-- vuna-interp：编译后的解释器 CLI 入口。
-- 参数：[--root DIR]... <file.vuna>；root 是模块根（默认 lib），可重复。
import Vuna.Base
import Vuna.Interp

usage = "usage: vuna-interp [--root DIR]... <file.vuna>"

main = run Nil getArgs

run roots args =
  case args of
    Cons "--root" (Cons dir rest) => run (append roots (Cons dir Nil)) rest
    Cons path Nil => emit roots path
    _ => usageError

usageError = let _ = print (usage ++ "\n") in 1

emit roots path =
  let actualRoots = effectiveRoots roots
  in let output = interpretFile actualRoots path
     in let _ = print (output ++ "\n") in 0