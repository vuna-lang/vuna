-- vuna-compile：用 vuna 写的编译器 CLI。
-- 用法：vuna-compile [--no-print] [--root DIR] <entry.vuna> [out.ml]
-- 不传 out.ml 时把生成的 OCaml 打到 stdout。
import Vuna.Ast
import Vuna.Interp

usage = "usage: vuna [--no-print] [--root DIR] <entry.vuna> [out.ml]"

main = dispatch True "lib" getArgs

dispatch printResult root args =
  case args of
    Nil => emitUsage
    Cons a rest =>
      if a == "--no-print" then dispatch False root rest
      else if a == "--root" then
        case rest of
          Cons dir rest2 => dispatch printResult dir rest2
          Nil => emitUsage
      else emit printResult root a rest

emitUsage = let _ = print (usage ++ "\n") in 1

emit printResult root entry rest =
  case Vuna.Interp.compileFile root entry printResult of
    Vuna.Ast.Ok code =>
      case rest of
        Cons out Nil => let _ = writeFile out code in 0
        _ => let _ = print code in 0
    Vuna.Ast.Err e => let _ = print ("error: " ++ e ++ "\n") in 1
