-- vuna-compile：用 vuna 写的编译器 CLI。
-- 用法：vuna-compile [--no-print] [--no-typecheck] [--typed] [--root DIR]... <entry.vuna> [out.ml]
-- 不传 out.ml 时把生成的 OCaml 打到 stdout。--root 可重复，按顺序组成模块根。
import Vuna.Base
import Vuna.Interp

usage = "usage: vuna [--no-print] [--no-typecheck] [--typed] [--root DIR]... <entry.vuna> [out.ml]"

main = dispatch True True True Nil getArgs

dispatch printResult typeCheck typed roots args =
  case args of
    Nil => emitUsage
    Cons a rest =>
      if a == "--no-print" then dispatch False typeCheck typed roots rest
      else if a == "--no-typecheck" then dispatch printResult False False roots rest
      else if a == "--typecheck" then dispatch printResult True typed roots rest
      else if a == "--typed" then dispatch printResult True True roots rest
      else if a == "--root" then
        case rest of
          Cons dir rest2 => dispatch printResult typeCheck typed (append roots (Cons dir Nil)) rest2
          Nil => emitUsage
      else emit printResult typeCheck typed roots a rest

emitUsage = let _ = print (usage ++ "\n") in 1

emit printResult typeCheck typed roots entry rest =
  let actualRoots = effectiveRoots roots
  in
    let result = if typed then compileFileTyped actualRoots entry printResult
                 else if typeCheck then compileFileChecked actualRoots entry printResult
                 else compileFile actualRoots entry printResult
    in case result of
         Ok code =>
           case rest of
             Cons out Nil => let _ = writeFile out code in 0
             _ => let _ = print code in 0
         Err e => let _ = print ("error: " ++ e ++ "\n") in 1