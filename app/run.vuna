-- 解释器 CLI 入口：从命令行读一个 .vuna 文件，解释执行，并把结果原样打印到
-- stdout（与 `vunax run` 的输出一致）。
--
-- 与 app/interp.vuna 组合（去掉 interp 的 demo main），再用
-- `vunax compile --no-print` 编译成独立二进制：
--
--   ./vuna-run vunax/test/corpus/run/01_arithmetic.vuna
--   7

main =
  case getArgs of
    Cons path rest =>
      let _ = print (interpret (readFile path) ++ "\n") in 0
    Nil =>
      let _ = print "usage: vuna-run <file.vuna>\n" in 0