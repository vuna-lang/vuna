-- vuna：统一 CLI 入口（compile / lint / interp）。
-- 用法：见 usage；不带子命令时按旧用法执行 compile。
import Vuna.Base
import Vuna.Interp
import qualified Lint

usage = "usage:\n  vuna compile [--no-print] [--no-typecheck] [--typecheck] [--typed] [--root DIR]... <entry.vuna> [out.ml]\n  vuna check [--root DIR]... <entry.vuna>\n  vuna lint [--fix] <file.vuna>...\n  vuna interp [--root DIR]... <file.vuna>\n  vuna help\n"

main = exit (dispatch (getArgs))

dispatch args =
  case args of
    Nil => usageError
    Cons arg rest =>
      case arg of
        "compile" => compileArgs rest
        "check" => checkArgs rest
        "lint" => Lint.runLint rest
        "interp" => interpArgs rest
        "help" => help
        "--help" => help
        _ => compileArgs args

help = let _ = print usage in 0

usageError = let _ = print usage in 2

compileArgs args = compileParse True True True Nil args

compileParse printResult typeCheck typed roots args =
  case args of
    Nil => usageError
    Cons arg rest =>
      case arg of
        "--no-print" => compileParse False typeCheck typed roots rest
        "--no-typecheck" => compileParse printResult False False roots rest
        "--typecheck" => compileParse printResult True typed roots rest
        "--typed" => compileParse True True True roots rest
        "--root" =>
          case rest of
            Cons dir rest2 => compileParse printResult typeCheck typed (append roots (Cons dir Nil)) rest2
            Nil => usageError
        _ => compileEmit printResult typeCheck typed roots arg rest

compileEmit printResult typeCheck typed roots entry rest =
  let actualRoots = effectiveRoots roots
  in
    let result = if typed then compileFileTyped actualRoots entry printResult
                 else if typeCheck then compileFileChecked actualRoots entry printResult
                 else compileFile actualRoots entry printResult
    in case result of
         Ok code =>
           case rest of
             Cons out Nil => let _ = writeFile out code in 0
             _ => let _ = print code in 0
         Err e => let _ = print ("error: " ++ e ++ "\n") in 1

interpArgs args = interpParse Nil args

interpParse roots args =
  case args of
    Cons "--root" (Cons dir rest) => interpParse (append roots (Cons dir Nil)) rest
    Cons path Nil => interpEmit (effectiveRoots roots) path
    _ => usageError

interpEmit roots path =
  let output = interpretFile roots path
  in let _ = print (output ++ "\n")
     in if startsWith "error:" output then 2 else 0

checkArgs args = checkParse Nil args

checkParse roots args =
  case args of
    Cons "--root" (Cons dir rest) => checkParse (append roots (Cons dir Nil)) rest
    Cons path Nil => checkEmit (effectiveRoots roots) path
    _ => usageError

checkEmit roots path =
  case checkFile roots path of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok warnings => let _ = printWarnings warnings in 0

printWarnings Nil = 0
printWarnings (Cons w rest) = let _ = print (w ++ "\n") in printWarnings rest