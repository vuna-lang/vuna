#!/bin/sh
# 仓库自带 shell wrapper：OpenCode 的 shell / terminal 工具在 flake 仓库内自动套
# nix develop devshell，没有 flake.nix 的目录退化为普通 zsh。
#
# OpenCode 以 `<shell> +o nomatch -c <script>` 这种形状调用，所以这里必须把
# "$@" 原样转发给真正的 zsh（不能自己拼 bash -c）。
#
# 生效路径：OpenCode 的 `shell` 只从全局配置读取，全局入口
# (~/.config/opencode/shell/nix-devshell) 会优先选用当前仓库里的这一份。
#
# `--no-warn-dirty`：工作树脏时不要每条命令都打一行 warning。
# `--quiet`：不打印 devshell 的 "building …" 行。
# `__NIXOS_SET_ENVIRONMENT_DONE`：NixOS 的 /etc/zshenv 在第一次启动 zsh 时会 source
# set-environment 并把 PATH 重置成系统默认，那样 devshell 的 PATH 就丢了。
# `VUNA_QUIET_SHELL`：devshell 横幅只在真正的交互式终端出现，工具调用保持静默。

ZSH=/run/current-system/sw/bin/zsh
NIX=/run/current-system/sw/bin/nix

dir=$PWD
while [ "$dir" != "/" ] && [ ! -e "$dir/flake.nix" ]; do
  dir=${dir%/*}
  [ -z "$dir" ] && dir=/
done

if [ -e "$dir/flake.nix" ] && [ -x "$NIX" ]; then
  __NIXOS_SET_ENVIRONMENT_DONE=1 VUNA_QUIET_SHELL=1 \
    exec "$NIX" develop --quiet --no-warn-dirty "$dir#default" --command "$ZSH" "$@"
fi

exec "$ZSH" "$@"