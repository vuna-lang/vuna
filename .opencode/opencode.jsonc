{
  "$schema": "https://opencode.ai/config.json",
  // 本仓的 shell / terminal 依赖 flake devshell（OCaml 工具链）。
  // 入口是 PATH 上的 `direnv-shell`（实现见 nixos-config 的 packages/direnv-shell.nix）：
  // 进入含 .envrc 的目录时用 direnv 载入环境（nix-direnv 缓存 devshell，不再每条命令 eval
  // flake），没有 .envrc 的目录退回普通 zsh。
  "shell": "direnv-shell",
}