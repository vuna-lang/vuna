module Vuna.Typecheck (TVar, TCon, TFun, Scheme, lookupScheme, checkProgramInfoElab, checkProgramInfo, checkProgram, exhaustiveWarnings) where

-- Vuna.Typecheck：core-v0 的 Hindley-Milner 风格类型检查。
-- M7b 先覆盖单文件程序与显式顶层签名；模块类型名解析与自检在 M7c 处理。

import Vuna.Base
import Vuna.Ast

data Ty : Type where
  TVar : Int -> Ty
  TCon : String -> List Ty -> Ty
  TFun : Ty -> Ty -> Ty

data Scheme : Type where
  Scheme : List Int -> Ty -> Scheme

-- M10.5 记录声明信息：类型名、参数名、字段（名+类型表达式）、deriving 列表。
data RecordInfo : Type where
  RecordInfo : String -> List String -> List (Pair String Expr) -> List String -> RecordInfo

-- 延迟求解的记录约束：字段访问 / 更新需要 base 的类型确定后才能消歧。
data RecConstraint : Type where
  FieldCon : Ty -> String -> Ty -> Span -> RecConstraint
  UpdateCon : Ty -> String -> Ty -> Span -> RecConstraint

-- M10.5 trait：方法信息（短名、scheme、原始类型表达式供 instance/deriving 生成签名）。
data TraitMethodInfo : Type where
  TraitMethodInfo : String -> Scheme -> Expr -> TraitMethodInfo

data TraitDecl : Type where
  TraitDecl : String -> List TraitMethodInfo -> TraitDecl

-- 方法查找表：key（loader 解析后的方法名）、trait、方法 scheme。
data TraitMethodRef : Type where
  TraitMethodRef : String -> String -> Scheme -> TraitMethodRef

-- 实例：trait、命名实例名（Nothing=default）、head 类型、方法短名 → 实现函数名。
data TraitInst : Type where
  TraitInst : String -> Maybe String -> Ty -> List (Pair String String) -> TraitInst

data TraitCtx : Type where
  TraitCtx : List TraitDecl -> List TraitInst -> TraitCtx

-- 推断状态：下一个类型变量编号、substitution、类型名表、记录表、待求解记录约束、
-- 方法表 + trait 上下文（M10.5 静态派发）。
data TC : Type where
  TC : Int -> List (Pair Int Ty) -> List String -> List RecordInfo -> List RecConstraint -> List TraitMethodRef -> TraitCtx -> TC

-- 推断阶段产出的 annotated 表达式：比较运算应用暂存操作数类型（Ty），
-- 待子句与顶层签名 unify 完成后，再用最终 substitution 决定合成 builtin 名。
-- 每个节点保留源码 span，供 lower 回 Expr 后做运行时错误定位。
data EExpr : Type where
  XEVar : String -> Span -> EExpr
  XEInt : Int -> Span -> EExpr
  XEStr : String -> Span -> EExpr
  XELam : List String -> EExpr -> Span -> EExpr
  XEApp : EExpr -> List EExpr -> Span -> EExpr
  XECmp : String -> List EExpr -> Ty -> Span -> EExpr
  XELet : List (Pair Pat EExpr) -> EExpr -> Bool -> Span -> EExpr
  XECase : EExpr -> Ty -> List (Pair Pat EExpr) -> Span -> EExpr
  XEIf : EExpr -> EExpr -> EExpr -> Span -> EExpr
  XEField : EExpr -> String -> Ty -> Span -> EExpr
  XERecUpdate : EExpr -> Ty -> List (Pair String EExpr) -> Span -> EExpr
  XEMethod : String -> String -> Ty -> Span -> EExpr
  XEMethodInst : String -> String -> String -> Ty -> Span -> EExpr

eeSpan e =
  case e of
    XEVar n sp => sp
    XEInt n sp => sp
    XEStr s sp => sp
    XELam ps b sp => sp
    XEApp f a sp => sp
    XECmp n a ty sp => sp
    XELet bs b _ sp => sp
    XECase s ty a sp => sp
    XEIf c t e sp => sp
    XEField b f ty sp => sp
    XERecUpdate b ty fs sp => sp
    XEMethod tr meth ty sp => sp
    XEMethodInst tr meth inst ty sp => sp

-- ---------------------------------------------------------------
-- 基础工具
-- ---------------------------------------------------------------

lookupSubst i Nil = Nothing
lookupSubst i (Cons (Pair j t) rest) =
  if i == j then Just t else lookupSubst i rest

memInt i Nil = False
memInt i (Cons x rest) = if i == x then True else memInt i rest

addUnique x xs = if memInt x xs then xs else Cons x xs

unionInts Nil ys = ys
unionInts (Cons x rest) ys = addUnique x (unionInts rest ys)

diffInts Nil ys = Nil
diffInts (Cons x rest) ys = if memInt x ys then diffInts rest ys else Cons x (diffInts rest ys)

resolveTy : List (Pair Int Ty) -> Ty -> Ty
resolveTy s ty =
  case ty of
    TVar i =>
      case lookupSubst i s of
        Just t => resolveTy s t
        Nothing => ty
    TCon n args => TCon n (map (resolveTy s) args)
    TFun a b => TFun (resolveTy s a) (resolveTy s b)

occursIn : Int -> List (Pair Int Ty) -> Ty -> Bool
occursIn i s ty =
  case resolveTy s ty of
    TVar j => i == j
    TCon n args => occursInArgs i s args
    TFun a b => occursIn i s a || occursIn i s b

occursInArgs i s Nil = False
occursInArgs i s (Cons ty rest) = occursIn i s ty || occursInArgs i s rest

showTy : Ty -> String
showTy ty =
  case ty of
    TVar i => "t" ++ strFromInt i
    TCon n Nil => n
    TCon n args => "(" ++ n ++ " " ++ showTyArgs args ++ ")"
    TFun a b => "(" ++ showTy a ++ " -> " ++ showTy b ++ ")"

showTyArgs Nil = ""
showTyArgs (Cons ty Nil) = showTy ty
showTyArgs (Cons ty rest) = showTy ty ++ " " ++ showTyArgs rest

nextVar : TC -> Pair Int TC
nextVar (TC n s typeNames records cons methods tctx) = Pair n (TC (n + 1) s typeNames records cons methods tctx)

freshTy : TC -> Pair Ty TC
freshTy st =
  case nextVar st of
    Pair n st2 => Pair (TVar n) st2

bindVar : Int -> Ty -> TC -> Result TC
bindVar i ty (TC n s typeNames records cons methods tctx) = Ok (TC n (Cons (Pair i ty) s) typeNames records cons methods tctx)

unifyLists : List Ty -> List Ty -> TC -> Result TC
unifyLists Nil Nil st = Ok st
unifyLists (Cons a ar) (Cons b br) st =
  case unify a b st of
    Err e => Err e
    Ok st2 => unifyLists ar br st2
unifyLists _ _ st = Err "type mismatch: different number of arguments"

unify : Ty -> Ty -> TC -> Result TC
unify a b (TC n s typeNames records cons methods tctx) =
  case resolveTy s a of
    ra =>
      case resolveTy s b of
        rb =>
          case ra of
            TVar i =>
              case rb of
                TVar j =>
                  if i == j then Ok (TC n s typeNames records cons methods tctx) else bindVar i rb (TC n s typeNames records cons methods tctx)
                _ =>
                  if occursIn i s rb then Err ("occurs check: " ++ showTy rb)
                  else bindVar i rb (TC n s typeNames records cons methods tctx)
            TCon tn xs =>
              case rb of
                TVar j =>
                  if occursIn j s ra then Err ("occurs check: " ++ showTy ra)
                  else bindVar j ra (TC n s typeNames records cons methods tctx)
                TCon tn2 ys =>
                  if tn == tn2 || sameBuiltinTy tn tn2 then unifyLists xs ys (TC n s typeNames records cons methods tctx)
                  else Err ("type mismatch: expected " ++ showTy rb ++ " but got " ++ showTy ra)
                _ => Err ("type mismatch: expected " ++ showTy rb ++ " but got " ++ showTy ra)
            TFun x y =>
              case rb of
                TVar j =>
                  if occursIn j s ra then Err ("occurs check: " ++ showTy ra)
                  else bindVar j ra (TC n s typeNames records cons methods tctx)
                TFun x2 y2 => andThen (unify x x2 (TC n s typeNames records cons methods tctx)) (\st2 => unify y y2 st2)
                _ => Err ("type mismatch: expected " ++ showTy rb ++ " but got " ++ showTy ra)

instantiateVars Nil st = Pair Nil st
instantiateVars (Cons q rest) st =
  case freshTy st of
    Pair ty st2 =>
      case instantiateVars rest st2 of
        Pair mapping st3 => Pair (Cons (Pair q ty) mapping) st3

renameTy mapping ty =
  case ty of
    TVar i =>
      case lookupSubst i mapping of
        Just t => t
        Nothing => ty
    TCon n args => TCon n (map (renameTy mapping) args)
    TFun a b => TFun (renameTy mapping a) (renameTy mapping b)

instantiate : TC -> Scheme -> Pair Ty TC
instantiate st (Scheme qs ty) =
  case instantiateVars qs st of
    Pair mapping st2 => Pair (renameTy mapping ty) st2

freeVarsTy ty =
  case ty of
    TVar i => Cons i Nil
    TCon n args => freeVarsArgs args
    TFun a b => unionInts (freeVarsTy a) (freeVarsTy b)

freeVarsArgs Nil = Nil
freeVarsArgs (Cons ty rest) = unionInts (freeVarsTy ty) (freeVarsArgs rest)

freeVarsScheme (Scheme qs ty) = diffInts (freeVarsTy ty) qs

freeVarsEnv Nil = Nil
freeVarsEnv (Cons (Pair n sch) rest) =
  unionInts (freeVarsScheme sch) (freeVarsEnv rest)

-- ---------------------------------------------------------------
-- 类型表达式 → Ty
-- ---------------------------------------------------------------

isLowerName name =
  case strUnpack name of
    Nil => False
    Cons c rest => c >= 97 && c <= 122

lookupTyVar name Nil = Nothing
lookupTyVar name (Cons (Pair n ty) rest) =
  if n == name then Just ty else lookupTyVar name rest

knownTypeName typeNames name =
  memName name typeNames || name == "Int" || name == "String" || name == "Bool"

convertTypes typeNames vars Nil st = Ok (Pair (Pair Nil vars) st)
convertTypes typeNames vars (Cons e rest) st =
  andThen (convertType typeNames vars st e) (\pa =>
    case pa of
      Pair (Pair ty vars1) st1 =>
        andThen (convertTypes typeNames vars1 rest st1) (\pb =>
          case pb of
            Pair (Pair tys vars2) st2 => Ok (Pair (Pair (Cons ty tys) vars2) st2)))

convertType typeNames vars st expr =
  case expr of
    EVar name _ =>
      if knownTypeName typeNames name then
        Ok (Pair (Pair (TCon name Nil) vars) st)
      else if isLowerName name then
        case lookupTyVar name vars of
          Just ty => Ok (Pair (Pair ty vars) st)
          Nothing =>
            case freshTy st of
              Pair ty st2 => Ok (Pair (Pair ty (Cons (Pair name ty) vars)) st2)
      else Err ("unknown type: " ++ name)
    EApp fn args _ =>
      case fn of
        EVar "->" _ =>
          case args of
            Cons a (Cons b Nil) =>
              andThen (convertType typeNames vars st a) (\pa =>
                case pa of
                  Pair (Pair ta vars1) st1 =>
                    andThen (convertType typeNames vars1 st1 b) (\pb =>
                      case pb of
                        Pair (Pair tb vars2) st2 =>
                          Ok (Pair (Pair (TFun ta tb) vars2) st2)))
            _ => Err "invalid arrow type"
        EVar name _ =>
          if knownTypeName typeNames name then
            andThen (convertTypes typeNames vars args st) (\pc =>
              case pc of
                Pair (Pair tys vars1) st1 => Ok (Pair (Pair (TCon name tys) vars1) st1))
          else Err ("unknown type constructor: " ++ name)
        _ => Err "invalid type application"
    _ => Err "invalid type expression"

varIds Nil = Nil
varIds (Cons (Pair n ty) rest) =
  case ty of
    TVar i => Cons i (varIds rest)
    _ => varIds rest

schemeOfSig typeNames ty st =
  andThen (convertType typeNames Nil st ty) (\p =>
    case p of
      Pair (Pair ty2 vars) st2 => Ok (Pair (Scheme (varIds vars) ty2) st2))

seedVars Nil st = Pair Nil st
seedVars (Cons name rest) st =
  case freshTy st of
    Pair ty st1 =>
      case seedVars rest st1 of
        Pair vars st2 => Pair (Cons (Pair name ty) vars) st2

schemeOfCtor typeNames params st (Ctor name ty arity _) =
  case seedVars params st of
    Pair vars st1 =>
      andThen (convertType typeNames vars st1 ty) (\p =>
        case p of
          Pair (Pair ty2 vars2) st2 =>
            Ok (Pair (Pair name (Scheme (varIds vars2) ty2)) st2))

-- ---------------------------------------------------------------
-- 收集声明：数据类型名、签名、构造器 scheme
-- ---------------------------------------------------------------

declDataNames Nil = Nil
declDataNames (Cons d rest) =
  case d of
    DData name params ctors _ _ => Cons name (declDataNames rest)
    _ => declDataNames rest

collectSigs typeNames Nil st = Ok (Pair Nil st)
collectSigs typeNames (Cons d rest) st =
  case d of
    DSig name ty _ =>
      andThen (schemeOfSig typeNames ty st) (\p =>
        case p of
          Pair sch st1 =>
            andThen (collectSigs typeNames rest st1) (\q =>
              case q of Pair sigs st2 => Ok (Pair (Cons (Pair name sch) sigs) st2)))
    _ => collectSigs typeNames rest st

collectCtors typeNames Nil st = Ok (Pair Nil st)
collectCtors typeNames (Cons d rest) st =
  case d of
    DData name params ctors _ _ =>
      andThen (collectCtorList typeNames params ctors st) (\p =>
        case p of
          Pair newCtors st1 =>
            andThen (collectCtors typeNames rest st1) (\q =>
              case q of Pair ctors2 st2 => Ok (Pair (append newCtors ctors2) st2)))
    _ => collectCtors typeNames rest st

collectCtorList typeNames params Nil st = Ok (Pair Nil st)
collectCtorList typeNames params (Cons c rest) st =
  andThen (schemeOfCtor typeNames params st c) (\p =>
    case p of
      Pair (Pair cname sch) st1 =>
        andThen (collectCtorList typeNames params rest st1) (\q =>
          case q of Pair ctors st2 => Ok (Pair (Cons (Pair cname sch) ctors) st2)))

-- ---------------------------------------------------------------
-- 内建函数类型
-- ---------------------------------------------------------------

intTy = TCon "Int" Nil

strTy = TCon "String" Nil

boolTy = TCon "Bool" Nil

listOf ty = TCon "List" (Cons ty Nil)

fun2 a b c = TFun a (TFun b c)

builtinSchemes =
  [ Pair "+" (Scheme Nil (fun2 intTy intTy intTy))
  , Pair "-" (Scheme Nil (fun2 intTy intTy intTy))
  , Pair "*" (Scheme Nil (fun2 intTy intTy intTy))
  , Pair "/" (Scheme Nil (fun2 intTy intTy intTy))
  , Pair "==" (Scheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "/=" (Scheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "<" (Scheme Nil (fun2 intTy intTy boolTy))
  , Pair "<=" (Scheme Nil (fun2 intTy intTy boolTy))
  , Pair ">" (Scheme Nil (fun2 intTy intTy boolTy))
  , Pair ">=" (Scheme Nil (fun2 intTy intTy boolTy))
  , Pair "&&" (Scheme Nil (fun2 boolTy boolTy boolTy))
  , Pair "||" (Scheme Nil (fun2 boolTy boolTy boolTy))
  , Pair "++" (Scheme Nil (fun2 strTy strTy strTy))
  , Pair "strLength" (Scheme Nil (TFun strTy intTy))
  , Pair "strUnpack" (Scheme Nil (TFun strTy (listOf intTy)))
  , Pair "strPack" (Scheme Nil (TFun (listOf intTy) strTy))
  , Pair "strFromInt" (Scheme Nil (TFun intTy strTy))
  , Pair "readFile" (Scheme Nil (TFun strTy strTy))
  , Pair "writeFile" (Scheme Nil (fun2 strTy strTy intTy))
  , Pair "print" (Scheme Nil (TFun strTy intTy))
  , Pair "getArgs" (Scheme Nil (listOf strTy))
  , Pair "fileExists" (Scheme Nil (TFun strTy boolTy))
  , Pair "exit" (Scheme Nil (TFun intTy intTy))
  ]

-- ---------------------------------------------------------------
-- 比较运算符的 typed elaboration：按操作数 unify 后的类型改写合成 builtin 名
-- ---------------------------------------------------------------

intCmpName name =
  case name of
    "==" => "bi_eq_int"
    "/=" => "bi_neq_int"
    "<" => "bi_lt_int"
    "<=" => "bi_le_int"
    ">" => "bi_gt_int"
    ">=" => "bi_ge_int"
    _ => name

strCmpName name =
  case name of
    "==" => "bi_eq_str"
    "/=" => "bi_neq_str"
    _ => name

boolCmpName name =
  case name of
    "==" => "bi_eq_bool"
    "/=" => "bi_neq_bool"
    _ => name

specializeCmp name ty =
  case ty of
    TCon n args =>
      if shortTyName n == "Int" then intCmpName name
      else if shortTyName n == "String" then strCmpName name
      else if shortTyName n == "Bool" then boolCmpName name
      else name
    _ => name

firstArgTy argTys =
  case argTys of
    Cons ty rest => ty
    Nil => TCon "" Nil

isCmpName name =
  name == "==" || name == "/=" || name == "<" || name == "<=" || name == ">" || name == ">="

elabAppExpr fn fnElab args argTys argEls sp =
  case fn of
    EVar name _ =>
      case args of
        Cons _ (Cons _ Nil) =>
          if isCmpName name then XECmp name argEls (firstArgTy argTys) sp
          else XEApp fnElab argEls sp
        _ => XEApp fnElab argEls sp
    _ => XEApp fnElab argEls sp

-- 记录字段降级用的临时模式变量（只在生成的一小段 case 内可见）。
recFieldVarsAt i n = if i >= n then Nil else Cons ("vuna_rf" ++ strFromInt i) (recFieldVarsAt (i + 1) n)

recFieldVars n = recFieldVarsAt 0 n

nthNameAt i Nil = ""

nthNameAt i (Cons x rest) = if i == 0 then x else nthNameAt (i - 1) rest

nthName i vars = nthNameAt i vars

recFieldCount Nil = 0

recFieldCount (Cons (Pair n t) rest) = 1 + recFieldCount rest

-- `e.f` → `case e of R v0 .. vn => vk`；base 只求值一次。
lowerFieldAccess subst typeNames records base fname baseTy sp =
  case resolveTy subst baseTy of
    TCon rname args =>
      case lookupRecord rname records of
        Nothing => EInt 0 sp
        Just (RecordInfo rname2 params fdefs derivings) =>
          case fieldIndex fname fdefs of
            Nothing => EInt 0 sp
            Just k =>
              let n = recFieldCount fdefs
              in let names = recFieldVars n
                 in let pats = map (\nm => PVar nm sp) names
                    in ECase (lowerExpr subst typeNames records base)
                         (Cons (Pair (PCon rname pats sp) (EVar (nthName k names) sp)) Nil) sp
    _ => EInt 0 sp

recUpdateArgs subst typeNames records fields provided vars i sp =
  case fields of
    Nil => Nil
    Cons (Pair fname fty) rest =>
      case lookupProvided fname provided of
        Just e =>
          Cons (lowerExpr subst typeNames records e)
               (recUpdateArgs subst typeNames records rest provided vars (i + 1) sp)
        Nothing =>
          Cons (EVar (nthName i vars) sp)
               (recUpdateArgs subst typeNames records rest provided vars (i + 1) sp)

-- `{e | f = v}` → `case e of R v0 .. vn => R (v / vi) ...`
lowerRecUpdate subst typeNames records base baseTy fields sp =
  case resolveTy subst baseTy of
    TCon rname args =>
      case lookupRecord rname records of
        Nothing => EInt 0 sp
        Just (RecordInfo rname2 params fdefs derivings) =>
          let n = recFieldCount fdefs
          in let names = recFieldVars n
             in let pats = map (\nm => PVar nm sp) names
                in let args2 = recUpdateArgs subst typeNames records fdefs fields names 0 sp
                   in ECase (lowerExpr subst typeNames records base)
                        (Cons (Pair (PCon rname pats sp) (EApp (EVar rname sp) args2 sp)) Nil) sp
    _ => EInt 0 sp

lowerExpr subst typeNames records expr =
  case expr of
    XEVar name sp => EVar name sp
    XEInt n sp => EInt n sp
    XEStr s sp => EStr s sp
    XELam params body sp => ELam params (lowerExpr subst typeNames records body) sp
    XEApp fn args sp =>
      EApp (lowerExpr subst typeNames records fn) (map (lowerExpr subst typeNames records) args) sp
    XECmp name args ty sp =>
      EApp (EVar (specializeCmp name (resolveTy subst ty)) sp)
           (map (lowerExpr subst typeNames records) args) sp
    XELet binds body rec_ sp =>
      ELet (map (lowerBind subst typeNames records) binds) (lowerExpr subst typeNames records body) rec_ sp
    XECase scrut ty alts sp =>
      ECase (lowerExpr subst typeNames records scrut) (map (lowerAlt subst typeNames records) alts) sp
    XEIf c t e sp =>
      EIf (lowerExpr subst typeNames records c) (lowerExpr subst typeNames records t)
          (lowerExpr subst typeNames records e) sp
    XEField base fname baseTy sp =>
      lowerFieldAccess subst typeNames records base fname baseTy sp
    XERecUpdate base baseTy fields sp =>
      lowerRecUpdate subst typeNames records base baseTy fields sp

lowerBind subst typeNames records (Pair pat value) =
  Pair pat (lowerExpr subst typeNames records value)

lowerAlt subst typeNames records (Pair pat body) =
  Pair pat (lowerExpr subst typeNames records body)

lowerClause subst typeNames records (Pair pats body) =
  Pair pats (lowerExpr subst typeNames records body)

lowerClauses subst typeNames records Nil = Nil

lowerClauses subst typeNames records (Cons clause rest) =
  Cons (lowerClause subst typeNames records clause) (lowerClauses subst typeNames records rest)

-- ---------------------------------------------------------------
-- 记录（M10.5）：声明抽取、语法降级、延迟约束求解、lower
-- ---------------------------------------------------------------

recordsOf (TC n s typeNames records cons methods tctx) = records

typeNamesOfTC (TC n s typeNames records cons methods tctx) = typeNames

constraintsOfTC (TC n s typeNames records cons methods tctx) = cons

addRecConstraint c (TC n s typeNames records cons methods tctx) = TC n s typeNames records (Cons c cons) methods tctx

clearRecConstraints (TC n s typeNames records cons methods tctx) = TC n s typeNames records Nil methods tctx

lookupRecord name Nil = Nothing

lookupRecord name (Cons (RecordInfo rname params fields derivings) rest) =
  if rname == name then Just (RecordInfo rname params fields derivings)
  else lookupRecord name rest

zipParamTys Nil Nil = Nil

zipParamTys (Cons p ps) (Cons t ts) = Cons (Pair p t) (zipParamTys ps ts)

freshParamTys Nil st = Pair Nil st

freshParamTys (Cons p ps) st =
  case freshTy st of
    Pair ty st1 =>
      case freshParamTys ps st1 of
        Pair tys st2 => Pair (Cons ty tys) st2

fieldNamesOf Nil = Nil

fieldNamesOf (Cons (Pair n t) rest) = Cons n (fieldNamesOf rest)

fieldIndexAt fname Nil i = Nothing

fieldIndexAt fname (Cons (Pair n t) rest) i =
  if n == fname then Just i else fieldIndexAt fname rest (i + 1)

fieldIndex fname fields = fieldIndexAt fname fields 0

lookupProvided : String -> List (Pair String a) -> Maybe a
lookupProvided fname Nil = Nothing

lookupProvided fname (Cons (Pair n e) rest) =
  if n == fname then Just e else lookupProvided fname rest

hasDuplicateFieldNames : List (Pair String a) -> Bool
hasDuplicateFieldNames Nil = False

hasDuplicateFieldNames (Cons (Pair n e) rest) =
  case lookupProvided n rest of
    Just _ => True
    Nothing => hasDuplicateFieldNames rest

missingFieldMsg sp fname = showSpanLoc sp ++ ": missing field " ++ fname

unknownFieldMsg sp fname = showSpanLoc sp ++ ": unknown field " ++ fname

duplicateFieldMsg sp = showSpanLoc sp ++ ": duplicate field"

hasUnknownFields fieldNames Nil = False

hasUnknownFields fieldNames (Cons (Pair n v) rest) =
  if memName n fieldNames then hasUnknownFields fieldNames rest else True

firstUnknownFieldMsg sp fieldNames Nil = unknownFieldMsg sp ""

firstUnknownFieldMsg sp fieldNames (Cons (Pair n v) rest) =
  if memName n fieldNames then firstUnknownFieldMsg sp fieldNames rest
  else unknownFieldMsg sp n

checkProvidedFields fieldNames Nil sp = Ok Nil

checkProvidedFields fieldNames (Cons (Pair n v) rest) sp =
  if memName n fieldNames then checkProvidedFields fieldNames rest sp
  else Err (unknownFieldMsg sp n)

-- 记录声明抽取：DRecord 记住 RecordInfo，并降级成单构造器 DData。
extractRecords Nil = Pair Nil Nil

extractRecords (Cons d rest) =
  case extractRecords rest of
    Pair recs ds =>
      case d of
        DRecord dname params fields derivings sp =>
          let info = RecordInfo dname params (map recordFieldPair fields) derivings
          in Pair (Cons info recs) (Cons (recordDeclToData d) ds)
        _ => Pair recs (Cons d ds)

recordFieldPair (Field fname ty sp) = Pair fname ty

recordParamNames Nil = Nil

recordParamNames (Cons p rest) = Cons p (recordParamNames rest)

recordParamVarExprs params sp = map (\p => EVar p sp) params

recordCtorFieldExprs fields = map fieldType fields

recordRetType dname params sp = EApp (EVar dname sp) (recordParamVarExprs (recordParamNames params) sp) sp

recordArrowType Nil ret sp = ret

recordArrowType (Cons f fs) ret sp =
  EApp (EVar "->" sp) (Cons (fieldType f) (Cons (recordArrowType fs ret sp) Nil)) sp

recordDeclToData (DRecord dname params fields derivings sp) =
  DData dname params
    (Cons (Ctor dname (recordArrowType fields (recordRetType dname params sp) sp) (length fields) sp) Nil)
    derivings sp

-- 记录语法降级：构造 → 构造器应用；记录模式 → 构造器模式（按声明顺序补 PWild）。
desugarRecords : List RecordInfo -> List Decl -> Result (List Decl)
desugarRecords records decls = traverse (desugarRecordDecl records) decls

desugarRecordDecl : List RecordInfo -> Decl -> Result Decl
desugarRecordDecl records d =
  case d of
    DFun name pats body sp =>
      andThen (traverse (desugarPattern records) pats) (\pats2 =>
        andThen (desugarExpr records body) (\body2 => Ok (DFun name pats2 body2 sp)))
    DData name params ctors derivings sp => Ok d
    DRecord name params fields derivings sp => Ok d
    DTrait name params methods sp => Ok d
    DInstance iname isDefault head methods sp =>
      andThen (traverse (desugarRecordDecl records) methods) (\ms => Ok (DInstance iname isDefault head ms sp))
    DSig name ty sp => Ok d

desugarPattern records pat =
  case pat of
    PWild sp => Ok (PWild sp)
    PVar n sp => Ok (PVar n sp)
    PInt n sp => Ok (PInt n sp)
    PStr s sp => Ok (PStr s sp)
    PCon name pats sp =>
      andThen (traverse (desugarPattern records) pats) (\ps => Ok (PCon name ps sp))
    PRecord name fields sp =>
      case lookupRecord name records of
        Nothing => Err (showSpanLoc sp ++ ": unknown record: " ++ name)
        Just (RecordInfo rname params fdefs derivings) =>
          if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
          else if hasUnknownFields (fieldNamesOf fdefs) fields then
            Err (firstUnknownFieldMsg sp (fieldNamesOf fdefs) fields)
          else
            andThen (desugarRecordPatternFields records fdefs fields sp) (\ps =>
              Ok (PCon rname ps sp))

desugarRecordPatternFields records Nil provided sp = Ok Nil

desugarRecordPatternFields records (Cons (Pair fname fty) rest) provided sp =
  case lookupProvided fname provided of
    Nothing =>
      andThen (desugarRecordPatternFields records rest provided sp) (\ps =>
        Ok (Cons (PWild sp) ps))
    Just p =>
      andThen (desugarPattern records p) (\p2 =>
        andThen (desugarRecordPatternFields records rest provided sp) (\ps =>
          Ok (Cons p2 ps)))

desugarExpr : List RecordInfo -> Expr -> Result Expr
desugarExpr records e =
  case e of
    EVar n sp => Ok e
    EInt n sp => Ok e
    EStr s sp => Ok e
    ELam ps b sp =>
      andThen (desugarExpr records b) (\b2 => Ok (ELam ps b2 sp))
    EApp f args sp =>
      andThen (desugarExpr records f) (\f2 =>
        andThen (traverse (desugarExpr records) args) (\a2 => Ok (EApp f2 a2 sp)))
    ELet binds body rec_ sp =>
      andThen (traverse (desugarBind records) binds) (\b2 =>
        andThen (desugarExpr records body) (\body2 => Ok (ELet b2 body2 rec_ sp)))
    ECase scrut alts sp =>
      andThen (desugarExpr records scrut) (\s2 =>
        andThen (traverse (desugarAlt records) alts) (\a2 => Ok (ECase s2 a2 sp)))
    EIf c t el sp =>
      andThen (desugarExpr records c) (\c2 =>
        andThen (desugarExpr records t) (\t2 =>
          andThen (desugarExpr records el) (\e2 => Ok (EIf c2 t2 e2 sp))))
    EField base fname sp =>
      andThen (desugarExpr records base) (\b => Ok (EField b fname sp))
    ERecord name fields sp =>
      case lookupRecord name records of
        Nothing => Err (showSpanLoc sp ++ ": unknown record: " ++ name)
        Just (RecordInfo rname params fdefs derivings) =>
          if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
          else if hasUnknownFields (fieldNamesOf fdefs) fields then
            Err (firstUnknownFieldMsg sp (fieldNamesOf fdefs) fields)
          else
            andThen (desugarRecordValues records fdefs fields sp) (\vs =>
              Ok (EApp (EVar rname sp) vs sp))
    ERecUpdate base fields sp =>
      andThen (desugarExpr records base) (\b =>
        andThen (traverse (desugarFieldValue records) fields) (\fs => Ok (ERecUpdate b fs sp)))
    EInstSel m n sp =>
      andThen (desugarExpr records m) (\m2 => Ok (EInstSel m2 n sp))

desugarRecordValues : List RecordInfo -> List (Pair String Expr) -> List (Pair String Expr) -> Span -> Result (List Expr)
desugarRecordValues records Nil provided sp = Ok Nil

desugarRecordValues records (Cons (Pair fname fty) rest) provided sp =
  case lookupProvided fname provided of
    Nothing => Err (missingFieldMsg sp fname)
    Just v =>
      andThen (desugarExpr records v) (\v2 =>
        andThen (desugarRecordValues records rest provided sp) (\vs =>
          Ok (Cons v2 vs)))

desugarFieldValue : List RecordInfo -> Pair String Expr -> Result (Pair String Expr)
desugarFieldValue records (Pair fname v) =
  andThen (desugarExpr records v) (\v2 => Ok (Pair fname v2))

desugarBind : List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarBind records (Pair pat value) =
  andThen (desugarPattern records pat) (\p2 =>
    andThen (desugarExpr records value) (\v2 => Ok (Pair p2 v2)))

desugarAlt : List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarAlt records (Pair pat body) =
  andThen (desugarPattern records pat) (\p2 =>
    andThen (desugarExpr records body) (\b2 => Ok (Pair p2 b2)))

-- ---------------------------------------------------------------
-- 环境查询与推断
-- ---------------------------------------------------------------

lookupLocal name Nil = Nothing
lookupLocal name (Cons (Pair n ty) rest) =
  if n == name then Just ty else lookupLocal name rest

lookupScheme name Nil = Nothing
lookupScheme name (Cons (Pair n sch) rest) =
  if n == name then Just sch else lookupScheme name rest

funArgs ty =
  case ty of
    TFun a b => Cons a (funArgs b)
    _ => Nil

funResult ty =
  case ty of
    TFun a b => funResult b
    _ => ty

foldFun Nil body = body
foldFun (Cons a rest) body = TFun a (foldFun rest body)

seedPatTypes Nil st = Pair Nil st
seedPatTypes (Cons p rest) st =
  case freshTy st of
    Pair ty st1 =>
      case seedPatTypes rest st1 of
        Pair tys st2 => Pair (Cons ty tys) st2

inferPatterns globals locals Nil Nil st = Ok (Pair locals st)
inferPatterns globals locals (Cons p pr) (Cons ty tr) st =
  andThen (inferPattern globals locals st p ty) (\q =>
    case q of
      Pair locals2 st1 => inferPatterns globals locals2 pr tr st1)
inferPatterns globals locals _ _ st = Err "pattern arity mismatch"

inferPattern globals locals st pat expected =
  case pat of
    PWild _ => Ok (Pair locals st)
    PVar name _ => Ok (Pair (Cons (Pair name expected) locals) st)
    PInt n _ => andThen (unify intTy expected st) (\st2 => Ok (Pair locals st2))
    PStr s _ => andThen (unify strTy expected st) (\st2 => Ok (Pair locals st2))
    PCon name pats _ =>
      case lookupScheme name globals of
        Nothing => Err ("unknown constructor: " ++ name ++ suggest name (map firstOf globals))
        Just sch =>
          case instantiate st sch of
            Pair ctorTy st1 =>
              let argTys = funArgs ctorTy
              in if length pats == length argTys then
                   andThen (unify (funResult ctorTy) expected st1) (\st2 =>
                     inferPatterns globals locals pats argTys st2)
                 else Err ("constructor " ++ name ++ " expects " ++ strFromInt (length argTys) ++ " arguments")

inferArgs globals locals fnTy Nil st = Ok (Pair Nil (Pair Nil (Pair fnTy st)))
inferArgs globals locals fnTy (Cons arg rest) st =
  andThen (inferExpr globals locals st arg) (\pa =>
    case pa of
      Pair (Pair argTy argElab) st1 =>
        case freshTy st1 of
          Pair resTy st2 =>
            andThen (unify fnTy (TFun argTy resTy) st2) (\st3 =>
              andThen (inferArgs globals locals resTy rest st3) (\pr =>
                case pr of
                  Pair argTys (Pair argEls (Pair finalTy st4)) =>
                    Ok (Pair (Cons argTy argTys) (Pair (Cons argElab argEls) (Pair finalTy st4))))))

seedLocals Nil locals st = Pair Nil (Pair locals st)
seedLocals (Cons name rest) locals st =
  case freshTy st of
    Pair ty st1 =>
      case seedLocals rest (Cons (Pair name ty) locals) st1 of
        Pair tys (Pair locals2 st2) => Pair (Cons ty tys) (Pair locals2 st2)

inferBinds globals locals Nil st = Ok (Pair Nil (Pair locals st))
inferBinds globals locals (Cons (Pair pat value) rest) st =
  andThen (inferExpr globals locals st value) (\pv =>
    case pv of
      Pair (Pair valueTy valueElab) st1 =>
        andThen (inferPattern globals locals st1 pat valueTy) (\pp =>
          case pp of
            Pair locals2 st2 =>
              andThen (inferBinds globals locals2 rest st2) (\pr =>
                case pr of
                  Pair bindEls (Pair locals3 st3) =>
                    Ok (Pair (Cons (Pair pat valueElab) bindEls) (Pair locals3 st3)))))

-- 递归 let（where 块）：所有绑定名对全部 value 与 body 可见，可互相/自引用。
inferRecLet globals locals binds body sp st =
  case seedRecNames binds st of
    Err e => Err e
    Ok (Pair recPairs st1) =>
      let locals2 = recExtendLocals locals recPairs
      in case checkRecValues globals locals2 recPairs st1 of
           Err e => Err e
           Ok (Pair recElabs st2) =>
             case inferExpr globals locals2 st2 body of
               Err e => Err e
               Ok (Pair (Pair bodyTy bodyElab) st3) =>
                 Ok (Pair (Pair bodyTy (XELet recElabs bodyElab True sp)) st3)

seedRecNames Nil st = Ok (Pair Nil st)
seedRecNames (Cons (Pair pat value) rest) st =
  case pat of
    PVar name _ =>
      case freshTy st of
        Pair ty st1 =>
          case seedRecNames rest st1 of
            Ok (Pair tail st2) => Ok (Pair (Cons (Pair (Pair name ty) (Pair pat value)) tail) st2)
            Err e => Err e
    _ => Err "recursive let bindings must be simple names"

recExtendLocals locals Nil = locals
recExtendLocals locals (Cons (Pair (Pair name ty) _) rest) =
  recExtendLocals (Cons (Pair name ty) locals) rest

checkRecValues globals locals Nil st = Ok (Pair Nil st)
checkRecValues globals locals (Cons (Pair (Pair _ ty) (Pair pat value)) rest) st =
  andThen (inferExpr globals locals st value) (\pv =>
    case pv of
      Pair (Pair valueTy valueElab) st1 =>
        andThen (unify ty valueTy st1) (\st2 =>
          case checkRecValues globals locals rest st2 of
            Ok (Pair tail st3) => Ok (Pair (Cons (Pair pat valueElab) tail) st3)
            Err e => Err e))

inferAlts globals locals scrutTy Nil st = Err "empty case"
inferAlts globals locals scrutTy (Cons (Pair pat body) rest) st =
  andThen (inferPattern globals locals st pat scrutTy) (\pp =>
    case pp of
      Pair locals2 st1 =>
        andThen (inferExpr globals locals2 st1 body) (\pb =>
          case pb of
            Pair (Pair bodyTy bodyElab) st2 =>
              case rest of
                Nil => Ok (Pair (Cons (Pair pat bodyElab) Nil) (Pair bodyTy st2))
                _ =>
                  andThen (inferAlts globals locals scrutTy rest st2) (\pr =>
                    case pr of
                      Pair altsElab (Pair restTy st3) =>
                        andThen (unify bodyTy restTy st3) (\st4 =>
                          Ok (Pair (Cons (Pair pat bodyElab) altsElab) (Pair bodyTy st4))))))

inferExpr globals locals st expr =
  case expr of
    EVar name sp =>
      case lookupLocal name locals of
        Just ty => Ok (Pair (Pair ty (XEVar name sp)) st)
        Nothing =>
          case lookupScheme name globals of
            Just sch =>
              case instantiate st sch of
                Pair ty st2 => Ok (Pair (Pair ty (XEVar name sp)) st2)
            Nothing => Err ("unbound variable: " ++ name ++ suggest name (map firstOf globals))
    EInt n sp => Ok (Pair (Pair intTy (XEInt n sp)) st)
    EStr s sp => Ok (Pair (Pair strTy (XEStr s sp)) st)
    EApp fn args sp =>
      andThen (inferExpr globals locals st fn) (\pf =>
        case pf of
          Pair (Pair fnTy fnElab) st1 =>
            andThen (inferArgs globals locals fnTy args st1) (\pr =>
              case pr of
                Pair argTys (Pair argEls (Pair resTy st2)) =>
                  Ok (Pair (Pair resTy (elabAppExpr fn fnElab args argTys argEls sp)) st2)))
    ELam params body sp =>
      case seedLocals params locals st of
        Pair paramTys (Pair locals2 st1) =>
          andThen (inferExpr globals locals2 st1 body) (\pb =>
            case pb of
              Pair (Pair bodyTy bodyElab) st2 =>
                Ok (Pair (Pair (foldFun paramTys bodyTy) (XELam params bodyElab sp)) st2))
    ELet binds body rec_ sp =>
      if rec_ then inferRecLet globals locals binds body sp st
      else
        andThen (inferBinds globals locals binds st) (\pb =>
          case pb of
            Pair bindEls (Pair locals2 st1) =>
              andThen (inferExpr globals locals2 st1 body) (\pr =>
                case pr of
                  Pair (Pair bodyTy bodyElab) st2 =>
                    Ok (Pair (Pair bodyTy (XELet bindEls bodyElab False sp)) st2)))
    ECase scrut alts sp =>
      andThen (inferExpr globals locals st scrut) (\ps =>
        case ps of
          Pair (Pair scrutTy scrutElab) st1 =>
            andThen (inferAlts globals locals scrutTy alts st1) (\pr =>
              case pr of
                Pair altsElab (Pair bodyTy st2) =>
                  Ok (Pair (Pair bodyTy (XECase scrutElab scrutTy altsElab sp)) st2)))
    EIf c t e sp =>
      andThen (inferExpr globals locals st c) (\pc =>
        case pc of
          Pair (Pair condTy condElab) st1 =>
            andThen (unify condTy boolTy st1) (\st2 =>
              andThen (inferExpr globals locals st2 t) (\pt =>
                case pt of
                  Pair (Pair thenTy thenElab) st3 =>
                    andThen (inferExpr globals locals st3 e) (\pe =>
                      case pe of
                        Pair (Pair elseTy elseElab) st4 =>
                          andThen (unify thenTy elseTy st4) (\st5 =>
                            Ok (Pair (Pair thenTy (XEIf condElab thenElab elseElab sp)) st5))))))
    EField base fname sp =>
      andThen (inferExpr globals locals st base) (\pb =>
        case pb of
          Pair (Pair baseTy baseElab) st1 =>
            case freshTy st1 of
              Pair resTy st2 =>
                Ok (Pair (Pair resTy (XEField baseElab fname baseTy sp))
                      (addRecConstraint (FieldCon baseTy fname resTy sp) st2)))
    ERecUpdate base fields sp =>
      andThen (inferExpr globals locals st base) (\pb =>
        case pb of
          Pair (Pair baseTy baseElab) st1 =>
            if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
            else
              andThen (inferUpdateValues globals locals baseTy sp fields st1) (\p =>
                case p of
                  Pair vals st2 =>
                    Ok (Pair (Pair baseTy (XERecUpdate baseElab baseTy vals sp)) st2)))
    ERecord rname fields sp => Err (showSpanLoc sp ++ ": internal: record expression should be desugared before inference")
    EInstSel meth iname sp => Err (showSpanLoc sp ++ ": trait method selection is not implemented yet (M10.5 Phase T)")

inferUpdateValues globals locals baseTy sp Nil st = Ok (Pair Nil st)

inferUpdateValues globals locals baseTy sp (Cons (Pair fname e) rest) st =
  andThen (inferExpr globals locals st e) (\p =>
    case p of
      Pair (Pair vty velab) st1 =>
        andThen (inferUpdateValues globals locals baseTy sp rest st1) (\r =>
          case r of
            Pair vs st2 =>
              Ok (Pair (Cons (Pair fname velab) vs)
                    (addRecConstraint (UpdateCon baseTy fname vty sp) st2))))

tcNoSpan = Span "" 0 0 0 0

nthFieldTy i Nil = EInt 0 tcNoSpan

nthFieldTy i (Cons (Pair n t) rest) = if i == 0 then t else nthFieldTy (i - 1) rest

-- 延迟记录约束求解：逐个尝试；全部求解后清空 TC 中的约束列表。
solveRecConstraints typeNames records cons st =
  case solveRecPass typeNames records cons st Nil of
    Err e => Err e
    Ok (Pair remaining st2) =>
      case remaining of
        Nil => Ok (clearRecConstraints st2)
        _ =>
          if length remaining == length cons then
            Err (recConstraintFailMsg remaining)
          else solveRecConstraints typeNames records remaining st2

recConstraintFailMsg Nil = "cannot resolve record type; add a type signature"

recConstraintFailMsg (Cons c rest) =
  case c of
    FieldCon baseTy fname resTy sp =>
      showSpanLoc sp ++ ": cannot resolve record type for field access ." ++ fname
      ++ "; add a type signature"
    UpdateCon baseTy fname valTy sp =>
      showSpanLoc sp ++ ": cannot resolve record type for record update {" ++ fname
      ++ " = ...}; add a type signature"

solveRecPass typeNames records Nil st acc = Ok (Pair (reverse acc) st)

solveRecPass typeNames records (Cons c rest) st acc =
  case solveOneConstraint typeNames records c st of
    Err e => Err e
    Ok (Pair solved st1) =>
      case solved of
        True => solveRecPass typeNames records rest st1 acc
        False => solveRecPass typeNames records rest st1 (Cons c acc)

solveOneConstraint typeNames records c st =
  case c of
    FieldCon baseTy fname targetTy sp =>
      solveFieldConstraint typeNames records baseTy fname targetTy sp st
    UpdateCon baseTy fname valTy sp =>
      solveFieldConstraint typeNames records baseTy fname valTy sp st

solveFieldConstraint typeNames records baseTy fname targetTy sp st =
  case resolveTy (substOf st) baseTy of
    TVar i => Ok (Pair False st)
    TCon rname args =>
      case lookupRecord rname records of
        Nothing => Err (showSpanLoc sp ++ ": not a record type: " ++ rname)
        Just (RecordInfo rname2 params fdefs derivings) =>
          case fieldIndex fname fdefs of
            Nothing =>
              Err (showSpanLoc sp ++ ": unknown field " ++ fname ++ " for record " ++ rname)
            Just k =>
              andThen (convertType typeNames (zipParamTys params args) st (nthFieldTy k fdefs)) (\p =>
                case p of
                  Pair (Pair fty vars) st1 =>
                    andThen (unify targetTy fty st1) (\st2 => Ok (Pair True st2)))
    _ => Err (showSpanLoc sp ++ ": not a record type in field access/update")

inferClause globals st (Pair pats body) =
  case seedPatTypes pats st of
    Pair paramTys st1 =>
      andThen (inferPatterns globals Nil pats paramTys st1) (\pp =>
        case pp of
          Pair locals2 st2 =>
            andThen (inferExpr globals locals2 st2 body) (\pb =>
              case pb of
                Pair (Pair bodyTy bodyElab) st3 =>
                  Ok (Pair (Pair (foldFun paramTys bodyTy) (Pair pats bodyElab)) st3)))

inferClauses globals Nil st = Err "function has no clauses"
inferClauses globals (Cons clause rest) st =
  andThen (inferClause globals st clause) (\pc =>
    case pc of
      Pair (Pair ty clauseElab) st1 =>
        case rest of
          Nil => Ok (Pair (Cons clauseElab Nil) (Pair ty st1))
          _ =>
            andThen (inferClauses globals rest st1) (\pr =>
              case pr of
                Pair clauseEls (Pair restTy st2) =>
                  andThen (unify ty restTy st2) (\st3 =>
                    Ok (Pair (Cons clauseElab clauseEls) (Pair ty st3)))))

functionNames decls = uniqueNames (map declFunName decls)

declFunName d =
  case d of
    DFun name pats body _ => name
    _ => ""

uniqueNames Nil = Nil
uniqueNames (Cons name rest) =
  if name == "" then uniqueNames rest
  else if memName name rest then uniqueNames rest
  else Cons name (uniqueNames rest)

hasSig name sigs = memName name (map firstOf sigs)

seedPlaceholders Nil sigs st = Pair Nil st
seedPlaceholders (Cons name rest) sigs st =
  if hasSig name sigs then seedPlaceholders rest sigs st
  else
    case freshTy st of
      Pair ty st1 =>
        case seedPlaceholders rest sigs st1 of
          Pair ps st2 => Pair (Cons (Pair name (Scheme Nil ty)) ps) st2

updateScheme name sch env =
  case env of
    Nil => Nil
    Cons (Pair n s) rest =>
      if n == name then Cons (Pair n sch) rest else Cons (Pair n s) (updateScheme name sch rest)

freeVarsEnvExcept name env =
  case env of
    Nil => Nil
    Cons (Pair n sch) rest =>
      if n == name then freeVarsEnvExcept name rest
      else unionInts (freeVarsScheme sch) (freeVarsEnvExcept name rest)

substOf (TC n s typeNames records cons methods tctx) = s

-- 类型错误的源码位置：取函数第一个子句体的 span（诊断）。
funLoc name decls =
  case clausesFor decls name of
    Nil => ""
    Cons (Pair pats body) _ =>
      let sp = exprSpan body
      in if spanStartLine sp == 0 then "" else showSpanLoc sp ++ ": "

checkFunction globals decls sigs name st =
  case lookupScheme name globals of
    Nothing => Err ("missing type signature: " ++ name)
    Just sch =>
      case instantiate st sch of
        Pair expected st1 =>
          case inferClauses globals (clausesFor decls name) st1 of
            Err e => Err (funLoc name decls ++ "in " ++ name ++ ": " ++ e)
            Ok (Pair clauseEls (Pair inferred st2)) =>
              case unify inferred expected st2 of
                Err e => Err (funLoc name decls ++ "in " ++ name ++ ": " ++ e)
                Ok st3 =>
                  andThen
                    (solveRecConstraints (typeNamesOfTC st3) (recordsOf st3) (constraintsOfTC st3) st3)
                    (\st4 =>
                      let elabClauses = lowerClauses (substOf st4) (typeNamesOfTC st4) (recordsOf st4) clauseEls
                      in if hasSig name sigs then Ok (Pair elabClauses (Pair globals st4))
                         else
                           let resolved = resolveTy (substOf st4) inferred
                           in
                             let scheme = Scheme (diffInts (freeVarsTy resolved) (freeVarsEnvExcept name globals)) resolved
                             in Ok (Pair elabClauses (Pair (updateScheme name scheme globals) st4)))

checkFunctions globals decls sigs Nil st elabMap = Ok (Pair (reverse elabMap) (Pair globals st))
checkFunctions globals decls sigs (Cons name rest) st elabMap =
  andThen (checkFunction globals decls sigs name st) (\p =>
    case p of
      Pair clauseEls (Pair globals2 st1) =>
        checkFunctions globals2 decls sigs rest st1 (Cons (Pair name clauseEls) elabMap))

rebuildDecls Nil elabMap = Nil
rebuildDecls (Cons d rest) elabMap =
  case d of
    DFun name pats body sp =>
      case lookupPair name elabMap of
        Just (Cons (Pair pats2 body2) restElab) =>
          Cons (DFun name pats2 body2 sp) (rebuildDecls rest (replaceElab name restElab elabMap))
        _ => Cons d (rebuildDecls rest elabMap)
    _ => Cons d (rebuildDecls rest elabMap)

replaceElab name clauses Nil = Nil
replaceElab name clauses (Cons (Pair n old) rest) =
  if n == name then Cons (Pair n clauses) rest
  else Cons (Pair n old) (replaceElab name clauses rest)

-- M10.5b（trait）实现中：当前先保持记录/旧程序路径不变。
prepareTraits decls = Ok (Pair (TraitCtx Nil Nil) decls)

traitMethodRefs (TraitCtx decls insts) = Nil

checkProgramInfoElab decls0 =
  case prepareTraits decls0 of
    Err e => Err e
    Ok (Pair tctx declsA) =>
      case extractRecords declsA of
        Pair records decls1 =>
          case desugarRecords records decls1 of
            Err e => Err e
            Ok decls2 =>
              case collectData decls2 of
                Pair typeNames dataDecls =>
                  case collectSigs typeNames decls2 (TC 0 Nil typeNames records Nil Nil tctx) of
                    Err e => Err e
                    Ok (Pair sigs st1) =>
                      case collectCtors typeNames decls2 st1 of
                        Err e => Err e
                        Ok (Pair ctors st2) =>
                          case seedPlaceholders (functionNames decls2) sigs st2 of
                            Pair placeholders st3 =>
                              case checkFunctions (append builtinSchemes (append ctors (append sigs placeholders))) decls2 sigs (functionNames decls2) st3 Nil of
                                Err e => Err e
                                Ok (Pair elabMap (Pair globals st4)) =>
                                  Ok (Pair (finalizeGlobals (substOf st4) globals) (rebuildDecls decls2 elabMap))

checkProgramInfo decls =
  andThen (checkProgramInfoElab decls) (\p => Ok (firstOf p))

checkProgram decls =
  andThen (checkProgramInfo decls) (\_ => Ok Nil)

-- ---------------------------------------------------------------
-- 穷尽性 / 冗余诊断（非致命警告；typecheck 成功后单独运行）
-- ---------------------------------------------------------------

exhaustiveWarnings : List Decl -> List String
exhaustiveWarnings decls =
  case checkProgramInfo decls of
    Ok globals => programWarnings globals decls
    Err _ => Nil

programWarnings globals decls =
  concatMap (funWarnings globals decls) (functionNames decls)

funWarnings globals decls name =
  case lookupScheme name globals of
    Nothing => Nil
    Just sch =>
      let clauses = clausesFor decls name
      in let paramTys = flattenFun (schemeTy sch)
         in let bodyWarn = concatMap (clauseBodyWarnings globals decls paramTys) clauses
            in append (funCoverageWarnings decls paramTys clauses) bodyWarn

clauseBodyWarnings globals decls paramTys (Pair pats body) =
  let locals = zipLocals (patsVarNames pats) paramTys
  in exprWarnings globals decls locals body

exprWarnings globals decls locals e =
  case e of
    EVar n sp => Nil
    EInt n sp => Nil
    EStr s sp => Nil
    ELam ps body sp =>
      case inferExpr globals locals (TC 0 Nil Nil Nil Nil Nil (TraitCtx Nil Nil)) e of
        Ok (Pair (Pair ty _) _) =>
          let pty = flattenFun ty
          in exprWarnings globals decls (append (zipLocals ps pty) locals) body
        Err _ => exprWarnings globals decls locals body
    EApp fn args sp => concatMap (exprWarnings globals decls locals) (Cons fn args)
    ELet binds body _ sp =>
      let locals2 = append (letLocals globals locals binds) locals
      in append (concatMap (bindWarnings globals decls) binds) (exprWarnings globals decls locals2 body)
    ECase scrut alts sp =>
      append (caseWarnings globals decls locals scrut alts sp)
            (append (exprWarnings globals decls locals scrut) (concatMap (altWarnings globals decls locals) alts))
    EIf c t e sp => concatMap (exprWarnings globals decls locals) (Cons c (Cons t (Cons e Nil)))

altWarnings globals decls locals (Pair pat body) =
  exprWarnings globals decls locals body

letLocals globals locals Nil = Nil
letLocals globals locals (Cons (Pair pat value) rest) =
  let patTys = patternLocals globals locals pat value
  in append patTys (letLocals globals locals rest)

patternLocals globals locals pat value =
  case inferExpr globals locals (TC 0 Nil Nil Nil Nil Nil (TraitCtx Nil Nil)) value of
    Ok (Pair (Pair ty _) _) => patVarsTy pat ty
    Err _ => Nil

patVarsTy (PVar n _) ty = Cons (Pair n ty) Nil
patVarsTy (PCon _ subpats _) ty = subPatsVarNames subpats ty
patVarsTy _ ty = Nil

subPatsVarNames Nil ty = Nil
subPatsVarNames (Cons p rest) ty = append (patVarsTy p ty) (subPatsVarNames rest ty)

bindWarnings globals decls (Pair pat value) =
  case pat of
    PVar n _ => Nil
    PWild _ => Nil
    _ => Cons (showSpanLoc (patSpan pat) ++ ": non-exhaustive let pattern") Nil

caseWarnings globals decls locals scrut alts sp =
  case inferExpr globals locals (TC 0 Nil Nil Nil Nil Nil (TraitCtx Nil Nil)) scrut of
    Err _ => Nil
    Ok (Pair (Pair ty _) _) =>
      let ctors = tyCtorNames decls ty
      in if ctors == Nil then Nil
         else
           let pats = map firstOf alts
           in let exhaustive = hasCatchAll pats || allCtorsCovered pats ctors
              in let nonEx = if exhaustive then Nil else Cons (showSpanLoc sp ++ ": non-exhaustive case") Nil
                 in append nonEx (redundantWarnings pats)

funCoverageWarnings decls Nil clauses = Nil
funCoverageWarnings decls (Cons ty rest) clauses =
  let posPats = map (clausePatAt 0) clauses
  in let w1 = coverageWarnings decls ty posPats
     in append w1 (funCoverageWarnings decls rest (map dropFirstPat clauses))

clausePatAt i (Pair pats body) = nthOrWild i pats

coverageWarnings decls ty posPats =
  let ctors = tyCtorNames decls ty
  in if ctors == Nil then Nil
     else if posPats == Nil then Nil
     else
       let exhaustive = hasCatchAll posPats || allCtorsCovered posPats ctors
       in let nonEx = if exhaustive then Nil
                      else Cons (showSpanLoc (patSpan (firstPat posPats)) ++ ": non-exhaustive function clauses") Nil
          in append nonEx (redundantWarnings posPats)

firstPat (Cons p rest) = p
firstPat Nil = PWild (Span "" 0 0 0 0)

nthOrWild i Nil = PWild (Span "" 0 0 0 0)
nthOrWild 0 (Cons p rest) = p
nthOrWild i (Cons p rest) = nthOrWild (i - 1) rest

dropFirstPat (Pair pats body) =
  case pats of
    Nil => Pair Nil body
    Cons p pr => Pair pr body

tyCtorNames decls ty =
  case ty of
    TCon name _ => ctorNamesOf decls name
    _ => Nil

ctorNamesOf Nil name = Nil
ctorNamesOf (Cons d rest) name =
  case d of
    DData dn params ctors _ _ =>
      if dn == name then map ctorName ctors else ctorNamesOf rest name
    _ => ctorNamesOf rest name

allCtorsCovered pats Nil = True
allCtorsCovered pats (Cons c rest) =
  if ctorCovered c pats then allCtorsCovered pats rest else False

ctorCovered c Nil = False
ctorCovered c (Cons p rest) =
  if patCoversCtor c p then True else ctorCovered c rest

patCoversCtor c p =
  case p of
    PVar n _ => True
    PWild _ => True
    PCon pn subpats _ => pn == c
    _ => False

hasCatchAll Nil = False
hasCatchAll (Cons p rest) =
  case p of
    PVar n _ => True
    PWild _ => True
    _ => hasCatchAll rest

redundantWarnings pats = redWarn Nil pats

redWarn prefix Nil = Nil
redWarn prefix (Cons p rest) =
  let more = redWarn (append prefix (Cons p Nil)) rest
  in if anySubsumes p prefix then Cons (showSpanLoc (patSpan p) ++ ": redundant pattern") more
     else more

anySubsumes p Nil = False
anySubsumes p (Cons earlier rest) =
  if subsumes earlier p then True else anySubsumes p rest

subsumes earlier p =
  case earlier of
    PVar n _ => True
    PWild _ => True
    PCon en subpats _ =>
      case p of
        PCon pn ps2 _ => en == pn
        _ => False
    _ => False

patsVarNames Nil = Nil
patsVarNames (Cons p rest) = append (patVarNames p) (patsVarNames rest)

patVarNames p =
  case p of
    PVar n _ => Cons n Nil
    PCon _ subpats _ => concatMap patVarNames subpats
    _ => Nil

zipLocals Nil Nil = Nil
zipLocals (Cons n ns) (Cons t ts) = Cons (Pair n t) (zipLocals ns ts)
zipLocals _ _ = Nil

schemeTy (Scheme qs ty) = ty

flattenFun ty =
  case ty of
    TFun a b => Cons a (flattenFun b)
    _ => Nil

collectData decls =
  Pair (declDataNames decls) decls
shortTyName name =
  case splitLastDot (splitOnDot name) of
    Pair rev base => base

sameBuiltinTy a b =
  let sa = shortTyName a
  in (sa == "Bool" || sa == "List") && sa == shortTyName b

finalizeScheme subst (Scheme qs ty) = Scheme qs (resolveTy subst ty)

finalizeGlobals subst globals =
  case globals of
    Nil => Nil
    Cons (Pair name sch) rest =>
      Cons (Pair name (finalizeScheme subst sch)) (finalizeGlobals subst rest)

