module Vuna.Codegen (sanitizeName, ocamlString, generateProgram) where

-- vuna codegen：把 flatten 后的程序生成动态 value 表示的 OCaml。

import Vuna.Base
import Vuna.Ast

joinWith sep Nil = ""
joinWith sep (Cons x Nil) = x
joinWith sep (Cons x rest) = x ++ sep ++ joinWith sep rest

runtimeCode = "\ntype value =\n  | VInt of int\n  | VStr of string\n  | VCon of string * value list\n  | VFun of string * (value -> value)\n\nlet fail (msg : string) : 'a = failwith msg\n\nlet apply (fn : value) (arg : value) : value =\n  match fn with\n  | VFun (_, f) -> f arg\n  | _ -> fail \"cannot apply a non-function\"\n\nlet expect_int (name : string) (v : value) : int =\n  match v with VInt n -> n | _ -> fail (name ^ \": expected an Int argument\")\n\nlet expect_str (name : string) (v : value) : string =\n  match v with VStr s -> s | _ -> fail (name ^ \": expected a String argument\")\n\nlet vbool (b : bool) : value = VCon ((if b then \"True\" else \"False\"), [])\n\nlet expect_bool (name : string) (v : value) : bool =\n  match v with\n  | VCon (\"True\", []) -> true\n  | VCon (\"False\", []) -> false\n  | _ -> fail (name ^ \": expected a Bool argument\")\n\nlet string_to_value (s : string) : value =\n  let n = String.length s in\n  let rec go i acc =\n    if i < 0 then acc\n    else go (i - 1) (VCon (\"Cons\", [ VInt (Char.code s.[i]); acc ]))\n  in\n  go (n - 1) (VCon (\"Nil\", []))\n\nlet value_to_string (v : value) : string =\n  let buf = Buffer.create 16 in\n  let rec go (v : value) =\n    match v with\n    | VCon (\"Nil\", []) -> ()\n    | VCon (\"Cons\", [ VInt c; rest ]) ->\n        if c < 0 || c > 255 then fail \"strPack: character code out of range\";\n        Buffer.add_char buf (Char.chr c);\n        go rest\n    | _ -> fail \"strPack expects a List Int\"\n  in\n  go v;\n  Buffer.contents buf\n\nlet list_of_strings (strings : string list) : value =\n  List.fold_right\n    (fun s acc -> VCon (\"Cons\", [ VStr s; acc ]))\n    strings (VCon (\"Nil\", []))\n\nlet read_file (path : string) : string =\n  try\n    let channel = open_in_bin path in\n    Fun.protect\n      ~finally:(fun () -> close_in_noerr channel)\n      (fun () -> really_input_string channel (in_channel_length channel))\n  with Sys_error message -> fail (\"readFile: \" ^ message)\n\nlet write_file (path : string) (contents : string) : int =\n  try\n    let channel = open_out_bin path in\n    Fun.protect\n      ~finally:(fun () -> close_out_noerr channel)\n      (fun () -> output_string channel contents);\n    String.length contents\n  with Sys_error message -> fail (\"writeFile: \" ^ message)\n\nlet print_stdout (text : string) : int =\n  print_string text;\n  flush stdout;\n  String.length text\n\nlet get_args () : value =\n  let argv = Sys.argv in\n  let count = Array.length argv in\n  let args =\n    if count <= 1 then [] else Array.to_list (Array.sub argv 1 (count - 1))\n  in\n  list_of_strings args\n\nlet bi_add =\n  fun a -> VFun (\"+\", fun b -> VInt (expect_int \"+\" a + expect_int \"+\" b))\n\nlet bi_sub =\n  fun a -> VFun (\"-\", fun b -> VInt (expect_int \"-\" a - expect_int \"-\" b))\n\nlet bi_mul =\n  fun a -> VFun (\"*\", fun b -> VInt (expect_int \"*\" a * expect_int \"*\" b))\n\nlet bi_div =\n  fun a ->\n    VFun\n      ( \"/\",\n        fun b ->\n          let x = expect_int \"/\" a in\n          let y = expect_int \"/\" b in\n          if y = 0 then fail \"division by zero\" else VInt (x / y) )\n\nlet bi_eq =\n  fun a ->\n    VFun\n      ( \"==\",\n        fun b ->\n          match (a, b) with\n          | VInt x, VInt y -> vbool (x = y)\n          | VStr x, VStr y -> vbool (x = y)\n          | _ -> fail \"bad arguments for ==\" )\n\nlet bi_neq =\n  fun a ->\n    VFun\n      ( \"/=\",\n        fun b ->\n          match (a, b) with\n          | VInt x, VInt y -> vbool (x <> y)\n          | VStr x, VStr y -> vbool (x <> y)\n          | _ -> fail \"bad arguments for /=\" )\n\nlet bi_lt =\n  fun a -> VFun (\"<\", fun b -> vbool (expect_int \"<\" a < expect_int \"<\" b))\n\nlet bi_le =\n  fun a -> VFun (\"<=\", fun b -> vbool (expect_int \"<=\" a <= expect_int \"<=\" b))\n\nlet bi_gt =\n  fun a -> VFun (\">\", fun b -> vbool (expect_int \">\" a > expect_int \">\" b))\n\nlet bi_ge =\n  fun a -> VFun (\">=\", fun b -> vbool (expect_int \">=\" a >= expect_int \">=\" b))\n\nlet bi_and =\n  fun a ->\n    VFun\n      (\"&&\", fun b -> vbool (expect_bool \"&&\" a && expect_bool \"&&\" b))\n\nlet bi_or =\n  fun a ->\n    VFun (\"||\", fun b -> vbool (expect_bool \"||\" a || expect_bool \"||\" b))\n\nlet bi_concat =\n  fun a -> VFun (\"++\", fun b -> VStr (expect_str \"++\" a ^ expect_str \"++\" b))\n\nlet bi_str_length = fun a -> VInt (String.length (expect_str \"strLength\" a))\n\nlet bi_str_unpack =\n  fun a -> string_to_value (expect_str \"strUnpack\" a)\n\nlet bi_str_pack = fun a -> VStr (value_to_string a)\n\nlet bi_str_from_int =\n  fun a -> VStr (string_of_int (expect_int \"strFromInt\" a))"

-- ---------------------------------------------------------------
-- 结构性 show（T5b）：main 结果的展示由程序自身的 data 声明生成。
-- 运行时只保留前缀裁剪与字符串转义基础件，不再动用固定的通用展示实现。
-- ---------------------------------------------------------------
showPrelude = "\nlet vuna_short (name : string) : string =\n  match String.rindex_opt name '.' with\n  | Some index -> String.sub name (index + 1) (String.length name - index - 1)\n  | None -> name\n\nlet vuna_quote = String.make 1 (Char.chr 34)\n\nlet vuna_escape (s : string) : string =\n  let buf = Buffer.create (String.length s + 2) in\n  let backslash = String.make 1 (Char.chr 92) in\n  String.iter\n    (fun c ->\n      let code = Char.code c in\n      if code = 34 then (Buffer.add_string buf backslash; Buffer.add_char buf c)\n      else if code = 92 then (Buffer.add_string buf backslash; Buffer.add_char buf c)\n      else if code = 10 then (Buffer.add_string buf backslash; Buffer.add_char buf (Char.chr 110))\n      else if code = 9 then (Buffer.add_string buf backslash; Buffer.add_char buf (Char.chr 116))\n      else if code = 13 then (Buffer.add_string buf backslash; Buffer.add_char buf (Char.chr 114))\n      else if code = 8 then (Buffer.add_string buf backslash; Buffer.add_char buf (Char.chr 98))\n      else if code >= 32 && code <= 126 then Buffer.add_char buf c\n      else (Buffer.add_string buf backslash; Buffer.add_string buf (Printf.sprintf \"%03d\" code)))\n    s;\n  Buffer.contents buf\n"

-- 最后一个点之后的名字：ctor 短名展示与类型名分类共用（模块前缀剥离）。
lastSegment name =
  case splitLastDot (splitOnDot name) of
    Pair before after => after

-- ctor 类型 `A -> B -> T` → 字段类型列表。
splitCtorFields ty =
  case ty of
    EApp (EVar "->" _) (Cons a (Cons rest Nil)) _ => Cons a (splitCtorFields rest)
    _ => Nil

-- 字段声明类型 → OCaml 的 `value -> string` 展示函数表达式。
-- 动态值不带静态类型：每个特化函数都对不匹配的值回退到 vuna_show，
-- 因此任意 tag 组合的展示结果都与旧通用 show 一致。
fieldShowFn ty =
  case ty of
    EVar name _ =>
      if lastSegment name == "Int" then "vuna_show_int"
      else if lastSegment name == "String" then "vuna_show_str"
      else if lastSegment name == "Bool" then "vuna_show_bool"
      else "vuna_show"
    EApp fn args _ =>
      case fn of
        EVar name _ =>
          case args of
            Cons a Nil =>
              if lastSegment name == "List" then "(vuna_show_list " ++ fieldShowFn a ++ ")"
              else "vuna_show"
            _ => "vuna_show"
        _ => "vuna_show"
    _ => "vuna_show"

genFieldShows Nil Nil = Nil
genFieldShows (Cons f fs) (Cons v vs) =
  Cons ("(" ++ fieldShowFn f ++ " " ++ v ++ ")") (genFieldShows fs vs)
genFieldShows _ _ = Nil

ctorShort c = lastSegment (ctorName c)

ctorShowBody short Nil = ocamlString short
ctorShowBody short shows =
  "\"(\" ^ " ++ ocamlString short ++ " ^ \" \" ^ " ++ joinList " ^ \" \" ^ " shows ++ " ^ \")\""

-- 每个 ctor 一个展示函数：按声明字段顺序递归 show，参数形状不符时回退通用展示。
genCtorShow c =
  let short = ctorShort c
  in let fields = splitCtorFields (ctorType c)
     in let vars = makeCtorParams (length fields)
        in let shows = genFieldShows fields vars
           in
             "and vuna_show_ctor_" ++ sanitizeName short ++ " (args : value list) : string =\n"
             ++ "  match args with\n"
             ++ "  | [" ++ joinList "; " vars ++ "] -> "
             ++ ctorShowBody short shows
             ++ "\n  | _ -> vuna_show_con_generic " ++ ocamlString short ++ " args\n"

genCtorArms Nil = ""
genCtorArms (Cons c rest) =
  "  | " ++ ocamlString (ctorShort c) ++ " -> vuna_show_ctor_" ++ sanitizeName (ctorShort c) ++ " args\n"
  ++ genCtorArms rest

genCtorShows Nil = ""
genCtorShows (Cons c rest) = genCtorShow c ++ genCtorShows rest

allDataCtors Nil = Nil
allDataCtors (Cons d rest) =
  case d of
    DData dname params ctors derivings sp => append ctors (allDataCtors rest)
    _ => allDataCtors rest

-- 从 data 声明生成 vuna_show：VCon 按短 ctor 名分派到生成的字段展示函数，
-- 未声明的 tag 回退到通用展示（短名 + 递归字段）。
genShowDefs decls =
  let ctors = allDataCtors decls
  in showPrelude
     ++ "\nlet rec vuna_show (v : value) : string =\n  match v with\n  | VInt n -> string_of_int n\n  | VStr s -> vuna_quote ^ vuna_escape s ^ vuna_quote\n  | VFun (\"\", _) -> \"<lambda>\"\n  | VFun (name, _) -> \"<function \" ^ vuna_short name ^ \">\"\n  | VCon (name, args) -> vuna_show_con (vuna_short name) args\n"
     ++ "\nand vuna_show_con (name : string) (args : value list) : string =\n  match name with\n"
     ++ genCtorArms ctors
     ++ "  | _ -> vuna_show_con_generic name args\n"
     ++ "\nand vuna_show_con_generic (name : string) (args : value list) : string =\n  match args with\n  | [] -> name\n  | _ -> \"(\" ^ name ^ \" \" ^ String.concat \" \" (List.map vuna_show args) ^ \")\"\n"
     ++ "\nand vuna_show_int (v : value) : string =\n  match v with VInt n -> string_of_int n | _ -> vuna_show v\n"
     ++ "\nand vuna_show_str (v : value) : string =\n  match v with VStr s -> vuna_quote ^ vuna_escape s ^ vuna_quote | _ -> vuna_show v\n"
     ++ "\nand vuna_show_bool (v : value) : string =\n  match v with\n  | VCon (\"True\", []) -> \"True\"\n  | VCon (\"False\", []) -> \"False\"\n  | _ -> vuna_show v\n"
     ++ "\nand vuna_show_list (sh : value -> string) (v : value) : string =\n  match v with\n  | VCon (\"Nil\", []) -> \"Nil\"\n  | VCon (\"Cons\", [ x; xs ]) -> \"(Cons \" ^ sh x ^ \" \" ^ vuna_show_list sh xs ^ \")\"\n  | _ -> vuna_show v\n"
     ++ genCtorShows ctors


-- codegen（M6）：flatten 后的程序 → 动态 value 表示的 OCaml
-- ---------------------------------------------------------------

data BuiltinInfo : Type where
  BuiltinInfo : String -> String -> Int -> String -> BuiltinInfo

builtinInfos =
  [ BuiltinInfo "+" "bi_add" 2 "VInt (expect_int \"+\" a + expect_int \"+\" b)"
  , BuiltinInfo "-" "bi_sub" 2 "VInt (expect_int \"-\" a - expect_int \"-\" b)"
  , BuiltinInfo "*" "bi_mul" 2 "VInt (expect_int \"*\" a * expect_int \"*\" b)"
  , BuiltinInfo "/" "bi_div" 2 "let x = expect_int \"/\" a in let y = expect_int \"/\" b in if y = 0 then fail \"division by zero\" else VInt (x / y)"
  , BuiltinInfo "==" "bi_eq" 2 "match (a, b) with VInt x, VInt y -> vbool (x = y) | VStr x, VStr y -> vbool (x = y) | _ -> fail \"bad arguments for ==\""
  , BuiltinInfo "/=" "bi_neq" 2 "match (a, b) with VInt x, VInt y -> vbool (x <> y) | VStr x, VStr y -> vbool (x <> y) | _ -> fail \"bad arguments for /=\""
  , BuiltinInfo "<" "bi_lt" 2 "vbool (expect_int \"<\" a < expect_int \"<\" b)"
  , BuiltinInfo "<=" "bi_le" 2 "vbool (expect_int \"<=\" a <= expect_int \"<=\" b)"
  , BuiltinInfo ">" "bi_gt" 2 "vbool (expect_int \">\" a > expect_int \">\" b)"
  , BuiltinInfo ">=" "bi_ge" 2 "vbool (expect_int \">=\" a >= expect_int \">=\" b)"
  , BuiltinInfo "bi_eq_int" "bi_eq_int" 2 "vbool (expect_int \"==\" a = expect_int \"==\" b)"
  , BuiltinInfo "bi_neq_int" "bi_neq_int" 2 "vbool (expect_int \"/=\" a <> expect_int \"/=\" b)"
  , BuiltinInfo "bi_lt_int" "bi_lt_int" 2 "vbool (expect_int \"<\" a < expect_int \"<\" b)"
  , BuiltinInfo "bi_le_int" "bi_le_int" 2 "vbool (expect_int \"<=\" a <= expect_int \"<=\" b)"
  , BuiltinInfo "bi_gt_int" "bi_gt_int" 2 "vbool (expect_int \">\" a > expect_int \">\" b)"
  , BuiltinInfo "bi_ge_int" "bi_ge_int" 2 "vbool (expect_int \">=\" a >= expect_int \">=\" b)"
  , BuiltinInfo "bi_eq_str" "bi_eq_str" 2 "vbool (expect_str \"==\" a = expect_str \"==\" b)"
  , BuiltinInfo "bi_neq_str" "bi_neq_str" 2 "vbool (expect_str \"/=\" a <> expect_str \"/=\" b)"
  , BuiltinInfo "bi_eq_bool" "bi_eq_bool" 2 "vbool (expect_bool \"==\" a = expect_bool \"==\" b)"
  , BuiltinInfo "bi_neq_bool" "bi_neq_bool" 2 "vbool (expect_bool \"/=\" a <> expect_bool \"/=\" b)"
  , BuiltinInfo "&&" "bi_and" 2 "vbool (expect_bool \"&&\" a && expect_bool \"&&\" b)"
  , BuiltinInfo "||" "bi_or" 2 "vbool (expect_bool \"||\" a || expect_bool \"||\" b)"
  , BuiltinInfo "++" "bi_concat" 2 "VStr (expect_str \"++\" a ^ expect_str \"++\" b)"
  , BuiltinInfo "strLength" "bi_str_length" 1 "VInt (String.length (expect_str \"strLength\" a))"
  , BuiltinInfo "strUnpack" "bi_str_unpack" 1 "string_to_value (expect_str \"strUnpack\" a)"
  , BuiltinInfo "strPack" "bi_str_pack" 1 "VStr (value_to_string a)"
  , BuiltinInfo "strFromInt" "bi_str_from_int" 1 "VStr (string_of_int (expect_int \"strFromInt\" a))"
  , BuiltinInfo "readFile" "bi_read_file" 1 "VStr (read_file (expect_str \"readFile\" a))"
  , BuiltinInfo "writeFile" "bi_write_file" 2 "VInt (write_file (expect_str \"writeFile\" a) (expect_str \"writeFile\" b))"
  , BuiltinInfo "print" "bi_print" 1 "let text = expect_str \"print\" a in VInt (print_stdout text)"
  , BuiltinInfo "getArgs" "bi_get_args" 0 "get_args ()"
  , BuiltinInfo "fileExists" "bi_file_exists" 1 "vbool (Sys.file_exists (expect_str \"fileExists\" a))"
  , BuiltinInfo "exit" "bi_exit" 1 "exit (expect_int \"exit\" a)"
  ]

findBuiltin name Nil = Nothing
findBuiltin name (Cons (BuiltinInfo vname ocname arity body) rest) =
  if vname == name then Just (BuiltinInfo vname ocname arity body) else findBuiltin name rest

joinList sep Nil = ""
joinList sep (Cons x Nil) = x
joinList sep (Cons x rest) = x ++ sep ++ joinList sep rest

headOf Nil = ""
headOf (Cons x rest) = x

nthList n Nil = ""
nthList n (Cons x rest) = if n == 0 then x else nthList (n - 1) rest

sanitizeChar c =
  if c == 46 then Cons 95 (Cons 100 Nil)
  else if c == 95 then Cons 95 (Cons 117 Nil)
  else if c == 39 then Cons 95 (Cons 112 Nil)
  else Cons c Nil

sanitizeName name = strPack (concatMap sanitizeChar (strUnpack name))

pad3 s =
  if strLength s == 1 then "00" ++ s
  else if strLength s == 2 then "0" ++ s
  else s

escapeChar c =
  if c == 34 then Cons 92 (Cons 34 Nil)
  else if c == 92 then Cons 92 (Cons 92 Nil)
  else if c == 10 then Cons 92 (Cons 110 Nil)
  else if c == 9 then Cons 92 (Cons 116 Nil)
  else if c == 13 then Cons 92 (Cons 114 Nil)
  else if c >= 32 && c <= 126 then Cons c Nil
  else strUnpack ("\\" ++ pad3 (strFromInt c))

ocamlString s = "\"" ++ strPack (concatMap escapeChar (strUnpack s)) ++ "\""

genVar decls scope name =
  if memName name scope then Ok ("x_" ++ sanitizeName name)
  else
    case funArity name decls of
      Just 0 => Ok ("v_" ++ sanitizeName name ++ " ()")
      Just arity =>
        Ok ("VFun (" ++ ocamlString name ++ ", v_" ++ sanitizeName name ++ ")")
      Nothing =>
        case ctorArity name decls of
          Just 0 => Ok ("VCon (" ++ ocamlString name ++ ", [])")
          Just arity =>
            Ok
              ("VFun (" ++ ocamlString name ++ ", mk_" ++ sanitizeName name
             ++ ")")
          Nothing =>
            case findBuiltin name builtinInfos of
              Just (BuiltinInfo vname ocname arity body) =>
                if arity == 0 then Ok (ocname ++ " ()")
                else Ok ("VFun (" ++ ocamlString name ++ ", " ++ ocname ++ ")")
              Nothing => Err ("unbound variable: " ++ name)

pconPattern name Nil = "VCon (" ++ ocamlString name ++ ", [])"
pconPattern name pats =
  "VCon (" ++ ocamlString name ++ ", [" ++ joinList "; " pats ++ "])"

genPattern pat =
  case pat of
    PWild _ => Ok (Pair "_" Nil)
    PVar name _ => Ok (Pair ("x_" ++ sanitizeName name) (Cons name Nil))
    PInt n _ => Ok (Pair ("VInt (" ++ strFromInt n ++ ")") Nil)
    PStr s _ => Ok (Pair ("VStr " ++ ocamlString s) Nil)
    PCon name pats _ =>
      andThen (traverse genPattern pats) (\parts =>
        Ok
          (Pair (pconPattern name (map firstOf parts))
             (concatMap secondOf parts)))

genLambda decls scope params body =
  case params of
    Nil => genExpr decls scope body
    Cons p rest =>
      andThen (genLambda decls (Cons p scope) rest body) (\inner =>
        Ok ("VFun (\"\", fun x_" ++ sanitizeName p ++ " -> " ++ inner ++ ")"))

genAlt decls scope (Pair pat body) =
  andThen (genPattern pat) (\p =>
    case p of
      Pair patCode bound =>
        andThen (genExpr decls (append bound scope) body) (\bodyCode =>
          Ok ("| " ++ patCode ++ " -> " ++ bodyCode)))

genCase decls scope scrut alts =
  andThen (genExpr decls scope scrut) (\scrutCode =>
    andThen (traverse (genAlt decls scope) alts) (\branches =>
      Ok
        ("(match (" ++ scrutCode ++ ") with\n    "
        ++ joinList "\n    " branches
        ++ "\n    | _ -> fail \"case pattern match failure\")")))

genLet decls scope rec_ binds body =
  if rec_ then genRecLet decls scope binds body
  else genLetSeq decls scope binds body

genLetSeq decls scope binds body =
  case binds of
    Nil => genExpr decls scope body
    Cons (Pair pat value) rest =>
      andThen (genExpr decls scope value) (\valueCode =>
        andThen (genPattern pat) (\p =>
          case p of
            Pair patCode bound =>
              andThen (genLetSeq decls (append bound scope) rest body) (\bodyCode =>
                Ok
                  ("(let " ++ patCode ++ " = (" ++ valueCode ++ ") in "
                  ++ bodyCode ++ ")"))))

-- 递归 let（where 块）：`let rec x_<n> = ... and ... in body`。
genRecLet decls scope binds body =
  andThen (genRecDefs decls (append (recBindNames binds) scope) binds) (\defs =>
    andThen (genExpr decls (append (recBindNames binds) scope) body) (\b =>
      Ok ("(let rec " ++ joinWith " and " defs ++ " in " ++ b ++ ")")))

recBindNames Nil = Nil
recBindNames (Cons (Pair (PVar name _) _) rest) = Cons name (recBindNames rest)
recBindNames (Cons (Pair _ _) _) = Nil

genRecDefs decls scope Nil = Ok Nil
genRecDefs decls scope (Cons (Pair (PVar name _) value) rest) =
  andThen (genExpr decls scope value) (\v =>
    andThen (genRecDefs decls scope rest) (\tail =>
      Ok (Cons ("x_" ++ sanitizeName name ++ " = " ++ v) tail)))
genRecDefs decls scope (Cons (Pair _ _) _) = Err "recursive let bindings must be simple names"

cgApplyFold acc Nil = acc
cgApplyFold acc (Cons a rest) =
  cgApplyFold ("(apply (" ++ acc ++ ") (" ++ a ++ "))") rest

genApply decls scope fn args =
  andThen (genExpr decls scope fn) (\fnCode =>
    andThen (traverse (\a => genExpr decls scope a) args) (\argCodes =>
      Ok (cgApplyFold fnCode argCodes)))

-- `&&` / `||` 短路：生成的 OCaml 先绑定左操作数，只按需在分支内求值右操作数。
-- 临时名带 `'`，vuna 源标识符经 sanitizeName 不会产生 `'`，因此不会捕获。
genAndShort decls scope a b =
  andThen (genExpr decls scope a) (\ac =>
    andThen (genExpr decls scope b) (\bc =>
      Ok
        ("(let vuna_and' = (" ++ ac
        ++ ") in (match vuna_and' with VCon (\"True\", []) -> (match (" ++ bc
        ++ ") with VCon (\"True\", []) -> VCon (\"True\", [])"
        ++ " | VCon (\"False\", []) -> VCon (\"False\", [])"
        ++ " | _ -> fail \"expected a Bool\")"
        ++ " | VCon (\"False\", []) -> VCon (\"False\", [])"
        ++ " | _ -> fail \"expected a Bool\"))")))

genOrShort decls scope a b =
  andThen (genExpr decls scope a) (\ac =>
    andThen (genExpr decls scope b) (\bc =>
      Ok
        ("(let vuna_or' = (" ++ ac
        ++ ") in (match vuna_or' with VCon (\"True\", []) -> VCon (\"True\", [])"
        ++ " | VCon (\"False\", []) -> (match (" ++ bc
        ++ ") with VCon (\"True\", []) -> VCon (\"True\", [])"
        ++ " | VCon (\"False\", []) -> VCon (\"False\", [])"
        ++ " | _ -> fail \"expected a Bool\")"
        ++ " | _ -> fail \"expected a Bool\"))")))

genEApp decls scope fn args =
  case fn of
    EVar "&&" _ =>
      case args of
        Cons a (Cons b Nil) => genAndShort decls scope a b
        _ => genApply decls scope fn args
    EVar "||" _ =>
      case args of
        Cons a (Cons b Nil) => genOrShort decls scope a b
        _ => genApply decls scope fn args
    _ => genApply decls scope fn args

genExpr decls scope expr =
  case expr of
    EVar name _ => genVar decls scope name
    EInt n _ => Ok ("VInt (" ++ strFromInt n ++ ")")
    EStr s _ => Ok ("VStr " ++ ocamlString s)
    ELam params body _ => genLambda decls scope params body
    EApp fn args _ => genEApp decls scope fn args
    ELet binds body rec_ _ => genLet decls scope rec_ binds body
    ECase scrut alts _ => genCase decls scope scrut alts
    EIf c t e _ =>
      andThen (genExpr decls scope c) (\cc =>
        andThen (genExpr decls scope t) (\tc =>
          andThen (genExpr decls scope e) (\ec =>
            Ok
              ("(match (" ++ cc
              ++ ") with VCon (\"True\", []) -> " ++ tc
              ++ " | VCon (\"False\", []) -> " ++ ec
              ++ " | _ -> fail \"if condition is not a Bool\")"))))

groupFunctions decls = groupFunctionsLoop decls Nil

groupFunctionsLoop Nil groups = groups
groupFunctionsLoop (Cons d rest) groups =
  case d of
    DFun name pats body _ =>
      groupFunctionsLoop rest (addClause name (Pair pats body) groups)
    _ => groupFunctionsLoop rest groups

addClause name clause Nil = Cons (Pair name (Cons clause Nil)) Nil
addClause name clause (Cons (Pair gname clauses) rest) =
  if gname == name then
    Cons (Pair gname (append clauses (Cons clause Nil))) rest
  else Cons (Pair gname clauses) (addClause name clause rest)

arityOf name Nil = Err ("function " ++ name ++ " has no clauses")
arityOf name (Cons (Pair pats body) rest) = checkArities name (length pats) rest

checkArities name expected Nil = Ok expected
checkArities name expected (Cons (Pair pats body) rest) =
  if length pats == expected then checkArities name expected rest
  else Err ("clauses for " ++ name ++ " have different arities")

ctorPairs Nil = Nil
ctorPairs (Cons c rest) =
  Cons (Pair (ctorName c) (ctorArityOf c)) (ctorPairs rest)

allCtors Nil = Nil
allCtors (Cons d rest) =
  case d of
    DData dname params ctors _ _ => append (ctorPairs ctors) (allCtors rest)
    _ => allCtors rest

validateCtors Nil = Ok Nil
validateCtors (Cons (Pair name arity) rest) =
  if memName name (map firstOf rest) then
    Err ("duplicate constructor: " ++ name)
  else validateCtors rest

checkNoCtorFun Nil decls = Ok Nil
checkNoCtorFun (Cons (Pair name clauses) rest) decls =
  case ctorArity name decls of
    Just arity =>
      Err ("name is both a constructor and a function: " ++ name)
    Nothing => checkNoCtorFun rest decls

makeParams n = makeParamsFrom 1 n

makeParamsFrom i n =
  if i > n then Nil
  else Cons ("a" ++ strFromInt i) (makeParamsFrom (i + 1) n)

makeCtorParams n = makeCtorParamsFrom 1 n

makeCtorParamsFrom i n =
  if i > n then Nil
  else Cons ("c" ++ strFromInt i) (makeCtorParamsFrom (i + 1) n)

genBranches decls arity Nil = Ok Nil
genBranches decls arity (Cons (Pair pats body) rest) =
  andThen (traverse genPattern pats) (\parts =>
    let patternCode = if arity == 1 then headOf (map firstOf parts) else "(" ++ joinList ", " (map firstOf parts) ++ ")"
    in andThen (genExpr decls (concatMap secondOf parts) body) (\b =>
         andThen (genBranches decls arity rest) (\restBranches =>
           Ok (Cons ("| " ++ patternCode ++ " -> " ++ b) restBranches))))

genFunction decls name clauses =
  andThen (arityOf name clauses) (\arity =>
    case clauses of
      Nil => Err ("function " ++ name ++ " has no clauses")
      Cons (Pair pats body) _ =>
        if arity == 0 then
          andThen (genExpr decls Nil body) (\b =>
            Ok ("(fun () -> " ++ b ++ ")"))
        else
          let params = makeParams arity in
          let scrutinee = if arity == 1 then headOf params else "(" ++ joinList ", " params ++ ")"
          in andThen (genBranches decls arity clauses) (\branches =>
               let matchCode = "(match (" ++ scrutinee ++ ") with\n    " ++ joinList "\n    " branches ++ "\n    | _ -> fail \"no matching clause for " ++ name ++ "\")"
               in Ok (wrapFun name params matchCode 0)))

wrapFun name params matchCode k =
  if k == length params - 1 then
    "(fun " ++ nthList k params ++ " -> " ++ matchCode ++ ")"
  else
    "(fun " ++ nthList k params ++ " -> VFun (" ++ ocamlString name ++ ", "
    ++ wrapFun name params matchCode (k + 1) ++ "))"

genCtor (Pair name arity) =
  if arity == 0 then Ok ""
  else
    let params = makeCtorParams arity in
    let body = "VCon (" ++ ocamlString name ++ ", [" ++ joinList "; " params ++ "])"
    in Ok
         ("let mk_" ++ sanitizeName name ++ " = "
         ++ wrapCtor name params body 0 ++ "\n")

wrapCtor name params body k =
  if k == length params - 1 then
    "(fun " ++ nthList k params ++ " -> " ++ body ++ ")"
  else
    "(fun " ++ nthList k params ++ " -> VFun (" ++ ocamlString name ++ ", "
    ++ wrapCtor name params body (k + 1) ++ "))"

genCtorDefs Nil = Ok ""
genCtorDefs (Cons c rest) =
  andThen (genCtor c) (\def =>
    andThen (genCtorDefs rest) (\restDefs => Ok (def ++ restDefs)))

genBuiltinDef Nil = ""
genBuiltinDef (Cons (BuiltinInfo vname ocname arity body) rest) =
  let def = if arity == 0 then "let " ++ ocname ++ " = fun () -> " ++ body ++ "\n" else if arity == 1 then "let " ++ ocname ++ " = fun a -> " ++ body ++ "\n" else "let " ++ ocname ++ " = fun a -> VFun (" ++ ocamlString vname ++ ", fun b -> " ++ body ++ ")\n"
  in def ++ genBuiltinDef rest

genFunctions decls Nil = Ok Nil
genFunctions decls (Cons (Pair name clauses) rest) =
  andThen (genFunction decls name clauses) (\def =>
    andThen (genFunctions decls rest) (\defs =>
      Ok (Cons (Pair name def) defs)))

renderRecsFrom Nil index = ""
renderRecsFrom (Cons f rest) index =
  let prefix = if index == 0 then "let rec " else "and "
  in prefix ++ "v_" ++ sanitizeName (firstOf f) ++ " = " ++ secondOf f
     ++ "\n" ++ renderRecsFrom rest (index + 1)

generateProgram decls printResult =
  case allCtors decls of
    ctors =>
      andThen (validateCtors ctors) (\_ =>
        andThen (checkNoCtorFun (groupFunctions decls) decls) (\_ =>
          case funArity "main" decls of
            Just 0 =>
              andThen (genFunctions decls (groupFunctions decls)) (\defs =>
                andThen (genCtorDefs ctors) (\ctorDefs =>
                  Ok
                    (runtimeCode ++ ctorDefs ++ genBuiltinDef builtinInfos
                    ++ genShowDefs decls
                    ++ renderRecsFrom defs 0
                    ++ (if printResult then
                          "let () = print_endline (vuna_show (v_main ()))\n"
                        else "let () = ignore (v_main ())\n"))))
            Just arity => Err "`main` must be a nullary definition"
            Nothing => Err "no `main` definition"))
