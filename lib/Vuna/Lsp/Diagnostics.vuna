module Vuna.Lsp.Diagnostics
  ( DiagCache
  , contextForDoc
  , diagReportJson
  , diagnosticsForCached
  , diagnosticsForSuggestions
  , findingDiagJson
  , publishDiagnosticsCached
  , publishDiagnosticsEmpty
  , publishDiagnosticsFor
  ) where

-- Vuna.Lsp.Diagnostics：LSP 诊断链（工具链模块，**永不进 seed 闭包**）。
--
-- 策略（M30 起走包上下文，不再「含 import 就跳过」）：
--   1. 解析失败 ⇒ 一条带位置的 parse 诊断；
--   2. 有 `module` 头 ⇒ 模块源码路径，无头 ⇒ 入口语义；DT 精化错误按
--      `<file>:<line>:<col>` 转 LSP 0-based；
--   3. 依赖文件（spanFile 不是当前文件）的错误**过滤掉**——每个打开的文件只发布自己的
--      诊断；没有位置的错误归到当前文件 0:0；
--   4. 合并 `Vuna.Lint.Rules.lintSourceWith` 的语法级 finding（severity 2，code = LN_ 规则码）；
--      lint 重排用**程序级** fixity（`Vuna.FixityEnv`，与 fmt/CLI 同源）。
--
-- 包上下文：file:// URI → 路径 → `contextForFile`；非 file URI（或磁盘上不存在的
-- 路径）退化到 cwd 的 `contextForDir "."`。失败由调用方转成 0:0 的 `pkg: ...` 诊断。
--
-- M34.6（5a/5c）：**会话缓存** + 单文件增量精化。
--   - `DiagCache` 保存一次请求建立的包上下文 / 依赖模块接口 / 本包干净模块 / termAux 预处理
--     / fixity 环境；每个请求先做**惰性校验**（编译器指纹 + 包名 + 闭包源文件与 manifest 的
--     mtime+size，安全窗内回读内容哈希），任一变化就重建（无文件 watcher）；
--   - 校验通过时只精化当前 buffer（同包干净模块 / 依赖包 artifact 从接口预置），并把当前
--     模块的接口写回本包 manifest（buffer == 磁盘时；只写当前模块、保留其他条目、原子写）。
--     这让 LSP-only 会话逐步变热；
--   - 无接口（依赖包还没 check / 本包没有 manifest）时回退全量精化，诊断语义不变。
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Sink
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Driver.Iface
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Packages.Pkg
import Vuna.Files
import Vuna.FixityEnv
import Vuna.Json
import Vuna.Lint.Rules
import Vuna.Lsp.Protocol
import Base.IO.Host

-- DiagnosticSeverity：1 = Error、2 = Warning、3 = Information、4 = Hint
severityError : Int
severityError = 1

severityWarning : Int
severityWarning = 2

-- 诊断
-- ---------------------------------------------------------------
-- LSP 直接消费编译器的 `Diagnostic`（结构化值），不再从文本反解析位置。
-- 列单位：编译器内部 1-based UTF-8 字节；LSP 要求 0-based UTF-16 code units，
-- 这里按 buffer 文本换算（非 ASCII 行的 range 才正确）。
-- 首个 primary 标签的 span。
diagPrimarySpan : List Label -> Maybe Span
diagPrimarySpan [] = Nothing
diagPrimarySpan ((Label sp _ LabelPrimary _) :: rest) = sp
diagPrimarySpan (_ :: rest) = diagPrimarySpan rest

-- 首个 primary 标签的文本。
diagPrimaryText : List Label -> String
diagPrimaryText [] = ""
diagPrimaryText ((Label _ text LabelPrimary _) :: rest) = text
diagPrimaryText (_ :: rest) = diagPrimaryText rest

-- 诊断是否属于当前文件：无位置的诊断归到当前 buffer；依赖文件的诊断不发。
diagOwns : String -> Diagnostic -> Bool
diagOwns label d = case diagPrimarySpan d.diagLabels of
  Nothing => True
  Just sp =>
    if sp.spanFile == "" then True
    else if sp.spanFile == label then True
    else if fileNameOf label /= "" && endsWith "/${fileNameOf label}" sp.spanFile then True else False

-- Severity → LSP 1..4。
lspSeverityOf : Severity -> Int
lspSeverityOf SevError = 1
lspSeverityOf SevWarning = 2
lspSeverityOf SevNote = 3
lspSeverityOf SevHelp = 4

-- 第 n 行文本（1-based）；越界返回空串。
lineTextAt : List String -> Int -> String
lineTextAt [] n = ""
lineTextAt (x :: rest) n = if n <= 1 then x else lineTextAt rest (n - 1)

-- UTF-8 字节列（1-based）→ UTF-16 code unit 列（1-based）。
-- 只数到 byteCol-1 的字节：4 字节序列（>= 0xF0）计 2 个 unit，续字节（0x80..0xBF）计 0。
utf16ColOf : String -> Int -> Int
utf16ColOf lineText byteCol = utf16ColGo (strUnpack lineText) 0 0 (byteCol - 1) + 1

utf16ColGo : List Int -> Int -> Int -> Int -> Int
utf16ColGo [] i units stop = units
utf16ColGo (b :: rest) i units stop =
  if i >= stop then units
  else if b >= 240 then utf16ColGo rest (i + 1) (units + 2) stop
  else if b >= 128 && b < 192 then utf16ColGo rest (i + 1) units stop
  else utf16ColGo rest (i + 1) (units + 1) stop

-- 一个标签的位置转 LSP range（用 buffer 文本换算 UTF-16）。
labelRangeJson : List String -> Span -> Json
labelRangeJson lines sp =
  lspRange (spanStartLine sp) (utf16ColOf (lineTextAt lines (spanStartLine sp)) (spanStartCol sp))
    (spanEndLine sp) (utf16ColOf (lineTextAt lines (spanEndLine sp)) (spanEndCol sp))

-- 次级/上下文标签 → relatedInformation 的一项。
labelRelatedJson : String -> List String -> Label -> List Json
labelRelatedJson label lines (Label Nothing text _ _) = []
labelRelatedJson label lines (Label (Just s) text _ _) =
  if text == "" then []
  else [ JObj [Pair "location" (JObj [Pair "uri" (JStr (pathToUri label)), Pair "range" (labelRangeJson lines s)]), Pair "message" (JStr text)]
  ]

-- 字段 → `data` 数组项（机器消费，不解析散文）。
fieldJson : DiagField -> Json
fieldJson (FieldExpected s) = JObj [Pair "kind" (JStr "expected"), Pair "value" (JStr s)]
fieldJson (FieldFound s) = JObj [Pair "kind" (JStr "found"), Pair "value" (JStr s)]
fieldJson (FieldName s) = JObj [Pair "kind" (JStr "name"), Pair "value" (JStr s)]
fieldJson (FieldCandidates cs) =
  JObj [Pair "kind" (JStr "candidates"), Pair "value" (JArr (map candidateJson cs))]
fieldJson (FieldCall c) =
  JObj
    [Pair "kind" (JStr "call"), Pair "value" (JObj [Pair "callee" (JStr c.callCallee), Pair "arg" (JStr c.callArg), Pair "relation" (JStr c.callRelation)])]
fieldJson (FieldQuantity name declared observed) =
  JObj
    [Pair "kind" (JStr "quantity"), Pair "value" (JObj [Pair "name" (JStr name), Pair "declared" (JNum declared), Pair "observed" (JNum observed)])]
fieldJson (FieldEffect s) = JObj [Pair "kind" (JStr "effect"), Pair "value" (JStr s)]
fieldJson (FieldModule s) = JObj [Pair "kind" (JStr "module"), Pair "value" (JStr s)]
fieldJson (FieldSpan name sp) =
  JObj
    [Pair "kind" (JStr "span"), Pair "name" (JStr name), Pair "value" (JObj [Pair "file" (JStr sp.spanFile), Pair "line" (JNum sp.spanStartLine), Pair "column" (JNum sp.spanStartCol)])]
fieldJson (FieldNote s) = JObj [Pair "kind" (JStr "note"), Pair "value" (JStr s)]

candidateJson : Candidate -> Json
candidateJson c = JObj (append [Pair "text" (JStr c.candidateText)] (append (case c.candidateSpan of
  Nothing => []
  Just sp => [Pair "span" (spanRange sp)]
) (case c.candidateReason of
  Nothing => []
  Just r => [Pair "reason" (JStr r)]
)
)
)

-- 诊断消息 + notes + suggestions（LSP 客户端只显示 message）。
messageWithExtras : Diagnostic -> String
messageWithExtras d =
  let
    notes = map (\n => "note: ${n}") d.diagNotes
    fixes = map suggestionHelp d.diagSuggestions
  in join "\n" (append [d.diagMessage] (append notes fixes))

suggestionHelp : Suggestion -> String
suggestionHelp s = "help: ${s.suggestionTitle}"

-- 一条结构化诊断 → LSP Diagnostic JSON。
diagnosticJson : String -> List String -> Diagnostic -> Json
diagnosticJson label lines d =
  let
    range = case diagPrimarySpan d.diagLabels of
      Nothing => lspRange 0 0 0 0
      Just sp => labelRangeJson lines sp
    related = concatMap (labelRelatedJson label lines) d.diagLabels
    fieldData = append (map fieldJson d.diagFields) (originFields d)
    base =
      [ Pair "range" range,
        Pair "severity" (JNum (lspSeverityOf d.diagSeverity)),
        Pair "source" (JStr "vuna"),
        Pair "message" (JStr (messageWithExtras d))
      ]
    withCode = if d.diagCode == "" then base else append base [Pair "code" (JStr d.diagCode)]
    tags = lspTagsOf d.diagCode
    withTags = if length tags == 0 then withCode else append withCode [Pair "tags" (JArr tags)]
    withRelated =
      if length related == 0 then withTags
      else append withTags [Pair "relatedInformation" (JArr related)]
    withData =
      if length fieldData == 0 then withRelated
      else append withRelated [Pair "data" (JArr fieldData)]
  in JObj withData

-- 包上下文：file:// URI → 路径 → `contextForFile`；非 file URI（或磁盘上不存在的
-- 路径）退化到 cwd 的 `contextForDir "."`。失败由调用方转成 0:0 的 `pkg: ...` 诊断。
contextForDoc : String -> Check (Pair String PackageContext)
contextForDoc uri =
  let
    path = decodeUri uri
  in if path == "" then fmap (\ctx => Pair "" ctx) (contextForDir ".")
  else if pathExistsFile path then fmap (\ctx => Pair path ctx) (contextForFile path)
  else fmap (\ctx => Pair path ctx) (contextForDir ".")

-- ---------------------------------------------------------------
-- 会话缓存（M34.6 5c）
-- ---------------------------------------------------------------
-- 缓存项只在「编译器指纹 / 包名 / 闭包源文件与 manifest 的 stat 全部未变」时复用；
-- 外部改任意依赖文件后下一次请求必然失败校验并重建（无 watcher）。
record DiagCache where
  dcLabel : String
  dcKey : Int
  dcCtx : PackageContext
  dcTool : Maybe ToolContext
  dcClean : List ModuleIface
  dcBuiltSec : Int
  dcStats : List SourceInfo
  dcAux : Maybe AuxCache
  dcFix : FixityEnv

-- 缓存 key：编译器二进制指纹 + 包名（包上下文/依赖图变化由 stats 面兜住）。
ctxKeyOf : PackageContext -> Int
ctxKeyOf ctx = toolCompilerFingerprint * 1000003 + hashTextStrong "lsp|${contextPackageName ctx}"

-- 本包模块名集合（来自 manifest）。
ownNamesOfTool : ToolContext -> List String
ownNamesOfTool tool = case tool.tcOwnManifest of
  Just mf => map meNameOfEntry (pmModulesOf mf)
  Nothing => []

-- buffer 当前 import 闭包里的「本包模块名」子集（增量路径只预置这些干净模块）。
ownNeededOf : ToolContext -> List String -> List String
ownNeededOf tool needed =
  let
    ownNames = ownNamesOfTool tool
  in filter (\n => memName n ownNames) needed

-- needed ⊆ 会话建立时的闭包吗？buffer 引入新 import 时闭包会变大，必须重建会话。
neededInClosure : List String -> List String -> Bool
neededInClosure closure [] = True
neededInClosure closure (n :: rest) = memName n closure && neededInClosure closure rest

-- 缓存校验：key / label / 全部源文件与 manifest 的 stat 面。
cacheFresh : Maybe DiagCache -> String -> PackageContext -> Bool
cacheFresh Nothing label ctx = False
cacheFresh (Just c) label ctx =
  c.dcLabel == label && c.dcKey == ctxKeyOf ctx && toolSessionFresh c.dcBuiltSec c.dcStats

-- 建立会话：工具接口（依赖闭包 / 依赖哈希 / 本包 manifest）+ 本包干净模块 + 校验面。
-- 返回 Nothing = 当前没有可校验的工具接口（每请求走全量）。
buildSession : PackageContext -> String -> String -> Maybe String -> Maybe DiagCache
buildSession ctx label text modName = case depIfacesForToolSourceDetailed ctx label text of
  Nothing => Nothing
  Just tool =>
    let
      builtSec = toolNowSec
      ownNeeded = ownNeededOf tool tool.tcNeeded
      clean = toolCleanOwnModules ctx tool builtSec modName ownNeeded
      stats = append tool.tcStats [sourceInfoForPath "${contextDir ctx}/vuna.toml"]
    in Just
      (DiagCache label (ctxKeyOf ctx) ctx (Just tool) clean builtSec stats Nothing emptyFixityEnv)

-- 会话里的工具接口可用且闭包未扩大 ⇒ 直接复用；否则（一次）重建。
usableSession : Maybe DiagCache -> PackageContext -> String -> String -> Maybe String -> List Import -> Maybe DiagCache
usableSession cache ctx label text modName imports =
  let
    health = case cache of
      Just c =>
        if cacheFresh (Just c) label ctx then sessionClosureOk c ctx modName imports else Nothing
      Nothing => Nothing
  in case health of
    Just c => Just c
    Nothing => buildSession ctx label text modName

sessionClosureOk : DiagCache -> PackageContext -> Maybe String -> List Import -> Maybe DiagCache
sessionClosureOk c ctx modName imports = case c.dcTool of
  Nothing => Just c
  Just tool =>
    let
      needed = toolNeededOfImports ctx tool (currentNameOf modName) imports
    in if neededInClosure tool.tcNeeded needed then Just c else Nothing

currentNameOf : Maybe String -> String
currentNameOf Nothing = ""
currentNameOf (Just n) = n

-- ---------------------------------------------------------------
-- 精化 + 写回
-- ---------------------------------------------------------------
diagsOfCheck : String -> Check (List Diagnostic) -> List Diagnostic
diagsOfCheck label (OkC _) = []
diagsOfCheck label (ErrC e) = if diagOwns label e then [e] else []

-- buffer == 磁盘吗？单模块写回的前置条件（否则写下的 SourceInfo 与磁盘不符，读侧会判脏）。
diskMatches : String -> String -> Bool
diskMatches label text =
  if runIO (prim_fileExists label) == False then False
  else toolTextHash (runIO (prim_readFile label)) == toolTextHash text

isCleanModule : DiagCache -> String -> Bool
isCleanModule session name = memName name (map miNameOf session.dcClean)

-- Maybe Int 与「当前磁盘内容哈希」相等吗（无条目 = 需要写）。
entryHashMatches : Maybe Int -> Int -> Bool
entryHashMatches Nothing _ = False
entryHashMatches (Just h) x = h == x

-- 单文件增量精化（会话可用）：依赖接口 + 本包干净模块预置，只精化当前 buffer。
-- 安全阀说「不适用」（Nothing）时回退全量。
checkIncremental : DiagCache -> String -> String -> Maybe String -> List Import -> Pair (Maybe DiagCache) (List Diagnostic)
checkIncremental session label text modName imports = case session.dcTool of
  Nothing => Pair Nothing []
  Just tool =>
    let
      needed = toolNeededOfImports session.dcCtx tool (currentNameOf modName) imports
      cleanNeeded = filter (\mi => memName (miNameOf mi) (ownNeededOf tool needed)) session.dcClean
      needPkg = case modName of
        Just n => if isCleanModule session n then False else diskMatches label text
        Nothing => False
      checked =
        dtCheckSourceIncremental session.dcCtx label text tool.tcDepIfaces cleanNeeded session.dcAux
          needPkg
    in case checked of
      ErrC e => Pair (Just session) (diagsOfCheck label (ErrC e))
      OkC (Pair applied (Pair maybePkg maybeAux)) => if applied then
        let
          session2 =
            DiagCache session.dcLabel session.dcKey session.dcCtx session.dcTool session.dcClean
              session.dcBuiltSec session.dcStats maybeAux session.dcFix
        in case maybePkg of
          Nothing => Pair (Just session2) []
          Just checkedPkg => Pair (Just (writeBackModule session2 label text checkedPkg modName)) []
      else Pair Nothing []

-- 上下文的精简入口（`dtCheckSourceChecked` 需要 ctx）。
checkFullWith : Maybe DiagCache -> PackageContext -> String -> String -> Maybe String -> Pair (Maybe DiagCache) (List Diagnostic)
checkFullWith cache ctx label text modName = case dtCheckSourceChecked ctx label text of
  ErrC e => Pair cache (diagsOfCheck label (ErrC e))
  OkC (Pair _ checkedPkg) =>
    let
      session = case cache of
        Just c => c
        Nothing =>
          DiagCache label (ctxKeyOf ctx) ctx Nothing [] toolNowSec [] Nothing emptyFixityEnv
      session2 = writeBackModule session label text checkedPkg modName
      keep = case cache of
        Just _ => Just session2
        Nothing => Nothing
    in Pair keep []

-- ---------------------------------------------------------------
-- lint（会话复用 fixity 模块图；外部文件变化会随会话重建清空）
-- ---------------------------------------------------------------
lintWithEnv : FixityEnv -> String -> String -> Pair FixityEnv (List Diagnostic)
lintWithEnv env label text = case fixitiesForFile env label text of
  Pair env2 (ErrC _) => Pair env2 []
  Pair env2 (OkC fx) => Pair env2 (case lintSourceWith fx text of
    ErrC _ => []
    OkC findings => map findingToDiagnostic findings
  )

-- lint finding 与编译器诊断共用同一个 `Diagnostic` 模型（phase = Tool，category = Tool）。
findingToDiagnostic : Finding -> Diagnostic
findingToDiagnostic f =
  diagAt (Span "" f.findingLine f.findingCol f.findingLine (f.findingCol + 1)) SevWarning PhTool
    CatTool f.findingCode f.findingMessage

-- 单个 lint finding 的 Diagnostic JSON（codeAction 内嵌诊断用）：与 publishDiagnostics
-- 的字段集合一致（range/severity/source/code/message），客户端可按 code 关联。
findingDiagJson : Finding -> Json
findingDiagJson f =
  JObj
    (append [Pair "range" (lspRange f.findingLine f.findingCol f.findingLine (f.findingCol + 1)), Pair "severity" (JNum severityWarning), Pair "source" (JStr "vuna")] (append (if f.findingCode == "" then [] else [Pair "code" (JStr f.findingCode)]) [Pair "message" (JStr f.findingMessage)]))

-- ---------------------------------------------------------------
-- 一次请求的完整诊断链
-- ---------------------------------------------------------------
-- DT 诊断：会话可用时走单文件增量精化，否则回退全量（诊断语义不变）。
checkDiagnostics : Maybe DiagCache -> String -> PackageContext -> String -> Maybe String -> List Import -> Pair (Maybe DiagCache) (List Diagnostic)
checkDiagnostics cache label ctx text modName imports =
  let
    session = usableSession cache ctx label text modName imports
  in case session of
    Nothing => checkFullWith cache ctx label text modName
    Just s =>
      let
        inc = checkIncremental s label text modName imports
      in case firstOf inc of
        Just s2 => Pair (Just s2) (secondOf inc)
        Nothing => checkFullWith (Just s) ctx label text modName

diagnosticsForCached : Maybe DiagCache -> String -> String -> Pair (Maybe DiagCache) (Pair String (List Diagnostic))
diagnosticsForCached = diagnosticsForCachedWith False

-- 代码动作路径：包含 `UN_UnusedImport`（编辑器侧虽不回放其诊断，但仍可给出删除 import 的修复）。
diagnosticsForSuggestions : Maybe DiagCache -> String -> String -> Pair (Maybe DiagCache) (Pair String (List Diagnostic))
diagnosticsForSuggestions = diagnosticsForCachedWith True

diagnosticsForCachedWith : Bool -> Maybe DiagCache -> String -> String -> Pair (Maybe DiagCache) (Pair String (List Diagnostic))
diagnosticsForCachedWith includeUnused cache uri text = case contextForDoc uri of
  ErrC e => Pair cache (Pair "" [e])
  OkC (Pair label ctx) => case parseSource label text of
    ErrC e => Pair cache (Pair label [e])
    OkC (SourceFile hdr imports fixities decls) =>
      let
        modName = case hdr of
          Just (ModDecl n hasList items sp) => Just n
          Nothing => Nothing
        checked = checkDiagnostics cache label ctx text modName imports
        cache2 = firstOf checked
        linted = case cache2 of
          Just c => lintWithEnv c.dcFix label text
          Nothing => lintWithEnv emptyFixityEnv label text
        cache3 = case cache2 of
          Just c =>
            Just
              (DiagCache c.dcLabel c.dcKey c.dcCtx c.dcTool c.dcClean c.dcBuiltSec c.dcStats c.dcAux (firstOf linted))
          Nothing => Nothing
      in Pair cache3
        (Pair label (append (secondOf checked) (append (secondOf linted) (filter (diagOwns label) (filter (warnAllowed includeUnused) (takeWarnings 0))))))

publishDiagnostics : String -> Int -> String -> List Diagnostic -> Json
publishDiagnostics uri version text diags =
  let
    lines0 = lines text
    jsonDiags = map (diagnosticJson uri lines0) diags
  in notify "textDocument/publishDiagnostics"
    (JObj [Pair "uri" (JStr uri), Pair "version" (JNum version), Pair "diagnostics" (JArr jsonDiags)])

-- 一次请求的完整发布帧 + 更新后的会话缓存（LSP 门面持有缓存，跨请求复用）。
publishDiagnosticsCached : Maybe DiagCache -> String -> Int -> String -> Pair (Maybe DiagCache) Json
publishDiagnosticsCached cache uri version text =
  let
    result = diagnosticsForCached cache uri text
    labeled = secondOf result
  in Pair (firstOf result) (publishDiagnostics uri version text (secondOf labeled))

-- didClose：直接发空诊断（不跑检查链）。
publishDiagnosticsEmpty : String -> Int -> Json
publishDiagnosticsEmpty uri version = publishDiagnostics uri version "" []

-- 无会话的便捷入口（测试 / 一次性请求）。
publishDiagnosticsFor : String -> Int -> String -> Json
publishDiagnosticsFor uri version text =
  secondOf (publishDiagnosticsCached Nothing uri version text)

-- 写回当前模块接口（buffer == 磁盘时才写；只写当前模块、合并进本包 manifest）。
-- 守卫：本包 manifest 里已有「同源内容」的接口时不重写（LSP 增量上下文算出的接口哈希
-- 可能与整包 check 的略有差异——擦除位残 meta 不同；重写会让依赖者的 miDepHashes 失配）。
-- 冷启动（还没有本包 manifest）才用整包接口兜底写。失败静默跳过（不影响诊断）。
writeBackModule : DiagCache -> String -> String -> CheckedPackage -> Maybe String -> DiagCache
writeBackModule session label text checked Nothing = session
writeBackModule session label text checked (Just name) = if diskMatches label text then
  let
    si = sourceInfoForPath label
    cleanForWrite = filter (\mi => miNameOf mi /= name) session.dcClean
    attempt = case session.dcTool of
      Just tool =>
        if entryHashMatches (toolOwnEntrySourceHash tool name) (siHashOf si) then Nothing
        else Just (toolWriteModuleIface session.dcCtx tool cleanForWrite checked name si)
      Nothing =>
        if toolHasOwnManifest session.dcCtx then Nothing
        else Just (toolWriteModuleIfaceCold session.dcCtx checked name si)
  in case attempt of
    Nothing => session
    Just (ErrC _) => session
    Just (OkC mi) =>
      DiagCache session.dcLabel session.dcKey session.dcCtx session.dcTool (mi :: session.dcClean)
        session.dcBuiltSec session.dcStats session.dcAux session.dcFix
else session

-- 单文件增量精化（会话可用）：依赖接口 + 本包干净模块预置，只精化当前 buffer。
-- ---------------------------------------------------------------
-- Pull diagnostics（LSP 3.17 textDocument/diagnostic）
-- ---------------------------------------------------------------
-- | 一次 pull 的完整报告（kind=full）。items 与 push 的 diagnostics 字段同构。
diagReportJson : String -> String -> List Diagnostic -> Json
diagReportJson uri text diags =
  let
    lines0 = lines text
  in JObj [Pair "kind" (JStr "full"), Pair "items" (JArr (map (diagnosticJson uri lines0) diags))]

-- 告警的 LSP tags：未使用/冗余/不可达 → `1`（Unnecessary）。
lspTagsOf : String -> List Json
lspTagsOf code =
  if startsWith "UN_Unused" code || startsWith "UN_Redundant" code || code == "UN_BranchAfterCatchAll" then [JNum 1]
  else []

-- LSP 增量路径不重算 import 使用集：`UN_UnusedImport` 在编辑器侧可能误报，
-- 故 publish 链路不回放该告警（CLI 全量检查仍报告）。
lspWarnable : Diagnostic -> Bool
lspWarnable d = d.diagCode /= "UN_UnusedImport"

warnAllowed : Bool -> Diagnostic -> Bool
warnAllowed True d = True
warnAllowed False d = lspWarnable d

originFields : Diagnostic -> List Json
originFields d = case d.diagOrigin of
  OriginDirect => []
  OriginCascade _ => [JObj [Pair "kind" (JStr "origin"), Pair "value" (JStr "cascade")]]
