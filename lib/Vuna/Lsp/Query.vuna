module Vuna.Lsp.Query
  ( codeActionsFor
  , completionItems
  , definitionResult
  , documentSymbols
  , fixAllLintCommand
  , fixAllLintWorkspaceEdit
  , formattingEdits
  , holeHoverAt
  , referencesResult
  , symbolHoverResult
  , workspaceRoot
  , workspaceSymbols
  ) where

-- Vuna.Lsp.Query：LSP 各查询方法的实现（工具链模块，**永不进 seed 闭包**）。
--
-- 全是「输入文本/位置/索引 → JSON 结果」的纯查询，不持有服务器状态（状态机在
-- Vuna.Lsp 门面）。依赖方向：Query → Diagnostics → Protocol，单向无环。
--
-- 方法：
--   hover             先 DT 洞目标（`_` / `?name`；文本里无洞 token 时跳过精化；M40 起走
--                     容错查询，未解洞也给目标+上下文），未命中再看 Bindings（模块名/局部
--                     绑定，见 Vuna.Lsp），最后 Index 标识符签名/注释；
--                     range 落在光标 token 上（不是定义位置）；
--   formatting        `Vuna.Fmt.formatSourceWith`（程序级 fixity）成功且内容变化 ⇒ 全文 TextEdit；
--   codeAction        lint finding（可自动修复）→ quick fix TextEdit（内嵌诊断带
--                     range/severity/source/code/message，与 publishDiagnostics 同源）；全文档
--                     fix all 走 `Command`（`vuna.fixAllLint` + workspace/executeCommand）；
--                     光标在洞上时按上下文 data / record binder 生成 `case split on <name>`
--                     （`refactor.rewrite`，C38；构造子解析是 parse 级，见下方 case split 段）；
--   documentSymbol    AST 声明树（data/record/trait 带子节点）；selectionRange 精确落名字；
--   definition        位置 token（支持 `Mod.name`）→ Index 符号 → Location；Index 不可用时
--                     同文件缓冲兜底；
--   references        定义位置 + Index `findReferences` 的出现位置；
--   completion        关键字 + 当前缓冲顶层名 + Index 符号（`.` 后按模块过滤，cap 500）；
--   workspace/symbol  Index 过滤（cap 200），没有 textDocument 时用首个打开文档推断根。
import Vuna.Compiler.Common
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Elab
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.FixityEnv
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Packages.Pkg
import Vuna.Fmt
import Vuna.Index
import Vuna.Json
import Vuna.Lint.Fix
import Vuna.Lint.Rules
import Vuna.Lsp.Bindings
import Vuna.Lsp.Diagnostics
import Vuna.Lsp.Protocol

-- 结果上限：避免病态索引/大文件把单帧撑爆。
maxCompletions : Int
maxCompletions = 500

maxWorkspaceSymbols : Int
maxWorkspaceSymbols = 200

maxReferences : Int
maxReferences = 500

-- codeAction 结果上限：同屏 quick fix 不需要无限长。
maxCodeActions : Int
maxCodeActions = 20

-- 全文范围（格式化用）：0:0 到最后一行的行尾。
fullRange : String -> Json
fullRange text =
  let
    ls = split "\n" text
    endLine = length ls - 1
    endText = case lastElem ls of
      Nothing => ""
      Just x => x
  in lspRange 1 1 (endLine + 1) (strLength endText + 1)

-- ---------------------------------------------------------------
-- 选择范围：尽量指向名字本身，找不到就退回声明起点（`findNamePos` 在 Protocol）。
nameSelRange : List String -> Span -> String -> Json
nameSelRange lines sp name = case findNamePos lines sp name of
  Nothing =>
    lspRange (spanStartLine sp) (spanStartCol sp) (spanStartLine sp)
      (spanStartCol sp + strLength name)
  Just (Pair l c) => lspRange l c l (c + strLength name)

-- ---------------------------------------------------------------
-- hover：DT 洞目标 + 标识符签名
-- ---------------------------------------------------------------
ctxLine : Pair String String -> String
ctxLine kv = "- `${firstOf kv}` : ${secondOf kv}\n"

contextBlock : List (Pair String String) -> String
contextBlock [] = ""
contextBlock ctx = """

Context:
${join "" (map ctxLine ctx)}"""

goalContents : DtGoalInfo -> Json
goalContents g =
  let
    -- M40：命名洞显示 `?name : <目标类型>`；匿名洞保持只显示目标类型（与旧输出一致）。
    label =
      if g.dtGoalInfoName == "" then g.dtGoalInfoGoal
      else "${g.dtGoalInfoName} : ${g.dtGoalInfoGoal}"
  in JObj
    [Pair "kind" (JStr "markdown"), Pair "value" (JStr "```vuna\n${label}\n```\n${contextBlock g.dtGoalInfoCtx}")]

holeContains : Int -> Int -> DtGoalInfo -> Bool
holeContains line col g =
  let
    sp = g.dtGoalInfoSpan
    sl = spanStartLine sp
    sc = spanStartCol sp
    el = spanEndLine sp
    ec = sp.spanEndCol
  in not (line < sl || line > el || line == sl && col < sc || line == el && col > ec)

holeAt : Int -> Int -> List DtGoalInfo -> Maybe DtGoalInfo
holeAt line col [] = Nothing
holeAt line col (g :: rest) = if holeContains line col g then Just g else holeAt line col rest

holeHoverJson : DtGoalInfo -> Json
holeHoverJson g =
  let
    sp = g.dtGoalInfoSpan
  in JObj
    [Pair "contents" (goalContents g), Pair "range" (lspRange (spanStartLine sp) (spanStartCol sp) (spanEndLine sp) sp.spanEndCol)]

symbolHoverBody : Sym -> String
symbolHoverBody s =
  let
    body =
      if symKind s == "fun" then "${symFullName s} : ${symSig s}"
      else if symSig s == "" then symFullName s else symSig s
    doc = if s.symDoc == "" then "" else "\n\n${s.symDoc}"
  in """```vuna
${body}
```${doc}"""

-- hover 的 range 必须是**光标下的 token**，不是符号定义位置：客户端（VS Code）用
-- hover.range 判断 hover 何时失效，鼠标一动到 range 外就收起。返回定义位置会让使用点
-- 的 hover 立刻消失。
symbolHoverJson : Sym -> Int -> Int -> String -> Json
symbolHoverJson s line startCol token =
  JObj
    [Pair "contents" (JObj [Pair "kind" (JStr "markdown"), Pair "value" (JStr (symbolHoverBody s))]), Pair "range" (lspRange line startCol line (startCol + strLength token))]

-- ---------------------------------------------------------------
currentModuleNameOf : String -> String
currentModuleNameOf text = case parseSource "<lsp>" text of
  ErrC e => ""
  OkC (SourceFile hdr imports fx decls) => currentModuleName decls hdr

-- hover 的第一段：DT 洞目标（包上下文；与 `vuna goal` 同源）。
-- 快速判据：文本里没有洞（`_` / `?name`）时直接跳过——否则每次 hover 都要跑一遍
-- 整模块（含 import 闭包）的 DT 精化，大文件上是秒级开销。
-- M40：用 tolerant 查询，**未解洞**也能拿到目标类型与上下文快照。
holeHoverAt : String -> Int -> Int -> String -> Eff [] (Maybe Json)
holeHoverAt uri line col text =
  if hasHole text then holeHoverChecked uri line col text else pure Nothing

holeHoverChecked : String -> Int -> Int -> String -> Eff [] (Maybe Json)
holeHoverChecked uri line col text = do
  ctxR <- contextForDoc uri
  case ctxR of
    ErrC e => pure Nothing
    OkC (Pair label ctx) => do
      gsR <- dtGoalsSourceTolerant ctx label text
      pure (case gsR of
        ErrC e => Nothing
        OkC gs => case holeAt line col gs of
          Nothing => Nothing
          Just g => Just (holeHoverJson g)
      )

-- 洞判定：`_` 是独立 token（左右都不是标识符/限定名的连接字符）；`?name` 是 `?` 紧邻标识符
-- 起始字符（M40）。行首/行尾用哨兵 -1；字符串或注释里的洞字符会误判成「有洞」，只多跑一次
-- 精化，不影响正确性。
holeJoinCode : Int -> Bool
holeJoinCode c =
  c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 46

holeIdentStart : Int -> Bool
holeIdentStart c = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

holeScan : List Int -> Int -> Bool
holeScan [] prev = False
holeScan (c :: rest) prev = case c of
  95 => holeAtUnderscore rest prev
  63 => holeNamedAhead rest
  _ => holeScan rest c

-- `?` 后面紧跟标识符起始字符（同行，无空格）⇒ 命名洞；否则按普通运算符字符继续扫。
holeNamedAhead : List Int -> Bool
holeNamedAhead [] = False
holeNamedAhead (c :: rest) = holeIdentStart c || holeScan rest 63

holeAtUnderscore : List Int -> Int -> Bool
holeAtUnderscore rest prev =
  if holeJoinCode prev then holeScan rest 95
  else if holeJoinNext rest then holeScan rest 95 else True

holeJoinNext : List Int -> Bool
holeJoinNext [] = False
holeJoinNext (c :: rest) = holeJoinCode c

hasHole : String -> Bool
hasHole text = holeScan (strUnpack text) (0 - 1)

-- hover 的第二段：光标标识符的签名/注释（Index；不可用/未命中 → null）。
symbolHoverResult : String -> Int -> Int -> String -> Maybe Index -> Json
symbolHoverResult uri line col text Nothing = JNull
symbolHoverResult uri line col text (Just idx) = case tokenAtCursor text line col of
  Nothing => JNull
  Just (Pair startCol token) => case bestSymbol idx (currentModuleNameOf text) token of
    Nothing => JNull
    Just sym => symbolHoverJson sym line startCol token

-- definition：光标 token → Index 符号 → Location；Index 不可用/未命中时同文件兜底。
definitionResult : String -> Int -> Int -> String -> Maybe Index -> Json
definitionResult uri line col text Nothing =
  bufferDefinition uri text (fromMaybe "" (fmap secondOf (tokenAtCursor text line col)))
definitionResult uri line col text (Just idx) = case tokenAtCursor text line col of
  Nothing => JNull
  Just (Pair startCol token) => case bestSymbol idx (currentModuleNameOf text) token of
    Nothing => bufferDefinition uri text token
    Just sym => case symLocation idx sym of
      Nothing => bufferDefinition uri text token
      Just loc => JArr [loc]

-- references：定义位置 + Index refs 的出现位置。
-- C45：`references` 识别局部名——光标落在局部绑定上时，返回该 binder 在当前文档作用域内的
-- 全部出现位置（定义 + 使用，遮蔽同源，复用 `Vuna.Lsp.Bindings.bindingRenameOccurrences`），
-- 而不是按名字全局匹配（那会把同名顶层符号 / 其它作用域的同名局部混进来）。
-- 局部未命中（顶层符号 / 模块名 / 洞 / 关键字 ⇒ `bindingRenameOccurrences` 返回 Nothing）才回落
-- Index refs。返回扁平 Location 列表（与 `referencesFor` 同结构）。
referencesResult : String -> Int -> Int -> String -> Maybe Index -> List Json
referencesResult uri line col text midx =
  let
    localHits = localRefLocations uri line col text
  in case localHits of
    hit :: _ => localHits
    [] => case tokenAtCursor text line col of
      Nothing => []
      Just (Pair startCol token) => case midx of
        Nothing => []
        Just idx => referencesFor idx (currentModuleNameOf text) token

-- 局部绑定的引用位置（scope-aware）；光标不在局部绑定上返回 []。
localRefLocations : String -> Int -> Int -> String -> List Json
localRefLocations uri line col text = case bindingRenameOccurrences line col text of
  Nothing => []
  Just positions =>
    map (\pos => localRefLocation uri text (firstOf pos) (secondOf pos))
      (take maxReferences positions)

localRefLocation : String -> String -> Int -> Int -> Json
localRefLocation uri text line col =
  let
    width = case tokenAtCursor text line col of
      Nothing => 0
      Just (Pair _ token) => strLength token
  in JObj [Pair "uri" (JStr uri), Pair "range" (lspRange line col line (col + width))]

-- formatting：formatSourceWith 成功且内容有变化 ⇒ 全文 TextEdit；否则 []。
-- M31.3（B27）：fixity 是程序级的——与 CLI 同源，用 `Vuna.FixityEnv`（按文件目录缓存模块图，
-- 声明表逐文件重算 local + import 闭包）。上下文/加载失败或未知运算符 ⇒ 返回空 edits
-- （不让 LSP 请求失败，也不静默改语义）。
formattingEdits : String -> String -> Eff [] (List Json)
formattingEdits uri text = do
  fxR <- formattingFixities uri text
  pure (case fxR of
    ErrC e => []
    OkC fixities => case formatSourceWith fixities text of
      ErrC e => []
      OkC formatted =>
        if formatted == text then []
        else [JObj [Pair "range" (fullRange text), Pair "newText" (JStr formatted)]]
  )

formattingFixities : String -> String -> Eff [] (Check (List FixityDecl))
formattingFixities uri text =
  let
    path = decodeUri uri
  in if path == "" then pure (err "empty document uri")
  else do
    looked <- fixitiesForFile emptyFixityEnv path text
    pure (secondOf looked)

-- ---------------------------------------------------------------
-- codeAction：lint quick fix（M38 P1c）+ fix all 的 Command 形式 + 洞 case split（C38）
-- ---------------------------------------------------------------
-- 与诊断同源：程序级 fixity（`Vuna.FixityEnv`）→ `Vuna.Lint.Rules.lintSourceWith`；
-- 只取**可自动修复**（`findingEdit = Just`）且编辑行范围与请求 range（1-based 行闭区间）
-- 相交的 finding。Edit 的行范围是 1-based 闭区间**整行替换**：
--   LSP range = (editStart - 1, 0) .. (editStop, 0)（末端取下一行行首，不吞掉下一行）；
--   newText = `joinLines editLines`。
-- 另加一条 "fix all lint findings"：`Vuna.Lint.Fix.fixLoop` 跑到收敛（与 CLI `--fix`
-- 同一条路径）；C38 起该动作走 **`Command` 形式**（`vuna.fixAllLint`），客户端执行后由
-- `workspace/executeCommand` → `workspace/applyEdit` 推送整文档替换（见 Vuna.Lsp）。
-- 请求 range 附近没有可修复 finding 时不给 fix all，避免每一行都冒出全文档 fix。
-- 总条数上限 20；fix all 占最后一格，case split 动作排在最前。
--
-- `context.only`（Maybe：Nothing = 客户端不限制、Just [] = 明确不要任何 kind）：
--   - quickfix 动作只在未限制或含 `quickfix` 时给；
--   - case split 动作只在未限制或含 `refactor` / `refactor.rewrite` 时给。
codeActionsFor : String -> String -> Int -> Int -> Int -> Int -> Maybe (List String) -> Eff [] (List Json)
codeActionsFor uri text reqStart reqStartCol reqEnd reqEndCol only = do
  ctxR <- contextForDoc uri
  case ctxR of
    ErrC e => pure []
    OkC (Pair label ctx) =>
      codeActionsForCtx uri label ctx text reqStart reqStartCol reqEnd reqEndCol only

codeActionsForCtx : String -> String -> PackageContext -> String -> Int -> Int -> Int -> Int -> Maybe (List String) -> Eff [] (List Json)
codeActionsForCtx uri label ctx text reqStart reqStartCol reqEnd reqEndCol only = do
  looked <- fixitiesForFile emptyFixityEnv label text
  case secondOf looked of
    ErrC e => pure []
    OkC programFixities => case lintSourceWith programFixities text of
      ErrC e => pure []
      OkC findings => do
        rawSplits <-
          if refactorAllowed only then caseSplitActions uri label ctx text reqStart reqStartCol reqEnd reqEndCol
          else pure []
        diagActions <-
          if quickfixAllowed only then diagnosticSuggestionActions uri text reqStart reqEnd
          else pure []
        let
          splits = take maxCodeActions rawSplits
          fixable =
            if quickfixAllowed only then filter (editTouches reqStart reqEnd) findings else []
          singles = mapMaybe (findingQuickFix uri) fixable
          fixAll =
            if not (isEmptyList fixable) then fixAllActions uri programFixities text findings
            else []
          budget = maxOf 0 (maxCodeActions - length splits)
          singles2 = take (if isEmptyList fixAll then budget else maxOf 0 (budget - 1)) singles
          -- fix all 需要一格；case split 已占满上限时不再追加（总数仍 ≤ maxCodeActions）。
          fixAll2 = if isEmptyList fixAll || budget <= 0 then [] else fixAll
          used = length splits + length singles2 + length fixAll2
          diagActions2 = take (maxOf 0 (maxCodeActions - used)) diagActions
        in pure (append splits (append singles2 (append fixAll2 diagActions2)))

onlyKindsAllow : String -> Maybe (List String) -> Bool
onlyKindsAllow kind Nothing = True
onlyKindsAllow kind (Just kinds) = memName kind kinds

quickfixAllowed : Maybe (List String) -> Bool
quickfixAllowed only = onlyKindsAllow "quickfix" only

-- `refactor` 是 `refactor.rewrite` 的父 kind：客户端只要 `refactor` 时也应给 rewrite。
refactorAllowed : Maybe (List String) -> Bool
refactorAllowed only = onlyKindsAllow "refactor.rewrite" only || onlyKindsAllow "refactor" only

maxOf : Int -> Int -> Int
maxOf a b = if a >= b then a else b

-- 请求 range（1-based 行闭区间）与 Edit 的行范围（1-based 闭区间）是否相交。
editTouches : Int -> Int -> Finding -> Bool
editTouches reqStart reqEnd f = case f.findingEdit of
  Nothing => False
  Just e => e.editStart <= reqEnd && e.editEnd >= reqStart

-- Edit 的行范围是 1-based 闭区间整行替换 → LSP 0-based 半开 range（末端 = 下一行行首）。
editLspRange : Edit -> Json
editLspRange e = lspRange e.editStart 1 (e.editEnd + 1) 1

textEditJson : Json -> String -> Json
textEditJson range newText = JObj [Pair "range" range, Pair "newText" (JStr newText)]

-- 单条 quick fix：title 带规则短名；`diagnostics` 复用 `Vuna.Lsp.Diagnostics` 的
-- finding→diagnostic 转换（与 publishDiagnostics 同一条 JSON：range/severity/source/code/
-- message），客户端可按 code 关联到已有诊断；edit.changes 按 uri 分组。
findingQuickFix : String -> Finding -> Maybe Json
findingQuickFix uri f = case f.findingEdit of
  Nothing => Nothing
  Just e =>
    Just
      (JObj [Pair "title" (JStr "fix: ${f.findingRule}"), Pair "kind" (JStr "quickfix"), Pair "diagnostics" (JArr [findingDiagJson f]), Pair "edit" (JObj [Pair "changes" (JObj [Pair uri (JArr [textEditJson (editLspRange e) (joinLines e.editLines)])])])])

-- fix all 的命令名（initialize capabilities 的 executeCommandProvider 与动作共用）。
fixAllLintCommand : String
fixAllLintCommand = "vuna.fixAllLint"

-- C38：fix all 走 `Command`（不内嵌 WorkspaceEdit）：客户端选中后发
-- `workspace/executeCommand`，服务器再以 `workspace/applyEdit` 推送整文档替换。
-- 好处是 codeAction 结果不带大段 newText，且 command 通道可被客户端/脚本单独触发。
fixAllActionJson : String -> Json
fixAllActionJson uri =
  JObj
    [Pair "title" (JStr "fix all lint findings"), Pair "kind" (JStr "quickfix"), Pair "command" (JObj [Pair "title" (JStr "fix all lint findings"), Pair "command" (JStr fixAllLintCommand), Pair "arguments" (JArr [JStr uri])])]

-- fixLoop 把全部可修复 finding 迭代应用（8 轮，与 CLI `--fix` 一致）；无改动 → Nothing。
fixAllLintEdit : List FixityDecl -> String -> List Finding -> Maybe String
fixAllLintEdit programFixities text findings = case fixLoop programFixities text findings 8 0 of
  ErrC e => Nothing
  OkC (Pair count newText) => if count == 0 || newText == text then Nothing else Just newText

-- fix all 的 codeAction：只有确实有改动时才产生动作。
fixAllActions : String -> List FixityDecl -> String -> List Finding -> List Json
fixAllActions uri programFixities text findings = case fixAllLintEdit programFixities text findings of
  Nothing => []
  Just newText => [fixAllActionJson uri]

-- `workspace/executeCommand` 的 `vuna.fixAllLint`：按当前缓冲重算 lint + fixLoop，
-- 返回 WorkspaceEdit（changes 按 uri 分组）；无改动 / 上下文不可用 → Nothing。
fixAllLintWorkspaceEdit : String -> String -> Eff [] (Maybe Json)
fixAllLintWorkspaceEdit uri text = do
  ctxR <- contextForDoc uri
  case ctxR of
    ErrC e => pure Nothing
    OkC (Pair label ctx) => do
      looked <- fixitiesForFile emptyFixityEnv label text
      pure (case secondOf looked of
        ErrC e => Nothing
        OkC programFixities => case lintSourceWith programFixities text of
          ErrC e => Nothing
          OkC findings => case fixAllLintEdit programFixities text findings of
            Nothing => Nothing
            Just newText =>
              Just
                (JObj [Pair "changes" (JObj [Pair uri (JArr [textEditJson (fullRange text) newText])])])
      )

-- ---------------------------------------------------------------
-- case split（C38）：洞 → 上下文 binder 的 data 构造子 / record 分支
-- ---------------------------------------------------------------
-- 触发链（便宜 → 贵）：
--   1. 文本级扫描请求 range 里的 `_` / `?name` token（不跑精化；没有就不查洞）；
--   2. 命中才跑容错洞查询 `dtGoalsSourceTolerant`（与 hover / `vuna goal` 同源）；
--   3. 取覆盖请求 range 的那个洞，对上下文里每个「类型头解析到非索引 data / record」的
--      binder 生成一条 `refactor.rewrite`：`case <name> of` / `  <Ctor> _ => _` / ...；
--      record 是单构造器类型，给**一条**分支 `  <Type> { f = _, g = _ } => _`。
--
-- 构造子信息是 parse 级：当前缓冲 AST + `Bindings.moduleSourceIn`（按包上下文模块根读
-- 依赖模块源码；本模块内联）。类型头解析失败（函数类型 / 类型变量 / 索引族 / axiom /
-- 依赖模块缺失）就跳过该 binder——不报错、不产生动作（安全降级）。构造子名 / record
-- 类型名也按作用域决定：本模块 / open import / Prelude 重导出写短名，`import qualified`
-- 写 `Mod.` 限定名；两者都不成立的类型（只经函数签名间接可见）给不了合法模式名 →
-- 同样跳过。
--
-- 缩进：分支 = 洞所在行的行首缩进 + 2（与 fmt 对 `case` 的输出一致）。
-- 边界：隐式构造子参数（`{a : Type} ->`）不进模式（`ctorPatArity` 按 EPi 的 implicit 判定）；
-- 索引族**不枚举**（索引约束在 parse 级不可知，不可达分支会被精化器以
-- `TC_ImpossibleBranchIndex` 拒绝）；record 分支字段全部写 `_`（省略字段 = 通配也可，
-- 但写全字段不依赖字段默认值且与 fmt 输出一致）；洞若出现在类型位置，生成的 `case` 不是
-- 合法表达式——goal API 不区分表达式/类型位置，由编辑器把 action 当建议展示（用户可撤销）。
-- 请求 range 的行文本里是否有洞 token（文本级门控：没有就不跑整模块 DT 精化）。
-- 只按行判（不比较列）：同行的洞在 goalAtRange 里按 span 精确判定，误报只多一次精化。
rangeTouchesHole : String -> Int -> Int -> Int -> Int -> Bool
rangeTouchesHole text sl sc el ec = hasHole (join "\n" (map (lineText text) (range sl (el + 1))))

posBeforeOrEq : Pair Int Int -> Pair Int Int -> Bool
posBeforeOrEq a b = firstOf a < firstOf b || firstOf a == firstOf b && secondOf a <= secondOf b

-- 洞 span 对 `_` 是零宽（end = start）：末列至少放宽到 start + 1，让「光标在 token 右侧」
-- 也能命中；命名洞的 span 本身覆盖整个 `?name`。
goalTouchesRange : Int -> Int -> Int -> Int -> DtGoalInfo -> Bool
goalTouchesRange sl sc el ec g =
  let
    sp = g.dtGoalInfoSpan
    h1 = Pair (spanStartLine sp) (spanStartCol sp)
    h2 = Pair (spanEndLine sp) (maxOf sp.spanEndCol (spanStartCol sp + 1))
    p1 = Pair sl sc
    p2 = Pair el ec
  in posBeforeOrEq p1 h2 && posBeforeOrEq h1 p2

goalAtRange : Int -> Int -> Int -> Int -> List DtGoalInfo -> Maybe DtGoalInfo
goalAtRange sl sc el ec [] = Nothing
goalAtRange sl sc el ec (g :: rest) =
  if goalTouchesRange sl sc el ec g then Just g else goalAtRange sl sc el ec rest

-- 非索引 data 的 kind 只能是 `Type`（索引族写成 `... -> Type`，不枚举）。
dataKindIsType : Expr -> Bool
dataKindIsType (EVar "Type" sp) = True
dataKindIsType (EParen inner sp) = dataKindIsType inner
dataKindIsType _ = False

-- 可 split 的类型：非索引 data（多分支）或 record（单构造器，构造器名 = 类型名）。
-- 索引族**不做**：parse 级拿不到索引约束，枚举全部构造子可能生成精化器直接拒绝的
-- 不可达分支（`TC_ImpossibleBranchIndex`），所以宁可安全降级。`axiom` / 类型变量 /
-- trait / 函数类型没有可枚举的构造子，同样不给动作。
data SplitTy : Type where
  SplitData : List Ctor -> SplitTy
  SplitRecord : String -> List String -> SplitTy

findSplitIn : List Decl -> String -> Maybe SplitTy
findSplitIn [] name = Nothing
findSplitIn ((DData dname params kind ctors derivings viaField repr lin sp) :: rest) name =
  if dname == name then if dataKindIsType kind && not (isEmptyList ctors) then Just (SplitData ctors) else Nothing
  else findSplitIn rest name
findSplitIn ((DRecord dname params fields derivings viaField repr lin sp) :: rest) name =
  if dname == name then Just (SplitRecord dname (map fieldName fields)) else findSplitIn rest name
findSplitIn (_ :: rest) name = findSplitIn rest name

-- 类型表达式的头名（`Base.Maybe.Maybe` / `T.Color` / 应用后的 `T.Box`）。函数类型 /
-- Pi / 运算符不是构造子类型的候选 → Nothing。
-- 注意：洞上下文里的类型是精化器 `showTerm` 的文本，应用写在全括号里且左结合
-- （`((Base.Pair.Pair Int) Base.Bool.Bool)`），所以 EApp 要沿函数侧递归剥括号。
-- 箭头 `A -> B` 也编码成 `EApp (EVar "->") [A, B]`：头名是 `->`，解析不到声明 → 降级。
typeHeadName : Expr -> Maybe String
typeHeadName (EVar n sp) = Just n
typeHeadName (EApp f args sp2) = typeHeadName f
typeHeadName (EParen inner sp) = typeHeadName inner
typeHeadName _ = Nothing

firstMaybe : List (Maybe a) -> Maybe a
firstMaybe [] = Nothing
firstMaybe (x :: rest) = case x of
  Just v => Just v
  Nothing => firstMaybe rest

-- Eff 版的 firstMaybe：按顺序执行，命中即停。
firstMaybeEff : List (Eff [] (Maybe a)) -> Eff [] (Maybe a)
firstMaybeEff [] = pure Nothing
firstMaybeEff (x :: rest) = do
  v <- x
  case v of
    Just found => pure (Just found)
    Nothing => firstMaybeEff rest

-- 顺序执行每个元素的效果并拼接结果（列表顺序与纯 concatMap 一致）。
concatMapEff : (a -> Eff [] (List b)) -> List a -> Eff [] (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

moduleSplitIn : List Root -> String -> String -> Eff [] (Maybe SplitTy)
moduleSplitIn roots modName tyName = do
  src <- moduleSourceIn roots modName
  case src of
    Nothing => pure Nothing
    Just source => case parseSource "<case-split>" source of
      ErrC e => pure Nothing
      OkC dep => pure (findSplitIn dep.sourceFileDecls tyName)

exportedSplit : List Root -> String -> ExportItem -> Eff [] (Maybe SplitTy)
exportedSplit roots tyName (XModule name sp) = moduleSplitIn roots name tyName
exportedSplit roots tyName item = pure Nothing

-- 未限定类型名：本模块 → Prelude 的整模块重导出 → 各 open/qualified import 的模块。
preludeSplit : List Root -> String -> Eff [] (Maybe SplitTy)
preludeSplit roots tyName = do
  src <- moduleSourceIn roots "Prelude"
  case src of
    Nothing => pure Nothing
    Just source => case parseSource "<prelude>" source of
      ErrC e => pure Nothing
      OkC sf => case sf.sourceFileModDecl of
        Nothing => pure Nothing
        Just m => firstMaybeEff (map (exportedSplit roots tyName) m.modDeclExportItems)

importSplit : List Root -> String -> Import -> Eff [] (Maybe SplitTy)
importSplit roots tyName imp = moduleSplitIn roots imp.importName tyName

importedSplit : List Root -> String -> List Import -> Eff [] (Maybe SplitTy)
importedSplit roots tyName imports = firstMaybeEff (map (importSplit roots tyName) imports)

resolveUnqualifiedSplit : SourceFile -> List Root -> String -> Eff [] (Maybe (Pair String SplitTy))
resolveUnqualifiedSplit sf roots tyName = case findSplitIn sf.sourceFileDecls tyName of
  Just split => pure (Just (Pair "" split))
  Nothing => do
    prelude <- preludeSplit roots tyName
    case prelude of
      Just split => pure (Just (Pair "" split))
      Nothing => do
        imported <- importedSplit roots tyName sf.sourceFileImports
        pure (case imported of
          Just split => Just (Pair "" split)
          Nothing => Nothing
        )

-- 洞上下文里的类型文本 → (类型所在模块名, 可 split 的声明)。模块名 "" = 当前缓冲 /
-- 经 Prelude 重导出（分支写短名）。
-- 边界：类型文本是精化器 show 出来的**规范全名**（`Dep.Point` / `B.Local`），所以
-- `import ... as` 的模块别名不会出现在这里；也没有类型别名声明可展开（见 lsp.md）。
tagSplit : String -> Maybe SplitTy -> Maybe (Pair String SplitTy)
tagSplit modName (Just cs) = Just (Pair modName cs)
tagSplit modName Nothing = Nothing

resolveTypeSplit : SourceFile -> List Root -> String -> String -> Eff [] (Maybe (Pair String SplitTy))
resolveTypeSplit sf roots curMod tyText = case parseExpressionSource tyText of
  ErrC e => pure Nothing
  OkC ty => case typeHeadName ty of
    Nothing => pure Nothing
    Just head =>
      let
        split = splitLastDot (splitOnDot head)
        modName = joinDots (firstOf split)
        tyName = secondOf split
      in if modName == "" then resolveUnqualifiedSplit sf roots tyName
      else if modName == curMod then pure (tagSplit curMod (findSplitIn sf.sourceFileDecls tyName))
      else do
        found <- moduleSplitIn roots modName tyName
        pure (tagSplit modName found)

-- 构造子的模式参数个数：显式 `->` / `(a : Type) ->`（EPi implicit = False）才占通配；
-- 隐式 `{a : Type} ->`（EPi implicit = True）由调用点推断，不进模式。
ctorPatArity : Expr -> Int
ctorPatArity (EInfix "->" lhs rhs sp) = 1 + ctorPatArity rhs
ctorPatArity (EApp (EVar "->" sp1) ([x, rest]) sp2) = 1 + ctorPatArity rest
ctorPatArity (EPi n implicit qty dom cod sp) = (if implicit then 0 else 1) + ctorPatArity cod
ctorPatArity ty = 0

ctorWildArgs : Int -> String
ctorWildArgs n = join "" (map (\_ => " _") (range 0 n))

-- 直接 `import qualified` 的目标模块：构造子 / record 类型名要写限定名；本模块 /
-- open import / 经 Prelude 重导出的 base 类型短名在作用域里。既没直接 import、也不在
-- Prelude 重导出面里的模块（类型只经函数签名间接可见）连限定名都不可解析 —— 不给动作。
importQualifiedness : SourceFile -> String -> Maybe Bool
importQualifiedness sf name = firstMaybe (map (matchImportQualified name) sf.sourceFileImports)

matchImportQualified : String -> Import -> Maybe Bool
matchImportQualified name imp =
  if imp.importName == name then Just imp.importIsQualified else Nothing

exportModuleName : ExportItem -> Maybe String
exportModuleName (XModule name sp) = Just name
exportModuleName item = Nothing

-- Prelude 的整模块重导出面（`module Base.Bool` 等）：这些模块的短名在任意模块里可见。
preludeReexportModules : List Root -> Eff [] (List String)
preludeReexportModules roots = do
  src <- moduleSourceIn roots "Prelude"
  case src of
    Nothing => pure []
    Just source => case parseSource "<prelude>" source of
      ErrC e => pure []
      OkC sf => case sf.sourceFileModDecl of
        Nothing => pure []
        Just m => pure (mapMaybe exportModuleName m.modDeclExportItems)

typePatternPrefix : SourceFile -> List String -> String -> Maybe String
typePatternPrefix sf preludeModules modName = if modName == "" then Just ""
else if modName == currentModuleName sf.sourceFileDecls sf.sourceFileModDecl then Just ""
else case importQualifiedness sf modName of
  Just True => Just "${modName}."
  Just False => Just ""
  Nothing => if memName modName preludeModules then Just "" else Nothing

branchLine : String -> String -> Ctor -> String
branchLine indent prefix c =
  "\n${indent}${prefix}${ctorName c}${ctorWildArgs (ctorPatArity (ctorType c))} => _"

-- record 是单构造器类型（构造器名 = 类型名）：一条分支，字段全写 `_`。
recordBranchLine : String -> String -> String -> List String -> String
recordBranchLine indent prefix name fields =
  if isEmptyList fields then "\n${indent}${prefix}${name} => _"
  else "\n${indent}${prefix}${name} { ${join ", " (map (\f => "${f} = _") fields)} } => _"

splitBranchLines : String -> String -> SplitTy -> String
splitBranchLines indent prefix (SplitData ctors) = join "" (map (branchLine indent prefix) ctors)
splitBranchLines indent prefix (SplitRecord name fields) =
  recordBranchLine indent prefix name fields

caseSplitNewText : Int -> String -> String -> SplitTy -> String
caseSplitNewText baseIndent binder prefix split =
  "case ${binder} of" ++ splitBranchLines (spacesOf (baseIndent + 2)) prefix split

leadingSpaces : String -> Int
leadingSpaces s = leadingSpacesGo (strUnpack s) 0

leadingSpacesGo : List Int -> Int -> Int
leadingSpacesGo [] n = n
leadingSpacesGo (c :: rest) n = if c == 32 then leadingSpacesGo rest (n + 1) else n

spacesOf : Int -> String
spacesOf n = join "" (map (\_ => " ") (range 0 n))

splitActionJson : String -> Int -> Int -> Int -> String -> String -> Json
splitActionJson uri line startCol endCol title newText =
  JObj
    [Pair "title" (JStr title), Pair "kind" (JStr "refactor.rewrite"), Pair "edit" (JObj [Pair "changes" (JObj [Pair uri (JArr [textEditJson (lspRange line startCol line endCol) newText])])])]

-- 一个 binder → 最多一条 action（类型解析不到 / 构造子名不在作用域就 0 条）。
binderSplitAction : String -> String -> SourceFile -> List Root -> List String -> DtGoalInfo -> Pair String String -> Eff [] (List Json)
binderSplitAction uri text sf roots preludeModules g (Pair name tyText) = do
  resolved <-
    resolveTypeSplit sf roots (currentModuleName sf.sourceFileDecls sf.sourceFileModDecl) tyText
  case resolved of
    Nothing => pure []
    Just (Pair modName split) =>
      let
        sp = g.dtGoalInfoSpan
        line = spanStartLine sp
        startCol = spanStartCol sp
        endCol = maxOf sp.spanEndCol (startCol + 1)
        baseIndent = leadingSpaces (lineText text line)
      in case typePatternPrefix sf preludeModules modName of
        Nothing => pure []
        Just prefix =>
          pure
            [splitActionJson uri line startCol endCol "case split on ${name}" (caseSplitNewText baseIndent name prefix split)]

ctxSplitActions : String -> String -> SourceFile -> List Root -> List String -> DtGoalInfo -> Eff [] (List Json)
ctxSplitActions uri text sf roots preludeModules g =
  concatMapEff (binderSplitAction uri text sf roots preludeModules g) g.dtGoalInfoCtx

-- 入口：请求 range → 洞 → 上下文里的可分裂 binder（不命中返回 []）。
caseSplitActions : String -> String -> PackageContext -> String -> Int -> Int -> Int -> Int -> Eff [] (List Json)
caseSplitActions uri label ctx text sl sc el ec = if not (rangeTouchesHole text sl sc el ec) then pure []
else do
  gsR <- dtGoalsSourceTolerant ctx label text
  case gsR of
    ErrC e => pure []
    OkC gs => case goalAtRange sl sc el ec gs of
      Nothing => pure []
      Just g => case parseSource "<lsp>" text of
        ErrC e => pure []
        OkC sf => do
          preludeModules <- preludeReexportModules (contextRoots ctx)
          ctxSplitActions uri text sf (contextRoots ctx) preludeModules g

-- Index：惰性加载（首次 definition/references/completion/workspaceSymbol 时）
-- ---------------------------------------------------------------
-- 工作区根：从文件所在目录向上取**最外层** manifest（workspace 根）。
outermostManifest : Int -> String -> Eff [] String
outermostManifest fuel dir = if fuel <= 0 then pure dir
else
  let
    parent = parentDir dir
  in if parent == dir then pure dir
  else do
    found <- findManifestDirMaybe parent
    case found of
      Nothing => pure dir
      Just p => outermostManifest (fuel - 1) p

workspaceRoot : String -> Eff [] String
workspaceRoot uri =
  let
    path = decodeUri uri
    startDir = if path == "" then "." else dirOfPath path
  in do
    found <- findManifestDirMaybe startDir
    case found of
      Nothing => do
        fallback <- findManifestDirMaybe "."
        pure (case fallback of
          Nothing => "."
          Just d => d
        )
      Just nearest => outermostManifest 64 nearest

modulePathOf : Index -> String -> Maybe String
modulePathOf idx modNameQuery = case filter (\mi => modName mi == modNameQuery) (indexModules idx) of
  mi :: rest => Just (modPath mi)
  [] => Nothing

-- 符号定义位置 → LSP Location。
symLocation : Index -> Sym -> Maybe Json
symLocation idx s = case modulePathOf idx (symModule s) of
  Nothing => Nothing
  Just path =>
    Just
      (JObj [Pair "uri" (JStr (pathToUri path)), Pair "range" (lspRange (symLine s) (symCol s) (symLine s) (symCol s + strLength (symName s)))])

-- 光标名字的最佳符号：优先当前模块，否则取第一个候选。
pickBestSymbol : String -> List Sym -> Maybe Sym
pickBestSymbol curMod syms = case filter (\s => symModule s == curMod) syms of
  s :: rest => Just s
  [] => case syms of
    s :: rest => Just s
    [] => Nothing

bestSymbol : Index -> String -> String -> Maybe Sym
bestSymbol idx curMod token = case findSymbol idx token of
  OkC syms => pickBestSymbol curMod syms
  ErrC e => Nothing

-- 当前文档的模块名（无 module 头 → ""）。
currentModuleName : List Decl -> Maybe ModDecl -> String
currentModuleName decls Nothing = ""
currentModuleName decls (Just (ModDecl name explicit items sp)) = name

-- 当前缓冲里的顶层名字（类型名 + 声明名），供补全使用。
declBufferNames : Decl -> List String
declBufferNames d = append (typeNamesOf [d]) (declNames d)

bufferNames : String -> List String
bufferNames text = case parseSource "<completion>" text of
  ErrC e => []
  OkC (SourceFile hdr imports fx decls) => dedupeNames (concatMap declBufferNames decls)

dedupeNames : List String -> List String
dedupeNames xs = dedupeNamesGo xs [] []

dedupeNamesGo : List String -> List String -> List String -> List String
dedupeNamesGo [] seen acc = reverse acc
dedupeNamesGo (x :: rest) seen acc =
  if memName x seen then dedupeNamesGo rest seen acc else dedupeNamesGo rest (x :: seen) (x :: acc)

-- ---------------------------------------------------------------
-- documentSymbol：AST 声明树
-- ---------------------------------------------------------------
declNameOf : Decl -> String
declNameOf (DData name params kind ctors derivings viaField repr lin sp) = name
declNameOf (DAxiom name ty sp) = name
declNameOf (DExtern name cName ty sp) = name
declNameOf (DSig name ctx ty sp) = name
declNameOf (DFun name pats body sp) = name
declNameOf (DRecord name params fields derivings viaField repr lin sp) = name
declNameOf (DTrait name params methods sp) = name
declNameOf (DInstance ctxE head methods sp) = "instance"

-- LSP SymbolKind：Function=12、Field=8、Interface=11、Constant=14、
-- EnumMember=22、Struct=23、Method=6。
declSymbolKind : Decl -> Int
declSymbolKind (DData name params kind ctors derivings viaField repr lin sp) = 23
declSymbolKind (DRecord name params fields derivings viaField repr lin sp) = 23
declSymbolKind (DTrait name params methods sp) = 11
declSymbolKind (DAxiom name ty sp) = 14
declSymbolKind (DExtern name cName ty sp) = 14
declSymbolKind (DSig name ctx ty sp) = 12
declSymbolKind (DFun name pats body sp) = 12
declSymbolKind (DInstance ctxE head methods sp) = 12

symbolJson : String -> Int -> Json -> Json -> List Json -> Json
symbolJson name kind range sel children =
  JObj
    (append [Pair "name" (JStr name), Pair "kind" (JNum kind), Pair "range" range, Pair "selectionRange" sel] (if isEmptyList children then [] else [Pair "children" (JArr children)]))

ctorSymbolJson : List String -> Ctor -> Json
ctorSymbolJson lines c =
  symbolJson (ctorName c) 22 (spanRange (ctorSpan c)) (nameSelRange lines (ctorSpan c) (ctorName c))
    []

fieldSymbolJson : List String -> Field -> Json
fieldSymbolJson lines f =
  symbolJson (fieldName f) 8 (spanRange (fieldSpan f))
    (nameSelRange lines (fieldSpan f) (fieldName f)) []

-- M30（B20）：方法子节点用方法签名 span（方法名到类型结束），不再复用 trait 声明 span。
methodSymbolJson : List String -> TraitMethod -> Json
methodSymbolJson lines m =
  symbolJson (traitMethodName m) 6 (spanRange (traitMethodSpan m))
    (nameSelRange lines (traitMethodSpan m) (traitMethodName m)) []

declChildrenJson : List String -> Decl -> List Json
declChildrenJson lines (DData name params kind ctors derivings viaField repr lin sp) =
  map (ctorSymbolJson lines) ctors
declChildrenJson lines (DRecord name params fields derivings viaField repr lin sp) =
  map (fieldSymbolJson lines) fields
declChildrenJson lines (DTrait name params methods sp) = map (methodSymbolJson lines) methods
declChildrenJson lines _ = []

declSymbolJson : List String -> Decl -> Json
declSymbolJson lines d =
  let
    sp = declSpan d
    name = declNameOf d
  in symbolJson name (declSymbolKind d) (spanRange sp) (nameSelRange lines sp name)
    (declChildrenJson lines d)

documentSymbols : String -> String -> Eff [] (List Json)
documentSymbols uri text = case parseSource uri text of
  ErrC e => pure []
  OkC (SourceFile hdr imports fx decls0) => do
    fxR <- formattingFixities uri text
    pure (case fxR of
      ErrC _ => []
      OkC programFixities => case reorderProgram (tableOfKeepOps (append programFixities fx)) decls0 of
        ErrC e => []
        OkC decls => map (declSymbolJson (split "\n" text)) decls
    )

-- ---------------------------------------------------------------
-- definition：位置 → token → Index → Location
-- ---------------------------------------------------------------
findDeclByName : String -> List Decl -> Maybe Decl
findDeclByName name [] = Nothing
findDeclByName name (d :: rest) =
  if memName name (declBufferNames d) then Just d else findDeclByName name rest

-- Index 不可用/未命中时的同文件兜底：在当前缓冲的顶层声明里找同名定义。
bufferDefinition : String -> String -> String -> Json
bufferDefinition uri text token = case parseSource uri text of
  ErrC e => JNull
  OkC (SourceFile hdr imports fx decls) => case findDeclByName (lastSegment token) decls of
    Nothing => JNull
    Just d =>
      JArr
        [JObj [Pair "uri" (JStr uri), Pair "range" (nameSelRange (split "\n" text) (declSpan d) (lastSegment token))]]

-- ---------------------------------------------------------------
-- references：Index refs（带出现位置）+ 定义位置
-- ---------------------------------------------------------------
refLocation : Index -> Ref -> Maybe Json
refLocation idx r = case modulePathOf idx (refModule r) of
  Nothing => Nothing
  Just path =>
    Just
      (JObj [Pair "uri" (JStr (pathToUri path)), Pair "range" (lspRange r.refLine r.refCol r.refLine (r.refCol + strLength (refName r)))])

referencesFor : Index -> String -> String -> List Json
referencesFor idx curMod token = case bestSymbol idx curMod token of
  Nothing => []
  Just sym =>
    let
      refs = case findReferences idx (symName sym) of
        OkC rs => take maxReferences rs
        ErrC e => []
      refLocs = mapMaybe (refLocation idx) refs
      defLocs = case symLocation idx sym of
        Nothing => []
        Just loc => [loc]
    in append defLocs refLocs

-- ---------------------------------------------------------------
-- completion
-- ---------------------------------------------------------------
record Compl where
  complLabel : String
  complKind : Int
  complDetail : String

complLabel : Compl -> String
complLabel (Compl label kind detail) = label

-- CompletionItemKind：Method=2、Function=3、Constructor=4、Field=5、Variable=6、
-- Class=7、Interface=8、Module=9、Keyword=14、Constant=21、Struct=22。
symCompletionKind : Sym -> Int
symCompletionKind s = case symKind s of
  "fun" => 3
  "data" => 22
  "record" => 22
  "trait" => 8
  "axiom" => 21
  "ctor" => 4
  "field" => 5
  "method" => 2
  _ => 6

symSymbolKind : Sym -> Int
symSymbolKind s = case symKind s of
  "data" => 23
  "record" => 23
  "trait" => 11
  "axiom" => 14
  "ctor" => 22
  "field" => 8
  "method" => 6
  _ => 12

complJson : Compl -> Json
complJson c =
  JObj
    (append [Pair "label" (JStr (complLabel c)), Pair "kind" (JNum c.complKind)] (if c.complDetail == "" then [] else [Pair "detail" (JStr c.complDetail)]))

dedupeCompls : List Compl -> List Compl
dedupeCompls xs = dedupeComplsGo xs [] []

dedupeComplsGo : List Compl -> List String -> List Compl -> List Compl
dedupeComplsGo [] seen acc = reverse acc
dedupeComplsGo (x :: rest) seen acc =
  if memName (complLabel x) seen then dedupeComplsGo rest seen acc
  else dedupeComplsGo rest (complLabel x :: seen) (x :: acc)

lspKeywords : List String
lspKeywords =
  [ "module",
    "import",
    "data",
    "record",
    "trait",
    "instance",
    "where",
    "deriving",
    "axiom",
    "let",
    "in",
    "case",
    "of",
    "do",
    "if",
    "then",
    "else",
    "Type",
    "True",
    "False"
  ]

bufferCompls : String -> List Compl
bufferCompls text = map (\n => Compl n 3 "") (bufferNames text)

keywordCompls : List Compl
keywordCompls = map (\n => Compl n 14 "") lspKeywords

indexCompls : Maybe Index -> List Compl
indexCompls Nothing = []
indexCompls (Just idx) =
  map (\s => Compl (symName s) (symCompletionKind s) (symSig s)) idx.indexSymbols

hasPrefix : String -> List Compl -> List Compl
hasPrefix prefix items = filter (\c => startsWith prefix (complLabel c)) items

finishCompls : List Compl -> List Json
finishCompls items = map complJson (take maxCompletions (dedupeCompls items))

-- `.` 之后的限定补全：前缀是模块名，按 `<module>.` 过滤符号全名。
qualifiedCompletions : String -> List Int -> Int -> String -> Maybe Index -> List Json
qualifiedCompletions ln chars prefixStart prefix Nothing = []
qualifiedCompletions ln chars prefixStart prefix (Just idx) =
  let
    beforeDotChars = take (prefixStart - 1) chars
    modLen = qualPrefixLen (reverse beforeDotChars)
    modStart = length beforeDotChars - modLen
    modPrefix = substring (natFromInt modStart) (natFromInt modLen) ln
    fullPrefix = "${modPrefix}."
    hits =
      filter (\s => startsWith fullPrefix (symFullName s) && startsWith prefix (symName s))
        idx.indexSymbols
  in finishCompls (map (\s => Compl (symName s) (symCompletionKind s) (symSig s)) hits)

completionItems : String -> Int -> Int -> Maybe Index -> List Json
completionItems text line0 col0 midx =
  let
    ln = lineText text (line0 + 1)
    chars = strUnpack ln
    p0 = clampInt 0 col0 (length chars)
    left = reverse (take p0 chars)
    prefixLen = wordPrefixLen left
    prefixStart = p0 - prefixLen
    afterDot = prefixStart > 0 && nthCode chars (prefixStart - 1) == 46
    prefix = substring (natFromInt prefixStart) (natFromInt prefixLen) ln
  in if afterDot then qualifiedCompletions ln chars prefixStart prefix midx
  else finishCompls
    (append (hasPrefix prefix keywordCompls) (append (hasPrefix prefix (bufferCompls text)) (hasPrefix prefix (indexCompls midx))))

-- ---------------------------------------------------------------
-- workspace/symbol
-- ---------------------------------------------------------------
matchingSymbols : Index -> String -> List Sym
matchingSymbols idx query = case findSymbol idx query of
  OkC syms => syms
  ErrC e =>
    filter (\s => contains query (symName s) || contains query (symFullName s)) idx.indexSymbols

symbolInfoJson : Index -> Sym -> Maybe Json
symbolInfoJson idx s = case symLocation idx s of
  Nothing => Nothing
  Just loc =>
    Just
      (JObj (append [Pair "name" (JStr (symName s)), Pair "kind" (JNum (symSymbolKind s)), Pair "location" loc] (if symModule s == "" then [] else [Pair "containerName" (JStr (symModule s))])))

workspaceSymbols : Maybe Index -> String -> List Json
workspaceSymbols Nothing query = []
workspaceSymbols (Just idx) query =
  let
    syms = if query == "" then idx.indexSymbols else matchingSymbols idx query
  in mapMaybe (symbolInfoJson idx) (take maxWorkspaceSymbols syms)

-- ---------------------------------------------------------------
-- 诊断自带的 suggestion（如 UN_UnusedDefinition 的删除编辑）→ quick fix CodeAction。
diagnosticSuggestionActions : String -> String -> Int -> Int -> Eff [] (List Json)
diagnosticSuggestionActions uri text reqStart reqEnd = do
  result <- diagnosticsForSuggestions Nothing uri text
  let
    diags = secondOf (secondOf result)
  in pure (concatMap (diagSuggestionActions uri reqStart reqEnd) diags)

diagSuggestionActions : String -> Int -> Int -> Diagnostic -> List Json
diagSuggestionActions uri reqStart reqEnd d =
  if not (diagTouchesReq d reqStart reqEnd) then []
  else map (suggestionActionJson uri) d.diagSuggestions

diagTouchesReq : Diagnostic -> Int -> Int -> Bool
diagTouchesReq d reqStart reqEnd = case primarySpanQ d.diagLabels of
  Nothing => False
  Just sp => spanStartLine sp - 1 <= reqEnd && spanEndLine sp - 1 >= reqStart

suggestionActionJson : String -> Suggestion -> Json
suggestionActionJson uri s =
  JObj
    [Pair "title" (JStr s.suggestionTitle), Pair "kind" (JStr "quickfix"), Pair "edit" (JObj [Pair "changes" (JObj [Pair uri (JArr (map suggestionEditJson s.suggestionEdits))])])]

suggestionEditJson : DiagEdit -> Json
suggestionEditJson e = textEditJson (spanRange e.editSpan) e.editNewText

primarySpanQ : List Label -> Maybe Span
primarySpanQ [] = Nothing
primarySpanQ ((Label sp _ LabelPrimary _) :: rest) = sp
primarySpanQ (_ :: rest) = primarySpanQ rest
