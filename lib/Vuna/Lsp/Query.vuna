module Vuna.Lsp.Query
  ( codeActionsFor
  , completionItems
  , definitionResult
  , documentSymbols
  , formattingEdits
  , holeHoverAt
  , referencesResult
  , symbolHoverResult
  , workspaceRoot
  , workspaceSymbols
  ) where

-- Vuna.Lsp.Query：LSP 各查询方法的实现（工具链模块，**永不进 seed 闭包**）。
--
-- 全是「输入文本/位置/索引 → JSON 结果」的纯查询，不持有服务器状态（状态机在
-- Vuna.Lsp 门面）。依赖方向：Query → Diagnostics → Protocol，单向无环。
--
-- 方法：
--   hover             先 DT 洞目标（`_` / `?name`；文本里无洞 token 时跳过精化；M40 起走
--                     容错查询，未解洞也给目标+上下文），未命中再看 Bindings（模块名/局部
--                     绑定，见 Vuna.Lsp），最后 Index 标识符签名/注释；
--                     range 落在光标 token 上（不是定义位置）；
--   formatting        `Vuna.Fmt.formatSourceWith`（程序级 fixity）成功且内容变化 ⇒ 全文 TextEdit；
--   codeAction        lint finding（可自动修复）→ quick fix TextEdit；另加全文档 fix all；
--   documentSymbol    AST 声明树（data/record/trait 带子节点）；selectionRange 精确落名字；
--   definition        位置 token（支持 `Mod.name`）→ Index 符号 → Location；Index 不可用时
--                     同文件缓冲兜底；
--   references        定义位置 + Index `findReferences` 的出现位置；
--   completion        关键字 + 当前缓冲顶层名 + Index 符号（`.` 后按模块过滤，cap 500）；
--   workspace/symbol  Index 过滤（cap 200），没有 textDocument 时用首个打开文档推断根。
import Vuna.Compiler.Common
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Elab
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.FixityEnv
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Packages.Pkg
import Vuna.Fmt
import Vuna.Index
import Vuna.Json
import Vuna.Lint.Fix
import Vuna.Lint.Rules
import Vuna.Lsp.Diagnostics
import Vuna.Lsp.Protocol

-- 结果上限：避免病态索引/大文件把单帧撑爆。
maxCompletions : Int
maxCompletions = 500

maxWorkspaceSymbols : Int
maxWorkspaceSymbols = 200

maxReferences : Int
maxReferences = 500

-- codeAction 结果上限：同屏 quick fix 不需要无限长。
maxCodeActions : Int
maxCodeActions = 20

-- 全文范围（格式化用）：0:0 到最后一行的行尾。
fullRange : String -> Json
fullRange text =
  let
    ls = split "\n" text
    endLine = length ls - 1
    endText = case lastElem ls of
      Nothing => ""
      Just x => x
  in lspRange 1 1 (endLine + 1) (strLength endText + 1)

-- ---------------------------------------------------------------
-- 选择范围：尽量指向名字本身，找不到就退回声明起点（`findNamePos` 在 Protocol）。
nameSelRange : List String -> Span -> String -> Json
nameSelRange lines sp name = case findNamePos lines sp name of
  Nothing =>
    lspRange (spanStartLine sp) (spanStartCol sp) (spanStartLine sp)
      (spanStartCol sp + strLength name)
  Just (Pair l c) => lspRange l c l (c + strLength name)

-- ---------------------------------------------------------------
-- hover：DT 洞目标 + 标识符签名
-- ---------------------------------------------------------------
ctxLine : Pair String String -> String
ctxLine kv = "- `${firstOf kv}` : ${secondOf kv}\n"

contextBlock : List (Pair String String) -> String
contextBlock [] = ""
contextBlock ctx = """

Context:
${join "" (map ctxLine ctx)}"""

goalContents : DtGoalInfo -> Json
goalContents g =
  let
    -- M40：命名洞显示 `?name : <目标类型>`；匿名洞保持只显示目标类型（与旧输出一致）。
    label =
      if g.dtGoalInfoName == "" then g.dtGoalInfoGoal
      else "${g.dtGoalInfoName} : ${g.dtGoalInfoGoal}"
  in JObj
    [Pair "kind" (JStr "markdown"), Pair "value" (JStr "```vuna\n${label}\n```\n${contextBlock g.dtGoalInfoCtx}")]

holeContains : Int -> Int -> DtGoalInfo -> Bool
holeContains line col g =
  let
    sp = g.dtGoalInfoSpan
    sl = spanStartLine sp
    sc = spanStartCol sp
    el = spanEndLine sp
    ec = sp.spanEndCol
  in not (line < sl || line > el || line == sl && col < sc || line == el && col > ec)

holeAt : Int -> Int -> List DtGoalInfo -> Maybe DtGoalInfo
holeAt line col [] = Nothing
holeAt line col (g :: rest) = if holeContains line col g then Just g else holeAt line col rest

holeHoverJson : DtGoalInfo -> Json
holeHoverJson g =
  let
    sp = g.dtGoalInfoSpan
  in JObj
    [Pair "contents" (goalContents g), Pair "range" (lspRange (spanStartLine sp) (spanStartCol sp) (spanEndLine sp) sp.spanEndCol)]

symbolHoverBody : Sym -> String
symbolHoverBody s =
  let
    body =
      if symKind s == "fun" then "${symFullName s} : ${symSig s}"
      else if symSig s == "" then symFullName s else symSig s
    doc = if s.symDoc == "" then "" else "\n\n${s.symDoc}"
  in """```vuna
${body}
```${doc}"""

-- hover 的 range 必须是**光标下的 token**，不是符号定义位置：客户端（VS Code）用
-- hover.range 判断 hover 何时失效，鼠标一动到 range 外就收起。返回定义位置会让使用点
-- 的 hover 立刻消失。
symbolHoverJson : Sym -> Int -> Int -> String -> Json
symbolHoverJson s line startCol token =
  JObj
    [Pair "contents" (JObj [Pair "kind" (JStr "markdown"), Pair "value" (JStr (symbolHoverBody s))]), Pair "range" (lspRange line startCol line (startCol + strLength token))]

-- ---------------------------------------------------------------
currentModuleNameOf : String -> String
currentModuleNameOf text = case parseSource "<lsp>" text of
  Err e => ""
  Ok (SourceFile hdr imports fx decls) => currentModuleName decls hdr

-- hover 的第一段：DT 洞目标（包上下文；与 `vuna goal` 同源）。
-- 快速判据：文本里没有洞（`_` / `?name`）时直接跳过——否则每次 hover 都要跑一遍
-- 整模块（含 import 闭包）的 DT 精化，大文件上是秒级开销。
-- M40：用 tolerant 查询，**未解洞**也能拿到目标类型与上下文快照。
holeHoverAt : String -> Int -> Int -> String -> Maybe Json
holeHoverAt uri line col text = if hasHole text then holeHoverChecked uri line col text else Nothing

holeHoverChecked : String -> Int -> Int -> String -> Maybe Json
holeHoverChecked uri line col text = case contextForDoc uri of
  Err e => Nothing
  Ok (Pair label ctx) => case dtGoalsSourceTolerant ctx label text of
    Err e => Nothing
    Ok gs => case holeAt line col gs of
      Nothing => Nothing
      Just g => Just (holeHoverJson g)

-- 洞判定：`_` 是独立 token（左右都不是标识符/限定名的连接字符）；`?name` 是 `?` 紧邻标识符
-- 起始字符（M40）。行首/行尾用哨兵 -1；字符串或注释里的洞字符会误判成「有洞」，只多跑一次
-- 精化，不影响正确性。
holeJoinCode : Int -> Bool
holeJoinCode c =
  c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 46

holeIdentStart : Int -> Bool
holeIdentStart c = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

holeScan : List Int -> Int -> Bool
holeScan [] prev = False
holeScan (c :: rest) prev =
  if c == 95 then holeAtUnderscore rest prev
  else if c == 63 then holeNamedAhead rest else holeScan rest c

-- `?` 后面紧跟标识符起始字符（同行，无空格）⇒ 命名洞；否则按普通运算符字符继续扫。
holeNamedAhead : List Int -> Bool
holeNamedAhead [] = False
holeNamedAhead (c :: rest) = holeIdentStart c || holeScan rest 63

holeAtUnderscore : List Int -> Int -> Bool
holeAtUnderscore rest prev =
  if holeJoinCode prev then holeScan rest 95
  else if holeJoinNext rest then holeScan rest 95 else True

holeJoinNext : List Int -> Bool
holeJoinNext [] = False
holeJoinNext (c :: rest) = holeJoinCode c

hasHole : String -> Bool
hasHole text = holeScan (strUnpack text) (0 - 1)

-- hover 的第二段：光标标识符的签名/注释（Index；不可用/未命中 → null）。
symbolHoverResult : String -> Int -> Int -> String -> Maybe Index -> Json
symbolHoverResult uri line col text Nothing = JNull
symbolHoverResult uri line col text (Just idx) = case tokenAtCursor text line col of
  Nothing => JNull
  Just (Pair startCol token) => case bestSymbol idx (currentModuleNameOf text) token of
    Nothing => JNull
    Just sym => symbolHoverJson sym line startCol token

-- definition：光标 token → Index 符号 → Location；Index 不可用/未命中时同文件兜底。
definitionResult : String -> Int -> Int -> String -> Maybe Index -> Json
definitionResult uri line col text Nothing =
  bufferDefinition uri text (fromMaybe "" (mapJust secondOf (tokenAtCursor text line col)))
definitionResult uri line col text (Just idx) = case tokenAtCursor text line col of
  Nothing => JNull
  Just (Pair startCol token) => case bestSymbol idx (currentModuleNameOf text) token of
    Nothing => bufferDefinition uri text token
    Just sym => case symLocation idx sym of
      Nothing => bufferDefinition uri text token
      Just loc => JArr [loc]

-- references：定义位置 + Index refs 的出现位置。
referencesResult : String -> Int -> Int -> String -> Maybe Index -> List Json
referencesResult uri line col text Nothing = []
referencesResult uri line col text (Just idx) = case tokenAtCursor text line col of
  Nothing => []
  Just (Pair startCol token) => referencesFor idx (currentModuleNameOf text) token

-- formatting：formatSourceWith 成功且内容有变化 ⇒ 全文 TextEdit；否则 []。
-- M31.3（B27）：fixity 是程序级的——与 CLI 同源，用 `Vuna.FixityEnv`（按文件目录缓存模块图，
-- 声明表逐文件重算 local + import 闭包）。上下文/加载失败或未知运算符 ⇒ 返回空 edits
-- （不让 LSP 请求失败，也不静默改语义）。
formattingEdits : String -> String -> List Json
formattingEdits uri text = case formattingFixities uri text of
  Err e => []
  Ok fixities => case formatSourceWith fixities text of
    Err e => []
    Ok formatted =>
      if formatted == text then []
      else [JObj [Pair "range" (fullRange text), Pair "newText" (JStr formatted)]]

formattingFixities : String -> String -> Result (List FixityDecl)
formattingFixities uri text =
  let
    path = decodeUri uri
  in if path == "" then Err "empty document uri"
  else secondOf (fixitiesForFile emptyFixityEnv path text)

-- ---------------------------------------------------------------
-- codeAction：lint finding → quick fix（M38 P1c）
-- ---------------------------------------------------------------
-- 与诊断同源：程序级 fixity（`Vuna.FixityEnv`）→ `Vuna.Lint.Rules.lintSourceWith`；
-- 只取**可自动修复**（`findingEdit = Just`）且编辑行范围与请求 range（1-based 行闭区间）
-- 相交的 finding。Edit 的行范围是 1-based 闭区间**整行替换**：
--   LSP range = (editStart - 1, 0) .. (editStop, 0)（末端取下一行行首，不吞掉下一行）；
--   newText = `joinLines editLines`。
-- 另加一条 "fix all lint findings"：`Vuna.Lint.Fix.fixLoop` 跑到收敛（与 CLI `--fix`
-- 同一条路径），发整文档替换编辑。请求 range 附近没有可修复 finding 时返回空数组，
-- 避免每一行都冒出全文档 fix。总条数上限 20（fix all 占最后一格）。
codeActionsFor : String -> String -> Int -> Int -> List Json
codeActionsFor uri text reqStart reqEnd = case contextForDoc uri of
  Err e => []
  Ok (Pair label _) => case fixitiesForFile emptyFixityEnv label text of
    Pair _ (Err e) => []
    Pair _ (Ok programFixities) => case lintSourceWith programFixities text of
      Err e => []
      Ok findings =>
        let
          fixable = filter (editTouches reqStart reqEnd) findings
        in if isEmptyList fixable then []
        else
          let
            singles = mapMaybe (findingQuickFix uri) fixable
            fixAll = fixAllActions uri programFixities text findings
          in if isEmptyList fixAll then take maxCodeActions singles
          else append (take (maxCodeActions - 1) singles) fixAll

-- 请求 range（1-based 行闭区间）与 Edit 的行范围（1-based 闭区间）是否相交。
editTouches : Int -> Int -> Finding -> Bool
editTouches reqStart reqEnd f = case f.findingEdit of
  Nothing => False
  Just e => e.editStart <= reqEnd && e.editEnd >= reqStart

-- Edit 的行范围是 1-based 闭区间整行替换 → LSP 0-based 半开 range（末端 = 下一行行首）。
editLspRange : Edit -> Json
editLspRange e = lspRange e.editStart 1 (e.editEnd + 1) 1

textEditJson : Json -> String -> Json
textEditJson range newText = JObj [Pair "range" range, Pair "newText" (JStr newText)]

-- 单条 quick fix：title 带规则短名，diagnostics 只带 code（客户端按 code 关联到已有诊断），
-- edit.changes 按 uri 分组。
findingQuickFix : String -> Finding -> Maybe Json
findingQuickFix uri f = case f.findingEdit of
  Nothing => Nothing
  Just e =>
    Just
      (JObj [Pair "title" (JStr "fix: ${f.findingRule}"), Pair "kind" (JStr "quickfix"), Pair "diagnostics" (JArr [JObj [Pair "code" (JStr f.findingCode)]]), Pair "edit" (JObj [Pair "changes" (JObj [Pair uri (JArr [textEditJson (editLspRange e) (joinLines e.editLines)])])])])

-- 全文档 fix：fixLoop 把全部可修复 finding 迭代应用（8 轮，与 CLI `--fix` 一致）；
-- 有改动才发整文档替换编辑，否则不产生动作。
fixAllActions : String -> List FixityDecl -> String -> List Finding -> List Json
fixAllActions uri programFixities text findings = case fixLoop programFixities text findings 8 0 of
  Err e => []
  Ok (Pair count newText) =>
    if count == 0 || newText == text then []
    else [ JObj [Pair "title" (JStr "fix all lint findings"), Pair "kind" (JStr "quickfix"), Pair "edit" (JObj [Pair "changes" (JObj [Pair uri (JArr [textEditJson (fullRange text) newText])])])]
    ]

-- Index：惰性加载（首次 definition/references/completion/workspaceSymbol 时）
-- ---------------------------------------------------------------
-- 工作区根：从文件所在目录向上取**最外层** manifest（workspace 根）。
outermostManifest : Int -> String -> String
outermostManifest fuel dir = if fuel <= 0 then dir
else
  let
    parent = parentDir dir
  in if parent == dir then dir
  else case findManifestDirMaybe parent of
    Nothing => dir
    Just p => outermostManifest (fuel - 1) p

workspaceRoot : String -> String
workspaceRoot uri =
  let
    path = decodeUri uri
    startDir = if path == "" then "." else dirOfPath path
  in case findManifestDirMaybe startDir of
    Nothing => case findManifestDirMaybe "." of
      Nothing => "."
      Just d => d
    Just nearest => outermostManifest 64 nearest

modulePathOf : Index -> String -> Maybe String
modulePathOf idx modNameQuery = case filter (\mi => modName mi == modNameQuery) (indexModules idx) of
  mi :: rest => Just (modPath mi)
  [] => Nothing

-- 符号定义位置 → LSP Location。
symLocation : Index -> Sym -> Maybe Json
symLocation idx s = case modulePathOf idx (symModule s) of
  Nothing => Nothing
  Just path =>
    Just
      (JObj [Pair "uri" (JStr (pathToUri path)), Pair "range" (lspRange (symLine s) (symCol s) (symLine s) (symCol s + strLength (symName s)))])

-- 光标名字的最佳符号：优先当前模块，否则取第一个候选。
pickBestSymbol : String -> List Sym -> Maybe Sym
pickBestSymbol curMod syms = case filter (\s => symModule s == curMod) syms of
  s :: rest => Just s
  [] => case syms of
    s :: rest => Just s
    [] => Nothing

bestSymbol : Index -> String -> String -> Maybe Sym
bestSymbol idx curMod token = case findSymbol idx token of
  Ok syms => pickBestSymbol curMod syms
  Err e => Nothing

-- 当前文档的模块名（无 module 头 → ""）。
currentModuleName : List Decl -> Maybe ModDecl -> String
currentModuleName decls Nothing = ""
currentModuleName decls (Just (ModDecl name explicit items sp)) = name

-- 当前缓冲里的顶层名字（类型名 + 声明名），供补全使用。
declBufferNames : Decl -> List String
declBufferNames d = append (typeNamesOf [d]) (declNames d)

bufferNames : String -> List String
bufferNames text = case parseSource "<completion>" text of
  Err e => []
  Ok (SourceFile hdr imports fx decls) => dedupeNames (concatMap declBufferNames decls)

dedupeNames : List String -> List String
dedupeNames xs = dedupeNamesGo xs [] []

dedupeNamesGo : List String -> List String -> List String -> List String
dedupeNamesGo [] seen acc = reverse acc
dedupeNamesGo (x :: rest) seen acc =
  if memName x seen then dedupeNamesGo rest seen acc else dedupeNamesGo rest (x :: seen) (x :: acc)

-- ---------------------------------------------------------------
-- documentSymbol：AST 声明树
-- ---------------------------------------------------------------
declNameOf : Decl -> String
declNameOf (DData name params kind ctors derivings lin sp) = name
declNameOf (DAxiom name ty sp) = name
declNameOf (DExtern name cName ty sp) = name
declNameOf (DSig name ctx ty sp) = name
declNameOf (DFun name pats body sp) = name
declNameOf (DRecord name params fields derivings lin sp) = name
declNameOf (DTrait name params methods sp) = name
declNameOf (DInstance ctxE head methods sp) = "instance"

-- LSP SymbolKind：Function=12、Field=8、Interface=11、Constant=14、
-- EnumMember=22、Struct=23、Method=6。
declSymbolKind : Decl -> Int
declSymbolKind (DData name params kind ctors derivings lin sp) = 23
declSymbolKind (DRecord name params fields derivings lin sp) = 23
declSymbolKind (DTrait name params methods sp) = 11
declSymbolKind (DAxiom name ty sp) = 14
declSymbolKind (DExtern name cName ty sp) = 14
declSymbolKind (DSig name ctx ty sp) = 12
declSymbolKind (DFun name pats body sp) = 12
declSymbolKind (DInstance ctxE head methods sp) = 12

symbolJson : String -> Int -> Json -> Json -> List Json -> Json
symbolJson name kind range sel children =
  JObj
    (append [Pair "name" (JStr name), Pair "kind" (JNum kind), Pair "range" range, Pair "selectionRange" sel] (if isEmptyList children then [] else [Pair "children" (JArr children)]))

ctorSymbolJson : List String -> Ctor -> Json
ctorSymbolJson lines c =
  symbolJson (ctorName c) 22 (spanRange (ctorSpan c)) (nameSelRange lines (ctorSpan c) (ctorName c))
    []

fieldSymbolJson : List String -> Field -> Json
fieldSymbolJson lines f =
  symbolJson (fieldName f) 8 (spanRange (fieldSpan f))
    (nameSelRange lines (fieldSpan f) (fieldName f)) []

-- M30（B20）：方法子节点用方法签名 span（方法名到类型结束），不再复用 trait 声明 span。
methodSymbolJson : List String -> TraitMethod -> Json
methodSymbolJson lines m =
  symbolJson (traitMethodName m) 6 (spanRange (traitMethodSpan m))
    (nameSelRange lines (traitMethodSpan m) (traitMethodName m)) []

declChildrenJson : List String -> Decl -> List Json
declChildrenJson lines (DData name params kind ctors derivings lin sp) =
  map (ctorSymbolJson lines) ctors
declChildrenJson lines (DRecord name params fields derivings lin sp) =
  map (fieldSymbolJson lines) fields
declChildrenJson lines (DTrait name params methods sp) = map (methodSymbolJson lines) methods
declChildrenJson lines _ = []

declSymbolJson : List String -> Decl -> Json
declSymbolJson lines d =
  let
    sp = declSpan d
    name = declNameOf d
  in symbolJson name (declSymbolKind d) (spanRange sp) (nameSelRange lines sp name)
    (declChildrenJson lines d)

documentSymbols : String -> String -> List Json
documentSymbols uri text = case parseSource uri text of
  Err e => []
  Ok (SourceFile hdr imports fx decls0) => case formattingFixities uri text of
    Err _ => []
    Ok programFixities => case reorderProgram (tableOfKeepOps (append programFixities fx)) decls0 of
      Err e => []
      Ok decls => map (declSymbolJson (split "\n" text)) decls

-- ---------------------------------------------------------------
-- definition：位置 → token → Index → Location
-- ---------------------------------------------------------------
findDeclByName : String -> List Decl -> Maybe Decl
findDeclByName name [] = Nothing
findDeclByName name (d :: rest) =
  if memName name (declBufferNames d) then Just d else findDeclByName name rest

-- Index 不可用/未命中时的同文件兜底：在当前缓冲的顶层声明里找同名定义。
bufferDefinition : String -> String -> String -> Json
bufferDefinition uri text token = case parseSource uri text of
  Err e => JNull
  Ok (SourceFile hdr imports fx decls) => case findDeclByName (lastSegment token) decls of
    Nothing => JNull
    Just d =>
      JArr
        [JObj [Pair "uri" (JStr uri), Pair "range" (nameSelRange (split "\n" text) (declSpan d) (lastSegment token))]]

-- ---------------------------------------------------------------
-- references：Index refs（带出现位置）+ 定义位置
-- ---------------------------------------------------------------
refLocation : Index -> Ref -> Maybe Json
refLocation idx r = case modulePathOf idx (refModule r) of
  Nothing => Nothing
  Just path =>
    Just
      (JObj [Pair "uri" (JStr (pathToUri path)), Pair "range" (lspRange r.refLine r.refCol r.refLine (r.refCol + strLength (refName r)))])

referencesFor : Index -> String -> String -> List Json
referencesFor idx curMod token = case bestSymbol idx curMod token of
  Nothing => []
  Just sym =>
    let
      refs = case findReferences idx (symName sym) of
        Ok rs => take maxReferences rs
        Err e => []
      refLocs = mapMaybe (refLocation idx) refs
      defLocs = case symLocation idx sym of
        Nothing => []
        Just loc => [loc]
    in append defLocs refLocs

-- ---------------------------------------------------------------
-- completion
-- ---------------------------------------------------------------
record Compl where
  complLabel : String
  complKind : Int
  complDetail : String

complLabel : Compl -> String
complLabel (Compl label kind detail) = label

-- CompletionItemKind：Method=2、Function=3、Constructor=4、Field=5、Variable=6、
-- Class=7、Interface=8、Module=9、Keyword=14、Constant=21、Struct=22。
symCompletionKind : Sym -> Int
symCompletionKind s = case symKind s of
  "fun" => 3
  "data" => 22
  "record" => 22
  "trait" => 8
  "axiom" => 21
  "ctor" => 4
  "field" => 5
  "method" => 2
  _ => 6

symSymbolKind : Sym -> Int
symSymbolKind s = case symKind s of
  "data" => 23
  "record" => 23
  "trait" => 11
  "axiom" => 14
  "ctor" => 22
  "field" => 8
  "method" => 6
  _ => 12

complJson : Compl -> Json
complJson c =
  JObj
    (append [Pair "label" (JStr (complLabel c)), Pair "kind" (JNum c.complKind)] (if c.complDetail == "" then [] else [Pair "detail" (JStr c.complDetail)]))

dedupeCompls : List Compl -> List Compl
dedupeCompls xs = dedupeComplsGo xs [] []

dedupeComplsGo : List Compl -> List String -> List Compl -> List Compl
dedupeComplsGo [] seen acc = reverse acc
dedupeComplsGo (x :: rest) seen acc =
  if memName (complLabel x) seen then dedupeComplsGo rest seen acc
  else dedupeComplsGo rest (complLabel x :: seen) (x :: acc)

lspKeywords : List String
lspKeywords =
  [ "module",
    "import",
    "data",
    "record",
    "trait",
    "instance",
    "where",
    "deriving",
    "axiom",
    "let",
    "in",
    "case",
    "of",
    "do",
    "if",
    "then",
    "else",
    "Type",
    "True",
    "False"
  ]

bufferCompls : String -> List Compl
bufferCompls text = map (\n => Compl n 3 "") (bufferNames text)

keywordCompls : List Compl
keywordCompls = map (\n => Compl n 14 "") lspKeywords

indexCompls : Maybe Index -> List Compl
indexCompls Nothing = []
indexCompls (Just idx) =
  map (\s => Compl (symName s) (symCompletionKind s) (symSig s)) idx.indexSymbols

hasPrefix : String -> List Compl -> List Compl
hasPrefix prefix items = filter (\c => startsWith prefix (complLabel c)) items

finishCompls : List Compl -> List Json
finishCompls items = map complJson (take maxCompletions (dedupeCompls items))

-- `.` 之后的限定补全：前缀是模块名，按 `<module>.` 过滤符号全名。
qualifiedCompletions : String -> List Int -> Int -> String -> Maybe Index -> List Json
qualifiedCompletions ln chars prefixStart prefix Nothing = []
qualifiedCompletions ln chars prefixStart prefix (Just idx) =
  let
    beforeDotChars = take (prefixStart - 1) chars
    modLen = qualPrefixLen (reverse beforeDotChars)
    modStart = length beforeDotChars - modLen
    modPrefix = substring (natFromInt modStart) (natFromInt modLen) ln
    fullPrefix = "${modPrefix}."
    hits =
      filter (\s => startsWith fullPrefix (symFullName s) && startsWith prefix (symName s))
        idx.indexSymbols
  in finishCompls (map (\s => Compl (symName s) (symCompletionKind s) (symSig s)) hits)

completionItems : String -> Int -> Int -> Maybe Index -> List Json
completionItems text line0 col0 midx =
  let
    ln = lineText text (line0 + 1)
    chars = strUnpack ln
    p0 = clampInt 0 col0 (length chars)
    left = reverse (take p0 chars)
    prefixLen = wordPrefixLen left
    prefixStart = p0 - prefixLen
    afterDot = prefixStart > 0 && nthCode chars (prefixStart - 1) == 46
    prefix = substring (natFromInt prefixStart) (natFromInt prefixLen) ln
  in if afterDot then qualifiedCompletions ln chars prefixStart prefix midx
  else finishCompls
    (append (hasPrefix prefix keywordCompls) (append (hasPrefix prefix (bufferCompls text)) (hasPrefix prefix (indexCompls midx))))

-- ---------------------------------------------------------------
-- workspace/symbol
-- ---------------------------------------------------------------
matchingSymbols : Index -> String -> List Sym
matchingSymbols idx query = case findSymbol idx query of
  Ok syms => syms
  Err e =>
    filter (\s => contains query (symName s) || contains query (symFullName s)) idx.indexSymbols

symbolInfoJson : Index -> Sym -> Maybe Json
symbolInfoJson idx s = case symLocation idx s of
  Nothing => Nothing
  Just loc =>
    Just
      (JObj (append [Pair "name" (JStr (symName s)), Pair "kind" (JNum (symSymbolKind s)), Pair "location" loc] (if symModule s == "" then [] else [Pair "containerName" (JStr (symModule s))])))

workspaceSymbols : Maybe Index -> String -> List Json
workspaceSymbols Nothing query = []
workspaceSymbols (Just idx) query =
  let
    syms = if query == "" then idx.indexSymbols else matchingSymbols idx query
  in mapMaybe (symbolInfoJson idx) (take maxWorkspaceSymbols syms)

