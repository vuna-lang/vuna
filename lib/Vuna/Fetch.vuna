-- | `vuna fetch`：显式取包到持久 store（git / url），path 依赖只校验摘要。
module Vuna.Fetch where

-- Vuna.Fetch：包获取（阶段 1）。纪律（D15）：
--   * **只有 fetch 联网**；check/build/test 只读 store，缺对象报 `PKG_NotMaterialized`。
--   * `path` 依赖是可变输入（D12）：不复制进 store，只按声明摘要校验（无摘要则跳过）。
--   * `git` 依赖：clone → checkout rev → 收集内容 → 校验声明摘要 → 写对象 + 物化。
--   * `url` 依赖：URL 直指 **`pkg-source 1` 对象文件**（不是 tar/压缩包；vuna 没有解压
--     原语），下载后按 framing + 内容地址校验。
--   * `--locked`：不联网，只检查 store 是否已物化；缺失即失败。
-- 传输外置给宿主 `git` / `curl`；语言内只有裸 TCP 原语，不实现 TLS。
import Base.HostRow
import Vuna.Cli.Args
import Vuna.Compiler.Canonical.Pkg
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Pkg
import Vuna.Compiler.Frontend.Manifest
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Packages.Source
import Vuna.PackageStore
import Base.Nat
import Base.List
import Base.String

export runFetch : List String -> Eff hostRow Int
runFetch args = case parseToolArgs "vuna fetch" [BoolFlag "locked"] args of
  ErrC e => fetchFailText (diagText e)
  OkC parsed =>
    let
      locked = flagSet parsed "locked"
    in case parsed.positionals of
      [] => fetchAt "." locked
      [dir] => fetchAt dir locked
      _ => fetchFailText "too many arguments; expected at most one directory"

-- | 取一个包目录声明的**完整依赖闭包**。path 依赖递归进工作树目录；git/url 依赖
-- 物化后递归进 `pkgs/<digest>`。实现是「待处理目录队列 + visited」：`fetchAll` 与
-- `dirsOfDeps` 各自结构递归，不做函数间互递归（SCT 只认结构下降）。
export fetchAt : String -> Bool -> Eff hostRow Int
fetchAt dir locked = do
  abs <- absolutePath dir
  root <- storeRootEff
  fetchAll 64 root locked [abs] []

fetchAll : Int -> String -> Bool -> List String -> List String -> Eff hostRow Int
fetchAll fuel root locked [] visited = pure 0
fetchAll fuel root locked (dir :: rest) visited = if fuel <= 0 then fetchFailText "fetch: dependency depth limit exceeded (cycle?)"
else if memName dir visited then do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "fetch: ${dir} (cycle skipped)\n")
  fetchAll (fuel - 1) root locked rest visited
else do
  mdirs <- dirsOfPackage root locked dir
  case mdirs of
    Nothing => pure 1
    Just dirs => fetchAll (fuel - 1) root locked (append dirs rest) (dir :: visited)

dirsOfPackage : String -> Bool -> String -> Eff hostRow (Maybe (List String))
dirsOfPackage root locked dir = do
  let
    manifestPath = "${dir}/vuna.toml"
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists manifestPath)
    if exists then do
      raw <- raiseToRow hostRow (@vuna@prim_eff_readFile manifestPath)
      case parseManifest manifestPath raw of
        ErrC e => do
          _ <- printDiagEff e
          pure Nothing
        OkC manifest => case validateManifest manifest of
          ErrC e => do
            _ <- printDiagEff e
            pure Nothing
          OkC valid => dirsOfDeps root locked dir valid.manifestDependencies
    else do
      _ <- fetchFailText "missing vuna.toml in ${dir}"
      pure Nothing

dirsOfDeps : String -> Bool -> String -> List Dependency -> Eff hostRow (Maybe (List String))
dirsOfDeps root locked baseDir [] = pure (Just [])
dirsOfDeps root locked baseDir (dep :: rest) = do
  here <- dirOfDep root locked baseDir dep
  case here of
    Nothing => pure Nothing
    Just d => do
      there <- dirsOfDeps root locked baseDir rest
      case there of
        Nothing => pure Nothing
        Just ds => pure (Just (d :: ds))

dirOfDep : String -> Bool -> String -> Dependency -> Eff hostRow (Maybe String)
dirOfDep root locked baseDir dep = case depSourceOf dep of
  DepPath rel => do
    abs <- absolutePath (joinPath baseDir rel)
    files <- packageFilesEff abs
    code <- verifyPathDep dep (contentHashOf (PackageSource "" [] [] files))
    if code /= 0 then pure Nothing else pure (Just abs)
  DepGit url rev => case depHashOf dep of
    Nothing => do
      _ <- fetchFailText "dependency ${depAliasOf dep}: git source needs hash"
      pure Nothing
    Just expected => do
      let
        digest = normalizeHash expected
      in do
        done <- isMaterializedEff root digest
        if done then do
          _ <- raiseToRow hostRow (@vuna@prim_eff_print "fetch: ${depAliasOf dep} cached\n")
          pure (Just (materializedDir root digest))
        else if locked then do
          _ <- fetchFail (NotMaterialized (depAliasOf dep)) (depAliasOf dep)
          pure Nothing
        else do
          stored <- fetchGit root dep url rev digest
          case stored of
            Nothing => pure Nothing
            Just got => pure (Just (materializedDir root got))
  DepUrl u => case depHashOf dep of
    Nothing => do
      _ <- fetchFailText "dependency ${depAliasOf dep}: url source needs hash"
      pure Nothing
    Just expected => do
      let
        digest = normalizeHash expected
      in do
        done <- isMaterializedEff root digest
        if done then do
          _ <- raiseToRow hostRow (@vuna@prim_eff_print "fetch: ${depAliasOf dep} cached\n")
          pure (Just (materializedDir root digest))
        else if locked then do
          _ <- fetchFail (NotMaterialized (depAliasOf dep)) (depAliasOf dep)
          pure Nothing
        else do
          stored <- fetchUrl root dep u digest
          case stored of
            Nothing => pure Nothing
            Just got => pure (Just (materializedDir root got))

verifyPathDep : Dependency -> String -> Eff hostRow Int
verifyPathDep dep actual = case depHashOf dep of
  Nothing => do
    _ <-
      raiseToRow hostRow
        (@vuna@prim_eff_print "fetch: ${depAliasOf dep} path unlocked (${actual})\n")
    pure 0
  Just expected => if verifyHash expected actual then do
    _ <- raiseToRow hostRow (@vuna@prim_eff_print "fetch: ${depAliasOf dep} path ok\n")
    pure 0
  else hashMismatch (depAliasOf dep) expected actual

fetchGit : String -> Dependency -> String -> String -> String -> Eff hostRow (Maybe String)
fetchGit root dep url rev expected =
  let
    tmp = "${root}/tmp/git-${expected}"
  in do
    _ <- ensureDirPath root
    _ <- raiseToRow hostRow (@vuna@prim_eff_runIn root ["rm", "-rf", tmp])
    _ <- ensureDirPath tmp
    cloneCode <- raiseToRow hostRow (@vuna@prim_eff_runIn tmp ["git", "clone", "--quiet", url, "."])
    if cloneCode /= 0 then do
      _ <- fetchFail (FetchFailed url) url
      pure Nothing
    else do
      checkoutCode <-
        raiseToRow hostRow (@vuna@prim_eff_runIn tmp ["git", "checkout", "--quiet", rev])
      if checkoutCode /= 0 then do
        _ <- fetchFail (FetchFailed "${url}@${rev}") "${url}@${rev}"
        pure Nothing
      else do
        files <- packageFilesEff tmp
        verifyAndStore root dep expected (PackageSource "" [] [] files)

-- 校验声明摘要后写对象 + 物化（git 与 url 共用）；成功返回实际摘要。
verifyAndStore : String -> Dependency -> String -> PackageSource -> Eff hostRow (Maybe String)
verifyAndStore root dep expected ps =
  let
    actual = contentHashOf ps
  in if verifyHash expected actual then do
    _ <- writeObjectEff root actual ps.psFiles
    _ <- materializeEff root actual ps.psFiles
    _ <- raiseToRow hostRow (@vuna@prim_eff_print "fetch: ${depAliasOf dep} ok\n")
    pure (Just actual)
  else do
    _ <- hashMismatch (depAliasOf dep) expected actual
    pure Nothing

-- URL 直指 `pkg-source 1` 对象文件；下载后由 framing + 内容地址校验兜底。
fetchUrl : String -> Dependency -> String -> String -> Eff hostRow (Maybe String)
fetchUrl root dep url expected =
  let
    obj = objectPathOf root expected
  in do
    _ <- ensureDirPath "${root}/objects"
    code <- raiseToRow hostRow (@vuna@prim_eff_runIn root ["curl", "-fsSL", url, "-o", obj])
    if code /= 0 then do
      _ <- fetchFail (FetchFailed url) url
      pure Nothing
    else do
      got <- readObjectEff root expected
      case got of
        Nothing => do
          _ <- fetchFail (FetchFailed url) url
          pure Nothing
        Just files => do
          _ <- materializeEff root expected files
          _ <- raiseToRow hostRow (@vuna@prim_eff_print "fetch: ${depAliasOf dep} ok\n")
          pure (Just expected)

hashMismatch : String -> String -> String -> Eff hostRow Int
hashMismatch alias expected actual =
  let
    detail = "declared ${expected}, actual ${actual}"
  in case pkgNoLoc (HashMismatch alias detail) [alias, detail] of
    ErrC d => printDiagEff d
    OkC _ => pure 0

fetchFail : PkgErr (Succ Zero) -> String -> Eff hostRow Int
fetchFail e arg = case pkgNoLoc1 e arg of
  ErrC d => printDiagEff d
  OkC _ => pure 0

fetchFailText : String -> Eff hostRow Int
fetchFailText msg = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "error: ${msg}\n")
  pure 2

printDiagEff : Diagnostic -> Eff hostRow Int
printDiagEff d = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print (diagText d ++ "\n"))
  pure 1

-- ---------------------------------------------------------------
-- vuna pin：把 git 依赖的实际内容摘要写回 manifest（只改已有 `hash = ...` 行）
-- ---------------------------------------------------------------
export runPin : List String -> Eff hostRow Int
runPin args = case parseToolArgs "vuna pin" [] args of
  ErrC e => fetchFailText (diagText e)
  OkC parsed => case parsed.positionals of
    [] => pinAt "."
    [dir] => pinAt dir
    _ => fetchFailText "too many arguments; expected at most one directory"

pinAt : String -> Eff hostRow Int
pinAt dir = do
  abs <- absolutePath dir
  let
    manifestPath = "${abs}/vuna.toml"
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists manifestPath)
    if exists then do
      raw <- raiseToRow hostRow (@vuna@prim_eff_readFile manifestPath)
      case parseManifest manifestPath raw of
        ErrC e => printDiagEff e
        OkC manifest => case validateManifest manifest of
          ErrC e => printDiagEff e
          OkC valid => do
            root <- storeRootEff
            pins <- collectPins root (manifestDir manifestPath) valid.manifestDependencies []
            let
              updated = applyPins pins raw
            in if updated == raw then do
              _ <- raiseToRow hostRow (@vuna@prim_eff_print "pin: up to date\n")
              pure 0
            else do
              _ <- raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic manifestPath updated)
              _ <-
                raiseToRow hostRow
                  (@vuna@prim_eff_print "pin: updated ${strFromInt (listLen pins)} dependency hash(es)\n")
              pure 0
    else fetchFailText "missing vuna.toml in ${dir}"

-- 对每个 git 依赖取实际摘要（clone → 收集 → 写对象 + 物化）。url/path 不参与：
-- url 对象文件的地址只能由对象自身给出，path 是可变输入（D12）。
collectPins : String -> String -> List Dependency -> List (Pair String String) -> Eff hostRow (List (Pair String String))
collectPins root baseDir [] acc = pure (reverse acc)
collectPins root baseDir (dep :: rest) acc = case depSourceOf dep of
  DepPath rel => do
    _ <- raiseToRow hostRow (@vuna@prim_eff_print "pin: ${depAliasOf dep} path (skipped)\n")
    collectPins root baseDir rest acc
  DepUrl u => do
    _ <-
      raiseToRow hostRow
        (@vuna@prim_eff_print "pin: ${depAliasOf dep} url (skipped: url objects carry their own address)\n")
    collectPins root baseDir rest acc
  DepGit url rev => do
    actual <- resolveGitDigest root (depAliasOf dep) url rev
    case actual of
      Nothing => do
        _ <- fetchFailText "pin: cannot resolve ${depAliasOf dep} (${url}@${rev})"
        pure []
      Just digest => collectPins root baseDir rest (Pair (depAliasOf dep) digest :: acc)

resolveGitDigest : String -> String -> String -> String -> Eff hostRow (Maybe String)
resolveGitDigest root alias url rev =
  let
    tmp = "${root}/tmp/pin-${alias}"
  in do
    _ <- ensureDirPath root
    _ <- raiseToRow hostRow (@vuna@prim_eff_runIn root ["rm", "-rf", tmp])
    _ <- ensureDirPath tmp
    cloneCode <- raiseToRow hostRow (@vuna@prim_eff_runIn tmp ["git", "clone", "--quiet", url, "."])
    if cloneCode /= 0 then do
      _ <- raiseToRow hostRow (@vuna@prim_eff_print "pin: git clone failed for ${alias}\n")
      pure Nothing
    else do
      checkoutCode <-
        raiseToRow hostRow (@vuna@prim_eff_runIn tmp ["git", "checkout", "--quiet", rev])
      if checkoutCode /= 0 then do
        _ <- raiseToRow hostRow (@vuna@prim_eff_print "pin: git checkout failed for ${alias}\n")
        pure Nothing
      else do
        files <- packageFilesEff tmp
        let
          actual = contentHashOf (PackageSource "" [] [] files)
        in do
          _ <- writeObjectEff root actual files
          _ <- materializeEff root actual files
          pure (Just actual)

-- 文本写回：只替换 `[dependencies.<alias>]` 段内已有的 `hash = ...` 行（保留缩进）。
-- 没有 hash 行（内联表 / 字符串简写 / 尚未写摘要）时不动该段：pin 不替用户猜格式。
applyPins : List (Pair String String) -> String -> String
applyPins pins raw = join "\n" (pinGo pins (split "\n" raw) Nothing)

pinGo : List (Pair String String) -> List String -> Maybe String -> List String
pinGo pins [] current = []
pinGo pins (line :: rest) current = case depSectionAlias (trim line) of
  Just alias => line :: pinGo pins rest (Just alias)
  Nothing => if isSectionHeader (trim line) then line :: pinGo pins rest Nothing
  else case current of
    Just alias =>
      if startsWith "hash" (trim line) then replaceHashLine alias pins line :: pinGo pins rest current
      else line :: pinGo pins rest current
    Nothing => line :: pinGo pins rest current

depSectionAlias : String -> Maybe String
depSectionAlias t =
  if startsWith "[dependencies." t && endsWith "]" t then Just (substring 14 (natFromInt (strLength t - 15)) t)
  else Nothing

isSectionHeader : String -> Bool
isSectionHeader t = startsWith "[" t

replaceHashLine : String -> List (Pair String String) -> String -> String
replaceHashLine alias pins line = case lookupPin alias pins of
  Nothing => line
  Just digest => "hash = \"sha256:${digest}\""

lookupPin : String -> List (Pair String String) -> Maybe String
lookupPin alias [] = Nothing
lookupPin alias ((Pair name digest) :: rest) =
  if name == alias then Just digest else lookupPin alias rest

listLen : List a -> Int
listLen [] = 0
listLen (_ :: rest) = 1 + listLen rest
