module Vuna.Obs where

-- Vuna.Obs：`vuna obs` 的门面（工具链；**永不进 seed 闭包**）。
--
-- 分层：
--   * `Vuna.Obs.Types`    事件模型（M/X/C/i）+ schema 常量 + 纯解析/渲染原语；
--   * `Vuna.Obs.Read`     JSONL 读取（行号、空行跳过、末行截断降级为 warning）；
--   * `Vuna.Obs.Validate` §3 字段/时序/词汇表校验（error = 退出码 1）；
--   * `Vuna.Obs.Summarize` span 树折叠 → 阶段/计数/采样表 + `--json` + `--baseline` 差值；
--   * `Vuna.Obs.Run`      `vuna obs run`（env 注入 + 子进程 + trace 路径打印）；
--   * `Vuna.Obs.Flame`    CPU 采样 → 折叠栈（`convert --to folded` 与 `render` 共用）；
--   * `Vuna.Obs.Convert`  `convert --to cpuprofile|speedscope|folded|jsonl`；
--   * `Vuna.Obs.Render`   `render`（单文件 HTML：瀑布 / 火焰图 / 计数器与采样表）；
--   * `Vuna.Obs.Merge`    `merge`（多 trace → 一份合法 JSONL）；
--   * `Vuna.Obs.Symbols`  `symbols`（split 产物 `.ml` → `vuna-symbols 1` 符号表）；
--   * `Vuna.Obs.Serve`    `serve --cdp`（CDP Profiler 子集，Content-Length JSON-RPC；
--     **离线**：数据源是已有 trace 文件，不是 live sampling）。
--
-- 本模块只做**子命令分发与退出码**（0 成功 / 1 被观测内容语义失败 / 2 用法或前提不满足），
-- 参数解析与业务实现都在各子模块。
--
-- 范围（规范 §7）：`run` / `summarize` / `validate` / `convert` / `render` / `merge` /
-- `symbols` / `serve --cdp`。未知子命令仍回可操作错误 + 退出码 2（不静默 unknown）。
import Vuna.Cli.Args
import Vuna.Compiler.Base.Common
import Vuna.Json
import Vuna.Obs.Convert
import Vuna.Obs.Merge
import Vuna.Obs.Read
import Vuna.Obs.Render
import Vuna.Obs.Run
import Vuna.Obs.Serve
import Vuna.Obs.Summarize
import Vuna.Obs.Symbols
import Vuna.Obs.Validate
import Base.EffConsole
import Base.Eff.Types
import Base.EffClock
import Base.EffEnv
import Base.EffFs
import Base.EffNet
import Base.EffProcess

-- | `vuna obs <sub>` 的入口（`args` 是去掉 `obs` 之后的参数）。
export runObs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nNet NetOp r => List String -> Eff r Int
runObs [] = obsUsage
runObs (sub :: rest) = case sub of
  "run" => Vuna.Obs.Run.runObsRun rest
  "summarize" => obsSummarizeArgs rest
  "validate" => obsValidateArgs rest
  "convert" => Vuna.Obs.Convert.runObsConvert rest
  "render" => Vuna.Obs.Render.runObsRender rest
  "merge" => Vuna.Obs.Merge.runObsMerge rest
  "symbols" => Vuna.Obs.Symbols.runObsSymbols rest
  "serve" => Vuna.Obs.Serve.runObsServe rest
  _ => do
    _ <- consolePrint "error: unknown `vuna obs` subcommand `${sub}`\n${obsUsageText}"
    pure 2

obsUsageText : String
obsUsageText = """usage:
  vuna obs run [--level N] [--sample cpu|mem|both] [--interval US] [--out FILE] [--] <cmd...>
  vuna obs summarize [--json] [--baseline FILE] [--threshold PCT] [TRACE...]
  vuna obs validate TRACE
  vuna obs convert --to cpuprofile|speedscope|folded|jsonl [--out PATH] TRACE
  vuna obs render --out FILE TRACE
  vuna obs merge [--out FILE] TRACE...
  vuna obs symbols [--out FILE] [OUTDIR]
  vuna obs serve --cdp ADDR [--allow-slow] [TRACE...]
"""

obsUsage : Member nConsole ConsoleOp r => Eff r Int
obsUsage = do
  _ <- consolePrint obsUsageText
  pure 2

-- ---------------------------------------------------------------
-- validate
-- ---------------------------------------------------------------
obsValidateArgs : Member nFs FsOp r, Member nConsole ConsoleOp r => List String -> Eff r Int
obsValidateArgs args = case parseToolArgs "vuna obs validate" [] args of
  ErrC e => obsError (diagText e)
  OkC parsed => case parsed.positionals of
    [path] => obsValidateFile path
    [] => obsError "usage: vuna obs validate TRACE"
    _ => obsError "usage: vuna obs validate TRACE (exactly one trace)"

obsValidateFile : Member nFs FsOp r, Member nConsole ConsoleOp r => String -> Eff r Int
obsValidateFile path = do
  reportR <- validateTraceFile path
  case reportR of
    ErrC e => obsError (diagText e)
    OkC report => do
      _ <- printIssues report.validateIssues
      errors <- pure (countErrors report)
      if errors > 0 then do
        _ <-
          consolePrint
            "error: ${strFromInt errors} error(s), ${strFromInt (countWarnings report)} warning(s) (${path})\n"
        pure 1
      else do
        _ <-
          consolePrint
            "${verifySummary report}, ${strFromInt (countWarnings report)} warning(s) (${path})\n"
        pure 0

printIssues : Member nConsole ConsoleOp r => List ValidateIssue -> Eff r Int
printIssues [] = pure 0
printIssues (i :: rest) = do
  _ <- consolePrint "${issueText i}\n"
  printIssues rest

-- ---------------------------------------------------------------
-- summarize
-- ---------------------------------------------------------------
obsSummarizeArgs : Member nFs FsOp r, Member nConsole ConsoleOp r => List String -> Eff r Int
obsSummarizeArgs args = case parseToolArgs "vuna obs summarize" [BoolFlag "json", ValueFlag "baseline", ValueFlag "threshold"] args of
  ErrC e => obsError (diagText e)
  OkC parsed => case thresholdOf parsed of
    ErrC e => obsError (diagText e)
    OkC threshold => case parsed.positionals of
      [] =>
        obsError "usage: vuna obs summarize [--json] [--baseline FILE] [--threshold PCT] [TRACE...]"
      traces => do
        baseR <- baselineOf parsed
        case baseR of
          ErrC e => obsError (diagText e)
          OkC base => summarizeTraces parsed threshold base traces

-- `--threshold`：缺省 10（百分比，非负整数）。
thresholdOf : Parsed -> Check Int
thresholdOf parsed = case flagValue parsed "threshold" of
  Nothing => OkC 10
  Just text => case parseNonNegIntText text of
    Just n => OkC n
    Nothing => err "--threshold must be a non-negative integer (percent), got `${text}`"

parseNonNegIntText : String -> Maybe Int
parseNonNegIntText s = if s == "" then Nothing else parseDigits (strUnpack s) 0 False

parseDigits : List Int -> Int -> Bool -> Maybe Int
parseDigits [] acc neg = Just (if neg then 0 - acc else acc)
parseDigits (c :: rest) acc neg =
  if c == 45 && not neg then parseDigits rest acc True
  else if c >= 48 && c <= 57 then parseDigits rest (acc * 10 + (c - 48)) neg else Nothing

baselineOf : Member nFs FsOp r => Parsed -> Eff r (Check (Maybe ObsSummary))
baselineOf parsed = case flagValue parsed "baseline" of
  Nothing => pure (OkC Nothing)
  Just path => do
    traceR <- readTraceFull path
    case traceR of
      ErrC e => pure (err "baseline: ${diagText e}")
      OkC trace => pure (OkC (Just (summarizeTrace trace)))

-- 无 TRACE 时用法错误（见调用方）；多个 TRACE 逐个输出，任一退出非 0 就停（不吞错误）。
summarizeTraces : Member nFs FsOp r, Member nConsole ConsoleOp r => Parsed -> Int -> Maybe ObsSummary -> List String -> Eff r Int
summarizeTraces parsed threshold base [] = pure 0
summarizeTraces parsed threshold base (path :: rest) = do
  traceR <- readTraceFull path
  case traceR of
    ErrC e => obsError (diagText e)
    OkC trace => do
      code <- emitSummary parsed threshold base path (summarizeTrace trace)
      if code /= 0 then pure code else summarizeTraces parsed threshold base rest

emitSummary : Member nConsole ConsoleOp r => Parsed -> Int -> Maybe ObsSummary -> String -> ObsSummary -> Eff r Int
emitSummary parsed threshold Nothing path summary = if flagSet parsed "json" then do
  _ <- obsLine (renderJson (summaryJson summary))
  pure 0
else do
  rows <-
    pure
      (append (append ["trace: ${path}"] (renderStageTable summary)) (append (renderCounterTable summary) (renderSampleSection summary)))
  _ <- printRows rows
  pure 0
emitSummary parsed threshold (Just baseSummary) path summary =
  emitDelta parsed threshold baseSummary path summary

emitDelta : Member nConsole ConsoleOp r => Parsed -> Int -> ObsSummary -> String -> ObsSummary -> Eff r Int
emitDelta parsed threshold baseSummary path summary =
  emitDeltaGo parsed threshold summary path (diffSummaries baseSummary summary)

emitDeltaGo : Member nConsole ConsoleOp r => Parsed -> Int -> ObsSummary -> String -> List StageDelta -> Eff r Int
emitDeltaGo parsed threshold summary path deltas =
  let
    maxPct = maxAbsDeltaPct deltas
    exceeds = maxPct > threshold
  in if flagSet parsed "json" then do
    _ <- obsLine (renderJson (summaryWithBaselineJson summary deltas))
    pure (if exceeds then 1 else 0)
  else do
    rows <-
      pure (append ["trace: ${path}"] (append (renderStageTable summary) (renderDeltaTable deltas)))
    _ <- printRows rows
    if exceeds then do
      _ <-
        consolePrint
          "error: regression exceeds --threshold ${strFromInt threshold}% (max ${strFromInt maxPct}%)\n"
      pure 1
    else do
      _ <-
        consolePrint "ok: max delta ${strFromInt maxPct}% (--threshold ${strFromInt threshold}%)\n"
      pure 0

-- `--json` + `--baseline`：在标准摘要上再嵌一个 `baseline` 字段（仍是单行 JSON）。
summaryWithBaselineJson : ObsSummary -> List StageDelta -> Json
summaryWithBaselineJson summary deltas = case summaryJson summary of
  JObj kvs => JObj (append kvs [Pair "baseline" (deltasJson deltas)])
  other => other

printRows : Member nConsole ConsoleOp r => List String -> Eff r Int
printRows [] = pure 0
printRows (row :: rest) = do
  _ <- consolePrint "${row}\n"
  printRows rest

obsLine : Member nConsole ConsoleOp r => String -> Eff r Int
obsLine s = fmap natToInt (consolePrint "${s}\n")

-- ---------------------------------------------------------------
-- 错误出口（用法/前提 = 退出码 2）
-- ---------------------------------------------------------------
obsError : Member nConsole ConsoleOp r => String -> Eff r Int
obsError e = do
  _ <- consolePrint "error: ${e}\n"
  pure 2
