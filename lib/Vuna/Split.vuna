module Vuna.Split (SplitFile, splitName, splitText, splitInitFiles, writeSplitFiles, splitCompileOrder, buildScript) where

-- Vuna.Split：分离编译（M12）的输出文件模型与构建脚本生成。
--
-- TypedCodegen.generateSplitProgram 产出 `List SplitFile`（相对文件名 + 内容）；
-- 本模块负责落盘并生成增量构建脚本：
--   - 编译顺序由 generateSplitProgram 给定（Vuna_runtime → 依赖拓扑序模块 → Main）；
--   - 每模块 .ml/.mli 变化、或任一更早模块的 .cmi 比本模块 .cmx 新 → 只重编本模块
--     （模块 open 链让所有更早模块都是依赖，保守但正确）；
--   - 最后链接成可执行文件。
-- 构建脚本只用 POSIX sh + ocamlopt，可在 Nix 沙箱内复现。

import Vuna.Base

data SplitFile : Type where
  SplitFile : String -> String -> SplitFile

splitName (SplitFile name text) = name

splitText (SplitFile name text) = text

-- 先结束条目（.mli/.ml 文件名列表），供 CLI/脚本使用。
splitInitFiles Nil = Nil

splitInitFiles (Cons f rest) = Cons (splitName f) (splitInitFiles rest)

writeSplitFiles : String -> List SplitFile -> Result Int
writeSplitFiles dir Nil = Ok 0

writeSplitFiles dir (Cons f rest) =
  andThen (writeSplitFiles dir rest) (\n =>
    let _ = writeFile (dir ++ "/" ++ splitName f) (splitText f)
    in Ok (n + 1))

-- 编译单元顺序：按输出顺序取 .ml（跳过 .mli 与 Vuna_runtime.ml 之后不重复）。
splitCompileOrder : List String -> List String
splitCompileOrder Nil = Nil

splitCompileOrder (Cons name rest) =
  if endsWith ".ml" name then Cons (stripMl name) (splitCompileOrder rest)
  else splitCompileOrder rest

stripMl name = substring 0 (strLength name - 3) name

-- 增量构建脚本；names 是编译单元（无扩展名）顺序，最后 Link 到 "$OUT"。
buildScript : List String -> String
buildScript names =
  "#!/bin/sh\n"
  ++ "# 由 vuna 生成：分离编译增量构建脚本（M12）。用法: ./build.sh [OUT]\n"
  ++ "set -eu\n"
  ++ "cd \"$(dirname \"$0\")\"\n"
  ++ "OUT=${1:-program}\n"
  ++ "FLAGS=\"-g -w -a+39 -warn-error +39\"\n"
  ++ "compile_mod() {\n"
  ++ "  base=$1\n"
  ++ "  shift\n"
  ++ "  stale=0\n"
  ++ "  [ -f \"$base.cmx\" ] || stale=1\n"
  ++ "  if [ \"$stale\" -eq 0 ] && [ \"$base.ml\" -nt \"$base.cmx\" ]; then stale=1; fi\n"
  ++ "  if [ -f \"$base.mli\" ]; then\n"
  ++ "    [ -f \"$base.cmi\" ] || stale=1\n"
  ++ "    if [ \"$stale\" -eq 0 ] && [ \"$base.mli\" -nt \"$base.cmi\" ]; then stale=1; fi\n"
  ++ "  fi\n"
  ++ "  for dep in \"$@\"; do\n"
  ++ "    if [ \"$stale\" -eq 0 ] && [ -f \"$dep.cmi\" ] && [ \"$dep.cmi\" -nt \"$base.cmx\" ]; then stale=1; fi\n"
  ++ "    if [ \"$stale\" -eq 1 ]; then break; fi\n"
  ++ "  done\n"
  ++ "  if [ \"$stale\" -eq 1 ]; then\n"
  ++ "    echo \"compile $base\"\n"
  ++ "    if [ -f \"$base.mli\" ]; then ocamlopt $FLAGS -c \"$base.mli\"; fi\n"
  ++ "    ocamlopt $FLAGS -c \"$base.ml\"\n"
  ++ "  fi\n"
  ++ "}\n"
  ++ compileCalls names Nil
  ++ "ocamlopt $FLAGS -o \"$OUT\" " ++ joinCmxs names ++ "\n"
  ++ "echo \"built $OUT\"\n"

depsSuffix Nil = ""

depsSuffix (Cons dep rest) = " " ++ dep ++ depsSuffix rest

compileCalls Nil prev = ""

compileCalls (Cons name rest) prev =
  "compile_mod " ++ name ++ depsSuffix prev ++ "\n" ++ compileCalls rest (Cons name prev)

joinCmxs Nil = ""

joinCmxs (Cons name Nil) = name ++ ".cmx"

joinCmxs (Cons name rest) = name ++ ".cmx " ++ joinCmxs rest
