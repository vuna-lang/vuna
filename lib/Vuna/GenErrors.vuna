module Vuna.GenErrors (runGenErrors) where

-- Vuna.GenErrors：从**枚举真源**生成错误码文档。
--
-- M30 重构后不再扫源码 `-- @code` 注释：code、模板、说明、规则名、修复动作
-- 全部来自三个枚举表——
--   Vuna.Compiler.Diagnostics 的 `tcAll` / `cgAll`（TC_/CG_），
--   Vuna.Lint.Diagnostics 的 `lintAll`（LN_），
-- 由此消除了旧实现「扫注释 + 从消息字面量反推前缀」的双重真源（findMsg 已删除）。
-- FX_（自动修复码）由可修复的 LN_ 规则派生：`FX_` + 规则名去 `-`。
-- 纯数据渲染，不读文件、不跑类型检查；生成物不纳入 git（docs/.generated/ 在 .gitignore）。
import Vuna.Cli.Args
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Diagnostics.Rn
import Vuna.Compiler.Diagnostics.Pkg
import Vuna.Compiler.Diagnostics.Warning
import Vuna.Compiler.Frontend.Diagnostics
import Vuna.Compiler.Loader.Diagnostics
import Vuna.Files
import Vuna.Lint.Diagnostics
import Base.List
import Base.String

record Entry where
  entryCode : String
  entryMsg : String
  entryDesc : String
  entryRule : String
  entryEdit : String
  entryFixable : Bool

entryFixable : Entry -> Bool
entryFixable (Entry c m d r e f) = f

-- ---------------------------------------------------------------
-- 枚举表 → Entry（唯一数据来源）
-- ---------------------------------------------------------------
tcEntryToEntry : TcEntry -> Entry
tcEntryToEntry e = Entry e.tcEntryCode e.tcEntryTemplate e.tcEntryDesc "" "" False

cgEntryToEntry : CgEntry -> Entry
cgEntryToEntry e = Entry e.cgEntryCode e.cgEntryTemplate e.cgEntryDesc "" "" False

lintEntryToEntry : LintEntry -> Entry
lintEntryToEntry e =
  Entry e.lintEntryCode "" e.lintEntryDesc e.lintEntryRule e.lintEntryEdit e.lintEntryFixable

lexEntryToEntry : LexEntry -> Entry
lexEntryToEntry e = Entry e.lexEntryCode e.lexEntryTemplate e.lexEntryDesc "" "" False

psEntryToEntry : PsEntry -> Entry
psEntryToEntry e = Entry e.psEntryCode e.psEntryTemplate e.psEntryDesc "" "" False

icEntryToEntry : IcEntry -> Entry
icEntryToEntry e = Entry e.icEntryCode e.icEntryTemplate e.icEntryDesc "" "" False

warnEntryToEntry : WarnEntry -> Entry
warnEntryToEntry e = Entry e.warnEntryCode e.warnEntryTemplate e.warnEntryDesc "" "" False

pkgEntryToEntry : PkgEntry -> Entry
pkgEntryToEntry e = Entry e.pkgEntryCode e.pkgEntryTemplate e.pkgEntryDesc "" "" False

rnEntryToEntry : RnEntry -> Entry
rnEntryToEntry e = Entry e.rnEntryCode e.rnEntryTemplate e.rnEntryDesc "" "" False

ldEntryToEntry : LdEntry -> Entry
ldEntryToEntry e = Entry e.ldEntryCode e.ldEntryTemplate e.ldEntryDesc "" "" False

allEntries : List Entry
allEntries =
  append (map tcEntryToEntry tcAll)
    (append (map cgEntryToEntry cgAll) (append (map lintEntryToEntry lintAll) (append (map lexEntryToEntry lexAll) (append (map psEntryToEntry psAll) (append (map icEntryToEntry icAll) (append (map rnEntryToEntry rnAll) (append (map pkgEntryToEntry pkgAll) (append (map warnEntryToEntry warnAll) (map ldEntryToEntry ldAll)))))))))

runGenErrors : String -> Eff [] Int
runGenErrors root = do
  rootR <- requireDirectory root
  case rootR of
    ErrC e => genErrorsError (diagText e)
    OkC _ => do
      doc <- renderDoc allEntries
      _ <- ensureDirPath (parentOf "${root}/docs/.generated/errors.md")
      _ <- prim_eff_writeFile "${root}/docs/.generated/errors.md" doc
      catalog <- renderCatalogJson allEntries
      _ <- prim_eff_writeFile "${root}/docs/.generated/errors.json" catalog
      _ <- prim_eff_print "wrote ${root}/docs/.generated/errors.md (${length allEntries} codes)\n"
      pure 0

genErrorsError : String -> Eff [] Int
genErrorsError e = do
  _ <- prim_eff_print "error: ${e}\n"
  pure 2

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
renderDoc : List Entry -> Eff [] String
renderDoc entries = do
  tcs <- renderTable (filter (isDomain "TC_") entries)
  cgs <- renderTable (filter (isDomain "CG_") entries)
  lxs <- renderTable (filter (isDomain "LX_") entries)
  pss <- renderTable (filter (isDomain "PS_") entries)
  lds <- renderTable (filter (isDomain "LD_") entries)
  ics <- renderTable (filter (isDomain "IC_") entries)
  rns <- renderTable (filter (isDomain "RN_") entries)
  pkgs <- renderTable (filter (isDomain "PKG_") entries)
  uns <- renderTable (filter (isDomain "UN_") entries)
  lns <- pure (renderLintTable (filter (isDomain "LN_") entries))
  fxs <- pure (renderLintTable (fixEntries entries))
  pure ("""# vuna 错误码

由 `vuna gen-errors` 从枚举真源（`Vuna.Compiler.Diagnostics` 的 `tcAll`/`cgAll`、
`Vuna.Compiler.Frontend.Diagnostics` 的 `lexAll`/`psAll`、`Vuna.Compiler.Loader.Diagnostics` 的 `ldAll`、
`Vuna.Lint.Diagnostics` 的 `lintAll`）生成；**勿手改**（生成物，不纳入 git）。

约定：运行诊断输出 `[CODE] 消息`；符号语义稳定、只增不删；
域前缀 TC_/CG_/LX_/PS_/RN_/PKG_/LD_/IC_/UN_/LN_/FX_。
模板中 `<0>`/`<1>` 是插值占位符，arity 由枚举构造子的类型索引在编译期锁定。

## 类型检查 / 精化（TC_）

${tcs}
## 代码生成（CG_）

${cgs}
## 词法（LX_）

${lxs}
## 语法（PS_）

${pss}
## 名字解析（RN_）

${rns}
## 告警（UN_）

${uns}
## 包清单（PKG_）

${pkgs}
## 模块加载（LD_）

${lds}
## 内部错误（IC_）

${ics}
## Lint 规则（LN_）

${lns}
## 修复规则（FX_）

${fxs}
"""
  )

isDomain : String -> Entry -> Bool
isDomain dom e = startsWith dom e.entryCode

renderTable : List Entry -> Eff [] String
renderTable [] = pure "（无）\n"
renderTable entries = do
  rows <- mapEff renderRow entries
  pure ("""| code | severity | phase | category | 消息 | 说明 | example |
| --- | --- | --- | --- | --- | --- | --- |
${join "\n" rows}
"""
  )

renderRow : Entry -> Eff [] String
renderRow e = do
  example <- exampleCell e.entryCode
  pure
    "| ${e.entryCode} | ${diagSeverityOf (codeDomain e.entryCode)} | ${diagPhaseOf (codeDomain e.entryCode)} | ${diagCategoryOf (codeDomain e.entryCode)} | `${escapeMsg e.entryMsg}` | ${e.entryDesc} | ${example} |"

renderLintTable : List Entry -> String
renderLintTable [] = "（无）\n"
renderLintTable entries = """| code | severity | phase | category | 规则 | 说明 | 自动修复 |
| --- | --- | --- | --- | --- | --- | --- |
${join "\n" (map renderLintRow entries)}
"""

renderLintRow : Entry -> String
renderLintRow e =
  "| ${e.entryCode} | ${diagSeverityOf (codeDomain e.entryCode)} | ${diagPhaseOf (codeDomain e.entryCode)} | ${diagCategoryOf (codeDomain e.entryCode)} | `${e.entryRule}` | ${e.entryDesc} | ${fixCell e} |"

fixCell : Entry -> String
fixCell e = if entryFixable e then "是" else "否"

-- 消息里反引号转成单引号（避免 Markdown 代码标记冲突）。
escapeMsg : String -> String
escapeMsg m = join "'" (split "`" m)

-- FX_：从可修复的 LN_ 推导（code = FX_ + 规则名去 `-`）。
fixEntries : List Entry -> List Entry
fixEntries entries = map fxOf (filter entryFixable (filter (isDomain "LN_") entries))

fxOf : Entry -> Entry
fxOf e =
  Entry "FX_${join "" (split "-" e.entryRule)}" e.entryMsg e.entryEdit e.entryRule e.entryEdit True

-- 效果列表遍历（本模块自用；顺序与纯 `map` 一致，示例夹具查找按此顺序发生）。
mapEff : (a -> Eff [] b) -> List a -> Eff [] (List b)
mapEff f [] = pure []
mapEff f (x :: rest) = do
  y <- f x
  ys <- mapEff f rest
  pure (y :: ys)

-- 目录 JSON：与 errors.md 同源（生成物，供工具/编辑器消费）。自带最小转义，
-- 刻意不依赖 Vuna.Json（避免把 GenErrors 加进 Json 的依赖扇出）。
renderCatalogJson : List Entry -> Eff [] String
renderCatalogJson entries = do
  texts <- mapEff entryJsonText entries
  pure ("{\"version\":1,\"codes\":[" ++ join "," texts ++ "]}")

entryJsonText : Entry -> Eff [] String
entryJsonText e = do
  example <- exampleField e.entryCode
  pure
    ("{" ++ join "," [field "code" e.entryCode, field "severity" (diagSeverityOf (codeDomain e.entryCode)), field "phase" (diagPhaseOf (codeDomain e.entryCode)), field "category" (diagCategoryOf (codeDomain e.entryCode)), field "message" e.entryMsg, field "desc" e.entryDesc, field "rule" e.entryRule, field "edit" e.entryEdit, " \"fixable\":" ++ (if e.entryFixable then "true" else "false") ++ " "] ++ example ++ "}")

field : String -> String -> String
field k v = " \"${k}\":${jsonQuote v} "

jsonQuote : String -> String
jsonQuote s = "\"" ++ join "" (map jsonEscapeChar (strUnpack s)) ++ "\""

jsonEscapes : List (Pair Int String)
jsonEscapes = [Pair 34 "\\\"", Pair 92 "\\\\", Pair 10 "\\n", Pair 13 "\\r", Pair 9 "\\t"]

jsonEscapeChar : Int -> String
jsonEscapeChar c = case lookupEscape c jsonEscapes of
  Just s => s
  Nothing => if c < 32 then "\\u00" ++ hexPair c else strPack [c]

lookupEscape : Int -> List (Pair Int String) -> Maybe String
lookupEscape c [] = Nothing
lookupEscape c ((Pair k v) :: rest) = if c == k then Just v else lookupEscape c rest

hexPair : Int -> String
hexPair c = strPack [hexDigit (c / 16), hexDigit (c - c / 16 * 16)]

hexDigit : Int -> Int
hexDigit n = if n < 10 then 48 + n else 87 + n

exampleCell : String -> Eff [] String
exampleCell code = do
  found <- exampleOf code
  pure (case found of
    Just p => p
    Nothing => "—"
  )

jsonExample : String -> Eff [] String
jsonExample code = do
  found <- exampleOf code
  pure (case found of
    Just p => jsonQuote p
    Nothing => "null"
  )

exampleField : String -> Eff [] String
exampleField code = do
  found <- exampleOf code
  pure (case found of
    Just p => "," ++ field "example" p
    Nothing => ""
  )
