module Vuna.Index.Render (renderApi, renderModules, renderOverview) where

-- Vuna.Index.Render：`vuna map` / `vuna api` 的文本渲染（M24 后维护·源码重组）。
-- 纯字符串拼装，不读源码。M30 删除 `renderDocWithComments`：`vuna doc --with-comments`
-- 从未实现（flag 已删），doc 现在由 Vuna.Doc 直接按源码 + `[export]` 渲染。
import Vuna.Compiler.Common
import Vuna.Index.Types

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
-- 总览：按包分组的模块表。
renderOverview : Index -> String
renderOverview index =
  let
    ms = indexModules index
    pkgs = distinct (map modPackage ms)
  in "${join "\n" (map (overviewSection ms) pkgs)}\n"

overviewSection : List ModuleInfo -> String -> String
overviewSection ms pkg =
  let
    mine = filter (\m => modPackage m == pkg) ms
    title = if pkg == "" then "(no package)" else pkg
  in "\n## ${title}\n\n${join "\n" (map (\m => "  ${modName m}  ${modBytes m}B  ${modDecls m} decls") mine)}"

renderModules : Index -> String
renderModules index =
  "${join "\n" (map (\m => "${modName m}  ${modPath m}") (indexModules index))}\n"

-- 某模块的 API 面（签名 + 行号 + 注释）。
renderApi : Index -> String -> Result String
renderApi index modQuery =
  let
    syms = filter (\s => symModule s == modQuery) index.indexSymbols
  in if length syms == 0 then Err "no such module: ${modQuery}"
  else Ok "## ${modQuery}\n\n${join "\n" (map apiRow syms)}"

apiRow : Sym -> String
apiRow s =
  "  ${symName s} : ${symSig s}  -- line ${symLine s}${if s.symDoc == "" then "" else "\n${join "\n" (map (\l => "      ${l}") (lines s.symDoc))}"}"
