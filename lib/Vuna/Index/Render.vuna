module Vuna.Index.Render (renderApi, renderDocWithComments, renderModules, renderOverview) where

-- Vuna.Index.Render：`vuna map` / `vuna api` / `vuna doc --with-comments` 的文本渲染
-- （M24 后维护·源码重组）。纯字符串拼装，不读源码。
import Vuna.Compiler.Common
import Vuna.Index.Types

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
-- 总览：按包分组的模块表。
renderOverview : Index -> String
renderOverview index =
  let
    ms = indexModules index
    pkgs = distinct (map modPackage ms)
  in join "\n" (map (overviewSection ms) pkgs) ++ "\n"

overviewSection : List ModuleInfo -> String -> String
overviewSection ms pkg =
  let
    mine = filter (\m => modPackage m == pkg) ms
    title = if pkg == "" then "(no package)" else pkg
  in "\n## "
    ++ title
    ++ "\n\n"
    ++ join "\n" (map (\m => "  " ++ modName m ++ "  " ++ strFromInt (modBytes m) ++ "B" ++ "  " ++ strFromInt (modDecls m) ++ " decls") mine)

renderModules : Index -> String
renderModules index =
  join "\n" (map (\m => modName m ++ "  " ++ modPath m) (indexModules index)) ++ "\n"

-- 某模块的 API 面（签名 + 行号 + 注释）。
renderApi : Index -> String -> Result String
renderApi index modQuery =
  let
    syms = filter (\s => symModule s == modQuery) (indexSymbols index)
  in if syms == [] then Err ("no such module: " ++ modQuery)
  else Ok ("## " ++ modQuery ++ "\n\n" ++ join "\n" (map apiRow syms))

apiRow : Sym -> String
apiRow s =
  "  "
    ++ symName s
    ++ " : "
    ++ symSig s
    ++ "  -- line "
    ++ strFromInt (symLine s)
    ++ (if symDoc s == "" then "" else "\n      " ++ symDoc s)

-- `vuna doc --with-comments`：模块 + 签名 + 紧邻注释。
renderDocWithComments : Index -> String
renderDocWithComments index =
  let
    mods = distinct (map symModule (indexSymbols index))
  in join "\n" (map (docSection index) mods)

docSection : Index -> String -> String
docSection index modQuery =
  let
    syms =
      filter
        (\s => symModule s == modQuery && (symKind s == "fun" || symKind s == "data" || symKind s == "record" || symKind s == "trait"))
        (indexSymbols index)
  in "## " ++ modQuery ++ "\n\n```vuna\n" ++ join "\n" (map docRow syms) ++ "```\n"

docRow : Sym -> String
docRow s =
  (if symDoc s == "" then "" else "-- " ++ symDoc s ++ "\n")
    ++ symName s
    ++ " : "
    ++ symSig s
    ++ "\n\n"
