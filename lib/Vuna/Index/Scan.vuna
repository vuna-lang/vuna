module Vuna.Index.Scan where

-- Vuna.Index.Scan：parse 级扫描、符号抽取、全量构建与索引缓存。
--
-- 缓存设计：`index:<dir>` 查询图节点 + 内容寻址 blob（见文件尾的实现）。
--   - 依赖表两条路径：CLI 用逐源文件内容哈希（C11：同 size + 同 mtime 的内容变更也
--     必须失效），REPL 用 stat 键（安全窗内回落内容哈希，`indexStatsOf`）；
--   - 命中 ⇒ 读 `<cache>/blobs/<digest>` 解码（`Index.Codec`）；未命中 ⇒ 全量重建 +
--     写 blob + 提交节点 + 落会话索引；每次 miss 只提交调用方选定的一个节点。
--
-- **没有「刷新索引」命令**：`vuna map` / `vuna api` / REPL 自己判新鲜度。
-- `Store` 是唯一写盘层，帧格式与内容地址校验见 `Vuna.Compiler.Store`。
--
-- 效果显式化：目录遍历、读文件、缓存写、时钟全部显式在 `Eff []` 里；纯数据逻辑
-- （路径/哈希/JSON 渲染/序列化解析）保持纯函数；`indexStatsOf` 只产出 stat 快照。
import Vuna.Compiler.Common
import Base.HashMap
import Base.Hashable
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Packages.Pkg
import Vuna.Doc.Comments
import Vuna.Doc.Types
import Vuna.FixityEnv
import Vuna.Index.Types
import Vuna.Sig
import Vuna.Index.Codec
import Vuna.Tool.Session

-- C41：工具链 fuel 耗尽不是「空结果」，而是内部不变量被破坏；与编译器一致硬失败。
indexFuelExhausted : String -> a
indexFuelExhausted what = prim_fail "vuna: internal: ${what} fuel exhausted"

-- ---------------------------------------------------------------
-- 小型 helper（本模块自用，避免污染 Base）
-- ---------------------------------------------------------------
splitChars : Int -> List Int -> List String -> List Int -> List String
splitChars sep [] acc seg = reverse (strPack (reverse seg) :: acc)
splitChars sep (c :: rest) acc seg =
  if c == sep then splitChars sep rest (strPack (reverse seg) :: acc) []
  else splitChars sep rest acc (c :: seg)

parseIntGo : List Int -> Int -> Maybe Int
parseIntGo [] acc = Just acc
parseIntGo (c :: rest) acc =
  if c >= 48 && c <= 57 then parseIntGo rest (acc * 10 + (c - 48)) else Nothing

dropPrefix : String -> String -> String
dropPrefix prefix s =
  if startsWith prefix s then substring (byteLength prefix) (byteLength s - byteLength prefix) s
  else s

-- ---------------------------------------------------------------
-- 效果列表遍历（本模块自用；顺序与纯 `map` / `concatMap` 一致）
-- ---------------------------------------------------------------
mapEff : (a -> Eff [] b) -> List a -> Eff [] (List b)
mapEff f [] = pure []
mapEff f (x :: rest) = do
  y <- f x
  ys <- mapEff f rest
  pure (y :: ys)

concatMapEff : (a -> Eff [] (List b)) -> List a -> Eff [] (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

-- ---------------------------------------------------------------
-- 目录遍历
-- ---------------------------------------------------------------
skipDir : String -> Bool
skipDir name =
  name == "."
    || name == ".."
    || name == ".git"
    || name == ".local"
    || name == ".output"
    || name == ".direnv"
    || name == "seed"
    || name == "_scratch"
    || name == ".dsh-plugins"
    || name == "result"
    || name == "node_modules"
    || name == ".vscode"

collectVuna : String -> Eff [] (List String)
collectVuna dir = collectVunaGo 1048576 dir

-- 目录树递归（符号链接可成环）用显式 fuel 守卫；每次下钻一层消耗 1。
collectVunaGo : Int -> String -> Eff [] (List String)
collectVunaGo fuel dir = if fuel <= 0 then indexFuelExhausted "directory walk"
else do
  names <- prim_eff_readDir dir
  concatMapEff (walkVunaGo (fuel - 1) dir) names

walkVunaGo : Int -> String -> String -> Eff [] (List String)
walkVunaGo fuel dir name = if fuel <= 0 then indexFuelExhausted "directory walk"
else if skipDir name then pure []
else
  let
    path = "${dir}/${name}"
  in do
    exists <- dirExists path
    if exists then collectVunaGo (fuel - 1) path
    else pure (if endsWith ".vuna" name then [path] else [])

-- prim_eff_isDirectory 对不存在的路径会抛异常，必须先判存在。
dirExists : String -> Eff [] Bool
dirExists path = do
  exists <- prim_eff_fileExists path
  if exists then prim_eff_isDirectory path else pure False

-- 包的索引范围：<pkg>/lib 与 <pkg>/app（模块源码）。刻意不扫 test/ 与 examples/
-- （夹具含故意不合法的语法，不是模块源码）。
packageSources : String -> Eff [] (List String)
packageSources dir = do
  hasLib <- dirExists "${dir}/lib"
  libFiles <- if hasLib then collectVuna "${dir}/lib" else pure []
  hasApp <- dirExists "${dir}/app"
  appFiles <- if hasApp then collectVuna "${dir}/app" else pure []
  pure (append libFiles appFiles)

packageDirs : String -> Eff [] (List (Pair String String))
packageDirs repo = do
  found <- findManifestDir repo
  case found of
    ErrC e => pure [Pair repo ""]
    OkC dir => do
      pkgsR <- workspacePackages dir
      pure (case pkgsR of
        ErrC e => [Pair dir ""]
        OkC pkgs => map (\p => Pair (packageDir p) (packageName p)) pkgs
      )

-- ---------------------------------------------------------------
-- 符号抽取（v3：doc 来自 DocTable，普通注释不再进入 symDoc）
-- ---------------------------------------------------------------
declLine : Decl -> Int
declLine d = spanStartLine (declSpan d)

declCol : Decl -> Int
declCol d = spanStartCol (declSpan d)

paramSuffix : List String -> String
paramSuffix [] = ""
paramSuffix params = " ${join " " params}"

traitParamSuffix : List TraitParam -> String
traitParamSuffix [] = ""
traitParamSuffix params = " " ++ join " " (map traitParamText params)

traitParamText : TraitParam -> String
traitParamText (TraitParam n Nothing) = n
traitParamText (TraitParam n (Just k)) = "(${n} : ${renderType k})"

signatureOf : String -> List Decl -> String
signatureOf name [] = ""
signatureOf name (d :: rest) = case d of
  DSig n ctx ty sp => if n == name then renderTypeInCtx ctx ty else signatureOf name rest
  _ => signatureOf name rest

typeOf : String -> List Decl -> String
typeOf name [] = ""
typeOf name (d :: rest) = case d of
  DSig n ctx ty sp => if n == name then renderType ty else typeOf name rest
  _ => typeOf name rest

symbolsOfModule : String -> List Decl -> DocTable -> List Sym
symbolsOfModule sMod decls table = concatMap (symbolsOfDecl sMod decls table) decls

symbolsOfDecl : String -> List Decl -> DocTable -> Decl -> List Sym
symbolsOfDecl sMod decls table d =
  let
    line = declLine d
    col = declCol d
  in case d of
    DData name params kind ctors derivings viaField repr lin sp =>
      Sym sMod name "data" "data ${name}${paramSuffix params}" "" (docForDecl table name) line col
        :: ctorSymbols sMod name ctors table
    DRecord name params fields derivings viaField repr lin sp =>
      Sym sMod name "record" "record ${name}${paramSuffix params}" "" (docForDecl table name) line col
        :: fieldSymbols sMod name fields table
    DTrait name params methods sp =>
      Sym sMod name "trait" "trait ${name}${traitParamSuffix params}" "" (docForDecl table name) line col
        :: methodSymbols sMod name methods table
    DSig name ctx ty sp => []
    DAxiom name ty sp =>
      [ Sym sMod name "axiom" "axiom ${name} : ${renderType ty}" (renderType ty) (docForDecl table name) line col
      ]
    DExtern name cName ty sp =>
      [ Sym sMod name "extern" "extern ${name} : ${renderType ty}" (renderType ty) (docForDecl table name) line col
      ]
    DFun name pats body sp =>
      [ Sym sMod name "fun" (signatureOf name decls) (typeOf name decls) (docForDecl table name) line col
      ]
    -- M29-T2b：命名实例已删除，实例不再产生符号（字典按实例表注册）。
    DInstance ctxE head methods sp => []

ctorSymbols : String -> String -> List Ctor -> DocTable -> List Sym
ctorSymbols sMod parent ctors table =
  map
    (\c => Sym sMod (ctorName c) "ctor" "${ctorName c} : ${renderType (ctorType c)}" (renderType (ctorType c)) (docForMember table parent (ctorName c)) (spanStartLine (ctorSpan c)) (spanStartCol (ctorSpan c)))
    ctors

fieldSymbols : String -> String -> List Field -> DocTable -> List Sym
fieldSymbols sMod parent fields table =
  map
    (\f => Sym sMod (fieldName f) "field" "${fieldName f} : ${renderType (fieldType f)}" (renderType (fieldType f)) (docForMember table parent (fieldName f)) (spanStartLine (fieldSpan f)) (spanStartCol (fieldSpan f)))
    fields

-- M30（B20）：trait 方法签名带 span，方法符号的行/列直接取方法签名位置。
methodSymbol : String -> String -> TraitMethod -> DocTable -> Sym
methodSymbol sMod parent m table =
  Sym sMod (traitMethodName m) "method" "${traitMethodName m} : ${renderType m.traitMethodType}"
    (renderType m.traitMethodType) (docForMember table parent (traitMethodName m))
    (spanStartLine (traitMethodSpan m)) (spanStartCol (traitMethodSpan m))

methodSymbols : String -> String -> List TraitMethod -> DocTable -> List Sym
methodSymbols sMod parent methods table = map (\m => methodSymbol sMod parent m table) methods

-- 同名符号合并：多子句函数会产生重复 DFun，只保留第一条（行号取首子句）。
dedupeSymbols : List Sym -> List Sym
dedupeSymbols syms = dedupeGo syms [] []

dedupeGo : List Sym -> List String -> List Sym -> List Sym
dedupeGo [] seen acc = reverse acc
dedupeGo (s :: rest) seen acc =
  if memName (symFullName s) seen then dedupeGo rest seen acc
  else dedupeGo rest (symFullName s :: seen) (s :: acc)

-- ---------------------------------------------------------------
-- 模块名
-- ---------------------------------------------------------------
-- 模块全名：源码模块头优先；无模块头时按路径推导。
moduleNameOf : String -> String -> Maybe ModDecl -> String
moduleNameOf dir path (Just (ModDecl name explicit items _ _ _ sp)) = name
moduleNameOf dir path Nothing = segmentModule dir path

segmentModule : String -> String -> String
segmentModule dir path =
  let
    rel = dropPrefix "${dir}/lib/" path
    rel2 = if rel == path then dropPrefix "${dir}/" path else rel
    stripped = if endsWith ".vuna" rel2 then substring 0 (byteLength rel2 - 5) rel2 else rel2
  in joinDots (splitChars 47 (strUnpack stripped) [] [])

-- ---------------------------------------------------------------
-- 引用抽取（语法级，保守：收集所有出现过的变量名 + 出现位置）
-- ---------------------------------------------------------------
refsInDecls : String -> List Decl -> List Ref
refsInDecls sMod decls = reverse (refsInDeclsGo sMod decls [])

refsInDeclsGo : String -> List Decl -> List Ref -> List Ref
refsInDeclsGo sMod [] acc = acc
refsInDeclsGo sMod (d :: rest) acc = refsInDeclsGo sMod rest (refsInDecl sMod d acc)

refsInDecl : String -> Decl -> List Ref -> List Ref
refsInDecl sMod (DFun name pats body sp) acc = refsInExprGo sMod body acc
refsInDecl sMod (DData name params kind ctors derivings viaField repr lin sp) acc =
  refsInCtors sMod ctors acc
refsInDecl sMod (DRecord name params fields derivings viaField repr lin sp) acc =
  refsInFieldTypes sMod fields acc
refsInDecl sMod (DTrait name params methods sp) acc = refsInMethods sMod methods acc
refsInDecl sMod (DInstance ctxE head methods sp) acc =
  refsInDeclsGo sMod methods (refsInExprGo sMod head acc)
refsInDecl sMod _ acc = acc

refsInCtors : String -> List Ctor -> List Ref -> List Ref
refsInCtors sMod [] acc = acc
refsInCtors sMod (c :: rest) acc = refsInCtors sMod rest (refsInExprGo sMod (ctorType c) acc)

refsInMethods : String -> List TraitMethod -> List Ref -> List Ref
refsInMethods sMod [] acc = acc
refsInMethods sMod (m :: rest) acc =
  refsInMethods sMod rest (refsInExprGo sMod m.traitMethodType acc)

refsInFieldTypes : String -> List Field -> List Ref -> List Ref
refsInFieldTypes sMod [] acc = acc
refsInFieldTypes sMod (f :: rest) acc =
  refsInFieldTypes sMod rest (refsInExprGo sMod (fieldType f) acc)

-- record 字面量/更新里的字段值（名字, 表达式）。
refsInFields : String -> List (Pair String Expr) -> List Ref -> List Ref
refsInFields sMod [] acc = acc
refsInFields sMod ((Pair fname value) :: rest) acc =
  refsInFields sMod rest (refsInExprGo sMod value acc)

refsInBinds : String -> List (Pair Pat Expr) -> List Ref -> List Ref
refsInBinds sMod [] acc = acc
refsInBinds sMod ((Pair p x) :: rest) acc = refsInBinds sMod rest (refsInExprGo sMod x acc)

refsInLocalClauses : String -> List (Pair (List Pat) Expr) -> List Ref -> List Ref
refsInLocalClauses sMod [] acc = acc
refsInLocalClauses sMod ((Pair pats body) :: rest) acc =
  refsInLocalClauses sMod rest (refsInExprGo sMod body acc)

refsInArgs : String -> List Expr -> List Ref -> List Ref
refsInArgs sMod [] acc = acc
refsInArgs sMod (a :: rest) acc = refsInArgs sMod rest (refsInExprGo sMod a acc)

refsInDoStmts : String -> List DoStmt -> List Ref -> List Ref
refsInDoStmts sMod [] acc = acc
refsInDoStmts sMod (s :: rest) acc = case s of
  DBind p x tsp => refsInDoStmts sMod rest (refsInExprGo sMod x acc)
  DExpr x tsp => refsInDoStmts sMod rest (refsInExprGo sMod x acc)

-- 累积器版本（difference list 语义）：每节点 O(1) cons，最后 reverse 一次。
-- 旧实现每个分支左结合 append 子树的引用列表，在应用 spine / 嵌套表达式上呈 O(n²)；
-- 这里保持与旧实现**相同的引用顺序**（先逆序收集，reverse 后还原）。
refsInExpr : String -> Expr -> List Ref
refsInExpr sMod e = reverse (refsInExprGo sMod e [])

refsInExprGo : String -> Expr -> List Ref -> List Ref
refsInExprGo sMod e acc = case e of
  -- M40：洞（`_` / `?name`）不是引用，不进索引（否则 `map --impact` / references 有噪音）。
  -- 内置宏标记（`@vuna@macro@name`）同理：它只是 `name!` 的语法编码，不是符号引用。
  EVar n sp =>
    if isHoleName n || isMacroSyntaxName n then acc
    else Ref sMod n (spanStartLine sp) (spanStartCol sp) :: acc
  EInt n sp => acc
  EStr s sp => acc
  EFloat raw sp => acc
  -- M36：模板字面量：洞内表达式的引用照常收集（find-references 需要）。
  EInterp multi parts sp => refsInInterpParts sMod parts acc
  ELam ps body sp => refsInExprGo sMod body acc
  EApp f args sp => refsInArgs sMod args (refsInExprGo sMod f acc)
  EPi n i _ dom cod sp => refsInExprGo sMod cod (refsInExprGo sMod dom acc)
  ELet binds body isRec sp => refsInBinds sMod binds (refsInExprGo sMod body acc)
  ECase scrut alts sp => refsInBinds sMod alts (refsInExprGo sMod scrut acc)
  -- A2：where/let 多 clause 局部函数：只看各 clause 的 body（与 refsInBind 一致，不看模式）。
  ELocalFun clauses sp => refsInLocalClauses sMod clauses acc
  EIf c t e2 sp => refsInExprGo sMod c (refsInExprGo sMod t (refsInExprGo sMod e2 acc))
  EField r fname sp => refsInExprGo sMod r acc
  ERecord tn fields sp => refsInFields sMod fields acc
  ERecUpdate r fields sp => refsInExprGo sMod r (refsInFields sMod fields acc)
  EDo stmts sp => refsInDoStmts sMod stmts acc
  EAnn value ty sp => refsInExprGo sMod value (refsInExprGo sMod ty acc)
  -- M31.3：keep 模式（index/fmt）下反引号中缀与 section **保留原形**（不像 EParen/EInfix
  -- 会被重排消掉），所以这里必须显式处理：反引号里的名字本身也是引用，操作数继续递归，
  -- 不能像旧 wildcard 那样静默丢整棵子树。
  EBacktick nm l r sp =>
    refsInExprGo sMod l
      (refsInExprGo sMod r (Ref sMod nm (spanStartLine sp) (spanStartCol sp) :: acc))
  ESectOp op sp => Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc
  ESectL op inner sp =>
    refsInExprGo sMod inner (Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc)
  ESectR inner op sp =>
    refsInExprGo sMod inner (Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc)
  -- M31.2：中缀链与括号是 parser 中间产物：op 记一条引用，操作数按同一累积器顺序递归。
  EInfix op l r sp =>
    refsInExprGo sMod l
      (refsInExprGo sMod r (Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc))
  EParen inner sp => refsInExprGo sMod inner acc

-- M36：模板片段里的引用（洞内表达式递归；文本块无引用）。
refsInInterpParts : String -> List InterpPart -> List Ref -> List Ref
refsInInterpParts sMod [] acc = acc
refsInInterpParts sMod ((IPText s) :: rest) acc = refsInInterpParts sMod rest acc
refsInInterpParts sMod ((IPHole e) :: rest) acc =
  refsInInterpParts sMod rest (refsInExprGo sMod e acc)

-- ---------------------------------------------------------------
-- 全量构建
-- ---------------------------------------------------------------
record Built where
  builtModules : List ModuleInfo
  builtSymbols : List Sym
  builtRefs : List Ref

-- 索引一个文件。parse/fixity 失败返回 Err（调用方转成 warning），不中断整体。
-- 返回推进后的 `FixityEnv`：按目录复用包上下文与已加载模块图（见 Vuna.FixityEnv）。
indexOne : FixityEnv -> String -> String -> String -> Eff [] (Pair FixityEnv (Check Built))
indexOne env dir pkgName path = do
  exists <- prim_eff_fileExists path
  if exists then indexOneExisting env dir pkgName path
  else pure (Pair env (err "${path}: no such file"))

indexOneExisting : FixityEnv -> String -> String -> String -> Eff [] (Pair FixityEnv (Check Built))
indexOneExisting env dir pkgName path = do
  source <- prim_eff_readFile path
  looked <- fixitiesForFile env path source
  let
    bytes = strLength source
    env2 = firstOf looked
  in case secondOf looked of
    ErrC e => pure (Pair env2 (err "${path}: cannot load package fixity context: ${diagText e}"))
    OkC programFixities => case parseSource path source of
      ErrC e => pure (Pair env2 (err "${path}: ${diagText e}"))
      -- M31.3（B26/B27）：必须按**程序级** fixity 重排（本文件声明 ++ import 闭包，
      -- 本地优先）。只用本地声明会让用到 `+`/`==`/`::` 的文件报 unknown fixity，
      -- 然后被当错误跳过 → `vuna map` 静默漏模块。
      OkC (SourceFile srcHdr imports fx decls0 _ _ _) => case reorderProgram (tableOfKeepOps (append programFixities fx)) decls0 of
        ErrC e => pure (Pair env2 (err "${path}: ${diagText e}"))
        OkC decls =>
          let
            sMod = moduleNameOf dir path srcHdr
            comments = case lexComments source of
              ErrC e => []
              OkC cs => cs
            table = docTableOf srcHdr decls comments
            info = ModuleInfo sMod pkgName path bytes (length decls)
            syms = symbolsOfModule sMod decls table
            refs = refsInDecls sMod decls
          in pure (Pair env2 (OkC (Built [info] syms refs)))

record Acc where
  accModules : List ModuleInfo
  accSymbols : List Sym
  accRefs : List Ref
  accWarns : List Diagnostic

-- 把 xs 逆序前插到 ys（O(#xs)）：跨文件累积用，避免每文件 append 复制整个已累积列表（M34）。
prependRev : List a -> List a -> List a
prependRev [] ys = ys
prependRev (x :: rest) ys = prependRev rest (x :: ys)

indexPackage : FixityEnv -> String -> String -> List String -> Acc -> Eff [] (Pair FixityEnv Acc)
indexPackage env dir pkgName files acc = foldFiles env dir pkgName files acc

foldFiles : FixityEnv -> String -> String -> List String -> Acc -> Eff [] (Pair FixityEnv Acc)
foldFiles env dir pkgName [] acc = pure (Pair env acc)
foldFiles env dir pkgName (path :: rest) acc = do
  stepped <- indexFileInto env dir pkgName path acc
  foldFiles (firstOf stepped) dir pkgName rest (secondOf stepped)

indexFileInto : FixityEnv -> String -> String -> String -> Acc -> Eff [] (Pair FixityEnv Acc)
indexFileInto env dir pkgName path acc = do
  stepped <- indexOne env dir pkgName path
  case secondOf stepped of
    ErrC e =>
      pure
        (Pair (firstOf stepped) (Acc acc.accModules acc.accSymbols acc.accRefs (e :: acc.accWarns)))
    OkC b =>
      pure
        (Pair (firstOf stepped) (Acc (prependRev b.builtModules acc.accModules) (prependRev b.builtSymbols acc.accSymbols) (prependRev b.builtRefs acc.accRefs) acc.accWarns))

collectAll : FixityEnv -> List (Pair String String) -> Acc -> Eff [] (Pair FixityEnv Acc)
collectAll env [] acc = pure (Pair env acc)
collectAll env (root :: rest) acc = do
  let
    dir = firstOf root
    pkgName = secondOf root
  in do
    files <- packageSources dir
    stepped <- indexPackage env dir pkgName files acc
    collectAll (firstOf stepped) rest (secondOf stepped)

-- 全量构建（parse 所有源码，不读写缓存）。
export buildIndex : String -> Eff [] (Check Index)
buildIndex repo = do
  dirs <- packageDirs repo
  stepped <- collectAll emptyFixityEnv dirs (Acc [] [] [] [])
  let
    acc = secondOf stepped
  in pure
    (OkC (Index (reverse acc.accModules) (dedupeSymbols (reverse acc.accSymbols)) (reverse acc.accRefs)))

-- ---------------------------------------------------------------
-- 缓存：查询图节点 `index:<dir>` + 内容寻址 blob
-- ---------------------------------------------------------------
--   节点 `index:<dir>` / `index-cheap:<dir>`：值 = 载荷的内容地址（`QRef`）；
--   载荷：`Index.Codec.encIndex` 的规范字节，落 `<cache>/blobs/<digest>`（codec
--   `index-payload 1`，`Store` framing + SHA-256 校验）；
--   依赖表：CLI 逐文件内容哈希 `f:<path>:<hash>`；REPL 用 stat 键
--   `st:<path>:<bytes>:<mtime>:<hash>`（安全窗内带内容哈希，窗口外留空）。
-- 命中 ⇒ 读 blob 解码；miss ⇒ 重建 + 写 blob + 提交节点 + 落会话索引，
-- 因此 `vuna map` 的跨进程复用由会话索引承担（`sessionSave` 写 `<cache>/query/.../index`）。
indexNodeKey : String -> String
indexNodeKey repo = "index:${repo}"

indexNodeKeyCheap : String -> String
indexNodeKeyCheap repo = "index-cheap:${repo}"

-- mtime 只有秒级分辨率：`builtSec` 前 `indexMtimeSafetyWindowSec` 秒内改过的文件必须回落
-- 内容哈希，否则「同秒同 size 的编辑」会被漏掉（C11 的教训）。
indexMtimeSafetyWindowSec : Int
indexMtimeSafetyWindowSec = 5

record SourceStat where
  ssPath : String
  ssBytes : Int
  ssMtime : Int
  -- 安全窗内 = 内容哈希；窗口外 = ""（依赖表键里带上，两侧规则一致就不会假失配）。
  ssHash : String

-- 当前 stat 面（含窗口内的内容哈希）。依赖表的唯一来源。
indexStatsOf : Int -> String -> Eff [] (List SourceStat)
indexStatsOf builtSec repo = do
  dirs <- packageDirs repo
  sources <- concatMapEff packageSources (map firstOf dirs)
  mapEff (sourceStatOf builtSec) sources

sourceStatOf : Int -> String -> Eff [] SourceStat
sourceStatOf builtSec path = do
  exists <- prim_eff_fileExists path
  if exists then do
    bytes <- prim_eff_fileSize path
    mtime <- prim_eff_fileMtime path
    if mtime + indexMtimeSafetyWindowSec > builtSec then do
      source <- prim_eff_readFile path
      pure (SourceStat path (strLength source) mtime (contentHash source))
    else pure (SourceStat path bytes mtime "")
  else pure (SourceStat path 0 0 "")

contentHash : String -> String
contentHash content = "${Base.Hashable.hashStr content}-${Base.Hashable.hashStr "v2:${content}"}"

indexDepKey : SourceStat -> String
indexDepKey s = "st:${s.ssPath}:${strFromInt s.ssBytes}:${strFromInt s.ssMtime}:${s.ssHash}"

-- 带缓存的入口：查索引节点 → 命中读 blob 解码 → 未命中重建并写回。
-- 非 workspace（向上找不到 vuna.toml）是**输入错误**，不再静默建空索引。
-- 强依赖（CLI 路径）：逐源文件**内容哈希**（C11：同 size + 同 mtime 的内容变更也必须失效）。
indexStrongDeps : String -> Eff [] (List String)
indexStrongDeps repo = do
  dirs <- packageDirs repo
  sources <- concatMapEff packageSources (map firstOf dirs)
  mapEff strongDepOf sources

strongDepOf : String -> Eff [] String
strongDepOf path = do
  exists <- prim_eff_fileExists path
  if exists then do
    source <- prim_eff_readFile path
    pure "f:${path}:${contentHash source}"
  else pure "f:${path}:"

-- 带缓存的入口（CLI：`vuna map` / `vuna api`）：强依赖 + `index:<dir>` 节点
-- → 命中读 blob 解码 → 未命中重建并写回。非 workspace（向上找不到 vuna.toml）是
-- **输入错误**，不再静默建空索引。
export loadOrBuild : String -> Eff [] (Check Index)
loadOrBuild repo = indexLoadOrBuild repo False

-- 廉价入口（REPL：每会话首次 `:browse`/`:info`/`:search`）：依赖表用 stat 键
-- `st:<path>:<bytes>:<mtime>:<hash>`（安全窗内回落内容哈希），不读全部源码算哈希。
-- 节点 key 前缀不同（`index-cheap:`），与 CLI 的强依赖缓存互不污染。
export loadOrBuildCheap : String -> Eff [] (Check Index)
loadOrBuildCheap repo = indexLoadOrBuild repo True

indexLoadOrBuild : String -> Bool -> Eff [] (Check Index)
indexLoadOrBuild repo cheap = do
  found <- findManifestDirMaybe repo
  case found of
    Nothing => do
      cwd <- prim_eff_getcwd
      pure (err "index: no vuna.toml found from ${cwd} (searched upward)")
    Just _ => do
      now <- effTimeUs
      let
        builtSec = now / 1000000
      in do
        deps <- if cheap then cheapDeps builtSec repo else indexStrongDeps repo
        let
          node = if cheap then indexNodeKeyCheap repo else indexNodeKey repo
        in do
          -- 节点 key 同时用作会话桶名：索引按目录分桶，CLI/REPL 各一条。
          ts0 <- pure (toolSessionNew "tool" node)
          hit <- toolHitValue ts0 node deps
          case hit of
            Just (Just digest) => do
              payload <- toolLoadPayload digest indexPayloadCodec
              case payload of
                Just bytes => case decIndexComplete bytes of
                  Just idx => do
                    _ <- indexNote "index-path=cache"
                    pure (OkC idx)
                  Nothing => rebuildIndex ts0 repo node deps
                Nothing => rebuildIndex ts0 repo node deps
            _ => rebuildIndex ts0 repo node deps

-- 廉价依赖：stat 快照 → 键。
cheapDeps : Int -> String -> Eff [] (List String)
cheapDeps builtSec repo = do
  stats <- indexStatsOf builtSec repo
  pure (map indexDepKey stats)

-- 重建：全量扫描 → 编码 → 写 blob → 提交节点（`toolStorePayload` 内含 `sessionSave`）。
-- 一次 miss 只提交调用方选定的 `node`（`index:` 或 `index-cheap:`），不写另一个 key。
rebuildIndex : ToolSession -> String -> String -> List String -> Eff [] (Check Index)
rebuildIndex ts repo node deps = do
  _ <- indexNote "index-path=build"
  built <- buildIndex repo
  case built of
    ErrC e => pure (ErrC e)
    OkC idx => do
      _ <- toolStorePayload ts node deps indexPayloadCodec (encIndex idx)
      pure (OkC idx)

-- | 工具链侧的 debug 行：与编译器探针共用唯一内置宏 `dbg!`（`--debug-perf` /
-- `VUNA_DEBUG_PERF=1` 门控，stderr，带时间戳）；工具链不进 TCB，但宏展开不需要 import。
indexNote : String -> Eff [] Int
indexNote msg = pure (dbg! msg)
