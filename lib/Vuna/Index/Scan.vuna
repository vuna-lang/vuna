module Vuna.Index.Scan
  ( SourceStat(..)
  , buildIndex
  , indexStatsOf
  , indexStatsUnchanged
  , loadOrBuild
  ) where

-- Vuna.Index.Scan：parse 级扫描、符号抽取、全量构建与 `.local/index/` 缓存
-- （M24 后维护·源码重组；M30 内容哈希缓存 v2 + 原子写 + 目录锁）。
--
-- 缓存设计（`.local/index/`，已 gitignore）：
--   - `manifest.txt` 首行 `vuna-index 3`（格式版本），随后每行
--     `path <TAB> bytes <TAB> hash`——新鲜度判定的唯一依据（内容哈希，不再用 mtime）；
--     旧格式（无版本行 / 只有 path+bytes+mtime）视为过期，全量重建；
--   - `modules.txt`  每行 `module <TAB> pkg <TAB> path <TAB> bytes <TAB> declCount`；
--   - `symbols.txt`  每行 `module <TAB> name <TAB> kind <TAB> line <TAB> col <TAB> sig <TAB> doc`；
--   - `refs.txt`     每行 `module <TAB> name <TAB> line <TAB> col`（引用出现位置）。
--
-- 新鲜度：每次调用遍历目录并读每个源文件算内容哈希，与 manifest 逐条比较；完全一致
-- 就直接从 `*.txt` 回读索引，否则全量重建并写回。**没有「刷新索引」命令**。
-- 同 size 同 mtime 的内容变更会因哈希不同而失效（C11）。
--
-- 原子性与锁（C11）：
--   - 数据文件先写、manifest 最后写：manifest 是「其余文件都有效」的提交点；
--   - 每个文件先写 `<name>.tmp`，再 `prim_eff_runIn mv` 同目录原子替换；
--   - `cache.lock` 目录锁（`mkdir` 原子）：新鲜锁（<60s）说明另一进程正在写，本次
--     只建内存索引、跳过写缓存；过期锁 `rm -rf` 后重试一次；结束时 rmdir；
--   - 缓存不可写 / 写失败一律降级为纯内存索引（不报错）。
import Vuna.Compiler.Common
import Base.HashMap
import Base.Hashable
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Packages.Pkg
import Vuna.Doc.Comments
import Vuna.Doc.Types
import Vuna.FixityEnv
import Vuna.Index.Types
import Vuna.Sig
import Base.Host

-- C41：工具链 fuel 耗尽不是「空结果」，而是内部不变量被破坏；与编译器一致硬失败。
indexFuelExhausted : String -> a
indexFuelExhausted what = prim_fail "vuna: internal: ${what} fuel exhausted"

-- ---------------------------------------------------------------
-- 小型 helper（本模块自用，避免污染 Base）
-- ---------------------------------------------------------------
splitChars : Int -> List Int -> List String -> List Int -> List String
splitChars sep [] acc seg = reverse (strPack (reverse seg) :: acc)
splitChars sep (c :: rest) acc seg =
  if c == sep then splitChars sep rest (strPack (reverse seg) :: acc) []
  else splitChars sep rest acc (c :: seg)

splitOnNewline : String -> List String
splitOnNewline s = splitChars 10 (strUnpack s) [] []

splitOnTab : String -> List String
splitOnTab s = splitChars 9 (strUnpack s) [] []

dropLeadingSpaces : List Int -> List Int
dropLeadingSpaces [] = []
dropLeadingSpaces (c :: rest) = if c == 32 || c == 9 then dropLeadingSpaces rest else c :: rest

trimStart : String -> String
trimStart s = strPack (dropLeadingSpaces (strUnpack s))

trimEnd : String -> String
trimEnd s = strPack (reverse (dropLeadingSpaces (reverse (strUnpack s))))

trimBoth : String -> String
trimBoth s = trimEnd (trimStart s)

parseInt : String -> Maybe Int
parseInt s = parseIntGo (strUnpack s) 0

parseIntGo : List Int -> Int -> Maybe Int
parseIntGo [] acc = Just acc
parseIntGo (c :: rest) acc =
  if c >= 48 && c <= 57 then parseIntGo rest (acc * 10 + (c - 48)) else Nothing

dropPrefix : String -> String -> String
dropPrefix prefix s =
  if startsWith prefix s then substring (byteLength prefix) (byteLength s - byteLength prefix) s
  else s

-- 缓存字段转义（v3）：doc / 类型文本可能含 TAB / 换行；用 `\\`、`\t`、`\n`、`\r`
-- 编成单行，解析时还原。反斜杠必须先转义，避免字面 `\n` 与换行混淆。
escapeField : String -> String
escapeField s = strPack (reverse (escapeChars (strUnpack s) []))

escapeChars : List Int -> List Int -> List Int
escapeChars [] acc = acc
escapeChars (c :: rest) acc = case c of
  92 => escapeChars rest (92 :: 92 :: acc)
  9 => escapeChars rest (116 :: 92 :: acc)
  10 => escapeChars rest (110 :: 92 :: acc)
  13 => escapeChars rest (114 :: 92 :: acc)
  _ => escapeChars rest (c :: acc)

unescapeField : String -> String
unescapeField s = strPack (reverse (unescapeChars (strUnpack s) []))

unescapeChars : List Int -> List Int -> List Int
unescapeChars [] acc = acc
unescapeChars (c :: rest) acc = if c == 92 then case rest of
  c2 :: rest2 => unescapeChars rest2 (unescapedChar c2 :: acc)
  [] => unescapeChars rest (92 :: acc)
else unescapeChars rest (c :: acc)

unescapedChar : Int -> Int
unescapedChar 110 = 10
unescapedChar 116 = 9
unescapedChar 114 = 13
unescapedChar 92 = 92
unescapedChar c = c

-- ---------------------------------------------------------------
-- 目录遍历
-- ---------------------------------------------------------------
skipDir : String -> Bool
skipDir name =
  name == "."
    || name == ".."
    || name == ".git"
    || name == ".local"
    || name == ".output"
    || name == ".direnv"
    || name == "seed"
    || name == "_scratch"
    || name == ".dsh-plugins"
    || name == "result"
    || name == "node_modules"
    || name == ".vscode"

collectVuna : String -> List String
collectVuna dir = collectVunaGo 1048576 dir

-- 目录树递归（符号链接可成环）用显式 fuel 守卫；每次下钻一层消耗 1。
collectVunaGo : Int -> String -> List String
collectVunaGo fuel dir =
  if fuel <= 0 then indexFuelExhausted "directory walk"
  else concatMap (walkVunaGo (fuel - 1) dir) (runPure (prim_eff_readDir dir))

walkVunaGo : Int -> String -> String -> List String
walkVunaGo fuel dir name = if fuel <= 0 then indexFuelExhausted "directory walk"
else if skipDir name then []
else
  let
    path = "${dir}/${name}"
  in if dirExists path then collectVunaGo (fuel - 1) path
  else if endsWith ".vuna" name then [path] else []

-- prim_eff_isDirectory 对不存在的路径会抛异常，必须先判存在。
dirExists : String -> Bool
dirExists path = runPure (prim_eff_fileExists path) && runPure (prim_eff_isDirectory path)

-- 包的索引范围：<pkg>/lib 与 <pkg>/app（模块源码）。刻意不扫 test/ 与 examples/
-- （夹具含故意不合法的语法，不是模块源码）。
packageSources : String -> List String
packageSources dir =
  append (if dirExists "${dir}/lib" then collectVuna "${dir}/lib" else [])
    (if dirExists "${dir}/app" then collectVuna "${dir}/app" else [])

packageDirs : String -> List (Pair String String)
packageDirs repo = case findManifestDir repo of
  ErrC e => [Pair repo ""]
  OkC dir => case workspacePackages dir of
    ErrC e => [Pair dir ""]
    OkC pkgs => map (\p => Pair (packageDir p) (packageName p)) pkgs

-- ---------------------------------------------------------------
-- 符号抽取（v3：doc 来自 DocTable，普通注释不再进入 symDoc）
-- ---------------------------------------------------------------
declLine : Decl -> Int
declLine d = spanStartLine (declSpan d)

declCol : Decl -> Int
declCol d = spanStartCol (declSpan d)

paramSuffix : List String -> String
paramSuffix [] = ""
paramSuffix params = " ${join " " params}"

traitParamSuffix : List TraitParam -> String
traitParamSuffix [] = ""
traitParamSuffix params = " " ++ join " " (map traitParamText params)

traitParamText : TraitParam -> String
traitParamText (TraitParam n Nothing) = n
traitParamText (TraitParam n (Just k)) = "(${n} : ${renderType k})"

signatureOf : String -> List Decl -> String
signatureOf name [] = ""
signatureOf name (d :: rest) = case d of
  DSig n ctx ty sp => if n == name then renderTypeInCtx ctx ty else signatureOf name rest
  _ => signatureOf name rest

typeOf : String -> List Decl -> String
typeOf name [] = ""
typeOf name (d :: rest) = case d of
  DSig n ctx ty sp => if n == name then renderType ty else typeOf name rest
  _ => typeOf name rest

symbolsOfModule : String -> List Decl -> DocTable -> List Sym
symbolsOfModule sMod decls table = concatMap (symbolsOfDecl sMod decls table) decls

symbolsOfDecl : String -> List Decl -> DocTable -> Decl -> List Sym
symbolsOfDecl sMod decls table d =
  let
    line = declLine d
    col = declCol d
  in case d of
    DData name params kind ctors derivings viaField repr lin sp =>
      Sym sMod name "data" "data ${name}${paramSuffix params}" "" (docForDecl table name) line col
        :: ctorSymbols sMod name ctors table
    DRecord name params fields derivings viaField repr lin sp =>
      Sym sMod name "record" "record ${name}${paramSuffix params}" "" (docForDecl table name) line col
        :: fieldSymbols sMod name fields table
    DTrait name params methods sp =>
      Sym sMod name "trait" "trait ${name}${traitParamSuffix params}" "" (docForDecl table name) line col
        :: methodSymbols sMod name methods table
    DSig name ctx ty sp => []
    DAxiom name ty sp =>
      [ Sym sMod name "axiom" "axiom ${name} : ${renderType ty}" (renderType ty) (docForDecl table name) line col
      ]
    DExtern name cName ty sp =>
      [ Sym sMod name "extern" "extern ${name} : ${renderType ty}" (renderType ty) (docForDecl table name) line col
      ]
    DFun name pats body sp =>
      [ Sym sMod name "fun" (signatureOf name decls) (typeOf name decls) (docForDecl table name) line col
      ]
    -- M29-T2b：命名实例已删除，实例不再产生符号（字典按实例表注册）。
    DInstance ctxE head methods sp => []

ctorSymbols : String -> String -> List Ctor -> DocTable -> List Sym
ctorSymbols sMod parent ctors table =
  map
    (\c => Sym sMod (ctorName c) "ctor" "${ctorName c} : ${renderType (ctorType c)}" (renderType (ctorType c)) (docForMember table parent (ctorName c)) (spanStartLine (ctorSpan c)) (spanStartCol (ctorSpan c)))
    ctors

fieldSymbols : String -> String -> List Field -> DocTable -> List Sym
fieldSymbols sMod parent fields table =
  map
    (\f => Sym sMod (fieldName f) "field" "${fieldName f} : ${renderType (fieldType f)}" (renderType (fieldType f)) (docForMember table parent (fieldName f)) (spanStartLine (fieldSpan f)) (spanStartCol (fieldSpan f)))
    fields

-- M30（B20）：trait 方法签名带 span，方法符号的行/列直接取方法签名位置。
methodSymbol : String -> String -> TraitMethod -> DocTable -> Sym
methodSymbol sMod parent m table =
  Sym sMod (traitMethodName m) "method" "${traitMethodName m} : ${renderType m.traitMethodType}"
    (renderType m.traitMethodType) (docForMember table parent (traitMethodName m))
    (spanStartLine (traitMethodSpan m)) (spanStartCol (traitMethodSpan m))

methodSymbols : String -> String -> List TraitMethod -> DocTable -> List Sym
methodSymbols sMod parent methods table = map (\m => methodSymbol sMod parent m table) methods

-- 同名符号合并：多子句函数会产生重复 DFun，只保留第一条（行号取首子句）。
dedupeSymbols : List Sym -> List Sym
dedupeSymbols syms = dedupeGo syms [] []

dedupeGo : List Sym -> List String -> List Sym -> List Sym
dedupeGo [] seen acc = reverse acc
dedupeGo (s :: rest) seen acc =
  if memName (symFullName s) seen then dedupeGo rest seen acc
  else dedupeGo rest (symFullName s :: seen) (s :: acc)

-- ---------------------------------------------------------------
-- 模块名
-- ---------------------------------------------------------------
-- 模块全名：源码模块头优先；无模块头时按路径推导。
moduleNameOf : String -> String -> Maybe ModDecl -> String
moduleNameOf dir path (Just (ModDecl name explicit items sp)) = name
moduleNameOf dir path Nothing = segmentModule dir path

segmentModule : String -> String -> String
segmentModule dir path =
  let
    rel = dropPrefix "${dir}/lib/" path
    rel2 = if rel == path then dropPrefix "${dir}/" path else rel
    stripped = if endsWith ".vuna" rel2 then substring 0 (byteLength rel2 - 5) rel2 else rel2
  in joinDots (splitChars 47 (strUnpack stripped) [] [])

-- ---------------------------------------------------------------
-- 引用抽取（语法级，保守：收集所有出现过的变量名 + 出现位置）
-- ---------------------------------------------------------------
refsInDecls : String -> List Decl -> List Ref
refsInDecls sMod decls = reverse (refsInDeclsGo sMod decls [])

refsInDeclsGo : String -> List Decl -> List Ref -> List Ref
refsInDeclsGo sMod [] acc = acc
refsInDeclsGo sMod (d :: rest) acc = refsInDeclsGo sMod rest (refsInDecl sMod d acc)

refsInDecl : String -> Decl -> List Ref -> List Ref
refsInDecl sMod (DFun name pats body sp) acc = refsInExprGo sMod body acc
refsInDecl sMod (DData name params kind ctors derivings viaField repr lin sp) acc =
  refsInCtors sMod ctors acc
refsInDecl sMod (DRecord name params fields derivings viaField repr lin sp) acc =
  refsInFieldTypes sMod fields acc
refsInDecl sMod (DTrait name params methods sp) acc = refsInMethods sMod methods acc
refsInDecl sMod (DInstance ctxE head methods sp) acc =
  refsInDeclsGo sMod methods (refsInExprGo sMod head acc)
refsInDecl sMod _ acc = acc

refsInCtors : String -> List Ctor -> List Ref -> List Ref
refsInCtors sMod [] acc = acc
refsInCtors sMod (c :: rest) acc = refsInCtors sMod rest (refsInExprGo sMod (ctorType c) acc)

refsInMethods : String -> List TraitMethod -> List Ref -> List Ref
refsInMethods sMod [] acc = acc
refsInMethods sMod (m :: rest) acc =
  refsInMethods sMod rest (refsInExprGo sMod m.traitMethodType acc)

refsInFieldTypes : String -> List Field -> List Ref -> List Ref
refsInFieldTypes sMod [] acc = acc
refsInFieldTypes sMod (f :: rest) acc =
  refsInFieldTypes sMod rest (refsInExprGo sMod (fieldType f) acc)

-- record 字面量/更新里的字段值（名字, 表达式）。
refsInFields : String -> List (Pair String Expr) -> List Ref -> List Ref
refsInFields sMod [] acc = acc
refsInFields sMod ((Pair fname value) :: rest) acc =
  refsInFields sMod rest (refsInExprGo sMod value acc)

refsInBinds : String -> List (Pair Pat Expr) -> List Ref -> List Ref
refsInBinds sMod [] acc = acc
refsInBinds sMod ((Pair p x) :: rest) acc = refsInBinds sMod rest (refsInExprGo sMod x acc)

refsInLocalClauses : String -> List (Pair (List Pat) Expr) -> List Ref -> List Ref
refsInLocalClauses sMod [] acc = acc
refsInLocalClauses sMod ((Pair pats body) :: rest) acc =
  refsInLocalClauses sMod rest (refsInExprGo sMod body acc)

refsInArgs : String -> List Expr -> List Ref -> List Ref
refsInArgs sMod [] acc = acc
refsInArgs sMod (a :: rest) acc = refsInArgs sMod rest (refsInExprGo sMod a acc)

refsInDoStmts : String -> List DoStmt -> List Ref -> List Ref
refsInDoStmts sMod [] acc = acc
refsInDoStmts sMod (s :: rest) acc = case s of
  DBind p x tsp => refsInDoStmts sMod rest (refsInExprGo sMod x acc)
  DExpr x tsp => refsInDoStmts sMod rest (refsInExprGo sMod x acc)

-- 累积器版本（difference list 语义）：每节点 O(1) cons，最后 reverse 一次。
-- 旧实现每个分支左结合 append 子树的引用列表，在应用 spine / 嵌套表达式上呈 O(n²)；
-- 这里保持与旧实现**相同的引用顺序**（先逆序收集，reverse 后还原）。
refsInExpr : String -> Expr -> List Ref
refsInExpr sMod e = reverse (refsInExprGo sMod e [])

refsInExprGo : String -> Expr -> List Ref -> List Ref
refsInExprGo sMod e acc = case e of
  -- M40：洞（`_` / `?name`）不是引用，不进索引（否则 `map --impact` / references 有噪音）。
  EVar n sp => if isHoleName n then acc else Ref sMod n (spanStartLine sp) (spanStartCol sp) :: acc
  EInt n sp => acc
  EStr s sp => acc
  EFloat raw sp => acc
  -- M36：模板字面量：洞内表达式的引用照常收集（find-references 需要）。
  EInterp multi parts sp => refsInInterpParts sMod parts acc
  ELam ps body sp => refsInExprGo sMod body acc
  EApp f args sp => refsInArgs sMod args (refsInExprGo sMod f acc)
  EPi n i _ dom cod sp => refsInExprGo sMod cod (refsInExprGo sMod dom acc)
  ELet binds body isRec sp => refsInBinds sMod binds (refsInExprGo sMod body acc)
  ECase scrut alts sp => refsInBinds sMod alts (refsInExprGo sMod scrut acc)
  -- A2：where/let 多 clause 局部函数：只看各 clause 的 body（与 refsInBind 一致，不看模式）。
  ELocalFun clauses sp => refsInLocalClauses sMod clauses acc
  EIf c t e2 sp => refsInExprGo sMod c (refsInExprGo sMod t (refsInExprGo sMod e2 acc))
  EField r fname sp => refsInExprGo sMod r acc
  ERecord tn fields sp => refsInFields sMod fields acc
  ERecUpdate r fields sp => refsInExprGo sMod r (refsInFields sMod fields acc)
  EDo stmts sp => refsInDoStmts sMod stmts acc
  EAnn value ty sp => refsInExprGo sMod value (refsInExprGo sMod ty acc)
  -- M31.3：keep 模式（index/fmt）下反引号中缀与 section **保留原形**（不像 EParen/EInfix
  -- 会被重排消掉），所以这里必须显式处理：反引号里的名字本身也是引用，操作数继续递归，
  -- 不能像旧 wildcard 那样静默丢整棵子树。
  EBacktick nm l r sp =>
    refsInExprGo sMod l
      (refsInExprGo sMod r (Ref sMod nm (spanStartLine sp) (spanStartCol sp) :: acc))
  ESectOp op sp => Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc
  ESectL op inner sp =>
    refsInExprGo sMod inner (Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc)
  ESectR inner op sp =>
    refsInExprGo sMod inner (Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc)
  -- M31.2：中缀链与括号是 parser 中间产物：op 记一条引用，操作数按同一累积器顺序递归。
  EInfix op l r sp =>
    refsInExprGo sMod l
      (refsInExprGo sMod r (Ref sMod op (spanStartLine sp) (spanStartCol sp) :: acc))
  EParen inner sp => refsInExprGo sMod inner acc

-- M36：模板片段里的引用（洞内表达式递归；文本块无引用）。
refsInInterpParts : String -> List InterpPart -> List Ref -> List Ref
refsInInterpParts sMod [] acc = acc
refsInInterpParts sMod ((IPText s) :: rest) acc = refsInInterpParts sMod rest acc
refsInInterpParts sMod ((IPHole e) :: rest) acc =
  refsInInterpParts sMod rest (refsInExprGo sMod e acc)

-- ---------------------------------------------------------------
-- 全量构建
-- ---------------------------------------------------------------
record Built where
  builtModules : List ModuleInfo
  builtSymbols : List Sym
  builtRefs : List Ref

-- 索引一个文件。parse/fixity 失败返回 Err（调用方转成 warning），不中断整体。
-- 返回推进后的 `FixityEnv`：按目录复用包上下文与已加载模块图（见 Vuna.FixityEnv）。
indexOne : FixityEnv -> String -> String -> String -> Pair FixityEnv (Check Built)
indexOne env dir pkgName path =
  if runPure (prim_eff_fileExists path) then indexOneExisting env dir pkgName path
  else Pair env (err "${path}: no such file")

indexOneExisting : FixityEnv -> String -> String -> String -> Pair FixityEnv (Check Built)
indexOneExisting env dir pkgName path =
  let
    source = runPure (prim_eff_readFile path)
    bytes = strLength source
    looked = fixitiesForFile env path source
    env2 = firstOf looked
  in case secondOf looked of
    ErrC e => Pair env2 (err "${path}: cannot load package fixity context: ${diagText e}")
    OkC programFixities => case parseSource path source of
      ErrC e => Pair env2 (err "${path}: ${diagText e}")
      -- M31.3（B26/B27）：必须按**程序级** fixity 重排（本文件声明 ++ import 闭包，
      -- 本地优先）。只用本地声明会让用到 `+`/`==`/`::` 的文件报 unknown fixity，
      -- 然后被当错误跳过 → `vuna map` 静默漏模块。
      OkC (SourceFile srcHdr imports fx decls0) => case reorderProgram (tableOfKeepOps (append programFixities fx)) decls0 of
        ErrC e => Pair env2 (err "${path}: ${diagText e}")
        OkC decls =>
          let
            sMod = moduleNameOf dir path srcHdr
            comments = case lexComments source of
              ErrC e => []
              OkC cs => cs
            table = docTableOf srcHdr decls comments
            info = ModuleInfo sMod pkgName path bytes (length decls)
            syms = symbolsOfModule sMod decls table
            refs = refsInDecls sMod decls
          in Pair env2 (OkC (Built [info] syms refs))

record Acc where
  accModules : List ModuleInfo
  accSymbols : List Sym
  accRefs : List Ref
  accWarns : List Diagnostic

-- 把 xs 逆序前插到 ys（O(#xs)）：跨文件累积用，避免每文件 append 复制整个已累积列表（M34）。
prependRev : List a -> List a -> List a
prependRev [] ys = ys
prependRev (x :: rest) ys = prependRev rest (x :: ys)

indexPackage : FixityEnv -> String -> String -> List String -> Acc -> Pair FixityEnv Acc
indexPackage env dir pkgName files acc = foldFiles env dir pkgName files acc

foldFiles : FixityEnv -> String -> String -> List String -> Acc -> Pair FixityEnv Acc
foldFiles env dir pkgName [] acc = Pair env acc
foldFiles env dir pkgName (path :: rest) acc =
  let
    stepped = indexFileInto env dir pkgName path acc
  in foldFiles (firstOf stepped) dir pkgName rest (secondOf stepped)

indexFileInto : FixityEnv -> String -> String -> String -> Acc -> Pair FixityEnv Acc
indexFileInto env dir pkgName path acc = case indexOne env dir pkgName path of
  Pair env2 result => case result of
    ErrC e => Pair env2 (Acc acc.accModules acc.accSymbols acc.accRefs (e :: acc.accWarns))
    OkC b =>
      Pair env2
        (Acc (prependRev b.builtModules acc.accModules) (prependRev b.builtSymbols acc.accSymbols) (prependRev b.builtRefs acc.accRefs) acc.accWarns)

collectAll : FixityEnv -> List (Pair String String) -> Acc -> Pair FixityEnv Acc
collectAll env [] acc = Pair env acc
collectAll env (root :: rest) acc =
  let
    dir = firstOf root
    pkgName = secondOf root
    files = packageSources dir
    stepped = indexPackage env dir pkgName files acc
  in collectAll (firstOf stepped) rest (secondOf stepped)

-- 全量构建（parse 所有源码，不读写缓存）。
buildIndex : String -> Check Index
buildIndex repo =
  let
    stepped = collectAll emptyFixityEnv (packageDirs repo) (Acc [] [] [] [])
    acc = secondOf stepped
  in OkC
    (Index (reverse acc.accModules) (dedupeSymbols (reverse acc.accSymbols)) (reverse acc.accRefs))

-- ---------------------------------------------------------------
-- 缓存读写（v2：内容哈希）
-- ---------------------------------------------------------------
cacheVersion : String
cacheVersion = "vuna-index 3"

cacheDir : String -> String
cacheDir repo = "${repo}/.local/index"

modulesPath : String -> String
modulesPath repo = "${cacheDir repo}/modules.txt"

symbolsPath : String -> String
symbolsPath repo = "${cacheDir repo}/symbols.txt"

refsPath : String -> String
refsPath repo = "${cacheDir repo}/refs.txt"

lockPath : String -> String
lockPath repo = "${cacheDir repo}/cache.lock"

-- 缓存条目：path、bytes、内容哈希。
-- 哈希 = strHash(content) 与 strHash("v2:" ++ content) 的组合（同一内容必须得到同一
-- 字符串；两个 10 位哈希组合降低「同 size 同 mtime 内容变更」漏判的概率）。
contentHash : String -> String
contentHash content = "${Base.Hashable.hashStr content}-${Base.Hashable.hashStr "v2:${content}"}"

entryPath : Pair String (Pair Int String) -> String
entryPath entry = firstOf entry

entryBytes : Pair String (Pair Int String) -> Int
entryBytes entry = firstOf (secondOf entry)

entryHash : Pair String (Pair Int String) -> String
entryHash entry = secondOf (secondOf entry)

-- 磁盘上的当前文件元数据（path, bytes, hash）。读内容算哈希，不 parse。
scanFile : String -> Pair String (Pair Int String)
scanFile path =
  if runPure (prim_eff_fileExists path) then scanFileExisting path else Pair path (Pair 0 "")

scanFileExisting : String -> Pair String (Pair Int String)
scanFileExisting path =
  let
    source = runPure (prim_eff_readFile path)
  in Pair path (Pair (strLength source) (contentHash source))

scanRoot : Pair String String -> List (Pair String (Pair Int String))
scanRoot root = map scanFile (packageSources (firstOf root))

scanSources : String -> List (Pair String (Pair Int String))
scanSources repo = concatMap scanRoot (packageDirs repo)

manifestLine : Pair String (Pair Int String) -> String
manifestLine entry = "${entryPath entry}\t${entryBytes entry}\t${entryHash entry}"

manifestText : List (Pair String (Pair Int String)) -> String
manifestText entries = """${cacheVersion}
${join "\n" (map manifestLine entries)}
"""

-- 逐字段显式比较（与 M29 的判等口径一致：String / Int 的 `==` 都走特化路径）。
manifestEntrySame : Pair String (Pair Int String) -> Pair String (Pair Int String) -> Bool
manifestEntrySame a b =
  entryPath a == entryPath b && entryBytes a == entryBytes b && entryHash a == entryHash b

manifestEntriesSame : List (Pair String (Pair Int String)) -> List (Pair String (Pair Int String)) -> Bool
manifestEntriesSame [] [] = True
manifestEntriesSame (a :: rest) (b :: rest2) =
  manifestEntrySame a b && manifestEntriesSame rest rest2
manifestEntriesSame _ _ = False

-- v2 manifest：首行必须是版本行；旧格式（无版本行）返回 Nothing → 触发全量重建。
parseManifestV2 : String -> Maybe (List (Pair String (Pair Int String)))
parseManifestV2 text = case splitOnNewline text of
  [] => Nothing
  versionLine :: rest =>
    if versionLine == cacheVersion then Just (concatMap parseManifestLine rest) else Nothing

parseManifestLine : String -> List (Pair String (Pair Int String))
parseManifestLine line = case splitOnTab line of
  [path, bytes, hash] => if path == "" then []
  else case parseInt bytes of
    Just b => [Pair path (Pair b hash)]
    Nothing => []
  _ => []

manifestPath : String -> String
manifestPath repo = "${cacheDir repo}/manifest.txt"

readManifestEntries : String -> Maybe (List (Pair String (Pair Int String)))
readManifestEntries repo =
  let
    path = manifestPath repo
  in if runPure (prim_eff_fileExists path) then parseManifestV2 (runPure (prim_eff_readFile path))
  else Nothing

manifestMatches : String -> List (Pair String (Pair Int String)) -> Bool
manifestMatches repo entries = case readManifestEntries repo of
  Just cached => manifestEntriesSame cached entries
  Nothing => False

-- ---------------------------------------------------------------
-- 写缓存：逐级建目录 + 目录锁 + 原子替换
-- ---------------------------------------------------------------
-- 写缓存：`.local` 在干净 clone / Nix 沙箱里可能不存在，而 prim_eff_makeDir 只建一层，
-- 所以要逐级创建（先 .local，再 .local/index）。缓存是纯优化：写不进去时
-- 索引本身仍然可用（本次调用已返回内存索引），只是下次会重建。
-- 注意：两个进程可能同时首次建缓存目录，`prim_eff_makeDir`（Sys.mkdir + failwith）
-- 在竞争时会对 EEXIST 抛宿主异常；用 `prim_eff_runIn mkdir`（返回码，不抛）保证并发安全。
ensureCacheDir : String -> Int
ensureCacheDir repo =
  let
    local = "${repo}/.local"
  in let
    _ = if dirExists local then 0 else primRunMkdir repo ".local"
  in if dirExists (cacheDir repo) then 0 else primRunMkdir repo ".local/index"

primRunMkdir : String -> String -> Int
primRunMkdir repo name = runPure (prim_eff_runIn repo ["mkdir", name])

-- 目录可写性探测（test -w 不写文件）：不可写时不做任何写缓存动作。
writableDir : String -> Bool
writableDir dir = runPure (prim_eff_runIn dir ["test", "-w", "."]) == 0

-- 锁年龄判定：`effTimeUs` 是时钟能力（vuna 根包 manifest 已声明 clock）。
nowSeconds : Int -> Int
nowSeconds _ = runPure effTimeUs / 1000000

lockIsFresh : Int -> String -> Bool
lockIsFresh _ path =
  let
    age = nowSeconds 0 - runPure (prim_eff_fileMtime path)
  in age >= 0 && age < 60

-- `mkdir` 是原子创建：返回 0 表示本进程拿到锁；非 0（已存在/不可写）表示放弃写缓存。
-- 用 prim_eff_runIn 而不是 prim_eff_makeDir：后者在并发竞争（路径刚被另一进程创建）时
-- 会抛宿主 failwith，而锁失败按约定必须静默降级。
tryMkdirLock : String -> Bool
tryMkdirLock repo = runPure (prim_eff_runIn (cacheDir repo) ["mkdir", "cache.lock"]) == 0

acquireLock : String -> Bool
acquireLock repo =
  let
    path = lockPath repo
  in if dirExists path then if lockIsFresh 0 path then False
  else
    let
      _ = runPure (prim_eff_runIn (cacheDir repo) ["rm", "-rf", "cache.lock"])
    in tryMkdirLock repo
  else tryMkdirLock repo

releaseLock : String -> Int
releaseLock repo = runPure (prim_eff_runIn (cacheDir repo) ["rm", "-rf", "cache.lock"])

-- 过期残留锁清理：缓存命中时不会走 saveIndex，但上一次崩溃/并发留下的**过期**锁
-- 必须清掉，否则它会在下一次缓存失效时让写缓存白等（<60s 新鲜锁仍尊重持有者）。
cleanupStaleLock : String -> Int
cleanupStaleLock repo =
  let
    path = lockPath repo
  in if dirExists path then if lockIsFresh 0 path then 0
  else runPure (prim_eff_runIn (cacheDir repo) ["rm", "-rf", "cache.lock"])
  else 0

-- 每个缓存文件先写 `<name>.tmp`，再 `mv` 同目录原子替换（rename(2)）。
writeAtomic : String -> String -> String -> Int
writeAtomic repo name content =
  let
    dir = cacheDir repo
    tmpName = "${name}.tmp"
    _ = runPure (prim_eff_writeFile "${dir}/${tmpName}" content)
  in runPure (prim_eff_runIn dir ["mv", tmpName, name])

-- 数据文件先写、manifest 最后：manifest 存在即表示其余文件都已提交。
-- 任一数据文件写失败都不写 manifest（降级为内存索引，下次重建）。
writeCacheFiles : String -> List (Pair String (Pair Int String)) -> Index -> Int
writeCacheFiles repo entries index =
  let
    modulesCode = writeAtomic repo "modules.txt" (modulesText index)
  in if modulesCode /= 0 then 1
  else
    let
      symbolsCode = writeAtomic repo "symbols.txt" (symbolsText index)
    in if symbolsCode /= 0 then 1
    else
      let
        refsCode = writeAtomic repo "refs.txt" (refsText index)
      in if refsCode /= 0 then 1 else writeAtomic repo "manifest.txt" (manifestText entries)

saveIndex : String -> List (Pair String (Pair Int String)) -> Index -> Int
saveIndex repo entries index =
  let
    _ = ensureCacheDir repo
  in if dirExists (cacheDir repo) then if writableDir (cacheDir repo) then if acquireLock repo then
    let
      code = writeCacheFiles repo entries index
    in let
      _ = releaseLock repo
    in code
  else 0
  else 0
  else 0

loadIndexFromCache : String -> Index
loadIndexFromCache repo =
  Index (parseModules (parseLines (readOrEmpty (modulesPath repo))))
    (parseSymbols (parseLines (readOrEmpty (symbolsPath repo))))
    (parseRefs (parseLines (readOrEmpty (refsPath repo))))

readOrEmpty : String -> String
readOrEmpty path =
  if runPure (prim_eff_fileExists path) then runPure (prim_eff_readFile path) else ""

parseLines : String -> List String
parseLines text = filterNonEmpty (splitOnNewline text)

filterNonEmpty : List String -> List String
filterNonEmpty [] = []
filterNonEmpty (line :: rest) =
  if line == "" then filterNonEmpty rest else line :: filterNonEmpty rest

parseModules : List String -> List ModuleInfo
parseModules [] = []
parseModules (line :: rest) = case splitOnTab line of
  [m, p, path, bytes, decls] => case parseInt bytes of
    Just b => case parseInt decls of
      Just dc => ModuleInfo m p path b dc :: parseModules rest
      Nothing => parseModules rest
    Nothing => parseModules rest
  _ => parseModules rest

parseSymbols : List String -> List Sym
parseSymbols [] = []
parseSymbols (line :: rest) = case splitOnTab line of
  [m, n, k, ln, col, sg, doc, ty] => case parseInt ln of
    Just l => case parseInt col of
      Just c =>
        Sym m n k (unescapeField sg) (unescapeField ty) (unescapeField doc) l c :: parseSymbols rest
      Nothing => parseSymbols rest
    Nothing => parseSymbols rest
  _ => parseSymbols rest

parseRefs : List String -> List Ref
parseRefs [] = []
parseRefs (line :: rest) = case splitOnTab line of
  [m, n, ln, col] => case parseInt ln of
    Just l => case parseInt col of
      Just c => Ref m n l c :: parseRefs rest
      Nothing => parseRefs rest
    Nothing => parseRefs rest
  _ => parseRefs rest

-- 带缓存的入口：manifest 完全一致则回读缓存，否则重建并写回。
-- 非 workspace（向上找不到 vuna.toml）是**输入错误**，不再静默建空索引。
loadOrBuild : String -> Check Index
loadOrBuild repo = case findManifestDirMaybe repo of
  Nothing => err "index: no vuna.toml found from ${runPure prim_eff_getcwd} (searched upward)"
  Just manifestDir =>
    let
      entries = scanSources repo
    in if manifestMatches repo entries then
      let
        _ = cleanupStaleLock repo
      in OkC (loadIndexFromCache repo)
    else saveAndReturn repo entries

saveAndReturn : String -> List (Pair String (Pair Int String)) -> Check Index
saveAndReturn repo entries = case buildIndex repo of
  ErrC e => ErrC e
  OkC index =>
    let
      _ = saveIndex repo entries index
    in OkC index

-- ---------------------------------------------------------------
-- 序列化（写缓存用）
-- ---------------------------------------------------------------
modulesText : Index -> String
modulesText index = "${join "\n" (map moduleLine (indexModules index))}\n"

moduleLine : ModuleInfo -> String
moduleLine m = "${modName m}\t${modPackage m}\t${modPath m}\t${modBytes m}\t${modDecls m}"

symbolsText : Index -> String
symbolsText index = "${join "\n" (map symLine0 index.indexSymbols)}\n"

symLine0 : Sym -> String
symLine0 s =
  "${symModule s}\t${symName s}\t${symKind s}\t${symLine s}\t${symCol s}\t${escapeField (symSig s)}\t${escapeField s.symDoc}\t${escapeField s.symType}"

refsText : Index -> String
refsText index = "${join "\n" (map refLineText index.indexRefs)}\n"

refLineText : Ref -> String
refLineText r = "${refModule r}\t${refName r}\t${r.refLine}\t${r.refCol}"

-- ---------------------------------------------------------------
-- 廉价新鲜度探针（REPL 会话缓存用，D35）
-- ---------------------------------------------------------------
-- `loadOrBuild` 的新鲜度判定要**读每个源文件算内容哈希**（166 模块 ≈0.6–1.1s），这是 REPL
-- 首次 `:browse` 卡顿的来源。REPL 会话改用 stat 快照判定：建立时记下每个源文件的
-- (path, bytes, mtime, 内容哈希)，复用前只重新遍历目录 + stat，逐条比对。
--
-- 判定语义与 `Driver/Cache` 的 `sourceInfoUnchanged` 一致：
--   * path 集合 / bytes / mtime 全部未变 ⇒ 内容未变（不读文件）；
--   * mtime 距快照建立时刻 `builtSec` 不足 `indexMtimeSafetyWindowSec` 秒的文件**一律回落
--     内容哈希**（mtime 只有秒级分辨率，同秒内同 size 的编辑不可分辨，宁可慢也不错用旧
--     索引）；
--   * 任一条目缺失 / 变化 / 回落哈希不一致 ⇒ 快照失效，调用方退回完整 `loadOrBuild`
--     （内容哈希判定 + 按需重建 + 回写 `.local/index`）。
-- 快照只存内存（REPL 会话内），不落盘、不改 `manifest.txt` 的 v3 格式与写侧语义。
indexMtimeSafetyWindowSec : Int
indexMtimeSafetyWindowSec = 5

record SourceStat where
  ssPath : String
  ssBytes : Int
  ssMtime : Int
  ssHash : String

-- 建立快照：遍历目录拿到当前源文件集合，逐个 stat；窗口内文件额外读内容算哈希。
indexStatsOf : Int -> String -> List SourceStat
indexStatsOf builtSec repo =
  map (sourceStatOf builtSec) (concatMap packageSources (map firstOf (packageDirs repo)))

-- mtime 距 `builtSec` 不足安全窗 ⇒ 内容哈希必须算（同秒同 size 的编辑 stat 不可分辨）；
-- 窗外的文件只 stat，哈希留空。快照与校验用同一条规则、同一个 `builtSec` ⇒ 同一文件要么
-- 两侧都算哈希、要么两侧都不算，不会出现「一侧有哈希一侧没有」的假失配。
sourceStatOf : Int -> String -> SourceStat
sourceStatOf builtSec path = if runPure (prim_eff_fileExists path) then
  let
    bytes = runPure (prim_eff_fileSize path)
    mtime = runPure (prim_eff_fileMtime path)
  in if mtime + indexMtimeSafetyWindowSec > builtSec then
    let
      source = runPure (prim_eff_readFile path)
    in SourceStat path (strLength source) mtime (contentHash source)
  else SourceStat path bytes mtime ""
else SourceStat path 0 0 ""

-- 快照校验：当前 stat 面与快照逐条一致（顺序无关，按 path 对齐；集合不同即失效）。
indexStatsUnchanged : Int -> List SourceStat -> List SourceStat -> Bool
indexStatsUnchanged builtSec snapshot current =
  statCount snapshot == statCount current && indexStatsUnchangedGo current snapshot

statCount : List SourceStat -> Int
statCount [] = 0
statCount (_ :: rest) = 1 + statCount rest

indexStatsUnchangedGo : List SourceStat -> List SourceStat -> Bool
indexStatsUnchangedGo [] _ = True
indexStatsUnchangedGo _ [] = False
indexStatsUnchangedGo snapshot (cur :: rest) =
  statMatches snapshot cur && indexStatsUnchangedGo snapshot rest

statMatches : List SourceStat -> SourceStat -> Bool
statMatches [] _ = False
statMatches (s :: rest) cur = case Pair s cur of
  Pair (SourceStat p1 b1 m1 h1) (SourceStat p2 b2 m2 h2) =>
    if p1 /= p2 then statMatches rest cur
    else if b1 /= b2 || m1 /= m2 then False else if h1 /= "" || h2 /= "" then h1 == h2 else True
