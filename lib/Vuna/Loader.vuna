module Vuna.Loader (Module, moduleNameOf, modulePackageOf, moduleImportsOf, moduleDeclsOf, moduleExportsOf, Project, projectEntryDecls, projectEntryImports, projectModules, loadProject, resolveProject, loadProgram, loadProgramRaw) where

-- Vuna.Loader：模块加载、名字解析与 flatten。

import Vuna.Base
import Vuna.Ast
import Vuna.Lexer
import Vuna.Parser
import Vuna.Builtins
import Vuna.Pkg

data Module : Type where
  Module : String -> String -> List Import -> List Decl -> List ExportEntry -> Module

-- 已加载项目：入口声明/import + 依赖模块列表（M12 分离编译用；保持 flatten 前的形态）。
data Project : Type where
  Project : List Decl -> List Import -> List Module -> Project

moduleNameOf (Module n p is ds es) = n

modulePackageOf (Module n p is ds es) = p

moduleImportsOf (Module n p is ds es) = is

moduleDeclsOf (Module n p is ds es) = ds

moduleExportsOf (Module n p is ds es) = es

projectEntryDecls (Project ds is ms) = ds

projectEntryImports (Project ds is ms) = is

projectModules (Project ds is ms) = ms

-- 模块导出表（M10）。每条是「本模块公开名 → 定义处带模块前缀的名字」。
-- kind 用字符串区分两套命名空间：val（函数/值）、ctor（构造器）、type（类型名）。
-- ctor 条目额外记录所属数据类型的定义名，供 `T(..)` 重导出保持源模块的抽象性。
-- 模块导出表条目：公开名、定义处名字、所属类型（仅 ctor）。
record ExportEntry where
  kind : String
  public : String
  target : String
  parent : String
deriving (Eq)

data ExportRef : Type where
  ExportRef : String -> String -> String -> ExportRef


allIdentChars chars =
  case chars of
    Nil => True
    Cons c rest =>
      if isIdentStart c || isDigit c then allIdentChars rest else False

validSegment seg =
  case strUnpack seg of
    Nil => False
    Cons c rest => isUpperChar c && allIdentChars rest

allSegmentsValid segs =
  case segs of
    Nil => False
    Cons seg rest =>
      if validSegment seg then
        case rest of
          Nil => True
          _ => allSegmentsValid rest
      else False

validModuleName name =
  case splitOnDot name of
    Nil => False
    segs => allSegmentsValid segs

isGlobalCtor name =
  name == "True" || name == "False" || name == "Cons" || name == "Nil"

mangle prefix name = if prefix == "" then name else prefix ++ "." ++ name

importName (Import name isQualified alias sp) = name

importIsQualified (Import name isQualified alias sp) = isQualified

importAlias (Import name isQualified alias sp) = alias

importModuleNames imports = map importName imports

hasDuplicateName Nil = False
hasDuplicateName (Cons x rest) =
  if memName x rest then True else hasDuplicateName rest

importAliases imports =
  case imports of
    Nil => Nil
    Cons imp rest =>
      case importAlias imp of
        Nothing => importAliases rest
        Just alias => Cons (Pair alias (importName imp)) (importAliases rest)

checkImportAliases label moduleNames aliases =
  case aliases of
    Nil => Ok Nil
    Cons (Pair alias m) rest =>
      if validSegment alias then
        if memName alias (map firstOf rest) then
          Err (label ++ ": duplicate module alias " ++ alias)
        else if memName alias moduleNames then
          if alias == m then checkImportAliases label moduleNames rest
          else Err (label ++ ": module alias " ++ alias ++ " conflicts with an imported module")
        else checkImportAliases label moduleNames rest
      else Err (label ++ ": invalid module alias " ++ alias)

validateImports label imports =
  if hasDuplicateName (importModuleNames imports) then
    Err (label ++ ": duplicate import")
  else checkImportAliases label (importModuleNames imports) (importAliases imports)

openModuleNames imports =
  case imports of
    Nil => Nil
    Cons imp rest =>
      if importIsQualified imp then openModuleNames rest
      else Cons (importName imp) (openModuleNames rest)

findImportPrefix imports prefix =
  case imports of
    Nil => Nothing
    Cons imp rest =>
      if importName imp == prefix then Just (importName imp)
      else
        case importAlias imp of
          Just alias =>
            if alias == prefix then Just (importName imp) else findImportPrefix rest prefix
          Nothing => findImportPrefix rest prefix

_joinNames Nil = ""
_joinNames (Cons x Nil) = x
_joinNames (Cons x rest) = x ++ ", " ++ _joinNames rest

moduleDecls modules name =
  case findModule modules name of
    Just (Module mname mpkg imports decls exports) => decls
    Nothing => Nil

moduleCtors modules name = ctorsOf (moduleDecls modules name)

exportsOf modules name =
  case findModule modules name of
    Just (Module mname mpkg imports decls exports) => exports
    Nothing => Nil

entryKind : ExportEntry -> String
entryKind e = e.kind

entryPublic : ExportEntry -> String
entryPublic e = e.public

entryTarget : ExportEntry -> String
entryTarget e = e.target

entryParent : ExportEntry -> String
entryParent e = e.parent

-- 按命名空间查公开名：kinds 是允许的 kind 列表（val / ctor / type）。
lookupExport kinds name entries =
  case entries of
    Nil => Nothing
    Cons e rest =>
      if memName (entryKind e) kinds && entryPublic e == name then Just e
      else lookupExport kinds name rest

findExportValue entries name = lookupExport (Cons "val" (Cons "ctor" Nil)) name entries

findExportCtor entries name = lookupExport (Cons "ctor" Nil) name entries

findExportType entries name = lookupExport (Cons "type" Nil) name entries

modulesExportingValueFrom modules names name =
  case names of
    Nil => Nil
    Cons m rest =>
      case findExportValue (exportsOf modules m) name of
        Just e => Cons (Pair m e) (modulesExportingValueFrom modules rest name)
        Nothing => modulesExportingValueFrom modules rest name

modulesExportingValue modules imports name =
  modulesExportingValueFrom modules (openModuleNames imports) name

modulesExportingCtorFrom modules names name =
  case names of
    Nil => Nil
    Cons m rest =>
      case findExportCtor (exportsOf modules m) name of
        Just e => Cons (Pair m e) (modulesExportingCtorFrom modules rest name)
        Nothing => modulesExportingCtorFrom modules rest name

modulesExportingCtor modules imports name =
  modulesExportingCtorFrom modules (openModuleNames imports) name

modulesExportingTypeFrom modules names name =
  case names of
    Nil => Nil
    Cons m rest =>
      case findExportType (exportsOf modules m) name of
        Just e => Cons (Pair m e) (modulesExportingTypeFrom modules rest name)
        Nothing => modulesExportingTypeFrom modules rest name

modulesExportingType modules imports name =
  modulesExportingTypeFrom modules (openModuleNames imports) name

-- 重导出时同名可能来自多个模块；只要 target 相同就不是歧义（门面伞模块常见）。
sameTargetRest e pairs =
  case pairs of
    Nil => True
    Cons (Pair m e2) rest => if entryTarget e == entryTarget e2 then sameTargetRest e rest else False

unifyEntryPairs label kindLabel name Nil = Err (label ++ ": unknown " ++ kindLabel ++ " " ++ name)

unifyEntryPairs label kindLabel name (Cons p rest) =
  if sameTargetRest (secondOf p) rest then Ok p
  else
    Err
      (label ++ ": ambiguous " ++ kindLabel ++ " " ++ name ++ " (imported from "
     ++ _joinNames (map firstOf (Cons p rest)) ++ "); qualify it")

modulePath root name = rootDir root ++ "/" ++ joinSlashes (splitOnDot name) ++ ".vuna"

-- 当前导入方所在包能否看到该 root 中的模块：同包永远可见；跨包只认 [export] 列表。
rootAllows : String -> Root -> String -> Bool
rootAllows importerPkg root name =
  case rootExports root of
    Nothing => True
    Just mods => rootName root == importerPkg || memName name mods

collectModuleFiles : List Root -> String -> String -> List (Pair String Root) -> List String -> Pair (List (Pair String Root)) (List String)
collectModuleFiles roots name importerPkg allowed hidden =
  case roots of
    Nil => Pair (reverse allowed) (reverse hidden)
    Cons root rest =>
      let path = modulePath root name
      in if fileExists path then
           if rootAllows importerPkg root name then
             collectModuleFiles rest name importerPkg (Cons (Pair path root) allowed) hidden
           else collectModuleFiles rest name importerPkg allowed (Cons (rootName root) hidden)
         else collectModuleFiles rest name importerPkg allowed hidden

_joinRootDirs roots = _joinNames (map rootDir roots)

candidateDir : Pair String Root -> String
candidateDir candidate = rootDir (secondOf candidate)

findModuleFile : List Root -> String -> String -> Result (Pair String Root)
findModuleFile roots name importerPkg =
  case collectModuleFiles roots name importerPkg Nil Nil of
    Pair allowed hidden =>
      case allowed of
        Nil =>
          case hidden of
            Nil => Err ("module " ++ name ++ " not found (roots: " ++ _joinRootDirs roots ++ ")")
            pkgs => Err ("module " ++ name ++ " is not exported by package " ++ _joinNames hidden)
        Cons only Nil => Ok only
        candidates => Err ("ambiguous module " ++ name ++ " (found in: " ++ _joinNames (map candidateDir allowed) ++ ")")

findModule modules name =
  case modules of
    Nil => Nothing
    Cons (Module mname mpkg imports decls exports) rest =>
      if mname == name then Just (Module mname mpkg imports decls exports) else findModule rest name

isBuiltinName name =
  case builtinArity name of
    Just arity => True
    Nothing => False

isBuiltinTraitName name =
  name == "Show" || name == "Eq" || name == "Ord"

isPreludeTraitMethod name =
  name == "show" || name == "eq" || name == "neq"
  || name == "lt" || name == "le" || name == "gt" || name == "ge"

resolveQualified modules label imports name =
  case splitLastDot (splitOnDot name) of
    Pair revPrefix base =>
      let prefix = joinDots revPrefix
      in case findImportPrefix imports prefix of
           Nothing => Err (label ++ ": module " ++ prefix ++ " is not imported")
           Just m =>
             if isGlobalCtor base then Ok base
             else
               case findExportValue (exportsOf modules m) base of
                 Just e => Ok (entryTarget e)
                 Nothing => Err (label ++ ": " ++ base ++ " is not exported by " ++ m)

-- 模式里的限定名只认构造器：`M.foo`（foo 是函数）必须报错，不能按值解析成构造器。
resolveQualifiedCtor modules label imports name =
  case splitLastDot (splitOnDot name) of
    Pair revPrefix base =>
      let prefix = joinDots revPrefix
      in case findImportPrefix imports prefix of
           Nothing => Err (label ++ ": module " ++ prefix ++ " is not imported")
           Just m =>
             if isGlobalCtor base then Ok base
             else
               case findExportCtor (exportsOf modules m) base of
                 Just e => Ok (entryTarget e)
                 Nothing => Err (label ++ ": constructor " ++ base ++ " is not exported by " ++ m)

-- 带点表达式的解析（M10.5）：先按「最长可解析模块前缀」尝试限定名/限定值+字段链，
-- 否则按「变量/顶层名 + 字段链」处理。`p.x`、`M.point.x`、`Vuna.Parser.parseSource` 都走这里。
resolveDottedExpr modules label prefix own imports scope name sp =
  case splitOnDot name of
    Nil => Err (label ++ ": invalid dotted name " ++ name)
    Cons head rest =>
      if memName head scope then Ok (foldFieldChain (EVar head sp) rest sp)
      else
        andThen (resolveQualifiedPath modules label imports (splitOnDot name) (length (splitOnDot name)) sp) (\q =>
          case q of
            Just e => Ok e
            Nothing =>
              if memName head own then Ok (foldFieldChain (EVar (mangle prefix head) sp) rest sp)
              else if isBuiltinName head then Ok (foldFieldChain (EVar head sp) rest sp)
              else if startsUpperName head then
                Err (label ++ ": module " ++ head ++ " is not imported")
              else andThen (resolveGlobal modules label prefix own imports scope head) (\n =>
                     Ok (foldFieldChain (EVar n sp) rest sp)))

foldFieldChain base Nil sp = base

foldFieldChain base (Cons f rest) sp = foldFieldChain (EField base f sp) rest sp

takeSegs n Nil = Nil
takeSegs n (Cons x rest) = if n <= 0 then Nil else Cons x (takeSegs (n - 1) rest)

dropSegs n Nil = Nil
dropSegs n (Cons x rest) = if n <= 0 then Cons x rest else dropSegs (n - 1) rest

resolveQualifiedPath modules label imports segs n sp =
  if n <= 1 then Ok Nothing
  else
    case findImportPrefix imports (joinDots (takeSegs (n - 1) segs)) of
      Just m =>
        case dropSegs (n - 1) segs of
          Cons member Nil =>
            if isGlobalCtor member then Ok (Just (EVar member sp))
            else
              case findExportValue (exportsOf modules m) member of
                Just e => Ok (Just (EVar (entryTarget e) sp))
                Nothing => Err (label ++ ": " ++ member ++ " is not exported by " ++ m)
          Cons member rest =>
            case findExportValue (exportsOf modules m) member of
              Just e => Ok (Just (foldFieldChain (EVar (entryTarget e) sp) rest sp))
              Nothing => Err (label ++ ": " ++ member ++ " is not exported by " ++ m)
          Nil => Ok Nothing
      Nothing => resolveQualifiedPath modules label imports segs (n - 1) sp

resolveGlobal modules label prefix own imports scope name =
  if memName name scope then Ok name
  else if isGlobalCtor name then Ok name
  else if containsDot name then resolveQualified modules label imports name
  else if memName name own then Ok (mangle prefix name)
  else if isBuiltinName name then Ok name
  else if isBuiltinTraitName name then Ok name
  else if isPreludeTraitMethod name then Ok name
  else
    case modulesExportingValue modules imports name of
      Nil => Err (label ++ ": unbound variable " ++ name ++ suggest name (append own scope))
      pairs =>
        andThen (unifyEntryPairs label "name" name pairs) (\p => Ok (entryTarget (secondOf p)))

resolveCtor modules label prefix ownCtors imports name =
  if isGlobalCtor name then Ok name
  else if containsDot name then resolveQualifiedCtor modules label imports name
  else if memName name ownCtors then Ok (mangle prefix name)
  else
    case modulesExportingCtor modules imports name of
      Nil => Err (label ++ ": unknown constructor " ++ name ++ suggest name ownCtors)
      pairs =>
        andThen (unifyEntryPairs label "constructor" name pairs) (\p => Ok (entryTarget (secondOf p)))

checkBinder label name =
  if containsDot name then Err (label ++ ": invalid variable name " ++ name)
  else Ok name

checkTopName label name =
  if name == "_" then Err (label ++ ": invalid top-level name _ (bare _ is reserved)")
  else if containsDot name then Err (label ++ ": invalid top-level name " ++ name)
  else Ok name

resolveTopName label prefix name =
  andThen (checkTopName label name) (\_ => Ok (mangle prefix name))

resolvePattern modules label prefix ownCtors imports pat =
  case pat of
    PWild sp => Ok (Pair (PWild sp) Nil)
    PVar name sp =>
      andThen (checkBinder label name) (\_ =>
        Ok (Pair (PVar name sp) (Cons name Nil)))
    PInt n sp => Ok (Pair (PInt n sp) Nil)
    PStr s sp => Ok (Pair (PStr s sp) Nil)
    PCon name pats sp =>
      andThen (resolveCtor modules label prefix ownCtors imports name) (\name2 =>
        andThen (traverse (resolvePattern modules label prefix ownCtors imports) pats) (\parts =>
          Ok (Pair (PCon name2 (map firstOf parts) sp) (concatMap secondOf parts))))
    PRecord name fields sp =>
      andThen (resolveCtor modules label prefix ownCtors imports name) (\name2 =>
        andThen (traverse (resolveRecordPatternField modules label prefix ownCtors imports) fields) (\parts =>
          Ok (Pair (PRecord name2 (map firstOf parts) sp) (concatMap secondOf parts))))

resolveRecordPatternField modules label prefix ownCtors imports (Pair fname pat) =
  andThen (resolvePattern modules label prefix ownCtors imports pat) (\p =>
    case p of
      Pair pat2 bound => Ok (Pair (Pair fname pat2) bound))

resolveAlt modules label prefix own ownCtors imports scope (Pair pat body) =
  andThen (resolvePattern modules label prefix ownCtors imports pat) (\p =>
    case p of
      Pair pat2 bound =>
        andThen (resolveExpr modules label prefix own ownCtors imports (append bound scope) body) (\body2 =>
          Ok (Pair pat2 body2)))

resolveLet modules label prefix own ownCtors imports scope rec_ binds body =
  if rec_ then resolveRecLet modules label prefix own ownCtors imports scope binds body
  else resolveLetSeq modules label prefix own ownCtors imports scope binds body

resolveLetSeq modules label prefix own ownCtors imports scope binds body =
  case binds of
    Nil =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope body) (\b =>
        Ok (Pair Nil b))
    Cons (Pair pat value) rest =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope value) (\value2 =>
        andThen (resolvePattern modules label prefix ownCtors imports pat) (\p =>
          case p of
            Pair pat2 bound =>
              andThen (resolveLetSeq modules label prefix own ownCtors imports (append bound scope) rest body) (\r =>
                case r of
                  Pair binds2 body2 =>
                    Ok (Pair (Cons (Pair pat2 value2) binds2) body2))))

-- 递归 let（where 块）：所有绑定名对全部 value 与 body 可见。
resolveRecLet modules label prefix own ownCtors imports scope binds body =
  case collectRecBinds modules label prefix ownCtors imports binds of
    Err e => Err e
    Ok (Pair names pairs) =>
      let scope2 = append names scope
      in andThen (resolveRecValues modules label prefix own ownCtors imports scope2 pairs) (\values2 =>
           andThen (resolveExpr modules label prefix own ownCtors imports scope2 body) (\b =>
             Ok (Pair values2 b)))

collectRecBinds modules label prefix ownCtors imports Nil = Ok (Pair Nil Nil)
collectRecBinds modules label prefix ownCtors imports (Cons (Pair pat value) rest) =
  andThen (resolvePattern modules label prefix ownCtors imports pat) (\pr =>
    case pr of
      Pair pat2 bound =>
        andThen (collectRecBinds modules label prefix ownCtors imports rest) (\r =>
          case r of
            Pair names tail => Ok (Pair (append bound names) (Cons (Pair pat2 value) tail))))

resolveRecValues modules label prefix own ownCtors imports scope Nil = Ok Nil
resolveRecValues modules label prefix own ownCtors imports scope (Cons (Pair pat value) rest) =
  andThen (resolveExpr modules label prefix own ownCtors imports scope value) (\value2 =>
    andThen (resolveRecValues modules label prefix own ownCtors imports scope rest) (\tail =>
      Ok (Cons (Pair pat value2) tail)))

resolveExpr modules label prefix own ownCtors imports scope expr =
  case expr of
    EVar name sp =>
      if containsDot name then resolveDottedExpr modules label prefix own imports scope name sp
      else andThen (resolveGlobal modules label prefix own imports scope name) (\n => Ok (EVar n sp))
    EInt n sp => Ok (EInt n sp)
    EStr s sp => Ok (EStr s sp)
    ELam params body sp =>
      andThen (traverse (checkBinder label) params) (\_ =>
        andThen (resolveExpr modules label prefix own ownCtors imports (append params scope) body) (\b =>
          Ok (ELam params b sp)))
    EApp fn args sp =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope fn) (\fn2 =>
        andThen (traverse (\a => resolveExpr modules label prefix own ownCtors imports scope a) args) (\args2 =>
          Ok (EApp fn2 args2 sp)))
    ELet binds body rec_ sp =>
      andThen (resolveLet modules label prefix own ownCtors imports scope rec_ binds body) (\r =>
        case r of
          Pair binds2 body2 => Ok (ELet binds2 body2 rec_ sp))
    ECase scrut alts sp =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope scrut) (\scrut2 =>
        andThen (traverse (resolveAlt modules label prefix own ownCtors imports scope) alts) (\alts2 =>
          Ok (ECase scrut2 alts2 sp)))
    EIf c t e sp =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope c) (\c2 =>
        andThen (resolveExpr modules label prefix own ownCtors imports scope t) (\t2 =>
          andThen (resolveExpr modules label prefix own ownCtors imports scope e) (\e2 =>
            Ok (EIf c2 t2 e2 sp))))
    EField base fname sp =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope base) (\b =>
        Ok (EField b fname sp))
    ERecord name fields sp =>
      andThen (resolveCtor modules label prefix ownCtors imports name) (\name2 =>
        andThen (traverse (resolveFieldValue modules label prefix own ownCtors imports scope) fields) (\fs =>
          Ok (ERecord name2 fs sp)))
    ERecUpdate base fields sp =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope base) (\b =>
        andThen (traverse (resolveFieldValue modules label prefix own ownCtors imports scope) fields) (\fs =>
          Ok (ERecUpdate b fs sp)))
    EInstSel meth name sp =>
      andThen (resolveExpr modules label prefix own ownCtors imports scope meth) (\m2 =>
        case resolveGlobal modules label prefix own imports scope name of
          Err e => Err (label ++ ": unknown instance name " ++ name ++ " (@" ++ name ++ ")")
          Ok n2 => Ok (EInstSel m2 n2 sp))
    EDo stmts sp =>
      andThen (desugarDo stmts) (\e =>
        resolveExpr modules label prefix own ownCtors imports scope e)

-- do（M11）在这里 desugar 成 bind/pure 的普通应用，后续类型检查与 codegen 无需认识 do。
-- 最后一条裸表达式即块结果（`do e` = `e`）；裸语句用 `bind e (\_ -> rest)` 顺序化。
desugarDo Nil = Err "do block needs at least one statement"
desugarDo (Cons (DExpr e sp) Nil) = Ok e
desugarDo (Cons (DExpr e sp) rest) =
  andThen (desugarDo rest) (\tail =>
    Ok (EApp (EVar "bind" sp)
          (Cons e (Cons (ELam (Cons "vuna_do_ignore" Nil) tail sp) Nil)) sp))
desugarDo (Cons (DBind (PVar name psp) e sp) rest) =
  andThen (desugarDo rest) (\tail =>
    Ok (EApp (EVar "bind" sp)
          (Cons e (Cons (ELam (Cons name Nil) tail sp) Nil)) sp))
desugarDo (Cons (DBind (PWild psp) e sp) rest) =
  andThen (desugarDo rest) (\tail =>
    Ok (EApp (EVar "bind" sp)
          (Cons e (Cons (ELam (Cons "vuna_do_ignore" Nil) tail sp) Nil)) sp))
desugarDo (Cons (DBind pat e sp) rest) =
  Err "do bind pattern must be a variable or _"

resolveFieldValue modules label prefix own ownCtors imports scope (Pair fname value) =
  andThen (resolveExpr modules label prefix own ownCtors imports scope value) (\v =>
    Ok (Pair fname v))

resolveCtorDecl label prefix ctor =
  if isGlobalCtor ctor then Ok ctor
  else andThen (checkTopName label ctor) (\_ => Ok (mangle prefix ctor))

isLowerTypeName name =
  case strUnpack name of
    Nil => False
    Cons c rest => isLowerChar c

startsUpperName name =
  case strUnpack name of
    Nil => False
    Cons c rest => c >= 65 && c <= 90

resolveTypeName modules label prefix ownTypes imports name =
  if name == "Int" || name == "String" || name == "Bool" || name == "Type" || name == "->" then
    Ok name
  else if isBuiltinTraitName name then Ok name
  else if isLowerTypeName name then Ok name
  else if containsDot name then
    case splitLastDot (splitOnDot name) of
      Pair revPrefix base =>
        let typePrefix = joinDots revPrefix
        in case findImportPrefix imports typePrefix of
             Nothing => Err (label ++ ": module " ++ typePrefix ++ " is not imported")
             Just m =>
               case findExportType (exportsOf modules m) base of
                 Just e => Ok (entryTarget e)
                 Nothing => Err (label ++ ": type " ++ base ++ " is not exported by " ++ m)
  else if memName name ownTypes then Ok (mangle prefix name)
  else
    case modulesExportingType modules imports name of
      Nil => Err (label ++ ": unknown type " ++ name)
      pairs =>
        andThen (unifyEntryPairs label "type" name pairs) (\p => Ok (entryTarget (secondOf p)))

resolveTypeExpr modules label prefix ownTypes imports ty =
  case ty of
    EVar name sp => andThen (resolveTypeName modules label prefix ownTypes imports name) (\n => Ok (EVar n sp))
    EApp fn args sp =>
      andThen (resolveTypeExpr modules label prefix ownTypes imports fn) (\fn2 =>
        andThen (traverse (resolveTypeExpr modules label prefix ownTypes imports) args) (\args2 =>
          Ok (EApp fn2 args2 sp)))
    _ => Err (label ++ ": invalid type expression (" ++ tyShape ty ++ ")")

resolveTypeTopName label prefix name =
  andThen (checkTopName label name) (\_ => Ok (mangle prefix name))

resolveCtorSpec modules label prefix ownTypes imports (Ctor ctor ty arity sp) =
  andThen (resolveCtorDecl label prefix ctor) (\c2 =>
    andThen (resolveTypeExpr modules label prefix ownTypes imports ty) (\ty2 =>
      Ok (Ctor c2 ty2 arity sp)))

resolveDecl modules label prefix own ownCtors ownTypes imports d =
  case d of
    DData dname params ctors derivings sp =>
      andThen (resolveTypeTopName label prefix dname) (\dn =>
        andThen (traverse (resolveCtorSpec modules label prefix ownTypes imports) ctors) (\ctors2 =>
          andThen (traverse (resolveTypeName modules label prefix ownTypes imports) derivings) (\ds2 =>
            Ok (DData dn params ctors2 ds2 sp))))
    DRecord dname params fields derivings sp =>
      andThen (resolveTypeTopName label prefix dname) (\dn =>
        andThen (traverse (resolveRecordField modules label prefix ownTypes imports) fields) (\fields2 =>
          andThen (traverse (resolveTypeName modules label prefix ownTypes imports) derivings) (\ds2 =>
            Ok (DRecord dn params fields2 ds2 sp))))
    DTrait tname params methods sp =>
      andThen (resolveTypeTopName label prefix tname) (\tn =>
        andThen (traverse (resolveTraitMethod modules label prefix ownTypes imports) methods) (\ms =>
          Ok (DTrait tn params ms sp)))
    DInstance iname isDefault head methods sp =>
      andThen (resolveInstanceName label prefix iname) (\in2 =>
        andThen (resolveTypeExpr modules label prefix ownTypes imports head) (\head2 =>
          andThen
            (traverse
              (resolveInstanceMethod modules label prefix own ownCtors ownTypes imports) methods)
            (\ms => Ok (DInstance in2 isDefault head2 ms sp))))
    DSig name ty sp =>
      andThen (resolveTopName label prefix name) (\n =>
        andThen (resolveTypeExpr modules label prefix ownTypes imports ty) (\ty2 =>
          Ok (DSig n ty2 sp)))
    DFun name pats body sp =>
      andThen (resolveTopName label prefix name) (\n =>
        andThen (traverse (resolvePattern modules label prefix ownCtors imports) pats) (\parts =>
          andThen (resolveExpr modules label prefix own ownCtors imports (concatMap secondOf parts) body) (\b =>
            Ok (DFun n (map firstOf parts) b sp))))

resolveRecordField modules label prefix ownTypes imports (Field fname ty sp) =
  andThen (checkBinder label fname) (\_ =>
    andThen (resolveTypeExpr modules label prefix ownTypes imports ty) (\ty2 =>
      Ok (Field fname ty2 sp)))

resolveTraitMethod modules label prefix ownTypes imports (Pair mname ty) =
  andThen (resolveTopName label prefix mname) (\n =>
    andThen (resolveTypeExpr modules label prefix ownTypes imports ty) (\ty2 =>
      Ok (Pair n ty2)))

-- 未命名实例（default）没有公开名字；给一个模块内私有的内部名字，便于校验孤儿规则。
resolveInstanceName label prefix Nothing = Ok (Just (mangle prefix "#default"))

resolveInstanceName label prefix (Just name) =
  andThen (resolveTopName label prefix name) (\n => Ok (Just n))

resolveInstanceMethod modules label prefix own ownCtors ownTypes imports d =
  case d of
    DSig name ty sp =>
      andThen (checkTopName label name) (\_ =>
        andThen (resolveTypeExpr modules label prefix ownTypes imports ty) (\ty2 =>
          Ok (DSig name ty2 sp)))
    DFun name pats body sp =>
      andThen (checkTopName label name) (\_ =>
        andThen (traverse (resolvePattern modules label prefix ownCtors imports) pats) (\parts =>
          andThen (resolveExpr modules label prefix own ownCtors imports (concatMap secondOf parts) body) (\b =>
            Ok (DFun name (map firstOf parts) b sp))))
    _ => Err (label ++ ": instance body may only contain method signatures/definitions")

resolveProgram modules label prefix own ownCtors ownTypes imports decls =
  traverse (resolveDecl modules label prefix own ownCtors ownTypes imports) decls

resolveEntry modules imports decls =
  resolveProgram modules "<entry>" "" (topNames decls) (ctorsOf decls) (typeNamesOf decls) imports decls

resolveModules modules =
  case modules of
    Nil => Ok Nil
    Cons (Module name mpkg imports decls exports) rest =>
      andThen (resolveProgram modules name name (topNames decls) (ctorsOf decls) (typeNamesOf decls) imports decls) (\d1 =>
        andThen (resolveModules rest) (\d2 => Ok (append d1 d2)))

-- ---------------------------------------------------------------
-- 模块导出表计算（M10）
-- ---------------------------------------------------------------

isPrivateName name = startsWith "_" name

privateExportMsg prefix sp name =
  prefix ++ ": " ++ showSpanLoc sp ++ ": cannot export private name " ++ name
  ++ " (names starting with _ are module-private)"

-- 本模块里与导出相关的「数据类型」信息：类型名 + 公开构造器名列表。
-- data / record / trait 都按同一套 T / T(..) 规则导出（trait 的方法是它的「构造器」）。
findOwnData name decls =
  case decls of
    Nil => Nothing
    Cons d rest =>
      case d of
        DData dname params ctors derivings sp =>
          if dname == name then Just (Pair dname (map ctorName ctors)) else findOwnData name rest
        DRecord dname params fields derivings sp =>
          if dname == name then Just (Pair dname (Cons dname Nil)) else findOwnData name rest
        DTrait tname params methods sp =>
          if tname == name then Just (Pair tname (map firstOf methods)) else findOwnData name rest
        _ => findOwnData name rest

findOwnFn name decls =
  case decls of
    Nil => Nothing
    Cons d rest =>
      case d of
        DFun n pats body sp => if n == name then Just name else findOwnFn name rest
        DSig n ty sp => if n == name then Just name else findOwnFn name rest
        _ => findOwnFn name rest

findCtorNamed name ctors =
  case ctors of
    Nil => Nothing
    Cons c rest =>
      if ctorName c == name then Just (ctorName c) else findCtorNamed name rest

findMethodNamed name methods =
  case methods of
    Nil => Nothing
    Cons (Pair mname ty) rest =>
      if mname == name then Just mname else findMethodNamed name rest

findOwnInstanceName name decls =
  case decls of
    Nil => Nothing
    Cons d rest =>
      case d of
        DInstance iname isDefault head methods sp =>
          if isDefault then findOwnInstanceName name rest
          else
            case iname of
              Just n => if n == name then Just n else findOwnInstanceName name rest
              Nothing => findOwnInstanceName name rest
        _ => findOwnInstanceName name rest

findOwnCtorName name decls =
  case decls of
    Nil => Nothing
    Cons d rest =>
      case d of
        DData dname params ctors derivings sp =>
          case findCtorNamed name ctors of
            Just cname => Just (Pair dname cname)
            Nothing => findOwnCtorName name rest
        DRecord dname params fields derivings sp =>
          if dname == name then Just (Pair dname dname) else findOwnCtorName name rest
        DTrait tname params methods sp =>
          case findMethodNamed name methods of
            Just mname => Just (Pair tname mname)
            Nothing => findOwnCtorName name rest
        _ => findOwnCtorName name rest

ownCtorEntries prefix dname names =
  case names of
    Nil => Nil
    Cons cname rest =>
      if isPrivateName cname then ownCtorEntries prefix dname rest
      else
        Cons
          (ExportEntry { kind = "ctor", public = cname, target = mangle prefix cname, parent = mangle prefix dname })
          (ownCtorEntries prefix dname rest)

-- 从某模块的导出表里取某数据类型的构造器条目：重导出 `T(..)` 时只重新公开
-- 源模块本来就公开的构造器，从而保持源模块的抽象性。
ctorEntriesOfType typeTarget entries =
  case entries of
    Nil => Nil
    Cons e rest =>
      if entryKind e == "ctor" && entryParent e == typeTarget then
        Cons e (ctorEntriesOfType typeTarget rest)
      else ctorEntriesOfType typeTarget rest

declImplicitExports prefix d =
  case d of
    DData dname params ctors derivings sp =>
      if isPrivateName dname then Nil
      else
        Cons
          (ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" })
          (ownCtorEntries prefix dname (map ctorName ctors))
    DRecord dname params fields derivings sp =>
      if isPrivateName dname then Nil
      else
        Cons
          (ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" })
          (ownCtorEntries prefix dname (Cons dname Nil))
    DTrait tname params methods sp =>
      if isPrivateName tname then Nil
      else
        Cons
          (ExportEntry { kind = "type", public = tname, target = mangle prefix tname, parent = "" })
          (ownCtorEntries prefix tname (map firstOf methods))
    DInstance iname isDefault head methods sp =>
      if isDefault then Nil
      else
        case iname of
          Nothing => Nil
          Just name =>
            if isPrivateName name then Nil
            else Cons (ExportEntry { kind = "val", public = name, target = mangle prefix name, parent = "" }) Nil
    DSig name ty sp =>
      if isPrivateName name then Nil
      else Cons (ExportEntry { kind = "val", public = name, target = mangle prefix name, parent = "" }) Nil
    DFun name pats body sp =>
      if isPrivateName name then Nil
      else Cons (ExportEntry { kind = "val", public = name, target = mangle prefix name, parent = "" }) Nil

implicitExports prefix decls = dedupeImplicitExports (concatMap (declImplicitExports prefix) decls)

-- 没有模块头 = 导出全部：类型签名 DSig 与子句 DFun 会为同一个函数各产生一条
-- val 条目，必须去重，否则重导出该模块时会在 duplicate export 检查里误报。
dedupeImplicitExports Nil = Nil

dedupeImplicitExports (Cons e rest) =
  if hasSamePublicKind e rest then dedupeImplicitExports rest
  else Cons e (dedupeImplicitExports rest)

refKind (ExportRef k tgt parent) = k

refTarget (ExportRef k tgt parent) = tgt

-- 裸名导出时，若名字是 **record 类型** 且与其同名构造器 target 相同，只导出类型、
-- 不导出构造器：抽象记录必须写 T(..) 才公开构造器。（普通 data 里 ctor 与类型同名
-- 的情形保持 v0 语义：裸名两者都导出。）
typeRefDominates modules decls prefix tr vr =
  case tr of
    Just (ExportRef tk tt tp) =>
      case vr of
        Just (ExportRef vk vt vp) =>
          if tk == "type" && vk == "ctor" && tt == vt then isRecordTarget modules decls prefix tt
          else False
        Nothing => False
    Nothing => False

isRecordTarget modules decls prefix target =
  case splitLastDot (splitOnDot target) of
    Pair revPrefix base =>
      let m = joinDots revPrefix
      in if m == prefix then isRecordDecl base decls
         else
           case findModule modules m of
             Just (Module mname mpkg mimports dcs exports) => isRecordDecl base dcs
             Nothing => False

isRecordDecl dname decls =
  case decls of
    Nil => False
    Cons d rest =>
      case d of
        DRecord dn params fields derivings sp =>
          if dn == dname then True else isRecordDecl dname rest
        _ => isRecordDecl dname rest

refEntryList pub Nothing = Nil

refEntryList pub (Just (ExportRef k tgt parent)) = Cons (ExportEntry { kind = k, public = pub, target = tgt, parent = parent }) Nil

ownOrImportedTypeRef modules prefix decls imports name =
  case findOwnData name decls of
    Just (Pair dname ctorNames) => Ok (Just (ExportRef "type" (mangle prefix dname) ""))
    Nothing =>
      case modulesExportingType modules imports name of
        Nil => Ok Nothing
        pairs =>
          case unifyEntryPairs prefix "type" name pairs of
            Err e => Err e
            Ok p => Ok (Just (ExportRef "type" (entryTarget (secondOf p)) ""))

ownOrImportedValueRef modules prefix decls imports name =
  case findOwnFn name decls of
    Just fn => Ok (Just (ExportRef "val" (mangle prefix fn) ""))
    Nothing =>
      case findOwnInstanceName name decls of
        Just iname => Ok (Just (ExportRef "val" (mangle prefix iname) ""))
        Nothing =>
          ownOrImportedValueRef2 modules prefix decls imports name

ownOrImportedValueRef2 modules prefix decls imports name =
  case findOwnCtorName name decls of
        Just (Pair dname cname) =>
          Ok (Just (ExportRef "ctor" (mangle prefix cname) (mangle prefix dname)))
        Nothing =>
          case modulesExportingValue modules imports name of
            Nil => Ok Nothing
            pairs =>
              case unifyEntryPairs prefix "name" name pairs of
                Err e => Err e
                Ok p =>
                  let e = secondOf p
                  in Ok (Just (ExportRef (entryKind e) (entryTarget e) (entryParent e)))

exportBare modules prefix decls imports name sp =
  case splitLastDot (splitOnDot name) of
    Pair revPrefix base =>
      case revPrefix of
        Nil =>
          if isPrivateName name then Err (privateExportMsg prefix sp name)
          else
            andThen (ownOrImportedTypeRef modules prefix decls imports name) (\tr =>
              andThen (ownOrImportedValueRef modules prefix decls imports name) (\vr =>
                case tr of
                  Nothing =>
                    case vr of
                      Nothing =>
                        Err (prefix ++ ": " ++ showSpanLoc sp ++ ": cannot export unknown name " ++ name)
                      Just _ => Ok (refEntryList name vr)
                  Just _ =>
                    case vr of
                      Nothing => Ok (refEntryList name tr)
                      Just _ =>
                        if typeRefDominates modules decls prefix tr vr then Ok (refEntryList name tr)
                        else Ok (append (refEntryList name tr) (refEntryList name vr))))
        _ =>
          let mprefix = joinDots revPrefix
          in case findImportPrefix imports mprefix of
               Nothing =>
                 Err (prefix ++ ": " ++ showSpanLoc sp ++ ": module " ++ mprefix ++ " is not imported")
               Just m => exportSelective modules prefix m base name sp

exportSelective modules prefix m base name sp =
  case findExportValue (exportsOf modules m) base of
    Just e =>
      case findExportType (exportsOf modules m) base of
        Just te =>
          Ok
            (Cons (ExportEntry { kind = entryKind e, public = base, target = entryTarget e, parent = entryParent e })
              (Cons (ExportEntry { kind = "type", public = base, target = entryTarget te, parent = "" }) Nil))
        Nothing =>
          Ok (Cons (ExportEntry { kind = entryKind e, public = base, target = entryTarget e, parent = entryParent e }) Nil)
    Nothing =>
      case findExportType (exportsOf modules m) base of
        Just te => Ok (Cons (ExportEntry { kind = "type", public = base, target = entryTarget te, parent = "" }) Nil)
        Nothing =>
          Err (prefix ++ ": " ++ showSpanLoc sp ++ ": cannot export unknown name " ++ name)

exportTypeAll modules prefix decls imports name sp =
  case splitLastDot (splitOnDot name) of
    Pair revPrefix base =>
      case revPrefix of
        Nil =>
          if isPrivateName name then Err (privateExportMsg prefix sp name)
          else
            case findOwnData name decls of
              Just (Pair dname ctorNames) =>
                Ok
                  (Cons
                    (ExportEntry { kind = "type", public = name, target = mangle prefix dname, parent = "" })
                    (ownCtorEntries prefix dname ctorNames))
              Nothing =>
                case modulesExportingType modules imports name of
                  Nil =>
                    Err (prefix ++ ": " ++ showSpanLoc sp ++ ": cannot export unknown name " ++ name)
                  pairs =>
                    case unifyEntryPairs prefix "type" name pairs of
                      Err e => Err e
                      Ok p =>
                        let m = firstOf p
                        in let tgt = entryTarget (secondOf p)
                           in Ok
                                (Cons
                                  (ExportEntry { kind = "type", public = name, target = tgt, parent = "" })
                                  (ctorEntriesOfType tgt (exportsOf modules m)))
        _ =>
          let mprefix = joinDots revPrefix
          in case findImportPrefix imports mprefix of
               Nothing =>
                 Err (prefix ++ ": " ++ showSpanLoc sp ++ ": module " ++ mprefix ++ " is not imported")
               Just m =>
                 case findExportType (exportsOf modules m) base of
                   Just e =>
                     Ok
                       (Cons
                         (ExportEntry { kind = "type", public = base, target = entryTarget e, parent = "" })
                         (ctorEntriesOfType (entryTarget e) (exportsOf modules m)))
                   Nothing =>
                     Err
                       (prefix ++ ": " ++ showSpanLoc sp ++ ": type " ++ base
                      ++ " is not exported by " ++ m)

exportItemEntries modules prefix decls imports item =
  case item of
    XModule name sp =>
      case findImportPrefix imports name of
        Nothing =>
          Err (prefix ++ ": " ++ showSpanLoc sp ++ ": module " ++ name ++ " is not imported")
        Just m => Ok (exportsOf modules m)
    XTypeAll name sp => exportTypeAll modules prefix decls imports name sp
    XBare name sp => exportBare modules prefix decls imports name sp

hasSamePublicKind e entries =
  case entries of
    Nil => False
    Cons e2 rest =>
      if entryKind e == entryKind e2 && entryPublic e == entryPublic e2 then True
      else hasSamePublicKind e rest

checkExportDuplicates prefix Nil = Ok Nil

checkExportDuplicates prefix (Cons e rest) =
  if hasSamePublicKind e rest then
    Err (prefix ++ ": duplicate export " ++ entryPublic e)
  else checkExportDuplicates prefix rest

explicitExports modules prefix decls imports Nil = Ok Nil

explicitExports modules prefix decls imports (Cons item rest) =
  andThen (exportItemEntries modules prefix decls imports item) (\es =>
    andThen (explicitExports modules prefix decls imports rest) (\tail =>
      Ok (append es tail)))

validateModuleHeader label hdr =
  case hdr of
    Nothing => Ok Nil
    Just (ModDecl declared hasList items sp) =>
      if declared == label then Ok Nil
      else
        Err
          (label ++ ": " ++ showSpanLoc sp ++ ": module name mismatch: source declares "
         ++ declared)

computeExports modules prefix hdr imports decls =
  case hdr of
    Nothing => Ok (implicitExports prefix decls)
    Just (ModDecl declared hasList items sp) =>
      if hasList then
        andThen (explicitExports modules prefix decls imports items) (\es =>
          andThen (checkExportDuplicates prefix es) (\_ => Ok es))
      else Ok (implicitExports prefix decls)

showCycle name stack = joinArrows (reverse (Cons name stack))

loadAll roots importerPkg modules stack imports =
  case imports of
    Nil => Ok modules
    Cons imp rest =>
      andThen (loadModule roots importerPkg modules stack (importName imp)) (\modules2 =>
        loadAll roots importerPkg modules2 stack rest)

loadModule roots importerPkg modules stack name =
  case findModule modules name of
    Just m => Ok modules
    Nothing =>
      if memName name stack then Err ("import cycle: " ++ showCycle name stack)
      else if validModuleName name then
        andThen (findModuleFile roots name importerPkg) (\found =>
          let path = firstOf found
          in let root = secondOf found
             in andThen (parseSource path (readFile path)) (\src =>
                  case src of
                    Source hdr imports decls =>
                      andThen (validateModuleHeader name hdr) (\_ =>
                        andThen (validateImports name imports) (\_ =>
                          andThen (loadAll roots (rootName root) modules (Cons name stack) imports) (\modules2 =>
                            andThen (computeExports modules2 name hdr imports decls) (\exports =>
                              Ok (Cons (Module name (rootName root) imports decls exports) modules2)))))))
      else Err ("invalid module name: " ++ name)

-- 包模式入口：entryPkg 是入口文件所属包（决定同包/跨包导出可见性）。
-- loadProject 返回 flatten 前的形态（入口声明 + 依赖模块列表），供分离编译使用。
loadProject roots entryPkg entry =
  if fileExists entry then
    andThen (parseSource entry (readFile entry)) (\src =>
      case src of
        Source hdr imports decls =>
          case hdr of
            Just (ModDecl dname hasList items sp) =>
              Err ("module header is not allowed in entry file (" ++ entry ++ ")")
            Nothing =>
              andThen (validateImports "<entry>" imports) (\_ =>
                andThen (loadAll roots entryPkg Nil Nil imports) (\modules =>
                  Ok (Project decls imports modules))))
  else Err ("entry file not found: " ++ entry)

-- 返回逐模块已解析（未 flatten）的声明，供 M12 分离编译使用。
resolveProject parts =
  case parts of
    Project decls imports modules =>
      andThen (resolveEntry modules imports decls) (\entryDecls =>
        andThen (resolveModulesKeep modules) (\modules2 =>
          Ok (Pair entryDecls modules2)))

resolveModulesKeep Nil = Ok Nil

resolveModulesKeep (Cons (Module name pkg imports decls exports) rest) =
  andThen
    (resolveProgram (Cons (Module name pkg imports decls exports) rest) name name
       (topNames decls) (ctorsOf decls) (typeNamesOf decls) imports decls)
    (\d1 =>
      andThen (resolveModulesKeep rest) (\d2 =>
        Ok (Cons (Module name pkg imports d1 exports) d2)))

-- flatten：入口先解析，再按加载顺序解析各模块后拼接（与历史输出保持一致）。
loadProgram roots entryPkg entry =
  andThen (loadProject roots entryPkg entry) (\p =>
    andThen (resolveProject p) (\r =>
      Ok (append (firstOf r) (concatMap moduleDeclsOf (secondOf r)))))

-- 原始 --root DIR 模式：所有根同属空包名，不限制导出。
loadProgramRaw roots entry = loadProgram (map rawRoot roots) "" entry

tyShape ty =
  case ty of
    EVar n _ => "var " ++ n
    EApp f a _ => "app"
    EInt n _ => "int"
    EStr s _ => "str"
    ELam ps b _ => "lam"
    ELet bs b _ _ => "let"
    ECase s alts _ => "case"
    EIf c t e _ => "if"
    EDo stmts _ => "do"
