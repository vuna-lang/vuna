module Vuna.Parser (parseSource, parseExpressionSource) where

-- vuna 源码 parser：offside layout，返回 AST 与 imports。

import Vuna.Base
import Vuna.Ast
import Vuna.Lexer

data PState : Type where
  PState : String -> List PTok -> Pos -> PState

-- vuna 源码 parser（offside layout）
-- ---------------------------------------------------------------

posOf (PTok t p) = p

tokOf (PTok t p) = t

fileOf (PState file toks last) = file

-- 从起始状态 st 到结束状态 st2 的 span：起点=当前 token，终点=最后消费的 token。
spanOf st st2 = Span (fileOf st) (posLine (peekPos st)) (posCol (peekPos st)) (posLine (lastPos st2)) (posCol (lastPos st2))

peekTok (PState file toks last) =
  case toks of
    Cons t rest => t
    Nil => PTok TEof (Pos 1 1)

peekPos st = posOf (peekTok st)

lastPos (PState file toks last) = last

advance (PState file toks last) =
  case toks of
    Cons t rest =>
      case t of
        PTok TEof p => PState file toks last
        _ => PState file rest (posOf t)
    Nil => PState file toks last

isEof st =
  case peekTok st of
    PTok TEof p => True
    _ => False

-- 让下一个 token 视作「与上一 token 同一行」：do 语句块里新起一行的裸表达式
-- 需要这一点，否则首 token 会被 canContinue 判成缩进不足。
toksOf (PState file toks last) = toks

sameLineState st =
  case peekPos st of
    Pos line col => PState (fileOf st) (toksOf st) (Pos line 0)

atSym st s =
  case peekTok st of
    PTok (TSym x) p => x == s
    _ => False

atKw st k =
  case peekTok st of
    PTok (TKw x) p => x == k
    _ => False

canContinue st blockCol =
  case peekPos st of
    Pos line col =>
      case lastPos st of
        Pos lastLine lastCol => line == lastLine || col > blockCol

expectSym st s =
  case peekTok st of
    PTok (TSym x) p => if x == s then Ok (Pair 0 (advance st)) else Err ("expected " ++ s)
    _ => Err ("expected " ++ s)

expectKw st k =
  case peekTok st of
    PTok (TKw x) p => if x == k then Ok (Pair 0 (advance st)) else Err ("expected " ++ k)
    _ => Err ("expected " ++ k)

expectIdent st =
  case peekTok st of
    PTok (TIdent x) p => Ok (Pair x (advance st))
    _ => Err "expected identifier"

upperFirst s =
  case strUnpack s of
    Cons c rest => c >= 65 && c <= 90
    Nil => False

-- `_` 前缀私有构造器（如 `_C`）在模式里也要能当构造器用：`_` 开头的标识符
-- 若紧随大写字母，按构造器解析；单独的 `_` 仍是通配符，`_x` 仍是变量。
underscoreCtorName s =
  case strUnpack s of
    Cons c rest =>
      if c == 95 then
        case rest of
          Cons c2 rest2 => c2 >= 65 && c2 <= 90
          Nil => False
      else False
    Nil => False

ctorPatternStart name = upperFirst name || underscoreCtorName name

startsAtom st =
  case peekTok st of
    PTok (TIdent x) p => True
    PTok (TInt x) p => True
    PTok (TStr x) p => True
    PTok (TKw "Type") p => True
    PTok (TSym "(") p => True
    PTok (TSym "[") p => True
    _ => False

startsPatternAtom st =
  case peekTok st of
    PTok (TIdent x) p => True
    PTok (TInt x) p => True
    PTok (TStr x) p => True
    PTok (TSym "(") p => True
    PTok (TSym "[") p => True
    _ => False

infixInfo "->" = Just (Pair 1 1)
infixInfo "||" = Just (Pair 2 0)
infixInfo "&&" = Just (Pair 3 0)
infixInfo "==" = Just (Pair 4 0)
infixInfo "/=" = Just (Pair 4 0)
infixInfo "<" = Just (Pair 4 0)
infixInfo "<=" = Just (Pair 4 0)
infixInfo ">" = Just (Pair 4 0)
infixInfo ">=" = Just (Pair 4 0)
infixInfo "++" = Just (Pair 5 1)
infixInfo "+" = Just (Pair 6 0)
infixInfo "-" = Just (Pair 6 0)
infixInfo "*" = Just (Pair 7 0)
infixInfo "/" = Just (Pair 7 0)
infixInfo "::" = Just (Pair 8 1)
infixInfo ">>=" = Just (Pair 1 1)
infixInfo ">>" = Just (Pair 1 0)
infixInfo _ = Nothing

opExpr "::" sp = EVar "Cons" sp
opExpr ">>=" sp = EVar "bind" sp
opExpr op sp = EVar op sp

-- `>>` 是 do 的派生：`a >> b` = `bind a (\_ -> b)`。
mkInfixExpr ">>" lhs rhs sp =
  EApp (EVar "bind" sp) (Cons lhs (Cons (ELam (Cons "vuna_seq_ignore" Nil) rhs sp) Nil)) sp
mkInfixExpr op lhs rhs sp = EApp (opExpr op sp) (Cons lhs (Cons rhs Nil)) sp

countArrows e =
  case e of
    EApp (EVar "->" _) (Cons x (Cons rest Nil)) _ => 1 + countArrows rest
    _ => 0

terminatesExpression tok =
  case tok of
    PTok (TSym ")") p => True
    PTok (TSym "]") p => True
    PTok (TSym ",") p => True
    PTok (TKw "else") p => True
    PTok (TKw "in") p => True
    PTok (TKw "then") p => True
    _ => False

badCaseIndent st altCol =
  if isEof st then False
  else
    case peekPos st of
      Pos line col =>
        if col > altCol then
          case terminatesExpression (peekTok st) of
            True => False
            False => True
        else False

parseSource file source =
  andThen (lexSource source) (\toks =>
    andThen (parseSourceFile (PState file toks (Pos 1 0))) (\p => Ok (firstOf p)))

-- 单表达式解析（REPL / 工具用）：整段输入必须恰好是一个表达式。
parseExpressionSource : String -> Result Expr
parseExpressionSource source =
  andThen (lexSource source) (\toks =>
    step (parseExpr (PState "<expr>" toks (Pos 1 0)) 0 0) (\e, st =>
      if isEof st then Ok e else Err "expected end of expression"))

-- 可选模块头（M10）：`module M (导出项, ...) where`；列表省略 = 导出全部。
parseSourceFile st =
  step (parseModDecl st) (\hdr, st1 =>
    step (parseImports st1) (\imports, st2 =>
      if isEof st2 then Ok (Pair (Source hdr imports Nil) st2)
      else
        case peekPos st2 of
          Pos line col =>
            step (parseDecls st2 col) (\decls, st3 =>
              if isEof st3 then Ok (Pair (Source hdr imports decls) st3)
              else Err "expected end of input")))

parseModDecl st =
  if atKw st "module" then
    step (expectKw st "module") (\_, st1 =>
      step (expectIdent st1) (\name, st2 =>
        if atSym st2 "(" then
          step (parseExportItems st2) (\items, st3 =>
            step (expectKw st3 "where") (\_, st4 =>
              Ok (Pair (Just (ModDecl name True items (spanOf st st4))) st4)))
        else
          step (expectKw st2 "where") (\_, st3 =>
            Ok (Pair (Just (ModDecl name False Nil (spanOf st st3))) st3))))
  else Ok (Pair Nothing st)

parseExportItems st =
  step (expectSym st "(") (\_, st1 =>
    if atSym st1 ")" then Ok (Pair Nil (advance st1))
    else parseExportItemsFrom st1)

parseExportItemsFrom st =
  step (parseExportItem st) (\item, st1 =>
    if atSym st1 "," then
      step (parseExportItemsFrom (advance st1)) (\rest, st2 =>
        Ok (Pair (Cons item rest) st2))
    else
      step (expectSym st1 ")") (\_, st2 =>
        Ok (Pair (Cons item Nil) st2)))

parseExportItem st =
  case peekTok st of
    PTok (TKw "module") p =>
      step (expectKw st "module") (\_, st1 =>
        step (expectIdent st1) (\name, st2 =>
          Ok (Pair (XModule name (spanOf st st2)) st2)))
    PTok (TIdent name) p =>
      let st1 = advance st
      in if atSym st1 "(" then
           step (expectSym st1 "(") (\_, st2 =>
             step (expectSym st2 "..") (\_, st3 =>
               step (expectSym st3 ")") (\_, st4 =>
                 Ok (Pair (XTypeAll name (spanOf st st4)) st4))))
         else Ok (Pair (XBare name (spanOf st st1)) st1)
    _ => Err "expected an export item"

parseImportSpec st =
  step (expectKw st "import") (\_, st1 =>
    if atKw st1 "qualified" then
      step (expectKw st1 "qualified") (\_, st2 => parseImportAlias st2 True)
    else parseImportAlias st1 False)

parseImportAlias st isQualified =
  step (expectIdent st) (\name, st1 =>
    if atKw st1 "as" then
      step (expectKw st1 "as") (\_, st2 =>
        step (expectIdent st2) (\alias, st3 =>
          Ok (Pair (Import name isQualified (Just alias) (spanOf st st3)) st3)))
    else Ok (Pair (Import name isQualified Nothing (spanOf st st1)) st1))

parseImports st =
  if atKw st "import" then
    step (parseImportSpec st) (\imp, st1 =>
      step (parseImports st1) (\rest, st2 =>
        Ok (Pair (Cons imp rest) st2)))
  else Ok (Pair Nil st)

parseDecls st blockCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == blockCol then
          step (parseDecl st blockCol) (\decl, st1 =>
            step (parseDecls st1 blockCol) (\rest, st2 =>
              Ok (Pair (Cons decl rest) st2)))
        else Err ("expected a declaration at column " ++ strFromInt blockCol)

parseDecl st blockCol =
  case peekTok st of
    PTok (TKw "data") p => parseData st blockCol p
    PTok (TKw "record") p => parseRecord st blockCol p
    PTok (TKw "trait") p => parseTrait st blockCol p
    PTok (TKw "instance") p => parseInstance st blockCol p
    PTok (TIdent name) p =>
      let st1 = advance st
      in if atSym st1 ":" then parseSignature st1 blockCol name p
         else parseClause st1 blockCol name p
    _ => Err "expected a top-level declaration"

parseSignature st blockCol name namePos =
  step (expectSym st ":") (\_, st1 =>
    step (parseExpr st1 blockCol 0) (\ty, st2 =>
      Ok (Pair (DSig name ty (Span (fileOf st) (posLine namePos) (posCol namePos) (posLine (lastPos st2)) (posCol (lastPos st2)))) st2)))

parseClause st blockCol name namePos =
  step (parseClausePatterns st blockCol) (\pats, st1 =>
    step (expectSym st1 "=") (\_, st2 =>
      step (parseExpr st2 blockCol 0) (\body, st3 =>
        step (parseWhere st3 blockCol) (\wheres, st4 =>
          let body2 =
                case wheres of
                  Nil => body
                  Cons _ _ => ELet wheres body True (spanOf st st4)
          in Ok (Pair (DFun name pats body2 (Span (fileOf st) (posLine namePos) (posCol namePos) (posLine (lastPos st4)) (posCol (lastPos st4)))) st4)))))

-- where 块：`body where\n  <bindings>`，解析后 desugar 成 ELet（绑定对 body 可见）。
parseWhere st blockCol =
  case peekTok st of
    PTok (TKw "where") p =>
      if posCol p > blockCol then
        step (Ok (Pair 0 (advance st))) (\_, st1 =>
          step (parseWhereBindings st1 blockCol) (\binds, st2 =>
            Ok (Pair binds st2)))
      else Ok (Pair Nil st)
    _ => Ok (Pair Nil st)

parseWhereBindings st whereCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col > whereCol then parseWhereBindingsAt st col
        else Ok (Pair Nil st)

parseWhereBindingsAt st bindCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == bindCol then
          step (parseWhereBinding st bindCol) (\b, st1 =>
            step (parseWhereBindingsAt st1 bindCol) (\rest, st2 =>
              Ok (Pair (Cons b rest) st2)))
        else if col > bindCol then Err "unexpected indentation in where block"
        else Ok (Pair Nil st)

-- 单条 where 绑定：`pat = expr` 或函数子句 `name pats = expr`（desugar 成 λ）。
parseWhereBinding st bindCol =
  step (parsePatternSingle st bindCol) (\pat, st1 =>
    case pat of
      PVar name _ =>
        if startsPatternAtom st1 && canContinue st1 bindCol then
          step (parseClausePatterns st1 bindCol) (\pats, st2 =>
            step (expectSym st2 "=") (\_, st3 =>
              step (parseExpr st3 bindCol 0) (\value, st4 =>
                andThen (lamNames pats) (\names =>
                  Ok (Pair (Pair (PVar name (patSpan pat)) (ELam names value (spanOf st st4))) st4)))))
        else parseWhereValue st1 pat bindCol
      _ => parseWhereValue st1 pat bindCol)

parseWhereValue st pat blockCol =
  step (expectSym st "=") (\_, st1 =>
    step (parseExpr st1 blockCol 0) (\value, st2 =>
      Ok (Pair (Pair pat value) st2)))

-- λ 参数名：where 函数子句的参数必须是简单变量名。
lamNames Nil = Ok Nil
lamNames (Cons (PVar n _) rest) =
  case lamNames rest of
    Ok ns => Ok (Cons n ns)
    Err e => Err e
lamNames (Cons _ _) = Err "where function arguments must be simple names"

parseClausePatterns st blockCol =
  if startsPatternAtom st && canContinue st blockCol then
    step (parsePatternAtom st blockCol) (\pat, st1 =>
      step (parseClausePatterns st1 blockCol) (\rest, st2 =>
        Ok (Pair (Cons pat rest) st2)))
  else Ok (Pair Nil st)

parseData st blockCol kwPos =
  step (expectKw st "data") (\_, st1 =>
    step (expectIdent st1) (\name, st2 =>
      step (parseParams st2) (\params, st3 =>
        step (expectSym st3 ":") (\_, st4 =>
          step (parseExpr st4 blockCol 0) (\ty, st5 =>
            step (expectKw st5 "where") (\_, st6 =>
              step (parseCtors st6 blockCol) (\ctors, st7 =>
                step (parseDeriving st7) (\derivings, st8 =>
                  Ok (Pair (DData name params ctors derivings (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st8)) (posCol (lastPos st8)))) st8)))))))))

-- 记录声明（M10.5）：`record Name params where` + 缩进字段 `f : Ty`，可跟 deriving。
parseRecord st blockCol kwPos =
  step (expectKw st "record") (\_, st1 =>
    step (expectIdent st1) (\name, st2 =>
      step (parseParams st2) (\params, st3 =>
        step (expectKw st3 "where") (\_, st4 =>
          step (parseFields st4 blockCol) (\fields, st5 =>
            step (parseDeriving st5) (\derivings, st6 =>
              Ok (Pair (DRecord name params fields derivings (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st6)) (posCol (lastPos st6)))) st6)))))))

parseFields st blockCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col > blockCol then parseFieldList st col
        else Ok (Pair Nil st)

parseFieldList st fieldCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == fieldCol then
          step (expectIdent st) (\name, st1 =>
            step (expectSym st1 ":") (\_, st2 =>
              step (parseExpr st2 fieldCol 0) (\ty, st3 =>
                step (parseFieldList st3 fieldCol) (\rest, st4 =>
                  Ok (Pair (Cons (Field name ty (spanOf st st3)) rest) st4)))))
        else if col > fieldCol then Err "unexpected indentation in record block"
        else Ok (Pair Nil st)

-- deriving (TraitA, TraitB)；可出现在 data/record 的构造器/字段块之后。
parseDeriving st =
  if atKw st "deriving" then
    step (expectKw st "deriving") (\_, st1 =>
      step (expectSym st1 "(") (\_, st2 =>
        if atSym st2 ")" then Ok (Pair Nil (advance st2))
        else step (parseDerivingNames st2) (\names, st3 => Ok (Pair names st3))))
  else Ok (Pair Nil st)

parseDerivingNames st =
  step (expectIdent st) (\name, st1 =>
    if atSym st1 "," then
      step (parseDerivingNames (advance st1)) (\rest, st2 =>
        Ok (Pair (Cons name rest) st2))
    else
      step (expectSym st1 ")") (\_, st2 => Ok (Pair (Cons name Nil) st2)))

-- trait 声明（M10.5）：`trait Name params where` + 缩进方法签名 `m : Ty`。
parseTrait st blockCol kwPos =
  step (expectKw st "trait") (\_, st1 =>
    step (expectIdent st1) (\name, st2 =>
      step (parseParams st2) (\params, st3 =>
        step (expectKw st3 "where") (\_, st4 =>
          step (parseMethodSigs st4 blockCol) (\methods, st5 =>
            Ok (Pair (DTrait name params methods (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st5)) (posCol (lastPos st5)))) st5))))))

parseMethodSigs st blockCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col > blockCol then parseMethodSigList st col
        else Ok (Pair Nil st)

parseMethodSigList st methodCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == methodCol then
          step (expectIdent st) (\name, st1 =>
            step (expectSym st1 ":") (\_, st2 =>
              step (parseExpr st2 methodCol 0) (\ty, st3 =>
                step (parseMethodSigList st3 methodCol) (\rest, st4 =>
                  Ok (Pair (Cons (Pair name ty) rest) st4)))))
        else if col > methodCol then Err "unexpected indentation in trait block"
        else Ok (Pair Nil st)

-- instance 声明（M10.5）：`instance Head [as name] where` + 缩进方法定义。
parseInstance st blockCol kwPos =
  step (expectKw st "instance") (\_, st1 =>
    step (parseExpr st1 blockCol 0) (\head, st2 =>
      step (parseInstanceName st2) (\name, st3 =>
        step (expectKw st3 "where") (\_, st4 =>
          step (parseInstanceBody st4 blockCol) (\methods, st5 =>
            let isDefault = instanceIsDefault name
            in Ok (Pair (DInstance name isDefault head methods (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st5)) (posCol (lastPos st5)))) st5))))))

instanceIsDefault name =
  case name of
    Nothing => True
    Just _ => False

parseInstanceName st =
  if atKw st "as" then
    step (expectKw st "as") (\_, st1 =>
      step (expectIdent st1) (\name, st2 => Ok (Pair (Just name) st2)))
  else Ok (Pair Nothing st)

parseInstanceBody st blockCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col > blockCol then parseInstanceDeclList st col
        else Ok (Pair Nil st)

parseInstanceDeclList st declCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == declCol then
          step (parseInstanceDecl st declCol) (\decl, st1 =>
            step (parseInstanceDeclList st1 declCol) (\rest, st2 =>
              Ok (Pair (Cons decl rest) st2)))
        else if col > declCol then Err "unexpected indentation in instance block"
        else Ok (Pair Nil st)

parseInstanceDecl st blockCol =
  case peekTok st of
    PTok (TIdent name) p =>
      let st1 = advance st
      in if atSym st1 ":" then parseSignature st1 blockCol name p
         else parseClause st1 blockCol name p
    _ => Err "expected an instance method"

parseParams st =
  case peekTok st of
    PTok (TIdent name) p =>
      step (parseParams (advance st)) (\rest, st1 =>
        Ok (Pair (Cons name rest) st1))
    _ => Ok (Pair Nil st)

parseCtors st blockCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col > blockCol then parseCtorList st col
        else Ok (Pair Nil st)

parseCtorList st ctorCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == ctorCol then
          step (expectIdent st) (\name, st1 =>
            step (expectSym st1 ":") (\_, st2 =>
              step (parseExpr st2 ctorCol 0) (\ty, st3 =>
                step (parseCtorList st3 ctorCol) (\rest, st4 =>
                  Ok (Pair (Cons (Ctor name ty (countArrows ty) (spanOf st st4)) rest) st4)))))
        else if col > ctorCol then Err "unexpected indentation in data block"
        else Ok (Pair Nil st)

parseExpr st blockCol minPrec =
  if isEof st then Err "unexpected end of input"
  else if canContinue st blockCol then
    step (parseLhs st blockCol) (\lhs, st1 =>
      parseInfix st1 blockCol minPrec lhs)
  else Err "expression is not indented enough"

parseInfix st blockCol minPrec lhs =
  case peekTok st of
    PTok (TSym op) p =>
      case infixInfo op of
        Just (Pair prec assoc) =>
          if prec >= minPrec && canContinue st blockCol then
            let rhsPrec = if assoc == 0 then prec + 1 else prec
            in step (parseExpr (advance st) blockCol rhsPrec) (\rhs, st2 =>
                 parseInfix st2 blockCol minPrec (mkInfixExpr op lhs rhs (spanOf st st2)))
          else Ok (Pair lhs st)
        Nothing => Ok (Pair lhs st)
    _ => Ok (Pair lhs st)

parseLhs st blockCol =
  case peekTok st of
    PTok (TSym "\\") p => parseLambda st blockCol
    PTok (TKw "let") p => parseLet st blockCol
    PTok (TKw "case") p => parseCase st blockCol
    PTok (TKw "if") p => parseIf st blockCol
    PTok (TKw "do") p => parseDo st blockCol
    _ => parseApplication st blockCol

parseApplication st blockCol =
  step (parseAtom st blockCol) (\first, st1 =>
    step (parseInstanceSelector st1 blockCol first) (\first2, st2 =>
      step (parseArgs st2 blockCol) (\args, st3 =>
        case args of
          Nil => Ok (Pair first2 st3)
          _ => Ok (Pair (EApp first2 args (spanOf st st3)) st3))))

-- `method @instance`：显式命名实例选择（M10.5）。
parseInstanceSelector st blockCol first =
  if atSym st "@" then
    step (expectSym st "@") (\_, st1 =>
      step (expectIdent st1) (\name, st2 =>
        Ok (Pair (EInstSel first name (spanFromExpr first st2)) st2)))
  else Ok (Pair first st)

spanFromExpr e st2 =
  let sp = exprSpan e
  in Span (spanFile sp) (spanStartLine sp) (spanStartCol sp) (posLine (lastPos st2)) (posCol (lastPos st2))

parseArgs st blockCol =
  if startsAtom st && canContinue st blockCol then
    step (parseAtom st blockCol) (\arg, st1 =>
      step (parseArgs st1 blockCol) (\rest, st2 =>
        Ok (Pair (Cons arg rest) st2)))
  else Ok (Pair Nil st)

parseAtom st blockCol =
  step (parseAtomBase st blockCol) (\base, st1 => parseFieldSuffix st1 blockCol base)

-- 字段访问后缀：`e.f` / `(e).f`；`p.x` 因 lexer 合成单 token 由 loader 拆分。
parseFieldSuffix st blockCol base =
  if atSym st "." then
    step (expectSym st ".") (\_, st1 =>
      step (expectIdent st1) (\fname, st2 =>
        parseFieldSuffix st2 blockCol (EField base fname (spanFromExpr base st2))))
  else Ok (Pair base st)

parseAtomBase st blockCol =
  case peekTok st of
    PTok (TIdent name) p =>
      let st1 = advance st
      in if atSym st1 "{" then
           step (expectSym st1 "{") (\_, st1b =>
             step (parseRecordAssignments st1b blockCol) (\fields, st2 =>
               Ok (Pair (ERecord name fields (spanOf st st2)) st2)))
         else Ok (Pair (EVar name (spanOf st st1)) st1)
    PTok (TInt n) p => Ok (Pair (EInt n (spanOf st (advance st))) (advance st))
    PTok (TStr s) p => Ok (Pair (EStr s (spanOf st (advance st))) (advance st))
    PTok (TKw "Type") p => Ok (Pair (EVar "Type" (spanOf st (advance st))) (advance st))
    PTok (TSym "(") p =>
      step (parseExpr (advance st) blockCol 0) (\inner, st1 =>
        step (expectSym st1 ")") (\_, st2 => Ok (Pair inner st2)))
    PTok (TSym "[") p => parseListExpr st blockCol
    PTok (TSym "{") p =>
      step (expectSym st "{") (\_, st1 =>
        step (parseExpr st1 blockCol 0) (\base, st2 =>
          step (expectSym st2 "|") (\_, st3 =>
            step (parseRecordAssignments st3 blockCol) (\fields, st4 =>
              Ok (Pair (ERecUpdate base fields (spanOf st st4)) st4)))))
    _ => Err "expected expression"

-- `{ f = e, ... }`：构造与更新的公共字段列表（进入时已在 `{` 之后）。
parseRecordAssignments st blockCol =
  if atSym st "}" then Ok (Pair Nil (advance st))
  else step (parseRecordAssignList st blockCol) (\fs, st1 => Ok (Pair fs st1))

parseRecordAssignList st blockCol =
  step (expectIdent st) (\fname, st1 =>
    step (expectSym st1 "=") (\_, st2 =>
      step (parseExpr st2 blockCol 0) (\value, st3 =>
        if atSym st3 "," then
          step (parseRecordAssignList (advance st3) blockCol) (\rest, st4 =>
            Ok (Pair (Cons (Pair fname value) rest) st4))
        else
          step (expectSym st3 "}") (\_, st4 =>
            Ok (Pair (Cons (Pair fname value) Nil) st4)))))

parseListExpr st blockCol =
  step (expectSym st "[") (\_, st1 =>
    if atSym st1 "]" then Ok (Pair (EVar "Nil" (spanOf st (advance st1))) (advance st1))
    else
      step (parseListExprElems st1 blockCol) (\elems, st2 =>
        Ok (Pair (foldCons (spanOf st st2) elems) st2)))

parseListExprElems st blockCol =
  step (parseExpr st blockCol 0) (\e, st1 =>
    if atSym st1 "," then
      step (parseListExprElems (advance st1) blockCol) (\rest, st2 =>
        Ok (Pair (Cons e rest) st2))
    else if atSym st1 "]" then Ok (Pair (Cons e Nil) (advance st1))
    else Err "expected , or ]")

foldCons sp Nil = EVar "Nil" sp
foldCons sp (Cons e rest) = EApp (EVar "Cons" sp) (Cons e (Cons (foldCons sp rest) Nil)) sp

parseLambda st blockCol =
  step (expectSym st "\\") (\_, st1 =>
    step (expectIdent st1) (\first, st2 =>
      step (parseLambdaParams st2 (Cons first Nil)) (\params, st3 =>
        step (expectSym st3 "=>") (\_, st4 =>
          step (parseExpr st4 blockCol 0) (\body, st5 =>
            Ok (Pair (ELam params body (spanOf st st5)) st5))))))

parseLambdaParams st acc =
  if atSym st "," then
    step (expectIdent (advance st)) (\name, st1 =>
      parseLambdaParams st1 (append acc (Cons name Nil)))
  else Ok (Pair acc st)

parseLet st blockCol =
  step (expectKw st "let") (\_, st1 =>
    step (parseLetBindings st1 blockCol) (\binds, st2 =>
      step (expectKw st2 "in") (\_, st3 =>
        step (parseExpr st3 blockCol 0) (\body, st4 =>
          Ok (Pair (ELet binds body False (spanOf st st4)) st4)))))

parseLetBindings st blockCol =
  if isEof st then Err "expected a let binding"
  else if atKw st "in" then Err "expected a let binding"
  else
    case peekPos st of
      Pos line col =>
        if col <= blockCol then Err "let binding is not indented enough"
        else parseLetBindingsAt st col

parseLetBindingsAt st declCol =
  if isEof st then Ok (Pair Nil st)
  else if atKw st "in" then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == declCol then
          step (parsePatternSingle st declCol) (\pat, st1 =>
            step (expectSym st1 "=") (\_, st2 =>
              step (parseExpr st2 declCol 0) (\value, st3 =>
                step (parseLetBindingsAt st3 declCol) (\rest, st4 =>
                  Ok (Pair (Cons (Pair pat value) rest) st4)))))
        else Ok (Pair Nil st)

parseCase st blockCol =
  step (expectKw st "case") (\_, st1 =>
    step (parseExpr st1 blockCol 0) (\scrut, st2 =>
      step (expectKw st2 "of") (\_, st3 =>
        step (parseCaseAlts st3 blockCol) (\alts, st4 =>
          Ok (Pair (ECase scrut alts (spanOf st st4)) st4)))))

parseCaseAlts st blockCol =
  if isEof st then Err "case expression needs an alternative"
  else
    case peekPos st of
      Pos line col =>
        if col <= blockCol then Err "case alternative is not indented enough"
        else
          step (parseAltList st col) (\alts, st2 =>
            if badCaseIndent st2 col then Err "unexpected indentation after case alternative"
            else
              case alts of
                Nil => Err "case expression needs an alternative"
                _ => Ok (Pair alts st2))

parseAltList st altCol =
  if isEof st then Ok (Pair Nil st)
  else
    case peekPos st of
      Pos line col =>
        if col == altCol then
          step (parsePatternSingle st altCol) (\pat, st1 =>
            step (expectSym st1 "=>") (\_, st2 =>
              step (parseExpr st2 altCol 0) (\body, st3 =>
                step (parseAltList st3 altCol) (\rest, st4 =>
                  Ok (Pair (Cons (Pair pat body) rest) st4)))))
        else Ok (Pair Nil st)

parseIf st blockCol =
  step (expectKw st "if") (\_, st1 =>
    step (parseExpr st1 blockCol 0) (\cond, st2 =>
      step (expectKw st2 "then") (\_, st3 =>
        step (parseExpr st3 blockCol 0) (\yes, st4 =>
          step (expectKw st4 "else") (\_, st5 =>
            step (parseExpr st5 blockCol 0) (\no, st6 =>
              Ok (Pair (EIf cond yes no (spanOf st st6)) st6)))))))

-- do 块（M11）：`do` + 缩进对齐的语句，语句是 `pat <- expr` 或裸表达式；
-- 最后一条必须是裸表达式（do 本身不引入 pure，最后表达式即块结果）。
parseDo st blockCol =
  step (expectKw st "do") (\_, st1 =>
    if isEof st1 then Err "do block needs at least one statement"
    else
      case peekPos st1 of
        Pos line col =>
          if col <= blockCol then Err "do block statement is not indented enough"
          else
            step (parseDoStmts st1 col Nil) (\stmts, st2 =>
              case reverse stmts of
                Cons (DExpr lastExpr lastSp) rest =>
                  Ok (Pair (EDo stmts (spanOf st st2)) st2)
                _ => Err "do block must end with an expression"))

parseDoStmts st stmtCol acc =
  if isEof st then Ok (Pair (reverse acc) st)
  else
    case peekPos st of
      Pos line col =>
        if col < stmtCol then Ok (Pair (reverse acc) st)
        else if col > stmtCol then Err "unexpected indentation in do block"
        else
          step (parseDoStmt st stmtCol) (\stmt, st1 =>
            case peekPos st1 of
              Pos line2 col2 =>
                if isEof st1 then Ok (Pair (reverse (Cons stmt acc)) st1)
                else if col2 < stmtCol then Ok (Pair (reverse (Cons stmt acc)) st1)
                else if col2 > stmtCol then Err "unexpected indentation in do block"
                else parseDoStmts st1 stmtCol (Cons stmt acc))

parseDoStmt st stmtCol =
  case parsePatternSingle st stmtCol of
    Ok (Pair pat st1) =>
      if atSym st1 "<-" then
        step (expectSym st1 "<-") (\_, st2 =>
          step (parseExpr st2 stmtCol 0) (\e, st3 =>
            Ok (Pair (DBind pat e (spanOf st st3)) st3)))
      else parseDoExprStmt st stmtCol
    Err _ => parseDoExprStmt st stmtCol

parseDoExprStmt st stmtCol =
  step (parseExpr (sameLineState st) stmtCol 0) (\e, st1 =>
    Ok (Pair (DExpr e (spanOf st st1)) st1))

parsePatternSingle st blockCol = parsePatternCons st blockCol

parsePatternCons st blockCol =
  step (parsePatternHead st blockCol) (\lhs, st1 =>
    if atSym st1 "::" && canContinue st1 blockCol then
      step (parsePatternCons (advance st1) blockCol) (\rhs, st2 =>
        Ok (Pair (PCon "Cons" (Cons lhs (Cons rhs Nil)) (spanOf st st2)) st2))
    else Ok (Pair lhs st1))

parsePatternHead st blockCol =
  case peekTok st of
    PTok (TIdent name) p =>
      let st1 = advance st
      in if ctorPatternStart name && atSym st1 "{" then
           step (parseRecordPatternFields st1 blockCol) (\fields, st2 =>
             Ok (Pair (PRecord name fields (spanOf st st2)) st2))
         else if ctorPatternStart name then
           step (parsePatternAtoms st1 blockCol) (\args, st2 =>
             Ok (Pair (PCon name args (spanOf st st2)) st2))
         else parsePatternAtom st blockCol
    _ => parsePatternAtom st blockCol

parseRecordPatternFields st blockCol =
  step (expectSym st "{") (\_, st1 => parseRecordPatternList st1 blockCol)

parseRecordPatternList st blockCol =
  if atSym st "}" then Ok (Pair Nil (advance st))
  else
    step (parseRecordPatternField st blockCol) (\f, st1 =>
      if atSym st1 "," then
        step (parseRecordPatternList (advance st1) blockCol) (\rest, st2 =>
          Ok (Pair (Cons f rest) st2))
      else
        step (expectSym st1 "}") (\_, st2 => Ok (Pair (Cons f Nil) st2)))

parseRecordPatternField st blockCol =
  case peekTok st of
    PTok (TIdent fname) p =>
      let st1 = advance st
      in if atSym st1 "=" then
           step (expectSym st1 "=") (\_, st2 =>
             step (parsePatternSingle st2 blockCol) (\pat, st3 =>
               Ok (Pair (Pair fname pat) st3)))
         else
           Ok (Pair (Pair fname (PVar fname (Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p)))) st1)
    _ => Err "expected a record field pattern"

parsePatternAtoms st blockCol =
  if startsPatternAtom st && canContinue st blockCol then
    step (parsePatternAtom st blockCol) (\pat, st1 =>
      step (parsePatternAtoms st1 blockCol) (\rest, st2 =>
        Ok (Pair (Cons pat rest) st2)))
  else Ok (Pair Nil st)

parsePatternAtom st blockCol =
  case peekTok st of
    PTok (TIdent "_") p => Ok (Pair (PWild (spanOf st (advance st))) (advance st))
    PTok (TIdent name) p =>
      if ctorPatternStart name then Ok (Pair (PCon name Nil (spanOf st (advance st))) (advance st))
      else Ok (Pair (PVar name (spanOf st (advance st))) (advance st))
    PTok (TInt n) p => Ok (Pair (PInt n (spanOf st (advance st))) (advance st))
    PTok (TStr s) p => Ok (Pair (PStr s (spanOf st (advance st))) (advance st))
    PTok (TSym "(") p =>
      step (parsePatternSingle (advance st) blockCol) (\inner, st1 =>
        step (expectSym st1 ")") (\_, st2 => Ok (Pair inner st2)))
    PTok (TSym "[") p => parseListPattern st blockCol
    _ => Err "expected pattern"

parseListPattern st blockCol =
  step (expectSym st "[") (\_, st1 =>
    if atSym st1 "]" then Ok (Pair (PCon "Nil" Nil (spanOf st (advance st1))) (advance st1))
    else
      step (parseListPatternElems st1 blockCol) (\pats, st2 =>
        Ok (Pair (foldPCon (spanOf st st2) pats) st2)))

parseListPatternElems st blockCol =
  step (parsePatternSingle st blockCol) (\pat, st1 =>
    if atSym st1 "," then
      step (parseListPatternElems (advance st1) blockCol) (\rest, st2 =>
        Ok (Pair (Cons pat rest) st2))
    else if atSym st1 "]" then Ok (Pair (Cons pat Nil) (advance st1))
    else Err "expected , or ]")

foldPCon sp Nil = PCon "Nil" Nil sp
foldPCon sp (Cons p rest) = PCon "Cons" (Cons p (Cons (foldPCon sp rest) Nil)) sp
