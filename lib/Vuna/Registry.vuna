-- | 静态包索引：`index/<name>.toml` 的解析与版本解析（`vuna add` 的查询层）。
module Vuna.Registry
  ( RegistryEntry(..)
  , Release(..)
  , loadRegistryEntryEff
  , parseRegistryEntry
  , resolveRelease
  ) where

-- Vuna.Registry：**可选**的静态索引（D14）。它只是 `name [@version] → (源, hash)` 的
-- 便利层，不是身份真源：
--
--   index/<name>.toml
--     [package]
--     name = "greet"
--
--     [releases."1.2.0"]
--     git = "https://..."      # 或 url = "..."
--     rev = "<commit>"
--     hash = "sha256:<64hex>"
--
-- 索引放在任何地方：本地目录、`file://`、`http(s)://`（后者由宿主 `curl` 取一次）。
-- 索引不可信：写回 manifest 的永远是 `(源, hash)`，之后 fetch/check 只认摘要。
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Pkg
import Vuna.Compiler.Frontend.Manifest
import Vuna.Compiler.Frontend.Toml
import Vuna.Cli.Args
import Vuna.Compiler.Packages.Source
import Vuna.Compiler.Store
import Base.List
import Base.String

-- | 一条发布：人读版本号 + 不可变源 + 内容摘要。
record Release where
  relVersion : String
  relSource : DependencySource
  relHash : String

-- | 一个包的索引条目（发布顺序 = 文件里的顺序）。
record RegistryEntry where
  regName : String
  regReleases : List Release

-- | 取最后一个发布（无版本时的默认）。
lastRelease : List Release -> Maybe Release
lastRelease [] = Nothing
lastRelease ([x]) = Just x
lastRelease (_ :: rest) = lastRelease rest

-- | 按版本精确解析；`Nothing` 取索引里的最后一个发布。
resolveRelease : RegistryEntry -> Maybe String -> Maybe Release
resolveRelease entry Nothing = lastRelease entry.regReleases
resolveRelease entry (Just version) = findRelease version entry.regReleases

findRelease : String -> List Release -> Maybe Release
findRelease version [] = Nothing
findRelease version (r :: rest) =
  if r.relVersion == version then Just r else findRelease version rest

-- ---------------------------------------------------------------- 解析
stringEntry : String -> List String -> String -> List TomlEntry -> Check String
stringEntry path section key entries = case lookupEntry section key entries of
  Nothing => pkgPath1 path (IndexMalformed "missing ${key} in [${joinDots section}]") key
  Just (TStr s) => OkC s
  Just _ => pkgPath1 path (IndexMalformed "${key} must be a string") key

maybeStringEntry : String -> List String -> String -> List TomlEntry -> Maybe String
maybeStringEntry path section key entries = case lookupEntry section key entries of
  Just (TStr s) => Just s
  _ => Nothing

-- 一条发布：git（url + rev + hash）或 url（+ hash）。
buildRelease : String -> String -> List TomlEntry -> Check Release
buildRelease path version entries =
  let
    section = ["releases", version]
  in case maybeStringEntry path section "git" entries of
    Just url => case maybeStringEntry path section "rev" entries of
      Nothing => pkgPath1 path (IndexMalformed "release ${version}: git needs rev") version
      Just rev => case stringEntry path section "hash" entries of
        ErrC e => ErrC e
        OkC hash => OkC (Release version (DepGit url rev) (normalizeHash hash))
    Nothing => case maybeStringEntry path section "url" entries of
      Just url => case stringEntry path section "hash" entries of
        ErrC e => ErrC e
        OkC hash => OkC (Release version (DepUrl url) (normalizeHash hash))
      Nothing => pkgPath1 path (IndexMalformed "release ${version}: needs git or url") version

-- | 解析索引文件文本。
parseRegistryEntry : String -> String -> Check RegistryEntry
parseRegistryEntry path text = case parseTomlAt path text of
  ErrC e => ErrC e
  OkC entries => case stringEntry path ["package"] "name" entries of
    ErrC e => ErrC e
    OkC name => case buildReleases path (sectionsUnder ["releases"] entries) entries [] of
      ErrC e => ErrC e
      OkC releases => OkC (RegistryEntry name releases)

buildReleases : String -> List String -> List TomlEntry -> List Release -> Check (List Release)
buildReleases path [] entries acc = OkC (reverse acc)
buildReleases path (version :: rest) entries acc = case buildRelease path version entries of
  ErrC e => ErrC e
  OkC release => buildReleases path rest entries (release :: acc)

-- ---------------------------------------------------------------- 读取
stripIndexSlash : String -> String
stripIndexSlash s = if endsWith "/" s then substring 0 (natFromInt (strLength s - 1)) s else s

isHttpUrl : String -> Bool
isHttpUrl s = startsWith "http://" s || startsWith "https://" s

isFileUrl : String -> Bool
isFileUrl s = startsWith "file://" s

-- | 读索引条目：目录 / `file://` / `http(s)://`（后者经宿主 `curl` 落到临时文件）。
loadRegistryEntryEff : String -> String -> Eff [] (Check RegistryEntry)
loadRegistryEntryEff indexRoot name =
  let
    root = stripIndexSlash indexRoot
    fileName = "${name}.toml"
  in if isHttpUrl root then do
    base <- storeCacheBaseEff
    let
      tmp = "${base}/index-${name}.toml"
    in do
      _ <- ensureDirPath base
      code <- prim_eff_runIn base ["curl", "-fsSL", "${root}/${fileName}", "-o", tmp]
      if code /= 0 then pure (pkgNoLoc1 (IndexMalformed "cannot fetch ${root}/${fileName}") fileName)
      else do
        text <- prim_eff_readFile tmp
        pure (parseRegistryEntry tmp text)
  else
    let
      dir = if isFileUrl root then substring 7 (natFromInt (strLength root - 7)) root else root
      filePath = "${dir}/${fileName}"
    in do
      exists <- prim_eff_fileExists filePath
      if exists then do
        text <- prim_eff_readFile filePath
        pure (parseRegistryEntry filePath text)
      else pure (pkgNoLoc1 (IndexMalformed "index entry not found: ${filePath}") fileName)
