-- | vuna explain：按错误码查询目录条目（消息模板 + 说明）。
module Vuna.Explain (runExplain) where

-- Vuna.Explain：`vuna explain CODE` / `vuna explain --list`。
--
-- 数据源就是各域的枚举条目（`tcAll`/`cgAll`/`lexAll`/`psAll`/`ldAll`/`icAll`/`lintAll`），
-- 不再维护第二份错误码文档；字段与 `vuna gen-errors` 同源。
import Base.List
import Base.String
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Frontend.Diagnostics
import Vuna.Compiler.Loader.Diagnostics
import Vuna.Compiler.Diagnostics.Rn
import Vuna.Compiler.Diagnostics.Pkg
import Vuna.Compiler.Diagnostics.Warning
import Vuna.Lint.Diagnostics
import Base.IO.Host
import Vuna.Files

record Info where
  infoCode : String
  infoTemplate : String
  infoDesc : String

tcInfo : TcEntry -> Info
tcInfo e = Info e.tcEntryCode e.tcEntryTemplate e.tcEntryDesc

cgInfo : CgEntry -> Info
cgInfo e = Info e.cgEntryCode e.cgEntryTemplate e.cgEntryDesc

icInfo : IcEntry -> Info
icInfo e = Info e.icEntryCode e.icEntryTemplate e.icEntryDesc

lexInfo : LexEntry -> Info
lexInfo e = Info e.lexEntryCode e.lexEntryTemplate e.lexEntryDesc

psInfo : PsEntry -> Info
psInfo e = Info e.psEntryCode e.psEntryTemplate e.psEntryDesc

warnInfo : WarnEntry -> Info
warnInfo e = Info e.warnEntryCode e.warnEntryTemplate e.warnEntryDesc

pkgInfo : PkgEntry -> Info
pkgInfo e = Info e.pkgEntryCode e.pkgEntryTemplate e.pkgEntryDesc

rnInfo : RnEntry -> Info
rnInfo e = Info e.rnEntryCode e.rnEntryTemplate e.rnEntryDesc

ldInfo : LdEntry -> Info
ldInfo e = Info e.ldEntryCode e.ldEntryTemplate e.ldEntryDesc

lintInfo : LintEntry -> Info
lintInfo e = Info e.lintEntryCode e.lintEntryRule e.lintEntryDesc

allInfos : List Info
allInfos =
  append (map tcInfo tcAll)
    (append (map cgInfo cgAll) (append (map icInfo icAll) (append (map lexInfo lexAll) (append (map psInfo psAll) (append (map rnInfo rnAll) (append (map pkgInfo pkgAll) (append (map warnInfo warnAll) (append (map ldInfo ldAll) (map lintInfo lintAll)))))))))

findInfo : String -> List Info -> Maybe Info
findInfo code [] = Nothing
findInfo code (i :: rest) = if i.infoCode == code then Just i else findInfo code rest

matchesPrefix : String -> String -> Bool
matchesPrefix prefix code = startsWith prefix code

printInfo : Info -> Int
printInfo i =
  let
    _ = runIO (prim_print "${i.infoCode}\n")
    _ = runIO (prim_print "  message: ${i.infoTemplate}\n")
    _ = runIO (prim_print "  meaning: ${i.infoDesc}\n")
    _ = runIO (prim_print "  severity: ${diagSeverityOf (codeDomain i.infoCode)}\n")
    _ = runIO (prim_print "  phase: ${diagPhaseOf (codeDomain i.infoCode)}\n")
    _ = runIO (prim_print "  category: ${diagCategoryOf (codeDomain i.infoCode)}\n")
    _ = case exampleOf i.infoCode of
      Just p => runIO (prim_print "  example: ${p}\n")
      Nothing => 0
  in 0

listInfos : List Info -> String -> Int
listInfos [] prefix = 0
listInfos (i :: rest) prefix =
  let
    _ =
      if prefix == "" || matchesPrefix prefix i.infoCode then runIO (prim_print "${i.infoCode}  ${i.infoDesc}\n")
      else 0
  in listInfos rest prefix

explainArgs : List String -> Int
explainArgs args = case stripExplainJson args of
  Pair rest json => explainArgsJson rest json

explainArgsJson : List String -> Bool -> Int
explainArgsJson args json = case args of
  [] =>
    let
      _ = runIO (prim_print "usage: vuna explain <CODE> | vuna explain --list [PREFIX] [--json]\n")
    in 2
  "--list" :: rest => case rest of
    [] => if json then listInfosJson allInfos "" else listInfos allInfos ""
    prefix :: _ => if json then listInfosJson allInfos prefix else listInfos allInfos prefix
  code :: _ => case findInfo code allInfos of
    Nothing =>
      let
        _ =
          if json then runIO (prim_print "{\"error\":\"unknown diagnostic code\",\"code\":${jsonQuote code}}\n")
          else runIO
            (prim_print "error: unknown diagnostic code `${code}` (try `vuna explain --list`)\n")
      in 2
    Just i => if json then printInfoJson i else printInfo i

stripExplainJson : List String -> Pair (List String) Bool
stripExplainJson [] = Pair [] False
stripExplainJson ("--json" :: rest) = Pair (firstOf (stripExplainJson rest)) True
stripExplainJson (arg :: rest) =
  Pair (Base.List.Cons arg (firstOf (stripExplainJson rest))) (secondOf (stripExplainJson rest))

runExplain : List String -> Int
runExplain args = explainArgs args

-- 目录 example：在 test/corpus 下找第一个包含该码的结构化夹具（展示用，不参与门禁）。
exampleOf : String -> Maybe String
exampleOf code = case findDiagExample 512 "test/corpus" code of
  Just p => Just p
  Nothing => case findDiagExample 512 "corpus" code of
    Just p => Just p
    Nothing => findDiagExample 512 "../test/corpus" code

findDiagExample : Int -> String -> String -> Maybe String
findDiagExample fuel dir code =
  if fuel <= 0 then Nothing
  else if not (pathExistsDir dir) then Nothing
  else firstJustExamples (map (oneEntry (fuel - 1) dir code) (runIO (prim_readDir dir)))

oneEntry : Int -> String -> String -> String -> Maybe String
oneEntry fuel dir code name = if name == "." || name == ".." || name == ".git" || name == ".local" then Nothing
else
  let
    path = "${dir}/${name}"
  in if pathExistsDir path then findDiagExample fuel path code
  else if endsWith ".diag.json" name && pathExistsFile path then if contains "\"code\":\"${code}\"" (runIO (prim_readFile path)) then Just path else Nothing
  else Nothing

firstJustExamples : List (Maybe String) -> Maybe String
firstJustExamples [] = Nothing
firstJustExamples ((Just x) :: rest) = Just x
firstJustExamples (Nothing :: rest) = firstJustExamples rest

-- JSON 输出（`vuna explain --json` / `--list --json`）；本地转义，不依赖 Vuna.Json
-- （避免把 Explain 加进 Json 的依赖扇出）。
printInfoJson : Info -> Int
printInfoJson i =
  let
    _ = runIO (prim_print (infoJson i ++ "\n"))
  in 0

infoJson : Info -> String
infoJson i =
  "{"
    ++ join "," [field "code" (jsonQuote i.infoCode), field "message" (jsonQuote i.infoTemplate), field "meaning" (jsonQuote i.infoDesc), field "severity" (jsonQuote (diagSeverityOf (codeDomain i.infoCode))), field "phase" (jsonQuote (diagPhaseOf (codeDomain i.infoCode))), field "category" (jsonQuote (diagCategoryOf (codeDomain i.infoCode))), field "example" (maybeJsonString (exampleOf i.infoCode))]
    ++ "}"

field : String -> String -> String
field k v = "\"${k}\":${v}"

maybeJsonString : Maybe String -> String
maybeJsonString Nothing = "null"
maybeJsonString (Just s) = jsonQuote s

jsonQuote : String -> String
jsonQuote s = "\"" ++ join "" (map jsonEsc (strUnpack s)) ++ "\""

jsonEsc : Int -> String
jsonEsc 34 = "\\\""
jsonEsc 92 = "\\\\"
jsonEsc 10 = "\\n"
jsonEsc 13 = "\\r"
jsonEsc 9 = "\\t"
jsonEsc c = if c < 32 then "\\u00" ++ hexPair c else strPack [c]

hexPair : Int -> String
hexPair c = strPack [hexDigit (c / 16), hexDigit (c - c / 16 * 16)]

hexDigit : Int -> Int
hexDigit n = if n < 10 then 48 + n else 87 + n

listInfosJson : List Info -> String -> Int
listInfosJson infos prefix =
  let
    selected = filter (matchesInfoPrefix prefix) infos
    _ = runIO (prim_print ("{\"codes\":[" ++ join "," (map infoJson selected) ++ "]}\n"))
  in 0

matchesInfoPrefix : String -> Info -> Bool
matchesInfoPrefix prefix i = prefix == "" || matchesPrefix prefix i.infoCode
