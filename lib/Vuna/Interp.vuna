-- Vuna.Interp：对外 facade（解释器/编译器入口）。

import Vuna.Base
import Vuna.Parser
import Vuna.Loader
import Vuna.Eval
import Vuna.Codegen
import Vuna.Typecheck
import Vuna.TypedCodegen

interpret source =
  case parseSource source of
    Err e => "error: " ++ e
    Ok (Pair imports decls) =>
      case imports of
        Nil => runDecls decls
        _ => "error: imports are only supported by interpretFile"

effectiveRoots Nil = Cons "lib" Nil
effectiveRoots roots = roots

interpretFile roots entry =
  case loadProgram roots entry of
    Err e => "error: " ++ e
    Ok decls => runDecls decls

compileFile roots entry printResult =
  andThen (loadProgram roots entry) (\decls =>
    case decls of ds => generateProgram ds printResult)

compileFileChecked roots entry printResult =
  andThen (loadProgram roots entry) (\decls =>
    andThen (checkProgram decls) (\_ => generateProgram decls printResult))

compileFileTyped roots entry printResult =
  andThen (loadProgram roots entry) (\decls =>
    andThen (checkProgramInfoElab decls) (\p =>
      case p of
        Pair globals elabDecls => generateProgramTyped elabDecls globals printResult))
