module Vuna.Interp (interpretFile, interpretFileIn) where

-- Vuna.Interp：解释器 facade（工具链侧；编译入口见 Vuna.Compile）。
--
-- 该模块依赖 Vuna.Eval，只被 CLI / REPL / test runner 使用，不属于编译器 seed 闭包。

import Vuna.Base
import Vuna.Pkg
import Vuna.Ast
import Vuna.Parser
import Vuna.Loader
import Vuna.Eval
import Vuna.Typecheck
import Vuna.Compile

interpret source =
  case parseSource "<input>" source of
    Err e => "error: " ++ e
    Ok (Source hdr imports decls) =>
      case hdr of
        Just _ => "error: module header is not allowed in entry file"
        Nothing =>
          case imports of
            Nil => runDecls decls
            _ => "error: imports are only supported by interpretFile"

interpretFile roots entry = interpretFileIn "" roots entry

interpretFileIn entryPkg roots entry =
  case loadProgram roots entryPkg entry of
    Err e => "error: " ++ e
    Ok decls =>
      if programNeedsElab decls then
        case checkProgramInfoElab decls of
          Err e => "error: " ++ e
          Ok (Pair globals elabDecls) => runDecls elabDecls
      else runDecls decls
