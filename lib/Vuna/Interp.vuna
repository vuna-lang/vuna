-- Vuna.Interp：对外 facade（解释器/编译器入口）。

import Vuna.Base
import Vuna.Parser
import Vuna.Loader
import Vuna.Eval
import Vuna.Codegen
import Vuna.Typecheck
import Vuna.TypedCodegen

interpret source =
  case parseSource source of
    Err e => "error: " ++ e
    Ok p =>
      case p of
        Pair imports decls =>
          case imports of
            Nil => runDecls decls
            _ => "error: imports are only supported by interpretFile"

interpretFile root entry =
  case loadProgram root entry of
    Err e => "error: " ++ e
    Ok decls => runDecls decls

compileFile root entry printResult =
  andThen (loadProgram root entry) (\decls =>
    case decls of ds => generateProgram ds printResult)

demo = "main = 40 + 2"

main = interpret demo

compileFileChecked root entry printResult =
  andThen (loadProgram root entry) (\decls =>
    andThen (checkProgram decls) (\_ => generateProgram decls printResult))

compileFileTyped root entry printResult =
  andThen (loadProgram root entry) (\decls =>
    andThen (checkProgramInfo decls) (\globals =>
      generateProgramTyped decls globals printResult))
