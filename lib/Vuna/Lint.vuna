module Vuna.Lint (runLint) where

-- Vuna.Lint：vuna 源码风格检查与自动修复（首批规则）门面。
-- 规则扫描与语法层工具在 Vuna.Lint.Rules，编辑应用在 Vuna.Lint.Fix；
-- 本模块只保留 CLI（参数、打印、退出码）与 --fix 多轮循环。
-- M30：参数走 `Vuna.Cli.Args` 的统一入口（--fix 开关 + 位置参数，未知/重复 flag 可读
-- 错误），读盘先判存在/目录（`readText`），不再对不存在路径抛宿主异常。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Cli.Args
import Vuna.FixityEnv
import Vuna.Lint.Fix
import Vuna.Lint.Rules
import Base.Host

printFinding : String -> Bool -> Finding -> Eff [] Int
printFinding path fixMode f =
  let
    suffix = if fixMode then " (not auto-fixable)" else ""
    text =
      "${path}:${f.findingLine}:${f.findingCol}: [${f.findingCode}] ${f.findingRule}: ${f.findingMessage}${suffix}\n"
  in do
    _ <- prim_eff_print text
    pure 0

printFindings : String -> Bool -> List Finding -> Eff [] Int
printFindings path fixMode [] = pure 0
printFindings path fixMode (f :: rest) = do
  _ <- printFinding path fixMode f
  printFindings path fixMode rest

lintUsage : String
lintUsage = "usage: vuna lint [--fix] <file.vuna>...\n"

-- A05：零参顶层定义在模块初始化时求值；打印 usage 是动作，函数化（调用点传 0）。
lintUsageError : Int -> Eff [] Int
lintUsageError _ = do
  _ <- prim_eff_print lintUsage
  pure 2

reportFindings : String -> Bool -> List Finding -> Eff [] Int
reportFindings path fixMode findings = do
  _ <- printFindings path fixMode findings
  pure (if length findings == 0 then 0 else 1)

fixReport : String -> String -> List Finding -> List FixityDecl -> Eff [] Int
fixReport path source findings programFixities = case fixLoop programFixities source findings 8 0 of
  ErrC e => do
    _ <- prim_eff_print "${path}: error: ${diagText e}\n"
    pure 2
  OkC (Pair count newSource) => if count == 0 then reportFindings path True findings
  else do
    _ <- prim_eff_writeFile path newSource
    case lintSourceWith programFixities newSource of
      ErrC e => do
        _ <- prim_eff_print "${path}: error: ${diagText e}\n"
        pure 2
      OkC remaining => do
        _ <- prim_eff_print "${path}: fixed ${count} finding(s)\n"
        reportFindings path True remaining

lintExisting : Bool -> String -> String -> List FixityDecl -> Eff [] Int
lintExisting doFix path source programFixities = case lintSourceWith programFixities source of
  ErrC e => do
    _ <- prim_eff_print "${path}: error: ${diagText e}\n"
    pure 2
  OkC findings =>
    if doFix then fixReport path source findings programFixities
    else reportFindings path False findings

-- 逐文件取程序级 fixity（`Vuna.FixityEnv` 按目录缓存模块图）；拿不到上下文是工具错误，
-- 不静默按本地声明表继续（那会把 import 闭包里的运算符判成 unknown fixity）。
lintOne : Bool -> FixityEnv -> String -> Eff [] (Pair FixityEnv Int)
lintOne doFix env path = case readText path of
  ErrC e => do
    _ <- prim_eff_print "error: ${diagText e}\n"
    pure (Pair env 2)
  OkC source => do
    looked <- fixitiesForFile env path source
    let
      env2 = firstOf looked
    in case secondOf looked of
      ErrC e => do
        _ <- prim_eff_print "${path}: cannot load package fixity context: ${diagText e}\n"
        pure (Pair env2 2)
      OkC programFixities => do
        code <- lintExisting doFix path source programFixities
        pure (Pair env2 code)

lintFiles : Bool -> FixityEnv -> List String -> Eff [] Int
lintFiles doFix env [] = pure 0
lintFiles doFix env (path :: rest) = do
  stepped <- lintOne doFix env path
  restCode <- lintFiles doFix (firstOf stepped) rest
  pure (if secondOf stepped > restCode then secondOf stepped else restCode)

runLint : List String -> Eff [] Int
runLint args = case parseToolArgs "vuna lint" [BoolFlag "fix"] args of
  ErrC e => do
    _ <- prim_eff_print "error: ${diagText e}\n"
    pure 2
  OkC parsed => case parsed.positionals of
    [] => lintUsageError 0
    files => lintFiles (flagSet parsed "fix") emptyFixityEnv files
