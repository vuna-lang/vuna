-- | vuna 源码风格检查与自动修复（`vuna lint`）的 CLI 门面。
--
-- 本模块负责参数解析、目标展开、逐文件读盘、配置/抑制应用、输出与 `--fix` 循环；
-- 规则扫描与源码切片在 [Vuna.Lint.Rules]，配置在 [Vuna.Lint.Config]，抑制指令在
-- [Vuna.Lint.Suppress]，编辑应用在 [Vuna.Lint.Fix]，规则元数据在
-- [Vuna.Lint.Diagnostics]。
--
-- 退出码：0 表示没有达到失败阈值；1 表示有 error finding 或 warning 超过
-- `max-warnings`；2 表示用法错误、配置/读盘/解析/fixity 上下文错误。
module Vuna.Lint where

import Base.List
import Base.Maybe
import Base.String
import Base.EffFs
import Base.EffConsole
import Base.Eff.Types
import Base.EffEnv
import Base.EffProcess
import Base.EffStdin
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Hash
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Cli.Args
import Vuna.Files
import Vuna.FixityEnv
import Vuna.Json
import Vuna.Lint.Cache
import Vuna.Lint.Config
import Vuna.Lint.Diagnostics
import Vuna.Lint.Fix
import Vuna.Lint.Rules

-- ---------------------------------------------------------------
-- 输出格式
-- ---------------------------------------------------------------
-- | CLI 输出格式。
data LintFormat : Type where
  -- | 现有 `路径:行:列: [CODE] rule: message` 文本。
  LintText : LintFormat
  -- | 稳定 JSON（CI/编辑器消费）。
  LintJson : LintFormat
  -- | GitHub Actions 注解。
  LintGithub : LintFormat
  -- | SARIF 2.1.0（CI 代码扫描）。
  LintSarif : LintFormat

-- | 内部：是否 JSON 输出（避免为格式枚举引入 Eq）。
isJsonFormat : LintFormat -> Bool
isJsonFormat LintJson = True
isJsonFormat _ = False

-- | 一次 CLI 运行的选项。
record LintOpts where
  lintOptFix : Bool
  lintOptDry : Bool
  lintOptQuiet : Bool
  lintOptFormat : LintFormat
  lintOptMaxPasses : Int
  lintOptNoConfig : Bool
  lintOptConfigPath : Maybe String
  lintOptSelect : List String
  lintOptIgnore : List String
  lintOptMaxWarnings : Maybe Int
  lintOptNoCache : Bool
  lintOptDiff : Bool

defaultLintOpts : LintOpts
defaultLintOpts = LintOpts False False False LintText 8 False Nothing [] [] Nothing False False

-- | 单个文件的结果。
record FileOutcome where
  fileOutcomePath : String
  fileOutcomeFindings : List Finding
  fileOutcomeFixed : Int
  fileOutcomeError : Maybe String

-- ---------------------------------------------------------------
-- finding 渲染 / 打印
-- ---------------------------------------------------------------
-- | 把一条 finding 渲染成 `path:line:col: [code] rule: message`；`fixMode` 为真时追加
-- `(not auto-fixable)` 标记。CLI 打印与测试断言共用这一份格式。
export renderFinding : String -> Bool -> Finding -> String
renderFinding path fixMode f =
  let
    suffix = if fixMode then " (not auto-fixable)" else ""
  in "${path}:${f.findingLine}:${f.findingCol}: [${f.findingCode}] ${f.findingRule}: ${f.findingMessage}${suffix}"

-- | `--fix` 的「已修复 N 条」报告行：`path: fixed N finding(s)`。
-- | `--fix --dry-run` 的「将修复 N 条」报告行。
renderDryFixReport : String -> Int -> String
renderDryFixReport path count = "${path}: would fix ${count} finding(s)"

export renderFixReport : String -> Int -> String
renderFixReport path count = "${path}: fixed ${count} finding(s)"

-- | 内部：打印一条 finding（带换行），返回 0。
printFinding : Member nConsole ConsoleOp r => String -> Bool -> Finding -> Eff r Int
printFinding path fixMode f = do
  _ <- consolePrint "${renderFinding path fixMode f}\n"
  pure 0

-- | 内部：按顺序打印全部 finding，返回 0。
printFindings : Member nConsole ConsoleOp r => String -> Bool -> List Finding -> Eff r Int
printFindings path fixMode [] = pure 0
printFindings path fixMode (f :: rest) = do
  _ <- printFinding path fixMode f
  printFindings path fixMode rest

-- | 内部：打印 findings（兼容测试侧入口；不改变文本格式）。
export reportFindings : Member nConsole ConsoleOp r => String -> Bool -> List Finding -> Eff r Int
reportFindings path fixMode findings = do
  _ <- printFindings path fixMode findings
  pure 0

-- ---------------------------------------------------------------
-- 计数 / 严重度
-- ---------------------------------------------------------------
-- | 内部：FileOutcome 字段投影（避免裸 lambda 里依赖字段推断）。
fileFindings : FileOutcome -> List Finding
fileFindings o = o.fileOutcomeFindings

fileFixed : FileOutcome -> Int
fileFixed o = o.fileOutcomeFixed

fileError : FileOutcome -> Maybe String
fileError o = o.fileOutcomeError

-- | 内部：统计某个严重度的 finding 数。
countSeverity : LintSeverity -> List Finding -> Int
countSeverity sev [] = 0
countSeverity sev (f :: rest) = (if f.findingSeverity == sev then 1 else 0) + countSeverity sev rest

-- | 内部：全部 finding 的计数。
countErrors : List FileOutcome -> Int
countErrors outcomes = foldl (\n, o => n + countSeverity LintError (fileFindings o)) 0 outcomes

countWarnings : List FileOutcome -> Int
countWarnings outcomes = foldl (\n, o => n + countSeverity LintWarn (fileFindings o)) 0 outcomes

countFindings : List FileOutcome -> Int
countFindings outcomes = foldl (\n, o => n + length (fileFindings o)) 0 outcomes

countFixed : List FileOutcome -> Int
countFixed outcomes = foldl (\n, o => n + fileFixed o) 0 outcomes

-- | 内部：finding 是否可自动修复。
isFixable : Finding -> Bool
isFixable f = isJust f.findingEdit

-- | 内部：某条 finding 是否应该打印（quiet 只隐藏 warning）。
visibleFinding : Bool -> Finding -> Bool
visibleFinding True f = f.findingSeverity == LintError
visibleFinding False f = True

-- ---------------------------------------------------------------
-- 目标展开
-- ---------------------------------------------------------------
-- | 内部：展开一个位置参数：目录递归收集 `.vuna`，文件原样保留。
expandLintPath : Member nFs FsOp r => String -> Eff r (List String)
expandLintPath path = do
  isDir <- pathExistsDir path
  if isDir then collectVunaFiles path else pure [path]

-- | 内部：按用户顺序展开路径。
expandLintPaths : Member nFs FsOp r => List String -> Eff r (List String)
expandLintPaths [] = pure []
expandLintPaths (path :: rest) = do
  here <- expandLintPath path
  there <- expandLintPaths rest
  pure (append here there)

-- | 内部：去重并保持首次出现顺序。
dedupePaths : List String -> List String
dedupePaths [] = []
dedupePaths (path :: rest) =
  if memName path rest then dedupePaths rest else path :: dedupePaths rest

-- | 内部：包的源码目标（默认不扫 test，避免把故意不干净的夹具当门禁）。
packageLintTargets : Package -> List String
packageLintTargets pkg = ["${packageDir pkg}/lib", "${packageDir pkg}/app"]

-- | 内部：workspace 默认目标：各包的 lib/app 中真实存在的目录。
defaultLintTargets : Member nFs FsOp r, Member nEnv EnvOp r => Eff r (Check (List String))
defaultLintTargets = do
  found <- findManifestDirMaybe "."
  case found of
    Nothing => pure (err "not inside a vuna workspace (no vuna.toml found); pass PATH explicitly")
    Just dir => do
      pkgsR <- workspacePackages dir
      case pkgsR of
        ErrC e => pure (ErrC e)
        OkC pkgs => do
          targets <- existingDirs (concatMap packageLintTargets pkgs) []
          files <- expandLintPaths targets
          pure (OkC (dedupePaths files))

-- | 内部：保留真实存在的目录。
existingDirs : Member nFs FsOp r => List String -> List String -> Eff r (List String)
existingDirs [] acc = pure (reverse acc)
existingDirs (path :: rest) acc = do
  exists <- pathExistsDir path
  if exists then existingDirs rest (path :: acc) else existingDirs rest acc

-- ---------------------------------------------------------------
-- 配置
-- ---------------------------------------------------------------
-- | 内部：配置的来源（显式文件 / 默认 / 就近 manifest）。
configForFile : Member nFs FsOp r => LintOpts -> String -> Eff r (Check LintConfig)
configForFile opts path = case opts.lintOptConfigPath of
  Just p => loadLintConfigAt p
  Nothing =>
    if opts.lintOptNoConfig then pure (OkC defaultLintConfig) else loadLintConfigForFile path

-- | 内部：命令行覆盖（select / ignore / max-warnings）。
applyOpts : LintOpts -> LintConfig -> Check LintConfig
applyOpts opts cfg =
  let
    selected =
      if length opts.lintOptSelect == 0 then OkC cfg else selectRules opts.lintOptSelect cfg
  in case selected of
    ErrC e => ErrC e
    OkC cfg1 =>
      let
        ignored =
          if length opts.lintOptIgnore == 0 then OkC cfg1 else ignoreRules opts.lintOptIgnore cfg1
      in case ignored of
        ErrC e => ErrC e
        OkC cfg2 => OkC (case opts.lintOptMaxWarnings of
          Just n => withMaxWarnings n cfg2
          Nothing => cfg2
        )

-- | 内部：读完整 stdin（分块，最多 64 MiB 量级）。
readStdinAll : Member nStdin StdinOp r => Eff r String
readStdinAll = readStdinGo 1024 []

readStdinGo : Member nStdin StdinOp r => Int -> List String -> Eff r String
readStdinGo fuel acc = if fuel <= 0 then pure (join "" (reverse acc))
else do
  chunk <- stdinReadBytes 65536
  case chunk of
    Nothing => pure (join "" (reverse acc))
    Just s => if s == "" then pure (join "" (reverse acc)) else readStdinGo (fuel - 1) (s :: acc)

-- ---------------------------------------------------------------
-- 单文件
-- ---------------------------------------------------------------
-- | 内部：对一份已知源码做 lint（配置/fixity 上下文按 configPath 解析）。
lintText : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => LintOpts -> FixityEnv -> String -> String -> String -> Eff r (Pair FixityEnv FileOutcome)
lintText opts env displayPath configPath source = do
  cfgR <- configForFile opts configPath
  case cfgR of
    ErrC e => pure (Pair env (FileOutcome displayPath [] 0 (Just (diagText e))))
    OkC cfg0 => case applyOpts opts cfg0 of
      ErrC e => pure (Pair env (FileOutcome displayPath [] 0 (Just (diagText e))))
      OkC cfg => if lintExcluded displayPath cfg then pure (Pair env (FileOutcome displayPath [] 0 Nothing))
      else do
        looked <- fixitiesForFile env configPath source
        env2 <- pure (firstOf looked)
        case secondOf looked of
          ErrC e => pure (Pair env2 (FileOutcome displayPath [] 0 (Just (diagText e))))
          OkC programFixities => do
            linted <-
              if opts.lintOptFix || opts.lintOptNoCache then pure (lintSourceWithConfig cfg programFixities source)
              else lintSourceWithCache cfg programFixities source
            case linted of
              ErrC e => pure (Pair env2 (FileOutcome displayPath [] 0 (Just (diagText e))))
              OkC findings => do
                fixedR <-
                  if opts.lintOptFix then fixFileWith opts cfg displayPath programFixities source findings
                  else pure (OkC (Pair findings 0))
                pure (case fixedR of
                  ErrC e => Pair env2 (FileOutcome displayPath [] 0 (Just (diagText e)))
                  OkC (Pair remaining fixed) =>
                    Pair env2 (FileOutcome displayPath remaining fixed Nothing)
                )

-- | 内部：lint 单个目标（文件或 `-` stdin），错误也作为结果。
lintOne : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nStdin StdinOp r => LintOpts -> FixityEnv -> String -> Eff r (Pair FixityEnv FileOutcome)
lintOne opts env path = if path == "-" then if opts.lintOptFix then pure (Pair env (FileOutcome "<stdin>" [] 0 (Just "--fix does not support stdin")))
else do
  source <- readStdinAll
  lintText opts env "<stdin>" "stdin.vuna" source
else do
  textR <- readText path
  case textR of
    ErrC e => pure (Pair env (FileOutcome path [] 0 (Just (diagText e))))
    OkC source => lintText opts env path path source

-- | 内部：打印 `--diff`（外部 `diff -u`；只用于人读，不影响退出码）。
printDiff : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> String -> Eff r Int
printDiff path oldSource newSource = do
  tmp0 <- envGetEnv "TMPDIR"
  tmp <- pure (if tmp0 == "" then "/tmp" else tmp0)
  base <- pure "${tmp}/vuna-lint-diff-${contentAddress path}"
  oldPath <- pure "${base}.old"
  newPath <- pure "${base}.new"
  outPath <- pure "${base}.out"
  cmd <- pure "diff -u '${oldPath}' '${newPath}' > '${outPath}' || true"
  _ <- fsWriteFile oldPath oldSource
  _ <- fsWriteFile newPath newSource
  _ <- processRunIn "." ["sh", "-c", cmd]
  exists <- fsFileExists outPath
  text <- if exists then fsReadFile outPath else pure ""
  msg <- pure (if text == "" then "" else "${text}\n")
  _ <- consolePrint msg
  _ <- fsRemoveFile oldPath
  _ <- fsRemoveFile newPath
  _ <- if exists then fsRemoveFile outPath else pure 0
  pure 0

-- | 内部：fix 单文件（把 dry-run / 原子写 / 重新 lint 聚在一处）。
fixFileWith : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => LintOpts -> LintConfig -> String -> List FixityDecl -> String -> List Finding -> Eff r (Check (Pair (List Finding) Int))
fixFileWith opts cfg path programFixities source findings = case fixLoop cfg programFixities source findings opts.lintOptMaxPasses 0 of
  ErrC e => pure (ErrC e)
  OkC (Pair count newSource) => if count == 0 then pure (OkC (Pair findings 0))
  else if opts.lintOptDiff then do
    _ <- printDiff path source newSource
    pure (OkC (Pair findings count))
  else if opts.lintOptDry then pure (OkC (Pair findings count))
  else do
    _ <- fsWriteFileAtomic path newSource
    pure (case lintSourceWithConfig cfg programFixities newSource of
      ErrC e => ErrC e
      OkC remaining => OkC (Pair remaining count)
    )

-- ---------------------------------------------------------------
-- 多文件 / 输出
-- ---------------------------------------------------------------
-- | 内部：逐文件 lint，返回全部结果（错误文件也保留）。
lintFiles : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nStdin StdinOp r => LintOpts -> FixityEnv -> List String -> List FileOutcome -> Eff r (Pair FixityEnv (List FileOutcome))
lintFiles opts env [] acc = pure (Pair env (reverse acc))
lintFiles opts env (path :: rest) acc = do
  stepped <- lintOne opts env path
  lintFiles opts (firstOf stepped) rest (secondOf stepped :: acc)

-- | 内部：文本/注解输出。
printOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printOutcomes opts outcomes = case opts.lintOptFormat of
  LintText => printTextOutcomes opts outcomes
  LintGithub => printGithubOutcomes opts outcomes
  LintJson => pure 0
  LintSarif => pure 0

printTextOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printTextOutcomes opts [] = pure 0
printTextOutcomes opts (o :: rest) = case o.fileOutcomeError of
  Just msg => do
    _ <- consoleEprint "${o.fileOutcomePath}: error: ${msg}\n"
    printTextOutcomes opts rest
  Nothing => do
    _ <-
      if o.fileOutcomeFixed > 0 then fmap natToInt
        (consolePrint "${if opts.lintOptDry then renderDryFixReport o.fileOutcomePath o.fileOutcomeFixed else renderFixReport o.fileOutcomePath o.fileOutcomeFixed}\n")
      else pure 0
    _ <-
      printFindings o.fileOutcomePath (opts.lintOptFix && not opts.lintOptDry)
        (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)
    printTextOutcomes opts rest

printGithubOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printGithubOutcomes opts [] = pure 0
printGithubOutcomes opts (o :: rest) = case o.fileOutcomeError of
  Just msg => do
    _ <- consoleEprint "${o.fileOutcomePath}: error: ${msg}\n"
    printGithubOutcomes opts rest
  Nothing => do
    _ <-
      printGithubFindings o.fileOutcomePath
        (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)
    printGithubOutcomes opts rest

printGithubFindings : Member nConsole ConsoleOp r => String -> List Finding -> Eff r Int
printGithubFindings path [] = pure 0
printGithubFindings path (f :: rest) =
  let
    level = if f.findingSeverity == LintError then "error" else "warning"
    msg =
      "::${level} file=${path},line=${f.findingLine},col=${f.findingCol},endLine=${f.findingEndLine},endColumn=${f.findingEndCol},title=${f.findingCode}::${f.findingRule}: ${f.findingMessage}"
  in do
    _ <- consolePrint "${msg}\n"
    printGithubFindings path rest

-- | 内部：JSON 输出（stdout 只输出一个 JSON 对象）。
printJsonOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printJsonOutcomes opts outcomes = do
  _ <- consolePrint "${renderJson (outcomeJson opts outcomes)}\n"
  pure 0

-- | 内部：SARIF 2.1.0 输出。
printSarifOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printSarifOutcomes opts outcomes = do
  _ <- consolePrint "${renderJson (sarifJson opts outcomes)}\n"
  pure 0

-- | 内部：SARIF 文档。
sarifJson : LintOpts -> List FileOutcome -> Json
sarifJson opts outcomes =
  JObj
    [Pair "version" (JStr "2.1.0"), Pair "$schema" (JStr "https://json.schemastore.org/sarif-2.1.0.json"), Pair "runs" (JArr [JObj [Pair "tool" (JObj [Pair "driver" (JObj [Pair "name" (JStr "vuna-lint"), Pair "rules" (JArr (map sarifRule lintAll))])]), Pair "results" (JArr (concatMap (sarifResults opts) outcomes))]])]

sarifRule : LintEntry -> Json
sarifRule e =
  JObj
    [Pair "id" (JStr e.lintEntryCode), Pair "name" (JStr e.lintEntryRule), Pair "shortDescription" (JObj [Pair "text" (JStr e.lintEntryDesc)]), Pair "properties" (JObj [Pair "fixable" (JBool e.lintEntryFixable)])]

sarifResults : LintOpts -> FileOutcome -> List Json
sarifResults opts o =
  map (sarifFinding o.fileOutcomePath)
    (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)

sarifFinding : String -> Finding -> Json
sarifFinding path f =
  JObj
    [Pair "ruleId" (JStr f.findingCode), Pair "level" (JStr (if f.findingSeverity == LintError then "error" else "warning")), Pair "message" (JObj [Pair "text" (JStr "${f.findingRule}: ${f.findingMessage}")]), Pair "locations" (JArr [JObj [Pair "physicalLocation" (JObj [Pair "artifactLocation" (JObj [Pair "uri" (JStr path)]), Pair "region" (JObj [Pair "startLine" (JNum f.findingLine), Pair "startColumn" (JNum f.findingCol), Pair "endLine" (JNum f.findingEndLine), Pair "endColumn" (JNum f.findingEndCol)])])]])]

-- | 内部：JSON 对象。
outcomeJson : LintOpts -> List FileOutcome -> Json
outcomeJson opts outcomes =
  JObj
    [Pair "version" (JNum 1), Pair "findings" (JArr (concatMap (outcomeFindingsJson opts) outcomes)), Pair "errors" (JArr (mapMaybe outcomeErrorJson outcomes)), Pair "summary" (JObj [Pair "files" (JNum (length outcomes)), Pair "errors" (JNum (countErrors outcomes)), Pair "warnings" (JNum (countWarnings outcomes)), Pair "fixable" (JNum (countFixable outcomes)), Pair "fixed" (JNum (countFixed outcomes))])]

outcomeFindingsJson : LintOpts -> FileOutcome -> List Json
outcomeFindingsJson opts o =
  map (findingJson o.fileOutcomePath)
    (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)

outcomeErrorJson : FileOutcome -> Maybe Json
outcomeErrorJson o = case o.fileOutcomeError of
  Nothing => Nothing
  Just msg => Just (JObj [Pair "path" (JStr o.fileOutcomePath), Pair "message" (JStr msg)])

findingJson : String -> Finding -> Json
findingJson path f =
  JObj
    [Pair "path" (JStr path), Pair "line" (JNum f.findingLine), Pair "column" (JNum f.findingCol), Pair "endLine" (JNum f.findingEndLine), Pair "endColumn" (JNum f.findingEndCol), Pair "code" (JStr f.findingCode), Pair "rule" (JStr f.findingRule), Pair "severity" (JStr (if f.findingSeverity == LintError then "error" else "warning")), Pair "message" (JStr f.findingMessage), Pair "fixable" (JBool (isJust f.findingEdit))]

-- | 内部：可修复 finding 数。
countFixable : List FileOutcome -> Int
countFixable outcomes = foldl (\n, o => n + length (filter isFixable (fileFindings o))) 0 outcomes

-- | 内部：退出码：工具错误 2 > error/超限 warning 1 > 0。
outcomeCode : LintOpts -> LintConfig -> List FileOutcome -> Int
outcomeCode opts cfg outcomes =
  if anyError outcomes then 2
  else if countErrors outcomes > 0 then 1
  else if opts.lintOptMaxWarnings /= Nothing then warningLimitCode opts outcomes
  else if lintMaxWarnings cfg >= 0 && countWarnings outcomes > lintMaxWarnings cfg then 1 else 0

warningLimitCode : LintOpts -> List FileOutcome -> Int
warningLimitCode opts outcomes = case opts.lintOptMaxWarnings of
  Just n => if n < 0 then 0 else if countWarnings outcomes > n then 1 else 0
  Nothing => 0

anyError : List FileOutcome -> Bool
anyError outcomes = length (filter (\o => fileError o /= Nothing) outcomes) > 0

-- | 内部：输出全部结果并给出退出码。
finishLint : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => LintOpts -> List FileOutcome -> Eff r Int
finishLint opts outcomes = do
  _ <- case opts.lintOptFormat of
    LintJson => printJsonOutcomes opts outcomes
    LintSarif => printSarifOutcomes opts outcomes
    _ => printOutcomes opts outcomes
  case outcomes of
    [] => pure 0
    o :: _ => do
      cfgR <- configForFile opts o.fileOutcomePath
      case cfgR of
        ErrC _ => pure (if anyError outcomes then 2 else 1)
        OkC cfg0 => case applyOpts opts cfg0 of
          ErrC _ =>
            pure (if anyError outcomes then 2 else if countErrors outcomes > 0 then 1 else 0)
          OkC cfg => pure (outcomeCode opts cfg outcomes)

-- ---------------------------------------------------------------
-- 规则信息
-- ---------------------------------------------------------------
-- | 内部：打印规则清单。
printRuleList : Member nConsole ConsoleOp r => Eff r Int
printRuleList = printRules lintAll

printRules : Member nConsole ConsoleOp r => List LintEntry -> Eff r Int
printRules [] = pure 0
printRules (e :: rest) = do
  _ <- consolePrint "${e.lintEntryCode}  ${e.lintEntryRule}  ${e.lintEntryDesc}\n"
  printRules rest

-- | 内部：打印单条规则的详细信息。
printRuleExplain : Member nConsole ConsoleOp r => String -> Eff r Int
printRuleExplain name = case lintRuleOfName name of
  Nothing => do
    _ <- consoleEprint "error: unknown lint rule: ${name}\n"
    pure 2
  Just rule => do
    _ <- consolePrint "${lintCode rule}\n"
    _ <- consolePrint "  rule: ${lintRule rule}\n"
    _ <- consolePrint "  description: ${lintDesc rule}\n"
    _ <- consolePrint "  fixable: ${if lintFixable rule then "yes" else "no"}\n"
    _ <- consolePrint "  edit: ${lintEdit rule}\n"
    pure 0

-- ---------------------------------------------------------------
-- 参数
-- ---------------------------------------------------------------
-- | 内部：`vuna lint` 的用法文本。
lintUsage : String
lintUsage = """usage: vuna lint [OPTIONS] [PATH]...
  PATH 可为文件或目录；省略时扫 workspace 各包的 lib/ 与 app/
  --fix                 应用可自动修复的 finding（原子写）
  --dry-run             与 --fix 同用：只报告会修复多少条，不写盘
  --diff                与 --fix 同用：打印 unified diff，不写盘
  --format FORMAT       text（默认）| json | github | sarif
  --max-warnings N      warning 超过 N 条时 exit 1（-1 = 不限）
  --quiet               只打印 error finding
  --select RULE         只启用给定规则（可重复）
  --ignore RULE         关闭给定规则（可重复）
  --config PATH         使用显式 vuna.toml 的 [lint]
  --no-config           不读 vuna.toml，使用默认配置
  --no-cache            不读/写 lint 结果缓存
  --max-passes N        --fix 最多迭代 N 轮（默认 8）
  --list                列出规则
  --explain RULE        解释单条规则
"""

lintUsageError : Member nConsole ConsoleOp r => Int -> Eff r Int
lintUsageError _ = do
  _ <- consoleEprint lintUsage
  pure 2

-- | 内部：解析非负/`-1` 整数。
parseIntArg : String -> Maybe Int
parseIntArg s = case strUnpack s of
  45 :: rest => case readDigits rest of
    Just n => Just (0 - n)
    Nothing => Nothing
  _ => readDigits (strUnpack s)

readDigits : List Int -> Maybe Int
readDigits [] = Nothing
readDigits (c :: rest) = if c >= 48 && c <= 57 then readMoreDigits rest (c - 48) else Nothing

readMoreDigits : List Int -> Int -> Maybe Int
readMoreDigits [] acc = Just acc
readMoreDigits (c :: rest) acc =
  if c >= 48 && c <= 57 then readMoreDigits rest (acc * 10 + (c - 48)) else Nothing

-- | 内部：解析选项；格式/整数非法给 `Nothing`。
parseLintOpts : Parsed -> Maybe LintOpts
parseLintOpts parsed = case formatOf (flagValue parsed "format") of
  Nothing => Nothing
  Just fmt => case intOf (flagValue parsed "max-warnings") (0 - 2) of
    Nothing => Nothing
    Just maxWarnings => case intOf (flagValue parsed "max-passes") 8 of
      Nothing => Nothing
      Just maxPasses =>
        if maxPasses <= 0 || maxWarnings /= -2 && maxWarnings < -1 then Nothing
        else Just
          (LintOpts (flagSet parsed "fix") (flagSet parsed "dry-run") (flagSet parsed "quiet") fmt maxPasses (flagSet parsed "no-config") (flagValue parsed "config") (flagValues parsed "select") (flagValues parsed "ignore") (if maxWarnings == -2 then Nothing else Just maxWarnings) (flagSet parsed "no-cache") (flagSet parsed "diff"))

formatOf : Maybe String -> Maybe LintFormat
formatOf Nothing = Just LintText
formatOf (Just "text") = Just LintText
formatOf (Just "json") = Just LintJson
formatOf (Just "github") = Just LintGithub
formatOf (Just "sarif") = Just LintSarif
formatOf _ = Nothing

intOf : Maybe String -> Int -> Maybe Int
intOf Nothing d = Just d
intOf (Just s) d = parseIntArg s

-- | `vuna lint` 的入口。
export runLint : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nStdin StdinOp r => List String -> Eff r Int
runLint args = case parseToolArgs "vuna lint" [BoolFlag "fix", BoolFlag "dry-run", BoolFlag "quiet", BoolFlag "list", BoolFlag "no-config", BoolFlag "no-cache", BoolFlag "diff", ValueFlag "format", ValueFlag "max-warnings", ValueFlag "max-passes", ValueFlag "explain", ValueFlag "config", MultiValueFlag "select", MultiValueFlag "ignore"] args of
  ErrC e => do
    _ <- consoleEprint "error: ${diagText e}\n"
    pure 2
  OkC parsed => if flagSet parsed "list" then printRuleList
  else case flagValue parsed "explain" of
    Just rule => printRuleExplain rule
    Nothing => case parseLintOpts parsed of
      Nothing => do
        _ <- consoleEprint "error: invalid lint option value\n"
        pure 2
      Just opts => do
        targetsR <-
          if length parsed.positionals == 0 then defaultLintTargets
          else fmap (\xs => OkC xs) (expandLintPaths parsed.positionals)
        case targetsR of
          ErrC e => do
            _ <- consoleEprint "error: ${diagText e}\n"
            pure 2
          OkC targets => if length (dedupePaths targets) == 0 then do
            _ <- consoleEprint "error: no vuna sources found\n"
            pure 2
          else do
            ran <- lintFiles opts emptyFixityEnv (dedupePaths targets) []
            finishLint opts (secondOf ran)
