module Vuna.Cli (runCli) where

-- Vuna.Cli：产品 CLI（vuna）。
--
-- 编译器命令（compile / check / build / seed）由 Vuna.CompilerCli 实现，
-- 这里只做 in-process 分发；工具命令（lint / interp / test / fmt / repl / doc）
-- 在本包实现。app/Main.vuna 仍然只是 `main = exit (runCli (getArgs))`。

import Vuna.Base
import Vuna.Pkg
import Vuna.Compile
import Vuna.CompilerCli
import Vuna.Interp
import Vuna.Fmt
import Vuna.Files
import Vuna.Repl
import Vuna.Doc
import Vuna.TestRunner
import qualified Vuna.Lint

toolUsageLines : String -> String
toolUsageLines prog =
  "  " ++ prog ++ " lint [--fix] <file.vuna>...\n"
  ++ "  " ++ prog ++ " interp [--root DIR]... <file.vuna>\n"
  ++ "  " ++ prog ++ " test [DIR]                           运行包内 test/*.vuna（main : String，空串通过）\n"
  ++ "  " ++ prog ++ " fmt [--check] [PATH]...              格式化（PATH 可为文件或目录；省略 = workspace 源码目录）\n"
  ++ "  " ++ prog ++ " repl [--root DIR]...                 交互式 REPL\n"
  ++ "  " ++ prog ++ " doc [DIR] [OUT]                      生成 API 文档（默认 OUT=DIR/docs/api.md）\n"

usageFor prog = "usage:\n" ++ compilerUsageLines prog ++ toolUsageLines prog

runCli : List String -> Int
runCli args =
  case args of
    Nil => usageError
    Cons arg rest =>
      case arg of
        "compile" => runCompilerCliFor "vuna" (Cons arg rest)
        "check" => runCompilerCliFor "vuna" (Cons arg rest)
        "build" => runCompilerCliFor "vuna" (Cons arg rest)
        "seed" => runCompilerCliFor "vuna" (Cons arg rest)
        "lint" => Vuna.Lint.runLint rest
        "interp" => interpArgs rest
        "test" => testArgs rest
        "fmt" => fmtArgs rest
        "repl" => replArgs rest
        "doc" => docArgs rest
        "help" => help
        "--help" => help
        _ => runCompilerCliFor "vuna" args

help = let _ = print (usageFor "vuna") in 0

usageError = let _ = print (usageFor "vuna") in 2

-- ---------------------------------------------------------------
-- interp
-- ---------------------------------------------------------------

interpArgs args = interpParse Nil args

interpParse roots args =
  case args of
    Cons "--root" rest => rootArg roots rest (\roots2, rest2 => interpParse roots2 rest2)
    Cons path Nil => interpEmit (effectiveRoots roots) path
    _ => usageError

rootArg roots rest k =
  case rest of
    Cons dir rest2 => k (append roots (Cons (rawRoot dir) Nil)) rest2
    Nil => usageError

interpEmit roots path =
  let output = interpretFile roots path
  in let _ = print (output ++ "\n")
     in if startsWith "error:" output then 2 else 0

-- ---------------------------------------------------------------
-- test（包模式）
-- ---------------------------------------------------------------

testArgs args =
  case args of
    Nil => testRun "."
    Cons dir Nil => testRun dir
    Cons "--root" rest => usageError
    _ => usageError

testRun dir =
  case loadPackage dir of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok pkg => runTests pkg (packageRoots pkg)

-- ---------------------------------------------------------------
-- fmt
-- ---------------------------------------------------------------

fmtArgs args = fmtParse False Nil args

fmtParse check paths args =
  case args of
    Nil => fmtRun check paths
    Cons arg rest =>
      case arg of
        "--check" => fmtParse True paths rest
        _ => fmtParse check (append paths (Cons arg Nil)) rest

fmtRun check Nil = fmtFiles check (fmtDefaultTargets) 0
fmtRun check paths = fmtFiles check (concatMap expandPath paths) 0

-- 省略 PATH 时格式化 workspace 内所有包的 lib/app/test（拆包后 compiler/ 也在内）。
fmtDefaultTargets : List String
fmtDefaultTargets =
  case findManifestDir "." of
    Err e => ["lib", "app", "test"]
    Ok dir =>
      case workspacePackages dir of
        Err e => [dir ++ "/lib", dir ++ "/app", dir ++ "/test"]
        Ok pkgs => existingTargets (concatMap packageTargets pkgs) Nil

packageTargets pkg =
  Cons (packageDir pkg ++ "/lib")
    (Cons (packageDir pkg ++ "/app") (Cons (packageDir pkg ++ "/test") Nil))

existingTargets Nil acc = reverse acc

existingTargets (Cons path rest) acc =
  if isDirectory path then existingTargets rest (Cons path acc)
  else existingTargets rest acc

expandPath path =
  if isDirectory path then collectVunaFiles path else Cons path Nil

fmtFiles check Nil changed =
  if check && changed > 0 then
    let _ = print (strFromInt changed ++ " file(s) need formatting\n") in 1
  else 0

fmtFiles check (Cons path rest) changed =
  let original = readFile path
  in case formatSource original of
       Err e => let _ = print ("error: " ++ path ++ ": " ++ e ++ "\n") in 2
       Ok formatted =>
         if formatted == original then fmtFiles check rest changed
         else if check then
           let _ = print ("would reformat: " ++ path ++ "\n")
           in fmtFiles check rest (changed + 1)
         else
           let _ = writeFile path formatted
           in let _ = print ("formatted " ++ path ++ "\n")
              in fmtFiles check rest (changed + 1)

-- ---------------------------------------------------------------
-- repl
-- ---------------------------------------------------------------

replArgs args = replParse Nil args

replParse roots args =
  case args of
    Cons "--root" rest => rootArg roots rest (\roots2, rest2 => replParse roots2 rest2)
    Nil => runRepl (effectiveRoots roots)
    _ => usageError

-- ---------------------------------------------------------------
-- doc
-- ---------------------------------------------------------------

docArgs args =
  case args of
    Nil => docRun "." "docs/api.md"
    Cons dir Nil => docRun dir (docDefaultOut dir)
    Cons dir (Cons out Nil) => docRun dir out
    _ => usageError

docDefaultOut dir =
  if dir == "." then "docs/api.md" else dir ++ "/docs/api.md"

docRun dir out = runDoc dir out
