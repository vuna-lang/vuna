module Vuna.Cli (runCli) where

-- Vuna.Cli：产品 CLI（vuna）。
--
-- 编译器命令（compile / check / build / seed）由 Vuna.Compiler.Driver.CompilerCli 实现，
-- 这里只做 in-process 分发；工具命令（lint / interp / test / fmt / repl / doc）在本包实现
-- （doc / gen-errors / map / api / goal / lsp 的实现在各自模块）。app/Main.vuna 仍然只是
-- `main = exit (runCli (prim_eff_getArgs))`。
--
-- 每个命令都必须显式书写；不再支持“无子命令 = compile”的旧式回退。
--
-- M30 · CLI 错误层：
--   - 参数解析统一走 `Vuna.Cli.Args`（允许的 flag 表 + 位置参数；未知/重复/缺值 flag
--     都是可读错误）；
--   - 退出码统一为 0（成功）/ 1（被检查代码或查询的语义失败）/ 2（用法、参数、输入
--     路径或不满足命令前提）；工具命令不得把宿主异常（对不存在路径调
--     `prim_eff_isDirectory`、读不存在文件）漏给用户；
--   - 所有用户给的路径先判存在/目录再读盘（`readText` / `requireExists` /
--     `requireDirectory`）。
import Base.List
import Vuna.Compiler.Common
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Driver.CompilerCli
import Vuna.Compiler.Version
import Vuna.Interp
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.FixityEnv
import Vuna.Compiler.Elab
import Vuna.Fmt
import Vuna.Files
import Vuna.Index
import Vuna.Repl
import Vuna.Repl.Client
import Vuna.Repl.Server
import Vuna.Search
import Vuna.Doc
import Vuna.GenErrors
import Vuna.Clean
import Vuna.Explain
import Vuna.TestRunner
import Vuna.Test.Suite
import Vuna.Test.Run
import Vuna.Run
import Vuna.Lsp
import Vuna.Cli.Args
import qualified Vuna.Lint
import Base.Host
-- W10 收尾：产品 CLI 的 console 路径迁到效应标签（`Base.EffConsole`）。入口仍是
-- `main : IO Int`（IO 是运行时基座/逃逸口）；只有 `consoleLine` 这一条真实路径
-- 经标签 + IO-backed handler 输出，作为工具链的一条真实迁移样板（边界见
-- docs/reference/effects-layers.md §8.6）。
import Base.Eff
import Base.EffConsole

toolUsageLines : String -> String
toolUsageLines prog = """  ${prog} lint [--fix] <file.vuna>...
  ${prog} interp <file.vuna>                   精化后核心求值（纯；不执行效果）
  ${prog} test [--list] [--filter PAT]... [--verbose] [--fail-fast] [--jobs N] [DIR]
      运行包内 test/*.vuna（纯 String/Int/Bool 走核心求值；main : IO ... 走 compile+运行；
      --jobs N 每个测试文件一个子进程、最多 N 并发，默认 1）
  ${prog} test --suite FILE [--only PAT] [--filter PAT] [--list] [--json] [--jobs auto|N]
      运行原生 suite（test/suite.toml）；--jobs auto 用探测到的全部可用核
  ${prog} run [--no-build] [--package NAME] [--out DIR] [DIR] [-- ARG]...
      构建并运行包的可执行入口（`--` 之后的参数原样透传）
  ${prog} fmt [--check] [PATH]...              格式化（PATH 可为文件或目录；省略 = workspace 内各包的 lib/app/test）
  ${prog} repl [FILE|DIR|MODULE]               交互式 REPL（可直接加载文件/目录/模块）
  ${prog} repl --listen ADDR [FILE|DIR|MODULE] 启动常驻 REPL server（JSON-RPC over Content-Length；
      ADDR = tcp:127.0.0.1:PORT | unix:PATH；stdout 输出就绪行 `listening <ADDR>`）
  ${prog} repl --client ADDR                   把 stdin 的一个 JSON-RPC 请求 body 发给 server，打印响应 body
  ${prog} doc [--check] [--package NAME] [DIR [OUT]]
      生成单文件交互 HTML API 文档（默认 OUT=DIR/docs/api.html）
  ${prog} search [--type|--name|--doc] [--module PFX] [--limit N] [--json] <query...>
      名称 / docstring / 类型检索（类型检索为 parse 级）
  ${prog} gen-errors [ROOT]  从枚举真源生成错误码文档（ROOT 必须是已存在目录；输出 ROOT/docs/.generated/errors.md）
  ${prog} explain <CODE> | --list [PREFIX]  查询错误码目录（消息模板 + 说明）
  ${prog} clean-iface [--dry-run] [DIR]         删除 DIR 下的 vuna iface 缓存文件（默认 `.`；不碰源码）
  ${prog} map [--modules]                      模块总览（索引缓存在 .local/index/，自动新鲜度判定）
  ${prog} map --find <Module.name>             定位符号：定义位置 + 引用者 + 建议测试
  ${prog} map --impact <Module.name>           改动影响面：受影响模块 + 测试标签
  ${prog} api <Module.name>                    某模块的签名面（含注释与行号）
  ${prog} goal <file.vuna>                     列出 DT 洞的目标与上下文（M17）
  ${prog} lsp                                  启动 LSP server（JSON-RPC over stdio）
  ${prog} version, --version                   显示版本
  ${prog} help, -h                             显示本帮助
"""

usageFor : String -> String
usageFor prog = "usage:\n${compilerUsageLines prog}${toolUsageLines prog}"

-- `--debug-perf` / `--release` 是全局开关（见 Vuna.Compiler.Debug）：不参与子命令分发。
-- `--release` 由编译器经 `prim_eff_getArgs` 自行读取（strip 只影响分发，不影响 argv）。
stripDebugFlags : List String -> List String
stripDebugFlags [] = []
stripDebugFlags (a :: rest) =
  if a == "--debug-perf" || a == "--release" then stripDebugFlags rest
  else Base.List.Cons a (stripDebugFlags rest)

runCli : List String -> Int
runCli args = if anyHelp (helpSurface args) then help 0 else runCli1 (stripDebugFlags args)

-- `--` 之后是字面量参数（`vuna run <pkg> -- --help` 必须透传给子进程），不参与
-- help 扫描；其余命令的 `--` 语义与 `Vuna.Cli.Args` 一致。
helpSurface : List String -> List String
helpSurface [] = []
helpSurface ("--" :: rest) = []
helpSurface (arg :: rest) = Base.List.Cons arg (helpSurface rest)

-- 编译器命令在 CompilerCli 里实现；`seed` 已删除，仍分发给 CompilerCli 是为了统一
-- 给出迁移提示（`build --out OUT [DIR]` / `compile DIR OUT`）。
runCli1 : List String -> Int
runCli1 args = case args of
  [] => usageError 0
  arg :: rest => case arg of
    "compile" => runCompilerCliFor "vuna" (arg :: rest)
    "check" => runCompilerCliFor "vuna" (arg :: rest)
    "build" => runCompilerCliFor "vuna" (arg :: rest)
    "seed" => runCompilerCliFor "vuna" (arg :: rest)
    "lint" => runPure (Vuna.Lint.runLint rest)
    "interp" => interpArgs rest
    "test" => testArgs rest
    "run" => runPure (Vuna.Run.runRun rest)
    "fmt" => fmtArgs rest
    "repl" => replArgs rest
    "doc" => runPure (Vuna.Doc.runDoc rest)
    "search" => runPure (Vuna.Search.runSearch rest)
    "gen-errors" => genErrorsArgs rest
    "explain" => runPure (Vuna.Explain.runExplain rest)
    "clean-iface" => runPure (Vuna.Clean.runCleanIface rest)
    "map" => mapArgs rest
    "api" => apiArgs rest
    "lsp" => Vuna.Lsp.runLspTool rest
    "goal" => goalArgs rest
    "version" => printVersion 0
    "--version" => printVersion 0
    "help" => help 0
    _ => if startsWith "-" arg then runCompilerCliFor "vuna" args else unknownCommand "vuna" arg

-- M30：版本唯一真源在编译器包（Vuna.Compiler.Version），产品 CLI 与
-- vuna-compiler 共用；VSCode 用它探测服务器。
-- W10 收尾：这一条输出路径走 console 效应标签（mock/real 可替换的样板），
-- 不再直接 `prim_eff_print`；IO 只在最外层 `runPure` 处出现（工具链入口仍是 IO）。
consoleLine : String -> Int
consoleLine msg = runPure (runConsole "vuna" (consolePrint "vuna" msg >>= (\_ => pure 0)))

printVersion : Int -> Int
printVersion _ = consoleLine "vuna ${vunaVersion}\n"

anyHelp : List String -> Bool
anyHelp [] = False
anyHelp (arg :: rest) = if arg == "-h" || arg == "--help" then True else anyHelp rest

help : Int -> Int
help _ =
  let
    _ = runPure (prim_eff_print (usageFor "vuna"))
  in 0

usageError : Int -> Int
usageError _ =
  let
    _ = runPure (prim_eff_print (usageFor "vuna"))
  in 2

unknownCommand : String -> String -> Int
unknownCommand prog arg =
  let
    _ = runPure (prim_eff_print "error: unknown command `${arg}`\nrun `${prog} help`\n")
  in 2

-- ---------------------------------------------------------------
-- 统一错误出口（0/1/2）
-- ---------------------------------------------------------------
toolError : String -> Int
toolError e =
  let
    _ = runPure (prim_eff_print "error: ${e}\n")
  in 2

toolFailure : String -> Int
toolFailure e =
  let
    _ = runPure (prim_eff_print "error: ${e}\n")
  in 1

-- 显式路径的批量存在性检查：一次给出第一个缺失的路径（不静默跳过）。
firstMissingPath : List String -> Maybe String
firstMissingPath [] = Nothing
firstMissingPath (path :: rest) =
  if runPure (prim_eff_fileExists path) then firstMissingPath rest else Just path

-- ---------------------------------------------------------------
-- interp
-- ---------------------------------------------------------------
interpArgs : List String -> Int
interpArgs args = case parseToolArgs "vuna interp" [] args of
  ErrC e => toolError (diagText e)
  OkC parsed => case parsed.positionals of
    [file] => interpFile file
    _ => usageError 0

-- interp 只接受单文件；包目录的入口是 check / compile。
interpFile : String -> Int
interpFile path = case requireExists path of
  ErrC e => toolError (diagText e)
  OkC _ => if runPure (prim_eff_isDirectory path) then interpDirErr path else interpEmit path

interpDirErr : String -> Int
interpDirErr path = toolError "interp takes a single file, not a package directory: ${path}"

interpEmit : String -> Int
interpEmit path = case contextForFile path of
  ErrC e => toolFailure (diagText e)
  OkC ctx =>
    let
      output = interpretFile ctx path
    in let
      _ = runPure (prim_eff_print "${output}\n")
    in if startsWith "error:" output then 2 else 0

-- ---------------------------------------------------------------
-- test（包模式；M38：--list / --filter / --verbose / --fail-fast；
-- C23/C39：--jobs N 包内并行 + 隐藏的 --only-file（内部子进程模式））
-- ---------------------------------------------------------------
testArgs : List String -> Int
testArgs args = case parseToolArgs "vuna test" [BoolFlag "list", BoolFlag "verbose", BoolFlag "fail-fast", BoolFlag "json", BoolFlag "no-cache", BoolFlag "audit", BoolFlag "strict-skips", BoolFlag "timings", BoolFlag "last-failed", BoolFlag "bless", BoolFlag "bless-diag", BoolFlag "watch", BoolFlag "quiet", MultiValueFlag "filter", MultiValueFlag "only", ValueFlag "jobs", ValueFlag "only-file", ValueFlag "suite", ValueFlag "timeout", ValueFlag "worker", ValueFlag "results-dir", ValueFlag "cache-dir", ValueFlag "changed"] args of
  ErrC e => toolError (diagText e)
  OkC parsed => case flagValue parsed "suite" of
    Just suitePath => suiteRun parsed suitePath
    Nothing => packageTestRun parsed

packageTestRun : Parsed -> Int
packageTestRun parsed = case testJobsOf parsed of
  ErrC e => toolError (diagText e)
  OkC jobs => case parsed.positionals of
    [] => testRun (testOptsOf parsed jobs) "."
    [dir] => testRun (testOptsOf parsed jobs) dir
    _ => usageError 0

-- suite 模式：`--suite FILE`；位置参数只用于包模式，`--suite` 时不允许。
suiteRun : Parsed -> String -> Int
suiteRun parsed suitePath = case parsed.positionals of
  [] => case suiteJobsOf parsed of
    ErrC e => toolError (diagText e)
    OkC jobs => case suiteTimeoutOf parsed of
      ErrC e => toolError (diagText e)
      OkC timeout => case suiteWorkerOf parsed of
        ErrC e => toolError (diagText e)
        OkC worker => case parseSuiteFile suitePath of
          ErrC e => toolError (diagText e)
          OkC suite => runSuite (suiteOptsOf parsed jobs timeout worker suitePath) suite
  _ => usageError 0

suiteOptsOf : Parsed -> Int -> Int -> Maybe (Pair Int Int) -> String -> SuiteOpts
suiteOptsOf parsed jobs timeout worker suitePath =
  SuiteOpts suitePath jobs (flagSet parsed "list") (flagSet parsed "verbose")
    (flagSet parsed "fail-fast") (flagSet parsed "json") (flagValues parsed "only")
    (flagValues parsed "filter") timeout worker (flagValue parsed "results-dir")
    (flagSet parsed "quiet") (flagSet parsed "no-cache") (flagSet parsed "last-failed")
    (flagSet parsed "bless") (flagSet parsed "bless-diag") (flagValue parsed "changed")
    (flagValue parsed "cache-dir") (flagSet parsed "watch") (flagSet parsed "timings")
    (flagSet parsed "strict-skips") (flagSet parsed "audit")

-- suite 的 `--jobs`：缺省 0（auto）；`auto` 也映射到 0；其余必须是 >= 1 的整数。
suiteJobsOf : Parsed -> Check Int
suiteJobsOf parsed = case flagValue parsed "jobs" of
  Nothing => OkC 0
  Just "auto" => OkC 0
  Just text => case parsePositiveInt text of
    Nothing => err "--jobs requires a positive integer (>= 1) or `auto`, got `${text}`"
    Just n => OkC n

suiteTimeoutOf : Parsed -> Check Int
suiteTimeoutOf parsed = case flagValue parsed "timeout" of
  Nothing => OkC 0
  Just text => case parsePositiveInt text of
    Nothing => err "--timeout requires a positive integer (seconds), got `${text}`"
    Just n => OkC n

-- 隐藏的 worker 参数：`--worker i/N`（i 从 0 开始）。
suiteWorkerOf : Parsed -> Check (Maybe (Pair Int Int))
suiteWorkerOf parsed = case flagValue parsed "worker" of
  Nothing => OkC Nothing
  Just text => case split "/" text of
    [iText, nText] => case parseNonNegInt iText of
      Nothing => err "--worker requires i/N with non-negative integers, got `${text}`"
      Just i => case parsePositiveInt nText of
        Nothing => err "--worker requires i/N with non-negative integers, got `${text}`"
        Just n => if i < n then OkC (Just (Pair i n)) else err "--worker index must be < N"
    _ => err "--worker requires i/N, got `${text}`"

parseNonNegInt : String -> Maybe Int
parseNonNegInt s = if s == "" then Nothing else nonNegDigits (strUnpack s) 0

nonNegDigits : List Int -> Int -> Maybe Int
nonNegDigits [] acc = Just acc
nonNegDigits (c :: rest) acc =
  if c >= 48 && c <= 57 then nonNegDigits rest (acc * 10 + (c - 48)) else Nothing

-- `--jobs N`：缺省 1；必须是 >= 1 的十进制整数（0 / 非数字 → usage error exit 2；
-- 负数会被参数解析当成缺值 flag，同样 exit 2）。
testJobsOf : Parsed -> Check Int
testJobsOf parsed = case flagValue parsed "jobs" of
  Nothing => OkC 1
  Just text => case parsePositiveInt text of
    Nothing => err "--jobs requires a positive integer (>= 1), got `${text}`"
    Just n => OkC n

parsePositiveInt : String -> Maybe Int
parsePositiveInt s = if s == "" then Nothing else positiveDigits (strUnpack s) 0

positiveDigits : List Int -> Int -> Maybe Int
positiveDigits [] acc = if acc > 0 then Just acc else Nothing
positiveDigits (c :: rest) acc =
  if c >= 48 && c <= 57 then positiveDigits rest (acc * 10 + (c - 48)) else Nothing

testOptsOf : Parsed -> Int -> TestOpts
testOptsOf parsed jobs =
  TestOpts (flagValues parsed "filter") (flagSet parsed "list") (flagSet parsed "verbose")
    (flagSet parsed "fail-fast") (if flagSet parsed "only-file" then 1 else jobs)
    (flagValue parsed "only-file")

testRun : TestOpts -> String -> Int
testRun opts dir = case requireDirectory dir of
  ErrC e => toolError (diagText e)
  OkC _ => case loadPackage dir of
    ErrC e => toolFailure (diagText e)
    OkC pkg => runPure (runTests opts pkg)

-- ---------------------------------------------------------------
-- fmt
-- ---------------------------------------------------------------
fmtArgs : List String -> Int
fmtArgs args = case parseToolArgs "vuna fmt" [BoolFlag "check"] args of
  ErrC e => toolError (diagText e)
  OkC parsed => fmtRun (flagSet parsed "check") parsed.positionals

fmtRun : Bool -> List String -> Int
fmtRun check [] = case fmtDefaultTargets 0 of
  ErrC e => toolError (diagText e)
  OkC targets => fmtFiles check emptyFixityEnv (concatMap expandPath targets) 0
fmtRun check paths = case firstMissingPath paths of
  Just missing => toolError "no such file: ${missing}"
  Nothing => fmtFiles check emptyFixityEnv (concatMap expandPath paths) 0

-- 省略 PATH 时格式化 workspace 内所有包的 lib/app/test（拆包后 compiler/ 也在内）。
-- 不是 workspace 或没有任何源码目录都是**输入错误**（exit 2），不再静默回退到相对
-- 路径 `lib/app/test`（旧实现会在非包目录把 `lib` 当文件读而抛宿主异常）。
-- A05：零参顶层定义在模块初始化时求值；这里是启动期读盘动作，必须函数化。
fmtDefaultTargets : Int -> Check (List String)
fmtDefaultTargets _ = case findManifestDirMaybe "." of
  Nothing =>
    err
      "not inside a vuna workspace (no vuna.toml found from ${runPure prim_eff_getcwd}); pass PATH explicitly"
  Just dir => case workspacePackages dir of
    ErrC e => ErrC e
    OkC pkgs =>
      let
        targets = existingTargets (concatMap packageTargets pkgs) []
      in if length targets == 0 then err
        "no vuna sources found in workspace at ${dir} (looked for lib/, app/, test/ under each package); pass PATH explicitly"
      else OkC targets

packageTargets : Package -> List String
packageTargets pkg = ["${packageDir pkg}/lib", "${packageDir pkg}/app", "${packageDir pkg}/test"]

existingTargets : List String -> List String -> List String
existingTargets [] acc = reverse acc
existingTargets (path :: rest) acc =
  if pathExistsDir path then existingTargets rest (path :: acc) else existingTargets rest acc

expandPath : String -> List String
expandPath path = if pathExistsDir path then collectVunaFiles path else [path]

-- M31.3（B27）：fmt 的 fixity 是**程序级**的（本文件 `infix*` 声明 + 该文件 import 闭包）。
-- `Vuna.FixityEnv` 按文件目录缓存「按包上下文加载的模块图」（昂贵部分），声明表逐文件
-- 重算（不同文件 imports 不同，跨文件复用会判 unknown fixity / 打出错误括号）。
-- 上下文/加载失败是硬错误：fixity 无法确定时**拒绝格式化该文件**，不静默改语义。
fmtFiles : Bool -> FixityEnv -> List String -> Int -> Int
fmtFiles check env [] changed = if check && changed > 0 then
  let
    _ = runPure (prim_eff_print "${changed} file(s) need formatting\n")
  in 1
else 0
fmtFiles check env (path :: rest) changed = case readText path of
  ErrC e => toolError (diagText e)
  OkC original =>
    let
      looked = fixitiesForFile env path original
      env2 = firstOf looked
    in case secondOf looked of
      ErrC e => toolError "${path}: cannot determine fixity context: ${diagText e}"
      OkC fixities => case formatSourceWith fixities original of
        ErrC e => toolError "${path}: ${diagText e}"
        OkC formatted => if formatted == original then fmtFiles check env2 rest changed
        else if check then
          let
            _ = runPure (prim_eff_print "would reformat: ${path}\n")
          in fmtFiles check env2 rest (changed + 1)
        else
          let
            _ = runPure (prim_eff_writeFile path formatted)
          in let
            _ = runPure (prim_eff_print "formatted ${path}\n")
          in fmtFiles check env2 rest (changed + 1)

-- ---------------------------------------------------------------
-- repl
-- ---------------------------------------------------------------
replArgs : List String -> Int
replArgs args = case parseToolArgs "vuna repl" [ValueFlag "listen", ValueFlag "client", BoolFlag "privileged"] args of
  ErrC e => toolError (diagText e)
  OkC parsed => case flagValue parsed "client" of
    Just addr => case flagValue parsed "listen" of
      Just _ => toolError "`--listen` 与 `--client` 只能二选一"
      Nothing => case parsed.positionals of
        [] => replClientWith addr
        _ =>
          toolError "`--client` 不接受启动目标（它只做传输，不加载包上下文）"
    Nothing => case flagValue parsed "listen" of
      Just addr => case parsed.positionals of
        [] =>
          replServerWith addr StartNone
            (maybePrivilegedCtx (flagSet parsed "privileged") (contextForDir "."))
        [target] => replServerWithTarget addr target (flagSet parsed "privileged")
        _ => usageError 0
      Nothing => case parsed.positionals of
        [] =>
          replWith Nothing 0 StartNone
            (maybePrivilegedCtx (flagSet parsed "privileged") (contextForDir "."))
        [target] => replTargetWith Nothing target (flagSet parsed "privileged")
        _ => usageError 0

-- `--client`：纯传输（不加载包上下文；地址校验在 Server 层共用）。
replClientWith : String -> Int
replClientWith addr = case checkReplAddr addr of
  ErrC e => toolError (diagText e)
  OkC _ => runReplClient addr

-- `--listen`：socket 上的常驻 server；启动目标与交互式同一套解析。
replServerWith : String -> ReplStart -> Check PackageContext -> Int
replServerWith addr start ctxRes = case checkReplAddr addr of
  ErrC e => toolError (diagText e)
  OkC _ => replWith (Just addr) 0 start ctxRes

replServerWithTarget : String -> String -> Bool -> Int
replServerWithTarget addr target priv = case checkReplAddr addr of
  ErrC e => toolError (diagText e)
  OkC _ => replTargetWith (Just addr) target priv

replWith : Maybe String -> Int -> ReplStart -> Check PackageContext -> Int
replWith Nothing _ start (ErrC e) = toolFailure (diagText e)
replWith Nothing _ start (OkC ctx) = runRepl ctx start
replWith (Just addr) _ start (ErrC e) = toolFailure (diagText e)
replWith (Just addr) _ start (OkC ctx) = runReplServer ctx start addr

-- 启动目标：存在目录 → 该包上下文；存在文件 → 文件所在包上下文 + 启动加载；
-- 不存在且像模块名 → cwd 上下文 + 启动导入；其它报可操作错误。
-- F3 P2b：REPL 默认按**非特权**上下文求值；`vuna repl --privileged` 显式以特权上下文
-- 求值（开发工具开关，见 `Pkg.privilegedContext`）。
maybePrivilegedCtx : Bool -> Check PackageContext -> Check PackageContext
maybePrivilegedCtx False r = r
maybePrivilegedCtx True r = case r of
  ErrC e => ErrC e
  OkC c => OkC (privilegedContext c)

replTargetWith : Maybe String -> String -> Bool -> Int
replTargetWith listen target priv =
  if runPure (prim_eff_fileExists target) then if runPure (prim_eff_isDirectory target) then replWith listen 0 (StartDir target) (maybePrivilegedCtx priv (contextForDir target))
  else replWith listen 0 (StartFile target) (maybePrivilegedCtx priv (contextForFile target))
  else if isModuleNameStr target then replWith listen 0 (StartModule target) (maybePrivilegedCtx priv (contextForDir "."))
  else toolFailure
    ("找不到文件或目录: " ++ target ++ "（vuna repl 接受 <FILE> | <DIR> | <Module.Name>）")

-- ---------------------------------------------------------------
-- gen-errors（错误码文档生成）
-- 用法：vuna gen-errors [ROOT]；ROOT 默认 "."，输出 ROOT/docs/.generated/errors.md。
-- 生成物不纳入 git（docs/.generated/ 在 .gitignore）。
-- ---------------------------------------------------------------
genErrorsArgs : List String -> Int
genErrorsArgs args = case parseToolArgs "vuna gen-errors" [] args of
  ErrC e => toolError (diagText e)
  OkC parsed => case parsed.positionals of
    [] => runPure (runGenErrors ".")
    [root] => runPure (runGenErrors root)
    _ => usageError 0

-- ---------------------------------------------------------------
-- map / api（源码索引）
-- 索引缓存在 .local/index/，每次调用自动按内容哈希判定新鲜度，
-- 没有「刷新索引」命令；详见 Vuna.Index。
-- ---------------------------------------------------------------
mapArgs : List String -> Int
mapArgs args = case parseToolArgs "vuna map" [BoolFlag "modules", ValueFlag "find", ValueFlag "impact"] args of
  ErrC e => toolError (diagText e)
  OkC parsed => case parsed.positionals of
    [] => mapRun parsed
    _ => usageError 0

mapRun : Parsed -> Int
mapRun parsed = case flagValue parsed "find" of
  Just query => case flagValue parsed "impact" of
    Just _ => usageError 0
    Nothing => runFind query
  Nothing => case flagValue parsed "impact" of
    Just query => runImpact query
    Nothing => printOverview (flagSet parsed "modules")

-- 非 workspace 是输入错误（exit 2），不再静默输出空索引。
withIndex : (Index -> Int) -> Int
withIndex f = case findManifestDirMaybe "." of
  Nothing =>
    toolError
      "not inside a vuna workspace (no vuna.toml found from ${runPure prim_eff_getcwd}); run `vuna map` from a package or workspace root"
  Just _ => case loadOrBuild "." of
    ErrC e => toolError (diagText e)
    OkC index => f index

printOverview : Bool -> Int
printOverview modulesOnly = withIndex (\index => let
  text = if modulesOnly then renderModules index else renderOverview index
in let
  _ = runPure (prim_eff_print "${text}\n")
in 0
)

runFind : String -> Int
runFind query = withIndex (\index => case findSymbol index query of
  ErrC e =>
    let
      _ = runPure (prim_eff_print "error: ${diagText e}\n")
    in 1
  OkC hits =>
    let
      _ = map (\s => runPure (prim_eff_print "${symLineText s}\n")) hits
    in case hits of
      [] => 1
      [_] => 0
      _ =>
        let
          _ =
            runPure
              (prim_eff_print "ambiguous: ${length hits} candidates, use a full Module.name\n")
        in 2
)

-- 一行：全名 + 文件:行 + 签名。
symLineText : Sym -> String
symLineText s =
  "${symFullName s}  (${symLine s}:${symCol s})${if symSig s == "" then "" else "  ${symSig s}"}"

runImpact : String -> Int
runImpact query = withIndex (\index => case impactOf index query of
  ErrC e =>
    let
      _ = runPure (prim_eff_print "error: ${diagText e}\n")
    in 1
  OkC text =>
    let
      _ = runPure (prim_eff_print "${text}\n")
    in 0
)

apiArgs : List String -> Int
apiArgs args = case parseToolArgs "vuna api" [] args of
  ErrC e => toolError (diagText e)
  OkC parsed => case parsed.positionals of
    [modName] => runApi modName
    _ => usageError 0

runApi : String -> Int
runApi modName = withIndex (\index => case renderApi index modName of
  ErrC e =>
    let
      _ = runPure (prim_eff_print "error: ${diagText e}\n")
    in 1
  OkC text =>
    let
      _ = runPure (prim_eff_print "${text}\n")
    in 0
)

-- ---------------------------------------------------------------
-- goal（M17：洞目标显示）
-- `vuna goal <file.vuna>` 列出 DT 文件里每个洞 `_` 的位置、目标类型与上下文。
-- ---------------------------------------------------------------
goalArgs : List String -> Int
goalArgs args = case parseToolArgs "vuna goal" [] args of
  ErrC e => toolError (diagText e)
  OkC parsed => case parsed.positionals of
    [file] => goalRun file
    _ => usageError 0

goalRun : String -> Int
goalRun file = case readText file of
  ErrC e => toolError (diagText e)
  OkC source => case parseSource file source of
    ErrC e => toolFailure (diagText e)
    OkC (SourceFile _ _ fx decls0) => case secondOf (fixitiesForFile emptyFixityEnv file source) of
      ErrC e => toolFailure (diagText e)
      OkC programFixities => case reorderProgram (tableOfKeepOps (append programFixities fx)) decls0 of
        ErrC e => toolFailure (diagText e)
        OkC decls => case goalsOfProgramTolerant decls of
          ErrC e => toolFailure (diagText e)
          OkC infos =>
            let
              _ =
                runPure (prim_eff_print (goalHeader file (length infos) ++ renderGoals file infos))
            in 0

renderGoals : String -> List DtGoalInfo -> String
renderGoals file [] = ""
renderGoals file (i :: rest) =
  "${showSpanLoc i.dtGoalInfoSpan}: goal ${goalLabel i}\n${renderGoalCtx i.dtGoalInfoCtx}${renderGoals file rest}"

-- M40：命名洞显示 `?name : <目标类型>`；匿名洞保持 `<目标类型>`（与旧输出一致）。
goalLabel : DtGoalInfo -> String
goalLabel i =
  if i.dtGoalInfoName == "" then i.dtGoalInfoGoal else "${i.dtGoalInfoName} : ${i.dtGoalInfoGoal}"

renderGoalCtx : List (Pair String String) -> String
renderGoalCtx [] = ""
renderGoalCtx ((Pair n ty) :: rest) = "  ${n} : ${ty}\n${renderGoalCtx rest}"

goalHeader : String -> Int -> String
goalHeader file n = if n == 0 then "${file}: no holes\n" else ""
