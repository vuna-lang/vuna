module Vuna.Json (Json(..), renderJson, parseJson, jsonGet, jsonGetIn, jsonAsStr, jsonAsInt, jsonAsBool, jsonAsArr, jsonAsObj, jsonStrOr, jsonIntOr, jsonBoolOr, jsonObjSingle) where

-- Vuna.Json：最小 JSON 读写（LSP 用；**永不进 seed 闭包**）。
--
-- 只做 JSON-RPC 需要的子集：null / bool / number / string / array / object。
-- 数字统一用 Int 表示：小数部分与指数会被截断（LSP 的位置、长度、id 都是整数，
-- 需要浮点的字段不在本模块范围内）。
--
-- 解析是单遍递归下降，输入用 `List Int`（strUnpack）游标；错误只报位置无关的
-- 简短原因（LSP 侧会把它写进 stderr 日志，不需要富诊断）。
--
-- 字符串转义：\" \\ \/ \b \f \n \r \t 与 \uXXXX（按 UTF-8 编码；代理对不支持，
-- 输出端把 < 0x20 的控制字符转成 \u00XX）。
import Base.List
import Base.Maybe
import Base.Result
import Base.String

-- ---------------------------------------------------------------
-- 数据模型
-- ---------------------------------------------------------------
data Json : Type where
  JNull : Json
  JBool : Bool -> Json
  JNum : Int -> Json
  JStr : String -> Json
  JArr : List Json -> Json
  JObj : List (Pair String Json) -> Json

-- 单键对象（构造响应时常用）。
jsonObjSingle : String -> Json -> Json
jsonObjSingle k v = JObj [Pair k v]

-- ---------------------------------------------------------------
-- 访问器
-- ---------------------------------------------------------------
jsonGet : String -> Json -> Maybe Json
jsonGet key v = case v of
  JObj kvs => lookupKV key kvs
  _ => Nothing

lookupKV : String -> List (Pair String Json) -> Maybe Json
lookupKV key [] = Nothing
lookupKV key ((Pair k x) :: rest) = if k == key then Just x else lookupKV key rest

-- 嵌套路径：`jsonGetIn ["params", "textDocument", "uri"] v`。
jsonGetIn : List String -> Json -> Maybe Json
jsonGetIn [] v = Just v
jsonGetIn (k :: rest) v = case jsonGet k v of
  Nothing => Nothing
  Just inner => jsonGetIn rest inner

jsonAsStr : Json -> Maybe String
jsonAsStr v = case v of
  JStr s => Just s
  _ => Nothing

jsonAsInt : Json -> Maybe Int
jsonAsInt v = case v of
  JNum n => Just n
  _ => Nothing

jsonAsBool : Json -> Maybe Bool
jsonAsBool v = case v of
  JBool b => Just b
  _ => Nothing

jsonAsArr : Json -> Maybe (List Json)
jsonAsArr v = case v of
  JArr xs => Just xs
  _ => Nothing

jsonAsObj : Json -> Maybe (List (Pair String Json))
jsonAsObj v = case v of
  JObj kvs => Just kvs
  _ => Nothing

jsonStrOr : String -> Json -> String
jsonStrOr d v = case v of
  JStr s => s
  _ => d

jsonIntOr : Int -> Json -> Int
jsonIntOr d v = case v of
  JNum n => n
  _ => d

jsonBoolOr : Bool -> Json -> Bool
jsonBoolOr d v = case v of
  JBool b => b
  _ => d

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
renderJson : Json -> String
renderJson v = case v of
  JNull => "null"
  JBool b => if b then "true" else "false"
  JNum n => strFromInt n
  JStr s => renderJsonString s
  JArr xs => "[" ++ join "," (map renderJson xs) ++ "]"
  JObj kvs => "{" ++ join "," (map renderMember kvs) ++ "}"

renderMember : Pair String Json -> String
renderMember kv = renderJsonString (firstOf kv) ++ ":" ++ renderJson (secondOf kv)

renderJsonString : String -> String
renderJsonString s =
  let
    body = join "" (map escapeChunk (strUnpack s))
  in "\"" ++ body ++ "\""

-- 每字符一块（无需转义时退化为单字符），拼起来等价于逐字符转义。
escapeChunk : Int -> String
escapeChunk c =
  if c == 34 then "\\\""
  else if c == 92 then "\\\\"
  else if c == 10 then "\\n"
  else if c == 9 then "\\t"
  else if c == 13 then "\\r"
  else if c == 8 then "\\b"
  else if c == 12 then "\\f" else if c < 32 then "\\u" ++ pad4 (hexLower c) else strPack [c]

pad4 : String -> String
pad4 s = repeat (4 - strLength s) "0" ++ s

hexLower : Int -> String
hexLower n = strPack [hexDigit (n / 16), hexDigit (n - n / 16 * 16)]

hexDigit : Int -> Int
hexDigit d = if d < 10 then 48 + d else 87 + d

-- ---------------------------------------------------------------
-- 解析
-- ---------------------------------------------------------------
parseJson : String -> Result Json
parseJson source =
  let
    chars = skipJsonWs (strUnpack source)
  in case parseValue chars of
    Err e => Err ("json: " ++ e)
    Ok (Pair v rest) => if skipJsonWs rest == [] then Ok v else Err "json: trailing characters"

skipJsonWs : List Int -> List Int
skipJsonWs [] = []
skipJsonWs (c :: rest) =
  if c == 32 || c == 9 || c == 10 || c == 13 then skipJsonWs rest else c :: rest

parseValue : List Int -> Result (Pair Json (List Int))
parseValue chars = case chars of
  [] => Err "unexpected end of input"
  c :: rest =>
    if c == 123 then parseObject rest
    else if c == 91 then parseArray rest
    else if c == 34 then parseStringBody rest []
    else if c == 116 then parseLiteral "true" (JBool True) chars
    else if c == 102 then parseLiteral "false" (JBool False) chars
    else if c == 110 then parseLiteral "null" JNull chars
    else if isDigitChar c || c == 45 then parseNumber chars
    else Err ("unexpected character " ++ strFromInt c)

isDigitChar : Int -> Bool
isDigitChar c = c >= 48 && c <= 57

parseLiteral : String -> Json -> List Int -> Result (Pair Json (List Int))
parseLiteral want value chars = case splitAtCharCount (strLength want) chars of
  Nothing => Err ("expected " ++ want)
  Just (Pair got rest) =>
    if strPack got == want then Ok (Pair value rest) else Err ("expected " ++ want)

parseObject : List Int -> Result (Pair Json (List Int))
parseObject chars = case parseObjectMembers chars [] of
  Err e => Err e
  Ok (Pair kvs rest) => Ok (Pair (JObj kvs) rest)

parseObjectMembers : List Int -> List (Pair String Json) -> Result (Pair (List (Pair String Json)) (List Int))
parseObjectMembers chars acc = case skipJsonWs chars of
  [] => Err "unterminated object"
  c :: rest =>
    if c == 125 then Ok (Pair (reverse acc) rest)
    else if c == 34 then parseObjectPair rest acc else Err "expected a string key in object"

parseObjectPair : List Int -> List (Pair String Json) -> Result (Pair (List (Pair String Json)) (List Int))
parseObjectPair chars acc = case parseStringBody chars [] of
  Err e => Err e
  Ok (Pair keyJson rest) => case skipJsonWs rest of
    [] => Err "unterminated object"
    c :: rest2 =>
      if c == 58 then parseObjectValue (jsonStrOr "" keyJson) (skipJsonWs rest2) acc
      else Err "expected : in object"

parseObjectValue : String -> List Int -> List (Pair String Json) -> Result (Pair (List (Pair String Json)) (List Int))
parseObjectValue key chars acc = case parseValue chars of
  Err e => Err e
  Ok (Pair v rest) => case skipJsonWs rest of
    [] => Err "unterminated object"
    c :: rest2 =>
      if c == 44 then parseObjectMembers rest2 (Pair key v :: acc)
      else if c == 125 then Ok (Pair (reverse (Pair key v :: acc)) rest2)
      else Err "expected , or } in object"

parseArray : List Int -> Result (Pair Json (List Int))
parseArray chars = case parseArrayItems chars [] of
  Err e => Err e
  Ok (Pair items rest) => Ok (Pair (JArr items) rest)

parseArrayItems : List Int -> List Json -> Result (Pair (List Json) (List Int))
parseArrayItems chars acc = case skipJsonWs chars of
  [] => Err "unterminated array"
  c :: rest => if c == 93 then Ok (Pair (reverse acc) rest) else parseArrayValue (c :: rest) acc

parseArrayValue : List Int -> List Json -> Result (Pair (List Json) (List Int))
parseArrayValue chars acc = case parseValue chars of
  Err e => Err e
  Ok (Pair v rest) => case skipJsonWs rest of
    [] => Err "unterminated array"
    c :: rest2 =>
      if c == 44 then parseArrayItems rest2 (v :: acc)
      else if c == 93 then Ok (Pair (reverse (v :: acc)) rest2) else Err "expected , or ] in array"

-- 字符串体：起始引号已被消费；acc 是逆序字符。
parseStringBody : List Int -> List Int -> Result (Pair Json (List Int))
parseStringBody chars acc = case chars of
  [] => Err "unterminated string"
  c :: rest =>
    if c == 34 then Ok (Pair (JStr (strPack (reverse acc))) rest)
    else if c == 92 then parseEscape rest acc else parseStringBody rest (c :: acc)

parseEscape : List Int -> List Int -> Result (Pair Json (List Int))
parseEscape chars acc = case chars of
  [] => Err "unterminated string"
  c :: rest =>
    if c == 34 then parseStringBody rest (34 :: acc)
    else if c == 92 then parseStringBody rest (92 :: acc)
    else if c == 47 then parseStringBody rest (47 :: acc)
    else if c == 98 then parseStringBody rest (8 :: acc)
    else if c == 102 then parseStringBody rest (12 :: acc)
    else if c == 110 then parseStringBody rest (10 :: acc)
    else if c == 114 then parseStringBody rest (13 :: acc)
    else if c == 116 then parseStringBody rest (9 :: acc)
    else if c == 117 then parseUnicodeEscape rest acc else Err ("invalid escape \\" ++ strPack [c])

parseUnicodeEscape : List Int -> List Int -> Result (Pair Json (List Int))
parseUnicodeEscape chars acc = case splitAtCharCount 4 chars of
  Nothing => Err "invalid \\u escape"
  Just (Pair digits rest) => case parseHex4 digits of
    Nothing => Err "invalid \\u escape"
    Just code => parseStringBody rest (append (reverse (encodeUtf8 code)) acc)

parseHex4 : List Int -> Maybe Int
parseHex4 digits = parseHex4Go digits 0 0

parseHex4Go : List Int -> Int -> Int -> Maybe Int
parseHex4Go [] code count = if count == 4 then Just code else Nothing
parseHex4Go (c :: rest) code count = case hexVal c of
  Nothing => Nothing
  Just d => parseHex4Go rest (code * 16 + d) (count + 1)

hexVal : Int -> Maybe Int
hexVal c =
  if c >= 48 && c <= 57 then Just (c - 48)
  else if c >= 97 && c <= 102 then Just (c - 87)
  else if c >= 65 && c <= 70 then Just (c - 55) else Nothing

-- UTF-8 编码（只处理 BMP；代理对不合并）。
encodeUtf8 : Int -> List Int
encodeUtf8 code =
  if code < 128 then [code]
  else if code < 2048 then [192 + code / 64, 128 + code - code / 64 * 64]
  else [224 + code / 4096, 128 + code / 64 - code / 4096 * 64, 128 + code - code / 64 * 64]

-- 数字：可选负号 + 整数部分；小数/指数被读取但截断（见模块头注释）。
parseNumber : List Int -> Result (Pair Json (List Int))
parseNumber chars = case signOf chars of
  Pair negative rest1 => case parseIntDigits rest1 0 0 of
    Pair value (Pair count rest2) => if count == 0 then Err "invalid number"
    else
      let
        signed = if negative then 0 - value else value
      in case skipNumberTail rest2 of
        Pair rest3 ok => if ok then Ok (Pair (JNum signed) rest3) else Err "invalid number"

signOf : List Int -> Pair Bool (List Int)
signOf chars = case chars of
  c :: rest => if c == 45 then Pair True rest else Pair False chars
  [] => Pair False []

-- 返回 (数值, (位数, 余下字符))。
parseIntDigits : List Int -> Int -> Int -> Pair Int (Pair Int (List Int))
parseIntDigits chars acc count = case chars of
  c :: rest =>
    if isDigitChar c then parseIntDigits rest (acc * 10 + (c - 48)) (count + 1)
    else Pair acc (Pair count (c :: rest))
  [] => Pair acc (Pair count [])

-- 小数与指数：语法校验后丢弃（值保持整数）。
skipNumberTail : List Int -> Pair (List Int) Bool
skipNumberTail chars = case chars of
  c :: rest => if c == 46 then case parseIntDigits rest 0 0 of
    Pair value (Pair count rest2) => if count == 0 then Pair chars False else skipExponent rest2
  else skipExponent chars
  [] => Pair [] True

skipExponent : List Int -> Pair (List Int) Bool
skipExponent chars = case chars of
  c :: rest => if c == 101 || c == 69 then
    let
      afterSign = case rest of
        s :: rest2 => if s == 43 || s == 45 then rest2 else rest
        [] => []
    in case parseIntDigits afterSign 0 0 of
      Pair value (Pair count rest3) => if count == 0 then Pair chars False else Pair rest3 True
  else Pair chars True
  [] => Pair [] True

-- 取前 n 个字符；不足 n 个返回 Nothing。
splitAtCharCount : Int -> List Int -> Maybe (Pair (List Int) (List Int))
splitAtCharCount n chars = takeCount chars n []

takeCount : List Int -> Int -> List Int -> Maybe (Pair (List Int) (List Int))
takeCount chars n acc = if n <= 0 then Just (Pair (reverse acc) chars)
else case chars of
  [] => Nothing
  c :: rest => takeCount rest (n - 1) (c :: acc)
