module Vuna.Json
  ( Json(..)
  , jsonAsArr
  , jsonAsBool
  , jsonAsInt
  , jsonAsObj
  , jsonAsStr
  , jsonBoolOr
  , jsonGet
  , jsonGetIn
  , jsonIntOr
  , jsonObjSingle
  , jsonStrOr
  , parseJson
  , renderJson
  ) where

-- Vuna.Json：最小 JSON 读写（LSP 用；**永不进 seed 闭包**）。
--
-- 只做 JSON-RPC 需要的子集：null / bool / number / string / array / object。
-- 数字统一用 Int 表示：小数部分与指数会被截断（LSP 的位置、长度、id 都是整数，
-- 需要浮点的字段不在本模块范围内）。
--
-- 解析是单遍递归下降，输入用 `List Int`（strUnpack）游标；错误只报位置无关的
-- 简短原因（LSP 侧会把它写进 stderr 日志，不需要富诊断）。
--
-- 字符串转义：\" \\ \/ \b \f \n \r \t 与 \uXXXX（按 UTF-8 编码；代理对不支持，
-- 输出端把 < 0x20 的控制字符转成 \u00XX）。
import Base.List
import Base.Maybe
import Base.Result
import Base.String

-- ---------------------------------------------------------------
-- 数据模型
-- ---------------------------------------------------------------
data Json : Type where
  JNull : Json
  JBool : Bool -> Json
  JNum : Int -> Json
  JStr : String -> Json
  JArr : List Json -> Json
  JObj : List (Pair String Json) -> Json

-- 单键对象（构造响应时常用）。
jsonObjSingle : String -> Json -> Json
jsonObjSingle k v = JObj [Pair k v]

-- ---------------------------------------------------------------
-- 访问器
-- ---------------------------------------------------------------
jsonGet : String -> Json -> Maybe Json
jsonGet key (JObj kvs) = lookupKV key kvs
jsonGet key _ = Nothing

lookupKV : String -> List (Pair String Json) -> Maybe Json
lookupKV key [] = Nothing
lookupKV key ((Pair k x) :: rest) = if k == key then Just x else lookupKV key rest

-- 嵌套路径：`jsonGetIn ["params", "textDocument", "uri"] v`。
jsonGetIn : List String -> Json -> Maybe Json
jsonGetIn [] v = Just v
jsonGetIn (k :: rest) v = case jsonGet k v of
  Nothing => Nothing
  Just inner => jsonGetIn rest inner

jsonAsStr : Json -> Maybe String
jsonAsStr (JStr s) = Just s
jsonAsStr _ = Nothing

jsonAsInt : Json -> Maybe Int
jsonAsInt (JNum n) = Just n
jsonAsInt _ = Nothing

jsonAsBool : Json -> Maybe Bool
jsonAsBool (JBool b) = Just b
jsonAsBool _ = Nothing

jsonAsArr : Json -> Maybe (List Json)
jsonAsArr (JArr xs) = Just xs
jsonAsArr _ = Nothing

jsonAsObj : Json -> Maybe (List (Pair String Json))
jsonAsObj (JObj kvs) = Just kvs
jsonAsObj _ = Nothing

jsonStrOr : String -> Json -> String
jsonStrOr d (JStr s) = s
jsonStrOr d _ = d

jsonIntOr : Int -> Json -> Int
jsonIntOr d (JNum n) = n
jsonIntOr d _ = d

jsonBoolOr : Bool -> Json -> Bool
jsonBoolOr d (JBool b) = b
jsonBoolOr d _ = d

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
renderJson : Json -> String
renderJson JNull = "null"
renderJson (JBool b) = if b then "true" else "false"
renderJson (JNum n) = strFromInt n
renderJson (JStr s) = renderJsonString s
renderJson (JArr xs) = "[" ++ join "," (map renderJson xs) ++ "]"
renderJson (JObj kvs) = "{" ++ join "," (map renderMember kvs) ++ "}"

renderMember : Pair String Json -> String
renderMember kv = renderJsonString (firstOf kv) ++ ":" ++ renderJson (secondOf kv)

renderJsonString : String -> String
renderJsonString s =
  let
    body = join "" (map escapeChunk (strUnpack s))
  in "\"" ++ body ++ "\""

-- 每字符一块（无需转义时退化为单字符），拼起来等价于逐字符转义。
escapeChunk : Int -> String
escapeChunk 34 = "\\\""
escapeChunk 92 = "\\\\"
escapeChunk 10 = "\\n"
escapeChunk 9 = "\\t"
escapeChunk 13 = "\\r"
escapeChunk 8 = "\\b"
escapeChunk 12 = "\\f"
escapeChunk c = if c < 32 then "\\u" ++ pad4 (hexLower c) else strPack [c]

pad4 : String -> String
pad4 s = repeat (4 - byteLength s) "0" ++ s

hexLower : Int -> String
hexLower n = strPack [hexDigit (n / 16), hexDigit (n - n / 16 * 16)]

hexDigit : Int -> Int
hexDigit d = if d < 10 then 48 + d else 87 + d

-- ---------------------------------------------------------------
-- 解析
-- ---------------------------------------------------------------
-- 显式 fuel：递归下降的互递归组经「返回剩余输入再递归」，SCT 看不到跨函数的结构下降；
-- 用 fuel 守卫 + 同参数位 `fuel - 1`。初值按输入字符数线性放大（每步至少消费一字符）。
jsonFuel : List Int -> Int
jsonFuel chars = 8 * length chars + 64

parseJson : String -> Result Json
parseJson source =
  let
    chars = skipJsonWs (strUnpack source)
  in case parseValue (jsonFuel chars) chars of
    Err e => Err ("json: " ++ e)
    Ok (Pair v rest) =>
      if length (skipJsonWs rest) == 0 then Ok v else Err "json: trailing characters"

skipJsonWs : List Int -> List Int
skipJsonWs [] = []
skipJsonWs (c :: rest) =
  if c == 32 || c == 9 || c == 10 || c == 13 then skipJsonWs rest else c :: rest

parseValue : Int -> List Int -> Result (Pair Json (List Int))
parseValue fuel chars = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case chars of
  [] => Err "unexpected end of input"
  c :: rest =>
    if c == 123 then parseObject (fuel - 1) rest
    else if c == 91 then parseArray (fuel - 1) rest
    else if c == 34 then parseStringBody (fuel - 1) rest []
    else if c == 116 then parseLiteral "true" (JBool True) chars
    else if c == 102 then parseLiteral "false" (JBool False) chars
    else if c == 110 then parseLiteral "null" JNull chars
    else if isDigitChar c || c == 45 then parseNumber chars
    else Err ("unexpected character " ++ strFromInt c)

isDigitChar : Int -> Bool
isDigitChar c = c >= 48 && c <= 57

parseLiteral : String -> Json -> List Int -> Result (Pair Json (List Int))
parseLiteral want value chars = case splitAtCharCount (strLength want) chars of
  Nothing => Err ("expected " ++ want)
  Just (Pair got rest) =>
    if strPack got == want then Ok (Pair value rest) else Err ("expected " ++ want)

parseObject : Int -> List Int -> Result (Pair Json (List Int))
parseObject fuel chars = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case parseObjectMembers (fuel - 1) chars [] of
  Err e => Err e
  Ok (Pair kvs rest) => Ok (Pair (JObj kvs) rest)

parseObjectMembers : Int -> List Int -> List (Pair String Json) -> Result (Pair (List (Pair String Json)) (List Int))
parseObjectMembers fuel chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case skipJsonWs chars of
  [] => Err "unterminated object"
  c :: rest => case c of
    125 => Ok (Pair (reverse acc) rest)
    34 => parseObjectPair (fuel - 1) rest acc
    _ => Err "expected a string key in object"

parseObjectPair : Int -> List Int -> List (Pair String Json) -> Result (Pair (List (Pair String Json)) (List Int))
parseObjectPair fuel chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case parseStringBody (fuel - 1) chars [] of
  Err e => Err e
  Ok (Pair keyJson rest) => case skipJsonWs rest of
    [] => Err "unterminated object"
    c :: rest2 =>
      if c == 58 then parseObjectValue (fuel - 1) (jsonStrOr "" keyJson) (skipJsonWs rest2) acc
      else Err "expected : in object"

parseObjectValue : Int -> String -> List Int -> List (Pair String Json) -> Result (Pair (List (Pair String Json)) (List Int))
parseObjectValue fuel key chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case parseValue (fuel - 1) chars of
  Err e => Err e
  Ok (Pair v rest) => case skipJsonWs rest of
    [] => Err "unterminated object"
    c :: rest2 => case c of
      44 => parseObjectMembers (fuel - 1) rest2 (Pair key v :: acc)
      125 => Ok (Pair (reverse (Pair key v :: acc)) rest2)
      _ => Err "expected , or } in object"

parseArray : Int -> List Int -> Result (Pair Json (List Int))
parseArray fuel chars = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case parseArrayItems (fuel - 1) chars [] of
  Err e => Err e
  Ok (Pair items rest) => Ok (Pair (JArr items) rest)

parseArrayItems : Int -> List Int -> List Json -> Result (Pair (List Json) (List Int))
parseArrayItems fuel chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case skipJsonWs chars of
  [] => Err "unterminated array"
  c :: rest =>
    if c == 93 then Ok (Pair (reverse acc) rest) else parseArrayValue (fuel - 1) (c :: rest) acc

parseArrayValue : Int -> List Int -> List Json -> Result (Pair (List Json) (List Int))
parseArrayValue fuel chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case parseValue (fuel - 1) chars of
  Err e => Err e
  Ok (Pair v rest) => case skipJsonWs rest of
    [] => Err "unterminated array"
    c :: rest2 => case c of
      44 => parseArrayItems (fuel - 1) rest2 (v :: acc)
      93 => Ok (Pair (reverse (v :: acc)) rest2)
      _ => Err "expected , or ] in array"

-- 字符串体：起始引号已被消费；acc 是逆序字符。
parseStringBody : Int -> List Int -> List Int -> Result (Pair Json (List Int))
parseStringBody fuel chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case chars of
  [] => Err "unterminated string"
  c :: rest => case c of
    34 => Ok (Pair (JStr (strPack (reverse acc))) rest)
    92 => parseEscape (fuel - 1) rest acc
    _ => parseStringBody (fuel - 1) rest (c :: acc)

parseEscape : Int -> List Int -> List Int -> Result (Pair Json (List Int))
parseEscape fuel chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case chars of
  [] => Err "unterminated string"
  c :: rest => case c of
    34 => parseStringBody (fuel - 1) rest (34 :: acc)
    92 => parseStringBody (fuel - 1) rest (92 :: acc)
    47 => parseStringBody (fuel - 1) rest (47 :: acc)
    98 => parseStringBody (fuel - 1) rest (8 :: acc)
    102 => parseStringBody (fuel - 1) rest (12 :: acc)
    110 => parseStringBody (fuel - 1) rest (10 :: acc)
    114 => parseStringBody (fuel - 1) rest (13 :: acc)
    116 => parseStringBody (fuel - 1) rest (9 :: acc)
    117 => parseUnicodeEscape (fuel - 1) rest acc
    _ => Err ("invalid escape \\" ++ strPack [c])

parseUnicodeEscape : Int -> List Int -> List Int -> Result (Pair Json (List Int))
parseUnicodeEscape fuel chars acc = if fuel <= 0 then Err "json: parser fuel exhausted (internal)"
else case splitAtCharCount 4 chars of
  Nothing => Err "invalid \\u escape"
  Just (Pair digits rest) => case parseHex4 digits of
    Nothing => Err "invalid \\u escape"
    Just code => parseStringBody (fuel - 1) rest (append (reverse (encodeUtf8 code)) acc)

parseHex4 : List Int -> Maybe Int
parseHex4 digits = parseHex4Go digits 0 0

parseHex4Go : List Int -> Int -> Int -> Maybe Int
parseHex4Go [] code count = if count == 4 then Just code else Nothing
parseHex4Go (c :: rest) code count = case hexVal c of
  Nothing => Nothing
  Just d => parseHex4Go rest (code * 16 + d) (count + 1)

hexVal : Int -> Maybe Int
hexVal c =
  if c >= 48 && c <= 57 then Just (c - 48)
  else if c >= 97 && c <= 102 then Just (c - 87)
  else if c >= 65 && c <= 70 then Just (c - 55) else Nothing

-- UTF-8 编码（只处理 BMP；代理对不合并）。
encodeUtf8 : Int -> List Int
encodeUtf8 code =
  if code < 128 then [code]
  else if code < 2048 then [192 + code / 64, 128 + code - code / 64 * 64]
  else [224 + code / 4096, 128 + code / 64 - code / 4096 * 64, 128 + code - code / 64 * 64]

-- 数字：可选负号 + 整数部分；小数/指数被读取但截断（见模块头注释）。
parseNumber : List Int -> Result (Pair Json (List Int))
parseNumber chars = case signOf chars of
  Pair negative rest1 => case parseIntDigits rest1 0 0 of
    Pair value (Pair count rest2) => if count == 0 then Err "invalid number"
    else
      let
        signed = if negative then 0 - value else value
      in case skipNumberTail rest2 of
        Pair rest3 ok => if ok then Ok (Pair (JNum signed) rest3) else Err "invalid number"

signOf : List Int -> Pair Bool (List Int)
signOf (chars@(c :: rest)) = if c == 45 then Pair True rest else Pair False chars
signOf [] = Pair False []

-- 返回 (数值, (位数, 余下字符))。
parseIntDigits : List Int -> Int -> Int -> Pair Int (Pair Int (List Int))
parseIntDigits (c :: rest) acc count =
  if isDigitChar c then parseIntDigits rest (acc * 10 + (c - 48)) (count + 1)
  else Pair acc (Pair count (c :: rest))
parseIntDigits [] acc count = Pair acc (Pair count [])

-- 小数与指数：语法校验后丢弃（值保持整数）。
skipNumberTail : List Int -> Pair (List Int) Bool
skipNumberTail (chars@(c :: rest)) = if c == 46 then case parseIntDigits rest 0 0 of
  Pair value (Pair count rest2) => if count == 0 then Pair chars False else skipExponent rest2
else skipExponent chars
skipNumberTail [] = Pair [] True

skipExponent : List Int -> Pair (List Int) Bool
skipExponent (chars@(c :: rest)) = if c == 101 || c == 69 then
  let
    afterSign = case rest of
      s :: rest2 => if s == 43 || s == 45 then rest2 else rest
      [] => []
  in case parseIntDigits afterSign 0 0 of
    Pair value (Pair count rest3) => if count == 0 then Pair chars False else Pair rest3 True
else Pair chars True
skipExponent [] = Pair [] True

-- 取前 n 个字符；不足 n 个返回 Nothing。
splitAtCharCount : Int -> List Int -> Maybe (Pair (List Int) (List Int))
splitAtCharCount n chars = takeCount chars n []

takeCount : List Int -> Int -> List Int -> Maybe (Pair (List Int) (List Int))
takeCount chars n acc = if n <= 0 then Just (Pair (reverse acc) chars)
else case chars of
  [] => Nothing
  c :: rest => takeCount rest (n - 1) (c :: acc)
