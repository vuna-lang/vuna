module Vuna.Base (module Vuna.Pair, module Vuna.Bool, module Vuna.List, module Vuna.Maybe, module Vuna.Result, module Vuna.String, Pos, Span, posLine, posCol, spanFile, spanStartLine, spanStartCol, spanEndLine, spanEndCol, showSpanLoc, suggest, containsDot, splitOnDot, splitLastDot, joinDots, joinSlashes, joinArrows, splitPath, baseName) where

-- Vuna.Base：编译器门面（M11）。
-- 通用类型与 helper 的唯一真源已迁到 stdlib/（Vuna.Pair/Bool/List/Maybe/Result/String），
-- 这里整模块重导出，保持既有 `import Vuna.Base` 的模块零改动；
-- 只保留编译器专属的源码位置（Pos/Span）与模块路径/诊断工具。

import Vuna.Pair
import Vuna.Bool
import Vuna.List
import Vuna.Maybe
import Vuna.Result
import Vuna.String

-- 源码位置（行、列，均从 1 开始）。
data Pos : Type where
  Pos : Int -> Int -> Pos

-- 源码 span：文件、起始行列、结束行列。文件在解析时由调用方注入，
-- 供跨模块 flatten 后仍能追溯每个表达式来自哪个源文件。
data Span : Type where
  Span : String -> Int -> Int -> Int -> Int -> Span

posLine (Pos l c) = l

posCol (Pos l c) = c

spanFile (Span f sl sc el ec) = f

spanStartLine (Span f sl sc el ec) = sl

spanStartCol (Span f sl sc el ec) = sc

spanEndLine (Span f sl sc el ec) = el

spanEndCol (Span f sl sc el ec) = ec

-- 把 span 渲染成 `文件:行:列`（错误信息前缀）。
showSpanLoc (Span f sl sc el ec) = f ++ ":" ++ strFromInt sl ++ ":" ++ strFromInt sc

memChar : Int -> List Int -> Bool
memChar c chars =
  case chars of
    Nil => False
    Cons x rest => if x == c then True else memChar c rest

-- 模块路径工具：`A.B.C` 的拆分/拼接（编译器专属）。
containsDot : String -> Bool
containsDot s = memChar 46 (strUnpack s)

splitOnDot : String -> List String
splitOnDot s = splitCharsOnDot (strUnpack s) Nil Nil

splitCharsOnDot : List Int -> List String -> List Int -> List String
splitCharsOnDot chars acc seg =
  case chars of
    Nil => reverse (Cons (strPack (reverse seg)) acc)
    Cons c rest =>
      if c == 46 then splitCharsOnDot rest (Cons (strPack (reverse seg)) acc) Nil
      else splitCharsOnDot rest acc (Cons c seg)

splitLastDot : List String -> Pair (List String) String
splitLastDot parts =
  case reverse parts of
    Nil => Pair Nil ""
    Cons last rest => Pair (reverse rest) last

joinDots : List String -> String
joinDots Nil = ""
joinDots (Cons x Nil) = x
joinDots (Cons x rest) = x ++ "." ++ joinDots rest

joinSlashes : List String -> String
joinSlashes Nil = ""
joinSlashes (Cons x Nil) = x
joinSlashes (Cons x rest) = x ++ "/" ++ joinSlashes rest

joinArrows : List String -> String
joinArrows Nil = ""
joinArrows (Cons x Nil) = x
joinArrows (Cons x rest) = x ++ " -> " ++ joinArrows rest

-- 路径拆分：返回去掉最后一段的目录与最后一段（无 "/" 时目录为 ""）。
-- 编译器驱动（创建输出文件父目录）与 doc 共用，因此放在 Base 而不是工具模块。
splitPath : String -> Pair String String
splitPath path = splitPathChars (strUnpack path) Nil

splitPathChars Nil acc =
  let chars = reverse acc
  in Pair "" (strPack chars)

splitPathChars (Cons c rest) acc =
  if c == 47 then Pair (strPack (reverse acc)) (strPack rest) else splitPathChars rest (Cons c acc)

baseName : String -> String
baseName path = secondOf (splitPath path)

-- 候选建议：与出错名相似的名字（诊断）
suggest : String -> List String -> String
suggest name Nil = ""
suggest name (Cons c rest) =
  if _similarName name c then " (did you mean " ++ c ++ "?)" else suggest name rest

_similarName a b =
  if a == b then False
  else if startsWith a b then True
  else if startsWith b a then True
  else
    let la = strUnpack a
    in let lb = strUnpack b
       in lengthDiffLE (length la) (length lb) 2 && prefixLen2 la lb >= 2

prefixLen2 Nil _ = 0
prefixLen2 _ Nil = 0
prefixLen2 (Cons x xs) (Cons y ys) =
  if x == y then 1 + prefixLen2 xs ys else 0

lengthDiffLE la lb n =
  if la >= lb then la - lb <= n else lb - la <= n
