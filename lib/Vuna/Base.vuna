-- Vuna.Base：语言通用类型、列表/Result 辅助函数与字符串工具。

data Result a : Type where
  Ok : a -> Result a
  Err : String -> Result a

data Maybe a : Type where
  Nothing : Maybe a
  Just : a -> Maybe a

data List a : Type where
  Nil : List a
  Cons : a -> List a -> List a

data Pair a b : Type where
  Pair : a -> b -> Pair a b


data Bool : Type where
  False : Bool
  True : Bool

-- 源码位置（行、列，均从 1 开始）。
data Pos : Type where
  Pos : Int -> Int -> Pos

-- 源码 span：文件、起始行列、结束行列。文件在解析时由调用方注入，
-- 供跨模块 flatten 后仍能追溯每个表达式来自哪个源文件。
data Span : Type where
  Span : String -> Int -> Int -> Int -> Int -> Span

posLine (Pos l c) = l

posCol (Pos l c) = c

spanFile (Span f sl sc el ec) = f

spanStartLine (Span f sl sc el ec) = sl

spanStartCol (Span f sl sc el ec) = sc

spanEndLine (Span f sl sc el ec) = el

spanEndCol (Span f sl sc el ec) = ec

-- 把 span 渲染成 `文件:行:列`（错误信息前缀）。
showSpanLoc (Span f sl sc el ec) = f ++ ":" ++ strFromInt sl ++ ":" ++ strFromInt sc

append : List a -> List a -> List a
append Nil ys = ys
append (Cons x xs) ys = Cons x (append xs ys)

reverseOnto : List a -> List a -> List a
reverseOnto Nil acc = acc
reverseOnto (Cons x xs) acc = reverseOnto xs (Cons x acc)

reverse : List a -> List a
reverse xs = reverseOnto xs Nil

length : List a -> Int
length Nil = 0
length (Cons x xs) = 1 + length xs

map : (a -> b) -> List a -> List b
map f Nil = Nil
map f (Cons x xs) = Cons (f x) (map f xs)

traverse : (a -> Result b) -> List a -> Result (List b)
traverse f Nil = Ok Nil
traverse f (Cons x xs) =
  case f x of
    Err e => Err e
    Ok y =>
      case traverse f xs of
        Err e => Err e
        Ok ys => Ok (Cons y ys)

andThen : Result a -> (a -> Result b) -> Result b
andThen r f =
  case r of
    Ok x => f x
    Err e => Err e

step : Result (Pair a b) -> (a -> b -> Result c) -> Result c
step r k =
  case r of
    Ok (Pair x st) => k x st
    Err e => Err e


concatMap : (a -> List b) -> List a -> List b
concatMap f Nil = Nil
concatMap f (Cons x rest) = append (f x) (concatMap f rest)

memName : String -> List String -> Bool
memName name Nil = False
memName name (Cons x rest) = if x == name then True else memName name rest

lookupPair : String -> List (Pair String v) -> Maybe v
lookupPair name Nil = Nothing
lookupPair name (Cons (Pair k v) rest) =
  if k == name then Just v else lookupPair name rest

firstOf : Pair a b -> a
firstOf (Pair a b) = a

secondOf : Pair a b -> b
secondOf (Pair a b) = b

memChar : Int -> List Int -> Bool
memChar c chars =
  case chars of
    Nil => False
    Cons x rest => if x == c then True else memChar c rest

containsDot : String -> Bool
containsDot s = memChar 46 (strUnpack s)

startsWith : String -> String -> Bool
startsWith prefix text = startsWithChars (strUnpack prefix) (strUnpack text)

startsWithChars : List Int -> List Int -> Bool
startsWithChars Nil text = True
startsWithChars (Cons p prest) text =
  case text of
    Nil => False
    Cons t trest => if p == t then startsWithChars prest trest else False

splitOnDot : String -> List String
splitOnDot s = splitCharsOnDot (strUnpack s) Nil Nil

splitCharsOnDot : List Int -> List String -> List Int -> List String
splitCharsOnDot chars acc seg =
  case chars of
    Nil => reverse (Cons (strPack (reverse seg)) acc)
    Cons c rest =>
      if c == 46 then splitCharsOnDot rest (Cons (strPack (reverse seg)) acc) Nil
      else splitCharsOnDot rest acc (Cons c seg)

splitLastDot : List String -> Pair (List String) String
splitLastDot parts =
  case reverse parts of
    Nil => Pair Nil ""
    Cons last rest => Pair (reverse rest) last

joinDots : List String -> String
joinDots Nil = ""
joinDots (Cons x Nil) = x
joinDots (Cons x rest) = x ++ "." ++ joinDots rest

joinSlashes : List String -> String
joinSlashes Nil = ""
joinSlashes (Cons x Nil) = x
joinSlashes (Cons x rest) = x ++ "/" ++ joinSlashes rest

joinArrows : List String -> String
joinArrows Nil = ""
joinArrows (Cons x Nil) = x
joinArrows (Cons x rest) = x ++ " -> " ++ joinArrows rest

-- 候选建议：与出错名相似的名字（诊断）
suggest : String -> List String -> String
suggest name Nil = ""
suggest name (Cons c rest) =
  if similarName name c then " (did you mean " ++ c ++ "?)" else suggest name rest

similarName a b =
  if a == b then False
  else if startsWith a b then True
  else if startsWith b a then True
  else
    let la = strUnpack a
    in let lb = strUnpack b
       in lengthDiffLE (length la) (length lb) 2 && prefixLen2 la lb >= 2

prefixLen2 Nil _ = 0
prefixLen2 _ Nil = 0
prefixLen2 (Cons x xs) (Cons y ys) =
  if x == y then 1 + prefixLen2 xs ys else 0

lengthDiffLE la lb n =
  if la >= lb then la - lb <= n else lb - la <= n
