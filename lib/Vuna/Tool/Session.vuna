-- | 工具会话：把「节点 key + 依赖摘要」缓存成输入寻址对象。
module Vuna.Tool.Session where

-- Vuna.Tool.Session：LSP / REPL / `vuna map` 的**会话级**缓存。
--
-- 语义：一次成功的工作（工具接口 / 索引）由 `(origin, bucket, nodeKey, deps...)` 唯一确定；
-- 这个组合的摘要就是对象地址，存在即命中，不存在即重算后写回。没有 `Db`、没有查询图、
-- 没有依赖快照比较——跨进程天然一致，坏字节由 `Store` framing 拒绝。
--
-- 载荷分两类，同一 `objects/tool/` 空间：
--   * marker（空载荷，codec `tool-marker 1`）：命中但调用方手里已有记录（REPL 的）
--   * 载荷字节（各调用方自己的 codec，如 `indexPayloadCodec`）
-- 读侧 codec 不符 ⇒ `Nothing` ⇒ 调用方重算（marker 因此永远不会被当成载荷）。
import Base.HostRow
import Base.Eff
import Base.List
import Vuna.Compiler.Addr
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Store

-- | 工具会话身份：`origin`（tool/pkg）+ `bucket`（同一进程内不同用途各占一桶）。
export record ToolSession(..) where
  tsOrigin : String
  tsBucket : String

-- | 落盘会话（桶名决定对象寻址前缀）。
export toolSessionNew : String -> String -> ToolSession
toolSessionNew origin bucket = ToolSession origin bucket

-- | 只在内存里复用的会话（与落盘会话唯一的差别是桶名为空，地址仍稳定）。
export toolSessionNewMemory : String -> ToolSession
toolSessionNewMemory origin = ToolSession origin "mem"

-- | 会话对象地址：`(origin, bucket, key, deps...)` 的输入摘要。
export toolSessionAddrOf : ToolSession -> String -> List String -> String
toolSessionAddrOf ts key deps = addrOf (append ["tool-session", ts.tsOrigin, ts.tsBucket, key] deps)

-- marker 的 codec：空载荷（存在性即是全部信息）。
toolMarkerCodec : String
toolMarkerCodec = "tool-marker 1"

-- | 命中：返回对象地址（调用方拿它去读载荷；marker 读不出 ⇒ 按 miss 重算）。
export toolHitValue : ToolSession -> String -> List String -> Eff hostRow (Maybe (Maybe String))
toolHitValue ts key deps = do
  let
    addr = toolSessionAddrOf ts key deps
  in do
    exists <- storeObjectExistsEff "tool" addr
    pure (if exists then Just (Just addr) else Nothing)

-- | 提交 marker 节点（成功但载荷在调用方手里）。
export toolCommitValue : ToolSession -> String -> List String -> Eff hostRow ToolSession
toolCommitValue ts key deps = do
  _ <- storeObjectWriteEff "tool" toolMarkerCodec (toolSessionAddrOf ts key deps) ""
  pure ts

-- | 写载荷对象（同一输入同一地址；内容未变则不写盘），返回地址。
export toolStorePayload : ToolSession -> String -> List String -> String -> String -> Eff hostRow (Pair ToolSession String)
toolStorePayload ts key deps codec payload = do
  let
    addr = toolSessionAddrOf ts key deps
  in do
    _ <- storeObjectWriteEff "tool" codec addr payload
    pure (Pair ts addr)

-- | 读载荷（codec 不符 / 坏字节 ⇒ `Nothing` ⇒ 调用方重算）。
export toolLoadPayload : String -> String -> Eff hostRow (Maybe String)
toolLoadPayload addr codec = storeObjectReadEff "tool" codec addr
