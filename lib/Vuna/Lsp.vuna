module Vuna.Lsp (runLsp, runLspTool) where

-- Vuna.Lsp：LSP（Language Server Protocol）服务端（工具链模块，**永不进 seed 闭包**）。
--
-- 传输：JSON-RPC 2.0 over stdio，帧格式 `Content-Length: N\r\n\r\n<json>`。
--   - **stdout 只写协议帧**；日志统一走 stderr，且在内存里累积、退出时一次写出
--     （`writeFile "/dev/stderr"` 每次打开都会截断，逐行写会把前面的行冲掉）。
--   - stdin 只有行级内建（`readLine`，等价 OCaml `input_line`），没有字节级读。
--     读取层因此维护字节缓冲：每 `readLine` 一次就把「该行 + "\n"」并入缓冲，
--     这等价于逐字节重建输入（`input_line` 只剥掉 `\n`，行尾 `\r` 会保留），
--     所以按 `Content-Length` 截取正文是字节精确的。
--
-- 已实现：
--   initialize / initialized / shutdown / exit        生命周期
--   textDocument/didOpen, didChange, didClose         文档同步（Full 同步，kind = 1）
--   textDocument/publishDiagnostics（服务端 → 客户端）
--   textDocument/hover                                DT 洞（`_`）的目标类型与上下文
--   completion / definition / references / documentSymbol / formatting / codeAction /
--   workspace/symbol                                  显式返回空结果，避免客户端报错
--
-- 未实现（返回 JSON-RPC method not found）：rename、signatureHelp、codeLens、
--   semanticTokens、workspace/* 等；`$/` 开头的通知一律静默。
--
-- 诊断策略（不做包解析，M17 第一版的已知边界）：
--   1. `parseSource` 失败 ⇒ 一条 parse 诊断（parse 错误无位置，范围取 0:0-0:0）；
--   2. 文件含 `import` ⇒ 跳过类型检查，只保留 parse 诊断；
--   3. 否则 DT 精化（`elabProgramWith`）：错误 severity 1；
--      `<file>:<line>:<col>: msg` 的 1-based
--      位置转成 LSP 的 0-based 范围。
--
-- 洞目标：hover 跑 `goalsOfProgram`（DT 精化器），
-- 命中请求位置的洞时返回目标类型与绑定的上下文。可插拔点是 `dtGoalsOf`。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Elab
import Vuna.Json

-- ---------------------------------------------------------------
-- 常量
-- ---------------------------------------------------------------
lspServerName : String
lspServerName = "vuna-lsp"

lspServerVersion : String
lspServerVersion = "0.1.0"

-- LSP 的 TextDocumentSyncKind.Full = 1
syncKindFull : Int
syncKindFull = 1

-- DiagnosticSeverity：1 = Error、2 = Warning、3 = Information、4 = Hint
severityError : Int
severityError = 1

severityWarning : Int
severityWarning = 2

-- JSON-RPC 2.0 错误码
errMethodNotFound : Int
errMethodNotFound = 0 - 32601

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
maxInt : Int -> Int -> Int
maxInt a b = if a >= b then a else b

isDigitCode : Int -> Bool
isDigitCode c = c >= 48 && c <= 57

allDigitCodes : List Int -> Bool
allDigitCodes [] = True
allDigitCodes (c :: rest) = if isDigitCode c then allDigitCodes rest else False

allDigits : String -> Bool
allDigits s = s /= "" && allDigitCodes (strUnpack s)

parseIntFull : String -> Maybe Int
parseIntFull s = if allDigits s then Just (digitsToInt (strUnpack s) 0) else Nothing

digitsToInt : List Int -> Int -> Int
digitsToInt [] acc = acc
digitsToInt (c :: rest) acc = digitsToInt rest (acc * 10 + (c - 48))

asciiLower : String -> String
asciiLower s = strPack (map lowerCode (strUnpack s))

lowerCode : Int -> Int
lowerCode c = if c >= 65 && c <= 90 then c + 32 else c

isNilList : List a -> Bool
isNilList xs = case xs of
  [] => True
  _ => False

-- ---------------------------------------------------------------
-- JSON-RPC 帧／响应构造
-- ---------------------------------------------------------------
-- 发送一帧。Content-Length 是**字节**数：vuna 的 String 底层是 OCaml string，
-- `strLength` 即字节数（UTF-8 多字节字符也按字节计），与协议一致。
sendFrame : Json -> Int
sendFrame payload =
  let
    body = renderJson payload
  in print ("Content-Length: " ++ strFromInt (strLength body) ++ "\r\n\r\n" ++ body)

responseOk : Json -> Json -> Json
responseOk id body = JObj [Pair "jsonrpc" (JStr "2.0"), Pair "id" id, Pair "result" body]

responseErr : Json -> Int -> String -> Json
responseErr id code message =
  JObj
    [Pair "jsonrpc" (JStr "2.0"), Pair "id" id, Pair "error" (JObj [Pair "code" (JNum code), Pair "message" (JStr message)])]

notify : String -> Json -> Json
notify methodName params =
  JObj [Pair "jsonrpc" (JStr "2.0"), Pair "method" (JStr methodName), Pair "params" params]

-- ---------------------------------------------------------------
-- 位置换算：vuna 的 Span 从 1 开始，LSP 从 0 开始
-- ---------------------------------------------------------------
lspPosition : Int -> Int -> Json
lspPosition line col =
  JObj [Pair "line" (JNum (maxInt 0 (line - 1))), Pair "character" (JNum (maxInt 0 (col - 1)))]

lspRange : Int -> Int -> Int -> Int -> Json
lspRange sl sc el ec = JObj [Pair "start" (lspPosition sl sc), Pair "end" (lspPosition el ec)]

-- ---------------------------------------------------------------
-- 诊断
-- ---------------------------------------------------------------
data Diag : Type where
  Diag : Int -> Int -> Int -> Int -> Int -> String -> Diag

diagStartLine : Diag -> Int
diagStartLine (Diag sl sc el ec sev msg) = sl

diagStartCol : Diag -> Int
diagStartCol (Diag sl sc el ec sev msg) = sc

diagEndLine : Diag -> Int
diagEndLine (Diag sl sc el ec sev msg) = el

diagEndCol : Diag -> Int
diagEndCol (Diag sl sc el ec sev msg) = ec

diagSeverity : Diag -> Int
diagSeverity (Diag sl sc el ec sev msg) = sev

diagMessage : Diag -> String
diagMessage (Diag sl sc el ec sev msg) = msg

diagJson : Diag -> Json
diagJson d =
  JObj
    [Pair "range" (lspRange (diagStartLine d) (diagStartCol d) (diagEndLine d) (diagEndCol d)), Pair "severity" (JNum (diagSeverity d)), Pair "source" (JStr "vuna"), Pair "message" (JStr (diagMessage d))]

-- 编译器的错误/警告串形如 `<file>:<line>:<col>: <msg>`；file 本身可能含冒号
-- （例如 URI `file:///x.vuna:2:7: ...`）。所以扫描第一个「连续两段都是数字」的位置，
-- 而不是取头两段。识别不出来就当无位置（0,0）。
splitLoc : String -> Pair Int (Pair Int String)
splitLoc message = case scanLoc (split ":" message) of
  Nothing => Pair 0 (Pair 0 message)
  Just loc => loc

scanLoc : List String -> Maybe (Pair Int (Pair Int String))
scanLoc segs = case segs of
  a :: b :: rest =>
    if allDigits a && allDigits b then Just
      (Pair (digitsToInt (strUnpack a) 0) (Pair (digitsToInt (strUnpack b) 0) (trim (join ":" rest))))
    else scanLoc (b :: rest)
  _ => Nothing

diagOfMessage : Int -> String -> Diag
diagOfMessage severity message =
  let
    loc = splitLoc message
    line = firstOf loc
    rest = secondOf loc
  in if line <= 0 then Diag 0 0 0 0 severity message
  else Diag line (firstOf rest) line (firstOf rest) severity (secondOf rest)

-- 单文件诊断。有 import 时只做 parse 级检查（见模块头注释第 2 条）。
diagnosticsFor : String -> String -> List Diag
diagnosticsFor uri text = case parseSource uri text of
  Err e => [Diag 0 0 0 0 severityError e]
  Ok (Source hdr imports decls) => if isNilList imports then case elabProgramWith False decls of
    Err e => [diagOfMessage severityError e]
    Ok _ => []
  else []

publishDiagnostics : String -> Int -> List Diag -> Json
publishDiagnostics uri version diags =
  notify "textDocument/publishDiagnostics"
    (JObj [Pair "uri" (JStr uri), Pair "version" (JNum version), Pair "diagnostics" (JArr (map diagJson diags))])

-- ---------------------------------------------------------------
-- 打开的文档表
-- ---------------------------------------------------------------
data Doc : Type where
  Doc : String -> Int -> String -> Doc

docUri : Doc -> String
docUri (Doc uri version text) = uri

docVersion : Doc -> Int
docVersion (Doc uri version text) = version

docText : Doc -> String
docText (Doc uri version text) = text

docLookup : String -> List Doc -> Maybe Doc
docLookup uri [] = Nothing
docLookup uri (d :: rest) = if docUri d == uri then Just d else docLookup uri rest

docSet : Doc -> List Doc -> List Doc
docSet d [] = [d]
docSet d (x :: rest) = if docUri x == docUri d then d :: rest else x :: docSet d rest

docRemove : String -> List Doc -> List Doc
docRemove uri [] = []
docRemove uri (x :: rest) = if docUri x == uri then docRemove uri rest else x :: docRemove uri rest

-- ---------------------------------------------------------------
-- hover：DT 洞目标
-- ---------------------------------------------------------------
-- 可插拔点：DT 前端接口若变化，只需改这里。
dtGoalsOf : String -> Result (List DtGoalInfo)
dtGoalsOf text = case parseSource "<hover>" text of
  Err e => Err e
  Ok (Source hdr imports decls) => goalsOfProgram decls

ctxLine : Pair String String -> String
ctxLine kv = "- `" ++ firstOf kv ++ "` : " ++ secondOf kv ++ "\n"

contextBlock : List (Pair String String) -> String
contextBlock [] = ""
contextBlock ctx = "\nContext:\n" ++ join "" (map ctxLine ctx)

goalContents : DtGoalInfo -> Json
goalContents g =
  JObj
    [Pair "kind" (JStr "markdown"), Pair "value" (JStr ("```vuna\n" ++ dtGoalInfoGoal g ++ "\n```\n" ++ contextBlock (dtGoalInfoCtx g)))]

holeContains : Int -> Int -> DtGoalInfo -> Bool
holeContains line col g =
  let
    sp = dtGoalInfoSpan g
    sl = spanStartLine sp
    sc = spanStartCol sp
    el = spanEndLine sp
    ec = spanEndCol sp
  in if line < sl || line > el then False
  else if line == sl && col < sc then False else if line == el && col > ec then False else True

holeAt : Int -> Int -> List DtGoalInfo -> Maybe DtGoalInfo
holeAt line col [] = Nothing
holeAt line col (g :: rest) = if holeContains line col g then Just g else holeAt line col rest

-- line/col 是 1-based（vuna 口径）。
hoverFor : Int -> Int -> String -> Maybe Json
hoverFor line col text = case dtGoalsOf text of
  Err e => Nothing
  Ok goals => case holeAt line col goals of
    Nothing => Nothing
    Just g =>
      let
        sp = dtGoalInfoSpan g
      in Just
        (JObj [Pair "contents" (goalContents g), Pair "range" (lspRange (spanStartLine sp) (spanStartCol sp) (spanEndLine sp) (spanEndCol sp))])

-- ---------------------------------------------------------------
-- 服务器状态
-- ---------------------------------------------------------------
-- docs：打开的文档（按 uri 去重）；shutdownReq：是否收到 shutdown；
-- logs：待写 stderr 的日志（逆序累积）。
data LspState : Type where
  LspState : List Doc -> Bool -> List String -> LspState

stateDocs : LspState -> List Doc
stateDocs (LspState docs shutdownReq logs) = docs

stateShutdown : LspState -> Bool
stateShutdown (LspState docs shutdownReq logs) = shutdownReq

stateLogs : LspState -> List String
stateLogs (LspState docs shutdownReq logs) = logs

setDocs : List Doc -> LspState -> LspState
setDocs docs (LspState _ s logs) = LspState docs s logs

setShutdown : Bool -> LspState -> LspState
setShutdown s (LspState docs _ logs) = LspState docs s logs

logTo : String -> LspState -> LspState
logTo line (LspState docs s logs) = LspState docs s (line :: logs)

logLine : String -> String
logLine s = "[vuna-lsp] " ++ s ++ "\n"

-- 退出时一次写出（避免 /dev/stderr 被反复截断）。
flushLogs : LspState -> Int
flushLogs st = case stateLogs st of
  [] => 0
  logs => writeFile "/dev/stderr" (join "" (map logLine (reverse logs)))

-- ---------------------------------------------------------------
-- capabilities
-- ---------------------------------------------------------------
serverCapabilities : Json
serverCapabilities =
  JObj
    [Pair "textDocumentSync" (JObj [Pair "openClose" (JBool True), Pair "change" (JNum syncKindFull)]), Pair "hoverProvider" (JBool True)]

-- ---------------------------------------------------------------
-- 请求分发
-- ---------------------------------------------------------------
paramsOf : Json -> Json
paramsOf msg = fromMaybe (JObj []) (jsonGet "params" msg)

idOf : Json -> Json
idOf msg = fromMaybe JNull (jsonGet "id" msg)

uriOfParams : Json -> String
uriOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "uri"] params >>= jsonAsStr)

versionOfParams : Json -> Int
versionOfParams params = fromMaybe 0 (jsonGetIn ["textDocument", "version"] params >>= jsonAsInt)

textOfParams : Json -> String
textOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "text"] params >>= jsonAsStr)

lastJson : List Json -> Maybe Json
lastJson [] = Nothing
lastJson (x :: rest) = case rest of
  [] => Just x
  _ => lastJson rest

-- Full 同步：取 contentChanges 最后一个 text。
changedText : Json -> String
changedText params = case jsonGetIn ["contentChanges"] params >>= jsonAsArr of
  Nothing => ""
  Just changes => case lastJson changes of
    Nothing => ""
    Just change => jsonStrOr "" (fromMaybe JNull (jsonGet "text" change))

initializeResult : Json -> Json
initializeResult msg =
  responseOk (idOf msg)
    (JObj [Pair "capabilities" serverCapabilities, Pair "serverInfo" (JObj [Pair "name" (JStr lspServerName), Pair "version" (JStr lspServerVersion)])])

-- didOpen：登记文档并推诊断。
handleDidOpen : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDidOpen msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    version = versionOfParams params
    text = textOfParams params
    docs = docSet (Doc uri version text) (stateDocs state)
  in Pair False (Pair (setDocs docs state) [publishDiagnostics uri version (diagnosticsFor uri text)])

-- didChange（Full 同步）：覆盖全文并重推诊断。
handleDidChange : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDidChange msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    version = versionOfParams params
    text = changedText params
    docs = docSet (Doc uri version text) (stateDocs state)
  in Pair False (Pair (setDocs docs state) [publishDiagnostics uri version (diagnosticsFor uri text)])

-- didClose：移除文档并清空诊断。
handleDidClose : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDidClose msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    docs = docRemove uri (stateDocs state)
  in Pair False (Pair (setDocs docs state) [publishDiagnostics uri 0 []])

-- hover：从打开的文档表取文本，按 1-based 位置查洞目标。
handleHover : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleHover msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = fromMaybe 0 (jsonGetIn ["position", "line"] params >>= jsonAsInt)
    col = fromMaybe 0 (jsonGetIn ["position", "character"] params >>= jsonAsInt)
    text = case docLookup uri (stateDocs state) of
      Just d => docText d
      Nothing => ""
    hover = hoverFor (line + 1) (col + 1) text
  in Pair False (Pair state [responseOk (idOf msg) (fromMaybe JNull hover)])

-- 处理一帧。返回 (是否退出, 新状态, 待发送帧)。
handleFrame : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleFrame msg state = case jsonGet "method" msg of
  Nothing => Pair False (Pair state []) -- 客户端对我们请求的响应：忽略
  Just m => case jsonAsStr m of
    Nothing => Pair False (Pair state [])
    Just methodName => dispatch methodName msg state

dispatch : String -> Json -> LspState -> Pair Bool (Pair LspState (List Json))
dispatch methodName msg state = case methodName of
  "initialize" => Pair False (Pair state [initializeResult msg])
  "initialized" => Pair False (Pair state [])
  "shutdown" => Pair False (Pair (setShutdown True state) [responseOk (idOf msg) JNull])
  "exit" => Pair True (Pair state [])
  "textDocument/didOpen" => handleDidOpen msg state
  "textDocument/didChange" => handleDidChange msg state
  "textDocument/didClose" => handleDidClose msg state
  "textDocument/hover" => handleHover msg state
  "textDocument/completion" => Pair False (Pair state [responseOk (idOf msg) (JArr [])])
  "textDocument/definition" => Pair False (Pair state [responseOk (idOf msg) JNull])
  "textDocument/references" => Pair False (Pair state [responseOk (idOf msg) (JArr [])])
  "textDocument/documentSymbol" => Pair False (Pair state [responseOk (idOf msg) (JArr [])])
  "textDocument/formatting" => Pair False (Pair state [responseOk (idOf msg) (JArr [])])
  "textDocument/codeAction" => Pair False (Pair state [responseOk (idOf msg) (JArr [])])
  "workspace/symbol" => Pair False (Pair state [responseOk (idOf msg) (JArr [])])
  "$/cancelRequest" => Pair False (Pair state [])
  _ =>
    if startsWith "$/" methodName then Pair False (Pair state [])
    else Pair False
      (Pair state [responseErr (idOf msg) errMethodNotFound ("method not found: " ++ methodName)])

-- ---------------------------------------------------------------
-- 帧读取：字节缓冲 + 按 Content-Length 切帧
-- ---------------------------------------------------------------
-- 从 stdin 再读一行并入缓冲；Nothing = EOF。
--
-- 难点：`readLine` 在 EOF 返回 ""，与「真正的空行」无法区分。而 **LF-only 帧**
-- （client 用 `\n` 分隔 header）的 header 结束符正好是一个空行，必须保留它的
-- `\n` 才能被 splitHeaders 识别成 `\n\n`。所以这里做一次 lookahead：
--   - 读到非空行 ⇒ 直接并入「行 + "\n"」；
--   - 读到空行  ⇒ 再读一行：又空 ⇒ 判定 EOF；非空 ⇒ 前一个空行是真的空行，
--                 并入 "\n" 与这一行。
-- CRLF 帧不受影响：`input_line` 只剥 `\n`，空行读到的是 "\r" 而不是 ""，
-- 走非空分支，于是缓冲里自然得到 `\r\n\r\n`。
readMore : String -> Maybe String
readMore pending =
  let
    line = readLine
  in if line /= "" then Just (pending ++ line ++ "\n")
  else
    let
      next = readLine
    in if next == "" then Nothing else Just (pending ++ "\n" ++ next ++ "\n")

-- 找子串 needle 从 start 起的字节偏移；找不到返回 -1。
findFrom : String -> Int -> String -> Int
findFrom needle start hay =
  if start + strLength needle > strLength hay then 0 - 1
  else if substring start (strLength needle) hay == needle then start
  else findFrom needle (start + 1) hay

crlfCrlf : String
crlfCrlf = strPack [13, 10, 13, 10]

lfLf : String
lfLf = strPack [10, 10]

cutHeaders : Int -> String -> Int -> Pair String String
cutHeaders at buf gap =
  Pair (substring 0 at buf) (substring (at + gap) (strLength buf - at - gap) buf)

-- 切出 header 块（到第一个 `\r\n\r\n` 或 `\n\n`），返回 (header 块, 之后的缓冲)。
splitHeaders : String -> Maybe (Pair String String)
splitHeaders buf = case findFrom crlfCrlf 0 buf of
  hit => if hit >= 0 then Just (cutHeaders hit buf 4) else splitHeadersLf buf

splitHeadersLf : String -> Maybe (Pair String String)
splitHeadersLf buf = case findFrom lfLf 0 buf of
  hit => if hit >= 0 then Just (cutHeaders hit buf 2) else Nothing

-- `Content-Length: 123`（大小写不敏感，容忍前后空白与行尾 \r）。
parseContentLength : String -> Maybe Int
parseContentLength line =
  let
    trimmed = trim line
  in if startsWith "content-length:" (asciiLower trimmed) then parseIntFull (trim (substring 15 (strLength trimmed - 15) trimmed))
  else Nothing

findLengthLine : List String -> Maybe Int
findLengthLine [] = Nothing
findLengthLine (line :: rest) = case parseContentLength line of
  Just n => Just n
  Nothing => findLengthLine rest

contentLengthOf : String -> Maybe Int
contentLengthOf block = case findLengthLine (split "\n" block) of
  Nothing => Nothing
  Just n => if n > 0 then Just n else Nothing

-- 尝试切一帧：Just (body, rest)；Nothing = 缓冲里还没有完整帧。
nextFrame : String -> Maybe (Pair String String)
nextFrame pending = case splitHeaders pending of
  Nothing => Nothing
  Just (Pair headerBlock afterHeaders) => case contentLengthOf headerBlock of
    Nothing => Nothing
    Just len =>
      if strLength afterHeaders < len then Nothing
      else Just
        (Pair (substring 0 len afterHeaders) (substring len (strLength afterHeaders - len) afterHeaders))

-- ---------------------------------------------------------------
-- 主循环
-- ---------------------------------------------------------------
-- 返回值即进程退出码：收到 shutdown 后的 exit 退 0，否则退 1（LSP 约定）。
lspLoop : String -> LspState -> Int
lspLoop pending state = case nextFrame pending of
  Nothing => case readMore pending of
    -- EOF 且从未收到 shutdown ⇒ 非正常断开，退 1。
    -- 注意 flushLogs 返回的是写入字节数，不能直接当退出码。
    Nothing => abnormalExit (logTo "input closed" state)
    Just pending2 => lspLoop pending2 state
  Just (Pair body rest) => case parseJson body of
    Err e => lspLoop rest (logTo ("malformed frame: " ++ e) state)
    Ok msg =>
      let
        result = handleFrame msg state
        shouldExit = firstOf result
        after = secondOf result
        state2 = firstOf after
        frames = secondOf after
        _ = map sendFrame frames
      in if shouldExit then exitCodeOf state2 else lspLoop rest state2

-- exit 之前是否收到过 shutdown。
exitCodeOf : LspState -> Int
exitCodeOf state =
  let
    _ = flushLogs state
  in if stateShutdown state then 0 else 1

-- 非正常结束（stdin EOF / 空输入）：flush 日志后一律退 1，
-- 不能把 flushLogs 的「写入字节数」当退出码。
abnormalExit : LspState -> Int
abnormalExit state =
  let
    _ = flushLogs state
  in 1

runLsp : Int
runLsp = lspLoop "" (logTo "starting" (LspState [] False []))

-- CLI 入口：与其它工具命令一致，返回退出码（由 Vuna.Cli 插入分发）。
runLspTool : List String -> Int
runLspTool args = runLsp
