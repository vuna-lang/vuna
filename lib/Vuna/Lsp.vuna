module Vuna.Lsp (runLsp, runLspTool) where

-- Vuna.Lsp：LSP 服务器门面（工具链模块，**永不进 seed 闭包**）。
--
-- 传输/URI/帧在 `Vuna.Lsp.Protocol`，诊断链在 `Vuna.Lsp.Diagnostics`，各查询方法在
-- `Vuna.Lsp.Query`；本模块只保留**服务器状态机**：
--   initialize / initialized / shutdown / exit、textDocument/didOpen|didChange|didClose
--   （Full 同步，kind = 1）、capabilities、请求分发与 stdin 字节帧循环。
-- `runLsp` / `runLspTool` 是 CLI 入口（由 Vuna.Cli 插入分发）。
--
-- 协议约束：**stdout 只写协议帧**；日志走 stderr（内存累积、退出时一次写出）。
-- 读取按 `Content-Length` 精确切字节（`readChunk`），**不能按行读**：标准 LSP 帧的
-- body 后面没有换行，客户端在拿到响应前也不发下一帧，行级读会在 `initialize` 就互等死锁。
-- 退出码：收到 shutdown 后的 exit 退 0，否则（EOF / 未 shutdown）退 1。
--
-- 服务器状态：打开的文档表、惰性 Index（一次构建并缓存）、日志缓冲。
-- 已知边界：
--   - didChange 跑一次完整 DT 精化，大文件逐个按键变更可能较慢（客户端可降级为保存时检查）；
--   - 编辑**未保存的依赖模块**时，精化仍从磁盘读依赖（LSP 只覆盖当前文档）；
--   - Index 只反映磁盘内容、不随 didChange 刷新；构建失败则相关方法退化返回空结果；
--   - 首次索引查找可能触发 `.local/index/` 全量重建（仓库级秒级），期间请求排队；
--   - 多根 workspace 未支持：workspace/symbol 用首个打开文档推断工作区根。
import Vuna.Compiler.Common
import Vuna.Index
import Vuna.Json
import Vuna.Lsp.Diagnostics
import Vuna.Lsp.Protocol
import Vuna.Lsp.Query

-- ---------------------------------------------------------------
-- 常量
-- ---------------------------------------------------------------
lspServerName : String
lspServerName = "vuna-lsp"

lspServerVersion : String
lspServerVersion = "0.2.1"

-- LSP 的 TextDocumentSyncKind.Full = 1
syncKindFull : Int
syncKindFull = 1

-- 每次 readChunk 的字节数（帧 body 可能跨多块；缓冲里拼够 Content-Length 再切帧）。
readChunkSize : Int
readChunkSize = 65536

-- 单帧 / 缓冲上界：坏客户端不能把内存撑爆（正常源文件帧远小于此）。
maxFrameBytes : Int
maxFrameBytes = 16777216

-- JSON-RPC 2.0 错误码
errMethodNotFound : Int
errMethodNotFound = 0 - 32601

-- 打开的文档表
-- ---------------------------------------------------------------
data Doc : Type where
  Doc : String -> Int -> String -> Doc

docUri : Doc -> String
docUri (Doc uri version text) = uri

docVersion : Doc -> Int
docVersion (Doc uri version text) = version

docText : Doc -> String
docText (Doc uri version text) = text

docLookup : String -> List Doc -> Maybe Doc
docLookup uri [] = Nothing
docLookup uri (d :: rest) = if docUri d == uri then Just d else docLookup uri rest

docSet : Doc -> List Doc -> List Doc
docSet d [] = [d]
docSet d (x :: rest) = if docUri x == docUri d then d :: rest else x :: docSet d rest

docRemove : String -> List Doc -> List Doc
docRemove uri [] = []
docRemove uri (x :: rest) = if docUri x == uri then docRemove uri rest else x :: docRemove uri rest

-- ---------------------------------------------------------------
-- 服务器状态
-- ---------------------------------------------------------------
-- docs：打开的文档（按 uri 去重）；shutdownReq：是否收到 shutdown；
-- index：惰性构建的索引（Nothing = 尚未成功构建）；indexTried：是否尝试过构建；
-- rootHint：第一个打开的文档 uri（workspace/symbol 没有 textDocument，用它推断工作区根；
-- 多根 workspace 未支持，取首个文档）；logs：待写 stderr 的日志（逆序累积）。
data LspState : Type where
  LspState : List Doc -> Bool -> Maybe Index -> Bool -> Maybe String -> List String -> LspState

stateDocs : LspState -> List Doc
stateDocs (LspState docs shutdownReq index tried rootHint logs) = docs

stateShutdown : LspState -> Bool
stateShutdown (LspState docs shutdownReq index tried rootHint logs) = shutdownReq

stateIndex : LspState -> Maybe Index
stateIndex (LspState docs shutdownReq index tried rootHint logs) = index

stateIndexTried : LspState -> Bool
stateIndexTried (LspState docs shutdownReq index tried rootHint logs) = tried

stateRootHint : LspState -> Maybe String
stateRootHint (LspState docs shutdownReq index tried rootHint logs) = rootHint

stateLogs : LspState -> List String
stateLogs (LspState docs shutdownReq index tried rootHint logs) = logs

setDocs : List Doc -> LspState -> LspState
setDocs docs (LspState _ s idx tried hint logs) = LspState docs s idx tried hint logs

setShutdown : Bool -> LspState -> LspState
setShutdown s (LspState docs _ idx tried hint logs) = LspState docs s idx tried hint logs

setIndex : Maybe Index -> LspState -> LspState
setIndex idx (LspState docs s _ tried hint logs) = LspState docs s idx tried hint logs

setIndexTried : Bool -> LspState -> LspState
setIndexTried tried (LspState docs s idx _ hint logs) = LspState docs s idx tried hint logs

setRootHintIfEmpty : String -> LspState -> LspState
setRootHintIfEmpty hint (LspState docs s idx tried (existing@(Just prev)) logs) =
  LspState docs s idx tried existing logs
setRootHintIfEmpty hint (LspState docs s idx tried Nothing logs) =
  LspState docs s idx tried (Just hint) logs

logTo : String -> LspState -> LspState
logTo line (LspState docs s idx tried hint logs) = LspState docs s idx tried hint (line :: logs)

-- 退出时一次写出（内存累积的日志，见 Protocol.flushLogLines）。
flushLogs : LspState -> Int
flushLogs st = flushLogLines (stateLogs st)

-- 首次需要索引时构建；失败一次后不再重试（避免每个请求都全量扫描磁盘）。
ensureIndex : String -> LspState -> Pair LspState (Maybe Index)
ensureIndex uri st = case stateIndex st of
  Just idx => Pair st (Just idx)
  Nothing => if stateIndexTried st then Pair st Nothing
  else
    let
      root = workspaceRoot uri
    in case loadOrBuild root of
      Ok idx =>
        let
          st1 = logTo ("index ready: " ++ root) (setIndexTried True (setIndex (Just idx) st))
        in Pair st1 (Just idx)
      Err e =>
        let
          st1 = logTo ("index unavailable: " ++ e) (setIndexTried True st)
        in Pair st1 Nothing

-- 打开的文档文本（未打开 → ""）。
textForUri : String -> LspState -> String
textForUri uri st = case docLookup uri (stateDocs st) of
  Nothing => ""
  Just d => docText d

-- ---------------------------------------------------------------
-- capabilities（M30 P2：全套）
-- ---------------------------------------------------------------
serverCapabilities : Json
serverCapabilities =
  JObj
    [Pair "textDocumentSync" (JObj [Pair "openClose" (JBool True), Pair "change" (JNum syncKindFull)]), Pair "completionProvider" (JObj [Pair "triggerCharacters" (JArr [JStr "."]), Pair "resolveProvider" (JBool False)]), Pair "definitionProvider" (JBool True), Pair "referencesProvider" (JBool True), Pair "documentSymbolProvider" (JBool True), Pair "documentFormattingProvider" (JBool True), Pair "workspaceSymbolProvider" (JBool True), Pair "hoverProvider" (JBool True), Pair "codeActionProvider" (JBool True)]

-- ---------------------------------------------------------------
-- 请求分发
-- ---------------------------------------------------------------
paramsOf : Json -> Json
paramsOf msg = fromMaybe (JObj []) (jsonGet "params" msg)

idOf : Json -> Json
idOf msg = fromMaybe JNull (jsonGet "id" msg)

uriOfParams : Json -> String
uriOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "uri"] params >>= jsonAsStr)

versionOfParams : Json -> Int
versionOfParams params = fromMaybe 0 (jsonGetIn ["textDocument", "version"] params >>= jsonAsInt)

textOfParams : Json -> String
textOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "text"] params >>= jsonAsStr)

lineOfParams : Json -> Int
lineOfParams params = fromMaybe 0 (jsonGetIn ["position", "line"] params >>= jsonAsInt)

colOfParams : Json -> Int
colOfParams params = fromMaybe 0 (jsonGetIn ["position", "character"] params >>= jsonAsInt)

lastJson : List Json -> Maybe Json
lastJson [] = Nothing
lastJson (x :: rest) = case rest of
  [] => Just x
  _ => lastJson rest

-- Full 同步：取 contentChanges 最后一个 text。
changedText : Json -> String
changedText params = case jsonGetIn ["contentChanges"] params >>= jsonAsArr of
  Nothing => ""
  Just changes => case lastJson changes of
    Nothing => ""
    Just change => jsonStrOr "" (fromMaybe JNull (jsonGet "text" change))

initializeResult : Json -> Json
initializeResult msg =
  responseOk (idOf msg)
    (JObj [Pair "capabilities" serverCapabilities, Pair "serverInfo" (JObj [Pair "name" (JStr lspServerName), Pair "version" (JStr lspServerVersion)])])

-- didOpen：登记文档并推诊断。
handleDidOpen : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDidOpen msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    version = versionOfParams params
    text = textOfParams params
    docs = docSet (Doc uri version text) (stateDocs state)
  in Pair False
    (Pair (setRootHintIfEmpty uri (setDocs docs state)) [publishDiagnosticsFor uri version text])

-- didChange（Full 同步）：覆盖全文并重推诊断。
handleDidChange : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDidChange msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    oldVersion = case docLookup uri (stateDocs state) of
      Nothing => 0
      Just d => docVersion d
    version = case jsonGetIn ["textDocument", "version"] params >>= jsonAsInt of
      Nothing => oldVersion
      Just v => v
    text = changedText params
    docs = docSet (Doc uri version text) (stateDocs state)
  in Pair False (Pair (setDocs docs state) [publishDiagnosticsFor uri version text])

-- didClose：移除文档并清空诊断。
handleDidClose : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDidClose msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    docs = docRemove uri (stateDocs state)
  in Pair False (Pair (setDocs docs state) [publishDiagnosticsFor uri 0 ""])

-- hover：先查洞目标（包上下文），未命中再查标识符签名/注释。
handleHover : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleHover msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in case holeHoverAt uri line col text of
    Just hover => Pair False (Pair state [responseOk (idOf msg) hover])
    Nothing =>
      let
        indexPair = ensureIndex uri state
        state1 = firstOf indexPair
        midx = secondOf indexPair
      in Pair False (Pair state1 [responseOk (idOf msg) (symbolHoverResult uri line col text midx)])

-- formatting：formatSource 成功且内容变化 ⇒ 全文 TextEdit；否则 []。
handleFormatting : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleFormatting msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in Pair False (Pair state [responseOk (idOf msg) (JArr (formattingEdits text))])

-- documentSymbol：当前缓冲的 AST 声明树（不要求磁盘上存在）。
handleDocumentSymbol : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDocumentSymbol msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in Pair False (Pair state [responseOk (idOf msg) (JArr (documentSymbols uri text))])

-- definition：光标 token → Index 符号 → Location；Index 不可用时同文件兜底。
handleDefinition : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDefinition msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
    indexPair = ensureIndex uri state
    state1 = firstOf indexPair
    midx = secondOf indexPair
  in Pair False (Pair state1 [responseOk (idOf msg) (definitionResult uri line col text midx)])

-- references：定义位置 + Index refs 的出现位置。
handleReferences : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleReferences msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
    indexPair = ensureIndex uri state
    state1 = firstOf indexPair
    midx = secondOf indexPair
  in Pair False (Pair state1 [responseOk (idOf msg) (JArr (referencesResult uri line col text midx))])

-- completion：关键字 + 当前缓冲顶层名 + Index 符号；`.` 后按模块过滤。
handleCompletion : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleCompletion msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params
    col = colOfParams params
    text = textForUri uri state
    indexPair = ensureIndex uri state
    state1 = firstOf indexPair
    midx = secondOf indexPair
  in Pair False (Pair state1 [responseOk (idOf msg) (JArr (completionItems text line col midx))])

-- workspace/symbol：Index 过滤（空 query = 全部，上限 200）。
handleWorkspaceSymbol : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleWorkspaceSymbol msg state =
  let
    params = paramsOf msg
    query = fromMaybe "" (jsonGet "query" params >>= jsonAsStr)
    hint = fromMaybe "" (stateRootHint state)
    indexPair = ensureIndex hint state
    state1 = firstOf indexPair
    midx = secondOf indexPair
  in Pair False (Pair state1 [responseOk (idOf msg) (JArr (workspaceSymbols midx query))])

-- 处理一帧。返回 (是否退出, 新状态, 待发送帧)。
handleFrame : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleFrame msg state = case jsonGet "method" msg of
  Nothing => Pair False (Pair state []) -- 客户端对我们请求的响应：忽略
  Just m => case jsonAsStr m of
    Nothing => Pair False (Pair state [])
    Just methodName => dispatch methodName msg state

dispatch : String -> Json -> LspState -> Pair Bool (Pair LspState (List Json))
dispatch "initialize" msg state = Pair False (Pair state [initializeResult msg])
dispatch "initialized" msg state = Pair False (Pair state [])
dispatch "shutdown" msg state =
  Pair False (Pair (setShutdown True state) [responseOk (idOf msg) JNull])
dispatch "exit" msg state = Pair True (Pair state [])
dispatch "textDocument/didOpen" msg state = handleDidOpen msg state
dispatch "textDocument/didChange" msg state = handleDidChange msg state
dispatch "textDocument/didClose" msg state = handleDidClose msg state
dispatch "textDocument/hover" msg state = handleHover msg state
dispatch "textDocument/completion" msg state = handleCompletion msg state
dispatch "textDocument/definition" msg state = handleDefinition msg state
dispatch "textDocument/references" msg state = handleReferences msg state
dispatch "textDocument/documentSymbol" msg state = handleDocumentSymbol msg state
dispatch "textDocument/formatting" msg state = handleFormatting msg state
dispatch "textDocument/codeAction" msg state =
  Pair False (Pair state [responseOk (idOf msg) (JArr [])])
dispatch "workspace/symbol" msg state = handleWorkspaceSymbol msg state
-- 客户端能力注册（vscode-languageclient 的 fileEvents 等）：服务器不消费这些注册，
-- 但必须回成功，否则客户端会把「注册失败」当成错误刷日志。
dispatch "client/registerCapability" msg state =
  Pair False (Pair state [responseOk (idOf msg) JNull])
dispatch "client/unregisterCapability" msg state =
  Pair False (Pair state [responseOk (idOf msg) JNull])
dispatch "$/cancelRequest" msg state = Pair False (Pair state [])
dispatch methodName msg state =
  if startsWith "$/" methodName then Pair False (Pair state [])
  else Pair False
    (Pair state [responseErr (idOf msg) errMethodNotFound ("method not found: " ++ methodName)])

-- ---------------------------------------------------------------
-- 主循环
-- ---------------------------------------------------------------
-- 逐帧循环：缓冲里先切 header（`splitHeaderBlock`），拿到 `Content-Length` 后按字节数
-- 判断 body 是否读够；不够就 `feedMore` 再读一块。返回值即进程退出码。
lspLoop : Int -> String -> LspState -> Int
lspLoop fuel pending state = if fuel <= 0 then abnormalExit (logTo "frame fuel exhausted (internal)" state)
else if strLength pending > maxFrameBytes then abnormalExit (logTo "frame buffer exceeded limit" state)
else case splitHeaderBlock pending of
  -- 还没有完整 header：继续读。
  Nothing => feedMore fuel pending state
  Just (Pair headerBlock afterHeaders) => case contentLengthOf headerBlock of
    -- header 里没有可用的 Content-Length：丢掉这段 header，避免无限等待。
    Nothing =>
      lspLoop (fuel - 1) afterHeaders (logTo "frame header without Content-Length dropped" state)
    Just len => frameBody fuel pending afterHeaders len state

-- header 有效：body 不够就再读；够了就解码一帧。
frameBody : Int -> String -> String -> Int -> LspState -> Int
frameBody fuel pending afterHeaders len state =
  if len > maxFrameBytes then abnormalExit (logTo "frame too large" state)
  else if strLength afterHeaders < len then feedMore fuel pending state
  else decodeFrame fuel len afterHeaders state

-- 切出 body（`Content-Length` 字节，body 后没有换行）、解析并分发，然后继续下一帧。
decodeFrame : Int -> Int -> String -> LspState -> Int
decodeFrame fuel len afterHeaders state =
  let
    body = substring 0 len afterHeaders
    rest = substring len (strLength afterHeaders - len) afterHeaders
  in case parseJson body of
    Err e => lspLoop (fuel - 1) rest (logTo ("malformed frame: " ++ e) state)
    Ok msg =>
      let
        result = handleFrame msg state
        shouldExit = firstOf result
        after = secondOf result
        state2 = firstOf after
        frames = secondOf after
        _ = map sendFrame frames
      in if shouldExit then exitCodeOf state2 else lspLoop (fuel - 1) rest state2

-- 缓冲里还没有完整的一帧：再读一块（可能只到几个字节）。
-- EOF（readChunk 返回 ""）且从未 shutdown ⇒ 非正常断开，退 1。
-- 注意 flushLogs 返回的是写入字节数，不能直接当退出码。
feedMore : Int -> String -> LspState -> Int
feedMore fuel pending state =
  let
    chunk = readChunk readChunkSize
  in if chunk == "" then abnormalExit (logTo "input closed" state)
  else lspLoop (fuel - 1) (pending ++ chunk) state

-- exit 之前是否收到过 shutdown。
exitCodeOf : LspState -> Int
exitCodeOf state =
  let
    _ = flushLogs state
  in if stateShutdown state then 0 else 1

-- 非正常结束（stdin EOF / 空输入）：flush 日志后一律退 1，
-- 不能把 flushLogs 的「写入字节数」当退出码。
abnormalExit : LspState -> Int
abnormalExit state =
  let
    _ = flushLogs state
  in 1

-- stdin 帧循环是「读帧→处理→再读」的无限状态机；用显式 fuel 守卫（1G 次读/帧操作）。
lspFuelBound : Int
lspFuelBound = 1073741824

-- A05：零参顶层定义在模块初始化时求值，所以「动作」必须函数化。
-- runLsp 是读 stdin 的 LSP 帧循环：若留成零参值，任何子命令启动都会跑它。
runLsp : Int -> Int
runLsp _ = lspLoop lspFuelBound "" (logTo "starting" (LspState [] False Nothing False Nothing []))

-- CLI 入口：与其它工具命令一致，返回退出码（由 Vuna.Cli 插入分发）。
runLspTool : List String -> Int
runLspTool args = runLsp 0
