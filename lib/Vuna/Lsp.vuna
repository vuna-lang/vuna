module Vuna.Lsp where

-- Vuna.Lsp：LSP 服务器门面（工具链模块，**永不进 seed 闭包**）。
--
-- 传输/URI/帧在 `Vuna.Lsp.Protocol`，诊断链在 `Vuna.Lsp.Diagnostics`，各查询方法在
-- `Vuna.Lsp.Query`，模块名/局部绑定在 `Vuna.Lsp.Bindings`；本模块只保留**服务器状态机**：
--   initialize / initialized / shutdown / exit、textDocument/didOpen|didChange|didClose
--   （Full 同步，kind = 1）、capabilities、请求分发与 stdin 字节帧循环。
-- `runLsp` / `runLspTool` 是 CLI 入口（由 Vuna.Cli 插入分发）。
--
-- M40 查询管线（hover）：洞目标 → Bindings（模块引用 / 局部绑定）→ Index 符号；
-- definition：Bindings → Index 符号 → 同文件缓冲兜底。Bindings 是 parse 级的，不触发
-- 索引构建；模块引用命中时 docstring 来自目标文件（当前文件用缓冲）。
-- C38：rename / prepareRename 走 `Vuna.Lsp.Rename`（局部绑定复用 Bindings 的作用域
-- 解析；顶层符号复用 Index 与 AST 声明位置）；codeAction 除 lint quick fix 外，新增洞的
-- case split（`refactor.rewrite`，构造子解析在 Query）与 `vuna.fixAllLint` command
-- （`workspace/executeCommand` → 服务器发 `workspace/applyEdit`）。
--
-- 协议约束：**stdout 只写协议帧**；日志走 stderr（内存累积、退出时一次写出）。
-- 读取按 `Content-Length` 精确切字节（`readChunk`），**不能按行读**：标准 LSP 帧的
-- body 后面没有换行，客户端在拿到响应前也不发下一帧，行级读会在 `initialize` 就互等死锁。
-- 退出码：收到 shutdown 后的 exit 退 0，否则（EOF / 未 shutdown）退 1。
--
-- 服务器状态：打开的文档表、惰性 Index（一次构建并缓存）、日志缓冲。
-- 已知边界：
--   - didChange 跑一次完整 DT 精化（同 uri + 内容重复请求命中进程内诊断帧缓存），大文件逐个按键变更可能较慢（客户端可降级为保存时检查）；
--   - 编辑**未保存的依赖模块**时，精化仍从磁盘读依赖（LSP 只覆盖当前文档）；
--   - Index 只反映磁盘内容、不随 didChange 刷新；构建失败则相关方法退化返回空结果；
--   - 首次索引查找可能触发索引全量重建（`index:<dir>` 未命中；仓库级秒级），期间请求排队；
--   - 多根 workspace 未支持：workspace/symbol 用首个打开文档推断工作区根。
import Base.HostRow
import Vuna.Compiler.Common
import Vuna.Index
import Vuna.Json
import Vuna.Json.Server
import Vuna.Lsp.Bindings
import Vuna.Lsp.Diagnostics
import Vuna.Lsp.Protocol
import Vuna.Lsp.Query
import Vuna.Lsp.Rename

-- ---------------------------------------------------------------
-- 常量
-- ---------------------------------------------------------------
lspServerName : String
lspServerName = "vuna-lsp"

lspServerVersion : String
lspServerVersion = "0.3.0"

-- LSP 的 TextDocumentSyncKind.Full = 1
syncKindFull : Int
syncKindFull = 1

-- 打开的文档表
-- ---------------------------------------------------------------
record Doc where
  docUri : String
  docVersion : Int
  docText : String

docLookup : String -> List Doc -> Maybe Doc
docLookup uri [] = Nothing
docLookup uri (d :: rest) = if d.docUri == uri then Just d else docLookup uri rest

docSet : Doc -> List Doc -> List Doc
docSet d [] = [d]
docSet d (x :: rest) = if x.docUri == d.docUri then d :: rest else x :: docSet d rest

docRemove : String -> List Doc -> List Doc
docRemove uri [] = []
docRemove uri (x :: rest) = if x.docUri == uri then docRemove uri rest else x :: docRemove uri rest

-- ---------------------------------------------------------------
-- 服务器状态
-- ---------------------------------------------------------------
-- docs：打开的文档（按 uri 去重）；shutdownReq：是否收到 shutdown；
-- index：惰性构建的索引（Nothing = 尚未成功构建）；indexTried：是否尝试过构建；
record LspState where
  stateDocs : List Doc
  stateShutdown : Bool
  -- 客户端在 initialize 里声明了 `textDocument.diagnostic`（pull 能力）。为 True 时服务器
  -- 只响应 pull 请求、不再 push：vscode-languageclient 会为 push / pull 各建一个诊断集合，
  -- 两套同时用会让 Problems 面板里每条诊断出现两遍。
  stateClientPull : Bool
  stateIndex : Maybe Index
  stateIndexTried : Bool
  stateRootHint : Maybe String
  stateLogs : List String
  stateDiagCache : List (Pair Int Json)
  stateDiagSession : Maybe DiagCache

setDocs : List Doc -> LspState -> LspState
setDocs docs (LspState _ s pull idx tried hint logs dc dsess) =
  LspState docs s pull idx tried hint logs dc dsess

setShutdown : Bool -> LspState -> LspState
setShutdown s (LspState docs _ pull idx tried hint logs dc dsess) =
  LspState docs s pull idx tried hint logs dc dsess

setClientPull : Bool -> LspState -> LspState
setClientPull pull (LspState docs s _ idx tried hint logs dc dsess) =
  LspState docs s pull idx tried hint logs dc dsess

setIndex : Maybe Index -> LspState -> LspState
setIndex idx (LspState docs s pull _ tried hint logs dc dsess) =
  LspState docs s pull idx tried hint logs dc dsess

setIndexTried : Bool -> LspState -> LspState
setIndexTried tried (LspState docs s pull idx _ hint logs dc dsess) =
  LspState docs s pull idx tried hint logs dc dsess

setRootHintIfEmpty : String -> LspState -> LspState
setRootHintIfEmpty hint (LspState docs s pull idx tried (existing@(Just prev)) logs dc dsess) =
  LspState docs s pull idx tried existing logs dc dsess
setRootHintIfEmpty hint (LspState docs s pull idx tried Nothing logs dc dsess) =
  LspState docs s pull idx tried (Just hint) logs dc dsess

setDiagCache : List (Pair Int Json) -> LspState -> LspState
setDiagCache dc (LspState docs s pull idx tried hint logs _ dsess) =
  LspState docs s pull idx tried hint logs dc dsess

setDiagSession : Maybe DiagCache -> LspState -> LspState
setDiagSession dsess (LspState docs s pull idx tried hint logs dc _) =
  LspState docs s pull idx tried hint logs dc dsess

-- M34.4：LSP 进程内诊断帧缓存（上限 32 条，前插）。
pushDiag : Int -> Json -> LspState -> LspState
pushDiag key frame (LspState docs s pull idx tried hint logs dc dsess) =
  LspState docs s pull idx tried hint logs (truncateCache 32 (Pair key frame :: dc)) dsess

truncateCache : Int -> List a -> List a
truncateCache n [] = []
truncateCache n (x :: rest) = if n <= 0 then [] else x :: truncateCache (n - 1) rest

logTo : String -> LspState -> LspState
logTo line (LspState docs s pull idx tried hint logs dc dsess) =
  LspState docs s pull idx tried hint (line :: logs) dc dsess

-- 退出时一次写出（内存累积的日志，见 Protocol.flushLogLines）。
flushLogs : LspState -> Eff hostRow Int
flushLogs st = flushLogLines st.stateLogs

-- 首次需要索引时构建；失败一次后不再重试（避免每个请求都全量扫描磁盘）。
ensureIndex : String -> LspState -> Eff hostRow (Pair LspState (Maybe Index))
ensureIndex uri st = case st.stateIndex of
  Just idx => pure (Pair st (Just idx))
  Nothing => if st.stateIndexTried then pure (Pair st Nothing)
  else do
    root <- workspaceRoot uri
    r <- loadOrBuild root
    case r of
      OkC idx =>
        let
          st1 = logTo "index ready: ${root}" (setIndexTried True (setIndex (Just idx) st))
        in pure (Pair st1 (Just idx))
      ErrC e =>
        let
          st1 = logTo "index unavailable: ${diagText e}" (setIndexTried True st)
        in pure (Pair st1 Nothing)

-- 打开的文档文本（未打开 → ""）。
textForUri : String -> LspState -> String
textForUri uri st = case docLookup uri st.stateDocs of
  Nothing => ""
  Just d => d.docText

-- ---------------------------------------------------------------
-- capabilities（M30 P2：全套；C38 增加 refactor.rewrite 与 executeCommand）
-- ---------------------------------------------------------------
serverCapabilities : Json
serverCapabilities =
  JObj
    [Pair "textDocumentSync" (JObj [Pair "openClose" (JBool True), Pair "change" (JNum syncKindFull)]), Pair "completionProvider" (JObj [Pair "triggerCharacters" (JArr [JStr "."]), Pair "resolveProvider" (JBool False)]), Pair "definitionProvider" (JBool True), Pair "referencesProvider" (JBool True), Pair "renameProvider" (JObj [Pair "prepareProvider" (JBool True)]), Pair "documentSymbolProvider" (JBool True), Pair "documentFormattingProvider" (JBool True), Pair "workspaceSymbolProvider" (JBool True), Pair "hoverProvider" (JBool True), Pair "codeActionProvider" (JObj [Pair "codeActionKinds" (JArr [JStr "quickfix", JStr "refactor.rewrite"])]), Pair "executeCommandProvider" (JObj [Pair "commands" (JArr [JStr fixAllLintCommand])]), Pair "diagnosticProvider" (JObj [Pair "interleaved" (JBool False), Pair "workspaceDiagnostics" (JBool False)])]

-- ---------------------------------------------------------------
-- 请求分发
-- ---------------------------------------------------------------
uriOfParams : Json -> String
uriOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "uri"] params >>= jsonAsStr)

versionOfParams : Json -> Int
versionOfParams params = fromMaybe 0 (jsonGetIn ["textDocument", "version"] params >>= jsonAsInt)

textOfParams : Json -> String
textOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "text"] params >>= jsonAsStr)

lineOfParams : Json -> Int
lineOfParams params = fromMaybe 0 (jsonGetIn ["position", "line"] params >>= jsonAsInt)

colOfParams : Json -> Int
colOfParams params = fromMaybe 0 (jsonGetIn ["position", "character"] params >>= jsonAsInt)

lastJson : List Json -> Maybe Json
lastJson [] = Nothing
lastJson (x :: rest) = case rest of
  [] => Just x
  _ => lastJson rest

-- Full 同步：取 contentChanges 最后一个 text。
changedText : Json -> String
changedText params = case jsonGetIn ["contentChanges"] params >>= jsonAsArr of
  Nothing => ""
  Just changes => case lastJson changes of
    Nothing => ""
    Just change => jsonStrOr "" (fromMaybe JNull (jsonGet "text" change))

initializeResult : Json -> Json
initializeResult msg =
  responseOk (idOf msg)
    (JObj [Pair "capabilities" serverCapabilities, Pair "serverInfo" (JObj [Pair "name" (JStr lspServerName), Pair "version" (JStr lspServerVersion)])])

-- 客户端是否在 initialize 声明了 pull 诊断能力（`textDocument.diagnostic` 为能力对象）。
-- 声明了 ⇒ 只走 pull（服务器不再 push，避免客户端把同一诊断显示两份）；没声明 ⇒ push。
clientSupportsPull : Json -> Bool
clientSupportsPull msg = case jsonGetIn ["params", "capabilities", "textDocument", "diagnostic"] msg of
  Just (JObj _) => True
  _ => False

-- didOpen：登记文档并推诊断（M34.4：同一 uri + 文本内容的诊断帧进程内缓存，重复请求
-- 不重复精化）。声明 pull 能力的客户端不 push（见 stateClientPull）。
handleDidOpen : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleDidOpen msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    version = versionOfParams params
    text = textOfParams params
    docs = docSet (Doc uri version text) state.stateDocs
  in if state.stateClientPull then pure (Pair False (Pair (setRootHintIfEmpty uri (setDocs docs state)) []))
  else do
    pair <- diagnoseCached uri version text state
    pure (Pair False (Pair (setRootHintIfEmpty uri (setDocs docs (firstOf pair))) [secondOf pair]))

-- didChange（Full 同步）：覆盖全文并重推诊断（pull 客户端只更新文档表）。
handleDidChange : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleDidChange msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    oldVersion = case docLookup uri state.stateDocs of
      Nothing => 0
      Just d => d.docVersion
    version = case jsonGetIn ["textDocument", "version"] params >>= jsonAsInt of
      Nothing => oldVersion
      Just v => v
    text = changedText params
    docs = docSet (Doc uri version text) state.stateDocs
  in if state.stateClientPull then pure (Pair False (Pair (setDocs docs state) []))
  else do
    pair <- diagnoseCached uri version text state
    pure (Pair False (Pair (setDocs docs (firstOf pair)) [secondOf pair]))

-- M34.4：诊断帧缓存查询（key = uri + 文本内容哈希；未命中才跑完整精化并写缓存）。
diagnoseCached : String -> Int -> String -> LspState -> Eff hostRow (Pair LspState Json)
diagnoseCached uri version text state =
  let
    key = strHash uri * 1000003 + strHash text
  in case lookupDiag key state.stateDiagCache of
    Just frame => pure (Pair state frame)
    Nothing => do
      result <- publishDiagnosticsCached state.stateDiagSession uri version text
      let
        frame = secondOf result
        state1 = pushDiag key frame (setDiagSession (firstOf result) state)
      in pure (Pair state1 frame)

lookupDiag : Int -> List (Pair Int Json) -> Maybe Json
lookupDiag key [] = Nothing
lookupDiag key ((Pair k v) :: rest) = if k == key then Just v else lookupDiag key rest

-- didClose：移除文档；push 模式清空诊断（pull 客户端由客户端侧自行清理）。
handleDidClose : Json -> LspState -> Pair Bool (Pair LspState (List Json))
handleDidClose msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    docs = docRemove uri state.stateDocs
  in if state.stateClientPull then Pair False (Pair (setDocs docs state) [])
  else Pair False (Pair (setDocs docs state) [publishDiagnosticsEmpty uri 0])

-- hover：洞目标（包上下文）→ 模块引用/局部绑定（parse 级）→ 标识符签名/注释。
-- pull diagnostics（LSP 3.17）：与 push 同一条诊断链，返回完整报告；不额外发布通知。
handlePullDiagnostics : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handlePullDiagnostics msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in do
    result <- diagnosticsForCached state.stateDiagSession uri text
    let
      labeled = secondOf result
      state1 = setDiagSession (firstOf result) state
    in pure
      (Pair False (Pair state1 [responseOk (idOf msg) (diagReportJson uri text (secondOf labeled))]))

handleHover : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleHover msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    holeHover <- holeHoverAt uri line col text
    case holeHover of
      Just hover => pure (Pair False (Pair state [responseOk (idOf msg) hover]))
      Nothing => do
        bindHover <- bindingHoverAt uri line col text
        case bindHover of
          Just hover => pure (Pair False (Pair state [responseOk (idOf msg) hover]))
          Nothing => do
            indexPair <- ensureIndex uri state
            let
              state1 = firstOf indexPair
              midx = secondOf indexPair
            in pure
              (Pair False (Pair state1 [responseOk (idOf msg) (symbolHoverResult uri line col text midx)]))

-- formatting：formatSourceWith 成功且内容变化 ⇒ 全文 TextEdit；否则 []（M31.3：程序级 fixity）。
handleFormatting : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleFormatting msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in do
    edits <- formattingEdits uri text
    pure (Pair False (Pair state [responseOk (idOf msg) (JArr edits)]))

-- ---------------------------------------------------------------
-- codeAction（M38 P1c：lint quick fix；C38：洞 case split + fix all 的 Command 形式）
-- ---------------------------------------------------------------
-- 请求 range 是 0-based；Query 侧用 1-based 行/列。`context.only` 是客户端想要的
-- CodeActionKind 列表（Nothing = 不限制）：Query 按 quickfix / refactor.rewrite 分别过滤。
rangeLineOf : String -> Json -> Int
rangeLineOf key params = fromMaybe 0 (jsonGetIn ["range", key, "line"] params >>= jsonAsInt)

rangeCharOf : String -> Json -> Int
rangeCharOf key params = fromMaybe 0 (jsonGetIn ["range", key, "character"] params >>= jsonAsInt)

onlyKindsOf : Json -> Maybe (List String)
onlyKindsOf params = case jsonGetIn ["context", "only"] params >>= jsonAsArr of
  Nothing => Nothing
  Just kinds => Just (mapMaybe jsonAsStr kinds)

-- codeAction：当前缓冲 → lint quick fix / fix all command / 洞 case split（纯查询）。
handleCodeAction : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleCodeAction msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
    startLine = rangeLineOf "start" params + 1
    startCol = rangeCharOf "start" params + 1
    endLine = rangeLineOf "end" params + 1
    endCol = rangeCharOf "end" params + 1
  in do
    actions <- codeActionsFor uri text startLine startCol endLine endCol (onlyKindsOf params)
    pure (Pair False (Pair state [responseOk (idOf msg) (JArr actions)]))

-- ---------------------------------------------------------------
-- workspace/executeCommand（C38：fix all 的 command 形式）
-- ---------------------------------------------------------------
-- codeAction 里的 `vuna.fixAllLint` 被客户端执行后到达这里：按当前缓冲重算整文档修正，
-- 用**服务器 → 客户端**的 `workspace/applyEdit` 请求把 WorkspaceEdit 推给客户端
-- （LSP 的 `workspace/executeCommand` 结果不会被自动应用，所以必须走 applyEdit）。
-- 客户端对 applyEdit 的响应帧没有 method，按既有逻辑忽略；服务器不等待它。
-- 服务器 → 客户端请求的 id：按 (uri, 当前文本) 派生，避免同一会话里两次 fix all
-- 复用同一个未决 id（客户端响应按 id 配对；服务器不等响应，但 id 仍应唯一）。
applyEditRequestId : String -> String -> String
applyEditRequestId uri text = "vuna-apply-${strFromInt (strHash (uri ++ text))}"

applyEditFrame : String -> Json -> Json
applyEditFrame reqId edit =
  JObj
    [Pair "jsonrpc" (JStr "2.0"), Pair "id" (JStr reqId), Pair "method" (JStr "workspace/applyEdit"), Pair "params" (JObj [Pair "edit" edit])]

firstCommandArg : List Json -> String
firstCommandArg [] = ""
firstCommandArg (arg :: rest) = fromMaybe "" (jsonAsStr arg)

-- 支持的 command：`vuna.fixAllLint`（arguments = [文档 uri]）。未知 command → -32602。
handleExecuteCommand : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleExecuteCommand msg state =
  let
    params = paramsOf msg
    command = fromMaybe "" (jsonGet "command" params >>= jsonAsStr)
    args = fromMaybe [] (jsonGet "arguments" params >>= jsonAsArr)
    uri = firstCommandArg args
    text = textForUri uri state
  in if command == fixAllLintCommand then do
    editR <- fixAllLintWorkspaceEdit uri text
    case editR of
      Nothing => pure (Pair False (Pair state [responseOk (idOf msg) JNull]))
      Just edit =>
        pure
          (Pair False (Pair state [applyEditFrame (applyEditRequestId uri text) edit, responseOk (idOf msg) JNull]))
  else pure
    (Pair False (Pair state [responseErr (idOf msg) errInvalidParams "unknown command: ${command}"]))

-- documentSymbol：当前缓冲的 AST 声明树（不要求磁盘上存在）。
handleDocumentSymbol : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleDocumentSymbol msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in do
    symbols <- documentSymbols uri text
    pure (Pair False (Pair state [responseOk (idOf msg) (JArr symbols)]))

-- definition：模块引用/局部绑定（parse 级）→ Index 符号 → 同文件兜底。
handleDefinition : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleDefinition msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    bindLoc <- bindingDefinitionAt uri line col text
    case bindLoc of
      Just loc => pure (Pair False (Pair state [responseOk (idOf msg) loc]))
      Nothing => do
        indexPair <- ensureIndex uri state
        let
          state1 = firstOf indexPair
          midx = secondOf indexPair
        in pure
          (Pair False (Pair state1 [responseOk (idOf msg) (definitionResult uri line col text midx)]))

-- references：定义位置 + Index refs 的出现位置。
handleReferences : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleReferences msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in pure
      (Pair False (Pair state1 [responseOk (idOf msg) (JArr (referencesResult uri line col text midx))]))

-- prepareRename：光标 token 的范围 + 占位名（无法改名 → null）。
handlePrepareRename : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handlePrepareRename msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in do
      json <- prepareRenameAt uri line col text midx
      pure (Pair False (Pair state1 [responseOk (idOf msg) json]))

-- rename：局部绑定只改当前文档；顶层符号额外改目标模块与 import 它的模块。
handleRename : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleRename msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    newName = fromMaybe "" (jsonGet "newName" params >>= jsonAsStr)
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in do
      json <- renameAt uri line col text newName midx
      pure (Pair False (Pair state1 [responseOk (idOf msg) json]))

-- completion：关键字 + 当前缓冲顶层名 + Index 符号；`.` 后按模块过滤。
handleCompletion : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleCompletion msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params
    col = colOfParams params
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in pure
      (Pair False (Pair state1 [responseOk (idOf msg) (JArr (completionItems text line col midx))]))

-- workspace/symbol：Index 过滤（空 query = 全部，上限 200）。
handleWorkspaceSymbol : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleWorkspaceSymbol msg state =
  let
    params = paramsOf msg
    query = fromMaybe "" (jsonGet "query" params >>= jsonAsStr)
    hint = fromMaybe "" state.stateRootHint
  in do
    indexPair <- ensureIndex hint state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in pure (Pair False (Pair state1 [responseOk (idOf msg) (JArr (workspaceSymbols midx query))]))

-- 处理一帧。返回 (是否退出, 新状态, 待发送帧)。
handleFrame : Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
handleFrame msg state = case jsonGet "method" msg of
  Nothing => pure (Pair False (Pair state [])) -- 客户端对我们请求的响应：忽略
  Just m => case jsonAsStr m of
    Nothing => pure (Pair False (Pair state []))
    Just methodName => dispatch methodName msg state

dispatch : String -> Json -> LspState -> Eff hostRow (Pair Bool (Pair LspState (List Json)))
dispatch "initialize" msg state =
  pure (Pair False (Pair (setClientPull (clientSupportsPull msg) state) [initializeResult msg]))
dispatch "initialized" msg state = pure (Pair False (Pair state []))
dispatch "shutdown" msg state =
  pure (Pair False (Pair (setShutdown True state) [responseOk (idOf msg) JNull]))
dispatch "exit" msg state = pure (Pair True (Pair state []))
dispatch "textDocument/didOpen" msg state = handleDidOpen msg state
dispatch "textDocument/didChange" msg state = handleDidChange msg state
dispatch "textDocument/didClose" msg state = pure (handleDidClose msg state)
dispatch "textDocument/diagnostic" msg state = handlePullDiagnostics msg state
dispatch "textDocument/hover" msg state = handleHover msg state
dispatch "textDocument/completion" msg state = handleCompletion msg state
dispatch "textDocument/definition" msg state = handleDefinition msg state
dispatch "textDocument/references" msg state = handleReferences msg state
dispatch "textDocument/prepareRename" msg state = handlePrepareRename msg state
dispatch "textDocument/rename" msg state = handleRename msg state
dispatch "textDocument/documentSymbol" msg state = handleDocumentSymbol msg state
dispatch "textDocument/formatting" msg state = handleFormatting msg state
dispatch "textDocument/codeAction" msg state = handleCodeAction msg state
dispatch "workspace/executeCommand" msg state = handleExecuteCommand msg state
dispatch "workspace/symbol" msg state = handleWorkspaceSymbol msg state
-- 客户端能力注册（vscode-languageclient 的 fileEvents 等）：服务器不消费这些注册，
-- 但必须回成功，否则客户端会把「注册失败」当成错误刷日志。
dispatch "client/registerCapability" msg state =
  pure (Pair False (Pair state [responseOk (idOf msg) JNull]))
dispatch "client/unregisterCapability" msg state =
  pure (Pair False (Pair state [responseOk (idOf msg) JNull]))
dispatch "$/cancelRequest" msg state = pure (Pair False (Pair state []))
dispatch methodName msg state =
  if startsWith "$/" methodName then pure (Pair False (Pair state []))
  else pure
    (Pair False (Pair state [responseErr (idOf msg) errMethodNotFound "method not found: ${methodName}"]))

-- ---------------------------------------------------------------
-- 主循环
-- ---------------------------------------------------------------
-- 连接循环（字节级切帧、坏帧丢弃、16 MiB / fuel 上界）由
-- `Vuna.Json.Server.serveConnection` 提供；LSP 只保留**退出策略**：
-- stdin EOF / 传输层致命错误算异常断开（flush 日志后退 1），
-- 收到 shutdown 之后的 exit 退 0。
writeStdout : String -> Eff hostRow Int
writeStdout s = @vuna@prim_eff_print s

-- 传输告警：LSP 的既有策略是丢帧 + 写日志（不回错误帧）。
lspWarn : String -> LspState -> Pair LspState (List Json)
lspWarn m st = Pair (logTo m st) []

-- exit 之前是否收到过 shutdown。
exitCodeOf : LspState -> Eff hostRow Int
exitCodeOf state = do
  _ <- flushLogs state
  pure (if state.stateShutdown then 0 else 1)

-- 非正常结束（stdin EOF / 传输层致命错误）：flush 日志后一律退 1，
-- 不能把 flushLogs 的「写入字节数」当退出码。
abnormalExit : LspState -> Eff hostRow Int
abnormalExit state = do
  _ <- flushLogs state
  pure 1

-- A05：零参顶层定义在模块初始化时求值，所以「动作」必须函数化。
-- runLsp 是读 stdin 的 LSP 帧循环：若留成零参值，任何子命令启动都会跑它。
-- M4：整个入口显式 `Eff hostRow`（帧处理/诊断/索引都已在 Eff 里），由 CLI 运行时执行。
export runLsp : Int -> Eff hostRow Int
runLsp _ = do
  outcome <-
    serveConnection readChunk writeStdout (\m => \s => pure (lspWarn m s))
      (\m => \s => handleFrame m s)
      (logTo "starting" (LspState [] False False Nothing False Nothing [] [] Nothing))
  let
    @vuna@prim_eff_exit = firstOf outcome
    state = secondOf outcome
  in case @vuna@prim_eff_exit of
    ExitRequested => exitCodeOf state
    ExitClosed => abnormalExit state
    ExitFatal msg => abnormalExit (logTo msg state)

-- CLI 入口：与其它工具命令一致，返回退出码（由 Vuna.Cli 插入分发）。
export runLspTool : List String -> Eff hostRow Int
runLspTool args = runLsp 0
