module Vuna.Search.Run (renderHit, runSearch) where

-- Vuna.Search.Run：`vuna search` 的参数、索引、模式选择、文本/JSON 输出。
--
-- 用法：
--   vuna search [--type|--name|--doc] [--module PFX] [--limit N] [--json] <query...>
-- 默认：查询含 `->` / `=>` 走类型检索，否则名称+doc 检索。
-- 退出码：0 命中、1 无命中、2 用法/查询解析/非 workspace 错误。
import Vuna.Cli.Args
import Vuna.Compiler.Common
import Vuna.Index
import Vuna.Json
import Vuna.Search.Query
import Vuna.Search.Types
import Base.Host

data SearchMode : Type where
  TypeMode : SearchMode
  NameDocMode : Bool -> Bool -> SearchMode

runSearch : List String -> Eff [] Int
runSearch args = case parseToolArgs "vuna search" [BoolFlag "type", BoolFlag "name", BoolFlag "doc", ValueFlag "module", ValueFlag "limit", BoolFlag "json"] args of
  ErrC e => toolError (diagText e)
  OkC parsed =>
    let
      query = join " " parsed.positionals
    in if query == "" then toolError "usage: vuna search [--type|--name|--doc] [--module PFX] [--limit N] [--json] <query>"
    else case modeOf parsed query of
      ErrC e => toolError (diagText e)
      OkC mode => case limitOf parsed of
        ErrC e => toolError (diagText e)
        OkC limit => case loadOrBuild "." of
          ErrC e => toolError (diagText e)
          OkC index => runOnIndex parsed mode query limit index

runOnIndex : Parsed -> SearchMode -> String -> Int -> Index -> Eff [] Int
runOnIndex parsed (mode@TypeMode) query limit index = case searchType index query of
  ErrC e => toolError (diagText e)
  OkC hits => finish parsed mode query (filterHits parsed limit hits)
runOnIndex parsed (mode@(NameDocMode nameOnly docOnly)) query limit index =
  finish parsed mode query (filterHits parsed limit (searchNameDoc index query nameOnly docOnly))

filterHits : Parsed -> Int -> List SearchHit -> List SearchHit
filterHits parsed limit hits =
  let
    pfx = case flagValue parsed "module" of
      Just p => p
      Nothing => ""
  in takeHits limit (filter (\h => pfx == "" || startsWith pfx (hitModule h)) hits)

modeOf : Parsed -> String -> Check SearchMode
modeOf parsed query =
  let
    isType = flagSet parsed "type"
    isName = flagSet parsed "name"
    isDoc = flagSet parsed "doc"
    count = boolInt isType + boolInt isName + boolInt isDoc
  in if count > 1 then err "choose one of --type / --name / --doc"
  else if isType then OkC TypeMode
  else if isName then OkC (NameDocMode True False)
  else if isDoc then OkC (NameDocMode False True)
  else if contains "->" query || contains "=>" query then OkC TypeMode else OkC (NameDocMode False False)

boolInt : Bool -> Int
boolInt True = 1
boolInt False = 0

limitOf : Parsed -> Check Int
limitOf parsed = case flagValue parsed "limit" of
  Nothing => OkC 20
  Just text => case parseInt text of
    Just n => if n > 0 then OkC n else err "--limit must be a positive integer"
    Nothing => err "--limit is not an integer: ${text}"

parseInt : String -> Maybe Int
parseInt s = parseIntChars (strUnpack s) 0

parseIntChars : List Int -> Int -> Maybe Int
parseIntChars [] acc = Just acc
parseIntChars (c :: rest) acc =
  if c >= 48 && c <= 57 then parseIntChars rest (acc * 10 + (c - 48)) else Nothing

takeHits : Int -> List SearchHit -> List SearchHit
takeHits n [] = []
takeHits n (h :: rest) = if n <= 0 then [] else h :: takeHits (n - 1) rest

-- ---------------------------------------------------------------
-- 文本 / JSON
-- ---------------------------------------------------------------
finish : Parsed -> SearchMode -> String -> List SearchHit -> Eff [] Int
finish parsed mode query hits = if length hits == 0 then do
  _ <- prim_eff_print "no results for `${query}`\n"
  pure 1
else if flagSet parsed "json" then do
  _ <- prim_eff_print "${renderJson (hitsJson mode query hits)}\n"
  pure 0
else printHits hits

printHits : List SearchHit -> Eff [] Int
printHits [] = pure 0
printHits (h :: rest) = do
  _ <- prim_eff_print "${hitText h}\n"
  printHits rest

-- REPL `:search` 复用同一份单条命中渲染。
renderHit : SearchHit -> String
renderHit h = hitText h

hitText : SearchHit -> String
hitText h =
  "${hitModule h}.${hitName h}${if hitSignature h == "" then "" else " : ${hitSignature h}"}  [${hitMatch h}]${if firstDocLine (hitDoc h) == "" then "" else "\n    ${firstDocLine (hitDoc h)}"}"

firstDocLine : String -> String
firstDocLine doc = case lines doc of
  first :: rest => first
  [] => ""

hitsJson : SearchMode -> String -> List SearchHit -> Json
hitsJson mode query hits =
  JObj
    [Pair "schema" (JStr "vuna-search/1"), Pair "query" (JStr query), Pair "mode" (JStr (modeName mode)), Pair "hits" (JArr (map hitJson hits))]

modeName : SearchMode -> String
modeName TypeMode = "type"
modeName (NameDocMode nameOnly docOnly) =
  if nameOnly then "name" else if docOnly then "doc" else "name+doc"

hitJson : SearchHit -> Json
hitJson h =
  JObj
    [Pair "module" (JStr (hitModule h)), Pair "name" (JStr (hitName h)), Pair "kind" (JStr (hitKind h)), Pair "signature" (JStr (hitSignature h)), Pair "doc" (JStr (hitDoc h)), Pair "line" (JNum (hitLine h)), Pair "score" (JNum (hitScore h)), Pair "match" (JStr (hitMatch h))]

toolError : String -> Eff [] Int
toolError e = do
  _ <- prim_eff_print "error: ${e}\n"
  pure 2
