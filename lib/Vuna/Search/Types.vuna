module Vuna.Search.Types where

-- Vuna.Search.Types：检索结果的数据模型（工具链；永不进 seed 闭包）。
import Vuna.Compiler.Common

export record SearchHit(..) where
  hitName : String
  hitModule : String
  hitKind : String
  hitSignature : String
  hitDoc : String
  hitLine : Int
  hitScore : Int
  hitMatch : String

export hitName : SearchHit -> String
hitName (SearchHit name mod kind sig doc line score match) = name

export hitModule : SearchHit -> String
hitModule (SearchHit name mod kind sig doc line score match) = mod

export hitKind : SearchHit -> String
hitKind (SearchHit name mod kind sig doc line score match) = kind

export hitSignature : SearchHit -> String
hitSignature (SearchHit name mod kind sig doc line score match) = sig

export hitDoc : SearchHit -> String
hitDoc (SearchHit name mod kind sig doc line score match) = doc

export hitLine : SearchHit -> Int
hitLine (SearchHit name mod kind sig doc line score match) = line

export hitScore : SearchHit -> Int
hitScore (SearchHit name mod kind sig doc line score match) = score

export hitMatch : SearchHit -> String
hitMatch (SearchHit name mod kind sig doc line score match) = match

hitFullName : SearchHit -> String
hitFullName h = "${hitModule h}.${hitName h}"
