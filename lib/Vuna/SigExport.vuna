module Vuna.SigExport (runSigExport) where

-- Vuna.SigExport：M23 的**一次性签名导出工具**（工具链模块，不进 seed）。
--
-- DT 路径要求顶层签名必填（终态也是「顶层签名必填、不引入 HM 式顶层推断」），而
-- 迁移期仓库里仍有大量无签名定义。本工具用**现有 HM 检查器的推断结果**生成 DT 可用的
-- 签名文本，交给外部脚本回写到源码；M24 删除 HM 后本模块一并删除（roadmap「决策变更」）。
--
-- 输出是一行一条的 TSV（stdout）：
--   <文件>\t<源码名>\t<签名文本>[\tcons=<n>]
-- cons 字段非 0 表示 HM 推断出 trait 约束（签名语法没有约束位置，回写时按类型部分处理；
-- 计数只用于人工核对）。
--
-- 为什么用 HM 而不是 DT：DT 精化器没有 HM 式顶层推断（这是终态决策），签名工具必须
-- 借一条仍在运行的推断通路；HM 推断结果里的小写类型变量在 DT 签名里由 DtQuant 自动
-- 量化为隐式参数，两边的「省略类型参数」写法一致。
import Vuna.Compiler.Common
import Vuna.Compiler.Ast
import Vuna.Compiler.Pkg
import Vuna.Compiler.Loader
import Vuna.Compiler.Typecheck

runSigExport : String -> Int
runSigExport dir = case loadPackage dir of
  Err e => sigExportErr e
  Ok pkg => case sigExportLoad pkg of
    Err e => sigExportErr e
    Ok project => sigExportEmit pkg project

sigExportErr : String -> Int
sigExportErr e =
  let
    _ = print ("error: " ++ e ++ "\n")
  in 1

-- 按包的形状取「入口声明 + 依赖模块」并解析（与 HM 的 check 路径一致）。
sigExportLoad : Package -> Result (Pair (List Decl) (List Module))
sigExportLoad pkg =
  let
    roots = packageRoots pkg
    name = packageName pkg
  in if fileExists (packageEntry pkg) then andThen (loadProject roots name (packageEntry pkg)) resolveProject
  else case packageExports pkg of
    Nothing => Err ("sig-export: library package " ++ name ++ " has no [export].modules")
    Just mods => andThen (loadProjectModules roots name mods) resolveProject

sigExportEmit : Package -> Pair (List Decl) (List Module) -> Int
sigExportEmit pkg project = case checkProgramInfoElabFixpoint (sigFlatDecls project) of
  Err e => sigExportErr e
  Ok globals =>
    let
      entryLines = sigDeclLines "" (packageEntry pkg) (firstOf project) globals
      moduleLines = sigModuleLines (packageDir pkg) (packageName pkg) (secondOf project) globals
      lines = append moduleLines entryLines
    in let
      _ = print (join "\n" lines ++ "\n")
    in let
      _ = print ("sig-export: " ++ strFromInt (length lines) ++ " unsigned definitions\n")
    in 0

-- HM 的 flatten 顺序（入口在前、模块按加载顺序）与 check 路径一致；只有这个顺序下
-- HM 检查器的 globals 与真实构建相同。
sigFlatDecls : Pair (List Decl) (List Module) -> List Decl
sigFlatDecls project = append (firstOf project) (concatMap moduleDeclsOf (secondOf project))

-- 每个模块一份行；文件路径由包目录 + 模块名推出（与 Loader.modulePath 同构）。
-- 只处理**本包拥有的模块**：依赖包（base、compiler）的模块会在各自包的 sig-export
-- 里处理，避免同一文件被写两次或路径算错。
sigModuleLines : String -> String -> List Module -> List (Pair String Scheme) -> List String
sigModuleLines pkgDir pkgName modules globals = sigModuleLinesGo pkgDir pkgName modules globals []

sigModuleLinesGo : String -> String -> List Module -> List (Pair String Scheme) -> List String -> List String
sigModuleLinesGo pkgDir pkgName modules globals acc = case modules of
  [] => acc
  m :: rest =>
    let
      modName = moduleNameOf m
      modPkg = modulePackageOf m
    in if modPkg == pkgName then
      let
        file = pkgDir ++ "/lib/" ++ joinSlashes (splitOnDot modName) ++ ".vuna"
        lines = sigDeclLines modName file (moduleDeclsOf m) globals
      in sigModuleLinesGo pkgDir pkgName rest globals (append lines acc)
    else sigModuleLinesGo pkgDir pkgName rest globals acc

-- 一条声明列表里的无签名定义 → 行（先收集 DSig 名，再按首个 DFun 发射一次）。
sigDeclLines : String -> String -> List Decl -> List (Pair String Scheme) -> List String
sigDeclLines prefix file decls globals = sigLinesGo prefix file decls globals [] [] []

sigLinesGo : String -> String -> List Decl -> List (Pair String Scheme) -> List String -> List String -> List String -> List String
sigLinesGo prefix file decls globals sigs emitted acc = case decls of
  [] => acc
  d :: rest => case d of
    DSig n ty sp => sigLinesGo prefix file rest globals (n :: sigs) emitted acc
    DFun n pats body sp => if memName n sigs || memName n emitted then sigLinesGo prefix file rest globals sigs emitted acc
    else case lookupScheme n globals of
      Nothing => sigLinesGo prefix file rest globals sigs emitted acc
      Just sch =>
        let
          line =
            file ++ "\t" ++ sourceSigName prefix n ++ "\t" ++ renderScheme sch ++ consSuffix sch
        in sigLinesGo prefix file rest globals sigs (n :: emitted) (line :: acc)
    _ => sigLinesGo prefix file rest globals sigs emitted acc

consSuffix : Scheme -> String
consSuffix sch = case schemeCons sch of
  [] => ""
  cons => "\tcons=" ++ strFromInt (length cons)

-- 源码里写的名字（Loader 已把定义名 mangle 成 `<模块>.<名>`）。
sourceSigName : String -> String -> String
sourceSigName prefix n = case prefix of
  "" => n
  _ => case splitLastDot (splitOnDot n) of
    Pair rev base => base

-- HM 类型 → 可回写的签名文本：类型变量按 `t<id>` 命名（小写、自由出现，DT 的
-- DtQuant.quantifyTopSig 会量化为隐式类型参数），类型构造器用短名（Loader 在包模式
-- 下按 import 解析短名，与源码里的写法一致）。
renderScheme : Scheme -> String
renderScheme sch = renderTy (schemeTy sch)

-- 最小括号渲染（与仓库源码签名风格一致，`fmt` 不会删冗余括号）：
-- 箭头右结合、应用最紧，因此只在「箭头作为箭头左操作数」和「非原子类型作为应用
-- 实参/头部」时加括号；`a -> b -> c`、`Maybe ModDecl -> List (Pair String Int)` 保持原样。
renderTy : Ty -> String
renderTy ty = case ty of
  TVar i => "t" ++ strFromInt i
  TCon n [] => shortTyName n
  TCon n args => shortTyName n ++ " " ++ renderTyArgs args
  TApp head args => renderTyAppArg head ++ " " ++ renderTyArgs args
  TFun a b => renderTyArrowOperand a ++ " -> " ++ renderTy b

-- 箭头左操作数：只有箭头本身需要括号（应用在这里已经绑定更紧）。
renderTyArrowOperand : Ty -> String
renderTyArrowOperand ty = case ty of
  TFun a b => "(" ++ renderTy ty ++ ")"
  _ => renderTy ty

-- 应用实参/头部：非原子类型（箭头、带参数的应用）都需要括号。
renderTyAppArg : Ty -> String
renderTyAppArg ty = case ty of
  TVar i => renderTy ty
  TCon n [] => renderTy ty
  _ => "(" ++ renderTy ty ++ ")"

renderTyArgs : List Ty -> String
renderTyArgs [] = ""
renderTyArgs (ty :: rest) = renderTyCommon ty rest

renderTyCommon : Ty -> List Ty -> String
renderTyCommon ty rest = case rest of
  [] => renderTyAppArg ty
  _ => renderTyAppArg ty ++ " " ++ renderTyArgs rest

shortTyName : String -> String
shortTyName name = case splitLastDot (splitOnDot name) of
  Pair rev base => base
