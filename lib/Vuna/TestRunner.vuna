module Vuna.TestRunner (runTests) where

-- Vuna.TestRunner：包内测试运行器（M11.5）。
--
-- 约定：包 `test/` 下每个 `*.vuna` 是一个测试模块，`main : String`；
-- 返回空串表示通过，返回非空串表示失败（打印失败信息）。
-- 用解释器 + 降级路径执行，能覆盖 trait/record/do；代码生成路径的验证留给 CI 脚本。
import Vuna.Compiler.Common
import Vuna.Compiler.Pkg
import Vuna.Files
import Vuna.Interp

runTests : Package -> List Root -> Int
runTests pkg roots =
  let
    testDir = packageDir pkg ++ "/test"
  in if pathExistsDir testDir then
    let
      files = testFiles (readDir testDir)
    in runTestFiles roots (packageName pkg) testDir files 0 0
  else
    let
      _ = print ("error: test directory not found: " ++ testDir ++ "\n")
    in 2

testFiles : List String -> List String
testFiles [] = []
testFiles (name :: rest) = if endsWith ".vuna" name then name :: testFiles rest else testFiles rest

runTestFiles : List Root -> String -> String -> List String -> Int -> Int -> Int
runTestFiles roots pkgName dir [] pass fail =
  let
    _ = print ("\n" ++ strFromInt pass ++ " passed, " ++ strFromInt fail ++ " failed\n")
  in if fail == 0 then 0 else 1
runTestFiles roots pkgName dir (name :: rest) pass fail =
  let
    path = dir ++ "/" ++ name
  in let
    output = interpretFileIn pkgName roots path
  in if output == "\"\"" then
    let
      _ = print ("ok   " ++ name ++ "\n")
    in runTestFiles roots pkgName dir rest (pass + 1) fail
  else
    let
      _ = print ("FAIL " ++ name ++ ": " ++ output ++ "\n")
    in runTestFiles roots pkgName dir rest pass (fail + 1)
