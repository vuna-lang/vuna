module Vuna.Doc.Run where

-- Vuna.Doc.Run：`vuna doc` 的参数解析、包发现、[export] 过滤、HTML 写出与 --check。
--
-- 用法：
--   vuna doc [--check] [--package NAME] [DIR [OUT]]
-- 默认 OUT：DIR=. -> docs/api.html，其他 DIR -> DIR/docs/api.html。
-- `--check` 不写文件，只报告缺失 docstring 的顶层导出项（退出 1）。
import Base.HostRow
import Vuna.Cli.Args
import Vuna.Compiler.Common
import Vuna.Compiler.Packages.Pkg
import Vuna.Doc.Html
import Vuna.Doc.Model
import Vuna.Files

export runDoc : List String -> Eff hostRow Int
runDoc args = case parseToolArgs "vuna doc" [BoolFlag "check", ValueFlag "package"] args of
  ErrC e => docError (diagText e)
  OkC parsed => case parsed.positionals of
    [] => docRun "." (docDefaultOut ".") (flagSet parsed "check") (flagValue parsed "package")
    [dir] => docRun dir (docDefaultOut dir) (flagSet parsed "check") (flagValue parsed "package")
    [dir, out] =>
      if flagSet parsed "check" then docError "--check does not take an OUT argument"
      else docRun dir out False (flagValue parsed "package")
    _ => docError "usage: vuna doc [--check] [--package NAME] [DIR [OUT]]"

docDefaultOut : String -> String
docDefaultOut dir = if dir == "." then "docs/api.html" else "${dir}/docs/api.html"

record DocScope where
  scopeDir : String
  scopeName : String
  scopeExports : Maybe (List String)

scopeDir : DocScope -> String
scopeDir (DocScope dir name exports) = dir

scopeName : DocScope -> String
scopeName (DocScope dir name exports) = name

scopeExports : DocScope -> Maybe (List String)
scopeExports (DocScope dir name exports) = exports

docRun : String -> String -> Bool -> Maybe String -> Eff hostRow Int
docRun dir out check pkgFilter = do
  dirR <- requireDirectory dir
  case dirR of
    ErrC e => docError (diagText e)
    OkC _ => do
      sc <- scopesFor dir pkgFilter
      case sc of
        ErrC e => docError (diagText e)
        OkC [] => docError "no such package: ${maybeText pkgFilter}"
        OkC scopes => do
          filesR <- filesForScopes scopes
          case filesR of
            ErrC e => docError (diagText e)
            OkC files => if length (filesOf files) == 0 then docError "no vuna sources found under ${dir}; pass a package or source directory"
            else do
              bookR <- buildBook scopes files
              case bookR of
                ErrC e => docError (diagText e)
                OkC book => if check then runCheck book else writeHtml out book

-- 每个 scope 的源文件（与 scope 一一对应；顺序稳定）。
filesForScopes : List DocScope -> Eff hostRow (Check (List (Pair DocScope (List String))))
filesForScopes scopes = traverseScopes scopes []

traverseScopes : List DocScope -> List (Pair DocScope (List String)) -> Eff hostRow (Check (List (Pair DocScope (List String))))
traverseScopes [] acc = pure (OkC (reverse acc))
traverseScopes (s :: rest) acc = do
  files <- scopeSourceFiles s
  traverseScopes rest (Pair s files :: acc)

scopeSourceFiles : DocScope -> Eff hostRow (List String)
scopeSourceFiles s =
  let
    root = "${scopeDir s}/lib"
  in do
    hasLib <- pathExistsDir root
    if hasLib then collectVunaFiles root
    else do
      hasDir <- pathExistsDir (scopeDir s)
      if hasDir then collectVunaFiles (scopeDir s) else pure []

-- 所有 scope 的源文件汇总（只用于空检查；真正构建按 scope 分组）。
filesOf : List (Pair DocScope (List String)) -> List String
filesOf pairs = concatMap secondOf pairs

buildBook : List DocScope -> List (Pair DocScope (List String)) -> Eff hostRow (Check DocBook)
buildBook scopes files = buildBookGo scopes files []

buildBookGo : List DocScope -> List (Pair DocScope (List String)) -> List DocModule -> Eff hostRow (Check DocBook)
buildBookGo [] files acc = pure (OkC (DocBook (reverse acc)))
buildBookGo (scope :: restScopes) files acc = case lookupScopeFiles scope files of
  Nothing => buildBookGo restScopes files acc
  Just paths => do
    modulesR <- buildModules (scopeName scope) paths
    case modulesR of
      ErrC e => pure (ErrC e)
      OkC modules0 => case selectModules (scopeExports scope) modules0 of
        ErrC e => pure (ErrC e)
        OkC modules1 => buildBookGo restScopes files (append modules1 acc)

lookupScopeFiles : DocScope -> List (Pair DocScope (List String)) -> Maybe (List String)
lookupScopeFiles scope [] = Nothing
lookupScopeFiles scope ((Pair s paths) :: rest) =
  if scopeName s == scopeName scope && scopeDir s == scopeDir scope then Just paths
  else lookupScopeFiles scope rest

-- `[export].modules`：按 manifest 顺序输出；缺模块是配置错误（exit 2）。
selectModules : Maybe (List String) -> List DocModule -> Check (List DocModule)
selectModules Nothing modules0 = OkC modules0
selectModules (Just names) modules0 = selectModulesGo names modules0 []

selectModulesGo : List String -> List DocModule -> List DocModule -> Check (List DocModule)
selectModulesGo [] modules0 acc = OkC (reverse acc)
selectModulesGo (name :: rest) modules0 acc = case findDocModule name modules0 of
  Nothing => err "exported module not found in sources: ${name} (from [export].modules)"
  Just m => selectModulesGo rest modules0 (m :: acc)

findDocModule : String -> List DocModule -> Maybe DocModule
findDocModule name [] = Nothing
findDocModule name (m :: rest) = if moduleName m == name then Just m else findDocModule name rest

-- ---------------------------------------------------------------
-- 包发现
-- ---------------------------------------------------------------
scopesFor : String -> Maybe String -> Eff hostRow (Check (List DocScope))
scopesFor dir pkgFilter = do
  hasManifest <- raiseToRow hostRow (@vuna@prim_eff_fileExists "${dir}/vuna.toml")
  if hasManifest then do
    packagesR <- workspacePackages dir
    pure (case packagesR of
      ErrC e => ErrC e
      OkC packages => OkC (filterScopes pkgFilter (mapToScopes packages))
    )
  else pure (OkC (filterScopes pkgFilter [DocScope dir "" Nothing]))

mapToScopes : List Package -> List DocScope
mapToScopes [] = []
mapToScopes (p :: rest) =
  DocScope (packageDir p) (packageName p) (packageExports p) :: mapToScopes rest

filterScopes : Maybe String -> List DocScope -> List DocScope
filterScopes Nothing scopes = scopes
filterScopes (Just name) scopes = filter (\s => scopeName s == name) scopes

-- ---------------------------------------------------------------
-- --check
-- ---------------------------------------------------------------
runCheck : DocBook -> Eff hostRow Int
runCheck book = if length (missingDocs book) == 0 then do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "docstrings ok (${length (bookModules book)} modules)\n")
  pure 0
else do
  _ <- printMissing (missingDocs book)
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "${length (missingDocs book)} missing docstring(s)\n")
  pure 1

printMissing : List String -> Eff hostRow Int
printMissing [] = pure 0
printMissing (line :: rest) = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "${line}\n")
  printMissing rest

missingDocs : DocBook -> List String
missingDocs book = concatMap missingInModule (bookModules book)

missingInModule : DocModule -> List String
missingInModule m = concatMap (missingInItem m) (moduleItems m)

missingInItem : DocModule -> DocItem -> List String
missingInItem m item =
  if itemDoc item == "" then ["missing docstring: ${moduleName m}.${itemName item} (${modulePath m}:${itemLine item})"]
  else []

-- ---------------------------------------------------------------
-- 写出
-- ---------------------------------------------------------------
writeHtml : String -> DocBook -> Eff hostRow Int
writeHtml out book =
  let
    content = renderPage book
  in do
    _ <- ensureDirPath (parentOf out)
    _ <- raiseToRow hostRow (@vuna@prim_eff_writeFile out content)
    _ <- raiseToRow hostRow (@vuna@prim_eff_print "wrote ${out} (${length (bookModules book)} modules)\n")
    pure 0

docError : String -> Eff hostRow Int
docError e = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "error: ${e}\n")
  pure 2

maybeText : Maybe String -> String
maybeText Nothing = "(none)"
maybeText (Just s) = s
