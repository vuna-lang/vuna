module Vuna.Fmt.Comment where

-- Vuna.Fmt.Comment：注释保留（M11.6）。
--
-- 注释不在 AST 里，格式化器单独 lex 出注释，按源码位置挂到最近的「条目」
-- （顶部声明/import/`infix*` 声明/构造器/记录字段/trait 方法/let 与 where 绑定/case 分支/
-- do 语句）：
-- 单独成行的注释成为下一条目的前置注释，写在同一行末尾的注释成为该条目的行尾注释；
-- 表达式内部的注释前移到最内层包含它的条目（没有则前移到下一条目；文件末尾的注释
-- 保留在文件末尾）。
--
-- M24 后维护·源码重组：从 Vuna.Fmt 拆出；暴露 anchorSpans / assignComments / attachAt 给
-- 门面与 Expr / Decl。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Fmt.Util

-- ---------------------------------------------------------------
-- 注释：渲染与「条目」定位
--
-- 注释行插入规则（保证幂等）：
-- - 前置注释在条目缩进处单独成行，条目原有内容不变；
-- - 行尾注释（仅单行注释）追加在该条目最后一行末尾；
-- - 多行块注释一律以「前置」形式插入（不挂在行尾）。
-- ---------------------------------------------------------------
isLineComment : Comment -> Bool
isLineComment c = case c.commentKind of
  CLine => True
  CBlock => False

containsNewline : String -> Bool
containsNewline s = hasNewlineChar (strUnpack s)

hasNewlineChar : List Int -> Bool
hasNewlineChar [] = False
hasNewlineChar (c :: rest) = c == 10 || hasNewlineChar rest

isSingleLineComment : Comment -> Bool
isSingleLineComment c = not (containsNewline c.commentText)

inlineCommentText : Comment -> String
inlineCommentText c = case c.commentKind of
  CLine => "--${c.commentText}"
  CBlock => "{-${c.commentText}-}"

trimRightSpaces : String -> String
trimRightSpaces s = strPack (reverse (dropReverseSpaces (reverse (strUnpack s))))

dropReverseSpaces : List Int -> List Int
dropReverseSpaces [] = []
dropReverseSpaces (c :: rest) = if c == 32 || c == 9 then dropReverseSpaces rest else c :: rest

-- 按 `\n` 切分（保留末尾空段，块注释原文用）。
splitOnNewline : String -> List String
splitOnNewline s = splitNewlineChars (strUnpack s) [] []

splitNewlineChars : List Int -> List String -> List Int -> List String
splitNewlineChars [] acc seg = reverse (strPack (reverse seg) :: acc)
splitNewlineChars (c :: rest) acc seg =
  if c == 10 then splitNewlineChars rest (strPack (reverse seg) :: acc) []
  else splitNewlineChars rest acc (c :: seg)

-- 去掉至多 n 个前导空格（块注释续行的公共缩进）。
dropSpacesUpTo : Int -> String -> String
dropSpacesUpTo n line = if n <= 0 then line
else case strUnpack line of
  c :: rest => if c == 32 then dropSpacesUpTo (n - 1) (strPack rest) else line
  [] => line

-- 块注释续行：去掉原来的起始列缩进，再按目标缩进重排（只改空白，不改正文）。
commentContinuation : Int -> Int -> String -> String
commentContinuation indent stripN line =
  let
    trimmed = trimRightSpaces (dropSpacesUpTo stripN line)
  in if trimmed == "" then "" else spaces indent ++ trimmed

-- 最后一行保留原行尾空白（`-}` 前通常有一个空格），只去除起始列缩进。
commentTailLines : Int -> Int -> List String -> List String
commentTailLines indent stripN [] = []
commentTailLines indent stripN ([line]) = ["${spaces indent}${dropSpacesUpTo stripN line}-}"]
commentTailLines indent stripN (line :: rest) =
  commentContinuation indent stripN line :: commentTailLines indent stripN rest

blockCommentLines : Int -> Comment -> List String
blockCommentLines indent c =
  let
    textLines = splitOnNewline c.commentText
    stripN = spanStartCol (commentSpan c) - 1
  in case textLines of
    [] => ["${spaces indent}{- -}"]
    first :: rest =>
      "${spaces indent}{-${trimRightSpaces first}" :: commentTailLines indent stripN rest

export commentLeadLines : Int -> Comment -> List String
commentLeadLines indent c = case c.commentKind of
  CLine => ["${spaces indent}--${c.commentText}"]
  CBlock =>
    if containsNewline c.commentText then blockCommentLines indent c
    else ["${spaces indent}{-${c.commentText}-}"]

-- 位置比较与附件表 ------------------------------------------------
posBefore : Int -> Int -> Int -> Int -> Bool
posBefore l1 c1 l2 c2 = l1 < l2 || l1 == l2 && c1 < c2

posBeforeOrEq : Int -> Int -> Int -> Int -> Bool
posBeforeOrEq l1 c1 l2 c2 = l1 < l2 || l1 == l2 && c1 <= c2

-- 注释起点是否落在条目 span 内。
containsPos : Span -> Int -> Int -> Bool
containsPos sp line col =
  posBeforeOrEq (spanStartLine sp) (spanStartCol sp) line col
    && posBeforeOrEq line col (spanEndLine sp) sp.spanEndCol

-- 最内层包含注释的条目（起点最晚者）。
innermostEnclosing : List Span -> Span -> Maybe Span
innermostEnclosing anchors csp = enclosingFold Nothing anchors csp

enclosingFold : Maybe Span -> List Span -> Span -> Maybe Span
enclosingFold best [] csp = best
enclosingFold best (sp :: rest) csp = if containsPos sp (spanStartLine csp) (spanStartCol csp) then case best of
  Nothing => enclosingFold (Just sp) rest csp
  Just b =>
    if betterNext sp b then enclosingFold (Just sp) rest csp else enclosingFold best rest csp
else enclosingFold best rest csp

sameKey : Pair Int Int -> Pair Int Int -> Bool
sameKey (Pair l c) (Pair l2 c2) = l == l2 && c == c2

-- 附件表：条目起点 (行, 列) -> (前置注释, 行尾注释)。
lookupSlot : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> Maybe (Pair (List Comment) (List Comment))
lookupSlot [] line col = Nothing
lookupSlot ((Pair key slot) :: rest) line col =
  if sameKey key (Pair line col) then Just slot else lookupSlot rest line col

leadOf : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> List Comment
leadOf at line col = case lookupSlot at line col of
  Nothing => []
  Just slot => firstOf slot

trailOf : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> List Comment
trailOf at line col = case lookupSlot at line col of
  Nothing => []
  Just slot => secondOf slot

addToSlot : Pair Int Int -> Bool -> Comment -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment)))
addToSlot key isTrail comment [] =
  if isTrail then [Pair key (Pair [] [comment])] else [Pair key (Pair [comment] [])]
addToSlot key isTrail comment ((Pair k slot) :: rest) = if sameKey k key then
  let
    newSlot =
      if isTrail then Pair (firstOf slot) (append (secondOf slot) [comment])
      else Pair (append (firstOf slot) [comment]) (secondOf slot)
  in Pair key newSlot :: rest
else Pair k slot :: addToSlot key isTrail comment rest

-- 行尾注释候选：与注释同行的、结束于注释之前的最近条目（结束列最大；
-- 同列时取起点更晚者，即更深层条目）。
trailCandidate : Span -> Span -> Bool
trailCandidate sp csp = spanEndLine sp == spanStartLine csp && sp.spanEndCol < spanStartCol csp

betterTrail : Span -> Span -> Bool
betterTrail sp b =
  let
    ec = sp.spanEndCol
    bc = b.spanEndCol
  in if ec > bc then True
  else if ec < bc then False
  else posBefore (spanStartLine b) (spanStartCol b) (spanStartLine sp) (spanStartCol sp)

bestTrailAnchor : List Span -> Span -> Maybe Span
bestTrailAnchor anchors csp = trailFold Nothing anchors csp

trailFold : Maybe Span -> List Span -> Span -> Maybe Span
trailFold best [] csp = best
trailFold best (sp :: rest) csp = if trailCandidate sp csp then case best of
  Nothing => trailFold (Just sp) rest csp
  Just b => if betterTrail sp b then trailFold (Just sp) rest csp else trailFold best rest csp
else trailFold best rest csp

-- 下一条目：起点严格晚于注释起点的最近条目。
isLaterAnchor : Span -> Span -> Bool
isLaterAnchor sp csp =
  posBefore (spanStartLine csp) (spanStartCol csp) (spanStartLine sp) (spanStartCol sp)

betterNext : Span -> Span -> Bool
betterNext sp b = posBefore (spanStartLine sp) (spanStartCol sp) (spanStartLine b) (spanStartCol b)

bestNextAnchor : List Span -> Span -> Maybe Span
bestNextAnchor anchors csp = nextFold Nothing anchors csp

nextFold : Maybe Span -> List Span -> Span -> Maybe Span
nextFold best [] csp = best
nextFold best (sp :: rest) csp = if isLaterAnchor sp csp then case best of
  Nothing => nextFold (Just sp) rest csp
  Just b => if betterNext sp b then nextFold (Just sp) rest csp else nextFold best rest csp
else nextFold best rest csp

export assignComments : List Span -> List Comment -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List Comment -> Pair (List (Pair (Pair Int Int) (Pair (List Comment) (List Comment)))) (List Comment)
assignComments anchors [] at eof = Pair at eof
assignComments anchors (c :: rest) at eof =
  let
    csp = commentSpan c
  in if isSingleLineComment c then case bestTrailAnchor anchors csp of
    Just sp =>
      assignComments anchors rest (addToSlot (Pair (spanStartLine sp) (spanStartCol sp)) True c at)
        eof
    Nothing => assignNextComment anchors c rest at eof
  else assignNextComment anchors c rest at eof

assignNextComment : List Span -> Comment -> List Comment -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List Comment -> Pair (List (Pair (Pair Int Int) (Pair (List Comment) (List Comment)))) (List Comment)
assignNextComment anchors c rest at eof = case nextAnchorWithFallback anchors (commentSpan c) of
  Just sp =>
    assignComments anchors rest (addToSlot (Pair (spanStartLine sp) (spanStartCol sp)) False c at)
      eof
  Nothing => assignComments anchors rest at (append eof [c])

-- 没有「下一条目」或下一条目已跳出当前声明时，注释前移到最内层包含它的条目之前
-- （例如函数体末尾的注释回到该函数上方，而不是下一位函数上方）。
nextAnchorWithFallback : List Span -> Span -> Maybe Span
nextAnchorWithFallback anchors csp = case bestNextAnchor anchors csp of
  Nothing => case innermostEnclosing anchors csp of
    Nothing => Nothing
    Just enc => Just enc
  Just sp => case innermostEnclosing anchors csp of
    Nothing => Just sp
    Just enc =>
      if posBeforeOrEq (spanStartLine enc) (spanStartCol enc) (spanStartLine sp) (spanStartCol sp) && posBeforeOrEq (spanStartLine sp) (spanStartCol sp) (spanEndLine enc) enc.spanEndCol then Just sp
      else Just enc

-- 条目定位：收集所有可挂注释的语法条目 span（源码顺序）。
-- M30（B20）：trait 方法用方法签名 span（方法名到类型结束）。
traitMethodAnchor : TraitMethod -> Span
traitMethodAnchor m = traitMethodSpan m

importAnchor : Import -> Span
importAnchor imp = imp.importSpan

headerAnchors : Maybe ModDecl -> List Span
headerAnchors Nothing = []
headerAnchors (Just m) = append [m.modDeclSpan] (modDeclItemAnchors m)

-- 导出项也作为注释锚点：排序时项注释随项移动。
modDeclItemAnchors : ModDecl -> List Span
modDeclItemAnchors (ModDecl _ _ items _ _ _ _) = map exportItemSpan items

declAnchors : Decl -> List Span
declAnchors (DData name params kind ctors derivings viaField repr lin sp) = sp :: map ctorSpan ctors
declAnchors (DAxiom name ty sp) = [sp]
declAnchors (DExtern name cName ty sp) = [sp]
declAnchors (DSig name ctx ty sp) = [sp]
declAnchors (DFun name pats body sp) = sp :: exprAnchors body
declAnchors (DRecord name params fields derivings viaField repr lin sp) = sp :: map fieldSpan fields
declAnchors (DTrait name params methods sp) = sp :: map traitMethodAnchor methods
declAnchors (DInstance ctxE head methods sp) = sp :: concatMap declAnchors methods

bindingAnchor : Pair Pat Expr -> Span
bindingAnchor (Pair pat value) = patSpan pat

bindingValueAnchors : Pair Pat Expr -> List Span
bindingValueAnchors (Pair pat value) = exprAnchors value

altAnchor : Pair Pat Expr -> Span
altAnchor (Pair pat body) = patSpan pat

altBodyAnchors : Pair Pat Expr -> List Span
altBodyAnchors (Pair pat body) = exprAnchors body

fieldExprAnchors : Pair String Expr -> List Span
fieldExprAnchors (Pair fname value) = exprAnchors value

doStmtAnchors : DoStmt -> List Span
doStmtAnchors (DBind pat value sp) = sp :: exprAnchors value
doStmtAnchors (DExpr value sp) = sp :: exprAnchors value

exprAnchors : Expr -> List Span
exprAnchors e = case e of
  EVar name sp => []
  EInt n sp => []
  EStr s sp => []
  EFloat raw sp => []
  ELam ps body sp => exprAnchors body
  EApp fn args sp => append (exprAnchors fn) (concatMap exprAnchors args)
  EPi name implicit _ dom cod sp => append (exprAnchors dom) (exprAnchors cod)
  ELet binds body rec_ sp =>
    append (append (map bindingAnchor binds) (concatMap bindingValueAnchors binds))
      (exprAnchors body)
  ECase scrut alts sp =>
    append (exprAnchors scrut) (append (map altAnchor alts) (concatMap altBodyAnchors alts))
  EIf c t el sp => append (exprAnchors c) (append (exprAnchors t) (exprAnchors el))
  EField base f sp => exprAnchors base
  ERecord name fields sp => concatMap fieldExprAnchors fields
  ERecUpdate base fields sp => append (exprAnchors base) (concatMap fieldExprAnchors fields)
  EDo stmts sp => concatMap doStmtAnchors stmts
  -- M24：where 绑定签名行（`g : Int -> Int`）本身是注释锚点（前置/行尾注释挂签名行）。
  EAnn value ty sp => sp :: exprAnchors value
  -- A2：where/let 多 clause 局部函数：每个 clause body 的表达式锚点。
  ELocalFun clauses sp => concatMap localClauseAnchors clauses
  EInfix op l r sp => append (exprAnchors l) (exprAnchors r)
  EParen inner sp => exprAnchors inner
  -- M31.3：反引号中缀 / section 是 parse 后中间产物；子表达式里的注释仍要前移。
  EBacktick name l r sp => append (exprAnchors l) (exprAnchors r)
  ESectOp op sp => []
  ESectL op inner sp => exprAnchors inner
  ESectR inner op sp => exprAnchors inner
  -- M36：模板字面量：洞内表达式的注释锚点照常收集（注释仍在字面量内，但会被提升到
  -- 外层条目——注释在 `${...}` 里不进 AST，见 Lexer 的说明）。
  EInterp multi parts sp => concatMap interpPartAnchors parts

interpPartAnchors : InterpPart -> List Span
interpPartAnchors (IPText s) = []
interpPartAnchors (IPHole e) = exprAnchors e

localClauseAnchors : Pair (List Pat) Expr -> List Span
localClauseAnchors (Pair pats body) = exprAnchors body

-- M31.3：`infix*` 声明的 span 也是注释锚点（前置/行尾注释随声明保留）。
export anchorSpans : Maybe ModDecl -> List Import -> List FixityDecl -> List Decl -> List Span
anchorSpans hdr imports fixities decls =
  append (headerAnchors hdr)
    (append (map importAnchor imports) (append (map fixitySpan fixities) (concatMap declAnchors decls)))

-- 把附件表应用到条目渲染结果上：前置注释在上，行尾注释追加到最后一行。
leadingLines : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Span -> Int -> List String
leadingLines at sp indent =
  concatMap (\c => commentLeadLines indent c) (leadOf at (spanStartLine sp) (spanStartCol sp))

trailingOn : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Span -> List String -> List String
trailingOn at sp lines = case trailOf at (spanStartLine sp) (spanStartCol sp) of
  [] => lines
  cs => foldl (\acc, c => appendLast " ${inlineCommentText c}" acc) lines cs

export attachAt : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Span -> Int -> List String -> List String
attachAt at sp indent lines = append (leadingLines at sp indent) (trailingOn at sp lines)

-- 导出项是否挂了注释（前置或行尾）：有注释时强制多行，避免单行把后续项注释掉。
itemHasComments : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> ExportItem -> Bool
itemHasComments at item =
  let
    sp = exportItemSpan item
  in case lookupSlot at (spanStartLine sp) (spanStartCol sp) of
    Nothing => False
    Just slot => not (isNilList (firstOf slot)) || not (isNilList (secondOf slot))

export anyItemHasComments : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List ExportItem -> Bool
anyItemHasComments at [] = False
anyItemHasComments at (item :: rest) = itemHasComments at item || anyItemHasComments at rest
