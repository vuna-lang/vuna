module Vuna.Fmt.Decl (filterSections, joinSections, renderSourceSections) where

-- Vuna.Fmt.Decl：声明 / 模块头 / import / `infix*` 声明的打印与文件组装（M24 后维护·源码
-- 重组，从 Vuna.Fmt 拆出；M31.3 加 fixity 声明打印与程序级 fixity 参数）。
--
-- 布局约定：2 空格缩进、顶层声明之间一个空行、文件末尾一个换行、无行尾空白；
-- `infix*` 声明放在 imports 之后、第一个声明之前（源码顺序，每行一条），单独成一个
-- section（与 imports / 声明之间各空一行）；导出列表按字面文本 ASCII 字典序排序
-- （`module B` 整模块重导出排最后），单行超 maxWidth 或含注释时逐项一行（逗号前置）。
-- where 块按 parser 的 ELet..True 形态还原成 where 写法（带签名绑定先输出签名行）。
--
-- env = 程序可见的 fixity 闭包（本地声明在最前），只用于打印侧的优先级/别名判定。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Fmt.Comment
import Vuna.Fmt.Expr
import Vuna.Fmt.Util
import Base.Sort

-- ---------------------------------------------------------------
-- M38：线性声明前缀。
linearPrefix : Bool -> String
linearPrefix True = "linear "
linearPrefix False = ""

-- R1（records-v2）：声明前缀 = 表示档位前缀 + 线性前缀（`transparent record` / `lin record`）。
declPrefix : ReprTier -> Bool -> String
declPrefix tier lin = reprPrefix tier ++ linearPrefix lin

-- 声明渲染
-- ---------------------------------------------------------------
renderDeclAt : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Decl -> List String
renderDeclAt env at lineInd decl =
  attachAt at (declSpan decl) lineInd (renderDeclBody env at lineInd decl)

renderDeclBody : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Decl -> List String
renderDeclBody env at lineInd (DData name params kind ctors derivings viaField repr lin sp) =
  renderDataDecl env at viaField (declPrefix repr lin) name params kind ctors derivings
renderDeclBody env at lineInd (DAxiom name ty sp) = renderSigLine env at lineInd "axiom " name [] ty
renderDeclBody env at lineInd (DExtern name cName ty sp) =
  renderSigLine env at lineInd "extern ${name} ${strShow cName}" "" [] ty
renderDeclBody env at lineInd (DSig name ctx ty sp) = renderSigLine env at lineInd "" name ctx ty
renderDeclBody env at lineInd (DFun name pats body sp) = renderClause env at lineInd name pats body
renderDeclBody env at lineInd (DRecord name params fields derivings viaField repr lin sp) =
  renderRecordDecl env at viaField (declPrefix repr lin) name params fields derivings
renderDeclBody env at lineInd (DTrait name params methods sp) =
  renderTraitDecl env at name params methods
renderDeclBody env at lineInd (DInstance ctxE head methods sp) =
  renderInstanceDecl env at ctxE head methods

-- 顶层签名与 axiom 声明共用：`<prefix>name : Ty`（prefix 为 "" 或 "axiom "）。
renderSigLine : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> String -> String -> List Expr -> Expr -> List String
renderSigLine env at lineInd prefix name ctx ty =
  prefixFirst "${spaces lineInd}${prefix}${name} : ${renderInstanceCtx env ctx}"
    (renderTypeExpr env at lineInd ty)

renderDataDecl : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Bool -> String -> String -> List String -> Expr -> List Ctor -> List String -> List String
renderDataDecl env at viaField prefix name params kind ctors derivings =
  let
    header =
      "${prefix}data ${name}${joinSpace params} : ${join " " (renderTypeExpr env at 0 kind)} where"
    ctorLines = concatMap (\c => renderCtorDecl env at c) ctors
  in append [header] (append ctorLines (renderDerivings viaField derivings))

renderCtorDecl : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Ctor -> List String
renderCtorDecl env at (Ctor cname ty arity sp) =
  attachAt at sp 2 (prefixFirst "  ${cname} : " (renderTypeExpr env at 2 ty))

renderDerivings : Bool -> List String -> List String
renderDerivings viaField [] = []
renderDerivings viaField names =
  if viaField then ["deriving via field (${joinComma names})"]
  else ["deriving (${joinComma names})"]

renderRecordDecl : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Bool -> String -> String -> List String -> List Field -> List String -> List String
renderRecordDecl env at viaField prefix name params fields derivings =
  let
    header = "${prefix}record ${name}${joinSpace params} where"
    fieldLines = concatMap (\f => renderRecordField env at f) fields
  in append [header] (append fieldLines (renderDerivings viaField derivings))

renderRecordField : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Field -> List String
renderRecordField env at f =
  attachAt at (fieldSpan f) 2
    (prefixFirst "  ${fieldName f} : " (renderTypeExpr env at 2 (fieldType f)))

renderTraitDecl : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> String -> List TraitParam -> List TraitMethod -> List String
renderTraitDecl env at name params methods =
  let
    header = "trait ${name}${joinSpace (map (traitParamText env at) params)} where"
    methodLines = concatMap (\m => renderMethodSig env at m) methods
  in append [header] methodLines

-- M30（B20）：注释锚点用方法签名 span（方法名到类型结束），不再用类型表达式 span。
traitParamText : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> TraitParam -> String
traitParamText env at (TraitParam n Nothing) = n
traitParamText env at (TraitParam n (Just k)) = "(${n} : ${join " " (renderTypeExpr env at 0 k)})"

renderMethodSig : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> TraitMethod -> List String
renderMethodSig env at m =
  attachAt at (traitMethodSpan m) 2
    (prefixFirst "  ${traitMethodName m} : " (renderTypeExpr env at 2 m.traitMethodType))

renderInstanceDecl : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List Expr -> Expr -> List Decl -> List String
renderInstanceDecl env at ctxE head methods =
  let
    headLines = case inlineExpr env head of
      Just s => [s]
      Nothing => parenWrapInd env at 0 head
    ctxText = renderInstanceCtx env ctxE
    headLine = appendLast " where" (prefixFirst "instance ${ctxText}" headLines)
    methodLines = concatMap (\d => renderDeclAt env at 2 d) methods
  in append headLine methodLines

-- 实例上下文：`C a, C b => `（M29 起实例可带 ctx；空 ctx 与旧输出逐字一致）。
renderInstanceCtx : List FixityDecl -> List Expr -> String
renderInstanceCtx env [] = ""
renderInstanceCtx env ctxE = "${joinTexts ", " (map (renderOneCtx env) ctxE)} => "

joinTexts : String -> List String -> String
joinTexts sep [] = ""
joinTexts sep ([x]) = x
joinTexts sep (x :: rest) = x ++ sep ++ joinTexts sep rest

renderOneCtx : List FixityDecl -> Expr -> String
renderOneCtx env e = case inlineExpr env e of
  Just s => s
  Nothing => "…"

-- 函数子句 / instance 方法子句 / where 绑定子句共用。
-- where 块（parser desugar 成 ELet .. True）优先按 where 形式还原。
renderClause : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> String -> List Pat -> Expr -> List String
renderClause env at lineInd name pats body =
  let
    headerBase = "${spaces lineInd}${name}${joinSpace (map renderPatAtom pats)} ="
  in case body of
    ELet binds inner recFlag sp => if recFlag then
      let
        whereInd = lineInd + 2
      in case inlinePrec env 0 inner of
        Just s => "${headerBase} ${s} where" :: renderWhereBindings env at whereInd binds
        Nothing =>
          let
            bodyInd = lineInd + 2
            bodyLines = prefixFirst (spaces bodyInd) (renderExpr env at bodyInd inner)
            whereLine = "${spaces whereInd}where"
            bindLines = renderWhereBindings env at (lineInd + 4) binds
          in headerBase :: append bodyLines (whereLine :: bindLines)
    else headerBase :: prefixFirst (spaces (lineInd + 2)) (renderExpr env at (lineInd + 2) body)
    _ => case inlinePrec env 0 body of
      Just s =>
        if strWidth "${headerBase} ${s}" <= maxWidth then ["${headerBase} ${s}"]
        else headerBase :: prefixFirst (spaces (lineInd + 2)) (renderExpr env at (lineInd + 2) body)
      Nothing => prefixFirst "${headerBase} " (renderExpr env at lineInd body)

renderWhereBindings : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> List (Pair Pat Expr) -> List String
renderWhereBindings env at lineInd binds =
  concatMap (\b => renderWhereBinding env at lineInd b) binds

renderWhereBinding : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pair Pat Expr -> List String
renderWhereBinding env at lineInd (Pair pat value) = case value of
  -- M24：带签名的 where 绑定先输出 `name : Ty` 独立一行，再按原格式输出子句。
  EAnn inner ty annSp =>
    append (attachAt at annSp lineInd (renderWhereSigLine env at lineInd pat ty))
      (attachAt at (patSpan pat) lineInd (renderWhereBindingBody env at lineInd pat inner))
  _ => attachAt at (patSpan pat) lineInd (renderWhereBindingBody env at lineInd pat value)

-- where 绑定签名行：`g : Int -> Int`（缩进与 where 绑定一致，类型不折行）。
renderWhereSigLine : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pat -> Expr -> List String
renderWhereSigLine env at lineInd (PVar name psp) ty =
  prefixFirst "${spaces lineInd}${name} : " (renderTypeExpr env at lineInd ty)
renderWhereSigLine env at lineInd pat ty =
  prefixFirst "${spaces lineInd}${renderPat pat} : " (renderTypeExpr env at lineInd ty)

renderWhereBindingBody : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pat -> Expr -> List String
renderWhereBindingBody env at lineInd (PVar name psp) value = case value of
  ELocalFun clauses lsp => renderLocalFunClauses env at lineInd name clauses
  ELam ps inner lsp => renderClause env at lineInd name (map (\n => PVar n dummySpan) ps) inner
  _ => renderBindingValue env at lineInd "${name} =" value
renderWhereBindingBody env at lineInd pat value =
  renderBindingValue env at lineInd "${renderPat pat} =" value

-- A2：where 内部多 clause 局部函数：每个 clause 走 `renderClause`（与顶层子句同形）。
renderLocalFunClauses : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> String -> List (Pair (List Pat) Expr) -> List String
renderLocalFunClauses env at lineInd name [] = []
renderLocalFunClauses env at lineInd name ((Pair pats body) :: rest) =
  append (renderClause env at lineInd name pats body)
    (renderLocalFunClauses env at lineInd name rest)

-- 顶层声明：不同函数之间一个空行；类型签名紧贴同名函数子句。
renderTopDecls : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List Decl -> List String
renderTopDecls env at [] = []
renderTopDecls env at (d :: rest) = append (renderDeclAt env at 0 d) (renderTopRest env at d rest)

renderTopRest : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Decl -> List Decl -> List String
renderTopRest env at prev [] = []
renderTopRest env at prev (d :: rest) =
  if attachDecl prev d then append (renderDeclAt env at 0 d) (renderTopRest env at d rest)
  else "" :: append (renderDeclAt env at 0 d) (renderTopRest env at d rest)

attachDecl : Decl -> Decl -> Bool
attachDecl prev (DFun n pats body sp) = declNamed prev n
attachDecl prev _ = False

declNamed : Decl -> String -> Bool
declNamed (DFun m pats body sp) n = m == n
declNamed (DSig m ctx ty sp) n = m == n
declNamed _ n = False

-- ---------------------------------------------------------------
-- 模块头 / import / `infix*` 声明 / 文件组装
-- ---------------------------------------------------------------
renderModDecl : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> ModDecl -> List String
renderModDecl at (ModDecl name True items sp) = renderExplicitModDecl at name (sortExports items)
renderModDecl at (ModDecl name False items sp) = ["module ${name} where"]

-- 空导出列表（`module M () where`）与短列表保持单行；超宽或含项注释时逐项一行。
renderExplicitModDecl : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> String -> List ExportItem -> List String
renderExplicitModDecl at name [] = ["module ${name} () where"]
renderExplicitModDecl at name sorted =
  let
    oneLine = "module ${name} (${joinComma (map renderExportItem sorted)}) where"
  in if fitsLine 0 oneLine && not (anyItemHasComments at sorted) then [oneLine]
  else renderExportListBlock at name sorted

-- 多行导出列表（逗号前置）：首项 `( a`，其余 `, b`，收尾 `) where`。
renderExportListBlock : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> String -> List ExportItem -> List String
renderExportListBlock at name items =
  append ["module ${name}"] (append (renderExportLines at items) ["  ) where"])

renderExportLines : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List ExportItem -> List String
renderExportLines at [] = []
renderExportLines at (first :: rest) =
  append (renderExportLine at "  ( " first) (renderExportRest at rest)

renderExportRest : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List ExportItem -> List String
renderExportRest at [] = []
renderExportRest at (item :: rest) =
  append (renderExportLine at "  , " item) (renderExportRest at rest)

renderExportLine : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> String -> ExportItem -> List String
renderExportLine at prefixText item =
  attachAt at (exportItemSpan item) 2 [prefixText ++ renderExportItem item]

renderExportItem : ExportItem -> String
renderExportItem (XBare name sp) = name
renderExportItem (XTypeAll name sp) = "${name}(..)"
renderExportItem (XModule name sp) = "module ${name}"

-- 排序键：分组前缀（`module B` = 1，其余 = 0）++ 字面文本；稳定排序保证幂等。
exportRank : ExportItem -> Int
exportRank (XModule _ _) = 1
exportRank _ = 0

exportKey : ExportItem -> String
exportKey item = strFromInt (exportRank item) ++ renderExportItem item

strLeChars : List Int -> List Int -> Bool
strLeChars [] [] = True
strLeChars [] (y :: ys) = True
strLeChars (x :: xs) [] = False
strLeChars (x :: xs) (y :: ys) = x < y || (if x > y then False else strLeChars xs ys)

strLe : String -> String -> Bool
strLe a b = strLeChars (strUnpack a) (strUnpack b)

exportKeyLe : ExportItem -> ExportItem -> Bool
exportKeyLe a b = strLe (exportKey a) (exportKey b)

sortExports : List ExportItem -> List ExportItem
sortExports items = sortBy exportKeyLe items

renderImport : Import -> String
renderImport (Import name isQualified alias sp) =
  "import ${if isQualified then "qualified " else ""}${name}${aliasSuffix alias}"

aliasSuffix : Maybe String -> String
aliasSuffix Nothing = ""
aliasSuffix (Just a) = " as ${a}"

-- `infix` / `infixl` / `infixr`（FixityDecl 的结合性编码：0 = 无，1 = 左，2 = 右）。
assocKeyword : Int -> String
assocKeyword 1 = "infixl"
assocKeyword 2 = "infixr"
assocKeyword n = "infix"

-- 规范写法：`infixl 6 +` / `infixr 5 :: = Cons` / `infix 4 == = eq`。
renderFixityDecl : FixityDecl -> String
renderFixityDecl (FixityDecl op level assoc target sp) =
  "${assocKeyword assoc} ${level} ${op}${targetSuffix target}"

targetSuffix : Maybe String -> String
targetSuffix Nothing = ""
targetSuffix (Just t) = " = ${t}"

renderFixityLine : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> FixityDecl -> List String
renderFixityLine at d = attachAt at (fixitySpan d) 0 [renderFixityDecl d]

renderHeader : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Maybe ModDecl -> List String
renderHeader at Nothing = []
renderHeader at (Just m) = attachAt at m.modDeclSpan 0 (renderModDecl at m)

renderImportLine : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Import -> List String
renderImportLine at imp = attachAt at imp.importSpan 0 [renderImport imp]

renderEofComments : List Comment -> List String
renderEofComments [] = []
renderEofComments comments = concatMap (commentLeadLines 0) comments

-- 文件组装：模块头 / imports / `infix*` 声明 / 声明 / 文件末尾注释各成一个 section，
-- 非空 section 之间空一行（`filterSections` 去掉空 section 靠 `joinSections` 分隔）。
renderSourceSections : List FixityDecl -> Maybe ModDecl -> List Import -> List FixityDecl -> List Decl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> List Comment -> List (List String)
renderSourceSections env hdr imports fixities decls at eof =
  [ renderHeader at hdr,
    concatMap (renderImportLine at) imports,
    concatMap (renderFixityLine at) fixities,
    renderTopDecls env at decls,
    renderEofComments eof
  ]

filterSections : List (List String) -> List (List String)
filterSections [] = []
filterSections (section :: rest) = case section of
  [] => filterSections rest
  _ => section :: filterSections rest

joinSections : List (List String) -> List String
joinSections [] = []
joinSections ([section]) = section
joinSections (section :: rest) = append section ("" :: joinSections rest)
