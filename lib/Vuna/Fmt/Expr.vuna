module Vuna.Fmt.Expr
  ( inlineExpr
  , inlinePrec
  , parenWrapInd
  , renderBindingValue
  , renderExpr
  , renderPat
  , renderPatAtom
  , renderTypeExpr
  ) where

-- Vuna.Fmt.Expr：表达式 / 模式 / 块级布局的打印（M24 后维护·源码重组，从 Vuna.Fmt 拆出）。
--
-- 单行形式（inlinePrecGo，按运算符优先级补括号；case/let/do 返回 Nothing）与块级形式
-- （renderExprGo → renderBlockGo/renderWideGo，按 maxWidth 折行）共用同一份模式与中缀表。
-- 注释锚点由 Vuna.Fmt.Comment 提供（attachAt）。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Frontend.Lexer
import Vuna.Fmt.Comment
import Vuna.Fmt.Util

-- ---------------------------------------------------------------
-- 字符串字面量：按 lexer 支持的转义重新编码
-- ---------------------------------------------------------------
escapeChar : Int -> String
escapeChar 34 = strPack [92, 34]
escapeChar 92 = strPack [92, 92]
escapeChar 10 = strPack [92, 110]
escapeChar 9 = strPack [92, 116]
escapeChar 13 = strPack [92, 114]
escapeChar c = strPack [c]

renderStr : String -> String
renderStr s = "\"" ++ renderTemplateText False s ++ "\""

-- ---------------------------------------------------------------
-- 模板 / 多行字面量（M36）
--
-- 规范形：
--   * 单行形式（`multi = False`、以及普通 `EStr`）：`"..."`，换行/制表转义；
--   * 多行形式（`multi = True`，来自源码 `"""`）：`"""..."""`，内容换行原样保留；
--   * 文本里的 `$` 紧跟 `{` 时写成 `\$`，否则会被重新解析成插值洞；
--   * 与 lexer「丢掉紧跟开引号的一个换行」互逆：首块以换行开头时先补一个换行。
-- 洞内表达式照常格式化；非单行可渲的洞（case/do/let）换到多行布局（换行只出现在
-- `${...}` 内部，仍属于代码，不影响字面量文本）。
-- ---------------------------------------------------------------
-- 文本块编码（`multi` 决定换行/制表是否原样）。
renderTemplateText : Bool -> String -> String
renderTemplateText multi s = strPack (reverse (renderTemplateTextGo multi (strUnpack s) []))

renderTemplateTextGo : Bool -> List Int -> List Int -> List Int
renderTemplateTextGo multi [] acc = acc
renderTemplateTextGo multi (c :: rest) acc = if c == 92 then renderTemplateTextGo multi rest (92 :: 92 :: acc)
else if c == 34 then renderTemplateTextGo multi rest (34 :: 92 :: acc)
else if c == 10 then if multi then renderTemplateTextGo multi rest (10 :: acc)
else renderTemplateTextGo multi rest (110 :: 92 :: acc)
else if c == 9 then if multi then renderTemplateTextGo multi rest (9 :: acc)
else renderTemplateTextGo multi rest (116 :: 92 :: acc)
else if c == 13 then if multi then renderTemplateTextGo multi rest (13 :: acc)
else renderTemplateTextGo multi rest (114 :: 92 :: acc)
else if c == 36 then case rest of
  c2 :: rest2 =>
    if c2 == 123 then renderTemplateTextGo multi rest2 (123 :: 36 :: 92 :: acc)
    else renderTemplateTextGo multi rest (36 :: acc)
  [] => renderTemplateTextGo multi rest (36 :: acc)
else renderTemplateTextGo multi rest (c :: acc)

startsWithNewline : String -> Bool
startsWithNewline s = case strUnpack s of
  10 :: rest => True
  _ => False

-- 开引号（多行形式：首块以换行开头时补一个换行，与 lexer 的「丢首个换行」互逆）。
interpOpen : Bool -> List InterpPart -> String
interpOpen multi parts = if multi then case parts of
  (IPText s) :: rest => if startsWithNewline s then "\"\"\"\n" else "\"\"\""
  _ => "\"\"\""
else "\""

interpClose : Bool -> String
interpClose multi = if multi then "\"\"\"" else "\""

-- 块布局洞的续行缩进（`lineInd + 2`）；不递归调用格式化器，SCT 组之外。
joinHoleLines : Int -> List String -> String
joinHoleLines lineInd [] = ""
joinHoleLines lineInd (first :: rest) =
  first ++ concatStrings (map (\l => "\n" ++ spaces (lineInd + 2) ++ l) rest)

-- 单个模板片段的字符串（M36）：文本块转义；洞单行可渲则 `${...}`，否则：
--   * 单行渲染用哨兵 `interpBlockMarker` 表示「这个字面量必须走块布局」；
-- 模板片段逐个渲染成字符串（M36），拼接交给调用方。
-- 自递归只在 `parts` 上、fuel 严格递减；洞的递归仍走格式化器的递归组。
interpPiecesInline : Int -> List FixityDecl -> Bool -> List InterpPart -> List String
interpPiecesInline fuel env multi parts = if fuel <= 0 then []
else case parts of
  [] => []
  (IPText s) :: rest => renderTemplateText multi s :: interpPiecesInline (fuel - 1) env multi rest
  (IPHole e) :: rest => case inlinePrecGo (fuel - 1) env 0 e of
    Just s => ("$" ++ "{" ++ s ++ "}") :: interpPiecesInline (fuel - 1) env multi rest
    Nothing => interpBlockMarker :: interpPiecesInline (fuel - 1) env multi rest

interpPiecesBlock : Int -> List FixityDecl -> Int -> Bool -> List InterpPart -> List String
interpPiecesBlock fuel env lineInd multi parts = if fuel <= 0 then []
else case parts of
  [] => []
  (IPText s) :: rest =>
    renderTemplateText multi s :: interpPiecesBlock (fuel - 1) env lineInd multi rest
  (IPHole e) :: rest => case inlinePrecGo (fuel - 1) env 0 e of
    Just s => ("$" ++ "{" ++ s ++ "}") :: interpPiecesBlock (fuel - 1) env lineInd multi rest
    Nothing =>
      ("$" ++ "{" ++ joinHoleLines lineInd (renderExprGo (fuel - 1) env [] lineInd e) ++ "}")
        :: interpPiecesBlock (fuel - 1) env lineInd multi rest

-- 按换行切行（内容换行是字面量内容，不参与外层布局）。
splitOnNewline : String -> List String
splitOnNewline s = splitOnNewlineGo (strUnpack s) []

splitOnNewlineGo : List Int -> List Int -> List String
splitOnNewlineGo [] acc = strPack (reverse acc) :: []
splitOnNewlineGo (c :: rest) acc =
  if c == 10 then strPack (reverse acc) :: splitOnNewlineGo rest []
  else splitOnNewlineGo rest (c :: acc)

-- 单行渲染里洞无法内联时的哨兵（源码字符串不可能含 NUL）。
interpBlockMarker : String
interpBlockMarker = strPack [0]

-- ---------------------------------------------------------------
-- 模式（模式没有块结构，统一输出单行，必要时加括号）
-- ---------------------------------------------------------------
-- M31.3：keep 模式下 parser 的两种 cons 拼写都保留（中缀 `::` 与列表语法的 `Cons`；
-- `[..]` 列表模式构造的是 canonical 的 `Cons`/`Nil`）。
consPatName : String -> Bool
consPatName name = name == "Cons" || name == "::"

patListElemsOf : String -> List Pat -> Maybe (List Pat)
patListElemsOf name pats = if name == "Nil" then if isNilList pats then Just [] else Nothing
else if consPatName name then case pats of
  [a, rest] => case patListElems rest of
    Just elems => Just (a :: elems)
    Nothing => Nothing
  _ => Nothing
else Nothing

patListElems : Pat -> Maybe (List Pat)
patListElems (PCon name pats sp) = patListElemsOf name pats
patListElems _ = Nothing

-- 列表渲染改为显式结构递归：`map renderPatGo` 的 λ 没有 size 关系，SCT 会判成无下降环。
renderPatElemsGo : Int -> List Pat -> String
renderPatElemsGo fuel pats = if fuel <= 0 then ""
else case pats of
  [] => ""
  [p] => renderPatGo (fuel - 1) p
  p :: rest => renderPatGo (fuel - 1) p ++ ", " ++ renderPatElemsGo (fuel - 1) rest

renderPatAtomsSpacedGo : Int -> List Pat -> String
renderPatAtomsSpacedGo fuel pats = if fuel <= 0 then ""
else case pats of
  [] => ""
  p :: rest => " " ++ renderPatAtomGo (fuel - 1) p ++ renderPatAtomsSpacedGo (fuel - 1) rest

renderRecPatFieldsGo : Int -> List (Pair String Pat) -> String
renderRecPatFieldsGo fuel fields = if fuel <= 0 then ""
else case fields of
  [] => ""
  [f] => renderRecPatFieldGo (fuel - 1) f
  f :: rest => renderRecPatFieldGo (fuel - 1) f ++ ", " ++ renderRecPatFieldsGo (fuel - 1) rest

renderPatGo : Int -> Pat -> String
renderPatGo fuel pat = if fuel <= 0 then ""
else case pat of
  PVar name sp => name
  PAs name inner sp => name ++ "@" ++ renderPatAtomGo (fuel - 1) inner
  PWild sp => "_"
  PInt n sp => strFromInt n
  PStr s sp => renderStr s
  PCon name pats sp => renderConPatGo (fuel - 1) name pats
  PRecord name fields sp => renderRecPatGo (fuel - 1) name fields

renderConPatGo : Int -> String -> List Pat -> String
renderConPatGo fuel name pats = if fuel <= 0 then ""
else case patListElemsOf name pats of
  Just elems => "[" ++ renderPatElemsGo (fuel - 1) elems ++ "]"
  Nothing =>
    if consPatName name then renderConsPatGo (fuel - 1) pats
    else if name == "Nil" && isNilList pats then "[]"
    else if isNilList pats then name else name ++ renderPatAtomsSpacedGo (fuel - 1) pats

renderConsPatGo : Int -> List Pat -> String
renderConsPatGo fuel pats = if fuel <= 0 then ""
else case pats of
  [a, b] => renderPatAtomGo (fuel - 1) a ++ " :: " ++ renderPatConsTailGo (fuel - 1) b
  _ => "Cons" ++ renderPatAtomsSpacedGo (fuel - 1) pats

renderPatConsTailGo : Int -> Pat -> String
renderPatConsTailGo fuel pat = if fuel <= 0 then ""
else case pat of
  PCon name pats sp => if consPatName name then case pats of
    [a, b] => renderPatAtomGo (fuel - 1) a ++ " :: " ++ renderPatConsTailGo (fuel - 1) b
    _ => renderPatAtomGo (fuel - 1) pat
  else renderPatAtomGo (fuel - 1) pat
  _ => renderPatAtomGo (fuel - 1) pat

renderPatAtomGo : Int -> Pat -> String
renderPatAtomGo fuel pat = if fuel <= 0 then ""
else case pat of
  PVar name sp => name
  PAs name inner sp => "(" ++ name ++ "@" ++ renderPatAtomGo (fuel - 1) inner ++ ")"
  PWild sp => "_"
  PInt n sp => strFromInt n
  PStr s sp => renderStr s
  PCon name [] sp => if name == "Nil" then "[]" else name
  PCon name pats sp => "(" ++ renderConPatGo (fuel - 1) name pats ++ ")"
  PRecord name fields sp => "(" ++ renderRecPatGo (fuel - 1) name fields ++ ")"

renderRecPatGo : Int -> String -> List (Pair String Pat) -> String
renderRecPatGo fuel name fields =
  if fuel <= 0 then ""
  else if isNilList fields then name ++ " { }"
  else name ++ " { " ++ renderRecPatFieldsGo (fuel - 1) fields ++ " }"

renderRecPatFieldGo : Int -> Pair String Pat -> String
renderRecPatFieldGo fuel (Pair fname pat) = if fuel <= 0 then ""
else case pat of
  PVar n sp => if n == fname then fname else fname ++ " = " ++ renderPatGo (fuel - 1) pat
  _ => fname ++ " = " ++ renderPatGo (fuel - 1) pat

-- ---------------------------------------------------------------
-- 单行表达式：inlineExprGo / inlinePrecGo / inlineAtomGo
-- inlinePrecGo 按运算符优先级决定是否补括号；块结构（case/let/do）返回 Nothing。
-- ---------------------------------------------------------------
-- 符号字符集（与 lexer 的 `isOpChar` 一致）：只有**整个名字都由符号字符组成**才是运算符
-- 符号名。`p.x` / `Mod.name` 这类带标识符字符的名字是记录字段/限定名，按原子名字原样打印。
isOpCharCode : Int -> Bool
isOpCharCode c =
  c == 33
    || c == 36
    || c == 37
    || c == 38
    || c == 42
    || c == 43
    || c == 45
    || c == 46
    || c == 47
    || c == 60
    || c == 61
    || c == 62
    || c == 63
    || c == 64
    || c == 92
    || c == 94
    || c == 124
    || c == 126
    || c == 58

allOpChars : List Int -> Bool
allOpChars [] = True
allOpChars (c :: rest) = isOpCharCode c && allOpChars rest

-- 符号名（`+`、`<+>`、`->`、`::`…）：中缀位置按 fixity 打印，原子/前缀位置必须打成
-- `(op)`，否则产物不可重新 parse。普通标识符（含 `bind`/`eq` 这类别名目标）按原样打印
-- ——格式化器只排版，不把 `bind a f` 改写成 `(>>=) a f`。
isSymbolName : String -> Bool
isSymbolName name = case strUnpack name of
  [] => False
  cs => allOpChars cs

-- 运算符的可见声明：直接查名字；未命中再按反向别名（`eq` -> `==`）查一次。
opDeclOf : List FixityDecl -> String -> Maybe FixityDecl
opDeclOf env op = case lookupFixityDecl (tableOfKeepOps env) op of
  Just d => Just d
  Nothing => case symbolOfTargetIn env op of
    Just sym => lookupFixityDecl (tableOfKeepOps env) sym
    Nothing => Nothing

-- canonical 别名目标（`Cons` -> `::`、`bind` -> `>>=`）：只有声明表里真的有这个反向
-- 别名才成立，所以不会误伤同名的普通函数。
hasOpAlias : List FixityDecl -> String -> Bool
hasOpAlias env name = case symbolOfTargetIn env name of
  Just sym => True
  Nothing => False

-- 中缀打印用的 (优先级, 结合性)：1 = 右，0 = 左/未知。
infixPrecOf : List FixityDecl -> String -> Maybe (Pair Int Int)
infixPrecOf env op = case opDeclOf env op of
  Just d => Just (Pair d.fixityLevel (if d.fixityAssoc == 2 then 1 else 0))
  Nothing => if isSymbolName op then Just (Pair 9 0) else Nothing

-- 打印侧优先级查询。Loader 的 keep 模式已对未知**符号**运算符报错，所以正常路径这里
-- 总有声明；剩下的 9 左只是打印侧兜底（反引号名字走 `backtickPrec` 的 9 左）。
infixPrec : List FixityDecl -> String -> Pair Int Int
infixPrec env op = case infixPrecOf env op of
  Just fx => fx
  Nothing => Pair 9 0

-- 反引号中缀的 fixity：普通名字无声明时按 9 左（与 Haskell 一致），符号名查声明表。
backtickPrec : List FixityDecl -> String -> Pair Int Int
backtickPrec env name = case opDeclOf env name of
  Just d => Pair d.fixityLevel (if d.fixityAssoc == 2 then 1 else 0)
  Nothing => Pair 9 0

-- 打印用的运算符文本：canonical 名字经反向别名还原（keep 模式下通常是原样）。
opText : List FixityDecl -> String -> String
opText env op = case symbolOfTargetIn env op of
  Just sym => sym
  Nothing => op

backtickLabel : String -> String
backtickLabel name = "`" ++ name ++ "`"

listExprElems : Expr -> Maybe (List Expr)
listExprElems (EVar "Nil" sp) = Just []
listExprElems (EApp (EVar "Cons" csp) ([a, rest]) sp) = case listExprElems rest of
  Just elems => Just (a :: elems)
  Nothing => Nothing
listExprElems _ = Nothing

inlineExprGo : Int -> List FixityDecl -> Expr -> Maybe String
inlineExprGo fuel env e = if fuel <= 0 then Nothing else inlinePrecGo (fuel - 1) env 0 e

inlinePrecGo : Int -> List FixityDecl -> Int -> Expr -> Maybe String
inlinePrecGo fuel env minPrec e = if fuel <= 0 then Nothing
else case e of
  EVar name sp =>
    if name == "Nil" then Just "[]"
    else if isSymbolName name then Just ("(" ++ name ++ ")") else Just name
  EInt n sp => Just (strFromInt n)
  EStr s sp => Just (renderStr s)
  -- M36：模板字面量。文本块转义；洞优先单行内联，洞需要块布局时放弃（交给块渲染）。
  EInterp multi parts sp =>
    let
      body = concatStrings (interpPiecesInline (fuel - 1) env multi parts)
      text = interpOpen multi parts ++ body ++ interpClose multi
    in if contains interpBlockMarker text then Nothing
    else if contains "\n" text then Nothing else Just text
  ELam ps body sp => case inlinePrecGo (fuel - 1) env 0 body of
    Nothing => Nothing
    Just b => Just (wrapPrec (minPrec > 0) ("\\" ++ joinComma ps ++ " => " ++ b))
  EApp fn args sp => case listExprElems (EApp fn args sp) of
    Just elems => case mapMaybeStrings (\x => inlineExprGo (fuel - 1) env x) elems of
      Nothing => Nothing
      Just ss => Just ("[" ++ joinComma ss ++ "]")
    Nothing => inlineAppGo (fuel - 1) env minPrec fn args
  EPi name implicit qty dom cod sp => inlinePiGo (fuel - 1) env minPrec qty name implicit dom cod
  ELet binds body rec_ sp => Nothing
  ECase scrut alts sp => Nothing
  EIf c t el sp => case inlinePrecGo (fuel - 1) env 0 c of
    Nothing => Nothing
    Just cs => case inlinePrecGo (fuel - 1) env 0 t of
      Nothing => Nothing
      Just ts => case inlinePrecGo (fuel - 1) env 0 el of
        Nothing => Nothing
        Just es => Just (wrapPrec (minPrec > 0) ("if " ++ cs ++ " then " ++ ts ++ " else " ++ es))
  EField base f sp => case inlineAtomGo (fuel - 1) env base of
    Nothing => Nothing
    Just b => Just (b ++ "." ++ f)
  ERecord name fields sp => case inlineFieldsGo (fuel - 1) env fields of
    Nothing => Nothing
    Just ss => case fields of
      [] => Just (name ++ " { }")
      _ => Just (name ++ " { " ++ joinComma ss ++ " }")
  ERecUpdate base fields sp => case inlinePrecGo (fuel - 1) env 0 base of
    Nothing => Nothing
    Just b => case inlineFieldsGo (fuel - 1) env fields of
      Nothing => Nothing
      Just ss => case fields of
        [] => Just ("{ " ++ b ++ " }")
        _ => Just ("{ " ++ b ++ " | " ++ joinComma ss ++ " }")
  EDo stmts sp => Nothing
  -- A2：局部函数组只作为 let/where 绑定值出现，由 `renderLetBindingGo` 展开成多子句。
  ELocalFun clauses sp => Nothing
  -- M24：非 where 位置（例如 `let` 绑定值）的 `EAnn` 透明渲染内部表达式：
  -- 表达式位置没有 `: Ty` 语法，输出标注会让 fmt 产物无法重新 parse。
  EAnn value ty sp => inlinePrecGo (fuel - 1) env minPrec value
  -- M31.3：反引号中缀 / section 是 parse 后中间产物；keep 模式保留原形按此打印。
  EBacktick name l r sp => inlineBacktickGo (fuel - 1) env minPrec name l r
  ESectOp op sp => Just ("(" ++ op ++ ")")
  ESectL op inner sp => case inlinePrecGo (fuel - 1) env 0 inner of
    Nothing => Nothing
    Just s => Just ("(" ++ op ++ " " ++ s ++ ")")
  -- 右 section 的 inner 必须按**原子**打印：`((a + b) +)` 才能重新 parse 成
  -- `ESectR (a + b) +`（否则最后一个 `+` 会被解析成更内层的右 section）。
  ESectR inner op sp => case inlineAtomGo (fuel - 1) env inner of
    Nothing => Nothing
    Just s => Just ("(" ++ s ++ " " ++ op ++ ")")
  _ => Nothing

wrapPrec : Bool -> String -> String
wrapPrec need s = if need then "(" ++ s ++ ")" else s

inlineFieldsGo : Int -> List FixityDecl -> List (Pair String Expr) -> Maybe (List String)
inlineFieldsGo fuel env fields = if fuel <= 0 then Nothing
else case fields of
  [] => Just []
  (Pair fname value) :: rest => case inlinePrecGo (fuel - 1) env 0 value of
    Nothing => Nothing
    Just v => case inlineFieldsGo (fuel - 1) env rest of
      Nothing => Nothing
      Just ss => Just ((fname ++ " = " ++ v) :: ss)

-- DT（M13）命名 Pi：`(x : A) -> B` 与隐式 `{x : A} -> B`；`->` 右结合。
inlinePiGo : Int -> List FixityDecl -> Int -> Maybe Qty -> String -> Bool -> Expr -> Expr -> Maybe String
inlinePiGo fuel env minPrec qty name implicit dom cod = if fuel <= 0 then Nothing
else case inlinePrecGo (fuel - 1) env 0 dom of
  Nothing => Nothing
  Just d => case inlinePrecGo (fuel - 1) env 1 cod of
    Nothing => Nothing
    Just c =>
      let
        binder =
          if implicit then "{" ++ qtyPrefix qty ++ name ++ " : " ++ d ++ "}"
          else "(" ++ qtyPrefix qty ++ name ++ " : " ++ d ++ ")"
      in Just (wrapPrec (minPrec > 1) (binder ++ " -> " ++ c))

-- M38：quantity 前缀（`0 ` / `1 `）；缺省不打印。
qtyPrefix : Maybe Qty -> String
qtyPrefix Nothing = ""
qtyPrefix (Just Q0) = "0 "
qtyPrefix (Just Q1) = "1 "

-- 域/余域含块结构时的兜底布局（DT 类型一般走 inlinePiGo；这里只保证不丢字符）。
renderPiBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Maybe Qty -> Bool -> String -> Expr -> Expr -> List String
renderPiBlockGo fuel env at lineInd qty implicit name dom cod = if fuel <= 0 then []
else
  let
    openTxt =
      if implicit then "{" ++ qtyPrefix qty ++ name ++ " : "
      else "(" ++ qtyPrefix qty ++ name ++ " : "
    closeTxt = if implicit then "}" else ")"
    domLines =
      appendLast (" " ++ closeTxt ++ " ->")
        (prefixFirst openTxt (renderExprGo (fuel - 1) env at lineInd dom))
  in append domLines
    (prefixFirst (spaces (lineInd + 2)) (renderExprGo (fuel - 1) env at (lineInd + 2) cod))

inlineAppGo : Int -> List FixityDecl -> Int -> Expr -> List Expr -> Maybe String
inlineAppGo fuel env minPrec fn args = if fuel <= 0 then Nothing
else case fn of
  -- 符号名/canonical 别名（`Cons`->`::`、`bind`->`>>=`）当作中缀运算符：两参应用还原成
  -- `a op b`（哪怕无声明也按 9 左打印）。普通标识符保持应用形式。
  EVar op sp => if isSymbolName op || hasOpAlias env op then case args of
    [a, b] =>
      let
        fx = infixPrec env op
      in inlineInfixGo (fuel - 1) env minPrec (firstOf fx) (secondOf fx) (opText env op) a b
    _ => inlineApplyGo (fuel - 1) env minPrec fn args
  else inlineApplyGo (fuel - 1) env minPrec fn args
  _ => inlineApplyGo (fuel - 1) env minPrec fn args

inlineInfixGo : Int -> List FixityDecl -> Int -> Int -> Int -> String -> Expr -> Expr -> Maybe String
inlineInfixGo fuel env minPrec p assoc label a b = if fuel <= 0 then Nothing
else
  let
    leftMin = if assoc == 0 then p else p + 1
    rightMin = if assoc == 0 then p + 1 else p
  in case inlinePrecGo (fuel - 1) env leftMin a of
    Nothing => Nothing
    Just lhsText => case inlinePrecGo (fuel - 1) env rightMin b of
      Nothing => Nothing
      Just rhsText => Just (wrapPrec (p < minPrec) (lhsText ++ " " ++ label ++ " " ++ rhsText))

-- 反引号中缀：`` l `name` r ``（优先级查 name，未知按 9 左）。
inlineBacktickGo : Int -> List FixityDecl -> Int -> String -> Expr -> Expr -> Maybe String
inlineBacktickGo fuel env minPrec name l r = if fuel <= 0 then Nothing
else
  let
    fx = backtickPrec env name
  in inlineInfixGo (fuel - 1) env minPrec (firstOf fx) (secondOf fx) (backtickLabel name) l r

inlineApplyGo : Int -> List FixityDecl -> Int -> Expr -> List Expr -> Maybe String
inlineApplyGo fuel env minPrec fn args = if fuel <= 0 then Nothing
else case inlineApplyHeadGo (fuel - 1) env fn of
  Nothing => Nothing
  Just headText => case mapMaybeStrings (\a => inlineAtomGo (fuel - 1) env a) args of
    Nothing => Nothing
    Just argTexts =>
      Just (wrapPrec (9 < minPrec) (headText ++ concatStrings (map (\a => " " ++ a) argTexts)))

inlineApplyHeadGo : Int -> List FixityDecl -> Expr -> Maybe String
inlineApplyHeadGo fuel env fn = if fuel <= 0 then Nothing
else case fn of
  _ => inlineAtomGo (fuel - 1) env fn

inlineAtomGo : Int -> List FixityDecl -> Expr -> Maybe String
inlineAtomGo fuel env e = if fuel <= 0 then Nothing
else case inlinePrecGo (fuel - 1) env 0 e of
  Nothing => Nothing
  Just s => if atomForm e then Just s else Just ("(" ++ s ++ ")")

atomForm : Expr -> Bool
atomForm (EVar name sp) = True
atomForm (EInt n sp) = True
atomForm (EStr s sp) = True
atomForm (EInterp multi parts sp) = True
atomForm (EField base f sp) = True
atomForm (ERecord name fields sp) = True
atomForm (ERecUpdate base fields sp) = True
atomForm (EApp fn args sp) = case listExprElems (EApp fn args sp) of
  Just elems => True
  Nothing => False
-- M31.3：section 自带括号，永远是原子；反引号中缀是运算符形式（最低优先级）。
atomForm (ESectOp op sp) = True
atomForm (ESectL op inner sp) = True
atomForm (ESectR inner op sp) = True
atomForm _ = False

-- ---------------------------------------------------------------
-- 块级表达式（含 case/let/do 或含块结构的子表达式）；
-- lineInd = 该表达式起始物理行的缩进（0 基），块内缩进 = lineInd + 2。
-- 返回 List String：首行不含缩进，续行是绝对缩进。
-- ---------------------------------------------------------------
renderExprGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderExprGo fuel env at lineInd e = if fuel <= 0 then []
else case inlinePrecGo formatFuelBound env 0 e of
  Just s => if fitsLine lineInd s then [s] else renderWideGo (fuel - 1) env at lineInd e
  Nothing => renderBlockGo (fuel - 1) env at lineInd e

-- 类型表达式不折行（保持签名/字段类型紧凑，避免 `->` 链被打断）。
renderTypeExpr : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderTypeExpr env at lineInd e = renderTypeExprFuel formatFuelBound env at lineInd e

-- 显式 fuel 的类型渲染：绑定块里的签名行需要把 fuel 串下去（SCT）。
renderTypeExprFuel : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderTypeExprFuel fuel env at lineInd e = if fuel <= 0 then []
else case inlinePrecGo (fuel - 1) env 0 e of
  Just s => [s]
  Nothing => renderBlockGo (fuel - 1) env at lineInd e

-- 行内放不下时的折行形式。
renderWideGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderWideGo fuel env at lineInd e = if fuel <= 0 then []
else case e of
  EIf c t el sp => renderIfGo (fuel - 1) env at lineInd c t el
  EApp fn args sp => case listExprElems (EApp fn args sp) of
    Just elems => case mapMaybeStrings (\x => inlineExprGo formatFuelBound env x) elems of
      Just ss => renderListBlock at lineInd ss
      Nothing => renderAppBlockGo (fuel - 1) env at lineInd fn args
    Nothing => renderAppBlockGo (fuel - 1) env at lineInd fn args
  _ => [renderExprInline env e]

renderExprInline : List FixityDecl -> Expr -> String
renderExprInline env e = case inlinePrecGo formatFuelBound env 0 e of
  Just s => s
  Nothing => ""

-- 列表字面量折行：`[ a,` / `  b` / `]`（最后一个元素后不加逗号）。
renderListBlock : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> List String -> List String
renderListBlock at lineInd [] = ["[]"]
renderListBlock at lineInd (first :: rest) =
  append ["[ " ++ first ++ (if isNilList rest then "" else ",")]
    (renderListBlockRest at lineInd rest)

renderListBlockRest : List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> List String -> List String
renderListBlockRest at lineInd [] = [spaces lineInd ++ "]"]
renderListBlockRest at lineInd ([s]) = [spaces (lineInd + 2) ++ s, spaces lineInd ++ "]"]
renderListBlockRest at lineInd (s :: rest) =
  (spaces (lineInd + 2) ++ s ++ ",") :: renderListBlockRest at lineInd rest

renderAtomExprGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderAtomExprGo fuel env at lineInd e = if fuel <= 0 then []
else case inlineAtomGo formatFuelBound env e of
  Just s => [s]
  Nothing => parenWrapIndGo (fuel - 1) env at lineInd e

parenWrapIndGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
parenWrapIndGo fuel env at lineInd e =
  if fuel <= 0 then []
  else append (prefixFirst "(" (renderBlockGo (fuel - 1) env at lineInd e)) [spaces lineInd ++ ")"]

renderBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderBlockGo fuel env at lineInd e = if fuel <= 0 then []
else case e of
  ECase scrut alts sp => renderCaseGo (fuel - 1) env at lineInd scrut alts
  ELet binds body rec_ sp => renderLetGo (fuel - 1) env at lineInd binds body
  EIf c t el sp => renderIfGo (fuel - 1) env at lineInd c t el
  EApp fn args sp => renderAppBlockGo (fuel - 1) env at lineInd fn args
  EPi name implicit qty dom cod sp =>
    renderPiBlockGo (fuel - 1) env at lineInd qty implicit name dom cod
  ELam ps body sp =>
    prefixFirst ("\\" ++ joinComma ps ++ " => ") (renderExprGo (fuel - 1) env at lineInd body)
  EField base f sp => appendLast ("." ++ f) (renderAtomExprGo (fuel - 1) env at lineInd base)
  ERecord name fields sp => renderRecordBlockGo (fuel - 1) env at lineInd name fields
  ERecUpdate base fields sp => renderRecUpdateBlockGo (fuel - 1) env at lineInd base fields
  EDo stmts sp => renderDoGo (fuel - 1) env at lineInd stmts
  -- A2：局部函数组只作为 let/where 绑定值出现，由 `renderLetBindingGo` 展开成多子句。
  ELocalFun clauses sp => []
  EAnn value ty sp => renderExprGo (fuel - 1) env at lineInd value
  EVar name sp => if isSymbolName name then ["(" ++ name ++ ")"] else [name]
  EInt n sp => [strFromInt n]
  EStr s sp => [renderStr s]
  -- M36：模板字面量（块布局）。文本块转义；洞可单行则单行，否则块渲染 + 缩进。
  EInterp multi parts sp =>
    let
      body = concatStrings (interpPiecesBlock (fuel - 1) env lineInd multi parts)
    in splitOnNewline (interpOpen multi parts ++ body ++ interpClose multi)
  -- M31.3：反引号中缀沿用中缀折行布局；section 自带宽括号，尽量单行。
  EBacktick name l r sp =>
    let
      fx = backtickPrec env name
    in renderInfixBlockGo (fuel - 1) env at lineInd (firstOf fx) (secondOf fx) (backtickLabel name) l r
  ESectOp op sp => ["(" ++ op ++ ")"]
  ESectL op inner sp =>
    append (prefixFirst ("(" ++ op ++ " ") (renderExprGo (fuel - 1) env at lineInd inner))
      [spaces lineInd ++ ")"]
  ESectR inner op sp =>
    appendLast (" " ++ op ++ ")") (prefixFirst "(" (renderExprGo (fuel - 1) env at lineInd inner))
  _ => []

renderScrutGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderScrutGo fuel env at lineInd e = if fuel <= 0 then []
else case inlineExprGo formatFuelBound env e of
  Just s => [s]
  Nothing => parenWrapIndGo (fuel - 1) env at lineInd e

renderCaseGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List (Pair Pat Expr) -> List String
renderCaseGo fuel env at lineInd scrut alts = if fuel <= 0 then []
else
  let
    headLines =
      appendLast " of" (prefixFirst "case " (renderScrutGo (fuel - 1) env at lineInd scrut))
    altInd = lineInd + 2
    altLines = concatMap (\alt => renderAltGo (fuel - 1) env at altInd alt) alts
  in append headLines altLines

renderAltGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pair Pat Expr -> List String
renderAltGo fuel env at altInd (Pair pat body) =
  if fuel <= 0 then []
  else attachAt at (patSpan pat) altInd (renderAltBodyGo (fuel - 1) env at altInd pat body)

renderAltBodyGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pat -> Expr -> List String
renderAltBodyGo fuel env at altInd pat body = if fuel <= 0 then []
else case body of
  ELet binds inner recFlag sp =>
    (spaces altInd ++ renderPatGo formatFuelBound pat ++ " =>")
      :: prefixFirst (spaces (altInd + 2)) (renderExprGo (fuel - 1) env at (altInd + 2) body)
  _ =>
    let
      prefix = spaces altInd ++ renderPatGo formatFuelBound pat ++ " => "
    in case inlinePrecGo formatFuelBound env 0 body of
      Just s =>
        if strWidth (prefix ++ s) <= maxWidth then [prefix ++ s]
        else (spaces altInd ++ renderPatGo formatFuelBound pat ++ " =>")
          :: prefixFirst (spaces (altInd + 2)) (renderExprGo (fuel - 1) env at (altInd + 2) body)
      Nothing => prefixFirst prefix (renderExprGo (fuel - 1) env at altInd body)

renderWhenBodyGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> String -> Expr -> List String
renderWhenBodyGo fuel env at lineInd keyword e = if fuel <= 0 then []
else case e of
  ELet binds inner recFlag sp =>
    (spaces lineInd ++ keyword)
      :: prefixFirst (spaces (lineInd + 2)) (renderExprGo (fuel - 1) env at (lineInd + 2) e)
  _ => prefixFirst (spaces lineInd ++ keyword ++ " ") (renderExprGo (fuel - 1) env at lineInd e)

renderIfGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> Expr -> Expr -> List String
renderIfGo fuel env at lineInd c t el = if fuel <= 0 then []
else
  let
    condLines = prefixFirst "if " (renderScrutGo (fuel - 1) env at lineInd c)
    thenLines = case t of
      ELet binds inner recFlag sp =>
        append (appendLast " then" condLines)
          (prefixFirst (spaces (lineInd + 2)) (renderExprGo (fuel - 1) env at (lineInd + 2) t))
      _ =>
        let
          tLines = renderExprGo (fuel - 1) env at lineInd t
        in append (appendLast (" then " ++ firstLine tLines) condLines) (restLines tLines)
    elseLines = renderWhenBodyGo (fuel - 1) env at lineInd "else" el
  in append thenLines elseLines

renderLetGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> List (Pair Pat Expr) -> Expr -> List String
renderLetGo fuel env at lineInd binds body = if fuel <= 0 then []
else case binds of
  [] => "let" :: prefixFirst (spaces lineInd ++ "in ") (renderExprGo (fuel - 1) env at lineInd body)
  first :: rest =>
    let
      bindInd = lineInd + 2
      bindingLines =
        append (renderLetBindingGo (fuel - 1) env at bindInd first)
          (concatMap (\b => renderLetBindingGo (fuel - 1) env at bindInd b) rest)
    in append ("let" :: bindingLines)
      (prefixFirst (spaces lineInd ++ "in ") (renderExprGo (fuel - 1) env at lineInd body))

-- M28：`let` 绑定也支持可选签名行（与 where 共用绑定块模型）；解析器把签名降级成
-- `EAnn value ty`，这里按「签名行 + 绑定」还原，否则 fmt 产物会丢掉类型标注。
renderLetBindingGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pair Pat Expr -> List String
renderLetBindingGo fuel env at bindInd (Pair pat value) = if fuel <= 0 then []
else case value of
  EAnn inner ty annSp => case inner of
    ELocalFun clauses lsp =>
      append
        (attachAt at annSp bindInd (prefixFirst (spaces bindInd ++ renderPatGo formatFuelBound pat ++ " : ") (renderTypeExprFuel (fuel - 1) env at bindInd ty)))
        (renderLocalFunGo (fuel - 1) env at bindInd pat clauses)
    _ => case pat of
      PVar name psp =>
        let
          sigLines =
            prefixFirst (spaces bindInd ++ name ++ " : ")
              (renderTypeExprFuel (fuel - 1) env at bindInd ty)
        in append (attachAt at annSp bindInd sigLines)
          (attachAt at (patSpan pat) bindInd (renderBindingValueGo (fuel - 1) env at bindInd (renderPatGo formatFuelBound pat ++ " =") inner))
      _ =>
        let
          sigLines =
            prefixFirst (spaces bindInd ++ renderPatGo formatFuelBound pat ++ " : ")
              (renderTypeExprFuel (fuel - 1) env at bindInd ty)
        in append (attachAt at annSp bindInd sigLines)
          (attachAt at (patSpan pat) bindInd (renderBindingValueGo (fuel - 1) env at bindInd (renderPatGo formatFuelBound pat ++ " =") inner))
  ELocalFun clauses lsp => renderLocalFunGo (fuel - 1) env at bindInd pat clauses
  _ =>
    attachAt at (patSpan pat) bindInd
      (renderBindingValueGo (fuel - 1) env at bindInd (renderPatGo formatFuelBound pat ++ " =") value)

-- A2：where/let 多 clause 局部函数：`name p1 p2 = body` 逐 clause 渲染。
renderLocalFunGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pat -> List (Pair (List Pat) Expr) -> List String
renderLocalFunGo fuel env at bindInd pat clauses = if fuel <= 0 then []
else case clauses of
  [] => []
  (Pair pats body) :: rest =>
    let
      headText = renderPatGo formatFuelBound pat ++ joinSpace (map renderPatAtom pats) ++ " ="
      lines = renderBindingValueGo (fuel - 1) env at bindInd headText body
    in append (attachAt at (patSpan pat) bindInd lines)
      (renderLocalFunGo (fuel - 1) env at bindInd pat rest)

renderBindingValueGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> String -> Expr -> List String
renderBindingValueGo fuel env at lineInd prefixText value = if fuel <= 0 then []
else case value of
  ELet binds inner recFlag sp =>
    (spaces lineInd ++ prefixText)
      :: prefixFirst (spaces (lineInd + 2)) (renderExprGo (fuel - 1) env at (lineInd + 2) value)
  _ => case inlinePrecGo formatFuelBound env 0 value of
    Just s =>
      if strWidth (spaces lineInd ++ prefixText ++ " " ++ s) <= maxWidth then [spaces lineInd ++ prefixText ++ " " ++ s]
      else (spaces lineInd ++ prefixText)
        :: prefixFirst (spaces (lineInd + 2)) (renderExprGo (fuel - 1) env at (lineInd + 2) value)
    Nothing =>
      prefixFirst (spaces lineInd ++ prefixText ++ " ")
        (renderExprGo (fuel - 1) env at lineInd value)

renderDoGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> List DoStmt -> List String
renderDoGo fuel env at lineInd stmts =
  if fuel <= 0 then []
  else "do" :: concatMap (\s => renderDoStmtGo (fuel - 1) env at (lineInd + 2) s) stmts

renderDoStmtGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> DoStmt -> List String
renderDoStmtGo fuel env at stmtInd stmt =
  if fuel <= 0 then []
  else attachAt at (doStmtSpan stmt) stmtInd (renderDoStmtBodyGo (fuel - 1) env at stmtInd stmt)

renderDoStmtBodyGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> DoStmt -> List String
renderDoStmtBodyGo fuel env at stmtInd stmt = if fuel <= 0 then []
else case stmt of
  DBind pat value sp =>
    let
      prefix = spaces stmtInd ++ renderPatGo formatFuelBound pat ++ " <- "
    in case inlinePrecGo formatFuelBound env 0 value of
      Just s =>
        if strWidth (prefix ++ s) <= maxWidth then [prefix ++ s]
        else (spaces stmtInd ++ renderPatGo formatFuelBound pat ++ " <-")
          :: prefixFirst (spaces (stmtInd + 2)) (renderExprGo (fuel - 1) env at (stmtInd + 2) value)
      Nothing => prefixFirst prefix (renderExprGo (fuel - 1) env at stmtInd value)
  DExpr value sp => prefixFirst (spaces stmtInd) (renderExprGo (fuel - 1) env at stmtInd value)

renderAppBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List Expr -> List String
renderAppBlockGo fuel env at lineInd fn args = if fuel <= 0 then []
else case fn of
  EVar op sp => if isSymbolName op || hasOpAlias env op then case args of
    [a, b] =>
      let
        fx = infixPrec env op
      in renderInfixBlockGo (fuel - 1) env at lineInd (firstOf fx) (secondOf fx) (opText env op) a b
    _ => renderApplyBlockGo (fuel - 1) env at lineInd fn args
  else renderApplyBlockGo (fuel - 1) env at lineInd fn args
  _ => renderApplyBlockGo (fuel - 1) env at lineInd fn args

renderInfixBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> Int -> String -> Expr -> Expr -> List String
renderInfixBlockGo fuel env at lineInd p assoc label a b = if fuel <= 0 then []
else case inlineInfixGo formatFuelBound env 0 p assoc label a b of
  Just s =>
    if fitsLine lineInd s then [s]
    else renderInfixChainGo (fuel - 1) env at lineInd p assoc label
      (infixChainOperands env p assoc label a b)
  Nothing =>
    let
      leftMin = if assoc == 0 then p else p + 1
      rightMin = if assoc == 0 then p + 1 else p
      lhsLines = renderOperandGo (fuel - 1) env at lineInd leftMin a
      rhsLines = renderOperandGo (fuel - 1) env at lineInd rightMin b
    in case rhsLines of
      [] => lhsLines
      r :: rest => append (appendLast (" " ++ label ++ " " ++ r) lhsLines) rest

-- 中缀链：运算符放续行行首（续行缩进 lineInd+2，满足 parser 的 offside 约束）。
infixChainOperands : List FixityDecl -> Int -> Int -> String -> Expr -> Expr -> List Expr
infixChainOperands env p assoc label a b =
  if assoc == 1 then a :: flattenInfixRight env p label b
  else append (flattenInfixLeft env p label a) [b]

flattenInfixLeft : List FixityDecl -> Int -> String -> Expr -> List Expr
flattenInfixLeft env p op (e@(EApp (EVar name sp) ([l, r]) sp2)) =
  let
    fx = infixPrec env name
    p2 = firstOf fx
  in if isSymbolName name && p2 == p && name == op then append (flattenInfixLeft env p op l) [r]
  else [e]
flattenInfixLeft env p op e = [e]

flattenInfixRight : List FixityDecl -> Int -> String -> Expr -> List Expr
flattenInfixRight env p op (e@(EApp (EVar name sp) ([l, r]) sp2)) =
  let
    fx = infixPrec env name
    p2 = firstOf fx
  in if isSymbolName name && p2 == p && name == op then l :: flattenInfixRight env p op r else [e]
flattenInfixRight env p op e = [e]

renderInfixChainGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> Int -> String -> List Expr -> List String
renderInfixChainGo fuel env at lineInd p assoc label operands = if fuel <= 0 then []
else case operands of
  [] => []
  first :: rest =>
    append (renderChainFirstGo (fuel - 1) env at lineInd (p + 1) first)
      (concatMap (\o => renderChainRestGo (fuel - 1) env at lineInd (p + 1) label o) rest)

renderChainFirstGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> Expr -> List String
renderChainFirstGo fuel env at lineInd minPrec e = if fuel <= 0 then []
else case inlinePrecGo formatFuelBound env minPrec e of
  Just s =>
    if fitsLine lineInd s then [s] else renderWideOperandGo (fuel - 1) env at lineInd minPrec e
  Nothing => parenWrapIndGo (fuel - 1) env at lineInd e

renderWideOperandGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> Expr -> List String
renderWideOperandGo fuel env at lineInd minPrec e =
  if fuel <= 0 then []
  else if minPrec > 0 then [renderExprInlineOperand env minPrec e]
  else renderWideGo (fuel - 1) env at lineInd e

renderExprInlineOperand : List FixityDecl -> Int -> Expr -> String
renderExprInlineOperand env minPrec e = case inlinePrecGo formatFuelBound env minPrec e of
  Just s => s
  Nothing => ""

renderChainRestGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> String -> Expr -> List String
renderChainRestGo fuel env at lineInd minPrec label e = if fuel <= 0 then []
else case inlinePrecGo formatFuelBound env minPrec e of
  Just s => [spaces (lineInd + 2) ++ label ++ " " ++ s]
  Nothing =>
    prefixFirst (spaces (lineInd + 2) ++ label ++ " ")
      (parenWrapIndGo (fuel - 1) env at (lineInd + 2) e)

renderOperandGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Int -> Expr -> List String
renderOperandGo fuel env at lineInd minPrec e = if fuel <= 0 then []
else case inlinePrecGo formatFuelBound env minPrec e of
  Just s => [s]
  Nothing => parenWrapIndGo (fuel - 1) env at lineInd e

renderApplyBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List Expr -> List String
renderApplyBlockGo fuel env at lineInd fn args = if fuel <= 0 then []
else
  let
    headLines = renderApplyHeadGo (fuel - 1) env at lineInd fn
  in case mapMaybeStrings (\a => inlineAtomGo formatFuelBound env a) args of
    Nothing => appendApplyArgsGo (fuel - 1) env at lineInd headLines args
    Just texts => case headLines of
      [h] =>
        if fitsLine lineInd (h ++ concatStrings (map (\t => " " ++ t) texts)) then appendApplyArgsGo (fuel - 1) env at lineInd headLines args
        else packApplyArgs lineInd [h] texts
      _ => appendApplyArgsGo (fuel - 1) env at lineInd headLines args

-- 贪心折行：尽量把参数放在当前行，放不下就新起一行（缩进 lineInd+2）。
packApplyArgs : Int -> List String -> List String -> List String
packApplyArgs lineInd lines [] = lines
packApplyArgs lineInd lines (t :: rest) =
  if fitsLineWidth (lastLineWidth lineInd lines) t then packApplyArgs lineInd (appendLast (" " ++ t) lines) rest
  else packApplyArgs lineInd (append lines [spaces (lineInd + 2) ++ t]) rest

lastLineWidth : Int -> List String -> Int
lastLineWidth lineInd lines =
  if isNilList (restLines lines) then lineInd + strWidth (lastLineOf lines)
  else strWidth (lastLineOf lines)

fitsLineWidth : Int -> String -> Bool
fitsLineWidth currentWidth t = currentWidth + 1 + strWidth t <= maxWidth

renderApplyHeadGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderApplyHeadGo fuel env at lineInd fn = if fuel <= 0 then []
else case fn of
  _ => renderAtomExprGo (fuel - 1) env at lineInd fn

appendApplyArgsGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> List String -> List Expr -> List String
appendApplyArgsGo fuel env at lineInd lines args = if fuel <= 0 then []
else case args of
  [] => lines
  a :: rest =>
    appendApplyArgsGo (fuel - 1) env at lineInd
      (appendBefore " " lines (renderAtomExprGo (fuel - 1) env at lineInd a)) rest

renderRecordBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> String -> List (Pair String Expr) -> List String
renderRecordBlockGo fuel env at lineInd name fields = if fuel <= 0 then []
else case fields of
  [] => [name ++ " { }"]
  first :: rest =>
    let
      start = appendBefore " " [name ++ " {"] (renderFieldBlockGo (fuel - 1) env at lineInd first)
      withRest = appendFieldBlocksGo (fuel - 1) env at lineInd start rest
    in appendLast " }" withRest

appendFieldBlocksGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> List String -> List (Pair String Expr) -> List String
appendFieldBlocksGo fuel env at lineInd lines fields = if fuel <= 0 then []
else case fields of
  [] => lines
  f :: rest =>
    appendFieldBlocksGo (fuel - 1) env at lineInd
      (appendBefore ", " lines (renderFieldBlockGo (fuel - 1) env at lineInd f)) rest

renderFieldBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Pair String Expr -> List String
renderFieldBlockGo fuel env at lineInd (Pair fname value) =
  if fuel <= 0 then []
  else prefixFirst (fname ++ " = ") (renderAtomExprGo (fuel - 1) env at lineInd value)

renderRecUpdateBlockGo : Int -> List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List (Pair String Expr) -> List String
renderRecUpdateBlockGo fuel env at lineInd base fields = if fuel <= 0 then []
else
  let
    start = appendBefore " " ["{"] (renderAtomExprGo (fuel - 1) env at lineInd base)
  in case fields of
    [] => appendLast " }" start
    first :: rest =>
      let
        start2 = appendBefore " | " start (renderFieldBlockGo (fuel - 1) env at lineInd first)
        withRest = appendFieldBlocksGo (fuel - 1) env at lineInd start2 rest
      in appendLast " }" withRest

-- 渲染递归显式 fuel：块级布局既沿 AST 子项下降、也沿同一表达式的不同缩进/模式前进，
-- 且大量递归经 concatMap/map 的 λ（无 size 关系）；用 fuel 守卫 + 同参数位递减。
-- 上界远大于任何实际 AST 的渲染调用数（1G）。
formatFuelBound : Int
formatFuelBound = 1073741824

-- 对外 API 保持不变：入口用固定预算调用内部 Go 版本。
parenWrapInd : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
parenWrapInd env at lineInd e = parenWrapIndGo formatFuelBound env at lineInd e

renderBindingValue : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> String -> Expr -> List String
renderBindingValue env at lineInd prefixText value =
  renderBindingValueGo formatFuelBound env at lineInd prefixText value

renderExpr : List FixityDecl -> List (Pair (Pair Int Int) (Pair (List Comment) (List Comment))) -> Int -> Expr -> List String
renderExpr env at lineInd e = renderExprGo formatFuelBound env at lineInd e

-- 单行渲染（inline*）同样经相互递归的 Maybe 链：用 fuel 守卫 + 同参数位递减。
-- 对外 API 不变：inlineExpr/inlinePrec 用固定预算进入内部 Go 版本。
inlineExpr : List FixityDecl -> Expr -> Maybe String
inlineExpr env e = inlineExprGo formatFuelBound env e

inlinePrec : List FixityDecl -> Int -> Expr -> Maybe String
inlinePrec env minPrec e = inlinePrecGo formatFuelBound env minPrec e

-- 模式渲染同样经相互递归的 Pat 链；用 fuel 守卫 + 同参数位递减。
-- 对外 API 不变：renderPat/renderPatAtom 用固定预算进入内部 Go 版本。
renderPat : Pat -> String
renderPat pat = renderPatGo formatFuelBound pat

renderPatAtom : Pat -> String
renderPatAtom pat = renderPatAtomGo formatFuelBound pat
