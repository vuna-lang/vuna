module Vuna.Repl (runRepl) where

-- Vuna.Repl：交互式 REPL（M11.5；M23 起底层是 DT 精化 + 核心求值）。
--
-- 设计：REPL 维护 imports / 定义 两段源码缓冲。每输入一行：
--   - `import ...` 行追加到 imports 缓冲（解析通过才接受）；
--   - 能整行解析为顶层定义时追加到定义缓冲（累积，供后续表达式使用）；
--   - 否则按表达式求值：`imports + 定义` 作为 program、当前行作为表达式交给
--     `Vuna.Interp.interpretExpr`（DT 精化后核心求值）。
--   - `:q`/`:quit` 退出，`:help` 帮助，`:reset` 清空缓冲。
-- 限制：一次只能输入一行（多行定义/表达式暂不支持）。DT 顶层签名必填，所以定义
-- 要先输入 `x : Int` 再输入 `x = 1 + 1`，之后表达式才能引用 `x`。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Frontend.Parser
import Vuna.Interp

replTempFile : String
replTempFile = "/tmp/vuna-repl.vuna"

replPrompt : String
replPrompt = "vuna> "

replHelp : String
replHelp =
  "命令：\n"
    ++ "  :help    显示帮助\n"
    ++ "  :reset   清空已输入的定义与 import\n"
    ++ "  :quit    退出（同 Ctrl-D）\n"
    ++ "其他输入按 vuna 源码处理：`import ...` 与定义会被累积，表达式会立即求值。\n"
    ++ "注意：DT 顶层签名必填，定义请先输入签名行（如 `x : Int`）再输入定义行。\n"

-- REPL 是「读一行→处理→再读一行」的无限状态机，递归不沿输入结构下降；
-- 用显式 fuel 守卫（1G 行，实际不可达）。
replFuelBound : Int
replFuelBound = 1073741824

-- M26：REPL 的模块解析来自**包上下文**（CLI 用 `contextForDir "."`：cwd 在包内
-- 就用最近 vuna.toml 的依赖闭包，cwd 不是包时退化成 base-only；不再有环境根 flag）。
runRepl : PackageContext -> Int
runRepl ctx =
  let
    _ = prim_print ("vuna repl\n" ++ replHelp)
  in replLoop replFuelBound ctx "" ""

replLoop : Int -> PackageContext -> String -> String -> Int
replLoop fuel ctx imports defs = if fuel <= 0 then 0
else
  let
    _ = prim_print replPrompt
  in let
    line = prim_readLine
  in if line == "" then 0 else replHandle (fuel - 1) ctx imports defs (trim line)

replHandle : Int -> PackageContext -> String -> String -> String -> Int
replHandle fuel ctx imports defs line = if fuel <= 0 then 0
else case line of
  "" => replLoop (fuel - 1) ctx imports defs
  ":q" => 0
  ":quit" => 0
  ":reset" =>
    let
      _ = prim_print "已清空\n"
    in replLoop (fuel - 1) ctx "" ""
  ":help" =>
    let
      _ = prim_print replHelp
    in replLoop (fuel - 1) ctx imports defs
  _ =>
    if startsWith "import " line then replAddImport (fuel - 1) ctx imports defs line
    else replDefineOrEval (fuel - 1) ctx imports defs line

replAddImport : Int -> PackageContext -> String -> String -> String -> Int
replAddImport fuel ctx imports defs line = if fuel <= 0 then 0
else
  let
    imports2 = imports ++ line ++ "\n"
  in case parseSource replTempFile (imports2 ++ defs) of
    Err e =>
      let
        _ = prim_print ("parse error: " ++ e ++ "\n")
      in replLoop (fuel - 1) ctx imports defs
    Ok _ => replLoop (fuel - 1) ctx imports2 defs

replDefineOrEval : Int -> PackageContext -> String -> String -> String -> Int
replDefineOrEval fuel ctx imports defs line = if fuel <= 0 then 0
else case parseSource replTempFile (imports ++ defs ++ line ++ "\n") of
  Ok (Source hdr imp decls) => case hdr of
    Just md => replEvalExpr (fuel - 1) ctx imports defs line
    Nothing => replLoop (fuel - 1) ctx imports (defs ++ line ++ "\n")
  Err e => replEvalExpr (fuel - 1) ctx imports defs line

replEvalExpr : Int -> PackageContext -> String -> String -> String -> Int
replEvalExpr fuel ctx imports defs line = if fuel <= 0 then 0
else case parseExpressionSource line of
  Err e =>
    let
      _ = prim_print ("错误: " ++ e ++ "\n")
    in replLoop (fuel - 1) ctx imports defs
  Ok _ =>
    let
      program = imports ++ "\n" ++ defs
    in let
      output = interpretExpr ctx program line
    in let
      _ = prim_print (output ++ "\n")
    in replLoop (fuel - 1) ctx imports defs
