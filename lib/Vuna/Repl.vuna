module Vuna.Repl (runRepl) where

-- Vuna.Repl：交互式 REPL（M11.5；M23 起底层是 DT 精化 + 核心求值）。
--
-- 设计：REPL 维护 imports / 定义 / 待续输入（pending）三段状态。每输入一行：
--   - `import ...` 行追加到 imports 缓冲（解析通过才接受）；
--   - 能整行解析为顶层定义时追加到定义缓冲（累积，供后续表达式使用）；
--   - 否则按表达式求值：`imports + 定义` 作为 program、当前输入作为表达式交给
--     `Vuna.Interp.evalExprInfo`（DT 精化后核心求值）。
--   - `:q`/`:quit` 退出，`:help` 帮助，`:reset` 清空缓冲。
-- DT 顶层签名必填，所以定义要先输入 `x : Int` 再输入 `x = 1 + 1`，之后表达式才能
-- 引用 `x`。
--
-- M30（D14）：多行输入 + 效果表达式。
--   - 输入不完整时进入 `... ` 续行：判据是未闭合的 `(`/`[`/`{`、未闭合字符串 / 块注释，
--     或行尾是一个「显然还要继续」的 token（`=` `->` `|` `,` `where` `do` `then`
--     `else` `of` `in` `case` `let`）。连续 64 行仍未闭合就报错丢弃。缩进续行
--     （offside 块：do / case / where 分支）按「去缩进的行或空行收尾」处理：空行提交
--     完整输入、不完整时报错丢弃；在续行状态里 `:q`/`:quit` 仍然可用。续行保留原始
--     缩进（offside 布局），只对第一行做 trim。
--   - IO 表达式：`evalExprInfo` 同时返回类型文本，顶层类型是 `(Base.IO.IO a)` 时不走
--     核心求值，而是把「imports + 定义 + `main : <类型>` + `main = <表达式>`」写进
--     临时包，`compileToDir` → `runBuildScript` → 运行（见 `Vuna.Interp.runEffectProgram`）。
--     效果输出直接到终端；`a` 是 Int/String/Bool 时运行完再打印结果值。编译失败打印
--     可读诊断并保持已有缓冲；缺 `ocamlopt` 时给「进 nix develop」的提示。
--   - 限制：程序里已经有 `main` 时拒绝效果执行（避免与合成入口重复定义）；临时包只能
--     依赖上下文的依赖包，当前包自己的 lib 模块在 IO 表达式里不可 import。
--
-- M38（P1b）：调试命令。
--   - `:type EXPR` 只打印 zonk 后的类型文本（不求值、不执行效果）；
--   - `:load FILE` 用文件源码整体替换 imports/defs 缓冲；文件含 `module ... where`
--     头时拒绝（模块文件由 Loader 按模块加载，不能灌进 REPL 缓冲）并提示改用 :browse；
--     `:reload` 重读上次 :load 的文件。失败时状态不变；
--   - `:browse MODULE` 惰性构建 `Vuna.Index`（首次 :browse 才 `loadOrBuild`，之后复用
--     `stateBrowseIndex` 缓存）后按 `vuna api` 的 `renderApi` 打印模块接口面；非 workspace 明确报错。
--
-- 实现结构：**只有 `replLoop` 递归**（显式 fuel：C28 记录的交互主循环不是全函数，
-- 用 1G 行守卫防不可达死循环），其余步骤函数都返回新状态（`ReplState` / `ReplOutcome`），
-- 不自我递归——这样「空行提交 pending 后再处理下一行」不会把后续输入吞进嵌套循环。
import Vuna.Cli.Args
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Frontend.Parser
import Vuna.Index
import Vuna.Compiler.Driver.Dt
import Vuna.Interp
import Base.IO

replTempFile : String
replTempFile = "/tmp/vuna-repl.vuna"

replPrompt : String
replPrompt = "vuna> "

-- 续行提示（GHCi 风格）：提醒当前输入还没结束。
replContinuePrompt : String
replContinuePrompt = "... "

-- 待续输入的行数上限：既防粘贴事故，也保证 needsMore 的误判不会无限续行。
replMaxPendingLines : Int
replMaxPendingLines = 64

replHelp : String
replHelp = """命令：
  :help           显示帮助
  :type EXPR      显示表达式类型（不求值，也不执行效果）
  :load FILE      加载定义文件（整段源码进缓冲；不支持 `module ... where` 模块文件）
  :reload         重新读取上次 :load 的文件
  :browse MODULE  显示模块接口（复用 `vuna api`；首次会构建源码索引）
  :reset          清空已输入的定义、import 与 :load 的文件
  :quit           退出（同 Ctrl-D）
其他输入按 vuna 源码处理：`import ...` 与定义会被累积，表达式会立即求值。
DT 顶层签名必填，定义请先输入签名行（如 `x : Int`）再输入定义行。
多行输入：未闭合的括号/字符串/块注释或行尾是 `=` `->` `|` `,` `where` `do` 等
时显示 `... ` 继续读；缩进块（do/case/where）用空行提交，空行时输入不完整则丢弃。
效果表达式（顶层类型是 IO a）会临时编译并运行；效果的输出直接到终端。
"""

-- REPL 是「读一行→处理→再读一行」的无限状态机，递归不沿输入结构下降；
-- 用显式 fuel 守卫（1G 行，实际不可达）。
replFuelBound : Int
replFuelBound = 1073741824

-- REPL 的累积状态：imports 缓冲、定义缓冲、待续输入（空串 = 没有待续输入）、
-- :load 的文件路径（空串 = 未加载）与 :browse 的索引缓存（首次 :browse 才构建）。
record ReplState where
  stateImports : String
  stateDefs : String
  statePending : String
  stateLoadedFile : String
  stateBrowseIndex : Maybe Index
  -- M34.6（5b）：表达式求值的 termAux 预处理缓存（依赖接口不变时跨表达式复用）。
  stateAuxCache : Maybe AuxCache

replState : String -> String -> String -> ReplState
replState imports defs pending = ReplState imports defs pending "" Nothing Nothing

-- 只替换 pending：imports / defs / :load 文件 / 索引缓存都保持（求值、追定义后清续行）。
withAuxCache : ReplState -> Maybe AuxCache -> ReplState
withAuxCache st aux =
  ReplState st.stateImports st.stateDefs st.statePending st.stateLoadedFile st.stateBrowseIndex aux

withPending : ReplState -> String -> ReplState
withPending st pending =
  ReplState st.stateImports st.stateDefs pending st.stateLoadedFile st.stateBrowseIndex
    st.stateAuxCache

-- 替换 imports / defs 并清 pending（import 接受、定义追加）；:load 文件与索引缓存保持。
withBuffers : ReplState -> String -> String -> ReplState
withBuffers st imports defs =
  ReplState imports defs "" st.stateLoadedFile st.stateBrowseIndex st.stateAuxCache

-- :load 成功后的状态：imports 缓冲清空（文件自带的 import 已在源码里）、整段源码进 defs、
-- 记录路径；pending 清空、索引缓存保留。
withLoadedSource : ReplState -> String -> String -> ReplState
withLoadedSource st path source =
  ReplState "" (ensureTrailingNewline source) "" path st.stateBrowseIndex Nothing

-- :reset：清空定义 / import / 待续输入与 :load 的文件；索引缓存保留（它只是源码快照缓存）。
resetBuffers : ReplState -> ReplState
resetBuffers st = ReplState "" "" "" "" st.stateBrowseIndex Nothing

ensureTrailingNewline : String -> String
ensureTrailingNewline s = if s == "" || endsWith "\n" s then s else "${s}\n"

-- 一步的结果：继续（带新状态）或退出（退出码）。
data ReplOutcome : Type where
  ReplContinue : ReplState -> ReplOutcome
  ReplExit : Int -> ReplOutcome

-- M26：REPL 的模块解析来自**包上下文**（CLI 用 `contextForDir "."`：cwd 在包内
-- 就用最近 vuna.toml 的依赖闭包，cwd 不是包时退化成 base-only；不再有环境根 flag）。
runRepl : PackageContext -> Int
runRepl ctx =
  let
    _ = runIO (prim_print "vuna repl\n${replHelp}")
  in replLoop replFuelBound ctx (replState "" "" "")

replLoop : Int -> PackageContext -> ReplState -> Int
replLoop fuel ctx st = if fuel <= 0 then 0
else
  let
    _ = runIO (prim_print (if st.statePending == "" then replPrompt else replContinuePrompt))
  in let
    raw = runIO prim_readLine
  in if trim raw == "" then case blankStep ctx st of
    ReplExit code => code
    ReplContinue st2 => replLoop (fuel - 1) ctx st2
  else case inputStep ctx st raw of
    ReplExit code => code
    ReplContinue st2 => replLoop (fuel - 1) ctx st2

-- 新读到的一行：没有待续输入时按完整输入处理；否则先追加到 pending。
inputStep : PackageContext -> ReplState -> String -> ReplOutcome
inputStep ctx st raw =
  if st.statePending == "" then lineStep ctx st (trim raw) else pendingStep ctx st raw

-- 空行 / Ctrl-D：`prim_readLine` 在 EOF 与空行上都返回 ""，再读一行区分：
-- 两行都空 = EOF（pending 完整则执行后退出，不完整则报错丢弃）；
-- 否则是「用户用空行收尾当前输入」：先提交 pending，再把读到的这行当新输入处理。
blankStep : PackageContext -> ReplState -> ReplOutcome
blankStep ctx st =
  let
    next = trim (runIO prim_readLine)
  in if next == "" then ReplExit (finishAtEof ctx st)
  else if st.statePending == "" then lineStep ctx st next
  else case submitPending ctx st of
    ReplExit code => ReplExit code
    ReplContinue st2 => lineStep ctx st2 next

-- EOF：pending 是完整输入就执行（结果不影响退出码），不完整则报错；都返回 0。
finishAtEof : PackageContext -> ReplState -> Int
finishAtEof ctx st = if st.statePending == "" then 0
else case submitPending ctx st of
  ReplExit code => code
  ReplContinue _ => 0

-- 提交 pending：结构上仍是未闭合状态（括号/字符串/块注释/行尾继续符）就报错丢弃，
-- 否则按完整输入处理（缩进块只有靠空行才能收尾）。
submitPending : PackageContext -> ReplState -> ReplOutcome
submitPending ctx st = if needsMore st.statePending then
  let
    _ = runIO (prim_print "错误: 输入不完整，已丢弃当前输入\n")
  in ReplContinue (withPending st "")
else submitText ctx st (trim st.statePending)

-- 完整的一行输入：冒号命令优先（在续行判定之前，否则 `:type f (` 会被当成未闭合源码），
-- 否则按「还需要续行 / import / 定义或表达式」处理。
lineStep : PackageContext -> ReplState -> String -> ReplOutcome
lineStep ctx st ":q" = ReplExit 0
lineStep ctx st ":quit" = ReplExit 0
lineStep ctx st ":reset" =
  let
    _ = runIO (prim_print "已清空\n")
  in ReplContinue (resetBuffers st)
lineStep ctx st ":help" =
  let
    _ = runIO (prim_print replHelp)
  in ReplContinue st
lineStep ctx st line =
  if startsWith ":" line then commandStep ctx st line
  else if needsMore line then ReplContinue (withPending st "${line}\n")
  else if startsWith "import " line then addImport ctx st line else submitText ctx st line

-- 冒号命令分发（`:help` / `:q` / `:reset` 等无参命令已在上面的子句处理）。
-- 未知命令给可操作提示，而不是落到 parse error。
commandStep : PackageContext -> ReplState -> String -> ReplOutcome
commandStep ctx st cmd = case commandArg cmd ":type" of
  Just expr => typeStep ctx st expr
  Nothing => case commandArg cmd ":load" of
    Just path => loadStep st path
    Nothing => case commandArg cmd ":reload" of
      Just arg => reloadStep st arg
      Nothing => case commandArg cmd ":browse" of
        Just modName => browseStep st modName
        Nothing =>
          let
            _ =
              runIO
                (prim_print "错误: 未知命令 `${cmd}`（输入 :help 查看可用命令）\n")
          in ReplContinue st

-- 命令参数：`cmd == name` → Just ""（缺参数）；`name` 后跟空格 → Just（trim 后的剩余）；
-- 其它 → Nothing（不是该命令）。按字节长度切前缀，不做 token 化。
commandArg : String -> String -> Maybe String
commandArg cmd name =
  if cmd == name then Just ""
  else if startsWith "${name} " cmd then Just (trim (substring (byteLength "${name} ") (byteLength cmd - byteLength "${name} ") cmd))
  else Nothing

commandUsage : ReplState -> String -> ReplOutcome
commandUsage st usage =
  let
    _ = runIO (prim_print "用法: ${usage}\n")
  in ReplContinue st

-- 当前缓冲拼成的程序（imports 在前、定义在后）。
bufferProgram : ReplState -> String
bufferProgram st = "${st.stateImports}\n${st.stateDefs}"

-- `:type EXPR`：只打印 zonk 后的类型文本（不求值、不执行效果）。先 parseExpressionSource
-- 拿到与 evalText 一致的干净解析错误；精化错误走既有 `错误:` 出口。
typeStep : PackageContext -> ReplState -> String -> ReplOutcome
typeStep ctx st exprText = if exprText == "" then commandUsage st ":type <表达式>"
else case parseExpressionSource exprText of
  Err e =>
    let
      _ = runIO (prim_print "错误: ${e}\n")
    in ReplContinue st
  Ok _ => case evalExprInfoWithAux ctx (bufferProgram st) exprText st.stateAuxCache of
    Err e =>
      let
        _ = runIO (prim_print "错误: ${e}\n")
      in ReplContinue st
    Ok (Pair info aux2) =>
      let
        _ = runIO (prim_print "${exprText} : ${trim (secondOf info)}\n")
      in ReplContinue (withAuxCache st aux2)

-- `:load FILE`：用文件源码整体替换 imports/defs 缓冲（成功才替换，失败状态不变）。
-- 只接受无 `module ... where` 头的入口式源码：模块文件由 Loader 按模块加载，不能直接
-- 灌进 REPL 缓冲，因此拒绝并提示改用 `:browse`。
loadStep : ReplState -> String -> ReplOutcome
loadStep st path = loadFileStep st "已加载" path

-- `:reload`：重读上次 :load 的文件；没有加载过就提示先 :load。
reloadStep : ReplState -> String -> ReplOutcome
reloadStep st arg = if arg /= "" then commandUsage st ":reload"
else if st.stateLoadedFile == "" then
  let
    _ = runIO (prim_print "错误: 还没有 :load 任何文件（先 :load <FILE>）\n")
  in ReplContinue st
else loadFileStep st "已重新加载" st.stateLoadedFile

loadFileStep : ReplState -> String -> String -> ReplOutcome
loadFileStep st verb path = if path == "" then commandUsage st ":load <FILE>"
else case readText path of
  Err e =>
    let
      _ = runIO (prim_print "错误: ${e}\n")
    in ReplContinue st
  Ok source => case parseSource path source of
    Err e =>
      let
        _ = runIO (prim_print "错误: ${e}\n")
      in ReplContinue st
    Ok (SourceFile hdr imp fx decls) => case hdr of
      Just md =>
        let
          _ =
            runIO
              (prim_print "错误: ${path} 是模块文件（含 `module ... where` 头），REPL 不能加载模块；请去掉 module 头后用 :load，或用 :browse <模块名> 查看模块接口\n")
        in ReplContinue st
      Nothing =>
        let
          _ = runIO (prim_print "${verb} ${path}（${length decls} 个定义）\n")
        in ReplContinue (withLoadedSource st path source)

-- `:browse MODULE`：复用 vuna api 的 Index + renderApi。索引只在首次 :browse 时构建
-- （`loadOrBuild "."`，结果缓存进 stateBrowseIndex）；非 workspace 明确报错且状态不变。
browseStep : ReplState -> String -> ReplOutcome
browseStep st modName = if modName == "" then commandUsage st ":browse <Module.name>"
else case st.stateBrowseIndex of
  Just index => browseRender st index modName
  Nothing => case findManifestDirMaybe "." of
    Nothing =>
      let
        _ =
          runIO
            (prim_print "错误: 当前目录不在 vuna workspace 内（向上找不到 vuna.toml）；:browse 需要在包或 workspace 根运行\n")
      in ReplContinue st
    Just _ => case loadOrBuild "." of
      Err e =>
        let
          _ = runIO (prim_print "错误: ${e}\n")
        in ReplContinue st
      Ok index => browseRender (withIndexCache st index) index modName

withIndexCache : ReplState -> Index -> ReplState
withIndexCache st index =
  ReplState st.stateImports st.stateDefs st.statePending st.stateLoadedFile (Just index)
    st.stateAuxCache

browseRender : ReplState -> Index -> String -> ReplOutcome
browseRender st index modName = case renderApi index modName of
  Err e =>
    let
      _ = runIO (prim_print "错误: ${e}\n")
    in ReplContinue st
  Ok text =>
    let
      _ = runIO (prim_print "${text}\n")
    in ReplContinue st

-- 续行状态：把新行（保留缩进）追加到 pending；`:q`/`:quit` 仍可直接退出。
-- 缩进行（offside 块的成员）即使结构上「完整」也继续等，直到出现去缩进行或空行，
-- 否则 `do` / `case` / `where` 的第一条分支就会被误当成完整输入提前求值。
pendingStep : PackageContext -> ReplState -> String -> ReplOutcome
pendingStep ctx st raw = if raw == ":q" || raw == ":quit" then ReplExit 0
else
  let
    pending2 = "${st.statePending}${raw}\n"
  in if countChar 10 pending2 > replMaxPendingLines then
    let
      _ =
        runIO
          (prim_print "错误: 续行超过 ${replMaxPendingLines} 行，已丢弃当前输入\n")
    in ReplContinue (withPending st "")
  else if needsMore pending2 then ReplContinue (withPending st pending2)
  else if startsIndented raw then ReplContinue (withPending st pending2)
  else submitText ctx st (trim pending2)

startsIndented : String -> Bool
startsIndented line = startsWith " " line || startsWith "\t" line

-- import：先和已有定义一起 parse，通过才接受（否则保持原状态并打印解析错误）。
addImport : PackageContext -> ReplState -> String -> ReplOutcome
addImport ctx st line =
  let
    imports2 = "${st.stateImports}${line}\n"
  in case parseSource replTempFile (imports2 ++ st.stateDefs) of
    Err e =>
      let
        _ = runIO (prim_print "parse error: ${e}\n")
      in ReplContinue st
    Ok _ => ReplContinue (withBuffers st imports2 st.stateDefs)

-- 定义还是表达式：整段能解析成顶层声明就追加到定义缓冲，否则按表达式求值。
submitText : PackageContext -> ReplState -> String -> ReplOutcome
submitText ctx st text = case parseSource replTempFile "${st.stateImports}${st.stateDefs}${text}\n" of
  Ok (SourceFile hdr imp fx decls) => case hdr of
    Just md => evalText ctx st text
    Nothing => ReplContinue (withBuffers st st.stateImports "${st.stateDefs}${text}\n")
  Err e => evalText ctx st text

-- 表达式求值：类型是 IO a 时走临时包编译+运行，否则核心求值后打印值。
evalText : PackageContext -> ReplState -> String -> ReplOutcome
evalText ctx st text = case parseExpressionSource text of
  Err e =>
    let
      _ = runIO (prim_print "错误: ${e}\n")
    in ReplContinue (withPending st "")
  Ok _ => case evalExprInfoWithAux ctx (bufferProgram st) text st.stateAuxCache of
    Err e =>
      let
        _ = runIO (prim_print "错误: ${e}\n")
      in ReplContinue (withPending st "")
    Ok (Pair info aux2) =>
      let
        tyText = secondOf info
      in if isIOTypeText tyText then
        let
          _ = evalIO ctx st text tyText
        in ReplContinue (withPending (withAuxCache st aux2) "")
      else
        let
          _ = runIO (prim_print "${firstOf info}\n")
        in ReplContinue (withPending (withAuxCache st aux2) "")

-- IO 表达式：合成 `main : <类型>` + `main = <表达式>`，临时编译并运行。
-- 返回进程退出码（0 成功；非 0 只打印退出码，不改变 REPL 状态）；错误已打印。
-- 类型里若有未解元变量（`?N`，常见于没有上下文可推断的裸 `pure ...`），不能写回
-- 签名，给出「加类型标注」的可操作提示。
evalIO : PackageContext -> ReplState -> String -> String -> Int
evalIO ctx st text tyText = if hasMainDef st.stateImports st.stateDefs then
  let
    _ =
      runIO
        (prim_print "错误: 程序已经定义了 main，无法把表达式当作效果入口（先 :reset 或改名）\n")
  in 0
else if hasUnsolvedMeta tyText then
  let
    _ =
      runIO
        (prim_print "错误: 无法确定 IO 表达式的完整类型（${tyText}）；先定义成带签名的值再求值（如 `prog : Base.IO.IO Int` + `prog = ...`）\n")
  in 0
else
  let
    source = """${st.stateImports}${st.stateDefs}
main : ${tyText}
main = ${text}
"""
  in case runEffectProgram ctx source (ioPrintResult tyText) of
    Err e =>
      let
        _ = runIO (prim_print "错误: ${e}\n")
      in 0
    Ok code => if code == 0 then 0
    else
      let
        _ = runIO (prim_print "[进程退出码 ${code}]\n")
      in code

-- 类型文本里是否有未解元变量（`showTerm` 渲染成 `?N`）。
hasUnsolvedMeta : String -> Bool
hasUnsolvedMeta tyText = contains "?" tyText

-- 程序源码里是否已经有 `main`（顶层签名或定义）；有则拒绝合成效果入口。
hasMainDef : String -> String -> Bool
hasMainDef imports defs = case parseSource replTempFile "${imports}\n${defs}" of
  Err e => False
  Ok (SourceFile hdr imp fx decls) => memName "main" (topNames decls)

-- 顶层类型文本是 canonical `IO a` 吗？`dtEvalExprInfo` 的 showTerm 把 TApp 渲染成
-- `(Base.IO.IO Int)`（canonical 全名），函数类型则是 `(...) -> ...`，前缀不会命中。
isIOTypeText : String -> Bool
isIOTypeText tyText =
  let
    t = trim tyText
  in startsWith "(Base.IO.IO " t
    || startsWith "Base.IO.IO " t
    || startsWith "(IO " t
    || t == "Base.IO.IO"
    || t == "IO"

-- 效果运行结束后是否让 codegen 的 main 钩子打印结果值：只有 a 是 Int/String/Bool
-- 时才能打印（其它返回类型 codegen 会报 MainReturnType，所以保持 ignore）。
ioPrintResult : String -> Bool
ioPrintResult tyText = case ioInnerType (trim tyText) of
  Nothing => False
  Just inner => inner == "Int" || inner == "String" || inner == "Bool"

-- `(Base.IO.IO Int)` → "Int"；`(Base.IO.IO (Base.Pair Int Int))` → "(Base.Pair Int Int)"。
ioInnerType : String -> Maybe String
ioInnerType t =
  if startsWith "(Base.IO.IO " t then Just
    (stripTrailingParen (trim (substring (byteLength "(Base.IO.IO ") (byteLength t - byteLength "(Base.IO.IO ") t)))
  else if startsWith "Base.IO.IO " t then Just
    (stripTrailingParen (trim (substring (byteLength "Base.IO.IO ") (byteLength t - byteLength "Base.IO.IO ") t)))
  else if startsWith "(IO " t then Just (stripTrailingParen (trim (substring 4 (byteLength t - 4) t)))
  else Nothing

-- 只保留实参本身：外层 TApp 的渲染是 `(IO a)`，去掉结尾的 `)` 即可
-- （实参本身是 TApp 时会剩下 `(Base.Pair Int Int)`，保留原样）。
stripTrailingParen : String -> String
stripTrailingParen s = if endsWith ")" s then trim (substring 0 (byteLength s - 1) s) else s

-- ---------------------------------------------------------------
-- 续行判定
--
-- needsMore 只看「结构」不看语义：本行结束时若还在字符串/块注释里、括号没配平，
-- 或最后一个 token 是继续符，就等下一行。空的 `(` 等结构在 64 行后强制报错。
-- ---------------------------------------------------------------
-- 扫描状态：grammar 状态（0 普通 / 1 字符串 / 2 块注释 / 3 行注释）+ 块注释嵌套深度
-- + 括号配平数（只统计普通状态下的括号）。
record ScanState where
  scanStateOf : Int
  scanStateDepth : Int
  scanBracketsOf : Int

needsMore : String -> Bool
needsMore text =
  let
    st = scanText (strUnpack text) 0 0 0
  in unclosedScan st
    || st.scanBracketsOf > 0
    || (if st.scanStateOf == 3 then False else tailTokenOpen text)

-- 字符串/块注释里的括号不算结构；行注释一直吃到行尾。
scanText : List Int -> Int -> Int -> Int -> ScanState
scanText [] state depth brackets = ScanState state depth brackets
scanText (c :: rest) state depth brackets = case state of
  0 => scanNormal c rest depth brackets
  1 => scanInString c rest depth brackets
  2 => scanInBlock c rest depth brackets
  _ => scanInLine c rest depth brackets

-- 普通状态：`"` 进字符串、`{-` 进块注释、`--` 进行注释、其余是括号配平。
scanNormal : Int -> List Int -> Int -> Int -> ScanState
scanNormal c rest depth brackets = if c == 34 then scanText rest 1 depth brackets
else if c == 123 then case rest of
  c2 :: rest2 =>
    if c2 == 45 then scanText rest2 2 (depth + 1) brackets else scanText rest 0 depth (brackets + 1)
  [] => ScanState 0 depth (brackets + 1)
else if c == 45 then case rest of
  c2 :: rest2 =>
    if c2 == 45 then scanText rest2 3 depth brackets else scanText rest 0 depth brackets
  [] => ScanState 0 depth brackets
else if c == 40 || c == 91 then scanText rest 0 depth (brackets + 1)
else if c == 41 || c == 93 || c == 125 then scanText rest 0 depth (if brackets > 0 then brackets - 1 else 0)
else scanText rest 0 depth brackets

-- 字符串：`\` 转义下一个字符（lexer 的规则），`"` 收尾。
scanInString : Int -> List Int -> Int -> Int -> ScanState
scanInString c rest depth brackets = if c == 92 then case rest of
  _ :: rest2 => scanText rest2 1 depth brackets
  [] => ScanState 1 depth brackets
else if c == 34 then scanText rest 0 depth brackets else scanText rest 1 depth brackets

-- 块注释可嵌套（与 lexer 一致）：`{-` 深度 +1，`-}` 深度 -1，深度 0 回普通状态。
scanInBlock : Int -> List Int -> Int -> Int -> ScanState
scanInBlock c rest depth brackets = if c == 123 then case rest of
  c2 :: rest2 =>
    if c2 == 45 then scanText rest2 2 (depth + 1) brackets else scanText rest 2 depth brackets
  [] => ScanState 2 depth brackets
else if c == 45 then case rest of
  c2 :: rest2 =>
    if c2 == 125 then if depth <= 1 then scanText rest2 0 0 brackets else scanText rest2 2 (depth - 1) brackets
    else scanText rest 2 depth brackets
  [] => ScanState 2 depth brackets
else scanText rest 2 depth brackets

-- 行注释：吃到换行（pending 的每行都以 `\n` 结尾，所以不会跨行）。
scanInLine : Int -> List Int -> Int -> Int -> ScanState
scanInLine c rest depth brackets =
  if c == 10 then scanText rest 0 depth brackets else scanText rest 3 depth brackets

-- 描到结尾：字符串/块注释里，或括号没配平 → 还需要更多行。
-- 行注释（state 3）到行尾就结束（pending 的扫描文本以 `\n` 收尾时不会走到这里）。
unclosedScan : ScanState -> Bool
unclosedScan st =
  let
    state = st.scanStateOf
  in state == 1 || state == 2

-- 行尾 token 是继续符吗？只在扫描状态是普通状态时用（行注释/字符串里不算）。
tailTokenOpen : String -> Bool
tailTokenOpen text = memName (lastToken text) tailTokens

tailTokens : List String
tailTokens = ["=", "->", "|", ",", "where", "do", "then", "else", "of", "in", "case", "let"]

-- 最后一个空白分隔 token（text 已 trimRight）。
lastToken : String -> String
lastToken text = lastTokenGo (strUnpack (trimRight text)) []

lastTokenGo : List Int -> List Int -> String
lastTokenGo [] acc = strPack (reverse acc)
lastTokenGo (c :: rest) acc =
  if c == 32 || c == 9 then lastTokenGo rest [] else lastTokenGo rest (c :: acc)

countChar : Int -> String -> Int
countChar c text = countCharGo c (strUnpack text)

countCharGo : Int -> List Int -> Int
countCharGo c [] = 0
countCharGo c (x :: rest) = if x == c then 1 + countCharGo c rest else countCharGo c rest
