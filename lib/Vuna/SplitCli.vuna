module Vuna.SplitCli (SplitInput, buildSplit, seedSplit) where

-- Vuna.SplitCli：包模式的分离编译入口（M12）。
--   vuna build --split OUTDIR [DIR]   → 包编译成逐模块 OCaml 源码 + build.sh（写到 OUTDIR）
--   vuna seed OUTDIR                  → 同上（生成 seed 文件集，供种子轮换）
-- 若程序含分离编译暂不支持的构造（如需要 trait 字典参数的泛型函数），返回 Err，
-- 由 CLI 回退到单文件 codegen。

import Vuna.Base
import Vuna.Ast
import Vuna.Pkg
import Vuna.Loader
import Vuna.Typecheck
import Vuna.TypedCodegen
import Vuna.Split

data SplitInput : Type where
  SplitInput : List Module -> List Decl -> List Decl -> List (Pair String Scheme) -> List (Pair String String) -> SplitInput

prepareSplit : String -> Result SplitInput
prepareSplit dir =
  case loadPackage dir of
    Err e => Err e
    Ok pkg =>
      let roots = packageRoots pkg
      in let entry = packageEntry pkg
         in case loadProject roots (packageName pkg) entry of
              Err e => Err e
              Ok project =>
                case resolveProject project of
                  Err e => Err e
                  Ok parts =>
                    let entryDecls = firstOf parts
                    in let modules = secondOf parts
                       in let flat = append entryDecls (concatMap moduleDeclsOf modules)
                          in case checkProgramInfoElabOwners flat of
                               Err e => Err e
                               Ok p =>
                                 case p of
                                   Pair (Pair globals elabDecls) owners =>
                                     Ok (SplitInput modules entryDecls elabDecls globals owners)

-- 生成 split 文件；成功后写盘并生成 build.sh。返回写出的源码文件数。
buildSplit : String -> String -> Result Int
buildSplit dir outDir =
  andThen (prepareSplit dir) (\input =>
    case input of
      SplitInput modules entryDecls elabDecls globals owners =>
        andThen (generateSplitProgram modules entryDecls elabDecls globals owners) (\files =>
          andThen (writeSplitFiles outDir files) (\n =>
            let order = splitCompileOrder (splitInitFiles files)
            in let _ = writeFile (outDir ++ "/build.sh") (buildScript order)
            in Ok n)))

seedSplit : String -> String -> Result Int
seedSplit dir outDir = buildSplit dir outDir
