-- | `vuna add <name>[@<version>] [DIR]`：查静态索引 → 写回 `[dependencies]` → 取包。
module Vuna.Add (runAdd) where

-- Vuna.Add：索引的唯一消费者（D14）。流程：
--   1. 读包 manifest 的 `[registry].index`（目录 / `file://` / `http(s)://`）；
--   2. 解析索引条目并按版本取发布（无版本 = 索引里的最后一个发布）；
--   3. 把 `(源, hash)` 写成内联表依赖行，写回 `[dependencies]`（段级替换/追加，
--      保留其余字节；子表形式不猜、报错让用户手改）；
--   4. 默认 `vuna fetch` 取包；`--no-fetch` 只改 manifest，`--dry-run` 只打印。
-- 索引不可信：写回的永远是摘要，后续 fetch/check 只认摘要。
import Vuna.Cli.Args
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Pkg
import Vuna.Compiler.Frontend.Manifest
import Vuna.Compiler.Packages.Pkg
import Vuna.Fetch
import Vuna.Registry
import Base.List
import Base.String

runAdd : List String -> Eff [] Int
runAdd args = case parseToolArgs "vuna add" [BoolFlag "dry-run", BoolFlag "no-fetch"] args of
  ErrC e => addFailText (diagText e)
  OkC parsed =>
    let
      dry = flagSet parsed "dry-run"
      noFetch = flagSet parsed "no-fetch"
    in case parsed.positionals of
      [] => addFailText "usage: vuna add <name>[@<version>] [DIR]"
      [spec] => addAt "." spec dry noFetch
      [spec, dir] => addAt dir spec dry noFetch
      _ => addFailText "too many arguments; expected <name>[@<version>] [DIR]"

-- | `greet@1.2.0` → (`greet`, `Just "1.2.0"`)；无 `@` 时版本为 `Nothing`。
splitSpec : String -> Pair String (Maybe String)
splitSpec spec = splitSpecGo (strUnpack spec) []

splitSpecGo : List Int -> List Int -> Pair String (Maybe String)
splitSpecGo [] acc = Pair (strPack (reverse acc)) Nothing
splitSpecGo (c :: rest) acc =
  if c == 64 then Pair (strPack (reverse acc)) (Just (strPack rest))
  else splitSpecGo rest (c :: acc)

addAt : String -> String -> Bool -> Bool -> Eff [] Int
addAt dir spec dry noFetch = do
  abs <- absolutePath dir
  let
    named = splitSpec spec
    alias = firstOf named
    version = secondOf named
    manifestPath = "${abs}/vuna.toml"
  in do
    exists <- prim_eff_fileExists manifestPath
    if exists then do
      raw <- prim_eff_readFile manifestPath
      case parseManifest manifestPath raw of
        ErrC e => printAddDiag e
        OkC manifest => case manifest.manifestRegistryIndex of
          Nothing => addFailText "manifest has no [registry].index (add it first)"
          Just indexRoot => do
            entryR <- loadRegistryEntryEff indexRoot alias
            case entryR of
              ErrC e => printAddDiag e
              OkC entry => case resolveRelease entry version of
                Nothing => addFailText "no release for ${spec} in index"
                Just release => writeAndFetch manifestPath raw alias release dry noFetch abs
    else addFailText "missing vuna.toml in ${dir}"

writeAndFetch : String -> String -> String -> Release -> Bool -> Bool -> String -> Eff [] Int
writeAndFetch manifestPath raw alias release dry noFetch abs = if hasSubtable alias raw then addFailText "dependency ${alias} is a subtable; edit [dependencies.${alias}] manually"
else
  let
    newLine = dependencyLine alias release
    updated = upsertDependencyLine alias newLine raw
  in if dry then do
    _ <- prim_eff_print "add: would write ${newLine}\n"
    pure 0
  else if updated == raw then do
    _ <- prim_eff_print "add: ${alias} already up to date\n"
    if noFetch then pure 0 else fetchAt abs False
  else do
    _ <- prim_eff_writeFileAtomic manifestPath updated
    _ <- prim_eff_print "add: wrote ${newLine}\n"
    if noFetch then pure 0 else fetchAt abs False

-- 内联表依赖行（一行；别名 = 包名，D13）。
dependencyLine : String -> Release -> String
dependencyLine alias release =
  let
    hashText = "sha256:${release.relHash}"
    sourceText = case release.relSource of
      DepGit url rev => "git = \"${url}\", rev = \"${rev}\", "
      DepUrl u => "url = \"${u}\", "
      DepPath p => "path = \"${p}\", "
  in "${alias} = { ${sourceText}hash = \"${hashText}\" }"

-- ---------------------------------------------------------------- 段级写回
-- 在 `[dependencies]` 段内替换同名行；没有同名行就在段末追加。子表形式
-- （`[dependencies.<alias>]`）不在这里处理：`upsertGo` 只看段内 key 行，
-- 若别名已是子表段，会走"追加"并产生重复定义——所以调用前先检查并报错。
upsertDependencyLine : String -> String -> String -> String
upsertDependencyLine alias newLine raw =
  if hasSubtable alias raw then raw
  else join "\n" (upsertGo alias newLine (split "\n" raw) False False)

-- 子表形式检测（`[dependencies.<alias>]` 行）。
hasSubtable : String -> String -> Bool
hasSubtable alias raw = anyLine (isSubtableHeader alias) (split "\n" raw)

anyLine : (a -> Bool) -> List a -> Bool
anyLine f [] = False
anyLine f (x :: rest) = if f x then True else anyLine f rest

isSubtableHeader : String -> String -> Bool
isSubtableHeader alias line = trim line == "[dependencies.${alias}]"

upsertGo : String -> String -> List String -> Bool -> Bool -> List String
upsertGo alias newLine [] inDeps done = if inDeps && not done then [newLine] else []
upsertGo alias newLine (line :: rest) inDeps done =
  let
    t = trim line
  in if t == "[dependencies]" then line :: upsertGo alias newLine rest True False
  else if inDeps then if isSectionHeader t then append (if done then [] else [newLine]) (line :: upsertGo alias newLine rest False True)
  else if isAliasLine alias t then newLine :: upsertGo alias newLine rest True True
  else line :: upsertGo alias newLine rest inDeps done
  else line :: upsertGo alias newLine rest False done

isSectionHeader : String -> Bool
isSectionHeader t = startsWith "[" t

isAliasLine : String -> String -> Bool
isAliasLine alias t = if startsWith alias t then
  let
    remainder =
      substring (natFromInt (strLength alias)) (natFromInt (strLength t - strLength alias)) t
  in startsWith "=" (trim remainder)
else False

printAddDiag : Diagnostic -> Eff [] Int
printAddDiag d = do
  _ <- prim_eff_print (diagText d ++ "\n")
  pure 1

addFailText : String -> Eff [] Int
addFailText msg = do
  _ <- prim_eff_print "error: ${msg}\n"
  pure 2
