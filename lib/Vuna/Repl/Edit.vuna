module Vuna.Repl.Edit (EditConfig(..), EditOutcome(..), editLine, terminalWidth) where

-- Vuna.Repl.Edit：REPL 行编辑器（工具链；不进 seed 闭包）。
--
-- 终端能力全部来自 `Vuna.Repl.Term`（stty + prim_eff_readBytes），因此不需要给编译器加
-- 终端原语。支持：
--   * 左/右移动、Home/End、Backspace/Delete（按 UTF-8 码点边界）；
--   * ↑/↓ 历史；Ctrl-R 反向增量历史搜索（Enter 接受、Esc/Ctrl-C 取消）；
--   * Ctrl-A/E/K/U/W/L、Ctrl-P/N、Ctrl-B/F；
--   * Ctrl-C 取消当前输入、Ctrl-D 空行退出；
--   * Tab 补全：普通位置补命令名 / 当前缓冲绑定名；`:load` / `:browse` / `import` 的
--     参数位补模块名与文件路径（候选池在 `Vuna.Repl.Complete`，只在按 Tab 时枚举）。
--     唯一匹配补全、多个匹配补最长公共前缀。
--   * 括号粘贴（`Vuna.Repl.Paste`）：`\e[200~` … `\e[201~` 之间的内容原样进缓冲，
--     粘贴里的换行不触发提交、Tab 不触发补全；换行在渲染时显示为 `↵`。
--   * 空闲轮询 + 窗口 resize 重绘：`stty min 0 time 1` 每 0.1s 醒一次（不忙等），
--     每 20 个空闲 tick（≈2s）查一次 `stty size`，宽度变了按新宽度重绘当前行（轮询频率是
--     权衡：每次查询要起 `sh` + `stty` 两个进程，2s 延迟对 resize 可接受且常驻开销低）。
-- 渲染用 `\r` + 水平窗口（超宽时只显示尾部）+ `\x1b[K`，光标用 `\x1b[nD` 回移。
-- 所有出口（提交/EOF/取消/不可用）都恢复终端状态（含关闭括号粘贴）。
import Vuna.Compiler.Common
import Vuna.Repl.Complete
import Vuna.Repl.Paste
import Vuna.Repl.Term
import Base.Host

record EditConfig where
  editPrompt : String
  editPromptWidth : Int
  editHistory : List String
  editCompletions : List String
  editWidth : Int
  editColorOn : Bool
  -- 当前包上下文的模块根（`:load` / `:browse` / `import` 参数位补全用）。
  editRoots : List String

data EditOutcome : Type where
  EditLine : String -> EditOutcome
  EditEof : EditOutcome
  EditCancel : EditOutcome
  EditUnavailable : EditOutcome

terminalWidth : Int -> Eff [] Int
terminalWidth n = termWidth n

record EditState where
  esBuf : List Int
  esCursor : Int
  esHistIdx : Int
  esDraft : List Int
  esSearching : Bool
  esQuery : List Int
  esMatch : Maybe (Pair Int String)

data EditResult : Type where
  EContinue : EditState -> EditResult
  ESubmit : String -> EditResult
  EExit : EditResult
  ECancel : EditResult

data Key : Type where
  KChar : Int -> Key
  KEnter : Key
  KBackspace : Key
  KDelete : Key
  KLeft : Key
  KRight : Key
  KUp : Key
  KDown : Key
  KHome : Key
  KEnd : Key
  KTab : Key
  KCtrK : Key
  KCtrU : Key
  KCtrW : Key
  KCtrL : Key
  KCtrR : Key
  KCtrC : Key
  KCtrD : Key
  KEsc : Key
  KEof : Key
  -- 空闲 tick（0.1s 内没有输入；只用于 resize 检测，不产生编辑动作）。
  KIdle : Key
  -- 一次括号粘贴的完整内容（可能含换行）。
  KPaste : String -> Key
  KIgnore : Key

editLine : EditConfig -> Eff [] EditOutcome
editLine cfg = do
  path <- termTmpPath 0
  saved <- termSaveState path
  if saved /= 0 then pure EditUnavailable
  else do
    rawOk <- termEnterRaw 0
    if rawOk /= 0 then do
      _ <- termRestoreState path
      pure EditUnavailable
    else
      let
        st0 = EditState [] 0 0 [] False [] Nothing
      in do
        _ <- pasteEnable 0
        -- 进入空闲轮询模式（min 0 time 1）：没有输入时每 0.1s 醒一次用于 resize 检测，
        -- 不忙等；原绑定键读取改由 readKey 的 KIdle 分支处理。
        _ <- termReadTimeout 0
        _ <- redraw cfg cfg.editWidth st0
        -- fuel 上限：空闲 tick 也扣 1，1e7 tick ≈ 11.6 天（远超一次交互会话）。
        -- 边界：timed read 的**超时与 EOF 都返回 -1**（`prim_eff_readBytes` 无法区分），本编辑器
        -- 一律当 KIdle——所以 tty 关闭/EOF 会退化成空闲轮询，耗尽 fuel 后以 ECancel 结束
        -- （≈11.6 天）；正常退出靠 Ctrl-D（空行）或 `:quit`，不依赖 EOF 判定。
        result <- editLoop 10000000 cfg cfg.editWidth 0 st0
        -- 先关括号粘贴（终端设置），再恢复 raw 前保存的终端状态。
        _ <- pasteDisable 0
        _ <- termRestoreState path
        _ <- writeOut "\n"
        pure (outcomeOf result)

outcomeOf : EditResult -> EditOutcome
outcomeOf (ESubmit text) = EditLine text
outcomeOf EExit = EditEof
outcomeOf ECancel = EditCancel
outcomeOf (EContinue st) = EditLine (strOf st.esBuf)

-- 主循环：读一键 → 处理 → 重绘；`KIdle` 每 20 tick（≈2s）查一次终端宽度，
-- 变化时按新宽度重绘。`width` 是本轮使用的列数（初值来自 Repl 的 `stty size`）。
editLoop : Int -> EditConfig -> Int -> Int -> EditState -> Eff [] EditResult
editLoop fuel cfg width tick st = if fuel <= 0 then pure ECancel
else do
  key <- readKey 0
  if isIdleKey key then
    let
      tick2 = tick + 1
    in if tick2 < 20 then editLoop (fuel - 1) cfg width tick2 st
    else do
      width2 <- terminalWidth 0
      if width2 == width then editLoop (fuel - 1) cfg width 0 st
      else do
        _ <- redraw cfg width2 st
        editLoop (fuel - 1) cfg width2 0 st
  else do
    outcome <- applyKey cfg key st
    case outcome of
      EContinue st2 => do
        _ <- redraw cfg width st2
        editLoop (fuel - 1) cfg width 0 st2
      other => pure other

isIdleKey : Key -> Bool
isIdleKey KIdle = True
isIdleKey _ = False

-- ---------------------------------------------------------------
-- 按键解码
-- ---------------------------------------------------------------
-- 终端处于 `min 0 time 1`（0.1s 超时）模式：没有输入时返回 KIdle，交给 resize 检测。
-- Esc 序列的后续字节也用同一超时读取：单独的 Esc 键会在 0.1s 超时后判为 KEsc。
readKey : Int -> Eff [] Key
readKey _ = do
  b <- termReadByte 0
  if b < 0 then pure KIdle
  else if b == 13 || b == 10 then pure KEnter
  else if b == 127 || b == 8 then pure KBackspace
  else case b of
    3 => pure KCtrC
    4 => pure KCtrD
    1 => pure KHome
    5 => pure KEnd
    11 => pure KCtrK
    21 => pure KCtrU
    23 => pure KCtrW
    12 => pure KCtrL
    18 => pure KCtrR
    16 => pure KUp
    14 => pure KDown
    2 => pure KLeft
    6 => pure KRight
    9 => pure KTab
    27 => readEscape 0
    _ => pure (KChar b)

readEscape : Int -> Eff [] Key
readEscape _ = do
  b2 <- termReadByte 0
  if b2 < 0 then pure KEsc else if b2 == 91 || b2 == 79 then csiKey 0 else pure KIgnore

-- CSI / SS3：`ESC [ ... final`。参数位只取第一个数值（`;` 之后的忽略），最多 16 字节；
-- 支持的 final：A/B/C/D（方向）、H/F（Home/End）、`~` 加参数（1/7 Home、4/8 End、
-- 3 Delete、200 括号粘贴开始——随后读到 `ESC [ 2 0 1 ~` 为止作为一次粘贴内容）。
csiKey : Int -> Eff [] Key
csiKey _ = csiParams 16 0 0

csiParams : Int -> Int -> Int -> Eff [] Key
csiParams fuel acc digits = if fuel <= 0 then pure KIgnore
else do
  b <- termReadByte 0
  if b < 0 then pure KIgnore
  else if b >= 48 && b <= 57 then csiParams (fuel - 1) (acc * 10 + (b - 48)) (digits + 1)
  else case b of
    59 => csiParams (fuel - 1) acc (digits + 1)
    126 => if digits == 0 then pure KIgnore else csiTilde acc
    _ => if b >= 64 && b <= 90 then pure (csiLetter b) else pure KIgnore

csiLetter : Int -> Key
csiLetter 65 = KUp
csiLetter 66 = KDown
csiLetter 67 = KRight
csiLetter 68 = KLeft
csiLetter 72 = KHome
csiLetter 70 = KEnd
csiLetter _ = KIgnore

csiTilde : Int -> Eff [] Key
csiTilde 1 = pure KHome
csiTilde 7 = pure KHome
csiTilde 3 = pure KDelete
csiTilde 4 = pure KEnd
csiTilde 8 = pure KEnd
csiTilde 200 = do
  text <- readPasteBody 0
  pure (KPaste text)
csiTilde _ = pure KIgnore

-- ---------------------------------------------------------------
-- 按键处理
-- ---------------------------------------------------------------
applyKey : EditConfig -> Key -> EditState -> Eff [] EditResult
applyKey cfg key st =
  if st.esSearching then applySearchKey cfg key st else applyNormalKey cfg key st

applyNormalKey : EditConfig -> Key -> EditState -> Eff [] EditResult
applyNormalKey cfg (KChar b) st =
  if b >= 32 then pure (EContinue (insertByte b st)) else pure (EContinue st)
applyNormalKey cfg KEnter st = pure (ESubmit (strOf st.esBuf))
applyNormalKey cfg KBackspace st = pure (EContinue (deleteBack st))
applyNormalKey cfg KDelete st = pure (EContinue (deleteAt st))
applyNormalKey cfg KLeft st = pure (EContinue (withCursor st (prevCharStart st.esBuf st.esCursor)))
applyNormalKey cfg KRight st = pure (EContinue (withCursor st (nextCharStart st.esBuf st.esCursor)))
applyNormalKey cfg KHome st = pure (EContinue (withCursor st 0))
applyNormalKey cfg KEnd st = pure (EContinue (withCursor st (lenInt st.esBuf)))
applyNormalKey cfg KUp st = pure (EContinue (historyUp cfg st))
applyNormalKey cfg KDown st = pure (EContinue (historyDown cfg st))
applyNormalKey cfg KTab st = do
  st2 <- complete cfg st
  pure (EContinue st2)
applyNormalKey cfg KCtrK st = pure (EContinue (killToEnd st))
applyNormalKey cfg KCtrU st = pure (EContinue (killToStart st))
applyNormalKey cfg KCtrW st = pure (EContinue (killWord st))
applyNormalKey cfg KCtrL st = do
  _ <- writeOut "${escCode}[2J${escCode}[H"
  pure (EContinue st)
applyNormalKey cfg KCtrR st = pure (EContinue (startSearch st))
applyNormalKey cfg KCtrC st = pure ECancel
applyNormalKey cfg KCtrD st =
  if lenInt st.esBuf == 0 then pure EExit else pure (EContinue (deleteAt st))
applyNormalKey cfg KEsc st = pure (EContinue st)
applyNormalKey cfg KEof st = if lenInt st.esBuf == 0 then pure EExit else pure (EContinue st)
applyNormalKey cfg KIdle st = pure (EContinue st)
applyNormalKey cfg (KPaste text) st = pure (EContinue (insertText st text))
applyNormalKey cfg KIgnore st = pure (EContinue st)

applySearchKey : EditConfig -> Key -> EditState -> Eff [] EditResult
applySearchKey cfg (KChar b) st =
  if b >= 32 then pure (EContinue (searchQueryAppend cfg st b)) else pure (EContinue st)
applySearchKey cfg KBackspace st = pure (EContinue (searchQueryBackspace cfg st))
applySearchKey cfg KCtrR st = pure (EContinue (searchContinue cfg st))
applySearchKey cfg KEnter st = case st.esMatch of
  Just (Pair idx entry) => pure (EContinue (acceptSearch st idx entry))
  Nothing => pure (EContinue (acceptSearchText st (strOf st.esQuery)))
applySearchKey cfg KEsc st = pure (EContinue (exitSearch st))
applySearchKey cfg KCtrC st = pure (EContinue (exitSearch st))
applySearchKey cfg KLeft st = pure (EContinue (exitSearch st))
applySearchKey cfg KRight st = pure (EContinue (exitSearch st))
applySearchKey cfg KIdle st = pure (EContinue st)
applySearchKey cfg (KPaste text) st = pure (EContinue (searchAppendText cfg st text))
applySearchKey cfg _ st = pure (EContinue st)

-- 粘贴进搜索查询：逐字节追加（与打字同语义），不触发其它按键。
searchAppendText : EditConfig -> EditState -> String -> EditState
searchAppendText cfg st text = searchAppendBytes cfg st (strUnpack text)

searchAppendBytes : EditConfig -> EditState -> List Int -> EditState
searchAppendBytes cfg st [] = st
searchAppendBytes cfg st (b :: rest) =
  if b >= 32 then searchAppendBytes cfg (searchQueryAppend cfg st b) rest
  else searchAppendBytes cfg st rest

-- ---------------------------------------------------------------
-- 编辑原语
-- ---------------------------------------------------------------
lenInt : List a -> Int
lenInt [] = 0
lenInt (_ :: rest) = 1 + lenInt rest

imax : Int -> Int -> Int
imax a b = if a >= b then a else b

immin : Int -> Int -> Int
immin a b = if a <= b then a else b

strOf : List Int -> String
strOf = strPack

isContinuation : Int -> Bool
isContinuation b = b >= 128 && b < 192

isSpaceByte : Int -> Bool
isSpaceByte b = b == 32 || b == 9

prevCharStart : List Int -> Int -> Int
prevCharStart buf cur = prevCharGo (reverse (take cur buf)) cur

prevCharGo : List Int -> Int -> Int
prevCharGo [] cur = 0
prevCharGo (b :: rest) cur = if isContinuation b then prevCharGo rest (cur - 1) else cur - 1

nextCharStart : List Int -> Int -> Int
nextCharStart buf cur =
  let
    total = lenInt buf
  in if cur >= total then total else immin total (cur + 1 + contCount (nthByte buf cur))

nthByte : List Int -> Int -> Int
nthByte buf i = case drop i buf of
  b :: rest => b
  [] => 0

insertByte : Int -> EditState -> EditState
insertByte b st =
  let
    buf2 = append (append (take st.esCursor st.esBuf) [b]) (drop st.esCursor st.esBuf)
  in EditState buf2 (st.esCursor + 1) 0 st.esDraft st.esSearching st.esQuery st.esMatch

-- 一次插入一段文本（括号粘贴）：换行作为普通字节进缓冲，不算提交。
insertText : EditState -> String -> EditState
insertText st text =
  let
    bytes = strUnpack text
    buf2 = append (append (take st.esCursor st.esBuf) bytes) (drop st.esCursor st.esBuf)
  in withBuf st buf2 (st.esCursor + lenInt bytes)

withCursor : EditState -> Int -> EditState
withCursor st cur =
  EditState st.esBuf cur st.esHistIdx st.esDraft st.esSearching st.esQuery st.esMatch

withBuf : EditState -> List Int -> Int -> EditState
withBuf st buf cur = EditState buf cur 0 st.esDraft st.esSearching st.esQuery st.esMatch

deleteBack : EditState -> EditState
deleteBack st =
  let
    start = prevCharStart st.esBuf st.esCursor
  in withBuf st (removeRange start st.esCursor st.esBuf) start

deleteAt : EditState -> EditState
deleteAt st = if st.esCursor >= lenInt st.esBuf then st
else
  let
    end = nextCharStart st.esBuf st.esCursor
  in withBuf st (removeRange st.esCursor end st.esBuf) st.esCursor

removeRange : Int -> Int -> List Int -> List Int
removeRange start end buf = append (take start buf) (drop end buf)

killToEnd : EditState -> EditState
killToEnd st = withBuf st (take st.esCursor st.esBuf) st.esCursor

killToStart : EditState -> EditState
killToStart st = withBuf st (drop st.esCursor st.esBuf) 0

killWord : EditState -> EditState
killWord st =
  let
    start = wordStart st.esBuf st.esCursor
  in withBuf st (removeRange start st.esCursor st.esBuf) start

wordStart : List Int -> Int -> Int
wordStart buf cur = wsSpace (reverse (take cur buf)) cur

wsSpace : List Int -> Int -> Int
wsSpace [] cur = cur
wsSpace (b :: rest) cur = if isSpaceByte b then wsSpace rest (cur - 1) else wsWord rest cur

wsWord : List Int -> Int -> Int
wsWord [] cur = cur
wsWord (b :: rest) cur = if isSpaceByte b then cur else wsWord rest (cur - 1)

-- ---------------------------------------------------------------
-- 历史
-- ---------------------------------------------------------------
fromNewest : Int -> List String -> Maybe String
fromNewest n xs = if n <= 0 then Nothing else elemAt (lenInt xs - n) xs

elemAt : Int -> List a -> Maybe a
elemAt i xs = case drop i xs of
  x :: rest => Just x
  [] => Nothing

historyUp : EditConfig -> EditState -> EditState
historyUp cfg st =
  let
    hi = st.esHistIdx
    draft = if hi == 0 then st.esBuf else st.esDraft
    total = lenInt cfg.editHistory
  in if hi >= total then st
  else case fromNewest (hi + 1) cfg.editHistory of
    Nothing => st
    Just entry => EditState (strUnpack entry) (byteLength entry) (hi + 1) draft False [] Nothing

historyDown : EditConfig -> EditState -> EditState
historyDown cfg st =
  let
    hi = st.esHistIdx
  in if hi <= 0 then st
  else if hi == 1 then EditState st.esDraft (lenInt st.esDraft) 0 st.esDraft False [] Nothing
  else case fromNewest (hi - 1) cfg.editHistory of
    Nothing => st
    Just entry =>
      EditState (strUnpack entry) (byteLength entry) (hi - 1) st.esDraft False [] Nothing

-- ---------------------------------------------------------------
-- 补全
-- ---------------------------------------------------------------
complete : EditConfig -> EditState -> Eff [] EditState
complete cfg st =
  let
    start = tokenStart st.esBuf st.esCursor
    prefix = strOf (take (st.esCursor - start) (drop start st.esBuf))
    kind = argKindOf st.esBuf st.esCursor
  in if prefix == "" then pure st
  else do
    pool <- if kind == 0 then pure cfg.editCompletions else argCompletions kind cfg.editRoots prefix
    let
      cands = filter (\c => startsWith prefix c && byteLength c > byteLength prefix) pool
    in case cands of
      [] => bell st
      [c] =>
        pure
          (withBuf st (append (append (take start st.esBuf) (strUnpack c)) (drop st.esCursor st.esBuf)) (start + byteLength c))
      _ =>
        let
          common = commonPrefixStrs cands
        in if byteLength common > byteLength prefix then pure
          (withBuf st (append (append (take start st.esBuf) (strUnpack common)) (drop st.esCursor st.esBuf)) (start + byteLength common))
        else bell st

bell : EditState -> Eff [] EditState
bell st = do
  _ <- writeOut (strPack [7])
  pure st

tokenStart : List Int -> Int -> Int
tokenStart buf cur = tokenGo (reverse (take cur buf)) cur

tokenGo : List Int -> Int -> Int
tokenGo [] cur = 0
tokenGo (b :: rest) cur = if isSpaceByte b then cur else tokenGo rest (cur - 1)

commonPrefixStrs : List String -> String
commonPrefixStrs [] = ""
commonPrefixStrs (x :: rest) = prefixFold x rest

prefixFold : String -> List String -> String
prefixFold acc [] = acc
prefixFold acc (y :: rest) = prefixFold (commonPrefix2 acc y) rest

commonPrefix2 : String -> String -> String
commonPrefix2 a b = strOf (commonPrefixBytes (strUnpack a) (strUnpack b))

commonPrefixBytes : List Int -> List Int -> List Int
commonPrefixBytes [] ys = []
commonPrefixBytes xs [] = []
commonPrefixBytes (x :: xs) (y :: ys) = if x == y then x :: commonPrefixBytes xs ys else []

-- ---------------------------------------------------------------
-- Ctrl-R 反向搜索
-- ---------------------------------------------------------------
startSearch : EditState -> EditState
startSearch st = EditState st.esBuf st.esCursor 0 st.esDraft True [] Nothing

searchQueryAppend : EditConfig -> EditState -> Int -> EditState
searchQueryAppend cfg st b =
  let
    query = append st.esQuery [b]
  in EditState st.esBuf st.esCursor 0 st.esDraft True query (searchFrom cfg.editHistory 1 query)

searchQueryBackspace : EditConfig -> EditState -> EditState
searchQueryBackspace cfg st =
  let
    query =
      if lenInt st.esQuery == 0 then []
      else take (prevCharStart st.esQuery (lenInt st.esQuery)) st.esQuery
  in EditState st.esBuf st.esCursor 0 st.esDraft True query (searchFrom cfg.editHistory 1 query)

searchContinue : EditConfig -> EditState -> EditState
searchContinue cfg st =
  let
    start = case st.esMatch of
      Just (Pair idx entry) => idx + 1
      Nothing => 1
  in EditState st.esBuf st.esCursor 0 st.esDraft True st.esQuery
    (searchFrom cfg.editHistory start st.esQuery)

searchFrom : List String -> Int -> List Int -> Maybe (Pair Int String)
searchFrom history start query = searchFromGo (drop (imax 0 (start - 1)) history) start query

searchFromGo : List String -> Int -> List Int -> Maybe (Pair Int String)
searchFromGo [] idx query = Nothing
searchFromGo (entry :: rest) idx query =
  if lenInt query == 0 || contains (strOf query) entry then Just (Pair idx entry)
  else searchFromGo rest (idx + 1) query

acceptSearch : EditState -> Int -> String -> EditState
acceptSearch st idx entry =
  EditState (strUnpack entry) (byteLength entry) idx st.esDraft False [] Nothing

acceptSearchText : EditState -> String -> EditState
acceptSearchText st text =
  EditState (strUnpack text) (byteLength text) 0 st.esDraft False [] Nothing

exitSearch : EditState -> EditState
exitSearch st = EditState st.esBuf st.esCursor st.esHistIdx st.esDraft False [] Nothing

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
redraw : EditConfig -> Int -> EditState -> Eff [] Int
redraw cfg width st = if st.esSearching then redrawSearch cfg st else redrawNormal cfg width st

redrawNormal : EditConfig -> Int -> EditState -> Eff [] Int
redrawNormal cfg width st =
  let
    avail = imax 8 (width - cfg.editPromptWidth)
    win = tailWindow avail st.esBuf
    left = immin (bytesWidth (drop st.esCursor st.esBuf)) (bytesWidth win)
    text = "${cfg.editPrompt}${renderBytes win}${escCode}[K${moveLeftText left}"
  in writeOut "\r${text}"

-- 缓冲字节 → 显示文本：裸换行（粘贴/历史里的多行单元）渲染成单列 `↵`，
-- 其余字节原样输出（宽度口径与 `bytesWidth` 一致：换行算 1 列）。
renderBytes : List Int -> String
renderBytes [] = ""
renderBytes (b :: rest) =
  if b == 10 then "↵${renderBytes rest}" else "${strPack [b]}${renderBytes rest}"

redrawSearch : EditConfig -> EditState -> Eff [] Int
redrawSearch cfg st =
  let
    queryText = strOf st.esQuery
    matchText = case st.esMatch of
      Just (Pair idx entry) => entry
      Nothing => ""
    promptText = "(reverse-i-search)`${queryText}': "
    styled = if cfg.editColorOn then ansi "36" promptText ++ matchText else promptText ++ matchText
  in writeOut "\r${styled}${escCode}[K"

-- 超宽时只显示尾部 avail 列（按 UTF-8 码点边界裁）。
tailWindow : Int -> List Int -> List Int
tailWindow avail buf =
  if bytesWidth buf <= avail then buf else dropToWidth (bytesWidth buf - avail) buf

dropToWidth : Int -> List Int -> List Int
dropToWidth k buf = dropToWidthGo k 0 buf

dropToWidthGo : Int -> Int -> List Int -> List Int
dropToWidthGo k skip [] = []
dropToWidthGo k skip (b :: rest) =
  if skip > 0 then dropToWidthGo k (skip - 1) rest
  else if k <= 0 then b :: rest
  else if isContinuation b then dropToWidthGo k 0 rest
  else dropToWidthGo (k - cpWidth b) (contCount b) rest

-- 显示宽度近似：续字节 0；CJK 常见区段 2；其余 1（组合字符/emoji 可能偏 1 格）。
bytesWidth : List Int -> Int
bytesWidth [] = 0
bytesWidth (b :: rest) = if isContinuation b then bytesWidth rest else cpWidth b + bytesWidth rest

cpWidth : Int -> Int
cpWidth b = if b >= 240 then 2 else if b >= 228 && b <= 233 then 2 else 1

contCount : Int -> Int
contCount b = if b >= 240 then 3 else if b >= 224 then 2 else if b >= 192 then 1 else 0

moveLeftText : Int -> String
moveLeftText n = if n > 0 then "${escCode}[${n}D" else ""
