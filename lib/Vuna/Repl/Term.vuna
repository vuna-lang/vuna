module Vuna.Repl.Term where

-- Vuna.Repl.Term：REPL 行编辑的终端层（工具链；不进 seed 闭包）。
--
-- 只用现有原语：`@vuna@prim_eff_runIn` 调 POSIX `stty` 做终端模式/尺寸，`@vuna@prim_eff_readBytes 1` 逐字节
-- 读入。没有给编译器加终端原语，TCB 不变；非 POSIX 或 stty 不可用时调用方回退到
-- `@vuna@prim_eff_readLine`。
--
-- 约定：所有函数返回 Int/Bool，失败返回非 0，不抛异常（读字节返回 -1 = EOF/超时，
-- 具体含义由调用方按当前读模式解释）。
import Base.HostRow
import Vuna.Cli.Args
import Vuna.Compiler.Common

export escCode : String
escCode = strPack [27]

export ansi : String -> String -> String
ansi code s = "${escCode}[${code}m${s}${escCode}[0m"

-- 单引号 shell 转义（路径可能来自 TMPDIR）。
export shellQuote : String -> String
shellQuote s = "'${shellEscaped (strUnpack s)}'"

shellEscaped : List Int -> String
shellEscaped [] = ""
shellEscaped (c :: rest) =
  if c == 39 then "'\\''${shellEscaped rest}" else strPack [c] ++ shellEscaped rest

-- 会话级临时路径（stty 状态 / 尺寸文件）；同一进程内 effTimeUs 保证不撞名。
export termTmpPath : Int -> Eff hostRow String
termTmpPath _ = do
  base <- termTempBase 0
  now <- raiseToRow hostRow effTimeUs
  pure "${base}/vuna-repl-term-${now}"

termTempBase : Int -> Eff hostRow String
termTempBase _ = do
  env <- raiseToRow hostRow (@vuna@prim_eff_getenv "TMPDIR")
  pure
    (if env == "" then "/tmp" else if endsWith "/" env then substring 0 (byteLength env - 1) env else env)

export rmFile : String -> Eff hostRow Int
rmFile path = raiseToRow hostRow (@vuna@prim_eff_runIn "/" ["rm", "-f", path])

-- `stty -g > path`：保存终端状态。
export termSaveState : String -> Eff hostRow Int
termSaveState path = do
  code <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["sh", "-c", "stty -g > ${shellQuote path}"])
  if code == 0 then do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
    pure (if exists then 0 else 1)
  else pure 1

-- `stty <saved>`：恢复终端；失败再试 `stty sane`。
export termRestoreState : String -> Eff hostRow Int
termRestoreState path = do
  textR <- readText path
  let
    saved = case textR of
      ErrC e => ""
      OkC s => trim s
  in do
    code <-
      if saved == "" then pure 1 else raiseToRow hostRow (@vuna@prim_eff_runIn "." ["stty", saved])
    _ <- rmFile path
    if code == 0 then pure 0 else raiseToRow hostRow (@vuna@prim_eff_runIn "." ["stty", "sane"])

-- `stty raw -echo min 1 time 0`：原始模式，逐字节阻塞读。
export termEnterRaw : Int -> Eff hostRow Int
termEnterRaw _ =
  raiseToRow hostRow (@vuna@prim_eff_runIn "." ["stty", "raw", "-echo", "min", "1", "time", "0"])

-- Esc 序列探测用：0.1s 超时读（readByte 返回 -1 = 无后续字节）。
export termReadTimeout : Int -> Eff hostRow Int
termReadTimeout _ = raiseToRow hostRow (@vuna@prim_eff_runIn "." ["stty", "min", "0", "time", "1"])

-- 恢复阻塞读。
export termReadBlock : Int -> Eff hostRow Int
termReadBlock _ = raiseToRow hostRow (@vuna@prim_eff_runIn "." ["stty", "min", "1", "time", "0"])

-- 读 1 字节；EOF 或超时返回 -1。
export termReadByte : Int -> Eff hostRow Int
termReadByte _ = do
  s <- raiseToRow hostRow (@vuna@prim_eff_readBytes 1)
  pure (case strUnpack s of
    [] => 0 - 1
    b :: rest => b
  )

-- 终端列数；失败默认 80。
export termWidth : Int -> Eff hostRow Int
termWidth _ = do
  base <- termTmpPath 0
  let
    path = "${base}.size"
  in do
    _ <-
      raiseToRow hostRow (@vuna@prim_eff_runIn "." ["sh", "-c", "stty size > ${shellQuote path}"])
    textR <- readText path
    let
      text = case textR of
        ErrC e => ""
        OkC s => trim s
      parts = filter (\p => p /= "") (split " " text)
    in do
      _ <- rmFile path
      pure (case parts of
        _ :: cols :: rest => case parseDigitsInt cols of
          Just n => if n > 0 then n else 80
          Nothing => 80
        _ => 80
      )

parseDigitsInt : String -> Maybe Int
parseDigitsInt s = if s == "" then Nothing else parseDigits (strUnpack s) 0

parseDigits : List Int -> Int -> Maybe Int
parseDigits [] acc = Just acc
parseDigits (c :: rest) acc =
  if c >= 48 && c <= 57 then parseDigits rest (acc * 10 + (c - 48)) else Nothing

export writeOut : String -> Eff hostRow Int
writeOut s = raiseToRow hostRow (@vuna@prim_eff_print s)
