module Vuna.Files
  ( collectSourceFiles
  , collectVunaFiles
  , exampleOf
  , pathExistsDir
  , pathExistsFile
  ) where

-- Vuna.Files：目录遍历工具（fmt / doc / test / Index 共用）。
-- 只依赖 prim_readDir / prim_isDirectory / prim_fileExists 内建；prim_readDir 返回字典序，遍历顺序确定。
-- 路径拆分（splitPath / baseName）在 Vuna.Compiler.Common，供编译器驱动与工具共用。
--
-- 注意：内建 `prim_isDirectory` 对**不存在的路径**会抛异常（会直接终止进程），
-- 所以任何来自用户输入的路径都必须先用 `pathExistsDir` 判存在，
-- 不要直接调用 `prim_isDirectory`。
import Vuna.Compiler.Common
import Base.IO.Host

-- C41：工具链 fuel 耗尽不是「空结果」，而是内部不变量被破坏；与编译器一致硬失败。
toolFuelExhausted : String -> a
toolFuelExhausted what = prim_fail "vuna: internal: ${what} fuel exhausted"

-- 递归收集目录下所有 .vuna 文件（跳过 . / .. 与隐藏项）。
-- 同时跳过生成物与本地缓存目录：它们可能包含符号链接 / 超大文件，
-- 既不该被格式化，也不该被 doc / test 扫描。
-- `corpus` 也跳过：test/corpus/ 下的 .vuna 是**夹具**，大量是故意不合法的源码
-- （解析错误、缩进错误、类型错误用例），格式化器 / 文档生成器不应该扫它们。
skipGenerated : String -> Bool
skipGenerated name =
  name == ".git"
    || name == ".local"
    || name == ".output"
    || name == ".direnv"
    || name == "node_modules"
    || name == ".vscode"
    || name == "_scratch"
    || name == ".dsh-plugins"
    || name == "result"
    || name == "corpus"

collectVunaFiles : String -> List String
collectVunaFiles dir = collectVunaFilesGo 1048576 dir

-- 目录树是文件系统图（符号链接可成环），递归无法用结构下降证明；用显式 fuel 守卫。
-- 每次进入下一层目录消耗 1，触底返回空列表（合法目录树远小于该上限）。
collectVunaFilesGo : Int -> String -> List String
collectVunaFilesGo fuel dir =
  if fuel <= 0 then toolFuelExhausted "directory walk"
  else if pathExistsDir dir then concatMap (walkVunaGo (fuel - 1) dir) (runIO (prim_readDir dir)) else []

walkVunaGo : Int -> String -> String -> List String
walkVunaGo fuel dir name = if fuel <= 0 then toolFuelExhausted "directory walk"
else case name of
  "." => []
  ".." => []
  _ => if skipGenerated name then []
  else
    let
      path = "${dir}/${name}"
    in if pathExistsDir path then collectVunaFilesGo (fuel - 1) path
    else if endsWith ".vuna" name then [path] else []

-- 递归收集目录下所有非隐藏项（文件与目录），用于通用遍历。
collectSourceFiles : String -> List String
collectSourceFiles dir = collectSourceFilesGo 1048576 dir

collectSourceFilesGo : Int -> String -> List String
collectSourceFilesGo fuel dir =
  if fuel <= 0 then toolFuelExhausted "directory walk"
  else if pathExistsDir dir then concatMap (walkAnyGo (fuel - 1) dir) (runIO (prim_readDir dir)) else []

walkAnyGo : Int -> String -> String -> List String
walkAnyGo fuel dir name = if fuel <= 0 then toolFuelExhausted "directory walk"
else case name of
  "." => []
  ".." => []
  _ => if skipGenerated name then []
  else
    let
      path = "${dir}/${name}"
    in if pathExistsDir path then collectSourceFilesGo (fuel - 1) path else [path]

-- 安全的目录判定：不存在返回 False，而不是抛异常。
pathExistsDir : String -> Bool
pathExistsDir path = pathExistsFile path && runIO (prim_isDirectory path)

pathExistsFile : String -> Bool
pathExistsFile path = runIO (prim_fileExists path)

-- ---------------------------------------------------------------
-- 诊断码 → 示例夹具（`explain`/`gen-errors` 共用；生成物不参与门禁）
-- ---------------------------------------------------------------
-- | 在 test/corpus（及 test/ 工作目录下的 corpus）找第一个包含该码的 `.diag.json`。
exampleOf : String -> Maybe String
exampleOf code = case findDiagExample 512 "test/corpus" code of
  Just p => Just p
  Nothing => case findDiagExample 512 "corpus" code of
    Just p => Just p
    Nothing => findDiagExample 512 "../test/corpus" code

findDiagExample : Int -> String -> String -> Maybe String
findDiagExample fuel dir code =
  if fuel <= 0 then Nothing
  else if not (pathExistsDir dir) then Nothing
  else firstJustExamples (map (oneEntry (fuel - 1) dir code) (runIO (prim_readDir dir)))

oneEntry : Int -> String -> String -> String -> Maybe String
oneEntry fuel dir code name = if name == "." || name == ".." || name == ".git" || name == ".local" then Nothing
else
  let
    path = "${dir}/${name}"
  in if pathExistsDir path then findDiagExample fuel path code
  else if endsWith ".diag.json" name && pathExistsFile path then if contains "\"code\":\"${code}\"" (runIO (prim_readFile path)) then Just path else Nothing
  else Nothing

firstJustExamples : List (Maybe String) -> Maybe String
firstJustExamples [] = Nothing
firstJustExamples ((Just x) :: rest) = Just x
firstJustExamples (Nothing :: rest) = firstJustExamples rest
