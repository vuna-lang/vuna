module Vuna.Test.Run (runSuite) where

-- Vuna.Test.Run：suite 模式的原生执行器。
--
-- 数据流：
--   test/suite.toml -> Vuna.Test.Suite.discoverCases -> 本模块并行执行
--   -> 每 case 独立临时目录 + 子进程 capture/timeout -> 结果/汇总/JSON
--
-- 并行模型：父进程按 `--jobs` spawn N 个自身（隐藏 `--worker i/N`），worker 按
-- `index mod N` 静态分片；每个 case 写一份 TSV 到临时 results 目录，父进程按序
-- 读回。这样避开 `prim_wait` 只能等指定 pid 的队首阻塞，也避免父进程收集海量输出。
--
-- 子进程输出捕获不新增编译器原语：把一段固定的 shell helper 写进临时目录，由
-- helper 做 `timeout ... >out 2>err`，Vuna 侧只读文件 + 退出码。
import Vuna.Compiler.Common
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Iface
import qualified Vuna.Cli.Args
import Vuna.Test.Session
import Vuna.Test.Suite
import Vuna.Files
import Vuna.Json
import Base.IO.Host
import Base.IORef

-- 执行环境。
record Env where
  envRoot : String
  envCwd : String
  envTmp : String
  envVuna : String
  envSeed : String
  envBase : String
  envOcamlopt : String
  envHelper : String
  envCacheDir : String
  envCacheEnabled : Bool
  envBaseHash : Int
  envBless : Bool
  envBlessDiag : Bool
  envWorker : Bool
  -- 增量构建桶（跨 run 持久；见 buildCacheDir）。
  envBuildDir : String
  -- 进程内精化会话（per worker）：base 依赖接口 + 增量精化的 termAux 缓存。
  -- 命中时 golden 的 check/interp 不再 spawn CLI（~200ms → ~10ms），未命中回退子进程。
  envSession : IORef Session

-- 一次子进程调用：退出码 + 分离的 stdout/stderr + 是否被 timeout 杀掉。
record CmdResult where
  cmdCode : Int
  cmdOut : String
  cmdErr : String
  cmdTimedOut : Bool

-- 一条断言。
record Assertion where
  assertionName : String
  assertionOk : Bool
  assertionDetail : String

-- 一个 case 的结果。
record CaseResult where
  resId : String
  resStatus : String
  resPass : Int
  resFail : Int
  resChecks : Int
  resMs : Int
  resMessages : List String

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
envVar : String -> String
envVar name = runIO (getEnv name)

envOr : String -> String -> String
envOr name fallback =
  let
    value = envVar name
  in if value == "" then fallback else value

strOfInt : Int -> String
strOfInt n = strFromInt n

-- 去掉结尾换行（命令替换语义；旧套件用 $(...) 会吃掉尾随换行）。
trimNewlines : String -> String
trimNewlines s =
  let
    rev = reverse (strUnpack s)
    kept = dropNewlineChars rev
  in strPack (reverse kept)

dropNewlineChars : List Int -> List Int
dropNewlineChars [] = []
dropNewlineChars (c :: rest) = if c == 10 then dropNewlineChars rest else c :: rest

-- 文件名安全化：case id 里的 `/` 等替换成 `_`（避免把临时产物写进子目录）。
safeName : String -> String
safeName s = strPack (map safeChar (strUnpack s))

safeChar : Int -> Int
safeChar c =
  if c >= 97 && c <= 122 then c
  else if c >= 65 && c <= 90 then c
  else if c >= 48 && c <= 57 then c else if c == 45 || c == 46 || c == 95 then c else 95

listLength : List a -> Int
listLength [] = 0
listLength (x :: rest) = 1 + listLength rest

sumInts : List Int -> Int
sumInts [] = 0
sumInts (x :: rest) = x + sumInts rest

-- ---------------------------------------------------------------
-- 临时目录与 helper
-- ---------------------------------------------------------------
-- 临时根必须位于**任何 vuna.toml 之外**：§39 一类用例要验证「无 manifest → base-only」，
-- 若临时根落在包内（Nix 沙箱里 TMPDIR 可能就是工作树根），向上找 manifest 会命中仓库根包，
-- 上下文语义被悄悄改写。策略：优先 TMPDIR，其次 /tmp；两者都在
-- manifest 内时回落 TMPDIR（调用方自己的断言会暴露问题）。
hasManifestAncestorFuel : Int -> String -> Bool
hasManifestAncestorFuel fuel dir = if fuel <= 0 then False
else if pathExistsFile "${dir}/vuna.toml" then True
else
  let
    parent = Vuna.Cli.Args.parentOf dir
  in if parent == dir then False else hasManifestAncestorFuel (fuel - 1) parent

hasManifestAncestor : String -> Bool
hasManifestAncestor dir = hasManifestAncestorFuel 64 dir

firstManifestFree : List String -> Maybe String
firstManifestFree [] = Nothing
firstManifestFree (dir :: rest) =
  if pathExistsDir dir && not (hasManifestAncestor dir) then Just dir else firstManifestFree rest

tempBase : String
tempBase =
  let
    value = envVar "TMPDIR"
    primary =
      if value == "" then "/tmp"
      else if endsWith "/" value then substring 0 (byteLength value - 1) value else value
  in case firstManifestFree [primary, "/tmp"] of
    Just dir => dir
    Nothing => primary

freshTempRoot : Int -> String -> String
freshTempRoot fuel candidate = if fuel <= 0 then candidate
else if pathExistsFile candidate then freshTempRoot (fuel - 1) "${candidate}-${strOfInt fuel}"
else
  let
    _ = ensureDirPath candidate
  in candidate

makeTempRoot : String -> String
makeTempRoot tag =
  let
    stamp = strOfInt (runIO nowMicros)
  in freshTempRoot 1000 "${tempBase}/vuna-suite-${stamp}-${safeName tag}"

helperScript : String
helperScript =
  "#!/bin/sh\nsecs=$1\nout=$2\nerr=$3\ninp=$4\nmerge=$5\nshift 5\nif [ \"$secs\" -gt 0 ] && command -v timeout >/dev/null 2>&1; then\n  if [ \"$merge\" = \"1\" ]; then\n    if [ \"$inp\" = \"-\" ]; then\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" >\"$out\" 2>&1\n    else\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" <\"$inp\" >\"$out\" 2>&1\n    fi\n  else\n    if [ \"$inp\" = \"-\" ]; then\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" >\"$out\" 2>\"$err\"\n    else\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" <\"$inp\" >\"$out\" 2>\"$err\"\n    fi\n  fi\n  rc=$?\nelse\n  if [ \"$merge\" = \"1\" ]; then\n    if [ \"$inp\" = \"-\" ]; then\n      \"$@\" >\"$out\" 2>&1\n    else\n      \"$@\" <\"$inp\" >\"$out\" 2>&1\n    fi\n  else\n    if [ \"$inp\" = \"-\" ]; then\n      \"$@\" >\"$out\" 2>\"$err\"\n    else\n      \"$@\" <\"$inp\" >\"$out\" 2>\"$err\"\n    fi\n  fi\n  rc=$?\nfi\nexit $rc\n"

writeHelper : String -> String
writeHelper tmp =
  let
    path = "${tmp}/run-capture.sh"
    _ = runIO (writeFile path helperScript)
  in path

-- ---------------------------------------------------------------
-- 子进程
-- ---------------------------------------------------------------
readMaybeFile : String -> String
readMaybeFile path = if pathExistsFile path then runIO (readFile path) else ""

-- 运行 argv（cwd 由 prim_runIn 控制），timeout 秒级；返回退出码与分离输出。
runCmdWith : Bool -> Env -> String -> String -> Int -> List String -> CmdResult
runCmdWith merge env tag cwd secs argv =
  let
    outPath = "${env.envTmp}/cmd-${safeName tag}.out"
    errPath = "${env.envTmp}/cmd-${safeName tag}.err"
    fullArgv =
      append ["sh", env.envHelper, strOfInt secs, outPath, errPath, "-", if merge then "1" else "0"]
        argv
    code = runIO (prim_runIn cwd fullArgv)
    out = readMaybeFile outPath
    err = readMaybeFile errPath
  in CmdResult code out err (code == 124 || code == 137)

runCmd : Env -> String -> String -> Int -> List String -> CmdResult
runCmd env tag cwd secs argv = runCmdWith False env tag cwd secs argv

runCmdMerged : Env -> String -> String -> Int -> List String -> CmdResult
runCmdMerged env tag cwd secs argv = runCmdWith True env tag cwd secs argv

-- 给子进程注入 suite 需要的环境（父进程不能 setenv）。
withEnv : Env -> List String -> List String
withEnv env argv =
  append
    ["env", "VUNA=${env.envVuna}", "VUNA_SEED=${env.envSeed}", "VUNA_BASE=${env.envBase}", "OCAMLOPT=${env.envOcamlopt}", "VUNA_SUITE_ROOT=${env.envRoot}"]
    argv

-- family case 的 iface 镜像根：每个 worker/进程用独立 envTmp，避免并发写源文件旁
-- 的 `*.iface`；章节脚本保持默认布局（它们自己要测布局）。
withEnvIface : Env -> List String -> List String
withEnvIface env argv = withEnvIfaceAt env "${env.envTmp}/iface" argv

-- 指定 iface 目录的变体：seed 必须用自己的 iface（否则会读到新编译器写的
-- `*.iface`，旧 seed 的 AST schema 不同会直接崩溃；与 seed 的独立性语义无关）。
withEnvIfaceAt : Env -> String -> List String -> List String
withEnvIfaceAt env ifaceDir argv =
  withEnv env (append ["env", "TMPDIR=${env.envTmp}", "VUNA_IFACE_DIR=${ifaceDir}"] argv)

-- steps case 的进程环境：TMPDIR/iface/REPL 历史都按 **case** 隔离（同一 worker 内多个
-- steps case 顺序执行，共享 envTmp 会让 `$TMPDIR/ws1` 之类互相污染）。章节脚本时代的
-- harness 用 mktemp 给每段一个独立 tmp；这里由 runner 直接提供。
withStepsEnv : Env -> String -> List String -> List String
withStepsEnv env caseTmp argv =
  withEnv env
    (append ["env", "TMPDIR=${caseTmp}", "VUNA_IFACE_DIR=${caseTmp}/iface", "VUNA_REPL_HISTORY=${caseTmp}/repl-history"] argv)

combinedOut : CmdResult -> String
combinedOut r = r.cmdOut ++ r.cmdErr

-- ---------------------------------------------------------------
-- 断言
-- ---------------------------------------------------------------
assertExit : String -> Int -> Assertion
assertExit name code = Assertion name (code == 0) "exit ${strOfInt code}"

assertExitNonZero : String -> Int -> Assertion
assertExitNonZero name code = Assertion name (code /= 0) "expected non-zero exit, got 0"

assertContains : String -> String -> String -> Assertion
assertContains name hay needle =
  Assertion name (contains needle hay) "missing fragment: ${needle}\nactual:\n${hay}"

assertEq : String -> String -> String -> Assertion
assertEq name expected actual =
  Assertion name (expected == actual) "expected:\n${expected}\nactual:\n${actual}"

assertAbsent : String -> String -> Assertion
assertAbsent name path = Assertion name (not (pathExistsFile path)) "should not exist: ${path}"

assertSilent : String -> String -> Assertion
assertSilent name out = Assertion name (out == "") "expected no output, got:\n${out}"

countPass : List Assertion -> Int
countPass [] = 0
countPass (a :: rest) = (if a.assertionOk then 1 else 0) + countPass rest

countFail : List Assertion -> Int
countFail [] = 0
countFail (a :: rest) = (if a.assertionOk then 0 else 1) + countFail rest

failMessages : List Assertion -> List String
failMessages [] = []
failMessages (a :: rest) =
  if a.assertionOk then failMessages rest
  else "${a.assertionName}: ${a.assertionDetail}" :: failMessages rest

finishCase : String -> Int -> List Assertion -> CaseResult
finishCase id start assertions =
  let
    failed = countFail assertions
    ms = (runIO nowMicros - start) / 1000
  in CaseResult id (if failed == 0 then "pass" else "fail") (countPass assertions) failed
    (countPass assertions + failed) ms (failMessages assertions)

-- ---------------------------------------------------------------
-- golden / error case
-- ---------------------------------------------------------------
-- 预热依赖接口镜像：`vuna check <base>` 会把 base 的模块接口写进 `VUNA_IFACE_DIR`
-- （单文件 check/compile 不写）。会话初始化据此把「每次重精化整棵 base」降到
-- 「读接口 + 只精化入口」。失败只降级（会话回退 CLI），不影响用例结果。
-- 注意：预热写的是**会话专用**镜像（`iface-session`），不是子进程用的 `iface`
-- 镜像——子进程必须保持「无接口 ⇒ 全量精化」的既有行为，否则工具侧增量路径的
-- 差异（例如 deriving via field 的判定）会被带进用例语义。
warmIfaces : Env -> Int
warmIfaces env =
  (runCmdMerged env "iface-warmup" env.envCwd 300 (withEnvIfaceAt env "${env.envTmp}/iface-session" [env.envVuna, "check", env.envBase])).cmdCode

uniqueOutDir : Env -> String -> String
uniqueOutDir env id = "${env.envTmp}/out-${safeName id}"

removeTree : String -> Int
removeTree path = runIO (prim_runIn "/" ["rm", "-rf", path])

-- ---------------------------------------------------------------
-- 增量构建缓存：按「生成模块集」复用 ocamlopt 产物
-- ---------------------------------------------------------------
-- 每个 case 的 codegen 都产出「整棵 base + 自己的 Main.ml」；base 部分对同一模块集
-- 逐字节一致，但旧实现每个 case 用独立目录 ⇒ 每次从零 ocamlopt 编译 ~25 个单元
-- （~650ms）。这里先 codegen 到 case 私有 staging，再按 staging 里的模块集取
-- **每 worker 共享**的构建目录，整份拷进去后跑 build.sh：内容哈希 stamp 让 base 单元
-- 全部命中，只重编 Main.ml 并链接（~250ms）。模块集相同的 case 互相加速，模块集变
-- 化才付一次冷编译；worker 内 case 串行执行，目录无并发写。
-- key 用「名字哈希之和」：与 readDir 顺序无关；万一碰撞，build.sh 的 clean 检测会
-- 退回全量重建（只是慢，不会错）。
buildSetKey : List String -> String
buildSetKey names = strOfInt (nonNegTotal (map hashTextStrong names))

nonNegTotal : List Int -> Int
nonNegTotal [] = 0
nonNegTotal (h :: rest) =
  let
    v = if h < 0 then 0 - h else h
  in v + nonNegTotal rest

-- 共享构建目录的 key：staging 里的产物名集合（Main.ml 每 case 不同，不参与）。
-- 目录在 `--cache-dir`（默认 `.local/test-cache`）下按「worker 作用域 + 编译器指纹 +
-- base 哈希」分桶 ⇒ 跨 run 复用 base 的 .cmx：本地重跑不再冷编译整棵 base。
-- 注意：两个 suite 同时用同一 worker 号会写同一桶（内容哈希 stamp 会退化为重编，
-- 极端情况下互相踩写）；并发跑时给其中一个传 `--cache-dir` 隔离。
buildCacheDir : Env -> String -> String
buildCacheDir env staging = "${env.envBuildDir}/set-${buildSetKey (runIO (readDir staging))}"

-- 把 staging 整份同步进共享目录（base 的 .ml 内容不变 ⇒ stamp 命中；Main.ml 换成
-- 本 case 的）。
syncBuildDir : String -> String -> Int
syncBuildDir staging dir =
  let
    _ = ensureDirPath dir
  in runIO (prim_runIn "/" ["cp", "-a", "${staging}/.", "${dir}/"])

-- 会话优先的 check / interp 探针：命中时零子进程（~200ms → ~10ms），语义等价
-- （check = 退出码，interp = trim 后输出文本）。会话不可用/安全阀不适用时回退 CLI，
-- 保证诊断文本与 `.check.err` 片段匹配仍走原来的路径。
probeInterp : Env -> Case -> String -> CmdResult
probeInterp env c source = case sessionInterp env.envSession env.envBase source of
  Just (Pair code out) => CmdResult code out "" False
  Nothing =>
    runCmdMerged env "${c.caseId}-interp" env.envCwd c.caseTimeout
      (withEnvIface env [env.envVuna, "interp", source])

probeCheck : Env -> Case -> String -> CmdResult
probeCheck env c source = case sessionCheck env.envSession env.envBase source of
  Just (Pair code out) => CmdResult code out "" False
  Nothing =>
    runCmdMerged env "${c.caseId}-check" env.envCwd c.caseTimeout
      (withEnvIface env [env.envVuna, "check", source])

goldenCase : Env -> Case -> String -> String -> Bool -> Bool -> Bool -> Bool -> Bool -> CaseResult
goldenCase env c source expected wantInterp wantCheck wantCompile wantRun wantCompare =
  let
    start = runIO nowMicros
    expectedText = trimNewlines (runIO (readFile expected))
    interpOn = wantInterp
    interpR = if interpOn then probeInterp env c source else CmdResult 1 "" "" False
    interpText = if interpOn then trimNewlines (combinedOut interpR) else ""
    interpA = if interpOn then [assertEq "interp" expectedText interpText] else []
    checkA = if wantCheck then [assertExit "check exit" (probeCheck env c source).cmdCode] else []
    staging = "${env.envTmp}/stage-${safeName c.caseId}"
    compileR =
      if wantCompile then runCmdMerged env "${c.caseId}-compile" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "compile", source, staging])
      else CmdResult 1 "" "" False
    compileA =
      if wantCompile then [ assertExit "compile exit" compileR.cmdCode,
        assertSilent "compile silent" (combinedOut compileR)
      ]
      else []
    outdir = if wantCompile && compileR.cmdCode == 0 then buildCacheDir env staging else staging
    syncA =
      if wantCompile && compileR.cmdCode == 0 then [assertExit "cache sync" (syncBuildDir staging outdir)]
      else []
    buildR =
      if wantCompile && compileR.cmdCode == 0 then runCmdMerged env "${c.caseId}-build" outdir c.caseTimeout ["sh", "build.sh", "prog"]
      else CmdResult 1 "" "" False
    buildA =
      if wantCompile && compileR.cmdCode == 0 then [assertExit "build exit" buildR.cmdCode] else []
    runOk = wantRun && wantCompile && compileR.cmdCode == 0 && buildR.cmdCode == 0
    runR =
      if runOk then runCmdMerged env "${c.caseId}-run" env.envCwd c.caseTimeout ["${outdir}/prog"]
      else CmdResult 1 "" "" False
    runA = if runOk then [assertEq "run" expectedText (trimNewlines (combinedOut runR))] else []
    compareA =
      if wantCompare && interpOn && runOk then [assertEq "interp == run" interpText (trimNewlines (combinedOut runR))]
      else []
  in let
    base =
      finishCase c.caseId start
        (append interpA (append checkA (append compileA (append syncA (append buildA (append runA compareA))))))
    actualForBless = if runOk then trimNewlines (combinedOut runR) else interpText
  in if env.envBless && base.resFail > 0 then
    let
      _ = runIO (writeFile expected "${actualForBless}\n")
    in CaseResult c.caseId "blessed" base.resChecks 0 base.resChecks base.resMs ["blessed ${expected}"]
  else base

-- 结构化诊断期望文件：与 `.check.err` 同目录的 `.diag.json`（`--json` 聚合文档）。
diagExpectedOf : String -> String
diagExpectedOf expected =
  if endsWith "expected.check.err" expected then "${Vuna.Cli.Args.parentOf expected}/expected.diag.json"
  else if endsWith "expected.err" expected then "${Vuna.Cli.Args.parentOf expected}/expected.diag.json"
  else if endsWith ".check.err" expected then "${substring 0 (byteLength expected - 10) expected}.diag.json"
  else if endsWith ".err" expected then "${substring 0 (byteLength expected - 4) expected}.diag.json"
  else "${expected}.diag.json"

errorCase : Env -> Case -> String -> String -> Bool -> Bool -> Bool -> CaseResult
errorCase env c source expected wantInterp wantCheck wantCompile =
  let
    start = runIO nowMicros
    fragment = trimNewlines (runIO (readFile expected))
    baseName =
      if endsWith ".vuna" source then substring 0 (byteLength source - 5) source else source
    compileErrPath = "${baseName}.compile.err"
    legacyCerrPath = "${baseName}.cerr"
    denyPath = if startsWith "/" baseName then "${baseName}.deny" else "${env.envCwd}/${baseName}.deny"
    denyArgs = if pathExistsFile denyPath then ["--deny-warnings"] else []
    compileFragment =
      if pathExistsFile compileErrPath then trimNewlines (runIO (readFile compileErrPath))
      else if pathExistsFile legacyCerrPath then trimNewlines (runIO (readFile legacyCerrPath))
      else fragment
    interpA = if wantInterp then
      let
        r =
          runCmdMerged env "${c.caseId}-interp" env.envCwd c.caseTimeout
            (withEnvIface env (append [env.envVuna, "interp", source] denyArgs))
      in [ assertContains "interp fragment" (combinedOut r) fragment,
        assertExitNonZero "interp exit" r.cmdCode
      ]
    else []
    checkA = if wantCheck then
      let
        r =
          runCmdMerged env "${c.caseId}-check" env.envCwd c.caseTimeout
            (withEnvIface env (append [env.envVuna, "check", source] denyArgs))
      in [ assertContains "check fragment" (combinedOut r) fragment,
        assertExitNonZero "check exit" r.cmdCode
      ]
    else []
    outdir = uniqueOutDir env c.caseId
    _ = removeTree outdir
    compileA = if wantCompile then
      let
        r =
          runCmdMerged env "${c.caseId}-compile" env.envCwd c.caseTimeout
            (withEnvIface env (append [env.envVuna, "compile", source, outdir] denyArgs))
      in [ assertContains "compile fragment" (combinedOut r) compileFragment,
        assertExitNonZero "compile exit" r.cmdCode,
        assertAbsent "compile no output dir" outdir
      ]
    else []
    diagPath = diagExpectedOf expected
    diagSource = relativeTo env.envCwd source
    diagRun = if wantCheck then
      runCmdMerged env "${c.caseId}-diag" env.envCwd c.caseTimeout
        (withEnvIface env (append [env.envVuna, "check", diagSource, "--json"] denyArgs))
      else if wantCompile then
        runCmdMerged env "${c.caseId}-diag" env.envCwd c.caseTimeout
          (withEnvIface env (append [env.envVuna, "compile", diagSource, uniqueOutDir env "${c.caseId}-diag", "--json"] denyArgs))
      else
        runCmdMerged env "${c.caseId}-diag" env.envCwd c.caseTimeout
          (withEnvIface env (append [env.envVuna, "check", diagSource, "--json"] denyArgs))
    actualDiag = trimNewlines (combinedOut diagRun)
    diagA = if env.envBlessDiag then
        let
          _ = runIO (writeFile diagPath "${actualDiag}\n")
        in []
      else if pathExistsFile diagPath then
        [assertEq "diag json" (trimNewlines (runIO (readFile diagPath))) actualDiag]
      else []
  in finishCase c.caseId start (append interpA (append checkA (append compileA diagA)))

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
parseLeadingInt : String -> Maybe Int
parseLeadingInt s = parseDigits (strUnpack s) 0 0

parseDigits : List Int -> Int -> Int -> Maybe Int
parseDigits [] acc count = if count == 0 then Nothing else Just acc
parseDigits (c :: rest) acc count =
  if c >= 48 && c <= 57 then parseDigits rest (acc * 10 + (c - 48)) (count + 1)
  else if count == 0 then Nothing else Just acc

-- ---------------------------------------------------------------
-- 单 case 分派
-- ---------------------------------------------------------------
-- ---------------------------------------------------------------
-- 结果缓存（本地增量；CI 用 --no-cache）
-- ---------------------------------------------------------------
-- 只缓存 golden/error case 的成功结果。key 含编译器指纹、base 源码树哈希、source/
-- expected 内容（目录型再加整个夹具目录的 .vuna 树）。section/脚本一律不缓存。
hashFileText : String -> String
hashFileText path = if pathExistsFile path then runIO (readFile path) else ""

hashFiles : Int -> List String -> Int
hashFiles acc [] = acc
hashFiles acc (path :: rest) = hashFiles (acc * 1000003 + hashTextStrong (hashFileText path)) rest

hashTree : String -> Int
hashTree dir = hashFiles 0 (collectVunaFiles dir)

caseTreeHash : Case -> String -> String -> Int
caseTreeHash c source expected = if contains "/app/" source then
  let
    root = Vuna.Cli.Args.parentOf (Vuna.Cli.Args.parentOf source)
  in hashTree root * 1000003 + hashTextStrong (hashFileText expected)
else
  let
    stamp = runIO (fileMtime source)
    size = runIO (fileSize source)
  in hashTextStrong
    "${hashFileText source}|${hashFileText expected}|${strOfInt stamp}|${strOfInt size}"

cacheKey : Env -> Case -> Int
cacheKey env c = if not env.envCacheEnabled then 0
else case c.caseKind of
  CGolden source expected _ _ _ _ _ =>
    hashTextStrong
      "${strOfInt toolCompilerFingerprint}|${strOfInt env.envBaseHash}|${c.caseId}|${strOfInt (caseTreeHash c source expected)}"
  CError source expected _ _ _ =>
    hashTextStrong
      "${strOfInt toolCompilerFingerprint}|${strOfInt env.envBaseHash}|${c.caseId}|${strOfInt (caseTreeHash c source expected)}"
  _ => 0

cachePath : Env -> Int -> String
cachePath env key = "${env.envCacheDir}/${strOfInt key}.cache"

-- ---------------------------------------------------------------
-- --last-failed
-- ---------------------------------------------------------------
lastFailedDir : Env -> String
lastFailedDir env = "${env.envRoot}/.local/test-suite"

lastFailedPath : Env -> String
lastFailedPath env = "${lastFailedDir env}/last-failed"

lastFailedIds : Env -> List String
lastFailedIds env =
  let
    path = lastFailedPath env
  in if not (pathExistsFile path) then []
  else filter (\line => line /= "") (lines (runIO (readFile path)))

filterLastFailed : Env -> List Case -> List Case
filterLastFailed env cases =
  let
    ids = lastFailedIds env
  in filter (caseIdIn ids) cases

recordLastFailed : Env -> List CaseResult -> Int
recordLastFailed env [] = 0
recordLastFailed env results =
  let
    _ = ensureDirPath (lastFailedDir env)
    failed = filter isFailed results
    text = join "\n" (map resIdOf failed)
  in runIO (writeFile (lastFailedPath env) text)

caseIdIn : List String -> Case -> Bool
caseIdIn ids c = memName c.caseId ids

resIdOf : CaseResult -> String
resIdOf r = r.resId

readCached : Env -> Case -> Maybe CaseResult
readCached env c =
  let
    key = cacheKey env c
  in if key == 0 then Nothing
  else
    let
      path = cachePath env key
    in if not (pathExistsFile path) then Nothing
    else
      let
        checks = fromMaybe 0 (parseLeadingInt (trim (runIO (readFile path))))
      in Just (CaseResult c.caseId "cached" checks 0 checks 0 [])

writeCached : Env -> Case -> CaseResult -> Int
writeCached env c r =
  let
    key = cacheKey env c
  in if key == 0 || r.resStatus /= "pass" then 0
  else runIO (writeFile (cachePath env key) "${strOfInt r.resChecks}\n")

runCase : Env -> Case -> CaseResult
runCase env c =
  let
    cached = readCached env c
  in case cached of
    Just r => r
    Nothing =>
      let
        r = runCaseGo env c
      in let
        _ = writeCached env c r
      in r

checkCase : Env -> Case -> String -> Bool -> String -> CaseResult
checkCase env c source expectPass expectedErr =
  let
    start = runIO nowMicros
    r =
      runCmdMerged env "${c.caseId}-check" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "check", source])
  in if expectPass then finishCase c.caseId start [assertExit "check exit" r.cmdCode]
  else
    let
      fragment = hashFileText expectedErr
      checks =
        if fragment == "" then [assertExitNonZero "check exit" r.cmdCode]
        else [ assertContains "check fragment" (combinedOut r) (trimNewlines fragment),
          assertExitNonZero "check exit" r.cmdCode
        ]
    in finishCase c.caseId start checks

lintCase : Env -> Case -> String -> String -> CaseResult

relativeTestPath : Env -> String -> String
relativeTestPath env source =
  let
    prefix = "${env.envRoot}/test/"
  in if startsWith prefix source then substring (byteLength prefix) (byteLength source - byteLength prefix) source
  else source

lintCase env c source expected =
  let
    start = runIO nowMicros
    lintPath = relativeTestPath env source
    expectedText = trimNewlines (runIO (readFile expected))
    r =
      runCmdMerged env "${c.caseId}-lint" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "lint", lintPath])
    expectedExit = if expectedText == "" then 0 else 1
    exitA =
      Assertion "lint exit" (r.cmdCode == expectedExit)
        "expected exit ${strOfInt expectedExit}, got ${strOfInt r.cmdCode}"
  in finishCase c.caseId start
    [assertEq "lint output" expectedText (trimNewlines (combinedOut r)), exitA]

fixCase : Env -> Case -> String -> String -> CaseResult
fixCase env c source expected =
  let
    start = runIO nowMicros
    expectedText = trimNewlines (runIO (readFile expected))
    work = "${env.envTmp}/fix-${safeName c.caseId}.vuna"
    _ = runIO (writeFile work (runIO (readFile source)))
    r1 =
      runCmdMerged env "${c.caseId}-fix1" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "lint", "--fix", work])
    once = trimNewlines (runIO (readFile work))
    r2 =
      runCmdMerged env "${c.caseId}-fix2" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "lint", "--fix", work])
    twice = trimNewlines (runIO (readFile work))
    fixA = assertEq "fix" expectedText once
    idemA = assertEq "fix idempotent" once twice
  in finishCase c.caseId start [fixA, idemA]

-- 产物运行期 case。expectedExit 语义：0 = 断言非 0（无显式退出码的遗留行为）；
-- 256 = 断言恰好 0（`.run.exit` 内容为 0，哨兵超出真实退出码 0–255 范围）；
-- n > 0（< 256）= 断言恰好 n。expectedErr 缺失（只有 `.run.exit`）时跳过片段断言。
runtimeCase : Env -> Case -> String -> String -> Int -> CaseResult
runtimeCase env c source expectedErr expectedExit =
  let
    start = runIO nowMicros
    fragmentText = readMaybeFile expectedErr
    fragment = trimNewlines fragmentText
    staging = "${env.envTmp}/stage-${safeName c.caseId}"
    comp =
      runCmdMerged env "${c.caseId}-compile" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "compile", source, staging])
    outdir = if comp.cmdCode == 0 then buildCacheDir env staging else staging
    _ = if comp.cmdCode == 0 then syncBuildDir staging outdir else 0
    buildA = if comp.cmdCode == 0 then
      let
        b = runCmdMerged env "${c.caseId}-build" outdir c.caseTimeout ["sh", "build.sh", "prog"]
      in if b.cmdCode == 0 then
        let
          r = runCmdMerged env "${c.caseId}-run" env.envCwd c.caseTimeout ["${outdir}/prog"]
          fragmentA =
            if fragmentText == "" then []
            else [assertContains "runtime fragment" (combinedOut r) fragment]
          exitA =
            if expectedExit == 0 then assertExitNonZero "runtime exit" r.cmdCode
            else if expectedExit == 256 then assertExit "runtime exit 0" r.cmdCode
            else Assertion "runtime exit" (r.cmdCode == expectedExit)
              "expected exit ${strOfInt expectedExit}, got ${strOfInt r.cmdCode}"
        in append fragmentA [exitA]
      else [assertExit "build exit" b.cmdCode]
    else [assertExit "compile exit" comp.cmdCode]
  in finishCase c.caseId start buildA

-- ---------------------------------------------------------------
-- 声明式步进用例（`*.steps`）
-- ---------------------------------------------------------------
-- 行式指令，一个文件 = 一个 case。步骤由 `run:` / `read:` 开启，其余指令挂当前步：
--   exit: 0 | nonzero | <n>          缺省 0（run/read 默认必须成功）
--   out-contains: / out-not-contains: / out-equals: <literal> / out-equals-file: <path>
--   file-exists: / file-absent: / file-contains: <path> <fragment>
-- `for-each: <shell word list>` … `end:` 把块内步骤按匹配项各跑一次；`{item}` = 匹配项
-- （去尾 `/`）、`{name}` = basename、`{stem}` = 去掉结尾 `.vuna` 的匹配项。空匹配 = 失败。
-- 路径：`$TMPDIR` 展开为 case 临时根；相对路径按 cwd = test/ 解析。
record Step where
  stRun : String
  stRead : String
  stExit : String
  stContains : List String
  stNotContains : List String
  stEquals : List String
  stEqualsFile : List String
  stFiles : List String
  stAbsent : List String
  stFileContains : List (Pair String String)

emptyStep : Step
emptyStep = Step "" "" "" [] [] [] [] [] [] []

stepWithRun : String -> Step
stepWithRun body = Step body "" "" [] [] [] [] [] [] []

stepWithRead : String -> Step
stepWithRead path = Step "" path "" [] [] [] [] [] [] []

record StepGroup where
  sgGlob : String
  sgSteps : List Step

record StepParse where
  spDone : List StepGroup
  spOpen : Bool
  spGlob : String
  spSteps : List Step
  spErr : String

data StepEdit : Type where
  SeOk : Step -> StepEdit
  SeErr : String -> StepEdit

data StepsParse : Type where
  SpOk : List StepGroup -> StepsParse
  SpErr : String -> StepsParse

isBlankOrComment : String -> Bool
isBlankOrComment line =
  let
    t = trim line
  in byteLength t == 0 || startsWith "#" t

firstSpaceIndex : List Int -> Int -> Int
firstSpaceIndex [] i = 0 - 1
firstSpaceIndex (c :: rest) i = if c == 32 then i else firstSpaceIndex rest (i + 1)

splitFirstSpace : String -> Pair String String
splitFirstSpace text =
  let
    i = firstSpaceIndex (strUnpack text) 0
    n = natToInt (byteLength text)
  in if i < 0 then Pair text ""
  else Pair (substring 0 (natFromInt i) text)
    (trim (substring (natFromInt (i + 1)) (natFromInt (n - i - 1)) text))

stepWithExit : Step -> String -> Step
stepWithExit st x =
  Step st.stRun st.stRead x st.stContains st.stNotContains st.stEquals st.stEqualsFile st.stFiles
    st.stAbsent st.stFileContains

stepWithContains : Step -> String -> Step
stepWithContains st x =
  Step st.stRun st.stRead st.stExit (append st.stContains [x]) st.stNotContains st.stEquals
    st.stEqualsFile st.stFiles st.stAbsent st.stFileContains

stepWithNotContains : Step -> String -> Step
stepWithNotContains st x =
  Step st.stRun st.stRead st.stExit st.stContains (append st.stNotContains [x]) st.stEquals
    st.stEqualsFile st.stFiles st.stAbsent st.stFileContains

stepWithEqualsFile : Step -> String -> Step
stepWithEqualsFile st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals
    (append st.stEqualsFile [x]) st.stFiles st.stAbsent st.stFileContains

stepWithEquals : Step -> String -> Step
stepWithEquals st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains (append st.stEquals [x])
    st.stEqualsFile st.stFiles st.stAbsent st.stFileContains

stepWithFile : Step -> String -> Step
stepWithFile st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals st.stEqualsFile
    (append st.stFiles [x]) st.stAbsent st.stFileContains

stepWithAbsent : Step -> String -> Step
stepWithAbsent st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals st.stEqualsFile
    st.stFiles (append st.stAbsent [x]) st.stFileContains

stepWithFileContains : Step -> Pair String String -> Step
stepWithFileContains st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals st.stEqualsFile
    st.stFiles st.stAbsent (append st.stFileContains [x])

applyDirective : Step -> String -> StepEdit
applyDirective st t =
  let
    n = byteLength t
  in if startsWith "exit:" t then SeOk (stepWithExit st (trim (substring 5 (n - 5) t)))
  else if startsWith "out-contains:" t then SeOk (stepWithContains st (trim (substring 13 (n - 13) t)))
  else if startsWith "out-not-contains:" t then SeOk (stepWithNotContains st (trim (substring 17 (n - 17) t)))
  else if startsWith "out-equals-file:" t then SeOk (stepWithEqualsFile st (trim (substring 16 (n - 16) t)))
  else if startsWith "out-equals:" t then SeOk (stepWithEquals st (trim (substring 11 (n - 11) t)))
  else if startsWith "file-exists:" t then SeOk (stepWithFile st (trim (substring 12 (n - 12) t)))
  else if startsWith "file-absent:" t then SeOk (stepWithAbsent st (trim (substring 12 (n - 12) t)))
  else if startsWith "file-contains:" t then SeOk (stepWithFileContains st (splitFirstSpace (trim (substring 14 (n - 14) t))))
  else SeErr "unknown step directive: ${t}"

setParseErr : StepParse -> String -> StepParse
setParseErr st msg = StepParse st.spDone st.spOpen st.spGlob st.spSteps msg

setParseSteps : StepParse -> List Step -> StepParse
setParseSteps st steps = StepParse st.spDone st.spOpen st.spGlob steps st.spErr

openGroup : StepParse -> String -> StepParse
openGroup st spec = StepParse st.spDone True spec st.spSteps st.spErr

closeGroup : StepParse -> StepParse
closeGroup st = StepParse st.spDone False "" st.spSteps st.spErr

pushStep : StepParse -> Step -> StepParse
pushStep st step = setParseSteps st (step :: st.spSteps)

flushGroup : StepParse -> StepParse
flushGroup st =
  if listLength st.spSteps == 0 then st
  else StepParse (StepGroup st.spGlob (reverse st.spSteps) :: st.spDone) st.spOpen st.spGlob [] st.spErr

-- 逐行解析（不用 foldl / 记录更新：把 `StepParse` 当多态 fold 的累加器、或在递归函数里
-- 用记录更新，都会触发 QTT 擦除 binder 推断 bug；显式构造器 + 错误字段更直接）。
parseLine : StepParse -> String -> StepParse
parseLine st line =
  let
    t = trim line
    n = byteLength t
  in if st.spErr /= "" then st
  else if isBlankOrComment line then st
  else if startsWith "for-each:" t then if st.spOpen then setParseErr st "nested for-each is not supported"
  else
    let
      spec = trim (substring 9 (n - 9) t)
      flushed = flushGroup st
    in if byteLength spec == 0 then setParseErr st "for-each needs a shell word list"
    else openGroup flushed spec
  else if t == "end:" then if not st.spOpen then setParseErr st "end: without matching for-each"
  else closeGroup (flushGroup st)
  else if startsWith "run:" t then pushStep st (stepWithRun (trim (substring 4 (n - 4) t)))
  else if startsWith "read:" t then pushStep st (stepWithRead (trim (substring 5 (n - 5) t)))
  else case st.spSteps of
    [] => setParseErr st "directive before any run:/read: step: ${t}"
    step :: rest => case applyDirective step t of
      SeErr e => setParseErr st e
      SeOk step2 => setParseSteps st (step2 :: rest)

parseLines : List String -> StepParse -> StepParse
parseLines [] st = st
parseLines (line :: rest) st = parseLines rest (parseLine st line)

parseStepsV2 : String -> StepsParse
parseStepsV2 text =
  let
    st = parseLines (splitOnChar 10 text) (StepParse [] False "" [] "")
  in if st.spErr /= "" then SpErr st.spErr
  else if st.spOpen then SpErr "unclosed for-each: ${st.spGlob}"
  else
    let
      flushed = flushGroup st
    in SpOk (reverse flushed.spDone)

countGroupSteps : StepGroup -> Int
countGroupSteps g = listLength g.sgSteps

countStepGroups : List StepGroup -> Int
countStepGroups [] = 0
countStepGroups (g :: rest) = countGroupSteps g + countStepGroups rest

replaceAll : String -> String -> String -> String
replaceAll needle repl text = if byteLength needle == 0 then text else join repl (split needle text)

dropTrailingSlashes : List Int -> List Int
dropTrailingSlashes [] = []
dropTrailingSlashes (c :: rest) = if c == 47 then dropTrailingSlashes rest else c :: rest

stripTrailingSlash : String -> String
stripTrailingSlash text =
  if byteLength text > 1 then strPack (reverse (dropTrailingSlashes (reverse (strUnpack text))))
  else text

lastSegment : List String -> String
lastSegment [] = ""
lastSegment ([x]) = x
lastSegment (x :: rest) = lastSegment rest

baseNameOf : String -> String
baseNameOf path = lastSegment (filter (\part => part /= "") (split "/" path))

stemOf : String -> String
stemOf path = if endsWith ".vuna" path then substring 0 (byteLength path - 5) path else path

substText : String -> String -> String -> String
substText item name text =
  replaceAll "{item}" item (replaceAll "{name}" name (replaceAll "{stem}" (stemOf item) text))

substFileContains : String -> String -> Pair String String -> Pair String String
substFileContains item name (Pair path frag) =
  Pair (substText item name path) (substText item name frag)

substStep : String -> String -> Step -> Step
substStep item name st =
  let
    s = substText item name
  in Step (s st.stRun) (s st.stRead) (s st.stExit) (map s st.stContains) (map s st.stNotContains)
    (map s st.stEquals) (map s st.stEqualsFile) (map s st.stFiles) (map s st.stAbsent)
    (map (substFileContains item name) st.stFileContains)

stepPath : Env -> String -> String -> String
stepPath env caseTmp path =
  let
    expanded = replaceAll "$TMPDIR" caseTmp path
  in if startsWith "/" expanded then expanded else "${env.envCwd}/${expanded}"

exitAsserts : String -> Int -> List Assertion
exitAsserts spec code =
  if spec == "" || spec == "0" then [assertExit "exit" code]
  else if spec == "nonzero" then [assertExitNonZero "exit" code]
  else [ Assertion "exit" (code == fromMaybe 0 (parseLeadingInt spec)) "expected ${spec}, got ${strOfInt code}"
  ]

fileContainsAssert : Env -> String -> Pair String String -> Assertion
fileContainsAssert env caseTmp (Pair path frag) =
  let
    text = readMaybeFile (stepPath env caseTmp path)
  in Assertion "file" (contains frag text) "file ${path} missing fragment: ${frag}\nactual:\n${text}"

outAsserts : Env -> String -> String -> Step -> List Assertion
outAsserts env caseTmp out st =
  append (map (\frag => assertContains "out" out frag) st.stContains)
    (append (map (\frag => Assertion "out" (not (contains frag out)) "unexpected fragment: ${frag}\nactual:\n${out}") st.stNotContains) (append (map (\want => assertEq "out" want (trimNewlines out)) st.stEquals) (append (map (\path => assertEq "out" (trimNewlines (readMaybeFile (stepPath env caseTmp path))) (trimNewlines out)) st.stEqualsFile) (append (map (\f => Assertion "file" (pathExistsFile (stepPath env caseTmp f)) "missing ${f}") st.stFiles) (append (map (\f => Assertion "file" (not (pathExistsFile (stepPath env caseTmp f))) "should not exist: ${f}") st.stAbsent) (map (fileContainsAssert env caseTmp) st.stFileContains))))))

stepAssertsV2 : Env -> String -> Int -> Step -> List Assertion
stepAssertsV2 env caseTmp timeout st = if byteLength st.stRun > 0 then
  let
    r = runCmdMerged env "step" env.envCwd timeout (withStepsEnv env caseTmp ["sh", "-c", st.stRun])
    timeoutA =
      if r.cmdTimedOut then [Assertion "timeout" False "step timed out after ${strOfInt timeout}s"]
      else []
  in append timeoutA
    (append (exitAsserts st.stExit r.cmdCode) (outAsserts env caseTmp (combinedOut r) st))
else if byteLength st.stRead > 0 then
  let
    resolved = stepPath env caseTmp st.stRead
    exists = pathExistsFile resolved
    missingA = if exists then [] else [Assertion "read" False "no such file: ${st.stRead}"]
    codeA =
      if byteLength st.stExit == 0 then [] else exitAsserts st.stExit (if exists then 0 else 1)
  in append missingA
    (append codeA (outAsserts env caseTmp (if exists then readMaybeFile resolved else "") st))
else []

prefixAssertions : String -> List Assertion -> List Assertion
prefixAssertions name [] = []
prefixAssertions name (a :: rest) =
  Assertion "${name}: ${a.assertionName}" a.assertionOk a.assertionDetail
    :: prefixAssertions name rest

expandLoopItems : Env -> String -> String -> CmdResult
expandLoopItems env caseTmp spec =
  let
    body =
      "for x in ${spec}; do if [ -e \"$x\" ]; then printf '%s\\n' \"$x\"; else exit 3; fi; done"
  in runCmdMerged env "for-each" env.envCwd 60 (withStepsEnv env caseTmp ["sh", "-c", body])

loopItemAsserts : Env -> String -> Int -> StepGroup -> String -> List Assertion
loopItemAsserts env caseTmp timeout g raw =
  let
    item = stripTrailingSlash raw
    name = baseNameOf item
    steps = map (substStep item name) g.sgSteps
  in prefixAssertions name (concatMap (stepAssertsV2 env caseTmp timeout) steps)

stepGroupAsserts : Env -> String -> Int -> StepGroup -> List Assertion
stepGroupAsserts env caseTmp timeout g = if byteLength g.sgGlob == 0 then concatMap (stepAssertsV2 env caseTmp timeout) g.sgSteps
else
  let
    r = expandLoopItems env caseTmp g.sgGlob
    items = filter (\raw => raw /= "") (lines r.cmdOut)
  in if r.cmdCode /= 0 then [ Assertion "for-each" False "failed to expand ${g.sgGlob} (exit ${strOfInt r.cmdCode}):\n${combinedOut r}"
  ]
  else if listLength items == 0 then [Assertion "for-each" False "matched nothing: ${g.sgGlob}"]
  else concatMap (loopItemAsserts env caseTmp timeout g) items

stepsCase : Env -> Case -> String -> CaseResult
stepsCase env c path =
  let
    start = runIO nowMicros
    caseTmp = "${env.envTmp}/c-${strOfInt (hashTextStrong c.caseId)}"
    _ = ensureDirPath caseTmp
    text = if pathExistsFile path then runIO (readFile path) else ""
  in case parseStepsV2 text of
    SpErr msg =>
      finishCase c.caseId start [Assertion "steps" False "parse error in ${path}: ${msg}"]
    SpOk groups =>
      let
        assertions = concatMap (stepGroupAsserts env caseTmp c.caseTimeout) groups
        hasWork = countStepGroups groups > 0
      in finishCase c.caseId start
        (Assertion "steps" hasWork "no run:/read: directive in ${path}" :: assertions)

seedCase : Env -> Case -> String -> String -> CaseResult
seedCase env c source expected =
  let
    start = runIO nowMicros
    expectedText = trimNewlines (runIO (readFile expected))
    outdir = uniqueOutDir env c.caseId
    _ = removeTree outdir
    ifaceDir = "${outdir}-iface"
    _ = removeTree ifaceDir
    _ = ensureDirPath ifaceDir
    comp =
      runCmdMerged env "${c.caseId}-compile" env.envCwd c.caseTimeout
        (withEnvIfaceAt env ifaceDir [env.envSeed, "compile", source, outdir])
    buildA = if comp.cmdCode == 0 then
      let
        b = runCmdMerged env "${c.caseId}-build" outdir c.caseTimeout ["sh", "build.sh", "prog"]
      in if b.cmdCode == 0 then
        let
          r = runCmdMerged env "${c.caseId}-run" env.envCwd c.caseTimeout ["${outdir}/prog"]
        in [assertEq "seed run" expectedText (trimNewlines (combinedOut r))]
      else [assertExit "seed build exit" b.cmdCode]
    else [assertExit "seed compile exit" comp.cmdCode]
  in finishCase c.caseId start buildA

runCaseGo : Env -> Case -> CaseResult
runCaseGo env c = case c.caseKind of
  CGolden source expected wantInterp wantCheck wantCompile wantRun wantCompare =>
    goldenCase env c source expected wantInterp wantCheck wantCompile wantRun wantCompare
  CError source expected wantInterp wantCheck wantCompile =>
    errorCase env c source expected wantInterp wantCheck wantCompile
  CCheck source expectPass expectedErr => checkCase env c source expectPass expectedErr
  CLint source expected => lintCase env c source expected
  CFix source expected => fixCase env c source expected
  CRuntime source expected exitCode => runtimeCase env c source expected exitCode
  CSeed source expected => seedCase env c source expected
  CSteps path => stepsCase env c path
  CBroken msg =>
    let
      start = runIO nowMicros
    in finishCase c.caseId start [Assertion "case" False msg]

-- ---------------------------------------------------------------
-- 过滤
-- ---------------------------------------------------------------
allDigits : String -> Bool
allDigits s = s /= "" && allDigitChars (strUnpack s)

allDigitChars : List Int -> Bool
allDigitChars [] = True
allDigitChars (c :: rest) = c >= 48 && c <= 57 && allDigitChars rest

matchPattern : String -> Case -> Bool
matchPattern pat c =
  if allDigits pat then c.caseSection == pat || startsWith "${pat}/" c.caseId
  else contains pat "${c.caseSection} ${c.caseId} ${join " " c.caseTags}"

matchAny : List String -> Case -> Bool
matchAny [] c = False
matchAny (pat :: rest) c = if matchPattern pat c then True else matchAny rest c

caseMatches : SuiteOpts -> Case -> Bool
caseMatches opts c =
  let
    onlyOk = case opts.suiteOnly of
      [] => True
      pats => matchAny pats c
    filterOk = case opts.suiteFilter of
      [] => True
      pats => matchAny pats c
  in onlyOk && filterOk

filterCases : SuiteOpts -> List Case -> List Case
filterCases opts cases = filter (caseMatches opts) cases

-- ---------------------------------------------------------------
-- 打印与汇总
-- ---------------------------------------------------------------
-- D25：`print` 返回 `Nat`（字节数）；工具链这里仍按 Int 使用（丢弃/比较都按 Int）。
printLine : String -> Int
printLine s = runIO (fmap natToInt (print "${s}\n"))

statusLine : Bool -> CaseResult -> String
statusLine verbose r =
  let
    tag = if r.resStatus == "fail" then "FAIL" else "ok  "
    timing =
      if r.resStatus == "cached" then " (cached)"
      else if verbose then " (${strOfInt r.resMs}ms)" else ""
  in "${tag} ${r.resId}${timing}"

printMessages : List String -> Int
printMessages [] = 0
printMessages (m :: rest) =
  let
    _ = printLine "  ${m}"
  in printMessages rest

printResult : Bool -> CaseResult -> Int
printResult verbose r =
  let
    _ = printLine (statusLine verbose r)
  in printMessages r.resMessages

resChecksOf : CaseResult -> Int
resChecksOf r = r.resChecks

resFailOf : CaseResult -> Int
resFailOf r = r.resFail

isFailed : CaseResult -> Bool
isFailed r = r.resStatus == "fail"

isSkipped : CaseResult -> Bool
isSkipped r = r.resStatus == "skip"

summarize : List CaseResult -> String
summarize results =
  let
    checks = sumInts (map resChecksOf results)
    failed = sumInts (map resFailOf results)
    badCases = listLength (filter isFailed results)
  in if failed == 0 && badCases == 0 then "vuna tests passed (${strOfInt checks} checks)"
  else "${strOfInt checks} checks, ${strOfInt badCases} failed case(s)"

printCompiler : Env -> Int
printCompiler env =
  printLine "compiler: ${env.envVuna} (fingerprint ${strOfInt toolCompilerFingerprint})"

-- ---------------------------------------------------------------
-- 顺序执行 + worker
-- ---------------------------------------------------------------
writeResultFile : String -> Int -> CaseResult -> Int
writeResultFile dir index r =
  let
    path = "${dir}/${strOfInt index}.tsv"
    line =
      "${r.resId}\t${r.resStatus}\t${strOfInt r.resPass}\t${strOfInt r.resFail}\t${strOfInt r.resChecks}\t${strOfInt r.resMs}\n"
  in runIO (writeFile path line)

runCasesIndexed : Env -> Bool -> Bool -> Bool -> String -> List (Pair Int Case) -> List CaseResult
runCasesIndexed env verbose failFast quiet resultsDir indexed =
  runCasesIndexedGo env verbose failFast quiet resultsDir indexed [] False

runCasesIndexedGo : Env -> Bool -> Bool -> Bool -> String -> List (Pair Int Case) -> List CaseResult -> Bool -> List CaseResult
runCasesIndexedGo env verbose failFast quiet resultsDir [] acc stopped = reverse acc
runCasesIndexedGo env verbose failFast quiet resultsDir ((Pair index c) :: rest) acc stopped = if stopped then
  let
    skip = CaseResult c.caseId "skip" 0 0 0 0 []
    _ = writeResultFile resultsDir index skip
  in runCasesIndexedGo env verbose failFast quiet resultsDir rest (skip :: acc) True
else
  let
    r = runCase env c
    _ = writeResultFile resultsDir index r
    _ = if quiet then 0 else printResult verbose r
    failed = r.resStatus == "fail"
  in runCasesIndexedGo env verbose failFast quiet resultsDir rest (r :: acc) (failFast && failed)

not : Bool -> Bool
not True = False
not False = True

runWorker : Env -> SuiteOpts -> List Case -> Int -> Int -> Int
runWorker env opts cases index count =
  let
    indexed = indexedCases cases index count
    resultsDir = case opts.suiteResultsDir of
      Just d => d
      Nothing => "${env.envTmp}/results"
    _ = ensureDirPath resultsDir
    results =
      runCasesIndexed env opts.suiteVerbose opts.suiteFailFast opts.suiteQuiet resultsDir indexed
    bad = listLength (filter isFailed results)
  in if bad == 0 then 0 else 1

-- ---------------------------------------------------------------
-- jobs
-- ---------------------------------------------------------------
detectJobs : Env -> Int
detectJobs env =
  let
    override = envVar "VUNA_TEST_JOBS"
  in if override /= "" then case parseLeadingInt override of
    Just n => if n > 0 then n else 1
    Nothing => 1
  else
    let
      r = runCmd env "jobs-probe" "." 10 ["nproc"]
      n = fromMaybe 0 (parseLeadingInt (trim r.cmdOut))
    in if n > 0 then n else 1

resolveJobs : Env -> SuiteOpts -> Int
resolveJobs env opts = if opts.suiteJobs == 0 then detectJobs env else opts.suiteJobs

-- ---------------------------------------------------------------
-- 父进程
-- ---------------------------------------------------------------
waitPids : List Int -> Int
waitPids [] = 0
waitPids (pid :: rest) =
  let
    code = runIO (prim_wait pid)
    last = waitPids rest
  in if code /= 0 then 1 else last

spawnWorkers : Env -> SuiteOpts -> String -> Int -> Int -> Int -> List Int -> List Int
spawnWorkers env opts resultsDir jobs fuel index pids = if fuel <= 0 then reverse pids
else if index >= jobs then reverse pids
else
  let
    workerArg = "${strOfInt index}/${strOfInt jobs}"
    filters =
      append (concatMap (\p => ["--only", p]) opts.suiteOnly)
        (concatMap (\p => ["--filter", p]) opts.suiteFilter)
    cacheArgs = case opts.suiteCacheDir of
      Just dir => ["--cache-dir", dir]
      Nothing => []
    changedArgs = case opts.suiteChanged of
      Just rev => ["--changed", rev]
      Nothing => []
    flagArgs =
      append (if opts.suiteFailFast then ["--fail-fast"] else [])
        (append (if opts.suiteJSON then ["--quiet"] else []) (append (if opts.suiteNoCache then ["--no-cache"] else []) (append (if opts.suiteLastFailed then ["--last-failed"] else []) (append (if opts.suiteBless then ["--bless"] else []) (append (if opts.suiteBlessDiag then ["--bless-diag"] else []) (append cacheArgs changedArgs))))))
    args =
      append ["test", "--suite", opts.suitePath, "--worker", workerArg, "--results-dir", resultsDir]
        (append filters flagArgs)
    pid = runIO (prim_spawn args)
  in spawnWorkers env opts resultsDir jobs (fuel - 1) (index + 1) (pid :: pids)

readResultFile : String -> Int -> Maybe CaseResult
readResultFile dir index =
  let
    path = "${dir}/${strOfInt index}.tsv"
  in if not (pathExistsFile path) then Nothing
  else
    let
      text = trimNewlines (runIO (readFile path))
      fields = split "\t" text
    in case fields of
      [id, status, pass, fail, checks, ms] =>
        Just
          (CaseResult id status (fromMaybe 0 (parseLeadingInt pass)) (fromMaybe 0 (parseLeadingInt fail)) (fromMaybe 0 (parseLeadingInt checks)) (fromMaybe 0 (parseLeadingInt ms)) [])
      _ => Nothing

collectResults : String -> Int -> List CaseResult
collectResults dir count = collectResultsGo (count + 1) dir count 0 []

collectResultsGo : Int -> String -> Int -> Int -> List CaseResult -> List CaseResult
collectResultsGo fuel dir count index acc = if fuel <= 0 then reverse acc
else if index >= count then reverse acc
else case readResultFile dir index of
  Just r => collectResultsGo (fuel - 1) dir count (index + 1) (r :: acc)
  Nothing =>
    collectResultsGo (fuel - 1) dir count (index + 1)
      (CaseResult "unknown-${strOfInt index}" "fail" 0 1 0 0 [] :: acc)

printJSON : List CaseResult -> Int
printJSON results =
  let
    cases = map resultJson results
    doc =
      JObj
        [Pair "suite" (JStr "vuna"), Pair "total" (JNum (listLength results)), Pair "failed" (JNum (listLength (filter isFailed results))), Pair "checks" (JNum (sumInts (map resChecksOf results))), Pair "cases" (JArr cases)]
  in printLine (renderJson doc)

resultJson : CaseResult -> Json
resultJson r =
  JObj
    [Pair "id" (JStr r.resId), Pair "status" (JStr r.resStatus), Pair "pass" (JNum r.resPass), Pair "fail" (JNum r.resFail), Pair "checks" (JNum r.resChecks), Pair "ms" (JNum r.resMs)]

finishResults : Env -> SuiteOpts -> List CaseResult -> Int
finishResults env opts results =
  let
    bad = listLength (filter isFailed results)
    skipped = listLength (filter isSkipped results)
    strictBad = if opts.suiteStrictSkips then skipped else 0
    _ = if strictBad > 0 then printLine "strict-skips: ${strOfInt skipped} skipped case(s)" else 0
    _ = recordLastFailed env results
    _ = if opts.suiteTimings then printTimings results else 0
    _ = if opts.suiteJSON then printJSON results else printLine (summarize results)
  in if bad + strictBad == 0 then 0 else 1

runParent : Env -> SuiteOpts -> Suite -> List Case -> Int
runParent env opts suite cases =
  let
    jobs = resolveJobs env opts
    n = listLength cases
    effective = if jobs > n then if n <= 0 then 1 else n else jobs
    indexed = indexAll cases 0 []
    resultsDir = case opts.suiteResultsDir of
      Just d => d
      Nothing => "${env.envTmp}/results"
    _ = ensureDirPath resultsDir
  in if effective <= 1 then finishResults env opts
    (runCasesIndexed env opts.suiteVerbose opts.suiteFailFast opts.suiteJSON resultsDir indexed)
  else
    let
      pids = spawnWorkers env opts resultsDir effective (effective + 1) 0 []
      _ = waitPids pids
      results = collectResults resultsDir n
    in finishResults env opts results

indexAll : List Case -> Int -> List (Pair Int Case) -> List (Pair Int Case)
indexAll [] i acc = reverse acc
indexAll (c :: rest) i acc = indexAll rest (i + 1) (Pair i c :: acc)

-- ---------------------------------------------------------------
-- list
-- ---------------------------------------------------------------
insertByMs : CaseResult -> List CaseResult -> List CaseResult
insertByMs r [] = [r]
insertByMs r (x :: rest) = if r.resMs > x.resMs then r :: x :: rest else x :: insertByMs r rest

sortByMs : List CaseResult -> List CaseResult
sortByMs [] = []
sortByMs (r :: rest) = insertByMs r (sortByMs rest)

printTimingsGo : Int -> List CaseResult -> Int
printTimingsGo n [] = 0
printTimingsGo n (r :: rest) = if n <= 0 then 0
else
  let
    _ = printLine "timing ${strOfInt r.resMs}ms ${r.resId}"
  in printTimingsGo (n - 1) rest

printTimings : List CaseResult -> Int
printTimings results = printTimingsGo 10 (sortByMs results)

printList : List Case -> Int
printList cases = printListGo cases

printListGo : List Case -> Int
printListGo [] = 0
printListGo (c :: rest) =
  let
    _ = printCase c
  in printListGo rest

printCase : Case -> Int
printCase c = printLine c.caseId

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
-- ---------------------------------------------------------------
-- --changed
-- ---------------------------------------------------------------
stripRoot : Env -> String -> String
stripRoot env path =
  let
    prefix = "${env.envRoot}/"
  in if startsWith prefix path then substring (byteLength prefix) (byteLength path - byteLength prefix) path
  else path

changedPaths : Env -> String -> Maybe (List String)
changedPaths env rev =
  let
    r = runCmd env "git-diff" env.envRoot 60 ["git", "diff", "--name-only", rev]
  in if r.cmdCode == 0 then Just (filter (\line => line /= "") (lines r.cmdOut)) else Nothing

isGlobalChange : String -> Bool
isGlobalChange path =
  startsWith "compiler/" path
    || startsWith "base/" path
    || startsWith "lib/" path
    || startsWith "app/" path
    || path == "vuna.toml"
    || startsWith "test/suite" path
    || path == "test/suite.toml"

takeFirstSegments : Int -> String -> String
takeFirstSegments n s = collectSegments n (split "/" s) ""

collectSegments : Int -> List String -> String -> String
collectSegments n [] acc = acc
collectSegments n (seg :: rest) acc =
  if n <= 0 then acc
  else if n == 1 then "${acc}${seg}/"
  else if acc == "" then collectSegments (n - 1) rest "${seg}/"
  else collectSegments (n - 1) rest "${acc}${seg}/"

corpusDirPrefix : String -> String
corpusDirPrefix rel = if startsWith "test/corpus/" rel then takeFirstSegments 3 rel else rel

pathTouches : String -> String -> Bool
pathTouches changed rel = changed == rel || startsWith changed rel || startsWith rel changed

casePaths : Env -> Case -> List String
casePaths env c = case c.caseKind of
  CGolden source expected _ _ _ _ _ => [stripRoot env source, stripRoot env expected]
  CError source expected _ _ _ => [stripRoot env source, stripRoot env expected]
  CCheck source _ expectedErr =>
    if expectedErr == "" then [stripRoot env source]
    else [stripRoot env source, stripRoot env expectedErr]
  CLint source expected => [stripRoot env source, stripRoot env expected]
  CFix source expected => [stripRoot env source, stripRoot env expected]
  CRuntime source expected _ => [stripRoot env source, stripRoot env expected]
  CSeed source expected => [stripRoot env source, stripRoot env expected]
  CSteps path => [stripRoot env path]
  CBroken _ => []

-- 章节/步骤文件的文本认领：夹具变更时，文件里提到该 corpus 目录就算“相关”。
claimTextTouches : Env -> String -> List String -> Bool
claimTextTouches env path changed =
  let
    text = runIO (readFile path)
    corpusChanges = filter (\p => startsWith "test/corpus/" p) changed
  in any (\p => contains (corpusDirPrefix p) text) corpusChanges
    || any (\p => contains (stripRoot env path) p) changed

caseAffected : Env -> List String -> Case -> Bool
caseAffected env changed c = if any isGlobalChange changed then True
else case c.caseKind of
  CSteps path => claimTextTouches env path changed
  _ =>
    let
      paths = casePaths env c
    in any (\rel => any (\p => pathTouches p rel) changed) paths

any : (a -> Bool) -> List a -> Bool
any pred [] = False
any pred (x :: rest) = if pred x then True else any pred rest

changedFilter : Env -> String -> List Case -> List Case
changedFilter env rev cases = case changedPaths env rev of
  Nothing => cases
  Just [] => []
  Just changed => filter (caseAffected env changed) cases

listSuite : Env -> List Case -> Int
listSuite env cases =
  let
    _ = printCompiler env
  in printList cases

-- ---------------------------------------------------------------
-- --audit / --watch
-- ---------------------------------------------------------------
stripTestPrefix : String -> String
stripTestPrefix rel = if startsWith "test/" rel then substring 5 (byteLength rel - 5) rel else rel

caseRoots : Env -> Case -> List String
caseRoots env c = map rootOfPath (casePaths env c)

rootOfPath : String -> String
rootOfPath path =
  if endsWith "/app/Main.vuna" path then "${Vuna.Cli.Args.parentOf (Vuna.Cli.Args.parentOf path)}/"
  else path

claimTextPairs : List Case -> List (Pair String String)
claimTextPairs [] = []
claimTextPairs (c :: rest) = case c.caseKind of
  CSteps path => Pair path (runIO (readFile path)) :: claimTextPairs rest
  _ => claimTextPairs rest

anyText : List (Pair String String) -> String -> Bool
anyText [] rel = False
anyText ((Pair _ text) :: rest) rel =
  if contains (stripTestPrefix rel) text || contains (stripTestPrefix (corpusDirPrefix rel)) text then True
  else anyText rest rel

auditClaimed : Env -> List Case -> List (Pair String String) -> String -> Bool
auditClaimed env cases texts rel =
  any (\c => any (\root => root == rel || startsWith root rel) (caseRoots env c)) cases
    || anyText texts rel

printOrphans : List String -> Int
printOrphans [] = 0
printOrphans (rel :: rest) =
  let
    _ = printLine "orphan ${rel}"
  in printOrphans rest

auditPathIgnored : String -> Bool
auditPathIgnored path = contains "/test/corpus/codegen/" path

-- 全量 corpus 里没有被任何 case / section 脚本认领的夹具。family 配置漏掉一整族
-- （或期望文件改错名）时 suite 会「少跑 case 却依然全绿」——这个结果是默认护栏的
-- 输入，不依赖 `--audit` 手动开关。
auditOrphans : Suite -> List String
auditOrphans suite =
  let
    root = suite.suiteRoot
    env =
      Env root "${root}/test" "/tmp" "" "" "${root}/base" "ocamlopt" "" "" False 0 False False False
        "/tmp/vuna-build" (runIO (newRef (sessionNew "/tmp/iface-session")))
    cases = discoverCases suite
    texts = claimTextPairs cases
    fixtures =
      filter (\path => not (auditPathIgnored path)) (collectVunaFiles "${root}/test/corpus")
  in filter (\path => not (auditClaimed env cases texts (stripRoot env path))) fixtures

takeFirst : Int -> List a -> List a
takeFirst n xs = if n <= 0 then []
else case xs of
  [] => []
  x :: rest => x :: takeFirst (n - 1) rest

-- family 声明的目录里应该被 case 认领的夹具（rel 路径）。文件型 = 顶层
-- `*.vuna`（跳过 `_` 辅助模块）；目录型 = 每个子目录的 entry。section 专属目录
-- （dt_pkg / dt_ad_hoc 等）不在 family 里，不参与精确审计。
isFixtureFile : String -> Bool
isFixtureFile name = endsWith ".vuna" name && not (startsWith "_" name)

fixtureTopOf : String -> String -> List String
fixtureTopOf familyDir name = ["${familyDir}/${name}"]

fixtureEntryOf : String -> String -> String -> String -> List String
fixtureEntryOf dir familyDir entry name =
  if pathExistsFile "${dir}/${name}/${entry}" then ["${familyDir}/${name}/${entry}"] else []

familyFixtures : String -> Family -> List String
familyFixtures root family =
  let
    dir = "${root}/${family.familyDir}"
  in if not (pathExistsDir dir) then []
  else
    let
      names = runIO (readDir dir)
    in case family.familyEntry of
      Just entry => concatMap (fixtureEntryOf dir family.familyDir entry) names
      Nothing => concatMap (fixtureTopOf family.familyDir) (filter isFixtureFile names)

noSectionTexts : List (Pair String String)
noSectionTexts = []

familyOrphan : Env -> List Case -> String -> Bool
familyOrphan env cases rel = not (auditClaimed env cases noSectionTexts rel)

-- 精确护栏：不用 section 脚本文本做模糊认领（旧 audit 只要脚本里提到目录名就
-- 算认领，整个 family 从 suite.toml 消失时也报 0 orphan）。
familyOrphans : Suite -> List String
familyOrphans suite =
  let
    root = suite.suiteRoot
    env =
      Env root "${root}/test" "/tmp" "" "" "${root}/base" "ocamlopt" "" "" False 0 False False False
        "/tmp/vuna-build" (runIO (newRef (sessionNew "/tmp/iface-session")))
    cases = discoverCases suite
    fixtures = concatMap (familyFixtures root) suite.suiteFamilies
  in filter (familyOrphan env cases) fixtures

commaJoin : List String -> String
commaJoin xs = join ", " xs

-- 孤儿存在 ⇒ 注入一个显式失败 case（worker 分片会把它派给某一个 worker 跑一次）。
auditCases : List String -> List Case
auditCases [] = []
auditCases paths =
  [ Case "audit/orphans" "audit" ["audit"] (CBroken "${strOfInt (listLength paths)} orphan fixture(s): ${commaJoin (takeFirst 12 paths)}") 0
  ]

auditSuite : SuiteOpts -> Suite -> Int
auditSuite opts suite =
  let
    unclaimed = auditOrphans suite
    _ = printOrphans unclaimed
    _ = printLine "audit: ${strOfInt (listLength unclaimed)} orphan fixture(s)"
  in case unclaimed of
    [] => 0
    _ => 1

maxMtime : Int -> List String -> Int
maxMtime acc [] = acc
maxMtime acc (path :: rest) =
  let
    m = runIO (fileMtime path)
  in maxMtime (if m > acc then m else acc) rest

watchSnapshot : String -> Int
watchSnapshot root =
  let
    paths =
      append (collectSourceFiles "${root}/test/corpus")
        (append (collectSourceFiles "${root}/test/suite") (append (collectSourceFiles "${root}/lib") (append (collectSourceFiles "${root}/compiler") (append (collectSourceFiles "${root}/app") (collectSourceFiles "${root}/base")))))
  in maxMtime 0
    (append paths (filter (\path => pathExistsFile path) ["${root}/test/suite.toml", "${root}/vuna.toml"]))

watchLoop : Int -> SuiteOpts -> Suite -> Int -> Int -> Int
watchLoop fuel opts suite last rc = if fuel <= 0 then rc
else
  let
    _ = runIO (sleepMicros 500000)
    now = watchSnapshot suite.suiteRoot
  in if now /= last then
    let
      _ = printLine "watch: change detected, rerunning"
      rc2 = runSuiteOnce opts suite
    in watchLoop (fuel - 1) opts suite now rc2
  else watchLoop (fuel - 1) opts suite last rc

watchSuite : SuiteOpts -> Suite -> Int
watchSuite opts suite =
  let
    rc = runSuiteOnce opts suite
  in watchLoop 100000000 opts suite (watchSnapshot suite.suiteRoot) rc

runSuite : SuiteOpts -> Suite -> Int
runSuite opts suite =
  if opts.suiteAudit then auditSuite opts suite
  else if opts.suiteWatch then watchSuite opts suite else runSuiteOnce opts suite

runSuiteOnce : SuiteOpts -> Suite -> Int
runSuiteOnce opts suite =
  let
    root = suite.suiteRoot
    tag = case opts.suiteWorker of
      Just (Pair i _) => "suite-w${strOfInt i}"
      Nothing => "suite"
    tmp = makeTempRoot tag
    helper = writeHelper tmp
    baseDir = envOr "VUNA_BASE" "${root}/base"
    cacheDir0 = "${root}/.local/test-cache"
    cacheDir = case opts.suiteCacheDir of
      Just dir => if startsWith "/" dir then dir else "${root}/${dir}"
      Nothing => cacheDir0
    baseHash = hashTree baseDir
    scope = case opts.suiteWorker of
      Just (Pair i _) => "w${strOfInt i}"
      Nothing => "single"
    -- 跨 run 的构建桶：base 的 .cmx 只编译一次，后续 run 直接命中 stamp。
    buildDir = "${cacheDir}/build/${scope}-${strOfInt toolCompilerFingerprint}-${strOfInt baseHash}"
    _ = if pathExistsDir cacheDir then 0 else ensureDirPath cacheDir
    env = Env root "${root}/test" tmp (runIO execPath) (envOr "VUNA_SEED" "vuna-seed") baseDir (envOr "OCAMLOPT" "ocamlopt") helper cacheDir (not opts.suiteNoCache && not opts.suiteBless && not opts.suiteBlessDiag) baseHash opts.suiteBless opts.suiteBlessDiag (case opts.suiteWorker of
      Just _ => True
      Nothing => False
    ) buildDir (runIO (newRef (sessionNew "${tmp}/iface-session")))
    -- 两层默认护栏（局部 --only/--filter 时被过滤掉，符合预期）：
    --   ① 已声明 family 目录里的孤儿夹具（精确 source 认领）；
    --   ② case 总数下限——整族从 suite.toml 消失时，①会连目录一起看不到。
    discovered = discoverCases suite
    minCase =
      if suite.suiteMinCases > 0 && listLength discovered < suite.suiteMinCases then [ Case "audit/min-cases" "audit" ["audit"] (CBroken "only ${strOfInt (listLength discovered)} case(s) discovered, suite.toml requires >= ${strOfInt suite.suiteMinCases}") 0
      ]
      else []
    cases0 =
      filterCases opts (append (append discovered (auditCases (familyOrphans suite))) minCase)
    -- 预热依赖接口（仅真正跑 case 时）：会话据此命中增量路径。
    _ = if opts.suiteListOnly then 0 else warmIfaces env
    cases1 = case opts.suiteChanged of
      Just rev => changedFilter env rev cases0
      Nothing => cases0
    cases = if opts.suiteLastFailed then filterLastFailed env cases1 else cases1
    result = if opts.suiteListOnly then listSuite env cases
    else case opts.suiteWorker of
      Just (Pair index count) => runWorker env opts cases index count
      Nothing => runParent env opts suite cases
    _ = runIO (prim_runIn "/" ["rm", "-rf", tmp])
  in result

-- 给每个 case 配全局下标：`zip cases [0..n-1]`，再按 worker index 过滤。
rangeUp : Int -> Int -> List Int
rangeUp fuel start = if fuel <= 0 then [] else start :: rangeUp (fuel - 1) (start + 1)

indexedCases : List Case -> Int -> Int -> List (Pair Int Case)
indexedCases cases index count =
  filter (matchesIndex index count) (zip (rangeUp (listLength cases) 0) cases)

-- 全局下标 i 属于 worker index：i mod count == index。
matchesIndex : Int -> Int -> Pair Int Case -> Bool
matchesIndex index count (Pair i _) = if count <= 0 then False else i - i / count * count == index

-- 把绝对源码路径转成相对 cwd 的路径（.diag.json 不写机器相关前缀）。
relativeTo : String -> String -> String
relativeTo base path =
  if startsWith "${base}/" path then
    substring (natFromInt (strLength base + 1)) (natFromInt (strLength path - strLength base - 1)) path
  else path
