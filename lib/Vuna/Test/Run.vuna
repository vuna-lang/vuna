module Vuna.Test.Run where

-- Vuna.Test.Run：suite 模式的原生执行器。
--
-- 数据流：
--   test/suite.toml -> Vuna.Test.Suite.discoverCases -> 本模块并行执行
--   -> 每 case 独立临时目录 + 子进程 capture/timeout -> 结果/汇总/JSON
--
-- 并行模型：父进程按 `--jobs` spawn N 个自身（隐藏 `--worker i/N`），worker 按
-- `index mod N` 静态分片；每个 case 写一份 TSV 到临时 results 目录，父进程按序
-- 读回。这样避开 `@vuna@prim_eff_wait` 只能等指定 pid 的队首阻塞，也避免父进程收集海量输出。
--
-- 子进程输出捕获不新增编译器原语：把一段固定的 shell helper 写进临时目录，由
-- helper 做 `timeout ... >out 2>err`，Vuna 侧只读文件 + 退出码。
import Base.HostRow
import Vuna.Compiler.Common
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Iface
import Vuna.Compiler.Store
import qualified Vuna.Cli.Args
import Vuna.Test.Session
import Vuna.Test.Suite
import Vuna.Files
import Vuna.Json
import Base.IORef

-- 执行环境。
record Env where
  envRoot : String
  envCwd : String
  envTmp : String
  envVuna : String
  envSeed : String
  envBase : String
  envOcamlopt : String
  envHelper : String
  envCacheDir : String
  envCacheEnabled : Bool
  envBaseHash : Int
  envBless : Bool
  envBlessDiag : Bool
  envWorker : Bool
  -- 本 run 的输入寻址对象库根（父进程解析一次，worker/case 共用；见 runSuiteOnce）。
  -- store-isolated 的 steps case 例外，仍用 case 私有 store。
  envStore : String
  -- 增量构建桶（跨 run 持久；见 buildCacheDir）。
  envBuildDir : String
  -- 进程内精化会话（per worker）：base 依赖接口 + 增量精化的 termAux 缓存。
  -- 命中时 golden 的 check/interp 不再 spawn CLI（~200ms → ~10ms），未命中回退子进程。
  envSession : IORef Session

-- 一次子进程调用：退出码 + 分离的 stdout/stderr + 是否被 timeout 杀掉。
record CmdResult where
  cmdCode : Int
  cmdOut : String
  cmdErr : String
  cmdTimedOut : Bool

-- 一条断言。
record Assertion where
  assertionName : String
  assertionOk : Bool
  assertionDetail : String

-- 一个 case 的结果。
record CaseResult where
  resId : String
  resStatus : String
  resPass : Int
  resFail : Int
  resChecks : Int
  resMs : Int
  resMessages : List String

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
envVar : String -> Eff hostRow String
envVar name = raiseToRow hostRow (@vuna@prim_eff_getenv name)

envOr : String -> String -> Eff hostRow String
envOr name fallback = do
  value <- envVar name
  pure (if value == "" then fallback else value)

strOfInt : Int -> String
strOfInt n = strFromInt n

-- 去掉结尾换行（命令替换语义；旧套件用 $(...) 会吃掉尾随换行）。
trimNewlines : String -> String
trimNewlines s =
  let
    rev = reverse (strUnpack s)
    kept = dropNewlineChars rev
  in strPack (reverse kept)

dropNewlineChars : List Int -> List Int
dropNewlineChars [] = []
dropNewlineChars (c :: rest) = if c == 10 then dropNewlineChars rest else c :: rest

-- 文件名安全化：case id 里的 `/` 等替换成 `_`（避免把临时产物写进子目录）。
safeName : String -> String
safeName s = strPack (map safeChar (strUnpack s))

safeChar : Int -> Int
safeChar c =
  if c >= 97 && c <= 122 then c
  else if c >= 65 && c <= 90 then c
  else if c >= 48 && c <= 57 then c else if c == 45 || c == 46 || c == 95 then c else 95

listLength : List a -> Int
listLength [] = 0
listLength (x :: rest) = 1 + listLength rest

sumInts : List Int -> Int
sumInts [] = 0
sumInts (x :: rest) = x + sumInts rest

-- 显式效果遍历：纯逻辑（case 模型 / JSON / 路径处理）保持纯，只有真正含效果的列表
-- 操作用这两个局部辅助（本模块没有现成的 Monad 遍历可复用）。
mapEff : (a -> Eff hostRow b) -> List a -> Eff hostRow (List b)
mapEff f [] = pure []
mapEff f (x :: rest) = do
  y <- f x
  ys <- mapEff f rest
  pure (y :: ys)

concatMapEff : (a -> Eff hostRow (List b)) -> List a -> Eff hostRow (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

filterEff : (a -> Eff hostRow Bool) -> List a -> Eff hostRow (List a)
filterEff pred [] = pure []
filterEff pred (x :: rest) = do
  keep <- pred x
  kept <- filterEff pred rest
  pure (if keep then x :: kept else kept)

-- ---------------------------------------------------------------
-- 临时目录与 helper
-- ---------------------------------------------------------------
-- 临时根必须位于**任何 vuna.toml 之外**：§39 一类用例要验证「无 manifest → base-only」，
-- 若临时根落在包内（Nix 沙箱里 TMPDIR 可能就是工作树根），向上找 manifest 会命中仓库根包，
-- 上下文语义被悄悄改写。策略：优先 TMPDIR，其次 /tmp；两者都在
-- manifest 内时回落 TMPDIR（调用方自己的断言会暴露问题）。
hasManifestAncestorFuel : Int -> String -> Eff hostRow Bool
hasManifestAncestorFuel fuel dir = if fuel <= 0 then pure False
else do
  exists <- pathExistsFile "${dir}/vuna.toml"
  if exists then pure True
  else
    let
      parent = Vuna.Cli.Args.parentOf dir
    in if parent == dir then pure False else hasManifestAncestorFuel (fuel - 1) parent

hasManifestAncestor : String -> Eff hostRow Bool
hasManifestAncestor dir = hasManifestAncestorFuel 64 dir

firstManifestFree : List String -> Eff hostRow (Maybe String)
firstManifestFree [] = pure Nothing
firstManifestFree (dir :: rest) = do
  isDir <- pathExistsDir dir
  if isDir then do
    hasAncestor <- hasManifestAncestor dir
    if not hasAncestor then pure (Just dir) else firstManifestFree rest
  else firstManifestFree rest

tempBase : Int -> Eff hostRow String
tempBase _ = do
  value <- envVar "TMPDIR"
  manifestFreeBase value

-- 临时根选择：优先 TMPDIR，其次 /tmp；两者都在 manifest 内时回落 primary。
manifestFreeBase : String -> Eff hostRow String
manifestFreeBase value =
  let
    primary =
      if value == "" then "/tmp"
      else if endsWith "/" value then substring 0 (byteLength value - 1) value else value
  in do
    found <- firstManifestFree [primary, "/tmp"]
    pure (case found of
      Just dir => dir
      Nothing => primary
    )

freshTempRoot : Int -> String -> Eff hostRow String
freshTempRoot fuel candidate = if fuel <= 0 then raiseToRow hostRow (pure candidate)
else do
  exists <- pathExistsFile candidate
  case exists of
    True => freshTempRoot (fuel - 1) "${candidate}-${strOfInt fuel}"
    False => do
      _ <- ensureDirPath candidate
      raiseToRow hostRow (pure candidate)

makeTempRoot : String -> Eff hostRow String
makeTempRoot tag = do
  base <- tempBase 0
  stamp <- effTimeUs
  freshTempRoot 1000 "${base}/vuna-suite-${strOfInt stamp}-${safeName tag}"

helperScript : String
helperScript =
  "#!/bin/sh\nsecs=$1\nout=$2\nerr=$3\ninp=$4\nmerge=$5\nshift 5\nif [ \"$secs\" -gt 0 ] && command -v timeout >/dev/null 2>&1; then\n  if [ \"$merge\" = \"1\" ]; then\n    if [ \"$inp\" = \"-\" ]; then\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" >\"$out\" 2>&1\n    else\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" <\"$inp\" >\"$out\" 2>&1\n    fi\n  else\n    if [ \"$inp\" = \"-\" ]; then\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" >\"$out\" 2>\"$err\"\n    else\n      timeout --foreground -s TERM -k 10 \"$secs\" \"$@\" <\"$inp\" >\"$out\" 2>\"$err\"\n    fi\n  fi\n  rc=$?\nelse\n  if [ \"$merge\" = \"1\" ]; then\n    if [ \"$inp\" = \"-\" ]; then\n      \"$@\" >\"$out\" 2>&1\n    else\n      \"$@\" <\"$inp\" >\"$out\" 2>&1\n    fi\n  else\n    if [ \"$inp\" = \"-\" ]; then\n      \"$@\" >\"$out\" 2>\"$err\"\n    else\n      \"$@\" <\"$inp\" >\"$out\" 2>\"$err\"\n    fi\n  fi\n  rc=$?\nfi\nexit $rc\n"

writeHelper : String -> Eff hostRow String
writeHelper tmp = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_writeFile "${tmp}/run-capture.sh" helperScript)
  pure "${tmp}/run-capture.sh"

-- ---------------------------------------------------------------
-- 子进程
-- ---------------------------------------------------------------
readMaybeFile : String -> Eff hostRow String
readMaybeFile path = do
  exists <- pathExistsFile path
  if exists then raiseToRow hostRow (@vuna@prim_eff_readFile path) else pure ""

-- 运行 argv（cwd 由 @vuna@prim_eff_runIn 控制），timeout 秒级；返回退出码与分离输出。
runCmdWith : Bool -> Env -> String -> String -> Int -> List String -> Eff hostRow CmdResult
runCmdWith merge env tag cwd secs argv =
  let
    outPath = "${env.envTmp}/cmd-${safeName tag}.out"
    errPath = "${env.envTmp}/cmd-${safeName tag}.err"
    fullArgv =
      append ["sh", env.envHelper, strOfInt secs, outPath, errPath, "-", if merge then "1" else "0"]
        argv
  in do
    code <- raiseToRow hostRow (@vuna@prim_eff_runIn cwd fullArgv)
    out <- readMaybeFile outPath
    err <- readMaybeFile errPath
    pure (CmdResult code out err (code == 124 || code == 137))

runCmd : Env -> String -> String -> Int -> List String -> Eff hostRow CmdResult
runCmd env tag cwd secs argv = runCmdWith False env tag cwd secs argv

runCmdMerged : Env -> String -> String -> Int -> List String -> Eff hostRow CmdResult
runCmdMerged env tag cwd secs argv = runCmdWith True env tag cwd secs argv

-- 给子进程注入 suite 需要的环境（父进程不能 setenv）。
withEnv : Env -> List String -> List String
withEnv env argv =
  append
    ["env", "VUNA=${env.envVuna}", "VUNA_SEED=${env.envSeed}", "VUNA_BASE=${env.envBase}", "OCAMLOPT=${env.envOcamlopt}", "VUNA_SUITE_ROOT=${env.envRoot}"]
    argv

-- family / tools case 的进程环境：TMPDIR 按 worker 隔离，对象库与整个 suite 共用
-- （父进程解析一次，见 runSuiteOnce）。对象库是输入寻址的：同一输入同一路径、
-- 原子写，日常 check/build 与测试共用同一根不会互相覆盖；只有断言缓存布局/GC/
-- 冷命中的 store-isolated case 才用私有 store。
withEnvIface : Env -> List String -> List String
withEnvIface env argv = withEnvIfaceAt env "" argv

-- 兼容旧签名（seed 等调用点历史上传 iface 目录）；对象库统一由 env.envStore 决定。
withEnvIfaceAt : Env -> String -> List String -> List String
withEnvIfaceAt env storeOverride argv =
  let
    store = if storeOverride == "" then env.envStore else storeOverride
  in withEnv env (append ["env", "TMPDIR=${env.envTmp}", "VUNA_STORE=${store}"] argv)

-- steps case 的进程环境：TMPDIR/REPL 历史按 **case** 隔离（同一 worker 内多个 steps
-- case 顺序执行，共享 envTmp 会让 `$TMPDIR/ws1` 之类互相污染）。对象库默认与 suite
-- 共用；只有 store-isolated case 用 `${caseTmp}/store`。
withStepsEnv : Env -> String -> Bool -> List String -> List String
withStepsEnv env caseTmp isolated argv =
  let
    store = if isolated then "${caseTmp}/store" else env.envStore
  in withEnv env
    (append ["env", "TMPDIR=${caseTmp}", "VUNA_STORE=${store}", "VUNA_REPL_HISTORY=${caseTmp}/repl-history"] argv)

combinedOut : CmdResult -> String
combinedOut r = r.cmdOut ++ r.cmdErr

-- ---------------------------------------------------------------
-- 断言
-- ---------------------------------------------------------------
assertExit : String -> Int -> Assertion
assertExit name code = Assertion name (code == 0) "exit ${strOfInt code}"

assertExitNonZero : String -> Int -> Assertion
assertExitNonZero name code = Assertion name (code /= 0) "expected non-zero exit, got 0"

assertContains : String -> String -> String -> Assertion
assertContains name hay needle =
  Assertion name (contains needle hay) "missing fragment: ${needle}\nactual:\n${hay}"

assertEq : String -> String -> String -> Assertion
assertEq name expected actual =
  Assertion name (expected == actual) "expected:\n${expected}\nactual:\n${actual}"

assertAbsent : String -> String -> Eff hostRow Assertion
assertAbsent name path = do
  exists <- pathExistsFile path
  pure (Assertion name (not exists) "should not exist: ${path}")

assertSilent : String -> String -> Assertion
assertSilent name out = Assertion name (out == "") "expected no output, got:\n${out}"

countPass : List Assertion -> Int
countPass [] = 0
countPass (a :: rest) = (if a.assertionOk then 1 else 0) + countPass rest

countFail : List Assertion -> Int
countFail [] = 0
countFail (a :: rest) = (if a.assertionOk then 0 else 1) + countFail rest

failMessages : List Assertion -> List String
failMessages [] = []
failMessages (a :: rest) =
  if a.assertionOk then failMessages rest
  else "${a.assertionName}: ${a.assertionDetail}" :: failMessages rest

finishCase : String -> Int -> List Assertion -> Eff hostRow CaseResult
finishCase id start assertions =
  let
    failed = countFail assertions
    passed = countPass assertions
  in do
    now <- effTimeUs
    pure
      (CaseResult id (if failed == 0 then "pass" else "fail") passed failed (passed + failed) ((now - start) / 1000) (failMessages assertions))

-- ---------------------------------------------------------------
-- golden / error case
-- ---------------------------------------------------------------
-- 预热依赖接口（只在父进程跑一次）：`vuna check <base>` 把 base 的模块接口写进
-- 对象库（`$VUNA_STORE/objects/iface`），worker 共用同一根，因此后续 check/interp
-- 只精化自己的入口。失败只降级（会话回退 CLI），不影响用例结果。
warmIfaces : Env -> Eff hostRow Int
warmIfaces env = do
  r <-
    runCmdMerged env "iface-warmup" env.envCwd 300
      (withEnvIface env [env.envVuna, "check", env.envBase])
  pure r.cmdCode

uniqueOutDir : Env -> String -> String
uniqueOutDir env id = "${env.envTmp}/out-${safeName id}"

removeTree : String -> Eff hostRow Int
removeTree path = @vuna@prim_eff_runIn "/" ["rm", "-rf", path]

-- ---------------------------------------------------------------
-- 增量构建缓存：按「生成模块集」复用 ocamlopt 产物
-- ---------------------------------------------------------------
-- 每个 case 的 codegen 都产出「整棵 base + 自己的 Main.ml」；base 部分对同一模块集
-- 逐字节一致，但旧实现每个 case 用独立目录 ⇒ 每次从零 ocamlopt 编译 ~25 个单元
-- （~650ms）。这里先 codegen 到 case 私有 staging，再按 staging 里的模块集取
-- **每 worker 共享**的构建目录，整份拷进去后跑 build.sh：内容哈希 stamp 让 base 单元
-- 全部命中，只重编 Main.ml 并链接（~250ms）。模块集相同的 case 互相加速，模块集变
-- 化才付一次冷编译；worker 内 case 串行执行，目录无并发写。
-- key 用「名字哈希之和」：与 readDir 顺序无关；万一碰撞，build.sh 的 clean 检测会
-- 退回全量重建（只是慢，不会错）。
buildSetKey : List String -> String
buildSetKey names = strOfInt (nonNegTotal (map hashTextStrong names))

nonNegTotal : List Int -> Int
nonNegTotal [] = 0
nonNegTotal (h :: rest) =
  let
    v = if h < 0 then 0 - h else h
  in v + nonNegTotal rest

-- 共享构建目录的 key：staging 里的产物名集合（Main.ml 每 case 不同，不参与）。
-- 目录在 `--cache-dir`（默认 `.local/test-cache`）下按「worker 作用域 + 编译器指纹 +
-- base 哈希」分桶 ⇒ 跨 run 复用 base 的 .cmx：本地重跑不再冷编译整棵 base。
-- 注意：两个 suite 同时用同一 worker 号会写同一桶（内容哈希 stamp 会退化为重编，
-- 极端情况下互相踩写）；并发跑时给其中一个传 `--cache-dir` 隔离。
buildCacheDir : Env -> String -> Eff hostRow String
buildCacheDir env staging = do
  names <- raiseToRow hostRow (@vuna@prim_eff_readDir staging)
  pure "${env.envBuildDir}/set-${buildSetKey names}"

-- 把 staging 整份同步进共享目录（base 的 .ml 内容不变 ⇒ stamp 命中；Main.ml 换成
-- 本 case 的）。
syncBuildDir : String -> String -> Eff hostRow Int
syncBuildDir staging dir = do
  _ <- ensureDirPath dir
  raiseToRow hostRow (@vuna@prim_eff_runIn "/" ["cp", "-a", "${staging}/.", "${dir}/"])

-- 会话优先的 check / interp 探针：命中时零子进程（~200ms → ~10ms），语义等价
-- （check = 退出码，interp = trim 后输出文本）。会话不可用/安全阀不适用时回退 CLI，
-- 保证诊断文本与 `.check.err` 片段匹配仍走原来的路径。
probeInterp : Env -> Case -> String -> Eff hostRow CmdResult
probeInterp env c source = do
  probed <- sessionInterp env.envSession env.envBase source
  case probed of
    Just (Pair code out) => pure (CmdResult code out "" False)
    Nothing =>
      runCmdMerged env "${c.caseId}-interp" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "interp", source])

probeCheck : Env -> Case -> String -> Eff hostRow CmdResult
probeCheck env c source = do
  probed <- sessionCheck env.envSession env.envBase source
  case probed of
    Just (Pair code out) => pure (CmdResult code out "" False)
    Nothing =>
      runCmdMerged env "${c.caseId}-check" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "check", source])

goldenCase : Env -> Case -> String -> String -> Bool -> Bool -> Bool -> Bool -> Bool -> Eff hostRow CaseResult
goldenCase env c source expected wantInterp wantCheck wantCompile wantRun wantCompare =
  let
    staging = "${env.envTmp}/stage-${safeName c.caseId}"
  in do
    start <- effTimeUs
    expectedText <- fmap trimNewlines (raiseToRow hostRow (@vuna@prim_eff_readFile expected))
    interpR <- if wantInterp then probeInterp env c source else pure (CmdResult 1 "" "" False)
    checkCode <- if wantCheck then do
      r <- probeCheck env c source
      pure r.cmdCode
    else pure 1
    compileR <-
      if wantCompile then runCmdMerged env "${c.caseId}-compile" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "compile", source, staging])
      else pure (CmdResult 1 "" "" False)
    outdir <-
      if wantCompile && compileR.cmdCode == 0 then buildCacheDir env staging else pure staging
    syncCode <- if wantCompile && compileR.cmdCode == 0 then syncBuildDir staging outdir else pure 0
    buildR <-
      if wantCompile && compileR.cmdCode == 0 then runCmdMerged env "${c.caseId}-build" outdir c.caseTimeout ["sh", "build.sh", "prog"]
      else pure (CmdResult 1 "" "" False)
    runOk <- pure (wantRun && wantCompile && compileR.cmdCode == 0 && buildR.cmdCode == 0)
    runR <-
      if runOk then runCmdMerged env "${c.caseId}-run" env.envCwd c.caseTimeout ["${outdir}/prog"]
      else pure (CmdResult 1 "" "" False)
    base <- finishCase c.caseId start (let
      interpOn = wantInterp
      interpText = if interpOn then trimNewlines (combinedOut interpR) else ""
      interpA = if interpOn then [assertEq "interp" expectedText interpText] else []
      checkA = if wantCheck then [assertExit "check exit" checkCode] else []
      compileA =
        if wantCompile then [ assertExit "compile exit" compileR.cmdCode,
          assertSilent "compile silent" (combinedOut compileR)
        ]
        else []
      syncA =
        if wantCompile && compileR.cmdCode == 0 then [assertExit "cache sync" syncCode] else []
      buildA =
        if wantCompile && compileR.cmdCode == 0 then [assertExit "build exit" buildR.cmdCode]
        else []
      runA = if runOk then [assertEq "run" expectedText (trimNewlines (combinedOut runR))] else []
      compareA =
        if wantCompare && interpOn && runOk then [assertEq "interp == run" interpText (trimNewlines (combinedOut runR))]
        else []
    in append interpA
      (append checkA (append compileA (append syncA (append buildA (append runA compareA)))))
    )
    actualForBless <-
      pure
        (if runOk then trimNewlines (combinedOut runR) else if wantInterp then trimNewlines (combinedOut interpR) else "")
    if env.envBless && base.resFail > 0 then do
      _ <- raiseToRow hostRow (@vuna@prim_eff_writeFile expected "${actualForBless}\n")
      pure
        (CaseResult c.caseId "blessed" base.resChecks 0 base.resChecks base.resMs ["blessed ${expected}"])
    else pure base

-- 结构化诊断期望文件：与 `.check.err` 同目录的 `.diag.json`（`--json` 聚合文档）。
diagExpectedOf : String -> String
diagExpectedOf expected =
  if endsWith "expected.check.err" expected then "${Vuna.Cli.Args.parentOf expected}/expected.diag.json"
  else if endsWith "expected.err" expected then "${Vuna.Cli.Args.parentOf expected}/expected.diag.json"
  else if endsWith ".check.err" expected then "${substring 0 (byteLength expected - 10) expected}.diag.json"
  else if endsWith ".err" expected then "${substring 0 (byteLength expected - 4) expected}.diag.json"
  else "${expected}.diag.json"

errorCase : Env -> Case -> String -> String -> Bool -> Bool -> Bool -> Eff hostRow CaseResult
errorCase env c source expected wantInterp wantCheck wantCompile =
  let
    baseName =
      if endsWith ".vuna" source then substring 0 (byteLength source - 5) source else source
    compileErrPath = "${baseName}.compile.err"
    legacyCerrPath = "${baseName}.cerr"
    denyPath =
      if startsWith "/" baseName then "${baseName}.deny" else "${env.envCwd}/${baseName}.deny"
    outdir = uniqueOutDir env c.caseId
    diagPath = diagExpectedOf expected
  in do
    pkgRoot <- pkgRootOf (Vuna.Cli.Args.parentOf source) 8
    denyExists <- pathExistsFile denyPath
    let
      denyArgs = if denyExists then ["--deny-warnings"] else []
      -- 共享 store 命中会跳过精化，warning 不持久化 ⇒ 负例必须 `-W` 绕过判定，
      -- 否则同一 checkIn 的第二个 case 看不到 warning。`--deny-warnings` 本身也绕过。
      warnArgs = if denyExists then [] else ["-W"]
      checkArgs = append denyArgs warnArgs
      -- `.deny` 的 warning 语义没有进 split/check 的输入摘要（缓存键只看源/依赖/
      -- 编译器），共享 store 下可能命中普通 check 的成功结果 ⇒ 强制全量，绕过判定。
      denyFull = if denyExists then ["env", "VUNA_ELAB_FULL=1"] else []
      -- warning/deny 语义没有进 split 的输入摘要：用 case 私有空 store，避免命中
      -- 普通 check 写下的成功产物（共享 store 下否则会假通过）。
      denyStore = if denyExists then "${env.envTmp}/store-deny-${safeName c.caseId}" else ""
      pkgMode = not (pkgRoot == "")
      caseCwd = if pkgMode then pkgRoot else env.envCwd
      target = if pkgMode then "." else source
      diagSource = if pkgMode then "." else relativeTo env.envCwd source
      diagCwd = caseCwd
    in do
      start <- effTimeUs
      fragment <- fmap trimNewlines (raiseToRow hostRow (@vuna@prim_eff_readFile expected))
      compileExists <- pathExistsFile compileErrPath
      compileFragment <- if compileExists then fmap trimNewlines (raiseToRow hostRow (@vuna@prim_eff_readFile compileErrPath))
      else do
        legacyExists <- pathExistsFile legacyCerrPath
        if legacyExists then fmap trimNewlines (raiseToRow hostRow (@vuna@prim_eff_readFile legacyCerrPath))
        else pure fragment
      interpA <- if wantInterp then do
        r <-
          runCmdMerged env "${c.caseId}-interp" env.envCwd c.caseTimeout
            (withEnvIface env (append [env.envVuna, "interp", source] denyArgs))
        pure
          [assertContains "interp fragment" (combinedOut r) fragment, assertExitNonZero "interp exit" r.cmdCode]
      else pure []
      checkA <- if wantCheck then do
        r <-
          runCmdMerged env "${c.caseId}-check" caseCwd c.caseTimeout
            (withEnvIfaceAt env denyStore (append denyFull (append [env.envVuna, "check", target] checkArgs)))
        pure
          [assertContains "check fragment" (combinedOut r) fragment, assertExitNonZero "check exit" r.cmdCode]
      else pure []
      _ <- removeTree outdir
      compileA <- if wantCompile then do
        r <-
          runCmdMerged env "${c.caseId}-compile" caseCwd c.caseTimeout
            (withEnvIfaceAt env denyStore (append denyFull (append [env.envVuna, "compile", target, outdir] checkArgs)))
        absent <- assertAbsent "compile no output dir" outdir
        pure
          [assertContains "compile fragment" (combinedOut r) compileFragment, assertExitNonZero "compile exit" r.cmdCode, absent]
      else pure []
      diagRun <-
        if wantCheck then runCmdMerged env "${c.caseId}-diag" diagCwd c.caseTimeout
          (withEnvIfaceAt env denyStore (append denyFull (append [env.envVuna, "check", diagSource, "--json"] checkArgs)))
        else if wantCompile then runCmdMerged env "${c.caseId}-diag" diagCwd c.caseTimeout
          (withEnvIfaceAt env denyStore (append denyFull (append [env.envVuna, "compile", diagSource, uniqueOutDir env "${c.caseId}-diag", "--json"] checkArgs)))
        else runCmdMerged env "${c.caseId}-diag" diagCwd c.caseTimeout
          (withEnvIfaceAt env denyStore (append denyFull (append [env.envVuna, "check", diagSource, "--json"] checkArgs)))
      actualDiag <- pure (normalizeDiagText env (trimNewlines (combinedOut diagRun)))
      diagA <- if env.envBlessDiag then do
        _ <- raiseToRow hostRow (@vuna@prim_eff_writeFile diagPath "${actualDiag}\n")
        pure []
      else do
        hasDiag <- pathExistsFile diagPath
        if hasDiag then do
          expectedDiag <- raiseToRow hostRow (@vuna@prim_eff_readFile diagPath)
          pure [assertEq "diag json" (normalizeDiagText env (trimNewlines expectedDiag)) actualDiag]
        else pure []
      finishCase c.caseId start (append interpA (append checkA (append compileA diagA)))

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
parseLeadingInt : String -> Maybe Int
parseLeadingInt s = parseDigits (strUnpack s) 0 0

parseDigits : List Int -> Int -> Int -> Maybe Int
parseDigits [] acc count = if count == 0 then Nothing else Just acc
parseDigits (c :: rest) acc count =
  if c >= 48 && c <= 57 then parseDigits rest (acc * 10 + (c - 48)) (count + 1)
  else if count == 0 then Nothing else Just acc

-- ---------------------------------------------------------------
-- 单 case 分派
-- ---------------------------------------------------------------
-- ---------------------------------------------------------------
-- 结果缓存（本地增量；CI 用 --no-cache）
-- ---------------------------------------------------------------
-- 只缓存 golden/error case 的成功结果。key 含编译器指纹、base 源码树哈希、source/
-- expected 内容（目录型再加整个夹具目录的 .vuna 树）。section/脚本一律不缓存。
hashFileText : String -> Eff hostRow String
hashFileText path = do
  exists <- pathExistsFile path
  if exists then raiseToRow hostRow (@vuna@prim_eff_readFile path) else pure ""

hashFiles : Int -> List String -> Eff hostRow Int
hashFiles acc [] = pure acc
hashFiles acc (path :: rest) = do
  text <- hashFileText path
  hashFiles (acc * 1000003 + hashTextStrong text) rest

hashTree : String -> Eff hostRow Int
hashTree dir = do
  files <- collectVunaFiles dir
  hashFiles 0 files

caseTreeHash : Case -> String -> String -> Eff hostRow Int
caseTreeHash c source expected =
  if contains "/app/" source then appTreeHash source expected else fileTreeHash source expected

-- 目录型夹具（`app/Main.vuna`）：整棵包目录的 .vuna 树参与 key。
appTreeHash : String -> String -> Eff hostRow Int
appTreeHash source expected = do
  treeHash <- hashTree (Vuna.Cli.Args.parentOf (Vuna.Cli.Args.parentOf source))
  expectedText <- hashFileText expected
  pure (treeHash * 1000003 + hashTextStrong expectedText)

-- 文件型夹具：source/expected 内容 + mtime/size。
fileTreeHash : String -> String -> Eff hostRow Int
fileTreeHash source expected = do
  stamp <- raiseToRow hostRow (@vuna@prim_eff_fileMtime source)
  size <- raiseToRow hostRow (@vuna@prim_eff_fileSize source)
  sourceText <- hashFileText source
  expectedText <- hashFileText expected
  pure (hashTextStrong "${sourceText}|${expectedText}|${strOfInt stamp}|${strOfInt size}")

-- ---------------------------------------------------------------
-- test verdict 对象（objects/test/<testIn>）
--
-- 通过 = 对象存在；载荷 = checks 数。输入只含**内容**摘要，不含 mtime/size；steps
-- 暂不缓存（输入不可声明）。warning 不持久化，负例仍靠 `-W` / 私有 store 绕过命中。
-- ---------------------------------------------------------------
testVerdictSchema : String
testVerdictSchema = "vuna-test-verdict 1"

testVerdictCodec : String
testVerdictCodec = "test-verdict 1"

absHash : Int -> Int
absHash n = if n < 0 then 0 - n else n

testProjectId : Env -> String
testProjectId env = strOfInt (absHash (hashTextStrong env.envRoot))

verdictEnvTag : Eff hostRow String
verdictEnvTag = do
  noSession <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_TEST_NO_SESSION")
  pure "no-session=${noSession}"

-- 只缓存输入可声明的 golden/error；check/lint/fix/steps 不缓存。
verdictKey : Env -> Case -> Eff hostRow String
verdictKey env c = if not env.envCacheEnabled then pure ""
else case c.caseKind of
  CGolden source expected _ _ _ _ _ => verdictKeyOf env c source expected
  CError source expected _ _ _ => verdictKeyOf env c source expected
  _ => pure ""

verdictKeyOf : Env -> Case -> String -> String -> Eff hostRow String
verdictKeyOf env c source expected = do
  srcText <- hashFileText source
  expText <- hashFileText expected
  fp <- toolCompilerFingerprint
  tag <- verdictEnvTag
  let
    kindTag = case c.caseKind of
      CGolden _ _ _ _ _ _ _ => "golden"
      CError _ _ _ _ _ => "error"
      _ => "other"
    srcHash = strOfInt (absHash (hashTextStrong srcText))
    expHash = strOfInt (absHash (hashTextStrong expText))
    input =
      join "|"
        [testVerdictSchema, c.caseId, kindTag, srcHash, expHash, strOfInt fp, strOfInt env.envBaseHash, tag]
  in pure (strOfInt (absHash (hashTextStrong input)))

-- ---------------------------------------------------------------
-- --last-failed
-- ---------------------------------------------------------------
lastFailedDir : Env -> String
lastFailedDir env = "${env.envRoot}/.local/test-suite"

lastFailedPath : Env -> String
lastFailedPath env = "${lastFailedDir env}/last-failed"

lastFailedIds : Env -> Eff hostRow (List String)
lastFailedIds env =
  let
    path = lastFailedPath env
  in do
    exists <- pathExistsFile path
    if not exists then pure []
    else do
      text <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
      pure (filter (\line => line /= "") (lines text))

filterLastFailed : Env -> List Case -> Eff hostRow (List Case)
filterLastFailed env cases = do
  ids <- lastFailedIds env
  pure (filter (caseIdIn ids) cases)

recordLastFailed : Env -> List CaseResult -> Eff hostRow Int
recordLastFailed env [] = pure 0
recordLastFailed env results =
  let
    failed = filter isFailed results
    text = join "\n" (map resIdOf failed)
  in do
    _ <- ensureDirPath (lastFailedDir env)
    raiseToRow hostRow (@vuna@prim_eff_writeFile (lastFailedPath env) text)

caseIdIn : List String -> Case -> Bool
caseIdIn ids c = memName c.caseId ids

resIdOf : CaseResult -> String
resIdOf r = r.resId

cachedChecks : String -> Int
cachedChecks text = fromMaybe 0 (parseLeadingInt (trim text))

readCached : Env -> Case -> Eff hostRow (Maybe CaseResult)
readCached env c = do
  key <- verdictKey env c
  if key == "" then pure Nothing
  else do
    raw <- storeObjectReadEff "test" testVerdictCodec key
    case raw of
      Nothing => pure Nothing
      Just text => do
        n <- pure (cachedChecks text)
        pure (Just (CaseResult c.caseId "cached" n 0 n 0 []))

writeCached : Env -> Case -> CaseResult -> Eff hostRow Int
writeCached env c r = do
  key <- verdictKey env c
  if key == "" || r.resStatus /= "pass" then pure 0
  else do
    _ <- storeObjectWriteEff "test" testVerdictCodec key "${strOfInt r.resChecks}\n"
    storeRootAppendEff (testProjectId env) [key]

runCase : Env -> Case -> Eff hostRow CaseResult
runCase env c = do
  cached <- readCached env c
  case cached of
    Just r => pure r
    Nothing => do
      r <- runCaseGo env c
      _ <- writeCached env c r
      pure r

checkCase : Env -> Case -> String -> Bool -> String -> Eff hostRow CaseResult
checkCase env c source expectPass expectedErr = do
  start <- effTimeUs
  let
    warnArgs = if expectPass then [] else ["-W"]
  in do
    r <-
      runCmdMerged env "${c.caseId}-check" env.envCwd c.caseTimeout
        (withEnvIface env (append [env.envVuna, "check", source] warnArgs))
    if expectPass then finishCase c.caseId start [assertExit "check exit" r.cmdCode]
    else do
      fragment <- hashFileText expectedErr
      let
        checks =
          if fragment == "" then [assertExitNonZero "check exit" r.cmdCode]
          else [ assertContains "check fragment" (combinedOut r) (trimNewlines fragment),
            assertExitNonZero "check exit" r.cmdCode
          ]
      in finishCase c.caseId start checks

relativeTestPath : Env -> String -> String
relativeTestPath env source =
  let
    prefix = "${env.envRoot}/test/"
  in if startsWith prefix source then substring (byteLength prefix) (byteLength source - byteLength prefix) source
  else source

lintCase : Env -> Case -> String -> String -> Eff hostRow CaseResult
lintCase env c source expected = do
  start <- effTimeUs
  rawExpected <- raiseToRow hostRow (@vuna@prim_eff_readFile expected)
  r <-
    runCmdMerged env "${c.caseId}-lint" env.envCwd c.caseTimeout
      (withEnvIface env [env.envVuna, "lint", relativeTestPath env source])
  let
    expectedText = trimNewlines rawExpected
    expectedExit = if expectedText == "" then 0 else 1
    exitA =
      Assertion "lint exit" (r.cmdCode == expectedExit)
        "expected exit ${strOfInt expectedExit}, got ${strOfInt r.cmdCode}"
  in finishCase c.caseId start
    [assertEq "lint output" expectedText (trimNewlines (combinedOut r)), exitA]

-- `--fix` 的工作副本路径（纯）：整份源码先拷到该文件，再对副本跑两次 lint --fix。
fixWorkPath : Env -> Case -> String
fixWorkPath env c = "${env.envTmp}/fix-${safeName c.caseId}.vuna"

fixCase : Env -> Case -> String -> String -> Eff hostRow CaseResult
fixCase env c source expected =
  let
    work = fixWorkPath env c
  in do
    start <- effTimeUs
    expectedText <- fmap trimNewlines (raiseToRow hostRow (@vuna@prim_eff_readFile expected))
    sourceText <- raiseToRow hostRow (@vuna@prim_eff_readFile source)
    _ <- raiseToRow hostRow (@vuna@prim_eff_writeFile work sourceText)
    _ <-
      runCmdMerged env "${c.caseId}-fix1" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "lint", "--fix", work])
    onceText <- raiseToRow hostRow (@vuna@prim_eff_readFile work)
    _ <-
      runCmdMerged env "${c.caseId}-fix2" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "lint", "--fix", work])
    twiceText <- raiseToRow hostRow (@vuna@prim_eff_readFile work)
    let
      once = trimNewlines onceText
      twice = trimNewlines twiceText
      fixA = assertEq "fix" expectedText once
      idemA = assertEq "fix idempotent" once twice
    in finishCase c.caseId start [fixA, idemA]

-- 产物运行期 case。expectedExit 语义：0 = 断言非 0（无显式退出码的遗留行为）；
-- 256 = 断言恰好 0（`.run.exit` 内容为 0，哨兵超出真实退出码 0–255 范围）；
-- n > 0（< 256）= 断言恰好 n。expectedErr 缺失（只有 `.run.exit`）时跳过片段断言。
runtimeCase : Env -> Case -> String -> String -> Int -> Eff hostRow CaseResult
runtimeCase env c source expectedErr expectedExit =
  let
    staging = "${env.envTmp}/stage-${safeName c.caseId}"
  in do
    start <- effTimeUs
    fragmentText <- readMaybeFile expectedErr
    comp <-
      runCmdMerged env "${c.caseId}-compile" env.envCwd c.caseTimeout
        (withEnvIface env [env.envVuna, "compile", source, staging])
    outdir <- if comp.cmdCode == 0 then buildCacheDir env staging else pure staging
    _ <- if comp.cmdCode == 0 then syncBuildDir staging outdir else pure 0
    buildA <- if comp.cmdCode == 0 then do
      b <- runCmdMerged env "${c.caseId}-build" outdir c.caseTimeout ["sh", "build.sh", "prog"]
      if b.cmdCode == 0 then do
        r <- runCmdMerged env "${c.caseId}-run" env.envCwd c.caseTimeout ["${outdir}/prog"]
        let
          fragmentA =
            if fragmentText == "" then []
            else [assertContains "runtime fragment" (combinedOut r) (trimNewlines fragmentText)]
          exitA =
            if expectedExit == 0 then assertExitNonZero "runtime exit" r.cmdCode
            else if expectedExit == 256 then assertExit "runtime exit 0" r.cmdCode
            else Assertion "runtime exit" (r.cmdCode == expectedExit)
              "expected exit ${strOfInt expectedExit}, got ${strOfInt r.cmdCode}"
        in pure (append fragmentA [exitA])
      else pure [assertExit "build exit" b.cmdCode]
    else pure [assertExit "compile exit" comp.cmdCode]
    finishCase c.caseId start buildA

-- ---------------------------------------------------------------
-- 声明式步进用例（`*.steps`）
-- ---------------------------------------------------------------
-- 行式指令，一个文件 = 一个 case。步骤由 `run:` / `read:` 开启，其余指令挂当前步：
--   exit: 0 | nonzero | <n>          缺省 0（run/read 默认必须成功）
--   out-contains: / out-not-contains: / out-equals: <literal> / out-equals-file: <path>
--   file-exists: / file-absent: / file-contains: <path> <fragment>
-- `for-each: <shell word list>` … `end:` 把块内步骤按匹配项各跑一次；`{item}` = 匹配项
-- （去尾 `/`）、`{name}` = basename、`{stem}` = 去掉结尾 `.vuna` 的匹配项。空匹配 = 失败。
-- 路径：`$TMPDIR` 展开为 case 临时根；相对路径按 cwd = test/ 解析。
record Step where
  stRun : String
  stRead : String
  stExit : String
  stContains : List String
  stNotContains : List String
  stEquals : List String
  stEqualsFile : List String
  stFiles : List String
  stAbsent : List String
  stFileContains : List (Pair String String)

emptyStep : Step
emptyStep = Step "" "" "" [] [] [] [] [] [] []

stepWithRun : String -> Step
stepWithRun body = Step body "" "" [] [] [] [] [] [] []

stepWithRead : String -> Step
stepWithRead path = Step "" path "" [] [] [] [] [] [] []

record StepGroup where
  sgGlob : String
  sgSteps : List Step

record StepParse where
  spDone : List StepGroup
  spOpen : Bool
  spGlob : String
  spSteps : List Step
  spErr : String

data StepEdit : Type where
  SeOk : Step -> StepEdit
  SeErr : String -> StepEdit

data StepsParse : Type where
  SpOk : List StepGroup -> StepsParse
  SpErr : String -> StepsParse

isBlankOrComment : String -> Bool
isBlankOrComment line =
  let
    t = trim line
  in byteLength t == 0 || startsWith "#" t

firstSpaceIndex : List Int -> Int -> Int
firstSpaceIndex [] i = 0 - 1
firstSpaceIndex (c :: rest) i = if c == 32 then i else firstSpaceIndex rest (i + 1)

splitFirstSpace : String -> Pair String String
splitFirstSpace text =
  let
    i = firstSpaceIndex (strUnpack text) 0
    n = natToInt (byteLength text)
  in if i < 0 then Pair text ""
  else Pair (substring 0 (natFromInt i) text)
    (trim (substring (natFromInt (i + 1)) (natFromInt (n - i - 1)) text))

stepWithExit : Step -> String -> Step
stepWithExit st x =
  Step st.stRun st.stRead x st.stContains st.stNotContains st.stEquals st.stEqualsFile st.stFiles
    st.stAbsent st.stFileContains

stepWithContains : Step -> String -> Step
stepWithContains st x =
  Step st.stRun st.stRead st.stExit (append st.stContains [x]) st.stNotContains st.stEquals
    st.stEqualsFile st.stFiles st.stAbsent st.stFileContains

stepWithNotContains : Step -> String -> Step
stepWithNotContains st x =
  Step st.stRun st.stRead st.stExit st.stContains (append st.stNotContains [x]) st.stEquals
    st.stEqualsFile st.stFiles st.stAbsent st.stFileContains

stepWithEqualsFile : Step -> String -> Step
stepWithEqualsFile st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals
    (append st.stEqualsFile [x]) st.stFiles st.stAbsent st.stFileContains

stepWithEquals : Step -> String -> Step
stepWithEquals st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains (append st.stEquals [x])
    st.stEqualsFile st.stFiles st.stAbsent st.stFileContains

stepWithFile : Step -> String -> Step
stepWithFile st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals st.stEqualsFile
    (append st.stFiles [x]) st.stAbsent st.stFileContains

stepWithAbsent : Step -> String -> Step
stepWithAbsent st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals st.stEqualsFile
    st.stFiles (append st.stAbsent [x]) st.stFileContains

stepWithFileContains : Step -> Pair String String -> Step
stepWithFileContains st x =
  Step st.stRun st.stRead st.stExit st.stContains st.stNotContains st.stEquals st.stEqualsFile
    st.stFiles st.stAbsent (append st.stFileContains [x])

applyDirective : Step -> String -> StepEdit
applyDirective st t =
  let
    n = byteLength t
  in if startsWith "exit:" t then SeOk (stepWithExit st (trim (substring 5 (n - 5) t)))
  else if startsWith "out-contains:" t then SeOk (stepWithContains st (trim (substring 13 (n - 13) t)))
  else if startsWith "out-not-contains:" t then SeOk (stepWithNotContains st (trim (substring 17 (n - 17) t)))
  else if startsWith "out-equals-file:" t then SeOk (stepWithEqualsFile st (trim (substring 16 (n - 16) t)))
  else if startsWith "out-equals:" t then SeOk (stepWithEquals st (trim (substring 11 (n - 11) t)))
  else if startsWith "file-exists:" t then SeOk (stepWithFile st (trim (substring 12 (n - 12) t)))
  else if startsWith "file-absent:" t then SeOk (stepWithAbsent st (trim (substring 12 (n - 12) t)))
  else if startsWith "file-contains:" t then SeOk (stepWithFileContains st (splitFirstSpace (trim (substring 14 (n - 14) t))))
  else SeErr "unknown step directive: ${t}"

setParseErr : StepParse -> String -> StepParse
setParseErr st msg = StepParse st.spDone st.spOpen st.spGlob st.spSteps msg

setParseSteps : StepParse -> List Step -> StepParse
setParseSteps st steps = StepParse st.spDone st.spOpen st.spGlob steps st.spErr

openGroup : StepParse -> String -> StepParse
openGroup st spec = StepParse st.spDone True spec st.spSteps st.spErr

closeGroup : StepParse -> StepParse
closeGroup st = StepParse st.spDone False "" st.spSteps st.spErr

pushStep : StepParse -> Step -> StepParse
pushStep st step = setParseSteps st (step :: st.spSteps)

flushGroup : StepParse -> StepParse
flushGroup st =
  if listLength st.spSteps == 0 then st
  else StepParse (StepGroup st.spGlob (reverse st.spSteps) :: st.spDone) st.spOpen st.spGlob [] st.spErr

-- 逐行解析（不用 foldl / 记录更新：把 `StepParse` 当多态 fold 的累加器、或在递归函数里
-- 用记录更新，都会触发 QTT 擦除 binder 推断 bug；显式构造器 + 错误字段更直接）。
parseLine : StepParse -> String -> StepParse
parseLine st line =
  let
    t = trim line
    n = byteLength t
  in if st.spErr /= "" then st
  else if isBlankOrComment line then st
  else if startsWith "for-each:" t then if st.spOpen then setParseErr st "nested for-each is not supported"
  else
    let
      spec = trim (substring 9 (n - 9) t)
      flushed = flushGroup st
    in if byteLength spec == 0 then setParseErr st "for-each needs a shell word list"
    else openGroup flushed spec
  else if t == "end:" then if not st.spOpen then setParseErr st "end: without matching for-each"
  else closeGroup (flushGroup st)
  else if startsWith "run:" t then pushStep st (stepWithRun (trim (substring 4 (n - 4) t)))
  else if startsWith "read:" t then pushStep st (stepWithRead (trim (substring 5 (n - 5) t)))
  else case st.spSteps of
    [] => setParseErr st "directive before any run:/read: step: ${t}"
    step :: rest => case applyDirective step t of
      SeErr e => setParseErr st e
      SeOk step2 => setParseSteps st (step2 :: rest)

parseLines : List String -> StepParse -> StepParse
parseLines [] st = st
parseLines (line :: rest) st = parseLines rest (parseLine st line)

parseStepsV2 : String -> StepsParse
parseStepsV2 text =
  let
    st = parseLines (splitOnChar 10 text) (StepParse [] False "" [] "")
  in if st.spErr /= "" then SpErr st.spErr
  else if st.spOpen then SpErr "unclosed for-each: ${st.spGlob}"
  else
    let
      flushed = flushGroup st
    in SpOk (reverse flushed.spDone)

countGroupSteps : StepGroup -> Int
countGroupSteps g = listLength g.sgSteps

countStepGroups : List StepGroup -> Int
countStepGroups [] = 0
countStepGroups (g :: rest) = countGroupSteps g + countStepGroups rest

replaceAll : String -> String -> String -> String
replaceAll needle repl text = if byteLength needle == 0 then text else join repl (split needle text)

dropTrailingSlashes : List Int -> List Int
dropTrailingSlashes [] = []
dropTrailingSlashes (c :: rest) = if c == 47 then dropTrailingSlashes rest else c :: rest

stripTrailingSlash : String -> String
stripTrailingSlash text =
  if byteLength text > 1 then strPack (reverse (dropTrailingSlashes (reverse (strUnpack text))))
  else text

lastSegment : List String -> String
lastSegment [] = ""
lastSegment ([x]) = x
lastSegment (x :: rest) = lastSegment rest

baseNameOf : String -> String
baseNameOf path = lastSegment (filter (\part => part /= "") (split "/" path))

stemOf : String -> String
stemOf path = if endsWith ".vuna" path then substring 0 (byteLength path - 5) path else path

substText : String -> String -> String -> String
substText item name text =
  replaceAll "{item}" item (replaceAll "{name}" name (replaceAll "{stem}" (stemOf item) text))

substFileContains : String -> String -> Pair String String -> Pair String String
substFileContains item name (Pair path frag) =
  Pair (substText item name path) (substText item name frag)

substStep : String -> String -> Step -> Step
substStep item name st =
  let
    s = substText item name
  in Step (s st.stRun) (s st.stRead) (s st.stExit) (map s st.stContains) (map s st.stNotContains)
    (map s st.stEquals) (map s st.stEqualsFile) (map s st.stFiles) (map s st.stAbsent)
    (map (substFileContains item name) st.stFileContains)

stepPath : Env -> String -> String -> String
stepPath env caseTmp path =
  let
    expanded = replaceAll "$TMPDIR" caseTmp path
  in if startsWith "/" expanded then expanded else "${env.envCwd}/${expanded}"

exitAsserts : String -> Int -> List Assertion
exitAsserts spec code =
  if spec == "" || spec == "0" then [assertExit "exit" code]
  else if spec == "nonzero" then [assertExitNonZero "exit" code]
  else [ Assertion "exit" (code == fromMaybe 0 (parseLeadingInt spec)) "expected ${spec}, got ${strOfInt code}"
  ]

-- 失败上下文：step 命令行 + 捕获输出尾部。CI 里 steps case 只报 `exit: exit 1`，
-- 看不出是哪条命令失败、也看不到脚本自己打印的原因（如 corpus check.sh 的 `FAIL:` 行）。
stepContext : String -> String -> String
stepContext cmd out =
  let
    outTail = trimNewlines out
  in "\n  step: ${truncateHead 240 cmd}"
    ++ (if byteLength outTail == 0 then "" else "\n  output tail:\n${truncateTail 1600 outTail}")

withStepContext : String -> Assertion -> Assertion
withStepContext ctx a =
  if a.assertionOk then a else Assertion a.assertionName False "${a.assertionDetail}${ctx}"

truncateHead : Int -> String -> String
truncateHead n s = if byteLength s <= n then s else "${substring 0 (natFromInt n) s}…"

truncateTail : Int -> String -> String
truncateTail n s =
  if byteLength s <= n then s
  else "…${substring (natFromInt (byteLength s - n)) (natFromInt n) s}"

fileContainsAssert : Env -> String -> Pair String String -> Eff hostRow Assertion
fileContainsAssert env caseTmp (Pair path frag) = do
  text <- readMaybeFile (stepPath env caseTmp path)
  pure
    (Assertion "file" (contains frag text) "file ${path} missing fragment: ${frag}\nactual:\n${text}")

-- 断言列表：纯片段（out-contains / file-exists 等）照旧现算；只有读文件的两类
-- （out-equals-file / file-contains）走效果遍历，顺序与旧的 let 求值一致。
outAsserts : Env -> String -> String -> Step -> Eff hostRow (List Assertion)
outAsserts env caseTmp out st = do
  equalsFileA <- mapEff (\path => do
    text <- readMaybeFile (stepPath env caseTmp path)
    pure (assertEq "out" (trimNewlines text) (trimNewlines out))
  ) st.stEqualsFile
  fileContainsA <- mapEff (fileContainsAssert env caseTmp) st.stFileContains
  fileExistsA <- mapEff (\f => do
    exists <- pathExistsFile (stepPath env caseTmp f)
    pure (Assertion "file" exists "missing ${f}")
  ) st.stFiles
  fileAbsentA <- mapEff (\f => do
    exists <- pathExistsFile (stepPath env caseTmp f)
    pure (Assertion "file" (not exists) "should not exist: ${f}")
  ) st.stAbsent
  pure
    (append (map (\frag => assertContains "out" out frag) st.stContains) (append (map (\frag => Assertion "out" (not (contains frag out)) "unexpected fragment: ${frag}\nactual:\n${out}") st.stNotContains) (append (map (\want => assertEq "out" want (trimNewlines out)) st.stEquals) (append equalsFileA (append fileExistsA (append fileAbsentA fileContainsA))))))

stepAssertsV2 : Env -> String -> Int -> Bool -> Step -> Eff hostRow (List Assertion)
stepAssertsV2 env caseTmp timeout isolated st = if byteLength st.stRun > 0 then do
  r <-
    runCmdMerged env "step" env.envCwd timeout
      (withStepsEnv env caseTmp isolated ["sh", "-c", st.stRun])
  outA <- outAsserts env caseTmp (combinedOut r) st
  let
    ctx = stepContext st.stRun (combinedOut r)
    headA =
      if r.cmdTimedOut then [Assertion "timeout" False "step timed out after ${strOfInt timeout}s${ctx}"]
      else []
  in pure (append headA (append (map (withStepContext ctx) (exitAsserts st.stExit r.cmdCode)) outA))
else if byteLength st.stRead > 0 then
  let
    resolved = stepPath env caseTmp st.stRead
  in do
    exists <- pathExistsFile resolved
    text <- if exists then readMaybeFile resolved else pure ""
    outA <- outAsserts env caseTmp text st
    pure
      (append (if exists then [] else [Assertion "read" False "no such file: ${st.stRead}"]) (append (if byteLength st.stExit == 0 then [] else exitAsserts st.stExit (if exists then 0 else 1)) outA))
else pure []

prefixAssertions : String -> List Assertion -> List Assertion
prefixAssertions name [] = []
prefixAssertions name (a :: rest) =
  Assertion "${name}: ${a.assertionName}" a.assertionOk a.assertionDetail
    :: prefixAssertions name rest

expandLoopItems : Env -> String -> Bool -> String -> Eff hostRow CmdResult
expandLoopItems env caseTmp isolated spec =
  let
    body =
      "for x in ${spec}; do if [ -e \"$x\" ]; then printf '%s\\n' \"$x\"; else exit 3; fi; done"
  in runCmdMerged env "for-each" env.envCwd 60 (withStepsEnv env caseTmp isolated ["sh", "-c", body])

loopItemAsserts : Env -> String -> Int -> Bool -> StepGroup -> String -> Eff hostRow (List Assertion)
loopItemAsserts env caseTmp timeout isolated g raw =
  let
    item = stripTrailingSlash raw
    name = baseNameOf item
    steps = map (substStep item name) g.sgSteps
  in do
    asserts <- concatMapEff (stepAssertsV2 env caseTmp timeout isolated) steps
    pure (prefixAssertions name asserts)

stepGroupAsserts : Env -> String -> Int -> Bool -> StepGroup -> Eff hostRow (List Assertion)
stepGroupAsserts env caseTmp timeout isolated g = if byteLength g.sgGlob == 0 then concatMapEff (stepAssertsV2 env caseTmp timeout isolated) g.sgSteps
else do
  r <- expandLoopItems env caseTmp isolated g.sgGlob
  let
    items = filter (\raw => raw /= "") (lines r.cmdOut)
  in if r.cmdCode /= 0 then pure
    [Assertion "for-each" False "failed to expand ${g.sgGlob} (exit ${strOfInt r.cmdCode}):\n${combinedOut r}"]
  else if listLength items == 0 then pure [Assertion "for-each" False "matched nothing: ${g.sgGlob}"]
  else concatMapEff (loopItemAsserts env caseTmp timeout isolated g) items

-- steps case 的隔离临时根（纯）：同一 worker 内多个 steps case 顺序执行，
-- 共享 envTmp 会让 `$TMPDIR/ws1` 之类互相污染，所以按 case id 的哈希分目录。
stepsTmpDir : Env -> Case -> String
stepsTmpDir env c = "${env.envTmp}/c-${strOfInt (hashTextStrong c.caseId)}"

stepsCase : Env -> Case -> String -> Eff hostRow CaseResult
stepsCase env c path =
  let
    caseTmp = stepsTmpDir env c
  in do
    start <- effTimeUs
    _ <- ensureDirPath caseTmp
    hasPath <- pathExistsFile path
    text <- if hasPath then raiseToRow hostRow (@vuna@prim_eff_readFile path) else pure ""
    -- 文件头 `# store-isolated` 标记：该 case 断言缓存布局/GC/冷命中，必须用私有 store；
    -- 其余 steps 默认与 suite 共用对象库。
    let
      isolated = contains "store-isolated" text
    in case parseStepsV2 text of
      SpErr msg =>
        finishCase c.caseId start [Assertion "steps" False "parse error in ${path}: ${msg}"]
      SpOk groups => do
        assertions <- concatMapEff (stepGroupAsserts env caseTmp c.caseTimeout isolated) groups
        let
          hasWork = countStepGroups groups > 0
        in finishCase c.caseId start
          (Assertion "steps" hasWork "no run:/read: directive in ${path}" :: assertions)

seedCase : Env -> Case -> String -> String -> Eff hostRow CaseResult
seedCase env c source expected =
  let
    outdir = uniqueOutDir env c.caseId
    ifaceDir = "${outdir}-iface"
  in do
    start <- effTimeUs
    expectedText <- fmap trimNewlines (raiseToRow hostRow (@vuna@prim_eff_readFile expected))
    _ <- removeTree outdir
    _ <- removeTree ifaceDir
    _ <- ensureDirPath ifaceDir
    comp <-
      runCmdMerged env "${c.caseId}-compile" env.envCwd c.caseTimeout
        (withEnvIfaceAt env ifaceDir [env.envSeed, "compile", source, outdir])
    buildA <- if comp.cmdCode == 0 then do
      b <- runCmdMerged env "${c.caseId}-build" outdir c.caseTimeout ["sh", "build.sh", "prog"]
      if b.cmdCode == 0 then do
        r <- runCmdMerged env "${c.caseId}-run" env.envCwd c.caseTimeout ["${outdir}/prog"]
        pure [assertEq "seed run" expectedText (trimNewlines (combinedOut r))]
      else pure [assertExit "seed build exit" b.cmdCode]
    else pure [assertExit "seed compile exit" comp.cmdCode]
    finishCase c.caseId start buildA

runCaseGo : Env -> Case -> Eff hostRow CaseResult
runCaseGo env c = case c.caseKind of
  CGolden source expected wantInterp wantCheck wantCompile wantRun wantCompare =>
    goldenCase env c source expected wantInterp wantCheck wantCompile wantRun wantCompare
  CError source expected wantInterp wantCheck wantCompile =>
    errorCase env c source expected wantInterp wantCheck wantCompile
  CCheck source expectPass expectedErr => checkCase env c source expectPass expectedErr
  CLint source expected => lintCase env c source expected
  CFix source expected => fixCase env c source expected
  CRuntime source expected exitCode => runtimeCase env c source expected exitCode
  CSeed source expected => seedCase env c source expected
  CSteps path => stepsCase env c path
  CBroken msg => do
    start <- effTimeUs
    finishCase c.caseId start [Assertion "case" False msg]

-- ---------------------------------------------------------------
-- 过滤
-- ---------------------------------------------------------------
allDigits : String -> Bool
allDigits s = s /= "" && allDigitChars (strUnpack s)

allDigitChars : List Int -> Bool
allDigitChars [] = True
allDigitChars (c :: rest) = c >= 48 && c <= 57 && allDigitChars rest

matchPattern : String -> Case -> Bool
matchPattern pat c =
  if allDigits pat then c.caseSection == pat || startsWith "${pat}/" c.caseId
  else contains pat "${c.caseSection} ${c.caseId} ${join " " c.caseTags}"

matchAny : List String -> Case -> Bool
matchAny [] c = False
matchAny (pat :: rest) c = if matchPattern pat c then True else matchAny rest c

caseMatches : SuiteOpts -> Case -> Bool
caseMatches opts c =
  let
    onlyOk = case opts.suiteOnly of
      [] => True
      pats => matchAny pats c
    filterOk = case opts.suiteFilter of
      [] => True
      pats => matchAny pats c
    tierOk = case opts.suiteTiers of
      [] => True
      tiers => memName c.caseTier tiers
  in onlyOk && filterOk && tierOk

filterCases : SuiteOpts -> List Case -> List Case
filterCases opts cases = filter (caseMatches opts) cases

-- ---------------------------------------------------------------
-- 打印与汇总
-- ---------------------------------------------------------------
-- D25：`@vuna@prim_eff_print` 返回 `Int` 字节数；`Nat` 归一化只在 Eff handler 的 result 族。
-- 工具链这里按 Int 使用（丢弃/比较都按 Int）。
printLine : String -> Eff hostRow Int
printLine s = @vuna@prim_eff_print "${s}\n"

statusLine : Bool -> CaseResult -> String
statusLine verbose r =
  let
    tag = if r.resStatus == "fail" then "FAIL" else "ok  "
    timing =
      if r.resStatus == "cached" then " (cached)"
      else if verbose then " (${strOfInt r.resMs}ms)" else ""
  in "${tag} ${r.resId}${timing}"

printMessages : List String -> Eff hostRow Int
printMessages [] = pure 0
printMessages (m :: rest) = do
  _ <- printLine "  ${m}"
  printMessages rest

printResult : Bool -> CaseResult -> Eff hostRow Int
printResult verbose r = do
  _ <- printLine (statusLine verbose r)
  printMessages r.resMessages

resChecksOf : CaseResult -> Int
resChecksOf r = r.resChecks

resFailOf : CaseResult -> Int
resFailOf r = r.resFail

isFailed : CaseResult -> Bool
isFailed r = r.resStatus == "fail"

isSkipped : CaseResult -> Bool
isSkipped r = r.resStatus == "skip"

summarize : List CaseResult -> String
summarize results =
  let
    checks = sumInts (map resChecksOf results)
    failed = sumInts (map resFailOf results)
    bad = filter isFailed results
    badCases = listLength bad
  in if failed == 0 && badCases == 0 then "vuna tests passed (${strOfInt checks} checks)"
  else "${strOfInt checks} checks, ${strOfInt badCases} failed case(s): ${join ", " (map resIdOf bad)}"

printCompiler : Env -> Eff hostRow Int
printCompiler env = do
  fp <- toolCompilerFingerprint
  printLine "compiler: ${env.envVuna} (fingerprint ${strOfInt fp})"

-- ---------------------------------------------------------------
-- 顺序执行 + worker
-- ---------------------------------------------------------------
writeResultFile : String -> Int -> CaseResult -> Eff hostRow Int
writeResultFile dir index r =
  let
    path = "${dir}/${strOfInt index}.tsv"
    line =
      "${r.resId}\t${r.resStatus}\t${strOfInt r.resPass}\t${strOfInt r.resFail}\t${strOfInt r.resChecks}\t${strOfInt r.resMs}\n"
  in raiseToRow hostRow (@vuna@prim_eff_writeFile path line)

runCasesIndexed : Env -> Bool -> Bool -> Bool -> String -> List (Pair Int Case) -> Eff hostRow (List CaseResult)
runCasesIndexed env verbose failFast quiet resultsDir indexed =
  runCasesIndexedGo env verbose failFast quiet resultsDir indexed [] False

runCasesIndexedGo : Env -> Bool -> Bool -> Bool -> String -> List (Pair Int Case) -> List CaseResult -> Bool -> Eff hostRow (List CaseResult)
runCasesIndexedGo env verbose failFast quiet resultsDir [] acc stopped = pure (reverse acc)
runCasesIndexedGo env verbose failFast quiet resultsDir ((Pair index c) :: rest) acc stopped = if stopped then do
  skip <- pure (CaseResult c.caseId "skip" 0 0 0 0 [])
  _ <- writeResultFile resultsDir index skip
  runCasesIndexedGo env verbose failFast quiet resultsDir rest (skip :: acc) True
else do
  r <- runCase env c
  _ <- writeResultFile resultsDir index r
  _ <- if quiet then pure 0 else printResult verbose r
  runCasesIndexedGo env verbose failFast quiet resultsDir rest (r :: acc)
    (failFast && r.resStatus == "fail")

not : Bool -> Bool
not True = False
not False = True

-- ---------------------------------------------------------------
-- LPT 调度（仅用于非 e2e tier）
--
-- e2e 的冷隔离长 case 对顺序敏感，仍按发现顺序；gate（fast/integration）用历史
-- `.local/test-suite/costs.tsv` 做 LPT 分桶：重 case 优先放到当前负载最小的 worker。
-- worker 各自读同一份 costs，确定性地算出同一组 bins，再取自己的 bin。
-- ---------------------------------------------------------------
costsPath : Env -> String
costsPath env = "${env.envRoot}/.local/test-suite/costs.tsv"

loadCosts : Env -> Eff hostRow (List (Pair String Int))
loadCosts env = do
  exists <- pathExistsFile (costsPath env)
  if not exists then pure []
  else do
    text <- raiseToRow hostRow (@vuna@prim_eff_readFile (costsPath env))
    pure (mapMaybe parseCostLine (lines text))

parseCostLine : String -> Maybe (Pair String Int)
parseCostLine line = case split "\t" line of
  id :: ms :: _ => Just (Pair id (fromMaybe 100 (parseLeadingInt ms)))
  _ => Nothing

caseCost : List (Pair String Int) -> Case -> Int
caseCost costs c = case lookupPair c.caseId costs of
  Just ms => if ms > 0 then ms else defaultCost c
  Nothing => defaultCost c

defaultCost : Case -> Int
defaultCost c = case c.caseKind of
  CSteps _ => 1500
  CSeed _ _ => 800
  CRuntime _ _ _ => 500
  CGolden _ _ _ _ _ _ _ => 300
  CError _ _ _ _ _ => 300
  _ => 100

useLpt : SuiteOpts -> Bool
useLpt opts = case opts.suiteTiers of
  [] => False
  tiers => not (memName "e2e" tiers)

emptyBin : Pair (List (Pair Int Case)) Int
emptyBin = Pair [] 0

repeatN : Int -> Pair (List (Pair Int Case)) Int -> List (Pair (List (Pair Int Case)) Int)
repeatN n x = if n <= 0 then [] else x :: repeatN (n - 1) x

sortWeighted : List (Pair Int (Pair Int Case)) -> List (Pair Int (Pair Int Case))
sortWeighted [] = []
sortWeighted (x :: rest) = insertWeighted x (sortWeighted rest)

insertWeighted : Pair Int (Pair Int Case) -> List (Pair Int (Pair Int Case)) -> List (Pair Int (Pair Int Case))
insertWeighted x [] = [x]
insertWeighted x ((Pair w p) :: rest) =
  if firstOf x >= w then x :: Pair w p :: rest else Pair w p :: insertWeighted x rest

lptBins : Env -> Int -> List (Pair Int Case) -> Eff hostRow (List (List (Pair Int Case)))
lptBins env jobs indexed = do
  costs <- loadCosts env
  let
    weighted = map (\p => Pair (caseCost costs (secondOf p)) p) indexed
    sorted = sortWeighted weighted
    bins = assignAll sorted (repeatN jobs emptyBin)
  in pure (map (\b => firstOf b) bins)

assignAll : List (Pair Int (Pair Int Case)) -> List (Pair (List (Pair Int Case)) Int) -> List (Pair (List (Pair Int Case)) Int)
assignAll [] bins = bins
assignAll (w :: rest) bins =
  let
    loads = map (\b => secondOf b) bins
    idx = lightestIndex loads
    bins2 = addAtBin idx w bins
  in assignAll rest bins2

lightestIndex : List Int -> Int
lightestIndex loads = lightestGo loads 0 0 999999999

lightestGo : List Int -> Int -> Int -> Int -> Int
lightestGo [] _ best _ = best
lightestGo (n :: rest) i best bestLoad =
  if n < bestLoad then lightestGo rest (i + 1) i n else lightestGo rest (i + 1) best bestLoad

addAtBin : Int -> Pair Int (Pair Int Case) -> List (Pair (List (Pair Int Case)) Int) -> List (Pair (List (Pair Int Case)) Int)
addAtBin idx w bins = addAtBinGo idx 0 w bins

addAtBinGo : Int -> Int -> Pair Int (Pair Int Case) -> List (Pair (List (Pair Int Case)) Int) -> List (Pair (List (Pair Int Case)) Int)
addAtBinGo _ _ _ [] = []
addAtBinGo idx i w ((Pair items load) :: rest) =
  if i == idx then Pair (secondOf w :: items) (load + firstOf w) :: rest
  else Pair items load :: addAtBinGo idx (i + 1) w rest

nthBin : Int -> List (List (Pair Int Case)) -> List (Pair Int Case)
nthBin _ [] = []
nthBin n (b :: rest) = if n <= 0 then b else nthBin (n - 1) rest

costRowText : CaseResult -> String
costRowText r = "${r.resId}\t${strOfInt r.resMs}"

isCostRow : CaseResult -> Bool
isCostRow r = r.resStatus /= "cached" && r.resMs > 0

recordCosts : Env -> List CaseResult -> Eff hostRow Int
recordCosts env results =
  let
    rows = filter isCostRow results
    text = join "\n" (map costRowText rows)
  in if listLength rows == 0 then pure 0
  else do
    _ <- ensureDirPath "${env.envRoot}/.local/test-suite"
    raiseToRow hostRow (@vuna@prim_eff_writeFile (costsPath env) text)

runWorker : Env -> SuiteOpts -> List Case -> Int -> Int -> Eff hostRow Int
runWorker env opts cases index count = do
  indexed <- if useLpt opts then do
    bins <- lptBins env count (indexAll cases 0 [])
    pure (nthBin index bins)
  else pure (indexedCases cases index count)
  let
    resultsDir = case opts.suiteResultsDir of
      Just d => d
      Nothing => "${env.envTmp}/results"
  in do
    _ <- ensureDirPath resultsDir
    results <-
      runCasesIndexed env opts.suiteVerbose opts.suiteFailFast opts.suiteQuiet resultsDir indexed
    pure (if listLength (filter isFailed results) == 0 then 0 else 1)

-- ---------------------------------------------------------------
-- jobs
-- ---------------------------------------------------------------
detectJobs : Env -> Eff hostRow Int
detectJobs env = do
  override <- envVar "VUNA_TEST_JOBS"
  if override /= "" then pure (positiveOrOne (parseLeadingInt override))
  else do
    r <- runCmd env "jobs-probe" "." 10 ["nproc"]
    pure (positiveOrOne (parseLeadingInt (trim r.cmdOut)))

-- 探测结果 -> 并发数：缺失/非正数一律回落 1（与旧行为一致）。
positiveOrOne : Maybe Int -> Int
positiveOrOne Nothing = 1
positiveOrOne (Just n) = if n > 0 then n else 1

resolveJobs : Env -> SuiteOpts -> Eff hostRow Int
resolveJobs env opts = if opts.suiteJobs == 0 then detectJobs env else pure opts.suiteJobs

-- ---------------------------------------------------------------
-- 父进程
-- ---------------------------------------------------------------
waitPids : List Int -> Eff hostRow Int
waitPids [] = pure 0
waitPids (pid :: rest) = do
  code <- raiseToRow hostRow (@vuna@prim_eff_wait pid)
  last <- waitPids rest
  pure (if code /= 0 then 1 else last)

spawnWorkers : Env -> SuiteOpts -> String -> Int -> Int -> Int -> List Int -> Eff hostRow (List Int)
spawnWorkers env opts resultsDir jobs fuel index pids = if fuel <= 0 then pure (reverse pids)
else if index >= jobs then pure (reverse pids)
else
  let
    workerArg = "${strOfInt index}/${strOfInt jobs}"
    filters =
      append (concatMap (\p => ["--only", p]) opts.suiteOnly)
        (append (concatMap (\p => ["--filter", p]) opts.suiteFilter) (concatMap (\p => ["--tier", p]) opts.suiteTiers))
    cacheArgs = case opts.suiteCacheDir of
      Just dir => ["--cache-dir", dir]
      Nothing => []
    changedArgs = case opts.suiteChanged of
      Just rev => ["--changed", rev]
      Nothing => []
    flagArgs =
      append (if opts.suiteFailFast then ["--fail-fast"] else [])
        (append (if opts.suiteJSON then ["--quiet"] else []) (append (if opts.suiteNoCache then ["--no-cache"] else []) (append (if opts.suiteLastFailed then ["--last-failed"] else []) (append (if opts.suiteBless then ["--bless"] else []) (append (if opts.suiteBlessDiag then ["--bless-diag"] else []) (append cacheArgs changedArgs))))))
    args =
      append ["test", "--suite", opts.suitePath, "--worker", workerArg, "--results-dir", resultsDir]
        (append filters flagArgs)
  in do
    pid <- raiseToRow hostRow (@vuna@prim_eff_spawn args)
    spawnWorkers env opts resultsDir jobs (fuel - 1) (index + 1) (pid :: pids)

readResultFile : String -> Int -> Eff hostRow (Maybe CaseResult)
readResultFile dir index =
  let
    path = "${dir}/${strOfInt index}.tsv"
  in do
    exists <- pathExistsFile path
    if not exists then pure Nothing
    else do
      text <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
      pure (case split "\t" (trimNewlines text) of
        [id, status, pass, fail, checks, ms] =>
          Just
            (CaseResult id status (fromMaybe 0 (parseLeadingInt pass)) (fromMaybe 0 (parseLeadingInt fail)) (fromMaybe 0 (parseLeadingInt checks)) (fromMaybe 0 (parseLeadingInt ms)) [])
        _ => Nothing
      )

collectResults : String -> Int -> List (Pair Int Case) -> Eff hostRow (List CaseResult)
collectResults dir count indexed = collectResultsGo (count + 1) dir count 0 indexed []

-- 缺结果文件 ⇒ worker 没跑完/被杀（崩溃、OOM、超时被外层杀），不是 case 断言失败。
-- 用 index → case id 还原真实用例名；旧行为只报 `unknown-<index>`，线上失败完全无法定位。
caseIdAt : Int -> List (Pair Int Case) -> String
caseIdAt i [] = "unknown-${strOfInt i}"
caseIdAt i ((Pair j c) :: rest) = if j == i then c.caseId else caseIdAt i rest

collectResultsGo : Int -> String -> Int -> Int -> List (Pair Int Case) -> List CaseResult -> Eff hostRow (List CaseResult)
collectResultsGo fuel dir count index indexed acc = if fuel <= 0 then pure (reverse acc)
else if index >= count then pure (reverse acc)
else do
  found <- readResultFile dir index
  case found of
    Just r => collectResultsGo (fuel - 1) dir count (index + 1) indexed (r :: acc)
    Nothing =>
      collectResultsGo (fuel - 1) dir count (index + 1) indexed
        (CaseResult "${caseIdAt index indexed} (no result)" "fail" 0 1 0 0 [] :: acc)

printJSON : List CaseResult -> Eff hostRow Int
printJSON results =
  let
    cases = map resultJson results
    doc =
      JObj
        [Pair "suite" (JStr "vuna"), Pair "total" (JNum (listLength results)), Pair "failed" (JNum (listLength (filter isFailed results))), Pair "checks" (JNum (sumInts (map resChecksOf results))), Pair "cases" (JArr cases)]
  in printLine (renderJson doc)

resultJson : CaseResult -> Json
resultJson r =
  JObj
    [Pair "id" (JStr r.resId), Pair "status" (JStr r.resStatus), Pair "pass" (JNum r.resPass), Pair "fail" (JNum r.resFail), Pair "checks" (JNum r.resChecks), Pair "ms" (JNum r.resMs)]

finishResults : Env -> SuiteOpts -> List CaseResult -> Eff hostRow Int
finishResults env opts results =
  let
    bad = listLength (filter isFailed results)
    skipped = listLength (filter isSkipped results)
    strictBad = if opts.suiteStrictSkips then skipped else 0
  in do
    _ <-
      if strictBad > 0 then printLine "strict-skips: ${strOfInt skipped} skipped case(s)"
      else pure 0
    _ <- recordCosts env results
    _ <- recordLastFailed env results
    _ <- if opts.suiteTimings then printTimings results else pure 0
    _ <- if opts.suiteJSON then printJSON results else printLine (summarize results)
    pure (if bad + strictBad == 0 then 0 else 1)

runParent : Env -> SuiteOpts -> Suite -> List Case -> Eff hostRow Int
runParent env opts suite cases = do
  jobs <- resolveJobs env opts
  let
    n = listLength cases
    effective = if jobs > n then if n <= 0 then 1 else n else jobs
    indexed = indexAll cases 0 []
    resultsDir = case opts.suiteResultsDir of
      Just d => d
      Nothing => "${env.envTmp}/results"
  in case effective <= 1 of
    True => do
      _ <- ensureDirPath resultsDir
      results <-
        runCasesIndexed env opts.suiteVerbose opts.suiteFailFast opts.suiteJSON resultsDir indexed
      finishResults env opts results
    False => do
      _ <- ensureDirPath resultsDir
      pids <- spawnWorkers env opts resultsDir effective (effective + 1) 0 []
      _ <- waitPids pids
      results <- collectResults resultsDir n indexed
      finishResults env opts results

indexAll : List Case -> Int -> List (Pair Int Case) -> List (Pair Int Case)
indexAll [] i acc = reverse acc
indexAll (c :: rest) i acc = indexAll rest (i + 1) (Pair i c :: acc)

-- ---------------------------------------------------------------
-- list
-- ---------------------------------------------------------------
insertByMs : CaseResult -> List CaseResult -> List CaseResult
insertByMs r [] = [r]
insertByMs r (x :: rest) = if r.resMs > x.resMs then r :: x :: rest else x :: insertByMs r rest

sortByMs : List CaseResult -> List CaseResult
sortByMs [] = []
sortByMs (r :: rest) = insertByMs r (sortByMs rest)

printTimingsGo : Int -> List CaseResult -> Eff hostRow Int
printTimingsGo n [] = pure 0
printTimingsGo n (r :: rest) = if n <= 0 then pure 0
else do
  _ <- printLine "timing ${strOfInt r.resMs}ms ${r.resId}"
  printTimingsGo (n - 1) rest

printTimings : List CaseResult -> Eff hostRow Int
printTimings results = printTimingsGo 10 (sortByMs results)

printList : List Case -> Eff hostRow Int
printList cases = printListGo cases

printListGo : List Case -> Eff hostRow Int
printListGo [] = pure 0
printListGo (c :: rest) = do
  _ <- printCase c
  printListGo rest

printCase : Case -> Eff hostRow Int
printCase c = printLine c.caseId

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
-- ---------------------------------------------------------------
-- --changed
-- ---------------------------------------------------------------
stripRoot : Env -> String -> String
stripRoot env path =
  let
    prefix = "${env.envRoot}/"
  in if startsWith prefix path then substring (byteLength prefix) (byteLength path - byteLength prefix) path
  else path

changedPaths : Env -> String -> Eff hostRow (Maybe (List String))
changedPaths env rev = do
  r <- runCmd env "git-diff" env.envRoot 60 ["git", "diff", "--name-only", rev]
  pure (if r.cmdCode == 0 then Just (filter (\line => line /= "") (lines r.cmdOut)) else Nothing)

isGlobalChange : String -> Bool
isGlobalChange path =
  startsWith "compiler/" path
    || startsWith "base/" path
    || startsWith "lib/" path
    || startsWith "app/" path
    || path == "vuna.toml"
    || startsWith "test/suite" path
    || path == "test/suite.toml"

takeFirstSegments : Int -> String -> String
takeFirstSegments n s = collectSegments n (split "/" s) ""

collectSegments : Int -> List String -> String -> String
collectSegments n [] acc = acc
collectSegments n (seg :: rest) acc =
  if n <= 0 then acc
  else if n == 1 then "${acc}${seg}/"
  else if acc == "" then collectSegments (n - 1) rest "${seg}/"
  else collectSegments (n - 1) rest "${acc}${seg}/"

corpusDirPrefix : String -> String
corpusDirPrefix rel = if startsWith "test/corpus/" rel then takeFirstSegments 3 rel else rel

pathTouches : String -> String -> Bool
pathTouches changed rel = changed == rel || startsWith changed rel || startsWith rel changed

casePaths : Env -> Case -> List String
casePaths env c = case c.caseKind of
  CGolden source expected _ _ _ _ _ => [stripRoot env source, stripRoot env expected]
  CError source expected _ _ _ => [stripRoot env source, stripRoot env expected]
  CCheck source _ expectedErr =>
    if expectedErr == "" then [stripRoot env source]
    else [stripRoot env source, stripRoot env expectedErr]
  CLint source expected => [stripRoot env source, stripRoot env expected]
  CFix source expected => [stripRoot env source, stripRoot env expected]
  CRuntime source expected _ => [stripRoot env source, stripRoot env expected]
  CSeed source expected => [stripRoot env source, stripRoot env expected]
  CSteps path => [stripRoot env path]
  CBroken _ => []

-- 章节/步骤文件的文本认领：夹具变更时，文件里提到该 corpus 目录就算“相关”。
claimTextTouches : Env -> String -> List String -> Eff hostRow Bool
claimTextTouches env path changed = do
  text <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
  let
    corpusChanges = filter (\p => startsWith "test/corpus/" p) changed
  in pure
    (any (\p => contains (corpusDirPrefix p) text) corpusChanges || any (\p => contains (stripRoot env path) p) changed)

caseAffected : Env -> List String -> Case -> Eff hostRow Bool
caseAffected env changed c = if any isGlobalChange changed then pure True
else case c.caseKind of
  CSteps path => claimTextTouches env path changed
  _ =>
    let
      paths = casePaths env c
    in pure (any (\rel => any (\p => pathTouches p rel) changed) paths)

any : (a -> Bool) -> List a -> Bool
any pred [] = False
any pred (x :: rest) = if pred x then True else any pred rest

changedFilter : Env -> String -> List Case -> Eff hostRow (List Case)
changedFilter env rev cases = do
  changed <- changedPaths env rev
  case changed of
    Nothing => pure cases
    Just [] => pure []
    Just flags => filterEff (caseAffected env flags) cases

listSuite : Env -> List Case -> Eff hostRow Int
listSuite env cases = do
  _ <- printCompiler env
  printList cases

-- ---------------------------------------------------------------
-- --audit / --watch
-- ---------------------------------------------------------------
stripTestPrefix : String -> String
stripTestPrefix rel = if startsWith "test/" rel then substring 5 (byteLength rel - 5) rel else rel

caseRoots : Env -> Case -> List String
caseRoots env c = map rootOfPath (casePaths env c)

rootOfPath : String -> String
rootOfPath path =
  if endsWith "/app/Main.vuna" path then "${Vuna.Cli.Args.parentOf (Vuna.Cli.Args.parentOf path)}/"
  else path

claimTextPairs : List Case -> Eff hostRow (List (Pair String String))
claimTextPairs [] = pure []
claimTextPairs (c :: rest) = case c.caseKind of
  CSteps path => do
    text <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
    more <- claimTextPairs rest
    pure (Pair path text :: more)
  _ => claimTextPairs rest

anyText : List (Pair String String) -> String -> Bool
anyText [] rel = False
anyText ((Pair _ text) :: rest) rel =
  if contains (stripTestPrefix rel) text || contains (stripTestPrefix (corpusDirPrefix rel)) text then True
  else anyText rest rel

auditClaimed : Env -> List Case -> List (Pair String String) -> String -> Bool
auditClaimed env cases texts rel =
  any (\c => any (\root => root == rel || startsWith root rel) (caseRoots env c)) cases
    || anyText texts rel

printOrphans : List String -> Eff hostRow Int
printOrphans [] = pure 0
printOrphans (rel :: rest) = do
  _ <- printLine "orphan ${rel}"
  printOrphans rest

auditPathIgnored : String -> Bool
auditPathIgnored path = contains "/test/corpus/codegen/" path

-- 全量 corpus 里没有被任何 case / section 脚本认领的夹具。family 配置漏掉一整族
-- （或期望文件改错名）时 suite 会「少跑 case 却依然全绿」——这个结果是默认护栏的
-- 输入，不依赖 `--audit` 手动开关。
auditOrphans : Suite -> Eff hostRow (List String)
auditOrphans suite =
  let
    root = suite.suiteRoot
  in do
    allFixtures <- collectVunaFiles "${root}/test/corpus"
    ref <- newRef (sessionNew "/tmp/iface-session")
    cases <- discoverCases suite
    texts <- claimTextPairs cases
    let
      env =
        Env root "${root}/test" "/tmp" "" "" "${root}/base" "ocamlopt" "" "" False 0 False False
          False "/tmp/vuna-store" "/tmp/vuna-build" ref
      fixtures = filter (\path => not (auditPathIgnored path)) allFixtures
    in pure (filter (\path => not (auditClaimed env cases texts (stripRoot env path))) fixtures)

takeFirst : Int -> List a -> List a
takeFirst n xs = if n <= 0 then []
else case xs of
  [] => []
  x :: rest => x :: takeFirst (n - 1) rest

-- family 声明的目录里应该被 case 认领的夹具（rel 路径）。文件型 = 顶层
-- `*.vuna`（跳过 `_` 辅助模块）；目录型 = 每个子目录的 entry。section 专属目录
-- （dt_pkg / dt_ad_hoc 等）不在 family 里，不参与精确审计。
isFixtureFile : String -> Bool
isFixtureFile name = endsWith ".vuna" name && not (startsWith "_" name)

fixtureTopOf : String -> String -> List String
fixtureTopOf familyDir name = ["${familyDir}/${name}"]

fixtureEntryOf : String -> String -> String -> String -> Eff hostRow (List String)
fixtureEntryOf dir familyDir entry name = do
  exists <- pathExistsFile "${dir}/${name}/${entry}"
  pure (if exists then ["${familyDir}/${name}/${entry}"] else [])

familyFixtures : String -> Family -> Eff hostRow (List String)
familyFixtures root family =
  let
    dir = "${root}/${family.familyDir}"
  in do
    exists <- pathExistsDir dir
    if not exists then pure []
    else do
      names <- raiseToRow hostRow (@vuna@prim_eff_readDir dir)
      case family.familyEntry of
        Just entry => concatMapEff (fixtureEntryOf dir family.familyDir entry) names
        Nothing => pure (concatMap (fixtureTopOf family.familyDir) (filter isFixtureFile names))

noSectionTexts : List (Pair String String)
noSectionTexts = []

familyOrphan : Env -> List Case -> String -> Bool
familyOrphan env cases rel = not (auditClaimed env cases noSectionTexts rel)

-- 精确护栏：不用 section 脚本文本做模糊认领（旧 audit 只要脚本里提到目录名就
-- 算认领，整个 family 从 suite.toml 消失时也报 0 orphan）。
familyOrphans : Suite -> Eff hostRow (List String)
familyOrphans suite =
  let
    root = suite.suiteRoot
  in do
    ref <- newRef (sessionNew "/tmp/iface-session")
    cases <- discoverCases suite
    fixtures <- concatMapEff (familyFixtures root) suite.suiteFamilies
    let
      env =
        Env root "${root}/test" "/tmp" "" "" "${root}/base" "ocamlopt" "" "" False 0 False False
          False "/tmp/vuna-store" "/tmp/vuna-build" ref
    in pure (filter (familyOrphan env cases) fixtures)

commaJoin : List String -> String
commaJoin xs = join ", " xs

-- 孤儿存在 ⇒ 注入一个显式失败 case（worker 分片会把它派给某一个 worker 跑一次）。
auditCases : List String -> List Case
auditCases [] = []
auditCases paths =
  [ Case "audit/orphans" "audit" ["audit"] (CBroken "${strOfInt (listLength paths)} orphan fixture(s): ${commaJoin (takeFirst 12 paths)}") 0 "e2e"
  ]

auditSuite : SuiteOpts -> Suite -> Eff hostRow Int
auditSuite opts suite = do
  unclaimed <- auditOrphans suite
  _ <- printOrphans unclaimed
  _ <- printLine "audit: ${strOfInt (listLength unclaimed)} orphan fixture(s)"
  pure (case unclaimed of
    [] => 0
    _ => 1
  )

maxMtime : Int -> List String -> Eff hostRow Int
maxMtime acc [] = pure acc
maxMtime acc (path :: rest) = do
  m <- raiseToRow hostRow (@vuna@prim_eff_fileMtime path)
  maxMtime (if m > acc then m else acc) rest

watchSnapshot : String -> Eff hostRow Int
watchSnapshot root = do
  corpusFiles <- collectSourceFiles "${root}/test/corpus"
  suiteFiles <- collectSourceFiles "${root}/test/suite"
  libFiles <- collectSourceFiles "${root}/lib"
  compilerFiles <- collectSourceFiles "${root}/compiler"
  appFiles <- collectSourceFiles "${root}/app"
  baseFiles <- collectSourceFiles "${root}/base"
  extra <- filterEff pathExistsFile ["${root}/test/suite.toml", "${root}/vuna.toml"]
  maxMtime 0
    (append corpusFiles (append suiteFiles (append libFiles (append compilerFiles (append appFiles (append baseFiles extra))))))

watchLoop : Int -> SuiteOpts -> Suite -> Int -> Int -> Eff hostRow Int
watchLoop fuel opts suite last rc = if fuel <= 0 then pure rc
else do
  _ <- raiseToRow hostRow (@vuna@prim_eff_sleep 500000)
  now <- watchSnapshot suite.suiteRoot
  if now /= last then do
    _ <- printLine "watch: change detected, rerunning"
    rc2 <- runSuiteOnce opts suite
    watchLoop (fuel - 1) opts suite now rc2
  else watchLoop (fuel - 1) opts suite last rc

watchSuite : SuiteOpts -> Suite -> Eff hostRow Int
watchSuite opts suite = do
  rc <- runSuiteOnce opts suite
  snapshot <- watchSnapshot suite.suiteRoot
  watchLoop 100000000 opts suite snapshot rc

export runSuite : SuiteOpts -> Suite -> Eff hostRow Int
runSuite opts suite =
  if opts.suiteAudit then auditSuite opts suite
  else if opts.suiteWatch then watchSuite opts suite else runSuiteOnce opts suite

runSuiteOnce : SuiteOpts -> Suite -> Eff hostRow Int
runSuiteOnce opts suite =
  let
    root = suite.suiteRoot
    tag = case opts.suiteWorker of
      Just (Pair i _) => "suite-w${strOfInt i}"
      Nothing => "suite"
    cacheDir = case opts.suiteCacheDir of
      Just dir => if startsWith "/" dir then dir else "${root}/${dir}"
      Nothing => "${root}/.local/test-cache"
    scope = case opts.suiteWorker of
      Just (Pair i _) => "w${strOfInt i}"
      Nothing => "single"
    workerMode = case opts.suiteWorker of
      Just _ => True
      Nothing => False
  in do
    tmp <- makeTempRoot tag
    helper <- writeHelper tmp
    baseDir <- envOr "VUNA_BASE" "${root}/base"
    baseHash <- hashTree baseDir
    cacheExists <- pathExistsDir cacheDir
    _ <- if cacheExists then pure 0 else ensureDirPath cacheDir
    -- 对象库根：父进程解析一次，worker/case 全部继承（不再每个 worker/case 新建）。
    -- 默认由 devShell / nix run 包装 / CI 导出 `VUNA_STORE`；未设置时按 Store 的
    -- `$XDG_DATA_HOME` / `~/.vuna/store` / `$TMPDIR/vuna-store` 回落。
    store <- storeRootReadyEff
    vuna <- raiseToRow hostRow @vuna@prim_eff_execPath
    vunaSeed <- envOr "VUNA_SEED" "vuna-seed"
    ocamlopt <- envOr "OCAMLOPT" "ocamlopt"
    -- 跨 run 的构建桶：base 的 .cmx 只编译一次，后续 run 直接命中 stamp。
    buildFp <- toolCompilerFingerprint
    buildDir <- pure "${cacheDir}/build/${scope}-${strOfInt buildFp}-${strOfInt baseHash}"
    ref <- newRef (sessionNew "${tmp}/iface-session")
    discovered <- discoverCases suite
    orphans <- familyOrphans suite
    let
      env =
        Env root "${root}/test" tmp vuna vunaSeed baseDir ocamlopt helper cacheDir
          (not opts.suiteNoCache && not opts.suiteBless && not opts.suiteBlessDiag) baseHash
          opts.suiteBless opts.suiteBlessDiag workerMode store buildDir ref
      -- 两层默认护栏（局部 --only/--filter 时被过滤掉，符合预期）：
      --   ① 已声明 family 目录里的孤儿夹具（精确 source 认领）；
      --   ② case 总数下限——整族从 suite.toml 消失时，①会连目录一起看不到。
      minCase =
        if suite.suiteMinCases > 0 && listLength discovered < suite.suiteMinCases then [ Case "audit/min-cases" "audit" ["audit"] (CBroken "only ${strOfInt (listLength discovered)} case(s) discovered, suite.toml requires >= ${strOfInt suite.suiteMinCases}") 0 "e2e"
        ]
        else []
      cases0 = filterCases opts (append (append discovered (auditCases orphans)) minCase)
    in do
      -- 预热依赖接口（仅父进程、仅真正跑 case 时）：共享 store 只需预热一次；
      -- worker 直接复用父进程写下的接口/对象。
      _ <- if opts.suiteListOnly then pure 0 else if workerMode then pure 0 else warmIfaces env
      cases1 <- case opts.suiteChanged of
        Just rev => changedFilter env rev cases0
        Nothing => pure cases0
      cases <- if opts.suiteLastFailed then filterLastFailed env cases1 else pure cases1
      result <- if opts.suiteListOnly then listSuite env cases
      else case opts.suiteWorker of
        Just (Pair index count) => runWorker env opts cases index count
        Nothing => runParent env opts suite cases
      _ <- raiseToRow hostRow (@vuna@prim_eff_runIn "/" ["rm", "-rf", tmp])
      pure result

-- 给每个 case 配全局下标：`zip cases [0..n-1]`，再按 worker index 过滤。
rangeUp : Int -> Int -> List Int
rangeUp fuel start = if fuel <= 0 then [] else start :: rangeUp (fuel - 1) (start + 1)

indexedCases : List Case -> Int -> Int -> List (Pair Int Case)
indexedCases cases index count =
  filter (matchesIndex index count) (zip (rangeUp (listLength cases) 0) cases)

-- 全局下标 i 属于 worker index：i mod count == index。
matchesIndex : Int -> Int -> Pair Int Case -> Bool
matchesIndex index count (Pair i _) = if count <= 0 then False else i - i / count * count == index

-- 把绝对源码路径转成相对 cwd 的路径（.diag.json 不写机器相关前缀）。
relativeTo : String -> String -> String
relativeTo base path =
  if startsWith "${base}/" path then substring (natFromInt (strLength base + 1)) (natFromInt (strLength path - strLength base - 1))
    path
  else path

-- 文本替换（诊断 JSON 归一化用；Base.String 没有 replace）。
replaceAllText : String -> String -> String -> String
replaceAllText needle replacement haystack =
  let
    chars = strUnpack haystack
  in strPack (reverse (replaceAllGo needle replacement chars [] chars))

replaceAllGo : String -> String -> List Int -> List Int -> List Int -> List Int
replaceAllGo needle replacement rest acc [] = acc
replaceAllGo needle replacement rest acc (_ :: fs) = replaceStep needle replacement rest acc fs

replaceStep : String -> String -> List Int -> List Int -> List Int -> List Int
replaceStep needle replacement [] acc fs = acc
replaceStep needle replacement (c :: cs) acc fs =
  if prefixOfInts (strUnpack needle) (c :: cs) then replaceAllGo needle replacement (dropNInts (length (strUnpack needle)) (c :: cs))
    (append (reverse (strUnpack replacement)) acc) fs
  else replaceAllGo needle replacement cs (c :: acc) fs

prefixOfInts : List Int -> List Int -> Bool
prefixOfInts [] _ = True
prefixOfInts _ [] = False
prefixOfInts (a :: xs) (b :: ys) = if a == b then prefixOfInts xs ys else False

dropNInts : Int -> List Int -> List Int
dropNInts n xs = if n <= 0 then xs
else case xs of
  [] => []
  _ :: rest => dropNInts (n - 1) rest

-- 诊断 JSON 里的环境路径归一化（本地工作树 vs nix 构建目录）。
normalizeDiagText : Env -> String -> String
normalizeDiagText env text =
  let
    t1 = replaceAllText env.envBase "<BASE>" text
  in replaceAllText env.envRoot "<ROOT>" t1

-- 含 `.package-dir` 标记的目录型夹具：以包根为 cwd 跑 `vuna check .`。
pkgRootOf : String -> Int -> Eff hostRow String
pkgRootOf dir fuel = if fuel <= 0 then pure ""
else do
  exists <- pathExistsFile "${dir}/.package-dir"
  if exists then pure dir else pkgRootOf (Vuna.Cli.Args.parentOf dir) (fuel - 1)
