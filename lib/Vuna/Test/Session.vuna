module Vuna.Test.Session where

-- Vuna.Test.Session：测试 runner 的**进程内精化会话**（每个 worker 进程一个）。
--
-- 背景：进程内 check/interp 若每次都对整棵 base 闭包做全量精化，每个 case 要付
-- ~120ms 的重复工作（instheads + bodies + instbodies）。本模块把依赖包（base）的
-- 模块接口缓存进会话，用例只精化自己的入口，与 LSP 的诊断会话
-- （`Lsp/Diagnostics.buildSession`）同一条 `dtCheckSourceIncremental`。
--
-- 关键纪律：**会话只影响进程内的路径选择，绝不回退子进程**。
--   * 接口读不到 / `applied = False` ⇒ 返回 `Nothing`，调用方
--     （`Vuna.Test.InProc`）在同一进程内改走全量 `dtCheck` / `dtEvalFile`；
--   * 两条进程内路径都不可用 ⇒ 用例失败（`inprocess-unavailable`），
--     不再 spawn `vuna check`——那会把断言退回字符串匹配。
--
-- 返回值刻意**不用** `Maybe (Check a)`：该形状（把 `Check` 放进 `Maybe` 后由别的
-- 模块解构）会触发精化器的一条 `TC_UnknownConstructorInCase` 误报。这里改用普通
-- 记录 `CheckSample` / `EvalSample`，`Check` 的构造/解构只发生在 `Vuna.Test.InProc`。
import Base.HostRow
import Base.IORef
import Vuna.Compiler.Common
import Vuna.Compiler.Diag
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Iface
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Packages.Pkg

export record Session where
  sesRoot : String -- 接口镜像根（`${envTmp}/iface`；空 = 不镜像，读源码旁）
  sesDir : String -- 当前依赖接口的包目录（base 绝对路径；空 = 尚未建立）
  sesIfaces : List ModuleIface
  sesAux : Maybe AuxCache -- check 路径的 termAux 预处理缓存
  sesEvalAux : Maybe AuxCache -- interp 路径的缓存

export sessionNew : String -> Session
sessionNew ifaceRoot = Session ifaceRoot "" [] Nothing Nothing

-- check 结果样本：`csErr = Just e` 表示精化失败；否则 `csDiags` 是完整诊断表
-- （含 warning；`--json` 写进 `.diag.json` 的就是这一份）。
export record CheckSample where
  csErr : Maybe Diagnostic
  csDiags : List Diagnostic

-- interp 结果样本：`esErr = Just e` 表示精化失败；否则 `esText` 是求值展示文本。
export record EvalSample where
  esErr : Maybe Diagnostic
  esText : String

-- 字段投影 helper（绑定变量的记录字段访问需要显式类型）。
sesRootOf : Session -> String
sesRootOf s = s.sesRoot

sesDirOf : Session -> String
sesDirOf s = s.sesDir

sesIfacesOf : Session -> List ModuleIface
sesIfacesOf s = s.sesIfaces

sesAuxOf : Session -> Maybe AuxCache
sesAuxOf s = s.sesAux

sesEvalAuxOf : Session -> Maybe AuxCache
sesEvalAuxOf s = s.sesEvalAux

-- 用 base 目录自己的包上下文（`contextForDir`）：包身份、包环境、依赖图都从它的
-- manifest 推出，与 `vuna check <base>` 写侧完全同口径。
readBaseIfaces : String -> Eff hostRow (Maybe (List ModuleIface))
readBaseIfaces baseDir = do
  ctxR <- contextForDir baseDir
  case ctxR of
    ErrC _ => pure Nothing
    OkC ctx => ifacesForContextEff ctx

-- 会话可用性：命中缓存 → 直接用；否则读一次接口并写回（读失败/为空 ⇒ Nothing）。
ensureSession : IORef Session -> String -> Eff hostRow (Maybe (List ModuleIface))
ensureSession ref baseDir = do
  s <- readRef ref
  if sesDirOf s == baseDir && listLength (sesIfacesOf s) > 0 then pure (Just (sesIfacesOf s))
  else do
    ifacesR <- readBaseIfaces baseDir
    case ifacesR of
      Nothing => pure Nothing
      Just ifaces => if listLength ifaces == 0 then pure Nothing
      else do
        _ <- writeRef ref (Session (sesRootOf s) baseDir ifaces (sesAuxOf s) (sesEvalAuxOf s))
        pure (Just ifaces)

-- check：`Nothing` = 会话不可用（调用方改走全量）。
export sessionCheckSample : IORef Session -> String -> String -> Eff hostRow (Maybe CheckSample)
sessionCheckSample ref baseDir source = do
  ses <- ensureSession ref baseDir
  case ses of
    Nothing => pure Nothing
    Just ifaces => do
      ctxR <- contextForFile source
      case ctxR of
        ErrC e => pure (Just (CheckSample (Just e) []))
        OkC ctx => do
          text <- raiseToRow hostRow (@vuna@prim_eff_readFile source)
          s <- readRef ref
          result <- dtCheckSourceIncremental ctx source text ifaces [] (sesAuxOf s) False
          applyCheckResult ref s baseDir ifaces result

applyCheckResult : IORef Session -> Session -> String -> List ModuleIface -> Check (Pair Bool (Pair (List Diagnostic) (Pair (Maybe CheckedPackage) (Maybe AuxCache)))) -> Eff hostRow (Maybe CheckSample)
applyCheckResult ref s baseDir ifaces result = case result of
  ErrC e => pure (Just (CheckSample (Just e) []))
  OkC p => if not (firstOf p) then pure Nothing
  else do
    _ <-
      writeRef ref
        (Session (sesRootOf s) baseDir ifaces (secondOf (secondOf (secondOf p))) (sesEvalAuxOf s))
    pure (Just (CheckSample Nothing (firstOf (secondOf p))))

-- interp：`Nothing` = 会话不可用（调用方改走全量 `dtEvalFile`）。
export sessionEvalSample : IORef Session -> String -> String -> Eff hostRow (Maybe EvalSample)
sessionEvalSample ref baseDir source = do
  ses <- ensureSession ref baseDir
  case ses of
    Nothing => pure Nothing
    Just ifaces => do
      ctxR <- contextForFile source
      case ctxR of
        ErrC e => pure (Just (EvalSample (Just e) ""))
        OkC ctx => do
          text <- raiseToRow hostRow (@vuna@prim_eff_readFile source)
          s <- readRef ref
          result <- dtEvalSourceIncremental ctx source text ifaces (sesEvalAuxOf s)
          applyEvalResult ref s baseDir ifaces result

applyEvalResult : IORef Session -> Session -> String -> List ModuleIface -> Check (Pair Bool (Pair String (Maybe AuxCache))) -> Eff hostRow (Maybe EvalSample)
applyEvalResult ref s baseDir ifaces result = case result of
  ErrC e => pure (Just (EvalSample (Just e) ""))
  OkC p => if not (firstOf p) then pure Nothing
  else do
    _ <- writeRef ref (Session (sesRootOf s) baseDir ifaces (sesAuxOf s) (secondOf (secondOf p)))
    pure (Just (EvalSample Nothing (firstOf (secondOf p))))

listLength : List a -> Int
listLength [] = 0
listLength (_ :: rest) = 1 + listLength rest
