module Vuna.Test.Suite where

-- Vuna.Test.Suite：suite 文件（test/suite.toml）的模型、校验与 case discovery。
--
--   * `[family.<name>]` 按目录约定展开成一批 golden/error case，避免为每个夹具
--     手写一段 TOML；
--   * `[suite]` 只放全局默认（jobs/timeout/name）。
--
-- 本模块不做执行；只做「文件/TOML -> List Case」的数据转换（读盘经 Eff，TOML 解析与
-- case 建模保持纯）。对外入口因此是 `Eff []`：`parseSuiteFile` / `discoverCases`。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Toml
import Vuna.Files
import Vuna.Cli.Args

-- `vuna test --suite` 的选项。jobs = 0 表示 auto（由 runner 探测全部可用核）。
export record SuiteOpts(..) where
  suitePath : String
  suiteJobs : Int
  suiteListOnly : Bool
  suiteVerbose : Bool
  suiteFailFast : Bool
  suiteJSON : Bool
  suiteOnly : List String
  suiteFilter : List String
  suiteTimeout : Int
  -- `Just (i, n)` 是父进程 spawn 出来的 worker 模式：只跑 index mod n == i 的 case。
  suiteWorker : Maybe (Pair Int Int)
  suiteResultsDir : Maybe String
  suiteQuiet : Bool
  suiteNoCache : Bool
  suiteLastFailed : Bool
  suiteBless : Bool
  suiteBlessDiag : Bool
  suiteChanged : Maybe String
  suiteCacheDir : Maybe String
  suiteWatch : Bool
  suiteTimings : Bool
  suiteStrictSkips : Bool
  suiteAudit : Bool

-- 一个 family：目录约定 + 各阶段的上限开关（后缀决定实际参与；family 关掉即不跑）。
export record Family(..) where
  familyName : String
  familySection : String
  familyDir : String
  familyKind : String
  familyEntry : Maybe String
  familyInterp : Bool
  familyCheck : Bool
  familyCompile : Bool
  familyRun : Bool
  familyCompareInterp : Bool
  familyTags : List String
  familyTimeout : Int
  familyExclude : List String
  familyInclude : List String

export record Suite(..) where
  suiteName : String
  suiteRoot : String
  suiteDefaultJobs : Int
  suiteDefaultTimeout : Int
  suiteFamilies : List Family
  -- case 数下限：family 整族从配置里消失时，孤儿审计（只看已声明目录）也看不到它，
  -- 用总数下限兜底。0 = 不检查。
  suiteMinCases : Int

-- `CGolden` 的字段：source expected interp check compile run compareInterp。
-- `CError` 的字段：source expectedErr interp check compile。
export data CaseKind(..) : Type where
  CGolden : String -> String -> Bool -> Bool -> Bool -> Bool -> Bool -> CaseKind
  CError : String -> String -> Bool -> Bool -> Bool -> CaseKind
  CCheck : String -> Bool -> String -> CaseKind
  CLint : String -> String -> CaseKind
  CFix : String -> String -> CaseKind
  CRuntime : String -> String -> Int -> CaseKind
  CSeed : String -> String -> CaseKind
  -- 声明式用例：`*.steps` 文件（run/expect 指令），由 runner 解释执行。
  CSteps : String -> CaseKind
  CBroken : String -> CaseKind

export record Case(..) where
  caseId : String
  caseSection : String
  caseTags : List String
  caseKind : CaseKind
  caseTimeout : Int

-- ---------------------------------------------------------------
-- 路径与读盘
-- ---------------------------------------------------------------
-- 显式效果遍历（本模块只有 discovery 读盘这一条效果路径；纯 TOML/模型逻辑保持纯）。
concatMapEff : (a -> Eff [] (List b)) -> List a -> Eff [] (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

readTextFile : String -> Eff [] (Check String)
readTextFile path = do
  exists <- pathExistsFile path
  if exists then do
    isDir <- pathExistsDir path
    if isDir then pure (err "is a directory: ${path}") else fmap OkC (prim_eff_readFile path)
  else pure (err "no such file: ${path}")

-- suite 文件在 <root>/test/suite.toml；root = 上两级。
suiteFileRoot : String -> String
suiteFileRoot path = parentOf (parentOf path)

-- ---------------------------------------------------------------
-- TOML 取值（类型错误显式报错，不静默回落默认）
-- ---------------------------------------------------------------
sectionText : List String -> String
sectionText [] = ""
sectionText section = " in [${joinDots section}]"

samePathText : List String -> List String -> Bool
samePathText [] [] = True
samePathText (x :: xs) (y :: ys) = if x == y then samePathText xs ys else False
samePathText _ _ = False

fieldErr : List String -> String -> String -> String
fieldErr section key msg = "wrong type for `${key}`${sectionText section}: ${msg}"

getStr : List String -> String -> List TomlEntry -> Check (Maybe String)
getStr section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TStr s) => OkC (Just s)
  Just _ => err (fieldErr section key "expected a string")

getInt : List String -> String -> List TomlEntry -> Check (Maybe Int)
getInt section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TInt n) => OkC (Just n)
  Just _ => err (fieldErr section key "expected an integer")

getBool : List String -> String -> List TomlEntry -> Check (Maybe Bool)
getBool section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TBool b) => OkC (Just b)
  Just _ => err (fieldErr section key "expected a boolean")

getList : List String -> String -> List TomlEntry -> Check (Maybe (List String))
getList section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TArray xs) => case arrayStrings xs of
    Nothing => err (fieldErr section key "expected an array of strings")
    Just ys => OkC (Just ys)
  Just _ => err (fieldErr section key "expected an array of strings")

-- 可选字段的解包（Maybe 默认值只用于“缺失”，类型错误仍由 get* 报出）。
strOr : String -> Maybe String -> String
strOr d m = fromMaybe d m

intOr : Int -> Maybe Int -> Int
intOr d m = fromMaybe d m

boolOr : Bool -> Maybe Bool -> Bool
boolOr d m = fromMaybe d m

listOr : List String -> Maybe (List String) -> List String
listOr d m = fromMaybe d m

-- ---------------------------------------------------------------
-- family 解析
-- ---------------------------------------------------------------
familyKeys : List String
familyKeys =
  [ "section",
    "dir",
    "kind",
    "entry",
    "interp",
    "check",
    "compile",
    "run",
    "compare_interp",
    "tags",
    "timeout",
    "exclude",
    "include"
  ]

checkFamilyKeys : List String -> List TomlEntry -> Check Int
checkFamilyKeys section entries = checkFamilyKeysGo section entries

checkFamilyKeysGo : List String -> List TomlEntry -> Check Int
checkFamilyKeysGo section [] = OkC 0
checkFamilyKeysGo section (e :: rest) =
  if samePathText e.tomlEntrySection section then if memName e.tomlEntryKey familyKeys then checkFamilyKeysGo section rest
  else err "${sectionText section}: unknown key `${e.tomlEntryKey}`"
  else checkFamilyKeysGo section rest

-- buildFamily 的 option 读取拆成两段：单条 `>>=` 链过长会触发 D48 的推断 fuel /
-- 指数级问题（Result 管道每层 bind 都带字典插入）。拆分后每段 ≤7 层。
record FamilyOpts where
  familyOptKind : Maybe String
  familyOptEntry : Maybe String

record FamilyFlags where
  familyFlagInterp : Maybe Bool
  familyFlagCheck : Maybe Bool
  familyFlagCompile : Maybe Bool
  familyFlagRun : Maybe Bool
  familyFlagCompare : Maybe Bool
  familyFlagTags : Maybe (List String)
  familyFlagTimeout : Maybe Int

readFamilyOpts : List String -> List TomlEntry -> Check FamilyOpts
readFamilyOpts section entries =
  getStr section "kind" entries
    >>= (\kindOpt => getStr section "entry" entries >>= (\entryOpt => OkC (FamilyOpts kindOpt entryOpt)))

readFamilyFlags : List String -> List TomlEntry -> Check FamilyFlags
readFamilyFlags section entries =
  getBool section "interp" entries
    >>= (\interpOpt => getBool section "check" entries >>= (\checkOpt => getBool section "compile" entries >>= (\compileOpt => getBool section "run" entries >>= (\runOpt => getBool section "compare_interp" entries >>= (\compareOpt => getList section "tags" entries >>= (\tagsOpt => getInt section "timeout" entries >>= (\timeoutOpt => OkC (FamilyFlags interpOpt checkOpt compileOpt runOpt compareOpt tagsOpt timeoutOpt))))))))

-- 长 `>>=` 链在 Result 管道上会触发 D48 的推断 fuel 问题；这里用显式 case 展开。
buildFamily : Suite -> List TomlEntry -> String -> Check Family
buildFamily suite entries name =
  let
    section = ["family", name]
  in case checkFamilyKeys section entries of
    ErrC e => ErrC e
    OkC _ => case getStr section "section" entries of
      ErrC e => ErrC e
      OkC sectionOpt => case getStr section "dir" entries of
        ErrC e => ErrC e
        OkC dirOpt => case dirOpt of
          Nothing => err "family `${name}` needs `dir`"
          Just dir => case readFamilyOpts section entries of
            ErrC e => ErrC e
            OkC opts => case readFamilyFlags section entries of
              ErrC e => ErrC e
              OkC flags =>
                let
                  excludeList = case lookupEntry section "exclude" entries of
                    Just (TArray xs) => fromMaybe [] (arrayStrings xs)
                    _ => []
                  includeList = case lookupEntry section "include" entries of
                    Just (TArray xs) => fromMaybe [] (arrayStrings xs)
                    _ => []
                  kind = strOr "auto" opts.familyOptKind
                in if kind == "auto" || kind == "golden" || kind == "error" || kind == "check-ok" || kind == "check-error" || kind == "lint" || kind == "fix" || kind == "steps" then OkC
                  (Family name (strOr "" sectionOpt) dir kind opts.familyOptEntry (boolOr True flags.familyFlagInterp) (boolOr False flags.familyFlagCheck) (boolOr True flags.familyFlagCompile) (boolOr True flags.familyFlagRun) (boolOr True flags.familyFlagCompare) (listOr [] flags.familyFlagTags) (intOr suite.suiteDefaultTimeout flags.familyFlagTimeout) excludeList includeList)
                else err
                  (sectionText section ++ ": kind must be auto/golden/error/check-ok/check-error/lint/fix/steps, got `${kind}`")

-- 从 entries 收集 family 名（保持首次出现顺序）。
familyNames : List TomlEntry -> List String
familyNames entries = familyNamesGo entries []

familyNamesGo : List TomlEntry -> List String -> List String
familyNamesGo [] acc = reverse acc
familyNamesGo (e :: rest) acc = case e.tomlEntrySection of
  ["family", name] =>
    if memName name acc then familyNamesGo rest acc else familyNamesGo rest (name :: acc)
  _ => familyNamesGo rest acc

-- ---------------------------------------------------------------
-- suite 解析
-- ---------------------------------------------------------------
buildSuiteWithEntries : String -> List TomlEntry -> Check Suite
buildSuiteWithEntries path entries =
  let
    root = suiteFileRoot path
    section = ["suite"]
  in case getStr section "name" entries of
    ErrC e => ErrC e
    OkC nameOpt => case getInt section "jobs" entries of
      ErrC e => ErrC e
      OkC jobsOpt => case getInt section "timeout" entries of
        ErrC e => ErrC e
        OkC timeoutOpt => case getInt section "min_cases" entries of
          ErrC e => ErrC e
          OkC minOpt =>
            let
              draft =
                Suite (strOr "vuna" nameOpt) root (intOr 0 jobsOpt) (intOr 300 timeoutOpt) []
                  (intOr 0 minOpt)
            in buildFamiliesWith draft entries (familyNames entries)
              >>= (\families => OkC (Suite draft.suiteName draft.suiteRoot draft.suiteDefaultJobs draft.suiteDefaultTimeout families draft.suiteMinCases))

buildFamiliesWith : Suite -> List TomlEntry -> List String -> Check (List Family)
buildFamiliesWith suite entries [] = OkC []
buildFamiliesWith suite entries (name :: rest) = case buildFamily suite entries name of
  ErrC e => ErrC e
  OkC family => buildFamiliesWith suite entries rest >>= (\more => OkC (family :: more))

-- ---------------------------------------------------------------
-- discovery
-- ---------------------------------------------------------------
stripVuna : String -> String
stripVuna name = if endsWith ".vuna" name then substring 0 (byteLength name - 5) name else name

isFixtureName : String -> Bool
isFixtureName name = endsWith ".vuna" name && not (startsWith "_" name)

-- ---------------------------------------------------------------
-- 阶段限定后缀：`<base>.<stage>.<artifact>` 表达阶段矩阵
-- ---------------------------------------------------------------
-- 一个夹具扫描到的全部期望文件。阶段参与由「后缀存在性」推导，family 旗标只是
-- 上限（关掉即不跑）；矛盾组合显式 CBroken，不静默跳过。
record FixtureWant where
  fwCheckErr : Maybe String
  fwInterpOut : Maybe String
  fwInterpErr : Maybe String
  fwCompileErr : Maybe String
  fwRunOut : Maybe String
  fwRunErr : Maybe String
  fwRunExit : Maybe String
  fwSharedOut : Maybe String

hasOpt : Maybe a -> Bool
hasOpt (Just _) = True
hasOpt Nothing = False

orOpt : Maybe a -> Maybe a -> Maybe a
orOpt (Just x) _ = Just x
orOpt Nothing b = b

-- 探测夹具 base 名下的全部期望文件：阶段限定后缀优先，裸 `.out`（interp+run
-- 共享 golden，断言两者一致）与裸 `.err`（check 负例）是兼容形态。
parseWant : String -> Eff [] FixtureWant
parseWant base = do
  checkErr <- firstExisting ["${base}.check.err", "${base}.err"]
  interpOut <- firstExisting ["${base}.interp.out"]
  interpErr <- firstExisting ["${base}.interp.err"]
  compileErr <- firstExisting ["${base}.compile.err"]
  runOut <- firstExisting ["${base}.run.out"]
  runErr <- firstExisting ["${base}.run.err"]
  runExit <- firstExisting ["${base}.run.exit"]
  sharedOut <- firstExisting ["${base}.out"]
  pure (FixtureWant checkErr interpOut interpErr compileErr runOut runErr runExit sharedOut)

-- `.run.exit` 的期望退出码（十进制；空/非数字视为 0）。
readExitCode : String -> Eff [] Int
readExitCode path =
  fmap (\text => parseExitDigits (strUnpack (trim text)) 0 0) (prim_eff_readFile path)

parseExitDigits : List Int -> Int -> Int -> Int
parseExitDigits [] acc seen = if seen == 0 then 0 else acc
parseExitDigits (c :: rest) acc seen =
  if c >= 48 && c <= 57 then parseExitDigits rest (acc * 10 + (c - 48)) 1
  else if seen == 0 then parseExitDigits rest acc 0 else acc

-- 目录型夹具的期望文件（`expected.<stage>.<artifact>`；裸 `expected.out`/`expected.err` 兼容）。
dirWant : String -> Eff [] FixtureWant
dirWant caseDir = do
  checkErr <- firstExisting ["${caseDir}/expected.check.err", "${caseDir}/expected.err"]
  interpOut <- firstExisting ["${caseDir}/expected.interp.out"]
  compileErr <- firstExisting ["${caseDir}/expected.compile.err"]
  runOut <- firstExisting ["${caseDir}/expected.run.out"]
  runErr <- firstExisting ["${caseDir}/expected.run.err"]
  runExit <- firstExisting ["${caseDir}/expected.run.exit"]
  sharedOut <- firstExisting ["${caseDir}/expected.out"]
  pure (FixtureWant checkErr interpOut Nothing compileErr runOut runErr runExit sharedOut)

firstExisting : List String -> Eff [] (Maybe String)
firstExisting [] = pure Nothing
firstExisting (p :: rest) = do
  exists <- pathExistsFile p
  if exists then pure (Just p) else firstExisting rest

-- 从 want 推导 case。矛盾组合 / family 不允许的阶段显式 Err（→ CBroken）。
-- `.run.exit` 的读取是建模期唯一的效果；读完后的判定保持纯。
wantCase : Family -> String -> String -> FixtureWant -> Eff [] (Check Case)
wantCase family source id want = do
  exitCode <- case want.fwRunExit of
    Just p => readExitCode p
    Nothing => pure 0
  pure (wantCaseWith family source id want exitCode)

wantCaseWith : Family -> String -> String -> FixtureWant -> Int -> Check Case
wantCaseWith family source id want exitCode =
  let
    negRun = hasOpt want.fwRunErr || hasOpt want.fwRunExit
    negAny = hasOpt want.fwCheckErr || hasOpt want.fwInterpErr || hasOpt want.fwCompileErr || negRun
    posAny = hasOpt want.fwInterpOut || hasOpt want.fwSharedOut || hasOpt want.fwRunOut
  in if posAny && negAny then err "conflicting expect: golden (`.out`/`.interp.out`/`.run.out`) with error (`.check.err`/…)"
  else if hasOpt want.fwCheckErr && hasOpt want.fwInterpErr then err "conflicting expect: `.check.err` with `.interp.err`"
  else if hasOpt want.fwCompileErr && negRun then err "conflicting expect: `.compile.err` with `.run.err`/`.run.exit`"
  else if hasOpt want.fwInterpErr && (hasOpt want.fwCheckErr || hasOpt want.fwCompileErr) then err "conflicting expect: `.interp.err` with another error stage"
  else if hasOpt want.fwInterpErr && not family.familyInterp then err "family does not allow interp expectations"
  else if hasOpt want.fwRunOut && negRun then err "conflicting expect: `.run.out` with `.run.err`/`.run.exit`"
  else if negRun then if not family.familyRun then err "family does not allow run expectations"
  else
    let
      expect = fromMaybe "" want.fwRunErr
      -- `.run.exit` 语义：0 → 256 哨兵（vuna 没有负字面量；256 超出真实退出码
      -- 0–255 范围）= 断言恰好退出 0；n > 0 → 断言恰好 n。无 `.run.exit` 时
      -- 0 = 遗留语义（断言非 0）。
      code = if hasOpt want.fwRunExit then if exitCode == 0 then 256 else exitCode else 0
    in OkC
      (Case id family.familySection family.familyTags (CRuntime source expect code) family.familyTimeout)
  else if negAny then if hasOpt want.fwCompileErr && not family.familyCompile then err "family does not allow compile expectations"
  else
    let
      expect = fromMaybe "" (orOpt (orOpt want.fwCheckErr want.fwInterpErr) want.fwCompileErr)
      interpOn = family.familyInterp && (hasOpt want.fwCheckErr || hasOpt want.fwInterpErr)
      checkOn = family.familyCheck && hasOpt want.fwCheckErr
    in OkC
      (Case id family.familySection family.familyTags (CError source expect interpOn checkOn family.familyCompile) family.familyTimeout)
  else if hasOpt want.fwRunOut then if not family.familyCompile || not family.familyRun then err "family does not allow compile+run"
  else OkC
    (Case id family.familySection family.familyTags (CGolden source (fromMaybe "" want.fwRunOut) False family.familyCheck True True False) family.familyTimeout)
  else if hasOpt want.fwSharedOut then OkC
    (Case id family.familySection family.familyTags (CGolden source (fromMaybe "" want.fwSharedOut) family.familyInterp family.familyCheck family.familyCompile family.familyRun family.familyCompareInterp) family.familyTimeout)
  else if hasOpt want.fwInterpOut then OkC
    (Case id family.familySection family.familyTags (CGolden source (fromMaybe "" want.fwInterpOut) True family.familyCheck False False False) family.familyTimeout)
  else err "no expect file (need one of `.out` / `.check.err` / `.run.out` / …)"

-- check 负例期望路径：阶段限定优先，裸 `.err` 兼容。
expectPath : String -> Eff [] String
expectPath base = do
  exists <- pathExistsFile "${base}.check.err"
  if exists then pure "${base}.check.err" else pure "${base}.err"

-- 目录型 family：entry 配置时每个子目录一个 case。
discoverDirFamily : Suite -> Family -> String -> Eff [] (List Case)
discoverDirFamily suite family entry =
  let
    dir = "${suite.suiteRoot}/${family.familyDir}"
  in do
    exists <- pathExistsDir dir
    if not exists then pure [brokenFamilyCase family "family dir not found: ${dir}"]
    else do
      names <- prim_eff_readDir dir
      concatMapEff (oneDir family dir entry) names

oneDir : Family -> String -> String -> String -> Eff [] (List Case)
oneDir family dir entry name =
  let
    caseDir = "${dir}/${name}"
    source = "${caseDir}/${entry}"
    id = "${family.familySection}/${family.familyName}/${name}"
  in do
    isDir <- pathExistsDir caseDir
    isFile <- if isDir then pathExistsFile source else pure False
    if isDir && isFile then do
      want <- dirWant caseDir
      derived <- wantCase family source id want
      pure (case derived of
        ErrC msg => [brokenFamilyCase family (diagText msg)]
        OkC c => [c]
      )
    else pure []

-- 文件型 family：每个 `*.vuna` 一个 case；auto 按磁盘上存在的 `.out`/`.err` 判定。
discoverFileFamily : Suite -> Family -> Eff [] (List Case)
discoverFileFamily suite family =
  let
    dir = "${suite.suiteRoot}/${family.familyDir}"
  in do
    exists <- pathExistsDir dir
    if not exists then pure [brokenFamilyCase family "family dir not found: ${dir}"]
    else do
      names <- prim_eff_readDir dir
      concatMapEff (oneFile family dir) names

matchesExclude : Family -> String -> Bool
matchesExclude family name = matchesAnyExclude family.familyExclude name

matchesAnyExclude : List String -> String -> Bool
matchesAnyExclude [] name = False
matchesAnyExclude (pat :: rest) name =
  if contains pat name then True else matchesAnyExclude rest name

matchesInclude : Family -> String -> Bool
matchesInclude family name = matchesAnyExclude family.familyInclude name

includeActive : Family -> Bool
includeActive family = case family.familyInclude of
  [] => False
  _ => True

oneFile : Family -> String -> String -> Eff [] (List Case)
oneFile family dir name = if isFixtureName name then if matchesExclude family name then pure []
else if includeActive family && not (matchesInclude family name) then pure []
else
  let
    source = "${dir}/${name}"
  in do
    derived <- fileCase family source (stripVuna source) (stripVuna name)
    pure (case derived of
      ErrC msg => [brokenFamilyCase family (diagText msg)]
      OkC c => [c]
    )
else pure []

fileCase : Family -> String -> String -> String -> Eff [] (Check Case)
fileCase family source base rel =
  let
    id = "${family.familySection}/${family.familyName}/${rel}"
  in if family.familyKind == "lint" then
    let
      expected = "${base}.out"
    in do
      exists <- pathExistsFile expected
      if exists then pure
        (OkC (Case id family.familySection family.familyTags (CLint source expected) family.familyTimeout))
      else pure (err "expected file not found: ${expected}")
  else if family.familyKind == "fix" then
    let
      expected = "${base}.expected"
    in do
      exists <- pathExistsFile expected
      if exists then pure
        (OkC (Case id family.familySection family.familyTags (CFix source expected) family.familyTimeout))
      else pure (err "expected file not found: ${expected}")
  else if family.familyKind == "steps" then pure (OkC (Case id family.familySection family.familyTags (CSteps source) family.familyTimeout))
  else if family.familyKind == "check-ok" then pure
    (OkC (Case id family.familySection family.familyTags (CCheck source True "") family.familyTimeout))
  else if family.familyKind == "check-error" then do
    expected <- expectPath base
    exists <- pathExistsFile expected
    if exists then pure
      (OkC (Case id family.familySection family.familyTags (CCheck source False expected) family.familyTimeout))
    else pure (err "expected file not found: ${expected}")
  else do
    want <- parseWant base
    wantCase family source id want

brokenFamilyCase : Family -> String -> Case
brokenFamilyCase family msg =
  Case "${family.familySection}/${family.familyName}/__missing__" family.familySection
    family.familyTags (CBroken msg) family.familyTimeout

-- steps 家族：目录里每个 `*.steps` 一个声明式 case（run/expect 指令由 runner 解释）。
discoverStepsFamily : Suite -> Family -> Eff [] (List Case)
discoverStepsFamily suite family =
  let
    dir = "${suite.suiteRoot}/${family.familyDir}"
  in do
    exists <- pathExistsDir dir
    if not exists then pure [brokenFamilyCase family "family dir not found: ${dir}"]
    else do
      names <- prim_eff_readDir dir
      pure (concatMap (\name => if endsWith ".steps" name then
        let
          rel = substring 0 (byteLength name - 6) name
          id = "${family.familySection}/${family.familyName}/${rel}"
        in [ Case id family.familySection family.familyTags (CSteps "${dir}/${name}") family.familyTimeout
        ]
      else []
      ) names
      )

discoverFamily : Suite -> Family -> Eff [] (List Case)
discoverFamily suite family = if family.familyKind == "steps" then discoverStepsFamily suite family
else case family.familyEntry of
  Just entry => discoverDirFamily suite family entry
  Nothing => discoverFileFamily suite family

-- ---------------------------------------------------------------
-- 对外入口
-- ---------------------------------------------------------------
export parseSuiteFile : String -> Eff [] (Check Suite)
parseSuiteFile path = do
  cwd <- prim_eff_getcwd
  let
    absPath = if startsWith "/" path then path else "${cwd}/${path}"
  in parseSuiteAt absPath

parseSuiteAt : String -> Eff [] (Check Suite)
parseSuiteAt absPath = do
  contents <- readTextFile absPath
  case contents of
    ErrC e => pure (ErrC e)
    OkC text => case parseTomlAt absPath text of
      ErrC e => pure (ErrC e)
      OkC entries => pure (buildSuiteWithEntries absPath entries)

export discoverCases : Suite -> Eff [] (List Case)
discoverCases suite =
  let
    seedPath = "${suite.suiteRoot}/test/corpus/run/12_fact.vuna"
    seed =
      [ Case "13/seed" "13" ["seed"] (CSeed seedPath "${suite.suiteRoot}/test/corpus/run/12_fact.out") 900
      ]
  in do
    base <- concatMapEff (discoverFamily suite) suite.suiteFamilies
    hasSeed <- pathExistsFile seedPath
    pure (append base (if hasSeed then seed else []))
