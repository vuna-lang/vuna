module Vuna.Test.InProc where

-- Vuna.Test.InProc：测试的进程内执行层。
--
-- 设计原则：**直接调用编译器/工具链的导出函数，断言返回值**。不 spawn
-- `vuna <cmd>`，也不截获 stdout / 改进程 cwd / 模拟退出码——那等于把 CLI 复制
-- 一遍再反解析它的输出。
--
-- 本模块只做三件事：
--   1. 上下文解析（文件 → `contextForFile`，包目录 → `loadPackage`）；
--   2. 与 CLI 同口径的**诊断裁剪**（去重 → 按归属过滤 → 上限 20 条），使进程内
--      结果与 `vuna check --json` 写进 `.diag.json` 的形态逐项一致；
--   3. 分派到对应的导出函数（check / interp / compile / lint / fix）。
--
-- 唯一的「路径选择」是**进程内的两条实现路径**（增量会话优先、失败退回全量），
-- 绝不退回子进程：会话不可用就再跑一次全量精化，两条都不可用才算用例失败。
--
-- 仍在子进程的部分（构造上不可进程内，见 `docs/reference/testing.md` 的「进程绑定
-- 岛」）：`build.sh`（ocamlopt 链接）、产物执行、`repl`/`lsp`/`seed`/包管理器。
import Base.HostRow
import Base.IORef
import Base.List
import Base.Maybe
import Base.String
import Vuna.Compiler.Common
import Vuna.Compiler.Diag
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Diagnostics.Sink
import Vuna.Compiler.Packages.Pkg
import Vuna.FixityEnv
import Vuna.Lint.Fix
import Vuna.Lint.Rules
import Vuna.Test.Session

-- 诊断上限：与 `CliOpts` 默认 `optMaxErrors = 20` 一致（`takeDiags` 同语义）。
diagCap : Int
diagCap = 20

-- ---------------------------------------------------------------
-- 与 CLI 同口径的诊断裁剪
-- ---------------------------------------------------------------
stripDotSlash : String -> String
stripDotSlash s =
  if startsWith "./" s then substring (natFromInt 2) (natFromInt (strLength s - 2)) s else s

-- 与 `CompilerCli.ownedByFile` 同一判据：本文件拥有的诊断。
ownedByFile : String -> Diagnostic -> Bool
ownedByFile path d = stripDotSlash (diagFileOf d) == stripDotSlash path

-- 与 `CompilerCli.ownedByPackage` 同一判据：`lib/` `app/` `test/` 下的诊断属于该包。
ownedByPackage : Package -> Diagnostic -> Bool
ownedByPackage pkg d =
  let
    dir = stripDotSlash (packageDir pkg)
    file = stripDotSlash (diagFileOf d)
    prefix = if dir == "." || dir == "" then "" else "${dir}/"
  in startsWith (prefix ++ "lib/") file
    || startsWith (prefix ++ "app/") file
    || startsWith (prefix ++ "test/") file

-- 单文件入口：`checkEntryFile` / `checkModuleFileEntry` 的裁剪链。
fileShown : String -> List Diagnostic -> List Diagnostic
fileShown path ds = Base.List.take diagCap (filter (ownedByFile path) (dedupeWarnings ds))

-- 包目录：`checkPackageCode` 的裁剪链。
packageShown : Package -> List Diagnostic -> List Diagnostic
packageShown pkg ds = Base.List.take diagCap (filter (ownedByPackage pkg) (dedupeWarnings ds))

-- ---------------------------------------------------------------
-- check
-- ---------------------------------------------------------------
-- 单文件 check：与 `vuna check <file>` 同一分派（`module` 头 → 库模块语义）。
-- 返回裁剪后的诊断列表（`OkC` 时可能只有 warning；`ErrC` 时首错 + children）。
export checkFile : String -> Eff hostRow (Check (List Diagnostic))
checkFile path = do
  ctxR <- contextForFile path
  case ctxR of
    ErrC e => pure (ErrC e)
    OkC ctx => do
      moduleFile <- dtFileHasModuleHeader path
      if moduleFile then do
        checked <- dtCheckModuleFile ctx path
        pure (case checked of
          ErrC e => ErrC e
          OkC ws => OkC (fileShown path ws)
        )
      else do
        checked <- dtCheck ctx path
        pure (case checked of
          ErrC e => ErrC e
          OkC ws => OkC (fileShown path ws)
        )

-- 包目录 check：`vuna check <dir>` 的单包路径（workspace 展开由调用方决定）。
-- `wantWarnings = True`：warning 不持久化，负例断言必须看到它们，绕开一切缓存判定。
export checkPackageAt : String -> Eff hostRow (Check (List Diagnostic))
checkPackageAt dir = do
  pkgR <- loadPackage dir
  case pkgR of
    ErrC e => pure (ErrC e)
    OkC pkg => do
      checked <- checkPackage False True pkg
      case checked of
        ErrC e => pure (ErrC e)
        OkC ws => pure (OkC (packageShown pkg ws))

-- 目录是否为包目录（`vuna check <dir>` 与 `vuna check <file>` 的分派依据）。
export isPackageDir : String -> Eff hostRow Bool
isPackageDir path = do
  isDir <- pathExistsDirEff path
  if not isDir then pure False
  else do
    hasManifest <- pathExistsFileEff "${path}/vuna.toml"
    pure hasManifest

pathExistsDirEff : String -> Eff hostRow Bool
pathExistsDirEff path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if not exists then pure False else raiseToRow hostRow (@vuna@prim_eff_isDirectory path)

pathExistsFileEff : String -> Eff hostRow Bool
pathExistsFileEff path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if not exists then pure False
  else do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory path)
    pure (not isDir)

-- ---------------------------------------------------------------
-- 会话优先的 check / interp
-- ---------------------------------------------------------------
-- 会话优先的 check / interp
-- ---------------------------------------------------------------
-- 进程内两条路径：增量会话（命中依赖接口 + termAux 缓存，~10ms）优先；会话不可用
-- （接口缺失 / `applied=False`）时**在同一进程内**退回全量精化。绝不 spawn 子进程。
--
-- **正例专用**：增量路径（`dtCheckSourceIncremental` / `dtEvalSourceIncremental`）
-- 只汇总 loader + `dtProgWarnings`，不跑全量路径尾部的 `warnUnusedDefsIn`；负例
-- 夹具要断言「未使用定义/遮蔽」这类 warning，必须走全量 `checkFile`。
export checkFileSessioned : IORef Session -> String -> String -> Eff hostRow (Check (List Diagnostic))
checkFileSessioned ref base source = do
  probed <- sessionCheckSample ref base source
  case probed of
    Nothing => checkFile source
    Just sample => case sample.csErr of
      Just e => pure (ErrC e)
      Nothing => pure (OkC sample.csDiags)

export interpFileSessioned : IORef Session -> String -> String -> Eff hostRow (Check String)
interpFileSessioned ref base source = do
  probed <- sessionEvalSample ref base source
  case probed of
    Nothing => interpFile source
    Just sample => case sample.esErr of
      Just e => pure (ErrC e)
      Nothing => pure (OkC sample.esText)

-- ---------------------------------------------------------------
-- interp
-- ---------------------------------------------------------------
-- `vuna interp <file>` 的进程内形态：DT 精化 + 核心求值，返回展示文本。
export interpFile : String -> Eff hostRow (Check String)
interpFile path = do
  ctxR <- contextForFile path
  case ctxR of
    ErrC e => pure (ErrC e)
    OkC ctx => dtEvalFile ctx path

-- ---------------------------------------------------------------
-- compile
-- ---------------------------------------------------------------
-- `vuna compile <file> <out>` 的进程内形态：目录 codegen（含 build.sh 与 ffi 复制）。
-- `printResult = True` 与 CLI 默认一致（影响 codegen 的入口展示，进输入摘要）。
-- 归一成 `Check Int`：`OkC (Pair n ds)` 只保留模块数（诊断要么为空，要么调用方
-- 走负例路径；正例断言只要「编译成功且无诊断」）。
export compileFile : String -> String -> Eff hostRow (Check (Pair Int (List Diagnostic)))
compileFile path outDir = do
  ctxR <- contextForFile path
  case ctxR of
    ErrC e => pure (ErrC e)
    OkC ctx => compileToDir ctx path True outDir

-- 包目录 compile（`vuna compile <dir> <out>`）：先要求可执行包，再编入口。
export compilePackageAt : String -> String -> Eff hostRow (Check (Pair Int (List Diagnostic)))
compilePackageAt dir outDir = do
  pkgR <- loadPackage dir
  case pkgR of
    ErrC e => pure (ErrC e)
    OkC pkg => do
      entries <- pure (packageEntry pkg)
      exists <- pathExistsFileEff entries
      if exists then compileToDir (packageContext pkg) entries True outDir
      else pure (err "package ${packageName pkg} has no app entry")

-- ---------------------------------------------------------------
-- lint / fix
-- ---------------------------------------------------------------
-- `vuna lint <file>` 的进程内形态：返回 findings（顺序与 CLI 打印一致）。
export lintFile : String -> Eff hostRow (Check (List Finding))
lintFile path = do
  textR <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
  looked <- fixitiesForFile emptyFixityEnv path textR
  pure (case secondOf looked of
    ErrC e => ErrC e
    OkC fixities => lintSourceWith fixities textR
  )

-- `vuna lint --fix <file>` 的进程内形态（与 `Lint.fixReport` 同一条 `fixLoop` 路径）：
-- 返回（修复数, 新源码）。调用方负责把新源码写回工作副本。
-- **必须**先取程序级 fixity（`fixitiesForFile`）：`fixLoop` 每轮都用 fixities 重新
-- lint 结果源码，空表会让「已知运算符」退化成 unknown fixity，第二轮起直接放弃修复。
export fixFile : String -> String -> Eff hostRow (Check (Pair Int String))
fixFile path text = do
  looked <- fixitiesForFile emptyFixityEnv path text
  pure (case secondOf looked of
    ErrC e => ErrC e
    OkC fixities => case lintSourceWith fixities text of
      ErrC e => ErrC e
      OkC findings => fixLoop fixities text findings 8 0
  )
