module Vuna.Clean (runCleanIface) where

-- Vuna.Clean：批量删除 iface 缓存文件（`vuna clean-iface [--dry-run] [DIR]`）。
--
-- iface 默认与源码同目录（`lib/Base/Int.vuna` 旁就是 `Int.iface`）+ 包级 `.vuna-iface`；
-- `VUNA_IFACE_DIR` 模式下在外部镜像根。清理按**文件名**识别、不读文件内容：
--   - `*.iface`（模块接口）
--   - `.vuna-iface`（包级 manifest）
--   - `*.iface.*.tmp`（`prim_eff_writeFileAtomic` 崩溃残留）
-- 这样既不会把宿主异常漏给用户，也不会误删 `.vuna` 源码；`.iface` 扩展是 vuna 保留名。
import Vuna.Compiler.Common
import Vuna.Cli.Args
import Base.Host

runCleanIface : List String -> Eff [] Int
runCleanIface args = case parseToolArgs "vuna clean-iface" [BoolFlag "dry-run"] args of
  ErrC e => cleanError (diagText e)
  OkC parsed => case parsed.positionals of
    [] => cleanAt "." (flagSet parsed "dry-run")
    [dir] => cleanAt dir (flagSet parsed "dry-run")
    _ => cleanError "too many arguments; expected at most one directory"

cleanAt : String -> Bool -> Eff [] Int
cleanAt dir dry = case requireDirectory dir of
  ErrC e => cleanError (diagText e)
  OkC _ => do
    all <- walkFiles 1048576 dir
    _ <- if dry then pure 0 else removeEach (filter isIfaceFile all)
    _ <-
      prim_eff_print
        (if length (filter isIfaceFile all) == 0 then "clean-iface: no iface files under ${dir}\n" else if dry then "clean-iface: would remove ${strFromInt (length (filter isIfaceFile all))} file(s) under ${dir}\n" else "clean-iface: removed ${strFromInt (length (filter isIfaceFile all))} file(s) under ${dir}\n")
    pure 0

removeEach : List String -> Eff [] Int
removeEach [] = pure 0
removeEach (f :: rest) = do
  _ <- prim_eff_removeFile f
  removeEach rest

cleanError : String -> Eff [] Int
cleanError e = do
  _ <- prim_eff_print "error: ${e}\n"
  pure 2

-- 与工作树其他遍历一致的跳过规则：`.local` 不跳过（`VUNA_IFACE_DIR=.local/iface` 时要能清到）。
skipCleanDir : String -> Bool
skipCleanDir name =
  name == ".git"
    || name == ".direnv"
    || name == "node_modules"
    || name == "_scratch"
    || name == ".vscode"
    || name == ".dsh-plugins"
    || name == "seed"
    || name == "result"
    || startsWith "result-" name

-- 目录树是文件系统图（符号链接可成环），用显式 fuel 守卫。
walkFiles : Int -> String -> Eff [] (List String)
walkFiles fuel dir = if fuel <= 0 then pure []
else do
  exists <- prim_eff_fileExists dir
  isDir <- prim_eff_isDirectory dir
  if exists && isDir then do
    names <- prim_eff_readDir dir
    concatMapEff (walkGo (fuel - 1) dir) names
  else pure []

concatMapEff : (a -> Eff [] (List b)) -> List a -> Eff [] (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

walkGo : Int -> String -> String -> Eff [] (List String)
walkGo fuel dir name = if fuel <= 0 then pure []
else case name of
  "." => pure []
  ".." => pure []
  _ => if skipCleanDir name then pure []
  else
    let
      path = "${dir}/${name}"
    in do
      exists <- prim_eff_fileExists path
      isDir <- prim_eff_isDirectory path
      if exists && isDir then walkFiles (fuel - 1) path else pure [path]

isIfaceFile : String -> Bool
isIfaceFile path =
  if endsWith "/.vuna-iface" path then True
  else if endsWith ".iface" path then True else endsWith ".tmp" path && contains ".iface." path
