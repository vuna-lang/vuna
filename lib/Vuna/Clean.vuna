module Vuna.Clean where

-- Vuna.Clean：缓存清理（`vuna clean [--store] [--packages] [--gc] [--all] [--dry-run] [DIR]`）。
--
-- 一个 store 根、两类生命周期（D15）：
--   --store     **缓存族**：`objects/<kind>/`（iface/header/lex/order/check/tool/mods/test/
--               splitptr）、`blobs/`、`units/`、`views/bin/`、`.tmp/`（锁与暂存）。
--               保留 `objects/pkg/`、`pkgs/`、`roots/`、`tmp/`。
--   --packages  **取包对象族**：`objects/pkg/`、物化视图 `pkgs/`、取包中转 `tmp/`。
--               保留缓存族与 roots。
--   --gc        与 `--packages` 连用：只删包对象族里**未被引用**的对象；引用集 =
--               当前包与 `[workspace].members`（递归）的 git/url 依赖摘要 + 所有项目 roots。
--   --all       两者都清。
-- 不带 flag 时只清缓存族（默认不碰持久包对象）。
-- `DIR` 只对 `--gc` 的引用集有用（默认 `.`）；`--store` / `--packages` 不收目录。
import Base.HostRow
import Vuna.Cli.Args
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Manifest
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Packages.Source
import Vuna.Compiler.Store
import Base.List
import Base.Nat
import Base.String

export runClean : List String -> Eff hostRow Int
runClean args = case parseToolArgs "vuna clean" [BoolFlag "dry-run", BoolFlag "store", BoolFlag "packages", BoolFlag "gc", BoolFlag "all"] args of
  ErrC e => cleanError (diagText e)
  OkC parsed =>
    let
      dry = flagSet parsed "dry-run"
      wantGc = flagSet parsed "gc"
      anyFlag =
        flagSet parsed "store"
          || flagSet parsed "packages"
          || flagSet parsed "gc"
          || flagSet parsed "all"
      wantStore = flagSet parsed "store" || flagSet parsed "all" || not anyFlag
      wantPackages = flagSet parsed "packages" || flagSet parsed "all"
    in if wantGc && not wantPackages then cleanError "vuna clean --gc requires --packages"
    else case parsed.positionals of
      [] => cleanTargets wantStore wantPackages wantGc dry "."
      [dir] =>
        if (wantStore || wantPackages) && not wantGc then cleanError "vuna clean --store/--packages takes no directory"
        else cleanTargets wantStore wantPackages wantGc dry dir
      _ => cleanError "too many arguments; expected at most one directory"

-- 接口缓存已并入对象库（`$VUNA_STORE/objects/iface`），不再有树内 `*.iface`；
-- 因此没有 `--iface`：清缓存 = 清缓存族（`--store`）或包对象族（`--packages`）。
cleanTargets : Bool -> Bool -> Bool -> Bool -> String -> Eff hostRow Int
cleanTargets wantStore wantPackages wantGc dry dir = do
  storeCode <- if wantStore then cleanStore dry else pure 0
  if storeCode /= 0 then pure storeCode
  else if wantPackages then cleanPackages wantGc dir dry else pure 0

-- 缓存族：按 kind 目录 + 派生目录枚举，不碰包对象族与 roots。
cacheKindNames : List String
cacheKindNames =
  ["iface", "header", "lex", "order", "check", "tool", "mods", "test", "pkgiface", "splitptr"]

cacheScopesOf : String -> List String
cacheScopesOf root =
  append (map (\k => "${root}/objects/${k}") cacheKindNames)
    ["${root}/blobs", "${root}/units", "${root}/views/bin", "${root}/.tmp"]

cleanStore : Bool -> Eff hostRow Int
cleanStore dry = do
  root <- storeRootEff
  cleanScopes "clean-store" (cacheScopesOf root) dry

-- `--packages`：默认整族清理；`--gc` 只删未被引用对象。
cleanPackages : Bool -> String -> Bool -> Eff hostRow Int
cleanPackages wantGc dir dry = do
  root <- storeDataRootEff
  if wantGc then cleanPackagesGc root dir dry
  else cleanScopes "clean-packages" ["${root}/objects/pkg", "${root}/pkgs", "${root}/tmp"] dry

cleanPackagesGc : String -> String -> Bool -> Eff hostRow Int
cleanPackagesGc root dir dry = do
  local <- collectRootDigests dir
  global <- allRootDigests
  files <- concatMapEff filesUnder ["${root}/objects/pkg", "${root}/pkgs"]
  let
    roots = append local global
    drop = filter (\p => not (isReferenced roots p)) files
    n = length drop
  in do
    _ <- if dry then pure 0 else removeEach drop
    _ <-
      @vuna@prim_eff_print
        "clean-packages --gc: ${storeVerb dry} ${strFromInt n} unreferenced file(s) under ${root}\n"
    pure 0

-- 路径属于被引用对象：`objects/pkg/<digest>` 或 `pkgs/<digest>/...`。
isReferenced : List String -> String -> Bool
isReferenced roots path =
  anyLine (\d => contains "/objects/pkg/${d}" path || contains "/pkgs/${d}/" path) roots

anyLine : (a -> Bool) -> List a -> Bool
anyLine f [] = False
anyLine f (x :: rest) = if f x then True else anyLine f rest

-- 引用集 = 当前包 + `[workspace].members`（**递归嵌套**）的 git/url 依赖摘要（path 依赖不
-- 参与，D12）。工作队列 + seen + fuel：结构递归在队列上，fuel 只防 members 环/失控。
collectRootDigests : String -> Eff hostRow (List String)
collectRootDigests dir = do
  abs <- absolutePath dir
  walkMemberDirs 4096 [abs] []

walkMemberDirs : Int -> List String -> List String -> Eff hostRow (List String)
walkMemberDirs fuel queue seen = if fuel <= 0 then pure []
else case queue of
  [] => pure []
  d :: rest => if memName d seen then walkMemberDirs (fuel - 1) rest seen
  else do
    info <- manifestInfoEff (joinPath d "vuna.toml")
    case info of
      Nothing => walkMemberDirs (fuel - 1) rest (d :: seen)
      Just (Pair hashes members) => do
        more <-
          walkMemberDirs (fuel - 1) (append (map (\rel => joinPath d rel) members) rest) (d :: seen)
        pure (append hashes more)

manifestInfoEff : String -> Eff hostRow (Maybe (Pair (List String) (List String)))
manifestInfoEff path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then do
    raw <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
    case parseManifest path raw of
      ErrC _ => pure Nothing
      OkC manifest => case validateManifest manifest of
        ErrC _ => pure Nothing
        OkC valid =>
          pure (Just (Pair (depHashesOf valid.manifestDependencies) valid.manifestMembers))
  else pure Nothing

depHashesOf : List Dependency -> List String
depHashesOf [] = []
depHashesOf (dep :: rest) = case depHashOf dep of
  Nothing => depHashesOf rest
  Just h => normalizeHash h :: depHashesOf rest

-- 清一组**作用域路径**（目录或文件）：先统计文件数（dry-run/输出口径），再整目录删除。
-- 路径不存在 ⇒ 跳过；`rm -rf` 只对目录，文件走 removeFile。
cleanScopes : String -> List String -> Bool -> Eff hostRow Int
cleanScopes label paths dry = do
  files <- concatMapEff filesUnder paths
  let
    n = length files
  in do
    _ <- if dry then pure 0 else removeEachPath paths
    _ <-
      raiseToRow hostRow
        (@vuna@prim_eff_print "${label}: ${storeVerb dry} ${strFromInt n} file(s)\n")
    pure 0

-- 路径下的全部文件：不存在 ⇒ []；文件 ⇒ 它自己；目录 ⇒ 递归。
filesUnder : String -> Eff hostRow (List String)
filesUnder path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if not exists then pure []
  else do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory path)
    if isDir then walkFiles 1048576 path else pure [path]

removeEachPath : List String -> Eff hostRow Int
removeEachPath [] = pure 0
removeEachPath (path :: rest) = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if not exists then removeEachPath rest
  else do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory path)
    _ <-
      if isDir then raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", path])
      else raiseToRow hostRow (@vuna@prim_eff_removeFile path)
    removeEachPath rest

storeVerb : Bool -> String
storeVerb True = "would remove"
storeVerb False = "removed"

removeEach : List String -> Eff hostRow Int
removeEach [] = pure 0
removeEach (f :: rest) = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_removeFile f)
  removeEach rest

cleanError : String -> Eff hostRow Int
cleanError e = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "error: ${e}\n")
  pure 2

-- 与工作树其他遍历一致的跳过规则：`.local` 不跳过（`VUNA_IFACE_DIR=.local/iface` 时要能清到）。
skipCleanDir : String -> Bool
skipCleanDir name =
  name == ".git"
    || name == ".direnv"
    || name == "node_modules"
    || name == "_scratch"
    || name == ".vscode"
    || name == ".dsh-plugins"
    || name == "seed"
    || name == "result"
    || startsWith "result-" name

-- 目录树是文件系统图（符号链接可成环），用显式 fuel 守卫。
walkFiles : Int -> String -> Eff hostRow (List String)
walkFiles fuel dir = if fuel <= 0 then pure []
else do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists dir)
  isDir <- if exists then @vuna@prim_eff_isDirectory dir else pure False
  if exists && isDir then do
    names <- raiseToRow hostRow (@vuna@prim_eff_readDir dir)
    concatMapEff (walkGo (fuel - 1) dir) names
  else pure []

concatMapEff : (a -> Eff hostRow (List b)) -> List a -> Eff hostRow (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

walkGo : Int -> String -> String -> Eff hostRow (List String)
walkGo fuel dir name = if fuel <= 0 then pure []
else case name of
  "." => pure []
  ".." => pure []
  _ => if skipCleanDir name then pure []
  else
    let
      path = "${dir}/${name}"
    in do
      exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
      isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory path)
      if exists && isDir then walkFiles (fuel - 1) path else pure [path]

-- ---------------------------------------------------------------
-- `vuna store gc`：按 **roots + 宽限窗口 + 容量上限** 淘汰对象。
--
-- 输入寻址下删除对象**不影响正确性**：缺了就是一次未命中、重算即可。所以这里只需要
-- 一条策略：常用的别删。roots（`store/roots/<项目摘要>`，项目只追加）就是「常用」的
-- 声明；宽限窗口保护「刚写、root 还没写」的崩溃窗口。
-- ---------------------------------------------------------------
export runStoreGc : List String -> Eff hostRow Int
runStoreGc args = case parseToolArgs "vuna store gc" [BoolFlag "dry-run", ValueFlag "older-than", ValueFlag "max-size"] args of
  ErrC e => cleanError (diagText e)
  OkC parsed => do
    root <- storeRootReadyEff
    keep <- allRootDigests
    let
      dry = flagSet parsed "dry-run"
      graceSec = case lookupPair "older-than" parsed.valuesOf of
        Just v => strToIntOr v 3600
        Nothing => 3600
      maxBytes = case lookupPair "max-size" parsed.valuesOf of
        Just v => strToIntOr v 0
        Nothing => 0
    in do
      gcSweep root keep graceSec maxBytes dry

-- 十进制整数解析：只接受纯数字（`--older-than` / `--max-size` 都是非负整数）。
-- 语言侧没有 char 级原语，这里用 `substring` 逐字符取一位再比对字面量；递归用显式 fuel
-- （长度上限即 fuel），这样终止性检查不需要理解 `i` 的递增。
strToIntOr : String -> Int -> Int
strToIntOr s d = case readNatFuel (toInt (byteLength s)) 0 s 0 of
  Just v => v
  Nothing => d

digitOf : String -> Maybe Int
digitOf "0" = Just 0
digitOf "1" = Just 1
digitOf "2" = Just 2
digitOf "3" = Just 3
digitOf "4" = Just 4
digitOf "5" = Just 5
digitOf "6" = Just 6
digitOf "7" = Just 7
digitOf "8" = Just 8
digitOf "9" = Just 9
digitOf _ = Nothing

-- `fuel` 从长度递减到 0；`pos` 是当前位（0 起）。
readNatFuel : Int -> Int -> String -> Int -> Maybe Int
readNatFuel fuel pos s acc = if fuel <= 0 then Just acc
else case digitOf (substring (Base.Nat.fromInt pos) (Base.Nat.fromInt 1) s) of
  Nothing => Nothing
  Just d => readNatFuel (fuel - 1) (pos + 1) s (acc * 10 + d)

-- 所有项目 roots 的并集（GC 的「保留」集合）。
allRootDigests : Eff hostRow (List String)
allRootDigests = do
  projects <- storeRootProjectListEff
  concatMapEff storeRootLoadEff projects

-- 遍历缓存族：objects/（**排除包对象族 objects/pkg/**）、blobs/、units/ 的全部文件。
gcFilesOf : String -> Eff hostRow (List String)
gcFilesOf root = do
  objs <- walkFiles 1048576 "${root}/objects"
  blobs <- walkFiles 1048576 "${root}/blobs"
  units <- walkFiles 1048576 "${root}/units"
  let
    pkgPrefix = "${root}/objects/pkg/"
    cacheObjs = filter (\p => not (startsWith pkgPrefix p)) objs
  in pure (append cacheObjs (append blobs units))

-- 目录下的直接子目录（不存在/不是目录 ⇒ []）。
subDirsOf : String -> Eff hostRow (List String)
subDirsOf dir = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists dir)
  isDir <- if exists then @vuna@prim_eff_isDirectory dir else pure False
  if exists && isDir then do
    names <- raiseToRow hostRow (@vuna@prim_eff_readDir dir)
    concatMapEff (\n => do
      let
        p = "${dir}/${n}"
      in do
        sub <- raiseToRow hostRow (@vuna@prim_eff_isDirectory p)
        pure (if sub then [p] else [])
    ) names
  else pure []

dirSizeOf : String -> Eff hostRow Int
dirSizeOf path = do
  files <- walkFiles 1048576 path
  xs <- sizesOf files
  pure (sumSizes xs)

-- 视图候选：整目录按 roots 名保护、按目录 mtime 判旧。视图只能整目录删
-- （`.complete` 还在时删单个文件会让读侧把半截视图当完整的）。
gcViewCandidates : Int -> List String -> Int -> List String -> Eff hostRow (List (Pair Int (Pair Int String)))
gcViewCandidates _ _ _ [] = pure []
gcViewCandidates now keep grace (d :: rest) = do
  more <- gcViewCandidates now keep grace rest
  if memName (fileNameOf d) keep then pure more
  else do
    mtime <- raiseToRow hostRow (@vuna@prim_eff_fileMtime d)
    if mtime + grace < now then do
      size <- dirSizeOf d
      pure (Pair mtime (Pair size d) :: more)
    else pure more

fileNameOf : String -> String
fileNameOf path = case reverse (split "/" path) of
  [] => ""
  x :: _ => x

-- 候选 = 名字不在 roots 里、且 mtime 早于宽限窗口；带 size 便于容量判定。
gcCandidates : Int -> List String -> Int -> List String -> Eff hostRow (List (Pair Int (Pair Int String)))
gcCandidates _ _ _ [] = pure []
gcCandidates now keep grace (p :: rest) = do
  more <- gcCandidates now keep grace rest
  if memName (fileNameOf p) keep then pure more
  else do
    mtime <- raiseToRow hostRow (@vuna@prim_eff_fileMtime p)
    if mtime + grace < now then do
      size <- raiseToRow hostRow (@vuna@prim_eff_fileSize p)
      pure (Pair mtime (Pair size p) :: more)
    else pure more

sortByAge : List (Pair Int (Pair Int String)) -> List (Pair Int (Pair Int String))
sortByAge [] = []
sortByAge (x :: rest) = insertByAge x (sortByAge rest)

insertByAge : Pair Int (Pair Int String) -> List (Pair Int (Pair Int String)) -> List (Pair Int (Pair Int String))
insertByAge x [] = [x]
insertByAge x ((Pair k v) :: rest) =
  if firstOf x <= k then Base.List.Cons x (Base.List.Cons (Pair k v) rest)
  else Base.List.Cons (Pair k v) (insertByAge x rest)

-- 容量压力：最旧的先删，直到总量落到上限以下；上限 0 = 不限容量（全删候选）。
pickGo : Int -> Int -> List (Pair Int (Pair Int String)) -> List (Pair Int (Pair Int String)) -> List (Pair Int (Pair Int String))
pickGo _ _ [] acc = reverse acc
pickGo total maxBytes (r :: rest) acc =
  if total <= maxBytes then reverse acc
  else pickGo (total - firstOf (secondOf r)) maxBytes rest (r :: acc)

sumSizes : List (Pair String Int) -> Int
sumSizes [] = 0
sumSizes (p :: rest) = secondOf p + sumSizes rest

sizesOf : List String -> Eff hostRow (List (Pair String Int))
sizesOf [] = pure []
sizesOf (p :: rest) = do
  more <- sizesOf rest
  size <- raiseToRow hostRow (@vuna@prim_eff_fileSize p)
  pure (Pair p size :: more)

gcSweep : String -> List String -> Int -> Int -> Bool -> Eff hostRow Int
gcSweep root keep grace maxBytes dry = do
  now <- currentSec
  files <- gcFilesOf root
  fileCands <- gcCandidates now keep grace files
  viewDirs <- subDirsOf "${root}/views/bin"
  viewCands <- gcViewCandidates now keep grace viewDirs
  viewFiles <- concatMapEff (\d => walkFiles 1048576 d) viewDirs
  sizes <- sizesOf (append files viewFiles)
  let
    total = sumSizes sizes
    cands = append fileCands viewCands
    targets = pickGo total maxBytes (sortByAge cands) []
    paths = map (\q => secondOf (secondOf q)) targets
    n = length paths
    _ = dbg! "store-gc candidates=${length cands} delete=${strFromInt n} total=${strFromInt total}"
  in do
    _ <- if dry then pure 0 else removeEachPath paths
    _ <-
      @vuna@prim_eff_print
        "store-gc: ${storeVerb dry} ${strFromInt n} object(s) under ${root} (keep ${strFromInt (length keep)}, grace ${strFromInt grace}s)\n"
    pure 0

-- 当前 Unix 秒（GC 的宽限窗口判据）。
currentSec : Eff hostRow Int
currentSec = do
  us <- effTimeUs
  pure (us / 1000000)
