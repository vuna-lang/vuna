-- | lint 结果的内容寻址缓存。
--
-- 键覆盖：规则/编码 schema、编译器指纹、源文件内容、程序级 fixity 闭包、有效规则配置。
-- 抑制指令在源文件里，已被源内容哈希覆盖；路径不参与（finding 不携带路径，配置覆盖已在
-- 有效配置里）。只缓存成功 lint 的完整 finding（含 Edit），解析/抑制错误不缓存。
module Vuna.Lint.Cache where

import Base.Bool
import Base.Int
import Base.List
import Base.Maybe
import Base.String
import Base.Eff.Types
import Base.EffFs
import Base.EffEnv
import Base.EffProcess
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Hash
import Vuna.Compiler.Base.Store
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Elab.Canonical
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.Json
import Vuna.Lint.Config
import Vuna.Lint.Diagnostics
import Vuna.Lint.Rules

-- | 缓存 schema；规则实现或 finding 编码变化时 bump。
lintCacheSchema : String
lintCacheSchema = "vuna-lint-cache 3"

-- | Store codec 名。
lintCacheCodec : String
lintCacheCodec = "lint-findings 1"

-- | 有效配置的缓存身份：只看会影响 finding 的规则开关/严重度。
configCacheText : LintConfig -> String
configCacheText cfg =
  join "|" (map (\r => "${lintRule r}=${lintSeverityName (lintRuleSeverity cfg r)}") lintAllRules)

-- | 计算缓存 key。
export lintCacheKey : Member nFs FsOp r, Member nEnv EnvOp r => LintConfig -> List FixityDecl -> String -> Eff r String
lintCacheKey cfg fixities source =
  let
    fixityText = join "\n" (encFixities fixities [])
  in do
    fp <- toolCompilerFingerprint
    pure
      (contentAddress (join "|" [lintCacheSchema, strFromInt fp, configCacheText cfg, contentAddress source, contentAddress fixityText]))

-- | 带缓存的 lint：命中返回缓存 finding；未命中计算并写回。
export lintSourceWithCache : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => LintConfig -> List FixityDecl -> String -> Eff r (Check (List Finding))
lintSourceWithCache cfg fixities source = do
  key <- lintCacheKey cfg fixities source
  cached <- storeObjectReadEff "lint" lintCacheCodec key
  case cached of
    Just text => case decodeFindings text of
      Just findings => pure (OkC findings)
      Nothing => computeAndStore cfg fixities source key
    Nothing => computeAndStore cfg fixities source key

-- | 内部：计算并写回；只有成功的 finding 才落盘。
computeAndStore : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => LintConfig -> List FixityDecl -> String -> String -> Eff r (Check (List Finding))
computeAndStore cfg fixities source key = case lintSourceWithConfig cfg fixities source of
  ErrC e => pure (ErrC e)
  OkC findings => do
    _ <- storeObjectWriteEff "lint" lintCacheCodec key (encodeFindings findings)
    pure (OkC findings)

-- ---------------------------------------------------------------
-- JSON 载荷
-- ---------------------------------------------------------------
encodeFindings : List Finding -> String
encodeFindings findings = renderJson (JArr (map encodeFinding findings))

decodeFindings : String -> Maybe (List Finding)
decodeFindings text = case parseJson text of
  ErrC _ => Nothing
  OkC j => case jsonAsArr j of
    Nothing => Nothing
    Just xs => decodeList xs []

decodeList : List Json -> List Finding -> Maybe (List Finding)
decodeList [] acc = Just (reverse acc)
decodeList (x :: rest) acc = case decodeFinding x of
  Nothing => Nothing
  Just f => decodeList rest (f :: acc)

encodeFinding : Finding -> Json
encodeFinding f =
  JObj
    [Pair "line" (JNum f.findingLine), Pair "col" (JNum f.findingCol), Pair "endLine" (JNum f.findingEndLine), Pair "endCol" (JNum f.findingEndCol), Pair "code" (JStr f.findingCode), Pair "rule" (JStr f.findingRule), Pair "message" (JStr f.findingMessage), Pair "severity" (JStr (lintSeverityName f.findingSeverity)), Pair "edit" (encodeEdit f.findingEdit)]

encodeEdit : Maybe Edit -> Json
encodeEdit Nothing = JNull
encodeEdit (Just e) =
  JObj
    [Pair "start" (JNum e.editStart), Pair "end" (JNum e.editEnd), Pair "lines" (JArr (map JStr e.editLines))]

decodeFinding : Json -> Maybe Finding
decodeFinding j =
  let
    line = jsonGet "line" j
    col = jsonGet "col" j
    endLine = jsonGet "endLine" j
    endCol = jsonGet "endCol" j
    code = jsonGet "code" j
    rule = jsonGet "rule" j
    message = jsonGet "message" j
    sev = jsonGet "severity" j
  in case line of
    Nothing => Nothing
    Just lj => case col of
      Nothing => Nothing
      Just cj => case endLine of
        Nothing => Nothing
        Just elj => case endCol of
          Nothing => Nothing
          Just ecj => case code of
            Nothing => Nothing
            Just codeJ => case rule of
              Nothing => Nothing
              Just ruleJ => case message of
                Nothing => Nothing
                Just msgJ => case sev of
                  Nothing => Nothing
                  Just sevJ => decodeFields lj cj elj ecj codeJ ruleJ msgJ sevJ (jsonGet "edit" j)

decodeFields : Json -> Json -> Json -> Json -> Json -> Json -> Json -> Json -> Maybe Json -> Maybe Finding
decodeFields lj cj elj ecj codeJ ruleJ msgJ sevJ editJ = case jsonAsInt lj of
  Nothing => Nothing
  Just line => case jsonAsInt cj of
    Nothing => Nothing
    Just col => case jsonAsInt elj of
      Nothing => Nothing
      Just endLine => case jsonAsInt ecj of
        Nothing => Nothing
        Just endCol => case jsonAsStr codeJ of
          Nothing => Nothing
          Just code => case jsonAsStr ruleJ of
            Nothing => Nothing
            Just rule => case jsonAsStr msgJ of
              Nothing => Nothing
              Just message => case jsonAsStr sevJ of
                Nothing => Nothing
                Just sevName => case lintSeverityOfName sevName of
                  Nothing => Nothing
                  Just sev => case decodeEdit editJ of
                    Nothing => Nothing
                    Just Nothing =>
                      Just (Finding line col endLine endCol code rule message sev Nothing)
                    Just (Just edit) =>
                      Just (Finding line col endLine endCol code rule message sev (Just edit))

decodeEdit : Maybe Json -> Maybe (Maybe Edit)
decodeEdit Nothing = Just Nothing
decodeEdit (Just JNull) = Just Nothing
decodeEdit (Just j) = case jsonGet "start" j of
  Nothing => Nothing
  Just aj => case jsonGet "end" j of
    Nothing => Nothing
    Just bj => case jsonGet "lines" j of
      Nothing => Nothing
      Just cj => case jsonAsInt aj of
        Nothing => Nothing
        Just start => case jsonAsInt bj of
          Nothing => Nothing
          Just end => case jsonAsArr cj of
            Nothing => Nothing
            Just lines => case decodeStrings lines [] of
              Just ls => Just (Just (Edit start end ls))
              Nothing => Nothing

decodeStrings : List Json -> List String -> Maybe (List String)
decodeStrings [] acc = Just (reverse acc)
decodeStrings (x :: rest) acc = case jsonAsStr x of
  Nothing => Nothing
  Just s => decodeStrings rest (s :: acc)
