module Vuna.Lint.Rules
  ( Edit
  , Finding
  , editEnd
  , editLines
  , editStart
  , findingCode
  , findingCol
  , findingEdit
  , findingLine
  , findingMessage
  , findingRule
  , isNilList
  , joinLines
  , lintSource
  , splitLines
  ) where

-- Vuna.Lint.Rules：lint 的规则检查与语法层工具（M24 后维护·源码重组，从 Vuna.Lint 拆出）。
--
-- 只做语法层分析：Lexer 取 token 行列 + 按行文本扫描。规则产出 `Finding`
-- （行列 + 规则名 + 消息 + 可选的 `Edit` 修复描述），由 Vuna.Lint.Fix 应用修复、
-- 门面负责 CLI 与打印。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser

data Edit : Type where
  Edit : Int -> Int -> List String -> Edit

data Finding : Type where
  Finding : Int -> Int -> String -> String -> String -> Maybe Edit -> Finding

data LitBranch : Type where
  LitBranch : String -> String -> LitBranch

data IfHead : Type where
  IfHead : String -> String -> String -> IfHead

data Enclosing : Type where
  Enclosing : Int -> List PTok -> String -> Enclosing

data CaseBody : Type where
  CaseBody : Int -> List String -> CaseBody

editStart : Edit -> Int
editStart (Edit start stop lines) = start

editEnd : Edit -> Int
editEnd (Edit start stop lines) = stop

editLines : Edit -> List String
editLines (Edit start stop lines) = lines

findingLine : Finding -> Int
findingLine (Finding line col code rule message edit) = line

findingCol : Finding -> Int
findingCol (Finding line col code rule message edit) = col

findingCode : Finding -> String
findingCode (Finding line col code rule message edit) = code

findingRule : Finding -> String
findingRule (Finding line col code rule message edit) = rule

findingMessage : Finding -> String
findingMessage (Finding line col code rule message edit) = message

findingEdit : Finding -> Maybe Edit
findingEdit (Finding line col code rule message edit) = edit

litText : LitBranch -> String
litText (LitBranch text expr) = text

litExpr : LitBranch -> String
litExpr (LitBranch text expr) = expr

headName : IfHead -> String
headName (IfHead name text expr) = name

headText : IfHead -> String
headText (IfHead name text expr) = text

headExpr : IfHead -> String
headExpr (IfHead name text expr) = expr

enclosingLine : Enclosing -> Int
enclosingLine (Enclosing line toks kind) = line

enclosingToks : Enclosing -> List PTok
enclosingToks (Enclosing line toks kind) = toks

enclosingKind : Enclosing -> String
enclosingKind (Enclosing line toks kind) = kind

caseBodyEnd : CaseBody -> Int
caseBodyEnd (CaseBody stop lines) = stop

caseBodyLines : CaseBody -> List String
caseBodyLines (CaseBody stop lines) = lines

isNilList : List a -> Bool
isNilList [] = True
isNilList (x :: rest) = False

notBool : Bool -> Bool
notBool b = if b then False else True

isSpaceChar : Int -> Bool
isSpaceChar c = c == 32 || c == 9

spaceChars : Int -> List Int
spaceChars n = if n <= 0 then [] else 32 :: spaceChars (n - 1)

spaces : Int -> String
spaces n = strPack (spaceChars n)

indentOf : String -> Int
indentOf line = indentChars (strUnpack line)

indentChars : List Int -> Int
indentChars [] = 0
indentChars (c :: rest) =
  if c == 32 then 1 + indentChars rest else if c == 9 then 1 + indentChars rest else 0

isBlankLine : String -> Bool
isBlankLine line = blankChars (strUnpack line)

blankChars : List Int -> Bool
blankChars [] = True
blankChars (c :: rest) = isSpaceChar c && blankChars rest

splitLines : String -> List String
splitLines source = splitLinesFrom (strUnpack source) [] []

splitLinesFrom : List Int -> List String -> List Int -> List String
splitLinesFrom [] acc cur = reverse (strPack (reverse cur) :: acc)
splitLinesFrom (c :: rest) acc cur =
  if c == 10 then splitLinesFrom rest (strPack (reverse cur) :: acc) []
  else splitLinesFrom rest acc (c :: cur)

joinLines : List String -> String
joinLines [] = ""
joinLines (line :: rest) = line ++ "\n" ++ joinLines rest

nthLine : List String -> Int -> String
nthLine [] n = ""
nthLine (line :: rest) n = if n <= 1 then line else nthLine rest (n - 1)

lineAt : List String -> Int -> String
lineAt lines n = nthLine lines n

takeChars : Int -> List a -> List a
takeChars n [] = []
takeChars n (c :: rest) = if n <= 0 then [] else c :: takeChars (n - 1) rest

dropChars : Int -> List a -> List a
dropChars n chars = if n <= 0 then chars
else case chars of
  [] => []
  c :: rest => dropChars (n - 1) rest

sliceChars : Int -> Int -> List a -> List a
sliceChars start count chars = takeChars count (dropChars start chars)

sliceLine : Int -> Int -> String -> String
sliceLine start count line = strPack (sliceChars start count (strUnpack line))

dropIndent : Int -> String -> String
dropIndent n line = strPack (dropChars n (strUnpack line))

nthChar : Int -> List Int -> Int
nthChar i [] = 0
nthChar i (c :: rest) = if i <= 0 then c else nthChar (i - 1) rest

trimLen : List Int -> Int -> Int
trimLen chars n =
  if n <= 0 then 0 else if isSpaceChar (nthChar (n - 1) chars) then trimLen chars (n - 1) else n

trimEnd : String -> String
trimEnd line =
  strPack (takeChars (trimLen (strUnpack line) (length (strUnpack line))) (strUnpack line))

dropSpaceChars : List Int -> List Int
dropSpaceChars chars = case chars of
  [] => []
  c :: rest => if isSpaceChar c then dropSpaceChars rest else chars

trimStart : String -> String
trimStart line = strPack (dropSpaceChars (strUnpack line))

trimBoth : String -> String
trimBoth line = trimStart (trimEnd line)

textFromCol : String -> Int -> String
textFromCol line col = trimBoth (strPack (dropChars (col - 1) (strUnpack line)))

blankFill : Int -> Int -> List String
blankFill n stop = blankFillEach (range n (stop + 1))

-- 计数器循环改为对 line 编号列表的结构递归（range 用倒计数实现，M25.2b 已可证）。
blankFillEach : List Int -> List String
blankFillEach [] = []
blankFillEach (_ :: rest) = "" :: blankFillEach rest

tailFromCol : String -> Int -> String
tailFromCol line col = strPack (dropChars (col - 1) (strUnpack line))

startsLower : String -> Bool
startsLower name = case strUnpack name of
  [] => False
  c :: rest => c >= 97 && c <= 122

startsUpper : String -> Bool
startsUpper name = case strUnpack name of
  [] => False
  c :: rest => c >= 65 && c <= 90

prefixChars : List Int -> List Int -> Bool
prefixChars [] text = True
prefixChars (p :: prest) text = case text of
  [] => False
  t :: trest => if p == t then prefixChars prest trest else False

containsSubChars : List Int -> List Int -> Bool
containsSubChars pat text = case text of
  [] => False
  c :: rest => if prefixChars pat text then True else containsSubChars pat rest

containsChar : Int -> List Int -> Bool
containsChar c [] = False
containsChar c (x :: rest) = if x == c then True else containsChar c rest

hasComment : String -> Bool
hasComment line =
  containsSubChars (strUnpack "--") (strUnpack line)
    || containsSubChars (strUnpack "{-") (strUnpack line)

hasTabOrCR : String -> Bool
hasTabOrCR line = containsChar 9 (strUnpack line) || containsChar 13 (strUnpack line)

posLine : Pos -> Int
posLine (Pos line col) = line

posCol : Pos -> Int
posCol (Pos line col) = col

tokPos : PTok -> Pos
tokPos (PTok t p) = p

tokLine : PTok -> Int
tokLine tok = posLine (tokPos tok)

tokCol : PTok -> Int
tokCol tok = posCol (tokPos tok)

tokIsKw : PTok -> String -> Bool
tokIsKw tok key = case tok of
  PTok (TKw x) p => x == key
  _ => False

tokIsSym : PTok -> String -> Bool
tokIsSym tok sym = case tok of
  PTok (TSym x) p => x == sym
  _ => False

tokIdentOf : PTok -> Maybe String
tokIdentOf tok = case tok of
  PTok (TIdent x) p => Just x
  _ => Nothing

tokStrOf : PTok -> Maybe String
tokStrOf tok = case tok of
  PTok (TStr x) p => Just x
  _ => Nothing

tokIntOf : PTok -> Maybe Int
tokIntOf tok = case tok of
  PTok (TInt x) p => Just x
  _ => Nothing

headToken : List a -> Maybe a
headToken [] = Nothing
headToken (t :: rest) = Just t

lastToken : List a -> Maybe a
lastToken [] = Nothing
lastToken ([t]) = Just t
lastToken (t :: rest) = lastToken rest

tokensOnLine : List PTok -> Int -> List PTok
tokensOnLine toks n = filterTokLine toks n

filterTokLine : List PTok -> Int -> List PTok
filterTokLine [] n = []
filterTokLine (t :: rest) n =
  if tokLine t == n then t :: filterTokLine rest n else filterTokLine rest n

bodyMentionsVar : List PTok -> String -> Int -> Int -> Bool
bodyMentionsVar toks var start stop = bodyMentionsVarGo toks var (range start stop)

bodyMentionsVarGo : List PTok -> String -> List Int -> Bool
bodyMentionsVarGo toks var [] = False
bodyMentionsVarGo toks var (k :: rest) =
  if countIdent var (tokensOnLine toks k) > 0 then True else bodyMentionsVarGo toks var rest

hasSym : List PTok -> String -> Bool
hasSym [] sym = False
hasSym (t :: rest) sym = if tokIsSym t sym then True else hasSym rest sym

tailOf : List a -> List a
tailOf [] = []
tailOf (t :: rest) = rest

splitAtSym : String -> List PTok -> Maybe (Pair (List PTok) (Pair PTok (List PTok)))
splitAtSym sym toks = splitAtSymGo sym toks []

splitAtSymGo : String -> List PTok -> List PTok -> Maybe (Pair (List PTok) (Pair PTok (List PTok)))
splitAtSymGo sym [] acc = Nothing
splitAtSymGo sym (t :: rest) acc =
  if tokIsSym t sym then Just (Pair (reverse acc) (Pair t rest))
  else splitAtSymGo sym rest (t :: acc)

countIdent : String -> List PTok -> Int
countIdent name [] = 0
countIdent name (t :: rest) = case tokIdentOf t of
  Just other => if other == name then 1 + countIdent name rest else countIdent name rest
  Nothing => countIdent name rest

lowercaseIdents : List PTok -> List String
lowercaseIdents [] = []
lowercaseIdents (t :: rest) = case tokIdentOf t of
  Just name =>
    if startsLower name && name /= "_" then name :: lowercaseIdents rest else lowercaseIdents rest
  Nothing => lowercaseIdents rest

intersects : List String -> List String -> Bool
intersects [] ys = False
intersects (x :: rest) ys = if memName x ys then True else intersects rest ys

isSimpleTokens : List PTok -> Bool
isSimpleTokens toks = simpleFrom toks 0 && noKeyword toks

simpleFrom : List PTok -> Int -> Bool
simpleFrom [] depth = depth == 0
simpleFrom (t :: rest) depth = case t of
  PTok (TSym s) p =>
    if s == "(" || s == "[" then simpleFrom rest (depth + 1)
    else if s == ")" || s == "]" then if depth > 0 then simpleFrom rest (depth - 1) else False
    else simpleFrom rest depth
  _ => simpleFrom rest depth

noKeyword : List PTok -> Bool
noKeyword [] = True
noKeyword (t :: rest) = case t of
  PTok (TKw x) p => False
  _ => noKeyword rest

startsWithIf : List PTok -> Bool
startsWithIf toks = case toks of
  t :: rest => tokIsKw t "if"
  [] => False

parseIfHead : List PTok -> String -> Maybe IfHead
parseIfHead toks line = case toks of
  [] => Nothing
  t1 :: rest => case tokIdentOf t1 of
    Nothing => Nothing
    Just name => case rest of
      [] => Nothing
      t2 :: rest2 => if tokIsSym t2 "==" then case rest2 of
        [] => Nothing
        t3 :: rest3 => case tokStrOf t3 of
          Nothing => Nothing
          Just lit => case rest3 of
            [] => Nothing
            t4 :: rest4 =>
              if tokIsKw t4 "then" then if isNilList rest4 then Nothing
              else if isSimpleTokens rest4 then Just
                (IfHead name (trimEnd (sliceLine (tokCol t3 - 1) (tokCol t4 - tokCol t3) line)) (textFromCol line (tokCol t4 + 4)))
              else Nothing
              else Nothing
      else Nothing

finalElseText : String -> PTok -> List PTok -> Maybe String
finalElseText line elseTok rest =
  if isNilList rest then Nothing
  else if startsWithIf rest then Nothing
  else if isSimpleTokens rest then Just (textFromCol line (tokCol elseTok + 4)) else Nothing

renderLitBranch : Int -> LitBranch -> String
renderLitBranch indent branch = spaces (indent + 2) ++ litText branch ++ " => " ++ litExpr branch

makeChainFinding : Int -> Int -> String -> List LitBranch -> String -> Int -> List Finding
-- @code LN_LiteralIfChain
-- @rule literal-if-chain
-- @fixable
-- @msg if/else-if chain on <scrutinee> can be a case with literal patterns
-- @edit 改写为 case 表达式：字面量分支 + 兜底 `_ =>`
-- @desc if/else-if 字面量链可改写为 case 表达式。
makeChainFinding firstLine indent scrutinee acc defaultText lastLine =
  let
    branches = reverse acc
  in if length branches < 2 then []
  else
    let
      newLines =
        append [spaces indent ++ "case " ++ scrutinee ++ " of"]
          (append (map (\b => renderLitBranch indent b) branches) [spaces (indent + 2) ++ "_ => " ++ defaultText])
    in [ Finding firstLine (indent + 1) "LN_LiteralIfChain" "literal-if-chain" ("if/else-if chain on `" ++ scrutinee ++ "` can be a case with literal patterns") (Just (Edit firstLine lastLine newLines))
    ]

finishChain : List String -> List PTok -> Int -> Int -> Int -> Int -> String -> List LitBranch -> List Finding
finishChain lines toks lastLine n indent firstLine scrutinee acc =
  finishChainGo lines toks indent firstLine scrutinee acc (range n (lastLine + 1))

finishChainGo : List String -> List PTok -> Int -> Int -> String -> List LitBranch -> List Int -> List Finding
finishChainGo lines toks indent firstLine scrutinee acc [] = []
finishChainGo lines toks indent firstLine scrutinee acc (k :: rest) =
  let
    line = lineAt lines k
  in let
    ts = tokensOnLine toks k
  in if isNilList ts then []
  else if indentOf line /= indent then []
  else if hasComment line then []
  else case ts of
    [] => []
    first :: rest2 => if tokIsKw first "else" then case rest2 of
      [] => []
      second :: rest3 => if tokIsKw second "if" then case parseIfHead rest3 line of
        Nothing => []
        Just head =>
          if headName head == scrutinee then finishChainGo lines toks indent firstLine scrutinee
            (LitBranch (headText head) (headExpr head) :: acc) rest
          else []
      else case finalElseText line first rest2 of
        Nothing => []
        Just text => makeChainFinding firstLine indent scrutinee acc text k
    else []

ifChainAt : List String -> List PTok -> Int -> Int -> List Finding
ifChainAt lines toks lastLine n =
  let
    line = lineAt lines n
  in let
    ts = tokensOnLine toks n
  in if isNilList ts then []
  else if hasComment line then []
  else case ts of
    [] => []
    first :: rest => if tokIsKw first "if" && tokCol first == indentOf line + 1 then case parseIfHead rest line of
      Nothing => []
      Just head =>
        finishChain lines toks lastLine (n + 1) (indentOf line) n (headName head)
          [LitBranch (headText head) (headExpr head)]
    else []

scanIfChains : List String -> List PTok -> Int -> Int -> List Finding
scanIfChains lines toks n lastLine = scanIfChainsGo lines toks lastLine (range n (lastLine + 1))

scanIfChainsGo : List String -> List PTok -> Int -> List Int -> List Finding
scanIfChainsGo lines toks lastLine [] = []
scanIfChainsGo lines toks lastLine (k :: rest) =
  append (ifChainAt lines toks lastLine k) (scanIfChainsGo lines toks lastLine rest)

caseVarOf : List PTok -> Maybe String
caseVarOf toks = case toks of
  [] => Nothing
  t1 :: rest => if tokIsKw t1 "case" then case rest of
    [] => Nothing
    t2 :: rest2 => case tokIdentOf t2 of
      Nothing => Nothing
      Just name => case rest2 of
        [] => Nothing
        t3 :: rest3 => if tokIsKw t3 "of" && isNilList rest3 then Just name else Nothing
  else Nothing

enclosingClause : List String -> List PTok -> Int -> Maybe Enclosing
enclosingClause lines toks headLine = if headLine < 1 then Nothing
else
  let
    line = lineAt lines headLine
  in if isBlankLine line then Nothing
  else if indentOf line /= 0 then Nothing
  else
    let
      ts = tokensOnLine toks headLine
    in if hasSym ts "=" && notBool (hasSym ts "=>") then Just (Enclosing headLine ts "clause")
    else Nothing

enclosingAlt : List String -> List PTok -> Int -> Int -> Maybe Enclosing
enclosingAlt lines toks headLine expectedIndent = if headLine < 1 then Nothing
else
  let
    line = lineAt lines headLine
  in if isBlankLine line then Nothing
  else if indentOf line /= expectedIndent then Nothing
  else
    let
      ts = tokensOnLine toks headLine
    in if hasSym ts "\\" then Nothing
    else case lastToken ts of
      Nothing => Nothing
      Just t => if tokIsSym t "=>" then Just (Enclosing headLine ts "alt") else Nothing

enclosingOf : List String -> List PTok -> Int -> Int -> Maybe Enclosing
enclosingOf lines toks caseLine indent =
  if indent == 2 then enclosingClause lines toks (caseLine - 1)
  else enclosingAlt lines toks (caseLine - 1) (indent - 2)

ctorOrLitPattern : List PTok -> Bool
ctorOrLitPattern toks = case toks of
  [] => False
  t :: rest => case tokIdentOf t of
    Just name => startsUpper name
    Nothing => case tokIntOf t of
      Just n => True
      Nothing => case tokStrOf t of
        Just s => True
        Nothing => False

scanBody : List String -> List PTok -> Int -> Int -> Int -> List String -> CaseBody
scanBody lines toks lastLine n indent acc =
  scanBodyGo lines lastLine indent acc (range n (lastLine + 1))

scanBodyGo : List String -> Int -> Int -> List String -> List Int -> CaseBody
scanBodyGo lines lastLine indent acc [] = CaseBody (lastLine + 1) (reverse acc)
scanBodyGo lines lastLine indent acc (k :: rest) =
  let
    line = lineAt lines k
  in if isBlankLine line then scanBodyGo lines lastLine indent (line :: acc) rest
  else if indentOf line > indent then scanBodyGo lines lastLine indent (line :: acc) rest
  else CaseBody k (reverse acc)

blockBodyOk : List String -> List PTok -> Int -> Int -> Int -> Int -> Bool
blockBodyOk lines toks lastLine start stop indent =
  if start >= stop then False
  else if bodyIndentOk lines start stop indent && noSiblingAlt lines toks start stop indent then True
  else False

bodyIndentOk : List String -> Int -> Int -> Int -> Bool
bodyIndentOk lines n stop indent = bodyIndentOkGo lines indent (range n stop)

bodyIndentOkGo : List String -> Int -> List Int -> Bool
bodyIndentOkGo lines indent [] = True
bodyIndentOkGo lines indent (k :: rest) =
  let
    line = lineAt lines k
  in if isBlankLine line then bodyIndentOkGo lines indent rest
  else if hasComment line || hasTabOrCR line then False
  else if indentOf line < indent + 4 then False else bodyIndentOkGo lines indent rest

noSiblingAlt : List String -> List PTok -> Int -> Int -> Int -> Bool
noSiblingAlt lines toks n stop indent = noSiblingAltGo lines toks indent (range n stop)

noSiblingAltGo : List String -> List PTok -> Int -> List Int -> Bool
noSiblingAltGo lines toks indent [] = True
noSiblingAltGo lines toks indent (k :: rest) =
  let
    line = lineAt lines k
  in let
    ts = tokensOnLine toks k
  in if isBlankLine line then noSiblingAltGo lines toks indent rest
  else if indentOf line == indent + 2 && hasSym ts "=>" then False
  else noSiblingAltGo lines toks indent rest

nextNonBlank : List String -> Int -> Int -> Int
nextNonBlank lines n lastLine = nextNonBlankGo lines lastLine (range n (lastLine + 1))

nextNonBlankGo : List String -> Int -> List Int -> Int
nextNonBlankGo lines lastLine [] = lastLine + 1
nextNonBlankGo lines lastLine (k :: rest) =
  let
    line = lineAt lines k
  in if isBlankLine line then nextNonBlankGo lines lastLine rest else k

tailTokenCol : PTok -> Int
tailTokenCol tok = tokCol tok + strLength (tokenText tok)

tokenText : PTok -> String
tokenText tok = case tok of
  PTok (TIdent x) p => x
  PTok (TKw x) p => x
  PTok (TInt x) p => strFromInt x
  PTok (TStr x) p => x
  PTok (TSym x) p => x
  PTok TEof p => ""

replaceIdentInLine : String -> PTok -> String -> String
replaceIdentInLine line tok replacement =
  let
    col = tokCol tok
    len = strLength (tokenText tok)
    prefix = sliceLine 0 (col - 1) line
    suffix = tailFromCol line (col + len)
  in prefix ++ replacement ++ suffix

clauseHeadPatterns : List PTok -> Maybe (Pair String (List PTok))
clauseHeadPatterns toks = case splitAtSym "=" toks of
  Nothing => Nothing
  Just (Pair before (Pair arrow after)) => if isNilList after then case before of
    [] => Nothing
    fn :: rest => Just (Pair (tokenText fn) rest)
  else Nothing

altHeadPatterns : List PTok -> Maybe (List PTok)
altHeadPatterns toks = case splitAtSym "=>" toks of
  Nothing => Nothing
  Just (Pair before (Pair arrow after)) => if isNilList after then Just before else Nothing

lastClauseCheck : List String -> List PTok -> Int -> Int -> String -> Bool
lastClauseCheck lines toks lastLine stop fnName =
  let
    next = nextNonBlank lines stop lastLine
  in if next > lastLine then True
  else
    let
      line = lineAt lines next
    in if indentOf line /= 0 then False
    else
      let
        ts = tokensOnLine toks next
      in case headToken ts of
        Nothing => False
        Just t => case tokIdentOf t of
          Just other => notBool (other == fnName)
          Nothing => True

lastAltCheck : List String -> List PTok -> Int -> Int -> Int -> Bool
lastAltCheck lines toks lastLine stop indent =
  let
    next = nextNonBlank lines stop lastLine
  in if next > lastLine then True
  else
    let
      line = lineAt lines next
    in let
      ind = indentOf line
    in if ind == indent - 2 then if hasSym (tokensOnLine toks next) "=>" then False else True
    else if ind < indent - 2 then True else False

linesClean : List String -> Int -> Int -> Bool
linesClean lines start stop = linesCleanGo lines (range start (stop + 1))

linesCleanGo : List String -> List Int -> Bool
linesCleanGo lines [] = True
linesCleanGo lines (k :: rest) =
  let
    line = lineAt lines k
  in if hasComment line || hasTabOrCR line then False else linesCleanGo lines rest

checkRedundantBody : List String -> List PTok -> Int -> Int -> Int -> String -> Enclosing -> List Finding
checkRedundantBody lines toks lastLine caseLine indent var enclosing =
  let
    headLine = enclosingLine enclosing
    headToks = enclosingToks enclosing
    kind = enclosingKind enclosing
    altLine = caseLine + 1
  in if altLine > lastLine then []
  else
    let
      altText = lineAt lines altLine
    in if isBlankLine altText then []
    else if indentOf altText /= indent + 2 then []
    else
      let
        altToks = tokensOnLine toks altLine
      in case splitAtSym "=>" altToks of
        Nothing => []
        Just (Pair patToks (Pair arrow bodyToks)) => if isNilList patToks then []
        else if notBool (ctorOrLitPattern patToks) then []
        else
          let
            patText =
              trimEnd
                (sliceLine (tokCol (headOfTokens patToks) - 1) (tokCol arrow - tokCol (headOfTokens patToks)) altText)
          in if isNilList bodyToks then blockShape lines toks lastLine caseLine indent var enclosing patToks patText arrow
          else inlineShape lines toks lastLine caseLine indent var enclosing patToks patText arrow
            bodyToks

headOfTokens : List PTok -> PTok
headOfTokens [] = PTok TEof (Pos 1 1)
headOfTokens (t :: rest) = t

inlineShape : List String -> List PTok -> Int -> Int -> Int -> String -> Enclosing -> List PTok -> String -> PTok -> List PTok -> List Finding
inlineShape lines toks lastLine caseLine indent var enclosing patToks patText arrow bodyToks =
  let
    altLine = caseLine + 1
    altText = lineAt lines altLine
    next = nextNonBlank lines (altLine + 1) lastLine
  in if notBool (simpleFrom bodyToks 0) then []
  else if next <= lastLine && indentOf (lineAt lines next) >= indent then []
  else if notBool (linesClean lines (enclosingLine enclosing) (caseLine + 1)) then []
  else
    let
      bodyText = textFromCol altText (tokCol arrow + 2)
      tailEnd = if next > lastLine then lastLine else next - 1
      newBody = (spaces indent ++ bodyText) :: blankFill (altLine + 1) tailEnd
    in redundantFinding lines toks lastLine caseLine indent var enclosing patToks patText
      (countIdent var bodyToks > 0) next newBody

blockShape : List String -> List PTok -> Int -> Int -> Int -> String -> Enclosing -> List PTok -> String -> PTok -> List Finding
blockShape lines toks lastLine caseLine indent var enclosing patToks patText arrow =
  let
    altLine = caseLine + 1
    scanned = scanBody lines toks lastLine (altLine + 1) indent []
  in case scanned of
    CaseBody stop rawLines => if stop <= altLine + 1 then []
    else if notBool (stop > lastLine || indentOf (lineAt lines stop) < indent) then []
    else if notBool (blockBodyOk lines toks lastLine (altLine + 1) stop indent) then []
    else if notBool (linesClean lines (enclosingLine enclosing) (stop - 1)) then []
    else
      let
        newBody = map (\line => dropIndent 4 line) rawLines
      in redundantFinding lines toks lastLine caseLine indent var enclosing patToks patText
        (bodyMentionsVar toks var (altLine + 1) stop) stop newBody

redundantFinding : List String -> List PTok -> Int -> Int -> Int -> String -> Enclosing -> List PTok -> String -> Bool -> Int -> List String -> List Finding
-- @code LN_RedundantCase
-- @rule redundant-case
-- @fixable
-- @msg single-alternative case on <var> can be folded into the enclosing pattern
-- @edit 把单分支 case 折叠进外层模式（需无冲突且体不提及被折叠变量）
-- @desc 单分支 case 可折叠进外层模式（需满足 enclosing 安全判据）。
redundantFinding lines toks lastLine caseLine indent var enclosing patToks patText mentions stop newBody =
  let
    headLine = enclosingLine enclosing
    headToks = enclosingToks enclosing
    kind = enclosingKind enclosing
    headText = lineAt lines headLine
  in case tokenOfVar var headToks of
    Nothing => []
    Just varTok => case enclosingPatterns kind headToks of
      Nothing => []
      Just (Pair fnOrKind patArea) =>
        let
          outerNames = lowercaseIdents patArea
          innerNames = lowercaseIdents patToks
          otherOuter = removeName var outerNames
          conflict = intersects innerNames otherOuter
          oneOccurrence = countIdent var patArea == 1
          lastOk = enclosingIsLast lines toks lastLine stop indent kind fnOrKind
          cleanOk = linesClean lines headLine (caseLine + 1)
        in if notBool oneOccurrence then []
        else if conflict then []
        else
          let
            newHead = replaceIdentInLine headText varTok ("(" ++ patText ++ ")")
            newLines = newHead :: newBody
            fixable = lastOk && cleanOk && notBool mentions
            edit = if fixable then Just (Edit headLine (stop - 1) newLines) else Nothing
          in [ Finding caseLine (indent + 1) "LN_RedundantCase" "redundant-case" ("single-alternative case on `" ++ var ++ "` can be folded into the enclosing pattern") edit
          ]

tokenOfVar : String -> List PTok -> Maybe PTok
tokenOfVar name [] = Nothing
tokenOfVar name (t :: rest) = case tokIdentOf t of
  Just other => if other == name then Just t else tokenOfVar name rest
  Nothing => tokenOfVar name rest

removeName : String -> List String -> List String
removeName name [] = []
removeName name (x :: rest) = if x == name then removeName name rest else x :: removeName name rest

enclosingPatterns : String -> List PTok -> Maybe (Pair String (List PTok))
enclosingPatterns kind headToks = if kind == "clause" then case clauseHeadPatterns headToks of
  Nothing => Nothing
  Just (Pair fnName pats) => Just (Pair fnName pats)
else case altHeadPatterns headToks of
  Nothing => Nothing
  Just pats => Just (Pair "" pats)

enclosingIsLast : List String -> List PTok -> Int -> Int -> Int -> String -> String -> Bool
enclosingIsLast lines toks lastLine stop indent kind fnOrKind =
  if kind == "clause" then lastClauseCheck lines toks lastLine stop fnOrKind
  else lastAltCheck lines toks lastLine stop indent

redundantCaseAt : List String -> List PTok -> Int -> Int -> List Finding
redundantCaseAt lines toks lastLine n =
  let
    line = lineAt lines n
  in let
    indent = indentOf line
  in let
    ts = tokensOnLine toks n
  in case caseVarOf ts of
    Nothing => []
    Just var => case enclosingOf lines toks n indent of
      Nothing => []
      Just enclosing => checkRedundantBody lines toks lastLine n indent var enclosing

scanRedundant : List String -> List PTok -> Int -> Int -> List Finding
scanRedundant lines toks n lastLine = scanRedundantGo lines toks lastLine (range n (lastLine + 1))

scanRedundantGo : List String -> List PTok -> Int -> List Int -> List Finding
scanRedundantGo lines toks lastLine [] = []
scanRedundantGo lines toks lastLine (k :: rest) =
  append (redundantCaseAt lines toks lastLine k) (scanRedundantGo lines toks lastLine rest)

sortFindings : List Finding -> List Finding
sortFindings [] = []
sortFindings (f :: rest) = insertFinding f (sortFindings rest)

insertFinding : Finding -> List Finding -> List Finding
insertFinding f [] = [f]
insertFinding f (g :: rest) =
  if findingLine f < findingLine g then f :: g :: rest
  else if findingLine f == findingLine g && findingCol f <= findingCol g then f :: g :: rest
  else g :: insertFinding f rest

lintSource : String -> Result (List Finding)
lintSource source = case parseSource "<lint>" source of
  Err e => Err e
  Ok ignored => case lexSource source of
    Err e => Err e
    Ok toks =>
      let
        lines = splitLines source
      in Ok
        (sortFindings (append (scanIfChains lines toks 1 (length lines)) (scanRedundant lines toks 1 (length lines))))
