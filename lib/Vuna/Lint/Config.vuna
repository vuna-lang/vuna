-- | lint 配置：读取 `vuna.toml` 的 `[lint]` section 并合并成规则开关/严重度。
--
-- 编译器只把 `[lint]` 当 TOML 结构放行（见 `Frontend.Manifest`）；规则名、severity、
-- 未知 key 等语义由本模块在 lint 消费时校验。配置从文件所在目录向上收集 manifest：
-- 外层（workspace 根）先应用，内层（包/manifest）覆盖，最后才是命令行 flag。
module Vuna.Lint.Config where

import Base.Bool
import Base.List
import Base.Maybe
import Base.Pair
import Base.String
import Base.Eff.Types
import Base.EffFs
import Vuna.Cli.Args
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Toml
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Lint.Diagnostics

-- | 已合并的 lint 配置。`lintCfgRules` 覆盖全部规则（off 也显式列出，避免默认值漂移）。
export record LintConfig(..) where
  -- | 规则 → 严重度。
  lintCfgRules : List (Pair LintRule LintSeverity)
  -- | `max-warnings`；`Nothing` = 沿用上层/默认（默认不限）。
  lintCfgMaxWarnings : Maybe Int
  -- | 排除路径模式（相对 manifest 目录；CLI 目标展开时使用）。
  lintCfgExclude : List String
  -- | 配置来源（诊断用；空串 = 默认配置）。
  lintCfgSource : String

-- | 默认配置：recommended 预设、warning 不设上限。
export defaultLintConfig : LintConfig
defaultLintConfig =
  LintConfig
    (map (\r => Pair r (if lintRecommended r then lintDefaultSeverity r else LintOff)) lintAllRules)
    Nothing [] ""

-- | 某种预设下的规则表。
presetRules : String -> List (Pair LintRule LintSeverity)
presetRules preset =
  map
    (\r => Pair r (if preset == "all" then lintDefaultSeverity r else if preset == "none" then LintOff else if preset == "recommended" && lintRecommended r then lintDefaultSeverity r else LintOff))
    lintAllRules

-- | 配置里某规则的严重度；配置表覆盖全部规则，缺失时回落默认值。
export lintRuleSeverity : LintConfig -> LintRule -> LintSeverity
lintRuleSeverity cfg rule = case lookupRule rule cfg.lintCfgRules of
  Just sev => sev
  Nothing => lintDefaultSeverity rule

-- | 内部：在规则表里查规则。
lookupRule : LintRule -> List (Pair LintRule LintSeverity) -> Maybe LintSeverity
lookupRule rule [] = Nothing
lookupRule rule ((Pair r sev) :: rest) = if sameRule r rule then Just sev else lookupRule rule rest

-- | 内部：规则相等（枚举比较；单独具名便于以后扩展）。
sameRule : LintRule -> LintRule -> Bool
sameRule a b = lintCode a == lintCode b

-- | 有效规则列表（off 不参与扫描）。
export lintEnabledRules : LintConfig -> List LintRule
lintEnabledRules cfg = filter (\r => lintRuleSeverity cfg r /= LintOff) lintAllRules

-- | 有效 `max-warnings`；未设置时 -1（不限）。
export lintMaxWarnings : LintConfig -> Int
lintMaxWarnings cfg = case cfg.lintCfgMaxWarnings of
  Just n => n
  Nothing => -1

-- | 路径是否被配置排除（当前支持目录/文件前缀与 `*` 通配；模式相对 manifest 目录）。
export lintExcluded : String -> LintConfig -> Bool
lintExcluded path cfg = anyPattern path cfg.lintCfgExclude

-- | 内部：任一模式命中。
anyPattern : String -> List String -> Bool
anyPattern path [] = False
anyPattern path (p :: rest) = matchPattern p path || anyPattern path rest

-- | 内部：极简 glob：`*` 匹配一段（不跨 `/`），`**` 匹配任意段。
export matchPattern : String -> String -> Bool
matchPattern pattern path =
  matchPatternChars (strLength pattern + strLength path + 1) (strUnpack pattern) (strUnpack path)

-- | 内部：逐段匹配；fuel 保证互递归的终止性证明。
matchPatternChars : Int -> List Int -> List Int -> Bool
matchPatternChars fuel pattern path =
  if fuel <= 0 then False else matchPatternCharsGo (fuel - 1) pattern path

-- | 内部：`matchPatternChars` 的主体（fuel 已扣减）。
matchPatternCharsGo : Int -> List Int -> List Int -> Bool
matchPatternCharsGo fuel [] [] = True
matchPatternCharsGo fuel [] _ = False
matchPatternCharsGo fuel (42 :: 42 :: rest) path = matchAnyTail fuel rest path
matchPatternCharsGo fuel (42 :: rest) path = matchStar fuel rest path
matchPatternCharsGo fuel (p :: prest) path = case path of
  c :: cret => p == c && matchPatternChars fuel prest cret
  [] => False

-- | 内部：`**` 之后可从任意位置继续匹配。
matchAnyTail : Int -> List Int -> List Int -> Bool
matchAnyTail fuel rest path =
  if fuel <= 0 then False
  else matchPatternChars fuel rest path || matchAnyTail (fuel - 1) rest (dropOne path)

-- | 内部：`*` 匹配不跨 `/` 的一段。
matchStar : Int -> List Int -> List Int -> Bool
matchStar fuel rest path = if fuel <= 0 then False
else matchPatternChars fuel rest path || (case path of
  c :: cret => c /= 47 && matchStar (fuel - 1) rest cret
  [] => False
)

-- | 内部：丢弃一个字符。
dropOne : List Int -> List Int
dropOne [] = []
dropOne (c :: rest) = rest

-- | 命令行 `--select`：只保留给定规则（默认严重度），其余关闭。
export selectRules : List String -> LintConfig -> Check LintConfig
selectRules names cfg = case resolveRules names [] of
  ErrC e => ErrC e
  OkC selected => OkC (applySelection (map (\r => Pair r LintOff) lintAllRules) selected cfg)

-- | 命令行 `--ignore`：关闭给定规则。
export ignoreRules : List String -> LintConfig -> Check LintConfig
ignoreRules names cfg = case resolveRules names [] of
  ErrC e => ErrC e
  OkC selected => OkC (applyIgnored selected cfg)

-- | 命令行 `--max-warnings`。
export withMaxWarnings : Int -> LintConfig -> LintConfig
withMaxWarnings n cfg = { cfg | lintCfgMaxWarnings = Just n }

-- | 内部：解析规则名列表。
resolveRules : List String -> List LintRule -> Check (List LintRule)
resolveRules [] acc = OkC (reverse acc)
resolveRules (name :: rest) acc = case lintRuleOfName name of
  Nothing => err "unknown lint rule: ${name}"
  Just rule => resolveRules rest (rule :: acc)

-- | 内部：按选中规则生成规则表（选中项取默认严重度）。
applySelection : List (Pair LintRule LintSeverity) -> List LintRule -> LintConfig -> LintConfig
applySelection base selected cfg =
  { cfg | lintCfgRules = foldl (\rules, rule => setRule rules rule (lintDefaultSeverity rule)) base selected }

-- | 内部：关闭指定规则。
applyIgnored : List LintRule -> LintConfig -> LintConfig
applyIgnored selected cfg =
  { cfg | lintCfgRules = foldl (\rules, rule => setRule rules rule LintOff) cfg.lintCfgRules selected }

-- ---------------------------------------------------------------
-- 解析单个 manifest 的 `[lint]`
-- ---------------------------------------------------------------
-- | 解析一份 `vuna.toml` 的 `[lint]`；没有 `[lint]` 返回 `Nothing`。
export parseLintConfig : String -> String -> Check (Maybe LintConfig)
parseLintConfig path text =
  Vuna.Compiler.Base.Common.bind (parseTomlAt path text) (\entries => parseLintEntries path entries)

-- | 内部：只取 `[lint]` 下的条目。
lintEntriesOf : List TomlEntry -> List TomlEntry
lintEntriesOf [] = []
lintEntriesOf (e :: rest) = case e.tomlEntrySection of
  "lint" :: _ => e :: lintEntriesOf rest
  _ => lintEntriesOf rest

-- | 内部：`TomlEntry` 的 section 投影（字段名只在 Toml 里定义一次）。
sectionOfEntry : TomlEntry -> List String
sectionOfEntry (TomlEntry section key value line) = section

-- | 内部：校验并构造配置。
parseLintEntries : String -> List TomlEntry -> Check (Maybe LintConfig)
parseLintEntries path entries = case lintEntriesOf entries of
  [] => OkC Nothing
  lints =>
    Vuna.Compiler.Base.Common.bind (lintAcc path lints initAcc)
      (\acc => OkC (Just (finishAcc path acc)))

-- | 内部：累积器。
record LintAcc where
  lintAccPreset : String
  lintAccMaxWarnings : Maybe Int
  lintAccExclude : List String
  lintAccRules : List (Pair LintRule LintSeverity)

initAcc : LintAcc
initAcc = LintAcc "recommended" Nothing [] []

-- | 内部：逐条处理 `[lint]` 条目。
lintAcc : String -> List TomlEntry -> LintAcc -> Check LintAcc
lintAcc path [] acc = OkC acc
lintAcc path (e :: rest) acc =
  let
    section = e.tomlEntrySection
    key = e.tomlEntryKey
    value = e.tomlEntryValue
    line = e.tomlEntryLine
  in case section of
    ["lint"] => case key of
      "preset" => case value of
        TStr p => if p == "recommended" || p == "all" || p == "none" then
          let
            acc2 = { acc | lintAccPreset = p }
          in lintAcc path rest acc2
        else cfgErr path line "invalid lint preset: ${p} (expected recommended/all/none)"
        _ => cfgErr path line "lint.preset must be a string"
      "max-warnings" => case value of
        TInt n => if n >= -1 then
          let
            acc2 = { acc | lintAccMaxWarnings = Just n }
          in lintAcc path rest acc2
        else cfgErr path line "lint.max-warnings must be >= -1"
        _ => cfgErr path line "lint.max-warnings must be an integer"
      "exclude" => case value of
        TArray xs => case arrayStrings xs of
          Just ys =>
            let
              acc2 = { acc | lintAccExclude = append acc.lintAccExclude ys }
            in lintAcc path rest acc2
          Nothing => cfgErr path line "lint.exclude must be an array of strings"
        _ => cfgErr path line "lint.exclude must be an array of strings"
      other => cfgErr path line "unknown lint key: ${other}"
    ["lint", "rules"] => case value of
      TStr sevName => case lintRuleOfName key of
        Nothing => cfgErr path line "unknown lint rule: ${key}"
        Just rule => case lintSeverityOfName sevName of
          Nothing =>
            cfgErr path line "invalid severity for ${key}: ${sevName} (expected off/warn/error)"
          Just sev =>
            let
              acc2 = { acc | lintAccRules = setRule acc.lintAccRules rule sev }
            in lintAcc path rest acc2
      _ => cfgErr path line "lint rule severity must be a string"
    _ => cfgErr path line "unknown [lint] section: ${join "." section}"

-- | 内部：设置规则严重度（保留首次出现的位置）。
setRule : List (Pair LintRule LintSeverity) -> LintRule -> LintSeverity -> List (Pair LintRule LintSeverity)
setRule [] rule sev = [Pair rule sev]
setRule ((Pair r old) :: rest) rule sev =
  if sameRule r rule then Pair r sev :: rest else Pair r old :: setRule rest rule sev

-- | 内部：预设 + 覆盖 → 最终配置。
finishAcc : String -> LintAcc -> LintConfig
finishAcc path acc =
  LintConfig
    (foldl (\rules, p => setRule rules (firstOf p) (secondOf p)) (presetRules acc.lintAccPreset) acc.lintAccRules)
    acc.lintAccMaxWarnings acc.lintAccExclude path

-- | 内部：配置错误带 `路径:行`。
cfgErr : String -> Int -> String -> Check a
cfgErr path line msg =
  err (if path == "" then "line ${line}: ${msg}" else "${path}:${line}: ${msg}")

-- | 内部：`TArray` 里的字符串（非字符串项给 `Nothing`）。
arrayStrings : List TomlValue -> Maybe (List String)
arrayStrings [] = Just []
arrayStrings ((TStr s) :: rest) = case arrayStrings rest of
  Just ys => Just (s :: ys)
  Nothing => Nothing
arrayStrings (_ :: rest) = Nothing

-- ---------------------------------------------------------------
-- 向上收集 manifest 并合并
-- ---------------------------------------------------------------
-- | 读一个 manifest 的 `[lint]`；文件不存在给 `Nothing`。
readManifestLint : Member nFs FsOp r => String -> Eff r (Check (Maybe LintConfig))
readManifestLint dir =
  let
    path = "${dir}/vuna.toml"
  in do
    exists <- fsFileExists path
    if not exists then pure (OkC Nothing)
    else do
      text <- fsReadFile path
      pure (parseLintConfig path text)

-- | 从文件所在目录向上收集 manifest 目录（内层在前）。
manifestDirsUp : Member nFs FsOp r => Int -> String -> List String -> Eff r (List String)
manifestDirsUp fuel dir seen = if fuel <= 0 then pure []
else do
  found <- findManifestDirMaybe dir
  case found of
    Nothing => pure []
    Just d => if memName d seen then pure []
    else do
      let
        parent = parentOf d
      in if parent == d then pure [d]
      else do
        rest <- manifestDirsUp (fuel - 1) parent (d :: seen)
        pure (d :: rest)

-- | 显式 `--config PATH`：读该文件的 `[lint]`；没有 `[lint]` 是配置错误。
export loadLintConfigAt : Member nFs FsOp r => String -> Eff r (Check LintConfig)
loadLintConfigAt path = do
  textR <- readText path
  pure (case textR of
    ErrC e => ErrC e
    OkC text => case parseLintConfig path text of
      ErrC e => ErrC e
      OkC Nothing => err "${path}: no [lint] section"
      OkC (Just cfg) => OkC cfg
  )

-- | 读一个文件的有效 lint 配置：外层 manifest 先应用，内层覆盖；没有配置时用默认。
export loadLintConfigForFile : Member nFs FsOp r => String -> Eff r (Check LintConfig)
loadLintConfigForFile path =
  let
    start = parentOf path
  in do
    dirs <- manifestDirsUp (strLength path + 8) start []
    mergeManifests (reverse dirs) defaultLintConfig

-- | 内部：按外层→内层顺序合并 manifest 配置。
mergeManifests : Member nFs FsOp r => List String -> LintConfig -> Eff r (Check LintConfig)
mergeManifests [] cfg = pure (OkC cfg)
mergeManifests (dir :: rest) cfg = do
  loaded <- readManifestLint dir
  case loaded of
    ErrC e => pure (ErrC e)
    OkC Nothing => mergeManifests rest cfg
    OkC (Just inner) => mergeManifests rest (mergeConfig cfg inner)

-- | 合并两份配置：`inner` 的规则/上限/排除覆盖 `base`。
export mergeConfig : LintConfig -> LintConfig -> LintConfig
mergeConfig base inner = LintConfig (foldl (\rules, p => setRule rules (firstOf p) (secondOf p)) base.lintCfgRules inner.lintCfgRules) (case inner.lintCfgMaxWarnings of
  Just _ => inner.lintCfgMaxWarnings
  Nothing => base.lintCfgMaxWarnings
) (append base.lintCfgExclude inner.lintCfgExclude) (if inner.lintCfgSource == "" then base.lintCfgSource else inner.lintCfgSource)
