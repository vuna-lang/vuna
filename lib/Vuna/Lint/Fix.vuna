-- | 把 lint 规则给出的编辑描述应用到源码，并驱动 `--fix` 的多轮修复循环。
--
-- 编辑按起点降序排列、从后往前应用，前面的替换不会让后面的行号与列号漂移；每轮修完用
-- `parseSource` 复验，改完不合法就整体当作失败，不写回部分结果。
module Vuna.Lint.Fix where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Parser
import Vuna.Lint.Config
import Vuna.Lint.Rules

-- | 内部：编辑按起点降序（从后往前应用）。
editStartGe : Edit -> Edit -> Bool
editStartGe a b = a.editStart >= b.editStart

-- | 内部：合并两个按起点降序的编辑序列。
mergeEdits : Int -> List Edit -> List Edit -> List Edit
mergeEdits fuel [] ys = ys
mergeEdits fuel xs [] = xs
mergeEdits fuel (x :: xs) (y :: ys) =
  if fuel <= 0 then append (x :: xs) (y :: ys)
  else if editStartGe x y then x :: mergeEdits (fuel - 1) xs (y :: ys)
  else y :: mergeEdits (fuel - 1) (x :: xs) ys

-- | 内部：按起点降序归并排序编辑。
sortEditsGo : Int -> List Edit -> List Edit
sortEditsGo fuel [] = []
sortEditsGo fuel ([x]) = [x]
sortEditsGo fuel edits = if fuel <= 0 then edits
else
  let
    half = length edits / 2
    left = sortEditsGo (fuel - 1) (takeList half edits)
    right = sortEditsGo (fuel - 1) (dropList half edits)
  in mergeEdits fuel left right

-- | 内部：按 `editStart` 降序排序编辑。
sortEdits : List Edit -> List Edit
sortEdits edits = sortEditsGo (length edits + 1) edits

-- | 内部：收集 finding 里带编辑的项（累加器风格，结果与输入反序）。
collectEdits : List Finding -> List Edit -> List Edit
collectEdits [] acc = acc
collectEdits (f :: rest) acc = case f.findingEdit of
  Nothing => collectEdits rest acc
  Just e => collectEdits rest (e :: acc)

-- | 内部：前 n 行（n <= 0 时为空）。
takeList : Int -> List a -> List a
takeList n [] = []
takeList n (x :: rest) = if n <= 0 then [] else x :: takeList (n - 1) rest

-- | 内部：去掉前 n 行。
dropList : Int -> List a -> List a
dropList n lines = if n <= 0 then lines
else case lines of
  [] => []
  x :: rest => dropList (n - 1) rest

-- | 内部：把 1 基行区间 `[start, stop]` 替换成 newLines。
replaceRange : Int -> Int -> List a -> List a -> List a
replaceRange start stop newLines lines =
  append (takeList (start - 1) lines) (append newLines (dropList stop lines))

-- | 内部：按已排序顺序逐个应用编辑；只有结束行严格早于上一个已应用编辑起点的编辑才应用
-- （避免重叠编辑互相破坏），返回应用条数与新行列表。
applyEditList : List Edit -> List String -> Int -> Int -> Pair Int (List String)
applyEditList [] lines limit count = Pair count lines
applyEditList (e :: rest) lines limit count =
  if e.editEnd < limit then applyEditList rest (replaceRange e.editStart e.editEnd e.editLines lines) e.editStart (count + 1)
  else applyEditList rest lines limit count

-- | 内部：收集并应用全部编辑；没有可用编辑时原样返回，应用后用 `parseSource` 复验，失败即
-- `ErrC`。返回（修复条数, 新源码）。
applyFixes : String -> List Finding -> Check (Pair Int String)
applyFixes source findings =
  let
    edits = sortEdits (collectEdits findings [])
  in case applyEditList edits (splitLines source) (length (splitLines source) + 1) 0 of
    Pair count newLines => if count == 0 then OkC (Pair 0 source)
    else
      let
        newSource = joinLines newLines
      in case parseSource "<lint>" newSource of
        ErrC e => err "parse failed after fix: ${diagText e}"
        OkC ignored => OkC (Pair count newSource)

-- | 最多跑 `passes` 轮修复：每轮应用编辑、重新 lint，直到没有可应用的编辑或轮数用尽；任一
-- 环节解析失败即整体报错。返回累计修复条数与最终源码。
--
-- 每轮复验沿用首轮的程序级 fixity：修复只做格式与结构改写、不改 imports，换一份 fixity
-- 重排会退化成 unknown fixity。
export fixLoop : LintConfig -> List FixityDecl -> String -> List Finding -> Int -> Int -> Check (Pair Int String)
fixLoop cfg programFixities source findings passes total = if passes <= 0 then OkC (Pair total source)
else case applyFixes source findings of
  ErrC e => ErrC e
  OkC (Pair count newSource) => if count == 0 then OkC (Pair total source)
  else case lintSourceWithConfig cfg programFixities newSource of
    ErrC e => ErrC e
    OkC remaining => fixLoop cfg programFixities newSource remaining (passes - 1) (total + count)
