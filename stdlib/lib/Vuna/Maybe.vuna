module Vuna.Maybe (Maybe(..), fromMaybe, isJust, isNothing, maybe, mapJust) where

-- Vuna.Maybe：可选值类型与消除/映射函数（不依赖 List）。
-- 依赖 Vuna.Bool 只为让 `data Bool` 声明进入程序：typed codegen 要求
-- 程序里出现 Bool 声明才能生成 True/False 表达式。

import Vuna.Bool
import Vuna.Monad

data Maybe a : Type where
  Nothing : Maybe a
  Just : a -> Maybe a

fromMaybe : a -> Maybe a -> a
fromMaybe d m =
  case m of
    Nothing => d
    Just x => x

isJust : Maybe a -> Bool
isJust m =
  case m of
    Nothing => False
    Just _ => True

isNothing : Maybe a -> Bool
isNothing m =
  case m of
    Nothing => True
    Just _ => False

maybe : b -> (a -> b) -> Maybe a -> b
maybe d f m =
  case m of
    Nothing => d
    Just x => f x

mapJust : (a -> b) -> Maybe a -> Maybe b
mapJust f m =
  case m of
    Nothing => Nothing
    Just x => Just (f x)

-- M11-C：Functor / Monad 实例。trait 来自 Vuna.Monad，类型 Maybe 定义在本模块，
-- 因此可以写 default（匿名）实例（孤儿规则允许）。
instance Functor Maybe where
  fmap f m =
    case m of
      Nothing => Nothing
      Just x => Just (f x)

instance Monad Maybe where
  bind m f =
    case m of
      Nothing => Nothing
      Just x => f x
  pure x = Just x

