module Vuna.Sort (mergeSort, sortBy) where

-- Vuna.Sort：稳定归并排序。`<=` 由内建 Ord 回退承担（typed 路径可用）。

import Vuna.List

sortBy : (a -> a -> Bool) -> List a -> List a
sortBy le xs =
  case xs of
    Nil => Nil
    Cons _ Nil => xs
    _ =>
      let n = length xs
      in let half = n / 2
         in mergeBy le (sortBy le (take half xs)) (sortBy le (drop half xs))

mergeBy : (a -> a -> Bool) -> List a -> List a -> List a
mergeBy le Nil ys = ys
mergeBy le xs Nil = xs
mergeBy le (Cons x xs) (Cons y ys) =
  if le x y then Cons x (mergeBy le xs (Cons y ys))
  else Cons y (mergeBy le (Cons x xs) ys)

mergeSort : List a -> List a
mergeSort xs = sortBy (\x, y => x <= y) xs
