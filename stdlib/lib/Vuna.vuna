module Vuna (module Vuna.Pair, module Vuna.Bool, module Vuna.List, module Vuna.Maybe, module Vuna.Result, module Vuna.String, module Vuna.Sort, module Vuna.Map, module Vuna.Monad, module Vuna.IO) where

-- Vuna：stdlib 包门面（M11-C）。整模块重导出核心模块，保留各模块的抽象性
-- （例如 Map/IO 的构造器不因门面而公开）。编译器/用户程序可以只 `import Vuna`。

import Vuna.Pair
import Vuna.Bool
import Vuna.List
import Vuna.Maybe
import Vuna.Result
import Vuna.String
import Vuna.Sort
import Vuna.Map
import Vuna.Monad
import Vuna.IO
