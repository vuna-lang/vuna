trait Pretty a where
  pretty : a -> String

data C1 : Type where
  A : C1

data C2 : Type where
  B : C2

instance Pretty C1 where
  pretty c = "a"

instance Pretty C2 where
  pretty c = "b"

render x = pretty x

main : String
main = render A ++ "/" ++ render B ++ "/" ++ pretty A ++ "/" ++ pretty B
