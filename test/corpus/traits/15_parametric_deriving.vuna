-- M29-T2b：参数化 data 的 deriving：单参数（Box）、双参数（Pair2）、递归（Tree）。
import Prelude

data Box a : Type where
  MkBox : a -> Box a
deriving (Eq, Show, Ord)

data Pair2 a b : Type where
  MkPair2 : a -> b -> Pair2 a b
deriving (Eq, Show, Ord)

data Tree a : Type where
  Leaf : a -> Tree a
  Node : Tree a -> Tree a -> Tree a
deriving (Eq, Show)

main : String
main =
  show (MkBox 1)
    ++ "/"
    ++ show (MkPair2 1 "s")
    ++ "/"
    ++ show (Node (Leaf 1) (Leaf 2))
    ++ "/"
    ++ (if MkBox 1 < MkBox 2 then "lt" else "ge")
    ++ "/"
    ++ (if Node (Leaf 1) (Leaf 2) == Node (Leaf 1) (Leaf 2) then "eq" else "ne")
