-- 多参数 trait 的实例 tele kind 按实参的构造子 kind 推断（不按「被应用次数」）。
-- `T : N -> Type` ⇒ `instance Pretty (T n)` 的 tele `n` 是 `N`；把它当
-- `Type` 就会报 "expected N, got Type"。
import Prelude

data N : Type where
  Nz : N
  Ns : N -> N

data T : N -> Type where
  MkT : {n : N} -> T n

trait Pretty a where
  pretty : a -> String

instance Pretty (T n) where
  pretty _ = "t"

mkT0 : T Nz
mkT0 = MkT

mkT1 : T (Ns Nz)
mkT1 = MkT

main : String
main = pretty mkT0 ++ pretty mkT1
