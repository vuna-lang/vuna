-- M32：高阶 kind 约束（`Monad m =>`）与 do 块；body 的 `bind` 命中声明的
-- `Dict_Monad m` 假设，main 用 Maybe 实例实例化。
import Prelude
import Base.Maybe

twice : Monad m => m a -> (a -> m a) -> m a
twice ma f = do
  x <- ma
  f x

main : String
main = case twice (Just 1) (\x => Just (x + 1)) of
  Nothing => "Nothing"
  Just n => "Just " ++ strFromInt n