-- M29-T2b：约束实例 `instance Eq a => Eq (Box a)`；`mem (Box Int)` 需要 Eq 字典，
-- 由「参数化实例 + ctx 递归求解（Eq Int）」提供。
import Prelude
import Base.List

data Box a : Type where
  MkBox : a -> Box a

instance Eq a => Eq (Box a) where
  eq x y = case x of
    MkBox p => case y of
      MkBox q => p == q
  neq x y = if x == y then False else True

main : String
main = if mem (MkBox 1) [MkBox 1, MkBox 2] then "found" else "missing"
