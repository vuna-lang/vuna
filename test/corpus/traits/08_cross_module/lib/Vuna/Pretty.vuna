-- 无模块头 = 全导出：trait 方法、Color 构造器、default 实例、命名实例 fancy 都可见。
trait Pretty a where
  pretty : a -> String

data Color : Type where
  Red : Color
  Blue : Color

instance Pretty Color where
  pretty c = case c of
    Red => "red"
    Blue => "blue"

instance Pretty Color as fancy where
  pretty c = "FANCY"
