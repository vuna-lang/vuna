-- console 效应标签（命名实例）——同一程序在 mock（"mock"）与真实 handler
-- 下各跑一次；mock 收集日志（纯 answer），real 走 entry 自动预装的 handler。
import Base.Effect.Core as Eff
import Base.Effect.Console as EffConsole
import Base.Data.Pair as Pair

prog : (n : String) -> Eff (Named n ConsoleOp :: []) Int
prog n = do
  _ <- consolePrint@(n) "hello"
  _ <- consoleEprint@(n) "oops"
  _ <- consolePrint@(n) "!"
  pure 7

progReal : Eff [ConsoleOp] Int
progReal = do
  _ <- consolePrint "hello"
  _ <- consoleEprint "oops"
  _ <- consolePrint "!"
  pure 7

mret : Int -> Pair Int String
mret a = Pair a ""

mopH : (i : Type) -> (o : ConsoleOp i) -> (Eff.resIdx i o -> Pair Int String) -> Pair Int String
mopH i op k = case op of
  Print s => case k 0 of
    Pair a log => Pair a (("out:" ++ s ++ ";") ++ log)
  EPrint s => case k 0 of
    Pair a log => Pair a (("err:" ++ s ++ ";") ++ log)

main : Eff [ConsoleOp] Int
main = case runPure (handleConsole "mock" mret mopH (prog "mock")) of
  Pair n log => do
    _ <- consolePrint ("mock " ++ log ++ "value " ++ strFromInt n ++ "\n")
    progReal
