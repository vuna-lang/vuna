-- 多效应 main（FsOp + ConsoleOp）；entry 自动装两个 handler。
import Base.Effect.Eff as Eff
import Base.Effect.EffConsole as EffConsole
import Base.Effect.EffFs as EffFs

main : Eff [FsOp, ConsoleOp] Int
main = do
  _ <- fsWriteFile "vuna-host-multi.txt" "multi\n"
  s <- fsReadFile "vuna-host-multi.txt"
  _ <- consolePrint s
  pure 0
