-- fs 查询走 typed effects（entry 自动预装 handler），不直接调用宿主原语。
-- 路径是相对的：ocaml / native 用真实 cwd，wasm 用 preopen 根，语义一致。
import Base.Eff
import Base.EffFs

main : Eff [FsOp] Int
main = do
  _ <- fsWriteFile "exists-probe.txt" "x"
  here <- fsFileExists "exists-probe.txt"
  nope <- fsFileExists "definitely-not-a-file-xyz"
  pure (if here then if nope then 0 else 42 else 13)
