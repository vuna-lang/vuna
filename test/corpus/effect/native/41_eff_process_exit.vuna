-- process 的 `Exit` 可控——mock handler（"mock"）与可选参数 handler
-- （"observed" 的 `handleProcessHostWith` 现成实例）都能观察退出码并继续执行；真实路径
-- （`handleProcessHost` 的 `@vuna@prim_eff_exit`）保留，但本夹具不触发它（否则测试进程退出）。
import Base.Effect.Core as Eff
import Base.Effect.Process as EffProcess
import Base.Effect.Console as EffConsole
import Base.Data.List as List

prog : (n : String) -> Eff (Named n ProcessOp :: []) Int
prog n = do
  c <- processExit@(n) 7
  pure c

mret : Int -> Int
mret a = a

mopH : (i : Type) -> (o : ProcessOp i) -> (Eff.resIdx i o -> Int) -> Int
mopH i op k = case op of
  Args => k []
  Exit c => k c
  RunIn dir args => k 0
  Spawn args => k 9
  Wait h => k 0

main : Eff [ConsoleOp, ProcessOp] Int
main = do
  _ <-
    consolePrint
      ("mock " ++ strFromInt (runPure (handleProcess "mock" mret mopH (prog "mock"))) ++ "\n")
  observed <-
    raiseTo [ConsoleOp, ProcessOp]
      (joinEff (handleProcessHostWith "observed" (\c => pure c) (prog "observed")))
  _ <- consolePrint ("observed " ++ strFromInt observed ++ "\n")
  pure 0
