-- 文件元数据走 typed effects（entry 自动预装 handler）：取不到时是 `Nothing`（无值），
-- 不是 0；存在时 `Just` 才是值。
import Base.Effect.Eff as Eff
import Base.Effect.EffFs as EffFs
import Base.Data.Maybe as Maybe

prog : Eff [FsOp] Int
prog = do
  _ <- fsWriteFile "meta-probe.txt" "abc"
  self <- fsFileSize "meta-probe.txt"
  stamp <- fsFileMtime "meta-probe.txt"
  missingSize <- fsFileSize "definitely-not-a-file-xyz"
  missingMtime <- fsFileMtime "definitely-not-a-file-xyz"
  pure ((((case self of
    Just n => if natToInt n > 0 then 1 else 0
    Nothing => 0
  ) + (case stamp of
    Just s => if s > 1000000000 then 1 else 0
    Nothing => 0
  )
  ) + (if isNothing missingSize then 1 else 0)
  ) + (if isNothing missingMtime then 1 else 0)
  )

main : Eff [FsOp] Int
main = prog
