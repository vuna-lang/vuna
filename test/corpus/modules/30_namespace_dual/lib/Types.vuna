module Types where

-- 类型名与构造子同名：类型位置解析成族，值位置解析成构造子。
export data Pair a b(..) : Type where
  Pair : a -> b -> Pair a b

export mk : Pair Int String
mk = Pair 7 "x"

export pairFst : Pair Int String -> Int
pairFst p = case p of
  Pair n s => n

-- 类型作为项：族名出现在值位置（显式 `(a : Type)` 实参）。
export firstTy : (a : Type) -> a -> Type
firstTy a x = a
