data Capability : Type where
  CapConsole : Capability
  CapFs : Capability
  CapProcess : Capability
  CapEnv : Capability
  CapClock : Capability

capabilityName : Capability -> String
capabilityName c = case c of
  CapConsole => "console"
  CapFs => "fs"
  CapProcess => "process"
  CapEnv => "env"
  CapClock => "clock"

main : Int
main = 0