-- M11：高阶 kind + 一般约束泛化。`bindPair : m a -> m b -> m (Pair a b)` 的
-- 签名里 m 是类型构造器变量；调用点分别传入 Maybe 与 List 的字典。
-- M23 限制：`check` 已支持该签名推断（DtQuant 按应用次数推断 m : Type -> Type），
-- 但含多隐式参数字典的定义，核心求值与擦除 codegen 尚不可用（liftFreeDictGoals 的
-- binder 插入/去重缺陷，M24 处理；见 docs/reference/limits.md）。因此本夹具带
-- `.nointerp` + `.nocompile` 标记，runner 只断言 `check`。
trait Monad m where
  bind : m a -> (a -> m b) -> m b
  pure : a -> m a

data Maybe a : Type where
  Nothing : Maybe a
  Just : a -> Maybe a

data List a : Type where
  Nil : List a
  Cons : a -> List a -> List a

data Pair a b : Type where
  Pair : a -> b -> Pair a b

append : List a -> List a -> List a
append Nil ys = ys
append (Cons x xs) ys = Cons x (append xs ys)

concatMap : (a -> List b) -> List a -> List b
concatMap f Nil = Nil
concatMap f (Cons x xs) = append (f x) (concatMap f xs)

instance Monad Maybe where
  bind m f = case m of
    Nothing => Nothing
    Just x => f x
  pure x = Just x

instance Monad List where
  bind xs f = concatMap f xs
  pure x = Cons x Nil

bindPair : m a -> m b -> m (Pair a b)
bindPair ma mb = do
  a <- ma
  b <- mb
  pure (Pair a b)

showM : Maybe (Pair Int Int) -> String
showM m = case m of
  Nothing => "Nothing"
  Just (Pair a b) => "Just " ++ strFromInt a ++ ":" ++ strFromInt b

showL : List (Pair Int Int) -> String
showL Nil = "[]"
showL (Cons (Pair a b) rest) = strFromInt a ++ ":" ++ strFromInt b ++ " " ++ showL rest

main : String
main = showM (bindPair (Just 1) (Just 2)) ++ "/" ++ showL (bindPair (Cons 1 (Cons 2 Nil)) (Cons 3 Nil))
