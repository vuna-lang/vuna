-- M11：高阶 kind + 一般约束泛化。`bindPair : m a -> m b -> m (Pair a b)` 的
-- 签名里 m 是类型构造器变量；调用点分别传入 Maybe 与 LList 的字典。
-- M23 限制：`check` 已支持该签名推断（Elab.Sig 按应用次数推断 m : Type -> Type），
-- 但含多隐式参数字典的定义，核心求值与擦除 codegen 尚不可用（liftFreeDictGoals 的
-- binder 插入/去重缺陷，M24 处理；规则见 docs/reference/type-system.md）。因此本夹具带
-- `.nointerp` + `.nocompile` 标记，runner 只断言 `check`。
trait Monad m where
  bind : m a -> (a -> m b) -> m b
  pure : a -> m a

data Maybe a : Type where
  Nothing : Maybe a
  Just : a -> Maybe a

data LList a : Type where
  LNil : LList a
  LCons : a -> LList a -> LList a

data Pair a b : Type where
  Pair : a -> b -> Pair a b

append : LList a -> LList a -> LList a
append LNil ys = ys
append (LCons x xs) ys = LCons x (append xs ys)

concatMap : (a -> LList b) -> LList a -> LList b
concatMap f LNil = LNil
concatMap f (LCons x xs) = append (f x) (concatMap f xs)

instance Monad Maybe where
  bind m f = case m of
    Nothing => Nothing
    Just x => f x
  pure x = Just x

instance Monad LList where
  bind xs f = concatMap f xs
  pure x = LCons x LNil

bindPair : m a -> m b -> m (Pair a b)
bindPair ma mb = do
  a <- ma
  b <- mb
  pure (Pair a b)

showM : Maybe (Pair Int Int) -> String
showM m = case m of
  Nothing => "Nothing"
  Just (Pair a b) => "Just " ++ strFromInt a ++ ":" ++ strFromInt b

showL : LList (Pair Int Int) -> String
showL LNil = "[]"
showL (LCons (Pair a b) rest) = strFromInt a ++ ":" ++ strFromInt b ++ " " ++ showL rest

main : String
main = showM (bindPair (Just 1) (Just 2)) ++ "/" ++ showL (bindPair (LCons 1 (LCons 2 LNil)) (LCons 3 LNil))
