trait Monad m where
  bind : m a -> (a -> m b) -> m b
  pure : a -> m a

data Maybe a : Type where
  Nothing : Maybe a
  Just : a -> Maybe a

instance Monad Maybe where
  bind m f = case m of
    Nothing => Nothing
    Just x => f x
  pure x = Just x

sumDo : Maybe Int
sumDo = do
  x <- Just 1
  y <- Just 2
  pure (x + y)

bail : Maybe Int
bail = do
  x <- Nothing
  pure (x + 1)

showMaybe : Maybe Int -> String
showMaybe m = case m of
  Nothing => "Nothing"
  Just n => "Just " ++ strFromInt n

main : String
main = showMaybe sumDo ++ "/" ++ showMaybe bail
