module Vuna.Sample (Point(..), Shape, area, module Vuna.Compiler.Common, Vuna.Compiler.Frontend.Parser.parseSource) where

import Vuna.Compiler.Common
import qualified Vuna.Compiler.Frontend.Parser as P
import Vuna.Compiler.Frontend.Ast as A
import qualified Vuna.Compiler.Frontend.Lexer as L

data Shape : Type where
  Circle : Int -> Shape
  Rect : Int -> Int -> Shape

area : Shape -> Int
area s = case s of
  Circle r => 3 * r * r
  Rect w h => w * h
