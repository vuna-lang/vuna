data Color : Type where
  Red : Color
  Blue : Color
deriving (Show, Eq)

trait Pretty a where
  pretty : a -> String
  shout : a -> String

instance Pretty Color where
  pretty c = case c of
    Red => "red"
    Blue => "blue"
  shout c = pretty c ++ "!"

instance Pretty Color as fancy where
  pretty c = "fancy"
  shout c = "fancy!"

main : String
main = pretty @fancy Blue ++ "/" ++ show Red
