module Vuna.Sample
  ( Base.HashMap.fromList
  , Base.String.strLength
  , Point(..)
  , Shape
  , area
  , module Base.List
  ) where

import Base.String
import Base.HashMap
import Base.List
import qualified Base.Maybe as M
import Base.Bool as B

data Shape : Type where
  Circle : Int -> Shape
  Rect : Int -> Int -> Shape

area : Shape -> Int
area s = case s of
  Circle r => 3 * r * r
  Rect w h => w * h

point : Point
point = Point { x = 1, y = 2 }
