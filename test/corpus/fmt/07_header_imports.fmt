module Vuna.Sample
  ( Point(..)
  , Shape
  , Vuna.Compiler.Parser.parseSource
  , area
  , module Vuna.Compiler.Common
  ) where

import Vuna.Compiler.Common
import qualified Vuna.Compiler.Parser as P
import Vuna.Compiler.Ast as A
import qualified Vuna.Compiler.Lexer as L

data Shape : Type where
  Circle : Int -> Shape
  Rect : Int -> Int -> Shape

area : Shape -> Int
area s = case s of
  Circle r => 3 * r * r
  Rect w h => w * h
