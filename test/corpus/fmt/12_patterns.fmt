data List a : Type where
  Nil : List a
  Cons : a -> List a -> List a

data Maybe : Type where
  Nothing : Maybe
  Just : Int -> Maybe

f : Maybe -> Int
f Nothing = 0
f (Just 0) = 1
f (Just n) = n

g : List Int -> Int
g [] = 0
g (x :: xs) = x + g xs

h : List Int -> Int
h (_ :: y :: _) = y
h _ = 0

main : Int
main = f (Just 5) + g [1, 2] + h [3, 4]
