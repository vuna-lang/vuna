-- fmt 测试探针：读文件 → formatSourceWith（M31.3：带程序级 fixity）；mode: fmt/check/write。
-- 由 check.sh 用当前编译器编译（不是测试输入，文件名以下划线开头）。
-- main : Eff [] Int，由运行时执行；效果只经宿主层。
--
-- 探针包在 check.sh 里按**真实依赖布局**构造（base 是依赖包），所以 fixity 上下文应能
-- 正常加载；加载失败或未知运算符是硬错误，不再静默降级（格式化器宁可拒绝也不改语义）。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.FixityEnv
import Vuna.Fmt
import Vuna.Compiler.Frontend.Parser
import Base.Monad

main : Eff [] Int
main = do
  args <- prim_eff_getArgs
  run args

run : List String -> Eff [] Int
run args =
  case args of
    Cons "fmt" (Cons path Nil) => runFmt path
    Cons "check" (Cons path Nil) => runCheck path
    Cons "write" (Cons path (Cons out Nil)) => runWrite path out
    _ => do
      _ <- prim_eff_print "usage: probe (fmt|check|write) file [out]\n"
      pure 2

fail : String -> String -> Eff [] Int
fail path msg = do
  _ <- prim_eff_print (path ++ ": " ++ msg ++ "\n")
  pure 1

-- 程序级 fixity：与 CLI 同源（Vuna.FixityEnv：按文件目录缓存模块图，声明表逐文件算）。
fixitiesFor : String -> String -> Eff [] (Check (List FixityDecl))
fixitiesFor path source = do
  looked <- fixitiesForFile emptyFixityEnv path source
  pure (secondOf looked)

runFmt : String -> Eff [] Int
runFmt path = do
  source <- prim_eff_readFile path
  fxR <- fixitiesFor path source
  case fxR of
    ErrC e => fail path (diagText e)
    OkC env => case formatSourceWith env source of
      ErrC e => fail path ("format error: " ++ diagText e)
      OkC out => do
        _ <- prim_eff_print out
        pure 0

runCheck : String -> Eff [] Int
runCheck path = do
  source <- prim_eff_readFile path
  fxR <- fixitiesFor path source
  case fxR of
    ErrC e => fail path (diagText e)
    OkC env => case formatSourceWith env source of
      ErrC e => fail path ("format error: " ++ diagText e)
      OkC out1 => case parseSource path out1 of
        ErrC e => fail path ("reparse error: " ++ diagText e)
        OkC parsed => do
          fx2R <- fixitiesFor path out1
          case fx2R of
            ErrC e => fail path (diagText e)
            OkC env2 => case formatSourceWith env2 out1 of
              ErrC e => fail path ("reformat error: " ++ diagText e)
              OkC out2 =>
                if out1 == out2 then pure 0
                else fail path ("not idempotent\n--- first ---\n" ++ out1 ++ "--- second ---\n" ++ out2)

runWrite : String -> String -> Eff [] Int
runWrite path out = do
  source <- prim_eff_readFile path
  fxR <- fixitiesFor path source
  case fxR of
    ErrC e => fail path (diagText e)
    OkC env => case formatSourceWith env source of
      ErrC e => fail path ("format error: " ++ diagText e)
      OkC formatted => do
        _ <- prim_eff_writeFile out formatted
        pure 0