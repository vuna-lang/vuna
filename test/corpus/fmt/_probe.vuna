-- fmt 测试探针：读文件 → formatSourceWith（M31.3：带程序级 fixity）；mode: fmt/check/write。
-- 由 check.sh 用当前编译器编译（不是测试输入，文件名以下划线开头）。
-- main : IO Int，由运行时执行；效果只经 Base.IO。
--
-- 探针包在 check.sh 里按**真实依赖布局**构造（base 是依赖包），所以 fixity 上下文应能
-- 正常加载；加载失败或未知运算符是硬错误，不再静默降级（格式化器宁可拒绝也不改语义）。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.FixityEnv
import Vuna.Fmt
import Vuna.Compiler.Frontend.Parser
import Base.Monad
import Base.IO

main : IO Int
main = do
  args <- getArgs
  run args

run : List String -> IO Int
run args =
  case args of
    Cons "fmt" (Cons path Nil) => runFmt path
    Cons "check" (Cons path Nil) => runCheck path
    Cons "write" (Cons path (Cons out Nil)) => runWrite path out
    _ => do
      _ <- print "usage: probe (fmt|check|write) file [out]\n"
      pure 2

fail : String -> String -> IO Int
fail path msg = do
  _ <- print (path ++ ": " ++ msg ++ "\n")
  pure 1

-- 程序级 fixity：与 CLI 同源（Vuna.FixityEnv：按文件目录缓存模块图，声明表逐文件算）。
fixitiesFor : String -> String -> Result (List FixityDecl)
fixitiesFor path source = secondOf (fixitiesForFile emptyFixityEnv path source)

runFmt : String -> IO Int
runFmt path = do
  source <- readFile path
  case fixitiesFor path source of
    Err e => fail path e
    Ok env => case formatSourceWith env source of
      Err e => fail path ("format error: " ++ e)
      Ok out => do
        _ <- print out
        pure 0

runCheck : String -> IO Int
runCheck path = do
  source <- readFile path
  case fixitiesFor path source of
    Err e => fail path e
    Ok env => case formatSourceWith env source of
      Err e => fail path ("format error: " ++ e)
      Ok out1 => case parseSource path out1 of
        Err e => fail path ("reparse error: " ++ e)
        Ok parsed => case fixitiesFor path out1 of
          Err e => fail path e
          Ok env2 => case formatSourceWith env2 out1 of
            Err e => fail path ("reformat error: " ++ e)
            Ok out2 =>
              if out1 == out2 then pure 0
              else fail path ("not idempotent\n--- first ---\n" ++ out1 ++ "--- second ---\n" ++ out2)

runWrite : String -> String -> IO Int
runWrite path out = do
  source <- readFile path
  case fixitiesFor path source of
    Err e => fail path e
    Ok env => case formatSourceWith env source of
      Err e => fail path ("format error: " ++ e)
      Ok formatted => do
        _ <- writeFile out formatted
        pure 0