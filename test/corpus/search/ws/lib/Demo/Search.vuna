-- | Demo search module.
module Demo.Search where

import Base.Eff
import Base.List

-- | Identity.
id : a -> a
id x = x

-- | Increment an Int.
inc : Int -> Int
inc n = n

-- | Length of a list.
length : List a -> Nat
length xs = 0

-- | Pair constructor helper.
pair : Int -> String -> Pair Int String
pair a b = Pair a b

-- | Equality test helper.
showLike : Eq a => a -> a -> Bool
showLike a b = True

-- | Just-like constructor.
data Maybe2 a : Type where
  -- | Nothing-like.
  Nothing2 : Maybe2 a
  -- | Just-like.
  Just2 : a -> Maybe2 a

-- | A row tag for list/row rendering.
data Fetch : Type where

-- | Empty-row effect runner (list-syntax nil).
runPure2 : Eff [] a -> a
runPure2 e = runPure e

-- | Open row with a cons chain (infix rendering).
runWith : Eff (Fetch :: r) a -> Eff r a
runWith e = e

-- | Closed row written with `::` (kept infix by the pretty-printer).
runFetch : Eff (Fetch :: []) a -> Eff a
runFetch e = e
