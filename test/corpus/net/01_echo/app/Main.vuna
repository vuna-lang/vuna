-- M35.3：`net` 原语的端到端夹具。
--
-- 一个程序三种模式（测试驱动直接以 argv 调二进制）：
--   serve PATH  —— 绑 Unix socket，accept 一个连接，回 "echo:<收到>"，退出；
--   serve-tcp   —— 绑 127.0.0.1:0（临时端口），打印 `port:<N>`，accept 一个连接后同样 echo；
--   client ADDR —— 连接、发 "ping\n"、打印回包、退出。
import Base.Host
import Base.Monad

serve : String -> Eff [] Int
serve path = do
  h <- prim_eff_netListen path
  _ <- println "ready"
  c <- prim_eff_netAccept h
  msg <- prim_eff_netRecv c 4096
  _ <- prim_eff_netSend c ("echo:" ++ msg)
  _ <- prim_eff_netClose c
  _ <- prim_eff_netClose h
  println "server done"
  exit 0

serveTcp : Eff [] Int
serveTcp = do
  h <- prim_eff_netListen "tcp:127.0.0.1:0"
  p <- prim_eff_netPort h
  println ("port:" ++ strFromInt p)
  c <- prim_eff_netAccept h
  msg <- prim_eff_netRecv c 4096
  _ <- prim_eff_netSend c ("echo:" ++ msg)
  _ <- prim_eff_netClose c
  _ <- prim_eff_netClose h
  exit 0

client : String -> Eff [] Int
client addr = do
  c <- prim_eff_netConnect addr
  _ <- prim_eff_netSend c "ping\n"
  reply <- prim_eff_netRecv c 4096
  _ <- prim_eff_netClose c
  _ <- prim_eff_print reply
  exit 0

dispatch : List String -> Eff [] Int
dispatch (["serve", path]) = serve path
dispatch (["serve-tcp"]) = serveTcp
dispatch (["client", addr]) = client addr
dispatch _ = do
  _ <- prim_eff_print "usage\n"
  exit 2

main : Eff [] Int
main = do
  args <- getArgs
  dispatch args
