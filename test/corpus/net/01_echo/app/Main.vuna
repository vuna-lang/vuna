-- `net` 原语的端到端夹具。
--
-- 一个程序三种模式（测试驱动直接以 argv 调二进制）：
--   serve PATH  —— 绑 Unix socket，accept 一个连接，回 "echo:<收到>"，退出；
--   serve-tcp   —— 绑 127.0.0.1:0（临时端口），打印 `port:<N>`，accept 一个连接后同样 echo；
--   client ADDR —— 连接、发 "ping\n"、打印回包、退出。
-- main 带具体宿主行，entry 自动预装 Console/Args/Exit handler；net 走带行 API。
import Base.Trait.Monad as Monad
import Base.Effect.Eff as Eff
import Base.Effect.EffArgs as EffArgs
import Base.Effect.EffConsole as EffConsole
import Base.Effect.EffExit as EffExit
import Base.Effect.EffNet as EffNet
import Base.Data.Maybe as Maybe

serve : String -> Eff [ConsoleOp, ExitOp, ArgsOp, NetOp] Int
serve path = do
  h <- netListen path
  _ <- consolePrint ("ready" ++ "\n")
  c <- netAccept h
  msg <- fmap (fromMaybe "") (netRecv c 4096)
  _ <- netSend c ("echo:" ++ msg)
  _ <- netClose c
  _ <- netClose h
  _ <- consolePrint ("server done" ++ "\n")
  exitWith 0

serveTcp : Eff [ConsoleOp, ExitOp, ArgsOp, NetOp] Int
serveTcp = do
  h <- netListen "tcp:127.0.0.1:0"
  p <- netPort h
  _ <- consolePrint (("port:" ++ strFromInt p) ++ "\n")
  c <- netAccept h
  msg <- fmap (fromMaybe "") (netRecv c 4096)
  _ <- netSend c ("echo:" ++ msg)
  _ <- netClose c
  _ <- netClose h
  exitWith 0

client : String -> Eff [ConsoleOp, ExitOp, ArgsOp, NetOp] Int
client addr = do
  c <- netConnect addr
  _ <- netSend c "ping\n"
  reply <- fmap (fromMaybe "") (netRecv c 4096)
  _ <- netClose c
  _ <- consolePrint reply
  exitWith 0

dispatch : List String -> Eff [ConsoleOp, ExitOp, ArgsOp, NetOp] Int
dispatch (["serve", path]) = serve path
dispatch (["serve-tcp"]) = serveTcp
dispatch (["client", addr]) = client addr
dispatch _ = do
  _ <- consolePrint "usage\n"
  exitWith 2

main : Eff [ConsoleOp, ExitOp, ArgsOp, NetOp] Int
main = do
  args <- argsGetArgs
  dispatch args
