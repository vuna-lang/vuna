-- M23：DT 暂不支持 where 子句，原来的局部辅助函数改为顶层互递归定义
-- （保留递归调用覆盖点；golden 随之改为 2）。
data Bool : Type where
  False : Bool
  True : Bool

isEven : Int -> Bool
isEven n = if n == 0 then True else isOdd (n - 1)

isOdd : Int -> Bool
isOdd n = if n == 0 then False else isEven (n - 1)

check : Bool -> Int
check b = if b then 1 else 0

main : Int
main = check (isEven 10) + check (isOdd 7)