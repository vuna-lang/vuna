-- 负例：线性续延 resume 两次 → 用量检查拒绝。
import Base.Effect.Eff as Eff
import Base.Effect.EffReader as EffReader

prog : Eff [ReaderOp Int@counter] Int
prog = ask "counter" Int

opH : (i : Type) -> (o : ReaderOp Int i) -> (1 k : Cont i Int) -> Int
opH i op k = case op of
  Ask => resumeCont k 1 + resumeCont k 2

main : Int
main = runPure (handleReaderLin "counter" Int (\a => a) opH prog)
