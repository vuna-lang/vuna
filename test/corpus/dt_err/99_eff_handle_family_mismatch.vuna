-- native-effects N1（提交 4b）负例（ND10）：同一 handle 块的 clause 构造子必须同族。
import Base.Eff
import Base.EffClock
import Base.EffConsole
import Base.List
import Base.Monad
import Base.Nat

prog : Eff [Console@audit] Nat
prog = do
  n <- perform (Print "hello")
  pure n

run : Eff (Cons "audit" (Console "audit") Nil) Nat -> Nat
run comp = runPure (handle comp {
  Print s k -> k 5
  Now k -> k 7
  })
