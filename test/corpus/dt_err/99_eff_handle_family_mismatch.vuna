-- 负例：同一 handle 块的 clause 构造子必须同族。
import Base.Eff
import Base.EffClock
import Base.EffConsole
import Base.List
import Base.Monad
import Base.Nat

prog : Eff [ConsoleOp@audit] Nat
prog = do
  n <- perform (Print "hello")
  pure n

run : Eff ((Named "audit" ConsoleOp :: Nil)) Nat -> Nat
run comp = runPure (handle comp {
  Print s k -> k 5
  Now k -> k 7
  })
