-- native-effects N1（提交 4b）负例：handle 子句必须穷尽该 op 族。
import Base.Eff
import Base.EffConsole
import Base.List
import Base.Monad
import Base.Nat

prog : Eff [ConsoleOp@audit] Nat
prog = do
  n <- perform (Print "hello")
  pure n

run : Eff (Cons "audit" ConsoleOp Nil) Nat -> Nat
run comp = runPure (handle comp {
  Print s k -> k 5
  })
