-- 负例：handle 的 op 族没有结果索引（kind 是 `Type`，不是 `params… -> Type -> Type`）。
import Base.Effect.Eff as Eff
import Base.Data.List as List
import Base.Trait.Monad as Monad
import Base.Data.Nat as Nat

data BoomOp : Type where
  BoomIt : BoomOp

data Boom : String -> Type -> Type where

prog : Eff [Boom "default"] Nat
prog = sendCore (Named "default" (Boom "default")) "BoomOp" "default" BoomIt

run : Eff [Boom "default"] Nat -> Nat
run comp = runPure (handle comp {
  BoomIt k -> k 5
}
)
