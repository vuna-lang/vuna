-- fs 命名实例：程序需要 `Fs "real"`，handler 却处理 `Fs "mock"` → 行/类型不匹配，不能静默过。
-- （W10 收尾把 Fs 从单实例迁移成命名实例后，实例名必须一致。）
import Base.Eff
import Base.EffFs

prog : Eff [Fs "real"] String
prog = fsReadFile "real" "/tmp/vuna_w10_fs_err.txt"

main : IO Int
main = prim_bindIO (runIOAnswer (handleFsIO "mock" prog)) (\_ => prim_pureIO 0)