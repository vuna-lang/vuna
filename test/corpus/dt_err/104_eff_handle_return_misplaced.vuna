-- 负例：return 子句必须唯一且在最前。
import Base.Effect.Eff as Eff
import Base.Effect.EffConsole as EffConsole
import Base.Data.List as List
import Base.Trait.Monad as Monad
import Base.Data.Nat as Nat

prog : Eff [ConsoleOp@audit] Nat
prog = do
  n <- perform (Print "hello")
  pure n

run : Eff ((Named "audit" ConsoleOp :: Nil)) Nat -> Nat
run comp = runPure (handle comp {
  Print s k -> k 5
  return x -> x
  })
