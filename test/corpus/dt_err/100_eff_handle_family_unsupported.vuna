-- native-effects N1（提交 4b）负例：作用域/高阶 op 族（Exn：op 携带 Row、标签 arity 与
-- op arity 不匹配）不在 handle 语法支持范围。
import Base.Eff
import Base.EffExn
import Base.List
import Base.Monad
import Base.Nat

prog : Eff [Exn "boom"] Nat
prog = pure 1

run : Eff (Cons "boom" (Exn "boom") []) Nat -> Nat
run comp = runPure (handle comp {
  ThrowExn msg k -> k 0
  Try sub k -> k 0
}
)
