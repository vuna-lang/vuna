-- native-effects N1（提交 4b）负例：handle 块至少要有一个 op 子句。
import Base.Eff
import Base.EffConsole
import Base.List
import Base.Monad
import Base.Nat

prog : Eff [Console@audit] Nat
prog = do
  n <- perform (Print "hello")
  pure n

run : Eff (Cons "audit" (Console "audit") Nil) Nat -> Nat
run comp = runPure (handle comp {
})