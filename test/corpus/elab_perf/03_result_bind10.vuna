-- D48：10 层显式 `Result` `>>=` 链（右结合续延嵌套；推断 fuel 边界回归）。
import Base.Result

chain : Result Int
chain = Ok 1 >>= \x0 => Ok (x0 + 1) >>= \x1 => Ok (x1 + 1) >>= \x2 => Ok (x2 + 1) >>= \x3 => Ok (x3 + 1) >>= \x4 => Ok (x4 + 1) >>= \x5 => Ok (x5 + 1) >>= \x6 => Ok (x6 + 1) >>= \x7 => Ok (x7 + 1) >>= \x8 => Ok (x8 + 1) >>= \x9 => Ok (x9 + 1)
