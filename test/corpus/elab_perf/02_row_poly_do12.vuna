-- D48：行多态 `{r : Row}` 的 12 步 do 链；`Monad (Eff r)` 字典应从期望类型早解。
import Base.Eff

chain : {r : Row} -> Eff r Int
chain = do
  x1 <- pure 1
  x2 <- pure (x1 + 1)
  x3 <- pure (x2 + 1)
  x4 <- pure (x3 + 1)
  x5 <- pure (x4 + 1)
  x6 <- pure (x5 + 1)
  x7 <- pure (x6 + 1)
  x8 <- pure (x7 + 1)
  x9 <- pure (x8 + 1)
  x10 <- pure (x9 + 1)
  x11 <- pure (x10 + 1)
  x12 <- pure (x11 + 1)
  pure x12
