-- stdlib：Base.Data.String 常用操作。
import Base.Data.String as String
import Base.Data.List as List

showBool : Bool -> String
showBool b = if b then "True" else "False"

showStrList : List String -> String
showStrList [] = "[]"
showStrList (x :: xs) = "[" ++ x ++ showStrTail xs

showStrTail : List String -> String
showStrTail [] = "]"
showStrTail (x :: xs) = "," ++ x ++ showStrTail xs

main : String
main =
  "sp="
    ++ showStrList (split "," "a,b,c")
    ++ " j="
    ++ join "-" ((::) "x" ((::) "y" []))
    ++ " ln="
    ++ showStrList (lines "a\nbc")
    ++ " ul="
    ++ showBool (unlines ((::) "x" ((::) "y" [])) == "x\ny\n")
    ++ " tr="
    ++ trim "  hi  "
    ++ " tl="
    ++ trimLeft "  lo"
    ++ " tr2="
    ++ trimRight "hi  "
    ++ " ct="
    ++ showBool (contains "ell" "hello")
    ++ showBool (contains "zz" "hello")
    ++ " sw="
    ++ showBool (startsWith "he" "hello")
    ++ " ew="
    ++ showBool (endsWith "lo" "hello")
    ++ " rp="
    ++ repeat 3 "ab"
    ++ " ss="
    ++ substring 1 3 "hello"
