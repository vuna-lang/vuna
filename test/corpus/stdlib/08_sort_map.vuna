-- stdlib：Base.Sort + 抽象 Base.Map（跨模块只能通过 API 使用）。
import Base.Data.Sort as Sort
import Base.Container.Map as Map
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.Maybe as Maybe

showIntList : List Int -> String
showIntList [] = "[]"
showIntList (x :: xs) = "[" ++ strFromInt x ++ showIntTail xs

showIntTail : List Int -> String
showIntTail [] = "]"
showIntTail (x :: xs) = "," ++ strFromInt x ++ showIntTail xs

showStrList : List String -> String
showStrList [] = "[]"
showStrList (x :: xs) = "[" ++ x ++ showStrTail xs

showStrTail : List String -> String
showStrTail [] = "]"
showStrTail (x :: xs) = "," ++ x ++ showStrTail xs

showMaybeInt : Maybe Int -> String
showMaybeInt m = case m of
  Nothing => "Nothing"
  Just x => "Just " ++ strFromInt x

main : String
main =
  let
    sorted = mergeSort ((::) 3 ((::) 1 ((::) 2 [])))
  in let
    desc = sortBy (\x, y => x >= y) ((::) 1 ((::) 3 ((::) 2 [])))
  in let
    m = insert "b" 2 (insert "a" 1 empty)
  in let
    m2 = remove "a" m
  in "s="
    ++ showIntList sorted
    ++ " d="
    ++ showIntList desc
    ++ " k="
    ++ showStrList (keys m)
    ++ " v="
    ++ showIntList (values m)
    ++ " sz="
    ++ strFromInt (size m)
    ++ " lk="
    ++ showMaybeInt (lookup "b" m)
    ++ " rm="
    ++ showStrList (keys m2)
    ++ " fl="
    ++ strFromInt (size (fromList ((::) (Pair "x" 9) [])))
    ++ " tl="
    ++ showStrList (map (\p => firstOf p ++ "=" ++ strFromInt (secondOf p)) (toList m2))
