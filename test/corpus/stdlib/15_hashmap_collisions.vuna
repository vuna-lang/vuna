-- stdlib：Base.Container.HashMap 的碰撞覆盖（1024 个键铺满全部桶，必然出现哈希碰撞）。
-- 规模超出核心求值的默认燃料（512）：只 check + compile + run（.run.out）。
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Base.Data.Pair as Pair

manyKeys : List String
manyKeys = map strFromInt (range 0 1024)

buildMany : List String -> HashMap.HashMap String Int
buildMany ks =
  foldl (\acc, k => HashMap.insert k (strLength k) acc) (HashMap.fromList []) ks

allThere : List String -> HashMap.HashMap String Int -> Bool
allThere [] _ = True
allThere (k :: rest) m = if HashMap.member k m then allThere rest m else False

main : String
main =
  let
    big = buildMany manyKeys
  in "big="
    ++ strFromInt (HashMap.size big)
    ++ " all="
    ++ (if allThere manyKeys big then "True" else "False")
