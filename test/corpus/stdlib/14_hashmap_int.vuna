-- stdlib：泛型 HashMap 的 Int 键路径（0 与 1024 必碰撞）。
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair

-- 63 位 Int 的 min_int：绝对值超出可表示字面量，用算术构造。
minKey : Int
minKey = 0 - 4611686018427387903 - 1

showMaybeInt : Maybe Int -> String
showMaybeInt Nothing = "Nothing"
showMaybeInt (Just x) = "Just " ++ strFromInt x

main : String
main =
  let
    m = HashMap.insert 0 10 (HashMap.insert 1024 11 (HashMap.fromList []))
    m2 = HashMap.fromList [Pair 0 1, Pair 0 2, Pair (0 - 1) 3]
    m3 = HashMap.insert (0 - 1024) 7 (HashMap.fromList [])
    mn = HashMap.insert minKey 9 (HashMap.fromList [])
    m4 = HashMap.insertAll [Pair 0 1, Pair 0 2] (HashMap.fromList [])
  in "a="
    ++ showMaybeInt (HashMap.lookup 0 m)
    ++ " b="
    ++ showMaybeInt (HashMap.lookup 1024 m)
    ++ " sz="
    ++ strFromInt (HashMap.size m)
    ++ " fl="
    ++ showMaybeInt (HashMap.lookup 0 m2)
    ++ " insall="
    ++ showMaybeInt (HashMap.lookup 0 m4)
    ++ " neg="
    ++ showMaybeInt (HashMap.lookup (0 - 1) m2)
    ++ " neg2="
    ++ showMaybeInt (HashMap.lookup (0 - 1024) m3)
    ++ " min="
    ++ showMaybeInt (HashMap.lookup minKey mn)
    ++ " miss="
    ++ showMaybeInt (HashMap.lookup 5 m)
