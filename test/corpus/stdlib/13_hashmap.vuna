-- stdlib：Base.HashMap / Base.HashSet（String 键的持久哈希容器）。
import Base.Container.HashMap as HashMap
import Base.Container.HashSet as HashSet
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair

showMaybeInt : Maybe Int -> String
showMaybeInt Nothing = "Nothing"
showMaybeInt (Just x) = "Just " ++ strFromInt x

main : String
main =
  let
    m = HashMap.insert "b" 2 (HashMap.insert "a" 1 (HashMap.fromList []))
    m2 = HashMap.fromList [Pair "b" 2, Pair "a" 1, Pair "c" 3]
    s = HashSet.fromList ["x", "y", "x"]
  in "lk=" ++ showMaybeInt (HashMap.lookup "a" m)
       ++ " miss=" ++ showMaybeInt (HashMap.lookup "z" m)
       ++ " mem=" ++ (if HashMap.member "b" m then "True" else "False")
       ++ " sz=" ++ strFromInt (HashMap.size m)
       ++ " sz2=" ++ strFromInt (HashMap.size m2)
       ++ " hs=" ++ strFromInt (HashSet.size s)
       ++ " hx=" ++ (if HashSet.member "x" s then "True" else "False")