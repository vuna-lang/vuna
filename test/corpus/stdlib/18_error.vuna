-- M35.1：Base.Error 的 Monad/do + catchError 路径（interp 可归约）。
import Base.Error
import Base.Int

safeDiv : Int -> Int -> Error String Int
safeDiv a b = if b == 0 then throwError "div0" else pure (a / b)

guard : Error String Int
guard = do
  v <- safeDiv 84 0
  pure v

main : Int
main = runError (catchError guard (\_ => pure 42)) (\_ => 0) (\v => v)
