-- stdlib：do 语法 + Maybe 的 Monad 实例（bind/pure）。
import Base.Monad
import Base.Maybe

showMaybe : Maybe Int -> String
showMaybe m =
  case m of
    Nothing => "Nothing"
    Just n => "Just " ++ strFromInt n

sumDo : Maybe Int
sumDo = do
  x <- Just 1
  y <- Just 2
  pure (x + y)

bail : Maybe Int
bail = do
  x <- Just 10
  y <- Nothing
  pure (x + y)

main : String
main = showMaybe sumDo ++ "/" ++ showMaybe bail
