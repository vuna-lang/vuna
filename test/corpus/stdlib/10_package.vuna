-- stdlib：包门面 `import Base` 覆盖多个模块（List/Sort/Map/String/Monad）。
-- 阶段 5：宿主 console 走 Eff hostRow（entry 自动预装 handler）。
import Base.Eff
import Base.EffConsole
import Base.HostRow
import Base

sum : List Int -> Int
sum Nil = 0
sum (Cons x xs) = x + sum xs

result : String
result =
  let xs = fmap (\x => x + 1) [1, 2]
  in bool "False" "True" (mem 2 xs) ++ "/"
       ++ strFromInt (sum (mergeSort (Cons 3 (Cons 1 (Cons 2 Nil))))) ++ "/"
       ++ join "-" (map (\x => strFromInt x) xs) ++ "/"
       ++ strFromInt (fromMaybe 0 (lookup "a" (insert "a" 7 empty))) ++ "/" ++ strFromInt (strLength "p")

prog : Eff hostRow String
prog = do
  _ <- consolePrint "p"
  pure result

main : Eff hostRow String
main = prog
