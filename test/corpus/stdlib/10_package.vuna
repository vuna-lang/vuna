-- stdlib：包门面 `import Base` 覆盖多个模块（List/Sort/Map/String/Monad）。
-- 宿主 console 走 Eff [ConsoleOp]（entry 自动预装 handler）。
import Base.Effect.Eff as Eff
import Base.Effect.EffConsole as EffConsole
import Base

sum : List Int -> Int
sum [] = 0
sum (x :: xs) = x + sum xs

result : String
result =
  let
    xs = fmap (\x => x + 1) [1, 2]
  in bool "False" "True" (mem 2 xs)
    ++ "/"
    ++ strFromInt (sum (mergeSort ((::) 3 ((::) 1 ((::) 2 [])))))
    ++ "/"
    ++ join "-" (map (\x => strFromInt x) xs)
    ++ "/"
    ++ strFromInt (fromMaybe 0 (lookup "a" (insert "a" 7 empty)))
    ++ "/"
    ++ strFromInt (strLength "p")

prog : Eff [ConsoleOp] String
prog = do
  _ <- consolePrint "p"
  pure result

main : Eff [ConsoleOp] String
main = prog
