-- Array 的 Show / Eq 实例（落点 Base.Array；实例体经 toList 复用 List）。
import Base.Container.Array as Array

main : String
main =
  let
    a = Array.fromList [1, 2, 3]
    b = Array.fromList [1, 2, 3]
    c = Array.fromList [1, 2, 4]
  in show a ++ (if a == b then "/eq" else "/ne") ++ (if a == c then "/eq" else "/ne")
