-- stdlib：宿主 console 效应（print/println 的 typed 版本）+ Eff 的 do/pure。
-- main : Eff [] Int 由运行时执行；所有效果放进单个 Eff 动作，保证输出顺序一致。
import Base.Eff
import Base.EffConsole

program : Eff [Console "real"] Int
program = do
  n <- consolePrint "real" "abc"
  m <- consolePrint "real" "de"
  x <- consolePrint "real" "x\n"
  pure (n + m + x + 10)

main : Eff [] Int
main = runConsole "real" program
