-- stdlib：do 在 List monad 上（bind = concatMap，pure = 单元素）。
import Base.Monad
import Base.List
import Base.Pair

showPair : Pair Int Int -> String
showPair (Pair a b) = strFromInt a ++ ":" ++ strFromInt b

showPairs : List (Pair Int Int) -> String
showPairs [] = "[]"
showPairs (p :: ps) = showPair p ++ " " ++ showPairs ps

pairs : List (Pair Int Int)
pairs = do
  x <- (::) 1 ((::) 2 [])
  y <- (::) 10 ((::) 20 [])
  pure (Pair x y)

main : String
main = showPairs pairs
