-- stdlib：泛型 HashMap / HashSet（任意 Eq + Hashable 键）。
-- 需要 strHash intrinsic；只 check + compile + run（.run.out）。
import Base.Trait.Eq as Eq
import Base.Container.HashMap as HashMap
import Base.Container.HashSet as HashSet
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String

data Key : Type where
  MkKey : Int -> Key
deriving (Eq, Hashable)

intMap : HashMap Int Int
intMap = HashMap.insert 1 10 (HashMap.insert 2 20 (HashMap.fromList []))

pairMap : HashMap (Pair String Int) Int
pairMap = HashMap.fromList [Pair (Pair "x" 1) 10, Pair (Pair "y" 2) 20]

keyMap : HashMap Key Int
keyMap = HashMap.insert (MkKey 7) 70 (HashMap.fromList [])

setInt : HashSet Int
setInt = HashSet.fromList [3, 1, 2, 1]

main : String
main =
  strFromInt (fromMaybe 0 (HashMap.lookup 1 intMap))
    ++ "/"
    ++ strFromInt (fromMaybe 0 (HashMap.lookup (Pair "y" 2) pairMap))
    ++ "/"
    ++ strFromInt (fromMaybe 0 (HashMap.lookup (MkKey 7) keyMap))
    ++ "/"
    ++ strFromInt (HashSet.size setInt)
    ++ "/"
    ++ (if HashSet.member 2 setInt then "y" else "n")
    ++ "/"
    ++ (if HashSet.member 9 setInt then "y" else "n")
