-- deriving (Ord) 之后**运算符** `<`/`<=`/`>`/`>=` 同样走 Ord 字典。
-- 零参 data 族名按用户声明解析，不被当成内建类型（只有 `compare` 方法可用是不够的）。
import Prelude

data C3 : Type where
  Low : C3
  Mid : C3
  High : C3
deriving (Ord)

check : Bool -> Int
check b = if b then 1 else 0

main : Int
main = check (Low < Mid) + check (Mid <= High) + check (High > Low) + check (High >= High)
