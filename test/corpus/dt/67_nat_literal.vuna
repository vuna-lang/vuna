-- Nat 零开销表示：字面量构造、Nat 字段、Vec 字面量索引、Zero/Succ 模式。
import Base.Nat
import Base.Vec

toInt : Nat -> Int
toInt n = case n of
  Zero => 0
  Succ k => 1 + toInt k

data Box : Type where
  MkBox : Nat -> Box

unbox : Box -> Nat
unbox (MkBox n) = n

v3 : Vec 3 Int
v3 = Cons 1 (Cons 2 (Cons 3 Nil))

vsum : Vec 3 Int -> Int
vsum xs = case xs of
  Cons a (Cons b (Cons c Nil)) => a + b + c

main : Int
main = toInt (unbox (MkBox 3)) + vsum v3
