-- Nat 零开销表示：字面量构造、Nat 字段、Vec 字面量索引、Zero/Succ 模式。
import Base.Nat
import Base.Vec

toInt : Nat -> Int
toInt n = case n of
  Zero => 0
  Succ k => 1 + toInt k

data Box : Type where
  MkBox : Nat -> Box

unbox : Box -> Nat
unbox (MkBox n) = n

v3 : Vec 3 Int
v3 = 1 :: 2 :: 3 :: []

vsum : Vec 3 Int -> Int
vsum xs = case xs of
  [a, b, c] => a + b + c

main : Int
main = toInt (unbox (MkBox 3)) + vsum v3
