data Pair a b : Type where
  MkPair : a -> b -> Pair a b

data State : Type -> Type -> Type where
  MkState : {s : Type} -> {a : Type} -> (s -> Pair a s) -> State s a

runState : {s : Type} -> {a : Type} -> State s a -> s -> Pair a s
runState st s = case st of
  MkState f => f s

instance Monad (State s) where
  bind st k = MkState (\s => case runState st s of
    MkPair a s2 => runState (k a) s2
  )

instance Applicative (State s) where
  pure x = MkState (\s => MkPair x s)
  ap mf mx = MkState (\s => case runState mf s of
    MkPair g s1 => case runState mx s1 of
      MkPair b s2 => MkPair (g b) s2
  )
  liftA2 f sa sb = MkState (\s => case runState sa s of
    MkPair a s1 => case runState sb s1 of
      MkPair b s2 => MkPair (f a b) s2
  )

get : {s : Type} -> State s s
get = MkState (\s => MkPair s s)

prog : State Int Int
prog = do
  x <- get
  pure (x + 1)

main : Int
main = case runState prog 41 of
  MkPair a s => a + s
