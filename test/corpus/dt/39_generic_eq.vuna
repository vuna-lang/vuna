-- M23：没有 Eq 实例的类型上 `==` 退回泛型结构比较（与 HM 的运行时 `=` 对齐），
-- 不再报 "no instance" 错误。有实例时仍优先走字典。
data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat

data List a : Type where
  Nil : List a
  Cons : a -> List a -> List a

eqNat : Nat -> Nat -> Bool
eqNat a b = a == b

eqList : List Int -> List Int -> Bool
eqList a b = a == b

main : Int
main = if eqNat Zero Zero then (if eqNat Zero (Succ Zero) then 3 else 42) else 0
