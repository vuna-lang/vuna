-- M29：相等收口为证据驱动——没有 Eq 证据的 `==` / `/=` 在 check 期报错，
-- 不再退回泛型结构比较。普通 data 用 `deriving (Eq)`；参数化 data 的 `deriving (Eq)`
-- 生成约束实例（`instance Eq a => Eq (List a)`），`List Int` 上的相等因此可用。
data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat
deriving (Eq)

data List a : Type where
  Nil : List a
  Cons : a -> List a -> List a
deriving (Eq)

eqNat : Nat -> Nat -> Bool
eqNat a b = a == b

eqList : List Int -> List Int -> Bool
eqList a b = a == b

main : Int
main = if eqNat Zero Zero then if eqNat Zero (Succ Zero) then 3 else 42 else 0
