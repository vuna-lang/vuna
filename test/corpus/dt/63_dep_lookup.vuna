-- M29（B13/D12）：依赖索引 lookup —— 元素类型随位置变化时，把「类型码 + 该项」藏进
-- Σ（Tarski 风格存在式），lookup 只返回存在式。于是不需要精化器写出「按位置变化的
-- 类型族」（`docs/reference/type-system.md` 的依赖索引取值）：存在式本身就是索引隐藏手段。
-- 没有这层 Σ 时，递归步会把 `Ctx n` 精化成 `Ctx (Succ n)` 而拿不出 `Tm (Succ n)`
-- （负例：test/corpus/dt_err/46_lookup_no_sigma.vuna）。
-- Σ 的通用构造/投影/嵌套见 test/corpus/dt/62_sigma_basic.vuna。
data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat

data Fin : Nat -> Type where
  FZero : {n : Nat} -> Fin (Succ n)
  FSucc : {n : Nat} -> Fin n -> Fin (Succ n)

data Ty : Type where
  TNat : Ty

data Tm : Ty -> Type where
  TZero : Tm TNat

-- Σ (t : Ty). Tm t：元素类型随位置变化被存在式藏起来。
data Some : Type where
  MkSome : (t : Ty) -> Tm t -> Some

evalTm : (t : Ty) -> Tm t -> Int
evalTm t x = case t of
  TNat => 1

data Ctx : Nat -> Type where
  CtxNil : Ctx Zero
  CtxCons : {n : Nat} -> Some -> Ctx n -> Ctx (Succ n)

-- 依赖索引取值：返回存在式，因此递归步不需要把结果索引从 (Succ n) 收窄到 n。
lookupSome : {n : Nat} -> Ctx n -> Fin n -> Some
lookupSome c i = case c of
  CtxCons x xs => case i of
    FZero => x
    FSucc j => lookupSome xs j

get : Some -> Int
get s = case s of
  MkSome t x => evalTm t x

env2 : Ctx (Succ (Succ Zero))
env2 = CtxCons (MkSome TNat TZero) (CtxCons (MkSome TNat TZero) CtxNil)

main : Int
main = get (lookupSome env2 (FSucc FZero))
