-- M28 决策 1：严格分层、非累积（B05/D05/D06）。
--
-- 规则：data kind 必须是 Pi 链且以 `Type l`（l ≥ 0）收尾；构造子的**字段 binder**
-- （跳过前 arity 个族参数/索引 binder 后）的域 sort 必须 `≤ 族层级`；族参数/索引不受
-- 此限（大参数合法）。`Type i : Type (i+1)`，`Type i` 与 `Type j`（i≠j）不相等，
-- 没有 subtyping / cumulativity。
data Box5 : Type 5 where
  MkBox5 : Box5

data Eta : Type 0 where
  MkEta : Eta

-- `Type` 本身住 `Type 1`（sort 1），所以显式宇宙域字段要求族至少住在 `Type 1`。
data AtOne : Type 1 where
  MkAtOne : Type -> AtOne
  MkAtOneInt : Int -> AtOne

-- 普通字段（Int/String/Bool）的 sort 都是 0，族住在 `Type 0` 即可。
data Holder : Type where
  MkHolder : Int -> String -> Bool -> Holder

-- 大参数合法：`a : Type 1` 是族的第 1 个 binder（在 arity 内，不受字段层级检查）；
-- 字段 `Int` 的 sort 0 ≤ 族层级 0。注意这是**非累积**的：`Type 0 : Type 1` 才能填
-- `a : Type 1`，`Type 1` 不行。
data BigParam : Type 1 -> Type where
  MkBigParam : (a : Type 1) -> Int -> BigParam a

-- 依赖字段：`x : a` 的 sort 取参数 `a` 的层级（0），同样 ≤ 族层级。
data Dep : Type -> Type where
  MkDep : (a : Type) -> a -> Dep a

-- 非累积的正向证据：`Type 0` 住 `Type 1`，可以直接赋给 `Type 1` 的签名。
universe0 : Type 1
universe0 = Type 0

big : BigParam (Type 0)
big = MkBigParam (Type 0) 7

ignoreBig : BigParam (Type 0) -> Int
ignoreBig _ = 35

dep : Dep Int
dep = MkDep Int 35

depValue : Dep Int -> Int
depValue d = case d of
  MkDep a x => x

main : Int
main = ignoreBig big + depValue dep
