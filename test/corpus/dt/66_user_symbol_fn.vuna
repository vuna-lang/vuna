-- M31.3：用户符号名函数：定义 + 签名 + infix* 声明 + 中缀 / 反引号 / section 使用。
-- 符号名走与普通名相同的 Loader 解析与 codegen 名字转义（`<+>` → `_x60__x43__x62_`），
-- 因此必须真的能 codegen 并被 OCaml 编译运行。
--
-- 左/右 section 展开成 lambda：DT 精化在推断位置不接受无签名 lambda，按真实用法传给
-- 带函数签名的参数（检查模式）。
infixl 6 <+>
infixr 5 <++>

applyTo : (Int -> Int) -> Int
applyTo f = f 5

<+> : Int -> Int -> Int
<+> a b = a + b + 1

<++> : Int -> Int -> Int
<++> a b = a * 10 + b

-- 反引号里用符号名：`` 3 `<+>` 4 `` = `<+> 3 4`。
main : Int
main = 1 <+> 2 <+> 3 + (3 `<+>` 4) + (5 <++> 6) + applyTo (<+> 10) + applyTo (10 <+>)
