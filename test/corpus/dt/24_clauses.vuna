-- M19：多 clause 与方程左端模式（合成单个 case 表达式）。
-- M26：本地类型改名为 MyList/MyMaybe（构造子 MyNil/MyCons/MyNothing/MyJust），
-- 避开 base 的 List/Maybe 与其构造子 Nil/Cons/Just/Nothing；同名 data 的解析优先级
-- 见 A07/A08/A09/C17（M27）。语义与 expected.out 不变。
data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat

data MyList : Type -> Type where
  MyNil : (a : Type) -> MyList a
  MyCons : (a : Type) -> a -> MyList a -> MyList a

data MyMaybe : Type -> Type where
  MyNothing : (a : Type) -> MyMaybe a
  MyJust : (a : Type) -> a -> MyMaybe a

-- 每条 clause 的方程左端是构造子模式。
plus : Nat -> Nat -> Nat
plus Zero b = b
plus (Succ k) b = Succ (plus k b)

toInt : Nat -> Int
toInt Zero = 0
toInt (Succ k) = 1 + toInt k

len : MyList Nat -> Int
len (MyNil a) = 0
len (MyCons a y ys) = 1 + len ys

-- 同一构造子的多个 clause（子模式细化）+ 变量兜底。
pick : MyMaybe Nat -> Int
pick (MyNothing a) = 0
pick (MyJust a Zero) = 1
pick (MyJust a (Succ k)) = 2

-- 兜底 clause 在最前（前面的 clause 匹配所有值时后者不可达，语义按 clause 顺序）。
alwaysOne : Nat -> Int
alwaysOne n = 1
alwaysOne Zero = 99

four : Nat
four = Succ (Succ (Succ (Succ Zero)))

list1 : MyList Nat
list1 = MyCons Nat Zero (MyCons Nat (Succ Zero) (MyNil Nat))

main : Int
main = toInt (plus four four) + len list1 + pick (MyJust Nat (Succ Zero)) + alwaysOne four
