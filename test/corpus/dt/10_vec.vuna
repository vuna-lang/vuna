-- M14：索引族 Vec —— 用索引排除 Nil 分支（长度/首元素/尾）。
data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat

data Vec : Type -> Nat -> Type where
  Nil : (a : Type) -> Vec a Zero
  Cons : (a : Type) -> (n : Nat) -> a -> Vec a n -> Vec a (Succ n)

vhead : (a : Type) -> (n : Nat) -> Vec a (Succ n) -> a
vhead a n xs =
  case xs of
    Cons b m y ys => y

vtail : (a : Type) -> (n : Nat) -> Vec a (Succ n) -> Vec a n
vtail a n xs =
  case xs of
    Cons b m y ys => ys

vlen : (a : Type) -> (n : Nat) -> Vec a n -> Int
vlen a n xs =
  case xs of
    Nil b => 0
    Cons b m y ys => 1 + vlen b m ys

pair : Vec Int (Succ (Succ Zero))
pair = Cons Int (Succ Zero) 1 (Cons Int Zero 2 (Nil Int))

main : Int
main = vhead Int Zero (vtail Int (Succ Zero) pair) + vlen Int (Succ (Succ Zero)) pair
