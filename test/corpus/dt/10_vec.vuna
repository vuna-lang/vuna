-- M14：索引族 Vec —— 用索引排除 VNil 分支（长度/首元素/尾）。
data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat

data Vec : Type -> Nat -> Type where
  VNil : (a : Type) -> Vec a Zero
  VCons : (a : Type) -> (n : Nat) -> a -> Vec a n -> Vec a (Succ n)

vhead : (a : Type) -> (n : Nat) -> Vec a (Succ n) -> a
vhead a n xs = case xs of
  VCons b m y ys => y

vtail : (a : Type) -> (n : Nat) -> Vec a (Succ n) -> Vec a n
vtail a n xs = case xs of
  VCons b m y ys => ys

vlen : (a : Type) -> (n : Nat) -> Vec a n -> Int
vlen a n xs = case xs of
  VNil b => 0
  VCons b m y ys => 1 + vlen b m ys

pair : Vec Int (Succ (Succ Zero))
pair = VCons Int (Succ Zero) 1 (VCons Int Zero 2 (VNil Int))

main : Int
main = vhead Int Zero (vtail Int (Succ Zero) pair) + vlen Int (Succ (Succ Zero)) pair
