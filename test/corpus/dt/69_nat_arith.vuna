-- Nat 的 + - * /：减法截断到 0，其余饱和；interp 与产物必须一致。
import Base.Nat

toInt : Nat -> Int
toInt n = case n of
  Zero => 0
  Succ k => 1 + toInt k

subN : Nat -> Nat -> Nat
subN a b = a - b

mulN : Nat -> Nat -> Nat
mulN a b = a * b

divN : Nat -> Nat -> Nat
divN a b = a / b

main : Int
main = toInt (subN 2 5) + toInt (mulN 6 7) + toInt (divN 7 2)
