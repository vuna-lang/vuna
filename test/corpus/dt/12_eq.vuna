-- M14：Eq 族 —— refl 唯一构造子，sym/trans 靠索引合一自动消去不可能分支。
data Eq : Type -> Type -> Type where
  Refl : (a : Type) -> Eq a a

sym : (a : Type) -> (b : Type) -> Eq a b -> Eq b a
sym a b e = case e of
  Refl c => Refl c

trans : (a : Type) -> (b : Type) -> (c : Type) -> Eq a b -> Eq b c -> Eq a c
trans a b c e1 e2 = case e1 of
  Refl d => e2

n : Int
n = 7

main : Int
main = n
