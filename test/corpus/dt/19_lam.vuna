-- lambda 形参擦除规则。
-- lambda 形参只有域是宇宙才擦除；否则参与运行时表示（与定义参数同规则）。
data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat

-- ① 形参在运行时被使用：域是值类型的形参不擦除，因此合法。
twice : (Nat -> Nat) -> Nat -> Nat
twice f x = f (f x)

three : Nat
three = twice (\n => Succ n) Zero

toInt : Nat -> Int
toInt n = case n of
  Zero => 0
  Succ k => 1 + toInt k

-- ② 形参未被使用：仍必须生成完整 `fun` 层（少一层会在 ocamlopt 处报类型错）。
apply2 : (Int -> Int) -> Int -> Int
apply2 f x = f x

unused : Int
unused = apply2 (\n => 7) 1

-- ③ 闭包捕获上游状态：捕获的变量必须能正确带入闭包。
addN : Int -> Int -> Int
addN n x = x + n

captured : Int
captured = addN 10 5

-- ④ 高阶传 lambda：lambda 作为实参传给高阶函数，再被调用。
inc : Int -> Int
inc n = n + 1

dbl : Int -> Int
dbl n = n * 2

main : Int
main = toInt three + unused + captured + inc (dbl 3)
