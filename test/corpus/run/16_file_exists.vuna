-- 阶段 5：fs 查询走 typed effects（entry 自动预装 handler），不再直接调用宿主原语。
import Base.Eff
import Base.EffFs
import Base.HostRow

prog : Eff hostRow Int
prog = do
  root <- fsFileExists "default" "/"
  nope <- fsFileExists "default" "/vuna/definitely-not-a-file-xyz"
  pure (if root then (if nope then 0 else 42) else 0)

main : Eff hostRow Int
main = prog
