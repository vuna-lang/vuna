-- P2c：fs 查询走 typed effects（Fs 标签 + runFs），不再直接调用宿主原语。
import Base.Eff
import Base.EffFs

prog : Eff [FsOp@real] Int
prog = do
  root <- fsFileExists "real" "/"
  nope <- fsFileExists "real" "/vuna/definitely-not-a-file-xyz"
  pure (if root then (if nope then 0 else 42) else 0)

main : Eff [] Int
main = runFs "real" prog
