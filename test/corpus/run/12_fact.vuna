-- Nat 上的结构递归（`fact (S k) = … * fact k`）：下降由构造子模式给出。
-- Int 上的 `n - 1` 递降需要下界守卫证据，这里只用 Nat 结构递归，golden 不变。
data Nat : Type where
  Z : Nat
  S : Nat -> Nat

toInt : Nat -> Int
toInt Z = 0
toInt (S k) = 1 + toInt k

fact : Nat -> Int
fact Z = 1
fact (S k) = toInt (S k) * fact k

main : Int
main = fact (S (S (S (S (S Z)))))
