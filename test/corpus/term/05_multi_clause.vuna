-- 多 clause 函数，每个 clause 的自递归都要有下降证据。
import Prelude

data Nat : Type where
  Zero : Nat
  Succ : Nat -> Nat

append2 : List Int -> List Int -> List Int
append2 [] ys = ys
append2 (x :: rest) ys = (::) x (append2 rest ys)

dropAll : Nat -> List Int -> List Int
dropAll Zero xs = xs
dropAll (Succ k) [] = []
dropAll (Succ k) (x :: rest) = dropAll k rest

main : Int
main = 0
