module Fancy where

-- codegen 夹具：多构造子 data + 大 case（ctorcount/maxline）、as-pattern（多 clause）、
-- let 多 clause。
import Base.List

export data Shape(..) : Type where
  Circle : Int -> Shape
  Square : Int -> Shape
  Triangle : Int -> Int -> Shape
  Rect : Int -> Int -> Shape
  Pentagon : Int -> Shape
  Hexagon : Int -> Int -> Shape

export area : Shape -> Int
area s = case s of
  Circle r => r * r
  Square a => a * a
  Triangle b h => b * h
  Rect w h => w * h
  Pentagon a => a * a
  Hexagon w h => w * h

export firstTwo : List Int -> Int
firstTwo [] = 0
firstTwo (all@(x :: rest)) = x + length all + length rest

export swapAdd : Int -> Int
swapAdd n =
  let
    f : Int -> Int
    f 0 = n
    f _ = n + 1
  in f 2
