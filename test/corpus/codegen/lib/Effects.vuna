module Effects where

-- codegen 夹具：IO/do（Monad bind/pure）、效果原语直接调用（prim_* 本身是 IO 动作，
-- M31 的 ioPrim 包装路径）与零参定义（zeroarg 应为 0）。
-- program / probe 不被求值，只要求它们进入 codegen 产物，覆盖 IO 动作的生成形状。
import Base.Monad
import Base.IO.Host

program : IO Int
program = do
  _ <- print "codegen"
  pure 0

probe : IO Int
probe = prim_print "codegen"

marker : Int
marker = 0
