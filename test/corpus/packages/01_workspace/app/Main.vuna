import Vuna.Hello
import Dep
import Base.Eff
import Base.EffConsole

-- P2c：宿主 console 走 Eff（runConsole）；main 返回 0，golden 含尾随 0。
-- C35/M37：`tag` 让产物 Main.ml 引用依赖单元的构造子（跨单元全限定断言）。
tag : DepTag
tag = DepTagA

prog : Eff [ConsoleOp@real] Int
prog = do
  _ <- consolePrint "real" (hello ++ "/" ++ depText)
  pure 0

main : Eff [] Int
main = runConsole "real" prog
