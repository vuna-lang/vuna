import Facade
import Vuna.Use
import Base.Eff
import Base.EffConsole

-- P2c：宿主 console 走 Eff（runConsole）；main 返回 0，golden 含尾随 0。
prog : Eff [Console "real"] Int
prog = do
  _ <- consolePrint "real" (strFromInt (total [1, 2, 3] + firstOr (Just 10)))
  pure 0

main : Eff [] Int
main = runConsole "real" prog
