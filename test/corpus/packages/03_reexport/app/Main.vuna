import Facade
import Vuna.Use
import Base.Effect.Eff as Eff
import Base.Effect.EffConsole as EffConsole

-- 宿主 console 走 Eff [ConsoleOp]（entry 自动预装 handler）；main 返回 0，golden 含尾随 0。
prog : Eff [ConsoleOp] Int
prog = do
  _ <- consolePrint (strFromInt (total [1, 2, 3] + firstOr (Just 10)))
  pure 0

main : Eff [ConsoleOp] Int
main = prog
