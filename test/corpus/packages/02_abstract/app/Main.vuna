import Vuna.Box
import Base.Effect.Core as Eff
import Base.Effect.Console as EffConsole

-- 宿主 console 走 Eff [ConsoleOp]（entry 自动预装 handler）；main 返回 0，golden 含尾随 0。
prog : Eff [ConsoleOp] Int
prog = do
  _ <- consolePrint (strFromInt (boxValue (makeBox 42)))
  pure 0

main : Eff [ConsoleOp] Int
main = prog
