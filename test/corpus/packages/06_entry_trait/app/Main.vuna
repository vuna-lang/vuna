-- M26 夹具：入口 data + trait + instance + deriving 都可 build。
-- Prelude 由包上下文自动注入（base 依赖），因此 Show 与本文件的 Pretty 同时可见。
data Color : Type where
  Red : Color
  Blue : Color
deriving (Show)

trait Pretty a where
  pretty : a -> String

instance Pretty Color where
  pretty c = case c of
    Red => "red"
    Blue => "blue"

main : String
main = pretty Red ++ "/" ++ show Blue
