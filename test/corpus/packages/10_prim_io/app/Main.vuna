-- M37 / C1：Eff 是唯一动作类型；宿主原语是 `Eff []` 叶子。
-- `@vuna@prim_eff_sleep`（微秒，原生阻塞睡眠）探针断言真实推进时间；`exitWith "default" 0`
-- 让 golden 只含业务输出。
import Base.HostRow
import Base.EffClock
import Base.EffExit
import Base.EffConsole
import Base.Eff

main : Eff hostRow Int
main = do
  _ <- consolePrint "default" "hi\n"
  t0 <- effTimeUs
  _ <- clockSleepMicros "default" 5000
  t1 <- effTimeUs
  _ <- consolePrint "default" (if t1 - t0 >= 3000 then "slept\n" else "early\n")
  exitWith "default" 0
