module TrustLib (probe, runIOHelper) where

-- D28 夹具：`runIOHelper` 是信任点（manifest `[trust] unsafe` 列出），可以直调
-- `unsafe` 门控内建 `prim_schedNewScope`；`probe` 只经信任入口间接使用，不是直接使用点。

-- | 信任点：直接引用 unsafe 门控内建（D28 夹具的合法直接使用点）。
runIOHelper : Int -> Int
runIOHelper x = prim_schedNewScope x

-- | 非信任定义：只调用信任入口 `runIOHelper`，不直接引用 unsafe 门控目标。
probe : Int -> Int
probe x = runIOHelper x + x
