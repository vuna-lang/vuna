-- 答案本身是 Eff 动作（`return x -> pure x`，两层 runPure），
-- 以及丢弃续延（abort，续延 binder 用 `_`）。
import Base.Effect.Eff as Eff
import Base.Effect.EffConsole as EffConsole
import Base.Data.List as List
import Base.Trait.Monad as Monad
import Base.Data.Nat as Nat

prog : Eff [ConsoleOp@audit] Nat
prog = do
  n <- perform Print "hello"
  pure (n + 1)

runAnswer : Eff ([ConsoleOp@"audit"]) Nat -> Nat
runAnswer comp = runPure (runPure (handle comp {
  return x -> pure x
  Print s k -> k 5
  EPrint s k -> k 7
}
)
)

runAbort : Eff ([ConsoleOp@"audit"]) Nat -> Nat
runAbort comp = runPure (handle comp {
  Print s _ -> 5
  EPrint s _ -> 7
}
)

main : Nat
main = runAnswer prog + runAbort prog
