-- M37：StateT 效应栈（IO 之上）。`runStateT` 返回 IO 动作，由 main 执行；
-- `liftIO` 把 IO 动作提升进 StateT，handler 显式取 Pair。
import Base.Effect
import Base.IO
import Base.Pair
import Base.StateT

prog : StateT Int Int
prog = do
  x <- get
  _ <- put (x + 1)
  liftIO (print "state\n")
  pure (x + 10)

main : IO Int
main = do
  p <- runStateT prog 41
  print ("result=" ++ strFromInt (firstOf p) ++ ",state=" ++ strFromInt (secondOf p) ++ "\n")
  exit 0
