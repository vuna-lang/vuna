-- M37：State 效应栈（用 Base.EffState 取代旧 StateT）。
-- 标签 `State "counter" Int`；handler 以 `s -> Pair a s` 为 answer 线程状态。
import Base.Eff
import Base.EffState
import Base.Host
import Base.Pair

prog : Eff [State "counter" Int] Int
prog = do
  x <- get "counter" Int
  _ <- put "counter" Int (x + 1)
  pure (x + 10)

ret : Int -> Int -> Pair Int Int
ret a s = Pair a s

opH : (o : StateOp Int) -> (Base.EffState.resState Int o -> Int -> Pair Int Int) -> Int -> Pair Int Int
opH op k s = case op of
  Get => k s s
  Put x => k 0 x

main : Eff [] Int
main = do
  _ <- print "state\n"
  case runPure (handleState "counter" Int ret opH prog) 41 of
    Pair a s => do
      _ <- print ("result=" ++ strFromInt a ++ ",state=" ++ strFromInt s ++ "\n")
      exit 0
