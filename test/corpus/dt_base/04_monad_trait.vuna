-- M21：trait 方法投影经 `import Base.Monad` 可用（fmap / bind / pure），
-- 具体实例来自 `import Base.Maybe`；do 块走同一套投影。
import Base.Monad
import Base.Maybe

mapProbe : Maybe Int
mapProbe = fmap (\x => x + 1) (Just 41)

bindProbe : Maybe Int
bindProbe = Just 41 >>= (\x => Just (x + 1))

doProbe : Maybe Int
doProbe = do
  x <- Just 41
  pure (x + 1)

main : Int
main = case doProbe of
  Nothing => 0
  Just x => x
