-- op 携带子计算（Try），scoped handler 在嵌套 handler 里运行子计算；
-- 子计算里的 Reader 效应继续由外层 handler 处理。
import Base.Effect.Eff as Eff
import Base.Effect.EffReader as EffReader
import Base.Effect.EffExn as EffExn
import Base.Data.Result as Result

prog : Eff [ExnOp@default, ReaderOp Int@counter] Int
prog = do
  res <- tryWith "default" (do
    x <- ask "counter" Int
    _ <- throwExn "default" "boom"
    pure x
  )
  case res of
    Ok a => pure a
    Err _ => do
      x <- ask "counter" Int
      pure (x + 100)

opH : (i : Type) -> (o : ReaderOp Int i) -> (Eff.resIdx i o -> Int) -> Int
opH i op k = case op of
  Ask => k 7

main : Int
main = runPure (handleReader "counter" Int (\a => a) opH (do
  res <- runExn "default" prog
  case res of
    Ok n => pure n
    Err _ => pure 0
)
)
