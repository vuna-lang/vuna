-- W6：op 携带子计算（Try），scoped handler 在嵌套 handler 里运行子计算；
-- 子计算里的 Reader 效应继续由外层 handler 处理。
import Base.Eff
import Base.Eff.Reader
import Base.EffExn
import Base.Result

prog : Eff [Exn "main", Reader "counter" Int] Int
prog = do
  res <- tryWith "main" (do
    x <- ask "counter" Int
    _ <- throwExn "main" "boom"
    pure x
  )
  case res of
    Ok a => pure a
    Err _ => do
      x <- ask "counter" Int
      pure (x + 100)

opH : (o : ReaderOp Int) -> (Base.Eff.Reader.resReader Int o -> Int) -> Int
opH op k = case op of
  Ask => k 7

main : Int
main = runPure (handleReader "counter" Int (\a => a) opH (do
  res <- runExn "main" prog
  case res of
    Ok n => pure n
    Err _ => pure 0
))