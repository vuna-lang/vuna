-- Layer 1：State 效应（handler 以 s -> Pair a s 为 answer，续延线程状态）。
import Base.Eff
import Base.EffState
import Base.Pair

prog : Eff [State "counter" Int] Int
prog = do
  x <- get "counter" Int
  _ <- put "counter" Int (x + 1)
  get "counter" Int

ret : Int -> Int -> Pair Int Int
ret a s = Pair a s

opH : (o : StateOp Int) -> (Base.EffState.resState Int o -> Int -> Pair Int Int) -> Int -> Pair Int Int
opH op k s = case op of
  Get => k s s
  Put x => k 0 x

main : Int
main = case runPure (handleState "counter" Int ret opH prog) 3 of
  Pair a s => a + s
