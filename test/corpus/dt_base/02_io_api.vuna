-- M21：宿主原语（`prim_eff_*`）在 DT 下的类型面。效果不在这条夹具里执行
-- （纯核心求值器不跑效果），运行时效果见 corpus/dt_io/。
-- D25 的 `Nat` 边界在 Eff 标签的 result 族（`Base.EffConsole.Print`、`Base.EffFs.WriteFile`/`FileSize`），
-- 直接调用原语得到 `Int`。
import Base.Eff
import Base.List

readProbe : Eff [] String
readProbe = prim_eff_readFile "x"

writeProbe : Eff [] Int
writeProbe = prim_eff_writeFile "x" "y"

lineProbe : Eff [] String
lineProbe = prim_eff_readLine

dirProbe : Eff [] (List String)
dirProbe = prim_eff_readDir "."

isDirProbe : Eff [] Bool
isDirProbe = prim_eff_isDirectory "."

makeDirProbe : Eff [] Int
makeDirProbe = prim_eff_makeDir "x"

removeProbe : Eff [] Int
removeProbe = prim_eff_removeFile "x"

existsProbe : Eff [] Bool
existsProbe = prim_eff_fileExists "x"

mtimeProbe : Eff [] Int
mtimeProbe = prim_eff_fileMtime "x"

sizeProbe : Eff [] Int
sizeProbe = prim_eff_fileSize "x"

argsProbe : Eff [] (List String)
argsProbe = prim_eff_getArgs

exitProbe : Eff [] Int
exitProbe = prim_eff_exit 0

main : Eff [] Int
main = pure 0
