-- M21：`Base.IO` 的公开 API 在 DT 下全部可用（类型面）。效果不在这条夹具里执行
-- （纯核心求值器不跑效果），运行时效果见 corpus/dt_io/。
import Base.Host
import Base.List
import Base.Nat

readProbe : Eff [] String
readProbe = readFile "x"

writeProbe : Eff [] Nat
writeProbe = writeFile "x" "y"

lineProbe : Eff [] String
lineProbe = readLine

dirProbe : Eff [] (List String)
dirProbe = readDir "."

isDirProbe : Eff [] Bool
isDirProbe = isDirectory "."

makeDirProbe : Eff [] Int
makeDirProbe = makeDir "x"

removeProbe : Eff [] Int
removeProbe = removeFile "x"

existsProbe : Eff [] Bool
existsProbe = fileExists "x"

mtimeProbe : Eff [] Int
mtimeProbe = fileTimeProbe

fileTimeProbe : Eff [] Int
fileTimeProbe = fileMtime "x"

sizeProbe : Eff [] Nat
sizeProbe = fileSize "x"

argsProbe : Eff [] (List String)
argsProbe = getArgs

exitProbe : Eff [] Int
exitProbe = exit 0

main : Eff [] Int
main = pure 0
