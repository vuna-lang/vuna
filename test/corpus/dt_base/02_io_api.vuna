-- 宿主原语（`@vuna@prim_eff_*`）在 DT 下的类型面。效果不在这条夹具里执行
-- （纯核心求值器不跑效果），运行时效果见 corpus/dt_io/。
-- `Nat` 边界在 Eff 标签的 result 族（`Base.EffConsole.Print`、`Base.EffFs.WriteFile`/`FileSize`），
-- 直接调用原语得到 `Int`。
import Base.EffStdin
import Base.EffExit
import Base.EffArgs
import Base.EffFs
import Base.Eff
import Base.List
import Base.Nat

readProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] String
readProbe = fsReadFile "x"

writeProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] Nat
writeProbe = fsWriteFile "x" "y"

lineProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] (Maybe String)
lineProbe = stdinReadLine

dirProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] (List String)
dirProbe = fsReadDir "."

isDirProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] Bool
isDirProbe = fsIsDirectory "."

makeDirProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] Int
makeDirProbe = fsMakeDir "x"

removeProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] Int
removeProbe = fsRemoveFile "x"

existsProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] Bool
existsProbe = fsFileExists "x"

mtimeProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] (Maybe Int)
mtimeProbe = fsFileMtime "x"

sizeProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] (Maybe Nat)
sizeProbe = fsFileSize "x"

argsProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] (List String)
argsProbe = argsGetArgs

exitProbe : Eff [FsOp, ExitOp, StdinOp, ArgsOp] Int
exitProbe = exitWith 0

main : Eff [FsOp, ExitOp, StdinOp, ArgsOp] Int
main = pure 0
