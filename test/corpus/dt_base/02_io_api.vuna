-- 宿主原语（`@vuna@prim_eff_*`）在 DT 下的类型面。效果不在这条夹具里执行
-- （纯核心求值器不跑效果），运行时效果见 corpus/dt_io/。
-- `Nat` 边界在 Eff 标签的 result 族（`Base.EffConsole.Print`、`Base.EffFs.WriteFile`/`FileSize`），
-- 直接调用原语得到 `Int`。
import Base.Effect.EffStdin as EffStdin
import Base.Effect.EffExit as EffExit
import Base.Effect.EffArgs as EffArgs
import Base.Effect.EffFs as EffFs
import Base.Effect.Eff as Eff
import Base.Data.List as List
import Base.Data.Nat as Nat

readProbe : Eff [FsOp] String
readProbe = fsReadFile "x"

writeProbe : Eff [FsOp] Nat
writeProbe = fsWriteFile "x" "y"

lineProbe : Eff [StdinOp] (Maybe String)
lineProbe = stdinReadLine

dirProbe : Eff [FsOp] (List String)
dirProbe = fsReadDir "."

isDirProbe : Eff [FsOp] Bool
isDirProbe = fsIsDirectory "."

makeDirProbe : Eff [FsOp] Int
makeDirProbe = fsMakeDir "x"

removeProbe : Eff [FsOp] Int
removeProbe = fsRemoveFile "x"

existsProbe : Eff [FsOp] Bool
existsProbe = fsFileExists "x"

mtimeProbe : Eff [FsOp] (Maybe Int)
mtimeProbe = fsFileMtime "x"

sizeProbe : Eff [FsOp] (Maybe Nat)
sizeProbe = fsFileSize "x"

argsProbe : Eff [ArgsOp] (List String)
argsProbe = argsGetArgs

exitProbe : Eff [ExitOp] Int
exitProbe = exitWith 0

main : Eff [] Int
main = pure 0
