-- M21：宿主原语（`@vuna@prim_eff_*`）在 DT 下的类型面。效果不在这条夹具里执行
-- （纯核心求值器不跑效果），运行时效果见 corpus/dt_io/。
-- D25 的 `Nat` 边界在 Eff 标签的 result 族（`Base.EffConsole.Print`、`Base.EffFs.WriteFile`/`FileSize`），
-- 直接调用原语得到 `Int`。
import Base.HostRow
import Base.EffStdin
import Base.EffExit
import Base.EffArgs
import Base.EffFs
import Base.Eff
import Base.List
import Base.Nat

readProbe : Eff hostRow String
readProbe = fsReadFile "x"

writeProbe : Eff hostRow Nat
writeProbe = fsWriteFile "x" "y"

lineProbe : Eff hostRow String
lineProbe = stdinReadLine

dirProbe : Eff hostRow (List String)
dirProbe = fsReadDir "."

isDirProbe : Eff hostRow Bool
isDirProbe = fsIsDirectory "."

makeDirProbe : Eff hostRow Int
makeDirProbe = fsMakeDir "x"

removeProbe : Eff hostRow Int
removeProbe = fsRemoveFile "x"

existsProbe : Eff hostRow Bool
existsProbe = fsFileExists "x"

mtimeProbe : Eff hostRow Int
mtimeProbe = fsFileMtime "x"

sizeProbe : Eff hostRow Nat
sizeProbe = fsFileSize "x"

argsProbe : Eff hostRow (List String)
argsProbe = argsGetArgs

exitProbe : Eff hostRow Int
exitProbe = exitWith 0

main : Eff hostRow Int
main = pure 0
