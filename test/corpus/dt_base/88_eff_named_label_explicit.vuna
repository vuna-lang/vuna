-- Named 标签与 (::)：显式 `Named "audit" Op :: []` 与行字面量 `[Op@audit]` 等价。
import Base.Effect.Core as Eff
import Base.Effect.Console as EffConsole
import Base.Trait.Monad as Monad
import Base.Data.Nat as Nat

prog : Eff (Named "audit" ConsoleOp :: []) Nat
prog = do
  n <- perform Print "hi"
  pure (n + 1)

same : Eff [ConsoleOp@audit] Nat
same = prog

main : Nat
main = runPure (handle prog {
  Print s k -> k 1
  EPrint s k -> k 0
}
)
