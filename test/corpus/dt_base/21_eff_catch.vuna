-- Layer 2：Error 的作用域 catch（嵌套 catch；fallback 在 handler 之外执行）。
import Base.Eff
import Base.EffError
import Base.Result

prog : Eff [Error "default"] Int
prog = catch "default" (throw "default" "boom") (\_ => pure 42)

prog2 : Eff [Error "default"] Int
prog2 =
  catch "default" (catch "default" (throw "default" "a") (\_ => throw "default" "b")) (\_ => pure 7)

main : Int
main = case (runPure (runError "default" (do
  a <- prog
  b <- prog2
  pure (a * 100 + b)
)
)
) of
  Ok n => n
  Err _ => 0
