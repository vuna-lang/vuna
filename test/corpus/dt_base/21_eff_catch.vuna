-- Layer 2：Error 的作用域 catch（嵌套 catch；fallback 在 handler 之外执行）。
import Base.Eff
import Base.EffError
import Base.Result

prog : Eff (Error E1 :: []) Int
prog = catch E1 (throw E1 "boom") (\_ => pureEff 42)

prog2 : Eff (Error E1 :: []) Int
prog2 = catch E1 (catch E1 (throw E1 "a") (\_ => throw E1 "b")) (\_ => pureEff 7)

main : Int
main = case runPure (runError E1 (bindEff prog (\a => bindEff prog2 (\b => pureEff (a * 100 + b))))) of
  Ok n => n
  Err _ => 0
