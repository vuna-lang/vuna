-- Layer 2：Error 的作用域 catch（嵌套 catch；fallback 在 handler 之外执行）。
import Base.Eff
import Base.EffError
import Base.Result

prog : Eff [Error "main"] Int
prog = catch "main" (throw "main" "boom") (\_ => pure 42)

prog2 : Eff [Error "main"] Int
prog2 = catch "main" (catch "main" (throw "main" "a") (\_ => throw "main" "b")) (\_ => pure 7)

main : Int
main = case runPure (runError "main" (do
  a <- prog
  b <- prog2
  pure (a * 100 + b)
)) of
  Ok n => n
  Err _ => 0