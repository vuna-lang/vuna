-- D24：大 Nat 字面量（300 / 1000）不撞固定步数预算。
--
-- 字面量在 Core 里展开成 `Zero` / `Succ` 链；擦除检查 / capture check / 求值路径都按
-- 结构递归遍历，没有固定 fuel：这个深度既不报 `erasure fuel exhausted`，也不会在求值
-- 中途截断链。这里同时覆盖：链折回、Nat 字面量模式、`show` / `toInt` / `<` 的运行时
-- 表示（OCaml int）。
import Base.Data.Nat as Nat
import Base.Data.String as String

n : Nat
n = 300

m : Nat
m = 1000

pick : Nat -> Int
pick k = case k of
  300 => 1
  1000 => 2
  _ => 3

bigShow : String
bigShow = show n ++ "/" ++ show m

nGreater : Bool
nGreater = n < m

main : Int
main = toInt n + toInt m + pick n + pick m + (if nGreater then 10 else 0)
