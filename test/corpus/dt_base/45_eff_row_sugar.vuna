-- 行语法糖：`[Fetch]` / `[Fetch, Log]` / `[]` 在期望 Row 的位置展开为
-- Cons/Nil；普通列表字面量（List Int）不受影响。
import Base.Eff
import Base.List
import Base.String

data Fetch : Type where

data Log : Type where

data FetchOp : Type where
  FetchUrl : String -> FetchOp

resFetch : FetchOp -> Type
resFetch (FetchUrl _) = String

fetch : String -> {r : Row} -> {w : Member Fetch r} -> Eff r String
fetch url = sendCore Fetch "fetch" "fetch" (FetchUrl url)

r1 : Row
r1 = [Fetch]

r2 : Row
r2 = [Fetch, Log]

-- B43：`::` 是 `Cons` 的中缀别名（fixity 来自 Base.List）；在期望 Row 的位置由期望
-- 类型消歧到 Row.Cons（不再默认 List.Cons），非 Row 位置才是 List。
r3 : Row
r3 = Fetch :: Nil

r0 : Row
r0 = []

xs : List Int
xs = [1, 2, 3]

getPage : String -> Eff [Fetch] String
getPage url = fetch url

handleFetch : {a : Type} -> {b : Type} -> {r : Row} -> (a -> b) -> ((o : FetchOp) -> (resFetch o -> b) -> b) -> Eff (Cons Fetch r) a -> Eff r b
handleFetch ret opH comp = handleCore Fetch "fetch" "fetch" ret opH comp

opH : (o : FetchOp) -> (resFetch o -> String) -> String
opH op k = case op of
  FetchUrl url => k ("body of " ++ url)

prog : Eff [Fetch] String
prog = getPage "example"

main : String
main = runPure (handleFetch (\a => a) opH prog)