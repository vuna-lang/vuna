-- 行语法糖：`[Fetch]` / `[Fetch, Log]` / `[]` 在期望 Row 的位置展开为
-- Cons/Nil（命名行：裸标签补默认名 "default"）；普通列表字面量（List Int）不受影响。
import Base.Effect.Core as Eff
import Base.Data.List as List
import Base.Data.String as String

data Fetch : Type -> Type where
  FetchUrl : String -> Fetch String

data Log : Type -> Type where

fetch : String -> {r : Row} -> {w : Member (Named "default" Fetch) r} -> Eff r String
fetch url = sendCore (Named "default" Fetch) "fetch" "default" (FetchUrl url)

r1 : Row
r1 = [Fetch]

r2 : Row
r2 = [Fetch, Log]

-- 命名行：`Row.Cons` 需要 (名字, 标签, 尾行) 三个实参，`::` 中缀别名只适
-- 用于二参构造子，故这里直接写 `[Fetch]`。
r3 : Row
r3 = [Fetch]

-- 显式 `Named` 条目：列表字面量不再包一层默认名（与 `Named ... :: []` 等价）。
r4 : Row
r4 = [Named "default" Fetch]

r5 : Row
r5 = [Named "audit" Fetch, Log]

r0 : Row
r0 = []

xs : List Int
xs = [1, 2, 3]

getPage : String -> Eff [Fetch] String
getPage url = fetch url

handleFetch : {a : Type} -> {b : Type} -> {r : Row} -> (a -> b) -> ((i : Type) -> (o : Fetch i) -> (Eff.resIdx i o -> b) -> b) -> Eff (Named "default" Fetch :: r) a -> Eff r b
handleFetch ret opH comp = handleCore (Named "default" Fetch) "fetch" "default" ret opH comp

opH : (i : Type) -> (o : Fetch i) -> (Eff.resIdx i o -> String) -> String
opH i op k = case op of
  FetchUrl url => k ("body of " ++ url)

prog : Eff [Fetch] String
prog = getPage "example"

main : String
main = runPure (handleFetch (\a => a) opH prog)
