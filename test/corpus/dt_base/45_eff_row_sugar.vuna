-- 行语法糖：`[Fetch]` / `[Fetch, Log]` / `[]` 在期望 Row 的位置展开为
-- Cons/Nil（命名行：裸标签补默认名 "main"）；普通列表字面量（List Int）不受影响。
import Base.Eff
import Base.List
import Base.String

data Fetch : Type where

data Log : Type where

data FetchOp : Type where
  FetchUrl : String -> FetchOp

resFetch : FetchOp -> Type
resFetch (FetchUrl _) = String

fetch : String -> {r : Row} -> {w : Member "main" Fetch r} -> Eff r String
fetch url = sendCore Fetch "fetch" "main" (FetchUrl url)

r1 : Row
r1 = [Fetch]

r2 : Row
r2 = [Fetch, Log]

-- 命名行（ND1）：`Row.Cons` 需要 (名字, 标签, 尾行) 三个实参，`::` 中缀别名只适
-- 用于二参构造子，故这里直接写 `Cons "main" Fetch Nil`。
r3 : Row
r3 = Cons "main" Fetch []

r0 : Row
r0 = []

xs : List Int
xs = [1, 2, 3]

getPage : String -> Eff [Fetch] String
getPage url = fetch url

handleFetch : {a : Type} -> {b : Type} -> {r : Row} -> (a -> b) -> ((o : FetchOp) -> (resFetch o -> b) -> b) -> Eff (Cons "main" Fetch r) a -> Eff r b
handleFetch ret opH comp = handleCore Fetch "fetch" "main" ret opH comp

opH : (o : FetchOp) -> (resFetch o -> String) -> String
opH op k = case op of
  FetchUrl url => k ("body of " ++ url)

prog : Eff [Fetch] String
prog = getPage "example"

main : String
main = runPure (handleFetch (\a => a) opH prog)
