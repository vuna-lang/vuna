-- W7：线性 handler；续延是 quantity 1 的 Cont，resume 一次通过。
import Base.Eff
import Base.Eff.Reader

prog : Eff (RCons (Reader Cnt1 Int) RNil) Int
prog = ask Cnt1 Int

opH : (o : ReaderOp Int) -> (1 k : Cont (Base.Eff.Reader.resReader Int o) Int) -> Int
opH op k = case op of
  Ask => resumeCont k 7

main : Int
main = runPure (handleReaderLin Cnt1 Int (\a => a) opH prog)
