-- 泛型 Base.HashMap 在 DT 包上下文的可用性（与 Base.Sort/Map 同层）。
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Base.Data.Pair as Pair

main : Int
main =
  let
    h = HashMap.fromList [Pair "a" 1, Pair "b" 2, Pair "a" 3]
    m = HashMap.fromList [Pair 0 10, Pair 1024 11]
  in (case HashMap.lookup "a" h of
    Just v => v
    Nothing => 0
  ) + (case HashMap.lookup 1024 m of
    Just v => v
    Nothing => 0
  )
