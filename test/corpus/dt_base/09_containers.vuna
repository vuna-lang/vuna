-- M22.2：Base.HashMap / Base.IntMap 在 DT 包上下文的可用性（与 Base.Sort/Map 同层）。
import Base.HashMap
import Base.IntMap
import Base.List
import Base.Pair

main : Int
main =
  let
    h = Base.HashMap.fromList [Pair "a" 1, Pair "b" 2, Pair "a" 3]
    m = Base.IntMap.fromList [Pair 0 10, Pair 1024 11]
  in (case Base.HashMap.lookup "a" h of
        Just v => v
        Nothing => 0)
       + (case Base.IntMap.lookup 1024 m of
            Just v => v
            Nothing => 0)