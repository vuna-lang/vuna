-- Error 效应栈（`Base.Effect.Error`）。
-- `throw` 被作用域 `catch` 恢复；结果用 `Result` 观察。
import Base.Effect.Exit as EffExit
import Base.Effect.Console as EffConsole
import Base.Effect.Core as Eff
import Base.Effect.Error as EffError
import Base.Data.Result as Result

prog : Eff [ErrorOp@e] Int
prog = throw@e "boom"

main : Eff [ConsoleOp, ExitOp] Int
main = do
  _ <- consolePrint "error\n"
  r <- pure (runPure (runError "e" (catch "e" prog (\msg => pure 7))))
  case r of
    Ok a => do
      _ <- consolePrint ("ok " ++ strFromInt a ++ "\n")
      exitWith 0
    Err msg => do
      _ <- consolePrint ("caught " ++ msg ++ "\n")
      exitWith 0
