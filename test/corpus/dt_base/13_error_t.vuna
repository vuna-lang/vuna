-- M37：Error 效应栈（用 Base.EffError 取代旧 ErrorT）。
-- `throw` 被作用域 `catch` 恢复；结果用 `Result` 观察。
import Base.Eff
import Base.EffError
import Base.Host
import Base.Result

prog : Eff [ErrorOp@e] Int
prog = throw "e" "boom"

main : Eff [] Int
main = do
  _ <- print "error\n"
  r <- pure (runPure (runError "e" (catch "e" prog (\msg => pure 7))))
  case r of
    Ok a => do
      _ <- print ("ok " ++ strFromInt a ++ "\n")
      exit 0
    Err msg => do
      _ <- print ("caught " ++ msg ++ "\n")
      exit 0
