-- M37：Error 效应栈（用 Base.EffError 取代旧 ErrorT）。
-- `throw` 被作用域 `catch` 恢复；结果用 `Result` 观察。
import Base.HostRow
import Base.EffExit
import Base.EffConsole
import Base.Eff
import Base.EffError
import Base.Result

prog : Eff [ErrorOp@e] Int
prog = throw@e "boom"

main : Eff hostRow Int
main = do
  _ <- consolePrint "error\n"
  r <- pure (runPure (runError "e" (catch "e" prog (\msg => pure 7))))
  case r of
    Ok a => do
      _ <- consolePrint ("ok " ++ strFromInt a ++ "\n")
      exitWith 0
    Err msg => do
      _ <- consolePrint ("caught " ++ msg ++ "\n")
      exitWith 0
