-- W10：fs 效应标签（命名实例 "default"，入口自动预装的真实 handler）——写/原子写/读/
-- 元数据/目录/删除。注：fs 步骤拆成两个行类型已钉死的 helper。单段 14 步 do 链会触发
-- D48 的指数级精化；拆分后语义/操作顺序不变。
import Base.Eff
import Base.EffFs
import Base.EffConsole
import Base.HostRow

dir : String
dir = "/tmp/vuna_w10_fs"

pathA : String
pathA = "/tmp/vuna_w10_fs/a.txt"

pathB : String
pathB = "/tmp/vuna_w10_fs/b.txt"

b2i : Bool -> Int
b2i b = if b then 1 else 0

prepare : Eff hostRow Int
prepare = do
  _ <- fsRemoveFile pathA
  _ <- fsRemoveFile pathB
  _ <- fsMakeDir dir
  written <- fsWriteFile pathA "hello"
  _ <- fsWriteFileAtomic pathB "yo"
  _ <- fsRemoveFile pathB
  pure written

inspectFs : Int -> Eff hostRow String
inspectFs written = do
  exists <- fsFileExists pathA
  content <- fsReadFile pathA
  size <- fsFileSize pathA
  isdir <- fsIsDirectory dir
  files <- fsReadDir dir
  _ <- fsRemoveFile pathA
  exists2 <- fsFileExists pathA
  pure
    (strFromInt written ++ ":" ++ content ++ ":" ++ strFromInt size ++ ":" ++ strFromInt (b2i isdir) ++ ":" ++ join "," files ++ ":" ++ strFromInt (b2i exists2))

prog : Eff hostRow String
prog = do
  written <- prepare
  result <- inspectFs written
  pure result

main : Eff hostRow Int
main = do
  summary <- prog
  _ <- consolePrint (summary ++ "\n")
  pure 0
