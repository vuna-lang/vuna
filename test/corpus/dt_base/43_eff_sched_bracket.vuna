-- W7：调度器取消时的 bracket cleanup。
-- 任务在挂起点（yield）收到取消状态 → use 正常返回 → 库层 bracket 在带内
-- pop + release（不是硬中止路径；硬中止只有尽力清理，见 effects-layers.md）。
import Base.Eff
import Base.EffSched
import Base.Host
import Base.Result

spin : List Int -> Eff [] Int
spin [] = pure 1
spin (_ :: rest) = do
  st <- yieldNow
  if st <= 0 then spin rest else pure 1

task : Eff [] Int
task =
  bracket (raise (println "acquire")) (\_ => raise (fmap natToInt (println "release")))
    (\_ => spin [0, 0, 0, 0, 0])

prog : Eff [] (Result Int)
prog = withScope (\sc => do
  w <- forkTask sc task
  _ <- yieldNow
  _ <- cancelScope sc
  _ <- scopeWait sc
  rw <- awaitTask w
  case rw of
    Ok n => pure (Ok n)
    Err _ => pure (Ok 3)
)

main : Eff [] Int
main = do
  r <- prog
  case r of
    Ok n => pure n
    Err _ => pure 0
