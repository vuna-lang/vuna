-- W9：任务句柄可复制；完成后重复 awaitTask 幂等（Ok 同值），
-- 对已完成任务 cancelTask 是 no-op（不算错误）。
import Base.Eff
import Base.EffSched
import Base.Result

sumThree : Result Int -> Result Int -> Result Int -> Result Int
sumThree (Ok a) (Ok b) (Ok c) = Ok (a + b + c)
sumThree _ _ _ = Ok 0

prog : Eff [] (Result Int)
prog = withScope (\sc => do
  ta <- forkTask sc (pure 11)
  r1 <- awaitTask ta
  r2 <- awaitTask ta
  _ <- cancelTask ta
  r3 <- awaitTask ta
  pure (sumThree r1 r2 r3)
)

main : Eff [] Int
main = do
  r <- prog
  case r of
    Ok n => pure n
    Err _ => pure 0
