-- W7：bracket 基础；use 抛 Exn 时 release 仍执行（经 State 观察）。
import Base.Eff
import Base.EffExn
import Base.EffState
import Base.Result
import Base.Pair

prog : Eff [Exn "main", State "counter" Int] Int
prog =
  bracketExn "main" (pure 0) (\_ => put "counter" Int 99)
    (\_ => do
      _ <- throwExn "main" "boom"
      pure 1
    )

ret : Base.Result.Result Int -> Int -> Pair (Base.Result.Result Int) Int
ret a s = Pair a s

opH : (o : StateOp Int) -> (Base.EffState.resState Int o -> Int -> Pair (Base.Result.Result Int) Int) -> Int -> Pair (Base.Result.Result Int) Int
opH op k s = case op of
  Get => k s s
  Put x => k 0 x

run : Pair (Base.Result.Result Int) Int
run = runPure (handleState "counter" Int ret opH (runExn "main" prog)) 3

main : Int
main = case run of
  Pair r s => s