-- bracket 基础；use 抛 Exn 时 release 仍执行（经 State 观察）。
import Base.Effect.Eff as Eff
import Base.Effect.EffExn as EffExn
import Base.Effect.EffState as EffState
import Base.Data.Result as Result
import Base.Data.Pair as Pair

prog : Eff [ExnOp@default, StateOp Int@counter] Int
prog = bracketExn "default" (pure 0) (\_ => put "counter" Int 99) (\_ => do
  _ <- throwExn "default" "boom"
  pure 1
)

ret : Result.Result Int -> Int -> Pair (Result.Result Int) Int
ret a s = Pair a s

opH : (i : Type) -> (o : StateOp Int i) -> (Eff.resIdx i o -> Int -> Pair (Result.Result Int) Int) -> Int -> Pair (Result.Result Int) Int
opH i op k s = case op of
  Get => k s s
  Put x => k 0 x

run : Pair (Result.Result Int) Int
run = runPure (handleState "counter" Int ret opH (runExn "default" prog)) 3

main : Int
main = case run of
  Pair r s => s
