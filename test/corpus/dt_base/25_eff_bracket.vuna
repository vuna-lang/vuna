-- W7：bracket 基础；use 抛 Exn 时 release 仍执行（经 State 观察）。
import Base.Eff
import Base.EffExn
import Base.EffState
import Base.Result
import Base.Pair

prog : Eff (Exn X1 :: State S1 Int :: []) Int
prog =
  bracketExn X1 (pureEff 0) (\_ => put S1 Int 99)
    (\_ => bindEff (throwExn X1 "boom") (\_ => pureEff 1))

ret : Base.Result.Result Int -> Int -> Pair (Base.Result.Result Int) Int
ret a s = Pair a s

opH : (o : StateOp Int) -> (Base.EffState.resState Int o -> Int -> Pair (Base.Result.Result Int) Int) -> Int -> Pair (Base.Result.Result Int) Int
opH op k s = case op of
  Get => k s s
  Put x => k 0 x

run : Pair (Base.Result.Result Int) Int
run = runPure (handleState S1 Int ret opH (runExn X1 prog)) 3

main : Int
main = case run of
  Pair r s => s
