-- D51：`Eff [] a` 传给要求非空行的位置时，check 方向自动用 `Base.Eff.weaken` 做行
-- lift（运行时恒等）；`let` 的签名绑定与函数实参两种形态都覆盖。期望是 `Eff []` 时
-- 不触发（那要报 TC_UnhandledEffects，见 dt_err/82）。
import Base.Eff

data Fetch : Type where

prog : Eff [] Int
prog = pure 21

use : Eff [Fetch] Int -> Int
use e = runEff e

runLet : Int
runLet =
  let
    w : Eff [Fetch] Int
    w = prog
  in runEff w

main : Int
main = use prog + runLet * 2