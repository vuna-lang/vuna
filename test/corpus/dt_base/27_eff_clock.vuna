-- W10：clock 效应标签（命名实例）——mock handler 固定时间（elapsed = 0）；
-- real handler 走 Base.IO.nowMicros / sleepMicros，同程序验证 sleep 确实推进时间。
import Base.Eff
import Base.EffClock
import Base.IO

prog : (n : Name) -> Eff (Clock n :: []) Int
prog n =
  bindEff (clockNow n)
    (\t0 => bindEff (clockSleepMicros n 2000) (\_ => bindEff (clockNow n) (\t1 => pureEff (t1 - t0))))

mret : Int -> Int
mret a = a

mopH : (o : ClockOp) -> (Base.EffClock.resClock o -> Int) -> Int
mopH op k = case op of
  Now => k 1000
  SleepMicros us => k 0

main : IO Int
main = case runPure (handleClock K1 mret mopH (prog K1)) of
  mockElapsed =>
    prim_bindIO (print ("mock " ++ strFromInt mockElapsed ++ "\n"))
      (\_ => prim_bindIO (runIOAnswer (handleClockIO K2 (prog K2))) (\realElapsed => prim_bindIO (print ("real " ++ strFromInt (if realElapsed >= 1000 then 1 else 0) ++ "\n")) (\_ => prim_pureIO 0)))
