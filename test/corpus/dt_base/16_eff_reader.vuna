-- Layer 1：运行时续延 + 行 + 命名实例（两个 Reader Int 实例，按实例名区分）。
import Base.Eff
import Base.Eff.Reader

prog : Eff [ReaderOp Int@counter, ReaderOp Int@config] Int
prog = do
  x <- ask "counter" Int
  y <- ask "config" Int
  pure (x * 10 + y)

op1 : (o : ReaderOp Int) -> (Base.Eff.Reader.resReader Int o -> Int) -> Int
op1 op k = case op of
  Ask => k 3

op2 : (o : ReaderOp Int) -> (Base.Eff.Reader.resReader Int o -> Int) -> Int
op2 op k = case op of
  Ask => k 4

main : Int
main =
  runPure (handleReader "counter" Int (\a => a) op1 (handleReader "config" Int (\a => a) op2 prog))
