-- W10 收尾：process 的 `Exit` 可控——mock handler（"mock"）与可选参数 handler
-- （"observed" 的 `handleProcessHostWith` 现成实例）都能观察退出码并继续执行；真实路径
-- （`handleProcessHost` 的 `@vuna@prim_eff_exit`）保留，但本夹具不触发它（否则测试进程退出）。
import Base.Eff
import Base.EffProcess
import Base.EffConsole
import Base.HostRow
import Base.List

prog : (n : String) -> Eff (Cons n ProcessOp Nil) Int
prog n = do
  c <- processExit n 7
  pure c

mret : Int -> Int
mret a = a

mopH : (o : ProcessOp) -> (Base.EffProcess.resProcess o -> Int) -> Int
mopH op k = case op of
  Args => k []
  Exit c => k c
  RunIn dir args => k 0

main : Eff hostRow Int
main = do
  _ <-
    consolePrint "default" ("mock " ++ strFromInt (runPure (handleProcess "mock" mret mopH (prog "mock"))) ++ "\n")
  observed <- raiseToRow hostRow (joinEff (handleProcessHostWith "observed" (\c => pure c) (prog "observed")))
  _ <- consolePrint "default" ("observed " ++ strFromInt observed ++ "\n")
  pure 0
