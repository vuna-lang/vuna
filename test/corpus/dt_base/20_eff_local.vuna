-- Layer 2：作用域 Reader（local）——先取外层 env，再在临时 handler 里用 f env 回答 Ask。
import Base.Eff
import Base.Eff.Reader

prog : Eff [Reader "counter" Int] Int
prog = do
  x <- ask "counter" Int
  y <- local "counter" Int (\v => v + 10) (ask "counter" Int)
  z <- ask "counter" Int
  pure (x * 100 + y * 10 + z)

opH : (o : ReaderOp Int) -> (Base.Eff.Reader.resReader Int o -> Int) -> Int
opH op k = case op of
  Ask => k 7

main : Int
main = runPure (handleReader "counter" Int (\a => a) opH prog)