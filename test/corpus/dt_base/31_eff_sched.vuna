-- W9：单线程协作式 fiber 调度器（Layer 3）。
-- fork/await 顺序：fork 只入队；父纤程 yield/await 时子任务才跑，轮转顺序确定。
-- 结构化作用域：withScope 在 body 结束后等所有子任务结束，Ok 带回完成数汇总。
import Base.Eff
import Base.EffSched
import Base.Result

work : String -> String -> Int -> Eff [] Int
work first second n = do
  _ <- raise (prim_eff_print (first ++ "\n"))
  _ <- yieldNow
  _ <- raise (prim_eff_print (second ++ "\n"))
  pure n

prog : Eff [] (Result Int)
prog = withScope (\sc => do
  ta <- forkTask sc (work "a1" "a2" 10)
  tb <- forkTask sc (work "b1" "b2" 20)
  _ <- raise (prim_eff_print ("forked" ++ "\n"))
  rb <- awaitTask tb
  case rb of
    Ok b => do
      ra <- awaitTask ta
      case ra of
        Ok a => pure (Ok (a + b))
        Err e => pure (Err e)
    Err e => pure (Err e)
)

main : Eff [] Int
main = do
  r <- prog
  case r of
    Ok n => pure n
    Err _ => pure 0
