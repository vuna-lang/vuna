-- W9：取消清理——挂起的任务在挂起点收到取消状态（yield 返回 1），
-- 跑完自己的清理代码后返回；scopeWait 只等「全部结束」（取消不算 scope 错误），
-- 取消结果由 awaitTask 的 Err "cancelled" 观察。
import Base.Eff
import Base.EffSched
import Base.IO
import Base.Result

spin : List Int -> Eff [] Int
spin [] = pure 1
spin (_ :: rest) = do
  st <- yieldNow
  if st <= 0 then spin rest else do
    _ <- liftIOEff (println "cleanup")
    pure 2

prog : Eff [] (Result Int)
prog = withScope (\sc => do
  w <- forkTask sc (spin [0, 0, 0, 0, 0, 0])
  _ <- yieldNow
  _ <- liftIOEff (println "cancel")
  _ <- cancelScope sc
  _ <- scopeWait sc
  rw <- awaitTask w
  case rw of
    Ok _ => pure (Ok 1)
    Err _ => pure (Ok 3)
)

main : IO Int
main = do
  r <- runIOEff prog
  case r of
    Ok n => pure n
    Err _ => pure 0