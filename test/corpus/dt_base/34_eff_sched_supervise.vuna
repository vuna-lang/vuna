-- W9：结构化监督——子任务失败时同范围其余任务被取消（在挂起点清理），
-- 失败消息经 awaitTask 的 Err 返回；body 返回 Err 后 withScope 先取消再等干净。
import Base.Eff
import Base.EffSched
import Base.Result

bad : Eff [] Int
bad = do
  _ <- yieldNow
  sendCore Int "boom" "default" 0

work : List Int -> Eff [] Int
work [] = pure 0
work (_ :: rest) = do
  _ <- raise (prim_eff_print ("tick" ++ "\n"))
  st <- yieldNow
  if st <= 0 then work rest
  else do
    _ <- raise (prim_eff_print ("sibling-cleanup" ++ "\n"))
    pure 9

prog : Eff [] (Result Int)
prog = withScope (\sc => do
  tb <- forkTask sc bad
  tg <- forkTask sc (work [0, 0, 0])
  _ <- yieldNow
  rb <- awaitTask tb
  case rb of
    Ok _ => pure (Ok 0)
    Err e => do
      _ <- raise (prim_eff_print (e ++ "\n"))
      _ <- scopeWait sc
      rw <- awaitTask tg
      case rw of
        Ok _ => pure (Err e)
        Err e2 => do
          _ <- raise (prim_eff_print (e2 ++ "\n"))
          pure (Err e)
)

main : Eff [] Int
main = do
  r <- prog
  case r of
    Ok n => pure n
    Err _ => pure 2
