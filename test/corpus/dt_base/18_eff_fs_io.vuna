-- Layer 1：宿主-backed Fs 效应（handler 直调 @vuna@prim_eff_* 原语；answer = `Eff [] Int`）。
-- W10 收尾：`Fs` 是命名实例，操作与 handler 显式带实例名（本夹具用 "real"）。
import Base.HostRow
import Base.Eff
import Base.EffFs
import Base.Nat

prog : Eff [FsOp@real] Int
prog = do
  _ <- fsWriteFile@real "/tmp/vuna_eff_fs.txt" "hello"
  s <- fsReadFile@real "/tmp/vuna_eff_fs.txt"
  pure (toInt (byteLength s))

ret : Int -> Eff hostRow Int
ret a = pure a

opH : (o : FsOp) -> (Base.EffFs.resFs o -> Eff hostRow Int) -> Eff hostRow Int
opH op k = case op of
  ReadFile p => do
    s <- fsReadFile p
    k s
  WriteFile p s => do
    n <- fsWriteFile p s
    k n
  _ => prim_fail "unexpected fs op in 18_eff_fs_io"

main : Eff hostRow Int
main = joinEff (handleFs "real" ret opH prog)
