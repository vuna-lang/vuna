-- 参数化 op 族（State 的 k = 1）。op 族
-- `StateOp : Type -> Type -> Type`、标签 `StateOp s`、结果索引由构造子给出；handle 按族参数补洞，
-- 续延在 `Get` 分支拿到索引 `s`。
import Base.Effect.Eff as Eff
import Base.Effect.EffState as EffState
import Base.Data.List as List
import Base.Trait.Monad as Monad
import Base.Data.Nat as Nat

oneN : Nat
oneN = 1

getN : Eff [StateOp Nat@counter] Nat
getN = perform Get

putOne : Eff [StateOp Nat@counter] Int
putOne = perform Put oneN

prog : Eff [StateOp Nat@counter] Nat
prog = do
  n <- getN
  _ <- putOne
  pure n

run : {r : Row} -> Eff (Named "counter" (StateOp Nat) :: r) Nat -> Eff r Nat
run comp = handle comp {
  Get k -> k 5
  Put x k -> k 6
}

main : Nat
main = runPure (run prog)
