-- W9 Mutex：两个 fork 的任务在锁下各 +1；单线程协作式 mutex。
import Base.Eff
import Base.EffMutex
import Base.EffSched
import Base.IO
import Base.IORef
import Base.Result

inc : Mutex -> IORef Int -> Eff [] Int
inc m ctr = do
  r <- acquire m
  case r of
    Ok _ => do
      v <- liftIOEff (readRef ctr)
      _ <- liftIOEff (writeRef ctr (v + 1))
      release m
    Err _ => pure 0

prog : Eff [] (Result Int)
prog =
  withScope
    (\sc => do
      m <- newMutex
      ctr <- liftIOEff (newRef 0)
      _ <- forkTask sc (inc m ctr)
      _ <- forkTask sc (inc m ctr)
      _ <- scopeWait sc
      n <- liftIOEff (readRef ctr)
      pure (Ok n)
    )

main : IO Int
main = do
  r <- runIOEff prog
  case r of
    Ok n => pure n
    Err _ => pure 0
