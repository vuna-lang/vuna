-- `perform <op>` 语法。key 取 op 族规范名，实例名由行解出
-- （`[ConsoleOp@audit]` → 名字 "audit"），结果类型走上下文。
-- handler 侧也按同一 key 取名；base 的 wrapper 仍手写 "console"，两边 key 不配对
-- （见 debt D57）。
import Base.Eff
import Base.EffConsole
import Base.List
import Base.Monad
import Base.Nat

mockOpH : {a : Type} -> (i : Type) -> (o : ConsoleOp i) -> (Base.Eff.resIdx i o -> a) -> a
mockOpH i op k = case op of
  Print s => k 5
  EPrint s => k 0

prog : Eff [ConsoleOp@audit] Nat
prog = do
  n <- perform Print "hello"
  pure n

runAudit : {a : Type} -> Eff [ConsoleOp@audit] a -> a
runAudit comp =
  runPure
    (handleCore (Named "audit" ConsoleOp) "Base.EffConsole.ConsoleOp" "audit" (\x => x) mockOpH comp)

main : Nat
main = runAudit prog
