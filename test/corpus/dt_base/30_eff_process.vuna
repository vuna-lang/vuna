-- W10：process 效应标签（命名实例）——mock handler 给固定 args/退出码；
-- real 路径走入口自动预装的行 handler（含 argv 与 runIn 的退出码 0）。
import Base.Eff
import Base.EffProcess
import Base.EffConsole
import Base.HostRow
import Base.List

prog : (n : String) -> Eff (Cons n ProcessOp Nil) String
prog n = do
  args <- processArgs@(n)
  code <- processRunIn@(n) "." ("true" :: [])
  pure (join "," args ++ "|" ++ strFromInt code)

progReal : Eff hostRow String
progReal = do
  args <- processArgs
  code <- processRunIn "." ("true" :: [])
  pure (join "," args ++ "|" ++ strFromInt code)

mret : String -> String
mret a = a

mopH : (o : ProcessOp) -> (Base.EffProcess.resProcess o -> String) -> String
mopH op k = case op of
  Args => k ("a" :: "b" :: [])
  Exit c => k c
  RunIn dir args => k 3

main : Eff hostRow Int
main = case runPure (handleProcess "mock" mret mopH (prog "mock")) of
  mockLog => do
    _ <- consolePrint ("mock " ++ mockLog ++ "\n")
    realLog <- progReal
    _ <- consolePrint ("real " ++ realLog ++ "\n")
    pure 0
