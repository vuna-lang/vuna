-- W9 effect-aware fork：显式 handler 把 Reader task 收成 Nil 后 fork；任务局部 env=7。
import Base.Eff
import Base.Eff.Reader
import Base.EffSched
import Base.Result

opH : (o : ReaderOp Int) -> (Base.Eff.Reader.resReader Int o -> Int) -> Int
opH op k = case op of
  Ask => k 7

handled : Eff [ReaderOp Int@task] Int -> Eff [] Int
handled comp = handleReader "task" Int (\a => a) opH comp

prog : Eff [] (Result Int)
prog = withScope (\sc => do
  t <- forkTaskWith sc handled (ask "task" Int)
  awaitTask t
)

main : Eff [] Int
main = do
  r <- prog
  case r of
    Ok n => pure n
    Err _ => pure 0
