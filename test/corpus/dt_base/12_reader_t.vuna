-- Reader 效应栈（`Base.Eff.Reader`）。
-- `ask` 读环境，`local` 在临时 handler 里改写；handler 的 answer 用 Int。
import Base.Effect.EffExit as EffExit
import Base.Effect.EffConsole as EffConsole
import Base.Effect.Eff as Eff
import Base.Effect.EffReader as EffReader

prog : Eff [ReaderOp Int@counter] Int
prog = do
  e <- ask "counter" Int
  pure (e + 1)

opH : (i : Type) -> (o : ReaderOp Int i) -> (Eff.resIdx i o -> Int) -> Int
opH i op k = case op of
  Ask => k 41

main : Eff [ConsoleOp, ExitOp] Int
main = do
  _ <- consolePrint "reader\n"
  a <- pure (runPure (handleReader "counter" Int (\x => x) opH prog))
  b <-
    pure
      (runPure (handleReader "counter" Int (\x => x) opH (local "counter" Int (\x => x + 1) (ask "counter" Int))))
  _ <- consolePrint ("a=" ++ strFromInt a ++ ",b=" ++ strFromInt b ++ "\n")
  exitWith 0
