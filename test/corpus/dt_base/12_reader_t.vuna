-- M37：ReaderT 效应栈（IO 之上）。`ask` 读环境，`local` 局部改写；
-- `runReaderT` 返回 IO 动作，由 main 执行。
import Base.Effect
import Base.IO
import Base.ReaderT

prog : ReaderT Int Int
prog = do
  e <- ask
  liftIO (print "reader\n")
  pure (e + 1)

main : IO Int
main = do
  a <- runReaderT prog 41
  b <- runReaderT (local (\x => x + 1) ask) 41
  print ("a=" ++ strFromInt a ++ ",b=" ++ strFromInt b ++ "\n")
  exit 0
