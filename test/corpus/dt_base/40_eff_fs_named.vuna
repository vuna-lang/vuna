-- fs 命名实例（"mock" / 入口行 handler）——同一程序在 mock（纯 answer）与
-- 真实（入口自动预装）下各跑一次；证明 mock/real handler 可以在同一程序里并存。
-- mock 的 WriteFile/ReadFile 是固定答案（与 clock/env mock 同一风格）。
import Base.Eff
import Base.Nat
import Base.Maybe
import Base.EffFs
import Base.EffConsole
import Base.List

dir : String
dir = "/tmp/vuna_w10_fs_named"

path : String
path = "/tmp/vuna_w10_fs_named/a.txt"

b2i : Bool -> Int
b2i b = if b then 1 else 0

prog : (n : String) -> Eff (Named n FsOp :: []) String
prog n = do
  _ <- fsMakeDir@(n) dir
  _ <- fsRemoveFile@(n) path
  w <- fsWriteFile@(n) path "hello"
  s <- fsReadFile@(n) path
  e <- fsFileExists@(n) path
  sz <- fmap (\o => natToInt (fromMaybe Zero o)) (fsFileSize@(n) path)
  _ <- fsRemoveFile@(n) path
  pure (join "," (strFromInt w :: s :: strFromInt (b2i e) :: strFromInt sz :: []))

progReal : Eff [FsOp, ConsoleOp] String
progReal = do
  _ <- fsMakeDir dir
  _ <- fsRemoveFile path
  w <- fsWriteFile path "hello"
  s <- fsReadFile path
  e <- fsFileExists path
  sz <- fmap (\o => natToInt (fromMaybe Zero o)) (fsFileSize path)
  _ <- fsRemoveFile path
  pure (join "," (strFromInt w :: s :: strFromInt (b2i e) :: strFromInt sz :: []))

mret : String -> String
mret a = a

mopH : (i : Type) -> (o : FsOp i) -> (Base.Eff.resIdx i o -> String) -> String
mopH i op k = case op of
  ReadFile p => k "M"
  WriteFile p s => k 5
  WriteFileAtomic p s => k 5
  ReadDir p => k []
  IsDirectory p => k True
  MakeDir p => k 0
  RemoveFile p => k 0
  FileExists p => k True
  FileMtime p => k (Just 0)
  FileSize p => k (Just 42)
  RemoveTree p => k 0
  Rename s d => k 0
  Symlink t l => k 0
  MakeDirExclusive p => k True

main : Eff [FsOp, ConsoleOp] Int
main = do
  _ <- consolePrint ("mock " ++ runPure (handleFs "mock" mret mopH (prog "mock")) ++ "\n")
  real <- progReal
  _ <- consolePrint ("real " ++ real ++ "\n")
  pure 0
