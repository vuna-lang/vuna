-- W10 收尾：fs 命名实例（"mock" / 入口行 handler）——同一程序在 mock（纯 answer）与
-- 真实（入口自动预装）下各跑一次；证明 mock/real handler 可以在同一程序里并存。
-- mock 的 WriteFile/ReadFile 是固定答案（与 clock/env mock 同一风格）。
import Base.Eff
import Base.EffFs
import Base.EffConsole
import Base.HostRow
import Base.List

dir : String
dir = "/tmp/vuna_w10_fs_named"

path : String
path = "/tmp/vuna_w10_fs_named/a.txt"

b2i : Bool -> Int
b2i b = if b then 1 else 0

prog : (n : String) -> Eff (Cons n FsOp Nil) String
prog n = do
  _ <- fsMakeDir@(n) dir
  _ <- fsRemoveFile@(n) path
  w <- fsWriteFile@(n) path "hello"
  s <- fsReadFile@(n) path
  e <- fsFileExists@(n) path
  sz <- fsFileSize@(n) path
  _ <- fsRemoveFile@(n) path
  pure (join "," (strFromInt w :: s :: strFromInt (b2i e) :: strFromInt sz :: []))

progReal : Eff hostRow String
progReal = do
  _ <- fsMakeDir dir
  _ <- fsRemoveFile path
  w <- fsWriteFile path "hello"
  s <- fsReadFile path
  e <- fsFileExists path
  sz <- fsFileSize path
  _ <- fsRemoveFile path
  pure (join "," (strFromInt w :: s :: strFromInt (b2i e) :: strFromInt sz :: []))

mret : String -> String
mret a = a

mopH : (o : FsOp) -> (Base.EffFs.resFs o -> String) -> String
mopH op k = case op of
  ReadFile p => k "M"
  WriteFile p s => k 5
  WriteFileAtomic p s => k 5
  ReadDir p => k []
  IsDirectory p => k True
  MakeDir p => k 0
  RemoveFile p => k 0
  FileExists p => k True
  FileMtime p => k 0
  FileSize p => k 42

main : Eff hostRow Int
main = do
  _ <- consolePrint ("mock " ++ runPure (handleFs "mock" mret mopH (prog "mock")) ++ "\n")
  real <- progReal
  _ <- consolePrint ("real " ++ real ++ "\n")
  pure 0
