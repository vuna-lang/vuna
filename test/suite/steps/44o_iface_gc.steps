# 44o) 镜像模式内容寻址 + 孤儿 GC：文件名含接口哈希（`Dep-<token>.iface`）；实现变化
#      产生新 token 文件，旧 token 在 60s 窗口外由写侧孤儿 GC 清理（只剩 1 个）。
#      夹具 corpus/packages/m34_iface_audit 复制到 $TMPDIR，vuna.toml 的 base 改到本仓库。
run: sh -c 'rm -rf "$TMPDIR/iface-audit-pkg" "$TMPDIR/iface-audit-cache"; cp -R corpus/packages/m34_iface_audit "$TMPDIR/iface-audit-pkg"; mkdir -p "$TMPDIR/iface-audit-cache"'
run: sh -c 'for mf in "$TMPDIR/iface-audit-pkg"/*/vuna.toml; do sed "s|vuna-base = \"[^\"]*\"|vuna-base = \"$VUNA_BASE\"|" "$mf" > "$mf.tmp" && mv "$mf.tmp" "$mf"; done'
run: sh -c 'TMPDIR="$TMPDIR/iface-audit-cache" "$VUNA" check "$TMPDIR/iface-audit-pkg/dep"'
# 内容寻址文件名。
run: sh -c 'm="$VUNA_IFACE_DIR$(cd "$TMPDIR/iface-audit-pkg/dep" && pwd)"; find "$m" -name "Dep-*.iface" | grep -q .'
# 把现有 token 文件时间调到 60s 窗口外（孤儿 GC 只删 mtime 超 60s 的未引用文件）。
run: sh -c 'm="$VUNA_IFACE_DIR$(cd "$TMPDIR/iface-audit-pkg/dep" && pwd)"; find "$m" -name "*.iface" -exec touch -d "2020-01-01 00:00:00" {} + 2>/dev/null || true'
# 改实现体（同导出面）：产生新 token，旧 token 变孤儿。
run: sh -c 'printf "%s\n" "module Dep (foo, bar) where" "" "foo : Int" "foo = 2" "" "bar : Int" "bar = 2" > "$TMPDIR/iface-audit-pkg/dep/lib/Dep.vuna"'
run: sh -c 'find "$TMPDIR/iface-audit-cache"/vuna-cache -name query -type d -prune -exec rm -rf {} + 2>/dev/null || true'
run: sh -c 'TMPDIR="$TMPDIR/iface-audit-cache" "$VUNA" check "$TMPDIR/iface-audit-pkg/dep"'
run: sh -c 'm="$VUNA_IFACE_DIR$(cd "$TMPDIR/iface-audit-pkg/dep" && pwd)"; [ "$(find "$m" -name "Dep-*.iface" | wc -l)" -eq 1 ]'