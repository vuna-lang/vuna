# 44o) 对象库不落树内文件：接口只写 `$VUNA_STORE/objects/`，包目录里不再出现
#      `.output/iface` / `*.iface` / `.vuna-iface`（镜像、孤儿 GC、只读降级随之消失）。
run: sh -c 'rm -rf "$TMPDIR/44o-pkg" "$TMPDIR/44o-store" "$TMPDIR/44o-cache"; cp -R corpus/packages/m34_iface_audit "$TMPDIR/44o-pkg"'
run: sh -c 'for mf in "$TMPDIR/44o-pkg"/*/vuna.toml; do sed "s|vuna-base = \"[^\"]*\"|vuna-base = \"$VUNA_BASE\"|" "$mf" > "$mf.tmp" && mv "$mf.tmp" "$mf"; done'
run: sh -c 'VUNA_STORE="$TMPDIR/44o-store" TMPDIR="$TMPDIR/44o-cache" "$VUNA" check "$TMPDIR/44o-pkg/dep"'
exit: 0
run: sh -c 'find "$TMPDIR/44o-pkg" -name "*.iface" -o -name ".vuna-iface" | wc -l | tr -d " "'
out-equals: 0
run: sh -c 'test ! -d "$TMPDIR/44o-pkg/dep/.output/iface"; echo ok'
out-equals: ok
run: sh -c 'test -d "$TMPDIR/44o-store/objects/iface" && test -d "$TMPDIR/44o-store/objects/header"'
exit: 0
