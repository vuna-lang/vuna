# 44e) 仓库自身：预热 base/compiler 接口后，根包 `check .` 走摘要路径且通过
#      （C37 的 Eq Type 假歧义 / Interp.vuna:71 回归）。cwd = test/，所以先 cd 到仓库根。
run: sh -c 'mkdir -p "$TMPDIR/summary-repo-cache"'
run: sh -c 'cd .. && TMPDIR="$TMPDIR/summary-repo-cache" "$VUNA" check base >/dev/null 2>&1 && TMPDIR="$TMPDIR/summary-repo-cache" "$VUNA" check compiler >/dev/null 2>&1'
exit: 0
run: sh -c 'cd .. && TMPDIR="$TMPDIR/summary-repo-cache" "$VUNA" check . --debug-perf'
exit: 0
out-contains: cache-path=summary deps=2