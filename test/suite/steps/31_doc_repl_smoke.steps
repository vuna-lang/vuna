# 31) doc / repl 冒烟：doc 产出 HTML 含 Vuna.Hello；repl 顶层定义 + 裸表达式可求值。
run: VUNA_STORE="$TMPDIR/doc-store" "$VUNA" doc corpus/packages/01_workspace "$TMPDIR/api.html"
exit: 0
run: grep -q Vuna.Hello "$TMPDIR/api.html"
exit: 0
# 第二次同一输入走对象库（tool 载荷）：命中且 HTML 逐字节一致。
run: sh -c 'VUNA_STORE="$TMPDIR/doc-store" VUNA_DEBUG_PERF=1 "$VUNA" doc corpus/packages/01_workspace "$TMPDIR/api2.html" 2>&1'
exit: 0
out-contains: doc-cache=hit
run: cmp "$TMPDIR/api.html" "$TMPDIR/api2.html"
exit: 0
run: sh corpus/doc/check.sh "$VUNA"
exit: 0
run: printf 'x : Int\nx = 1 + 1\nx + 40\n:q\n' | "$VUNA" repl 2>&1
exit: 0
out-contains: 42
run: printf ':q\n' | "$VUNA" repl
exit: 0
