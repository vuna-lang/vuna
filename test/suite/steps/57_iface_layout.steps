# 57) iface 布局（S8）：默认写在**构建产物目录** `<包目录>/.output/iface/<编译器指纹>/`
#     （与 `.ml`/`.cmx` 同处，按指纹分桶避免 seed / 产品二进制 / 本地构建互相失效）；
#     `VUNA_IFACE_DIR` 覆盖时镜像到外部根，读侧两种布局都能消费。
# 注意：变量赋值不要写成 `TMPDIR=... VUNA_IFACE_DIR="$TMPDIR/..."`（dash 按顺序展开，
# 后面的赋值会读到新 TMPDIR）；统一先算好 cache/root 变量再传给命令。
# 57a) 默认布局：复制 base 到 $TMPDIR 后 unset VUNA_IFACE_DIR 检查。
run: cp -R "$VUNA_BASE" "$TMPDIR/iface-beside"
exit: 0
run: unset VUNA_IFACE_DIR; TMPDIR="$TMPDIR/iface-beside-cache" "$VUNA" check "$TMPDIR/iface-beside" 2>&1
exit: 0
run: find "$TMPDIR/iface-beside/.output/iface" -name Int.iface 2>/dev/null | sed -n '1p'
out-contains: Int.iface
run: find "$TMPDIR/iface-beside/.output/iface" -name '.vuna-iface' 2>/dev/null | sed -n '1p'
out-contains: .vuna-iface
run: rm -rf "$TMPDIR/iface-beside-cache"/vuna-cache/query
exit: 0
run: unset VUNA_IFACE_DIR; TMPDIR="$TMPDIR/iface-beside-cache" VUNA_IFACE_SELFTEST=1 "$VUNA" check "$TMPDIR/iface-beside" --debug-perf 2>&1
exit: 0
out-contains: iface-write=0/
out-contains: iface-selftest=ok
# 57b) 覆盖模式：镜像布局；依赖包接口按包目录（不是包名哈希）定位，根包走摘要路径。
run: cache="$TMPDIR/iface-mirror-cache"; mirror="$TMPDIR/iface-mirror-root"; mkdir -p "$mirror"; TMPDIR="$cache" VUNA_IFACE_DIR="$mirror" "$VUNA" check "$VUNA_BASE" 2>&1
exit: 0
run: cache="$TMPDIR/iface-mirror-cache"; mirror="$TMPDIR/iface-mirror-root"; pkg="$(cd corpus/packages/m34_summary && pwd)"; TMPDIR="$cache" VUNA_IFACE_DIR="$mirror" "$VUNA" check "$pkg/dep" 2>&1
exit: 0
run: b="$TMPDIR/iface-mirror-root$(cd "$VUNA_BASE" && pwd)"; find "$b/lib/Base" -name 'Int-*.iface' 2>/dev/null | sed -n '1p'
out-contains: Int-
run: b="$TMPDIR/iface-mirror-root$(cd "$VUNA_BASE" && pwd)"; test -f "$b/.vuna-iface"
exit: 0
run: cache="$TMPDIR/iface-mirror-cache"; mirror="$TMPDIR/iface-mirror-root"; pkg="$(cd corpus/packages/m34_summary && pwd)"; TMPDIR="$cache" VUNA_IFACE_DIR="$mirror" "$VUNA" check "$pkg/root" --debug-perf 2>&1
exit: 0
out-contains: cache-path=summary deps=2
# 57c) 入口写法归一：`check base` / `check ./base` / `check <绝对路径>` 命中同一镜像目录。
run: cache="$TMPDIR/iface-enum-cache"; root="$TMPDIR/iface-enum-root"; cd .. && TMPDIR="$cache" VUNA_IFACE_DIR="$root" "$VUNA" check base >/dev/null 2>&1 && TMPDIR="$cache" VUNA_IFACE_DIR="$root" "$VUNA" check ./base >/dev/null 2>&1
exit: 0
run: find "$TMPDIR/iface-enum-root" -name '.vuna-iface' | wc -l | tr -d ' '
out-equals: 1
run: rm -rf "$TMPDIR/iface-enum-cache"/vuna-cache/query
exit: 0
run: cache="$TMPDIR/iface-enum-cache"; root="$TMPDIR/iface-enum-root"; TMPDIR="$cache" VUNA_IFACE_DIR="$root" "$VUNA" check "$VUNA_BASE" --debug-perf 2>&1
exit: 0
out-contains: iface-write=0/
# 57d) 同名不同目录：同一镜像根下各占一棵树，不互相覆盖（旧实现按包名哈希会互踩）。
run: a="$TMPDIR/iface-same-a"; b="$TMPDIR/iface-same-b"; mkdir -p "$a/lib" "$b/lib"; printf '[package]\nname = "iface-same"\n\n[export]\nmodules = ["SA"]\n' >"$a/vuna.toml"; printf '[package]\nname = "iface-same"\n\n[export]\nmodules = ["SB"]\n' >"$b/vuna.toml"; printf 'module SA where\n\nexport saVal : Int\nsaVal = 1\n' >"$a/lib/SA.vuna"; printf 'module SB where\n\nexport sbVal : Int\nsbVal = 2\n' >"$b/lib/SB.vuna"
exit: 0
run: cache="$TMPDIR/iface-same-cache"; root="$TMPDIR/iface-same-root"; TMPDIR="$cache" VUNA_IFACE_DIR="$root" "$VUNA" check "$TMPDIR/iface-same-a" 2>&1
exit: 0
run: cache="$TMPDIR/iface-same-cache"; root="$TMPDIR/iface-same-root"; TMPDIR="$cache" VUNA_IFACE_DIR="$root" "$VUNA" check "$TMPDIR/iface-same-b" 2>&1
exit: 0
file-exists: $TMPDIR/iface-same-root$TMPDIR/iface-same-a/.vuna-iface
file-exists: $TMPDIR/iface-same-root$TMPDIR/iface-same-b/.vuna-iface