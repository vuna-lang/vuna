import Base.Eff

data AOp : Type where
  A : Int -> AOp

resA : AOp -> Type
resA (A n) = Int

data BOp : Type where
  B : Int -> BOp

resB : BOp -> Type
resB (B n) = Int

prog : Eff (Named "a" AOp :: [BOp@b]) Int
prog = do
  x <- perform A 1
  y <- perform B 2
  pure (x + y)

inner : Eff (Named "a" AOp :: [BOp@b]) Int -> Eff [BOp@b] Int
inner comp = handle comp {
  A n k -> k (n + 10)
}

main : Int
main = runPure (handle (inner prog) {
  B n k -> k (n * 100)
}
)
