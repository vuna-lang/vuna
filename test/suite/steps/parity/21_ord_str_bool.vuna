import Base.Bool
import Base.Int
import Base.List
import Base.Ord
import Base.Sort
import Base.String

flag : Bool -> String
flag b = if b then "1" else "0"

sorted : List String
sorted = sortBy (\a, b => a <= b) ["b", "a", "c"]

joined : List String -> String
joined xs = case xs of
  a :: b :: c :: _ => a ++ b ++ c
  _ => ""

main : String
main =
  flag ("abc" < "abd")
  ++ flag ("abc" < "ab")
  ++ flag ("ab" < "abc")
  ++ flag ("b" < "a")
  ++ flag ("a" <= "a")
  ++ flag ("abc" > "abd")
  ++ flag (True > False)
  ++ flag (False >= True)
  ++ flag (True <= False)
  ++ (case compare "b" "a" of
        LT => "L"
        EQ => "E"
        GT => "G")
  ++ joined sorted
