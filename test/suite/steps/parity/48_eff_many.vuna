import Base.Eff
import Base.Nat

data POp : Type where
  P : Int -> POp

resP : POp -> Type
resP (P n) = Int

many : Nat -> Eff [POp] Int
many n = case n of
  Zero => pure 0
  Succ m => do
    x <- perform (P 1)
    y <- many m
    pure (x + y)

main : Int
main = runPure (handle (many (natFromInt 200)) { P n k -> k n })
