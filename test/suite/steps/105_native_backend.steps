# 105) native 后端机制：x86-64 汇编 -> 静态可执行、产物形状、确定性、trap、ABI 与拒绝面。
#
# 共享语义（算术 / 字符串 / data / record / List 桥接 / 闭包 / 高阶 API）由
# `109_backend_parity.steps` 对拍三端；这里只保留 native 特有的机制性用例。
# 依赖 PATH 里的 cc（devShell / e2e 的 ocamlTools）。

# 0) 工具链探针：缺 cc 时给出明确失败，而不是让后续链接报 127。
run: command -v cc
exit: 0

# 1) 最小可执行：产物形状（main.s / build.sh / 可链接二进制）与入口打印。
run: sh -c 'd="$TMPDIR/min"; mkdir -p "$d/app"; printf "[package]\nname = \"min\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = 42\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/min-out" "$d"'
exit: 0
file-exists: $TMPDIR/min-out/main.s
file-exists: $TMPDIR/min-out/build.sh
file-contains: $TMPDIR/min-out/main.s .intel_syntax noprefix
file-contains: $TMPDIR/min-out/main.s .globl _start
file-contains: $TMPDIR/min-out/main.s .section .bss
run: "$TMPDIR/min-out/bin/min" 2>&1
exit: 0
out-equals: 42

# 2) 多个函数各自的内部 label 不得撞名（label 编号跨定义累加）。
run: sh -c 'd="$TMPDIR/labels"; mkdir -p "$d/app"; printf "[package]\nname = \"labels\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "f : Int -> Int\nf x = if x > 0 then 1 else 0\n\ng : Int -> Int\ng x = if x > 5 then 2 else 0\n\nmain : Int\nmain = f 1 + g 6\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/labels-out" "$d"'
exit: 0
run: "$TMPDIR/labels-out/bin/labels" 2>&1
out-equals: 3

# 3) 除零：编译通过，运行 exit 2 并输出运行时错误前缀。
run: sh -c 'd="$TMPDIR/dz"; mkdir -p "$d/app"; printf "[package]\nname = \"dz\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = 1 / 0\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/dz-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/dz-out/bin/dz" 2>&1'
exit: 2
out-contains: vuna: runtime error: division by zero

# 4) 确定性：同一程序两次 compile 的 main.s 逐字节一致（含字符串字面量池）。
run: sh -c 'd="$TMPDIR/det"; mkdir -p "$d/app"; printf "[package]\nname = \"det\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : String\nmain = \"a\" ++ strFromInt 42 ++ \"b\"\n" > "$d/app/Main.vuna"; "$VUNA" compile "$d/app/Main.vuna" "$TMPDIR/det-a" --target native; "$VUNA" compile "$d/app/Main.vuna" "$TMPDIR/det-b" --target native; cmp "$TMPDIR/det-a/main.s" "$TMPDIR/det-b/main.s"'
exit: 0

# 5) 可增长 arena：超过初始 1 MiB 时 mmap 新段，不再 OOM。
run: sh -c 'd="$TMPDIR/oom"; mkdir -p "$d/app"; printf "[package]\nname = \"oom\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Nat\n\nrep : Nat -> String -> String\nrep n s = case n of\n  Zero => \"\"\n  Succ k => s ++ rep k s\n\nmain : Int\nmain = strLength (rep (natFromInt 5000) \"0123456789abcdef\")\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/oom-out" "$d"'
exit: 0
run: "$TMPDIR/oom-out/bin/oom" 2>&1
out-equals: 80000

# 6) 运行时错误文本：assert / prim_fail / todo 统一走报告器格式（stderr + exit 2）。
run: sh -c 'd="$TMPDIR/traps"; mkdir -p "$d/app"; printf "[package]\nname = \"traps\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = assert False \"bad\" 9\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/traps-as" "$d"'
exit: 0
run: sh -c '"$TMPDIR/traps-as/bin/traps" 2>&1'
exit: 2
out-equals: vuna: runtime error: assertion failed: bad
run: sh -c 'printf "main : Int\nmain = prim_fail \"boom\"\n" > "$TMPDIR/traps/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/traps-pf" "$TMPDIR/traps"'
exit: 0
run: sh -c '"$TMPDIR/traps-pf/bin/traps" 2>&1'
exit: 2
out-equals: vuna: runtime error: boom
run: sh -c 'printf "main : Int\nmain = todo \"later\"\n" > "$TMPDIR/traps/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/traps-todo" "$TMPDIR/traps"'
exit: 0
run: sh -c '"$TMPDIR/traps-todo/bin/traps" 2>&1'
exit: 2
out-equals: vuna: runtime error: TODO: later

# 7) 数组越界：trap 文本与 OCaml 报告器首行一致（native 没有位置行），exit 2。
run: sh -c 'd="$TMPDIR/arr"; mkdir -p "$d/app"; printf "[package]\nname = \"arr\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Array\n\nmain : Int\nmain = arrayGet (fromList [1, 2]) 5\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/arr-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/arr-out/bin/arr" 2>&1'
exit: 2
out-equals: vuna: runtime error: Invalid_argument("index out of bounds")

# 7) dbg! 的运行时原语：关闭时返回 43 且不求值。
run: sh -c 'd="$TMPDIR/dbg"; mkdir -p "$d/app"; printf "[package]\nname = \"dbg\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = let _ = dbg! \"x\" in 43\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/dbg-out" "$d"'
exit: 0
run: "$TMPDIR/dbg-out/bin/dbg" 2>&1
out-equals: 43

# 8) 栈传参（arity > 6）：前 6 个走寄存器，第 7 个起压栈。
run: sh -c 'd="$TMPDIR/argv"; mkdir -p "$d/app"; printf "[package]\nname = \"argv\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "poly : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\npoly a b c d e f g h i = a * 100000000 + b * 10000000 + c * 1000000 + d * 100000 + e * 10000 + f * 1000 + g * 100 + h * 10 + i\n\nmain : Int\nmain = poly 1 2 3 4 5 6 7 8 9\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/argv-out" "$d"'
exit: 0
run: "$TMPDIR/argv-out/bin/argv" 2>&1
out-equals: 123456789
# 奇数个栈参数（7 参）走对齐空洞；返回值必须原样。
run: sh -c 'd="$TMPDIR/argv"; printf "poly : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\npoly a b c d e f g = a + b + c + d + e + f + g\n\nmain : Int\nmain = poly 1 2 3 4 5 6 7\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/argv7-out" "$d"'
exit: 0
run: "$TMPDIR/argv7-out/bin/argv" 2>&1
out-equals: 28
# 栈传参 + 递归：每层都要读自己栈帧上的第 7 个参数。
run: sh -c 'd="$TMPDIR/argv"; printf "import Base.Nat\n\ng : Nat -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\ng a b c d e f h i = case a of\n  Zero => i\n  Succ k => g k b c d e f h (i + 1)\n\nmain : Int\nmain = g (natFromInt 5) 1 2 3 4 5 6 7\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/argvrec-out" "$d"'
exit: 0
run: "$TMPDIR/argvrec-out/bin/argv" 2>&1
out-equals: 12

# 9) 动作入口：`main : Eff [ConsoleOp] a` 在入口处跑，纯返回 1。
run: sh -c 'd="$TMPDIR/effpure"; mkdir -p "$d/app"; printf "[package]\nname = \"effpure\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffConsole\n\nmain : Eff [ConsoleOp] Int\nmain = pure 1\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effpure-out" "$d"'
exit: 0
run: "$TMPDIR/effpure-out/bin/effpure" 2>&1
out-equals: 1

# 9a) 入口宿主 handler：consolePrint 打印后把字节数交回动作，结果 2。
run: sh -c 'd="$TMPDIR/effhost"; mkdir -p "$d/app"; printf "[package]\nname = \"effhost\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffConsole\nimport Base.Nat\n\nmain : Eff [ConsoleOp] Nat\nmain = do\n  n <- consolePrint \"hi\"\n  pure (n + 10)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effhost-out" "$d"'
exit: 0
run: "$TMPDIR/effhost-out/bin/effhost" 2>&1
out-equals: hi12

# 9b) 两次 perform + 续延恢复：第二次 perform 在恢复后的栈上重新找 handler。
run: sh -c 'd="$TMPDIR/efftwo"; mkdir -p "$d/app"; printf "[package]\nname = \"efftwo\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffConsole\nimport Base.Nat\n\nmain : Eff [ConsoleOp] Nat\nmain = do\n  a <- consolePrint \"a\"\n  b <- consolePrint \"b\"\n  pure (a * 10 + b)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/efftwo-out" "$d"'
exit: 0
run: "$TMPDIR/efftwo-out/bin/efftwo" 2>&1
out-equals: ab11

# 9c) mock handler：resume 后 handler 还能用返回值继续计算（k 结果 + 100）。
run: sh -c 'd="$TMPDIR/effresume"; mkdir -p "$d/app"; printf "[package]\nname = \"effresume\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\n\ndata POp : Type where\n  P : Int -> POp\n\nresP : POp -> Type\nresP (P n) = Int\n\nmain : Int\nmain = runPure (handle (perform (P 3)) { P n k -> k (n + 1) + 100 })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effresume-out" "$d"'
exit: 0
run: "$TMPDIR/effresume-out/bin/effresume" 2>&1
out-equals: 104

# 9d) abort（不恢复续延）：handler 直接返回 42，后续计算丢弃。
run: sh -c 'd="$TMPDIR/effabort"; mkdir -p "$d/app"; printf "[package]\nname = \"effabort\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\n\ndata POp : Type where\n  P : Int -> POp\n\nresP : POp -> Type\nresP (P n) = Int\n\nmain : Int\nmain = runPure (handle (do\n  a <- perform (P 3)\n  pure (a * 2)\n) { P n k -> 42 })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effabort-out" "$d"'
exit: 0
run: "$TMPDIR/effabort-out/bin/effabort" 2>&1
out-equals: 42

# 9e) one-shot：resume 两次在运行期 trap（exit 2）。
run: sh -c 'd="$TMPDIR/efftwice"; mkdir -p "$d/app"; printf "[package]\nname = \"efftwice\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\n\ndata POp : Type where\n  P : Int -> POp\n\nresP : POp -> Type\nresP (P n) = Int\n\nmain : Int\nmain = runPure (handle (perform (P 3)) { P n k -> k (n + 1) + k 0 })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/efftwice-out" "$d"'
exit: 0
run: "$TMPDIR/efftwice-out/bin/efftwice" 2>&1
exit: 2
out-contains: continuation already resumed

# 9f) Exit 宿主 handler：exitWith 3 走宿主叶子，进程 exit 3。
run: sh -c 'd="$TMPDIR/effexit"; mkdir -p "$d/app"; printf "[package]\nname = \"effexit\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffExit\n\nmain : Eff [ExitOp] Int\nmain = do\n  _ <- exitWith 3\n  pure 0\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effexit-out" "$d"'
exit: 0
run: "$TMPDIR/effexit-out/bin/effexit" 2>&1
exit: 3

# 9g) 连续 500 次 perform：续延反复迁移/恢复，handler 链与返回值保持。
run: sh -c 'd="$TMPDIR/effmany"; mkdir -p "$d/app"; printf "[package]\nname = \"effmany\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.Nat\n\ndata POp : Type where\n  P : Int -> POp\n\nresP : POp -> Type\nresP (P n) = Int\n\nmany : Nat -> Eff [POp] Int\nmany n = case n of\n  Zero => pure 0\n  Succ m => do\n    x <- perform (P 1)\n    y <- many m\n    pure (x + y)\n\nmain : Int\nmain = runPure (handle (many (natFromInt 500)) { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effmany-out" "$d"'
exit: 0
run: "$TMPDIR/effmany-out/bin/effmany" 2>&1
out-equals: 500

# 9h) 嵌套 handler（外层未被触发）：恢复内层时链上仍有外层节点。
run: sh -c 'd="$TMPDIR/effnest"; mkdir -p "$d/app"; printf "[package]\nname = \"effnest\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\n\ndata AOp : Type where\n  A : Int -> AOp\n\nresA : AOp -> Type\nresA (A n) = Int\n\ndata BOp : Type where\n  B : Int -> BOp\n\nresB : BOp -> Type\nresB (B n) = Int\n\nprog : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int\nprog = do\n  x <- perform (A 1)\n  pure x\n\ninner : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int -> Eff (Named \"b\" BOp :: []) Int\ninner comp = handle comp {\n  A n k -> k (n + 10)\n}\n\nmain : Int\nmain = runPure (handle (inner prog) { B n k -> k (n * 100) })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effnest-out" "$d"'
exit: 0
run: "$TMPDIR/effnest-out/bin/effnest" 2>&1
out-equals: 11

# 9i) 显式 return：answer 类型与 comp 结果类型不同（Nat -> Int）。
run: sh -c 'd="$TMPDIR/effret"; mkdir -p "$d/app"; printf "[package]\nname = \"effret\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffConsole\nimport Base.Nat\n\nmain : Int\nmain = runPure (handle (perform (Print \"x\")) {\n  return n -> natToInt n\n  Print s k -> k (natFromInt 5)\n  EPrint s k -> k (natFromInt 7)\n})\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effret-out" "$d"'
exit: 0
run: "$TMPDIR/effret-out/bin/effret" 2>&1
out-equals: 5

# 9j) 恢复后深递归：续延栈段留出的向下增长空间（128 KiB）覆盖约 500 帧。
run: sh -c 'd="$TMPDIR/effdeep"; mkdir -p "$d/app"; printf "[package]\nname = \"effdeep\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.Nat\n\ndata POp : Type where\n  P : Int -> POp\n\nresP : POp -> Type\nresP (P n) = Int\n\nsum : Nat -> Eff [POp] Int\nsum n = case n of\n  Zero => pure 0\n  Succ m => do\n    y <- sum m\n    pure (y + 1)\n\nprog : Eff [POp] Int\nprog = do\n  x <- perform (P 1)\n  y <- sum (natFromInt 500)\n  pure (x + y)\n\nmain : Int\nmain = runPure (handle prog { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effdeep-out" "$d"'
exit: 0
run: "$TMPDIR/effdeep-out/bin/effdeep" 2>&1
out-equals: 501

# 9k) 嵌套 handler 的内层恢复段里触发外层 perform：整段栈迁移后仍回到 211。
run: sh -c 'd="$TMPDIR/effnested"; mkdir -p "$d/app"; printf "[package]\nname = \"effnested\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\n\ndata AOp : Type where\n  A : Int -> AOp\n\nresA : AOp -> Type\nresA (A n) = Int\n\ndata BOp : Type where\n  B : Int -> BOp\n\nresB : BOp -> Type\nresB (B n) = Int\n\nprog : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int\nprog = do\n  x <- perform (A 1)\n  y <- perform (B 2)\n  pure (x + y)\n\ninner : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int -> Eff (Named \"b\" BOp :: []) Int\ninner comp = handle comp {\n  A n k -> k (n + 10)\n}\n\nmain : Int\nmain = runPure (handle (inner prog) { B n k -> k (n * 100) })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effnested-out" "$d"'
exit: 0
run: "$TMPDIR/effnested-out/bin/effnested" 2>&1
out-equals: 211

# 9l) 续延栈段越界：恢复后的深递归超过 slack 时 trap（exit 2），不踩堆。
run: sh -c 'd="$TMPDIR/effovf"; mkdir -p "$d/app"; printf "[package]\nname = \"effovf\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.Nat\n\ndata POp : Type where\n  P : Int -> POp\n\nresP : POp -> Type\nresP (P n) = Int\n\nsum : Nat -> Eff [POp] Int\nsum n = case n of\n  Zero => pure 0\n  Succ m => do\n    y <- sum m\n    pure (y + 1)\n\nprog : Eff [POp] Int\nprog = do\n  x <- perform (P 1)\n  y <- sum (natFromInt 400000)\n  pure (x + y)\n\nmain : Int\nmain = runPure (handle prog { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effovf-out" "$d"'
exit: 0
run: "$TMPDIR/effovf-out/bin/effovf" 2>&1
exit: 2
out-contains: continuation stack overflow

# 9m) 单次捕获超过堆初始段（1 MiB）：perform 在 20000 帧深处，捕获缓冲必须按
#     请求放大 mmap，而不是落进 1 MiB 段尾。
run: sh -c 'd="$TMPDIR/effcap"; mkdir -p "$d/app"; printf "[package]\nname = \"effcap\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.Nat\n\ndata POp : Type where\n  P : Int -> POp\n\nresP : POp -> Type\nresP (P n) = Int\n\nsum : Nat -> Eff [POp] Int\nsum n = case n of\n  Zero => perform (P 1)\n  Succ m => do\n    y <- sum m\n    pure (y + 1)\n\nmain : Int\nmain = runPure (handle (sum (natFromInt 20000)) { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effcap-out" "$d"'
exit: 0
run: "$TMPDIR/effcap-out/bin/effcap" 2>&1
out-equals: 20001

# 9n) 高阶观测原语：`@vuna@obs@span` 不写事件，但必须调 thunk 并返回其结果。
run: sh -c 'd="$TMPDIR/obsspan"; mkdir -p "$d/app"; printf "[package]\nname = \"obsspan\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Obs.Span\n\nmain : Int\nmain = obsSpan \"vuna.probe\" \"vuna.user\" (\\_ => 42)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/obsspan-out" "$d"'
exit: 0
run: "$TMPDIR/obsspan-out/bin/obsspan" 2>&1
out-equals: 42

# 10) --no-compile：只写 main.s + build.sh；build.sh 可独立链接并运行。
run: sh -c 'd="$TMPDIR/nc"; mkdir -p "$d/app"; printf "[package]\nname = \"nc\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : String\nmain = \"n\" ++ strFromInt 7\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --no-compile --out "$TMPDIR/nc-out" "$d"'
exit: 0
file-exists: $TMPDIR/nc-out/main.s
file-exists: $TMPDIR/nc-out/build.sh
file-absent: $TMPDIR/nc-out/bin/nc
run: sh -c 'cd "$TMPDIR/nc-out" && sh build.sh && ./bin/nc'
exit: 0
out-equals: "n7"

# 9o) 宿主入参/环境/目录/时钟：argv 不含 argv[0]，envp 键值扫描，cwd/execPath 非空，
#     sleep 后时间不倒退；结果 2+5+1+1+1 = 10。
run: sh -c 'd="$TMPDIR/hostargs"; mkdir -p "$d/app"; printf "[package]\nname = \"hostargs\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffArgs\nimport Base.EffClock\nimport Base.EffEnv\nimport Base.Int\nimport Base.List\nimport Base.String\n\nmain : Eff [ArgsOp, ClockOp, EnvOp] Int\nmain = do\n  args <- argsGetArgs\n  home <- envGetEnv \"VUNA_TEST_ENV\"\n  cwd <- envGetCwd\n  exe <- envExecPath\n  t0 <- clockNow\n  _ <- clockSleepMicros 1000\n  t1 <- clockNow\n  pure (length args + strLength home + (if strLength cwd > 0 then 1 else 0) + (if strLength exe > 0 then 1 else 0) + (if t1 >= t0 then 1 else 0))\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/hostargs-out" "$d"'
exit: 0
run: sh -c 'VUNA_TEST_ENV=hello "$TMPDIR/hostargs-out/bin/hostargs" one two 2>&1'
exit: 0
out-equals: 10

# 9p) bracket/finally：cleanup 登记表 push/pop（正常路径；abort 不运行，与 wasm 同边界）。
run: sh -c 'd="$TMPDIR/bracket"; mkdir -p "$d/app"; printf "[package]\nname = \"bracket\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.Int\n\nmain : Int\nmain = runPure (bracket (pure 7) (\\\\_ => pure 0) (\\\\r => pure (r * 6)))\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/bracket-out" "$d"'
exit: 0
run: "$TMPDIR/bracket-out/bin/bracket" 2>&1
out-equals: 42

# 9q) 宿主 fs：建/写/读/原子写/目录列举（排序）/stat/rename/symlink/递归删除。
#     a="hello"(5) + b="atomic"(6) + entries 2 + isDir 1 + exists 1 + size 5 + mtime 1 = 21。
run: sh -c 'd="$TMPDIR/fsops"; mkdir -p "$d/app"; printf "[package]\nname = \"fsops\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Bool\nimport Base.Eff\nimport Base.EffFs\nimport Base.Int\nimport Base.List\nimport Base.Maybe\nimport Base.Nat\nimport Base.String\n\ndir : String\ndir = \"$TMPDIR/fs-tree\"\n\nmain : Eff [FsOp] Int\nmain = do\n  _ <- fsRemoveTree dir\n  _ <- fsMakeDir dir\n  _ <- fsWriteFile (dir ++ \"/a.txt\") \"hello\"\n  _ <- fsWriteFileAtomic (dir ++ \"/b.txt\") \"atomic\"\n  a <- fsReadFile (dir ++ \"/a.txt\")\n  b <- fsReadFile (dir ++ \"/b.txt\")\n  entries <- fsReadDir dir\n  isd <- fsIsDirectory dir\n  ex <- fsFileExists (dir ++ \"/a.txt\")\n  sz <- fsFileSize (dir ++ \"/a.txt\")\n  mt <- fsFileMtime (dir ++ \"/a.txt\")\n  _ <- fsRename (dir ++ \"/b.txt\") (dir ++ \"/c.txt\")\n  _ <- fsSymlink (dir ++ \"/a.txt\") (dir ++ \"/link\")\n  _ <- fsRemoveFile (dir ++ \"/c.txt\")\n  _ <- fsRemoveTree dir\n  pure (strLength a + strLength b + length entries + (if isd then 1 else 0) + (if ex then 1 else 0) + maybe 0 (\\\\n => natToInt n) sz + maybe 0 (\\\\_ => 1) mt)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/fsops-out" "$d"'
exit: 0
run: "$TMPDIR/fsops-out/bin/fsops" 2>&1
out-equals: 21
run: sh -c 'test ! -e "$TMPDIR/fs-tree" && echo cleaned'
out-equals: cleaned

# 9r) readDir 按字典序（`Sys.readdir` + `sort compare` 语义）：建 c/a/b -> "abc"。
run: sh -c 'd="$TMPDIR/fsdir"; mkdir -p "$d/app"; printf "[package]\nname = \"fsdir\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffFs\nimport Base.Int\nimport Base.List\nimport Base.String\n\ndir : String\ndir = \"$TMPDIR/fs-dir\"\n\nmain : Eff [FsOp] String\nmain = do\n  _ <- fsRemoveTree dir\n  _ <- fsMakeDir dir\n  _ <- fsWriteFile (dir ++ \"/c\") \"\"\n  _ <- fsWriteFile (dir ++ \"/a\") \"\"\n  _ <- fsWriteFile (dir ++ \"/b\") \"\"\n  xs <- fsReadDir dir\n  pure (case xs of\n    x :: y :: z :: _ => x ++ y ++ z\n    _ => \"?\")\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/fsdir-out" "$d"'
exit: 0
run: "$TMPDIR/fsdir-out/bin/fsdir" 2>&1
out-equals: "abc"

# 9s) fs 失败路径：读不存在的文件 -> typed error 收口（诊断 + exit 1），不伪造内容。
run: sh -c 'd="$TMPDIR/fsmiss"; mkdir -p "$d/app"; printf "[package]\nname = \"fsmiss\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Eff\nimport Base.EffFs\nimport Base.Int\nimport Base.String\n\nmain : Eff [FsOp] Int\nmain = do\n  s <- fsReadFile \"$TMPDIR/fs-missing-file\"\n  pure (strLength s)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/fsmiss-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/fsmiss-out/bin/fsmiss" 2>&1'
exit: 1
out-contains: fs: readFile
