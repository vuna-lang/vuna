# 15) 用户 data + 通用 case + record（与 native 同一表示决策）。
run: sh -c 'd="$TMPDIR/m3a"; mkdir -p "$d/app"; printf "[package]\nname = \"m3a\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "data Color : Type where\n  Red : Color\n  Blue : Color\n\npick : Color -> Int\npick c = case c of\n  Red => 1\n  Blue => 2\n\nmain : Int\nmain = pick Red + pick Blue\n" > "$d/app/Main.vuna"; "$VUNA" build --target wasm --out "$TMPDIR/m3a-w" "$d"'
exit: 0
run: sh -c 'cd "$TMPDIR/m3a-w" && wasmtime run -W gc=y -W function-references=y main.wasm 2>&1'
out-equals: 3
run: sh -c 'd="$TMPDIR/m3a"; printf "data Shape : Type where\n  Dot : Shape\n  Rect : Int -> Int -> Shape\n\narea : Shape -> Int\narea s = case s of\n  Dot => 0\n  Rect w h => w * h\n\nmain : Int\nmain = area (Rect 3 4) + area Dot\n" > "$d/app/Main.vuna"; "$VUNA" build --target wasm --out "$TMPDIR/m3a-wrect" "$d"'
exit: 0
run: sh -c 'cd "$TMPDIR/m3a-wrect" && wasmtime run -W gc=y -W function-references=y main.wasm 2>&1'
