run: sh -c 'd="$TMPDIR/m3a"; printf "record Point where\n  x : Int\n  y : Int\n\nmain : Int\nmain = let p = Point { x = 3, y = 4 } in p.x * p.x + p.y * p.y\n" > "$d/app/Main.vuna"; "$VUNA" build --target wasm --out "$TMPDIR/m3a-wrec" "$d"'
exit: 0
run: sh -c 'cd "$TMPDIR/m3a-wrec" && wasmtime run -W gc=y -W function-references=y main.wasm 2>&1'
