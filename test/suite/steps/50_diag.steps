# 50) M38 CLI 诊断片段：`-->` + 源码行 + 插入符；无位置错误保持单行；退出码不变。
#     夹具写在 case 私有 $TMPDIR（包上下文只依赖 $VUNA_BASE），不触碰工作树。
#     注：steps 的 out-contains 值会 trim 首尾空白，原 `"  --> "` 改为 `-->`（片段语义不变）。
run: sh -c 'd="$TMPDIR/m38-diag-pkg"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m38-diag-pkg\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = \"boom\"\n" > "$d/app/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" 2>&1
exit: 1
out-contains: -->
out-contains: app/Main.vuna:2:8
out-contains: main = "boom"
out-contains: ^
# 无位置错误（入口文件不存在）保持单行诊断：有消息、没有源码片段、退出码 1。
run: "$VUNA" check "$TMPDIR/m38-no-such-entry.vuna" 2>&1
exit: 1
out-contains: no such file
out-not-contains: -->
# 结构化输出：--json 给出 code/severity/phase + 机器字段（expected/found）。
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" --json 2>&1
exit: 1
out-contains: "code":"TC_TypeMismatch"
out-contains: "severity":"error"
out-contains: "phase":"elab"
out-contains: "kind":"expected"
out-contains: "kind":"found"
# human：rustc 风格首行 + 片段。
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" --error-format=human 2>&1
exit: 1
out-contains: error[TC_TypeMismatch]:
out-contains: -->
# explain：码目录查询（未知码 exit 2）。
run: "$VUNA" explain TC_TypeMismatch
exit: 0
out-contains: TC_TypeMismatch
out-contains: type mismatch
run: sh -c '"$VUNA" explain NOPE 2>&1'
exit: 2
out-contains: unknown diagnostic code
# 清单诊断：vuna.toml 未知 key 是有码、带行号的诊断。
run: sh -c 'd="$TMPDIR/m38-manifest"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m38-manifest\"\nversion = \"1\"\n" > "$d/vuna.toml"; printf "main : Int\nmain = 1\n" > "$d/app/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-manifest" 2>&1
exit: 1
out-contains: [PKG_UnknownKey]
out-contains: unknown key "version" in [package]
out-contains: vuna.toml:3:1
# warning 通道：默认静默；-W 显示；--deny-warnings 提升退出码。
run: sh -c 'printf "apply : (Int -> Int) -> Int\napply f = f 1\n\nunused : Int\nunused = apply (\\x => 2)\n\nmain : Int\nmain = unused\n" > "$TMPDIR/m38-warn.vuna"'
run: "$VUNA" check "$TMPDIR/m38-warn.vuna" 2>&1
out-not-contains: UN_UnusedBinder
run: "$VUNA" check -W "$TMPDIR/m38-warn.vuna" 2>&1
out-contains: [UN_UnusedBinder]
out-contains: binder `x` is never used
run: "$VUNA" check "$TMPDIR/m38-warn.vuna" --deny-warnings 2>&1
exit: 1
out-contains: [UN_UnusedBinder]
# shadow warning：内层同名 binder。
run: sh -c 'printf "f : Int -> Int -> Int\nf x = \\x => x\n\nmain : Int\nmain = f 1 2\n" > "$TMPDIR/m38-shadow.vuna"'
run: "$VUNA" check -W "$TMPDIR/m38-shadow.vuna" 2>&1
out-contains: [UN_ShadowedBinder]
out-contains: shadows an outer binder
# SARIF 2.1.0：单 run、ruleId/level/locations/region 来自结构化诊断。
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" --error-format=sarif 2>&1
exit: 1
out-contains: "version":"2.1.0"
out-contains: "ruleId":"TC_TypeMismatch"
out-contains: "level":"error"
out-contains: "startLine":2
# vuna.toml [diagnostics]：format / warnings / max-errors（命令行 flag 优先）。
run: sh -c 'd="$TMPDIR/m38-cfgfmt"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"cfgfmt\"\n[export]\nmodules = [\"Main\"]\n\n[diagnostics]\nformat = \"json\"\n" > "$d/vuna.toml"; printf "module Main where\n\nmain : Int\nmain = \"x\"\n" > "$d/lib/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-cfgfmt" 2>&1
exit: 1
out-contains: "version":1
out-contains: "code":"TC_TypeMismatch"
# 显式 flag 覆盖配置。
run: "$VUNA" check "$TMPDIR/m38-cfgfmt" --error-format=short 2>&1
exit: 1
out-contains: [TC_TypeMismatch]
out-not-contains: "version":1
# warnings = true 打开告警。
run: sh -c 'd="$TMPDIR/m38-cfgwarn"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"cfgwarn\"\n[export]\nmodules = [\"Main\"]\n\n[diagnostics]\nwarnings = true\n" > "$d/vuna.toml"; printf "module Main where\n\nf : Int -> Int\nf x = 1\n\nmain : Int\nmain = f 1\n" > "$d/lib/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-cfgwarn" 2>&1
out-contains: [UN_UnusedBinder]
# 非法 format 是清单诊断。
run: sh -c 'd="$TMPDIR/m38-cfgbad"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"cfgbad\"\n\n[diagnostics]\nformat = \"xml\"\n" > "$d/vuna.toml"; printf "module Main where\n\nmain : Int\nmain = 1\n" > "$d/lib/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-cfgbad" 2>&1
exit: 1
out-contains: [PKG_InvalidDiagFormat]
# unused import warning：-W 显示；实际使用的 import 不报。
run: sh -c 'printf "import Base.List as L\n\nmain : Int\nmain = 1\n" > "$TMPDIR/m38-impbad.vuna"'
run: "$VUNA" check -W "$TMPDIR/m38-impbad.vuna" 2>&1
out-contains: [UN_UnusedImport]
out-contains: module `Base.List` is imported but never used
run: sh -c 'printf "import Base.List as L\n\nmain : Int\nmain = L.length [1,2]\n" > "$TMPDIR/m38-impok.vuna"'
run: "$VUNA" check -W "$TMPDIR/m38-impok.vuna" 2>&1
out-not-contains: UN_UnusedImport
# 解析错误累积：多个语法错误一次报出；--max-errors 截断（short 与 JSON 一致）。
run: sh -c 'printf "main : Int\nmain = case 1 of\n2 => 0\n\nf : Int\nf = let in 0\n\ng : Int\ng = do\n" > "$TMPDIR/m39-multi.vuna"'
run: "$VUNA" check "$TMPDIR/m39-multi.vuna" 2>&1
exit: 1
out-contains: PS_CaseAltNotIndented
out-contains: PS_ExpectedLetBinding
out-contains: PS_DoBlockNeedsStatement
run: sh -c '"$VUNA" check "$TMPDIR/m39-multi.vuna" --max-errors 2 2>&1 | grep -c "^error"'
out-contains: 2
run: sh -c '"$VUNA" check "$TMPDIR/m39-multi.vuna" --max-errors 2 --json 2>&1 | grep -o "\"code\"" | wc -l'
out-contains: 2
# explain 元数据：severity/phase/category 与诊断目录同源。
run: "$VUNA" explain TC_TypeMismatch
out-contains: severity: error
out-contains: phase: elab
out-contains: category: types
run: "$VUNA" explain UN_UnusedBinder
out-contains: severity: warning
out-contains: phase: usage
# i18n：--lang zh 默认切到 human 并追加中文目录说明；默认 en 不变。
run: sh -c 'printf "main : Int\nmain = \"x\"\n" > "$TMPDIR/m40-i18n.vuna"'
run: "$VUNA" check "$TMPDIR/m40-i18n.vuna" --lang zh 2>&1
exit: 1
out-contains: 说明: 类型不匹配
run: "$VUNA" check "$TMPDIR/m40-i18n.vuna" --json --lang zh 2>&1
exit: 1
out-not-contains: 说明:
# [diagnostics].lang：manifest 配置 zh 时 human 输出中文说明（CLI flag 优先）。
run: sh -c 'd="$TMPDIR/m41-langpkg"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m41-langpkg\"\n[diagnostics]\nlang = \"zh\"\n" > "$d/vuna.toml"; printf "main : Int\nmain = \"x\"\n" > "$d/app/Main.vuna"'
run: sh -c 'cd "$TMPDIR/m41-langpkg" && "$VUNA" check . 2>&1'
exit: 1
out-contains: 说明: 类型不匹配
# explain example：从 corpus 结构化夹具反查示例文件。
run: "$VUNA" explain TC_TypeMismatch
out-contains: example: corpus/
# open import 追踪：使用未限定名不再误报；完全未使用才告警。
run: sh -c 'd="$TMPDIR/m42-open-use"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m42\"\n[export]\nmodules = [\"Main\", \"M\"]\n" > "$d/vuna.toml"; printf "module M where\n\nhelper : Int\nhelper = 1\n" > "$d/lib/M.vuna"; printf "module Main where\n\nimport M\n\nmain : Int\nmain = helper\n" > "$d/lib/Main.vuna"; cd "$d" && "$VUNA" check -W . --json 2>&1'
exit: 0
out-not-contains: UN_UnusedImport
run: sh -c 'd="$TMPDIR/m42-open-unused"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m42b\"\n[export]\nmodules = [\"Main\", \"M\"]\n" > "$d/vuna.toml"; printf "module M where\n\nhelper : Int\nhelper = 1\n" > "$d/lib/M.vuna"; printf "module Main where\n\nimport M\n\nmain : Int\nmain = 0\n" > "$d/lib/Main.vuna"; cd "$d" && "$VUNA" check -W . --json 2>&1'
exit: 0
out-contains: UN_UnusedImport
# human 视图展示机器字段/轨迹/建议（与 JSON 同源）。
run: sh -c 'printf "main : Int\nmain = \"x\"\n" > "$TMPDIR/m43-fields.vuna"'
run: "$VUNA" check "$TMPDIR/m43-fields.vuna" --error-format human 2>&1
exit: 1
out-contains: = expected: Int
out-contains: = found: String
out-contains: = trace[unify]:
run: "$VUNA" check corpus/dt_err/28_multi_clause_coverage.vuna --error-format human 2>&1
exit: 1
out-contains: = candidates: Nat.Succ
