# 50) M38 CLI 诊断片段：`-->` + 源码行 + 插入符；无位置错误保持单行；退出码不变。
#     夹具写在 case 私有 $TMPDIR（包上下文只依赖 $VUNA_BASE），不触碰工作树。
#     注：steps 的 out-contains 值会 trim 首尾空白，原 `"  --> "` 改为 `-->`（片段语义不变）。
run: sh -c 'd="$TMPDIR/m38-diag-pkg"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m38-diag-pkg\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = \"boom\"\n" > "$d/app/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" 2>&1
exit: 1
out-contains: -->
out-contains: app/Main.vuna:2:8
out-contains: main = "boom"
out-contains: ^
# 无位置错误（入口文件不存在）保持单行诊断：有消息、没有源码片段、退出码 1。
run: "$VUNA" check "$TMPDIR/m38-no-such-entry.vuna" 2>&1
exit: 1
out-contains: no such file
out-not-contains: -->
# 结构化输出：--json 给出 code/severity/phase + 机器字段（expected/found）。
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" --json 2>&1
exit: 1
out-contains: "code":"TC_TypeMismatch"
out-contains: "severity":"error"
out-contains: "phase":"elab"
out-contains: "kind":"expected"
out-contains: "kind":"found"
# human：rustc 风格首行 + 片段。
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" --error-format=human 2>&1
exit: 1
out-contains: error[TC_TypeMismatch]:
out-contains: -->
# explain：码目录查询（未知码 exit 2）。
run: "$VUNA" explain TC_TypeMismatch
exit: 0
out-contains: TC_TypeMismatch
out-contains: type mismatch
run: sh -c '"$VUNA" explain NOPE 2>&1'
exit: 2
out-contains: unknown diagnostic code
# 清单诊断：vuna.toml 未知 key 是有码、带行号的诊断。
run: sh -c 'd="$TMPDIR/m38-manifest"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m38-manifest\"\nversion = \"1\"\n" > "$d/vuna.toml"; printf "main : Int\nmain = 1\n" > "$d/app/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-manifest" 2>&1
exit: 1
out-contains: [PKG_UnknownKey]
out-contains: unknown key "version" in [package]
out-contains: vuna.toml:3:1
# warning 通道：默认静默；-W 显示；--deny-warnings 提升退出码。
run: sh -c 'printf "apply : (Int -> Int) -> Int\napply f = f 1\n\nunused : Int\nunused = apply (\\x => 2)\n\nmain : Int\nmain = unused\n" > "$TMPDIR/m38-warn.vuna"'
run: "$VUNA" check "$TMPDIR/m38-warn.vuna" 2>&1
out-not-contains: UN_UnusedBinder
run: "$VUNA" check -W "$TMPDIR/m38-warn.vuna" 2>&1
out-contains: [UN_UnusedBinder]
out-contains: binder `x` is never used
run: "$VUNA" check "$TMPDIR/m38-warn.vuna" --deny-warnings 2>&1
exit: 1
out-contains: [UN_UnusedBinder]
# shadow warning：内层同名 binder。
run: sh -c 'printf "f : Int -> Int -> Int\nf x = \\x => x\n\nmain : Int\nmain = f 1 2\n" > "$TMPDIR/m38-shadow.vuna"'
run: "$VUNA" check -W "$TMPDIR/m38-shadow.vuna" 2>&1
out-contains: [UN_ShadowedBinder]
out-contains: shadows an outer binder
# SARIF 2.1.0：单 run、ruleId/level/locations/region 来自结构化诊断。
run: "$VUNA" check "$TMPDIR/m38-diag-pkg" --error-format=sarif 2>&1
exit: 1
out-contains: "version":"2.1.0"
out-contains: "ruleId":"TC_TypeMismatch"
out-contains: "level":"error"
out-contains: "startLine":2
out-contains: "shortDescription":{"text":"类型不匹配"}
out-contains: "properties":{"tags":["elab","types"]}
# vuna.toml [diagnostics]：format / warnings / max-errors（命令行 flag 优先）。
run: sh -c 'd="$TMPDIR/m38-cfgfmt"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"cfgfmt\"\n[export]\nmodules = [\"Main\"]\n\n[diagnostics]\nformat = \"json\"\n" > "$d/vuna.toml"; printf "module Main where\n\nmain : Int\nmain = \"x\"\n" > "$d/lib/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-cfgfmt" 2>&1
exit: 1
out-contains: "version":1
out-contains: "code":"TC_TypeMismatch"
# 显式 flag 覆盖配置。
run: "$VUNA" check "$TMPDIR/m38-cfgfmt" --error-format=short 2>&1
exit: 1
out-contains: [TC_TypeMismatch]
out-not-contains: "version":1
# warnings = true 打开告警。
run: sh -c 'd="$TMPDIR/m38-cfgwarn"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"cfgwarn\"\n[export]\nmodules = [\"Main\"]\n\n[diagnostics]\nwarnings = true\n" > "$d/vuna.toml"; printf "module Main where\n\nf : Int -> Int\nf x = 1\n\nmain : Int\nmain = f 1\n" > "$d/lib/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-cfgwarn" 2>&1
out-contains: [UN_UnusedBinder]
# 非法 format 是清单诊断。
run: sh -c 'd="$TMPDIR/m38-cfgbad"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"cfgbad\"\n\n[diagnostics]\nformat = \"xml\"\n" > "$d/vuna.toml"; printf "module Main where\n\nmain : Int\nmain = 1\n" > "$d/lib/Main.vuna"'
run: "$VUNA" check "$TMPDIR/m38-cfgbad" 2>&1
exit: 1
out-contains: [PKG_InvalidDiagFormat]
# unused import warning：-W 显示；实际使用的 import 不报。
run: sh -c 'printf "import Base.List as L\n\nmain : Int\nmain = 1\n" > "$TMPDIR/m38-impbad.vuna"'
run: "$VUNA" check -W "$TMPDIR/m38-impbad.vuna" 2>&1
out-contains: [UN_UnusedImport]
out-contains: module `Base.List` is imported but never used
run: sh -c 'printf "import Base.List as L\n\nmain : Int\nmain = L.length [1,2]\n" > "$TMPDIR/m38-impok.vuna"'
run: "$VUNA" check -W "$TMPDIR/m38-impok.vuna" 2>&1
out-not-contains: UN_UnusedImport
# 解析错误累积：多个语法错误一次报出；--max-errors 截断（short 与 JSON 一致）。
run: sh -c 'printf "main : Int\nmain = case 1 of\n2 => 0\n\nf : Int\nf = let in 0\n\ng : Int\ng = do\n" > "$TMPDIR/m39-multi.vuna"'
run: "$VUNA" check "$TMPDIR/m39-multi.vuna" 2>&1
exit: 1
out-contains: PS_CaseAltNotIndented
out-contains: PS_ExpectedLetBinding
out-contains: PS_DoBlockNeedsStatement
run: sh -c '"$VUNA" check "$TMPDIR/m39-multi.vuna" --max-errors 2 2>&1 | grep -c "^error"'
out-contains: 2
run: sh -c '"$VUNA" check "$TMPDIR/m39-multi.vuna" --max-errors 2 --json 2>&1 | grep -o "\"code\"" | wc -l'
out-contains: 2
# explain 元数据：severity/phase/category 与诊断目录同源。
run: "$VUNA" explain TC_TypeMismatch
out-contains: severity: error
out-contains: phase: elab
out-contains: category: types
run: "$VUNA" explain UN_UnusedBinder
out-contains: severity: warning
out-contains: phase: usage
# i18n：--lang zh 默认切到 human 并追加中文目录说明；默认 en 不变。
run: sh -c 'printf "main : Int\nmain = \"x\"\n" > "$TMPDIR/m40-i18n.vuna"'
run: "$VUNA" check "$TMPDIR/m40-i18n.vuna" --lang zh 2>&1
exit: 1
out-contains: [TC_TypeMismatch]: 类型不匹配
out-contains: = message: type mismatch
run: "$VUNA" check "$TMPDIR/m40-i18n.vuna" --json --lang zh 2>&1
exit: 1
out-not-contains: 说明:
# [diagnostics].lang：manifest 配置 zh 时 human 输出中文说明（CLI flag 优先）。
run: sh -c 'd="$TMPDIR/m41-langpkg"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m41-langpkg\"\n[diagnostics]\nlang = \"zh\"\n" > "$d/vuna.toml"; printf "main : Int\nmain = \"x\"\n" > "$d/app/Main.vuna"'
run: sh -c 'cd "$TMPDIR/m41-langpkg" && "$VUNA" check . 2>&1'
exit: 1
out-contains: [TC_TypeMismatch]: 类型不匹配
out-contains: = message: type mismatch
# explain example：从 corpus 结构化夹具反查示例文件。
run: "$VUNA" explain TC_TypeMismatch
out-contains: example: corpus/
# open import 追踪：使用未限定名不再误报；完全未使用才告警。
run: sh -c 'd="$TMPDIR/m42-open-use"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m42\"\n[export]\nmodules = [\"Main\", \"M\"]\n" > "$d/vuna.toml"; printf "module M where\n\nexport helper : Int\nhelper = 1\n" > "$d/lib/M.vuna"; printf "module Main where\n\nimport M\n\nmain : Int\nmain = helper\n" > "$d/lib/Main.vuna"; cd "$d" && "$VUNA" check -W . --json 2>&1'
exit: 0
out-not-contains: UN_UnusedImport
run: sh -c 'd="$TMPDIR/m42-open-unused"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m42b\"\n[export]\nmodules = [\"Main\", \"M\"]\n" > "$d/vuna.toml"; printf "module M where\n\nexport helper : Int\nhelper = 1\n" > "$d/lib/M.vuna"; printf "module Main where\n\nimport M\n\nmain : Int\nmain = 0\n" > "$d/lib/Main.vuna"; cd "$d" && "$VUNA" check -W . --json 2>&1'
exit: 0
out-contains: UN_UnusedImport
# human 视图展示机器字段/轨迹/建议（与 JSON 同源）。
run: sh -c 'printf "main : Int\nmain = \"x\"\n" > "$TMPDIR/m43-fields.vuna"'
run: "$VUNA" check "$TMPDIR/m43-fields.vuna" --error-format human 2>&1
exit: 1
out-contains: = expected: Int
out-contains: = found: String
out-contains: = trace[unify]:
run: "$VUNA" check corpus/dt_err/28_multi_clause_coverage.vuna --error-format human 2>&1
exit: 1
out-contains: = candidates: Nat.Succ
# explain --json：目录条目机器可读（含 example 夹具路径）。
run: "$VUNA" explain --json TC_TypeMismatch
out-contains: "code":"TC_TypeMismatch"
out-contains: "meaning":"类型不匹配"
out-contains: "phase":"elab"
out-contains: "example":
run: "$VUNA" explain --list --json
out-contains: "codes":[
run: "$VUNA" explain --json NOPE_Code
exit: 2
out-contains: unknown diagnostic code
# [diagnostics].deny-warnings：manifest 配置把 warning 提升为失败（显式 CLI 优先）。
run: sh -c 'd="$TMPDIR/m44-denycfg"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m44\"\n[export]\nmodules = [\"Main\"]\n\n[diagnostics]\ndeny-warnings = true\n" > "$d/vuna.toml"; printf "module Main where\n\nf : Int -> Int\nf x = 1\n" > "$d/lib/Main.vuna"; cd "$d" && "$VUNA" check . 2>&1'
exit: 1
out-contains: UN_UnusedBinder
run: sh -c 'd="$TMPDIR/m44-denycfg-clean"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m44b\"\n[export]\nmodules = [\"Main\"]\n\n[diagnostics]\ndeny-warnings = true\n" > "$d/vuna.toml"; printf "module Main where\n\nmain : Int\nmain = 0\n" > "$d/lib/Main.vuna"; cd "$d" && "$VUNA" check . >/dev/null 2>&1'
exit: 0
# 冗余/不可达分支：删除分支的 machine-applicable 建议（JSON 可见；LSP 走同一 suggestions）。
run: "$VUNA" check -W corpus/dt_err/41_redundant_ctor_branch.vuna --json 2>&1
out-contains: remove redundant constructor branch
run: "$VUNA" check -W corpus/dt_err/41b_redundant_literal.vuna --json 2>&1
out-contains: remove redundant literal branch
run: "$VUNA" check -W corpus/dt_err/41c_branch_after_catchall.vuna --json 2>&1
out-contains: remove unreachable branch
# LSP 诊断建议 quick fix 集成：冗余分支删除 + 未使用 binder 改名。
run: sh corpus/lsp/quickfix.sh "$VUNA"
out-contains: quickfix: ok
# elab best-effort 多错误：--continue-on-error 逐次移除失败声明后继续（文件入口）。
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = \"y\"\n\nmain : Int\nmain = 0\n" > "$TMPDIR/m45-multi.vuna"; "$VUNA" check "$TMPDIR/m45-multi.vuna" --continue-on-error --json 2>&1'
exit: 1
out-contains: "line":2
out-contains: "line":5
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = \"y\"\n\nmain : Int\nmain = 0\n" > "$TMPDIR/m45-multi2.vuna"; "$VUNA" check "$TMPDIR/m45-multi2.vuna" --json 2>&1'
exit: 1
out-contains: "line":2
out-not-contains: "line":5
# 恢复路径的级联检测：依赖被移除声明的错误标 origin=cascade；独立错误保持 direct。
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = a\n\nmain : Int\nmain = b\n" > "$TMPDIR/m46-dep.vuna"; "$VUNA" check "$TMPDIR/m46-dep.vuna" --continue-on-error --json 2>&1'
exit: 1
out-contains: "kind":"cascade"
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = \"y\"\n\nmain : Int\nmain = 0\n" > "$TMPDIR/m46-indep.vuna"; "$VUNA" check "$TMPDIR/m46-indep.vuna" --continue-on-error --json 2>&1'
exit: 1
out-not-contains: "kind":"cascade"
# 恢复路径：包入口同样支持 --continue-on-error；--max-errors 约束恢复结果。
run: sh -c 'd="$TMPDIR/m47-pkg"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m47\"\n" > "$d/vuna.toml"; printf "a : Int\na = \"x\"\n\nb : Int\nb = \"y\"\n\nmain : Int\nmain = 0\n" > "$d/app/Main.vuna"; cd "$d" && "$VUNA" check . --continue-on-error --json 2>&1'
exit: 1
out-contains: "line":2
out-contains: "line":5
run: sh -c 'd="$TMPDIR/m47-pkg2"; rm -rf "$d"; mkdir -p "$d/app"; printf "[package]\nname = \"m47b\"\n" > "$d/vuna.toml"; printf "a : Int\na = \"x\"\n\nb : Int\nb = \"y\"\n\nmain : Int\nmain = 0\n" > "$d/app/Main.vuna"; cd "$d" && "$VUNA" check . --continue-on-error --max-errors 1 --json 2>&1'
exit: 1
out-contains: "line":2
out-not-contains: "line":5
# 级联默认折叠：human 只显示 direct 错误；--show-cascade 打开恢复路径的级联 note。
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = a\n\nmain : Int\nmain = b\n" > "$TMPDIR/m47-dep.vuna"; "$VUNA" check "$TMPDIR/m47-dep.vuna" --continue-on-error --error-format human 2>&1'
exit: 1
out-not-contains: best-effort: may be a cascade
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = a\n\nmain : Int\nmain = b\n" > "$TMPDIR/m47-dep.vuna"; "$VUNA" check "$TMPDIR/m47-dep.vuna" --continue-on-error --error-format human --show-cascade 2>&1'
exit: 1
out-contains: best-effort: may be a cascade
# 实例搜索候选也带声明 span（可跳转到 instance 定义）。
run: "$VUNA" check corpus/dt_err/25_no_instance.vuna --json 2>&1
exit: 1
out-contains: "text":"Name_A","span":{"file"
# 库包（[export].modules）恢复：两个模块各自的独立错误都被收集。
run: sh -c 'd="$TMPDIR/m49-lib"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m49\"\n[export]\nmodules = [\"A\", \"B\"]\n" > "$d/vuna.toml"; printf "module A where\n\na : Int\na = \"x\"\n" > "$d/lib/A.vuna"; printf "module B where\n\nb : Int\nb = \"y\"\n" > "$d/lib/B.vuna"; cd "$d" && "$VUNA" check . --continue-on-error --json 2>&1'
exit: 1
out-contains: lib/A.vuna
out-contains: lib/B.vuna
# 级联来源在 SARIF 也机器可读。
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = a\n\nmain : Int\nmain = b\n" > "$TMPDIR/m50-cascade.vuna"; "$VUNA" check "$TMPDIR/m50-cascade.vuna" --continue-on-error --error-format sarif 2>&1'
exit: 1
out-contains: "vuna.origin":"cascade"
# 实例搜索候选拒绝原因包含实例头与目标对照。
run: "$VUNA" check corpus/dt_err/25_no_instance.vuna --json 2>&1
exit: 1
out-contains: "reason":"instance head
# 终止性 call matrix：每条调用边带参数位置 + 调用点 span。
run: "$VUNA" check corpus/dt_err/16_nonterm.vuna --json 2>&1
exit: 1
out-contains: "arg":"call at argument position
out-contains: "kind":"call"
# QTT 使用点：线性重复使用错误附每个使用点的 fields.span（name=use）。
run: "$VUNA" check corpus/dt_err/59_linear_twice.vuna --json 2>&1
exit: 1
out-contains: "kind":"span","name":"use"
# 机器格式 i18n：--lang zh 的 JSON 保留英文 message 并附 localizedMessage。
run: "$VUNA" check corpus/dt_err/02_conv.vuna --lang zh --json 2>&1
exit: 1
out-contains: "localizedMessage":
# 元变量创建点：未填洞的诊断附 fields.span name=created（注册表按 meta id 反查）。
run: "$VUNA" check corpus/dt_err/03_hole.vuna --json 2>&1
exit: 1
out-contains: "kind":"span","name":"created"
# M45：签名里自动量化的隐式类型变量不是用户可见 binder —— `f a = a` 与实例方法体内的
# `\a => \b =>` 不报 UN_ShadowedBinder（镜像 base 的 Applicative 实例）。
run: sh -c 'printf "f : a -> a\nf a = a\n\nmain : Int\nmain = f 1\n" > "$TMPDIR/m45-generic-shadow.vuna"'
run: "$VUNA" check -W "$TMPDIR/m45-generic-shadow.vuna" 2>&1
out-not-contains: UN_ShadowedBinder
run: sh -c 'd="$TMPDIR/m45-inst-shadow.vuna"; printf "%s\n" "trait T f where" "  m3 : (a -> b -> c) -> f a -> f b -> f c" "" "instance T Maybe where" "  m3 f (Just a) (Just b) = Just (f a b)" "  m3 _ _ _ = Nothing" "" "main : Int" "main = 0" > "$d"'
run: "$VUNA" check -W "$TMPDIR/m45-inst-shadow.vuna" 2>&1
out-not-contains: UN_ShadowedBinder
# 对照：两个运行时 binder 真遮蔽仍然告警（corpus/dt_err/43_shadowed_binder 也覆盖）。
run: sh -c 'printf "f : Int -> Int\nf x = let\n  x = 1\n  in x\n\nmain : Int\nmain = f 0\n" > "$TMPDIR/m45-real-shadow.vuna"'
run: "$VUNA" check -W "$TMPDIR/m45-real-shadow.vuna" 2>&1
out-contains: [UN_ShadowedBinder]
# M45：单文件 check 支持带 module 头的库模块（不再报 LD_ModuleHeaderInEntryFile）；
# A 的真实遮蔽告警只报本文件，B 的类型错误定位到 B。
run: sh -c 'd="$TMPDIR/m45-mod-file"; rm -rf "$d"; mkdir -p "$d/lib"; printf "[package]\nname = \"m45-mod-file\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "module A where\n\na : Int -> Int\na x = let\n  x = 1\n  in x\n" > "$d/lib/A.vuna"; printf "module B where\n\nb : Int\nb = \"boom\"\n" > "$d/lib/B.vuna"'
run: "$VUNA" check "$TMPDIR/m45-mod-file/lib/A.vuna" 2>&1
exit: 0
out-not-contains: LD_ModuleHeaderInEntryFile
run: "$VUNA" check -W "$TMPDIR/m45-mod-file/lib/A.vuna" 2>&1
out-contains: [UN_ShadowedBinder]
out-not-contains: LD_ModuleHeaderInEntryFile
run: "$VUNA" check "$TMPDIR/m45-mod-file/lib/B.vuna" 2>&1
exit: 1
out-contains: lib/B.vuna:4
out-contains: TC_TypeMismatch
out-not-contains: LD_ModuleHeaderInEntryFile
run: "$VUNA" check "$TMPDIR/m45-mod-file/lib/B.vuna" --continue-on-error 2>&1
exit: 1
out-not-contains: LD_ModuleHeaderInEntryFile

# --fail-fast：多错误恢复只输出首条（与 --max-errors 取小）。
run: sh -c 'printf "a : Int\na = \"x\"\n\nb : Int\nb = a\n\nmain : Int\nmain = b\n" > "$TMPDIR/mff.vuna"; n=$("$VUNA" check "$TMPDIR/mff.vuna" --continue-on-error --error-format human --show-cascade 2>&1 | grep -c "^error"); m=$("$VUNA" check "$TMPDIR/mff.vuna" --continue-on-error --error-format human --show-cascade --fail-fast 2>&1 | grep -c "^error"); [ "$n" -eq 3 ] && [ "$m" -eq 1 ]'
exit: 0
