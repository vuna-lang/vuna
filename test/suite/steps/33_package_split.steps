# 33) M26 包级 split：`vuna compile <pkg> OUTDIR` 走 DT 逐模块 codegen
#     → OUTDIR/<Module>.ml... + Main.ml + build.sh；build.sh 增量编译（无改动不重编；
#     改内容只重编受影响者）。E14：入口 data 也在产物 Main.ml 里。
#     C35：每单元只 `open Vuna_runtime`（无 open 链），跨单元引用全限定（`Unit.name`）；
#     build.sh 的 compile_mod 只列直接依赖，层内并行、每模块 stamp 只含直接依赖。
#     夹具 corpus/packages/[01][0-9]_*/ 先复制到 case 私有 $TMPDIR 并重写 vuna-base。
for-each: corpus/packages/[01][0-9]_*/
  run: mkdir -p "$TMPDIR/pkgs"; dst="$TMPDIR/pkgs/{name}"; rm -rf "$dst"; cp -R "corpus/packages/{name}" "$dst"; find "$dst" -name vuna.toml -exec sed -i 's|^vuna-base = .*|vuna-base = "'"$VUNA_BASE"'"|' {} +
  exit: 0
  run: "$VUNA" compile "$TMPDIR/pkgs/{name}" "$TMPDIR/split-{name}" 2>&1
  exit: 0
  file-exists: $TMPDIR/split-{name}/Main.ml
  file-exists: $TMPDIR/split-{name}/build.sh
  run: bad=$(for ml in "$TMPDIR/split-{name}"/*.ml; do case "$(basename "$ml")" in Vuna_runtime.ml) continue ;; esac; grep -H '^open ' "$ml" 2>/dev/null | grep -v 'open Vuna_runtime$'; done | sed -n '1,3p'); [ -z "$bad" ] || { printf '%s\n' "$bad"; exit 1; }
  exit: 0
  run: cd "$TMPDIR/split-{name}" && mkdir -p bin && sh build.sh bin/prog 2>&1
  exit: 0
  run: "$TMPDIR/split-{name}/bin/prog" 2>&1
  exit: 0
  out-equals-file: corpus/packages/{name}/expected.out
end:
# E14：入口 data 必须进 split 产物 Main.ml（corpus/packages/05_entry_data / 06_entry_trait）。
for-each: corpus/packages/05_entry_data/ corpus/packages/06_entry_trait/
  run: sh -c 'test -f "$TMPDIR/split-{name}/Main.ml"'
  exit: 0
  file-contains: $TMPDIR/split-{name}/Main.ml C_Color_Red
end:
# 增量构建行为用 corpus/packages/01_workspace 的副本验证（编译单元 = sanitizeName 后模块名）。
run: cd "$TMPDIR/split-01_workspace" && sh build.sh bin/prog 2>&1
exit: 0
out-not-contains: compile
run: printf '\n(* M30 incremental probe *)\n' >>"$TMPDIR/split-01_workspace/Vuna_dHello.ml"
exit: 0
run: cd "$TMPDIR/split-01_workspace" && sh build.sh bin/prog 2>&1
exit: 0
out-contains: compile Vuna_dHello
out-not-contains: compile Vuna_runtime
out-not-contains: compile Dep
out-not-contains: compile Prelude
out-not-contains: compile Base_dIO
# C35：跨单元引用必须是 OCaml 限定名 `Unit.name`（旧模型靠 open 链写裸名）。
read: $TMPDIR/split-01_workspace/Main.ml
out-contains: Vuna_dHello.v_Vuna_dHello_dhello
out-contains: Dep.v_Dep_ddepText
out-contains: Dep.C_Dep_dDepTag_DepTagA
out-contains: v_main 0
run: grep -hoE '[A-Z][A-Za-z0-9_]*\.C_[A-Za-z0-9_]+' "$TMPDIR/split-01_workspace"/*.ml | sed -n '1,3p'
out-contains: .C_
run: sh -c '! grep -qE "(^|[^A-Za-z0-9_.])v_Vuna_dHello_dhello" "$TMPDIR/split-01_workspace/Main.ml"'
exit: 0
run: sh -c '! grep -qE "(^|[^A-Za-z0-9_.])C_Dep_dDepTag_DepTagA" "$TMPDIR/split-01_workspace/Main.ml"'
exit: 0
# C35：build.sh 的 compile_mod 只列直接依赖（Vuna_dHello 只列 Vuna_runtime）。
run: grep -E '^compile_mod Vuna_dHello( |$)' "$TMPDIR/split-01_workspace/build.sh" | sed -n '1p' | sed -e 's/^compile_mod Vuna_dHello//' -e 's/[[:space:]]*&[[:space:]]*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
out-equals: Vuna_runtime
run: ml=$(ls "$TMPDIR/split-01_workspace"/*.ml | wc -l); cm=$(grep -c '^compile_mod ' "$TMPDIR/split-01_workspace/build.sh"); [ "$ml" = "$cm" ]
exit: 0
# 每模块一次 compile_mod 调用；多单元层用 `&` + `wait`。
read: $TMPDIR/split-01_workspace/build.sh
out-contains: compile_mod Vuna_dHello Vuna_runtime &
out-contains: wait "$p"