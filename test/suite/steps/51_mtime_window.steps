# 51) mtime 快路径安全窗（`VUNA_CACHE_MTIME=1`）：`prim_fileMtime` 只有秒精度，
#     「同秒 + 同大小」的编辑不能靠 mtime+size 判未变。安全窗（5s）内一律回落内容哈希，
#     所以刚写出的接口即使 mtime/size 都没变也必须被判定失效（回退全量、报出真实错误）。
#     确定性做法：编辑后把 mtime 显式 touch 回记录的秒值（模拟同一秒内两次写）。
run: C="$TMPDIR/mtime-window-cache"; D="$TMPDIR/mtime-window-dep"; R="$TMPDIR/mtime-window-root"; rm -rf "$C" "$D" "$R"; mkdir -p "$D/lib" "$R/app"; printf '[package]\nname = "mtime-window-dep"\n\n[export]\nmodules = ["MDep"]\n\n[dependencies]\nvuna-base = "%s"\n' "$VUNA_BASE" >"$D/vuna.toml"; printf 'module MDep where\n\nexport mVal : Int\nmVal = 1\n' >"$D/lib/MDep.vuna"; printf '[package]\nname = "mtime-window-root"\n\n[dependencies]\nmtime-window-dep = "%s"\nvuna-base = "%s"\n' "$D" "$VUNA_BASE" >"$R/vuna.toml"; printf 'import MDep\n\nmain : Int\nmain = mVal\n' >"$R/app/Main.vuna"; TMPDIR="$C" VUNA_CACHE_MTIME=1 "$VUNA" check "$VUNA_BASE" >/dev/null 2>&1 || { printf 'mtime window warmup: base check failed\n'; exit 1; }; TMPDIR="$C" VUNA_CACHE_MTIME=1 "$VUNA" check "$D" >/dev/null 2>&1 || { printf 'mtime window warmup: dep check failed\n'; exit 1; }; TMPDIR="$C" VUNA_CACHE_MTIME=1 "$VUNA" check "$R" >/dev/null 2>&1 || { printf 'mtime window warmup: root check failed\n'; exit 1; }; f="$D/lib/MDep.vuna"; touch "$f"; sec=$(stat -c %Y "$f"); size=$(stat -c %s "$f"); sed -i 's/mVal : Int/mVal : Bnt/' "$f"; touch -d "@$sec" "$f"; now=$(date +%s); [ "$(stat -c %Y "$f")" = "$sec" ] && [ "$(stat -c %s "$f")" = "$size" ] && [ $((now - sec)) -lt 5 ] || { printf 'mtime window fixture: not same mtime/size within 5s\n'; exit 1; }; if TMPDIR="$C" VUNA_CACHE_MTIME=1 "$VUNA" check "$R" >"$TMPDIR/mt.out" 2>&1; then printf 'mtime window: check passed with stale iface\n'; exit 1; fi
read: $TMPDIR/mt.out
out-contains: Bnt