# 59) `vuna clean-iface`：批量删除 `*.iface` / `.vuna-iface` / `*.iface.*.tmp`，不动源码与
#     其他文件；--dry-run 只报数量；不存在的目录 exit 2。
#     在 $TMPDIR 的 base 副本上验证（unset VUNA_IFACE_DIR，让 iface 写在源码旁）。
run: cp -R "$VUNA_BASE" "$TMPDIR/clean-iface-pkg"
exit: 0
run: unset VUNA_IFACE_DIR; TMPDIR="$TMPDIR/clean-iface-cache" "$VUNA" check "$TMPDIR/clean-iface-pkg" 2>&1
exit: 0
run: printf 'user note\n' >"$TMPDIR/clean-iface-pkg/keep.txt"
exit: 0
run: find "$TMPDIR/clean-iface-pkg" -name '*.iface' | wc -l | tr -d ' ' >"$TMPDIR/iface-before.count"; n=$(cat "$TMPDIR/iface-before.count"); [ "$n" -gt 0 ]
exit: 0
run: "$VUNA" clean-iface --dry-run "$TMPDIR/clean-iface-pkg" 2>&1
exit: 0
out-contains: would remove
run: find "$TMPDIR/clean-iface-pkg" -name '*.iface' | wc -l | tr -d ' '
out-equals-file: $TMPDIR/iface-before.count
run: "$VUNA" clean-iface "$TMPDIR/clean-iface-pkg" 2>&1
exit: 0
out-contains: removed
run: find "$TMPDIR/clean-iface-pkg" -name '*.iface' | wc -l | tr -d ' '
out-equals: 0
run: find "$TMPDIR/clean-iface-pkg" -maxdepth 1 -name '.vuna-iface' | wc -l | tr -d ' '
out-equals: 0
file-exists: $TMPDIR/clean-iface-pkg/keep.txt
run: "$VUNA" clean-iface "$TMPDIR/clean-iface-pkg" 2>&1
exit: 0
out-contains: no iface files
run: "$VUNA" clean-iface "$TMPDIR/no-such-clean-dir" 2>&1
exit: 2
out-contains: no such directory