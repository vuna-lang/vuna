# store-isolated: 断言 [layers] 层约束，使用 case 私有 store。
# 82) 层约束：跨层 import 报 LD_LayerViolation；同层/依赖包/前缀边界放行；
#     manifest 侧三类错误（未加引号的键 / 非法层名 / 层图成环）。
run: sh -c 'S="$TMPDIR/lay"; rm -rf "$S"; mk(){ d="$S/$1"; mkdir -p "$d/lib" "$d/app"; printf "%b" "$2" > "$d/vuna.toml"; }; mk lay1 "[package]\nname = \"lay1\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\n\"L.A\" = []\n\"L.B\" = [\"L.A\"]\n"; mkdir -p "$S/lay1/lib/L/A" "$S/lay1/lib/L/B"; printf "module L.A.One where\n\nimport L.B.Two\n\nexport one : Int\none = two\n" > "$S/lay1/lib/L/A/One.vuna"; printf "module L.B.Two where\n\nexport two : Int\ntwo = 2\n" > "$S/lay1/lib/L/B/Two.vuna"; printf "import L.A.One\n\nmain : Int\nmain = one\n" > "$S/lay1/app/Main.vuna"; mk lay2 "[package]\nname = \"lay2\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\n\"L.A\" = []\n"; mkdir -p "$S/lay2/lib/L/A"; printf "module L.A.One where\n\nimport Base.List\nimport L.A.Helper\n\nexport one : Int\none = helper\n" > "$S/lay2/lib/L/A/One.vuna"; printf "module L.A.Helper where\n\nexport helper : Int\nhelper = 1\n" > "$S/lay2/lib/L/A/Helper.vuna"; printf "import L.A.One\n\nmain : Int\nmain = one\n" > "$S/lay2/app/Main.vuna"; mk lay3 "[package]\nname = \"lay3\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\n\"L.AB\" = []\n"; mkdir -p "$S/lay3/lib/L/ABC" "$S/lay3/lib/L/Z"; printf "module L.ABC.Deep where\n\nimport L.Z.Zed\n\nexport deep : Int\ndeep = zed\n" > "$S/lay3/lib/L/ABC/Deep.vuna"; printf "module L.Z.Zed where\n\nexport zed : Int\nzed = 3\n" > "$S/lay3/lib/L/Z/Zed.vuna"; printf "import L.ABC.Deep\n\nmain : Int\nmain = deep\n" > "$S/lay3/app/Main.vuna"; mk lay4 "[package]\nname = \"lay4\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\nL.A = []\n"; printf "main : Int\nmain = 1\n" > "$S/lay4/app/Main.vuna"; mk lay5 "[package]\nname = \"lay5\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\n\"L.A\" = [\"L.B\"]\n\"L.B\" = [\"L.A\"]\n"; printf "main : Int\nmain = 1\n" > "$S/lay5/app/Main.vuna"; mk lay6 "[package]\nname = \"lay6\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\n\"L-A\" = []\n"; printf "main : Int\nmain = 1\n" > "$S/lay6/app/Main.vuna"; mk lay7 "[package]\nname = \"lay7\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\n\"L\" = []\n\"L.A\" = []\n"; mkdir -p "$S/lay7/lib/L/A" "$S/lay7/lib/L/B"; printf "module L.A.One where\n\nimport L.B.Two\n\nexport one : Int\none = two\n" > "$S/lay7/lib/L/A/One.vuna"; printf "module L.B.Two where\n\nexport two : Int\ntwo = 2\n" > "$S/lay7/lib/L/B/Two.vuna"; printf "import L.A.One\n\nmain : Int\nmain = one\n" > "$S/lay7/app/Main.vuna"; mk lay8 "[package]\nname = \"lay8\"\n\n[dependencies]\nvuna-base = \"$VUNA_BASE\"\n\n[layers]\n\"L.A\" = [\"L-A\"]\n"; printf "main : Int\nmain = 1\n" > "$S/lay8/app/Main.vuna"'
exit: 0

# 跨层 import ⇒ LD_LayerViolation，位置指到 import 行。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay1" 2>&1'
exit: 1
out-contains: LD_LayerViolation
out-contains: L.A.One
out-contains: L.B.Two

# 同层 import + 依赖包 import 放行。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay2" 2>&1'
exit: 0

# 层前缀按段边界匹配：L.AB 不覆盖 L.ABC。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay3" 2>&1'
exit: 0

# 嵌套层取交集：根层放行、更具体的 L.A 收紧 ⇒ 越层。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay7" 2>&1'
exit: 1
out-contains: LD_LayerViolation

# 违规包仍可 fmt（工具路径不做层检查）。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" fmt "$S/lay1" 2>&1'
exit: 0

# manifest 侧错误：未加引号的键。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay4" 2>&1'
exit: 1
out-contains: PKG_LayerKeyMustBeQuoted

# manifest 侧错误：非法层名。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay6" 2>&1'
exit: 1
out-contains: PKG_LayerInvalidName

# manifest 侧错误：层图成环。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay5" 2>&1'
exit: 1
out-contains: PKG_LayerCycle

# manifest 侧错误：层目标不是合法模块前缀。
run: sh -c 'S="$TMPDIR/lay"; VUNA_STORE="$S/store" "$VUNA" check "$S/lay8" 2>&1'
exit: 1
out-contains: PKG_LayerInvalidTarget
