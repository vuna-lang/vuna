# 59) `vuna clean`：缓存清理入口。接口已并入对象库，所以只有两类目标：
#     --store     对象库根（$VUNA_STORE → XDG → ~/.vuna/store → $TMPDIR/vuna-store）
#     --packages  持久包 store（同一根下的 objects/ + pkgs/），--gc 只删未引用对象
#     不带 flag 时只清 store；--dry-run 只报数量。
run: sh -c 'rm -rf "$TMPDIR/clean-store"; export VUNA_STORE="$TMPDIR/clean-store"; VUNA_IFACE_DIR= "$VUNA" check "$VUNA_BASE" >/dev/null 2>&1; test -d "$VUNA_STORE/objects/iface"'
exit: 0
run: sh -c 'printf "user note\n" >"$TMPDIR/keep.txt"; export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" clean --store --dry-run'
exit: 0
out-contains: would remove
run: sh -c 'export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" clean --store'
exit: 0
out-contains: removed
run: sh -c 'find "$TMPDIR/clean-store" -type f | wc -l | tr -d " "'
out-equals: 0
file-exists: $TMPDIR/keep.txt
run: sh -c 'export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" clean --store'
exit: 0
out-contains: removed 0 file(s)
