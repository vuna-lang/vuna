# 41) workspace 检查/构建单元 + 确定性/增量构建
run: "$VUNA" check corpus/packages/m30_ws_member_error 2>&1
exit: nonzero
out-contains: [bad]
run: "$VUNA" build --out "$TMPDIR/ws1" corpus/packages/m30_ws_build 2>&1
exit: 0
out-contains: skipped (library): member
run: "$TMPDIR/ws1/ws-build/bin/ws-build" 2>&1
exit: 0
out-equals: "hello from member"
run: "$VUNA" build --out "$TMPDIR/ws1" corpus/packages/m30_ws_build 2>&1
out-contains: up to date:
run: "$VUNA" build --package member --out "$TMPDIR/ws-pkg" corpus/packages/m30_ws_build 2>&1
exit: 0
out-contains: skipped (library): member
run: sh -c '"$VUNA" build --out "$TMPDIR/ws2" corpus/packages/m30_ws_build >/dev/null 2>&1 && for f in "$TMPDIR/ws1/ws-build"/*.ml "$TMPDIR/ws1/ws-build/build.sh" "$TMPDIR/ws1/ws-build/build-meta.json"; do cmp -s "$f" "$TMPDIR/ws2/ws-build/$(basename "$f")" || exit 1; done'
exit: 0
# examples/multi：多包 workspace（根包 + 成员库 + base 路径依赖）的 build/test/fmt/doc 冒烟。
# 复制到 case 私有目录并重写 vuna-base 绝对路径，避免往仓库工作树写 .output。
run: rm -rf "$TMPDIR/multi"; cp -R ../examples/multi "$TMPDIR/multi"; find "$TMPDIR/multi" -name vuna.toml -exec sed -i 's|^vuna-base = .*|vuna-base = "'"$VUNA_BASE"'"|' {} +
exit: 0
run: "$VUNA" build "$TMPDIR/multi" 2>&1
exit: 0
run: "$TMPDIR/multi/.output/bin/multi" 2>&1
exit: 0
out-equals: hi hi hi|n2 n1
run: "$VUNA" test "$TMPDIR/multi" 2>&1
exit: 0
out-contains: 1 passed, 0 failed
run: "$VUNA" fmt --check "$TMPDIR/multi" 2>&1
exit: 0
run: "$VUNA" doc "$TMPDIR/multi/greet" "$TMPDIR/api.html" 2>&1
exit: 0
run: grep -q Greet "$TMPDIR/api.html"
exit: 0
