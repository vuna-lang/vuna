# 62) 标签：Args / Stdin / Exit（runArgs / runStdin / runExit 单效应入口）。
run: D="$TMPDIR/p2c-labels"; rm -rf "$D"; mkdir -p "$D/p2c-args/app" "$D/p2c-stdin/app" "$D/p2c-exit/app"; printf '[package]\nname = "p2c-args"\n\n[dependencies]\nvuna-base = "%s"\n' "$VUNA_BASE" >"$D/p2c-args/vuna.toml"; printf 'import Base.Effect.Core as Eff\nimport Base.Effect.Args as EffArgs\nimport Base.Data.List as List\n\nprog : Eff ([ArgsOp]) Int\nprog = do\n  xs <- argsGetArgs\n  pure (natToInt (length xs))\n\nmain : Eff ([ArgsOp]) Int\nmain = prog\n' >"$D/p2c-args/app/Main.vuna"; printf '[package]\nname = "p2c-stdin"\n\n[dependencies]\nvuna-base = "%s"\n' "$VUNA_BASE" >"$D/p2c-stdin/vuna.toml"; printf 'import Base.Effect.Core as Eff\nimport Base.Effect.Stdin as EffStdin\nimport Base.Data.Maybe as Maybe\nimport Base.Data.String as String\n\nprog : Eff ([StdinOp]) (Maybe String)\nprog = stdinReadLine\n\nmain : Eff ([StdinOp]) Int\nmain = do\n  s <- prog\n  pure (case s of\n    Nothing => 0\n    Just line => strLength line)\n' >"$D/p2c-stdin/app/Main.vuna"; printf '[package]\nname = "p2c-exit"\n\n[dependencies]\nvuna-base = "%s"\n' "$VUNA_BASE" >"$D/p2c-exit/vuna.toml"; printf 'import Base.Effect.Core as Eff\nimport Base.Effect.Exit as EffExit\n\nprog : Eff ([ExitOp]) Int\nprog = exitWith 3\n\nmain : Eff ([ExitOp]) Int\nmain = prog\n' >"$D/p2c-exit/app/Main.vuna"
run: "$VUNA" build "$TMPDIR/p2c-labels/p2c-args" >/dev/null 2>&1
run: "$TMPDIR/p2c-labels/p2c-args/.output/bin/p2c-args" 2>&1
out-contains: 0
run: "$VUNA" build "$TMPDIR/p2c-labels/p2c-stdin" >/dev/null 2>&1
run: printf '' | "$TMPDIR/p2c-labels/p2c-stdin/.output/bin/p2c-stdin" 2>&1
out-contains: 0
run: "$VUNA" build "$TMPDIR/p2c-labels/p2c-exit" >/dev/null 2>&1
run: "$TMPDIR/p2c-labels/p2c-exit/.output/bin/p2c-exit" >/dev/null 2>&1
exit: 3