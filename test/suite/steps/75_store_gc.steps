# store-isolated: 断言缓存/对象库行为，使用 case 私有 store。
# 75) `vuna store gc`：缓存族按 roots + 宽限窗口 + 容量上限淘汰。
#     包对象族 `objects/pkg/` 永不进入候选（包对象要靠 fetch 重建，不是缓存）；
#     派生对象删了只影响命中率；views 只能整目录淘汰。

run: sh -c 'rm -rf "$TMPDIR/gc-store"; VUNA_STORE="$TMPDIR/gc-store" "$VUNA" check "$VUNA_BASE" >/dev/null 2>&1; test "$(find "$TMPDIR/gc-store/objects" -type f | wc -l)" -gt 0'
exit: 0
# check 会在 roots/<项目>/ 下写逐摘要文件（GC 的保留集合）。
run: sh -c 'test -d "$TMPDIR/gc-store/roots" && test -n "$(find "$TMPDIR/gc-store/roots" -type f | head -1)"'
exit: 0
# 包对象：永远不进入候选（靠 fetch 重建，不是缓存）。
run: sh -c 'mkdir -p "$TMPDIR/gc-store/objects/pkg"; printf x >"$TMPDIR/gc-store/objects/pkg/pkgobj"; printf x >"$TMPDIR/gc-store/objects/pkg/keepobj"; touch -d "2020-01-01" "$TMPDIR/gc-store/objects/pkg/pkgobj" "$TMPDIR/gc-store/objects/pkg/keepobj"'
exit: 0
# 宽限窗口内的对象不删（默认 3600s）；包对象即使很旧也不动。
run: sh -c 'VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc'
exit: 0
out-contains: store-gc:
run: sh -c 'test -f "$TMPDIR/gc-store/objects/pkg/pkgobj" && test -f "$TMPDIR/gc-store/objects/pkg/keepobj"'
exit: 0
# 受 roots 保护的缓存对象与 view 留下；未保护的旧 view 删除；包对象一概不动。
run: sh -c 'keep=$(find "$TMPDIR/gc-store/objects/iface" -type f | head -1 | xargs basename); mkdir -p "$TMPDIR/gc-store/roots/project-a" "$TMPDIR/gc-store/views/bin/keepview" "$TMPDIR/gc-store/views/bin/oldview"; : >"$TMPDIR/gc-store/roots/project-a/$keep"; : >"$TMPDIR/gc-store/roots/project-a/keepview"; printf x >"$TMPDIR/gc-store/views/bin/keepview/f"; printf x >"$TMPDIR/gc-store/views/bin/oldview/f"; touch -d "2020-01-01" "$TMPDIR/gc-store/views/bin/keepview/f" "$TMPDIR/gc-store/views/bin/keepview" "$TMPDIR/gc-store/views/bin/oldview/f" "$TMPDIR/gc-store/views/bin/oldview"; VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 >/dev/null 2>&1; test -f "$(find "$TMPDIR/gc-store/objects/iface" -name "$keep" | head -1)" && test -d "$TMPDIR/gc-store/views/bin/keepview" && test ! -d "$TMPDIR/gc-store/views/bin/oldview" && test -f "$TMPDIR/gc-store/objects/pkg/pkgobj" && test -f "$TMPDIR/gc-store/objects/pkg/keepobj"'
exit: 0
# 未受保护的旧对象被删（objects 里文件数不增），dry-run 不改盘。
run: sh -c 'VUNA_STORE="$TMPDIR/gc-store" "$VUNA" check "$VUNA_BASE" >/dev/null 2>&1; n1=$(find "$TMPDIR/gc-store/objects" -type f | wc -l); VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 --dry-run >/dev/null; n2=$(find "$TMPDIR/gc-store/objects" -type f | wc -l); [ "$n1" -eq "$n2" ]'
exit: 0
run: sh -c 'VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 >/dev/null; n=$(find "$TMPDIR/gc-store/objects" -type f | wc -l); [ "$n" -ge 1 ] && test -f "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0