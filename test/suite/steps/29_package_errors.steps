# store-isolated: 断言 build 的“首次构建/错误且不留产物”，不能被已发布视图命中。
# 29) 包模式错误：缺依赖 / 依赖环 / 隐藏模块 / 依赖包歧义 → 非 0、含片段、不留产物。
run: sh -c 'for raw in corpus/packages/9[0-9]_*/ corpus/packages/m31_*/; do [ -d "$raw" ] || continue; dir=${raw%/}; case "$dir" in *95_cross_dep) continue ;; esac; fragment=$(cat "$dir/expected.err"); rm -rf "$dir/.output"; if out=$("$VUNA" build "$dir" 2>&1); then printf "expected failure: %s\n" "$dir"; exit 1; fi; printf "%s" "$out" | grep -qF "$fragment" || { printf "fragment missing: %s\n" "$dir"; exit 1; }; if [ -e "$dir/.output" ]; then printf "output left: %s\n" "$dir"; exit 1; fi; rm -rf "$dir/.output"; done'
exit: 0
