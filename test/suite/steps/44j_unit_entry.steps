# 44j) 单元缓存按 entry 分桶 + GC（S7）：同一包上下文里不同入口文件各占一个桶；切换入口
#      时旧桶被 GC 清掉，同一入口（路径不变、内容变了）重建仍能命中单元缓存。
# 夹具现场生成；缓存落在 case 私有 $TMPDIR 下（原脚本另起 unit-cache-j，此处 case 隔离等价）。
run: mkdir -p "$TMPDIR/unit-entry-pkg"
run: printf '[package]\nname = "unit-entry-pkg"\n\n[dependencies]\nvuna-base = "%s"\n' "$VUNA_BASE" > "$TMPDIR/unit-entry-pkg/vuna.toml"
run: printf 'main : Int\nmain = 1\n' > "$TMPDIR/unit-entry-pkg/A.vuna"
run: printf 'main : Int\nmain = 2\n' > "$TMPDIR/unit-entry-pkg/B.vuna"
run: VUNA_UNIT_CACHE=1 "$VUNA" compile "$TMPDIR/unit-entry-pkg/A.vuna" "$TMPDIR/unit-j1"
# 同一入口路径、内容变化后重建：必须命中单元缓存。
run: printf '\n-- probe\n' >> "$TMPDIR/unit-entry-pkg/A.vuna"
run: VUNA_UNIT_CACHE=1 VUNA_DEBUG_PERF=1 "$VUNA" compile "$TMPDIR/unit-entry-pkg/A.vuna" "$TMPDIR/unit-j1" 2>&1
out-contains: unit-cache-hit
# 切到同一包上下文的另一个入口 B：旧桶被 GC 后只剩一个 entry 桶。
run: VUNA_UNIT_CACHE=1 "$VUNA" compile "$TMPDIR/unit-entry-pkg/B.vuna" "$TMPDIR/unit-j2"
run: find "$VUNA_STORE/units" -path "*/units/*/e-*" -name "*.unit" 2>/dev/null | xargs -r -n1 dirname | sort -u | wc -l
out-equals: 1