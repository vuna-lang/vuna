# 44q) 双路径审计（C49 回归）：`VUNA_IFACE_AUDIT=1` 让同一次 check 分别走摘要路径与
#      全量路径并逐字节比较诊断；record-update 定义的载荷必须闭合（旧缺陷：
#      `Core.Term.hasFreeTermVar` 下降 `TRecUpd.body` 时少加 `length tele` 的 binder
#      深度）。写入自检（`VUNA_IFACE_SELFTEST`）随文件层删除已不再存在。
run: sh -c 'mkdir -p "$TMPDIR/c49/pkg/lib" "$TMPDIR/c49/pkg/app"'
run: sh -c 'printf "%s\n" "[package]" "name = \"c49rec\"" "" "[dependencies]" "vuna-base = \"$VUNA_BASE\"" > "$TMPDIR/c49/pkg/vuna.toml"'
run: sh -c 'printf "%s\n" "module C49 where" "" "export record Box(..) where" "  a : Int" "  b : Int" "" "export bump : Box -> Box" "bump x = { x | a = x.a + 1 }" > "$TMPDIR/c49/pkg/lib/C49.vuna"'
run: sh -c 'printf "%s\n" "import C49" "" "main : Int" "main = (bump (Box { a = 1, b = 2 })).a" > "$TMPDIR/c49/pkg/app/Main.vuna"'
# 冷缓存 + 审计：摘要/全量两条路径诊断必须逐字节一致。
run: sh -c 'rm -rf "$TMPDIR/c49/store" "$TMPDIR/c49/cache"; VUNA_STORE="$TMPDIR/c49/store" TMPDIR="$TMPDIR/c49/cache" VUNA_IFACE_AUDIT=1 "$VUNA" check "$TMPDIR/c49/pkg" --debug-perf 2>&1'
exit: 0
out-contains: iface-audit subject=check
out-not-contains: iface-audit-mismatch
# 热缓存 + 审计：审计绕过判定重跑两条路径，仍然一致。
run: sh -c 'VUNA_STORE="$TMPDIR/c49/store" TMPDIR="$TMPDIR/c49/cache" VUNA_IFACE_AUDIT=1 "$VUNA" check "$TMPDIR/c49/pkg" --debug-perf 2>&1'
exit: 0
out-not-contains: iface-audit-mismatch
# 正常路径（不带审计）冷缓存也通过。
run: sh -c 'rm -rf "$TMPDIR/c49/cache"; VUNA_STORE="$TMPDIR/c49/store" TMPDIR="$TMPDIR/c49/cache" "$VUNA" check "$TMPDIR/c49/pkg"'
exit: 0
