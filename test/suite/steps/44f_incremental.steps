# store-isolated: 断言缓存/对象库行为，使用 case 私有 store。
# 44f) 包内逐模块增量：复制 base，改一个叶子模块后重算——其余模块复用、只 parse
#      改动模块、第二次运行收敛（全部干净、零重写）、manifest 与全量路径逐字节一致，
#      注入类型错误后增量与全量诊断逐字节一致。
#      夹具：$VUNA_BASE 复制到 $TMPDIR/incr-base（不改工作树）；缓存与临时 TMPDIR 均在 case 私有根下。
run: sh -c 'rm -rf "$TMPDIR/incr-base" "$TMPDIR/incr-cache"; mkdir -p "$TMPDIR/incr-cache"; cp -r "$VUNA_BASE" "$TMPDIR/incr-base"; TMPDIR="$TMPDIR/incr-cache" "$VUNA" check "$TMPDIR/incr-base" >/dev/null 2>&1'
# 改一个叶子模块后带 --debug-perf 重算，日志落盘供后续计数/片段断言。
run: sh -c 'printf "\nincrProbe : Int\nincrProbe = 1\n" >> "$TMPDIR/incr-base/lib/Base/Error.vuna"; TMPDIR="$TMPDIR/incr-cache" "$VUNA" check "$TMPDIR/incr-base" --debug-perf > "$TMPDIR/incr.log" 2>&1'
# 0 < cache-own-clean < 模块总数（总数取 iface-write=N/M 的 M；内容寻址下目录文件数不可靠）。
run: sh -c 'log="$TMPDIR/incr.log"; total=$(grep -o "iface-write=[0-9]*/[0-9]*" "$log" | head -1 | cut -d/ -f2); clean=$(sed -n "s/.*cache-own-clean=\([0-9][0-9]*\).*/\1/p" "$log"); [ -n "$clean" ] && [ -n "$total" ] && [ "$total" -gt 0 ] && [ "$clean" -lt "$total" ]'
# 只 parse 脏模块：parse-module 行数 == total - clean。
run: sh -c 'log="$TMPDIR/incr.log"; total=$(grep -o "iface-write=[0-9]*/[0-9]*" "$log" | head -1 | cut -d/ -f2); clean=$(sed -n "s/.*cache-own-clean=\([0-9][0-9]*\).*/\1/p" "$log"); parse=$(grep -c "parse-module=Base\." "$log" || true); [ "$parse" -eq "$((total - clean))" ]'
# 改动模块被写回：iface-write >= 1。
run: sh -c 'log="$TMPDIR/incr.log"; writes=$(grep -o "iface-write=[0-9]*" "$log" | head -1 | cut -d= -f2); [ -n "$writes" ] && [ "$writes" -ge 1 ]'
# 删掉 check 缓存后重跑：全部命中 clean、对象库零新增（收敛）。
# 断言用「对象文件数不变」而不是 `iface-write=0/`：完全命中时写侧会走
# `iface-skip partial`（没有脏模块产出的接口可写），两者是同一件事的两种表述。
run: sh -c 'rm -rf "$VUNA_STORE"/query; n1=$(find "$VUNA_STORE/objects/module-iface" -type f 2>/dev/null | wc -l); TMPDIR="$TMPDIR/incr-cache" "$VUNA" check "$TMPDIR/incr-base" --debug-perf > "$TMPDIR/incr2.log" 2>&1; n2=$(find "$VUNA_STORE/objects/module-iface" -type f 2>/dev/null | wc -l); [ "$n1" -eq "$n2" ]'
run: sh -c 'log="$TMPDIR/incr2.log"; grep -qE "cache-path=" "$log"'
# 注入类型错误：增量路径与全量路径（VUNA_ELAB_FULL=1）的诊断（去掉 DEBUG 行）逐字节一致。
run: sh -c 'printf "\nbadProbe : Int\nbadProbe = \"x\"\n" >> "$TMPDIR/incr-base/lib/Base/Error.vuna"'
run: sh -c 'TMPDIR="$TMPDIR/incr-cache" "$VUNA" check "$TMPDIR/incr-base" > "$TMPDIR/incr-bad.log" 2>&1'
exit: nonzero
run: sh -c 'TMPDIR="$TMPDIR/incr-bad-full" VUNA_ELAB_FULL=1 "$VUNA" check "$TMPDIR/incr-base" > "$TMPDIR/incr-bad-full.log" 2>&1'
exit: nonzero
run: sh -c 'grep -vE "^DEBUG " "$TMPDIR/incr-bad.log" > "$TMPDIR/incr-bad-diag"; grep -vE "^DEBUG " "$TMPDIR/incr-bad-full.log" > "$TMPDIR/incr-bad-full-diag"'
read: $TMPDIR/incr-bad-diag
out-contains: TC_TypeMismatch
out-equals-file: $TMPDIR/incr-bad-full-diag
# 依赖排在本模块**之后**（A < Z）时也必须失效：A `export module Z`，Z 新增导出后
# Main 要能立刻用上。旧实现按模块名排序分配依赖地址，前向边停在 `ext:` 哨兵，
# A 的接口地址不随 Z 变化 ⇒ 读到陈旧 A 接口（unbound variable）。
run: sh -c 'rm -rf "$TMPDIR/stale-direct" "$TMPDIR/stale-store1"; mkdir -p "$TMPDIR/stale-direct/lib" "$TMPDIR/stale-direct/app"; printf "[package]\nname = \"staledirect\"\n" > "$TMPDIR/stale-direct/vuna.toml"; printf "module A where\n\nexport module Z\n" > "$TMPDIR/stale-direct/lib/A.vuna"; printf "module Z where\n\nexport zx : Int\nzx = 1\n" > "$TMPDIR/stale-direct/lib/Z.vuna"; printf "import A\n\nmain : Int\nmain = zx\n" > "$TMPDIR/stale-direct/app/Main.vuna"; VUNA_STORE="$TMPDIR/stale-store1" "$VUNA" check "$TMPDIR/stale-direct" >/dev/null 2>&1'
run: sh -c 'printf "module Z where\n\nexport zx : Int\nzx = 1\n\nexport zy : Int\nzy = 2\n" > "$TMPDIR/stale-direct/lib/Z.vuna"; printf "import A\n\nmain : Int\nmain = zy\n" > "$TMPDIR/stale-direct/app/Main.vuna"; VUNA_STORE="$TMPDIR/stale-store1" "$VUNA" check "$TMPDIR/stale-direct" 2>&1'
exit: 0
# 传递重导出：A → B → Z，只有 Z 的源变化（B 的源不变，A 的地址也不会变）⇒
# 靠候选接口记录的 `miDepHashes` 与当前地址表比对把 A 判脏。
run: sh -c 'rm -rf "$TMPDIR/stale-trans" "$TMPDIR/stale-store2"; mkdir -p "$TMPDIR/stale-trans/lib" "$TMPDIR/stale-trans/app"; printf "[package]\nname = \"staletrans\"\n" > "$TMPDIR/stale-trans/vuna.toml"; printf "module A where\n\nexport module B\n" > "$TMPDIR/stale-trans/lib/A.vuna"; printf "module B where\n\nexport module Z\n" > "$TMPDIR/stale-trans/lib/B.vuna"; printf "module Z where\n\nexport zx : Int\nzx = 1\n" > "$TMPDIR/stale-trans/lib/Z.vuna"; printf "import A\n\nmain : Int\nmain = zx\n" > "$TMPDIR/stale-trans/app/Main.vuna"; VUNA_STORE="$TMPDIR/stale-store2" "$VUNA" check "$TMPDIR/stale-trans" >/dev/null 2>&1'
run: sh -c 'printf "module Z where\n\nexport zx : Int\nzx = 1\n\nexport zy : Int\nzy = 2\n" > "$TMPDIR/stale-trans/lib/Z.vuna"; printf "import A\n\nmain : Int\nmain = zy\n" > "$TMPDIR/stale-trans/app/Main.vuna"; VUNA_STORE="$TMPDIR/stale-store2" "$VUNA" check "$TMPDIR/stale-trans" 2>&1'
exit: 0
