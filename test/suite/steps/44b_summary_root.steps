# 44b) 根包（入口-only 包，没有 lib 模块接口可写）：依赖接口命中 ⇒ 摘要路径
#      （`cache-path=summary deps=2`：vuna-base + dep）；依赖模块**不再 parse 源码**
#      （无 `parse-module=Dep`）；check 通过。夹具 corpus/packages/m34_summary/root。
run: sh -c 'mkdir -p "$TMPDIR/summary-cache"'
run: sh -c 'TMPDIR="$TMPDIR/summary-cache" "$VUNA" check "$VUNA_BASE"'
run: sh -c 'TMPDIR="$TMPDIR/summary-cache" "$VUNA" check corpus/packages/m34_summary/dep'
run: TMPDIR="$TMPDIR/summary-cache" VUNA_IFACE_SELFTEST=1 "$VUNA" check corpus/packages/m34_summary/root --debug-perf
exit: 0
out-contains: cache-path=summary deps=2
out-not-contains: parse-module=Dep

# 44b-2) mtime 快路径：独立缓存里以 `VUNA_CACHE_MTIME=1` 预热 base/dep 后，根包仍命中
#        摘要路径（读侧用 mtime+size 快判；写侧仍存内容哈希）。
run: sh -c 'mkdir -p "$TMPDIR/summary-mtime-cache"'
run: sh -c 'TMPDIR="$TMPDIR/summary-mtime-cache" VUNA_CACHE_MTIME=1 "$VUNA" check "$VUNA_BASE"'
run: sh -c 'TMPDIR="$TMPDIR/summary-mtime-cache" VUNA_CACHE_MTIME=1 "$VUNA" check corpus/packages/m34_summary/dep'
run: TMPDIR="$TMPDIR/summary-mtime-cache" VUNA_CACHE_MTIME=1 "$VUNA" check corpus/packages/m34_summary/root --debug-perf
exit: 0
out-contains: cache-path=summary deps=2