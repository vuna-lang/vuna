# 52) C32 收口：所有缓存载荷统一 `Store` framing
#     `vuna-cache-frame 2|tag|codec|len|内容地址\n<payload>`，载荷是显式规范编码（不再是
#     OCaml Marshal）。截断（len 不符）、篡改（内容地址不符）、codec/tag 不符都必须被读侧
#     拒绝 ⇒ 回退重算、不崩，且缓存文件被重写成合法 framing。
#     单字节篡改用 dd 打在载荷中部（不是头部，避免只靠 magic 就过）。
#     阶段 2 起 codegen 产物落在**内容寻址 blob**（`$TMPDIR/vuna-cache/blobs/<digest>`），
#     图节点 `split:<pkg>:<kind>` 只存地址；坏字节的后果是「该地址读不出 ⇒ 重算并写回
#     同一路径」。单元缓存（`PerfCache`）仍是独立目录，一并断言 framing。
#     夹具 corpus/packages/m34_summary 复制到 $TMPDIR（不改工作树），副本内所有
#     vuna.toml 的 `vuna-base =` 行重写为 $VUNA_BASE。
run: sh -c 'rm -rf "$TMPDIR/c32-pkg" "$TMPDIR/c32-cache" "$TMPDIR/c32-clean" "$TMPDIR/c32-out2"; cp -r corpus/packages/m34_summary "$TMPDIR/c32-pkg"; for mf in "$TMPDIR/c32-pkg"/*/vuna.toml; do sed -i "s|^vuna-base = .*|vuna-base = \"$VUNA_BASE\"|" "$mf"; done; TMPDIR="$TMPDIR/c32-cache" "$VUNA" build --no-compile --out "$TMPDIR/c32-clean" "$TMPDIR/c32-pkg/root" >/dev/null 2>&1'
run: sh -c 'blob=$(find "$TMPDIR/c32-cache"/vuna-cache/blobs -type f 2>/dev/null | head -1); [ -n "$blob" ] && printf "%s" "$blob" > "$TMPDIR/c32-blob-path"'
run: sh -c 'unit=$(find "$TMPDIR/c32-cache"/vuna-cache -path "*/split-units/*" -type f 2>/dev/null | head -1); [ -n "$unit" ] && printf "%s" "$unit" > "$TMPDIR/c32-unit-path"'
# 52a) 产物 blob 的 framing 头：magic 是 v2，tag 带 split-node schema 1，codec 是 split-files 1。
run: sh -c 'blob=$(cat "$TMPDIR/c32-blob-path"); head -c 18 "$blob"'
out-equals: vuna-cache-frame 2
run: sh -c 'blob=$(cat "$TMPDIR/c32-blob-path"); head -1 "$blob" | cut -d"|" -f2 | cut -d"/" -f1'
out-equals: vuna-split-node 1
run: sh -c 'blob=$(cat "$TMPDIR/c32-blob-path"); head -1 "$blob" | cut -d"|" -f3'
out-equals: split-files 1
# 52a2) 单元缓存（PerfCache）的 framing 头：tag 带 unit-cache schema 2，codec 是 split-file 1。
run: sh -c 'unit=$(cat "$TMPDIR/c32-unit-path"); head -c 18 "$unit"'
out-equals: vuna-cache-frame 2
run: sh -c 'unit=$(cat "$TMPDIR/c32-unit-path"); head -1 "$unit" | cut -d"|" -f2 | cut -d"/" -f1'
out-equals: vuna-unit-cache 2
run: sh -c 'unit=$(cat "$TMPDIR/c32-unit-path"); head -1 "$unit" | cut -d"|" -f3'
out-equals: split-file 1
# 52b) 截断：全部 blob 只留前 4096 字节（头行完整、载荷少一截）⇒ len/内容地址校验拒绝
#      ⇒ 重算并重写同一路径。产物**文件集**必须与干净构建一致；逐字节一致性受既有的
#      「全量 vs 增量 codegen」差异影响（debt C51），不在本条断言范围内。
run: sh -c 'for f in $(find "$TMPDIR/c32-cache"/vuna-cache/blobs -type f); do head -c 4096 "$f" > "$f.part"; mv "$f.part" "$f"; done; TMPDIR="$TMPDIR/c32-cache" "$VUNA" build --no-compile --out "$TMPDIR/c32-out2" "$TMPDIR/c32-pkg/root" >/dev/null 2>&1'
run: sh -c '(cd "$TMPDIR/c32-clean" && find . -type f | LC_ALL=C sort) > "$TMPDIR/names-clean"; (cd "$TMPDIR/c32-out2" && find . -type f | LC_ALL=C sort) > "$TMPDIR/names-out2"; diff "$TMPDIR/names-clean" "$TMPDIR/names-out2"'
# 52c) 篡改：在每个 blob 的载荷中部改一个字节（长度不变，内容地址必须拒绝）⇒ 重建成功。
run: sh -c 'for f in $(find "$TMPDIR/c32-cache"/vuna-cache/blobs -type f); do off=$(( $(stat -c %s "$f") / 2 )); printf "X" | dd of="$f" bs=1 seek="$off" conv=notrunc 2>/dev/null; done; TMPDIR="$TMPDIR/c32-cache" "$VUNA" build --no-compile --out "$TMPDIR/c32-out2" "$TMPDIR/c32-pkg/root" >/dev/null 2>&1'
run: sh -c 'blob=$(cat "$TMPDIR/c32-blob-path"); head -c 18 "$blob"'
out-equals: vuna-cache-frame 2
# 52d) check 结果：阶段 2 起是**查询图节点**（`check:<pkg>:<kind>`，值 = QMarker），
#      落在 `$TMPDIR/vuna-cache/query/<包桶>/index`（`Store` framing，codec `query-index 1`）。
#      截断索引后必须视为未命中（重算并覆盖），不能静默当成功。
run: sh -c 'rm -rf "$TMPDIR/c32-check-cache"; TMPDIR="$TMPDIR/c32-check-cache" "$VUNA" check "$TMPDIR/c32-pkg/dep" >/dev/null 2>&1; TMPDIR="$TMPDIR/c32-check-cache" "$VUNA" check "$TMPDIR/c32-pkg/root" >/dev/null 2>&1'
run: sh -c 'ok=1; n=0; for f in $(find "$TMPDIR/c32-check-cache"/vuna-cache/query -type f 2>/dev/null); do n=$((n + 1)); [ "$(head -c 18 "$f")" = "vuna-cache-frame 2" ] || ok=0; [ "$(head -1 "$f" | cut -d"|" -f3)" = "query-index 1" ] || ok=0; done; [ "$n" -ge 2 ] && [ "$ok" -eq 1 ]'
run: sh -c 'for f in $(find "$TMPDIR/c32-check-cache"/vuna-cache/query -type f 2>/dev/null); do head -c 40 "$f" > "$f.part"; mv "$f.part" "$f"; done; TMPDIR="$TMPDIR/c32-check-cache" VUNA_DEBUG_PERF=1 "$VUNA" check "$TMPDIR/c32-pkg/dep" 2>&1 | tee "$TMPDIR/c32-check.log"'
out-contains: query-miss check:dep:lib:
run: sh -c 'ok=1; for f in $(find "$TMPDIR/c32-check-cache"/vuna-cache/query -type f 2>/dev/null); do [ "$(head -c 18 "$f")" = "vuna-cache-frame 2" ] || ok=0; done; [ "$ok" -eq 1 ]'
# 52e) lex 缓存：全部截断后照常 lex 并重写（旧 Marshal 实现会 Marshal.from_string 崩溃）。
run: sh -c 'rm -rf "$TMPDIR/c32-lex-cache"; TMPDIR="$TMPDIR/c32-lex-cache" "$VUNA" check "$TMPDIR/c32-pkg/root" >/dev/null 2>&1; TMPDIR="$TMPDIR/c32-lex-cache" "$VUNA" check "$TMPDIR/c32-pkg/root" >/dev/null 2>&1; list=$(find "$TMPDIR/c32-lex-cache/vuna-cache/lex" -type f 2>/dev/null); [ -n "$list" ] || exit 1; printf "%s\n" "$list" | wc -l | tr -d " " > "$TMPDIR/c32-lex-count"; for f in $list; do head -c 8 "$f" > "$f.part"; mv "$f.part" "$f"; done; rm -rf "$TMPDIR/c32-lex-cache"/vuna-cache/query'
run: sh -c 'TMPDIR="$TMPDIR/c32-lex-cache" "$VUNA" check "$TMPDIR/c32-pkg/root" >/dev/null 2>&1'
run: sh -c 'n=$(cat "$TMPDIR/c32-lex-count"); framed=0; for f in $(find "$TMPDIR/c32-lex-cache/vuna-cache/lex" -type f 2>/dev/null); do [ "$(head -c 18 "$f")" = "vuna-cache-frame 2" ] && framed=$((framed + 1)); done; [ "$framed" -eq "$n" ]'
# 52f) codec 不符：把某个 lex 条目的 codec 改成别的名字（tag/len/内容地址都不动）
#      ⇒ 读侧必须拒绝、重新 lex 并重写同一个文件（路径 = key，内容寻址）。
run: sh -c 'f=$(find "$TMPDIR/c32-lex-cache/vuna-cache/lex" -type f | head -1); printf "%s" "$f" > "$TMPDIR/c32-codec-path"; sed -i "1s/|lex-tokens 1|/|bogus-codec 9|/" "$f"; rm -rf "$TMPDIR/c32-lex-cache"/vuna-cache/query; TMPDIR="$TMPDIR/c32-lex-cache" "$VUNA" check "$TMPDIR/c32-pkg/root" >/dev/null 2>&1'
run: sh -c 'f=$(cat "$TMPDIR/c32-codec-path"); head -1 "$f" | cut -d"|" -f3'
out-equals: lex-tokens 1
