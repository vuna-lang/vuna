# store-isolated: 断言缓存/对象库行为，使用 case 私有 store。
# 44p) 工具写回与整包写共用同一对象地址：LSP 冷启动的单模块写回落在
#      `objects/iface/<输入摘要>`，随后命令行 check 直接复用（零重写、无 miss）。
#      旧的 `meOrigin`（pkg/tool 隔离）随文件层与 manifest 一起删除 —— 地址由输入决定，
#      谁写的都一样。
#      夹具 corpus/packages/m34_iface_audit 复制到 $TMPDIR，vuna.toml 的 base 改到本仓库。
run: sh -c 'rm -rf "$TMPDIR/org-pkg" "$TMPDIR/org-store" "$TMPDIR/org-cache"; cp -R corpus/packages/m34_iface_audit "$TMPDIR/org-pkg"'
run: sh -c 'for mf in "$TMPDIR/org-pkg"/*/vuna.toml; do sed "s|vuna-base = \"[^\"]*\"|vuna-base = \"$VUNA_BASE\"|" "$mf" > "$mf.tmp" && mv "$mf.tmp" "$mf"; done'
run: sh -c 'VUNA_STORE="$TMPDIR/org-store" TMPDIR="$TMPDIR/org-cache" "$VUNA" check "$TMPDIR/org-pkg/dep" && VUNA_STORE="$TMPDIR/org-store" TMPDIR="$TMPDIR/org-cache" "$VUNA" check "$TMPDIR/org-pkg/mid"'
exit: 0
# LSP 冷启动：清掉临时 store 里本包相关对象，让 LSP 走单模块精化并写回。
# LSP 冷启动：不清 store（复用预热好的依赖对象），只清 LSP 侧缓存。
run: sh -c 'mkdir -p "$TMPDIR/org-lsp-cache"'
# 构造 JSON-RPC 帧（每行一个紧凑 JSON；text 里换行必须是转义序列 \n）。
run: pkg="$TMPDIR/org-pkg/mid"; src="$pkg/lib/Mid.vuna"; { jq -cn --arg uri "file://$pkg" '{jsonrpc:"2.0",id:1,method:"initialize",params:{rootUri:$uri,capabilities:{}}}'; jq -cn '{jsonrpc:"2.0",method:"initialized",params:{}}'; jq -cn --arg uri "file://$src" --rawfile text "$src" '{jsonrpc:"2.0",method:"textDocument/didOpen",params:{textDocument:{uri:$uri,languageId:"vuna",version:1,text:$text}}}'; jq -cn '{jsonrpc:"2.0",id:2,method:"shutdown"}'; jq -cn '{jsonrpc:"2.0",method:"exit"}'; } > "$TMPDIR/lsp-org.jsonl"; LC_ALL=C awk '{ printf "Content-Length: %d\r\n\r\n%s", length($0), $0 }' "$TMPDIR/lsp-org.jsonl" > "$TMPDIR/lsp-org.frames"
run: sh -c 'VUNA_STORE="$TMPDIR/org-store" TMPDIR="$TMPDIR/org-lsp-cache" "$VUNA" lsp < "$TMPDIR/lsp-org.frames" > /dev/null 2>&1'
exit: 0
# LSP 写回产生了对象。
run: sh -c 'test -d "$TMPDIR/org-store/objects/iface"'
exit: 0
# 命令行 check 复用这些对象：包级判定若命中则直接通过；未命中时也不应出现
# 「依赖接口缺件 ⇒ 全量回退」的信号。
run: sh -c 'VUNA_STORE="$TMPDIR/org-store" TMPDIR="$TMPDIR/org-cache" "$VUNA" check "$TMPDIR/org-pkg/mid" --debug-perf 2>&1'
exit: 0
out-not-contains: iface-miss
