# 44k) M34.6 工具链惰性闭包完整性（默认开启）：同包模块自己 import 的依赖包模块必须
#      进闭包（否则 Loader 从源码加载它们却没有 artifact，假报 TC_UnknownName）；本包
#      manifest 缺失/新增模块时安全阀回退全量，诊断仍正确。
# 夹具现场生成在 case 私有 $TMPDIR（vuna-base 直接指 $VUNA_BASE）。
run: mkdir -p "$TMPDIR/iface-k-dep/lib" "$TMPDIR/iface-k-root/lib" "$TMPDIR/iface-k-root/app"
run: printf '[package]\nname = "iface-k-dep"\n\n[export]\nmodules = ["KDep"]\n\n[dependencies]\nvuna-base = "%s"\n' "$VUNA_BASE" > "$TMPDIR/iface-k-dep/vuna.toml"
run: printf 'module KDep (kdepVal, KBox(..), unKBox) where\n\ndata KBox : Type where\n  MkKBox : Int -> KBox\n\nunKBox : KBox -> Int\nunKBox (MkKBox n) = n\n\nkdepVal : Int\nkdepVal = 42\n' > "$TMPDIR/iface-k-dep/lib/KDep.vuna"
run: printf '[package]\nname = "iface-k-root"\n\n[dependencies]\niface-k-dep = "%s"\nvuna-base = "%s"\n' "$TMPDIR/iface-k-dep" "$VUNA_BASE" > "$TMPDIR/iface-k-root/vuna.toml"
run: printf 'module KInner (innerVal) where\n\nimport KDep\n\ninnerVal : Int\ninnerVal = kdepVal\n' > "$TMPDIR/iface-k-root/lib/KInner.vuna"
run: printf 'module KOuter (outerVal) where\n\nimport KInner\n\nouterVal : Int\nouterVal = innerVal + 1\n' > "$TMPDIR/iface-k-root/lib/KOuter.vuna"
run: printf 'import KOuter\n\nmain : Int\nmain = outerVal\n' > "$TMPDIR/iface-k-root/app/Main.vuna"
# 预热依赖/本包接口。
run: "$VUNA" check "$VUNA_BASE"
run: "$VUNA" check "$TMPDIR/iface-k-dep"
run: "$VUNA" check "$TMPDIR/iface-k-root"
# 默认（惰性闭包）：同包模块自己 import 的依赖模块必须进闭包，REPL 能求值出 43。
run: cd "$TMPDIR/iface-k-root" && printf 'import KOuter\nouterVal\n:q\n' | VUNA_DEBUG_PERF=1 "$VUNA" repl 2>&1
out-contains: iface-tool-lazy modules=
out-contains: 43
out-not-contains: TC_UnknownName
# 全量路径对照。
run: cd "$TMPDIR/iface-k-root" && printf 'import KOuter\nouterVal\n:q\n' | VUNA_IFACE_TOOL=0 "$VUNA" repl 2>&1
out-contains: 43
# 依赖包的 data/ctor 在接口路径下必须能被 REPL 表达式求值看到（S7 组装 DtProgram 时
# 漏补依赖 datas ⇒ `[1,2,3]`/构造子报假 TC_UnknownName）。
run: cd "$TMPDIR/iface-k-root" && printf 'import KDep\nunKBox (MkKBox 7)\n:q\n' | "$VUNA" repl 2>&1
out-contains: 7
out-not-contains: TC_UnknownName
# 安全阀：新增一个不在本包 manifest 里的模块，它的依赖无法从 manifest 闭包推出；
# 加载后必须回退全量（iface-fallback=repl）且结果仍正确。
run: printf 'module KNew (newVal) where\n\nimport KDep\n\nnewVal : Int\nnewVal = kdepVal + 1\n' > "$TMPDIR/iface-k-root/lib/KNew.vuna"
run: cd "$TMPDIR/iface-k-root" && printf 'import KNew\nnewVal\n:q\n' | VUNA_DEBUG_PERF=1 "$VUNA" repl 2>&1
out-contains: iface-fallback=repl missing=
out-contains: 43