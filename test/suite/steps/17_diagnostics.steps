# 17) M9 诊断：穷尽性/模式诊断与退出码（M24 起 interp 与 check/compile 共用 DT 静态诊断）。
#     临时夹具位于 case 私有 $TMPDIR（无 manifest 祖先 → base-only 上下文，base 由 VUNA_BASE 给出）。
run: sh -c 'mkdir -p "$TMPDIR/m9"; printf "%s\n" "data Maybe : Type where" "  Just : Int -> Maybe" "  Nothing : Maybe" "" "f : Maybe -> Int" "f (Just x) = x" "" "main : Int" "main = f Nothing" > "$TMPDIR/m9/loc.vuna"; printf "%s\n" "data Maybe : Type where" "  Just : Int -> Maybe" "  Nothing : Maybe" "" "f : Maybe -> Int" "f (Just x) = x" "" "main : Int" "main = f Nothing" > "/m9/ne_fun.vuna"; printf "%s\n" "data Maybe : Type where" "  Just : Int -> Maybe" "  Nothing : Maybe" "" "g : Maybe -> Int" "g x = case x of" "  Just a => a" "" "main : Int" "main = g Nothing" > "$TMPDIR/m9/ne_case.vuna"; printf "%s\n" "data B : Type where" "  T : B" "  F : B" "" "g : B -> Int" "g x = case x of" "  T => 1" "  _ => 0" "  F => 2" "" "main : Int" "main = g T" > "$TMPDIR/m9/red.vuna"; printf "%s\n" "data Maybe : Type where" "  Just : Int -> Maybe" "  Nothing : Maybe" "" "g : Maybe -> Int" "g x = case x of" "  Just a => a" "  Nothing => 0" "" "main : Int" "main = g Nothing" > "$TMPDIR/m9/ok.vuna"; printf "%s\n" "main : Int" "main = \"oops\"" > "$TMPDIR/m9/type_err.vuna"'
exit: 0
run: "$VUNA" interp "$TMPDIR/m9/loc.vuna" 2>&1
exit: nonzero
out-contains: case is not exhaustive
run: "$VUNA" compile "$TMPDIR/m9/loc.vuna" "$TMPDIR/m9/loc-out" 2>&1
exit: nonzero
out-contains: case is not exhaustive
file-absent: $TMPDIR/m9/loc-out
run: "$VUNA" check "$TMPDIR/m9/ne_case.vuna" 2>&1
exit: nonzero
out-contains: case is not exhaustive
run: "$VUNA" check "$TMPDIR/m9/ne_fun.vuna" 2>&1
exit: nonzero
run: "$VUNA" check "$TMPDIR/m9/red.vuna" 2>&1
exit: nonzero
out-contains: catch-all branch must be the last one
run: "$VUNA" check "$TMPDIR/m9/ok.vuna" 2>&1
exit: 0
out-equals:
run: "$VUNA" check "$TMPDIR/m9/type_err.vuna" 2>&1
exit: nonzero
run: "$VUNA" compile "$TMPDIR/m9/type_err.vuna" "$TMPDIR/m9/type_err-out" 2>&1
exit: nonzero
file-absent: $TMPDIR/m9/type_err-out
# 15b) 工作区机器格式：stdout 恰好一份 JSON 文档（成员包不再各打一份）。
run: sh -c 'out=$("$VUNA" check --json "$VUNA_SUITE_ROOT/test/corpus/packages/m30_ws_member_error" 2>/dev/null); rc=$?; [ "$rc" -ne 0 ] || exit 1; n=$(printf "%s" "$out" | grep -o "\"version\":1" | wc -l); [ "$n" -eq 1 ] || { printf "json docs=%s\n" "$n"; exit 1; }; printf "%s" "$out" | grep -q "TC_TypeMismatch"'
exit: 0

# 15c) 纯显示配置（[diagnostics]）不进语义缓存身份：改 format 后 check 仍命中。
run: sh -c 'set -e; d="$TMPDIR/diagcfg"; rm -rf "$d"; cp -R "$VUNA_SUITE_ROOT/test/corpus/packages/01_workspace" "$d"; sed -i "s|../../../../base|$VUNA_SUITE_ROOT/base|" "$d/vuna.toml"; VUNA_DEBUG_PERF=1 "$VUNA" check "$d" >/dev/null 2>&1 || true; printf "\n[diagnostics]\nformat = \"human\"\n" >> "$d/vuna.toml"; err=$(VUNA_DEBUG_PERF=1 "$VUNA" check "$d" 2>&1 >/dev/null); printf "%s" "$err" | grep -q "cache-path=hit"'
exit: 0

# 15d) `--release` 是语义开关：debug 检查过的同一输入，release 不能命中缓存而放行
#      debug-only 构造（assert/todo）。地址缺 release 维度时这里会误判为通过。
run: sh -c 'set -e; d="$TMPDIR/relcheck"; rm -rf "$d"; mkdir -p "$d"; printf "%s\n" "main : Int" "main = assert True \"ok\" 1" > "$d/main.vuna"; "$VUNA" check "$d/main.vuna" >/dev/null 2>&1; if "$VUNA" check --release "$d/main.vuna" >/dev/null 2>&1; then printf "release check hit debug cache\n"; exit 1; fi'
exit: 0

# 15e) 片段列按 UTF-8 码点换算：CJK 行之后的插入符与源码显示列对齐
#      （字节列会多出 8 个空格；这里断言 | 到 ^ 的显示偏移为 19）。
run: sh -c 'set -e; d="$TMPDIR/cjk"; rm -rf "$d"; mkdir -p "$d"; printf "main : String\nmain = \"中文中文\" ++ 1\n" > "$d/a.vuna"; out=$("$VUNA" check "$d/a.vuna" 2>&1 || true); line=$(printf "%s\n" "$out" | grep -F "^" | tail -1); tail=${line#*|}; [ "${#tail}" -eq 19 ]'
exit: 0

# 15f) 失败检查按输入地址 replay：第二次 check 命中缓存，错误与位置逐字一致。
run: sh -c 'set -e; d="$TMPDIR/replay"; rm -rf "$d"; cp -R "$VUNA_SUITE_ROOT/test/corpus/packages/01_workspace" "$d"; sed -i "s|../../../../base|$VUNA_SUITE_ROOT/base|" "$d/vuna.toml"; printf "main : Int\nmain = \"boom\"\n" > "$d/app/Main.vuna"; out1=$("$VUNA" check "$d" 2>&1 || true); err=$("$VUNA" check "$d" --debug-perf 2>&1 >/dev/null || true); printf "%s" "$err" | grep -q "cache-path=hit"; out2=$("$VUNA" check "$d" 2>&1 || true); [ "$out1" = "$out2" ]'
exit: 0

# 15g) 同内容不同目录共享 store：命中后路径按**当前**项目解析，不泄露上一个目录。
run: sh -c 'set -e; roots="$TMPDIR/rp"; rm -rf "$roots"; mkdir -p "$roots"; for n in a b; do d="$roots/$n"; cp -R "$VUNA_SUITE_ROOT/test/corpus/packages/01_workspace" "$d"; sed -i "s|../../../../base|$VUNA_SUITE_ROOT/base|" "$d/vuna.toml"; printf "main : Int\nmain = \"boom\"\n" > "$d/app/Main.vuna"; done; "$VUNA" check "$roots/a" >/dev/null 2>&1 || true; out=$("$VUNA" check "$roots/b" 2>&1 || true); printf "%s" "$out" | grep -q "$roots/b/app/Main.vuna"; if printf "%s" "$out" | grep -q "$roots/a/app/Main.vuna"; then exit 1; fi'
exit: 0

# 15h) 坏载荷只降级为 miss：篡改 check 对象后仍能重算并给出正确诊断。
run: sh -c 'set -e; d="$TMPDIR/corrupt"; st="$TMPDIR/corrupt-store"; rm -rf "$d" "$st"; cp -R "$VUNA_SUITE_ROOT/test/corpus/packages/01_workspace" "$d"; sed -i "s|../../../../base|$VUNA_SUITE_ROOT/base|" "$d/vuna.toml"; printf "main : Int\nmain = \"boom\"\n" > "$d/app/Main.vuna"; VUNA_STORE="$st" "$VUNA" check "$d" >/dev/null 2>&1 || true; obj=$(find "$st/objects/check" -type f | head -1); printf "garbage" > "$obj"; out=$(VUNA_STORE="$st" "$VUNA" check "$d" 2>&1 || true); printf "%s" "$out" | grep -q "TC_TypeMismatch"'
exit: 0

# 15i) --error-format=github：一行一条 workflow annotation，位置来自结构化 span。
run: sh -c 'set -e; out=$("$VUNA" check --error-format github "$VUNA_SUITE_ROOT/test/corpus/dt_err/01_universe.vuna" 2>&1 || true); printf "%s" "$out" | grep -q "^::error file=.*01_universe.vuna,line=2,col=7,endLine=2,endColumn=7::\[TC_TypeLevelArg\]"'
exit: 0

# 15j) 诊断默认上限 20；--max-errors=0 不限、=N 截断（JSON 计数）。
run: sh -c 'set -e; d="$TMPDIR/many"; rm -rf "$d"; mkdir -p "$d"; { printf "main : Int\nmain = 1\n"; i=0; while [ $i -lt 30 ]; do printf "@\n"; i=$((i+1)); done; } > "$d/many.vuna"; count() { "$VUNA" check --json "$@" "$d/many.vuna" 2>/dev/null | grep -o severity | wc -l; }; [ "$(count)" -eq 20 ]; [ "$(count --max-errors=0)" -eq 31 ]; [ "$(count --max-errors=3)" -eq 3 ]'
exit: 0
