;; stack-switching 探针：内层 handler 把不匹配的 effect 转发给外层，外层 resume 后
;; 内层再恢复自己的 comp continuation。run = 101。
(module
  (type $ft (func (param i32) (result i32)))
  (type $ct (cont $ft))
  (tag $eff (param i32) (result i32))
  (func $comp (param $x i32) (result i32)
    (i32.add (suspend $eff (local.get $x)) (i32.const 1)))
  (elem declare func $comp $inner)
  (func $inner (param $x i32) (result i32)
    (local $k (ref $ct))
    (local $p i32)
    (local $v i32)
    (block $on (result i32 (ref $ct))
      (resume $ct (on $eff $on) (local.get $x) (cont.new $ct (ref.func $comp)))
      (return))
    (local.set $k)
    (local.set $p)
    (if (i32.eq (local.get $p) (i32.const 1))
      (then
        (block $on1 (result i32 (ref $ct))
          (resume $ct (on $eff $on1) (i32.const 10) (local.get $k))
          (return))
        (drop) (drop) (return (i32.const -1)))
      (else
        (local.set $v (suspend $eff (local.get $p)))
        (block $on2 (result i32 (ref $ct))
          (resume $ct (on $eff $on2) (local.get $v) (local.get $k))
          (return))
        (drop) (drop) (return (i32.const -2))))
    (unreachable))
  (func (export "run") (result i32)
    (local $k (ref $ct))
    (local $p i32)
    (block $out (result i32 (ref $ct))
      (resume $ct (on $eff $out) (i32.const 2) (cont.new $ct (ref.func $inner)))
      (return))
    (local.set $k)
    (local.set $p)
    (block $out2 (result i32 (ref $ct))
      (resume $ct (on $eff $out2) (i32.const 100) (local.get $k))
      (return))
    (drop) (drop) (i32.const -3))
)
