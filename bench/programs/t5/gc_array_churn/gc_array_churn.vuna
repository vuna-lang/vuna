-- 大对象 GC 压力：每轮 fromList 建数组 + Array.set 的 copy-on-write 复制后丢弃。
-- 手写 OCaml 对照见 gc_array_churn.ml（同算法：Array.of_list + Array.copy/set）。
import Base.Container.Array as Array
import Base.Data.List as List
import Base.Data.Nat as Nat

churn : Int -> Int
churn n =
  if n <= 0 then
    0
  else
    let
      a = Array.fromList (range 0 1000)
      b = Array.set a (Nat.fromIntClamp 0) n
    in Nat.toInt (Array.length b) + Array.get b (Nat.fromIntClamp 0) + churn (n - 1)

main : Int
main = churn 8000
