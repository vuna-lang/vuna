-- T2 real：9 状态的状态机，每步按当前状态线性分派（Int `case` 降级为 if 链），
-- 尾递归推进；压分支链布局、`condBranch` 方向与 `_` 兜底臂。
-- 一次 op 是一次状态转移；手写 OCaml 对照见 state_machine.ml（同算法）。
step : Int -> Int -> Int -> Int
step s acc n =
  if n <= 0 then
    acc
  else
    case s of
      0 => step 1 (acc + 1) (n - 1)
      1 => step 2 (acc + 2) (n - 1)
      2 => step 3 (acc + 3) (n - 1)
      3 => step 4 (acc + 5) (n - 1)
      4 => step 5 (acc + 8) (n - 1)
      5 => step 6 (acc + 13) (n - 1)
      6 => step 7 (acc + 21) (n - 1)
      7 => step 8 (acc + 34) (n - 1)
      _ => step (if acc > 1000000 then 0 else 1) (acc + 55) (n - 1)

main : Int
main = step 0 0 5000000
