-- 效应基准：Console handler 的 answer 是 Eff（answer row），每轮额外发一个 Tick。
-- 手写 OCaml 对照见 eff_host.ml（Effect.Deep，同算法）。
import Base.Effect.Core as Eff
import Base.Effect.Console as EffConsole
import Base.Data.Nat as Nat

data TickOp : Type -> Type where
  Tick : Int -> TickOp Int

loop : Nat -> Eff [ConsoleOp@mock] Int
loop 0 = pure 0
loop (Succ m) =
  do
    _ <- consolePrint@mock "x"
    y <- loop m
    pure (y + 1)

ret : Int -> Eff [TickOp] Int
ret a = pure a

opH : (i : Type) -> (o : ConsoleOp i) -> (Eff.resIdx i o -> Eff [TickOp] Int) -> Eff [TickOp] Int
opH i (Print s) k =
  do
    _ <- perform (Tick 1)
    k (natFromInt 0)
opH i (EPrint s) k =
  do
    _ <- perform (Tick 1)
    k 0

main : Int
main =
  runPure (
      handle (joinEffNilOuter (handleConsole "mock" ret opH (loop (natFromInt 5000)))) {
        Tick n k -> k n
      }
    )
