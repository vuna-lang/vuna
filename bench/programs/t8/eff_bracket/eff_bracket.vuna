-- 效应基准：每轮 `bracket` 包一次 perform，测 cleanup 步骤（push/pop）与 do 绑定。
-- 手写 OCaml 对照见 eff_bracket.ml（同算法：尾递归累加，release 直接内联）。
import Base.Effect.Core as Eff
import Base.Data.Nat as Nat

data TickOp : Type -> Type where
  Tick : Int -> TickOp Int

loop : Nat -> Int -> Eff [TickOp] Int
loop 0 acc = pure acc
loop (Succ m) acc =
  do
    x <- bracket (pure 0) (\_ => pure 1) (\_ => perform (Tick 1))
    loop m (acc + x)

main : Int
main =
  runPure (
      handle (loop (natFromInt 10000) 0) {
        Tick n k -> k n
      }
    )
