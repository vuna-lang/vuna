-- 宽 tag 分派：16 个 nullary 构造子，逐轮 next + code（跳转表 / 决策树）。
-- 手写 OCaml 对照见 micro_variant_wide.ml（同形 variant）。
data Tag : Type where
  T0 : Tag
  T1 : Tag
  T2 : Tag
  T3 : Tag
  T4 : Tag
  T5 : Tag
  T6 : Tag
  T7 : Tag
  T8 : Tag
  T9 : Tag
  T10 : Tag
  T11 : Tag
  T12 : Tag
  T13 : Tag
  T14 : Tag
  T15 : Tag

next : Tag -> Tag
next T0 = T1
next T1 = T2
next T2 = T3
next T3 = T4
next T4 = T5
next T5 = T6
next T6 = T7
next T7 = T8
next T8 = T9
next T9 = T10
next T10 = T11
next T11 = T12
next T12 = T13
next T13 = T14
next T14 = T15
next T15 = T0

code : Tag -> Int
code T0 = 0
code T1 = 1
code T2 = 2
code T3 = 3
code T4 = 4
code T5 = 5
code T6 = 6
code T7 = 7
code T8 = 8
code T9 = 9
code T10 = 10
code T11 = 11
code T12 = 12
code T13 = 13
code T14 = 14
code T15 = 15

go : Int -> Tag -> Int -> Int
go k t acc = if k <= 0 then acc else go (k - 1) (next t) (acc + code t)

main : Int
main = go 1000000 T0 0
