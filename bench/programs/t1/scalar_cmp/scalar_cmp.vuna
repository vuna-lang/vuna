-- T1 micro：六种比较关系物化成 0/1（`setcc` + `movzx`），结果累加。
-- 比较结果作为尾调用实参传给下一轮，避免 `IrIf` 把它直接融合成分支；
-- 循环变量保持原子槽，不引入 `let`（wasm 尾调用也能发 `return_call`）。
-- 手写 OCaml 对照见 scalar_cmp.ml（同算法）。
loop : Int -> Bool -> Bool -> Bool -> Bool -> Bool -> Bool -> Int -> Int
loop acc lt le eq ne gt ge n =
  if n <= 0 then
    acc
  else
    loop
      (acc + (if lt then 1 else 0) + (if le then 1 else 0) + (if eq then 1 else 0) + (if ne then 1 else 0) + (if gt then 1 else 0) + (if ge then 1 else 0))
      (n < 500000)
      (n <= 1000000)
      (n == 1500000)
      (n /= 1500000)
      (n > 1200000)
      (n >= 1800000)
      (n - 1)

main : Int
main = loop 0 True True True True True True 2000000
