-- Nat 饱和算术与位运算：Nat 结构递归 + 截断减法 / 负数夹取 + 63-bit 逻辑移位 / 异或。
-- 手写 OCaml 对照见 nat_bits.ml（同算法）。
import Base.Data.Bits as Bits
import Base.Data.Nat as Nat

loop : Nat -> Nat -> Nat
loop acc 0 = acc
loop acc (Succ k) = loop (Nat.plus acc (Nat.mult k (Nat.fromInt 3))) k

rotr : Int -> Int -> Int
rotr x k = if k <= 0 then x else rotr (bxor (shr x 1) (shl (band x 1) 62)) (k - 1)

main : Int
main =
  let
    n = Nat.toInt (Nat.minus (loop 0 (Nat.fromInt 800000)) (Nat.fromInt 3))
    m = Nat.toInt (Nat.fromInt (0 - 7))
    r = rotr 123456789 64
  in n + band r 65535 + m
