-- 文本扫描：strAt / strLength 逐字节读取并累积（不经过 List 桥接）；fuel 保证终止。
-- 手写 OCaml 对照见 text_scan.ml（同算法）。
scan : Int -> String -> Int -> Int -> Int -> Int
scan fuel s i n acc =
  if fuel <= 0 then
    acc
  else if i >= n then
    acc
  else
    let
      next = acc * 31 + strAt s i
    in scan (fuel - 1) s (i + 1) n (next - next / 1000003 * 1000003)

-- 尾递归累积分片，再用一次 strConcatMany；避免 `repeat` 的非尾 `range`/`map` 在
-- wasm 的 1 MB 栈上溢出（`repeat` 本身仍由 string_ops 覆盖）。
chunks : Int -> List String -> List String
chunks k acc = if k <= 0 then acc else chunks (k - 1) ("0123456789" :: acc)

main : Int
main =
  let
    s = strConcatMany (chunks 16000 [])
  in scan (strLength s) s 0 (strLength s) 0
