-- HashSet 基准：Int 键的 insert / remove / member / size（1024 桶持久集合）。
-- 键序列 scramble(k) = k*7919 mod 100003（7919 与 100003 互素，N 内无重复）。
-- 手写 OCaml 对照用标准库 Hashtbl（见 hashset.ml）。
-- ops = 容器操作次数（insert N + remove N + member N）。
import Base.Container.HashSet as HashSet
import Base.Data.Int as Int
import Base.Data.Nat as Nat

scramble : Int -> Int
scramble i =
  let
    x = i * 7919
  in x - x / 100003 * 100003

insertAll : Int -> HashSet Int -> HashSet Int
insertAll k s = if k <= 0 then s else insertAll (k - 1) (HashSet.insert (scramble k) s)

removeEven : Int -> HashSet Int -> HashSet Int
removeEven k s = if k <= 0 then s else removeEven (k - 1) (HashSet.remove (scramble (k * 2)) s)

hitSum : Int -> HashSet Int -> Int -> Int
hitSum k s acc =
  if k <= 0 then
    acc
  else
    hitSum (k - 1) s (if HashSet.member (scramble k) s then acc * 31 + k else acc)

main : Int
main =
  let
    n = 20000
    s0 = insertAll n HashSet.empty
    s1 = removeEven n s0
  in hitSum n s1 0 + natToInt (HashSet.size s1)
