opam-version: "2.0"
synopsis: "vunax — archived stage 0 vuna compiler (OCaml implementation)"
description: """
Vunax was the external OCaml compiler for the vuna programming language. The
bootstrap chain is now self-hosted (bootstrap/stage1.ml -> vuna-boot -> vuna),
so this implementation is frozen and kept only as an archive/reference. It no
longer tracks new vuna features and is not part of the default build or checks.
"""
maintainer: "vuna-lang"
authors: "vuna-lang"
license: "MIT"
homepage: "https://github.com/vuna-lang/vuna"
bug-reports: "https://github.com/vuna-lang/vuna/issues"
dev-repo: "git+https://github.com/vuna-lang/vuna.git"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.17"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
