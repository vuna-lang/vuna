(program
  (data List (a) (Nil 0) (Cons 2))
  (sig singleton (app (var ->) (var Nat) (app (var List) (var Nat))))
  (fun singleton ((pvar x)) (app (var Cons) (var x) (var Nil)))
  (sig pair (app (var List) (var Nat)))
  (fun pair () (app (var Cons) (int 1) (app (var Cons) (int 2) (var Nil))))
  (sig head (app (var ->) (app (var List) (var a)) (var a)))
  (fun head ((pcon Cons (pvar x) (pvar xs))) (var x))
  (sig second (app (var ->) (app (var List) (var Nat)) (var Nat)))
  (fun second ((pcon Cons (pvar x) (pcon Cons (pvar y) (pcon Nil)))) (var y))
)
