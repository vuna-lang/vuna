-- pass 表不变量：名字唯一、事件名唯一且带 `vuna.pass.` 前缀、`findPass` 可反查；
-- 链首 before 校验用第一项的标记检查进入链前的数据；尾标记在已有 `IrTail` 上幂等。
import Base
import Base.Effect.Core
import Base.Data.List as List
import Base.Data.String as String
import Vuna.Ir.Model
import Vuna.Ir.Passes
import Vuna.Ir.Tail
import Vuna.Ir.Codec
import Base.Effect.Console
import Base.Effect.Exit

main : Eff [ConsoleOp, ExitOp] String
main =
  case filter (\p => not (secondOf p)) results of
    [] => pure ""
    bad =>
      do
        _ <- consolePrint ("ir passes failed: " ++ join "; " (map firstOf bad) ++ "\n")
        _ <- exitWith 1
        pure ""

results : List (Pair String Bool)
results =
  [
    Pair "names-nonempty" (length allPassNames > 0),
    Pair "names-unique" (unique allPassNames),
    Pair "events-prefixed" (allOf (\n => startsWith "vuna.pass." (passEventName n)) allPassNames),
    Pair "events-unique" (unique (map passEventName allPassNames)),
    Pair "layers-known" (allOf knownLayer allPassSpecs),
    Pair "find-roundtrip" (allOf findRoundtrip allPassSpecs),
    Pair "find-miss" findMiss,
    Pair "native-order" (map psNameOf nativePasses == expectedNativeOrder),
    Pair "ir-order" (map psNameOf irPasses == expectedIrOrder),
    Pair "check-after-good" (checkOk (checkPassAfter irCps [goodDef])),
    Pair "check-after-scope" (checkErrNamed "ir.cps" (checkPassAfter irCps [badVarDef])),
    Pair "check-after-dup" (checkErrNamed "ir.cps" (checkPassAfter irCps [goodDef, goodDef])),
    Pair "check-after-off" (checkOk (checkPassAfter offSpec [badVarDef])),
    Pair
      "check-after-all"
      (checkErrNamed "ir.machine.mark" (checkAfterAll [(irCps, [goodDef]), (irMachineMark, [badVarDef])])),
    Pair "check-before-scope" (checkErrNamed "ir.cps (before)" (checkPassBefore irCps [badVarDef])),
    Pair
      "check-head-before"
      (checkErrNamed "native.cps (before)" (checkHeadBefore nativeStages [badVarDef])),
    Pair "check-head-before-ok" (checkOk (checkHeadBefore nativeStages [goodDef])),
    Pair "check-head-before-empty" (checkOk (checkHeadBefore [] [badVarDef])),
    Pair "tail-annotate-idempotent" annotateIdempotent,
    Pair "tail-annotate-keeps-tail" annotateKeepsExistingTail
  ]

-- | 链首 before 校验的调用形态：用第一项的标记检查进入链前的数据。
nativeStages : List (PassSpec, List IrDef)
nativeStages = [(nativeCps, [goodDef])]

-- | 结构相等：`IrDef` 没有 `Eq` 实例，用规范编码比较（同一 IR 编码成同一串字节）。
encoded : List IrDef -> String
encoded ds = encodeUnit (IrUnit [] [IrGroup False ds] False [] Nothing)

-- 夹具：`h = g`（`g` 是零参定义），标记把尾位置的 `IrGlobal` 包成 `IrTail`。
tailZeroDef : IrDef
tailZeroDef = IrDef "g" 0 [] Nothing (IrInt 0) False False Nothing

tailAliasDef : IrDef
tailAliasDef = IrDef "h" 0 [] Nothing (IrGlobal "g") False False Nothing

tailSampleDefs : List IrDef
tailSampleDefs = [tailZeroDef, tailAliasDef]

-- | 已带尾标记的输入。
tailWrappedDef : IrDef
tailWrappedDef = IrDef "h" 0 [] Nothing (IrTail (IrGlobal "g")) False False Nothing

-- 幂等门禁：`ir.tail.annotate` 重复跑与只跑一次等价（第一次已包好 `IrTail`，第二次不再包）。
annotateIdempotent : Bool
annotateIdempotent =
  case annotateDefs tailSampleDefs of
    Err _ => False
    Ok once =>
      case annotateDefs once of
        Err _ => False
        Ok twice => encoded twice == encoded once

-- | 输入里已有的 `IrTail` 原样保留，不叠第二层。
annotateKeepsExistingTail : Bool
annotateKeepsExistingTail =
  case annotateDefs [tailWrappedDef] of
    Err _ => False
    Ok ds => encoded ds == encoded [tailWrappedDef]

goodDef : IrDef
goodDef = IrDef "f" 0 [] Nothing (IrInt 1) False False Nothing

badVarDef : IrDef
badVarDef = IrDef "f" 0 [] Nothing (IrVar (mkIrBinder 99 "x")) False False Nothing

offSpec : PassSpec
offSpec = PassSpec "test.off" "ir" "lower" False False False

checkOk : Result Int -> Bool
checkOk r =
  case r of
    Ok _ => True
    Err _ => False

checkErrNamed : String -> Result Int -> Bool
checkErrNamed name r =
  case r of
    Ok _ => False
    Err msg => startsWith "pass ${name}:" msg

allPassSpecs : List PassSpec
allPassSpecs = append irPasses (append nativePasses wasmPasses)

findRoundtrip : PassSpec -> Bool
findRoundtrip spec =
  case findPass spec.psName allPassSpecs of
    Just q => q.psName == spec.psName
    Nothing => False

findMiss : Bool
findMiss =
  case findPass "no.such.pass" allPassSpecs of
    Nothing => True
    Just _ => False

psNameOf : PassSpec -> String
psNameOf spec = spec.psName

knownLayer : PassSpec -> Bool
knownLayer spec = spec.psLayer == "ir" || spec.psLayer == "native" || spec.psLayer == "wasm"

allOf : {a : Type} -> (a -> Bool) -> List a -> Bool
allOf pred [] = True
allOf pred (x :: rest) = pred x && allOf pred rest

unique : List String -> Bool
unique [] = True
unique (x :: rest) = not (memName x rest) && unique rest

expectedIrOrder : List String
expectedIrOrder =
  [
    "ir.cps",
    "ir.machine.handlers",
    "ir.machine.mark",
    "ir.machine.apply",
    "ir.machine.steps",
    "ir.tail.annotate"
  ]

expectedNativeOrder : List String
expectedNativeOrder =
  [
    "native.cps",
    "native.specialize",
    "native.lsr",
    "native.inline",
    "native.inline.again",
    "native.let-float",
    "native.cse",
    "native.inline.tail",
    "native.simplify",
    "native.merge-tail-if",
    "native.alias",
    "native.fold-nat-sums",
    "native.fold-affine",
    "native.prune",
    "native.alias.again",
    "native.float-lets",
    "native.reach",
    "native.params",
    "native.validate",
    "native.emit",
    "native.init"
  ]
