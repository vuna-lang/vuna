module Vuna.Ir.Analysis where

-- Vuna.Ir.Analysis：IR 依赖分析（SCC 分组）与合法性护栏。
--
-- 只依赖 `Ir.Model`（不碰 Core/Elab），因此同一套分组既能服务 Lowering（用 Core 侧算出的
-- 名字 + 依赖做分组，再按组序降低体），也能服务已降低的 IR（校验 / 检查路径）。
--
-- 分组算法从迁移前的 `Checks` 原样搬来（Kosaraju：完成序 → 反向图收集 → 依赖
-- 就绪排序）。分组顺序决定 `let` / `let rec ... and ...` 的落盘顺序，必须与迁移前
-- **逐项一致**才能做到产物逐字节相同。
import Vuna.Compiler.Base.Common
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Base.Diagnostics
import Vuna.Ir.Model

-- ---------------------------------------------------------------
-- 邻接表
-- ---------------------------------------------------------------
export neighborsOf : HashMap String (List String) -> String -> List String
neighborsOf adjT name =
  case HashMap.lookup name adjT of
    Just ns => ns
    Nothing => []

export adjTblOf : List (Pair String (List String)) -> HashMap String (List String)
adjTblOf adj = HashMap.insertAll adj (HashMap.fromList [])

addDependents : String -> List String -> HashMap String (List String) -> HashMap String (List String)
addDependents src [] t = t
addDependents src (m :: rest) t =
  let
    cur =
      case HashMap.lookup m t of
        Just xs => xs
        Nothing => []
  in addDependents src rest (HashMap.insert m ((::) src cur) t)

reverseAdjTbl : List (Pair String (List String)) -> HashMap String (List String)
reverseAdjTbl [] = HashMap.fromList []
reverseAdjTbl ((Pair n ns) :: rest) = addDependents n ns (reverseAdjTbl rest)

-- ---------------------------------------------------------------
-- 完成序（正向图 DFS 后序）
-- ---------------------------------------------------------------
foldNeighborsPost : HashMap String (List String) -> List String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
foldNeighborsPost adjT ms visited order = foldNeighborsPostFuel 100000 adjT ms visited order

foldNeighborsPostFuel : Int -> HashMap String (List String) -> List String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
foldNeighborsPostFuel fuel adjT ms visited order =
  if fuel <= 0 then
    Pair visited order
  else
    case ms of
      [] => Pair visited order
      m :: rest =>
        if HashMap.member m visited then
          foldNeighborsPostFuel (fuel - 1) adjT rest visited order
        else
          case dfsPostFuel (fuel - 1) adjT m (HashMap.insert m True visited) order of
            Pair visited2 order2 => foldNeighborsPostFuel (fuel - 1) adjT rest visited2 order2

dfsPost : HashMap String (List String) -> String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
dfsPost adjT n visited order = dfsPostFuel 100000 adjT n visited order

dfsPostFuel : Int -> HashMap String (List String) -> String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
dfsPostFuel fuel adjT n visited order =
  if fuel <= 0 then
    Pair visited order
  else
    case foldNeighborsPostFuel (fuel - 1) adjT (neighborsOf adjT n) visited order of
      Pair visited2 order2 => Pair visited2 ((::) n order2)

postOrder : HashMap String (List String) -> List String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
postOrder adjT [] visited order = Pair visited order
postOrder adjT (n :: rest) visited order =
  if HashMap.member n visited then
    postOrder adjT rest visited order
  else
    case dfsPost adjT n (HashMap.insert n True visited) order of
      Pair visited2 order2 => postOrder adjT rest visited2 order2

-- ---------------------------------------------------------------
-- 反向图收集分量
-- ---------------------------------------------------------------
foldNeighborsCollect : HashMap String (List String) -> List String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
foldNeighborsCollect adjT ms visited comp = foldNeighborsCollectFuel 100000 adjT ms visited comp

foldNeighborsCollectFuel : Int -> HashMap String (List String) -> List String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
foldNeighborsCollectFuel fuel adjT ms visited comp =
  if fuel <= 0 then
    Pair visited comp
  else
    case ms of
      [] => Pair visited comp
      m :: rest =>
        if HashMap.member m visited then
          foldNeighborsCollectFuel (fuel - 1) adjT rest visited comp
        else
          case dfsCollectFuel (fuel - 1) adjT m (HashMap.insert m True visited) comp of
            Pair visited2 comp2 => foldNeighborsCollectFuel (fuel - 1) adjT rest visited2 comp2

dfsCollect : HashMap String (List String) -> String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
dfsCollect adjT n visited comp = dfsCollectFuel 100000 adjT n visited comp

dfsCollectFuel : Int -> HashMap String (List String) -> String -> HashMap String Bool -> List String -> Pair (HashMap String Bool) (List String)
dfsCollectFuel fuel adjT n visited comp =
  if fuel <= 0 then
    Pair visited comp
  else
    case foldNeighborsCollectFuel (fuel - 1) adjT (neighborsOf adjT n) visited comp of
      Pair visited2 comp2 => Pair visited2 ((::) n comp2)

collectComps : HashMap String (List String) -> List String -> HashMap String Bool -> List (List String) -> List (List String)
collectComps adjT [] visited comps = comps
collectComps adjT (n :: rest) visited comps =
  if HashMap.member n visited then
    collectComps adjT rest visited comps
  else
    case dfsCollect adjT n (HashMap.insert n True visited) [] of
      Pair visited2 comp => collectComps adjT rest visited2 (comp :: comps)

-- 名字 → 所属分量（一次构建，O(1) 查）。
componentTblOf : List (List String) -> HashMap String (List String)
componentTblOf comps =
  HashMap.insertAll (concatMap (\g => map (\n => Pair n g) g) comps) (HashMap.fromList [])

addAllNames : List String -> HashMap String Bool -> HashMap String Bool
addAllNames [] t = t
addAllNames (n :: rest) t = addAllNames rest (HashMap.insert n True t)

-- 按 names 首次出现顺序产出 SCC，组内成员按 names 顺序排列。
groupsFromComps : List (List String) -> List String -> List (List String)
groupsFromComps comps names =
  groupsFromCompsGo (componentTblOf comps) names names (HashMap.fromList [])

groupsFromCompsGo : HashMap String (List String) -> List String -> List String -> HashMap String Bool -> List (List String)
groupsFromCompsGo compTbl allNames [] emitted = []
groupsFromCompsGo compTbl allNames (n :: rest) emitted =
  if HashMap.member n emitted then
    groupsFromCompsGo compTbl allNames rest emitted
  else
    case HashMap.lookup n compTbl of
      Just g => (::) (groupOf allNames g) (groupsFromCompsGo compTbl allNames rest (addAllNames g emitted))
      Nothing => groupsFromCompsGo compTbl allNames rest emitted

-- 单成员分量（大程序里占绝对多数）直接返回，免掉对全程序名字的一次 filter。
groupOf : List String -> List String -> List String
groupOf allNames ([x]) = [x]
groupOf allNames g =
  let
    memberTbl = HashMap.ofNames g
  in filterNames (\m => HashMap.member m memberTbl) allNames

filterNames : (String -> Bool) -> List String -> List String
filterNames pred [] = []
filterNames pred (n :: rest) =
  if pred n then (::) n (filterNames pred rest) else filterNames pred rest

notIn : String -> List String -> Bool
notIn name names = not (memName name names)

-- ---------------------------------------------------------------
-- 拓扑排序（Kahn；与「每轮挑最小下标的就绪组」逐项等价）
-- ---------------------------------------------------------------
--
-- 旧实现每产出一组就重扫剩余组并重算依赖（最坏 O(V²)），反向依赖的命令式定义上会
-- 明显退化。这里一次建依赖下标表 + 入度 + 反向边，按**原始下标最小优先**出队，
-- 与旧算法的输出顺序逐项一致。
orderGroups : HashMap String (List String) -> List (List String) -> Check (List (List String))
orderGroups adjT groups =
  let
    indexed = indexGroups 0 groups []
    groupIdxT = groupIndexTbl indexed
    grpTbl =
      HashMap.insertAll (map (\p => Pair (firstOf p) (secondOf p)) indexed) (HashMap.fromList [])
    depPairs = map (\p => Pair (firstOf p) (groupDepIdx adjT groupIdxT p)) indexed
    revTbl = reverseDepTbl depPairs
    indeg =
      foldl
        (\acc, p => HashMap.insert (firstOf p) (countList (secondOf p)) acc)
        (HashMap.fromList [])
        depPairs
    ready = filter (\n => lookupInt indeg n == 0) (map firstOf indexed)
  in orderGroupsGo (countList groups + 1) grpTbl revTbl indeg ready (countList groups) []

indexGroups : Int -> List (List String) -> List (Pair Int (List String)) -> List (Pair Int (List String))
indexGroups i [] acc = reverse acc
indexGroups i (g :: rest) acc = indexGroups (i + 1) rest (Pair i g :: acc)

groupIndexTbl : List (Pair Int (List String)) -> HashMap String Int
groupIndexTbl indexed =
  HashMap.insertAll
    (concatMap (\p => map (\n => Pair n (firstOf p)) (secondOf p)) indexed)
    (HashMap.fromList [])

-- | 组的下标依赖：把组内各成员在邻接表里的依赖映射成组下标（去重、去自环）。
-- 不在本单元的依赖已在 `groupNames` 过滤。
groupDepIdx : HashMap String (List String) -> HashMap String Int -> Pair Int (List String) -> List Int
groupDepIdx adjT gIdxT (Pair i g) =
  groupDepIdxGo i gIdxT (concatMap (neighborsOf adjT) g) (HashMap.fromList []) []

groupDepIdxGo : Int -> HashMap String Int -> List String -> HashMap Int Bool -> List Int -> List Int
groupDepIdxGo i gIdxT [] seen acc = reverse acc
groupDepIdxGo i gIdxT (n :: rest) seen acc =
  case HashMap.lookup n gIdxT of
    Just j =>
      if j == i || HashMap.member j seen then
        groupDepIdxGo i gIdxT rest seen acc
      else
        groupDepIdxGo i gIdxT rest (HashMap.insert j True seen) (j :: acc)
    Nothing => groupDepIdxGo i gIdxT rest seen acc

reverseDepTbl : List (Pair Int (List Int)) -> HashMap Int (List Int)
reverseDepTbl pairs = foldl addReverseEdges (HashMap.fromList []) pairs

-- 同一个依赖被多个组引用时必须追加（`insertAll` 会覆盖同键）。
addReverseEdges : HashMap Int (List Int) -> Pair Int (List Int) -> HashMap Int (List Int)
addReverseEdges tbl (Pair i deps) =
  foldl (\acc, d => HashMap.insert d (append (lookupDeps acc d) [i]) acc) tbl deps

lookupInt : HashMap Int Int -> Int -> Int
lookupInt tbl k =
  case HashMap.lookup k tbl of
    Just v => v
    Nothing => 0

lookupNames : HashMap Int (List String) -> Int -> List String
lookupNames tbl k =
  case HashMap.lookup k tbl of
    Just v => v
    Nothing => []

lookupDeps : HashMap Int (List Int) -> Int -> List Int
lookupDeps tbl k =
  case HashMap.lookup k tbl of
    Just v => v
    Nothing => []

-- | 最小下标优先的有序插入（就绪集合通常很小）。
insertReady : Int -> List Int -> List Int
insertReady i [] = [i]
insertReady i (x :: rest) = if i <= x then (::) i ((::) x rest) else (::) x (insertReady i rest)

orderGroupsGo : Int -> HashMap Int (List String) -> HashMap Int (List Int) -> HashMap Int Int -> List Int -> Int -> List (List String) -> Check (List (List String))
orderGroupsGo fuel grpTbl revTbl indeg ready remaining acc =
  if fuel <= 0 then
    cgErr0 DependencyCycle
  else if remaining == 0 then
    OkC (reverse acc)
  else
    case ready of
      [] => cgErr0 DependencyCycle
      i :: rest =>
        let
          deps = lookupDeps revTbl i
          indeg2 = foldl (\acc2, d => HashMap.insert d (lookupInt indeg d - 1) acc2) indeg deps
          ready2 = foldl (\r, d => if lookupInt indeg2 d == 0 then insertReady d r else r) rest deps
        in orderGroupsGo (fuel - 1) grpTbl revTbl indeg2 ready2 (remaining - 1) (lookupNames grpTbl i :: acc)

-- ---------------------------------------------------------------
-- 对外分组入口
-- ---------------------------------------------------------------
-- | 纯名字级分组：入参是 (名字, 依赖) 与名字的全序（源码顺序）。
-- 依赖里不在 `names` 里的（内建 / 运行时常量 / 类型级名）在这里被忽略——迁移前
-- `depAdjacency` 已先把它们滤掉，这里再保险一次。
export groupNames : List (Pair String (List String)) -> List String -> Check (List (List String))
groupNames adj names =
  let
    nameTbl = HashMap.ofNames names
    adj2 = map (\p => Pair (firstOf p) (filter (\n => HashMap.member n nameTbl) (secondOf p))) adj
    adjT = adjTblOf adj2
    revT = reverseAdjTbl adj2
  in case postOrder adjT names (HashMap.fromList []) [] of
    Pair _ order =>
      let
        comps = collectComps revT order (HashMap.fromList []) []
        groups = groupsFromComps comps names
      in Vuna.Compiler.Base.Common.bind
        (orderGroups adjT groups)
        (\ordered => checkGroupsCover ordered names)

-- | 分组必须覆盖全部名字：DFS 预算耗尽或分组算法异常时，宁可报内部错也不能
-- 让定义悄悄缺席（缺席的定义会在链接期才暴露成未定义符号）。
checkGroupsCover : List (List String) -> List String -> Check (List (List String))
checkGroupsCover groups names =
  let
    covered = HashMap.ofNames (concatMap (\g => g) groups)
  in if allCovered covered names then
    OkC groups
  else
    icInternal "SCC grouping dropped definitions (DFS budget exhausted?)"

allCovered : HashMap String Bool -> List String -> Bool
allCovered covered [] = True
allCovered covered (n :: rest) = HashMap.member n covered && allCovered covered rest

-- | 单函数 SCC 且不引用自身时用 let；多函数 SCC（互递归）或自递归才用 let rec。
groupNeedsRec : HashMap String (List String) -> List String -> Bool
groupNeedsRec adjT [] = False
groupNeedsRec adjT ([x]) = memName x (neighborsOf adjT x)
groupNeedsRec adjT group = True

-- | 递归组里零参定义的右值形状护栏：`let rec` 只接受函数 / 构造子应用。
-- （判据由 Lowering 从 Core 项算好放进 `irDefRecValueOk`。）
firstBadRecursiveValue : List IrDef -> Maybe String
firstBadRecursiveValue [] = Nothing
firstBadRecursiveValue (d :: rest) =
  if irDefArity d == 0 then
    if irDefRecValueOk d then firstBadRecursiveValue rest else Just (irDefName d)
  else
    firstBadRecursiveValue rest

findDefByName : String -> List IrDef -> Maybe IrDef
findDefByName name [] = Nothing
findDefByName name (d :: rest) = if irDefName d == name then Just d else findDefByName name rest

groupDefsOf : List IrDef -> List String -> List IrDef
groupDefsOf defs [] = []
groupDefsOf defs (n :: rest) =
  case findDefByName n defs of
    Nothing => groupDefsOf defs rest
    Just d => d :: groupDefsOf defs rest

-- | 把一个定义表按给定分组序列落成分组，并对递归组做右值形状护栏（顺序与迁移前
-- `genGroups` 一致：先护栏、再生成）。
export assembleGroups : HashMap String (List String) -> List IrDef -> List (List String) -> Check (List IrGroup)
assembleGroups adjT defs [] = OkC []
assembleGroups adjT defs (g :: rest) =
  let
    members = groupDefsOf defs g
    isRec = groupNeedsRec adjT g
    checked =
      if isRec then
        case firstBadRecursiveValue members of
          Just name =>
            case findDefByName name members of
              Just d => cgErrDefAt (irDefSpan d) name (RecursiveValueDefinition name) [name]
              Nothing => cgErr1 (RecursiveValueDefinition name) name
          Nothing => OkC (IrGroup True members)
      else
        OkC (IrGroup False members)
  in Vuna.Compiler.Base.Common.bind
    checked
    (\grp => Vuna.Compiler.Base.Common.bind (assembleGroups adjT defs rest) (\tail => OkC ((::) grp tail)))

-- ---------------------------------------------------------------
-- 可达性（后端共用的纯分析）
-- ---------------------------------------------------------------
-- | 从入口种子出发的可达定义（依赖闭包；未知名字忽略），按 `defs` 程序顺序返回。
--
-- 名字表一次建好；预算 = 种子数 + 依赖边数（每个名字最多处理一次），不用固定上限。
export reachableDefs : List String -> List IrDef -> List IrDef
reachableDefs seeds defs =
  let
    defTbl = HashMap.insertAll (map (\d => Pair (irDefName d) d) defs) (HashMap.fromList [])
    budget = 8 + countList seeds + depEdgeCount defs
    seen = reachableNames budget seeds defTbl (HashMap.fromList [])
  in filter (\d => HashMap.member (irDefName d) seen) defs

depEdgeCount : List IrDef -> Int
depEdgeCount defs = foldl (\acc, d => acc + countList (irDefDeps d)) 0 defs

countList : List a -> Int
countList [] = 0
countList (_ :: rest) = 1 + countList rest

reachableNames : Int -> List String -> HashMap String IrDef -> HashMap String Bool -> HashMap String Bool
reachableNames fuel pending defTbl seen =
  if fuel <= 0 then
    seen
  else
    case pending of
      [] => seen
      n :: rest =>
        if HashMap.member n seen then
          reachableNames (fuel - 1) rest defTbl seen
        else
          let
            seen2 = HashMap.insert n True seen
          in case HashMap.lookup n defTbl of
            Nothing => reachableNames (fuel - 1) rest defTbl seen2
            Just d => reachableNames (fuel - 1) (append (irDefDeps d) rest) defTbl seen2

-- ---------------------------------------------------------------
-- 节点遍历（后端共用的纯分析）
-- ---------------------------------------------------------------
-- | 一个 IR 项里的全部字符串字面量（含 `IrConcatMany` 的叶子），按出现顺序。
-- native / wasm 的字符串池都吃这一份，避免各自维护一份节点分派。
export irStringsOf : Ir -> List String
irStringsOf (IrStr s) = [s]
irStringsOf (IrCtor _ _ _ args) = concatMap irStringsOf args
irStringsOf (IrRecord _ _ fields) = concatMap irStringsOfField fields
irStringsOf (IrProj base _ _ _) = irStringsOf base
irStringsOf (IrRecUpd base _ fields _) =
  append (irStringsOf base) (concatMap irStringsOfField fields)
irStringsOf (IrRtApp _ args) = concatMap irStringsOf args
irStringsOf (IrCast cFrom cTo inner) = irStringsOf inner
irStringsOf (IrLet _ scrut body) = append (irStringsOf scrut) (irStringsOf body)
irStringsOf (IrLam _ _ body) = irStringsOf body
irStringsOf (IrApp _ f a) = append (irStringsOf f) (irStringsOf a)
irStringsOf (IrTail inner) = irStringsOf inner
irStringsOf (IrIf c t e) = append (irStringsOf c) (append (irStringsOf t) (irStringsOf e))
irStringsOf (IrCase _ _ scrut alts) = append (irStringsOf scrut) (concatMap irStringsOfAlt alts)
irStringsOf (IrNatCase scrut _ z s c) =
  append
    (irStringsOf scrut)
    (append (irStringsOfAltMaybe z) (append (irStringsOfAltMaybe s) (irStringsOfAltMaybe c)))
irStringsOf (IrConcatMany parts) = concatMap irStringsOf parts
irStringsOf (IrEffThunk _ _ _ _ prim) = irStringsOf prim
irStringsOf _ = []

irStringsOfField : Pair String Ir -> List String
irStringsOfField p = irStringsOf (secondOf p)

irStringsOfAlt : IrAlt -> List String
irStringsOfAlt alt = irStringsOf (irAltBodyOf alt)

irStringsOfAltMaybe : Maybe IrAlt -> List String
irStringsOfAltMaybe Nothing = []
irStringsOfAltMaybe (Just alt) = irStringsOfAlt alt

-- | 应用的左脊：拆出 head 与按序实参。`IrTail` 不属于脊，调用方先处理标记。
export flattenApp : Ir -> Pair Ir (List Ir)
flattenApp (IrApp _ f a) =
  let
    p = flattenApp f
  in Pair (firstOf p) (append (secondOf p) [a])
flattenApp x = Pair x []

-- | 一个运行时定义体的字符串字面量（extern / 无体定义为空）。
export irStringsOfDef : IrDef -> List String
irStringsOfDef d =
  case irDefBody d of
    Nothing => []
    Just body => irStringsOf body

-- | 单元内定义名不得重复（迁移前在 OCaml 名字层校验；IR 层先按源码名去重，
-- 后端再按渲染名去重）。
export checkUniqueDefNames : List IrDef -> Check Int
checkUniqueDefNames defs = checkUniqueDefNamesGo (map irDefName defs) (HashMap.fromList [])

checkUniqueDefNamesGo : List String -> HashMap String Bool -> Check Int
checkUniqueDefNamesGo [] seen = OkC 0
checkUniqueDefNamesGo (n :: rest) seen =
  if HashMap.member n seen then
    icInternal "duplicate runtime definition name in IR: `${n}`"
  else
    checkUniqueDefNamesGo rest (HashMap.insert n True seen)

-- | 名字级分组 + 递归组右值护栏（不消费 `IrDef`）。
--
-- Lowering 必须在**生成体之前**知道分组顺序：fresh binder 编号是单元内全局递增的
-- （迁移前的 `gsNext` 跨组累积），所以生成顺序 = 分组顺序。这里把「分组 + 护栏」与
-- 「生成」解耦：`recOk` / `spanOf` 由调用方按 Core 定义提供。
export assembleGroupNames : List (Pair String (List String)) -> List String -> (String -> Bool) -> (String -> Maybe Span) -> Check (List (Pair Bool (List String)))
assembleGroupNames adj names recOk spanOf =
  groupNamesGo (adjTblOf adj) names (groupNames adj names) recOk spanOf

groupNamesGo : HashMap String (List String) -> List String -> Check (List (List String)) -> (String -> Bool) -> (String -> Maybe Span) -> Check (List (Pair Bool (List String)))
groupNamesGo adjT names (ErrC e) recOk spanOf = ErrC e
groupNamesGo adjT names (OkC groups) recOk spanOf = assembleGo adjT groups recOk spanOf

assembleGo : HashMap String (List String) -> List (List String) -> (String -> Bool) -> (String -> Maybe Span) -> Check (List (Pair Bool (List String)))
assembleGo adjT [] recOk spanOf = OkC []
assembleGo adjT (g :: rest) recOk spanOf =
  let
    isRec = groupNeedsRec adjT g
    checked =
      if isRec then
        case firstBadRecName g recOk of
          Just name => cgErrDefAt (spanOf name) name (RecursiveValueDefinition name) [name]
          Nothing => OkC (Pair True g)
      else
        OkC (Pair False g)
  in Vuna.Compiler.Base.Common.bind
    checked
    (\grp => Vuna.Compiler.Base.Common.bind (assembleGo adjT rest recOk spanOf) (\tail => OkC ((::) grp tail)))

firstBadRecName : List String -> (String -> Bool) -> Maybe String
firstBadRecName [] recOk = Nothing
firstBadRecName (n :: rest) recOk = if recOk n then firstBadRecName rest recOk else Just n

-- | 项里是否直接引用某个顶层定义名（只看 `IrGlobal`，不展开被引用定义）。
-- CPS 这类会合成全局引用的 pass 用它维护 `irDefDeps`。
export irMentionsGlobal : String -> Ir -> Bool
irMentionsGlobal name (IrGlobal n) = n == name
irMentionsGlobal name (IrCtor _ _ _ args) = anyMentions name args
irMentionsGlobal name (IrRecord _ _ fields) = anyMentionsFields name fields
irMentionsGlobal name (IrProj base _ _ _) = irMentionsGlobal name base
irMentionsGlobal name (IrRecUpd base _ fields _) =
  irMentionsGlobal name base || anyMentionsFields name fields
irMentionsGlobal name (IrRtApp _ args) = anyMentions name args
irMentionsGlobal name (IrCast _ _ inner) = irMentionsGlobal name inner
irMentionsGlobal name (IrLet _ scrut body) =
  irMentionsGlobal name scrut || irMentionsGlobal name body
irMentionsGlobal name (IrLam _ _ body) = irMentionsGlobal name body
irMentionsGlobal name (IrApp _ f a) = irMentionsGlobal name f || irMentionsGlobal name a
irMentionsGlobal name (IrIf c t e) =
  irMentionsGlobal name c || (irMentionsGlobal name t || irMentionsGlobal name e)
irMentionsGlobal name (IrCase _ _ scrut alts) =
  irMentionsGlobal name scrut || anyMentionsAlts name alts
irMentionsGlobal name (IrNatCase scrut _ z s c) =
  irMentionsGlobal name scrut
    || (anyMentionsAltM name z || (anyMentionsAltM name s || anyMentionsAltM name c))
irMentionsGlobal name (IrConcatMany parts) = anyMentions name parts
irMentionsGlobal name (IrEffThunk _ _ _ _ prim) = irMentionsGlobal name prim
irMentionsGlobal name _ = False

anyMentions : String -> List Ir -> Bool
anyMentions name [] = False
anyMentions name (x :: rest) = irMentionsGlobal name x || anyMentions name rest

anyMentionsFields : String -> List (Pair String Ir) -> Bool
anyMentionsFields name [] = False
anyMentionsFields name ((Pair fn fe) :: rest) =
  irMentionsGlobal name fe || anyMentionsFields name rest

anyMentionsAlts : String -> List IrAlt -> Bool
anyMentionsAlts name [] = False
anyMentionsAlts name (alt :: rest) =
  irMentionsGlobal name (irAltBodyOf alt) || anyMentionsAlts name rest

anyMentionsAltM : String -> Maybe IrAlt -> Bool
anyMentionsAltM name Nothing = False
anyMentionsAltM name (Just alt) = irMentionsGlobal name (irAltBodyOf alt)
