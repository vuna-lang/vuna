module Vuna.Ir.Validate where

-- 擦除后中间表示（IR）的单元/程序级校验。
--
-- 分层：
--   - `Ir.Model`   ：IR 数据定义（唯一真源）：节点、`IrTy`、binder、共享元数据、单元/程序；
--   - `Ir.Analysis`：IR 上的纯分析：Kosaraju SCC 分组（决定 `let` / `let rec` 顺序）、
--                    递归值形状护栏、定义名去重；
--
-- 谁 import 谁：
-- 数据定义在 `Ir.Model`，运行时符号契约在 `Ir.Runtime`，SCC 分组在 `Ir.Analysis`。
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Container.HashMap as HashMap
import Vuna.Ir.Model
import Vuna.Ir.Analysis
import Vuna.Ir.Runtime
import Vuna.Compiler.Base.Common

-- | 单元级校验：定义名唯一、分组自洽（每个依赖要么在更早的组、要么在同组）、
-- 运行时符号已声明且 arity 一致。分组自洽用一次线性扫描，不重跑 SCC。
export validateUnit : IrShared -> IrUnit -> Check Int
validateUnit shared u =
  let
    defs = concatMap irGroupDefs u.irUnitGroups
    nameTbl = HashMap.ofNames (map irDefName defs)
  in Vuna.Compiler.Base.Common.bind
    (checkUniqueDefNames defs)
    (\_ => Vuna.Compiler.Base.Common.bind (checkGroupOrder u.irUnitGroups nameTbl) (\_ => Vuna.Compiler.Base.Common.bind (checkSymbolRefs (irSymbolsOfUnit u)) (\_ => Vuna.Compiler.Base.Common.bind (checkScopedUnit u) (\_ => Vuna.Compiler.Base.Common.bind (validateTyDecls u.irUnitTyDecls) (\_ => checkBinderTys shared u.irUnitTyDecls defs)))))

-- 依赖可见性：组内成员可以互引；跨组引用只能指向已经产出的组。
checkGroupOrder : List IrGroup -> HashMap String Bool -> Check Int
checkGroupOrder groups nameTbl = checkGroupOrderGo groups (HashMap.fromList []) nameTbl

checkGroupOrderGo : List IrGroup -> HashMap String Bool -> HashMap String Bool -> Check Int
checkGroupOrderGo [] seen nameTbl = OkC 0
checkGroupOrderGo (g :: rest) seen nameTbl =
  let
    members = irGroupDefs g
    visible = foldl (\acc, d => HashMap.insert (irDefName d) True acc) seen members
  in case firstUnorderedDep nameTbl visible members of
    Nothing => checkGroupOrderGo rest visible nameTbl
    Just bad =>
      icInternal
        "IR group order is inconsistent: `${secondOf bad}` referenced before it is defined (group of `${firstOf bad}`)"

firstUnorderedDep : HashMap String Bool -> HashMap String Bool -> List IrDef -> Maybe (Pair String String)
firstUnorderedDep nameTbl visible defs = firstUnorderedDepGo nameTbl visible defs

firstUnorderedDepGo : HashMap String Bool -> HashMap String Bool -> List IrDef -> Maybe (Pair String String)
firstUnorderedDepGo nameTbl visible [] = Nothing
firstUnorderedDepGo nameTbl visible (d :: rest) =
  case firstMissingDep nameTbl visible (irDefName d) (irDefDeps d) of
    Just bad => Just bad
    Nothing => firstUnorderedDepGo nameTbl visible rest

firstMissingDep : HashMap String Bool -> HashMap String Bool -> String -> List String -> Maybe (Pair String String)
firstMissingDep nameTbl visible self [] = Nothing
firstMissingDep nameTbl visible self (dep :: rest) =
  if HashMap.member dep nameTbl then
    if HashMap.member dep visible then
      firstMissingDep nameTbl visible self rest
    else
      Just (Pair self dep)
  else
    firstMissingDep nameTbl visible self rest

-- | 每个运行时符号都必须在 `Ir.Runtime` 契约里；饱和应用还必须与 `irInlineArity` 一致。
-- 违反即编译器 bug（内部错），不是用户面诊断。
checkSymbolRefs : List (Pair String (Maybe Int)) -> Check Int
checkSymbolRefs [] = OkC 0
checkSymbolRefs (p :: rest) =
  case irRtLookup (firstOf p) of
    Nothing => icInternal "IR references an undeclared runtime symbol: `${firstOf p}`"
    Just _ =>
      case secondOf p of
        Nothing => checkSymbolRefs rest
        Just n =>
          if n > 0 && irInlineArity (firstOf p) == n then
            checkSymbolRefs rest
          else
            icInternal
              "IR saturated runtime symbol `${firstOf p}` has the wrong arity (${strFromInt n})"

-- | 程序级校验：单元级校验 + 入口引用的 main 必须在本单元定义里。
export validateProgram : IrProgram -> Check Int
validateProgram p =
  let
    u = p.irProgUnit
    shared = p.irProgShared
    defs = concatMap irGroupDefs u.irUnitGroups
  in case u.irUnitEntry of
    Nothing => validateUnit shared u
    Just e =>
      if memName e.irEntryMain (map irDefName defs) then
        validateUnit shared u
      else
        icInternal "IR entry references an undefined main: `${e.irEntryMain}`"

-- ---------------------------------------------------------------
-- binder 类型槽校验
-- ---------------------------------------------------------------
-- 注解只能挂在运行时 binder 上（擦除占位必须 `Nothing`）；`IrTyData` 的实参个数
-- 要与本单元声明的运行时类型参数个数一致。跨单元类型只递归检查实参，不检查 arity。
checkBinderTys : IrShared -> List IrTyDecl -> List IrDef -> Check Int
checkBinderTys shared decls [] = OkC 0
checkBinderTys shared decls (d :: rest) =
  Vuna.Compiler.Base.Common.bind (checkDefTy decls (irDefName d) (irDefTy d)) (
      \_ =>
        Vuna.Compiler.Base.Common.bind (checkDefArityVsSig d) (
            \_ =>
              case irDefBody d of
                Nothing => checkBinderTys shared decls rest
                Just body => Vuna.Compiler.Base.Common.bind (checkBinderTysWork shared (8 * irSize body + 64) decls [body]) (\_ => checkBinderTys shared decls rest)
          )
    )

-- 运行时 arity 不能超过签名的箭头数：签名是体的类型，体最多 η-展开成同样多的运行时
-- 参数（η-收缩的定义 arity 更小）。签名不可命名（0 箭头，例如类型别名）时无法核对，跳过。
-- 投影定义的运行时字典参数必须出现在签名里，这条守它。
checkDefArityVsSig : IrDef -> Check Int
checkDefArityVsSig d =
  case irDefExtern d of
    Just _ => OkC 0
    Nothing =>
      case irDefTy d of
        Nothing => OkC 0
        Just ty =>
          let
            arrows = irTyArrowArity ty
          in if irDefArity d == 0 || arrows == 0 then
            OkC 0
          else if irDefArity d <= arrows then
            OkC 0
          else
            icInternal
              "definition `${irDefName d}` has ${strFromInt (irDefArity d)} runtime parameters but its signature has ${strFromInt arrows}"

irTyArrowArity : IrTy -> Int
irTyArrowArity (IrTyFun _ cod) = 1 + irTyArrowArity cod
irTyArrowArity _ = 0

checkDefTy : List IrTyDecl -> String -> Maybe IrTy -> Check Int
checkDefTy decls _ Nothing = OkC 0
checkDefTy decls name (Just ty) =
  case checkTyArity decls ty of
    ErrC _ => icInternal "definition `${name}` has an invalid runtime signature"
    OkC n => OkC n

checkBinderTysWork : IrShared -> Int -> List IrTyDecl -> List Ir -> Check Int
checkBinderTysWork shared fuel decls work =
  if fuel <= 0 then
    icFuel "ir-binder-ty"
  else
    case work of
      [] => OkC 0
      ir :: rest => Vuna.Compiler.Base.Common.bind (checkNodeBinderTys shared decls ir) (\_ => checkBinderTysWork shared (fuel - 1) decls (append (irChildren ir) rest))

checkNodeBinderTys : IrShared -> List IrTyDecl -> Ir -> Check Int
checkNodeBinderTys shared decls (IrLam bs resultTy _) =
  if anyErasedBinder bs then
    icInternal "IR lambda carries an erased binder placeholder"
  else
    Vuna.Compiler.Base.Common.bind (checkBinderTysOf decls bs) (\_ => checkIrTyM decls resultTy)
checkNodeBinderTys shared decls (IrLet bs scrut body) = checkBinderTysOf decls bs
checkNodeBinderTys shared decls (IrCase caseTy resultTy _ alts) =
  Vuna.Compiler.Base.Common.bind
    (checkIrTyM decls caseTy)
    (\_ => Vuna.Compiler.Base.Common.bind (checkIrTyM decls resultTy) (\_ => checkAltBinderTys decls alts))
checkNodeBinderTys shared decls (IrApp appTy _ _) = checkAppTyM decls appTy
checkNodeBinderTys shared decls (IrCtor family ctor tys args) =
  checkCtorTys shared decls family ctor tys (listLength args)
checkNodeBinderTys shared decls (IrRecord _ resTy _) = checkIrTyM decls resTy
checkNodeBinderTys shared decls (IrProj _ _ _ resTy) = checkIrTyM decls resTy
checkNodeBinderTys shared decls (IrRecUpd _ _ _ resTy) = checkIrTyM decls resTy
checkNodeBinderTys shared decls (IrNatCase scrut fresh zero succ catch) =
  Vuna.Compiler.Base.Common.bind
    (checkAltBinderTysM decls zero)
    (\_ => Vuna.Compiler.Base.Common.bind (checkAltBinderTysM decls succ) (\_ => checkAltBinderTysM decls catch))
checkNodeBinderTys shared decls (IrCast from to _) =
  Vuna.Compiler.Base.Common.bind (checkIrTyM decls from) (\_ => checkIrTyM decls to)
checkNodeBinderTys shared decls (IrTail inner) = checkNodeBinderTys shared decls inner
checkNodeBinderTys shared decls _ = OkC 0

checkAppTyM : List IrTyDecl -> Maybe (Pair IrTy IrTy) -> Check Int
checkAppTyM decls Nothing = OkC 0
checkAppTyM decls (Just p) =
  Vuna.Compiler.Base.Common.bind
    (checkIrTyM decls (Just (firstOf p)))
    (\_ => checkIrTyM decls (Just (secondOf p)))

checkCtorTys : IrShared -> List IrTyDecl -> String -> String -> Maybe (List IrTy) -> Int -> Check Int
checkCtorTys shared decls family ctor tys nargs =
  Vuna.Compiler.Base.Common.bind (checkTyArityListM decls tys) (
      \_ =>
        let
          typeArityOk =
            case tyDeclArityOf decls family of
              Just n =>
                case tys of
                  Just ts => listLength ts == n
                  Nothing => True
              Nothing => True
        in if typeArityOk then checkCtorArity shared family ctor nargs else icInternal "constructor application has the wrong runtime type argument count for `${family}`"
    )

checkTyArityListM : List IrTyDecl -> Maybe (List IrTy) -> Check Int
checkTyArityListM decls Nothing = OkC 0
checkTyArityListM decls (Just tys) = checkTyArityList decls tys

-- | 构造子的运行时字段数从**程序级** shared 表取（split 后单元声明表只含本单元，
--   跨单元构造子在 `decls` 里查不到）。查不到 = IR 引用了未声明的构造子。
checkCtorArity : IrShared -> String -> String -> Int -> Check Int
checkCtorArity shared family ctor nargs =
  case irSharedCtorShapeOf ctor shared.irSharedCtorShapes of
    Nothing => icInternal "IR references an undeclared constructor: `${ctor}`"
    Just (Pair fam flags) =>
      if fam == family then
        let
          n = countKeptFlags flags
        in if nargs == n then OkC 0 else icInternal "constructor `${ctor}` has ${strFromInt nargs} runtime arguments, expected ${strFromInt n}"
      else
        icInternal "constructor `${ctor}` belongs to family `${fam}`, not `${family}`"

countKeptFlags : List Bool -> Int
countKeptFlags [] = 0
countKeptFlags (k :: rest) = if k then 1 + countKeptFlags rest else countKeptFlags rest

checkIrTyM : List IrTyDecl -> Maybe IrTy -> Check Int
checkIrTyM decls Nothing = OkC 0
checkIrTyM decls (Just ty) = checkTyArity decls ty

anyErasedBinder : List IrBinder -> Bool
anyErasedBinder [] = False
anyErasedBinder (b :: rest) = if b.irBinderErased then True else anyErasedBinder rest

checkBinderTysOf : List IrTyDecl -> List IrBinder -> Check Int
checkBinderTysOf decls [] = OkC 0
checkBinderTysOf decls (b :: rest) =
  if b.irBinderErased then
    case b.irBinderTy of
      Nothing => checkBinderTysOf decls rest
      Just _ => icInternal "erased binder carries a runtime type annotation"
  else
    case b.irBinderTy of
      Nothing => checkBinderTysOf decls rest
      Just ty => Vuna.Compiler.Base.Common.bind (checkTyArity decls ty) (\_ => checkBinderTysOf decls rest)

checkAltBinderTys : List IrTyDecl -> List IrAlt -> Check Int
checkAltBinderTys decls [] = OkC 0
checkAltBinderTys decls (alt :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkBinderTysOf decls (irAltBindersOf alt))
    (\_ => checkAltBinderTys decls rest)

checkAltBinderTysM : List IrTyDecl -> Maybe IrAlt -> Check Int
checkAltBinderTysM decls Nothing = OkC 0
checkAltBinderTysM decls (Just alt) = checkBinderTysOf decls (irAltBindersOf alt)

checkTyArity : List IrTyDecl -> IrTy -> Check Int
checkTyArity decls ty = checkTyArityIn decls Nothing ty

-- | `slots` 是「本声明允许的类型参数槽个数」：`Nothing` = 当前位置没有可核对的上界
--   （签名 / binder 注解里的槽已被 Lowering 替换成实参，残留即为 bug）。
checkTyArityIn : List IrTyDecl -> Maybe Int -> IrTy -> Check Int
checkTyArityIn decls slots (IrTyVar i) =
  if i < 0 then
    icInternal "negative runtime type parameter slot"
  else
    case slots of
      Nothing => OkC 0
      Just n => if i < n then OkC 0 else icInternal "runtime type parameter slot ${strFromInt i} is out of range (declaration has ${strFromInt n} type parameters)"
checkTyArityIn decls slots IrTyInt = OkC 0
checkTyArityIn decls slots IrTyStr = OkC 0
checkTyArityIn decls slots IrTyBool = OkC 0
checkTyArityIn decls slots IrTyFloat = OkC 0
checkTyArityIn decls slots IrTyOpaque = OkC 0
checkTyArityIn decls slots (IrTyArray a) = checkTyArityIn decls slots a
checkTyArityIn decls slots (IrTyRef a) = checkTyArityIn decls slots a
checkTyArityIn decls slots (IrTyFun d c) =
  Vuna.Compiler.Base.Common.bind (checkTyArityIn decls slots d) (\_ => checkTyArityIn decls slots c)
checkTyArityIn decls slots (IrTyData fam args) =
  case tyDeclArityOf decls fam of
    Just n =>
      if listLength args == n then
        checkTyArityListIn decls slots args
      else
        icInternal
          "binder type annotation has the wrong type argument count for `${fam}` (expected ${strFromInt n}, got ${strFromInt (listLength args)})"
    Nothing => checkTyArityListIn decls slots args

checkTyArityList : List IrTyDecl -> List IrTy -> Check Int
checkTyArityList decls tys = checkTyArityListIn decls Nothing tys

checkTyArityListIn : List IrTyDecl -> Maybe Int -> List IrTy -> Check Int
checkTyArityListIn decls slots [] = OkC 0
checkTyArityListIn decls slots (t :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkTyArityIn decls slots t)
    (\_ => checkTyArityListIn decls slots rest)

-- | 声明体里的槽必须落在该声明自己的 arity 内（后端把它们渲染成 `'a<i>`，
--   越界即产物里出现未绑定的类型变量）。
export validateTyDecls : List IrTyDecl -> Check Int
validateTyDecls decls = validateTyDeclsGo decls decls

validateTyDeclsGo : List IrTyDecl -> List IrTyDecl -> Check Int
validateTyDeclsGo all [] = OkC 0
validateTyDeclsGo all (d :: rest) =
  Vuna.Compiler.Base.Common.bind (checkDeclSlots all d) (\_ => validateTyDeclsGo all rest)

checkDeclSlots : List IrTyDecl -> IrTyDecl -> Check Int
checkDeclSlots all (IrVariantDecl name n ctors) = checkDeclCtorSlots all name n ctors
checkDeclSlots all (IrRecordDecl name n fields tys) = checkTyArityListIn all (Just n) tys
checkDeclSlots all (IrUnboxedDecl name n ty) = checkTyArityIn all (Just n) ty

checkDeclCtorSlots : List IrTyDecl -> String -> Int -> List (Pair String (List IrTy)) -> Check Int
checkDeclCtorSlots all name n [] = OkC 0
checkDeclCtorSlots all name n ((Pair ctor tys) :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkTyArityListIn all (Just n) tys)
    (\_ => checkDeclCtorSlots all name n rest)

tyDeclArityOf : List IrTyDecl -> String -> Maybe Int
tyDeclArityOf [] fam = Nothing
tyDeclArityOf ((IrVariantDecl name n ctors) :: rest) fam =
  if name == fam then Just n else tyDeclArityOf rest fam
tyDeclArityOf ((IrRecordDecl name n fields tys) :: rest) fam =
  if name == fam then Just n else tyDeclArityOf rest fam
tyDeclArityOf ((IrUnboxedDecl name n ty) :: rest) fam =
  if name == fam then Just n else tyDeclArityOf rest fam

listLength : List a -> Int
listLength [] = 0
listLength (x :: rest) = 1 + listLength rest

-- ---------------------------------------------------------------
-- 作用域校验
-- ---------------------------------------------------------------
-- `IrVar` 携带 binder 身份，所以「每个变量都在语法作用域里」可以逐节点检查；
-- 另外擦除占位 binder 不得出现在运行时 IR 的变量位置（Lowering 的擦除判据若漏一处，
-- 这里会报内部错，而不是生成一条引用 `_` 的 OCaml）。
--
-- 用显式工作队列而不是互递归：每个节点出队时把自己的子节点按**扩展后的作用域**压回，
-- 预算按节点规模派生（与 `Lowering` 的 `lowerBudgetFor` 同思路）。
export checkScopedUnit : IrUnit -> Check Int
checkScopedUnit u = checkScopedDefs (concatMap irGroupDefs u.irUnitGroups)

checkScopedDefs : List IrDef -> Check Int
checkScopedDefs [] = OkC 0
checkScopedDefs (d :: rest) =
  case irDefBody d of
    Nothing => checkScopedDefs rest
    Just body =>
      Vuna.Compiler.Base.Common.bind
        (checkScopedWork (scopedFuelOf body + 1) [Pair [] body])
        (\_ => checkScopedDefs rest)

scopedFuelOf : Ir -> Int
scopedFuelOf body = 8 * irSize body + 64

checkScopedWork : Int -> List (Pair (List IrBinder) Ir) -> Check Int
checkScopedWork fuel work =
  if fuel <= 0 then
    icFuel "ir-scope"
  else
    case work of
      [] => OkC 0
      (Pair scope ir) :: rest =>
        case ir of
          IrVar b => if b.irBinderErased then icInternal "erased binder reached runtime IR" else if memBinder b scope then checkScopedWork (fuel - 1) rest else icInternal "IR variable references a binder outside its scope"
          _ => checkScopedWork (fuel - 1) (append (scopedChildren scope ir) rest)

-- 子节点 + 它们的作用域：只有 `IrLam` / `IrLet` / `IrCase` / `IrNatCase` 引入 binder。
scopedChildren : List IrBinder -> Ir -> List (Pair (List IrBinder) Ir)
scopedChildren scope (IrCtor family ctor _ args) = map (\a => Pair scope a) args
scopedChildren scope (IrRecord family _ fields) = map (\p => Pair scope (secondOf p)) fields
scopedChildren scope (IrProj base family field _) = [Pair scope base]
scopedChildren scope (IrRecUpd base family fields _) =
  Pair scope base :: map (\p => Pair scope (secondOf p)) fields
scopedChildren scope (IrRtApp sym args) = map (\a => Pair scope a) args
scopedChildren scope (IrCast cFrom cTo inner) = [Pair scope inner]
scopedChildren scope (IrLet bs scrut body) = [Pair scope scrut, Pair (append bs scope) body]
scopedChildren scope (IrLam bs _ body) = [Pair (append bs scope) body]
scopedChildren scope (IrApp _ f a) = [Pair scope f, Pair scope a]
scopedChildren scope (IrIf c th el) = [Pair scope c, Pair scope th, Pair scope el]
scopedChildren scope (IrCase _ _ scrut alts) = Pair scope scrut :: altWork scope alts
scopedChildren scope (IrNatCase scrut fresh zero succ catch) =
  append
    [Pair scope scrut]
    (append (altWork scope (maybeAlts zero)) (append (altWork scope (maybeAlts succ)) (altWork scope (maybeAlts catch))))
scopedChildren scope (IrConcatMany parts) = map (\a => Pair scope a) parts
scopedChildren scope (IrEffThunk family ctor unitTy arity prim) = [Pair scope prim]
scopedChildren scope (IrTail inner) = [Pair scope inner]
scopedChildren scope _ = []

maybeAlts : Maybe IrAlt -> List IrAlt
maybeAlts Nothing = []
maybeAlts (Just alt) = [alt]

altWork : List IrBinder -> List IrAlt -> List (Pair (List IrBinder) Ir)
altWork scope [] = []
altWork scope (alt :: rest) =
  Pair (append (irAltBindersOf alt) scope) (irAltBodyOf alt) :: altWork scope rest

-- 结构子节点（不含作用域）：`checkBinderTys` 只按节点校验注解，不需要 binder 作用域；
-- 用它替代 `scopedChildren []` 省掉「造 scope 对、再 map secondOf 丢掉」的整轮分配。
irChildren : Ir -> List Ir
irChildren (IrCtor family ctor _ args) = args
irChildren (IrRecord family _ fields) = map secondOf fields
irChildren (IrProj base family field _) = [base]
irChildren (IrRecUpd base family fields _) = base :: map secondOf fields
irChildren (IrRtApp sym args) = args
irChildren (IrCast cFrom cTo inner) = [inner]
irChildren (IrLet bs scrut body) = [scrut, body]
irChildren (IrLam bs _ body) = [body]
irChildren (IrApp _ f a) = [f, a]
irChildren (IrIf c th el) = [c, th, el]
irChildren (IrCase _ _ scrut alts) = scrut :: altBodies alts
irChildren (IrNatCase scrut fresh zero succ catch) =
  append
    [scrut]
    (append (maybeAltBodies zero) (append (maybeAltBodies succ) (maybeAltBodies catch)))
irChildren (IrConcatMany parts) = parts
irChildren (IrEffThunk family ctor unitTy arity prim) = [prim]
irChildren (IrTail inner) = [inner]
irChildren _ = []

altBodies : List IrAlt -> List Ir
altBodies [] = []
altBodies (alt :: rest) = irAltBodyOf alt :: altBodies rest

maybeAltBodies : Maybe IrAlt -> List Ir
maybeAltBodies Nothing = []
maybeAltBodies (Just alt) = [irAltBodyOf alt]

memBinder : IrBinder -> List IrBinder -> Bool
memBinder b [] = False
memBinder b (x :: rest) = if sameBinder b x then True else memBinder b rest

sameBinder : IrBinder -> IrBinder -> Bool
sameBinder b1 b2 =
  b1.irBinderErased == b2.irBinderErased && sameBName b1.irBinderName b2.irBinderName

sameBName : IrBName -> IrBName -> Bool
sameBName (IrBUser a) (IrBUser b) = a == b
sameBName (IrBArm a) (IrBArm b) = a == b
sameBName (IrBNat a) (IrBNat b) = a == b
sameBName IrBWild IrBWild = True
sameBName a b = False
