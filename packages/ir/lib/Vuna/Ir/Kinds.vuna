-- ---------------------------------------------------------------
-- binder / 值位置的 kind
-- ---------------------------------------------------------------
-- | binder 的 kind：声明类型优先；缺类型时用绑定点的推断值。
export irBinderKind : List IrTyDecl -> Maybe IrKind -> IrBinder -> IrKind
irBinderKind decls fallback b =
  case irKindOfTy decls b.irBinderTy of
    KMissing =>
      case fallback of
        Just k => k
        Nothing => KMissing
    k => k

-- | 按 binder 身份（稳定 id）查环境；名字只是渲染，不承担身份。
export irKindEnvLookup : Int -> List (Int, IrKind) -> Maybe IrKind
irKindEnvLookup _ [] = Nothing
irKindEnvLookup id (p :: rest) =
  if firstOf p == id then Just (secondOf p) else irKindEnvLookup id rest

-- | 一个值位置的 kind。控制构造（`let` / `if` / 尾标记）不产出独立的值，返回 `Nothing`。
--
-- `env` 是当前作用域的 binder kind 表；找不到的 binder 落 `KMissing`，不当错误——
-- CPS 合成的 Lam 形参可能真的没有类型可推（D125）。
export irKindOfValue : List IrTyDecl -> List IrDef -> List (Int, IrKind) -> Ir -> Maybe IrKind
irKindOfValue decls defs env (IrVar b) =
  case irKindOfTy decls b.irBinderTy of
    KMissing =>
      case irKindEnvLookup b.irBinderId env of
        Just k => Just k
        Nothing => Just KMissing
    k => Just k
irKindOfValue decls defs env (IrGlobal name) = Just (irKindOfTy decls (irDefTyNamed name defs))
irKindOfValue decls defs env (IrCtor _ _ _ _) = Just KRef
irKindOfValue decls defs env (IrRecord _ resTy _) = Just (irKindOfTy decls resTy)
irKindOfValue decls defs env (IrRecUpd _ _ _ _) = Just KRef
irKindOfValue decls defs env (IrProj _ _ _ resTy) = Just (irKindOfTy decls resTy)
-- 运行时符号作为值（`IrRt sym`）是函数值 / 动作值，与它返回什么无关。
irKindOfValue decls defs env (IrRt _) = Just KRef
irKindOfValue decls defs env (IrRtApp sym _) = Just (irRtKindToValue (irRtKind sym))
irKindOfValue decls defs env (IrCast _ to _) = Just (irKindOfTy decls to)
irKindOfValue decls defs env (IrInt _) = Just KInt
irKindOfValue decls defs env (IrStr _) = Just KStr
irKindOfValue decls defs env (IrBool _) = Just KBool
irKindOfValue decls defs env (IrFloatLit _) = Just KFloat
irKindOfValue decls defs env (IrLam _ _ _) = Just KRef
irKindOfValue decls defs env (IrApp appTy _ _) =
  case appTy of
    Just p => Just (irKindOfTy decls (Just (secondOf p)))
    Nothing => Just KMissing
irKindOfValue decls defs env (IrCase _ resTy _ _) = Just (irKindOfTy decls resTy)
irKindOfValue decls defs env (IrNatCase _ _ _ _ _) = Just KInt
irKindOfValue decls defs env (IrConcatMany _) = Just KStr
irKindOfValue decls defs env (IrEffThunk _ _ _ _ _) = Just KRef
irKindOfValue decls defs env (IrEffBind _ _ _) = Just KRef
irKindOfValue decls defs env (IrLet _ _ _) = Nothing
irKindOfValue decls defs env (IrTail _) = Nothing
irKindOfValue decls defs env (IrIf _ _ _) = Nothing

irDefTyNamed : String -> List IrDef -> Maybe IrTy
irDefTyNamed _ [] = Nothing
irDefTyNamed name (d :: rest) = if irDefName d == name then irDefTy d else irDefTyNamed name rest

-- ---------------------------------------------------------------
-- case 分支 binder：按构造子字段类型推断
-- ---------------------------------------------------------------
-- | 分支 binder 的 kind fallback：有构造子就按字段类型（代入 scrutinee 的运行时类型
--   实参），否则用 scrutinee 自己的 kind。`idx` 是运行时字段序号（跳过擦除位）。
export irAltBinderKindFallback : List IrTyDecl -> Maybe IrTy -> Maybe (String, String) -> Int -> Maybe IrKind
irAltBinderKindFallback decls caseTy (Just (fam, ctor)) idx =
  case Layout.irDeclOf fam decls of
    Just d =>
      case irTyAt (ctorFieldTysOf d ctor) idx of
        Just fieldTy =>
          Just (irKindOfTy decls (Just (irTySubstVars (irTyDataArgsOf caseTy) fieldTy)))
        Nothing => Just (irKindOfTy decls caseTy)
    Nothing => Just (irKindOfTy decls caseTy)
irAltBinderKindFallback decls caseTy Nothing idx = Just (irKindOfTy decls caseTy)

ctorFieldTysOf : IrTyDecl -> String -> List IrTy
ctorFieldTysOf (IrVariantDecl _ _ ctors) ctor = ctorFieldsIn ctor ctors
ctorFieldTysOf (IrRecordDecl _ _ _ fields) ctor = fields
ctorFieldTysOf (IrUnboxedDecl _ _ _) ctor = []

ctorFieldsIn : String -> List (String, List IrTy) -> List IrTy
ctorFieldsIn _ [] = []
ctorFieldsIn ctor (p :: rest) = if firstOf p == ctor then secondOf p else ctorFieldsIn ctor rest
