module Vuna.Ir.Tail where

-- 尾位置标记 pass。
--
-- `IrTail` 只是注解：求值与原节点相同，表示该节点处在函数结果位置。尾位置规则
-- 集中在这里，native / wasm 只消费标记并发射各自的尾调用指令。
--
-- 运行位置：`Ir.Cps.cpsDefsMachine` 末尾。CPS 会新建/重排 `IrApp` 与 `IrLam`，
-- 因此标记必须在 CPS 之后。`IrEffThunk` 的 prim 是模板，不在这里标记；后端把它
-- 塞进合成的 lambda 时不标记（效应 thunk / eta wrapper 的 body 仍按普通调用生成）。
--
-- 边界：只 import `Ir.Model` 与 Base 的纯数据结构。
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.Result as Result
import Vuna.Ir.Model

-- | 定义名 -> 运行时 arity。extern 不参与（没有 IR 调用点）。
arityTableOf : List IrDef -> HashMap String Int
arityTableOf defs = foldl addDef (HashMap.fromList []) defs

addDef : HashMap String Int -> IrDef -> HashMap String Int
addDef tbl (IrDef name arity _ _ _ _ _ _) = HashMap.insert name arity tbl
addDef tbl (IrExternDef _ _ _ _) = tbl

arityOfTable : HashMap String Int -> String -> Maybe Int
arityOfTable tbl name = HashMap.lookup name tbl

tailFuelOf : Ir -> Int
tailFuelOf ir = 64 + 16 * irSize ir

annotateDefsWith : (String -> Maybe Int) -> List IrDef -> List IrDef
annotateDefsWith arityOf defs = map (annotateDef arityOf) defs

annotateDef : (String -> Maybe Int) -> IrDef -> IrDef
annotateDef arityOf (IrDef name arity deps ty body recOk initGuard span) =
  IrDef name arity deps ty (annotateAt (tailFuelOf body) arityOf True body) recOk initGuard span
annotateDef arityOf (d@(IrExternDef _ _ _ _)) = d

-- | 对一段函数体做标记（顶层就是结果位置）。codegen 合成效应 thunk 时用。
export annotateBody : (String -> Maybe Int) -> Ir -> Ir
annotateBody arityOf ir = annotateAt (tailFuelOf ir) arityOf True ir

-- | 对整个定义表做标记。同一个 pass 幂等：已有 `IrTail` 不再包一层。
export annotateDefs : List IrDef -> Result (List IrDef)
annotateDefs defs =
  let
    tbl = arityTableOf defs
  in Ok (annotateDefsWith (arityOfTable tbl) defs)

-- | 去掉当前求值上下文里的尾标记，但保留 `IrLam` body 内的标记（那是函数体）。
--   wasm 的零参定义在 `_start` 里内联求值，不能按函数返回位置发 `return_call`。
export stripTail : Ir -> Ir
stripTail ir = stripTailAt (tailFuelOf ir) ir

stripTailAt : Int -> Ir -> Ir
stripTailAt fuel ir =
  if fuel <= 0 then
    ir
  else
    case ir of
      IrTail inner => stripTailAt (fuel - 1) inner
      IrVar _ => ir
      IrGlobal _ => ir
      IrCtor family ctor tys args => IrCtor family ctor tys (map (stripTailAt (fuel - 1)) args)
      IrRecord family resTy fields => IrRecord family resTy (map (stripField (fuel - 1)) fields)
      IrProj base family field resTy => IrProj (stripTailAt (fuel - 1) base) family field resTy
      IrRecUpd base family fields resTy => IrRecUpd (stripTailAt (fuel - 1) base) family (map (stripField (fuel - 1)) fields) resTy
      IrRt _ => ir
      IrRtApp sym args => IrRtApp sym (map (stripTailAt (fuel - 1)) args)
      IrCast cFrom cTo inner => IrCast cFrom cTo (stripTailAt (fuel - 1) inner)
      IrInt _ => ir
      IrStr _ => ir
      IrBool _ => ir
      IrFloatLit _ => ir
      IrLet bs scrut body => IrLet bs (stripTailAt (fuel - 1) scrut) (stripTailAt (fuel - 1) body)
      IrLam bs rt body => IrLam bs rt (stripTailAt (fuel - 1) body)
      IrApp appTy f a => IrApp appTy (stripTailAt (fuel - 1) f) (stripTailAt (fuel - 1) a)
      IrIf c t el => IrIf (stripTailAt (fuel - 1) c) (stripTailAt (fuel - 1) t) (stripTailAt (fuel - 1) el)
      IrCase caseTy resultTy scrut alts => IrCase caseTy resultTy (stripTailAt (fuel - 1) scrut) (map (stripAlt (fuel - 1)) alts)
      IrNatCase scrut fresh zero succ catch => IrNatCase (stripTailAt (fuel - 1) scrut) fresh (stripAltM (fuel - 1) zero) (stripAltM (fuel - 1) succ) (stripAltM (fuel - 1) catch)
      IrConcatMany parts => IrConcatMany (map (stripTailAt (fuel - 1)) parts)
      IrEffThunk family ctor unitTy arity prim => IrEffThunk family ctor unitTy arity (stripTailAt (fuel - 1) prim)
      IrEffBind _ _ _ => ir

stripField : Int -> (String, Ir) -> (String, Ir)
stripField fuel p = (firstOf p, stripTailAt fuel (secondOf p))

stripAlt : Int -> IrAlt -> IrAlt
stripAlt fuel alt = IrAlt alt.irAltCtor alt.irAltBinders (stripTailAt fuel alt.irAltBody)

stripAltM : Int -> Maybe IrAlt -> Maybe IrAlt
stripAltM fuel Nothing = Nothing
stripAltM fuel (Just alt) = Just (stripAlt fuel alt)

annotateAt : Int -> (String -> Maybe Int) -> Bool -> Ir -> Ir
annotateAt fuel arityOf tail ir =
  if fuel <= 0 then
    ir
  else
    case ir of
      IrVar _ => ir
      IrGlobal name =>
        if tail then
          case arityOf name of
            Just 0 => IrTail (IrGlobal name)
            _ => IrGlobal name
        else
          IrGlobal name
      IrCtor family ctor tys args => IrCtor family ctor tys (map (annotateAt (fuel - 1) arityOf False) args)
      IrRecord family resTy fields => IrRecord family resTy (map (annotateField (fuel - 1) arityOf) fields)
      IrProj base family field resTy => IrProj (annotateAt (fuel - 1) arityOf False base) family field resTy
      IrRecUpd base family fields resTy => IrRecUpd (annotateAt (fuel - 1) arityOf False base) family (map (annotateField (fuel - 1) arityOf) fields) resTy
      IrRt sym => if tail then IrTail (IrRt sym) else IrRt sym
      IrRtApp sym args =>
        let
          args2 = map (annotateAt (fuel - 1) arityOf False) args
        in if tail then IrTail (IrRtApp sym args2) else IrRtApp sym args2
      IrCast cFrom cTo inner => IrCast cFrom cTo (annotateAt (fuel - 1) arityOf tail inner)
      IrInt _ => ir
      IrStr _ => ir
      IrBool _ => ir
      IrFloatLit _ => ir
      IrLet bs scrut body => IrLet bs (annotateAt (fuel - 1) arityOf False scrut) (annotateAt (fuel - 1) arityOf tail body)
      IrLam bs rt body => IrLam bs rt (annotateAt (fuel - 1) arityOf True body)
      IrApp appTy f a =>
        let
          f2 = annotateAt (fuel - 1) arityOf False f
          a2 = annotateAt (fuel - 1) arityOf False a
        in if tail then IrTail (IrApp appTy f2 a2) else IrApp appTy f2 a2
      IrTail inner => IrTail (annotateAt (fuel - 1) arityOf False inner)
      IrIf c t el => IrIf (annotateAt (fuel - 1) arityOf False c) (annotateAt (fuel - 1) arityOf tail t) (annotateAt (fuel - 1) arityOf tail el)
      IrCase caseTy resultTy scrut alts => IrCase caseTy resultTy (annotateAt (fuel - 1) arityOf False scrut) (map (annotateAlt (fuel - 1) arityOf tail) alts)
      IrNatCase scrut fresh zero succ catch => IrNatCase (annotateAt (fuel - 1) arityOf False scrut) fresh (annotateAltMaybe (fuel - 1) arityOf tail zero) (annotateAltMaybe (fuel - 1) arityOf tail succ) (annotateAltMaybe (fuel - 1) arityOf tail catch)
      IrConcatMany parts => IrConcatMany (map (annotateAt (fuel - 1) arityOf False) parts)
      IrEffThunk family ctor unitTy arity prim => IrEffThunk family ctor unitTy arity (annotateAt (fuel - 1) arityOf False prim)
      IrEffBind _ _ _ => ir

annotateField : Int -> (String -> Maybe Int) -> (String, Ir) -> (String, Ir)
annotateField fuel arityOf p = (firstOf p, annotateAt fuel arityOf False (secondOf p))

annotateAlt : Int -> (String -> Maybe Int) -> Bool -> IrAlt -> IrAlt
annotateAlt fuel arityOf tail alt =
  IrAlt alt.irAltCtor alt.irAltBinders (annotateAt fuel arityOf tail alt.irAltBody)

annotateAltMaybe : Int -> (String -> Maybe Int) -> Bool -> Maybe IrAlt -> Maybe IrAlt
annotateAltMaybe fuel arityOf tail Nothing = Nothing
annotateAltMaybe fuel arityOf tail (Just alt) = Just (annotateAlt fuel arityOf tail alt)

-- ---------------------------------------------------------------
-- TMC（tail modulo cons）候选
-- ---------------------------------------------------------------
--
-- OCaml 的 `[@tail_mod_cons]` 把「构造子字段位置上的自递归」编译成单遍原地构造
-- （OCaml stdlib 的 `List.map` / `List.init` 就是这样写的）：既不吃深栈的 GC 扫描，
-- 也不用 reverse 复制一遍。只有 OCaml 后端用这条注解；判定放在这里是因为它与尾位置
-- 同一套「结果位置」规则。
--
-- 判据：函数体里自引用的每一次出现都必须落在**结果位置**——尾调用，或构造子的
-- **最后一个字段**（可连续套构造子）——且至少出现一次后者（否则注解没有意义）。
-- 不满足的形状（自引用当值用、在 lambda 里、在非末字段、在实参里）一律返回 False。
-- | 单递归定义是否是 TMC 候选（供 OCaml 后端决定是否加 `[@tail_mod_cons]`）。
export tmcCandidate : IrDef -> Bool
tmcCandidate (IrExternDef _ _ _ _) = False
tmcCandidate (IrDef name _ _ _ body _ _ _) =
  let
    -- 定义体是「λ 包住函数体」：剥掉外层 λ，函数体才是结果位置。
    core = tmcStripLams body
  in case tmcProbe (64 + 16 * irSize core) name True False core of
    (ok, ctorField) => ok && ctorField

tmcStripLams : Ir -> Ir
tmcStripLams (IrLam _ _ body) = tmcStripLams body
tmcStripLams ir = ir

-- | `(ok, hasCtorField)`：自引用是否都合法、是否至少有一次在构造子末字段。
tmcProbe : Int -> String -> Bool -> Bool -> Ir -> (Bool, Bool)
tmcProbe fuel self tail dest ir =
  if fuel <= 0 then
    (True, False)
  else
    case ir of
      IrVar _ => (True, False)
      IrInt _ => (True, False)
      IrStr _ => (True, False)
      IrBool _ => (True, False)
      IrFloatLit _ => (True, False)
      IrRt _ => (True, False)
      IrEffBind _ _ _ => (True, False)
      IrGlobal name => if name == self then if tail || dest then (True, dest) else (False, False) else (True, False)
      -- 已有尾标记（native / wasm 的 pass 会加）：按结果位置继续。
      IrTail inner => tmcProbe (fuel - 1) self True dest inner
      IrCast _ _ inner => tmcProbe (fuel - 1) self tail dest inner
      IrApp _ _ _ => tmcApp (fuel - 1) self tail dest ir
      IrCtor _ _ _ args => tmcCtorArgs (fuel - 1) self (tail || dest) args
      IrProj base _ _ _ => tmcProbe (fuel - 1) self False False base
      IrRecord _ _ fields => tmcFields (fuel - 1) self (map (\f => secondOf f) fields)
      IrRecUpd base _ fields _ => tmcAnd2 (fuel - 1) self (tmcProbe (fuel - 1) self False False base) (tmcFields (fuel - 1) self (map (\f => secondOf f) fields))
      IrRtApp _ args => tmcEach (fuel - 1) self (map (\a => tmcProbe (fuel - 1) self False False a) args)
      IrConcatMany parts => tmcEach (fuel - 1) self (map (\a => tmcProbe (fuel - 1) self False False a) parts)
      IrLet _ scrut body => tmcAnd2 (fuel - 1) self (tmcProbe (fuel - 1) self False False scrut) (tmcProbe (fuel - 1) self tail dest body)
      IrLam _ _ body => tmcProbe (fuel - 1) self False False body
      IrIf c t el => tmcAnd3 (fuel - 1) self (tmcProbe (fuel - 1) self False False c) (tmcProbe (fuel - 1) self tail dest t) (tmcProbe (fuel - 1) self tail dest el)
      IrCase _ _ scrut alts => tmcAnd2 (fuel - 1) self (tmcProbe (fuel - 1) self False False scrut) (tmcAlts (fuel - 1) self tail dest alts)
      IrNatCase scrut fresh zero succ catch => tmcAnd3 (fuel - 1) self (tmcProbe (fuel - 1) self False False scrut) (tmcAltM (fuel - 1) self tail dest zero) (tmcAnd2 (fuel - 1) self (tmcAltM (fuel - 1) self tail dest succ) (tmcAltM (fuel - 1) self tail dest catch))
      IrEffThunk _ _ _ _ prim => tmcProbe (fuel - 1) self False False prim

-- 应用脊：`f a1 a2` 是 `IrApp (IrApp f a1) a2`；头是自引用时整条脊就是一次自调用。
tmcApp : Int -> String -> Bool -> Bool -> Ir -> (Bool, Bool)
tmcApp fuel self tail dest ir =
  case spineOf fuel ir [] of
    (head, args) =>
      case head of
        IrGlobal name =>
          if name == self then
            case tmcEach (fuel - 1) self (map (\a => tmcProbe (fuel - 1) self False False a) args) of
              (okArgs, _) => (okArgs && (tail || dest), dest)
          else
            tmcEach (fuel - 1) self (map (\a => tmcProbe (fuel - 1) self False False a) args)
        _ =>
          tmcAnd2
            (fuel - 1)
            self
            (tmcProbe (fuel - 1) self False False head)
            (tmcEach (fuel - 1) self (map (\a => tmcProbe (fuel - 1) self False False a) args))

spineOf : Int -> Ir -> List Ir -> (Ir, List Ir)
spineOf fuel ir acc =
  if fuel <= 0 then
    (ir, acc)
  else
    case ir of
      IrApp _ f a => spineOf (fuel - 1) f (a :: acc)
      _ => (ir, acc)

-- 构造子字段：只有**最后一个**字段是 TMC 的目的地（可继续套构造子）。
tmcCtorArgs : Int -> String -> Bool -> List Ir -> (Bool, Bool)
tmcCtorArgs fuel self dest args =
  case reverse args of
    [] => (True, False)
    last :: revRest =>
      case tmcEach (fuel - 1) self (map (\a => tmcProbe (fuel - 1) self False False a) revRest) of
        (okRest, _) =>
          case tmcProbe (fuel - 1) self False dest last of
            (okLast, lastField) => (okRest && okLast, lastField)

tmcFields : Int -> String -> List Ir -> (Bool, Bool)
tmcFields fuel self fields =
  tmcEach (fuel - 1) self (map (\f => tmcProbe (fuel - 1) self False False f) fields)

tmcAlts : Int -> String -> Bool -> Bool -> List IrAlt -> (Bool, Bool)
tmcAlts fuel self tail dest alts =
  tmcEach (fuel - 1) self (map (\a => tmcProbe (fuel - 1) self tail dest (irAltBodyOf a)) alts)

tmcAltM : Int -> String -> Bool -> Bool -> Maybe IrAlt -> (Bool, Bool)
tmcAltM fuel self tail dest Nothing = (True, False)
tmcAltM fuel self tail dest (Just alt) = tmcProbe (fuel - 1) self tail dest (irAltBodyOf alt)

tmcEach : Int -> String -> List (Bool, Bool) -> (Bool, Bool)
tmcEach fuel self [] = (True, False)
tmcEach fuel self (p :: rest) = tmcAnd2 fuel self p (tmcEach (fuel - 1) self rest)

tmcAnd2 : Int -> String -> (Bool, Bool) -> (Bool, Bool) -> (Bool, Bool)
tmcAnd2 fuel self a b = (firstOf a && firstOf b, secondOf a || secondOf b)

tmcAnd3 : Int -> String -> (Bool, Bool) -> (Bool, Bool) -> (Bool, Bool) -> (Bool, Bool)
tmcAnd3 fuel self a b c = tmcAnd2 fuel self (tmcAnd2 fuel self a b) c
