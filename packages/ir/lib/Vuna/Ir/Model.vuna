module Vuna.Ir.Model where

-- Vuna.Ir.Model：擦除后中间表示（IR）的数据定义（唯一真源）。
--
-- 定位（Track A 第一步）：`Core --Lower--> IR --OCaml 后端--> 文本`。
-- IR 是 Core 与**唯一**后端之间的显式契约：
--   * 只有运行时定义进 IR：类型级定义 / axiom 不出现，被擦除的实参不产生节点；
--     但**擦除 binder 仍占 de Bruijn 槽位**（`irBinderErased`），因此 IR 的下标与
--     Core 的 de Bruijn 下标逐位一致，Lowering 不需要重编号；
--   * IR 不含 `DtData` / `DtDef` / `Value` / `Closure` 等 Elab/Core 类型，也不含
--     元变量、固定 fuel、模块归属；只有确定性数据（String / Int / Bool / List / Span），
--     为后续 `Canonical.Ir`（内容寻址）留出空间；
--   * **表示语义**（擦除、Nat 字面量折叠、Nat case 降级、case 分支 binder 形状、
--     record 表示、构造子实参对齐、不透明 cast、内建饱和内联、`++` 链展平、
--     入口分类、类型声明的参数槽分配）全部在 Lowering 完成，IR 节点自带全部决策；
--   * **文本**（OCaml 名字编码、跨单元限定、fresh 名字前缀与编号、布局、`let rec`
--     分组文本、运行时模板）只属于后端。IR 里的名字一律是源码名或**目标中立的运行时
--     符号**（`Ir.Runtime` 的契约条目），不含 `v_` / `t_` / `C_` 之类目标前缀，
--     也不含 OCaml 表达式。
--
-- 边界：本模块只 import Base 的纯数据结构与 `Vuna.Compiler.Base.Source` 的 `Span`，
-- 不下钻 Core / Elab / Intrinsics / Codegen。
import Vuna.Compiler.Base.Source

-- ---------------------------------------------------------------
-- 签名级运行时类型表面
-- ---------------------------------------------------------------
--
-- 只覆盖运行时表示能出现的形状：类型参数槽、primitive、程序数据族、显式函数、
-- 两个内建类型构造子、以及运行时不可命名的值（`Obj.t`）。隐式 Pi / 索引 / telescope
-- 在 Lowering 消解，不进 IR。
export data IrTy(..) : Type where
  -- | 数据族的类型参数槽（后端渲染成 `'a<i>`）。
  IrTyVar : Int -> IrTy
  -- | `Int` primitive。
  IrTyInt : IrTy
  -- | `String` primitive。
  IrTyStr : IrTy
  -- | `Bool`（canonical 族的运行时表示就是 OCaml bool）。
  IrTyBool : IrTy
  -- | `Float` primitive。
  IrTyFloat : IrTy
  -- | 运行时不可命名的值（OCaml `Obj.t`）。
  IrTyOpaque : IrTy
  -- | `Array a` 内建类型构造子。
  IrTyArray : IrTy -> IrTy
  -- | `IORef a` 内建类型构造子。
  IrTyRef : IrTy -> IrTy
  -- | 程序数据族应用（族名 + 运行时类型实参）。
  IrTyData : String -> List IrTy -> IrTy
  -- | 显式函数类型（隐式 Pi 已剥掉）。
  IrTyFun : IrTy -> IrTy -> IrTy

-- | 用类型实参替换 `IrTyVar` 槽；越界/缺失的槽落 `IrTyOpaque`。
export irTySubstVars : List IrTy -> IrTy -> IrTy
irTySubstVars args (IrTyVar i) = irTyVarAt args i
irTySubstVars args IrTyInt = IrTyInt
irTySubstVars args IrTyStr = IrTyStr
irTySubstVars args IrTyBool = IrTyBool
irTySubstVars args IrTyFloat = IrTyFloat
irTySubstVars args IrTyOpaque = IrTyOpaque
irTySubstVars args (IrTyArray a) = IrTyArray (irTySubstVars args a)
irTySubstVars args (IrTyRef a) = IrTyRef (irTySubstVars args a)
irTySubstVars args (IrTyData f xs) = IrTyData f (map (\x => irTySubstVars args x) xs)
irTySubstVars args (IrTyFun d c) = IrTyFun (irTySubstVars args d) (irTySubstVars args c)

irTyVarAt : List IrTy -> Int -> IrTy
irTyVarAt [] _ = IrTyOpaque
irTyVarAt (x :: xs) i = if i <= 0 then x else irTyVarAt xs (i - 1)

-- | 数据族类型应用的实参；非 `IrTyData` 返回空列表。
export irTyDataArgsOf : Maybe IrTy -> List IrTy
irTyDataArgsOf (Just (IrTyData _ args)) = args
irTyDataArgsOf _ = []

-- | 列表按下标取 `IrTy`（越界返回 `Nothing`）。
export irTyAt : List IrTy -> Int -> Maybe IrTy
irTyAt [] _ = Nothing
irTyAt (x :: xs) i = if i <= 0 then Just x else irTyAt xs (i - 1)

-- | 这条运行时类型能否安全写进 OCaml 的 binder 注解：整条类型都可命名
-- （不含 `IrTyOpaque` / 类型变量槽）。含不透明部分的注解会固定 OCaml 的多态性
-- （例如把 `List (a -> b)` 的元素注解成 `Obj.t`），所以只在可命名时写。
export irTyAnnotatable : IrTy -> Bool
irTyAnnotatable (IrTyVar _) = False
irTyAnnotatable IrTyInt = True
irTyAnnotatable IrTyStr = True
irTyAnnotatable IrTyBool = True
irTyAnnotatable IrTyFloat = True
irTyAnnotatable IrTyOpaque = False
irTyAnnotatable (IrTyArray a) = irTyAnnotatable a
irTyAnnotatable (IrTyRef a) = irTyAnnotatable a
irTyAnnotatable (IrTyData _ args) = allAnnotatableIrTys args
irTyAnnotatable (IrTyFun a b) = if irTyAnnotatable a then irTyAnnotatable b else False

allAnnotatableIrTys : List IrTy -> Bool
allAnnotatableIrTys [] = True
allAnnotatableIrTys (t :: rest) = if irTyAnnotatable t then allAnnotatableIrTys rest else False

-- ---------------------------------------------------------------
-- binder
-- ---------------------------------------------------------------
--
-- binder 的**身份**在 Lowering 里分配：lambda 参数沿用源码名（后端转义）；
-- 生成器 fresh binder 只带「种类 + 序号」，前缀与编号渲染属后端文本约定
-- （`dtb__<n>` / `dtnat__<n>`）。
export data IrBName(..) : Type where
  -- | 源码 binder 名（后端负责转义 / 保留字处理）。
  IrBUser : String -> IrBName
  -- | case 分支 binder：序号由 Lowering 按生成顺序分配（后端渲染成 `dtb__<n>`）。
  IrBArm : Int -> IrBName
  -- | Nat case 的 scrutinee binder（后端渲染成 `dtnat__<n>`）。
  IrBNat : Int -> IrBName
  -- | 丢弃 binder（渲染成 `_`）。
  IrBWild : IrBName

export record IrBinder(..) where
  -- | 稳定身份：同一次 lowering / pass 产物里**沿作用域链唯一**。
  --   正值 = Lowering 分配；负值 = 各 pass 的保留区间（CPS / ANF / 后端合成）；
  --   `0` = 擦除占位（占槽位但不进运行时，`IrVar` 不得引用）。
  irBinderId : Int
  irBinderName : IrBName
  -- | 擦除占位：占 de Bruijn 槽位，但不进运行时表示（不渲染参数 / pattern）。
  irBinderErased : Bool
  -- | binder 的运行时类型（选择性标注）：`Nothing` = 未记录或运行时类型不可命名。
  irBinderTy : Maybe IrTy

-- | binder 身份：只比稳定 id（名字、类型只是渲染 / 注解）。
export sameBinderId : IrBinder -> IrBinder -> Bool
sameBinderId a b = a.irBinderId == b.irBinderId

-- | 源码名 binder。
export mkIrBinder : Int -> String -> IrBinder
mkIrBinder id name = IrBinder id (IrBUser name) False Nothing

-- | 带运行时类型标注的源码名 binder。
export mkIrBinderTyped : Int -> String -> IrTy -> IrBinder
mkIrBinderTyped id name ty = IrBinder id (IrBUser name) False (Just ty)

-- | 类型未知的运行时 binder（落 `IrTyOpaque`；OCaml 注解会按不可命名过滤）。
export mkIrBinderOpaque : Int -> String -> IrBinder
mkIrBinderOpaque id name = IrBinder id (IrBUser name) False (Just IrTyOpaque)

-- | 擦除占位 binder（id 0：共享哨兵，运行时不可引用）。
export mkIrBinderErased : IrBinder
mkIrBinderErased = IrBinder 0 IrBWild True Nothing

-- | case 分支 fresh binder：稳定 id + 渲染序号。
export mkIrBinderArm : Int -> Int -> IrBinder
mkIrBinderArm id n = IrBinder id (IrBArm n) False Nothing

-- | Nat case scrutinee binder：稳定 id + 渲染序号。
export mkIrBinderNat : Int -> Int -> IrBinder
mkIrBinderNat id n = IrBinder id (IrBNat n) False Nothing

-- | 丢弃 binder（`let _ = e in ...` 的 `_`）。
export mkIrBinderWild : Int -> IrBinder
mkIrBinderWild id = IrBinder id IrBWild False Nothing

-- ---------------------------------------------------------------
-- case 分支
-- ---------------------------------------------------------------
--
-- `irAltCtor = Nothing` 是 catch-all；否则是 (族名, 构造子名)。
-- `irAltBinders` 保留**全部**分支 binder（含擦除占位），因此分支体的 `IrVar` 下标与
-- Core 一致；只有非擦除 binder 进运行时 pattern。
export record IrAlt(..) where
  irAltCtor : Maybe (String, String)
  irAltBinders : List IrBinder
  irAltBody : Ir

-- ---------------------------------------------------------------
-- IR 节点
-- ---------------------------------------------------------------
export data Ir(..) : Type where
  -- | 运行时 binder 引用（Lowering 已把 Core 的 de Bruijn 下标解析成 binder 身份；
  -- 擦除 binder 不进 IR——运行时引用擦除 binder 在 Lowering 就是错误）。
  IrVar : IrBinder -> Ir
  -- | 顶层运行时值定义引用（跨单元限定时由后端加前缀并记依赖）。
  IrGlobal : String -> Ir
  -- | 构造子应用：族名、构造子名、运行时类型实参（可选）、运行时实参
  -- （已按 keep 形状对齐、不可命名字段已 cast）。
  IrCtor : String -> String -> Maybe (List IrTy) -> List Ir -> Ir
  -- | record 构造：族名 + 结果运行时类型（可选）+ (字段源码名, 值)（按运行时字段顺序）。
  IrRecord : String -> Maybe IrTy -> List (String, Ir) -> Ir
  -- | record 投影：base、族名、字段源码名、结果运行时类型（可选）。
  IrProj : Ir -> String -> String -> Maybe IrTy -> Ir
  -- | record 更新：base、族名、(字段源码名, 新值)、结果运行时类型（可选）。
  IrRecUpd : Ir -> String -> List (String, Ir) -> Maybe IrTy -> Ir
  -- | 运行时符号引用（目标中立；名字必须在 `Ir.Runtime` 的契约里声明）。
  -- 目标文本由后端按契约映射，IR 里不出现 `bi_*` / `dtp_*` / OCaml 表达式。
  IrRt : String -> Ir
  -- | 运行时符号的饱和应用（内建名 + 实参；模板在后端，arity 由 `irInlineArity` 定）。
  IrRtApp : String -> List Ir -> Ir
  -- | 表现层转换（表示改变、运行时不产生操作；后端渲染成自己的转换形式）。
  -- 两个 `Maybe IrTy` 是源/目标运行时类型（未知时 `Nothing`）。
  IrCast : Maybe IrTy -> Maybe IrTy -> Ir -> Ir
  -- | 整数字面量（含折叠后的 Nat 字面量）。
  IrInt : Int -> Ir
  -- | 字符串字面量（未转义）。
  IrStr : String -> Ir
  -- | 布尔字面量。
  IrBool : Bool -> Ir
  -- | 浮点字面量（原始文本，与源码一致）。
  IrFloatLit : String -> Ir
  -- | `let` 绑定（unboxed case 降级用）。binder 表是**完整 telescope**（含擦除占位），
  -- 因此体的 de Bruijn 下标不变；只有非擦除 binder 进渲染的 pattern。
  IrLet : List IrBinder -> Ir -> Ir -> Ir
  -- | lambda 链（只含运行时 binder；无运行时 binder 时退化成体）。
  -- 第二个字段是体（链的最终结果）的运行时类型；未知时 `Nothing`。
  IrLam : List IrBinder -> Maybe IrTy -> Ir -> Ir
  -- | 应用（擦除实参已在 Lowering 丢弃）。第一个字段是函数类型与结果类型
  -- （`IrTyFun` 的域/余域；未知时 `Nothing`）。
  IrApp : Maybe (IrTy, IrTy) -> Ir -> Ir -> Ir
  -- | 尾位置标记：求值与内层相同。只表示内层处在函数结果位置，后端按自身能力
  -- 决定是否发射尾调用；允许包裹 `IrApp` / `IrRtApp` / `IrRt` / 零参 `IrGlobal`。
  IrTail : Ir -> Ir
  -- | `if`。
  IrIf : Ir -> Ir -> Ir -> Ir
  -- | 通用 `match`：scrutinee 的运行时类型、结果类型（均可缺）+ scrutinee + 分支。
  -- 无 catch-all 时后端补不可达兜底臂，保持 match 完整。
  IrCase : Maybe IrTy -> Maybe IrTy -> Ir -> List IrAlt -> Ir
  -- | Nat case 降级（运行时是 int）：scrutinee、scrutinee 的 fresh 序号（`dtnat__<n>`）、
  -- 零支 / 后继支 / 兜底支。三支的 binder 表同样是完整 telescope。
  IrNatCase : Ir -> Int -> Maybe IrAlt -> Maybe IrAlt -> Maybe IrAlt -> Ir
  -- | `++` 链展平：`String.concat "" [a; b; c]`。
  IrConcatMany : List Ir -> Ir
  -- | 装箱动作构造：族名、构造子名、`EffUnit` 运行时类型、原语运行时 arity、原语节点。
  IrEffThunk : String -> String -> IrTy -> Int -> Ir -> Ir
  -- | 线性 bind 的装箱实现：族名、构造子名、`EffUnit` 运行时类型。
  IrEffBind : String -> String -> IrTy -> Ir

-- | IR 节点的运行时结果类型：只读节点自带的类型槽，未知返回 `Nothing`。
-- 不重新推导类型，因此不会引入第二套精化；只把 Lowering 已经决定的类型槽
-- 汇总成「这个表达式产出什么运行时类型」。
export irResultTyOf : Ir -> Maybe IrTy
irResultTyOf ir = irResultTyFuel 256 ir

irResultTyFuel : Int -> Ir -> Maybe IrTy
irResultTyFuel fuel ir =
  if fuel <= 0 then
    Nothing
  else
    case ir of
      IrVar b => if b.irBinderErased then Nothing else b.irBinderTy
      IrRecord _ resTy _ => resTy
      IrProj _ _ _ resTy => resTy
      IrRecUpd _ _ _ resTy => resTy
      IrCast _ to _ => to
      IrInt _ => Just IrTyInt
      IrStr _ => Just IrTyStr
      IrBool _ => Just IrTyBool
      IrFloatLit _ => Just IrTyFloat
      IrLet _ _ body => irResultTyFuel (fuel - 1) body
      IrLam bs bodyTy _ => irLamTyFuel (fuel - 1) bodyTy bs
      IrApp appTy _ _ =>
        case appTy of
          Just p => Just (secondOf p)
          Nothing => Nothing
      IrTail inner => irResultTyFuel (fuel - 1) inner
      IrIf _ th el =>
        case irResultTyFuel (fuel - 1) th of
          Just ty => Just ty
          Nothing => irResultTyFuel (fuel - 1) el
      IrCase _ resultTy _ _ => resultTy
      IrConcatMany _ => Just IrTyStr
      _ => Nothing

-- lambda 链的运行时函数类型：只含非擦除 binder；binder 类型未记录时域落
-- `IrTyOpaque`（体类型才是调用点的结果，域不可命名不影响 `IrApp` 的结果类型）。
irLamTyFuel : Int -> Maybe IrTy -> List IrBinder -> Maybe IrTy
irLamTyFuel fuel bodyTy bs =
  if fuel <= 0 then
    Nothing
  else
    case bs of
      [] => bodyTy
      b :: rest =>
        case irLamTyFuel (fuel - 1) bodyTy rest of
          Nothing => Nothing
          Just inner =>
            if b.irBinderErased then
              Just inner
            else
              case b.irBinderTy of
                Just ty => Just (IrTyFun ty inner)
                Nothing => Just (IrTyFun IrTyOpaque inner)

-- | `Eff` 的运行时类型名与构造子名：宿主效应直连时后端构造纯动作（`MkEff (\\u => r)`）用。
export irEffTypeName : String
irEffTypeName = "Base.Effect.Core.Eff"

export irEffMkCtor : String
irEffMkCtor = "Base.Effect.Core.Eff.MkEff"

-- ---------------------------------------------------------------
-- 类型声明
-- ---------------------------------------------------------------
--
-- 三族运行时表示（变体 / OCaml record / 去装箱别名）在 Lowering 决定；每条声明带
-- 族名、运行时类型参数个数与 `IrTy` 字段表，后端只做文本渲染与跨单元限定。
export data IrTyDecl(..) : Type where
  -- | 变体族：族名、运行时类型参数个数、[(构造子名, 字段运行时类型表)]。
  IrVariantDecl : String -> Int -> List (String, List IrTy) -> IrTyDecl
  -- | record 族：族名、运行时类型参数个数、(字段序号, 字段源码名) 表、字段运行时类型表。
  IrRecordDecl : String -> Int -> List (Int, String) -> List IrTy -> IrTyDecl
  -- | 去装箱族：族名、运行时类型参数个数、唯一保留字段的运行时类型。
  IrUnboxedDecl : String -> Int -> IrTy -> IrTyDecl

-- ---------------------------------------------------------------
-- 定义与分组
-- ---------------------------------------------------------------
--
-- 只剩运行时定义（类型级定义 / axiom 已被 Lowering 分区掉）。
-- `irDefDeps` 是运行时引用到的顶层定义（Core 遍历顺序的去重表）：SCC 分组吃它，
-- 分组结果与迁移前逐项一致。
export data IrDef(..) : Type where
  -- | 运行时定义：名字、运行时参数个数、依赖、签名类型、体、递归值形状合法、入口期求值守卫、span。
  IrDef : String -> Int -> List String -> Maybe IrTy -> Ir -> Bool -> Bool -> Maybe Span -> IrDef
  -- | 受限 FFI 定义：名字、`external` 运行时类型、C 符号名、span。
  IrExternDef : String -> IrTy -> String -> Maybe Span -> IrDef

export irDefName : IrDef -> String
irDefName (IrDef name arity deps ty body recOk initGuard span) = name
irDefName (IrExternDef name ty cName span) = name

export irDefArity : IrDef -> Int
irDefArity (IrDef name arity deps ty body recOk initGuard span) = arity
irDefArity (IrExternDef name ty cName span) = 0

export irDefDeps : IrDef -> List String
irDefDeps (IrDef name arity deps ty body recOk initGuard span) = deps
irDefDeps (IrExternDef name ty cName span) = []

export irDefTy : IrDef -> Maybe IrTy
irDefTy (IrDef name arity deps ty body recOk initGuard span) = ty
irDefTy (IrExternDef name ty cName span) = Just ty

export irDefBody : IrDef -> Maybe Ir
irDefBody (IrDef name arity deps ty body recOk initGuard span) = Just body
irDefBody (IrExternDef name ty cName span) = Nothing

export irDefExtern : IrDef -> Maybe (IrTy, String)
irDefExtern (IrDef name arity deps ty body recOk initGuard span) = Nothing
irDefExtern (IrExternDef name ty cName span) = Just (ty, cName)

-- | 零参定义作为 `let rec` 右值是否合法（`let rec` 只接受函数 / 构造子应用）。
export irDefRecValueOk : IrDef -> Bool
irDefRecValueOk (IrDef name arity deps ty body recOk initGuard span) = recOk
irDefRecValueOk (IrExternDef name ty cName span) = True

-- | 定义体是否要包运行时报告器（入口单元零参 `main`：模块初始化期求值）。
export irDefInitGuard : IrDef -> Bool
irDefInitGuard (IrDef name arity deps ty body recOk initGuard span) = initGuard
irDefInitGuard (IrExternDef name ty cName span) = False

export irDefSpan : IrDef -> Maybe Span
irDefSpan (IrDef name arity deps ty body recOk initGuard span) = span
irDefSpan (IrExternDef name ty cName span) = span

-- | 分组：SCC 序 + 该组是否需要 `let rec`。
export record IrGroup(..) where
  irGroupIsRec : Bool
  irGroupDefs : List IrDef

export irGroupIsRec : IrGroup -> Bool
irGroupIsRec (IrGroup isRec defs) = isRec

export irGroupDefs : IrGroup -> List IrDef
irGroupDefs (IrGroup isRec defs) = defs

-- ---------------------------------------------------------------
-- 入口（main 钩子）的已决策形态
-- ---------------------------------------------------------------
--
-- main 的类型拆解（动作 vs 普通值）、展示函数选择、动作行 handler 列表都在 Lowering
-- 完成；后端只按固定钩子模板把名字渲染进文本。
export record IrEntry(..) where
  -- | 展示函数节点（合成符号 `@ir@showInt` 等，或合成的 `@vuna@main_show` 值引用）。
  irEntryShow : Ir
  -- | main 运行时值定义的源码名（通常是 `main`）。
  irEntryMain : String
  -- | main 是否是动作（`Eff r a`）：True 时先跑 `runMain` 与宿主 handler。
  irEntryIsAction : Bool
  -- | 动作 main 的 `runMain` 源码名（非动作为 Nothing）。
  irEntryRunMain : Maybe String
  -- | 动作行里的内建宿主效应 handler（源码名，行顺序：后出现的包在外层）。
  irEntryHandlers : List String
  -- | 动作行里的内建宿主效应标签（行顺序，供目标能力检查）。
  irEntryRowTags : List String

-- ---------------------------------------------------------------
-- 共享元数据 / 单元 / 程序
-- ---------------------------------------------------------------
-- | canonical `Base.Data.List.List` 族的三个源码名（程序没声明时没有）。
export record IrListFam(..) where
  irListFamily : String
  irListNil : String
  irListCons : String

-- | 程序级共享元数据（与单元无关，Lowering 一次算好）。
--
-- 只保留后端渲染真正消费的表示决策结果：record 字段表、canonical List 族、
-- float / tracing / obs 开关与定义位置行。构造子形状、去装箱集合、类型参数槽都是
-- Lowering 内部的查表输入，不进 IR。
export record IrShared(..) where
  -- | 用 OCaml record 表示的族 → 运行时字段表 `(字段序号, 字段源码名)`。
  -- case 分支的 record pattern 需要它；构造 / 投影 / 更新节点自带字段名。
  irSharedRecordFields : List (String, List (Int, String))
  -- | canonical List 族（没有声明时 Nothing）。
  irSharedListFam : Maybe IrListFam
  -- | 程序是否用到浮点（决定 `Vuna_runtime.ml` 是否追加浮点 helper）。
  irSharedUsesFloat : Bool
  -- | 程序是否用到编译器 tracing 隐藏原语（决定是否追加 tracing helper）。
  irSharedUsesTrace : Bool
  -- | 程序是否用到可观测性隐藏原语（决定是否追加 obs runtime；与 tracing 分开，
  -- 让 `dbg!` 程序不背事件缓冲、obs 程序不背 stderr 门控）。
  irSharedUsesObs : Bool
  -- | 运行时定义的位置行：定义名 → (文件, 起始行)。只有带 span 的定义在这里；
  -- 跨单元的 `extraDefLocs` 由调用方与这里合并（顺序无关，落盘前统一排序）。
  irSharedDefLocs : List (String, String, Int)
  -- | 去装箱族：族名 → (唯一构造子名, 保留字段序号)。表示选择 pass 的输入。
  irSharedUnboxed : List (String, String, Int)
  -- | 构造子形状：构造子名 → (族名, keep flags)。pass 把构造子应用/分支 pattern
  -- 改写成去装箱形式时需要它；Lowering 仍在项生成期用它做擦除与实参对齐。
  irSharedCtorShapes : List (String, String, List Bool)

export irSharedUnboxedOf : String -> List (String, String, Int) -> Maybe (String, Int)
irSharedUnboxedOf family [] = Nothing
irSharedUnboxedOf family (p :: rest) =
  if firstOf p == family then Just (secondOf p) else irSharedUnboxedOf family rest

export irSharedCtorShapeOf : String -> List (String, String, List Bool) -> Maybe (String, List Bool)
irSharedCtorShapeOf ctor [] = Nothing
irSharedCtorShapeOf ctor (p :: rest) =
  if firstOf p == ctor then Just (secondOf p) else irSharedCtorShapeOf ctor rest

export irSharedRecordFieldsOf : String -> List (String, List (Int, String)) -> List (Int, String)
irSharedRecordFieldsOf family [] = []
irSharedRecordFieldsOf family (p :: rest) =
  if firstOf p == family then secondOf p else irSharedRecordFieldsOf family rest

-- | 一个编译单元的 IR。
export record IrUnit(..) where
  -- | 本单元写出的类型声明（程序顺序）。
  irUnitTyDecls : List IrTyDecl
  -- | 本单元运行时定义（SCC 序分组）。
  irUnitGroups : List IrGroup
  -- | 本单元是否声明 canonical `Base.Data.List.List` 族（决定是否写桥接 helper）。
  irUnitHasListFamily : Bool
  -- | 本单元类型声明里出现过的全局名（`typeDepsOf` 的输入，含擦除位置引用）。
  irUnitTypeRefs : List String
  -- | 入口单元（`Main`）的入口形态；库单元为 Nothing。
  irUnitEntry : Maybe IrEntry

-- | 整个程序的 IR（check 路径把它当一个单元装配）。
export record IrProgram(..) where
  irProgShared : IrShared
  irProgUnit : IrUnit

-- | 内建饱和应用的内联 arity（名字 → 运行时参数个数；0 = 不可内联）。
--
-- 这是**形态决策**的输入（「饱和应用能否内联」），不是文本：具体运算符模板只在 OCaml
-- 后端。放在 IR 模型里是因为 Lowering 与后端必须用同一张表，各写一份会漂移。
export irInlineArity : String -> Int
irInlineArity "+" = 2
irInlineArity "-" = 2
irInlineArity "*" = 2
irInlineArity "/" = 2
irInlineArity "&&" = 2
irInlineArity "||" = 2
irInlineArity "bitAnd" = 2
irInlineArity "bitOr" = 2
irInlineArity "bitXor" = 2
irInlineArity "bitNot" = 1
irInlineArity "bitShl" = 2
irInlineArity "bitShr" = 2
irInlineArity "++" = 2
irInlineArity "bi_eq_int" = 2
irInlineArity "bi_neq_int" = 2
irInlineArity "effectId" = 1
irInlineArity "bi_eq_str" = 2
irInlineArity "bi_neq_str" = 2
irInlineArity "bi_lt_int" = 2
irInlineArity "bi_le_int" = 2
irInlineArity "bi_gt_int" = 2
irInlineArity "bi_ge_int" = 2
irInlineArity "bi_lt_str" = 2
irInlineArity "bi_le_str" = 2
irInlineArity "bi_gt_str" = 2
irInlineArity "bi_ge_str" = 2
irInlineArity "bi_lt_bool" = 2
irInlineArity "bi_le_bool" = 2
irInlineArity "bi_gt_bool" = 2
irInlineArity "bi_ge_bool" = 2
irInlineArity "bi_add_float" = 2
irInlineArity "bi_sub_float" = 2
irInlineArity "bi_mul_float" = 2
irInlineArity "bi_div_float" = 2
irInlineArity "bi_eq_float" = 2
irInlineArity "bi_neq_float" = 2
irInlineArity "bi_lt_float" = 2
irInlineArity "bi_le_float" = 2
irInlineArity "bi_gt_float" = 2
irInlineArity "bi_ge_float" = 2
irInlineArity "@ir@m@runEff" = 2
irInlineArity "natToInt" = 1
irInlineArity "natFromInt" = 1
irInlineArity "natAdd" = 2
irInlineArity "natSub" = 2
irInlineArity "natMul" = 2
irInlineArity "natDiv" = 2
irInlineArity _ = 0

-- | canonical List 族名。
export irListFamilyOf : IrListFam -> String
irListFamilyOf (IrListFam fam nil cons) = fam

-- | canonical List 的 nil 构造子名。
export irListNilOf : IrListFam -> String
irListNilOf (IrListFam fam nil cons) = nil

-- | canonical List 的 cons 构造子名。
export irListConsOf : IrListFam -> String
irListConsOf (IrListFam fam nil cons) = cons

-- | 分支的构造子（`Nothing` = catch-all）。
export irAltCtorOf : IrAlt -> Maybe (String, String)
irAltCtorOf (IrAlt ctor bs body) = ctor

-- | 分支的 binder 表（完整 telescope，含擦除占位）。
export irAltBindersOf : IrAlt -> List IrBinder
irAltBindersOf (IrAlt ctor bs body) = bs

-- | 分支体。
export irAltBodyOf : IrAlt -> Ir
irAltBodyOf (IrAlt ctor bs body) = body

-- | 入口展示函数节点。
export irEntryShowOf : IrEntry -> Ir
irEntryShowOf (IrEntry show main isAction runMain handlers rowTags) = show

-- | 入口 main 的源码名。
export irEntryMainOf : IrEntry -> String
irEntryMainOf (IrEntry show main isAction runMain handlers rowTags) = main

-- | main 是否是动作。
export irEntryIsActionOf : IrEntry -> Bool
irEntryIsActionOf (IrEntry show main isAction runMain handlers rowTags) = isAction

-- | 动作 main 的 `runMain` 源码名。
export irEntryRunMainOf : IrEntry -> Maybe String
irEntryRunMainOf (IrEntry show main isAction runMain handlers rowTags) = runMain

-- | 动作行的内建宿主 handler（源码名表）。
export irEntryHandlersOf : IrEntry -> List String
irEntryHandlersOf (IrEntry show main isAction runMain handlers rowTags) = handlers

-- | 动作行的内建宿主效应标签。
export irEntryRowTagsOf : IrEntry -> List String
irEntryRowTagsOf (IrEntry show main isAction runMain handlers rowTags) = rowTags

-- | 程序级共享元数据。
export irProgSharedOf : IrProgram -> IrShared
irProgSharedOf (IrProgram shared unit) = shared

-- | 程序的（唯一）单元 IR。
export irProgUnitOf : IrProgram -> IrUnit
irProgUnitOf (IrProgram shared unit) = unit

-- ---------------------------------------------------------------
-- 结构规模（派生预算用）
-- ---------------------------------------------------------------
-- | 节点数（含 binder / 分支体）；只做结构遍历，不展开定义。
export irSize : Ir -> Int
irSize (IrTail inner) = irSize inner
irSize ir = 1 + irSizeChildren ir

irSizeChildren : Ir -> Int
irSizeChildren (IrCtor family ctor _ args) = irSizeList args
irSizeChildren (IrRecord family _ fields) = irSizeFields fields
irSizeChildren (IrProj base family field _) = irSize base
irSizeChildren (IrRecUpd base family fields _) = irSize base + irSizeFields fields
irSizeChildren (IrRtApp sym args) = irSizeList args
irSizeChildren (IrCast cFrom cTo inner) = irSize inner
irSizeChildren (IrLet bs scrut body) = irSize scrut + irSize body
irSizeChildren (IrLam bs _ body) = irSize body
irSizeChildren (IrApp _ f a) = irSize f + irSize a
irSizeChildren (IrTail inner) = irSize inner
irSizeChildren (IrIf c th el) = irSize c + irSize th + irSize el
irSizeChildren (IrCase _ _ scrut alts) = irSize scrut + irSizeAlts alts
irSizeChildren (IrNatCase scrut fresh zero succ catch) =
  irSize scrut + irSizeAlt zero + irSizeAlt succ + irSizeAlt catch
irSizeChildren (IrConcatMany parts) = irSizeList parts
irSizeChildren (IrEffThunk family ctor unitTy arity prim) = irSize prim
irSizeChildren _ = 0

export irSizeList : List Ir -> Int
irSizeList [] = 0
irSizeList (ir :: rest) = irSize ir + irSizeList rest

irSizeFields : List (String, Ir) -> Int
irSizeFields [] = 0
irSizeFields ((label, ir) :: rest) = irSize ir + irSizeFields rest

irSizeAlts : List IrAlt -> Int
irSizeAlts [] = 0
irSizeAlts (alt :: rest) = irSize (irAltBodyOf alt) + irSizeAlts rest

irSizeAlt : Maybe IrAlt -> Int
irSizeAlt Nothing = 0
irSizeAlt (Just alt) = irSize (irAltBodyOf alt)
