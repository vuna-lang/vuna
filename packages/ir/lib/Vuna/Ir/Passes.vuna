-- | 优化链的 pass 表：名字、层、kind 与观测 span 的唯一真源。
module Vuna.Ir.Passes where

-- pass 表是**纯数据**：顺序声明与实现分开，表可以被单测、`--only` 与观测词汇表共用。
-- 各后端的驱动仍按自己的数据依赖串接步骤（例如 native 的段间查询），表只回答
-- 「有哪些步骤、叫什么、属于哪一层、是否要在前后校验 / dump」。
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.String as String
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Obs
import Vuna.Ir.Model
import Vuna.Ir.Validate

-- | 一个优化步骤的元数据。`psCheckBefore` / `psCheckAfter` / `psDump` 是给驱动的声明，
-- 不把函数放进记录（不同层的返回类型不同，记录保持可比较、可测试的纯数据）。
export record PassSpec(..) where
  psName : String
  psLayer : String
  psKind : String
  psCheckBefore : Bool
  psCheckAfter : Bool
  psDump : Bool

-- | 事件名：`vuna.pass.<name>`。
export passEventName : String -> String
passEventName name = "vuna.pass.${name}"

-- | 把一步求值放进 `ph:"X"` 跨度。返回类型多态：IR 链是 `Result`，native 链是
-- `List IrDef` 或元组，同一个包装都能用，不需要为每层新增类型。
export passSpan : PassSpec -> (Int -> a) -> a
passSpan spec f = obsPure (passEventName spec.psName) f

-- ---------------------------------------------------------------
-- IR 链（`Ir.Cps.cpsDefsMachine`）
-- ---------------------------------------------------------------
export irCps : PassSpec
irCps = PassSpec "ir.cps" "ir" "lower" True True True

export irMachineHandlers : PassSpec
irMachineHandlers = PassSpec "ir.machine.handlers" "ir" "lower" False True True

export irMachineMark : PassSpec
irMachineMark = PassSpec "ir.machine.mark" "ir" "mark" False True True

export irMachineApply : PassSpec
irMachineApply = PassSpec "ir.machine.apply" "ir" "lower" False True True

export irMachineSteps : PassSpec
irMachineSteps = PassSpec "ir.machine.steps" "ir" "mark" False True True

export irTailAnnotate : PassSpec
irTailAnnotate = PassSpec "ir.tail.annotate" "ir" "mark" False True True

export irPasses : List PassSpec
irPasses = [irCps, irMachineHandlers, irMachineMark, irMachineApply, irMachineSteps, irTailAnnotate]

-- ---------------------------------------------------------------
-- native 链（`Target.Native.Module.build`）
-- ---------------------------------------------------------------
export nativeCps : PassSpec
nativeCps = PassSpec "native.cps" "native" "lower" False True True

export nativeSpecialize : PassSpec
nativeSpecialize = PassSpec "native.specialize" "native" "inline" False True True

export nativeLsr : PassSpec
nativeLsr = PassSpec "native.lsr" "native" "fold" False True True

export nativeInline : PassSpec
nativeInline = PassSpec "native.inline" "native" "inline" False True True

export nativeInlineAgain : PassSpec
nativeInlineAgain = PassSpec "native.inline.again" "native" "inline" False True True

export nativeLetFloat : PassSpec
nativeLetFloat = PassSpec "native.let-float" "native" "fold" False True True

export nativeCse : PassSpec
nativeCse = PassSpec "native.cse" "native" "fold" False True True

export nativeInlineTail : PassSpec
nativeInlineTail = PassSpec "native.inline.tail" "native" "inline" False True True

export nativeSimplify : PassSpec
nativeSimplify = PassSpec "native.simplify" "native" "fold" False True True

export nativeMergeTailIf : PassSpec
nativeMergeTailIf = PassSpec "native.merge-tail-if" "native" "fold" False True True

export nativeAlias : PassSpec
nativeAlias = PassSpec "native.alias" "native" "fold" False True True

export nativeFoldNatSums : PassSpec
nativeFoldNatSums = PassSpec "native.fold-nat-sums" "native" "fold" False True True

export nativeFoldAffine : PassSpec
nativeFoldAffine = PassSpec "native.fold-affine" "native" "fold" False True True

export nativePrune : PassSpec
nativePrune = PassSpec "native.prune" "native" "prune" False True True

export nativeAliasAgain : PassSpec
nativeAliasAgain = PassSpec "native.alias.again" "native" "fold" False True True

export nativeFloatLets : PassSpec
nativeFloatLets = PassSpec "native.float-lets" "native" "fold" False True True

-- | 可达性收尾（`allocatingDefNames` / `defsUseThread`）：也是整程序遍历，但不在变换链里。
export nativeReach : PassSpec
nativeReach = PassSpec "native.reach" "native" "prune" False False True

-- | 形参区间不动点（整程序多轮），链尾但只能靠 span 归因。
export nativeParams : PassSpec
nativeParams = PassSpec "native.params" "native" "fold" False False True

-- | pass 之间的作用域校验（`Passes.checkAfterAll`）。默认只校验首末两步，全量由
--   `VUNA_STAGE_CHECK=all` 打开，用于 CI 与排查。
export nativeValidate : PassSpec
nativeValidate = PassSpec "native.validate" "native" "mark" False False True

-- | 代码发射（`genDefs` → `NativeFunc` 列表）。
export nativeEmit : PassSpec
nativeEmit = PassSpec "native.emit" "native" "lower" False False True

-- | 入口装配（`initNeeds` / `cafOrderOf` / 运行时函数裁剪）。
export nativeInit : PassSpec
nativeInit = PassSpec "native.init" "native" "prune" False False True

export nativePasses : List PassSpec
nativePasses =
  [
    nativeCps,
    nativeSpecialize,
    nativeLsr,
    nativeInline,
    nativeInlineAgain,
    nativeLetFloat,
    nativeCse,
    nativeInlineTail,
    nativeSimplify,
    nativeMergeTailIf,
    nativeAlias,
    nativeFoldNatSums,
    nativeFoldAffine,
    nativePrune,
    nativeAliasAgain,
    nativeFloatLets,
    nativeReach,
    nativeParams,
    nativeValidate,
    nativeEmit,
    nativeInit
  ]

-- ---------------------------------------------------------------
-- wasm 链（`Target.Wasm.Module.build`；顺序声明随后端接线一起用）
-- ---------------------------------------------------------------
export wasmCps : PassSpec
wasmCps = PassSpec "wasm.cps" "wasm" "lower" False True True

export wasmHostRewrite : PassSpec
wasmHostRewrite = PassSpec "wasm.host-rewrite" "wasm" "lower" False True True

export wasmPrune : PassSpec
wasmPrune = PassSpec "wasm.prune" "wasm" "prune" False True True

export wasmAnf : PassSpec
wasmAnf = PassSpec "wasm.anf" "wasm" "lower" False True True

export wasmTailAnnotate : PassSpec
wasmTailAnnotate = PassSpec "wasm.tail.annotate" "wasm" "mark" False True True

export wasmPasses : List PassSpec
wasmPasses = [wasmHostRewrite, wasmPrune, wasmCps, wasmAnf, wasmTailAnnotate]

-- | 全部 pass 名字（供 `--only` 校验与观测词汇表使用）。
export allPassNames : List String
allPassNames = map psNameOf (append irPasses (append nativePasses wasmPasses))

psNameOf : PassSpec -> String
psNameOf spec = spec.psName

-- | 按名字查表。
export findPass : String -> List PassSpec -> Maybe PassSpec
findPass name [] = Nothing
findPass name (spec :: rest) = if spec.psName == name then Just spec else findPass name rest

-- | 一步之后的 scoped 校验（`psCheckAfter`）：定义名唯一 + `IrVar` 指向语法作用域内的
-- binder。不查运行时符号契约（CPS / 机器 / 后端内部符号不在 `Ir.Runtime` 里）。返回的
-- 错误带 pass 名，驱动直接把它当作该步失败。
export checkPassAfter : PassSpec -> List IrDef -> Result Int
checkPassAfter spec ds =
  if spec.psCheckAfter then
    case Vuna.Ir.Validate.validateScopedDefs ds of
      ErrC e => Err "pass ${spec.psName}: ${diagText e}"
      OkC n => Ok n
  else
    Ok 0

-- | 一步之前的 scoped 校验（`psCheckBefore`）：与 `checkPassAfter` 同口径，用于链首
-- 输入与「上一步没有跑 after 校验」的驱动。
export checkPassBefore : PassSpec -> List IrDef -> Result Int
checkPassBefore spec ds =
  if spec.psCheckBefore then
    case Vuna.Ir.Validate.validateScopedDefs ds of
      ErrC e => Err "pass ${spec.psName} (before): ${diagText e}"
      OkC n => Ok n
  else
    Ok 0

-- | 依次检查一批（pass, 该步输出）对；第一个失败即停。驱动在链尾统一调用，避免把
-- 校验塞进每一步的嵌套 `let`。
export checkAfterAll : List (PassSpec, List IrDef) -> Result Int
checkAfterAll [] = Ok 0
checkAfterAll ((spec, ds) :: rest) =
  case checkPassAfter spec ds of
    Err msg => Err msg
    Ok _ => checkAfterAll rest

-- | 按模式挑出要校验的步骤：`full` 为真取全部，否则只取首末两项。
export selectStages : Bool -> List (PassSpec, List IrDef) -> List (PassSpec, List IrDef)
selectStages full stages =
  if full then
    stages
  else
    case stages of
      [] => []
      first :: rest => first :: takeLast 1 rest

takeLast : Int -> List a -> List a
takeLast n xs = List.take n (List.reverse xs)
