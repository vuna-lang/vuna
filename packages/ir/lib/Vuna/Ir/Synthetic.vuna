module Vuna.Ir.Synthetic where

-- Vuna.Ir.Synthetic：后端在降级期合成的 IR 片段（助记符 + 保留 binder 区间）。
--
-- 为什么在这里：native 与 wasm 都要把 `IrEffThunk` 展开成
-- `MkEff (\_ => prim args)`，并把零参定义 eta 展开成 `\p… => f p…`。两端的这段
-- 构造曾经各写一份（`applyAllIr` / `backendBinderId` / `effUnitBinder` / `effArgBinders`），
-- 逐字相同，只有错误文本与 `IrApp` 的类型槽不同。IR 形状不属于目标，所以放在 IR 层。
--
-- `IrApp` 的类型槽：本模块一律用 `Nothing`（两端原本就是 `IrApp Nothing`）。需要类型槽的
-- 调用方自己拼 `IrApp (Just …)`，CPS 的 `applyAll` 就是那种情形，不复用这里的版本。
--
-- 边界：本模块只 import `Ir.Model`；不 import Core/Elab/Intrinsics 与任何后端。
import Vuna.Ir.Model

-- | 左折叠应用：`f a b c` 展开成 `((f a) b) c`。
export applyAllIr : Ir -> List Ir -> Ir
applyAllIr f [] = f
applyAllIr f (a :: rest) = applyAllIr (IrApp Nothing f a) rest

-- | 后端合成 binder 的保留 id 区间：负值且远离 Lowering / CPS / ANF 的编号。
export backendBinderId : Int -> Int
backendBinderId n = 0 - (200000000000000000 + n)

-- | 效应 thunk 的丢弃 binder（`\_ => …`）。
export effUnitBinder : IrBinder
effUnitBinder = IrBinder (backendBinderId 1) (IrBUser "effUnitArg") False Nothing

-- | 效应 thunk 的原语实参 binder（`\a0 a1 … => …`）。
export effArgBinders : Int -> List IrBinder
effArgBinders n =
  map
    (\i => IrBinder (backendBinderId (100 + i)) (IrBUser ("effArg" ++ strFromInt i)) False Nothing)
    (range 0 n)

-- | eta 展开用的 binder（`\p0 p1 … =>`）。
export etaBinders : Int -> List IrBinder
etaBinders n =
  map
    (\i => IrBinder (backendBinderId (200 + i)) (IrBUser ("__eta" ++ strFromInt i)) False Nothing)
    (range 0 n)

-- | 效应原语包装成 `\_ => prim args`；arity > 0 时再包一层参数 lambda。
--   `Eff` 在运行时就是 thunk 本身（不分配构造子），所以这里不套 `MkEff`。
export effThunkIr : Int -> Ir -> Ir
effThunkIr arity prim =
  let
    bs = effArgBinders arity
    applied = applyAllIr prim (map (\b => IrVar b) bs)
    thunk = IrLam [effUnitBinder] Nothing applied
  in if arity <= 0 then thunk else IrLam bs Nothing thunk

-- ---------------------------------------------------------------
-- `case e of MkEff f -> body` 规范化成 `let f = e in body`
-- ---------------------------------------------------------------
-- `Eff` 在运行时就是 thunk（`MkEff` 不分配，见 `Ir.Synthetic.effThunkIr`），
-- 所以拆构造子就是取值本身。早先只有 OCaml 后端在 `IrCase` 上特判；CPS 输出
-- 统一成 `let` 之后，三端吃同一形态（native / wasm 不会对闭包做 tag 分派）。
export effCaseToLet : Int -> Ir -> Ir
effCaseToLet fuel e =
  if fuel <= 0 then
    e
  else
    case e of
      IrCase caseTy resTy scrut [IrAlt (Just (fam, ctor)) bs body] => if fam == irEffTypeName && ctor == irEffMkCtor then IrLet bs (effCaseToLet (fuel - 1) scrut) (effCaseToLet (fuel - 1) body) else IrCase caseTy resTy (effCaseToLet (fuel - 1) scrut) [IrAlt (Just (fam, ctor)) bs (effCaseToLet (fuel - 1) body)]
      IrCase caseTy resTy scrut alts => IrCase caseTy resTy (effCaseToLet (fuel - 1) scrut) (effCaseToLetAlts (fuel - 1) alts)
      IrNatCase sc fr z su ca => IrNatCase (effCaseToLet (fuel - 1) sc) fr (effCaseToLetAltM (fuel - 1) z) (effCaseToLetAltM (fuel - 1) su) (effCaseToLetAltM (fuel - 1) ca)
      IrCtor fam ctor tys args => IrCtor fam ctor tys (effCaseToLetList (fuel - 1) args)
      IrRecord fam ty fs => IrRecord fam ty (effCaseToLetFields (fuel - 1) fs)
      IrProj b fam x ty => IrProj (effCaseToLet (fuel - 1) b) fam x ty
      IrRecUpd b fam fs ty => IrRecUpd (effCaseToLet (fuel - 1) b) fam (effCaseToLetFields (fuel - 1) fs) ty
      IrCast cFrom cTo x => IrCast cFrom cTo (effCaseToLet (fuel - 1) x)
      IrLet bs rhs body => IrLet bs (effCaseToLet (fuel - 1) rhs) (effCaseToLet (fuel - 1) body)
      IrLam bs rt body => IrLam bs rt (effCaseToLet (fuel - 1) body)
      IrApp ty f a => IrApp ty (effCaseToLet (fuel - 1) f) (effCaseToLet (fuel - 1) a)
      IrTail inner => IrTail (effCaseToLet (fuel - 1) inner)
      IrIf c t el => IrIf (effCaseToLet (fuel - 1) c) (effCaseToLet (fuel - 1) t) (effCaseToLet (fuel - 1) el)
      IrConcatMany xs => IrConcatMany (effCaseToLetList (fuel - 1) xs)
      IrEffThunk fam ctor u ar prim => IrEffThunk fam ctor u ar (effCaseToLet (fuel - 1) prim)
      _ => e

effCaseToLetList : Int -> List Ir -> List Ir
effCaseToLetList fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => effCaseToLet (fuel - 1) x :: effCaseToLetList (fuel - 1) rest

effCaseToLetFields : Int -> List (String, Ir) -> List (String, Ir)
effCaseToLetFields fuel fs =
  if fuel <= 0 then
    fs
  else
    case fs of
      [] => []
      p :: rest => (firstOf p, effCaseToLet (fuel - 1) (secondOf p)) :: effCaseToLetFields (fuel - 1) rest

effCaseToLetAlts : Int -> List IrAlt -> List IrAlt
effCaseToLetAlts fuel alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (effCaseToLet (fuel - 1) a.irAltBody) :: effCaseToLetAlts (fuel - 1) rest

effCaseToLetAltM : Int -> Maybe IrAlt -> Maybe IrAlt
effCaseToLetAltM fuel m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (effCaseToLet (fuel - 1) a.irAltBody))

export effCaseToLetDef : IrDef -> IrDef
effCaseToLetDef (IrDef n ar deps sigTy body r g sp) =
  IrDef n ar deps sigTy (effCaseToLet (64 + 8 * irSize body) body) r g sp
effCaseToLetDef d = d
