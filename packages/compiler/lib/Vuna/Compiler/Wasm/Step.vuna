module Vuna.Compiler.Wasm.Step where

-- wasm 效应执行的选择性 Step 表示（Eff 仍是数据，只驱动 CPS 化的 thunk）。
--
-- `$step` 的 tag：
--   0 Done      a=value
--   1 Perform   a=key b=name c=op d=k
--   2 Handle    a=key b=name c=ret d=opH e=comp f=u g=kOuter
--   3 Self      a=th b=k
--   4 Abort     a=targetFrame b=value
-- `$runres`：driver 的返回（0 normal a=value；1 abort a=target b=value）。
import Base.Bool
import Base.Int
import Base.List
import Base.Pair
import Vuna.Compiler.Wasm.Instr
import Vuna.Compiler.Wasm.Model

-- | Step 协议类型；由 wasm 模块在 full-CPS 模式发射。
cat : List (List Instr) -> List Instr
cat xs = concatMap (\x => x) xs

export stepTypes : List WatType
stepTypes =
  [ WatStructType "$step" [WatField False WvI32, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$runres" [WatField False WvI32, WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$hframe" [WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$kctx" [WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$kctx2" [WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef]
  ]

-- ---------------------------------------------------------------
-- 选择性 CPS driver（Eff 仍是数据，只驱动效应 thunk）
-- ---------------------------------------------------------------
rtSelDone : WatFunc
rtSelDone =
  rtFunc "$rt_selDone" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [IConstI32 0, ILocalGet "$p0", IRefNull, IRefNull, IRefNull, IRefNull, IRefNull, IRefNull, IStructNew "$step"]

rtSelPerform : WatFunc
rtSelPerform =
  rtFunc "$rt_selPerform"
    [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef, Pair "$p3" WvAnyRef] [WvAnyRef]
    []
    [IConstI32 1, ILocalGet "$p0", ILocalGet "$p1", ILocalGet "$p2", ILocalGet "$p3", IRefNull, IRefNull, IRefNull, IStructNew "$step"]

rtSelHandle : WatFunc
rtSelHandle =
  rtFunc "$rt_selHandle"
    [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef, Pair "$p3" WvAnyRef, Pair "$p4" WvAnyRef, Pair "$p5" WvAnyRef, Pair "$p6" WvAnyRef]
    [WvAnyRef] []
    [IConstI32 2, ILocalGet "$p0", ILocalGet "$p1", ILocalGet "$p2", ILocalGet "$p3", ILocalGet "$p4", ILocalGet "$p5", ILocalGet "$p6", IStructNew "$step"]

-- | Handle 正常返回：弹 frame（g_stepHandlers = prev），执行 ret，再把结果交给 kOuter。
rtSelHandleDone : WatFunc
rtSelHandleDone =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$f" WvAnyRef, Pair "$r" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "$hframe",
        ILocalSet "$f",
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 5,
        IGlobalSet "$g_stepHandlers",
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 2,
        ILocalGet "$p1",
        ICall "$rt_apply",
        ILocalSet "$r",
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 4,
        ILocalGet "$r",
        ICall "$rt_apply",
        IReturn
      ]
  in rtFunc "$rt_selHandleDone" params [WvAnyRef] locals body

-- | Perform 不 resume 时：弹到 frame，直接交 kOuter（不经过 ret）。
rtSelKDone : WatFunc
rtSelKDone =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$f" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "$hframe",
        ILocalSet "$f",
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 5,
        IGlobalSet "$g_stepHandlers",
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 4,
        ILocalGet "$p1",
        ICall "$rt_apply",
        IReturn
      ]
  in rtFunc "$rt_selKDone" params [WvAnyRef] locals body

rtSelDrive : WatFunc
-- Done
-- Handle
-- Perform
rtSelDrive =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals =
      [ Pair "$s" WvAnyRef,
        Pair "$tag" WvI32,
        Pair "$cur" WvAnyRef,
        Pair "$f" WvAnyRef,
        Pair "$k" WvAnyRef,
        Pair "$kclo" WvAnyRef,
        Pair "$res" WvAnyRef
      ]
    body =
      [ ILocalGet "$p0",
        ILocalSet "$s",
        ILoop "$l" "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 0, ILocalSet "$tag", ILocalGet "$tag", IConstI32 0, IBinop "i32.eq", IIf "" [IConstI32 0, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, IRefNull, IStructNew "$runres", IReturn, IUnreachable] [INop], ILocalGet "$tag", IConstI32 2, IBinop "i32.eq", IIf "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 2, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 3, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 4, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 7, IGlobalGet "$g_stepHandlers", IStructNew "$hframe", ILocalSet "$f", ILocalGet "$f", IGlobalSet "$g_stepHandlers", IRefFunc "$rt_selHandleDone", ILocalGet "$f", IStructNew "$clo", ILocalSet "$kclo", ILocalGet "$s", IRefCast "$step", IStructGet "$step" 5, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 6, ICall "$rt_apply", ILocalGet "$kclo", ICall "$rt_apply", ILocalSet "$s", IBr "$l"] [INop], ILocalGet "$tag", IConstI32 1, IBinop "i32.eq", IIf "" [IGlobalGet "$g_stepHandlers", ILocalSet "$cur", IBlock "$found" "" [ILoop "$j" "" [ILocalGet "$cur", IPlain "ref.is_null", IIf "" [IUnreachable] [INop], ILocalGet "$cur", IRefCast "$hframe", IStructGet "$hframe" 0, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, ICall "$rt_eqStr", IRefCast "i31", II31GetU, ILocalGet "$cur", IRefCast "$hframe", IStructGet "$hframe" 1, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 2, ICall "$rt_eqStr", IRefCast "i31", II31GetU, IBinop "i32.and", IIf "" [IBr "$found"] [INop], ILocalGet "$cur", IRefCast "$hframe", IStructGet "$hframe" 5, ILocalSet "$cur", IBr "$j"]], ILocalGet "$cur", ILocalSet "$f", IRefFunc "$rt_selKDone", ILocalGet "$f", IStructNew "$clo", ILocalSet "$kclo", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 3, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 3, ICall "$rt_apply", ILocalGet "$s", IRefCast "$step", IStructGet "$step" 4, ICall "$rt_apply", ILocalGet "$kclo", ICall "$rt_apply", ILocalSet "$s", IBr "$l"] [INop], IUnreachable],
        IUnreachable
      ]
  in rtFunc "$rt_selDrive" params [WvAnyRef] locals body

rtSelRun : WatFunc
rtSelRun =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$res" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefNull,
        ICall "$rt_selDrive",
        ILocalSet "$res",
        ILocalGet "$res",
        IRefCast "$runres",
        IStructGet "$runres" 0,
        IConstI32 0,
        IBinop "i32.eq",
        IIf "" [ILocalGet "$res", IRefCast "$runres", IStructGet "$runres" 1, IReturn] [IUnreachable],
        IUnreachable
      ]
  in rtFunc "$rt_selRun" params [WvAnyRef] locals body

export selFunctions : List WatFunc
selFunctions =
  [rtSelDone, rtSelPerform, rtSelHandle, rtSelHandleDone, rtSelKDone, rtSelDrive, rtSelRun]

rtFunc : String -> List (Pair String WatValTy) -> List WatValTy -> List (Pair String WatValTy) -> List Instr -> WatFunc
rtFunc name params results locals body = WatFunc name "" params results locals body
