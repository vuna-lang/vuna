module Vuna.Compiler.Wasm.Step where

-- wasm 效应执行的选择性 Step 表示（Eff 仍是数据，只驱动 CPS 化的 thunk）。
--
-- `$step` 的 tag：
--   0 Done      a=value
--   1 Perform   a=key b=name c=op d=k
--   2 Handle    a=key b=name c=ret d=opH e=comp f=u g=kOuter
--   3 Self      a=th b=k
--   4 Abort     a=targetFrame b=value
-- `$runres`：driver 的返回（0 normal a=value；1 abort a=target b=value）。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Pair as Pair
import Vuna.Compiler.Wasm.Instr
import Vuna.Compiler.Wasm.Model

-- | Step 协议类型；由 wasm 模块在 full-CPS 模式发射。
cat : List (List Instr) -> List Instr
cat xs = concatMap (\x => x) xs

export stepTypes : List WatType
stepTypes =
  [ WatStructType "$step" [WatField False WvI32, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$runres" [WatField False WvI32, WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$selK" [WatField False WvAnyRef, WatField True WvI32],
    WatStructType "$mres1" [WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$mres2" [WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$mctx" [WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$hframe" [WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvI32],
    WatStructType "$kctx" [WatField False WvAnyRef, WatField False WvAnyRef],
    WatStructType "$kctx2" [WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef]
  ]

-- ---------------------------------------------------------------
-- 显式效应机器（方案 A）：Continuation 只返回 Control，循环单层派发
-- ---------------------------------------------------------------
rtMDone : WatFunc
rtMDone =
  rtFunc "$rt_mDone" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [IConstI32 0, ILocalGet "$p0", IRefNull, IRefNull, IRefNull, IRefNull, IRefNull, IRefNull, IStructNew "$step"]

rtMPerform : WatFunc
rtMPerform =
  rtFunc "$rt_mPerform"
    [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef, Pair "$p3" WvAnyRef] [WvAnyRef]
    []
    [IConstI32 1, ILocalGet "$p0", ILocalGet "$p1", ILocalGet "$p2", ILocalGet "$p3", IConstI32 0, IStructNew "$selK", IRefNull, IRefNull, IRefNull, IStructNew "$step"]

rtMHandle : WatFunc
rtMHandle =
  rtFunc "$rt_mHandle"
    [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef, Pair "$p3" WvAnyRef, Pair "$p4" WvAnyRef, Pair "$p5" WvAnyRef, Pair "$p6" WvAnyRef]
    [WvAnyRef] []
    [IConstI32 2, ILocalGet "$p0", ILocalGet "$p1", ILocalGet "$p2", ILocalGet "$p3", ILocalGet "$p4", ILocalGet "$p5", ILocalGet "$p6", IStructNew "$step"]

rtMKComp : WatFunc
rtMKComp =
  rtFunc "$rt_mKComp" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [IConstI32 3, ILocalGet "$p0", ILocalGet "$p1", IRefNull, IRefNull, IRefNull, IRefNull, IRefNull, IStructNew "$step"]

-- | 续延转移：唯一形态。机器循环派发（一次迭代一次 wasm 调用）。
rtMApply : WatFunc
rtMApply =
  rtFunc "$rt_mApply" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [IConstI32 4, ILocalGet "$p0", ILocalGet "$p1", IRefNull, IRefNull, IRefNull, IRefNull, IRefNull, IStructNew "$step"]

-- | handler 的 answer 落地：在 resume 期间（ctx 命中同一帧）交回该次 resume 的
-- kRest，让外层 perform 的日志/handler 链继续；否则弹帧交 kOuter。
-- | 用续延 K 跑一个 Eff 的 thunk（dummy 单元取 null：thunk 体不看它）。
rtMRunEff : WatFunc
rtMRunEff =
  rtFunc "$rt_mRunEff" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefNull, ICall "$rt_apply", ILocalGet "$p1", ICall "$rt_apply"]

-- | frame 是否已经在 handler 链上（resume 时判断需不需要重新装回）。
rtMInChain : WatFunc
rtMInChain =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$cur" WvAnyRef]
    body =
      [ ILocalGet "$p1",
        ILocalSet "$cur",
        IBlock "$done" "" [ILoop "$l" "" [ILocalGet "$cur", IPlain "ref.is_null", IBrIf "$done", ILocalGet "$cur", IRefCast "$hframe", ILocalGet "$p0", IRefCast "$hframe", IPlain "ref.eq", IBrIf "$done", ILocalGet "$cur", IRefCast "$hframe", IStructGet "$hframe" 5, ILocalSet "$cur", IBr "$l"]],
        ILocalGet "$cur",
        IPlain "ref.is_null",
        IPlain "i32.eqz"
      ]
  in rtFunc "$rt_mInChain" params [WvI32] locals body

-- | `handleScoped`/`handleSelf`：把当前最内层 handler 帧重新装到 th 上跑，
-- answer 交给当前续延（等价于 kOuter = k 的 Handle）。
rtMSelf : WatFunc
rtMSelf =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$f" WvAnyRef]
    body =
      [ IGlobalGet "$g_stepHandlers",
        ILocalSet "$f",
        ILocalGet "$f",
        IPlain "ref.is_null",
        IIf "" [IUnreachable] [INop],
        IConstI32 2,
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 0,
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 1,
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 2,
        ILocalGet "$f",
        IRefCast "$hframe",
        IStructGet "$hframe" 3,
        ILocalGet "$p0",
        IRefNull,
        ILocalGet "$p1",
        IStructNew "$step"
      ]
  in rtFunc "$rt_mSelf" params [WvAnyRef] locals body

-- | 退出钩子：把 `f` 的 base 之上的 cleanup 全部跑掉（bracket/finally 的 abort 路径）。
-- 正常路径由 `bracket` 自己在带内 pop，所以这里退化成 no-op。
rtMRunCleanups : WatFunc
rtMRunCleanups =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$f" WvAnyRef, Pair "$c" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "$hframe",
        ILocalSet "$f",
        IBlock "$done" "" [ILoop "$l" "" [IGlobalGet "$g_cleanDepth", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 6, IBinop "i32.le_s", IBrIf "$done", IGlobalGet "$g_cleanups", IPlain "ref.is_null", IBrIf "$done", IGlobalGet "$g_cleanups", IRefCast "$clean", ILocalSet "$c", ILocalGet "$c", IRefCast "$clean", IStructGet "$clean" 1, IGlobalSet "$g_cleanups", IGlobalGet "$g_cleanDepth", IConstI32 1, IBinop "i32.sub", IGlobalSet "$g_cleanDepth", ILocalGet "$c", IRefCast "$clean", IStructGet "$clean" 0, IConstI64 0, IStructNew "$int", ICall "$rt_apply", IBr "$l"]]
      ]
  in rtFunc "$rt_mRunCleanups" params [] locals body

rtMKDone : WatFunc
rtMKDone =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$f" WvAnyRef, Pair "$ctx" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "$hframe",
        ILocalSet "$f",
        ILocalGet "$f",
        ICall "$rt_mRunCleanups",
        IGlobalGet "$g_mctx",
        ILocalSet "$ctx",
        ILocalGet "$ctx",
        IPlain "ref.is_null",
        IIf "" [ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 5, IGlobalSet "$g_stepHandlers", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 4, ILocalGet "$p1", ICall "$rt_apply", IReturn] [ILocalGet "$ctx", IRefCast "$mctx", IStructGet "$mctx" 0, IRefCast "$hframe", ILocalGet "$f", IRefCast "$hframe", IPlain "ref.eq", IIf "" [ILocalGet "$ctx", IRefCast "$mctx", IStructGet "$mctx" 2, IGlobalSet "$g_mctx", ILocalGet "$ctx", IRefCast "$mctx", IStructGet "$mctx" 1, ILocalGet "$p1", ICall "$rt_apply", IReturn] [ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 5, IGlobalSet "$g_stepHandlers", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 4, ILocalGet "$p1", ICall "$rt_apply", IReturn]],
        IUnreachable
      ]
  in rtFunc "$rt_mKDone" params [WvAnyRef] locals body

rtMPureThunk1 : WatFunc
rtMPureThunk1 =
  rtFunc "$rt_mPureThunk1" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [IRefFunc "$rt_mPureThunk2", ILocalGet "$p0", IStructNew "$clo"]

rtMPureThunk2 : WatFunc
rtMPureThunk2 =
  rtFunc "$rt_mPureThunk2" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p1", ILocalGet "$p0", ICall "$rt_apply", ILocalSet "$p0", ILocalGet "$p0", IReturn]

rtMKAns : WatFunc
rtMKAns =
  rtFunc "$rt_mKAns" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p1", ICall "$rt_mDone", IReturn]

rtMRes1 : WatFunc
rtMRes1 =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$e" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "$mres1",
        ILocalSet "$e",
        IRefFunc "$rt_mRes2",
        ILocalGet "$e",
        IRefCast "$mres1",
        IStructGet "$mres1" 0,
        ILocalGet "$e",
        IRefCast "$mres1",
        IStructGet "$mres1" 1,
        ILocalGet "$p1",
        IStructNew "$mres2",
        IStructNew "$clo"
      ]
  in rtFunc "$rt_mRes1" params [WvAnyRef] locals body

rtMRes2 : WatFunc
-- 转移而不是调用：resume 之后的计算由循环派发，resume 链不占 wasm 帧
-- 只有 frame 已被 pop（answer 已交出去）时才重新装回被恢复的段
rtMRes2 =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals =
      [ Pair "$e" WvAnyRef,
        Pair "$k" (WvRef "$selK"),
        Pair "$hs" WvAnyRef,
        Pair "$here" WvI32,
        Pair "$step" WvAnyRef
      ]
    body =
      [ ILocalGet "$p0",
        IRefCast "$mres2",
        ILocalSet "$e",
        IGlobalGet "$g_stepHandlers",
        ILocalSet "$hs",
        ILocalGet "$e",
        IRefCast "$mres2",
        IStructGet "$mres2" 0,
        IGlobalGet "$g_stepHandlers",
        ICall "$rt_mInChain",
        ILocalSet "$here",
        ILocalGet "$e",
        IRefCast "$mres2",
        IStructGet "$mres2" 0,
        ILocalGet "$p1",
        IGlobalGet "$g_mctx",
        ILocalGet "$here",
        IIf "anyref" [IRefNull] [ILocalGet "$hs"],
        IStructNew "$mctx",
        IGlobalSet "$g_mctx",
        ILocalGet "$here",
        IIf "" [INop] [ILocalGet "$e", IRefCast "$mres2", IStructGet "$mres2" 0, IRefCast "$hframe", IStructGet "$hframe" 0, ILocalGet "$e", IRefCast "$mres2", IStructGet "$mres2" 0, IRefCast "$hframe", IStructGet "$hframe" 1, ILocalGet "$e", IRefCast "$mres2", IStructGet "$mres2" 0, IRefCast "$hframe", IStructGet "$hframe" 2, ILocalGet "$e", IRefCast "$mres2", IStructGet "$mres2" 0, IRefCast "$hframe", IStructGet "$hframe" 3, ILocalGet "$e", IRefCast "$mres2", IStructGet "$mres2" 0, IRefCast "$hframe", IStructGet "$hframe" 4, IGlobalGet "$g_stepHandlers", ILocalGet "$e", IRefCast "$mres2", IStructGet "$mres2" 0, IRefCast "$hframe", IStructGet "$hframe" 6, IStructNew "$hframe", IGlobalSet "$g_stepHandlers"],
        ILocalGet "$e",
        IRefCast "$mres2",
        IStructGet "$mres2" 1,
        IRefCast "$selK",
        ILocalSet "$k",
        ILocalGet "$k",
        IStructGet "$selK" 1,
        IIf "" [ICall "$rt_resumeTwice"] [INop],
        ILocalGet "$k",
        IConstI32 1,
        IStructSet "$selK" 1,
        ILocalGet "$k",
        IStructGet "$selK" 0,
        ILocalGet "$e",
        IRefCast "$mres2",
        IStructGet "$mres2" 2,
        ICall "$rt_mApply",
        IReturn
      ]
  in rtFunc "$rt_mRes2" params [WvAnyRef] locals body

rtMRun : WatFunc
rtMRun =
  let
    params = [Pair "$p0" WvAnyRef]
    locals =
      [ Pair "$s" WvAnyRef,
        Pair "$tag" WvI32,
        Pair "$cur" WvAnyRef,
        Pair "$f" WvAnyRef,
        Pair "$kclo" WvAnyRef,
        Pair "$ctx" WvAnyRef,
        Pair "$v" WvAnyRef,
        Pair "$hh" WvAnyRef,
        Pair "$kdone" WvAnyRef
      ]
    body =
      [ IRefNull,
        IGlobalSet "$g_mctx",
        ILocalGet "$p0",
        ILocalSet "$s",
        ILoop "$l" "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 0, ILocalSet "$tag", ILocalGet "$tag", IConstI32 0, IBinop "i32.eq", IIf "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, IReturn, IUnreachable] [INop], ILocalGet "$tag", IConstI32 3, IBinop "i32.eq", IIf "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, ILocalSet "$f", ILocalGet "$s", IRefCast "$step", IStructGet "$step" 2, ILocalSet "$v", IGlobalGet "$g_mctx", ILocalSet "$ctx", ILocalGet "$ctx", IPlain "ref.is_null", IIf "" [ILocalGet "$f", ICall "$rt_mRunCleanups", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 5, IGlobalSet "$g_stepHandlers", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 4, ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 2, ILocalGet "$v", ICall "$rt_apply", ICall "$rt_apply", ILocalSet "$s"] [ILocalGet "$ctx", IRefCast "$mctx", IStructGet "$mctx" 0, IRefCast "$hframe", ILocalGet "$f", IRefCast "$hframe", IPlain "ref.eq", IIf "" [ILocalGet "$ctx", IRefCast "$mctx", IStructGet "$mctx" 2, IGlobalSet "$g_mctx", ILocalGet "$ctx", IRefCast "$mctx", IStructGet "$mctx" 3, ILocalSet "$hh", ILocalGet "$hh", IPlain "ref.is_null", IIf "" [INop] [ILocalGet "$hh", IRefCast "$hframe", IGlobalSet "$g_stepHandlers"], ILocalGet "$ctx", IRefCast "$mctx", IStructGet "$mctx" 1, ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 2, ILocalGet "$v", ICall "$rt_apply", ICall "$rt_apply", ILocalSet "$s"] [ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 5, IGlobalSet "$g_stepHandlers", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 4, ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 2, ILocalGet "$v", ICall "$rt_apply", ICall "$rt_apply", ILocalSet "$s"]], IBr "$l"] [INop], ILocalGet "$tag", IConstI32 4, IBinop "i32.eq", IIf "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 2, ICall "$rt_apply", ILocalSet "$s", IBr "$l"] [INop], ILocalGet "$tag", IConstI32 2, IBinop "i32.eq", IIf "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 2, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 3, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 4, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 7, IGlobalGet "$g_stepHandlers", IGlobalGet "$g_cleanDepth", IStructNew "$hframe", ILocalSet "$f", ILocalGet "$f", IGlobalSet "$g_stepHandlers", IRefFunc "$rt_mKComp", ILocalGet "$f", IStructNew "$clo", ILocalSet "$kclo", ILocalGet "$s", IRefCast "$step", IStructGet "$step" 5, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 6, ICall "$rt_apply", ILocalGet "$kclo", ICall "$rt_apply", ILocalSet "$s", IBr "$l"] [INop], ILocalGet "$tag", IConstI32 1, IBinop "i32.eq", IIf "" [IGlobalGet "$g_stepHandlers", ILocalSet "$cur", IBlock "$found" "" [ILoop "$j" "" [ILocalGet "$cur", IPlain "ref.is_null", IIf "" [ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 2, ICall "$rt_cpsUnhandled2", IUnreachable] [INop], ILocalGet "$cur", IRefCast "$hframe", IStructGet "$hframe" 0, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 1, ICall "$rt_eqStr", IRefCast "i31", II31GetU, ILocalGet "$cur", IRefCast "$hframe", IStructGet "$hframe" 1, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 2, ICall "$rt_eqStr", IRefCast "i31", II31GetU, IBinop "i32.and", IIf "" [IBr "$found"] [INop], ILocalGet "$cur", IRefCast "$hframe", IStructGet "$hframe" 5, ILocalSet "$cur", IBr "$j"]], ILocalGet "$cur", ILocalSet "$f", IRefFunc "$rt_mRes1", ILocalGet "$f", ILocalGet "$s", IRefCast "$step", IStructGet "$step" 4, IStructNew "$mres1", IStructNew "$clo", ILocalSet "$kclo", IRefFunc "$rt_mKDone", ILocalGet "$f", IStructNew "$clo", ILocalSet "$kdone", ILocalGet "$f", IRefCast "$hframe", IStructGet "$hframe" 3, ILocalGet "$s", IRefCast "$step", IStructGet "$step" 3, ICall "$rt_apply", ILocalGet "$kclo", ICall "$rt_apply", ILocalGet "$kdone", ICall "$rt_apply", ILocalSet "$s", IBr "$l"] [INop], IUnreachable],
        IUnreachable
      ]
  in rtFunc "$rt_mRun" params [WvAnyRef] locals body

export mFunctions : List WatFunc
mFunctions =
  [ rtMDone,
    rtMPerform,
    rtMHandle,
    rtMKComp,
    rtMApply,
    rtMInChain,
    rtMRunCleanups,
    rtMSelf,
    rtMRunEff,
    rtMKDone,
    rtMRes1,
    rtMRes2,
    rtMPureThunk1,
    rtMPureThunk2,
    rtMKAns,
    rtMRun
  ]

rtFunc : String -> List (Pair String WatValTy) -> List WatValTy -> List (Pair String WatValTy) -> List Instr -> WatFunc
rtFunc name params results locals body = WatFunc name "" params results locals body
