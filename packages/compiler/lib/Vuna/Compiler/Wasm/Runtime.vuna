-- ---------------------------------------------------------------
-- 数组（不可变、copy-on-write）
-- ---------------------------------------------------------------
-- 表示沿用 `$arr`（`anyref` 数组）：`array.len` 是长度，元素是任意运行时值。
-- `arraySet` 先整块复制再写，原数组不变；越界读/写走 `$rt_arrayOob`。
rtArrayLength : WatFunc
rtArrayLength =
  rtFunc
    "$rt_arrayLength"
    [Pair "$p0" WvAnyRef]
    [WvAnyRef]
    []
    [ILocalGet "$p0", IRefCast "$arr", IArrayLen, IPlain "i64.extend_i32_u", IStructNew "$int"]

rtArrayGet : WatFunc
rtArrayGet =
  let
    locals = [Pair "$ix" WvI32]
    oob = [ICall "$rt_arrayOob", IUnreachable]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$arr", IArrayLen, ILocalSet "$ix"], unboxInt 1, [IPlain "i32.wrap_i64", ILocalSet "$ix"], [ILocalGet "$ix", IConstI32 0, IBinop "i32.lt_s", IIf "" oob [], ILocalGet "$ix", ILocalGet "$p0", IRefCast "$arr", IArrayLen, IBinop "i32.ge_s", IIf "" oob [], ILocalGet "$p0", IRefCast "$arr", ILocalGet "$ix", IArrayGet "$arr"]]
  in rtFunc "$rt_arrayGet" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] locals body

rtArraySet : WatFunc
rtArraySet =
  let
    locals = [Pair "$ix" WvI32, Pair "$n" WvI32, Pair "$new" (WvRef "$arr")]
    oob = [ICall "$rt_arrayOob", IUnreachable]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$arr", IArrayLen, ILocalSet "$n"], unboxInt 1, [IPlain "i32.wrap_i64", ILocalSet "$ix"], [ILocalGet "$ix", IConstI32 0, IBinop "i32.lt_s", IIf "" oob [], ILocalGet "$ix", ILocalGet "$n", IBinop "i32.ge_s", IIf "" oob [], ILocalGet "$n", IArrayNewDefault "$arr", ILocalSet "$new", ILocalGet "$new", IConstI32 0, ILocalGet "$p0", IRefCast "$arr", IConstI32 0, ILocalGet "$n", IArrayCopy "$arr" "$arr", ILocalGet "$new", ILocalGet "$ix", ILocalGet "$p2", IArraySet "$arr", ILocalGet "$new"]]
  in rtFunc
    "$rt_arraySet"
    [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef]
    [WvAnyRef]
    locals
    body

rtArrayMake : WatFunc
rtArrayMake =
  let
    locals = [Pair "$n" WvI32, Pair "$out" (WvRef "$arr"), Pair "$i" WvI32]
    body =
      cat
        [unboxInt 0, [IPlain "i32.wrap_i64", ILocalSet "$n", ILocalGet "$n", IArrayNewDefault "$arr", ILocalSet "$out", IConstI32 0, ILocalSet "$i"], [IBlock "$am_done" "" [ILoop "$am_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_s", IBrIf "$am_done", ILocalGet "$out", ILocalGet "$i", ILocalGet "$p1", IArraySet "$arr", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$am_l"]]], [ILocalGet "$out"]]
  in rtFunc "$rt_arrayMake" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] locals body

-- | `strFromInt` / `showInt` / `showNat`。
rtStrFromInt : WatFunc
rtStrFromInt =
  let
    params = [Pair "$p0" WvAnyRef]
    locals =
      [
        Pair "$n" WvI64,
        Pair "$neg" WvI32,
        Pair "$m" WvI64,
        Pair "$tmp" WvI64,
        Pair "$digits" WvI32,
        Pair "$len" WvI32,
        Pair "$out" (WvRef "$str"),
        Pair "$i" WvI32,
        Pair "$d" WvI64
      ]
    signPart =
      [
        ILocalGet "$n",
        IConstI64 0,
        IBinop "i64.lt_s",
        IIf
          ""
          [IConstI32 1, ILocalSet "$neg", IConstI64 0, ILocalGet "$n", IBinop "i64.sub", ILocalSet "$m"]
          [IConstI32 0, ILocalSet "$neg", ILocalGet "$n", ILocalSet "$m"]
      ]
    digitsPart =
      [
        IConstI32 1,
        ILocalSet "$digits",
        ILocalGet "$m",
        ILocalSet "$tmp",
        IBlock
          "$digits_done"
          ""
          [ILoop "$digits_l" "" [ILocalGet "$tmp", IConstI64 10, IBinop "i64.lt_u", IBrIf "$digits_done", ILocalGet "$tmp", IConstI64 10, IBinop "i64.div_u", ILocalSet "$tmp", ILocalGet "$digits", IConstI32 1, IBinop "i32.add", ILocalSet "$digits", IBr "$digits_l"]]
      ]
    allocPart =
      [
        ILocalGet "$digits",
        ILocalGet "$neg",
        IBinop "i32.add",
        ILocalSet "$len",
        ILocalGet "$len",
        IArrayNewDefault "$str",
        ILocalSet "$out",
        ILocalGet "$len",
        IConstI32 1,
        IBinop "i32.sub",
        ILocalSet "$i"
      ]
    signOut =
      [ILocalGet "$neg", IIf "" [ILocalGet "$out", IConstI32 0, IConstI32 45, IArraySet "$str"] []]
    fillPart =
      [
        IBlock
          "$fill_done"
          ""
          [ILoop "$fill_l" "" [ILocalGet "$m", IConstI64 10, IBinop "i64.rem_u", ILocalSet "$d", ILocalGet "$out", ILocalGet "$i", ILocalGet "$d", IPlain "i32.wrap_i64", IConstI32 48, IBinop "i32.add", IArraySet "$str", ILocalGet "$i", IConstI32 1, IBinop "i32.sub", ILocalSet "$i", ILocalGet "$m", IConstI64 10, IBinop "i64.div_u", ILocalSet "$m", ILocalGet "$m", IConstI64 0, IBinop "i64.gt_u", IBrIf "$fill_l"]]
      ]
    body =
      cat
        [unboxInt 0, [ILocalSet "$n"], signPart, digitsPart, allocPart, signOut, fillPart, [ILocalGet "$out"]]
  in rtFunc "$rt_strFromInt" params [WvAnyRef] locals body

rtShowInt : WatFunc
rtShowInt = rtStrFromInt

rtShowBool : RtConsts -> WatFunc
rtShowBool c =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      [
        ILocalGet "$p0",
        IRefCast "i31",
        II31GetU,
        IIf "anyref" (mkString c.rtcTrueOff c.rtcTrueLen) (mkString c.rtcFalseOff c.rtcFalseLen)
      ]
  in rtFunc "$rt_showBool" params [WvAnyRef] [] body

-- | 单字节转义判定：置 `$esc`，并把需要改写字符的 `$c` 换成转义后的可见字符。
-- 与 OCaml 的 `dt_show_string` 逐条对齐：`"`、`\`、换行、制表、回车。
escapePair : Int -> Int -> List Instr
escapePair code mapped =
  [
    ILocalGet "$c",
    IConstI32 code,
    IBinop "i32.eq",
    IIf "" [IConstI32 1, ILocalSet "$esc", IConstI32 mapped, ILocalSet "$c"] []
  ]

escapeStepAll : List Instr
escapeStepAll =
  cat
    [[IConstI32 0, ILocalSet "$esc"], escapePair 34 34, escapePair 92 92, escapePair 10 110, escapePair 9 116, escapePair 13 114]

-- | `showStr`：`"` 包裹，按 `dt_show_string` 转义。两遍扫描：先算转义后的长度再填充，
-- 避免预先分配过多、尾部未用字节被 `array.len` 当成内容。
rtShowStr : WatFunc
rtShowStr =
  let
    params = [Pair "$p0" WvAnyRef]
    locals =
      [
        Pair "$src" (WvRef "$str"),
        Pair "$n" WvI32,
        Pair "$len" WvI32,
        Pair "$i" WvI32,
        Pair "$o" WvI32,
        Pair "$c" WvI32,
        Pair "$esc" WvI32,
        Pair "$out" (WvRef "$str")
      ]
    loadChar = [ILocalGet "$src", ILocalGet "$i", IArrayGetU "$str", ILocalSet "$c"]
    bumpLen =
      [
        ILocalGet "$len",
        ILocalGet "$esc",
        IIf "i32" [IConstI32 2] [IConstI32 1],
        IBinop "i32.add",
        ILocalSet "$len"
      ]
    bumpIdx = [ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i"]
    lengthCond = [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_u", IBrIf "$ss_len_done"]
    lengthStep = append (cat [loadChar, escapeStepAll, bumpLen, bumpIdx]) [IBr "$ss_len_l"]
    lengthLoop = [IBlock "$ss_len_done" "" [ILoop "$ss_len_l" "" (append lengthCond lengthStep)]]
    writeEsc = [ILocalGet "$out", ILocalGet "$o", IConstI32 92, IArraySet "$str"]
    bumpOut = [ILocalGet "$o", IConstI32 1, IBinop "i32.add", ILocalSet "$o"]
    writeChar = [ILocalGet "$out", ILocalGet "$o", ILocalGet "$c", IArraySet "$str"]
    fillCond = [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_u", IBrIf "$ss_fill_done"]
    fillStep =
      append
        (cat [loadChar, escapeStepAll, [ILocalGet "$esc", IIf "" (append writeEsc bumpOut) []], writeChar, bumpOut, bumpIdx])
        [IBr "$ss_fill_l"]
    fillLoop = [IBlock "$ss_fill_done" "" [ILoop "$ss_fill_l" "" (append fillCond fillStep)]]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$src", ILocalGet "$src", IArrayLen, ILocalSet "$n", IConstI32 2, ILocalSet "$len", IConstI32 0, ILocalSet "$i"], lengthLoop, [ILocalGet "$len", IArrayNewDefault "$str", ILocalSet "$out"], [ILocalGet "$out", IConstI32 0, IConstI32 34, IArraySet "$str", IConstI32 0, ILocalSet "$i", IConstI32 1, ILocalSet "$o"], fillLoop, [ILocalGet "$out", ILocalGet "$o", IConstI32 34, IArraySet "$str", ILocalGet "$out"]]
  in rtFunc "$rt_showStr" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- 除法/失败辅助
-- ---------------------------------------------------------------
export failWithConst : Int -> Int -> List Instr
failWithConst off len = cat [mkString off len, [ICall "$rt_failStr", IUnreachable]]

rtDiv : RtConsts -> WatFunc
rtDiv c =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$b", IConstI64 0, IBinop "i64.eq", IIf "i64" (failWithConst c.rtcDivOff c.rtcDivLen) [ILocalGet "$a", IConstI64 (0 - 4611686018427387903 - 1), IBinop "i64.eq", ILocalGet "$b", IConstI64 (0 - 1), IBinop "i64.eq", IBinop "i32.and", IIf "i64" [IConstI64 (0 - 4611686018427387903 - 1)] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.div_s"]]], boxInt]
  in rtFunc "$rt_div" params [WvAnyRef] locals body

rtAssert : RtConsts -> WatFunc
rtAssert c =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef]
    locals = [Pair "$m" WvAnyRef]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "i31", II31GetU], [IIf "anyref" [ILocalGet "$p2"] (cat [mkString c.rtcAssertOff c.rtcAssertLen, [ILocalGet "$p1", ICall "$rt_strConcat", ILocalSet "$m"], [ILocalGet "$m", ICall "$rt_failStr", IUnreachable]])]]
  in rtFunc "$rt_assert" params [WvAnyRef] locals body

rtPrimFail : WatFunc
rtPrimFail =
  let
    params = [Pair "$p0" WvAnyRef]
    body = [ILocalGet "$p0", ICall "$rt_failStr", IUnreachable]
  in rtFunc "$rt_primFail" params [WvAnyRef] [] body

rtTodo : RtConsts -> WatFunc
rtTodo c =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      cat
        [mkString c.rtcTodoOff c.rtcTodoLen, [ILocalGet "$p0"], [ICall "$rt_strConcat"], [ICall "$rt_failStr", IUnreachable]]
  in rtFunc "$rt_todo" params [WvAnyRef] [] body

rtErase : WatFunc
rtErase =
  let
    params = [Pair "$p0" WvAnyRef]
  in rtFunc "$rt_erase" params [WvAnyRef] [] [ILocalGet "$p0"]

rtStrConcat : WatFunc
rtStrConcat =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals =
      [
        Pair "$a" (WvRef "$str"),
        Pair "$b" (WvRef "$str"),
        Pair "$na" WvI32,
        Pair "$nb" WvI32,
        Pair "$out" (WvRef "$str")
      ]
    body =
      [
        ILocalGet "$p0",
        IRefCast "$str",
        ILocalSet "$a",
        ILocalGet "$p1",
        IRefCast "$str",
        ILocalSet "$b",
        ILocalGet "$a",
        IArrayLen,
        ILocalSet "$na",
        ILocalGet "$b",
        IArrayLen,
        ILocalSet "$nb",
        ILocalGet "$na",
        ILocalGet "$nb",
        IBinop "i32.add",
        IArrayNewDefault "$str",
        ILocalSet "$out",
        ILocalGet "$out",
        IConstI32 0,
        ILocalGet "$a",
        IConstI32 0,
        ILocalGet "$na",
        IArrayCopy "$str" "$str",
        ILocalGet "$out",
        ILocalGet "$na",
        ILocalGet "$b",
        IConstI32 0,
        ILocalGet "$nb",
        IArrayCopy "$str" "$str",
        ILocalGet "$out"
      ]
  in rtFunc "$rt_strConcat" params [WvAnyRef] locals body

rtNatSucc : WatFunc
rtNatSucc =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$n"], [ILocalGet "$n", IConstI64 4611686018427387903, IBinop "i64.ge_s", IIf "i64" [IConstI64 4611686018427387903] [ILocalGet "$n", IConstI64 1, IBinop "i64.add"]], boxInt]
  in rtFunc "$rt_natSucc" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- Nat 原语（饱和语义，参考 `Codegen.Term` 的 `bi_nat*`）
-- ---------------------------------------------------------------
maxInt63 : Int
maxInt63 = 4611686018427387903

rtNatAdd : WatFunc
rtNatAdd =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$a", IConstI64 maxInt63, ILocalGet "$b", IBinop "i64.sub", IBinop "i64.gt_s", IIf "i64" [IConstI64 maxInt63] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.add"]], boxInt]
  in rtFunc "$rt_natAdd" params [WvAnyRef] locals body

rtNatSub : WatFunc
rtNatSub =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$a", ILocalGet "$b", IBinop "i64.le_s", IIf "i64" [IConstI64 0] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.sub"]], boxInt]
  in rtFunc "$rt_natSub" params [WvAnyRef] locals body

rtNatMul : WatFunc
rtNatMul =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    inner =
      [
        ILocalGet "$a",
        IConstI64 maxInt63,
        ILocalGet "$b",
        IBinop "i64.div_s",
        IBinop "i64.gt_s",
        IIf "i64" [IConstI64 maxInt63] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.mul"]
      ]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$a", IConstI64 0, IBinop "i64.le_s", ILocalGet "$b", IConstI64 0, IBinop "i64.le_s", IBinop "i32.or", IIf "i64" [IConstI64 0] inner], boxInt]
  in rtFunc "$rt_natMul" params [WvAnyRef] locals body

rtNatDiv : RtConsts -> WatFunc
rtNatDiv c =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$b", IConstI64 0, IBinop "i64.eq", IIf "i64" (failWithConst c.rtcDivOff c.rtcDivLen) [ILocalGet "$a", ILocalGet "$b", IBinop "i64.div_s"]], boxInt]
  in rtFunc "$rt_natDiv" params [WvAnyRef] locals body

-- | `natToInt`：无损提升，表示上恒等。
rtNatToInt : WatFunc
rtNatToInt =
  let
    params = [Pair "$p0" WvAnyRef]
  in rtFunc "$rt_natToInt" params [WvAnyRef] [] [ILocalGet "$p0"]

-- | `natFromInt`：有损，负数钳成 0。
rtNatFromInt : WatFunc
rtNatFromInt =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$n"], [ILocalGet "$n", IConstI64 0, IBinop "i64.le_s", IIf "i64" [IConstI64 0] [ILocalGet "$n"]], boxInt]
  in rtFunc "$rt_natFromInt" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- String 原语（参考 `Codegen.Term` 的 `bi_strLength` / `dtp_str*`）
-- ---------------------------------------------------------------
rtStrLength : WatFunc
rtStrLength =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      [ILocalGet "$p0", IRefCast "$str", IArrayLen, IPlain "i64.extend_i32_s", IStructNew "$int"]
  in rtFunc "$rt_strLength" params [WvAnyRef] [] body

-- | `strAt`：越界返回 `-1`（对齐 OCaml 的 `dtp_strAt` 哨兵）。
rtStrAt : WatFunc
rtStrAt =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$s" (WvRef "$str"), Pair "$n" WvI32, Pair "$i" WvI64]
    outOfRange =
      [
        ILocalGet "$i",
        IConstI64 0,
        IBinop "i64.lt_s",
        ILocalGet "$i",
        ILocalGet "$n",
        IPlain "i64.extend_i32_s",
        IBinop "i64.ge_s",
        IBinop "i32.or"
      ]
    inRange =
      [
        ILocalGet "$s",
        ILocalGet "$i",
        IPlain "i32.wrap_i64",
        IArrayGetU "$str",
        IPlain "i64.extend_i32_s"
      ]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$s", ILocalGet "$s", IArrayLen, ILocalSet "$n"], unboxInt 1, [ILocalSet "$i"], outOfRange, [IIf "i64" [IConstI64 (0 - 1)] inRange], boxInt]
  in rtFunc "$rt_strAt" params [WvAnyRef] locals body

-- | `strSubstring(start, len, s)`：参数序与 `Intrinsics` 的类型一致（start, len, s）。
rtSubstring : WatFunc
rtSubstring =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef]
    locals =
      [
        Pair "$s" (WvRef "$str"),
        Pair "$n" WvI32,
        Pair "$st" WvI32,
        Pair "$ln" WvI32,
        Pair "$start" WvI64,
        Pair "$len" WvI64,
        Pair "$out" (WvRef "$str")
      ]
    clampStart =
      [
        ILocalGet "$start",
        IConstI64 0,
        IBinop "i64.lt_s",
        IIf
          "i32"
          [IConstI32 0]
          [ILocalGet "$start", ILocalGet "$n", IPlain "i64.extend_i32_s", IBinop "i64.gt_s", IIf "i32" [ILocalGet "$n"] [ILocalGet "$start", IPlain "i32.wrap_i64"]]
      ]
    clampLen =
      [
        ILocalGet "$len",
        IConstI64 0,
        IBinop "i64.lt_s",
        IIf
          "i32"
          [IConstI32 0]
          [ILocalGet "$st", ILocalGet "$len", IPlain "i32.wrap_i64", IBinop "i32.add", ILocalGet "$n", IBinop "i32.gt_u", IIf "i32" [ILocalGet "$n", ILocalGet "$st", IBinop "i32.sub"] [ILocalGet "$len", IPlain "i32.wrap_i64"]]
      ]
    body =
      cat
        [[ILocalGet "$p2", IRefCast "$str", ILocalSet "$s", ILocalGet "$s", IArrayLen, ILocalSet "$n"], unboxInt 0, [ILocalSet "$start"], unboxInt 1, [ILocalSet "$len"], clampStart, [ILocalSet "$st"], clampLen, [ILocalSet "$ln"], [ILocalGet "$ln", IArrayNewDefault "$str", ILocalSet "$out"], [ILocalGet "$out", IConstI32 0, ILocalGet "$s", ILocalGet "$st", ILocalGet "$ln", IArrayCopy "$str" "$str"], [ILocalGet "$out"]]
  in rtFunc "$rt_substring" params [WvAnyRef] locals body

-- | `strHash`：`(h * 33 + byte) land 1023`，与 OCaml 的 `dtp_strHash` 逐字一致。
rtStrHash : WatFunc
rtStrHash =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$s" (WvRef "$str"), Pair "$n" WvI32, Pair "$i" WvI32, Pair "$h" WvI64]
    loop =
      [
        IBlock
          "$hash_done"
          ""
          [ILoop "$hash_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_u", IBrIf "$hash_done", ILocalGet "$h", IConstI64 33, IBinop "i64.mul", ILocalGet "$s", ILocalGet "$i", IArrayGetU "$str", IPlain "i64.extend_i32_u", IBinop "i64.add", IConstI64 1023, IBinop "i64.and", ILocalSet "$h", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$hash_l"]]
      ]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$s", ILocalGet "$s", IArrayLen, ILocalSet "$n", IConstI32 0, ILocalSet "$i", IConstI64 0, ILocalSet "$h"], loop, [ILocalGet "$h"], boxInt]
  in rtFunc "$rt_strHash" params [WvAnyRef] locals body

-- | 字符串相等：先比长度，再逐字节短路比较（`bi_eq_str`）。
rtEqStr : WatFunc
rtEqStr =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals =
      [
        Pair "$a" (WvRef "$str"),
        Pair "$b" (WvRef "$str"),
        Pair "$na" WvI32,
        Pair "$nb" WvI32,
        Pair "$i" WvI32,
        Pair "$eq" WvI32
      ]
    loop =
      [
        IBlock
          "$eq_done"
          ""
          [ILoop "$eq_l" "" [ILocalGet "$i", ILocalGet "$na", IBinop "i32.ge_u", IBrIf "$eq_done", ILocalGet "$a", ILocalGet "$i", IArrayGetU "$str", ILocalGet "$b", ILocalGet "$i", IArrayGetU "$str", IBinop "i32.ne", IIf "" [IConstI32 0, ILocalSet "$eq", IBr "$eq_done"] [], ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$eq_l"]]
      ]
    lenCheck =
      [
        IBlock
          "$len_done"
          ""
          [ILocalGet "$a", IArrayLen, ILocalSet "$na", ILocalGet "$b", IArrayLen, ILocalSet "$nb", ILocalGet "$na", ILocalGet "$nb", IBinop "i32.ne", IIf "" [IConstI32 0, ILocalSet "$eq", IConstI32 0, ILocalSet "$na", IBr "$len_done"] []]
      ]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$a", ILocalGet "$p1", IRefCast "$str", ILocalSet "$b", IConstI32 1, ILocalSet "$eq", IConstI32 0, ILocalSet "$i"], lenCheck, loop, [ILocalGet "$eq", II31New]]
  in rtFunc "$rt_eqStr" params [WvAnyRef] locals body

-- | 字符串不等：复用 `$rt_eqStr` 再取反（`bi_neq_str`）。
rtNeqStr : WatFunc
rtNeqStr =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body =
      [
        ILocalGet "$p0",
        ILocalGet "$p1",
        ICall "$rt_eqStr",
        IRefCast "i31",
        II31GetU,
        IConstI32 1,
        IBinop "i32.xor",
        II31New
      ]
  in rtFunc "$rt_neqStr" params [WvAnyRef] [] body

rtBoxZero : WatFunc
rtBoxZero =
  let
    params = [Pair "$p0" WvAnyRef]
  in rtFunc "$rt_boxZero" params [WvAnyRef] [] [IConstI64 0, IStructNew "$int"]

-- | `@vuna@debug@on`：1 元常量 False（`dbg!` 的开关在 wasm 上恒关）。
rtConstFalse1 : WatFunc
rtConstFalse1 =
  let
    params = [Pair "$p0" WvAnyRef]
  in rtFunc "$rt_constFalse1" params [WvAnyRef] [] (boolValue False)

-- | 三向比较基元（-1 / 0 / 1）；`$rt_compare` 与字符串/数组比较共用。
--   `i32.sub` 是「先压的减后压的」，所以先算 `x > y`、再算 `x < y`。
rtCmpI32 : WatFunc
rtCmpI32 =
  let
    params = [Pair "$x" WvI32, Pair "$y" WvI32]
    body =
      [
        ILocalGet "$x",
        ILocalGet "$y",
        IBinop "i32.gt_s",
        ILocalGet "$x",
        ILocalGet "$y",
        IBinop "i32.lt_s",
        IBinop "i32.sub"
      ]
  in rtFunc "$rt_cmpI32" params [WvI32] [] body

rtCmpI64 : WatFunc
rtCmpI64 =
  let
    params = [Pair "$x" WvI64, Pair "$y" WvI64]
    body =
      [
        ILocalGet "$x",
        ILocalGet "$y",
        IBinop "i64.gt_s",
        ILocalGet "$x",
        ILocalGet "$y",
        IBinop "i64.lt_s",
        IBinop "i32.sub"
      ]
  in rtFunc "$rt_cmpI64" params [WvI32] [] body

rtCmpF64 : WatFunc
rtCmpF64 =
  let
    params = [Pair "$x" WvF64, Pair "$y" WvF64]
    body =
      [
        ILocalGet "$x",
        ILocalGet "$y",
        IBinop "f64.gt",
        ILocalGet "$x",
        ILocalGet "$y",
        IBinop "f64.lt",
        IBinop "i32.sub"
      ]
  in rtFunc "$rt_cmpF64" params [WvI32] [] body

-- | `bi_*_str` / `bi_*_bool`：把 `$rt_compare` 的结果映射成 Bool（i31）。
rtGenericCmp : String -> String -> WatFunc
rtGenericCmp name op =
  let
    params = [Pair "$a" WvAnyRef, Pair "$b" WvAnyRef]
    body = [ILocalGet "$a", ILocalGet "$b", ICall "$rt_compare", IConstI32 0, IBinop op, II31New]
  in rtFunc name params [WvAnyRef] [] body

rtBoxZero2 : WatFunc
rtBoxZero2 =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
  in rtFunc "$rt_boxZero2" params [WvAnyRef] [] [IConstI64 0, IStructNew "$int"]

-- | 未实现的宿主操作：按 arity 生成显式失败函数（不伪造结果）。
rtHostTrap : RtConsts -> Int -> WatFunc
rtHostTrap c n =
  let
    params = map (\i => Pair ("$p" ++ strFromInt i) WvAnyRef) (range 0 n)
  in rtFunc
    "$rt_hostTrap${strFromInt n}"
    params
    [WvAnyRef]
    []
    (failWithConst c.rtcHostOff c.rtcHostLen)

-- | `bracket` 的 cleanup 登记表：全局 LIFO（无调度器时只有一个 fiber）。
--   正常路径由 `bracket` 自己 pop + 执行 release；异常/中断路径由效应机器在弹帧前跑
--   （`Base.Effect.Core.dropCleanups`），因此这里只维护栈本身。
rtCleanupPush : WatFunc
rtCleanupPush =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      [
        ILocalGet "$p0",
        IGlobalGet "$g_cleanups",
        IStructNew "$clean",
        IGlobalSet "$g_cleanups",
        IGlobalGet "$g_cleanDepth",
        IConstI32 1,
        IBinop "i32.add",
        IGlobalSet "$g_cleanDepth",
        IConstI64 0,
        IStructNew "$int"
      ]
  in rtFunc "$rt_cleanupPush" params [WvAnyRef] [] body

rtCleanupPop : WatFunc
rtCleanupPop =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      [
        IGlobalGet "$g_cleanups",
        IPlain "ref.is_null",
        IIf
          ""
          [INop]
          [IGlobalGet "$g_cleanups", IRefCast "$clean", IStructGet "$clean" 1, IGlobalSet "$g_cleanups", IGlobalGet "$g_cleanDepth", IConstI32 1, IBinop "i32.sub", IGlobalSet "$g_cleanDepth"],
        IConstI64 0,
        IStructNew "$int"
      ]
  in rtFunc "$rt_cleanupPop" params [WvAnyRef] [] body

-- | 高阶 obs span：关闭观测时等价于把 thunk 应用到 0。叶子原语已是 no-op 桩。
rtObsSpan : WatFunc
rtObsSpan =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef]
    body = [ILocalGet "$p2", IConstI64 0, IStructNew "$int", IReturnCall "$rt_apply"]
  in rtFunc "$rt_obsSpan" params [WvAnyRef] [] body

-- | `obsSpanLab`：多一个 label 参数，thunk 仍是最后一个。
rtObsSpanLab : WatFunc
rtObsSpanLab =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef, Pair "$p3" WvAnyRef]
    body = [ILocalGet "$p3", IConstI64 0, IStructNew "$int", IReturnCall "$rt_apply"]
  in rtFunc "$rt_obsSpanLab" params [WvAnyRef] [] body

rtBitNot : WatFunc
rtBitNot =
  let
    params = [Pair "$p0" WvAnyRef]
    body = cat [unboxInt 0, [IConstI64 (0 - 1), IBinop "i64.xor"], wrap63, boxInt]
  in rtFunc "$rt_bitNot" params [WvAnyRef] [] body

shiftCountOk : List Instr
shiftCountOk =
  [
    ILocalGet "$n",
    IConstI64 0,
    IBinop "i64.lt_s",
    ILocalGet "$n",
    IConstI64 63,
    IBinop "i64.ge_s",
    IBinop "i32.or"
  ]

rtBitShl : WatFunc
rtBitShl =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$n"], shiftCountOk, [IIf "i64" [IConstI64 0] (cat [[ILocalGet "$a", ILocalGet "$n", IBinop "i64.shl"], wrap63])], boxInt]
  in rtFunc "$rt_bitShl" params [WvAnyRef] locals body

rtBitShr : WatFunc
rtBitShr =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$n"], shiftCountOk, [IIf "i64" [IConstI64 0] [ILocalGet "$a", IConstI64 1, IBinop "i64.shl", IConstI64 1, IBinop "i64.shr_u", ILocalGet "$n", IBinop "i64.shr_u"]], boxInt]
  in rtFunc "$rt_bitShr" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- 显式效应机器的共享运行时
-- ---------------------------------------------------------------
-- `$rt_resumeTwice` / `$rt_cpsUnhandled2` 由机器（mode 6）使用。
rtResumeTwice : RtConsts -> WatFunc
rtResumeTwice c = rtFunc "$rt_resumeTwice" [] [] [] (failWithConst c.rtcResumedOff c.rtcResumedLen)

cpsParams : Int -> List (Pair String WatValTy)
cpsParams n = map (\i => Pair ("$p" ++ strFromInt i) WvAnyRef) (range 0 n)

-- | 没有匹配 handler 的 perform。
rtCpsUnhandled : RtConsts -> WatFunc
rtCpsUnhandled c =
  rtFunc "$rt_cpsUnhandled" [] [] [] (failWithConst c.rtcUnhandledOff c.rtcUnhandledLen)

-- | 未匹配 handler：把 key/name 拼进错误文本，便于定位实例名。
rtCpsUnhandled2 : RtConsts -> WatFunc
rtCpsUnhandled2 c =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$m" WvAnyRef]
    body =
      cat
        [mkString c.rtcUnhandledOff c.rtcUnhandledLen, [ILocalGet "$p0", ICall "$rt_strConcat"], [ILocalGet "$p1", ICall "$rt_strConcat"], [ILocalSet "$m"], [ILocalGet "$m", ICall "$rt_failStr", IUnreachable]]
  in rtFunc "$rt_cpsUnhandled2" params [] locals body

-- | 一次性 continuation：第二次调用直接 trap。
-- ---------------------------------------------------------------
-- 已实现函数清单（固定顺序）
-- ---------------------------------------------------------------
export rtFunctions : RtConsts -> List WatFunc
rtFunctions c =
  [
    rtApply,
    rtMRunEff,
    rtCpsUnhandled c,
    rtCpsUnhandled2 c,
    rtResumeTwice c,
    rtWrite,
    rtPathCopyRel,
    rtPathLen,
    rtMemToStr,
    rtErrno,
    rtWriteChunked,
    rtPathOpen,
    rtFdReadAll,
    rtEmptyStr,
    rtStatErr,
    rtTryReadFile,
    rtTryWriteFile,
    rtTryWriteFileAtomic c,
    rtTryIsDirectory,
    rtFileExists,
    rtFileMtime,
    rtFileSize,
    rtTryMakeDir,
    rtTryMakeDirExclusive,
    rtTryRemoveFile,
    rtTryRemoveTree,
    rtTryRename,
    rtHostStatus,
    rtGetEnv,
    rtGetCwd c,
    rtExecPath,
    rtTimeUs,
    rtPrintln,
    rtEffNewRef,
    rtEffReadRef,
    rtEffWriteRef,
    rtEffPrint "$rt_effPrint" 1,
    rtEffPrint "$rt_effEprint" 2,
    rtEffExit,
    rtFailStr c,
    rtArrayOob c,
    rtFloatFromInt,
    rtIntFromFloat,
    rtFloatBin "$rt_floatAdd" "f64.add",
    rtFloatBin "$rt_floatSub" "f64.sub",
    rtFloatBin "$rt_floatMul" "f64.mul",
    rtFloatBin "$rt_floatDiv" "f64.div",
    rtFloatCmp "$rt_floatEq" "f64.eq",
    rtFloatCmp "$rt_floatNeq" "f64.ne",
    rtFloatCmp "$rt_floatLt" "f64.lt",
    rtFloatCmp "$rt_floatLe" "f64.le",
    rtFloatCmp "$rt_floatGt" "f64.gt",
    rtFloatCmp "$rt_floatGe" "f64.ge",
    rtFloatAbs,
    rtFloatSqrt,
    rtArrayLength,
    rtArrayGet,
    rtArraySet,
    rtArrayMake,
    rtStrFromInt,
    rtShowBool c,
    rtShowStr,
    rtStrConcat,
    binInt "$rt_add" "i64.add",
    binInt "$rt_sub" "i64.sub",
    binInt "$rt_mul" "i64.mul",
    rtDiv c,
    rtBitNot,
    rtBitShl,
    rtBitShr,
    binInt "$rt_bitAnd" "i64.and",
    binInt "$rt_bitOr" "i64.or",
    binInt "$rt_bitXor" "i64.xor",
    cmpInt "$rt_eqInt" "i64.eq",
    cmpInt "$rt_neqInt" "i64.ne",
    cmpInt "$rt_ltInt" "i64.lt_s",
    cmpInt "$rt_leInt" "i64.le_s",
    cmpInt "$rt_gtInt" "i64.gt_s",
    cmpInt "$rt_geInt" "i64.ge_s",
    binBool "$rt_and" "i32.and",
    binBool "$rt_or" "i32.or",
    rtNatSucc,
    rtNatAdd,
    rtNatSub,
    rtNatMul,
    rtNatDiv c,
    rtNatToInt,
    rtNatFromInt,
    rtStrLength,
    rtStrAt,
    rtSubstring,
    rtStrHash,
    rtEqStr,
    rtNeqStr,
    rtBoxZero,
    rtConstFalse1,
    rtBoxZero2,
    rtCleanupPush,
    rtCleanupPop,
    rtHostTrap c 0,
    rtHostTrap c 1,
    rtHostTrap c 2,
    rtHostTrap c 3,
    rtHostTrap c 4,
    rtHostTrap c 5,
    rtHostTrap c 6,
    rtCmpI32,
    rtCmpI64,
    rtCmpF64,
    rtGenericCmp "$rt_ltValue" "i32.lt_s",
    rtGenericCmp "$rt_leValue" "i32.le_s",
    rtGenericCmp "$rt_gtValue" "i32.gt_s",
    rtGenericCmp "$rt_geValue" "i32.ge_s",
    rtObsSpan,
    rtObsSpanLab,
    rtErase,
    rtAssert c,
    rtPrimFail,
    rtTodo c
  ]

-- ---------------------------------------------------------------
-- 符号表
-- ---------------------------------------------------------------
export rtImplOf : String -> RtImpl
-- 可观测性原语（`docs/reference/observability.md` §4.1）：wasm 后端只给**叶子**
-- 原语 no-op 桩（返回盒装 0）；`span` 依赖闭包，本后端不支持闭包 ⇒ 引用点编译期拒绝。
rtImplOf "+" = RtFunc 2 "$rt_add"
rtImplOf "-" = RtFunc 2 "$rt_sub"
rtImplOf "*" = RtFunc 2 "$rt_mul"
rtImplOf "/" = RtFunc 2 "$rt_div"
rtImplOf "++" = RtFunc 2 "$rt_strConcat"
rtImplOf "bitAnd" = RtFunc 2 "$rt_bitAnd"
rtImplOf "bitOr" = RtFunc 2 "$rt_bitOr"
rtImplOf "bitXor" = RtFunc 2 "$rt_bitXor"
rtImplOf "bitNot" = RtFunc 1 "$rt_bitNot"
rtImplOf "bitShl" = RtFunc 2 "$rt_bitShl"
rtImplOf "bitShr" = RtFunc 2 "$rt_bitShr"
rtImplOf "&&" = RtFunc 2 "$rt_and"
rtImplOf "||" = RtFunc 2 "$rt_or"
rtImplOf "strFromInt" = RtFunc 1 "$rt_strFromInt"
rtImplOf "strShow" = RtFunc 1 "$rt_showStr"
rtImplOf "bi_eq_int" = RtFunc 2 "$rt_eqInt"
rtImplOf "bi_neq_int" = RtFunc 2 "$rt_neqInt"
rtImplOf "bi_lt_int" = RtFunc 2 "$rt_ltInt"
rtImplOf "bi_le_int" = RtFunc 2 "$rt_leInt"
rtImplOf "bi_gt_int" = RtFunc 2 "$rt_gtInt"
rtImplOf "bi_ge_int" = RtFunc 2 "$rt_geInt"
rtImplOf "prim_erase" = RtFunc 1 "$rt_erase"
rtImplOf "@vuna@prim@toObj" = RtFunc 1 "$rt_erase"
rtImplOf "@vuna@prim@fromObj" = RtFunc 1 "$rt_erase"
rtImplOf "assert" = RtFunc 3 "$rt_assert"
rtImplOf "prim_fail" = RtFunc 1 "$rt_primFail"
rtImplOf "todo" = RtFunc 1 "$rt_todo"
rtImplOf "@ir@showInt" = RtFunc 1 "$rt_strFromInt"
rtImplOf "@ir@showNat" = RtFunc 1 "$rt_strFromInt"
rtImplOf "@ir@showBool" = RtFunc 1 "$rt_showBool"
rtImplOf "@ir@showStr" = RtFunc 1 "$rt_showStr"
rtImplOf "@vuna@debug@on" = RtFunc 1 "$rt_constFalse1"
rtImplOf "@vuna@debug@line" = RtFunc 1 "$rt_boxZero"
rtImplOf "@vuna@obs@level" = RtFunc 1 "$rt_boxZero"
rtImplOf "@vuna@obs@log" = RtFunc 1 "$rt_boxZero"
rtImplOf "@vuna@obs@counter" = RtFunc 2 "$rt_boxZero2"
rtImplOf "@vuna@obs@mark" = RtFunc 1 "$rt_boxZero"
rtImplOf "@vuna@obs@spanBegin" = RtFunc 2 "$rt_boxZero2"
rtImplOf "@vuna@obs@spanEnd" = RtFunc 1 "$rt_boxZero"
rtImplOf "@vuna@obs@sampleStart" = RtFunc 2 "$rt_boxZero2"
rtImplOf "@vuna@obs@sampleStop" = RtFunc 1 "$rt_boxZero"
rtImplOf "@vuna@obs@span" = RtFunc 3 "$rt_obsSpan"
rtImplOf "@vuna@obs@spanLab" = RtFunc 4 "$rt_obsSpanLab"
rtImplOf "@ir@natSucc" = RtFunc 1 "$rt_natSucc"
rtImplOf "arrayEmpty" = RtValue [IConstI32 0, IArrayNewDefault "$arr"]
rtImplOf "floatFromInt" = RtFunc 1 "$rt_floatFromInt"
rtImplOf "intFromFloat" = RtFunc 1 "$rt_intFromFloat"
rtImplOf "floatAbs" = RtFunc 1 "$rt_floatAbs"
rtImplOf "floatSqrt" = RtFunc 1 "$rt_floatSqrt"
rtImplOf "bi_add_float" = RtFunc 2 "$rt_floatAdd"
rtImplOf "bi_sub_float" = RtFunc 2 "$rt_floatSub"
rtImplOf "bi_mul_float" = RtFunc 2 "$rt_floatMul"
