rtImplOf "bi_ge_str" = RtFunc 2 "$rt_geValue"
rtImplOf "bi_lt_bool" = RtFunc 2 "$rt_ltValue"
rtImplOf "bi_le_bool" = RtFunc 2 "$rt_leValue"
rtImplOf "bi_gt_bool" = RtFunc 2 "$rt_gtValue"
