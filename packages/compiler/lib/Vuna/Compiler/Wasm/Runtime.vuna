rtImplOf "@vuna@host@tryRunIn" = RtFunc 2 "$rt_hostTrap2"
rtImplOf "@vuna@host@runIn" = RtFunc 2 "$rt_hostTrap2"
rtImplOf "prim_eff_runIn_host" = RtFunc 2 "$rt_hostTrap2"
rtImplOf "prim_eff_getArgs_process_host" = RtFunc 0 "$rt_getArgs"
rtImplOf "prim_eff_exit_process_host" = RtFunc 1 "$rt_effExit"
rtImplOf "prim_eff_spawn" = RtFunc 1 "$rt_hostTrap1"
rtImplOf "@vuna@prim_eff_spawn" = RtFunc 1 "$rt_hostTrap1"
rtImplOf "prim_eff_wait" = RtFunc 1 "$rt_hostTrap1"
rtImplOf "@vuna@prim_eff_wait" = RtFunc 1 "$rt_hostTrap1"
rtImplOf "effTimeUs_host" = RtFunc 0 "$rt_timeUs"
rtImplOf "prim_eff_sleep_host" = RtFunc 1 "$rt_hostTrap1"
rtImplOf "@vuna@prim_eff_sleep_host" = RtFunc 1 "$rt_hostTrap1"
rtImplOf "@vuna@host@sleep" = RtFunc 1 "$rt_hostTrap1"
rtImplOf _ = RtUnsupported
