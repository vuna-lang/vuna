-- | 环境变量查找（environ_get 一次读入 scratch；key 前缀 + `=` 匹配）。
rtGetEnv : WatFunc
rtGetEnv =
  let
    params = [Pair "$key" WvAnyRef]
    locals =
      [
        Pair "$sa" (WvRef "$str"),
        Pair "$keyLen" WvI32,
        Pair "$count" WvI32,
        Pair "$size" WvI32,
        Pair "$ptrArr" WvI32,
        Pair "$buf" WvI32,
        Pair "$i" WvI32,
        Pair "$p" WvI32,
        Pair "$j" WvI32,
        Pair "$ok" WvI32,
        Pair "$k" WvI32,
        Pair "$err" WvI32
      ]
    body =
      [
        ILocalGet "$key",
        IRefCast "$str",
        ILocalSet "$sa",
        ILocalGet "$sa",
        IArrayLen,
        ILocalSet "$keyLen",
        IConstI32 wasiAux,
        IConstI32 (wasiAux + 4),
        ICall "$environ_sizes_get",
        ILocalSet "$err",
        ILocalGet "$err",
        IConstI32 0,
        IBinop "i32.ne",
        IIf "" [ICall "$rt_emptyStr", IReturn] [INop],
        IConstI32 wasiAux,
        ILoad32,
        ILocalSet "$count",
        IConstI32 (wasiAux + 4),
        ILoad32,
        ILocalSet "$size",
        ILocalGet "$size",
        ILocalGet "$count",
        IConstI32 4,
        IBinop "i32.mul",
        IBinop "i32.add",
        IConstI32 180000,
        IBinop "i32.gt_s",
        IIf "" [ICall "$rt_emptyStr", IReturn] [INop],
        IConstI32 (wasiAux + 8),
        ILocalSet "$ptrArr",
        ILocalGet "$ptrArr",
        ILocalGet "$count",
        IConstI32 4,
        IBinop "i32.mul",
        IBinop "i32.add",
        ILocalSet "$buf",
        ILocalGet "$ptrArr",
        ILocalGet "$buf",
        ICall "$environ_get",
        IDrop,
        IConstI32 0,
        ILocalSet "$i",
        IBlock
          "$env_done"
          ""
          [ILoop "$env_l" "" [ILocalGet "$i", ILocalGet "$count", IBinop "i32.ge_s", IBrIf "$env_done", ILocalGet "$ptrArr", ILocalGet "$i", IConstI32 4, IBinop "i32.mul", IBinop "i32.add", ILoad32, ILocalSet "$p", IConstI32 0, ILocalSet "$j", IConstI32 1, ILocalSet "$ok", IBlock "$cmp_done" "" [ILoop "$cmp_l" "" [ILocalGet "$j", ILocalGet "$keyLen", IBinop "i32.ge_s", IBrIf "$cmp_done", ILocalGet "$p", ILocalGet "$j", IBinop "i32.add", ILoad8U, ILocalGet "$sa", ILocalGet "$j", IArrayGetU "$str", IBinop "i32.ne", IIf "" [IConstI32 0, ILocalSet "$ok", IBr "$cmp_done"] [INop], ILocalGet "$j", IConstI32 1, IBinop "i32.add", ILocalSet "$j", IBr "$cmp_l"]], ILocalGet "$ok", IConstI32 0, IBinop "i32.ne", IIf "" [ILocalGet "$p", ILocalGet "$keyLen", IBinop "i32.add", ILoad8U, IConstI32 61, IBinop "i32.eq", IIf "" [ILocalGet "$keyLen", IConstI32 1, IBinop "i32.add", ILocalSet "$k", IBlock "$nul_done" "" [ILoop "$nul_l" "" [ILocalGet "$p", ILocalGet "$k", IBinop "i32.add", ILoad8U, IConstI32 0, IBinop "i32.eq", IBrIf "$nul_done", ILocalGet "$k", IConstI32 1, IBinop "i32.add", ILocalSet "$k", IBr "$nul_l"]], ILocalGet "$p", ILocalGet "$keyLen", IConstI32 1, IBinop "i32.add", IBinop "i32.add", ILocalGet "$k", ILocalGet "$keyLen", IConstI32 1, IBinop "i32.add", IBinop "i32.sub", ICall "$rt_memToStr", IReturn] [INop]] [INop], ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$env_l"]],
        ICall "$rt_emptyStr"
      ]
  in rtFunc "$rt_getEnv" params [WvAnyRef] locals body

-- | 浏览器/边缘没有宿主 cwd：返回虚拟 preopen 根 `/`，相对路径由调用方按该根归一。
rtGetCwd : RtConsts -> WatFunc
rtGetCwd c = rtFunc "$rt_getCwd" [] [WvAnyRef] [] (mkString c.rtcRootOff c.rtcRootLen)

rtExecPath : WatFunc
rtExecPath = rtFunc "$rt_execPath" [] [WvAnyRef] [] emptyStrInstrs

rtTimeUs : WatFunc
rtTimeUs =
  let
    locals = [Pair "$err" WvI32]
    body =
      [
        IConstI32 0,
        IConstI64 1,
        IConstI32 wasiAux,
        ICall "$clock_time_get",
        ILocalSet "$err",
        ILocalGet "$err",
        IConstI32 0,
        IBinop "i32.ne",
        IIf "" [IConstI64 0, IStructNew "$int", IReturn] [INop],
        IConstI32 wasiAux,
        ILoad64,
        IConstI64 1000,
        IBinop "i64.div_u",
        IStructNew "$int"
      ]
  in rtFunc "$rt_timeUs" [] [WvAnyRef] locals body

rtPrintln : WatFunc
rtPrintln =
  let
    params = [Pair "$p0" WvAnyRef]
    body = [IConstI32 1, ILocalGet "$p0", IConstI32 1, ICall "$rt_write"]
  in rtFunc "$rt_println" params [] [] body

rtFailStr : RtConsts -> WatFunc
-- 统一前缀 `vuna: runtime error: ` + msg
-- 写 stderr（rt_write 的 nl=1 补换行）
rtFailStr c =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$m" WvAnyRef]
    body =
      cat
        [mkString c.rtcErrOff c.rtcErrLen, [ILocalGet "$p0", ICall "$rt_strConcat", ILocalSet "$m"], [IConstI32 2, ILocalGet "$m", IConstI32 1, ICall "$rt_write"], [IConstI32 2, ICall "$proc_exit", IUnreachable]]
  in rtFunc "$rt_failStr" params [] locals body

-- | 数组越界：固定文本 + exit 2（wasm 没有位置表，因此没有 OCaml 报告器的 `at` 行）。
rtArrayOob : RtConsts -> WatFunc
rtArrayOob c =
  rtFunc
    "$rt_arrayOob"
    []
    []
    []
    (append (failWithConst c.rtcOobOff c.rtcOobLen) [ICall "$rt_failStr", IUnreachable])

-- ---------------------------------------------------------------
-- 效应原语（宿主层叶子 + IORef）
-- ---------------------------------------------------------------
-- `Eff` 的运行时壳是 base 的 `MkEff` data；这些原语只负责「做一次宿主操作」。
-- 续延与 handler 由 base 的效应机器（`Base.Effect.Core.Control` + `machineRun`）驱动；
-- cleanup 登记表只维护 LIFO，正常路径由 `bracket` pop，异常路径由机器弹帧前跑。
rtEffNewRef : WatFunc
rtEffNewRef =
  rtFunc
    "$rt_newRef"
    [Pair "$p0" WvAnyRef]
    [WvAnyRef]
    [Pair "$out" (WvRef "$arr")]
    [IConstI32 1, IArrayNewDefault "$arr", ILocalSet "$out", ILocalGet "$out", IConstI32 0, ILocalGet "$p0", IArraySet "$arr", ILocalGet "$out"]

rtEffReadRef : WatFunc
rtEffReadRef =
  rtFunc
    "$rt_readRef"
    [Pair "$p0" WvAnyRef]
    [WvAnyRef]
    []
    [ILocalGet "$p0", IRefCast "$arr", IConstI32 0, IArrayGet "$arr"]

rtEffWriteRef : WatFunc
rtEffWriteRef =
  rtFunc
    "$rt_writeRef"
    [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    [WvAnyRef]
    []
    [ILocalGet "$p0", IRefCast "$arr", IConstI32 0, ILocalGet "$p1", IArraySet "$arr", IConstI64 0, IStructNew "$int"]

-- | `print` / `eprint`：写 fd 后返回写出的字节数（与 OCaml 的 `String.length` 一致）。
rtEffPrint : String -> Int -> WatFunc
rtEffPrint name fd =
  rtFunc
    name
    [Pair "$p0" WvAnyRef]
    [WvAnyRef]
    [Pair "$n" WvI32]
    [IConstI32 fd, ILocalGet "$p0", IConstI32 0, ICall "$rt_write", ILocalGet "$p0", IRefCast "$str", IArrayLen, ILocalSet "$n", ILocalGet "$n", IPlain "i64.extend_i32_u", IStructNew "$int"]

rtEffExit : WatFunc
rtEffExit =
  rtFunc
    "$rt_effExit"
    [Pair "$p0" WvAnyRef]
    [WvAnyRef]
    []
    [ILocalGet "$p0", IRefCast "$int", IStructGet "$int" 0, IPlain "i32.wrap_i64", ICall "$proc_exit", IUnreachable]

