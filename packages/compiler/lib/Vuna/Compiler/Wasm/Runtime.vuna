module Vuna.Compiler.Wasm.Runtime where

-- Vuna.Compiler.Wasm.Runtime：运行时函数的 WAT 指令实现 + IR 符号表。
--
-- 产物只有 WAT；运行时按 `Ir.Runtime` 契约的符号名生成 WAT 函数。子集外的符号映射到
-- `RtUnsupported`，代码生成在引用点报 `WasmUnsupported`（编译期拒绝，不生成坏代码）。
--
-- 表示约定（与 Wasm.Module 一致）：
--   * Int/Nat 是 `(struct (field i64))`，box/unbox 由 `$int` 完成；63-bit 语义。
--   * String 是 `(array (mut i8))`；静态字节在 `$d0` passive data segment。
--   * Bool 是 `i31`；Array 是 `(array (mut anyref))`。
--   * 闭包 `$clo` = { code: (ref $ft), env: anyref }；`$ft` 是 (env, arg) -> anyref。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Compiler.Wasm.Instr
import Vuna.Compiler.Wasm.Model

-- ---------------------------------------------------------------
-- 常量字符串在 `$d0` 里的位置（由 Wasm.Module 计算）
-- ---------------------------------------------------------------
export record RtConsts(..) where
  rtcTrueOff : Int
  rtcTrueLen : Int
  rtcFalseOff : Int
  rtcFalseLen : Int
  rtcTodoOff : Int
  rtcTodoLen : Int
  rtcDivOff : Int
  rtcDivLen : Int
  -- 运行时错误报告器的统一前缀 / 断言前缀（与 OCaml 的 `dt_report_exn` 对齐）。
  rtcErrOff : Int
  rtcErrLen : Int
  rtcAssertOff : Int
  rtcAssertLen : Int
  -- | 数组越界（与 OCaml `Invalid_argument ("index out of bounds")` 的首行一致）。
  rtcOobOff : Int
  rtcOobLen : Int
  -- | 一次性续延被第二次 resume（与 native 的 trap 文本一致）。
  rtcResumedOff : Int
  rtcResumedLen : Int
  -- | 该目标未实现的宿主操作（运行期显式失败，不伪造结果）。
  rtcHostOff : Int
  rtcHostLen : Int
  -- | 原子写的临时后缀 / 虚拟根路径。
  rtcTmpOff : Int
  rtcTmpLen : Int
  rtcRootOff : Int
  rtcRootLen : Int
  -- | CPS 模式下没有匹配 handler 的 perform。
  rtcUnhandledOff : Int
  rtcUnhandledLen : Int

-- | 运行时符号的实现形态。
export data RtImpl(..) : Type where
  -- | 0 元值：直接把这些指令插到引用点。
  RtValue : List Instr -> RtImpl
  -- | n 元函数：名字 + arity。
  RtFunc : Int -> String -> RtImpl
  -- | 本后端未实现的契约符号：引用点报 `WasmUnsupported`（带符号名）。
  RtUnsupported : RtImpl

-- ---------------------------------------------------------------
-- 指令拼装 helper
-- ---------------------------------------------------------------
cat : List (List Instr) -> List Instr
cat xs = concatMap (\x => x) xs

localP : Int -> String
localP i = "$p${strFromInt i}"

rtFunc : String -> List (Pair String WatValTy) -> List WatValTy -> List (Pair String WatValTy) -> List Instr -> WatFunc
rtFunc name params results locals body = WatFunc name "" params results locals body

rtApply : WatFunc
rtApply =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$code" (WvRef "$ft"), Pair "$env" WvAnyRef]
    body =
      [
        ILocalGet "$p0",
        IRefCast "$clo",
        IStructGet "$clo" 0,
        ILocalSet "$code",
        ILocalGet "$p0",
        IRefCast "$clo",
        IStructGet "$clo" 1,
        ILocalSet "$env",
        ILocalGet "$env",
        ILocalGet "$p1",
        ILocalGet "$code",
        IReturnCallRef "$ft"
      ]
  in rtFunc "$rt_apply" params [WvAnyRef] locals body

-- | 用续延 K 跑一个 `Eff` 的 thunk（dummy 单元取 null：thunk 体不看它）。
--   机器路径（`@ir@m@*` → `Base.Effect.Core.Control`）里的 `runEff` 落到这里。
rtMRunEff : WatFunc
rtMRunEff =
  rtFunc
    "$rt_mRunEff"
    [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    [WvAnyRef]
    []
    [ILocalGet "$p0", IRefNull, ICall "$rt_apply", ILocalGet "$p1", ICall "$rt_apply"]

-- ---------------------------------------------------------------
-- 数值/布尔 helper
-- ---------------------------------------------------------------
unboxInt : Int -> List Instr
unboxInt i = [ILocalGet (localP i), IRefCast "$int", IStructGet "$int" 0]

boxInt : List Instr
boxInt = [IStructNew "$int"]

wrap63 : List Instr
wrap63 = [IConstI64 1, IBinop "i64.shl", IConstI64 1, IBinop "i64.shr_s"]

binInt : String -> String -> WatFunc
binInt name op =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body = cat [unboxInt 0, unboxInt 1, [IBinop op], wrap63, boxInt]
  in rtFunc name params [WvAnyRef] [] body

cmpInt : String -> String -> WatFunc
cmpInt name op =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body = cat [unboxInt 0, unboxInt 1, [IBinop op, II31New]]
  in rtFunc name params [WvAnyRef] [] body

binBool : String -> String -> WatFunc
binBool name op =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body =
      [
        ILocalGet "$p0",
        IRefCast "i31",
        II31GetU,
        ILocalGet "$p1",
        IRefCast "i31",
        II31GetU,
        IBinop op,
        II31New
      ]
  in rtFunc name params [WvAnyRef] [] body

boolValue : Bool -> List Instr
boolValue b = [IConstI32 (if b then 1 else 0), II31New]

-- ---------------------------------------------------------------
-- 字符串/输出 helper
-- ---------------------------------------------------------------
dataSegmentName : String
dataSegmentName = "$d0"

mkString : Int -> Int -> List Instr
mkString off len = [IConstI32 off, IConstI32 len, IArrayNewData "$str" dataSegmentName]

-- ---------------------------------------------------------------
-- WASI 线性内存布局（固定 scratch；GC 堆在引擎侧）
-- ---------------------------------------------------------------
export wasiIov : Int
wasiIov = 0

export wasiN : Int
wasiN = 8

export wasiPath1 : Int
wasiPath1 = 16

export wasiPath2 : Int
wasiPath2 = 4112

export wasiIo : Int
wasiIo = 8208

export wasiIoCap : Int
wasiIoCap = 65536

export wasiStat : Int
wasiStat = 73744

export wasiDir : Int
wasiDir = 74256

export wasiDirCap : Int
wasiDirCap = 4096

export wasiAux : Int
wasiAux = 78352

-- WASI preview1 rights：读（含 readdir）与写分别给最小有效集。
export readRights : Int
readRights = 136601638

export writeRights : Int
writeRights = 150994943

emptyStrInstrs : List Instr
emptyStrInstrs = [IConstI32 0, IArrayNewDefault "$str"]

boxI64 : List Instr
boxI64 = [IStructNew "$int"]

-- | 路径复制（跳过开头的 `/`，WASI 的 dirfd 版本不接受绝对路径）。
--   返回复制后的相对长度。目标缓冲容量由 `dst` 决定（`wasiPath1`→4096 字节，
--   否则 `wasiPath2`→`wasiAux`）；超出即 trap，不覆盖相邻 scratch。
rtPathCopyRel : WatFunc
rtPathCopyRel =
  let
    params = [Pair "$s" WvAnyRef, Pair "$dst" WvI32]
    locals =
      [
        Pair "$sa" (WvRef "$str"),
        Pair "$n" WvI32,
        Pair "$i" WvI32,
        Pair "$j" WvI32,
        Pair "$cap" WvI32
      ]
    body =
      [
        ILocalGet "$dst",
        IConstI32 wasiPath1,
        IBinop "i32.eq",
        IIf "i32" [IConstI32 (wasiPath2 - wasiPath1 - 1)] [IConstI32 (wasiAux - wasiPath2 - 1)],
        ILocalSet "$cap",
        ILocalGet "$s",
        IRefCast "$str",
        ILocalSet "$sa",
        ILocalGet "$sa",
        IArrayLen,
        ILocalSet "$n",
        IConstI32 0,
        ILocalSet "$i",
        ILocalGet "$n",
        IConstI32 0,
        IBinop "i32.gt_s",
        IIf
          ""
          [ILocalGet "$sa", IConstI32 0, IArrayGetU "$str", IConstI32 47, IBinop "i32.eq", IIf "" [IConstI32 1, ILocalSet "$i"] [INop]]
          [INop],
        IConstI32 0,
        ILocalSet "$j",
        IBlock
          "$p_done"
          ""
          [ILoop "$p_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_s", IBrIf "$p_done", ILocalGet "$j", ILocalGet "$cap", IBinop "i32.ge_s", IIf "" [IUnreachable] [INop], ILocalGet "$dst", ILocalGet "$j", IBinop "i32.add", ILocalGet "$sa", ILocalGet "$i", IArrayGetU "$str", IStore8, ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", ILocalGet "$j", IConstI32 1, IBinop "i32.add", ILocalSet "$j", IBr "$p_l"]],
        ILocalGet "$j"
      ]
  in rtFunc "$rt_pathCopyRel" params [WvI32] locals body

-- | 线性内存字节 → Vuna String。
rtMemToStr : WatFunc
rtMemToStr =
  let
    params = [Pair "$ptr" WvI32, Pair "$len" WvI32]
    locals = [Pair "$out" (WvRef "$str"), Pair "$i" WvI32]
    body =
      [
        ILocalGet "$len",
        IArrayNewDefault "$str",
        ILocalSet "$out",
        IConstI32 0,
        ILocalSet "$i",
        IBlock
          "$m_done"
          ""
          [ILoop "$m_l" "" [ILocalGet "$i", ILocalGet "$len", IBinop "i32.ge_s", IBrIf "$m_done", ILocalGet "$out", ILocalGet "$i", ILocalGet "$ptr", ILocalGet "$i", IBinop "i32.add", ILoad8U, IArraySet "$str", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$m_l"]],
        ILocalGet "$out"
      ]
  in rtFunc "$rt_memToStr" params [WvAnyRef] locals body

-- | WASI errno → 与 OCaml `dtp_hostCode` 一致的 1..6 / 9。
errnoEq : Int -> List Instr -> List Instr -> List Instr
errnoEq n thenB elseB = [ILocalGet "$e", IConstI32 n, IBinop "i32.eq", IIf "i32" thenB elseB]

rtErrno : WatFunc
rtErrno =
  let
    params = [Pair "$e" WvI32]
    body =
      errnoEq
        44
        [IConstI32 1]
        (errnoEq 2 [IConstI32 2] (errnoEq 63 [IConstI32 2] (errnoEq 76 [IConstI32 2] (errnoEq 51 [IConstI32 3] (errnoEq 19 [IConstI32 3] (errnoEq 22 [IConstI32 3] (errnoEq 54 [IConstI32 4] (errnoEq 31 [IConstI32 5] (errnoEq 20 [IConstI32 6] [IConstI32 9])))))))))
  in rtFunc "$rt_errno" params [WvI32] [] body

-- | `rt_writeChunked(fd, s, nl)`：分块写（每次 ≤64 KiB），返回写入字节数或 -1。
rtWriteChunked : WatFunc
rtWriteChunked =
  let
    params = [Pair "$fd" WvI32, Pair "$s" WvAnyRef, Pair "$nl" WvI32]
    locals =
      [
        Pair "$sa" (WvRef "$str"),
        Pair "$total" WvI32,
        Pair "$off" WvI32,
        Pair "$chunk" WvI32,
        Pair "$i" WvI32,
        Pair "$err" WvI32,
        Pair "$nw" WvI32
      ]
    copyChunk =
      [
        IConstI32 0,
        ILocalSet "$i",
        IBlock
          "$c_done"
          ""
          [ILoop "$c_l" "" [ILocalGet "$i", ILocalGet "$chunk", IBinop "i32.ge_s", IBrIf "$c_done", IConstI32 wasiIo, ILocalGet "$i", IBinop "i32.add", ILocalGet "$sa", ILocalGet "$off", ILocalGet "$i", IBinop "i32.add", IArrayGetU "$str", IStore8, ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$c_l"]]
      ]
    writeChunk =
      [
        IConstI32 wasiIov,
        IConstI32 wasiIo,
        IStore32,
        IConstI32 (wasiIov + 4),
        ILocalGet "$chunk",
        IStore32,
        ILocalGet "$fd",
        IConstI32 wasiIov,
        IConstI32 1,
        IConstI32 wasiN,
        ICall "$fd_write",
        ILocalSet "$err",
        ILocalGet "$err",
        IConstI32 0,
        IBinop "i32.ne",
        IIf
          ""
          [ILocalGet "$err", ICall "$rt_errno", IGlobalSet "$g_hostStatus", IConstI32 (0 - 1), IReturn]
          [INop],
        IConstI32 wasiN,
        ILoad32,
        ILocalSet "$nw",
        ILocalGet "$nw",
        IConstI32 0,
        IBinop "i32.le_s",
        IIf "" [IConstI32 (0 - 1), IReturn] [INop],
        ILocalGet "$off",
        ILocalGet "$nw",
        IBinop "i32.add",
        ILocalSet "$off"
      ]
    body =
      [
        ILocalGet "$s",
        IRefCast "$str",
        ILocalSet "$sa",
        ILocalGet "$sa",
        IArrayLen,
        ILocalSet "$total",
        IConstI32 0,
        ILocalSet "$off",
        IBlock
          "$w_done"
          ""
          [ILoop "$w_l" "" (cat [[ILocalGet "$off", ILocalGet "$total", IBinop "i32.ge_s", IBrIf "$w_done", ILocalGet "$total", ILocalGet "$off", IBinop "i32.sub", ILocalSet "$chunk", ILocalGet "$chunk", IConstI32 wasiIoCap, IBinop "i32.gt_s", IIf "" [IConstI32 wasiIoCap, ILocalSet "$chunk"] [INop]], copyChunk, writeChunk, [IBr "$w_l"]])],
        ILocalGet "$nl",
        IConstI32 0,
        IBinop "i32.ne",
        IIf
          ""
          [IConstI32 wasiIo, IConstI32 10, IStore8, IConstI32 wasiIov, IConstI32 wasiIo, IStore32, IConstI32 (wasiIov + 4), IConstI32 1, IStore32, ILocalGet "$fd", IConstI32 wasiIov, IConstI32 1, IConstI32 wasiN, ICall "$fd_write", IDrop]
          [INop],
        ILocalGet "$total"
      ]
  in rtFunc "$rt_writeChunked" params [WvI32] locals body

-- | `rt_write(fd, s, nl)`：分块写 stdout/stderr（不再受 256 KiB 线性内存上限约束）。
rtWrite : WatFunc
rtWrite =
  let
    params = [Pair "$fd" WvI32, Pair "$s" WvAnyRef, Pair "$nl" WvI32]
    body = [ILocalGet "$fd", ILocalGet "$s", ILocalGet "$nl", ICall "$rt_writeChunked", IDrop]
  in rtFunc "$rt_write" params [] [] body

-- ---------------------------------------------------------------
-- 宿主文件系统 / 环境 / 参数的 WASI 实现
-- ---------------------------------------------------------------
-- 约定：`--dir` 预打开根目录为 fd 3；路径统一去掉开头的 `/`（WASI dirfd 形式）。
rtPathLen : WatFunc
rtPathLen =
  let
    params = [Pair "$s" WvAnyRef]
    locals = [Pair "$sa" (WvRef "$str"), Pair "$n" WvI32]
    body =
      [
        ILocalGet "$s",
        IRefCast "$str",
        ILocalSet "$sa",
        ILocalGet "$sa",
        IArrayLen,
        ILocalSet "$n",
        ILocalGet "$n",
        IConstI32 0,
        IBinop "i32.gt_s",
        IIf
          "i32"
          [ILocalGet "$sa", IConstI32 0, IArrayGetU "$str", IConstI32 47, IBinop "i32.eq", IIf "i32" [ILocalGet "$n", IConstI32 1, IBinop "i32.sub"] [ILocalGet "$n"]]
          [ILocalGet "$n"]
      ]
  in rtFunc "$rt_pathLen" params [WvI32] locals body

-- | 打开路径，返回 fd（失败 -1，状态槽已写）。
rtPathOpen : WatFunc
rtPathOpen =
  let
    params = [Pair "$s" WvAnyRef, Pair "$oflags" WvI32, Pair "$rights" WvI64]
    locals = [Pair "$len" WvI32, Pair "$err" WvI32]
    body =
      [
        ILocalGet "$s",
        IConstI32 wasiPath1,
        ICall "$rt_pathCopyRel",
        ILocalSet "$len",
        IConstI32 3,
        IConstI32 0,
        IConstI32 wasiPath1,
        ILocalGet "$len",
        ILocalGet "$oflags",
        ILocalGet "$rights",
        ILocalGet "$rights",
        IConstI32 0,
        IConstI32 wasiAux,
        ICall "$path_open",
        ILocalSet "$err",
        ILocalGet "$err",
        IConstI32 0,
        IBinop "i32.ne",
        IIf
          ""
          [ILocalGet "$err", ICall "$rt_errno", IGlobalSet "$g_hostStatus", IConstI32 (0 - 1), IReturn]
          [INop],
        IConstI32 wasiAux,
        ILoad32,
        IReturn
      ]
  in rtFunc "$rt_pathOpen" params [WvI32] locals body

-- | 从 fd 顺序读到 EOF（或 size 字节），返回 Vuna String；读失败写状态槽并返回空串。
rtFdReadAll : WatFunc
rtFdReadAll =
  let
    params = [Pair "$fd" WvI32, Pair "$size" WvI32]
    locals =
      [
        Pair "$out" (WvRef "$str"),
        Pair "$off" WvI32,
        Pair "$rem" WvI32,
        Pair "$chunk" WvI32,
        Pair "$err" WvI32,
        Pair "$n" WvI32,
        Pair "$i" WvI32
      ]
    body =
      [
        ILocalGet "$size",
        IArrayNewDefault "$str",
        ILocalSet "$out",
        IConstI32 0,
        ILocalSet "$off",
        IBlock
          "$rd_done"
          ""
          [ILoop "$rd_l" "" [ILocalGet "$off", ILocalGet "$size", IBinop "i32.ge_s", IBrIf "$rd_done", ILocalGet "$size", ILocalGet "$off", IBinop "i32.sub", ILocalSet "$rem", ILocalGet "$rem", ILocalSet "$chunk", ILocalGet "$chunk", IConstI32 wasiIoCap, IBinop "i32.gt_s", IIf "" [IConstI32 wasiIoCap, ILocalSet "$chunk"] [INop], IConstI32 wasiIov, IConstI32 wasiIo, IStore32, IConstI32 (wasiIov + 4), ILocalGet "$chunk", IStore32, ILocalGet "$fd", IConstI32 wasiIov, IConstI32 1, IConstI32 wasiN, ICall "$fd_read", ILocalSet "$err", ILocalGet "$err", IConstI32 0, IBinop "i32.ne", IIf "" [ILocalGet "$err", ICall "$rt_errno", IGlobalSet "$g_hostStatus", ICall "$rt_emptyStr", IReturn] [INop], IConstI32 wasiN, ILoad32, ILocalSet "$n", ILocalGet "$n", IConstI32 0, IBinop "i32.le_s", IBrIf "$rd_done", IConstI32 0, ILocalSet "$i", IBlock "$rc_done" "" [ILoop "$rc_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_s", IBrIf "$rc_done", ILocalGet "$out", ILocalGet "$off", ILocalGet "$i", IBinop "i32.add", IConstI32 wasiIo, ILocalGet "$i", IBinop "i32.add", ILoad8U, IArraySet "$str", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$rc_l"]], ILocalGet "$off", ILocalGet "$n", IBinop "i32.add", ILocalSet "$off", IBr "$rd_l"]],
        ILocalGet "$out"
      ]
  in rtFunc "$rt_fdReadAll" params [WvAnyRef] locals body

rtEmptyStr : WatFunc
rtEmptyStr = rtFunc "$rt_emptyStr" [] [WvAnyRef] [] emptyStrInstrs

-- | `path_filestat_get`，返回 errno。
rtStatErr : WatFunc
rtStatErr =
  let
    params = [Pair "$s" WvAnyRef]
    locals = [Pair "$len" WvI32]
    body =
      [
        ILocalGet "$s",
        IConstI32 wasiPath1,
        ICall "$rt_pathCopyRel",
        ILocalSet "$len",
        IConstI32 3,
        IConstI32 0,
        IConstI32 wasiPath1,
        ILocalGet "$len",
        IConstI32 wasiStat,
        ICall "$path_filestat_get"
      ]
  in rtFunc "$rt_statErr" params [WvI32] locals body

rtTryReadFile : WatFunc
rtTryReadFile =
  let
    params = [Pair "$s" WvAnyRef]
    locals = [Pair "$err" WvI32, Pair "$size" WvI32, Pair "$fd" WvI32, Pair "$out" WvAnyRef]
    body =
      [
        IConstI32 0,
        IGlobalSet "$g_hostStatus",
        ILocalGet "$s",
        ICall "$rt_statErr",
        ILocalSet "$err",
        ILocalGet "$err",
        IConstI32 0,
        IBinop "i32.ne",
        IIf
          ""
          [ILocalGet "$err", ICall "$rt_errno", IGlobalSet "$g_hostStatus", ICall "$rt_emptyStr", IReturn]
          [INop],
        IConstI32 (wasiStat + 32),
        ILoad32,
        ILocalSet "$size",
        ILocalGet "$s",
        IConstI32 0,
        IConstI64 136601638,
        ICall "$rt_pathOpen",
        ILocalSet "$fd",
        ILocalGet "$fd",
        IConstI32 0,
        IBinop "i32.lt_s",
        IIf "" [ICall "$rt_emptyStr", IReturn] [INop],
        ILocalGet "$fd",
        ILocalGet "$size",
        ICall "$rt_fdReadAll",
        ILocalSet "$out",
        ILocalGet "$fd",
        ICall "$fd_close",
        IDrop,
        ILocalGet "$out"
      ]
  in rtFunc "$rt_tryReadFile" params [WvAnyRef] locals body

rtTryWriteFile : WatFunc
rtTryWriteFile =
  let
    params = [Pair "$s" WvAnyRef, Pair "$contents" WvAnyRef]
    locals = [Pair "$fd" WvI32, Pair "$n" WvI32]
    body =
      [
        IConstI32 0,
        IGlobalSet "$g_hostStatus",
        ILocalGet "$s",
        IConstI32 9,
        IConstI64 150994943,
        ICall "$rt_pathOpen",
        ILocalSet "$fd",
        ILocalGet "$fd",
        IConstI32 0,
        IBinop "i32.lt_s",
        IIf "" [IConstI64 0, IStructNew "$int", IReturn] [INop],
        ILocalGet "$fd",
        ILocalGet "$contents",
        IConstI32 0,
        ICall "$rt_writeChunked",
        ILocalSet "$n",
        ILocalGet "$fd",
        ICall "$fd_close",
        IDrop,
        ILocalGet "$n",
        IConstI32 0,
        IBinop "i32.lt_s",
        IIf "" [IConstI64 0, IStructNew "$int", IReturn] [INop],
        ILocalGet "$n",
        IPlain "i64.extend_i32_u",
        IStructNew "$int"
      ]
  in rtFunc "$rt_tryWriteFile" params [WvAnyRef] locals body

rtTryWriteFileAtomic : RtConsts -> WatFunc
rtTryWriteFileAtomic c =
  let
    params = [Pair "$s" WvAnyRef, Pair "$contents" WvAnyRef]
    locals =
      [
        Pair "$tmp" WvAnyRef,
        Pair "$lenP" WvI32,
        Pair "$lenT" WvI32,
        Pair "$fd" WvI32,
        Pair "$n" WvI32,
        Pair "$err" WvI32
      ]
    body =
      cat
        [[IConstI32 0, IGlobalSet "$g_hostStatus", ILocalGet "$s"], mkString c.rtcTmpOff c.rtcTmpLen, [ICall "$rt_strConcat", ICall "$rt_timeUs", ICall "$rt_strFromInt", ICall "$rt_strConcat", IGlobalGet "$g_tmpSeq", IConstI32 1, IBinop "i32.add", IGlobalSet "$g_tmpSeq", IGlobalGet "$g_tmpSeq", IPlain "i64.extend_i32_u", IStructNew "$int", ICall "$rt_strFromInt", ICall "$rt_strConcat", ILocalSet "$tmp", ILocalGet "$s", ICall "$rt_pathLen", ILocalSet "$lenP", ILocalGet "$tmp", ICall "$rt_pathLen", ILocalSet "$lenT", ILocalGet "$tmp", IConstI32 9, IConstI64 150994943, ICall "$rt_pathOpen", ILocalSet "$fd", ILocalGet "$fd", IConstI32 0, IBinop "i32.lt_s", IIf "" [IConstI64 0, IStructNew "$int", IReturn] [INop], ILocalGet "$fd", ILocalGet "$contents", IConstI32 0, ICall "$rt_writeChunked", ILocalSet "$n", ILocalGet "$fd", ICall "$fd_close", IDrop, ILocalGet "$n", IConstI32 0, IBinop "i32.lt_s", IIf "" [IConstI64 0, IStructNew "$int", IReturn] [INop], ILocalGet "$s", IConstI32 wasiPath2, ICall "$rt_pathCopyRel", IDrop, IConstI32 3, IConstI32 wasiPath1, ILocalGet "$lenT", IConstI32 3, IConstI32 wasiPath2, ILocalGet "$lenP", ICall "$path_rename", ILocalSet "$err", ILocalGet "$err", IConstI32 0, IBinop "i32.ne", IIf "" [IConstI32 3, IConstI32 wasiPath1, ILocalGet "$lenT", ICall "$path_unlink_file", IDrop, ILocalGet "$err", ICall "$rt_errno", IGlobalSet "$g_hostStatus", IConstI64 0, IStructNew "$int", IReturn] [INop], ILocalGet "$n", IPlain "i64.extend_i32_u", IStructNew "$int"]]
