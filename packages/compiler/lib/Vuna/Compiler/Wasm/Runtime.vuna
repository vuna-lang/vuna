rtImplOf "arrayLength" = RtFunc 1 "$rt_arrayLength"
rtImplOf "arrayGet" = RtFunc 2 "$rt_arrayGet"
rtImplOf "arraySet" = RtFunc 3 "$rt_arraySet"
rtImplOf "arrayMake" = RtFunc 2 "$rt_arrayMake"
rtImplOf "arrayFromList" = RtFunc 1 "$rt_arrayFromList"
rtImplOf "arrayToList" = RtFunc 1 "$rt_arrayToList"
