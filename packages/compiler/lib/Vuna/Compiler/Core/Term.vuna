module Vuna.Compiler.Core.Term where

-- core 类型论的表示层与纯数据操作。
--
-- 这里定义 Term/Value/Neutral/Closure/CaseAlt/VCaseAlt/Rig/Level 等数据（唯一
-- 真源），以及不涉及求值/quote/conv 的项变换（shift/subst/显示/自由变量检查）。
--
-- **表示层定型**：擦除标志用三值 `Rig`（QTT 预留），宇宙层级用不透明
-- `Level`。`Vuna.Compiler.Core` 之外**禁止**解构 `Rig` / `Level`，只能走字段/访问器；
-- 详见 docs/reference/core.md 的映射表与不变量。
--
-- 本模块是 Core 的叶子，只依赖 Common。
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Base.Intrinsics
export import Base.Data (not)

-- ---------------------------------------------------------------
-- 表示层定型（QTT 预留）
-- ---------------------------------------------------------------
--
-- Rig 是「这个 binder 在运行时用几次」的三值格子。精化器三值都产生（Rig0 / Rig1 / RigOmega）；
-- 擦除与用量判据只读 Rig（`rigIsErased`），codegen 的下游
-- 逻辑（判「是否擦除」）不变。
export data Rig(..) : Type where
  -- 运行时零次：类型级 binder、隐式实参。擦除 = 不进运行时表示。
  Rig0 : Rig
  -- 运行时恰好一次：普通值 binder。
  Rig1 : Rig
  -- QTT 预留：不受限使用。当前不产生。
  RigOmega : Rig

-- 「是否擦除」唯一判据：Elab 与 Codegen 都走这里，不直接模式匹配 Rig。
export rigIsErased : Rig -> Bool
rigIsErased Rig0 = True
rigIsErased Rig1 = False
rigIsErased RigOmega = False

export rigIsLinear : Rig -> Bool
rigIsLinear Rig1 = True
rigIsLinear _ = False

export rigIsOmega : Rig -> Bool
rigIsOmega RigOmega = True
rigIsOmega _ = False

-- 其余显式值 binder 默认 ω（1 只来自显式线性标注）。
-- 注意这是**默认构造**入口；带源码 quantity 的路径走 Elab 的 `rigForPi`。
export rigOfBinder : Bool -> Bool -> Rig
rigOfBinder True isTypeDom = Rig0
rigOfBinder False True = Rig0
rigOfBinder False False = RigOmega

export defaultExplicitRig : Rig
defaultExplicitRig = RigOmega

-- Rig 三值半环。唯一实现；Elab/Usage 不自己写三值分支。
--   add   ：同一变量多次出现 / 顺序组合
--   scale ：把一段 usage 按 binder quantity 放大
--   join  ：分支合并（0∨1 = ω：线性值必须在每条路径上都被消费）
export rigAdd : Rig -> Rig -> Rig
rigAdd Rig0 b = b
rigAdd a Rig0 = a
rigAdd Rig1 Rig1 = RigOmega
rigAdd _ _ = RigOmega

export rigScale : Rig -> Rig -> Rig
rigScale Rig0 _ = Rig0
rigScale _ Rig0 = Rig0
rigScale Rig1 u = u
rigScale RigOmega u = RigOmega

export rigJoin : Rig -> Rig -> Rig
rigJoin Rig0 Rig0 = Rig0
rigJoin Rig1 Rig1 = Rig1
rigJoin RigOmega _ = RigOmega
rigJoin _ RigOmega = RigOmega
rigJoin _ _ = RigOmega

-- 声明的 quantity 与实测 usage 是否兼容（0/1 精确；ω 任意）。
export rigExact : Rig -> Rig -> Bool
rigExact Rig0 Rig0 = True
rigExact Rig0 _ = False
rigExact Rig1 Rig1 = True
rigExact Rig1 _ = False
rigExact RigOmega _ = True

export showRig : Rig -> String
showRig Rig0 = "0"
showRig Rig1 = "1"
showRig RigOmega = "ω"

-- 宇宙层级：不透明。`Level` 的表示（现在就是一个非负 Int）只有本模块可见；
-- 其它模块只能经 levelZero / levelSucc / levelMax / levelToInt / levelEq / levelLt
-- 与 `TType` / `VType` 触碰层级，**禁止**自己做 `Int` 算术或模式匹配。
export record Level(..) where
  levelToInt : Int

export levelZero : Level
levelZero = Level 0

export levelSucc : Level -> Level
levelSucc (Level n) = Level (n + 1)

export levelMax : Level -> Level -> Level
levelMax (Level a) (Level b) = Level (if a >= b then a else b)

-- 只给输入语法 `Type n` 与解析器/测试用；生产路径一律经 levelSucc / levelMax。
export levelOfInt : Int -> Level
levelOfInt n = Level n

export levelEq : Level -> Level -> Bool
levelEq (Level a) (Level b) = a == b

export levelLt : Level -> Level -> Bool
levelLt (Level a) (Level b) = a < b

export data Term(..) : Type where
  TVar : String -> Int -> Span -> Term
  TMeta : Int -> Term
  TGlobal : String -> Term
  TType : Level -> Term
  -- Pi：名字、是否隐式、binder 的 multiplicity、域、codomain。
  TPi : String -> Bool -> Rig -> Term -> Term -> Term
  -- Lambda：名字、multiplicity、类型槽（派生信息，`Nothing` 表示未记录）、
  -- binder 自身的源码位置（合成 binder 用 `spanEmpty`）、体。
  -- 类型槽是 `Pair binderTy resultTy`：binder 类型在外层上下文里（不引用该 binder
  -- 自己），结果类型在 binder 的作用域里。binder span 只服务诊断
  -- （未使用/遮蔽/线性用量），不参与语义与编码。
  TLam : String -> Rig -> Maybe (LamMark, Maybe Term, Maybe Term) -> Span -> Term -> Term
  TApp : Term -> Term -> Rig -> Term
  -- 构造子应用（自携每个实参的 multiplicity，与 TApp 一致）。
  TCon : String -> List (Term, Rig) -> Term
  -- R3：record 构造原语（记录构造子名 + 实参）：语义与 TCon 相同，codegen 扩展回 TCon。
  TMk : String -> List (Term, Rig) -> Term
  -- 依赖模式匹配。CaseAlt 的名字是构造子名（case 已按分支顺序排列）。
  TCase : Term -> List CaseAlt -> Term
  -- R3（records-v2）：记录字段投影原语（base、构造子/记录名、字段序号、字段数）。
  -- 精化期把 `p.x` 从生成的 `case` 改为这个原语；codegen 再按同一形状展开成
  -- 原有 `TCase`（产物逐字节一致），eval/quote/conv 直接消费它（iota + stuck）。
  TProj : Term -> String -> List (String, Rig) -> Int -> Int -> Term
  -- R3：记录更新原语（base、构造子名、字段 telescope、被改字段序号、重建体）。
  -- 语义与「单分支 TCase」完全相同（eval 直接按 case 展开），原语只多带记录身份标注。
  TRecUpd : Term -> String -> List (String, Rig) -> List Int -> Term -> Term
  TInt : Int -> Term
  TStr : String -> Term
  TBool : Bool -> Term
  TIf : Term -> Term -> Term -> Term
  -- `Float` 字面量（放末尾保持既有 tag 顺序）。
  TFloat : String -> Term
  -- R4（records-v2）：record 族的类型应用前导（记录名 + 实参）。语义 = `TGlobal name`
  -- 的应用脊；只在精化期存在，codegen 展开回 `TApp` 链（产物逐字节一致）。
  TRecord : String -> List (Term, Rig) -> Term

-- binder（case 分支的构造子字段）：名字、multiplicity、binder 自身的源码位置。
-- span 只服务诊断（未使用/遮蔽/线性用量），不参与语义与编码；合成 binder 用 `spanEmpty`。
export record Binder(..) where
  binderName : String
  binderRig : Rig
  binderSpan : Span

export binderNameOf : Binder -> String
binderNameOf (Binder n r sp) = n

export binderRigOf : Binder -> Rig
binderRigOf (Binder n r sp) = r

export binderSpanOf : Binder -> Span
binderSpanOf (Binder n r sp) = sp

-- | binder → (名字, multiplicity)：给只吃名字/rig 的位置（telescope / codegen / 值层）。
export binderPair : Binder -> (String, Rig)
binderPair b = (binderNameOf b, binderRigOf b)

export binderPairs : List Binder -> List (String, Rig)
binderPairs bs = map binderPair bs

-- | (名字, multiplicity) → 没有源码位置的 binder（telescope / 合成分支）。
export binderOfPair : (String, Rig) -> Binder
binderOfPair (n, r) = Binder n r spanEmpty

export bindersOfPairs : List (String, Rig) -> List Binder
bindersOfPairs ps = map binderOfPair ps

-- case 分支：构造子名 + 绑定子（名字 / multiplicity / 位置）+ 体。
export record CaseAlt(..) where
  caseAltName : String
  caseAltBinders : List Binder
  caseAltBody : Term

export record Closure(..) where
  closureEnv : List Value
  closureBody : Term

export data Neutral(..) : Type where
  NVar : String -> Int -> List Value -> Neutral
  NGlobal : String -> List Value -> Neutral

export data Value(..) : Type where
  VType : Level -> Value
  VPi : String -> Bool -> Rig -> Value -> Closure -> Value
  VLam : String -> Rig -> Closure -> Value
  VNeutral : Neutral -> Value
  VMeta : Int -> List Value -> Value
  -- 卡住的应用（头部既不是 lambda 也不是中性 spines 时保留实参，禁止静默丢弃）。
  VApp : Value -> Value -> Value
  -- 构造子值（已应用全部参数）。
  VCon : String -> List Value -> Value
  -- 卡住的 case（scrutinee 是中性值）。
  VCase : Value -> List VCaseAlt -> Value
  -- R3：卡住的记录投影（base 是中性值）；base 为 VCon 时 eval 直接取字段（iota）。
  VProj : Value -> String -> List (String, Rig) -> Int -> Int -> Value
  VInt : Int -> Value
  VStr : String -> Value
  VBool : Bool -> Value
  VIf : Value -> Value -> Value -> Value
  -- `Float` 值（放末尾保持既有 tag 顺序）：载荷是宿主 double，算术与比较不经过文本。
  VFloat : Float -> Value

-- case 分支的值形态：绑定子 + 悬挂在「绑定子入环境后」的闭包。
export record VCaseAlt(..) where
  vCaseAltName : String
  vCaseAltBinders : List (String, Rig)
  vCaseAltClosure : Closure

export defaultFuel : Int
defaultFuel = 512

-- ---------------------------------------------------------------
-- D24：Nat 字面量链的表示与项规模
-- ---------------------------------------------------------------
--
-- 字面量在精化期展开成 `Zero` / `Succ` 链（`Elab/Term/Impl.natLitTerm`），Core 里没有
-- 惰性 `TNat`。链是普通构造子应用，任何**逐节点**的遍历（擦除检查 / conv / capture
-- check）成本都随字面量大小线性增长，固定 fuel 因此会在「值 ≥256 / 索引 ≥20」时假报
-- `DT: internal: ... fuel exhausted`（D24）。这里提供两个纯数据 helper：
--   * `natChainValue`：把链 O(1) 折回整数（等价判定与燃料派生用）；
--   * `termSize`：项节点数（把固定 fuel 改成按项规模派生时用），饱和在 `termSizeCap`。
-- 链折回的整数上限与运行时 Nat 饱和上限一致（OCaml 63 位 int 的 max_int）。
natChainMax : Int
natChainMax = 4611686018427387903

-- | Nat 字面量链折回整数：`Zero` / `Succ` 构造子（`TCon`、`TGlobal` 形态，允许
-- `TApp` 嵌套的应用脊）折成 `Maybe Int`，非链形态或部分应用返回 `Nothing`。
-- 超过 `natChainMax` 时与运行时 Nat 一样饱和；链深超过内部上限返回 `Nothing`
-- （防失控输入，正常源码字面量远小于该上限）。
export natChainValue : Term -> Maybe Int
natChainValue t = natChainGo 1000000 t

natChainGo : Int -> Term -> Maybe Int
natChainGo fuel t =
  if fuel <= 0 then
    Nothing
  else
    case flattenTermApp t of
      (head, args) =>
        case head of
          TCon c cargs => natChainArgs (fuel - 1) c (append cargs args)
          TGlobal c => natChainArgs (fuel - 1) c args
          _ => Nothing

natChainArgs : Int -> String -> List (Term, Rig) -> Maybe Int
natChainArgs fuel c args =
  if c == natZeroCtor then
    case args of
      [] => Just 0
      _ => Nothing
  else if c == natSuccCtor then
    case args of
      [(a, _)] =>
        case natChainGo fuel a of
          Just n => Just (natChainNext n)
          Nothing => Nothing
      _ => Nothing
  else
    Nothing

-- 饱和 +1（与 `Core.Eval.natSatAdd` / codegen 的 nat 折回一致）。
natChainNext : Int -> Int
natChainNext n = if n >= natChainMax then natChainMax else n + 1

-- 应用脊展平：`TApp (TApp f a) b` → `(f, [a, b])`（累积参数，保持线性）。
export flattenTermApp : Term -> (Term, List (Term, Rig))
flattenTermApp t = flattenTermAppGo t []

flattenTermAppGo : Term -> List (Term, Rig) -> (Term, List (Term, Rig))
flattenTermAppGo (TApp f a rig) acc = flattenTermAppGo f ((a, rig) :: acc)
flattenTermAppGo (TRecord name args) acc = (TGlobal name, append args acc)
flattenTermAppGo t acc = (t, acc)

-- | 项的节点数（`TVar` / 字面量 / binder 各计 1，case 只数 scrutinee 与分支体），
-- **饱和**在 `termSizeCap`。
--
-- 项按出现次数计数：同一子项被多处引用（精化期的按引用内联、do 块复用计划项）会让规模
-- 指数级增长，逐节点递归在这里就会不返回。因此规模计算本身也走节点预算：最多访问
-- `termSizeCap` 个节点，超过就返回上限，调用方派生的燃料随之封顶，由各自的燃料耗尽路径
-- 收尾；正常大小的项仍得到精确节点数。
export termSize : Term -> Int
termSize t = termSizeGo termSizeCap [t]

-- | 项规模的计数上限（节点数）。派生的燃料最坏与它同阶：`lowerBudgetFor` 是
-- `512 + 8 * termSize`，即上限 800 万步。
export termSizeCap : Int
termSizeCap = 1000000

-- `fuel` 是剩余节点预算，每展开一个节点减 1；耗尽后返回已计数（= 上限）。
termSizeGo : Int -> List Term -> Int
termSizeGo fuel [] = 0
termSizeGo fuel (t :: rest) =
  if fuel <= 0 then 0 else 1 + termSizeGo (fuel - 1) (append (termAllChildren t) rest)

-- 全部直接子项（含 λ 类型槽；规模 / 元变量扫描用）。
export termAllChildren : Term -> List Term
termAllChildren (TVar _ _ _) = []
termAllChildren (TMeta _) = []
termAllChildren (TGlobal _) = []
termAllChildren (TType _) = []
termAllChildren (TInt _) = []
termAllChildren (TStr _) = []
termAllChildren (TFloat _) = []
termAllChildren (TBool _) = []
termAllChildren (TPi _ _ _ dom cod) = [dom, cod]
termAllChildren (TLam _ _ slot _ body) = append (termSizeSlotTerms slot) [body]
termAllChildren (TApp f a _) = [f, a]
termAllChildren (TCon _ args) = termSizeArgTerms args
termAllChildren (TMk _ args) = termSizeArgTerms args
termAllChildren (TRecord _ args) = termSizeArgTerms args
termAllChildren (TCase scrut alts) = scrut :: termSizeAltTerms alts
termAllChildren (TProj base _ _ _ _) = [base]
termAllChildren (TRecUpd base _ _ _ body) = [base, body]
termAllChildren (TIf c th el) = [c, th, el]

termSizeArgTerms : List (Term, Rig) -> List Term
termSizeArgTerms [] = []
termSizeArgTerms ((a, _) :: rest) = a :: termSizeArgTerms rest

termSizeAltTerms : List CaseAlt -> List Term
termSizeAltTerms [] = []
termSizeAltTerms (alt :: rest) = caseAltBody alt :: termSizeAltTerms rest

termSizeSlotTerms : Maybe (LamMark, Maybe Term, Maybe Term) -> List Term
termSizeSlotTerms Nothing = []
termSizeSlotTerms (Just p) =
  append (termSizeMaybeTerms (firstOf (secondOf p))) (termSizeMaybeTerms (secondOf (secondOf p)))

termSizeMaybeTerms : Maybe Term -> List Term
termSizeMaybeTerms Nothing = []
termSizeMaybeTerms (Just t) = [t]

-- ---------------------------------------------------------------
-- Plain 遍历（值子项）：语义扫描只跟运行时值走，不进入 λ 类型槽。
-- `termValueChildren` 是唯一的结构真源；`foldTermPlain` / `termAnyPlain` 只负责
-- 顺序与短路。新增 `Term` 构造子必须在这里接线（不写 `_` 兜底）。
-- ---------------------------------------------------------------
export termValueChildren : Term -> List Term
termValueChildren (TVar _ _ _) = []
termValueChildren (TMeta _) = []
termValueChildren (TGlobal _) = []
termValueChildren (TType _) = []
termValueChildren (TInt _) = []
termValueChildren (TStr _) = []
termValueChildren (TFloat _) = []
termValueChildren (TBool _) = []
termValueChildren (TPi _ _ _ dom cod) = [dom, cod]
termValueChildren (TLam _ _ _ _ body) = [body]
termValueChildren (TApp f a _) = [f, a]
termValueChildren (TCon _ args) = termValueArgTerms args
termValueChildren (TMk _ args) = termValueArgTerms args
termValueChildren (TRecord _ args) = termValueArgTerms args
termValueChildren (TCase scrut alts) = scrut :: map caseAltBody alts
termValueChildren (TProj base _ _ _ _) = [base]
termValueChildren (TRecUpd base _ _ _ body) = [base, body]
termValueChildren (TIf c th el) = [c, th, el]

termValueArgTerms : List (Term, Rig) -> List Term
termValueArgTerms [] = []
termValueArgTerms ((a, _) :: rest) = a :: termValueArgTerms rest

export foldTermPlain : (acc -> Term -> acc) -> acc -> Term -> acc
foldTermPlain f acc t = foldTermPlainGo f (f acc t) (termValueChildren t)

foldTermPlainGo : (acc -> Term -> acc) -> acc -> List Term -> acc
foldTermPlainGo f acc [] = acc
foldTermPlainGo f acc (k :: rest) = foldTermPlainGo f (foldTermPlain f acc k) rest

export termAnyPlain : (Term -> Bool) -> Term -> Bool
termAnyPlain pred t = if pred t then True else termAnyPlainList pred (termValueChildren t)

termAnyPlainList : (Term -> Bool) -> List Term -> Bool
termAnyPlainList pred [] = False
termAnyPlainList pred (k :: rest) = termAnyPlain pred k || termAnyPlainList pred rest

-- ---------------------------------------------------------------
-- 元变量 / 定义表（解是 level 形态的 Value，可以提到当前上下文里的局部变量）
-- ---------------------------------------------------------------
-- 热路径入口：查解表的 HashMap Int 索引（O(1)、无 strFromInt 分配）。
export metaLookup : Int -> HashMap Int Value -> Maybe Value
metaLookup i t = HashMap.lookup i t

-- 纯 list 场景（只有解表 list、没有索引）的线性兜底；热路径不要用。
export metaLookupList : Int -> List (Int, Value) -> Maybe Value
metaLookupList i [] = Nothing
metaLookupList i ((j, t) :: rest) = if i == j then Just t else metaLookupList i rest

-- ---------------------------------------------------------------
-- Sols：解表 + 其哈希索引。
-- ---------------------------------------------------------------
-- 解表是权威数据（前插新解），但**线性查找**在大程序上是 O(#元变量)/次：签名期的元变量
-- （隐式参数）在 bodies 阶段每次 force/conv 都要查，逐定义成本随元变量数增长 ⇒ check 超线性。
-- 这里把「list（权威）+ HashMap（索引）+ 元变量创建深度索引」打包成一个值沿调用链传递；
-- 前插新解时同时插入索引，因此查找恒为 O(1)。
--
-- 元变量创建深度进入 Sols（`solsDepth`），求解点**就地**检查作用域——
-- 不存「先存解、事后扫解表」的两段式复核。
export record Sols(..) where
  solsTbl : HashMap Int Value
  solsList : List (Int, Value)
  solsDepth : HashMap Int Int

export solsEmpty : Sols
solsEmpty = Sols (HashMap.fromList []) [] (HashMap.fromList [])

export solsFromList : List (Int, Value) -> Sols
solsFromList xs = Sols (HashMap.insertAll xs (HashMap.fromList [])) xs (HashMap.fromList [])

-- Elab 侧构造：解表（list 权威）+ 解索引 + 元变量创建深度索引。
export solsOf : HashMap Int Value -> List (Int, Value) -> HashMap Int Int -> Sols
solsOf t xs d = Sols t xs d

-- 元变量创建深度（绑定当时的上下文长度）；未登记的元变量返回 Nothing。
export solsDepthAt : Int -> Sols -> Maybe Int
solsDepthAt i (Sols t xs d) = HashMap.lookup i d

export solsLookup : Int -> Sols -> Maybe Value
-- 索引与 list 同步维护（`solsCons`/`ecPutSols` 每次前插都插表），所以 miss 就是「未解」，
-- 不做线性兜底：未解元变量在推断期是**高频**查询，兜底会退化成 O(#解)/次。
solsLookup i (Sols t xs d) = HashMap.lookup i t

export solsCons : Int -> Value -> Sols -> Sols
solsCons i v (Sols t xs d) = Sols (HashMap.insert i v t) ((i, v) :: xs) d

-- 未解 meta / level 扫描的预算：耗尽一律按保守方向回答。项与值共用同一个上限
-- （262144 远超正常项 / 值的深度与实参长度）。
metaScanBound : Int
metaScanBound = 262144

-- 项里是否有**未解**元变量（值共享的安全条件之一：含未解 meta 的体不缓存）。
-- 已解的 TMeta 不算：缓存里留下的是已解值，再求解也不会改写既有解。
-- 走燃料版扫描：闭包体 / `VCase` 分支体这类项可能很深，耗尽按保守方向回答 `True`。
export termHasUnsolvedMeta : Sols -> Term -> Bool
termHasUnsolvedMeta sols t = termHasUnsolvedMetaFuel metaScanBound sols t

-- `fuel` 同时约束递归深度与实参 / 分支列表长度；耗尽返回 `True`（与值层扫描同口径）。
termHasUnsolvedMetaFuel : Int -> Sols -> Term -> Bool
termHasUnsolvedMetaFuel fuel sols t =
  if fuel <= 0 then
    True
  else
    case t of
      TMeta m =>
        case solsLookup m sols of
          Just _ => False
          Nothing => True
      TVar name i sp => False
      TGlobal g => False
      TType l => False
      TPi name implicit rig dom cod => termHasUnsolvedMetaFuel (fuel - 1) sols dom || termHasUnsolvedMetaFuel (fuel - 1) sols cod
      TLam name rig slot _ body =>
        let
          tys =
            case slot of
              Nothing => False
              Just (_, binderTy, resultTy) => termHasUnsolvedMetaMaybeFuel (fuel - 1) sols binderTy || termHasUnsolvedMetaMaybeFuel (fuel - 1) sols resultTy
        in tys || termHasUnsolvedMetaFuel (fuel - 1) sols body
      TApp f a rig => termHasUnsolvedMetaFuel (fuel - 1) sols f || termHasUnsolvedMetaFuel (fuel - 1) sols a
      TCon c args => termHasUnsolvedMetaArgsFuel (fuel - 1) sols args
      TMk c args => termHasUnsolvedMetaArgsFuel (fuel - 1) sols args
      TRecord c args => termHasUnsolvedMetaArgsFuel (fuel - 1) sols args
      TProj base c tele i fi => termHasUnsolvedMetaFuel (fuel - 1) sols base
      TRecUpd base c tele idxs body => termHasUnsolvedMetaFuel (fuel - 1) sols base || termHasUnsolvedMetaFuel (fuel - 1) sols body
      TCase scrut alts => termHasUnsolvedMetaFuel (fuel - 1) sols scrut || termHasUnsolvedMetaAltsFuel (fuel - 1) sols alts
      TInt n => False
      TStr s => False
      TFloat raw => False
      TBool b => False
      TIf c th el => termHasUnsolvedMetaFuel (fuel - 1) sols c || termHasUnsolvedMetaFuel (fuel - 1) sols th || termHasUnsolvedMetaFuel (fuel - 1) sols el

termHasUnsolvedMetaMaybeFuel : Int -> Sols -> Maybe Term -> Bool
termHasUnsolvedMetaMaybeFuel fuel sols Nothing = False
termHasUnsolvedMetaMaybeFuel fuel sols (Just t) = termHasUnsolvedMetaFuel fuel sols t

termHasUnsolvedMetaArgsFuel : Int -> Sols -> List (Term, Rig) -> Bool
termHasUnsolvedMetaArgsFuel fuel sols args =
  if fuel <= 0 then
    True
  else
    case args of
      [] => False
      (a, rig) :: rest => termHasUnsolvedMetaFuel (fuel - 1) sols a || termHasUnsolvedMetaArgsFuel (fuel - 1) sols rest

termHasUnsolvedMetaAltsFuel : Int -> Sols -> List CaseAlt -> Bool
termHasUnsolvedMetaAltsFuel fuel sols alts =
  if fuel <= 0 then
    True
  else
    case alts of
      [] => False
      alt :: rest => termHasUnsolvedMetaFuel (fuel - 1) sols (caseAltBody alt) || termHasUnsolvedMetaAltsFuel (fuel - 1) sols rest

-- | 项是否含浮点字面量，或引用名字在给定列表里的全局（`floatIntrinsicNames` 等）：
-- interp/REPL 拒绝浮点求值、codegen 按需生成浮点 runtime helper 的共用判据。
export termUsesFloat : List String -> Term -> Bool
termUsesFloat names t = termAnyPlain (usesFloatAt names) t

usesFloatAt : List String -> Term -> Bool
usesFloatAt names (TFloat _) = True
usesFloatAt names (TGlobal n) = memName n names
usesFloatAt names (TVar _ _ _) = False
usesFloatAt names (TMeta _) = False
usesFloatAt names (TType _) = False
usesFloatAt names (TPi _ _ _ _ _) = False
usesFloatAt names (TLam _ _ _ _ _) = False
usesFloatAt names (TApp _ _ _) = False
usesFloatAt names (TCon _ _) = False
usesFloatAt names (TMk _ _) = False
usesFloatAt names (TRecord _ _) = False
usesFloatAt names (TProj _ _ _ _ _) = False
usesFloatAt names (TRecUpd _ _ _ _ _) = False
usesFloatAt names (TCase _ _) = False
usesFloatAt names (TInt _) = False
usesFloatAt names (TStr _) = False
usesFloatAt names (TBool _) = False
usesFloatAt names (TIf _ _ _) = False

export termGlobalNames : Term -> List String
termGlobalNames t = foldTermPlain globalNameAt [] t

globalNameAt : List String -> Term -> List String
globalNameAt acc (TGlobal n) = append acc [n]
globalNameAt acc (TRecord c _) = append acc [c]
globalNameAt acc (TVar _ _ _) = acc
globalNameAt acc (TMeta _) = acc
globalNameAt acc (TType _) = acc
globalNameAt acc (TPi _ _ _ _ _) = acc
globalNameAt acc (TLam _ _ _ _ _) = acc
globalNameAt acc (TApp _ _ _) = acc
globalNameAt acc (TCon _ _) = acc
globalNameAt acc (TMk _ _) = acc
globalNameAt acc (TProj _ _ _ _ _) = acc
globalNameAt acc (TRecUpd _ _ _ _ _) = acc
globalNameAt acc (TCase _ _) = acc
globalNameAt acc (TInt _) = acc
globalNameAt acc (TStr _) = acc
globalNameAt acc (TBool _) = acc
globalNameAt acc (TIf _ _ _) = acc
globalNameAt acc (TFloat _) = acc

export defLookup : String -> HashMap String Term -> Maybe Term
defLookup name tbl = HashMap.lookup name tbl

-- 闭合项检查：TVar 只有在被 lambda/Pi 绑定时才允许。
-- ---------------------------------------------------------------
-- 作用域遍历：所有「按 binder 深度检查某个叶子」的遍历共用这一份递归。
-- `pred depth node` 只判定当前节点；子项按构造子的 binder 规则推进深度：
-- `TPi` 余域 +1、`TLam` 结果类型与体 +1、`TCase` 分支 +binder 数、
-- `TRecUpd` 体 +tele 长度。新增 `Term` 构造子必须在这里接线（不写 `_` 兜底）。
-- ---------------------------------------------------------------
export termAnyScoped : (Int -> Term -> Bool) -> Int -> Term -> Bool
termAnyScoped pred depth t = if pred depth t then True else termAnyScopedKids pred depth t

termAnyScopedKids : (Int -> Term -> Bool) -> Int -> Term -> Bool
termAnyScopedKids pred depth (TVar _ _ _) = False
termAnyScopedKids pred depth (TMeta _) = False
termAnyScopedKids pred depth (TGlobal _) = False
termAnyScopedKids pred depth (TType _) = False
termAnyScopedKids pred depth (TPi _ _ _ dom cod) =
  termAnyScoped pred depth dom || termAnyScoped pred (depth + 1) cod
termAnyScopedKids pred depth (TLam _ _ slot _ body) =
  termAnyScopedSlot pred depth slot || termAnyScoped pred (depth + 1) body
termAnyScopedKids pred depth (TApp f a _) = termAnyScoped pred depth f || termAnyScoped pred depth a
termAnyScopedKids pred depth (TCon _ args) = termAnyScopedArgs pred depth args
termAnyScopedKids pred depth (TMk _ args) = termAnyScopedArgs pred depth args
termAnyScopedKids pred depth (TRecord _ args) = termAnyScopedArgs pred depth args
termAnyScopedKids pred depth (TProj base _ _ _ _) = termAnyScoped pred depth base
termAnyScopedKids pred depth (TRecUpd base _ tele _ body) =
  termAnyScoped pred depth base || termAnyScoped pred (depth + length tele) body
termAnyScopedKids pred depth (TCase scrut alts) =
  termAnyScoped pred depth scrut || termAnyScopedAlts pred depth alts
termAnyScopedKids pred depth (TInt _) = False
termAnyScopedKids pred depth (TStr _) = False
termAnyScopedKids pred depth (TBool _) = False
termAnyScopedKids pred depth (TIf c th el) =
  termAnyScoped pred depth c || termAnyScoped pred depth th || termAnyScoped pred depth el
termAnyScopedKids pred depth (TFloat _) = False

termAnyScopedSlot : (Int -> Term -> Bool) -> Int -> Maybe (LamMark, Maybe Term, Maybe Term) -> Bool
termAnyScopedSlot pred depth Nothing = False
termAnyScopedSlot pred depth (Just p) =
  termAnyScopedMaybe pred depth (firstOf (secondOf p))
    || termAnyScopedMaybe pred (depth + 1) (secondOf (secondOf p))

termAnyScopedMaybe : (Int -> Term -> Bool) -> Int -> Maybe Term -> Bool
termAnyScopedMaybe pred depth Nothing = False
termAnyScopedMaybe pred depth (Just t) = termAnyScoped pred depth t

termAnyScopedArgs : (Int -> Term -> Bool) -> Int -> List (Term, Rig) -> Bool
termAnyScopedArgs pred depth [] = False
termAnyScopedArgs pred depth ((a, _) :: rest) =
  termAnyScoped pred depth a || termAnyScopedArgs pred depth rest

termAnyScopedAlts : (Int -> Term -> Bool) -> Int -> List CaseAlt -> Bool
termAnyScopedAlts pred depth [] = False
termAnyScopedAlts pred depth (alt :: rest) =
  termAnyScoped pred (depth + length (caseAltBinders alt)) (caseAltBody alt)
    || termAnyScopedAlts pred depth rest

export hasMeta : Int -> Int -> Term -> Bool
hasMeta m depth t = termAnyScoped (metaAt m) depth t

metaAt : Int -> Int -> Term -> Bool
metaAt m _ (TMeta j) = m == j
metaAt _ _ _ = False

-- | 对 λ binder 类型槽做项变换（`Nothing` 保持不动）。
export mapTermMaybe : (Term -> Term) -> Maybe Term -> Maybe Term
mapTermMaybe f Nothing = Nothing
mapTermMaybe f (Just t) = Just (f t)

-- ---------------------------------------------------------------
-- λ 类型槽（binder 类型 + 结果类型）
-- ---------------------------------------------------------------
--
-- `TLam` 的槽：`Maybe (Pair LamMark (Pair (Maybe Term) (Maybe Term)))`。外层 `Nothing`
-- 表示没有记录；`LamMark` 是结构的 λ 标记（不再把标记编进 binder 名），两项类型各自可缺。
export data LamMark(..) : Type where
  LamPlain : LamMark
  LamLinearClosure : LamMark

export lamMarkOf : Maybe (LamMark, Maybe Term, Maybe Term) -> LamMark
lamMarkOf Nothing = LamPlain
lamMarkOf (Just p) = firstOf p

export lamSlotTys : Maybe (LamMark, Maybe Term, Maybe Term) -> Maybe (Maybe Term, Maybe Term)
lamSlotTys Nothing = Nothing
lamSlotTys (Just p) = Just (secondOf p)

export lamBinderTyOf : Maybe (LamMark, Maybe Term, Maybe Term) -> Maybe Term
lamBinderTyOf slot =
  case lamSlotTys slot of
    Nothing => Nothing
    Just p => firstOf p

export lamResultTyOf : Maybe (LamMark, Maybe Term, Maybe Term) -> Maybe Term
lamResultTyOf slot =
  case lamSlotTys slot of
    Nothing => Nothing
    Just p => secondOf p

export lamTyOf : Maybe Term -> Maybe Term -> Maybe (LamMark, Maybe Term, Maybe Term)
lamTyOf Nothing Nothing = Nothing
lamTyOf binderTy resultTy = Just (LamPlain, binderTy, resultTy)

export markLamLinear : Maybe (LamMark, Maybe Term, Maybe Term) -> Maybe (LamMark, Maybe Term, Maybe Term)
markLamLinear slot =
  let
    tys =
      case lamSlotTys slot of
        Nothing => (Nothing, Nothing)
        Just p => p
  in Just (LamLinearClosure, tys)

export lamTyWithBinder : Maybe Term -> Maybe (LamMark, Maybe Term, Maybe Term)
lamTyWithBinder binderTy = lamTyOf binderTy Nothing

export lamTyWithResult : Maybe Term -> Maybe (LamMark, Maybe Term, Maybe Term)
lamTyWithResult resultTy = lamTyOf Nothing resultTy

-- ---------------------------------------------------------------
-- de Bruijn 移动：把项从深度 depth 的上下文嵌入到更深上下文（自由变量 +amount）。
-- 局部上下文的类型按「绑定时上下文」存储，取用时需要 shift 0 (idx+1)。
--
-- `shift` / `substVarAt` 共用一份结构递归。
-- 深度规则与 `termAnyScoped` 一致：`TPi` 余域 +1、`TLam` 结果类型与体 +1、
-- `TCase` 分支 +binder 数、`TRecUpd` 体 +tele 长度。
-- 元变量替换要按解继续下钻（不是子项），保留自己的 fuel 递归（`substMetasFuel`）。
-- ---------------------------------------------------------------
data TermMapMode : Type where
  MapShift : Int -> TermMapMode
  MapSubstVar : Int -> Term -> TermMapMode

mapTermScoped : TermMapMode -> Int -> Term -> Term
mapTermScoped (MapShift amount) depth (TVar n i sp) =
  if i >= depth then TVar n (i + amount) sp else TVar n i sp
mapTermScoped (MapSubstVar idx arg) depth (TVar n i sp) =
  if i == idx + depth then arg else TVar n i sp
mapTermScoped mode depth (TMeta m) = TMeta m
mapTermScoped mode depth (TGlobal g) = TGlobal g
mapTermScoped mode depth (TType l) = TType l
mapTermScoped mode depth (TPi n im r dom cod) =
  TPi n im r (mapTermScoped mode depth dom) (mapTermScoped mode (depth + 1) cod)
mapTermScoped mode depth (TLam n r slot sp body) =
  let
    slot2 =
      case slot of
        Nothing => Nothing
        Just (mark, bt, rt) =>
          let
            bt2 =
              case bt of
                Nothing => Nothing
                Just t => Just (mapTermScoped mode depth t)
            rt2 =
              case rt of
                Nothing => Nothing
                Just t => Just (mapTermScoped mode (depth + 1) t)
          in Just (mark, bt2, rt2)
  in TLam n r slot2 sp (mapTermScoped mode (depth + 1) body)
mapTermScoped mode depth (TApp f a r) =
  TApp (mapTermScoped mode depth f) (mapTermScoped mode depth a) r
mapTermScoped mode depth (TCon c args) =
  TCon c (map (\p => (mapTermScoped mode depth (firstOf p), secondOf p)) args)
mapTermScoped mode depth (TMk c args) =
  TMk c (map (\p => (mapTermScoped mode depth (firstOf p), secondOf p)) args)
mapTermScoped mode depth (TRecord c args) =
  TRecord c (map (\p => (mapTermScoped mode depth (firstOf p), secondOf p)) args)
mapTermScoped mode depth (TProj base c tele i fi) =
  TProj (mapTermScoped mode depth base) c tele i fi
mapTermScoped mode depth (TRecUpd base c tele idxs body) =
  TRecUpd
    (mapTermScoped mode depth base)
    c
    tele
    idxs
    (mapTermScoped mode (depth + length tele) body)
mapTermScoped mode depth (TCase s alts) =
  TCase
    (mapTermScoped mode depth s)
    (map (\alt => CaseAlt (caseAltName alt) (caseAltBinders alt) (mapTermScoped mode (depth + length (caseAltBinders alt)) (caseAltBody alt))) alts)
mapTermScoped mode depth (TInt n) = TInt n
mapTermScoped mode depth (TStr s) = TStr s
mapTermScoped mode depth (TBool b) = TBool b
mapTermScoped mode depth (TIf c th el) =
  TIf (mapTermScoped mode depth c) (mapTermScoped mode depth th) (mapTermScoped mode depth el)
mapTermScoped mode depth (TFloat raw) = TFloat raw

export shift : Int -> Int -> Term -> Term
shift depth amount t = mapTermScoped (MapShift amount) depth t

export substVarAt : Int -> Term -> Term -> Term
substVarAt idx arg t = mapTermScoped (MapSubstVar idx arg) 0 t

-- 字典提升：把 `?m` 换成 `TVar d (depth - q)`（`q` = 插入点外侧绑定子数，含类参数绑定子）。
-- `depth` 是 `?m` 出现处深度（de Bruijn）：延迟的字典元变量要变成提升后的字典绑定子变量，
-- 索引必须按出现点深度算；深度 0 的版本会把解里的 `NVar` 拍成越界变量
-- （字典签名会变成 `{d : Dict_Ord ?67}` 这类错形）。遍历与 `substMetas*` 共用一份。
export substMetaVar : Int -> String -> Int -> Term -> Term
substMetaVar m name q t = substMetaVarGo m name q 0 t

export substMetaVarGo : Int -> String -> Int -> Int -> Term -> Term
substMetaVarGo m name q depth t =
  substMetas (\d => \n => if n == m then Just (TVar name (d - q) spanEmpty) else Nothing) depth t

-- ---------------------------------------------------------------
-- 元变量替换的共享骨架
-- ---------------------------------------------------------------
-- 「按出现点深度把 `TMeta m` 换成项」的遍历有多个策略（已解元变量代入、接口摘要 zonk、
-- 字典提升）；它们此前各写一份，覆盖的构造子集合与 `TRecUpd` 的深度口径互不一致。
-- 这里收敛成唯一实现：`resolve depth meta` 给出替换项（`Nothing` = 保留原 `TMeta`），
-- 替换出来的项继续按同一深度下钻（解里可能还有已解元变量）。
--
-- 深度口径与 `shift` / `substVarAt` / `hasFreeTermVar` 一致：`TPi` 余域、`TLam` 结果类型
-- 与体、`TCase` 分支体、`TRecUpd` 的体都在对应 binder / `tele` 之下加一；`TProj` 的
-- `tele` 只是字段名标注，base 留在外层上下文。
--
-- 新增 `Term` 构造子时必须同步这里：漏覆盖不会报错，只会让调用方拿到残留 `TMeta`
-- （接口摘要的安全阀整份拒收、codegen 报 `UnsolvedMetavarRuntime`）。
-- fuel 耗尽时返回当前子项（残留 `TMeta` 由调用方的安全阀显式拒绝，不静默改写结构）。
export substMetasFuel : Int -> (Int -> Int -> Maybe Term) -> Int -> Term -> Term
substMetasFuel fuel resolve depth t =
  if fuel <= 0 then
    t
  else
    case t of
      TMeta m =>
        case resolve depth m of
          Nothing => t
          Just q => substMetasFuel (fuel - 1) resolve depth q
      TPi n i r d c => TPi n i r (substMetasFuel (fuel - 1) resolve depth d) (substMetasFuel (fuel - 1) resolve (depth + 1) c)
      TLam n r slot sp b => TLam n r (substMetasSlot (fuel - 1) resolve depth slot) sp (substMetasFuel (fuel - 1) resolve (depth + 1) b)
      TApp f a r => TApp (substMetasFuel (fuel - 1) resolve depth f) (substMetasFuel (fuel - 1) resolve depth a) r
      TCon c args => TCon c (substMetasArgs (fuel - 1) resolve depth args)
      TMk c args => TMk c (substMetasArgs (fuel - 1) resolve depth args)
      TRecord c args => TRecord c (substMetasArgs (fuel - 1) resolve depth args)
      TProj base c tele i fi => TProj (substMetasFuel (fuel - 1) resolve depth base) c tele i fi
      TRecUpd base c tele idxs body => TRecUpd (substMetasFuel (fuel - 1) resolve depth base) c tele idxs (substMetasFuel (fuel - 1) resolve (depth + length tele) body)
      TCase s alts => TCase (substMetasFuel (fuel - 1) resolve depth s) (map (substMetasAlt (fuel - 1) resolve depth) alts)
      TIf c th el => TIf (substMetasFuel (fuel - 1) resolve depth c) (substMetasFuel (fuel - 1) resolve depth th) (substMetasFuel (fuel - 1) resolve depth el)
      TInt n => t
      TStr s => t
      TBool b => t
      TFloat raw => t
      TVar n i sp => t
      TGlobal g => t
      TType l => t

substMetasArgs : Int -> (Int -> Int -> Maybe Term) -> Int -> List (Term, Rig) -> List (Term, Rig)
substMetasArgs fuel resolve depth [] = []
substMetasArgs fuel resolve depth ((a, rig) :: rest) =
  (substMetasFuel fuel resolve depth a, rig) :: substMetasArgs fuel resolve depth rest

substMetasSlot : Int -> (Int -> Int -> Maybe Term) -> Int -> Maybe (LamMark, Maybe Term, Maybe Term) -> Maybe (LamMark, Maybe Term, Maybe Term)
substMetasSlot fuel resolve depth Nothing = Nothing
substMetasSlot fuel resolve depth (Just p) =
  let
    tys = secondOf p
  in Just
    (firstOf p, mapTermMaybe (substMetasFuel fuel resolve depth) (firstOf tys), mapTermMaybe (substMetasFuel fuel resolve (depth + 1)) (secondOf tys))

substMetasAlt : Int -> (Int -> Int -> Maybe Term) -> Int -> CaseAlt -> CaseAlt
substMetasAlt fuel resolve depth (CaseAlt n bs b) =
  CaseAlt n bs (substMetasFuel fuel resolve (depth + length bs) b)

-- | 骨架的默认燃料：按项规模派生（`termSize` 必 ≥ 嵌套深度；每节点 4 步，覆盖解展开）。
export substMetasFuelFor : Term -> Int
substMetasFuelFor t =
  let
    need = 128 + 4 * termSize t
  in if need > substMetasFuelMax then substMetasFuelMax else need

substMetasFuelMax : Int
substMetasFuelMax = 1000000

-- | 无显式 fuel 的入口。
export substMetas : (Int -> Int -> Maybe Term) -> Int -> Term -> Term
substMetas resolve depth t = substMetasFuel (substMetasFuelFor t) resolve depth t

-- 字典提升：在 `TPi` 链索引 `idx` 的绑定子后插入 `{d : Dict_C a}`（隐式运行时字典）。
-- `dictDom` 里类参数引用插入后索引 +1（`d` 落在类参数绑定子之内）。
export insertDictBinder : String -> Int -> Term -> Term -> Term
insertDictBinder name idx dictDom t = insertDictBinderGo name idx dictDom 0 t

-- 在 telescope 里插入 binder（插在第 idx+1 个 binder 之后）：cod 根处深度恰好是 idx+1，
-- 其中 0..idx 号索引都指向插入点之前的 binder，索引全部 +1；`shift 0 1` 在嵌套 binder
-- 内会把 cutoff 自动抬高 1，正好让「插入点之后才绑定的变量」保持不变。
export insertDictBinderGo : String -> Int -> Term -> Int -> Term -> Term
insertDictBinderGo name idx dictDom depth (TPi n i r d c) =
  if depth == idx then
    TPi n i r d (TPi name True RigOmega dictDom (shift 0 1 c))
  else
    TPi n i r d (insertDictBinderGo name idx dictDom (depth + 1) c)
insertDictBinderGo name idx dictDom depth t = t

-- 同 `insertDictBinder`，但 binder 的 rig 由调用方给（签名 `Member` 证明是 Rig0）。
export insertImplicitBinder : String -> Int -> Rig -> Term -> Term -> Term
insertImplicitBinder name idx rig dom t = insertImplicitBinderGo name idx rig dom 0 t

export insertImplicitBinderGo : String -> Int -> Rig -> Term -> Int -> Term -> Term
insertImplicitBinderGo name idx rig dom depth (TPi n i r d c) =
  if depth == idx then
    TPi n i r d (TPi name True rig dom (shift 0 1 c))
  else
    TPi n i r d (insertImplicitBinderGo name idx rig dom (depth + 1) c)
insertImplicitBinderGo name idx rig dom depth t = t

-- 导出面快照仍引用该名字，故保留导出（本模块自己不用）。
export cutoffOf : Int -> Int -> Int
cutoffOf total idx = if total - (idx + 1) <= 0 then 0 else total - (idx + 1)

export countPis : Term -> Int
countPis (TPi n i r d c) = 1 + countPis c
countPis _ = 0

-- 字典提升：在 `TLam` 链索引 `idx` 的绑定子后插入 `TLam d`。
-- 插入点之后的体 `b` 的自由变量全部位于插入点**外侧**，因此 shift 的 cutoff
-- 必须是 0（`shift` 下钻 binder 时会自动抬高 cutoff，正好保持体内层变量不变）。
-- 传 `total - (idx + 1)` 会让第 `idx` 个 binder 及一部分外侧变量少移一位，被提升的
-- 字典变量因此退化成显式参数（`ma` → `d114` 自应用）。
export insertLamBinder : String -> Int -> Term -> Term
insertLamBinder name idx t = insertLamBinderGo name idx 0 t

export insertLamBinderGo : String -> Int -> Int -> Term -> Term
insertLamBinderGo name idx depth (TLam n r mty sp b) =
  if depth == idx then
    TLam n r mty sp (TLam name RigOmega Nothing spanEmpty (shift 0 1 b))
  else
    TLam n r mty sp (insertLamBinderGo name idx (depth + 1) b)
insertLamBinderGo name idx depth t = t

export countLams : Term -> Int
countLams (TLam n r _ _ b) = 1 + countLams b
countLams _ = 0

-- 项里是否有自由变量（`i >= depth` 的 `TVar`）。闭项无自由变量。
export hasFreeTermVar : Int -> Term -> Bool
hasFreeTermVar depth t = termAnyScoped freeVarAt depth t

freeVarAt : Int -> Term -> Bool
freeVarAt d (TVar _ i _) = i >= d
freeVarAt _ _ = False

-- | 旧名（闭包检查）：与 `hasFreeTermVar` 同一实现。
export hasFreeVar : Int -> Term -> Bool
hasFreeVar = hasFreeTermVar

-- 负 de Bruijn 索引：quote 的越界产物（`varIndexM` 对越界 level 返回 `Nothing`，项里
-- 落成 `-1` 哨兵）。`hasFreeTermVar`
-- 只查上界，负索引会被 `lookupEnv` 的 `i <= 0` 当成**最内层**变量（静默错位），所以
-- 序列化/摘要校验必须单独拒绝它。
export hasNegativeVar : Term -> Bool
hasNegativeVar t = termAnyScoped negativeVarAt 0 t

negativeVarAt : Int -> Term -> Bool
negativeVarAt _ (TVar _ i _) = i < 0
negativeVarAt _ _ = False

export anyNegativeVarArgs : List (Term, Rig) -> Bool
anyNegativeVarArgs [] = False
anyNegativeVarArgs ((a, _) :: rest) = hasNegativeVar a || anyNegativeVarArgs rest

export anyNegativeVarAlts : List CaseAlt -> Bool
anyNegativeVarAlts [] = False
anyNegativeVarAlts (alt :: rest) = hasNegativeVar (caseAltBody alt) || anyNegativeVarAlts rest

-- 值里是否还有未解元变量（`VMeta m` 未解，或解里仍有未解）。
-- 预算耗尽时按**保守方向**回答 `True`（当成「可能还有未解」），避免把不干净的值当可复用。
export hasUnsolvedMetaValue : Sols -> Value -> Bool
hasUnsolvedMetaValue sols v = hasUnsolvedMetaValueFuel metaScanBound sols v

hasUnsolvedMetaValueFuel : Int -> Sols -> Value -> Bool
hasUnsolvedMetaValueFuel fuel sols v =
  if fuel <= 0 then
    True
  else
    case v of
      VMeta m sp =>
        case solsLookup m sols of
          Just solved => hasUnsolvedMetaValueFuel (fuel - 1) sols solved
          Nothing => True
      VNeutral n =>
        case n of
          NVar name lvl sp => hasUnsolvedMetaListFuel (fuel - 1) sols sp
          NGlobal g sp => hasUnsolvedMetaListFuel (fuel - 1) sols sp
      VPi name implicit rig dom clo => hasUnsolvedMetaValueFuel (fuel - 1) sols dom || hasUnsolvedMetaCloFuel (fuel - 1) sols clo
      VLam name rig clo => hasUnsolvedMetaCloFuel (fuel - 1) sols clo
      VCon c args => hasUnsolvedMetaListFuel (fuel - 1) sols args
      VApp f a => hasUnsolvedMetaValueFuel (fuel - 1) sols f || hasUnsolvedMetaValueFuel (fuel - 1) sols a
      -- 分支闭包必须一起扫：scrutinee 干净但分支体里的未解 meta 仍是真实残留。
      VCase scrut alts => hasUnsolvedMetaValueFuel (fuel - 1) sols scrut || hasUnsolvedMetaCaseAltsFuel (fuel - 1) sols alts
      -- tele 只有字段名 / multiplicity，不携带值；底座的 lambda 闭包体由值扫描下钻。
      VProj base c i fi n => hasUnsolvedMetaValueFuel (fuel - 1) sols base
      VIf c th el => hasUnsolvedMetaValueFuel (fuel - 1) sols c || hasUnsolvedMetaValueFuel (fuel - 1) sols th || hasUnsolvedMetaValueFuel (fuel - 1) sols el
      VType l => False
      VInt n => False
      VStr s => False
      VBool b => False
      VFloat d => False

export hasUnsolvedMetaList : Sols -> List Value -> Bool
hasUnsolvedMetaList sols vs = hasUnsolvedMetaListFuel metaScanBound sols vs

hasUnsolvedMetaListFuel : Int -> Sols -> List Value -> Bool
hasUnsolvedMetaListFuel fuel sols vs =
  if fuel <= 0 then
    True
  else
    case vs of
      [] => False
      v :: rest => hasUnsolvedMetaValueFuel (fuel - 1) sols v || hasUnsolvedMetaListFuel (fuel - 1) sols rest

hasUnsolvedMetaCaseAltsFuel : Int -> Sols -> List VCaseAlt -> Bool
hasUnsolvedMetaCaseAltsFuel fuel sols alts =
  if fuel <= 0 then
    True
  else
    case alts of
      [] => False
      alt :: rest => hasUnsolvedMetaCloFuel (fuel - 1) sols (vCaseAltClosure alt) || hasUnsolvedMetaCaseAltsFuel (fuel - 1) sols rest

export hasUnsolvedMetaClo : Sols -> Closure -> Bool
hasUnsolvedMetaClo sols clo = hasUnsolvedMetaCloFuel metaScanBound sols clo

hasUnsolvedMetaCloFuel : Int -> Sols -> Closure -> Bool
hasUnsolvedMetaCloFuel fuel sols clo =
  if fuel <= 0 then
    True
  else
    case clo of
      -- env 之外还要扫体：闭包体里的 `TMeta` 不在环境里，只看 env 会漏判。
      Closure env body => hasUnsolvedMetaListFuel (fuel - 1) sols env || termHasUnsolvedMetaFuel (fuel - 1) sols body

-- ---------------------------------------------------------------
-- 宇宙 helper
-- ---------------------------------------------------------------
export isTypeValue : Value -> Bool
isTypeValue (VType l) = True
isTypeValue _ = False

export typeLevelOf : Value -> Maybe Level
typeLevelOf (VType l) = Just l
typeLevelOf _ = Nothing

-- ---------------------------------------------------------------
-- 打印（错误信息与 interp --dt 结果展示）
-- ---------------------------------------------------------------
-- 解里是否出现 level ≥ limit 的局部变量（即创建该元变量之后才绑定的变量）。
export levelEscapes : Int -> Int -> Value -> Bool
levelEscapes limit depth (VNeutral n) =
  case n of
    NVar name lvl sp => lvl >= limit || levelEscapesList limit sp
    NGlobal g sp => levelEscapesList limit sp
levelEscapes limit depth (VPi name implicit rig dom clo) =
  levelEscapes limit depth dom || levelEscapesClo limit clo
levelEscapes limit depth (VLam name rig clo) = levelEscapesClo limit clo
levelEscapes limit depth (VMeta m sp) = levelEscapesList limit sp
levelEscapes limit depth (VCon c args) = levelEscapesList limit args
levelEscapes limit depth (VApp f a) = levelEscapes limit depth f || levelEscapes limit depth a
levelEscapes limit depth (VCase scrut alts) =
  levelEscapes limit depth scrut || levelEscapesAlts limit alts
-- tele 只有字段名 / multiplicity，不携带值；底座里的闭包由值遍历下钻。
levelEscapes limit depth (VProj base c i fi n) = levelEscapes limit depth base
levelEscapes limit depth (VIf c th el) =
  levelEscapes limit depth c || levelEscapes limit depth th || levelEscapes limit depth el
levelEscapes limit depth (VType l) = False
levelEscapes limit depth (VInt n) = False
levelEscapes limit depth (VStr s) = False
levelEscapes limit depth (VFloat _) = False
levelEscapes limit depth (VBool b) = False

export levelEscapesList : Int -> List Value -> Bool
levelEscapesList limit [] = False
levelEscapesList limit (v :: rest) = levelEscapes limit 0 v || levelEscapesList limit rest

export levelEscapesClo : Int -> Closure -> Bool
levelEscapesClo limit (Closure env body) = levelEscapesList limit env

-- case 分支的闭包环境同样要扫：分支体悬挂在 binder 之下，逃逸只可能来自 env 里的
-- 自由局部变量（body 自身的 binder 不算逃逸）。
levelEscapesAlts : Int -> List VCaseAlt -> Bool
levelEscapesAlts limit [] = False
levelEscapesAlts limit (alt :: rest) =
  levelEscapesClo limit (vCaseAltClosure alt) || levelEscapesAlts limit rest

export showTerm : Term -> String
showTerm (TVar name i _) = name
showTerm (TMeta m) = "?${m}"
showTerm (TGlobal g) = g
showTerm (TType l) = if levelToInt l == 0 then "Type" else "Type ${levelToInt l}"
showTerm (TPi name implicit rig dom cod) =
  if name == "_" then
    "${showTerm dom} -> ${showTerm cod}"
  else if implicit then
    "{${name} : ${showTerm dom}} -> ${showTerm cod}"
  else
    "(${name} : ${showTerm dom}) -> ${showTerm cod}"
showTerm (TLam name rig _ _ body) = "\\${name} => ${showTerm body}"
showTerm (TApp f a rig) = "(${showTerm f} ${showTerm a})"
showTerm (TCon c args) = "(${c}${showArgTerms args})"
showTerm (TMk c args) = "(${c}${showArgTerms args})"
showTerm (TRecord name args) = recordAppShow name args
showTerm (TProj base c tele i fi) = "${showTerm base}.${c}#${fi}"
showTerm (TRecUpd base c tele idxs body) = "${showTerm base} with ${c} ${showTerm body}"
showTerm (TCase scrut alts) = "case ${showTerm scrut} of ${showCoreAlts alts}"
showTerm (TInt n) = strFromInt n
showTerm (TStr s) = showCoreString s
showTerm (TFloat raw) = raw
showTerm (TBool b) = if b then "True" else "False"
showTerm (TIf c th el) = "if ${showTerm c} then ${showTerm th} else ${showTerm el}"

-- 可回读的类型渲染（REPL 自动签名 / `:type` / 合成动作入口签名写回用）。
-- `showTerm` 不为匿名 Pi 的域补括号：`(Int -> Int) -> Int` 会渲染成
-- `Int -> Int -> Int`（右结合），写回源码会静默改变类型；TApp/TCon 的实参也有
-- 同样问题。这里只在需要时补括号，其余形态委托 `showTerm`（诊断文案不受影响）。
-- Pi 类型的显示体：`showTypeSig` 与 `showSigParenIfPi` 共用，避免把「同一个 TPi
-- 重新拼出来后递归」当成结构下降（那不是下降）。
showPiSig : String -> Bool -> Term -> Term -> String
showPiSig name implicit dom cod =
  if name == "_" then
    showSigParenIfPi dom ++ " -> " ++ showTypeSig cod
  else if implicit then
    "{" ++ name ++ " : " ++ showTypeSig dom ++ "} -> " ++ showTypeSig cod
  else
    "(" ++ name ++ " : " ++ showTypeSig dom ++ ") -> " ++ showTypeSig cod

export showTypeSig : Term -> String
showTypeSig (TPi name implicit rig dom cod) = showPiSig name implicit dom cod
showTypeSig (TCon c []) = c
showTypeSig (TApp f a rig) = "(" ++ showSigParenIfPi f ++ " " ++ showSigParenIfPi a ++ ")"
showTypeSig (TCon c args) = "(" ++ c ++ showSigArgs args ++ ")"
showTypeSig (TRecord name args) = showSigAppText name args
showTypeSig t = showTerm t

showSigParenIfPi : Term -> String
showSigParenIfPi (TPi name implicit rig dom cod) = "(" ++ showPiSig name implicit dom cod ++ ")"
showSigParenIfPi t = showTypeSig t

showSigArgs : List (Term, Rig) -> String
showSigArgs [] = ""
showSigArgs ((a, rig) :: rest) = " " ++ showSigParenIfPi a ++ showSigArgs rest

export showArgTerms : List (Term, Rig) -> String
showArgTerms [] = ""
showArgTerms ((a, rig) :: rest) = " ${showTerm a}${showArgTerms rest}"

-- | R4：`TRecord name args` 的显示与等价 `TApp` 链一致（嵌套括号，诊断文案不变）。
recordAppShow : String -> List (Term, Rig) -> String
recordAppShow s [] = s
recordAppShow s ((a, _) :: rest) = recordAppShow ("(" ++ s ++ " " ++ showTerm a ++ ")") rest

-- | R4：`showTypeSig` 版本（实参按需补 Pi 括号，与 `TApp` 链一致）。
showSigAppText : String -> List (Term, Rig) -> String
showSigAppText s [] = s
showSigAppText s ((a, _) :: rest) =
  showSigAppText ("(" ++ s ++ " " ++ showSigParenIfPi a ++ ")") rest

export showCoreAlts : List CaseAlt -> String
showCoreAlts [] = ""
showCoreAlts (alt :: rest) =
  "${caseAltName alt}${showBinders (binderPairs (caseAltBinders alt))} => ${showTerm (caseAltBody alt)} | ${showCoreAlts rest}"

export showBinders : List (String, Rig) -> String
showBinders [] = ""
showBinders ((n, rig) :: rest) = " ${n}${showBinders rest}"

export showCoreString : String -> String
showCoreString s = "\"${showCoreChars (strUnpack s)}\""

export showCoreChars : List Int -> String
showCoreChars [] = ""
showCoreChars (c :: rest) =
  case c of
    34 => "\\\"${showCoreChars rest}"
    92 => "\\\\${showCoreChars rest}"
    10 => "\\n${showCoreChars rest}"
    9 => "\\t${showCoreChars rest}"
    13 => "\\r${showCoreChars rest}"
    _ => strPack [c] ++ showCoreChars rest
