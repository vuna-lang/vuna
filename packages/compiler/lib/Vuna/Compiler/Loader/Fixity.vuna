module Vuna.Compiler.Loader.Fixity where

-- Vuna.Compiler.Loader.Fixity：中缀重排。
--
-- parser 不做优先级判断：中缀链按源码顺序右嵌套，但降级成普通应用
-- `EApp (EVar op) [lhs, rhs]`；「这一层是链步、是否反引号」记在表面形状里
-- （`Frontend.Cst`，按节点 id 查）。括号是重排的边界，同样在表面形状里。
-- 所以本模块的重排上下文同时带 fixity 表与表面形状。本模块按模块可见的 `infix*` 声明
-- （`FixityDecl`：优先级 0–9、结合性 0/1/2）把链重排成 `EApp`，并**在这一步**完成
-- section 立即应用折叠与 `>>` 的 do 派生。
--
-- 表来源：**唯一来源是源码声明**（库或用户）。`->` 是语法而不是用户运算符，
-- 由 `syntaxFixityDecls` 恒可见。表里没有声明的**符号**运算符在中缀位置一律报错（不静默
-- 默认优先级，否则 `a + b * c` 会静默变成 `(a + b) * c`）；fmt 宁可拒绝格式化也不按错
-- 优先级重排。反引号名字（`a `f` b`）是普通函数的中缀写法，没声明时按 9 左结合
-- （Haskell 默认）。
--
-- 重排后 AST 不含 section 与未展开的链步；Elab / codegen 不应看到它们
-- （残留即 internal error）。
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.AstWalk
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Base.Diagnostics.Rn
import Base.Container.HashMap as HashMap

-- 重排上下文：fixity 表 + 从树派生的表面事实（括号边界按节点 id 查）。
export record FixityTable where
  renameMode : Bool
  fixityDecls : List FixityDecl
  fixFacts : FixityFacts

export tableOf : FixityFacts -> List FixityDecl -> FixityTable
tableOf facts ds = FixityTable True ds facts

-- Fmt 用：不替换别名（打印时保留源码里的运算符写法）；section 与反引号保留原形。
export tableOfKeepOps : FixityFacts -> List FixityDecl -> FixityTable
tableOfKeepOps facts ds = FixityTable False ds facts

-- 从树现取事实（工具侧：树就在手上）。
export tableOfCst : CstNode -> List FixityDecl -> FixityTable
tableOfCst cst = tableOf (fixityFactsOf cst)

export tableOfKeepOpsCst : CstNode -> List FixityDecl -> FixityTable
tableOfKeepOpsCst cst = tableOfKeepOps (fixityFactsOf cst)

-- 内建运算符：`->` 是语法，`&&` / `||` 是短路原语。fixity 由编译器固定，
-- 用户声明会命中 `BuiltinFixity`。
export builtinFixityDecls : List FixityDecl
builtinFixityDecls =
  [FixityDecl "->" 1 2 noNodeRef, FixityDecl "&&" 3 1 noNodeRef, FixityDecl "||" 2 1 noNodeRef]

export builtinFixityOps : List String
builtinFixityOps = map fixityOpOf builtinFixityDecls

fixityOpOf : FixityDecl -> String
fixityOpOf d = d.fixityOp

-- 全程序唯一：同一运算符只能有一处声明。声明身份的去重由
-- `Flatten.dedupeFixitiesOf` 按「模块 + 形状 + 位置」完成，这里只判 op 唯一性。
export checkUniqueFixities : List FixityDecl -> Check (List FixityDecl)
checkUniqueFixities ds = checkUniqueFixitiesGo ds (HashMap.fromList [])

checkUniqueFixitiesGo : List FixityDecl -> HashMap String Int -> Check (List FixityDecl)
checkUniqueFixitiesGo [] opSeen = OkC []
checkUniqueFixitiesGo (d :: rest) opSeen =
  let
    sp = fixitySpan d
  in if memName d.fixityOp builtinFixityOps then
    onErrDiag (withFixitySpan sp) (rnNoLoc1 (BuiltinFixity d.fixityOp) d.fixityOp)
  else
    case HashMap.lookup d.fixityOp opSeen of
      Just _ => onErrDiag (withFixitySpan sp) (rnNoLoc1 (DuplicateFixity d.fixityOp) d.fixityOp)
      Nothing => Vuna.Compiler.Base.Common.bind (checkUniqueFixitiesGo rest (HashMap.insert d.fixityOp 1 opSeen)) (\tailDecls => OkC (d :: tailDecls))

-- iface 来源的声明没有 span：不给假位置（与 `Layers.withImportSpan` 同口径）。
withFixitySpan : Span -> Diagnostic -> Diagnostic
withFixitySpan sp e = if spanFile sp == "" then e else withFallbackSpan sp e

-- 第一处匹配生效：调用方把「本模块 + imports 闭包」放在前面、语法表放在后面。
lookupDecl : String -> List FixityDecl -> Maybe FixityDecl
lookupDecl op [] = Nothing
lookupDecl op (d :: rest) = if d.fixityOp == op then Just d else lookupDecl op rest

-- 查找顺序：调用方给的声明（本模块 + import 闭包）→ 语法表（`->`）。没有别处兜底。
export lookupFixityDecl : FixityTable -> String -> Maybe FixityDecl
lookupFixityDecl t op =
  case lookupDecl op t.fixityDecls of
    Just d => Just d
    Nothing => lookupDecl op builtinFixityDecls

export lookupFixity : FixityTable -> String -> Maybe (Int, Int)
lookupFixity t op =
  case lookupFixityDecl t op of
    Just d => Just (d.fixityLevel, d.fixityAssoc)
    Nothing => Nothing

-- 链元素：运算符名、是否反引号写法（未声明时按 9 左结合）、右操作数。
record ChainOp where
  chainOp : String
  chainIsBacktick : Bool
  chainRhs : Expr
  chainRef : NodeRef

-- 未知运算符的诊断（严格表）：不静默默认优先级。
unknownFixityMsg : String -> Diagnostic
unknownFixityMsg op = rnMsg (UnknownFixity op) [op]

-- 运算符优先级：查表；反引号名字没声明时按 9 左结合（Haskell 默认）；未知**符号**运算符
-- 一律报错——fmt 宁可拒绝格式化也不按错优先级重排改变语义。
fixityOf : FixityTable -> ChainOp -> Check (Int, Int)
fixityOf t c =
  case lookupFixity t c.chainOp of
    Just p => OkC p
    Nothing =>
      if c.chainIsBacktick then
        OkC (9, 1)
      else
        onErrDiag (withFallbackSpan (nodeRefSpan c.chainRef)) (ErrC (unknownFixityMsg c.chainOp))

-- rename 模式在名字解析前把 `>>` 派生成 `>>=`（keep 模式留给工具按原形打印）。
-- 两种模式都产出普通应用；反引号写法只影响 fixity 默认值，不影响 AST。
infixTerm : FixityTable -> ChainOp -> Expr -> Expr -> NodeRef -> Expr
infixTerm t c lhs rhs sp =
  if renameMode t && c.chainOp == ">>" then
    EApp (EVar ">>=" sp) [lhs, ELam [("_", spanEmpty)] rhs sp] sp
  else
    EApp (EVar c.chainOp sp) [lhs, rhs] sp

-- 链步判定：parser 把中缀降级成 `EApp (EVar op) [l, r]`。符号名作函数的 2 参应用只可能
-- 来自中缀（前缀写法必须加括号，那是 section）；反引号写法（普通标识符）由表面形状记。
isChainNode : FixityTable -> Expr -> Bool
isChainNode t e =
  case sectionOfFacts t.fixFacts (exprSpan e) of
    Just _ => False
    Nothing =>
      case e of
        EApp (EVar op _) [_, _] _ => isSymbolName op || chainBacktick t e
        EApp (EVar _ _) [_, _] _ => chainBacktick t e
        _ => False

-- 链步是否反引号写法（表面事实；普通符号中缀不在表里）。
chainBacktick : FixityTable -> Expr -> Bool
chainBacktick t e = backtickOfFacts t.fixFacts (nodeRefId (exprRef e))

-- 重排递归的显式上界：合法 AST 远低于它，只防实现 bug；每个节点至少消费 1。
fixityFuel : Int
fixityFuel = 1073741824

-- 把右嵌套的链展平成「首操作数 + 链元素列表」；括号 / 应用 / 原子作为边界操作数
-- （先递归重排）。
collectChainF : Int -> FixityTable -> Expr -> Check (Expr, List ChainOp)
collectChainF fuel t (e@(EApp (EVar op _) [l, r] sp)) =
  if fuel <= 0 then
    icFuel "infix reorder"
  else if isChainNode t e then
    Vuna.Compiler.Base.Common.bind
      (reorderExprF (fuel - 1) t l)
      (\l2 => Vuna.Compiler.Base.Common.bind (chainOperandF (fuel - 1) t r) (\p => OkC (l2, ChainOp op (chainBacktick t e) (firstOf p) sp :: secondOf p)))
  else
    Vuna.Compiler.Base.Common.bind (reorderNonChainF (fuel - 1) t e) (\e2 => OkC (e2, []))
collectChainF fuel t e =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    Vuna.Compiler.Base.Common.bind (reorderNonChainF (fuel - 1) t e) (\e2 => OkC (e2, []))

-- | 链的右操作数：被括号包住时是**边界**（整体作为一个操作数，不再沿链展平）；
-- 否则继续收集同一行上的后继运算符。
chainOperandF : Int -> FixityTable -> Expr -> Check (Expr, List ChainOp)
chainOperandF fuel t r =
  if fuel <= 0 then
    icFuel "infix reorder"
  else if parenDepthOfFacts t.fixFacts (nodeRefId (exprRef r)) > 0 then
    Vuna.Compiler.Base.Common.bind (reorderExprF (fuel - 1) t r) (\r2 => OkC (r2, []))
  else
    collectChainF (fuel - 1) t r

-- precedence climbing：`rest` 里同级/更高级的运算符继续被消费。
-- 显式 fuel 计步（`more` 是列表模式变量，SCT 对「tuple 列表」的递减度量
-- 不闭合；按「守卫 Int」判据给上界，每次递归消费一个运算符）。
climb : Int -> FixityTable -> Int -> Expr -> List ChainOp -> NodeRef -> Check (Expr, List ChainOp)
climb fuel t minPrec lhs rest sp =
  if fuel <= 0 then
    icInternal "infix reorder fuel exhausted"
  else
    case rest of
      [] => OkC (lhs, [])
      c :: more =>
        case fixityOf t c of
          ErrC e => ErrC e
          OkC fx =>
            let
              level = firstOf fx
              assoc = secondOf fx
              nextMin = if assoc == 2 then level else level + 1
              rhs = c.chainRhs
            in if level < minPrec then
              OkC (lhs, rest)
            else
              Vuna.Compiler.Base.Common.bind (climb (fuel - 1) t nextMin rhs more sp) (
                  \p =>
                    case p of
                      (rhs2, more2) => climb (fuel - 1) t minPrec (infixTerm t c lhs rhs2 sp) more2 sp
                )

-- 一条中缀链：先展平，再按优先级重排；重排后不允许剩运算符。
reorderChainF : Int -> FixityTable -> Expr -> Check Expr
reorderChainF fuel t e =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    Vuna.Compiler.Base.Common.bind (collectChainF (fuel - 1) t e) (
        \p =>
          case p of
            (first, rest) =>
              Vuna.Compiler.Base.Common.bind (climb (2 * length rest + 2) t 0 first rest (exprRef e)) (
                  \q =>
                    case q of
                      (out, leftover) => if length leftover == 0 then OkC out else icInternal "infix reorder left an operator"
                )
      )

-- section 已在 parser 降级成 λ；这里只把「section 立即应用」折叠成普通应用
-- （`(+ e) a` ⇒ `a + e`），不生成新的 lambda。
foldApps : Expr -> List Expr -> NodeRef -> Expr
foldApps base [] sp = base
foldApps base (a :: rest) sp = foldApps (EApp base [a] sp) rest sp

-- | 非中缀链的表达式：子节点统一走 `AstWalk.mapExprPat`；链节点与 section 在入口
-- 单独拦截（它们是重排语义的一部分，不是结构遍历）。
reorderNonChainF : Int -> FixityTable -> Expr -> Check Expr
reorderNonChainF fuel t (ELam names body sp) =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    case sectionOfFacts t.fixFacts (nodeRefSpan sp) of
      -- section λ 的体是 parser 合成的应用：只重排操作数与实参，不把合成应用当普通
      -- 中缀链收集（否则 `(+ (1+2)) 3` 会被重排成 `(x*1)+2`）。
      Just _ => Vuna.Compiler.Base.Common.bind (mapExpr (reorderExprF (fuel - 1) t) body) (\b => OkC (ELam names b sp))
      Nothing => Vuna.Compiler.Base.Common.bind (reorderExprF (fuel - 1) t body) (\b => OkC (ELam names b sp))
reorderNonChainF fuel t (EApp fn args sp) =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    case fn of
      ELam _ body secSp =>
        case sectionOfFacts t.fixFacts (nodeRefSpan secSp) of
          Just shape => if renameMode t then reorderSectionApplyF (fuel - 1) t shape body args sp else reorderAppF (fuel - 1) t fn args sp
          Nothing => reorderAppF (fuel - 1) t fn args sp
      _ => reorderAppF (fuel - 1) t fn args sp
reorderNonChainF fuel t e =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    mapExprPat (reorderExprF (fuel - 1) t) (reorderPatternF (fuel - 1) t) e

reorderAppF : Int -> FixityTable -> Expr -> List Expr -> NodeRef -> Check Expr
reorderAppF fuel t fn args sp =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    mapExprPat (reorderExprF (fuel - 1) t) (reorderPatternF (fuel - 1) t) (EApp fn args sp)

reorderSectionApplyF : Int -> FixityTable -> SectionShape -> Expr -> List Expr -> NodeRef -> Check Expr
reorderSectionApplyF fuel t shape (EApp (EVar op opSp) bodyArgs bsp) args sp =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    case shape of
      SectionLeft _ =>
        case bodyArgs of
          [_, operand] => applySectionLeftF (fuel - 1) t op opSp operand args sp
          _ => reorderAppF (fuel - 1) t (EApp (EVar op opSp) bodyArgs bsp) args sp
      SectionRight _ =>
        case bodyArgs of
          [operand, _] => applySectionRightF (fuel - 1) t op opSp operand args sp
          _ => reorderAppF (fuel - 1) t (EApp (EVar op opSp) bodyArgs bsp) args sp
      SectionOp _ => reorderAppF (fuel - 1) t (EApp (EVar op opSp) bodyArgs bsp) args sp
reorderSectionApplyF fuel t shape body args sp =
  if fuel <= 0 then icFuel "infix reorder" else reorderAppF (fuel - 1) t body args sp

applySectionLeftF : Int -> FixityTable -> String -> NodeRef -> Expr -> List Expr -> NodeRef -> Check Expr
applySectionLeftF fuel t op opSp operand [] sp = icInternal "section application without arguments"
applySectionLeftF fuel t op opSp operand (a :: rest) sp =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    Vuna.Compiler.Base.Common.bind
      (reorderExprF (fuel - 1) t a)
      (\a2 => Vuna.Compiler.Base.Common.bind (reorderExprF (fuel - 1) t operand) (\o2 => Vuna.Compiler.Base.Common.bind (Vuna.Compiler.Base.Common.traverse (\x => reorderExprF (fuel - 1) t x) rest) (\r2 => OkC (foldApps (EApp (EVar op opSp) [a2, o2] sp) r2 sp))))

applySectionRightF : Int -> FixityTable -> String -> NodeRef -> Expr -> List Expr -> NodeRef -> Check Expr
applySectionRightF fuel t op opSp operand [] sp = icInternal "section application without arguments"
applySectionRightF fuel t op opSp operand (a :: rest) sp =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    Vuna.Compiler.Base.Common.bind
      (reorderExprF (fuel - 1) t operand)
      (\o2 => Vuna.Compiler.Base.Common.bind (reorderExprF (fuel - 1) t a) (\a2 => Vuna.Compiler.Base.Common.bind (Vuna.Compiler.Base.Common.traverse (\x => reorderExprF (fuel - 1) t x) rest) (\r2 => OkC (foldApps (EApp (EVar op opSp) [o2, a2] sp) r2 sp))))

-- | 表达式重排入口：中缀 / backtick 链交给 `reorderChain`，其余交给 `reorderNonChain`。
export reorderExpr : FixityTable -> Expr -> Check Expr
reorderExpr t e = reorderExprF fixityFuel t e

reorderExprF : Int -> FixityTable -> Expr -> Check Expr
reorderExprF fuel t (e@(EApp (EVar _ _) [_, _] _)) =
  if fuel <= 0 then
    icFuel "infix reorder"
  else if isChainNode t e then reorderChainF (fuel - 1) t e else reorderNonChainF (fuel - 1) t e
reorderExprF fuel t e =
  if fuel <= 0 then icFuel "infix reorder" else reorderNonChainF (fuel - 1) t e

export reorderPattern : FixityTable -> Pat -> Check Pat
reorderPattern t pat = reorderPatternF fixityFuel t pat

reorderPatternF : Int -> FixityTable -> Pat -> Check Pat
reorderPatternF fuel t pat =
  if fuel <= 0 then icFuel "infix reorder" else mapPat (reorderPatternF (fuel - 1) t) pat

reorderDeclF : Int -> FixityTable -> Decl -> Check Decl
reorderDeclF fuel t d =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    mapDeclWith
      (reorderExprF (fuel - 1) t)
      (reorderPatternF (fuel - 1) t)
      (reorderInstanceMethodDeclF (fuel - 1) t)
      (reorderTraitParamF (fuel - 1) t)
      d

-- | 重排 trait 参数显式 kind 里的中缀（`Type -> Type` 这类 kind 必须经过 Loader，否则 Elab 见到未重排的链步）。
reorderTraitParamF : Int -> FixityTable -> TraitParam -> Check TraitParam
reorderTraitParamF fuel t p =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    case p.traitParamKind of
      Nothing => OkC p
      Just k => Vuna.Compiler.Base.Common.bind (reorderExprF (fuel - 1) t k) (\k2 => OkC (TraitParam p.traitParamName (Just k2)))

reorderInstanceMethodDeclF : Int -> FixityTable -> Decl -> Check Decl
reorderInstanceMethodDeclF fuel t (DSig name ctx ty sp) =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    mapDeclWith
      (reorderExprF (fuel - 1) t)
      (reorderPatternF (fuel - 1) t)
      (\d => OkC d)
      (reorderTraitParamF (fuel - 1) t)
      (DSig name ctx ty sp)
reorderInstanceMethodDeclF fuel t (DFun name pats body sp) =
  if fuel <= 0 then
    icFuel "infix reorder"
  else
    mapDeclWith
      (reorderExprF (fuel - 1) t)
      (reorderPatternF (fuel - 1) t)
      (\d => OkC d)
      (reorderTraitParamF (fuel - 1) t)
      (DFun name pats body sp)
-- | instance 体只允许方法签名与方法子句（parser 用 `ExpectedInstanceMethod` 挡其它形状）。
-- 走到这里说明 AST 被别的路径改成了非法形状，按内部错误报出，不静默放行成后续 ICE。
reorderInstanceMethodDeclF fuel t other =
  onErrDiag
    (withFallbackSpan (declSpan other))
    (icInternal "instance body has a declaration that is neither a signature nor a function")

export reorderProgram : FixityTable -> List Decl -> Check (List Decl)
reorderProgram t decls = mapDeclsWith (reorderDeclF fixityFuel t) decls
