-- | 闭包图上的纯算法：可达名字闭包与依赖序拓扑排序。
--
-- 只吃 `(名字, 依赖名列表)` 两个投影，不认识 `ClosureMod` / `ModuleIface` / `Module`；
-- 源码扫描、接口读取与 loader 语义留在各自的 Eff/Check 层。fuel 只防病态图，合法输入
-- 每访问一个节点至少消费 1 步。
module Vuna.Compiler.Loader.Closure where

import Base.Data.List as List
import Vuna.Compiler.Base.Common

-- ---------------------------------------------------------------
-- 闭包节点（纯数据）
-- ---------------------------------------------------------------
-- | 一个包在闭包里的身份 / 环境（地址计算的输入）。
export record ClosurePkg(..) where
  peName : String
  peDir : String
  peKey : String
  peEnv : String
  peImplicitPrelude : Bool

-- | 一个模块在闭包里的全部输入：包身份 / 模块名 / 源码路径 / 内容地址与 63-bit 键 /
-- header import 边 / 接口地址。
export record ClosureMod(..) where
  cmPkg : String
  cmPkgKey : String
  cmPkgEnv : String
  cmName : String
  cmPath : String
  cmSrc : String
  cmKey : Int
  cmImports : List String
  cmAddr : String
deriving (Selectors)

-- ---------------------------------------------------------------
-- 可达名字闭包
-- ---------------------------------------------------------------
-- | 从 `starts` 沿 `depsOf` 展开可达名字。结果按首次访问的逆序返回（与既有
-- `importClosureOf` / `closureNamesOf` 一致）；不在 `nodes` 里的外部名字保留在结果里，
-- 但不再展开。重复名字只保留一次。
export reachableFrom : (a -> String) -> (a -> List String) -> List String -> List a -> List String
reachableFrom nameOf depsOf starts nodes =
  reachableGo (closureFuel starts nodes depsOf) nameOf depsOf nodes starts []

closureFuel : List String -> List a -> (a -> List String) -> Int
closureFuel starts nodes depsOf = length starts + length nodes + closureEdges nodes depsOf + 1

closureEdges : List a -> (a -> List String) -> Int
closureEdges [] _ = 0
closureEdges (n :: rest) depsOf = length (depsOf n) + closureEdges rest depsOf

reachableGo : Int -> (a -> String) -> (a -> List String) -> List a -> List String -> List String -> List String
reachableGo fuel nameOf depsOf nodes work acc =
  if fuel <= 0 then
    acc
  else
    case work of
      [] => acc
      name :: rest =>
        if memName name acc then
          reachableGo (fuel - 1) nameOf depsOf nodes rest acc
        else
          case findByName nameOf nodes name of
            Nothing => reachableGo (fuel - 1) nameOf depsOf nodes rest (name :: acc)
            Just node => reachableGo (fuel - 1) nameOf depsOf nodes (append (depsOf node) rest) (name :: acc)

-- ---------------------------------------------------------------
-- 依赖层（并行调度）
-- ---------------------------------------------------------------
-- | 按依赖层切分：每一层内的节点依赖只落在更早的层（或图外名字）。层内保持输入顺序，
-- 供调用方并行执行。图成环 / 没有可运行层 ⇒ 显式内部错误，不静默全起。
export topoLayers : (a -> String) -> (a -> List String) -> List a -> Check (List (List a))
topoLayers nameOf depsOf nodes =
  let
    names = map nameOf nodes
  in topoLayersGo (length nodes + 1) nameOf depsOf names nodes []

topoLayersGo : Int -> (a -> String) -> (a -> List String) -> List String -> List a -> List (List a) -> Check (List (List a))
topoLayersGo _ _ _ _ [] acc = OkC (reverse acc)
topoLayersGo fuel nameOf depsOf names pending acc =
  if fuel <= 0 then
    icInternal "closure: dependency cycle"
  else
    let
      done = concatMap (map nameOf) acc
      ready = filter (\n => depsReady nameOf depsOf names done n) pending
    in if length ready == 0 then
      icInternal "closure: dependency cycle"
    else
      let
        rest = filter (\n => not (depsReady nameOf depsOf names done n)) pending
      in topoLayersGo (fuel - 1) nameOf depsOf names rest (ready :: acc)

depsReady : (a -> String) -> (a -> List String) -> List String -> List String -> a -> Bool
depsReady nameOf depsOf names done n = depsReadyGo names done (depsOf n)

depsReadyGo : List String -> List String -> List String -> Bool
depsReadyGo _ _ [] = True
depsReadyGo names done (d :: rest) =
  (not (memName d names) || memName d done) && depsReadyGo names done rest

-- ---------------------------------------------------------------
-- 依赖序拓扑排序
-- ---------------------------------------------------------------
-- | 按输入顺序作为起点顺序做 DFS 后序（依赖在前）。`starts` 的先后由调用方决定；
-- 需要跨缓存状态确定时，调用方先把节点排成全序。不在 `nodes` 里的依赖名被忽略。
export topoOrderBy : (a -> String) -> (a -> List String) -> List a -> List a
topoOrderBy nameOf depsOf nodes =
  secondOf (topoVisitAll (length nodes + 1) nameOf depsOf nodes (map nameOf nodes) [] [])

topoVisit : Int -> (a -> String) -> (a -> List String) -> List a -> String -> List String -> List a -> (List String, List a)
topoVisit fuel nameOf depsOf nodes name visited acc =
  if fuel <= 0 then
    (visited, acc)
  else if memName name visited then
    (visited, acc)
  else
    case findByName nameOf nodes name of
      Nothing => (name :: visited, acc)
      Just node =>
        let
          step = topoVisitAll (fuel - 1) nameOf depsOf nodes (depsOf node) (name :: visited) acc
        in (firstOf step, append (secondOf step) [node])

topoVisitAll : Int -> (a -> String) -> (a -> List String) -> List a -> List String -> List String -> List a -> (List String, List a)
topoVisitAll fuel nameOf depsOf nodes work visited acc =
  if fuel <= 0 then
    (visited, acc)
  else
    case work of
      [] => (visited, acc)
      name :: rest =>
        let
          step = topoVisit fuel nameOf depsOf nodes name visited acc
        in topoVisitAll (fuel - 1) nameOf depsOf nodes rest (firstOf step) (secondOf step)

findByName : (a -> String) -> List a -> String -> Maybe a
findByName _ [] _ = Nothing
findByName nameOf (n :: rest) name =
  if nameOf n == name then Just n else findByName nameOf rest name
