-- | 输入摘要（地址）层：落盘对象的路径由这里的纯函数决定。
module Vuna.Compiler.Loader.Addr where

-- Vuna.Compiler.Loader.Addr：**唯一寻址规则**的实现。
--
--   落盘路径 = 该对象的输入摘要     ⇒   「命中」= 路径存在性
--
-- 于是索引、依赖快照比较、写锁、会话持久化都不再需要：缓存是否新鲜由路径本身回答。
-- 载荷完整性仍由 `Store` framing 头里的内容地址兜底（读侧重算）。
--
-- 本模块只提供**通用构造器**与模块依赖图（header）。每个载荷族在自己的模块里定义
-- 输入分段（`addrOf ["module-iface", codec, …]`），避免与 `Store`/`Driver` 成环。
--
-- 分段用 `Canonical.Bytes` 的 `[n:…]`/`s<len>:` 自定界编码再取 SHA-256：不用「拼字符串
-- 再加分隔符」，因为那会 reintroduce `("a","bc")` 与 `("ab","c")` 同键的歧义。
import Base.Data.List as List
import Vuna.Compiler.Base.Bytes
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Base.Hash

-- | 地址格式版本：分段文法或摘要算法变化时递增（地址随之换代）。
export addrSchema : String
addrSchema = "vuna-addr 1"

-- | 内容摘要（小输入：SHA-256 十六进制）。
export hashHex : String -> String
hashHex s = digestHex (digestOfString s)

-- | 输入摘要：域分隔的规范编码后取 SHA-256。
export addrOf : List String -> String
addrOf parts = hashHex (encTop (encList encStr) (addrSchema :: parts))

-- | 项目身份：**规范化绝对包目录**的摘要。roots 按项目分目录（`store/roots/<id>/`），
-- 编译器与 `vuna deps fetch` 必须用同一个公式，否则 GC 的保护集合会对不上。
export projectIdAddrOf : String -> String
projectIdAddrOf dir = addrOf ["project", dir]

-- ---------------------------------------------------------------
-- 模块头（header）
--
-- import 名单与 fixity 表是 parse 的产物。抽取口径只有 `headerOfSource` 一处。
-- 载荷与模块名无关（名字来自路径），所以同一份字节在不同包/路径下得到同一份头。
--
-- 隐式导入（Prelude）不进 header：它依赖包上下文，同一份源文件在两个包里应得到不同的
-- 依赖边。依赖方在算输入摘要时**无条件**并入 `Prelude` 的输入摘要（过近似，
-- 只多失效不漏失效）。
-- ---------------------------------------------------------------
export record FixRow(..) where
  frOp : String
  frLevel : Int
  frAssoc : Int

export record ModHeader(..) where
  mhName : String
  mhImports : List String
  mhFixities : List FixRow

-- ---------------------------------------------------------------
-- 从 parse 产物抽出 header
-- ---------------------------------------------------------------
export fixRowOf : FixityDecl -> FixRow
fixRowOf f = FixRow f.fixityOp f.fixityLevel f.fixityAssoc

importNameOf : Import -> String
importNameOf (Import n _ _ _) = n

-- `export module C [as X]` 在加载期会合成 `import C`（Flatten 的 namespaceImportsOf），
-- 但源码 import 表里没有它。header 是接口闭包的依赖边来源，漏掉它会让依赖方的接口闭包
-- 缺 C（构造子/类型的 canonical 名查不到）。
exportItemDep : ExportItem -> List String
exportItemDep (XModule name _) = [name]
exportItemDep (XNamespace name _ _) = [name]
exportItemDep _ = []

dedupNames : List String -> List String
dedupNames [] = []
dedupNames (x :: rest) = if memName x rest then dedupNames rest else (::) x (dedupNames rest)

-- | 模块名 + 显式 import 名单（含 `export module` 合成的 import）+ fixity 表。
-- 隐式导入由调用方在算摘要时并入（见模块头）。
export headerOfSource : String -> SourceFile -> ModHeader
headerOfSource name (SourceFile _ imports fixities _ _ reexports _) =
  ModHeader
    name
    (dedupNames (append (map importNameOf imports) (concatMap exportItemDep reexports)))
    (map fixRowOf fixities)
