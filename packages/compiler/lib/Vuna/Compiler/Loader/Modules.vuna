module Vuna.Compiler.Loader.Modules where

-- Vuna.Compiler.Loader.Modules：加载器的**数据与模块图**（叶子层，无跨 Loader 子模块依赖）。
--
-- 只放：Module / Project / ExportEntry / ExportRef 的类型与访问器、import 表的纯函数
-- 校验、模块根查找（`findModuleFile`）、模块表与导出表的查询。名字解析在 Resolve，
-- 导出表计算、加载流程与 flatten 在 Flatten；门面 `Vuna.Compiler.Loader` 重导出这些入口。
import Vuna.Compiler.Base.Diagnostics.Loader
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics.Rn
import Base.HashMap
import Base.List
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Base.Eq
import Vuna.Compiler.Frontend.Packages.Pkg
import Base.EffFs
import Base.Eff.Types

-- 显式 import 与自动注入的 Prelude（隐式 import）分开保存：
-- 名字解析与 codegen 拓扑序用 all；模块重导出/include 只认显式 import。
-- 最后一个字段是**可见 fixity 表**（本模块声明 + imports 闭包，查找时本模块优先；
-- 中缀重排见 `Loader.Fixity`）。
export record Module(..) where
  moduleNameOf : String
  modulePackageOf : String
  moduleImportsOf : List Import
  moduleImplicitImportsOf : List Import
  moduleDeclsOf : List Decl
  moduleExportsOf : List ExportEntry
  moduleFixitiesOf : List FixityDecl
  -- | 模块头导出列表里 `module X` 重导出的 import 名（`import X` / `import X as Y`
  -- 统一成 `X`）。resolve 期把它们并入 used-import 集合，`UN_UnusedImport` 才不会把
  -- 「只用于重导出」的 import 报成未使用（used-set 在加载期标记、resolve 期被重置）。
  moduleReexportsOf : List String
  -- D11：本模块声明为 opaque 的定义全名（已 mangle）；下游 depStart 不把它们的体放进 deftbl。
  moduleOpaqueOf : List String
  -- | 公开名 → 该名字的全部导出条目（保持 `moduleExportsOf` 里的顺序）。解析期按名字
  -- 查导出走这张表；裸导出表线性扫在每次名字解析里都会重扫一遍。
  moduleExportIndexOf : HashMap String (List ExportEntry)

-- 已加载项目：入口声明/import + 依赖模块列表（保持 flatten 前的形态）。
-- entryPkg 用于按包限制 effectful 内建（普通包只能经 Eff + handler 使用效果）。
-- entryFixities 是入口文件自己的 fixity 声明（入口 decls 的重排要用）。
export record Project(..) where
  projectEntryDecls : List Decl
  projectEntryImports : List Import
  projectImplicitImports : List Import
  projectModules : List Module
  projectEntryPkg : String
  projectEntryFixities : List FixityDecl

export moduleNameOf : Module -> String
moduleNameOf (Module n p is imps ds es fx _ _ _) = n

export modulePackageOf : Module -> String
modulePackageOf (Module n p is imps ds es fx _ _ _) = p

export moduleAllImportsOf : Module -> List Import
moduleAllImportsOf (Module n p is imps ds es fx _ _ _) = append is imps

export moduleDeclsOf : Module -> List Decl
moduleDeclsOf (Module n p is imps ds es fx _ _ _) = ds

export moduleFixitiesOf : Module -> List FixityDecl
moduleFixitiesOf (Module n p is imps ds es fx _ _ _) = fx

-- | 模块重导出的 import 名（见 Module 字段注释）。
export moduleReexportsOf : Module -> List String
moduleReexportsOf (Module n p is imps ds es fx reexports _ _) = reexports

export moduleOpaqueOf : Module -> List String
moduleOpaqueOf (Module n p is imps ds es fx reexports opacity _) = opacity

export projectEntryAllImports : Project -> List Import
projectEntryAllImports (Project ds is imps ms pkg fx) = append is imps

-- 解析期的三个命名空间，与导出表 kind 一一对应，**不拍平**。
--   values = 值命名空间（DFun / 签名 / 实例名；导出 kind "val"）
--   ctors  = 构造子命名空间（data 构造子 / record 名 / trait 方法；导出 kind "ctor"）
--   types  = 类型命名空间（data / record / trait 的类型名；导出 kind "type"）
-- 解析位置决定查哪个表：类型位置只查 types；值位置按 values → ctors → types（类型当项）。
export record Namespaces(..) where
  nsValues : List String
  nsCtors : List String
  nsTypes : List String
  -- 解析期查找的 O(1) 版本（每个 EVar 都会查这三个集合；list 线性查找在几十万
  -- 节点上是主要 resolve 成本）。list 字段保留给错误提示的 suggest。
  nsValueSet : HashMap String Bool
  nsCtorSet : HashMap String Bool
  nsTypeSet : HashMap String Bool
  -- data/record 构造子的候选表（短名 → 未加模块 prefix 的 "Data.Ctor"）。
  -- 同名构造子按族区分；trait 方法不在此表（不是族的构造子）。
  nsCtorCands : List (Pair String String)
  -- release 构建模式：Resolve 的 assert/todo 拒绝检查用（显式传入，不读进程环境）。
  nsRelease : Bool

-- 字段访问按全局唯一字段名解析（Elab 降级成模式绑定）；构造用命名字段。
-- 模块导出表。每条是「本模块公开名 → 定义处带模块前缀的名字」。
-- kind 用字符串区分两套命名空间：val（函数/值）、ctor（构造器）、type（类型名）。
-- ctor 条目额外记录所属数据类型的定义名，供 `T(..)` 重导出保持源模块的抽象性。
-- 模块导出表条目：公开名、定义处名字、所属类型（仅 ctor）。
export record ExportEntry(..) where
  kind : String
  public : String
  target : String
  parent : String
deriving (Eq)

export record ExportRef(..) where
  refKind : String
  refTarget : String
  refParent : String

allIdentChars : List Int -> Bool
allIdentChars [] = True
allIdentChars (c :: rest) = (isIdentStart c || isDigit c) && allIdentChars rest

validSegment : String -> Bool
validSegment seg = case strUnpack seg of
  [] => False
  c :: rest => isUpperChar c && allIdentChars rest

allSegmentsValid : List String -> Bool
allSegmentsValid [] = False
allSegmentsValid (seg :: rest) = if validSegment seg then case rest of
  [] => True
  _ => allSegmentsValid rest
else False

export validModuleName : String -> Bool
validModuleName name = case splitOnDot name of
  [] => False
  segs => allSegmentsValid segs

export mangle : String -> String -> String
mangle prefix name = if prefix == "" then name else "${prefix}.${name}"

-- | 构造子 canonical 名 = `Module.Data.Ctor`（entry 文件 `Data.Ctor`）。
-- 不同数据类型的同名构造子因此天然不冲突；裸名按期望类型在候选里选（见 Resolve/Elab）。
export ctorCanonical : String -> String -> String -> String
ctorCanonical prefix dname cname = mangle prefix "${dname}.${cname}"

export importName : Import -> String
importName (Import name isQualified alias sp) = name

export importModuleNames : List Import -> List String
importModuleNames imports = map importName imports

-- 导入点 span：隐式我们自己的合成 Import 没有真实位置（file = ""）时不加。
withImportSite : Span -> Diagnostic -> Diagnostic
withImportSite sp d = if spanFile sp == "" then d else withFallbackSpan sp d

-- | 限定名候选：显式 alias / 完整模块名是强候选；最后一段是弱候选。
-- 强候选非空时只用强候选（强限定优先），否则回落到弱候选。结果按出现顺序去重。
export qualifierCandidates : List Import -> String -> List String
qualifierCandidates imports q =
  let
    strong =
      nubNames
        (append (map importName (filter (\imp => importName imp == q) imports)) (map importName (filter (\imp => aliasIs q imp) imports)))
  in if notEmptyList strong then strong
  else nubNames (map importName (filter (\imp => lastSegment (importName imp) == q) imports))

aliasIs : String -> Import -> Bool
aliasIs q imp = case imp.importAlias of
  Just alias => alias == q
  Nothing => False

lastSegment : String -> String
lastSegment name = case splitLastDot (splitOnDot name) of
  Pair _ base => base

notEmptyList : List a -> Bool
notEmptyList [] = False
notEmptyList (_ :: _) = True

-- | 校验 alias 语法（单个合法大写段）；重复 alias / 与模块名冲突不再在 import 期报错，
-- 由使用点的限定名候选集判定。
export validateImports : String -> List Import -> Check (List a)
validateImports label imports = checkImportAliasSyntax imports

checkImportAliasSyntax : List Import -> Check (List a)
checkImportAliasSyntax [] = OkC []
checkImportAliasSyntax (imp :: rest) = case imp.importAlias of
  Nothing => checkImportAliasSyntax rest
  Just alias =>
    if validSegment alias then checkImportAliasSyntax rest
    else onErrDiag (withImportSite imp.importSpan) (rnNoLoc1 (InvalidModuleAlias alias) alias)

openModuleNames : List Import -> List String
openModuleNames [] = []
openModuleNames (imp :: rest) =
  if imp.importIsQualified then openModuleNames rest
  else nubNames ((::) (importName imp) (openModuleNames rest))

-- 纯查找（不标记 used）：`import X` 或 `import X as Y` 里 `name` 对应的 import 模块名。
export findImportModule : List Import -> String -> Maybe String
findImportModule [] _ = Nothing
findImportModule (imp :: rest) name = if importName imp == name then Just (importName imp)
else case imp.importAlias of
  Just alias => if alias == name then Just (importName imp) else findImportModule rest name
  Nothing => findImportModule rest name

-- 模块头导出列表里 `module X` 对应的 import 名（去重、保持出现顺序）。加载期算好放进
-- `Module.moduleReexportsOf`，resolve 期并入 used-import 集合。
export reexportedImportNames : List Import -> List ExportItem -> List String
reexportedImportNames imports items = reexportedImportNamesGo imports items []

reexportedImportNamesGo : List Import -> List ExportItem -> List String -> List String
reexportedImportNamesGo imports [] acc = Base.List.reverse acc
reexportedImportNamesGo imports ((XModule name _) :: rest) acc = case findImportModule imports name of
  Nothing => reexportedImportNamesGo imports rest acc
  Just m =>
    if memName m acc then reexportedImportNamesGo imports rest acc
    else reexportedImportNamesGo imports rest ((::) m acc)
reexportedImportNamesGo imports ((XNamespace name _ _) :: rest) acc = case findImportModule imports name of
  Nothing => reexportedImportNamesGo imports rest acc
  Just m =>
    if memName m acc then reexportedImportNamesGo imports rest acc
    else reexportedImportNamesGo imports rest ((::) m acc)
reexportedImportNamesGo imports (_ :: rest) acc = reexportedImportNamesGo imports rest acc

-- | 有显式导出列表时才算重导出；无 module 头 / 隐式导出 = []。
export reexportedImportNamesOfHeader : List Import -> Maybe ModDecl -> List String
reexportedImportNamesOfHeader imports (Just (ModDecl _ True items _ _ _ _)) =
  reexportedImportNames imports items
reexportedImportNamesOfHeader imports _ = []

_joinNames : List String -> String
_joinNames [] = ""
_joinNames ([x]) = x
_joinNames (x :: rest) = "${x}, ${_joinNames rest}"

-- 查一个**必须已加载**的模块。把「模块未加载」当成「空表」（`moduleDecls` /
-- `exportsOf` 的 `Nothing => []`）会让调用方只看到「没有这个导出」，于是一个加载器
-- 状态不一致被伪装成普通的「名字不存在」，错误被静默吞掉。缺模块直接返回清晰的 Err
-- （这是内部不变量，不是用户源码错误）。
missingModule : String -> Check a
missingModule name =
  icInternal "module ${name} is not loaded (import list and module table disagree)"

export moduleDecls : List Module -> String -> Check (List Decl)
moduleDecls modules name = case findModule modules name of
  Just (Module mname mpkg imports imps decls exports fx _ _ _) => OkC decls
  Nothing => missingModule name

moduleCtors : List Module -> String -> Check (List String)
moduleCtors modules name =
  Vuna.Compiler.Base.Common.bind (moduleDecls modules name) (\decls => OkC (ctorsOf decls))

-- | 把 import/限定名里的路径解析成真实模块名：先查直接模块；不是真实模块时按
-- 「最长已加载模块前缀 + 命名空间路径」解析。供 `exportsOf` / 索引查询使用。
export resolveModuleName : List Module -> String -> Maybe String
resolveModuleName modules name = case findModule modules name of
  Just _ => Just name
  Nothing => resolvePathModule modules (splitOnDot name) (Base.List.length (splitOnDot name) - 1)

resolvePathModule : List Module -> List String -> Int -> Maybe String
resolvePathModule modules segs n = if n < 1 then Nothing
else case findModule modules (joinDots (takeSegsLocal n segs)) of
  Just _ => walkNamespaceIndex modules (joinDots (takeSegsLocal n segs)) (dropFirst n segs)
  Nothing => resolvePathModule modules segs (n - 1)

export exportsOf : List Module -> String -> Check (List ExportEntry)
exportsOf modules name = case findModule modules (resolvedName modules name) of
  Just (Module mname mpkg imports imps decls exports fx _ _ _) => OkC exports
  Nothing => missingModule name

resolvedName : List Module -> String -> String
resolvedName modules name = case resolveModuleName modules name of
  Just real => real
  Nothing => name

-- | 导出表的公开名索引（保持原顺序；同名的 val/ctor/type 条目并存）。
export exportIndexOf : List ExportEntry -> HashMap String (List ExportEntry)
exportIndexOf entries = exportIndexOfGo entries (Base.HashMap.fromList [])

exportIndexOfGo : List ExportEntry -> HashMap String (List ExportEntry) -> HashMap String (List ExportEntry)
exportIndexOfGo [] idx = idx
exportIndexOfGo (e :: rest) idx =
  let
    tail = exportIndexOfGo rest idx
  in Base.HashMap.insert e.public ((::) e (entriesByName e.public tail)) tail

-- | 索引里某个公开名的全部条目（无则空）。
entriesByName : String -> HashMap String (List ExportEntry) -> List ExportEntry
entriesByName name idx = case Base.HashMap.lookup name idx of
  Just es => es
  Nothing => []

export exportIndexOfModule : List Module -> String -> Check (HashMap String (List ExportEntry))
exportIndexOfModule modules name = case findModule modules (resolvedName modules name) of
  Just m => OkC m.moduleExportIndexOf
  Nothing => missingModule name

-- 按命名空间查公开名：kinds 是允许的 kind 列表（val / ctor / type）。
lookupExport : List String -> String -> List ExportEntry -> Maybe ExportEntry
lookupExport kinds name [] = Nothing
lookupExport kinds name (e :: rest) =
  if memName e.kind kinds && e.public == name then Just e else lookupExport kinds name rest

export findExportValue : List ExportEntry -> String -> Maybe ExportEntry
findExportValue entries name = lookupExport ["val", "ctor"] name entries

-- | 同名值/构造子条目的全部候选（重导出后可能来自不同 target）。
export findExportValues : List ExportEntry -> String -> List ExportEntry
findExportValues entries name = filterKinds ["val", "ctor"] name entries

export findExportTypes : List ExportEntry -> String -> List ExportEntry
findExportTypes entries name = filterKinds ["type"] name entries

export findExportModules : List ExportEntry -> String -> List ExportEntry
findExportModules entries name = filterKinds ["module"] name entries

filterKinds : List String -> String -> List ExportEntry -> List ExportEntry
filterKinds kinds name [] = []
filterKinds kinds name (e :: rest) =
  if memName e.kind kinds && e.public == name then (::) e (filterKinds kinds name rest)
  else filterKinds kinds name rest

export findExportCtor : List ExportEntry -> String -> Maybe ExportEntry
findExportCtor entries name = lookupExport ["ctor"] name entries

-- | 同名构造子可以有多条导出（不同族、不同 target）。裸名解析要拿全集。
export findExportCtors : List ExportEntry -> String -> List ExportEntry
findExportCtors entries name = filterCtors name entries

-- | 导出表里 kind 为 ctor 且公开名匹配的全部条目。
filterCtors : String -> List ExportEntry -> List ExportEntry
filterCtors name [] = []
filterCtors name (e :: rest) =
  if e.kind == "ctor" && e.public == name then (::) e (filterCtors name rest)
  else filterCtors name rest

export findExportType : List ExportEntry -> String -> Maybe ExportEntry
findExportType entries name = lookupExport ["type"] name entries

-- | `export module` 命名空间路径条目（kind = "module"，public 是路径文本）。
export findExportModule : List ExportEntry -> String -> Maybe ExportEntry
findExportModule entries name = lookupExport ["module"] name entries

export findExportModuleIn : HashMap String (List ExportEntry) -> String -> Maybe ExportEntry
findExportModuleIn idx name = lookupExport ["module"] name (entriesByName name idx)

export findExportValueIn : HashMap String (List ExportEntry) -> String -> Maybe ExportEntry
findExportValueIn idx name = lookupExport ["val", "ctor"] name (entriesByName name idx)

export findExportValuesIn : HashMap String (List ExportEntry) -> String -> List ExportEntry
findExportValuesIn idx name = filterKinds ["val", "ctor"] name (entriesByName name idx)

export findExportTypesIn : HashMap String (List ExportEntry) -> String -> List ExportEntry
findExportTypesIn idx name = filterKinds ["type"] name (entriesByName name idx)

export findExportCtorIn : HashMap String (List ExportEntry) -> String -> Maybe ExportEntry
findExportCtorIn idx name = lookupExport ["ctor"] name (entriesByName name idx)

export findExportCtorsIn : HashMap String (List ExportEntry) -> String -> List ExportEntry
findExportCtorsIn idx name = filterCtors name (entriesByName name idx)

export findExportTypeIn : HashMap String (List ExportEntry) -> String -> Maybe ExportEntry
findExportTypeIn idx name = lookupExport ["type"] name (entriesByName name idx)

modulesExportingValueFrom : List Module -> List String -> String -> Check (List (Pair String ExportEntry))
modulesExportingValueFrom modules [] name = OkC []
modulesExportingValueFrom modules (m :: rest) name = Vuna.Compiler.Base.Common.bind (exportIndexOfModule modules m) (\idx => case findExportValuesIn idx name of
  [] => modulesExportingValueFrom modules rest name
  entries =>
    Vuna.Compiler.Base.Common.bind (modulesExportingValueFrom modules rest name)
      (\more => OkC (append (map (\e => Pair m e) entries) more))
)

export modulesExportingValue : List Module -> List Import -> String -> Check (List (Pair String ExportEntry))
modulesExportingValue modules imports name =
  modulesExportingValueFrom modules (openModuleNames imports) name

-- | 在给定的多个模块里找同名构造子的导出条目（每个模块可贡献多条）。
modulesExportingCtorFrom : List Module -> List String -> String -> Check (List (Pair String ExportEntry))
modulesExportingCtorFrom modules [] name = OkC []
modulesExportingCtorFrom modules (m :: rest) name = Vuna.Compiler.Base.Common.bind (exportIndexOfModule modules m) (\idx => let
  found = findExportCtorsIn idx name
in Vuna.Compiler.Base.Common.bind (modulesExportingCtorFrom modules rest name)
  (\more => OkC (append (map (\e => Pair m e) found) more))
)

export modulesExportingCtor : List Module -> List Import -> String -> Check (List (Pair String ExportEntry))
modulesExportingCtor modules imports name =
  modulesExportingCtorFrom modules (openModuleNames imports) name

modulesExportingTypeFrom : List Module -> List String -> String -> Check (List (Pair String ExportEntry))
modulesExportingTypeFrom modules [] name = OkC []
modulesExportingTypeFrom modules (m :: rest) name = Vuna.Compiler.Base.Common.bind (exportIndexOfModule modules m) (\idx => case findExportTypesIn idx name of
  [] => modulesExportingTypeFrom modules rest name
  entries =>
    Vuna.Compiler.Base.Common.bind (modulesExportingTypeFrom modules rest name)
      (\more => OkC (append (map (\e => Pair m e) entries) more))
)

export modulesExportingType : List Module -> List Import -> String -> Check (List (Pair String ExportEntry))
modulesExportingType modules imports name =
  modulesExportingTypeFrom modules (openModuleNames imports) name

-- 重导出时同名可能来自多个模块；只要 target 相同就不是歧义（门面伞模块常见）。
sameTargetRest : ExportEntry -> List (Pair a ExportEntry) -> Bool
sameTargetRest e [] = True
sameTargetRest e ((Pair m e2) :: rest) = e.target == e2.target && sameTargetRest e rest

export unifyEntryPairs : String -> String -> String -> List (Pair String ExportEntry) -> Check (Pair String ExportEntry)
unifyEntryPairs label kindLabel name [] = icInternal "unifyEntryPairs: empty candidates"
unifyEntryPairs label kindLabel name (p :: rest) =
  if sameTargetRest (secondOf p) rest then OkC p
  else err
    "${label}: ambiguous ${kindLabel} ${name} (imported from ${_joinNames (map firstOf (p :: rest))}); qualify it"

modulePath : Root -> String -> String
modulePath root name = "${rootDir root}/${joinSlashes (splitOnDot name)}.vuna"

-- 当前导入方所在包能否看到该 root 中的模块：同包永远可见；跨包只认 [export] 列表。
rootAllows : String -> Root -> String -> Bool
rootAllows importerPkg root name = case root.rootExports of
  Nothing => True
  Just mods => rootName root == importerPkg || memName name mods

-- 模块根候选的**存在性探测**是宿主动作，显式在 `Eff []` 里；
-- 可见性判定与候选分类保持纯。
export collectModuleFiles : Member nFs FsOp r => List Root -> String -> String -> List (Pair String Root) -> List String -> Eff r (Pair (List (Pair String Root)) (List String))
collectModuleFiles [] name importerPkg allowed hidden =
  pure (Pair (reverse allowed) (reverse hidden))
collectModuleFiles (root :: rest) name importerPkg allowed hidden =
  let
    path = modulePath root name
  in do
    exists <- fsFileExists path
    if exists then if rootAllows importerPkg root name then collectModuleFiles rest name importerPkg (Pair path root :: allowed) hidden
    else collectModuleFiles rest name importerPkg allowed (rootName root :: hidden)
    else collectModuleFiles rest name importerPkg allowed hidden

_joinRootDirs : List Root -> String
_joinRootDirs roots = _joinNames (map rootDir roots)

candidateDir : Pair String Root -> String
candidateDir candidate = rootDir (secondOf candidate)

-- 导入点位置兜底：隐式 Prelude 的合成 Import 没有真实 span（file = ""）时不加位置。
withImporterSpan : Span -> Diagnostic -> Diagnostic
withImporterSpan sp d = if spanFile sp == "" then d else withFallbackSpan sp d

export findModuleFile : Member nFs FsOp r => List Root -> String -> String -> Span -> Eff r (Check (Pair String Root))
findModuleFile roots name importerPkg importerSpan = do
  collected <- collectModuleFiles roots name importerPkg [] []
  let
    allowed = firstOf collected
    hidden = secondOf collected
  in pure (case allowed of
    [] => case hidden of
      [] =>
        onErrDiag (withImporterSpan importerSpan)
          (ldErr2 (ModuleNotFound name (_joinRootDirs roots)) name (_joinRootDirs roots))
      pkgs =>
        onErrDiag (withImporterSpan importerSpan)
          (ldErr2 (ModuleNotExported name (_joinNames hidden)) name (_joinNames hidden))
    [only] => OkC only
    candidates =>
      onErrDiag (withImporterSpan importerSpan)
        (rnNoLoc2 (AmbiguousModule name (_joinNames (map candidateDir allowed))) name (_joinNames (map candidateDir allowed)))
  )

-- | 在模块 `m` 的命名空间导出里按最长点号前缀走路径，返回最终目标模块名。
-- 目标模块必须已加载（它是 m 的依赖）。
export walkNamespaceIndex : List Module -> String -> List String -> Maybe String
walkNamespaceIndex modules m segs =
  walkNamespaceIndexFuel (1 + Base.List.length segs) modules m segs

export moduleExportIndexOfOf : Module -> HashMap String (List ExportEntry)
moduleExportIndexOfOf (Module _ _ _ _ _ _ _ _ _ idx) = idx

walkNamespaceIndexFuel : Int -> List Module -> String -> List String -> Maybe String
walkNamespaceIndexFuel fuel modules m segs = if fuel <= 0 then Nothing
else case findModule modules m of
  Nothing => Nothing
  Just md => if Base.List.length segs <= 0 then Just (moduleNameOf md)
  else case longestIndexPrefix (moduleExportIndexOfOf md) segs (Base.List.length segs) of
    Nothing => Nothing
    Just (Pair target k) => walkNamespaceIndexFuel (fuel - 1) modules target (dropFirst k segs)

longestIndexPrefix : HashMap String (List ExportEntry) -> List String -> Int -> Maybe (Pair String Int)
longestIndexPrefix idx segs k = if k <= 0 then Nothing
else case findExportModuleIn idx (joinDots (takeSegsLocal k segs)) of
  Just e => Just (Pair e.target k)
  Nothing => longestIndexPrefix idx segs (k - 1)

takeSegsLocal : Int -> List String -> List String
takeSegsLocal n [] = []
takeSegsLocal n (x :: rest) = if n <= 0 then [] else (::) x (takeSegsLocal (n - 1) rest)

dropFirst : Int -> List String -> List String
dropFirst n [] = []
dropFirst n (x :: rest) = if n <= 0 then (::) x rest else dropFirst (n - 1) rest

export findModule : List Module -> String -> Maybe Module
findModule [] name = Nothing
findModule ((Module mname mpkg imports imps decls exports fx reexports opacity idx) :: rest) name =
  if mname == name then Just (Module mname mpkg imports imps decls exports fx reexports opacity idx)
  else findModule rest name

-- target 是否是某个 data/record 的构造子（用于把 trait method 从“构造子重载候选”
-- 里排除；trait method 不是族的构造子，仍按原名字解析）。
-- | 任一已加载模块里是否存在以 target 为 canonical 名的 data/record 构造子。
export isDataOrRecordCtorTarget : List Module -> String -> Bool
isDataOrRecordCtorTarget modules target =
  let
    cname = lastSeg target
    dprefix = prefixOfName target
  in if dprefix == "" then False else anyModuleCtorTarget modules target dprefix cname

anyModuleCtorTarget : List Module -> String -> String -> String -> Bool
anyModuleCtorTarget [] _ _ _ = False
anyModuleCtorTarget (m :: rest) target dprefix cname =
  let
    mname = moduleNameOf m
  in if not (startsWith mname target) then anyModuleCtorTarget rest target dprefix cname
  else isCtorTargetInDecls mname target dprefix cname (moduleDeclsOf m)
    || anyModuleCtorTarget rest target dprefix cname

-- | 单模块声明里是否存在 canonical 名为 target 的 data/record 构造子。
-- 先按 canonical 的「数据前缀」筛一次族，再比构造子短名；不再为每个构造子拼一次
-- `${mname}.${dname}.${cname}`（解析期这一步按名字调用，拼接量随构造子数放大）。
isCtorTargetInDecls : String -> String -> String -> String -> List Decl -> Bool
isCtorTargetInDecls mname target dprefix cname [] = False
isCtorTargetInDecls mname target dprefix cname (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    mangle mname dname == dprefix && anyCtorNamed cname ctors
      || isCtorTargetInDecls mname target dprefix cname rest
  DRecord dname params fields derivings viaField repr lin sp =>
    mangle mname dname == target || isCtorTargetInDecls mname target dprefix cname rest
  _ => isCtorTargetInDecls mname target dprefix cname rest

anyCtorNamed : String -> List Ctor -> Bool
anyCtorNamed cname [] = False
anyCtorNamed cname (c :: rest) = ctorName c == cname || anyCtorNamed cname rest

-- | `data dname` 的构造子里是否有 canonical 名为 target 的。
anyCtorTarget : String -> String -> String -> List Ctor -> Bool
anyCtorTarget mname dname target [] = False
anyCtorTarget mname dname target (c :: rest) =
  ctorCanonical mname dname (ctorName c) == target || anyCtorTarget mname dname target rest
