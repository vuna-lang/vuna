module Vuna.Compiler.Loader.Flatten where

-- Vuna.Compiler.Loader.Flatten：模块导出表计算、加载流程与 flatten。
--
-- 依赖 `Loader.Modules`（模块/导出表）与 `Loader.Resolve`（名字解析）：先算每个模块的
-- 导出表，再按 import 图递归加载（含隐式 Prelude）。
-- 入口统一吃 `PackageContext`（最近 manifest 的包 + 依赖闭包 roots）；DT 精化由
-- `Driver.Dt` 按「依赖序列 + 入口声明」拼接。
import Base.Data.List as List
import Vuna.Compiler.Loader.Layers
import Vuna.Compiler.Base.Diagnostics.Loader
import Vuna.Compiler.Loader.Expand
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics.Warning
import Vuna.Compiler.Base.Diagnostics.Rn
import Base.Container.HashMap as HashMap
import Base.Data.ObsSpan as ObsSpan
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Frontend.Parser.Support
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Loader.Modules
import Vuna.Compiler.Loader.Resolve
import Vuna.Compiler.Base.Intrinsics
import Vuna.Compiler.Base.Obs
import Vuna.Compiler.Frontend.Packages.Pkg
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes
import Base.Effect.Env as EffEnv
import Base.Effect.Process as EffProcess

-- imports 模块的**可见 fixity 表**（Module 里已含各自的 import 闭包）。
-- 本模块声明由调用方放在返回列表最前，查找时第一处匹配生效。
-- parse 错误带文件名（前端诊断无位置，加载器知道路径）。
--
-- 不做 AST / token 缓存：`Canonical.Ast` 的编码口径**故意丢 span**（它是 iface 哈希输入，
-- 移动代码不能改依赖方摘要），用它当缓存载荷会让进程里所有诊断位置退化成 `:0:0`、
-- codegen 的 `dt_def_locs` 整表变成 `":0"`；tokens 缓存的净收益在整包 check 上不到 0.1 s，
-- 不值得为它冻结一份载荷 schema。所有加载路径都从源文本 lex。
--
-- 缓存读写、模块文件探测与读盘都是宿主动作，显式在 `Eff r` 里；
-- 导出表计算、flatten 与 resolve 保持纯函数。
-- | 解析一个源文件：lex 一次，再走语法分析。所有加载路径都走这里。
-- 编译器路径用 `PmStrict`（语义级语法错误致命）；只需要 AST 的工具（fixity 解析）用
-- `parseFileWithPathMode PmTool`，别让「重复 binder」把整个文件挡在门外。
export parseFileWithPath : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> Eff r (Check SourceFile)
parseFileWithPath = parseFileWithPathMode PmStrict

export parseFileWithPathMode : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => ParseMode -> String -> String -> Eff r (Check SourceFile)
parseFileWithPathMode mode path src =
  case obsSpan "vuna.parse.lex" "vuna.phase" (\_ => lexSource src) of
    ErrC e => pure (ErrC (withSpanFileIfEmpty path e))
    OkC toks => pure (parseWith mode path toks)

-- | 由 token 流得到 parse 结果。Lexer/Parser 都已在产生点给出 span；这里只给词法诊断
-- 那个 file 为空的 span 注入真实路径（parser 的 span 从 PState 拿文件名）。
-- 恢复期收集到的多条诊断挂在首条错误上（批量错误通道），全部自带位置。
parseWith : ParseMode -> String -> List PTok -> Check SourceFile
parseWith mode path toks =
  case obsSpan "vuna.parse.syntax" "vuna.phase" (\_ => parseSourceRecoveringTokens path mode toks) of
    ErrC e => ErrC (withSpanFileIfEmpty path e)
    OkC p =>
      let
        parsed = firstOf p
        errs = secondOf p
      in case errs of
        [] => OkC parsed
        e :: rest => ErrC (withChildren rest e)

-- fixity 是**程序级**属性：加载闭包里所有模块的声明构成一张表（import 到就全局生效），
-- 不再按逐模块的可见闭包拼接。`Module` 里存的是该模块自己的声明。
-- | 声明身份 = 所属模块 + 运算符 + 级别 + 结合性 + 源码位置。iface 路径的 span 全空，
-- 必须靠模块名区分不同模块的同名声明（否则会被静默去重，`RN_DuplicateFixity` 失效）。
-- `local` 是入口文件自己的声明（不属于任何模块）。
dedupeFixitiesOf : List Module -> List FixityDecl -> List FixityDecl
dedupeFixitiesOf modules local =
  dedupeFixitiesGo
    (append (concatMap (\m => map (\d => ("${moduleNameOf m}|${fixityDeclKey d}", d)) (moduleFixitiesOf m)) modules) (map (\d => ("|entry|${fixityDeclKey d}", d)) local))
    (HashMap.fromList [])
    []

dedupeFixitiesGo : List (String, FixityDecl) -> HashMap String Int -> List FixityDecl -> List FixityDecl
dedupeFixitiesGo [] seen acc = reverse acc
dedupeFixitiesGo (p :: rest) seen acc =
  let
    key = firstOf p
  in case HashMap.lookup key seen of
    Just _ => dedupeFixitiesGo rest seen acc
    Nothing => dedupeFixitiesGo rest (HashMap.insert key 1 seen) (secondOf p :: acc)

-- 声明身份键：**运算符 + 形状 + 声明处位置**（模块名由调用方前缀）。
fixityDeclKey : FixityDecl -> String
fixityDeclKey d =
  let
    sp = fixitySpan d
  in "${d.fixityOp}|${strFromInt d.fixityLevel}|${strFromInt d.fixityAssoc}|${spanFile sp}:${spanStartLine sp}:${spanStartCol sp}"

-- ---------------------------------------------------------------
-- 模块导出表计算
-- ---------------------------------------------------------------
isPrivateName : String -> Bool
isPrivateName name = startsWith "_" name

privateExportMsg : String -> Span -> String -> Diagnostic
privateExportMsg prefix sp name =
  diagAt
    sp
    SevError
    PhLoad
    CatPackage
    ""
    "${prefix}: cannot export private name ${name} (names starting with _ are module-private)"

-- 本模块里与导出相关的「数据类型」信息：类型名 + 公开构造器名列表。
-- data / record / trait 都按同一套 T / T(..) 规则导出（trait 的方法是它的「构造器」）。
findOwnData : String -> List Decl -> Maybe (String, List String)
findOwnData name [] = Nothing
findOwnData name (d :: rest) =
  case d of
    DData dname params kind ctors derivings viaField repr lin sp =>
      if dname == name then Just (dname, map ctorName ctors) else findOwnData name rest
    DRecord dname params fields derivings viaField repr lin sp =>
      if dname == name then Just (dname, [dname]) else findOwnData name rest
    DTrait tname params supers methods sp =>
      if tname == name then Just (tname, map traitMethodName methods) else findOwnData name rest
    _ => findOwnData name rest

findOwnFn : String -> List Decl -> Maybe String
findOwnFn name [] = Nothing
findOwnFn name (d :: rest) =
  case d of
    DFun n pats body sp => if n == name then Just name else findOwnFn name rest
    DSig n ctx ty sp => if n == name then Just name else findOwnFn name rest
    DAxiom n ty sp => if n == name then Just name else findOwnFn name rest
    DExtern n c ty sp => if n == name then Just name else findOwnFn name rest
    _ => findOwnFn name rest

findCtorNamed : String -> List Ctor -> Maybe String
findCtorNamed name [] = Nothing
findCtorNamed name (c :: rest) =
  if ctorName c == name then Just (ctorName c) else findCtorNamed name rest

-- trait 方法按 `TraitMethod` 取名字（`traitMethodName`）。
findMethodNamed : String -> List TraitMethod -> Maybe String
findMethodNamed name [] = Nothing
findMethodNamed name ((TraitMethod mname ty msp) :: rest) =
  if mname == name then Just mname else findMethodNamed name rest

-- | 本模块里名为 name 的**全部**构造子（不同族可同名）。裸名导出/重导出必须检测歧义。
findOwnCtorNames : String -> List Decl -> List (String, String)
findOwnCtorNames name [] = []
findOwnCtorNames name (d :: rest) =
  case d of
    DData dname params kind ctors derivings viaField repr lin sp =>
      append
        (map (\c => (dname, ctorName c)) (filter (\c => ctorName c == name) ctors))
        (findOwnCtorNames name rest)
    DRecord dname params fields derivings viaField repr lin sp =>
      if dname == name then
        (::) (dname, dname) (findOwnCtorNames name rest)
      else
        findOwnCtorNames name rest
    DTrait tname params supers methods sp =>
      append
        (map (\m => (tname, traitMethodName m)) (filter (\m => traitMethodName m == name) methods))
        (findOwnCtorNames name rest)
    _ => findOwnCtorNames name rest

-- record / trait 的「构造子」条目：target = parent（构造子名 = 类型名 / 方法名）。
ownCtorEntries : String -> String -> List String -> List ExportEntry
ownCtorEntries prefix dname [] = []
ownCtorEntries prefix dname (cname :: rest) =
  (::)
    ExportEntry { kind = "ctor", public = cname, target = mangle prefix cname, parent = mangle prefix dname }
    (ownCtorEntries prefix dname rest)

-- data 构造子的 canonical target 是 `Module.Data.Ctor`。
-- | 本地 data 声明的构造子导出条目（target 用族限定名）。
ownDataCtorEntries : String -> String -> List String -> List ExportEntry
ownDataCtorEntries prefix dname [] = []
ownDataCtorEntries prefix dname (cname :: rest) =
  (::)
    ExportEntry { kind = "ctor", public = cname, target = ctorCanonical prefix dname cname, parent = mangle prefix dname }
    (ownDataCtorEntries prefix dname rest)

-- | 本地类型名的完整导出条目（type + 其构造子/方法），供 `T(..)` 导出使用。
ownTypeEntries : String -> List Decl -> String -> Maybe (List ExportEntry)
ownTypeEntries prefix [] name = Nothing
ownTypeEntries prefix (d :: rest) name =
  case d of
    DData dname params kind ctors derivings viaField repr lin sp =>
      if dname == name then
        Just
          ((::) ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" } (ownDataCtorEntries prefix dname (map ctorName ctors)))
      else
        ownTypeEntries prefix rest name
    DRecord dname params fields derivings viaField repr lin sp =>
      if dname == name then
        Just
          ((::) ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" } (ownCtorEntries prefix dname [dname]))
      else
        ownTypeEntries prefix rest name
    DTrait tname params supers methods sp =>
      if tname == name then
        Just
          ((::) ExportEntry { kind = "type", public = tname, target = mangle prefix tname, parent = "" } (ownCtorEntries prefix tname (map traitMethodName methods)))
      else
        ownTypeEntries prefix rest name
    _ => ownTypeEntries prefix rest name

-- 从某模块的导出表里取某数据类型的构造器条目：重导出 `T(..)` 时只重新公开
-- 源模块本来就公开的构造器，从而保持源模块的抽象性。
ctorEntriesOfType : String -> List ExportEntry -> List ExportEntry
ctorEntriesOfType typeTarget [] = []
ctorEntriesOfType typeTarget (e :: rest) =
  if e.kind == "ctor" && e.parent == typeTarget then
    (::) e (ctorEntriesOfType typeTarget rest)
  else
    ctorEntriesOfType typeTarget rest

-- 裸名导出时，若名字是 **record 类型** 且与其同名构造器 target 相同，只导出类型、
-- 不导出构造器：抽象记录必须写 T(..) 才公开构造器。（普通 data 里 ctor 与类型同名
-- 的情形保持 v0 语义：裸名两者都导出。）
typeRefDominates : List Module -> List Decl -> String -> Maybe ExportRef -> Maybe ExportRef -> Bool
typeRefDominates modules decls prefix (Just (ExportRef tk tt tp)) vr =
  case vr of
    Just (ExportRef vk vt vp) =>
      if tk == "type" && vk == "ctor" && tt == vt then
        isRecordTarget modules decls prefix tt
      else
        False
    Nothing => False
typeRefDominates modules decls prefix Nothing vr = False

isRecordTarget : List Module -> List Decl -> String -> String -> Bool
isRecordTarget modules decls prefix target =
  case splitLastDot (splitOnDot target) of
    (revPrefix, base) =>
      let
        m = joinDots revPrefix
      in if m == prefix then
        isRecordDecl base decls
      else
        case findModule modules m of
          Just (Module mname mpkg mimports mimps dcs exports mfx _ _ _) => isRecordDecl base dcs
          Nothing => False

isRecordDecl : String -> List Decl -> Bool
isRecordDecl dname [] = False
isRecordDecl dname (d :: rest) =
  case d of
    DRecord dn params fields derivings viaField repr lin sp =>
      dn == dname || isRecordDecl dname rest
    _ => isRecordDecl dname rest

refEntryList : String -> Maybe ExportRef -> List ExportEntry
refEntryList pub Nothing = []
refEntryList pub (Just (ExportRef k tgt parent)) =
  [ExportEntry { kind = k, public = pub, target = tgt, parent = parent }]

ownOrImportedTypeRef : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedTypeRef modules prefix decls imports name =
  case findOwnData name decls of
    Just (dname, ctorNames) => OkC (Just (ExportRef "type" (mangle prefix dname) ""))
    Nothing =>
      Vuna.Compiler.Base.Common.bind (modulesExportingType modules imports name) (
          \pairs =>
            case pairs of
              [] => OkC Nothing
              _ => Vuna.Compiler.Base.Common.bind (unifyEntryPairs prefix "type" name pairs) (\p => OkC (Just (ExportRef "type" (secondOf p).target "")))
        )

ownOrImportedValueRef : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedValueRef modules prefix decls imports name =
  case findOwnFn name decls of
    Just fn => OkC (Just (ExportRef "val" (mangle prefix fn) ""))
    Nothing => ownOrImportedValueRef2 modules prefix decls imports name

-- | 本模块值 / 构造子名字的导出引用（构造子走 `ownCtorEntriesNamed` 的歧义检测）。
ownOrImportedValueRef2 : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedValueRef2 modules prefix decls imports name =
  case ownCtorEntriesNamed prefix name decls of
    [e] => OkC (Just (ExportRef "ctor" e.target e.parent))
    _ :: _ :: _ => rnNoLoc1 (AmbiguousConstructorExport name) name
    [] =>
      Vuna.Compiler.Base.Common.bind (modulesExportingValue modules imports name) (
          \pairs =>
            case pairs of
              [] => OkC Nothing
              _ =>
                Vuna.Compiler.Base.Common.bind (unifyEntryPairs prefix "name" name pairs) (
                    \p =>
                      let
                        e = secondOf p
                      in OkC (Just (ExportRef e.kind e.target e.parent))
                  )
        )

-- | 本模块里名为 name 的构造子导出条目（data 用族限定 target；record/trait 用原名）。
ownCtorEntriesNamed : String -> String -> List Decl -> List ExportEntry
ownCtorEntriesNamed prefix name [] = []
ownCtorEntriesNamed prefix name (d :: rest) =
  case d of
    DData dname params kind ctors derivings viaField repr lin sp =>
      append
        (ownDataCtorEntries prefix dname (map ctorName (filter (\c => ctorName c == name) ctors)))
        (ownCtorEntriesNamed prefix name rest)
    DRecord dname params fields derivings viaField repr lin sp =>
      if dname == name then
        append (ownCtorEntries prefix dname [dname]) (ownCtorEntriesNamed prefix name rest)
      else
        ownCtorEntriesNamed prefix name rest
    DTrait tname params supers methods sp =>
      append
        (ownCtorEntries prefix tname (map traitMethodName (filter (\m => traitMethodName m == name) methods)))
        (ownCtorEntriesNamed prefix name rest)
    _ => ownCtorEntriesNamed prefix name rest

exportBare : List Module -> String -> List Decl -> List Import -> String -> Span -> Check (List ExportEntry)
exportBare modules prefix decls imports name sp =
  case splitLastDot (splitOnDot name) of
    (revPrefix, base) =>
      case revPrefix of
        [] =>
          Vuna.Compiler.Base.Common.bind (ownOrImportedTypeRef modules prefix decls imports name) (
              \tr =>
                Vuna.Compiler.Base.Common.bind (ownOrImportedValueRef modules prefix decls imports name) (
                    \vr =>
                      case tr of
                        Nothing =>
                          case vr of
                            Nothing => rnAt1 sp (CannotExportUnknownName name) name
                            Just _ => OkC (refEntryList name vr)
                        Just _ =>
                          case vr of
                            Nothing => OkC (refEntryList name tr)
                            Just _ => if typeRefDominates modules decls prefix tr vr then OkC (refEntryList name tr) else OkC (append (refEntryList name tr) (refEntryList name vr))
                  )
            )
        _ =>
          let
            mprefix = joinDots revPrefix
          in Vuna.Compiler.Base.Common.bind
            (resolveImportPrefix imports mprefix)
            (\m => exportSelective modules prefix m base name sp)

renameExportEntry : String -> ExportEntry -> ExportEntry
renameExportEntry public e =
  ExportEntry { kind = e.kind, public = public, target = e.target, parent = e.parent }

renameTypeEntry : String -> ExportEntry -> ExportEntry
renameTypeEntry public e =
  ExportEntry { kind = "type", public = public, target = e.target, parent = "" }

-- | 从指定模块按短名选择性导出：同名多 target 的条目全部保留，使用点再判定。
exportSelective : List Module -> String -> String -> String -> String -> Span -> Check (List ExportEntry)
exportSelective modules prefix m base name sp =
  Vuna.Compiler.Base.Common.bind (exportsOf modules m) (
      \es =>
        let
          values = map (renameExportEntry base) (findExportValues es base)
          types = map (renameTypeEntry base) (findExportTypes es base)
          entries = append values types
        in if isEmptyEntries entries then rnAt1 sp (CannotExportUnknownName name) name else OkC entries
    )

isEmptyEntries : List a -> Bool
isEmptyEntries [] = True
isEmptyEntries (_ :: _) = False

exportTypeAll : List Module -> String -> List Decl -> List Import -> String -> Span -> Check (List ExportEntry)
exportTypeAll modules prefix decls imports name sp =
  case splitLastDot (splitOnDot name) of
    (revPrefix, base) =>
      case revPrefix of
        [] =>
          case ownTypeEntries prefix decls name of
            Just entries => OkC entries
            Nothing =>
              Vuna.Compiler.Base.Common.bind (modulesExportingType modules imports name) (
                  \pairs =>
                    case pairs of
                      [] => rnAt1 sp (CannotExportUnknownName name) name
                      _ =>
                        Vuna.Compiler.Base.Common.bind (unifyEntryPairs prefix "type" name pairs) (
                            \p =>
                              let
                                m = firstOf p
                              in let
                                tgt = (secondOf p).target
                              in Vuna.Compiler.Base.Common.bind (exportsOf modules m) (\es => OkC ((::) ExportEntry { kind = "type", public = name, target = tgt, parent = "" } (ctorEntriesOfType tgt es)))
                          )
                )
        _ =>
          let
            mprefix = joinDots revPrefix
          in Vuna.Compiler.Base.Common.bind (resolveImportPrefix imports mprefix) (
              \m =>
                Vuna.Compiler.Base.Common.bind (exportsOf modules m) (
                    \es =>
                      case findExportType es base of
                        Just e => OkC ((::) ExportEntry { kind = "type", public = base, target = e.target, parent = "" } (ctorEntriesOfType e.target es))
                        Nothing => rnAt2 sp (TypeNotExported base m) base m
                  )
            )

-- | `export module C [as X]` 对应的 import：已 import 过 C 就复用，否则合成
-- `import C [as X]`（保持 import 区的 open 语义；不写进 AST，Fmt 仍按 `export module` 渲染）。
namespaceImportsOf : List Import -> List ExportItem -> List Import
namespaceImportsOf imports items = append imports (reverse (namespaceImportsGo imports items []))

namespaceImportsGo : List Import -> List ExportItem -> List Import -> List Import
namespaceImportsGo imports [] acc = acc
namespaceImportsGo imports ((XNamespace target alias sp) :: rest) acc =
  if hasImportOf imports target || hasImportOf acc target then
    namespaceImportsGo imports rest acc
  else
    namespaceImportsGo imports rest ((::) (Import target False alias sp) acc)
namespaceImportsGo imports (_ :: rest) acc = namespaceImportsGo imports rest acc

hasImportOf : List Import -> String -> Bool
hasImportOf [] name = False
hasImportOf (imp :: rest) name = importName imp == name || hasImportOf rest name

-- | 导出项里的模块前缀：必须唯一（重复 alias/弱短名在导出定义处报歧义）。
resolveImportPrefix : List Import -> String -> Check String
resolveImportPrefix imports prefix =
  case qualifierCandidates imports prefix of
    [m] => OkC m
    [] => rnNoLoc1 (ModuleNotImported prefix) prefix
    ms => rnNoLoc2 (AmbiguousModule prefix (joinCommaNames ms)) prefix (joinCommaNames ms)

joinCommaNames : List String -> String
joinCommaNames [] = ""
joinCommaNames ([x]) = x
joinCommaNames (x :: rest) = "${x}, ${joinCommaNames rest}"

exportItemEntries : List Module -> String -> List Decl -> List Import -> ExportItem -> Check (List ExportEntry)
exportItemEntries modules prefix decls imports (XModule name sp) =
  Vuna.Compiler.Base.Common.bind (resolveImportPrefix imports name) (\m => exportsOf modules m)
exportItemEntries modules prefix decls imports (XNamespace name alias sp) =
  Vuna.Compiler.Base.Common.bind (resolveImportPrefix imports name) (
      \m =>
        case alias of
          Nothing => exportsOf modules m
          Just path => if path == name then OkC [namespaceEntry name m] else OkC [namespaceEntry name m, namespaceEntry path m]
    )
exportItemEntries modules prefix decls imports (XTypeAll name sp) =
  exportTypeAll modules prefix decls imports name (nodeRefSpan sp)
exportItemEntries modules prefix decls imports (XTypeSome name members sp) =
  Vuna.Compiler.Base.Common.bind
    (exportTypeAll modules prefix decls imports name (nodeRefSpan sp))
    (\es => OkC (filterExportMembers members es))
exportItemEntries modules prefix decls imports (XBare name sp) =
  exportBare modules prefix decls imports name (nodeRefSpan sp)

-- | 命名空间路径条目：public 是路径文本（完整模块名或 alias），target 是目标模块。
namespaceEntry : String -> String -> ExportEntry
namespaceEntry path target =
  ExportEntry { kind = "module", public = path, target = target, parent = "" }

filterExportMembers : List String -> List ExportEntry -> List ExportEntry
filterExportMembers members [] = []
filterExportMembers members (e :: rest) =
  if e.kind == "ctor" && not (memName e.public members) then
    filterExportMembers members rest
  else
    (::) e (filterExportMembers members rest)

dedupeExportEntries : List ExportEntry -> List ExportEntry
dedupeExportEntries entries = dedupeByFullKey entries (HashMap.fromList []) []

exportEntryKey : ExportEntry -> String
exportEntryKey e = "${e.kind}|${e.public}|${e.target}|${e.parent}"

dedupeByFullKey : List ExportEntry -> HashMap String Int -> List ExportEntry -> List ExportEntry
dedupeByFullKey [] seen acc = reverse acc
dedupeByFullKey (e :: rest) seen acc =
  let
    key = exportEntryKey e
  in case HashMap.lookup key seen of
    Just _ => dedupeByFullKey rest seen acc
    Nothing => dedupeByFullKey rest (HashMap.insert key 1 seen) (e :: acc)

explicitExports : List Module -> String -> List Decl -> List Import -> List ExportItem -> Check (List ExportEntry)
explicitExports modules prefix decls imports [] = OkC []
explicitExports modules prefix decls imports items =
  Vuna.Compiler.Base.Common.bind
    (exportItemsAll modules prefix decls imports items)
    (\es => OkC (dedupeExportEntries es))

-- 逐项解析条目。整表只做一次重复检查、最后只去重一次：不在每个导出项上重查剩余
-- 列表并把 append 结果整体去重（那是 O(k³)，k=400 时约 16s）。
exportItemsAll : List Module -> String -> List Decl -> List Import -> List ExportItem -> Check (List ExportEntry)
exportItemsAll modules prefix decls imports [] = OkC []
exportItemsAll modules prefix decls imports (item :: rest) =
  Vuna.Compiler.Base.Common.bind
    (exportItemEntries modules prefix decls imports item)
    (\es => Vuna.Compiler.Base.Common.bind (exportItemsAll modules prefix decls imports rest) (\tail => OkC (append es tail)))

validateModuleHeader : String -> Maybe ModDecl -> Check (List a)
validateModuleHeader label Nothing = OkC []
validateModuleHeader label (Just (ModDecl declared hasList items _ _ _ sp)) =
  if declared == label then
    OkC []
  else
    rnAt1 (nodeRefSpan sp) (ModuleNameMismatch declared) declared

opaqueNamesOf : String -> List OpacitySpec -> List String
opaqueNamesOf prefix [] = []
opaqueNamesOf prefix (o :: rest) =
  case o.opacityKind of
    OpacityOpaque => (::) (mangle prefix (opacitySpecName o)) (opaqueNamesOf prefix rest)
    OpacityTransparent => opaqueNamesOf prefix rest
    OpacityAbstract => (::) (":" ++ mangle prefix (opacitySpecName o)) (opaqueNamesOf prefix rest)

export abstractOpaquePrefix : String
abstractOpaquePrefix = ":"

export opaqueBaseName : String -> String
opaqueBaseName name =
  if startsWith abstractOpaquePrefix name then
    strSubstring
      (strLength abstractOpaquePrefix)
      (strLength name - strLength abstractOpaquePrefix)
      name
  else
    name

export isAbstractOpaqueName : String -> Bool
isAbstractOpaqueName name = startsWith abstractOpaquePrefix name

computeExports : List Module -> String -> Maybe ModDecl -> List Import -> List Decl -> List ExportSpec -> List ExportItem -> Check (List ExportEntry)
computeExports modules prefix hdr imports decls extraExports extraReexports =
  let
    newItems = append (map exportSpecToItem extraExports) extraReexports
    explicit = explicitExports modules prefix decls imports newItems
  in if notEmpty newItems then
    case hdr of
      Just (ModDecl _ hasList _ _ _ _ sp) => if hasList then rnAt1 (nodeRefSpan sp) (DuplicateExport "module header") "module header" else explicit
      Nothing => explicit
  else
    case hdr of
      Just (ModDecl _ hasList items _ _ _ spHdr) => if hasList then explicitExports modules prefix decls imports items else OkC []
      Nothing => OkC []

notEmpty : List a -> Bool
notEmpty [] = False
notEmpty (_ :: _) = True

exportSpecToItem : ExportSpec -> ExportItem
exportSpecToItem (ESValue name sp) = XBare name (detachedNodeRef sp)
exportSpecToItem (ESType name EMNone sp) = XBare name (detachedNodeRef sp)
exportSpecToItem (ESType name EMAll sp) = XTypeAll name (detachedNodeRef sp)
exportSpecToItem (ESType name (EMOnly members) sp) = XTypeSome name members (detachedNodeRef sp)

showCycle : String -> List String -> String
showCycle name stack = joinArrows (reverse (name :: stack))

-- 自动注入的 Prelude：从导入方所在包可见的依赖包取。
-- 显式 import Prelude 时不再重复注入；Prelude 自身不注入（避免环）；当前包自己
-- 的 Prelude 不算候选（`implicitPreludeDeps` 按包名过滤）。
-- ad-hoc（importerPkg==""）同样是包上下文（base-only）：自动注入 base 的 Prelude；
-- 没有 base 依赖的包没有候选，于是不注入。
export implicitPrelude : Member nFs FsOp r => List Root -> String -> String -> List Import -> Eff r (Check (List Import))
implicitPrelude roots importerPkg currentName imports =
  if currentName == "Prelude" then
    pure (OkC [])
  else if memName "Prelude" (importModuleNames imports) then
    pure (OkC [])
  else
    implicitPreludeFrom roots importerPkg

implicitPreludeFrom : Member nFs FsOp r => List Root -> String -> Eff r (Check (List Import))
implicitPreludeFrom roots importerPkg =
  do
    collected <- collectModuleFiles roots "Prelude" importerPkg [] []
    let
      allowed = firstOf collected
    in pure (implicitPreludeDeps importerPkg (filter (\c => rootName (secondOf c) /= importerPkg) allowed))

implicitPreludeDeps : String -> List (String, Root) -> Check (List Import)
implicitPreludeDeps importerPkg [] = OkC []
implicitPreludeDeps importerPkg ([_]) = OkC [Import "Prelude" False Nothing noNodeRef]
implicitPreludeDeps importerPkg deps =
  onErrDiag
    (withAbsent NsPackageGraph)
    (rnNoLoc1 (AmbiguousPrelude (joinArrows (map (\c => rootName (secondOf c)) deps))) (joinArrows (map (\c => rootName (secondOf c)) deps)))

-- 导入点位置：隐式 Prelude 的合成 Import 没有真实 span（file = ""），此时不给位置。
-- 载入完成后跑一次层约束检查（`[layers]`）；未声明层的项目是零开销的空检查。
withLayerCheck : List Root -> Project -> Check Project
withLayerCheck roots project =
  Vuna.Compiler.Base.Common.bind (checkProjectLayers roots project) (\_ => OkC project)

withImportSpan : Import -> Diagnostic -> Diagnostic
withImportSpan imp e =
  if spanFile (importSpan imp) == "" then e else withFallbackSpan (importSpan imp) e

loadAll : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Int -> List Root -> String -> List Module -> List String -> List Import -> Eff r (Check (List Module))
loadAll fuel roots importerPkg modules stack imports =
  if fuel <= 0 then
    pure (icFuel "loader")
  else
    case imports of
      [] => pure (OkC modules)
      imp :: rest =>
        do
          modulesR <- loadModule (fuel - 1) roots importerPkg modules stack imp
          case modulesR of
            ErrC e => pure (ErrC e)
            OkC modules2 => loadAll (fuel - 1) roots importerPkg modules2 stack rest

pathPrefixOf : Member nFs FsOp r => List Root -> String -> List String -> Int -> Eff r (Maybe (String, Int))
pathPrefixOf roots importerPkg segs n =
  if n < 1 then
    pure Nothing
  else
    do
      collected <- collectModuleFiles roots (joinDots (nsTakeLocal n segs)) importerPkg [] []
      if notEmpty (firstOf collected) then pure (Just (joinDots (nsTakeLocal n segs), n)) else pathPrefixOf roots importerPkg segs (n - 1)

nsTakeLocal : Int -> List String -> List String
nsTakeLocal n [] = []
nsTakeLocal n (x :: rest) = if n <= 0 then [] else (::) x (nsTakeLocal (n - 1) rest)

nsDropLocal : Int -> List String -> List String
nsDropLocal n [] = []
nsDropLocal n (x :: rest) = if n <= 0 then (::) x rest else nsDropLocal (n - 1) rest

loadModule : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Int -> List Root -> String -> List Module -> List String -> Import -> Eff r (Check (List Module))
loadModule fuel roots importerPkg modules stack imp =
  let
    name = importName imp
  in if fuel <= 0 then
    pure (icFuel "loader")
  else
    case findModule modules name of
      Just m => if moduleVisibleTo roots importerPkg m then pure (OkC modules) else pure (onErrDiag (withImportSpan imp) (ldErr2 (ModuleNotExported name (modulePackageOf m)) name (modulePackageOf m)))
      Nothing =>
        if memName name stack then
          pure (onErrDiag (withImportSpan imp) (ldErr1 (ImportCycle (showCycle name stack)) (showCycle name stack)))
        else if validModuleName name then
          do
            foundR <- findModuleFile roots name importerPkg (importSpan imp)
            case foundR of
              ErrC e =>
                case imp.importAlias of
                  Nothing => pure (ErrC e)
                  Just alias =>
                    do
                      prefixR <- pathPrefixOf roots importerPkg (splitOnDot name) (List.length (splitOnDot name) - 1)
                      case prefixR of
                        Nothing => pure (ErrC e)
                        Just (prefix, n) =>
                          do
                            modsR <- loadModule (fuel - 1) roots importerPkg modules stack (Import prefix False Nothing (detachedNodeRef (importSpan imp)))
                            case modsR of
                              ErrC e2 => pure (ErrC e2)
                              OkC modules1 =>
                                case findModule modules1 prefix of
                                  Nothing => pure (ErrC e)
                                  Just provider =>
                                    case walkNamespaceIndex modules1 prefix (nsDropLocal n (splitOnDot name)) of
                                      Nothing => pure (ErrC e)
                                      Just target => loadModule (fuel - 1) roots importerPkg modules1 stack (Import target True Nothing (detachedNodeRef (importSpan imp)))
              OkC found =>
                let
                  path = firstOf found
                  root = secondOf found
                  -- `compiler/steps_native/44f_incremental` 用这行断言「只 parse 脏模块」。
                  _ = dbg! "parse-module=${name}"
                in do
                  text <- fsReadFile path
                  parsed <- parseFileWithPath path text
                  case parsed of
                    ErrC e => pure (ErrC e)
                    OkC (SourceFile hdr imports0 fixities decls exports reexports opacity) =>
                      let
                        imports1 = imports0
                        providers = []
                        modules1 = modules
                        imports = namespaceImportsOf imports1 reexports
                      in case validateModuleHeader name hdr of
                        ErrC e => pure (ErrC e)
                        OkC _ =>
                          case validateImports name imports of
                            ErrC e => pure (ErrC e)
                            OkC _ =>
                              do
                                implicitR <- implicitPrelude roots (rootName root) name imports
                                case implicitR of
                                  ErrC e => pure (ErrC e)
                                  OkC implicit =>
                                    do
                                      modulesR <- loadAll (fuel - 1) roots (rootName root) modules1 (name :: stack) (append imports implicit)
                                      case modulesR of
                                        ErrC e => pure (ErrC e)
                                        OkC modules2 =>
                                          let
                                            imports2 = normalizeImports modules2 imports
                                          in case computeExports modules2 name hdr imports2 decls exports reexports of
                                            ErrC e => pure (ErrC e)
                                            OkC exports =>
                                              let
                                                visible = fixities
                                              in pure (OkC ((::) (Module name (rootName root) imports2 implicit decls exports visible (append providers (append (reexportedImportNamesOfHeader imports2 hdr) (reexportedImportNames imports2 reexports))) (opaqueNamesOf name opacity) (exportIndexOf exports)) modules2))
        else
          pure (onErrDiag (withImportSpan imp) (ldErr1 (InvalidModuleName name) name))

-- 包上下文入口：ctx 给出模块根（自己 lib 在最前 + 依赖闭包）与导入方包名
-- （决定同包/跨包导出可见性与 manifest 能力声明）。
-- loadProject 返回 flatten 前的形态（入口声明 + 依赖模块列表），供分离编译使用。
export loadProject : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Check Project)
loadProject ctx entry = loadProjectWithPreloaded ctx entry []

-- 接口模式加载。`preloaded` 是依赖包里**已解析**的模块（来自模块接口），
-- 加载器把它们当「已加载模块」直接命中：不读源码、不 parse、不算导出表。本包模块与入口
-- 仍按源码加载；模块表的顺序约定与 `loadAll` 一致（新加载模块前插，dependents-first），
-- 所以调用方应把 `preloaded` 按 reverse(topo) 传入。
export loadProjectWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> List Module -> Eff r (Check Project)
loadProjectWithPreloaded ctx entry preloaded =
  do
    exists <- fsFileExists entry
    if exists then
      do
        text <- fsReadFile entry
        parsed <- parseFileWithPath entry text
        case parsed of
          ErrC e => pure (ErrC e)
          OkC (SourceFile hdr imports fixities decls exports reexports opacity) =>
            case hdr of
              Just (ModDecl dname hasList items _ _ _ sp) => pure (onErrDiag (withFallbackSpan (nodeRefSpan sp)) (ldErr1 (ModuleHeaderInEntryFile entry) entry))
              Nothing =>
                let
                  imports1 = imports
                  preloaded1 = preloaded
                in case validateImports "<entry>" imports1 of
                  ErrC e => pure (ErrC e)
                  OkC _ =>
                    do
                      implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports1
                      case implicitR of
                        ErrC e => pure (ErrC e)
                        OkC implicit =>
                          do
                            modulesR <- loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded1 [] (append imports1 implicit)
                            pure (
                                case modulesR of
                                  ErrC e => ErrC e
                                  OkC modules =>
                                    let
                                      imports2 = normalizeImports modules imports1
                                    in withLayerCheck (contextRoots ctx) (Project decls imports2 implicit modules (contextPackageName ctx) fixities)
                              )
    else
      pure (ldErr1 (EntryFileNotFound entry) entry)

-- 库包入口：不带 app/Main.vuna 的包，以 [export].modules 作为根模块集合。
export loadProjectModules : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> Eff r (Check Project)
loadProjectModules ctx names = loadProjectModulesWithPreloaded ctx names []

export loadProjectModulesWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> List Module -> Eff r (Check Project)
loadProjectModulesWithPreloaded ctx names preloaded =
  let
    entryImports = map (\n => Import n False Nothing noNodeRef) names
  in do
    modulesR <-
      loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded [] entryImports
    pure (
        case modulesR of
          ErrC e => ErrC e
          OkC modules => withLayerCheck (contextRoots ctx) (Project [] [] [] modules (contextPackageName ctx) [])
      )

-- 入口以**源码字符串**给出（REPL 的表达式求值）：入口不落盘（import 仍按上下文的
-- roots 从磁盘解析）；隐式 Prelude 与文件入口同规则（ad-hoc 单文件也自动注入）。
export loadProjectSource : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Check Project)
loadProjectSource ctx label source = loadProjectSourceWithPreloaded ctx label source []

-- | 入口以源码字符串给出，依赖包模块可预置（零 parse）。
export loadProjectSourceWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> List Module -> Eff r (Check Project)
loadProjectSourceWithPreloaded ctx label source preloaded =
  do
    parsed <- parseFileWithPathMode PmTool label source
    case parsed of
      ErrC e => pure (ErrC e)
      OkC (SourceFile hdr imports fixities decls exports reexports opacity) =>
        case hdr of
          Just (ModDecl dname hasList items _ _ _ sp) => pure (ldErr1 (ModuleHeaderInEntrySource label) label)
          Nothing =>
            let
              imports1 = imports
              preloaded1 = preloaded
            in case validateImports "<entry>" imports1 of
              ErrC e => pure (ErrC e)
              OkC _ =>
                do
                  implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports1
                  case implicitR of
                    ErrC e => pure (ErrC e)
                    OkC implicit =>
                      do
                        modulesR <- loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded1 [] (append imports1 implicit)
                        pure (
                            case modulesR of
                              ErrC e => ErrC e
                              OkC modules =>
                                let
                                  imports2 = normalizeImports modules imports1
                                in withLayerCheck (contextRoots ctx) (Project decls imports2 implicit modules (contextPackageName ctx) fixities)
                          )

-- 以**源码字符串**给出一个**库模块**：源码允许带 `module ... where`
-- 头（LSP 打开 lib/ 下的文件时就是这种形态）。模块头存在时，按 import 闭包加载后
-- 把该模块本身作为合成的 `Module` 放进 Project，再交给 `resolveProject` 做名字解析；
-- 无模块头时退化为入口语义（与 `loadProjectSource` 相同）。
-- 入口声明保持为空：调用方只需要逐模块已解析的声明。
export loadModuleSource : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Check Project)
loadModuleSource ctx label source = loadModuleSourceWithPreloaded ctx label source []

-- 依赖包模块可预置（来自接口的 `Module`），只 parse 当前文件与同包源码。
export loadModuleSourceWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> List Module -> Eff r (Check Project)
loadModuleSourceWithPreloaded ctx label source preloaded =
  do
    parsed <- parseFileWithPathMode PmTool label source
    case parsed of
      ErrC e => pure (ErrC e)
      OkC (SourceFile hdr imports0 fixities decls exports reexports opacity) =>
        case hdr of
          Nothing => loadProjectSourceWithPreloaded ctx label source preloaded
          Just (ModDecl name hasList items _ _ _ sp) =>
            let
              imports1 = imports0
              providers = []
              preloaded1 = preloaded
              imports = namespaceImportsOf imports1 reexports
            in case validateImports name imports of
              ErrC e => pure (ErrC e)
              OkC _ =>
                do
                  implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) name imports
                  case implicitR of
                    ErrC e => pure (ErrC e)
                    OkC implicit =>
                      do
                        modulesR <- loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded1 [] (append imports implicit)
                        case modulesR of
                          ErrC e => pure (ErrC e)
                          OkC modules =>
                            let
                              imports2 = normalizeImports modules imports
                            in case computeExports modules name hdr imports2 decls exports reexports of
                              ErrC e => pure (ErrC e)
                              OkC exports =>
                                let
                                  visible = fixities
                                in pure (withLayerCheck (contextRoots ctx) (Project [] imports2 implicit (Module name (contextPackageName ctx) imports2 implicit decls exports visible (append providers (reexportedImportNames imports2 (append items reexports))) (opaqueNamesOf name opacity) (exportIndexOf exports) :: modules) (contextPackageName ctx) []))

-- fmt 用的「程序级 fixity」——本文件的 `infix*` 声明（在前，本地优先）
-- ++ import 闭包可见的声明（Module 里已含各自的 import 闭包）。只 parse + 加载模块图，
-- **不做精化/名字解析**，因此很便宜；有/无模块头都支持。
--
-- `modules` 是调用方可复用的已加载模块表（按包上下文缓存）：同包多文件只加载一次模块图。
-- 但 fixity **声明表必须按文件重算**（local + 该文件自己的 import 闭包）——不同文件的
-- imports 不同，跨文件复用声明表会让 fmt 给 `::`/`+` 等打出错误的括号。
-- 返回值同时带回更新后的模块表，供调用方继续复用。
-- parse 读 lex 缓存 / 探测模块文件是宿主动作，外壳显式 `Eff r`；声明表计算保持纯。
export fixitiesForSourceIn : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List Module -> String -> String -> Eff r (Check (List Module, List FixityDecl))
fixitiesForSourceIn ctx modules0 label source =
  do
    parsed <- parseFileWithPathMode PmTool label source
    case parsed of
      ErrC e => pure (ErrC e)
      OkC sf => fixitiesFromParsed ctx modules0 label sf

-- | 同 `fixitiesForSourceIn`，但源码**已经**解析过（工具路径一次词法的产物）。
--
-- 工具（lint / index / doc）本来就要为规则或 docstring 解析一遍；再为 fixity 解析一遍是
-- 同一份源码的第二次完整语法分析。这里只做「加载 import 闭包的模块图 + 拼接声明表」。
export fixitiesFromParsed : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List Module -> String -> SourceFile -> Eff r (Check (List Module, List FixityDecl))
fixitiesFromParsed ctx modules0 label (SourceFile hdr imports0 fixities decls exports reexports opacity) =
  let
    imports1 = imports0
    modules1 = modules0
    imports = namespaceImportsOf imports1 reexports
  in case hdr of
    Nothing =>
      case validateImports label imports of
        ErrC e => pure (ErrC e)
        OkC _ =>
          do
            implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports
            case implicitR of
              ErrC e => pure (ErrC e)
              OkC implicit =>
                do
                  modulesR <- loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) modules1 [] (append imports implicit)
                  pure (
                      case modulesR of
                        ErrC e => ErrC e
                        OkC modules => OkC (modules, dedupeFixitiesOf modules fixities)
                    )
    Just (ModDecl name hasList items _ _ _ sp) =>
      case validateImports name imports of
        ErrC e => pure (ErrC e)
        OkC _ =>
          do
            implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) name imports
            case implicitR of
              ErrC e => pure (ErrC e)
              OkC implicit =>
                do
                  modulesR <- loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) modules1 [] (append imports implicit)
                  pure (
                      case modulesR of
                        ErrC e => ErrC e
                        OkC modules => OkC (modules, dedupeFixitiesOf modules fixities)
                    )

-- 单文件便捷入口（LSP formatting / fmt 探针）：不跨调用复用模块表。
export fixitiesForSource : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Check (List FixityDecl))
fixitiesForSource ctx label source =
  do
    pairR <- fixitiesForSourceIn ctx [] label source
    pure (
        case pairR of
          ErrC e => ErrC e
          OkC p => OkC (secondOf p)
      )

-- 返回逐模块已解析（未 flatten）的声明 + 本次解析产生的 warning（unused import）。
-- warning 是显式返回值：名字解析期不维护 used-set，解析完成后按「实际引用的目标」判定。
export resolveProject : Project -> Check (List Diagnostic, List Decl, List Module)
resolveProject project = resolveProjectKeeping False [] project

-- | 带 release 模式的解析入口（CLI 路径显式传入 `--release` / `VUNA_RELEASE=1`）。
export resolveProjectWith : Bool -> Project -> Check (List Diagnostic, List Decl, List Module)
resolveProjectWith release project = resolveProjectKeeping release [] project

-- `keep` 里的模块已经解析过（来自接口文件），原样保留、不重解析。
--
-- 阶段跨度：`vuna.resolve.reorder` / `.expand` / `.entry` / `.warn` 是入口声明的四段；
-- 逐模块的四段在 `resolveModulesKeep`（同名跨度，按次聚合）。名字解析本身没有内部的
-- 结构化子阶段，`vuna.resolve` 标记到这组跨度之间只剩 `checkUniqueFixities` 与函数分派。
export resolveProjectKeeping : Bool -> List String -> Project -> Check (List Diagnostic, List Decl, List Module)
resolveProjectKeeping release keep (Project decls imports implicit modules entryPkg entryFixes) =
  let
    projectFixities = dedupeFixitiesOf modules entryFixes
  in Vuna.Compiler.Base.Common.bind
    (checkUniqueFixities projectFixities)
    (\fixes => Vuna.Compiler.Base.Common.bind (obsCheck "vuna.resolve.reorder" (\_ => reorderProgram (tableOf fixes) decls)) (\decls2 => Vuna.Compiler.Base.Common.bind (obsCheck "vuna.resolve.expand" (\_ => expandDecls decls2)) (\decls3 => Vuna.Compiler.Base.Common.bind (obsCheck "vuna.resolve.entry" (\_ => resolveEntry release modules entryPkg (append imports implicit) decls3)) (\entryDecls => Vuna.Compiler.Base.Common.bind (obsCheck "vuna.resolve.warn" (\_ => unusedImportWarnings modules imports entryDecls decls3 [])) (\entryWarns => Vuna.Compiler.Base.Common.bind (resolveModulesKeep release keep fixes modules) (\p2 => OkC (append entryWarns (secondOf p2), entryDecls, firstOf p2)))))))

resolveModulesKeep : Bool -> List String -> List FixityDecl -> List Module -> Check (List Module, List Diagnostic)
resolveModulesKeep release keep fixes [] = OkC ([], [])
resolveModulesKeep release keep fixes (m :: rest) =
  if memName (moduleNameOf m) keep then
    Vuna.Compiler.Base.Common.bind
      (resolveModulesKeep release keep fixes rest)
      (\p2 => OkC ((::) m (firstOf p2), secondOf p2))
  else
    Vuna.Compiler.Base.Common.bind
      (obsCheck "vuna.resolve.reorder" (\_ => reorderProgram (tableOf fixes) (moduleDeclsOf m)))
      (\decls2 => Vuna.Compiler.Base.Common.bind (resolveModuleGo release m rest (obsCheck "vuna.resolve.expand" (\_ => expandDecls decls2))) (\p => Vuna.Compiler.Base.Common.bind (resolveModulesKeep release keep fixes rest) (\p2 => OkC ((::) (firstOf p) (firstOf p2), append (secondOf p) (secondOf p2)))))

-- | 单个模块 expand 之后的三段：命名空间建表 → 名字解析 → 未用 import 判定。
-- `rest` 参与模块表：解析期要看到后续模块的导出面。
resolveModuleGo : Bool -> Module -> List Module -> Check (List Decl) -> Check (Module, List Diagnostic)
resolveModuleGo release m rest declsR =
  Vuna.Compiler.Base.Common.bind declsR (
      \decls3 =>
        let
          modules2 = Module (moduleNameOf m) (modulePackageOf m) m.moduleImportsOf m.moduleImplicitImportsOf decls3 m.moduleExportsOf (moduleFixitiesOf m) (moduleReexportsOf m) (moduleOpaqueOf m) m.moduleExportIndexOf :: rest
          ns = obsPure "vuna.resolve.ns" (\_ => namespacesOfWith release modules2 decls3)
        in Vuna.Compiler.Base.Common.bind (obsCheck "vuna.resolve.module" (\_ => resolveProgram modules2 (moduleNameOf m) (moduleNameOf m) ns (moduleAllImportsOf m) decls3)) (\d1 => Vuna.Compiler.Base.Common.bind (obsCheck "vuna.resolve.warn" (\_ => unusedImportWarnings modules2 m.moduleImportsOf d1 decls3 (moduleReexportsOf m))) (\warns => OkC (Module (moduleNameOf m) (modulePackageOf m) m.moduleImportsOf m.moduleImplicitImportsOf d1 m.moduleExportsOf (moduleFixitiesOf m) (moduleReexportsOf m) (moduleOpaqueOf m) m.moduleExportIndexOf, warns)))
    )

-- ---------------------------------------------------------------
-- unused import warning：显式 import 未在所属检查单元里被引用。
-- （隐式 Prelude 不参与；判定见 `unusedImportWarnings`。）
-- ---------------------------------------------------------------
unusedImportWarnings : List Module -> List Import -> List Decl -> List Decl -> List String -> Check (List Diagnostic)
unusedImportWarnings modules imports decls sourceDecls reexports =
  obsCheck "vuna.resolve.warn.names" (
      \_ =>
        let
          -- 源码名只走一遍：`interp` 判定与「源码里出现过哪些运算符」共用同一份引用名。
          sourceRefs = concatMap declRefNames sourceDecls
          -- 模板字符串降级会合成 `Base.Trait.Interp.interp`（Resolve.lowerTemplate）：它是解析**之后**
          -- 注入的 canonical 名，不算作 import 使用。源码没有显式引用 interp 时剔除合成名，
          -- 只被模板串引用的 import 仍报 unused。
          interpRef = memName "interp" sourceRefs || memName interpMethodName sourceRefs
          names0 = concatMap declGlobalNames decls
          names = if interpRef then names0 else filter (\n => n /= interpMethodName) names0
          nameSet = HashMap.ofNames names
          -- fixity 判定只需要「源码里出现过的、某个 import 能提供的运算符」：
          -- 全量引用名集合在整包上是 10^5 量级，过滤后通常只有个位数。
          fixitySet = HashMap.ofNames (visibleFixityOps modules imports)
        in obsCheck "vuna.resolve.warn.sources" (
            \_ =>
              obsCheck "vuna.resolve.warn.imports" (
                  \_ =>
                    let
                      sourceNames = HashMap.ofNames (filter (\n => HashMap.member n fixitySet) sourceRefs)
                    in unusedImportWarningsGo modules nameSet sourceNames imports decls reexports imports
                )
          )
    )

-- | 当前检查单元里所有 import 的模块声明可见的 fixity 运算符（去重前的集合源）。
visibleFixityOps : List Module -> List Import -> List String
visibleFixityOps modules imports =
  concatMap (
      \imp =>
        case findModule modules (importName imp) of
          Just m => fixityOpsOf (moduleFixitiesOf m)
          Nothing => []
    ) imports

unusedImportWarningsGo : List Module -> HashMap String Bool -> HashMap String Bool -> List Import -> List Decl -> List String -> List Import -> Check (List Diagnostic)
unusedImportWarningsGo modules nameSet sourceNames imports decls reexports [] = OkC []
unusedImportWarningsGo modules nameSet sourceNames imports decls reexports (imp :: rest) =
  Vuna.Compiler.Base.Common.bind (exportsOf modules (importName imp)) (
      \es =>
        let
          used = memName (importName imp) reexports || anyTargetIn nameSet (map exportTargetOf es) || importProvidesUsedFixity sourceNames modules imp || importProvidesDeclaredFixity decls modules imp || moduleDeclaresInstance modules imp
        in Vuna.Compiler.Base.Common.bind (unusedImportWarningsGo modules nameSet sourceNames imports decls reexports rest) (\more => OkC (if used then more else (::) (unusedImportDiag imports decls imp) more))
    )

-- unused import 诊断：能安全整行删除时才附 machine-applicable 编辑（空编辑列表的
-- suggestion 会被下游误当成「已可应用」）。
unusedImportDiag : List Import -> List Decl -> Import -> Diagnostic
unusedImportDiag imports decls imp =
  let
    d = warnDiagAt (importSpan imp) (UnusedImport imp.importName) [imp.importName]
  in case importRemovalEdits imports decls imp of
    [] => d
    edits =>
      withSuggestion (Suggestion "remove unused import ${imp.importName}" MachineApplicable edits) d

-- | 该 import 的模块声明的 fixity 里，是否有运算符真的写进了源码。
--
-- fixity 表是全程序的（`Module` 只存本模块声明），`import` 是让声明生效的唯一手段；
-- 而 fixity 声明不进 `Decl`，rename 结果里看不到引用，只能拿源码名比对。
importProvidesUsedFixity : HashMap String Bool -> List Module -> Import -> Bool
importProvidesUsedFixity sourceNames modules imp =
  case findModule modules (importName imp) of
    Nothing => False
    Just m => anyNameIn sourceNames (fixityOpsOf (moduleFixitiesOf m))

fixityOpsOf : List FixityDecl -> List String
fixityOpsOf [] = []
fixityOpsOf (d :: rest) = d.fixityOp :: fixityOpsOf rest

-- | 本模块自己声明了运算符（trait 方法 / 顶层定义），而它的 fixity 由该 import 提供：
-- 这个 import 是给**下游**用的（fixity 表随 import 闭包传播），不能算 unused。
importProvidesDeclaredFixity : List Decl -> List Module -> Import -> Bool
importProvidesDeclaredFixity decls modules imp =
  case findModule modules (importName imp) of
    Nothing => False
    Just m => anyOpDeclared (fixityOpsOf (moduleFixitiesOf m)) (definedNamesOf decls)

anyOpDeclared : List String -> List String -> Bool
anyOpDeclared [] _ = False
anyOpDeclared (op :: rest) names =
  if anyNameSuffixIn op names then True else anyOpDeclared rest names

anyNameSuffixIn : String -> List String -> Bool
anyNameSuffixIn _ [] = False
anyNameSuffixIn suffix (n :: rest) =
  if n == suffix || endsWith ("." ++ suffix) n then True else anyNameSuffixIn suffix rest

-- | 声明引入的名字（定义 / 签名 / axiom / extern / data / record / trait 方法）。
definedNamesOf : List Decl -> List String
definedNamesOf [] = []
definedNamesOf (d :: rest) = append (definedNamesOfDecl d) (definedNamesOf rest)

definedNamesOfDecl : Decl -> List String
definedNamesOfDecl (DData dname params kind ctors derivings viaField repr lin sp) = (::) dname []
definedNamesOfDecl (DRecord dname params fields derivings viaField repr lin sp) = (::) dname []
definedNamesOfDecl (DTrait tname params supers methods sp) = tname :: traitMethodNames methods
definedNamesOfDecl (DInstance ctxE head methods sp) = []
definedNamesOfDecl (DSig name ctx ty sp) = (::) name []
definedNamesOfDecl (DAxiom name ty sp) = (::) name []
definedNamesOfDecl (DExtern name cName ty sp) = (::) name []
definedNamesOfDecl (DFun name pats body sp) = (::) name []

traitMethodNames : List TraitMethod -> List String
traitMethodNames [] = []
traitMethodNames (m :: rest) = m.traitMethodName :: traitMethodNames rest

anyNameIn : HashMap String Bool -> List String -> Bool
anyNameIn _ [] = False
anyNameIn s (n :: rest) = if HashMap.member n s then True else anyNameIn s rest

-- | 模块是否声明了实例。实例搜索与字典选择发生在 Elab（loader 之后），名字扫描看不到
-- 「加载这些实例」这件事；声明了实例的模块被 import 就是可见副作用，不算 unused。
moduleDeclaresInstance : List Module -> Import -> Bool
moduleDeclaresInstance modules imp =
  case findModule modules (importName imp) of
    Nothing => False
    Just m => anyInstanceDecl (moduleDeclsOf m)

anyInstanceDecl : List Decl -> Bool
anyInstanceDecl [] = False
anyInstanceDecl ((DInstance _ _ _ _) :: _) = True
anyInstanceDecl (_ :: rest) = anyInstanceDecl rest

-- | unused import 的 machine-applicable 编辑：整行删除只在 import **独占该行**时成立。
-- 同行的另一条 import、同行起头的声明都会被一起删掉，此时不给编辑（诊断照报）。
importRemovalEdits : List Import -> List Decl -> Import -> List DiagEdit
importRemovalEdits imports decls imp =
  if importOwnsLine imports decls imp then
    [DiagEdit (importRemovalSpan (importSpan imp)) ""]
  else
    []

-- | `import` 关键字在行首（span 起点列 = 1），且该行没有其它 import / 声明。
importOwnsLine : List Import -> List Decl -> Import -> Bool
importOwnsLine imports decls imp =
  importStartsLine imp
    && not (anyImportOnLine imports imp)
    && not (anyDeclOnLine decls (spanStartLine (importSpan imp)))

importStartsLine : Import -> Bool
importStartsLine imp = spanStartCol (importSpan imp) == 1

anyImportOnLine : List Import -> Import -> Bool
anyImportOnLine [] imp = False
anyImportOnLine (other :: rest) imp =
  if spanStartOffset (importSpan other) == spanStartOffset (importSpan imp) then
    anyImportOnLine rest imp
  else if spanStartLine (importSpan other) == spanStartLine (importSpan imp) then
    True
  else
    anyImportOnLine rest imp

anyDeclOnLine : List Decl -> Int -> Bool
anyDeclOnLine [] line = False
anyDeclOnLine (d :: rest) line =
  if spanStartLine (declSpan d) == line then True else anyDeclOnLine rest line

-- 整行删除 import 的编辑 span：从行首到下一行行首（含换行）。
importRemovalSpan : Span -> Span
importRemovalSpan sp =
  Span
    (spanFile sp)
    (spanStartLine sp)
    1
    (spanStartLine sp + 1)
    1
    (spanStartOffset sp - (spanStartCol sp - 1))
    (spanStartOffset sp - (spanStartCol sp - 1))

-- 已解析声明里出现的全部引用目标（值 / 类型 / 构造子位置）。解析期已把可解析的名字
-- 换成 canonical target；`@vuna@ctor@短名@t1@t2` 形态（重载构造子）展开成它的候选目标。
declGlobalNames : Decl -> List String
declGlobalNames d = concatMap expandGlobalName (declRefNames d)

-- | 把内部语法名展开成它携带的 canonical target；普通名字原样返回。
--   * `@vuna@ctor@短名@t1@t2`（重载构造子）→ 候选目标 t1/t2；
--   * `@vuna@do@bind@<canonical>` / `@vuna@do@ignore@<canonical>` → canonical bind 目标
--     （do 链在 rename 后仍引用 bind 的实现模块，import 是否使用要算上它）。
expandGlobalName : String -> List String
expandGlobalName n =
  if isOverCtorName n then
    overCtorTargets n
  else
    case doSyntaxCanonical n of
      Just canonical => (::) canonical []
      Nothing => (::) n []

-- | 导出条目的 canonical target。
exportTargetOf : ExportEntry -> String
exportTargetOf e = e.target

-- | import 导出表里是否有某个 target 出现在本次检查的已解析声明中。
anyTargetIn : HashMap String Bool -> List String -> Bool
anyTargetIn nameSet [] = False
anyTargetIn nameSet (t :: rest) =
  if HashMap.member t nameSet then True else anyTargetIn nameSet rest

-- | 声明里出现的引用名（不递归展开 over-ctor；构造子/类型/值位置都收集）。
declRefNames : Decl -> List String
declRefNames (DData dname params kind ctors derivings viaField repr lin sp) =
  append (exprRefNames kind) (append (concatMap ctorRefNames ctors) derivings)
declRefNames (DRecord dname params fields derivings viaField repr lin sp) =
  append (concatMap fieldRefNames fields) derivings
declRefNames (DTrait tname params supers methods sp) =
  append (concatMap exprRefNames supers) (concatMap traitMethodRefNames methods)
declRefNames (DInstance ctxE head methods sp) =
  append (concatMap exprRefNames ctxE) (append (exprRefNames head) (concatMap declRefNames methods))
declRefNames (DSig name ctx ty sp) = append (concatMap exprRefNames ctx) (exprRefNames ty)
declRefNames (DAxiom name ty sp) = exprRefNames ty
declRefNames (DExtern name cName ty sp) = exprRefNames ty
declRefNames (DFun name pats body sp) = append (concatMap patRefNames pats) (exprRefNames body)

-- | 构造子声明类型里的引用名。
ctorRefNames : Ctor -> List String
ctorRefNames c = exprRefNames c.ctorType

-- | record 字段类型里的引用名。
fieldRefNames : Field -> List String
fieldRefNames f = exprRefNames f.fieldType

-- | trait 方法类型里的引用名。
traitMethodRefNames : TraitMethod -> List String
traitMethodRefNames m = exprRefNames m.traitMethodType

-- | 模式里的引用名（构造子 / record 名；binder 名不是引用）。
patRefNames : Pat -> List String
patRefNames p = patRefNamesGo p []

patRefNamesGo : Pat -> List String -> List String
patRefNamesGo (PVar name _) acc = acc
patRefNamesGo (PAs name inner _) acc = patRefNamesGo inner acc
patRefNamesGo (PWild _) acc = acc
patRefNamesGo (PCon name pats _) acc = patRefNamesListGo pats ((::) name acc)
patRefNamesGo (PInt n _) acc = acc
patRefNamesGo (PStr s _) acc = acc
patRefNamesGo (PRecord name fields _) acc = fieldPatsGo fields ((::) name acc)

patRefNamesListGo : List Pat -> List String -> List String
patRefNamesListGo [] acc = acc
patRefNamesListGo (p :: rest) acc = patRefNamesListGo rest (patRefNamesGo p acc)

fieldPatsGo : List (String, Pat) -> List String -> List String
fieldPatsGo [] acc = acc
fieldPatsGo (f :: rest) acc = fieldPatsGo rest (patRefNamesGo (secondOf f) acc)

-- | 表达式里出现的引用名（`EVar` 已由解析期换成 canonical target）。
-- 用累加器而不是 `append` 拼接：重排后的左结合应用链是左嵌套（`((a+b)+c)+…`），
-- `append (子结果) …` 在每一层复制整段左子结果就是 O(n²)。累加器每个节点只 cons 一次；
-- **返回顺序未定义**（调用方都按集合消费：`HashMap.ofNames` / `memName`）。
exprRefNames : Expr -> List String
exprRefNames e = exprRefNamesGo e []

exprRefNamesGo : Expr -> List String -> List String
exprRefNamesGo (EVar n _) acc = (::) n acc
exprRefNamesGo (EInt n _) acc = acc
exprRefNamesGo (EStr s _) acc = acc
exprRefNamesGo (EFloat raw _) acc = acc
exprRefNamesGo (ELam ps body _) acc = exprRefNamesGo body acc
exprRefNamesGo (EApp fn args _) acc = exprRefNamesGo fn (exprRefNamesListGo args acc)
exprRefNamesGo (EPi name implicit qty dom cod _) acc = exprRefNamesGo dom (exprRefNamesGo cod acc)
exprRefNamesGo (ELet binds body rec_ _) acc = exprRefNamesGo body (bindRefNamesListGo binds acc)
exprRefNamesGo (ELocalFun clauses _) acc = clauseRefNamesListGo clauses acc
exprRefNamesGo (ECase scrut alts _) acc = exprRefNamesGo scrut (bindRefNamesListGo alts acc)
exprRefNamesGo (EIf c t el _) acc = exprRefNamesGo c (exprRefNamesGo t (exprRefNamesGo el acc))
exprRefNamesGo (EField base fname _) acc = exprRefNamesGo base acc
exprRefNamesGo (ERecord name fields _) acc = fieldExprsGo fields ((::) name acc)
exprRefNamesGo (ERecUpdate base fields _) acc = exprRefNamesGo base (fieldExprsGo fields acc)
exprRefNamesGo (EDo stmts _) acc = doStmtRefNamesListGo stmts acc
exprRefNamesGo (EInfix op lhs rhs _) acc = exprRefNamesGo lhs (exprRefNamesGo rhs ((::) op acc))
exprRefNamesGo (EParen inner _) acc = exprRefNamesGo inner acc
exprRefNamesGo (EBacktick op lhs rhs _) acc = exprRefNamesGo lhs (exprRefNamesGo rhs ((::) op acc))
exprRefNamesGo (ESectOp op _) acc = (::) op acc
exprRefNamesGo (ESectL op rhs _) acc = (::) op (exprRefNamesGo rhs acc)
exprRefNamesGo (ESectR lhs op _) acc = (::) op (exprRefNamesGo lhs acc)
exprRefNamesGo (EAnn value ty _) acc = exprRefNamesGo value (exprRefNamesGo ty acc)
exprRefNamesGo (EInterp multi parts _) acc = interpPartRefNamesListGo parts acc

exprRefNamesListGo : List Expr -> List String -> List String
exprRefNamesListGo [] acc = acc
exprRefNamesListGo (e :: rest) acc = exprRefNamesListGo rest (exprRefNamesGo e acc)

fieldExprsGo : List (String, Expr) -> List String -> List String
fieldExprsGo [] acc = acc
fieldExprsGo (f :: rest) acc = fieldExprsGo rest (exprRefNamesGo (secondOf f) acc)

-- | `pat = expr` 绑定里的引用名（模式 binder 不算引用）。
bindRefNamesGo : (Pat, Expr) -> List String -> List String
bindRefNamesGo p acc = patRefNamesGo (firstOf p) (exprRefNamesGo (secondOf p) acc)

bindRefNamesListGo : List (Pat, Expr) -> List String -> List String
bindRefNamesListGo [] acc = acc
bindRefNamesListGo (b :: rest) acc = bindRefNamesListGo rest (bindRefNamesGo b acc)

-- | 局部函数 clause（参数模式 + body）里的引用名。
clauseRefNamesGo : (List Pat, Expr) -> List String -> List String
clauseRefNamesGo p acc = patRefNamesListGo (firstOf p) (exprRefNamesGo (secondOf p) acc)

clauseRefNamesListGo : List (List Pat, Expr) -> List String -> List String
clauseRefNamesListGo [] acc = acc
clauseRefNamesListGo (c :: rest) acc = clauseRefNamesListGo rest (clauseRefNamesGo c acc)

-- | do 语句里的引用名。
doStmtRefNamesGo : DoStmt -> List String -> List String
doStmtRefNamesGo (DBind pat e sp) acc = patRefNamesGo pat (exprRefNamesGo e acc)
doStmtRefNamesGo (DExpr e sp) acc = exprRefNamesGo e acc
doStmtRefNamesGo (DLet binds sp) acc = bindRefNamesListGo binds acc

doStmtRefNamesListGo : List DoStmt -> List String -> List String
doStmtRefNamesListGo [] acc = acc
doStmtRefNamesListGo (s :: rest) acc = doStmtRefNamesListGo rest (doStmtRefNamesGo s acc)

-- | 模板片段里的引用名（洞内表达式）。
interpPartRefNamesGo : InterpPart -> List String -> List String
interpPartRefNamesGo (IPText s) acc = acc
interpPartRefNamesGo (IPHole e) acc = exprRefNamesGo e acc

interpPartRefNamesListGo : List InterpPart -> List String -> List String
interpPartRefNamesListGo [] acc = acc
interpPartRefNamesListGo (p :: rest) acc =
  interpPartRefNamesListGo rest (interpPartRefNamesGo p acc)
