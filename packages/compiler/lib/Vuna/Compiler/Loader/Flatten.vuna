module Vuna.Compiler.Loader.Flatten where

-- Vuna.Compiler.Loader.Flatten：模块导出表计算、加载流程与 flatten。
--
-- 依赖 `Loader.Modules`（模块/导出表）与 `Loader.Resolve`（名字解析）：先算每个模块的
-- 导出表，再按 import 图递归加载（含隐式 Prelude）。
-- 入口统一吃 `PackageContext`（最近 manifest 的包 + 依赖闭包 roots）；DT 精化由
-- `Driver.Dt` 按「依赖序列 + 入口声明」拼接。
import Base.List
import Vuna.Compiler.Loader.Addr
import Vuna.Compiler.Loader.Layers
import Vuna.Compiler.Base.Bytes
import Vuna.Compiler.Frontend.Canonical.Lex
import Vuna.Compiler.Loader.Fingerprint
import Vuna.Compiler.Base.Store
import Vuna.Compiler.Base.Diagnostics.Loader
import Vuna.Compiler.Loader.Expand
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Hash
import Vuna.Compiler.Base.Diagnostics.Warning
import Vuna.Compiler.Base.Diagnostics.Rn
import Base.HashMap
import Base.Obs.Span
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Frontend.Parser.Support
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Loader.Modules
import Vuna.Compiler.Loader.Resolve
import Vuna.Compiler.Base.Intrinsics
import Vuna.Compiler.Frontend.Packages.Pkg
import Base.EffFs
import Base.Eff.Types
import Base.EffEnv
import Base.EffProcess

-- imports 模块的**可见 fixity 表**（Module 里已含各自的 import 闭包）。
-- 本模块声明由调用方放在返回列表最前，查找时第一处匹配生效。
-- parse 错误带文件名（前端诊断无位置，加载器知道路径）。
--
-- **lex 缓存**。parse = lex + 语法分析，lexer 占大头（实测 40 KB 文件 lex 3.96 ms /
-- 全程 4.59 ms）；缓存 token 流后命中路径只跑语法分析。
--
-- 不做 AST 缓存：`Canonical.Ast` 的编码口径**故意丢 span**（它是 iface 哈希输入，
-- 移动代码不能改依赖方摘要），AST 缓存命中时进程里所有诊断位置会退化成 `:0:0`、
-- codegen 的 `dt_def_locs` 整表变成 `":0"`——缓存改变用户可见行为，不可接受。
-- token 流带位置，重放 parse 得到的 AST 与冷路径逐字节相同。
--
-- key = `contentAddress(schema + 编译器 tag + 路径 + 源文本)`（含编译器指纹，
-- AST/Token 布局不同的二进制各占一套 key 空间）；载荷 = `Canonical.Lex` 的显式编码 +
-- `Store` framing（magic/tag/codec/len/内容地址），坏字节在读侧变成 miss、不会进解码器。
lexCacheSchema : String
lexCacheSchema = "vuna-lex-cache 3"

-- | lex 载荷编码版本（`Store` 的 codec 段）。
lexCacheCodec : String
lexCacheCodec = "lex-tokens 3"

-- 缓存读写、模块文件探测与读盘都是宿主动作，显式在 `Eff r` 里；
-- 导出表计算、flatten 与 resolve 保持纯函数。
--
-- 寻址：`objects/lex/<输入摘要>`，输入摘要 = schema + codec + **源内容地址**。
-- 路径与编译器指纹都不进 key：同一份源在任何路径/任何二进制下都是同一份 token 流，
-- 跨项目、跨二进制自然复用。
lexAddrOf : String -> String
lexAddrOf src = addrOf ["lex", lexCacheSchema, lexCacheCodec, contentAddress src]

-- | 读 lex 缓存：`Store` framing 全量校验通过才解码；任何不符 ⇒ `Nothing`（重新 lex）。
readLexCache : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r (Maybe (List PTok))
readLexCache addr = do
  payload <- storeObjectReadEff "lex" lexCacheCodec addr
  pure (case payload of
    Nothing => Nothing
    Just bytes => decPTokListComplete bytes
  )

-- | 写 lex 缓存（目录由 `Store` 建；原子写由 `Store` 负责）。
storeLexCache : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> List PTok -> Eff r Int
storeLexCache addr toks = storeObjectWriteEff "lex" lexCacheCodec addr (encTop encPTokList toks)

-- | 解析一个源文件（带 lex 缓存）。所有加载路径都走这里。
-- 编译器路径用 `PmStrict`（语义级语法错误致命）；只需要 AST 的工具（fixity 解析）用
-- `parseFileWithPathMode PmTool`，别让「重复 binder」把整个文件挡在门外。
export parseFileWithPath : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> Eff r (Check SourceFile)
parseFileWithPath = parseFileWithPathMode PmStrict

export parseFileWithPathMode : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => ParseMode -> String -> String -> Eff r (Check SourceFile)
parseFileWithPathMode mode path src = do
  let
    addr = lexAddrOf src
  in do
    cached <- readLexCache addr
    case cached of
      Just toks => pure (parseWith mode path toks)
      Nothing => lexAndStore mode addr path src

-- | 缓存未命中：lex → 落盘 → 解析。落盘**无条件**（即使语法有错）：token 流只依赖源文本，
-- 与 parse 是否成功无关，错文件下次也能省掉 lex。
lexAndStore : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => ParseMode -> String -> String -> String -> Eff r (Check SourceFile)
lexAndStore mode addr path src = case obsSpan "vuna.parse.lex" "vuna.phase" (\_ => lexSource src) of
  ErrC e => pure (ErrC (withSpanFileIfEmpty path e))
  OkC toks => do
    _ <- storeLexCache addr toks
    pure (parseWith mode path toks)

-- | 由 token 流得到 parse 结果。Lexer/Parser 都已在产生点给出 span；这里只给词法诊断
-- 那个 file 为空的 span 注入真实路径（parser 的 span 从 PState 拿文件名）。
-- 恢复期收集到的多条诊断挂在首条错误上（批量错误通道），全部自带位置。
parseWith : ParseMode -> String -> List PTok -> Check SourceFile
parseWith mode path toks = case obsSpan "vuna.parse.syntax" "vuna.phase" (\_ => parseSourceRecoveringTokens path mode toks) of
  ErrC e => ErrC (withSpanFileIfEmpty path e)
  OkC p =>
    let
      parsed = firstOf p
      errs = secondOf p
    in case errs of
      [] => OkC parsed
      e :: rest => ErrC (withChildren rest e)

-- fixity 是**程序级**属性：加载闭包里所有模块的声明构成一张表（import 到就全局生效），
-- 不再按逐模块的可见闭包拼接。`Module` 里存的是该模块自己的声明。
visibleFixitiesOf : List Module -> List Import -> List FixityDecl
visibleFixitiesOf modules imports = concatMap moduleFixitiesOf modules

-- 按「声明身份」去重（文件 + 起始行列）：同一个模块的声明从不同 import 路径到达时
-- 只保留一份；不同模块对同一运算符的声明都保留，交给 `checkUniqueFixities` 报重复。
-- 去重后长度是 O(不同声明数)，闭包拼接保持线性（import 图有大量 diamond）。
dedupeFixities : List FixityDecl -> List FixityDecl
dedupeFixities ds = dedupeFixitiesGo ds (Base.HashMap.fromList []) []

dedupeFixitiesGo : List FixityDecl -> HashMap String Int -> List FixityDecl -> List FixityDecl
dedupeFixitiesGo [] seen acc = reverse acc
dedupeFixitiesGo (d :: rest) seen acc =
  let
    key = fixityDeclKey d
  in case Base.HashMap.lookup key seen of
    Just _ => dedupeFixitiesGo rest seen acc
    Nothing => dedupeFixitiesGo rest (Base.HashMap.insert key 1 seen) (d :: acc)

-- 声明身份键：**运算符 + 声明处位置**。iface 里 span 被归一化成空，位置相同的不同
-- 运算符不能互相去重，所以 op 必须进键；同一模块对同一运算符声明两次（值相同）在
-- 源码装载时由模块级检查报错。
fixityDeclKey : FixityDecl -> String
fixityDeclKey d =
  let
    sp = d.fixitySpan
  in "${d.fixityOp}@${spanFile sp}:${spanStartLine sp}:${spanStartCol sp}"

-- ---------------------------------------------------------------
-- 模块导出表计算
-- ---------------------------------------------------------------
isPrivateName : String -> Bool
isPrivateName name = startsWith "_" name

privateExportMsg : String -> Span -> String -> Diagnostic
privateExportMsg prefix sp name =
  diagAt sp SevError PhLoad CatPackage ""
    "${prefix}: cannot export private name ${name} (names starting with _ are module-private)"

-- 本模块里与导出相关的「数据类型」信息：类型名 + 公开构造器名列表。
-- data / record / trait 都按同一套 T / T(..) 规则导出（trait 的方法是它的「构造器」）。
findOwnData : String -> List Decl -> Maybe (Pair String (List String))
findOwnData name [] = Nothing
findOwnData name (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    if dname == name then Just (Pair dname (map ctorName ctors)) else findOwnData name rest
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then Just (Pair dname [dname]) else findOwnData name rest
  DTrait tname params supers methods sp =>
    if tname == name then Just (Pair tname (map traitMethodName methods)) else findOwnData name rest
  _ => findOwnData name rest

findOwnFn : String -> List Decl -> Maybe String
findOwnFn name [] = Nothing
findOwnFn name (d :: rest) = case d of
  DFun n pats body sp => if n == name then Just name else findOwnFn name rest
  DSig n ctx ty sp => if n == name then Just name else findOwnFn name rest
  DAxiom n ty sp => if n == name then Just name else findOwnFn name rest
  DExtern n c ty sp => if n == name then Just name else findOwnFn name rest
  _ => findOwnFn name rest

findCtorNamed : String -> List Ctor -> Maybe String
findCtorNamed name [] = Nothing
findCtorNamed name (c :: rest) =
  if ctorName c == name then Just (ctorName c) else findCtorNamed name rest

-- trait 方法按 `TraitMethod` 取名字（`traitMethodName`）。
findMethodNamed : String -> List TraitMethod -> Maybe String
findMethodNamed name [] = Nothing
findMethodNamed name ((TraitMethod mname ty msp) :: rest) =
  if mname == name then Just mname else findMethodNamed name rest

-- | 本模块里名为 name 的**全部**构造子（不同族可同名）。裸名导出/重导出必须检测歧义。
findOwnCtorNames : String -> List Decl -> List (Pair String String)
findOwnCtorNames name [] = []
findOwnCtorNames name (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    append (map (\c => Pair dname (ctorName c)) (filter (\c => ctorName c == name) ctors))
      (findOwnCtorNames name rest)
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then (::) (Pair dname dname) (findOwnCtorNames name rest)
    else findOwnCtorNames name rest
  DTrait tname params supers methods sp =>
    append
      (map (\m => Pair tname (traitMethodName m)) (filter (\m => traitMethodName m == name) methods))
      (findOwnCtorNames name rest)
  _ => findOwnCtorNames name rest

-- record / trait 的「构造子」条目：target = parent（构造子名 = 类型名 / 方法名）。
ownCtorEntries : String -> String -> List String -> List ExportEntry
ownCtorEntries prefix dname [] = []
ownCtorEntries prefix dname (cname :: rest) =
  (::)
    ExportEntry { kind = "ctor", public = cname, target = mangle prefix cname, parent = mangle prefix dname }
    (ownCtorEntries prefix dname rest)

-- data 构造子的 canonical target 是 `Module.Data.Ctor`。
-- | 本地 data 声明的构造子导出条目（target 用族限定名）。
ownDataCtorEntries : String -> String -> List String -> List ExportEntry
ownDataCtorEntries prefix dname [] = []
ownDataCtorEntries prefix dname (cname :: rest) =
  (::)
    ExportEntry { kind = "ctor", public = cname, target = ctorCanonical prefix dname cname, parent = mangle prefix dname }
    (ownDataCtorEntries prefix dname rest)

-- | 本地类型名的完整导出条目（type + 其构造子/方法），供 `T(..)` 导出使用。
ownTypeEntries : String -> List Decl -> String -> Maybe (List ExportEntry)
ownTypeEntries prefix [] name = Nothing
ownTypeEntries prefix (d :: rest) name = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    if dname == name then Just
      ((::) ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" } (ownDataCtorEntries prefix dname (map ctorName ctors)))
    else ownTypeEntries prefix rest name
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then Just
      ((::) ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" } (ownCtorEntries prefix dname [dname]))
    else ownTypeEntries prefix rest name
  DTrait tname params supers methods sp =>
    if tname == name then Just
      ((::) ExportEntry { kind = "type", public = tname, target = mangle prefix tname, parent = "" } (ownCtorEntries prefix tname (map traitMethodName methods)))
    else ownTypeEntries prefix rest name
  _ => ownTypeEntries prefix rest name

-- 从某模块的导出表里取某数据类型的构造器条目：重导出 `T(..)` 时只重新公开
-- 源模块本来就公开的构造器，从而保持源模块的抽象性。
ctorEntriesOfType : String -> List ExportEntry -> List ExportEntry
ctorEntriesOfType typeTarget [] = []
ctorEntriesOfType typeTarget (e :: rest) =
  if e.kind == "ctor" && e.parent == typeTarget then (::) e (ctorEntriesOfType typeTarget rest)
  else ctorEntriesOfType typeTarget rest

-- 裸名导出时，若名字是 **record 类型** 且与其同名构造器 target 相同，只导出类型、
-- 不导出构造器：抽象记录必须写 T(..) 才公开构造器。（普通 data 里 ctor 与类型同名
-- 的情形保持 v0 语义：裸名两者都导出。）
typeRefDominates : List Module -> List Decl -> String -> Maybe ExportRef -> Maybe ExportRef -> Bool
typeRefDominates modules decls prefix (Just (ExportRef tk tt tp)) vr = case vr of
  Just (ExportRef vk vt vp) =>
    if tk == "type" && vk == "ctor" && tt == vt then isRecordTarget modules decls prefix tt
    else False
  Nothing => False
typeRefDominates modules decls prefix Nothing vr = False

isRecordTarget : List Module -> List Decl -> String -> String -> Bool
isRecordTarget modules decls prefix target = case splitLastDot (splitOnDot target) of
  Pair revPrefix base =>
    let
      m = joinDots revPrefix
    in if m == prefix then isRecordDecl base decls
    else case findModule modules m of
      Just (Module mname mpkg mimports mimps dcs exports mfx _ _ _) => isRecordDecl base dcs
      Nothing => False

isRecordDecl : String -> List Decl -> Bool
isRecordDecl dname [] = False
isRecordDecl dname (d :: rest) = case d of
  DRecord dn params fields derivings viaField repr lin sp => dn == dname || isRecordDecl dname rest
  _ => isRecordDecl dname rest

refEntryList : String -> Maybe ExportRef -> List ExportEntry
refEntryList pub Nothing = []
refEntryList pub (Just (ExportRef k tgt parent)) =
  [ExportEntry { kind = k, public = pub, target = tgt, parent = parent }]

ownOrImportedTypeRef : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedTypeRef modules prefix decls imports name = case findOwnData name decls of
  Just (Pair dname ctorNames) => OkC (Just (ExportRef "type" (mangle prefix dname) ""))
  Nothing => Vuna.Compiler.Base.Common.bind (modulesExportingType modules imports name) (\pairs => case pairs of
    [] => OkC Nothing
    _ =>
      Vuna.Compiler.Base.Common.bind (unifyEntryPairs prefix "type" name pairs)
        (\p => OkC (Just (ExportRef "type" (secondOf p).target "")))
  )

ownOrImportedValueRef : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedValueRef modules prefix decls imports name = case findOwnFn name decls of
  Just fn => OkC (Just (ExportRef "val" (mangle prefix fn) ""))
  Nothing => ownOrImportedValueRef2 modules prefix decls imports name

-- | 本模块值 / 构造子名字的导出引用（构造子走 `ownCtorEntriesNamed` 的歧义检测）。
ownOrImportedValueRef2 : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedValueRef2 modules prefix decls imports name = case ownCtorEntriesNamed prefix name decls of
  [e] => OkC (Just (ExportRef "ctor" e.target e.parent))
  _ :: _ :: _ => rnNoLoc1 (AmbiguousConstructorExport name) name
  [] => Vuna.Compiler.Base.Common.bind (modulesExportingValue modules imports name) (\pairs => case pairs of
    [] => OkC Nothing
    _ => Vuna.Compiler.Base.Common.bind (unifyEntryPairs prefix "name" name pairs) (\p => let
      e = secondOf p
    in OkC (Just (ExportRef e.kind e.target e.parent))
    )
  )

-- | 本模块里名为 name 的构造子导出条目（data 用族限定 target；record/trait 用原名）。
ownCtorEntriesNamed : String -> String -> List Decl -> List ExportEntry
ownCtorEntriesNamed prefix name [] = []
ownCtorEntriesNamed prefix name (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    append
      (ownDataCtorEntries prefix dname (map ctorName (filter (\c => ctorName c == name) ctors)))
      (ownCtorEntriesNamed prefix name rest)
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then append (ownCtorEntries prefix dname [dname]) (ownCtorEntriesNamed prefix name rest)
    else ownCtorEntriesNamed prefix name rest
  DTrait tname params supers methods sp =>
    append
      (ownCtorEntries prefix tname (map traitMethodName (filter (\m => traitMethodName m == name) methods)))
      (ownCtorEntriesNamed prefix name rest)
  _ => ownCtorEntriesNamed prefix name rest

exportBare : List Module -> String -> List Decl -> List Import -> String -> Span -> Check (List ExportEntry)
exportBare modules prefix decls imports name sp = case splitLastDot (splitOnDot name) of
  Pair revPrefix base => case revPrefix of
    [] => Vuna.Compiler.Base.Common.bind (ownOrImportedTypeRef modules prefix decls imports name) (\tr => Vuna.Compiler.Base.Common.bind (ownOrImportedValueRef modules prefix decls imports name) (\vr => case tr of
      Nothing => case vr of
        Nothing => rnAt1 sp (CannotExportUnknownName name) name
        Just _ => OkC (refEntryList name vr)
      Just _ => case vr of
        Nothing => OkC (refEntryList name tr)
        Just _ =>
          if typeRefDominates modules decls prefix tr vr then OkC (refEntryList name tr)
          else OkC (append (refEntryList name tr) (refEntryList name vr))
    )
    )
    _ =>
      let
        mprefix = joinDots revPrefix
      in Vuna.Compiler.Base.Common.bind (resolveImportPrefix imports mprefix)
        (\m => exportSelective modules prefix m base name sp)

renameExportEntry : String -> ExportEntry -> ExportEntry
renameExportEntry public e =
  ExportEntry { kind = e.kind, public = public, target = e.target, parent = e.parent }

renameTypeEntry : String -> ExportEntry -> ExportEntry
renameTypeEntry public e =
  ExportEntry { kind = "type", public = public, target = e.target, parent = "" }

-- | 从指定模块按短名选择性导出：同名多 target 的条目全部保留，使用点再判定。
exportSelective : List Module -> String -> String -> String -> String -> Span -> Check (List ExportEntry)
exportSelective modules prefix m base name sp = Vuna.Compiler.Base.Common.bind (exportsOf modules m) (\es => let
  values = map (renameExportEntry base) (findExportValues es base)
  types = map (renameTypeEntry base) (findExportTypes es base)
  entries = append values types
in if isEmptyEntries entries then rnAt1 sp (CannotExportUnknownName name) name else OkC entries
)

isEmptyEntries : List a -> Bool
isEmptyEntries [] = True
isEmptyEntries (_ :: _) = False

exportTypeAll : List Module -> String -> List Decl -> List Import -> String -> Span -> Check (List ExportEntry)
exportTypeAll modules prefix decls imports name sp = case splitLastDot (splitOnDot name) of
  Pair revPrefix base => case revPrefix of
    [] => case ownTypeEntries prefix decls name of
      Just entries => OkC entries
      Nothing => Vuna.Compiler.Base.Common.bind (modulesExportingType modules imports name) (\pairs => case pairs of
        [] => rnAt1 sp (CannotExportUnknownName name) name
        _ => Vuna.Compiler.Base.Common.bind (unifyEntryPairs prefix "type" name pairs) (\p => let
          m = firstOf p
        in let
          tgt = (secondOf p).target
        in Vuna.Compiler.Base.Common.bind (exportsOf modules m)
          (\es => OkC ((::) ExportEntry { kind = "type", public = name, target = tgt, parent = "" } (ctorEntriesOfType tgt es)))
        )
      )
    _ =>
      let
        mprefix = joinDots revPrefix
      in Vuna.Compiler.Base.Common.bind (resolveImportPrefix imports mprefix) (\m => Vuna.Compiler.Base.Common.bind (exportsOf modules m) (\es => case findExportType es base of
        Just e =>
          OkC
            ((::) ExportEntry { kind = "type", public = base, target = e.target, parent = "" } (ctorEntriesOfType e.target es))
        Nothing => rnAt2 sp (TypeNotExported base m) base m
      )
      )

-- | `export module C [as X]` 对应的 import：已 import 过 C 就复用，否则合成
-- `import C [as X]`（保持 import 区的 open 语义；不写进 AST，Fmt 仍按 `export module` 渲染）。
namespaceImportsOf : List Import -> List ExportItem -> List Import
namespaceImportsOf imports items = append imports (reverse (namespaceImportsGo imports items []))

namespaceImportsGo : List Import -> List ExportItem -> List Import -> List Import
namespaceImportsGo imports [] acc = acc
namespaceImportsGo imports ((XNamespace target alias sp) :: rest) acc =
  if hasImportOf imports target || hasImportOf acc target then namespaceImportsGo imports rest acc
  else namespaceImportsGo imports rest ((::) (Import target False alias sp) acc)
namespaceImportsGo imports (_ :: rest) acc = namespaceImportsGo imports rest acc

hasImportOf : List Import -> String -> Bool
hasImportOf [] name = False
hasImportOf (imp :: rest) name = importName imp == name || hasImportOf rest name

-- | 导出项里的模块前缀：必须唯一（重复 alias/弱短名在导出定义处报歧义）。
resolveImportPrefix : List Import -> String -> Check String
resolveImportPrefix imports prefix = case qualifierCandidates imports prefix of
  [m] => OkC m
  [] => rnNoLoc1 (ModuleNotImported prefix) prefix
  ms => rnNoLoc2 (AmbiguousModule prefix (joinCommaNames ms)) prefix (joinCommaNames ms)

joinCommaNames : List String -> String
joinCommaNames [] = ""
joinCommaNames ([x]) = x
joinCommaNames (x :: rest) = "${x}, ${joinCommaNames rest}"

exportItemEntries : List Module -> String -> List Decl -> List Import -> ExportItem -> Check (List ExportEntry)
exportItemEntries modules prefix decls imports (XModule name sp) =
  Vuna.Compiler.Base.Common.bind (resolveImportPrefix imports name) (\m => exportsOf modules m)
exportItemEntries modules prefix decls imports (XNamespace name alias sp) = Vuna.Compiler.Base.Common.bind (resolveImportPrefix imports name) (\m => case alias of
  Nothing => exportsOf modules m
  Just path =>
    if path == name then OkC [namespaceEntry name m]
    else OkC [namespaceEntry name m, namespaceEntry path m]
)
exportItemEntries modules prefix decls imports (XTypeAll name sp) =
  exportTypeAll modules prefix decls imports name sp
exportItemEntries modules prefix decls imports (XTypeSome name members sp) =
  Vuna.Compiler.Base.Common.bind (exportTypeAll modules prefix decls imports name sp)
    (\es => OkC (filterExportMembers members es))
exportItemEntries modules prefix decls imports (XBare name sp) =
  exportBare modules prefix decls imports name sp

-- | 命名空间路径条目：public 是路径文本（完整模块名或 alias），target 是目标模块。
namespaceEntry : String -> String -> ExportEntry
namespaceEntry path target =
  ExportEntry { kind = "module", public = path, target = target, parent = "" }

filterExportMembers : List String -> List ExportEntry -> List ExportEntry
filterExportMembers members [] = []
filterExportMembers members (e :: rest) =
  if e.kind == "ctor" && not (memName e.public members) then filterExportMembers members rest
  else (::) e (filterExportMembers members rest)

dedupeExportEntries : List ExportEntry -> List ExportEntry
dedupeExportEntries entries = dedupeByFullKey entries (Base.HashMap.fromList []) []

exportEntryKey : ExportEntry -> String
exportEntryKey e = "${e.kind}|${e.public}|${e.target}|${e.parent}"

dedupeByFullKey : List ExportEntry -> HashMap String Int -> List ExportEntry -> List ExportEntry
dedupeByFullKey [] seen acc = reverse acc
dedupeByFullKey (e :: rest) seen acc =
  let
    key = exportEntryKey e
  in case Base.HashMap.lookup key seen of
    Just _ => dedupeByFullKey rest seen acc
    Nothing => dedupeByFullKey rest (Base.HashMap.insert key 1 seen) (e :: acc)

explicitExports : List Module -> String -> List Decl -> List Import -> List ExportItem -> Check (List ExportEntry)
explicitExports modules prefix decls imports [] = OkC []
explicitExports modules prefix decls imports items =
  Vuna.Compiler.Base.Common.bind (exportItemsAll modules prefix decls imports items)
    (\es => OkC (dedupeExportEntries es))

-- 逐项解析条目。整表只做一次重复检查、最后只去重一次：不在每个导出项上重查剩余
-- 列表并把 append 结果整体去重（那是 O(k³)，k=400 时约 16s）。
exportItemsAll : List Module -> String -> List Decl -> List Import -> List ExportItem -> Check (List ExportEntry)
exportItemsAll modules prefix decls imports [] = OkC []
exportItemsAll modules prefix decls imports (item :: rest) =
  Vuna.Compiler.Base.Common.bind (exportItemEntries modules prefix decls imports item)
    (\es => Vuna.Compiler.Base.Common.bind (exportItemsAll modules prefix decls imports rest) (\tail => OkC (append es tail)))

validateModuleHeader : String -> Maybe ModDecl -> Check (List a)
validateModuleHeader label Nothing = OkC []
validateModuleHeader label (Just (ModDecl declared hasList items _ _ _ sp)) =
  if declared == label then OkC [] else rnAt1 sp (ModuleNameMismatch declared) declared

opaqueNamesOf : String -> List OpacitySpec -> List String
opaqueNamesOf prefix [] = []
opaqueNamesOf prefix (o :: rest) = case o.opacityKind of
  OpacityOpaque => (::) (mangle prefix (opacitySpecName o)) (opaqueNamesOf prefix rest)
  OpacityTransparent => opaqueNamesOf prefix rest
  OpacityAbstract => (::) (":" ++ mangle prefix (opacitySpecName o)) (opaqueNamesOf prefix rest)

export abstractOpaquePrefix : String
abstractOpaquePrefix = ":"

export opaqueBaseName : String -> String
opaqueBaseName name =
  if startsWith abstractOpaquePrefix name then strSubstring (strLength abstractOpaquePrefix) (strLength name - strLength abstractOpaquePrefix)
    name
  else name

export isAbstractOpaqueName : String -> Bool
isAbstractOpaqueName name = startsWith abstractOpaquePrefix name

computeExports : List Module -> String -> Maybe ModDecl -> List Import -> List Decl -> List ExportSpec -> List ExportItem -> Check (List ExportEntry)
computeExports modules prefix hdr imports decls extraExports extraReexports =
  let
    newItems = append (map exportSpecToItem extraExports) extraReexports
    explicit = explicitExports modules prefix decls imports newItems
  in if notEmpty newItems then case hdr of
    Just (ModDecl _ hasList _ _ _ _ sp) =>
      if hasList then rnAt1 sp (DuplicateExport "module header") "module header" else explicit
    Nothing => explicit
  else case hdr of
    Just (ModDecl _ hasList items _ _ _ spHdr) =>
      if hasList then explicitExports modules prefix decls imports items else OkC []
    Nothing => OkC []

notEmpty : List a -> Bool
notEmpty [] = False
notEmpty (_ :: _) = True

exportSpecToItem : ExportSpec -> ExportItem
exportSpecToItem (ESValue name sp) = XBare name sp
exportSpecToItem (ESType name EMNone sp) = XBare name sp
exportSpecToItem (ESType name EMAll sp) = XTypeAll name sp
exportSpecToItem (ESType name (EMOnly members) sp) = XTypeSome name members sp

showCycle : String -> List String -> String
showCycle name stack = joinArrows (reverse (name :: stack))

-- 自动注入的 Prelude：从导入方所在包可见的依赖包取。
-- 显式 import Prelude 时不再重复注入；Prelude 自身不注入（避免环）；当前包自己
-- 的 Prelude 不算候选（`implicitPreludeDeps` 按包名过滤）。
-- ad-hoc（importerPkg==""）同样是包上下文（base-only）：自动注入 base 的 Prelude；
-- 没有 base 依赖的包没有候选，于是不注入。
export implicitPrelude : Member nFs FsOp r => List Root -> String -> String -> List Import -> Eff r (Check (List Import))
implicitPrelude roots importerPkg currentName imports =
  if currentName == "Prelude" then pure (OkC [])
  else if memName "Prelude" (importModuleNames imports) then pure (OkC [])
  else implicitPreludeFrom roots importerPkg

implicitPreludeFrom : Member nFs FsOp r => List Root -> String -> Eff r (Check (List Import))
implicitPreludeFrom roots importerPkg = do
  collected <- collectModuleFiles roots "Prelude" importerPkg [] []
  let
    allowed = firstOf collected
  in pure
    (implicitPreludeDeps importerPkg (filter (\c => rootName (secondOf c) /= importerPkg) allowed))

implicitPreludeDeps : String -> List (Pair String Root) -> Check (List Import)
implicitPreludeDeps importerPkg [] = OkC []
implicitPreludeDeps importerPkg ([_]) = OkC [Import "Prelude" False Nothing (Span "" 0 0 0 0 0 0)]
implicitPreludeDeps importerPkg deps =
  onErrDiag (withAbsent NsPackageGraph)
    (rnNoLoc1 (AmbiguousPrelude (joinArrows (map (\c => rootName (secondOf c)) deps))) (joinArrows (map (\c => rootName (secondOf c)) deps)))

-- 导入点位置：隐式 Prelude 的合成 Import 没有真实 span（file = ""），此时不给位置。
-- 载入完成后跑一次层约束检查（`[layers]`）；未声明层的项目是零开销的空检查。
withLayerCheck : List Root -> Project -> Check Project
withLayerCheck roots project =
  Vuna.Compiler.Base.Common.bind (checkProjectLayers roots project) (\_ => OkC project)

withImportSpan : Import -> Diagnostic -> Diagnostic
withImportSpan imp e =
  if spanFile imp.importSpan == "" then e else withFallbackSpan imp.importSpan e

loadAll : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Int -> List Root -> String -> List Module -> List String -> List Import -> Eff r (Check (List Module))
loadAll fuel roots importerPkg modules stack imports = if fuel <= 0 then pure (icFuel "loader")
else case imports of
  [] => pure (OkC modules)
  imp :: rest => do
    modulesR <- loadModule (fuel - 1) roots importerPkg modules stack imp
    case modulesR of
      ErrC e => pure (ErrC e)
      OkC modules2 => loadAll (fuel - 1) roots importerPkg modules2 stack rest

pathPrefixOf : Member nFs FsOp r => List Root -> String -> List String -> Int -> Eff r (Maybe (Pair String Int))
pathPrefixOf roots importerPkg segs n = if n < 1 then pure Nothing
else do
  collected <- collectModuleFiles roots (joinDots (nsTakeLocal n segs)) importerPkg [] []
  if notEmpty (firstOf collected) then pure (Just (Pair (joinDots (nsTakeLocal n segs)) n))
  else pathPrefixOf roots importerPkg segs (n - 1)

nsTakeLocal : Int -> List String -> List String
nsTakeLocal n [] = []
nsTakeLocal n (x :: rest) = if n <= 0 then [] else (::) x (nsTakeLocal (n - 1) rest)

nsDropLocal : Int -> List String -> List String
nsDropLocal n [] = []
nsDropLocal n (x :: rest) = if n <= 0 then (::) x rest else nsDropLocal (n - 1) rest

loadModule : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Int -> List Root -> String -> List Module -> List String -> Import -> Eff r (Check (List Module))
loadModule fuel roots importerPkg modules stack imp =
  let
    name = importName imp
  in if fuel <= 0 then pure (icFuel "loader")
  else case findModule modules name of
    Just m => pure (OkC modules)
    Nothing => if memName name stack then pure
      (onErrDiag (withImportSpan imp) (ldErr1 (ImportCycle (showCycle name stack)) (showCycle name stack)))
    else if validModuleName name then do
      foundR <- findModuleFile roots name importerPkg imp.importSpan
      case foundR of
        ErrC e => case imp.importAlias of
          Nothing => pure (ErrC e)
          Just alias => do
            prefixR <-
              pathPrefixOf roots importerPkg (splitOnDot name)
                (Base.List.length (splitOnDot name) - 1)
            case prefixR of
              Nothing => pure (ErrC e)
              Just (Pair prefix n) => do
                modsR <-
                  loadModule (fuel - 1) roots importerPkg modules stack
                    (Import prefix False Nothing imp.importSpan)
                case modsR of
                  ErrC e2 => pure (ErrC e2)
                  OkC modules1 => case findModule modules1 prefix of
                    Nothing => pure (ErrC e)
                    Just provider => case walkNamespaceIndex modules1 prefix (nsDropLocal n (splitOnDot name)) of
                      Nothing => pure (ErrC e)
                      Just target =>
                        loadModule (fuel - 1) roots (modulePackageOf provider) modules1 stack
                          (Import target True Nothing imp.importSpan)
        OkC found =>
          let
            path = firstOf found
            root = secondOf found
            _ = dbg! "parse-module=${name}"
          in do
            text <- fsReadFile path
            parsed <- parseFileWithPath path text
            case parsed of
              ErrC e => pure (ErrC e)
              OkC (SourceFile hdr imports0 fixities decls exports reexports opacity) =>
                let
                  imports1 = imports0
                  providers = []
                  modules1 = modules
                  imports = namespaceImportsOf imports1 reexports
                in case validateModuleHeader name hdr of
                  ErrC e => pure (ErrC e)
                  OkC _ => case validateImports name imports of
                    ErrC e => pure (ErrC e)
                    OkC _ => do
                      implicitR <- implicitPrelude roots (rootName root) name imports
                      case implicitR of
                        ErrC e => pure (ErrC e)
                        OkC implicit => do
                          modulesR <-
                            loadAll (fuel - 1) roots (rootName root) modules1 (name :: stack)
                              (append imports implicit)
                          case modulesR of
                            ErrC e => pure (ErrC e)
                            OkC modules2 => case computeExports modules2 name hdr imports decls exports reexports of
                              ErrC e => pure (ErrC e)
                              OkC exports =>
                                let
                                  visible = fixities
                                in pure
                                  (OkC ((::) (Module name (rootName root) imports implicit decls exports visible (append providers (append (reexportedImportNamesOfHeader imports hdr) (reexportedImportNames imports reexports))) (opaqueNamesOf name opacity) (exportIndexOf exports)) modules2))
    else pure (onErrDiag (withImportSpan imp) (ldErr1 (InvalidModuleName name) name))

-- 包上下文入口：ctx 给出模块根（自己 lib 在最前 + 依赖闭包）与导入方包名
-- （决定同包/跨包导出可见性与 manifest 能力声明）。
-- loadProject 返回 flatten 前的形态（入口声明 + 依赖模块列表），供分离编译使用。
export loadProject : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Check Project)
loadProject ctx entry = loadProjectWithPreloaded ctx entry []

-- 接口模式加载。`preloaded` 是依赖包里**已解析**的模块（来自模块接口），
-- 加载器把它们当「已加载模块」直接命中：不读源码、不 parse、不算导出表。本包模块与入口
-- 仍按源码加载；模块表的顺序约定与 `loadAll` 一致（新加载模块前插，dependents-first），
-- 所以调用方应把 `preloaded` 按 reverse(topo) 传入。
export loadProjectWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> List Module -> Eff r (Check Project)
loadProjectWithPreloaded ctx entry preloaded = do
  exists <- fsFileExists entry
  if exists then do
    text <- fsReadFile entry
    parsed <- parseFileWithPath entry text
    case parsed of
      ErrC e => pure (ErrC e)
      OkC (SourceFile hdr imports fixities decls exports reexports opacity) => case hdr of
        Just (ModDecl dname hasList items _ _ _ sp) =>
          pure (onErrDiag (withFallbackSpan sp) (ldErr1 (ModuleHeaderInEntryFile entry) entry))
        Nothing =>
          let
            imports1 = imports
            preloaded1 = preloaded
          in case validateImports "<entry>" imports1 of
            ErrC e => pure (ErrC e)
            OkC _ => do
              implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports1
              case implicitR of
                ErrC e => pure (ErrC e)
                OkC implicit => do
                  modulesR <-
                    loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded1 []
                      (append imports1 implicit)
                  pure (case modulesR of
                    ErrC e => ErrC e
                    OkC modules =>
                      withLayerCheck (contextRoots ctx)
                        (Project decls imports1 implicit modules (contextPackageName ctx) fixities)
                  )
  else pure (ldErr1 (EntryFileNotFound entry) entry)

-- 库包入口：不带 app/Main.vuna 的包，以 [export].modules 作为根模块集合。
export loadProjectModules : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> Eff r (Check Project)
loadProjectModules ctx names = loadProjectModulesWithPreloaded ctx names []

export loadProjectModulesWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> List Module -> Eff r (Check Project)
loadProjectModulesWithPreloaded ctx names preloaded =
  let
    entryImports = map (\n => Import n False Nothing (Span "" 0 0 0 0 0 0)) names
  in do
    modulesR <-
      loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded [] entryImports
    pure (case modulesR of
      ErrC e => ErrC e
      OkC modules =>
        withLayerCheck (contextRoots ctx) (Project [] [] [] modules (contextPackageName ctx) [])
    )

-- 入口以**源码字符串**给出（REPL 的表达式求值）：入口不落盘（import 仍按上下文的
-- roots 从磁盘解析）；隐式 Prelude 与文件入口同规则（ad-hoc 单文件也自动注入）。
export loadProjectSource : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Check Project)
loadProjectSource ctx label source = loadProjectSourceWithPreloaded ctx label source []

-- | 入口以源码字符串给出，依赖包模块可预置（零 parse）。
export loadProjectSourceWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> List Module -> Eff r (Check Project)
loadProjectSourceWithPreloaded ctx label source preloaded = do
  parsed <- parseFileWithPathMode PmTool label source
  case parsed of
    ErrC e => pure (ErrC e)
    OkC (SourceFile hdr imports fixities decls exports reexports opacity) => case hdr of
      Just (ModDecl dname hasList items _ _ _ sp) =>
        pure (ldErr1 (ModuleHeaderInEntrySource label) label)
      Nothing =>
        let
          imports1 = imports
          preloaded1 = preloaded
        in case validateImports "<entry>" imports1 of
          ErrC e => pure (ErrC e)
          OkC _ => do
            implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports1
            case implicitR of
              ErrC e => pure (ErrC e)
              OkC implicit => do
                modulesR <-
                  loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded1 []
                    (append imports1 implicit)
                pure (case modulesR of
                  ErrC e => ErrC e
                  OkC modules =>
                    withLayerCheck (contextRoots ctx)
                      (Project decls imports1 implicit modules (contextPackageName ctx) fixities)
                )

-- 以**源码字符串**给出一个**库模块**：源码允许带 `module ... where`
-- 头（LSP 打开 lib/ 下的文件时就是这种形态）。模块头存在时，按 import 闭包加载后
-- 把该模块本身作为合成的 `Module` 放进 Project，再交给 `resolveProject` 做名字解析；
-- 无模块头时退化为入口语义（与 `loadProjectSource` 相同）。
-- 入口声明保持为空：调用方只需要逐模块已解析的声明。
export loadModuleSource : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Check Project)
loadModuleSource ctx label source = loadModuleSourceWithPreloaded ctx label source []

-- 依赖包模块可预置（来自接口的 `Module`），只 parse 当前文件与同包源码。
export loadModuleSourceWithPreloaded : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> List Module -> Eff r (Check Project)
loadModuleSourceWithPreloaded ctx label source preloaded = do
  parsed <- parseFileWithPathMode PmTool label source
  case parsed of
    ErrC e => pure (ErrC e)
    OkC (SourceFile hdr imports0 fixities decls exports reexports opacity) => case hdr of
      Nothing => loadProjectSourceWithPreloaded ctx label source preloaded
      Just (ModDecl name hasList items _ _ _ sp) =>
        let
          imports1 = imports0
          providers = []
          preloaded1 = preloaded
          imports = namespaceImportsOf imports1 reexports
        in case validateImports name imports of
          ErrC e => pure (ErrC e)
          OkC _ => do
            implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) name imports
            case implicitR of
              ErrC e => pure (ErrC e)
              OkC implicit => do
                modulesR <-
                  loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) preloaded1 []
                    (append imports implicit)
                case modulesR of
                  ErrC e => pure (ErrC e)
                  OkC modules => case computeExports modules name hdr imports decls exports reexports of
                    ErrC e => pure (ErrC e)
                    OkC exports =>
                      let
                        visible = fixities
                      in pure
                        (withLayerCheck (contextRoots ctx) (Project [] imports implicit (Module name (contextPackageName ctx) imports implicit decls exports visible (append providers (reexportedImportNames imports (append items reexports))) (opaqueNamesOf name opacity) (exportIndexOf exports) :: modules) (contextPackageName ctx) []))

-- fmt 用的「程序级 fixity」——本文件的 `infix*` 声明（在前，本地优先）
-- ++ import 闭包可见的声明（Module 里已含各自的 import 闭包）。只 parse + 加载模块图，
-- **不做精化/名字解析**，因此很便宜；有/无模块头都支持。
--
-- `modules` 是调用方可复用的已加载模块表（按包上下文缓存）：同包多文件只加载一次模块图。
-- 但 fixity **声明表必须按文件重算**（local + 该文件自己的 import 闭包）——不同文件的
-- imports 不同，跨文件复用声明表会让 fmt 给 `::`/`+` 等打出错误的括号。
-- 返回值同时带回更新后的模块表，供调用方继续复用。
-- parse 读 lex 缓存 / 探测模块文件是宿主动作，外壳显式 `Eff r`；声明表计算保持纯。
export fixitiesForSourceIn : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List Module -> String -> String -> Eff r (Check (Pair (List Module) (List FixityDecl)))
fixitiesForSourceIn ctx modules0 label source = do
  parsed <- parseFileWithPathMode PmTool label source
  case parsed of
    ErrC e => pure (ErrC e)
    OkC (SourceFile hdr imports0 fixities decls exports reexports opacity) =>
      let
        imports1 = imports0
        modules1 = modules0
        imports = namespaceImportsOf imports1 reexports
      in case hdr of
        Nothing => case validateImports label imports of
          ErrC e => pure (ErrC e)
          OkC _ => do
            implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports
            case implicitR of
              ErrC e => pure (ErrC e)
              OkC implicit => do
                modulesR <-
                  loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) modules1 []
                    (append imports implicit)
                pure (case modulesR of
                  ErrC e => ErrC e
                  OkC modules =>
                    OkC
                      (Pair modules (dedupeFixities (append fixities (visibleFixitiesOf modules (append imports implicit)))))
                )
        Just (ModDecl name hasList items _ _ _ sp) => case validateImports name imports of
          ErrC e => pure (ErrC e)
          OkC _ => do
            implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) name imports
            case implicitR of
              ErrC e => pure (ErrC e)
              OkC implicit => do
                modulesR <-
                  loadAll 1048576 (contextRoots ctx) (contextPackageName ctx) modules1 []
                    (append imports implicit)
                pure (case modulesR of
                  ErrC e => ErrC e
                  OkC modules =>
                    OkC
                      (Pair modules (dedupeFixities (append fixities (visibleFixitiesOf modules (append imports implicit)))))
                )

-- 单文件便捷入口（LSP formatting / fmt 探针）：不跨调用复用模块表。
export fixitiesForSource : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Check (List FixityDecl))
fixitiesForSource ctx label source = do
  pairR <- fixitiesForSourceIn ctx [] label source
  pure (case pairR of
    ErrC e => ErrC e
    OkC p => OkC (secondOf p)
  )

-- 返回逐模块已解析（未 flatten）的声明 + 本次解析产生的 warning（unused import）。
-- warning 是显式返回值：名字解析期不维护 used-set，解析完成后按「实际引用的目标」判定。
export resolveProject : Project -> Check (Pair (List Diagnostic) (Pair (List Decl) (List Module)))
resolveProject project = resolveProjectKeeping False [] project

-- | 带 release 模式的解析入口（CLI 路径显式传入 `--release` / `VUNA_RELEASE=1`）。
export resolveProjectWith : Bool -> Project -> Check (Pair (List Diagnostic) (Pair (List Decl) (List Module)))
resolveProjectWith release project = resolveProjectKeeping release [] project

-- `keep` 里的模块已经解析过（来自接口文件），原样保留、不重解析。
export resolveProjectKeeping : Bool -> List String -> Project -> Check (Pair (List Diagnostic) (Pair (List Decl) (List Module)))
resolveProjectKeeping release keep (Project decls imports implicit modules entryPkg entryFixes) =
  let
    projectFixities = dedupeFixities (append (concatMap moduleFixitiesOf modules) entryFixes)
  in Vuna.Compiler.Base.Common.bind (checkUniqueFixities projectFixities)
    (\fixes => Vuna.Compiler.Base.Common.bind (reorderProgram (tableOf fixes) decls) (\decls2 => Vuna.Compiler.Base.Common.bind (expandDecls decls2) (\decls3 => Vuna.Compiler.Base.Common.bind (resolveEntry release modules entryPkg (append imports implicit) decls3) (\entryDecls => Vuna.Compiler.Base.Common.bind (unusedImportWarnings modules imports entryDecls decls3 []) (\entryWarns => Vuna.Compiler.Base.Common.bind (resolveModulesKeep release keep fixes modules) (\p2 => OkC (Pair (append entryWarns (secondOf p2)) (Pair entryDecls (firstOf p2)))))))))

resolveModulesKeep : Bool -> List String -> List FixityDecl -> List Module -> Check (Pair (List Module) (List Diagnostic))
resolveModulesKeep release keep fixes [] = OkC (Pair [] [])
resolveModulesKeep release keep fixes ((Module name pkg imports implicit decls exports fixities reexports opacity idx) :: rest) =
  if memName name keep then Vuna.Compiler.Base.Common.bind (resolveModulesKeep release keep fixes rest)
    (\p2 => OkC (Pair ((::) (Module name pkg imports implicit decls exports fixities reexports opacity idx) (firstOf p2)) (secondOf p2)))
  else Vuna.Compiler.Base.Common.bind (reorderProgram (tableOf fixes) decls)
    (\decls2 => Vuna.Compiler.Base.Common.bind (expandDecls decls2) (\decls3 => Vuna.Compiler.Base.Common.bind (resolveProgram (Module name pkg imports implicit decls3 exports fixities reexports opacity idx :: rest) name name (namespacesOfWith release decls3) (append imports implicit) decls3) (\d1 => Vuna.Compiler.Base.Common.bind (unusedImportWarnings (Module name pkg imports implicit decls3 exports fixities reexports opacity idx :: rest) imports d1 decls3 reexports) (\warns => Vuna.Compiler.Base.Common.bind (resolveModulesKeep release keep fixes rest) (\p2 => OkC (Pair ((::) (Module name pkg imports implicit d1 exports fixities reexports opacity idx) (firstOf p2)) (append warns (secondOf p2))))))))

-- ---------------------------------------------------------------
-- unused import warning：显式 import 未在所属检查单元里被引用。
-- （隐式 Prelude 不参与；判定见 `unusedImportWarnings`。）
-- ---------------------------------------------------------------
unusedImportWarnings : List Module -> List Import -> List Decl -> List Decl -> List String -> Check (List Diagnostic)
unusedImportWarnings modules imports decls sourceDecls reexports =
  let
    names0 = concatMap declGlobalNames decls
    -- 模板字符串降级会合成 `Base.Interp.interp`（Resolve.lowerTemplate）：它是解析**之后**
    -- 注入的 canonical 名，不算作 import 使用。源码没有显式引用 interp 时剔除合成名，
    -- 只被模板串引用的 import 仍报 unused。
    names =
      if interpReferencedInSource sourceDecls then names0
      else filter (\n => n /= interpMethodName) names0
    nameSet = Base.HashMap.ofNames names
  in unusedImportWarningsGo modules nameSet reexports imports

-- | 源码里是否显式提到 `interp` / `Base.Interp.interp`（未解析 AST 的名字扫描）。
interpReferencedInSource : List Decl -> Bool
interpReferencedInSource decls =
  let
    names = concatMap declRefNames decls
  in memName "interp" names || memName interpMethodName names

unusedImportWarningsGo : List Module -> HashMap String Bool -> List String -> List Import -> Check (List Diagnostic)
unusedImportWarningsGo modules nameSet reexports [] = OkC []
unusedImportWarningsGo modules nameSet reexports (imp :: rest) = Vuna.Compiler.Base.Common.bind (exportsOf modules (importName imp)) (\es => let
  used = memName (importName imp) reexports || anyTargetIn nameSet (map exportTargetOf es)
in Vuna.Compiler.Base.Common.bind (unusedImportWarningsGo modules nameSet reexports rest)
  (\more => OkC (if used then more else (::) (warnDiagAtMod (\d => withSuggestion (Suggestion "remove unused import ${imp.importName}" MachineApplicable [DiagEdit (importRemovalSpan imp.importSpan) ""]) d) imp.importSpan (UnusedImport imp.importName) [imp.importName]) more))
)

-- 整行删除 import 的编辑 span：从行首到下一行行首（含换行）。
importRemovalSpan : Span -> Span
importRemovalSpan sp =
  Span (spanFile sp) (spanStartLine sp) 1 (spanStartLine sp + 1) 1
    (spanStartOffset sp - (spanStartCol sp - 1)) (spanStartOffset sp - (spanStartCol sp - 1))

-- 已解析声明里出现的全部引用目标（值 / 类型 / 构造子位置）。解析期已把可解析的名字
-- 换成 canonical target；`@vuna@ctor@短名@t1@t2` 形态（重载构造子）展开成它的候选目标。
declGlobalNames : Decl -> List String
declGlobalNames d = concatMap expandGlobalName (declRefNames d)

-- | 把内部语法名展开成它携带的 canonical target；普通名字原样返回。
--   * `@vuna@ctor@短名@t1@t2`（重载构造子）→ 候选目标 t1/t2；
--   * `@vuna@do@bind@<canonical>` / `@vuna@do@ignore@<canonical>` → canonical bind 目标
--     （do 链在 rename 后仍引用 bind 的实现模块，import 是否使用要算上它）。
expandGlobalName : String -> List String
expandGlobalName n = if isOverCtorName n then overCtorTargets n
else case doSyntaxCanonical n of
  Just canonical => (::) canonical []
  Nothing => (::) n []

-- | 导出条目的 canonical target。
exportTargetOf : ExportEntry -> String
exportTargetOf e = e.target

-- | import 导出表里是否有某个 target 出现在本次检查的已解析声明中。
anyTargetIn : HashMap String Bool -> List String -> Bool
anyTargetIn nameSet [] = False
anyTargetIn nameSet (t :: rest) =
  if Base.HashMap.member t nameSet then True else anyTargetIn nameSet rest

-- | 声明里出现的引用名（不递归展开 over-ctor；构造子/类型/值位置都收集）。
declRefNames : Decl -> List String
declRefNames (DData dname params kind ctors derivings viaField repr lin sp) =
  append (exprRefNames kind) (append (concatMap ctorRefNames ctors) derivings)
declRefNames (DRecord dname params fields derivings viaField repr lin sp) =
  append (concatMap fieldRefNames fields) derivings
declRefNames (DTrait tname params supers methods sp) =
  append (concatMap exprRefNames supers) (concatMap traitMethodRefNames methods)
declRefNames (DInstance ctxE head methods sp) =
  append (concatMap exprRefNames ctxE) (append (exprRefNames head) (concatMap declRefNames methods))
declRefNames (DSig name ctx ty sp) = append (concatMap exprRefNames ctx) (exprRefNames ty)
declRefNames (DAxiom name ty sp) = exprRefNames ty
declRefNames (DExtern name cName ty sp) = exprRefNames ty
declRefNames (DFun name pats body sp) = append (concatMap patRefNames pats) (exprRefNames body)

-- | 构造子声明类型里的引用名。
ctorRefNames : Ctor -> List String
ctorRefNames c = exprRefNames c.ctorType

-- | record 字段类型里的引用名。
fieldRefNames : Field -> List String
fieldRefNames f = exprRefNames f.fieldType

-- | trait 方法类型里的引用名。
traitMethodRefNames : TraitMethod -> List String
traitMethodRefNames m = exprRefNames m.traitMethodType

-- | 模式里的引用名（构造子 / record 名；binder 名不是引用）。
patRefNames : Pat -> List String
patRefNames (PVar name sp) = []
patRefNames (PAs name inner sp) = patRefNames inner
patRefNames (PWild sp) = []
patRefNames (PCon name pats sp) = (::) name (concatMap patRefNames pats)
patRefNames (PInt n sp) = []
patRefNames (PStr s sp) = []
patRefNames (PRecord name fields sp) = (::) name (concatMap (\f => patRefNames (secondOf f)) fields)

-- | 表达式里出现的引用名（EVar 已由解析期换成 canonical target）。
exprRefNames : Expr -> List String
exprRefNames (EVar n sp) = (::) n []
exprRefNames (EInt n sp) = []
exprRefNames (EStr s sp) = []
exprRefNames (EFloat raw sp) = []
exprRefNames (ELam ps body sp) = exprRefNames body
exprRefNames (EApp fn args sp) = append (exprRefNames fn) (concatMap exprRefNames args)
exprRefNames (EPi name implicit qty dom cod sp) = append (exprRefNames dom) (exprRefNames cod)
exprRefNames (ELet binds body rec_ sp) = append (concatMap bindRefNames binds) (exprRefNames body)
exprRefNames (ELocalFun clauses sp) = concatMap clauseRefNames clauses
exprRefNames (ECase scrut alts sp) = append (exprRefNames scrut) (concatMap bindRefNames alts)
exprRefNames (EIf c t el sp) = append (exprRefNames c) (append (exprRefNames t) (exprRefNames el))
exprRefNames (EField base fname sp) = exprRefNames base
exprRefNames (ERecord name fields sp) =
  (::) name (concatMap (\f => exprRefNames (secondOf f)) fields)
exprRefNames (ERecUpdate base fields sp) =
  append (exprRefNames base) (concatMap (\f => exprRefNames (secondOf f)) fields)
exprRefNames (EDo stmts sp) = concatMap doStmtRefNames stmts
exprRefNames (EInfix op lhs rhs sp) = (::) op (append (exprRefNames lhs) (exprRefNames rhs))
exprRefNames (EParen inner sp) = exprRefNames inner
exprRefNames (EBacktick op lhs rhs sp) = (::) op (append (exprRefNames lhs) (exprRefNames rhs))
exprRefNames (ESectOp op sp) = (::) op []
exprRefNames (ESectL op rhs sp) = (::) op (exprRefNames rhs)
exprRefNames (ESectR lhs op sp) = (::) op (exprRefNames lhs)
exprRefNames (EAnn value ty sp) = append (exprRefNames value) (exprRefNames ty)
exprRefNames (EInterp multi parts sp) = concatMap interpPartRefNames parts

-- | `pat = expr` 绑定里的引用名（模式 binder 不算引用）。
bindRefNames : Pair Pat Expr -> List String
bindRefNames p = append (patRefNames (firstOf p)) (exprRefNames (secondOf p))

-- | 局部函数 clause（参数模式 + body）里的引用名。
clauseRefNames : Pair (List Pat) Expr -> List String
clauseRefNames p = append (concatMap patRefNames (firstOf p)) (exprRefNames (secondOf p))

-- | do 语句里的引用名。
doStmtRefNames : DoStmt -> List String
doStmtRefNames (DBind pat e sp) = append (patRefNames pat) (exprRefNames e)
doStmtRefNames (DExpr e sp) = exprRefNames e

-- | 模板片段里的引用名（洞内表达式）。
interpPartRefNames : InterpPart -> List String
interpPartRefNames (IPText s) = []
interpPartRefNames (IPHole e) = exprRefNames e
