-- | 模块头（import 名单）的输入寻址缓存。
--
-- 头是源字节的纯函数（`Addr.headerOfSource`）。闭包扫描只需要 import 边来算接口地址，
-- 却要为此把每个模块完整 lex + parse 一遍；整包 183 个模块约 0.15 s，而每个模块的
-- 头只有几十字节。这里把「源内容地址 → import 名单」落成一个小对象：命中就不 parse，
-- 未命中现 parse 一次并写回。
--
-- 只缓存**成功解析**的模块：语法错误的源每次重新 parse，诊断仍由加载器照常上报。
-- 键只含源内容地址（不含编译器身份）：同一份字节永远同一个头，与谁构建它无关；
-- 抽取口径变化靠 `headerCodec` bump 换代。
module Vuna.Compiler.Loader.Header where

import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes
import Vuna.Compiler.Base.Bytes
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Store
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Addr
import Vuna.Compiler.Loader.Flatten

headerKind : String
headerKind = "module-header"

-- | 载荷 schema（抽取口径 / 编码变化时 bump，旧对象自然拒绝）。
headerCodec : String
headerCodec = "module-header 1"

-- | 对象地址：源内容地址 + schema。
headerObjKey : String -> String
headerObjKey srcDigest = addrOf [headerKind, headerCodec, srcDigest]

encImports : List String -> String
encImports = encTop (encList encStr)

decImports : String -> Maybe (List String)
decImports s =
  case decList decStr (strLength s) (curOf s) of
    Nothing => Nothing
    Just (Pair names rest) => if curAtEnd rest then Just names else Nothing

-- | 模块的 import 名单（含 `export module` 合成的边，见 `Addr.headerOfSource`）。
--
-- `srcDigest` 是源字节的内容地址（与 `ClosureMod.cmSrc` 同一个摘要），`path` 只用于
-- 解析诊断里的文件名。
export headerImportsEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> String -> Eff r (List String)
headerImportsEff path srcDigest raw =
  do
    saved <- storeObjectReadEff headerKind headerCodec (headerObjKey srcDigest)
    case saved of
      Just payload =>
        case decImports payload of
          Just names => pure names
          Nothing => parseAndStore path srcDigest raw
      Nothing => parseAndStore path srcDigest raw

parseAndStore : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> String -> Eff r (List String)
parseAndStore path srcDigest raw =
  do
    parsed <- parseFileWithPath path raw
    case parsed of
      ErrC _ => pure []
      OkC sf =>
        let
          -- 模块名来自路径而不是源字节，所以头里不需要它：缓存的是名字无关的 import 边。
          hdr = headerOfSource "" sf
          names = hdr.mhImports
        in do
          _ <- storeObjectWriteEff headerKind headerCodec (headerObjKey srcDigest) (encImports names)
          pure names
