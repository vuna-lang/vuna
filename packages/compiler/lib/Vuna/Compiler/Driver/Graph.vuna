-- | 查询图的节点表（进程内）：节点 key = 输入地址，边 = 直接依赖。
--
-- 这里只做**节点形状与调度层**：源摘要 / 模块接口 / pass 结果统一成 `GraphNode`；
-- 有效性仍由对象库回答，源码扫描由 `Driver.Compile.ScanMode` 提供。当前接的是模块接口
-- 节点（`ClosureMod.cmAddr`），后续再加源摘要与 pass 节点时复用同一张表。
module Vuna.Compiler.Driver.Graph where

import Base.Data.List as List
import Base.Data.String as String
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Loader.Addr
import Vuna.Compiler.Loader.Closure
import Vuna.Ir.Passes

export data NodeKind(..) : Type where
  NodeSource : NodeKind
  NodeIface : NodeKind
  NodePass : String -> NodeKind

export record GraphNode(..) where
  gnKey : String
  gnKind : NodeKind
  gnDeps : List String
  gnCost : Int

-- | 模块接口节点：key 是接口地址，依赖是**自身源摘要节点** + 每个 import 的接口地址；
-- 闭包外的名字保留成 `ext:<name>` 哨兵（不阻塞调度，但观测里能看出缺口）。
export ifaceNodesOf : List ClosureMod -> List GraphNode
ifaceNodesOf mods = map (ifaceNodeOf mods) mods

ifaceNodeOf : List ClosureMod -> ClosureMod -> GraphNode
ifaceNodeOf mods m =
  GraphNode
    m.cmAddr
    NodeIface
    (sourceKeyOf m :: map (ifaceDepKey mods) m.cmImports)
    (1 + length m.cmImports)

-- | 源摘要节点：key 由包身份 + 模块名 + 63-bit 内容键决定；接口节点依赖它。
export sourceNodesOf : List ClosureMod -> List GraphNode
sourceNodesOf mods = map sourceNodeOf mods

sourceNodeOf : ClosureMod -> GraphNode
sourceNodeOf m = GraphNode (sourceKeyOf m) NodeSource [] 1

export sourceKeyOf : ClosureMod -> String
sourceKeyOf m = addrOf ["source", m.cmPkgKey, m.cmName, strFromInt m.cmKey]

-- | 源节点 + 接口节点的完整两级图。
export ifaceGraphOf : List ClosureMod -> List GraphNode
ifaceGraphOf mods = append (sourceNodesOf mods) (ifaceNodesOf mods)

ifaceDepKey : List ClosureMod -> String -> String
ifaceDepKey mods name =
  case findMod mods name of
    Just m => m.cmAddr
    Nothing => "ext:${name}"

findMod : List ClosureMod -> String -> Maybe ClosureMod
findMod [] _ = Nothing
findMod (m :: rest) name = if m.cmName == name then Just m else findMod rest name

-- | 优化 pass 节点：线性链（每个 pass 依赖前一个），key = `pass:<name>`。
export passNodesOf : List PassSpec -> List GraphNode
passNodesOf specs = passNodesGo Nothing specs

passNodesGo : Maybe String -> List PassSpec -> List GraphNode
passNodesGo _ [] = []
passNodesGo prev (spec :: rest) =
  let
    key = "pass:${spec.psName}"
  in GraphNode key (NodePass spec.psName) (prevDeps prev) 1 :: passNodesGo (Just key) rest

prevDeps : Maybe String -> List String
prevDeps Nothing = []
prevDeps (Just key) = [key]

-- | 依赖层：层内节点互不依赖，可并行；成环 / 空层显式错误（与 `Closure.topoLayers` 同口径）。
export graphLayers : List GraphNode -> Check (List (List GraphNode))
graphLayers nodes = topoLayers gnKey gnDeps nodes

-- | 节点的有效性判定：`Hit` = 对象库已有可用产物；`Recompute` = 需要重算。
-- 这是调度器与对象库之间唯一的契约；节点自身不保存状态。
export data NodeAction(..) : Type where
  NodeHit : NodeAction
  NodeRecompute : NodeAction

export record PlannedNode(..) where
  pnNode : GraphNode
  pnAction : NodeAction

-- | 按依赖层给出每个节点的动作；层内顺序保持输入顺序。`isHit` 由调用方提供
-- （接口对象存在 / clean 判定 / 已有 pass 产物），图本身不做 I/O。
export planLayers : (String -> Bool) -> List GraphNode -> Check (List (List PlannedNode))
planLayers isHit nodes =
  case topoLayers gnKey gnDeps nodes of
    ErrC e => ErrC e
    OkC layers => OkC (map (map (planNode isHit)) layers)

planNode : (String -> Bool) -> GraphNode -> PlannedNode
planNode isHit n = PlannedNode n (if isHit n.gnKey then NodeHit else NodeRecompute)

-- | 计划摘要：命中 / 重算节点数。
export planSummary : List (List PlannedNode) -> (Int, Int)
planSummary layers = planSummaryGo layers 0 0

planSummaryGo : List (List PlannedNode) -> Int -> Int -> (Int, Int)
planSummaryGo [] hits misses = (hits, misses)
planSummaryGo (layer :: rest) hits misses =
  planSummaryGo rest (hits + countHits layer) (misses + countMisses layer)

countHits : List PlannedNode -> Int
countHits [] = 0
countHits (p :: rest) = countHit p + countHits rest

countHit : PlannedNode -> Int
countHit (PlannedNode _ NodeHit) = 1
countHit (PlannedNode _ NodeRecompute) = 0

countMisses : List PlannedNode -> Int
countMisses [] = 0
countMisses (p :: rest) = countMiss p + countMisses rest

countMiss : PlannedNode -> Int
countMiss (PlannedNode _ NodeRecompute) = 1
countMiss (PlannedNode _ NodeHit) = 0

-- | 节点 / 边 / 外部缺口计数（观测用；不参与调度）。
export record GraphStats(..) where
  gsNodes : Int
  gsEdges : Int
  gsExternal : Int

export graphStats : List GraphNode -> GraphStats
graphStats nodes = GraphStats (length nodes) (sumDeps nodes) (countExternal nodes [])

sumDeps : List GraphNode -> Int
sumDeps [] = 0
sumDeps (n :: rest) = length n.gnDeps + sumDeps rest

countExternal : List GraphNode -> List String -> Int
countExternal [] _ = 0
countExternal (n :: rest) seen =
  countExternalDeps n.gnDeps seen + countExternal rest (append (map extKey n.gnDeps) seen)

countExternalDeps : List String -> List String -> Int
countExternalDeps [] _ = 0
countExternalDeps (d :: rest) seen =
  (if isExternalKey d && not (memName d seen) then 1 else 0) + countExternalDeps rest (d :: seen)

isExternalKey : String -> Bool
isExternalKey d = startsWith "ext:" d

extKey : String -> String
extKey d = d
