module Vuna.Compiler.Driver.Owner where

-- **声明归属表**——声明名 / 实例名 / 方法投影名 / 派生实例名
-- → 所属模块（入口声明归合成模块 `Main`）。
--
-- 归属不只服务 codegen 的逐单元切分，也服务
-- 模块级接口摘要（Driver.Iface 把 DtProgram 按模块切开）。两侧共用
-- 同一份推导，避免「Elab 生成的名字」与「归属表」各写一套、互相漂移。
--
-- 归属来源只有 Loader-resolved 的声明结构：声明名、`DInstance` 头（与 Elab 同一
-- `instanceSymbol` 实现）、`DData`/`DRecord` 的 deriving 实例名、`DTrait` 的方法投影名与
-- `Dict_<trait>`。推导不到的带点名字回落到「模块前缀必须是已知模块」，否则报错。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Base.Intrinsics
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Elab.Derive
import Vuna.Compiler.Elab.Driver
import Vuna.Compiler.Frontend.Rast.Bridge
import Vuna.Compiler.Elab.InstName
import Vuna.Compiler.Elab.Term
import Vuna.Compiler.Elab.Types

splitNoSpan : Span
splitNoSpan = Span "" 0 0 0 0 0 0

-- 入口单元的固定名（入口声明不带模块前缀，统一归到 `Main`）。
export entryOwner : String
entryOwner = "Main"

-- | 名字的模块前缀（`A.B.f` → `A.B`；无点时 `""`）；实现收敛到 `Source.prefixOfName`。
export modulePrefixOfName : String -> String
modulePrefixOfName name = prefixOfName name

-- ---------------------------------------------------------------
-- 归属表：声明名 / 实例名 / 方法投影名 → 模块；data / 字典 data → 模块
-- ---------------------------------------------------------------
export splitDeclNames : List Decl -> List String
splitDeclNames [] = []
splitDeclNames (d :: rest) =
  case d of
    DSig name ctx ty sp => name :: splitDeclNames rest
    DExtern name cName ty sp => name :: splitDeclNames rest
    DFun name pats body sp => name :: splitDeclNames rest
    DData name params kind ctors derivings viaField repr lin sp => name :: splitDeclNames rest
    DRecord name params fields derivings viaField repr lin sp => name :: splitDeclNames rest
    DTrait name params supers methods sp => name :: splitDeclNames rest
    _ => splitDeclNames rest

splitDataNames : List Decl -> List String
splitDataNames [] = []
splitDataNames (d :: rest) =
  case d of
    DData name params kind ctors derivings viaField repr lin sp => name :: splitDataNames rest
    DRecord name params fields derivings viaField repr lin sp => name :: splitDataNames rest
    _ => splitDataNames rest

headClassName : Expr -> Maybe String
headClassName (EApp fn args _) =
  case fn of
    EVar n _ => Just n
    _ => Nothing
headClassName (EVar n _) = Just n
headClassName _ = Nothing

-- 实例符号与派生实例符号用 Elab 的同一实现（`Elab.instanceSymbol` / `Elab.instHead`），
-- 不再复制命名逻辑：Elab 生成的 `DtDef` 名字与本表逐字一致。
splitInstanceOwnerOf : String -> Decl -> List (String, String)
splitInstanceOwnerOf owner (DInstance ctxE headExpr methods sp) =
  case headClassName headExpr of
    Just c => [(instanceSymbol c (toRastExpr headExpr), owner)]
    Nothing => []
splitInstanceOwnerOf owner (DData dname params kind ctors derivings viaField repr lin sp) =
  splitDerivedOwners owner dname params derivings
splitInstanceOwnerOf owner (DRecord dname params fields derivings viaField repr lin sp) =
  append
    (splitDerivedOwners owner dname params derivings)
    (splitHasFieldOwners owner dname params fields)
splitInstanceOwnerOf owner _ = []

hasFieldRecordTypeExpr : String -> List String -> Expr
hasFieldRecordTypeExpr dname [] = EVar dname (detachedNodeRef splitNoSpan)
hasFieldRecordTypeExpr dname params =
  EApp
    (EVar dname (detachedNodeRef splitNoSpan))
    (map (\p => EVar p (detachedNodeRef splitNoSpan)) params)
    (detachedNodeRef splitNoSpan)

hasFieldOwnerOf : String -> String -> List String -> Field -> (String, String)
hasFieldOwnerOf owner dname params f =
  let
    fname = fieldName f
    fty = fieldType f
    label =
      EApp
        (EVar hasFieldLabelName (detachedNodeRef splitNoSpan))
        [EStr fname (detachedNodeRef splitNoSpan)]
        (detachedNodeRef splitNoSpan)
    head =
      EApp
        (EVar hasFieldTraitName (detachedNodeRef splitNoSpan))
        [label, hasFieldRecordTypeExpr dname params, fty]
        (detachedNodeRef splitNoSpan)
  in (instanceSymbol hasFieldTraitName (toRastExpr head), owner)

splitHasFieldOwners : String -> String -> List String -> List Field -> List (String, String)
splitHasFieldOwners owner dname params [] = []
splitHasFieldOwners owner dname params (f :: rest) =
  hasFieldOwnerOf owner dname params f :: splitHasFieldOwners owner dname params rest

splitDerivedOwners : String -> String -> List String -> List String -> List (String, String)
splitDerivedOwners owner dname params [] = []
splitDerivedOwners owner dname params (t :: rest) =
  (instanceSymbol t (instHead t dname params splitNoSpan), owner)
    :: splitDerivedOwners owner dname params rest

-- trait 的运行时产物不在顶层声明名里：方法投影定义与字典类型都由 Elab 生成，
-- 因此按 `DTrait` 结构显式补上（入口 trait 没有模块前缀，这一步是唯一归属来源）。
splitTraitDefOwnerOf : String -> Decl -> List (String, String)
splitTraitDefOwnerOf owner (DTrait tname params supers methods sp) =
  map (\m => (traitMethodName m, owner)) methods
splitTraitDefOwnerOf owner _ = []

splitTraitDataOwnerOf : String -> Decl -> List (String, String)
splitTraitDataOwnerOf owner (DTrait tname params supers methods sp) = [("Dict_${tname}", owner)]
splitTraitDataOwnerOf owner _ = []

splitInstanceOwnersGo : String -> List Decl -> List (String, String)
splitInstanceOwnersGo owner [] = []
splitInstanceOwnersGo owner (d :: rest) =
  append (splitInstanceOwnerOf owner d) (splitInstanceOwnersGo owner rest)

export splitOwnerEntriesOf : String -> List Decl -> List (String, String)
splitOwnerEntriesOf owner decls =
  append
    (map (\n => (n, owner)) (splitDeclNames decls))
    (append (splitInstanceOwnersGo owner decls) (concatMap (splitTraitDefOwnerOf owner) decls))

export splitDataOwnerEntriesOf : String -> List Decl -> List (String, String)
splitDataOwnerEntriesOf owner decls =
  append
    (map (\n => (n, owner)) (splitDataNames decls))
    (concatMap (splitTraitDataOwnerOf owner) decls)

export splitOwnerEntriesOfModules : List (String, List Decl) -> List (String, String)
splitOwnerEntriesOfModules [] = []
splitOwnerEntriesOfModules ((mname, decls) :: rest) =
  append (splitOwnerEntriesOf mname decls) (splitOwnerEntriesOfModules rest)

export splitDataOwnerEntriesOfModules : List (String, List Decl) -> List (String, String)
splitDataOwnerEntriesOfModules [] = []
splitDataOwnerEntriesOfModules ((mname, decls) :: rest) =
  append (splitDataOwnerEntriesOf mname decls) (splitDataOwnerEntriesOfModules rest)

export record SplitMeta(..) where
  smDefOwners : List (String, String)
  smDataOwners : List (String, String)
  smKnownModules : List String
  -- 同一份归属表的哈希索引。清单保留给 `Driver.Iface.ownerIndexOf`（它按
  -- `Base.Container.HashMap.fromList` 建自己的表），但 codegen 侧逐 def/data 查归属不用线性扫清单
  -- （那是 O(#def × #owner-pairs)）。
  smDefOwnerT : HashMap String String
  smDataOwnerT : HashMap String String

export splitMetaOf : List (String, List Decl) -> List Decl -> SplitMeta
splitMetaOf modules entryDecls =
  let
    knownModules = map (\p => firstOf p) modules
    defOwners =
      append (splitOwnerEntriesOfModules modules) (splitOwnerEntriesOf entryOwner entryDecls)
    dataOwners =
      append
        (splitDataOwnerEntriesOfModules modules)
        (splitDataOwnerEntriesOf entryOwner entryDecls)
  in SplitMeta
    defOwners
    dataOwners
    knownModules
    (HashMap.fromList defOwners)
    (HashMap.fromList dataOwners)

export lookupModuleOf : List (String, String) -> String -> Maybe String
lookupModuleOf pairs name = lookupPair name pairs

export knownModuleOrErr : List String -> String -> String -> Check String
knownModuleOrErr knownModules what name =
  let
    prefix = modulePrefixOfName name
  in if memName prefix knownModules then
    OkC prefix
  else
    icInternal "DT split: `${what}` ${name} has module prefix `${prefix}` but no such module"

export splitDataOwnerOf : SplitMeta -> DtData -> Check String
splitDataOwnerOf meta d =
  case HashMap.lookup (dtDataName d) meta.smDataOwnerT of
    Just o => OkC o
    Nothing =>
      if containsDot (dtDataName d) then
        knownModuleOrErr meta.smKnownModules "data" (dtDataName d)
      else
        icInternal "DT split: cannot determine module for data `${dtDataName d}`"

-- Elab 收尾合成的内部名字（`@vuna@` 前缀，如 `@vuna@main_show`）不属于任何源
-- 模块、也没有模块前缀；它们由入口收尾阶段产生，归入口单元 `Main`。
-- 只放行这一族名字：普通无前缀定义仍按「无法确定模块」报错（不静默归到入口）。
isSyntheticInternalName : String -> Bool
isSyntheticInternalName name = name == mainShowDefName || startsWith "@vuna@" name

export splitDefOwnerOf : SplitMeta -> String -> Check String
splitDefOwnerOf meta name =
  case HashMap.lookup name meta.smDefOwnerT of
    Just o => OkC o
    Nothing =>
      if containsDot name then
        knownModuleOrErr meta.smKnownModules "definition" name
      else if isSyntheticInternalName name then
        OkC entryOwner
      else
        icInternal "DT split: cannot determine module for definition `${name}`"

export nameOwnerPairsOfDefs : SplitMeta -> List DtDef -> Check (List (String, String))
nameOwnerPairsOfDefs meta [] = OkC []
nameOwnerPairsOfDefs meta (d :: rest) =
  Vuna.Compiler.Base.Common.bind
    (splitDefOwnerOf meta (dtDefName d))
    (\o => Vuna.Compiler.Base.Common.bind (nameOwnerPairsOfDefs meta rest) (\ps => OkC ((dtDefName d, o) :: ps)))

export nameOwnerPairsOfDatas : SplitMeta -> List DtData -> Check (List (String, String))
nameOwnerPairsOfDatas meta [] = OkC []
nameOwnerPairsOfDatas meta (d :: rest) =
  Vuna.Compiler.Base.Common.bind
    (splitDataOwnerOf meta d)
    (\o => Vuna.Compiler.Base.Common.bind (nameOwnerPairsOfDatas meta rest) (\ps => OkC ((dtDataName d, o) :: ps)))
