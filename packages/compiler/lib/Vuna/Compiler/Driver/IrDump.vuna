module Vuna.Compiler.Driver.IrDump where

-- `vuna dev ir dump`：检查 + lowering 后输出确定性 IR 调试文本。
-- 只服务工具链/调试，不写产物，也不进 seed。
import Base.Effect.Types as EffTypes
import Base.Data.Pair as Pair
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Codegen.Ocaml.Render
import Vuna.Compiler.Codegen.Term
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Ir.Cps
import Vuna.Compiler.Ir.Model
import Vuna.Compiler.Ir.Render
import Vuna.Compiler.Lowering.Program
import Base.Effect.Fs as EffFs
import Base.Effect.Env as EffEnv
import Base.Effect.Process as EffProcess

export dumpIr : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> PackageContext -> String -> Eff r (Check String)
dumpIr after ctx entry = do
  checked <- dtCheckWithProgramParts ctx entry
  pure (case checked of
    ErrC e => ErrC e
    OkC pair =>
      let
        pkg = secondOf pair
      in case lowerProgramOf pkg.checkedProgram.dtProgDatas pkg.checkedProgram.dtProgDefs of
        ErrC e => ErrC e
        OkC program => dumpAfter after program
  )

dumpAfter : String -> IrProgram -> Check String
dumpAfter "cps" program = dumpCps program
dumpAfter "machine" program = dumpMachine program
dumpAfter "ocaml" program = dumpOcaml program
dumpAfter _ program = OkC (renderProgram program)

-- | OCaml 后端视图：类型声明 + 每个顶层的 `name = <渲染后的 OTerm>`。
-- 名字编码与前缀是完整的（`v_` / `C_` / `f_`），check 路径的 `noQual` 因此不写跨单元限定。
dumpOcaml : IrProgram -> Check String
dumpOcaml program =
  let
    unit = program.irProgUnit
    st = mkGenStWith (\p => p) noQual program.irProgShared
    types = irTypeDeclsText noQual unit.irUnitTyDecls
  in case genGroups st unit.irUnitGroups of
    ErrC e => OkC ("OCAML ERROR: " ++ diagText e)
    OkC (Pair bodies _) => OkC (types ++ joinWith "\n\n" bodies)

dumpMachine : IrProgram -> Check String
dumpMachine program =
  let
    defs = concatMap irGroupDefs program.irProgUnit.irUnitGroups
  in case cpsDefsMachine defs of
    Err msg => OkC ("MACHINE ERROR: " ++ msg)
    Ok ds => OkC (renderDefs ds)

dumpCps : IrProgram -> Check String
dumpCps program = case cpsUnit program.irProgUnit of
  Err msg => OkC ("CPS ERROR: " ++ msg)
  Ok u1 =>
    let
      shared = program.irProgShared
    in OkC (renderProgram (IrProgram shared u1))
