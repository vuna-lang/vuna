module Vuna.Compiler.Driver.SplitGen where

-- 逐模块 split 生成（`compile` / `build` / `seed` 的唯一输出模型）。
--
-- 把同一份精化结果按「声明归属」切到各模块文件。每个单元只 `open Vuna_runtime`，
-- 跨单元引用（值 / 构造子 / 类型）由 `Target.Ocaml.Decl` / `Target.Ocaml.Term` 生成
-- `Unit.name` 全限定名；每个 `SplitFile` 因此带一张**直接依赖单元**表（实际引用到的
-- 单元，由 `Target.Ocaml.Assembly.UnitParts` 累积），文件顺序仍是拓扑序但编译不再依赖
-- open 链 —— 依赖图是精确 DAG，可分层/并行编译。
-- 装配（prepare / 类型 / 桥接 / 正文 / main 钩子）全部由 `Target.Ocaml.Assembly` 提供，
-- 本模块只做「归属表 + 按归属过滤 + 分文件 + 依赖序校验」。
--
-- 归属表**只从 Loader-resolved 的声明结构派生**（声明名、实例名、派生实例名、trait
-- 方法投影名与 `Dict_<trait>`）；没有按字符串前缀猜归属的表。
-- 推导不到的带点名字回落到「模块前缀必须是已知模块」，否则报错。
import Vuna.Compiler.Base.Common
import Base.Effect.Types as EffTypes
import Base.Container.HashMap as HashMap
import Base.Data.String as String
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Driver.Owner
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Base.Diagnostics
import Vuna.Target.Ocaml.Assembly
import Vuna.Target.Ocaml.Decl
import Vuna.Compiler.Lowering.Program
import Vuna.Ir.Model
import Vuna.Ir.Direct as Direct
import Vuna.Target.Ocaml.Term
import Vuna.Compiler.Elab.Driver
import Vuna.Compiler.Elab.Term
import Vuna.Compiler.Elab.Types

-- 单元名同时是 seed 文件名与跨单元引用前缀，所以只取模块路径的**包内部分**：
--   Vuna.Target.Native.Abi → Native_dAbi
--   Base.Data.List           → B_dData_dList
-- 剥前缀只是命名策略，归属推导仍用完整模块名（`SplitMeta` 的表）；重名由
-- `checkUniqueUnits` 在生成前报错。
splitUnitOfModule : String -> String
splitUnitOfModule modName = sanitizeName (unitPathOf modName)

compilerPkgPrefix : String
compilerPkgPrefix = "Vuna.Compiler."

basePkgPrefix : String
basePkgPrefix = "Base."

unitPathOf : String -> String
unitPathOf m =
  if startsWith compilerPkgPrefix m then
    strSubstring (strLength compilerPkgPrefix) (strLength m - strLength compilerPkgPrefix) m
  else if startsWith basePkgPrefix m then
    "B.${strSubstring (strLength basePkgPrefix) (strLength m - strLength basePkgPrefix) m}"
  else
    m

-- 定义名 → 所属单元（位置表的键是「单元.值名」，与运行时回栈帧名一致：
-- 定义名带模块前缀，入口声明是裸名、归 `Main`）。
unitOfLocName : String -> String
unitOfLocName name =
  let
    p = modulePrefixOfName name
  in if p == "" then splitUnitOfModule entryOwner else splitUnitOfModule p

-- 入口单元在定义求值**之前**就开启回栈记录（零参 `main` 在模块初始化期求值，
-- 早于 main 钩子的 try；初始化异常靠当时已开启的回栈打印 vuna 位置帧）。
mainInitPrologue : String
mainInitPrologue = "open Vuna_runtime\nlet () = dt_record_backtrace true\n"

-- ---------------------------------------------------------------
-- 按归属过滤 + 生成
-- ---------------------------------------------------------------
-- 名字 → 归属单元的哈希索引。对**每个**模块把全部 def/data 逐个线性扫 pairs 是
-- O(#模块 × #def × #pairs)，大包上就是几秒。
ownerTblOf : List (String, String) -> HashMap String String
ownerTblOf pairs = HashMap.insertAll pairs (HashMap.fromList [])

-- 归属 → 本单元的定义（保持程序顺序）。逐单元分组与 lowering 都直接取桶：
-- 原来每个单元对全体 def/data 各过滤一遍是 O(单元数 × 定义数)，大包上就是几百万次查表。
-- 桶在 `reverse` 后的列表上做前插，取出来的顺序与原程序顺序一致。
defBucketsOf : HashMap String String -> List DtDef -> HashMap String (List DtDef)
defBucketsOf ownerT defs = defBucketsGo ownerT (reverse defs) (HashMap.fromList [])

defBucketsGo : HashMap String String -> List DtDef -> HashMap String (List DtDef) -> HashMap String (List DtDef)
defBucketsGo ownerT [] acc = acc
defBucketsGo ownerT (d :: rest) acc =
  let
    owner =
      case HashMap.lookup (dtDefName d) ownerT of
        Just o => o
        Nothing => ""
    bucket =
      case HashMap.lookup owner acc of
        Just ds => ds
        Nothing => []
  in defBucketsGo ownerT rest (HashMap.insert owner (d :: bucket) acc)

dataBucketsOf : HashMap String String -> List DtData -> HashMap String (List DtData)
dataBucketsOf ownerT datas = dataBucketsGo ownerT (reverse datas) (HashMap.fromList [])

dataBucketsGo : HashMap String String -> List DtData -> HashMap String (List DtData) -> HashMap String (List DtData)
dataBucketsGo ownerT [] acc = acc
dataBucketsGo ownerT (d :: rest) acc =
  let
    owner =
      case HashMap.lookup (dtDataName d) ownerT of
        Just o => o
        Nothing => ""
    bucket =
      case HashMap.lookup owner acc of
        Just ds => ds
        Nothing => []
  in dataBucketsGo ownerT rest (HashMap.insert owner (d :: bucket) acc)

-- ---------------------------------------------------------------
-- 依赖：每单元的直接依赖必须都是本次程序的已知单元（`runtime` / 模块 / 入口）。
-- 生成器累积的依赖来自**实际引用**（`QualCtx` 限定 / 类型声明 / List 桥接 / main
-- 钩子）；它们不保证落在 import 序的后面（类型声明里的族名引用不要求 import），
-- 所以位置不在这里比 —— 最终顺序由 `Split.canonicalTopo` 按实际依赖图重算。
-- ---------------------------------------------------------------
-- 依赖只校验**成员**：必须是本次程序的已知单元。位置不在这里比：`modules` 是 import
-- 图的拓扑序，而 codegen 的真实引用可以跨过它（类型声明里的族名引用不要求 import），
-- 最终文件顺序由 `Split.canonicalTopo` 按**实际依赖图**重算。真实环由
-- `checkSplitAcyclic` 在返回文件集前报。
knownUnit : List String -> String -> Bool
knownUnit units u = memName u units

checkDepsKnown : List String -> String -> List String -> Check Int
checkDepsKnown known self [] = OkC 0
checkDepsKnown known self (d :: rest) =
  if not (knownUnit known d) then
    icInternal "${self} references unknown unit `${d}`"
  else if not (knownUnit known self) then
    icInternal "split unit `${self}` is not in the module order"
  else
    checkDepsKnown known self rest

-- 依赖按模块顺序排列并去重（同单元自引用丢弃）；最终顺序仍是 `canonicalTopo` 的事。
depsInOrder : List String -> String -> List String -> List String
depsInOrder ordered self deps = filter (\u => not (u == self) && memName u deps) ordered

unitDepsOf : List String -> String -> List String -> Check (List String)
unitDepsOf ordered self deps =
  Vuna.Compiler.Base.Common.bind
    (checkDepsKnown ordered self deps)
    (\_ => OkC (depsInOrder ordered self deps))

-- ---------------------------------------------------------------
-- 依赖环
-- ---------------------------------------------------------------
-- 单元名即文件名：两个模块撞名会写到同一个 `.ml` 并互相覆盖，必须在返回文件集前报错。
uniqueSplitNames : List SplitFile -> List String -> Bool
uniqueSplitNames [] seen = True
uniqueSplitNames ((SplitFile name _ _) :: rest) seen =
  if memName name seen then False else uniqueSplitNames rest (name :: seen)

checkSplitNames : List SplitFile -> Check Int
checkSplitNames files =
  if uniqueSplitNames files [] then
    OkC 0
  else
    icInternal "split unit name collides with another module (codegen unit naming)"

-- 实际依赖图必须无环：`canonicalTopo` 用迭代松弛算层，环会让层号永远增长、停在燃料
-- 上界并给出错误的“拓扑序”（build.sh 的分层与链接顺序随之失效）。判定直接复用深度
-- 松弛：DAG 上不超过 n 轮就收敛。
checkSplitAcyclic : List SplitFile -> Check Int
checkSplitAcyclic files =
  if splitGraphAcyclic files then
    OkC 0
  else
    icInternal "split dependency graph has a cycle (unit order is not a DAG)"

-- 分文件生成的共享上下文（归属表一次建好，所有单元复用）。
record SplitGenCtx where
  -- Lowering 环境（程序级表 + 当前单元名；每单元用 `lwEnvWithUnit` 换单元）。
  sgcEnv : LwEnv
  sgcAllDefs : List DtDef
  sgcDefOwnerT : HashMap String String
  sgcDataOwnerT : HashMap String String
  sgcDefUnitT : HashMap String String
  sgcDataUnitT : HashMap String String
  sgcOrdered : List String
  -- 归属 → 定义 / 数据（一次分桶，逐单元直接取）。
  sgcDefBuckets : HashMap String (List DtDef)
  sgcDataBuckets : HashMap String (List DtData)
  -- `#line` 路径归一（包相对）：与 `dt_def_locs` 位置表用同一函数（`splitLocPath`）。
  sgcNormPath : String -> String

defsOfUnit : SplitGenCtx -> String -> List DtDef
defsOfUnit ctx u =
  case HashMap.lookup u ctx.sgcDefBuckets of
    Just ds => ds
    Nothing => []

datasOfUnit : SplitGenCtx -> String -> List DtData
datasOfUnit ctx u =
  case HashMap.lookup u ctx.sgcDataBuckets of
    Just ds => ds
    Nothing => []

mapToUnit : List (String, String) -> List (String, String)
mapToUnit pairs = map (\q => (firstOf q, splitUnitOfModule (secondOf q))) pairs

-- ---------------------------------------------------------------
-- 生成前护栏：模块声明必须已 resolved、入口声明必须是裸名、归属必须全覆盖
-- ---------------------------------------------------------------
checkModuleDeclName : List String -> String -> String -> Check Int
checkModuleDeclName knownModules mname name =
  if containsDot name then
    if memName (modulePrefixOfName name) knownModules then
      OkC 0
    else
      icInternal
        "module ${mname} declares `${name}` whose module prefix `${modulePrefixOfName name}` is not a known module (codegen requires Loader-resolved decls)"
  else
    icInternal
      "module ${mname} has an unresolved declaration name `${name}` (codegen requires Loader-resolved decls)"

checkModuleDeclNames : List String -> String -> List String -> Check Int
checkModuleDeclNames knownModules mname [] = OkC 0
checkModuleDeclNames knownModules mname (n :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkModuleDeclName knownModules mname n)
    (\_ => checkModuleDeclNames knownModules mname rest)

checkModuleDecls : List String -> List (String, List Decl) -> Check Int
checkModuleDecls knownModules [] = OkC 0
checkModuleDecls knownModules ((mname, decls) :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkModuleDeclNames knownModules mname (splitDeclNames decls))
    (\_ => checkModuleDecls knownModules rest)

-- 入口的**声明身份**：签名/定义同名是正常形态（DSig + 多 clause DFun），所以只看
-- data/record/trait/sig 这些唯一标识；它们必须是裸名（入口没有模块前缀）。
-- `data T` 与值 `T` 同名是允许的（两个命名空间），因此身份带命名空间标签；
-- 只有同一命名空间内重名才是重复。
entryDeclIdentities : List Decl -> List (Bool, String)
entryDeclIdentities [] = []
entryDeclIdentities (d :: rest) =
  case d of
    DSig name ctx ty sp => (False, name) :: entryDeclIdentities rest
    DExtern name cName ty sp => (False, name) :: entryDeclIdentities rest
    DData name params kind ctors derivings viaField repr lin sp =>
      (True, name) :: entryDeclIdentities rest
    DRecord name params fields derivings viaField repr lin sp =>
      (True, name) :: entryDeclIdentities rest
    DTrait name params supers methods sp => (True, name) :: entryDeclIdentities rest
    _ => entryDeclIdentities rest

entryDeclKey : (Bool, String) -> String
entryDeclKey (True, name) = "type\t${name}"
entryDeclKey (False, name) = "value\t${name}"

checkEntryDeclName : List String -> (Bool, String) -> Check Int
checkEntryDeclName seen identity =
  let
    name = secondOf identity
    key = entryDeclKey identity
  in if name == "" then
    icInternal "entry declaration has an empty name"
  else if containsDot name then
    icInternal
      "entry declaration `${name}` must not contain a module prefix (codegen requires Loader-resolved decls)"
  else if memName key seen then icInternal "duplicate entry declaration `${name}`" else OkC 0

checkEntryDeclsGo : List String -> List (Bool, String) -> Check Int
checkEntryDeclsGo seen [] = OkC 0
checkEntryDeclsGo seen (n :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkEntryDeclName seen n)
    (\_ => checkEntryDeclsGo (entryDeclKey n :: seen) rest)

checkEntryDecls : List Decl -> Check Int
checkEntryDecls decls = checkEntryDeclsGo [] (entryDeclIdentities decls)

-- 每个 runtime `DtDef` / `DtData` 都必须有归属（查表命中或带点名字命中已知模块），
-- 在生成前失败并带名字，而不是静默丢定义。
checkDefOwners : SplitMeta -> List DtDef -> Check Int
checkDefOwners meta [] = OkC 0
checkDefOwners meta (d :: rest) =
  Vuna.Compiler.Base.Common.bind
    (splitDefOwnerOf meta (dtDefName d))
    (\_ => checkDefOwners meta rest)

checkDataOwners : SplitMeta -> List DtData -> Check Int
checkDataOwners meta [] = OkC 0
checkDataOwners meta (d :: rest) =
  Vuna.Compiler.Base.Common.bind (splitDataOwnerOf meta d) (\_ => checkDataOwners meta rest)

checkResolvedModules : SplitMeta -> List (String, List Decl) -> List Decl -> List DtDef -> List DtData -> Check Int
checkResolvedModules meta modules entryDecls runtime datas =
  Vuna.Compiler.Base.Common.bind
    (checkModuleDecls meta.smKnownModules modules)
    (\_ => Vuna.Compiler.Base.Common.bind (checkEntryDecls entryDecls) (\_ => Vuna.Compiler.Base.Common.bind (checkDefOwners meta runtime) (\_ => checkDataOwners meta datas)))

-- ---------------------------------------------------------------
-- 定义位置表（Vuna_runtime.ml 的 dt_def_locs）的路径归一
-- ---------------------------------------------------------------
-- 定义 span 里的路径是解析时的原样：模块文件是 `<rootDir>/<模块路径>.vuna` 的绝对
-- 路径，入口可能是绝对 `<contextDir>/app/Main.vuna` 或调用方给的相对路径。位置表按
-- 「模块根 → 包目录 → 前导 ./」顺序尽量剥成短路径；都不匹配则保留原样。
splitStripPrefix : String -> String -> String
splitStripPrefix = stripPathPrefix

splitStripRoots : List String -> String -> String
splitStripRoots = stripRootsPath

splitStripDotSlash : String -> String
splitStripDotSlash = stripDotSlashPath

splitLocPath : List String -> String -> String -> String
splitLocPath roots contextDir path = locationPathUnder roots contextDir path

-- roots 是模块根目录（`PackageContext.contextRoots` 的 rootDir），contextDir 是包目录
-- （`PackageContext.contextDir`）；生成位置表用它把 span 路径归一。
-- 纯生成逻辑（归属表、分文件、依赖序校验）保持纯函数。
-- | 已保留单元的文本是否引用某个 runtime helper（按标识符子串判定）。
helperInText : String -> List String -> Bool
helperInText name [] = False
helperInText name (t :: rest) = String.contains name t || helperInText name rest

helperInTexts : List String -> List String -> Bool
helperInTexts [] texts = False
helperInTexts (n :: rest) texts = helperInText n texts || helperInTexts rest texts

-- | runtime 的数据 helper 按**已保留单元**的引用追加（剪枝在装配末尾完成）；
-- 纯数值程序因此不带字符串 / 数组 / 字节缓冲 helper。
dtRuntimeFor : IrShared -> Bool -> List String -> String
dtRuntimeFor shared entryIsAction keptTexts =
  dtRuntimeWith
    shared.irSharedUsesFloat
    shared.irSharedUsesTrace
    shared.irSharedUsesObs
    shared.irSharedUsesHost
    (shared.irSharedUsesSched || entryIsAction)
    (shared.irSharedUsesEff || entryIsAction)
    (helperInTexts dtStrHelperNames keptTexts)
    (helperInTexts dtArrHelperNames keptTexts)
    (helperInTexts dtBufHelperNames keptTexts)

-- | 入口是否是动作（`Eff r a`）。调度器 runtime 的装配用它。
entryIsActionM : Maybe IrEntry -> Bool
entryIsActionM Nothing = False
entryIsActionM (Just ent) = irEntryIsActionOf ent

export generateDtSplitProgram : {r : Row} -> List (String, List Decl) -> List Decl -> DtProgram -> Bool -> List String -> String -> List (String, String, Int) -> Eff r (Check (List SplitFile))
generateDtSplitProgram modules entryDecls prog printResult roots contextDir extraDefLocs =
  case eraseDefs (dtProgDefs prog) of
    ErrC e => pure (ErrC e)
    OkC allDefs =>
      case lowerEntryOf allDefs of
        ErrC e => pure (ErrC e)
        OkC entryM =>
          let
            -- 动作入口的钩子引用 `dtp_sched_main` 与效应机器，所以即使程序没用
            -- `Base.EffSched` 也要追加调度器 / 效应 runtime；纯值入口不需要。
            entryIsAction = entryIsActionM entryM
            -- 把「精化完成 → 装配开始」之间的构建独有开销分段；stamp 关闭时只花一次分支。
            _ = log! "info" "cg-splitstart"
            allDatas = rtDatasOf (dtProgDatas prog)
            runtimeDefs = partitionRuntimeDefs allDefs
            env =
              mkLwEnvFromErased
                (dtProgDatas prog)
                allDefs
                (dtProgDefs prog)
                (dtProgGlobals prog)
                (splitUnitOfModule entryOwner)
            shared = lwEnvShared env
            meta = splitMetaOf modules entryDecls
            _ = log! "info" "cg-splitmeta-done"
            -- 位置表：Lowering 已算好本程序的运行时定义行；增量路径复用模块的额外行在这里合并
            -- （`extraDefLocs` 来自接口的 `miDefLocs`，落盘前统一排序，全量/增量一致）。
            locRows = append shared.irSharedDefLocs extraDefLocs
            _ = log! "info" "cg-deflocs-done"
          in splitProgramFiles
            env
            modules
            entryDecls
            printResult
            runtimeDefs
            allDatas
            meta
            (splitLocPath roots contextDir)
            shared
            entryIsAction
            locRows

splitProgramFiles : {r : Row} -> LwEnv -> List (String, List Decl) -> List Decl -> Bool -> List DtDef -> List DtData -> SplitMeta -> (String -> String) -> IrShared -> Bool -> List (String, String, Int) -> Eff r (Check (List SplitFile))
splitProgramFiles env modules entryDecls printResult runtimeDefs allDatas meta normPath shared entryIsAction locRows =
  case checkProgramOf env of
    ErrC e => pure (ErrC e)
    OkC _ =>
      splitProgramChecked
        env
        modules
        entryDecls
        printResult
        runtimeDefs
        allDatas
        meta
        normPath
        shared
        entryIsAction
        locRows

splitProgramChecked : {r : Row} -> LwEnv -> List (String, List Decl) -> List Decl -> Bool -> List DtDef -> List DtData -> SplitMeta -> (String -> String) -> IrShared -> Bool -> List (String, String, Int) -> Eff r (Check (List SplitFile))
splitProgramChecked env modules entryDecls printResult runtimeDefs allDatas meta normPath shared entryIsAction locRows =
  case checkResolvedModules meta modules entryDecls runtimeDefs allDatas of
    ErrC e => pure (ErrC e)
    OkC _ =>
      case nameOwnerPairsOfDefs meta runtimeDefs of
        ErrC e => pure (ErrC e)
        OkC defPairs =>
          case nameOwnerPairsOfDatas meta allDatas of
            ErrC e => pure (ErrC e)
            OkC dataPairs =>
              splitWithOwners
                env
                modules
                printResult
                allDatas
                runtimeDefs
                defPairs
                dataPairs
                normPath
                shared
                entryIsAction
                locRows

splitWithOwners : {r : Row} -> LwEnv -> List (String, List Decl) -> Bool -> List DtData -> List DtDef -> List (String, String) -> List (String, String) -> (String -> String) -> IrShared -> Bool -> List (String, String, Int) -> Eff r (Check (List SplitFile))
splitWithOwners env modules printResult allDatas allDefs defPairs dataPairs normPath shared entryIsAction locRows =
  let
    defOwnerT = ownerTblOf defPairs
    dataOwnerT = ownerTblOf dataPairs
    defUnitT = unitTblOf (mapToUnit defPairs)
    dataUnitT = unitTblOf (mapToUnit dataPairs)
    ordered =
      append
        (append [runtimeUnit, deflocsUnit] (map (\q => splitUnitOfModule (firstOf q)) modules))
        [splitUnitOfModule entryOwner]
    ctx =
      SplitGenCtx
        env
        allDefs
        defOwnerT
        dataOwnerT
        defUnitT
        dataUnitT
        ordered
        (defBucketsOf defOwnerT allDefs)
        (dataBucketsOf dataOwnerT allDatas)
        normPath
  in do
    moduleFilesR <- splitModuleFiles ctx modules
    case moduleFilesR of
      ErrC e => pure (ErrC e)
      OkC moduleFiles =>
        do
          mainFileR <- splitMainFile ctx printResult
          pure (
              case mainFileR of
                ErrC e => ErrC e
                OkC mainFile =>
                  let
                    -- 只落盘入口可达的单元：不可达模块既不编译也不链接，产物的代码页
                    -- 与模块初始化都只支付真正用到的部分。
                    runtimeFile0 = SplitFile "${runtimeUnit}.ml" "" []
                    deflocsFile = SplitFile "${deflocsUnit}.ml" "" [runtimeUnit]
                    files0 = pruneSplitFiles [runtimeUnit, deflocsUnit, splitUnitOfFile mainFile] (runtimeFile0 :: deflocsFile :: append moduleFiles [mainFile])
                    keptUnits = map splitUnitOfFile files0
                    keptTexts = map splitText (filter (\f => not (splitUnitOfFile f == runtimeUnit || splitUnitOfFile f == deflocsUnit)) files0)
                    runtimeText = dtRuntimeFor shared entryIsAction keptTexts
                    -- 位置表只保留已落盘单元的定义：被剪掉的模块不会出现在回溯里。
                    keptLocRows = filter (\row => memName (unitOfLocName (firstOf row)) keptUnits) locRows
                    deflocsText = dtDefLocsUnit (dtDefLocTable normPath unitOfLocName keptLocRows)
                    files = map (\f => if splitUnitOfFile f == runtimeUnit then SplitFile (splitName f) runtimeText (splitDeps f) else if splitUnitOfFile f == deflocsUnit then SplitFile (splitName f) deflocsText (splitDeps f) else f) files0
                  in case checkSplitNames files of
                    ErrC e => ErrC e
                    OkC _ =>
                      case checkSplitAcyclic files of
                        ErrC e => ErrC e
                        OkC _ => OkC files
            )

-- 单模块：按归属过滤名字 → Lowering 出 `IrUnit` → 装配成文件。
splitModuleFiles : {r : Row} -> SplitGenCtx -> List (String, List Decl) -> Eff r (Check (List SplitFile))
splitModuleFiles ctx [] = pure (OkC [])
splitModuleFiles ctx ((mname, decls) :: rest) =
  let
    unit = splitUnitOfModule mname
    unitDatas = datasOfUnit ctx mname
    unitDefs = defsOfUnit ctx mname
    qc = QualCtx unit ctx.sgcDefUnitT ctx.sgcDataUnitT
    envU = lwEnvWithUnit unit ctx.sgcEnv
  in case lowerUnitCheckedFrom envU unitDatas unitDefs of
    ErrC e => pure (ErrC e)
    OkC unitIr0 =>
      let
        unitIr = Direct.directUnit (\_ => Nothing) unitIr0
      in case genUnitPartsWith ctx.sgcNormPath qc (lwEnvShared envU) unitIr of
        ErrC e => pure (ErrC e)
        OkC parts =>
          do
            tailR <- splitModuleFiles ctx rest
            case tailR of
              ErrC e => pure (ErrC e)
              OkC tail =>
                case unitDepsOf ctx.sgcOrdered unit (unitPartsDeps parts) of
                  ErrC e => pure (ErrC e)
                  OkC deps =>
                    let
                      sf = SplitFile "${unit}.ml" "${genUnitText parts}\n" deps
                    in pure (OkC (sf :: tail))

-- 入口文件：`Main` 单元正文 + main 钩子。
splitMainFile : {r : Row} -> SplitGenCtx -> Bool -> Eff r (Check SplitFile)
splitMainFile ctx printResult =
  let
    entryUnit = splitUnitOfModule entryOwner
    entryDefs = defsOfUnit ctx entryOwner
    entryDatas = datasOfUnit ctx entryOwner
    qc = QualCtx entryUnit ctx.sgcDefUnitT ctx.sgcDataUnitT
    envU = lwEnvWithUnit entryUnit ctx.sgcEnv
  in case lowerUnitCheckedFrom envU entryDatas entryDefs of
    ErrC e => pure (ErrC e)
    OkC unitIr0 =>
      let
        unitIr = Direct.directUnit (\_ => Nothing) unitIr0
      in case lowerEntryOf ctx.sgcAllDefs of
        ErrC e => pure (ErrC e)
        OkC entryM =>
          case entryM of
            Nothing => pure (cgErr0 NoMain)
            Just entryIr =>
              case genUnitPartsWith ctx.sgcNormPath qc (lwEnvShared envU) unitIr of
                ErrC e => pure (ErrC e)
                OkC parts =>
                  case genEntryHook (mkGenStWith ctx.sgcNormPath qc (lwEnvShared envU)) entryIr printResult of
                    ErrC e => pure (ErrC e)
                    OkC hook =>
                      case unitDepsOf ctx.sgcOrdered entryUnit (append (append (unitPartsDeps parts) (secondOf hook)) [deflocsUnit]) of
                        ErrC e => pure (ErrC e)
                        OkC deps =>
                          let
                            sf =
                              SplitFile
                                "Main.ml"
                                (mainInitPrologue ++ genUnitText parts ++ firstOf hook)
                                deps
                          in pure (OkC sf)
