module Vuna.Compiler.Driver.SplitGen where

-- 逐模块 split 生成（`compile` / `build` / `seed` 的唯一输出模型）。
--
-- 把同一份精化结果按「声明归属」切到各模块文件。每个单元只 `open Vuna_runtime`，
-- 跨单元引用（值 / 构造子 / 类型）由 `Codegen.Decl` / `Codegen.Term` 生成
-- `Unit.name` 全限定名；每个 `SplitFile` 因此带一张**直接依赖单元**表（实际引用到的
-- 单元，由 `Codegen.Assembly.UnitParts` 累积），文件顺序仍是拓扑序但编译不再依赖
-- open 链 —— 依赖图是精确 DAG，可分层/并行编译。
-- 装配（prepare / 类型 / 桥接 / 正文 / main 钩子）全部由 `Codegen.Assembly` 提供，
-- 本模块只做「归属表 + 按归属过滤 + 分文件 + 依赖序校验」。
--
-- 归属表**只从 Loader-resolved 的声明结构派生**（声明名、实例名、派生实例名、trait
-- 方法投影名与 `Dict_<trait>`）；没有按字符串前缀猜归属的表。
-- 推导不到的带点名字回落到「模块前缀必须是已知模块」，否则报错。
import Vuna.Compiler.Base.Common
import Base.Effect.EffTypes as EffTypes
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Driver.Owner
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Codegen.Assembly
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Lowering.Program
import Vuna.Compiler.Codegen.Term
import Vuna.Compiler.Elab.Driver
import Vuna.Compiler.Elab.Term
import Vuna.Compiler.Elab.Types

splitUnitOfModule : String -> String
splitUnitOfModule modName = sanitizeName modName

-- 入口单元在定义求值**之前**就开启回栈记录（零参 `main` 在模块初始化期求值，
-- 早于 main 钩子的 try；初始化异常靠当时已开启的回栈打印 vuna 位置帧）。
mainInitPrologue : String
mainInitPrologue = "let () = Printexc.record_backtrace true\n"

-- ---------------------------------------------------------------
-- 按归属过滤 + 生成
-- ---------------------------------------------------------------
-- 名字 → 归属单元的哈希索引。对**每个**模块把全部 def/data 逐个线性扫 pairs 是
-- O(#模块 × #def × #pairs)，大包上就是几秒。
ownerTblOf : List (Pair String String) -> HashMap String String
ownerTblOf pairs = HashMap.insertAll pairs (HashMap.fromList [])

ownerOfTbl : HashMap String String -> String -> String
ownerOfTbl t name = case HashMap.lookup name t of
  Just o => o
  Nothing => ""

datasInUnit : HashMap String String -> String -> List DtData -> List DtData
datasInUnit ownerT u datas = filter (\d => ownerOfTbl ownerT (dtDataName d) == u) datas

defsInUnit : HashMap String String -> String -> List DtDef -> List DtDef
defsInUnit ownerT u defs = filter (\d => ownerOfTbl ownerT (dtDefName d) == u) defs

-- ---------------------------------------------------------------
-- 依赖：每单元的直接依赖必须都是本次程序的已知单元（`runtime` / 模块 / 入口）。
-- 生成器累积的依赖来自**实际引用**（`QualCtx` 限定 / 类型声明 / List 桥接 / main
-- 钩子）；它们不保证落在 import 序的后面（类型声明里的族名引用不要求 import），
-- 所以位置不在这里比 —— 最终顺序由 `Split.canonicalTopo` 按实际依赖图重算。
-- ---------------------------------------------------------------
-- 依赖只校验**成员**：必须是本次程序的已知单元。位置不在这里比：`modules` 是 import
-- 图的拓扑序，而 codegen 的真实引用可以跨过它（类型声明里的族名引用不要求 import），
-- 最终文件顺序由 `Split.canonicalTopo` 按**实际依赖图**重算。真实环由
-- `checkSplitAcyclic` 在返回文件集前报。
knownUnit : List String -> String -> Bool
knownUnit units u = memName u units

checkDepsKnown : List String -> String -> List String -> Check Int
checkDepsKnown known self [] = OkC 0
checkDepsKnown known self (d :: rest) =
  if not (knownUnit known d) then icInternal "${self} references unknown unit `${d}`"
  else if not (knownUnit known self) then icInternal "split unit `${self}` is not in the module order"
  else checkDepsKnown known self rest

-- 依赖按模块顺序排列并去重（同单元自引用丢弃）；最终顺序仍是 `canonicalTopo` 的事。
depsInOrder : List String -> String -> List String -> List String
depsInOrder ordered self deps = filter (\u => not (u == self) && memName u deps) ordered

unitDepsOf : List String -> String -> List String -> Check (List String)
unitDepsOf ordered self deps =
  Vuna.Compiler.Base.Common.bind (checkDepsKnown ordered self deps)
    (\_ => OkC (depsInOrder ordered self deps))

-- ---------------------------------------------------------------
-- 缓存条目校验与依赖环
-- ---------------------------------------------------------------
-- 单元缓存按 `(单元名, 声明+import 链摘要)` 命中，载荷自带依赖表。依赖表是**生成时**
-- 程序的实际引用，read 侧还要过一道本程序的成员校验：旧 key 文件（模块集合变化）或
-- 载荷与当前程序不一致时回退重算，而不是把不存在的单元写进 build.sh 的依赖/stamp 表。
cachedUnitOk : List String -> String -> SplitFile -> Bool
cachedUnitOk known unit (SplitFile name _ deps) = name == "${unit}.ml" && depsKnown known deps

depsKnown : List String -> List String -> Bool
depsKnown known [] = True
depsKnown known (d :: rest) = if knownUnit known d then depsKnown known rest else False

-- | `Maybe` 缓存条目按当前程序校验后的可复用版本。
keepCached : List String -> String -> Maybe SplitFile -> Maybe SplitFile
keepCached known unit (Just sf) = if cachedUnitOk known unit sf then Just sf else Nothing
keepCached known unit Nothing = Nothing

-- 实际依赖图必须无环：`canonicalTopo` 用迭代松弛算层，环会让层号永远增长、停在燃料
-- 上界并给出错误的“拓扑序”（build.sh 的分层与链接顺序随之失效）。判定直接复用深度
-- 松弛：DAG 上不超过 n 轮就收敛。
checkSplitAcyclic : List SplitFile -> Check Int
checkSplitAcyclic files =
  if splitGraphAcyclic files then OkC 0
  else icInternal "split dependency graph has a cycle (unit order is not a DAG)"

-- 分文件生成的共享上下文（归属表一次建好，所有单元复用）。
record SplitGenCtx where
  -- Lowering 环境（程序级表 + 当前单元名；每单元用 `lwEnvWithUnit` 换单元）。
  sgcEnv : LwEnv
  sgcAllDatas : List DtData
  sgcAllDefs : List DtDef
  sgcDefOwnerT : HashMap String String
  sgcDataOwnerT : HashMap String String
  sgcDefUnitT : HashMap String String
  sgcDataUnitT : HashMap String String
  sgcOrdered : List String
  -- `#line` 路径归一（包相对）：与 `dt_def_locs` 位置表用同一函数（`splitLocPath`）。
  sgcNormPath : String -> String

mapToUnit : List (Pair String String) -> List (Pair String String)
mapToUnit pairs = map (\q => Pair (firstOf q) (splitUnitOfModule (secondOf q))) pairs

-- ---------------------------------------------------------------
-- 生成前护栏：模块声明必须已 resolved、入口声明必须是裸名、归属必须全覆盖
-- ---------------------------------------------------------------
checkModuleDeclName : List String -> String -> String -> Check Int
checkModuleDeclName knownModules mname name =
  if containsDot name then if memName (modulePrefixOfName name) knownModules then OkC 0
  else err
    "DT: internal: module ${mname} declares `${name}` whose module prefix `${modulePrefixOfName name}` is not a known module (codegen requires Loader-resolved decls)"
  else err
    "DT: internal: module ${mname} has an unresolved declaration name `${name}` (codegen requires Loader-resolved decls)"

checkModuleDeclNames : List String -> String -> List String -> Check Int
checkModuleDeclNames knownModules mname [] = OkC 0
checkModuleDeclNames knownModules mname (n :: rest) =
  Vuna.Compiler.Base.Common.bind (checkModuleDeclName knownModules mname n)
    (\_ => checkModuleDeclNames knownModules mname rest)

checkModuleDecls : List String -> List (Pair String (List Decl)) -> Check Int
checkModuleDecls knownModules [] = OkC 0
checkModuleDecls knownModules ((Pair mname decls) :: rest) =
  Vuna.Compiler.Base.Common.bind (checkModuleDeclNames knownModules mname (splitDeclNames decls))
    (\_ => checkModuleDecls knownModules rest)

-- 入口的**声明身份**：签名/定义同名是正常形态（DSig + 多 clause DFun），所以只看
-- data/record/trait/sig 这些唯一标识；它们必须是裸名（入口没有模块前缀）。
-- `data T` 与值 `T` 同名是允许的（两个命名空间），因此身份带命名空间标签；
-- 只有同一命名空间内重名才是重复。
entryDeclIdentities : List Decl -> List (Pair Bool String)
entryDeclIdentities [] = []
entryDeclIdentities (d :: rest) = case d of
  DSig name ctx ty sp => Pair False name :: entryDeclIdentities rest
  DExtern name cName ty sp => Pair False name :: entryDeclIdentities rest
  DData name params kind ctors derivings viaField repr lin sp =>
    Pair True name :: entryDeclIdentities rest
  DRecord name params fields derivings viaField repr lin sp =>
    Pair True name :: entryDeclIdentities rest
  DTrait name params supers methods sp => Pair True name :: entryDeclIdentities rest
  _ => entryDeclIdentities rest

entryDeclKey : Pair Bool String -> String
entryDeclKey (Pair True name) = "type\t${name}"
entryDeclKey (Pair False name) = "value\t${name}"

checkEntryDeclName : List String -> Pair Bool String -> Check Int
checkEntryDeclName seen identity =
  let
    name = secondOf identity
    key = entryDeclKey identity
  in if name == "" then icInternal "entry declaration has an empty name"
  else if containsDot name then err
    "DT: internal: entry declaration `${name}` must not contain a module prefix (codegen requires Loader-resolved decls)"
  else if memName key seen then icInternal "duplicate entry declaration `${name}`" else OkC 0

checkEntryDeclsGo : List String -> List (Pair Bool String) -> Check Int
checkEntryDeclsGo seen [] = OkC 0
checkEntryDeclsGo seen (n :: rest) =
  Vuna.Compiler.Base.Common.bind (checkEntryDeclName seen n)
    (\_ => checkEntryDeclsGo (entryDeclKey n :: seen) rest)

checkEntryDecls : List Decl -> Check Int
checkEntryDecls decls = checkEntryDeclsGo [] (entryDeclIdentities decls)

-- 每个 runtime `DtDef` / `DtData` 都必须有归属（查表命中或带点名字命中已知模块），
-- 在生成前失败并带名字，而不是静默丢定义。
checkDefOwners : SplitMeta -> List DtDef -> Check Int
checkDefOwners meta [] = OkC 0
checkDefOwners meta (d :: rest) =
  Vuna.Compiler.Base.Common.bind (splitDefOwnerOf meta (dtDefName d))
    (\_ => checkDefOwners meta rest)

checkDataOwners : SplitMeta -> List DtData -> Check Int
checkDataOwners meta [] = OkC 0
checkDataOwners meta (d :: rest) =
  Vuna.Compiler.Base.Common.bind (splitDataOwnerOf meta d) (\_ => checkDataOwners meta rest)

checkResolvedModules : SplitMeta -> List (Pair String (List Decl)) -> List Decl -> List DtDef -> List DtData -> Check Int
checkResolvedModules meta modules entryDecls runtime datas =
  Vuna.Compiler.Base.Common.bind (checkModuleDecls meta.smKnownModules modules)
    (\_ => Vuna.Compiler.Base.Common.bind (checkEntryDecls entryDecls) (\_ => Vuna.Compiler.Base.Common.bind (checkDefOwners meta runtime) (\_ => checkDataOwners meta datas)))

-- ---------------------------------------------------------------
-- 定义位置表（Vuna_runtime.ml 的 dt_def_locs）的路径归一
-- ---------------------------------------------------------------
-- 定义 span 里的路径是解析时的原样：模块文件是 `<rootDir>/<模块路径>.vuna` 的绝对
-- 路径，入口可能是绝对 `<contextDir>/app/Main.vuna` 或调用方给的相对路径。位置表按
-- 「模块根 → 包目录 → 前导 ./」顺序尽量剥成短路径；都不匹配则保留原样。
splitStripPrefix : String -> String -> String
splitStripPrefix prefix path =
  if prefix == "" then path
  else if startsWith "${prefix}/" path then strSubstring (strLength "${prefix}/") (strLength path - strLength "${prefix}/") path
  else path

splitStripRoots : List String -> String -> String
splitStripRoots [] path = path
splitStripRoots (root :: rest) path =
  if startsWith "${root}/" path then splitStripPrefix root path else splitStripRoots rest path

splitStripDotSlash : String -> String
splitStripDotSlash path =
  if startsWith "./" path then strSubstring 2 (strLength path - 2) path else path

splitLocPath : List String -> String -> String -> String
splitLocPath roots contextDir path =
  splitStripDotSlash (splitStripPrefix contextDir (splitStripRoots roots path))

-- roots 是模块根目录（`PackageContext.contextRoots` 的 rootDir），contextDir 是包目录
-- （`PackageContext.contextDir`）；生成位置表用它把 span 路径归一。
noUnitLookup : {r : Row} -> String -> Eff r (Maybe SplitFile)
noUnitLookup _ = pure Nothing

noUnitStore : {r : Row} -> String -> SplitFile -> Eff r Int
noUnitStore _ _ = pure 0

-- 单元缓存的 lookup/store 是宿主动作，生成外壳显式在 `Eff []` 里；
-- 纯生成逻辑（归属表、分文件、依赖序校验）保持纯函数。
export generateDtSplitProgram : {r : Row} -> List (Pair String (List Decl)) -> List Decl -> DtProgram -> Bool -> List String -> String -> List (Pair String (Pair String Int)) -> Eff r (Check (List SplitFile))
generateDtSplitProgram modules entryDecls prog printResult roots contextDir extraDefLocs =
  generateDtSplitProgramWith noUnitLookup noUnitStore modules entryDecls prog printResult roots
    contextDir extraDefLocs

-- 带**单元级缓存**的生成入口（`lookup` 按模块名，入口用 `__entry__`；
-- 命中即跳过该单元的 lowering + 文本生成，`store` 只对重新生成的单元调用）。
export generateDtSplitProgramWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> List (Pair String (List Decl)) -> List Decl -> DtProgram -> Bool -> List String -> String -> List (Pair String (Pair String Int)) -> Eff r (Check (List SplitFile))
generateDtSplitProgramWith lookup store modules entryDecls prog printResult roots contextDir extraDefLocs =
  let
    -- 把「精化完成 → 装配开始」之间的构建独有开销分段；stamp 关闭时只花一次分支。
    _ = dbg! "cg-splitstart"
    allDatas = rtDatasOf (dtProgDatas prog)
    allDefs = dtProgDefs prog
    runtimeDefs = partitionRuntimeDefs allDefs
    env = mkLwEnv (dtProgDatas prog) allDefs (splitUnitOfModule entryOwner)
    shared = lwEnvShared env
    meta = splitMetaOf modules entryDecls
    _ = dbg! "cg-splitmeta-done"
    -- 位置表：Lowering 已算好本程序的运行时定义行；增量路径复用模块的额外行在这里合并
    -- （`extraDefLocs` 来自接口的 `miDefLocs`，落盘前统一排序，全量/增量一致）。
    locRows = append shared.irSharedDefLocs extraDefLocs
    locTbl = dtDefLocTable (splitLocPath roots contextDir) locRows
    _ = dbg! "cg-deflocs-done"
    runtimeText =
      dtRuntimeWith locTbl shared.irSharedUsesFloat shared.irSharedUsesTrace shared.irSharedUsesObs
    _ = dbg! "cg-runtimeText-done"
  in splitProgramFilesWith lookup store env modules entryDecls printResult runtimeDefs allDatas meta
    (splitLocPath roots contextDir) runtimeText

splitProgramFilesWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> LwEnv -> List (Pair String (List Decl)) -> List Decl -> Bool -> List DtDef -> List DtData -> SplitMeta -> (String -> String) -> String -> Eff r (Check (List SplitFile))
splitProgramFilesWith lookup store env modules entryDecls printResult runtimeDefs allDatas meta normPath runtimeText = case checkProgramOf env of
  ErrC e => pure (ErrC e)
  OkC _ =>
    splitProgramCheckedWith lookup store env modules entryDecls printResult runtimeDefs allDatas
      meta normPath runtimeText

splitProgramCheckedWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> LwEnv -> List (Pair String (List Decl)) -> List Decl -> Bool -> List DtDef -> List DtData -> SplitMeta -> (String -> String) -> String -> Eff r (Check (List SplitFile))
splitProgramCheckedWith lookup store env modules entryDecls printResult runtimeDefs allDatas meta normPath runtimeText = case checkResolvedModules meta modules entryDecls runtimeDefs allDatas of
  ErrC e => pure (ErrC e)
  OkC _ => case nameOwnerPairsOfDefs meta runtimeDefs of
    ErrC e => pure (ErrC e)
    OkC defPairs => case nameOwnerPairsOfDatas meta allDatas of
      ErrC e => pure (ErrC e)
      OkC dataPairs =>
        splitWithOwnersWith lookup store env modules printResult allDatas runtimeDefs defPairs
          dataPairs normPath runtimeText

splitWithOwnersWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> LwEnv -> List (Pair String (List Decl)) -> Bool -> List DtData -> List DtDef -> List (Pair String String) -> List (Pair String String) -> (String -> String) -> String -> Eff r (Check (List SplitFile))
splitWithOwnersWith lookup store env modules printResult allDatas allDefs defPairs dataPairs normPath runtimeText =
  let
    defUnitT = unitTblOf (mapToUnit defPairs)
    dataUnitT = unitTblOf (mapToUnit dataPairs)
    ordered =
      append (append [runtimeUnit] (map (\q => splitUnitOfModule (firstOf q)) modules))
        [splitUnitOfModule entryOwner]
    ctx =
      SplitGenCtx env allDatas allDefs (ownerTblOf defPairs) (ownerTblOf dataPairs) defUnitT
        dataUnitT ordered normPath
  in do
    moduleFilesR <- splitModuleFilesWith lookup store ctx modules
    case moduleFilesR of
      ErrC e => pure (ErrC e)
      OkC moduleFiles => do
        mainFileR <- splitMainFileWith lookup store ctx printResult
        pure (case mainFileR of
          ErrC e => ErrC e
          OkC mainFile =>
            let
              files = SplitFile "Vuna_runtime.ml" runtimeText [] :: append moduleFiles [mainFile]
            in case checkSplitAcyclic files of
              ErrC e => ErrC e
              OkC _ => OkC files
        )

-- 单模块：按归属过滤名字 → Lowering 出 `IrUnit` → 装配成文件。
splitModuleFilesWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> SplitGenCtx -> List (Pair String (List Decl)) -> Eff r (Check (List SplitFile))
splitModuleFilesWith lookup store ctx [] = pure (OkC [])
splitModuleFilesWith lookup store ctx ((Pair mname decls) :: rest) =
  let
    unit = splitUnitOfModule mname
  in do
    cached0 <- lookup mname
    let
      cached = keepCached ctx.sgcOrdered unit cached0
    in case cached of
      Just cachedFile => do
        tailR <- splitModuleFilesWith lookup store ctx rest
        pure (case tailR of
          ErrC e => ErrC e
          OkC tail => OkC (cachedFile :: tail)
        )
      Nothing =>
        let
          unitDatas = datasInUnit ctx.sgcDataOwnerT mname ctx.sgcAllDatas
          unitDefs = defsInUnit ctx.sgcDefOwnerT mname ctx.sgcAllDefs
          qc = QualCtx unit ctx.sgcDefUnitT ctx.sgcDataUnitT
          envU = lwEnvWithUnit unit ctx.sgcEnv
        in case lowerUnitChecked envU (map dtDefName unitDefs) (map dtDataName unitDatas) of
          ErrC e => pure (ErrC e)
          OkC unitIr => case genUnitPartsWith ctx.sgcNormPath qc (lwEnvShared envU) unitIr of
            ErrC e => pure (ErrC e)
            OkC parts => do
              tailR <- splitModuleFilesWith lookup store ctx rest
              case tailR of
                ErrC e => pure (ErrC e)
                OkC tail => case unitDepsOf ctx.sgcOrdered unit (unitPartsDeps parts) of
                  ErrC e => pure (ErrC e)
                  OkC deps =>
                    let
                      sf = SplitFile "${unit}.ml" "${genUnitText parts}\n" deps
                    in do
                      _ <- store mname sf
                      pure (OkC (sf :: tail))

-- 入口文件：`Main` 单元正文 + main 钩子。
splitMainFileWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> SplitGenCtx -> Bool -> Eff r (Check SplitFile)
splitMainFileWith lookup store ctx printResult = do
  cached0 <- lookup "__entry__"
  let
    cached = keepCached ctx.sgcOrdered (splitUnitOfModule entryOwner) cached0
  in case cached of
    Just cachedFile => pure (OkC cachedFile)
    Nothing =>
      let
        entryUnit = splitUnitOfModule entryOwner
        entryDefs = defsInUnit ctx.sgcDefOwnerT entryOwner ctx.sgcAllDefs
        entryDatas = datasInUnit ctx.sgcDataOwnerT entryOwner ctx.sgcAllDatas
        qc = QualCtx entryUnit ctx.sgcDefUnitT ctx.sgcDataUnitT
        envU = lwEnvWithUnit entryUnit ctx.sgcEnv
      in case lowerUnitChecked envU (map dtDefName entryDefs) (map dtDataName entryDatas) of
        ErrC e => pure (ErrC e)
        OkC unitIr => case lowerEntryOf ctx.sgcAllDefs of
          ErrC e => pure (ErrC e)
          OkC entryM => case entryM of
            Nothing => pure (cgErr0 NoMain)
            Just entryIr => case genUnitPartsWith ctx.sgcNormPath qc (lwEnvShared envU) unitIr of
              ErrC e => pure (ErrC e)
              OkC parts => case genEntryHook (mkGenStWith ctx.sgcNormPath qc (lwEnvShared envU)) entryIr printResult of
                ErrC e => pure (ErrC e)
                OkC hook => case unitDepsOf ctx.sgcOrdered entryUnit (append (unitPartsDeps parts) (secondOf hook)) of
                  ErrC e => pure (ErrC e)
                  OkC deps =>
                    let
                      sf =
                        SplitFile "Main.ml" (mainInitPrologue ++ genUnitText parts ++ firstOf hook)
                          deps
                    in do
                      _ <- store "__entry__" sf
                      pure (OkC sf)
