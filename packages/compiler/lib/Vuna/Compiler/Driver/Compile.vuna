module Vuna.Compiler.Driver.Compile where

-- Vuna.Compiler.Driver.Compile：编译入口（供 CompilerCli / 测试使用）。唯一路径是 DT：
-- 精化（Elab）→ 擦除检查 + 逐模块 OCaml 生成（Driver.SplitGen）；`check*` 只检查不产码。
-- 包上下文（`PackageContext`）是唯一入口形状；`compile` 与 `seed`
-- rotation 共用 `compileToDir`（目录 + build.sh）。
-- `build` 在链接成功后写 `build-meta.json`（源/依赖闭包内容哈希 + compiler 版本），
-- 同哈希直接跳过；`compile` / `build --no-compile` 不写 meta（seed rotation 与快照
-- 只认 .ml/build.sh 的确定性产物）。
-- codegen 用全限定跨单元引用，每个模块只 `open` / 依赖它真正引用的前序单元；
-- `writeCompiledNormalized` 把 SplitFile 的直接依赖传给 `buildScript`，生成的 build.sh 按 vuna
-- 预先算好的层**分层并行**编译 + 精确增量（每单元 stamp 只含直接依赖），依赖图不再
-- 退化为全序链。
--
-- 效果显式化：扫描/读文件/写文件/建目录/删除/子进程/时钟/环境/二进制指纹全部显式在
-- `Eff r` 里；纯逻辑（路径/哈希/序列化/缓存键计算/AST 变换）保持纯函数。下挂模块
-- （`Driver.Split`、`Driver.Dt`、`Packages.Pkg` 的磁盘层）同样是 `Eff r`，这里直接调用。
import Base.Container.HashMap as HashMap
import Base.Data.Maybe as Maybe
import Vuna.Compiler.Loader.Addr
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Hash
import Vuna.Compiler.Base.Diagnostics.Pkg
import Vuna.Compiler.Base.Bytes
import Vuna.Compiler.Loader.Fingerprint
import Vuna.Compiler.Base.Store
import Vuna.Compiler.Base.Walk
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Frontend.Packages.Source
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Driver.Cache
import Vuna.Compiler.Driver.Iface
import Vuna.Compiler.Base.Diag.Codec
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Flatten
import Vuna.Compiler.Loader.Header
import Vuna.Compiler.Loader.Modules
import Vuna.Compiler.Frontend.Manifest
import Vuna.Compiler.Base.Version
import Vuna.Compiler.Base.Obs
import Base.Data.List as List
import Base.Data.Nat as Nat
import Base.Effect.Args as EffArgs
import Base.Effect.Clock as EffClock
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes
import Base.Effect.Console as EffConsole
import Base.Effect.Exit as EffExit
import Vuna.Compiler.Elab.Driver
import Vuna.Compiler.Elab.Term

-- ---------------------------------------------------------------
-- 效果辅助（本模块自用；顺序与纯 `map` / `concatMap` / `mapMaybe` 一致）
-- ---------------------------------------------------------------
mapEff : {r : Row} -> (a -> Eff r b) -> List a -> Eff r (List b)
mapEff f [] = pure []
mapEff f (x :: rest) =
  do
    y <- f x
    ys <- mapEff f rest
    pure (y :: ys)

concatMapEff : {r : Row} -> (a -> Eff r (List b)) -> List a -> Eff r (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) =
  do
    xs <- f x
    ys <- concatMapEff f rest
    pure (append xs ys)

mapMaybeEff : {r : Row} -> (a -> Eff r (Maybe b)) -> List a -> Eff r (List b)
mapMaybeEff f [] = pure []
mapMaybeEff f (x :: rest) =
  do
    y <- f x
    ys <- mapMaybeEff f rest
    pure (
        case y of
          Just v => v :: ys
          Nothing => ys
      )

-- 包级 check：可执行包检查 app/Main.vuna；库包检查 [export].modules。
-- 结果走磁盘缓存（key = 闭包源哈希 + 依赖哈希 + manifest + 版本）。
-- `wantWarnings` = 调用方要 warning（`-W` / `--deny-warnings`）。warning 不持久化，
-- 缓存命中/干净模块复用都会跳过精化、丢掉 warning，所以这里跳过 check 缓存并强制本包
-- 模块重算（依赖仍走接口摘要，不重算依赖包）。
export checkPackage : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> Bool -> Package -> Eff r (Check (List Diagnostic))
checkPackage release wantWarnings pkg =
  let
    ctx = contextWithRelease release (packageContext pkg)
  in do
    exists <- fsFileExists (packageEntry pkg)
    if exists then
      do
        exeR <- checkCachedExe wantWarnings ctx (packageEntry pkg)
        case exeR of
          ErrC e => pure (ErrC e)
          OkC ds =>
            case packageExports pkg of
              -- 纯可执行包：入口闭包就是全部模块面。
              Nothing => pure (OkC ds)
              -- 既是可执行包又导出库模块：入口闭包之外还有模块面。依赖方可能 import 这些模块，
              -- 而接口对象只从被精化的模块产生 —— 不补这一次 lib check，包会「有源文件但没有
              -- 接口」，依赖方读接口缺件后只能整体回退全量。第二遍不重复报 warning。
              Just names =>
                do
                  -- 入口闭包已经覆盖全部导出模块时（典型：Main import 了库模块），入口那遍
                  -- 已经写全 order + iface 对象，再补一遍 lib check 只会重复精化整包
                  -- （4000 定义探针上约 +0.9 s，且放大增长比）。order 只在「完整模块面」
                  -- 写成功后才存在，所以「order 覆盖 names」等价于 iface 也已写全。
                  -- `VUNA_ELAB_FULL=1` 的语义是「每条路径都全量」，必须照跑第二遍（也会重新
                  -- 读写 lex 对象；截断恢复的用例依赖它）。
                  full <- elabFullRequested
                  covered <- if full then pure False else orderCoversEff ctx names
                  if covered then
                    do
                      let
                        _ = log! "debug" "check-lib-skip covered=${length names}"
                      in pure (OkC ds)
                  else
                    do
                      libR <- checkCachedLib False ctx names
                      case libR of
                        ErrC e => pure (ErrC e)
                        OkC ds2 => pure (OkC (append ds ds2))
    else
      case packageExports pkg of
        Nothing => pure (pkgAt1 "${packageDir pkg}/vuna.toml" 1 (LibraryWithoutEntry (packageName pkg)) (packageName pkg))
        Just names => checkCachedLib wantWarnings ctx names

-- 逐级创建目录（`--out a/b` 的父目录可能不存在）。
--
-- 并发注意：并行构建会在同一目录上竞争；宿主 `MakeDir` 幂等（已存在返回 0），
-- 逐级递归创建不会因 EEXIST 失败。
export ensureDirPath : Member nFs FsOp r, Member nProcess ProcessOp r => String -> Eff r Int
ensureDirPath path = ensureDirPathFuel 256 path

ensureDirPathFuel : Member nFs FsOp r, Member nProcess ProcessOp r => Int -> String -> Eff r Int
ensureDirPathFuel fuel path =
  if fuel <= 0 then
    pure 0
  else if path == "" || path == "." || path == "/" then
    pure 0
  else
    do
      exists <- fsFileExists path
      if exists then
        pure 0
      else
        do
          _ <- ensureDirPathFuel (fuel - 1) (parentOfPath path)
          fsMakeDir path

-- 去掉最后一段（`a/b/c` -> `a/b`；无 `/` -> "."；绝对路径的父仍绝对）由 `Source.parentOfPath`
-- 提供（`Common` 已重导出），这里不再保留第二份实现。
-- 逐模块 split 输出到 outDir：各模块 .ml + Main.ml + build.sh；Ok 写出的文件数。
-- outDir 在 codegen 成功后才创建（精化失败不留产物）。
-- 包根 `ffi/*.c` 复制到 `OUTDIR/ffi/` 并写进 build.sh（受限 FFI 的 C 实现）。
export compileToDir : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Bool -> String -> Eff r (Check (Int, List Diagnostic))
compileToDir ctx entry printResult outDir =
  do
    inputs <- splitInputsOf ctx entry printResult
    compileToDirGiven inputs ctx entry printResult outDir

-- | 同上，复用调用方已经算好的 split 输入：`build` 的 view 地址与 codegen 判定共用同一次
-- 闭包扫描 / 依赖接口读取（一次整包源扫描 + 每个模块的头解析）。
export compileToDirGiven : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => SplitInputs -> PackageContext -> String -> Bool -> String -> Eff r (Check (Int, List Diagnostic))
compileToDirGiven inputs ctx entry printResult outDir =
  do
    audit <- ifaceAuditRequested
    if audit then
      auditCompile inputs ctx entry printResult outDir
    else
      compileToDirNormal inputs ctx entry printResult outDir

-- 单元缓存 key 的逐模块身份：闭包扫描已经算好的接口地址。
modHashPair : ClosureMod -> (String, String)
modHashPair m = (m.cmName, m.cmAddr)

-- 摘要路径的 split（**不读 split 缓存**）：接口可用 ⇒ 摘要路径（干净模块 + 依赖接口），
-- 否则全量。抽出来供正常路径与审计路径共用，保证两条路径的「摘要分支」完全一致。
-- 构建路径的 codegen 口径：**只用同一套（全量）**。
--
-- 构建路径**不能**用「干净模块从接口补 defloc 行」这条增量口径：`miDefLocs` 只记录
-- `cachedDefs` 里有 span 的定义，而全量路径的位置表由 Lowering 从完整程序算出——两者
-- 在派生/预处理定义上不等（实测差的是一行 `Member.greet`）。于是同一个输入在「冷 store
-- → 全量」与「热 store → 增量」下会产出不同字节，而输入寻址下同一路径会被两份内容
-- 先后覆盖。
-- 构建一律走全量 lowering（单元缓存仍按声明哈希命中，所以热构建依然快），
-- 产物因此是输入摘要的纯函数。
summarySplitParts : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List ClosureMod -> Maybe (List ModuleIface) -> String -> Bool -> Eff r (Check (List SplitFile, CheckedPackage))
summarySplitParts ctx mods depIfaces entry printResult =
  let
    -- 单元缓存 key 的逐模块身份：闭包扫描已经算好的接口地址。
    modIds = map modHashPair mods
  in case depIfaces of
    Just ifaces => dtSplitProjectWithIfaces ctx entry printResult modIds ifaces
    Nothing => dtSplitProjectParts ctx entry printResult modIds

-- | 构建（codegen）入口：两级输入寻址。
--
-- 1. **快 key**（`splitInOf`）：源闭包 + 依赖身份 + 编译器指纹；命中
--    `objects/splitptr/<快 key>` 就直接读语义 blob（未改动源码 = 零精化）；
-- 2. **语义 key**（`splitIdentityOf`）：本包 `pkgIfaceHash` + `pkgImplHash` + 布局摘要 +
--    依赖身份 + 产物口径；`blobs/<语义 key>` 是产物真身。注释变更 ⇒ 快 key 变、语义 key
--    不变 ⇒ 精化一次、codegen 复用；行移动 ⇒ 布局摘要变 ⇒ 重建（运行时位置表正确）。
compileToDirNormal : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => SplitInputs -> PackageContext -> String -> Bool -> String -> Eff r (Check (Int, List Diagnostic))
compileToDirNormal inputs ctx entry printResult outDir =
  do
    let
      fast = splitInOf inputs.siMods
    in do
      ptr <- readSplitPointer fast
      case ptr of
        Just sem =>
          do
            cached <- readSplitBlob sem
            case cached of
              Just files =>
                do
                  let
                    _ = log! "debug" "split-pointer-hit cache-path=hit"
                  in do
                    n <- writeCompiledNormalized ctx outDir files
                    pure (
                        case n of
                          ErrC e => ErrC e
                          OkC count => OkC (count, [])
                      )
              Nothing => rebuildSplit inputs ctx entry printResult outDir fast
        Nothing => rebuildSplit inputs ctx entry printResult outDir fast

-- 快指针未命中：精化一次 → 写接口（返回模块摘要）→ 语义 key → blob 命中则复用，
-- 否则 codegen + 写 blob + 写快指针。
rebuildSplit : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => SplitInputs -> PackageContext -> String -> Bool -> String -> String -> Eff r (Check (Int, List Diagnostic))
rebuildSplit inputs ctx entry printResult outDir fast =
  do
    -- 同包干净模块的接口读一次：codegen 的语义 key 与写回都用这份表。
    cleanR <- ownCleanInfoWith ctx inputs.siClosure
    let
      clean =
        case cleanR of
          Just xs => xs
          Nothing => []
    in do
      summary <- summarySplitParts ctx inputs.siClosure inputs.siDepIfaces entry printResult
      case summary of
        ErrC e => pure (ErrC e)
        OkC p =>
          do
            let
              canon = canonicalTopo (firstOf p)
              checked = secondOf p
            in do
              shadow <- writeIfaceShadowWithClean ctx checked (Just inputs.siClosure) clean
              case shadow of
                ErrC e => pure (ErrC e)
                OkC modules =>
                  do
                    tag <- cacheTagEff
                    let
                      -- 入口-only 包没有可写的模块面（`modules=[]`），语义 key 无从谈起：
                      -- 退回源输入 key（正确优先，放弃这类包的注释复用）。
                      sem =
                        case modules of
                          [] => fast
                          _ => splitIdentityOf ctx printResult tag modules inputs.siMods.cmKind inputs.siMods.cmDeps
                    in do
                      cached <- readSplitBlob sem
                      case cached of
                        Just files =>
                          do
                            _ <- writeSplitPointer fast sem
                            _ <- rootKeepEff ctx [fast, sem]
                            let
                              _ = log! "debug" "split-identity-hit cache-path=hit"
                            in do
                              n <- writeCompiledNormalized ctx outDir files
                              pure (
                                  case n of
                                    ErrC e => ErrC e
                                    OkC count => OkC (count, checked.checkedWarnings)
                                )
                        Nothing =>
                          do
                            _ <- writeSplitBlobAt sem canon
                            _ <- writeSplitPointer fast sem
                            _ <- rootKeepEff ctx [fast, sem]
                            n <- writeCompiledNormalized ctx outDir canon
                            pure (
                                case n of
                                  ErrC e => ErrC e
                                  OkC count => OkC (count, checked.checkedWarnings)
                              )

-- 审计（`VUNA_IFACE_AUDIT=1`）：同一进程分别走摘要路径与全量路径，codegen 产物逐字节比较；
-- 一致才落盘，不一致报 `iface-audit-mismatch` 且**不写任何缓存/接口**。
auditCompile : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => SplitInputs -> PackageContext -> String -> Bool -> String -> Eff r (Check (Int, List Diagnostic))
auditCompile inputs ctx entry printResult outDir =
  do
    summary <- summarySplitParts ctx inputs.siClosure inputs.siDepIfaces entry printResult
    full <- dtSplitProjectParts ctx entry printResult (map modHashPair inputs.siClosure)
    let
      _ = log! "info" "iface-audit subject=compile entry=${entry}"
    in do
      compared <- pure (auditCompare "compile" entry (splitSignatureOf summary) (splitSignatureOf full))
      case compared of
        ErrC e => pure (ErrC e)
        OkC _ =>
          case summary of
            ErrC e => pure (ErrC e)
            OkC p =>
              do
                let
                  files = firstOf p
                  checked = secondOf p
                  canon = canonicalTopo files
                  fast = splitInOf inputs.siMods
                in do
                  shadow <- writeIfaceShadowWith ctx checked (Just inputs.siClosure)
                  case shadow of
                    ErrC e => pure (ErrC e)
                    OkC modules =>
                      do
                        tag <- cacheTagEff
                        let
                          sem =
                            case modules of
                              [] => fast
                              _ => splitIdentityOf ctx printResult tag modules inputs.siMods.cmKind inputs.siMods.cmDeps
                        in do
                          _ <- writeSplitBlobAt sem canon
                          _ <- writeSplitPointer fast sem
                          _ <- rootKeepEff ctx [fast, sem]
                          n <- writeCompiledNormalized ctx outDir canon
                          pure (
                              case n of
                                ErrC e => ErrC e
                                OkC count => OkC (count, checked.checkedWarnings)
                            )

-- 内容相同就不写：`build-id` 这类小文件反复重写会改 mtime，影响 `diff -r` 与增量判定。
writeFileIfChanged : Member nFs FsOp r => String -> String -> Eff r Nat
writeFileIfChanged path content =
  do
    exists <- fsFileExists path
    if exists then
      do
        old <- fsReadFile path
        if old == content then pure 0 else fsWriteFile path content
    else
      fsWriteFile path content

-- 把**已规范拓扑序**的 split 文件写入 outDir 并写 build.sh。
-- 调用方保证 files 已过 `canonicalTopo`：命中路径的 blob 在写侧就规范化了，未命中路径
-- 在写 blob 前规范化。build.sh 的层/顺序因此不在热路径重算：`canonicalTopo` 只在写侧
-- 跑一次。
writeCompiledNormalized : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> List SplitFile -> Eff r (Check Int)
writeCompiledNormalized ctx outDir files =
  do
    _ <- ensureDirPath outDir
    id <- buildIdForEff ctx
    _ <- writeFileIfChanged "${outDir}/${buildIdFileName}" "${id}\n"
    let
      _ = log! "info" "write-compiled-start"
    in do
      written <- writeSplitFilesIfChanged outDir files
      case written of
        ErrC e => pure (ErrC e)
        OkC n =>
          do
            let
              _ = log! "info" "write-split-files-done"
              graph = splitGraph files
              _ = log! "info" "split-graph-done"
            in do
              cFiles <- copyFfiFiles (contextDir ctx) outDir
              _ <- fsWriteFile "${outDir}/build.sh" (buildScript graph cFiles)
              let
                _ = log! "info" "build-script-done"
              in do
                pure (OkC n)

-- 包根 `ffi/*.c` → OUTDIR/ffi/<name>.c；返回写进 build.sh 的相对路径列表。
-- 没有 ffi/ 目录时返回 []。
copyFfiFiles : Member nFs FsOp r, Member nProcess ProcessOp r => String -> String -> Eff r (List String)
copyFfiFiles ctxDir outDir =
  do
    let
      ffiDir = "${ctxDir}/ffi"
    in do
      exists <- fsFileExists ffiDir
      isDir <- if exists then fsIsDirectory ffiDir else pure False
      if exists && isDir then
        do
          names <- fsReadDir ffiDir
          let
            cs = filter (\n => endsWith ".c" n) names
          in do
            _ <- ensureDirPath "${outDir}/ffi"
            _ <-
              mapEff (
                  \n =>
                    do
                      content <- fsReadFile "${ffiDir}/${n}"
                      fsWriteFile "${outDir}/ffi/${n}" content
                ) cs
            pure (map (\n => "ffi/${n}") cs)
      else
        pure []

-- loadPackage + compileToDir：给定包目录的代码生成（seed rotation / 测试用）。
export buildSplit : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> Eff r (Check Int)
buildSplit dir outDir =
  do
    pkgR <- loadPackage dir
    case pkgR of
      ErrC e => pure (ErrC e)
      OkC pkg =>
        do
          r <- compileToDir (packageContext pkg) (packageEntry pkg) True outDir
          pure (
              case r of
                ErrC e => ErrC e
                OkC p => OkC (firstOf p)
            )

-- ---------------------------------------------------------------
-- build meta（确定性、无绝对路径/时间戳）
--
-- 目的：同输入同产物 + 依赖闭包哈希 + 同哈希跳过。meta 只记录**模块名**与内容
-- 哈希（模块名由模块根相对路径推导，跨机器稳定）；不记录绝对路径/时间戳。
-- `build` 链接成功后写；`compile` / `build --no-compile` 不写（seed rotation 与
-- 快照只认 .ml/build.sh）。
-- ---------------------------------------------------------------
metaSchema : Int
metaSchema = 1

metaFileName : String
metaFileName = "build-meta.json"

-- 内容哈希：SHA-256 的 63-bit 派生键。
textHash : String -> Int
textHash s = Vuna.Compiler.Base.Hash.contentKey s

-- 编译器身份（缓存 key 必须含它：check/codegen 语义随编译器变化）。口径与读取顺序见
-- `Vuna.Compiler.Loader.Fingerprint`（产物 `build-id` → `VUNA_COMPILER_TAG` → stat 兜底）。
-- env/stat 是宿主动作，显式 `Eff r`。
compilerFingerprint : Member nFs FsOp r, Member nEnv EnvOp r => Eff r Int
compilerFingerprint = compilerFingerprintEff

-- 缓存根：与对象库同一棵树（`storeRootEff`）。split / unit / 会话索引都落在这里，
-- 这样 GC / roots 只需要认识一个根。
cacheBase : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Eff r String
cacheBase = storeRootReadyEff

-- 目录遍历（模块根内的 .vuna）。`.gitignore` 与包内容跳过名单同一份
-- （`Packages.Source`），避免「什么算包内容」出现两套规则。
collectVunaMeta : Member nFs FsOp r => String -> Eff r (List String)
collectVunaMeta dir = collectFilesEff skipSourceDir (\name => endsWith ".vuna" name) dir

dropPrefixMeta : String -> String -> String
dropPrefixMeta prefix s =
  if startsWith prefix s then
    substring (byteLength prefix) (byteLength s - byteLength prefix) s
  else
    s

slashesToDots : String -> String
slashesToDots s = strPack (map slashToDot (strUnpack s))

slashToDot : Int -> Int
slashToDot c = if c == 47 then 46 else c

moduleNameOfPath : String -> String -> String
moduleNameOfPath rootPath path =
  let
    rel0 = dropPrefixMeta "${rootPath}/" path
    rel = if endsWith ".vuna" rel0 then substring 0 (byteLength rel0 - 5) rel0 else rel0
  in slashesToDots rel

rootSources : Member nFs FsOp r => Root -> Eff r (List (String, Int))
rootSources root =
  do
    paths <- collectVunaMeta (rootDir root)
    mapEff (
        \p =>
          do
            content <- fsReadFile p
            pure (moduleNameOfPath (rootDir root) p, textHash content)
      ) paths

rootHash : Member nFs FsOp r => Root -> Eff r Int
rootHash root =
  do
    sources <- rootSources root
    pure (closureHashOf sources 0)

closureHashOf : List (String, Int) -> Int -> Int
closureHashOf [] acc = acc
closureHashOf ((name, h) :: rest) acc = closureHashOf rest (acc * 1000003 + h)

-- 入口文件 + 所有模块根的源码（模块名 → 哈希）。
entrySource : Member nFs FsOp r => String -> Eff r (String, Int)
entrySource entry =
  do
    content <- fsReadFile entry
    pure ("<entry>", textHash content)

-- 本包自己的模块根（依赖根由 `depIdentitiesEff` 的接口身份负责，不进源闭包）。
ownRootsOf : PackageContext -> List Root
ownRootsOf ctx = filter (\r => rootName r == contextPackageName ctx) (contextRoots ctx)

contextSources : Member nFs FsOp r => PackageContext -> String -> Eff r (List (String, Int))
contextSources ctx entry =
  do
    own <- concatMapEff rootSources (ownRootsOf ctx)
    es <- entrySource entry
    pure (append own [es])

-- 依赖闭包（跳过第一个根：它是本包自己的 lib；base-only 由 build 不会走到）。
dependencyHashes : Member nFs FsOp r => PackageContext -> Eff r (List (String, Int))
dependencyHashes ctx =
  case contextRoots ctx of
    [] => pure []
    _ :: deps =>
      mapEff (
          \r =>
            do
              h <- rootHash r
              pure (rootName r, h)
        ) deps

-- ---------------------------------------------------------------
-- 编译器身份的归属与产物里的 `build-id`
--
-- 身份属于**编译器闭包**，不属于打包它的 CLI：本包模块含 `compilerClosureModule` 的包按
-- 源闭包定址（与谁构建它无关），其余包继承构建它的编译器身份。因此改 `lib/` 不会让
-- 编译器缓存换代，改 `compiler/` 会；同源跨目录、重建同源也一致。
-- ---------------------------------------------------------------
compilerClosureModule : String
compilerClosureModule = "Vuna.Compiler.Loader.Fingerprint"

-- | 构建产物要写进 `build-id` 的身份。
buildIdForEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r String
buildIdForEff ctx =
  do
    own <- concatMapEff rootSources (ownRootsOf ctx)
    if memName compilerClosureModule (map firstOf own) then
      do
        deps <- depIdentitiesEff ctx
        pure (compilerIdOf own (depIdentitiesHash deps))
    else
      compilerTagEff

-- ---------------------------------------------------------------
-- 依赖身份：依赖方只消费依赖包的**接口身份**，不是源字节闭包。
--
-- 依赖包 check/build 成功后写一个稳定对象 `objects/pkg-iface/<key>`，key = 包名 + 该包
-- lib 根源闭包摘要 + 编译器 tag，载荷 = `pkgIfaceHashOfModules`。依赖方按同样的 key 读取：
--   * 命中 ⇒ `iface:<pkgIfaceHash>`（注释 / 诊断配置 / opaque 体变化不脏依赖方）；
--   * 缺失（依赖还没 check、或源码变了还没重跑）⇒
--     `manifest:<toml 内容摘要>:<该根源闭包摘要>` 回退。
--     源闭包在回退里：依赖源码变了而依赖方先跑，也必然换地址，不会复用旧判定；
--     依赖重跑后同一个接口身份回到 `iface:`，注释不敏感的增量性质恢复。
-- 没有读依赖接口对象，因此不会回到 `ifaceModsEff`（env）形成环。
-- ---------------------------------------------------------------
pkgIfaceSummaryKind : String
pkgIfaceSummaryKind = "pkg-iface"

pkgIfaceSummaryCodec : String
pkgIfaceSummaryCodec = "pkg-iface-summary 1"

pkgIfaceSummaryKeyOf : String -> String -> String -> String
pkgIfaceSummaryKeyOf pkg srcClosure tag = addrOf ["pkg-iface", pkg, srcClosure, tag]

-- | 依赖根的接口身份（或 manifest 回退）。
depRootIdentityEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Root -> Eff r (String, String)
depRootIdentityEff root =
  do
    h <- rootHash root
    tag <- cacheTagEff
    let
      key = pkgIfaceSummaryKeyOf (rootName root) (strFromInt h) tag
    in do
      saved <- storeObjectReadEff pkgIfaceSummaryKind pkgIfaceSummaryCodec key
      let
        verdict =
          case saved of
            Just _ => "iface"
            Nothing => "manifest"
        _ = log! "debug" "dep-identity=${rootName root} verdict=${verdict} src=${strFromInt h}"
      in case saved of
        Just s => pure (rootName root, "iface:${s}")
        Nothing =>
          do
            let
              tomlPath = "${rootDir root}/vuna.toml"
            in do
              exists <- fsFileExists tomlPath
              toml <- if exists then fsReadFile tomlPath else pure ""
              pure (rootName root, "manifest:${textHash toml}:${strFromInt h}")

depIdentitiesEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (List (String, String))
depIdentitiesEff ctx =
  case contextRoots ctx of
    [] => pure []
    _ :: deps => mapEff depRootIdentityEff deps

depIdentitiesHash : List (String, String) -> String
depIdentitiesHash pairs = addrOf ("dep-identities" :: map pairText pairs)

pairText : (String, String) -> String
pairText p = "${firstOf p}=${secondOf p}"

-- | 写本包的接口身份摘要（供依赖方读；失败/缺根不影响正确性，只是依赖方回退 manifest）。
writePkgIfaceSummaryEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List ModuleIface -> Eff r Int
writePkgIfaceSummaryEff ctx modules =
  case filter (\r => rootName r == contextPackageName ctx) (contextRoots ctx) of
    [] => pure 0
    r :: _ =>
      do
        h <- rootHash r
        tag <- cacheTagEff
        let
          key = pkgIfaceSummaryKeyOf (contextPackageName ctx) (strFromInt h) tag
          payload = pkgIfaceHashOfModules (contextPackageName ctx) modules
        in storeObjectWriteEff pkgIfaceSummaryKind pkgIfaceSummaryCodec key payload

metaPairText : (String, Int) -> String
metaPairText (name, hash) = "{\"name\":\"${name}\",\"hash\":${hash}}"

joinJsonList : List String -> String
joinJsonList [] = ""
joinJsonList [x] = x
joinJsonList (x :: rest) = "${x},${joinJsonList rest}"

-- 路径最后一段（`splitPath` 按第一个 `/` 切，不适合取 basename）。
-- 输入是反向字符流；acc 里已是原顺序的最后一段字符，直接 strPack。
lastSegmentRev : List Int -> List Int -> String
lastSegmentRev [] acc = strPack acc
lastSegmentRev (c :: rest) acc = if c == 47 then strPack acc else lastSegmentRev rest (c :: acc)

lastSegment : String -> String
lastSegment path = lastSegmentRev (reverse (strUnpack path)) []

export buildMetaText : Member nFs FsOp r => PackageContext -> String -> Bool -> Eff r String
buildMetaText ctx entry linked =
  do
    sources <- contextSources ctx entry
    deps <- dependencyHashes ctx
    let
      manifestHash = textHash (manifestSemanticText ctx.contextPackage)
      entryName = lastSegment entry
      linkedText = if linked then "true" else "false"
    in do
      pure "{\"schema\":${metaSchema},\"compiler\":\"${vunaVersion}\",\"package\":\"${contextPackageName ctx}\",\"entry\":\"${entryName}\",\"linked\":${linkedText},\"closure\":${closureHashOf sources 0},\"manifest\":${manifestHash},\"sources\":[${joinJsonList (map metaPairText sources)}],\"dependencies\":[${joinJsonList (map metaPairText deps)}]}\n"

metaPathOf : String -> String
metaPathOf outDir = "${outDir}/${metaFileName}"

export writeBuildMeta : Member nFs FsOp r => String -> PackageContext -> String -> Bool -> Eff r Int
writeBuildMeta outDir ctx entry linked =
  do
    text <- buildMetaText ctx entry linked
    n <- fsWriteFile (metaPathOf outDir) text
    pure (natToInt n)

-- 同哈希跳过：meta 内容与期望（linked=true）完全一致，且产物二进制存在。
export metaUpToDate : Member nFs FsOp r => String -> PackageContext -> String -> String -> Eff r Bool
metaUpToDate outDir ctx entry binPath =
  do
    let
      path = metaPathOf outDir
    in do
      exists <- fsFileExists path
      binExists <- if exists then fsFileExists binPath else pure False
      if exists && binExists then
        do
          raw <- fsReadFile path
          expected <- buildMetaText ctx entry True
          pure (raw == expected)
      else
        pure False

-- 在 dir 里跑生成的 build.sh：`sh build.sh <out>`（out 相对 dir，例如 "bin/<pkg>"）。
-- 链接失败给出带包名/目录/退出码的清晰错误（ocamlopt 的 stderr 已在终端）。
export runBuildScript : Member nProcess ProcessOp r => String -> String -> String -> Eff r (Check Int)
runBuildScript dir out name =
  do
    code <- processRunIn dir ["sh", "build.sh", out]
    pure
      (if code == 0 then OkC 0 else err "build: ${name}: sh build.sh ${out} failed in ${dir} (exit ${code})")

-- 判过标记是**输入寻址对象的存在性**：`checkIn` 就是那四个摘要的哈希，存在即判过。
-- ---------------------------------------------------------------
-- | 输入摘要的 schema（结构变化必须 bump；旧对象自然拒绝）。
checkNodeSchema : String
checkNodeSchema = "vuna-check-node 3"

hashText : Int -> String
hashText n = strFromInt n

-- ---------------------------------------------------------------
-- 清单的**语义**投影（缓存身份）
--
-- 只含影响检查/代码生成的字段：包名、导出面、依赖的 alias/source/hash。
-- `[diagnostics]`（纯显示配置：format/lang/max-errors/warnings）与 `[registry]`
-- （取包位置）**不进指纹**——改诊断格式不应该让整包与依赖方接口全部失效。
-- 这个投影用于 check/split 的 manifest 维度与 `packageEnvHash` / `buildMetaText`。
-- ---------------------------------------------------------------
maybeSemanticText : Maybe String -> String
maybeSemanticText Nothing = ""
maybeSemanticText (Just s) = s

depSourceText : DependencySource -> String
depSourceText (DepPath p) = "path:${p}"
depSourceText (DepGit url rev) = "git:${url}@${rev}"
depSourceText (DepUrl u) = "url:${u}"

depSemanticText : Dependency -> String
depSemanticText d =
  "${d.depAlias}|${depSourceText d.depSource}|${maybeSemanticText d.depHash}|${maybeSemanticText d.depIdentity}"

manifestSemanticText : Maybe Package -> String
manifestSemanticText Nothing = ""
manifestSemanticText (Just pkg) =
  let
    man = pkg.packageManifest
    exportsText =
      case man.manifestExports of
        Nothing => ""
        Just xs => join "," xs
  in join
    "\n"
    ((::) "name:${maybeSemanticText man.manifestName}" ((::) "exports:${exportsText}" (map depSemanticText man.manifestDependencies)))

-- | 语义开关：release 会拒绝 debug-only 构造（诊断集合不同），必须进输入摘要。
releaseFlagOf : PackageContext -> String
releaseFlagOf ctx = if contextRelease ctx then "release" else "debug"

-- | 可执行包的 check 节点输入：源闭包 / 依赖身份 / 语义 manifest / 编译器 / flags。
checkModsExe : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r CheckMods
checkModsExe ctx entry =
  do
    sources <- contextSources ctx entry
    deps <- depIdentitiesEff ctx
    fp <- compilerFingerprint
    let
      srcHash = closureHashOf sources 0
      manHash = textHash (manifestSemanticText ctx.contextPackage)
      verHash = textHash (checkNodeSchema ++ vunaVersion) + fp
    in pure (checkModsOf (contextPackageName ctx) "exe" (hashText manHash) (hashText srcHash) (depIdentitiesHash deps) (hashText verHash) (releaseFlagOf ctx))

-- | 库包的 check 节点输入：全部模块根（不受入口闭包限制）+ 导出面 + 依赖身份 + 语义 manifest。
checkModsLib : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> Eff r CheckMods
checkModsLib ctx names =
  do
    rootSourcesAll <- concatMapEff rootSources (contextRoots ctx)
    deps <- depIdentitiesEff ctx
    fp <- compilerFingerprint
    let
      srcHash = closureHashOf rootSourcesAll 0
      manHash = textHash (manifestSemanticText ctx.contextPackage)
      namesHash = textHash (join "\t" names)
      verHash = textHash (checkNodeSchema ++ vunaVersion) + fp
    in pure (checkModsOf (contextPackageName ctx) "lib:${hashText namesHash}" (hashText manHash) (hashText srcHash) (depIdentitiesHash deps) (hashText verHash) (releaseFlagOf ctx))

-- 依赖优先的 DFS 后序 + 按包名去重（与 `Packages.Pkg.dependencyRoots` 同规则）。
-- 直接依赖经单 clause 投影 `depPackagesOf` 取（SCT 认作结构子项），遍历本身是结构递归，
-- 不设 fuel：包图再深也不会截断成部分列表。
collectDepPackages : List String -> List Package -> (List String, List Package)
collectDepPackages seen [] = (seen, [])
collectDepPackages seen (p :: rest) =
  if memName (packageName p) seen then
    collectDepPackages seen rest
  else
    case collectDepPackages (packageName p :: seen) (depPackagesOf p) of
      (seen1, transitive) =>
        case collectDepPackages seen1 rest of
          (seen2, siblings) => (seen2, append transitive (p :: siblings))

-- | 直接依赖的投影：单 clause 构造子模式是结构子项，终止性判据直接认。
depPackagesOf : Package -> List Package
depPackagesOf (Package _ ds _) = ds

sameNameSet : List String -> List String -> Bool
sameNameSet a b = length a == length b && allNamesIn a b && allNamesIn b a

allNamesIn : List String -> List String -> Bool
allNamesIn [] _ = True
allNamesIn (x :: rest) ys = memName x ys && allNamesIn rest ys

-- 依赖包接口哈希表：写本包接口时给 `miDepHashes` 用。
-- 依赖包**模块接口**加载（TTC 的 module 复用）。
--
-- 读每包的 `.vuna-iface`
-- 并逐项校验：schema/编译器指纹/包名 → 每个模块的源码哈希 → 依赖接口哈希链
-- （`miDepHashes`）→ 依赖包当前源码模块集合与接口模块集合一致。任一失败 ⇒ Nothing ⇒
-- 调用方回退全量（宁可慢，不静默用陈旧接口）。
depPackageList : PackageContext -> List Package
depPackageList ctx =
  case ctx.contextPackage of
    Nothing => []
    Just pkg => secondOf (collectDepPackages [] pkg.packageDependencies)

depPackageCount : PackageContext -> Int
depPackageCount ctx = length (depPackageList ctx)

-- ---------------------------------------------------------------
-- 输入寻址的 iface 层
--
-- 模块接口的**地址**由输入摘要决定 —— 源码摘要 + 包身份 + 包环境 + 直接依赖模块的地址（+ 隐式 Prelude）。
-- 落盘是 `objects/module-iface/<地址>`，「模块干净」因此退化为一次路径存在性检查。
--
-- 依赖图从 **header 对象**得到（按源摘要寻址，热路径只读每个模块一个几百字节的对象），
-- 缺失时现 parse 一次并写回 —— 冷启动只付一次 parse，之后不再 parse 依赖包。
-- ---------------------------------------------------------------
ifaceObjectCodec : String
ifaceObjectCodec = "module-iface 5"

export record PkgEntry(..) where
  peName : String
  peDir : String
  peKey : String
  peEnv : String

export record ClosureMod(..) where
  cmPkg : String
  cmPkgKey : String
  cmPkgEnv : String
  cmName : String
  cmPath : String
  cmSrc : String
  cmImports : List String
  cmAddr : String
deriving (Selectors)

-- 包身份：**只要包名**。vuna 的依赖解析是「按名字在闭包里唯一」（同名不同目录会被 loader
-- 拒绝），所以名字就是身份；目录不进 key 反而是必要的——同一个包在不同入口写法、不同 cwd、
-- 作为依赖被引用时，路径字符串会不同（相对/绝对/`.` 分量），把目录算进身份会让
-- 「自己 check」与「被别人当依赖」算出两套地址，接口永远互相看不见（实测 56 个模块的
-- header 全部重复）。
pkgKeyOf : String -> String
pkgKeyOf name = addrOf ["pkg", name]

pkgTableEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (List PkgEntry)
pkgTableEff ctx =
  do
    ownEnv <- packageEnvHash ctx
    let
      own = PkgEntry (contextPackageName ctx) (contextDir ctx) (pkgKeyOf (contextPackageName ctx)) (strFromInt ownEnv)
    in do
      deps <-
        mapEff (
            \p =>
              do
                e <- packageEnvHash (packageContext p)
                pure (PkgEntry (packageName p) (packageDir p) (pkgKeyOf (packageName p)) (strFromInt e))
          ) (depPackageList ctx)
      pure (own :: deps)

findPkgEntry : String -> List PkgEntry -> Maybe PkgEntry
findPkgEntry _ [] = Nothing
findPkgEntry n (e :: rest) = if e.peName == n then Just e else findPkgEntry n rest

findClosureMod : String -> List ClosureMod -> Maybe ClosureMod
findClosureMod _ [] = Nothing
findClosureMod n (m :: rest) = if m.cmName == n then Just m else findClosureMod n rest

-- | 一次读盘同时算内容摘要与 header：`cmSrc` 是源摘要，`cmImports` 是解析出的 import 边
-- （尾接隐式 Prelude 由 `appendPrelude` 在拿到全量模块表后做）。
closureModsEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List PkgEntry -> Eff r (List ClosureMod)
closureModsEff ctx pkgs =
  do
    per <-
      mapEff (
          \r =>
            case findPkgEntry (rootName r) pkgs of
              Nothing => pure []
              Just pe =>
                do
                  paths <- collectVunaMeta (rootDir r)
                  mapEff (
                      \p =>
                        do
                          raw <- fsReadFile p
                          closureModOf pe (rootDir r) p raw
                    ) paths
        ) (contextRoots ctx)
    pure (concatMap (\xs => xs) per)

closureModOf : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PkgEntry -> String -> String -> String -> Eff r ClosureMod
closureModOf pe root p raw =
  do
    let
      name = moduleNameOfPath root p
      src = contentAddress raw
    in do
      imports <- headerImportsEff p src raw
      pure (ClosureMod pe.peName pe.peKey pe.peEnv name p src imports "")

-- 尾接隐式 Prelude（作为**普通图边**）：不这样做的话，Prelude 会作为「每个模块的额外依赖」
-- 后置在地址里，而它在拓扑序里没有前驱 ⇒ 早于 Prelude 的模块算地址时它还没分配，
-- 退化成 `ext:Prelude` 哨兵。哨兵/真实地址混用会让地址依赖遍历顺序（跨上下文不稳定，
-- 实测 `check compiler` 与 `check .` 算出两套地址）。写进 header 后它就是正常边。
appendPrelude : Bool -> ClosureMod -> ClosureMod
appendPrelude hasPrelude m =
  if hasPrelude && m.cmName /= "Prelude" && not (memName "Prelude" m.cmImports) then
    ClosureMod
      m.cmPkg
      m.cmPkgKey
      m.cmPkgEnv
      m.cmName
      m.cmPath
      m.cmSrc
      (append m.cmImports ["Prelude"])
      ""
  else
    m

modGraphEntry : ClosureMod -> (String, List String)
modGraphEntry m = (m.cmName, m.cmImports)

modNameOf : ClosureMod -> String
modNameOf m = m.cmName

isDepModOf : PackageContext -> ClosureMod -> Bool
isDepModOf ctx m = m.cmPkg /= contextPackageName ctx

isSelfModOf : PackageContext -> ClosureMod -> Bool
isSelfModOf ctx m = m.cmPkg == contextPackageName ctx

moduleGraphOf : List ClosureMod -> List (String, List String)
moduleGraphOf mods = map modGraphEntry mods

-- 依赖身份：直接用**依赖的源摘要**（不是已分配地址、也不是排序位置）。
--
-- 这里不能用「按模块名排序逐个赋值、未赋值的依赖取 ext:」：compiler 的 import 图有环，
-- 环内边必须停在一个稳定哨兵上；但按名字排序时，**无环**的前向边（依赖名排在依赖方之后，
-- 例如 `Base.Common` → `Base.Source`）也会落在 `ext:` 上。那样依赖内容变化时依赖方的
-- 接口地址不变，`ownCleanModules` 会按旧地址读到陈旧接口（跨 worktree 共享对象库时尤其
-- 容易踩到）。改把每个 import 的 `pkgKey|源摘要` 编进地址：与遍历顺序/图规模无关，
-- 依赖内容一变地址就变。传递变化（依赖的依赖改了导出面）由 `ownCleanInfo` 的
-- 重导出链传播兜住。
depSrcOf : HashMap.HashMap String String -> String -> String
depSrcOf tbl name =
  case HashMap.lookup name tbl of
    Just src => src
    Nothing => "ext:${name}"

-- | 模块源摘要表（模块名 → `包身份|源摘要`）：地址解析用。
srcTblOf : List ClosureMod -> HashMap.HashMap String String
srcTblOf mods = HashMap.fromList (map srcPairOf mods)

srcPairOf : ClosureMod -> (String, String)
srcPairOf m = (modNameOf m, "${m.cmPkgKey}|${m.cmSrc}")

-- | 模块接口地址：包身份 / 模块名 / 自身源摘要 / 包环境 / 每个直接依赖的源摘要。
ifaceAddrOf : HashMap.HashMap String String -> ClosureMod -> String
ifaceAddrOf srcTbl m =
  addrOf
    (append ["module-iface", ifaceObjectCodec, m.cmPkgKey, m.cmName, m.cmSrc, m.cmPkgEnv] (map (depSrcOf srcTbl) m.cmImports))

withAddr : HashMap.HashMap String String -> ClosureMod -> ClosureMod
withAddr srcTbl m =
  ClosureMod
    m.cmPkg
    m.cmPkgKey
    m.cmPkgEnv
    m.cmName
    m.cmPath
    m.cmSrc
    m.cmImports
    (ifaceAddrOf srcTbl m)

-- | 整个依赖闭包的模块 + 各自接口地址（依赖在前，本包在后）。
export ifaceModsEff : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (List ClosureMod)
ifaceModsEff ctx =
  do
    pkgs <- pkgTableEff ctx
    ifaceModsWithEff ctx pkgs

ifaceModsWithEff : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List PkgEntry -> Eff r (List ClosureMod)
ifaceModsWithEff ctx pkgs =
  do
    -- 阶段标记（`Eff` 动作不能被纯跨度包住，只能打零宽度点）：进入 / 退出各一个
    -- `vuna.iface.compute`，与下面的 `iface-mods-phases` 文本行并存。
    _ <- obsMarkEff "vuna.iface.compute"
    ta <- clockNow
    mods0 <- closureModsEff ctx pkgs
    tb <- clockNow
    let
      hasPrelude = memName "Prelude" (map modNameOf mods0)
      mods = map (appendPrelude hasPrelude) mods0
      srcTbl = srcTblOf mods
      assigned = map (withAddr srcTbl) mods
    in do
      _ <- pure (log! "info" "iface-mods-phases n=${strFromInt (length mods)} closure=${strFromInt ((tb - ta) / 1000)}ms assign=direct")
      _ <- obsMarkEff "vuna.iface.compute"
      pure assigned

-- | 摘要路径与 iface 影子写共用的闭包扫描：无包上下文时给出空表
-- （`depIfacesOfWith` 对无包上下文直接返回 `Nothing`，不会用到它）。
summaryClosureMods : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (List ClosureMod)
summaryClosureMods ctx =
  case ctx.contextPackage of
    Nothing => pure []
    Just _ => ifaceModsEff ctx

-- | 只给影子写用的闭包扫描：不可写影子时返回 `Nothing`，让写侧跳过并省掉这次扫描。
shadowClosureMods : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ClosureMod))
shadowClosureMods ctx =
  if contextPackageName ctx == "" then
    pure Nothing
  else if not (shadowAllowed ctx) then
    pure Nothing
  else
    do
      mods <- ifaceModsEff ctx
      pure (Just mods)

-- | 只有 roots、没有包记录的上下文（单文件夹具 / base-only 会话）：按 root 名建表。
-- env 与 `packageEnvHash` 在「无依赖」时同口径（`<toml 内容哈希>|<tag>|`）。
rootEnvHashOf : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r Int
rootEnvHashOf dir =
  do
    tomlPath <- pure "${dir}/vuna.toml"
    exists <- fsFileExists tomlPath
    toml <- if exists then fsReadFile tomlPath else pure ""
    tag <- ifaceCompilerTag
    pure (textHash "${textHash toml}|${tag}|")

rootPkgTableEff : Member nFs FsOp r, Member nEnv EnvOp r => PackageContext -> Eff r (List PkgEntry)
rootPkgTableEff ctx =
  mapEff (
      \r =>
        do
          env <- rootEnvHashOf (rootDir r)
          pure (PkgEntry (rootName r) (rootDir r) (pkgKeyOf (rootName r)) (strFromInt env))
    ) (contextRoots ctx)

-- | 某上下文的整个模块闭包接口（工具 / 单文件 / 测试会话用）。
export ifacesForContextEff : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
ifacesForContextEff ctx =
  do
    mods <- ifaceModsEff ctx
    readIfaceListEff mods

-- | 同上，但上下文只有 roots（无包记录）：按 root 名建身份表。
export ifacesForRootsEff : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
ifacesForRootsEff ctx =
  do
    pkgs <- rootPkgTableEff ctx
    mods <- ifaceModsWithEff ctx pkgs
    readIfaceListEff mods

-- | 按地址读一个模块接口（载荷自证：解码失败即 `Nothing`）。
export readIfaceAtEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r (Maybe ModuleIface)
readIfaceAtEff a =
  do
    payload <- storeObjectReadEff "module-iface" ifaceObjectCodec a
    pure (
        case payload of
          Nothing => Nothing
          Just bytes => decModuleIfaceComplete bytes
      )

-- 按地址读整条闭包的接口。缓存计数（`vuna.counter.cache.hit` / `.miss`）：每个模块
-- 一次 `ph:"C"`——计数实参是常量 1（无 O(n) 表达式），关闭时只多一次 `Lazy.force` +
-- 分支与一个 `Eff` 绑定（相对这里的读对象/解码成本可忽略）。
-- 逐地址读接口，**跳过缺失项**：本包干净模块是纯优化，缺一个模块的接口不应该让整组
-- 干净模块作废（依赖它的模块会被 `moduleDepsOk` 一并拒掉，安全性不变）。依赖包仍用
-- all-or-nothing 的 `readIfaceListEff`：缺依赖必须整包回退，不能静默少装一个。
export readIfaceListPartialEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List ClosureMod -> Eff r (List ModuleIface)
readIfaceListPartialEff [] = pure []
readIfaceListPartialEff (m :: rest) =
  do
    mi <- readIfaceAtEff m.cmAddr
    xs <- readIfaceListPartialEff rest
    pure (
        case mi of
          Nothing => xs
          Just x => x :: xs
      )

readIfaceListEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List ClosureMod -> Eff r (Maybe (List ModuleIface))
readIfaceListEff [] = pure (Just [])
readIfaceListEff (m :: rest) =
  do
    mi <- readIfaceAtEff m.cmAddr
    case mi of
      Nothing =>
        do
          let
            _ = log! "debug" "iface-miss ${m.cmName} ${m.cmAddr} pkg=${m.cmPkg} src=${m.cmSrc}"
            _ = obsMark "vuna.tool.iface.miss:${m.cmName}:${m.cmAddr}"
          in do
            _ <- obsCountEff "vuna.counter.cache.miss" 1
            pure Nothing
      Just x =>
        do
          _ <- obsCountEff "vuna.counter.cache.hit" 1
          xs <- readIfaceListEff rest
          pure (
              case xs of
                Nothing => Nothing
                Just ys => Just (x :: ys)
            )

depModsOf : PackageContext -> List ClosureMod -> List ClosureMod
depModsOf ctx mods = filter (isDepModOf ctx) mods

selfModsOf : PackageContext -> List ClosureMod -> List ClosureMod
selfModsOf ctx mods = filter (isSelfModOf ctx) mods

depIfacesOf : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
depIfacesOf ctx =
  do
    mods <- ifaceModsEff ctx
    depIfacesOfWith ctx mods

-- | 依赖接口 + 同一次闭包扫描。检查路径把它同时交给写 iface 影子，避免再跑一遍
-- `ifaceModsEff`（整闭包源扫描 + header 解析）。
export depIfacesOfWith : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List ClosureMod -> Eff r (Maybe (List ModuleIface))
depIfacesOfWith ctx mods =
  case ctx.contextPackage of
    Nothing => pure Nothing
    Just _ =>
      do
        ordered <- depModsByOrderEff ctx mods
        case ordered of
          Nothing =>
            do
              let
                _ = log! "debug" "iface-reject=module-order"
              in do
                pure Nothing
          Just depMods => readIfaceListEff depMods

-- ---------------------------------------------------------------
-- 模块顺序对象
--
-- 下游 codegen 的 split 串接要求模块顺序与**精化顺序**一致（否则 `canonicalTopo` 报
-- "split dependency is not in topological order"）。对象库只按输入摘要寻址、没有顺序；
-- 用依赖图重新拓扑排序也不行——base/compiler 的 import 图**有环**，环内顺序任意。
-- 所以写侧把「这次写全的模块名顺序」单独存一个极小对象，读侧照它排列；缺失 ⇒ 回退全量。
-- ---------------------------------------------------------------
orderKind : String
orderKind = "module-order"

orderCodec : String
orderCodec = "module-order 1"

encOrderNames : List String -> String
encOrderNames names = encTop (encList encStr) names

decOrderNamesComplete : String -> Maybe (List String)
decOrderNamesComplete s =
  case decList decStr (strLength s) (curOf s) of
    Nothing => Nothing
    Just (names, rest) => if curAtEnd rest then Just names else Nothing

rootOfName : String -> List Root -> Maybe Root
rootOfName _ [] = Nothing
rootOfName n (r :: rest) = if rootName r == n then Just r else rootOfName n rest

-- 顺序对象的身份 = 包名 + 包源闭包 + 编译器 tag。只用包名会让编译器换代或源码变化后
-- 仍读到旧顺序（`Split.canonicalTopo` 随后报依赖不在拓扑序）。
orderKeyOfEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Root -> Eff r String
orderKeyOfEff root =
  do
    h <- rootHash root
    tag <- cacheTagEff
    pure (addrOf ["module-order", rootName root, strFromInt h, tag])

-- | 写某包的模块顺序（完整模块面写全后调用）。
writeOrderEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> Eff r Int
writeOrderEff ctx names =
  case rootOfName (contextPackageName ctx) (contextRoots ctx) of
    Nothing => pure 0
    Just root =>
      do
        key <- orderKeyOfEff root
        storeObjectWriteEff orderKind orderCodec key (encOrderNames names)

-- | 读某包的模块顺序；缺失/损坏 ⇒ Nothing（调用方回退全量，宁可慢，不产错序）。
readOrderEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Maybe (List String))
readOrderEff ctx pkg =
  case rootOfName pkg (contextRoots ctx) of
    Nothing => pure Nothing
    Just root =>
      do
        key <- orderKeyOfEff root
        payload <- storeObjectReadEff orderKind orderCodec key
        pure (
            case payload of
              Nothing => Nothing
              Just bytes => decOrderNamesComplete bytes
          )

-- | 已写的模块顺序是否覆盖这些导出模块（覆盖 ⇒ 入口那遍已写全 iface，无需再补 lib check）。
orderCoversEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> Eff r Bool
orderCoversEff ctx names =
  do
    ord <- readOrderEff ctx (contextPackageName ctx)
    pure (
        case ord of
          Just written => allNamesIn names written
          Nothing => False
      )

pickByOrder : List ClosureMod -> List String -> List ClosureMod
pickByOrder _ [] = []
pickByOrder mods (n :: rest) =
  case findClosureMod n mods of
    Just m => m :: pickByOrder mods rest
    Nothing => pickByOrder mods rest

pkgEq : String -> ClosureMod -> Bool
pkgEq p m = m.cmPkg == p

distinctPkgs : List ClosureMod -> List String -> List String
distinctPkgs [] acc = reverse acc
distinctPkgs (m :: rest) acc =
  if memName m.cmPkg acc then distinctPkgs rest acc else distinctPkgs rest (m.cmPkg :: acc)

goPkgs : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List ClosureMod -> List String -> List ClosureMod -> Eff r (Maybe (List ClosureMod))
goPkgs _ _ [] acc = pure (Just acc)
goPkgs ctx mods (p :: rest) acc =
  do
    ord <- readOrderEff ctx p
    case ord of
      Nothing => pure Nothing
      Just names =>
        let
          -- 顺序对象是按「包源闭包 + 编译器 tag」寻址的；这里再挡一次名集不相容
          -- （手改/残留对象）：顺序里出现闭包中不存在的模块 ⇒ 当缺失处理。
          current = map modNameOf (filter (pkgEq p) mods)
          namesCurrent = allNamesIn names current
          picked = pickByOrder mods names
          -- 该依赖包**对外承诺**的模块面（`[export].modules`；根不限制导出 ⇒ 全部模块）。
          -- 完整性判据 = 「导出面 ⊆ 写侧顺序」——与写侧 `writeIfaceShadow` 的判据同口径。
          required = exportedDepModsOf ctx p mods
        in if namesCurrent && allNamesIn (map modNameOf required) (map modNameOf picked) then goPkgs ctx mods rest (append acc picked) else pure Nothing

-- 依赖包 p 的对外模块面（按 `mods` 的闭包枚举顺序）。
exportedDepModsOf : PackageContext -> String -> List ClosureMod -> List ClosureMod
exportedDepModsOf ctx p mods =
  let
    inPkg = filter (pkgEq p) mods
  in case rootExportsOf p (contextRoots ctx) of
    Nothing => inPkg
    Just names => filter (nameExportedBy names) inPkg

-- 包 p 的 `[export]` 名单；找不到 root ⇒ `Nothing`（不限制导出，等价于「全部模块」）。
rootExportsOf : String -> List Root -> Maybe (List String)
rootExportsOf _ [] = Nothing
rootExportsOf p (r :: rest) = if rootName r == p then r.rootExports else rootExportsOf p rest

-- | 依赖模块接口按**写侧模块顺序**排列；任一步不可得 ⇒ Nothing。
depModsByOrderEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List ClosureMod -> Eff r (Maybe (List ClosureMod))
depModsByOrderEff ctx mods = goPkgs ctx mods (distinctPkgs (depModsOf ctx mods) []) []

-- 依赖模块接口按**拓扑序**（依赖在前）返回：下游 `Dt`/split 期望模块串接顺序与 import
-- 依赖一致（否则 `canonicalTopo` 报 "split dependency is not in topological order"）。
-- 对象库按输入摘要寻址、没有顺序，所以这里显式排序。
pickDepMods : PackageContext -> List ClosureMod -> List String -> List String -> List ClosureMod
pickDepMods _ _ [] _ = []
pickDepMods ctx mods (n :: rest) seen =
  if memName n seen then
    pickDepMods ctx mods rest seen
  else
    case findClosureMod n mods of
      Just m => if m.cmPkg /= contextPackageName ctx then m :: pickDepMods ctx mods rest (n :: seen) else pickDepMods ctx mods rest (n :: seen)
      Nothing => pickDepMods ctx mods rest seen

-- 把「本包依赖闭包的模块接口」暴露给工具链（不暴露内部实现）。
-- 无包上下文/依赖接口不全时返回 Nothing，调用方退回全量。
export depIfacesForCheck : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
depIfacesForCheck ctx = depIfacesOf ctx

-- 工具链消费默认走接口（`VUNA_IFACE_TOOL=0` 关闭做 A/B/排障）。
-- 一次性读全依赖闭包接口只用于调试入口；LSP/REPL 走下面的惰性闭包。
-- 工具链**按需**读依赖接口。
importNameStr : Import -> String
importNameStr (Import n alias q sp) = n

toolImportsOfSource : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (List String)
toolImportsOfSource ctx label source =
  do
    parsed <- parseFileWithPath label source
    case parsed of
      ErrC _ => pure []
      OkC parsedFile =>
        let
          sf = firstOf parsedFile
          hdr = sf.sourceFileModDecl
          imports = sf.sourceFileImports
        in case hdr of
          Just (ModDecl dname _ _ _ _ _ _) => toolImportNamesOf ctx dname imports
          Nothing => toolImportNamesOf ctx "" imports

toolImportNamesOf : Member nFs FsOp r => PackageContext -> String -> List Import -> Eff r (List String)
toolImportNamesOf ctx current imports =
  do
    implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) current imports
    pure (
        case implicitR of
          ErrC _ => map importNameStr imports
          OkC implicit => map importNameStr (append imports implicit)
      )

-- 工具链消费：默认按源码 import 闭包按需读依赖接口；`VUNA_IFACE_TOOL=0` 关闭（排障/A-B）。
-- 闭包必须含**同包模块的 import**——entry 直接 import 的模块可能再由同包模块
-- import 别的依赖包模块；只沿 entry imports 展开会漏掉这些依赖模块（Loader 从源码加载
-- 它们却没有 artifact 注入 ⇒ 假 `TC_UnknownName`）。同包模块名/import 从本包 manifest 取
-- （`check`/`build` 会写）；没有本包 manifest 或闭包仍不完整时，`Dt` 侧安全阀回退全量。
toolEnabled : Member nEnv EnvOp r => Eff r Bool
toolEnabled =
  do
    v <- envGetEnv "VUNA_IFACE_TOOL"
    pure (v /= "0")

importClosureGo : Int -> List ClosureMod -> List String -> List String -> List String
importClosureGo fuel _ [] acc = acc
importClosureGo fuel mods (n :: rest) acc =
  if fuel <= 0 then
    acc
  else if memName n acc then
    importClosureGo (fuel - 1) mods rest acc
  else
    case findClosureMod n mods of
      Nothing => importClosureGo (fuel - 1) mods rest (n :: acc)
      Just m => importClosureGo (fuel - 1) mods (append m.cmImports rest) (n :: acc)

-- 从起点名单沿 header 的 import 边做传递闭包（不读模块文件；header 已在内存）。
-- fuel 守卫：header 图理论上无环（loader 拒绝环），这里只防脏数据。队列里每个名字
-- 最多处理一次；重复边与起点里的外部名也会入队，所以上界 = 起点 + 节点 + 边 + 1。
importClosureOf : List ClosureMod -> List String -> List String
importClosureOf mods starts = importClosureGo (closureFuel mods starts) mods starts []

closureFuel : List ClosureMod -> List String -> Int
closureFuel mods starts = length starts + length mods + closureEdges mods + 1

closureEdges : List ClosureMod -> Int
closureEdges [] = 0
closureEdges (m :: rest) = length m.cmImports + closureEdges rest

isNeededMod : List String -> ClosureMod -> Bool
isNeededMod needed m = memName m.cmName needed

-- 闭包里的**依赖包**模块（同包模块由工具链从源码加载，不需要接口）。
toolDepModsOf : PackageContext -> List ClosureMod -> List String -> List ClosureMod
toolDepModsOf ctx mods needed = filter (isNeededMod needed) (depModsOf ctx mods)

export depIfacesForToolSource : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Maybe (List ModuleIface))
depIfacesForToolSource ctx label source =
  do
    enabled <- toolEnabled
    if enabled then
      do
        mods <- ifaceModsEff ctx
        starts <- toolImportsOfSource ctx label source
        let
          needed = importClosureOf mods starts
          depMods = toolDepModsOf ctx mods needed
          _ = log! "debug" "tool-closure modules=${length depMods}"
        in do
          readIfaceListEff depMods
    else
      pure Nothing

-- REPL：program 是「imports + 定义」的源码，闭包同样从它的 import 算。
export depIfacesForToolProgram : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Maybe (List ModuleIface))
depIfacesForToolProgram ctx program = depIfacesForToolSource ctx "<repl>" program

export depIfacesForTool : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
depIfacesForTool ctx =
  do
    enabled <- toolEnabled
    if enabled then depIfacesOf ctx else pure Nothing

-- base-only 上下文（无 manifest 的单文件夹具）的依赖接口 = base 包的模块接口。
-- `depIfacesOf` 需要 `ctx.contextPackage`（有 manifest 才有），单文件夹具拿不到；
-- 这里直接读 roots 里 base 包的接口，供会话化工具（test runner 等）注入。
-- 接口缺失 / schema / 编译器 tag 不符 ⇒ Nothing（调用方回退全量精化）。
export baseDepIfacesOf : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
baseDepIfacesOf ctx =
  case ctx.contextPackage of
    Just _ => pure Nothing
    Nothing => ifacesForRootsEff ctx

-- ---------------------------------------------------------------
-- 工具链（LSP / REPL）会话上下文
--
-- 一次工具请求需要的「依赖包接口 + 依赖接口哈希表 + 本包 manifest + 本次 buffer 的 import
-- 闭包 + 校验面」。全部由 manifest（小文件）算出来，模块接口按闭包惰性读；会话层把它按
-- 「编译器指纹 + 包名 + manifest 内容 + 闭包源文件 stat」缓存，失效时重建。
-- ---------------------------------------------------------------
-- `tcDepIfaces`：import 闭包里需要的依赖包模块接口（惰性读取的子集）；
-- `tcDepHashes`：依赖闭包**全部**模块的接口哈希（来自 manifest，不读模块文件；写本包接口
-- 时填 `miDepHashes` 用）；
-- `tcOwnManifest`：本包 manifest（干净同包模块 / 单模块写回的合并基）；
-- `tcNeeded`：本次 buffer 的 import 闭包（含本包模块名）——buffer 引入新依赖时据此失效；
-- `tcStats`：校验面（依赖/本包模块源文件 + manifest 文件的 (路径, 内容哈希, mtime, size)）；
-- `tcDepTable`：依赖模块名 → (接口目录, manifest 条目)，buffer 改 import 时重算闭包用；
-- `tcOwnDir`：本包接口目录（建会话时在 Eff 上取好；`toolNeededOfImports` 仍是纯函数）。
export record ToolContext(..) where
  tcDepIfaces : List ModuleIface
  tcDepHashes : List (String, String)
  tcNeeded : List String
  -- 本包模块名集合。LSP 用它把闭包分成「本包模块」（可预置干净接口）与依赖模块；
  -- 由会话建立时直接算好。
  tcOwnNames : List String
  tcStats : List SourceInfo

-- 内容哈希（与缓存 key / 接口源信息同一函数）：工具链侧比较 buffer 与磁盘内容用。
export toolTextHash : String -> String
toolTextHash = payloadDigest

export sourceInfoForPath : Member nFs FsOp r => String -> Eff r SourceInfo
sourceInfoForPath path =
  do
    raw <- fsReadFile path
    mtime <- fmap (fromMaybe 0) (fsFileMtime path)
    size <- fmap (\o => natToInt (fromMaybe 0 o)) (fsFileSize path)
    pure (SourceInfo path (payloadDigest raw) mtime size)

export toolNowSec : Member nClock ClockOp r => Eff r Int
toolNowSec =
  do
    us <- clockNow
    pure (us / 1000000)

-- mtime 秒精度的安全窗：`fsFileMtime` 只有秒级分辨率，同秒内改内容且大小不变的编辑
-- 用 mtime+size 不可分辨。mtime 距会话建立不足该窗口的文件一律回落内容哈希。
mtimeSafetyWindowSec : Int
mtimeSafetyWindowSec = 5

-- 校验：文件还在，且（mtime+size 快路径）或（内容哈希）与记录一致。
-- 安全窗如上：记录的 mtime 距会话建立不足窗口时，同秒内同大小编辑不可分辨 ⇒ 回读哈希。
export sourceFresh : Member nFs FsOp r => Int -> SourceInfo -> Eff r Bool
sourceFresh builtSec si =
  do
    let
      path = siPathOf si
    in do
      exists <- fsFileExists path
      if exists == False then
        pure False
      else
        do
          m <- fmap (fromMaybe 0) (fsFileMtime path)
          sz <- fmap (\o => natToInt (fromMaybe 0 o)) (fsFileSize path)
          if m == siMtimeOf si && sz == siSizeOf si && siMtimeOf si + mtimeSafetyWindowSec <= builtSec then
            pure True
          else
            do
              content <- fsReadFile path
              pure (payloadDigest content == siHashOf si)

export toolSessionFresh : Member nFs FsOp r => Int -> List SourceInfo -> Eff r Bool
toolSessionFresh builtSec [] = pure True
toolSessionFresh builtSec (si :: rest) =
  do
    fresh <- sourceFresh builtSec si
    if fresh then toolSessionFresh builtSec rest else pure False

-- import 名 → 闭包；buffer 每次变化都按当前 imports 重算。
export toolNeededOfImports : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> ToolContext -> String -> List Import -> Eff r (List String)
toolNeededOfImports ctx tool currentName imports =
  do
    mods <- ifaceModsEff ctx
    importNames <- toolImportNamesOf ctx currentName imports
    pure (importClosureOf mods importNames)

-- 惰性工具接口 + 会话上下文：与 `depIfacesForToolSource` 同一套校验，
-- 额外返回依赖哈希表 / 本包 manifest / 闭包 / 校验面。
export depIfacesForToolSourceDetailed : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> String -> Eff r (Maybe ToolContext)
depIfacesForToolSourceDetailed ctx label source =
  do
    enabled <- toolEnabled
    if enabled then
      do
        _ <- obsMarkEff "vuna.tool.ifaces.lookup"
        mods <- ifaceModsEff ctx
        starts <- toolImportsOfSource ctx label source
        let
          needed = importClosureOf mods starts
          depMods = toolDepModsOf ctx mods needed
          depHashes = map modHashPair depMods
          ownNames = map modNameOf (selfModsOf ctx mods)
          _ = log! "debug" "tool-closure modules=${length depMods}"
        in do
          ifaces <- readIfaceListEff depMods
          case ifaces of
            Nothing =>
              do
                _ <- obsMarkEff "vuna.tool.ifaces.missing"
                pure Nothing
            Just ifs =>
              do
                _ <- obsMarkEff "vuna.tool.ifaces.ready"
                stats <- mapEff statOfClosureMod depMods
                pure (Just (ToolContext ifs depHashes needed ownNames stats))
    else
      do
        _ <- obsMarkEff "vuna.tool.ifaces.disabled"
        pure Nothing

statOfClosureMod : Member nFs FsOp r => ClosureMod -> Eff r SourceInfo
statOfClosureMod m =
  do
    mtime <- fmap (fromMaybe 0) (fsFileMtime m.cmPath)
    size <- fmap (\o => natToInt (fromMaybe 0 o)) (fsFileSize m.cmPath)
    pure (SourceInfo m.cmPath m.cmSrc mtime size)

-- 本包干净模块：按**对象地址**读本包模块接口，再做源内容 / 依赖链校验。
-- 只读 `needed` 里的模块（闭包子集）；`exclude` 是当前正在编辑的模块名（buffer 可能与
-- 磁盘不同，不能复用它的 iface）。
export toolCleanOwnModules : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> ToolContext -> Int -> Maybe String -> List String -> Eff r (List ModuleIface)
toolCleanOwnModules ctx tool builtSec exclude needed =
  do
    mods <- ifaceModsEff ctx
    let
      cands = filter (ownCleanWanted needed exclude) (selfModsOf ctx mods)
    in do
      let
        _ = obsCounter "vuna.tool.clean.cands" (length cands)
      in do
        clean <- readIfaceListPartialEff cands
        let
          _ = obsCounter "vuna.tool.clean.read" (length clean)
        in toolCleanGo builtSec tool.tcDepHashes clean []

ownCleanWanted : List String -> Maybe String -> ClosureMod -> Bool
ownCleanWanted needed exclude m =
  memName m.cmName needed && (
      case exclude of
        Just x => m.cmName /= x
        Nothing => True
    )

-- 干净模块判定分两步：
--   1. 逐模块的**自身**判据（接口载荷自证 / 源新鲜 / 缓存程序可用 / 无缺失依赖哨兵）——一次 Eff pass；
--   2. 依赖链判据（本包模块的 `miDepHashes` 必须命中「依赖表 或 已收干净模块」）——纯定点。
-- 第 2 步必须定点而不是单遍：候选顺序是闭包枚举顺序（不保证拓扑序），单遍会把「依赖还没
-- 被接受」的模块误判成脏，连锁把大半包判脏（实测根包 27 个候选里 16 个这样被拒）。
toolCleanGo : Member nFs FsOp r, Member nEnv EnvOp r => Int -> List (String, String) -> List ModuleIface -> List ModuleIface -> Eff r (List ModuleIface)
toolCleanGo builtSec depTbl cands cleanRev =
  do
    ok <- cleanSelfOk builtSec cands []
    pure (cleanFixpoint (length ok + 1) depTbl ok cleanRev)

cleanSelfOk : Member nFs FsOp r, Member nEnv EnvOp r => Int -> List ModuleIface -> List ModuleIface -> Eff r (List ModuleIface)
cleanSelfOk builtSec [] acc = pure (reverse acc)
cleanSelfOk builtSec (m :: rest) acc =
  do
    selfOk <- payloadSelfOk m
    let
      _ = if selfOk then 0 else log! "debug" "iface-reject=self-hash ${miNameOf m}"
    in do
      fresh <- sourceFresh builtSec (miSourceOf m)
      let
        valid = cachedProgramValid (miCachedOf m)
        missingDep = hasMissingDep (miDepHashesOf m)
        ok = fresh && valid && selfOk && not missingDep
        -- 归因：整包重精化时看是哪一条把干净模块判掉（各计数器只在 reject 时 +1）。
        _ = if selfOk then 0 else obsCounter "vuna.tool.clean.reject.self" 1
        _ = if fresh then 0 else obsCounter "vuna.tool.clean.reject.fresh" 1
        _ = if valid then 0 else obsCounter "vuna.tool.clean.reject.cached" 1
        _ = if missingDep then obsCounter "vuna.tool.clean.reject.missingdep" 1 else 0
      in cleanSelfOk builtSec rest (if ok then m :: acc else acc)

-- 依赖链定点：每遍按枚举顺序收「依赖已满足」的模块，链式依赖在同一遍里推进；
-- 一遍没有任何进展 ⇒ 其余模块的依赖不在闭包内，整批拒绝（fuel 只防脏数据）。
cleanFixpoint : Int -> List (String, String) -> List ModuleIface -> List ModuleIface -> List ModuleIface
cleanFixpoint fuel depTbl pending cleanRev =
  if fuel <= 0 then
    append (reverse pending) cleanRev
  else
    case cleanPass depTbl pending cleanRev [] of
      ([], kept) => append (reverse kept) cleanRev
      (rest, kept) =>
        if length kept == 0 then
          append (reverse rest) cleanRev
        else
          let
            _ = obsCounter "vuna.tool.clean.kept" (length kept)
          in cleanFixpoint (fuel - 1) depTbl rest (append (reverse kept) cleanRev)

cleanPass : List (String, String) -> List ModuleIface -> List ModuleIface -> List ModuleIface -> (List ModuleIface, List ModuleIface)
cleanPass depTbl [] cleanRev acc = ([], reverse acc)
cleanPass depTbl (m :: rest) cleanRev acc =
  if moduleDepsOk depTbl cleanRev (miDepHashesOf m) then
    cleanPass depTbl rest (m :: cleanRev) (m :: acc)
  else
    let
      p = cleanPass depTbl rest cleanRev acc
    in (m :: firstOf p, secondOf p)

-- 单模块接口写回：LSP 每次成功请求后只写「当前模块」的接口对象。语义与整包 ifaceOfPackage
-- 一致（见 `Iface.ifaceOfModule`）；有缺口/其他脏模块时返回 Err，调用方静默跳过（不影响诊断）。
export toolWriteModuleIface : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => PackageContext -> ToolContext -> List ModuleIface -> CheckedPackage -> String -> SourceInfo -> Eff r (Check ModuleIface)
toolWriteModuleIface ctx tool clean checked name si =
  do
    let
      miResult = ifaceOfModule (contextPackageName ctx) si tool.tcDepHashes checked.checkedInherited clean checked.checkedModules checked.checkedEntryDecls checked.checkedProgram name
    in do
      case miResult of
        ErrC e => pure (ErrC e)
        OkC mi =>
          do
            _ <- writeModuleIfaceGuarded ctx mi
            pure (OkC mi)

-- | 单模块写回的只读写降级：失败静默跳过（诊断/会话缓存不受影响）。
writeModuleIfaceGuarded : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> ModuleIface -> Eff r Int
writeModuleIfaceGuarded ctx mi =
  if contextPackageName ctx == "" then
    pure 0
  else
    do
      mods <- ifaceModsEff ctx
      case findClosureMod (miNameOf mi) mods of
        Nothing => pure 0
        Just m => storeObjectWriteEff "module-iface" ifaceObjectCodec m.cmAddr (encModuleIface mi)

-- 冷启动（没有工具会话）：依赖哈希从磁盘接口汇总，干净模块按现有判定重算；
-- 写回尽力而为（LSP-only 会话逐步变热），失败不影响诊断。
export toolWriteModuleIfaceCold : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => PackageContext -> CheckedPackage -> String -> SourceInfo -> Eff r (Check ModuleIface)
toolWriteModuleIfaceCold ctx checked name si =
  do
    clean <- cleanIfacesOrEmpty ctx
    depTbl <- depIfaceHashTable ctx
    let
      miResult = ifaceOfModule (contextPackageName ctx) si depTbl checked.checkedInherited clean checked.checkedModules checked.checkedEntryDecls checked.checkedProgram name
    in do
      case miResult of
        ErrC e => pure (ErrC e)
        OkC mi =>
          do
            _ <- writeModuleIfaceGuarded ctx mi
            pure (OkC mi)

export toolCompilerFingerprint : Member nFs FsOp r, Member nEnv EnvOp r => Eff r Int
toolCompilerFingerprint = compilerFingerprint

-- | 包级 check 的判定入口：命中 = `objects/check-outcome/<checkIn>` 存在 → 未命中则跑精化，
-- 成功后写 marker 并把摘要登记进本项目 roots。
--
-- 命中时**完全跳过**精化；`-W` / `--deny-warnings`（warning 不持久化）、
-- `VUNA_ELAB_FULL=1`（强制全量）、`VUNA_IFACE_AUDIT=1`（双路径对拍）都直接绕过判定
-- （既不判命中也不提交），保持各自的既有语义。
-- 没有节点执行器，也就没有 span / 预算 / trace。
-- 缓存载荷里的路径一律**包相对**：同一份内容在不同 checkout / 共享 store 下编码一致。
canonicalDir : String -> String
canonicalDir dir =
  if endsWith "/" dir then substring 0 (natFromInt (strLength dir - 1)) dir else dir

canonicalPath : String -> String -> String
canonicalPath dir file =
  let
    d = canonicalDir dir
  in if d == "." || d == "" then
    file
  else if startsWith "${d}/" file then
    substring (natFromInt (strLength d + 1)) (natFromInt (strLength file - strLength d - 1)) file
  else
    file

resolveStoredPath : String -> String -> String
resolveStoredPath dir file =
  let
    d = canonicalDir dir
  in if file == "" || startsWith "/" file then
    file
  else if d == "." || d == "" then file else "${d}/${file}"

absoluteSpanLabel : Label -> Bool
absoluteSpanLabel l =
  case l.labelSpan of
    Nothing => False
    Just sp => startsWith "/" sp.spanFile

hasAbsoluteLabels : List Label -> Bool
hasAbsoluteLabels [] = False
hasAbsoluteLabels (l :: rest) = absoluteSpanLabel l || hasAbsoluteLabels rest

anyAbsoluteChild : List Diagnostic -> Bool
anyAbsoluteChild [] = False
anyAbsoluteChild (k :: rest) = diagHasAbsolutePath k || anyAbsoluteChild rest

diagHasAbsolutePath : Diagnostic -> Bool
diagHasAbsolutePath (Diagnostic _ _ _ _ _ _ labels _ _ _ _ _ kids _ _ _ _) =
  hasAbsoluteLabels labels || anyAbsoluteChild kids

isStableDiag : Diagnostic -> Bool
isStableDiag d =
  case d.diagStability of
    Stable => True
    Volatile => False

allStableDiags : List Diagnostic -> Bool
allStableDiags ds = length (filter (\d => not (isStableDiag d)) ds) == 0

-- 存储前：路径规范化为包相对；仍为绝对路径的诊断标 Volatile（不落盘）。
prepareForStore : PackageContext -> Diagnostic -> Diagnostic
prepareForStore ctx d =
  let
    d2 = mapSpanFile (canonicalPath (contextDir ctx)) d
  in if diagHasAbsolutePath d2 then
    withStability Volatile d2
  else if isStableDiag d2 then withStability Stable d2 else d2

resolveStoredDiag : PackageContext -> Diagnostic -> Diagnostic
resolveStoredDiag ctx d = mapSpanFile (resolveStoredPath (contextDir ctx)) d

replayFailure : List Diagnostic -> Check (List Diagnostic)
replayFailure [] = OkC []
replayFailure [d] = ErrC d
replayFailure (d :: rest) = ErrC (withChildren rest d)

storeCheckPayload : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> CheckOutcome -> Eff r Int
storeCheckPayload ctx dig outcome =
  do
    _ <- storeObjectWriteEff "check-outcome" checkResultCodec dig (encCheckOutcome outcome)
    rootKeepEff ctx [dig]

-- 包级缓存判定的输入摘要（纯数据；key 由 `checkInOf` / `splitInOf` 换算成对象地址）。
--
-- `cmKind` = `exe`（可执行包入口）/ `lib:<namesHash>`（库包导出面）。`cmVer` 是
-- 「编译器版本 + 指纹」：换二进制即整套判定换代。
export record CheckMods(..) where
  cmPkg : String
  cmKind : String
  cmManifest : String
  cmSources : String
  cmDeps : String
  cmVer : String
  -- 语义开关（当前：release/debug）。多一段 ⇒ 不同 flags 得到不同地址。
  cmFlags : String

-- | 拼 `CheckMods`（纯构造；摘要由调用方算好传入）。
checkModsOf : String -> String -> String -> String -> String -> String -> String -> CheckMods
checkModsOf pkg kind manifest sources deps ver flags =
  CheckMods pkg kind manifest sources deps ver flags

-- 项目身份：**规范化绝对包目录**的摘要。roots 按项目分目录（`store/roots/<id>/`），
-- 项目只追加自己关心的摘要；GC 扫所有项目的并集，所以 A 不需要知道 B 的存在。
-- 公式在 `Addr.projectIdAddrOf`：`vuna deps fetch` 也要写同一个项目的 roots。
export projectIdOf : Member nEnv EnvOp r => PackageContext -> Eff r String
projectIdOf ctx =
  do
    abs <- absolutePath (contextDir ctx)
    pure (projectIdAddrOf abs)

-- | 把摘要追加进本项目 roots（GC 的保留集合）。失败不影响正确性（删了只是重算）。
-- 同时记录项目的绝对目录：GC 按它清理「目录已不存在」的项目根（统一 store 下
-- 临时目录 / 已删除的 worktree 不会永久钉住对象）。
rootKeepEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> Eff r Int
rootKeepEff ctx digests =
  do
    pid <- projectIdOf ctx
    abs <- absolutePath (contextDir ctx)
    storeRootAppendEff pid abs digests

-- 包级 check 判定：**输入寻址对象的「存在性」**。
--
-- 判据就是 `checkInOf mods` 这个摘要：包名 + kind + manifest/源闭包/依赖闭包摘要 +
-- 编译器指纹。存在 ⇒ 判过（跳过精化）；不存在 ⇒ 精化后写一个 0 字节 marker 对象。
-- 没有查询图、没有会话索引：跨进程天然一致，坏字节由 framing 拒绝。
checkViaGraph : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> CheckMods -> Eff r (Check (List Diagnostic)) -> Eff r (Check (List Diagnostic))
checkViaGraph ctx mods run =
  do
    full <- elabFullRequested
    audit <- ifaceAuditRequested
    if full || audit then
      run
    else
      do
        let
          dig = checkInOf mods
        in do
          payload <- storeObjectReadEff "check-outcome" checkResultCodec dig
          case payload of
            Just raw =>
              case decCheckOutcome raw of
                Just (CheckPassed ds) =>
                  do
                    let
                      _ = log! "debug" "cache-path=hit"
                    in do
                      _ <- obsCountEff "vuna.counter.cache.hit" 1
                      pure (OkC (map (resolveStoredDiag ctx) ds))
                Just (CheckFailed ds) =>
                  do
                    let
                      _ = log! "debug" "cache-path=hit"
                    in do
                      _ <- obsCountEff "vuna.counter.cache.hit" 1
                      pure (replayFailure (map (resolveStoredDiag ctx) ds))
                Nothing => runAndStore ctx dig run
            Nothing => runAndStore ctx dig run

-- 未命中：跑精化，把结果（通过/失败 + 诊断）作为输入寻址载荷落盘。
-- 含绝对路径或 Volatile 诊断时不落盘（下次重算），保证载荷是地址输入的纯函数。
runAndStore : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Check (List Diagnostic)) -> Eff r (Check (List Diagnostic))
runAndStore ctx dig run =
  do
    let
      _ = log! "debug" "cache-path=miss"
    in do
      _ <- obsCountEff "vuna.counter.cache.miss" 1
      r <- run
      case r of
        ErrC e =>
          let
            stored = map (prepareForStore ctx) [e]
            _ = log! "debug" "check-store stable=${strFromInt (length (filter (\d => isStableDiag d) stored))}/${strFromInt (length stored)}"
          in if allStableDiags stored then
            do
              n <- storeCheckPayload ctx dig (CheckFailed stored)
              let
                _ = log! "debug" "check-store write=${strFromInt n}"
              in do
                -- 落盘成功 ⇒ 一次缓存写（`vuna.cache.write` 是保留名，作 `ph:"C"` 计数用）。
                _ <- obsCountEff "vuna.counter.cache.write" 1
                pure (ErrC e)
          else
            do
              let
                _ = log! "debug" "check-cache=skip volatile"
              in pure (ErrC e)
        OkC ds =>
          let
            -- Pass 只持久化「本包可达」的 Stable 诊断：依赖包 warning 的路径不在本包目录下
            -- （绝对路径跨 checkout 不可复用），显示侧本来也会被 ownedByPackage 过滤。
            allStored = map (prepareForStore ctx) ds
            stored = filter isStableDiag allStored
            dropped = length allStored - length stored
            _ = log! "debug" "check-store pass stable=${strFromInt (length stored)}/${strFromInt (length allStored)}"
            _ = if dropped > 0 then log! "debug" "check-store dropped=${strFromInt dropped}" else 0
          in do
            n <- storeCheckPayload ctx dig (CheckPassed stored)
            let
              _ = log! "debug" "check-store write=${strFromInt n}"
            in do
              _ <- obsCountEff "vuna.counter.cache.write" 1
              pure (OkC ds)

checkCachedExe : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> String -> Eff r (Check (List Diagnostic))
checkCachedExe wantWarnings ctx entry =
  do
    mods <- checkModsExe ctx entry
    if wantWarnings then
      checkUncachedExe wantWarnings ctx entry
    else
      checkViaGraph ctx mods (checkUncachedExe wantWarnings ctx entry)

-- 缓存未命中时的精化入口：默认「依赖接口摘要齐全 ⇒ 摘要路径，否则全量」。
-- 摘要路径返回 `Err` 时**直接上报**（不回退——回退会吞掉本包真实错误）。
-- `VUNA_ELAB_FULL=1` 强制全量：排障/A-B 对拍用（测试里对两份诊断逐字节比较）。
checkUncachedExe : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> String -> Eff r (Check (List Diagnostic))
checkUncachedExe wantWarnings ctx entry =
  do
    full <- elabFullRequested
    if full then
      fullCheckExe ctx entry
    else
      do
        mods <- summaryClosureMods ctx
        audit <- ifaceAuditRequested
        if audit then
          auditCheckExe wantWarnings ctx mods entry
        else
          do
            summary <- summaryCheckExeParts wantWarnings ctx mods entry
            checkAndShadowWith ctx (Just mods) (pure summary)

-- 摘要路径（**不落盘**）：接口不可用 ⇒ 全量（只是不直接写缓存）。
-- wantWarnings 时 clean 列表清空 ⇒ 本包模块全部重算（warning 不在缓存里）。
summaryCheckExeParts : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> List ClosureMod -> String -> Eff r (Check (List Diagnostic, CheckedPackage))
summaryCheckExeParts wantWarnings ctx mods entry =
  do
    depIfaces <- depIfacesOfWith ctx mods
    case depIfaces of
      Nothing =>
        do
          let
            _ = log! "debug" "cache-path=full"
          in do
            dtCheckWithProgramParts ctx entry
      Just ifaces =>
        do
          -- `ownCleanInfo` 只需要包上下文；此前这里传 `depIfaceHashTable ctx`，那个函数内部
          -- 会跑一整遍 `ifaceModsEff`（整闭包源扫描 + 地址表），一次 check 要跑 6 次以上——纯死计算。
          clean <- ownCleanModulesWith ctx mods
          case clean of
            Just clean2 =>
              do
                let
                  cleanReal = if wantWarnings then [] else clean2
                  _ = log! "debug" "cache-path=summary deps=${depPackageCount ctx}"
                  _ = log! "debug" "cache-own-clean=${length cleanReal}"
                in do
                  dtCheckPackageIncrementalParts ctx entry ifaces cleanReal
            Nothing =>
              do
                let
                  _ = log! "debug" "cache-path=summary deps=${depPackageCount ctx}"
                in do
                  dtCheckPackageWithIfacesParts ctx entry ifaces

fullCheckExe : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Check (List Diagnostic))
fullCheckExe ctx entry =
  let
    _ = log! "debug" "cache-path=full"
  in do
    mods <- shadowClosureMods ctx
    checkAndShadowWith ctx mods (dtCheckWithProgramParts ctx entry)

-- 审计（`VUNA_IFACE_AUDIT=1`）：摘要路径 vs 全量路径的诊断逐字节对拍。一致才按摘要结果
-- 落盘；不一致报 `iface-audit-mismatch` 并**不写缓存/接口**。
auditCheckExe : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> List ClosureMod -> String -> Eff r (Check (List Diagnostic))
auditCheckExe wantWarnings ctx mods entry =
  do
    summary <- summaryCheckExeParts wantWarnings ctx mods entry
    full <- dtCheckWithProgramParts ctx entry
    let
      _ = log! "info" "iface-audit subject=check entry=${entry}"
    in do
      compared <- pure (auditCompare "check" entry (checkSignatureOf summary) (checkSignatureOf full))
      case compared of
        ErrC e => pure (ErrC e)
        OkC _ => checkAndShadowWith ctx (Just mods) (pure summary)

-- `VUNA_ELAB_FULL=1`：强制全量精化（接口摘要路径的排障开关；默认关闭）。
elabFullRequested : Member nEnv EnvOp r => Eff r Bool
elabFullRequested =
  do
    v <- envGetEnv "VUNA_ELAB_FULL"
    pure (v == "1")

-- `VUNA_IFACE_AUDIT=1`：排障/CI 开关——摘要路径与全量路径在同一进程各跑一次并逐字节比较
-- 诊断/产物；不一致即失败且不写缓存。默认关闭（双倍精化，不适合热路径）。
ifaceAuditRequested : Member nEnv EnvOp r => Eff r Bool
ifaceAuditRequested =
  do
    v <- envGetEnv "VUNA_IFACE_AUDIT"
    pure (v == "1")

-- 诊断签名：`Ok`/`Err` 都参与比较（顺序敏感，逐字节）。
-- 直接按构造子在 clause 头分派（dispatch-lift），避免再嵌一层 case。
-- warning 不参与签名：摘要路径在 `wantWarnings=false` 时会复用干净模块（不重算 warning），
-- 全量路径会全算，二者在 warning 上不可比（warning 不进缓存）。
checkSignatureOf : Check (List Diagnostic, CheckedPackage) -> String
checkSignatureOf (OkC _) = "ok\n"
checkSignatureOf (ErrC e) = "err\n${diagText e}"

splitSignatureOf : Check (List SplitFile, CheckedPackage) -> String
-- 审计签名：只用于「摘要路径与全量路径产物是否一致」的比较，不进缓存。
-- 用规范编码——同一 SplitFile 列表编码逐字节稳定。
splitSignatureOf (OkC p) = "ok\n" ++ encTop encSplitFiles (firstOf p)
splitSignatureOf (ErrC e) = "err\n${diagText e}"

joinLines : List String -> String
joinLines [] = ""
joinLines (x :: rest) = if rest == [] then x else "${x}\n${joinLines rest}"

-- 不一致时只报签名指纹与长度（诊断可能很长，整段回显会把终端淹掉）；
-- `subject`/`at` 给出入口与位置，便于定位。
auditCompare : String -> String -> String -> String -> Check Int
auditCompare subject at s f =
  if s == f then
    OkC 0
  else
    err
      "iface-audit-mismatch subject=${subject} at=${at} summary=${textHash s}/${strLength s} full=${textHash f}/${strLength f}"

-- 依赖模块的「名字 → 输入摘要」表：写本包接口时给 `miDepHashes` 用。
-- 对象库下依赖的标识就是它的接口地址（与 `ifaceAddrOf` 的口径一致）。
depIfaceHashTable : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (List (String, String))
depIfaceHashTable ctx =
  do
    mods <- ifaceModsEff ctx
    pure (map modHashPair (depModsOf ctx mods))

-- 包环境指纹（`peEnv`）：本包 manifest 内容 + 依赖**接口身份** + 编译器标签。
-- **不含目录**：目录字符串依赖入口写法（相对/绝对/`.` 分量），把它算进环境会让同一个包
-- 「自己 check」与「被别的包当依赖」得到两套 env、进而两套接口地址（实测跨包永不命中）。
-- 依赖接口身份来自 `depIdentitiesEff`：注释 / 诊断配置 / opaque 体变化不脏
-- 依赖方；接口或声明面变化会换 env。
packageEnvHash : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r Int
packageEnvHash ctx =
  do
    let
      -- 纯显示配置（[diagnostics]）与取包位置（[registry]）不进语义身份。
      own = textHash (manifestSemanticText ctx.contextPackage)
    in do
      deps <- depIdentitiesEff ctx
      tag <- ifaceCompilerTag
      pure (textHash "${own}|${tag}|${joinLines (map pairText deps)}")

-- ---------------------------------------------------------------
-- 包内逐模块增量的脏/净判定
--
-- 两级判据：
--   1. **接口地址**：`ifaceAddrOf` 把模块源摘要、`pkgEnv` 与每个直接 import 的源摘要
--      编进地址，「按地址读到接口」⇒ 自身的源与直接依赖的源都没变；
--   2. **重导出链传播**：地址只编直接依赖的**源**摘要，依赖的依赖改了（依赖的导出面
--      随之变化）不会改依赖方地址。对 `export import` 的模块，这会读到陈旧接口
--      （被重导出模块的新导出看不见）——所以按导出条目的**定义处模块**把脏性沿重导出链
--      传播（A→B→Z 逐轮）。普通 import 只影响已缓存的实现体（与旧路径一致地复用），
--      不参与判脏，避免把「叶子模块改动 ⇒ 全体传递依赖重精化」的代价带回来。
-- ---------------------------------------------------------------
-- 与 `ownCleanModules` 同一次读取，同时回报「已有整包接口是否可完整读回」（按模块跳过
-- 的前提）：check/build 的写前校验已经解码过整包接口，写回时复用
-- 这次结果，不必把同样的 65 个模块文件读 + decode 第二遍。
readOneModIface : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => ClosureMod -> Eff r (ClosureMod, Maybe ModuleIface)
readOneModIface m =
  do
    mi <- readIfaceAtEff m.cmAddr
    pure (m, mi)

ownCleanInfo : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
ownCleanInfo ctx =
  do
    mods <- ifaceModsEff ctx
    ownCleanInfoWith ctx mods

-- | 干净模块判定：闭包由调用方传入（摘要路径已经算过一次，别再扫一遍）。
ownCleanInfoWith : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List ClosureMod -> Eff r (Maybe (List ModuleIface))
ownCleanInfoWith ctx mods =
  do
    reads <- mapEff readOneModIface (selfModsOf ctx mods)
    let
      ownNames = map modNameOf (selfModsOf ctx mods)
      cands = readIfaces reads
      -- 接口读不到的模块先算脏（源/依赖变了，或还没写过接口）。
      missing = filter (\n => not (memName n (map miNameOf cands))) ownNames
      clean = collectClean missing cands
    in pure (if length clean == 0 then Nothing else Just clean)

-- 候选（同包、接口可读）模块的接口列表。
readIfaces : List (ClosureMod, Maybe ModuleIface) -> List ModuleIface
readIfaces [] = []
readIfaces (p :: rest) =
  case secondOf p of
    Nothing => readIfaces rest
    Just mi => mi :: readIfaces rest

-- 候选接口是否重导出了某个脏模块：导出条目的定义处名以 `<mod>.` 开头。
-- `export import` 只拷贝条目，所以链式重导出（A→B→Z）的条目目标仍指向最初的定模块，
-- 用「定义处模块」做脏性传播能一次覆盖直接与间接重导出。
exportsFromDirty : List String -> ModuleIface -> Bool
exportsFromDirty dirty mi = anyExportFrom dirty (miExportsOf mi)

anyExportFrom : List String -> List ExportEntry -> Bool
anyExportFrom dirty [] = False
anyExportFrom dirty (e :: rest) =
  if fromDirty dirty e.target then True else anyExportFrom dirty rest

fromDirty : List String -> String -> Bool
fromDirty [] target = False
fromDirty (d :: rest) target = if startsWith "${d}." target then True else fromDirty rest target

-- 脏性固定点：接口读不到的同包模块先算脏；重导出了脏模块的也脏（链式重导出逐轮传播）。
-- 只传播「重导出」边：普通 import 只影响已缓存的实现体（与旧路径一致地复用），
-- 这样叶子模块改动不会把全体传递依赖都拖进重精化。
dirtyFix : Int -> List String -> List ModuleIface -> List String
dirtyFix fuel dirty cands =
  if fuel <= 0 then
    dirty
  else
    let
      added = map miNameOf (filter (\mi => not (memName (miNameOf mi) dirty) && exportsFromDirty dirty mi) cands)
    in if length added == 0 then dirty else dirtyFix (fuel - 1) (append added dirty) cands

collectClean : List String -> List ModuleIface -> List ModuleIface
collectClean dirty0 cands =
  let
    dirty = dirtyFix (length cands + 1) dirty0 cands
  in filter (\mi => not (memName (miNameOf mi) dirty)) cands

ownCleanModules : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Maybe (List ModuleIface))
ownCleanModules ctx =
  do
    info <- ownCleanInfo ctx
    pure info

-- | 同 `ownCleanModules`，闭包由调用方传入（复用摘要路径的那次扫描）。
ownCleanModulesWith : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List ClosureMod -> Eff r (Maybe (List ModuleIface))
ownCleanModulesWith ctx mods = ownCleanInfoWith ctx mods

-- 工具路径（LSP 冷启动写单模块接口）复用的干净模块：记录原样写回，避免用增量路径缺失的
-- 整包 sols 重算导致擦除位残 meta 的 zonk 结果漂移。命令行 check/build 走
-- writeIfaceShadow 的同一次 `ownCleanInfo` 读取，不经过这里。
cleanIfacesOrEmpty : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (List ModuleIface)
cleanIfacesOrEmpty ctx =
  do
    clean <- ownCleanModules ctx
    pure (
        case clean of
          Just clean2 => clean2
          Nothing => []
      )

-- 载荷自证（`VUNA_IFACE_SELFTEST=1`）：复用前用载荷重算哈希，与记录的 `miIfaceHash`
-- 比对。默认关闭——热路径只做 schema / 编译器指纹 / 环境指纹这些 O(1) 门；CI 打开
-- 后能抓住「载荷被改写但哈希字段没变」的接口。成本 O(payload)。
payloadSelfOk : Member nEnv EnvOp r => ModuleIface -> Eff r Bool
payloadSelfOk m =
  do
    self <- ifaceSelfTestRequested
    pure (if self then hashOfIface m == miIfaceHashOf m else True)

moduleDepsOk : List (String, String) -> List ModuleIface -> List (String, String) -> Bool
moduleDepsOk depTbl cleanRev [] = True
moduleDepsOk depTbl cleanRev ((name, h) :: rest) =
  if h == depMissingHash then
    moduleDepsOk depTbl cleanRev rest
  else
    case lookupPair name depTbl of
      Just h2 => h2 == h && moduleDepsOk depTbl cleanRev rest
      Nothing =>
        case cleanHashOf cleanRev name of
          Just h2 => h2 == h && moduleDepsOk depTbl cleanRev rest
          Nothing => False

cleanHashOf : List ModuleIface -> String -> Maybe String
cleanHashOf [] _ = Nothing
cleanHashOf (m :: rest) name =
  if miNameOf m == name then Just (miIfaceHashOf m) else cleanHashOf rest name

-- 接口摘要的**影子写**。整包 check / build 成功后按声明归属把 DtProgram
-- 切成每模块一份 `ModuleIface`，按地址写 `objects/module-iface/` + `objects/module-order/`（依赖侧的
-- 接口加载与失效判定读它）；写失败/归属缺口只打 note（不影响 check 结果），缺口存在时
-- **不写**（避免依赖方拿到不完整接口）。
ifaceCompilerTag : Member nFs FsOp r, Member nEnv EnvOp r => Eff r String
ifaceCompilerTag = cacheTagEff

-- | iface 目录：默认与源码同布局（`<包目录>/lib/.../X.vuna` → 同目录 `X.iface`）；
-- `VUNA_IFACE_DIR` 非空时整体镜像到该根（`<根>/<包绝对目录>/lib/.../X.iface`），便于
-- 持久化/共享。相对值按进程 cwd 解析（启动时读取一次）。
-- | 本包模块的 `SourceInfo`：源摘要直接取闭包扫描时算好的 `cmSrc`（同一个
-- `contentAddress`），这里只补 mtime / size，不再重读源文件。
ownSourceInfos : Member nFs FsOp r, Member nEnv EnvOp r => PackageContext -> List ClosureMod -> Eff r (List (String, SourceInfo))
ownSourceInfos ctx mods = mapEff ownInfoOf (selfModsOf ctx mods)

ownInfoOf : Member nFs FsOp r, Member nEnv EnvOp r => ClosureMod -> Eff r (String, SourceInfo)
ownInfoOf m =
  do
    abs <- absolutePath m.cmPath
    mtime <- fmap (fromMaybe 0) (fsFileMtime abs)
    size <- fmap (\o => natToInt (fromMaybe 0 o)) (fsFileSize abs)
    pure (m.cmName, SourceInfo abs m.cmSrc mtime size)

-- | 干净模块的 `miSource` 来自磁盘接口记录（可能是上一次以相对/绝对不同写法 check 时写入的
-- 路径）。复用时必须换成本次上下文的路径，否则相对/绝对入口交替会算出空路径而整包跳过写。
resyncCleanSources : List (String, SourceInfo) -> List ModuleIface -> List ModuleIface
resyncCleanSources sources clean =
  map (
      \m =>
        case lookupPair (miNameOf m) sources of
          Just si => ModuleIface (miNameOf m) (miPackageOf m) si (miIfaceHashOf m) (miImplHashOf m) (miDepHashesOf m) (miImportsOf m) (miImplicitImportsOf m) (miExportsOf m) (miFixitiesOf m) (miDeclsOf m) (miRecordsOf m) (miPreparedOf m) (miCachedOf m) (miDefLocsOf m)
          Nothing => m
    ) clean

-- 只有「声明了导出模块的包」才写接口对象。
--
-- 入口-only 包（单文件夹具、`vuna compile <file>`）没有可复用的库模块面：给它们写接口
-- 会让同一份源码在后续阶段（check → compile）命中缓存而**跳过精化**，于是只在精化时
-- 产生的诊断（典型 `UN_UnusedImport`）静默消失。
-- 有包记录就写（含 `[export]` 为空的入口包：它的模块面 = 入口闭包）。
-- 没有包记录（单文件夹具 / base-only 上下文）不写：没有可判定的「本包」边界。
shadowAllowed : PackageContext -> Bool
shadowAllowed ctx =
  case ctx.contextPackage of
    Nothing => False
    Just _ => True

-- 模块名是否在导出名单里（`filter` 的命名谓词；lambda 参数无类型标注时字段访问不可用）。
nameExportedBy : List String -> ClosureMod -> Bool
nameExportedBy names m = memName m.cmName names

-- 包对外承诺的模块面 = `[export].modules`。写侧完整性必须按**导出名单**判，而不是
-- lib 根下的全部 `.vuna`：未导出模块只服务本包内部（依赖方按 `rootAllows` 看不到它们），
-- 把它们算进判据会让「入口闭包 == 导出面」的包永远判 partial，于是每轮都补跑一遍
-- lib check（冷 `check compiler` 实测 21.5 s vs 单遍 12.5 s）。
-- 入口包（`[export]` 为空）的模块面 = 入口闭包本身：`own` 已经是「本包在闭包里出现的
-- 全部模块」，所以 `Nothing` 分支直接返回 `own`。
exportedOwnOf : PackageContext -> List ClosureMod -> List ClosureMod
exportedOwnOf ctx own =
  case ctx.contextPackage of
    Nothing => own
    Just pkg =>
      case packageExports pkg of
        Nothing => own
        Just names => filter (nameExportedBy names) own

writeIfaceShadow : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> CheckedPackage -> Eff r (Check (List ModuleIface))
writeIfaceShadow ctx checked = writeIfaceShadowWith ctx checked Nothing

-- 写侧开关：一次性对象库（自举 / CI 每级全新的 store）里接口写完之后不会再被读到，
-- 计算与落盘都是纯开销。默认开；`VUNA_IFACE_WRITE=0` 关闭。
ifaceWriteEnabled : Member nEnv EnvOp r => Eff r Bool
ifaceWriteEnabled =
  do
    v <- envGetEnv "VUNA_IFACE_WRITE"
    pure (v /= "0")

-- | 写 iface 影子；`pre` 是调用方已经算好的闭包扫描（`ifaceModsEff`），给了就不再算。
-- 没有干净模块表时按全量重算（check 路径）。
writeIfaceShadowWith : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> CheckedPackage -> Maybe (List ClosureMod) -> Eff r (Check (List ModuleIface))
writeIfaceShadowWith ctx checked pre = writeIfaceShadowWithClean ctx checked pre []

-- | `clean` = 调用方已读出的同包干净接口：记录直接复用，只在写回时编码脏模块。
writeIfaceShadowWithClean : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> CheckedPackage -> Maybe (List ClosureMod) -> List ModuleIface -> Eff r (Check (List ModuleIface))
writeIfaceShadowWithClean ctx checked pre clean =
  do
    enabled <- ifaceWriteEnabled
    if not enabled then pure (OkC []) else writeIfaceShadowGo ctx checked pre clean

writeIfaceShadowGo : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> CheckedPackage -> Maybe (List ClosureMod) -> List ModuleIface -> Eff r (Check (List ModuleIface))
writeIfaceShadowGo ctx checked pre clean =
  if contextPackageName ctx == "" then
    pure (OkC [])
  else if not (shadowAllowed ctx) then
    pure (OkC [])
  else
    do
      let
        _ = log! "info" "iface-shadow-start"
      in do
        -- 闭包只算一次：让 `depIfaceHashTable` 自己再跑一遍 `ifaceModsEff`（那是「读全部源文件
        -- + 算地址 + 取 header」的全量扫描）等于把最贵的一步做两遍。
        t0 <- clockNow
        mods <-
          case pre of
            Just known => pure known
            Nothing => ifaceModsEff ctx
        t1 <- clockNow
        sources <- ownSourceInfos ctx mods
        t2 <- clockNow
        let
          depTbl = map modHashPair (depModsOf ctx mods)
          own = selfModsOf ctx mods
          cleanNames = map miNameOf clean
          -- 完整性判据 = 导出面（不是 lib 根全部文件）。
          required = exportedOwnOf ctx own
        in do
          case ifaceOfPackage (contextPackageName ctx) sources depTbl checked.checkedInherited clean checked.checkedModules checked.checkedEntryDecls checked.checkedProgram of
            ErrC e =>
              do
                let
                  _ = log! "debug" "iface-reject=compute iface-skip ${diagText e}"
                in do
                  pure (OkC [])
            OkC modules =>
              do
                t3 <- clockNow
                let
                  unwritten = missingNamesOf required (map miNameOf modules)
                  -- 只写脏模块（干净模块的接口已在它的地址上）。
                  toWrite = filter (\mi => not (memName (miNameOf mi) cleanNames)) modules
                in do
                  -- **只写完整的导出面**：一次 check 若没覆盖包的某个导出模块（典型：入口没
                  -- import 它，且它不是入口闭包的一部分），就不写接口 —— 否则同一个地址会先后
                  -- 被两份不同精化上下文（入口 vs 库）的载荷覆盖，`miPrepared`/`miDecls` 随写入
                  -- 顺序漂移，下游 codegen 对拍与实例可见性都会抖。
                  -- 可执行包 + `[export] modules` 时由 `checkPackage` 补的那遍 lib check 写全。
                  --
                  -- 判据只看导出面：lib 根下**未导出**的模块（只服务本包内部）不参与判据，
                  -- 因此「入口闭包 == 导出面」的包第一遍就写全，不会每轮补跑第二遍。
                  if length unwritten > 0 then
                    do
                      let
                        _ = log! "debug" "iface-skip partial closure=${length own} required=${length required} covered=${length modules} missing=${join "," unwritten}"
                      in do
                        pure (OkC [])
                  else
                    do
                      -- 载荷自证（`VUNA_IFACE_SELFTEST=1`）：写之前重算每个模块的 iface 哈希，
                      -- 与记录值比对。不一致说明「载荷与哈希字段漂移」，此时不写（写出去会把
                      -- 错误的依赖哈希传给下游），并留 `iface-hash-mismatch` 行给门禁。
                      selfOk <- ifaceSelfCheckEff toWrite
                      if not selfOk then
                        do
                          let
                            _ = log! "debug" "iface-selftest=skip-write ${strFromInt (length toWrite)}"
                          in do
                            pure (OkC modules)
                      else
                        do
                          -- 先写「模块顺序」再写接口对象：读侧只有两份都在时才用接口路径。
                          _ <- writeOrderEff ctx (map miNameOf modules)
                          -- 接口写边界：`Eff` 动作，标记而非跨度；`vuna.counter.cache.write` 不是
                          -- 词汇表里的名字（只有 `vuna.cache.write`，且它是保留的 span 名而不是计数名的
                          -- 样子），所以这里只打标记 + 保留既有 `iface-write=…` 文本行的四段 ms：
                          -- 阶段拆分靠文本行，结构化只报「写发生了」。
                          _ <- obsMarkEff "vuna.iface.write"
                          n <- writeIfaceObjects own toWrite
                          -- 依赖身份摘要：依赖方按 lib 根源闭包摘要 + 编译器 tag 读。
                          _ <- writePkgIfaceSummaryEff ctx modules
                          t4 <- clockNow
                          let
                            _ = log! "info" "iface-write=${n}/${length modules} closure=${length own} phases mods=${strFromInt ((t1 - t0) / 1000)}ms sources=${strFromInt ((t2 - t1) / 1000)}ms compute=${strFromInt ((t3 - t2) / 1000)}ms write=${strFromInt ((t4 - t3) / 1000)}ms"
                          in do
                            pure (OkC modules)

-- 闭包里没有对应接口产物的模块名（写侧覆盖性诊断）。
missingNamesOf : List ClosureMod -> List String -> List String
missingNamesOf [] _ = []
missingNamesOf (m :: rest) written =
  if memName m.cmName written then
    missingNamesOf rest written
  else
    m.cmName :: missingNamesOf rest written

-- 载荷自证：重算每个模块的 iface 哈希，与记录值比对（`VUNA_IFACE_SELFTEST=1` 才跑）。
-- 不变式是「`miIfaceHash` == `hashOfIface` 对该载荷的结果」——载荷里任何字段
-- （含 depends 表）被改写而哈希没跟着变，都会在这里暴露。
ifaceSelfCheckEff : Member nEnv EnvOp r => List ModuleIface -> Eff r Bool
ifaceSelfCheckEff mods =
  do
    self <- ifaceSelfTestRequested
    pure (if self then ifaceSelfCheckGo mods else True)

ifaceSelfCheckGo : List ModuleIface -> Bool
ifaceSelfCheckGo [] = True
ifaceSelfCheckGo (m :: rest) =
  let
    h = miIfaceHashOf m
    h2 = hashOfIface m
    _ =
      if h == h2 then
        0
      else
        log! "debug" "iface-hash-mismatch ${miNameOf m} stored=${h} recomputed=${h2}"
    _ = if h == h2 then 0 else obsCounter "vuna.counter.iface.hash.mismatch" 1
  in h == h2 && ifaceSelfCheckGo rest

-- 按地址写模块接口（同一地址重复写幂等）。
-- 只统计**内容变化**的写入（`storeObjectWriteEff` 在字节相同时返回 0）：收敛后的
-- 第二次 check 应报 `iface-write=0/N`，这是「缓存已稳定」最直接的可观测信号。
writeIfaceObjects : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List ClosureMod -> List ModuleIface -> Eff r Int
writeIfaceObjects _ [] = pure 0
writeIfaceObjects mods (mi :: rest) =
  case findClosureMod (miNameOf mi) mods of
    Nothing => writeIfaceObjects mods rest
    Just m =>
      do
        bytes <- storeObjectWriteEff "module-iface" ifaceObjectCodec m.cmAddr (encModuleIface mi)
        n <- writeIfaceObjects mods rest
        pure (if bytes > 0 then n + 1 else n)

-- 真正写接口：入口-only 包（没有 lib 模块）不写（没有可复用的模块接口；写空包只会让
-- 消费者读到 invalid 接口）。每模块按地址只写内容变化的接口对象，模块顺序最后提交。
-- 目标存储不可写（Nix store / 只读 store）时读侧没有接口就回退全量。
-- 写侧自证（`VUNA_IFACE_SELFTEST=1`）：写前逐个模块重算 `hashOfIface` 并与记录值比对
-- （`ifaceSelfCheckEff`），不一致就不写并留 `iface-hash-mismatch`。
-- CI 由 `checks.vuna-iface-selftest` 覆盖；复用侧另有 `payloadSelfOk` 的同口径检查。
ifaceSelfTestRequested : Member nEnv EnvOp r => Eff r Bool
ifaceSelfTestRequested =
  do
    v <- envGetEnv "VUNA_IFACE_SELFTEST"
    pure (v == "1")

-- 成功收尾：写接口影子（check 结果节点由 `checkViaGraph` 提交，这里不再写 marker 文件）。
checkAndShadow : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Eff r (Check (List Diagnostic, CheckedPackage)) -> Eff r (Check (List Diagnostic))
checkAndShadow ctx checked = checkAndShadowWith ctx Nothing checked

checkAndShadowWith : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> Maybe (List ClosureMod) -> Eff r (Check (List Diagnostic, CheckedPackage)) -> Eff r (Check (List Diagnostic))
checkAndShadowWith ctx pre checked =
  do
    checkedR <- checked
    case checkedR of
      ErrC e => pure (ErrC e)
      OkC pr =>
        do
          shadow <- writeIfaceShadowWith ctx (secondOf pr) pre
          case shadow of
            ErrC e => pure (ErrC e)
            OkC _ => pure (OkC (firstOf pr))

checkCachedLib : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> List String -> Eff r (Check (List Diagnostic))
checkCachedLib wantWarnings ctx names =
  do
    mods <- checkModsLib ctx names
    if wantWarnings then
      checkUncachedLib wantWarnings ctx names
    else
      checkViaGraph ctx mods (checkUncachedLib wantWarnings ctx names)

checkUncachedLib : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> List String -> Eff r (Check (List Diagnostic))
checkUncachedLib wantWarnings ctx names =
  do
    full <- elabFullRequested
    if full then
      fullCheckLib ctx names
    else
      do
        mods <- summaryClosureMods ctx
        audit <- ifaceAuditRequested
        if audit then
          auditCheckLib wantWarnings ctx mods names
        else
          do
            summary <- summaryCheckLibParts wantWarnings ctx mods names
            checkAndShadowWith ctx (Just mods) (pure summary)

summaryCheckLibParts : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> List ClosureMod -> List String -> Eff r (Check (List Diagnostic, CheckedPackage))
summaryCheckLibParts wantWarnings ctx mods names =
  do
    depIfaces <- depIfacesOfWith ctx mods
    case depIfaces of
      Nothing =>
        do
          let
            _ = log! "debug" "cache-path=full"
          in do
            dtCheckLibraryWithProgramParts ctx names
      Just ifaces =>
        do
          -- 同 `summarySplitParts`：依赖表参数不被消费，传 `[]` 免一次 `ifaceModsEff`。
          clean <- ownCleanModulesWith ctx mods
          case clean of
            Just clean2 =>
              do
                let
                  cleanReal = if wantWarnings then [] else clean2
                  _ = log! "debug" "cache-path=summary deps=${depPackageCount ctx}"
                  _ = log! "debug" "cache-own-clean=${length cleanReal}"
                in do
                  dtCheckLibraryPackageIncrementalParts ctx names ifaces cleanReal
            Nothing =>
              do
                let
                  _ = log! "debug" "cache-path=summary deps=${depPackageCount ctx}"
                in do
                  dtCheckLibraryPackageWithIfacesParts ctx names ifaces

fullCheckLib : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> List String -> Eff r (Check (List Diagnostic))
fullCheckLib ctx names =
  let
    _ = log! "debug" "cache-path=full"
  in do
    mods <- shadowClosureMods ctx
    checkAndShadowWith ctx mods (dtCheckLibraryWithProgramParts ctx names)

auditCheckLib : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Bool -> PackageContext -> List ClosureMod -> List String -> Eff r (Check (List Diagnostic))
auditCheckLib wantWarnings ctx mods names =
  do
    summary <- summaryCheckLibParts wantWarnings ctx mods names
    full <- dtCheckLibraryWithProgramParts ctx names
    let
      subject = joinLines names
      _ = log! "info" "iface-audit subject=check-lib entry=${subject}"
    in do
      compared <- pure (auditCompare "check-lib" subject (checkSignatureOf summary) (checkSignatureOf full))
      case compared of
        ErrC e => pure (ErrC e)
        OkC _ => checkAndShadow ctx (pure summary)

-- ---------------------------------------------------------------
-- codegen 产物的缓存判定：**输入寻址的 split blob 存在性**。
--
-- `blobs/<splitIn>`：`splitIn` 由包名 + kind + 三项输入摘要 +
-- 编译器指纹算出，同一输入同一路径；命中判定就是文件存在，写侧重算结果覆盖同一路径。
-- ---------------------------------------------------------------
-- | split 输入摘要的 schema（结构变化必须 bump；旧 blob 自然失效）。
splitNodeSchema : String
splitNodeSchema = "vuna-split-node 2"

-- | split 载荷的编码版本（`Store` 的 codec 段）。
-- 载荷是 `canonicalTopo` 后的规范拓扑序。命中路径直接按
-- 载荷顺序写产物，不再重算规范化。
splitCacheCodec : String
splitCacheCodec = "split-files 2"

-- | blob 的 framing tag（schema + 编译器指纹）。
splitBlobTag : Member nFs FsOp r, Member nEnv EnvOp r => Eff r String
splitBlobTag =
  do
    tag <- cacheTagEff
    pure "${splitNodeSchema}/${tag}"

-- | split 节点的输入摘要：源闭包 / 依赖身份 / 版本+指纹+printResult。
-- | 一次 build 命令共用的 split 输入：闭包扫描 / 依赖接口 / 输入摘要。
--
-- 三者由同一次 `ifaceModsEff`（整包源扫描 + 逐模块头解析 + 地址分配）派生。`build` 的
-- view 地址与 codegen 判定以前各算一遍，于是同一份源码在一个命令里被扫两到三次。
export record SplitInputs(..) where
  siClosure : List ClosureMod
  siDepIfaces : Maybe (List ModuleIface)
  siMods : CheckMods

export splitInputsOf : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Bool -> Eff r SplitInputs
splitInputsOf ctx entry printResult =
  do
    closure <- ifaceModsEff ctx
    depIfaces <- depIfacesOfWith ctx closure
    sources <- contextSources ctx entry
    deps <- depIdentitiesEff ctx
    fp <- compilerFingerprint
    let
      srcHash = closureHashOf sources 0
      verHash = textHash (splitNodeSchema ++ vunaVersion) + fp
      prHash = if printResult then 1 else 0
      -- **产物口径**必须进判定 key：摘要路径（依赖接口齐全）与全量路径产出的代码不同
      -- （实测 runtime 的 defloc 表在两条路径下长度不同）。只用源码/依赖摘要当 key 会让
      -- 「先全量、后摘要」两次构建复用同一 blob 却覆盖不同内容。mode 因此进 kind。
      mode =
        case depIfaces of
          Just _ => "s"
          Nothing => "f"
      kind = "${mode}:${if printResult then "pr1" else "pr0"}"
    in pure (SplitInputs closure depIfaces (checkModsOf (contextPackageName ctx) kind "" (hashText srcHash) (depIdentitiesHash deps) (hashText (verHash + prHash)) (releaseFlagOf ctx)))

-- | blob 路径：内容寻址（`<cache>/blobs/<digest>`）。
splitBlobPath : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r String
splitBlobPath digest =
  do
    base <- cacheBase
    pure "${base}/blobs/${digest}"

-- | 写 blob 到**输入寻址**路径（key 由 `splitInOf` 给出，不再由内容哈希决定）：
-- 同一个输入永远同一个路径，命中判定就是「文件存在」。
writeSplitBlobAt : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> List SplitFile -> Eff r Int
writeSplitBlobAt digest files =
  do
    let
      payload = encTop encSplitFiles files
      -- 路径是**输入**地址；framing 头里记**内容**地址，读侧才能发现篡改。
      contentDigest = payloadDigest payload
    in do
      tag <- splitBlobTag
      path <- splitBlobPath digest
      base <- cacheBase
      _ <- storeEnsureDirEff "${base}/blobs"
      storeWriteIfChangedAsEff tag splitCacheCodec contentDigest path payload

-- | split 的输入摘要：包 + kind + 三个闭包摘要 + 编译器指纹（与 check 判定同口径）。
splitInOf : CheckMods -> String
splitInOf m =
  addrOf ["split", m.cmPkg, m.cmKind, m.cmManifest, m.cmSources, m.cmDeps, m.cmVer, m.cmFlags]

-- ---------------------------------------------------------------
-- 产物身份（代码即内容）：快 key → 语义 key 的指针 + 语义 blob。
--
-- `splitIdentityOf` 看本包接口面 / 产物面 / 布局（span 行号）、依赖身份、产物口径与
-- 编译器 tag，不看本包源字节：注释变更不换语义 key（复用 codegen），行移动换布局摘要
-- （重建位置表），`opaque`/`abstract` 体变更换 `pkgImplHash`（只换本包产物），
-- 依赖包变化换 `deps`（产物文件集含依赖单元）。
-- ---------------------------------------------------------------
splitPtrKind : String
splitPtrKind = "splitptr"

splitPtrCodec : String
splitPtrCodec = "split-pointer 1"

readSplitPointer : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r (Maybe String)
readSplitPointer fast =
  do
    saved <- storeObjectReadEff splitPtrKind splitPtrCodec fast
    pure (
        case saved of
          Just sem => if sem == "" then Nothing else Just sem
          Nothing => Nothing
      )

writeSplitPointer : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> Eff r Int
writeSplitPointer fast sem = storeObjectWriteEff splitPtrKind splitPtrCodec fast sem

defLocLine : PackageContext -> (String, String, Int) -> String
defLocLine ctx p =
  "${firstOf p}|${dropPrefixMeta "${contextDir ctx}/" (firstOf (secondOf p))}|${strFromInt (secondOf (secondOf p))}"

-- 布局摘要：排序后的模块 × 定义位置（相对包目录的文件 + startLine）。产物里的
-- `dt_def_locs` 由它决定；与源字节/注释/绝对路径无关。
layoutDigestOf : PackageContext -> List ModuleIface -> String
layoutDigestOf ctx modules =
  addrOf
    ("split-layout" :: concatMap (\m => map (\p => "${miNameOf m}|${defLocLine ctx p}") (miDefLocsOf m)) (sortModuleIfaces modules))

-- | 语义 key：本包接口面 / 产物面 / 布局（span 行号）+ **产物口径**（摘要 / 全量、
--   printResult）+ **依赖身份** + 编译器 tag。
--
-- 依赖身份必须进 key：产物文件集包含依赖包的单元，只改依赖包（本包源码不变）时
-- 语义 key 若不换，`split-identity-hit` 会复用含旧依赖单元的 blob。产物口径同理：
-- 摘要路径与全量路径的 runtime defloc 表不同。
splitIdentityOf : PackageContext -> Bool -> String -> List ModuleIface -> String -> String -> String
splitIdentityOf ctx printResult tag modules kind deps =
  let
    pkg = contextPackageName ctx
    pr = if printResult then "1" else "0"
  in addrOf
    ["split-identity", splitNodeSchema, pkg, pr, kind, deps, pkgIfaceHashOfModules pkg modules, pkgImplHashOfModules pkg modules, layoutDigestOf ctx modules, tag]

-- | 链接工具链身份：视图里放的是**链接产物**，它由生成的 .ml 与链接工具链共同决定。
-- `views/bin` 的 key 因此 = 产物输入摘要 + 工具链身份；统一 store 下不会把别的工具链
-- 链出来的二进制当成同一次构建。优先 `VUNA_OCAML_ID`（构建图注入，免一次子进程），
-- 否则现跑 `ocamlopt -version`（只发生在 `build` 路径，`check` / `--no-compile` 不付）。
-- 取不到 ⇒ `none`（仍可构建，只是不同工具链的视图不区分）。
export toolchainIdEff : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Eff r String
toolchainIdEff =
  do
    override <- envGetEnv "VUNA_OCAML_ID"
    if override /= "" then
      pure override
    else
      do
        base <- cacheBase
        _ <- storeEnsureDirEff "${base}/.tmp"
        let
          path = "${base}/.tmp/ocamlopt-version"
        in do
          _ <- processRunIn "." ["sh", "-c", "ocamlopt -version > \"${path}\" 2>/dev/null || true"]
          exists <- fsFileExists path
          if exists then
            do
              text <- fsReadFile path
              pure (if trim text == "" then "none" else trim text)
          else
            pure "none"

-- | build 视图的地址：产物输入摘要 + 链接工具链身份。默认输出目录就是
-- `$VUNA_STORE/views/bin/<该摘要>`，`.output` 只是指向它的符号链接。
export buildViewAddrOf : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => SplitInputs -> Eff r String
buildViewAddrOf inputs =
  do
    tool <- toolchainIdEff
    pure (addrOf ["view-bin", splitInOf inputs.siMods, tool])

-- | check 的判定摘要：四个输入摘要 + 包 + kind。存在即「判过」。
checkInOf : CheckMods -> String
checkInOf m =
  addrOf
    ["check-outcome", m.cmPkg, m.cmKind, m.cmManifest, m.cmSources, m.cmDeps, m.cmVer, m.cmFlags]

-- | 写 blob（内容不变就不写：同一产物被多次构建复用时零写放大）。
-- 调用方传入**已规范化**的列表：digest 与产物顺序都按规范序取，原始 codegen 顺序不落盘。
writeSplitBlob : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List SplitFile -> Eff r String
writeSplitBlob files =
  do
    let
      payload = encTop encSplitFiles files
      digest = payloadDigest payload
    in do
      tag <- splitBlobTag
      path <- splitBlobPath digest
      base <- cacheBase
      _ <- storeEnsureDirEff "${base}/blobs"
      _ <- storeWriteIfChangedAsEff tag splitCacheCodec digest path payload
      pure digest

-- | 读 blob：framing 全量校验（**重算**载荷内容地址，不只是比对头声明）+ 内容地址比对
-- 通过才解码；任何不符 ⇒ Nothing（重算并重写同一路径）。
--
-- split 载荷没有 iface 那种逐字段语义自证，所以不能走
-- `storeReadAsEff`（只比头里的地址字符串，同长度载荷篡改会静默进入解码器 → 损坏的
-- codegen 产物）。重算成本是 `contentAddress` 的预折叠 + SHA-256（~2.2 ms/MB），
-- 只在 split 命中路径付一次；载荷中部的单字节篡改因此真正被拒绝。
readSplitBlob : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r (Maybe (List SplitFile))
readSplitBlob digest =
  do
    tag <- splitBlobTag
    path <- splitBlobPath digest
    -- 路径是输入地址；framing 头记内容地址，`storeReadEff` 重算并校验
    -- （截断/篡改必须被拒绝，不能把坏载荷当产物写出去）。
    payload <- storeReadEff tag splitCacheCodec path
    pure (
        case payload of
          Just bytes => decSplitFilesComplete bytes
          Nothing => Nothing
      )
