module Vuna.Compiler.Driver.Wasm where

-- WAT 目标驱动。
--
-- 复用 DT 检查 + `Lowering.lowerProgramOf` 得到整程序 IR，再交给
-- `Wasm.Module.build` / `Wasm.Render.render`，写到 `OUT/main.wat`。
-- 边界：不 import Core/Elab/Intrinsics；只经由 Driver.Dt 与 Lowering。
import Base.Effect.Types as EffTypes
import Base.Data.Int as Int
import Base.Data.Pair as Pair
import Vuna.Compiler.Base.Capabilities
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diag
import Vuna.Compiler.Base.Diagnostics.Warning
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Ir.Model
import Vuna.Compiler.Lowering.Program
import Vuna.Compiler.Wasm.Model
import Vuna.Compiler.Wasm.Module
import Vuna.Compiler.Wasm.Render
import Base.Effect.Fs as EffFs
import Base.Effect.Env as EffEnv
import Base.Effect.Process as EffProcess

wasmErrDiag : WasmErr -> Diagnostic
wasmErrDiag err = diagNoLoc SevError PhCodegen CatCodegen "" (wasmErrText err)

-- | 入口行里在当前目标上不可用的内建效应：产物能生成，但这些效应一旦执行就 trap，
-- 所以在构建期给出告警。
entryCapabilityWarnings : String -> IrProgram -> List Diagnostic
entryCapabilityWarnings target program =
  case program.irProgUnit.irUnitEntry of
    Nothing => []
    Just entry => capWarnings target entry.irEntryRowTags

capWarnings : String -> List String -> List Diagnostic
capWarnings target [] = []
capWarnings target (tag :: rest) =
  if isUnavailable (capabilityOf target tag) then
    targetEffectWarn target tag :: capWarnings target rest
  else
    capWarnings target rest

isUnavailable : Capability -> Bool
isUnavailable CapUnavailable = True
isUnavailable CapAvailable = False

export compileWasm : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Bool -> String -> Eff r (Check (Pair Int (List Diagnostic)))
compileWasm ctx entry printResult outDir =
  do
    _ <- ensureDirPath outDir
    checked <- dtCheckWithProgramParts ctx entry
    case checked of
      ErrC e => pure (ErrC e)
      OkC pair =>
        let
          pkg = secondOf pair
        in case lowerProgramOf pkg.checkedProgram.dtProgDatas pkg.checkedProgram.dtProgDefs of
          ErrC e => pure (ErrC e)
          OkC program =>
            case build program printResult of
              WasmRejected err => pure (ErrC (wasmErrDiag err))
              WasmOk m =>
                do
                  _ <- fsWriteFile "${outDir}/main.wat" (renderModule m)
                  pure (OkC (Pair 1 (entryCapabilityWarnings "wasm" program)))
