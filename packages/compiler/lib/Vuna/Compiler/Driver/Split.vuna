module Vuna.Compiler.Driver.Split where

-- 分离编译的输出文件模型与构建脚本生成。
--
-- Driver.SplitGen.generateDtSplitProgram 产出 `List SplitFile`（相对文件名 + 内容 +
-- 该单元的直接依赖单元名）；本模块负责落盘并生成**分层并行**的增量构建脚本：
--   - 跨单元引用用全限定 OCaml 名字，每个单元只依赖它真正引用的前序单元，
--     依赖图不退化为「open 全部前序」的全序链；
--   - 分层由 vuna 侧预先算好（splitLayers：depth(u) = 1 + max(depth(dep))，无依赖
--     depth = 0）：同层单元互不依赖，脚本逐层编译、层内多单元用后台任务并行；
--   - 增量判据 = 本单元 .ml/.mli + **直接依赖** 的 .stamp 内容哈希（同输入
--     同产物，不依赖 mtime），改一个单元只重编它的直接/传递依赖者；
--   - 最后按依赖拓扑序链接成可执行文件。
-- 构建脚本只用 POSIX sh + ocamlopt，可在 Nix 沙箱内复现。
import Base.Data.Sort as Sort
import Vuna.Compiler.Base.Bytes
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Hash
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes

export record SplitFile(..) where
  splitName : String
  splitText : String
  splitDeps : List String

-- 该输出文件所在编译单元的直接依赖（单元名 = 模块名 sanitize 后，无扩展名）。

-- 落盘是宿主动作，显式在 `Eff []` 里；文件内容/依赖图计算保持纯。
export writeSplitFiles : Member nFs FsOp r => String -> List SplitFile -> Eff r (Check Int)
writeSplitFiles dir [] = pure (OkC 0)
writeSplitFiles dir (f :: rest) =
  do
    restR <- writeSplitFiles dir rest
    case restR of
      ErrC e => pure (ErrC e)
      OkC n =>
        do
          _ <- fsWriteFile "${dir}/${splitName f}" (splitText f)
          pure (OkC (n + 1))

-- 只写内容变化的文件（build 的逐模块增量写盘；内容相同不 touch）。
export writeSplitFilesIfChanged : Member nFs FsOp r => String -> List SplitFile -> Eff r (Check Int)
writeSplitFilesIfChanged dir [] = pure (OkC 0)
writeSplitFilesIfChanged dir (f :: rest) =
  do
    restR <- writeSplitFilesIfChanged dir rest
    case restR of
      ErrC e => pure (ErrC e)
      OkC n =>
        let
          path = "${dir}/${splitName f}"
          text = splitText f
        in do
          exists <- fsFileExists path
          if exists then
            do
              old <- fsReadFile path
              if old == text then
                pure (OkC (n + 1))
              else
                do
                  _ <- fsWriteFile path text
                  pure (OkC (n + 1))
          else
            do
              _ <- fsWriteFile path text
              pure (OkC (n + 1))

-- 编译单元依赖图：按输出顺序取 .ml（跳过 .mli），unit = 文件名去掉 ".ml"；
-- deps 原样保留（已是直接依赖单元名，保持顺序、不去重）。
export splitGraph : List SplitFile -> List (String, List String)
splitGraph [] = []
splitGraph (f :: rest) =
  let
    name = splitName f
  in if endsWith ".ml" name then
    (::) (stripMl name, splitDeps f) (splitGraph rest)
  else
    splitGraph rest

stripMl : String -> String
stripMl name = substring 0 (byteLength name - 3) name

-- 按直接依赖分层。graph 是拓扑序（依赖在前），一遍扫描即可算出所有层的 depth：
--   depth(unit) = 1 + max(depth(dep))；无依赖 depth = 0；dep 不在 graph 里按 depth 0 计。
-- 层内保持 graph 顺序（确定），层间按 depth 升序。
export splitLayers : List (String, List String) -> List (List (String, List String))
splitLayers [] = []
splitLayers graph =
  let
    depths = splitDepths graph (HashMap.fromList [])
    maxD = graphMaxDepth graph depths 0
  in map (\d => filter (\q => depthOfUnit depths (firstOf q) == d) graph) (range 0 (maxD + 1))

-- 扫描 graph 建 depth 表；依赖都已在前（拓扑序），因此一遍就够。
splitDepths : List (String, List String) -> HashMap String Int -> HashMap String Int
splitDepths [] depths = depths
splitDepths ((unit, deps) :: rest) depths =
  splitDepths rest (HashMap.insert unit (depthOfDeps depths deps) depths)

-- depth(unit) = 1 + max(depth(dep))；空依赖 = 0。
depthOfDeps : HashMap String Int -> List String -> Int
depthOfDeps depths [] = 0
depthOfDeps depths (dep :: rest) = maxInt (depthOfUnit depths dep + 1) (depthOfDeps depths rest)

depthOfUnit : HashMap String Int -> String -> Int
depthOfUnit depths unit =
  case HashMap.lookup unit depths of
    Just d => d
    Nothing => 0

graphMaxDepth : List (String, List String) -> HashMap String Int -> Int -> Int
graphMaxDepth [] depths acc = acc
graphMaxDepth ((unit, deps) :: rest) depths acc =
  graphMaxDepth rest depths (maxInt acc (depthOfUnit depths unit))

maxInt : Int -> Int -> Int
maxInt a b = if a > b then a else b

-- 构建脚本；graph 是 (单元名, 直接依赖单元名) 的拓扑序（依赖在前，链接顺序即 graph 顺序）。
-- cFiles 是包根 `ffi/*.c` 复制到 OUTDIR 后的相对路径（如 `ffi/add.c`），
-- 由 ocamlopt 编译成 .o 并参与链接；空列表时不编译任何 C 文件。
-- 并行度由 `$JOBS` 决定（`VUNA_BUILD_JOBS` > `NIX_BUILD_CORES` > `nproc`）：
--   * 干净构建（没有 .cmx，例如 Nix 构建 seed / stage1）**且 JOBS ≤ 1**：一次 ocamlopt
--     调用，避免几十次进程启动（单核下分层并行的进程/I/O 开销反而更慢）；
--   * 其余情况（干净 + 多核，或已有 .cmx 的增量）：按**内容哈希**（.ml/.mli + 直接依赖
--     .stamp）逐单元编译，同层 `&` 并行 + 层间 `wait` 收尾。
-- 单元表只写一份（`UNIT_TABLE`）：编译、stamp 与链接顺序都从它派生。
export buildScript : List (String, List String) -> List String -> String
buildScript graph cFiles = """#!/bin/sh
# 由 vuna 生成：分离编译构建脚本（直接依赖表 + 内容哈希增量 + 分层并行）。用法: ./build.sh [OUT]
# 单元表在本文件末尾的 `VUNA_UNIT_TABLE` 里：`@` 分隔并行层，其余每行 `单元 直接依赖...`
# （拓扑序）。干净构建且 JOBS<=1：一次 ocamlopt 编译全部 .mli/.ml；其余按内容哈希逐单元编译。
set -eu
cd \"$(dirname \"$0\")\"
OUT=\${1:-program}
FLAGS=\"-g -w -a+39 -warn-error +39\"
JOBS=\${VUNA_BUILD_JOBS:-}
if [ -z \"$JOBS\" ]; then
  JOBS=$(nproc 2>/dev/null || echo 1)
  case \"\${NIX_BUILD_CORES:-}\" in
    ''|*[!0-9]*) ;;
    0) ;;
    *) JOBS=$NIX_BUILD_CORES ;;
  esac
fi
C_MODULES=\"${spaceJoin cFiles}\"
C_OBJS=\"\"
if [ -n \"$C_MODULES\" ]; then
  for c in $C_MODULES; do ocamlopt -I +unix -c \"$c\"; b=\${c##*/}; C_OBJS=\"$C_OBJS \${b%.c}.o\"; done
fi
hash_of() {
  for f in \"$@\"; do
    if [ -f \"$f\" ]; then cat \"$f\"; else printf '%s' '-'; fi
  done | sha256sum | awk '{print $1}'
}
stamp_want() {
  base=$1
  shift
  deps=\"\"
  for d in \"$@\"; do deps=\"$deps $d.stamp\"; done
  hash_of \"$base.ml\" \"$base.mli\" $deps
}
compile_mod() {
  base=$1
  shift
  want=$(stamp_want \"$base\" \"$@\")
  if [ -f \"$base.cmx\" ] && [ -f \"$base.stamp\" ] && [ \"$(cat \"$base.stamp\")\" = \"$want\" ]; then return 0; fi
  echo \"compile $base\"
  if [ -f \"$base.mli\" ]; then ocamlopt $FLAGS -I +unix -c \"$base.mli\"; fi
  ocamlopt $FLAGS -I +unix -c \"$base.ml\"
  printf '%s' \"$want\" > \"$base.stamp\"
}
pids=\"\"
flush_layer() {
  for p in $pids; do wait \"$p\" || exit 1; done
  pids=\"\"
}
# 按单元表驱动，四种用途共用同一份依赖表：
#   clean    探测是否已有 .cmx（决定走单次调用还是逐单元路径）
#   source   收集单次 ocamlopt 的全部输入（SOURCES）与链接序（CMXS）
#   parallel 逐层并行编译：层内 `&`，层末 flush_layer 逐个 wait
#   stamps   干净构建后补写每单元 .stamp（增量构建的输入）
each_unit() {
  mode=$1
  while IFS= read -r line; do
    case \"$line\" in
      ''|'#'*) continue ;;
      '@') flush_layer; continue ;;
    esac
    set -- $line
    base=$1
    shift
    case \"$mode\" in
      clean) if [ -f \"$base.cmx\" ]; then clean=0; fi ;;
      source)
        CMXS=\"$CMXS $base.cmx\"
        if [ -f \"$base.mli\" ]; then SOURCES=\"$SOURCES $base.mli\"; fi
        SOURCES=\"$SOURCES $base.ml\"
        ;;
      parallel)
        CMXS=\"$CMXS $base.cmx\"
        compile_mod \"$base\" \"$@\" &
        pids=\"$pids $!\"
        ;;
      stamps) printf '%s' \"$(stamp_want \"$base\" \"$@\")\" > \"$base.stamp\" ;;
    esac
  done <<'VUNA_UNIT_TABLE'
${unitTableText (splitLayers graph)}VUNA_UNIT_TABLE
  flush_layer
}
clean=1
each_unit clean
if [ \"$clean\" -eq 1 ] && [ \"$JOBS\" -le 1 ]; then
  SOURCES=\"\"
  CMXS=\"\"
  each_unit source
  ocamlopt $FLAGS -I +unix -o \"$OUT\" unix.cmxa $SOURCES $C_OBJS
  each_unit stamps
  echo \"built $OUT\"
  exit 0
fi
CMXS=\"\"
each_unit parallel
ocamlopt $FLAGS -I +unix -o \"$OUT\" unix.cmxa $CMXS $C_OBJS
echo \"built $OUT\"
"""

-- 单元表：一层若干行 `单元 直接依赖...`，层间用 `@` 分隔（同层互不依赖，可并行）。
unitTableText : List (List (String, List String)) -> String
unitTableText [] = ""
unitTableText (layer :: rest) = tableRows layer ++ tableRest rest

tableRows : List (String, List String) -> String
tableRows [] = ""
tableRows ((unit, deps) :: rest) = "${unit}${depsSuffix deps}\n${tableRows rest}"

tableRest : List (List (String, List String)) -> String
tableRest [] = ""
tableRest (layer :: rest) = "@\n${tableRows layer}${tableRest rest}"

spaceJoin : List String -> String
spaceJoin [] = ""
spaceJoin (name :: rest) = "${name} ${spaceJoin rest}"

depsSuffix : List String -> String
depsSuffix [] = ""
depsSuffix (dep :: rest) = " ${dep}${depsSuffix rest}"

-- | 实际依赖图是否有环：深度松弛在 DAG 上最多 n 轮收敛（最长路径 ≤ n-1）；环上每轮
-- 仍在增长，燃料用尽即未收敛。`canonicalTopo` 的前置条件。
export splitGraphAcyclic : List SplitFile -> Bool
splitGraphAcyclic files =
  let
    graph = splitGraph files
    baseMemo = HashMap.fromList (map (\p => (firstOf p, 0)) graph)
  in convergedWithin (length graph + 2) graph baseMemo

convergedWithin : Int -> List (String, List String) -> HashMap String Int -> Bool
convergedWithin fuel graph memo =
  if fuel <= 0 then
    False
  else
    let
      next = stepDepths memo graph
    in if sameDepthTable memo next then True else convergedWithin (fuel - 1) graph (HashMap.fromList next)

-- 把 split 文件列表规范化为**确定性拓扑序**（依赖在前；同层按名字哈希
-- 排序）。`SplitFile` 的列表顺序不能随生成路径变化，build.sh 的层/顺序不能因此漂移
-- （否则增量/全量产物不一致）。深度用迭代松弛算（与列表顺序无关）。
--
-- 三处叠加的 O(n²) 必须避开：① 迭代松弛每轮对每个依赖线性扫 memo 表；② 排序每次
-- 比较重算 SHA-256 的 `unitTieKey`；③ 排序结果按名在 `files` 里线性找文件。做法：
--   ① 迭代松弛改用 `HashMap String Int` memo（每轮查找 O(1)，缺失键按 0）；
--   ② graph 单元 + 全部依赖去重成表，每个名字只算一次 tie key；
--   ③ `HashMap String SplitFile` 文件名索引。
-- 不变量：depth 是最长路径的不动点、稳定排序（`Base.Data.Sort.sortBy`）、同 depth 内按
-- `unitTieKey` 升序（`<=`）。
unitTieKey : String -> Int
unitTieKey name = Vuna.Compiler.Base.Hash.contentKey "t:${name}"

-- 名字集合（graph 单元 + 全部直接依赖）：tie key 只对唯一名字各算一次 SHA-256。
nameSetOf : List (String, List String) -> HashMap String Bool -> HashMap String Bool
nameSetOf [] seen = seen
nameSetOf ((unit, deps) :: rest) seen =
  nameSetOf rest (markNames deps (HashMap.insert unit True seen))

markNames : List String -> HashMap String Bool -> HashMap String Bool
markNames [] seen = seen
markNames (n :: rest) seen = markNames rest (HashMap.insert n True seen)

tieTableOf : List (String, List String) -> HashMap String Int
tieTableOf graph =
  HashMap.fromList
    (map (\n => (n, unitTieKey n)) (map firstOf (HashMap.toList (nameSetOf graph (HashMap.fromList [])))))

tieOf : HashMap String Int -> String -> Int
tieOf ties name =
  case HashMap.lookup name ties of
    Just k => k
    Nothing => 0

-- 迭代松弛到不动点：depth(u) = 1 + max(depth(dep))（无依赖 = 0；dep 不在 graph 按 0）。
-- 每轮用上一轮的 depth 同步更新；HashMap 让每轮查找 O(1)。
maxDepth : HashMap String Int -> List String -> Int
maxDepth memo [] = 0 - 1
maxDepth memo (d :: rest) =
  let
    dd = depthOfUnit memo d
    mm = maxDepth memo rest
  in if dd > mm then dd else mm

stepDepths : HashMap String Int -> List (String, List String) -> List (String, Int)
stepDepths memo [] = []
stepDepths memo (p :: rest) =
  let
    md = maxDepth memo (secondOf p)
  in (firstOf p, if md < 0 then 0 else md + 1) :: stepDepths memo rest

-- 层表键集固定（graph 的单元名），逐项比同值。
sameDepthTable : HashMap String Int -> List (String, Int) -> Bool
sameDepthTable memo [] = True
sameDepthTable memo (p :: rest) =
  depthOfUnit memo (firstOf p) == secondOf p && sameDepthTable memo rest

fixDepths : Int -> List (String, List String) -> HashMap String Int -> HashMap String Int
fixDepths fuel graph memo =
  if fuel <= 0 then
    memo
  else
    let
      next = stepDepths memo graph
    in if sameDepthTable memo next then memo else fixDepths (fuel - 1) graph (HashMap.fromList next)

-- 排序键 = (depth, tieKey)；预计算后比较只碰 Int。
depthEntryLess : ((Int, Int), String) -> ((Int, Int), String) -> Bool
depthEntryLess a b =
  if firstOf (firstOf a) /= firstOf (firstOf b) then
    firstOf (firstOf a) < firstOf (firstOf b)
  else
    secondOf (firstOf a) <= secondOf (firstOf b)

sortDepthEntries : List ((Int, Int), String) -> List ((Int, Int), String)
sortDepthEntries xs = sortBy depthEntryLess xs

-- 文件名索引：查 `${unit}.ml`；非 .ml 项不参与。
filesOfDepthEntries : HashMap String SplitFile -> List String -> List SplitFile
filesOfDepthEntries table [] = []
filesOfDepthEntries table (unit :: rest) =
  case HashMap.lookup "${unit}.ml" table of
    Just f => f :: filesOfDepthEntries table rest
    Nothing => filesOfDepthEntries table rest

export canonicalTopo : List SplitFile -> List SplitFile
canonicalTopo files =
  let
    graph = splitGraph files
    ties = tieTableOf graph
    fileTable = HashMap.fromList (map (\f => (splitName f, f)) files)
    baseMemo = HashMap.fromList (map (\p => (firstOf p, 0)) graph)
    depths = fixDepths (length graph + 2) graph baseMemo
    keyed = map (\p => ((depthOfUnit depths (firstOf p), tieOf ties (firstOf p)), firstOf p)) graph
    ordered = map secondOf (sortDepthEntries keyed)
  in map (normalizeFileDeps ties) (filesOfDepthEntries fileTable ordered)

sortDepsByTie : HashMap String Int -> List String -> List String
sortDepsByTie ties deps = map firstOf (sortDepEntries (map (\d => (d, tieOf ties d)) deps))

sortDepEntries : List (String, Int) -> List (String, Int)
sortDepEntries xs = sortBy (\a, b => secondOf a <= secondOf b) xs

normalizeFileDeps : HashMap String Int -> SplitFile -> SplitFile
normalizeFileDeps ties f = SplitFile (splitName f) (splitText f) (sortDepsByTie ties (splitDeps f))

-- ---------------------------------------------------------------
-- 规范编码（audit 对拍签名）
-- ---------------------------------------------------------------
-- `SplitFile` 是 codegen 的输出模型（文件名 + 文本 + 直接依赖单元名）。显式编码后逐字节
-- 稳定，供 `VUNA_IFACE_AUDIT` 比较两条路径的产物。
--
-- | `SplitFile` 的规范编码：名字 / 文本 / 依赖表。
export encSplitFile : SplitFile -> List String -> List String
encSplitFile f acc = encStr f.splitName (encStr f.splitText (encList encStr f.splitDeps acc))

-- | `List SplitFile` 的规范编码（audit 对拍签名）。
export encSplitFiles : List SplitFile -> List String -> List String
encSplitFiles fs acc = encList encSplitFile fs acc
