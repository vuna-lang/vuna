module Vuna.Compiler.Ir.Cps where

-- Vuna.Compiler.Ir.Cps：把 `Eff` / `Scoped` 的 thunk 降到显式 CPS。
--
-- 只改写**效应 thunk**，纯代码保持直接风格：
--   * `MkEff` / `MkScoped` 的 lambda 增加 continuation 参数 `k`；
--   * thunk 的运行点（`case e of MkEff f => f u`、`runThunk e u`）追加 `k`；
--   * `prim_effectPerform` / `prim_effectHandle` / `prim_effectSelf` 换成 CPS
--     运行时符号（`@ir@cps@*`），由后端实现；
--   * `runPure` / `runEff` / `runMain` / `handleScoped` 是 trampoline 边界，传 identity。
--
-- `cpsExpr` 的 continuation 是**运行时值**（`Ir` 表达式），不是编译器函数：这样递归
-- 只发生在子项上，终止性检查能看到结构下降。纯代码只重建，不改调用约定。
--
-- 边界：本模块只 import `Ir.Model` 与 Base 的纯数据结构；不 import Core / Elab /
-- Intrinsics / 任何后端。输出仍是 `Ir`；CPS 符号只由本模块产生，后端按需实现。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.Result as Result
import Base.Data.String as String
import Vuna.Compiler.Ir.Model

-- ---------------------------------------------------------------
-- 协议名字
-- ---------------------------------------------------------------
-- | CPS 版 perform / handle / self。只有本模块产生；不在 `Ir.Runtime` 契约里，
-- 因为它们是后端 lowering 的内部约定，不是用户面内建。
export irCpsPerformName : String
irCpsPerformName = "@ir@cps@perform"

export irCpsHandleName : String
irCpsHandleName = "@ir@cps@handle"

export irCpsSelfName : String
irCpsSelfName = "@ir@cps@self"

export irMPerformName : String
irMPerformName = "@ir@m@perform"

export irMHandleName : String
irMHandleName = "@ir@m@handle"

export irMSelfName : String
irMSelfName = "@ir@m@self"

-- | 机器转移：mode 6 里 continuation 调用一律 `@ir@m@apply`（返回 Control），
-- 由机器循环单层派发；这是「续延不返回值」的唯一形态。
export irMApplyName : String
irMApplyName = "@ir@m@apply"

export irMRunEffName : String
irMRunEffName = "@ir@m@runEff"

export irMRunName : String
irMRunName = "@ir@m@run"

export irMDoneName : String
irMDoneName = "@ir@m@done"

-- | `Scoped` 的运行时类型 / 构造子名（`Base.Effect.Core.Scoped`）。
export irScopedTypeName : String
irScopedTypeName = "Base.Effect.Core.Scoped"

export irScopedMkCtor : String
irScopedMkCtor = "Base.Effect.Core.Scoped.MkScoped"

-- | trampoline 边界的定义名。
runThunkName : String
runThunkName = "Base.Effect.Core.runThunk"

runPureName : String
runPureName = "Base.Effect.Core.runPure"

runEffName : String
runEffName = "Base.Effect.Core.runEff"

runMainName : String
runMainName = "Base.Effect.Core.runMain"

handleScopedName : String
handleScopedName = "Base.Effect.Core.handleScoped"

-- | 预算按项规模派生（每节点最多几步）：固定 200000 对超大单元会让某个 pass 静默半途而废
-- （函数体原样返回），产物因此既不是纯 IR 也不是 CPS。派生后耗尽不可由输入规模触发。
cpsFuelBase : Int
cpsFuelBase = 64

cpsFuelOfBody : Ir -> Int
cpsFuelOfBody body = cpsFuelBase + 8 * irSize body

cpsDefsSize : List IrDef -> Int
cpsDefsSize [] = 0
cpsDefsSize (d :: rest) =
  case irDefBody d of
    Nothing => 1 + cpsDefsSize rest
    Just b => 1 + irSize b + cpsDefsSize rest

cpsFuelOfDefs : List IrDef -> Int
cpsFuelOfDefs defs = cpsFuelBase + 8 * cpsDefsSize defs

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
bNameEq : IrBName -> IrBName -> Bool
bNameEq (IrBUser x) (IrBUser y) = x == y
bNameEq (IrBArm x) (IrBArm y) = x == y
bNameEq (IrBNat x) (IrBNat y) = x == y
bNameEq IrBWild IrBWild = True
bNameEq _ _ = False

binderEq : IrBinder -> IrBinder -> Bool
binderEq (IrBinder na ea ta) (IrBinder nb eb tb) = bNameEq na nb && ea == eb

memBinder : IrBinder -> List IrBinder -> Bool
memBinder _ [] = False
memBinder b (x :: rest) = binderEq b x || memBinder b rest

binderErased : IrBinder -> Bool
binderErased (IrBinder _ erased _) = erased

-- | 运行时 binder（擦除占位不进作用域）。
runtimeBinders : List IrBinder -> List IrBinder
runtimeBinders bs = filter (\b => not (binderErased b)) bs

mkBinder : String -> IrBinder
mkBinder name = mkIrBinder name

-- binder 名字带燃料编号：同一路径上燃料严格递减，嵌套 binder 不会撞名
-- （binder 身份是 name + erased，纯同名会被内层遮蔽）。
freshV : Int -> IrBinder
freshV fuel = mkBinder ("__cpsV" ++ strFromInt fuel)

freshK : Int -> IrBinder
freshK fuel = mkBinder ("__cpsK" ++ strFromInt fuel)

freshU : Int -> IrBinder
freshU fuel = mkBinder ("__cpsU" ++ strFromInt fuel)

freshA : Int -> Int -> IrBinder
freshA fuel i = mkBinder ("__cpsA" ++ strFromInt fuel ++ "_" ++ strFromInt i)

applyAll : Ir -> List Ir -> Ir
applyAll f [] = f
applyAll f (a :: rest) = applyAll (IrApp Nothing f a) rest

flattenApp : Ir -> Pair Ir (List Ir)
flattenApp (IrApp _ f a) =
  let
    p = flattenApp f
  in Pair (firstOf p) (append (secondOf p) [a])
flattenApp x = Pair x []

-- | 直接递归的列表映射：避免把递归调用藏在 `map` 的 lambda 里（SCT 看不到）。
mapDirect : Int -> List Ir -> List Ir
mapDirect fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => transformDirect (fuel - 1) x :: mapDirect (fuel - 1) rest

mapAltDirect : Int -> List IrAlt -> List IrAlt
mapAltDirect fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      a :: rest => transformAltDirect (fuel - 1) a :: mapAltDirect (fuel - 1) rest

mapAltCps : Int -> List IrBinder -> List IrAlt -> Ir -> List IrAlt
mapAltCps fuel env xs k =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      a :: rest => cpsAlt (fuel - 1) env a k :: mapAltCps (fuel - 1) env rest k

mapFieldsDirect : Int -> List (Pair String Ir) -> List (Pair String Ir)
mapFieldsDirect fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      p :: rest => Pair (firstOf p) (transformDirect (fuel - 1) (secondOf p)) :: mapFieldsDirect (fuel - 1) rest

-- | thunk 构造子：`MkEff` 或 `MkScoped`。
isThunkCtor : String -> String -> Bool
isThunkCtor family ctor =
  family
    == irEffTypeName && ctor == irEffMkCtor || family == irScopedTypeName && ctor == irScopedMkCtor

isThunkAlt : IrAlt -> Bool
isThunkAlt alt =
  case alt.irAltCtor of
    Just (Pair family ctor) => isThunkCtor family ctor
    Nothing => False

-- | 一个 case 分支引入的 thunk binder（只对 `MkEff` / `MkScoped` 分支）。
thunkBindersOfAlt : IrAlt -> List IrBinder
thunkBindersOfAlt alt = if isThunkAlt alt then runtimeBinders alt.irAltBinders else []

-- | identity continuation：`\v => v`。
identityCont : Ir
identityCont =
  let
    v = mkBinder "__cpsId"
  in IrLam [v] Nothing (IrVar v)

-- ---------------------------------------------------------------
-- CPS 变换
-- ---------------------------------------------------------------
-- `cpsExpr env e k`：`k` 是运行时 continuation 值。返回的 IR 求值 `e` 后把结果交给
-- `k`；thunk 运行点会把 `k` 作为被调 thunk 的最后一个实参。
cpsExpr : Int -> List IrBinder -> Ir -> Ir -> Ir
cpsExpr fuel env e k =
  if fuel <= 0 then
    IrApp Nothing k (transformDirect (fuel - 1) e)
  else
    case e of
      IrApp _ _ _ => cpsApp (fuel - 1) env e k
      IrCase caseTy _ scrut alts =>
        let
          v = freshV fuel
          kCase = IrLam [v] Nothing (IrCase caseTy Nothing (IrVar v) (mapAltCps (fuel - 1) env alts k))
        in cpsExpr (fuel - 1) env scrut kCase
      IrNatCase scrut fresh zero succ catch =>
        let
          v = freshV fuel
          kCase = IrLam [v] Nothing (IrNatCase (IrVar v) fresh (cpsAltMaybe (fuel - 1) env zero k) (cpsAltMaybe (fuel - 1) env succ k) (cpsAltMaybe (fuel - 1) env catch k))
        in cpsExpr (fuel - 1) env scrut kCase
      IrIf c t el =>
        let
          v = freshV fuel
          kIf = IrLam [v] Nothing (IrIf (IrVar v) (cpsExpr (fuel - 1) env t k) (cpsExpr (fuel - 1) env el k))
        in cpsExpr (fuel - 1) env c kIf
      IrLet bs scrut body =>
        let
          v = freshV fuel
          kLet = IrLam [v] Nothing (IrLet bs (IrVar v) (cpsExpr (fuel - 1) env body k))
        in cpsExpr (fuel - 1) env scrut kLet
      IrCast cFrom cTo inner => IrCast cFrom cTo (cpsExpr (fuel - 1) env inner k)
      _ => IrApp Nothing k (transformDirect (fuel - 1) e)

cpsAlt : Int -> List IrBinder -> IrAlt -> Ir -> IrAlt
cpsAlt fuel env alt k =
  if fuel <= 0 then
    alt
  else
    let
      env1 = append (thunkBindersOfAlt alt) env
    in IrAlt alt.irAltCtor alt.irAltBinders (cpsExpr (fuel - 1) env1 alt.irAltBody k)

cpsAltMaybe : Int -> List IrBinder -> Maybe IrAlt -> Ir -> Maybe IrAlt
cpsAltMaybe fuel env m k =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just alt => Just (cpsAlt (fuel - 1) env alt k)

-- | 纯应用的实参求值（左→右）。`head` 已求值；最后 `applyAll head args` 交给 `k`。
cpsArgs : Int -> List IrBinder -> List Ir -> Ir -> List Ir -> Ir -> Ir
cpsArgs fuel env args head acc k =
  if fuel <= 0 then
    IrApp Nothing k (applyAll head (reverse acc))
  else
    case args of
      [] => IrApp Nothing k (applyAll head (reverse acc))
      a :: rest =>
        let
          v = freshV fuel
        in cpsExpr (fuel - 1) env a (IrLam [v] Nothing (cpsArgs (fuel - 1) env rest head (IrVar v :: acc) k))

-- | thunk 运行点：把 `k` 追加为最后一个实参。
cpsThunkCall : Int -> Ir -> List Ir -> Ir -> Ir
cpsThunkCall fuel head args k =
  if fuel <= 0 then
    applyAll head (append args [k])
  else
    applyAll (transformDirect (fuel - 1) head) (append (mapDirect (fuel - 1) args) [k])

-- | 应用脊椎：识别 thunk 运行 / CPS 原语；其余按纯应用处理（按值序 CPS）。
cpsApp : Int -> List IrBinder -> Ir -> Ir -> Ir
cpsApp fuel env e k =
  if fuel <= 0 then
    IrApp Nothing k e
  else
    let
      p = flattenApp e
      head = firstOf p
      args = secondOf p
      v = freshV fuel
    in case head of
      IrVar b => if memBinder b env then cpsThunkCall (fuel - 1) head args k else cpsExpr (fuel - 1) env head (IrLam [v] Nothing (cpsArgs (fuel - 1) env args (IrVar v) [] k))
      IrGlobal name => if name == runThunkName then cpsThunkCall (fuel - 1) head args k else cpsExpr (fuel - 1) env head (IrLam [v] Nothing (cpsArgs (fuel - 1) env args (IrVar v) [] k))
      IrRt sym =>
        case sym of
          "prim_effectPerform" => cpsThunkCall (fuel - 1) (IrRt irCpsPerformName) args k
          "prim_effectHandle" => cpsThunkCall (fuel - 1) (IrRt irCpsHandleName) args k
          "prim_effectSelf" => cpsThunkCall (fuel - 1) (IrRt irCpsSelfName) args k
          _ => cpsExpr (fuel - 1) env head (IrLam [v] Nothing (cpsArgs (fuel - 1) env args (IrVar v) [] k))
      _ => cpsExpr (fuel - 1) env head (IrLam [v] Nothing (cpsArgs (fuel - 1) env args (IrVar v) [] k))

-- ---------------------------------------------------------------
-- 直接风格部分：只改写嵌套的 thunk 构造
-- ---------------------------------------------------------------
transformDirect : Int -> Ir -> Ir
transformDirect fuel e =
  if fuel <= 0 then
    e
  else
    case e of
      IrCtor family ctor tyArgs args =>
        if isThunkCtor family ctor then
          case args of
            [IrLam bs _ body] =>
              let
                k = freshK fuel
                body1 = cpsExpr (fuel - 1) [] body (IrVar k)
              in IrCtor family ctor tyArgs [IrLam (append bs [k]) Nothing body1]
            _ => IrCtor family ctor tyArgs (mapDirect (fuel - 1) args)
        else
          IrCtor family ctor tyArgs (mapDirect (fuel - 1) args)
      IrEffThunk family ctor _unitTy arity prim =>
        let
          u = freshU fuel
          k = freshK fuel
          argBs = map (\i => freshA fuel i) (range 0 arity)
          applied = applyAll (transformDirect (fuel - 1) prim) (map IrVar argBs)
          inner = IrCtor family ctor Nothing [IrLam [u, k] Nothing (IrApp Nothing (IrVar k) applied)]
        in if arity <= 0 then inner else IrLam argBs Nothing inner
      IrRecord family resTy fields => IrRecord family resTy (mapFieldsDirect (fuel - 1) fields)
      IrProj base family field resTy => IrProj (transformDirect (fuel - 1) base) family field resTy
      IrRecUpd base family fields resTy => IrRecUpd (transformDirect (fuel - 1) base) family (mapFieldsDirect (fuel - 1) fields) resTy
      IrRtApp sym args => IrRtApp sym (mapDirect (fuel - 1) args)
      IrCast cFrom cTo inner => IrCast cFrom cTo (transformDirect (fuel - 1) inner)
      IrLet bs scrut body => IrLet bs (transformDirect (fuel - 1) scrut) (transformDirect (fuel - 1) body)
      IrLam bs rt body => IrLam bs rt (transformDirect (fuel - 1) body)
      IrApp appTy g a => IrApp appTy (transformDirect (fuel - 1) g) (transformDirect (fuel - 1) a)
      IrIf c t el => IrIf (transformDirect (fuel - 1) c) (transformDirect (fuel - 1) t) (transformDirect (fuel - 1) el)
      IrCase caseTy resTy scrut alts => IrCase caseTy resTy (transformDirect (fuel - 1) scrut) (mapAltDirect (fuel - 1) alts)
      IrNatCase scrut fresh zero succ catch => IrNatCase (transformDirect (fuel - 1) scrut) fresh (transformAltMaybe (fuel - 1) zero) (transformAltMaybe (fuel - 1) succ) (transformAltMaybe (fuel - 1) catch)
      IrConcatMany parts => IrConcatMany (mapDirect (fuel - 1) parts)
      IrVar _ => e
      IrGlobal _ => e
      IrRt _ => e
      IrInt _ => e
      IrStr _ => e
      IrBool _ => e
      IrFloatLit _ => e
      IrEffBind _ _ _ => e

transformAltDirect : Int -> IrAlt -> IrAlt
transformAltDirect fuel alt =
  if fuel <= 0 then
    alt
  else
    IrAlt alt.irAltCtor alt.irAltBinders (transformDirect (fuel - 1) alt.irAltBody)

transformAltMaybe : Int -> Maybe IrAlt -> Maybe IrAlt
transformAltMaybe fuel m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just alt => Just (transformAltDirect (fuel - 1) alt)

-- ---------------------------------------------------------------
-- 定义级：trampoline 边界
-- ---------------------------------------------------------------
-- `runPure e` / `runEff e` / `runMain e` 的体是 `runThunk e MkEffUnit`；在 CPS 里
-- 这个运行点需要 identity continuation。
trampolineBody : String -> Ir -> Result Ir
trampolineBody name (IrLam bs rt inner) =
  case trampolineBody name inner of
    Err msg => Err msg
    Ok inner1 => Ok (IrLam bs rt inner1)
trampolineBody name (IrCast cFrom cTo inner) =
  case trampolineBody name inner of
    Err msg => Err msg
    Ok inner1 => Ok (IrCast cFrom cTo inner1)
trampolineBody name (IrApp _ (IrApp _ (IrGlobal g) e) u) =
  if g == runThunkName then
    Ok (applyAll (IrGlobal g) [e, u, identityCont])
  else
    Err ("CPS: unexpected trampoline shape: " ++ name)
trampolineBody name _ = Err ("CPS: unexpected trampoline shape: " ++ name)

-- `handleScoped (MkScoped th) = prim_effectSelf th`：identity continuation。
selfAlt : Int -> IrAlt -> String -> Result IrAlt
selfAlt fuel alt name =
  if fuel <= 0 then
    Ok alt
  else
    case selfBody (fuel - 1) alt.irAltBody name of
      Err msg => Err msg
      Ok body1 => Ok (IrAlt alt.irAltCtor alt.irAltBinders body1)

selfAlts : Int -> List IrAlt -> String -> Result (List IrAlt)
selfAlts fuel alts name =
  if fuel <= 0 then
    Ok alts
  else
    case alts of
      [] => Ok []
      a :: rest =>
        case selfAlt (fuel - 1) a name of
          Err msg => Err msg
          Ok a1 =>
            case selfAlts (fuel - 1) rest name of
              Err msg => Err msg
              Ok rest1 => Ok (a1 :: rest1)

selfBody : Int -> Ir -> String -> Result Ir
selfBody fuel body name =
  if fuel <= 0 then
    Ok body
  else
    case body of
      IrLam bs rt inner =>
        case selfBody (fuel - 1) inner name of
          Err msg => Err msg
          Ok inner1 => Ok (IrLam bs rt inner1)
      IrCast cFrom cTo inner =>
        case selfBody (fuel - 1) inner name of
          Err msg => Err msg
          Ok inner1 => Ok (IrCast cFrom cTo inner1)
      IrCase caseTy resTy scrut alts =>
        case selfAlts (fuel - 1) alts name of
          Err msg => Err msg
          Ok alts1 => Ok (IrCase caseTy resTy scrut alts1)
      IrApp _ (IrRt sym) th => if sym == "prim_effectSelf" then Ok (applyAll (IrRt irCpsSelfName) [th, identityCont]) else Err ("CPS: unexpected handleScoped shape: " ++ name)
      _ => Err ("CPS: unexpected handleScoped shape: " ++ name)

transformDef : Int -> IrDef -> Result IrDef
transformDef fuel d =
  if fuel <= 0 then
    Ok d
  else
    case d of
      IrExternDef _ _ _ _ => Ok d
      IrDef name arity deps sigTy body recOk initGuard span =>
        if name == runPureName || name == runEffName || name == runMainName then
          case trampolineBody name body of
            Err msg => Err msg
            Ok body1 => Ok (IrDef name arity deps sigTy body1 recOk initGuard span)
        else if name == handleScopedName then
          case selfBody (fuel - 1) body name of
            Err msg => Err msg
            Ok body1 => Ok (IrDef name arity deps sigTy body1 recOk initGuard span)
        else
          Ok (IrDef name arity deps sigTy (transformDirect (fuel - 1) body) recOk initGuard span)

transformDefs : Int -> List IrDef -> Result (List IrDef)
transformDefs fuel xs =
  if fuel <= 0 then
    Ok xs
  else
    case xs of
      [] => Ok []
      d :: rest =>
        case transformDef (fuel - 1) d of
          Err msg => Err msg
          Ok d1 =>
            case transformDefs (fuel - 1) rest of
              Err msg => Err msg
              Ok rest1 => Ok (d1 :: rest1)

transformGroup : Int -> IrGroup -> Result IrGroup
transformGroup fuel g =
  if fuel <= 0 then
    Ok g
  else
    case transformDefs (fuel - 1) g.irGroupDefs of
      Err msg => Err msg
      Ok defs1 => Ok (IrGroup g.irGroupIsRec defs1)

transformGroups : Int -> List IrGroup -> Result (List IrGroup)
transformGroups fuel xs =
  if fuel <= 0 then
    Ok xs
  else
    case xs of
      [] => Ok []
      g :: rest =>
        case transformGroup (fuel - 1) g of
          Err msg => Err msg
          Ok g1 =>
            case transformGroups (fuel - 1) rest of
              Err msg => Err msg
              Ok rest1 => Ok (g1 :: rest1)

-- ---------------------------------------------------------------
-- 机器化 handler CPS（方案 2 第一层）：resumption 改成 (v, kRest)
-- ---------------------------------------------------------------
mBNameText : IrBName -> String
mBNameText (IrBUser x) = x
mBNameText (IrBArm i) = "arm" ++ strFromInt i
mBNameText (IrBNat i) = "nat" ++ strFromInt i
mBNameText IrBWild = "wild"

mIsOp : IrBinder -> Bool
mIsOp b =
  case b.irBinderName of
    IrBUser n => n == "@vuna@handle@o"
    _ => False

mResumption : List IrBinder -> Maybe IrBinder
mResumption bs = mResumeGo (runtimeBinders bs)

mResumeGo : List IrBinder -> Maybe IrBinder
mResumeGo [] = Nothing
mResumeGo (b :: rest) =
  if mIsOp b then
    case rest of
      r :: _ => Just r
      [] => Nothing
  else
    mResumeGo rest

mEraseHead : Ir -> Ir
mEraseHead (e@(IrApp _ (IrRt s) x)) = if s == "prim_erase" then mEraseHead x else e
mEraseHead (IrCast cFrom cTo x) = mEraseHead x
mEraseHead e = e

-- | 去掉外包的擦除包装（`prim_erase` / cast）：精化器会在运行时位置插一层，
-- resumption 调用因此可能是 `prim_erase (k v)` 而不是 `k v`。
mStripErase : Ir -> Ir
mStripErase (IrCast cFrom cTo x) = mStripErase x
mStripErase (IrApp _ (IrRt s) x) =
  if s == "prim_erase" then mStripErase x else IrApp Nothing (IrRt s) x
mStripErase x = x

mIsResumeApp : IrBinder -> Ir -> Bool
mIsResumeApp r e0 = mIsResumeAppGo r (mStripErase e0)

mIsResumeAppGo : IrBinder -> Ir -> Bool
mIsResumeAppGo r (e@(IrApp _ _ _)) =
  let
    p = flattenApp e
  in case mEraseHead (firstOf p) of
    IrVar b => mBNameText b.irBinderName == mBNameText r.irBinderName
    _ =>
      case secondOf p of
        x :: _ =>
          case mEraseHead x of
            IrVar b => mBNameText b.irBinderName == mBNameText r.irBinderName
            _ => False
        [] => False
mIsResumeAppGo r _ = False

mFreshV : Int -> IrBinder
mFreshV n = mkBinder ("__mchV" ++ strFromInt n)

mFreshK : Int -> IrBinder
mFreshK n = mkBinder ("__mchK" ++ strFromInt n)

-- | handler clause 的 kDone：尾位置 resume 用它作为段边界标记（`MkRestTail`）。
mFreshTailK : Int -> IrBinder
mFreshTailK n = mkBinder ("__mchTK" ++ strFromInt n)

mFreshR : Int -> IrBinder
mFreshR n = mkBinder ("__mchR" ++ strFromInt n)

-- | λ 的结果类型是不是 `Eff r a`：机器化 CPS 据此区分 `a -> Eff r b` 与普通函数。
-- `Eff` 的运行时实参记成 `[IrTyOpaque]`（结果类型不可命名时）；这里只比族名。
isEffResultTy : Maybe IrTy -> Bool
isEffResultTy (Just (IrTyData fam _)) = fam == irEffTypeName
isEffResultTy _ = False

isEffContLambda : Maybe IrTy -> Bool
isEffContLambda = isEffResultTy

-- | λ 体已经是 `MkEff (\u K -> …)`（mCps 已包过），避免后处理重复包一层。
isEffThunkBody : Ir -> Bool
isEffThunkBody (IrCtor family ctor _ ([IrLam _ _ _])) =
  family == irEffTypeName && ctor == irEffMkCtor
isEffThunkBody _ = False

-- | 用续延 K 跑一个 Eff 值：`case eff of MkEff th => runEff th K`。
mRunEffTerm : Ir -> Ir -> Ir
mRunEffTerm eff k =
  let
    th = mkBinder "__mEffTh"
  in IrCase
    Nothing
    Nothing
    eff
    [IrAlt (Just (Pair irEffTypeName irEffMkCtor)) [th] (IrRtApp irMRunEffName [IrVar th, k])]

mNoResumption : IrBinder
mNoResumption = mkBinder "@vuna@noresume"

-- | do 块续延 λ：保持一个参数（`>>=` 仍按 1 参调用），返回一个 Eff，其 thunk
-- 以 (u, K) 运行；resumption 的 kRest 接成 K。
mEffContLambda : Int -> IrBinder -> List IrBinder -> Maybe IrTy -> Ir -> Ir
mEffContLambda fuel r bs rt body =
  let
    kd = mFreshK fuel
    u = mkBinder "__mEffU"
    v = mFreshV fuel
  in IrLam
    bs
    rt
    (IrCtor irEffTypeName irEffMkCtor Nothing [IrLam [u, kd] Nothing (mCps (fuel - 1) r (IrLam [v] Nothing (mRunEffTerm (IrVar v) (IrVar kd))) body)])

mCpsAlts : Int -> IrBinder -> Ir -> List IrAlt -> List IrAlt
mCpsAlts fuel r k alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (mCps (fuel - 1) r k a.irAltBody) :: mCpsAlts (fuel - 1) r k rest

mCpsAltM : Int -> IrBinder -> Ir -> Maybe IrAlt -> Maybe IrAlt
mCpsAltM fuel r k m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (mCps (fuel - 1) r k a.irAltBody))

mIsControl : Ir -> Bool
mIsControl (IrCase caseTy _ _ _) = True
mIsControl (IrIf _ _ _) = True
mIsControl (IrNatCase _ _ _ _ _) = True
mIsControl _ = False

-- | 逐个 CPS 实参，最后把运行时符号应用交给 k。
mCpsArgs : Int -> IrBinder -> Ir -> String -> List Ir -> List Ir -> Ir
mCpsArgs fuel r k sym args acc =
  if fuel <= 0 then
    IrApp Nothing k (IrRtApp sym (reverse acc))
  else
    case args of
      [] => IrApp Nothing k (IrRtApp sym (reverse acc))
      a :: rest =>
        let
          v = mFreshV fuel
        in mCps (fuel - 1) r (IrLam [v] Nothing (mCpsArgs (fuel - 1) r k sym rest (IrVar v :: acc))) a

-- | 逐个 CPS 一个应用脊（head :: args），最后 applyAll 交给 k。
mCpsApply : Int -> IrBinder -> Ir -> List Ir -> Ir
mCpsApply fuel r k parts =
  if fuel <= 0 then
    IrApp Nothing k (IrGlobal "?")
  else
    case parts of
      [] => IrApp Nothing k (IrGlobal "?")
      [x] => mCps (fuel - 1) r k x
      x :: rest =>
        let
          v = mFreshV fuel
        in mCps (fuel - 1) r (IrLam [v] Nothing (mCpsApplyArgs (fuel - 1) r k rest [] v)) x

mCpsApplyArgs : Int -> IrBinder -> Ir -> List Ir -> List Ir -> IrBinder -> Ir
mCpsApplyArgs fuel r k args acc headV =
  if fuel <= 0 then
    IrApp Nothing k (IrGlobal "?")
  else
    case args of
      [] => IrApp Nothing k (applyAll (IrVar headV) (reverse acc))
      a :: rest =>
        let
          v = mFreshV fuel
        in mCps (fuel - 1) r (IrLam [v] Nothing (mCpsApplyArgs (fuel - 1) r k rest (IrVar v :: acc) headV)) a

-- | handler clause 顶层的 kDone（`mFreshTailK`）：resume 在尾位置时用它标记段边界。
isTailCont : Ir -> Bool
isTailCont e =
  case e of
    IrVar b => String.startsWith "__mchTK" (mBNameText b.irBinderName)
    _ => False

mCps : Int -> IrBinder -> Ir -> Ir -> Ir
mCps fuel r k e =
  if fuel <= 0 then
    IrApp Nothing k e
  else if mIsResumeApp r e then
    if isTailCont k then IrApp Nothing e (IrCtor "Base.Effect.Core.Rest" "Base.Effect.Core.Rest.MkRestTail" Nothing []) else IrApp Nothing e (IrCtor "Base.Effect.Core.Rest" "Base.Effect.Core.Rest.MkRestCont" Nothing [k])
  else
    case e of
      IrLet bs rhs body =>
        let
          v = mFreshV fuel
          cont = IrLam [v] Nothing (IrLet bs (IrVar v) (mCps (fuel - 1) r k body))
        in mCps (fuel - 1) r cont rhs
      IrCase caseTy _ scrut alts =>
        let
          v = mFreshV fuel
          cont = IrLam [v] Nothing (IrCase caseTy Nothing (IrVar v) (mCpsAlts (fuel - 2) r k alts))
        in mCps (fuel - 1) r cont scrut
      IrIf c t el =>
        let
          v = mFreshV fuel
          cont = IrLam [v] Nothing (IrIf (IrVar v) (mCps (fuel - 2) r k t) (mCps (fuel - 2) r k el))
        in mCps (fuel - 1) r cont c
      IrNatCase scrut fr z su ca =>
        let
          v = mFreshV fuel
          cont = IrLam [v] Nothing (IrNatCase (IrVar v) fr (mCpsAltM (fuel - 2) r k z) (mCpsAltM (fuel - 2) r k su) (mCpsAltM (fuel - 2) r k ca))
        in mCps (fuel - 1) r cont scrut
      IrCast cFrom cTo x => IrCast cFrom cTo (mCps (fuel - 1) r k x)
      IrRtApp sym args => mCpsArgs (fuel - 1) r k sym args []
      IrLam bs rt body => if isEffContLambda rt then IrApp Nothing k (mEffContLambda (fuel - 1) r bs rt body) else IrApp Nothing k e
      IrApp _ _ _ =>
        let
          p = flattenApp e
        in mCpsApply (fuel - 1) r k (append [firstOf p] (secondOf p))
      _ => IrApp Nothing k e

mHandlerLam : Int -> List IrBinder -> Ir -> Ir
mHandlerLam fuel bs body =
  case mResumption bs of
    Nothing => IrLam bs Nothing (mHandlers (fuel - 1) body)
    Just r =>
      let
        kd = mFreshTailK fuel
        rs = mFreshR fuel
      in IrLam
        (append bs [kd, rs])
        Nothing
        (mScopedCalls (fuel - 1) rs (mCps (fuel - 1) r (IrVar kd) body))

mListH : Int -> List Ir -> List Ir
mListH fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => mHandlers (fuel - 1) x :: mListH (fuel - 1) rest

mFieldsH : Int -> List (Pair String Ir) -> List (Pair String Ir)
mFieldsH fuel fs =
  if fuel <= 0 then
    fs
  else
    case fs of
      [] => []
      p :: rest => Pair (firstOf p) (mHandlers (fuel - 1) (secondOf p)) :: mFieldsH (fuel - 1) rest

mHandlers : Int -> Ir -> Ir
mHandlers fuel e =
  if fuel <= 0 then
    e
  else
    case e of
      IrLam bs _ body => mHandlerLam (fuel - 1) bs body
      IrCtor fam ctor _ args => IrCtor fam ctor Nothing (mListH (fuel - 1) args)
      IrRecord fam _ fs => IrRecord fam Nothing (mFieldsH (fuel - 1) fs)
      IrProj b fam f _ => IrProj (mHandlers (fuel - 1) b) fam f Nothing
      IrRecUpd b fam fs _ => IrRecUpd (mHandlers (fuel - 1) b) fam (mFieldsH (fuel - 1) fs) Nothing
      IrRtApp sym args => IrRtApp sym (mListH (fuel - 1) args)
      IrCast cFrom cTo x => IrCast cFrom cTo (mHandlers (fuel - 1) x)
      IrLet bs rhs body => IrLet bs (mHandlers (fuel - 1) rhs) (mHandlers (fuel - 1) body)
      IrApp _ f a => IrApp Nothing (mHandlers (fuel - 1) f) (mHandlers (fuel - 1) a)
      IrIf c t el => IrIf (mHandlers (fuel - 1) c) (mHandlers (fuel - 1) t) (mHandlers (fuel - 1) el)
      IrCase caseTy _ s alts => IrCase caseTy Nothing (mHandlers (fuel - 1) s) (mHandlersAlts (fuel - 1) alts)
      IrNatCase s fr z su ca => IrNatCase (mHandlers (fuel - 1) s) fr (mHandlersAltM (fuel - 1) z) (mHandlersAltM (fuel - 1) su) (mHandlersAltM (fuel - 1) ca)
      IrConcatMany xs => IrConcatMany (mListH (fuel - 1) xs)
      IrEffThunk fam ctor u arity prim => IrEffThunk fam ctor u arity (mHandlers (fuel - 1) prim)
      _ => e

mHandlersAlts : Int -> List IrAlt -> List IrAlt
mHandlersAlts fuel alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (mHandlers (fuel - 1) a.irAltBody) :: mHandlersAlts (fuel - 1) rest

mHandlersAltM : Int -> Maybe IrAlt -> Maybe IrAlt
mHandlersAltM fuel m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (mHandlers (fuel - 1) a.irAltBody))

mSym : String -> String
mSym x =
  if x == irCpsPerformName then
    irMPerformName
  else if x == irCpsHandleName then irMHandleName else if x == irCpsSelfName then irMSelfName else x

mSyms : Int -> Ir -> Ir
mSyms fuel e =
  if fuel <= 0 then
    e
  else
    case e of
      IrRt x => IrRt (mSym x)
      IrRtApp x args => IrRtApp (mSym x) (mListS (fuel - 1) args)
      IrCtor f c _ args => IrCtor f c Nothing (mListS (fuel - 1) args)
      IrRecord f _ fs => IrRecord f Nothing (mFieldsS (fuel - 1) fs)
      IrProj b f x _ => IrProj (mSyms (fuel - 1) b) f x Nothing
      IrRecUpd b f fs _ => IrRecUpd (mSyms (fuel - 1) b) f (mFieldsS (fuel - 1) fs) Nothing
      IrCast cFrom cTo x => IrCast cFrom cTo (mSyms (fuel - 1) x)
      IrLet bs r b => IrLet bs (mSyms (fuel - 1) r) (mSyms (fuel - 1) b)
      IrLam bs rt b => IrLam bs rt (mSyms (fuel - 1) b)
      IrApp _ f a => IrApp Nothing (mSyms (fuel - 1) f) (mSyms (fuel - 1) a)
      IrIf c t el => IrIf (mSyms (fuel - 1) c) (mSyms (fuel - 1) t) (mSyms (fuel - 1) el)
      IrCase caseTy _ sc alts => IrCase caseTy Nothing (mSyms (fuel - 1) sc) (mSymsAltsM (fuel - 1) alts)
      IrNatCase sc fr z su ca => IrNatCase (mSyms (fuel - 1) sc) fr (mSymsAltMM (fuel - 1) z) (mSymsAltMM (fuel - 1) su) (mSymsAltMM (fuel - 1) ca)
      IrConcatMany xs => IrConcatMany (mListS (fuel - 1) xs)
      IrEffThunk f c u a pr => IrEffThunk f c u a (mSyms (fuel - 1) pr)
      _ => e

mListS : Int -> List Ir -> List Ir
mListS fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => mSyms (fuel - 1) x :: mListS (fuel - 1) rest

mFieldsS : Int -> List (Pair String Ir) -> List (Pair String Ir)
mFieldsS fuel fs =
  if fuel <= 0 then
    fs
  else
    case fs of
      [] => []
      p :: rest => Pair (firstOf p) (mSyms (fuel - 1) (secondOf p)) :: mFieldsS (fuel - 1) rest

mSymsAltsM : Int -> List IrAlt -> List IrAlt
mSymsAltsM fuel alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (mSyms (fuel - 1) a.irAltBody) :: mSymsAltsM (fuel - 1) rest

mSymsAltMM : Int -> Maybe IrAlt -> Maybe IrAlt
mSymsAltMM fuel m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (mSyms (fuel - 1) a.irAltBody))

mDoneCont : Ir
mDoneCont =
  let
    v = mkBinder "__mDoneV"
  in IrLam [v] Nothing (IrApp Nothing (IrRt irMDoneName) (IrVar v))

mTrampolineBody : String -> Ir -> Result Ir
mTrampolineBody name (IrLam bs rt inner) =
  case mTrampolineBody name inner of
    Err msg => Err msg
    Ok b => Ok (IrLam bs rt b)
mTrampolineBody name (IrCast cFrom cTo inner) =
  case mTrampolineBody name inner of
    Err msg => Err msg
    Ok b => Ok (IrCast cFrom cTo b)
mTrampolineBody name (IrApp _ (IrApp _ (IrApp _ (IrGlobal g) e) u) _idc) =
  if g == runThunkName then
    Ok (IrApp Nothing (IrRt irMRunName) (applyAll (IrGlobal g) [e, u, mDoneCont]))
  else
    Err ("machine CPS: unexpected trampoline shape: " ++ name)
mTrampolineBody name _ = Err ("machine CPS: unexpected trampoline shape: " ++ name)

-- ---------------------------------------------------------------
-- handler clause 收集（按运行时签名判定，arity / 名字只作回退）
-- ---------------------------------------------------------------
-- handler 组合子的签名结果行是 `Eff`，且至少一个参数是 opH clause
-- （`o -> k -> b`，其中 `k` 是函数）。`IrDef` 的运行时签名由 Lowering 写入；
-- 签名里不可命名的部分落 `IrTyOpaque` 时回退到 arity / 组合子名字。
mBodyOf : IrDef -> Ir
mBodyOf d =
  case irDefBody d of
    Just b => b
    Nothing => IrInt 0

record HandlerTables where
  htArities : List (Pair String Int)
  htSigs : List (Pair String (Maybe IrTy))

defArities : Int -> List IrDef -> List (Pair String Int)
defArities fuel ds =
  if fuel <= 0 then
    []
  else
    case ds of
      [] => []
      d :: rest => Pair (irDefName d) (irDefArity d) :: defArities (fuel - 1) rest

defSigs : Int -> List IrDef -> List (Pair String (Maybe IrTy))
defSigs fuel ds =
  if fuel <= 0 then
    []
  else
    case ds of
      [] => []
      d :: rest => Pair (irDefName d) (irDefTy d) :: defSigs (fuel - 1) rest

handlerTables : Int -> List IrDef -> HandlerTables
handlerTables fuel ds = HandlerTables (defArities fuel ds) (defSigs fuel ds)

arityOf : List (Pair String Int) -> String -> Int
arityOf [] _ = 0
arityOf (x :: rest) n = if firstOf x == n then secondOf x else arityOf rest n

sigOf : List (Pair String (Maybe IrTy)) -> String -> Maybe IrTy
sigOf [] _ = Nothing
sigOf (x :: rest) n = if firstOf x == n then secondOf x else sigOf rest n

funArity : IrTy -> Int
funArity (IrTyFun _ c) = 1 + funArity c
funArity _ = 0

funResult : IrTy -> IrTy
funResult (IrTyFun _ c) = funResult c
funResult t = t

isFunTy : IrTy -> Bool
isFunTy (IrTyFun _ _) = True
isFunTy _ = False

-- opH clause 的运行时形状：`(o : Op i) -> (k : resIdx i o -> b) -> b`。
-- `ret` 是 `a -> b`（第二个参数不是函数），普通二元回调（如 `foldM` 的
-- `b -> a -> Eff r b`）也不满足「第二个参数是函数」。
isClauseTy : IrTy -> Bool
isClauseTy (IrTyFun _ (IrTyFun k _)) = isFunTy k
isClauseTy _ = False

-- handler 组合子：运行时至少两个参数、结果行是 Eff，且某个参数是 opH clause。
isHandlerCombinatorTy : IrTy -> Bool
isHandlerCombinatorTy ty =
  funArity ty >= 2 && isEffResultTy (Just (funResult ty)) && hasClauseParam ty

hasClauseParam : IrTy -> Bool
hasClauseParam (IrTyFun d c) = isClauseTy d || hasClauseParam c
hasClauseParam _ = False

-- | 核心 handler 组合子：opH 的类型是裸类型变量 `h`，类型判据看不出 clause，
-- 只能按定义名点名（不是 `startsWith … contains` 的字符串启发式）。
isCoreHandleCombinator : String -> Bool
isCoreHandleCombinator n =
  n
    == "Base.Effect.Core.handleCore"
    || n
    == "Base.Effect.Core.handleCoreAt"
    || n
    == "Base.Effect.Core.handleCoreLin"
    || n == "Base.Effect.Core.handleWith" || n == "Base.Effect.Core.handleWithAt"

isHandleCombinator : HandlerTables -> String -> Bool
isHandleCombinator t n =
  case sigOf t.htSigs n of
    Just ty =>
      if funArity ty == 0 then
        isCoreHandleCombinator n
      else
        isHandlerCombinatorTy ty || isCoreHandleCombinator n
    Nothing => isCoreHandleCombinator n

clauseArityOf : HandlerTables -> String -> Int
clauseArityOf t n =
  case sigOf t.htSigs n of
    Just ty => if funArity ty > 0 then funArity ty else arityOf t.htArities n
    Nothing => arityOf t.htArities n

isClauseGlobal : HandlerTables -> String -> Bool
isClauseGlobal t n =
  case sigOf t.htSigs n of
    Just ty => if funArity ty > 0 then isClauseTy ty else arityOf t.htArities n >= 2
    Nothing => arityOf t.htArities n >= 2

clauseGlobals : HandlerTables -> List Ir -> List String
clauseGlobals t args =
  if fuelOf args <= 0 then
    []
  else
    case args of
      [] => []
      a :: rest =>
        case a of
          IrGlobal h => if isClauseGlobal t h && clauseArityOf t h >= 2 then h :: clauseGlobals t rest else clauseGlobals t rest
          _ =>
            case flattenApp a of
              -- 部分应用的 clause（如 `processOpHIOWith onExit`）：剩余运行时参数仍是
              -- (o, k)，同样要按 clause 补 kDone/runScoped。
              Pair (IrGlobal h) prefixArgs => if isClauseGlobal t h && clauseArityOf t h - lenOf prefixArgs >= 2 then h :: clauseGlobals t rest else clauseGlobals t rest
              _ => clauseGlobals t rest

lenOf : List a -> Int
lenOf xs =
  case xs of
    [] => 0
    _ :: rest => 1 + lenOf rest

fuelOf : List Ir -> Int
fuelOf _ = 1

collectHandlerGlobals : HandlerTables -> Int -> Ir -> List String
collectHandlerGlobals t fuel e =
  if fuel <= 0 then
    []
  else
    case e of
      IrApp _ _ _ =>
        let
          p = flattenApp e
          head = firstOf p
          args = secondOf p
          here =
            case head of
              IrGlobal n => if isHandleCombinator t n then clauseGlobals t args else []
              _ => []
        in append here (append (collectHandlerGlobals t (fuel - 1) head) (collectHandlerGlobalsList t (fuel - 1) args))
      IrCtor _ _ _ args => collectHandlerGlobalsList t (fuel - 1) args
      IrRecord _ _ fs => collectHandlerGlobalsFields t (fuel - 1) fs
      IrProj b _ _ _ => collectHandlerGlobals t (fuel - 1) b
      IrRecUpd b _ fs _ => append (collectHandlerGlobals t (fuel - 1) b) (collectHandlerGlobalsFields t (fuel - 1) fs)
      IrRtApp _ args => collectHandlerGlobalsList t (fuel - 1) args
      IrCast cFrom cTo x => collectHandlerGlobals t (fuel - 1) x
      IrLet _ a b => append (collectHandlerGlobals t (fuel - 1) a) (collectHandlerGlobals t (fuel - 1) b)
      IrLam _ _ b => collectHandlerGlobals t (fuel - 1) b
      IrIf c t1 el => append (collectHandlerGlobals t (fuel - 1) c) (append (collectHandlerGlobals t (fuel - 1) t1) (collectHandlerGlobals t (fuel - 1) el))
      IrCase caseTy _ s alts => append (collectHandlerGlobals t (fuel - 1) s) (collectHandlerGlobalsAlts t (fuel - 1) alts)
      IrNatCase s _ z su ca => append (collectHandlerGlobals t (fuel - 1) s) (append (collectHandlerGlobalsAltM t (fuel - 1) z) (append (collectHandlerGlobalsAltM t (fuel - 1) su) (collectHandlerGlobalsAltM t (fuel - 1) ca)))
      IrConcatMany xs => collectHandlerGlobalsList t (fuel - 1) xs
      IrEffThunk _ _ _ _ pr => collectHandlerGlobals t (fuel - 1) pr
      _ => []

collectHandlerGlobalsList : HandlerTables -> Int -> List Ir -> List String
collectHandlerGlobalsList t fuel xs =
  if fuel <= 0 then
    []
  else
    case xs of
      [] => []
      x :: rest => append (collectHandlerGlobals t (fuel - 1) x) (collectHandlerGlobalsList t (fuel - 1) rest)

collectHandlerGlobalsFields : HandlerTables -> Int -> List (Pair String Ir) -> List String
collectHandlerGlobalsFields t fuel fs =
  if fuel <= 0 then
    []
  else
    case fs of
      [] => []
      p :: rest => append (collectHandlerGlobals t (fuel - 1) (secondOf p)) (collectHandlerGlobalsFields t (fuel - 1) rest)

collectHandlerGlobalsAlts : HandlerTables -> Int -> List IrAlt -> List String
collectHandlerGlobalsAlts t fuel alts =
  if fuel <= 0 then
    []
  else
    case alts of
      [] => []
      a :: rest => append (collectHandlerGlobals t (fuel - 1) a.irAltBody) (collectHandlerGlobalsAlts t (fuel - 1) rest)

collectHandlerGlobalsAltM : HandlerTables -> Int -> Maybe IrAlt -> List String
collectHandlerGlobalsAltM t fuel m =
  if fuel <= 0 then
    []
  else
    case m of
      Nothing => []
      Just a => collectHandlerGlobals t (fuel - 1) a.irAltBody

collectHandleOpsDefs : Int -> List IrDef -> List String
collectHandleOpsDefs fuel ds =
  let
    tables = handlerTables 100000 ds
  in collectHandleOpsDefsGo fuel tables ds

collectHandleOpsDefsGo : Int -> HandlerTables -> List IrDef -> List String
collectHandleOpsDefsGo fuel t ds =
  if fuel <= 0 then
    []
  else
    case ds of
      [] => []
      d :: rest => append (collectHandlerGlobals t (fuel - 1) (mBodyOf d)) (collectHandleOpsDefsGo (fuel - 1) t rest)

memName : String -> List String -> Bool
memName x [] = False
memName x (y :: rest) = if x == y then True else memName x rest

-- | handler clause 内对 `handleScoped` / `handleSelf` 的调用：改成机器给的
-- runScoped 参数（当前帧上的嵌套运行），`Scoped` 值直接交给它。
scopedName : String
scopedName = "Base.Effect.Core.handleScoped"

selfName : String
selfName = "Base.Effect.Core.handleSelf"

scopeName : String
scopeName = "Base.Effect.Core.scope"

cleanupPushName : String
cleanupPushName = "Base.Effect.Core.pushCleanup"

cleanupPopName : String
cleanupPopName = "Base.Effect.Core.popCleanup"

mScopedCalls : Int -> IrBinder -> Ir -> Ir
mScopedCalls fuel rs e =
  if fuel <= 0 then
    e
  else
    case e of
      IrApp _ f a =>
        let
          f1 = mScopedCalls (fuel - 1) rs f
          a1 = mScopedCalls (fuel - 1) rs a
        in case f1 of
          IrGlobal n => if n == scopedName then IrApp Nothing (IrVar rs) a1 else if n == selfName then IrApp Nothing (IrVar rs) (IrApp Nothing (IrGlobal scopeName) a1) else IrApp Nothing f1 a1
          _ => IrApp Nothing f1 a1
      IrRtApp sym args => IrRtApp sym (mScopedList (fuel - 1) rs args)
      IrCtor fam ctor _ args => IrCtor fam ctor Nothing (mScopedList (fuel - 1) rs args)
      IrRecord fam _ fs => IrRecord fam Nothing (mScopedFields (fuel - 1) rs fs)
      IrProj b fam x _ => IrProj (mScopedCalls (fuel - 1) rs b) fam x Nothing
      IrRecUpd b fam fs _ => IrRecUpd (mScopedCalls (fuel - 1) rs b) fam (mScopedFields (fuel - 1) rs fs) Nothing
      IrCast cFrom cTo x => IrCast cFrom cTo (mScopedCalls (fuel - 1) rs x)
      IrLet bs rhs body => IrLet bs (mScopedCalls (fuel - 1) rs rhs) (mScopedCalls (fuel - 1) rs body)
      IrLam bs rt body => IrLam bs rt (mScopedCalls (fuel - 1) rs body)
      IrIf c t el => IrIf (mScopedCalls (fuel - 1) rs c) (mScopedCalls (fuel - 1) rs t) (mScopedCalls (fuel - 1) rs el)
      IrCase caseTy _ sc alts => IrCase caseTy Nothing (mScopedCalls (fuel - 1) rs sc) (mScopedAlts (fuel - 1) rs alts)
      IrNatCase sc fr z su ca => IrNatCase (mScopedCalls (fuel - 1) rs sc) fr (mScopedAltM (fuel - 1) rs z) (mScopedAltM (fuel - 1) rs su) (mScopedAltM (fuel - 1) rs ca)
      IrConcatMany xs => IrConcatMany (mScopedList (fuel - 1) rs xs)
      IrEffThunk fam ctor u ar prim => IrEffThunk fam ctor u ar (mScopedCalls (fuel - 1) rs prim)
      _ => e

mScopedList : Int -> IrBinder -> List Ir -> List Ir
mScopedList fuel rs xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => mScopedCalls (fuel - 1) rs x :: mScopedList (fuel - 1) rs rest

mScopedFields : Int -> IrBinder -> List (Pair String Ir) -> List (Pair String Ir)
mScopedFields fuel rs fs =
  if fuel <= 0 then
    fs
  else
    case fs of
      [] => []
      p :: rest => Pair (firstOf p) (mScopedCalls (fuel - 1) rs (secondOf p)) :: mScopedFields (fuel - 1) rs rest

mScopedAlts : Int -> IrBinder -> List IrAlt -> List IrAlt
mScopedAlts fuel rs alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (mScopedCalls (fuel - 1) rs a.irAltBody) :: mScopedAlts (fuel - 1) rs rest

mScopedAltM : Int -> IrBinder -> Maybe IrAlt -> Maybe IrAlt
mScopedAltM fuel rs m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (mScopedCalls (fuel - 1) rs a.irAltBody))

lastBinderOf : List IrBinder -> Maybe IrBinder
lastBinderOf bs =
  case bs of
    [] => Nothing
    b :: rest =>
      case rest of
        [] => Just b
        _ => lastBinderOf rest

-- | `pushCleanup` / `popCleanup` 的机器形态：thunk 直接变成 Control 步骤
-- （CPS 层无法用类型语言构造 Control，所以按名字在 lowering 里落）。
mCleanupDef : String -> Ir -> Maybe Ir
mCleanupDef n body =
  if n == cleanupPushName then
    case body of
      IrLam bs _ _ =>
        case lastBinderOf bs of
          Just th => Just (IrLam bs Nothing (IrCtor irEffTypeName irEffMkCtor Nothing [IrLam [mkBinder "__mCleanU", mkBinder "__mCleanK"] Nothing (IrCtor machineCtl (machineCtl ++ ".MkPushCleanup") Nothing [IrCtor "Base.Effect.Core.Cleanup" "Base.Effect.Core.Cleanup.MkCleanup" Nothing [IrVar th], IrVar (mkBinder "__mCleanK")])]))
          Nothing => Nothing
      _ => Nothing
  else if n == cleanupPopName then
    case body of
      IrLam bs _ _ => Just (IrLam bs Nothing (IrCtor irEffTypeName irEffMkCtor Nothing [IrLam [mkBinder "__mCleanU", mkBinder "__mCleanK"] Nothing (IrCtor machineCtl (machineCtl ++ ".MkPopCleanup") Nothing [IrVar (mkBinder "__mCleanK")])]))
      _ => Nothing
  else
    Nothing

mHandlerFun : Int -> Ir -> Ir
mHandlerFun fuel body =
  if fuel <= 0 then
    body
  else
    case body of
      IrLam bs _ inner =>
        case runtimeBinders bs of
          _ :: r :: _ =>
            let
              kd = mFreshK fuel
              rs = mFreshR fuel
            in IrLam (append bs [kd, rs]) Nothing (mScopedCalls (fuel - 1) rs (mCps (fuel - 1) r (IrVar kd) inner))
          _ => body
      _ => body

mDef : List String -> Int -> IrDef -> IrDef
mDef handlers fuel d =
  if fuel <= 0 then
    d
  else
    case d of
      IrExternDef _ _ _ _ => d
      IrDef n ar deps sigTy body r g sp =>
        let
          marked = memName n handlers
          h =
            case mCleanupDef n body of
              Just b1 => b1
              Nothing => if marked then mHandlerFun (fuel - 1) body else body
          ar2 = if marked then ar + 2 else ar
          -- handler def 的运行时 arity 多出 kDone / runScoped 两个参数，原签名不再匹配；
          -- 其余 def 的签名在 CPS 前后不变，原样保留。
          sigTy1 = if ar2 == ar then sigTy else Nothing
          b = mSyms (fuel - 1) (mHandlers (fuel - 1) h)
        in if n == runPureName || n == runEffName || n == runMainName then
          case mTrampolineBody n b of
            Ok b1 => IrDef n ar2 deps sigTy1 b1 r g sp
            Err _ => IrDef n ar2 deps sigTy1 b r g sp
        else
          IrDef n ar2 deps sigTy1 b r g sp

mDefs : List String -> Int -> List IrDef -> List IrDef
mDefs handlers fuel ds =
  if fuel <= 0 then
    ds
  else
    case ds of
      [] => []
      d :: rest => mDef handlers (fuel - 1) d :: mDefs handlers (fuel - 1) rest

-- ---------------------------------------------------------------
-- continuation 调用 → `@ir@m@apply`（Control 转移）
-- ---------------------------------------------------------------
-- | mode 6 生成代码里的 continuation binder（`__cpsK*` / `__mchK*`）。
isContBinder : IrBinder -> Bool
isContBinder b =
  let
    n = mBNameText b.irBinderName
  in String.startsWith "__cpsK" n || String.startsWith "__mchTK" n || String.startsWith "__mchK" n

mApplys : Int -> Ir -> Ir
mApplys fuel e =
  if fuel <= 0 then
    e
  else
    case e of
      IrApp _ f a =>
        case f of
          IrVar b => if isContBinder b then IrRtApp irMApplyName [IrVar b, mApplys (fuel - 1) a] else IrApp Nothing (mApplys (fuel - 1) f) (mApplys (fuel - 1) a)
          _ => IrApp Nothing (mApplys (fuel - 1) f) (mApplys (fuel - 1) a)
      IrRtApp sym args => IrRtApp sym (mApplysList (fuel - 1) args)
      IrCtor fam ctor _ args => IrCtor fam ctor Nothing (mApplysList (fuel - 1) args)
      IrRecord fam _ fs => IrRecord fam Nothing (mApplysFields (fuel - 1) fs)
      IrProj b fam x _ => IrProj (mApplys (fuel - 1) b) fam x Nothing
      IrRecUpd b fam fs _ => IrRecUpd (mApplys (fuel - 1) b) fam (mApplysFields (fuel - 1) fs) Nothing
      IrCast cFrom cTo x => IrCast cFrom cTo (mApplys (fuel - 1) x)
      IrLet bs rhs body => IrLet bs (mApplys (fuel - 1) rhs) (mApplys (fuel - 1) body)
      IrLam bs rt body => IrLam bs rt (mApplys (fuel - 1) body)
      IrIf c t el => IrIf (mApplys (fuel - 1) c) (mApplys (fuel - 1) t) (mApplys (fuel - 1) el)
      IrCase caseTy _ sc alts => IrCase caseTy Nothing (mApplys (fuel - 1) sc) (mApplysAlts (fuel - 1) alts)
      IrNatCase sc fr z su ca => IrNatCase (mApplys (fuel - 1) sc) fr (mApplysAltM (fuel - 1) z) (mApplysAltM (fuel - 1) su) (mApplysAltM (fuel - 1) ca)
      IrConcatMany xs => IrConcatMany (mApplysList (fuel - 1) xs)
      IrEffThunk fam ctor u ar prim => IrEffThunk fam ctor u ar (mApplys (fuel - 1) prim)
      _ => e

mApplysList : Int -> List Ir -> List Ir
mApplysList fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => mApplys (fuel - 1) x :: mApplysList (fuel - 1) rest

mApplysFields : Int -> List (Pair String Ir) -> List (Pair String Ir)
mApplysFields fuel fs =
  if fuel <= 0 then
    fs
  else
    case fs of
      [] => []
      p :: rest => Pair (firstOf p) (mApplys (fuel - 1) (secondOf p)) :: mApplysFields (fuel - 1) rest

mApplysAlts : Int -> List IrAlt -> List IrAlt
mApplysAlts fuel alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (mApplys (fuel - 1) a.irAltBody) :: mApplysAlts (fuel - 1) rest

mApplysAltM : Int -> Maybe IrAlt -> Maybe IrAlt
mApplysAltM fuel m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (mApplys (fuel - 1) a.irAltBody))

-- ---------------------------------------------------------------
-- do 块续延：`\v -> <Eff>` → `\v K -> runEff <Eff> K`
-- ---------------------------------------------------------------
-- handler 体里的续延 λ 由 `mCps` 负责（那里能拿到 resumption binder）；其余 def
-- 走这里。已经带 K 的（`mCps` 处理过的）不会再次命中，因为最后一个 binder 换成
-- 了构造名。
mMarked : Int -> Ir -> Ir
mMarked fuel e =
  if fuel <= 0 then
    e
  else
    case e of
      IrLam bs rt body => if isEffContLambda rt && not (isEffThunkBody body) then mEffContLambda (fuel - 1) mNoResumption bs rt body else IrLam bs rt (mMarked (fuel - 1) body)
      -- `handleScoped`：`self th id` 的值语义边界 => `run (self th doneCont)`
      IrApp _ (IrApp _ (IrRt "@ir@m@self") th) (IrLam ([_]) _ _) => IrApp Nothing (IrRt irMRunName) (IrApp Nothing (IrApp Nothing (IrRt "@ir@m@self") (mMarked (fuel - 1) th)) mDoneCont)
      IrRtApp sym args => IrRtApp sym (mMarkedList (fuel - 1) args)
      IrCtor fam ctor _ args => IrCtor fam ctor Nothing (mMarkedList (fuel - 1) args)
      IrRecord fam _ fs => IrRecord fam Nothing (mMarkedFields (fuel - 1) fs)
      IrProj b fam x _ => IrProj (mMarked (fuel - 1) b) fam x Nothing
      IrRecUpd b fam fs _ => IrRecUpd (mMarked (fuel - 1) b) fam (mMarkedFields (fuel - 1) fs) Nothing
      IrCast cFrom cTo x => IrCast cFrom cTo (mMarked (fuel - 1) x)
      IrLet bs rhs body => IrLet bs (mMarked (fuel - 1) rhs) (mMarked (fuel - 1) body)
      IrApp _ f a => IrApp Nothing (mMarked (fuel - 1) f) (mMarked (fuel - 1) a)
      IrIf c t el => IrIf (mMarked (fuel - 1) c) (mMarked (fuel - 1) t) (mMarked (fuel - 1) el)
      IrCase caseTy _ sc alts => IrCase caseTy Nothing (mMarked (fuel - 1) sc) (mMarkedAlts (fuel - 1) alts)
      IrNatCase sc fr z su ca => IrNatCase (mMarked (fuel - 1) sc) fr (mMarkedAltM (fuel - 1) z) (mMarkedAltM (fuel - 1) su) (mMarkedAltM (fuel - 1) ca)
      IrConcatMany xs => IrConcatMany (mMarkedList (fuel - 1) xs)
      IrEffThunk fam ctor u ar prim => IrEffThunk fam ctor u ar (mMarked (fuel - 1) prim)
      _ => e

mMarkedList : Int -> List Ir -> List Ir
mMarkedList fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => mMarked (fuel - 1) x :: mMarkedList (fuel - 1) rest

mMarkedFields : Int -> List (Pair String Ir) -> List (Pair String Ir)
mMarkedFields fuel fs =
  if fuel <= 0 then
    fs
  else
    case fs of
      [] => []
      p :: rest => Pair (firstOf p) (mMarked (fuel - 1) (secondOf p)) :: mMarkedFields (fuel - 1) rest

mMarkedAlts : Int -> List IrAlt -> List IrAlt
mMarkedAlts fuel alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (mMarked (fuel - 1) a.irAltBody) :: mMarkedAlts (fuel - 1) rest

mMarkedAltM : Int -> Maybe IrAlt -> Maybe IrAlt
mMarkedAltM fuel m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (mMarked (fuel - 1) a.irAltBody))

mMarkedDef : IrDef -> IrDef
mMarkedDef (IrDef n ar deps sigTy body r g sp) =
  IrDef n ar deps sigTy (mMarked (cpsFuelOfBody body) body) r g sp
mMarkedDef d = d

-- ---------------------------------------------------------------
mApplysDef : IrDef -> IrDef
mApplysDef (IrDef n ar deps sigTy body r g sp) =
  IrDef n ar deps sigTy (mApplys (cpsFuelOfBody body) body) r g sp
mApplysDef d = d

-- | 方案 2 第一层：选择性 CPS 后把 handler clause 改成 (o, k, kDone)，resumption 为 (v, kRest)。
-- ---------------------------------------------------------------
-- 机器步骤 → 库构造函数（方案 B）
-- ---------------------------------------------------------------
-- `@ir@m@*` 是 lowering 的协议符号；方案 B 把它们改写成对
-- `Base.Effect.Machine` 的构造子 / 函数调用，这样三端共用同一份 vuna 机器。
machineCtl : String
machineCtl = "Base.Effect.Core.Control"

machineCtorOf : String -> Maybe String
machineCtorOf sym =
  if sym == irMDoneName then
    Just "MkDone"
  else if sym == irMApplyName then
    Just "MkApply"
  else if sym == irMPerformName then
    Just "MkPerform"
  else if sym == irMHandleName then
    Just "MkHandle"
  else if sym == irMSelfName then Just "MkSelf" else Nothing

-- | `@ir@m@handle` 的实参是 key,name,ret,opH,comp,unit,kOuter；机器里 comp 自带
-- unit（循环里传），所以丢掉第 6 个。
machineArgsOf : String -> List Ir -> List Ir
machineArgsOf sym args =
  if sym == irMHandleName then
    case args of
      a :: b :: c :: d :: e :: _ :: rest => append [a, b, c, d, e] rest
      _ => args
  else
    args

mSteps : Int -> Ir -> Ir
mSteps fuel e =
  if fuel <= 0 then
    e
  else
    case e of
      IrRtApp sym args =>
        case machineCtorOf sym of
          Just ctor => IrCtor machineCtl (machineCtl ++ "." ++ ctor) Nothing (mStepsList (fuel - 1) (machineArgsOf sym args))
          Nothing =>
            if sym == irMRunName then
              case args of
                [a] => IrApp Nothing (IrGlobal "Base.Effect.Core.machineRun") (mSteps (fuel - 1) a)
                _ => IrRtApp sym (mStepsList (fuel - 1) args)
            else
              IrRtApp sym (mStepsList (fuel - 1) args)
      IrApp _ _ _ =>
        let
          p = flattenApp e
          head = firstOf p
          args = secondOf p
        in case head of
          IrRt sym =>
            case machineCtorOf sym of
              Just ctor => IrCtor machineCtl (machineCtl ++ "." ++ ctor) Nothing (mStepsList (fuel - 1) (machineArgsOf sym args))
              Nothing =>
                if sym == irMRunName then
                  case args of
                    [a] => IrApp Nothing (IrGlobal "Base.Effect.Core.machineRun") (mSteps (fuel - 1) a)
                    _ => foldAppMap (fuel - 1) (mSteps (fuel - 1) head) args
                else
                  foldAppMap (fuel - 1) (mSteps (fuel - 1) head) args
          _ => foldAppMap (fuel - 1) (mSteps (fuel - 1) head) args
      IrCtor fam ctor _ args => IrCtor fam ctor Nothing (mStepsList (fuel - 1) args)
      IrRecord fam _ fs => IrRecord fam Nothing (mStepsFields (fuel - 1) fs)
      IrProj b fam x _ => IrProj (mSteps (fuel - 1) b) fam x Nothing
      IrRecUpd b fam fs _ => IrRecUpd (mSteps (fuel - 1) b) fam (mStepsFields (fuel - 1) fs) Nothing
      IrCast cFrom cTo x => IrCast cFrom cTo (mSteps (fuel - 1) x)
      IrLet bs rhs body => IrLet bs (mSteps (fuel - 1) rhs) (mSteps (fuel - 1) body)
      IrLam bs rt body => IrLam bs rt (mSteps (fuel - 1) body)
      IrIf c t el => IrIf (mSteps (fuel - 1) c) (mSteps (fuel - 1) t) (mSteps (fuel - 1) el)
      IrCase caseTy _ sc alts => IrCase caseTy Nothing (mSteps (fuel - 1) sc) (mStepsAlts (fuel - 1) alts)
      IrNatCase sc fr z su ca => IrNatCase (mSteps (fuel - 1) sc) fr (mStepsAltM (fuel - 1) z) (mStepsAltM (fuel - 1) su) (mStepsAltM (fuel - 1) ca)
      IrConcatMany xs => IrConcatMany (mStepsList (fuel - 1) xs)
      IrEffThunk fam ctor u ar prim => IrEffThunk fam ctor u ar (mSteps (fuel - 1) prim)
      _ => e

mStepsList : Int -> List Ir -> List Ir
mStepsList fuel xs =
  if fuel <= 0 then
    xs
  else
    case xs of
      [] => []
      x :: rest => mSteps (fuel - 1) x :: mStepsList (fuel - 1) rest

mStepsFields : Int -> List (Pair String Ir) -> List (Pair String Ir)
mStepsFields fuel fs =
  if fuel <= 0 then
    fs
  else
    case fs of
      [] => []
      p :: rest => Pair (firstOf p) (mSteps (fuel - 1) (secondOf p)) :: mStepsFields (fuel - 1) rest

mStepsAlts : Int -> List IrAlt -> List IrAlt
mStepsAlts fuel alts =
  if fuel <= 0 then
    alts
  else
    case alts of
      [] => []
      a :: rest => IrAlt a.irAltCtor a.irAltBinders (mSteps (fuel - 1) a.irAltBody) :: mStepsAlts (fuel - 1) rest

mStepsAltM : Int -> Maybe IrAlt -> Maybe IrAlt
mStepsAltM fuel m =
  if fuel <= 0 then
    m
  else
    case m of
      Nothing => Nothing
      Just a => Just (IrAlt a.irAltCtor a.irAltBinders (mSteps (fuel - 1) a.irAltBody))

-- | 把已求值的头逐个应用到实参（保持左结合脊）。
foldAppMap : Int -> Ir -> List Ir -> Ir
foldAppMap fuel acc xs =
  if fuel <= 0 then
    acc
  else
    case xs of
      [] => acc
      x :: rest => foldAppMap (fuel - 1) (IrApp Nothing acc (mSteps (fuel - 1) x)) rest

mStepsDef : IrDef -> IrDef
mStepsDef (IrDef n ar deps sigTy body r g sp) =
  IrDef n ar deps sigTy (mSteps (cpsFuelOfBody body) body) r g sp
mStepsDef d = d

export cpsDefsMachine : List IrDef -> Result (List IrDef)
cpsDefsMachine defs =
  case cpsDefs defs of
    Err msg => Err msg
    Ok ds =>
      let
        handlerNames = collectHandleOpsDefs 100000 ds
      in Ok
        (map mStepsDef (map mApplysDef (map mMarkedDef (mDefs handlerNames (cpsFuelOfDefs ds) ds))))

-- | 单元级入口：改写所有组；入口展示节点是纯值，不需要 CPS。
export cpsUnit : IrUnit -> Result IrUnit
cpsUnit u =
  case transformGroups (cpsFuelOfDefs (concatMap irGroupDefs u.irUnitGroups)) u.irUnitGroups of
    Err msg => Err msg
    Ok groups1 =>
      Ok (IrUnit u.irUnitTyDecls groups1 u.irUnitHasListFamily u.irUnitTypeRefs u.irUnitEntry)

-- | 定义列表入口（后端只持有可达 defs 时用）。
export cpsDefs : List IrDef -> Result (List IrDef)
cpsDefs defs = transformDefs (cpsFuelOfDefs defs) defs
