module Vuna.Compiler.Native.Audit where

-- native 目标能力审计：把可达定义里**当前不支持**的构造按种类计数。
--
-- `Native.Module.build` 在生成失败时把它附在诊断后面（一次列出全部缺口），避免
-- 「一次只报一个 unsupported」的串行试错。判据与生成器逐条同源：白名单与 arity 来自
-- `Native.Runtime`，形状判据（多 binder let、effect bind、extern）来自
-- `Native.Module` 的拒绝点。
--
-- 这里只做静态遍历：不生成代码、不产出诊断分类；诊断仍由 codegen 的第一条失败决定。
--
-- 边界：只 import Base 与 `Ir.*` + `Native.Runtime`（与 `Native` 层约束一致）。
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Compiler.Ir.Model
import Vuna.Compiler.Ir.Runtime
import Vuna.Compiler.Native.Model
import Vuna.Compiler.Native.Runtime

auditErased : IrBinder -> Bool
auditErased b = b.irBinderErased

-- | 运行时 binder 个数（擦除占位不算）。
auditRuntimeBinders : List IrBinder -> Int
auditRuntimeBinders bs = length (filter (\b => not (auditErased b)) bs)

-- | 符号名是否可作为 `IrRtApp` 的目标（`&&` / `||` 由生成器特化，不查表）。
auditSymSupported : String -> Bool
auditSymSupported sym = if sym == "&&" || sym == "||" then True
else if sym == irRtNatSucc then True
else case nativeRtTarget sym of
  Just _ => True
  Nothing => False

-- | `IrRtApp`：arity 必须等于 `irInlineArity`，且符号必须在白名单里。
auditRtAppKeys : String -> List Ir -> List String
auditRtAppKeys sym args =
  if sym == "&&" || sym == "||" then []
  else if not (auditSymSupported sym) then ["symbol " ++ sym]
  else if length args /= irInlineArity sym then ["rt-app-arity " ++ sym] else []

-- ---------------------------------------------------------------
-- 逐节点收集缺口 key
-- ---------------------------------------------------------------
auditKeys : List IrDef -> Ir -> List String
auditKeys defs (IrVar _) = []
auditKeys defs (IrGlobal _) = []
auditKeys defs (IrInt _) = []
auditKeys defs (IrStr _) = []
auditKeys defs (IrBool _) = []
auditKeys defs (IrFloatLit _) = []
auditKeys defs (IrCast inner) = auditKeys defs inner
auditKeys defs (IrLet bs scrut body) =
  append
    (append (if auditRuntimeBinders bs > 1 then ["multi-binder-let"] else []) (auditKeys defs scrut))
    (auditKeys defs body)
auditKeys defs (IrIf c t e) =
  append (auditKeys defs c) (append (auditKeys defs t) (auditKeys defs e))
auditKeys defs (IrCtor _ _ args) = concatMap (auditKeys defs) args
auditKeys defs (IrRecord _ fields) = concatMap (\p => auditKeys defs (secondOf p)) fields
auditKeys defs (IrProj base _ _) = auditKeys defs base
auditKeys defs (IrRecUpd base _ fields) =
  append (auditKeys defs base) (concatMap (\p => auditKeys defs (secondOf p)) fields)
auditKeys defs (IrCase scrut alts) =
  append (auditKeys defs scrut) (concatMap (auditAltKeys defs) alts)
auditKeys defs (IrNatCase scrut _ z s c) =
  append (auditKeys defs scrut)
    (append (auditAltMaybeKeys defs z) (append (auditAltMaybeKeys defs s) (auditAltMaybeKeys defs c)))
auditKeys defs (IrConcatMany parts) = concatMap (auditKeys defs) parts
auditKeys defs (IrLam _ body) = auditKeys defs body
auditKeys defs (IrApp f a) = append (auditKeys defs f) (auditKeys defs a)
auditKeys defs (IrRtApp sym args) =
  append (auditRtAppKeys sym args) (concatMap (auditKeys defs) args)
auditKeys defs (IrRt sym) = if auditSymSupported sym then [] else ["symbol " ++ sym]
auditKeys defs (IrEffThunk _ _ _ _ prim) = auditKeys defs prim
auditKeys defs (IrEffBind _ _ _) = ["effect-bind"]

auditAltKeys : List IrDef -> IrAlt -> List String
auditAltKeys defs alt = auditKeys defs (irAltBodyOf alt)

auditAltMaybeKeys : List IrDef -> Maybe IrAlt -> List String
auditAltMaybeKeys defs Nothing = []
auditAltMaybeKeys defs (Just alt) = auditAltKeys defs alt

auditDefKeys : List IrDef -> IrDef -> List String
auditDefKeys defs d = case irDefBody d of
  Nothing => ["extern " ++ irDefName d]
  Just body => auditKeys defs body

-- ---------------------------------------------------------------
-- 计数与格式化
-- ---------------------------------------------------------------
auditUniq : List String -> List String
auditUniq [] = []
auditUniq (x :: rest) = if memKey x rest then auditUniq rest else x :: auditUniq rest

memKey : String -> List String -> Bool
memKey _ [] = False
memKey x (y :: rest) = if x == y then True else memKey x rest

-- | key 的第一段是类别（`symbol` / `effect-bind` …）。
auditPrefixOf : String -> String
auditPrefixOf key = case split " " key of
  p :: _ => p
  [] => key

-- | key 去掉类别后的其余部分（符号名 / 定义名）。
auditRestOf : String -> String
auditRestOf key = case split " " key of
  _ :: rest => foldl (\acc, part => if strLength acc == 0 then part else acc ++ " " ++ part) "" rest
  [] => ""

-- 输出顺序：先缺失符号，再形状缺口。
auditCategories : List String
auditCategories = ["symbol", "rt-app-arity", "multi-binder-let", "effect-bind", "extern"]

auditInCategory : String -> String -> Bool
auditInCategory cat key = auditPrefixOf key == cat

auditCategoryExamples : String -> List String -> List String
auditCategoryExamples cat keys =
  take 3 (auditUniq (map auditRestOf (filter (auditInCategory cat) keys)))

auditExamplesText : String -> List String -> String
auditExamplesText cat keys = case auditCategoryExamples cat keys of
  [] => ""
  ex :: rest => " (" ++ foldl (\acc, e => acc ++ ", " ++ e) ex rest ++ ")"

auditCategoryLine : String -> List String -> String
auditCategoryLine cat keys =
  let
    hits = filter (auditInCategory cat) keys
  in if length hits == 0 then ""
  else "    " ++ cat ++ " x" ++ strFromInt (length hits) ++ auditExamplesText cat keys

-- | 附在诊断后面的审计块；没有缺口时返回空表。
--   每类一行（计数 + 最多三个例子），类别内不按出现次数细分，避免几百行的清单。
export nativeAuditLines : List IrDef -> List String
nativeAuditLines defs =
  let
    keys = concatMap (auditDefKeys defs) defs
    uniqs = auditUniq keys
    catLines = filter (\l => strLength l > 0) (map (\c => auditCategoryLine c keys) auditCategories)
  in if length keys == 0 then []
  else append
    ["  native audit: ${strFromInt (length keys)} unsupported reference(s), ${strFromInt (length uniqs)} kind(s)"]
    catLines

-- | 把审计块接在 unsupported 文本后面（诊断仍是第一条失败的文本）。
export nativeAuditEnrich : NativeErr -> List IrDef -> NativeErr
nativeAuditEnrich (err@(NativeUnsupported msg)) defs =
  let
    lines = nativeAuditLines defs
  in if length lines == 0 then err
  else NativeUnsupported (msg ++ "\n" ++ foldl (\acc, l => acc ++ "\n" ++ l) "" lines)
nativeAuditEnrich (err@(NativeInternal _)) defs = err
