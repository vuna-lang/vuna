module Vuna.Compiler.Lowering.Env where

-- Core → IR 的**程序级环境**：LwEnv / LwSt、表示判定、类型参数槽不动点、
-- 共享元数据与定义体使用事实。单元 lowering（项/case/record/声明/入口）在
-- `Vuna.Compiler.Lowering.Program.Impl`；本模块不递归进项。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Core.Canonical
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Representation
import Vuna.Compiler.Lowering.Checks
import Vuna.Compiler.Lowering.Erased
import Vuna.Compiler.Base.Intrinsics
import Vuna.Ir.Model
import Vuna.Ir.Analysis
import Vuna.Ir.Runtime
import Vuna.Compiler.Lowering.Checks
import Base.Effect.Types as EffTypes

-- ---------------------------------------------------------------
-- 生成环境
-- ---------------------------------------------------------------
--
-- 「程序级表」在 N 次单元 lowering 之间是常量：放在 `LwEnv` 里只算一次
-- （split 路径每个模块都用同一份）。单元内可变量只有 fresh 计数（`LwSt`）。
export record LwEnv where
  lwShared : IrShared
  -- 运行时族（Bool / Nat 族已被过滤，不进运行时表示）。
  lwDatas : List DtData
  -- 数据族名 → 声明（`lwDatas` 的索引）。类型渲染/构造子判定要按名字查存在性，
  -- 热路径上不再每次线性扫全体数据族。
  lwDataTbl : HashMap String DtData
  -- 族 → 运行时类型参数槽（声明与实参共用的不动点结果）。
  lwTyParams : HashMap String (List Int)
  -- 族 → (去装箱构造子, 保留字段序号)；去装箱声明判定用。
  lwUnboxedInfo : List (String, DtCtor, Int)
  -- 族 → 运行时字段表 `(字段序号, 字段源码名)`（只有 OCaml record 表示的族）。
  lwRecordFields : HashMap String (List (Int, String))
  -- 构造子 → (族名, keep flags)。
  lwCtors : HashMap String (String, List Bool)
  -- 构造子 → 不透明字段 flags。
  lwOpaques : HashMap String (List Bool)
  -- 去装箱族集合。
  lwUnboxed : HashMap String Bool
  -- 程序是否声明 canonical `Base.Data.List.List` 族（桥接内建的放行判据）。
  lwHasListFamily : Bool
  -- 运行时定义表（delta 展开与归属查询用）。
  lwDefs : List DtDef
  -- 擦除前的定义（擦除检查 / 作用域护栏读原始下标空间）。
  lwOrigDefs : List DtDef
  -- 名字 → 定义（**一次建表**，分组/单元过滤都查它；`lwDefs` 是唯一真源）。
  --
  -- 为什么要表：`appendGroups` 过去对每个 SCC 都 `filter (memName …) lwDefs`，单点 SCC
  -- 的合成程序是 O(n²)（N=2000/4000/8000 的 codegen 段 89/284/1083 ms，逐档 ×3.2/×3.8）。
  -- 表只替换**查找**，不参与排序：组内成员顺序仍来自 `assembleGroupNames`（源码序）。
  lwDefTbl : HashMap String DtDef
  -- 全局名 → **类型项**（与精化器的 `ecGlobalsTbl` 同源）。运行时定义也在 `lwDefTbl`
  -- 里；这张表补的是非 `IrDef` 的名字（trait 方法选择子等），只服务 `IrApp` 的节点类型。
  lwGlobals : HashMap String Term
  -- 定义名 → 使用事实（运行时依赖 + 隐藏原语旗标）；分组与 `IrDef` 都吃它。
  lwFacts : HashMap String TermUse
  -- 当前单元名（`Main` 是入口单元；check 路径为 ""）。
  lwUnit : String

export lwEnvShared : LwEnv -> IrShared
lwEnvShared (LwEnv shared datas datatbl typs uinfo recs ctors opqs unboxed hasList defs origDefs tbl globals facts unit) =
  shared

export lwEnvWithUnit : String -> LwEnv -> LwEnv
lwEnvWithUnit unit (LwEnv shared datas datatbl typs uinfo recs ctors opqs unboxed hasList defs origDefs tbl globals facts oldUnit) =
  LwEnv
    shared
    datas
    datatbl
    typs
    uinfo
    recs
    ctors
    opqs
    unboxed
    hasList
    defs
    origDefs
    tbl
    globals
    facts
    unit

-- ---------------------------------------------------------------
-- | 列表长度（`Base.Data.List.length` 的本地名，避免与 `Ir` 里的字段名混淆）。
export listLength : List a -> Int
listLength [] = 0
listLength (x :: rest) = 1 + listLength rest

-- 依赖去重（保持首现顺序）。
export pushDep : String -> List String -> List String
pushDep dep deps = if dep == "" then deps else if memName dep deps then deps else append deps [dep]

-- | `Maybe` 过滤映射（`List` 没有现成的 mapMaybe）。
mapSome : (a -> Maybe b) -> List a -> List b
mapSome f [] = []
mapSome f (x :: rest) =
  case f x of
    Nothing => mapSome f rest
    Just y => y :: mapSome f rest

-- 不透明字段判据（D27）：卡住的类型族应用 / 类型族参数 → 运行时不可命名。
-- 与 `Elab.Meta.valueOpaqueScoped` 同源；类型声明、构造子实参 cast、case 绑定共用。
isTypeHeadOpaqueDatas : List DtData -> String -> Bool
isTypeHeadOpaqueDatas datas name =
  if isUnboxedCanonical name then
    False
  else
    case findDtData name datas of
      Just _ => False
      Nothing => not (isTypeConstructorName name)

memOpaqueLevel : Int -> List Int -> Bool
memOpaqueLevel i [] = False
memOpaqueLevel i (x :: rest) = if x == i then True else memOpaqueLevel i rest

-- ---------------------------------------------------------------
-- 表示判定
-- ---------------------------------------------------------------
--
-- 这三族判据（record 表示 / 去装箱别名 / 运行时族过滤）属于 Lowering（表示决策），
-- 后端只渲染 `IrTyDecl`。
-- `recordFieldLabel` 留在 Decl（它是**文本**：`f_<fam>_<field>`）。
-- | 该族是否为 record（声明来源 + 单构造子）。
isRecordData : DtData -> Bool
isRecordData d =
  if dtDataIsRecord d then
    case dtDataCtors d of
      [_] => True
      _ => False
  else
    False

-- | record 的运行时字段（字段声明序号 → 字段源码名），只含 keep 字段。
export recordRtFields : DtData -> List (Int, String)
recordRtFields d =
  case dtDataCtors d of
    [c] =>
      let
        arity = listLength d.dtDataParams
      in recordRtFieldsGo (dtDataName d) (drop arity (ctorKeepFlags c)) (dtDataFields d)
    _ => []

recordRtFieldsGo : String -> List Bool -> List DtFieldMeta -> List (Int, String)
recordRtFieldsGo family [] fs = []
recordRtFieldsGo family (k :: ks) [] = []
recordRtFieldsGo family (k :: ks) (f :: fs) =
  if k then
    (f.dtFieldIndex, f.dtFieldName) :: recordRtFieldsGo family ks fs
  else
    recordRtFieldsGo family ks fs

-- | 该族用 OCaml record 表示：是 record 且**有**运行时字段。
export hasRecordRepr : DtData -> Bool
hasRecordRepr d =
  if isRecordData d then
    case recordRtFields d of
      [] => False
      _ => True
  else
    False

-- | 运行时族：剔除表示不是变体的 canonical 族（Bool / Nat）。
export rtDatasOf : List DtData -> List DtData
rtDatasOf datas = filter (\d => not (isUnboxedCanonical (dtDataName d))) datas

-- 构造子字段的「不透明」形状（D27）：与 keep flags 逐位对齐，擦除位置恒 False。
-- 判据与 `Elab.Meta.valueOpaqueScoped` 同源（卡住的类型族应用 / 类型族参数）。
export ctorOpaqueFlagsOf : List DtData -> DtCtor -> List Bool
ctorOpaqueFlagsOf datas c = ctorOpaqueGo datas (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) [] []

ctorOpaqueGo : List DtData -> List (String, Rig) -> Int -> Value -> List Int -> List Bool -> List Bool
ctorOpaqueGo datas [] lvl v famLevels acc = reverse acc
ctorOpaqueGo datas ((name, rig) :: rest) lvl v famLevels acc =
  case v of
    VPi pname implicit _ dom clo =>
      let
        flag =
          not (rigIsErased rig)
            && (
              valueOpaqueScoped
                (\l => memOpaqueLevel l famLevels)
                (isTypeHeadOpaqueDatas datas)
                lvl
                famLevels
                dom || valueHasImplicitPi dom
            )
        fam2 = if isFamilyKindValue dom then lvl :: famLevels else famLevels
        next = applyClosure clo (VNeutral (NVar pname lvl []))
      in ctorOpaqueGo datas rest (lvl + 1) next fam2 (flag :: acc)
    _ => reverse acc

-- 运行时定义的位置行（只对有 span 的定义）。
locRowPair : DtDef -> Maybe (String, String, Int)
locRowPair d =
  case dtDefSpan d of
    Nothing => Nothing
    Just sp => Just (dtDefName d, sp.spanFile, spanStartLine sp)

-- ---------------------------------------------------------------
-- 族参数槽（不动点）与运行时类型渲染
-- ---------------------------------------------------------------
--
-- 这一节产出 `IrTy`（不是 OCaml 文本）：判定逻辑（哪些族参数槽要用、哪些字段不透明）
-- 必须与构造子实参对齐、
-- 声明与实参共用同一份结果，否则类型参数位置漂移。
typeParamLevels : DtData -> List Int
typeParamLevels d = typeParamLevelsGo d.dtDataParams 0

typeParamLevelsGo : List (String, Rig) -> Int -> List Int
typeParamLevelsGo [] i = []
typeParamLevelsGo (p :: rest) i =
  if rigIsErased (secondOf p) then
    i :: typeParamLevelsGo rest (i + 1)
  else
    typeParamLevelsGo rest (i + 1)

memIntIn : Int -> List Int -> Bool
memIntIn i [] = False
memIntIn i (x :: rest) = x == i || memIntIn i rest

export levelSlotIn : List Int -> Int -> Maybe Int
levelSlotIn levels lvl = levelSlotGoIn levels lvl 0

levelSlotGoIn : List Int -> Int -> Int -> Maybe Int
levelSlotGoIn [] lvl acc = Nothing
levelSlotGoIn (x :: rest) lvl acc = if x == lvl then Just acc else levelSlotGoIn rest lvl (acc + 1)

export nthValueIn : List Value -> Int -> Maybe Value
nthValueIn [] i = Nothing
nthValueIn (v :: rest) i = if i <= 0 then Just v else nthValueIn rest (i - 1)

lookupUsedIn : List (String, List Int) -> String -> List Int
lookupUsedIn [] name = []
lookupUsedIn (p :: rest) name = if firstOf p == name then secondOf p else lookupUsedIn rest name

-- | 同一张表的哈希索引版本（声明 / 实参渲染用；不动点内部仍用列表）。
export lookupTyParamsIn : HashMap String (List Int) -> String -> List Int
lookupTyParamsIn tbl name =
  case HashMap.lookup name tbl of
    Just levels => levels
    Nothing => []

collectUsedLevels : List Int -> List (String, List Int) -> List DtData -> Int -> Value -> List Int
collectUsedLevels tps table datas lvl v = collectUsedLevelsFuel 256 tps table datas lvl v

collectUsedLevelsFuel : Int -> List Int -> List (String, List Int) -> List DtData -> Int -> Value -> List Int
collectUsedLevelsFuel fuel tps table datas lvl v =
  if fuel <= 0 then
    []
  else
    case v of
      VPi name implicit rig dom clo => if implicit then collectUsedLevelsFuel (fuel - 1) tps table datas (lvl + 1) (applyClosure clo (VNeutral (NVar name lvl []))) else append (collectUsedLevelsFuel (fuel - 1) tps table datas lvl dom) (collectUsedLevelsFuel (fuel - 1) tps table datas (lvl + 1) (applyClosure clo (VNeutral (NVar name lvl []))))
      VNeutral n =>
        case n of
          NVar name lvl2 sp => append (if memIntIn lvl2 tps then [lvl2] else []) (collectUsedSpineFuel (fuel - 1) tps table datas lvl sp)
          NGlobal g sp =>
            case findDtData g datas of
              Just gd => collectFamilyArgsFuel (fuel - 1) tps table datas lvl (lookupUsedIn table g) sp
              Nothing => collectUsedSpineFuel (fuel - 1) tps table datas lvl sp
      _ => []

collectUsedSpineFuel : Int -> List Int -> List (String, List Int) -> List DtData -> Int -> List Value -> List Int
collectUsedSpineFuel fuel tps table datas lvl [] = if fuel <= 0 then [] else []
collectUsedSpineFuel fuel tps table datas lvl (v :: rest) =
  if fuel <= 0 then
    []
  else
    append
      (collectUsedLevelsFuel (fuel - 1) tps table datas lvl v)
      (collectUsedSpineFuel (fuel - 1) tps table datas lvl rest)

collectFamilyArgs : List Int -> List (String, List Int) -> List DtData -> Int -> List Int -> List Value -> List Int
collectFamilyArgs tps table datas lvl usedPats args =
  collectFamilyArgsFuel 256 tps table datas lvl usedPats args

collectFamilyArgsFuel : Int -> List Int -> List (String, List Int) -> List DtData -> Int -> List Int -> List Value -> List Int
collectFamilyArgsFuel fuel tps table datas lvl usedPats args =
  if fuel <= 0 then
    []
  else
    case usedPats of
      [] => []
      i :: rest =>
        case nthValueIn args i of
          Just arg => append (collectUsedLevelsFuel (fuel - 1) tps table datas lvl arg) (collectFamilyArgsFuel (fuel - 1) tps table datas lvl rest args)
          Nothing => collectFamilyArgsFuel (fuel - 1) tps table datas lvl rest args

ctorUsedLevels : List Int -> List (String, List Int) -> List DtData -> List Int -> List (String, Rig) -> Int -> Value -> List Int
ctorUsedLevels tps table datas famLevels [] lvl v = []
ctorUsedLevels tps table datas famLevels ((name, rig) :: rest) lvl v =
  case v of
    VPi pname implicit _ dom clo =>
      let
        isOpq =
          valueOpaqueScoped
            (\l => memOpaqueLevel l famLevels)
            (isTypeHeadOpaqueDatas datas)
            lvl
            famLevels
            dom
        fam2 = if isFamilyKindValue dom then lvl :: famLevels else famLevels
        next = applyClosure clo (VNeutral (NVar pname lvl []))
      in if rigIsErased rig then
        ctorUsedLevels tps table datas fam2 rest (lvl + 1) next
      else if isOpq then
        ctorUsedLevels tps table datas fam2 rest (lvl + 1) next
      else
        append
          (collectUsedLevels tps table datas lvl dom)
          (ctorUsedLevels tps table datas fam2 rest (lvl + 1) next)
    -- 不透明字段渲染成独立运行时值，不再引用数据族参数：collect 必须与渲染同步跳过，
    -- 否则 usedTable 与声明 arity 漂移（类型参数个数对不上）。
    _ => []

dataUsedLevels : DtData -> List (String, List Int) -> List DtData -> List Int
dataUsedLevels d table datas =
  let
    raw =
      concatMap
        (\c => ctorUsedLevels (typeParamLevels d) table datas [] (dtCtorTelescope c) 0 (eval [] (dtCtorType c)))
        (dtDataCtors d)
  in filter (\l => memIntIn l raw) (typeParamLevels d)

levelListEq : List Int -> List Int -> Bool
levelListEq [] [] = True
levelListEq (x :: xs) (y :: ys) = x == y && levelListEq xs ys
levelListEq _ _ = False

sameLevelTable : List (String, List Int) -> List (String, List Int) -> Bool
sameLevelTable [] [] = True
sameLevelTable (a :: rest) (b :: rest2) =
  if firstOf a == firstOf b && levelListEq (secondOf a) (secondOf b) then
    sameLevelTable rest rest2
  else
    False
sameLevelTable _ _ = False

-- | 轮数上界 = 1 + 各族类型参数总数：不动点是单调子集链，每轮至少涨一个槽，
--   涨不动即收敛。固定 64 对族数×槽数大的程序会静默返回上一轮的表。
usedFixRounds : List DtData -> Int
usedFixRounds datas = 1 + usedSlotCount datas

usedSlotCount : List DtData -> Int
usedSlotCount [] = 0
usedSlotCount (d :: rest) = length (typeParamLevels d) + usedSlotCount rest

usedTableFix : List DtData -> List (String, List Int) -> List (String, List Int)
usedTableFix datas table = usedTableFixFuel (usedFixRounds datas) datas table

usedTableFixFuel : Int -> List DtData -> List (String, List Int) -> List (String, List Int)
usedTableFixFuel fuel datas table =
  if fuel <= 0 then
    table
  else
    let
      next = map (\d => (dtDataName d, dataUsedLevels d table datas)) datas
    in if sameLevelTable next table then next else usedTableFixFuel (fuel - 1) datas next

-- | 族 → 运行时类型参数槽（不动点到稳定；声明与实参共用这一份）。
tyParamsOf : List DtData -> List (String, List Int)
tyParamsOf datas = usedTableFix datas (map (\d => (dtDataName d, [])) datas)

recordFieldsOf : List DtData -> List (String, List (Int, String))
recordFieldsOf datas =
  map
    (\d => (dtDataName d, recordRtFields d))
    (filter hasRecordRepr (filter (\d => not (memName (dtDataName d) (unboxedFamilySet datas))) datas))

-- | Float 展示的唯一实现（`Base.Data.Float.floatRender`）：`Show Float`、`main : Float`
--   入口与模板插值都落到这里，三个后端共用同一份 `%.12g` 渲染。
export floatRenderRefName : String
floatRenderRefName = "Base.Data.Float.floatRender"

-- | 依赖表里的 `strFromFloat` 落成 `Base.Data.Float.floatRender`（否则可达性收集会漏）。
export factsDepsOf : LwEnv -> String -> List String
factsDepsOf env name =
  map (\d => if d == "strFromFloat" then floatRenderRefName else d) (factsOf env name).termUseDeps

factsOf : LwEnv -> String -> TermUse
factsOf env name = lookupFacts env.lwFacts name

-- ---------------------------------------------------------------
-- 共享元数据
-- ---------------------------------------------------------------
export lowerSharedOf : List DtData -> List DtDef -> HashMap String TermUse -> IrShared
lowerSharedOf datas defs facts =
  let
    runtime = rtDatasOf datas
    locRows = mapSome locRowPair defs
    usesTrace = anyDefFlag (\f => f.termUseFlags.useFlagsTrace) defs facts
    usesObs = anyDefFlag (\f => f.termUseFlags.useFlagsObs) defs facts
    -- tracing / 观测运行时也引用 Unix，所以它们的旗标同样触发宿主运行时。
    usesHost = anyDefFlag (\f => f.termUseFlags.useFlagsHost) defs facts || usesTrace || usesObs
    usesSched = anyDefFlag (\f => f.termUseFlags.useFlagsSched) defs facts
    usesEff = anyDefFlag (\f => f.termUseFlags.useFlagsEff) defs facts
  in IrShared
    (recordFieldsOf runtime)
    (listFamOf runtime)
    (anyDefFlag (\f => f.termUseFlags.useFlagsFloat || f.termUseFloatLit) defs facts)
    usesTrace
    usesObs
    locRows
    (map unboxedRowOf (unboxedInfoOf runtime))
    (ctorTableOf runtime)
    usesHost
    usesSched
    usesEff

-- | 去装箱表：`unboxedInfoOf` 的 `DtCtor` 收敛成构造子名（IR 只带名字）。
unboxedRowOf : (String, DtCtor, Int) -> (String, String, Int)
unboxedRowOf (family, ctor, idx) = (family, dtCtorName ctor, idx)

-- | 是否有任一可见定义命中旗标（隐藏 runtime 段按此按需追加）。
anyDefFlag : (TermUse -> Bool) -> List DtDef -> HashMap String TermUse -> Bool
anyDefFlag pred [] facts = False
anyDefFlag pred (d :: rest) facts =
  pred (lookupFacts facts (dtDefName d)) || anyDefFlag pred rest facts

lookupFacts : HashMap String TermUse -> String -> TermUse
lookupFacts facts name =
  case HashMap.lookup name facts of
    Just f => f
    Nothing => TermUse [] noUseFlags False

listFamOf : List DtData -> Maybe IrListFam
listFamOf datas =
  case findListFamilyData datas of
    Nothing => Nothing
    Just dd =>
      case findFamilyCtor (dtDataCtors dd) listNilCtor of
        Nothing => Nothing
        Just nilC =>
          case findFamilyCtor (dtDataCtors dd) listConsCtor of
            Nothing => Nothing
            Just consC => Just (IrListFam (dtDataName dd) (dtCtorName nilC) (dtCtorName consC))

findFamilyCtor : List DtCtor -> String -> Maybe DtCtor
findFamilyCtor [] name = Nothing
findFamilyCtor (c :: rest) name = if dtCtorName c == name then Just c else findFamilyCtor rest name

findListFamilyData : List DtData -> Maybe DtData
findListFamilyData [] = Nothing
findListFamilyData (d :: rest) =
  if dtDataName d == listFamilyName then Just d else findListFamilyData rest

ctorTableOf : List DtData -> List (String, String, List Bool)
ctorTableOf datas =
  concatMap
    (\d => map (\c => (dtCtorName c, dtCtorFamily c, ctorKeepFlags c)) (dtDataCtors d))
    datas

ctorOpaqueTableOf : List DtData -> List (String, List Bool)
ctorOpaqueTableOf datas =
  concatMap (\d => map (\c => (dtCtorName c, ctorOpaqueFlagsOf datas c)) (dtDataCtors d)) datas

-- | 构建 lowering 环境（split 路径每个程序一份；check 路径用 `lwEnvWithUnit ""`）。
export mkLwEnv : List DtData -> List DtDef -> List (String, Term) -> String -> Check LwEnv
mkLwEnv datas defs globals unit =
  Vuna.Compiler.Base.Common.bind
    (eraseDefs defs)
    (\defs2 => OkC (mkLwEnvFromErased datas defs2 defs globals unit))

-- | 擦除后 Core 的 typed view：运行时 `TVar` 下标归一化；类型面（binder 槽 /
-- 类型实参 / telescope）原样保留。类型级定义没有运行时项，跳过。
export eraseDefs : List DtDef -> Check (List DtDef)
eraseDefs defs =
  let
    runtimeNames = map dtDefName (firstOf (partitionDefs (defTable defs) defs))
    runtimeTbl = HashMap.insertAll (map (\n => (n, True)) runtimeNames) (HashMap.fromList [])
  in eraseDefsGo runtimeTbl defs []

eraseDefsGo : HashMap String Bool -> List DtDef -> List DtDef -> Check (List DtDef)
eraseDefsGo runtimeTbl [] acc = OkC (reverse acc)
eraseDefsGo runtimeTbl (d :: rest) acc =
  case d of
    DtDef name ty body sp =>
      if HashMap.member name runtimeTbl then
        Vuna.Compiler.Base.Common.bind
          (eraseTerm body)
          (\body2 => eraseDefsGo runtimeTbl rest (DtDef name ty body2 sp :: acc))
      else
        eraseDefsGo runtimeTbl rest (d :: acc)
    _ => eraseDefsGo runtimeTbl rest (d :: acc)

-- | 已擦除定义直接建环境（split 路径擦一次后复用，不再二次遍历）。
export mkLwEnvFromErased : List DtData -> List DtDef -> List DtDef -> List (String, Term) -> String -> LwEnv
mkLwEnvFromErased datas defs origDefs globals unit =
  let
    facts = defFactsTblOf defs
    shared = lowerSharedOf datas defs facts
    runtime = rtDatasOf datas
  in LwEnv
    shared
    runtime
    (dataTblOf runtime)
    (strTblOf (tyParamsOf runtime))
    (unboxedInfoOf runtime)
    (strTblOf shared.irSharedRecordFields)
    (strTblOf (ctorTableOf runtime))
    (strTblOf (ctorOpaqueTableOf runtime))
    (HashMap.ofNames (unboxedFamilySet runtime))
    (hasDataNamed listFamilyName datas)
    defs
    origDefs
    (defTblOf defs)
    (strTblOf globals)
    facts
    unit

-- | 全部定义的使用事实：每个体只遍历一次（依赖与旗标同源）。
defFactsTblOf : List DtDef -> HashMap String TermUse
defFactsTblOf defs =
  let
    -- `strFromFloat` 是内建名、不在定义表里；依赖遍历要放行它（落盘时改写成
    -- `Base.Data.Float.floatRender`）。
    names = nameSetOf ((::) "strFromFloat" (runtimeNamesOf defs))
  in HashMap.insertAll (map (\d => (dtDefName d, defFactsOf names d)) defs) (HashMap.fromList [])

defFactsOf : HashMap String Bool -> DtDef -> TermUse
defFactsOf names d =
  case dtDefBody d of
    Nothing => TermUse [] noUseFlags False
    Just body => termUseInto names useFlagsOfName body

-- 隐藏原语 → 旗标（`Intrinsics` 的六张清单是唯一真源；各类互不重叠）。
intrinsicUseFlagsTbl : HashMap String UseFlags
intrinsicUseFlagsTbl =
  HashMap.insertAll
    (append (map (\n => (n, UseFlags True False False False False False)) floatIntrinsicNames) (append (map (\n => (n, UseFlags False True False False False False)) logIntrinsicNames) (append (map (\n => (n, UseFlags False False True False False False)) obsIntrinsicNames) (append (map (\n => (n, UseFlags False False False True False False)) hostIntrinsicNames) (append (map (\n => (n, UseFlags False False False False True False)) schedIntrinsicNames) (map (\n => (n, UseFlags False False False False False True)) effIntrinsicNames))))))
    (HashMap.fromList [])

useFlagsOfName : String -> UseFlags
useFlagsOfName name =
  case HashMap.lookup name intrinsicUseFlagsTbl of
    Just f => f
    Nothing => noUseFlags

-- 名字 → 定义（重复名时取列表中靠前的那条：head 最后插入、桶内命中即返回，与 `findDtDef` 的「首个匹配」一致）。
export defTblOf : List DtDef -> HashMap String DtDef
defTblOf [] = HashMap.fromList []
defTblOf (d :: rest) = HashMap.insert (dtDefName d) d (defTblOf rest)

-- | 字符串键的关联表（程序级表：一次建好，热路径只查）。
strTblOf : List (String, v) -> HashMap String v
strTblOf pairs = HashMap.insertAll pairs (HashMap.fromList [])

-- | 数据族名 → 声明（运行时族列表的索引；类型渲染与构造子判定按名字查）。
dataTblOf : List DtData -> HashMap String DtData
dataTblOf datas = HashMap.insertAll (map (\d => (dtDataName d, d)) datas) (HashMap.fromList [])

-- | 程序里是否有这个名字的数据族（桥接内建的放行判据）。
export hasDataNamed : String -> List DtData -> Bool
hasDataNamed name [] = False
hasDataNamed name (d :: rest) = dtDataName d == name || hasDataNamed name rest

nameSetOf : List String -> HashMap String Bool
nameSetOf [] = HashMap.fromList []
nameSetOf (n :: rest) = HashMap.insert n True (nameSetOf rest)
