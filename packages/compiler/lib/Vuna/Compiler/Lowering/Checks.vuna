module Vuna.Compiler.Lowering.Checks where

-- Core 侧检查与定义体事实（纯分析，不产生 IR / 文本）。
--
-- 输入是 Elab 产出的 `DtProgram` 定义表（项上自带擦除标志），本模块负责：
--   - 类型级 / 运行时定义分区（`isTypeForming` / `partitionDefs`）；
--   - 运行时项的擦除检查（运行时位置不得出现被擦除绑定 / 类型 / 类型级定义）；
--   - axiom 的运行时使用检查；
--   - de Bruijn 作用域护栏；
--   - 运行时依赖遍历（`termDepsInto`，供 axiom 检查）与定义体使用事实
--     （`termUseInto`：运行时依赖 + float / tracing / obs 旗标，一次遍历）。
-- SCC 分组已迁到 `Vuna.Compiler.Ir.Analysis`（IR 层，不依赖 Core 的具体含义之外的东西）；
-- 本模块只提供输入它的「名字级」分析。不产生 OCaml 文本。
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Elab.Representation
import Vuna.Compiler.Elab.Term
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Usage

-- ---------------------------------------------------------------
-- 构造子应用的标准形态
-- ---------------------------------------------------------------
--
-- 精化器可能把饱和的构造子应用表示成嵌套 `TApp (TApp (TCon c []) a) b`，
-- 也可能直接给 `TCon c [a, b]`。这里统一折叠成 (构造子名, 实参列表)：
-- 擦除/依赖分析按实参自带的擦除标志判断，生成侧好一次性 tupled 出来。
export flattenConApp : Term -> Maybe (Pair String (List (Pair Term Rig)))
flattenConApp t =
  case flattenAppSpine t of
    Pair head args =>
      case head of
        TCon c cargs => Just (Pair c (append cargs args))
        TMk c cargs => Just (Pair c (append cargs args))
        _ => Nothing

-- | 应用脊展平：`TApp (TApp f a) b` → `(f, [a, b])`（一次线性累积，保持原序）。
export flattenAppSpine : Term -> Pair Term (List (Pair Term Rig))
flattenAppSpine t = flattenAppSpineGo t []

flattenAppSpineGo : Term -> List (Pair Term Rig) -> Pair Term (List (Pair Term Rig))
flattenAppSpineGo (TApp f a rig) acc = flattenAppSpineGo f (Pair a rig :: acc)
flattenAppSpineGo t acc = Pair t acc

-- ---------------------------------------------------------------
-- 预处理：分区（类型级 / 运行时）、擦除检查、依赖拓扑排序
-- ---------------------------------------------------------------
export defTable : List DtDef -> List (Pair String Term)
defTable [] = []
defTable (d :: rest) =
  case dtDefBody d of
    -- axiom 无体，不进 delta 展开表。
    Just body => Pair (dtDefName d) body :: defTable rest
    Nothing => defTable rest

export findDtDef : String -> List DtDef -> Maybe DtDef
findDtDef name [] = Nothing
findDtDef name (d :: rest) = if dtDefName d == name then Just d else findDtDef name rest

-- 无体/不透明顶层（`axiom`）判据（`Elab.Types.dtDefHasBody` 是唯一真源）。
isAxiomDef : DtDef -> Bool
isAxiomDef d = not (dtDefHasBody d)

export axiomNamesOf : List DtDef -> List String
axiomNamesOf [] = []
axiomNamesOf (d :: rest) =
  if isAxiomDef d then (::) (dtDefName d) (axiomNamesOf rest) else axiomNamesOf rest

isTypeLevelDef : HashMap String Term -> DtDef -> Bool
isTypeLevelDef tbl d = isTypeForming (force tbl solsEmpty defaultFuel (eval [] (dtDefType d)))

-- 类型级 / 运行时分区。`axiom` 是擦除/不透明顶层——**无论它的类型是什么**
-- 都进类型级分区（没有运行时定义体，不能被 codegen 生成）；它的运行时使用由
-- `checkNoAxiomRuntime` 报专门诊断。
export partitionDefs : List (Pair String Term) -> List DtDef -> Pair (List DtDef) (List String)
partitionDefs table defs = partitionDefsGo (HashMap.fromList table) defs [] []

partitionDefsGo : HashMap String Term -> List DtDef -> List DtDef -> List String -> Pair (List DtDef) (List String)
partitionDefsGo table [] runtime typeNames = Pair (reverse runtime) (reverse typeNames)
partitionDefsGo table (d :: rest) runtime typeNames =
  if isAxiomDef d then
    partitionDefsGo table rest runtime (dtDefName d :: typeNames)
  else if isTypeLevelDef table d then
    partitionDefsGo table rest runtime (dtDefName d :: typeNames)
  else
    partitionDefsGo table rest (d :: runtime) typeNames

-- 定义级诊断前缀（唯一实现在 `Diagnostics.cgDefLoc`，此处只做访问器适配）。
-- 有来源 span（`DtDef` 的 `Maybe Span`）时输出 `file:line:col: in `name`: `，
-- 没有时只有 `in `name`: `。CG 诊断是 `Err String`（不走位置层），在拼串处补前缀。
defLocDiag : DtDef -> Diagnostic -> Diagnostic
defLocDiag d e = withContext (dtDefSpan d) (dtDefName d) e

-- axiom 只在擦除/类型层可用；运行时位置（非擦除实参/非类型层）的使用报
-- `CG_AxiomAtRuntime`。用运行时依赖遍历（跳过擦除实参）找名字，类型层引用不报。
export checkNoAxiomRuntime : List String -> List DtDef -> Check Int
checkNoAxiomRuntime axiomNames defs = checkNoAxiomRuntimeGo (HashMap.ofNames axiomNames) defs

checkNoAxiomRuntimeGo : HashMap String Bool -> List DtDef -> Check Int
checkNoAxiomRuntimeGo axiomTbl [] = OkC 0
checkNoAxiomRuntimeGo axiomTbl (d :: rest) =
  case dtDefBody d of
    Nothing => checkNoAxiomRuntimeGo axiomTbl rest
    Just body =>
      case termDepsInto axiomTbl [] body of
        [] => checkNoAxiomRuntimeGo axiomTbl rest
        -- 带使用点定义的位置。
        name :: more => cgErrDefAt (dtDefSpan d) (dtDefName d) (AxiomAtRuntime name) [name]

export checkAllErasure : List String -> List DtDef -> Check Int
checkAllErasure typeNames [] = OkC 0
checkAllErasure typeNames (d :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkOneErasure typeNames d)
    (\_ => checkAllErasure typeNames rest)

-- 报错带上定义名：同一份程序里哪个函数有问题要能一眼看出来。
-- 有 span 时前缀 `file:line:col:`（保留 `in `name`: ` 形状）。
checkOneErasure : List String -> DtDef -> Check Int
checkOneErasure typeNames d =
  case dtDefExtern d of
    -- extern 没有 vuna 体，运行时实现由 OCaml `external` 提供；不参与擦除检查。
    Just _ => OkC 0
    Nothing =>
      case dtDefBody d of
        Nothing => icInternal "axiom reached the runtime erasure check (partition must erase it)"
        Just body =>
          case checkErasure typeNames [] body of
            ErrC e => ErrC (defLocDiag d e)
            OkC n => OkC n

-- binders：最近绑定在前（名字 + 是否擦除）。
export showMetaHint : Int -> String
showMetaHint m = " ?${m}"

checkErasureNode : Int -> List String -> List (Pair String Rig) -> Term -> Check Int
checkErasureNode fuel typeNames binders t =
  if fuel <= 0 then
    icFuel "erasure"
  else
    case t of
      TVar name i _ =>
        case binderAt i binders of
          Just (Pair n rig) => if rigIsErased rig then cgErr1 (TypeLevelBindingRuntime name) name else OkC 0
          Nothing => icInternal "unbound runtime variable ${name} (index ${i}, binders ${length binders})"
      TGlobal name => if memName name typeNames then cgErr1 (TypeLevelNameRuntime name) name else OkC 0
      TType l => cgErr0 TypeUsedAtRuntime
      TPi name implicit rig dom cod => cgErr0 TypeUsedAtRuntime
      TMeta m => cgErr1 (UnsolvedMetavarRuntime (showMetaHint m)) (showMetaHint m)
      TLam name rig _ _ body => checkErasureFuel (fuel - 1) typeNames (Pair name rig :: binders) body
      TApp f a rig =>
        case flattenConApp t of
          -- 嵌套在构造子上的应用按构造子实参检查（实参自带擦除标志，比 TApp 的更准）。
          Just (Pair c args) => checkConArgsErasureFuel (fuel - 1) typeNames binders args
          Nothing => if rigIsErased rig then checkErasureFuel (fuel - 1) typeNames binders f else Vuna.Compiler.Base.Common.bind (checkErasureFuel (fuel - 1) typeNames binders f) (\_ => checkErasureFuel (fuel - 1) typeNames binders a)
      -- 构造子应用只看非擦除实参（擦除实参是族参数/索引，允许是类型项）。
      TCon c args => checkConArgsErasureFuel (fuel - 1) typeNames binders args
      TMk c args => checkConArgsErasureFuel (fuel - 1) typeNames binders args
      -- record 类型应用只出现在类型层，不参与运行时擦除检查。
      TRecord name args => OkC 0
      -- case 的分支把「完整 telescope（表面顺序）」压栈后再检查分支体。
      TProj base c tele i fi => checkErasureFuel (fuel - 1) typeNames binders base
      TRecUpd base c tele idxs body => Vuna.Compiler.Base.Common.bind (checkErasureFuel (fuel - 1) typeNames binders base) (\_ => checkAltErasureFuel (fuel - 1) typeNames binders [CaseAlt c (bindersOfPairs tele) body])
      TCase scrut alts => Vuna.Compiler.Base.Common.bind (checkErasureFuel (fuel - 1) typeNames binders scrut) (\_ => checkAltErasureFuel (fuel - 1) typeNames binders alts)
      TInt n => OkC 0
      TStr s => OkC 0
      TFloat raw => OkC 0
      TBool b => OkC 0
      TIf c th el => Vuna.Compiler.Base.Common.bind (checkErasureFuel (fuel - 1) typeNames binders c) (\_ => Vuna.Compiler.Base.Common.bind (checkErasureFuel (fuel - 1) typeNames binders th) (\_ => checkErasureFuel (fuel - 1) typeNames binders el))

checkConArgsErasureFuel : Int -> List String -> List (Pair String Rig) -> List (Pair Term Rig) -> Check Int
checkConArgsErasureFuel fuel typeNames binders [] = if fuel <= 0 then icFuel "erasure" else OkC 0
checkConArgsErasureFuel fuel typeNames binders ((Pair arg rig) :: rest) =
  if fuel <= 0 then
    icFuel "erasure"
  else if rigIsErased rig then
    checkConArgsErasureFuel (fuel - 1) typeNames binders rest
  else
    Vuna.Compiler.Base.Common.bind
      (checkErasureFuel (fuel - 1) typeNames binders arg)
      (\_ => checkConArgsErasureFuel (fuel - 1) typeNames binders rest)

checkAltErasureFuel : Int -> List String -> List (Pair String Rig) -> List CaseAlt -> Check Int
checkAltErasureFuel fuel typeNames binders [] = if fuel <= 0 then icFuel "erasure" else OkC 0
checkAltErasureFuel fuel typeNames binders (alt :: rest) =
  if fuel <= 0 then
    icFuel "erasure"
  else
    let
      altBinders = binderPairs (caseAltBinders alt)
      env = append (reverse altBinders) binders
    in Vuna.Compiler.Base.Common.bind (checkErasureFuel (fuel - 1) typeNames env (caseAltBody alt)) (\_ => checkAltErasureFuel (fuel - 1) typeNames binders rest)

export binderAt : Int -> List (Pair String Rig) -> Maybe (Pair String Rig)
binderAt i [] = Nothing
binderAt i (b :: rest) = if i <= 0 then Just b else binderAt (i - 1) rest

-- 依赖：运行时会用到的 TGlobal（擦除实参里的不算）。
termDepsIntoFuel : Int -> HashMap String Bool -> List String -> Term -> List String
termDepsIntoFuel fuel runtimeNames acc t =
  if fuel <= 0 then
    acc
  else
    case t of
      TGlobal name => if HashMap.member name runtimeNames then addName name acc else acc
      TVar name i _ => acc
      TMeta m => acc
      TType l => acc
      TPi name implicit rig dom cod => acc
      TLam name rig _ _ body => termDepsIntoFuel (fuel - 1) runtimeNames acc body
      TApp f a rig =>
        case flattenConApp t of
          Just (Pair c args) => termDepsArgsFuel (fuel - 1) runtimeNames acc args
          Nothing => if rigIsErased rig then termDepsIntoFuel (fuel - 1) runtimeNames acc f else termDepsIntoFuel (fuel - 1) runtimeNames (termDepsIntoFuel (fuel - 1) runtimeNames acc f) a
      TCon c args => termDepsArgsFuel (fuel - 1) runtimeNames acc args
      TMk c args => termDepsArgsFuel (fuel - 1) runtimeNames acc args
      -- 类型应用不产生运行时依赖。
      TRecord name args => acc
      TProj base c tele i fi => termDepsIntoFuel (fuel - 1) runtimeNames acc base
      TRecUpd base c tele idxs body => termDepsAltsFuel (fuel - 1) runtimeNames (termDepsIntoFuel (fuel - 1) runtimeNames acc base) [CaseAlt c (bindersOfPairs tele) body]
      TCase scrut alts => termDepsAltsFuel (fuel - 1) runtimeNames (termDepsIntoFuel (fuel - 1) runtimeNames acc scrut) alts
      TInt n => acc
      TStr s => acc
      TFloat raw => acc
      TBool b => acc
      TIf c th el => termDepsIntoFuel (fuel - 1) runtimeNames (termDepsIntoFuel (fuel - 1) runtimeNames (termDepsIntoFuel (fuel - 1) runtimeNames acc c) th) el

termDepsArgsFuel : Int -> HashMap String Bool -> List String -> List (Pair Term Rig) -> List String
termDepsArgsFuel fuel runtimeNames acc [] = if fuel <= 0 then acc else acc
termDepsArgsFuel fuel runtimeNames acc ((Pair arg rig) :: rest) =
  if fuel <= 0 then
    acc
  else if rigIsErased rig then
    termDepsArgsFuel (fuel - 1) runtimeNames acc rest
  else
    termDepsArgsFuel (fuel - 1) runtimeNames (termDepsIntoFuel (fuel - 1) runtimeNames acc arg) rest

termDepsAltsFuel : Int -> HashMap String Bool -> List String -> List CaseAlt -> List String
termDepsAltsFuel fuel runtimeNames acc [] = if fuel <= 0 then acc else acc
termDepsAltsFuel fuel runtimeNames acc (alt :: rest) =
  if fuel <= 0 then
    acc
  else
    termDepsAltsFuel
      (fuel - 1)
      runtimeNames
      (termDepsIntoFuel (fuel - 1) runtimeNames acc (caseAltBody alt))
      rest

addName : String -> List String -> List String
addName name [] = [name]
addName name (x :: rest) = if x == name then (::) x rest else (::) x (addName name rest)

-- ---------------------------------------------------------------
-- 定义体的使用事实：一次遍历同时给出运行时依赖与隐藏原语旗标
-- ---------------------------------------------------------------
--
-- 依赖只记**运行时位置**（擦除实参里的引用不算）；旗标覆盖全部位置，与
-- `Core.termUsesFloat` 同口径（类型层里出现也算）。分组邻接表、`IrDef` 依赖、
-- `IrShared` 的 float / tracing / obs 开关都吃这一份结果，不再各自遍历。
-- | 三类隐藏原语的使用旗标。
export record UseFlags where
  useFlagsFloat : Bool
  useFlagsTrace : Bool
  useFlagsObs : Bool

export noUseFlags : UseFlags
noUseFlags = UseFlags False False False

orUseFlags : UseFlags -> UseFlags -> UseFlags
orUseFlags a b =
  UseFlags
    (a.useFlagsFloat || b.useFlagsFloat)
    (a.useFlagsTrace || b.useFlagsTrace)
    (a.useFlagsObs || b.useFlagsObs)

-- | 一个定义体的使用事实。
export record TermUse where
  termUseDeps : List String
  termUseFlags : UseFlags
  termUseFloatLit : Bool

export termUseInto : HashMap String Bool -> (String -> UseFlags) -> Term -> TermUse
termUseInto runtimeNames flagOf t =
  termUseFuel (useBudgetFor (termSize t)) runtimeNames flagOf True (TermUse [] noUseFlags False) t

-- | 使用事实的遍历预算：按项规模派生（每节点最多几步递归），不靠固定上限。
useBudgetFor : Int -> Int
useBudgetFor size = 512 + 4 * size

addRuntimeDep : HashMap String Bool -> Bool -> String -> TermUse -> TermUse
addRuntimeDep names live n u =
  if live && HashMap.member n names then
    TermUse (addName n u.termUseDeps) u.termUseFlags u.termUseFloatLit
  else
    u

withFlags : UseFlags -> TermUse -> TermUse
withFlags f u = TermUse u.termUseDeps (orUseFlags u.termUseFlags f) u.termUseFloatLit

termUseFuel : Int -> HashMap String Bool -> (String -> UseFlags) -> Bool -> TermUse -> Term -> TermUse
termUseFuel fuel names flagOf live acc t =
  if fuel <= 0 then
    acc
  else
    case t of
      TGlobal n => withFlags (flagOf n) (addRuntimeDep names live n acc)
      TFloat raw => TermUse acc.termUseDeps acc.termUseFlags True
      TVar n i sp => acc
      TMeta m => acc
      TType l => acc
      TInt n => acc
      TStr s => acc
      TBool b => acc
      TPi n implicit rig dom cod => termUseFuel (fuel - 1) names flagOf False (termUseFuel (fuel - 1) names flagOf False acc dom) cod
      TLam n rig _ _ body => termUseFuel (fuel - 1) names flagOf live acc body
      TApp f a rig => termUseFuel (fuel - 1) names flagOf (live && not (rigIsErased rig)) (termUseFuel (fuel - 1) names flagOf live acc f) a
      TCon c args => termUseArgsFuel (fuel - 1) names flagOf live acc args
      TMk c args => termUseArgsFuel (fuel - 1) names flagOf live acc args
      TRecord c args => termUseArgsFuel (fuel - 1) names flagOf False acc args
      TProj base c tele i fi => termUseFuel (fuel - 1) names flagOf live acc base
      TRecUpd base c tele idxs body => termUseFuel (fuel - 1) names flagOf live (termUseFuel (fuel - 1) names flagOf live acc base) body
      TCase scrut alts => termUseAltsFuel (fuel - 1) names flagOf live (termUseFuel (fuel - 1) names flagOf live acc scrut) alts
      TIf c th el => termUseFuel (fuel - 1) names flagOf live (termUseFuel (fuel - 1) names flagOf live (termUseFuel (fuel - 1) names flagOf live acc c) th) el

termUseArgsFuel : Int -> HashMap String Bool -> (String -> UseFlags) -> Bool -> TermUse -> List (Pair Term Rig) -> TermUse
termUseArgsFuel fuel names flagOf live acc [] = acc
termUseArgsFuel fuel names flagOf live acc ((Pair a rig) :: rest) =
  if fuel <= 0 then
    acc
  else
    termUseArgsFuel
      (fuel - 1)
      names
      flagOf
      live
      (termUseFuel (fuel - 1) names flagOf (live && not (rigIsErased rig)) acc a)
      rest

termUseAltsFuel : Int -> HashMap String Bool -> (String -> UseFlags) -> Bool -> TermUse -> List CaseAlt -> TermUse
termUseAltsFuel fuel names flagOf live acc [] = acc
termUseAltsFuel fuel names flagOf live acc (alt :: rest) =
  if fuel <= 0 then
    acc
  else
    termUseAltsFuel
      (fuel - 1)
      names
      flagOf
      live
      (termUseFuel (fuel - 1) names flagOf live acc (caseAltBody alt))
      rest

export runtimeNamesOf : List DtDef -> List String
runtimeNamesOf [] = []
runtimeNamesOf (d :: rest) = dtDefName d :: runtimeNamesOf rest

-- ---------------------------------------------------------------
-- de Bruijn index 的作用域护栏。
-- `Core.varIndex` 越界返回 -1（不静默指向 0）；这里对**全部**定义体
-- （含类型级定义，它们整体擦除、不过擦除检查）做一次作用域验证，任何
-- 越界/负 index 都在 check 期报内部错误，而不是在 codegen/OCaml 阶段才炸。
checkTermScopes : Int -> Term -> Check Int
checkTermScopes depth (TVar name i _) =
  if i >= 0 then
    if i < depth then OkC 0 else icInternal "out-of-scope de Bruijn index ${i} (depth ${depth})"
  else
    icInternal "negative de Bruijn index ${i}"
checkTermScopes depth (TGlobal name) = OkC 0
checkTermScopes depth (TInt n) = OkC 0
checkTermScopes depth (TStr s) = OkC 0
checkTermScopes depth (TFloat raw) = OkC 0
checkTermScopes depth (TBool b) = OkC 0
checkTermScopes depth (TType l) = OkC 0
checkTermScopes depth (TMeta m) = OkC 0
-- 作用域与运行时擦除无关——擦除只影响 codegen，不是「可以引用越界变量」的
-- 许可证；TApp 的擦除实参与构造子实参同样要查。
checkTermScopes depth (TApp f a rig) =
  Vuna.Compiler.Base.Common.bind (checkTermScopes depth f) (\_ => checkTermScopes depth a)
checkTermScopes depth (TCon c args) = checkTermScopesArgs depth args
checkTermScopes depth (TMk c args) = checkTermScopesArgs depth args
checkTermScopes depth (TRecord c args) = checkTermScopesArgs depth args
checkTermScopes depth (TLam name rig slot _ body) =
  Vuna.Compiler.Base.Common.bind
    (checkTermScopesSlot depth slot)
    (\_ => checkTermScopes (depth + 1) body)
checkTermScopes depth (TPi name implicit rig dom cod) =
  Vuna.Compiler.Base.Common.bind (checkTermScopes depth dom) (\_ => checkTermScopes (depth + 1) cod)
checkTermScopes depth (TIf c th el) =
  Vuna.Compiler.Base.Common.bind
    (checkTermScopes depth c)
    (\_ => Vuna.Compiler.Base.Common.bind (checkTermScopes depth th) (\_ => checkTermScopes depth el))
checkTermScopes depth (TProj base c tele i fi) = checkTermScopes depth base
checkTermScopes depth (TRecUpd base c tele idxs body) =
  Vuna.Compiler.Base.Common.bind
    (checkTermScopes depth base)
    (\_ => checkTermScopes (depth + length tele) body)
checkTermScopes depth (TCase scrut alts) =
  Vuna.Compiler.Base.Common.bind (checkTermScopes depth scrut) (\_ => checkAltScopes depth alts)

checkTermScopesMaybe : Int -> Maybe Term -> Check Int
checkTermScopesMaybe depth Nothing = OkC 0
checkTermScopesMaybe depth (Just t) = checkTermScopes depth t

checkTermScopesSlot : Int -> Maybe (Pair (Maybe Term) (Maybe Term)) -> Check Int
checkTermScopesSlot depth Nothing = OkC 0
checkTermScopesSlot depth (Just p) =
  Vuna.Compiler.Base.Common.bind
    (checkTermScopesMaybe depth (firstOf p))
    (\_ => checkTermScopesMaybe (depth + 1) (secondOf p))

checkTermScopesArgs : Int -> List (Pair Term Rig) -> Check Int
checkTermScopesArgs depth [] = OkC 0
checkTermScopesArgs depth ((Pair arg _) :: rest) =
  Vuna.Compiler.Base.Common.bind (checkTermScopes depth arg) (\_ => checkTermScopesArgs depth rest)

checkAltScopes : Int -> List CaseAlt -> Check Int
checkAltScopes depth [] = OkC 0
checkAltScopes depth (alt :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkTermScopes (depth + length (caseAltBinders alt)) (caseAltBody alt))
    (\_ => checkAltScopes depth rest)

export checkAllDefScopes : List DtDef -> Check Int
checkAllDefScopes [] = OkC 0
checkAllDefScopes (d :: rest) =
  case dtDefBody d of
    -- axiom 没有体；作用域护栏只检查会落项的体。
    Nothing => checkAllDefScopes rest
    -- 内部护栏错误也带定义来源位置，便于定位生成定义。
    Just body =>
      case checkTermScopes 0 body of
        ErrC e => ErrC (defLocDiag d e)
        OkC n => checkAllDefScopes rest

export termDepsInto : HashMap String Bool -> List String -> Term -> List String
termDepsInto a1 a2 a3 = termDepsIntoFuel (useBudgetFor (termSize a3)) a1 a2 a3

termDepsArgs : HashMap String Bool -> List String -> List (Pair Term Rig) -> List String
termDepsArgs a1 a2 a3 = termDepsArgsFuel 100000 a1 a2 a3

termDepsAlts : HashMap String Bool -> List String -> List CaseAlt -> List String
termDepsAlts a1 a2 a3 = termDepsAltsFuel 100000 a1 a2 a3

checkErasure : List String -> List (Pair String Rig) -> Term -> Check Int
checkErasure typeNames binders t =
  checkErasureFuel (erasureFuelFor (termSize t)) typeNames binders t

-- D24：每个节点先试折闭合 Nat 链 —— 链里只有 canonical `Zero`/`Succ`，不可能藏擦除违规；
-- 折回后既不按链长吃 fuel，也不逐节点展开长字面量。
checkErasureFuel : Int -> List String -> List (Pair String Rig) -> Term -> Check Int
checkErasureFuel fuel typeNames binders t =
  if fuel <= 0 then
    icFuel "erasure"
  else
    case natChainValue t of
      Just _ => OkC 0
      Nothing => checkErasureNode fuel typeNames binders t

-- | 擦除检查的 fuel 派生（D24）：固定 512 对深项不够，按项节点数放大（每节点最多几步
-- 递归）；上限 `erasureFuelMax` 防失控输入。Nat 字面量链已在入口折回，不依赖这条。
erasureFuelFor : Int -> Int
erasureFuelFor size =
  let
    scaled = 512 + 4 * size
  in if scaled > erasureFuelMax then erasureFuelMax else scaled

erasureFuelMax : Int
erasureFuelMax = 1000000

erasureFuelForArgs : List (Pair Term Rig) -> Int
erasureFuelForArgs [] = 0
erasureFuelForArgs ((Pair a _) :: rest) = termSize a + erasureFuelForArgs rest

checkConArgsErasure : List String -> List (Pair String Rig) -> List (Pair Term Rig) -> Check Int
checkConArgsErasure a1 a2 a3 =
  checkConArgsErasureFuel (erasureFuelFor (erasureFuelForArgs a3)) a1 a2 a3

checkAltErasure : List String -> List (Pair String Rig) -> List CaseAlt -> Check Int
checkAltErasure a1 a2 a3 = checkAltErasureFuel (erasureFuelFor (erasureFuelForAlts a3)) a1 a2 a3

erasureFuelForAlts : List CaseAlt -> Int
erasureFuelForAlts [] = 0
erasureFuelForAlts (alt :: rest) = termSize (caseAltBody alt) + erasureFuelForAlts rest
