module Vuna.Compiler.Lowering.Program where

-- Core → IR 的唯一入口。
--
-- 这里集中全部**决策**，后端只渲染文本：
--   * 擦除：擦除 binder 占位、擦除实参丢弃、擦除分支 binder；
--   * 表示：record 字段表、构造子实参对齐与不透明 cast、去装箱族、类型参数槽、
--     Nat 字面量折回（`Core.natChainValue`）与 Nat case 降级；
--   * 形态判定：内建饱和内联、`++` 链展平、case 分支 binder 形状、unboxed case 降级；
--   * 入口分类（动作 / 值）、展示函数、动作行的宿主 handler 序列。
--
-- 输出 `Ir`（只有确定性纯数据，不含 `Term` / `Value` / `DtDef`）。后端
-- （`Codegen.{Decl,Term,Assembly,Split}`）此后只消费 IR，边界由 `checks.ir-boundary`
-- 守护；`Core` / `Elab` / `Intrinsics` 只允许出现在本模块。
--
-- 门禁：产物逐字节确定（[architecture-target.md] 的 IR 门禁）。因此本模块的遍历顺序、
-- fresh 编号分配顺序、分支与实参顺序都不能随实现方式变化。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Source as Source
import Vuna.Compiler.Base.Obs
import Vuna.Compiler.Base.Diagnostics
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Representation
import Vuna.Compiler.Base.Intrinsics
import Vuna.Compiler.Ir.Model
import Vuna.Compiler.Ir.Dispatch
import Vuna.Compiler.Ir.Represent
import Vuna.Compiler.Ir.Analysis
import Vuna.Compiler.Ir.Runtime
import Vuna.Compiler.Ir.Validate
import Vuna.Compiler.Lowering.Checks
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Codegen.Runtime
import Base.Effect.Types as EffTypes
export module Vuna.Compiler.Lowering.Env
export module Vuna.Compiler.Lowering.Ty
export module Vuna.Compiler.Lowering.Entry

-- 小工具
-- ---------------------------------------------------------------
-- 小名字列表用 `Base.Data.List` 的 `memName` / `lookupPair`；程序级大表（构造子、族、
-- 类型参数槽）在 `LwEnv` 里建一次哈希索引，热路径只查表。
-- 小名字列表用 `Base.Data.List` 的 `memName`；程序级大表在 `LwEnv` 里建一次哈希索引。
-- | 单元内生成状态（唯一可变量：case / Nat case 的 fresh binder 计数）。
export record LwSt where
  lwNext : Int

-- record 字段访问器（vuna 不为 record 生成字段函数，统一用位置模式）。
binderErasedOf : IrBinder -> Bool
binderErasedOf (IrBinder nm erased ty) = erased

-- ---------------------------------------------------------------
-- 项 → IR
-- ---------------------------------------------------------------
--
-- 遍历顺序、fresh 编号分配、分支与实参顺序必须稳定（门禁是逐字节一致）。
--
-- **预算与 `if fuel <= 0` 守卫是终止性证书**：项 lowering 有非结构边（`TRecord`
-- 展开成应用脊、非 record 族的 `TProj` / `TRecUpd` 展开成 `case`、从应用脊 / 实参
-- 列表取子项），DT 的 SCT 只接受「结构下降或**带守卫的**递减 Int」；删掉守卫会让
-- 终止性检查直接失败。预算按项规模派生（`lowerBudgetFor size = 8 * size + 512`，
-- 每个节点最多消耗几步），因此深层合法项不会误报 `IC_FuelExhausted (codegen)`。
--
-- binder 栈 `List IrBinder` 最近绑定在前；`IrVar` 直接携带 binder 身份（Lowering
-- 已把 de Bruijn 下标解析掉），运行时引用擦除 binder 在这里就是错误。
lowerBudgetFor : Int -> Int
lowerBudgetFor size = 512 + 8 * size

export lowerTerm : LwEnv -> LwSt -> List IrBinder -> Term -> Check (Pair Ir LwSt)
lowerTerm env st binders t = lowerTermFuel (lowerBudgetFor (termSize t)) env st binders t

lowerTermFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> Check (Pair Ir LwSt)
lowerTermFuel fuel env st binders t =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    case t of
      TVar name i sp =>
        case binderAtIn i binders of
          Just b => if binderErasedOf b then cgErr1 (TypeLevelBindingRuntime name) name else OkC (Pair (IrVar b) st)
          Nothing => icInternal "unbound runtime variable"
      TGlobal name => Vuna.Compiler.Base.Common.bind (lowerGlobalRef env name) (\ir => OkC (Pair ir st))
      TInt n => OkC (Pair (IrInt n) st)
      TStr s => OkC (Pair (IrStr s) st)
      TFloat raw => OkC (Pair (IrFloatLit raw) st)
      TBool b => OkC (Pair (IrBool b) st)
      TIf c th el =>
        Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st binders c) (
            \pc =>
              case pc of
                Pair irC st1 =>
                  Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st1 binders th) (
                      \pt =>
                        case pt of
                          Pair irT st2 =>
                            Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st2 binders el) (
                                \pe =>
                                  case pe of
                                    Pair irE st3 => OkC (Pair (IrIf irC irT irE) st3)
                              )
                    )
          )
      TLam name rig slot sp body => lowerLamFuel (fuel - 1) env st binders name rig slot sp body
      TApp f a rig => lowerAppFuel (fuel - 1) env st binders f a rig
      TCon c args => lowerConAppFuel (fuel - 1) env st binders c args
      TMk c args => lowerConAppFuel (fuel - 1) env st binders c args
      -- R4：record 类型应用展开回 `TGlobal` 应用脊（产物与改造前逐字节一致）。
      TRecord name args => lowerTermFuel (fuel - 1) env st binders (recordTermAsAppIn (TGlobal name) args)
      TCase scrut alts => lowerCaseFuel (fuel - 1) env st binders scrut alts
      -- R4：record 族的更新/投影直接用 OCaml record 语法；非 record 仍按 case 形状展开。
      TRecUpd base c tele idxs body =>
        case HashMap.lookup c env.lwRecordFields of
          Just fields => lowerRecordUpdateFuel (fuel - 1) env st binders base c tele fields idxs body
          Nothing => lowerTermFuel (fuel - 1) env st binders (TCase base [CaseAlt c (bindersOfPairs tele) body])
      TProj base c tele i fi =>
        case HashMap.lookup c env.lwRecordFields of
          Just fields =>
            Vuna.Compiler.Base.Common.bind (recordFieldNameAt fi fields) (
                \label =>
                  Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st binders base) (
                      \p =>
                        case p of
                          Pair baseIr st2 =>
                            Vuna.Compiler.Base.Common.bind (ctorKeptFieldTys env c) (
                                \fieldTys =>
                                  let
                                    args = irTyDataArgsOf (annotTyOf env binders base)
                                    resTy =
                                      case lookupRtPosIn fi fields 0 of
                                        Just pos => irTyAt (map (irTySubstVars args) fieldTys) pos
                                        Nothing => Nothing
                                  in OkC (Pair (IrProj baseIr c label resTy) st2)
                              )
                    )
              )
          Nothing => lowerProjAsCaseFuel (fuel - 1) env st binders base c tele i fi
      TPi name implicit rig dom cod => cgErr0 TypeUsedAtRuntime
      TType l => cgErr0 TypeUsedAtRuntime
      TMeta m => cgErr1 (UnsolvedMetavarRuntime (showMetaHint m)) (showMetaHint m)

binderAtIn : Int -> List IrBinder -> Maybe IrBinder
binderAtIn i [] = Nothing
binderAtIn i (b :: rest) = if i <= 0 then Just b else binderAtIn (i - 1) rest

recordFieldNameAt : Int -> List (Pair Int String) -> Check String
recordFieldNameAt i [] = icInternal "record field position out of range"
recordFieldNameAt i ((Pair n label) :: rest) =
  if n == i then OkC label else recordFieldNameAt i rest

-- | 把 `TRecord name args` 展开成等价 `TApp` 链。
recordTermAsAppIn : Term -> List (Pair Term Rig) -> Term
recordTermAsAppIn t [] = t
recordTermAsAppIn t ((Pair a rig) :: rest) = recordTermAsAppIn (TApp t a rig) rest

-- | 顶层名引用：Nat 构造子 / 程序构造子 / 内建 / 普通运行时定义。
-- 分支顺序固定（Nat Zero → `0`；Succ → `@ir@natSucc`）：交换顺序会让产物与诊断漂移。
-- 需要 List 桥接的内建在没有 canonical `Base.Data.List.List` 族时报 `CG_ListBridgeRequired`。
lowerGlobalRef : LwEnv -> String -> Check Ir
lowerGlobalRef env name =
  if name == natZeroCtor then
    OkC (IrInt 0)
  else if name == "strFromFloat" then
    OkC (IrGlobal floatRenderRefName)
  else if name == natSuccCtor then
    OkC (IrRt irRtNatSucc)
  else
    case HashMap.lookup name env.lwCtors of
      Just (Pair family keepFlags) => OkC (IrCtor family name Nothing [])
      Nothing =>
        case findIntrinsic name of
          Just i => if name == primEffBind1Name then OkC (IrEffBind effTypeName effMkCtor effUnitTyIn) else if intrinsicReturnsEff i then lowerBridgeGuard env name (IrEffThunk effTypeName effMkCtor effUnitTyIn (intrinsicArity i) (IrRt (intrinsicName i))) else lowerBridgeGuard env name (IrRt (intrinsicName i))
          Nothing => OkC (IrGlobal name)

-- 需要 List 桥接的内建：程序必须声明 canonical `Base.Data.List.List` 族，
-- 否则报 `CG_ListBridgeRequired`。
-- 桥接标记来自契约（`Ir.Runtime`，单一来源）。
lowerBridgeGuard : LwEnv -> String -> Ir -> Check Ir
lowerBridgeGuard env name ir =
  if irRtBridgesList name then
    if env.lwHasListFamily then OkC ir else cgErr1 (ListBridgeRequired name) name
  else
    OkC ir

effUnitTyIn : IrTy
effUnitTyIn = IrTyData effUnitTypeName []

-- 多参数 lambda 链合并。
-- 擦除 binder 只占 de Bruijn 位置、不作为 OCaml 参数。
-- 每个参数的 binder 类型槽（派生信息）随链一起带下来，供 IR 的选择性标注使用。
record LamParam where
  lamParamName : String
  lamParamRig : Rig
  lamParamTy : Maybe Term

record LamChainIn where
  lamChainBinders : List LamParam
  lamChainBody : Term
  lamChainResultTy : Maybe Term

collectLamChainIn : Term -> LamChainIn
collectLamChainIn (TLam name rig slot _ body) =
  let
    p = collectLamChainIn body
    result =
      case p.lamChainResultTy of
        Just _ => p.lamChainResultTy
        Nothing => lamResultTyOf slot
  in LamChainIn (LamParam name rig (lamBinderTyOf slot) :: p.lamChainBinders) p.lamChainBody result
collectLamChainIn t = LamChainIn [] t Nothing

lowerLamFuel : Int -> LwEnv -> LwSt -> List IrBinder -> String -> Rig -> Maybe (Pair (Maybe Term) (Maybe Term)) -> Span -> Term -> Check (Pair Ir LwSt)
lowerLamFuel fuel env st binders name rig slot sp body =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    case collectLamChainIn (TLam name rig slot sp body) of
      LamChainIn params inner resultTy => lowerLamChainFuel fuel env st binders [] params inner resultTy

-- λ 链的公共部分：binder 表 + 结果类型 + 体。`hints` 是外层签名给的 runtime 域类型
-- （按非擦除参数逐位对齐；为空表示全部走 Core 侧的注解）。
lowerLamChainFuel : Int -> LwEnv -> LwSt -> List IrBinder -> List IrTy -> List LamParam -> Term -> Maybe Term -> Check (Pair Ir LwSt)
lowerLamChainFuel fuel env st binders hints params inner resultTy =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    let
      bs = bindersOfParamsHint env binders hints params
      envB = append (reverse bs) binders
      resultIr =
        case resultTy of
          Nothing => Nothing
          Just t =>
            case annotTyOf env envB t of
              Just ty => Just ty
              -- 族实参不可命名（类型变量、擦除占位）时仍要留下「结果是 Eff」这一位：
              -- 机器化 CPS 只按它判定 `a -> Eff r b`（见 Ir.Cps.isEffResultTy）。
              Nothing => effResultTyOf t
    in Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st envB inner) (
        \p =>
          case p of
            Pair b st2 =>
              let
                resultIr2 =
                  case resultIr of
                    Just _ => resultIr
                    Nothing => irResultTyOf b
              in OkC (Pair (IrLam bs resultIr2 b) st2)
      )

-- 顶层定义体：签名箭头与 λ 链的运行时 binder 逐位对应时用签名回填 binder 类型
-- （其余情形按 Core 侧注解 lowering）。
lowerDefBodyTerm : LwEnv -> LwSt -> Term -> Maybe IrTy -> Check (Pair Ir LwSt)
lowerDefBodyTerm env st body defTy =
  case collectLamChainIn body of
    LamChainIn [] _ _ => lowerTerm env st [] body
    LamChainIn params inner resultTy =>
      case defTy of
        Nothing => lowerTerm env st [] body
        Just sigTy =>
          case sigArrowTys 256 sigTy of
            Nothing => lowerTerm env st [] body
            Just arrows =>
              if listLength arrows == countRuntimeParams params then
                lowerLamChainFuel
                  (lowerBudgetFor (termSize body))
                  env
                  st
                  []
                  arrows
                  params
                  inner
                  resultTy
              else
                lowerTerm env st [] body

countRuntimeParams : List LamParam -> Int
countRuntimeParams [] = 0
countRuntimeParams (p :: rest) =
  if rigIsErased p.lamParamRig then countRuntimeParams rest else 1 + countRuntimeParams rest

sigArrowTys : Int -> IrTy -> Maybe (List IrTy)
sigArrowTys fuel ty =
  if fuel <= 0 then
    Nothing
  else
    case ty of
      IrTyFun dom cod =>
        case sigArrowTys (fuel - 1) cod of
          Nothing => Nothing
          Just rest => Just (dom :: rest)
      _ => Just []

-- | 结果类型不可命名时的族身份：只认 `Eff`（实体是数据族，运行时类型实参无用途）。
effResultTyOf : Term -> Maybe IrTy
effResultTyOf t =
  case headGlobalOf t of
    Just g => if g == irEffTypeName then Just (IrTyData irEffTypeName [IrTyOpaque]) else Nothing
    Nothing => Nothing

headGlobalOf : Term -> Maybe String
headGlobalOf (TGlobal g) = Just g
headGlobalOf (TApp f _ _) = headGlobalOf f
headGlobalOf (TRecord g _) = Just g
headGlobalOf _ = Nothing

-- lambda 链的 binder 表（外→内）：每个 binder 的注解按它自己的外层上下文解析。
bindersOfParams : LwEnv -> List IrBinder -> List LamParam -> List IrBinder
bindersOfParams env outer [] = []
bindersOfParams env outer (p :: rest) =
  let
    b = binderOfParam env outer p
  in b :: bindersOfParams env (b :: outer) rest

binderOfParam : LwEnv -> List IrBinder -> LamParam -> IrBinder
binderOfParam env outer p =
  if rigIsErased p.lamParamRig then
    mkIrBinderErased
  else
    case p.lamParamTy of
      Nothing => mkIrBinder p.lamParamName
      Just ty => mkIrBinderTyped p.lamParamName (annotTyOfTotal env outer ty)

-- 带外层签名提示的 binder 表：非擦除参数按顺序消费一个提示类型。
-- 提示类型可以含 `IrTyOpaque`：OCaml 侧的 lambda 注解由 `irTyAnnotatable` 过滤，
-- 不透明类型不会写进 OCaml，因此不会固定多态性。
bindersOfParamsHint : LwEnv -> List IrBinder -> List IrTy -> List LamParam -> List IrBinder
bindersOfParamsHint env outer _ [] = []
bindersOfParamsHint env outer hints (p :: rest) =
  let
    erased = rigIsErased p.lamParamRig
    hint =
      if erased then
        Nothing
      else
        case hints of
          h :: _ => Just h
          [] => Nothing
    restHints =
      if erased then
        hints
      else
        case hints of
          _ :: hs => hs
          [] => []
    b =
      case hint of
        Just ty => mkIrBinderTyped p.lamParamName ty
        Nothing => binderOfParam env outer p
  in b :: bindersOfParamsHint env (b :: outer) restHints rest

-- 应用：先按构造子折叠（多维变体构造子是 tupled 的），再试内建内联 / `++` 展平 / 普通应用。
lowerAppFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> Term -> Rig -> Check (Pair Ir LwSt)
lowerAppFuel fuel env st binders f a rig =
  if fuel <= 0 then
    icFuel "ir-lower"
  else if rigIsErased rig then
    lowerTermFuel (fuel - 1) env st binders f
  else
    case flattenConApp (TApp f a rig) of
      Just (Pair c args) => lowerConAppFuel (fuel - 1) env st binders c args
      Nothing =>
        case flattenConcatChainIn (TApp f a rig) of
          Just parts =>
            if listLength parts >= 3 then
              Vuna.Compiler.Base.Common.bind (lowerTermsFuel (fuel - 1) env st binders parts) (
                  \p =>
                    case p of
                      Pair texts st2 => OkC (Pair (IrConcatMany texts) st2)
                )
            else
              lowerPlainAppFuel (fuel - 1) env st binders (TApp f a rig)
          Nothing => lowerPlainAppFuel (fuel - 1) env st binders (TApp f a rig)

lowerPlainAppFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> Check (Pair Ir LwSt)
lowerPlainAppFuel fuel env st binders t =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    case t of
      TApp f a rig =>
        case flattenIntrinsicAppIn t of
          Just (Pair name args) =>
            if inlineArityMatchesIn name args then
              Vuna.Compiler.Base.Common.bind (lowerInlineArgsFuel (fuel - 1) env st binders args) (
                  \p =>
                    case p of
                      Pair irs st2 => OkC (Pair (IrRtApp name irs) st2)
                )
            else
              lowerAppFallbackFuel (fuel - 1) env st binders f a rig
          Nothing => lowerAppFallbackFuel (fuel - 1) env st binders f a rig
      _ => icInternal "lowerPlainApp expects an application"

appTyOf : LwEnv -> List IrBinder -> Term -> Maybe (Pair IrTy IrTy)
appTyOf env binders f =
  case annotCalleeTy env binders f of
    Just (fn@(IrTyFun _ cod)) => Just (Pair fn cod)
    _ => Nothing

-- 已降低 callee 的节点类型兜底：内联 lambda / 已带函数类型的变量在这里命中。
appTyOfIr : Ir -> Maybe (Pair IrTy IrTy)
appTyOfIr ir =
  case irResultTyOf ir of
    Just (fn@(IrTyFun _ cod)) => Just (Pair fn cod)
    _ => Nothing

appTyFrom : LwEnv -> List IrBinder -> Term -> Ir -> Maybe (Pair IrTy IrTy)
appTyFrom env binders f irF =
  case appTyOf env binders f of
    Just p => Just p
    Nothing => appTyOfIr irF

lowerAppFallbackFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> Term -> Rig -> Check (Pair Ir LwSt)
lowerAppFallbackFuel fuel env st binders f a rig =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st binders f) (
        \pf =>
          case pf of
            Pair irF st1 =>
              Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st1 binders a) (
                  \pa =>
                    case pa of
                      Pair irA st2 => OkC (Pair (IrApp (appTyFrom env binders f irF) irF irA) st2)
                )
      )

lowerInlineArgsFuel : Int -> LwEnv -> LwSt -> List IrBinder -> List (Pair Term Rig) -> Check (Pair (List Ir) LwSt)
lowerInlineArgsFuel fuel env st binders [] =
  if fuel <= 0 then icFuel "ir-lower" else OkC (Pair [] st)
lowerInlineArgsFuel fuel env st binders ((Pair arg rig) :: rest) =
  if fuel <= 0 then
    icFuel "ir-lower"
  else if rigIsErased rig then
    icInternal "erased argument in inlined builtin application"
  else
    Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st binders arg) (
        \p =>
          case p of
            Pair ir st2 =>
              Vuna.Compiler.Base.Common.bind (lowerInlineArgsFuel (fuel - 1) env st2 binders rest) (
                  \q =>
                    case q of
                      Pair irs st3 => OkC (Pair ((::) ir irs) st3)
                )
      )

lowerTermsFuel : Int -> LwEnv -> LwSt -> List IrBinder -> List Term -> Check (Pair (List Ir) LwSt)
lowerTermsFuel fuel env st binders [] = if fuel <= 0 then icFuel "ir-lower" else OkC (Pair [] st)
lowerTermsFuel fuel env st binders (t :: rest) =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st binders t) (
        \p =>
          case p of
            Pair ir st2 =>
              Vuna.Compiler.Base.Common.bind (lowerTermsFuel (fuel - 1) env st2 binders rest) (
                  \q =>
                    case q of
                      Pair irs st3 => OkC (Pair ((::) ir irs) st3)
                )
      )

-- `++` 应用树展平成叶子列表（右结合 / 左结合都吃）；非 `++` 根返回 Nothing。
flattenConcatChainIn : Term -> Maybe (List Term)
flattenConcatChainIn (TApp (TApp head l rl) r rr) =
  if rigIsErased rl || rigIsErased rr then
    Nothing
  else
    case head of
      TGlobal g => if g == "++" then Just (append (concatLeavesIn l) (concatLeavesIn r)) else Nothing
      _ => Nothing
flattenConcatChainIn _ = Nothing

concatLeavesIn : Term -> List Term
concatLeavesIn t = concatLeavesGo t []

concatLeavesGo : Term -> List Term -> List Term
concatLeavesGo (TApp (TApp head l rl) r rr) acc =
  let
    whole = TApp (TApp head l rl) r rr
  in if rigIsErased rl || rigIsErased rr then
    whole :: acc
  else
    case head of
      TGlobal g => if g == "++" then concatLeavesGo l (concatLeavesGo r acc) else whole :: acc
      _ => whole :: acc
concatLeavesGo t acc = t :: acc

-- `f a1 ... an` 的 head 是内建、且每个实参都未擦除时，收集 (名字, 实参)（左→右）。
-- 脊只展平一次：长应用链上不按层重复拼接。
flattenIntrinsicAppIn : Term -> Maybe (Pair String (List (Pair Term Rig)))
flattenIntrinsicAppIn t =
  case flattenAppSpine t of
    Pair head args =>
      if allRuntimeArgs args then
        case head of
          TGlobal name => if irInlineArity name > 0 then Just (Pair name args) else Nothing
          _ => Nothing
      else
        Nothing

allRuntimeArgs : List (Pair Term Rig) -> Bool
allRuntimeArgs [] = True
allRuntimeArgs ((Pair a rig) :: rest) = not (rigIsErased rig) && allRuntimeArgs rest

inlineArityMatchesIn : String -> List (Pair Term Rig) -> Bool
inlineArityMatchesIn name args =
  if irInlineArity name <= 0 then False else listLength args == irInlineArity name

-- ---------------------------------------------------------------
-- 构造子应用
-- ---------------------------------------------------------------
-- 实参有两种合法约定（全 telescope / 仅保留字段），都归一成
-- 运行时实参列表（只含非擦除位）。
alignCtorArgs : String -> List Bool -> List (Pair Term Rig) -> Check (List (Pair Term Rig))
alignCtorArgs label [] [] = OkC []
alignCtorArgs label [] (_ :: _) =
  icInternal "constructor ${label}: application has more arguments than its shape"
alignCtorArgs label (keep :: flags) [] =
  if keep then
    icInternal "constructor ${label}: application has fewer arguments than its shape"
  else
    alignCtorArgs label flags []
alignCtorArgs label (keep :: flags) ((Pair arg rig) :: rest) =
  if keep then
    if rigIsErased rig then
      icInternal "constructor ${label}: runtime field marked erased"
    else
      Vuna.Compiler.Base.Common.bind
        (alignCtorArgs label flags rest)
        (\ts => OkC ((::) (Pair arg rig) ts))
  else if rigIsErased rig then
    alignCtorArgs label flags rest
  else
    alignCtorArgs label flags (Pair arg rig :: rest)

lowerConArgsFuel : Int -> LwEnv -> LwSt -> List IrBinder -> List Bool -> List (Pair Term Rig) -> Check (Pair (List Ir) LwSt)
lowerConArgsFuel fuel env st binders opqs [] =
  if fuel <= 0 then icFuel "ir-lower" else OkC (Pair [] st)
lowerConArgsFuel fuel env st binders [] (_ :: _) =
  icInternal "constructor opaque flags shorter than runtime arguments"
lowerConArgsFuel fuel env st binders (opq :: opqs) ((Pair arg rig) :: rest) =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st binders arg) (
        \p =>
          case p of
            Pair ir st2 =>
              Vuna.Compiler.Base.Common.bind (lowerConArgsFuel (fuel - 1) env st2 binders opqs rest) (
                  \q =>
                    case q of
                      Pair irs st3 => OkC (Pair ((::) (ctorArgIr (annotTyOf env binders arg) opq ir) irs) st3)
                )
      )

-- 运行时不可命名的擦除依赖字段：表现层转换。
ctorArgIr : Maybe IrTy -> Bool -> Ir -> Ir
ctorArgIr src True ir = IrCast src (Just IrTyOpaque) ir
ctorArgIr src False ir = ir

-- 只保留运行时字段位置的不透明标志。
ctorOpaqueKeptFlags : List Bool -> List Bool -> List Bool
ctorOpaqueKeptFlags [] _ = []
ctorOpaqueKeptFlags _ [] = []
ctorOpaqueKeptFlags (keep :: keeps) (opq :: opqs) =
  if keep then opq :: ctorOpaqueKeptFlags keeps opqs else ctorOpaqueKeptFlags keeps opqs

lowerConAppFuel : Int -> LwEnv -> LwSt -> List IrBinder -> String -> List (Pair Term Rig) -> Check (Pair Ir LwSt)
lowerConAppFuel fuel env st binders c args =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    case natChainValue (TCon c args) of
      Just n => OkC (Pair (IrInt n) st)
      Nothing => lowerConAppNonChainFuel (fuel - 1) env st binders c args

lowerConAppNonChainFuel : Int -> LwEnv -> LwSt -> List IrBinder -> String -> List (Pair Term Rig) -> Check (Pair Ir LwSt)
lowerConAppNonChainFuel fuel env st binders c args =
  if fuel <= 0 then
    icFuel "ir-lower"
  else if c == natZeroCtor then
    case alignCtorArgs c [] args of
      ErrC e => ErrC e
      OkC runtimeArgs =>
        case runtimeArgs of
          [] => OkC (Pair (IrInt 0) st)
          _ => icInternal "Nat Zero applied to arguments"
  else if c == natSuccCtor then
    case alignCtorArgs c [True] args of
      ErrC e => ErrC e
      OkC runtimeArgs =>
        Vuna.Compiler.Base.Common.bind (lowerConArgsFuel (fuel - 1) env st binders [False] runtimeArgs) (
            \p =>
              case p of
                Pair irs st2 =>
                  case irs of
                    ir :: rest =>
                      case rest of
                        [] => OkC (Pair (IrApp Nothing (IrRt irRtNatSucc) ir) st2)
                        _ => icInternal "Nat Succ must have exactly one runtime argument"
                    [] => icInternal "Nat Succ must have exactly one runtime argument"
          )
  else
    case HashMap.lookup c env.lwCtors of
      Nothing => icInternal "unknown constructor ${c}"
      Just (Pair family keepFlags) =>
        case HashMap.lookup c env.lwOpaques of
          Nothing => icInternal "no opaque shape for constructor ${c}"
          Just opqs =>
            Vuna.Compiler.Base.Common.bind (alignCtorArgs c keepFlags args) (
                \runtimeArgs =>
                  Vuna.Compiler.Base.Common.bind (lowerConArgsFuel (fuel - 1) env st binders (ctorOpaqueKeptFlags keepFlags opqs) runtimeArgs) (
                      \p =>
                        case p of
                          Pair irs st2 => lowerConAppFinish env st2 family c args irs
                    )
              )

-- 收尾：去装箱族只保留单字段（构造子不落 OCaml 变体）；record 族生成 `IrRecord`；
-- 其余生成 `IrCtor`。族名与字段名都是源码名（文本前缀属后端）。
lowerConAppFinish : LwEnv -> LwSt -> String -> String -> List (Pair Term Rig) -> List Ir -> Check (Pair Ir LwSt)
lowerConAppFinish env st family c args irs =
  case HashMap.lookup family env.lwRecordFields of
    Just fields =>
      let
        recTy =
          case ctorTypeArgsOf env c args of
            Just tys => Just (IrTyData family tys)
            Nothing => Nothing
      in Vuna.Compiler.Base.Common.bind
        (zipFieldNames fields irs)
        (\pairs => OkC (Pair (IrRecord family recTy pairs) st))
    Nothing => OkC (Pair (IrCtor family c (ctorTypeArgsOf env c args) irs) st)

-- record 构造：运行时节数（与降级后的实参逐位对齐）→ 字段表给出字段源码名。
-- 两张表都由 `ctorKeepFlags` 驱动，长度不等是内部对齐 bug，不能静默截断。
zipFieldNames : List (Pair Int String) -> List Ir -> Check (List (Pair String Ir))
zipFieldNames [] [] = OkC []
zipFieldNames [] (_ :: _) =
  icInternal "record construction has more runtime arguments than its runtime field table"
zipFieldNames (_ :: _) [] =
  icInternal "record construction has fewer runtime arguments than its runtime field table"
zipFieldNames (f :: fs) (ir :: irs) =
  Vuna.Compiler.Base.Common.bind
    (zipFieldNames fs irs)
    (\rest => OkC (Pair (secondOf f) ir :: rest))

-- ---------------------------------------------------------------
-- case / 分支 binder
-- ---------------------------------------------------------------
-- binder 环境：全部 telescope binder 都进栈（擦除的用擦除占位），顺序为 telescope
-- 表面顺序的逆序；fresh 编号只给非擦除 binder。
record AltEnvIn where
  aeEnv : List IrBinder
  aePats : List IrBinder
  aeSt : LwSt

aeEnvOf : AltEnvIn -> List IrBinder
aeEnvOf (AltEnvIn e p s) = e

aePatsOf : AltEnvIn -> List IrBinder
aePatsOf (AltEnvIn e p s) = p

aeStOf : AltEnvIn -> LwSt
aeStOf (AltEnvIn e p s) = s

countKept : List Bool -> Int
countKept [] = 0
countKept (k :: rest) = if k then 1 + countKept rest else countKept rest

altEnvGo : LwSt -> List IrBinder -> List (Pair String Rig) -> List IrBinder -> AltEnvIn
altEnvGo st env [] pats = AltEnvIn env (reverse pats) st
altEnvGo st env ((Pair name rig) :: rest) pats =
  if rigIsErased rig then
    altEnvGo st (mkIrBinderErased :: env) rest pats
  else
    let
      fresh = st.lwNext
      b = mkIrBinderArm fresh
    in altEnvGo (LwSt (fresh + 1)) (b :: env) rest (b :: pats)

altEnvIn : LwSt -> List IrBinder -> List (Pair String Rig) -> AltEnvIn
altEnvIn st outer tele = altEnvGo st outer tele []

-- 构造子分支：按 keep flags 决定哪些 telescope 位置进 pattern；两种约定（全 telescope /
-- 仅保留字段）按 binders 长度选择，并逐位校验 rig。
altEnvCheckedIn : LwSt -> String -> List IrBinder -> List (Pair String Rig) -> List Bool -> Check AltEnvIn
altEnvCheckedIn st label outer binders flags =
  if listLength binders == listLength flags then
    altEnvFullIn st label outer binders flags []
  else if listLength binders == countKept flags then
    altEnvKeptIn st label outer binders []
  else
    icInternal
      "constructor ${label}: case branch binder count matches neither full telescope nor kept fields"

altEnvFullIn : LwSt -> String -> List IrBinder -> List (Pair String Rig) -> List Bool -> List IrBinder -> Check AltEnvIn
altEnvFullIn st label outer [] flags pats =
  case flags of
    [] => OkC (AltEnvIn outer (reverse pats) st)
    _ :: _ => icInternal "constructor ${label}: case branch has fewer binders than its shape"
altEnvFullIn st label outer ((Pair name rig) :: rest) flags pats =
  case flags of
    [] => icInternal "constructor ${label}: case branch has more binders than its shape"
    keep :: flags2 =>
      if flagMatchesRigIn keep rig then
        if keep then
          let
            fresh = st.lwNext
            b = mkIrBinderArm fresh
          in altEnvFullIn (LwSt (fresh + 1)) label (b :: outer) rest flags2 (b :: pats)
        else
          altEnvFullIn st label (mkIrBinderErased :: outer) rest flags2 pats
      else
        icInternal "constructor ${label}: case branch binder rig disagrees with its shape"

altEnvKeptIn : LwSt -> String -> List IrBinder -> List (Pair String Rig) -> List IrBinder -> Check AltEnvIn
altEnvKeptIn st label outer [] pats = OkC (AltEnvIn outer (reverse pats) st)
altEnvKeptIn st label outer ((Pair name rig) :: rest) pats =
  if rigIsErased rig then
    icInternal "constructor ${label}: kept-field branch has an erased binder"
  else
    let
      fresh = st.lwNext
      b = mkIrBinderArm fresh
    in altEnvKeptIn (LwSt (fresh + 1)) label (b :: outer) rest (b :: pats)

-- 分支 binder 的运行时类型：按构造子字段类型实例化族参数槽；catch-all 用 scrutinee 类型。
binderWithTy : Maybe IrTy -> IrBinder -> IrBinder
binderWithTy ty b = IrBinder b.irBinderName b.irBinderErased ty

typedPats : List IrTy -> List IrBinder -> List IrBinder
typedPats [] bs = bs
typedPats _ [] = []
typedPats (t :: ts) (b :: rest) = binderWithTy (Just t) b :: typedPats ts rest

typedPatsAll : Maybe IrTy -> List IrBinder -> List IrBinder
typedPatsAll ty bs = map (\b => binderWithTy ty b) bs

-- 把 pattern 上的类型回填到 binder 环境：分支体里的 `IrVar` 因此也带运行时类型
-- （分支体 lower 时用的是 env 里的 binder 对象，与 pattern 是同一批名字）。
armTyTblOf : List IrBinder -> List (Pair Int IrTy)
armTyTblOf [] = []
armTyTblOf (b :: rest) =
  let
    tail = armTyTblOf rest
  in case b.irBinderName of
    IrBArm n =>
      case b.irBinderTy of
        Just ty => Pair n ty :: tail
        Nothing => tail
    _ => tail

retagArmBinder : List (Pair Int IrTy) -> IrBinder -> IrBinder
retagArmBinder tbl b =
  case b.irBinderName of
    IrBArm n =>
      case lookupArmTy n tbl of
        Just ty => binderWithTy (Just ty) b
        Nothing => b
    _ => b

lookupArmTy : Int -> List (Pair Int IrTy) -> Maybe IrTy
lookupArmTy n [] = Nothing
lookupArmTy n ((Pair k ty) :: rest) = if k == n then Just ty else lookupArmTy n rest

retagArmEnv : List (Pair Int IrTy) -> List IrBinder -> List IrBinder
retagArmEnv tbl [] = []
retagArmEnv tbl (b :: rest) = retagArmBinder tbl b :: retagArmEnv tbl rest

retagAltEnv : AltEnvIn -> List IrBinder -> AltEnvIn
retagAltEnv (AltEnvIn e _ s) typed = AltEnvIn (retagArmEnv (armTyTblOf typed) e) typed s

-- 分支体：把分支 binder 栈接在外层上面后 lower。
lowerArmBodyFuel : Int -> LwEnv -> AltEnvIn -> Term -> Check (Pair Ir LwSt)
lowerArmBodyFuel fuel env bound body = lowerTermFuel fuel env (aeStOf bound) (aeEnvOf bound) body

hasFallbackAlt : List CaseAlt -> Bool
hasFallbackAlt [] = False
hasFallbackAlt (alt :: rest) = caseAltName alt == "" || hasFallbackAlt rest

allCatchAll : List CaseAlt -> Bool
allCatchAll [] = True
allCatchAll (alt :: rest) = if caseAltName alt == "" then allCatchAll rest else False

-- 去装箱 case 降级成 `let`：单构造子 + 单运行时字段，其余分支必须全是 catch-all。
lowerUnboxedCaseAlt : LwEnv -> List CaseAlt -> Maybe CaseAlt
lowerUnboxedCaseAlt env [] = Nothing
lowerUnboxedCaseAlt env (alt :: rest) =
  case caseAltName alt of
    "" => Nothing
    name =>
      case HashMap.lookup name env.lwCtors of
        Just (Pair family keepFlags) =>
          if HashMap.member family env.lwUnboxed then
            if allCatchAll rest then Just alt else Nothing
          else
            Nothing
        Nothing => Nothing

lowerUnboxedCaseFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> CaseAlt -> Check (Pair Ir LwSt)
lowerUnboxedCaseFuel fuel env st outer scrut alt =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    case caseAltName alt of
      "" => icInternal "unboxed case arm has no constructor"
      name =>
        case HashMap.lookup name env.lwCtors of
          Nothing => icInternal "no shape for constructor ${name}"
          Just (Pair family keepFlags) =>
            Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st outer scrut) (
                \p =>
                  case p of
                    Pair scrutIr st1 =>
                      Vuna.Compiler.Base.Common.bind (altEnvCheckedIn st1 name outer (binderPairs (caseAltBinders alt)) keepFlags) (
                          \bound =>
                            Vuna.Compiler.Base.Common.bind (ctorKeptFieldTys env name) (
                                \fieldTys =>
                                  let
                                    argTys = map (irTySubstVars (irTyDataArgsOf (annotTyOf env outer scrut))) fieldTys
                                    typed = typedPats argTys (aePatsOf bound)
                                    bound2 = retagAltEnv bound typed
                                  in Vuna.Compiler.Base.Common.bind (lowerArmBodyFuel (fuel - 1) env bound2 (caseAltBody alt)) (
                                      \q =>
                                        case q of
                                          Pair bodyIr st2 => OkC (Pair (IrLet typed scrutIr bodyIr) st2)
                                    )
                              )
                        )
              )

-- 分支体的结果类型：先读已降低节点的类型槽（嵌套 case / app / record 自带类型），
-- 缺失时再回退到 Core 类型注解。
armResultTyOf : LwEnv -> AltEnvIn -> Ir -> Term -> Maybe IrTy
armResultTyOf env bound bodyIr coreBody =
  case irResultTyOf bodyIr of
    Just ty => Just ty
    Nothing =>
      case bodyIr of
        IrGlobal g =>
          case annotGlobalTy env (aeEnvOf bound) g of
            Just ty => Just ty
            Nothing => annotTyOf env (aeEnvOf bound) coreBody
        _ => annotTyOf env (aeEnvOf bound) coreBody

-- 每个分支：catch-all → pattern 只有非擦除 binder；构造子 → 按形状绑定。
lowerArmFuel : Int -> LwEnv -> Maybe IrTy -> LwSt -> List IrBinder -> CaseAlt -> Check (Pair IrAlt (Pair (Maybe IrTy) LwSt))
lowerArmFuel fuel env scrutTy st outer alt =
  if fuel <= 0 then
    icFuel "ir-lower"
  else if caseAltName alt == "" then
    let
      bound = altEnvIn st outer (binderPairs (caseAltBinders alt))
      typed = typedPatsAll scrutTy (aePatsOf bound)
      bound2 = retagAltEnv bound typed
    in Vuna.Compiler.Base.Common.bind (lowerArmBodyFuel (fuel - 1) env bound2 (caseAltBody alt)) (
        \p =>
          case p of
            Pair bodyIr st2 => OkC (Pair (IrAlt Nothing typed bodyIr) (Pair (armResultTyOf env bound2 bodyIr (caseAltBody alt)) st2))
      )
  else
    case HashMap.lookup (caseAltName alt) env.lwCtors of
      Nothing => icInternal "unknown constructor ${caseAltName alt}"
      Just (Pair family keepFlags) =>
        Vuna.Compiler.Base.Common.bind (altEnvCheckedIn st (caseAltName alt) outer (binderPairs (caseAltBinders alt)) keepFlags) (
            \bound =>
              Vuna.Compiler.Base.Common.bind (ctorKeptFieldTys env (caseAltName alt)) (
                  \fieldTys =>
                    let
                      argTys = map (irTySubstVars (irTyDataArgsOf scrutTy)) fieldTys
                      typed = typedPats argTys (aePatsOf bound)
                      bound2 = retagAltEnv bound typed
                    in Vuna.Compiler.Base.Common.bind (lowerArmBodyFuel (fuel - 1) env bound2 (caseAltBody alt)) (
                        \p =>
                          case p of
                            Pair bodyIr st2 => OkC (Pair (IrAlt (Just (Pair family (caseAltName alt))) typed bodyIr) (Pair (armResultTyOf env bound2 bodyIr (caseAltBody alt)) st2))
                      )
                )
          )

lowerArmsFuel : Int -> LwEnv -> Maybe IrTy -> LwSt -> List IrBinder -> List CaseAlt -> Check (Pair (List IrAlt) (Pair (Maybe IrTy) LwSt))
lowerArmsFuel fuel env scrutTy st outer [] =
  if fuel <= 0 then icFuel "ir-lower" else OkC (Pair [] (Pair Nothing st))
lowerArmsFuel fuel env scrutTy st outer (alt :: rest) =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    Vuna.Compiler.Base.Common.bind (lowerArmFuel (fuel - 1) env scrutTy st outer alt) (
        \p =>
          case p of
            Pair arm (Pair bodyTy st2) =>
              Vuna.Compiler.Base.Common.bind (lowerArmsFuel (fuel - 1) env scrutTy st2 outer rest) (
                  \q =>
                    case q of
                      Pair arms (Pair restTy st3) =>
                        let
                          resultTy =
                            case bodyTy of
                              Just _ => bodyTy
                              Nothing => restTy
                        in OkC (Pair ((::) arm arms) (Pair resultTy st3))
                )
      )

-- ---------------------------------------------------------------
-- Nat case 降级（运行时是 int）
-- ---------------------------------------------------------------
isNatCtorName : String -> Bool
isNatCtorName name = name == natZeroCtor || name == natSuccCtor

natCaseApplies : List CaseAlt -> Bool
natCaseApplies [] = False
natCaseApplies alts = natCaseAllCtors alts && natCaseHasCtor alts

natCaseAllCtors : List CaseAlt -> Bool
natCaseAllCtors [] = True
natCaseAllCtors (alt :: rest) =
  case caseAltName alt of
    "" => natCaseAllCtors rest
    name => isNatCtorName name && natCaseAllCtors rest

natCaseHasCtor : List CaseAlt -> Bool
natCaseHasCtor [] = False
natCaseHasCtor (alt :: rest) =
  case caseAltName alt of
    "" => natCaseHasCtor rest
    _ => True

findAltBy : String -> List CaseAlt -> Maybe CaseAlt
findAltBy name [] = Nothing
findAltBy name (alt :: rest) = if caseAltName alt == name then Just alt else findAltBy name rest

findCatchAllAlt : List CaseAlt -> Maybe CaseAlt
findCatchAllAlt [] = Nothing
findCatchAllAlt (alt :: rest) = if caseAltName alt == "" then Just alt else findCatchAllAlt rest

-- Nat 分支：Zero 无 binder；Succ 的唯一 binder 绑定到 `sc - 1`；兜底绑到 `sc`。
lowerNatAltFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Maybe CaseAlt -> Check (Pair (Maybe IrAlt) LwSt)
lowerNatAltFuel fuel env st outer Nothing = OkC (Pair Nothing st)
lowerNatAltFuel fuel env st outer (Just alt) =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    let
      bound = altEnvIn st outer (binderPairs (caseAltBinders alt))
      typed = typedPatsAll (Just IrTyInt) (aePatsOf bound)
      bound2 = retagAltEnv bound typed
    in Vuna.Compiler.Base.Common.bind (lowerArmBodyFuel (fuel - 1) env bound2 (caseAltBody alt)) (
        \p =>
          case p of
            Pair bodyIr st2 => OkC (Pair (Just (IrAlt Nothing typed bodyIr)) st2)
      )

lowerNatCaseFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> List CaseAlt -> Check (Pair Ir LwSt)
lowerNatCaseFuel fuel env st outer scrut alts =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st outer scrut) (
        \p =>
          case p of
            Pair scrutIr st1 =>
              let
                fresh = st1.lwNext
                st2 = LwSt (fresh + 1)
                zeroAlt = findAltBy natZeroCtor alts
                succAlt = findAltBy natSuccCtor alts
                catchAlt = findCatchAllAlt alts
              in Vuna.Compiler.Base.Common.bind (lowerNatAltFuel (fuel - 1) env st2 outer zeroAlt) (
                  \pz =>
                    case pz of
                      Pair zeroIr st3 =>
                        Vuna.Compiler.Base.Common.bind (lowerNatAltFuel (fuel - 1) env st3 outer succAlt) (
                            \ps =>
                              case ps of
                                Pair succIr st4 =>
                                  Vuna.Compiler.Base.Common.bind (lowerNatAltFuel (fuel - 1) env st4 outer catchAlt) (
                                      \pc =>
                                        case pc of
                                          Pair catchIr st5 => OkC (Pair (IrNatCase scrutIr fresh zeroIr succIr catchIr) st5)
                                    )
                          )
                )
      )

-- ---------------------------------------------------------------
-- 通用 case
-- ---------------------------------------------------------------
lowerCaseFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> List CaseAlt -> Check (Pair Ir LwSt)
lowerCaseFuel fuel env st outer scrut alts =
  if fuel <= 0 then
    icFuel "ir-lower"
  else if natCaseApplies alts then
    lowerNatCaseFuel (fuel - 1) env st outer scrut alts
  else
    Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st outer scrut) (
        \p =>
          case p of
            Pair scrutIr st1 =>
              let
                scrutTy = annotTyOf env outer scrut
              in Vuna.Compiler.Base.Common.bind (lowerArmsFuel (fuel - 1) env scrutTy st1 outer alts) (
                  \q =>
                    case q of
                      Pair arms (Pair resultTy st2) => OkC (Pair (IrCase scrutTy resultTy scrutIr arms) st2)
                )
      )

-- 非 record 族的投影按 `case` 形状展开（产物形状逐字节确定）。
lowerProjAsCaseFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> String -> List (Pair String Rig) -> Int -> Int -> Check (Pair Ir LwSt)
lowerProjAsCaseFuel fuel env st outer base c tele i fi =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    let
      n = listLength tele
    in lowerTermFuel (fuel - 1) env st outer (TCase base [CaseAlt c (bindersOfPairs (projBindersIn tele 0)) (TVar (recordProjVarIn fi) (n - 1 - fi) (Span "" 0 0 0 0 0 0))])

recordProjVarIn : Int -> String
recordProjVarIn i = "@vuna@record@proj${i}"

projBindersIn : List (Pair String Rig) -> Int -> List (Pair String Rig)
projBindersIn [] i = []
projBindersIn (b :: rest) i = Pair (recordProjVarIn i) (secondOf b) :: projBindersIn rest (i + 1)

-- ---------------------------------------------------------------
-- record 更新
-- ---------------------------------------------------------------
lookupRtLabelIn : Int -> List (Pair Int String) -> Maybe String
lookupRtLabelIn fi [] = Nothing
lookupRtLabelIn fi ((Pair i label) :: rest) =
  if i == fi then Just label else lookupRtLabelIn fi rest

lookupRtPosIn : Int -> List (Pair Int String) -> Int -> Maybe Int
lookupRtPosIn fi [] n = Nothing
lookupRtPosIn fi ((Pair i label) :: rest) n =
  if i == fi then Just n else lookupRtPosIn fi rest (n + 1)

lookupRtPositionsIn : List (Pair Int String) -> List Int -> Check (List (Pair Int Int))
lookupRtPositionsIn fields [] = OkC []
lookupRtPositionsIn fields (i :: rest) =
  case lookupRtPosIn i fields 0 of
    Just pos =>
      Vuna.Compiler.Base.Common.bind
        (lookupRtPositionsIn fields rest)
        (\ps => OkC (Pair i pos :: ps))
    Nothing =>
      icInternal "record update targets field index ${strFromInt i}, which has no runtime field"

nthOpqArgIn : Int -> List Bool -> List (Pair Term Rig) -> Maybe Term
nthOpqArgIn n [] args = Nothing
nthOpqArgIn n (opq :: opqs) [] = Nothing
nthOpqArgIn n (opq :: opqs) ((Pair a rig) :: rest) =
  if n <= 0 then Just a else nthOpqArgIn (n - 1) opqs rest

-- 把 record 字段 binder 补进 binder 栈（被改值在 alt 上下文里精化，其 de Bruijn
-- index 含这些槽位；这些字段 binder 不生成，故标成擦除占位）。
recordAltBindersIn : List (Pair String Rig) -> List IrBinder -> List IrBinder
recordAltBindersIn tele binders = append (reverse (map eraseTele tele)) binders

eraseTele : Pair String Rig -> IrBinder
eraseTele b = mkIrBinderErased

lowerRecordUpdateFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Term -> String -> List (Pair String Rig) -> List (Pair Int String) -> List Int -> Term -> Check (Pair Ir LwSt)
lowerRecordUpdateFuel fuel env st outer base c tele fields idxs body =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st outer base) (
        \p =>
          case p of
            Pair baseIr st1 =>
              let
                baseTy = annotTyOf env outer base
              in case body of
                TMk c2 args => lowerRecordUpdateArgsFuel (fuel - 1) env st1 (recordAltBindersIn tele outer) baseIr baseTy c fields idxs args
                TCon c2 args => lowerRecordUpdateArgsFuel (fuel - 1) env st1 (recordAltBindersIn tele outer) baseIr baseTy c fields idxs args
                _ => icInternal "record update body is not a constructor application"
      )

lowerRecordUpdateArgsFuel : Int -> LwEnv -> LwSt -> List IrBinder -> Ir -> Maybe IrTy -> String -> List (Pair Int String) -> List Int -> List (Pair Term Rig) -> Check (Pair Ir LwSt)
lowerRecordUpdateArgsFuel fuel env st binders baseIr baseTy c fields idxs args =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    case HashMap.lookup c env.lwCtors of
      Nothing => icInternal "no shape for constructor ${c}"
      Just (Pair family keepFlags) =>
        case HashMap.lookup c env.lwOpaques of
          Nothing => icInternal "no opaque shape for constructor ${c}"
          Just opqs =>
            Vuna.Compiler.Base.Common.bind (alignCtorArgs c keepFlags args) (
                \runtimeArgs =>
                  Vuna.Compiler.Base.Common.bind (lookupRtPositionsIn fields idxs) (
                      \positions =>
                        Vuna.Compiler.Base.Common.bind (lowerUpdFieldsFuel (fuel - 1) env st binders fields (ctorOpaqueKeptFlags keepFlags opqs) positions runtimeArgs) (
                            \q =>
                              case q of
                                Pair updates st2 => OkC (Pair (IrRecUpd baseIr c updates baseTy) st2)
                          )
                    )
              )

lowerUpdFieldsFuel : Int -> LwEnv -> LwSt -> List IrBinder -> List (Pair Int String) -> List Bool -> List (Pair Int Int) -> List (Pair Term Rig) -> Check (Pair (List (Pair String Ir)) LwSt)
lowerUpdFieldsFuel fuel env st binders fields opqs [] args =
  if fuel <= 0 then icFuel "ir-lower" else OkC (Pair [] st)
lowerUpdFieldsFuel fuel env st binders fields opqs (p :: rest) args =
  if fuel <= 0 then
    icFuel "ir-lower"
  else
    case nthOpqArgIn (secondOf p) opqs args of
      Nothing => icInternal "record update position out of range"
      Just arg =>
        Vuna.Compiler.Base.Common.bind (lowerTermFuel (fuel - 1) env st binders arg) (
            \q =>
              case q of
                Pair ir st2 =>
                  Vuna.Compiler.Base.Common.bind (lowerUpdFieldsFuel (fuel - 1) env st2 binders fields opqs rest args) (
                      \r =>
                        case r of
                          Pair updates st3 =>
                            case lookupRtLabelIn (firstOf p) fields of
                              Just label => OkC (Pair (Pair label ir :: updates) st3)
                              Nothing => icInternal "record update position has no runtime field"
                    )
          )

-- ---------------------------------------------------------------
-- 定义、分组、入口
-- ---------------------------------------------------------------
-- 运行时参数个数：擦除 lambda 不计入。
runtimeArityIn : Term -> Int
runtimeArityIn (TLam n r _ _ b) = if rigIsErased r then runtimeArityIn b else 1 + runtimeArityIn b
runtimeArityIn _ = 0

-- `let rec` 右值形状护栏。
recursiveValueAllowedIn : Term -> Bool
recursiveValueAllowedIn (TLam n rig _ _ b) =
  if rigIsErased rig then recursiveValueAllowedIn b else True
recursiveValueAllowedIn (TCon c args) = True
recursiveValueAllowedIn _ = False

-- 入口单元零参 `main`：模块初始化期求值，要套运行时报告器。
initGuardOf : LwEnv -> Bool -> String -> Term -> Bool
initGuardOf env True name body = False
initGuardOf env False name body =
  if env.lwUnit == "Main" && name == "main" && runtimeArityIn body == 0 then True else False

-- 单个运行时定义 → `IrDef`（extern 走 `IrExternDef`）。
--
-- fresh binder 编号是**单元内**全局递增的（整单元生成期累积，跨组也不重置），
-- 所以 `LwSt` 必须跨定义顺序传递。
lowerDef : LwEnv -> LwSt -> DtDef -> Check (Pair IrDef LwSt)
lowerDef env st d =
  case dtDefExtern d of
    Just cName =>
      case lowerExternTy (dtDefType d) of
        ErrC e => ErrC (withContext (dtDefSpan d) (dtDefName d) e)
        OkC ty => OkC (Pair (IrExternDef (dtDefName d) ty cName (dtDefSpan d)) st)
    Nothing =>
      case dtDefBody d of
        Just body =>
          let
            defTy = Just (renderPiTy [] env.lwTyParams env.lwDatas 0 (eval [] (dtDefType d)))
          in case lowerDefBodyTerm env st body defTy of
            ErrC e => ErrC (withContext (dtDefSpan d) (dtDefName d) e)
            OkC (Pair bodyIr st2) =>
              OkC
                (Pair (IrDef (dtDefName d) (runtimeArityIn body) (factsDepsOf env (dtDefName d)) defTy bodyIr (recursiveValueAllowedIn body) (initGuardOf env False (dtDefName d) body) (dtDefSpan d)) st2)
        Nothing =>
          ErrC
            (withContext (dtDefSpan d) (dtDefName d) (diagNoLoc SevError PhInternal CatInternal "IC_AxiomRuntime" "axiom reached runtime code generation (partition must erase it)"))

-- extern 类型 → `IrTy`（判据：Int/String/Bool/Array 基本类型，
-- 显式 Pi 链；隐式参数与非基本类型是内部错）。
lowerExternTy : Term -> Check IrTy
lowerExternTy ty = externTyIr 64 0 (eval [] ty)

externTyIr : Int -> Int -> Value -> Check IrTy
externTyIr fuel lvl (VPi name implicit _ dom clo) =
  if fuel <= 0 then
    icInternal "extern type is too deep"
  else if implicit then
    icInternal "extern has an implicit parameter"
  else
    Vuna.Compiler.Base.Common.bind
      (externDomIr dom)
      (\domIr => Vuna.Compiler.Base.Common.bind (externTyIr (fuel - 1) (lvl + 1) (applyClosure clo (VNeutral (NVar name lvl [])))) (\resIr => OkC (IrTyFun domIr resIr)))
externTyIr fuel lvl v = if fuel <= 0 then icInternal "extern type is too deep" else externDomIr v

externDomIr : Value -> Check IrTy
externDomIr (VNeutral (NGlobal "Array" ([elem]))) =
  Vuna.Compiler.Base.Common.bind (externBasicIr elem) (\e => OkC (IrTyArray e))
externDomIr (VNeutral (NGlobal "Array" _)) = icInternal "extern Array needs one type argument"
externDomIr v = externBasicIr v

externBasicIr : Value -> Check IrTy
externBasicIr (VNeutral (NGlobal g args)) =
  if isFfiScalarName g then
    case reprTyIr g of
      Just t => OkC t
      Nothing => icInternal "extern type has no runtime representation: ${g}"
  else
    icInternal "extern type is not basic: ${g}"
externBasicIr (VNeutral _) = icInternal "extern type is not a global type"
externBasicIr _ = icInternal "extern type is not basic"

lowerDefs : LwEnv -> LwSt -> List DtDef -> Check (Pair (List IrDef) LwSt)
lowerDefs env st [] = OkC (Pair [] st)
lowerDefs env st (d :: rest) =
  Vuna.Compiler.Base.Common.bind (lowerDef env st d) (
      \p =>
        case p of
          Pair ir st2 =>
            Vuna.Compiler.Base.Common.bind (lowerDefs env st2 rest) (
                \q =>
                  case q of
                    Pair tail st3 => OkC (Pair ((::) ir tail) st3)
              )
    )

-- ---------------------------------------------------------------
-- 单元 lowering
-- ---------------------------------------------------------------
-- OCaml 名字单射性护栏：名字只编码本地段，所以**同一模块前缀**（= 同一单元）内必须
-- 唯一；跨单元由 `Unit.` 限定区分，不在此约束。三族前缀 v_/t_/C_ 互不相同，只需族内校验。
nameKey : String -> String -> Pair String String
nameKey raw encoded = Pair (Source.prefixOfName raw) encoded

checkNoDupOcamlNames : String -> List (Pair String String) -> Check Int
checkNoDupOcamlNames kind keys = checkNoDupOcamlNamesGo kind keys (HashMap.fromList [])

checkNoDupOcamlNamesGo : String -> List (Pair String String) -> HashMap String Bool -> Check Int
checkNoDupOcamlNamesGo kind [] seen = OkC 0
checkNoDupOcamlNamesGo kind ((Pair owner encoded) :: rest) seen =
  let
    key = "${owner}\t${encoded}"
  in if HashMap.member key seen then
    icInternal "OCaml name collision among ${kind}s in module `${owner}`: `${encoded}`"
  else
    checkNoDupOcamlNamesGo kind rest (HashMap.insert key True seen)

ensureUniqueOcamlNamesIn : List DtData -> List DtDef -> Check Int
ensureUniqueOcamlNamesIn datas defs =
  let
    runtime = rtDatasOf datas
    unboxed = unboxedFamilySet runtime
    valueKeys = map (\d => nameKey (dtDefName d) (valueName (dtDefName d))) defs
    typeKeys = map (\d => nameKey (dtDataName d) (typeName (dtDataName d))) runtime
    ctorKeys =
      concatMap
        (\d => if memName (dtDataName d) unboxed then [] else map (\c => nameKey (dtCtorFamily c) (ctorOcamlName (dtCtorFamily c) (dtCtorName c))) (dtDataCtors d))
        runtime
  in Vuna.Compiler.Base.Common.bind
    (checkNoDupOcamlNames "value" valueKeys)
    (\_ => Vuna.Compiler.Base.Common.bind (checkNoDupOcamlNames "type" typeKeys) (\_ => checkNoDupOcamlNames "constructor" ctorKeys))

-- | 分区 + 护栏 + 擦除检查（顺序与诊断集合固定）。
-- 返回运行时定义（源码顺序）与「类型级 + 族名」名字集（擦除检查的输入）。
prepareProgram : List DtData -> List DtDef -> Check (List DtDef)
prepareProgram datas defs =
  let
    table = defTable defs
    familyNames = map dtDataName datas
    axiomNames = axiomNamesOf defs
  in case partitionDefs table defs of
    Pair runtime typeNames =>
      let
        -- 与数据族同名的**运行时值定义**（`data T` 与 `T : Int` 同名）在项里也
        -- 是 `TGlobal T`；这种名字属于值命名空间，不能按「类型级名字」拒绝。
        runtimeNames = map dtDefName runtime
        familyTypeNames = filter (\n => not (memName n runtimeNames)) familyNames
        allTypeNames = append typeNames familyTypeNames
      in Vuna.Compiler.Base.Common.bind
        (checkNoAxiomRuntime axiomNames runtime)
        (\_ => Vuna.Compiler.Base.Common.bind (checkAllDefScopes defs) (\_ => Vuna.Compiler.Base.Common.bind (ensureUniqueOcamlNamesIn datas runtime) (\_ => Vuna.Compiler.Base.Common.bind (checkAllErasure allTypeNames runtime) (\_ => OkC runtime))))

-- | 单元内运行时定义 → 分组（SCC 序）。
--
-- 分组必须在**生成体之前**算出来：fresh binder 编号是单元内全局递增的（跨组累积），
-- 所以「分组顺序」决定生成顺序。这里先用名字级分组（+ 递归组的
-- 右值形状护栏），再按分组顺序逐组生成 `IrDef`。
groupDefs : LwEnv -> List DtDef -> Check (List (Pair Bool (List IrDef)))
groupDefs env defs =
  let
    -- 依赖邻接表（运行时引用到的顶层名，遍历顺序即首现顺序）。
    adj = map (adjOfDef env) defs
    names = map dtDefName defs
    -- 递归右值判据与 span 只依赖**本单元**的 defs：一次建表，别让每个名字各扫一遍。
    tbl = defTblOf defs
  in Vuna.Compiler.Base.Common.bind
    (assembleGroupNames adj names (recOkOfTbl tbl) (spanOfTbl tbl))
    (
      \groups =>
        Vuna.Compiler.Base.Common.bind (appendGroups env (LwSt 0) groups) (
            \q =>
              case q of
                Pair grouped _ => OkC grouped
          )
    )

tblLookup : HashMap String DtDef -> String -> Maybe DtDef
tblLookup tbl name = HashMap.lookup name tbl

recOkOfTbl : HashMap String DtDef -> String -> Bool
recOkOfTbl tbl name =
  case tblLookup tbl name of
    Nothing => False
    Just d =>
      case dtDefBody d of
        Nothing => True
        Just body => recursiveValueAllowedIn body

spanOfTbl : HashMap String DtDef -> String -> Maybe Span
spanOfTbl tbl name =
  case tblLookup tbl name of
    Nothing => Nothing
    Just d => dtDefSpan d

appendGroups : LwEnv -> LwSt -> List (Pair Bool (List String)) -> Check (Pair (List (Pair Bool (List IrDef))) LwSt)
appendGroups env st [] = OkC (Pair [] st)
appendGroups env st (g :: rest) =
  let
    isRec = firstOf g
    members = secondOf g
    -- 组内成员是**源码序**（`assembleGroupNames` 保证），这里只按成员名查表取定义，
    -- 不再对 `env.lwDefs` 做线性过滤（单点 SCC 时那是 O(n²)）。
    defs = mapMaybeDef env.lwDefTbl members
  in Vuna.Compiler.Base.Common.bind (lowerDefs env st defs) (
      \p =>
        case p of
          Pair irDefs st2 =>
            Vuna.Compiler.Base.Common.bind (checkUniqueDefNames irDefs) (
                \_ =>
                  Vuna.Compiler.Base.Common.bind (appendGroups env st2 rest) (
                      \q =>
                        case q of
                          Pair tail st3 => OkC (Pair (Pair isRec irDefs :: tail) st3)
                    )
              )
    )

mapMaybeDef : HashMap String DtDef -> List String -> List DtDef
mapMaybeDef _ [] = []
mapMaybeDef tbl (n :: rest) =
  case tblLookup tbl n of
    Nothing => mapMaybeDef tbl rest
    Just d => (::) d (mapMaybeDef tbl rest)

-- | 程序级检查（擦除、axiom 运行时使用、作用域、OCaml 名字单射、SCC 递归值形状）。
--
-- 这一步按**整个程序**跑一次，然后每个单元只做分组与文本生成；诊断内容与先后顺序
-- 都必须稳定。
export checkProgramOf : LwEnv -> Check Int
checkProgramOf env =
  Vuna.Compiler.Base.Common.bind
    (prepareProgram env.lwDatas env.lwDefs)
    (\_ => checkRuntimeContract)

-- | 运行时契约一致性：`Intrinsics` ↔ `Ir.Runtime` ↔ OCaml 后端符号表。
--
-- 三处任何一处漂移都是编译器 bug（内部错），不是用户面诊断；用户面诊断码不变。
checkRuntimeContract : Check Int
checkRuntimeContract =
  let
    intrinsicNames = map intrinsicName allIntrinsics
    contractNames = irRtNames
    missingFromContract =
      filter
        (\n => if n == primEffBind1Name then False else if memName n contractNames then False else True)
        intrinsicNames
    extrasInContract =
      filter
        (\n => if memName n intrinsicNames then False else if memName n irRtSyntheticNames then False else True)
        contractNames
  in if listLength missingFromContract > 0 then
    icInternal "runtime contract misses intrinsic `${firstOfList missingFromContract}`"
  else if listLength extrasInContract > 0 then
    icInternal "runtime contract declares unknown symbol `${firstOfList extrasInContract}`"
  else if listLength rtTextGaps > 0 then
    icInternal "OCaml runtime table misses contract symbol `${firstOfList rtTextGaps}`"
  else if listLength rtTextExtras > 0 then
    icInternal "OCaml runtime table has symbol outside the contract: `${firstOfList rtTextExtras}`"
  else
    OkC 0

firstOfList : List String -> String
firstOfList [] = ""
firstOfList (x :: _) = x

-- | 单元 lowering：入参是本单元的定义名与数据族名（已按归属过滤，顺序=程序顺序）。
--
-- 全量检查 + lowering（单单元 / check 路径用）。
export lowerUnitOf : LwEnv -> List String -> List String -> Check IrUnit
lowerUnitOf env defNames dataNames =
  Vuna.Compiler.Base.Common.bind
    (checkProgramOf env)
    (\_ => lowerUnitAfterChecks env defNames dataNames)

-- | 降一个单元并自证 IR（split 路径用它：分组/符号校验与降级同一入口）。
export lowerUnitChecked : LwEnv -> List String -> List String -> Check IrUnit
lowerUnitChecked env defNames dataNames =
  Vuna.Compiler.Base.Common.bind
    (lowerUnitAfterChecks env defNames dataNames)
    (\u => Vuna.Compiler.Base.Common.bind (validateUnit (lwEnvShared env) u) (\_ => OkC u))

-- | 只做 lowering（程序级检查已由 `checkProgramOf` 跑过；split 路径每个单元用它）。
--
-- 分区只取本单元的运行时定义：类型级定义 / axiom 没有运行时表示，不进任何单元文件。
export lowerUnitAfterChecks : LwEnv -> List String -> List String -> Check IrUnit
lowerUnitAfterChecks env defNames dataNames =
  let
    datas = env.lwDatas
    -- 保留 `env.lwDefs` 的**程序顺序**（分区/分组都按它），只把「是否属于本单元」的
    -- 判定从线性 `memName` 换成一次建表（split 路径每单元一次，原来是 O(单元数×全程序)）。
    defNameTbl = HashMap.ofNames defNames
    defs = filter (\d => HashMap.member (dtDefName d) defNameTbl) env.lwDefs
    dataNameTbl = HashMap.ofNames dataNames
    unitDatas = filter (\d => HashMap.member (dtDataName d) dataNameTbl) datas
    runtime = partitionRuntimeDefs defs
  in Vuna.Compiler.Base.Common.bind (groupDefs env runtime) (
      \groups =>
        Vuna.Compiler.Base.Common.bind (tyDeclsOf env.lwTyParams env.lwUnboxedInfo datas unitDatas) (
            \decls =>
              let
                groups2 = map groupOfPair groups
                hasList = hasDataNamed listFamilyName unitDatas
              in OkC (dispatchIdsUnit (representUnit (lwEnvShared env) (IrUnit decls groups2 hasList (tyDeclRefs decls) Nothing)))
          )
    )

adjOfDef : LwEnv -> DtDef -> Pair String (List String)
adjOfDef env d = Pair (dtDefName d) (factsDepsOf env (dtDefName d))

groupOfPair : Pair Bool (List IrDef) -> IrGroup
groupOfPair (Pair isRec ds) = IrGroup isRec ds

-- | 整个程序当作一个单元 lowering（check 路径；文本丢弃）。
export lowerProgramOf : List DtData -> List DtDef -> List (Pair String Term) -> Check IrProgram
lowerProgramOf datas defs globals =
  Vuna.Compiler.Base.Common.bind
    (obsCheck "vuna.codegen.env" (\_ => OkC (mkLwEnv datas defs globals "")))
    (
      \env =>
        Vuna.Compiler.Base.Common.bind (obsCheck "vuna.codegen.prepare" (\_ => checkProgramOf env)) (
            \_ =>
              Vuna.Compiler.Base.Common.bind (obsCheck "vuna.codegen.unit" (\_ => lowerUnitAfterChecks env (map dtDefName defs) (map dtDataName datas))) (
                  \unitIr =>
                    Vuna.Compiler.Base.Common.bind (obsCheck "vuna.codegen.entry" (\_ => lowerEntryOf defs)) (
                        \entry =>
                          let
                            program = IrProgram (lwEnvShared env) (IrUnit unitIr.irUnitTyDecls unitIr.irUnitGroups unitIr.irUnitHasListFamily unitIr.irUnitTypeRefs entry)
                          in Vuna.Compiler.Base.Common.bind (validateProgram program) (\_ => OkC program)
                      )
                )
          )
    )

-- | 运行时定义分区（不跑检查；Split 的归属表与名字护栏只看运行时定义——axiom /
-- 类型级定义没有归属，也不进任何单元文件）。
export partitionRuntimeDefs : List DtDef -> List DtDef
partitionRuntimeDefs defs =
  case partitionDefs (defTable defs) defs of
    Pair runtime typeNames => runtime
