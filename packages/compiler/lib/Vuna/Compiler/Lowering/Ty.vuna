module Vuna.Compiler.Lowering.Ty where

-- Core → IR 的**类型表面**：类型参数槽渲染、`IrTy`、类型声明。纯函数（不进项）。
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Core.Canonical
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Representation
import Vuna.Compiler.Base.Intrinsics
import Vuna.Compiler.Ir.Model
import Vuna.Compiler.Ir.Analysis
import Vuna.Compiler.Ir.Runtime
import Vuna.Compiler.Lowering.Env

-- ---------------------------------------------------------------
-- 运行时类型渲染（Value → IrTy）
-- ---------------------------------------------------------------
--
-- `IrTy` 是签名级运行时类型。判据（哪些字段不透明、哪些族参数槽进声明）必须与
-- 构造子实参逐位对齐；文本渲染在后端。
renderTyOf : List Int -> HashMap String (List Int) -> List DtData -> Value -> IrTy
renderTyOf levels table datas v = renderTyFuel 256 levels table datas v

renderTyFuel : Int -> List Int -> HashMap String (List Int) -> List DtData -> Value -> IrTy
renderTyFuel fuel levels table datas v =
  if fuel <= 0 then
    IrTyOpaque
  else
    case v of
      VNeutral n =>
        case n of
          NVar name lvl sp =>
            case levelSlotIn levels lvl of
              Just s => IrTyVar s
              -- 命名不到的局部类型变量：不透明运行时值。
              Nothing => IrTyOpaque
          NGlobal g sp => renderTyGlobal fuel levels table datas g sp
      _ => IrTyOpaque

-- | primitive / canonical 族的 IR 运行时类型；`Nothing` = 普通 data（按声明渲染）。
export reprTyIr : String -> Maybe IrTy
reprTyIr name =
  if name == intTypeName then
    Just IrTyInt
  else if name == strTypeName then
    Just IrTyStr
  else if name == floatTypeName then
    Just IrTyFloat
  else
    case canonicalReprOf name of
      Just FamReprNat => Just IrTyInt
      Just FamReprBool => Just IrTyBool
      _ => Nothing

renderTyGlobal : Int -> List Int -> HashMap String (List Int) -> List DtData -> String -> List Value -> IrTy
renderTyGlobal fuel levels table datas g sp =
  case renderTyIntrinsic g (map (\x => renderTyFuel (fuel - 1) levels table datas x) sp) of
    Just t => t
    Nothing =>
      case reprTyIr g of
        Just t => t
        Nothing =>
          case findDtData g datas of
            Just gd =>
              IrTyData
                g
                (renderFamilyArgs (fuel - 1) levels table datas (lookupTyParamsIn table g) sp)
            Nothing => IrTyOpaque

renderTyIntrinsic : String -> List IrTy -> Maybe IrTy
renderTyIntrinsic "Array" ([a]) = Just (IrTyArray a)
renderTyIntrinsic "IORef" ([a]) = Just (IrTyRef a)
renderTyIntrinsic _ _ = Nothing

renderFamilyArgs : Int -> List Int -> HashMap String (List Int) -> List DtData -> List Int -> List Value -> List IrTy
renderFamilyArgs fuel levels table datas usedPats args =
  if fuel <= 0 then
    []
  else
    case usedPats of
      [] => []
      i :: rest =>
        case nthValueIn args i of
          Just arg => renderTyFuel (fuel - 1) levels table datas arg :: renderFamilyArgs (fuel - 1) levels table datas rest args
          -- 高阶/部分应用：族头出现时实参可能少于运行时参数槽（例如
          -- `Dict_Functor Maybe` 里的 `Maybe`）。保留槽位，用不透明值占位，
          -- 保证 `IrTyData` 的 arity 与声明一致。
          Nothing => IrTyOpaque :: renderFamilyArgs (fuel - 1) levels table datas rest args

-- 显式 Pi 结构化渲染（`(Int -> a)` 这类）；带隐式量词的 Pi 整体不透明。
export renderPiTy : List Int -> HashMap String (List Int) -> List DtData -> Int -> Value -> IrTy
renderPiTy levels table datas lvl v = renderPiTyFuel 256 levels table datas lvl v

renderPiTyFuel : Int -> List Int -> HashMap String (List Int) -> List DtData -> Int -> Value -> IrTy
renderPiTyFuel fuel levels table datas lvl v =
  if fuel <= 0 then
    renderTyFuel fuel levels table datas v
  else
    case v of
      VPi name implicit rig dom clo =>
        let
          next = applyClosure clo (VNeutral (NVar name lvl []))
        in if rigIsErased rig then renderPiTyFuel (fuel - 1) levels table datas (lvl + 1) next else IrTyFun (renderPiTyFuel (fuel - 1) levels table datas lvl dom) (renderPiTyFuel (fuel - 1) levels table datas (lvl + 1) next)
      _ => renderTyFuel fuel levels table datas v

-- 单个字段的运行时类型 + 下一个不透明参数槽。
renderFieldTy : List Int -> HashMap String (List Int) -> List DtData -> Int -> Value -> Int -> Pair IrTy Int
renderFieldTy levels table datas lvl (dom@(VPi name implicit rig d clo)) slot =
  if implicit then
    Pair (IrTyVar slot) (slot + 1)
  else
    Pair (renderPiTy levels table datas lvl dom) slot
renderFieldTy levels table datas lvl (VNeutral n) slot =
  case n of
    NVar name lvl2 sp =>
      case levelSlotIn levels lvl2 of
        Just s => Pair (IrTyVar s) slot
        Nothing => Pair (IrTyVar slot) (slot + 1)
    NGlobal g sp =>
      case renderTyIntrinsic g (map (\x => renderTyFuel 256 levels table datas x) sp) of
        Just t => Pair t slot
        Nothing =>
          case reprTyIr g of
            Just t => Pair t slot
            Nothing =>
              case findDtData g datas of
                Just gd =>
                  Pair
                    (IrTyData g (renderFamilyArgs 256 levels table datas (lookupTyParamsIn table g) sp))
                    slot
                Nothing => Pair (IrTyVar slot) (slot + 1)
renderFieldTy levels table datas lvl _ slot = Pair (IrTyVar slot) (slot + 1)

export flagMatchesRigIn : Bool -> Rig -> Bool
flagMatchesRigIn True rig = not (rigIsErased rig)
flagMatchesRigIn False rig = rigIsErased rig

-- 构造子字段的运行时类型表（唯一真源：keep flags + 不透明 flags 与 telescope 逐位对齐）。
ctorFieldTys : List Int -> HashMap String (List Int) -> List DtData -> List Bool -> List Bool -> List (Pair String Rig) -> Int -> Value -> Int -> Check (Pair (List IrTy) Int)
ctorFieldTys levels table datas keepFlags opaqueFlags [] lvl v slot = OkC (Pair [] slot)
ctorFieldTys levels table datas [] (_ :: _) tele lvl v slot =
  icInternal "constructor opaque flags longer than its shape"
ctorFieldTys levels table datas [] [] (_ :: _) lvl v slot =
  icInternal "constructor shape has more binders than its telescope"
ctorFieldTys levels table datas (_ :: _) [] (_ :: _) lvl v slot =
  icInternal "constructor opaque flags shorter than its shape"
ctorFieldTys levels table datas (keep :: flags) (opq :: opqs) ((Pair name rig) :: rest) lvl v slot =
  if flagMatchesRigIn keep rig then
    case v of
      VPi pname implicit _ dom clo =>
        let
          next = applyClosure clo (VNeutral (NVar pname lvl []))
        in if keep then
          if opq then
            Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table datas flags opqs rest (lvl + 1) next slot) (
                \p =>
                  case p of
                    -- 不透明字段：整个字段渲染成不命名的运行时值；不消耗类型参数槽。
                    Pair tys slot3 => OkC (Pair (IrTyOpaque :: tys) slot3)
              )
          else
            case renderFieldTy levels table datas lvl dom slot of
              Pair text slot2 =>
                Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table datas flags opqs rest (lvl + 1) next slot2) (
                    \p =>
                      case p of
                        Pair tys slot3 => OkC (Pair (text :: tys) slot3)
                  )
        else
          ctorFieldTys levels table datas flags opqs rest (lvl + 1) next slot
      _ => icInternal "constructor telescope does not match its type"
  else
    icInternal "constructor keep flag disagrees with telescope rig"

ctorArityNeed : List Int -> HashMap String (List Int) -> List DtData -> DtCtor -> Check Int
ctorArityNeed levels table datas c =
  Vuna.Compiler.Base.Common.bind
    (ctorFieldTys levels table datas (ctorKeepFlags c) (ctorOpaqueFlagsOf datas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels))
    (\p => OkC (secondOf p - listLength levels))

dataArityNeed : List Int -> HashMap String (List Int) -> List DtData -> List DtCtor -> Check Int
dataArityNeed levels table datas ctors =
  Vuna.Compiler.Base.Common.bind
    (Vuna.Compiler.Base.Common.traverse (ctorArityNeed levels table datas) ctors)
    (\ns => OkC (listLength levels + maxIntListIn ns))

maxIntListIn : List Int -> Int
maxIntListIn [] = 0
maxIntListIn (x :: rest) = if x >= maxIntListIn rest then x else maxIntListIn rest

-- ---------------------------------------------------------------
-- λ binder 的运行时类型（选择性标注）
-- ---------------------------------------------------------------
--
-- binder 类型槽是 Core 侧的派生项。只有整条类型都能落到**可命名**的 `IrTy` 时
-- 才返回 `Just`：变量取外层 binder 已解析的运行时类型，primitive / 数据族要求
-- 类型实参全部可解析；其余（类型参数、别名、卡住的类型族应用、隐式 Pi）一律
-- `Nothing`，后端因此不会渲染可能错配的注解。
export annotTyOf : LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotTyOf env binders t = annotTyOfFuel 256 env binders t

annotTyOfFuel : Int -> LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotTyOfFuel fuel env binders t =
  if fuel <= 0 then
    Nothing
  else
    case t of
      TVar _ i _ => binderTyAtIn i binders
      TGlobal g => annotHeadTy (fuel - 1) env binders g []
      TApp _ _ _ =>
        case flattenAnnotApp t of
          Pair head args =>
            case head of
              TGlobal g => annotHeadTy (fuel - 1) env binders g args
              _ => Nothing
      TRecord g args => annotHeadTy (fuel - 1) env binders g (map firstOf args)
      TCon c args => annotConTy (fuel - 1) env c args
      TMk c args => annotConTy (fuel - 1) env c args
      TInt _ => Just IrTyInt
      TStr _ => Just IrTyStr
      TBool _ => Just IrTyBool
      TFloat _ => Just IrTyFloat
      TIf _ t _ => annotTyOfFuel (fuel - 1) env binders t
      TPi name implicit rig dom cod =>
        if rigIsErased rig then
          Nothing
        else
          case annotTyOfFuel (fuel - 1) env binders dom of
            Nothing => Nothing
            Just domTy =>
              case annotTyOfFuel (fuel - 1) env (mkIrBinderTyped name domTy :: binders) cod of
                Nothing => Nothing
                Just codTy => Just (IrTyFun domTy codTy)
      _ => Nothing

annotConTy : Int -> LwEnv -> String -> List (Pair Term Rig) -> Maybe IrTy
annotConTy fuel env c args =
  if fuel <= 0 then
    Nothing
  else
    case HashMap.lookup c env.lwCtors of
      Nothing => Nothing
      Just (Pair family _) =>
        case reprTyIr family of
          Just t => Just t
          Nothing =>
            case ctorTypeArgsOf env c args of
              Just tys => Just (IrTyData family tys)
              Nothing => Nothing

-- 外层 binder 的运行时类型（de Bruijn 下标；最近绑定在前）。
-- 擦除占位只占槽位、运行时类型不可命名，因此恒返回 `Nothing`。
binderTyAtIn : Int -> List IrBinder -> Maybe IrTy
binderTyAtIn i [] = Nothing
binderTyAtIn i (b :: rest) =
  if i <= 0 then if b.irBinderErased then Nothing else b.irBinderTy else binderTyAtIn (i - 1) rest

-- 应用脊展平（类型项：`TRecord` 等价于它的 `TGlobal` 应用脊）。
flattenAnnotApp : Term -> Pair Term (List Term)
flattenAnnotApp t = flattenAnnotAppGo t []

flattenAnnotAppGo : Term -> List Term -> Pair Term (List Term)
flattenAnnotAppGo (TApp f a _) acc = flattenAnnotAppGo f (a :: acc)
flattenAnnotAppGo (TRecord name args) acc = Pair (TGlobal name) (append (map firstOf args) acc)
flattenAnnotAppGo t acc = Pair t acc

annotHeadTy : Int -> LwEnv -> List IrBinder -> String -> List Term -> Maybe IrTy
annotHeadTy fuel env binders g args =
  if fuel <= 0 then
    Nothing
  else if g == "Array" then
    case args of
      [a] =>
        case annotTyOfFuel (fuel - 1) env binders a of
          Nothing => Nothing
          Just t => Just (IrTyArray t)
      _ => Nothing
  else if g == "IORef" then
    case args of
      [a] =>
        case annotTyOfFuel (fuel - 1) env binders a of
          Nothing => Nothing
          Just t => Just (IrTyRef t)
      _ => Nothing
  else
    case reprTyIr g of
      Just t =>
        case args of
          [] => Just t
          _ => Nothing
      Nothing =>
        case findDtData g env.lwDatas of
          Nothing => Nothing
          Just dd =>
            case annotFamilyArgs (fuel - 1) env binders (lookupTyParamsIn env.lwTyParams g) args of
              Nothing => Nothing
              Just tys => Just (IrTyData g tys)

-- | 应用头的运行时类型：局部变量/数据族仍走 `annotTyOf`；全局**函数**从定义表
-- 取 `renderPiTy` 签名。只用于 `IrApp` 的节点类型，不参与 binder 注解。
--
-- 部分应用（`TApp` 脊）按已应用的实参剥 Pi：全局定义在剥的时候用项里的**擦除实参**
-- （类型参数 / 证明）实例化闭包，因此 `map (add 1)` 得到 `List Int -> List Int` 而不是
-- 不可命名的兜底；局部变量则从它自己的函数类型逐实参剥。
export annotCalleeTy : LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotCalleeTy env binders t =
  case t of
    TGlobal g => annotGlobalTy env binders g
    TApp _ _ _ =>
      case flattenAnnotAppRig t of
        Pair (TGlobal g) args =>
          case findDtData g env.lwDatas of
            Just _ => annotTyOf env binders t
            Nothing =>
              case globalTyTermOf env g of
                Just ty => peelPiArgsTy 256 env (eval [] ty) args
                Nothing => peelIrFuns (countRuntimeArgs args) (annotTyOf env binders (TGlobal g))
        Pair head args => peelIrFuns (countRuntimeArgs args) (annotTyOf env binders head)
    _ => annotTyOf env binders t

-- | 全局名的**类型项**：运行时定义走 `lwDefTbl`，其余（trait 方法选择子等）走
-- `lwGlobals`。只读类型，不看定义体。
export globalTyTermOf : LwEnv -> String -> Maybe Term
globalTyTermOf env g =
  case HashMap.lookup g env.lwDefTbl of
    Just d => Just (dtDefType d)
    Nothing => HashMap.lookup g env.lwGlobals

-- | 全局值的运行时类型（签名级）。`IrGlobal` 与 `IrApp` 的节点类型都走这里。
export annotGlobalTy : LwEnv -> List IrBinder -> String -> Maybe IrTy
annotGlobalTy env binders g =
  case findDtData g env.lwDatas of
    Just _ => annotTyOf env binders (TGlobal g)
    Nothing =>
      case globalTyTermOf env g of
        Just ty => Just (renderPiTy [] env.lwTyParams env.lwDatas 0 (eval [] ty))
        Nothing => annotTyOf env binders (TGlobal g)

-- 应用脊展平（保留每个实参的 rig；`TRecord` 等价于它的 `TGlobal` 应用脊）。
flattenAnnotAppRig : Term -> Pair Term (List (Pair Term Rig))
flattenAnnotAppRig t = flattenAnnotAppRigGo t []

flattenAnnotAppRigGo : Term -> List (Pair Term Rig) -> Pair Term (List (Pair Term Rig))
flattenAnnotAppRigGo (TApp f a rig) acc = flattenAnnotAppRigGo f (Pair a rig :: acc)
flattenAnnotAppRigGo (TRecord name args) acc = Pair (TGlobal name) (append args acc)
flattenAnnotAppRigGo t acc = Pair t acc

countRuntimeArgs : List (Pair Term Rig) -> Int
countRuntimeArgs [] = 0
countRuntimeArgs ((Pair _ rig) :: rest) =
  if rigIsErased rig then countRuntimeArgs rest else 1 + countRuntimeArgs rest

peelIrFuns : Int -> Maybe IrTy -> Maybe IrTy
peelIrFuns n Nothing = Nothing
peelIrFuns n (Just ty) =
  if n <= 0 then
    Just ty
  else
    case ty of
      IrTyFun _ cod => peelIrFuns (n - 1) (Just cod)
      _ => Nothing

-- 按定义签名逐个剥已应用的实参：擦除 binder 用项里的擦除实参实例化闭包，
-- 其余 binder 只推进到后来的实参（结果类型不依赖运行时值本身）。
peelPiArgsTy : Int -> LwEnv -> Value -> List (Pair Term Rig) -> Maybe IrTy
peelPiArgsTy fuel env v args =
  if fuel <= 0 then
    Nothing
  else
    case v of
      VPi name implicit rig dom clo =>
        if rigIsErased rig then
          case args of
            (Pair arg arig) :: rest => if rigIsErased arig then peelPiArgsTy (fuel - 1) env (applyClosure clo (eval [] arg)) rest else peelPiArgsTy (fuel - 1) env (applyClosure clo (VNeutral (NVar name 0 []))) args
            [] => Just (renderPiTy [] env.lwTyParams env.lwDatas 0 v)
        else
          case args of
            (Pair _ _) :: rest => peelPiArgsTy (fuel - 1) env (applyClosure clo (VNeutral (NVar name 0 []))) rest
            [] => Just (renderPiTy [] env.lwTyParams env.lwDatas 0 v)
      _ => Just (renderPiTy [] env.lwTyParams env.lwDatas 0 v)

-- 数据族的运行时类型实参：按族的**运行时参数槽**（`usedPats` 是族 telescope 的 level）
-- 选实参，因此注解的实参个数与声明的类型参数个数逐位一致。
annotFamilyArgs : Int -> LwEnv -> List IrBinder -> List Int -> List Term -> Maybe (List IrTy)
annotFamilyArgs fuel env binders usedPats args =
  if fuel <= 0 then
    Nothing
  else
    case usedPats of
      [] => Just []
      i :: rest =>
        case nthTermIn args i of
          Nothing => Nothing
          Just a =>
            case annotTyOfFuel (fuel - 1) env binders a of
              Nothing => Nothing
              Just t =>
                case annotFamilyArgs (fuel - 1) env binders rest args of
                  Nothing => Nothing
                  Just ts => Just (t :: ts)

nthTermIn : List Term -> Int -> Maybe Term
nthTermIn [] i = Nothing
nthTermIn (t :: rest) i = if i <= 0 then Just t else nthTermIn rest (i - 1)

-- | 构造子应用的运行时类型实参（按族的运行时参数槽选实参）。
export ctorTypeArgsOf : LwEnv -> String -> List (Pair Term Rig) -> Maybe (List IrTy)
ctorTypeArgsOf env ctor args =
  case HashMap.lookup ctor env.lwCtors of
    Just (Pair family _) =>
      case findDtData family env.lwDatas of
        Nothing => Nothing
        Just _ =>
          annotFamilyArgs 256 env [] (lookupTyParamsIn env.lwTyParams family) (map firstOf args)
    Nothing => Nothing

findCtorInLocal : String -> List DtCtor -> Maybe DtCtor
findCtorInLocal name [] = Nothing
findCtorInLocal name (c :: rest) =
  if dtCtorName c == name then Just c else findCtorInLocal name rest

-- | 构造子的**运行时**字段类型表（只含 kept 字段，未实例化族参数槽）。
export ctorKeptFieldTys : LwEnv -> String -> Check (List IrTy)
ctorKeptFieldTys env ctor =
  case HashMap.lookup ctor env.lwCtors of
    Nothing => OkC []
    Just (Pair family keepFlags) =>
      case findDtData family env.lwDatas of
        Nothing => OkC []
        Just dd =>
          case findCtorInLocal ctor (dtDataCtors dd) of
            Nothing => OkC []
            Just c =>
              let
                levels = lookupTyParamsIn env.lwTyParams family
              in Vuna.Compiler.Base.Common.bind
                (ctorFieldTys levels env.lwTyParams env.lwDatas keepFlags (ctorOpaqueFlagsOf env.lwDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels))
                (\p => OkC (firstOf p))

-- ---------------------------------------------------------------
-- 类型声明（IR）
-- ---------------------------------------------------------------
--
-- 三族运行时表示（去装箱别名 / OCaml record / 变体）在这里判定，产出 `IrTyDecl`。
-- record 字段表与类型参数槽在 `LwEnv` 里只算一次，声明与实参共用同一份结果。
export tyDeclsOf : HashMap String (List Int) -> List (Pair String (Pair DtCtor Int)) -> List DtData -> List DtData -> Check (List IrTyDecl)
tyDeclsOf tyParams unboxed allDatas subset = tyDeclsGo tyParams allDatas unboxed subset

export tyDeclsGo : HashMap String (List Int) -> List DtData -> List (Pair String (Pair DtCtor Int)) -> List DtData -> Check (List IrTyDecl)
tyDeclsGo table allDatas unboxed [] = OkC []
tyDeclsGo table allDatas unboxed (d :: rest) =
  Vuna.Compiler.Base.Common.bind
    (tyDeclOf table allDatas unboxed d)
    (\decl => Vuna.Compiler.Base.Common.bind (tyDeclsGo table allDatas unboxed rest) (\tail => OkC ((::) decl tail)))

export tyDeclOf : HashMap String (List Int) -> List DtData -> List (Pair String (Pair DtCtor Int)) -> DtData -> Check IrTyDecl
tyDeclOf table allDatas unboxed d =
  let
    levels = lookupTyParamsIn table (dtDataName d)
    arity = listLength levels
  in case lookupUnboxedInfo (dtDataName d) unboxed of
    Just (Pair c idx) =>
      Vuna.Compiler.Base.Common.bind
        (ctorFieldTys levels table allDatas (ctorKeepFlags c) (ctorOpaqueFlagsOf allDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels))
        (
          \p =>
            case firstOf p of
              [only] => OkC (IrUnboxedDecl (dtDataName d) arity only)
              _ => icInternal "unboxed constructor does not have exactly one kept field: ${dtCtorName c}"
        )
    Nothing =>
      if hasRecordRepr d then
        case dtDataCtors d of
          [c] => Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table allDatas (ctorKeepFlags c) (ctorOpaqueFlagsOf allDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels)) (\p => OkC (IrRecordDecl (dtDataName d) arity (recordRtFields d) (firstOf p)))
          _ => icInternal "record family must have exactly one constructor: ${dtDataName d}"
      else
        Vuna.Compiler.Base.Common.bind (dataArityNeed levels table allDatas (dtDataCtors d)) (\fullArity => Vuna.Compiler.Base.Common.bind (Vuna.Compiler.Base.Common.traverse (\c => Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table allDatas (ctorKeepFlags c) (ctorOpaqueFlagsOf allDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels)) (\p => OkC (Pair (dtCtorName c) (firstOf p)))) (dtDataCtors d)) (\ctors => OkC (IrVariantDecl (dtDataName d) fullArity ctors)))

-- 类型声明里引用到的全局族名（去重、首现顺序）。后端据此算跨单元类型依赖。
export tyDeclRefs : List IrTyDecl -> List String
tyDeclRefs decls = tyDeclRefsGo (map tyDeclTys decls) []

tyDeclTys : IrTyDecl -> List IrTy
tyDeclTys (IrVariantDecl name n ctors) = concatMap secondOf ctors
tyDeclTys (IrRecordDecl name n fields tys) = tys
tyDeclTys (IrUnboxedDecl name n ty) = [ty]

tyDeclRefsGo : List (List IrTy) -> List String -> List String
tyDeclRefsGo [] acc = reverse acc
tyDeclRefsGo (tys :: rest) acc = tyDeclRefsGo rest (foldlTyNames tys acc)

foldlTyNames : List IrTy -> List String -> List String
foldlTyNames [] acc = acc
foldlTyNames (t :: rest) acc = foldlTyNames rest (tyNamesInto t acc)

tyNamesInto : IrTy -> List String -> List String
tyNamesInto (IrTyVar i) acc = acc
tyNamesInto IrTyInt acc = acc
tyNamesInto IrTyStr acc = acc
tyNamesInto IrTyBool acc = acc
tyNamesInto IrTyFloat acc = acc
tyNamesInto IrTyOpaque acc = acc
tyNamesInto (IrTyArray a) acc = tyNamesInto a acc
tyNamesInto (IrTyRef a) acc = tyNamesInto a acc
tyNamesInto (IrTyFun d c) acc = tyNamesInto c (tyNamesInto d acc)
tyNamesInto (IrTyData fam args) acc = foldlTyNames args (pushDep fam acc)
