module Vuna.Compiler.Lowering.Ty where

-- Core → IR 的**类型表面**：类型参数槽渲染、`IrTy`、类型声明。纯函数（不进项）。
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Core.Canonical
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Representation
import Vuna.Compiler.Base.Intrinsics
import Vuna.Ir.Model
import Vuna.Ir.Analysis
import Vuna.Ir.Runtime
import Vuna.Compiler.Lowering.Env

-- ---------------------------------------------------------------
-- 运行时类型渲染（Value → IrTy）
-- ---------------------------------------------------------------
--
-- `IrTy` 是签名级运行时类型。判据（哪些字段不透明、哪些族参数槽进声明）必须与
-- 构造子实参逐位对齐；文本渲染在后端。
renderTyOf : List Int -> HashMap String (List Int) -> HashMap String DtData -> Value -> IrTy
renderTyOf levels table dataTbl v = renderTyFuel 256 levels table dataTbl v

renderTyFuel : Int -> List Int -> HashMap String (List Int) -> HashMap String DtData -> Value -> IrTy
renderTyFuel fuel levels table dataTbl v =
  if fuel <= 0 then
    IrTyOpaque
  else
    case v of
      VNeutral n =>
        case n of
          NVar name lvl sp =>
            case levelSlotIn levels lvl of
              Just s => IrTyVar s
              -- 命名不到的局部类型变量：不透明运行时值。
              Nothing => IrTyOpaque
          NGlobal g sp => renderTyGlobal fuel levels table dataTbl g sp
      _ => IrTyOpaque

-- | primitive / canonical 族的 IR 运行时类型；`Nothing` = 普通 data（按声明渲染）。
export reprTyIr : String -> Maybe IrTy
reprTyIr name =
  if name == intTypeName then
    Just IrTyInt
  else if name == strTypeName then
    Just IrTyStr
  else if name == floatTypeName then
    Just IrTyFloat
  else
    case canonicalReprOf name of
      Just FamReprNat => Just IrTyInt
      Just FamReprBool => Just IrTyBool
      _ => Nothing

renderTyGlobal : Int -> List Int -> HashMap String (List Int) -> HashMap String DtData -> String -> List Value -> IrTy
renderTyGlobal fuel levels table dataTbl g sp =
  case renderTyIntrinsicWith (\x => renderTyFuel (fuel - 1) levels table dataTbl x) g sp of
    Just t => t
    Nothing =>
      case reprTyIr g of
        Just t => t
        Nothing =>
          if HashMap.member g dataTbl then
            IrTyData
              g
              (renderFamilyArgs (fuel - 1) levels table dataTbl (lookupTyParamsIn table g) sp)
          else
            IrTyOpaque

-- | intrinsic 族的 IR 运行时类型。实参由调用方传入的渲染函数**按需**渲染：非 intrinsic
-- 族直接返回 `Nothing`，不碰实参。传「已渲染的实参表」会先把整棵内层类型算完再丢弃，
-- 数据族每层嵌套就重复渲染一次（`renderFamilyArgs` 之后还会再渲染）。
renderTyIntrinsicWith : (Value -> IrTy) -> String -> List Value -> Maybe IrTy
renderTyIntrinsicWith render "Array" [a] = Just (IrTyArray (render a))
renderTyIntrinsicWith render "@vuna@Cell" [a] = Just (IrTyRef (render a))
renderTyIntrinsicWith render "@vuna@MArray" [a] = Just (IrTyArray (render a))
renderTyIntrinsicWith render "@vuna@MDynArray" [a] = Just (IrTyRef IrTyOpaque)
renderTyIntrinsicWith render "@vuna@MBuffer" [] = Just (IrTyRef IrTyOpaque)
renderTyIntrinsicWith render "Thread" ([a]) = Just IrTyOpaque
renderTyIntrinsicWith render "Mutex" [] = Just IrTyOpaque
renderTyIntrinsicWith render "Condvar" [] = Just IrTyOpaque
renderTyIntrinsicWith render "Atomic" [] = Just IrTyOpaque
renderTyIntrinsicWith render _ _ = Nothing

renderFamilyArgs : Int -> List Int -> HashMap String (List Int) -> HashMap String DtData -> List Int -> List Value -> List IrTy
renderFamilyArgs fuel levels table dataTbl usedPats args =
  if fuel <= 0 then
    []
  else
    case usedPats of
      [] => []
      i :: rest =>
        case nthValueIn args i of
          Just arg => renderTyFuel (fuel - 1) levels table dataTbl arg :: renderFamilyArgs (fuel - 1) levels table dataTbl rest args
          -- 高阶/部分应用：族头出现时实参可能少于运行时参数槽（例如
          -- `Dict_Functor Maybe` 里的 `Maybe`）。保留槽位，用不透明值占位，
          -- 保证 `IrTyData` 的 arity 与声明一致。
          Nothing => IrTyOpaque :: renderFamilyArgs (fuel - 1) levels table dataTbl rest args

-- 显式 Pi 结构化渲染（`(Int -> a)` 这类）；带隐式量词的 Pi 整体不透明。
export renderPiTy : List Int -> HashMap String (List Int) -> HashMap String DtData -> Int -> Value -> IrTy
renderPiTy levels table dataTbl lvl v = renderPiTyFuel 256 levels table dataTbl lvl v

renderPiTyFuel : Int -> List Int -> HashMap String (List Int) -> HashMap String DtData -> Int -> Value -> IrTy
renderPiTyFuel fuel levels table dataTbl lvl v =
  if fuel <= 0 then
    renderTyFuel fuel levels table dataTbl v
  else
    case v of
      VPi name implicit rig dom clo =>
        let
          next = applyClosure clo (VNeutral (NVar name lvl []))
        in if rigIsErased rig then renderPiTyFuel (fuel - 1) levels table dataTbl (lvl + 1) next else IrTyFun (renderPiTyFuel (fuel - 1) levels table dataTbl lvl dom) (renderPiTyFuel (fuel - 1) levels table dataTbl (lvl + 1) next)
      _ => renderTyFuel fuel levels table dataTbl v

-- 单个字段的运行时类型 + 下一个不透明参数槽。
-- 只有「运行时隐式字段」会分配新槽；其余解析不到的形态一律报内部错——凭空造槽会让
-- 声明的 arity 超过族真实参数个数（后端渲染成未绑定的 `'a<i>`）。
renderFieldTy : List Int -> HashMap String (List Int) -> HashMap String DtData -> Int -> Value -> Int -> Check (IrTy, Int)
renderFieldTy levels table dataTbl lvl (dom@(VPi name implicit rig d clo)) slot =
  if implicit then
    OkC (IrTyVar slot, slot + 1)
  else
    OkC (renderPiTy levels table dataTbl lvl dom, slot)
renderFieldTy levels table dataTbl lvl (VNeutral n) slot =
  case n of
    NVar name lvl2 sp =>
      case levelSlotIn levels lvl2 of
        Just s => OkC (IrTyVar s, slot)
        Nothing =>
          icInternal
            "constructor field type mentions a type variable outside the family's runtime parameter slots"
    NGlobal g sp =>
      case renderTyIntrinsicWith (\x => renderTyFuel 256 levels table dataTbl x) g sp of
        Just t => OkC (t, slot)
        Nothing =>
          case reprTyIr g of
            Just t => OkC (t, slot)
            Nothing =>
              if HashMap.member g dataTbl then
                OkC
                  (IrTyData g (renderFamilyArgs 256 levels table dataTbl (lookupTyParamsIn table g) sp), slot)
              else
                icInternal "constructor field type head is not a known family: ${g}"
renderFieldTy levels table dataTbl lvl _ slot =
  icInternal "constructor field type has no runtime rendering"

export flagMatchesRigIn : Bool -> Rig -> Bool
flagMatchesRigIn True rig = not (rigIsErased rig)
flagMatchesRigIn False rig = rigIsErased rig

-- 构造子字段的运行时类型表（唯一真源：keep flags + 不透明 flags 与 telescope 逐位对齐）。
ctorFieldTys : List Int -> HashMap String (List Int) -> HashMap String DtData -> List Bool -> List Bool -> List (String, Rig) -> Int -> Value -> Int -> Check (List IrTy, Int)
ctorFieldTys levels table dataTbl keepFlags opaqueFlags [] lvl v slot = OkC ([], slot)
ctorFieldTys levels table dataTbl [] (_ :: _) tele lvl v slot =
  icInternal "constructor opaque flags longer than its shape"
ctorFieldTys levels table dataTbl [] [] (_ :: _) lvl v slot =
  icInternal "constructor shape has more binders than its telescope"
ctorFieldTys levels table dataTbl (_ :: _) [] (_ :: _) lvl v slot =
  icInternal "constructor opaque flags shorter than its shape"
ctorFieldTys levels table dataTbl (keep :: flags) (opq :: opqs) ((name, rig) :: rest) lvl v slot =
  if flagMatchesRigIn keep rig then
    case v of
      VPi pname implicit _ dom clo =>
        let
          next = applyClosure clo (VNeutral (NVar pname lvl []))
        in if keep then
          if opq then
            Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table dataTbl flags opqs rest (lvl + 1) next slot) (
                \p =>
                  case p of
                    -- 不透明字段：整个字段渲染成不命名的运行时值；不消耗类型参数槽。
                    (tys, slot3) => OkC (IrTyOpaque :: tys, slot3)
              )
          else
            Vuna.Compiler.Base.Common.bind (renderFieldTy levels table dataTbl lvl dom slot) (
                \p =>
                  case p of
                    (text, slot2) =>
                      Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table dataTbl flags opqs rest (lvl + 1) next slot2) (
                          \q =>
                            case q of
                              (tys, slot3) => OkC (text :: tys, slot3)
                        )
              )
        else
          ctorFieldTys levels table dataTbl flags opqs rest (lvl + 1) next slot
      _ => icInternal "constructor telescope does not match its type"
  else
    icInternal "constructor keep flag disagrees with telescope rig"

ctorArityNeed : HashMap String DtData -> List Int -> HashMap String (List Int) -> List DtData -> DtCtor -> Check Int
ctorArityNeed dataTbl levels table datas c =
  Vuna.Compiler.Base.Common.bind
    (ctorFieldTys levels table dataTbl (ctorKeepFlags c) (ctorOpaqueFlagsOf datas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels))
    (\p => OkC (secondOf p - listLength levels))

dataArityNeed : HashMap String DtData -> List Int -> HashMap String (List Int) -> List DtData -> List DtCtor -> Check Int
dataArityNeed dataTbl levels table datas ctors =
  Vuna.Compiler.Base.Common.bind
    (Vuna.Compiler.Base.Common.traverse (ctorArityNeed dataTbl levels table datas) ctors)
    (\ns => OkC (listLength levels + maxIntListIn ns))

maxIntListIn : List Int -> Int
maxIntListIn [] = 0
maxIntListIn (x :: rest) = if x >= maxIntListIn rest then x else maxIntListIn rest

-- ---------------------------------------------------------------
-- λ binder 的运行时类型（两种口径）
-- ---------------------------------------------------------------
--
-- binder 类型槽是 Core 侧的派生项：变量取外层 binder 已解析的运行时类型，
-- primitive / 数据族要求类型实参可解析。两种口径共用同一套遍历：
--
--   * `annotTyOf`：不可命名的部分返回 `Nothing`（选择性注解）；
--   * `annotTyOfTotal`：不可命名的部分落 `IrTyOpaque`，因此总能给出结构
--     （`a -> b` 是 `Opaque -> Opaque` 而不是整体未知）。它只服务 binder 类型槽；
--     OCaml lambda 注解另由 `irTyAnnotatable` 过滤，不透明类型不会写进 OCaml，
--     从而不固定多态性。
export annotTyOf : LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotTyOf env binders t = annotTyOfFuel 256 Nothing env binders t

-- 类型注解遍历里的临时 binder：不进 IR，用与运行时 binder 不相交的哨兵 id。
tempAnnotBinderId : Int
tempAnnotBinderId = 0 - 1

export annotTyOfTotal : LwEnv -> List IrBinder -> Term -> IrTy
annotTyOfTotal env binders t =
  case annotTyOfFuel 256 (Just IrTyOpaque) env binders t of
    Just ty => ty
    Nothing => IrTyOpaque

-- 第一个 `Maybe IrTy` 是「不可命名时落什么」：`Nothing` = 整体未知，`Just IrTyOpaque`
-- = 保留结构、把洞填成不透明值。
annotTyOfFuel : Int -> Maybe IrTy -> LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotTyOfFuel fuel dflt env binders t =
  if fuel <= 0 then
    dflt
  else
    case t of
      TVar _ i _ =>
        case binderTyAtIn i binders of
          Just ty => Just ty
          Nothing => dflt
      TGlobal g => annotHeadTy (fuel - 1) dflt env binders g []
      TApp _ _ _ =>
        case flattenAnnotApp t of
          (head, args) =>
            case head of
              TGlobal g => annotHeadTy (fuel - 1) dflt env binders g args
              _ => dflt
      TRecord g args => annotHeadTy (fuel - 1) dflt env binders g (map firstOf args)
      TCon c args => annotConTy (fuel - 1) dflt env c args
      TMk c args => annotConTy (fuel - 1) dflt env c args
      TInt _ => Just IrTyInt
      TStr _ => Just IrTyStr
      TBool _ => Just IrTyBool
      TFloat _ => Just IrTyFloat
      TIf _ t _ => annotTyOfFuel (fuel - 1) dflt env binders t
      TPi name implicit rig dom cod =>
        if rigIsErased rig then
          dflt
        else
          case annotTyOfFuel (fuel - 1) dflt env binders dom of
            Nothing => Nothing
            Just domTy =>
              case annotTyOfFuel (fuel - 1) dflt env (mkIrBinderTyped tempAnnotBinderId name domTy :: binders) cod of
                Nothing => Nothing
                Just codTy => Just (IrTyFun domTy codTy)
      _ => dflt

annotConTy : Int -> Maybe IrTy -> LwEnv -> String -> List (Term, Rig) -> Maybe IrTy
annotConTy fuel dflt env c args =
  if fuel <= 0 then
    dflt
  else
    case HashMap.lookup c env.lwCtors of
      Nothing => dflt
      Just (family, _) =>
        case reprTyIr family of
          Just t => Just t
          Nothing =>
            case ctorTypeArgsOf env c args of
              Just tys => Just (IrTyData family tys)
              Nothing => dflt

-- 外层 binder 的运行时类型（de Bruijn 下标；最近绑定在前）。
-- 擦除占位只占槽位、运行时类型不可命名，因此恒返回 `Nothing`。
binderTyAtIn : Int -> List IrBinder -> Maybe IrTy
binderTyAtIn i [] = Nothing
binderTyAtIn i (b :: rest) =
  if i <= 0 then if b.irBinderErased then Nothing else b.irBinderTy else binderTyAtIn (i - 1) rest

-- 应用脊展平（类型项：`TRecord` 等价于它的 `TGlobal` 应用脊）。
flattenAnnotApp : Term -> (Term, List Term)
flattenAnnotApp t = flattenAnnotAppGo t []

flattenAnnotAppGo : Term -> List Term -> (Term, List Term)
flattenAnnotAppGo (TApp f a _) acc = flattenAnnotAppGo f (a :: acc)
flattenAnnotAppGo (TRecord name args) acc = (TGlobal name, append (map firstOf args) acc)
flattenAnnotAppGo t acc = (t, acc)

annotHeadTy : Int -> Maybe IrTy -> LwEnv -> List IrBinder -> String -> List Term -> Maybe IrTy
annotHeadTy fuel dflt env binders g args =
  if fuel <= 0 then
    dflt
  else if g == "Array" then
    case args of
      [a] =>
        case annotTyOfFuel (fuel - 1) dflt env binders a of
          Nothing => Nothing
          Just t => Just (IrTyArray t)
      _ => dflt
  else if g == "@vuna@Cell" then
    case args of
      [a] =>
        case annotTyOfFuel (fuel - 1) dflt env binders a of
          Nothing => Nothing
          Just t => Just (IrTyRef t)
      _ => dflt
  else if g == "@vuna@MArray" then
    case args of
      [a] =>
        case annotTyOfFuel (fuel - 1) dflt env binders a of
          Nothing => Nothing
          Just t => Just (IrTyArray t)
      _ => dflt
  else if g == "@vuna@MDynArray" then
    case args of
      [a] => Just (IrTyRef IrTyOpaque)
      _ => dflt
  else if g == "@vuna@MBuffer" then
    case args of
      [] => Just (IrTyRef IrTyOpaque)
      _ => dflt
  else if g == "Thread" then
    Just IrTyOpaque
  else if g == "Mutex" then
    Just IrTyOpaque
  else if g == "Condvar" then
    Just IrTyOpaque
  else if g == "Atomic" then
    Just IrTyOpaque
  else
    case reprTyIr g of
      Just t =>
        case args of
          [] => Just t
          _ => dflt
      Nothing =>
        if HashMap.member g env.lwDataTbl then
          case annotFamilyArgs (fuel - 1) dflt env binders (lookupTyParamsIn env.lwTyParams g) args of
            Nothing => Nothing
            Just tys => Just (IrTyData g tys)
        else
          dflt

-- | 应用头的运行时类型：局部变量/数据族仍走 `annotTyOf`；全局**函数**从定义表
-- 取 `renderPiTy` 签名。只用于 `IrApp` 的节点类型，不参与 binder 注解。
--
-- 部分应用（`TApp` 脊）按已应用的实参剥 Pi：全局定义在剥的时候用项里的**擦除实参**
-- （类型参数 / 证明）实例化闭包，因此 `map (add 1)` 得到 `List Int -> List Int` 而不是
-- 不可命名的兜底；局部变量则从它自己的函数类型逐实参剥。
-- | 运行时项的类型：`TVar` 用**运行时下标**解析（擦除后 Core 的运行时位置）。
-- 其余形状（数据族 / 构造子 / 全局头）里的类型实参仍走原始上下文的 `annotTyOf`。
export annotRunTyOf : LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotRunTyOf env binders (TVar _ i _) = binderTyAtRuntime i binders
annotRunTyOf env binders (TIf _ a _) = annotRunTyOf env binders a
annotRunTyOf env binders t = annotTyOf env binders t

-- 运行时下标 → binder 类型（跳过擦除占位）。
binderTyAtRuntime : Int -> List IrBinder -> Maybe IrTy
binderTyAtRuntime j [] = Nothing
binderTyAtRuntime j (b :: rest) =
  if b.irBinderErased then
    binderTyAtRuntime j rest
  else if j <= 0 then b.irBinderTy else binderTyAtRuntime (j - 1) rest

-- | `annotCalleeTy` 的运行时版本：局部头用运行时下标；全局头仍按签名。
export annotRunCalleeTy : LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotRunCalleeTy env binders (TGlobal g) = annotGlobalTy env binders g
annotRunCalleeTy env binders (t@(TApp _ _ _)) =
  case flattenAnnotAppRig t of
    (TGlobal g, args) => annotCalleeTy env binders t
    (head, args) => peelIrFuns (countRuntimeArgs args) (Just (annotRunTyOfTotal env binders head))
annotRunCalleeTy env binders t = annotRunTyOf env binders t

annotRunTyOfTotal : LwEnv -> List IrBinder -> Term -> IrTy
annotRunTyOfTotal env binders t =
  case annotRunTyOf env binders t of
    Just ty => ty
    Nothing => IrTyOpaque

export annotCalleeTy : LwEnv -> List IrBinder -> Term -> Maybe IrTy
annotCalleeTy env binders (TGlobal g) = annotGlobalTy env binders g
annotCalleeTy env binders (t@(TApp _ _ _)) =
  case flattenAnnotAppRig t of
    (TGlobal g, args) =>
      if HashMap.member g env.lwDataTbl then
        annotTyOf env binders t
      else
        case globalTyTermOf env g of
          Just ty => peelPiArgsTy 256 env (eval [] ty) args
          Nothing => peelIrFuns (countRuntimeArgs args) (annotTyOf env binders (TGlobal g))
    (head, args) => peelIrFuns (countRuntimeArgs args) (Just (annotTyOfTotal env binders head))
annotCalleeTy env binders t = annotTyOf env binders t

-- | 全局名的**类型项**：运行时定义走 `lwDefTbl`，其余（trait 方法选择子等）走
-- `lwGlobals`。只读类型，不看定义体。
export globalTyTermOf : LwEnv -> String -> Maybe Term
globalTyTermOf env g =
  case HashMap.lookup g env.lwDefTbl of
    Just d => Just (dtDefType d)
    Nothing => HashMap.lookup g env.lwGlobals

-- | 全局值的运行时类型（签名级）。`IrGlobal` 与 `IrApp` 的节点类型都走这里。
export annotGlobalTy : LwEnv -> List IrBinder -> String -> Maybe IrTy
annotGlobalTy env binders g =
  if HashMap.member g env.lwDataTbl then
    annotTyOf env binders (TGlobal g)
  else
    case globalTyTermOf env g of
      Just ty => Just (renderPiTy [] env.lwTyParams env.lwDataTbl 0 (eval [] ty))
      Nothing => annotTyOf env binders (TGlobal g)

-- 应用脊展平（保留每个实参的 rig；`TRecord` 等价于它的 `TGlobal` 应用脊）。
flattenAnnotAppRig : Term -> (Term, List (Term, Rig))
flattenAnnotAppRig t = flattenAnnotAppRigGo t []

flattenAnnotAppRigGo : Term -> List (Term, Rig) -> (Term, List (Term, Rig))
flattenAnnotAppRigGo (TApp f a rig) acc = flattenAnnotAppRigGo f ((a, rig) :: acc)
flattenAnnotAppRigGo (TRecord name args) acc = (TGlobal name, append args acc)
flattenAnnotAppRigGo t acc = (t, acc)

countRuntimeArgs : List (Term, Rig) -> Int
countRuntimeArgs [] = 0
countRuntimeArgs ((_, rig) :: rest) =
  if rigIsErased rig then countRuntimeArgs rest else 1 + countRuntimeArgs rest

peelIrFuns : Int -> Maybe IrTy -> Maybe IrTy
peelIrFuns n Nothing = Nothing
peelIrFuns n (Just ty) =
  if n <= 0 then
    Just ty
  else
    case ty of
      IrTyFun _ cod => peelIrFuns (n - 1) (Just cod)
      _ => Nothing

-- 按定义签名逐个剥已应用的实参：擦除 binder 用项里的擦除实参实例化闭包，
-- 其余 binder 只推进到后来的实参（结果类型不依赖运行时值本身）。
peelPiArgsTy : Int -> LwEnv -> Value -> List (Term, Rig) -> Maybe IrTy
peelPiArgsTy fuel env v args =
  if fuel <= 0 then
    Nothing
  else
    case v of
      VPi name implicit rig dom clo =>
        if rigIsErased rig then
          case args of
            (arg, arig) :: rest => if rigIsErased arig then peelPiArgsTy (fuel - 1) env (applyClosure clo (eval [] arg)) rest else peelPiArgsTy (fuel - 1) env (applyClosure clo (VNeutral (NVar name 0 []))) args
            [] => Just (renderPiTy [] env.lwTyParams env.lwDataTbl 0 v)
        else
          case args of
            (_, _) :: rest => peelPiArgsTy (fuel - 1) env (applyClosure clo (VNeutral (NVar name 0 []))) rest
            [] => Just (renderPiTy [] env.lwTyParams env.lwDataTbl 0 v)
      _ => Just (renderPiTy [] env.lwTyParams env.lwDataTbl 0 v)

-- 数据族的运行时类型实参：按族的**运行时参数槽**（`usedPats` 是族 telescope 的 level）
-- 选实参，因此注解的实参个数与声明的类型参数个数逐位一致。
annotFamilyArgs : Int -> Maybe IrTy -> LwEnv -> List IrBinder -> List Int -> List Term -> Maybe (List IrTy)
annotFamilyArgs fuel dflt env binders usedPats args =
  if fuel <= 0 then
    Nothing
  else
    case usedPats of
      [] => Just []
      i :: rest =>
        case nthTermIn args i of
          Nothing => Nothing
          Just a =>
            case annotTyOfFuel (fuel - 1) dflt env binders a of
              Nothing => Nothing
              Just t =>
                case annotFamilyArgs (fuel - 1) dflt env binders rest args of
                  Nothing => Nothing
                  Just ts => Just (t :: ts)

nthTermIn : List Term -> Int -> Maybe Term
nthTermIn [] i = Nothing
nthTermIn (t :: rest) i = if i <= 0 then Just t else nthTermIn rest (i - 1)

-- | 构造子应用的运行时类型实参（按族的运行时参数槽选实参）。
export ctorTypeArgsOf : LwEnv -> String -> List (Term, Rig) -> Maybe (List IrTy)
ctorTypeArgsOf env ctor args =
  case HashMap.lookup ctor env.lwCtors of
    Just (family, _) =>
      if HashMap.member family env.lwDataTbl then
        annotFamilyArgs
          256
          Nothing
          env
          []
          (lookupTyParamsIn env.lwTyParams family)
          (map firstOf args)
      else
        Nothing
    Nothing => Nothing

findCtorInLocal : String -> List DtCtor -> Maybe DtCtor
findCtorInLocal name [] = Nothing
findCtorInLocal name (c :: rest) =
  if dtCtorName c == name then Just c else findCtorInLocal name rest

-- | 构造子的**运行时**字段类型表（只含 kept 字段，未实例化族参数槽）。
export ctorKeptFieldTys : LwEnv -> String -> Check (List IrTy)
ctorKeptFieldTys env ctor =
  case HashMap.lookup ctor env.lwCtors of
    Nothing => OkC []
    Just (family, keepFlags) =>
      case HashMap.lookup family env.lwDataTbl of
        Nothing => OkC []
        Just dd =>
          case findCtorInLocal ctor (dtDataCtors dd) of
            Nothing => OkC []
            Just c =>
              let
                levels = lookupTyParamsIn env.lwTyParams family
              in Vuna.Compiler.Base.Common.bind
                (ctorFieldTys levels env.lwTyParams env.lwDataTbl keepFlags (ctorOpaqueFlagsOf env.lwDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels))
                (\p => OkC (firstOf p))

-- ---------------------------------------------------------------
-- 类型声明（IR）
-- ---------------------------------------------------------------
--
-- 三族运行时表示（去装箱别名 / OCaml record / 变体）在这里判定，产出 `IrTyDecl`。
-- record 字段表与类型参数槽在 `LwEnv` 里只算一次，声明与实参共用同一份结果。
export tyDeclsOf : HashMap String DtData -> HashMap String (List Int) -> List (String, DtCtor, Int) -> List DtData -> List DtData -> Check (List IrTyDecl)
tyDeclsOf dataTbl tyParams unboxed allDatas subset =
  tyDeclsGo dataTbl tyParams allDatas unboxed subset

export tyDeclsGo : HashMap String DtData -> HashMap String (List Int) -> List DtData -> List (String, DtCtor, Int) -> List DtData -> Check (List IrTyDecl)
tyDeclsGo dataTbl table allDatas unboxed [] = OkC []
tyDeclsGo dataTbl table allDatas unboxed (d :: rest) =
  Vuna.Compiler.Base.Common.bind
    (tyDeclOf dataTbl table allDatas unboxed d)
    (\decl => Vuna.Compiler.Base.Common.bind (tyDeclsGo dataTbl table allDatas unboxed rest) (\tail => OkC ((::) decl tail)))

export tyDeclOf : HashMap String DtData -> HashMap String (List Int) -> List DtData -> List (String, DtCtor, Int) -> DtData -> Check IrTyDecl
tyDeclOf dataTbl table allDatas unboxed d =
  let
    levels = lookupTyParamsIn table (dtDataName d)
    arity = listLength levels
  in case lookupUnboxedInfo (dtDataName d) unboxed of
    Just (c, idx) =>
      Vuna.Compiler.Base.Common.bind
        (ctorFieldTys levels table dataTbl (ctorKeepFlags c) (ctorOpaqueFlagsOf allDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) arity)
        (
          \p =>
            case firstOf p of
              [only] => OkC (IrUnboxedDecl (dtDataName d) (secondOf p) only)
              _ => icInternal "unboxed constructor does not have exactly one kept field: ${dtCtorName c}"
        )
    Nothing =>
      if hasRecordRepr d then
        case dtDataCtors d of
          [c] =>
            Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table dataTbl (ctorKeepFlags c) (ctorOpaqueFlagsOf allDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) arity) (
                \p =>
                  let
                    fields = recordRtFields d
                    tys = firstOf p
                  in if listLength fields == listLength tys then OkC (IrRecordDecl (dtDataName d) (secondOf p) fields tys) else icInternal "record `${dtDataName d}` has ${strFromInt (listLength fields)} runtime fields but ${strFromInt (listLength tys)} field types"
              )
          _ => icInternal "record family must have exactly one constructor: ${dtDataName d}"
      else
        Vuna.Compiler.Base.Common.bind (dataArityNeed dataTbl levels table allDatas (dtDataCtors d)) (\fullArity => Vuna.Compiler.Base.Common.bind (Vuna.Compiler.Base.Common.traverse (\c => Vuna.Compiler.Base.Common.bind (ctorFieldTys levels table dataTbl (ctorKeepFlags c) (ctorOpaqueFlagsOf allDatas c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (listLength levels)) (\p => OkC (dtCtorName c, firstOf p))) (dtDataCtors d)) (\ctors => OkC (IrVariantDecl (dtDataName d) fullArity ctors)))

-- 类型声明里引用到的全局族名（去重、首现顺序）。后端据此算跨单元类型依赖。
export tyDeclRefs : List IrTyDecl -> List String
tyDeclRefs decls = tyDeclRefsGo (map tyDeclTys decls) []

tyDeclTys : IrTyDecl -> List IrTy
tyDeclTys (IrVariantDecl name n ctors) = concatMap secondOf ctors
tyDeclTys (IrRecordDecl name n fields tys) = tys
tyDeclTys (IrUnboxedDecl name n ty) = [ty]

tyDeclRefsGo : List (List IrTy) -> List String -> List String
tyDeclRefsGo [] acc = reverse acc
tyDeclRefsGo (tys :: rest) acc = tyDeclRefsGo rest (foldlTyNames tys acc)

foldlTyNames : List IrTy -> List String -> List String
foldlTyNames [] acc = acc
foldlTyNames (t :: rest) acc = foldlTyNames rest (tyNamesInto t acc)

tyNamesInto : IrTy -> List String -> List String
tyNamesInto (IrTyVar i) acc = acc
tyNamesInto IrTyInt acc = acc
tyNamesInto IrTyStr acc = acc
tyNamesInto IrTyBool acc = acc
tyNamesInto IrTyFloat acc = acc
tyNamesInto IrTyOpaque acc = acc
tyNamesInto (IrTyArray a) acc = tyNamesInto a acc
tyNamesInto (IrTyRef a) acc = tyNamesInto a acc
tyNamesInto (IrTyFun d c) acc = tyNamesInto c (tyNamesInto d acc)
tyNamesInto (IrTyData fam args) acc = foldlTyNames args (pushDep fam acc)
