-- | 过渡期 canonical 名映射：新目录模块名 → 旧的模块名前缀。
--
-- 目录重排把 base 的模块名改成门面路径（`Base.List` → `Base.Data.List`），
-- 但当前 seed 里仍硬编码旧 canonical 名。这里只给 seed 编译新目录时用：
-- `Loader.Modules.mangle` 在拼接 canonical 名前把新模块名折回旧名，
-- 使 seed 的识别表/字面量继续命中。新 seed 生成后删除本模块。
module Vuna.Compiler.Base.NameAlias where

import Base.String
import Base.List
import Base.Nat

-- | 新模块名 → 旧 canonical 模块名；未改名模块原样返回。
export canonicalModule : String -> String
canonicalModule m =
  if m == "Base.Effect.Core" then "Base.Eff"
  else if m == "Base.Effect.Types" then "Base.Eff.Types"
  else if m == "Base.Effect.State" then "Base.EffState"
  else if m == "Base.Effect.Reader" then "Base.Eff.Reader"
  else if m == "Base.Effect.Error" then "Base.EffError"
  else if m == "Base.Effect.Exn" then "Base.EffExn"
  else if m == "Base.Effect.Ref" then "Base.EffRef"
  else if m == "Base.Effect.Fs" then "Base.EffFs"
  else if m == "Base.Effect.Console" then "Base.EffConsole"
  else if m == "Base.Effect.Clock" then "Base.EffClock"
  else if m == "Base.Effect.Env" then "Base.EffEnv"
  else if m == "Base.Effect.Args" then "Base.EffArgs"
  else if m == "Base.Effect.Stdin" then "Base.EffStdin"
  else if m == "Base.Effect.Exit" then "Base.EffExit"
  else if m == "Base.Effect.Net" then "Base.EffNet"
  else if m == "Base.Effect.Process" then "Base.EffProcess"
  else if startsWith "Base.Effect.Pure." m then rehome "Base.Effect.Pure" "Base" m
  else if startsWith "Base.Data." m then rehome "Base.Data" "Base" m
  else if startsWith "Base.Trait." m then rehome "Base.Trait" "Base" m
  else if startsWith "Base.Container." m then rehome "Base.Container" "Base" m
  else if m == "Base.Internal.Operator" then "Base.Operator"
  else m

-- | 把 `from` 前缀换成 `to`：按段替换，只动前缀部分。
rehome : String -> String -> String -> String
rehome from to m =
  let
    fromSegs = split "." from
    segs = split "." m
  in join "." (append (split "." to) (drop (natToInt (length fromSegs)) segs))