module Vuna.Compiler.Elab.Termination where

-- Vuna.Compiler.Elab.Termination：DT 终止性检查入口。
-- 判据细节见 `.Measure`（size/守卫正事实/投影/关系/弱环）与 `.Scc`（size-change）。
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name
import Vuna.Compiler.Elab.Termination.Measure
import Vuna.Compiler.Elab.Termination.Scc

patNames : Pat -> List String
patNames (PVar n sp) = [n]
patNames (PAs n inner sp) = n :: patNames inner
patNames (PCon c ps sp) = concatMap patNames ps
patNames (PRecord rn fields sp) = concatMap (\q => patNames (secondOf q)) fields
patNames (PWild sp) = []
patNames _ = []

patsNames : List Pat -> List String
patsNames ps = concatMap patNames ps

refsOfStmt : List String -> DoStmt -> (List String, List String)
refsOfStmt bound (DBind pat e sp) = (patNames pat, exprRefsB bound e)
refsOfStmt bound (DExpr e sp) = ([], exprRefsB bound e)
refsOfStmt bound (DLet binds sp) =
  (concatMap (\bd => patNames (firstOf bd)) binds,
    concatMap (\bd => exprRefsB bound (secondOf bd)) binds)

refsOfStmts : List String -> List DoStmt -> (List String, List String)
refsOfStmts bound [] = ([], [])
refsOfStmts bound (st :: rest) =
  case refsOfStmt bound st of
    (newNames, refs) =>
      case refsOfStmts (append newNames bound) rest of
        (newNames2, restRefs) => (newNames2, append refs restRefs)

exprRefsB : List String -> Expr -> List String
exprRefsB bound e =
  case e of
    EVar n sp => if memName (rnameKey n) bound then [] else [rnameKey n]
    EInt n sp => []
    EStr s sp => []
    ELam ns b sp => exprRefsB (append (map firstOf ns) bound) b
    EApp fn args sp => append (exprRefsB bound fn) (concatMap (exprRefsB bound) args)
    EPi n implicit _ dom cod sp => append (exprRefsB bound dom) (exprRefsB (n :: bound) cod)
    ELet binds b rec_ sp =>
      append
        (concatMap (\bd => exprRefsB bound (secondOf bd)) binds)
        (exprRefsB (append (concatMap (\bd => patNames (firstOf bd)) binds) bound) b)
    ECase scrut alts sp =>
      append
        (exprRefsB bound scrut)
        (concatMap (\alt => exprRefsB (append (patNames (firstOf alt)) bound) (secondOf alt)) alts)
    EIf c t el sp => append (exprRefsB bound c) (append (exprRefsB bound t) (exprRefsB bound el))
    EField base f sp => exprRefsB bound base
    ERecord rn fields sp => concatMap (\q => exprRefsB bound (secondOf q)) fields
    ERecUpdate base fields sp =>
      append (exprRefsB bound base) (concatMap (\q => exprRefsB bound (secondOf q)) fields)
    EDo stmts sp => secondOf (refsOfStmts bound stmts)
    EAnn value ty sp => append (exprRefsB bound value) (exprRefsB bound ty)
    -- 局部函数组：每个 clause 的参数模式绑定在其体内可见。
    ELocalFun clauses sp =>
      concatMap (\c => exprRefsB (append (patsNames (firstOf c)) bound) (secondOf c)) clauses
    _ => []

refsOfDef : List (List Pat, Expr) -> List String
refsOfDef clauses = dedup (concatMap (\c => exprRefsB (patsNames (firstOf c)) (secondOf c)) clauses)

mapEdges : HashMap String Bool -> List (String, List (List Pat, Expr)) -> List (String, List String)
mapEdges names [] = []
mapEdges names (d :: rest) =
  (firstOf d, filter (\r => HashMap.member r names) (refsOfDef (secondOf d))) :: mapEdges names rest

callGraph : List (String, List (List Pat, Expr)) -> List (String, List String)
callGraph defs = mapEdges (HashMap.ofNames (defNames defs)) defs

adjOf : String -> HashMap String (List String) -> List String
adjOf n g =
  case HashMap.lookup n g of
    Just xs => xs
    Nothing => []

adjTblOf : List (String, List String) -> HashMap String (List String)
adjTblOf g = HashMap.insertAll g (HashMap.fromList [])

-- 反向邻接表：一次遍历建哈希表（逐边 lookup/replace 转置是 O(#边 × #节点)）。
reverseAdjOf : List (String, List String) -> HashMap String (List String)
reverseAdjOf [] = HashMap.fromList []
reverseAdjOf ((src, dsts) :: rest) = addSrcs src dsts (reverseAdjOf rest)

addSrcs : String -> List String -> HashMap String (List String) -> HashMap String (List String)
addSrcs src [] t = t
addSrcs src (dst :: ds) t =
  let
    cur =
      case HashMap.lookup dst t of
        Just xs => xs
        Nothing => []
  in addSrcs src ds (HashMap.insert dst ((::) src cur) t)

replacePair : String -> List String -> List (String, List String) -> List (String, List String)
replacePair n v [] = []
replacePair n v ((k, xs) :: rest) =
  if k == n then (::) (n, v) rest else (::) (k, xs) (replacePair n v rest)

addEdge : String -> String -> List (String, List String) -> List (String, List String)
-- 注意：这里**不做 dedup**。每个新边都对已累积的依赖表 dedup 是 O(k²)（高扇入
-- 时合计 O(k³)）；去重挪到 transpose 结束后整表做一次（dedupTransposed）。
addEdge n m acc =
  case lookupPair n acc of
    Just xs => replacePair n (m :: xs) acc
    Nothing => (n, [m]) :: acc

addEdges : String -> List String -> List (String, List String) -> List (String, List String)
addEdges src [] a = a
addEdges src (d :: ds) a = addEdges src ds (addEdge d src a)

transposeGo : List (String, List String) -> List (String, List String) -> List (String, List String)
transposeGo [] acc = acc
transposeGo ((src, dsts) :: rest) acc = transposeGo rest (addEdges src dsts acc)

transpose : List (String, List String) -> List (String, List String)
transpose g = dedupTransposed (transposeGo g [])

dedupTransposed : List (String, List String) -> List (String, List String)
dedupTransposed [] = []
dedupTransposed ((n, xs) :: rest) = (n, dedup xs) :: dedupTransposed rest

edgeCount : List (String, List String) -> Int
edgeCount [] = 0
edgeCount ((n, ds) :: rest) = length ds + edgeCount rest

graphFuel : List (String, List String) -> List String -> Int
graphFuel g nodes = 4 * length nodes + 4 * edgeCount g + 16

-- 迭代 DFS 后序：steps 里 (n, False) = 访问，(n, True) = 发射。
dfsPost : List (String, Bool) -> Int -> HashMap String (List String) -> HashMap String Bool -> List String -> (HashMap String Bool, List String)
dfsPost steps fuel g visited post =
  if fuel <= 0 then
    (visited, post)
  else
    case steps of
      [] => (visited, post)
      (n, True) :: rest => dfsPost rest (fuel - 1) g visited (n :: post)
      (n, False) :: rest => if HashMap.member n visited then dfsPost rest (fuel - 1) g visited post else dfsPost (append (map (\m => (m, False)) (adjOf n g)) ((n, True) :: rest)) (fuel - 1) g (HashMap.insert n True visited) post

dfsAll : List String -> Int -> HashMap String (List String) -> HashMap String Bool -> List String -> List String
dfsAll [] fuel g visited post = post
dfsAll (n :: rest) fuel g visited post =
  if fuel <= 0 then
    post
  else if HashMap.member n visited then
    dfsAll rest (fuel - 1) g visited post
  else
    case dfsPost [(n, False)] fuel g visited post of
      (v2, p2) => dfsAll rest (fuel - 1) g v2 p2

-- | `Pair ok post`：`ok = False` = DFS 未发射全部节点（fuel 耗尽）。
postOrder : HashMap String (List String) -> List (String, List String) -> List String -> (Bool, List String)
postOrder gT g nodes =
  let
    post = dfsAll nodes (graphFuel g nodes) gT (HashMap.fromList []) []
  in (length post == length nodes, post)

collectComp : List String -> Int -> HashMap String (List String) -> HashMap String Bool -> List String -> (HashMap String Bool, List String, Bool)
-- 耗尽：comp 只是前缀，不能当成完整分量。
collectComp [] fuel rg assigned comp = (assigned, comp, True)
collectComp (m :: rest) fuel rg assigned comp =
  if fuel <= 0 then
    (assigned, comp, False)
  else if HashMap.member m assigned then
    collectComp rest (fuel - 1) rg assigned comp
  else
    collectComp
      (append (adjOf m rg) rest)
      (fuel - 1)
      rg
      (HashMap.insert m True assigned)
      (m :: comp)

-- | `Pair ok comps`：`ok = False` 表示某个分量被 fuel 截断。
sccOf : List String -> Int -> HashMap String (List String) -> HashMap String Bool -> List (List String) -> (Bool, List (List String))
sccOf [] fuel rg assigned comps = (True, comps)
sccOf (n :: rest) fuel rg assigned comps =
  if fuel <= 0 then
    (False, comps)
  else if HashMap.member n assigned then
    sccOf rest (fuel - 1) rg assigned comps
  else
    case collectComp [n] (fuel - 1) rg assigned [] of
      (assigned2, comp, ok) =>
        case ok of
          False => (False, comp :: comps)
          True => sccOf rest (fuel - 1) rg assigned2 (comp :: comps)

strWalk : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Expr -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalk fuel comp ctors projs p sizes caller facts region e acc =
  if fuel <= 0 then
    markInvalid acc
  else
    case e of
      EApp fn args sp => strWalkEApp (fuel - 1) comp ctors projs p sizes caller facts region fn args sp acc
      ECase scrut alts sp => strWalkAlts (fuel - 1) comp ctors projs p sizes caller facts region scrut alts (strWalk (fuel - 1) comp ctors projs p sizes caller facts region scrut acc)
      EIf c t el sp =>
        let
          acc1 = strWalk (fuel - 1) comp ctors projs p sizes caller facts region c acc
          acc2 = strWalk (fuel - 1) comp ctors projs p sizes caller facts (append (guardThenPosVars c) region) t acc1
        in strWalk (fuel - 1) comp ctors projs p sizes caller facts (append (guardElsePosVars c) region) el acc2
      ELam ns b sp => strWalk (fuel - 1) comp ctors projs p sizes caller facts region b acc
      ELet binds body rec_ sp =>
        let
          sizes2 = extendByBinds projs binds sizes
        in strWalk (fuel - 1) comp ctors projs p sizes2 caller facts region body (strWalkBinds (fuel - 1) comp ctors projs p sizes caller facts region binds acc)
      EPi n implicit _ dom cod sp => strWalk (fuel - 1) comp ctors projs p sizes caller facts region cod (strWalk (fuel - 1) comp ctors projs p sizes caller facts region dom acc)
      EField base f sp => strWalk (fuel - 1) comp ctors projs p sizes caller facts region base acc
      ERecord rn fields sp => strWalkFields (fuel - 1) comp ctors projs p sizes caller facts region fields acc
      ERecUpdate base fields sp => strWalkFields (fuel - 1) comp ctors projs p sizes caller facts region fields (strWalk (fuel - 1) comp ctors projs p sizes caller facts region base acc)
      EDo stmts sp => strWalkStmts (fuel - 1) comp ctors projs p sizes caller facts region stmts acc
      EAnn value ty sp => strWalk (fuel - 1) comp ctors projs p sizes caller facts region ty (strWalk (fuel - 1) comp ctors projs p sizes caller facts region value acc)
      -- where/let 多 clause 局部函数的每个 clause body 都要进 STR 遍历（body 里可能
      -- 调用外层递归函数，兜底跳过会漏检）。借用 `strWalkBinds`（参数表与 `strWalk`
      -- 完全一致，SCT 可证下降）；模式列表只用来定位，不参与 STR。
      ELocalFun clauses sp => strWalkBinds (fuel - 1) comp ctors projs p sizes caller facts region (localClauseBinds clauses) acc
      EVar n sp => if memName (rnameKey n) comp then markInvalid acc else acc
      _ => acc

-- 关系证不出来时记一条诊断边：位置 p 的实参为什么拿不到尺寸关系。
hintEdge : String -> String -> Int -> List Expr -> List String -> List (String, Int, Int, List Int) -> Span -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
hintEdge caller callee p args ctors sizes sp acc =
  case argRelHint p args sizes ctors of
    Nothing => acc
    Just m => addEdgeMode caller callee m sp acc

strWalkEApp : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Expr -> List Expr -> Span -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkEApp fuel comp ctors projs p sizes caller facts region fn args sp acc =
  if fuel <= 0 then
    markInvalid acc
  else
    case groupHead comp fn of
      Just callee =>
        case argRel p args sizes ctors projs caller facts region of
          Nothing => markInvalid (strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args (hintEdge caller callee p args ctors sizes sp acc))
          Just rel => strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args (addEdgeMode caller callee rel sp acc)
      Nothing =>
        case fn of
          EVar nm nsp =>
            case hofSpecOf nm of
              Just spec =>
                case hofLambdaCall spec args of
                  Just hc =>
                    let
                      acc1 = strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region hc.hofSideArgs acc
                      sizes2 = extendElemSizes sizes hc.hofListExpr hc.hofElemBinder
                    in strWalk (fuel - 1) comp ctors projs p sizes2 caller facts region hc.hofBody acc1
                  Nothing => if spec.hofLambdaArity == 1 then strWalkEAppMap (fuel - 1) comp ctors projs p sizes caller facts region fn args acc else strWalkApp (fuel - 1) comp ctors projs p sizes caller facts region fn args acc
              Nothing => strWalkApp (fuel - 1) comp ctors projs p sizes caller facts region fn args acc
          _ => strWalkApp (fuel - 1) comp ctors projs p sizes caller facts region fn args acc

strWalkEAppMap : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Expr -> List Expr -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkEAppMap fuel comp ctors projs p sizes caller facts region fn args acc =
  if fuel <= 0 then
    markInvalid acc
  else
    case args of
      [cb, lst] =>
        case cb of
          EApp (EVar g gsp) pargs cbsp => if memName (rnameKey g) comp then strWalkMapPartialInline (fuel - 1) comp ctors projs p sizes caller facts region (rnameKey g) pargs lst cbsp acc else strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc
          EVar g gsp => if memName (rnameKey g) comp then strWalkMapPartialInline (fuel - 1) comp ctors projs p sizes caller facts region (rnameKey g) [] lst gsp acc else strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc
          _ => strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc
      _ => strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc

strWalkMapPartialInline : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> String -> List Expr -> Expr -> Span -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkMapPartialInline fuel comp ctors projs p sizes caller facts region g pargs lst cbsp acc =
  if fuel <= 0 then
    markInvalid acc
  else
    let
      acc1 = strWalk (fuel - 1) comp ctors projs p sizes caller facts region lst acc
      elems = extendElemSizes sizes lst "$elem"
      fullArgs = append pargs [EVar (classifyName "$elem") cbsp]
      acc2 = strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region pargs acc1
    in case argRel p fullArgs elems ctors projs caller facts region of
      Nothing => markInvalid acc2
      Just rel => addEdgeMode caller g rel cbsp acc2

strWalkApp : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Expr -> List Expr -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkApp fuel comp ctors projs p sizes caller facts region fn args acc =
  if fuel <= 0 then
    markInvalid acc
  else
    strWalkArgs
      (fuel - 1)
      comp
      ctors
      projs
      p
      sizes
      caller
      facts
      region
      args
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region fn acc)

strWalkArgs : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> List Expr -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkArgs fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkArgs fuel comp ctors projs p sizes caller facts region (a :: rest) acc =
  if fuel <= 0 then
    markInvalid acc
  else
    strWalkArgs
      (fuel - 1)
      comp
      ctors
      projs
      p
      sizes
      caller
      facts
      region
      rest
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region a acc)

strWalkAlts : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Expr -> List (Pat, Expr) -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkAlts fuel comp ctors projs p sizes caller facts region scrut [] acc =
  if fuel <= 0 then acc else acc
strWalkAlts fuel comp ctors projs p sizes caller facts region scrut ((pat, body) :: rest) acc =
  if fuel <= 0 then
    markInvalid acc
  else
    strWalkAlts
      (fuel - 1)
      comp
      ctors
      projs
      p
      sizes
      caller
      facts
      region
      scrut
      rest
      (strWalk (fuel - 1) comp ctors projs p (extendSizesStrict projs sizes scrut pat) caller facts region body acc)

strWalkBinds : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> List (Pat, Expr) -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkBinds fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkBinds fuel comp ctors projs p sizes caller facts region ((pat, val) :: rest) acc =
  if fuel <= 0 then
    markInvalid acc
  else
    strWalkBinds
      (fuel - 1)
      comp
      ctors
      projs
      p
      (extendSizesStrict projs sizes val pat)
      caller
      facts
      region
      rest
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region val acc)

strWalkFields : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> List (String, Expr) -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkFields fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkFields fuel comp ctors projs p sizes caller facts region ((fn, fe) :: rest) acc =
  if fuel <= 0 then
    markInvalid acc
  else
    strWalkFields
      (fuel - 1)
      comp
      ctors
      projs
      p
      sizes
      caller
      facts
      region
      rest
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region fe acc)

strWalkStmts : Int -> List String -> List String -> List (String, List Int) -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> List DoStmt -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
strWalkStmts fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkStmts fuel comp ctors projs p sizes caller facts region (s :: rest) acc =
  if fuel <= 0 then
    markInvalid acc
  else
    case s of
      DBind pat e sp => strWalkStmts (fuel - 1) comp ctors projs p (extendSizesStrict projs sizes e pat) caller facts region rest (strWalk (fuel - 1) comp ctors projs p sizes caller facts region e acc)
      DExpr e sp => strWalkStmts (fuel - 1) comp ctors projs p sizes caller facts region rest (strWalk (fuel - 1) comp ctors projs p sizes caller facts region e acc)
      DLet binds sp => strWalkStmts (fuel - 1) comp ctors projs p (extendByBinds projs binds sizes) caller facts region rest (strWalkBinds (fuel - 1) comp ctors projs p sizes caller facts region binds acc)

strClause : List String -> List String -> List (String, List Int) -> Int -> String -> HashMap String (List Int) -> (List Pat, Expr) -> (Bool, List (((String, String), Int), Span))
strClause comp ctors projs p caller facts clause =
  strWalk
    (exprBudget 32 (secondOf clause))
    comp
    ctors
    projs
    p
    (strSizeEntries (firstOf clause))
    caller
    facts
    []
    (secondOf clause)
    (True, [])

-- 终止性失败的描述（<0>）：两种措辞（单函数 / 递归组）统一到 arity 1 的
-- `CannotProveTermination`，描述里保留单函数 / 递归组的区分信息。
groupMessage : List String -> String
groupMessage ([f]) = "${f} (recursive call does not structurally decrease)"
groupMessage comp =
  "recursive group {${joinComma comp}} (mutual recursion: no parameter position decreases on every recursive call)"

-- | 终止性失败诊断（附调用边 + 被检查的形参位置）。
cannotProveMsgEdges : List String -> Int -> List (((String, String), Int), Span) -> Diagnostic
cannotProveMsgEdges comp p edges =
  let
    desc = groupMessage comp
    base = tcMsg (CannotProveTermination desc) [desc]
  in applyCallFields p edges (
      case edges of
        [] => withAbsent NsSynthetic base
        (_, sp) :: _ => withFallbackSpan sp base
    )

-- | 把调用边逐条挂到诊断 fields.call：位置是被测的形参下标，关系按编号渲染。
applyCallFields : Int -> List (((String, String), Int), Span) -> Diagnostic -> Diagnostic
applyCallFields p [] d = d
applyCallFields p ((((caller, callee), rel), sp) :: rest) d =
  applyCallFields
    p
    rest
    (withField (FieldCall (CallInfo callee "argument ${strFromInt p}" (relText rel) (Just sp))) d)

collectClauses : List (List Pat, Expr) -> List String -> List String -> List (String, List Int) -> Int -> String -> HashMap String (List Int) -> (Bool, List (((String, String), Int), Span)) -> Check (Bool, List (((String, String), Int), Span))
collectClauses [] comp ctors projs p caller facts acc = OkC acc
collectClauses (cl :: rest) comp ctors projs p caller facts acc =
  case firstOf acc of
    False => OkC acc
    True =>
      case strClause comp ctors projs p caller facts cl of
        (True, edges) =>
          collectClauses rest comp ctors projs p caller facts (True, append (secondOf acc) edges)
        (False, edges) => OkC (False, append (secondOf acc) edges)

collectMeasure : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> Int -> HashMap String (List Int) -> List String -> (Bool, List (((String, String), Int), Span)) -> Check (Bool, List (((String, String), Int), Span))
collectMeasure comp defTbl ctors projs p facts [] acc = OkC acc
collectMeasure comp defTbl ctors projs p facts (n :: rest) acc =
  Vuna.Compiler.Base.Common.bind
    (collectClauses (clausesOfDefTbl n defTbl) comp ctors projs p n facts acc)
    (\acc2 => collectMeasure comp defTbl ctors projs p facts rest acc2)

-- | 失败诊断的候选：越可操作越优先（缺非负证明 > 无尺寸来源 > 别的形参 > 无关系）。
record FailCandidate where
  fcRank : Int
  fcPos : Int
  fcEdges : List (((String, String), Int), Span)

emptyFail : Int -> FailCandidate
emptyFail p = FailCandidate 0 p []

-- | 诊断边 → 可操作程度：正数是「已证出的关系」，不参与排序。
hintRankOf : Int -> Int
hintRankOf m =
  if m == relMissingGuard then
    4
  else if m == relAscending then
    4
  else if m == relUnknownSize then
    3
  else if m == relOtherPosition then 2 else if m == relNoRelation then 1 else 0

edgeRankOf : (((String, String), Int), Span) -> Int
edgeRankOf (((c, g), m), sp) = hintRankOf m

edgesRankOf : List (((String, String), Int), Span) -> Int
edgesRankOf [] = 0
edgesRankOf (e :: rest) = maxInt (edgeRankOf e) (edgesRankOf rest)

betterFail : Int -> List (((String, String), Int), Span) -> FailCandidate -> FailCandidate
betterFail p edges best =
  let
    rank = edgesRankOf edges
  in if rank > best.fcRank then FailCandidate rank p edges else best

-- 同一对 (caller, callee) 的所有调用点都非零 ⇒ 该边严格。
tryMeasure : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Int -> Int -> Check Int
tryMeasure comp defTbl ctors projs facts p maxP =
  tryMeasureGo comp defTbl ctors projs facts (maxP - p) maxP p [] (emptyFail p)

tryMeasureGo : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Int -> Int -> Int -> List (((String, String), Int), Span) -> FailCandidate -> Check Int
tryMeasureGo comp defTbl ctors projs facts remaining maxP lastP lastEdges best =
  if remaining <= 0 then
    if best.fcRank > 0 then ErrC (cannotProveMsgEdges comp best.fcPos best.fcEdges) else ErrC (cannotProveMsgEdges comp lastP lastEdges)
  else
    let
      p = maxP - remaining
    in case collectMeasure comp defTbl ctors projs p facts comp (True, []) of
      ErrC e => ErrC e
      OkC (valid, edges) =>
        if valid then
          let
            modes = filterModes (map callMode edges)
          in if notEmpty modes then if allSame modes then if hasWeakCycle comp edges then tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges best else OkC 0 else tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges best else tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges best
        else
          tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges (betterFail p edges best)

checkStrictGroup : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> List (String, Int) -> Check Int
checkStrictGroup comp defTbl ctors projs facts =
  let
    factsTbl = posTblOf facts
  in case tryMeasure comp defTbl ctors projs factsTbl 0 (maxArityOf comp defTbl) of
    OkC n => OkC n
    ErrC e =>
      case tryFuelThread comp defTbl ctors projs factsTbl e of
        OkC n => OkC n
        ErrC e2 => sctCheck comp defTbl ctors projs factsTbl e2

checkComp : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List String) -> List (String, Int) -> Check Int
checkComp [] defTbl ctors projs g facts = OkC 0
checkComp (comp@([f])) defTbl ctors projs g facts =
  if memName f (adjOf f g) then checkStrictGroup comp defTbl ctors projs facts else OkC 0
checkComp comp defTbl ctors projs g facts = checkStrictGroup comp defTbl ctors projs facts

-- worklist 不动点——首轮扫所有有出边的 caller，之后只重扫「新 facts 的 callee 的
-- callers」；每轮全量扫描所有 defs 是 check 的最大热点。
computePosFactsWork : List String -> HashMap String (List (List Pat, Expr)) -> HashMap String (List String) -> Int -> List (String, Int) -> List String -> List (String, Int)
computePosFactsWork names defTbl rgT fuel facts work =
  if fuel <= 0 then
    facts
  else
    let
      namesTbl = HashMap.ofNames names
      scan = posScanNames namesTbl defTbl (posTblOf facts) work ([], [])
      fresh = posFilterTbl (firstOf scan) (posTblOf (secondOf scan))
      newFacts = posFilterTbl fresh (posTblOf facts)
      merged = posUnionTbl facts fresh
      nextWork = dedup (concatMap (\n => adjOf n rgT) (map firstOf newFacts))
    in case nextWork of
      [] => merged
      _ => computePosFactsWork names defTbl rgT (fuel - 1) merged nextWork

-- 只报告 own 里定义的函数的终止性失败；其余（依赖包已在自己 check 里验过）只作为
-- 分析上下文参与 SCT（跨包调用/投影/构造子关系需要它们的子句）。全量路径 own = 全部名字。
export checkTerminationDecls : List Decl -> Check Int
checkTerminationDecls decls = checkTerminationDeclsWith (dfunNames decls) decls

dfunNames : List Decl -> List String
dfunNames [] = []
dfunNames (d :: rest) =
  case d of
    DFun name pats body sp => name :: dfunNames rest
    DInstance ctx head methods sp => append (dfunNames methods) (dfunNames rest)
    _ => dfunNames rest

export checkTerminationDeclsWith : List String -> List Decl -> Check Int
checkTerminationDeclsWith own decls = checkTerminationGroups own decls [] decls

-- | 精化后路径：`ownDecls` 由 `Termination.ElabInput` 从 `DtProgram` 构造（调用名已规范、
--   实例方法按字典符号分组），`depDecls` 是依赖包的 Rast 声明（只作 SCT 上下文；
--   包依赖无环，不会引入跨包环），`tableDecls` 提供构造子 / 记录字段表。
export checkTerminationGroups : List String -> List Decl -> List Decl -> List Decl -> Check Int
checkTerminationGroups own ownDecls depDecls tableDecls =
  let
    -- 转发器调用先归约成直接调用（`apply f x` → `f x`），三套分析共用改写后的体。
    allDecls = append depDecls ownDecls
    resolved = expandForwarders allDecls
    defs = groupDefs resolved
    defTbl = HashMap.fromList defs
    ctors = ctorNamesOf (append depDecls tableDecls)
    projs = append (projectionsOf defs) (fieldProjectionsOf (append depDecls tableDecls))
    g = callGraph defs
    gT = adjTblOf g
    nodes = defNames defs
    rgT = reverseAdjOf g
    callerNames = filter (\n => notEmpty (adjOf n gT)) nodes
    facts = computePosFactsWork nodes defTbl rgT 1024 [] callerNames
    -- own 只建一次哈希表，逐 SCC 的 own 判定是 O(1) 查表（逐 SCC 线性扫是 O(n²)）。
    ownTbl = HashMap.ofNames own
    _ = log! "debug" "term-facts"
    fuel = graphFuel g nodes
    postR = postOrder gT g nodes
    compsR = sccOf (secondOf postR) fuel rgT (HashMap.fromList []) []
  in case firstOf postR of
    False => icFuel "termination-scc"
    True =>
      case firstOf compsR of
        False => icFuel "termination-scc"
        True => checkSccsWith ownTbl (reverse (secondOf compsR)) defTbl ctors projs gT facts

anyOwnTbl : HashMap String Bool -> List String -> Bool
anyOwnTbl ownTbl [] = False
anyOwnTbl ownTbl (n :: rest) = if HashMap.member n ownTbl then True else anyOwnTbl ownTbl rest

checkSccsWith : HashMap String Bool -> List (List String) -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List String) -> List (String, Int) -> Check Int
checkSccsWith ownTbl [] defTbl ctors projs g facts = OkC 0
checkSccsWith ownTbl (comp :: rest) defTbl ctors projs g facts =
  if anyOwnTbl ownTbl comp then
    Vuna.Compiler.Base.Common.bind
      (checkComp comp defTbl ctors projs g facts)
      (\n => Vuna.Compiler.Base.Common.bind (checkSccsWith ownTbl rest defTbl ctors projs g facts) (\m => OkC (n + m)))
  else
    checkSccsWith ownTbl rest defTbl ctors projs g facts

-- | 取调用边的参数关系编号。
callMode : (((String, String), Int), Span) -> Int
callMode (((caller, callee), mode), sp) = mode
