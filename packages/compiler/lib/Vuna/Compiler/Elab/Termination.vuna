module Vuna.Compiler.Elab.Termination where

-- Vuna.Compiler.Elab.Termination：DT 终止性检查入口。
-- 判据细节见 `.Measure`（size/守卫正事实/投影/关系/弱环）与 `.Scc`（size-change）。
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.AstWalk
import Vuna.Compiler.Frontend.Name
import Vuna.Compiler.Elab.Termination.Measure
import Vuna.Compiler.Elab.Termination.Scc
import Vuna.Compiler.Elab.Termination.Walk
import Vuna.Compiler.Frontend.AstQuery

patsNames : List Pat -> List String
patsNames ps = concatMap patBinders ps

altPatOf : Alt -> Pat
altPatOf a = a.altPat

altBodyOf : Alt -> Expr
altBodyOf a = a.altBody

stmtBinderNames : DoStmt -> List String
stmtBinderNames (DBind pat e sp) = patBinders pat
stmtBinderNames (DExpr e sp) = []
stmtBinderNames (DLet binds sp) = concatMap bindingPatNames binds

stmtRefsF : Int -> List String -> DoStmt -> List String
stmtRefsF fuel bound (DBind pat e sp) = exprRefsBF (fuel - 1) bound e
stmtRefsF fuel bound (DExpr e sp) = exprRefsBF (fuel - 1) bound e
stmtRefsF fuel bound (DLet binds sp) = exprRefsBindsF (fuel - 1) bound binds

refsOfStmtsF : Int -> List String -> List DoStmt -> List String
refsOfStmtsF fuel bound [] = []
refsOfStmtsF fuel bound (st :: rest) =
  if fuel <= 0 then
    []
  else
    append
      (stmtRefsF (fuel - 1) bound st)
      (refsOfStmtsF (fuel - 1) (append (stmtBinderNames st) bound) rest)

exprRefsB : List String -> Expr -> List String
exprRefsB bound e = exprRefsBF (exprBudget 64 e) bound e

exprRefsBF : Int -> List String -> Expr -> List String
exprRefsBF fuel bound e =
  if fuel <= 0 then
    []
  else
    case e of
      EVar n sp => if memName (n) bound then [] else [n]
      EInt n sp => []
      EStr s sp => []
      ELam ns b sp => exprRefsBF (fuel - 1) (append (map firstOf ns) bound) b
      EApp fn args sp => append (exprRefsBF (fuel - 1) bound fn) (concatMap (exprRefsBF (fuel - 1) bound) args)
      EPi n implicit _ dom cod sp => append (exprRefsBF (fuel - 1) bound dom) (exprRefsBF (fuel - 1) (n :: bound) cod)
      ELet binds b rec_ sp => append (exprRefsBindsF (fuel - 1) bound binds) (exprRefsBF (fuel - 1) (append (concatMap bindingBinderNames binds) bound) b)
      ECase scrut alts sp => append (exprRefsBF (fuel - 1) bound scrut) (concatMap (\alt => exprRefsBF (fuel - 1) (append (patBinders (altPatOf alt)) bound) (altBodyOf alt)) alts)
      EIf c t el sp => append (exprRefsBF (fuel - 1) bound c) (append (exprRefsBF (fuel - 1) bound t) (exprRefsBF (fuel - 1) bound el))
      EField base f sp => exprRefsBF (fuel - 1) bound base
      ERecord rn fields sp => concatMap (\q => exprRefsBF (fuel - 1) bound (secondOf q)) fields
      ERecUpdate base fields sp => append (exprRefsBF (fuel - 1) bound base) (concatMap (\q => exprRefsBF (fuel - 1) bound (secondOf q)) fields)
      EDo stmts sp => refsOfStmtsF (fuel - 1) bound stmts
      _ => []

exprRefsBindsF : Int -> List String -> List Binding -> List String
exprRefsBindsF fuel bound [] = []
exprRefsBindsF fuel bound (b :: rest) =
  if fuel <= 0 then
    []
  else
    append (exprRefsBindingF (fuel - 1) bound b) (exprRefsBindsF (fuel - 1) bound rest)

exprRefsBindingF : Int -> List String -> Binding -> List String
exprRefsBindingF fuel bound (Binding pat value sig ref) =
  if fuel <= 0 then
    []
  else
    append (
        case value of
          BVal e => exprRefsBF (fuel - 1) bound e
          BClauses cs => exprRefsClausesF (fuel - 1) bound cs
      ) (
        case sig of
          Just s => exprRefsBF (fuel - 1) bound s.sigType
          Nothing => []
      )

exprRefsClausesF : Int -> List String -> List LocalClause -> List String
exprRefsClausesF fuel bound [] = []
exprRefsClausesF fuel bound (c :: rest) =
  if fuel <= 0 then
    []
  else
    append
      (exprRefsBF (fuel - 1) (append (patsNames c.lcPats) bound) c.lcBody)
      (exprRefsClausesF (fuel - 1) bound rest)

bindingPatNames : Binding -> List String
bindingPatNames b = patBinders b.bindPat

bindingBinderNames : Binding -> List String
bindingBinderNames b = patBinders b.bindPat

refsOfDef : List (List Pat, Expr) -> List String
refsOfDef clauses = dedup (concatMap (\c => exprRefsB (patsNames (firstOf c)) (secondOf c)) clauses)

mapEdges : HashMap String Bool -> List (String, List (List Pat, Expr)) -> List (String, List String)
mapEdges names [] = []
mapEdges names (d :: rest) =
  (firstOf d, filter (\r => HashMap.member r names) (refsOfDef (secondOf d))) :: mapEdges names rest

callGraph : List (String, List (List Pat, Expr)) -> List (String, List String)
callGraph defs = mapEdges (HashMap.ofNames (defNames defs)) defs

adjOf : String -> HashMap String (List String) -> List String
adjOf n g =
  case HashMap.lookup n g of
    Just xs => xs
    Nothing => []

adjTblOf : List (String, List String) -> HashMap String (List String)
adjTblOf g = HashMap.insertAll g (HashMap.fromList [])

-- 反向邻接表：一次遍历建哈希表（逐边 lookup/replace 转置是 O(#边 × #节点)）。
reverseAdjOf : List (String, List String) -> HashMap String (List String)
reverseAdjOf [] = HashMap.fromList []
reverseAdjOf ((src, dsts) :: rest) = addSrcs src dsts (reverseAdjOf rest)

addSrcs : String -> List String -> HashMap String (List String) -> HashMap String (List String)
addSrcs src [] t = t
addSrcs src (dst :: ds) t =
  let
    cur =
      case HashMap.lookup dst t of
        Just xs => xs
        Nothing => []
  in addSrcs src ds (HashMap.insert dst ((::) src cur) t)

replacePair : String -> List String -> List (String, List String) -> List (String, List String)
replacePair n v [] = []
replacePair n v ((k, xs) :: rest) =
  if k == n then (::) (n, v) rest else (::) (k, xs) (replacePair n v rest)

addEdge : String -> String -> List (String, List String) -> List (String, List String)
-- 注意：这里**不做 dedup**。每个新边都对已累积的依赖表 dedup 是 O(k²)（高扇入
-- 时合计 O(k³)）；去重挪到 transpose 结束后整表做一次（dedupTransposed）。
addEdge n m acc =
  case lookupPair n acc of
    Just xs => replacePair n (m :: xs) acc
    Nothing => (n, [m]) :: acc

addEdges : String -> List String -> List (String, List String) -> List (String, List String)
addEdges src [] a = a
addEdges src (d :: ds) a = addEdges src ds (addEdge d src a)

transposeGo : List (String, List String) -> List (String, List String) -> List (String, List String)
transposeGo [] acc = acc
transposeGo ((src, dsts) :: rest) acc = transposeGo rest (addEdges src dsts acc)

transpose : List (String, List String) -> List (String, List String)
transpose g = dedupTransposed (transposeGo g [])

dedupTransposed : List (String, List String) -> List (String, List String)
dedupTransposed [] = []
dedupTransposed ((n, xs) :: rest) = (n, dedup xs) :: dedupTransposed rest

edgeCount : List (String, List String) -> Int
edgeCount [] = 0
edgeCount ((n, ds) :: rest) = length ds + edgeCount rest

graphFuel : List (String, List String) -> List String -> Int
graphFuel g nodes = 4 * length nodes + 4 * edgeCount g + 16

-- 迭代 DFS 后序：steps 里 (n, False) = 访问，(n, True) = 发射。
dfsPost : List (String, Bool) -> Int -> HashMap String (List String) -> HashMap String Bool -> List String -> (HashMap String Bool, List String)
dfsPost steps fuel g visited post =
  if fuel <= 0 then
    (visited, post)
  else
    case steps of
      [] => (visited, post)
      (n, True) :: rest => dfsPost rest (fuel - 1) g visited (n :: post)
      (n, False) :: rest => if HashMap.member n visited then dfsPost rest (fuel - 1) g visited post else dfsPost (append (map (\m => (m, False)) (adjOf n g)) ((n, True) :: rest)) (fuel - 1) g (HashMap.insert n True visited) post

dfsAll : List String -> Int -> HashMap String (List String) -> HashMap String Bool -> List String -> List String
dfsAll [] fuel g visited post = post
dfsAll (n :: rest) fuel g visited post =
  if fuel <= 0 then
    post
  else if HashMap.member n visited then
    dfsAll rest (fuel - 1) g visited post
  else
    case dfsPost [(n, False)] fuel g visited post of
      (v2, p2) => dfsAll rest (fuel - 1) g v2 p2

-- | `Pair ok post`：`ok = False` = DFS 未发射全部节点（fuel 耗尽）。
postOrder : HashMap String (List String) -> List (String, List String) -> List String -> (Bool, List String)
postOrder gT g nodes =
  let
    post = dfsAll nodes (graphFuel g nodes) gT (HashMap.fromList []) []
  in (length post == length nodes, post)

collectComp : List String -> Int -> HashMap String (List String) -> HashMap String Bool -> List String -> (HashMap String Bool, List String, Bool)
-- 耗尽：comp 只是前缀，不能当成完整分量。
collectComp [] fuel rg assigned comp = (assigned, comp, True)
collectComp (m :: rest) fuel rg assigned comp =
  if fuel <= 0 then
    (assigned, comp, False)
  else if HashMap.member m assigned then
    collectComp rest (fuel - 1) rg assigned comp
  else
    collectComp
      (append (adjOf m rg) rest)
      (fuel - 1)
      rg
      (HashMap.insert m True assigned)
      (m :: comp)

-- | `Pair ok comps`：`ok = False` 表示某个分量被 fuel 截断。
sccOf : List String -> Int -> HashMap String (List String) -> HashMap String Bool -> List (List String) -> (Bool, List (List String))
sccOf [] fuel rg assigned comps = (True, comps)
sccOf (n :: rest) fuel rg assigned comps =
  if fuel <= 0 then
    (False, comps)
  else if HashMap.member n assigned then
    sccOf rest (fuel - 1) rg assigned comps
  else
    case collectComp [n] (fuel - 1) rg assigned [] of
      (assigned2, comp, ok) =>
        case ok of
          False => (False, comp :: comps)
          True => sccOf rest (fuel - 1) rg assigned2 (comp :: comps)

-- 终止性失败的描述（<0>）：两种措辞（单函数 / 递归组）统一到 arity 1 的
-- `CannotProveTermination`，描述里保留单函数 / 递归组的区分信息。
groupMessage : List String -> String
groupMessage [f] = "${f} (recursive call does not structurally decrease)"
groupMessage comp =
  "recursive group {${joinComma comp}} (mutual recursion: no parameter position decreases on every recursive call)"

-- | 终止性失败诊断（附调用边 + 被检查的形参位置）。
cannotProveMsgEdges : List String -> Int -> List (((String, String), Int), Span) -> Diagnostic
cannotProveMsgEdges comp p edges =
  let
    desc = groupMessage comp
    base = tcMsg (CannotProveTermination desc) [desc]
  in applyCallFields p edges (
      case edges of
        [] => withAbsent NsSynthetic base
        (_, sp) :: _ => withFallbackSpan sp base
    )

-- | 把调用边逐条挂到诊断 fields.call：位置是被测的形参下标，关系按编号渲染。
applyCallFields : Int -> List (((String, String), Int), Span) -> Diagnostic -> Diagnostic
applyCallFields p [] d = d
applyCallFields p ((((caller, callee), rel), sp) :: rest) d =
  applyCallFields
    p
    rest
    (withField (FieldCall (CallInfo callee "argument ${strFromInt p}" (relText rel) (Just sp))) d)

collectClauses : List (List Pat, Expr) -> List String -> List String -> List (String, List Int) -> Int -> String -> HashMap String (List Int) -> (Bool, List (((String, String), Int), Span)) -> Check (Bool, List (((String, String), Int), Span))
collectClauses [] comp ctors projs p caller facts acc = OkC acc
collectClauses (cl :: rest) comp ctors projs p caller facts acc =
  case firstOf acc of
    False => OkC acc
    True =>
      case strClause comp ctors projs p caller facts cl of
        (True, edges) =>
          collectClauses rest comp ctors projs p caller facts (True, append (secondOf acc) edges)
        (False, edges) => OkC (False, append (secondOf acc) edges)

collectMeasure : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> Int -> HashMap String (List Int) -> List String -> (Bool, List (((String, String), Int), Span)) -> Check (Bool, List (((String, String), Int), Span))
collectMeasure comp defTbl ctors projs p facts [] acc = OkC acc
collectMeasure comp defTbl ctors projs p facts (n :: rest) acc =
  Vuna.Compiler.Base.Common.bind
    (collectClauses (clausesOfDefTbl n defTbl) comp ctors projs p n facts acc)
    (\acc2 => collectMeasure comp defTbl ctors projs p facts rest acc2)

-- | 失败诊断的候选：越可操作越优先（缺非负证明 > 无尺寸来源 > 别的形参 > 无关系）。
record FailCandidate where
  fcRank : Int
  fcPos : Int
  fcEdges : List (((String, String), Int), Span)

emptyFail : Int -> FailCandidate
emptyFail p = FailCandidate 0 p []

-- | 诊断边 → 可操作程度：正数是「已证出的关系」，不参与排序。
hintRankOf : Int -> Int
hintRankOf m =
  if m == relMissingGuard then
    4
  else if m == relAscending then
    4
  else if m == relUnknownSize then
    3
  else if m == relOtherPosition then 2 else if m == relNoRelation then 1 else 0

edgeRankOf : (((String, String), Int), Span) -> Int
edgeRankOf (((c, g), m), sp) = hintRankOf m

edgesRankOf : List (((String, String), Int), Span) -> Int
edgesRankOf [] = 0
edgesRankOf (e :: rest) = maxInt (edgeRankOf e) (edgesRankOf rest)

betterFail : Int -> List (((String, String), Int), Span) -> FailCandidate -> FailCandidate
betterFail p edges best =
  let
    rank = edgesRankOf edges
  in if rank > best.fcRank then FailCandidate rank p edges else best

-- 同一对 (caller, callee) 的所有调用点都非零 ⇒ 该边严格。
tryMeasure : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Int -> Int -> Check Int
tryMeasure comp defTbl ctors projs facts p maxP =
  tryMeasureGo comp defTbl ctors projs facts (maxP - p) maxP p [] (emptyFail p) NoGiveUp

-- `gaveUp` 只累积、不提前退出：后面的测度位置仍可能证出终止；全部位置失败后才把
-- 「放弃」渲染成预算耗尽。
tryMeasureGo : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Int -> Int -> Int -> List (((String, String), Int), Span) -> FailCandidate -> GiveUp -> Check Int
tryMeasureGo comp defTbl ctors projs facts remaining maxP lastP lastEdges best gaveUp =
  if remaining <= 0 then
    let
      base = if best.fcRank > 0 then cannotProveMsgEdges comp best.fcPos best.fcEdges else cannotProveMsgEdges comp lastP lastEdges
    in if isGaveUp gaveUp then ErrC (gaveUpDiagnostic (joinComma comp) (gaveUpDetail gaveUp) base) else ErrC base
  else
    let
      p = maxP - remaining
    in case collectMeasure comp defTbl ctors projs p facts comp (True, []) of
      ErrC e => ErrC e
      OkC (valid, edges) =>
        if valid then
          let
            modes = filterModes (map callMode edges)
          in if notEmpty modes then
            if allSame modes then
              case hasWeakCycle comp edges of
                (cyc, g) => if isGaveUp g then tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges best (mergeGiveUp gaveUp g) else if cyc then tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges best gaveUp else OkC 0
            else
              tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges best gaveUp
          else
            tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges best gaveUp
        else
          tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP p edges (betterFail p edges best) gaveUp

checkStrictGroup : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> List (String, Int) -> Check Int
checkStrictGroup comp defTbl ctors projs facts =
  let
    factsTbl = posTblOf facts
  in case tryMeasure comp defTbl ctors projs factsTbl 0 (maxArityOf comp defTbl) of
    OkC n => OkC n
    ErrC e =>
      case tryFuelThread comp defTbl ctors projs factsTbl e of
        OkC n => OkC n
        ErrC e2 => sctCheck comp defTbl ctors projs factsTbl e2

checkComp : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List String) -> List (String, Int) -> Check Int
checkComp [] defTbl ctors projs g facts = OkC 0
checkComp (comp@[f]) defTbl ctors projs g facts =
  if memName f (adjOf f g) then checkStrictGroup comp defTbl ctors projs facts else OkC 0
checkComp comp defTbl ctors projs g facts = checkStrictGroup comp defTbl ctors projs facts

-- 正性事实不动点：每轮至少新增一条事实，否则直接收敛，所以 1024 只是防御上限。
posFactsFuelBound : Int
posFactsFuelBound = 1024

-- worklist 不动点——首轮扫所有有出边的 caller，之后只重扫「新 facts 的 callee 的
-- callers」；每轮全量扫描所有 defs 是 check 的最大热点。
-- 耗尽时返回**部分** facts，必须带 `GaveUp`：部分事实只可能让证明失败，不能当完整结果。
export computePosFactsWork : List String -> HashMap String (List (List Pat, Expr)) -> HashMap String (List String) -> Int -> List (String, Int) -> List String -> (List (String, Int), GiveUp)
computePosFactsWork names defTbl rgT fuel facts work =
  if fuel <= 0 then
    (facts, GaveUp "正性事实不动点未收敛（上限 ${strFromInt posFactsFuelBound} 轮）")
  else
    let
      namesTbl = HashMap.ofNames names
      scan = posScanNames namesTbl defTbl (posTblOf facts) work ([], [])
      fresh = posFilterTbl (firstOf scan) (posTblOf (secondOf scan))
      newFacts = posFilterTbl fresh (posTblOf facts)
      merged = posUnionTbl facts fresh
      nextWork = dedup (concatMap (\n => adjOf n rgT) (map firstOf newFacts))
    in case nextWork of
      [] => (merged, NoGiveUp)
      _ => computePosFactsWork names defTbl rgT (fuel - 1) merged nextWork

-- 只报告 own 里定义的函数的终止性失败；其余（依赖包已在自己 check 里验过）只作为
-- 分析上下文参与 SCT（跨包调用/投影/构造子关系需要它们的子句）。全量路径 own = 全部名字。
export checkTerminationDecls : List Decl -> Check Int
checkTerminationDecls decls = checkTerminationDeclsWith (dfunNames decls) decls

dfunNames : List Decl -> List String
dfunNames [] = []
dfunNames (d :: rest) =
  case d of
    DFun name pats body sp => name :: dfunNames rest
    DInstance ctx head methods sp => append (dfunNames methods) (dfunNames rest)
    _ => dfunNames rest

export checkTerminationDeclsWith : List String -> List Decl -> Check Int
checkTerminationDeclsWith own decls = checkTerminationGroups own decls [] decls

-- | 精化后路径：`ownDecls` 由 `Termination.ElabInput` 从 `DtProgram` 构造（调用名已规范、
--   实例方法按字典符号分组），`depDecls` 是依赖包的 Ast 声明（只作 SCT 上下文；
--   包依赖无环，不会引入跨包环），`tableDecls` 提供构造子 / 记录字段表。
export checkTerminationGroups : List String -> List Decl -> List Decl -> List Decl -> Check Int
checkTerminationGroups own ownDecls depDecls tableDecls =
  let
    -- 转发器调用先归约成直接调用（`apply f x` → `f x`），三套分析共用改写后的体。
    allDecls = append depDecls ownDecls
    resolved = expandForwarders allDecls
    defs = groupDefs resolved
    defTbl = HashMap.fromList defs
    ctors = ctorNamesOf (append depDecls tableDecls)
    projs = append (projectionsOf defs) (fieldProjectionsOf (append depDecls tableDecls))
    g = callGraph defs
    gT = adjTblOf g
    nodes = defNames defs
    rgT = reverseAdjOf g
    callerNames = filter (\n => notEmpty (adjOf n gT)) nodes
    -- own 只建一次哈希表，逐 SCC 的 own 判定是 O(1) 查表（逐 SCC 线性扫是 O(n²)）。
    ownTbl = HashMap.ofNames own
    _ = log! "debug" "term-facts"
    fuel = graphFuel g nodes
    postR = postOrder gT g nodes
    compsR = sccOf (secondOf postR) fuel rgT (HashMap.fromList []) []
  in case computePosFactsWork nodes defTbl rgT posFactsFuelBound [] callerNames of
    (facts, factsGiveUp) =>
      case firstOf postR of
        False => icFuel "termination-scc"
        True =>
          case firstOf compsR of
            False => icFuel "termination-scc"
            True =>
              checkSccsWith
                ownTbl
                (reverse (secondOf compsR))
                defTbl
                ctors
                projs
                gT
                facts
                factsGiveUp

anyOwnTbl : HashMap String Bool -> List String -> Bool
anyOwnTbl ownTbl [] = False
anyOwnTbl ownTbl (n :: rest) = if HashMap.member n ownTbl then True else anyOwnTbl ownTbl rest

checkSccsWith : HashMap String Bool -> List (List String) -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List String) -> List (String, Int) -> GiveUp -> Check Int
checkSccsWith ownTbl [] defTbl ctors projs g facts factsGiveUp = OkC 0
checkSccsWith ownTbl (comp :: rest) defTbl ctors projs g facts factsGiveUp =
  if anyOwnTbl ownTbl comp then
    case checkComp comp defTbl ctors projs g facts of
      ErrC e => ErrC (markGaveUp comp factsGiveUp e)
      OkC n => Vuna.Compiler.Base.Common.bind (checkSccsWith ownTbl rest defTbl ctors projs g facts factsGiveUp) (\m => OkC (n + m))
  else
    checkSccsWith ownTbl rest defTbl ctors projs g facts factsGiveUp

-- | 取调用边的参数关系编号。
callMode : (((String, String), Int), Span) -> Int
callMode (((caller, callee), mode), sp) = mode
