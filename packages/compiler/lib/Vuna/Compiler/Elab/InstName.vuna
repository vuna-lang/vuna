-- | 实例名派生（trait 投影/实例字典的符号名）。
module Vuna.Compiler.Elab.InstName where

-- Vuna.Compiler.Elab.InstName：实例名派生（trait 投影/实例字典的符号名）。
-- 与 `Elab.Trait` 分工：实例名的派生规则单独成模块，避免 Trait 继续膨胀。
-- 纯函数、无状态；Trait 与 Driver.SplitGen 共用 `instanceName` / `derivedInstName`。
import Vuna.Compiler.Base.Bytes
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Hash
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Frontend.Canonical.Ast
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Bridge
import Vuna.Compiler.Frontend.Rast.Name

-- | 实例定义名：**单类前缀 + 完整 head 名**（`Eq_Int`、`Eq_Base.Bool.Bool`、`Show_Box_a`）。
-- 没有命名实例（`as name`），不存在覆盖名；按「类名 + 头实参」派生是唯一规则
-- （同一模块的 `instance Functor Maybe` / `instance Monad Maybe` 名字不同）。
--
-- **类部分只取短名一次**；head 部分保留**完整限定名**：库模块里的
-- data 解析后是 `<模块>.<名字>`（`Base.Data.Bool.Bool`），入口文件里是裸名（`Bool`）。
-- 这样不同模块的同名 data（base 的 `Base.Data.Bool.Bool` 与用户自己的 `Bool`）不会生成
-- 同一个 dict 名——否则 `findInstanceClash` 的名字判重会把两个合法 head 误报成
-- duplicate。同一类内的 head 唯一性仍由 coherence 保证
-- （`anyInstanceExact` / `anyInstanceOverlap` 按 head 判定）。
export instanceName : String -> Expr -> String
instanceName cname headExpr = sanitizeInstName "${baseNameOf cname}_${derivedInstName headExpr}"

-- 实例名里的限定名（`Base.Trait.Field.Field`）带点；codegen 按名字前缀切模块时会把
-- `HasField_Base.Field` 误判成模块前缀。实例名只是内部符号，统一把点换成下划线。
-- | 实例名里的限定名带点；把点统一换成下划线，避免 codegen 按名字前缀误判模块。
sanitizeInstName : String -> String
sanitizeInstName s = join "_" (split "." s)

-- | 实例头的名字后缀（类名本身不计入，类短名已由 `instanceName` 加过一次）：
-- `Eq Int` → `Int`、`Eq Base.Data.Bool.Bool` → `Base.Data.Bool.Bool`、`Eq (Box a)` → `Box_a`。
export derivedInstName : Expr -> String
derivedInstName (EApp fn args sp) = argSuffixTail args
derivedInstName other = exprNameFor other

-- | 头实参的完整名序列（首项无前导下划线；嵌套应用递归拼）。
export argSuffixTail : List Expr -> String
argSuffixTail [] = ""
argSuffixTail (a :: rest) = exprNameFor a ++ argSuffix rest

-- | 头实参的名字序列（首项带前导下划线 `_`，用于拼接 `Eq_a_b` 形态）。
export argSuffix : List Expr -> String
argSuffix [] = ""
argSuffix (a :: rest) = "_${exprNameFor a}${argSuffix rest}"

-- | 函数类型（命名 Pi 与匿名箭头）的名字：两者定义性相等，必须同名——否则 α-等价的
-- head（`Int -> String` 与 `(n : Int) -> String`）会拿到两个名字，跨包时无人做
-- coherence 检查，同一 head 会留下两份实例。
piName : Expr -> Expr -> String
piName dom cod = "Pi_${exprNameFor dom}_${exprNameFor cod}"

-- | 类型表达式的完整名：`EVar` 直接用解析后的全名（库模块 = `<模块>.<名字>`，入口 = 裸名；
-- 不能再取最后一段，否则不同模块的同名 data 会撞名）。
--
-- 其余形状给按规范编码定址的 `?<hex>`：`?` 不会出现在标识符里，因此不会与任何合法
-- head 名相撞；规范编码不含 span，跨进程稳定（名字进 iface 摘要与 codegen 符号）。
export exprNameFor : Expr -> String
exprNameFor e =
  case e of
    EVar n sp => rnameKey n
    EInt n sp => strFromInt n
    EStr s sp => s
    EPi _ _ _ dom cod _ => piName dom cod
    EApp (EVar n nsp) args sp =>
      if rnameKey n == "->" then
        case args of
          a :: b :: _ => piName a b
          _ => "?" ++ digestHex (digestOfString (encTop encExpr (toAstExpr e)))
      else
        exprNameFor (EVar n nsp) ++ argSuffix args
    -- 参数化实例名要能区分 `Box a` / `Pair a b`（一律取同一个占位名会让 `Eq_X` 撞名）。
    EApp fn args sp => exprNameFor fn ++ argSuffix args
    other => "?" ++ digestHex (digestOfString (encTop encExpr (toAstExpr other)))
