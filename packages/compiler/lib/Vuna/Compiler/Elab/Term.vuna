export deferDictBinder : List (String, Term) -> Ctx -> Ec -> Value -> Closure -> List Expr -> Span -> Check (List (Term, Rig), Value, Ec)
deferDictBinder globals ctx ec dom clo args sp =
  deferDictBinderFuel 64 globals ctx ec dom clo args sp Nothing

