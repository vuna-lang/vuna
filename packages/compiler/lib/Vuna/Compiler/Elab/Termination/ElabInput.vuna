-- | 从**精化后**的程序构造终止性分析输入。
--
-- 分析引擎（`Elab.Termination` / `Scc` / `Measure`）工作在「定义名 → 子句（参数模式 +
-- 体）」这一层。以前这一层直接取 Loader 之后的 Rast 声明，于是实例方法体里的自调用
-- 在包上下文里对不上名字（D124）：Loader 把 trait 方法投影改名成 `<模块前缀>.<方法>`，
-- 分析只按声明短名连边。
--
-- 现在输入来自精化产物：`Term` 里所有调用都已是规范名，实例字典是
-- `TCon MkDict_C [方法实现...]`，自调用是 `<投影> <字典值> <实参...>`。本模块做三件事：
--   1. 把每个 `DtDef` 拆成分析组：普通定义一组；字典定义按字段拆成
--      `<字典符号>#<方法短名>` 一组（方法体 + 方法自己的显式参数）；
--   2. 把 `Term` 翻译成引擎认识的表达式形状：擦除实参直接丢弃（引擎只关心运行时
--      参数位置），`case` 分支的 binder 变成构造子模式；
--   3. 把「投影 + 已知字典值」的调用点改写成对应的组名。字典值是 `TGlobal <字典符号>`
--      （本包自己的实例）时目标唯一；是 ctx 变量（泛型函数里的字典参数）时保持原名、
--      不连边——与之前「未知名字不连边」的保守程度一致。
--
-- 依赖包的声明仍作为 SCT 上下文传入（来自模块接口），但**本包**的定义一律来自精化
-- 产物；跨包调用按规范名连边，实例方法按字典分组，不再依赖源码层的短名对齐。
module Vuna.Compiler.Elab.Termination.ElabInput where

import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name

-- ---------------------------------------------------------------
-- 组名
-- ---------------------------------------------------------------
-- | 实例方法的分析组名：字典符号 + `#` + 方法短名。
--
-- 字典符号里没有 `#`，所以组名不会与任何全局名或彼此相同；同一方法的不同实例、
-- 不同类的同名方法因此天然分开（跨实例字典派发不会再被当成自递归，D124 的另一半）。
export dictGroupKey : String -> String -> String
dictGroupKey dictSym method = "${dictSym}#${method}"

-- ---------------------------------------------------------------
-- 投影表：投影全局名 → (字典构造子, 字段序号)
-- ---------------------------------------------------------------
-- 投影定义由 `Elab.Trait.projectionDefs` 生成，形状固定：
--   `\p.. => \_d => \x.. => case _d of MkDict_C f0..fn => f_k x..`
-- 只按形状识别（不猜名字前缀规则），拿到「这个全局名是哪个类的第几个方法」。
record ProjEntry where
  peName : String
  peCtor : String
  peField : Int

export peNameOf : ProjEntry -> String
peNameOf p = p.peName

record DefShape where
  dsName : String
  -- | 擦除实参丢弃之后，还要跳过的隐式（非擦除）前缀个数：ctx 字典参数。
  dsPrefix : Int
  -- | 运行时显式参数个数（擦除位不计）。
  dsArity : Int

-- | 调用点改写与参数对齐所需的全部上下文。
record ConvCtx where
  ccProjs : List ProjEntry
  -- | 字典符号 → 类名（本包自己的实例）。
  ccDicts : List (Pair String String)
  ccShapes : List DefShape
  ccClasses : List DtClass
  -- | record 构造子 → 按位置排列的字段名（`TProj` 的 `tele` 只有位置名，字段身份在
  -- `DtData.dtDataFields`）。
  ccFields : List (Pair String (List String))
  -- | 合成节点的 span：Core 的调用节点没有 span，统一用定义自身的声明位置，
  -- 终止性诊断的 label 因此落在定义上（而不是像源码层那样落在调用点）。
  ccSpan : Span

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
-- | 一组分析组：组名 + 参数名 + 体。
record Group where
  grName : String
  grParams : List String
  grBody : Expr
  grSpan : Span

export grNameOf : Group -> String
grNameOf g = g.grName

-- | 把精化后的定义拆成分析组。返回（本包组名，`DFun` 形式的声明）。
export elabTermInput : List DtData -> List DtClass -> List DtDef -> Pair (List String) (List Decl)
elabTermInput datas classes defs =
  let
    projs = projectionTable defs
    dicts = dictSymbolsOf classes defs
    shapes = mapMaybe defShape defs
    fields = recordFieldTable datas
    groups = concatMap (groupsOfDef projs dicts shapes classes fields) defs
  in Pair (map grNameOf groups) (map groupToDecl groups)

groupToDecl : Group -> Decl
groupToDecl g = DFun g.grName (map (\p => PVar p spanEmpty) g.grParams) g.grBody g.grSpan

groupsOfDef : List ProjEntry -> List (Pair String String) -> List DefShape -> List DtClass -> List (Pair String (List String)) -> DtDef -> List Group
groupsOfDef projs dicts shapes classes fields d =
  let
    sp = fromMaybe spanEmpty (dtDefSpan d)
    cc = ConvCtx projs dicts shapes classes fields sp
  in groupsOfDefGo cc d

groupsOfDefGo : ConvCtx -> DtDef -> List Group
groupsOfDefGo cc d =
  case dtDefBody d of
    Nothing => []
    Just body =>
      if memName (dtDefName d) (map peNameOf cc.ccProjs) then
        []
      else
        case dictFieldsOf cc body of
          -- 投影定义本身不是用户函数：它只提供 `投影 → 方法序号` 的映射。
          Just (Pair ctor fields) => dictFieldGroups cc (dtDefName d) ctor fields
          Nothing =>
            let
              stripped = stripLeading (dtDefType d) body
            in [Group (dtDefName d) (firstOf stripped) (convExpr cc (secondOf stripped)) cc.ccSpan]

-- 字典定义：λ tele → λ ctx → `TCon MkDict_C [方法实现...]`。
dictFieldsOf : ConvCtx -> Term -> Maybe (Pair String (List (Pair Term Rig)))
dictFieldsOf cc body =
  case peelLams body of
    TCon ctor fields =>
      case lookupDictCtor cc.ccClasses ctor of
        Just _ => Just (Pair ctor fields)
        Nothing => Nothing
    _ => Nothing

dictFieldGroups : ConvCtx -> String -> String -> List (Pair Term Rig) -> List Group
dictFieldGroups cc dictSym dictCtor fields = dictFieldGroupsGo cc dictSym dictCtor fields 0

dictFieldGroupsGo : ConvCtx -> String -> String -> List (Pair Term Rig) -> Int -> List Group
dictFieldGroupsGo cc dictSym dictCtor [] i = []
dictFieldGroupsGo cc dictSym dictCtor ((Pair fieldTerm _) :: rest) i =
  case lookupCtorClass cc.ccClasses dictCtor of
    Nothing => dictFieldGroupsGo cc dictSym dictCtor rest (i + 1)
    Just cls =>
      case nthAt cls.dtClassMethods i of
        Nothing => dictFieldGroupsGo cc dictSym dictCtor rest (i + 1)
        Just method =>
          case nthAt cls.dtClassFieldTys i of
            Nothing => dictFieldGroupsGo cc dictSym dictCtor rest (i + 1)
            Just methodTy =>
              let
                mname = firstOf method
                stripped = stripLeading methodTy fieldTerm
                g =
                  Group
                    (dictGroupKey dictSym mname)
                    (firstOf stripped)
                    (convExpr cc (secondOf stripped))
                    cc.ccSpan
              in g :: dictFieldGroupsGo cc dictSym dictCtor rest (i + 1)

-- ---------------------------------------------------------------
-- 字典符号 / 构造子 ↔ 类
-- ---------------------------------------------------------------
-- | 本包字典定义的名字 → 类名（由定义体的 `MkDict_C` 推出）。
dictSymbolsOf : List DtClass -> List DtDef -> List (Pair String String)
dictSymbolsOf classes defs = mapMaybe (dictSymbolOf classes) defs

dictSymbolOf : List DtClass -> DtDef -> Maybe (Pair String String)
dictSymbolOf classes d =
  case dtDefBody d of
    Nothing => Nothing
    Just body =>
      case peelLams body of
        TCon ctor _ =>
          case lookupCtorClass classes ctor of
            Just cls => Just (Pair (dtDefName d) (dtClassName cls))
            Nothing => Nothing
        _ => Nothing

lookupDictCtor : List DtClass -> String -> Maybe DtClass
lookupDictCtor [] ctor = Nothing
lookupDictCtor (c :: rest) ctor =
  if dictCtorName (dtClassName c) == ctor then Just c else lookupDictCtor rest ctor

lookupCtorClass : List DtClass -> String -> Maybe DtClass
lookupCtorClass = lookupDictCtor

lookupDictClass : ConvCtx -> String -> Maybe String
lookupDictClass cc sym =
  case filter (\p => firstOf p == sym) cc.ccDicts of
    (Pair _ cls) :: _ => Just cls
    [] => Nothing

lookupClassByName : List DtClass -> String -> Maybe DtClass
lookupClassByName [] name = Nothing
lookupClassByName (c :: rest) name =
  if dtClassName c == name then Just c else lookupClassByName rest name

lookupProjEntry : String -> List ProjEntry -> Maybe ProjEntry
lookupProjEntry name [] = Nothing
lookupProjEntry name (p :: rest) = if p.peName == name then Just p else lookupProjEntry name rest

-- ---------------------------------------------------------------
-- 签名形状：隐式非擦除前缀 + 运行时显式参数个数
-- ---------------------------------------------------------------
defShape : DtDef -> Maybe DefShape
defShape d =
  case dtDefBody d of
    Nothing => Nothing
    Just _ =>
      let
        counts = shapeOfTy (dtDefType d)
      in Just (DefShape (dtDefName d) (firstOf counts) (secondOf counts))

shapeOfTy : Term -> Pair Int Int
shapeOfTy ty = shapeGo ty 0 0

shapeGo : Term -> Int -> Int -> Pair Int Int
shapeGo (TPi _ implicit rig _ cod) prefix arity =
  if implicit then
    shapeGo cod (if rigIsErased rig then prefix else prefix + 1) arity
  else
    shapeGo cod prefix (if rigIsErased rig then arity else arity + 1)
shapeGo _ prefix arity = Pair prefix arity

lookupShape : String -> List DefShape -> Maybe DefShape
lookupShape name [] = Nothing
lookupShape name (s :: rest) = if s.dsName == name then Just s else lookupShape name rest

-- | 按类型 Pi 链剥掉函数前导 λ：隐式 / 擦除 binder 不是值参数。
--
-- 类型链比 λ 链短时（函数返回函数）停在链尾：剩下的 λ 属于体，不再当参数。
stripLeading : Term -> Term -> Pair (List String) Term
stripLeading ty body = stripGo ty body []

stripGo : Term -> Term -> List String -> Pair (List String) Term
stripGo (TPi _ implicit rig _ cod) body acc =
  case body of
    TLam name lamRig _ _ inner =>
      let
        isParam = not implicit && not (rigIsErased rig) && not (rigIsErased lamRig)
        acc2 = if isParam then append acc [name] else acc
      in stripGo cod inner acc2
    _ => Pair acc body
stripGo _ body acc = Pair acc body

-- ---------------------------------------------------------------
-- 表达式翻译
-- ---------------------------------------------------------------
-- 单函数 + 实参累加器：递归只沿 `Term` 子项下降（`TApp` 的函数/实参、`TLam` 的体、
-- `case` 的分支体…）。实参表里存的是**已翻译**的 `Expr`，不把 `Term` 列表当参数传下去，
-- 否则终止性分析看不到结构下降（`List Expr` 与输入项无关）。
convExpr : ConvCtx -> Term -> Expr
convExpr cc t = convGo cc t []

convGo : ConvCtx -> Term -> List Expr -> Expr
convGo cc t acc =
  case t of
    TApp fn arg rig =>
      case rig of
        Rig0 => convGo cc fn acc
        -- 从外到内下降、前插累积：到叶子时正好是书写顺序。
        _ => convGo cc fn (convExpr cc arg :: acc)
    TLam name lamRig _ _ body =>
      case acc of
        a :: rest =>
          if rigIsErased lamRig then
            convGo cc body (a :: rest)
          else
            ELet [Pair (PVar name spanEmpty) a] (convGo cc body rest) False cc.ccSpan
        [] =>
          if rigIsErased lamRig then
            convGo cc body []
          else
            ELam [Pair name spanEmpty] (convGo cc body []) cc.ccSpan
    _ => convLeaf cc t acc

convLeaf : ConvCtx -> Term -> List Expr -> Expr
convLeaf cc t acc =
  case t of
    TGlobal name => appGlobal cc name acc
    TVar name _ _ => applyAcc cc (EVar (RLocal name) cc.ccSpan) acc
    TCon ctor args => tagApply cc ctor (convArgs cc args) acc
    TMk ctor args => tagApply cc ctor (convArgs cc args) acc
    TRecord ctor args => tagApply cc ctor (convArgs cc args) acc
    -- `TProj base ctor tele (族参数个数 + 字段号) 字段号`：字段名按**字段号**取
    -- （`tele` 已经去掉了 record 的族参数）。
    TProj base ctor tele _ fi =>
      case fieldNameAt cc ctor fi tele of
        Just field => applyAcc cc (EField (convExpr cc base) field cc.ccSpan) acc
        Nothing => applyAcc cc (convExpr cc base) acc
    TRecUpd base _ _ _ _ => applyAcc cc (convExpr cc base) acc
    -- 记录更新在递归定义里不参与下降关系：只保留被更新的基值。
    TCase scrut alts => applyAcc cc (ECase (convExpr cc scrut) (convAlts cc alts) cc.ccSpan) acc
    TIf c a b => applyAcc cc (EIf (convExpr cc c) (convExpr cc a) (convExpr cc b) cc.ccSpan) acc
    TInt n => applyAcc cc (EInt n cc.ccSpan) acc
    TBool b => applyAcc cc (EInt (if b then 1 else 0) cc.ccSpan) acc
    TStr s => applyAcc cc (EStr s cc.ccSpan) acc
    TFloat raw => applyAcc cc (EStr raw cc.ccSpan) acc
    -- 类型 / 元变量 / 布尔字面量：分析视角下是惰性常量。
    _ => applyAcc cc (EInt 0 cc.ccSpan) acc

convArgs : ConvCtx -> List (Pair Term Rig) -> List Expr
convArgs cc [] = []
convArgs cc ((Pair arg rig) :: rest) =
  if rigIsErased rig then convArgs cc rest else convExpr cc arg :: convArgs cc rest

convAlts : ConvCtx -> List CaseAlt -> List (Pair Pat Expr)
convAlts cc [] = []
convAlts cc ((CaseAlt name binders body) :: rest) =
  Pair (altPattern name binders) (convExpr cc body) :: convAlts cc rest

altPattern : String -> List Binder -> Pat
altPattern "" binders = PWild spanEmpty
altPattern ctor binders = PCon (classifyName ctor) (convBinders binders) spanEmpty

-- 擦除 binder（族参数等）不占运行时位置：分析里同样跳过，路径下标才与**值实参**
-- 一致（`y :: more` 的值字段是 0/1，不是 1/2）。
convBinders : List Binder -> List Pat
convBinders [] = []
convBinders ((Binder name rig _) :: rest) =
  if rigIsErased rig then convBinders rest else PVar name spanEmpty :: convBinders rest

applyAcc : ConvCtx -> Expr -> List Expr -> Expr
applyAcc cc e [] = e
applyAcc cc e args = EApp e args cc.ccSpan

tagApply : ConvCtx -> String -> List Expr -> List Expr -> Expr
tagApply cc ctor vals acc = applyAcc cc (applyAcc cc (EVar (classifyName ctor) cc.ccSpan) vals) acc

appGlobal : ConvCtx -> String -> List Expr -> Expr
appGlobal cc name args =
  case lookupProjEntry name cc.ccProjs of
    Just pe =>
      case args of
        -- 方法投影：`proj <字典值> <实参...>`。字典值是本包实例时改写成该实例方法的组名。
        dictExpr :: rest =>
          case dictExpr of
            EVar rname _ =>
              case lookupDictClass cc (rnameKey rname) of
                Just cls =>
                  case lookupClassByName cc.ccClasses cls of
                    Just classTerm =>
                      case nthAt classTerm.dtClassMethods pe.peField of
                        Just (Pair method _) =>
                          applyAcc
                            cc
                            (EVar (RLocal (dictGroupKey (rnameKey rname) method)) cc.ccSpan)
                            rest
                        Nothing => applyNamed cc name args
                    Nothing => applyNamed cc name args
                Nothing => applyNamed cc name args
            _ => applyNamed cc name args
        [] => applyNamed cc name args
    Nothing => applyNamed cc name args

-- 已知被调者：丢掉 ctx 字典前缀、按运行时 arity 分组，多余实参继续套应用。
applyNamed : ConvCtx -> String -> List Expr -> Expr
applyNamed cc name args =
  case lookupShape name cc.ccShapes of
    Just shape =>
      let
        valueArgs = dropCount shape.dsPrefix args
        head = EVar (classifyName name) cc.ccSpan
      in case valueArgs of
        [] => head
        _ =>
          nestApp
            cc
            (EApp head (takeCount shape.dsArity valueArgs) cc.ccSpan)
            (dropCount shape.dsArity valueArgs)
    Nothing => applyAcc cc (EVar (classifyName name) cc.ccSpan) args

nestApp : ConvCtx -> Expr -> List Expr -> Expr
nestApp cc base [] = base
nestApp cc base (arg :: rest) = nestApp cc (EApp base [arg] cc.ccSpan) rest

-- ---------------------------------------------------------------
-- 记录字段名
-- ---------------------------------------------------------------
-- `DtFieldMeta` 没有导出的字段访问器：用显式类型标注的模式取名字。
fieldMetaName : DtFieldMeta -> String
fieldMetaName m =
  let
    n = m.dtFieldName
  in n

recordFieldTable : List DtData -> List (Pair String (List String))
recordFieldTable [] = []
recordFieldTable (d :: rest) =
  case dtDataFields d of
    [] => recordFieldTable rest
    fields =>
      let
        names = map fieldMetaName fields
        entries = map (\c => Pair (dtCtorName c) names) (dtDataCtors d)
      in append entries (recordFieldTable rest)

fieldNameAt : ConvCtx -> String -> Int -> List (Pair String Rig) -> Maybe String
fieldNameAt cc ctor i tele =
  case lookupFieldNames ctor cc.ccFields of
    Just names =>
      case nthAt names i of
        Just n => Just n
        Nothing => teleName tele i
    Nothing => teleName tele i

lookupFieldNames : String -> List (Pair String (List String)) -> Maybe (List String)
lookupFieldNames ctor [] = Nothing
lookupFieldNames ctor ((Pair c names) :: rest) =
  if c == ctor then Just names else lookupFieldNames ctor rest

teleName : List (Pair String Rig) -> Int -> Maybe String
teleName tele i =
  case nthAt tele i of
    Just (Pair n _) => Just n
    Nothing => Nothing

-- ---------------------------------------------------------------
-- 通用小工具
-- ---------------------------------------------------------------
peelLams : Term -> Term
peelLams (TLam _ _ _ _ body) = peelLams body
peelLams e = e

nthAt : List a -> Int -> Maybe a
nthAt [] i = Nothing
nthAt (x :: rest) i = if i <= 0 then Just x else nthAt rest (i - 1)

takeCount : Int -> List a -> List a
takeCount n xs = if n <= 0 then [] else takeGo n xs

takeGo : Int -> List a -> List a
takeGo n [] = []
takeGo n (x :: rest) = if n <= 0 then [] else x :: takeGo (n - 1) rest

dropCount : Int -> List a -> List a
dropCount n xs = if n <= 0 then xs else dropGo n xs

dropGo : Int -> List a -> List a
dropGo n [] = []
dropGo n (x :: rest) = if n <= 0 then x :: rest else dropGo (n - 1) rest

-- ---------------------------------------------------------------
-- 投影识别
-- ---------------------------------------------------------------
projectionTable : List DtDef -> List ProjEntry
projectionTable [] = []
projectionTable (d :: rest) =
  case projectionShape (dtDefBody d) of
    Just (Pair ctor field) => ProjEntry (dtDefName d) ctor field :: projectionTable rest
    Nothing => projectionTable rest

projectionShape : Maybe Term -> Maybe (Pair String Int)
projectionShape Nothing = Nothing
projectionShape (Just body) =
  case peelToCase body of
    Just alt =>
      case appHeadVar (caseAltBody alt) of
        Just v =>
          case fieldIndexOfVar v of
            Just k => Just (Pair (caseAltName alt) k)
            Nothing => Nothing
        Nothing => Nothing
    Nothing => Nothing

peelToCase : Term -> Maybe CaseAlt
peelToCase (TLam _ _ _ _ body) = peelToCase body
peelToCase (TCase _ ([alt])) = Just alt
peelToCase _ = Nothing

appHeadVar : Term -> Maybe String
appHeadVar (TApp fn _ _) = appHeadVar fn
appHeadVar (TVar name _ _) = Just name
appHeadVar _ = Nothing

-- `_f<k>`：投影体里选中的字段变量（`Elab.Meta.fieldVarName`）。
fieldIndexOfVar : String -> Maybe Int
fieldIndexOfVar name =
  if startsWith fieldVarPrefix name then
    parseNat (dropGo (strLength fieldVarPrefix) (strUnpack name))
  else
    Nothing

fieldVarPrefix : String
fieldVarPrefix = "_f"

parseNat : List Int -> Maybe Int
parseNat ds = parseNatGo ds 0 0

parseNatGo : List Int -> Int -> Int -> Maybe Int
parseNatGo [] acc seen = if seen == 0 then Nothing else Just acc
parseNatGo (c :: rest) acc seen =
  if c >= 48 && c <= 57 then parseNatGo rest (acc * 10 + (c - 48)) (seen + 1) else Nothing
