module Vuna.Compiler.Elab.Termination.Scc where

-- Vuna.Compiler.Elab.Termination.Scc：size-change termination 引擎——
-- 参数级 size-change 图、传递闭包、幂等图严格边判定（SCT 定理）。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Obs
import Base.Data.Obs as Obs
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name
import Vuna.Compiler.Elab.Termination.Measure

record Site where
  siteCaller : String
  siteCallee : String
  siteArgs : List Expr
  siteSizes : List (Pair String (Pair Int (Pair Int (List Int))))
  siteRegion : List String
  -- 编译期看不见实参位置的调用（callee 以值传递 / 遍历预算耗尽）：只落全弱边。
  siteBlind : Bool

-- 遍历预算耗尽或 callee 以值传递时，用「全弱边」占位站点覆盖该 caller 到组内每个
-- 成员：漏掉的调用边仍留在图上，且不可能贡献严格下降（sound 方向）。
blindSitesOf : List String -> String -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List Site
blindSitesOf comp caller sizes region = map (\g => Site caller g [] sizes region True) comp

record ScEdge where
  edgeFrom : Int
  edgeTo : Int
  scStrictEdge : Bool

siteCollectList : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List Expr -> List Site -> List Site
siteCollectList fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectList fuel comp ctors projs caller facts sizes region (a :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectList
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      sizes
      region
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region a acc)

siteCollectFields : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List (Pair String Expr) -> List Site -> List Site
siteCollectFields fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectFields fuel comp ctors projs caller facts sizes region ((Pair fn fe) :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectFields
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      sizes
      region
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fe acc)

siteCollectAlts : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> Expr -> List (Pair Pat Expr) -> List Site -> List Site
siteCollectAlts fuel comp ctors projs caller facts sizes region scrut [] acc =
  if fuel <= 0 then acc else acc
siteCollectAlts fuel comp ctors projs caller facts sizes region scrut ((Pair pat body) :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectAlts
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      sizes
      region
      scrut
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts (extendSizesStrict sizes scrut pat) region body acc)

siteCollectBinds : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List (Pair Pat Expr) -> List Site -> List Site
siteCollectBinds fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectBinds fuel comp ctors projs caller facts sizes region ((Pair pat val) :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectBinds
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      (extendSizesStrict sizes val pat)
      region
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region val acc)

siteCollectStmts : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List DoStmt -> List Site -> List Site
siteCollectStmts fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectStmts fuel comp ctors projs caller facts sizes region (s :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case s of
      DBind pat e sp => siteCollectStmts (fuel - 1) comp ctors projs caller facts (extendSizesStrict sizes e pat) region rest (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region e acc)
      DExpr e sp => siteCollectStmts (fuel - 1) comp ctors projs caller facts sizes region rest (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region e acc)

siteWalkC : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> Expr -> List Site -> List Site
siteWalkC fuel comp ctors projs caller facts sizes region e acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case e of
      EApp fn args sp => siteWalkEApp (fuel - 1) comp ctors projs caller facts sizes region fn args acc
      ECase scrut alts sp => siteCollectAlts (fuel - 1) comp ctors projs caller facts sizes region scrut alts (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region scrut acc)
      EIf c t el sp =>
        let
          acc1 = siteWalkC (fuel - 1) comp ctors projs caller facts sizes region c acc
          acc2 = siteWalkC (fuel - 1) comp ctors projs caller facts sizes (append (guardThenPosVars c) region) t acc1
        in siteWalkC (fuel - 1) comp ctors projs caller facts sizes (append (guardElsePosVars c) region) el acc2
      ELam ns b sp => siteWalkC (fuel - 1) comp ctors projs caller facts sizes region b acc
      ELet binds body rec_ sp => siteWalkC (fuel - 1) comp ctors projs caller facts (extendByBinds binds sizes) region body (siteCollectBinds (fuel - 1) comp ctors projs caller facts sizes region binds acc)
      EPi n implicit _ dom cod sp => siteWalkC (fuel - 1) comp ctors projs caller facts sizes region cod (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region dom acc)
      EField base f sp => siteWalkC (fuel - 1) comp ctors projs caller facts sizes region base acc
      ERecord rn fields sp => siteCollectFields (fuel - 1) comp ctors projs caller facts sizes region fields acc
      ERecUpdate base fields sp => siteCollectFields (fuel - 1) comp ctors projs caller facts sizes region fields (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region base acc)
      EDo stmts sp => siteCollectStmts (fuel - 1) comp ctors projs caller facts sizes region stmts acc
      EAnn value ty sp => siteWalkC (fuel - 1) comp ctors projs caller facts sizes region ty (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region value acc)
      -- where/let 多 clause 局部函数：各 clause body 的调用点同样要收集
      -- （否则 `where` 绑定体里调外层递归函数会漏检）。
      ELocalFun clauses sp => siteCollectBinds (fuel - 1) comp ctors projs caller facts sizes region (localClauseBinds clauses) acc
      EVar n sp => if memName (rnameKey n) comp then Site caller (rnameKey n) [] sizes region True :: acc else acc
      _ => acc

siteWalkEApp : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> Expr -> List Expr -> List Site -> List Site
siteWalkEApp fuel comp ctors projs caller facts sizes region fn args acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case groupHead comp fn of
      Just callee => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (Site caller callee args sizes region False :: acc)
      Nothing =>
        case fn of
          EVar nm nsp =>
            case hofSpecOf nm of
              Just spec =>
                case hofLambdaCall spec args of
                  Just hc =>
                    let
                      acc1 = siteCollectList (fuel - 1) comp ctors projs caller facts sizes region hc.hofSideArgs acc
                      sizes2 = extendElemSizes sizes hc.hofListExpr hc.hofElemBinder
                    in siteWalkC (fuel - 1) comp ctors projs caller facts sizes2 region hc.hofBody acc1
                  Nothing => if spec.hofLambdaArity == 1 then siteWalkEAppMap (fuel - 1) comp ctors projs caller facts sizes region fn args acc else siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fn acc)
              Nothing => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fn acc)
          _ => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fn acc)

siteWalkEAppMap : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> Expr -> List Expr -> List Site -> List Site
siteWalkEAppMap fuel comp ctors projs caller facts sizes region fn args acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case args of
      [cb, lst] =>
        case cb of
          EApp (EVar g gsp) pargs cbsp => if memName (rnameKey g) comp then siteWalkMapPartialInline (fuel - 1) comp ctors projs caller facts sizes region (rnameKey g) pargs lst cbsp acc else siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc
          EVar g gsp => if memName (rnameKey g) comp then siteWalkMapPartialInline (fuel - 1) comp ctors projs caller facts sizes region (rnameKey g) [] lst gsp acc else siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc
          _ => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc
      _ => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc

siteWalkMapPartialInline : Int -> List String -> List String -> List (Pair String (List Int)) -> String -> HashMap String (List Int) -> List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> String -> List Expr -> Expr -> Span -> List Site -> List Site
siteWalkMapPartialInline fuel comp ctors projs caller facts sizes region g pargs lst cbsp acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    let
      acc1 = siteWalkC (fuel - 1) comp ctors projs caller facts sizes region lst acc
      elems = extendElemSizes sizes lst "$elem"
      fullArgs = append pargs [EVar (classifyName "$elem") cbsp]
      acc2 = siteCollectList (fuel - 1) comp ctors projs caller facts sizes region pargs acc1
    in Site caller g fullArgs elems region False :: acc2

-- ---------------------------------------------------------------
-- 别名解析：`let g = f in g x`（f 是同组函数）按直接调用参与尺寸分析。
-- 只在绑定是裸 `PVar` + `EVar` 组内函数时替换；遇到同名 binder 立即屏蔽。
-- ---------------------------------------------------------------
aliasNameOf : Pair String String -> String
aliasNameOf p = firstOf p

lookupAlias : String -> List (Pair String String) -> Maybe String
lookupAlias n [] = Nothing
lookupAlias n ((Pair k v) :: rest) = if n == k then Just v else lookupAlias n rest

dropAliases : List String -> List (Pair String String) -> List (Pair String String)
dropAliases [] als = als
dropAliases (n :: rest) als = dropAliases rest (filter (\p => aliasNameOf p /= n) als)

aliasOf : List String -> Pair Pat Expr -> Maybe (Pair String String)
aliasOf comp (Pair (PVar g gsp) val) =
  case val of
    EVar n nsp => if memName (rnameKey n) comp then Just (Pair g (rnameKey n)) else Nothing
    _ => Nothing
aliasOf comp (Pair _ val) = Nothing

inlArgs : List String -> List (Pair String String) -> List Expr -> List Expr
inlArgs comp als [] = []
inlArgs comp als (a :: rest) = inlGo comp als a :: inlArgs comp als rest

inlFields : List String -> List (Pair String String) -> List (Pair String Expr) -> List (Pair String Expr)
inlFields comp als [] = []
inlFields comp als ((Pair fn fe) :: rest) = Pair fn (inlGo comp als fe) :: inlFields comp als rest

inlParts : List String -> List (Pair String String) -> List InterpPart -> List InterpPart
inlParts comp als [] = []
inlParts comp als (p :: rest) =
  case p of
    IPText t => IPText t :: inlParts comp als rest
    IPHole e => IPHole (inlGo comp als e) :: inlParts comp als rest

inlBinds : List String -> List (Pair String String) -> List (Pair Pat Expr) -> Pair (List (Pair Pat Expr)) (List (Pair String String))
inlBinds comp als [] = Pair [] als
inlBinds comp als ((Pair pat val) :: rest) =
  let
    rhs = inlGo comp als val
  in case aliasOf comp (Pair pat rhs) of
    -- 纯别名（`let g = f`）：绑定本身没有分析价值，丢掉以免它的裸值引用
    -- 被当成「callee 以值传递」的盲站点；body 里的 `g` 已在 `inlGo` 里替换。
    Just a =>
      let
        restP = inlBinds comp (a :: als) rest
      in Pair (firstOf restP) (secondOf restP)
    Nothing =>
      let
        restP = inlBinds comp (dropAliases (patNamesOf pat) als) rest
      in Pair (Pair pat rhs :: firstOf restP) (secondOf restP)

inlAlts : List String -> List (Pair String String) -> List (Pair Pat Expr) -> List (Pair Pat Expr)
inlAlts comp als [] = []
inlAlts comp als ((Pair pat body) :: rest) =
  Pair pat (inlGo comp (dropAliases (patNamesOf pat) als) body) :: inlAlts comp als rest

inlClauses : List String -> List (Pair String String) -> List (Pair (List Pat) Expr) -> List (Pair (List Pat) Expr)
inlClauses comp als [] = []
inlClauses comp als ((Pair pats body) :: rest) =
  Pair pats (inlGo comp (dropAliases (patNamesOfPats pats) als) body) :: inlClauses comp als rest

inlStmts : List String -> List (Pair String String) -> List DoStmt -> List DoStmt
inlStmts comp als [] = []
inlStmts comp als (s :: rest) =
  case s of
    DBind pat e sp =>
      DBind pat (inlGo comp als e) sp :: inlStmts comp (dropAliases (patNamesOf pat) als) rest
    DExpr e sp => DExpr (inlGo comp als e) sp :: inlStmts comp als rest

inlGo : List String -> List (Pair String String) -> Expr -> Expr
inlGo comp als (EVar n sp) =
  case lookupAlias (rnameKey n) als of
    Just target => EVar (classifyName target) sp
    Nothing => EVar n sp
inlGo comp als (ELam ns body sp) = ELam ns (inlGo comp (dropAliases (map firstOf ns) als) body) sp
inlGo comp als (EApp fn args sp) = EApp (inlGo comp als fn) (inlArgs comp als args) sp
inlGo comp als (EPi n implicit qty dom cod sp) =
  EPi n implicit qty (inlGo comp als dom) (inlGo comp (dropAliases [n] als) cod) sp
inlGo comp als (ELet binds body rec_ sp) =
  let
    p = inlBinds comp als binds
  in ELet (firstOf p) (inlGo comp (secondOf p) body) rec_ sp
inlGo comp als (ELocalFun clauses sp) = ELocalFun (inlClauses comp als clauses) sp
inlGo comp als (ECase scrut alts sp) = ECase (inlGo comp als scrut) (inlAlts comp als alts) sp
inlGo comp als (EIf c t el sp) = EIf (inlGo comp als c) (inlGo comp als t) (inlGo comp als el) sp
inlGo comp als (EField base f sp) = EField (inlGo comp als base) f sp
inlGo comp als (ERecord rn fields sp) = ERecord rn (inlFields comp als fields) sp
inlGo comp als (ERecUpdate base fields sp) =
  ERecUpdate (inlGo comp als base) (inlFields comp als fields) sp
inlGo comp als (EDo stmts sp) = EDo (inlStmts comp als stmts) sp
inlGo comp als (EInfix op l r sp) = EInfix op (inlGo comp als l) (inlGo comp als r) sp
inlGo comp als (EParen e sp) = EParen (inlGo comp als e) sp
inlGo comp als (EBacktick op l r sp) = EBacktick op (inlGo comp als l) (inlGo comp als r) sp
inlGo comp als (ESectL op e sp) = ESectL op (inlGo comp als e) sp
inlGo comp als (ESectR e op sp) = ESectR (inlGo comp als e) op sp
inlGo comp als (EAnn value ty sp) = EAnn (inlGo comp als value) (inlGo comp als ty) sp
inlGo comp als (EInterp multi parts sp) = EInterp multi (inlParts comp als parts) sp
inlGo comp als e = e

inlineAliases : List String -> Expr -> Expr
inlineAliases comp e = inlGo comp [] e

siteCollectClauses : List String -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> String -> List (Pair (List Pat) Expr) -> List Site -> List Site
siteCollectClauses comp ctors projs facts caller [] acc = acc
siteCollectClauses comp ctors projs facts caller (cl :: rest) acc =
  let
    body = inlineAliases comp (secondOf cl)
  in siteCollectClauses
    comp
    ctors
    projs
    facts
    caller
    rest
    (siteWalkC (exprBudget 32 body) comp ctors projs caller facts (strSizeEntries (firstOf cl)) [] body acc)

siteCollect : List String -> List String -> List (Pair String (List Int)) -> HashMap String (List (Pair (List Pat) Expr)) -> HashMap String (List Int) -> List Site
siteCollect comp ctors projs defTbl facts = siteCollectGo comp ctors projs defTbl facts comp []

siteCollectGo : List String -> List String -> List (Pair String (List Int)) -> HashMap String (List (Pair (List Pat) Expr)) -> HashMap String (List Int) -> List String -> List Site -> List Site
siteCollectGo comp ctors projs defTbl facts [] acc = acc
siteCollectGo comp ctors projs defTbl facts (f :: rest) acc =
  siteCollectGo
    comp
    ctors
    projs
    defTbl
    facts
    rest
    (siteCollectClauses comp ctors projs facts f (clausesOfDefTbl f defTbl) acc)

scIsStrict : Int -> Bool
scIsStrict m = m /= 0

maxBaseOf : List (Pair String (Pair Int (Pair Int (List Int)))) -> Int
maxBaseOf [] = 0
maxBaseOf ((Pair n (Pair base (Pair depth path))) :: rest) = maxInt base (maxBaseOf rest)

insertEdge : ScEdge -> List ScEdge -> List ScEdge
insertEdge e [] = [e]
insertEdge e (x :: rest) =
  if e.edgeFrom < x.edgeFrom then
    e :: x :: rest
  else if e.edgeFrom == x.edgeFrom then
    if e.edgeTo <= x.edgeTo then e :: x :: rest else x :: insertEdge e rest
  else
    x :: insertEdge e rest

sortEdges : List ScEdge -> List ScEdge
sortEdges [] = []
sortEdges (e :: rest) = insertEdge e (sortEdges rest)

mergeStrict : ScEdge -> ScEdge -> ScEdge
mergeStrict a b = ScEdge a.edgeFrom a.edgeTo (if a.scStrictEdge then True else b.scStrictEdge)

compactEdges : List ScEdge -> List ScEdge
compactEdges [] = []
compactEdges (e :: rest) =
  case rest of
    [] => [e]
    x :: xs =>
      if e.edgeFrom == x.edgeFrom then
        if e.edgeTo == x.edgeTo then mergeStrict e x :: compactEdges xs else e :: compactEdges rest
      else
        e :: compactEdges rest

canonEdges : List ScEdge -> List ScEdge
canonEdges edges = compactEdges (sortEdges edges)

edgesEqCanon : List ScEdge -> List ScEdge -> Bool
edgesEqCanon [] [] = True
edgesEqCanon (x :: xs) (y :: ys) =
  if x.edgeFrom == y.edgeFrom then
    if x.edgeTo == y.edgeTo then
      if x.scStrictEdge == y.scStrictEdge then edgesEqCanon xs ys else False
    else
      False
  else
    False
edgesEqCanon (x :: xs) [] = False
edgesEqCanon [] (y :: ys) = False

edgesEq : List ScEdge -> List ScEdge -> Bool
edgesEq a b = edgesEqCanon (canonEdges a) (canonEdges b)

combineWith : ScEdge -> List ScEdge -> List ScEdge
combineWith e [] = []
combineWith e (x :: rest) =
  if e.edgeTo == x.edgeFrom then
    ScEdge e.edgeFrom x.edgeTo (if e.scStrictEdge then True else x.scStrictEdge)
      :: combineWith e rest
  else
    combineWith e rest

composeGo : List ScEdge -> List ScEdge -> List ScEdge
composeGo [] g2 = []
composeGo (e :: rest) g2 = append (combineWith e g2) (composeGo rest g2)

composeEdges : List ScEdge -> List ScEdge -> List ScEdge
composeEdges g1 g2 = canonEdges (composeGo g1 g2)

hasStrict : List ScEdge -> Bool
hasStrict [] = False
hasStrict (e :: rest) = e.scStrictEdge || hasStrict rest

graphIdempotent : List ScEdge -> Bool
graphIdempotent edges = edgesEq (composeEdges edges edges) edges

-- `closureLoop` 收敛后，表是传递闭包的超集：非幂等图还会在闭包里继续合成，所以
-- 只在幂等图上要求严格边（SCT 定理）。未收敛的闭包不进这里判定。
graphOK : List ScEdge -> Bool
graphOK edges = if graphIdempotent edges then hasStrict edges else True

graphsOK : List (List ScEdge) -> Bool
graphsOK [] = True
graphsOK (g :: rest) = graphOK g && graphsOK rest

-- ---------------------------------------------------------------
-- 表：pair -> 图集合
-- ---------------------------------------------------------------
tableGraphCap : Int
tableGraphCap = 512

tableLookup : Pair String String -> List (Pair (Pair String String) (List (List ScEdge))) -> Maybe (List (List ScEdge))
tableLookup k [] = Nothing
tableLookup k ((Pair k2 gs) :: rest) =
  if firstOf k == firstOf k2 then
    if secondOf k == secondOf k2 then Just gs else tableLookup k rest
  else
    tableLookup k rest

graphListHas : List ScEdge -> List (List ScEdge) -> Bool
graphListHas g [] = False
graphListHas g (x :: rest) = edgesEq g x || graphListHas g rest

graphListSubset : List (List ScEdge) -> List (List ScEdge) -> Bool
graphListSubset [] b = True
graphListSubset (g :: rest) b = graphListHas g b && graphListSubset rest b

tableAddPair : String -> String -> List ScEdge -> List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge)))
tableAddPair f g edges [] = [Pair (Pair f g) [edges]]
tableAddPair f g edges ((Pair (Pair f2 g2) gs) :: rest) =
  if f == f2 then
    if g == g2 then
      Pair (Pair f g) (edges :: gs) :: rest
    else
      Pair (Pair f2 g2) gs :: tableAddPair f g edges rest
  else
    Pair (Pair f2 g2) gs :: tableAddPair f g edges rest

tableAdd : String -> String -> List ScEdge -> List (Pair (Pair String String) (List (List ScEdge))) -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
tableAdd f g edges table =
  case tableLookup (Pair f g) table of
    Nothing => Pair (tableAddPair f g edges table) True
    Just gs =>
      if graphListHas edges gs then
        Pair table True
      else if length gs >= tableGraphCap then
        Pair table False
      else
        Pair (tableAddPair f g edges table) True

-- ---------------------------------------------------------------
-- 传递闭包（每轮：对表中每张图 a:(f,g) 与每张图 b:(g,h) 合成加入 (f,h)）
-- ---------------------------------------------------------------
closureStepHs : String -> String -> List ScEdge -> List (List ScEdge) -> List (Pair (Pair String String) (List (List ScEdge))) -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
closureStepHs f h a [] acc = Pair acc True
closureStepHs f h a (b :: bs) acc =
  case tableAdd f h (composeEdges a b) acc of
    Pair acc2 True => closureStepHs f h a bs acc2
    Pair acc2 False => Pair acc2 False

closureStepOne : String -> String -> List ScEdge -> List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge))) -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
closureStepOne f g a table acc = closureStepOneGo f g a table acc True

closureStepOneGo : String -> String -> List ScEdge -> List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge))) -> Bool -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
closureStepOneGo f g a [] acc ok = Pair acc ok
closureStepOneGo f g a ((Pair (Pair g2 h) hs) :: rest) acc ok =
  if g2 == g then
    case closureStepHs f h a hs acc of
      Pair acc2 (ok2@True) => closureStepOneGo f g a rest acc2 ok2
      Pair acc2 False => Pair acc2 False
  else
    closureStepOneGo f g a rest acc ok

closureStepGraphs : String -> String -> List (List ScEdge) -> List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge))) -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
closureStepGraphs f g [] table acc = Pair acc True
closureStepGraphs f g (a :: arest) table acc =
  case closureStepOne f g a table acc of
    Pair acc2 True => closureStepGraphs f g arest table acc2
    Pair acc2 False => Pair acc2 False

closureStepGo : List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge))) -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
closureStepGo [] table acc = Pair acc True
closureStepGo ((Pair (Pair f g) gs) :: rest) table acc =
  case closureStepGraphs f g gs table acc of
    Pair acc2 True => closureStepGo rest table acc2
    Pair acc2 False => Pair acc2 False

closureStep : List (Pair (Pair String String) (List (List ScEdge))) -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
closureStep table = closureStepGo table table table

tableSame : List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge))) -> Bool
tableSame a b = length a == length b && tableSubset a b

tableSubset : List (Pair (Pair String String) (List (List ScEdge))) -> List (Pair (Pair String String) (List (List ScEdge))) -> Bool
tableSubset [] b = True
tableSubset ((Pair k gs) :: rest) b =
  case tableLookup k b of
    Nothing => False
    Just gs2 => graphListSubset gs gs2 && tableSubset rest b

closureLoop : List (Pair (Pair String String) (List (List ScEdge))) -> Int -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) (Pair Bool Int)
closureLoop table fuel =
  if fuel <= 0 then
    Pair table (Pair False fuel)
  else
    case closureStep table of
      Pair table2 True => if tableSame table table2 then Pair table2 (Pair True fuel) else closureLoop table2 (fuel - 1)
      Pair table2 False => Pair table2 (Pair False fuel)

-- ---------------------------------------------------------------
-- 从调用点构造图
-- ---------------------------------------------------------------

-- 实参依赖的 caller 形参位：关系证不出时用它决定落哪些弱边。只按真实依赖落边，
-- 否则 `f x y = f x (y - 1)` 会凭空得到 0→1 / 1→0 的弱环，把正常程序判失败。
argBases : List (Pair String (Pair Int (Pair Int (List Int)))) -> Expr -> List Int
argBases sizes e = dedupBases (argBasesGo sizes [] e)

basesUpToGo : Int -> List Int -> List Int
basesUpToGo i acc = if i <= 0 then 0 :: acc else basesUpToGo (i - 1) (i :: acc)

basesUpTo : Int -> List Int
basesUpTo n = if n < 0 then [] else basesUpToGo n []

hasBase : Int -> List Int -> Bool
hasBase i [] = False
hasBase i (x :: rest) = i == x || hasBase i rest

dedupBases : List Int -> List Int
dedupBases [] = []
dedupBases (x :: rest) = if hasBase x rest then dedupBases rest else x :: dedupBases rest

patNamesOf : Pat -> List String
patNamesOf (PVar n sp) = [n]
patNamesOf (PAs n inner sp) = n :: patNamesOf inner
patNamesOf (PCon c ps sp) = patNamesOfPats ps
patNamesOf (PRecord rn fields sp) = patNamesOfFields fields
patNamesOf _ = []

patNamesOfPats : List Pat -> List String
patNamesOfPats [] = []
patNamesOfPats (p :: rest) = append (patNamesOf p) (patNamesOfPats rest)

patNamesOfFields : List (Pair String Pat) -> List String
patNamesOfFields [] = []
patNamesOfFields ((Pair fn fp) :: rest) = append (patNamesOf fp) (patNamesOfFields rest)

patNamesOfBinds : List (Pair Pat Expr) -> List String
patNamesOfBinds [] = []
patNamesOfBinds ((Pair pat val) :: rest) = append (patNamesOf pat) (patNamesOfBinds rest)

argBasesGo : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> Expr -> List Int
argBasesGo sizes locals (EVar n sp) =
  let
    name = rnameKey n
  in case sizeOfVarStrict name sizes of
    Just (Pair base pr) => [base]
    Nothing => if memName name locals then basesUpTo (maxBaseOf sizes) else []
argBasesGo sizes locals (ELam ns body sp) = argBasesGo sizes (append (map firstOf ns) locals) body
argBasesGo sizes locals (EApp fn args sp) =
  append (argBasesGo sizes locals fn) (argBasesArgs sizes locals args)
argBasesGo sizes locals (EPi n implicit qty dom cod sp) =
  append (argBasesGo sizes locals dom) (argBasesGo sizes locals cod)
argBasesGo sizes locals (ELet binds body rec_ sp) =
  append
    (argBasesBinds sizes locals binds)
    (argBasesGo sizes (append (patNamesOfBinds binds) locals) body)
argBasesGo sizes locals (ELocalFun clauses sp) = argBasesClauses sizes locals clauses
argBasesGo sizes locals (ECase scrut alts sp) =
  append (argBasesGo sizes locals scrut) (argBasesAlts sizes locals alts)
argBasesGo sizes locals (EIf c t el sp) =
  append
    (argBasesGo sizes locals c)
    (append (argBasesGo sizes locals t) (argBasesGo sizes locals el))
argBasesGo sizes locals (EField base f sp) = argBasesGo sizes locals base
argBasesGo sizes locals (ERecord rn fields sp) = argBasesFields sizes locals fields
argBasesGo sizes locals (ERecUpdate base fields sp) =
  append (argBasesGo sizes locals base) (argBasesFields sizes locals fields)
argBasesGo sizes locals (EDo stmts sp) = argBasesStmts sizes locals stmts
argBasesGo sizes locals (EInfix op l r sp) =
  append (argBasesGo sizes locals l) (argBasesGo sizes locals r)
argBasesGo sizes locals (EParen e sp) = argBasesGo sizes locals e
argBasesGo sizes locals (EBacktick op l r sp) =
  append (argBasesGo sizes locals l) (argBasesGo sizes locals r)
argBasesGo sizes locals (ESectL op e sp) = argBasesGo sizes locals e
argBasesGo sizes locals (ESectR e op sp) = argBasesGo sizes locals e
argBasesGo sizes locals (EAnn value ty sp) =
  append (argBasesGo sizes locals value) (argBasesGo sizes locals ty)
argBasesGo sizes locals (EInterp multi parts sp) = argBasesParts sizes locals parts
argBasesGo sizes locals _ = []

argBasesArgs : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List Expr -> List Int
argBasesArgs sizes locals [] = []
argBasesArgs sizes locals (a :: rest) =
  append (argBasesGo sizes locals a) (argBasesArgs sizes locals rest)

argBasesFields : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List (Pair String Expr) -> List Int
argBasesFields sizes locals [] = []
argBasesFields sizes locals ((Pair fn fe) :: rest) =
  append (argBasesGo sizes locals fe) (argBasesFields sizes locals rest)

argBasesBinds : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List (Pair Pat Expr) -> List Int
argBasesBinds sizes locals [] = []
argBasesBinds sizes locals ((Pair pat val) :: rest) =
  append (argBasesGo sizes locals val) (argBasesBinds sizes locals rest)

argBasesAlts : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List (Pair Pat Expr) -> List Int
argBasesAlts sizes locals [] = []
argBasesAlts sizes locals ((Pair pat body) :: rest) =
  append (argBasesGo sizes (append (patNamesOf pat) locals) body) (argBasesAlts sizes locals rest)

argBasesClauses : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List (Pair (List Pat) Expr) -> List Int
argBasesClauses sizes locals [] = []
argBasesClauses sizes locals ((Pair pats body) :: rest) =
  append
    (argBasesGo sizes (append (patNamesOfPats pats) locals) body)
    (argBasesClauses sizes locals rest)

argBasesStmts : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List DoStmt -> List Int
argBasesStmts sizes locals [] = []
argBasesStmts sizes locals (s :: rest) =
  case s of
    DBind pat e sp =>
      append (argBasesGo sizes locals e) (argBasesStmts sizes (append (patNamesOf pat) locals) rest)
    DExpr e sp => append (argBasesGo sizes locals e) (argBasesStmts sizes locals rest)

argBasesParts : List (Pair String (Pair Int (Pair Int (List Int)))) -> List String -> List InterpPart -> List Int
argBasesParts sizes locals [] = []
argBasesParts sizes locals (p :: rest) =
  case p of
    IPText t => argBasesParts sizes locals rest
    IPHole e => append (argBasesGo sizes locals e) (argBasesParts sizes locals rest)

-- 盲站点（callee 以值传递 / 遍历预算耗尽）：caller 全形参位 × callee arity 全弱边。
blindEdgesJ : Int -> Int -> List ScEdge
blindEdgesJ arity i =
  if arity <= 0 then [] else ScEdge i (arity - 1) False :: blindEdgesJ (arity - 1) i

blindEdgesI : Int -> Int -> List ScEdge
blindEdgesI i arity =
  if i <= 0 then
    if i == 0 then blindEdgesJ arity 0 else []
  else
    append (blindEdgesJ arity i) (blindEdgesI (i - 1) arity)

blindEdges : HashMap String (List (Pair (List Pat) Expr)) -> Site -> List ScEdge
blindEdges defTbl s =
  blindEdgesI
    (defArity (clausesOfDefTbl s.siteCaller defTbl) - 1)
    (defArity (clausesOfDefTbl s.siteCallee defTbl))

siteEdgeAt : Int -> Int -> List Int -> Site -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> List ScEdge
siteEdgeAt i j deps s ctors projs facts =
  case nthExpr s.siteArgs j of
    Nothing => []
    Just a =>
      case relOfArg i a s.siteSizes ctors projs s.siteCaller facts s.siteRegion of
        Just m => [ScEdge i j (scIsStrict m)]
        -- 关系证不出：按实参真实依赖落弱边，让调用仍留在图上（弱环不能消失）。
        Nothing => if hasBase i deps then [ScEdge i j False] else []

nthDeps : List (List Int) -> Int -> List Int
nthDeps [] i = []
nthDeps (d :: rest) i = if i <= 0 then d else nthDeps rest (i - 1)

siteEdgesJ : Int -> Int -> List (List Int) -> Site -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> List ScEdge
siteEdgesJ i count deps s ctors projs facts =
  if count <= 0 then
    []
  else
    append
      (siteEdgeAt i (count - 1) (nthDeps deps (count - 1)) s ctors projs facts)
      (siteEdgesJ i (count - 1) deps s ctors projs facts)

siteEdgesI : Int -> List (List Int) -> Site -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> List ScEdge
siteEdgesI i deps s ctors projs facts =
  if i <= 0 then
    siteEdgesJ 0 (length s.siteArgs) deps s ctors projs facts
  else
    append
      (siteEdgesJ i (length s.siteArgs) deps s ctors projs facts)
      (siteEdgesI (i - 1) deps s ctors projs facts)

siteEdgesOf : HashMap String (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> Site -> List ScEdge
siteEdgesOf defTbl ctors projs facts s =
  if s.siteBlind then
    blindEdges defTbl s
  else
    siteEdgesI (maxBaseOf s.siteSizes) (map (argBases s.siteSizes) s.siteArgs) s ctors projs facts

initialTable : HashMap String (List (Pair (List Pat) Expr)) -> List Site -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
initialTable defTbl sites ctors projs facts = initialTableGo defTbl sites ctors projs facts [] True

initialTableGo : HashMap String (List (Pair (List Pat) Expr)) -> List Site -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> List (Pair (Pair String String) (List (List ScEdge))) -> Bool -> Pair (List (Pair (Pair String String) (List (List ScEdge)))) Bool
initialTableGo defTbl [] ctors projs facts acc ok = Pair acc ok
initialTableGo defTbl (s :: rest) ctors projs facts acc ok =
  if ok then
    case tableAdd s.siteCaller s.siteCallee (siteEdgesOf defTbl ctors projs facts s) acc of
      Pair acc2 ok2 => initialTableGo defTbl rest ctors projs facts acc2 ok2
  else
    Pair acc False

-- ---------------------------------------------------------------
-- 判定
-- ---------------------------------------------------------------
-- 闭包迭代上限：每轮把路径长度翻倍，实际上限来自 `tableGraphCap`（每对函数的图数）。
sctClosureFuel : Int
sctClosureFuel = 240

-- 幂等图的起点必然等于终点（幂等即自合成），所以只检查 `f == g` 的配对。
sctCheckTable : List (Pair (Pair String String) (List (List ScEdge))) -> Bool
sctCheckTable [] = True
sctCheckTable ((Pair (Pair f g) gs) :: rest) =
  if f == g then if graphsOK gs then sctCheckTable rest else False else sctCheckTable rest

sctBadGraphs : String -> List (List ScEdge) -> List String
sctBadGraphs f [] = []
sctBadGraphs f (g :: rest) = if graphOK g then sctBadGraphs f rest else f :: sctBadGraphs f rest

sctBadPairs : List (Pair (Pair String String) (List (List ScEdge))) -> List String
sctBadPairs [] = []
sctBadPairs ((Pair (Pair f g) gs) :: rest) =
  if f == g then append (sctBadGraphs f gs) (sctBadPairs rest) else sctBadPairs rest

edgeText : ScEdge -> String
edgeText e = if e.scStrictEdge then strictEdgeText e else weakEdgeText e

strictEdgeText : ScEdge -> String
strictEdgeText e = "${e.edgeFrom}->>${e.edgeTo}"

weakEdgeText : ScEdge -> String
weakEdgeText e = "${e.edgeFrom}->${e.edgeTo}"

edgesText : List ScEdge -> String
edgesText [] = ""
edgesText ([e]) = edgeText e
edgesText (e :: rest) = "${edgeText e},${edgesText rest}"

badGraphText : String -> List (List ScEdge) -> List String
badGraphText f [] = []
badGraphText f (g :: rest) =
  if graphOK g then badGraphText f rest else "${f}{${edgesText g}}" :: badGraphText f rest

sctBadText : List (Pair (Pair String String) (List (List ScEdge))) -> List String
sctBadText [] = []
sctBadText ((Pair (Pair f g) gs) :: rest) =
  if f == g then append (badGraphText f gs) (sctBadText rest) else sctBadText rest

sctDiag : List (Pair (Pair String String) (List (List ScEdge))) -> String
sctDiag table = joinComma (dedup (sctBadText table))

-- 盲调用（callee 以值传递 / 遍历预算耗尽）只按弱边计入；单独点名，避免与
-- 「有调用但关系证不出」的图混在一起读。
isBlindSite : Site -> Bool
isBlindSite s = s.siteBlind

blindPairText : Site -> String
blindPairText s = "${s.siteCaller}->${s.siteCallee}"

sctBlindNote : List Site -> String
sctBlindNote sites =
  case dedup (map blindPairText (filter isBlindSite sites)) of
    [] => ""
    ns =>
      " [SCT 未识别调用：${joinComma ns}（callee 以值传递或遍历预算耗尽，只按弱边计入）]"

export sctCheck : List String -> HashMap String (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> Diagnostic -> Check Int
sctCheck comp defTbl ctors projs facts msg =
  obsCheck "vuna.term.sct" (\_ => sctCheckGo comp defTbl ctors projs facts msg)

-- | 表内图总数（SCT 规模读数）。
countGraphs : List (Pair (Pair String String) (List (List ScEdge))) -> Int
countGraphs [] = 0
countGraphs ((Pair k gs) :: rest) = length gs + countGraphs rest

sctCheckGo : List String -> HashMap String (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> Diagnostic -> Check Int
sctCheckGo comp defTbl ctors projs facts msg =
  let
    sites = siteCollect comp ctors projs defTbl facts
    note = sctBlindNote sites
    _ = Obs.obsCounter "vuna.counter.term.scc_size" (length comp)
    _ = Obs.obsCounter "vuna.counter.term.sites" (length sites)
  in case initialTable defTbl sites ctors projs facts of
    Pair table0 ok0 =>
      if ok0 then
        let
          _ = Obs.obsCounter "vuna.counter.term.graphs" (countGraphs table0)
        in case closureLoop table0 sctClosureFuel of
          Pair table1 (Pair closed remaining) =>
            let
              _ = Obs.obsCounter "vuna.counter.term.closure_rounds" (sctClosureFuel - remaining)
              _ = Obs.obsCounter "vuna.counter.term.graphs_final" (countGraphs table1)
            in if closed then if sctCheckTable table1 then OkC 0 else ErrC (appendMessage note (appendMessage " [SCT 无下降环：${sctDiag table1}]" msg)) else ErrC (appendMessage note (appendMessage " [SCT 放弃：size-change 图闭包未收敛（每对函数上限 ${strFromInt tableGraphCap} 张图，${strFromInt sctClosureFuel} 轮）]" msg))
      else
        ErrC (appendMessage note (appendMessage " [SCT 放弃：size-change 图闭包未收敛（每对函数上限 ${strFromInt tableGraphCap} 张图，${strFromInt sctClosureFuel} 轮）]" msg))

-- ===============================================================
-- 12. fuel 线程判据：组内函数的某个形参是 Int fuel（通常第 0 个，也可能在别的
-- 位置，如 `elsePartDoc blocky fuel …`），函数体以 `if fuel <= 0 then <基例> else <body>`
-- 守卫；每条组内调用把 callee 的 fuel 传成 caller 的 fuel（`=`）或 `fuel - k`（k>0，
-- 严格下降）；每个环至少一条严格边。则任意调用链的 fuel 严格下降，触底即返回基例
-- ⇒ 终止（Int 可负也安全：callee 在 fuel <= 0 时不再递归）。不涉及具体函数/豁免。
-- ===============================================================
paramNamesOf : List Pat -> List String
paramNamesOf [] = []
paramNamesOf (p :: rest) =
  case p of
    PVar n sp => n :: paramNamesOf rest
    _ => paramNamesOf rest

paramIndexGo : List Pat -> String -> Int -> Maybe Int
paramIndexGo [] name i = Nothing
paramIndexGo (p :: rest) name i =
  case p of
    PVar n sp => if n == name then Just i else paramIndexGo rest name (i + 1)
    _ => paramIndexGo rest name (i + 1)

hasFuelGuard : String -> Expr -> Bool
hasFuelGuard p0 (EIf c t el sp) =
  case guardPosVar c of
    Just v => v == p0
    Nothing => False
hasFuelGuard p0 _ = False

guardParamGo : List String -> Expr -> Maybe String
guardParamGo [] body = Nothing
guardParamGo (n :: rest) body = if hasFuelGuard n body then Just n else guardParamGo rest body

-- | 首个 clause 里被 `<= 0` 守卫的形参名（fuel 参数）。
fuelParamNameOf : String -> HashMap String (List (Pair (List Pat) Expr)) -> Maybe String
fuelParamNameOf name defTbl =
  case clausesOfDefTbl name defTbl of
    [] => Nothing
    cl :: rest => guardParamGo (paramNamesOf (firstOf cl)) (secondOf cl)

-- | callee 的 fuel 实参位置：有守卫时取守卫形参；否则按「与 caller 的 fuel 同名」的
-- 形参定位（同一组里命名通常一致），都没有则退回第 0 个参数。
fuelParamIndexOf : String -> String -> HashMap String (List (Pair (List Pat) Expr)) -> Maybe Int
fuelParamIndexOf callee callerFuel defTbl =
  case clausesOfDefTbl callee defTbl of
    [] => Just 0
    cl :: rest =>
      let
        pats = firstOf cl
      in case fuelParamNameOf callee defTbl of
        Just n => paramIndexGo pats n 0
        Nothing =>
          case paramIndexGo pats callerFuel 0 of
            Just i => Just i
            Nothing => Just 0

callerFuelName : String -> HashMap String (List (Pair (List Pat) Expr)) -> String
callerFuelName name defTbl =
  case fuelParamNameOf name defTbl of
    Just n => n
    Nothing =>
      case clausesOfDefTbl name defTbl of
        [] => ""
        cl :: rest =>
          case paramNamesOf (firstOf cl) of
            [] => ""
            n :: rest2 => n

paramsOf : String -> HashMap String (List (Pair (List Pat) Expr)) -> List String
paramsOf name defTbl =
  case clausesOfDefTbl name defTbl of
    [] => []
    cl :: rest => paramNamesOf (firstOf cl)

-- 单个调用点：callee 的 fuel 实参是否 = caller 的 fuel（False）或 fuel-k（True）。
-- caller 有守卫时按守卫变量名匹配；没有守卫时按「实参是 caller 的某个形参 / 形参减 k」
-- 判弱边 / 严格边（这种调用者的环另外由 `fuelAcceptable` 的无守卫子图判定兜住）。
siteFuelStrict : List String -> Maybe String -> Maybe Int -> Site -> Maybe Bool
siteFuelStrict callerParams callerGuard Nothing site = Nothing
siteFuelStrict callerParams callerGuard (Just i) site =
  case nthExpr site.siteArgs i of
    Nothing => Nothing
    Just a =>
      case callerGuard of
        Nothing =>
          case a of
            EApp (EVar op osp) xs sp =>
              if isSubOpName (rnameKey op) then
                case xs of
                  [EVar n nsp, EInt k ksp] => if k > 0 && memName (rnameKey n) callerParams then Just True else Just False
                  _ => Just False
              else
                Just False
            _ => Just False
        Just callerFuel =>
          case a of
            EVar n sp => if rnameKey n == callerFuel then Just False else Nothing
            EApp (EVar op osp) xs sp =>
              if isSubOpName (rnameKey op) then
                case xs of
                  [EVar n nsp, EInt k ksp] => if rnameKey n == callerFuel then if k > 0 then Just True else Nothing else Nothing
                  _ => Nothing
              else
                Nothing
            _ => Nothing

fuelEdgesOf : List String -> HashMap String (List (Pair (List Pat) Expr)) -> List Site -> List (Pair (Pair (Pair String String) Int) Span)
fuelEdgesOf comp defTbl sites = fuelEdgesGo comp defTbl sites []

-- | 收集调用边：识别出「fuel / fuel-k」的站点标严格边，其余**组内**站点按弱边计入。
--   把未识别站点当弱边（而不是丢掉）是判据成立的前提：丢掉会让「弱环」在图上消失。
fuelEdgesGo : List String -> HashMap String (List (Pair (List Pat) Expr)) -> List Site -> List (Pair (Pair (Pair String String) Int) Span) -> List (Pair (Pair (Pair String String) Int) Span)
fuelEdgesGo comp defTbl [] acc = acc
fuelEdgesGo comp defTbl (s :: rest) acc =
  let
    inGroup = memName s.siteCallee comp
    mode =
      case siteFuelStrict (paramsOf s.siteCaller defTbl) (fuelParamNameOf s.siteCaller defTbl) (fuelParamIndexOf s.siteCallee (callerFuelName s.siteCaller defTbl) defTbl) s of
        Just True => 1
        Just False => 0
        Nothing => 0
    acc2 =
      if inGroup then
        Pair (Pair (Pair s.siteCaller s.siteCallee) mode) (Span "" 0 0 0 0 0 0) :: acc
      else
        acc
  in fuelEdgesGo comp defTbl rest acc2

-- | 单个成员是否有 `fuel <= 0` 守卫（取首个 clause 里的守卫参数）。
memberGuarded : String -> HashMap String (List (Pair (List Pat) Expr)) -> Bool
memberGuarded f defTbl =
  case fuelParamNameOf f defTbl of
    Just _ => True
    Nothing => False

unguardedOf : List String -> HashMap String (List (Pair (List Pat) Expr)) -> List String
unguardedOf [] defTbl = []
unguardedOf (f :: rest) defTbl =
  if memberGuarded f defTbl then unguardedOf rest defTbl else f :: unguardedOf rest defTbl

-- 只问「有没有环」：严格边也参与，否则同一对之间的严格边会让弱邻接丢失。
allWeakEdges : List (Pair (Pair (Pair String String) Int) Span) -> List (Pair (Pair (Pair String String) Int) Span)
allWeakEdges [] = []
allWeakEdges ((Pair (Pair (Pair c g) m) sp) :: rest) =
  Pair (Pair (Pair c g) 0) sp :: allWeakEdges rest

onlyUnguarded : List String -> List (Pair (Pair (Pair String String) Int) Span) -> List (Pair (Pair (Pair String String) Int) Span)
onlyUnguarded unguarded [] = []
onlyUnguarded unguarded ((Pair (Pair (Pair c g) m) sp) :: rest) =
  if memName c unguarded then
    if memName g unguarded then
      Pair (Pair (Pair c g) m) sp :: onlyUnguarded unguarded rest
    else
      onlyUnguarded unguarded rest
  else
    onlyUnguarded unguarded rest

-- 不含守卫的子图是否有环：有环 ⇒ 存在一条永不触底的路径，判据不成立。
unguardedCycle : List String -> List (Pair (Pair (Pair String String) Int) Span) -> Bool
unguardedCycle unguarded edges =
  hasWeakCycle unguarded (allWeakEdges (onlyUnguarded unguarded edges))

-- | 守卫条件：全组都守卫，或任何环都穿过守卫节点（不含守卫的子图无环）。
-- 后者覆盖「守卫只写在少数几个入口函数上」的写法，仍然 sound：无限下降必然反复
-- 经过守卫节点，而守卫节点在 `fuel <= 0` 时直接返回。
fuelAcceptable : List String -> HashMap String (List (Pair (List Pat) Expr)) -> List (Pair (Pair (Pair String String) Int) Span) -> Bool
fuelAcceptable comp defTbl edges =
  case unguardedOf comp defTbl of
    [] => True
    unguarded => if unguardedCycle unguarded edges then False else True

export tryFuelThread : List String -> HashMap String (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap String (List Int) -> Diagnostic -> Check Int
tryFuelThread comp defTbl ctors projs facts msg =
  let
    sites = siteCollect comp ctors projs defTbl facts
    edges = fuelEdgesOf comp defTbl sites
    strictCount = length (filterModes (map edgeModeOf edges))
  in if strictCount > 0 && fuelAcceptable comp defTbl edges && not (hasWeakCycle comp edges) then
    OkC 0
  else
    ErrC msg

-- | 取边上的参数关系编号。
edgeModeOf : Pair (Pair (Pair String String) Int) Span -> Int
edgeModeOf (Pair (Pair (Pair caller callee) mode) sp) = mode
