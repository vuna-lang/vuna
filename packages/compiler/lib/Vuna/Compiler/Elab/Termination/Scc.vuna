module Vuna.Compiler.Elab.Termination.Scc where

-- Vuna.Compiler.Elab.Termination.Scc：size-change termination 引擎——
-- 参数级 size-change 图、传递闭包、幂等图严格边判定（SCT 定理）。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Base.Obs
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Name
import Vuna.Compiler.Elab.Termination.Measure
import Vuna.Compiler.Frontend.AstQuery

record Site where
  siteCaller : String
  siteCallee : String
  siteArgs : List Expr
  siteSizes : List (String, Int, Int, List Int)
  siteRegion : List String
  -- 编译期看不见实参位置的调用（callee 以值传递 / 遍历预算耗尽）：只落全弱边。
  siteBlind : Bool

-- 遍历预算耗尽或 callee 以值传递时，用「全弱边」占位站点覆盖该 caller 到组内每个
-- 成员：漏掉的调用边仍留在图上，且不可能贡献严格下降（sound 方向）。
blindSitesOf : List String -> String -> List (String, Int, Int, List Int) -> List String -> List Site
blindSitesOf comp caller sizes region = map (\g => Site caller g [] sizes region True) comp

record ScEdge where
  edgeFrom : Int
  edgeTo : Int
  scStrictEdge : Bool

siteCollectList : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> List Expr -> List Site -> List Site
siteCollectList fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectList fuel comp ctors projs caller facts sizes region (a :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectList
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      sizes
      region
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region a acc)

siteCollectFields : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> List (String, Expr) -> List Site -> List Site
siteCollectFields fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectFields fuel comp ctors projs caller facts sizes region ((fn, fe) :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectFields
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      sizes
      region
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fe acc)

siteCollectAlts : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> Expr -> List Alt -> List Site -> List Site
siteCollectAlts fuel comp ctors projs caller facts sizes region scrut [] acc =
  if fuel <= 0 then acc else acc
siteCollectAlts fuel comp ctors projs caller facts sizes region scrut (a :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectAlts
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      sizes
      region
      scrut
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts (extendSizesStrict projs sizes scrut a.altPat) region a.altBody acc)

siteCollectBinds : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> List (Pat, Expr) -> List Site -> List Site
siteCollectBinds fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectBinds fuel comp ctors projs caller facts sizes region ((pat, val) :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    siteCollectBinds
      (fuel - 1)
      comp
      ctors
      projs
      caller
      facts
      (extendSizesStrict projs sizes val pat)
      region
      rest
      (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region val acc)

-- 绑定列表 → 遍历用的 (模式, 表达式) 序列：普通右值一条；局部函数组的每条子句用
-- `PWild` 占位（与旧形态一致，只走子句体）。只做形状转换，不参与递归组。
bindsToWalkPairs : List Binding -> List (Pat, Expr)
bindsToWalkPairs [] = []
bindsToWalkPairs (b :: rest) = append (bindingWalkPairs b) (bindsToWalkPairs rest)

bindingWalkPairs : Binding -> List (Pat, Expr)
bindingWalkPairs (Binding pat (BVal e) sig ref) = [(pat, e)]
bindingWalkPairs (Binding pat (BClauses cs) sig ref) = map clauseWalkPair cs

clauseWalkPair : LocalClause -> (Pat, Expr)
clauseWalkPair c = (PWild (detachedNodeRef (exprSpan c.lcBody)), c.lcBody)

siteCollectStmts : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> List DoStmt -> List Site -> List Site
siteCollectStmts fuel comp ctors projs caller facts sizes region [] acc =
  if fuel <= 0 then acc else acc
siteCollectStmts fuel comp ctors projs caller facts sizes region (s :: rest) acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case s of
      DBind pat e sp => siteCollectStmts (fuel - 1) comp ctors projs caller facts (extendSizesStrict projs sizes e pat) region rest (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region e acc)
      DExpr e sp => siteCollectStmts (fuel - 1) comp ctors projs caller facts sizes region rest (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region e acc)
      DLet binds sp => siteCollectStmts (fuel - 1) comp ctors projs caller facts (extendByBinds projs binds sizes) region rest (siteCollectBinds (fuel - 1) comp ctors projs caller facts sizes region (bindsToWalkPairs binds) acc)

siteWalkC : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> Expr -> List Site -> List Site
siteWalkC fuel comp ctors projs caller facts sizes region e acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case e of
      EApp fn args sp => siteWalkEApp (fuel - 1) comp ctors projs caller facts sizes region fn args acc
      ECase scrut alts sp => siteCollectAlts (fuel - 1) comp ctors projs caller facts sizes region scrut alts (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region scrut acc)
      EIf c t el sp =>
        let
          acc1 = siteWalkC (fuel - 1) comp ctors projs caller facts sizes region c acc
          acc2 = siteWalkC (fuel - 1) comp ctors projs caller facts sizes (append (guardThenPosVars c) region) t acc1
        in siteWalkC (fuel - 1) comp ctors projs caller facts sizes (append (guardElsePosVars c) region) el acc2
      ELam ns b sp => siteWalkC (fuel - 1) comp ctors projs caller facts sizes region b acc
      ELet binds body rec_ sp => siteWalkC (fuel - 1) comp ctors projs caller facts (extendByBinds projs binds sizes) region body (siteCollectBinds (fuel - 1) comp ctors projs caller facts sizes region (bindsToWalkPairs binds) acc)
      EPi n implicit _ dom cod sp => siteWalkC (fuel - 1) comp ctors projs caller facts sizes region cod (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region dom acc)
      EField base f sp => siteWalkC (fuel - 1) comp ctors projs caller facts sizes region base acc
      ERecord rn fields sp => siteCollectFields (fuel - 1) comp ctors projs caller facts sizes region fields acc
      ERecUpdate base fields sp => siteCollectFields (fuel - 1) comp ctors projs caller facts sizes region fields (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region base acc)
      EDo stmts sp => siteCollectStmts (fuel - 1) comp ctors projs caller facts sizes region stmts acc
      EVar n sp => if memName (n) comp then Site caller (n) [] sizes region True :: acc else acc
      _ => acc

siteWalkEApp : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> Expr -> List Expr -> List Site -> List Site
siteWalkEApp fuel comp ctors projs caller facts sizes region fn args acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case groupHead comp fn of
      Just callee => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (Site caller callee args sizes region False :: acc)
      Nothing =>
        case fn of
          EVar nm nsp =>
            case hofSpecOf nm of
              Just spec =>
                case hofLambdaCall spec args of
                  Just hc =>
                    let
                      acc1 = siteCollectList (fuel - 1) comp ctors projs caller facts sizes region hc.hofSideArgs acc
                      sizes2 = extendElemSizes sizes hc.hofListExpr hc.hofElemBinder
                    in siteWalkC (fuel - 1) comp ctors projs caller facts sizes2 region hc.hofBody acc1
                  Nothing => if spec.hofLambdaArity == 1 then siteWalkEAppMap (fuel - 1) comp ctors projs caller facts sizes region fn args acc else siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fn acc)
              Nothing => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fn acc)
          _ => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args (siteWalkC (fuel - 1) comp ctors projs caller facts sizes region fn acc)

siteWalkEAppMap : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> Expr -> List Expr -> List Site -> List Site
siteWalkEAppMap fuel comp ctors projs caller facts sizes region fn args acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    case args of
      [cb, lst] =>
        case cb of
          EApp (EVar g gsp) pargs cbsp => if memName (g) comp then siteWalkMapPartialInline (fuel - 1) comp ctors projs caller facts sizes region (g) pargs lst (nodeRefSpan cbsp) acc else siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc
          EVar g gsp => if memName (g) comp then siteWalkMapPartialInline (fuel - 1) comp ctors projs caller facts sizes region (g) [] lst (nodeRefSpan gsp) acc else siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc
          _ => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc
      _ => siteCollectList (fuel - 1) comp ctors projs caller facts sizes region args acc

siteWalkMapPartialInline : Int -> List String -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List (String, Int, Int, List Int) -> List String -> String -> List Expr -> Expr -> Span -> List Site -> List Site
siteWalkMapPartialInline fuel comp ctors projs caller facts sizes region g pargs lst cbsp acc =
  if fuel <= 0 then
    append (blindSitesOf comp caller sizes region) acc
  else
    let
      acc1 = siteWalkC (fuel - 1) comp ctors projs caller facts sizes region lst acc
      elems = extendElemSizes sizes lst "$elem"
      fullArgs = append pargs [EVar ("$elem") (detachedNodeRef cbsp)]
      acc2 = siteCollectList (fuel - 1) comp ctors projs caller facts sizes region pargs acc1
    in Site caller g fullArgs elems region False :: acc2

-- ---------------------------------------------------------------
-- 别名解析：`let g = f in g x`（f 是同组函数）按直接调用参与尺寸分析。
-- 只在绑定是裸 `PVar` + `EVar` 组内函数时替换；遇到同名 binder 立即屏蔽。
-- ---------------------------------------------------------------
aliasNameOf : (String, String) -> String
aliasNameOf p = firstOf p

lookupAlias : String -> List (String, String) -> Maybe String
lookupAlias n [] = Nothing
lookupAlias n ((k, v) :: rest) = if n == k then Just v else lookupAlias n rest

dropAliases : List String -> List (String, String) -> List (String, String)
dropAliases [] als = als
dropAliases (n :: rest) als = dropAliases rest (filter (\p => aliasNameOf p /= n) als)

aliasOf : List String -> (Pat, Expr) -> Maybe (String, String)
aliasOf comp (PVar g gsp, val) =
  case val of
    EVar n nsp => if memName (n) comp then Just (g, n) else Nothing
    _ => Nothing
aliasOf comp (_, val) = Nothing

inlArgsF : Int -> List String -> List (String, String) -> List Expr -> List Expr
inlArgsF fuel comp als [] = []
inlArgsF fuel comp als (a :: rest) =
  inlGoF (fuel - 1) comp als a :: inlArgsF (fuel - 1) comp als rest

inlFieldsF : Int -> List String -> List (String, String) -> List (String, Expr) -> List (String, Expr)
inlFieldsF fuel comp als [] = []
inlFieldsF fuel comp als ((fn, fe) :: rest) =
  (fn, inlGoF (fuel - 1) comp als fe) :: inlFieldsF (fuel - 1) comp als rest

inlPartsF : Int -> List String -> List (String, String) -> List InterpPart -> List InterpPart
inlPartsF fuel comp als [] = []
inlPartsF fuel comp als (p :: rest) =
  case p of
    IPText t => IPText t :: inlPartsF (fuel - 1) comp als rest
    IPHole e => IPHole (inlGoF (fuel - 1) comp als e) :: inlPartsF (fuel - 1) comp als rest

inlBindsF : Int -> List String -> List (String, String) -> List Binding -> (List Binding, List (String, String))
inlBindsF fuel comp als [] = ([], als)
inlBindsF fuel comp als (b :: rest) =
  let
    b2 = inlBindingF (fuel - 1) comp als b
  in case b2.bindValue of
    BVal rhs =>
      case aliasOf comp (b2.bindPat, rhs) of
        Just a =>
          let
            restP = inlBindsF (fuel - 1) comp (a :: als) rest
          in (firstOf restP, secondOf restP)
        Nothing =>
          let
            restP = inlBindsF (fuel - 1) comp (dropAliases (patNamesOf b2.bindPat) als) rest
          in (b2 :: firstOf restP, secondOf restP)
    BClauses cs =>
      let
        restP = inlBindsF (fuel - 1) comp (dropAliases (patNamesOf b2.bindPat) als) rest
      in (b2 :: firstOf restP, secondOf restP)

inlBindingF : Int -> List String -> List (String, String) -> Binding -> Binding
inlBindingF fuel comp als b =
  let
    value =
      case b.bindValue of
        BVal e => BVal (inlGoF (fuel - 1) comp als e)
        BClauses cs => BClauses (inlClausesF (fuel - 1) comp als cs)
    sig =
      case b.bindSig of
        Just s => Just ({ s | sigType = inlGoF (fuel - 1) comp als s.sigType })
        Nothing => Nothing
  in { b | bindValue = value, bindSig = sig }

inlAltsF : Int -> List String -> List (String, String) -> List Alt -> List Alt
inlAltsF fuel comp als [] = []
inlAltsF fuel comp als (a :: rest) =
  { a | altBody = inlGoF (fuel - 1) comp (dropAliases (patNamesOf a.altPat) als) a.altBody }
    :: inlAltsF (fuel - 1) comp als rest

inlClausesF : Int -> List String -> List (String, String) -> List LocalClause -> List LocalClause
inlClausesF fuel comp als [] = []
inlClausesF fuel comp als (c :: rest) =
  { c | lcBody = inlGoF (fuel - 1) comp (dropAliases (patNamesOfPats c.lcPats) als) c.lcBody }
    :: inlClausesF (fuel - 1) comp als rest

inlStmtsF : Int -> List String -> List (String, String) -> List DoStmt -> List DoStmt
inlStmtsF fuel comp als [] = []
inlStmtsF fuel comp als (s :: rest) =
  case s of
    DBind pat e sp =>
      DBind pat (inlGoF (fuel - 1) comp als e) sp
        :: inlStmtsF (fuel - 1) comp (dropAliases (patNamesOf pat) als) rest
    DExpr e sp => DExpr (inlGoF (fuel - 1) comp als e) sp :: inlStmtsF (fuel - 1) comp als rest
    DLet binds sp =>
      let
        p = inlBindsF (fuel - 1) comp als binds
      in DLet (firstOf p) sp :: inlStmtsF (fuel - 1) comp (secondOf p) rest

inlGoF : Int -> List String -> List (String, String) -> Expr -> Expr
inlGoF fuel comp als e =
  if fuel <= 0 then
    e
  else
    case e of
      EVar n sp =>
        case lookupAlias (n) als of
          Just target => EVar (target) sp
          Nothing => EVar n sp
      ELam ns body sp => ELam ns (inlGoF (fuel - 1) comp (dropAliases (map firstOf ns) als) body) sp
      EApp fn args sp => EApp (inlGoF (fuel - 1) comp als fn) (inlArgsF (fuel - 1) comp als args) sp
      EPi n implicit qty dom cod sp => EPi n implicit qty (inlGoF (fuel - 1) comp als dom) (inlGoF (fuel - 1) comp (dropAliases [n] als) cod) sp
      ELet binds body rec_ sp =>
        let
          p = inlBindsF (fuel - 1) comp als binds
        in ELet (firstOf p) (inlGoF (fuel - 1) comp (secondOf p) body) rec_ sp
      ECase scrut alts sp => ECase (inlGoF (fuel - 1) comp als scrut) (inlAltsF (fuel - 1) comp als alts) sp
      EIf c t el sp => EIf (inlGoF (fuel - 1) comp als c) (inlGoF (fuel - 1) comp als t) (inlGoF (fuel - 1) comp als el) sp
      EField base f sp => EField (inlGoF (fuel - 1) comp als base) f sp
      ERecord rn fields sp => ERecord rn (inlFieldsF (fuel - 1) comp als fields) sp
      ERecUpdate base fields sp => ERecUpdate (inlGoF (fuel - 1) comp als base) (inlFieldsF (fuel - 1) comp als fields) sp
      EDo stmts sp => EDo (inlStmtsF (fuel - 1) comp als stmts) sp
      EInterp parts sp => EInterp (inlPartsF (fuel - 1) comp als parts) sp
      _ => e

inlineAliases : List String -> Expr -> Expr
inlineAliases comp e = inlGoF (exprBudget 32 e) comp [] e

siteCollectClauses : List String -> List String -> List (String, List Int) -> HashMap String (List Int) -> String -> List (List Pat, Expr) -> List Site -> List Site
siteCollectClauses comp ctors projs facts caller [] acc = acc
siteCollectClauses comp ctors projs facts caller (cl :: rest) acc =
  let
    body = inlineAliases comp (secondOf cl)
  in siteCollectClauses
    comp
    ctors
    projs
    facts
    caller
    rest
    (siteWalkC (exprBudget 32 body) comp ctors projs caller facts (strSizeEntries (firstOf cl)) [] body acc)

siteCollect : List String -> List String -> List (String, List Int) -> HashMap String (List (List Pat, Expr)) -> HashMap String (List Int) -> List Site
siteCollect comp ctors projs defTbl facts = siteCollectGo comp ctors projs defTbl facts comp []

siteCollectGo : List String -> List String -> List (String, List Int) -> HashMap String (List (List Pat, Expr)) -> HashMap String (List Int) -> List String -> List Site -> List Site
siteCollectGo comp ctors projs defTbl facts [] acc = acc
siteCollectGo comp ctors projs defTbl facts (f :: rest) acc =
  siteCollectGo
    comp
    ctors
    projs
    defTbl
    facts
    rest
    (siteCollectClauses comp ctors projs facts f (clausesOfDefTbl f defTbl) acc)

scIsStrict : Int -> Bool
scIsStrict m = m /= 0

maxBaseOf : List (String, Int, Int, List Int) -> Int
maxBaseOf [] = 0
maxBaseOf ((n, base, depth, path) :: rest) = maxInt base (maxBaseOf rest)

insertEdge : ScEdge -> List ScEdge -> List ScEdge
insertEdge e [] = [e]
insertEdge e (x :: rest) =
  if e.edgeFrom < x.edgeFrom then
    e :: x :: rest
  else if e.edgeFrom == x.edgeFrom then
    if e.edgeTo <= x.edgeTo then e :: x :: rest else x :: insertEdge e rest
  else
    x :: insertEdge e rest

sortEdges : List ScEdge -> List ScEdge
sortEdges [] = []
sortEdges (e :: rest) = insertEdge e (sortEdges rest)

mergeStrict : ScEdge -> ScEdge -> ScEdge
mergeStrict a b = ScEdge a.edgeFrom a.edgeTo (if a.scStrictEdge then True else b.scStrictEdge)

compactEdges : List ScEdge -> List ScEdge
compactEdges [] = []
compactEdges (e :: rest) =
  case rest of
    [] => [e]
    x :: xs =>
      if e.edgeFrom == x.edgeFrom then
        if e.edgeTo == x.edgeTo then mergeStrict e x :: compactEdges xs else e :: compactEdges rest
      else
        e :: compactEdges rest

canonEdges : List ScEdge -> List ScEdge
canonEdges edges = compactEdges (sortEdges edges)

edgesEqCanon : List ScEdge -> List ScEdge -> Bool
edgesEqCanon [] [] = True
edgesEqCanon (x :: xs) (y :: ys) =
  if x.edgeFrom == y.edgeFrom then
    if x.edgeTo == y.edgeTo then
      if x.scStrictEdge == y.scStrictEdge then edgesEqCanon xs ys else False
    else
      False
  else
    False
edgesEqCanon (x :: xs) [] = False
edgesEqCanon [] (y :: ys) = False

edgesEq : List ScEdge -> List ScEdge -> Bool
edgesEq a b = edgesEqCanon (canonEdges a) (canonEdges b)

combineWith : ScEdge -> List ScEdge -> List ScEdge
combineWith e [] = []
combineWith e (x :: rest) =
  if e.edgeTo == x.edgeFrom then
    ScEdge e.edgeFrom x.edgeTo (if e.scStrictEdge then True else x.scStrictEdge)
      :: combineWith e rest
  else
    combineWith e rest

composeGo : List ScEdge -> List ScEdge -> List ScEdge
composeGo [] g2 = []
composeGo (e :: rest) g2 = append (combineWith e g2) (composeGo rest g2)

composeEdges : List ScEdge -> List ScEdge -> List ScEdge
composeEdges g1 g2 = canonEdges (composeGo g1 g2)

hasStrict : List ScEdge -> Bool
hasStrict [] = False
hasStrict (e :: rest) = e.scStrictEdge || hasStrict rest

graphIdempotent : List ScEdge -> Bool
graphIdempotent edges = edgesEq (composeEdges edges edges) edges

-- `closureLoop` 收敛后，表是传递闭包的超集：非幂等图还会在闭包里继续合成，所以
-- 只在幂等图上要求严格边（SCT 定理）。未收敛的闭包不进这里判定。
graphOK : List ScEdge -> Bool
graphOK edges = if graphIdempotent edges then hasStrict edges else True

graphsOK : List (List ScEdge) -> Bool
graphsOK [] = True
graphsOK (g :: rest) = graphOK g && graphsOK rest

-- ---------------------------------------------------------------
-- 表：pair -> 图集合
-- ---------------------------------------------------------------
tableGraphCap : Int
tableGraphCap = 512

tableLookup : (String, String) -> List ((String, String), List (List ScEdge)) -> Maybe (List (List ScEdge))
tableLookup k [] = Nothing
tableLookup k ((k2, gs) :: rest) =
  if firstOf k == firstOf k2 then
    if secondOf k == secondOf k2 then Just gs else tableLookup k rest
  else
    tableLookup k rest

graphListHas : List ScEdge -> List (List ScEdge) -> Bool
graphListHas g [] = False
graphListHas g (x :: rest) = edgesEq g x || graphListHas g rest

graphListSubset : List (List ScEdge) -> List (List ScEdge) -> Bool
graphListSubset [] b = True
graphListSubset (g :: rest) b = graphListHas g b && graphListSubset rest b

tableAddPair : String -> String -> List ScEdge -> List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge))
tableAddPair f g edges [] = [((f, g), [edges])]
tableAddPair f g edges (((f2, g2), gs) :: rest) =
  if f == f2 then
    if g == g2 then ((f, g), edges :: gs) :: rest else ((f2, g2), gs) :: tableAddPair f g edges rest
  else
    ((f2, g2), gs) :: tableAddPair f g edges rest

tableAdd : String -> String -> List ScEdge -> List ((String, String), List (List ScEdge)) -> (List ((String, String), List (List ScEdge)), Bool)
tableAdd f g edges table =
  case tableLookup (f, g) table of
    Nothing => (tableAddPair f g edges table, True)
    Just gs =>
      if graphListHas edges gs then
        (table, True)
      else if length gs >= tableGraphCap then
        (table, False)
      else
        (tableAddPair f g edges table, True)

-- ---------------------------------------------------------------
-- 传递闭包（每轮：对表中每张图 a:(f,g) 与每张图 b:(g,h) 合成加入 (f,h)）
-- ---------------------------------------------------------------
closureStepHs : String -> String -> List ScEdge -> List (List ScEdge) -> List ((String, String), List (List ScEdge)) -> (List ((String, String), List (List ScEdge)), Bool)
closureStepHs f h a [] acc = (acc, True)
closureStepHs f h a (b :: bs) acc =
  case tableAdd f h (composeEdges a b) acc of
    (acc2, True) => closureStepHs f h a bs acc2
    (acc2, False) => (acc2, False)

closureStepOne : String -> String -> List ScEdge -> List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge)) -> (List ((String, String), List (List ScEdge)), Bool)
closureStepOne f g a table acc = closureStepOneGo f g a table acc True

closureStepOneGo : String -> String -> List ScEdge -> List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge)) -> Bool -> (List ((String, String), List (List ScEdge)), Bool)
closureStepOneGo f g a [] acc ok = (acc, ok)
closureStepOneGo f g a (((g2, h), hs) :: rest) acc ok =
  if g2 == g then
    case closureStepHs f h a hs acc of
      (acc2, ok2@True) => closureStepOneGo f g a rest acc2 ok2
      (acc2, False) => (acc2, False)
  else
    closureStepOneGo f g a rest acc ok

closureStepGraphs : String -> String -> List (List ScEdge) -> List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge)) -> (List ((String, String), List (List ScEdge)), Bool)
closureStepGraphs f g [] table acc = (acc, True)
closureStepGraphs f g (a :: arest) table acc =
  case closureStepOne f g a table acc of
    (acc2, True) => closureStepGraphs f g arest table acc2
    (acc2, False) => (acc2, False)

closureStepGo : List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge)) -> (List ((String, String), List (List ScEdge)), Bool)
closureStepGo [] table acc = (acc, True)
closureStepGo (((f, g), gs) :: rest) table acc =
  case closureStepGraphs f g gs table acc of
    (acc2, True) => closureStepGo rest table acc2
    (acc2, False) => (acc2, False)

closureStep : List ((String, String), List (List ScEdge)) -> (List ((String, String), List (List ScEdge)), Bool)
closureStep table = closureStepGo table table table

tableSame : List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge)) -> Bool
tableSame a b = length a == length b && tableSubset a b

tableSubset : List ((String, String), List (List ScEdge)) -> List ((String, String), List (List ScEdge)) -> Bool
tableSubset [] b = True
tableSubset ((k, gs) :: rest) b =
  case tableLookup k b of
    Nothing => False
    Just gs2 => graphListSubset gs gs2 && tableSubset rest b

closureLoop : List ((String, String), List (List ScEdge)) -> Int -> (List ((String, String), List (List ScEdge)), Bool, Int)
closureLoop table fuel =
  if fuel <= 0 then
    (table, False, fuel)
  else
    case closureStep table of
      (table2, True) => if tableSame table table2 then (table2, True, fuel) else closureLoop table2 (fuel - 1)
      (table2, False) => (table2, False, fuel)

-- ---------------------------------------------------------------
-- 从调用点构造图
-- ---------------------------------------------------------------

-- 实参依赖的 caller 形参位：关系证不出时用它决定落哪些弱边。只按真实依赖落边，
-- 否则 `f x y = f x (y - 1)` 会凭空得到 0→1 / 1→0 的弱环，把正常程序判失败。
argBases : List (String, Int, Int, List Int) -> Expr -> List Int
argBases sizes e = dedupBases (argBasesGo sizes [] e)

basesUpToGo : Int -> List Int -> List Int
basesUpToGo i acc = if i <= 0 then 0 :: acc else basesUpToGo (i - 1) (i :: acc)

basesUpTo : Int -> List Int
basesUpTo n = if n < 0 then [] else basesUpToGo n []

hasBase : Int -> List Int -> Bool
hasBase i [] = False
hasBase i (x :: rest) = i == x || hasBase i rest

dedupBases : List Int -> List Int
dedupBases [] = []
dedupBases (x :: rest) = if hasBase x rest then dedupBases rest else x :: dedupBases rest

patNamesOf : Pat -> List String
patNamesOf (PVar n sp) = [n]
patNamesOf (PAs n inner sp) = n :: patNamesOf inner
patNamesOf (PCon c ps sp) = patNamesOfPats ps
patNamesOf (PRecord rn fields sp) = patNamesOfFields fields
patNamesOf _ = []

patNamesOfPats : List Pat -> List String
patNamesOfPats [] = []
patNamesOfPats (p :: rest) = append (patNamesOf p) (patNamesOfPats rest)

patNamesOfFields : List (String, Pat) -> List String
patNamesOfFields [] = []
patNamesOfFields ((fn, fp) :: rest) = append (patNamesOf fp) (patNamesOfFields rest)

patNamesOfBinds : List Binding -> List String
patNamesOfBinds [] = []
patNamesOfBinds (b :: rest) = append (patNamesOf b.bindPat) (patNamesOfBinds rest)

argBasesGo : List (String, Int, Int, List Int) -> List String -> Expr -> List Int
argBasesGo sizes locals e = argBasesGoF (exprBudget 32 e) sizes locals e

argBasesGoF : Int -> List (String, Int, Int, List Int) -> List String -> Expr -> List Int
argBasesGoF fuel sizes locals e =
  if fuel <= 0 then
    []
  else
    case e of
      EVar n sp =>
        case sizeOfVarStrict n sizes of
          Just (base, pr) => [base]
          Nothing => if memName n locals then basesUpTo (maxBaseOf sizes) else []
      ELam ns body sp => argBasesGoF (fuel - 1) sizes (append (map firstOf ns) locals) body
      EApp fn args sp => append (argBasesGoF (fuel - 1) sizes locals fn) (argBasesArgsF (fuel - 1) sizes locals args)
      EPi n implicit qty dom cod sp => append (argBasesGoF (fuel - 1) sizes locals dom) (argBasesGoF (fuel - 1) sizes locals cod)
      ELet binds body rec_ sp => append (argBasesBindsF (fuel - 1) sizes locals binds) (argBasesGoF (fuel - 1) sizes (append (patNamesOfBinds binds) locals) body)
      ECase scrut alts sp => append (argBasesGoF (fuel - 1) sizes locals scrut) (argBasesAltsF (fuel - 1) sizes locals alts)
      EIf c t el sp => append (argBasesGoF (fuel - 1) sizes locals c) (append (argBasesGoF (fuel - 1) sizes locals t) (argBasesGoF (fuel - 1) sizes locals el))
      EField base f sp => argBasesGoF (fuel - 1) sizes locals base
      ERecord rn fields sp => argBasesFieldsF (fuel - 1) sizes locals fields
      ERecUpdate base fields sp => append (argBasesGoF (fuel - 1) sizes locals base) (argBasesFieldsF (fuel - 1) sizes locals fields)
      EDo stmts sp => argBasesStmtsF (fuel - 1) sizes locals stmts
      EInterp parts sp => argBasesPartsF (fuel - 1) sizes locals parts
      _ => []

argBasesArgsF : Int -> List (String, Int, Int, List Int) -> List String -> List Expr -> List Int
argBasesArgsF fuel sizes locals [] = []
argBasesArgsF fuel sizes locals (a :: rest) =
  if fuel <= 0 then
    []
  else
    append (argBasesGoF (fuel - 1) sizes locals a) (argBasesArgsF (fuel - 1) sizes locals rest)

argBasesFieldsF : Int -> List (String, Int, Int, List Int) -> List String -> List (String, Expr) -> List Int
argBasesFieldsF fuel sizes locals [] = []
argBasesFieldsF fuel sizes locals ((fn, fe) :: rest) =
  if fuel <= 0 then
    []
  else
    append (argBasesGoF (fuel - 1) sizes locals fe) (argBasesFieldsF (fuel - 1) sizes locals rest)

argBasesBindsF : Int -> List (String, Int, Int, List Int) -> List String -> List Binding -> List Int
argBasesBindsF fuel sizes locals [] = []
argBasesBindsF fuel sizes locals (b :: rest) =
  if fuel <= 0 then
    []
  else
    append
      (argBasesBindingF (fuel - 1) sizes locals b)
      (argBasesBindsF (fuel - 1) sizes locals rest)

argBasesBindingF : Int -> List (String, Int, Int, List Int) -> List String -> Binding -> List Int
argBasesBindingF fuel sizes locals b =
  if fuel <= 0 then
    []
  else
    let
      value =
        case b.bindValue of
          BVal e => argBasesGoF (fuel - 1) sizes locals e
          BClauses cs => argBasesClausesF (fuel - 1) sizes locals cs
    in case b.bindSig of
      Just sig => append value (argBasesGoF (fuel - 1) sizes locals sig.sigType)
      Nothing => value

argBasesAltsF : Int -> List (String, Int, Int, List Int) -> List String -> List Alt -> List Int
argBasesAltsF fuel sizes locals [] = []
argBasesAltsF fuel sizes locals (a :: rest) =
  if fuel <= 0 then
    []
  else
    append
      (argBasesGoF (fuel - 1) sizes (append (patNamesOf a.altPat) locals) a.altBody)
      (argBasesAltsF (fuel - 1) sizes locals rest)

argBasesClausesF : Int -> List (String, Int, Int, List Int) -> List String -> List LocalClause -> List Int
argBasesClausesF fuel sizes locals [] = []
argBasesClausesF fuel sizes locals (c :: rest) =
  if fuel <= 0 then
    []
  else
    append
      (argBasesGoF (fuel - 1) sizes (append (patNamesOfPats c.lcPats) locals) c.lcBody)
      (argBasesClausesF (fuel - 1) sizes locals rest)

argBasesStmtsF : Int -> List (String, Int, Int, List Int) -> List String -> List DoStmt -> List Int
argBasesStmtsF fuel sizes locals [] = []
argBasesStmtsF fuel sizes locals (s :: rest) =
  if fuel <= 0 then
    []
  else
    case s of
      DBind pat e sp => append (argBasesGoF (fuel - 1) sizes locals e) (argBasesStmtsF (fuel - 1) sizes (append (patNamesOf pat) locals) rest)
      DExpr e sp => append (argBasesGoF (fuel - 1) sizes locals e) (argBasesStmtsF (fuel - 1) sizes locals rest)
      DLet binds sp => append (argBasesBindsF (fuel - 1) sizes locals binds) (argBasesStmtsF (fuel - 1) sizes (append (patNamesOfBinds binds) locals) rest)

argBasesPartsF : Int -> List (String, Int, Int, List Int) -> List String -> List InterpPart -> List Int
argBasesPartsF fuel sizes locals [] = []
argBasesPartsF fuel sizes locals (p :: rest) =
  if fuel <= 0 then
    []
  else
    case p of
      IPText t => argBasesPartsF (fuel - 1) sizes locals rest
      IPHole e => append (argBasesGoF (fuel - 1) sizes locals e) (argBasesPartsF (fuel - 1) sizes locals rest)

-- 盲站点（callee 以值传递 / 遍历预算耗尽）：caller 全形参位 × callee arity 全弱边。
blindEdgesJ : Int -> Int -> List ScEdge
blindEdgesJ arity i =
  if arity <= 0 then [] else ScEdge i (arity - 1) False :: blindEdgesJ (arity - 1) i

blindEdgesI : Int -> Int -> List ScEdge
blindEdgesI i arity =
  if i <= 0 then
    if i == 0 then blindEdgesJ arity 0 else []
  else
    append (blindEdgesJ arity i) (blindEdgesI (i - 1) arity)

blindEdges : HashMap String (List (List Pat, Expr)) -> Site -> List ScEdge
blindEdges defTbl s =
  blindEdgesI
    (defArity (clausesOfDefTbl s.siteCaller defTbl) - 1)
    (defArity (clausesOfDefTbl s.siteCallee defTbl))

siteEdgeAt : Int -> Int -> List Int -> Site -> List String -> List (String, List Int) -> HashMap String (List Int) -> List ScEdge
siteEdgeAt i j deps s ctors projs facts =
  case nthExpr s.siteArgs j of
    Nothing => []
    Just a =>
      case relOfArg i a s.siteSizes ctors projs s.siteCaller facts s.siteRegion of
        Just m => [ScEdge i j (scIsStrict m)]
        -- 关系证不出：按实参真实依赖落弱边，让调用仍留在图上（弱环不能消失）。
        Nothing => if hasBase i deps then [ScEdge i j False] else []

nthDeps : List (List Int) -> Int -> List Int
nthDeps [] i = []
nthDeps (d :: rest) i = if i <= 0 then d else nthDeps rest (i - 1)

siteEdgesJ : Int -> Int -> List (List Int) -> Site -> List String -> List (String, List Int) -> HashMap String (List Int) -> List ScEdge
siteEdgesJ i count deps s ctors projs facts =
  if count <= 0 then
    []
  else
    append
      (siteEdgeAt i (count - 1) (nthDeps deps (count - 1)) s ctors projs facts)
      (siteEdgesJ i (count - 1) deps s ctors projs facts)

siteEdgesI : Int -> List (List Int) -> Site -> List String -> List (String, List Int) -> HashMap String (List Int) -> List ScEdge
siteEdgesI i deps s ctors projs facts =
  if i <= 0 then
    siteEdgesJ 0 (length s.siteArgs) deps s ctors projs facts
  else
    append
      (siteEdgesJ i (length s.siteArgs) deps s ctors projs facts)
      (siteEdgesI (i - 1) deps s ctors projs facts)

siteEdgesOf : HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Site -> List ScEdge
siteEdgesOf defTbl ctors projs facts s =
  if s.siteBlind then
    blindEdges defTbl s
  else
    siteEdgesI (maxBaseOf s.siteSizes) (map (argBases s.siteSizes) s.siteArgs) s ctors projs facts

initialTable : HashMap String (List (List Pat, Expr)) -> List Site -> List String -> List (String, List Int) -> HashMap String (List Int) -> (List ((String, String), List (List ScEdge)), Bool)
initialTable defTbl sites ctors projs facts = initialTableGo defTbl sites ctors projs facts [] True

initialTableGo : HashMap String (List (List Pat, Expr)) -> List Site -> List String -> List (String, List Int) -> HashMap String (List Int) -> List ((String, String), List (List ScEdge)) -> Bool -> (List ((String, String), List (List ScEdge)), Bool)
initialTableGo defTbl [] ctors projs facts acc ok = (acc, ok)
initialTableGo defTbl (s :: rest) ctors projs facts acc ok =
  if ok then
    case tableAdd s.siteCaller s.siteCallee (siteEdgesOf defTbl ctors projs facts s) acc of
      (acc2, ok2) => initialTableGo defTbl rest ctors projs facts acc2 ok2
  else
    (acc, False)

-- ---------------------------------------------------------------
-- 判定
-- ---------------------------------------------------------------
-- 闭包迭代上限：每轮把路径长度翻倍，实际上限来自 `tableGraphCap`（每对函数的图数）。
sctClosureFuel : Int
sctClosureFuel = 240

-- 幂等图的起点必然等于终点（幂等即自合成），所以只检查 `f == g` 的配对。
sctCheckTable : List ((String, String), List (List ScEdge)) -> Bool
sctCheckTable [] = True
sctCheckTable (((f, g), gs) :: rest) =
  if f == g then if graphsOK gs then sctCheckTable rest else False else sctCheckTable rest

sctBadGraphs : String -> List (List ScEdge) -> List String
sctBadGraphs f [] = []
sctBadGraphs f (g :: rest) = if graphOK g then sctBadGraphs f rest else f :: sctBadGraphs f rest

sctBadPairs : List ((String, String), List (List ScEdge)) -> List String
sctBadPairs [] = []
sctBadPairs (((f, g), gs) :: rest) =
  if f == g then append (sctBadGraphs f gs) (sctBadPairs rest) else sctBadPairs rest

edgeText : ScEdge -> String
edgeText e = if e.scStrictEdge then strictEdgeText e else weakEdgeText e

strictEdgeText : ScEdge -> String
strictEdgeText e = "${e.edgeFrom}->>${e.edgeTo}"

weakEdgeText : ScEdge -> String
weakEdgeText e = "${e.edgeFrom}->${e.edgeTo}"

edgesText : List ScEdge -> String
edgesText [] = ""
edgesText [e] = edgeText e
edgesText (e :: rest) = "${edgeText e},${edgesText rest}"

badGraphText : String -> List (List ScEdge) -> List String
badGraphText f [] = []
badGraphText f (g :: rest) =
  if graphOK g then badGraphText f rest else "${f}{${edgesText g}}" :: badGraphText f rest

sctBadText : List ((String, String), List (List ScEdge)) -> List String
sctBadText [] = []
sctBadText (((f, g), gs) :: rest) =
  if f == g then append (badGraphText f gs) (sctBadText rest) else sctBadText rest

sctDiag : List ((String, String), List (List ScEdge)) -> String
sctDiag table = joinComma (dedup (sctBadText table))

-- 盲调用（callee 以值传递 / 遍历预算耗尽）只按弱边计入；单独点名，避免与
-- 「有调用但关系证不出」的图混在一起读。
isBlindSite : Site -> Bool
isBlindSite s = s.siteBlind

blindPairText : Site -> String
blindPairText s = "${s.siteCaller}->${s.siteCallee}"

sctBlindNote : List Site -> String
sctBlindNote sites =
  case dedup (map blindPairText (filter isBlindSite sites)) of
    [] => ""
    ns =>
      " [SCT 未识别调用：${joinComma ns}（callee 以值传递或遍历预算耗尽，只按弱边计入）]"

-- | SCT 放弃（图数 / 轮数上限）用独立错误码：这不是「证明不终止」。
-- 保留上游诊断的位置 / call 字段，只换 code 与模板。
budgetDiagnostic : List String -> Diagnostic -> Diagnostic
budgetDiagnostic comp msg =
  let
    subject = join "," comp
    detail =
      "size-change 图闭包未收敛（每对函数上限 ${strFromInt tableGraphCap} 张图，${strFromInt sctClosureFuel} 轮）"
    base = tcMsg (TerminationBudgetExhausted subject) [subject]
    kept = { base | diagLabels = msg.diagLabels, diagFields = msg.diagFields }
  in appendMessage " [${detail}]" kept

export sctCheck : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Diagnostic -> Check Int
sctCheck comp defTbl ctors projs facts msg =
  obsCheck "vuna.term.sct" (\_ => sctCheckGo comp defTbl ctors projs facts msg)

-- | 表内图总数（SCT 规模读数）。
countGraphs : List ((String, String), List (List ScEdge)) -> Int
countGraphs [] = 0
countGraphs ((k, gs) :: rest) = length gs + countGraphs rest

sctCheckGo : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Diagnostic -> Check Int
sctCheckGo comp defTbl ctors projs facts msg =
  let
    sites = siteCollect comp ctors projs defTbl facts
    note = sctBlindNote sites
    _ = obsCounter "vuna.counter.term.scc_size" (length comp)
    _ = obsCounter "vuna.counter.term.sites" (length sites)
  in case initialTable defTbl sites ctors projs facts of
    (table0, ok0) =>
      if ok0 then
        let
          _ = obsCounter "vuna.counter.term.graphs" (countGraphs table0)
        in case closureLoop table0 sctClosureFuel of
          (table1, closed, remaining) =>
            let
              _ = obsCounter "vuna.counter.term.closure_rounds" (sctClosureFuel - remaining)
              _ = obsCounter "vuna.counter.term.graphs_final" (countGraphs table1)
            in if closed then if sctCheckTable table1 then OkC 0 else ErrC (appendMessage note (appendMessage " [SCT 无下降环：${sctDiag table1}]" msg)) else ErrC (appendMessage note (budgetDiagnostic comp msg))
      else
        ErrC (appendMessage note (budgetDiagnostic comp msg))

-- ===============================================================
-- 12. fuel 线程判据：组内函数的某个形参是 Int fuel（通常第 0 个，也可能在别的
-- 位置，如 `elsePartDoc blocky fuel …`），函数体以 `if fuel <= 0 then <基例> else <body>`
-- 守卫；每条组内调用把 callee 的 fuel 传成 caller 的 fuel（`=`）或 `fuel - k`（k>0，
-- 严格下降）；每个环至少一条严格边。则任意调用链的 fuel 严格下降，触底即返回基例
-- ⇒ 终止（Int 可负也安全：callee 在 fuel <= 0 时不再递归）。不涉及具体函数/豁免。
-- ===============================================================
paramNamesOf : List Pat -> List String
paramNamesOf [] = []
paramNamesOf (p :: rest) =
  case p of
    PVar n sp => n :: paramNamesOf rest
    _ => paramNamesOf rest

paramIndexGo : List Pat -> String -> Int -> Maybe Int
paramIndexGo [] name i = Nothing
paramIndexGo (p :: rest) name i =
  case p of
    PVar n sp => if n == name then Just i else paramIndexGo rest name (i + 1)
    _ => paramIndexGo rest name (i + 1)

-- | `p0` 是否在体里被某个 `if p0 <= 0` 守卫。
--
-- 精化后多子句函数的体先是一层 `case`（子句模式），守卫在各分支里；源码层每个 clause
-- 的体顶层就是 `if`。两层都看，判定口径保持「这个形参是 fuel」。
hasFuelGuard : String -> Expr -> Bool
hasFuelGuard p0 e = hasFuelGuardF (exprBudget 32 e) p0 e

hasFuelGuardF : Int -> String -> Expr -> Bool
hasFuelGuardF fuel p0 e =
  if fuel <= 0 then
    False
  else
    case e of
      EIf c t el sp =>
        case guardPosVar c of
          Just v => v == p0
          Nothing => hasFuelGuardF (fuel - 1) p0 t || hasFuelGuardF (fuel - 1) p0 el
      ECase scrut alts sp => anyAltFuelGuardF (fuel - 1) p0 alts
      ELet binds body rec_ sp => hasFuelGuardF (fuel - 1) p0 body || anyBindFuelGuardF (fuel - 1) p0 binds
      ELam ns b sp => hasFuelGuardF (fuel - 1) p0 b
      _ => False

anyAltFuelGuardF : Int -> String -> List Alt -> Bool
anyAltFuelGuardF fuel p0 [] = False
anyAltFuelGuardF fuel p0 (a :: rest) =
  if fuel <= 0 then
    False
  else
    hasFuelGuardF (fuel - 1) p0 a.altBody || anyAltFuelGuardF (fuel - 1) p0 rest

anyBindFuelGuardF : Int -> String -> List Binding -> Bool
anyBindFuelGuardF fuel p0 [] = False
anyBindFuelGuardF fuel p0 (b :: rest) =
  if fuel <= 0 then
    False
  else
    bindingHasFuelGuardF (fuel - 1) p0 b || anyBindFuelGuardF (fuel - 1) p0 rest

bindingHasFuelGuardF : Int -> String -> Binding -> Bool
bindingHasFuelGuardF fuel p0 b =
  if fuel <= 0 then
    False
  else
    let
      value =
        case b.bindValue of
          BVal e => hasFuelGuardF (fuel - 1) p0 e
          BClauses cs => anyClauseFuelGuardF (fuel - 1) p0 cs
    in if value then
      True
    else
      case b.bindSig of
        Just sig => hasFuelGuardF (fuel - 1) p0 sig.sigType
        Nothing => False

anyClauseFuelGuardF : Int -> String -> List LocalClause -> Bool
anyClauseFuelGuardF fuel p0 [] = False
anyClauseFuelGuardF fuel p0 (c :: rest) =
  if fuel <= 0 then
    False
  else
    hasFuelGuardF (fuel - 1) p0 c.lcBody || anyClauseFuelGuardF (fuel - 1) p0 rest

guardParamGo : List String -> Expr -> Maybe String
guardParamGo [] body = Nothing
guardParamGo (n :: rest) body = if hasFuelGuard n body then Just n else guardParamGo rest body

-- | 首个 clause 里被 `<= 0` 守卫的形参名（fuel 参数）。
fuelParamNameOf : String -> HashMap String (List (List Pat, Expr)) -> Maybe String
fuelParamNameOf name defTbl =
  case clausesOfDefTbl name defTbl of
    [] => Nothing
    cl :: rest => guardParamGo (paramNamesOf (firstOf cl)) (secondOf cl)

-- | callee 的 fuel 实参位置：有守卫时取守卫形参；否则按「与 caller 的 fuel 同名」的
-- 形参定位（同一组里命名通常一致），都没有则退回第 0 个参数。
fuelParamIndexOf : String -> String -> HashMap String (List (List Pat, Expr)) -> Maybe Int
fuelParamIndexOf callee callerFuel defTbl =
  case clausesOfDefTbl callee defTbl of
    [] => Just 0
    cl :: rest =>
      let
        pats = firstOf cl
      in case fuelParamNameOf callee defTbl of
        Just n => paramIndexGo pats n 0
        Nothing =>
          case paramIndexGo pats callerFuel 0 of
            Just i => Just i
            Nothing => Just 0

callerFuelName : String -> HashMap String (List (List Pat, Expr)) -> String
callerFuelName name defTbl =
  case fuelParamNameOf name defTbl of
    Just n => n
    Nothing =>
      case clausesOfDefTbl name defTbl of
        [] => ""
        cl :: rest =>
          case paramNamesOf (firstOf cl) of
            [] => ""
            n :: rest2 => n

paramsOf : String -> HashMap String (List (List Pat, Expr)) -> List String
paramsOf name defTbl =
  case clausesOfDefTbl name defTbl of
    [] => []
    cl :: rest => paramNamesOf (firstOf cl)

-- 单个调用点：callee 的 fuel 实参是否 = caller 的 fuel（False）或 fuel-k（True）。
-- caller 有守卫时按守卫变量名匹配；没有守卫时按「实参是 caller 的某个形参 / 形参减 k」
-- 判弱边 / 严格边（这种调用者的环另外由 `fuelAcceptable` 的无守卫子图判定兜住）。
siteFuelStrict : List String -> Maybe String -> Maybe Int -> Site -> Maybe Bool
siteFuelStrict callerParams callerGuard Nothing site = Nothing
siteFuelStrict callerParams callerGuard (Just i) site =
  case nthExpr site.siteArgs i of
    Nothing => Nothing
    Just a =>
      case callerGuard of
        Nothing =>
          case a of
            EApp (EVar op osp) xs sp =>
              if isSubOpName (op) then
                case xs of
                  [EVar n nsp, EInt k ksp] => if k > 0 && memName (n) callerParams then Just True else Just False
                  _ => Just False
              else
                Just False
            _ => Just False
        Just callerFuel =>
          case a of
            EVar n sp => if n == callerFuel then Just False else Nothing
            EApp (EVar op osp) xs sp =>
              if isSubOpName (op) then
                case xs of
                  [EVar n nsp, EInt k ksp] => if n == callerFuel then if k > 0 then Just True else Nothing else Nothing
                  _ => Nothing
              else
                Nothing
            _ => Nothing

fuelEdgesOf : List String -> HashMap String (List (List Pat, Expr)) -> List Site -> List (((String, String), Int), Span)
fuelEdgesOf comp defTbl sites = fuelEdgesGo comp defTbl sites []

-- | 收集调用边：识别出「fuel / fuel-k」的站点标严格边，其余**组内**站点按弱边计入。
--   把未识别站点当弱边（而不是丢掉）是判据成立的前提：丢掉会让「弱环」在图上消失。
fuelEdgesGo : List String -> HashMap String (List (List Pat, Expr)) -> List Site -> List (((String, String), Int), Span) -> List (((String, String), Int), Span)
fuelEdgesGo comp defTbl [] acc = acc
fuelEdgesGo comp defTbl (s :: rest) acc =
  let
    inGroup = memName s.siteCallee comp
    mode =
      case siteFuelStrict (paramsOf s.siteCaller defTbl) (fuelParamNameOf s.siteCaller defTbl) (fuelParamIndexOf s.siteCallee (callerFuelName s.siteCaller defTbl) defTbl) s of
        Just True => 1
        Just False => 0
        Nothing => 0
    acc2 =
      if inGroup then (((s.siteCaller, s.siteCallee), mode), Span "" 0 0 0 0 0 0) :: acc else acc
  in fuelEdgesGo comp defTbl rest acc2

-- | 单个成员是否有 `fuel <= 0` 守卫（取首个 clause 里的守卫参数）。
memberGuarded : String -> HashMap String (List (List Pat, Expr)) -> Bool
memberGuarded f defTbl =
  case fuelParamNameOf f defTbl of
    Just _ => True
    Nothing => False

unguardedOf : List String -> HashMap String (List (List Pat, Expr)) -> List String
unguardedOf [] defTbl = []
unguardedOf (f :: rest) defTbl =
  if memberGuarded f defTbl then unguardedOf rest defTbl else f :: unguardedOf rest defTbl

-- 只问「有没有环」：严格边也参与，否则同一对之间的严格边会让弱邻接丢失。
allWeakEdges : List (((String, String), Int), Span) -> List (((String, String), Int), Span)
allWeakEdges [] = []
allWeakEdges ((((c, g), m), sp) :: rest) = (((c, g), 0), sp) :: allWeakEdges rest

onlyUnguarded : List String -> List (((String, String), Int), Span) -> List (((String, String), Int), Span)
onlyUnguarded unguarded [] = []
onlyUnguarded unguarded ((((c, g), m), sp) :: rest) =
  if memName c unguarded then
    if memName g unguarded then
      (((c, g), m), sp) :: onlyUnguarded unguarded rest
    else
      onlyUnguarded unguarded rest
  else
    onlyUnguarded unguarded rest

-- 不含守卫的子图是否有环：有环 ⇒ 存在一条永不触底的路径，判据不成立。
unguardedCycle : List String -> List (((String, String), Int), Span) -> Bool
unguardedCycle unguarded edges =
  hasWeakCycle unguarded (allWeakEdges (onlyUnguarded unguarded edges))

-- | 守卫条件：全组都守卫，或任何环都穿过守卫节点（不含守卫的子图无环）。
-- 后者覆盖「守卫只写在少数几个入口函数上」的写法，仍然 sound：无限下降必然反复
-- 经过守卫节点，而守卫节点在 `fuel <= 0` 时直接返回。
fuelAcceptable : List String -> HashMap String (List (List Pat, Expr)) -> List (((String, String), Int), Span) -> Bool
fuelAcceptable comp defTbl edges =
  case unguardedOf comp defTbl of
    [] => True
    unguarded => if unguardedCycle unguarded edges then False else True

export tryFuelThread : List String -> HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Int) -> HashMap String (List Int) -> Diagnostic -> Check Int
tryFuelThread comp defTbl ctors projs facts msg =
  let
    sites = siteCollect comp ctors projs defTbl facts
    edges = fuelEdgesOf comp defTbl sites
    strictCount = length (filterModes (map edgeModeOf edges))
  in if strictCount > 0 && fuelAcceptable comp defTbl edges && not (hasWeakCycle comp edges) then
    OkC 0
  else
    ErrC msg

-- | 取边上的参数关系编号。
edgeModeOf : (((String, String), Int), Span) -> Int
edgeModeOf (((caller, callee), mode), sp) = mode
