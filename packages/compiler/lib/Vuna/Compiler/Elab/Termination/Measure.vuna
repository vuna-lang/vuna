module Vuna.Compiler.Elab.Termination.Measure where

-- Vuna.Compiler.Elab.Termination.Measure：DT 终止性判据的共享底座——
-- 基础工具、定义分组、构造子名、size 表、守卫 Int 的正事实、投影分析、调用点关系、
-- 以及弱边/环检测。入口与 SCC 判定在 `Vuna.Compiler.Elab.Termination`，SCT 在 `.Scc`。
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Name
import Vuna.Compiler.Frontend.AstQuery

export maxInt : Int -> Int -> Int
maxInt a b = if a >= b then a else b

export notEmpty : List a -> Bool
notEmpty [] = False
notEmpty _ = True

export allEqTo : Int -> List Int -> Bool
allEqTo x [] = True
allEqTo x (y :: rest) = x == y && allEqTo x rest

export allSame : List Int -> Bool
allSame [] = True
allSame (x :: rest) = allEqTo x rest

-- | 保序字符串去重（重复名只保留最后一次出现；`Base.nubNames` 的既有入口名）。
export dedup : List String -> List String
dedup names = nubNames names

export joinComma : List String -> String
joinComma [] = ""
joinComma [x] = x
joinComma (x :: rest) = "${x}, ${joinComma rest}"

-- | 分析「放弃」的结论：预算 / 容量 / 可观察范围不足时，不能把没证出来当成
--   「证明不终止」。用户面统一渲染成 `TC_TerminationBudgetExhausted`。
export data GiveUp(..) : Type where
  NoGiveUp : GiveUp
  GaveUp : String -> GiveUp

export isGaveUp : GiveUp -> Bool
isGaveUp NoGiveUp = False
isGaveUp (GaveUp _) = True

export gaveUpDetail : GiveUp -> String
gaveUpDetail NoGiveUp = ""
gaveUpDetail (GaveUp d) = d

-- 合并两处放弃原因：保留先出现的那条（调用方只关心「是否放弃」与原因文本）。
export mergeGiveUp : GiveUp -> GiveUp -> GiveUp
mergeGiveUp NoGiveUp b = b
mergeGiveUp a _ = a

-- 正数事实表：函数名 + 形参下标。
export posHas : String -> Int -> List (String, Int) -> Bool
posHas f i [] = False
posHas f i ((g, j) :: rest) =
  if f == g then if i == j then True else posHas f i rest else posHas f i rest

-- facts 的 O(1) 查找：name → 正位置列表。不动点每轮建一次表（posWalk 逐节点查 facts）；
-- 逐实参位置线性扫整个 facts 列表会随 def 数增长呈 n²。
export posTblOf : List (String, Int) -> HashMap String (List Int)
posTblOf xs = posTblOfGo xs (HashMap.fromList [])

posTblOfGo : List (String, Int) -> HashMap String (List Int) -> HashMap String (List Int)
posTblOfGo [] tbl = tbl
posTblOfGo ((f, i) :: rest) tbl =
  case HashMap.lookup f tbl of
    Just is => posTblOfGo rest (HashMap.insert f (i :: is) tbl)
    Nothing => posTblOfGo rest (HashMap.insert f [i] tbl)

posHasTbl : String -> Int -> HashMap String (List Int) -> Bool
posHasTbl f i tbl =
  case HashMap.lookup f tbl of
    Just is => memInt i is
    Nothing => False

memInt : Int -> List Int -> Bool
memInt i [] = False
memInt i (x :: rest) = i == x || memInt i rest

export posAdd : String -> Int -> List (String, Int) -> List (String, Int)
posAdd f i facts = if posHas f i facts then facts else (f, i) :: facts

export posSubset : List (String, Int) -> List (String, Int) -> Bool
posSubset [] b = True
posSubset ((f, i) :: rest) b = posHas f i b && posSubset rest b

export posSetEq : List (String, Int) -> List (String, Int) -> Bool
posSetEq a b = length a == length b && posSubset a b

export posFilter : List (String, Int) -> List (String, Int) -> List (String, Int)
posFilter [] neg = []
posFilter ((f, i) :: rest) neg =
  if posHas f i neg then posFilter rest neg else (f, i) :: posFilter rest neg

export posUnion : List (String, Int) -> List (String, Int) -> List (String, Int)
posUnion [] b = b
posUnion ((f, i) :: rest) b = posUnion rest (posAdd f i b)

-- 表版集合操作：不动点每轮的 filter / 并集 / 相等比较用 name→位置表；
-- 逐候选线性扫另一个集合在 facts 千级时每轮是 O(n²)。
export posFilterTbl : List (String, Int) -> HashMap String (List Int) -> List (String, Int)
posFilterTbl [] neg = []
posFilterTbl ((f, i) :: rest) neg =
  if posHasTbl f i neg then posFilterTbl rest neg else (f, i) :: posFilterTbl rest neg

posSubsetTbl : List (String, Int) -> HashMap String (List Int) -> Bool
posSubsetTbl [] b = True
posSubsetTbl ((f, i) :: rest) b = posHasTbl f i b && posSubsetTbl rest b

posSetEqTbl : List (String, Int) -> List (String, Int) -> Bool
posSetEqTbl a b = length a == length b && posSubsetTbl a (posTblOf b) && posSubsetTbl b (posTblOf a)

-- 并集：fresh 在前，facts 中不在 fresh 的在后（集合语义与 `posUnion facts fresh` 一致）。
export posUnionTbl : List (String, Int) -> List (String, Int) -> List (String, Int)
posUnionTbl facts fresh = append fresh (posFilterTbl facts (posTblOf fresh))

export funDeclsOf : List Decl -> List (String, List Pat, Expr)
funDeclsOf [] = []
funDeclsOf (d :: rest) =
  case d of
    DFun name pats body sp => (name, pats, body) :: funDeclsOf rest
    -- 实例方法体同样参与终止性分析：按方法短名分组建 SCC（同名方法在整个包内
    -- 共用一组，覆盖 trait dispatch 的任意实例选择；方向保守）。
    DInstance ctx head methods sp => append (funDeclsOf methods) (funDeclsOf rest)
    _ => funDeclsOf rest

export lookupGroup : String -> List (String, List (List Pat, Expr)) -> Maybe (List (List Pat, Expr))
lookupGroup name [] = Nothing
lookupGroup name ((n, cls) :: rest) = if n == name then Just cls else lookupGroup name rest

export replaceGroup : String -> List (List Pat, Expr) -> List (String, List (List Pat, Expr)) -> List (String, List (List Pat, Expr))
replaceGroup name cls [] = []
replaceGroup name cls ((n, olds) :: rest) =
  if n == name then (n, cls) :: rest else (n, olds) :: replaceGroup name cls rest

export groupDefs : List Decl -> List (String, List (List Pat, Expr))
groupDefs decls =
  let
    stepped = groupDefsGo (HashMap.fromList []) [] (funDeclsOf decls)
    tbl = firstOf stepped
    order = secondOf stepped
  in map (
      \n =>
        let
          cls2 =
            case HashMap.lookup n tbl of
              Just cls => reverse cls
              Nothing => []
        in (n, cls2)
    ) (reverse order)

-- O(1) 分组：HashMap 累积 clauses（逆序，最后 reverse），order 记录首次出现顺序。
export groupDefsGo : HashMap String (List (List Pat, Expr)) -> List String -> List (String, List Pat, Expr) -> (HashMap String (List (List Pat, Expr)), List String)
groupDefsGo tbl order [] = (tbl, order)
groupDefsGo tbl order ((name, clause) :: rest) =
  case HashMap.lookup name tbl of
    Just cls => groupDefsGo (HashMap.insert name (clause :: cls) tbl) order rest
    Nothing => groupDefsGo (HashMap.insert name [clause] tbl) (name :: order) rest

export defNames : List (String, List (List Pat, Expr)) -> List String
defNames defs = map firstOf defs

-- ---------------------------------------------------------------
-- 转发器：`g k x = k x` 这类「只调用一个回调、其余实参由形参拼出」的定义。终止性分析把
-- 调用点 `g f a` 看成 `f a`（定义性 beta 归约），回调里的下降关系才不会被
-- 「callee 以值传递」挡住。三条与源形状有关的结论：
--   * 回调实参可以是形参上的**无 binder 表达式**（`g k c = k (tail c)`、`g k n = k (n - 1)`）：
--     模板按调用点实参替换后再交给同一套尺寸判据，不认识的形状仍落保守方向；
--   * 被调者可以是**另一个转发器**（`via k = apply k`：转发器被部分应用后再调用），
--     归约时把两层实参拼起来继续归约；
--   * 应用脊椎先拼平（`(g a) b` = `g [a, b]`）再归约，与 `ElabInput` 的按 arity 嵌套一致。
-- 模板只收无 binder 的形状，替换因此不会捕获调用点表达式的自由变量；模板里出现本组名字
-- 的定义不算转发器（否则改写会在自己的定义体上不停展开）。改写只进入终止性分析，
-- 不改变精化与求值。
-- ---------------------------------------------------------------
record Forwarder where
  fwdCallee : String
  -- | 形参个数（= 子句模式个数）。
  fwdArity : Int
  -- | 形参名（模板里的占位以此为准）。
  fwdParams : List String
  -- | 被调形参下标；< 0 表示被调者是另一个转发器（`fwdChain`）。
  fwdCbParam : Int
  fwdChain : String
  fwdArgs : List Expr

pvarParamsOf : List Pat -> List String
pvarParamsOf [] = []
pvarParamsOf (p :: rest) =
  case p of
    PVar n sp => n :: pvarParamsOf rest
    _ => []

paramPositionOf : String -> List String -> Maybe Int
paramPositionOf n [] = Nothing
paramPositionOf n (p :: rest) =
  if n == p then
    Just 0
  else
    case paramPositionOf n rest of
      Just i => Just (i + 1)
      Nothing => Nothing

-- 应用脊椎：`(g a) b` 拼平成 `g [a, b]`；头部不是应用时实参表为空。
spineOf : Expr -> (Expr, List Expr)
spineOf (EApp fn args sp) =
  let
    inner = spineOf fn
  in (firstOf inner, append (secondOf inner) args)
spineOf e = (e, [])

-- 回调实参模板允许的形状：无 binder（替换不会捕获自由变量）。变量可以是形参（替换点）或
-- 全局名（原样保留）。`case` / `let` / `λ` / `do` 一律不收，留着按普通调用保守处理。
fwdTmplOk : Expr -> Bool
fwdTmplOk (EVar n sp) = True
fwdTmplOk (EInt k ksp) = True
fwdTmplOk (EStr s ssp) = True
fwdTmplOk (EFloat raw rsp) = True
fwdTmplOk (EField base f sp) = fwdTmplOk base
fwdTmplOk (EApp fn args sp) = fwdTmplOk fn && fwdTmplsOk args
fwdTmplOk _ = False

fwdTmplsOk : List Expr -> Bool
fwdTmplsOk [] = True
fwdTmplsOk (a :: rest) = fwdTmplOk a && fwdTmplsOk rest

mentionsName : String -> Expr -> Bool
mentionsName n (EVar m msp) = n == m
mentionsName n (EApp fn args sp) = mentionsName n fn || anyMentionsName n args
mentionsName n (EField base f sp) = mentionsName n base
mentionsName n _ = False

anyMentionsName : String -> List Expr -> Bool
anyMentionsName n [] = False
anyMentionsName n (a :: rest) = mentionsName n a || anyMentionsName n rest

forwarderOfClause : List Forwarder -> String -> (List Pat, Expr) -> Maybe Forwarder
forwarderOfClause fwds name (pats, body) =
  let
    params = pvarParamsOf pats
  in if length params == length pats && notEmpty params then
    case spineOf body of
      (EVar h hsp, cargs) => forwarderOfCall fwds name params h cargs
      _ => Nothing
  else
    Nothing

-- 体是「把某个函数应用到一组实参模板上」：被调者要么是本组形参（回调），要么是另一个
-- 已识别的转发器（中转 / 部分应用）。
forwarderOfCall : List Forwarder -> String -> List String -> String -> List Expr -> Maybe Forwarder
forwarderOfCall fwds name params h cargs =
  if fwdTmplsOk cargs && notEmpty cargs then
    if anyMentionsName name cargs then Nothing else forwarderOfHit fwds name params h cargs
  else
    Nothing

forwarderOfHit : List Forwarder -> String -> List String -> String -> List Expr -> Maybe Forwarder
forwarderOfHit fwds name params h cargs =
  case paramPositionOf (h) params of
    Just j => Just (Forwarder name (length params) params j "" cargs)
    Nothing =>
      case lookupForwarder h fwds of
        Just f =>
          if length cargs <= f.fwdArity then
            Just (Forwarder name (length params) params (-1) h cargs)
          else
            Nothing
        Nothing => Nothing

-- 两个模板在「形参按位置对应」的口径下相同（多子句的形参名可以不同）。fuel 按模板节点数
-- 派生：每次下降正好消费一层节点。
sameFwdArg : Int -> List String -> Expr -> List String -> Expr -> Bool
sameFwdArg fuel pa a pb b =
  if fuel <= 0 then
    False
  else
    case (a, b) of
      (EVar n na, EVar m nb) => sameFwdVar pa n pb m
      (EInt x xa, EInt y yb) => x == y
      (EStr x xa, EStr y yb) => x == y
      (EFloat x xa, EFloat y yb) => x == y
      (EField ba fa sa, EField bb fb sb) => fa == fb && sameFwdArg (fuel - 1) pa ba pb bb
      (EApp fa aa sa, EApp fb ab sb) => sameFwdArg (fuel - 1) pa fa pb fb && sameFwdArgs (fuel - 1) pa aa pb ab
      _ => False

sameFwdVar : List String -> String -> List String -> String -> Bool
sameFwdVar pa n pb m =
  case paramPositionOf (n) pa of
    Just i =>
      case paramPositionOf (m) pb of
        Just k => i == k
        Nothing => False
    Nothing =>
      case paramPositionOf (m) pb of
        Just k => False
        Nothing => n == m

sameFwdArgs : Int -> List String -> List Expr -> List String -> List Expr -> Bool
sameFwdArgs fuel pa xs pb ys =
  if fuel <= 0 then
    False
  else
    case xs of
      [] =>
        case ys of
          [] => True
          _ => False
      a :: rest =>
        case ys of
          [] => False
          b :: rest2 => sameFwdArg (fuel - 1) pa a pb b && sameFwdArgs (fuel - 1) pa rest pb rest2

templWeight : Expr -> Int
templWeight (EApp fn args sp) = 1 + templWeight fn + sumF (map templWeight args)
templWeight (EField base f sp) = 1 + templWeight base
templWeight _ = 1

templsWeight : List Expr -> Int
templsWeight xs = sumF (map templWeight xs)

sameForwarder : Forwarder -> Forwarder -> Bool
sameForwarder a b =
  a.fwdArity
    == b.fwdArity
    && a.fwdCbParam
    == b.fwdCbParam
    && a.fwdChain
    == b.fwdChain
    && sameFwdArgs
      (2 + templsWeight a.fwdArgs + templsWeight b.fwdArgs)
      a.fwdParams
      a.fwdArgs
      b.fwdParams
      b.fwdArgs

matchForwarders : List Forwarder -> Forwarder -> List (List Pat, Expr) -> Bool
matchForwarders fwds f [] = True
matchForwarders fwds f (cl :: rest) =
  case forwarderOfClause fwds f.fwdCallee cl of
    Just g => sameForwarder f g && matchForwarders fwds f rest
    Nothing => False

forwarderOfGroup : List Forwarder -> (String, List (List Pat, Expr)) -> Maybe Forwarder
forwarderOfGroup fwds (name, cl :: rest) =
  case forwarderOfClause fwds name cl of
    Just f => if matchForwarders fwds f rest then Just f else Nothing
    Nothing => Nothing
forwarderOfGroup fwds _ = Nothing

-- 中转转发器要等被中转的那个先认出来：不动点每轮拿上一轮的表重扫，直到条目数不再变
-- （识别只依赖表里已有的名字，所以单调，条目数稳定即到达不动点）。
forwardersFix : List (String, List (List Pat, Expr)) -> Int -> List Forwarder -> List Forwarder
forwardersFix defs fuel fwds =
  if fuel <= 0 then
    fwds
  else
    let
      fwds2 = forwardersScan defs fwds []
    in if length fwds2 == length fwds then fwds2 else forwardersFix defs (fuel - 1) fwds2

forwardersScan : List (String, List (List Pat, Expr)) -> List Forwarder -> List Forwarder -> List Forwarder
forwardersScan [] old acc = reverse acc
forwardersScan (d :: rest) old acc =
  case forwarderOfGroup old d of
    Just f => forwardersScan rest old (f :: acc)
    Nothing => forwardersScan rest old acc

forwardersOf : List Decl -> List Forwarder
forwardersOf decls =
  let
    defs = groupDefs decls
  in forwardersFix defs (length defs) []

lookupForwarder : String -> List Forwarder -> Maybe Forwarder
lookupForwarder n [] = Nothing
lookupForwarder n (f :: rest) = if f.fwdCallee == n then Just f else lookupForwarder n rest

-- 模板替换：形参名 → 调用点实参（模板里其余变量是全局名，原样保留）。
substFwd : List String -> List Expr -> Expr -> Expr
substFwd params actuals (EVar n nsp) =
  case paramPositionOf (n) params of
    Just i =>
      case nthExpr actuals i of
        Just a => a
        Nothing => EVar n nsp
    Nothing => EVar n nsp
substFwd params actuals (EApp fn args sp) =
  EApp (substFwd params actuals fn) (map (substFwd params actuals) args) sp
substFwd params actuals (EField base f sp) = EField (substFwd params actuals base) f sp
substFwd params actuals e = e

takeArgs : Int -> List Expr -> List Expr
takeArgs n [] = []
takeArgs n (a :: rest) = if n <= 0 then [] else a :: takeArgs (n - 1) rest

dropArgs : Int -> List Expr -> List Expr
dropArgs n [] = []
dropArgs n (a :: rest) = if n <= 0 then a :: rest else dropArgs (n - 1) rest

fwFields : List Forwarder -> List (String, Expr) -> List (String, Expr)
fwFields fwds fields = fwFieldsF (exprBudget 32 (ERecord "" fields noNodeRef)) fwds fields

fwFieldsF : Int -> List Forwarder -> List (String, Expr) -> List (String, Expr)
fwFieldsF fuel fwds [] = []
fwFieldsF fuel fwds ((fn, fe) :: rest) =
  (fn, fwExprF (fuel - 1) fwds fe) :: fwFieldsF (fuel - 1) fwds rest

fwBindsF : Int -> List Forwarder -> List Binding -> List Binding
fwBindsF fuel fwds [] = []
fwBindsF fuel fwds (b :: rest) = fwBindingF (fuel - 1) fwds b :: fwBindsF (fuel - 1) fwds rest

fwBindingF : Int -> List Forwarder -> Binding -> Binding
fwBindingF fuel fwds b =
  let
    value =
      case b.bindValue of
        BVal e => BVal (fwExprF (fuel - 1) fwds e)
        BClauses cs => BClauses (fwClausesF (fuel - 1) fwds cs)
    sig =
      case b.bindSig of
        Just s => Just ({ s | sigType = fwExprF (fuel - 1) fwds s.sigType })
        Nothing => Nothing
  in { b | bindValue = value, bindSig = sig }

fwAltsF : Int -> List Forwarder -> List Alt -> List Alt
fwAltsF fuel fwds [] = []
fwAltsF fuel fwds (a :: rest) =
  { a | altBody = fwExprF (fuel - 1) fwds a.altBody } :: fwAltsF (fuel - 1) fwds rest

fwClausesF : Int -> List Forwarder -> List LocalClause -> List LocalClause
fwClausesF fuel fwds [] = []
fwClausesF fuel fwds (c :: rest) =
  { c | lcBody = fwExprF (fuel - 1) fwds c.lcBody } :: fwClausesF (fuel - 1) fwds rest

fwStmtsF : Int -> List Forwarder -> List DoStmt -> List DoStmt
fwStmtsF fuel fwds [] = []
fwStmtsF fuel fwds (s :: rest) =
  case s of
    DBind pat e sp => DBind pat (fwExprF (fuel - 1) fwds e) sp :: fwStmtsF (fuel - 1) fwds rest
    DExpr e sp => DExpr (fwExprF (fuel - 1) fwds e) sp :: fwStmtsF (fuel - 1) fwds rest
    DLet binds sp => DLet (fwBindsF (fuel - 1) fwds binds) sp :: fwStmtsF (fuel - 1) fwds rest

fwPartsF : Int -> List Forwarder -> List InterpPart -> List InterpPart
fwPartsF fuel fwds [] = []
fwPartsF fuel fwds (p :: rest) =
  case p of
    IPText t => IPText t :: fwPartsF (fuel - 1) fwds rest
    IPHole e => IPHole (fwExprF (fuel - 1) fwds e) :: fwPartsF (fuel - 1) fwds rest

fwArgsF : Int -> List Forwarder -> List Expr -> List Expr
fwArgsF fuel fwds [] = []
fwArgsF fuel fwds (a :: rest) = fwExprF (fuel - 1) fwds a :: fwArgsF (fuel - 1) fwds rest

-- | 归约一个转发器应用：`g e1..en r1..rk` → `cb (a1[σ]..am[σ]) r1..rk`（σ 是前 n 个实参）。
--   被调者是另一个转发器（`via k = apply k`，部分应用后再调用）时，把两层实参拼起来继续
--   归约；回调实参位置本身是「转发器的部分应用」时同样拼平后继续。
fwdReduce : Int -> List Forwarder -> Expr -> List Expr -> NodeRef -> Expr
fwdReduce fuel fwds headExpr spine sp =
  if fuel <= 0 then
    EApp headExpr spine sp
  else
    case headExpr of
      EVar g gsp =>
        case lookupForwarder (g) fwds of
          Just f => fwdReduceTaken (fuel - 1) fwds f spine sp
          Nothing => EApp (EVar g gsp) spine sp
      EApp _ _ _ =>
        let
          flat = spineOf headExpr
          innerHead = firstOf flat
        in case innerHead of
          EVar g gsp =>
            case lookupForwarder (g) fwds of
              Just f => fwdReduceTaken (fuel - 1) fwds f (append (secondOf flat) spine) sp
              Nothing => EApp headExpr spine sp
          _ => EApp headExpr spine sp
      _ => EApp headExpr spine sp

-- 形参个数够了才归约：取前缀做实参替换，剩下的实参原样接在回调调用后面。
fwdReduceTaken : Int -> List Forwarder -> Forwarder -> List Expr -> NodeRef -> Expr
fwdReduceTaken fuel fwds f spine sp =
  if length spine >= f.fwdArity then
    let
      taken = takeArgs f.fwdArity spine
      rest = dropArgs f.fwdArity spine
      mapped = fwArgsF (fuel - 1) fwds (map (substFwd f.fwdParams taken) f.fwdArgs)
      whole = append mapped rest
    in if f.fwdCbParam >= 0 then
      case nthExpr taken f.fwdCbParam of
        Just cb => fwdReduce (fuel - 1) fwds cb whole sp
        Nothing => EApp (EVar (f.fwdCallee) sp) whole sp
    else
      fwdReduce (fuel - 1) fwds (EVar (f.fwdChain) sp) whole sp
  else
    EApp (EVar (f.fwdCallee) sp) spine sp

fwExprF : Int -> List Forwarder -> Expr -> Expr
fwExprF fuel fwds e =
  if fuel <= 0 then
    e
  else
    case e of
      EApp fn args sp =>
        let
          args2 = fwArgsF (fuel - 1) fwds args
        in case fn of
          EVar g gsp =>
            case lookupForwarder (g) fwds of
              Just f => fwdReduce (fuel - 1) fwds (EVar g gsp) args2 sp
              Nothing => EApp (EVar g gsp) args2 sp
          -- 头部本身是应用（`(g a) b`）：先拼平脊椎，再看拼平后的头部是不是转发器。
          EApp _ _ _ =>
            let
              flat = spineOf e
            in case firstOf flat of
              EVar g gsp =>
                case lookupForwarder (g) fwds of
                  Just f => fwdReduce (fuel - 1) fwds (EVar g gsp) (fwArgsF (fuel - 1) fwds (secondOf flat)) sp
                  Nothing => EApp (fwExprF (fuel - 1) fwds fn) args2 sp
              _ => EApp (fwExprF (fuel - 1) fwds fn) args2 sp
          _ => EApp (fwExprF (fuel - 1) fwds fn) args2 sp
      ELam ns body sp => ELam ns (fwExprF (fuel - 1) fwds body) sp
      ELet binds body rec_ sp => ELet (fwBindsF (fuel - 1) fwds binds) (fwExprF (fuel - 1) fwds body) rec_ sp
      ECase scrut alts sp => ECase (fwExprF (fuel - 1) fwds scrut) (fwAltsF (fuel - 1) fwds alts) sp
      EIf c t el sp => EIf (fwExprF (fuel - 1) fwds c) (fwExprF (fuel - 1) fwds t) (fwExprF (fuel - 1) fwds el) sp
      EField base f sp => EField (fwExprF (fuel - 1) fwds base) f sp
      ERecord rn fields sp => ERecord rn (fwFieldsF (fuel - 1) fwds fields) sp
      ERecUpdate base fields sp => ERecUpdate (fwExprF (fuel - 1) fwds base) (fwFieldsF (fuel - 1) fwds fields) sp
      EDo stmts sp => EDo (fwStmtsF (fuel - 1) fwds stmts) sp
      EPi n implicit qty dom cod sp => EPi n implicit qty (fwExprF (fuel - 1) fwds dom) (fwExprF (fuel - 1) fwds cod) sp
      EInterp parts sp => EInterp (fwPartsF (fuel - 1) fwds parts) sp
      _ => e

declFuel : Decl -> Int
declFuel (DFun name pats body sp) = exprBudget 64 body
declFuel (DInstance ctxE head methods sp) = 64 + sumF (map declFuel methods)
declFuel d = 0

sumF : List Int -> Int
sumF [] = 0
sumF (x :: rest) = x + sumF rest

fwDecl : List Forwarder -> Decl -> Decl
fwDecl fwds d = fwDeclF (declFuel d) fwds d

fwDeclF : Int -> List Forwarder -> Decl -> Decl
fwDeclF fuel fwds d =
  if fuel <= 0 then
    d
  else
    case d of
      DFun name pats body sp => DFun name pats (fwExprF (fuel - 1) fwds body) sp
      DInstance ctxE head methods sp => DInstance ctxE head (map (fwDeclF (fuel - 1) fwds) methods) sp
      _ => d

-- | 把转发器调用 `g f a` 归约成 `f a`（只用于终止性分析；不改变精化/求值）。
export expandForwarders : List Decl -> List Decl
expandForwarders decls =
  case forwardersOf decls of
    [] => decls
    fwds => map (fwDecl fwds) decls

export clausesOfDef : String -> List (String, List (List Pat, Expr)) -> List (List Pat, Expr)
clausesOfDef name [] = []
clausesOfDef name ((n, cls) :: rest) = if n == name then cls else clausesOfDef name rest

-- O(1) 版：终止性检查（SCC / measure）用 name→clauses 表，避免逐 SCC 线性扫全部 defs。
export clausesOfDefTbl : String -> HashMap String (List (List Pat, Expr)) -> List (List Pat, Expr)
clausesOfDefTbl name tbl =
  case HashMap.lookup name tbl of
    Just cls => cls
    Nothing => []

export defArity : List (List Pat, Expr) -> Int
defArity [] = 0
defArity (c :: rest) = maxInt (length (firstOf c)) (defArity rest)

export maxArityOf : List String -> HashMap String (List (List Pat, Expr)) -> Int
maxArityOf [] defTbl = 0
maxArityOf (n :: rest) defTbl =
  maxInt (defArity (clausesOfDefTbl n defTbl)) (maxArityOf rest defTbl)

export ctorNamesOf : List Decl -> List String
ctorNamesOf [] = []
ctorNamesOf (d :: rest) =
  case d of
    DData name params kind ctors derivings viaField repr lin sp =>
      append (map ctorNameOf ctors) (ctorNamesOf rest)
    DRecord name params fields derivings viaField repr lin sp => name :: ctorNamesOf rest
    _ => ctorNamesOf rest

export ctorNameOf : Ctor -> String
ctorNameOf (Ctor name ty arity sp) = name

export patSizeStrict : Pat -> Int -> List Int -> List (String, Int, Int, List Int) -> List (String, Int, Int, List Int)
patSizeStrict (PAs n inner sp) base path acc =
  patSizeStrict inner base path ((n, base, natToInt (length path), path) :: acc)
patSizeStrict (PVar n sp) base path acc = (n, base, natToInt (length path), path) :: acc
patSizeStrict (PWild sp) base path acc = acc
patSizeStrict (PCon c ps sp) base path acc = patsSizeStrict ps base path 0 acc
patSizeStrict (PRecord rn fields sp) base path acc = fieldsSizeStrict fields base path 0 acc
patSizeStrict _ base path acc = acc

export patsSizeStrict : List Pat -> Int -> List Int -> Int -> List (String, Int, Int, List Int) -> List (String, Int, Int, List Int)
patsSizeStrict [] base path k acc = acc
patsSizeStrict (p :: rest) base path k acc =
  patsSizeStrict rest base path (k + 1) (patSizeStrict p base (append path [k]) acc)

export fieldsSizeStrict : List (String, Pat) -> Int -> List Int -> Int -> List (String, Int, Int, List Int) -> List (String, Int, Int, List Int)
fieldsSizeStrict [] base path k acc = acc
fieldsSizeStrict ((fn, fp) :: rest) base path k acc =
  fieldsSizeStrict rest base path (k + 1) (patSizeStrict fp base (append path [k]) acc)

export strSizeEntries : List Pat -> List (String, Int, Int, List Int)
strSizeEntries pats = strSizeEntriesGo pats 0

export strSizeEntriesGo : List Pat -> Int -> List (String, Int, Int, List Int)
strSizeEntriesGo [] i = []
strSizeEntriesGo (p :: rest) i = append (patSizeStrict p i [] []) (strSizeEntriesGo rest (i + 1))

-- | 表达式携带的尺寸：变量直接查表；非 alias record 的字段投影按声明顺序下推一位。
-- alias record 的投影是恒等，不能在字段表里出现（`fieldProjectionsOf` 会剔除）。
export sizeOfExpr : List (String, List Int) -> List (String, Int, Int, List Int) -> Expr -> Maybe (Int, Int, List Int)
sizeOfExpr projs sizes (EVar n sp) = sizeOfVarStrict (n) sizes
sizeOfExpr projs sizes (EField base f sp) =
  case sizeOfExpr projs sizes base of
    Just (b, d, path) =>
      case fieldIndexOf f projs of
        Just k => Just (b, d + 1, append path [k])
        Nothing => Nothing
    Nothing => Nothing
sizeOfExpr projs sizes _ = Nothing

export extendSizesStrict : List (String, List Int) -> List (String, Int, Int, List Int) -> Expr -> Pat -> List (String, Int, Int, List Int)
extendSizesStrict projs sizes scrut pat =
  case sizeOfExpr projs sizes scrut of
    Just sz =>
      case sz of
        (base, depth, path) =>
          case pat of
            -- `let ys = xs` / `do ys <- xs`：别名继承被绑定变量的尺寸。
            PVar n nsp => (n, sz) :: sizes
            PAs n inner asp => extendSizesStrict projs ((n, sz) :: sizes) scrut inner
            PCon c ps sp2 => append sizes (patsSizeStrict ps base path 0 [])
            PRecord rn fields sp2 => append sizes (fieldsSizeStrict fields base path 0 [])
            _ => sizes
    Nothing => sizes

-- | 顺序绑定块：第 k 条的尺寸只对后面的绑定与 body 可见。
export extendByBinds : List (String, List Int) -> List Binding -> List (String, Int, Int, List Int) -> List (String, Int, Int, List Int)
extendByBinds projs [] sizes = sizes
extendByBinds projs (b :: rest) sizes = extendByBinds projs rest (extendBindingSizes projs sizes b)

export extendBindingSizes : List (String, List Int) -> List (String, Int, Int, List Int) -> Binding -> List (String, Int, Int, List Int)
extendBindingSizes projs sizes b =
  case b.bindValue of
    BVal e => extendSizesStrict projs sizes e b.bindPat
    BClauses cs => extendLocalClauses projs sizes cs

export extendLocalClauses : List (String, List Int) -> List (String, Int, Int, List Int) -> List LocalClause -> List (String, Int, Int, List Int)
extendLocalClauses projs sizes [] = sizes
extendLocalClauses projs sizes (c :: rest) =
  extendLocalClauses
    projs
    (extendSizesStrict projs sizes c.lcBody (PWild (detachedNodeRef spanEmpty)))
    rest

export sizeOfVarStrict : String -> List (String, Int, Int, List Int) -> Maybe (Int, Int, List Int)
sizeOfVarStrict name [] = Nothing
sizeOfVarStrict name ((n, sz) :: rest) = if n == name then Just sz else sizeOfVarStrict name rest

-- `map (\v => body) lst`：lambda 绑定 v 视为 lst 的元素（更深的子项），
-- 让 map 回调里的递归/投影参与下降判定。
-- ==== 检查器实现（正事实 / 投影 / 调用点关系 / 遍历辅助）====
export guardPosVar : Expr -> Maybe String
guardPosVar e =
  case e of
    EApp (EVar op osp) args sp =>
      case cmpOpOf (opBaseName (op)) of
        -- `<=` / `>=` / `<` 在 Loader 被解析成 `le` / `ge` / `lt` 方法调用，
        -- 终止性守卫按方法短名识别；裸运算符名保留（Loader 之前的内部生成物）。
        "le" => guardLE args
        "ge" => guardGE args
        "lt" => guardLT args
        "<=" => guardLE args
        ">=" => guardGE args
        "<" => guardLT args
        _ => Nothing
    _ => Nothing

-- Core 的 Int 比较是内建原语（`bi_le_int` …），语义与 `le`/`ge`/`lt`/`gt` 相同：
-- 守卫识别归一到短名，只维护一份口径（两类来源都认）。
export cmpOpOf : String -> String
cmpOpOf "bi_le_int" = "le"
cmpOpOf "bi_ge_int" = "ge"
cmpOpOf "bi_lt_int" = "lt"
cmpOpOf "bi_gt_int" = "gt"
cmpOpOf op = op

-- 名字按点取最后一段（`Base.Trait.Ord.le` → `le`）；裸名原样返回。
opBaseName : String -> String
opBaseName name = secondOf (splitLastDot (splitOnDot name))

-- 比较运算的最后两个**语义**实参：方法投影带类型 / 字典实参时（`le t d n 0`）前面还有
-- 隐式位，但比较的左右操作数始终是最后两个。
export lastTwo : List Expr -> Maybe (Expr, Expr)
lastTwo (a :: b :: rest) = Just (lastTwoGo a b rest)
lastTwo _ = Nothing

lastTwoGo : Expr -> Expr -> List Expr -> (Expr, Expr)
lastTwoGo a b [] = (a, b)
lastTwoGo a b (c :: rest) = lastTwoGo b c rest

export guardLE : List Expr -> Maybe String
guardLE args =
  case lastTwo args of
    Just (lhs, rhs) =>
      case rhs of
        EInt k ksp => if k == 0 then varOfExpr lhs else Nothing
        _ => Nothing
    Nothing => Nothing

export guardGE : List Expr -> Maybe String
guardGE args =
  case lastTwo args of
    Just (lhs, rhs) =>
      case lhs of
        EInt k ksp => if k == 0 then varOfExpr rhs else Nothing
        _ => Nothing
    Nothing => Nothing

export guardLT : List Expr -> Maybe String
guardLT args =
  case lastTwo args of
    Just (lhs, rhs) =>
      case rhs of
        EInt k ksp => if k == 1 then varOfExpr lhs else Nothing
        _ => Nothing
    Nothing => Nothing

export varOfExpr : Expr -> Maybe String
varOfExpr (EVar n sp) = Just (n)
-- Nat → Int 的转换是恒等（只换表示）：守卫变量仍按原变量名识别。
varOfExpr (EApp (EVar c csp) [x] sp) = if isNatCoerceName (c) then varOfExpr x else Nothing
varOfExpr _ = Nothing

isNatCoerceName : String -> Bool
isNatCoerceName name =
  let
    b = opBaseName name
  in b == "natToInt" || b == "natFromInt" || b == "toInt"

-- | 局部函数子句 → 只保留体的“绑定”视图（模式不影响正性/尺寸事实）。
--   树的三种遍历共用这一份，避免各自实现漂移。
export localClauseBinds : List LocalClause -> List (Pat, Expr)
localClauseBinds [] = []
localClauseBinds (c :: rest) = (PWild c.lcRef, c.lcBody) :: localClauseBinds rest

-- | 正性事实的集合运算：`&&` 的真分支取并、`||` 的真分支取交；
-- 假分支由德摩根定律对调。
export guardUnion : List String -> List String -> List String
guardUnion a b = dedup (append a b)

guardInter : List String -> List String -> List String
guardInter [] b = []
guardInter (x :: rest) b = if memName x b then x :: guardInter rest b else guardInter rest b

-- | 单个比较为真时成立的「正性」：`x > k`（k ≥ 0）/ `x ≥ k`（k ≥ 1）及其字面量在左的写法。
guardThenPosAtom : String -> List Expr -> Maybe String
guardThenPosAtom op args =
  case lastTwo args of
    Just (lhs, rhs) =>
      case rhs of
        EInt k ksp =>
          if op == "gt" || op == ">" then
            if k >= 0 then varOfExpr lhs else Nothing
          else if op == "ge" || op == ">=" then
            if k >= 1 then varOfExpr lhs else Nothing
          else
            Nothing
        _ =>
          case lhs of
            EInt k ksp =>
              if op == "lt" || op == "<" then
                if k >= 0 then varOfExpr rhs else Nothing
              else if op == "le" || op == "<=" then
                if k >= 1 then varOfExpr rhs else Nothing
              else
                Nothing
            _ => Nothing
    Nothing => Nothing

-- | 单个比较为假时成立的「正性」：`x <= k`（k ≥ 0）为假 ⇒ `x > 0`；
-- `x < k`（k ≥ 1）为假 ⇒ `x ≥ 1 > 0`。字面量在左的写法按同一口径镜像。
guardElsePosAtom : String -> List Expr -> Maybe String
guardElsePosAtom op args =
  case lastTwo args of
    Just (lhs, rhs) =>
      case rhs of
        EInt k ksp =>
          if op == "le" || op == "<=" then
            if k >= 0 then varOfExpr lhs else Nothing
          else if op == "lt" || op == "<" then
            if k >= 1 then varOfExpr lhs else Nothing
          else
            Nothing
        _ =>
          case lhs of
            EInt k ksp =>
              if op == "ge" || op == ">=" then
                if k >= 0 then varOfExpr rhs else Nothing
              else if op == "gt" || op == ">" then
                if k >= 1 then varOfExpr rhs else Nothing
              else
                Nothing
            _ => Nothing
    Nothing => Nothing

-- | 条件为真时成立的全部正性事实。`a && b` 取并；`a || b` 只有两侧都为真才成立的
--   事实才可用（取交），否则会把「至少一侧为正」误当成两侧都为正。
export guardThenPosVars : Expr -> List String
-- `a && b` 在 Core 里是 `if a then b else False`：真分支两侧都成立。
guardThenPosVars (EIf c t el sp) =
  if isFalseLit el then guardUnion (guardThenPosVars c) (guardThenPosVars t) else []
guardThenPosVars (EApp (EVar op osp) args sp) =
  let
    opn = cmpOpOf (opBaseName (op))
  in if opn == "&&" then
    case args of
      [a, b] => guardUnion (guardThenPosVars a) (guardThenPosVars b)
      _ => []
  else if opn == "||" then
    case args of
      [a, b] => guardInter (guardThenPosVars a) (guardThenPosVars b)
      _ => []
  else
    case guardThenPosAtom opn args of
      Just v => [v]
      Nothing => []
guardThenPosVars _ = []

-- | 条件为假时成立的全部正性事实：`a || b` 为假 ⇒ 两侧都假（取并）；
--   `a && b` 为假只说明至少一侧为假（取交）。
export guardElsePosVars : Expr -> List String
-- `a || b` 在 Core 里是 `if a then True else b`：假分支两侧都成立。
guardElsePosVars (EIf c t el sp) =
  if isTrueLit t then guardUnion (guardElsePosVars c) (guardElsePosVars el) else []
guardElsePosVars (EApp (EVar op osp) args sp) =
  let
    opn = cmpOpOf (opBaseName (op))
  in if opn == "&&" then
    case args of
      [a, b] => guardInter (guardElsePosVars a) (guardElsePosVars b)
      _ => []
  else if opn == "||" then
    case args of
      [a, b] => guardUnion (guardElsePosVars a) (guardElsePosVars b)
      _ => []
  else
    case guardElsePosAtom opn args of
      Just v => [v]
      Nothing => []
guardElsePosVars _ = []

isTrueLit : Expr -> Bool
isTrueLit (EInt k sp) = k /= 0
isTrueLit _ = False

isFalseLit : Expr -> Bool
isFalseLit (EInt k sp) = k == 0
isFalseLit _ = False

-- 一个实参是否「已知为正」：字面量 >0，或变量处于守卫区 / 调用方同位置形参已有正事实。
export argPositive : List Expr -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Bool
argPositive args i sizes caller facts region =
  case nthExpr args i of
    Nothing => False
    Just a =>
      case a of
        EInt k sp => k > 0
        EVar n sp =>
          if memName (n) region then
            True
          else
            case sizeOfVarStrict (n) sizes of
              Just sz =>
                case sz of
                  (base, depth, path) => depth == 0 && posHasTbl caller base facts
              Nothing => False
        _ => False

-- 扫描一遍：收集「正规实参」与「非正实参」的 (callee, argIndex) 候选。
-- 扫阶段的累积只做 O(1) 前插，**去重推迟到一轮扫描结束**（冷路径）：
-- 每标记一个 (callee, argIndex) 就对已累积的整表线性扫一遍（`posAdd`），
-- 一轮扫描内累积到数千条 ⇒ O(#标记 × #事实)，是 check 冷路径的最大热点。
export posMarkPos : String -> Int -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posMarkPos f i st = ((f, i) :: firstOf st, secondOf st)

export posMarkNeg : String -> Int -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posMarkNeg f i st = (firstOf st, (f, i) :: secondOf st)

-- 一轮扫描结束后的去重（哈希分组 + 每组 memInt 去重；顺序不影响语义）。
posNormalize : List (String, Int) -> List (String, Int)
posNormalize xs = posTblPairs (posTblOf xs)

posTblPairs : HashMap String (List Int) -> List (String, Int)
posTblPairs tbl = concatMap posEntryPairs (HashMap.toList tbl)

posEntryPairs : (String, List Int) -> List (String, Int)
posEntryPairs (n, is) = map (\i => (n, i)) (dedupInts is)

dedupInts : List Int -> List Int
dedupInts [] = []
dedupInts (x :: rest) = if memInt x rest then dedupInts rest else x :: dedupInts rest

posWalkArgsF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> List Expr -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkArgsF fuel namesTbl caller sizes facts region [] st = st
posWalkArgsF fuel namesTbl caller sizes facts region (a :: rest) st =
  if fuel <= 0 then
    st
  else
    posWalkArgsF
      (fuel - 1)
      namesTbl
      caller
      sizes
      facts
      region
      rest
      (posWalkF (fuel - 1) namesTbl caller sizes facts region a st)

posWalkFieldsF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> List (String, Expr) -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkFieldsF fuel namesTbl caller sizes facts region [] st = st
posWalkFieldsF fuel namesTbl caller sizes facts region ((fn, fe) :: rest) st =
  if fuel <= 0 then
    st
  else
    posWalkFieldsF
      (fuel - 1)
      namesTbl
      caller
      sizes
      facts
      region
      rest
      (posWalkF (fuel - 1) namesTbl caller sizes facts region fe st)

posWalkAltsF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> Expr -> List Alt -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkAltsF fuel namesTbl caller sizes facts region scrut [] st = st
posWalkAltsF fuel namesTbl caller sizes facts region scrut (a :: rest) st =
  if fuel <= 0 then
    st
  else
    posWalkAltsF
      (fuel - 1)
      namesTbl
      caller
      sizes
      facts
      region
      scrut
      rest
      (posWalkF (fuel - 1) namesTbl caller (extendSizesVarOnly sizes scrut a.altPat) facts region a.altBody st)

-- `posWalk` 不携带投影表：只有变量 scrutinee 能扩尺寸（`case r.field of …` 的下降由
-- `strWalkAlts` / `siteCollectAlts` 的完整版本负责）。
extendSizesVarOnly : List (String, Int, Int, List Int) -> Expr -> Pat -> List (String, Int, Int, List Int)
extendSizesVarOnly sizes (scrut@(EVar _ _)) pat = extendSizesStrict [] sizes scrut pat
extendSizesVarOnly sizes _ pat = sizes

posWalkClausesF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> List LocalClause -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkClausesF fuel namesTbl caller sizes facts region [] st = st
posWalkClausesF fuel namesTbl caller sizes facts region (c :: rest) st =
  if fuel <= 0 then
    st
  else
    posWalkClausesF
      (fuel - 1)
      namesTbl
      caller
      sizes
      facts
      region
      rest
      (posWalkF (fuel - 1) namesTbl caller sizes facts region c.lcBody st)

posWalkBindsF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> List Binding -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkBindsF fuel namesTbl caller sizes facts region [] st = st
posWalkBindsF fuel namesTbl caller sizes facts region (b :: rest) st =
  if fuel <= 0 then
    st
  else
    posWalkBindsF
      (fuel - 1)
      namesTbl
      caller
      sizes
      facts
      region
      rest
      (posWalkBindingF (fuel - 1) namesTbl caller sizes facts region b st)

posWalkBindingF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> Binding -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkBindingF fuel namesTbl caller sizes facts region b st =
  if fuel <= 0 then
    st
  else
    let
      st1 =
        case b.bindValue of
          BVal e => posWalkF (fuel - 1) namesTbl caller sizes facts region e st
          BClauses cs => posWalkClausesF (fuel - 1) namesTbl caller sizes facts region cs st
    in case b.bindSig of
      Just sig => posWalkF (fuel - 1) namesTbl caller sizes facts region sig.sigType st1
      Nothing => st1

posWalkStmtsF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> List DoStmt -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkStmtsF fuel namesTbl caller sizes facts region [] st = st
posWalkStmtsF fuel namesTbl caller sizes facts region (s :: rest) st =
  if fuel <= 0 then
    st
  else
    case s of
      DBind pat e sp => posWalkStmtsF (fuel - 1) namesTbl caller sizes facts region rest (posWalkF (fuel - 1) namesTbl caller sizes facts region e st)
      DExpr e sp => posWalkStmtsF (fuel - 1) namesTbl caller sizes facts region rest (posWalkF (fuel - 1) namesTbl caller sizes facts region e st)
      DLet binds sp => posWalkStmtsF (fuel - 1) namesTbl caller sizes facts region rest (posWalkBindsF (fuel - 1) namesTbl caller sizes facts region binds st)

export posWalk : HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> Expr -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalk namesTbl caller sizes facts region e st =
  posWalkF (exprBudget 32 e) namesTbl caller sizes facts region e st

posWalkF : Int -> HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> Expr -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkF fuel namesTbl caller sizes facts region e st =
  if fuel <= 0 then
    st
  else
    case e of
      EApp fn args sp =>
        case fn of
          EVar g gsp => if HashMap.member (g) namesTbl then posWalkArgsF (fuel - 1) namesTbl caller sizes facts region args (posWalkCallee namesTbl caller sizes facts region (g) 0 args st) else posWalkArgsF (fuel - 1) namesTbl caller sizes facts region args (posWalkF (fuel - 1) namesTbl caller sizes facts region fn st)
          _ => posWalkArgsF (fuel - 1) namesTbl caller sizes facts region args (posWalkF (fuel - 1) namesTbl caller sizes facts region fn st)
      EIf c t el sp =>
        let
          st1 = posWalkF (fuel - 1) namesTbl caller sizes facts region c st
          st2 = posWalkF (fuel - 1) namesTbl caller sizes facts (append (guardThenPosVars c) region) t st1
        in posWalkF (fuel - 1) namesTbl caller sizes facts (append (guardElsePosVars c) region) el st2
      ECase scrut alts sp => posWalkAltsF (fuel - 1) namesTbl caller sizes facts region scrut alts (posWalkF (fuel - 1) namesTbl caller sizes facts region scrut st)
      ELam ns b sp => posWalkF (fuel - 1) namesTbl caller sizes facts region b st
      ELet binds body rec_ sp => posWalkF (fuel - 1) namesTbl caller sizes facts region body (posWalkBindsF (fuel - 1) namesTbl caller sizes facts region binds st)
      EPi n implicit _ dom cod sp => posWalkF (fuel - 1) namesTbl caller sizes facts region cod (posWalkF (fuel - 1) namesTbl caller sizes facts region dom st)
      EField base f sp => posWalkF (fuel - 1) namesTbl caller sizes facts region base st
      ERecord rn fields sp => posWalkFieldsF (fuel - 1) namesTbl caller sizes facts region fields st
      ERecUpdate base fields sp => posWalkFieldsF (fuel - 1) namesTbl caller sizes facts region fields (posWalkF (fuel - 1) namesTbl caller sizes facts region base st)
      EDo stmts sp => posWalkStmtsF (fuel - 1) namesTbl caller sizes facts region stmts st
      EVar n sp => st
      EInt _ _ => st
      EStr _ _ => st
      EFloat _ _ => st
      EInterp _ _ => st

export posWalkCallee : HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> String -> Int -> List Expr -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkCallee namesTbl caller sizes facts region g i args st =
  posWalkCalleeGo namesTbl caller sizes facts region g (length args - i) args st

export posWalkCalleeGo : HashMap String Bool -> String -> List (String, Int, Int, List Int) -> HashMap String (List Int) -> List String -> String -> Int -> List Expr -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posWalkCalleeGo namesTbl caller sizes facts region g remaining args st =
  if remaining <= 0 then
    st
  else
    let
      i = length args - remaining
      st1 = if argPositive args i sizes caller facts region then posMarkPos g i st else posMarkNeg g i st
    in posWalkCalleeGo namesTbl caller sizes facts region g (remaining - 1) args st1

export posScanClauses : HashMap String Bool -> List (String, List (List Pat, Expr)) -> HashMap String (List Int) -> String -> List (List Pat, Expr) -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posScanClauses namesTbl defs facts caller [] st = st
posScanClauses namesTbl defs facts caller (cl :: rest) st =
  let
    sizes = strSizeEntries (firstOf cl)
    st2 = posWalk namesTbl caller sizes facts [] (secondOf cl) st
  in posScanClauses namesTbl defs facts caller rest st2

export posScanDefs : HashMap String Bool -> List (String, List (List Pat, Expr)) -> HashMap String (List Int) -> List (String, List (List Pat, Expr)) -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posScanDefs namesTbl defs facts [] st = st
posScanDefs namesTbl defs facts (d :: rest) st =
  posScanDefs
    namesTbl
    defs
    facts
    rest
    (posScanClauses namesTbl defs facts (firstOf d) (secondOf d) st)

-- 按名字列表扫描（worklist 不动点用）：只扫受影响的 caller，而不是每轮全量 defs。
export posScanNames : HashMap String Bool -> HashMap String (List (List Pat, Expr)) -> HashMap String (List Int) -> List String -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posScanNames namesTbl defTbl factsTbl work st =
  let
    scanned = posScanNamesGo namesTbl defTbl factsTbl work st
  in (posNormalize (firstOf scanned), posNormalize (secondOf scanned))

posScanNamesGo : HashMap String Bool -> HashMap String (List (List Pat, Expr)) -> HashMap String (List Int) -> List String -> (List (String, Int), List (String, Int)) -> (List (String, Int), List (String, Int))
posScanNamesGo namesTbl defTbl factsTbl [] st = st
posScanNamesGo namesTbl defTbl factsTbl (n :: rest) st =
  posScanNamesGo
    namesTbl
    defTbl
    factsTbl
    rest
    (posScanClauses namesTbl [] factsTbl n (clausesOfDefTbl n defTbl) st)

-- 单调不动点：每轮用当前事实重扫，只增不减；不收敛时提前停（保守，宁可多拒）。
export computePosFacts : List (String, List (List Pat, Expr)) -> Int -> List (String, Int) -> List (String, Int)
computePosFacts defs fuel facts = if fuel <= 0 then facts else computePosFactsStep defs fuel facts

export computePosFactsStep : List (String, List (List Pat, Expr)) -> Int -> List (String, Int) -> List (String, Int)
computePosFactsStep defs fuel facts =
  let
    namesTbl = HashMap.ofNames (defNames defs)
    scanned = posScanDefs namesTbl defs (posTblOf facts) defs ([], [])
    scan = (posNormalize (firstOf scanned), posNormalize (secondOf scanned))
    fresh = posFilterTbl (firstOf scan) (posTblOf (secondOf scan))
    merged = posUnionTbl facts fresh
  in if posSetEqTbl facts merged then merged else computePosFacts defs (fuel - 1) merged

export pathInPats : String -> List Pat -> List Int -> Int -> Maybe (List Int)
pathInPats v [] path k = Nothing
pathInPats v (p :: rest) path k =
  case pathInPat v p (append path [k]) of
    Just q => Just q
    Nothing => pathInPats v rest path (k + 1)

export pathInFields : String -> List (String, Pat) -> List Int -> Int -> Maybe (List Int)
pathInFields v [] path k = Nothing
pathInFields v ((fn, fp) :: rest) path k =
  case pathInPat v fp (append path [k]) of
    Just q => Just q
    Nothing => pathInFields v rest path (k + 1)

export pathInPat : String -> Pat -> List Int -> Maybe (List Int)
pathInPat v (PVar n sp) path = if n == v then Just path else Nothing
pathInPat v (PWild sp) path = Nothing
pathInPat v (PCon c ps sp) path = pathInPats v ps path 0
pathInPat v (PRecord rn fields sp) path = pathInFields v fields path 0
pathInPat v _ path = Nothing

export projectionOfDef : (String, List (List Pat, Expr)) -> Maybe (String, List Int)
projectionOfDef d =
  case secondOf d of
    [cl] =>
      case firstOf cl of
        [pat] =>
          case secondOf cl of
            EVar v vsp =>
              case pathInPat (v) pat [] of
                Just path => if notEmpty path then Just (firstOf d, path) else Nothing
                Nothing => Nothing
            -- 精化后的单构造子投影：`\p => case p of C .. v .. => v`。
            -- 与源码层的 `f (C .. v ..) = v` 是同一个定义，字段下标取**运行时位置**
            -- （擦除 binder 已在翻译时剔除）。
            ECase scrut alts csp =>
              case (pat, scrut, alts) of
                (PVar pn psp, EVar sn ssp, [alt]) =>
                  if pn == sn then
                    case alt.altBody of
                      EVar v vsp2 =>
                        case pathInPat (v) alt.altPat [] of
                          Just path => if notEmpty path then Just (firstOf d, path) else Nothing
                          Nothing => Nothing
                      _ => Nothing
                  else
                    Nothing
                _ => Nothing
            _ => Nothing
        _ => Nothing
    _ => Nothing

export projectionsOf : List (String, List (List Pat, Expr)) -> List (String, List Int)
projectionsOf [] = []
projectionsOf (d :: rest) =
  case projectionOfDef d of
    Just pr => pr :: projectionsOf rest
    Nothing => projectionsOf rest

-- ---------------------------------------------------------------
-- 记录字段投影：非 alias record 的字段按声明顺序编号，`r.f` 的尺寸 = `r` 的尺寸
-- 再下推一位。alias record 的投影是定义性恒等，必须排除；同名字段在不同记录里
-- 下标不一致时也丢弃（拿不到确切下标就不给证据）。
-- ---------------------------------------------------------------
fieldProjPrefix : String
fieldProjPrefix = "$field."

fieldEntryName : (String, Int) -> String
fieldEntryName p = firstOf p

fieldEntryIndex : (String, Int) -> Int
fieldEntryIndex p = secondOf p

fieldNameOfField : Field -> String
fieldNameOfField f = f.fieldName

numberedFieldNames : List Field -> Int -> List (String, Int)
numberedFieldNames [] i = []
numberedFieldNames (f :: rest) i = (fieldNameOfField f, i) :: numberedFieldNames rest (i + 1)

recordFieldEntries : List Decl -> (List (String, Int), List String)
recordFieldEntries [] = ([], [])
recordFieldEntries (d :: rest) =
  let
    prev = recordFieldEntries rest
  in case d of
    DRecord name params fields derivings viaField repr lin sp =>
      if reprAlias repr then
        (firstOf prev, append (map fieldNameOfField fields) (secondOf prev))
      else
        (append (numberedFieldNames fields 0) (firstOf prev), secondOf prev)
    _ => prev

reprAlias : ReprTier -> Bool
reprAlias ReprAlias = True
reprAlias _ = False

fieldIndexOfEntries : String -> List (String, Int) -> Maybe Int
fieldIndexOfEntries name entries =
  case dedupInts (map fieldEntryIndex (filter (\p => fieldEntryName p == name) entries)) of
    [k] => Just k
    _ => Nothing

export fieldProjectionsOf : List Decl -> List (String, List Int)
fieldProjectionsOf decls =
  let
    collected = recordFieldEntries decls
    entries = firstOf collected
    poisoned = secondOf collected
  in fieldProjectionsGo (dedup (map fieldEntryName entries)) entries poisoned

fieldProjectionsGo : List String -> List (String, Int) -> List String -> List (String, List Int)
fieldProjectionsGo [] entries poisoned = []
fieldProjectionsGo (n :: rest) entries poisoned =
  if memName n poisoned then
    fieldProjectionsGo rest entries poisoned
  else
    case fieldIndexOfEntries n entries of
      Just k => (fieldProjPrefix ++ n, [k]) :: fieldProjectionsGo rest entries poisoned
      Nothing => fieldProjectionsGo rest entries poisoned

-- | 字段名 → 声明顺序下标（只查 `fieldProjectionsOf` 写进 `projs` 的规范条目）。
export fieldIndexOf : String -> List (String, List Int) -> Maybe Int
fieldIndexOf f projs =
  case fieldProjPath (fieldProjPrefix ++ f) projs of
    Just path =>
      case path of
        [k] => Just k
        _ => Nothing
    Nothing => Nothing

fieldProjPath : String -> List (String, List Int) -> Maybe (List Int)
fieldProjPath name [] = Nothing
fieldProjPath name ((g, path) :: rest) = if name == g then Just path else fieldProjPath name rest

export projHas : String -> List (String, List Int) -> Bool
projHas f [] = False
projHas f ((g, path) :: rest) = f == g || projHas f rest

-- | 实参 `Ctor x0..xn` 恰好把形参同一构造子的各字段**原样**拼回：`xk` 的路径正好
-- 是 `[k]`（该字段本身）。成立时实参与形参相等 —— 弱边，不是下降。
export sameCtorApp : Int -> List Expr -> List (String, Int, Int, List Int) -> Bool
sameCtorApp p args sizes = sameCtorGo p args sizes 0

sameCtorGo : Int -> List Expr -> List (String, Int, Int, List Int) -> Int -> Bool
sameCtorGo p [] sizes k = k > 0
sameCtorGo p (a :: rest) sizes k =
  case a of
    EVar n sp =>
      case sizeOfVarStrict (n) sizes of
        Just sz =>
          case sz of
            (base, depth, path) => sameCtorField base depth path p rest sizes k
        Nothing => False
    _ => False

sameCtorField : Int -> Int -> List Int -> Int -> List Expr -> List (String, Int, Int, List Int) -> Int -> Bool
sameCtorField base depth path p rest sizes k =
  case base == p of
    True =>
      case depth == 1 of
        True =>
          case path of
            first :: restPath =>
              case restPath of
                [] => if first == k then sameCtorGo p rest sizes (k + 1) else False
                _ => False
            [] => False
        False => False
    False => False

export findWrapField : Int -> List Expr -> List (String, Int, Int, List Int) -> Int -> Maybe Int
findWrapField p [] sizes k = Nothing
findWrapField p (a :: rest) sizes k =
  case a of
    EVar n sp =>
      case sizeOfVarStrict (n) sizes of
        Just sz =>
          case sz of
            (base, depth, path) =>
              if base == p then
                wrapCheck p rest sizes k depth path
              else
                findWrapField p rest sizes (k + 1)
        Nothing => findWrapField p rest sizes (k + 1)
    _ => findWrapField p rest sizes (k + 1)

-- | 重建同一个构造子时，第 k 个字段必须换成原第 k 个字段的**真**子项：
-- `path = k :: restPath` 且 `restPath` 非空；`path = [k]` 是字段本身（相等），不是下降。
export wrapCheck : Int -> List Expr -> List (String, Int, Int, List Int) -> Int -> Int -> List Int -> Maybe Int
wrapCheck p rest sizes k depth path =
  case depth > 0 of
    True =>
      case path of
        first :: restPath =>
          if first == k then
            if notEmpty restPath then Just (k + 2) else findWrapField p rest sizes (k + 1)
          else
            findWrapField p rest sizes (k + 1)
        [] => findWrapField p rest sizes (k + 1)
    False => findWrapField p rest sizes (k + 1)

export posVarIn : String -> Int -> String -> HashMap String (List Int) -> List String -> Bool
posVarIn x p caller facts region = memName x region || posHasTbl caller p facts

export arithRel : Int -> Expr -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Maybe Int
arithRel p (EApp (EVar op osp) args sp) sizes caller facts region =
  if isSubOpName (op) then arithMinus p args sizes caller facts region else Nothing
arithRel p _ sizes caller facts region = Nothing

-- `-` 是 `Base.Trait.Num.sub` 的方法别名（Loader 在名字解析前替换），
-- 终止性检查里「fuel 递减」只看减法语义，因此两种写法都认。
-- | `-` 的两种写法：内建运算符名与 `Base.Trait.Num.sub` 方法投影（别名替换后）。
export isSubOpName : String -> Bool
isSubOpName op =
  op == "-" || op == "Base.Trait.Num.sub" || op == "Base.Trait.Num.-" || opBaseName op == "natSub"

-- | `+` 的两种写法：升序计数器不构成下降证据，但失败诊断要能指出来。
export isAddOpName : String -> Bool
isAddOpName op = op == "+" || op == "Base.Trait.Num.add" || op == "Base.Trait.Num.+"

export arithMinus : Int -> List Expr -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Maybe Int
arithMinus p args sizes caller facts region =
  case lastTwo args of
    Just (base, rhs) =>
      case natLitOf rhs of
        Just k => if k > 0 then arithMinusBase p base k sizes caller facts region else Nothing
        Nothing => Nothing
    Nothing => Nothing

-- 自然数字面量：`0` / `Z` / `Zero` 与 `Succ …` / `S …` 链（Core 里是构造子应用）。
natLitOf : Expr -> Maybe Int
natLitOf (EInt k sp) = if k >= 0 then Just k else Nothing
natLitOf (EVar n sp) =
  let
    b = opBaseName (n)
  in if b == "Z" || b == "Zero" then Just 0 else Nothing
natLitOf (EApp (EVar c csp) [x] sp) =
  let
    b = opBaseName (c)
  in if b == "S" || b == "Succ" then
    case natLitOf x of
      Just k => Just (k + 1)
      Nothing => Nothing
  else
    Nothing
natLitOf _ = Nothing

export arithMinusBase : Int -> Expr -> Int -> List (String, Int, Int, List Int) -> String -> HashMap String (List Int) -> List String -> Maybe Int
arithMinusBase p (EVar x xsp) k sizes caller facts region =
  case sizeOfVarStrict (x) sizes of
    Just sz =>
      case sz of
        (baseIdx, depth, path) =>
          if baseIdx == p then
            if depth == 0 then
              if posVarIn (x) p caller facts region then Just 4 else Nothing
            else
              Nothing
          else
            Nothing
    Nothing => Nothing
arithMinusBase p _ k sizes caller facts region = Nothing

-- 投影调用 `proj v`：v 是 p 位置形参（或其次子项）时，结果是严格子项 ⇒ 直接下降。
export projRel : Int -> List Expr -> List (String, Int, Int, List Int) -> Maybe Int
projRel p args sizes =
  case lastOf args of
    Just v =>
      case v of
        EVar x xsp =>
          case sizeOfVarStrict (x) sizes of
            Just sz =>
              case sz of
                (base, depth, path) => if base == p then Just 1 else Nothing
            Nothing => Nothing
        _ => Nothing
    Nothing => Nothing

lastOf : List a -> Maybe a
lastOf [] = Nothing
lastOf (x :: rest) =
  case rest of
    [] => Just x
    _ => lastOf rest

export relOfArg : Int -> Expr -> List (String, Int, Int, List Int) -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List String -> Maybe Int
relOfArg p (EVar n sp) sizes ctors projs caller facts region =
  case sizeOfVarStrict (n) sizes of
    Just sz =>
      case sz of
        (base, depth, path) => if base == p then if depth > 0 then Just 1 else Just 0 else Nothing
    Nothing => Nothing
relOfArg p (EField base f sp) sizes ctors projs caller facts region =
  case sizeOfExpr projs sizes (EField base f sp) of
    Just (b, d, path) => if b == p then if d > 0 then Just 1 else Just 0 else Nothing
    Nothing => Nothing
relOfArg p (a@(EApp fn cargs sp)) sizes ctors projs caller facts region =
  case fn of
    EVar c csp =>
      if memName (c) ctors then
        case findWrapField p cargs sizes 0 of
          Just m => Just m
          Nothing => if sameCtorApp p cargs sizes then Just relEqual else Nothing
      else if projHas (c) projs then projRel p cargs sizes else arithRel p a sizes caller facts region
    _ => arithRel p a sizes caller facts region
relOfArg p _ sizes ctors projs caller facts region = Nothing

export argRel : Int -> List Expr -> List (String, Int, Int, List Int) -> List String -> List (String, List Int) -> String -> HashMap String (List Int) -> List String -> Maybe Int
argRel p args sizes ctors projs caller facts region =
  case nthExpr args p of
    Nothing => Nothing
    Just a => relOfArg p a sizes ctors projs caller facts region

-- | 位置 p 的实参**为什么**证不出关系：只服务失败诊断，不参与判定。
-- 返回值是 `relMissingGuard` / `relAscending` / `relUnknownSize` / `relOtherPosition` / `relNoRelation`。
export argRelHint : Int -> List Expr -> List (String, Int, Int, List Int) -> List String -> Maybe Int
argRelHint p args sizes ctors =
  case nthExpr args p of
    Nothing => Nothing
    Just a =>
      case a of
        EVar n sp =>
          if memName (n) ctors then
            Just relNoRelation
          else
            case sizeOfVarStrict (n) sizes of
              Just sz =>
                case sz of
                  (base, depth, path) => if base == p then Just relNoRelation else Just relOtherPosition
              Nothing => Just relUnknownSize
        EApp (EVar op osp) xs sp =>
          if isSubOpName (op) then
            hintArith p xs sizes relMissingGuard
          else if isAddOpName (op) then hintArith p xs sizes relAscending else Just relNoRelation
        _ => Just relNoRelation

hintArith : Int -> List Expr -> List (String, Int, Int, List Int) -> Int -> Maybe Int
hintArith p [EVar x xsp, EInt k ksp] sizes mode =
  if k <= 0 then
    Just relNoRelation
  else
    case sizeOfVarStrict (x) sizes of
      Just sz =>
        case sz of
          (base, depth, path) => if base == p then if depth == 0 then Just mode else Just relNoRelation else Just relOtherPosition
      Nothing => Just relUnknownSize
hintArith p _ sizes mode = Just relNoRelation

export markInvalid : (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
markInvalid acc = (False, secondOf acc)

export addEdgeMode : String -> String -> Int -> Span -> (Bool, List (((String, String), Int), Span)) -> (Bool, List (((String, String), Int), Span))
addEdgeMode caller callee m sp acc = (firstOf acc, (((caller, callee), m), sp) :: secondOf acc)

export groupHead : List String -> Expr -> Maybe String
groupHead comp (EVar n sp) = if memName (n) comp then Just (n) else Nothing
groupHead comp _ = Nothing

export nthExpr : List Expr -> Int -> Maybe Expr
nthExpr [] i = Nothing
nthExpr (e :: rest) i = if i <= 0 then Just e else nthExpr rest (i - 1)

-- ---------------------------------------------------------------
-- 已知高阶函数：lambda 的第 `hofElemParam` 个参数绑定第 `hofListArg` 个容器实参的元素，
-- 其余 lambda 参数（折叠的累加器）不带尺寸。只认 base 的规范模块名：按短名匹配会把
-- 用户自定义的 `map` 也当成按元素应用。
-- ---------------------------------------------------------------
record HofSpec where
  hofLambdaArity : Int
  hofElemParam : Int
  hofListArg : Int

record HofCall where
  hofElemBinder : String
  hofListExpr : Expr
  hofSideArgs : List Expr
  hofBody : Expr

unaryHofSpec : HofSpec
unaryHofSpec = HofSpec 1 0 1

foldLHofSpec : HofSpec
foldLHofSpec = HofSpec 2 1 2

foldRHofSpec : HofSpec
foldRHofSpec = HofSpec 2 0 2

export hofSpecOf : String -> Maybe HofSpec
hofSpecOf name =
  case splitGlobalKey name of
    Just g => hofSpecIn (firstOf g) (secondOf g)
    Nothing => Nothing

hofSpecIn : String -> String -> Maybe HofSpec
hofSpecIn m b =
  if m == "Base.Data.List" then
    if b == "map" || b == "filter" || b == "concatMap" || b == "mapMaybe" then
      Just unaryHofSpec
    else
      case b of
        "foldl" => Just foldLHofSpec
        "foldr" => Just foldRHofSpec
        _ => Nothing
  else if m == "Base.Data.Result" || m == "Vuna.Compiler.Base.Common" then if b == "traverse" then Just unaryHofSpec else Nothing else Nothing

nthName : List String -> Int -> Maybe String
nthName [] i = Nothing
nthName (n :: rest) i = if i <= 0 then Just n else nthName rest (i - 1)

-- | 展开 `n` 个 lambda 参数（兼容 `\a, b =>` 与 `\a => \b =>` 两种写法）。
peelLam : Int -> Expr -> Maybe (List String, Expr)
peelLam n e =
  if n <= 0 then
    Just ([], e)
  else
    case e of
      ELam ns body sp =>
        if length ns > n then
          Nothing
        else
          case peelLam (n - length ns) body of
            Just (more, final) => Just (append (map firstOf ns) more, final)
            Nothing => Nothing
      _ => Nothing

-- | 若实参表匹配该 HOF 的形状且回调是 lambda，给出「元素 binder + 容器实参 +
--   其余要照常遍历的实参 + lambda 体」。
export hofLambdaCall : HofSpec -> List Expr -> Maybe HofCall
hofLambdaCall spec (e :: rest) =
  case peelLam spec.hofLambdaArity e of
    Just (ns, body) =>
      if length rest == spec.hofListArg then
        case nthExpr rest (spec.hofListArg - 1) of
          Just lst =>
            case nthName ns spec.hofElemParam of
              Just v => Just (HofCall v lst rest body)
              Nothing => Nothing
          Nothing => Nothing
      else
        Nothing
    Nothing => Nothing
hofLambdaCall spec _ = Nothing

export extendElemSizes : List (String, Int, Int, List Int) -> Expr -> String -> List (String, Int, Int, List Int)
extendElemSizes sizes (EVar n sp) v =
  case sizeOfVarStrict (n) sizes of
    Just sz =>
      case sz of
        (base, depth, path) => (v, base, depth + 1, append path [0]) :: sizes
    Nothing => sizes
extendElemSizes sizes _ v = sizes

export edgeStrict : String -> String -> List (((String, String), Int), Span) -> Bool
edgeStrict f g edges = edgeStrictGo f g edges False True

export edgeStrictGo : String -> String -> List (((String, String), Int), Span) -> Bool -> Bool -> Bool
edgeStrictGo f g [] seen acc = seen && acc
edgeStrictGo f g ((((cf, cg), m), sp) :: rest) seen acc =
  if cf == f then
    if cg == g then
      edgeStrictGo f g rest True (if m > 0 then acc else False)
    else
      edgeStrictGo f g rest seen acc
  else
    edgeStrictGo f g rest seen acc

export edgeTargets : String -> List (((String, String), Int), Span) -> List String
edgeTargets f edges = dedup (edgeTargetsGo f edges)

export edgeTargetsGo : String -> List (((String, String), Int), Span) -> List String
edgeTargetsGo f [] = []
edgeTargetsGo f ((((cf, cg), m), sp) :: rest) =
  if cf == f then cg :: edgeTargetsGo f rest else edgeTargetsGo f rest

-- 弱边邻接：组内边里「存在非严格调用点」的那些目标。
export weakAdj : List String -> List (((String, String), Int), Span) -> String -> List String
weakAdj comp edges f = weakAdjGo comp edges f (edgeTargets f edges)

export weakAdjGo : List String -> List (((String, String), Int), Span) -> String -> List String -> List String
weakAdjGo comp edges f [] = []
weakAdjGo comp edges f (g :: rest) =
  if edgeStrict f g edges then weakAdjGo comp edges f rest else g :: weakAdjGo comp edges f rest

-- 弱边可达性检查的步数上限：每个判据调用按输入规模派生，正常程序远低于此值；
-- 耗尽时返回 `(True, GaveUp …)`（保守当成「可达」保证 sound），调用方必须按放弃报。
weakReachBound : Int
weakReachBound = 100000

export weakReach : List String -> List (((String, String), Int), Span) -> String -> List String -> List String -> (Bool, GiveUp)
weakReach comp edges start frontier visited =
  weakReachFuel weakReachBound comp edges start frontier visited

export weakReachFuel : Int -> List String -> List (((String, String), Int), Span) -> String -> List String -> List String -> (Bool, GiveUp)
weakReachFuel fuel comp edges start frontier visited =
  if fuel <= 0 then
    (True, GaveUp "弱环可达性检查超出步数上限（${strFromInt weakReachBound}），按「可能存在环」保守处理")
  else
    case frontier of
      -- 耗尽不能回答「无环」：那会让 `hasWeakCycle` 放过一个环。按保守方向当成「可达」，
      -- 同时带上放弃标记，避免把「没算完」渲染成「证明有环」。
      [] => (False, NoGiveUp)
      n :: rest => if n == start then (True, NoGiveUp) else if memName n visited then weakReachFuel (fuel - 1) comp edges start rest visited else weakReachFuel (fuel - 1) comp edges start (append rest (weakAdj comp edges n)) (n :: visited)

export hasWeakCycle : List String -> List (((String, String), Int), Span) -> (Bool, GiveUp)
hasWeakCycle comp edges = hasWeakCycleGo comp edges comp

export hasWeakCycleGo : List String -> List (((String, String), Int), Span) -> List String -> (Bool, GiveUp)
hasWeakCycleGo comp edges [] = (False, NoGiveUp)
hasWeakCycleGo comp edges (f :: rest) =
  case weakReach comp edges f (weakAdj comp edges f) [f] of
    (True, g) => (True, g)
    (False, g1) =>
      case hasWeakCycleGo comp edges rest of
        (True, g2) => (True, g2)
        (False, g2) => (False, mergeGiveUp g1 g2)

-- 调用点关系编号：0 = 相等；正数 = 严格下降（1 子项 / 4 守卫减法）；
-- 负数 = 证不出关系（诊断收集用，不参与严格性判定）。
export relEqual : Int
relEqual = 0

export relStrictSub : Int
relStrictSub = 1

export relStrictMinus : Int
relStrictMinus = 4

export relUnknownSize : Int
relUnknownSize = -1

export relMissingGuard : Int
relMissingGuard = -2

export relNoRelation : Int
relNoRelation = -3

export relOtherPosition : Int
relOtherPosition = -4

export relAscending : Int
relAscending = -5

-- | 关系编号 → 诊断文案（human 视图与 `fields.call` 共用）。
export relText : Int -> String
relText m =
  if m == relStrictSub then
    "strict subterm"
  else if m == relStrictMinus then
    "decreases by a constant, with the non-negativity guard proven"
  else if m == relMissingGuard then
    "decreases by a constant, but the non-negativity guard is missing"
  else if m == relUnknownSize then
    "no known size (not a subterm of a parameter)"
  else if m == relOtherPosition then
    "decreases a different parameter"
  else if m == relEqual then
    "unchanged"
  else if m == relAscending then
    "increases instead of decreasing (ascending counters are not supported)"
  else
    "no size relation"

export isDescent : Int -> Bool
isDescent m = m > 0

export filterModes : List Int -> List Int
filterModes [] = []
filterModes (m :: rest) = if isDescent m then m :: filterModes rest else filterModes rest
