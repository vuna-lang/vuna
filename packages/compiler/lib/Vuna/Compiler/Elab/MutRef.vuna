-- | `Base.Effect.MutRef` 的编译期部分：名字常量、签名里的单元参数合成、
-- 以及用户面声明（`read`/`write`/`withMutRef`）到内部入口的改写。
--
-- 这一层只做纯结构操作（Term / Expr 的形状），不碰求解器状态。
module Vuna.Compiler.Elab.MutRef where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Base.Intrinsics
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name
import Vuna.Compiler.Frontend.Reserved

-- ---------------------------------------------------------------
-- 名字
-- ---------------------------------------------------------------
-- | 模块名。
export mrefModuleName : String
mrefModuleName = "Base.Effect.MutRef"

-- | 操作族：`MutRefOp a i`。
export mrefOpName : String
mrefOpName = "Base.Effect.MutRef.MutRefOp"

-- | 用户面声明（精化器识别后改写，不进运行时）。
export mrefReadName : String
mrefReadName = "Base.Effect.MutRef.read"

export mrefWriteName : String
mrefWriteName = "Base.Effect.MutRef.write"

export mrefWithName : String
mrefWithName = "Base.Effect.MutRef.withMutRef"

export mrefWithPureName : String
mrefWithPureName = "Base.Effect.MutRef.withMutRefPure"

-- | 内部入口（`@vuna@` 前缀；用户源码写不出）。
export mrefReadOpName : String
mrefReadOpName = "Base.Effect.MutRef.cellReadOp"

export mrefWriteOpName : String
mrefWriteOpName = "Base.Effect.MutRef.cellWriteOp"

export mrefWithOpName : String
mrefWithOpName = "Base.Effect.MutRef.cellWith"

export mrefWithPureOpName : String
mrefWithPureOpName = "Base.Effect.MutRef.cellWithPure"

-- | 单元类型（隐藏）。
export mrefCellTypeName : String
mrefCellTypeName = "@vuna@Cell"

-- | 行首条目收口（运行时恒等）。
export effDropHeadName : String
effDropHeadName = "Base.Effect.Core.dropEffHead"

-- | 纯执行入口。
export effRunPureName : String
effRunPureName = "Base.Effect.Core.runPure"

-- ---------------------------------------------------------------
-- 单元 binder 名（编译期名字 ↔ 运行时参数的唯一对应）
-- ---------------------------------------------------------------
-- | 实例名 → 单元 binder 名。
export mrefCellBinder : String -> String
mrefCellBinder n = "@vuna@cell@" ++ n

-- | 单元 binder 名 → 实例名（不是单元 binder 时 `Nothing`）。
export mrefCellNameOf : String -> Maybe String
mrefCellNameOf name =
  if startsWith "@vuna@cell@" name then
    Just (substring (natFromInt 11) (natFromInt (strLength name - 11)) name)
  else
    Nothing

-- ---------------------------------------------------------------
-- 类型里的行条目
-- ---------------------------------------------------------------
-- | 类型项 Pi 尾里的 `Eff <row> _` 行条目：实例名 + 族头 + 载荷项。
export record MrefRowEntry(..) where
  mrefRowEntryName : String
  mrefRowEntryFamily : String
  mrefRowEntryPayload : Term

export mrefRowEntryNameOf : MrefRowEntry -> String
mrefRowEntryNameOf e = e.mrefRowEntryName

export mrefRowEntryFamilyOf : MrefRowEntry -> String
mrefRowEntryFamilyOf e = e.mrefRowEntryFamily

-- | 项的（头部全局名, 显式实参）：`TApp` 脊与构造子应用统一展开。
export mrefHeadArgs : Term -> Maybe (String, List Term)
mrefHeadArgs t = mrefHeadArgsGo t []

mrefHeadArgsGo : Term -> List Term -> Maybe (String, List Term)
mrefHeadArgsGo (TApp f a _) acc = mrefHeadArgsGo f (a :: acc)
mrefHeadArgsGo (TCon n args) acc = Just (n, append (map firstOf args) acc)
mrefHeadArgsGo (TMk n args) acc = Just (n, append (map firstOf args) acc)
mrefHeadArgsGo (TGlobal g) acc = Just (g, acc)
mrefHeadArgsGo _ acc = Nothing

-- | 类型项 Pi 尾里的 `Eff <row> _` 行条目。
export mrefRowEntriesOfTy : Term -> List MrefRowEntry
mrefRowEntriesOfTy t = mrefRowEntriesOfTyGo 256 t

mrefRowEntriesOfTyGo : Int -> Term -> List MrefRowEntry
mrefRowEntriesOfTyGo fuel t =
  if fuel <= 0 then
    []
  else
    case t of
      TPi _ _ _ _ cod => mrefRowEntriesOfTyGo (fuel - 1) cod
      _ =>
        case mrefHeadArgs t of
          Just (g, args) =>
            if g == "Base.Effect.Core.Eff" then
              case args of
                row :: _ => mrefRowEntriesGo fuel row
                [] => []
            else
              []
          Nothing => []

mrefRowEntriesGo : Int -> Term -> List MrefRowEntry
mrefRowEntriesGo fuel r =
  if fuel <= 0 then
    []
  else
    case mrefHeadArgs r of
      Just (g, args) =>
        if g == effRowConsCtor then
          case args of
            head :: tail :: _ =>
              case mrefEntryOf head of
                Just e => e :: mrefRowEntriesGo (fuel - 1) tail
                Nothing => mrefRowEntriesGo (fuel - 1) tail
            _ => []
        else
          []
      Nothing => []

mrefEntryOf : Term -> Maybe MrefRowEntry
mrefEntryOf e =
  case mrefHeadArgs e of
    Just (g, args) =>
      if g == effNamedName then
        case args of
          nameTerm :: inner :: _ =>
            case nameTerm of
              TStr n =>
                case mrefHeadArgs inner of
                  Just (f, iargs) =>
                    case iargs of
                      payload :: _ => Just (MrefRowEntry n f payload)
                      [] => Just (MrefRowEntry n f inner)
                  Nothing => Nothing
              _ => Nothing
          _ => Nothing
      else
        Nothing
    Nothing => Nothing

-- | 签名里的单元参数：`MutRefOp` 条目的 `(实例名, 载荷项)`；依赖载荷跳过（v1 只要闭合载荷）。
export mrefCellParamsOf : Term -> List (String, Term)
mrefCellParamsOf ty = mrefCellParamsGo (mrefRowEntriesOfTy ty) []

mrefCellParamsGo : List MrefRowEntry -> List (String, Term) -> List (String, Term)
mrefCellParamsGo [] acc = reverse acc
mrefCellParamsGo (e :: rest) acc =
  if mrefRowEntryFamilyOf e == mrefOpName then
    mrefCellParamsGo rest ((mrefRowEntryNameOf e, e.mrefRowEntryPayload) :: acc)
  else
    mrefCellParamsGo rest acc

-- | 把单元参数前置到签名类型：每个 `(n, a)` 变成 `{@vuna@cell@n : Cell a}`。
export mrefAddCellParams : Term -> Term
mrefAddCellParams ty = mrefAddCellParamsGo (mrefCellParamsOf ty) ty

mrefAddCellParamsGo : List (String, Term) -> Term -> Term
mrefAddCellParamsGo [] ty = ty
mrefAddCellParamsGo ((n, a) :: rest) ty =
  TPi
    (mrefCellBinder n)
    True
    RigOmega
    (TApp (TGlobal mrefCellTypeName) a Rig0)
    (mrefAddCellParamsGo rest ty)

-- | 项里是否出现变量（用于「载荷必须闭合」的 v1 限制）。

-- ---------------------------------------------------------------
-- 重复实例名检查（concrete 前缀，按 (族头, 实例名)）
-- ---------------------------------------------------------------
-- | 行里重复的 `(族头, 实例名)`（只在 concrete 前缀上判断）。
export duplicateRowKeys : Term -> List (String, String)
duplicateRowKeys ty = duplicateKeysGo (mrefRowKeys (mrefRowEntriesOfTy ty)) []

mrefRowKeys : List MrefRowEntry -> List (String, String)
mrefRowKeys [] = []
mrefRowKeys (e :: rest) = (mrefRowEntryFamilyOf e, mrefRowEntryNameOf e) :: mrefRowKeys rest

duplicateKeysGo : List (String, String) -> List (String, String) -> List (String, String)
duplicateKeysGo [] _ = []
duplicateKeysGo (k :: rest) seen =
  if memKey k seen then k :: duplicateKeysGo rest seen else duplicateKeysGo rest (k :: seen)

memKey : (String, String) -> List (String, String) -> Bool
memKey k [] = False
memKey (f, n) ((f2, n2) :: rest) = if f == f2 && n == n2 then True else memKey (f, n) rest

-- ---------------------------------------------------------------
-- 用户面声明 → 内部入口的表达式改写
-- ---------------------------------------------------------------
-- | `read` / `read@x` 的改写（`cell` 是已解析的实例名）。
export mrefReadExpr : Span -> String -> Expr
mrefReadExpr sp cell =
  EApp
    (EVar (RGlobal mrefModuleName "cellReadOp") sp)
    [EApp (EVar (RIntrinsic instArgSyntax) sp) [EStr cell sp] sp, EVar (RLocal (mrefCellBinder cell)) sp]
    sp

-- | `write v` / `write@x v` 的改写。
export mrefWriteExpr : Span -> String -> Expr -> Expr
mrefWriteExpr sp cell v =
  EApp
    (EVar (RGlobal mrefModuleName "cellWriteOp") sp)
    [EApp (EVar (RIntrinsic instArgSyntax) sp) [EStr cell sp] sp, EVar (RLocal (mrefCellBinder cell)) sp, v]
    sp

-- | `withMutRef n init body` 的改写。
export mrefWithExpr : Span -> Expr -> Expr -> Expr -> String -> Expr
mrefWithExpr sp nExpr init body cellName =
  EApp
    (EVar (RGlobal "Base.Effect.Core" "dropEffHead") sp)
    [EApp (EVar (RGlobal mrefModuleName "cellWith") sp) [nExpr, init, ELam [(mrefCellBinder cellName, spanEmpty)] body sp] sp]
    sp

-- | `withMutRefPure n init body` 的改写。
export mrefWithPureExpr : Span -> Expr -> Expr -> Expr -> String -> Expr
mrefWithPureExpr sp nExpr init body cellName =
  EApp
    (EVar (RGlobal "Base.Effect.Core" "runPure") sp)
    [EApp (EVar (RGlobal "Base.Effect.Core" "dropEffHead") sp) [EApp (EVar (RGlobal mrefModuleName "cellWithPure") sp) [nExpr, init, ELam [(mrefCellBinder cellName, spanEmpty)] body sp] sp] sp]
    sp

-- | 字面量名字（`withMutRef` 的引入名必须是编译期常量）。
export stringLitOf : Expr -> Maybe String
stringLitOf (EStr s _) = Just s
stringLitOf _ = Nothing
