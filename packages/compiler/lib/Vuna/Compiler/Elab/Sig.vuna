module Vuna.Compiler.Elab.Sig where

-- Vuna.Compiler.Elab.Sig：签名工具：trait 类参数的 kind 推断与顶层签名的自由名量化。
-- 两者都只做 AST 变换，量化依赖 kind 推断，因此放在同一模块。
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Name
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Base.Intrinsics
import Vuna.Compiler.Frontend.AstQuery

-- ---------------------------------------------------------------------------
-- 类参数 kind 推断（原 Elab/Kind.vuna）
-- ---------------------------------------------------------------------------
-- 类参数的 kind 推断（多参数 trait 逐参数调用）：参数名被应用了 k 个实参就当
-- `Type -> ... -> Type`（k 个箭头），从未被应用就是 `Type`。
export classParamKindOf : String -> List (String, Expr) -> Term
classParamKindOf pname methods = arityFun (methodMaxAppArity pname methods) (TType levelZero)

export classParamKind : String -> List (String, Expr) -> Term
classParamKind pname methods = classParamKindOf pname methods

export arityFun : Int -> Term -> Term
arityFun n res = if n <= 0 then res else TPi "_" False Rig0 (TType levelZero) (arityFun (n - 1) res)

methodMaxAppArity : String -> List (String, Expr) -> Int
methodMaxAppArity pname methods =
  maxIntList (map (\m => exprMaxAppArity pname (secondOf m)) methods)

maxIntList : List Int -> Int
maxIntList [] = 0
maxIntList (x :: rest) = if x >= maxIntList rest then x else maxIntList rest

-- | 名字在一组表达式里的最大应用次数。
export exprMaxAppArityIn : String -> List Expr -> Int
exprMaxAppArityIn pname exprs = maxIntList (map (exprMaxAppArity pname) exprs)

export exprMaxAppArity : String -> Expr -> Int
exprMaxAppArity pname e = exprMaxAppArityF (exprBudget 64 e) pname e

exprMaxAppArityF : Int -> String -> Expr -> Int
exprMaxAppArityF fuel pname e =
  if fuel <= 0 then
    0
  else
    case e of
      EApp (EVar f fsp) args sp => if f == pname then maxIntList (natToInt (length args) :: map (exprMaxAppArityF (fuel - 1) pname) args) else maxIntList (map (exprMaxAppArityF (fuel - 1) pname) args)
      EApp fn args sp => maxIntList (exprMaxAppArityF (fuel - 1) pname fn :: map (exprMaxAppArityF (fuel - 1) pname) args)
      ELam names body sp => exprMaxAppArityF (fuel - 1) pname body
      EPi n implicit _ dom cod sp => maxIntList [exprMaxAppArityF (fuel - 1) pname dom, exprMaxAppArityF (fuel - 1) pname cod]
      EIf c t f sp => maxIntList [exprMaxAppArityF (fuel - 1) pname c, exprMaxAppArityF (fuel - 1) pname t, exprMaxAppArityF (fuel - 1) pname f]
      ELet binds body rec_ sp => maxIntList (exprMaxAppArityF (fuel - 1) pname body :: exprMaxAppArityBindsF (fuel - 1) pname binds)
      ECase scrut alts sp => maxIntList (exprMaxAppArityF (fuel - 1) pname scrut :: concatMap (\a => [exprMaxAppArityF (fuel - 1) pname (altBodyOf a)]) alts)
      EField b f sp => exprMaxAppArityF (fuel - 1) pname b
      ERecord rn fields sp => maxIntList (map (\q => exprMaxAppArityF (fuel - 1) pname (secondOf q)) fields)
      ERecUpdate b fields sp => exprMaxAppArityF (fuel - 1) pname b
      _ => 0

exprMaxAppArityBindsF : Int -> String -> List Binding -> List Int
exprMaxAppArityBindsF fuel pname [] = []
exprMaxAppArityBindsF fuel pname (b :: rest) =
  exprMaxAppArityBindingF (fuel - 1) pname b :: exprMaxAppArityBindsF (fuel - 1) pname rest

exprMaxAppArityBindingF : Int -> String -> Binding -> Int
exprMaxAppArityBindingF fuel pname (Binding pat value sig ref) =
  maxIntList
    [exprMaxAppArityValueF (fuel - 1) pname value, exprMaxAppAritySigF (fuel - 1) pname sig]

exprMaxAppArityValueF : Int -> String -> BindingValue -> Int
exprMaxAppArityValueF fuel pname (BVal e) = exprMaxAppArityF (fuel - 1) pname e
exprMaxAppArityValueF fuel pname (BClauses cs) =
  maxIntList (map (\c => exprMaxAppArityF (fuel - 1) pname (clauseBodyOf c)) cs)

exprMaxAppAritySigF : Int -> String -> Maybe BindingSig -> Int
exprMaxAppAritySigF fuel pname (Just sig) = exprMaxAppArityF (fuel - 1) pname sig.sigType
exprMaxAppAritySigF fuel pname Nothing = 0

altBodyOf : Alt -> Expr
altBodyOf a = a.altBody

clauseBodyOf : LocalClause -> Expr
clauseBodyOf c = c.lcBody

-- 方法的显式参数各自的 multiplicity：逐 binder 按域判断，判据由调用方传入
-- （`Elab` 的 `piBinderRig`——`Elab.Sig` 不重复定义擦除规则，保持单一入口）。
export methodArgRigsOf : (Bool -> Value -> Rig) -> Term -> List Rig
methodArgRigsOf rigOf ty = methodArgRigsOfGo rigOf ty []

methodArgRigsOfGo : (Bool -> Value -> Rig) -> Term -> List Value -> List Rig
methodArgRigsOfGo rigOf (TPi name implicit rigB dom cod) env =
  let
    domVal = eval env dom
    v = VNeutral (NVar name (length env) [])
  in rigB :: methodArgRigsOfGo rigOf cod (v :: env)
methodArgRigsOfGo rigOf _ env = []

-- ---------------------------------------------------------------------------
-- 顶层签名量化（原 Elab/Quant.vuna）
-- ---------------------------------------------------------------------------
-- 把 trait 方法签名里的自由小写名量化为隐式类型参数。
-- `boundInScope` 给出「这个名字已在上下文里」的判定（trait 的类参数不算自由变量，
-- 且它们的 kind 是 `Type -> Type` 这类高阶形态，不能被 `Type` 覆盖）。
export quantifyTraitSig : (String -> Bool) -> Expr -> Span -> Expr
quantifyTraitSig inScope ty sp = quantify (freeNames inScope ty) ty sp

freeNames : (String -> Bool) -> Expr -> List String
freeNames inScope ty = keepOut inScope (dropPiBound (lowerVarNames ty) (piBoundNames ty))

keepOut : (String -> Bool) -> List String -> List String
keepOut inScope [] = []
keepOut inScope (n :: rest) = if inScope n then keepOut inScope rest else n :: keepOut inScope rest

quantify : List String -> Expr -> Span -> Expr
quantify [] e sp = e
quantify (n :: rest) e sp =
  EPi n True Nothing (EVar ("Type") (detachedNodeRef sp)) (quantify rest e sp) (detachedNodeRef sp)

-- 顶层签名的自由名按**用法**给 kind：名字在签名里被应用了 k 个实参 ⇒ `Type -> ... -> Type`
-- （`bindPair : m a -> m b -> m (Pair a b)` 的 `m`）。一律绑 `Type` 会让 `m a`
-- 报 "too many arguments (not a function)"。规则与 trait 类参数（`Elab.Sig.classParamKind`）
-- 同一套，只是作用在任意自由名上。
quantifyTopKinds : List String -> Expr -> Expr -> Span -> Expr
quantifyTopKinds names sigExpr e sp = quantifyTopKindsWith (\_ => Nothing) names [sigExpr] e sp

-- 带域覆盖的量化：`Member n e r => ...` 里的 n 是 String、r 是 Row（不是按应用次数
-- 推出的 Type）。其余名字仍按「在 `scanExprs` 里的最大应用次数」定 kind。
--
-- 扫描目标是**一组表达式**（签名 ctx ++ 返回类型）：扫描函数直接收列表，不构造伪应用
-- 把列表塞进单个 `Expr`。
quantifyTopKindsWith : (String -> Maybe Expr) -> List String -> List Expr -> Expr -> Span -> Expr
quantifyTopKindsWith domOf [] scanExprs e sp = e
quantifyTopKindsWith domOf (n :: rest) scanExprs e sp =
  let
    dom =
      case domOf n of
        Just d => d
        Nothing => kindArrowExpr (exprMaxAppArityIn n scanExprs) sp
  in EPi n True Nothing dom (quantifyTopKindsWith domOf rest scanExprs e sp) (detachedNodeRef sp)

-- 签名约束里的 `Member n e r`：收集 n/r 的域覆盖（String/Row），供量化使用。
-- 只有顶层签名 ctx 走这里；`Member` 本身仍是 Base.Effect.Core 的 data family，不是 trait。
memberDomainOverrides : List Expr -> List (String, Expr)
memberDomainOverrides [] = []
memberDomainOverrides (e :: rest) = append (memberDomainOverridesOne e) (memberDomainOverrides rest)

memberDomainOverridesOne : Expr -> List (String, Expr)
memberDomainOverridesOne (EApp (EVar g _) [nExpr, _, rExpr] sp) =
  if g == effMemberFamilyName then
    let
      nPart =
        case nExpr of
          EVar n nsp => [(n, EVar (strTypeName) nsp)]
          _ => []
      rPart =
        case rExpr of
          EVar r rsp => [(r, EVar (effRowFamilyName) rsp)]
          _ => []
    in append nPart rPart
  else
    []
memberDomainOverridesOne _ = []

memberDomainOf : List (String, Expr) -> String -> Maybe Expr
memberDomainOf [] n = Nothing
memberDomainOf ((k, v) :: rest) n = if k == n then Just v else memberDomainOf rest n

kindArrowExpr : Int -> Span -> Expr
kindArrowExpr k sp =
  let
    r = detachedNodeRef sp
  in if k <= 0 then
    EVar ("Type") r
  else
    EPi "_" False Nothing (EVar ("Type") r) (kindArrowExpr (k - 1) sp) r

piBoundNames : Expr -> List String
piBoundNames (EPi n implicit _ dom cod sp) = n :: piBoundNames cod
piBoundNames _ = []

lowerVarNames : Expr -> List String
lowerVarNames e = nubNames (exprLowerVars e)

export exprLowerVars : Expr -> List String
exprLowerVars e = exprLowerVarsF (exprBudget 64 e) e

exprLowerVarsF : Int -> Expr -> List String
exprLowerVarsF fuel e =
  if fuel <= 0 then
    []
  else
    case e of
      EVar n sp => if isLowerIdent (n) then [n] else []
      EApp fn args sp => append (exprLowerVarsF (fuel - 1) fn) (concatMap (exprLowerVarsF (fuel - 1)) args)
      ELam names body sp => exprLowerVarsF (fuel - 1) body
      EPi n implicit _ dom cod sp => append (exprLowerVarsF (fuel - 1) dom) (exprLowerVarsF (fuel - 1) cod)
      EIf c t f sp => append (exprLowerVarsF (fuel - 1) c) (append (exprLowerVarsF (fuel - 1) t) (exprLowerVarsF (fuel - 1) f))
      ELet binds body rec_ sp => append (exprLowerVarsBindsF (fuel - 1) binds) (exprLowerVarsF (fuel - 1) body)
      ECase scrut alts sp => append (exprLowerVarsF (fuel - 1) scrut) (concatMap (\a => exprLowerVarsF (fuel - 1) (altBodyOf a)) alts)
      EField b f sp => exprLowerVarsF (fuel - 1) b
      ERecord rn fields sp => concatMap (\q => exprLowerVarsF (fuel - 1) (secondOf q)) fields
      ERecUpdate b fields sp => exprLowerVarsF (fuel - 1) b
      _ => []

exprLowerVarsBindsF : Int -> List Binding -> List String
exprLowerVarsBindsF fuel [] = []
exprLowerVarsBindsF fuel (b :: rest) =
  append (exprLowerVarsBindingF (fuel - 1) b) (exprLowerVarsBindsF (fuel - 1) rest)

exprLowerVarsBindingF : Int -> Binding -> List String
exprLowerVarsBindingF fuel (Binding pat value sig ref) =
  append (exprLowerVarsValueF (fuel - 1) value) (exprLowerVarsSigF (fuel - 1) sig)

exprLowerVarsValueF : Int -> BindingValue -> List String
exprLowerVarsValueF fuel (BVal e) = exprLowerVarsF (fuel - 1) e
exprLowerVarsValueF fuel (BClauses cs) = exprLowerVarsClausesF (fuel - 1) cs

exprLowerVarsSigF : Int -> Maybe BindingSig -> List String
exprLowerVarsSigF fuel (Just sig) = exprLowerVarsF (fuel - 1) sig.sigType
exprLowerVarsSigF fuel Nothing = []

exprLowerVarsClausesF : Int -> List LocalClause -> List String
exprLowerVarsClausesF fuel [] = []
exprLowerVarsClausesF fuel (c :: rest) =
  append (exprLowerVarsF (fuel - 1) c.lcBody) (exprLowerVarsClausesF (fuel - 1) rest)

isLowerIdent : String -> Bool
isLowerIdent n =
  case strUnpack n of
    [] => False
    c :: rest => c >= 97 && c <= 122

dropPiBound : List String -> List String -> List String
dropPiBound names [] = names
dropPiBound names (b :: rest) = dropPiBound (dropName b names) rest

dropName : String -> List String -> List String
dropName b [] = []
dropName b (n :: rest) = if n == b then dropName b rest else n :: dropName b rest

-- 顶层签名里要量化的自由名字：额外排除本程序另有定义的名字（`vapp` 这类会被误
-- 当类型变量）与内建 prelude 名。每个名字的 kind 按它在签名里的应用次数推断。
export quantifyTopSig : HashMap String Bool -> Expr -> Span -> Expr
quantifyTopSig banned ty sp =
  quantifyTopKinds (keepOutTbl banned (freeNames (\n => False) ty)) ty ty sp

-- data 声明里每个族的**参数 kind**（kind 的箭头域，源语法形态）。
-- 自由名作为类型构造子实参时用它定 kind：`Box f` 里的 `f` 需要 `Type -> Type`，
-- 只看「被应用了几次」会把 `f` 判成 `Type`（`Box f` 于是报 kind 不匹配）。
export dataParamKindTbl : List Decl -> List (String, List Expr)
dataParamKindTbl [] = []
dataParamKindTbl (d :: rest) =
  case d of
    DData name params kind ctors derivings viaField repr lin sp =>
      (name, kindDomains kind) :: dataParamKindTbl rest
    _ => dataParamKindTbl rest

-- 两种箭头编码都要认：binder 形态是 `EPi`，匿名 `A -> B` 是 `EApp (EVar "->") [A, B]`
-- （见 `Frontend/Ast` 的编码约定）。
kindDomains : Expr -> List Expr
kindDomains (EPi n implicit _ dom cod sp) = dom :: kindDomains cod
kindDomains (EApp fn args sp) =
  case fn of
    EVar "->" _ =>
      case args of
        dom :: cod :: rest => dom :: kindDomains cod
        _ => []
    _ => []
kindDomains _ = []

-- 签名里「自由名作为某个族的第 i 个实参」出现的位置 ⇒ 该位置的参数 kind。
-- 只收集直接写出的 `T x1 … xk`（`EVar T` 应用）里的裸变量实参；实参本身是应用时
-- 交给「按应用次数」的规则。
-- | `argParamKinds` 的一组表达式版本（签名 ctx ++ 返回类型）。
export argParamKindsIn : List (String, List Expr) -> List Expr -> List (String, Expr)
argParamKindsIn tbl exprs = concatMap (argParamKinds tbl) exprs

export argParamKinds : List (String, List Expr) -> Expr -> List (String, Expr)
argParamKinds tbl e = argParamKindsF (exprBudget 64 e) tbl e

argParamKindsF : Int -> List (String, List Expr) -> Expr -> List (String, Expr)
argParamKindsF fuel tbl e =
  if fuel <= 0 then
    []
  else
    case e of
      EApp (EVar t _) args sp => append (zipArgKinds (lookupParamKinds tbl (t)) args) (concatMap (argParamKindsF (fuel - 1) tbl) args)
      EApp fn args sp => append (argParamKindsF (fuel - 1) tbl fn) (concatMap (argParamKindsF (fuel - 1) tbl) args)
      ELam names body sp => argParamKindsF (fuel - 1) tbl body
      EPi n i _ dom cod sp => append (argParamKindsF (fuel - 1) tbl dom) (argParamKindsF (fuel - 1) tbl cod)
      ELet binds body rec_ sp => append (argParamKindsBindsF (fuel - 1) tbl binds) (argParamKindsF (fuel - 1) tbl body)
      ECase scrut alts sp => append (argParamKindsF (fuel - 1) tbl scrut) (concatMap (\a => argParamKindsF (fuel - 1) tbl (altBodyOf a)) alts)
      EIf c t f sp => append (argParamKindsF (fuel - 1) tbl c) (append (argParamKindsF (fuel - 1) tbl t) (argParamKindsF (fuel - 1) tbl f))
      EField b f sp => argParamKindsF (fuel - 1) tbl b
      ERecord rn fields sp => concatMap (\q => argParamKindsF (fuel - 1) tbl (secondOf q)) fields
      ERecUpdate b fields sp => argParamKindsF (fuel - 1) tbl b
      _ => []

argParamKindsBindsF : Int -> List (String, List Expr) -> List Binding -> List (String, Expr)
argParamKindsBindsF fuel tbl [] = []
argParamKindsBindsF fuel tbl (b :: rest) =
  append (argParamKindsBindingF (fuel - 1) tbl b) (argParamKindsBindsF (fuel - 1) tbl rest)

argParamKindsBindingF : Int -> List (String, List Expr) -> Binding -> List (String, Expr)
argParamKindsBindingF fuel tbl (Binding pat value sig ref) =
  append (argParamKindsValueF (fuel - 1) tbl value) (argParamKindsSigF (fuel - 1) tbl sig)

argParamKindsValueF : Int -> List (String, List Expr) -> BindingValue -> List (String, Expr)
argParamKindsValueF fuel tbl (BVal e) = argParamKindsF (fuel - 1) tbl e
argParamKindsValueF fuel tbl (BClauses cs) = argParamKindsClausesF (fuel - 1) tbl cs

argParamKindsSigF : Int -> List (String, List Expr) -> Maybe BindingSig -> List (String, Expr)
argParamKindsSigF fuel tbl (Just sig) = argParamKindsF (fuel - 1) tbl sig.sigType
argParamKindsSigF fuel tbl Nothing = []

argParamKindsClausesF : Int -> List (String, List Expr) -> List LocalClause -> List (String, Expr)
argParamKindsClausesF fuel tbl [] = []
argParamKindsClausesF fuel tbl (c :: rest) =
  append (argParamKindsF (fuel - 1) tbl c.lcBody) (argParamKindsClausesF (fuel - 1) tbl rest)

lookupParamKinds : List (String, List Expr) -> String -> Maybe (List Expr)
lookupParamKinds [] name = Nothing
lookupParamKinds ((n, ks) :: rest) name = if n == name then Just ks else lookupParamKinds rest name

zipArgKinds : Maybe (List Expr) -> List Expr -> List (String, Expr)
zipArgKinds Nothing args = []
zipArgKinds (Just doms) args = zipArgKindsGo doms args

zipArgKindsGo : List Expr -> List Expr -> List (String, Expr)
zipArgKindsGo [] args = []
zipArgKindsGo doms [] = []
zipArgKindsGo (dom :: drest) (a :: arest) =
  case a of
    EVar n nsp => (n, dom) :: zipArgKindsGo drest arest
    _ => zipArgKindsGo drest arest

-- 顶层量化要排除的名字集合（本程序定义名 + 内建 prelude 名），哈希集合 O(1) 判定。
export topQuantBanned : List String -> HashMap String Bool
topQuantBanned defined = HashMap.ofNames (append defined topPreludeNames)

-- banned 集按**模块作用域**计算——只排除「与签名同一模块里另有定义」的
-- 名字。程序级 flatten 后模块边界落在名字的模块前缀（最后一段之前）上；入口文件的
-- 顶层名没有前缀（空串）。跨模块同名小写名不再让签名里的类型变量被误当全局名。
export bannedForModule : String -> List String -> HashMap String Bool
bannedForModule sigName defined = topQuantBanned (filterNamesInModule sigName defined)

filterNamesInModule : String -> List String -> List String
filterNamesInModule sigName [] = []
filterNamesInModule sigName (n :: rest) =
  if modulePrefixOf n == modulePrefixOf sigName then
    n :: filterNamesInModule sigName rest
  else
    filterNamesInModule sigName rest

-- 名字的模块前缀（`Base.Data.Nat.succ` → `Base.Data.Nat`；入口顶层的 `main` → ""）。
export modulePrefixOf : String -> String
modulePrefixOf name =
  case splitLastDot (splitOnDot name) of
    (rev, base) => joinDots rev

-- ---------------------------------------------------------------
-- 签名量化的**共享 banned 表**
-- ---------------------------------------------------------------
-- 逐签名扫一遍全程序 defined 名（filterNamesInModule 里逐名算 modulePrefixOf）并重建
-- 哈希表是 O(#签名 × #定义名) 次 splitOnDot/splitLastDot，每次分配。这里把「模块前缀 +
-- 名字」做成**一次性**的全局键，签名检查只做 O(1) 查表；语义与逐模块过滤逐项等价：
--   banned = prelude ∪ { n ∈ defined | modulePrefixOf n == modulePrefixOf sigName }
--   keepOutQualified σ 用 prelude 表 + 键 `modulePrefixOf sigName ++ "\t" ++ n`
-- 分隔符取 `\t`（标识符只允许字母/数字/下划线/撇号，mangle 前缀只含点，绝不会撞）。
export qualifiedBannedTbl : List String -> HashMap String Bool
qualifiedBannedTbl defined =
  HashMap.insertAll
    (map (\n => (qualifiedKey (modulePrefixOf n) n, True)) defined)
    (HashMap.fromList [])

qualifiedKey : String -> String -> String
qualifiedKey prefix name = "${prefix}\t${name}"

-- 与 `quantifyTopSig` 同义，但 banned 用共享的 qualified 表 + 全局 prelude 表。
export quantifyTopSigCached : String -> HashMap String Bool -> HashMap String Bool -> Expr -> Span -> Expr
quantifyTopSigCached prefix banned preludeBanned ty sp =
  quantifyTopKinds
    (keepOutQualified prefix banned preludeBanned (freeNames (\n => False) ty))
    ty
    ty
    sp

-- 带 trait 约束的顶层签名量化。约束实参与返回类型**一起**参与自由名扫描与
-- kind 推断（只出现在 `Eq a` 里的 `a` 也要量化），但只把 Pi 链包在返回类型上：
-- `f : Eq a => a -> Bool` 量化成 `{a : Type} -> (Eq a => a -> Bool)`。
export quantifyTopSigCtxCached : String -> HashMap String Bool -> HashMap String Bool -> List Expr -> Expr -> Span -> Expr
quantifyTopSigCtxCached prefix banned preludeBanned ctx ty sp =
  let
    -- 约束实参与返回类型一起参与自由名/应用次数扫描；`piBoundNames`（只看顶层 EPi 链）
    -- 看不到 ctx 里的 binder，ty 自己的 binder 必须手动扣除，否则显式
    -- `{a : Type} -> a -> a` 里的 a 会被当成自由名再量化一次
    -- （签名变成 `{a : Type} -> {a : Type} -> a -> a`，推断位置留下无主元变量）。
    scanExprs = append ctx [ty]
    lower = nubNames (append (concatMap exprLowerVars ctx) (exprLowerVars ty))
    names = keepOutQualified prefix banned preludeBanned (dropPiBound lower (piBoundNames ty))
    overrides = memberDomainOverrides ctx
  in quantifyTopKindsWith (memberDomainOf overrides) names scanExprs ty sp

-- 与 `quantifyTopSigCtxCached` 同义，额外用 data 声明的参数 kind 给「作为类型构造子
-- 实参的自由名」定 kind（优先级：`Member` 域覆盖 > 参数位置 kind > 按应用次数）。
export quantifyTopSigCtxCachedKinds : String -> HashMap String Bool -> HashMap String Bool -> List (String, List Expr) -> List Expr -> Expr -> Span -> Expr
quantifyTopSigCtxCachedKinds prefix banned preludeBanned paramKinds ctx ty sp =
  let
    scanExprs = append ctx [ty]
    lower = nubNames (append (concatMap exprLowerVars ctx) (exprLowerVars ty))
    names = keepOutQualified prefix banned preludeBanned (dropPiBound lower (piBoundNames ty))
    memberOverrides = memberDomainOverrides ctx
    argOverrides = argParamKindsIn paramKinds scanExprs
  in quantifyTopKindsWith (kindOverrideOf memberOverrides argOverrides) names scanExprs ty sp

-- kind 来源优先级：`Member` 域覆盖 > 参数位置 kind > 按应用次数（后者由调用点兜底）。
kindOverrideOf : List (String, Expr) -> List (String, Expr) -> String -> Maybe Expr
kindOverrideOf memberOverrides argOverrides n =
  case memberDomainOf memberOverrides n of
    Just d => Just d
    Nothing => paramKindOf argOverrides n

paramKindOf : List (String, Expr) -> String -> Maybe Expr
paramKindOf [] n = Nothing
paramKindOf ((k, d) :: rest) n = if k == n then Just d else paramKindOf rest n

keepOutQualified : String -> HashMap String Bool -> HashMap String Bool -> List String -> List String
keepOutQualified prefix banned preludeBanned [] = []
keepOutQualified prefix banned preludeBanned (n :: rest) =
  if HashMap.member n preludeBanned then
    keepOutQualified prefix banned preludeBanned rest
  else if HashMap.member (qualifiedKey prefix n) banned then
    keepOutQualified prefix banned preludeBanned rest
  else
    n :: keepOutQualified prefix banned preludeBanned rest

keepOutTbl : HashMap String Bool -> List String -> List String
keepOutTbl banned [] = []
keepOutTbl banned (n :: rest) =
  if HashMap.member n banned then keepOutTbl banned rest else n :: keepOutTbl banned rest

topPreludeNames : List String
topPreludeNames = append ["Type", "->", "_"] (append typeIntrinsicNames preludeValueNames)

-- 本程序里另有定义（DFun / DAxiom）的顶层名字：签名里的这些名字不是类型变量。
export definedNames : List Decl -> List String
definedNames [] = []
definedNames (d :: rest) =
  case d of
    DFun n pats body sp => n :: definedNames rest
    DAxiom n ty sp => n :: definedNames rest
    DExtern n c ty sp => n :: definedNames rest
    _ => definedNames rest
