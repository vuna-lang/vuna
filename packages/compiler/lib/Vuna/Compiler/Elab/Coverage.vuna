module Vuna.Compiler.Elab.Coverage where

-- Vuna.Compiler.Elab.Coverage：覆盖 / 可达性判定的**唯一**结论类型与模式矩阵工具。
--
-- 结论只有三种（`CoverVerdict`）：`CoverProved`（已证明覆盖）、`CoverMissing`
-- （已证明缺一个**可达**构造子）、`CoverUnknown`（无法证明：索引族 / 未知族 / 重载
-- 构造子 / 燃料耗尽）。**`CoverUnknown` 不等于「已覆盖」**：它会出现在需要「缺分支」
-- 结论的位置，调用方不得据此放行；只有 `CoverProved` / `CoverMissing` 是证明。
-- 家族归属也只有一个入口（`ctorFamily`）：参数族可按名字判覆盖，索引族的名字集合
-- 不等于可达集合（`Vec 2 a` 没有 `VNil`），重载/缺失构造子无从定位族。
--
-- 五处判定都消费这里：`Elab.Case` 的分支可达性（`BranchVerdict`，索引合一 + 空族）、
-- `clauseCover`（clause 有用性）、`Match.familyCoverVerdict`（是否补通配兜底）、
-- 见证（`matrixWitness`）与 `Impl` 的 Bool / Int / String / Nat 字面量特化
-- （`specializationCover`：这些族没有索引，结论与通用判据同源）。
--
-- 见证：输入是模式矩阵（每行一个 clause 的模式向量）与构造子表
-- （族 → (是否可判, [(构造子, 显式参数个数)])），输出**第一个**缺失模式的向量：
-- Maranget 的 usefulness 在全通配查询上的特化。调用方式是**后置**的：矩阵照常降级、
-- 精化，只有精化已经报 `TC_NotExhaustive` 时才用见证改写首行消息（`improveExhaustive`）。
-- 这样类型错、分支参数个数错等更具体的诊断优先——精化前的预检会把它们盖掉。
--
-- 判据与降级一致：
--   * 构造子列：族的全部构造子逐个尝试（**没出现的先试**，见证更具体）；通配行同时参与
--     特化，所以「有构造子没出现」不等于不穷尽（`Cons _ _ ; _ _` 是穷尽的）；
--   * 字面量列：无限域，只有通配行覆盖；
--   * 索引族 / 未知族 / 重载构造子：给不出见证（`WitnessUnknown`），**不当成已覆盖**；
--     索引族的可达集合由 `Elab.Case` 的同一套判据提供，矩阵只在根列消费它；
--   * 各行必须等长：`where` / `let` 允许不同 arity 的方程，矩阵算法不适用于那种组。
--
-- 参数个数用**显式** Pi binder 数（模式只写显式子模式，隐式族参数由精化器插入）。
import Base.Data.List as List
import Base.Data.Nat as Nat
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Name

emptyPatSpan : Span
emptyPatSpan = Span "" 0 0 0 0 0 0

-- ---------------------------------------------------------------
-- 覆盖 / 可达性的唯一结论类型
-- ---------------------------------------------------------------
-- `CoverUnknown` 是「无法证明」，不是「已覆盖」：需要「缺分支」结论的调用方只能消费
-- `CoverProved` / `CoverMissing`；需要「多写了分支」结论的调用方遇到 `CoverUnknown`
-- 只能不报（不能把无法证明当成不可达，否则是保守误拒）。
export data CoverVerdict(..) : Type where
  CoverProved : CoverVerdict
  CoverMissing : CoverVerdict
  CoverUnknown : CoverVerdict

-- 特化家族（Bool / Int / String / Nat 字面量）的覆盖结论。这些族没有索引：
-- 目标分支或兜底写了 ⇔ 覆盖，没写 ⇒ 缺，不存在「无法证明」。
export specializationCover : Bool -> CoverVerdict
specializationCover True = CoverProved
specializationCover False = CoverMissing

-- 一行等长的通配模式。
export wilds : Int -> List Pat
wilds n = if n <= 0 then [] else PWild (detachedNodeRef emptyPatSpan) :: wilds (n - 1)

-- 剥掉 as-pattern（覆盖性按内层模式判定）。
export patHead : Pat -> Pat
patHead (PAs _ inner _) = patHead inner
patHead p = p

headCtorName : List Pat -> Maybe String
headCtorName [] = Nothing
headCtorName (p :: _) =
  case patHead p of
    PCon c _ _ => Just (c)
    _ => Nothing

-- 该列出现的构造子名（保序、去重）。
ctorHeadsOf : List (List Pat) -> List String
ctorHeadsOf rows = nubNames (mapMaybe headCtorName rows)

-- 通配头（变量/通配/as-通配）：该行覆盖整列。
isWildHead : Pat -> Bool
isWildHead p =
  case patHead p of
    PVar _ _ => True
    PWild _ => True
    _ => False

-- 默认矩阵：只保留通配头行，并丢掉该列。
defaultRows : List (List Pat) -> List (List Pat)
defaultRows [] = []
defaultRows (row :: rest) =
  case row of
    [] => defaultRows rest
    p :: ps => if isWildHead p then ps :: defaultRows rest else defaultRows rest

-- 特化：取该构造子的行（子模式接到其余列前）；通配行补 arity 个通配。
specializeCtor : Int -> String -> List (List Pat) -> List (List Pat)
specializeCtor ar cname rows = concatMapRow (specializeRow ar cname) rows

concatMapRow : (List Pat -> List (List Pat)) -> List (List Pat) -> List (List Pat)
concatMapRow f [] = []
concatMapRow f (row :: rest) = append (f row) (concatMapRow f rest)

specializeRow : Int -> String -> List Pat -> List (List Pat)
specializeRow ar cname [] = []
specializeRow ar cname (p :: ps) =
  case patHead p of
    PCon c subs _ => if c == cname then [append subs ps] else []
    PVar _ _ => [append (wilds ar) ps]
    PWild _ => [append (wilds ar) ps]
    _ => []

hasNilRow : List (List Pat) -> Bool
hasNilRow [] = False
hasNilRow (row :: rest) =
  case row of
    [] => True
    _ => hasNilRow rest

lookupEntry : String -> List (String, Int) -> Maybe Int
lookupEntry cname [] = Nothing
lookupEntry cname ((c, n) :: rest) = if c == cname then Just n else lookupEntry cname rest

-- 构造子所属族的构造子表。**必须唯一**：重载构造子无法从名字定位族，按「未知」处理。
--
-- 家族归属的唯一入口是 `ctorFamily`；索引族能定位族（`CtorFamilyIndexed`）但名字集合
-- 不等于可达集合（`Vec 2 a` 没有 `VNil`），所以见证只对参数族开放。
export data CtorFamily(..) : Type where
  CtorFamilyJudgeable : List (String, Int) -> CtorFamily
  CtorFamilyIndexed : List (String, Int) -> CtorFamily
  CtorFamilyUnknown : CtorFamily

export ctorFamily : List (String, Bool, List (String, Int)) -> String -> CtorFamily
ctorFamily table cname =
  case filter (\e => lookupEntry cname (secondOf (secondOf e)) /= Nothing) table of
    [one] =>
      if firstOf (secondOf one) then
        CtorFamilyJudgeable (secondOf (secondOf one))
      else
        CtorFamilyIndexed (secondOf (secondOf one))
    _ => CtorFamilyUnknown

-- 该构造子是否需要「按可达集合」判覆盖：索引族与未知族都不能只按名字得出结论。
export ctorNeedsReachOracle : List (String, Bool, List (String, Int)) -> String -> Bool
ctorNeedsReachOracle table cname =
  case ctorFamily table cname of
    CtorFamilyJudgeable _ => False
    _ => True

familyCtors : List (String, Bool, List (String, Int)) -> String -> Maybe (List (String, Int))
familyCtors table cname =
  case ctorFamily table cname of
    CtorFamilyJudgeable ctors => Just ctors
    _ => Nothing

-- | 按构造子**短名**定位族：列表字面量哨兵（`@vuna@list@nil` / `@vuna@list@cons`）
-- 在模式矩阵里还没有 canonical 名字，只能按短名找。候选短名是**或**关系（不同列表族
-- 可能叫 `::` 或 `Cons`）；**必须唯一命中族**，否则按未知处理。
export familyOfShortCtors : List (String, Bool, List (String, Int)) -> List String -> Maybe (List (String, Int))
familyOfShortCtors table shorts =
  case filter (\e => anyShortCtor shorts (secondOf (secondOf e))) table of
    [one] => if firstOf (secondOf one) then Just (secondOf (secondOf one)) else Nothing
    _ => Nothing

anyShortCtor : List String -> List (String, Int) -> Bool
anyShortCtor [] ctors = False
anyShortCtor (s :: rest) ctors = hasShortCtor s ctors || anyShortCtor rest ctors

hasShortCtor : String -> List (String, Int) -> Bool
hasShortCtor s [] = False
hasShortCtor s ((c, n) :: rest) = ctorShortName c == s || hasShortCtor s rest

-- | 列表字面量哨兵 → 该族里对应的 canonical 构造子名；非哨兵原样返回。
export sentinelCtorIn : List (String, Int) -> String -> Maybe String
sentinelCtorIn ctors h =
  case classify h of
    Just RsListNil => findShortCtor ctors ["Nil"]
    Just RsListCons => findShortCtor ctors ["::", "Cons"]
    _ => Just h

findShortCtor : List (String, Int) -> List String -> Maybe String
findShortCtor [] shorts = Nothing
findShortCtor (p :: rest) shorts =
  if memName (ctorShortName (firstOf p)) shorts then Just (firstOf p) else findShortCtor rest shorts

-- 构造子尝试顺序：本列没出现的在前（见证更具体），已出现的在后。
orderedCtors : List (String, Int) -> List String -> List (String, Int)
orderedCtors ctors heads =
  append
    (filter (\e => not (memName (firstOf e) heads)) ctors)
    (filter (\e => memName (firstOf e) heads) ctors)

takePats : Int -> List Pat -> List Pat
takePats n xs =
  if n <= 0 then
    []
  else
    case xs of
      [] => []
      p :: rest => p :: takePats (n - 1) rest

dropPats : Int -> List Pat -> List Pat
dropPats n xs =
  if n <= 0 then
    xs
  else
    case xs of
      [] => []
      _ :: rest => dropPats (n - 1) rest

-- 见证搜索的结论。三值：`WitnessProved`（已证明覆盖）与 `WitnessUnknown`
-- （燃料耗尽 / 索引族 / 未知族）必须分开——把后者当成「已覆盖」正是静默放行的来源。
-- 只有 `WitnessMissing` 参与诊断改写。
export data Witness(..) : Type where
  WitnessProved : Witness
  WitnessMissing : List Pat -> Witness
  WitnessUnknown : Witness

-- 见证：全通配查询下矩阵是否穷尽；不穷尽时给出前缀（长度 = 原矩阵列数）。
--
-- `pending` 把「列下降」与「同列逐构造子尝试」合成**一个**自递归函数：
--   * `Nothing` = 处理当前列（列下降）；
--   * `Just ctors` = 已按族展开，正在逐个构造子尝试（取第一个出现缺失的分支）。
-- 燃料用 `Nat` 并按其构造子递归（`Zero`/`Succ`），终止性由结构下降直接可证。
export coverageWitness : List (String, Bool, List (String, Int)) -> Nat -> Maybe (List (String, Int)) -> List (List Pat) -> List Pat -> Witness
coverageWitness table fuel pending rows qs =
  case fuel of
    0 => WitnessUnknown
    Succ fuel2 =>
      case pending of
        Just ctors => coverageCtorTries table fuel2 ctors rows qs False
        Nothing =>
          case qs of
            [] => if hasNilRow rows then WitnessProved else WitnessMissing []
            _ :: qsRest =>
              case ctorHeadsOf rows of
                [] =>
                  case coverageWitness table fuel2 Nothing (defaultRows rows) qsRest of
                    WitnessMissing w => WitnessMissing (PWild (detachedNodeRef emptyPatSpan) :: w)
                    other => other
                h :: _ =>
                  case familyCtors table h of
                    -- 索引族 / 未知族（跨包表缺失 / 重载构造子）：给不出见证，
                    -- 但这不是「已覆盖」的证据——调用方只能不改写诊断。
                    Nothing => WitnessUnknown
                    Just ctors =>
                      coverageWitness
                        table
                        fuel2
                        (Just (orderedCtors ctors (ctorHeadsOf rows)))
                        rows
                        qsRest

-- 逐个构造子尝试：任一构造子给出缺失模式即采用；全部判定成功才是 `WitnessProved`；
-- 有「无法判定」而其余都不是缺失时整体 `WitnessUnknown`。
coverageCtorTries : List (String, Bool, List (String, Int)) -> Nat -> List (String, Int) -> List (List Pat) -> List Pat -> Bool -> Witness
coverageCtorTries table fuel [] rows qs unknownSeen =
  if unknownSeen then WitnessUnknown else WitnessProved
coverageCtorTries table fuel (entry :: rest) rows qs unknownSeen =
  let
    ar = secondOf entry
    deeper =
      coverageWitness
        table
        fuel
        Nothing
        (specializeCtor ar (firstOf entry) rows)
        (append (wilds ar) qs)
  in case deeper of
    WitnessMissing w =>
      WitnessMissing
        (PCon (firstOf entry) (takePats ar w) (detachedNodeRef emptyPatSpan) :: dropPats ar w)
    WitnessProved => coverageCtorTries table fuel rest rows qs unknownSeen
    WitnessUnknown => coverageCtorTries table fuel rest rows qs True

-- 矩阵穷尽性：`WitnessMissing w` = 缺 w（w 的长度等于矩阵列数）。
export matrixWitness : List (String, Bool, List (String, Int)) -> List (List Pat) -> Witness
matrixWitness table clauses =
  if uniformArity clauses then
    coverageWitness
      table
      (natFromInt (coverageFuelFor clauses))
      Nothing
      clauses
      (wilds (matrixArity clauses))
  else
    WitnessUnknown

-- ---------------------------------------------------------------
-- 子句可达性（usefulness）：`qs` 是否被 `rows` 完全覆盖。
-- 与 `coverageWitness` 的区别：查询是**具体子句的模式向量**，所以要按查询自己的
-- 构造子 / 字面量下降；「索引族 / 未知族 / 重载构造子 / 燃料耗尽」给 `CoverUnknown`
-- ——既不能当成已覆盖（会把未知族误判成不可达子句），也不当成缺。
-- ---------------------------------------------------------------
export clauseCover : List (String, Bool, List (String, Int)) -> Nat -> List (List Pat) -> List Pat -> CoverVerdict
clauseCover table fuel rows qs =
  case fuel of
    0 => CoverUnknown
    Succ fuel2 =>
      case qs of
        [] => if hasNilRow rows then CoverProved else CoverMissing
        q :: qsRest =>
          case patHead q of
            -- 查询头是构造子：只走该构造子的分支。
            PCon c subs _ =>
              clauseCover
                table
                fuel2
                (specializeCtor (natToInt (length subs)) (c) rows)
                (append subs qsRest)
            -- record 模式：字段匹配的覆盖性判据不在这一层，按未知处理（不报错）。
            PRecord _ _ _ => CoverUnknown
            -- 查询头是字面量：只有该列的通配行能覆盖这个具体值
            -- （同值字面量的重复子句由语法层 `PS_ClauseShadowed` 挡掉）。
            PInt _ _ => clauseCover table fuel2 (defaultRows rows) qsRest
            PStr _ _ => clauseCover table fuel2 (defaultRows rows) qsRest
            -- 变量 / 通配 / as-通配：这一列要整个族的并集覆盖。
            _ =>
              case ctorHeadsOf rows of
                [] => clauseCover table fuel2 (defaultRows rows) qsRest
                h :: _ =>
                  case familyCtors table h of
                    Nothing => CoverUnknown
                    Just ctors =>
                      clauseCoverCtorsGo
                        table
                        fuel2
                        (orderedCtors ctors (ctorHeadsOf rows))
                        rows
                        qsRest
                        CoverProved

-- 逐个构造子尝试：任一支有缺口 ⇒ `CoverMissing`；否则只要有未知 ⇒ `CoverUnknown`；
-- 全部分支都被覆盖才是 `CoverProved`。
clauseCoverCtorsGo : List (String, Bool, List (String, Int)) -> Nat -> List (String, Int) -> List (List Pat) -> List Pat -> CoverVerdict -> CoverVerdict
clauseCoverCtorsGo table fuel [] rows qsRest acc = acc
clauseCoverCtorsGo table fuel (entry :: rest) rows qsRest acc =
  let
    ar = secondOf entry
  in case clauseCover table fuel (specializeCtor ar (firstOf entry) rows) (append (wilds ar) qsRest) of
    CoverMissing => CoverMissing
    CoverUnknown => clauseCoverCtorsGo table fuel rest rows qsRest CoverUnknown
    CoverProved => clauseCoverCtorsGo table fuel rest rows qsRest acc

-- 根列（第一列）带可达构造子集合的入口。
-- `clauseCover` 在索引族 / 未知族上无法只按名字给结论（`Vec 2 a` 没有 `VNil`；
-- 重载构造子定位不到族）。调用方（`Elab.Match`）把 `Elab.Case` 的**同一套可达性判据**
-- 的结果传进来：该类型族的全部构造子 + 其中可达的名字。矩阵只用它在根列筛掉不可构造
-- 的构造子；同一次下降进入子列（字段类型不同）后立刻丢回 `clauseCover` 的保守路径。
--
-- 根列：按该类型下**可达**的构造子集合判覆盖（名字集合在这里不能直接用）。
clauseCoverRootReach : List (String, Int) -> List String -> List (String, Bool, List (String, Int)) -> Nat -> List (List Pat) -> List Pat -> CoverVerdict
clauseCoverRootReach ctors reachable table fuel rows qsRest =
  case ctorHeadsOf rows of
    [] => clauseCover table fuel (defaultRows rows) qsRest
    heads =>
      case filterReachable reachable ctors of
        [] => CoverUnknown
        liveCtors =>
          clauseCoverCtorsGo table fuel (orderedCtors liveCtors heads) rows qsRest CoverProved

filterReachable : List String -> List (String, Int) -> List (String, Int)
filterReachable reachable [] = []
filterReachable reachable (e :: rest) =
  if memName (firstOf e) reachable then
    e :: filterReachable reachable rest
  else
    filterReachable reachable rest

export clauseCoverWith : Maybe (List (String, Int), List String) -> List (String, Bool, List (String, Int)) -> Nat -> List (List Pat) -> List Pat -> CoverVerdict
clauseCoverWith Nothing table fuel rows qs = clauseCover table fuel rows qs
clauseCoverWith (Just (ctors, reachable)) table fuel rows qs =
  case fuel of
    0 => CoverUnknown
    Succ fuel2 =>
      case qs of
        [] => clauseCover table fuel rows qs
        q :: qsRest =>
          case patHead q of
            PVar _ _ => clauseCoverRootReach ctors reachable table fuel2 rows qsRest
            PWild _ => clauseCoverRootReach ctors reachable table fuel2 rows qsRest
            _ => clauseCover table fuel rows qs

-- 模式节点数（每个 `Pat` 节点计 1；构造子子模式 / record 字段递归）。
patNodes : Pat -> Int
patNodes (PCon _ ps _) = 1 + patNodesList ps
patNodes (PAs _ inner _) = 1 + patNodes inner
patNodes (PRecord _ fs _) = 1 + patNodesFields fs
patNodes _ = 1

patNodesList : List Pat -> Int
patNodesList [] = 0
patNodesList (p :: rest) = patNodes p + patNodesList rest

patNodesFields : List (String, Pat) -> Int
patNodesFields [] = 0
patNodesFields ((_, p) :: rest) = patNodes p + patNodesFields rest

matrixNodes : List (List Pat) -> Int
matrixNodes [] = 0
matrixNodes (row :: rest) = patNodesList row + matrixNodes rest

-- 见证搜索每下降一步至少消耗 1；每个待试构造子还会重复下降剩余列 → 每节点给 4 步余量。
export coverageFuelFor : List (List Pat) -> Int
coverageFuelFor clauses =
  let
    scaled = 256 + 4 * matrixNodes clauses
  in if scaled > coverageFuelMax then coverageFuelMax else scaled

coverageFuelMax : Int
coverageFuelMax = 1000000

-- 各行的列数必须一致（`where`/`let` 里允许不同 arity 的方程，矩阵算法不适用）。
export uniformArity : List (List Pat) -> Bool
uniformArity [] = False
uniformArity (r :: rest) = allSameLen (natToInt (length r)) rest

allSameLen : Int -> List (List Pat) -> Bool
allSameLen n [] = True
allSameLen n (r :: rest) = natToInt (length r) == n && allSameLen n rest

matrixArity : List (List Pat) -> Int
matrixArity [] = 0
matrixArity (row :: _) = natToInt (length row)

-- 把「合成 case 不可穷尽」的诊断换成带**源模式见证**的版本。
--
-- 只在错误码已经是 `TC_NotExhaustive` 时改写：类型错 / 分支参数个数错等更具体的诊断
-- 优先（那些错误在精化前无法预知，预检会把它们盖掉）。只有 `WitnessMissing` 才改写；
-- `WitnessProved` / `WitnessUnknown` 都保持原诊断（后者是「给不出见证」，不是「已覆盖」）。
-- `clausesOf` 是**惰性**的源矩阵：矩阵只在诊断需要改写时才构建（正常精化不付这份
-- 遍历；`matrixOf` 在 Match 里，Coverage 不能反向 import，因此用 thunk 而不是直接吃
-- 已建好的 `List (List Pat)`）。
export improveExhaustive : List (String, Bool, List (String, Int)) -> (Int -> List (List Pat)) -> Span -> Check a -> Check a
improveExhaustive table clausesOf sp (OkC v) = OkC v
improveExhaustive table clausesOf sp (ErrC d) = ErrC (improveDiag table (clausesOf 0) sp d)

improveDiag : List (String, Bool, List (String, Int)) -> List (List Pat) -> Span -> Diagnostic -> Diagnostic
improveDiag table clauses sp d =
  if d.diagCode /= "TC_NotExhaustive" then
    d
  else
    case matrixWitness table clauses of
      WitnessMissing w =>
        if witnessNamesCtor w then
          let
            rx = renderWitness w
          in withFallbackSpan sp (tcMsg (NotExhaustive rx) [rx])
        else
          d
      _ => d

-- 只有见证**首位**就是构造子时才值得抢先报错：那是最清晰的「漏了某个构造子」。
-- 首位是通配（字面量列 / 索引族 / 未知族）时不推断，留给降级后的既有诊断。
export witnessNamesCtor : List Pat -> Bool
witnessNamesCtor [] = False
witnessNamesCtor (p :: _) =
  case patHead p of
    PCon _ _ _ => True
    _ => False

-- 模式渲染：见证里的变量/通配统一显示为 `_`，构造子应用带括号。
-- `fuel` 只用于让终止性可证（模式深度远小于 64）。
export renderPat : Pat -> String
renderPat p = renderPatIn 64 False p

renderPatIn : Int -> Bool -> Pat -> String
renderPatIn fuel paren p =
  if fuel <= 0 then
    "_"
  else
    case patHead p of
      PCon c subs _ =>
        if natToInt (length subs) == 0 then
          c
        else
          let
            body = "${c} ${join " " (map (renderPatIn (fuel - 1) True) subs)}"
          in if paren then "(${body})" else body
      PVar _ _ => "_"
      PWild _ => "_"
      PInt n _ => strFromInt n
      PStr s _ => "\"${s}\""
      PRecord rn fields _ => "{ ${rn} }"
      PAs _ inner _ => renderPatIn (fuel - 1) paren inner

export renderWitness : List Pat -> String
renderWitness ws = join " " (map (renderPatIn 64 True) ws)
