module Vuna.Compiler.Elab.Match where

-- Vuna.Compiler.Elab.Match：把「多 clause + 构造子/字面量模式」的函数体降级成核心表达式。
--
-- 输入是 parser 的 clause 模式矩阵（`List (Pair (List Pat) Expr)`），输出一个不含顶层
-- 模式匹配的 `Expr`：参数折成 lambda，逐列下降，构造子列编成 `case`，Int/String 列编成
-- `if` 链。这样 `elabFunDef` 只需 `checkDef` 一个普通表达式，复用既有 case 精化。
--
-- 源级 `case` 的**唯一**降级入口（`multiToCaseExpr`，带 let 绑定 scrutinee）：
-- 嵌套模式与同构造子多分支都在这里消解成规范形（每构造子一个分支 + 变量子模式），
-- 精化器没有「去重降级 / 嵌套模式折叠」两条旁路。
--
-- 位置无关的纯语法变换（只依赖 Ast 模式与表达式），因此独立成模块。
-- 关键不变量：每个 `ctorAltList` 递归层生成的新鲜子模式名必须带**本列位置名**
-- （见 `subNamesFor`），否则层间同名会让外层 rename 抓到内层 binder。嵌套的矩阵降级
-- （内层 source case 各自降级）之间靠调用方传入的位置名区分（`checkCaseMatrixFuel` 用
-- 上下文深度做前缀）。
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Elab.Coverage
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name

-- 单 clause 的参数全是变量（或通配）时可直接 `checkDef` 绑定；否则需要 `multiToExpr`
-- 合成 case（如 `firstOf (Pair a b) = a`——参数是构造子模式）。
export allVarPats : List Pat -> Bool
allVarPats [] = True
allVarPats (p :: rest) =
  case p of
    PVar _ _ => allVarPats rest
    PWild _ => allVarPats rest
    -- as-pattern 引入绑定，必须走模式矩阵（multiToExpr）而不是 checkDef 快速路径。
    PAs _ _ _ => False
    _ => False

-- 只拒绝「比首子句 arity 更多」的 clause；少模式的 catch-all（如 `floatPrim1 _`）
-- 是 curry 后的合法降级，保持既有语义。
clauseArityTooMany : Int -> List (List Pat, Expr) -> Bool
clauseArityTooMany n [] = False
clauseArityTooMany n ((pats, _) :: rest) = natToInt (length pats) > n || clauseArityTooMany n rest

export multiToExpr : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> Check Expr
multiToExpr table clauses =
  case arityOf clauses of
    Nothing => ErrC (tcMsg FunctionNoClauses [])
    Just n =>
      if clauseArityTooMany n clauses then
        tcErr0 (firstPatSpan clauses) ClauseTooManyPatterns
      else
        Vuna.Compiler.Base.Common.bind (checkReachable table clauses) (
            \_ =>
              let
                names = paramNames n
              in Vuna.Compiler.Base.Common.bind (buildColumnExpr table clauses names (firstPatSpan clauses) (coverageFuelFor (matrixOf clauses))) (\body => OkC (wrapLambdas names body))
          )

-- | 每个子句必须匹配到前面子句没覆盖的值。
--   语法层已经挡掉「被单条前置子句蕴含」（`PS_ClauseShadowed`），这里补**并集**覆盖
--   （`True` / `False` 之后再来 `_`）。未知族 / 重载构造子 / 燃料耗尽不报
--   （`CovUnknown`）：不能证明不可达就不报。
--   列数不一致的组（`where` / `let` 允许少模式的 catch-all）不判。
export checkReachable : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> Check Bool
checkReachable table clauses =
  let
    rows = matrixOf clauses
  in if uniformArity rows then
    reachableGo table (natFromInt (coverageFuelFor rows)) [] clauses
  else
    OkC True

reachableGo : List (String, Bool, List (String, Int)) -> Nat -> List (List Pat) -> List (List Pat, Expr) -> Check Bool
reachableGo table fuel rows [] = OkC True
reachableGo table fuel rows ((pats, body) :: rest) =
  let
    qs = map stripAsPat pats
  in case clauseCover table fuel rows qs of
    CovCovered => tcErr0 (clauseHeadSpan pats body) ClauseUnreachable
    _ => reachableGo table fuel ((::) qs rows) rest

clauseHeadSpan : List Pat -> Expr -> Span
clauseHeadSpan (p :: _) body = patSpan p
clauseHeadSpan [] body = exprSpan body

-- 与 multiToExpr 同一套模式矩阵，但不包 lambda：`name` 是已在作用域里的位置名，
-- 直接返回以它为 scrutinee 的嵌套 case 体。供 Elab 的 case 去重降级使用
-- （先把 scrutinee 用 let 绑定成 name，保证只求值一次）。
export multiToCaseExpr : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> String -> Check Expr
multiToCaseExpr table clauses name =
  case arityOf clauses of
    Nothing => tcErr0 (firstPatSpan clauses) ClauseTooManyPatterns
    Just n =>
      if clauseArityTooMany n clauses then
        tcErr0 (firstPatSpan clauses) ClauseTooManyPatterns
      else
        buildColumnExpr
          table
          clauses
          [name]
          (firstPatSpan clauses)
          (coverageFuelFor (matrixOf clauses))

-- 源矩阵（剥掉 as-pattern）：覆盖性见证用。
export matrixOf : List (List Pat, Expr) -> List (List Pat)
matrixOf clauses = map (map stripAsPat) (map firstOf clauses)

stripAsPat : Pat -> Pat
stripAsPat (PAs _ inner _) = stripAsPat inner
stripAsPat p = p

arityOf : List (List Pat, Expr) -> Maybe Int
arityOf [] = Nothing
arityOf ((pats, body) :: rest) = Just (natToInt (length pats))

paramNames : Int -> List String
paramNames n = paramNamesGo (n - 0) n []

paramNamesGo : Int -> Int -> List String -> List String
paramNamesGo remaining n acc =
  if remaining <= 0 then
    reverse acc
  else
    paramNamesGo (remaining - 1) n ("mc${n - remaining}" :: acc)

wrapLambdas : List String -> Expr -> Expr
wrapLambdas [] body = body
wrapLambdas (n :: rest) body = ELam [(n, spanEmpty)] (wrapLambdas rest body) spanEmpty

-- 按列递归。params 是**尚未消耗**的位置名（与剩余模式列一一对应）。该列含内建字面量模式
-- （Int / String）：生成嵌套 if 链——`f 0 = a; f 1 = b; f n = c` → `if pos == 0 then a else
-- if pos == 1 then b else c`；变量/通配 clause 在字面量之后提供 fallback（体按剩余列递归构建）。
litAltExpr : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> String -> List String -> Span -> Int -> Check Expr
litAltExpr table clauses pos restParams fb fuel =
  if fuel <= 0 then icFuel "pattern matrix" else litAltExprGo table clauses pos restParams fb fuel

litAltExprGo : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> String -> List String -> Span -> Int -> Check Expr
litAltExprGo table clauses pos restParams fb fuel =
  if fuel <= 0 then
    icFuel "pattern matrix"
  else
    case clauses of
      [] => tcErr0 fb IntStringCaseNeedsFallback
      (p :: ps, body) :: rest =>
        case p of
          PVar pname psp => buildColumnExpr table (prepVarColumn pos clauses) restParams fb (fuel - 1)
          PWild psp => buildColumnExpr table (stripFirstCol clauses) restParams fb (fuel - 1)
          _ => Vuna.Compiler.Base.Common.bind (litAltExprGo table rest pos restParams fb (fuel - 1)) (\restExpr => Vuna.Compiler.Base.Common.bind (buildColumnExpr table (litBranchClauses p pos clauses) restParams fb (fuel - 1)) (\bodyExpr => OkC (EIf (EApp (EVar (classifyName "==") (Span "" 0 0 0 0 0 0)) [EVar (classifyName pos) (Span "" 0 0 0 0 0 0), litPatExpr p] (patSpan p)) bodyExpr restExpr (patSpan p))))
      -- 该字面量分支的子矩阵不只是「当前行 + 剩余列」——同一字面量的后续行与
      -- 变量/通配行也匹配这个字面量，必须一起进入子矩阵，否则内层列会缺分支
      -- （`TCon "a" [] => ...; TCon "b" _ => ...; TCon _ _ => ...` 报 missing Cons，
      -- 且 `f "a" [] = 1; f "a" _ = 2; f _ _ = 3` 会丢掉第二条同字面量分支）。
      ([], body) :: rest => tcErr0 fb ClauseTooManyPatterns

-- 字面量分支的子矩阵：同字面量的行 + 变量/通配行（它们也匹配该字面量），保持原顺序；
-- 其它字面量的行不匹配这个值。变量/通配行要把该列的头变量改名成 scrutinee 位置名
-- (pos)，否则体里对该变量的引用在「字面量分支的兜底」里没有 binder（TCon n args 的 n）。
litBranchClauses : Pat -> String -> List (List Pat, Expr) -> List (List Pat, Expr)
litBranchClauses lit pos clauses = filterLitBranch lit pos clauses []

filterLitBranch : Pat -> String -> List (List Pat, Expr) -> List (List Pat, Expr) -> List (List Pat, Expr)
filterLitBranch lit pos [] acc = reverse acc
filterLitBranch lit pos ((p :: ps, body) :: rest) acc =
  if litPatMatches lit p then
    filterLitBranch lit pos rest ((ps, literalBranchBody pos p body) :: acc)
  else
    filterLitBranch lit pos rest acc
filterLitBranch lit pos (([], body) :: rest) acc = filterLitBranch lit pos rest acc

-- 同字面量行直接用体；变量/通配行把该列的头变量改写成位置名。
literalBranchBody : String -> Pat -> Expr -> Expr
literalBranchBody pos (PVar nm psp) body = renameExpr nm pos body
literalBranchBody pos _ body = body

litPatMatches : Pat -> Pat -> Bool
litPatMatches (PInt n sp) p =
  case p of
    PInt m sp2 => n == m
    PVar nm psp => True
    PWild psp => True
    _ => False
litPatMatches (PStr s sp) p =
  case p of
    PStr t sp2 => s == t
    PVar nm psp => True
    PWild psp => True
    _ => False
litPatMatches _ p = False

-- 把字面量模式还原成表达式（Int / String）。
litPatExpr : Pat -> Expr
litPatExpr (PInt n sp) = EInt n sp
litPatExpr (PStr s sp) = EStr s sp
litPatExpr _ = EInt 0 (Span "" 0 0 0 0 0 0)

-- | 模式矩阵的列下降：按当前列（`pos`）的模式形态分派成 case / if 表达式。
buildColumnExpr : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> List String -> Span -> Int -> Check Expr
buildColumnExpr table clauses0 params fb fuel =
  if fuel <= 0 then
    ErrC (tcMsg PatternFuel [])
  else
    buildColumnExprPruned table (pruneRows clauses0) params fb fuel

buildColumnExprPruned : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> List String -> Span -> Int -> Check Expr
buildColumnExprPruned table clauses params fb fuel =
  if fuel <= 0 then
    ErrC (tcMsg PatternFuel [])
  else if allEmptyPats clauses then
    OkC (bodyOfFirst clauses)
  else if allWildPats (firstPats clauses) then
    OkC (bodyOfFirst clauses)
  else
    case params of
      -- 行优先级剪枝：某行的**剩余模式全不可辩**时，它覆盖之后的所有行（后面的行不可能被选中）。
      -- 不剪会把深层决策树按「每列一个分支」展开成指数体积（`f A _ _ = 0; f _ A _ = 1; f _ _ _ = b`
      -- 这类「多列规则 + 兜底」在 k 列时生成 3^k 个叶子，绝大多数叶子是同一个兜底体）。
      -- 首行全通配时直接返回它的体：没有任何列还需要判定。
      [] => tcErr0 fb ClauseTooManyPatterns
      pos :: restParams => if hasAsHead clauses then asColumn table clauses pos restParams fb fuel else if allVarHeads clauses then buildColumnExpr table (prepVarColumn pos clauses) restParams fb (fuel - 1) else if allCtorHeads clauses then ctorColumn table clauses pos restParams fb fuel else if hasCtorHead clauses then ctorColumn table clauses pos restParams fb fuel else litAltExpr table clauses pos restParams fb (fuel - 1)

-- as-pattern 列：先把该列 head 统一成变量（body 里的绑定名改写成该列变量 pos），
-- 再把内层模式作为「新列」对同一 pos 分派（等价于 `case pos of <inner> => body`）。
hasAsHead : List (List Pat, Expr) -> Bool
hasAsHead [] = False
hasAsHead (c :: rest) =
  case c of
    ((PAs _ _ _) :: ps, body) => True
    _ => hasAsHead rest

asColumn : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> String -> List String -> Span -> Int -> Check Expr
asColumn table clauses pos restParams fb fuel =
  if fuel <= 0 then
    ErrC (tcMsg PatternFuel [])
  else
    Vuna.Compiler.Base.Common.bind
      (buildColumnExpr table (map (asInnerClause pos) clauses) (pos :: restParams) fb (fuel - 1))
      (\e => OkC e)

asInnerClause : String -> (List Pat, Expr) -> (List Pat, Expr)
asInnerClause pos (p :: ps, body) = (append [innerOfHead p] ps, renameAsHead pos p body)
asInnerClause pos (c@([], body)) = c

innerOfHead : Pat -> Pat
innerOfHead (PAs n inner sp) = inner
innerOfHead p = p

renameAsHead : String -> Pat -> Expr -> Expr
renameAsHead pos (PAs n inner sp) body = renameExpr n pos body
renameAsHead pos (PVar n sp) body = renameExpr n pos body
renameAsHead pos p body = body

-- 合成 case 的位置：用首个 clause 的模式 span，让覆盖性错误能指回源码
-- （用空 span 会把穷尽性诊断报在 :0:0）。
export firstPatSpan : List (List Pat, Expr) -> Span
firstPatSpan ((p :: ps, body) :: rest) = patSpan p
firstPatSpan _ = Span "" 0 0 0 0 0 0

-- 构造子列：每个构造子一个分支。**该族构造子已经全覆盖时不再生成兜底分支**——
-- 变量/通配 head 的 clause 已经被 `clausesForCtor` 分发进每个构造子分支，
-- 再补一个 `_` 兜底只会把「剩余列在兜底里匹配不全」暴露成假的覆盖错误
-- （`mergeBy le [] ys` / `mergeBy le xs []` / `mergeBy le (x::xs) (y::ys)`
-- 会报 `missing Cons`）。族信息由 Elab 传入（`ctorTable`）。
ctorColumn : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> String -> List String -> Span -> Int -> Check Expr
ctorColumn table clauses pos restParams fbSp fuel =
  if fuel <= 0 then
    icFuel "pattern matrix"
  else
    Vuna.Compiler.Base.Common.bind (ctorAltList table clauses pos restParams fbSp (fuel - 1)) (
        \alts =>
          let
            caseSp = firstPatSpan clauses
          in if familyCovered table (ctorHeads clauses) then OkC (ECase (EVar (classifyName pos) caseSp) alts caseSp) else Vuna.Compiler.Base.Common.bind (fallbackAltList table pos clauses restParams fbSp (fuel - 1)) (\fbAlts => OkC (ECase (EVar (classifyName pos) caseSp) (append alts fbAlts) caseSp))
      )

-- 构造子名 → 所属族的构造子表；列表字面量哨兵按短名找族，其余找不到族时按未知处理。
familyOfCtor : List (String, Bool, List (String, Int)) -> String -> Maybe (Bool, List (String, Int))
familyOfCtor [] ctor = Nothing
familyOfCtor (p :: rest) ctor =
  if memName ctor (map firstOf (secondOf (secondOf p))) then
    Just (secondOf p)
  else
    familyOfCtor rest ctor

familyOfHead : List (String, Bool, List (String, Int)) -> String -> Maybe (List (String, Int))
familyOfHead table h =
  case familyOfCtor table h of
    Just fam => Just (secondOf fam)
    Nothing =>
      if isListNilSyntax h then
        familyOfShortCtors table ["Nil"]
      else if isListConsSyntax h then familyOfShortCtors table ["::", "Cons"] else Nothing

-- 该列 head 里的列表哨兵折回族里的 canonical 构造子名；非哨兵原样保留。
canonHeads : List (String, Int) -> List String -> Maybe (List String)
canonHeads ctors [] = Just []
canonHeads ctors (h :: rest) =
  case sentinelCtorIn ctors h of
    Nothing => Nothing
    Just c =>
      case canonHeads ctors rest of
        Nothing => Nothing
        Just tail => Just (c :: tail)

-- 该族是否已被本列构造子 head 全覆盖。族未知（表与模式不一致）时不推断：
-- 补 `_` 兜底会用不完整的残矩阵独立判覆盖，反而在不可达兜底里报假 missing；
-- 交给外层穷尽检查（它按真实构造子判）更准确。
familyCovered : List (String, Bool, List (String, Int)) -> List String -> Bool
familyCovered table [] = False
familyCovered table (heads@(h :: rest)) =
  case familyOfHead table h of
    Nothing => False
    Just fam =>
      let
        names = map firstOf fam
      in case canonHeads fam heads of
        Nothing => False
        Just canon => allMem names canon

-- 该列至少有一个构造子模式（与变量/通配混合时也要走构造子分支 + 兜底，
-- 不能落到 `litAltExpr`——它不会展开构造子子模式，丢失子模式绑定）。
hasCtorHead : List (List Pat, Expr) -> Bool
hasCtorHead [] = False
hasCtorHead (c :: rest) =
  case c of
    (p :: ps, body) =>
      case p of
        PCon _ _ _ => True
        _ => hasCtorHead rest
    ([], body) => hasCtorHead rest

-- 该列全是构造子模式（不含字面量）。
allCtorHeads : List (List Pat, Expr) -> Bool
allCtorHeads [] = True
allCtorHeads (c :: rest) =
  case c of
    (p :: ps, body) =>
      case p of
        PCon cname subpats psp => allCtorHeads rest
        _ => False
    ([], body) => False

-- 剩余模式是否全为通配（体不引用任何绑定名，可直接返回）。
allWildPats : List Pat -> Bool
allWildPats [] = True
allWildPats (p :: rest) = isWildPat p && allWildPats rest

isWildPat : Pat -> Bool
isWildPat (PWild _) = True
isWildPat _ = False

firstPats : List (List Pat, Expr) -> List Pat
firstPats ((pats, body) :: rest) = pats
firstPats [] = []

-- 不可辩模式（变量/通配/as-通配）：该行从这一列起覆盖一切。
irrefutablePat : Pat -> Bool
irrefutablePat (PVar _ _) = True
irrefutablePat (PWild _) = True
irrefutablePat (PAs _ inner _) = irrefutablePat inner
irrefutablePat _ = False

allIrrefutablePats : List Pat -> Bool
allIrrefutablePats [] = True
allIrrefutablePats (p :: rest) = irrefutablePat p && allIrrefutablePats rest

-- 保留到第一个「剩余模式全不可辩」的行（含），丢弃其后不可达的行。
pruneRows : List (List Pat, Expr) -> List (List Pat, Expr)
pruneRows [] = []
pruneRows (c :: rest) = if allIrrefutablePats (firstOf c) then [c] else c :: pruneRows rest

allEmptyPats : List (List Pat, Expr) -> Bool
allEmptyPats [] = True
allEmptyPats (c :: rest) =
  case c of
    ([], body) => allEmptyPats rest
    _ => False

bodyOfFirst : List (List Pat, Expr) -> Expr
bodyOfFirst ((pats, body) :: rest) = body
bodyOfFirst [] = EInt 0 (Span "" 0 0 0 0 0 0)

isVarPatD : Pat -> Bool
isVarPatD (PVar n sp) = True
isVarPatD (PWild sp) = True
isVarPatD _ = False

allVarHeads : List (List Pat, Expr) -> Bool
allVarHeads [] = True
allVarHeads (c :: rest) =
  case c of
    (p :: ps, body) => isVarPatD p && allVarHeads rest
    ([], body) => False

stripFirstCol : List (List Pat, Expr) -> List (List Pat, Expr)
stripFirstCol [] = []
stripFirstCol (c :: rest) =
  case c of
    ([], body) => c :: stripFirstCol rest
    (p :: ps, body) => (ps, body) :: stripFirstCol rest

-- | 整列都是变量：剥掉该列，并把**每个 clause 自己**的 head 变量改名成位置名。
--   只改本 clause 的体：把改名推迟到整个内层表达式建好之后会误捕获其它 clause 里
--   同名的更深子模式（`n :: e :: r :: _` 与 `e :: r :: _` 两条分支会串位）。
prepVarColumn : String -> List (List Pat, Expr) -> List (List Pat, Expr)
prepVarColumn pos [] = []
prepVarColumn pos (c :: rest) =
  case c of
    (p :: ps, body) =>
      case p of
        PVar nm psp => (ps, renameExpr nm pos body) :: prepVarColumn pos rest
        PWild psp => (ps, body) :: prepVarColumn pos rest
        _ => (ps, body) :: prepVarColumn pos rest
    ([], body) => c :: prepVarColumn pos rest

renameExpr : String -> String -> Expr -> Expr
renameExpr oldName newName e =
  case e of
    EVar nm sp => if rnameKey nm == oldName then EVar (classifyName newName) sp else e
    EInt n sp => EInt n sp
    EStr s sp => EStr s sp
    EFloat raw sp => EFloat raw sp
    ELam names body sp => ELam names (renameExprUnless oldName newName (map firstOf names) body) sp
    EApp fn args sp =>
      EApp (renameExpr oldName newName fn) (map (renameExpr oldName newName) args) sp
    EPi nm implicit qty dom cod sp =>
      EPi
        nm
        implicit
        qty
        (renameExpr oldName newName dom)
        (renameExprUnless oldName newName [nm] cod)
        sp
    ELet binds body rec_ sp =>
      ELet
        (map (renameBind oldName newName) binds)
        (renameExprUnless oldName newName (bindNames binds) body)
        rec_
        sp
    ECase scrut alts sp =>
      ECase (renameExpr oldName newName scrut) (map (renameAlt oldName newName) alts) sp
    -- 局部函数组的每个 clause 独立改名（参数模式绑定名遮蔽该 clause 的 body）。
    ELocalFun clauses sp => ELocalFun (map (renameLocalClause oldName newName) clauses) sp
    EIf c t e2 sp =>
      EIf
        (renameExpr oldName newName c)
        (renameExpr oldName newName t)
        (renameExpr oldName newName e2)
        sp
    EField b f sp => EField (renameExpr oldName newName b) f sp
    ERecord rn fields sp => ERecord rn (map (renameFieldValue oldName newName) fields) sp
    ERecUpdate b fields sp =>
      ERecUpdate (renameExpr oldName newName b) (map (renameFieldValue oldName newName) fields) sp
    EDo stmts sp => EDo stmts sp
    -- parser 中间产物；Elab 阶段正常不存在（Loader 重排已消除），这里保持结构递归。
    EAnn value ty sp => EAnn (renameExpr oldName newName value) (renameExpr oldName newName ty) sp
    -- 模板字面量在 Elab 之前已被 Loader 降级（正常不存在）；保持结构递归，
    -- 不静默丢洞内子表达式。
    EInterp parts sp => EInterp (renameInterpParts oldName newName parts) sp

renameInterpParts : String -> String -> List InterpPart -> List InterpPart
renameInterpParts oldName newName [] = []
renameInterpParts oldName newName ((IPText s) :: rest) =
  IPText s :: renameInterpParts oldName newName rest
renameInterpParts oldName newName ((IPHole e) :: rest) =
  IPHole (renameExpr oldName newName e) :: renameInterpParts oldName newName rest

renameExprUnless : String -> String -> List String -> Expr -> Expr
renameExprUnless oldName newName names body =
  if memName oldName names then body else renameExpr oldName newName body

renameBind : String -> String -> (Pat, Expr) -> (Pat, Expr)
renameBind oldName newName bnd = (firstOf bnd, renameExpr oldName newName (secondOf bnd))

renameFieldValue : String -> String -> (String, Expr) -> (String, Expr)
renameFieldValue oldName newName field =
  (firstOf field, renameExpr oldName newName (secondOf field))

-- 局部函数 clause —— 参数模式里的绑定名遮蔽 oldName。
renameLocalClause : String -> String -> (List Pat, Expr) -> (List Pat, Expr)
renameLocalClause oldName newName clause =
  (firstOf clause,
    renameExprUnless oldName newName (concatMap patNamesOf (firstOf clause)) (secondOf clause))

bindNames : List (Pat, Expr) -> List String
bindNames [] = []
bindNames (b :: rest) = append (patNamesOf (firstOf b)) (bindNames rest)

patNamesOf : Pat -> List String
patNamesOf (PVar n sp) = [n]
patNamesOf (PAs n inner sp) = n :: patNamesOf inner
patNamesOf (PWild sp) = []
patNamesOf (PCon cn ps sp) = concatMap patNamesOf ps
patNamesOf (PInt n sp) = []
patNamesOf (PStr s sp) = []
patNamesOf (PRecord rn fields sp) = concatMap (\f => patNamesOf (secondOf f)) fields

renameAlt : String -> String -> (Pat, Expr) -> (Pat, Expr)
renameAlt oldName newName alt =
  let
    p = firstOf alt
  in (p, renameExprUnless oldName newName (patNamesOf p) (secondOf alt))

-- 该列出现构造子：每个构造子一组。
--
-- **分支 pattern 的子模式一律用新鲜变量**（`_sc<i>`）：规范形的精化器只接受变量/通配
-- 子模式（`bindCtorTele`），位置名与 body 里的引用完全可控；子模式的真实形态交给内层
-- `buildColumnExpr` 用 case 表达。
ctorAltList : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> String -> List String -> Span -> Int -> Check (List (Pat, Expr))
ctorAltList table clauses pos restParams fbSp fuel =
  if fuel <= 0 then
    icFuel "pattern matrix"
  else
    ctorAltListGo table clauses (ctorHeads clauses) pos restParams fbSp fuel

ctorAltListGo : List (String, Bool, List (String, Int)) -> List (List Pat, Expr) -> List String -> String -> List String -> Span -> Int -> Check (List (Pat, Expr))
ctorAltListGo table clauses [] pos restParams fbSp fuel =
  if fuel <= 0 then icFuel "pattern matrix" else OkC []
ctorAltListGo table clauses (cname :: rest) pos restParams fbSp fuel =
  if fuel <= 0 then
    icFuel "pattern matrix"
  else
    let
      subpatCount = ctorSubPatCount clauses cname
      freshSubs = subNamesFor pos subpatCount
      subParams = append freshSubs restParams
      branchPats = map (\n => PVar n (Span "" 0 0 0 0 0 0)) freshSubs
      expanded = clausesForCtor cname branchPats pos clauses
    in Vuna.Compiler.Base.Common.bind (buildColumnExpr table expanded subParams fbSp (fuel - 1)) (\bodyExpr => Vuna.Compiler.Base.Common.bind (ctorAltListGo table clauses rest pos restParams fbSp (fuel - 1)) (\tail => OkC ((::) (PCon (classifyName cname) branchPats (Span "" 0 0 0 0 0 0), bodyExpr) tail)))

-- 该构造子在本列各 clause 里的子模式个数（取第一个匹配 clause 的长度）。
ctorSubPatCount : List (List Pat, Expr) -> String -> Int
ctorSubPatCount [] cname = 0
ctorSubPatCount (c :: rest) cname =
  case c of
    (p :: ps, body) =>
      case p of
        PCon cn subpats psp =>
          if rnameKey cn == cname then length subpats else ctorSubPatCount rest cname
        _ => ctorSubPatCount rest cname
    ([], body) => ctorSubPatCount rest cname

-- 新鲜子模式名必须带**所在列的**位置名：不同层 `ctorAltList` 递归会各自生成 `_sc0/_sc1`，
-- 若同名则内层 case 的 binder 遮蔽外层，且外层变量改名会把外层变量改写成
-- 内层 binder（如 `zip` 的 `y` 被改写成外层第一列的 `_sc1`），造成 a/b 串位。
subNamesFor : String -> Int -> List String
subNamesFor pos n = subNamesForGo pos 0 n []

subNamesForGo : String -> Int -> Int -> List String -> List String
subNamesForGo pos i n acc = subNamesForGoGo pos (n - i) n acc

subNamesForGoGo : String -> Int -> Int -> List String -> List String
subNamesForGoGo pos remaining n acc =
  if remaining <= 0 then
    reverse acc
  else
    subNamesForGoGo pos (remaining - 1) n ("_sc_${pos}_${n - remaining}" :: acc)

ctorHeads : List (List Pat, Expr) -> List String
ctorHeads [] = []
ctorHeads (c :: rest) =
  case c of
    (p :: ps, body) =>
      case p of
        PCon cname subpats psp => addNameDistinct (rnameKey cname) (ctorHeads rest)
        _ => ctorHeads rest
    ([], body) => ctorHeads rest

addNameDistinct : String -> List String -> List String
addNameDistinct name [] = [name]
addNameDistinct name (x :: rest) =
  if x == name then (::) x rest else (::) x (addNameDistinct name rest)

-- 该构造子分支的「匹配子句」：PCon 子句保留其子模式；变量/通配子句分发进该分支，
-- 用分支的新鲜子名（`freshSubs`）占位、并把体里的变量引用改写成该列 scrutinee（`pos`），
-- 否则变量子句被 `filterFallback` 收进外层兜底，嵌套 case 会缺该构造子的分支（覆盖错误）。
clausesForCtor : String -> List Pat -> String -> List (List Pat, Expr) -> List (List Pat, Expr)
clausesForCtor cname freshSubs pos [] = []
clausesForCtor cname freshSubs pos (c :: rest) =
  case c of
    (p :: ps, body) =>
      case p of
        PCon cn subpats psp =>
          if rnameKey cn == cname then
            (::) (append subpats ps, body) (clausesForCtor cname freshSubs pos rest)
          else
            clausesForCtor cname freshSubs pos rest
        PVar nm psp =>
          (append freshSubs ps, renameExpr nm pos body) :: clausesForCtor cname freshSubs pos rest
        PWild psp => (append freshSubs ps, body) :: clausesForCtor cname freshSubs pos rest
        _ => clausesForCtor cname freshSubs pos rest
    ([], body) => clausesForCtor cname freshSubs pos rest

filterFallback : List (List Pat, Expr) -> List (List Pat, Expr)
filterFallback [] = []
filterFallback (c :: rest) =
  case c of
    (p :: ps, body) => if isVarPatD p then (::) c (filterFallback rest) else filterFallback rest
    ([], body) => filterFallback rest

-- 兜底分支：变量/通配 head 的 clause 在**这一列**被通配吃掉，体里对该变量的引用
-- 要改写成外层 scrutinee 位置名（`pos`）。直接拿原始体时变量名在通配分支里没有
-- binder，会报 unknown name（`join sep (x :: rest)` 的 `rest`）。
fallbackAltList : List (String, Bool, List (String, Int)) -> String -> List (List Pat, Expr) -> List String -> Span -> Int -> Check (List (Pat, Expr))
fallbackAltList table pos clauses restParams fbSp fuel =
  if fuel <= 0 then
    icFuel "pattern matrix"
  else
    case prepFallbacks pos (filterFallback clauses) of
      [] => OkC []
      fbs => Vuna.Compiler.Base.Common.bind (buildColumnExpr table fbs restParams fbSp (fuel - 1)) (\bodyExpr => OkC [(PWild (Span "" 0 0 0 0 0 0), bodyExpr)])

prepFallbacks : String -> List (List Pat, Expr) -> List (List Pat, Expr)
prepFallbacks pos [] = []
prepFallbacks pos (c :: rest) =
  case c of
    (p :: ps, body) =>
      case p of
        PVar nm psp => (ps, renameExpr nm pos body) :: prepFallbacks pos rest
        PWild psp => (ps, body) :: prepFallbacks pos rest
        _ => c :: prepFallbacks pos rest
    ([], body) => c :: prepFallbacks pos rest
