    defs
    datas
    depths
    goals
    (instStorePush insts i)
    classes
    dgoals
    deftbl
    gtbl
    soltbl
    dptbl
    gcomp
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

