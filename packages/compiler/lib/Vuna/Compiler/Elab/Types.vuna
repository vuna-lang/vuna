export ecAddInst : Ec -> DtInst -> Ec
ecAddInst ec i = if hasInstKey i.dtInstKey (ecInsts ec) then ec else ecAddInstRaw ec i

export hasInstKey : String -> List DtInst -> Bool
hasInstKey key [] = False
hasInstKey key (i :: rest) = i.dtInstKey == key || hasInstKey key rest

-- | 字典符号是否已登记（符号撞名在 codegen 层是硬错误）。
export hasInstSym : String -> List DtInst -> Bool
hasInstSym sym [] = False
hasInstSym sym (i :: rest) = i.dtInstSym == sym || hasInstSym sym rest

export ecAddInstRaw : Ec -> DtInst -> Ec
ecAddInstRaw (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) i =
  Ec
    next
