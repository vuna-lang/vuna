-- 约束存储读写（所有入口直接使用）。
-- | 读取当前统一约束存储。
export ecConstraints : Ec -> ConstraintStore
ecConstraints (Ec next sols defs datas depths goals insts classes cons deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  cons

-- | 写回统一约束存储。
export ecPutConstraints : Ec -> ConstraintStore -> Ec
ecPutConstraints (Ec next sols defs datas depths goals insts classes cons deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) cons2 =
  Ec
    next
    sols
    defs
    datas
    depths
    goals
    insts
    classes
    cons2
    deftbl
    gtbl
    soltbl
    dptbl
    gcomp
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

-- | 取待处理约束列表（按入队顺序；O(n)，只给需要整表扫描的调用点）。
export ecPendingList : Ec -> List Constraint
ecPendingList ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok => Queue.toList pending

-- | 待处理约束个数（O(1)，求解器的 fuel 与空转判据使用）。
export ecPendingCount : Ec -> Int
ecPendingCount ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok => natToInt (Queue.size pending)

-- | 下一条约束的 id（单调递增；用于「只看本定义新产生的约束」）。
export ecNextConstraintId : Ec -> Int
ecNextConstraintId ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok => next

-- | 从队首取一条待处理约束（摊还 O(1)）。
export ecPopPending : Ec -> Maybe (Constraint, Ec)
ecPopPending ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok =>
      case Queue.pop pending of
        Nothing => Nothing
        Just (c, q2) =>
          Just (c, ecPutConstraints ec (ConstraintStore q2 next tried cnt passNext passSols ctorok))

-- | 追加一条约束到队尾（O(1)）。
export ecPushPending : Ec -> Constraint -> Ec
ecPushPending ec c =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok =>
      ecPutConstraints
        ec
        (ConstraintStore (Queue.push c pending) next tried cnt passNext passSols ctorok)

-- | 用列表替换待处理队列（保持列表顺序；O(n)）。
export ecPutPending : Ec -> List Constraint -> Ec
ecPutPending ec pending2 =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok =>
      ecPutConstraints
        ec
        (ConstraintStore (Queue.fromList pending2) next tried cnt passNext passSols ctorok)

-- | 分配新 id 并把一条约束追加到待处理队列末尾。
export ecAddConstraint : Ec -> ConstraintKind -> Int -> Value -> Maybe Span -> Int -> Ec
ecAddConstraint ec kind meta dom span depth =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok =>
      ecPutConstraints
        ec
        (ConstraintStore (Queue.push (Constraint next kind meta dom span depth) pending) (next + 1) tried cnt passNext passSols ctorok)

-- 已尝试记录（epoch = 解表长度）。
-- | 查某个约束上次尝试时的 epoch（解表长度）；没试过返回 Nothing。
export ecTriedAt : Ec -> Int -> Maybe Int
ecTriedAt ec cid =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok => HashMap.lookup cid tried

-- | 记录某个约束在给定 epoch 的尝试（epoch 通常是当时的解表长度）。
export ecRecordTried : Ec -> Int -> Int -> Ec
ecRecordTried ec cid epoch =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok =>
      ecPutConstraints
        ec
        (ConstraintStore pending next (HashMap.insert cid epoch tried) cnt passNext passSols ctorok)

export ecEmpty : Ec
ecEmpty =
  Ec
    0
    []
    []
    []
    []
    []
    instStoreEmpty
    []
    csEmpty
    (HashMap.fromList [])
    (HashMap.fromList [])
    (HashMap.fromList [])
    (HashMap.fromList [])
    False
    (HashMap.fromList [])
    (HashMap.fromList [])
    False
    []
    []
    []
    []
    []

-- 解表的哈希索引（键 = 元变量编号的十进制串）：`substDictTerm`/`rezonkDefs` 会对每个
-- 定义体的每个元变量查解，关联表是 O(#解) 一次；索引把它降到 O(1)。
export ecSolTbl : Ec -> HashMap Int Value
ecSolTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  soltbl

-- force/conv 的解表包装：list（权威）+ 哈希索引（O(1) 查）+ 元变量创建深度索引
-- （求解点就地检查解的作用域）。
export ecSolsP : Ec -> Sols
ecSolsP ec = solsOf (ecSolTbl ec) (ecSols ec) (ecDepthTbl ec)

export ecPutSols : Ec -> List (Int, Value) -> Ec
ecPutSols ec sols2 =
  let
    delta = solsDelta (ecSols ec) sols2
    soltbl2 = HashMap.insertAll delta (ecSolTbl ec)
    ec2 = ecPutSolsRaw ec sols2 soltbl2
  in ecPutSolsCount ec2 (ecSolsCountOf ec2 + length delta)

-- | O(1) 读解表条目数（求解器的 epoch 判据）。
export ecSolsCountOf : Ec -> Int
ecSolsCountOf ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok => cnt

ecPutSolsCount : Ec -> Int -> Ec
ecPutSolsCount ec cnt =
  case ecConstraints ec of
    ConstraintStore pending next tried old passNext passSols ctorok =>
      ecPutConstraints ec (ConstraintStore pending next tried cnt passNext passSols ctorok)

ecPutSolsRaw : Ec -> List (Int, Value) -> HashMap Int Value -> Ec
ecPutSolsRaw (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) sols2 soltbl2 =
  Ec
    next
    sols2
    defs
    datas
    depths
    goals
    insts
    classes
    dgoals
    deftbl
    gtbl
    soltbl2
    dptbl
    gcomp
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

-- | 记录一轮求解结束时的 (id, 解表数)，供下一轮的空转判据。
export ecPutPassMarker : Ec -> Ec
ecPutPassMarker ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok =>
      ecPutConstraints ec (ConstraintStore pending next tried cnt next cnt ctorok)

-- | 构造子索引是否覆盖全部已加载 data。
export ecCtorIndexComplete : Ec -> Bool
ecCtorIndexComplete ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok => ctorok

ecPutCtorIndexComplete : Ec -> Bool -> Ec
ecPutCtorIndexComplete ec ok =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols _ =>
      ecPutConstraints ec (ConstraintStore pending next tried cnt passNext passSols ok)

-- | 自上次求解轮以来没有新约束、解表也没增长 ⇒ 这一轮必然全部跳过，可整体省掉。
export ecDictPassIdle : Ec -> Bool
ecDictPassIdle ec =
  case ecConstraints ec of
    ConstraintStore pending next tried cnt passNext passSols ctorok =>
      passNext == next && passSols == cnt

-- 新解是前插的：旧表头编号之前的条目就是本次新增的解。
solsDelta : List (Int, Value) -> List (Int, Value) -> List (Int, Value)
solsDelta [] cur = cur
solsDelta ((oid, ov) :: rest) cur = prefixUntilId oid cur

prefixUntilId : Int -> List (Int, Value) -> List (Int, Value)
prefixUntilId pid [] = []
prefixUntilId pid ((cid, cv) :: rest) =
  if cid == pid then [] else (cid, cv) :: prefixUntilId pid rest

-- 数据族名在 `ecDatas` 里（`data T` 与值 `T` 同名时，类型位置必须保持族身份）。
memDataNameIn : String -> List DtData -> Bool
memDataNameIn name [] = False
memDataNameIn name (d :: rest) = if dtDataName d == name then True else memDataNameIn name rest

-- 值定义进 delta 表；但与数据族同名的定义**不进**——否则 `force` 会把签名里的
-- `TGlobal T`（类型位置，本应是族）delta 展开成值定义体，`T` 就退化成了值类型。
-- 定义体仍进 `ecDefs`（codegen 照常产出 `v_T`），只是不做定义性展开。
export ecAddDef : Ec -> (String, Term) -> Ec
ecAddDef (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) d =
  let
    delta =
      if memDataNameIn (firstOf d) datas then
        deftbl
      else
        HashMap.insert (firstOf d) (secondOf d) deftbl
  in Ec
    next
    sols
    (d :: defs)
    datas
    depths
    goals
    insts
    classes
    dgoals
    delta
    gtbl
    soltbl
    dptbl
    gcomp
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

