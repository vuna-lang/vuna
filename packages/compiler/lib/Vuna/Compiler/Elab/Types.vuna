export datasHaveLinear : List DtData -> Bool
datasHaveLinear [] = False
datasHaveLinear (d :: rest) = dtDataLinear d || datasHaveLinear rest

-- 局部上下文：最近绑定的在前。
--
-- 两份并行表示，按用途分工：
--   - `ctxItems`：名字 + 类型**项**（de Bruijn index 形态），用于展示与洞目标；
--   - `ctxEnvF`：未代入精化的求值环境，按「新 binder 取 depth-1」前插维护（O(1)）；
--     已有的 level 在 (idx+1, depth+1) 下不变，所以不需要重建。
--
-- refinements 是索引精化：level ↦ Value（level 形态，可提到更新的 binder，无需 de Bruijn
-- 搬运）。代入后的求值环境在精化/绑定点算一次（`ctxEnvRF`），取用侧 O(1) —— 分支里每次
-- 类型求值都重建一遍整个环境的话，代价是 O(深度 × 类型尺寸)，实测是热路径。
export record Ctx(..) where
  ctxItems : List (String, Term)
  ctxEnvF : List Value
  ctxRefVals : List (Int, Value)
  -- 深度在绑定点维护：`length ctxItems` 是 O(depth)，而它在每个变量引用/分支/隐式实参
  -- 上都会被读，实测是热路径。
  ctxDepthF : Int
  -- 已代入精化的求值环境（`ctxRefVals` 为空时与 `ctxEnvF` 同一个列表）。
  ctxEnvRF : List Value

export ctxDepth : Ctx -> Int
ctxDepth ctx = ctx.ctxDepthF

export ctxBind : String -> Term -> Ctx -> Ctx
ctxBind name ty (Ctx items env refs d rEnv) =
  let
    v = VNeutral (NVar name d [])
  in Ctx ((name, ty) :: items) (v :: env) refs (d + 1) (v :: rEnv)

-- 把一个 Value 形态的类型重新 quote 成项再入上下文（Pi 值里的域只有 Value）。
export ctxBindValue : String -> Value -> Ctx -> Ctx
ctxBindValue name dom (Ctx items env refs d rEnv) =
  let
    v = VNeutral (NVar name d [])
  in Ctx ((name, quote d dom) :: items) (v :: env) refs (d + 1) (v :: rEnv)

-- 记录一批精化：新 binder 不受影响（精化只指更老的 level），环境其余部分重算一次。
export ctxRefine : Ctx -> List (Int, Value) -> Ctx
ctxRefine (Ctx items env refs d rEnvOld) more =
  let
    refs2 = append refs more
  in Ctx items env refs2 d (refinedEnv refs2 env)

export ctxLookupAt : String -> List (String, Term) -> Int -> Maybe (Int, Term)
ctxLookupAt name [] idx = Nothing
ctxLookupAt name ((n, ty) :: rest) idx =
  if n == name then Just (idx, ty) else ctxLookupAt name rest (idx + 1)

export ctxLookup : String -> Ctx -> Maybe (Int, Term)
ctxLookup name ctx = ctxLookupAt name ctx.ctxItems 0

-- 求值环境代入索引精化：没有精化时直接复用环境（O(1)），有精化才逐项重写。
export refinedEnv : List (Int, Value) -> List Value -> List Value
refinedEnv [] env = env
refinedEnv refs env = map (refineValue refs defaultFuel) env

-- 上下文的求值环境：binder 的 level 从底部开始，与 quote 约定一致。
export ctxEnvAt : List (String, Term) -> Int -> Int -> List Value
ctxEnvAt [] idx depth = []
ctxEnvAt ((name, ty) :: rest) idx depth =
  VNeutral (NVar name (depth - idx - 1) []) :: ctxEnvAt rest (idx + 1) depth

-- 未代入精化的求值环境（声明侧视角）：`isOpaqueRuntimeTyIn` 等判据要求「声明成什么
-- 就按什么算」，不能被 case 的索引精化改写。环境在绑定点增量维护，这里只读。
export ctxEnv : Ctx -> List Value
ctxEnv (Ctx items env refs d rEnv) = env

-- 代入索引精化后的求值环境（取用侧视角：分支内所有类型求值都享受等式）。
export ctxEnvRefined : Ctx -> List Value
ctxEnvRefined ctx = ctx.ctxEnvRF

-- 把精化代入一个值。精化是「level ↦ Value」，而求值环境里的 binder 都是中性变量，
-- 求值后做一次重写即可（索引位置上出现的基本是中性变量或构造子值）。resolveLevel 处理链式精化。
export refineValue : List (Int, Value) -> Int -> Value -> Value
refineValue [] fuel v = v
refineValue refs fuel v =
  if fuel <= 0 then
    v
  else
    case v of
      VNeutral n =>
        case n of
          NVar name lvl sp =>
            let
              sp2 = map (refineValue refs (fuel - 1)) sp
            in case refineLookup lvl refs of
              Just r => applySpine (refineValue refs (fuel - 1) r) sp2
              Nothing => VNeutral (NVar name lvl sp2)
          NGlobal g sp => VNeutral (NGlobal g (map (refineValue refs (fuel - 1)) sp))
      VCon c args => VCon c (map (refineValue refs (fuel - 1)) args)
      VApp f a => VApp (refineValue refs (fuel - 1) f) (refineValue refs (fuel - 1) a)
      VCase scrut alts => VCase (refineValue refs (fuel - 1) scrut) alts
      VIf c th el => VIf (refineValue refs (fuel - 1) c) (refineValue refs (fuel - 1) th) (refineValue refs (fuel - 1) el)
      VMeta m sp => VMeta m (map (refineValue refs (fuel - 1)) sp)
      _ => v

export refineLookup : Int -> List (Int, Value) -> Maybe Value
refineLookup lvl [] = Nothing
refineLookup lvl ((l, v) :: rest) = if l == lvl then Just v else refineLookup lvl rest

-- 在取用点把精化代入求值环境再 eval（闭包捕获环境，域/余域递归精化）。见 docs/reference/core.md。
export evalCtx : Ctx -> Term -> Value
evalCtx ctx ty = eval (ctxEnvRefined ctx) ty

-- 局部变量 i 的类型。快路径直接读绑定点缓存的类型值（level 形态，无需 weaken）；
-- 越界时回落到「项 + 当前环境」的老路径，行为与缓存未命中一致。
export varTypeValue : Ctx -> Int -> Term -> Value
varTypeValue ctx idx ty = eval (ctxEnvRefined ctx) (shift 0 (idx + 1) ty)

export emptyCtx : Ctx
emptyCtx = Ctx [] [] [] 0 []

-- ---------------------------------------------------------------
-- 错误 / 状态 helper
-- ---------------------------------------------------------------
export errAt : Span -> String -> Check a
errAt sp msg = rawAt sp msg

-- 新建元变量并记录创建深度（求解时的作用域检查用）。
export newMeta : Ctx -> Ec -> (Term, Ec)
newMeta ctx (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  (TMeta next,
    Ec
      (next + 1)
      sols
      defs
      datas
      ((next, ctxDepth ctx) :: depths)
      goals
      insts
      classes
      dgoals
      deftbl
      gtbl
      soltbl
      (HashMap.insert next (ctxDepth ctx) dptbl)
      gcomp
      ctbl
      ctortbl
      haslin
      mspans
      uspans
      warnings
      counters
      errors)

export forceVal : Ec -> Value -> Value
forceVal ec v = force (ecDefTbl ec) (ecSolsP ec) defaultFuel v

-- 完整精化，额外返回洞目标与最终状态（供 `vuna goal` / LSP 的洞显示）。
-- 还带上收尾时的 globals / 实例表 / 类表 / 元变量游标——REPL 的表达式求值要在
-- 与程序相同的环境里精化一条表达式（`dtEvalExprIn`），这些状态不属于「定义」但对
-- 精化是必需的。
export record DtProgram(..) where
  dtProgDatas : List DtData
  dtProgDefs : List DtDef
  dtProgGoals : List DtGoal
  dtProgSols : List (Int, Value)
  dtProgGlobals : List (String, Term)
  dtProgInsts : List DtInst
  dtProgClasses : List DtClass
  dtProgNext : Int
  dtProgDepths : List (Int, Int)
  -- 本次精化发射的 warning（诊断出口；驱动层按检查单元过滤）。
  dtProgWarnings : List Diagnostic

export dtProgDatas : DtProgram -> List DtData
dtProgDatas (DtProgram datas defs goals sols globals insts classes next depths warnings) = datas

export dtProgDefs : DtProgram -> List DtDef
dtProgDefs (DtProgram datas defs goals sols globals insts classes next depths warnings) = defs

export dtProgGoals : DtProgram -> List DtGoal
dtProgGoals (DtProgram datas defs goals sols globals insts classes next depths warnings) = goals

export dtProgSols : DtProgram -> List (Int, Value)
dtProgSols (DtProgram datas defs goals sols globals insts classes next depths warnings) = sols

export dtProgGlobals : DtProgram -> List (String, Term)
dtProgGlobals (DtProgram datas defs goals sols globals insts classes next depths warnings) = globals

export dtProgInsts : DtProgram -> List DtInst
dtProgInsts (DtProgram datas defs goals sols globals insts classes next depths warnings) = insts

export dtProgClasses : DtProgram -> List DtClass
dtProgClasses (DtProgram datas defs goals sols globals insts classes next depths warnings) = classes

-- | 本次精化发射的 warning（按发射顺序）。
export dtProgWarnings : DtProgram -> List Diagnostic
dtProgWarnings (DtProgram datas defs goals sols globals insts classes next depths warnings) =
  warnings

-- 解表 → 索引（键 = 元变量编号的十进制串）。解表里每个元变量最多一条解，顺序无关。
export solsToTbl : List (Int, Value) -> HashMap Int Value
solsToTbl sols = HashMap.insertAll sols (HashMap.fromList [])

export ecPutDefTbl : Ec -> HashMap String Term -> Ec
ecPutDefTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) deftbl2 =
  Ec
    next
    sols
    defs
    datas
    depths
    goals
    insts
    classes
    dgoals
    deftbl2
    gtbl
    soltbl
    dptbl
    gcomp
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors
