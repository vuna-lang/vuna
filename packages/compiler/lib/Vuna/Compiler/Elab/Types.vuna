-- 构造子索引：名字 → DtCtor（唯一真相仍是 `ecDatas`；表只是可重建缓存）。
export ctorTblOfDatas : List DtData -> HashMap String DtCtor
ctorTblOfDatas datas = HashMap.insertAll (concatMap dataCtorPairs datas) (HashMap.fromList [])

dataCtorPairs : DtData -> List (String, DtCtor)
dataCtorPairs d = map (\c => (dtCtorName c, c)) (dtDataCtors d)

export ecPutCtorTbl : Ec -> HashMap String DtCtor -> Ec
ecPutCtorTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) ctortbl2 =
  ecPutCtorIndexComplete
    (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl2 haslin mspans uspans warnings counters errors)
    True

