module Vuna.Compiler.Elab.Types where

-- Vuna.Compiler.Elab.Types：Elab 的数据定义与共享状态：DtDef/DtCtor/DtData/DtGoal/DtClass/DtInst/Constraint/DtProgram
-- 等精化结果、Ec 环境与 Ctx 局部上下文、以及「上下文环境求值 / 索引精化代入」的基础设施。
-- 数据定义只在这里（叶子模块），其余模块只做模式匹配与访问器调用。
-- 对外门面是 `Vuna.Compiler.Elab`；本模块按真实调用图与其余 `Elab.*` 子模块分工。
import Vuna.Compiler.Base.Common
import Base.Container.HashMap as HashMap
import Base.Container.Queue as Queue
import Base.Data.List as List
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name

-- 一个 DT 定义：名字、类型项、体项（均为闭项；体带擦除标志）。
-- `DtAxiom` 是**无体/不透明**的顶层（`axiom name : Ty`）：它只有类型，没有
-- 运行时定义体。类型层引用合法；运行时位置的使用由擦除检查报
-- `CG_AxiomAtRuntime`。`dtDefBody` 因此返回 `Maybe Term`。
-- 末位带**来源 span**——顶层 DFun/DAxiom 用子句 span；instance 生成的
-- 字典定义用 instance 声明 span；trait 方法投影用 trait 声明 span；其它生成项（无来源）
-- 给 `Nothing`。codegen/擦除诊断据此把 `file:line:col:` 前缀补上。
export data DtDef(..) : Type where
  DtDef : String -> Term -> Term -> Maybe Span -> DtDef
  DtAxiom : String -> Term -> Maybe Span -> DtDef
  -- 受限 FFI：签名 + C 符号名，运行时由生成代码的 OCaml `external` 提供。
  DtExtern : String -> Term -> String -> Maybe Span -> DtDef

export dtDefName : DtDef -> String
dtDefName (DtDef name ty body span) = name
dtDefName (DtAxiom name ty span) = name
dtDefName (DtExtern name ty cName span) = name

export dtDefType : DtDef -> Term
dtDefType (DtDef name ty body span) = ty
dtDefType (DtAxiom name ty span) = ty
dtDefType (DtExtern name ty cName span) = ty

export dtDefBody : DtDef -> Maybe Term
dtDefBody (DtDef name ty body span) = Just body
dtDefBody (DtAxiom name ty span) = Nothing
dtDefBody (DtExtern name ty cName span) = Nothing

-- 有运行时定义体的定义（axiom 不算）：构造 def 表 / 求值环境时用它滤掉无体顶层。
export dtDefHasBody : DtDef -> Bool
dtDefHasBody (DtDef name ty body span) = True
dtDefHasBody (DtAxiom name ty span) = False
dtDefHasBody (DtExtern name ty cName span) = True

-- extern 的 C 符号名（Nothing = 不是 extern 定义）。
export dtDefExtern : DtDef -> Maybe String
dtDefExtern (DtExtern name ty cName span) = Just cName
dtDefExtern _ = Nothing

-- 来源 span（唯一读入口）：诊断在 def 粒度补 `file:line:col:` 前缀；`Nothing` 时保持无位置。
export dtDefSpan : DtDef -> Maybe Span
dtDefSpan (DtDef name ty body span) = span
dtDefSpan (DtAxiom name ty span) = span
dtDefSpan (DtExtern name ty cName span) = span

-- 一个构造子。telescope 是「族参数 + 字段」的完整 binder 表（名字 / 擦除标志），
-- 类型项是闭合的（`{n : Nat} -> {a : Type} -> a -> Vec n a -> Vec (Succ n) a` 形态）。
export record DtCtor(..) where
  dtCtorName : String
  dtCtorFamily : String
  dtCtorTelescope : List (String, Rig)
  dtCtorType : Term
  dtCtorSpan : Maybe Span

export dtCtorName : DtCtor -> String
dtCtorName (DtCtor name family tele ty sp) = name

export dtCtorFamily : DtCtor -> String
dtCtorFamily (DtCtor name family tele ty sp) = family

export dtCtorTelescope : DtCtor -> List (String, Rig)
dtCtorTelescope (DtCtor name family tele ty sp) = tele

export dtCtorType : DtCtor -> Term
dtCtorType (DtCtor name family tele ty sp) = ty

-- | 一条 record 字段的 Core 元数据（名字 / 声明序号 / 字段类型）。
-- `dtFieldType` 处在**外层上下文**（只剩族参数）里：构造子 telescope 的字段域已按
-- 序号 shift 掉前序字段 binder（record 字段类型不能引用前序字段），因此投影时
-- `eval (reverse idxs) dtFieldType` 即可，无需 `@vuna@record@dep` 占位值。
export record DtFieldMeta(..) where
  dtFieldName : String
  dtFieldIndex : Int
  dtFieldType : Term

-- 一个归纳族（索引族）。params 来自 kind 的 Pi binder（域是宇宙的擦除）。
export record DtData(..) where
  dtDataName : String
  dtDataParams : List (String, Rig)
  dtDataCtors : List DtCtor
  dtDataKind : Term
  -- `deriving via field` 列出的类（canonical 名）；空 = 普通 data。
  dtDataViaClasses : List String
  -- `lin data` / `lin record` 声明；线性族的值必须由 quantity 1 的 binder 绑定。
  dtDataLinear : Bool
  dtDataRepr : ReprTier
  -- record 字段表（名字 → 序号 → 外层字段类型）；普通 data 为空表。
  dtDataFields : List DtFieldMeta
  -- 该族是否由 `record` 声明。record 在 Core 仍带合成位置构造子
  -- （服务 TMk/eval/codegen），但表示推断 / via-field / HasField / OCaml record 判定
  -- 都按这个标记区分，不再靠 `dtDataFields` 非空猜（零字段 record 也有独立身份）。
  dtDataIsRecord : Bool

export dtDataName : DtData -> String
dtDataName (DtData name params ctors kind viaClasses lin repr fields isRec) = name

export dtDataCtors : DtData -> List DtCtor
dtDataCtors (DtData name params ctors kind viaClasses lin repr fields isRec) = ctors

export dtDataKind : DtData -> Term
dtDataKind (DtData name params ctors kind viaClasses lin repr fields isRec) = kind

-- | 取出 `deriving via field` 声明的类名列表（canonical 名；空表示普通 data）。
dtDataViaClasses : DtData -> List String
dtDataViaClasses (DtData name params ctors kind viaClasses lin repr fields isRec) = viaClasses

-- | 表示档位（`ReprAuto` = 未声明，回落自动去装箱推断；档位进 iface，下游与 FFI 可依赖）。
export dtDataRepr : DtData -> ReprTier
dtDataRepr (DtData name params ctors kind viaClasses lin repr fields isRec) = repr

-- | record 字段表（普通 data 为空）。进 iface（`miCached`），跨包字段访问据此查表。
export dtDataFields : DtData -> List DtFieldMeta
dtDataFields (DtData name params ctors kind viaClasses lin repr fields isRec) = fields

-- | 该族是否由 `record` 声明（`data` 与字典族为 False）。
export dtDataIsRecord : DtData -> Bool
dtDataIsRecord (DtData name params ctors kind viaClasses lin repr fields isRec) = isRec

export dtDataLinear : DtData -> Bool
dtDataLinear (DtData name params ctors kind viaClasses lin repr fields isRec) = lin

-- 一个洞的目标。编号、位置、目标类型（level 形态）、绑定时上下文快照。
-- `dtGoalName` 是洞的显示名（`_` = 匿名 → `""`；`?name` → `"?name"`）。
export record DtGoal(..) where
  dtGoalMeta : Int
  dtGoalSpan : Span
  dtGoalType : Value
  dtGoalCtx : List (String, Term)
  dtGoalName : String

-- 接口（trait）声明。参数名表、父类字典域、方法（名字 + 完整投影类型项）。
export record DtClass(..) where
  dtClassName : String
  dtClassParams : List String
  -- 直接父类字典域（在类参数 telescope 下）；字典构造子的前几个字段，顺序即字段序。
  dtClassSupers : List Term
  dtClassMethods : List (String, Term)
  dtClassFieldTys : List Term
  -- 方法名 → 声明 span（跨 iface 保留，供“实例缺方法”诊断指向 trait 方法行）。
  dtClassMethodSpans : List (String, Span)

export dtClassName : DtClass -> String
dtClassName (DtClass name params supers projs fieldTys spans) = name

-- 已注册实例：定义名 + 实例头类型项（`Show Int` 这类闭合项）+ 是否命名实例。
-- `as name` 的命名实例**不参与**自动实例搜索（只能 `@name` 选中，与 HM 一致），
-- 否则 `instance Pretty Color` 与 `instance Pretty Color as fancy` 会撞成歧义。
export record DtInst(..) where
  -- | 显示名（诊断 / 候选列表；类短名 + head 名，见 `Elab.InstName.instanceName`）。
  dtInstName : String
  -- | codegen 的字典符号（完整类名 + head 名，见 `instanceSymbol`）。
  dtInstSym : String
  -- | 稳定身份：完整类名 + 头（telescope 变量归一、span 无关）的规范摘要。
  --   与源码名 / 排序 / span 解耦；`ecAddInst`、coherence、iface 排序与缓存去重都用它。
  dtInstKey : String
  dtInstTele : List (String, Term)
  dtInstCtx : List Term
  dtInstHead : Term
  dtInstSpan : Maybe Span

export dtInstName : DtInst -> String
dtInstName i = i.dtInstName

export dtInstSym : DtInst -> String
dtInstSym i = i.dtInstSym

export dtInstKey : DtInst -> String
dtInstKey i = i.dtInstKey

-- 把一个项拆成「全局头 + 带 multiplicity 的实参表」（`Dict_C a` ⇒ `(Dict_C, [a])`）。
-- 非全局头（元变量/局部变量/lambda/…）返回 Nothing。实例头识别、族名提取共用它。
-- | 把项拆成「全局头 + 带 multiplicity 的实参表」（如 `Dict_C a` 拆成 `(Dict_C, [a])`）；头不是全局名时返回 Nothing。
export flattenTaggedApp : Term -> Maybe (String, List (Term, Rig))
flattenTaggedApp (TApp f a rig) =
  case flattenTaggedApp f of
    Just (g, args) => Just (g, append args [(a, rig)])
    Nothing => Nothing
flattenTaggedApp (TGlobal g) = Just (g, [])
flattenTaggedApp _ = Nothing

-- 实例登记表（`Ec.ecInsts` 的字段类型）。
--   - `instsList` 是**权威**表：登记序，实例搜索按此序做 specific→blanket 两阶段；
--   - `instsByFamily` 是**派生索引**：键 = 实例头族名（`Dict_<类>`），桶内保登记序；
--     只用来把「搜索某个字典族的实例」的候选从全表缩到同族。
-- 索引不一致只影响速度（候选少了会少找到实例——所以 `ecInstsAudit` 在 debug 下自检），
-- 语义真相始终是 `instsList`。字段与构造器不导出：外部只能经 `instStoreEmpty` /
-- `instStoreOf` / `instStorePush` 维护，经 `ecInsts`（全表）/ `ecInstsFamily`（族桶）读。
-- | 实例登记表：按登记序排列的权威实例列表，加上按实例头族名（`Dict_<类>`）分桶的派生索引。
export record InstStore where
  instsList : List DtInst
  instsByFamily : HashMap String (List DtInst)

-- 实例头的族名（`Dict_<类>` 全局名）；头不是全局应用时返回空串（理论上实例头都合法）。
-- | 实例头的字典族名（`Dict_<类>` 全局名）；头不是全局应用时返回空串。
export instFamilyOf : DtInst -> String
instFamilyOf i =
  case flattenTaggedApp i.dtInstHead of
    Just (g, args) => g
    Nothing => ""

-- | 空实例登记表：权威列表与族索引都为空。
export instStoreEmpty : InstStore
instStoreEmpty = InstStore [] (HashMap.fromList [])

-- 按登记序建表（`ecAddInstRaw` 每次 push；总量 ≪ 100，逐步 push 的 O(n²) 可忽略）。
-- | 按登记序由实例列表构建登记表（逐个 push，实例总量很小）。
export instStoreOf : List DtInst -> InstStore
instStoreOf [] = instStoreEmpty
instStoreOf (i :: rest) = instStorePush (instStoreOf rest) i

-- | 把一个实例追加到权威列表末尾，同时追加进它所属头族的桶。
export instStorePush : InstStore -> DtInst -> InstStore
instStorePush store i =
  let
    fam = instFamilyOf i
    bucket =
      case HashMap.lookup fam store.instsByFamily of
        Just b => b
        Nothing => []
  in InstStore
    (append store.instsList [i])
    (HashMap.insert fam (append bucket [i]) store.instsByFamily)

-- 精确族桶（不回落全表；未知族 = 空表）。
-- | 精确取某个头族的实例桶；未知族返回空表（不回落全表）。
instStoreFamily : InstStore -> String -> List DtInst
instStoreFamily store fam =
  case HashMap.lookup fam store.instsByFamily of
    Just b => b
    Nothing => []

-- 精化状态：下一个元变量编号、已解元变量（level 形态的 Value）、已精化的定义体、
-- 已声明的归纳族（case 精化需要知道族的构造子 telescope）。
-- `dgoals` 是延迟的字典约束——类参数未解时延迟成裸元变量，解后由 `resolveDictGoals` 回填。
-- 统一约束存储。`Constraint` 同时承载字典目标与行成员目标（kind 区分），带稳定 id、
-- 延迟点 span 与创建深度（诊断/作用域检查用；由延迟点填）。`csPending` 是 FIFO 队列
-- （从表头取、未解目标追加到表尾），`csNextId` 只用于分配 id。
-- | 延迟约束的类别：`CkDict` 是字典目标，`CkRow` 是行成员（效应）目标。
export data ConstraintKind(..) : Type where
  CkDict : ConstraintKind
  CkRow : ConstraintKind

-- | 一条延迟约束：稳定 id、类别、待解元变量、目标域值、延迟点 span 与创建深度。
export record Constraint(..) where
  conId : Int
  conKind : ConstraintKind
  conMeta : Int
  conDom : Value
  conSpan : Maybe Span
  conDepth : Int

-- | 统一约束存储：待处理约束**队列**（FIFO：逐个从表头取、未解目标追加到表尾）、下一个 id、
-- id 到尝试 epoch 的记录。
export record ConstraintStore where
  csPending : Queue Constraint
  csNextId : Int
  -- conId ↦ 上次尝试时的解表长度。只有解表增长才值得重试；没有进展的
  -- 目标在 program-level 每轮被跳过（仍留在 pending 里，供定义收尾 lift 用）。
  -- 按 id 索引（Hash），否则记录随尝试次数增长后，每次 `ecTriedAt` 都要线性扫。
  csTried : HashMap Int Int
  -- 解表条目数（O(1) 读）：epoch 判据要按它比较，不能每步 `length (ecSols …)`。
  csSolsCount : Int
  -- 上一轮收敛结束时的 (id, 解表数)：两者都没变时整轮必然空转，直接跳过。
  csPassNext : Int
  csPassSols : Int
  -- 构造子索引（`ecCtorTbl`）是否覆盖全部已加载 data：覆盖后「查不到 = 不是构造子」，
  -- 否则要做一次族表线性扫才能判定。
  csCtorIndexComplete : Bool

-- | 空约束存储：无待处理约束、id 从 0 开始、无已尝试记录。
export csEmpty : ConstraintStore
csEmpty = ConstraintStore Queue.empty 0 (HashMap.fromList []) 0 (0 - 1) (0 - 1) False

-- 末尾两个字段是**可重建缓存**（真相始终是列表 / defTbl）：
--   - `ecCtorTbl : HashMap String DtCtor`：构造子名 → DtCtor。`elabDatas` 之后建一次
--     （`ctorTblOfDatas`），`ecAddData` 增量插入；查不到时 `dtCtorLookupEc` 回落
--     `dtCtorLookup name (ecDatas ec)`，所以任何阶段的表不完整都只影响速度；
export record Ec(..) where
  ecNext : Int
  ecSols : List (Int, Value)
  ecDefsRev : List (String, Term)
  ecDatas : List DtData
  ecDepthOfMeta : List (Int, Int)
  ecGoals : List DtGoal
  -- 实例表是 `InstStore`（权威列表 + 按头族索引）。
  ecInsts : InstStore
  ecClasses : List DtClass
  -- 统一约束存储：字典目标与行成员目标共用一张待处理表。
  ecConstraints : ConstraintStore
  ecDefTbl : HashMap String Term
  ecGlobalsTbl : HashMap String Term
  ecSolTbl : HashMap Int Value
  ecDepthTbl : HashMap Int Int
  ecGlobalsComplete : Bool
  ecClausesTbl : HashMap String (List (List Pat, Expr))
  ecCtorTbl : HashMap String DtCtor
  -- 是否含线性数据族（O(1) 早退，避免每个 Pi 都线性扫 ecdatas）。
  ecHasLinear : Bool
  -- 元变量创建点 / QTT 使用点登记表（显式状态，替代进程内 IORef）。
  ecMetaSpans : List (Int, Span)
  ecUseSpans : List (String, Span)
  -- 本次精化发射的 warning（按发射顺序；由 Elab 显式线程，精化出口挂到 DtProgram）。
  ecWarnings : List Diagnostic
  -- 诊断计数器事件（前插的只读日志；仅在 `--debug-perf` 的规模行里归并读取）。
  -- 用「事件列表」而不是 HashMap：每次 bump 只付一次 cons，热路径上不付哈希/桶复制。
  ecCounters : List String
  -- 逐定义恢复时收集的诊断（前插；出口 reverse）。严格路径不用它（首个错误直接短路）。
  ecErrors : List Diagnostic

export ecPutNext : Ec -> Int -> Ec
ecPutNext (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) n =
  Ec
    n
    sols
    defs
    datas
    depths
    goals
    insts
    classes
    dgoals
    deftbl
    gtbl
    soltbl
    dptbl
    gcomp
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

export ecPutClausesTbl : Ec -> HashMap String (List (List Pat, Expr)) -> Ec
ecPutClausesTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) ctbl2 =
  Ec
    next
    sols
    defs
    datas
    depths
    goals
    insts
    classes
    dgoals
    deftbl
    gtbl
    soltbl
    dptbl
    gcomp
    ctbl2
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

export ecNext : Ec -> Int
ecNext (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  next

export ecSols : Ec -> List (Int, Value)
ecSols (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  sols

export ecDefs : Ec -> List (String, Term)
-- 内部按「新定义前插」存放（ecAddDef O(1)），读出时还原源顺序。
ecDefs (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  reverse defs

-- 定义体的哈希索引：`force` 的 delta 展开用它查「这个全局名有没有定义体」。
export ecDefTbl : Ec -> HashMap String Term
ecDefTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  deftbl

-- 全局签名（含构造子/族名）的哈希索引：正文类型检查的热路径用它替代线性扫 globals。
-- 在 `elabBodies` 之前用当时的 globals 建一次；正文期间每精化一个定义就插入它的类型。
export ecGlobalsTbl : Ec -> HashMap String Term
ecGlobalsTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  gtbl

export ecPutGlobalsTbl : Ec -> HashMap String Term -> Ec
ecPutGlobalsTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) gtbl2 =
  Ec
    next
    sols
    defs
    datas
    depths
    goals
    insts
    classes
    dgoals
    deftbl
    gtbl2
    soltbl
    dptbl
    gcomp
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

export ecDatas : Ec -> List DtData
ecDatas (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  datas

export ecDepthTbl : Ec -> HashMap Int Int
ecDepthTbl (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  dptbl

-- 全局表是否已完整建立（bodies 阶段开始前由 elabProgramGo 置 True）。完整时
-- globalsLookup 未命中即可返回 Nothing：省掉「线性扫全 globals」的回落
-- （实测 16k 次/单次 check、每次扫 ~2500 项；未命中的都是数据族名）。
export ecSetGlobalsComplete : Ec -> Bool -> Ec
ecSetGlobalsComplete (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) g =
  Ec
    next
    sols
    defs
    datas
    depths
    goals
    insts
    classes
    dgoals
    deftbl
    gtbl
    soltbl
    dptbl
    g
    ctbl
    ctortbl
    haslin
    mspans
    uspans
    warnings
    counters
    errors

export ecGoals : Ec -> List DtGoal
ecGoals (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  goals

export ecInsts : Ec -> List DtInst
ecInsts (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  insts.instsList

-- 实例表的**族桶**读入口（精确匹配，`fam` 未知 = 空表）。
-- | 读取实例表中某个头族的实例桶（精确匹配；未知族返回空表）。
export ecInstsFamily : Ec -> String -> List DtInst
ecInstsFamily (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) fam =
  instStoreFamily insts fam

-- 索引自检（**只**在 `--debug-perf` 下由 `Elab.Driver` 调用；调用方负责先判
-- `perfEnabled`，因为这里会扫全表）。两个判据：
--   1) 所有桶的条目总数 == 权威表长度（没漏、没重）；
--   2) 每个桶逐项等于「按该族过滤权威表」的结果（桶内容与族键一致，且桶内保序）。
-- 用实例名序列比较（`DtInst` 没有 Eq 实例；实例名唯一）。
-- | 自检实例表索引：所有桶的条目总数等于权威表长度，且每个桶与按该族过滤权威表的结果逐项一致。
export ecInstsAudit : Ec -> Bool
ecInstsAudit (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  let
    pairs = HashMap.toList insts.instsByFamily
    list = insts.instsList
  in bucketCount pairs == length list && allBucketsMatch list pairs

-- | 统计所有族桶里实例条目的总数。
bucketCount : List (String, List DtInst) -> Int
bucketCount [] = 0
bucketCount (p :: rest) = length (secondOf p) + bucketCount rest

-- | 校验每个族桶的实例名序列等于权威表按该族过滤后的序列（桶内保序、不漏不重）。
allBucketsMatch : List DtInst -> List (String, List DtInst) -> Bool
allBucketsMatch list [] = True
allBucketsMatch list ((fam, bucket) :: rest) =
  instNamesEq (map dtInstSym bucket) (map dtInstSym (filter (\i => instFamilyOf i == fam) list))
    && allBucketsMatch list rest

-- | 逐项比较两个实例名列表是否相等。
instNamesEq : List String -> List String -> Bool
instNamesEq [] [] = True
instNamesEq [] (b :: brest) = False
instNamesEq (a :: arest) [] = False
instNamesEq (a :: arest) (b :: brest) = a == b && instNamesEq arest brest

export ecClasses : Ec -> List DtClass
ecClasses (Ec next sols defs datas depths goals insts classes dgoals deftbl gtbl soltbl dptbl gcomp ctbl ctortbl haslin mspans uspans warnings counters errors) =
  classes

