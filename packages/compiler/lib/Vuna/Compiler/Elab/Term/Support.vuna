module Vuna.Compiler.Elab.Term.Support where

-- Vuna.Compiler.Elab.Term.Support：Term 的非递归叶子 helper（无组内递归）。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Elab.Case
import Vuna.Compiler.Elab.Dict
import Vuna.Compiler.Elab.Match
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name

-- 值位置只查值命名空间（`valueLookup`：构造子优先，再全局定义）。
-- 类型名只在没有任何值候选时作为「类型作为项」命中（数据族名在 globals 里有 kind）。
export inferVarRef : List (String, Term) -> Ctx -> Ec -> String -> Span -> Check (Term, Value, Ec)
inferVarRef globals ctx ec name sp =
  case ctxLookup name ctx of
    Just (idx, tyTerm) => OkC (TVar name idx sp, varTypeValue ctx idx tyTerm, ec)
    Nothing =>
      case valueLookup globals ec name of
        Just (VECtor ctor) => inferCtorRef ec ctx name (dtCtorType ctor)
        -- 全隐式前缀的全局值（HM 泛化出的 unifyErr : Result a、empty : Map k v）
        -- 必须在引用处实例化隐式参数，否则拿到的是 Pi 类型（{a} -> Result a），
        -- 在 if/分支/实参位置与期望类型对不上。构造子另有 inferCtorRef 处理。
        Just (VEDef tyTerm) =>
          if allImplicitPrefix tyTerm then
            let
              inst = instantiateAllImplicit ctx ec (ctorRefTerm (ecDatas ec) name) (eval [] tyTerm) []
            in OkC inst
          else
            OkC (ctorRefTerm (ecDatas ec) name, eval [] tyTerm, ec)
        Nothing => tcErr1 sp (UnknownName name) name

-- 签名项是否以隐式 Pi 开头并最终落到值（{a : Type} -> Result a）；显式 Pi 不算。
export allImplicitPrefix : Term -> Bool
allImplicitPrefix (TPi n implicit rig dom cod) = implicit && allImplicitPrefix cod
allImplicitPrefix _ = True

-- 实例化全隐式前缀：逐个插元变量，得到「值 + 剩余值类型」。
export instantiateAllImplicit : Ctx -> Ec -> Term -> Value -> List (Term, Rig) -> (Term, Value, Ec)
instantiateAllImplicit ctx ec head ty acc = instantiateAllImplicitFuel 64 ctx ec head ty acc

export instantiateAllImplicitFuel : Int -> Ctx -> Ec -> Term -> Value -> List (Term, Rig) -> (Term, Value, Ec)
instantiateAllImplicitFuel fuel ctx ec head ty acc =
  if fuel <= 0 then
    (foldAppTerms head (reverse acc), ty, ec)
  else
    case forceVal ec ty of
      VPi name implicit rig dom clo =>
        if implicit then
          let
            m = ecNext ec
          in case newMeta ctx ec of
            (mt, ec1) => instantiateAllImplicitFuel (fuel - 1) ctx ec1 head (applyClosure clo (VMeta m [])) ((mt, rig) :: acc)
        else
          (foldAppTerms head (reverse acc), ty, ec)
      _ => (foldAppTerms head (reverse acc), ty, ec)

-- where 块（parser 的 `ELet .. True`）要求每个绑定都有签名行；普通 `let` 的签名可选。
-- 两者共用同一套绑定块模型（parser 的 `bindingItemsToBinds`），这里只收口「是否强制」，
-- 使 check/infer 两条 let 路径不再各自重复这一段分支。
export checkBindingSigs : Bool -> List (Pat, Expr) -> Check Int
checkBindingSigs True binds = checkWhereSigs binds
checkBindingSigs False binds = OkC 0

export checkWhereSigs : List (Pat, Expr) -> Check Int
checkWhereSigs [] = OkC 0
checkWhereSigs (bnd :: rest) =
  case secondOf bnd of
    EAnn value ty annSp => checkWhereSigs rest
    _ =>
      let
        name = whereBindingName (firstOf bnd)
      in tcErr2 (patSpan (firstOf bnd)) (WhereNeedsSig name name) name name

export whereBindingName : Pat -> String
whereBindingName (PVar name sp) = name
whereBindingName _ = "_"

-- | 逐条未处理 effect 挂 `unhandled:` 字段。
export withEffectLabels : List String -> Diagnostic -> Diagnostic
withEffectLabels [] d = d
withEffectLabels (l :: rest) d = withEffectLabels rest (withField (FieldEffect "unhandled: ${l}") d)
