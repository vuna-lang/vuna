module Vuna.Compiler.Elab.Term.Support where

-- Vuna.Compiler.Elab.Term.Support：Term 的非递归叶子 helper（无组内递归）。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Core.Conv
import Vuna.Compiler.Base.Diagnostics
import Vuna.Compiler.Elab.Case
import Vuna.Compiler.Elab.Dict
import Vuna.Compiler.Elab.Match
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Frontend.Rast
import Vuna.Compiler.Frontend.Rast.Name

-- 值位置只查值命名空间（`valueLookup`：构造子优先，再全局定义）。
-- 类型名只在没有任何值候选时作为「类型作为项」命中（数据族名在 globals 里有 kind）。
export inferVarRef : List (String, Term) -> Ctx -> Ec -> String -> Span -> Check (Term, Value, Ec)
inferVarRef globals ctx ec name sp =
  case fieldSelectorOf name of
    Just (recordName, fieldName) => elabFieldSelector ctx ec recordName fieldName sp
    Nothing =>
      case ctxLookup name ctx of
        Just (idx, tyTerm) => OkC (TVar name idx sp, varTypeValue ctx idx tyTerm, ec)
        Nothing =>
          case valueLookup globals ec name of
            Just (VECtor ctor) => inferCtorRef ec ctx name (dtCtorType ctor)
            -- 全隐式前缀的全局值（HM 泛化出的 unifyErr : Result a、empty : Map k v）
            -- 必须在引用处实例化隐式参数，否则拿到的是 Pi 类型（{a} -> Result a），
            -- 在 if/分支/实参位置与期望类型对不上。构造子另有 inferCtorRef 处理。
            Just (VEDef tyTerm) =>
              if allImplicitPrefix tyTerm then
                let
                  inst = instantiateAllImplicit ctx ec (ctorRefTerm (ecDatas ec) name) (eval [] tyTerm) []
                in OkC inst
              else
                OkC (ctorRefTerm (ecDatas ec) name, eval [] tyTerm, ec)
            Nothing => tcErr1 sp (UnknownName name) name

-- ---------------------------------------------------------------
-- 字段选择器（Loader 为 `R.f` 合成的 `@vuna@select@<记录>@<字段>`）
-- ---------------------------------------------------------------
-- 选择器就是字段投影的 η 展开：`\{params} (p : R params) -> p.f`，类型
-- `{params} -> R params -> T`。record 身份、字段表与构造子 telescope 全部来自
-- `ecDatas`（跨包经 iface 流动），所以不依赖源码声明，也不产生新的全局。
-- | 线上名是否是字段选择器标记（返回记录 canonical 名与字段名）。
export fieldSelectorOf : String -> Maybe (String, String)
fieldSelectorOf name =
  case classify name of
    Just (RsFieldSel recName fldName) => Just (recName, fldName)
    _ => Nothing

-- | 线上名是否是字段选择器标记。
export isFieldSelectorName : String -> Bool
isFieldSelectorName name = isFieldSelText name

-- | 合成字段选择器项与类型；record 不存在 / 不是 record / 线性 record / 无该字段都报错。
export elabFieldSelector : Ctx -> Ec -> String -> String -> Span -> Check (Term, Value, Ec)
elabFieldSelector ctx ec recordName fieldName sp =
  case dtDataLookup recordName (ecDatas ec) of
    Nothing => errAt sp "field selector needs a record in scope: ${recordName}"
    Just dd =>
      if not (dtDataIsRecord dd) then
        errAt sp "${recordName} is not a record; field selector ${fieldName} is undefined"
      else if dtDataLinear dd then
        errAt sp "linear record ${recordName} has no field selectors; use pattern matching"
      else
        case dtDataCtors dd of
          [ctor] =>
            case fieldMetaOf fieldName (dtDataFields dd) of
              Nothing => errAt sp "record ${recordName} has no field ${fieldName}"
              Just fm => OkC (selectorTerm dd ctor fm, eval (ctxEnv ctx) (selectorType dd fm), ec)
          _ => errAt sp "record ${recordName} is malformed: expected exactly one constructor"

-- | 按名字查字段元数据（字段表线性扫）。
fieldMetaOf : String -> List DtFieldMeta -> Maybe DtFieldMeta
fieldMetaOf name [] = Nothing
fieldMetaOf name (fm :: rest) = if fm.dtFieldName == name then Just fm else fieldMetaOf name rest

-- | 选择器的类型：族参数改成隐式 Pi（与构造子类型同形），末位接 `(p : R params) -> T`。
selectorType : DtData -> DtFieldMeta -> Term
selectorType dd fm = selectorPiTail dd fm (dtDataKind dd)

selectorPiTail : DtData -> DtFieldMeta -> Term -> Term
selectorPiTail dd fm (TPi name implicit rig dom cod) =
  TPi name True rig dom (selectorPiTail dd fm cod)
selectorPiTail dd fm _ = TPi "p" False RigOmega (recordTypeApp dd) (shift 0 1 fm.dtFieldType)

-- | 记录类型应用 `R p_0 .. p_{n-1}`（索引按当前 Pi 链的深度）。
recordTypeApp : DtData -> Term
recordTypeApp dd =
  recordTypeAppGo 0 (length dd.dtDataParams) (TGlobal dd.dtDataName) dd.dtDataParams

recordTypeAppGo : Int -> Int -> Term -> List (String, Rig) -> Term
recordTypeAppGo i n acc [] = acc
recordTypeAppGo i n acc ((paramName, paramRig) :: rest) =
  recordTypeAppGo (i + 1) n (TApp acc (TVar paramName (n - 1 - i) spanEmpty) Rig0) rest

-- | 选择器项：族参数 λ 链 + `p` λ，体是 record 投影（与字段访问同一个 `TProj` 形态）。
selectorTerm : DtData -> DtCtor -> DtFieldMeta -> Term
selectorTerm dd ctor fm =
  selectorParamLams
    dd.dtDataParams
    (TLam "p" RigOmega Nothing spanEmpty (TProj (TVar "p" 0 spanEmpty) (dtCtorName ctor) (drop (length dd.dtDataParams) (dtCtorTelescope ctor)) (length dd.dtDataParams + fm.dtFieldIndex) fm.dtFieldIndex))

selectorParamLams : List (String, Rig) -> Term -> Term
selectorParamLams [] body = body
selectorParamLams ((paramName, paramRig) :: rest) body =
  TLam paramName paramRig Nothing spanEmpty (selectorParamLams rest body)

-- 签名项是否以隐式 Pi 开头并最终落到值（{a : Type} -> Result a）；显式 Pi 不算。
export allImplicitPrefix : Term -> Bool
allImplicitPrefix (TPi n implicit rig dom cod) = implicit && allImplicitPrefix cod
allImplicitPrefix _ = True

-- 实例化全隐式前缀：逐个插元变量，得到「值 + 剩余值类型」。
export instantiateAllImplicit : Ctx -> Ec -> Term -> Value -> List (Term, Rig) -> (Term, Value, Ec)
instantiateAllImplicit ctx ec head ty acc = instantiateAllImplicitFuel 64 ctx ec head ty acc

export instantiateAllImplicitFuel : Int -> Ctx -> Ec -> Term -> Value -> List (Term, Rig) -> (Term, Value, Ec)
instantiateAllImplicitFuel fuel ctx ec head ty acc =
  if fuel <= 0 then
    (foldAppTerms head (reverse acc), ty, ec)
  else
    case forceVal ec ty of
      VPi name implicit rig dom clo =>
        if implicit then
          let
            m = ecNext ec
          in case newMeta ctx ec of
            (mt, ec1) => instantiateAllImplicitFuel (fuel - 1) ctx ec1 head (applyClosure clo (VMeta m [])) ((mt, rig) :: acc)
        else
          (foldAppTerms head (reverse acc), ty, ec)
      _ => (foldAppTerms head (reverse acc), ty, ec)

-- where 块（parser 的 `ELet .. True`）要求每个绑定都有签名行；普通 `let` 的签名可选。
-- 两者共用同一套绑定块模型（parser 的 `bindingItemsToBinds`），这里只收口「是否强制」，
-- 使 check/infer 两条 let 路径不再各自重复这一段分支。
export checkBindingSigs : Bool -> List (Pat, Expr) -> Check Int
checkBindingSigs True binds = checkWhereSigs binds
checkBindingSigs False binds = OkC 0

export checkWhereSigs : List (Pat, Expr) -> Check Int
checkWhereSigs [] = OkC 0
checkWhereSigs (bnd :: rest) =
  case secondOf bnd of
    EAnn value ty annSp => checkWhereSigs rest
    _ =>
      let
        name = whereBindingName (firstOf bnd)
      in tcErr2 (patSpan (firstOf bnd)) (WhereNeedsSig name name) name name

export whereBindingName : Pat -> String
whereBindingName (PVar name sp) = name
whereBindingName _ = "_"

-- | 逐条未处理 effect 挂 `unhandled:` 字段。
export withEffectLabels : List String -> Diagnostic -> Diagnostic
withEffectLabels [] d = d
withEffectLabels (l :: rest) d = withEffectLabels rest (withField (FieldEffect "unhandled: ${l}") d)
