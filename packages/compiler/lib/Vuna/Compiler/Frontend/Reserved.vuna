-- | 保留 / 合成名的编码：`@vuna@...` 保留命名空间与编译器合成的 `#...` 名。
--
-- 这是名字编码的**唯一真源**（`Frontend.Ast` 与 `Frontend.Rast` 都重导出本模块；
-- 两套 AST 的 `Expr` / `Pat` / `Decl` 形状各自独立，只有这里的名字编码共享）。
module Vuna.Compiler.Frontend.Reserved where

import Vuna.Compiler.Base.Common

-- ---------------------------------------------------------------
-- 洞名：匿名洞是 `_`；命名洞写成 `?name`。
-- parser 把 `?name` 编码成 `EVar "?name"`（**不新增 AST 构造子**，Fmt/Lint/Doc/Usage/
-- Termination/Codegen 的结构遍历因此零改动）；洞名判定是唯一真源，Loader 放行、
-- 精化器建 goal、索引引用过滤都走这里。
-- ---------------------------------------------------------------
export isHoleName : String -> Bool
isHoleName name = name == "_" || holeNamed name

export holeNamed : String -> Bool
holeNamed name =
  case strUnpack name of
    63 :: _ :: _ => True
    _ => False

-- 洞的显示名：`_` → ""（匿名）；`?name` → "?name"。
export holeNameOf : String -> String
holeNameOf name = if holeNamed name then name else ""

-- ---------------------------------------------------------------
-- `@vuna@` 保留命名空间
-- ---------------------------------------------------------------
-- 与 `?hole` 同一先例：不新增 AST 构造子，用保留名编码，Fmt/Lint/Doc/Index 等
-- parse 阶段的结构遍历因此零改动（这些名字只在 Loader 之后出现，且不参与用户符号）。
--   `@vuna@ctor@<短名>@<候选 canonical 1>@<候选 canonical 2>...`
--
-- 卫生性靠**字符集不相交**：lexer 只在 `@vuna@` 前缀之后把 `@` 收进标识符
-- （`Frontend.Lexer.startsWithVunaAt`），普通用户标识符不可能意外落进这个空间。
-- 引用侧另有一道门（不是能力系统）：`Loader.Resolve` 只放行 parser 合成的标记与
-- `Base.*` / `Vuna.*` 模块（`Rast.Name.isCompilerModulePrefix`），普通包写 `@vuna@…`
-- 会报 `RN_UnknownVariable`；`packages/base` 因此可以直调宿主原语。
-- | 内部保留名的前缀（`@vuna@`）。
export internalNamePrefix : String
internalNamePrefix = "@vuna@"

-- | 重载构造子标记前缀（`@vuna@ctor@`）。
export overCtorPrefix : String
overCtorPrefix = "@vuna@ctor@"

-- | 是否是内部保留名（以 `@vuna@` 开头）。
export isInternalSyntaxName : String -> Bool
isInternalSyntaxName name = startsWith internalNamePrefix name

-- | 丢掉列表前 n 个元素。
export dropNChars : Int -> List Int -> List Int
dropNChars n xs =
  if n <= 0 then
    xs
  else
    case xs of
      [] => []
      _ :: rest => dropNChars (n - 1) rest

-- | 去掉字符串前缀（不匹配则原样返回）。
export dropNamePrefix : String -> String -> String
dropNamePrefix p name =
  if startsWith p name then strPack (dropNChars (strLength p) (strUnpack name)) else name

-- | 用 `@` 连接多个名字。
export joinWithAt : List String -> String
joinWithAt [] = ""
joinWithAt ([x]) = x
joinWithAt (x :: rest) = "${x}@${joinWithAt rest}"

-- | 由短名与候选 target 生成重载构造子标记名。
export overCtorName : String -> List String -> String
overCtorName short targets = "${overCtorPrefix}${short}@${joinWithAt targets}"

-- | 重载构造子标记名里的短名（非标记名返回空串）。
export overCtorShort : String -> String
overCtorShort name =
  case splitOnChar 64 (dropNamePrefix overCtorPrefix name) of
    [] => ""
    s :: rest => s

-- | 重载构造子标记名里的候选 target 列表（非标记名返回空表）。
export overCtorTargets : String -> List String
overCtorTargets name =
  case splitOnChar 64 (dropNamePrefix overCtorPrefix name) of
    [] => []
    s :: rest => rest

-- | 是否是重载构造子标记名。
export isOverCtorName : String -> Bool
isOverCtorName name = startsWith overCtorPrefix name

-- | 重载值标记前缀（`@vuna@value@`）：多个不同 target 的值候选，由精化器按期望类型选择。
export overValuePrefix : String
overValuePrefix = "@vuna@value@"

export overValueName : String -> List String -> String
overValueName short targets = "${overValuePrefix}${short}@${joinWithAt targets}"

export overValueShort : String -> String
overValueShort name =
  case splitOnChar 64 (dropNamePrefix overValuePrefix name) of
    [] => ""
    s :: rest => s

export overValueTargets : String -> List String
overValueTargets name =
  case splitOnChar 64 (dropNamePrefix overValuePrefix name) of
    [] => []
    s :: rest => rest

export isOverValueName : String -> Bool
isOverValueName name = startsWith overValuePrefix name

-- 列表字面量的保留名（parser 产出；Loader 原样放行；Elab 按期望族的 Nil/Cons
-- 通用展开）。不借裸 `Nil`/`Cons` 走构造子名字解析。
-- | 列表字面量展开出的 nil 保留名。
export listNilSyntax : String
listNilSyntax = "@vuna@list@nil"

-- | 列表字面量展开出的 cons 保留名。
export listConsSyntax : String
listConsSyntax = "@vuna@list@cons"

-- | 是否是列表 nil 保留名。
export isListNilSyntax : String -> Bool
isListNilSyntax name = name == listNilSyntax

-- | 是否是列表 cons 保留名。
export isListConsSyntax : String -> Bool
isListConsSyntax name = name == listConsSyntax

-- 元组与 unit 的保留名（parser 产出；Loader 改写成 `Pair` / `Unit` / `MkUnit` 后走名字解析，
-- 因此元组语法要求这些名字在作用域里）。`(a, b, c)` 右嵌套成两个 pair。
-- | 元组 pair 的保留名。
export tuplePairSyntax : String
tuplePairSyntax = "@vuna@tuple@pair"

-- | 是否是元组 pair 保留名。
export isTuplePairSyntax : String -> Bool
isTuplePairSyntax name = name == tuplePairSyntax

-- | unit `()` 的保留名（类型位置展开成 `Unit`，表达式 / 模式位置展开成 `MkUnit`）。
export tupleUnitSyntax : String
tupleUnitSyntax = "@vuna@tuple@unit"

-- | 是否是 unit `()` 保留名。
export isTupleUnitSyntax : String -> Bool
isTupleUnitSyntax name = name == tupleUnitSyntax

-- 表达式类型标注 `(e : T)`：parser 编码成
-- `EApp (EVar "@vuna@ascribe") [e, T]`，Loader 改写成 `EAnn e T`（与 where 签名同一条精化路径）。
-- | 类型标注 `(e : T)` 的保留名（parser 产出、Loader 改写）。
export ascribeSyntax : String
ascribeSyntax = "@vuna@ascribe"

-- | 是否是类型标注保留名。
export isAscribeSyntax : String -> Bool
isAscribeSyntax name = name == ascribeSyntax

-- ---------------------------------------------------------------
-- do 块的内部标记链
-- ---------------------------------------------------------------
-- 与 `@vuna@ctor@...` 同一先例：不新增 AST 构造子，用保留名编码。`Resolver` 把 do 降级
-- 成嵌套的 `EApp+ELam` 链（语句边界 / binder 名 / 语句 span 都仍编码在这条链上），但把每个
-- 节点的头部换成携带 **块作用域里解析出的 bind canonical 名** 的内部标记：
--
--   `@vuna@do@bind@<canonical>`    —— `pat <- e`（binder 是用户变量名）
--   `@vuna@do@ignore@<canonical>`  —— `_ <- e` / 裸语句 `e`（binder 是丢弃名）
--
-- 标记名只由 Loader 在 rename 之后产生，普通标识符不可能与它同形；于是
-- Elab 可以把整块按「一个 monad / 一个字典」精化，而不必逐个节点重新做名字解析。不认识
-- 标记的精化器（以及任何形状不符/回退路径）可以剥掉标记、用 canonical 名还原成普通
-- `bind` 应用——语义与今天的降级逐字一致。
-- `perform <op>` 的保留名编码。parser 产出
-- `EApp (EVar "@vuna@perform") [op]`；Elab 按 op 族推导 key（族规范名）、实例名
-- （行解 / 默认名）与效应签名（`sigFn (\i => <Op> <params…> i)`），再降级到 `Base.Effect.Core.performCore`。
-- 标记名落在 `@vuna@` 保留命名空间里，不会与普通用户标识符冲突。
-- | `perform <op>` 的保留名（parser 产出、Elab 展开）。
export performSyntax : String
performSyntax = "@vuna@perform"

-- | 是否是 `perform` 保留名。
export isPerformSyntax : String -> Bool
isPerformSyntax name = name == performSyntax

-- `handle <comp> { ... }` 的保留名编码。parser 产出
-- `EApp (EVar "@vuna@handle") [comp, ret, opH]`：
--   * `comp` 是被 handler 包裹的动作；
--   * `ret` 是 `ELam [x] body`；没有 return 子句时是哨兵 `EVar "@vuna@handle@noret"`
--     （Fmt 据此不打印 return 子句）；
--   * `opH` 是 `ELam [o, k] (ECase (EVar o) alts)`：每个 alt 的 pattern 只含构造子实参，
--     续延 binder `k` 是 λ 的第二个参数（同一 handle 块的所有 op 子句共用这个名字）。
-- Elab 从 clause 构造子推 op 族，再降级到 `Base.Effect.Core.handleWith`。
-- | `handle <comp> { ... }` 的保留名（parser 产出、Elab 展开）。
export handleSyntax : String
handleSyntax = "@vuna@handle"

-- | 是否是 `handle` 保留名。
export isHandleSyntax : String -> Bool
isHandleSyntax name = name == handleSyntax

-- | 无 return 子句时的哨兵名（Fmt 据此不打印 return 子句）。
export handleNoRetSyntax : String
handleNoRetSyntax = "@vuna@handle@noret"

-- | 是否是无 return 子句的哨兵名。
export isHandleNoRetSyntax : String -> Bool
isHandleNoRetSyntax name = name == handleNoRetSyntax

-- 行字面量里的显式实例名 `X@name`，编码成
-- `EApp (EVar "@vuna@row@at") [X, name]`；只在行字面量展开时被解释。
-- | 行字面量里 `X@name` 的保留名（Elab 在行展开时解释）。
export rowAtSyntax : String
rowAtSyntax = "@vuna@row@at"

-- | 是否是行实例名标记名。
export isRowAtSyntax : String -> Bool
isRowAtSyntax name = name == rowAtSyntax

-- 实例名调用糖：`f@name args` 编码成
-- `EApp (EVar "@vuna@app@at") (f :: name :: args)`。Elab 把它重写成
-- `f (@vuna@inst@arg name) args`，由 `inferArgsGo` 在隐式 `String` 实例名 binder
-- 处消费 `@vuna@inst@arg`。
export appAtSyntax : String
appAtSyntax = "@vuna@app@at"

-- | 是否是实例名调用标记（`@vuna@app@at`）。
export isAppAtSyntax : String -> Bool
isAppAtSyntax name = name == appAtSyntax

-- `@` 降级后插入的隐式实参标记：`EApp (EVar "@vuna@inst@arg") [payload]`。
-- 只在 `inferArgsGo` 的隐式 String binder 分支被消费；源码只能经 `f@name` 糖产生。
export instArgSyntax : String
instArgSyntax = "@vuna@inst@arg"

-- | 是否是实例名实参标记（`@vuna@inst@arg`）。
export isInstArgSyntax : String -> Bool
isInstArgSyntax name = name == instArgSyntax

-- ---------------------------------------------------------------
-- 内置宏：`name!` 调用的保留名编码
-- ---------------------------------------------------------------
-- 与 `@vuna@perform` / `@vuna@handle` 同一先例：**不新增 AST 构造子**，parser 把
-- `name! args` 编码成 `EApp (EVar "@vuna@macro@name") args`（无参时是裸 `EVar`）。
-- Loader 在名字解析前把标记展开成真正表达式，所以 Elab / Codegen / 缓存 / 无损 CST
-- 都看不到标记；Fmt 反向把标记渲染回 `name!`，Index 过滤标记引用。标记落在 `@vuna@`
-- 保留命名空间里，不会与普通用户标识符冲突。
-- | 宏调用标记的前缀（parser 产出、Loader 展开、Fmt 回渲染共用的唯一真源）。
export macroSyntaxPrefix : String
macroSyntaxPrefix = "@vuna@macro@"

-- | 由宏名生成 parser / Loader 之间的标记名。
export macroSyntaxName : String -> String
macroSyntaxName name = "${macroSyntaxPrefix}${name}"

-- | 是否是宏调用标记名（`@vuna@macro@<name>`）。
export isMacroSyntaxName : String -> Bool
isMacroSyntaxName name = startsWith macroSyntaxPrefix name

-- | 宏调用标记名 → 用户书写的宏名（非标记返回 `Nothing`）。
export macroNameOf : String -> Maybe String
macroNameOf name =
  if isMacroSyntaxName name then Just (dropNamePrefix macroSyntaxPrefix name) else Nothing

-- | do 链里 `pat <- e` 标记头的前缀。
export doBindSyntaxPrefix : String
doBindSyntaxPrefix = "@vuna@do@bind@"

-- | do 链里丢弃绑定（`_ <- e` / 裸语句）标记头的前缀。
export doIgnoreSyntaxPrefix : String
doIgnoreSyntaxPrefix = "@vuna@do@ignore@"

-- | 由 bind 的 canonical 名生成 `pat <- e` 标记头。
export doBindSyntaxName : String -> String
doBindSyntaxName canonical = "${doBindSyntaxPrefix}${canonical}"

-- | 由 bind 的 canonical 名生成丢弃绑定标记头。
export doIgnoreSyntaxName : String -> String
doIgnoreSyntaxName canonical = "${doIgnoreSyntaxPrefix}${canonical}"

-- | 是否是 `pat <- e` 标记头。
export isDoBindSyntaxName : String -> Bool
isDoBindSyntaxName name = startsWith doBindSyntaxPrefix name

-- | 是否是丢弃绑定标记头。
export isDoIgnoreSyntaxName : String -> Bool
isDoIgnoreSyntaxName name = startsWith doIgnoreSyntaxPrefix name

-- 标记头里的 canonical bind 名；不是 do 标记头返回 `Nothing`。
-- | do 标记头里的 canonical bind 名；不是标记头返回 `Nothing`。
export doSyntaxCanonical : String -> Maybe String
doSyntaxCanonical name =
  if isDoBindSyntaxName name then
    Just (dropNamePrefix doBindSyntaxPrefix name)
  else if isDoIgnoreSyntaxName name then
    Just (dropNamePrefix doIgnoreSyntaxPrefix name)
  else
    Nothing

-- 一般模式绑定（`Pair a b <- e`）降级时引入的中间 binder 名：模式拆解在续延里用
-- `case <该名> of pat => 后续语句` 完成。这个名字落在 `@vuna@` 保留命名空间里，
-- 不会与用户 binder 冲突。
-- | 模式绑定降级时的中间 binder 名（Loader 产出）。
export doPatternBinderName : String
doPatternBinderName = "@vuna@do@pat"

-- ---------------------------------------------------------------
-- 编译器合成的 `#` 名
-- ---------------------------------------------------------------
-- 与 `@vuna@` 的分工：`@vuna@` 是源码可出现的保留命名空间；`#` 开头的名字**不可能来自
-- 源码**（`#` 既不是标识符起始字符也不是运算符字符，源码里是词法错误），只由 Loader /
-- Elab 合成，用于会进 codegen 的 binder / 全局：
--   * 这些名字不参与用户符号与 iface，也不会被 Fmt / Index 当成用户名；
--   * 名字里的数字只用于同一定义内去重，**不是身份**（身份由 binder id / `dtInstKey` 承担）。
-- | 编译器合成名的前缀（`#`）。
export synthNamePrefix : String
synthNamePrefix = "#"

-- | 是否是编译器合成的 `#` 名。
export isSynthName : String -> Bool
isSynthName name = startsWith synthNamePrefix name

-- | section 展开成 lambda 时的 binder 名（`Loader/Fixity`）。
export sectionBinderName : String
sectionBinderName = "#section"

-- | 自由字典目标的 binder 名（`Elab/Trait`）；编号是定义内组序号，只用于去重。
export dictBinderName : Int -> String
dictBinderName k = "#dict${strFromInt k}"

-- | 构造子 η 展开的形参名（`Elab/Meta`）；编号在同一个 lambda 链内唯一。
export etaBinderName : Int -> String
etaBinderName i = "#eta${strFromInt i}"

-- | 实例头规范化里的占位 tele 变量名（`Elab/InstCoherence`）：只参与 alpha 归一。
export teleProbeBinderName : String
teleProbeBinderName = "#tele"

-- | 实例头规范化里的占位 global 名（`Elab/InstCoherence`）：只参与 alpha 归一。
export ovProbeName : Int -> String
ovProbeName i = "#ov${strFromInt i}"
