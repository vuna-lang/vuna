-- | 保留 / 合成名的编码：`@vuna@...` 保留命名空间与编译器合成的 `#...` 名。
--
-- 这是名字编码的**唯一真源**（`Frontend.Ast` 重导出本模块；
-- 两套 AST 的 `Expr` / `Pat` / `Decl` 形状各自独立，只有这里的名字编码共享）。
module Vuna.Compiler.Frontend.Reserved where

import Vuna.Compiler.Base.Common

-- ---------------------------------------------------------------
-- 洞名：匿名洞是 `_`；命名洞写成 `?name`。
-- parser 把 `?name` 编码成 `EVar "?name"`（**不新增 AST 构造子**，Fmt/Lint/Doc/Usage/
-- Termination/Codegen 的结构遍历因此零改动）；洞名判定是唯一真源，Loader 放行、
-- 精化器建 goal、索引引用过滤都走这里。
-- ---------------------------------------------------------------
export isHoleName : String -> Bool
isHoleName name = name == "_" || holeNamed name

export holeNamed : String -> Bool
holeNamed name =
  case strUnpack name of
    63 :: _ :: _ => True
    _ => False

-- 洞的显示名：`_` → ""（匿名）；`?name` → "?name"。
export holeNameOf : String -> String
holeNameOf name = if holeNamed name then name else ""

-- ---------------------------------------------------------------
-- `@vuna@` 保留命名空间
-- ---------------------------------------------------------------
-- 卫生性靠**字符集不相交**：lexer 只在 `@vuna@` 前缀之后把 `@` 收进标识符
-- （`Frontend.Lexer.startsWithVunaAt`），普通用户标识符不可能意外落进这个空间。
-- 引用侧另有一道门（不是能力系统）：`Loader.Resolve` 放行 `classify` 认出的表面
-- 标记与 `Base.*` / `Vuna.*` / `Obs.*` 模块（`Frontend.Name.isCompilerModulePrefix`），
-- 普通包写 `@vuna@…` 会报 `RN_UnknownVariable`；标准库与第一方观测库因此可以直调。
-- | 内部保留名的前缀（`@vuna@`）。
export internalNamePrefix : String
internalNamePrefix = "@vuna@"

-- | 是否是内部保留名（以 `@vuna@` 开头，含内建 / 原语 / 合成名）。
export isInternalSyntaxName : String -> Bool
isInternalSyntaxName name = startsWith internalNamePrefix name

-- ---------------------------------------------------------------
-- 表面语法糖标记：线上字符串 ↔ `Reserved`
-- ---------------------------------------------------------------
-- 每个表面标记有一个构造子。`reservedText` / `classify` 是唯一一对编解码：
--   * AST / canonical hash / cache / iface 仍然只传字符串（跨进程与跨 seed 的格式）；
--   * 两者都没有通配分支：新增构造子会让 `reservedText` **和** `classify` 同时编译失败，
--     标记表不会只更新一半；
--   * 载荷（宏名 / do 的 canonical bind / 重载候选）是构造子字段，调用方不再各自
--     切字符串。
-- 分类只覆盖表面糖；内建 / 原语 / 合成名（`@vuna@Cell`、`@vuna@prim_eff_*`、
-- `@vuna@cell@x` …）仍是 `isInternalSyntaxName` 的宽命名空间，不属于这里。
export data Reserved(..) : Type where
  -- 列表字面量 `[]` / `[a, b]`：Elab 按期望族的 `Nil` / `(::)` 通用展开。
  RsListNil : Reserved
  RsListCons : Reserved
  -- 元组 `(a, b)` 与 unit `()`：Loader 改写成 `Pair` / `MkUnit` / `Unit` 后走名字解析。
  RsTuplePair : Reserved
  RsTupleUnit : Reserved
  -- 类型标注 `(e : T)`：parser 保持 `@vuna@ascribe` 应用，由 Elab 在应用处按标注类型检查。
  RsAscribe : Reserved
  -- `perform <op>`：Elab 推导 key / 实例名 / 效应签名后降级到 `performCore`。
  RsPerform : Reserved
  -- `handle <comp> { ... }`：`EApp [comp, ret, opH]`。
  RsHandle : Reserved
  -- 无 return 子句时 handle 的 ret 位哨兵（Fmt 据此不打印 return 子句）。
  RsHandleNoRet : Reserved
  -- 行字面量里的 `X@name`。
  RsRowAt : Reserved
  -- 实例名调用糖 `f@name args`。
  RsAppAt : Reserved
  -- `@` 降级后插入的隐式实参标记：只在隐式 String 实例名 binder 处消费。
  RsInstArg : Reserved
  -- 重载构造子标记：短名 + 候选 canonical target。
  RsOverCtor : String -> List String -> Reserved
  -- 重载值标记：短名 + 候选 canonical target。
  RsOverValue : String -> List String -> Reserved
  -- 内置宏调用 `name!`。
  RsMacro : String -> Reserved
  -- do 链 `pat <- e` 的标记头：携带块作用域里解析出的 bind canonical 名。
  RsDoBind : String -> Reserved
  -- do 链丢弃绑定（`_ <- e` / 裸语句）的标记头。
  RsDoIgnore : String -> Reserved
  -- 字段选择器 `R.f`：记录 canonical 名 + 字段名；Loader 在模块名解析失败后合成。
  RsFieldSel : String -> String -> Reserved

-- 线上编码的原子段；只在 `reservedText` / `classify` 各引用一次。
rsListNilText : String
rsListNilText = "@vuna@list@nil"

rsListConsText : String
rsListConsText = "@vuna@list@cons"

rsTuplePairText : String
rsTuplePairText = "@vuna@tuple@pair"

rsTupleUnitText : String
rsTupleUnitText = "@vuna@tuple@unit"

rsAscribeText : String
rsAscribeText = "@vuna@ascribe"

rsPerformText : String
rsPerformText = "@vuna@perform"

rsHandleText : String
rsHandleText = "@vuna@handle"

rsHandleNoRetText : String
rsHandleNoRetText = "@vuna@handle@noret"

rsRowAtText : String
rsRowAtText = "@vuna@row@at"

rsAppAtText : String
rsAppAtText = "@vuna@app@at"

rsInstArgText : String
rsInstArgText = "@vuna@inst@arg"

-- 带载荷形态的前缀。
rsOverCtorPrefix : String
rsOverCtorPrefix = "@vuna@ctor@"

rsOverValuePrefix : String
rsOverValuePrefix = "@vuna@value@"

rsMacroPrefix : String
rsMacroPrefix = "@vuna@macro@"

rsDoBindPrefix : String
rsDoBindPrefix = "@vuna@do@bind@"

rsDoIgnorePrefix : String
rsDoIgnorePrefix = "@vuna@do@ignore@"

rsFieldSelPrefix : String
rsFieldSelPrefix = "@vuna@select@"

-- | 表面标记 → 线上字符串。
export reservedText : Reserved -> String
reservedText RsListNil = rsListNilText
reservedText RsListCons = rsListConsText
reservedText RsTuplePair = rsTuplePairText
reservedText RsTupleUnit = rsTupleUnitText
reservedText RsAscribe = rsAscribeText
reservedText RsPerform = rsPerformText
reservedText RsHandle = rsHandleText
reservedText RsHandleNoRet = rsHandleNoRetText
reservedText RsRowAt = rsRowAtText
reservedText RsAppAt = rsAppAtText
reservedText RsInstArg = rsInstArgText
reservedText (RsOverCtor short targets) = "${rsOverCtorPrefix}${short}@${joinWithAt targets}"
reservedText (RsOverValue short targets) = "${rsOverValuePrefix}${short}@${joinWithAt targets}"
reservedText (RsMacro name) = "${rsMacroPrefix}${name}"
reservedText (RsDoBind canonical) = "${rsDoBindPrefix}${canonical}"
reservedText (RsDoIgnore canonical) = "${rsDoIgnorePrefix}${canonical}"
reservedText (RsFieldSel recName fldName) = "${rsFieldSelPrefix}${recName}@${fldName}"

-- | 线上字符串 → 表面标记（不是表面标记给 `Nothing`）。
export classify : String -> Maybe Reserved
classify name =
  if name == rsListNilText then
    Just RsListNil
  else if name == rsListConsText then
    Just RsListCons
  else if name == rsTuplePairText then
    Just RsTuplePair
  else if name == rsTupleUnitText then
    Just RsTupleUnit
  else if name == rsAscribeText then
    Just RsAscribe
  else if name == rsPerformText then
    Just RsPerform
  else if name == rsHandleText then
    Just RsHandle
  else if name == rsHandleNoRetText then
    Just RsHandleNoRet
  else if name == rsRowAtText then
    Just RsRowAt
  else if name == rsAppAtText then
    Just RsAppAt
  else if name == rsInstArgText then
    Just RsInstArg
  else if startsWith rsOverCtorPrefix name then
    case overParts rsOverCtorPrefix name of
      Just (short, targets) => Just (RsOverCtor short targets)
      Nothing => Nothing
  else if startsWith rsOverValuePrefix name then
    case overParts rsOverValuePrefix name of
      Just (short, targets) => Just (RsOverValue short targets)
      Nothing => Nothing
  else if startsWith rsMacroPrefix name then Just (RsMacro (dropNamePrefix rsMacroPrefix name)) else if startsWith rsDoBindPrefix name then Just (RsDoBind (dropNamePrefix rsDoBindPrefix name)) else if startsWith rsDoIgnorePrefix name then Just (RsDoIgnore (dropNamePrefix rsDoIgnorePrefix name)) else if startsWith rsFieldSelPrefix name then fieldSelParts name else Nothing

-- | 字段选择器标记的 `<记录>@<字段>` 段 → （记录名，字段名）。
fieldSelParts : String -> Maybe Reserved
fieldSelParts name =
  case splitOnChar 64 (dropNamePrefix rsFieldSelPrefix name) of
    [recName, fldName] =>
      if recName == "" || fldName == "" then Nothing else Just (RsFieldSel recName fldName)
    _ => Nothing

-- | 重载标记的 `<短名>@<target>@...` 段 → 短名 + 候选（尾随分隔符的空段折叠掉）。
overParts : String -> String -> Maybe (String, List String)
overParts prefix name =
  case splitOnChar 64 (dropNamePrefix prefix name) of
    [] => Nothing
    short :: targets => Just (short, dropEmpty targets)

-- | 只由 parser 在源码层合成的表面标记（Loader 对普通包放行的白名单）。
-- 其余形态只在编译器包内可见：`@vuna@ctor@…` / `@vuna@value@…` 能指定任意 canonical
-- target，`@vuna@do@…` 只在 rename 后出现。
-- 无通配分支：新增标记必须在这里明确「普通包能否写出它」。
export isParserSurface : Reserved -> Bool
isParserSurface RsListNil = True
isParserSurface RsListCons = True
isParserSurface RsTuplePair = True
isParserSurface RsTupleUnit = True
isParserSurface RsAscribe = True
isParserSurface RsPerform = True
isParserSurface RsHandle = True
isParserSurface RsHandleNoRet = True
isParserSurface RsRowAt = True
isParserSurface RsAppAt = True
isParserSurface RsInstArg = False
isParserSurface (RsOverCtor _ _) = False
isParserSurface (RsOverValue _ _) = False
isParserSurface (RsMacro _) = False
isParserSurface (RsDoBind _) = False
isParserSurface (RsDoIgnore _) = False
isParserSurface (RsFieldSel _ _) = False

-- | 丢掉空串（`a@b@` 的尾段是构造 `overCtorName name []` 的形态，不是候选）。
dropEmpty : List String -> List String
dropEmpty [] = []
dropEmpty (x :: rest) = if x == "" then dropEmpty rest else x :: dropEmpty rest

-- | 是否是宏调用标记（`@vuna@macro@<name>`）。
export isMacroSyntaxName : String -> Bool
isMacroSyntaxName name = startsWith rsMacroPrefix name

-- | 是否是字段选择器标记（`@vuna@select@<record>@<field>`）。
export isFieldSelText : String -> Bool
isFieldSelText name = startsWith rsFieldSelPrefix name

-- | 宏调用标记名 → 用户书写的宏名（非标记返回 `Nothing`）。
export macroNameOf : String -> Maybe String
macroNameOf name =
  case classify name of
    Just (RsMacro macro) => Just macro
    _ => Nothing

-- ---------------------------------------------------------------
-- `classify` 的窄视图（载荷直接取出）
-- ---------------------------------------------------------------
-- 只服务「以单个形态为核心的判断」；多形态分派直接 `case classify`。
-- | 是否是重载构造子标记。
export isOverCtorName : String -> Bool
isOverCtorName name =
  case classify name of
    Just (RsOverCtor _ _) => True
    _ => False

-- | 重载构造子标记的短名（非标记返回空串）。
export overCtorShort : String -> String
overCtorShort name =
  case classify name of
    Just (RsOverCtor short _) => short
    _ => ""

-- | 重载构造子标记的候选 target（非标记返回空表）。
export overCtorTargets : String -> List String
overCtorTargets name =
  case classify name of
    Just (RsOverCtor _ targets) => targets
    _ => []

-- | 是否是重载值标记。
export isOverValueName : String -> Bool
isOverValueName name =
  case classify name of
    Just (RsOverValue _ _) => True
    _ => False

-- | 重载值标记的短名（非标记返回空串）。
export overValueShort : String -> String
overValueShort name =
  case classify name of
    Just (RsOverValue short _) => short
    _ => ""

-- | 重载值标记的候选 target（非标记返回空表）。
export overValueTargets : String -> List String
overValueTargets name =
  case classify name of
    Just (RsOverValue _ targets) => targets
    _ => []

-- | do 标记头里的 canonical bind 名；不是 do 标记头返回 `Nothing`。
export doSyntaxCanonical : String -> Maybe String
doSyntaxCanonical name =
  case classify name of
    Just (RsDoBind canonical) => Just canonical
    Just (RsDoIgnore canonical) => Just canonical
    _ => Nothing

-- | 去掉字符串前缀（不匹配则原样返回）。
export dropNamePrefix : String -> String -> String
dropNamePrefix p name =
  if startsWith p name then strPack (dropNChars (strLength p) (strUnpack name)) else name

-- | 丢掉列表前 n 个元素。
export dropNChars : Int -> List Int -> List Int
dropNChars n xs =
  if n <= 0 then
    xs
  else
    case xs of
      [] => []
      _ :: rest => dropNChars (n - 1) rest

-- | 用 `@` 连接多个名字。
export joinWithAt : List String -> String
joinWithAt [] = ""
joinWithAt [x] = x
joinWithAt (x :: rest) = "${x}@${joinWithAt rest}"

-- 一般模式绑定（`Pair a b <- e`）降级时引入的中间 binder 名：模式拆解在续延里用
-- `case <该名> of pat => 后续语句` 完成。这个名字落在 `@vuna@` 保留命名空间里，
-- 不会与用户 binder 冲突。
-- | 模式绑定降级时的中间 binder 名（Loader 产出）。
export doPatternBinderName : String
doPatternBinderName = "@vuna@do@pat"

-- ---------------------------------------------------------------
-- 编译器合成的 `@vuna@` binder 名
-- ---------------------------------------------------------------
-- 只由编译器构造、不参与 `classify`：它们不是表面糖标记，只是进 AST / 进 codegen 的
-- 名字。集中在类型 / 句柄 / 记录 / 宏的合成点上，避免同一个名字在多处手写。
-- | `handle` op λ 的 op 形参名。
export handleOpBinderName : String
handleOpBinderName = "@vuna@handle@o"

-- | `handle` op λ 的结果索引形参名。
export handleOpIndexBinderName : String
handleOpIndexBinderName = "@vuna@handle@ix"

-- | handle 降级后效应签名的 binder 名。
export handleSigBinderName : String
handleSigBinderName = "@vuna@handle@sig"

-- | handle 默认 return 子句的 binder 名。
export handleRetBinderName : String
handleRetBinderName = "@vuna@handle@ret"

-- | 记录降级时字段投影的 binder 名。
export recordProjBinderName : Int -> String
recordProjBinderName i = "@vuna@record@proj${strFromInt i}"

-- | 记录降级时字段形参的 binder 名。
export recordArgBinderName : Int -> String
recordArgBinderName i = "@vuna@record@arg${strFromInt i}"

-- | 记录降级时隐藏字段字典的 binder 名。
export recordHiddenFieldBinderName : Int -> String
recordHiddenFieldBinderName i = "@vuna@record@hf${strFromInt i}"

-- ---------------------------------------------------------------
-- 编译器合成的 `#` 名
-- ---------------------------------------------------------------
-- 与 `@vuna@` 的分工：`@vuna@` 是源码可出现的保留命名空间；`#` 开头的名字**不可能来自
-- 源码**（`#` 既不是标识符起始字符也不是运算符字符，源码里是词法错误），只由 Loader /
-- Elab 合成，用于会进 codegen 的 binder / 全局：
--   * 这些名字不参与用户符号与 iface，也不会被 Fmt / Index 当成用户名；
--   * 名字里的数字只用于同一定义内去重，**不是身份**（身份由 binder id / `dtInstKey` 承担）。
-- | 编译器合成名的前缀（`#`）。
export synthNamePrefix : String
synthNamePrefix = "#"

-- | 是否是编译器合成的 `#` 名。
export isSynthName : String -> Bool
isSynthName name = startsWith synthNamePrefix name

-- | section 展开成 lambda 时的 binder 名（`Loader/Fixity`）。
export sectionBinderName : String
sectionBinderName = "#section"

-- | 自由字典目标的 binder 名（`Elab/Trait`）；编号是定义内组序号，只用于去重。
export dictBinderName : Int -> String
dictBinderName k = "#dict${strFromInt k}"

-- | 构造子 η 展开的形参名（`Elab/Meta`）；编号在同一个 lambda 链内唯一。
export etaBinderName : Int -> String
etaBinderName i = "#eta${strFromInt i}"

-- | 实例头规范化里的占位 tele 变量名（`Elab/InstCoherence`）：只参与 alpha 归一。
export teleProbeBinderName : String
teleProbeBinderName = "#tele"

-- | 实例头规范化里的占位 global 名（`Elab/InstCoherence`）：只参与 alpha 归一。
export ovProbeName : Int -> String
ovProbeName i = "#ov${strFromInt i}"
