module Vuna.Compiler.Frontend.Parser.Support where

-- Vuna.Compiler.Frontend.Parser.Support：parser 的状态类型（PState）与 token/游标
-- 辅助（lookahead、advance、span、fuel、infix 表、token 分类）。解析规则留在
-- `Parser.vuna`；拆出本模块是为满足 `nix/checks/data/context.budget` 的 max_module_lines。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Base.Diagnostics.Frontend

-- | 解析模式。决定「语义级语法错误」是否致命：
--   * `PmStrict`：编译器路径。非线性格（重复 binder）等**语法层被借用的语义检查**
--     直接失败——没有相等约束，放过去会让精化器静默改名；
--   * `PmTool`：fmt / lint / index / doc / LSP 这类只读工具。它们要的是「语法完好
--     就能拿到 AST」，语义问题留给诊断，不该让整个文件不可用。
export data ParseMode(..) : Type where
  PmStrict : ParseMode
  PmTool : ParseMode

-- 末尾 `toksLeft` 是余下 token 数（O(1) 维护）：`stateFuel` 在每个声明/表达式循环
-- 入口都被调用，若每次都遍历剩余 token 列表，大文件解析就退化成 O(n²)。
-- `tokIndex` 是当前 head token 的**绝对**下标（`advance` 与 `recoverDecl` 各前进一步，
-- 都是 O(1)），建树事件的区间用它表达。
-- `pendEvents` 是逆序累积的建树事件：parser 在自己的递归点 open / close，
-- 区间由它的栈配对，所以事件流天然真嵌套（见 [Vuna.Compiler.Frontend.Cst.nestToTree]）。
export record PState(..) where
  fileOf : String
  toksOf : List PTok
  lastPos : Pos
  toksLeft : Int
  pmodeOf : ParseMode
  tokIndex : Int
  pendEvents : List NodeEvent
  -- | 下一个语法节点 id。parser 在 `withExtent` 处分配（文件根 0，节点从 1 起），
  -- 建树事件与 AST 的 `NodeRef` 用同一个值。
  nextNodeId : Int
  -- | 最近一次 `withExtent` 打开的节点 id。wrapper 在 body 入口读它，把 id 交给
  -- 声明构造；嵌套的 `withExtent` 会覆盖，但只在入口读一次，不会串。
  openNodeId : Int
  -- | 是否是独立 token 流（模板洞）：子流的 token 下标与主文件不相交，树也不会收它的
  -- 事件，所以这里不分配节点 id（`withExtent` 一律用 -1），AST 侧就是「无身份」。
  subStream : Bool

-- ---------------------------------------------------------------
-- vuna 源码 parser（offside layout）
-- ---------------------------------------------------------------
export fileOf : PState -> String
fileOf st = st.fileOf

-- | 解析模式（`PmStrict` / `PmTool`），见 `ParseMode`。
export pmodeOf : PState -> ParseMode
pmodeOf st = st.pmodeOf

-- | 从文件头开一个状态（`lastPos` 的 `Pos 1 0` 是「尚未消费 token」的哨兵）。
export mkState : String -> List PTok -> ParseMode -> PState
mkState file toks mode = PState file toks (Pos 1 0 0 0) (length toks) mode 0 [] 1 0 False

-- | 指定 `lastPos` / 剩余数（模板洞、同一行的裸表达式等场景）。
-- 建树事件在模板洞内单独收集（洞内 token 的绝对下标从 0 起，与外层不相交）。
export mkStateAt : String -> List PTok -> Pos -> Int -> ParseMode -> PState
mkStateAt file toks last count mode = PState file toks last count mode 0 [] 1 0 True

-- | 从起始状态到结束状态的建树事件（按发生顺序；每次事件一次 cons）。
export eventsOf : PState -> PState -> List NodeEvent
eventsOf st st2 = reverse (st2.pendEvents)

-- | 在一个节点区间里跑一段解析：入口发 open、成功回流后发 close（区间由调用点的
-- 递归配对，所以事件流天然真嵌套）。
--
-- 失败分支不补 close 是安全的：parser 的失败路径会整段丢弃状态（`do` 语句回退、
-- `recoverDecl` 从入口状态重来、模板洞另起状态），未配对的 open 因此不会进入最终事件流。
export withExtent : {a : Type} -> CstKind -> PState -> (PState -> Check (a, PState)) -> Check (a, PState)
withExtent kind st k =
  let
    nid = if st.subStream then 0 - 1 else st.nextNodeId
    opened =
      { st
        | pendEvents = EvOpen kind st.tokIndex nid :: st.pendEvents,
        nextNodeId = if st.subStream then st.nextNodeId else nid + 1,
        openNodeId = nid
      }
  in Vuna.Compiler.Base.Common.step (k opened) (\v, st1 => OkC (v, closedAt st1))

-- | 关闭最近打开的节点：终点是当前 token 下标（半开区间）。
closedAt : PState -> PState
closedAt st = { st | pendEvents = EvClose st.tokIndex :: st.pendEvents }

-- | 只覆盖 `lastPos`：模板字面量等「一个 token 占多行」的场景在 advance 之后
-- 把结束位置补到字面量末尾，token 下标与事件栈保持不变。
export withLastPos : Pos -> PState -> PState
withLastPos p st = { st | lastPos = p }

-- | 最后一个已消费 token 的**尾后**行列偏移：单行 token 的列 = 起点列 + 字节长度
-- （多行 token 自带的 `posEndOffset` 已指向其结束位置，列不再相加）。
export lastEndCol : Pos -> Int
lastEndCol p = posCol p + (posEndOffset p - posOffset p)

-- | 从起始状态 st 到结束状态 st2 的 span：起点 = 当前 token 起点，
-- 终点 = 最后消费 token 的**末尾**（开区间）。叶子与分支用同一套约定，
-- 所以「span 的 end」就是该构造覆盖的源码末尾，不再是最后一个 token 的起点。
export spanOf : PState -> PState -> Span
spanOf st st2 =
  let
    p1 = lastPos st2
  in Span
    (fileOf st)
    (posLine (peekPos st))
    (posCol (peekPos st))
    (posLine p1)
    (lastEndCol p1)
    (posOffset (peekPos st))
    (posEndOffset p1)

-- | 用显式起点（关键字 / 名字位置）到最后一个已消费 token 末尾的 span。
export spanFromStart : String -> Pos -> PState -> Span
spanFromStart file start st =
  let
    p1 = lastPos st
  in Span
    file
    (posLine start)
    (posCol start)
    (posLine p1)
    (lastEndCol p1)
    (posOffset start)
    (posEndOffset p1)

-- | 当前 token 的完整 span（起点到 token 结束字节）。只用于单行 token（标识符 / 符号）：
-- 列按 UTF-8 字节，所以结束列 = 起始列 + token 字节长度。
export tokenSpan : PState -> Span
tokenSpan st =
  let
    p = peekPos st
    len = posEndOffset p - posOffset p
  in Span
    (fileOf st)
    (posLine p)
    (posCol p)
    (posLine p)
    (posCol p + len)
    (posOffset p)
    (posEndOffset p)

export peekTok : PState -> PTok
peekTok st =
  case st.toksOf of
    t :: _ => t
    [] => PTok TEof (Pos 1 1 0 0)

export peekPos : PState -> Pos
peekPos st = (peekTok st).ptokPos

-- | 当前 token 的**点 span**（起点=终点，caret 宽度 1）。EOF 退到最后消费的 token：
-- `peekTok` 对空流给出 `Pos 1 1`，直接拿它会指向文件头。
export tokSpan : PState -> Span
tokSpan st =
  case peekTok st of
    PTok TEof _ =>
      let
        p = lastPos st
      in Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p) (posOffset p) (posOffset p)
    PTok _ p =>
      Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p) (posOffset p) (posOffset p)

export lastPos : PState -> Pos
lastPos st = st.lastPos

export advance : PState -> PState
advance st =
  case st.toksOf of
    t :: rest =>
      case t of
        PTok TEof p => st
        _ =>
          { st
            | toksOf = rest,
            lastPos = t.ptokPos,
            toksLeft = if st.toksLeft > 0 then st.toksLeft - 1 else 0,
            tokIndex = st.tokIndex + 1
          }
    [] => st

export isEof : PState -> Bool
isEof st =
  case peekTok st of
    PTok TEof p => True
    _ => False

-- 让下一个 token 视作「与上一 token 同一行」：do 语句块里新起一行的裸表达式
-- 需要这一点，否则首 token 会被 canContinue 判成缩进不足。
-- 显式 fuel（给出证明界）：parser 的递归都经「返回新状态再递归」，
-- 递归实参是**游标状态**而不是某个形参的真子项（PState 不可分解成更小的 token 列表），
-- 所以现有 SCT 判据看不到结构下降；每个解析循环带 fuel 并在入口 `if fuel <= 0` 守卫、
-- 递归传 `fuel - 1`，「守卫 Int」判据直接接受。
--
-- **不耗尽证明**（`stateFuel = 128 * 剩余 token 数 + 1024`）：
--   1. 不变量：任一带 fuel 的调用点上，`fuel >= 16 * 剩余 token 数 + 1`；
--   2. 相邻两次 token 消费之间的 fuel 递减数 ≤ 16。逐产生式审计最长的「零 token 递减链」：
--        - 表达式原子：parseExpr→parseLhs→parseApplication→parseAtom→parseAtomBase
--          = 5 步后消费 1 token（括号/列表/记录更新再嵌套，每 token 仍 ≤ 6 步）；
--        - 中缀：parseInfix 每消费 1 个运算符 token 至多 2 步；
--        - case 分支：parseCaseAlts→parseAltList→parsePatternSingle→parsePatternCons
--          →parsePatternHead→parsePatternAtom = 6 步消费 1 token；
--        - 绑定/where/do：parseWhere→parseBindingItemsAt→parseBindingItem →
--          parseBindingDef/parseBindingValue ≈ 5 步；
--      取 16 作统一上界（真实最长链 6）；
--   3. 归纳：种子 `128*N + 1024 >= 16*N + 1`；每消费 1 token 允许 16 步递减，
--      故沿路径 `fuel` 与「16 * 剩余」的差只增不减；路径末尾（EOF）至多再走
--      一个 ≤16 步的收尾链，被 1024 的常数项覆盖。`stateFuel` 在嵌套入口重新取值时
--      也按**当前**剩余 token 数线性放大，不变量保持。
--   于是任何可由内存构造的合法输入都不会触发 `parser fuel exhausted`。
export stateFuel : PState -> Int
stateFuel st = 128 * st.toksLeft + 1024

export sameLineState : PState -> PState
sameLineState st =
  case peekPos st of
    Pos line col _ _ => { st | lastPos = Pos line 0 0 0 }

export atSym : PState -> String -> Bool
atSym st s =
  case peekTok st of
    PTok (TSym x) p => x == s
    _ => False

-- 向后看第 n 个 token（0 = 当前）。Pi binder 需要 2-token lookahead。
export nthTok : List PTok -> Int -> Maybe PTok
nthTok [] n = Nothing
nthTok (t :: rest) n = if n <= 0 then Just t else nthTok rest (n - 1)

export peekTokAt : PState -> Int -> Maybe PTok
peekTokAt st n = nthTok st.toksOf n

-- Pi binder 头：`标识符 :`、`0 标识符 :`、`1 标识符 :`（`(x : A) -> B` / `{x : A} -> B`）。
-- 多参数 trait 的探针还写 `{a b : Type} -> ...`：同一 binder 组可含多个名字，这里返回
-- 名字列表，`parsePiBinder` 展开成嵌套 EPi。
export binderHead : PState -> Maybe (Maybe Qty, List String)
binderHead st =
  case peekTok st of
    PTok (TIdent name) _ =>
      case binderNameTail (tokTail st.toksOf) [] of
        Just names => Just (Nothing, name :: names)
        Nothing => Nothing
    PTok (TInt 0) _ => quantifiedHead st Q0
    PTok (TInt 1) _ => quantifiedHead st Q1
    _ => Nothing

-- 丢掉表头一个 token（第一个 token 已由 `binderHead` / `quantifiedHead` 认出）。
tokTail : List PTok -> List PTok
tokTail [] = []
tokTail (_ :: rest) = rest

-- 从给定 token 列表起收集连续的标识符，直到 `:`；递归沿列表结构下降（无长度上限）。
binderNameTail : List PTok -> List String -> Maybe (List String)
binderNameTail [] acc = Nothing
binderNameTail (t :: rest) acc =
  case t of
    PTok (TIdent name) _ => binderNameTail rest (name :: acc)
    PTok (TSym ":") _ => Just (reverse acc)
    _ => Nothing

quantifiedHead : PState -> Qty -> Maybe (Maybe Qty, List String)
quantifiedHead st q =
  case peekTokAt st 1 of
    Just (PTok (TIdent name) _) =>
      case binderNameTail (tokTail (tokTail st.toksOf)) [] of
        Just names => Just (Just q, name :: names)
        Nothing => Nothing
    _ => Nothing

-- | `(` 之后（当前状态在开括号之后）扫描到配对的 `)`，判断紧随其后的是否 `->`。
-- 用于区分 Pi binder `(x : A) -> B` 与类型标注 `(x : A)`：binder 头只说明「有名字 + `:`」，
-- 只有闭括号后接 `->` 才是 binder。
export piArrowAhead : PState -> Bool
piArrowAhead st = piArrowAheadGo 1 st.toksOf

piArrowAheadGo : Int -> List PTok -> Bool
piArrowAheadGo depth [] = False
piArrowAheadGo depth ((PTok (TSym "(") _) :: rest) = piArrowAheadGo (depth + 1) rest
piArrowAheadGo depth ((PTok (TSym ")") _) :: rest) =
  if depth == 1 then arrowAt rest else piArrowAheadGo (depth - 1) rest
piArrowAheadGo depth (_ :: rest) = piArrowAheadGo depth rest

arrowAt : List PTok -> Bool
arrowAt ((PTok (TSym "->") _) :: _) = True
arrowAt _ = False

export atKw : PState -> String -> Bool
atKw st k =
  case peekTok st of
    PTok (TKw x) p => x == k
    _ => False

export canContinue : PState -> Int -> Bool
canContinue st blockCol =
  case peekPos st of
    Pos line col _ _ =>
      case lastPos st of
        Pos lastLine lastCol _ _ => line == lastLine || col > blockCol

-- | 消费一个符号。返回后的状态即可继续解析（旧实现返回 `Pair Int PState` 的幽灵
-- `Int`，恒为 0，已删）。
export expectSym : PState -> String -> Check PState
expectSym st s =
  case peekTok st of
    PTok (TSym x) p =>
      if x == s then OkC (advance st) else psErr1At (tokSpan st) (ExpectedToken s) s
    _ => psErr1At (tokSpan st) (ExpectedToken s) s

export expectKw : PState -> String -> Check PState
expectKw st k =
  case peekTok st of
    PTok (TKw x) p => if x == k then OkC (advance st) else psErr1At (tokSpan st) (ExpectedToken k) k
    _ => psErr1At (tokSpan st) (ExpectedToken k) k

export expectIdent : PState -> Check (String, PState)
expectIdent st =
  case peekTok st of
    PTok (TIdent x) p => OkC (x, advance st)
    _ => psErr0At (tokSpan st) ExpectedIdentifier

-- 值位置名字 = 标识符或非保留符号名。用于用户符号名 def/signature 与反引号
-- 中缀里的名字（`` a `f` b ``）。
export expectValueName : PState -> Check (String, PState)
expectValueName st =
  case peekTok st of
    PTok (TIdent x) p =>
      if isReservedValueName x then
        psErr1At (tokSpan st) (ExpectedToken "value name") "value name"
      else
        OkC (x, advance st)
    PTok (TSym op) p =>
      if isReservedValueName op then
        psErr1At (tokSpan st) (ExpectedToken "value name") "value name"
      else
        OkC (op, advance st)
    _ => psErr0At (tokSpan st) ExpectedIdentifier

export upperFirst : String -> Bool
upperFirst s =
  case strUnpack s of
    c :: rest => c >= 65 && c <= 90
    [] => False

-- `_` 前缀私有构造器（如 `_C`）在模式里也要能当构造器用：`_` 开头的标识符
-- 若紧随大写字母，按构造器解析；单独的 `_` 仍是通配符，`_x` 仍是变量。
export underscoreCtorName : String -> Bool
underscoreCtorName s =
  case strUnpack s of
    c :: rest =>
      if c == 95 then
        case rest of
          c2 :: rest2 => c2 >= 65 && c2 <= 90
          [] => False
      else
        False
    [] => False

export ctorPatternStart : String -> Bool
ctorPatternStart name = upperFirst name || underscoreCtorName name

export startsAtom : PState -> Bool
startsAtom st =
  case peekTok st of
    PTok (TIdent x) p => True
    PTok (TInt x) p => True
    PTok (TFloat x) p => True
    PTok (TStr x) p => True
    PTok (TTmpl m parts ep) p => True
    PTok (TKw "Type") p => True
    PTok (TSym "(") p => True
    PTok (TSym "[") p => True
    PTok (TSym "?") p =>
      case holeAtomAt st of
        Just _ => True
        Nothing => False
    _ => False

-- 命名洞 `?name` 的原子：`?` 与紧随的标识符**同行且列号相邻**（`?h`）。
-- 空格分隔的 `?` 仍是普通运算符（`a ? b`、`(? b)`），不受影响。
-- 返回值 = 洞名（带 `?`）+ 覆盖 `?name` 的 span（end 到名字末字节，便于 hover 高亮整个洞）。
export holeAtomAt : PState -> Maybe (String, Span)
holeAtomAt st =
  case peekTok st of
    PTok (TSym "?") p =>
      case peekTokAt st 1 of
        Just (PTok (TIdent n) p2) =>
          if posLine p2 == posLine p && posCol p2 == posCol p + 1 then
            Just
              ("?" ++ n, Span (fileOf st) (posLine p) (posCol p) (posLine p2) (posCol p2 + strLength n) (posOffset p) (posOffset p2 + strLength n))
          else
            Nothing
        _ => Nothing
    _ => Nothing

export startsPatternAtom : PState -> Bool
startsPatternAtom st =
  case peekTok st of
    PTok (TIdent x) p => True
    PTok (TInt x) p => True
    PTok (TStr x) p => True
    PTok (TTmpl m parts ep) p => True
    PTok (TSym "(") p => True
    PTok (TSym "[") p => True
    _ => False

-- 中缀解析没有固定优先级表——`infix*` 声明随模块进入 Loader，重排时才消费。
-- 这里只判定「哪些符号在表达式位置属于语法、遇到就停止」，其余 TSym 都当运算符。
export isSyntaxSym : String -> Bool
isSyntaxSym op =
  case op of
    "=" => True
    ":" => True
    "," => True
    ";" => True
    "|" => True
    "=>" => True
    "<-" => True
    "\\" => True
    "." => True
    ".." => True
    "@" => True
    -- 括号/分隔符：表达式位置出现时是语法边界，不是运算符（否则 `(a + b)` 的 `)` 会被
    -- 当成中缀符号吞掉）。
    "(" => True
    ")" => True
    "[" => True
    "]" => True
    "{" => True
    "}" => True
    _ => False

-- 保留符号名不能被当作可定义名 / 反引号名字 / 原子 section 的 op。
-- 集合 = 表达式位置的语法符号（`isSyntaxSym`）∪ {`->`, `` ` ``}。
-- `->` 是语法而非用户运算符（fixity 由 Loader.builtinFixityDecls 恒提供）；反引号是定界符。
export isReservedValueName : String -> Bool
isReservedValueName name = isSyntaxSym name || name == "->" || name == "`"

-- 右 section 判定——当前 token 是运算符、下一个 token 是 `)`。
-- 不消费 `)`：由外层 `(` 分支统一消费。
export closeParenNext : PState -> Bool
closeParenNext st =
  case peekTokAt st 1 of
    Just (PTok (TSym ")") p) => True
    _ => False

-- `(` 之后的下一个 token 若是非保留符号名，则该括号是 section
-- （`(+)` 或 `(+ e)`），返回该符号名；否则不是 section。
-- `(?h)` 里 `?` 紧邻标识符 ⇒ 是命名洞而不是 `(? h)` section。
export sectionOpAt : PState -> Maybe String
sectionOpAt st =
  case peekTokAt st 1 of
    Just (PTok (TSym op) p) =>
      if isReservedValueName op then
        Nothing
      else if op == "?" then
        case holeAtomAt (advance st) of
          Just _ => Nothing
          Nothing => Just op
      else if op == "-" && minusLiteralAt p st then Nothing else Just op
    -- `(-1)` / `(-1.5)`：`-` 与数字紧邻时是负字面量，不是 `(- 1)` section。
    _ => Nothing

minusLiteralAt : Pos -> PState -> Bool
minusLiteralAt p st =
  case peekTokAt st 2 of
    Just (PTok (TInt _) q) => posLine q == posLine p && posCol q == posCol p + 1
    Just (PTok (TFloat _) q) => posLine q == posLine p && posCol q == posCol p + 1
    _ => False

export countArrows : Expr -> Int
countArrows (EInfix "->" _ rest _) = 1 + countArrows rest
countArrows (EApp (EVar "->" _) ([x, rest]) _) = 1 + countArrows rest
countArrows _ = 0

export terminatesExpression : PTok -> Bool
terminatesExpression (PTok (TSym ")") p) = True
terminatesExpression (PTok (TSym "]") p) = True
terminatesExpression (PTok (TSym ",") p) = True
terminatesExpression (PTok (TKw "else") p) = True
terminatesExpression (PTok (TKw "in") p) = True
terminatesExpression (PTok (TKw "then") p) = True
terminatesExpression _ = False

export badCaseIndent : PState -> Int -> Bool
badCaseIndent st altCol =
  if isEof st then
    False
  else
    case peekPos st of
      Pos line col _ _ =>
        if col > altCol then
          case terminatesExpression (peekTok st) of
            True => False
            False => True
        else
          False
