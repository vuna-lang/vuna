-- | 包内容收集与摘要：目录 → `PackageSource` → （内容摘要 / 语义身份）。
module Vuna.Compiler.Frontend.Packages.Source where

-- Vuna.Compiler.Frontend.Packages.Source：包内容的**收集与摘要**（D12 的输入侧）。
--
-- 包内容集合 = `vuna.toml` + `lib/**/*.vuna` + `app/**/*.vuna` + `test/**/*.vuna`，
-- 跳过名单见 `skipSourceDir`，并额外遵守 `.gitignore`（生成物不进入包内容与摘要）。
-- 收集是显式 `Eff []`（读目录/读文件）；摘要与身份是纯函数（`Canonical.Pkg`）。
--
-- 摘要口径见 `Canonical.Pkg`：内容摘要含全部文件字节；语义身份把文件折成内容摘要、
-- 且 `path` 依赖记 `"path"`（可变输入）。两者都不含绝对路径、mtime、遍历顺序。
import Vuna.Compiler.Frontend.Canonical.Pkg
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Ignore
import Vuna.Compiler.Frontend.Manifest
import Vuna.Compiler.Base.Hash
import Base.Data.List as List
import Base.Data.Sort as Sort
import Base.Data.String as String
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes

-- | 收集时跳过的目录名（与 `Driver.Compile` 的构建扫描同源）。
export skipSourceDir : String -> Bool
skipSourceDir name =
  name
    == ".git"
    || name
    == ".local"
    || name
    == ".output"
    || name
    == ".direnv"
    || name
    == "node_modules"
    || name == "seed" || name == "_scratch" || name == "result" || name == "corpus"

-- | 摘要文本归一：接受 `sha256:<64hex>` 与裸 64 位十六进制。
export normalizeHash : String -> String
normalizeHash h = if startsWith "sha256:" h then substring 7 64 h else h

-- | 期望摘要 vs 实际摘要（两侧都归一）。
export verifyHash : String -> String -> Bool
verifyHash expected actual = normalizeHash expected == normalizeHash actual

-- | 包内全部文件（相对路径 + 字节），按路径升序。`.gitignore` 命中的文件与目录不参与
-- 包内容（生成物不改变内容摘要与语义身份）。
-- 遍历燃料耗尽时报 `icFuel`：部分文件集合会让内容摘要判「一致」，不能静默截断。
export packageFilesEff : Member nFs FsOp r => String -> Eff r (Check (List PackageFile))
packageFilesEff root =
  do
    ignoreCtx0 <- ignoreContextEff root
    ignoreCtx <- loadIgnoreFile root (ignorePathOf ignoreCtx0 "") ignoreCtx0
    manifestFiles <- readManifestFile root
    libR <- collectDirFiles ignoreCtx pkgSourceDepth root "lib"
    case libR of
      ErrC e => pure (ErrC e)
      OkC libFiles =>
        do
          appR <- collectDirFiles ignoreCtx pkgSourceDepth root "app"
          case appR of
            ErrC e => pure (ErrC e)
            OkC appFiles =>
              do
                testR <- collectDirFiles ignoreCtx pkgSourceDepth root "test"
                case testR of
                  ErrC e => pure (ErrC e)
                  OkC testFiles => pure (OkC (sortByPath (append manifestFiles (append libFiles (append appFiles testFiles)))))

-- 目录深度预算只在**下钻**时消耗（同一层的兄弟项共用父级的预算）。合法树受宿主路径
-- 长度约束（PATH_MAX 4096，每层至少 2 字节 ⇒ 深度 ≤ 2048），因此 4096 对合法输入
-- 不可达；耗尽只可能来自绕不过内核 ELOOP 的形态。
pkgSourceDepth : Int
pkgSourceDepth = 4096

readManifestFile : Member nFs FsOp r => String -> Eff r (List PackageFile)
readManifestFile root =
  do
    exists <- fsFileExists "${root}/vuna.toml"
    if exists then
      do
        content <- fsReadFile "${root}/vuna.toml"
        pure [PackageFile "vuna.toml" content]
    else
      pure []

collectDirFiles : Member nFs FsOp r => IgnoreContext -> Int -> String -> String -> Eff r (Check (List PackageFile))
collectDirFiles ctx fuel root rel =
  if fuel <= 0 then
    pure (icFuel "package file collection")
  else
    let
      dir = if rel == "" then root else "${root}/${rel}"
    in do
      exists <- fsFileExists dir
      isDir <- if exists then fsIsDirectory dir else pure False
      if exists && isDir then
        do
          ctx2 <- loadIgnoreFile dir (ignorePathOf ctx rel) ctx
          names <- fsReadDir dir
          collectNames ctx2 fuel root rel names
      else
        pure (OkC [])

collectNames : Member nFs FsOp r => IgnoreContext -> Int -> String -> String -> List String -> Eff r (Check (List PackageFile))
collectNames ctx fuel root rel [] = pure (OkC [])
collectNames ctx fuel root rel (name :: rest) =
  if fuel <= 0 then
    pure (icFuel "package file collection")
  else
    do
      hereR <- walkName ctx fuel root rel name
      case hereR of
        ErrC e => pure (ErrC e)
        OkC here =>
          do
            thereR <- collectNames ctx fuel root rel rest
            case thereR of
              ErrC e => pure (ErrC e)
              OkC there => pure (OkC (append here there))

walkName : Member nFs FsOp r => IgnoreContext -> Int -> String -> String -> String -> Eff r (Check (List PackageFile))
walkName ctx fuel root rel name =
  if fuel <= 0 then
    pure (icFuel "package file collection")
  else
    case name of
      "." => pure (OkC [])
      ".." => pure (OkC [])
      _ =>
        if skipSourceDir name then
          pure (OkC [])
        else
          let
            childRel = if rel == "" then name else "${rel}/${name}"
            childPath = "${root}/${childRel}"
          in if isIgnored ctx childRel False then
            pure (OkC [])
          else
            do
              isDir <- fsIsDirectory childPath
              if isDir then
                if isIgnored ctx childRel True then pure (OkC []) else collectDirFiles ctx (fuel - 1) root childRel
              else if endsWith ".vuna" name then
                do
                  content <- fsReadFile childPath
                  pure (OkC [PackageFile childRel content])
              else
                pure (OkC [])

filePathLe : PackageFile -> PackageFile -> Bool
filePathLe a b = a.pfPath <= b.pfPath

sortByPath : List PackageFile -> List PackageFile
sortByPath files = sortBy filePathLe files

-- | 由 manifest + 文件集合构造 `PackageSource`（依赖声明只取别名与摘要）。
export packageSourceEff : Member nFs FsOp r => String -> Manifest -> Eff r (Check PackageSource)
packageSourceEff root manifest =
  do
    filesR <- packageFilesEff root
    case filesR of
      ErrC e => pure (ErrC e)
      OkC files => pure (OkC (PackageSource (packageNameOf manifest) (exportsOf manifest) (map depKeyOf manifest.manifestDependencies) files))

packageNameOf : Manifest -> String
packageNameOf manifest =
  case manifest.manifestName of
    Nothing => ""
    Just name => name

exportsOf : Manifest -> List String
exportsOf manifest =
  case manifest.manifestExports of
    Nothing => []
    Just xs => xs

-- 依赖身份优先取声明的 `identity`（分发/pin 身份）；没有就退回内容摘要。
-- `path` 依赖两者都没有时记 `"path"`：它是可变输入，摘要不参与依赖方身份（D12）。
depKeyOf : Dependency -> (String, String)
depKeyOf dep =
  let
    key =
      case depIdentityOf dep of
        Just i => normalizeHash i
        Nothing =>
          case depHashOf dep of
            Nothing => "path"
            Just h => normalizeHash h
  in (depAliasOf dep, key)

-- | 内容摘要：只含 `(相对路径, 字节)`。
export contentHashOf : PackageSource -> String
contentHashOf ps = contentAddress (encPackageContent ps.psFiles)

-- | 语义身份：包名 + 导出 + 依赖摘要 + 文件内容摘要。
export identityHashOf : PackageSource -> String
identityHashOf ps = contentAddress (encPackageIdentity (identityOfSource ps))
