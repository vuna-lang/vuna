module Vuna.Compiler.Frontend.Packages.Pkg where

-- Vuna.Compiler.Frontend.Packages.Pkg：包 / workspace 解析层（不碰 Loader / CLI）。
-- 每个包 = 带 vuna.toml 的目录。workspace 根有两种形态：根包（根 vuna.toml 同时含
-- [workspace] 与 [package]）与虚拟根（只有 [workspace]，没有 [package]）。
-- 本模块用内建 fsReadFile / fsFileExists 读盘；绝对化 = 词法归一（`Base.Source.normalizePath`
-- / `joinPath`，与 manifest 侧同一口径）后交给 `envRealPath` 解析符号链接，所以
-- `a/../b`、尾 `/` 与 `link -> real` 三种写法落到同一个目录字符串。循环检测与去重都用
-- 这个规范化后的目录字符串。
-- 包内目录约定：lib/、app/、test/；入口固定 app/Main.vuna。
--
-- 每个源文件只有唯一**包上下文**（`PackageContext`）= 最近的 vuna.toml 包
-- + 它的依赖闭包 + 模块根列表。没有 manifest 的文件只有 base 上下文（base 定位 =
-- `VUNA_BASE` 覆盖 + 可执行文件相对布局），此时包名为空（ad-hoc 入口）。
-- `Root` 只作为包上下文的内部模块根（类型 + 访问器导出，构造子不导出）。
-- 效果显式化：manifest 读盘、存在性探测、cwd / 环境 / 可执行文件路径全部显式在
-- `Eff []` 里；路径规范化、依赖图校验、包/上下文构造等纯逻辑保持纯函数。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics.Pkg
import Vuna.Compiler.Frontend.Manifest
import Vuna.Compiler.Frontend.Canonical.Pkg
import Vuna.Compiler.Frontend.Packages.Source
import Vuna.Compiler.Base.Store
import Base.Data.Unit
import Base.Data.List as List
import Base.Container.HashMap as HashMap
import Base.Container.MutRef
import Base.Effect.Mut
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes

-- 模块根：目录、包名、可选导出模块列表。
-- exports = Nothing 表示该根不限制导出（自己包）；exports = Just mods 表示只有
-- mods 里的模块可被跨包 import。
-- 抽象性：导出表只写 `Root`（不含 `(..)`）——record 的裸导出隐藏构造子，
-- 外部只能读字段、不能构造。
export record Root where
  rootDir : String
  rootName : String
  rootExports : Maybe (List String)
  rootLayerRules : List Layer
  -- | 本根对应包的模块是否自动注入 `Prelude`（来自 `[package] implicit-prelude`）。
  rootImplicitPrelude : Bool

-- 已解析的包：manifest、直接依赖（顺序同 [dependencies]）、包目录（已规范化）。
export record Package(..) where
  packageManifest : Manifest
  packageDependencies : List Package
  packageDir : String

-- 文件/目录的包上下文（抽象：record 裸导出隐藏构造子，只能经 `contextForFile` /
-- `contextForDir` / `packageContext` 构造；字段可跨模块读取）。
--   - String         = 上下文目录（包目录；base-only 时为 ""）
--   - Maybe Package  = 包本体（base-only 时为 Nothing：文件不属于任何包）
--   - List Root      = 模块根列表（自己 lib 在最前，随后是依赖闭包）
--   - String         = 包名（base-only 时为 ""）
--   - Bool           = release 构建模式（`--release` / `VUNA_RELEASE=1`；只影响诊断拒绝，
--                      不改变产物，因此不参与缓存指纹）。
export record PackageContext where
  contextDir : String
  contextPackage : Maybe Package
  contextRoots : List Root
  contextPackageName : String
  contextRelease : Bool

export rootLayers : Root -> List Layer
rootLayers (Root dir name exports layers _) = layers

-- rootName 的别名（Loader/CLI 侧更常用的叫法）。
export rootPackage : Root -> String
rootPackage root = rootName root

-- 上下文包名：base-only（ad-hoc）为空串；Loader 用它判同包可见性与效果内建。
export contextPackageOf : PackageContext -> Maybe Package
contextPackageOf ctx = ctx.contextPackage

-- | 在已有上下文上设置 release 模式（CLI 构造上下文后调用）。
export contextWithRelease : Bool -> PackageContext -> PackageContext
contextWithRelease release ctx = { ctx | contextRelease = release }

export packageName : Package -> String
packageName package =
  case package.packageManifest.manifestName of
    Nothing => ""
    Just name => name

export packageExports : Package -> Maybe (List String)
packageExports package = package.packageManifest.manifestExports

export packageLayers : Package -> List Layer
packageLayers package = package.packageManifest.manifestLayers

export packageImplicitPrelude : Package -> Bool
packageImplicitPrelude package = package.packageManifest.manifestImplicitPrelude

-- ---------------------------------------------------------------- 路径工具
-- 相对路径按当前工作目录归一为绝对路径（向上找 manifest 前必须先绝对化，
-- 否则 "." 这类相对路径的父目录仍是 "."，搜索在起点就停住）。
-- 折绝对后交给 `envRealPath`：符号链接也归一，`/tmp/link` 与 `/tmp/real` 得到同一个
-- 绝对目录（project id 与 store 的 roots 分目录都按这个字符串算）。路径不存在时原语
-- 回落入参，于是等价于纯词法结果。
export absolutePath : Member nEnv EnvOp r => String -> Eff r String
absolutePath path =
  do
    folded <-
      if startsWith "/" path then
        pure (normalizePath path)
      else
        do
          cwd <- envGetCwd
          pure (normalizePath "${cwd}/${path}")
    envRealPath folded

joinPathsText : List String -> String
joinPathsText [] = ""
joinPathsText [path] = path
joinPathsText (path :: rest) = "${path}, ${joinPathsText rest}"

-- ---------------------------------------------------------------- manifest
-- path 是 vuna.toml 的路径；缺失时报 `pkg: missing vuna.toml in <目录>`。
export loadManifestAt : Member nFs FsOp r => String -> Eff r (Check Manifest)
loadManifestAt path =
  do
    exists <- fsFileExists path
    if exists then
      do
        text <- fsReadFile path
        pure (
            case parseManifest path text of
              ErrC e => ErrC e
              OkC manifest =>
                case validateManifest manifest of
                  ErrC e => ErrC e
                  OkC validated => OkC validated
          )
    else
      pure (pkgPath1 path (MissingManifest (normalizePath (manifestDir path))) (normalizePath (manifestDir path)))

manifestNameString : Manifest -> String
manifestNameString manifest =
  case manifest.manifestName of
    Nothing => ""
    Just name => name

-- ---------------------------------------------------------------- 加载包
-- 依赖链栈：每个元素是 (规范化目录, 包名)；只用于循环检测。
memStackDir : Eq a => a -> List (a, b) -> Bool
memStackDir dir [] = False
memStackDir dir (pair :: rest) = firstOf pair == dir || memStackDir dir rest

cyclePrefix : Eq a => a -> List (a, b) -> Maybe (List (a, b))
cyclePrefix dir [] = Nothing
cyclePrefix dir (pair :: rest) =
  if firstOf pair == dir then
    Just [pair]
  else
    case cyclePrefix dir rest of
      Nothing => Nothing
      Just prefix => Just ((::) pair prefix)

cycleMessage : String -> Maybe String -> List (String, String) -> String
cycleMessage dir Nothing stack = "pkg: dependency cycle at ${dir}"
cycleMessage dir (Just dep) stack =
  case cyclePrefix dir stack of
    Nothing => "pkg: dependency cycle at ${dir}"
    Just prefix =>
      "pkg: dependency cycle: ${joinArrows (append (map secondOf (reverse prefix)) [dep])}"

dependencyNameOk : Eq a => Maybe a -> a -> Bool
dependencyNameOk Nothing actual = True
dependencyNameOk (Just expected) actual = expected == actual

mismatchMessage : Maybe String -> String -> String
mismatchMessage Nothing actual = "pkg: package name mismatch"
mismatchMessage (Just expected) actual =
  "pkg: dependency ${expected} expects package name ${expected} but found ${actual}"

-- 不可变源依赖：定位 store 物化视图（`<store>/pkgs/<digest>`）并校验 `.complete`。
-- 物化视图由 `vuna deps fetch` 写入；check/build 只读，缺失即 `PKG_NotMaterialized`。
loadStoreDependency : Member nFs FsOp r, Member nEnv EnvOp r, Member MutOp r => MutRef (HashMap String Package) -> Int -> List (String, String) -> Dependency -> Eff r (Check Package)
loadStoreDependency memo fuel stack dep =
  case depHashOf dep of
    Nothing => pure (pkgNoLoc1 (NotMaterialized (depAliasOf dep)) (depAliasOf dep))
    Just hash =>
      do
        root <- storeDataRootEff
        let
          digest = normalizeHash hash
          dir = "${root}/pkgs/${digest}"
        in do
          exists <- fsFileExists "${dir}/.complete"
          if exists then
            do
              text <- fsReadFile "${dir}/.complete"
              if text == digest then
                do
                  pkgR <- loadPackageWalk memo fuel stack (Just (depAliasOf dep)) dir
                  case pkgR of
                    ErrC e => pure (ErrC e)
                    OkC pkg =>
                      do
                        idR <- verifyIdentityEff dep dir pkg.packageManifest
                        case idR of
                          ErrC e => pure (ErrC e)
                          OkC _ => pure (OkC pkg)
              else
                pure (pkgNoLoc1 (NotMaterialized (depAliasOf dep)) (depAliasOf dep))
          else
            pure (pkgNoLoc1 (NotMaterialized (depAliasOf dep)) (depAliasOf dep))

-- 依赖声明了语义身份（`identity`）时校验；未声明则跳过（内容摘要负责完整性）。
verifyIdentityEff : Member nFs FsOp r => Dependency -> String -> Manifest -> Eff r (Check Int)
verifyIdentityEff dep dir manifest =
  case depIdentityOf dep of
    Nothing => pure (OkC 0)
    Just expected =>
      do
        psR <- packageSourceEff dir manifest
        case psR of
          ErrC e => pure (ErrC e)
          OkC ps =>
            let
              actual = identityHashOf ps
            in if normalizeHash expected == actual then
              pure (OkC 0)
            else
              do
                let
                  detail = "declared ${expected}, actual ${actual}"
                in pure (pkgNoLoc (IdentityMismatch (depAliasOf dep) detail) [depAliasOf dep, detail])

-- path 依赖显式写摘要时校验（不写则跳过：可变输入，D12）。
verifyPathHashEff : Member nFs FsOp r => Dependency -> String -> Eff r (Check Int)
verifyPathHashEff dep dir =
  case depHashOf dep of
    Nothing => pure (OkC 0)
    Just expected =>
      do
        filesR <- packageFilesEff dir
        case filesR of
          ErrC e => pure (ErrC e)
          OkC files =>
            let
              actual = contentHashOf (PackageSource "" [] [] files)
            in if verifyHash expected actual then
              pure (OkC 0)
            else
              do
                let
                  detail = "declared ${expected}, actual ${actual}"
                in pure (pkgNoLoc (HashMismatch (depAliasOf dep) detail) [depAliasOf dep, detail])

loadDependencyList : Member nFs FsOp r, Member nEnv EnvOp r, Member MutOp r => MutRef (HashMap String Package) -> Int -> List (String, String) -> String -> List Dependency -> Eff r (Check (List Package))
loadDependencyList memo fuel stack baseDir deps =
  if fuel <= 0 then
    pure (icFuel "pkg")
  else
    case deps of
      [] => pure (OkC [])
      dep :: rest =>
        do
          depR <- loadOneDependency memo (fuel - 1) stack baseDir dep
          case depR of
            ErrC e => pure (ErrC e)
            OkC dependency =>
              do
                restR <- loadDependencyList memo (fuel - 1) stack baseDir rest
                pure (
                    case restR of
                      ErrC e => ErrC e
                      OkC dependencies => OkC ((::) dependency dependencies)
                  )

-- 单条依赖：path 定位工作树目录（显式摘要则校验）；git/url 定位 store 物化视图。
loadOneDependency : Member nFs FsOp r, Member nEnv EnvOp r, Member MutOp r => MutRef (HashMap String Package) -> Int -> List (String, String) -> String -> Dependency -> Eff r (Check Package)
loadOneDependency memo fuel stack baseDir dep =
  case depSourceOf dep of
    DepPath rel =>
      do
        let
          dir = joinPath baseDir rel
        in do
          depR <- loadPackageWalk memo fuel stack (Just (depAliasOf dep)) dir
          case depR of
            ErrC e => pure (ErrC e)
            OkC dependency =>
              do
                hashR <- verifyPathHashEff dep dir
                case hashR of
                  ErrC e => pure (ErrC e)
                  OkC _ =>
                    do
                      idR <- verifyIdentityEff dep dir dependency.packageManifest
                      case idR of
                        ErrC e => pure (ErrC e)
                        OkC _ => pure (OkC dependency)
    DepGit url rev => loadStoreDependency memo fuel stack dep
    DepUrl url => loadStoreDependency memo fuel stack dep

-- 依赖图展开的 memo：同一个目录（diamond 依赖 / 多个父包共享）只读一次 `vuna.toml`。
-- 键是 `normalizePath` 后的目录；循环检测在查 memo **之前**（同一目录在不同 stack 下
-- 仍要能判环），memo 只存成功结果。
emptyPackageMemo : HashMap String Package
emptyPackageMemo = HashMap.fromList []

memoLookup : {r : Row} -> {w : Member MutOp r} -> MutRef (HashMap String Package) -> String -> Eff r (Maybe Package)
memoLookup memo dir =
  do
    tbl <- MutRef.read memo
    pure (HashMap.lookup dir tbl)

memoInsert : {r : Row} -> {w : Member MutOp r} -> MutRef (HashMap String Package) -> String -> Package -> Eff r Unit
memoInsert memo dir pkg =
  do
    tbl <- MutRef.read memo
    MutRef.write memo (HashMap.insert dir pkg tbl)

loadPackageWalk : Member nFs FsOp r, Member nEnv EnvOp r, Member MutOp r => MutRef (HashMap String Package) -> Int -> List (String, String) -> Maybe String -> String -> Eff r (Check Package)
loadPackageWalk memo fuel stack depName dir =
  if fuel <= 0 then
    pure (icFuel "pkg")
  else
    let
      normalized = normalizePath dir
    in if memStackDir normalized stack then
      pure (pkgInvalid (cycleMessage normalized depName stack))
    else
      do
        cached <- memoLookup memo normalized
        case cached of
          Just pkg => if dependencyNameOk depName (packageName pkg) then pure (OkC pkg) else pure (pkgInvalid (mismatchMessage depName (packageName pkg)))
          Nothing =>
            do
              manifestR <- loadManifestAt "${normalized}/vuna.toml"
              case manifestR of
                ErrC e => pure (ErrC e)
                OkC manifest =>
                  case manifest.manifestName of
                    Nothing => pure (pkgPath0 manifest.manifestPath NotPackage)
                    Just _ =>
                      let
                        name = manifestNameString manifest
                      in if dependencyNameOk depName name then
                        do
                          dependencyR <- loadDependencyList memo (fuel - 1) ((normalized, name) :: stack) normalized manifest.manifestDependencies
                          case dependencyR of
                            ErrC e => pure (ErrC e)
                            OkC dependencies =>
                              do
                                let pkg = Package manifest dependencies normalized
                                _ <- memoInsert memo normalized pkg
                                pure (OkC pkg)
                      else
                        pure (pkgInvalid (mismatchMessage depName name))

-- ---------------------------------------------------------------- 包名唯一性
-- 包名不是纯标签，它参与语义判定：`Loader.rootAllows` 的「同包永远可见」
-- （`rootName root == importerPkg`）。
-- 因此同一依赖图里两个**不同目录**共用包名是配置错误。按包名去重会让后出现的那支
-- 依赖（连同它自己的整支依赖）被静默丢弃、模块解析退化到前一个同名包，所以加载后
-- 显式校验：同名同目录（diamond 依赖）合法，同名不同目录直接报错。
collectPackageIds : Package -> List (String, String)
collectPackageIds package =
  (packageName package, packageDir package) :: collectDependencyIds (packageDependencies package)

collectDependencyIds : List Package -> List (String, String)
collectDependencyIds [] = []
collectDependencyIds (package :: rest) =
  append (collectPackageIds package) (collectDependencyIds rest)

lookupPackageDir : String -> List (String, String) -> Maybe String
lookupPackageDir name [] = Nothing
lookupPackageDir name ((n, dir) :: rest) =
  if n == name then Just dir else lookupPackageDir name rest

checkUniqueNamesGo : List (String, String) -> List (String, String) -> Check Int
checkUniqueNamesGo seen [] = OkC 0
checkUniqueNamesGo seen ((name, dir) :: rest) =
  case lookupPackageDir name seen of
    Nothing => checkUniqueNamesGo ((name, dir) :: seen) rest
    Just prevDir =>
      if prevDir == dir then
        checkUniqueNamesGo seen rest
      else
        pkgNoLoc (DuplicatePackageName name prevDir dir) [name, prevDir, dir]

checkUniquePackageNames : List Package -> Check Int
checkUniquePackageNames packages = checkUniqueNamesGo [] (collectDependencyIds packages)

-- 依赖 DFS 的初值（保留 1M，附「为什么不可能耗尽」的论证）。
-- 测度：每处理一条依赖边 / 展开一个包目录都要消费 ≥1 步 fuel；`memStackDir` 的
-- 循环检测保证一条依赖链上不重复进入同一目录，所以单条链上的展开深度 ≤ 链上的
-- **不同目录数**（有限，≤ 路径字符串长度量级），整张图的展开次数 ≤ 可达依赖边数
-- （有限）。1M 远高于任何可由内存构造的依赖图（每次展开都要读一个 vuna.toml，
-- 真实耗时在同一数量级就会先超时），且耗尽时是明确的 internal 错误、不会静默
-- 返回不完整图。按已访问目录数做更紧的界需要先收集 manifest 的依赖表（那本身
-- 就要走同一趟 DFS），所以这里用证明界而不是额外的两趟扫描。
pkgFuelBound : Int
pkgFuelBound = 1048576

-- 加载 dir/vuna.toml 及其 [dependencies] 路径依赖（递归、含循环检测）。
export loadPackage : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check Package)
loadPackage dir =
  withMutRef emptyPackageMemo (
      \memo =>
        do
          packageR <- loadPackageWalk memo pkgFuelBound [] Nothing dir
          pure (
              case packageR of
                ErrC e => ErrC e
                OkC package =>
                  case checkUniquePackageNames [package] of
                    ErrC e => ErrC e
                    OkC _ => OkC package
            )
    )

-- ---------------------------------------------------------------- workspace
loadMembers : Member nFs FsOp r, Member nEnv EnvOp r => String -> List String -> Eff r (Check (List Package))
loadMembers baseDir [] = pure (OkC [])
loadMembers baseDir (rel :: rest) =
  do
    memberR <- loadPackage (joinPath baseDir rel)
    case memberR of
      ErrC e => pure (ErrC e)
      OkC memberPackage =>
        do
          restR <- loadMembers baseDir rest
          pure (
              case restR of
                ErrC e => ErrC e
                OkC memberPackages => OkC (memberPackage :: memberPackages)
            )

-- 根包 + [workspace].members（顺序同 manifest）；没有 members 时只含根包。
-- 每个成员自己的依赖图已由 loadPackage 校验；这里再校验并集，捕获跨成员的
-- 同名不同目录冲突。
-- 虚拟根（没有 [package]）只有成员，没有根包。
export record Workspace(..) where
  workspaceDir : String
  workspaceRoot : Maybe Package
  workspaceMembers : List Package

export workspaceRootOf : Workspace -> Maybe Package
workspaceRootOf workspace = workspace.workspaceRoot

export workspaceMembersOf : Workspace -> List Package
workspaceMembersOf workspace = workspace.workspaceMembers

-- | workspace 内的全部包：有根包时在前，随后是成员（顺序同 manifest）。
export workspaceAllPackages : Workspace -> List Package
workspaceAllPackages workspace =
  case workspace.workspaceRoot of
    Nothing => workspace.workspaceMembers
    Just root => root :: workspace.workspaceMembers

-- | 加载 workspace：根 manifest 有 `[package]` 时是根包 + 成员；没有时是虚拟根
-- （只有成员，`[workspace]` 由 manifest 层强制）。
export loadWorkspace : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check Workspace)
loadWorkspace rootBaseDir =
  let
    base = normalizePath rootBaseDir
  in do
    manifestR <- loadManifestAt "${base}/vuna.toml"
    case manifestR of
      ErrC e => pure (ErrC e)
      OkC manifest =>
        case manifest.manifestName of
          Nothing =>
            do
              membersR <- loadMembers base manifest.manifestMembers
              pure (
                  case membersR of
                    ErrC e => ErrC e
                    OkC members =>
                      case checkUniquePackageNames members of
                        ErrC e => ErrC e
                        OkC _ => OkC (Workspace base Nothing members)
                )
          Just _ =>
            do
              rootR <- loadPackage base
              case rootR of
                ErrC e => pure (ErrC e)
                OkC root =>
                  do
                    membersR <- loadMembers base manifest.manifestMembers
                    pure (
                        case membersR of
                          ErrC e => ErrC e
                          OkC members =>
                            case checkUniquePackageNames (root :: members) of
                              ErrC e => ErrC e
                              OkC _ => OkC (Workspace base (Just root) members)
                      )

export workspacePackages : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check (List Package))
workspacePackages rootBaseDir =
  do
    workspaceR <- loadWorkspace rootBaseDir
    pure (
        case workspaceR of
          ErrC e => ErrC e
          OkC workspace => OkC (workspaceAllPackages workspace)
      )

-- | 虚拟 workspace 根的工具上下文：没有单一包身份，模块根 = 各成员的 `lib`（每根按成员
-- 自己的 `[export]` 限制）。用于 REPL / LSP / 单文件检查这类「只需要一个模块解析环境」的
-- 场景；`workspace 根` 不是包，但也并不是 base-only。
export workspaceContext : Workspace -> PackageContext
workspaceContext workspace =
  PackageContext
    workspace.workspaceDir
    Nothing
    (map dependencyRootOf (workspaceMembersOf workspace))
    ""
    False

-- ---------------------------------------------------------------- 模块根
dependencyRootOf : Package -> Root
dependencyRootOf package =
  Root
    "${packageDir package}/lib"
    (packageName package)
    (packageExports package)
    (packageLayers package)
    (packageImplicitPrelude package)

-- DFS 后序：先深依赖、再直接依赖本体；按包名去重（首次出现保留）。
-- 包名唯一性由 `checkUniquePackageNames` 在加载期保证（同名 ⇒ 同目录），所以
-- 按名字去重不会再丢掉不同目录的依赖。
-- 返回 (更新后的 seen, 根列表)。
dependencyRoots : List String -> List Package -> (List String, List Root)
dependencyRoots seen [] = (seen, [])
dependencyRoots seen (package :: rest) =
  if memName (packageName package) seen then
    dependencyRoots seen rest
  else
    case dependencyRoots (packageName package :: seen) (packageDependencies package) of
      (seen1, transitive) =>
        case dependencyRoots seen1 rest of
          (seen2, siblings) => (seen2, append transitive (dependencyRootOf package :: siblings))

-- 自身 lib 根在最前（exports = Nothing：本包内全部可见）；
-- 随后是传递依赖的 lib 根（依赖优先的 DFS 后序），各自用 [export].modules 限制。
export packageRoots : Package -> List Root
packageRoots package =
  let
    selfName = packageName package
    selfRoot =
      Root
        "${packageDir package}/lib"
        selfName
        Nothing
        (packageLayers package)
        (packageImplicitPrelude package)
  in case dependencyRoots [selfName] package.packageDependencies of
    (seen, roots) => selfRoot :: roots

-- 包入口固定为 <dir>/app/Main.vuna。
export packageEntry : Package -> String
packageEntry package = "${packageDir package}/app/Main.vuna"

-- 已知 Package 的上下文（调用方已有包对象时不必重新读盘）。
export packageContext : Package -> PackageContext
packageContext package =
  PackageContext
    (packageDir package)
    (Just package)
    (packageRoots package)
    (packageName package)
    False

-- ---------------------------------------------------------------- 查找
findManifestUpMaybe : Member nFs FsOp r => Int -> String -> Eff r (Maybe String)
findManifestUpMaybe fuel dir =
  if fuel <= 0 then
    pure Nothing
  else
    do
      exists <- fsFileExists "${dir}/vuna.toml"
      if exists then pure (Just dir) else findManifestUpMaybeStep (fuel - 1) dir (manifestDir dir)

findManifestUpMaybeStep : Member nFs FsOp r => Int -> String -> String -> Eff r (Maybe String)
findManifestUpMaybeStep fuel dir parent =
  if fuel <= 0 then
    pure Nothing
  else if parent == dir then pure Nothing else findManifestUpMaybe (fuel - 1) parent

-- 从 startDir 向上找第一个含 vuna.toml 的目录（找不到 → Nothing）。
-- 上界证明：每上溯一层消耗 2 步（findManifestUpMaybe + Step），
-- 层数 k 满足 2*(k-1) ≤ strLength start——absolute 路径每层至少占「/x」两字符，
-- 且 normalizePath 已去掉空段/`.`/`..`，所以 2*k ≤ strLength start + 2；
-- 取 2*strLength start + 4 严格覆盖（含末层 parent==dir 的收尾）。
export findManifestDirMaybe : Member nFs FsOp r => String -> Eff r (Maybe String)
findManifestDirMaybe startDir =
  let
    start = normalizePath startDir
  in findManifestUpMaybe (2 * strLength start + 4) start

-- `findManifestDir` 保留给 fmt / index 这类「向上找 workspace 根」的工具；
-- 包上下文一律走 `contextForFile` / `contextForDir`。
export findManifestDir : Member nFs FsOp r => String -> Eff r (Check String)
findManifestDir startDir =
  do
    found <- findManifestDirMaybe startDir
    pure (
        case found of
          Just dir => OkC dir
          Nothing => pkgNoLoc (NoManifestUpward (normalizePath startDir)) [normalizePath startDir]
      )

-- ---------------------------------------------------------------- base 定位
-- base 只由两处决定：`VUNA_BASE`（显式覆盖，相对路径按 cwd 归一），或可执行文件
-- 相对布局（<exeDir>/base、../base、../../base、../../../base）。候选目录必须含
-- vuna.toml；都不成立时报错并列出尝试路径 + `VUNA_BASE` 提示。
hasManifest : Member nFs FsOp r => String -> Eff r Bool
hasManifest dir = fsFileExists "${dir}/vuna.toml"

baseCandidates : String -> List String
baseCandidates exeDir =
  [
    joinPath exeDir "base",
    joinPath exeDir "../base",
    joinPath exeDir "../../base",
    joinPath exeDir "../../../base"
  ]

baseNotFound : List String -> Check a
baseNotFound tried = pkgNoLoc1 (MissingBase (joinPathsText tried)) (joinPathsText tried)

firstExistingBase : Member nFs FsOp r => List String -> List String -> Eff r (Check String)
firstExistingBase original [] = pure (baseNotFound original)
firstExistingBase original (dir :: rest) =
  do
    exists <- hasManifest dir
    if exists then pure (OkC dir) else firstExistingBase original rest

-- base 定位是启动期读环境/探路径的**动作**（零参顶层值是值，会在模块初始化时求值），
-- 因此函数化：调用方传 `MkUnit`，真正用到 base-only 上下文时才解析。
export locateBase : Member nFs FsOp r, Member nEnv EnvOp r => Unit -> Eff r (Check String)
locateBase _ =
  do
    env <- envGetEnv "VUNA_BASE"
    if env == "" then
      do
        exe <- envExecPath
        cwd <- absolutePath exe
        let
          candidates = baseCandidates (manifestDir cwd)
        in firstExistingBase candidates candidates
    else
      do
        dir <- absolutePath env
        exists <- hasManifest dir
        if exists then pure (OkC dir) else pure (baseNotFound [dir])

-- ---------------------------------------------------------------- 包上下文
-- base-only 上下文：不属于任何包的文件（ad-hoc 入口）。包名为空串（效果内建
-- 仍被拒绝），模块根只有 base/lib，导出限制沿用 base 的 [export].modules。
-- 入口能力为空（base 模块根各自携带 base manifest 的能力，不受影响）。
baseOnlyContext : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check PackageContext)
baseOnlyContext base =
  do
    packageR <- loadPackage base
    pure (
        case packageR of
          ErrC e => ErrC e
          OkC package => OkC (PackageContext "" Nothing [dependencyRootOf package] "" False)
      )

-- 从 start（已绝对化的目录）向上找最近 manifest；找不到 → base-only。
-- manifest 非法（解析/校验失败）必须报错，不回退到 base-only。最近的 manifest 是虚拟
-- workspace 根（没有 `[package]`）时给 workspace 上下文：成员包各自的 lib 是模块根。
contextAt : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check PackageContext)
contextAt start =
  do
    found <- findManifestDirMaybe start
    case found of
      Just dir =>
        do
          manifestR <- loadManifestAt "${dir}/vuna.toml"
          case manifestR of
            ErrC e => pure (ErrC e)
            OkC manifest =>
              case manifest.manifestName of
                Nothing =>
                  do
                    workspaceR <- loadWorkspace dir
                    pure (
                        case workspaceR of
                          ErrC e => ErrC e
                          OkC workspace => OkC (workspaceContext workspace)
                      )
                Just _ =>
                  do
                    packageR <- loadPackage dir
                    pure (
                        case packageR of
                          ErrC e => ErrC e
                          OkC package => OkC (packageContext package)
                      )
      Nothing =>
        do
          baseR <- locateBase MkUnit
          case baseR of
            ErrC e => pure (ErrC e)
            OkC base => baseOnlyContext base

-- 文件入口：相对路径先按 cwd 绝对化，再从文件所在目录向上找最近 vuna.toml。
export contextForFile : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check PackageContext)
contextForFile path =
  do
    absolute <- absolutePath path
    contextAt (manifestDir absolute)

-- 目录入口（REPL / 工具从 cwd 取上下文）：同样先绝对化再向上找 manifest。
-- 「显式包目录」语义（check/compile/build 的目录参数）不用本函数，而是直接
-- `loadPackage`：只认该目录自己的 vuna.toml，不向上搜索。
export contextForDir : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check PackageContext)
contextForDir dir =
  do
    absolute <- absolutePath dir
    contextAt absolute
