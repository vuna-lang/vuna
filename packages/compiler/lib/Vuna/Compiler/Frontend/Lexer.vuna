module Vuna.Compiler.Frontend.Lexer where

-- vuna 源码 lexer：字符游标、token 与 pos。
--
-- 注释与 token **规则同源**：注释正文的识别/嵌套（`collectLineBody` / `collectBlockBody`）
-- 与 trivia 判定只有一份实现，`skipTrivia`（token 路径，不分配）与
-- `skipTriviaComments`（注释路径，收集）共用它。旧实现另有一条 `scanComments` 并行
-- 扫描器（自己再实现一遍「字符串里不算注释」），两侧规则容易漂移，已删除。
-- 需要注释的消费者用 `lexSourceWithComments`（一次扫描同时给出 token 与注释），
-- 而不是 lex 之后再扫一遍。
--
-- 字符串字面量支持**模板插值**（`"hi ${name}"`）与**多行**（`"""..."""`）。
-- 扫描把字面量切成 `TmplPart`：
--   * `TPText`：文本块（转义已解）；
--   * `TPHole`：插值洞，存**洞内 token 列表**（由 `lexHoleTokens` 原位词法得到，
--     位置仍是绝对源码位置）——parser 直接拿这段 token 解析成表达式，无需二次词法。
-- 洞内注释（`--` / `{- -}`）随洞 token 一起被 `skipTrivia` 跳过：插值洞里的注释
-- **不进入 AST / 注释表**（fmt 会丢失它们），这是已知边界，见 docs/reference/templates.md。
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics.Frontend

-- 模板字面量的片段：文本块或插值洞（洞内 token 列表）。
export data TmplPart(..) : Type where
  TPText : String -> TmplPart
  TPHole : List PTok -> TmplPart

export data Tok(..) : Type where
  TIdent : String -> Tok
  TKw : String -> Tok
  TInt : Int -> Tok
  TStr : String -> Tok
  -- `TTmpl multi parts endPos`：`multi` = 是否 `"""` 形式；`endPos` = 结束引号位置
  -- （多行字面量会把 span 的结束行/列带对，布局与 decl span 依赖它）。
  TTmpl : Bool -> List TmplPart -> Pos -> Tok
  TSym : String -> Tok
  TEof : Tok
  -- `TFloat`：十进制浮点字面量的原始文本（放末尾保持 tag 顺序）。
  TFloat : String -> Tok

export record PTok(..) where
  ptokTok : Tok
  ptokPos : Pos

export record Chars(..) where
  charsSource : String
  charsOffset : Int
  charsPos : Pos

export charsSource : Chars -> String
charsSource cs = cs.charsSource

export charsOffset : Chars -> Int
charsOffset cs = cs.charsOffset

export charsPos : Chars -> Pos
charsPos cs = cs.charsPos

-- 游标原语：全部 O(1)。`strAt` 越界返回 -1，正好当 EOF 哨兵。
export charsEmpty : Chars -> Bool
charsEmpty cs = cs.charsOffset >= strLength cs.charsSource

export charsPeek : Chars -> Int
charsPeek cs = strAt cs.charsSource cs.charsOffset

export charsPeekAt : Int -> Chars -> Int
charsPeekAt k cs = strAt cs.charsSource (cs.charsOffset + k)

-- 消费一个**已知**字符 `c`（当前位置上的那个）。
export charsStep : Int -> Chars -> Chars
charsStep c cs = Chars cs.charsSource (cs.charsOffset + 1) (advanceChar c cs.charsPos)

-- 消费当前位置的字符（读一次再推进）。
export charsNext : Chars -> Chars
charsNext cs = charsStep (charsPeek cs) cs

-- 消费两个字符。
export charsNext2 : Chars -> Chars
charsNext2 cs = charsNext (charsNext cs)

-- 第二个字符的位置（消费第一个字符之后）。
export charsPos2 : Chars -> Pos
charsPos2 cs = advanceChar (charsPeek cs) cs.charsPos

-- | 词法诊断的 span：字符游标当前位置的**点 span**。Lexer 不知道文件名
-- （`Chars` 只有字符与 Pos），入口 `Loader.Flatten` 用 `withSpanFileIfEmpty` 注入。
-- | 内部：给 token 的起点 Pos 补上结束字节偏移（开区间）。
setTokEnd : Chars -> PTok -> PTok
setTokEnd cs (PTok tok p) = PTok tok (Pos (posLine p) (posCol p) (posOffset p) (charsOffset cs))

-- | 内部：把 Pos 的结束偏移补成给定值（EOF 等点位置）。
posWithEnd : Pos -> Int -> Pos
posWithEnd p end = Pos (posLine p) (posCol p) (posOffset p) end

export lexSpanAt : Pos -> Span
lexSpanAt (Pos line col off _) = Span "" line col line col off off

export advanceChar : Int -> Pos -> Pos
advanceChar c (Pos line col off _) =
  if c == 10 then Pos (line + 1) 1 (off + 1) (off + 1) else Pos line (col + 1) (off + 1) (off + 1)

export isUpperChar : Int -> Bool
isUpperChar c = c >= 65 && c <= 90

export isLowerChar : Int -> Bool
isLowerChar c = c >= 97 && c <= 122

export isIdentStart : Int -> Bool
isIdentStart c = isUpperChar c || isLowerChar c || c == 95

export isIdentChar : Int -> Bool
isIdentChar c = isIdentStart c || isDigit c || c == 39

export isDigit : Int -> Bool
isDigit c = c >= 48 && c <= 57

export isSpace : Int -> Bool
isSpace c = c == 32 || c == 9 || c == 10 || c == 13

export isOpChar : Int -> Bool
isOpChar c =
  c
    == 33
    || c
    == 36
    || c
    == 37
    || c
    == 38
    || c
    == 42
    || c
    == 43
    || c
    == 45
    || c
    == 46
    || c
    == 47
    || c
    == 60
    || c
    == 61 || c == 62 || c == 63 || c == 64 || c == 92 || c == 94 || c == 124 || c == 126 || c == 58

-- 关键字表（含 `axiom`、`infixl` / `infixr` / `infix`）。
export isKeyword : String -> Bool
-- 表示档位前缀（`alias record` / `boxed record`）与 `export` / `abstract` 是
-- **软关键字**：只在声明位置的特定上下文识别，不进入该表，避免与用户已有的同名
-- 标识符（编译器源码里就有 `alias` 等 binder）冲突。
-- `transparent` / `opaque` 是硬关键字（`export` 位置紧跟 record 时也作档位前缀）。
isKeyword s =
  s
    == "data"
    || s
    == "axiom"
    || s
    == "extern"
    || s
    == "case"
    || s
    == "of"
    || s
    == "let"
    || s
    == "in"
    || s
    == "if"
    || s
    == "then"
    || s
    == "else"
    || s
    == "where"
    || s
    == "linear"
    || s
    == "transparent"
    || s
    == "opaque"
    || s
    == "Type"
    || s
    == "import"
    || s
    == "module"
    || s
    == "qualified"
    || s
    == "as"
    || s
    == "record"
    || s
    == "trait"
    || s
    == "instance"
    || s
    == "deriving"
    || s
    == "do" || s == "perform" || s == "handle" || s == "infixl" || s == "infixr" || s == "infix"

export classifyIdent : String -> Tok
classifyIdent s = if isKeyword s then TKw s else TIdent s

-- ---------------------------------------------------------------
-- 注释（trivia 的一部分）
-- ---------------------------------------------------------------
export data CKind(..) : Type where
  CLine : CKind
  CBlock : CKind

export record Comment(..) where
  commentKind : CKind
  commentText : String
  commentSpan : Span

export commentSpan : Comment -> Span
commentSpan (Comment kind text sp) = sp

export trimTrailingSpace : String -> String
trimTrailingSpace s = strPack (reverse (dropTrailingSpace (reverse (strUnpack s))))

export dropTrailingSpace : List Int -> List Int
dropTrailingSpace [] = []
dropTrailingSpace (c :: rest) =
  if c == 32 || c == 9 || c == 13 then dropTrailingSpace rest else (::) c rest

-- 行注释正文：从 `--` 之后扫到行尾（不消费换行）；endP 是最后一个正文字符位置。
export collectLineBody : Int -> Chars -> List Int -> Pos -> Check (String, Chars, Pos)
collectLineBody fuel cs acc endP =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (strPack (reverse acc), cs, endP)
  else
    let
      c = charsPeek cs
    in if c == 10 then OkC (strPack (reverse acc), cs, endP) else collectLineBody (fuel - 1) (charsStep c cs) (c :: acc) (charsPos cs)

-- 块注释正文：深度从 1 开始，返回 `{-` 与 `-}` 之间的原文；endP 是 `}` 的位置。
export collectBlockBody : Int -> Chars -> Int -> List Int -> Pos -> Check (String, Chars, Pos)
collectBlockBody fuel cs depth acc endP =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    lexErr0At (lexSpanAt (charsPos cs)) UnterminatedBlockComment
  else
    let
      c = charsPeek cs
      c2 = charsPeekAt 1 cs
    in if c2 < 0 then collectBlockBody (fuel - 1) (charsStep c cs) depth (c :: acc) (charsPos cs) else if c == 123 && c2 == 45 then collectBlockBody (fuel - 1) (charsNext2 cs) (depth + 1) (c2 :: c :: acc) (charsPos2 cs) else if c == 45 && c2 == 125 then if depth == 1 then OkC (strPack (reverse acc), charsNext2 cs, charsPos2 cs) else collectBlockBody (fuel - 1) (charsNext2 cs) (depth - 1) (c2 :: c :: acc) (charsPos2 cs) else collectBlockBody (fuel - 1) (charsStep c cs) depth (c :: acc) (charsPos cs)

-- | 跳过行注释正文（`--` 之后），返回其后位置。
export skipLineComment : Int -> Chars -> Check Chars
skipLineComment fuel cs =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC cs
  else
    let
      c = charsPeek cs
    in if c == 10 then OkC cs else skipLineComment (fuel - 1) (charsStep c cs)

-- | 跳过块注释（`{-` 之后，depth 从 1 开始；可嵌套）。
export skipBlockComment : Int -> Int -> Chars -> Check Chars
skipBlockComment fuel depth cs =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    lexErr0At (lexSpanAt (charsPos cs)) UnterminatedBlockComment
  else
    let
      c = charsPeek cs
      c2 = charsPeekAt 1 cs
    in if c2 < 0 then skipBlockComment (fuel - 1) depth (charsStep c cs) else if c == 123 && c2 == 45 then skipBlockComment (fuel - 1) (depth + 1) (charsNext2 cs) else if c == 45 && c2 == 125 then if depth == 1 then OkC (charsNext2 cs) else skipBlockComment (fuel - 1) (depth - 1) (charsNext2 cs) else skipBlockComment (fuel - 1) depth (charsStep c cs)

export commentSpanOf : Pos -> Pos -> Span
commentSpanOf startP endP =
  Span
    ""
    (posLine startP)
    (posCol startP)
    (posLine endP)
    (posCol endP)
    (posOffset startP)
    (posOffset endP)

-- ---------------------------------------------------------------
-- trivia：空白 + 注释
-- ---------------------------------------------------------------
-- 两个入口：
--   * `skipTrivia`：token 路径，**不分配**注释正文（编译器热路径每次词法都要过）；
--   * `skipTriviaComments`：注释路径，用 `collectLineBody` / `collectBlockBody`
--     收集注释（正文 + 结束位置）。
-- 两者的「空白 / `--` / `{-` 判定」同源，但注释扫描是两份实现：token 路径的
-- `skipLineComment` / `skipBlockComment` 只推位置、零分配（`skipBlockComment` 因此
-- 自己写了深度计数）；把 token 路径改成返回 `Pair`（收集注释）实测让大文件
-- `vuna.parse.lex` 慢约 20%，不值（见 performance.md §6.1）。
-- 字符串/模板里的 `--` 不算注释这条规则只有一份：两条路径都走 `lexOneToken` /
-- `scanTemplateText`，不再有独立的注释扫描器。
-- fuel 按字符/注释段递减（所有扫描器都不回传 fuel：主循环与各扫描器各自持有一个
-- 够用的显式 fuel，终止性走「守卫 Int + 严格递减」）。
export skipTrivia : Int -> Chars -> Check Chars
skipTrivia fuel cs =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC cs
  else
    let
      c = charsPeek cs
      c2 = charsPeekAt 1 cs
    in if isSpace c then
      skipTrivia (fuel - 1) (charsStep c cs)
    else if c2 < 0 then
      OkC cs
    else if c == 45 && c2 == 45 then
      case skipLineComment (fuel - 1) (charsStep c cs) of
        ErrC e => ErrC e
        OkC cs3 => skipTrivia (fuel - 1) cs3
    else if c == 123 && c2 == 45 then
      case skipBlockComment (fuel - 1) 1 (charsStep c cs) of
        ErrC e => ErrC e
        OkC cs2 => skipTrivia (fuel - 1) cs2
    else
      OkC cs

-- | 同 `skipTrivia`，但把注释按源码顺序收集（`lexComments` / CST trivia 用）。
export skipTriviaComments : Int -> Chars -> Check (Chars, List Comment)
skipTriviaComments fuel cs = skipTriviaCommentsGo fuel [] cs

skipTriviaCommentsGo : Int -> List Comment -> Chars -> Check (Chars, List Comment)
skipTriviaCommentsGo fuel acc cs =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (cs, reverse acc)
  else
    let
      c = charsPeek cs
      c2 = charsPeekAt 1 cs
      p = charsPos cs
    in if isSpace c then
      skipTriviaCommentsGo (fuel - 1) acc (charsStep c cs)
    else if c2 < 0 then
      OkC (cs, reverse acc)
    else if c == 45 && c2 == 45 then
      case collectLineBody (fuel - 1) (charsNext2 cs) [] (charsPos2 cs) of
        ErrC e => ErrC e
        OkC (text, csLine, endP) => skipTriviaCommentsGo (fuel - 1) (Comment CLine (trimTrailingSpace text) (commentSpanOf p endP) :: acc) csLine
    else if c == 123 && c2 == 45 then
      case collectBlockBody (fuel - 1) (charsNext2 cs) 1 [] (charsPos2 cs) of
        ErrC e => ErrC e
        OkC (text, csBlock, endP) => skipTriviaCommentsGo (fuel - 1) (Comment CBlock text (commentSpanOf p endP) :: acc) csBlock
    else
      OkC (cs, reverse acc)

-- ---------------------------------------------------------------
-- 标识符 / 数字 / 运算符
-- ---------------------------------------------------------------
-- `@vuna@name` 内部名：只有 `@vuna@` 前缀且后续是标识符字符时才作为
-- 单个标识符收集；其余 `@` 仍是操作符（保持模式 `name@pat` 的语法不变）。
startsWithVunaAt : Chars -> Bool
startsWithVunaAt cs =
  charsPeekAt 0 cs
    == 118
    && charsPeekAt 1 cs
    == 117 && charsPeekAt 2 cs == 110 && charsPeekAt 3 cs == 97 && charsPeekAt 4 cs == 64

collectInternalIdent : Int -> Chars -> List Int -> Check (String, Chars)
collectInternalIdent fuel cs acc =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (strPack (reverse acc), cs)
  else
    let
      c = charsPeek cs
    in if isIdentChar c || c == 64 then collectInternalIdent (fuel - 1) (charsStep c cs) (c :: acc) else OkC (strPack (reverse acc), cs)

export collectIdent : Int -> Chars -> List Int -> Check (String, Chars)
collectIdent fuel cs acc =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (strPack (reverse acc), cs)
  else
    let
      c = charsPeek cs
    in if isIdentChar c then collectIdent (fuel - 1) (charsStep c cs) (c :: acc) else if c == 46 && isIdentStart (charsPeekAt 1 cs) then collectIdent (fuel - 1) (charsStep c cs) (c :: acc) else OkC (strPack (reverse acc), cs)

-- 63 位宿主 int 的上界（2^62 - 1）。字面量累加超过它就无法表示：在词法期报
-- `LX_IntLiteralOutOfRange`，不再让 `acc * 10 + d` 静默回绕成小值或负数。
export maxIntLiteral : Int
maxIntLiteral = 4611686018427387903

-- 十进制字面量的累加。每位先判「再乘 10 加 d 是否会超出 maxIntLiteral」，越界即报错；
-- 因此 `4611686018427387903` 仍合法，`...904` 起报 `LX_IntLiteralOutOfRange`。
export collectInt : Int -> Chars -> Int -> Check (Int, Chars)
collectInt fuel cs acc =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (acc, cs)
  else
    let
      c = charsPeek cs
    in if isDigit c then
      let
        d = c - 48
      in if acc > (maxIntLiteral - d) / 10 then lexErr0At (lexSpanAt (charsPos cs)) IntLiteralOutOfRange else collectInt (fuel - 1) (charsStep c cs) (acc * 10 + d)
    else
      OkC (acc, cs)

-- ---------------------------------------------------------------
-- 浮点字面量（`digits '.' digits`）
-- ---------------------------------------------------------------
-- 先看数字串后面是否是「`.` + 数字」，是才走浮点扫描；否则走整数扫描
-- （含 `LX_IntLiteralOutOfRange` 语义）。这样普通整数路径没有额外分配。
-- | 数字串后面是否紧跟「`.` + 数字」：是则整段按浮点字面量扫描，否则走整数路径。
export digitRunIsFloat : Int -> Chars -> Check Bool
digitRunIsFloat fuel cs =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC False
  else
    let
      c = charsPeek cs
    in if isDigit c then digitRunIsFloat (fuel - 1) (charsStep c cs) else if c == 46 then OkC (isDigit (charsPeekAt 1 cs)) else OkC False

-- 收集 `digits '.' digits` 的原始文本（首字符已消费，acc 是逆序的数字字符）。
-- | 收集浮点字面量 `digits . digits` 的原始文本；遇到 `.` 后交给 `collectFrac`。
export collectFloat : Int -> Chars -> List Int -> Check (String, Chars)
collectFloat fuel cs acc =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (strPack (reverse acc), cs)
  else
    let
      c = charsPeek cs
    in if isDigit c then collectFloat (fuel - 1) (charsStep c cs) (c :: acc) else if c == 46 then collectFrac (fuel - 1) (charsStep c cs) (c :: acc) else OkC (strPack (reverse acc), cs)

-- | 收集浮点字面量的小数部分（`.` 已消费），遇到非数字即停止。
export collectFrac : Int -> Chars -> List Int -> Check (String, Chars)
collectFrac fuel cs acc =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (strPack (reverse acc), cs)
  else
    let
      c = charsPeek cs
    in if isDigit c then collectFrac (fuel - 1) (charsStep c cs) (c :: acc) else OkC (strPack (reverse acc), cs)

export collectOp : Int -> Chars -> List Int -> Check (String, Chars)
collectOp fuel cs acc =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    OkC (strPack (reverse acc), cs)
  else
    let
      c = charsPeek cs
    in if isOpChar c then collectOp (fuel - 1) (charsStep c cs) (c :: acc) else OkC (strPack (reverse acc), cs)

-- ---------------------------------------------------------------
-- 字符串 / 模板字面量
--
-- 单行 `"..."`：转义 `\n \t \r \" \\ \' \$`；`${expr}` 插值；原始换行是
-- `LX_UnterminatedString`。
-- 多行 `"""..."""`：内容逐字（原始换行 / tab / `"` / `""` 都可以），**紧跟开引号的一个
-- 换行不计入内容**；遇 `"""` 结束；转义与插值同样生效。
--
-- 洞内 token 由同一套词法（`lexHoleTokens` → `lexOneToken`）原位产出，位置天然是绝对
-- 源码位置；洞里的注释随 `skipTrivia` 跳过（不进入 AST / 注释表——已知边界）。
-- ---------------------------------------------------------------
-- 转义字符 → 实际码点（`\$` 用来写一个字面 `${`）。
export decodeEscape : Int -> Maybe Int
decodeEscape 110 = Just 10
decodeEscape 116 = Just 9
decodeEscape 114 = Just 13
decodeEscape 34 = Just 34
decodeEscape 92 = Just 92
decodeEscape 39 = Just 39
decodeEscape 36 = Just 36
decodeEscape other = Nothing

export dropOpeningNewline : Chars -> Chars
dropOpeningNewline cs =
  if charsEmpty cs then
    cs
  else
    let
      c = charsPeek cs
    in if c == 10 then charsStep c cs else cs

export flushText : List Int -> List TmplPart -> List TmplPart
flushText [] parts = parts
flushText acc parts = TPText (strPack (reverse acc)) :: parts

-- 扫描模板正文。`multi` = 是否 `"""`；入口位置在**开引号之后**。
-- 返回：(parts（正序）、(字面量之后的 Chars, 结束引号位置))。
export scanTemplateText : Int -> Bool -> Chars -> List Int -> List TmplPart -> Check (List TmplPart, Chars, Pos)
-- 单行结束 `"`；单行不允许原始换行
scanTemplateText fuel multi cs acc parts =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    lexErr0At (lexSpanAt (charsPos cs)) UnterminatedString
  else
    let
      c = charsPeek cs
      c2 = charsPeekAt 1 cs
      c3 = charsPeekAt 2 cs
      p = charsPos cs
    in if c == 36 then
      if c2 == 123 then
        case lexHoleTokens (fuel - 1) 0 (charsNext2 cs) [] of
          -- 插值洞：`${`
          ErrC e => ErrC e
          OkC (toks, cs2) => if charsPeek cs2 == 125 then scanTemplateText (fuel - 1) multi (charsNext cs2) [] (TPHole toks :: flushText acc parts) else lexErr0At (lexSpanAt p) UnterminatedInterpolation
      else
        scanTemplateText (fuel - 1) multi (charsStep c cs) (c :: acc) parts
    else if c == 92 then
      if c2 < 0 then
        lexErr0At (lexSpanAt p) UnterminatedString
      else
        case decodeEscape c2 of
          -- 转义
          Nothing => lexErr0At (lexSpanAt p) UnknownEscape
          Just d => scanTemplateText (fuel - 1) multi (charsNext2 cs) (d :: acc) parts
    else if multi && c == 34 then
      if c2 == 34 && c3 == 34 then
        let
          -- 多行结束 `"""`
          pos3 = charsPos2 cs
        in OkC (reverse (flushText acc parts), charsNext2 (charsNext cs), pos3)
      else
        scanTemplateText (fuel - 1) multi (charsStep c cs) (c :: acc) parts
    else if not multi && c == 34 then OkC (reverse (flushText acc parts), charsStep c cs, p) else if not multi && c == 10 then lexErr0At (lexSpanAt p) UnterminatedString else scanTemplateText (fuel - 1) multi (charsStep c cs) (c :: acc) parts

-- 洞内 token 扫描：从 `${` 之后开始，`{`/`}` 计深度，深度 0 的 `}` 不消费。
-- 内部字符串/注释由 token 词法（`lexOneToken` / `skipTrivia`）整体跳过。
export lexHoleTokens : Int -> Int -> Chars -> List PTok -> Check (List PTok, Chars)
lexHoleTokens fuel depth cs acc =
  if fuel <= 0 then
    icFuel "lexer"
  else
    case skipTrivia (fuel - 1) cs of
      ErrC e => ErrC e
      -- 洞内注释随 trivia 丢弃（不进 AST / 注释表）：已知边界，见模块头。
      OkC cs2 =>
        if charsEmpty cs2 then
          lexErr0At (lexSpanAt (charsPos cs2)) UnterminatedInterpolation
        else if charsPeek cs2 == 125 && depth == 0 then
          OkC (reverse acc, cs2)
        else
          case lexOneToken (fuel - 1) cs2 of
            ErrC e => ErrC e
            OkC (tok, cs3) => lexHoleTokens (fuel - 1) (depthAfter depth tok.ptokTok) cs3 (setTokEnd cs3 tok :: acc)

-- 洞的深度更新：`{` 加深、`}` 变浅；其它 token 不变。
export depthAfter : Int -> Tok -> Int
depthAfter depth (TSym "{") = depth + 1
depthAfter depth (TSym "}") = if depth > 0 then depth - 1 else 0
depthAfter depth _ = depth

-- 消费一个 token（调用方保证已 skipTrivia 且输入非空）。
export lexOneToken : Int -> Chars -> Check (PTok, Chars)
lexOneToken fuel cs =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsEmpty cs then
    icInternal "lexOneToken on empty input"
  else
    let
      c = charsPeek cs
      p = charsPos cs
      next = charsStep c cs
    in if c == 64 && startsWithVunaAt next then
      case collectInternalIdent (fuel - 1) next [c] of
        ErrC e => ErrC e
        OkC (name, cs2) => OkC (PTok (classifyIdent name) p, cs2)
    else if isIdentStart c then
      case collectIdent (fuel - 1) next [c] of
        ErrC e => ErrC e
        OkC (name, cs2) => OkC (PTok (classifyIdent name) p, cs2)
    else if isDigit c then
      case digitRunIsFloat (fuel - 1) next of
        ErrC e => ErrC e
        OkC True =>
          case collectFloat (fuel - 1) next [c] of
            ErrC e => ErrC e
            OkC (raw, cs2) => OkC (PTok (TFloat raw) p, cs2)
        OkC False =>
          case collectInt (fuel - 1) next (c - 48) of
            ErrC e => ErrC e
            OkC (n, cs2) => OkC (PTok (TInt n) p, cs2)
    else if c == 34 then
      lexStringToken (fuel - 1) next p
    else if c == 40 || c == 41 || c == 91 || c == 93 || c == 44 || c == 123 || c == 125 then
      OkC (PTok (TSym (strPack [c])) p, next)
    else if c == 96 then
      OkC (PTok (TSym "`") p, next)
    else if isOpChar c then
      case collectOp (fuel - 1) next [c] of
        -- 反引号中缀的定界符。`96` 不在 isOpChar 里（否则会与相邻符号粘成一个 token），
        -- 单独识别成 `TSym "`"`，由 parser 配对消费。
        ErrC e => ErrC e
        OkC (op, cs2) => OkC (PTok (TSym op) p, cs2)
    else
      lexErr0At (lexSpanAt p) UnexpectedCharacter

-- `"..."` / `"""..."""`：判定形式后走模板扫描，再决定 token 形态。
-- 单行且无洞 → `TStr`；其余（多行 / 含洞）→ `TTmpl`。
export lexStringToken : Int -> Chars -> Pos -> Check (PTok, Chars)
lexStringToken fuel cs p =
  if fuel <= 0 then
    icFuel "lexer"
  else if charsPeek cs == 34 && charsPeekAt 1 cs == 34 then
    case scanTemplateText (fuel - 1) True (dropOpeningNewline (charsNext2 cs)) [] [] of
      ErrC e => ErrC e
      OkC (parts, cs2, endP) => OkC (PTok (TTmpl True parts endP) p, cs2)
  else
    lexSingleStringToken (fuel - 1) cs p

export lexSingleStringToken : Int -> Chars -> Pos -> Check (PTok, Chars)
lexSingleStringToken fuel body p =
  if fuel <= 0 then
    icFuel "lexer"
  else
    case scanTemplateText (fuel - 1) False body [] [] of
      ErrC e => ErrC e
      OkC (parts, cs2, endP) =>
        case parts of
          [TPText s] => OkC (PTok (TStr s) p, cs2)
          _ => OkC (PTok (TTmpl False parts endP) p, cs2)

-- ---------------------------------------------------------------
-- 主循环
-- ---------------------------------------------------------------
-- trivia 之后逐个 token，直到 EOF；注释在 trivia 阶段一并收集（`lexComments` 与 CST
-- 的 trivia 都取自这一次扫描）。每个 token 扣 1 步（各扫描器自带够用的 fuel：token
-- 内的字符数 ≤ 剩余源码长度，见 `sourceFuel` 的上界说明）。
-- 主循环是**尾递归**（token 逆序累积，出口一次 `reverse`）：递归深度等于源码 token 数，
-- 非尾形式在固定大小的 wasm 栈上会被大文件（如编译器自身的模块）耗尽。
export lexCharsWith : Int -> List Comment -> Chars -> Check (List PTok, List Comment)
lexCharsWith fuel acc0 cs =
  case lexCharsWithRev fuel acc0 [] cs of
    ErrC e => ErrC e
    OkC (toks, comments) => OkC (reverse toks, comments)

lexCharsWithRev : Int -> List Comment -> List PTok -> Chars -> Check (List PTok, List Comment)
lexCharsWithRev fuel acc toks cs =
  if fuel <= 0 then
    icFuel "lexer"
  else
    case skipTriviaComments fuel cs of
      ErrC e => ErrC e
      OkC (cs2, comments) =>
        if charsEmpty cs2 then
          OkC (PTok TEof (posWithEnd (charsPos cs2) (charsOffset cs2)) :: toks, reverse (append (reverse comments) acc))
        else
          case lexOneToken fuel cs2 of
            -- 末尾 trivia 里的注释也要收（否则文件尾注释会从注释表里消失）。
            ErrC e => ErrC e
            OkC (tok, cs3) => lexCharsWithRev (fuel - 1) (append (reverse comments) acc) (setTokEnd cs3 tok :: toks) cs3

-- | token 流主循环（不收集注释）：编译器热路径只走这一条。尾递归，见 `lexCharsWith`。
export lexChars : Int -> Chars -> Check (List PTok)
lexChars fuel cs =
  case lexCharsRev fuel [] cs of
    ErrC e => ErrC e
    OkC toks => OkC (reverse toks)

lexCharsRev : Int -> List PTok -> Chars -> Check (List PTok)
lexCharsRev fuel acc cs =
  if fuel <= 0 then
    icFuel "lexer"
  else
    case skipTrivia fuel cs of
      ErrC e => ErrC e
      OkC cs2 =>
        if charsEmpty cs2 then
          OkC (PTok TEof (posWithEnd (charsPos cs2) (charsOffset cs2)) :: acc)
        else
          case lexOneToken fuel cs2 of
            ErrC e => ErrC e
            OkC (tok, cs3) => lexCharsRev (fuel - 1) (setTokEnd cs3 tok :: acc) cs3

-- | 一次扫描的产物：token 流 + 注释表（源码顺序）。注释侧消费者（CST、
-- `parseSourceWithComments`、`lexComments`）用这一份，避免第二次全量词法。
export lexSourceWithComments : String -> Check (List PTok, List Comment)
lexSourceWithComments source = lexCharsWith (sourceFuel source) [] (Chars source 0 (Pos 1 1 0 0))

export lexSource : String -> Check (List PTok)
lexSource source = lexChars (sourceFuel source) (Chars source 0 (Pos 1 1 0 0))

export lexComments : String -> Check (List Comment)
lexComments source =
  case lexSourceWithComments source of
    ErrC e => ErrC e
    OkC (toks, comments) => OkC comments

-- 显式 fuel 的初值。
--
-- **上界说明**：主循环每个 token 扣 1，token 数 T ≤ len；token 内部的模板/洞扫描
-- 每个字符扣 1，且单个 token 的字符数 ≤ len，扫描起点处的存量 fuel 远大于它；
-- 注释扫描每次递归扣 1，每次至少消费 1 个字符 ⇒ 调用次数 ≤ len。
-- 取 4*len+64：任何合法输入都不会耗尽（耗尽即明确的 internal 错误，不静默半途而废）。
export sourceFuel : String -> Int
sourceFuel source = 4 * strLength source + 64
