-- | RAst → Ast 的桥：只服务仍以 Ast 为输入的消费者（iface 规范编码 / 工具）。
--
-- 桥模块同时导入两套类型，因此内部只用限定名；对外只暴露 `toAstExpr` 等函数名，
-- 不会把两套同名构造子带进调用方。
module Vuna.Compiler.Frontend.Rast.Bridge where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast as Ast
import Vuna.Compiler.Frontend.Rast as Rast
import Vuna.Compiler.Frontend.Rast.Name as RastName
import Vuna.Compiler.Frontend.Refs as Refs

-- | RAst 表达式 → Ast 表达式（名字还原为解析后的字符串）。
export toAstExpr : Rast.Expr -> Ast.Expr
toAstExpr (Rast.EVar n sp) = Ast.EVar (RastName.rnameKey n) (Ast.detachedNodeRef sp)
toAstExpr (Rast.EInt n sp) = Ast.EInt n (Ast.detachedNodeRef sp)
toAstExpr (Rast.EStr s sp) = Ast.EStr s (Ast.detachedNodeRef sp)
toAstExpr (Rast.EFloat raw sp) = Ast.EFloat raw (Ast.detachedNodeRef sp)
toAstExpr (Rast.EInterp parts sp) = Ast.EInterp (map toAstInterpPart parts) (Ast.detachedNodeRef sp)
toAstExpr (Rast.ELam params body sp) = Ast.ELam params (toAstExpr body) (Ast.detachedNodeRef sp)
toAstExpr (Rast.EApp fn args sp) =
  Ast.EApp (toAstExpr fn) (map toAstExpr args) (Ast.detachedNodeRef sp)
toAstExpr (Rast.EPi name implicit qty dom cod sp) =
  Ast.EPi name implicit qty (toAstExpr dom) (toAstExpr cod) (Ast.detachedNodeRef sp)
toAstExpr (Rast.ELet binds body rec_ sp) =
  Ast.ELet (map toAstBinding binds) (toAstExpr body) rec_ (Ast.detachedNodeRef sp)
-- 局部函数组只作为绑定值出现，由 `toAstBinding` 转成 `BClauses`；走到这里说明
-- 调用方把绑定值当成了普通表达式，保留一个写不出的标记而不是静默丢子树。
toAstExpr (Rast.ELocalFun _ sp) = Ast.EVar "#local-fun" (Ast.detachedNodeRef sp)
toAstExpr (Rast.ECase scrut alts sp) =
  Ast.ECase (toAstExpr scrut) (map toAstAlt alts) (Ast.detachedNodeRef sp)
toAstExpr (Rast.EIf c t f sp) =
  Ast.EIf (toAstExpr c) (toAstExpr t) (toAstExpr f) (Ast.detachedNodeRef sp)
toAstExpr (Rast.EField base fname sp) = Ast.EField (toAstExpr base) fname (Ast.detachedNodeRef sp)
toAstExpr (Rast.ERecord name fields sp) =
  Ast.ERecord (RastName.rnameKey name) (map toAstFieldValue fields) (Ast.detachedNodeRef sp)
toAstExpr (Rast.ERecUpdate base fields sp) =
  Ast.ERecUpdate (toAstExpr base) (map toAstFieldValue fields) (Ast.detachedNodeRef sp)
toAstExpr (Rast.EDo stmts sp) = Ast.EDo (map toAstStmt stmts) (Ast.detachedNodeRef sp)
toAstExpr (Rast.EAnn value ty sp) =
  Ast.EApp
    (Ast.EVar (Ast.reservedText Ast.RsAscribe) (Ast.detachedNodeRef sp))
    [toAstExpr value, toAstExpr ty]
    (Ast.detachedNodeRef sp)

toAstInterpPart : Rast.InterpPart -> Ast.InterpPart
toAstInterpPart (Rast.IPText s) = Ast.IPText s
toAstInterpPart (Rast.IPHole e) = Ast.IPHole (toAstExpr e)

-- 绑定 / 分支身份不进 Rast（Elab 不消费）；回到 Ast 时是 detached（工具侧用解析产物）。
toAstBinding : (Rast.Pat, Rast.Expr) -> Ast.Binding
toAstBinding (pat, Rast.ELocalFun clauses sp) =
  Ast.Binding (toAstPat pat) (Ast.BClauses (map toAstLocalClause clauses)) Nothing Ast.noNodeRef
toAstBinding (pat, value) =
  Ast.Binding (toAstPat pat) (Ast.BVal (toAstExpr value)) Nothing Ast.noNodeRef

-- 子句身份不进 Rast（Elab 不消费）；回到 Ast 时是 detached（工具侧用解析产物）。
toAstLocalClause : (List Rast.Pat, Rast.Expr) -> Ast.LocalClause
toAstLocalClause (pats, body) =
  Ast.LocalClause (map toAstPat pats) (toAstExpr body) Ast.noNodeRef Ast.noNodeRef

toAstAlt : (Rast.Pat, Rast.Expr) -> Ast.Alt
toAstAlt (pat, body) = Ast.Alt (toAstPat pat) (toAstExpr body) Ast.noNodeRef

toAstFieldValue : (String, Rast.Expr) -> (String, Ast.Expr)
toAstFieldValue (fname, value) = (fname, toAstExpr value)

toAstStmt : Rast.DoStmt -> Ast.DoStmt
toAstStmt (Rast.DBind pat value sp) =
  Ast.DBind (toAstPat pat) (toAstExpr value) (Ast.detachedNodeRef sp)
toAstStmt (Rast.DExpr value sp) = Ast.DExpr (toAstExpr value) (Ast.detachedNodeRef sp)
toAstStmt (Rast.DLet binds sp) = Ast.DLet (map toAstBinding binds) (Ast.detachedNodeRef sp)

toAstPat : Rast.Pat -> Ast.Pat
toAstPat (Rast.PVar name sp) = Ast.PVar name (Ast.detachedNodeRef sp)
toAstPat (Rast.PAs name inner sp) = Ast.PAs name (toAstPat inner) (Ast.detachedNodeRef sp)
toAstPat (Rast.PWild sp) = Ast.PWild (Ast.detachedNodeRef sp)
toAstPat (Rast.PCon name pats sp) =
  Ast.PCon (RastName.rnameKey name) (map toAstPat pats) (Ast.detachedNodeRef sp)
toAstPat (Rast.PInt n sp) = Ast.PInt n (Ast.detachedNodeRef sp)
toAstPat (Rast.PStr s sp) = Ast.PStr s (Ast.detachedNodeRef sp)
toAstPat (Rast.PRecord name fields sp) =
  Ast.PRecord (RastName.rnameKey name) (map toAstPatField fields) (Ast.detachedNodeRef sp)

toAstPatField : (String, Rast.Pat) -> (String, Ast.Pat)
toAstPatField (fname, pat) = (fname, toAstPat pat)

-- | Ast 表达式 → RAst（解码路径用；名字按无作用域分类）。
export toRastExpr : Ast.Expr -> Rast.Expr
toRastExpr e = Rast.ofExpr (Refs.annotateExpr e) e

-- | Ast 声明列表 → RAst（Loader → Elab 的边界）。
export toRastDecls : List Ast.Decl -> List Rast.Decl
toRastDecls decls = Rast.ofDecls decls

-- | 单条 Ast 声明 → RAst。
export toRastDecl : Ast.Decl -> Rast.Decl
toRastDecl d = Rast.ofDecl (Refs.annotateDecls [d]) d

-- | RAst 声明列表 → Ast（iface / 规范编码等仍以 Ast 为输入的消费者）。
export toAstDecls : List Rast.Decl -> List Ast.Decl
toAstDecls decls = map toAstDecl decls

export toAstDecl : Rast.Decl -> Ast.Decl
toAstDecl (Rast.DData name params kind ctors derivings via repr lin sp) =
  Ast.DData
    name
    params
    (toAstExpr kind)
    (map toAstCtor ctors)
    derivings
    via
    repr
    lin
    (detachedNodeRef sp)
toAstDecl (Rast.DAxiom name ty sp) = Ast.DAxiom name (toAstExpr ty) (detachedNodeRef sp)
toAstDecl (Rast.DExtern name cName ty sp) =
  Ast.DExtern name cName (toAstExpr ty) (detachedNodeRef sp)
toAstDecl (Rast.DSig name ctx ty sp) =
  Ast.DSig name (map toAstExpr ctx) (toAstExpr ty) (detachedNodeRef sp)
toAstDecl (Rast.DFun name pats body sp) =
  Ast.DFun name (map toAstPat pats) (toAstExpr body) (detachedNodeRef sp)
toAstDecl (Rast.DRecord name params fields derivings via repr lin sp) =
  Ast.DRecord name params (map toAstField fields) derivings via repr lin (detachedNodeRef sp)
toAstDecl (Rast.DTrait name params supers methods sp) =
  Ast.DTrait
    name
    (map toAstTraitParam params)
    (map toAstExpr supers)
    (map toAstTraitMethod methods)
    (detachedNodeRef sp)
toAstDecl (Rast.DInstance ctx head methods sp) =
  Ast.DInstance (map toAstExpr ctx) (toAstExpr head) (map toAstDecl methods) (detachedNodeRef sp)

toAstCtor : Rast.Ctor -> Ast.Ctor
toAstCtor (Rast.Ctor name ty arity sp) = Ast.Ctor name (toAstExpr ty) arity (Ast.detachedNodeRef sp)

toAstField : Rast.Field -> Ast.Field
toAstField (Rast.Field name ty sp) = Ast.Field name (toAstExpr ty) (Ast.detachedNodeRef sp)

toAstTraitParam : Rast.TraitParam -> Ast.TraitParam
toAstTraitParam (Rast.TraitParam name kind) = Ast.TraitParam name (maybeMap toAstExpr kind)

toAstTraitMethod : Rast.TraitMethod -> Ast.TraitMethod
toAstTraitMethod (Rast.TraitMethod name ty sp) =
  Ast.TraitMethod name (toAstExpr ty) (Ast.detachedNodeRef sp)

maybeMap : (a -> b) -> Maybe a -> Maybe b
maybeMap f Nothing = Nothing
maybeMap f (Just x) = Just (f x)

-- | Ast 模式 → RAst。
export toRastPat : Ast.Pat -> Rast.Pat
toRastPat (Ast.PVar name r) = Rast.PVar name (Ast.nodeRefSpan r)
toRastPat (Ast.PAs name inner r) = Rast.PAs name (toRastPat inner) (Ast.nodeRefSpan r)
toRastPat (Ast.PWild r) = Rast.PWild (Ast.nodeRefSpan r)
toRastPat (Ast.PCon name pats r) =
  Rast.PCon (RastName.classifyName name) (map toRastPat pats) (Ast.nodeRefSpan r)
toRastPat (Ast.PInt n r) = Rast.PInt n (Ast.nodeRefSpan r)
toRastPat (Ast.PStr s r) = Rast.PStr s (Ast.nodeRefSpan r)
toRastPat (Ast.PRecord name fields r) =
  Rast.PRecord (RastName.classifyName name) (map toRastPatField fields) (Ast.nodeRefSpan r)

toRastPatField : (String, Ast.Pat) -> (String, Rast.Pat)
toRastPatField (fname, pat) = (fname, toRastPat pat)
