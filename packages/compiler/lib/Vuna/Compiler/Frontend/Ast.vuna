module Vuna.Compiler.Frontend.Ast where

-- Vuna.Compiler.Frontend.Ast：语法类型与 AST 辅助函数。
import Vuna.Compiler.Base.Common
export module Vuna.Compiler.Frontend.Reserved

-- 保留 / 合成名的编码（`?hole` / `@vuna@...` / `#...`）在 `Frontend.Reserved`；
-- 这里只重导出，`Frontend.Ast.*` 的调用面保持不变。

-- | 语法节点的身份 + 源码区间。
--
-- id 由 parser 的 `withExtent` 分配（与建树事件携带的 id 相同），span 是同一区间的
-- 视图。身份不随 span 改写而变（宏展开、编辑）；没有解析身份的路径
-- （接口解码 / Rast 桥）用 `noNodeRef` / `detachedNodeRef`。
export record NodeRef where
  nodeRefId : Int
  nodeRefSpan : Span

export nodeRefId : NodeRef -> Int
nodeRefId r = r.nodeRefId

export nodeRefSpan : NodeRef -> Span
nodeRefSpan r = r.nodeRefSpan

-- | 没有节点身份的占位（接口解码：结构可还原，位置不可）。
export noNodeRef : NodeRef
noNodeRef = NodeRef (0 - 1) spanEmpty

-- | 保留区间、丢掉身份（Rast 桥与宏展开的过渡路径）。
export detachedNodeRef : Span -> NodeRef
detachedNodeRef sp = NodeRef (0 - 1) sp

-- 记录字段：字段名 + 类型表达式 + span。
export record Field(..) where
  fieldName : String
  fieldType : Expr
  fieldRef : NodeRef

export fieldSpan : Field -> Span
fieldSpan f = nodeRefSpan f.fieldRef

-- trait 方法签名：方法名 + 类型表达式 + span（span 覆盖「方法名到类型结束」，
-- 让方法级诊断/符号/注释锚点能落到方法行，而不是整条 trait 声明行）。
export record TraitMethod(..) where
  traitMethodName : String
  traitMethodType : Expr
  traitMethodRef : NodeRef

export traitMethodSpan : TraitMethod -> Span
traitMethodSpan m = nodeRefSpan m.traitMethodRef

-- 多参数 trait 的显式 kind 参数：`trait C (a : Type) (r : Row)`；裸参数 kind = Nothing。
export record TraitParam(..) where
  traitParamName : String
  traitParamKind : Maybe Expr

export data Pat(..) : Type where
  PVar : String -> Span -> Pat
  -- as-pattern（`x@pat` / `(pat)@x`）：匹配内层模式，并把整个匹配值绑定到 x。
  PAs : String -> Pat -> Span -> Pat
  PWild : Span -> Pat
  PCon : String -> List Pat -> Span -> Pat
  PInt : Int -> Span -> Pat
  PStr : String -> Span -> Pat
  PRecord : String -> List (Pair String Pat) -> Span -> Pat

export data InterpPart(..) : Type where
  IPText : String -> InterpPart
  IPHole : Expr -> InterpPart

-- 显式 binder quantity。源码写法 `(0 x : A)` / `(1 x : A)`；不写 = ω。
-- 只列可写出的两档；`RigOmega` 由「没有 Qty」表示，不引入 ω 字形。
export data Qty(..) : Type where
  Q0 : Qty
  Q1 : Qty

export qtyIsZero : Qty -> Bool
qtyIsZero Q0 = True
qtyIsZero Q1 = False

-- | 记录表示三档声明（`alias record` / `record` / `boxed record`）。
-- `ReprAuto` = 未声明：回落到底层自动去装箱推断。
-- `ReprAlias` = 声明去装箱别名：构造/投影定义性恒等，要求擦除后恰好一个运行时字段。
-- `ReprBoxed` = 声明强制装箱（FFI/ABI 稳定）。档位进 DtData 与 iface（D7：声明优先）。
export data ReprTier(..) : Type where
  ReprAuto : ReprTier
  ReprAlias : ReprTier
  ReprBoxed : ReprTier

-- | 档位的源码前缀（Fmt 用；`ReprAuto` 无前缀）。
export reprPrefix : ReprTier -> String
reprPrefix ReprAuto = ""
reprPrefix ReprAlias = "alias "
reprPrefix ReprBoxed = "boxed "

export data Expr(..) : Type where
  EVar : String -> Span -> Expr
  EInt : Int -> Span -> Expr
  EStr : String -> Span -> Expr
  -- λ：参数名 + 参数名自身的源码位置（`spanEmpty` = 合成 binder），体与整体 span。
  ELam : List (Pair String Span) -> Expr -> Span -> Expr
  EApp : Expr -> List Expr -> Span -> Expr
  -- 命名 Pi：`(x : A) -> B` 与隐式 `{x : A} -> B`；第三个字段是显式 quantity
  -- （`Nothing` = 默认 ω）。
  -- 匿名 `A -> B` 仍沿用 `EApp (EVar "->") [A, B]` 编码（默认 ω）。
  EPi : String -> Bool -> Maybe Qty -> Expr -> Expr -> Span -> Expr
  ELet : List (Pair Pat Expr) -> Expr -> Bool -> Span -> Expr
  -- 局部函数组（where/let 内的多 clause 函数）。
  -- 只作为 `ELet` 绑定值出现：每个 clause 是「参数模式列表 + body」。
  -- 由 Elab 用 `Elab.Match.multiToExpr` 降级成 lambda + 模式矩阵（与顶层 DFun 同一路径）。
  ELocalFun : List (Pair (List Pat) Expr) -> Span -> Expr
  ECase : Expr -> List (Pair Pat Expr) -> Span -> Expr
  EIf : Expr -> Expr -> Expr -> Span -> Expr
  EField : Expr -> String -> Span -> Expr
  ERecord : String -> List (Pair String Expr) -> Span -> Expr
  ERecUpdate : Expr -> List (Pair String Expr) -> Span -> Expr
  EDo : List DoStmt -> Span -> Expr
  -- 中缀链与括号。parser 的**中间产物**：Loader 按 fixity 表重排并消除它们
  -- （`Loader.Resolve.reorderProgram`），Elab / codegen 永远不应看到（残留即 internal
  -- error）；Fmt / Index / Lsp 在 parse 后处理它们。
  EInfix : String -> Expr -> Expr -> Span -> Expr
  EParen : Expr -> Span -> Expr
  -- 反引号中缀 `` a `f` b ``（f 是普通值名或符号名；Loader 按名字查 fixity）。
  -- 与 EInfix/EParen 同属 parser 中间产物：rename 模式（Loader 正常路径）后不存在。
  EBacktick : String -> Expr -> Expr -> Span -> Expr
  -- section：op 值 / 左 section / 右 section。同样是 parser 中间产物，
  -- Loader 在名字解析前消除成 EVar / lambda。
  ESectOp : String -> Span -> Expr
  ESectL : String -> Expr -> Span -> Expr
  ESectR : Expr -> String -> Span -> Expr
  -- 表达式类型标注。只由 parser 的 where 绑定签名生成（`g : Int -> Int` 行
  -- 绑定到随后的 `g ... = ...` 子句），Elab 精化时据此把 where 组按签名递归提升；
  -- 普通表达式位置不产生它，Fmt 在非 where 位置把它当透明括号渲染。
  EAnn : Expr -> Expr -> Span -> Expr
  -- 模板字符串字面量。`multi` = 是否 `"""` 形式（Fmt 用它保留书写形式；单行
  -- 字面量保持单行转义形式）。`Loader.Resolve` 把它降级成 `Base.Trait.Interp.interp`
  -- 调用 + `++` 链；Fmt / Lint / Index / Doc 在 parse 后处理它。
  EInterp : Bool -> List InterpPart -> Span -> Expr
  -- `Float` 字面量：原始十进制文本（放末尾以保持既有构造子 tag 顺序）。
  EFloat : String -> Span -> Expr

-- fixity 声明（`infixl 6 +`）。
-- 只进入 `SourceFile.fixities`，由 Loader 在中缀重排时消费；**不进入 `Decl`**，避免所有
-- Decl 匹配点扩散。
export record FixityDecl(..) where
  fixityOp : String
  fixityLevel : Int
  fixityAssoc : Int
  fixityRef : NodeRef

export fixitySpan : FixityDecl -> Span
fixitySpan d = nodeRefSpan d.fixityRef

-- do 语句：`pat <- expr` 或裸表达式；最后一条必须是裸表达式。
export data DoStmt(..) : Type where
  DBind : Pat -> Expr -> NodeRef -> DoStmt
  DExpr : Expr -> NodeRef -> DoStmt
  -- `let pat = e`（同组可多条，含签名行与局部函数组）：纯绑定，只对块内后续语句可见。
  DLet : List (Pair Pat Expr) -> NodeRef -> DoStmt

export record Ctor(..) where
  ctorName : String
  ctorType : Expr
  ctorArity : Int
  ctorRef : NodeRef

export ctorSpan : Ctor -> Span
ctorSpan c = nodeRefSpan c.ctorRef

export data Decl(..) : Type where
  -- `data Name params : kind where`；kind 是索引族的类型表达式（只接受 `Type`）。
  -- 末位 `Bool` 是 `lin data` 标记。
  -- `derivings` 后的 `Bool` 是 `deriving via field` 标记（仅 record 允许）。
  -- `viaField` 后的 `ReprTier` 是表示档位（data 恒为 `ReprAuto`，record 由
  -- `alias`/`boxed` 前缀给出）；降级与 DtData 都要携带它。
  DData : String -> List String -> Expr -> List Ctor -> List String -> Bool -> ReprTier -> Bool -> NodeRef -> Decl
  -- `axiom name : Ty` —— 无体的可擦除/不透明顶层（D10）。
  -- 它是**类型层**定义：类型层引用合法，运行时使用由擦除检查报错。
  DAxiom : String -> Expr -> NodeRef -> Decl
  -- 受限 FFI：`extern "c_name" : Ty`（无体；运行时由 C 链接提供）。
  DExtern : String -> String -> Expr -> NodeRef -> Decl
  -- 顶层签名可带 trait 约束上下文（`f : Eq a, Show b => τ`）；ctx 是约束表达式
  -- （每个形如 `C arg`，都是单参数 trait 应用）。空 ctx = 无显式约束。
  DSig : String -> List Expr -> Expr -> NodeRef -> Decl
  DFun : String -> List Pat -> Expr -> NodeRef -> Decl
  -- 末位 `Bool` 是 `lin record` 标记（降级成 DData 时透传）。
  -- `derivings` 后的 `Bool` 是 `deriving via field` 标记。
  -- `viaField` 后的 `ReprTier` 是表示档位（`alias`/`boxed` 前缀，缺省 `ReprAuto`）。
  DRecord : String -> List String -> List Field -> List String -> Bool -> ReprTier -> Bool -> NodeRef -> Decl
  -- `supers` 是父类约束（`Functor f => Applicative f` 的前缀），放在参数与方法之间。
  DTrait : String -> List TraitParam -> List Expr -> List TraitMethod -> NodeRef -> Decl
  DInstance : List Expr -> Expr -> List Decl -> NodeRef -> Decl

-- 模块头与导出项。
-- XBare 是裸名导出，XTypeAll 是 `T(..)`，XModule 是 `module B` 整模块重导出。
-- XTypeSome 是 `T(A, B)`（D11：data 构造子 / trait 方法子集；顺序无语义）。
-- XNamespace 是 `export module C [as X]`：不带 alias 时平铺重导出 C，带 alias 时只导出命名空间路径。
export data ExportItem(..) : Type where
  XBare : String -> Span -> ExportItem
  XTypeAll : String -> Span -> ExportItem
  XTypeSome : String -> List String -> Span -> ExportItem
  XModule : String -> Span -> ExportItem
  XNamespace : String -> Maybe String -> Span -> ExportItem

-- D11：逐定义 `export` 的成员集合（`T` / `T(..)` / `T(A, B)`）。
export data ExportMembers(..) : Type where
  EMNone : ExportMembers
  EMAll : ExportMembers
  EMOnly : List String -> ExportMembers

-- D11：一条逐定义导出声明。
-- `ESValue` = 值/axiom/extern/用户符号；`ESType` = data/record/trait + 成员面。
export data ExportSpec(..) : Type where
  ESValue : String -> Span -> ExportSpec
  ESType : String -> ExportMembers -> Span -> ExportSpec

export exportSpecName : ExportSpec -> String
exportSpecName (ESValue name sp) = name
exportSpecName (ESType name members sp) = name

export exportSpecSpan : ExportSpec -> Span
exportSpecSpan (ESValue name sp) = sp
exportSpecSpan (ESType name members sp) = sp

-- D11：定义归约修饰符。
export data Opacity(..) : Type where
  OpacityOpaque : Opacity
  OpacityTransparent : Opacity
  OpacityAbstract : Opacity

export record OpacitySpec(..) where
  opacityName : String
  opacityKind : Opacity
  opacitySpan : Span

export opacitySpecName : OpacitySpec -> String
opacitySpecName (OpacitySpec name kind sp) = name

export opacitySpecSpan : OpacitySpec -> Span
opacitySpecSpan (OpacitySpec name kind sp) = sp

-- 模块头：模块名、是否写了显式导出列表、导出项、span；
-- D11：逐定义导出/重导出/归约修饰符也挂在模块头（入口文件没有模块头，不需要它们）。
export record ModDecl(..) where
  modDeclName : String
  modDeclHasExportList : Bool
  modDeclExportItems : List ExportItem
  modDeclExports : List ExportSpec
  modDeclReexports : List ExportItem
  modDeclOpacity : List OpacitySpec
  modDeclSpan : Span

-- parser 的产物：可选模块头 + imports + fixity/别名声明 + 顶层声明。
export record SourceFile(..) where
  sourceFileModDecl : Maybe ModDecl
  sourceFileImports : List Import
  sourceFileFixities : List FixityDecl
  sourceFileDecls : List Decl
  -- 无模块头的模块文件也要能逐定义 export（入口文件在 Flatten 丢弃这些字段）。
  sourceFileExports : List ExportSpec
  sourceFileReexports : List ExportItem
  sourceFileOpacity : List OpacitySpec

-- 各节点的源码 span 访问器。
export patSpan : Pat -> Span
patSpan (PVar name sp) = sp
patSpan (PAs name inner sp) = sp
patSpan (PWild sp) = sp
patSpan (PCon name pats sp) = sp
patSpan (PInt n sp) = sp
patSpan (PStr s sp) = sp
patSpan (PRecord name fields sp) = sp

-- | 模式蕴含：`patSubsumes p q` = 任何匹配 `q` 的值都匹配 `p`（变量 / `_` 顶，as-pattern
--   只看内层）。**只做语法蕴含**：同一个构造子的子模式逐位比较，字面量同值，record 字段
--   逐名比较。并集覆盖（`True` / `False` 之后再来 `_`）不在这一层判，由精化期的模式矩阵
--   可达性检查负责。
export patSubsumes : Pat -> Pat -> Bool
patSubsumes (PVar _ _) q = True
patSubsumes (PWild _) q = True
patSubsumes (PAs _ inner _) q = patSubsumes inner q
patSubsumes p (PAs _ inner _) = patSubsumes p inner
patSubsumes (PCon c ps _) (PCon c2 qs _) = c == c2 && subsumePatList ps qs
patSubsumes (PCon _ _ _) _ = False
patSubsumes (PInt n _) (PInt m _) = n == m
patSubsumes (PInt _ _) _ = False
patSubsumes (PStr s _) (PStr t _) = s == t
patSubsumes (PStr _ _) _ = False
patSubsumes (PRecord name fs _) (PRecord name2 fs2 _) = name == name2 && subsumePatFields fs fs2
patSubsumes (PRecord _ _ _) _ = False

subsumePatList : List Pat -> List Pat -> Bool
subsumePatList [] [] = True
subsumePatList (p :: ps) (q :: qs) = patSubsumes p q && subsumePatList ps qs
subsumePatList _ _ = False

-- record 模式可以只写部分字段：`p` 约束了而 `q` 没写的字段，`q` 照样匹配全部取值。
subsumePatFields : List (Pair String Pat) -> List (Pair String Pat) -> Bool
subsumePatFields [] _ = True
subsumePatFields ((Pair fn fp) :: rest) qs =
  case fieldPatOf fn qs of
    Just qp => patSubsumes fp qp && subsumePatFields rest qs
    Nothing => subsumePatFields rest qs

fieldPatOf : String -> List (Pair String Pat) -> Maybe Pat
fieldPatOf fn [] = Nothing
fieldPatOf fn ((Pair n p) :: rest) = if n == fn then Just p else fieldPatOf fn rest

-- | 子句蕴含（参数个数不同时恒为 `False`：arity 由 `TC_DefMoreParams` 单独报）。
--   零参子句之间恒为 `True`——同名的第二条零参定义不可达。
export clauseSubsumedBy : List Pat -> List Pat -> Bool
clauseSubsumedBy ps qs = subsumePatList ps qs

export exprSpan : Expr -> Span
exprSpan (EVar name sp) = sp
exprSpan (EInfix op lhs rhs sp) = sp
exprSpan (EParen inner sp) = exprSpan inner
exprSpan (EBacktick name lhs rhs sp) = sp
exprSpan (ESectOp op sp) = sp
exprSpan (ESectL op rhs sp) = sp
exprSpan (ESectR lhs op sp) = sp
exprSpan (EInt n sp) = sp
exprSpan (EStr s sp) = sp
exprSpan (EFloat raw sp) = sp
exprSpan (ELam ps body sp) = sp
exprSpan (EApp fn args sp) = sp
exprSpan (EPi name implicit qty dom cod sp) = sp
exprSpan (ELet binds body _ sp) = sp
exprSpan (ELocalFun clauses sp) = sp
exprSpan (ECase scrut alts sp) = sp
exprSpan (EIf c t e sp) = sp
exprSpan (EField base f sp) = sp
exprSpan (ERecord name fields sp) = sp
exprSpan (ERecUpdate base fields sp) = sp
exprSpan (EDo stmts sp) = sp
exprSpan (EAnn inner ty sp) = sp
exprSpan (EInterp multi parts sp) = sp

export doStmtSpan : DoStmt -> Span
doStmtSpan (DBind pat expr r) = nodeRefSpan r
doStmtSpan (DExpr expr r) = nodeRefSpan r
doStmtSpan (DLet binds r) = nodeRefSpan r

-- | 声明的节点身份 + 区间。
export declRef : Decl -> NodeRef
declRef (DData name params kind ctors derivings viaField repr lin r) = r
declRef (DAxiom name ty r) = r
declRef (DExtern name cName ty r) = r
declRef (DSig name ctx ty r) = r
declRef (DFun name pats body r) = r
declRef (DRecord name params fields derivings viaField repr lin r) = r
declRef (DTrait name params supers methods r) = r
declRef (DInstance ctxE head methods r) = r

export declSpan : Decl -> Span
declSpan d = nodeRefSpan (declRef d)

export fieldName : Field -> String
fieldName (Field name ty sp) = name

export fieldType : Field -> Expr
fieldType (Field name ty sp) = ty

export traitMethodName : TraitMethod -> String
traitMethodName (TraitMethod name ty sp) = name

export record Import(..) where
  importName : String
  importIsQualified : Bool
  importAlias : Maybe String
  importRef : NodeRef

export importSpan : Import -> Span
importSpan i = nodeRefSpan i.importRef

export exportItemSpan : ExportItem -> Span
exportItemSpan (XBare name sp) = sp
exportItemSpan (XTypeAll name sp) = sp
exportItemSpan (XTypeSome name members sp) = sp
exportItemSpan (XModule name sp) = sp
exportItemSpan (XNamespace name _ sp) = sp

export collectClauses : List Decl -> String -> List (Pair (List Pat) Expr)
collectClauses [] name = []
collectClauses (d :: rest) name =
  case d of
    DFun n pats body _ =>
      if n == name then Pair pats body :: collectClauses rest name else collectClauses rest name
    _ => collectClauses rest name

export clausesFor : List Decl -> String -> List (Pair (List Pat) Expr)
clausesFor decls name = collectClauses decls name

export funArity : String -> List Decl -> Maybe Int
funArity name decls =
  case clausesFor decls name of
    [] => Nothing
    (Pair pats body) :: _ => Just (natToInt (length pats))

export ctorName : Ctor -> String
ctorName (Ctor name ty arity _) = name

-- canonical 构造子名的最后一段（短名）。data 构造子的 canonical 形如
-- `Module.Data.Ctor`（entry 文件是 `Data.Ctor`），短名用于族内查找/OCaml 名字/诊断。
-- | 短名（canonical 名的最后一段）；族内查找 / OCaml 名字 / 诊断用。
export ctorShortName : String -> String
ctorShortName name = lastSeg name

-- 用户可见的构造子名：`FamilyShort.Ctor`（单段名原样返回）。
-- 不用完整的 `Module.Data.Ctor`：那会把模块路径泄漏进诊断。
-- | 诊断里显示的构造子名 `FamilyShort.Ctor`（单段名原样返回）。
export ctorDisplayName : String -> String
ctorDisplayName name =
  case splitLastDot (splitOnDot name) of
    Pair [] base => base
    Pair revPrefix base =>
      case reverse revPrefix of
        [] => base
        fam :: rest => "${fam}.${base}"

export ctorType : Ctor -> Expr
ctorType (Ctor name ty arity _) = ty

export typeArity : Expr -> Int
typeArity (EApp (EVar "->" _) ([x, rest]) _) = 1 + typeArity rest
typeArity _ = 0

export lookupCtorArity : String -> List Ctor -> Maybe Int
lookupCtorArity name [] = Nothing
lookupCtorArity name (c :: rest) =
  if ctorName c == name then Just c.ctorArity else lookupCtorArity name rest

export ctorArity : String -> List Decl -> Maybe Int
ctorArity name [] = Nothing
ctorArity name (d :: rest) =
  case d of
    DData dname params kind ctors derivings viaField repr lin sp =>
      case lookupCtorArity name ctors of
        Just arity => Just arity
        Nothing => ctorArity name rest
    DRecord dname params fields derivings viaField repr lin sp =>
      if name == dname then Just (natToInt (length fields)) else ctorArity name rest
    _ => ctorArity name rest

export declNames : Decl -> List String
declNames (DFun name pats body _) = [name]
declNames (DAxiom name ty _) = [name]
declNames (DExtern name cName ty _) = [name]
declNames (DSig name ctx ty _) = [name]
declNames (DData dname params kind ctors derivings viaField repr lin _) = map ctorName ctors
declNames (DRecord dname params fields derivings viaField repr lin _) = [dname]
declNames (DTrait tname params supers methods _) = map traitMethodName methods
declNames (DInstance ctxE head methods _) = []

-- 顶层可见名字（把 data / record / trait 的**类型名**也算进来）。
-- Loader 用它判断「是不是本模块声明的名字」；DT 的类型名可以在值层位置出现
-- （`Vec n Nat` 的 `Nat`），所以必须一并认出来。语义仍由下游检查器决定。
export topNames : List Decl -> List String
topNames decls = concatMap declNames decls

export declAllNames : Decl -> List String
declAllNames (DData dname params kind ctors derivings viaField repr lin _) =
  dname :: map ctorName ctors
declAllNames (DRecord dname params fields derivings viaField repr lin _) = [dname]
declAllNames (DTrait tname params supers methods _) = tname :: map traitMethodName methods
declAllNames d = declNames d

_declCtors : Decl -> List String
_declCtors (DData dname params kind ctors derivings viaField repr lin _) = map ctorName ctors
_declCtors (DRecord dname params fields derivings viaField repr lin _) = [dname]
_declCtors (DTrait tname params supers methods _) = map traitMethodName methods
_declCtors _ = []

export ctorsOf : List Decl -> List String
ctorsOf decls = concatMap _declCtors decls

export declTypeNames : Decl -> List String
declTypeNames (DData name params kind ctors derivings viaField repr lin _) = [name]
declTypeNames (DRecord name params fields derivings viaField repr lin _) = [name]
declTypeNames (DTrait name params supers methods _) = [name]
declTypeNames _ = []

export typeNamesOf : List Decl -> List String
typeNamesOf decls = concatMap declTypeNames decls

export declDerivings : Decl -> List String
declDerivings (DData name params kind ctors derivings viaField repr lin _) = derivings
declDerivings (DRecord name params fields derivings viaField repr lin _) = derivings
declDerivings _ = []
