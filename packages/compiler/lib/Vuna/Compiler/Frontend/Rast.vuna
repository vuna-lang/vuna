-- | 解析后语法层（RAst）：名字是身份（`RName`），糖已由 Loader 去掉。
--
-- 形状与 [Vuna.Compiler.Frontend.Ast] 大体对应（便于 Elab 逐步迁移）：局部函数组在 Ast
-- 是 `BindingValue.BClauses`，在 Rast 仍以 `ELocalFun` 表达式作为 Elab 的输入。所有**引用**
-- 位置（变量、构造子、记录类型）都用 `RName`；binder 与声明名仍是源码短名。
-- `RName` 与字符串分类在 [Vuna.Compiler.Frontend.Rast.Name]（本模块重导出）。
module Vuna.Compiler.Frontend.Rast where

import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast as Ast
import Vuna.Compiler.Frontend.Rast.Name
export import Vuna.Compiler.Frontend.Ast (Qty, Q0, Q1, qtyIsZero, ReprTier, ReprAuto, ReprAlias, ReprBoxed, reprPrefix, FixityDecl, fixitySpan, Import, ExportItem, XBare, XTypeAll, XTypeSome, XModule, XNamespace, ExportMembers, EMNone, EMAll, EMOnly, ExportSpec, ESValue, ESType, exportSpecName, exportSpecSpan, Opacity, OpacityOpaque, OpacityTransparent, OpacityAbstract, OpacitySpec, opacitySpecName, opacitySpecSpan, ModDecl)
export module Vuna.Compiler.Frontend.Reserved

-- 保留 / 合成名的编码（`?hole` / `@vuna@...` / `#...`）在 `Frontend.Reserved`；
-- 这里只重导出，`Frontend.Rast.*` 的调用面保持不变。

-- 记录字段：字段名 + 类型表达式 + span。
export record Field(..) where
  fieldName : String
  fieldType : Expr
  fieldSpan : Span

-- trait 方法签名：方法名 + 类型表达式 + span（span 覆盖「方法名到类型结束」，
-- 让方法级诊断/符号/注释锚点能落到方法行，而不是整条 trait 声明行）。
export record TraitMethod(..) where
  traitMethodName : String
  traitMethodType : Expr
  traitMethodSpan : Span

-- 多参数 trait 的显式 kind 参数：`trait C (a : Type) (r : Row)`；裸参数 kind = Nothing。
export record TraitParam(..) where
  traitParamName : String
  traitParamKind : Maybe Expr

export data Pat(..) : Type where
  PVar : String -> Span -> Pat
  -- as-pattern（`x@pat` / `(pat)@x`）：匹配内层模式，并把整个匹配值绑定到 x。
  PAs : String -> Pat -> Span -> Pat
  PWild : Span -> Pat
  PCon : RName -> List Pat -> Span -> Pat
  PInt : Int -> Span -> Pat
  PStr : String -> Span -> Pat
  PRecord : RName -> List (String, Pat) -> Span -> Pat

export data InterpPart(..) : Type where
  IPText : String -> InterpPart
  IPHole : Expr -> InterpPart

export data Expr(..) : Type where
  EVar : RName -> Span -> Expr
  EInt : Int -> Span -> Expr
  EStr : String -> Span -> Expr
  -- λ：参数名 + 参数名自身的源码位置（`spanEmpty` = 合成 binder），体与整体 span。
  ELam : List (String, Span) -> Expr -> Span -> Expr
  EApp : Expr -> List Expr -> Span -> Expr
  -- 命名 Pi：`(x : A) -> B` 与隐式 `{x : A} -> B`；第三个字段是显式 quantity
  -- （`Nothing` = 默认 ω）。
  -- 匿名 `A -> B` 仍沿用 `EApp (EVar "->") [A, B]` 编码（默认 ω）。
  EPi : String -> Bool -> Maybe Qty -> Expr -> Expr -> Span -> Expr
  ELet : List (Pat, Expr) -> Expr -> Bool -> Span -> Expr
  -- 局部函数组（where/let 内的多 clause 函数）。
  -- 只作为 `ELet` 绑定值出现：每个 clause 是「参数模式列表 + body」。
  -- 由 Elab 用 `Elab.Match.multiToExpr` 降级成 lambda + 模式矩阵（与顶层 DFun 同一路径）。
  ELocalFun : List (List Pat, Expr) -> Span -> Expr
  ECase : Expr -> List (Pat, Expr) -> Span -> Expr
  EIf : Expr -> Expr -> Expr -> Span -> Expr
  EField : Expr -> String -> Span -> Expr
  ERecord : RName -> List (String, Expr) -> Span -> Expr
  ERecUpdate : Expr -> List (String, Expr) -> Span -> Expr
  EDo : List DoStmt -> Span -> Expr
  -- 括号、中缀链与 section 不在 AST 里（纯书写形式，见 `Frontend.Cst`）；
  -- 中缀链由 parser 降级成普通应用，section 由 parser 降级成 `EVar` / 单 binder λ。
  -- 表达式类型标注。只由 parser 的 where 绑定签名生成（`g : Int -> Int` 行
  -- 绑定到随后的 `g ... = ...` 子句），Elab 精化时据此把 where 组按签名递归提升；
  -- 普通表达式位置不产生它，Fmt 在非 where 位置把它当透明括号渲染。
  EAnn : Expr -> Expr -> Span -> Expr
  -- 模板字符串字面量。是否 `"""` 形式在 `Frontend.Cst`，AST 只保留语义分段。
  EInterp : List InterpPart -> Span -> Expr
  -- `Float` 字面量：原始十进制文本（放末尾以保持既有构造子 tag 顺序）。
  EFloat : String -> Span -> Expr

-- do 语句：`pat <- expr`、`let` 绑定或裸表达式；最后一条必须是裸表达式。
export data DoStmt(..) : Type where
  DBind : Pat -> Expr -> Span -> DoStmt
  DExpr : Expr -> Span -> DoStmt
  DLet : List (Pat, Expr) -> Span -> DoStmt

export record Ctor(..) where
  ctorName : String
  ctorType : Expr
  ctorArity : Int
  ctorSpan : Span

export data Decl(..) : Type where
  -- `data Name params : kind where`；kind 是索引族的类型表达式（只接受 `Type`）。
  -- 末位 `Bool` 是 `lin data` 标记。
  -- `derivings` 后的 `Bool` 是 `deriving via field` 标记（仅 record 允许）。
  -- `viaField` 后的 `ReprTier` 是表示档位（data 恒为 `ReprAuto`，record 由
  -- `alias`/`boxed` 前缀给出）；降级与 DtData 都要携带它。
  DData : String -> List String -> Expr -> List Ctor -> List String -> Bool -> ReprTier -> Bool -> Span -> Decl
  -- `axiom name : Ty` —— 无体的可擦除/不透明顶层（D10）。
  -- 它是**类型层**定义：类型层引用合法，运行时使用由擦除检查报错。
  DAxiom : String -> Expr -> Span -> Decl
  -- 受限 FFI：`extern "c_name" : Ty`（无体；运行时由 C 链接提供）。
  DExtern : String -> String -> Expr -> Span -> Decl
  -- 顶层签名可带 trait 约束上下文（`f : Eq a, Show b => τ`）；ctx 是约束表达式
  -- （每个形如 `C arg`，都是单参数 trait 应用）。空 ctx = 无显式约束。
  DSig : String -> List Expr -> Expr -> Span -> Decl
  DFun : String -> List Pat -> Expr -> Span -> Decl
  -- 末位 `Bool` 是 `lin record` 标记（降级成 DData 时透传）。
  -- `derivings` 后的 `Bool` 是 `deriving via field` 标记。
  -- `viaField` 后的 `ReprTier` 是表示档位（`alias`/`boxed` 前缀，缺省 `ReprAuto`）。
  DRecord : String -> List String -> List Field -> List String -> Bool -> ReprTier -> Bool -> Span -> Decl
  -- `supers` 是父类约束（`Functor f => Applicative f` 的前缀），放在参数与方法之间。
  DTrait : String -> List TraitParam -> List Expr -> List TraitMethod -> Span -> Decl
  DInstance : List Expr -> Expr -> List Decl -> Span -> Decl

-- D11：逐定义导出/重导出/归约修饰符也挂在模块头（入口文件没有模块头，不需要它们）。
-- parser 的产物：可选模块头 + imports + fixity/别名声明 + 顶层声明。
export record SourceFile(..) where
  sourceFileModDecl : Maybe ModDecl
  sourceFileImports : List Import
  sourceFileFixities : List FixityDecl
  sourceFileDecls : List Decl
  -- 无模块头的模块文件也要能逐定义 export（入口文件在 Flatten 丢弃这些字段）。
  sourceFileExports : List ExportSpec
  sourceFileReexports : List ExportItem
  sourceFileOpacity : List OpacitySpec

-- 各节点的源码 span 访问器。
export patSpan : Pat -> Span
patSpan (PVar name sp) = sp
patSpan (PAs name inner sp) = sp
patSpan (PWild sp) = sp
patSpan (PCon name pats sp) = sp
patSpan (PInt n sp) = sp
patSpan (PStr s sp) = sp
patSpan (PRecord name fields sp) = sp

export exprSpan : Expr -> Span
exprSpan (EVar name sp) = sp
exprSpan (EInt n sp) = sp
exprSpan (EStr s sp) = sp
exprSpan (EFloat raw sp) = sp
exprSpan (ELam ps body sp) = sp
exprSpan (EApp fn args sp) = sp
exprSpan (EPi name implicit qty dom cod sp) = sp
exprSpan (ELet binds body _ sp) = sp
exprSpan (ELocalFun clauses sp) = sp
exprSpan (ECase scrut alts sp) = sp
exprSpan (EIf c t e sp) = sp
exprSpan (EField base f sp) = sp
exprSpan (ERecord name fields sp) = sp
exprSpan (ERecUpdate base fields sp) = sp
exprSpan (EDo stmts sp) = sp
exprSpan (EAnn inner ty sp) = sp
exprSpan (EInterp parts sp) = sp

-- 节点计数与按规模派生的步数预算。
--
-- 精化 / 降级的入口用固定步数预算时，合法的大表达式（长算子链、长 `let` 链）
-- 会被误报成 `IC_FuelExhausted`；各阶段的递归深度不会超过节点数，所以入口按
-- 节点数派生、递归位置仍按 `fuel - 1` 递减。
export patWeight : Pat -> Int
patWeight (PVar _ _) = 1
patWeight (PAs _ inner _) = 1 + patWeight inner
patWeight (PWild _) = 1
patWeight (PCon _ pats _) = 1 + patWeightList pats
patWeight (PInt _ _) = 1
patWeight (PStr _ _) = 1
patWeight (PRecord _ fields _) = 1 + patWeightFields fields

patWeightList : List Pat -> Int
patWeightList [] = 0
patWeightList (p :: rest) = patWeight p + patWeightList rest

patWeightFields : List (String, Pat) -> Int
patWeightFields [] = 0
patWeightFields (f :: rest) = patWeight (secondOf f) + patWeightFields rest

-- | RAST 表达式节点数（含模式、局部函数 clause body / do 语句 / record 字段）。
--   每访问一个节点至少消耗 1 单位 fuel，因此 `exprBudget` 的上界成立；不要退回固定常数。
export exprWeight : Expr -> Int
exprWeight (EVar _ _) = 1
exprWeight (EInt _ _) = 1
exprWeight (EStr _ _) = 1
exprWeight (EFloat _ _) = 1
exprWeight (ELam _ body _) = 1 + exprWeight body
exprWeight (EApp fn args _) = 1 + exprWeight fn + exprWeightList args
exprWeight (EPi _ _ _ dom cod _) = 1 + exprWeight dom + exprWeight cod
exprWeight (ELet binds body _ _) = 1 + patExprWeight binds + exprWeight body
exprWeight (ELocalFun clauses _) = 1 + clauseWeight clauses
exprWeight (ECase scrut alts _) = 1 + exprWeight scrut + patExprWeight alts
exprWeight (EIf c t e _) = 1 + exprWeight c + exprWeight t + exprWeight e
exprWeight (EField base _ _) = 1 + exprWeight base
exprWeight (ERecord _ fields _) = 1 + exprWeightFields fields
exprWeight (ERecUpdate base fields _) = 1 + exprWeight base + exprWeightFields fields
exprWeight (EDo stmts _) = 1 + doStmtWeight stmts
exprWeight (EAnn value ty _) = 1 + exprWeight value + exprWeight ty
exprWeight (EInterp parts _) = 1 + interpWeight parts

exprWeightList : List Expr -> Int
exprWeightList [] = 0
exprWeightList (e :: rest) = exprWeight e + exprWeightList rest

patExprWeight : List (Pat, Expr) -> Int
patExprWeight [] = 0
patExprWeight (p :: rest) = patWeight (firstOf p) + exprWeight (secondOf p) + patExprWeight rest

clauseWeight : List (List Pat, Expr) -> Int
clauseWeight [] = 0
clauseWeight (c :: rest) = patWeightList (firstOf c) + exprWeight (secondOf c) + clauseWeight rest

exprWeightFields : List (String, Expr) -> Int
exprWeightFields [] = 0
exprWeightFields (f :: rest) = exprWeight (secondOf f) + exprWeightFields rest

doStmtWeight : List DoStmt -> Int
doStmtWeight [] = 0
doStmtWeight (s :: rest) = oneDoStmtWeight s + doStmtWeight rest

oneDoStmtWeight : DoStmt -> Int
oneDoStmtWeight (DBind pat expr _) = 1 + patWeight pat + exprWeight expr
oneDoStmtWeight (DExpr expr _) = 1 + exprWeight expr
oneDoStmtWeight (DLet binds _) = 1 + patExprWeight binds

interpWeight : List InterpPart -> Int
interpWeight [] = 0
interpWeight (p :: rest) = oneInterpWeight p + interpWeight rest

oneInterpWeight : InterpPart -> Int
oneInterpWeight (IPText _) = 1
oneInterpWeight (IPHole e) = 1 + exprWeight e

-- | 表达式入口预算：`base` 是旧的固定值（小表达式行为不变），随节点数线性增长。
export exprBudget : Int -> Expr -> Int
exprBudget base e = base + 8 * exprWeight e

-- | 模式入口预算（同上；模式比表达式廉价，调用方给更小的 `base`）。
export patBudget : Int -> Pat -> Int
patBudget base p = base + 8 * patWeight p

export doStmtSpan : DoStmt -> Span
doStmtSpan (DBind pat expr sp) = sp
doStmtSpan (DExpr expr sp) = sp
doStmtSpan (DLet binds sp) = sp

export declSpan : Decl -> Span
declSpan (DData name params kind ctors derivings viaField repr lin sp) = sp
declSpan (DAxiom name ty sp) = sp
declSpan (DExtern name cName ty sp) = sp
declSpan (DSig name ctx ty sp) = sp
declSpan (DFun name pats body sp) = sp
declSpan (DRecord name params fields derivings viaField repr lin sp) = sp
declSpan (DTrait name params supers methods sp) = sp
declSpan (DInstance ctxE head methods sp) = sp

export ctorSpan : Ctor -> Span
ctorSpan (Ctor name ty arity sp) = sp

export fieldSpan : Field -> Span
fieldSpan (Field name ty sp) = sp

export fieldName : Field -> String
fieldName (Field name ty sp) = name

export fieldType : Field -> Expr
fieldType (Field name ty sp) = ty

export traitMethodName : TraitMethod -> String
traitMethodName (TraitMethod name ty sp) = name

export traitMethodSpan : TraitMethod -> Span
traitMethodSpan (TraitMethod name ty sp) = sp

export exportItemSpan : ExportItem -> Span
exportItemSpan item = nodeRefSpan (exportItemRef item)

export collectClauses : List Decl -> String -> List (List Pat, Expr)
collectClauses [] name = []
collectClauses (d :: rest) name =
  case d of
    DFun n pats body _ =>
      if n == name then (pats, body) :: collectClauses rest name else collectClauses rest name
    _ => collectClauses rest name

export clausesFor : List Decl -> String -> List (List Pat, Expr)
clausesFor decls name = collectClauses decls name

export funArity : String -> List Decl -> Maybe Int
funArity name decls =
  case clausesFor decls name of
    [] => Nothing
    (pats, body) :: _ => Just (natToInt (length pats))

export ctorName : Ctor -> String
ctorName (Ctor name ty arity _) = name

-- canonical 构造子名的最后一段（短名）。data 构造子的 canonical 形如
-- `Module.Data.Ctor`（entry 文件是 `Data.Ctor`），短名用于族内查找/OCaml 名字/诊断。
-- | 短名（canonical 名的最后一段）；族内查找 / OCaml 名字 / 诊断用。
export ctorShortName : String -> String
ctorShortName name = lastSeg name

-- 用户可见的构造子名：`FamilyShort.Ctor`（单段名原样返回）。
-- 不用完整的 `Module.Data.Ctor`：那会把模块路径泄漏进诊断。
-- | 诊断里显示的构造子名 `FamilyShort.Ctor`（单段名原样返回）。
export ctorDisplayName : String -> String
ctorDisplayName name =
  case splitLastDot (splitOnDot name) of
    ([], base) => base
    (revPrefix, base) =>
      case reverse revPrefix of
        [] => base
        fam :: rest => "${fam}.${base}"

export ctorType : Ctor -> Expr
ctorType (Ctor name ty arity _) = ty

export typeArity : Expr -> Int
typeArity (EApp (EVar (RIntrinsic "->") _) ([x, rest]) _) = 1 + typeArity rest
typeArity _ = 0

export lookupCtorArity : String -> List Ctor -> Maybe Int
lookupCtorArity name [] = Nothing
lookupCtorArity name (c :: rest) =
  if ctorName c == name then Just c.ctorArity else lookupCtorArity name rest

export ctorArity : String -> List Decl -> Maybe Int
ctorArity name [] = Nothing
ctorArity name (d :: rest) =
  case d of
    DData dname params kind ctors derivings viaField repr lin sp =>
      case lookupCtorArity name ctors of
        Just arity => Just arity
        Nothing => ctorArity name rest
    DRecord dname params fields derivings viaField repr lin sp =>
      if name == dname then Just (natToInt (length fields)) else ctorArity name rest
    _ => ctorArity name rest

export declNames : Decl -> List String
declNames (DFun name pats body _) = [name]
declNames (DAxiom name ty _) = [name]
declNames (DExtern name cName ty _) = [name]
declNames (DSig name ctx ty _) = [name]
declNames (DData dname params kind ctors derivings viaField repr lin _) = map ctorName ctors
declNames (DRecord dname params fields derivings viaField repr lin _) = [dname]
declNames (DTrait tname params supers methods _) = map traitMethodName methods
declNames (DInstance ctxE head methods _) = []

-- 顶层可见名字（把 data / record / trait 的**类型名**也算进来）。
-- Loader 用它判断「是不是本模块声明的名字」；DT 的类型名可以在值层位置出现
-- （`Vec n Nat` 的 `Nat`），所以必须一并认出来。语义仍由下游检查器决定。
export topNames : List Decl -> List String
topNames decls = concatMap declNames decls

export declAllNames : Decl -> List String
declAllNames (DData dname params kind ctors derivings viaField repr lin _) =
  dname :: map ctorName ctors
declAllNames (DRecord dname params fields derivings viaField repr lin _) = [dname]
declAllNames (DTrait tname params supers methods _) = tname :: map traitMethodName methods
declAllNames d = declNames d

_declCtors : Decl -> List String
_declCtors (DData dname params kind ctors derivings viaField repr lin _) = map ctorName ctors
_declCtors (DRecord dname params fields derivings viaField repr lin _) = [dname]
_declCtors (DTrait tname params supers methods _) = map traitMethodName methods
_declCtors _ = []

export ctorsOf : List Decl -> List String
ctorsOf decls = concatMap _declCtors decls

export declTypeNames : Decl -> List String
declTypeNames (DData name params kind ctors derivings viaField repr lin _) = [name]
declTypeNames (DRecord name params fields derivings viaField repr lin _) = [name]
declTypeNames (DTrait name params supers methods _) = [name]
declTypeNames _ = []

export typeNamesOf : List Decl -> List String
typeNamesOf decls = concatMap declTypeNames decls

export declDerivings : Decl -> List String
declDerivings (DData name params kind ctors derivings viaField repr lin _) = derivings
declDerivings (DRecord name params fields derivings viaField repr lin _) = derivings
declDerivings _ = []

-- ---------------------------------------------------------------
-- 解析后的 Ast → RAst
--
-- Loader.Resolve 产出的 Ast 已经完成名字解析与去糖；这里只把**引用**名字换成
-- `RName`。作用域只用于区分「局部 binder 恰好与内建同名」的边缘情况。
-- ---------------------------------------------------------------
-- | 名字 → RName（在 binder 作用域里的一律是局部）。
nameOf : List String -> String -> RName
nameOf scope name = if memName name scope then RLocal name else classifyName name

-- | 转换一组顶层声明。
export ofDecls : List Ast.Decl -> List Decl
ofDecls decls = map (ofDecl []) decls

-- | 单条声明。
export ofDecl : List String -> Ast.Decl -> Decl
ofDecl scope (Ast.DData name params kind ctors derivings via repr lin r) =
  DData
    name
    params
    (ofExpr (append params scope) kind)
    (map (ofCtor (append params scope)) ctors)
    derivings
    via
    repr
    lin
    (nodeRefSpan r)
ofDecl scope (Ast.DAxiom name ty r) = DAxiom name (ofExpr scope ty) (nodeRefSpan r)
ofDecl scope (Ast.DExtern name cName ty r) = DExtern name cName (ofExpr scope ty) (nodeRefSpan r)
ofDecl scope (Ast.DSig name ctx ty r) =
  DSig name (map (ofExpr scope) ctx) (ofExpr scope ty) (nodeRefSpan r)
ofDecl scope (Ast.DFun name pats body r) =
  let
    bound = append (bindersOfPats pats) scope
  in DFun name (map (ofPat scope) pats) (ofExpr bound body) (nodeRefSpan r)
ofDecl scope (Ast.DRecord name params fields derivings via repr lin r) =
  DRecord
    name
    params
    (map (ofField (append params scope)) fields)
    derivings
    via
    repr
    lin
    (nodeRefSpan r)
ofDecl scope (Ast.DTrait name params supers methods r) =
  let
    bound = append (map astTraitParamName params) scope
  in DTrait
    name
    (map (ofTraitParam bound) params)
    (map (ofExpr bound) supers)
    (map (ofTraitMethod bound) methods)
    (nodeRefSpan r)
ofDecl scope (Ast.DInstance ctx head methods r) =
  DInstance
    (map (ofExpr scope) ctx)
    (ofExpr scope head)
    (map (ofDecl scope) methods)
    (nodeRefSpan r)

ofCtor : List String -> Ast.Ctor -> Ctor
ofCtor scope (Ast.Ctor name ty arity r) = Ctor name (ofExpr scope ty) arity (nodeRefSpan r)

ofField : List String -> Ast.Field -> Field
ofField scope (Ast.Field name ty r) = Field name (ofExpr scope ty) (nodeRefSpan r)

ofTraitMethod : List String -> Ast.TraitMethod -> TraitMethod
ofTraitMethod scope (Ast.TraitMethod name ty r) = TraitMethod name (ofExpr scope ty) (nodeRefSpan r)

-- | 模式：引用名（构造子 / 记录）换成 RName；binder 名保持短名。
ofPat : List String -> Ast.Pat -> Pat
ofPat scope (Ast.PVar name r) = PVar name (Ast.nodeRefSpan r)
ofPat scope (Ast.PAs name inner r) = PAs name (ofPat scope inner) (Ast.nodeRefSpan r)
ofPat scope (Ast.PWild r) = PWild (Ast.nodeRefSpan r)
ofPat scope (Ast.PCon name pats r) =
  PCon (nameOf scope name) (map (ofPat scope) pats) (Ast.nodeRefSpan r)
ofPat scope (Ast.PInt n r) = PInt n (Ast.nodeRefSpan r)
ofPat scope (Ast.PStr s r) = PStr s (Ast.nodeRefSpan r)
ofPat scope (Ast.PRecord name fields r) =
  PRecord (nameOf scope name) (map (ofPatField scope) fields) (Ast.nodeRefSpan r)

ofPatField : List String -> (String, Ast.Pat) -> (String, Pat)
ofPatField scope (fname, pat) = (fname, ofPat scope pat)

-- | 模式引入的 binder 名。
patBinders : Ast.Pat -> List String
patBinders (Ast.PVar name _) = [name]
patBinders (Ast.PAs name inner _) = name :: patBinders inner
patBinders (Ast.PWild _) = []
patBinders (Ast.PCon name pats _) = concatMap patBinders pats
patBinders (Ast.PInt n _) = []
patBinders (Ast.PStr s _) = []
patBinders (Ast.PRecord name fields _) = concatMap patFieldBinders fields

bindersOfPats : List Ast.Pat -> List String
bindersOfPats pats = concatMap patBinders pats

-- | 表达式转换。
export ofExpr : List String -> Ast.Expr -> Expr
ofExpr scope e =
  case e of
    -- vuna-lint: disable-next-line dispatch-lift
    Ast.EVar name sp => EVar (nameOf scope name) (Ast.nodeRefSpan sp)
    Ast.EInt n sp => EInt n (Ast.nodeRefSpan sp)
    Ast.EStr s sp => EStr s (Ast.nodeRefSpan sp)
    Ast.EFloat raw sp => EFloat raw (Ast.nodeRefSpan sp)
    Ast.EInterp parts sp => EInterp (map (ofInterpPart scope) parts) (Ast.nodeRefSpan sp)
    Ast.ELam params body sp =>
      ELam params (ofExpr (append (map firstOf params) scope) body) (Ast.nodeRefSpan sp)
    Ast.EApp fn args sp =>
      case fn of
        Ast.EVar name _ =>
          case args of
            [v, t] =>
              if isAscribeSyntax name then
                EAnn (ofExpr scope v) (ofExpr scope t) (Ast.nodeRefSpan sp)
              else
                EApp (ofExpr scope fn) (map (ofExpr scope) args) (Ast.nodeRefSpan sp)
            _ => EApp (ofExpr scope fn) (map (ofExpr scope) args) (Ast.nodeRefSpan sp)
        _ => EApp (ofExpr scope fn) (map (ofExpr scope) args) (Ast.nodeRefSpan sp)
    Ast.EPi name implicit qty dom cod sp =>
      EPi name implicit qty (ofExpr scope dom) (ofExpr (name :: scope) cod) (Ast.nodeRefSpan sp)
    Ast.ELet binds body rec_ sp =>
      let
        bound = append (concatMap bindingBinders binds) scope
      in ELet (map (ofBinding bound scope) binds) (ofExpr bound body) rec_ (Ast.nodeRefSpan sp)
    Ast.ECase scrut alts sp =>
      ECase (ofExpr scope scrut) (map (ofAlt scope) alts) (Ast.nodeRefSpan sp)
    Ast.EIf c t f sp => EIf (ofExpr scope c) (ofExpr scope t) (ofExpr scope f) (Ast.nodeRefSpan sp)
    Ast.EField base fname sp => EField (ofExpr scope base) fname (Ast.nodeRefSpan sp)
    Ast.ERecord name fields sp =>
      ERecord (nameOf scope name) (map (ofFieldValue scope) fields) (Ast.nodeRefSpan sp)
    Ast.ERecUpdate base fields sp =>
      ERecUpdate (ofExpr scope base) (map (ofFieldValue scope) fields) (Ast.nodeRefSpan sp)
    Ast.EDo stmts sp => EDo (ofStmts scope stmts) (Ast.nodeRefSpan sp)

ofBinding : List String -> List String -> Ast.Binding -> (Pat, Expr)
ofBinding bound scope (Ast.Binding pat (Ast.BVal e) sig ref) =
  let
    valueScope = append (patBinders pat) bound
    value = ofExpr valueScope e
  in case sig of
    -- 绑定签名行重新合成 Rast 的 `EAnn`（Elab 的 where 组按签名递归提升）。
    Just s => (ofPat scope pat, EAnn value (ofExpr valueScope s.sigType) (Ast.nodeRefSpan s.sigRef))
    Nothing => (ofPat scope pat, value)
ofBinding bound scope (Ast.Binding pat (Ast.BClauses clauses) sig ref) =
  let
    valueScope = append (patBinders pat) bound
    value = ELocalFun (map (ofLocalClause valueScope) clauses) (Ast.nodeRefSpan ref)
  in case sig of
    Just s => (ofPat scope pat, EAnn value (ofExpr valueScope s.sigType) (Ast.nodeRefSpan s.sigRef))
    Nothing => (ofPat scope pat, value)

ofLocalClause : List String -> Ast.LocalClause -> (List Pat, Expr)
ofLocalClause scope clause =
  let
    pats = clause.lcPats
  in (map (ofPat scope) pats, ofExpr (append (bindersOfPats pats) scope) clause.lcBody)

ofAlt : List String -> Ast.Alt -> (Pat, Expr)
ofAlt scope alt =
  let
    pat = alt.altPat
  in (ofPat scope pat, ofExpr (append (patBinders pat) scope) alt.altBody)

ofFieldValue : List String -> (String, Ast.Expr) -> (String, Expr)
ofFieldValue scope (fname, value) = (fname, ofExpr scope value)

ofInterpPart : List String -> Ast.InterpPart -> InterpPart
ofInterpPart scope (Ast.IPText s) = IPText s
ofInterpPart scope (Ast.IPHole e) = IPHole (ofExpr scope e)

ofStmts : List String -> List Ast.DoStmt -> List DoStmt
ofStmts scope [] = []
ofStmts scope (stmt :: rest) =
  case stmt of
    Ast.DBind pat value r =>
      DBind (ofPat scope pat) (ofExpr scope value) (nodeRefSpan r)
        :: ofStmts (append (patBinders pat) scope) rest
    Ast.DLet binds r =>
      let
        bound = append (concatMap bindingBinders binds) scope
      in DLet (map (ofBinding bound scope) binds) (nodeRefSpan r) :: ofStmts bound rest
    Ast.DExpr value r => DExpr (ofExpr scope value) (nodeRefSpan r) :: ofStmts scope rest

patFieldBinders : (String, Ast.Pat) -> List String
patFieldBinders (fname, pat) = patBinders pat

bindingBinders : Ast.Binding -> List String
bindingBinders binding = patBinders binding.bindPat

astTraitParamName : Ast.TraitParam -> String
astTraitParamName p = p.traitParamName

ofTraitParam : List String -> Ast.TraitParam -> TraitParam
ofTraitParam scope (Ast.TraitParam name kind) = TraitParam name (ofMaybeExpr scope kind)

ofMaybeExpr : List String -> Maybe Ast.Expr -> Maybe Expr
ofMaybeExpr scope Nothing = Nothing
ofMaybeExpr scope (Just e) = Just (ofExpr scope e)
