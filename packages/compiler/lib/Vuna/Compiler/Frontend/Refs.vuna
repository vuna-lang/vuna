-- | 引用注解：一次作用域感知的遍历，把「引用节点 → `RName`」集中算出来。
--
-- Ast 的引用只留字符串；`RName` 需要 binder 作用域才能区分「局部 binder 恰好与内建同名」
-- 与真正的内建（分类规则见 [Vuna.Compiler.Frontend.Rast.Name]）。作用域遍历只在这一处，
-- `Rast` 物化与后续「Ast + 注解」视图共用同一份规则。
--
-- 键见 `refKey`：span 文件 + 起止字节偏移 + 源码名。表不依赖节点 id——parser 的 id 只在
-- 单模块内唯一，宏展开还共享调用点身份，而普通引用大多是 `detachedNodeRef`（没有 id），
-- 只有 span 身份的引用才能覆盖全部写法。
--
-- 作用域规则与 `Rast` 的表达式形状一一对应：`ELet` / `DLet` 的绑定组对内互相可见
-- （非递归 `let` 也按同组可见处理），绑定右值额外看到自己的 binder；`ECase` / 局部函数组
-- 每条子句看到自己的模式 binder。
module Vuna.Compiler.Frontend.Refs where

import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast as Ast
import Vuna.Compiler.Frontend.Rast.Name

-- | 引用注解表：引用节点键 → 名字身份。
--
-- 表是**稀疏的作用域覆盖**：只存「局部 binder 与内建 / 全局名同名」的引用（其它引用
-- 的 `RName` 由字符串直接分类得出）。正常代码里这种引用极少，所以表很小。
export record Annot(..) where
  anRefs : HashMap (String, Int, Int, String) RName

-- 空 HashMap 的字面量在 OCaml 侧会退化成弱类型变量：用一条哨兵钉住类型再删掉它
-- （与 `Frontend/Cst.emptyParenTable` 同法）。
emptyRefTable : HashMap (String, Int, Int, String) RName
emptyRefTable = HashMap.remove emptyKey (HashMap.fromList [(emptyKey, RLocal "")])

emptyKey : (String, Int, Int, String)
emptyKey = ("", 0 - 1, 0 - 1, "")

export emptyAnnot : Annot
emptyAnnot = Annot emptyRefTable

-- | 按节点取名字身份；表里没有时回落到「只看字符串」的分类（等价于空作用域下的旧行为）。
-- 调用方手里通常有 Ast 的字符串，一并传入以免静默漂移。
export rnameAt : Annot -> String -> NodeRef -> RName
rnameAt a name ref =
  case HashMap.lookup (refKey name ref) a.anRefs of
    Just n => n
    Nothing => classifyName name

-- | 按节点取名字身份；表里没有时给 `Nothing`（需要区分「注解缺失」的消费者用）。
export lookupRName : Annot -> String -> NodeRef -> Maybe RName
lookupRName a name ref = HashMap.lookup (refKey name ref) a.anRefs

-- | 注解表的键：`(span 文件, 起始字节偏移, 结束字节偏移, 源码名)`。
--
-- 用 span 而不是节点 id：普通引用节点多是 `detachedNodeRef`（没有 id）；宏展开产出的节点
-- 又共享调用点的 span，只能靠源码名区分同一位置上展开出的多个引用。
refKey : String -> NodeRef -> (String, Int, Int, String)
refKey name ref =
  let
    sp = nodeRefSpan ref
  in (spanFile sp, spanStartOffset sp, spanEndOffset sp, name)

-- | 注释一组顶层声明。
export annotateDecls : List Ast.Decl -> Annot
annotateDecls decls = Annot (foldRefs (declsRefs decls) emptyRefTable)

-- | 注释单个表达式（REPL / 工具的单表达式入口；作用域为空）。
export annotateExpr : Ast.Expr -> Annot
annotateExpr e = Annot (foldRefs (exprRefs [] e) emptyRefTable)

-- 同一个键出现两次且分类不同，说明节点身份仍有歧义（宏展开可能连源码名一起共享）：
-- 删掉这个键，让读取回落到字符串分类，而不是留下一个可能错误的名字。
foldRefs : List ((String, Int, Int, String), RName) -> HashMap (String, Int, Int, String) RName -> HashMap (String, Int, Int, String) RName
foldRefs [] acc = acc
foldRefs (entry :: rest) acc =
  let
    k = firstOf entry
    v = secondOf entry
  in case HashMap.lookup k acc of
    Just prev =>
      if rnameKey prev == rnameKey v then
        foldRefs rest acc
      else
        foldRefs rest (HashMap.remove k acc)
    Nothing => foldRefs rest (HashMap.insert k v acc)

-- ---------------------------------------------------------------
-- 作用域感知的收集
-- ---------------------------------------------------------------
-- | 一个引用节点的表项：只登记**作用域覆盖**（在 binder 作用域里且字符串分类不是局部名）。
refEntry : List String -> String -> NodeRef -> List ((String, Int, Int, String), RName)
refEntry scope name ref =
  case classifyName name of
    RLocal _ => []
    _ => if memName name scope then [(refKey name ref, RLocal name)] else []

declsRefs : List Ast.Decl -> List ((String, Int, Int, String), RName)
declsRefs [] = []
declsRefs (d :: rest) = append (declRefs [] d) (declsRefs rest)

declRefs : List String -> Ast.Decl -> List ((String, Int, Int, String), RName)
declRefs scope (Ast.DData name params kind ctors derivings via repr lin r) =
  let
    bound = append params scope
  in append (exprRefs bound kind) (concatMap (ctorRefs bound) ctors)
declRefs scope (Ast.DAxiom name ty r) = exprRefs scope ty
declRefs scope (Ast.DExtern name cName ty r) = exprRefs scope ty
declRefs scope (Ast.DSig name ctx ty r) =
  append (concatMap (exprRefs scope) ctx) (exprRefs scope ty)
declRefs scope (Ast.DFun name pats body r) =
  append (concatMap (patRefs scope) pats) (exprRefs (append (bindersOfPats pats) scope) body)
declRefs scope (Ast.DRecord name params fields derivings via repr lin r) =
  concatMap (fieldRefs (append params scope)) fields
declRefs scope (Ast.DTrait name params supers methods r) =
  let
    bound = append (map astTraitParamName params) scope
  in append
    (concatMap (traitParamRefs bound) params)
    (append (concatMap (exprRefs bound) supers) (concatMap (traitMethodRefs bound) methods))
declRefs scope (Ast.DInstance ctx head methods r) =
  append
    (concatMap (exprRefs scope) ctx)
    (append (exprRefs scope head) (concatMap (declRefs scope) methods))

ctorRefs : List String -> Ast.Ctor -> List ((String, Int, Int, String), RName)
ctorRefs scope ctor = exprRefs scope ctor.ctorType

fieldRefs : List String -> Ast.Field -> List ((String, Int, Int, String), RName)
fieldRefs scope field = exprRefs scope field.fieldType

traitMethodRefs : List String -> Ast.TraitMethod -> List ((String, Int, Int, String), RName)
traitMethodRefs scope method = exprRefs scope method.traitMethodType

traitParamRefs : List String -> Ast.TraitParam -> List ((String, Int, Int, String), RName)
traitParamRefs scope param =
  case param.traitParamKind of
    Just kind => exprRefs scope kind
    Nothing => []

patRefs : List String -> Ast.Pat -> List ((String, Int, Int, String), RName)
patRefs scope (Ast.PVar name r) = []
patRefs scope (Ast.PAs name inner r) = patRefs scope inner
patRefs scope (Ast.PWild r) = []
patRefs scope (Ast.PCon name pats r) =
  append (refEntry scope name r) (concatMap (patRefs scope) pats)
patRefs scope (Ast.PInt n r) = []
patRefs scope (Ast.PStr s r) = []
patRefs scope (Ast.PRecord name fields r) =
  append (refEntry scope name r) (concatMap (patFieldRefs scope) fields)

patFieldRefs : List String -> (String, Ast.Pat) -> List ((String, Int, Int, String), RName)
patFieldRefs scope (fname, pat) = patRefs scope pat

exprRefs : List String -> Ast.Expr -> List ((String, Int, Int, String), RName)
exprRefs scope (Ast.EVar name r) = refEntry scope name r
exprRefs scope (Ast.EInt n r) = []
exprRefs scope (Ast.EStr s r) = []
exprRefs scope (Ast.EFloat raw r) = []
exprRefs scope (Ast.EInterp parts r) = concatMap (interpRefs scope) parts
exprRefs scope (Ast.ELam params body r) = exprRefs (append (map firstOf params) scope) body
exprRefs scope (Ast.EApp fn args r) = append (exprRefs scope fn) (concatMap (exprRefs scope) args)
exprRefs scope (Ast.EPi name implicit qty dom cod r) =
  append (exprRefs scope dom) (exprRefs (name :: scope) cod)
exprRefs scope (Ast.ELet binds body rec_ r) =
  let
    bound = append (concatMap bindingBinders binds) scope
  in append (concatMap (bindingRefs bound scope) binds) (exprRefs bound body)
exprRefs scope (Ast.ECase scrut alts r) =
  append (exprRefs scope scrut) (concatMap (altRefs scope) alts)
exprRefs scope (Ast.EIf c t f r) =
  append (exprRefs scope c) (append (exprRefs scope t) (exprRefs scope f))
exprRefs scope (Ast.EField base fname r) = exprRefs scope base
exprRefs scope (Ast.ERecord name fields r) =
  append (refEntry scope name r) (concatMap (fieldValueRefs scope) fields)
exprRefs scope (Ast.ERecUpdate base fields r) =
  append (exprRefs scope base) (concatMap (fieldValueRefs scope) fields)
exprRefs scope (Ast.EDo stmts r) = stmtsRefs scope stmts

bindingRefs : List String -> List String -> Ast.Binding -> List ((String, Int, Int, String), RName)
bindingRefs bound scope binding =
  let
    pat = binding.bindPat
    valueScope = append (patBinders pat) bound
    valueRefs =
      case binding.bindValue of
        Ast.BVal e => exprRefs valueScope e
        Ast.BClauses clauses => concatMap (localClauseRefs valueScope) clauses
    sigRefs =
      case binding.bindSig of
        Just sig => exprRefs valueScope sig.sigType
        Nothing => []
  in append (patRefs scope pat) (append valueRefs sigRefs)

localClauseRefs : List String -> Ast.LocalClause -> List ((String, Int, Int, String), RName)
localClauseRefs scope clause =
  let
    pats = clause.lcPats
  in append
    (concatMap (patRefs scope) pats)
    (exprRefs (append (bindersOfPats pats) scope) clause.lcBody)

altRefs : List String -> Ast.Alt -> List ((String, Int, Int, String), RName)
altRefs scope alt =
  let
    pat = alt.altPat
  in append (patRefs scope pat) (exprRefs (append (patBinders pat) scope) alt.altBody)

fieldValueRefs : List String -> (String, Ast.Expr) -> List ((String, Int, Int, String), RName)
fieldValueRefs scope (fname, value) = exprRefs scope value

interpRefs : List String -> Ast.InterpPart -> List ((String, Int, Int, String), RName)
interpRefs scope (Ast.IPText s) = []
interpRefs scope (Ast.IPHole e) = exprRefs scope e

stmtsRefs : List String -> List Ast.DoStmt -> List ((String, Int, Int, String), RName)
stmtsRefs scope [] = []
stmtsRefs scope (stmt :: rest) =
  append (stmtRefs scope stmt) (stmtsRefs (scopeOfStmt scope stmt) rest)

stmtRefs : List String -> Ast.DoStmt -> List ((String, Int, Int, String), RName)
stmtRefs scope (Ast.DBind pat value r) = append (patRefs scope pat) (exprRefs scope value)
stmtRefs scope (Ast.DLet binds r) =
  let
    bound = append (concatMap bindingBinders binds) scope
  in concatMap (bindingRefs bound scope) binds
stmtRefs scope (Ast.DExpr value r) = exprRefs scope value

-- | 一条 do 语句之后的作用域：`pat <- e` 与 `let ...` 引入 binder，其余不变。
scopeOfStmt : List String -> Ast.DoStmt -> List String
scopeOfStmt scope (Ast.DBind pat value r) = append (patBinders pat) scope
scopeOfStmt scope (Ast.DLet binds r) = append (concatMap bindingBinders binds) scope
scopeOfStmt scope (Ast.DExpr value r) = scope

-- ---------------------------------------------------------------
-- binder 名
-- ---------------------------------------------------------------
patBinders : Ast.Pat -> List String
patBinders (Ast.PVar name r) = [name]
patBinders (Ast.PAs name inner r) = name :: patBinders inner
patBinders (Ast.PWild r) = []
patBinders (Ast.PCon name pats r) = concatMap patBinders pats
patBinders (Ast.PInt n r) = []
patBinders (Ast.PStr s r) = []
patBinders (Ast.PRecord name fields r) = concatMap patFieldBinders fields

patFieldBinders : (String, Ast.Pat) -> List String
patFieldBinders (fname, pat) = patBinders pat

bindersOfPats : List Ast.Pat -> List String
bindersOfPats pats = concatMap patBinders pats

bindingBinders : Ast.Binding -> List String
bindingBinders binding = patBinders binding.bindPat

astTraitParamName : Ast.TraitParam -> String
astTraitParamName p = p.traitParamName
