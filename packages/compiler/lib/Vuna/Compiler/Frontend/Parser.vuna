module Vuna.Compiler.Frontend.Parser where

-- vuna 源码 parser：offside layout，返回 AST 与 imports。
import Base.Data.List as List
import Base.Data.Nat as Nat
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Base.Diagnostics.Frontend
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser.Support

-- ---------------------------------------------------------------
-- 诊断位置：parser 的每条诊断都带当前 token 的 span（EOF 退到最后消费位置）。
-- 位置必须在**产生点**给出：此处集中两个 helper，避免 `psErrAt (tokSpan st)` 铺满全文。
-- ---------------------------------------------------------------
ps0 : PState -> PsDiag Zero -> Check a
ps0 st e = psErr0At (tokSpan st) e

ps1 : PState -> PsDiag (Succ Zero) -> String -> Check a
ps1 st e a0 = psErr1At (tokSpan st) e a0

psAt : PState -> {n : Nat} -> PsDiag n -> Vec n String -> Check a
psAt st e args = psErrAt (tokSpan st) e args

-- 单次词法同时给出注释表：fmt / index / doc / LSP 都要注释，但不必为此再扫一遍源码
-- （`lexComments` 现在是一次完整词法，投影出注释）。
export parseSourceWithComments : String -> String -> Check (Pair SourceFile (List Comment))
parseSourceWithComments file source = case lexSourceWithComments source of
  ErrC e => ErrC e
  OkC (Pair toks comments) => case parseSourceFile False (mkState file toks PmTool) of
    ErrC e => ErrC e
    OkC p => OkC (Pair (firstOf (firstOf p)) comments)

export parseSource : String -> String -> Check SourceFile
parseSource file source = case parseSourceWithComments file source of
  ErrC e => ErrC e
  OkC (Pair sf comments) => OkC sf

-- 单表达式解析（REPL / 工具用）：整段输入必须恰好是一个表达式。
export parseExpressionSource : String -> Check Expr
parseExpressionSource source =
  Vuna.Compiler.Base.Common.bind (lexSource source)
    (\toks => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel (mkState "<expr>" toks PmStrict)) (mkState "<expr>" toks PmStrict) 0) (\e, st => if isEof st then OkC e else ps0 st ExpectedEndOfExpr))

-- 解析器累加器（导出/重导出/归约修饰符与声明一起收集）。
record DeclAcc where
  declAccFixities : List FixityDecl
  declAccDecls : List Decl
  declAccExports : List ExportSpec
  declAccOpacity : List OpacitySpec

emptyDeclAcc : DeclAcc
emptyDeclAcc = DeclAcc [] [] [] []

record ParsedDecl where
  parsedFixity : Maybe FixityDecl
  parsedDecl : Maybe Decl
  parsedExport : Maybe ExportSpec
  parsedOpacity : Maybe OpacitySpec

emptyParsedDecl : ParsedDecl
emptyParsedDecl = ParsedDecl Nothing Nothing Nothing Nothing

-- 把逐定义导出/重导出/归约修饰符挂到模块头上；入口文件没有模块头（这些信息也无下游）。
-- 可选模块头：`module M (导出项, ...) where`；列表省略 = 导出全部。
parseSourceFile : Bool -> PState -> Check (Pair (Pair SourceFile PState) (List Diagnostic))
parseSourceFile recover st = Vuna.Compiler.Base.Common.step (parseModDecl st) (\hdr, st1 => Vuna.Compiler.Base.Common.step (parseImports (stateFuel st1) st1) (\imp, st2 => case imp of
  Pair imports reexports => if isEof st2 then OkC (Pair (Pair (SourceFile hdr imports [] [] [] reexports []) st2) [])
  else case peekPos st2 of
    Pos line col _ _ => Vuna.Compiler.Base.Common.step (parseDecls recover (stateFuel st2) st2 col emptyDeclAcc) (\p, rest => case rest of
      Pair st3 errs => case p of
        DeclAcc fixities decls exports opacity =>
          if isEof st3 then OkC
            (Pair (Pair (SourceFile hdr imports fixities decls exports reexports opacity) st3) errs)
          else ps0 st3 ExpectedEndOfInput
    )
)
)

parseModDecl : PState -> Check (Pair (Maybe ModDecl) PState)
parseModDecl st =
  if atKw st "module" then Vuna.Compiler.Base.Common.bind (expectKw st "module")
    (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "where") (\st3 => OkC (Pair (Just (ModDecl name False [] [] [] [] (spanOf st st3))) st3))))
  else OkC (Pair Nothing st)

parseExportItems : PState -> Check (Pair (List ExportItem) PState)
parseExportItems st =
  Vuna.Compiler.Base.Common.bind (expectSym st "(")
    (\st1 => if atSym st1 ")" then OkC (Pair [] (advance st1)) else parseExportItemsFrom (stateFuel st1) st1)

parseExportItemsFrom : Int -> PState -> Check (Pair (List ExportItem) PState)
parseExportItemsFrom fuel st =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parseExportItem st)
    (\item, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseExportItemsFrom (fuel - 1) (advance st1)) (\rest, st2 => OkC (Pair ((::) item rest) st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (Pair [item] st2)))

parseExportItem : PState -> Check (Pair ExportItem PState)
parseExportItem st = case peekTok st of
  PTok (TKw "module") p =>
    Vuna.Compiler.Base.Common.bind (expectKw st "module")
      (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => OkC (Pair (XModule name (spanOf st st2)) st2)))
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 "(" then Vuna.Compiler.Base.Common.step (parseExportMembers st1)
      (\members, st2 => OkC (Pair (exportItemOf name members (spanOf st st2)) st2))
    else OkC (Pair (XBare name (spanOf st st1)) st1)
  -- 导出用户符号名函数（`(<+>)`）。保留符号不可导出。
  PTok (TSym op) p =>
    if isReservedValueName op then ps0 st ExpectedExportItem
    else OkC (Pair (XBare op (spanOf st (advance st))) (advance st))
  _ => ps0 st ExpectedExportItem

-- | `T(..)` / `T(A, B)` / `T()` 的括号体（`(` 尚未消费）。
parseExportMembers : PState -> Check (Pair ExportMembers PState)
parseExportMembers st =
  Vuna.Compiler.Base.Common.bind (expectSym st "(")
    (\st1 => if atSym st1 ")" then OkC (Pair EMNone (advance st1)) else if atSym st1 ".." then Vuna.Compiler.Base.Common.bind (expectSym st1 "..") (\st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 ")") (\st3 => OkC (Pair EMAll st3))) else Vuna.Compiler.Base.Common.step (parseMemberNames (stateFuel st1) st1) (\names, st2 => OkC (Pair (EMOnly names) st2)))

parseMemberNames : Int -> PState -> Check (Pair (List String) PState)
parseMemberNames fuel st =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (expectDeclName st)
    (\name, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseMemberNames (fuel - 1) (advance st1)) (\rest, st2 => OkC (Pair ((::) name rest) st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (Pair [name] st2)))

exportItemOf : String -> ExportMembers -> Span -> ExportItem
exportItemOf name EMAll sp = XTypeAll name sp
exportItemOf name EMNone sp = XTypeSome name [] sp
exportItemOf name (EMOnly members) sp = XTypeSome name members sp

-- | `export import [qualified] B [as L] [(x, T(..), T(A, B))]`。
-- 返回普通 `Import`（与 `import` 同语义）+ 重导出项。
parseExportImport : PState -> Check (Pair (Pair Import (List ExportItem)) PState)
parseExportImport st =
  Vuna.Compiler.Base.Common.step (expectIdent st)
    (\_, st1 => if atKw st1 "import" then Vuna.Compiler.Base.Common.bind (expectKw st1 "import") (\st2 => Vuna.Compiler.Base.Common.step (parseImportAfterKeyword st2) (\imp, st3 => parseReexportTail imp st3)) else ps0 st1 ExpectedTopLevelDecl)

-- | `export module C [as X]`：整模块重导出；带 alias 时导出命名空间路径。
-- 不带 Import：加载期按需合成/复用 `import C [as X]`。
parseExportNamespace : PState -> Check (Pair ExportItem PState)
parseExportNamespace st =
  Vuna.Compiler.Base.Common.step (expectIdent st)
    (\_, st1 => Vuna.Compiler.Base.Common.bind (expectKw st1 "module") (\st2 => Vuna.Compiler.Base.Common.step (expectIdent st2) (\name, st3 => if atKw st3 "as" then Vuna.Compiler.Base.Common.bind (expectKw st3 "as") (\st4 => Vuna.Compiler.Base.Common.step (expectIdent st4) (\alias, st5 => OkC (Pair (XNamespace name (Just alias) (spanOf st st5)) st5))) else OkC (Pair (XNamespace name Nothing (spanOf st st3)) st3))))

-- 复用 `import` 之后的 qualified/模块名/as 解析。
parseImportAfterKeyword : PState -> Check (Pair Import PState)
parseImportAfterKeyword st =
  if atKw st "qualified" then Vuna.Compiler.Base.Common.bind (expectKw st "qualified") (\st1 => parseImportAlias st1 True)
  else parseImportAlias st False

parseReexportTail : Import -> PState -> Check (Pair (Pair Import (List ExportItem)) PState)
parseReexportTail imp st =
  if atSym st "(" then Vuna.Compiler.Base.Common.step (parseExportItems st)
    (\items, st1 => OkC (Pair (Pair imp (map (qualifyExportItem (reexportPrefix imp)) items)) st1))
  else Vuna.Compiler.Base.Common.bind (expectSym st "(") (\st1 => OkC (Pair (Pair imp []) st1))

-- 重导出项里的模块前缀：写了 alias 用 alias，否则用全名。
reexportPrefix : Import -> String
reexportPrefix imp = case imp.importAlias of
  Just alias => alias
  Nothing => imp.importName

qualifyExportItem : String -> ExportItem -> ExportItem
qualifyExportItem prefix (XBare name sp) = XBare "${prefix}.${name}" sp
qualifyExportItem prefix (XTypeAll name sp) = XTypeAll "${prefix}.${name}" sp
qualifyExportItem prefix (XTypeSome name members sp) = XTypeSome "${prefix}.${name}" members sp
qualifyExportItem prefix (XModule name sp) = XModule name sp
qualifyExportItem prefix (XNamespace name alias sp) = XNamespace name alias sp

parseImportSpec : PState -> Check (Pair Import PState)
parseImportSpec st =
  Vuna.Compiler.Base.Common.bind (expectKw st "import")
    (\st1 => if atKw st1 "qualified" then Vuna.Compiler.Base.Common.bind (expectKw st1 "qualified") (\st2 => parseImportAlias st2 True) else parseImportAlias st1 False)

parseImportAlias : PState -> Bool -> Check (Pair Import PState)
parseImportAlias st isQualified =
  Vuna.Compiler.Base.Common.step (expectIdent st)
    (\name, st1 => if atKw st1 "as" then Vuna.Compiler.Base.Common.bind (expectKw st1 "as") (\st2 => Vuna.Compiler.Base.Common.step (expectIdent st2) (\alias, st3 => OkC (Pair (Import name isQualified (Just alias) (spanOf st st3)) st3))) else OkC (Pair (Import name isQualified Nothing (spanOf st st1)) st1))

-- import 区同时收 `export import` 的重导出项；列表顺序无语义。
parseImports : Int -> PState -> Check (Pair (Pair (List Import) (List ExportItem)) PState)
parseImports fuel st = if fuel <= 0 then icFuel "parser"
else if atKw st "import" then Vuna.Compiler.Base.Common.step (parseImportSpec st) (\imp, st1 => Vuna.Compiler.Base.Common.step (parseImports (fuel - 1) st1) (\rest, st2 => case rest of
  Pair imports reexports => OkC (Pair (Pair ((::) imp imports) reexports) st2)
)
)
else if atIdentName st "export" && atKw (advance st) "import" then Vuna.Compiler.Base.Common.step (parseExportImport st) (\p, st1 => case p of
  Pair imp reexports => Vuna.Compiler.Base.Common.step (parseImports (fuel - 1) st1) (\rest, st2 => case rest of
    Pair imports reexports2 =>
      OkC (Pair (Pair ((::) imp imports) (append reexports reexports2)) st2)
  )
)
else if atIdentName st "export" && atKw (advance st) "module" then Vuna.Compiler.Base.Common.step (parseExportNamespace st) (\item, st1 => Vuna.Compiler.Base.Common.step (parseImports (fuel - 1) st1) (\rest, st2 => case rest of
  Pair imports reexports2 => OkC (Pair (Pair imports ((::) item reexports2)) st2)
)
)
else OkC (Pair (Pair [] []) st)

-- `infixl` / `infixr` / `infix` 声明与顶层声明穿插收集（声明本身不进入 Decl，
-- 由 Loader 在中缀重排时消费；见 `SourceFile.fixities`）。
-- 累加器定义在文件前部（`DeclAcc` / `ParsedDecl`）。
parseDecls : Bool -> Int -> PState -> Int -> DeclAcc -> Check (Pair DeclAcc (Pair PState (List Diagnostic)))
parseDecls recover fuel st blockCol acc = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair (reverseDeclAcc acc) (Pair st []))
else case peekPos st of
  Pos line col _ _ => if col == blockCol then case parseFixityOrDecl st blockCol of
    ErrC e => if recover then
      let
        st2 = recoverDecl st blockCol
      in Vuna.Compiler.Base.Common.step (parseDecls True (fuel - 1) st2 blockCol acc) (\p, rest => case rest of
        Pair st3 errs => OkC (Pair p (Pair st3 ((::) e errs)))
      )
    else ErrC e
    OkC p =>
      let
        pd = firstOf p
        st1 = secondOf p
        acc2 = addParsedDecl pd acc
      in parseDecls recover (fuel - 1) st1 blockCol acc2
  else ps1 st (ExpectedDeclAtColumn (strFromInt blockCol)) (strFromInt blockCol)

addParsedDecl : ParsedDecl -> DeclAcc -> DeclAcc
addParsedDecl (ParsedDecl mfix mdecl mexp mop) (DeclAcc fixities decls exports opacity) =
  let
    fixities2 = case mfix of
      Just f => (::) f fixities
      Nothing => fixities
    decls2 = case mdecl of
      Just d => (::) d decls
      Nothing => decls
    exports2 = case mexp of
      Just e => (::) e exports
      Nothing => exports
    opacity2 = case mop of
      Just o => (::) o opacity
      Nothing => opacity
  in DeclAcc fixities2 decls2 exports2 opacity2

reverseDeclAcc : DeclAcc -> DeclAcc
reverseDeclAcc (DeclAcc fixities decls exports opacity) =
  DeclAcc (reverse fixities) (reverse decls) (reverse exports) (reverse opacity)

-- 解析恢复：跳过一个坏声明，停在下一个「与块首同列」的 token（无则到 EOF）。
recoverDecl : PState -> Int -> PState
recoverDecl (PState file toks last count mode) blockCol =
  let
    rest = skipToDeclLine toks blockCol
  in PState file rest last (length rest) mode

skipToDeclLine : List PTok -> Int -> List PTok
skipToDeclLine [] blockCol = []
skipToDeclLine (_ :: rest) blockCol = skipFrom rest blockCol

skipFrom : List PTok -> Int -> List PTok
skipFrom [] blockCol = []
skipFrom (t :: rest) blockCol =
  if posCol t.ptokPos == blockCol then (::) t rest else skipToDeclLine rest blockCol

-- 一条顶层声明：fixity / 带修饰符的声明 / 普通 Decl。
parseFixityOrDecl : PState -> Int -> Check (Pair ParsedDecl PState)
parseFixityOrDecl st blockCol = case peekTok st of
  PTok (TKw "infixl") p =>
    Vuna.Compiler.Base.Common.step (parseFixityDecl st blockCol 1 p)
      (\fd, st1 => OkC (Pair (ParsedDecl (Just fd) Nothing Nothing Nothing) st1))
  PTok (TKw "infixr") p =>
    Vuna.Compiler.Base.Common.step (parseFixityDecl st blockCol 2 p)
      (\fd, st1 => OkC (Pair (ParsedDecl (Just fd) Nothing Nothing Nothing) st1))
  PTok (TKw "infix") p =>
    Vuna.Compiler.Base.Common.step (parseFixityDecl st blockCol 0 p)
      (\fd, st1 => OkC (Pair (ParsedDecl (Just fd) Nothing Nothing Nothing) st1))
  _ =>
    if exportStart st then parseExportDecl st blockCol
    else if opacityStart st then parseOpacityDecl st blockCol
    else Vuna.Compiler.Base.Common.step (parseDecl st blockCol)
      (\decl, st1 => OkC (Pair (ParsedDecl Nothing (Just decl) Nothing Nothing) st1))

-- 软关键字 `export`：`export f : T` / `export data ...`；不吞掉名为 export 的普通定义。
exportStart : PState -> Bool
exportStart st = case peekTok st of
  PTok (TIdent "export") _ => exportMarkerFollows (advance st)
  _ => False

exportMarkerFollows : PState -> Bool
exportMarkerFollows st = case peekTok st of
  PTok (TSym ":") _ => False
  PTok (TIdent _) _ => case peekTok (advance st) of
    PTok (TSym ":") _ => True
    _ => True
  PTok (TSym _) _ => case peekTok (advance st) of
    PTok (TSym ":") _ => True
    _ => True
  PTok (TKw "data") _ => True
  PTok (TKw "record") _ => True
  PTok (TKw "trait") _ => True
  PTok (TKw "axiom") _ => True
  PTok (TKw "extern") _ => True
  PTok (TKw "linear") _ => True
  PTok (TKw "opaque") _ => True
  PTok (TKw "transparent") _ => True
  PTok (TKw "import") _ => True
  _ => False

-- `opaque` / `transparent` 在声明开头是定义归约修饰符；后跟 record/linear record 时
-- 不算修饰符（档位前缀写法只出现在 `export` 位置，声明位置给出明确诊断）。
opacityStart : PState -> Bool
opacityStart st = case peekTok st of
  PTok (TKw "opaque") _ => not (tierFollows st)
  PTok (TKw "transparent") _ => not (tierFollows st)
  PTok (TIdent "abstract") _ => True
  _ => False

-- | 逐定义导出：`export [opaque|transparent] <decl>`。
parseExportDecl : PState -> Int -> Check (Pair ParsedDecl PState)
parseExportDecl st blockCol =
  Vuna.Compiler.Base.Common.step (expectIdent st)
    (\_, st1 => if atKw st1 "opaque" && not (tierFollows st1) then Vuna.Compiler.Base.Common.bind (expectKw st1 "opaque") (\st2 => parseExportedValue (Just OpacityOpaque) st2 blockCol) else if atKw st1 "transparent" && not (tierFollows st1) then Vuna.Compiler.Base.Common.bind (expectKw st1 "transparent") (\st2 => parseExportedValue (Just OpacityTransparent) st2 blockCol) else if atIdentName st1 "abstract" then Vuna.Compiler.Base.Common.step (expectIdent st1) (\_, st2 => parseExportedValue (Just OpacityAbstract) st2 blockCol) else parseExportedPlain Nothing st1 blockCol)

parseExportedPlain : Maybe Opacity -> PState -> Int -> Check (Pair ParsedDecl PState)
parseExportedPlain op st blockCol = case peekTok st of
  PTok (TKw "data") p =>
    if opacityGiven op then ps1 st (ExpectedToken "value signature") "value signature"
    else parseDataExport False st blockCol p
  PTok (TKw "linear") p =>
    if opacityGiven op then ps1 st (ExpectedToken "value signature") "value signature"
    else parseLinearExport st blockCol p
  PTok (TKw "record") p =>
    if opacityGiven op then ps1 st (ExpectedToken "value signature") "value signature"
    else parseRecordExport False ReprAuto st blockCol p
  PTok (TKw "trait") p =>
    if opacityGiven op then ps1 st (ExpectedToken "value signature") "value signature"
    else parseTraitExport st blockCol p
  PTok (TKw "axiom") p => parseAxiomExport op st blockCol p
  PTok (TKw "extern") p => parseExternExport op st blockCol p
  PTok (TKw "transparent") p =>
    if tierFollows st then parseTieredExport ReprAlias st blockCol p
    else ps1 st (ExpectedToken "value signature") "value signature"
  PTok (TKw "opaque") p =>
    if tierFollows st then parseTieredExport ReprBoxed st blockCol p
    else ps1 st (ExpectedToken "value signature") "value signature"
  PTok (TIdent name) p =>
    if (name == "alias" || name == "boxed") && tierFollows st then if opacityGiven op then ps1 st (ExpectedToken "value signature") "value signature"
    else parseTieredExport (if name == "alias" then ReprAlias else ReprBoxed) st blockCol p
    else parseExportedValue op st blockCol
  PTok (TSym _) _ => parseExportedValue op st blockCol
  _ => ps0 st ExpectedTopLevelDecl

opacityGiven : Maybe Opacity -> Bool
opacityGiven Nothing = False
opacityGiven (Just _) = True

opacitySpecOf : Maybe Opacity -> String -> Span -> Maybe OpacitySpec
opacitySpecOf Nothing name sp = Nothing
opacitySpecOf (Just kind) name sp = Just (OpacitySpec name kind sp)

-- | `export [opaque|transparent] f : T`（也接受无签名的子句，交给 Elab 报既有诊断）。
parseExportedValue : Maybe Opacity -> PState -> Int -> Check (Pair ParsedDecl PState)
parseExportedValue op st blockCol = case peekTok st of
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True name p)
      (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanOf st st2))) (opacitySpecOf op name (spanOf st st2))) st2))
    else Vuna.Compiler.Base.Common.step (parseClause st1 blockCol name p)
      (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanOf st st2))) (opacitySpecOf op name (spanOf st st2))) st2))
  -- 声明位带括号的符号名：`export (==) : ...` / `export (<+>) x y = ...`。
  PTok (TSym "(") p =>
    Vuna.Compiler.Base.Common.step (expectDeclName st)
      (\name, st1 => if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True name (peekPos st)) (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanOf st st2))) (opacitySpecOf op name (spanOf st st2))) st2)) else Vuna.Compiler.Base.Common.step (parseClause st1 blockCol name (peekPos st)) (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanOf st st2))) (opacitySpecOf op name (spanOf st st2))) st2)))
  PTok (TSym sym) p => if isReservedValueName sym then ps1 st (ExpectedToken "value name") "value name"
  else
    let
      st1 = advance st
    in if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True sym p)
      (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue sym (spanOf st st2))) (opacitySpecOf op sym (spanOf st st2))) st2))
    else Vuna.Compiler.Base.Common.step (parseClause st1 blockCol sym p)
      (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue sym (spanOf st st2))) (opacitySpecOf op sym (spanOf st st2))) st2))
  _ => ps1 st (ExpectedToken "value name") "value name"

parseAxiomExport : Maybe Opacity -> PState -> Int -> Pos -> Check (Pair ParsedDecl PState)
parseAxiomExport op st blockCol kwPos = if opacityGiven op then ps1 st (ExpectedToken "value signature") "value signature"
else Vuna.Compiler.Base.Common.step (parseAxiom st blockCol kwPos) (\decl, st1 => case decl of
  DAxiom name _ sp =>
    OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue name sp)) Nothing) st1)
  _ => icInternal "parseAxiomExport: not an axiom"
)

parseExternExport : Maybe Opacity -> PState -> Int -> Pos -> Check (Pair ParsedDecl PState)
parseExternExport op st blockCol kwPos = if opacityGiven op then ps1 st (ExpectedToken "value signature") "value signature"
else Vuna.Compiler.Base.Common.step (parseExtern st blockCol kwPos) (\decl, st1 => case decl of
  DExtern name _ _ sp =>
    OkC (Pair (ParsedDecl Nothing (Just decl) (Just (ESValue name sp)) Nothing) st1)
  _ => icInternal "parseExternExport: not an extern"
)

-- | `export linear data/record ...`。
parseLinearExport : PState -> Int -> Pos -> Check (Pair ParsedDecl PState)
parseLinearExport st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "linear") (\st1 => case peekTok st1 of
  PTok (TKw "data") _ => parseDataExport True st1 blockCol kwPos
  PTok (TKw "record") _ => parseRecordExport True ReprAuto st1 blockCol kwPos
  _ => ps1 st1 (ExpectedToken "data/record") "data/record"
)

-- | 归约修饰符：`opaque f : T` / `transparent f : T`（值定义；不导出）。
parseOpacityDecl : PState -> Int -> Check (Pair ParsedDecl PState)
parseOpacityDecl st blockCol = case peekTok st of
  PTok (TKw "opaque") p =>
    Vuna.Compiler.Base.Common.bind (expectKw st "opaque")
      (\st1 => parseOpacityValue OpacityOpaque st1 blockCol (spanOf st st1))
  PTok (TKw "transparent") p =>
    Vuna.Compiler.Base.Common.bind (expectKw st "transparent")
      (\st1 => parseOpacityValue OpacityTransparent st1 blockCol (spanOf st st1))
  PTok (TIdent "abstract") p =>
    Vuna.Compiler.Base.Common.step (expectIdent st)
      (\_, st1 => parseOpacityValue OpacityAbstract st1 blockCol (spanOf st st1))
  _ => ps0 st ExpectedTopLevelDecl

parseOpacityValue : Opacity -> PState -> Int -> Span -> Check (Pair ParsedDecl PState)
parseOpacityValue kind st blockCol kwSpan = case peekTok st of
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True name p)
      (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) Nothing (Just (OpacitySpec name kind (spanOf st st2)))) st2))
    else ps1 st (ExpectedToken "value signature") "value signature"
  PTok (TSym sym) p => if isReservedValueName sym then ps1 st (ExpectedToken "value name") "value name"
  else
    let
      st1 = advance st
    in if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True sym p)
      (\decl, st2 => OkC (Pair (ParsedDecl Nothing (Just decl) Nothing (Just (OpacitySpec sym kind (spanOf st st2)))) st2))
    else ps1 st (ExpectedToken "value signature") "value signature"
  _ => ps1 st (ExpectedToken "value signature") "value signature"

-- | `export alias record` / `export boxed record`。
parseTieredExport : ReprTier -> PState -> Int -> Pos -> Check (Pair ParsedDecl PState)
parseTieredExport tier st blockCol kwPos = case peekTok (advance st) of
  PTok (TKw "linear") _ => case peekTok (advance (advance st)) of
    PTok (TKw "record") _ => parseRecordExport True tier (advance (advance st)) blockCol kwPos
    _ => ps1 (advance st) (ExpectedToken "record") "record"
  PTok (TKw "record") _ => parseRecordExport False tier (advance st) blockCol kwPos
  _ => ps1 (advance st) (ExpectedToken "record") "record"

-- | 导出 `data`：名字/参数后允许成员列表 `(..)` / `(A, B)` / `()`。
parseDataExport : Bool -> PState -> Int -> Pos -> Check (Pair ParsedDecl PState)
parseDataExport lin st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "data") (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (\params, st3 => Vuna.Compiler.Base.Common.step (parseOptionalMembers st3) (\members, st3b => Vuna.Compiler.Base.Common.bind (expectSym st3b ":") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st4) st4 blockCol) (\ty, st5 => Vuna.Compiler.Base.Common.bind (expectKw st5 "where") (\st6 => Vuna.Compiler.Base.Common.step (parseCtors st6 blockCol) (\ctors, st7 => Vuna.Compiler.Base.Common.step (parseDeriving st7) (\dv, st8 => case dv of
  Pair derivings via =>
    let
      decl =
        DData name params ty ctors derivings via ReprAuto lin
          (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st8)) (posCol (lastPos st8)) (posOffset kwPos) (posOffset (lastPos st8)))
    in OkC
      (Pair (ParsedDecl Nothing (Just decl) (Just (ESType name members (declSpan decl))) Nothing) st8)
)
)
)
)
)
)
)
)
)

parseRecordExport : Bool -> ReprTier -> PState -> Int -> Pos -> Check (Pair ParsedDecl PState)
parseRecordExport lin tier st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "record") (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (\params, st3 => Vuna.Compiler.Base.Common.step (parseOptionalMembers st3) (\members, st3b => Vuna.Compiler.Base.Common.bind (expectKw st3b "where") (\st4 => Vuna.Compiler.Base.Common.step (parseFields st4 blockCol) (\fields, st5 => Vuna.Compiler.Base.Common.step (parseDeriving st5) (\dv, st6 => case dv of
  Pair derivings via =>
    let
      decl =
        DRecord name params fields derivings via tier lin
          (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st6)) (posCol (lastPos st6)) (posOffset kwPos) (posOffset (lastPos st6)))
    in OkC
      (Pair (ParsedDecl Nothing (Just decl) (Just (ESType name members (declSpan decl))) Nothing) st6)
)
)
)
)
)
)
)

parseTraitExport : PState -> Int -> Pos -> Check (Pair ParsedDecl PState)
parseTraitExport st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "trait") (\st1 => Vuna.Compiler.Base.Common.step (parseTraitHead st1) (\h, st2 => Vuna.Compiler.Base.Common.step (parseTraitExportMembers st2) (\members, st3 => Vuna.Compiler.Base.Common.bind (expectKw st3 "where") (\st4 => Vuna.Compiler.Base.Common.step (parseMethodSigs st4 blockCol) (\methods, st5 => let
  decl =
    DTrait h.traitHeadName h.traitHeadParams h.traitHeadSupers methods
      (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st5)) (posCol (lastPos st5)) (posOffset kwPos) (posOffset (lastPos st5)))
in OkC
  (Pair (ParsedDecl Nothing (Just decl) (Just (ESType h.traitHeadName members (declSpan decl))) Nothing) st5)
)
)
)
)
)

-- trait 头：`[C1 a, C2 b =>] Name params`。父类约束在 trait 名之前（Haskell 风格）。
-- 用 token lookahead 判断是否存在约束前缀：`=>` 出现在 `where` 之前且括号深度为 0。
record TraitHead where
  traitHeadName : String
  traitHeadParams : List TraitParam
  traitHeadSupers : List Expr

parseTraitHead : PState -> Check (Pair TraitHead PState)
parseTraitHead st = if traitSupersFollow st then Vuna.Compiler.Base.Common.bind (parseTraitSupers (stateFuel st) st) (\p => let
  supers = firstOf p
  st1 = secondOf p
in Vuna.Compiler.Base.Common.step (expectIdent st1)
  (\name, st2 => Vuna.Compiler.Base.Common.step (parseTraitParams (stateFuel st2) st2) (\params, st3 => OkC (Pair (TraitHead name params supers) st3)))
)
else Vuna.Compiler.Base.Common.step (expectIdent st)
  (\name, st1 => Vuna.Compiler.Base.Common.step (parseTraitParams (stateFuel st1) st1) (\params, st2 => OkC (Pair (TraitHead name params []) st2)))

traitSupersFollow : PState -> Bool
traitSupersFollow st = traitSupersFollowGo 0 st.toksOf

traitSupersFollowGo : Int -> List PTok -> Bool
traitSupersFollowGo depth [] = False
traitSupersFollowGo depth ((PTok tok p) :: rest) = case tok of
  TSym "=>" => depth == 0
  TKw "where" => False
  TSym "(" => traitSupersFollowGo (depth + 1) rest
  TSym ")" => traitSupersFollowGo (if depth > 0 then depth - 1 else 0) rest
  _ => traitSupersFollowGo depth rest

parseTraitSupers : Int -> PState -> Check (Pair (List Expr) PState)
parseTraitSupers fuel st =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parseExpr fuel st 0)
    (\e1, st1 => parseTraitSupersRest (fuel - 1) st1 [e1])

parseTraitSupersRest : Int -> PState -> List Expr -> Check (Pair (List Expr) PState)
parseTraitSupersRest fuel st acc =
  if fuel <= 0 then icFuel "parser"
  else if atSym st "=>" then OkC (Pair (reverse acc) (advance st))
  else Vuna.Compiler.Base.Common.bind (expectSym st ",")
    (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 0) (\e, st2 => parseTraitSupersRest (fuel - 1) st2 (e :: acc)))

-- trait 导出成员：`trait C(..)` / `trait C(m1, m2)`；无成员列表 = EMNone。
parseTraitExportMembers : PState -> Check (Pair ExportMembers PState)
parseTraitExportMembers st = parseOptionalMembers st

-- 只看括号组里第一个 token：`..` / `)` / `ident ,` / `ident )` 是成员列表；
-- `ident ident :` / `ident :` 是显式 kind 参数。
parenIsMemberList : PState -> Bool
parenIsMemberList st = case peekTok (advance st) of
  PTok (TSym "..") _ => True
  PTok (TSym ")") _ => True
  PTok (TIdent _) _ => case peekTok (advance (advance st)) of
    PTok (TSym ",") _ => True
    PTok (TSym ")") _ => True
    _ => False
  _ => False

parseOptionalMembers : PState -> Check (Pair ExportMembers PState)
parseOptionalMembers st = if atSym st "(" then parseExportMembers st else OkC (Pair EMNone st)

-- `infixl 6 +` / `infixr 5 :: = Cons` / `infix 4 == = eq`。
parseFixityDecl : PState -> Int -> Int -> Pos -> Check (Pair FixityDecl PState)
parseFixityDecl st blockCol assoc kwPos =
  Vuna.Compiler.Base.Common.step (expectFixityLevel (advance st))
    (\level, st1 => Vuna.Compiler.Base.Common.step (expectOpName st1) (\op, st2 => if atSym st2 "=" then Vuna.Compiler.Base.Common.bind (expectSym st2 "=") (\st3 => Vuna.Compiler.Base.Common.step (expectOpName st3) (\target, st4 => OkC (Pair (FixityDecl op level assoc (Just target) (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st4)) (posCol (lastPos st4)) (posOffset kwPos) (posOffset (lastPos st4)))) st4))) else OkC (Pair (FixityDecl op level assoc Nothing (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st2)) (posCol (lastPos st2)) (posOffset kwPos) (posOffset (lastPos st2)))) st2)))

-- 声明位的名字：标识符 / `(sym)` / 裸符号。trait 方法、instance 方法、data 构造子
-- 与导出成员列表共用，允许运算符与标识符同等使用。保留符号不是可定义名。
expectDeclName : PState -> Check (Pair String PState)
expectDeclName st = case peekTok st of
  PTok (TIdent name) _ => OkC (Pair name (advance st))
  PTok (TSym "(") _ => case peekTokAt st 1 of
    Just (PTok (TSym sym) _) => if isReservedValueName sym then ps1 st (ExpectedToken "operator") "operator"
    else case peekTokAt st 2 of
      Just (PTok (TSym ")") _) => OkC (Pair sym (advance (advance (advance st))))
      _ => ps1 st (ExpectedToken "operator") "operator"
    _ => ps1 st (ExpectedToken "operator") "operator"
  PTok (TSym sym) _ =>
    if isReservedValueName sym then ps1 st (ExpectedToken "operator") "operator"
    else OkC (Pair sym (advance st))
  _ => ps0 st ExpectedIdentifier

expectFixityLevel : PState -> Check (Pair Int PState)
expectFixityLevel st = case peekTok st of
  PTok (TInt n) p => if n >= 0 && n <= 9 then OkC (Pair n (advance st)) else ps0 st FixityLevelRange
  _ => ps0 st ExpectedFixityLevel

-- fixity/别名声明里的运算符名：符号（`+`、`::`）或标识符（`eq`）。
-- 保留符号（`isSyntaxSym` ∪ {`->`, `` ` ``}）不是用户运算符，不能声明 fixity。
expectOpName : PState -> Check (Pair String PState)
expectOpName st = case peekTok st of
  PTok (TSym op) p =>
    if isReservedValueName op then ps1 st (ExpectedToken "operator") "operator"
    else OkC (Pair op (advance st))
  PTok (TIdent name) p =>
    if isReservedValueName name then ps1 st (ExpectedToken "operator") "operator"
    else OkC (Pair name (advance st))
  _ => ps1 st (ExpectedToken "operator") "operator"

parseDecl : PState -> Int -> Check (Pair Decl PState)
parseDecl st blockCol = case peekTok st of
  PTok (TKw "data") p => parseData False st blockCol p
  PTok (TKw "linear") p => parseLinearDecl st blockCol p
  -- 表示档位前缀只允许 record（data 收归位置/求和类型）。
  -- `alias` / `boxed` 是软关键字（只在紧跟 record/linear record 时生效）。
  PTok (TKw "axiom") p => parseAxiom st blockCol p
  PTok (TKw "extern") p => parseExtern st blockCol p
  PTok (TKw "record") p => parseRecord False ReprAuto st blockCol p
  PTok (TKw "trait") p => parseTrait st blockCol p
  PTok (TKw "instance") p => parseInstance st blockCol p
  -- 声明位的运算符名：`(==) : ...` / `(<+>) x y = ...`（与 trait 方法 / instance 方法 /
  -- 构造子一致）。裸符号写法（`<+> x y = ...`）同样接受。
  PTok (TSym "(") p =>
    Vuna.Compiler.Base.Common.step (expectDeclName st)
      (\name, st1 => if atSym st1 ":" then parseSignature st1 blockCol True name p else parseClause st1 blockCol name p)
  PTok (TIdent name) p => if name == "alias" && tierFollows st then parseTieredDecl ReprAlias st blockCol p
  else if name == "boxed" && tierFollows st then parseTieredDecl ReprBoxed st blockCol p
  else
    let
      st1 = advance st
    in if atSym st1 ":" then parseSignature st1 blockCol True name p
    else parseClause st1 blockCol name p
  -- 用户符号名函数（`<+> a b = a + b`）与签名（`<+> : ...`）。
  -- 保留符号（`->` / 反引号 / 语法符号）不是可定义名。
  PTok (TSym op) p => if isReservedValueName op then ps0 st ExpectedTopLevelDecl
  else
    let
      st1 = advance st
    in if atSym st1 ":" then parseSignature st1 blockCol True op p else parseClause st1 blockCol op p
  _ => ps0 st ExpectedTopLevelDecl

-- axiom 声明（D10）：`axiom name : Ty`，无 `=` 体。
-- 它是无体的可擦除顶层，只在类型层可用（运行时使用由擦除检查拒绝）。
parseAxiom : PState -> Int -> Pos -> Check (Pair Decl PState)
parseAxiom st blockCol kwPos =
  Vuna.Compiler.Base.Common.bind (expectKw st "axiom")
    (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 ":") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st3) st3 blockCol) (\ty, st4 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st4) (\st5 => OkC (Pair (DAxiom name ty (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st5)) (posCol (lastPos st5)) (posOffset kwPos) (posOffset (lastPos st5)))) st5))))))

-- 受限 FFI 声明 `extern name "c_name" : Ty`（无体）。类型只允许基本类型，
-- 由 Elab 检查；运行时由包根 `ffi/*.c` 提供，codegen 生成 OCaml `external`。
parseExtern : PState -> Int -> Pos -> Check (Pair Decl PState)
parseExtern st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "extern") (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => case peekTok st2 of
  PTok (TStr cName) cp =>
    Vuna.Compiler.Base.Common.step (OkC (Pair cName (advance st2)))
      (\cName2, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 ":") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st4) st4 blockCol) (\ty, st5 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st5) (\st6 => OkC (Pair (DExtern name cName2 ty (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st6)) (posCol (lastPos st6)) (posOffset kwPos) (posOffset (lastPos st6)))) st6)))))
  _ => ps1 st2 (ExpectedToken "string") "string"
)
)

-- 只有顶层签名允许 trait 约束 `C a =>`。其它签名位置（axiom / where / let /
-- trait 方法 / 构造子 / 记录字段）见到 `=>` 时直接给出明确诊断，而不是让 `=>` 作为
-- 残留 token 触发难懂的收尾错误。
rejectCtxSuffix : PState -> Check PState
rejectCtxSuffix st = if atSym st "=>" then ps0 st ConstraintUnsupportedHere else OkC st

-- 顶层签名：`name : [C1 a, C2 b =>] τ`。`allowCtx=False` 供 instance 方法签名复用同一
-- 解析入口（instance 方法的约束由实例 ctx 提供，签名上写 `=>` 报明确诊断）。
parseSignature : PState -> Int -> Bool -> String -> Pos -> Check (Pair Decl PState)
parseSignature st blockCol allowCtx name namePos = Vuna.Compiler.Base.Common.bind (expectSym st ":") (\st1 => Vuna.Compiler.Base.Common.step (parseCtxThenExpr (stateFuel st1) st1 blockCol) (\hc, st2 => case hc of
  Pair ctx ty => case ctx of
    [] =>
      OkC
        (Pair (DSig name [] ty (Span (fileOf st) (posLine namePos) (posCol namePos) (posLine (lastPos st2)) (posCol (lastPos st2)) (posOffset namePos) (posOffset (lastPos st2)))) st2)
    _ =>
      if allowCtx then OkC
        (Pair (DSig name ctx ty (Span (fileOf st) (posLine namePos) (posCol namePos) (posLine (lastPos st2)) (posCol (lastPos st2)) (posOffset namePos) (posOffset (lastPos st2)))) st2)
      else ps0 st1 ConstraintUnsupportedHere
)
)

parseClause : PState -> Int -> String -> Pos -> Check (Pair Decl PState)
parseClause st blockCol name namePos = Vuna.Compiler.Base.Common.step (parseClausePatterns (stateFuel st) st blockCol) (\pats, st1 => Vuna.Compiler.Base.Common.bind (checkBindersAt st pats) (\_ => Vuna.Compiler.Base.Common.bind (expectSym st1 "=") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 blockCol) (\body, st3 => Vuna.Compiler.Base.Common.step (parseWhere st3 blockCol) (\wheres, st4 => let
  body2 = case wheres of
    [] => body
    _ :: _ => ELet wheres body True (spanOf st st4)
in OkC
  (Pair (DFun name pats body2 (Span (fileOf st) (posLine namePos) (posCol namePos) (posLine (lastPos st4)) (posCol (lastPos st4)) (posOffset namePos) (posOffset (lastPos st4)))) st4)
)
)
)
)
)

-- where 块：`body where\n  <bindings>`，解析后 desugar 成 ELet（绑定对 body 可见）。
--
-- ---------------------------------------------------------------
-- 绑定块（统一作用域模型）：`where` 与 `let` 共用同一套绑定块解析：
--   * 每个绑定可先写一行签名 `name : Ty`（必须写在同名子句**之前**）；
--   * 子句可以是 `pat = expr` 或函数子句 `name pats = expr`（降级成 λ）。
-- 有签名的绑定把签名贴到紧随其后的同名子句值上（`EAnn value ty`，span 指向签名行），
-- Elab 据此在 checking 模式精化该值。两条记法只差一条：`where` 块**要求**每个绑定都有
-- 签名行（由 Elab 的 `checkBindingSigs` 用一个诊断收口），`let` 的签名是可选的。
-- ---------------------------------------------------------------
parseWhere : PState -> Int -> Check (Pair (List (Pair Pat Expr)) PState)
parseWhere st blockCol = case peekTok st of
  PTok (TKw "where") p =>
    if posCol p > blockCol then Vuna.Compiler.Base.Common.step (OkC (Pair 0 (advance st)))
      (\_, st1 => Vuna.Compiler.Base.Common.step (parseWhereBindings st1 blockCol) (\binds, st2 => OkC (Pair binds st2)))
    else OkC (Pair [] st)
  _ => OkC (Pair [] st)

parseWhereBindings : PState -> Int -> Check (Pair (List (Pair Pat Expr)) PState)
parseWhereBindings st whereCol = if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col > whereCol then Vuna.Compiler.Base.Common.step (parseBindingItemsAt (stateFuel st) st col)
      (\items, st1 => Vuna.Compiler.Base.Common.bind (bindingItemsToBinds items) (\binds => OkC (Pair binds st1)))
    else OkC (Pair [] st)

-- 绑定块的条目：签名行或一条绑定（`pat = expr` / `name pats = expr`）。
data BindingItem : Type where
  BISig : String -> Expr -> Span -> BindingItem
  BIBind : Pair Pat Expr -> BindingItem

parseBindingItemsAt : Int -> PState -> Int -> Check (Pair (List BindingItem) PState)
parseBindingItemsAt fuel st bindCol = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair [] st)
else if atKw st "in" then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col == bindCol then Vuna.Compiler.Base.Common.step (parseBindingItem (fuel - 1) st bindCol)
      (\item, st1 => Vuna.Compiler.Base.Common.step (parseBindingItemsAt (fuel - 1) st1 bindCol) (\rest, st2 => OkC (Pair ((::) item rest) st2)))
    else if col > bindCol then ps0 st UnexpectedIndentInBinding else OkC (Pair [] st)

parseBindingItem : Int -> PState -> Int -> Check (Pair BindingItem PState)
parseBindingItem fuel st bindCol = if fuel <= 0 then icFuel "parser"
else Vuna.Compiler.Base.Common.step (parsePatternSingle (stateFuel st) st bindCol) (\pat, st1 => case pat of
  PVar name psp =>
    if atSym st1 ":" then Vuna.Compiler.Base.Common.bind (expectSym st1 ":")
      (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 bindCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st3) (\st4 => OkC (Pair (BISig name ty (spanOf st st4)) st4))))
    else parseBindingDef (fuel - 1) st st1 bindCol pat
  _ => parseBindingDef (fuel - 1) st st1 bindCol pat
)

-- 单条绑定：`pat = expr` 或函数子句 `name pats = expr`（desugar 成 λ）。
parseBindingDef : Int -> PState -> PState -> Int -> Pat -> Check (Pair BindingItem PState)
parseBindingDef fuel stStart st bindCol pat = if fuel <= 0 then icFuel "parser"
else case pat of
  PVar name _ =>
    if startsPatternAtom st && canContinue st bindCol then Vuna.Compiler.Base.Common.step (parseClausePatterns (stateFuel st) st bindCol)
      (\pats, st2 => Vuna.Compiler.Base.Common.bind (checkBindersAt st pats) (\_ => Vuna.Compiler.Base.Common.bind (expectSym st2 "=") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st3 bindCol) (\value, st4 => OkC (Pair (BIBind (Pair (PVar name (patSpan pat)) (ELocalFun [Pair pats value] (spanOf stStart st4)))) st4)))))
    else Vuna.Compiler.Base.Common.step (parseBindingValue (fuel - 1) st pat bindCol)
      (\b, st2 => OkC (Pair (BIBind b) st2))
  _ =>
    Vuna.Compiler.Base.Common.step (parseBindingValue (fuel - 1) st pat bindCol)
      (\b, st2 => OkC (Pair (BIBind b) st2))

parseBindingValue : Int -> PState -> Pat -> Int -> Check (Pair (Pair Pat Expr) PState)
parseBindingValue fuel st pat blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (checkBindersAt st [pat])
    (\_ => Vuna.Compiler.Base.Common.bind (expectSym st "=") (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\value, st2 => OkC (Pair (Pair pat value) st2))))

-- 条目 → ELet 绑定：把签名贴到同名定义的值上（`EAnn value ty`），并校验布局约束：
-- 签名必须先于同名定义、不能重复、不能悬空。
bindingItemsToBinds : List BindingItem -> Check (List (Pair Pat Expr))
bindingItemsToBinds items = bindingBindsGo items [] [] []

bindingBindsGo : List BindingItem -> List (Pair String (Pair Expr Span)) -> List String -> List (Pair Pat Expr) -> Check (List (Pair Pat Expr))
bindingBindsGo [] sigs bound acc = case firstDanglingSig (reverse sigs) bound of
  Nothing => OkC (reverse acc)
  Just (Pair name sp) =>
    ErrC (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg (WhereSigNoDef name) [name]))
bindingBindsGo (item :: rest) sigs bound acc = case item of
  BISig name ty sp =>
    if memName name bound then ErrC
      (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg (WhereSigBeforeClause name) [name]))
    else if hasBindingSig name sigs then ErrC
      (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg (WhereSigDuplicate name) [name]))
    else bindingBindsGo rest (Pair name (Pair ty sp) :: sigs) bound acc
  BIBind (Pair pat value) => case localFunMerge (patBoundName pat) value acc of
    Just merged => bindingBindsGo rest sigs bound merged
    Nothing => case bindingSigOf (patBoundName pat) sigs of
      Just (Pair ty sp) =>
        if memName (patBoundName pat) bound then ErrC
          (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg (WhereSigMultiClause (patBoundName pat)) [patBoundName pat]))
        else bindingBindsGo rest sigs (patBoundName pat :: bound) (Pair pat (EAnn value ty sp) :: acc)
      Nothing => bindingBindsGo rest sigs (patBoundName pat :: bound) (Pair pat value :: acc)

-- 把相邻同名函数子句合并成一个 `ELocalFun` 绑定（where/let 多 clause）。
-- 签名保留在合并后的条目上（`EAnn` 只包裹第一条的 `ELocalFun`）；不连续的同名子句
-- 不合并，按 `WhereSigMultiClause` 报错。
localFunMerge : String -> Expr -> List (Pair Pat Expr) -> Maybe (List (Pair Pat Expr))
localFunMerge name value ((Pair (PVar n nsp) (ELocalFun cs0 sp0)) :: rest) = if n == name then case value of
  ELocalFun cs1 sp1 => Just ((::) (Pair (PVar n nsp) (ELocalFun (append cs0 cs1) sp0)) rest)
  _ => Nothing
else Nothing
localFunMerge name value ((Pair (PVar n nsp) (EAnn (ELocalFun cs0 sp0) ty annSp)) :: rest) = if n == name then case value of
  ELocalFun cs1 sp1 =>
    Just ((::) (Pair (PVar n nsp) (EAnn (ELocalFun (append cs0 cs1) sp0) ty annSp)) rest)
  _ => Nothing
else Nothing
localFunMerge name value _ = Nothing

-- 绑定名（非简单变量绑定返回空串，永远匹配不到签名）。
patBoundName : Pat -> String
patBoundName (PVar name sp) = name
patBoundName _ = ""

bindingSigOf : String -> List (Pair String (Pair Expr Span)) -> Maybe (Pair Expr Span)
bindingSigOf name [] = Nothing
bindingSigOf name ((Pair n v) :: rest) = if n == name then Just v else bindingSigOf name rest

hasBindingSig : String -> List (Pair String (Pair Expr Span)) -> Bool
hasBindingSig name sigs = case bindingSigOf name sigs of
  Just _ => True
  Nothing => False

firstDanglingSig : List (Pair String (Pair Expr Span)) -> List String -> Maybe (Pair String Span)
firstDanglingSig [] bound = Nothing
firstDanglingSig ((Pair name (Pair ty sp)) :: rest) bound =
  if memName name bound then firstDanglingSig rest bound else Just (Pair name sp)

-- λ 参数名：绑定块里的函数子句参数必须是简单变量名（模式版本见 parseBindingDef）。
parseClausePatterns : Int -> PState -> Int -> Check (Pair (List Pat) PState)
parseClausePatterns fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else if startsPatternAtom st && canContinue st blockCol then Vuna.Compiler.Base.Common.step (parsePatternAtom (stateFuel st) st blockCol)
    (\pat, st1 => Vuna.Compiler.Base.Common.step (parseClausePatterns (fuel - 1) st1 blockCol) (\rest, st2 => OkC (Pair ((::) pat rest) st2)))
  else OkC (Pair [] st)

-- `lin data ...` / `lin record ...`。kwPos 指向 `linear`，声明 span 从这里开始。
parseLinearDecl : PState -> Int -> Pos -> Check (Pair Decl PState)
parseLinearDecl st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "linear") (\st1 => case peekTok st1 of
  PTok (TKw "data") _ => parseData True st1 blockCol kwPos
  PTok (TKw "record") _ => parseRecord True ReprAuto st1 blockCol kwPos
  _ => ps1 st1 (ExpectedToken "data/record") "data/record"
)

-- | 软关键字 `alias` / `boxed`：后面必须跟 `record` 或 `linear record` 才按档位前缀解析；
-- 否则退化成普通标识符（现有源码里的 `alias` binder 就是靠这条保持可用）。
tierFollows : PState -> Bool
tierFollows st = case peekTok (advance st) of
  PTok (TKw "record") _ => True
  PTok (TKw "linear") _ => case peekTok (advance (advance st)) of
    PTok (TKw "record") _ => True
    _ => False
  _ => False

-- | `alias record ...` / `boxed record ...`（可再带 `lin`）。
-- kwPos 指向档位前缀，声明 span 从这里开始；档位只对 record 有意义（对 data 报错）。
parseTieredDecl : ReprTier -> PState -> Int -> Pos -> Check (Pair Decl PState)
parseTieredDecl tier st blockCol kwPos = case peekTok (advance st) of
  PTok (TKw "linear") _ =>
    let
      st1 = advance (advance st)
    in case peekTok st1 of
      PTok (TKw "record") _ => parseRecord True tier st1 blockCol kwPos
      _ => ps1 st1 (ExpectedToken "record") "record"
  PTok (TKw "record") _ => parseRecord False tier (advance st) blockCol kwPos
  _ => ps1 (advance st) (ExpectedToken "record") "record"

parseData : Bool -> PState -> Int -> Pos -> Check (Pair Decl PState)
parseData lin st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "data") (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (\params, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 ":") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st4) st4 blockCol) (\ty, st5 => Vuna.Compiler.Base.Common.bind (expectKw st5 "where") (\st6 => Vuna.Compiler.Base.Common.step (parseCtors st6 blockCol) (\ctors, st7 => Vuna.Compiler.Base.Common.step (parseDeriving st7) (\dv, st8 => case dv of
  Pair derivings via =>
    OkC
      (Pair (DData name params ty ctors derivings via ReprAuto lin (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st8)) (posCol (lastPos st8)) (posOffset kwPos) (posOffset (lastPos st8)))) st8)
)
)
)
)
)
)
)
)

-- 记录声明：`record Name params where` + 缩进字段 `f : Ty`，可跟 deriving。
-- 第二参数是表示档位（`alias`/`boxed` 前缀给出，缺省 `ReprAuto`）。
parseRecord : Bool -> ReprTier -> PState -> Int -> Pos -> Check (Pair Decl PState)
parseRecord lin tier st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "record") (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (\params, st3 => Vuna.Compiler.Base.Common.bind (expectKw st3 "where") (\st4 => Vuna.Compiler.Base.Common.step (parseFields st4 blockCol) (\fields, st5 => Vuna.Compiler.Base.Common.step (parseDeriving st5) (\dv, st6 => case dv of
  Pair derivings via =>
    OkC
      (Pair (DRecord name params fields derivings via tier lin (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st6)) (posCol (lastPos st6)) (posOffset kwPos) (posOffset (lastPos st6)))) st6)
)
)
)
)
)
)

parseFields : PState -> Int -> Check (Pair (List Field) PState)
parseFields st blockCol = if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col > blockCol then parseFieldList (stateFuel st) st col else OkC (Pair [] st)

parseFieldList : Int -> PState -> Int -> Check (Pair (List Field) PState)
parseFieldList fuel st fieldCol = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col == fieldCol then Vuna.Compiler.Base.Common.step (expectIdent st)
      (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ":") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 fieldCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st3) (\st3b => Vuna.Compiler.Base.Common.step (parseFieldList (fuel - 1) st3b fieldCol) (\rest, st4 => OkC (Pair ((::) (Field name ty (spanOf st st3)) rest) st4))))))
    else if col > fieldCol then ps0 st UnexpectedIndentInRecord else OkC (Pair [] st)

-- `deriving via field (C...)` 的 `via`/`field` 是上下文标识符，不进关键字表。
-- | 当前 token 是否是指定名字的标识符（`via`/`field` 等上下文关键字用）。
atIdentName : PState -> String -> Bool
atIdentName st name = case peekTok st of
  PTok (TIdent n) _ => n == name
  _ => False

-- deriving (TraitA, TraitB) 或 deriving via field (TraitA, TraitB)；
-- 可出现在 data/record 的构造器/字段块之后（strategy 只能用于 record）。
parseDeriving : PState -> Check (Pair (Pair (List String) Bool) PState)
parseDeriving st =
  if atKw st "deriving" then Vuna.Compiler.Base.Common.bind (expectKw st "deriving")
    (\st1 => if atIdentName st1 "via" then Vuna.Compiler.Base.Common.step (expectIdent st1) (\_, st2 => Vuna.Compiler.Base.Common.step (expectIdent st2) (\fld, st3 => if fld == "field" then parseDerivingParens True st3 else ps1 st2 (ExpectedToken "field") "field")) else parseDerivingParens False st1)
  else OkC (Pair (Pair [] False) st)

-- | 解析 `deriving` 后的 `(TraitA, TraitB)` 括号列表；`via` 标志原样带回结果。
parseDerivingParens : Bool -> PState -> Check (Pair (Pair (List String) Bool) PState)
parseDerivingParens via st =
  Vuna.Compiler.Base.Common.bind (expectSym st "(")
    (\st1 => if atSym st1 ")" then OkC (Pair (Pair [] via) (advance st1)) else Vuna.Compiler.Base.Common.step (parseDerivingNames (stateFuel st1) st1) (\names, st2 => OkC (Pair (Pair names via) st2)))

parseDerivingNames : Int -> PState -> Check (Pair (List String) PState)
parseDerivingNames fuel st =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (expectIdent st)
    (\name, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseDerivingNames (fuel - 1) (advance st1)) (\rest, st2 => OkC (Pair ((::) name rest) st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (Pair [name] st2)))

-- trait 声明：`trait [supers =>] Name params where` + 缩进方法签名 `m : Ty`。
-- 多参数 trait 参数可带显式 kind：`trait C (a : Type) (r : Row)`（裸参数仍支持）。
parseTrait : PState -> Int -> Pos -> Check (Pair Decl PState)
parseTrait st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "trait") (\st1 => Vuna.Compiler.Base.Common.step (parseTraitHead st1) (\h, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "where") (\st3 => Vuna.Compiler.Base.Common.step (parseMethodSigs st3 blockCol) (\methods, st4 => let
  decl =
    DTrait h.traitHeadName h.traitHeadParams h.traitHeadSupers methods
      (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st4)) (posCol (lastPos st4)) (posOffset kwPos) (posOffset (lastPos st4)))
in OkC (Pair decl st4)
)
)
)
)

-- trait 参数：裸标识符（kind 由方法签名推断）或 `(a b : Kind)` / `(a : Kind)`。
parseTraitParams : Int -> PState -> Check (Pair (List TraitParam) PState)
parseTraitParams fuel st = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent name) _ =>
    Vuna.Compiler.Base.Common.step (parseTraitParams (fuel - 1) (advance st))
      (\rest, st1 => OkC (Pair ((::) (TraitParam name Nothing) rest) st1))
  PTok (TSym "(") _ =>
    if parenIsMemberList st then OkC (Pair [] st)
    else Vuna.Compiler.Base.Common.bind (expectSym st "(")
      (\st1 => Vuna.Compiler.Base.Common.step (parsePiNames (fuel - 1) st1) (\names, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 ":") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st3) st3 0) (\kind, st4 => Vuna.Compiler.Base.Common.bind (expectSym st4 ")") (\st5 => Vuna.Compiler.Base.Common.step (parseTraitParams (fuel - 1) st5) (\rest, st6 => OkC (Pair (append (map (\n => TraitParam n (Just kind)) names) rest) st6)))))))
  _ => OkC (Pair [] st)

parseMethodSigs : PState -> Int -> Check (Pair (List TraitMethod) PState)
parseMethodSigs st blockCol = if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col > blockCol then parseMethodSigList (stateFuel st) st col else OkC (Pair [] st)

parseMethodSigList : Int -> PState -> Int -> Check (Pair (List TraitMethod) PState)
parseMethodSigList fuel st methodCol = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col == methodCol then Vuna.Compiler.Base.Common.step (expectDeclName st)
      (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ":") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 methodCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st3) (\st3b => Vuna.Compiler.Base.Common.step (parseMethodSigList (fuel - 1) st3b methodCol) (\rest, st4 => OkC (Pair ((::) (TraitMethod name ty (spanOf st st3)) rest) st4))))))
    else if col > methodCol then ps0 st UnexpectedIndentInTrait else OkC (Pair [] st)

-- instance 声明：`instance [<ctx> ,... =>] Head where` + 缩进方法定义。
-- ctx 是逗号分隔的字典约束（每个形如 `C arg`；只支持单参数 trait）。
-- 实例头与顶层签名共用「[ctx , ... =>] expr」解析（ctx 为空 = 无约束）。
parseInstance : PState -> Int -> Pos -> Check (Pair Decl PState)
parseInstance st blockCol kwPos = Vuna.Compiler.Base.Common.bind (expectKw st "instance") (\st1 => Vuna.Compiler.Base.Common.step (parseCtxThenExpr (stateFuel st1) st1 blockCol) (\hc, st2 => case hc of
  Pair ctxE head => parseInstanceTail ctxE head st blockCol kwPos st2
)
)

parseInstanceTail : List Expr -> Expr -> PState -> Int -> Pos -> PState -> Check (Pair Decl PState)
parseInstanceTail ctxE head st blockCol kwPos st2 =
  Vuna.Compiler.Base.Common.bind (expectKw st2 "where")
    (\st3 => Vuna.Compiler.Base.Common.step (parseInstanceBody st3 blockCol) (\methods, st4 => OkC (Pair (DInstance ctxE head methods (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st4)) (posCol (lastPos st4)) (posOffset kwPos) (posOffset (lastPos st4)))) st4)))

parseCtxThenExpr : Int -> PState -> Int -> Check (Pair (Pair (List Expr) Expr) PState)
parseCtxThenExpr fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parseExpr fuel st blockCol)
    (\e1, st1 => if atSym st1 "=>" then Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (advance st1) blockCol) (\hd, st2 => OkC (Pair (ctxThenSplit e1 hd) st2)) else if atSym st1 "," then parseCtxRest (fuel - 1) (advance st1) [e1] blockCol else OkC (Pair (Pair [] e1) st1))

-- `{a b : Type} -> Convert a b => ...`：显式 Pi 前缀写在约束之前时，把 Pi 链搬到
-- 返回类型上，约束本身作为 ctx（与 `Convert a b => ...` 自由名量化的结果同一形态）。
-- 只在 e1 是 Pi 表达式时触发；普通约束 `Eq a` 原样保留。
ctxThenSplit : Expr -> Expr -> Pair (List Expr) Expr
ctxThenSplit (EPi n i q d c sp) hd =
  Pair [innermostPiCod (EPi n i q d c sp)] (replacePiCod (EPi n i q d c sp) hd)
ctxThenSplit e1 hd = Pair [e1] hd

innermostPiCod : Expr -> Expr
innermostPiCod (EPi n i q d c sp) = innermostPiCod c
innermostPiCod e = e

replacePiCod : Expr -> Expr -> Expr
replacePiCod (EPi n i q d c sp) new = EPi n i q d (replacePiCod c new) sp
replacePiCod e new = new

-- ctx 列表的剩余部分：`e , e ... => head`。
parseCtxRest : Int -> PState -> List Expr -> Int -> Check (Pair (Pair (List Expr) Expr) PState)
parseCtxRest fuel st acc blockCol =
  if fuel <= 0 then icFuel "parser"
  else if atSym st "=>" then Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (advance st) blockCol)
    (\hd, st1 => OkC (Pair (Pair (reverse acc) hd) st1))
  else Vuna.Compiler.Base.Common.step (parseExpr fuel st blockCol)
    (\e, st1 => if atSym st1 "," then parseCtxRest (fuel - 1) (advance st1) (e :: acc) blockCol else Vuna.Compiler.Base.Common.bind (expectSym st1 "=>") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (\hd, st3 => OkC (Pair (Pair (reverse (e :: acc)) hd) st3))))

parseInstanceBody : PState -> Int -> Check (Pair (List Decl) PState)
parseInstanceBody st blockCol = if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col > blockCol then parseInstanceDeclList (stateFuel st) st col else OkC (Pair [] st)

parseInstanceDeclList : Int -> PState -> Int -> Check (Pair (List Decl) PState)
parseInstanceDeclList fuel st declCol = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col == declCol then Vuna.Compiler.Base.Common.step (parseInstanceDecl st declCol)
      (\decl, st1 => Vuna.Compiler.Base.Common.step (parseInstanceDeclList (fuel - 1) st1 declCol) (\rest, st2 => OkC (Pair ((::) decl rest) st2)))
    else if col > declCol then ps0 st UnexpectedIndentInInstance else OkC (Pair [] st)

parseInstanceDecl : PState -> Int -> Check (Pair Decl PState)
parseInstanceDecl st blockCol =
  if instanceMethodStart st then Vuna.Compiler.Base.Common.step (expectDeclName st)
    (\name, st1 => if atSym st1 ":" then parseSignature st1 blockCol False name (peekPos st) else parseClause st1 blockCol name (peekPos st))
  else ps0 st ExpectedInstanceMethod

-- instance 方法名：标识符、`(sym)`、裸符号；其它 token 仍走 `ExpectedInstanceMethod`。
instanceMethodStart : PState -> Bool
instanceMethodStart st = case peekTok st of
  PTok (TIdent _) _ => True
  PTok (TSym "(") _ => case peekTokAt st 1 of
    Just (PTok (TSym sym) _) => case peekTokAt st 2 of
      Just (PTok (TSym ")") _) => not (isReservedValueName sym)
      _ => False
    _ => False
  PTok (TSym sym) _ => not (isReservedValueName sym)
  _ => False

parseParams : Int -> PState -> Check (Pair (List String) PState)
parseParams fuel st = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent name) p =>
    Vuna.Compiler.Base.Common.step (parseParams (fuel - 1) (advance st))
      (\rest, st1 => OkC (Pair ((::) name rest) st1))
  _ => OkC (Pair [] st)

parseCtors : PState -> Int -> Check (Pair (List Ctor) PState)
parseCtors st blockCol = if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col > blockCol then parseCtorList (stateFuel st) st col else OkC (Pair [] st)

parseCtorList : Int -> PState -> Int -> Check (Pair (List Ctor) PState)
parseCtorList fuel st ctorCol = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col == ctorCol then Vuna.Compiler.Base.Common.step (expectDeclName st)
      (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ":") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 ctorCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st3) (\st3b => Vuna.Compiler.Base.Common.step (parseCtorList (fuel - 1) st3b ctorCol) (\rest, st4 => OkC (Pair ((::) (Ctor name ty (countArrows ty) (spanOf st st3)) rest) st4))))))
    else if col > ctorCol then ps0 st UnexpectedIndentInData else OkC (Pair [] st)

parseExpr : Int -> PState -> Int -> Check (Pair Expr PState)
parseExpr fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else if isEof st then ps0 st UnexpectedEndOfInput
  else if canContinue st blockCol then Vuna.Compiler.Base.Common.step (parseLhs (fuel - 1) st blockCol)
    (\lhs, st1 => parseInfix (fuel - 1) st1 blockCol lhs)
  else ps0 st ExprNotIndented

-- 优先级/结合性不在 parser 决定——中缀链原样收成 `EInfix`（右嵌套，保留
-- 括号边界用 `EParen`），Loader 按 `infix*` 声明重排。
parseInfix : Int -> PState -> Int -> Expr -> Check (Pair Expr PState)
parseInfix fuel st blockCol lhs = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  -- 反引号中缀 `` a `f` b ``。名字是普通值名或符号名（expectValueName）；
  -- rhs 用 parseExpr（与普通中缀一致，会继续吞后续中缀），形成右嵌套链交给 Loader 重排。
  PTok (TSym "`") p =>
    if canContinue st blockCol then Vuna.Compiler.Base.Common.step (expectValueName (advance st))
      (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 "`") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (\rhs, st3 => parseInfix (fuel - 1) st3 blockCol (EBacktick name lhs rhs (spanOf st st3)))))
    else OkC (Pair lhs st)
  PTok (TSym op) p =>
    if canContinue st blockCol && not (isSyntaxSym op) then if closeParenNext st then OkC (Pair (ESectR lhs op (spanOf st (advance st))) (advance st))
    else Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (advance st) blockCol)
      (\rhs, st2 => parseInfix (fuel - 1) st2 blockCol (EInfix op lhs rhs (spanOf st st2)))
    else OkC (Pair lhs st)
  -- 右 section `(e op)`。只消费 op；`)` 由外层 `(` 分支消费。
  _ => OkC (Pair lhs st)

parseLhs : Int -> PState -> Int -> Check (Pair Expr PState)
parseLhs fuel st blockCol = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TSym "\\") p => parseLambda (fuel - 1) st blockCol
  PTok (TKw "let") p => parseLet (fuel - 1) st blockCol
  PTok (TKw "case") p => parseCase (fuel - 1) st blockCol
  PTok (TKw "if") p => parseIf (fuel - 1) st blockCol
  PTok (TKw "do") p => parseDo (fuel - 1) st blockCol
  PTok (TKw "perform") p => parsePerform (fuel - 1) st blockCol
  PTok (TKw "handle") p => parseHandle (fuel - 1) st blockCol
  -- 一元负号：前缀位置才成立（表达式开头 / 运算符后 / `(` 等之后），所以 `f - 1`
  -- 仍是减法。字面量直接成为负字面量；其它表达式走 `negate`。
  PTok (TSym "-") p => parseNegation (fuel - 1) st blockCol
  _ => parseApplication (fuel - 1) st blockCol

parseNegation : Int -> PState -> Int -> Check (Pair Expr PState)
parseNegation fuel st blockCol = if fuel <= 0 then icFuel "parser"
else case peekTokAt st 1 of
  Just (PTok (TInt n) _) =>
    OkC (Pair (EInt (0 - n) (spanOf st (advance (advance st)))) (advance (advance st)))
  Just (PTok (TFloat raw) _) =>
    OkC (Pair (EFloat ("-" ++ raw) (spanOf st (advance (advance st)))) (advance (advance st)))
  _ =>
    Vuna.Compiler.Base.Common.step (parseApplication (fuel - 1) (advance st) blockCol)
      (\e, st1 => OkC (Pair (EApp (EVar "negate" (spanOf st (advance st))) [e] (spanOf st st1)) st1))

parseApplication : Int -> PState -> Int -> Check (Pair Expr PState)
parseApplication fuel st blockCol = if fuel <= 0 then icFuel "parser"
else Vuna.Compiler.Base.Common.step (parseAtom (fuel - 1) st blockCol) (\first, st1 => if atSym st1 "@" then Vuna.Compiler.Base.Common.step (parseAtPayload (fuel - 1) (advance st1) blockCol)
  (\payload, st2 => Vuna.Compiler.Base.Common.step (parseArgs (fuel - 1) st2 blockCol) (\args, st3 => OkC (Pair (EApp (EVar appAtSyntax (spanOf st st3)) (first :: payload :: args) (spanOf st st3)) st3)))
else Vuna.Compiler.Base.Common.step (parseArgs (fuel - 1) st1 blockCol) (\args, st2 => case args of
  [] => OkC (Pair first st2)
  _ =>
    let
      app = EApp first args (spanOf st st2)
    in if atSym st2 "@" then Vuna.Compiler.Base.Common.step (parseAtPayload (fuel - 1) (advance st2) blockCol)
      (\payload, st3 => OkC (Pair (EApp (EVar rowAtSyntax (spanOf st st3)) [app, payload] (spanOf st st3)) st3))
    else OkC (Pair app st2)
)
)

-- `@` 后面的 payload 与行 `@` 同一规则：裸标识符是名字字面量，字符串/数字/括号表达式原样。
parseAtPayload : Int -> PState -> Int -> Check (Pair Expr PState)
parseAtPayload fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parseAtom (fuel - 1) st blockCol)
    (\e, st1 => OkC (Pair (rowAtNameExpr e) st1))

spanFromExpr : Expr -> PState -> Span
spanFromExpr e st2 =
  let
    sp = exprSpan e
  in Span sp.spanFile (spanStartLine sp) (spanStartCol sp) (posLine (lastPos st2))
    (posCol (lastPos st2)) (spanStartOffset sp) (posOffset (lastPos st2))

parseArgs : Int -> PState -> Int -> Check (Pair (List Expr) PState)
parseArgs fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else if startsAtom st && canContinue st blockCol then Vuna.Compiler.Base.Common.step (parseAtom (fuel - 1) st blockCol)
    (\arg, st1 => Vuna.Compiler.Base.Common.step (parseArgs (fuel - 1) st1 blockCol) (\rest, st2 => OkC (Pair ((::) arg rest) st2)))
  else OkC (Pair [] st)

parseAtom : Int -> PState -> Int -> Check (Pair Expr PState)
parseAtom fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parseAtomBase (fuel - 1) st blockCol)
    (\base, st1 => parseFieldSuffix (stateFuel st1) st1 blockCol base)

-- 字段访问后缀：`e.f` / `(e).f`；`p.x` 因 lexer 合成单 token 由 loader 拆分。
parseFieldSuffix : Int -> PState -> Int -> Expr -> Check (Pair Expr PState)
parseFieldSuffix fuel st blockCol base =
  if fuel <= 0 then icFuel "parser"
  else if atSym st "." then Vuna.Compiler.Base.Common.bind (expectSym st ".")
    (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\fname, st2 => parseFieldSuffix (fuel - 1) st2 blockCol (EField base fname (spanFromExpr base st2))))
  else OkC (Pair base st)

-- 内置宏调用：`name!` 的 `!` 必须与标识符**紧邻**（同行且列号连续）。带空格的
-- `a ! b` 仍是普通中缀运算符，`!=` / `!!` 等更长的符号 token 也不触发。
-- | `name` 后是否紧跟同一行的 `!`（列号连续才算宏调用；空格分隔的 `!` 仍是中缀）。
macroBangAt : PState -> Pos -> String -> Bool
macroBangAt st start name = case peekTok st of
  PTok (TSym "!") p => posLine p == posLine start && posCol p == posCol start + strLength name
  _ => False

-- | 宏原子：无实参时是裸标记 `EVar`（交给展开期报 arity），有实参时是标记应用。
macroAtom : String -> List Expr -> Span -> Span -> Expr
macroAtom name [] appSp headSp = EVar (macroSyntaxName name) headSp
macroAtom name args appSp headSp = EApp (EVar (macroSyntaxName name) headSp) args appSp

parseAtomBase : Int -> PState -> Int -> Check (Pair Expr PState)
parseAtomBase fuel st blockCol = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 "{" then Vuna.Compiler.Base.Common.bind (expectSym st1 "{")
      (\st1b => Vuna.Compiler.Base.Common.step (parseRecordAssignments (fuel - 1) st1b blockCol) (\fields, st2 => OkC (Pair (ERecord name fields (spanOf st st2)) st2)))
    else if atSym st1 "." then case peekTokAt st1 1 of
      -- 限定符号引用 `A.+`：模块名 + `.` + 符号名，合成一个带点全名交给 Resolve。
      Just (PTok (TSym sym) _) =>
        if isReservedValueName sym then OkC (Pair (EVar name (spanOf st st1)) st1)
        else OkC
          (Pair (EVar (name ++ "." ++ sym) (spanOf st (advance (advance st1)))) (advance (advance st1)))
      _ => OkC (Pair (EVar name (spanOf st st1)) st1)
    else if macroBangAt st1 p name then Vuna.Compiler.Base.Common.bind (expectSym st1 "!")
      (\st1b => Vuna.Compiler.Base.Common.step (parseArgs (fuel - 1) st1b blockCol) (\args, st2 => OkC (Pair (macroAtom name args (spanOf st st2) (spanOf st st1b)) st2)))
    else OkC (Pair (EVar name (spanOf st st1)) st1)
  PTok (TInt n) p => OkC (Pair (EInt n (spanOf st (advance st))) (advance st))
  PTok (TFloat raw) p => OkC (Pair (EFloat raw (spanOf st (advance st))) (advance st))
  PTok (TStr s) p => OkC (Pair (EStr s (spanOf st (advance st))) (advance st))
  PTok (TTmpl multi parts endP) p => parseTemplateAtom (fuel - 1) st multi parts endP
  PTok (TKw "Type") p => OkC (Pair (EVar "Type" (spanOf st (advance st))) (advance st))
  PTok (TSym "(") p => case binderHead (advance st) of
    Just qn => parsePiBinder (fuel - 1) st blockCol (firstOf qn) (secondOf qn) False "(" ")"
    -- `(+)` / `(+ e)` section。`(e op)` 由 parseInfix 的右 section 分支处理。
    Nothing => case sectionOpAt st of
      Just op => parseSectionAtom (fuel - 1) st blockCol op
      Nothing =>
        Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (advance st) blockCol)
          (\inner, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (Pair (EParen inner (spanOf st st2)) st2)))
  PTok (TSym "[") p => parseListExpr (fuel - 1) st blockCol
  -- 命名洞 `?name`（`?` 与标识符紧邻）。编码成 `EVar "?name"`（不新增 AST 构造子），
  -- span 覆盖整个 `?name`；精化器据 `isHoleName` 把它当洞。
  PTok (TSym "?") p => case holeAtomAt st of
    Just h => OkC (Pair (EVar (firstOf h) (secondOf h)) (advance (advance st)))
    Nothing => ps0 st ExpectedExpression
  PTok (TSym "{") p => case binderHead (advance st) of
    Just qn => parsePiBinder (fuel - 1) st blockCol (firstOf qn) (secondOf qn) True "{" "}"
    Nothing =>
      Vuna.Compiler.Base.Common.bind (expectSym st "{")
        (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\base, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 "|") (\st3 => Vuna.Compiler.Base.Common.step (parseRecordAssignments (fuel - 1) st3 blockCol) (\fields, st4 => OkC (Pair (ERecUpdate base fields (spanOf st st4)) st4)))))
  _ => ps0 st ExpectedExpression

-- 模板字符串原子。文本块直接成为 `IPText`；插值洞用**洞内 token** 现场解析
-- （token 位置由 lexer 原位给出，仍是绝对源码位置），再组装成 `EInterp`。
-- 字面量结束位置写入 `lastPos`：多行字面量之后的布局判定与 decl span 都依赖它。
parseTemplateAtom : Int -> PState -> Bool -> List TmplPart -> Pos -> Check (Pair Expr PState)
parseTemplateAtom fuel st multi parts endP = if fuel <= 0 then icFuel "parser"
else Vuna.Compiler.Base.Common.bind (parseTemplateParts (fuel - 1) (fileOf st) (pmodeOf st) (tokSpan st) parts) (\ps => let
  advanced = advance st
  st2 = mkStateAt (fileOf st) advanced.toksOf endP advanced.toksLeft (pmodeOf st)
in OkC (Pair (EInterp multi ps (spanOf st st2)) st2)
)

parseTemplateParts : Int -> String -> ParseMode -> Span -> List TmplPart -> Check (List InterpPart)
parseTemplateParts fuel file mode fallback parts = if fuel <= 0 then icFuel "parser"
else case parts of
  [] => OkC []
  (TPText s) :: rest =>
    Vuna.Compiler.Base.Common.bind (parseTemplateParts (fuel - 1) file mode fallback rest)
      (\ps => OkC ((::) (IPText s) ps))
  (TPHole toks) :: rest =>
    Vuna.Compiler.Base.Common.bind (parseTemplateHole (toksFuel toks) file mode fallback toks)
      (\e => Vuna.Compiler.Base.Common.bind (parseTemplateParts (fuel - 1) file mode fallback rest) (\ps => OkC ((::) (IPHole e) ps)))

-- 一个插值洞：空 token → `TemplateHoleEmpty`（指向字面量起点的兜底 span）；否则必须
-- 恰好解析成一个表达式。洞内错误自带精确 span，兜底只为「无位置」的诊断补洞位置。
parseTemplateHole : Int -> String -> ParseMode -> Span -> List PTok -> Check Expr
parseTemplateHole fuel file mode fallback toks = if fuel <= 0 then icFuel "parser"
else case toks of
  [] => psErr0At fallback TemplateHoleEmpty
  first :: _ =>
    let
      pos = first.ptokPos
      subState = mkStateAt file toks pos (length toks) mode
    in case parseExpr (fuel - 1) subState 0 of
      ErrC e => ErrC (withFallbackSpan (holeSpan file pos) e)
      OkC (Pair e st2) =>
        if isEof st2 then OkC e
        else ErrC
          (withLabel (Label (Just (holeSpan file pos)) "" LabelPrimary Nothing) (psMsg ExpectedEndOfExpr []))

-- 插值洞的位置：洞内 token 的首位置（文件在 lexer 侧已知）。
holeSpan : String -> Pos -> Span
holeSpan file (Pos line col off _) = Span file line col line col off off

-- 洞内 token 的 parser fuel 种子（与 `stateFuel` 同形，按 token 数线性放大）。
toksFuel : List PTok -> Int
toksFuel toks = 128 * length toks + 1024

-- 洞内 token 全是文本块时拼成字符串（多行字面量在**模式**里只允许这种形态）。
textPartsOf : List TmplPart -> Maybe String
textPartsOf [] = Just ""
textPartsOf ((TPText s) :: rest) = case textPartsOf rest of
  Nothing => Nothing
  Just t => Just (s ++ t)
textPartsOf ((TPHole toks) :: rest) = Nothing

-- section 的 op 值 / 左 section 形态：`(op)` 与 `(op e)`。
-- 进入时已在 `(`，op 已由 sectionOpAt 确认（TSym 且非保留名）。
parseSectionAtom : Int -> PState -> Int -> String -> Check (Pair Expr PState)
parseSectionAtom fuel st blockCol op =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectSym st "(")
    (\st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 op) (\st2 => if atSym st2 ")" then OkC (Pair (ESectOp op (spanOf st (advance st2))) (advance st2)) else Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (\rhs, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 ")") (\st4 => OkC (Pair (ESectL op rhs (spanOf st st4)) st4)))))

-- Pi binder：`(x : A) -> B`、`{x : A} -> B`，以及带 quantity 的 `(0 x : A)` / `(1 x : A)`。
-- 多参数 trait 探针的 `{a b : Type} -> ...` 支持同一 binder 组写多个名字（展开成嵌套 EPi）。
-- 进入时已在开括号处；binder 头（可选 quantity + 名 + `:`）先由 lookahead 确认，再要求 `->`。
parsePiBinder : Int -> PState -> Int -> Maybe Qty -> List String -> Bool -> String -> String -> Check (Pair Expr PState)
parsePiBinder fuel st blockCol qty names implicit openSym closeSym =
  if fuel <= 0 then icFuel "parser"
  else if anyDottedName names then ps0 st PiBinderNameNotSimple
  else Vuna.Compiler.Base.Common.bind (expectSym st openSym)
    (\st1 => Vuna.Compiler.Base.Common.bind (consumeQty st1 qty) (\st2 => Vuna.Compiler.Base.Common.step (parsePiNames (fuel - 1) st2) (\names2, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 ":") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st4 blockCol) (\dom, st5 => Vuna.Compiler.Base.Common.bind (expectSym st5 closeSym) (\st6 => Vuna.Compiler.Base.Common.bind (expectSym st6 "->") (\st7 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st7 blockCol) (\cod, st8 => OkC (Pair (foldPiNames names2 implicit qty dom cod (spanOf st st8)) st8)))))))))

-- 连续的标识符（lookahead 已确认它们后面紧跟 `:`）。
parsePiNames : Int -> PState -> Check (Pair (List String) PState)
parsePiNames fuel st =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (expectIdent st)
    (\name, st1 => parsePiNamesRest (fuel - 1) st1 [name])

parsePiNamesRest : Int -> PState -> List String -> Check (Pair (List String) PState)
parsePiNamesRest fuel st acc = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent name) p => parsePiNamesRest (fuel - 1) (advance st) (name :: acc)
  _ => OkC (Pair (reverse acc) st)

-- 同名 binder 组展开成嵌套 EPi（外到内 = 源码顺序）。
foldPiNames : List String -> Bool -> Maybe Qty -> Expr -> Expr -> Span -> Expr
foldPiNames [] implicit qty dom cod sp = cod
foldPiNames (n :: rest) implicit qty dom cod sp =
  EPi n implicit qty dom (foldPiNames rest implicit qty dom cod sp) sp

anyDottedName : List String -> Bool
anyDottedName [] = False
anyDottedName (n :: rest) = containsDot n || anyDottedName rest

-- 消费 binder 前缀里的 quantity token（lookahead 已确认；这里只做机械前进）。
consumeQty : PState -> Maybe Qty -> Check PState
consumeQty st Nothing = OkC st
consumeQty st (Just q) = case peekTok st of
  PTok (TInt 0) _ => OkC (advance st)
  PTok (TInt 1) _ => OkC (advance st)
  _ => ps0 st ExpectedIdentifier

-- `{ f = e, ... }`：构造与更新的公共字段列表（进入时已在 `{` 之后）。
parseRecordAssignments : Int -> PState -> Int -> Check (Pair (List (Pair String Expr)) PState)
parseRecordAssignments fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else if atSym st "}" then OkC (Pair [] (advance st))
  else Vuna.Compiler.Base.Common.step (parseRecordAssignList (fuel - 1) st blockCol)
    (\fs, st1 => OkC (Pair fs st1))

parseRecordAssignList : Int -> PState -> Int -> Check (Pair (List (Pair String Expr)) PState)
parseRecordAssignList fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (expectIdent st)
    (\fname, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 "=") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (\value, st3 => if atSym st3 "," then Vuna.Compiler.Base.Common.step (parseRecordAssignList (fuel - 1) (advance st3) blockCol) (\rest, st4 => OkC (Pair ((::) (Pair fname value) rest) st4)) else Vuna.Compiler.Base.Common.bind (expectSym st3 "}") (\st4 => OkC (Pair [Pair fname value] st4)))))

parseListExpr : Int -> PState -> Int -> Check (Pair Expr PState)
parseListExpr fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectSym st "[")
    (\st1 => if atSym st1 "]" then OkC (Pair (EVar listNilSyntax (spanOf st (advance st1))) (advance st1)) else Vuna.Compiler.Base.Common.step (parseListExprElems (fuel - 1) st1 blockCol) (\elems, st2 => OkC (Pair (foldCons (spanOf st st2) elems) st2)))

parseListExprElems : Int -> PState -> Int -> Check (Pair (List Expr) PState)
parseListExprElems fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st blockCol)
    (\e0, st0 => Vuna.Compiler.Base.Common.step (parseListElemAt (fuel - 1) e0 st0) (\e, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseListExprElems (fuel - 1) (advance st1) blockCol) (\rest, st2 => OkC (Pair ((::) e rest) st2)) else if atSym st1 "]" then OkC (Pair [e] (advance st1)) else ps0 st1 ExpectedCommaOrBracket))

-- 列表字面量元素里的 `X@name`：`@` 在 vuna 里也是模式的
-- as-pattern，所以只在列表元素位置接受它，不做全局后缀。
parseListElemAt : Int -> Expr -> PState -> Check (Pair Expr PState)
parseListElemAt fuel e st =
  if fuel <= 0 then icFuel "parser"
  else if atSym st "@" then Vuna.Compiler.Base.Common.bind (expectSym st "@")
    (\st1 => Vuna.Compiler.Base.Common.step (parseAtom (fuel - 1) st1 0) (\nm, st2 => OkC (Pair (EApp (EVar rowAtSyntax (spanFromExpr e st2)) [e, rowAtNameExpr nm] (spanFromExpr e st2)) st2)))
  else OkC (Pair e st)

-- | 把元素列表折叠成 `cons` 保留名的右嵌套链（空表是 `nil` 保留名）。
foldCons : Span -> List Expr -> Expr
foldCons sp [] = EVar listNilSyntax sp
foldCons sp (e :: rest) = EApp (EVar listConsSyntax sp) [e, foldCons sp rest] sp

parseLambda : Int -> PState -> Int -> Check (Pair Expr PState)
parseLambda fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectSym st "\\")
    (\st1 => Vuna.Compiler.Base.Common.step (parseLambdaParam st1) (\first, st2 => Vuna.Compiler.Base.Common.step (parseLambdaParams (stateFuel st2) st2 [first]) (\params, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 "=>") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st4 blockCol) (\body, st5 => OkC (Pair (ELam params body (spanOf st st5)) st5))))))

-- | 一个 λ 参数：名字 + 名字自身的 span（单 token）。
parseLambdaParam : PState -> Check (Pair (Pair String Span) PState)
parseLambdaParam st =
  Vuna.Compiler.Base.Common.step (expectIdent st)
    (\name, st1 => OkC (Pair (Pair name (tokenSpan st)) st1))

parseLambdaParams : Int -> PState -> List (Pair String Span) -> Check (Pair (List (Pair String Span)) PState)
parseLambdaParams fuel st acc =
  if fuel <= 0 then icFuel "parser"
  else if atSym st "," then Vuna.Compiler.Base.Common.step (parseLambdaParam (advance st))
    (\p, st1 => parseLambdaParams (fuel - 1) st1 (append acc [p]))
  else OkC (Pair acc st)

parseLet : Int -> PState -> Int -> Check (Pair Expr PState)
parseLet fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectKw st "let")
    (\st1 => Vuna.Compiler.Base.Common.step (parseLetBindings (fuel - 1) st1 blockCol) (\binds, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "in") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st3 blockCol) (\body, st4 => OkC (Pair (ELet binds body False (spanOf st st4)) st4)))))

-- `let` 绑定块：与 `where` 共用 `parseBindingItemsAt` / `bindingItemsToBinds`
-- （签名行可选；函数子句降级成 λ）。块结束于缩进回退或 `in`。
parseLetBindings : Int -> PState -> Int -> Check (Pair (List (Pair Pat Expr)) PState)
parseLetBindings fuel st blockCol = if fuel <= 0 then icFuel "parser"
else if isEof st then ps0 st ExpectedLetBinding
else if atKw st "in" then ps0 st ExpectedLetBinding
else case peekPos st of
  Pos line col _ _ =>
    if col <= blockCol then ps0 st LetBindingNotIndented
    else Vuna.Compiler.Base.Common.step (parseBindingItemsAt (fuel - 1) st col)
      (\items, st1 => Vuna.Compiler.Base.Common.bind (bindingItemsToBinds items) (\binds => OkC (Pair binds st1)))

parseCase : Int -> PState -> Int -> Check (Pair Expr PState)
parseCase fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectKw st "case")
    (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\scrut, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "of") (\st3 => Vuna.Compiler.Base.Common.step (parseCaseAlts (fuel - 1) st3 blockCol) (\alts, st4 => OkC (Pair (ECase scrut alts (spanOf st st4)) st4)))))

parseCaseAlts : Int -> PState -> Int -> Check (Pair (List (Pair Pat Expr)) PState)
parseCaseAlts fuel st blockCol = if fuel <= 0 then icFuel "parser"
else if isEof st then ps0 st CaseNeedsAlternative
else case peekPos st of
  Pos line col _ _ => if col <= blockCol then ps0 st CaseAltNotIndented
  else Vuna.Compiler.Base.Common.step (parseAltList (fuel - 1) st col) (\alts, st2 => if badCaseIndent st2 col then ps0 st2 UnexpectedIndentAfterCaseAlt
  else case alts of
    [] => ps0 st2 CaseNeedsAlternative
    _ => OkC (Pair alts st2)
  )

parseAltList : Int -> PState -> Int -> Check (Pair (List (Pair Pat Expr)) PState)
parseAltList fuel st altCol = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair [] st)
else case peekPos st of
  Pos line col _ _ =>
    if col == altCol then Vuna.Compiler.Base.Common.step (parsePatternSingle (stateFuel st) st altCol)
      (\pat, st1 => Vuna.Compiler.Base.Common.bind (checkBindersAt st [pat]) (\_ => Vuna.Compiler.Base.Common.bind (expectSym st1 "=>") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 altCol) (\body, st3 => Vuna.Compiler.Base.Common.step (parseAltList (fuel - 1) st3 altCol) (\rest, st4 => OkC (Pair ((::) (Pair pat body) rest) st4))))))
    else OkC (Pair [] st)

-- `@` 后面的裸标识符是实例名**字面量**（`[Console@audit]` → 名字 "audit"）；字符串原样。
rowAtNameExpr : Expr -> Expr
rowAtNameExpr (EVar nm sp) = EStr nm sp
rowAtNameExpr e = e

-- `perform <expr>`：保留名单实参应用；Elab 侧按 op 族
-- 推导 key / 实例名 / 效应签名后降级到 `Base.Eff.performCore`，不新增 AST 构造子。
parsePerform : Int -> PState -> Int -> Check (Pair Expr PState)
parsePerform fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectKw st "perform")
    (\st1 => Vuna.Compiler.Base.Common.step (parseApplication (fuel - 1) st1 blockCol) (\operand, st2 => OkC (Pair (EApp (EVar performSyntax (spanOf st st2)) [operand] (spanOf st st2)) st2)))

-- ---------------------------------------------------------------
-- `handle <comp> { ... }`
-- ---------------------------------------------------------------
-- 表面语法：
--   handle <comp> { return x -> <expr>
--                   C p1 .. pn k -> <expr>
--                   ... }
-- 编码（不新增 Expr 构造子）：`EApp (EVar "@vuna@handle") [comp, ret, opH]`
--   * ret = `ELam [x] body`；缺 return 子句时是哨兵 `EVar "@vuna@handle@noret"`；
--   * opH = `ELam [i, o, k] (ECase (EVar o) alts)`：alt pattern 只含构造子实参（续延 binder
--     是 λ 的第三个参数，第二个是结果索引 binder）；op 族、实例名、效应签名全部由 Elab 从 clause 构造子推导。
-- | 一个 `handle` op 子句：构造子名、实参模式、子句 span、续延 binder 名、子句体。
data HandleOp : Type where
  HandleOp : String -> List Pat -> Span -> String -> Expr -> HandleOp

-- | `handle` 块：可选 return 子句（binder 名 + 体 + span）与 op 子句列表。
data HandleBlock : Type where
  HandleBlock : Maybe (Pair String (Pair Expr Span)) -> List HandleOp -> HandleBlock

-- | `handle` 块合成的 op λ 的 scrutinee binder 名（保留名，用户写不出）。
handleOpBinder : String
handleOpBinder = "@vuna@handle@o"

-- | 合成 handler λ 的结果索引 binder 名（保留名，用户写不出）。
handleOpIndexBinder : String
handleOpIndexBinder = "@vuna@handle@ix"

-- | `handle comp { return? op-clause+ }`：解析并降到保留名标记。
parseHandle : Int -> PState -> Int -> Check (Pair Expr PState)
parseHandle fuel st blockCol = if fuel <= 0 then icFuel "parser"
else Vuna.Compiler.Base.Common.bind (expectKw st "handle") (\st1 => Vuna.Compiler.Base.Common.step (parseHandleComp (fuel - 1) st1 blockCol) (\comp, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 "{") (\st3 => Vuna.Compiler.Base.Common.step (parseHandleBody (fuel - 1) st3 blockCol) (\blk, st4 => case handleExpr comp blk (spanOf st st4) of
  ErrC e => ErrC e
  OkC expr => OkC (Pair expr st4)
)
)
)
)

-- | 解析被 handle 包裹的 comp：裸标识符紧跟 `{` 时直接收成 `EVar`（避免记录字面量歧义）。
parseHandleComp : Int -> PState -> Int -> Check (Pair Expr PState)
parseHandleComp fuel st blockCol = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent name) p => case peekTokAt st 1 of
    Just (PTok (TSym "{") _) => OkC (Pair (EVar name (spanOf st (advance st))) (advance st))
    _ => parseExpr (fuel - 1) st blockCol
  _ => parseExpr (fuel - 1) st blockCol

-- | 解析 handle 块体：可选的 return 子句 + op 子句列表，随后消费 `}`。
parseHandleBody : Int -> PState -> Int -> Check (Pair HandleBlock PState)
parseHandleBody fuel st handleCol = if fuel <= 0 then icFuel "parser"
else if atSym st "}" then ps0 st HandleNeedsOpClause
else case peekPos st of
  Pos line col _ _ => if col <= handleCol then ps0 st HandleClauseNotIndented
  else Vuna.Compiler.Base.Common.step (parseHandleClauses (fuel - 1) st col Nothing []) (\p, st2 => case p of
    Pair retOpt ops =>
      Vuna.Compiler.Base.Common.bind (expectSym st2 "}")
        (\st3 => OkC (Pair (HandleBlock retOpt ops) st3))
  )

-- | 子句头是否是 return 子句（`return` 不是全局关键字，只在子句头按标识符识别）。
isReturnClauseHead : PState -> Bool
isReturnClauseHead stat = case peekTok stat of
  PTok (TIdent nm) _ => nm == "return"
  _ => False

-- | handle 子句循环：同列续行；遇 `}` 或缩进回退结束。
parseHandleClauses : Int -> PState -> Int -> Maybe (Pair String (Pair Expr Span)) -> List HandleOp -> Check (Pair (Pair (Maybe (Pair String (Pair Expr Span))) (List HandleOp)) PState)
parseHandleClauses fuel st clauseCol retOpt acc = if fuel <= 0 then icFuel "parser"
else if isEof st then ps0 st UnexpectedEndOfInput
else if atSym st "}" then OkC (Pair (Pair retOpt (reverse acc)) st)
else case peekPos st of
  Pos line col _ _ => if col == clauseCol then if isReturnClauseHead st then case retOpt of
    Just _ => ps0 st HandleReturnMisplaced
    Nothing => case acc of
      _ :: _ => ps0 st HandleReturnMisplaced
      [] => Vuna.Compiler.Base.Common.step (parseHandleRetClause (fuel - 1) st clauseCol) (\p, st2 => case p of
        Pair x (Pair body rsp) =>
          parseHandleClauses (fuel - 1) st2 clauseCol (Just (Pair x (Pair body rsp))) acc
      )
  else Vuna.Compiler.Base.Common.step (parseHandleOpClause (fuel - 1) st clauseCol)
    (\op, st2 => parseHandleClauses (fuel - 1) st2 clauseCol retOpt (op :: acc))
  else OkC (Pair (Pair retOpt (reverse acc)) st)

-- | 解析 `return x -> body` 子句。
parseHandleRetClause : Int -> PState -> Int -> Check (Pair (Pair String (Pair Expr Span)) PState)
parseHandleRetClause fuel st clauseCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (expectIdent st)
    (\_kw, st0 => Vuna.Compiler.Base.Common.step (expectIdent st0) (\x, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 "->") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 clauseCol) (\body, st3 => OkC (Pair (Pair x (Pair body (spanOf st st3))) st3)))))

-- | 解析一个 op 子句头：构造子模式 + 尾部续延 binder（`_` 允许，统一成 `_`）。
parseHandleOpClause : Int -> PState -> Int -> Check (Pair HandleOp PState)
parseHandleOpClause fuel st clauseCol = if fuel <= 0 then icFuel "parser"
else Vuna.Compiler.Base.Common.step (parsePatternSingle (stateFuel st) st clauseCol) (\pat, st1 => Vuna.Compiler.Base.Common.bind (checkBindersAt st [pat]) (\_ => case pat of
  PCon cname args psp => case reverse args of
    [] => psErr0At psp HandleClauseNeedsCtor
    last :: revRest => case last of
      PVar kname _ => handleOpTail (fuel - 1) st1 clauseCol cname (reverse revRest) psp kname
      PWild _ => handleOpTail (fuel - 1) st1 clauseCol cname (reverse revRest) psp "_"
      _ => psErr0At psp HandleClauseNeedsCtor
  _ => ps0 st HandleClauseNeedsCtor
)
)

-- | op 子句的 `-> body` 尾段。
handleOpTail : Int -> PState -> Int -> String -> List Pat -> Span -> String -> Check (Pair HandleOp PState)
handleOpTail fuel st clauseCol cname pats psp kname =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectSym st "->")
    (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 clauseCol) (\body, st2 => OkC (Pair (HandleOp cname pats psp kname body) st2)))

-- | op 子句的续延 binder 名。
handleOpKName : HandleOp -> String
handleOpKName (HandleOp _ _ _ k _) = k

-- | 找出与基准不同的续延 binder 名（都一致则 Nothing）。
firstOtherKName : List HandleOp -> String -> Maybe String
firstOtherKName [] k = Nothing
firstOtherKName (op :: rest) k =
  let
    k2 = handleOpKName op
  in if k2 == k then firstOtherKName rest k else Just k2

-- | HandleOp → 合成 case 的 alt（pattern 只含构造子实参）。
handleAlt : HandleOp -> Pair Pat Expr
handleAlt (HandleOp cname pats psp _ body) = Pair (PCon cname pats psp) body

-- | ret 实参表达式（缺 return 子句时用哨兵）。
handleRetExpr : Maybe (Pair String (Pair Expr Span)) -> Span -> Expr
handleRetExpr Nothing sp = EVar handleNoRetSyntax sp
handleRetExpr (Just (Pair x (Pair body rsp))) sp = ELam [Pair x rsp] body rsp

-- | 合成 op λ：`\o, k => case o of alts`。
handleOpLam : List HandleOp -> String -> Span -> Expr
handleOpLam ops kname sp =
  ELam [Pair handleOpIndexBinder spanEmpty, Pair handleOpBinder spanEmpty, Pair kname spanEmpty]
    (ECase (EVar handleOpBinder sp) (map handleAlt ops) sp) sp

-- | 校验子句并合成 `EApp (EVar "@vuna@handle") [comp, ret, opH]`。
handleExpr : Expr -> HandleBlock -> Span -> Check Expr
handleExpr comp (HandleBlock retOpt []) sp = psErr0At sp HandleNeedsOpClause
handleExpr comp (HandleBlock retOpt (first :: rest)) sp = case firstOtherKName rest (handleOpKName first) of
  Nothing =>
    OkC
      (EApp (EVar handleSyntax sp) [comp, handleRetExpr retOpt sp, handleOpLam (first :: rest) (handleOpKName first) sp] sp)
  Just k1 =>
    psErrAt sp (HandleContinuationNameMismatch (handleOpKName first) k1) [handleOpKName first, k1]

parseIf : Int -> PState -> Int -> Check (Pair Expr PState)
parseIf fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectKw st "if")
    (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\cond, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "then") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st3 blockCol) (\yes, st4 => Vuna.Compiler.Base.Common.bind (expectKw st4 "else") (\st5 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st5 blockCol) (\no, st6 => OkC (Pair (EIf cond yes no (spanOf st st6)) st6)))))))

-- do 块：`do` + 缩进对齐的语句，语句是 `pat <- expr` 或裸表达式；
-- 最后一条必须是裸表达式（do 本身不引入 pure，最后表达式即块结果）。
parseDo : Int -> PState -> Int -> Check (Pair Expr PState)
parseDo fuel st blockCol = if fuel <= 0 then icFuel "parser"
else Vuna.Compiler.Base.Common.bind (expectKw st "do") (\st1 => if isEof st1 then ps0 st1 DoBlockNeedsStatement
else case peekPos st1 of
  Pos line col _ _ => if col <= blockCol then ps0 st1 DoStatementNotIndented
  else Vuna.Compiler.Base.Common.step (parseDoStmts (fuel - 1) st1 col []) (\stmts, st2 => case reverse stmts of
    (DExpr lastExpr lastSp) :: rest => OkC (Pair (EDo stmts (spanOf st st2)) st2)
    _ => ps0 st2 DoBlockMustEndWithExpr
  )
)

parseDoStmts : Int -> PState -> Int -> List DoStmt -> Check (Pair (List DoStmt) PState)
parseDoStmts fuel st stmtCol acc = if fuel <= 0 then icFuel "parser"
else if isEof st then OkC (Pair (reverse acc) st)
else case peekPos st of
  Pos line col _ _ => if col < stmtCol then OkC (Pair (reverse acc) st)
  else if col > stmtCol then ps0 st UnexpectedIndentInDo
  else Vuna.Compiler.Base.Common.step (parseDoStmt (fuel - 1) st stmtCol) (\stmt, st1 => case peekPos st1 of
    Pos line2 col2 _ _ =>
      if isEof st1 then OkC (Pair (reverse (stmt :: acc)) st1)
      else if col2 < stmtCol then OkC (Pair (reverse (stmt :: acc)) st1)
      else if col2 > stmtCol then ps0 st1 UnexpectedIndentInDo
      else parseDoStmts (fuel - 1) st1 stmtCol (stmt :: acc)
  )

parseDoStmt : Int -> PState -> Int -> Check (Pair DoStmt PState)
parseDoStmt fuel st stmtCol = if fuel <= 0 then icFuel "parser"
else case parsePatternSingle (stateFuel st) st stmtCol of
  OkC (Pair pat st1) =>
    if atSym st1 "<-" then Vuna.Compiler.Base.Common.bind (checkBindersAt st [pat])
      (\_ => Vuna.Compiler.Base.Common.bind (expectSym st1 "<-") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 stmtCol) (\e, st3 => OkC (Pair (DBind pat e (spanOf st st3)) st3))))
    else parseDoExprStmt (fuel - 1) st stmtCol
  ErrC _ => parseDoExprStmt (fuel - 1) st stmtCol

parseDoExprStmt : Int -> PState -> Int -> Check (Pair DoStmt PState)
parseDoExprStmt fuel st stmtCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (sameLineState st) stmtCol)
    (\e, st1 => OkC (Pair (DExpr e (spanOf st st1)) st1))

-- ---------------------------------------------------------------
-- 非线性格检查（模式绑定名唯一性）
-- ---------------------------------------------------------------
-- 同一个绑定作用域（一条函数子句的**全部**参数模式 / 一个 case 分支 / 一条 let(where)
-- 绑定 / 一条 do-bind）里，一个名字只能绑定一次。当前不实现相等约束：重复绑定名在
-- 解析后直接拒绝，而不是被 `Elab.Match` 当作新 binder 静默重命名。
-- case 分支的 as-pattern、let 的嵌套模式等都在模式解析完成后走同一检查；不同子句 /
-- 分支 / 绑定是不同作用域，复用同名 binder 合法。
-- | 模式里按从左到右出现顺序的 (绑定名, span)：PVar 与 as 名算绑定，构造子 / 记录
-- 模式递归，通配与字面量不绑定。
patBinderBindings : Pat -> List (Pair String Span)
patBinderBindings (PVar name sp) = [Pair name sp]
patBinderBindings (PAs name inner sp) = (::) (Pair name sp) (patBinderBindings inner)
patBinderBindings (PCon cname pats sp) = concatMap patBinderBindings pats
patBinderBindings (PRecord rname fields sp) =
  concatMap (\f => patBinderBindings (secondOf f)) fields
patBinderBindings (PWild sp) = []
patBinderBindings (PInt n sp) = []
patBinderBindings (PStr s sp) = []

-- | 从左到右第一个重复绑定：返回第二次出现的 (名字, span)；没有重复返回 Nothing。
firstRepeatedBinding : List (Pair String Span) -> Maybe (Pair String Span)
firstRepeatedBinding binds = firstRepeatedBindingGo binds []

-- | `firstRepeatedBinding` 的累加器版本（seen = 已出现的名字）。
firstRepeatedBindingGo : List (Pair String Span) -> List String -> Maybe (Pair String Span)
firstRepeatedBindingGo [] seen = Nothing
firstRepeatedBindingGo ((Pair name sp) :: rest) seen =
  if memName name seen then Just (Pair name sp) else firstRepeatedBindingGo rest ((::) name seen)

-- | 非线性格检查：一个绑定作用域的模式列表里出现重复绑定名 → 在第二次出现处报
-- 语法错误（带位置与名字）；合法时原样返回模式列表（便于与后续解析组合）。
-- | 非线性格检查的入口：工具模式（fmt/lint/index/doc/LSP）跳过。
-- 编译器路径仍然拒绝——精化器没有相等约束，放过去会静默改名。
checkBindersAt : PState -> List Pat -> Check (List Pat)
checkBindersAt st pats = case pmodeOf st of
  PmTool => OkC pats
  PmStrict => checkNoRepeatedBinders pats

checkNoRepeatedBinders : List Pat -> Check (List Pat)
checkNoRepeatedBinders pats = case firstRepeatedBinding (concatMap patBinderBindings pats) of
  Nothing => OkC pats
  Just (Pair name sp) =>
    ErrC
      (withLabel (Label (Just sp) "" LabelPrimary Nothing) (appendMessage " (repeated name: `${name}`)" (psMsg RepeatedPatternBinder [])))

parsePatternSingle : Int -> PState -> Int -> Check (Pair Pat PState)
parsePatternSingle fuel st blockCol =
  if fuel <= 0 then icFuel "parser" else parsePatternCons (fuel - 1) st blockCol

parsePatternCons : Int -> PState -> Int -> Check (Pair Pat PState)
-- pattern 里的 `::` 保留符号原形，由 Loader 按 fixity/别名声明换成
-- canonical `Cons`（base 声明 `infixr 5 :: = Cons`）。
parsePatternCons fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parsePatternHead (fuel - 1) st blockCol)
    (\lhs, st1 => if atSym st1 "::" && canContinue st1 blockCol then Vuna.Compiler.Base.Common.step (parsePatternCons (fuel - 1) (advance st1) blockCol) (\rhs, st2 => OkC (Pair (PCon "::" [lhs, rhs] (spanOf st st2)) st2)) else OkC (Pair lhs st1))

parsePatternHead : Int -> PState -> Int -> Check (Pair Pat PState)
parsePatternHead fuel st blockCol = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if ctorPatternStart name && atSym st1 "{" then Vuna.Compiler.Base.Common.step (parseRecordPatternFields (fuel - 1) st1 blockCol)
      (\fields, st2 => OkC (Pair (PRecord name fields (spanOf st st2)) st2))
    else if ctorPatternStart name then Vuna.Compiler.Base.Common.step (parsePatternAtoms (fuel - 1) st1 blockCol)
      (\args, st2 => OkC (Pair (PCon name args (spanOf st st2)) st2))
    else parsePatternAtom (fuel - 1) st blockCol
  -- 符号构造子：`(sym) p1 p2`（无参时 `(sym)` 本身是空构造子模式）。
  PTok (TSym "(") _ => case peekTokAt st 1 of
    Just (PTok (TSym sym) _) => if isReservedValueName sym then parsePatternAtom (fuel - 1) st blockCol
    else case peekTokAt st 2 of
      Just (PTok (TSym ")") _) =>
        Vuna.Compiler.Base.Common.step
          (parsePatternAtoms (fuel - 1) (advance (advance (advance st))) blockCol)
          (\args, st2 => OkC (Pair (PCon sym args (spanOf st st2)) st2))
      _ => parsePatternAtom (fuel - 1) st blockCol
    _ => parsePatternAtom (fuel - 1) st blockCol
  _ => parsePatternAtom (fuel - 1) st blockCol

parseRecordPatternFields : Int -> PState -> Int -> Check (Pair (List (Pair String Pat)) PState)
parseRecordPatternFields fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectSym st "{")
    (\st1 => parseRecordPatternList (fuel - 1) st1 blockCol)

parseRecordPatternList : Int -> PState -> Int -> Check (Pair (List (Pair String Pat)) PState)
parseRecordPatternList fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else if atSym st "}" then OkC (Pair [] (advance st))
  else Vuna.Compiler.Base.Common.step (parseRecordPatternField (fuel - 1) st blockCol)
    (\f, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseRecordPatternList (fuel - 1) (advance st1) blockCol) (\rest, st2 => OkC (Pair ((::) f rest) st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 "}") (\st2 => OkC (Pair [f] st2)))

parseRecordPatternField : Int -> PState -> Int -> Check (Pair (Pair String Pat) PState)
parseRecordPatternField fuel st blockCol = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent fname) p =>
    let
      st1 = advance st
    in if atSym st1 "=" then Vuna.Compiler.Base.Common.bind (expectSym st1 "=")
      (\st2 => Vuna.Compiler.Base.Common.step (parsePatternSingle (fuel - 1) st2 blockCol) (\pat, st3 => OkC (Pair (Pair fname pat) st3)))
    else OkC
      (Pair (Pair fname (PVar fname (Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p) (posOffset p) (posOffset p)))) st1)
  _ => ps0 st ExpectedRecordFieldPattern

parsePatternAtoms : Int -> PState -> Int -> Check (Pair (List Pat) PState)
parsePatternAtoms fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else if startsPatternAtom st && canContinue st blockCol then Vuna.Compiler.Base.Common.step (parsePatternAtom (fuel - 1) st blockCol)
    (\pat, st1 => Vuna.Compiler.Base.Common.step (parsePatternAtoms (fuel - 1) st1 blockCol) (\rest, st2 => OkC (Pair ((::) pat rest) st2)))
  else OkC (Pair [] st)

parsePatternAtom : Int -> PState -> Int -> Check (Pair Pat PState)
parsePatternAtom fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parsePatternAtomBase (fuel - 1) st blockCol)
    (\base, st1 => finishAsPattern (fuel - 1) st base st1 blockCol)

-- as-pattern：`x@pat`（前缀）与 `(pat)@x`（后缀）；`_@x` 等价于 `x@_`。
finishAsPattern : Int -> PState -> Pat -> PState -> Int -> Check (Pair Pat PState)
finishAsPattern fuel st base st1 blockCol = if fuel <= 0 then icFuel "parser"
else if atSym st1 "@" && canContinue st1 blockCol then case base of
  PVar "_" psp =>
    Vuna.Compiler.Base.Common.step (parseAsName (fuel - 1) (advance st1))
      (\name, st2 => OkC (Pair (PAs name (PWild psp) (spanOf st st2)) st2))
  PVar name psp =>
    Vuna.Compiler.Base.Common.step (parsePatternAtom (fuel - 1) (advance st1) blockCol)
      (\rhs, st2 => OkC (Pair (PAs name rhs (spanOf st st2)) st2))
  _ =>
    Vuna.Compiler.Base.Common.step (parseAsName (fuel - 1) (advance st1))
      (\name, st2 => OkC (Pair (PAs name base (spanOf st st2)) st2))
else OkC (Pair base st1)

parseAsName : Int -> PState -> Check (Pair String PState)
parseAsName fuel st = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent name) p =>
    if name == "_" then ps0 st ExpectedPattern else OkC (Pair name (advance st))
  _ => ps0 st ExpectedPattern

parsePatternAtomBase : Int -> PState -> Int -> Check (Pair Pat PState)
parsePatternAtomBase fuel st blockCol = if fuel <= 0 then icFuel "parser"
else case peekTok st of
  PTok (TIdent "_") p => OkC (Pair (PWild (spanOf st (advance st))) (advance st))
  PTok (TIdent name) p =>
    if ctorPatternStart name then OkC (Pair (PCon name [] (spanOf st (advance st))) (advance st))
    else OkC (Pair (PVar name (spanOf st (advance st))) (advance st))
  PTok (TInt n) p => OkC (Pair (PInt n (spanOf st (advance st))) (advance st))
  PTok (TStr s) p => OkC (Pair (PStr s (spanOf st (advance st))) (advance st))
  -- 多行字面量模式只允许**无洞**（等价于普通字符串字面量模式）；带洞不支持。
  PTok (TTmpl multi parts endP) p => case textPartsOf parts of
    Just s =>
      let
        advanced = advance st
        st2 = mkStateAt (fileOf st) advanced.toksOf endP advanced.toksLeft (pmodeOf st)
      in OkC (Pair (PStr s (spanOf st st2)) st2)
    Nothing => ps0 st TemplateInPattern
  PTok (TSym "(") p =>
    Vuna.Compiler.Base.Common.step (parsePatternSingle (fuel - 1) (advance st) blockCol)
      (\inner, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (Pair inner st2)))
  PTok (TSym "[") p => parseListPattern (fuel - 1) st blockCol
  _ => ps0 st ExpectedPattern

parseListPattern : Int -> PState -> Int -> Check (Pair Pat PState)
parseListPattern fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.bind (expectSym st "[")
    (\st1 => if atSym st1 "]" then OkC (Pair (PCon listNilSyntax [] (spanOf st (advance st1))) (advance st1)) else Vuna.Compiler.Base.Common.step (parseListPatternElems (fuel - 1) st1 blockCol) (\pats, st2 => OkC (Pair (foldPCon (spanOf st st2) pats) st2)))

parseListPatternElems : Int -> PState -> Int -> Check (Pair (List Pat) PState)
parseListPatternElems fuel st blockCol =
  if fuel <= 0 then icFuel "parser"
  else Vuna.Compiler.Base.Common.step (parsePatternSingle (fuel - 1) st blockCol)
    (\pat, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseListPatternElems (fuel - 1) (advance st1) blockCol) (\rest, st2 => OkC (Pair ((::) pat rest) st2)) else if atSym st1 "]" then OkC (Pair [pat] (advance st1)) else ps0 st1 ExpectedCommaOrBracket)

-- | 把模式列表折叠成 `cons` 保留名的右嵌套链（空表是 `nil` 保留名）。
foldPCon : Span -> List Pat -> Pat
foldPCon sp [] = PCon listNilSyntax [] sp
foldPCon sp (p :: rest) = PCon listConsSyntax [p, foldPCon sp rest] sp

-- 文件加载专用：开启解析恢复（收集多个语法错误），调用范围外恢复短路。
-- 返回「解析结果 + 恢复期收集到的非致命诊断」（诊断按出现顺序；空 = 没有语法错误）。
-- | 文件加载专用：开启解析恢复并显式返回多条语法错误。
export parseSourceRecovering : String -> String -> Check (Pair SourceFile (List Diagnostic))
parseSourceRecovering file source =
  Vuna.Compiler.Base.Common.bind (lexSource source)
    (\toks => parseSourceRecoveringTokens file PmStrict toks)

-- 从**已有 token 流**解析（AST 缓存命中路径）：与 `parseSourceRecovering` 逐字节等价，
-- 只是跳过 lex。位置全部来自 token 自身，因此诊断 span 与冷路径一致。
export parseSourceRecoveringTokens : String -> ParseMode -> List PTok -> Check (Pair SourceFile (List Diagnostic))
parseSourceRecoveringTokens file mode toks =
  Vuna.Compiler.Base.Common.bind (parseSourceFile True (mkState file toks mode))
    (\p => OkC (Pair (firstOf (firstOf p)) (secondOf p)))
