module Vuna.Compiler.Frontend.Parser where

-- vuna 源码 parser：offside layout，返回 AST 与 imports；表示层产物是无损树 + AST 载荷。
import Base.Data.List as List
import Base.Data.Nat as Nat
import qualified Base.Data.Vec as Vec
import Base.Container.HashMap as HashMap
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.AstView
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Base.Diagnostics.Frontend
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser.Support

-- ---------------------------------------------------------------
-- 诊断位置：parser 的每条诊断都带当前 token 的 span（EOF 退到最后消费位置）。
-- 位置必须在**产生点**给出：此处集中两个 helper，避免 `psErrAt (tokSpan st)` 铺满全文。
-- ---------------------------------------------------------------
ps0 : PState -> PsDiag 0 -> Check a
ps0 st e = psErr0At (tokSpan st) e

ps1 : PState -> PsDiag 1 -> String -> Check a
ps1 st e a0 = psErr1At (tokSpan st) e a0

psAt : PState -> {n : Nat} -> PsDiag n -> Vec.Vec n String -> Check a
psAt st e args = psErrAt (tokSpan st) e args

-- 恢复期诊断的**值**出口：`ps0` / `ps1` 直接短路成 `ErrC`，恢复路径要把同一形状的
-- 诊断并进已收集的列表，所以单独构造（位置口径与 `ps0` 一致：当前 token 的 span）。
psDiagAt : PState -> {n : Nat} -> PsDiag n -> Vec.Vec n String -> Diagnostic
psDiagAt st e args = withLabel (Label (Just (tokSpan st)) "" LabelPrimary Nothing) (psMsg e args)

-- 解析收尾处仍有剩余 token 的诊断（与 `ps0 st ExpectedEndOfInput` 同一形状；恢复期
-- 需要它的值版本）。
endOfInputDiag : PState -> Diagnostic
endOfInputDiag st = psDiagAt st ExpectedEndOfInput []

-- | 一次词法的全部产物：AST + 注释表 + 词法 token 流。
--
-- trivia token 流（`CstToken`）不在这里组装：只有需要注释归属/原文的工具（fmt / LSP）
-- 才付那份成本，纯切片消费者（lint / index / doc）不该为它分配。fmt 用
-- `Cst.lexTokensOf` 从 `parsedRawToks` + `parsedComments` 组装。
export record ParsedSource(..) where
  -- | 语法树（从 `parsedCst` 投影：值在树节点的语义载荷里）。
  parsedFile : SourceFile
  -- | 注释表（源码顺序；抑制指令与 docstring 用）。
  parsedComments : List Comment
  -- | 词法 token 流（token 形态与字节偏移）；按 token 边界切原文的消费者用它。
  parsedRawToks : List PTok
  -- | parser 发射的无损节点树：kind / id / span / 表面形状 / 有序 children。
  --
  -- 表面形状（括号层数 / 反引号 / section / 模板 `"""`）就在分支节点上：
  -- `Cst.cstIndexOf` 建定位表后按节点 id / span 查；`Cst.fixityFactsOf` 派生出中缀重排
  -- 需要的那三条事实（树在加载器里随后就丢，事实按模块保留）。
  parsedCst : CstNode

-- | 内部：一次词法 + 语法分析的核心产物。建树还需要 parser 终态（事件流在那里），
-- 所以两者一起返回；`parseSourceDetailed` 与 `parseSourceWithComments` 共用这一条路径。
record ParsedCore where
  pcSource : SourceFile
  pcComments : List Comment
  pcToks : List PTok
  pcFin : PState

parseSourceCore : EventMode -> String -> String -> Check ParsedCore
parseSourceCore events file source =
  case lexSourceWithComments source of
    ErrC e => ErrC e
    OkC (toks, comments) =>
      let
        st0 = mkState file source toks PmTool events
      in case parseSourceFile False st0 of
        ErrC e => ErrC e
        OkC p => OkC (ParsedCore (firstOf (firstOf p)) comments toks (secondOf (firstOf p)))

-- | 工具路径的唯一入口：**一次**词法同时给出注释表与 token 流，再做语法分析。
-- 需要注释 / 原文切片 / 保留括号的工具（fmt / lint / index / doc / LSP）用它，
-- 不必为注释或原文切片再扫一遍源码。
--
-- `parsedFile` **从树投影**（`AstView.ofTree`）：tree 是 parser 的结构产物，AST 值在
-- 节点载荷里，这里不另取 parser 的直接 AST——两边的漂移由测试锁住。
export parseSourceDetailed : String -> String -> Check ParsedSource
parseSourceDetailed file source =
  case parseSourceCore EvFull file source of
    ErrC e => ErrC e
    OkC c =>
      let
        events = eventsOf c.pcFin
        cst =
          nestToTreeWithSurface
            (lexTokensOf source c.pcToks c.pcComments)
            events
            (parenEntriesOf c.pcToks events)
            c.pcFin.backtickShapes
            c.pcFin.sectionShapes
            c.pcFin.interpMultis
            c.pcFin.templateHoles
      in OkC (ParsedSource (AstView.ofTree cst) c.pcComments c.pcToks cst)

-- | 只要 AST 与注释表的入口。
--
-- 与 `parseSourceDetailed` 同一次词法、同一棵 AST，但不组装无损树：只要语法结构的消费者
-- （REPL / LSP / fixity 上下文）不该为 token + trivia + 建树付成本。需要表面事实的消费者
-- （fmt / lint / index / doc）走 `parseSourceDetailed`。
export parseSourceWithComments : String -> String -> Check (SourceFile, List Comment)
parseSourceWithComments file source =
  case parseSourceCore EvNone file source of
    ErrC e => ErrC e
    OkC c => OkC (c.pcSource, c.pcComments)

export parseSource : String -> String -> Check SourceFile
parseSource file source =
  case parseSourceWithComments file source of
    ErrC e => ErrC e
    OkC (sf, comments) => OkC sf

-- 单表达式解析（REPL / 工具用）：整段输入必须恰好是一个表达式。
export parseExpressionSource : String -> Check Expr
parseExpressionSource source =
  Vuna.Compiler.Base.Common.bind
    (lexSource source)
    (\toks => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel (mkState "<expr>" source toks PmStrict EvNone)) (mkState "<expr>" source toks PmStrict EvNone) 0) (\e, st => if isEof st then OkC e else ps0 st ExpectedEndOfExpr))

-- 解析器累加器（导出/重导出/归约修饰符与声明一起收集）。
record DeclAcc where
  declAccFixities : List FixityDecl
  declAccDecls : List Decl
  declAccExports : List ExportSpec
  declAccOpacity : List OpacitySpec

emptyDeclAcc : DeclAcc
emptyDeclAcc = DeclAcc [] [] [] []

record ParsedDecl where
  parsedFixity : Maybe FixityDecl
  parsedDecl : Maybe Decl
  parsedExport : Maybe ExportSpec
  parsedOpacity : Maybe OpacitySpec

emptyParsedDecl : ParsedDecl
emptyParsedDecl = ParsedDecl Nothing Nothing Nothing Nothing

-- | 一个声明构造的起点：节点 id（与建树事件同一个）+ 首 token 位置。
record DeclStart where
  declStartId : Int
  declStartPos : Pos

-- | 声明节点的 `NodeRef`：id 来自 `withExtent`，span = 起点到最后一个已消费 token。
declRefAt : PState -> DeclStart -> PState -> NodeRef
declRefAt st ds end = NodeRef ds.declStartId (spanFromStart (fileOf st) ds.declStartPos end)

-- ---------------------------------------------------------------
-- 语义载荷：节点区间产出的 AST 值挂到树节点上（`withExtent` 的 `toSem`）。
-- 这些映射是「AST 是树的投影」的唯一接线点：除这里外，树与 AST 不互相引用。
-- ---------------------------------------------------------------
semModHead : Maybe ModDecl -> Maybe CstSem
semModHead Nothing = Nothing
semModHead (Just m) = Just (SemModHead m)

semImport : Import -> Maybe CstSem
semImport i = Just (SemImport i)

semReexportImport : (Import, List ExportItem) -> Maybe CstSem
semReexportImport p = Just (SemReexportImport (firstOf p) (secondOf p))

semExportNamespace : ExportItem -> Maybe CstSem
semExportNamespace item = Just (SemExportNamespace item)

semExportItem : ExportItem -> Maybe CstSem
semExportItem item = Just (SemExportItem item)

semFixity : FixityDecl -> Maybe CstSem
semFixity f = Just (SemFixity f)

semDecl : Decl -> Maybe CstSem
semDecl d = Just (SemDecl d Nothing Nothing)

semParsedDecl : ParsedDecl -> Maybe CstSem
semParsedDecl (ParsedDecl _ (Just d) mexp mop) = Just (SemDecl d mexp mop)
semParsedDecl _ = Nothing

semCtor : Ctor -> Maybe CstSem
semCtor c = Just (SemCtor c)

semField : Field -> Maybe CstSem
semField f = Just (SemField f)

semMethod : TraitMethod -> Maybe CstSem
semMethod m = Just (SemMethod m)

semBindingItem : BindingItem -> Maybe CstSem
semBindingItem (BISig name ty r) = Just (SemBindingSig name ty r)
semBindingItem (BIBind b) = Just (SemBinding b)

semAlt : Alt -> Maybe CstSem
semAlt a = Just (SemAlt a)

semExpr : Expr -> Maybe CstSem
semExpr e = Just (SemExpr e)

semPat : Pat -> Maybe CstSem
semPat p = Just (SemPat p)

semDoStmt : DoStmt -> Maybe CstSem
semDoStmt s = Just (SemDoStmt s)

-- 宏调用节点的载荷：名字 + 实参个数（AST 里的根构造子是保留名标记）。
semMacroAtom : Expr -> Maybe CstSem
semMacroAtom (EVar n _) = semMacroNamed 0 n
semMacroAtom (EApp (EVar n _) args _) = semMacroNamed (natToInt (length args)) n
semMacroAtom _ = Nothing

semMacroNamed : Int -> String -> Maybe CstSem
semMacroNamed arity n =
  case macroNameOf n of
    Just name => Just (SemMacro name arity)
    Nothing => Nothing

-- `handle` 的 return 子句在 AST 里合成到 `ELam`，没有独立的语义构造。
semHandleRet : (String, Expr, NodeRef) -> Maybe CstSem
semHandleRet _ = Nothing

-- op 子句的 AST 形态就是它降级出的 `Alt`（与 `handleAlt` 同一形状）。
semHandleOp : HandleOp -> Maybe CstSem
semHandleOp op = Just (SemAlt (handleAlt op))

-- 把逐定义导出/重导出/归约修饰符挂到模块头上；入口文件没有模块头（这些信息也无下游）。
-- 可选模块头：`module M (导出项, ...) where`；列表省略 = 导出全部。
parseSourceFile : Bool -> PState -> Check ((SourceFile, PState), List Diagnostic)
parseSourceFile recover st =
  Vuna.Compiler.Base.Common.step (parseModDecl st) (
      \hdr, st1 =>
        Vuna.Compiler.Base.Common.step (parseImports (stateFuel st1) st1) (
            \imp, st2 =>
              case imp of
                (imports, reexports) =>
                  if isEof st2 then
                    OkC ((SourceFile hdr imports [] [] [] reexports [], st2), [])
                  else
                    case peekPos st2 of
                      Pos line col _ _ =>
                        Vuna.Compiler.Base.Common.step (parseDecls recover (stateFuel st2) st2 col emptyDeclAcc emptyDeclBlock) (
                            \p, rest =>
                              case rest of
                                (st3, errs) =>
                                  case p of
                                    -- 收尾 token 不是 EOF 也是语法错误，但已收集的诊断必须一起交回：
                                    -- 并进同一批，不要用单条首错覆盖它们。
                                    DeclAcc fixities decls exports opacity =>
                                      let
                                        sf = SourceFile hdr imports fixities decls exports reexports opacity
                                      in if isEof st3 then OkC ((sf, st3), errs) else if recover then OkC ((sf, st3), append errs [endOfInputDiag st3]) else ps0 st3 ExpectedEndOfInput
                          )
          )
    )

parseModDecl : PState -> Check (Maybe ModDecl, PState)
parseModDecl st =
  if atKw st "module" then
    withExtent CstModHeadKind semModHead st (\st0 => parseModDeclBody st0)
  else
    OkC (Nothing, st)

parseModDeclBody : PState -> Check (Maybe ModDecl, PState)
parseModDeclBody st =
  if atKw st "module" then
    Vuna.Compiler.Base.Common.bind
      (expectKw st "module")
      (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => if atSym st2 "(" then Vuna.Compiler.Base.Common.step (parseExportItems True st2) (\items, st3 => Vuna.Compiler.Base.Common.bind (expectKw st3 "where") (\st4 => OkC (Just (ModDecl name True items [] [] [] (NodeRef st.openNodeId (spanOf st st4))), st4))) else Vuna.Compiler.Base.Common.bind (expectKw st2 "where") (\st3 => OkC (Just (ModDecl name False [] [] [] [] (NodeRef st.openNodeId (spanOf st st3))), st3))))
  else
    OkC (Nothing, st)

-- | 导出项列表（模块头与重导出共用）。`anchored` 只对模块头为真：模块头导出项是
-- 注释锚点，重导出项不是；两者源码形状相同，只能由调用点区分。
parseExportItems : Bool -> PState -> Check (List ExportItem, PState)
parseExportItems anchored st =
  Vuna.Compiler.Base.Common.bind
    (expectSym st "(")
    (\st1 => if atSym st1 ")" then OkC ([], advance st1) else parseExportItemsFrom anchored (stateFuel st1) st1)

parseExportItemsFrom : Bool -> Int -> PState -> Check (List ExportItem, PState)
parseExportItemsFrom anchored fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseExportItemAt anchored st)
      (\item, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseExportItemsFrom anchored (fuel - 1) (advance st1)) (\rest, st2 => OkC ((::) item rest, st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC ([item], st2)))

parseExportItemAt : Bool -> PState -> Check (ExportItem, PState)
parseExportItemAt True st =
  withExtent
    CstExportItemKind
    semExportItem
    st
    (\st0 => Vuna.Compiler.Base.Common.step (parseExportItem st0) (\item, st1 => OkC (withExportItemRef (NodeRef st0.openNodeId (spanOf st st1)) item, st1)))
parseExportItemAt False st = parseExportItem st

parseExportItem : PState -> Check (ExportItem, PState)
parseExportItem st =
  case peekTok st of
    PTok (TKw "module") p =>
      Vuna.Compiler.Base.Common.bind
        (expectKw st "module")
        (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => OkC (XModule name (detachedNodeRef (spanOf st st2)), st2)))
    PTok (TIdent name) p =>
      let
        st1 = advance st
      in if atSym st1 "(" then
        Vuna.Compiler.Base.Common.step
          (parseExportMembers st1)
          (\members, st2 => OkC (exportItemOf name members (detachedNodeRef (spanOf st st2)), st2))
      else
        OkC (XBare name (detachedNodeRef (spanOf st st1)), st1)
    -- 导出用户符号名函数（`(<+>)`）。保留符号不可导出。
    PTok (TSym op) p =>
      if isReservedValueName op then
        ps0 st ExpectedExportItem
      else
        OkC (XBare op (detachedNodeRef (spanOf st (advance st))), advance st)
    _ => ps0 st ExpectedExportItem

-- | `T(..)` / `T(A, B)` / `T()` 的括号体（`(` 尚未消费）。
parseExportMembers : PState -> Check (ExportMembers, PState)
parseExportMembers st =
  Vuna.Compiler.Base.Common.bind
    (expectSym st "(")
    (\st1 => if atSym st1 ")" then OkC (EMNone, advance st1) else if atSym st1 ".." then Vuna.Compiler.Base.Common.bind (expectSym st1 "..") (\st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 ")") (\st3 => OkC (EMAll, st3))) else Vuna.Compiler.Base.Common.step (parseMemberNames (stateFuel st1) st1) (\names, st2 => OkC (EMOnly names, st2)))

parseMemberNames : Int -> PState -> Check (List String, PState)
parseMemberNames fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (expectDeclName st)
      (\name, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseMemberNames (fuel - 1) (advance st1)) (\rest, st2 => OkC ((::) name rest, st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC ([name], st2)))

exportItemOf : String -> ExportMembers -> NodeRef -> ExportItem
exportItemOf name EMAll sp = XTypeAll name sp
exportItemOf name EMNone sp = XTypeSome name [] sp
exportItemOf name (EMOnly members) sp = XTypeSome name members sp

-- | `export import [qualified] B [as L] [(x, T(..), T(A, B))]`。
-- 返回普通 `Import`（与 `import` 同语义）+ 重导出项。
parseExportImport : PState -> Check ((Import, List ExportItem), PState)
parseExportImport st =
  withExtent CstImportKind semReexportImport st (\st0 => parseExportImportBody st0)

parseExportImportBody : PState -> Check ((Import, List ExportItem), PState)
parseExportImportBody st =
  Vuna.Compiler.Base.Common.step
    (expectIdent st)
    (\_, st1 => if atKw st1 "import" then Vuna.Compiler.Base.Common.bind (expectKw st1 "import") (\st2 => Vuna.Compiler.Base.Common.step (parseImportAfterKeyword (peekPos st) st.openNodeId st2) (\imp, st3 => parseReexportTail imp st3)) else ps0 st1 ExpectedTopLevelDecl)

-- | `export module C [as X]`：整模块重导出；带 alias 时导出命名空间路径。
-- 不带 Import：加载期按需合成/复用 `import C [as X]`。
parseExportNamespace : PState -> Check (ExportItem, PState)
parseExportNamespace st =
  withExtent CstImportKind semExportNamespace st (\st0 => parseExportNamespaceBody st0)

parseExportNamespaceBody : PState -> Check (ExportItem, PState)
parseExportNamespaceBody st =
  Vuna.Compiler.Base.Common.step
    (expectIdent st)
    (\_, st1 => Vuna.Compiler.Base.Common.bind (expectKw st1 "module") (\st2 => Vuna.Compiler.Base.Common.step (expectIdent st2) (\name, st3 => if atKw st3 "as" then Vuna.Compiler.Base.Common.bind (expectKw st3 "as") (\st4 => Vuna.Compiler.Base.Common.step (expectIdent st4) (\alias, st5 => OkC (XNamespace name (Just alias) (NodeRef st.openNodeId (spanOf st st5)), st5))) else OkC (XNamespace name Nothing (NodeRef st.openNodeId (spanOf st st3)), st3))))

-- 复用 `import` 之后的 qualified/模块名/as 解析。`start` 是 import 构造的首 token
-- （`import` 或 `export`）——`(importSpan Import)` 覆盖整个构造。
parseImportAfterKeyword : Pos -> Int -> PState -> Check (Import, PState)
parseImportAfterKeyword start nid st =
  if atKw st "qualified" then
    Vuna.Compiler.Base.Common.bind
      (expectKw st "qualified")
      (\st1 => parseImportAlias start nid st1 True)
  else
    parseImportAlias start nid st False

parseReexportTail : Import -> PState -> Check ((Import, List ExportItem), PState)
parseReexportTail imp st =
  if atSym st "(" then
    Vuna.Compiler.Base.Common.step
      (parseExportItems False st)
      (\items, st1 => OkC ((imp, map (qualifyExportItem (reexportPrefix imp)) items), st1))
  else
    Vuna.Compiler.Base.Common.bind (expectSym st "(") (\st1 => OkC ((imp, []), st1))

-- 重导出项里的模块前缀：写了 alias 用 alias，否则用全名。
reexportPrefix : Import -> String
reexportPrefix imp =
  case imp.importAlias of
    Just alias => alias
    Nothing => imp.importName

qualifyExportItem : String -> ExportItem -> ExportItem
qualifyExportItem prefix (XBare name sp) = XBare "${prefix}.${name}" sp
qualifyExportItem prefix (XTypeAll name sp) = XTypeAll "${prefix}.${name}" sp
qualifyExportItem prefix (XTypeSome name members sp) = XTypeSome "${prefix}.${name}" members sp
qualifyExportItem prefix (XModule name sp) = XModule name sp
qualifyExportItem prefix (XNamespace name alias sp) = XNamespace name alias sp

parseImportSpec : PState -> Check (Import, PState)
parseImportSpec st = withExtent CstImportKind semImport st (\st0 => parseImportSpecBody st0)

parseImportSpecBody : PState -> Check (Import, PState)
parseImportSpecBody st =
  Vuna.Compiler.Base.Common.bind
    (expectKw st "import")
    (\st1 => parseImportAfterKeyword (peekPos st) st.openNodeId st1)

parseImportAlias : Pos -> Int -> PState -> Bool -> Check (Import, PState)
parseImportAlias start nid st isQualified =
  Vuna.Compiler.Base.Common.step
    (expectIdent st)
    (\name, st1 => if atKw st1 "as" then Vuna.Compiler.Base.Common.bind (expectKw st1 "as") (\st2 => Vuna.Compiler.Base.Common.step (expectIdent st2) (\alias, st3 => OkC (Import name isQualified (Just alias) (NodeRef nid (spanFromStart (fileOf st) start st3)), st3))) else OkC (Import name isQualified Nothing (NodeRef nid (spanFromStart (fileOf st) start st1)), st1))

-- import 区同时收 `export import` 的重导出项；列表顺序无语义。
parseImports : Int -> PState -> Check ((List Import, List ExportItem), PState)
parseImports fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else if atKw st "import" then
    Vuna.Compiler.Base.Common.step (parseImportSpec st) (
        \imp, st1 =>
          Vuna.Compiler.Base.Common.step (parseImports (fuel - 1) st1) (
              \rest, st2 =>
                case rest of
                  (imports, reexports) => OkC (((::) imp imports, reexports), st2)
            )
      )
  else if atIdentName st "export" && atKw (advance st) "import" then
    Vuna.Compiler.Base.Common.step (parseExportImport st) (
        \p, st1 =>
          case p of
            (imp, reexports) =>
              Vuna.Compiler.Base.Common.step (parseImports (fuel - 1) st1) (
                  \rest, st2 =>
                    case rest of
                      (imports, reexports2) => OkC (((::) imp imports, append reexports reexports2), st2)
                )
      )
  else if atIdentName st "export" && atKw (advance st) "module" then
    Vuna.Compiler.Base.Common.step (parseExportNamespace st) (
        \item, st1 =>
          Vuna.Compiler.Base.Common.step (parseImports (fuel - 1) st1) (
              \rest, st2 =>
                case rest of
                  (imports, reexports2) => OkC ((imports, (::) item reexports2), st2)
            )
      )
  else
    OkC (([], []), st)

-- ---------------------------------------------------------------
-- 顶层定义块：同名子句必须连续，且不得被前面的子句覆盖（语法蕴含）。
-- 判据只看源码顺序：fixity 行、逐定义 export / 归约修饰符行、任何别的声明都结束当前块。
-- PmStrict 与 PmTool 同判（这是语法形状，不是语义推断）。
-- ---------------------------------------------------------------
record DeclBlock where
  dbOpen : Maybe String
  dbClauses : List (List Pat, Span)
  dbFirst : HashMap String Span
  -- | 上一条声明解析失败：它与前后声明的关系不可判，恢复后的第一条声明不判子句规则
  -- （那是解析失败的级联），块状态照常更新，后续声明继续按规则判。
  dbResume : Bool

emptyDeclBlock : DeclBlock
emptyDeclBlock = DeclBlock Nothing [] (HashMap.fromList []) False

-- 恢复点：跳到下一个声明边界后，先把「边界不可判」标上。
dbMarkResume : DeclBlock -> DeclBlock
dbMarkResume b = { b | dbResume = True }

dbClose : DeclBlock -> DeclBlock
dbClose b = DeclBlock Nothing [] b.dbFirst b.dbResume

-- 开新块：`dbFirst` 只记**第一次**出现的位置（后置诊断的 label 指它）。
dbOpenAt : String -> Span -> DeclBlock -> DeclBlock
dbOpenAt n sp b =
  let
    first2 = if HashMap.member n b.dbFirst then b.dbFirst else HashMap.insert n sp b.dbFirst
  in DeclBlock (Just n) [] first2 b.dbResume

dbAddClause : DeclBlock -> List Pat -> Span -> DeclBlock
dbAddClause b pats sp = DeclBlock b.dbOpen ((::) (pats, sp) b.dbClauses) b.dbFirst b.dbResume

anyNullary : List (List Pat, Span) -> Bool
anyNullary [] = False
anyNullary ((ps, _) :: rest) =
  case ps of
    [] => True
    _ => anyNullary rest

findShadow : List (List Pat, Span) -> List Pat -> Maybe Span
findShadow [] qs = Nothing
findShadow ((ps, sp) :: rest) qs = if clauseSubsumedBy ps qs then Just sp else findShadow rest qs

clauseVerdict : DeclBlock -> String -> List Pat -> Span -> Maybe Diagnostic
clauseVerdict b n [] sp =
  if anyNullary b.dbClauses then
    Just (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg (DefinitionDuplicate n) [n]))
  else
    Nothing
clauseVerdict b n pats sp =
  case findShadow b.dbClauses pats of
    Just firstSp => Just (shadowDiag n sp firstSp)
    Nothing => Nothing

shadowDiag : String -> Span -> Span -> Diagnostic
shadowDiag n sp firstSp =
  withLabel
    (Label (Just firstSp) "an earlier clause already matches these values" LabelSecondary Nothing)
    (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg (ClauseShadowed n) [n]))

reopenDiag : DeclBlock -> String -> Span -> Maybe Diagnostic
reopenDiag b n sp =
  case HashMap.lookup n b.dbFirst of
    Just firstSp => Just (notAdjacentDiag n sp firstSp)
    Nothing => Nothing

notAdjacentDiag : String -> Span -> Span -> Diagnostic
notAdjacentDiag n sp firstSp =
  withLabel
    (Label (Just firstSp) "the definition starts here" LabelSecondary Nothing)
    (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg (ClauseNotAdjacent n) [n]))

blockFun : DeclBlock -> String -> List Pat -> Span -> (Maybe Diagnostic, DeclBlock)
blockFun b n pats sp =
  case b.dbOpen of
    Just cur =>
      if cur == n then
        (clauseVerdict b n pats sp, dbAddClause b pats sp)
      else
        (reopenDiag b n sp, dbOpenAt n sp (dbClose b))
    Nothing => (reopenDiag b n sp, dbOpenAt n sp (dbClose b))

blockSig : DeclBlock -> String -> Span -> (Maybe Diagnostic, DeclBlock)
blockSig b n sp =
  case b.dbOpen of
    Just cur => if cur == n then (Nothing, b) else (reopenDiag b n sp, dbOpenAt n sp (dbClose b))
    Nothing => (reopenDiag b n sp, dbOpenAt n sp b)

-- `Nothing` = 这条声明不破坏规则；`Just d` = 规则错误（调用方按 recover 决定致命 / 累积）。
--
-- 恢复后的第一条声明只更新块状态、不报规则错：解析失败吞掉了它前面那条声明的名字，
-- 与谁相邻 / 是否重复在语法上已经不可判（该报的是那条解析错，不是级联）。
blockStep : DeclBlock -> ParsedDecl -> (Maybe Diagnostic, DeclBlock)
blockStep b pd =
  case blockStepRaw b pd of
    (verdict, b2) => (if b.dbResume then Nothing else verdict, { b2 | dbResume = False })

blockStepRaw : DeclBlock -> ParsedDecl -> (Maybe Diagnostic, DeclBlock)
blockStepRaw b (ParsedDecl (Just _) _ _ _) = (Nothing, dbClose b)
blockStepRaw b (ParsedDecl Nothing _ (Just _) _) = (Nothing, dbClose b)
blockStepRaw b (ParsedDecl Nothing _ Nothing (Just _)) = (Nothing, dbClose b)
blockStepRaw b (ParsedDecl Nothing (Just (DFun n pats _ r)) Nothing Nothing) =
  blockFun b n pats (nodeRefSpan r)
blockStepRaw b (ParsedDecl Nothing (Just (DSig n _ _ r)) Nothing Nothing) =
  blockSig b n (nodeRefSpan r)
blockStepRaw b (ParsedDecl Nothing (Just _) Nothing Nothing) = (Nothing, dbClose b)
blockStepRaw b (ParsedDecl Nothing Nothing Nothing Nothing) = (Nothing, b)

-- `infixl` / `infixr` / `infix` 声明与顶层声明穿插收集（声明本身不进入 Decl，
-- 由 Loader 在中缀重排时消费；见 `SourceFile.fixities`）。
-- 累加器定义在文件前部（`DeclAcc` / `ParsedDecl`）。
parseDecls : Bool -> Int -> PState -> Int -> DeclAcc -> DeclBlock -> Check (DeclAcc, PState, List Diagnostic)
parseDecls recover fuel st blockCol acc blocks =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC (reverseDeclAcc acc, st, [])
  else
    case peekPos st of
      Pos line col _ _ =>
        if col == blockCol then
          case parseFixityOrDecl st blockCol of
            ErrC e =>
              if recover then
                let
                  st2 = recoverDecl st blockCol
                in Vuna.Compiler.Base.Common.step (parseDecls True (fuel - 1) st2 blockCol acc (dbMarkResume (dbClose blocks))) (
                    \p, rest =>
                      case rest of
                        (st3, errs) => OkC (p, st3, (::) e errs)
                  )
              else
                ErrC e
            OkC p =>
              let
                pd = firstOf p
                st1 = secondOf p
                acc2 = addParsedDecl pd acc
                verdict = blockStep blocks pd
              in case firstOf verdict of
                Just e =>
                  if recover then
                    Vuna.Compiler.Base.Common.step (parseDecls True (fuel - 1) st1 blockCol acc2 (secondOf verdict)) (
                        \q, rest =>
                          case rest of
                            (st3, errs) => OkC (q, st3, (::) e errs)
                      )
                  else
                    ErrC e
                Nothing => parseDecls recover (fuel - 1) st1 blockCol acc2 (secondOf verdict)
        else if recover then
          Vuna.Compiler.Base.Common.step (parseDecls True (fuel - 1) (recoverDecl st blockCol) blockCol acc (dbMarkResume (dbClose blocks))) (
              \p, rest =>
                case rest of
                  -- 块首列之外的 token：报告缩进错误。恢复期不短路整份文件——跨过它继续收集
                  -- 后面的声明错误；否则这里会丢掉此前已收集的诊断。
                  (st3, errs) => OkC (p, st3, (::) (declColumnDiag st blockCol) errs)
            )
        else
          ps1 st (ExpectedDeclAtColumn (strFromInt blockCol)) (strFromInt blockCol)

-- 「此处没有声明」的恢复期诊断（位置 = 当前 token；与 `ps1` 同一码与字段）。
declColumnDiag : PState -> Int -> Diagnostic
declColumnDiag st blockCol =
  let
    col = strFromInt blockCol
  in psDiagAt st (ExpectedDeclAtColumn col) [col]

addParsedDecl : ParsedDecl -> DeclAcc -> DeclAcc
addParsedDecl (ParsedDecl mfix mdecl mexp mop) (DeclAcc fixities decls exports opacity) =
  let
    fixities2 =
      case mfix of
        Just f => (::) f fixities
        Nothing => fixities
    decls2 =
      case mdecl of
        Just d => (::) d decls
        Nothing => decls
    exports2 =
      case mexp of
        Just e => (::) e exports
        Nothing => exports
    opacity2 =
      case mop of
        Just o => (::) o opacity
        Nothing => opacity
  in DeclAcc fixities2 decls2 exports2 opacity2

reverseDeclAcc : DeclAcc -> DeclAcc
reverseDeclAcc (DeclAcc fixities decls exports opacity) =
  DeclAcc (reverse fixities) (reverse decls) (reverse exports) (reverse opacity)

-- 解析恢复：跳过一个坏声明，停在下一个「可以开始声明」的 token（无则到 EOF）。
--
-- 声明起点必须同时满足：括号深度 0、与块首同列、不是闭括号。深度从**声明起点**开始
-- 计（顶层声明入口必在深度 0），所以多行括号表达式里与块首同列的 token 不会造出假声明；
-- 闭括号本身属于前一个没闭合的括号，也要跨过。
recoverDecl : PState -> Int -> PState
recoverDecl st blockCol =
  let
    rest = skipPastDeclStart st.toksOf blockCol
    skipped = length st.toksOf - length rest
  in { st | toksOf = rest, toksLeft = length rest, tokIndex = st.tokIndex + skipped }

skipPastDeclStart : List PTok -> Int -> List PTok
skipPastDeclStart [] blockCol = []
skipPastDeclStart (_ :: rest) blockCol = skipToDeclLine rest blockCol 0

-- `depth` = 已经跨过的括号层数（开括号加一、闭括号减一，不低于 0）。
skipToDeclLine : List PTok -> Int -> Int -> List PTok
skipToDeclLine [] blockCol depth = []
skipToDeclLine (t :: rest) blockCol depth =
  if declStartsAt depth t blockCol then
    (::) t rest
  else
    skipToDeclLine rest blockCol (declDepthAfter depth t)

-- 顶层块首列的声明起点：括号深度 0、不是闭括号、与块首同列。
declStartsAt : Int -> PTok -> Int -> Bool
declStartsAt depth (PTok tok p) blockCol =
  depth == 0 && posCol p == blockCol && not (closesBracket tok)

closesBracket : Tok -> Bool
closesBracket (TSym ")") = True
closesBracket (TSym "]") = True
closesBracket (TSym "}") = True
closesBracket _ = False

-- 括号层数的一步（非括号 token 不改变深度）。
declDepthAfter : Int -> PTok -> Int
declDepthAfter depth (PTok tok _) =
  case tokBracketStep tok depth of
    Just d2 => d2
    Nothing => depth

-- 一条顶层声明：fixity / 带修饰符的声明 / 普通 Decl。
parseFixityOrDecl : PState -> Int -> Check (ParsedDecl, PState)
parseFixityOrDecl st blockCol =
  case peekTok st of
    PTok (TKw "infixl") p =>
      Vuna.Compiler.Base.Common.step
        (parseFixityDecl st blockCol 1 p)
        (\fd, st1 => OkC (ParsedDecl (Just fd) Nothing Nothing Nothing, st1))
    PTok (TKw "infixr") p =>
      Vuna.Compiler.Base.Common.step
        (parseFixityDecl st blockCol 2 p)
        (\fd, st1 => OkC (ParsedDecl (Just fd) Nothing Nothing Nothing, st1))
    PTok (TKw "infix") p =>
      Vuna.Compiler.Base.Common.step
        (parseFixityDecl st blockCol 0 p)
        (\fd, st1 => OkC (ParsedDecl (Just fd) Nothing Nothing Nothing, st1))
    _ =>
      if exportStart st then
        parseExportDecl st blockCol
      else if opacityStart st then
        parseOpacityDecl st blockCol
      else
        Vuna.Compiler.Base.Common.step
          (parseDecl st blockCol)
          (\decl, st1 => OkC (ParsedDecl Nothing (Just decl) Nothing Nothing, st1))

-- 软关键字 `export`：`export f : T` / `export data ...`；不吞掉名为 export 的普通定义。
exportStart : PState -> Bool
exportStart st =
  case peekTok st of
    PTok (TIdent "export") _ => exportMarkerFollows (advance st)
    _ => False

exportMarkerFollows : PState -> Bool
exportMarkerFollows st =
  case peekTok st of
    PTok (TSym ":") _ => False
    PTok (TIdent _) _ => True
    PTok (TSym _) _ => True
    PTok (TKw "data") _ => True
    PTok (TKw "record") _ => True
    PTok (TKw "trait") _ => True
    PTok (TKw "axiom") _ => True
    PTok (TKw "extern") _ => True
    PTok (TKw "linear") _ => True
    PTok (TKw "opaque") _ => True
    PTok (TKw "transparent") _ => True
    PTok (TKw "import") _ => True
    _ => False

-- `opaque` / `transparent` 在声明开头是定义归约修饰符；后跟 record/linear record 时
-- 不算修饰符（档位前缀写法只出现在 `export` 位置，声明位置给出明确诊断）。
opacityStart : PState -> Bool
opacityStart st =
  case peekTok st of
    PTok (TKw "opaque") _ => not (tierFollows st)
    PTok (TKw "transparent") _ => not (tierFollows st)
    PTok (TIdent "abstract") _ => True
    _ => False

-- | 逐定义导出：`export [opaque|transparent] <decl>`。`ds` 的起点是 `export` 的位置：
-- 修饰符属于该声明的 span（与建树节点一致）。
parseExportDecl : PState -> Int -> Check (ParsedDecl, PState)
parseExportDecl st blockCol =
  withExtent
    CstDeclKind
    semParsedDecl
    st
    (\st0 => parseExportDeclBody st0 blockCol (DeclStart st0.openNodeId (peekPos st0)))

parseExportDeclBody : PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseExportDeclBody st blockCol ds =
  Vuna.Compiler.Base.Common.step
    (expectIdent st)
    (\_, st1 => if atKw st1 "opaque" && not (tierFollows st1) then Vuna.Compiler.Base.Common.bind (expectKw st1 "opaque") (\st2 => parseExportedValue (Just OpacityOpaque) st2 blockCol ds) else if atKw st1 "transparent" && not (tierFollows st1) then Vuna.Compiler.Base.Common.bind (expectKw st1 "transparent") (\st2 => parseExportedValue (Just OpacityTransparent) st2 blockCol ds) else if atIdentName st1 "abstract" then Vuna.Compiler.Base.Common.step (expectIdent st1) (\_, st2 => parseExportedValue (Just OpacityAbstract) st2 blockCol ds) else parseExportedPlain Nothing st1 blockCol ds)

parseExportedPlain : Maybe Opacity -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseExportedPlain op st blockCol ds =
  case peekTok st of
    PTok (TKw "data") _ =>
      if opacityGiven op then
        ps1 st (ExpectedToken "value signature") "value signature"
      else
        parseDataExport False st blockCol ds
    PTok (TKw "linear") _ =>
      if opacityGiven op then
        ps1 st (ExpectedToken "value signature") "value signature"
      else
        parseLinearExport st blockCol ds
    PTok (TKw "record") _ =>
      if opacityGiven op then
        ps1 st (ExpectedToken "value signature") "value signature"
      else
        parseRecordExport False ReprAuto st blockCol ds
    PTok (TKw "trait") _ =>
      if opacityGiven op then
        ps1 st (ExpectedToken "value signature") "value signature"
      else
        parseTraitExport st blockCol ds
    PTok (TKw "axiom") _ => parseAxiomExport op st blockCol ds
    PTok (TKw "extern") _ => parseExternExport op st blockCol ds
    PTok (TKw "transparent") _ =>
      if tierFollows st then
        parseTieredExport ReprAlias st blockCol ds
      else
        ps1 st (ExpectedToken "value signature") "value signature"
    PTok (TKw "opaque") _ =>
      if tierFollows st then
        parseTieredExport ReprBoxed st blockCol ds
      else
        ps1 st (ExpectedToken "value signature") "value signature"
    PTok (TIdent name) _ =>
      if (name == "alias" || name == "boxed") && tierFollows st then
        if opacityGiven op then
          ps1 st (ExpectedToken "value signature") "value signature"
        else
          parseTieredExport (if name == "alias" then ReprAlias else ReprBoxed) st blockCol ds
      else
        parseExportedValue op st blockCol ds
    PTok (TSym _) _ => parseExportedValue op st blockCol ds
    _ => ps0 st ExpectedTopLevelDecl

opacityGiven : Maybe Opacity -> Bool
opacityGiven Nothing = False
opacityGiven (Just _) = True

opacitySpecOf : Maybe Opacity -> String -> Span -> Maybe OpacitySpec
opacitySpecOf Nothing name sp = Nothing
opacitySpecOf (Just kind) name sp = Just (OpacitySpec name kind sp)

-- | `export [opaque|transparent] f : T`（也接受无签名的子句，交给 Elab 报既有诊断）。
parseExportedValue : Maybe Opacity -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseExportedValue op st blockCol ds =
  case peekTok st of
    PTok (TIdent name) _ =>
      let
        st1 = advance st
      in if atSym st1 ":" then
        Vuna.Compiler.Base.Common.step
          (parseSignature st1 blockCol True name ds)
          (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanFromStart (fileOf st) ds.declStartPos st2))) (opacitySpecOf op name (spanFromStart (fileOf st) ds.declStartPos st2)), st2))
      else
        Vuna.Compiler.Base.Common.step
          (parseClause st1 blockCol name ds)
          (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanFromStart (fileOf st) ds.declStartPos st2))) (opacitySpecOf op name (spanFromStart (fileOf st) ds.declStartPos st2)), st2))
    -- 声明位带括号的符号名：`export (==) : ...` / `export (<+>) x y = ...`。
    PTok (TSym "(") _ =>
      Vuna.Compiler.Base.Common.step
        (expectDeclName st)
        (\name, st1 => if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True name ds) (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanFromStart (fileOf st) ds.declStartPos st2))) (opacitySpecOf op name (spanFromStart (fileOf st) ds.declStartPos st2)), st2)) else Vuna.Compiler.Base.Common.step (parseClause st1 blockCol name ds) (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue name (spanFromStart (fileOf st) ds.declStartPos st2))) (opacitySpecOf op name (spanFromStart (fileOf st) ds.declStartPos st2)), st2)))
    PTok (TSym sym) _ =>
      if isReservedValueName sym then
        ps1 st (ExpectedToken "value name") "value name"
      else
        let
          st1 = advance st
        in if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True sym ds) (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue sym (spanFromStart (fileOf st) ds.declStartPos st2))) (opacitySpecOf op sym (spanFromStart (fileOf st) ds.declStartPos st2)), st2)) else Vuna.Compiler.Base.Common.step (parseClause st1 blockCol sym ds) (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue sym (spanFromStart (fileOf st) ds.declStartPos st2))) (opacitySpecOf op sym (spanFromStart (fileOf st) ds.declStartPos st2)), st2))
    _ => ps1 st (ExpectedToken "value name") "value name"

parseAxiomExport : Maybe Opacity -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseAxiomExport op st blockCol ds =
  if opacityGiven op then
    ps1 st (ExpectedToken "value signature") "value signature"
  else
    Vuna.Compiler.Base.Common.step (parseAxiom st blockCol ds) (
        \decl, st1 =>
          case decl of
            DAxiom name _ r => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue name (nodeRefSpan r))) Nothing, st1)
            _ => icInternal "parseAxiomExport: not an axiom"
      )

parseExternExport : Maybe Opacity -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseExternExport op st blockCol ds =
  if opacityGiven op then
    ps1 st (ExpectedToken "value signature") "value signature"
  else
    Vuna.Compiler.Base.Common.step (parseExtern st blockCol ds) (
        \decl, st1 =>
          case decl of
            DExtern name _ _ r => OkC (ParsedDecl Nothing (Just decl) (Just (ESValue name (nodeRefSpan r))) Nothing, st1)
            _ => icInternal "parseExternExport: not an extern"
      )

-- | `export linear data/record ...`。
parseLinearExport : PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseLinearExport st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "linear") (
      \st1 =>
        case peekTok st1 of
          PTok (TKw "data") _ => parseDataExport True st1 blockCol ds
          PTok (TKw "record") _ => parseRecordExport True ReprAuto st1 blockCol ds
          _ => ps1 st1 (ExpectedToken "data/record") "data/record"
    )

-- | 归约修饰符：`opaque f : T` / `transparent f : T`（值定义；不导出）。
parseOpacityDecl : PState -> Int -> Check (ParsedDecl, PState)
parseOpacityDecl st blockCol =
  withExtent
    CstDeclKind
    semParsedDecl
    st
    (\st0 => parseOpacityDeclBody st0 blockCol (DeclStart st0.openNodeId (peekPos st0)))

parseOpacityDeclBody : PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseOpacityDeclBody st blockCol ds =
  case peekTok st of
    PTok (TKw "opaque") _ =>
      Vuna.Compiler.Base.Common.bind
        (expectKw st "opaque")
        (\st1 => parseOpacityValue OpacityOpaque st1 blockCol ds)
    PTok (TKw "transparent") _ =>
      Vuna.Compiler.Base.Common.bind
        (expectKw st "transparent")
        (\st1 => parseOpacityValue OpacityTransparent st1 blockCol ds)
    PTok (TIdent "abstract") _ =>
      Vuna.Compiler.Base.Common.step
        (expectIdent st)
        (\_, st1 => parseOpacityValue OpacityAbstract st1 blockCol ds)
    _ => ps0 st ExpectedTopLevelDecl

parseOpacityValue : Opacity -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseOpacityValue kind st blockCol ds =
  case peekTok st of
    PTok (TIdent name) _ =>
      let
        st1 = advance st
      in if atSym st1 ":" then
        Vuna.Compiler.Base.Common.step
          (parseSignature st1 blockCol True name ds)
          (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) Nothing (Just (OpacitySpec name kind (spanFromStart (fileOf st) ds.declStartPos st2))), st2))
      else
        ps1 st (ExpectedToken "value signature") "value signature"
    PTok (TSym sym) _ =>
      if isReservedValueName sym then
        ps1 st (ExpectedToken "value name") "value name"
      else
        let
          st1 = advance st
        in if atSym st1 ":" then Vuna.Compiler.Base.Common.step (parseSignature st1 blockCol True sym ds) (\decl, st2 => OkC (ParsedDecl Nothing (Just decl) Nothing (Just (OpacitySpec sym kind (spanFromStart (fileOf st) ds.declStartPos st2))), st2)) else ps1 st (ExpectedToken "value signature") "value signature"
    _ => ps1 st (ExpectedToken "value signature") "value signature"

-- | `export alias record` / `export boxed record`。
parseTieredExport : ReprTier -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseTieredExport tier st blockCol ds =
  case peekTok (advance st) of
    PTok (TKw "linear") _ =>
      case peekTok (advance (advance st)) of
        PTok (TKw "record") _ => parseRecordExport True tier (advance (advance st)) blockCol ds
        _ => ps1 (advance st) (ExpectedToken "record") "record"
    PTok (TKw "record") _ => parseRecordExport False tier (advance st) blockCol ds
    _ => ps1 (advance st) (ExpectedToken "record") "record"

-- | 导出 `data`：名字/参数后允许成员列表 `(..)` / `(A, B)` / `()`。
parseDataExport : Bool -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseDataExport lin st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "data") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (expectIdent st1) (
            \name, st2 =>
              Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (
                  \params, st3 =>
                    Vuna.Compiler.Base.Common.step (parseOptionalMembers st3) (
                        \members, st3b =>
                          Vuna.Compiler.Base.Common.bind (expectSym st3b ":") (
                              \st4 =>
                                Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st4) st4 blockCol) (
                                    \ty, st5 =>
                                      Vuna.Compiler.Base.Common.bind (expectKw st5 "where") (
                                          \st6 =>
                                            Vuna.Compiler.Base.Common.step (parseCtors st6 blockCol) (
                                                \ctors, st7 =>
                                                  Vuna.Compiler.Base.Common.step (parseDeriving st7) (
                                                      \dv, st8 =>
                                                        case dv of
                                                          (derivings, via) =>
                                                            let
                                                              decl = DData name params ty ctors derivings via ReprAuto lin (declRefAt st ds st8)
                                                            in OkC (ParsedDecl Nothing (Just decl) (Just (ESType name members (declSpan decl))) Nothing, st8)
                                                    )
                                              )
                                        )
                                  )
                            )
                      )
                )
          )
    )

parseRecordExport : Bool -> ReprTier -> PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseRecordExport lin tier st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "record") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (expectIdent st1) (
            \name, st2 =>
              Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (
                  \params, st3 =>
                    Vuna.Compiler.Base.Common.step (parseOptionalMembers st3) (
                        \members, st3b =>
                          Vuna.Compiler.Base.Common.bind (expectKw st3b "where") (
                              \st4 =>
                                Vuna.Compiler.Base.Common.step (parseFields st4 blockCol) (
                                    \fields, st5 =>
                                      Vuna.Compiler.Base.Common.step (parseDeriving st5) (
                                          \dv, st6 =>
                                            case dv of
                                              (derivings, via) =>
                                                let
                                                  decl = DRecord name params fields derivings via tier lin (declRefAt st ds st6)
                                                in OkC (ParsedDecl Nothing (Just decl) (Just (ESType name members (declSpan decl))) Nothing, st6)
                                        )
                                  )
                            )
                      )
                )
          )
    )

parseTraitExport : PState -> Int -> DeclStart -> Check (ParsedDecl, PState)
parseTraitExport st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "trait") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (parseTraitHead st1) (
            \h, st2 =>
              Vuna.Compiler.Base.Common.step (parseTraitExportMembers st2) (
                  \members, st3 =>
                    Vuna.Compiler.Base.Common.bind (expectKw st3 "where") (
                        \st4 =>
                          Vuna.Compiler.Base.Common.step (parseMethodSigs st4 blockCol) (
                              \methods, st5 =>
                                let
                                  decl = DTrait h.traitHeadName h.traitHeadParams h.traitHeadSupers methods (declRefAt st ds st5)
                                in OkC (ParsedDecl Nothing (Just decl) (Just (ESType h.traitHeadName members (declSpan decl))) Nothing, st5)
                            )
                      )
                )
          )
    )

-- trait 头：`[C1 a, C2 b =>] Name params`。父类约束在 trait 名之前（Haskell 风格）。
-- 用 token lookahead 判断是否存在约束前缀：`=>` 出现在 `where` 之前且括号深度为 0。
record TraitHead where
  traitHeadName : String
  traitHeadParams : List TraitParam
  traitHeadSupers : List Expr

parseTraitHead : PState -> Check (TraitHead, PState)
parseTraitHead st =
  if traitSupersFollow st then
    Vuna.Compiler.Base.Common.bind (parseTraitSupers (stateFuel st) st) (
        \p =>
          let
            supers = firstOf p
            st1 = secondOf p
          in Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.step (parseTraitParams (stateFuel st2) st2) (\params, st3 => OkC (TraitHead name params supers, st3)))
      )
  else
    Vuna.Compiler.Base.Common.step (expectIdent st) (\name, st1 => Vuna.Compiler.Base.Common.step (parseTraitParams (stateFuel st1) st1) (\params, st2 => OkC (TraitHead name params [], st2)))

traitSupersFollow : PState -> Bool
traitSupersFollow st = traitSupersFollowGo 0 st.toksOf

traitSupersFollowGo : Int -> List PTok -> Bool
traitSupersFollowGo depth [] = False
traitSupersFollowGo depth ((PTok tok p) :: rest) =
  case tok of
    TSym "=>" => depth == 0
    TKw "where" => False
    TSym "(" => traitSupersFollowGo (depth + 1) rest
    TSym ")" => traitSupersFollowGo (if depth > 0 then depth - 1 else 0) rest
    _ => traitSupersFollowGo depth rest

parseTraitSupers : Int -> PState -> Check (List Expr, PState)
parseTraitSupers fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseExpr fuel st 0)
      (\e1, st1 => parseTraitSupersRest (fuel - 1) st1 [e1])

parseTraitSupersRest : Int -> PState -> List Expr -> Check (List Expr, PState)
parseTraitSupersRest fuel st acc =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "=>" then
    OkC (reverse acc, advance st)
  else
    Vuna.Compiler.Base.Common.bind
      (expectSym st ",")
      (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 0) (\e, st2 => parseTraitSupersRest (fuel - 1) st2 (e :: acc)))

-- trait 导出成员：`trait C(..)` / `trait C(m1, m2)`；无成员列表 = EMNone。
parseTraitExportMembers : PState -> Check (ExportMembers, PState)
parseTraitExportMembers st = parseOptionalMembers st

-- 只看括号组里第一个 token：`..` / `)` / `ident ,` / `ident )` 是成员列表；
-- `ident ident :` / `ident :` 是显式 kind 参数。
parenIsMemberList : PState -> Bool
parenIsMemberList st =
  case peekTok (advance st) of
    PTok (TSym "..") _ => True
    PTok (TSym ")") _ => True
    PTok (TIdent _) _ =>
      case peekTok (advance (advance st)) of
        PTok (TSym ",") _ => True
        PTok (TSym ")") _ => True
        _ => False
    _ => False

parseOptionalMembers : PState -> Check (ExportMembers, PState)
parseOptionalMembers st = if atSym st "(" then parseExportMembers st else OkC (EMNone, st)

-- `infixl 6 +` / `infixr 5 ::` / `infix 4 ==`。
-- | 一条 `infix*` 声明的建树节点。
parseFixityDecl : PState -> Int -> Int -> Pos -> Check (FixityDecl, PState)
parseFixityDecl st blockCol assoc kwPos =
  withExtent
    CstFixityKind
    semFixity
    st
    (\st0 => parseFixityDeclBody st0 blockCol assoc kwPos st0.openNodeId)

parseFixityDeclBody : PState -> Int -> Int -> Pos -> Int -> Check (FixityDecl, PState)
parseFixityDeclBody st blockCol assoc kwPos nid =
  Vuna.Compiler.Base.Common.step
    (expectFixityLevel (advance st))
    (\level, st1 => Vuna.Compiler.Base.Common.step (expectOpName st1) (\op, st2 => OkC (FixityDecl op level assoc (NodeRef nid (spanFromStart (fileOf st) kwPos st2)), st2)))

-- 声明位的名字：标识符 / `(sym)` / 裸符号。trait 方法、instance 方法、data 构造子
-- 与导出成员列表共用，允许运算符与标识符同等使用。保留符号不是可定义名。
expectDeclName : PState -> Check (String, PState)
expectDeclName st =
  case peekTok st of
    PTok (TIdent name) _ => OkC (name, advance st)
    PTok (TSym "(") _ =>
      case peekTokAt st 1 of
        Just (PTok (TSym sym) _) =>
          if isReservedValueName sym then
            ps1 st (ExpectedToken "operator") "operator"
          else
            case peekTokAt st 2 of
              Just (PTok (TSym ")") _) => OkC (sym, advance (advance (advance st)))
              _ => ps1 st (ExpectedToken "operator") "operator"
        _ => ps1 st (ExpectedToken "operator") "operator"
    PTok (TSym sym) _ =>
      if isReservedValueName sym then
        ps1 st (ExpectedToken "operator") "operator"
      else
        OkC (sym, advance st)
    _ => ps0 st ExpectedIdentifier

expectFixityLevel : PState -> Check (Int, PState)
expectFixityLevel st =
  case peekTok st of
    PTok (TInt n) p => if n >= 0 && n <= 9 then OkC (n, advance st) else ps0 st FixityLevelRange
    _ => ps0 st ExpectedFixityLevel

-- fixity/别名声明里的运算符名：符号（`+`、`::`）或标识符（`eq`）。
-- 保留符号（`isSyntaxSym` ∪ {`->`, `` ` ``}）不是用户运算符，不能声明 fixity。
expectOpName : PState -> Check (String, PState)
expectOpName st =
  case peekTok st of
    PTok (TSym op) p =>
      if isReservedValueName op then
        ps1 st (ExpectedToken "operator") "operator"
      else
        OkC (op, advance st)
    PTok (TIdent name) p =>
      if isReservedValueName name then
        ps1 st (ExpectedToken "operator") "operator"
      else
        OkC (name, advance st)
    _ => ps1 st (ExpectedToken "operator") "operator"

-- | 一条声明的建树节点（区间从入口 token 到出口 token）。
parseDecl : PState -> Int -> Check (Decl, PState)
parseDecl st blockCol =
  withExtent
    CstDeclKind
    semDecl
    st
    (\st0 => parseDeclBody st0 blockCol (DeclStart st0.openNodeId (peekPos st0)))

parseDeclBody : PState -> Int -> DeclStart -> Check (Decl, PState)
parseDeclBody st blockCol ds =
  case peekTok st of
    PTok (TKw "data") _ => parseData False st blockCol ds
    PTok (TKw "linear") _ => parseLinearDecl st blockCol ds
    -- 表示档位前缀只允许 record（data 收归位置/求和类型）。
    -- `alias` / `boxed` 是软关键字（只在紧跟 record/linear record 时生效）。
    PTok (TKw "axiom") _ => parseAxiom st blockCol ds
    PTok (TKw "extern") _ => parseExtern st blockCol ds
    PTok (TKw "record") _ => parseRecord False ReprAuto st blockCol ds
    PTok (TKw "trait") _ => parseTrait st blockCol ds
    PTok (TKw "instance") _ => parseInstance st blockCol ds
    -- 声明位的运算符名：`(==) : ...` / `(<+>) x y = ...`（与 trait 方法 / instance 方法 /
    -- 构造子一致）。裸符号写法（`<+> x y = ...`）同样接受。
    PTok (TSym "(") _ =>
      Vuna.Compiler.Base.Common.step
        (expectDeclName st)
        (\name, st1 => if atSym st1 ":" then parseSignature st1 blockCol True name ds else parseClause st1 blockCol name ds)
    PTok (TIdent name) _ =>
      if name == "alias" && tierFollows st then
        parseTieredDecl ReprAlias st blockCol ds
      else if name == "boxed" && tierFollows st then
        parseTieredDecl ReprBoxed st blockCol ds
      else
        let
          st1 = advance st
        in if atSym st1 ":" then parseSignature st1 blockCol True name ds else parseClause st1 blockCol name ds
    -- 用户符号名函数（`<+> a b = a + b`）与签名（`<+> : ...`）。
    -- 保留符号（`->` / 反引号 / 语法符号）不是可定义名。
    PTok (TSym op) _ =>
      if isReservedValueName op then
        ps0 st ExpectedTopLevelDecl
      else
        let
          st1 = advance st
        in if atSym st1 ":" then parseSignature st1 blockCol True op ds else parseClause st1 blockCol op ds
    _ => ps0 st ExpectedTopLevelDecl

-- axiom 声明（D10）：`axiom name : Ty`，无 `=` 体。
-- 它是无体的可擦除顶层，只在类型层可用（运行时使用由擦除检查拒绝）。
parseAxiom : PState -> Int -> DeclStart -> Check (Decl, PState)
parseAxiom st blockCol ds =
  Vuna.Compiler.Base.Common.bind
    (expectKw st "axiom")
    (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\name, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 ":") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st3) st3 blockCol) (\ty, st4 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st4) (\st5 => OkC (DAxiom name ty (declRefAt st ds st5), st5))))))

-- 受限 FFI 声明 `extern name "c_name" : Ty`（无体）。类型只允许基本类型，
-- 由 Elab 检查；运行时由包根 `ffi/*.c` 提供，codegen 生成 OCaml `external`。
parseExtern : PState -> Int -> DeclStart -> Check (Decl, PState)
parseExtern st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "extern") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (expectIdent st1) (
            \name, st2 =>
              case peekTok st2 of
                PTok (TStr cName) cp => Vuna.Compiler.Base.Common.step (OkC (cName, advance st2)) (\cName2, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 ":") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st4) st4 blockCol) (\ty, st5 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st5) (\st6 => OkC (DExtern name cName2 ty (declRefAt st ds st6), st6)))))
                _ => ps1 st2 (ExpectedToken "string") "string"
          )
    )

-- 只有顶层签名允许 trait 约束 `C a =>`。其它签名位置（axiom / where / let /
-- trait 方法 / 构造子 / 记录字段）见到 `=>` 时直接给出明确诊断，而不是让 `=>` 作为
-- 残留 token 触发难懂的收尾错误。
rejectCtxSuffix : PState -> Check PState
rejectCtxSuffix st = if atSym st "=>" then ps0 st ConstraintUnsupportedHere else OkC st

-- 顶层签名：`name : [C1 a, C2 b =>] τ`。`allowCtx=False` 供 instance 方法签名复用同一
-- 解析入口（instance 方法的约束由实例 ctx 提供，签名上写 `=>` 报明确诊断）。
parseSignature : PState -> Int -> Bool -> String -> DeclStart -> Check (Decl, PState)
parseSignature st blockCol allowCtx name ds =
  Vuna.Compiler.Base.Common.bind (expectSym st ":") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (parseCtxThenExpr (stateFuel st1) st1 blockCol) (
            \hc, st2 =>
              case hc of
                (ctx, ty) =>
                  case ctx of
                    [] => OkC (DSig name [] ty (declRefAt st ds st2), st2)
                    _ => if allowCtx then OkC (DSig name ctx ty (declRefAt st ds st2), st2) else ps0 st1 ConstraintUnsupportedHere
          )
    )

parseClause : PState -> Int -> String -> DeclStart -> Check (Decl, PState)
parseClause st blockCol name ds =
  Vuna.Compiler.Base.Common.step (parseClausePatterns (stateFuel st) st blockCol) (
      \pats, st1 =>
        Vuna.Compiler.Base.Common.bind (checkBindersAt st pats) (
            \_ =>
              Vuna.Compiler.Base.Common.bind (expectSym st1 "=") (
                  \st2 =>
                    Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 blockCol) (
                        \body, st3 =>
                          Vuna.Compiler.Base.Common.step (parseWhere st3 blockCol) (
                              \wheres, st4 =>
                                let
                                  body2 =
                                    case wheres of
                                      [] => body
                                      _ :: _ => ELet wheres body True (detachedNodeRef (spanOf st st4))
                                in OkC (DFun name pats body2 (declRefAt st ds st4), st4)
                            )
                      )
                )
          )
    )

-- where 块：`body where\n  <bindings>`，解析后 desugar 成 ELet（绑定对 body 可见）。
--
-- ---------------------------------------------------------------
-- 绑定块（统一作用域模型）：`where` 与 `let` 共用同一套绑定块解析：
--   * 每个绑定可先写一行签名 `name : Ty`（必须写在同名子句**之前**）；
--   * 子句可以是 `pat = expr` 或函数子句 `name pats = expr`（降级成 λ）。
-- 有签名的绑定把签名行存进 `Binding.bindSig`（`BindingSig` 自带签名行的树节点），
-- Elab 据此在 checking 模式精化该值。两条记法只差一条：`where` 块**要求**每个绑定都有
-- 签名行（由 Elab 的 `checkBindingSigs` 用一个诊断收口），`let` 的签名是可选的。
-- ---------------------------------------------------------------
parseWhere : PState -> Int -> Check (List Binding, PState)
parseWhere st blockCol =
  case peekTok st of
    PTok (TKw "where") p =>
      if posCol p > blockCol then
        Vuna.Compiler.Base.Common.step
          (OkC (0, advance st))
          (\_, st1 => Vuna.Compiler.Base.Common.step (parseWhereBindings st1 blockCol) (\binds, st2 => OkC (binds, st2)))
      else
        OkC ([], st)
    _ => OkC ([], st)

parseWhereBindings : PState -> Int -> Check (List Binding, PState)
parseWhereBindings st whereCol =
  if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col > whereCol then Vuna.Compiler.Base.Common.step (parseBindingItemsAt (stateFuel st) st col) (\items, st1 => Vuna.Compiler.Base.Common.bind (bindingItemsToBinds items) (\binds => OkC (binds, st1))) else OkC ([], st)

-- 绑定块的条目：签名行或一条绑定（`pat = expr` / `name pats = expr`）。
data BindingItem : Type where
  BISig : String -> Expr -> NodeRef -> BindingItem
  BIBind : Binding -> BindingItem

parseBindingItemsAt : Int -> PState -> Int -> Check (List BindingItem, PState)
parseBindingItemsAt fuel st bindCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC ([], st)
  else if atKw st "in" then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col == bindCol then Vuna.Compiler.Base.Common.step (parseBindingItem (fuel - 1) st bindCol) (\item, st1 => Vuna.Compiler.Base.Common.step (parseBindingItemsAt (fuel - 1) st1 bindCol) (\rest, st2 => OkC ((::) item rest, st2))) else if col > bindCol then ps0 st UnexpectedIndentInBinding else OkC ([], st)

parseBindingItem : Int -> PState -> Int -> Check (BindingItem, PState)
parseBindingItem fuel st bindCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    withExtent CstBindingKind semBindingItem st (\st0 => parseBindingItemBody fuel st0 bindCol)

parseBindingItemBody : Int -> PState -> Int -> Check (BindingItem, PState)
parseBindingItemBody fuel st bindCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      -- `name : Ty` 是签名行，**不是**模式：名字按 binder 直接读，不建 `pat` 节点
      -- （签名行在树里只有 `binding` 节点；模式节点留给定义行 / case 分支等真模式）。
      -- 签名行的身份就是该 `binding` 节点的 id（入口处的 `openNodeId`）。
      PTok (TIdent name) _ =>
        if name == "_" then
          parseBindingPattern fuel st bindCol
        else
          case peekTokAt st 1 of
            Just (PTok (TSym ":") _) => Vuna.Compiler.Base.Common.bind (expectSym (advance st) ":") (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 bindCol) (\ty, st2 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st2) (\st3 => OkC (BISig name ty (NodeRef st.openNodeId (spanOf st st3)), st3))))
            _ => parseBindingPattern fuel st bindCol
      _ => parseBindingPattern fuel st bindCol

-- 绑定项里的模式（`pat = expr` / `name pats = expr`）。
parseBindingPattern : Int -> PState -> Int -> Check (BindingItem, PState)
parseBindingPattern fuel st bindCol =
  Vuna.Compiler.Base.Common.step
    (parsePatternSingle (stateFuel st) st bindCol)
    (\pat, st1 => parseBindingDef (fuel - 1) st st1 bindCol pat)

-- 单条绑定：`pat = expr` 或函数子句 `name pats = expr`（desugar 成 λ）。
parseBindingDef : Int -> PState -> PState -> Int -> Pat -> Check (BindingItem, PState)
parseBindingDef fuel stStart st bindCol pat =
  if fuel <= 0 then
    icFuel "parser"
  else
    case pat of
      PVar name _ => if startsPatternAtom st && canContinue st bindCol then Vuna.Compiler.Base.Common.step (parseClausePatterns (stateFuel st) st bindCol) (\pats, st2 => Vuna.Compiler.Base.Common.bind (checkBindersAt st pats) (\_ => Vuna.Compiler.Base.Common.bind (expectSym st2 "=") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st3 bindCol) (\value, st4 => OkC (BIBind (Binding (PVar name (patRef pat)) (BClauses [LocalClause pats value (NodeRef stStart.openNodeId (spanOf stStart st4)) (patRef pat)]) Nothing (NodeRef stStart.openNodeId (spanOf stStart st4))), st4))))) else Vuna.Compiler.Base.Common.step (parseBindingValue (fuel - 1) stStart st stStart.openNodeId pat bindCol) (\b, st2 => OkC (BIBind b, st2))
      _ => Vuna.Compiler.Base.Common.step (parseBindingValue (fuel - 1) stStart st stStart.openNodeId pat bindCol) (\b, st2 => OkC (BIBind b, st2))

parseBindingValue : Int -> PState -> PState -> Int -> Pat -> Int -> Check (Binding, PState)
parseBindingValue fuel stStart st nid pat blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (checkBindersAt st [pat])
      (\_ => Vuna.Compiler.Base.Common.bind (expectSym st "=") (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\value, st2 => OkC ((Binding pat (BVal value) Nothing (NodeRef nid (spanOf stStart st2))), st2))))

-- 条目 → ELet 绑定：把签名行存进同名定义的 `Binding.bindSig`，并校验布局约束：
-- 签名必须先于同名定义、不能重复、不能悬空。
bindingItemsToBinds : List BindingItem -> Check (List Binding)
bindingItemsToBinds items = bindingBindsGo items [] [] []

bindingBindsGo : List BindingItem -> List (String, Expr, NodeRef) -> List String -> List Binding -> Check (List Binding)
bindingBindsGo [] sigs bound acc =
  case firstDanglingSig (reverse sigs) bound of
    Nothing => OkC (reverse acc)
    Just (name, sp) =>
      ErrC
        (withLabel (Label (Just (nodeRefSpan sp)) "" LabelPrimary Nothing) (psMsg (WhereSigNoDef name) [name]))
bindingBindsGo (item :: rest) sigs bound acc =
  case item of
    BISig name ty sp =>
      if memName name bound then
        ErrC
          (withLabel (Label (Just (nodeRefSpan sp)) "" LabelPrimary Nothing) (psMsg (WhereSigBeforeClause name) [name]))
      else if hasBindingSig name sigs then
        ErrC
          (withLabel (Label (Just (nodeRefSpan sp)) "" LabelPrimary Nothing) (psMsg (WhereSigDuplicate name) [name]))
      else
        bindingBindsGo rest ((name, ty, sp) :: sigs) bound acc
    BIBind binding =>
      case localFunMerge (patBoundName binding.bindPat) binding.bindValue acc of
        Just merged => bindingBindsGo rest sigs bound merged
        Nothing =>
          case bindingSigOf (patBoundName binding.bindPat) sigs of
            Just (ty, sp) =>
              if memName (patBoundName binding.bindPat) bound then
                ErrC
                  (withLabel (Label (Just (nodeRefSpan sp)) "" LabelPrimary Nothing) (psMsg (WhereSigMultiClause (patBoundName binding.bindPat)) [patBoundName binding.bindPat]))
              else
                bindingBindsGo
                  rest
                  sigs
                  (patBoundName binding.bindPat :: bound)
                  (Binding binding.bindPat binding.bindValue (Just (BindingSig ty sp)) binding.bindRef :: acc)
            Nothing =>
              bindingBindsGo rest sigs (patBoundName binding.bindPat :: bound) (binding :: acc)

-- 把相邻同名函数子句合并成一个 `BClauses` 绑定（where/let 多 clause）。
-- 签名保留在合并后的条目上（`Binding.bindSig` 挂在第一条的 `BClauses` 旁）；不连续的同名子句
-- 不合并，按 `WhereSigMultiClause` 报错。
localFunMerge : String -> BindingValue -> List Binding -> Maybe (List Binding)
localFunMerge name value (binding :: rest) =
  case binding.bindPat of
    PVar n nsp =>
      if n == name then
        case binding.bindValue of
          BClauses cs0 =>
            case value of
              BClauses cs1 => Just ((::) (Binding (PVar n nsp) (BClauses (append cs0 cs1)) binding.bindSig binding.bindRef) rest)
              _ => Nothing
          _ => Nothing
      else
        Nothing
    _ => Nothing
localFunMerge name value _ = Nothing

-- 绑定名（非简单变量绑定返回空串，永远匹配不到签名）。
patBoundName : Pat -> String
patBoundName (PVar name _) = name
patBoundName _ = ""

bindingSigOf : String -> List (String, Expr, NodeRef) -> Maybe (Expr, NodeRef)
bindingSigOf name [] = Nothing
bindingSigOf name ((n, v) :: rest) = if n == name then Just v else bindingSigOf name rest

hasBindingSig : String -> List (String, Expr, NodeRef) -> Bool
hasBindingSig name sigs =
  case bindingSigOf name sigs of
    Just _ => True
    Nothing => False

firstDanglingSig : List (String, Expr, NodeRef) -> List String -> Maybe (String, NodeRef)
firstDanglingSig [] bound = Nothing
firstDanglingSig ((name, ty, sp) :: rest) bound =
  if memName name bound then firstDanglingSig rest bound else Just (name, sp)

-- λ 参数名：绑定块里的函数子句参数必须是简单变量名（模式版本见 parseBindingDef）。
parseClausePatterns : Int -> PState -> Int -> Check (List Pat, PState)
parseClausePatterns fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if startsPatternAtom st && canContinue st blockCol then
    Vuna.Compiler.Base.Common.step
      (parsePatternAtom (stateFuel st) st blockCol)
      (\pat, st1 => Vuna.Compiler.Base.Common.step (parseClausePatterns (fuel - 1) st1 blockCol) (\rest, st2 => OkC ((::) pat rest, st2)))
  else
    OkC ([], st)

-- `lin data ...` / `lin record ...`。`linear` 的位置作为 `ds`，声明 span 从这里开始。
parseLinearDecl : PState -> Int -> DeclStart -> Check (Decl, PState)
parseLinearDecl st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "linear") (
      \st1 =>
        case peekTok st1 of
          PTok (TKw "data") _ => parseData True st1 blockCol ds
          PTok (TKw "record") _ => parseRecord True ReprAuto st1 blockCol ds
          _ => ps1 st1 (ExpectedToken "data/record") "data/record"
    )

-- | 软关键字 `alias` / `boxed`：后面必须跟 `record` 或 `linear record` 才按档位前缀解析；
-- 否则退化成普通标识符（现有源码里的 `alias` binder 就是靠这条保持可用）。
tierFollows : PState -> Bool
tierFollows st =
  case peekTok (advance st) of
    PTok (TKw "record") _ => True
    PTok (TKw "linear") _ =>
      case peekTok (advance (advance st)) of
        PTok (TKw "record") _ => True
        _ => False
    _ => False

-- | `alias record ...` / `boxed record ...`（可再带 `lin`）。
-- 档位前缀的位置作为 `ds`，声明 span 从这里开始；档位只对 record 有意义（对 data 报错）。
parseTieredDecl : ReprTier -> PState -> Int -> DeclStart -> Check (Decl, PState)
parseTieredDecl tier st blockCol ds =
  case peekTok (advance st) of
    PTok (TKw "linear") _ =>
      let
        st1 = advance (advance st)
      in case peekTok st1 of
        PTok (TKw "record") _ => parseRecord True tier st1 blockCol ds
        _ => ps1 st1 (ExpectedToken "record") "record"
    PTok (TKw "record") _ => parseRecord False tier (advance st) blockCol ds
    _ => ps1 (advance st) (ExpectedToken "record") "record"

parseData : Bool -> PState -> Int -> DeclStart -> Check (Decl, PState)
parseData lin st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "data") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (expectIdent st1) (
            \name, st2 =>
              Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (
                  \params, st3 =>
                    Vuna.Compiler.Base.Common.bind (expectSym st3 ":") (
                        \st4 =>
                          Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st4) st4 blockCol) (
                              \ty, st5 =>
                                Vuna.Compiler.Base.Common.bind (expectKw st5 "where") (
                                    \st6 =>
                                      Vuna.Compiler.Base.Common.step (parseCtors st6 blockCol) (
                                          \ctors, st7 =>
                                            Vuna.Compiler.Base.Common.step (parseDeriving st7) (
                                                \dv, st8 =>
                                                  case dv of
                                                    (derivings, via) => OkC (DData name params ty ctors derivings via ReprAuto lin (declRefAt st ds st8), st8)
                                              )
                                        )
                                  )
                            )
                      )
                )
          )
    )

-- 记录声明：`record Name params where` + 缩进字段 `f : Ty`，可跟 deriving。
-- 第二参数是表示档位（`alias`/`boxed` 前缀给出，缺省 `ReprAuto`）。
parseRecord : Bool -> ReprTier -> PState -> Int -> DeclStart -> Check (Decl, PState)
parseRecord lin tier st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "record") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (expectIdent st1) (
            \name, st2 =>
              Vuna.Compiler.Base.Common.step (parseParams (stateFuel st2) st2) (
                  \params, st3 =>
                    Vuna.Compiler.Base.Common.bind (expectKw st3 "where") (
                        \st4 =>
                          Vuna.Compiler.Base.Common.step (parseFields st4 blockCol) (
                              \fields, st5 =>
                                Vuna.Compiler.Base.Common.step (parseDeriving st5) (
                                    \dv, st6 =>
                                      case dv of
                                        (derivings, via) => OkC (DRecord name params fields derivings via tier lin (declRefAt st ds st6), st6)
                                  )
                            )
                      )
                )
          )
    )

parseFields : PState -> Int -> Check (List Field, PState)
parseFields st blockCol =
  if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col > blockCol then parseFieldList (stateFuel st) st col else OkC ([], st)

parseFieldList : Int -> PState -> Int -> Check (List Field, PState)
parseFieldList fuel st fieldCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col == fieldCol then Vuna.Compiler.Base.Common.step (parseField st fieldCol) (\fld, st1 => Vuna.Compiler.Base.Common.step (parseFieldList (fuel - 1) st1 fieldCol) (\rest, st2 => OkC ((::) fld rest, st2))) else if col > fieldCol then ps0 st UnexpectedIndentInRecord else OkC ([], st)

-- | 一个记录字段（`name : Ty`）；单独成节点是因为注释可以挂在字段上。
parseField : PState -> Int -> Check (Field, PState)
parseField st fieldCol =
  withExtent CstFieldKind semField st (\st0 => parseFieldBody st0 fieldCol st0.openNodeId)

parseFieldBody : PState -> Int -> Int -> Check (Field, PState)
parseFieldBody st fieldCol nid =
  Vuna.Compiler.Base.Common.step
    (expectIdent st)
    (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ":") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 fieldCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st3) (\st3b => OkC (Field name ty (NodeRef nid (spanOf st st3)), st3b)))))

-- `deriving via field (C...)` 的 `via`/`field` 是上下文标识符，不进关键字表。
-- | 当前 token 是否是指定名字的标识符（`via`/`field` 等上下文关键字用）。
atIdentName : PState -> String -> Bool
atIdentName st name =
  case peekTok st of
    PTok (TIdent n) _ => n == name
    _ => False

-- deriving (TraitA, TraitB) 或 deriving via field (TraitA, TraitB)；
-- 可出现在 data/record 的构造器/字段块之后（strategy 只能用于 record）。
parseDeriving : PState -> Check ((List String, Bool), PState)
parseDeriving st =
  if atKw st "deriving" then
    Vuna.Compiler.Base.Common.bind
      (expectKw st "deriving")
      (\st1 => if atIdentName st1 "via" then Vuna.Compiler.Base.Common.step (expectIdent st1) (\_, st2 => Vuna.Compiler.Base.Common.step (expectIdent st2) (\fld, st3 => if fld == "field" then parseDerivingParens True st3 else ps1 st2 (ExpectedToken "field") "field")) else parseDerivingParens False st1)
  else
    OkC (([], False), st)

-- | 解析 `deriving` 后的 `(TraitA, TraitB)` 括号列表；`via` 标志原样带回结果。
parseDerivingParens : Bool -> PState -> Check ((List String, Bool), PState)
parseDerivingParens via st =
  Vuna.Compiler.Base.Common.bind
    (expectSym st "(")
    (\st1 => if atSym st1 ")" then OkC (([], via), advance st1) else Vuna.Compiler.Base.Common.step (parseDerivingNames (stateFuel st1) st1) (\names, st2 => OkC ((names, via), st2)))

parseDerivingNames : Int -> PState -> Check (List String, PState)
parseDerivingNames fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (expectIdent st)
      (\name, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseDerivingNames (fuel - 1) (advance st1)) (\rest, st2 => OkC ((::) name rest, st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC ([name], st2)))

-- trait 声明：`trait [supers =>] Name params where` + 缩进方法签名 `m : Ty`。
-- 多参数 trait 参数可带显式 kind：`trait C (a : Type) (r : Row)`（裸参数仍支持）。
parseTrait : PState -> Int -> DeclStart -> Check (Decl, PState)
parseTrait st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "trait") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (parseTraitHead st1) (
            \h, st2 =>
              Vuna.Compiler.Base.Common.bind (expectKw st2 "where") (
                  \st3 =>
                    Vuna.Compiler.Base.Common.step (parseMethodSigs st3 blockCol) (
                        \methods, st4 =>
                          let
                            decl = DTrait h.traitHeadName h.traitHeadParams h.traitHeadSupers methods (declRefAt st ds st4)
                          in OkC (decl, st4)
                      )
                )
          )
    )

-- trait 参数：裸标识符（kind 由方法签名推断）或 `(a b : Kind)` / `(a : Kind)`。
parseTraitParams : Int -> PState -> Check (List TraitParam, PState)
parseTraitParams fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent name) _ => Vuna.Compiler.Base.Common.step (parseTraitParams (fuel - 1) (advance st)) (\rest, st1 => OkC ((::) (TraitParam name Nothing) rest, st1))
      PTok (TSym "(") _ => if parenIsMemberList st then OkC ([], st) else Vuna.Compiler.Base.Common.bind (expectSym st "(") (\st1 => Vuna.Compiler.Base.Common.step (parsePiNames (fuel - 1) st1) (\names, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 ":") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st3) st3 0) (\kind, st4 => Vuna.Compiler.Base.Common.bind (expectSym st4 ")") (\st5 => Vuna.Compiler.Base.Common.step (parseTraitParams (fuel - 1) st5) (\rest, st6 => OkC (append (map (\n => TraitParam n (Just kind)) names) rest, st6)))))))
      _ => OkC ([], st)

parseMethodSigs : PState -> Int -> Check (List TraitMethod, PState)
parseMethodSigs st blockCol =
  if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col > blockCol then parseMethodSigList (stateFuel st) st col else OkC ([], st)

parseMethodSigList : Int -> PState -> Int -> Check (List TraitMethod, PState)
parseMethodSigList fuel st methodCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col == methodCol then Vuna.Compiler.Base.Common.step (parseMethodSig st methodCol) (\m, st1 => Vuna.Compiler.Base.Common.step (parseMethodSigList (fuel - 1) st1 methodCol) (\rest, st2 => OkC ((::) m rest, st2))) else if col > methodCol then ps0 st UnexpectedIndentInTrait else OkC ([], st)

-- | 一条 trait 方法签名（`m : Ty`）；单独成节点是因为注释可以挂在方法上。
parseMethodSig : PState -> Int -> Check (TraitMethod, PState)
parseMethodSig st methodCol =
  withExtent CstMethodKind semMethod st (\st0 => parseMethodSigBody st0 methodCol st0.openNodeId)

parseMethodSigBody : PState -> Int -> Int -> Check (TraitMethod, PState)
parseMethodSigBody st methodCol nid =
  Vuna.Compiler.Base.Common.step
    (expectDeclName st)
    (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ":") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 methodCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st3) (\st3b => OkC (TraitMethod name ty (NodeRef nid (spanOf st st3)), st3b)))))

-- instance 声明：`instance [<ctx> ,... =>] Head where` + 缩进方法定义。
-- ctx 是逗号分隔的字典约束（每个形如 `C arg`；只支持单参数 trait）。
-- 实例头与顶层签名共用「[ctx , ... =>] expr」解析（ctx 为空 = 无约束）。
parseInstance : PState -> Int -> DeclStart -> Check (Decl, PState)
parseInstance st blockCol ds =
  Vuna.Compiler.Base.Common.bind (expectKw st "instance") (
      \st1 =>
        Vuna.Compiler.Base.Common.step (parseCtxThenExpr (stateFuel st1) st1 blockCol) (
            \hc, st2 =>
              case hc of
                (ctxE, head) => parseInstanceTail ctxE head st blockCol ds st2
          )
    )

parseInstanceTail : List Expr -> Expr -> PState -> Int -> DeclStart -> PState -> Check (Decl, PState)
parseInstanceTail ctxE head st blockCol ds st2 =
  Vuna.Compiler.Base.Common.bind
    (expectKw st2 "where")
    (\st3 => Vuna.Compiler.Base.Common.step (parseInstanceBody st3 blockCol) (\methods, st4 => OkC (DInstance ctxE head methods (declRefAt st ds st4), st4)))

parseCtxThenExpr : Int -> PState -> Int -> Check ((List Expr, Expr), PState)
parseCtxThenExpr fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseExpr fuel st blockCol)
      (\e1, st1 => if atSym st1 "=>" then Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (advance st1) blockCol) (\hd, st2 => OkC (ctxThenSplit e1 hd, st2)) else if atSym st1 "," then parseCtxRest (fuel - 1) (advance st1) [e1] blockCol else OkC (([], e1), st1))

-- `{a b : Type} -> Convert a b => ...`：显式 Pi 前缀写在约束之前时，把 Pi 链搬到
-- 返回类型上，约束本身作为 ctx（与 `Convert a b => ...` 自由名量化的结果同一形态）。
-- 只在 e1 是 Pi 表达式时触发；普通约束 `Eq a` 原样保留。
ctxThenSplit : Expr -> Expr -> (List Expr, Expr)
ctxThenSplit (EPi n i q d c sp) hd =
  ([innermostPiCod (EPi n i q d c sp)], replacePiCod (EPi n i q d c sp) hd)
ctxThenSplit e1 hd = ([e1], hd)

innermostPiCod : Expr -> Expr
innermostPiCod (EPi n i q d c _) = innermostPiCod c
innermostPiCod e = e

replacePiCod : Expr -> Expr -> Expr
replacePiCod (EPi n i q d c sp) new = EPi n i q d (replacePiCod c new) sp
replacePiCod e new = new

-- ctx 列表的剩余部分：`e , e ... => head`。
parseCtxRest : Int -> PState -> List Expr -> Int -> Check ((List Expr, Expr), PState)
parseCtxRest fuel st acc blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "=>" then
    Vuna.Compiler.Base.Common.step
      (parseExpr (fuel - 1) (advance st) blockCol)
      (\hd, st1 => OkC ((reverse acc, hd), st1))
  else
    Vuna.Compiler.Base.Common.step
      (parseExpr fuel st blockCol)
      (\e, st1 => if atSym st1 "," then parseCtxRest (fuel - 1) (advance st1) (e :: acc) blockCol else Vuna.Compiler.Base.Common.bind (expectSym st1 "=>") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (\hd, st3 => OkC ((reverse (e :: acc), hd), st3))))

parseInstanceBody : PState -> Int -> Check (List Decl, PState)
parseInstanceBody st blockCol =
  if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col > blockCol then parseInstanceDeclList (stateFuel st) st col else OkC ([], st)

parseInstanceDeclList : Int -> PState -> Int -> Check (List Decl, PState)
parseInstanceDeclList fuel st declCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col == declCol then Vuna.Compiler.Base.Common.step (parseInstanceDecl st declCol) (\decl, st1 => Vuna.Compiler.Base.Common.step (parseInstanceDeclList (fuel - 1) st1 declCol) (\rest, st2 => OkC ((::) decl rest, st2))) else if col > declCol then ps0 st UnexpectedIndentInInstance else OkC ([], st)

parseInstanceDecl : PState -> Int -> Check (Decl, PState)
parseInstanceDecl st blockCol =
  if instanceMethodStart st then
    withExtent
      CstDeclKind
      semDecl
      st
      (\st0 => parseInstanceDeclBody st0 blockCol (DeclStart st0.openNodeId (peekPos st0)))
  else
    ps0 st ExpectedInstanceMethod

parseInstanceDeclBody : PState -> Int -> DeclStart -> Check (Decl, PState)
parseInstanceDeclBody st blockCol ds =
  if instanceMethodStart st then
    Vuna.Compiler.Base.Common.step
      (expectDeclName st)
      (\name, st1 => if atSym st1 ":" then parseSignature st1 blockCol False name ds else parseClause st1 blockCol name ds)
  else
    ps0 st ExpectedInstanceMethod

-- instance 方法名：标识符、`(sym)`、裸符号；其它 token 仍走 `ExpectedInstanceMethod`。
instanceMethodStart : PState -> Bool
instanceMethodStart st =
  case peekTok st of
    PTok (TIdent _) _ => True
    PTok (TSym "(") _ =>
      case peekTokAt st 1 of
        Just (PTok (TSym sym) _) =>
          case peekTokAt st 2 of
            Just (PTok (TSym ")") _) => not (isReservedValueName sym)
            _ => False
        _ => False
    PTok (TSym sym) _ => not (isReservedValueName sym)
    _ => False

parseParams : Int -> PState -> Check (List String, PState)
parseParams fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent name) p => Vuna.Compiler.Base.Common.step (parseParams (fuel - 1) (advance st)) (\rest, st1 => OkC ((::) name rest, st1))
      _ => OkC ([], st)

parseCtors : PState -> Int -> Check (List Ctor, PState)
parseCtors st blockCol =
  if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col > blockCol then parseCtorList (stateFuel st) st col else OkC ([], st)

parseCtorList : Int -> PState -> Int -> Check (List Ctor, PState)
parseCtorList fuel st ctorCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col == ctorCol then Vuna.Compiler.Base.Common.step (parseCtor st ctorCol) (\ctor, st1 => Vuna.Compiler.Base.Common.step (parseCtorList (fuel - 1) st1 ctorCol) (\rest, st2 => OkC ((::) ctor rest, st2))) else if col > ctorCol then ps0 st UnexpectedIndentInData else OkC ([], st)

-- | 一个构造器（`Name : Ty`）；单独成节点是因为注释可以挂在构造器上。
parseCtor : PState -> Int -> Check (Ctor, PState)
parseCtor st ctorCol =
  withExtent CstCtorKind semCtor st (\st0 => parseCtorBody st0 ctorCol st0.openNodeId)

parseCtorBody : PState -> Int -> Int -> Check (Ctor, PState)
parseCtorBody st ctorCol nid =
  Vuna.Compiler.Base.Common.step
    (expectDeclName st)
    (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 ":") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (stateFuel st2) st2 ctorCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (rejectCtxSuffix st3) (\st3b => OkC (Ctor name ty (countArrows ty) (NodeRef nid (spanOf st st3)), st3b)))))

-- | 一个表达式的建树节点（嵌套表达式各自成节点，区间由递归配对）。
parseExpr : Int -> PState -> Int -> Check (Expr, PState)
parseExpr fuel st blockCol =
  withExtent
    CstExprKind
    semExpr
    st
    (\st0 => Vuna.Compiler.Base.Common.step (parseExprBody fuel st0.openNodeId st0 blockCol) (\e, st1 => OkC (withExprId st0.openNodeId e, rekeyInfix (nodeRefId (exprRef e)) st0.openNodeId st1)))

parseExprBody : Int -> Int -> PState -> Int -> Check (Expr, PState)
parseExprBody fuel nid st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    ps0 st UnexpectedEndOfInput
  else if canContinue st blockCol then
    Vuna.Compiler.Base.Common.step
      (parseLhs (fuel - 1) st blockCol)
      (\lhs, st1 => parseInfix (fuel - 1) nid st1 blockCol lhs)
  else
    ps0 st ExprNotIndented

-- 优先级/结合性不在 parser 决定——中缀链按源码顺序**右嵌套**，但降级成普通应用
-- `EApp (EVar op) [lhs, rhs]`；「这一层是链步、是否反引号」记进表面形状（按区间根 id），
-- Loader 按 `infix*` 声明重排、Fmt 按源码顺序打印时都读它。
parseInfix : Int -> Int -> PState -> Int -> Expr -> Check (Expr, PState)
parseInfix fuel nid st blockCol lhs =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      -- 反引号中缀 `` a `f` b ``。名字是普通值名或符号名（expectValueName）；
      -- rhs 用 parseExpr（与普通中缀一致，会继续吞后续中缀），形成右嵌套链交给 Loader 重排。
      PTok (TSym "`") p => if canContinue st blockCol then Vuna.Compiler.Base.Common.step (expectValueName (advance st)) (\name, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 "`") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (\rhs, st3 => parseInfix (fuel - 1) nid (addBacktickShape nid st3) blockCol (EApp (EVar name (detachedNodeRef (tokenSpan (advance st)))) [lhs, rhs] (detachedNodeRef (spanOf st st3)))))) else OkC (lhs, st)
      PTok (TSym op) p =>
        if canContinue st blockCol && not (isSyntaxSym op) then
          if closeParenNext st then
            withExtent CstExprKind semExpr st (
                \st0 =>
                  let
                    -- 右 section 的语法节点只覆盖运算符：操作数 `lhs` 已有自己的子树，`)` 由外层
                    -- `(` 分支消费。节点 span 从这里开始，与 section 写法的登记键（运算符起点）一致。
                    sp = spanOf st0 (advance st0)
                  in OkC (sectionRightExpr op lhs (NodeRef st0.openNodeId sp), addSectionShape (spanStartOffset sp) (SectionRight op) (advance st0))
              )
          else
            Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (advance st) blockCol) (\rhs, st2 => parseInfix (fuel - 1) nid st2 blockCol (EApp (EVar op (detachedNodeRef (tokenSpan st))) [lhs, rhs] (detachedNodeRef (spanOf st st2))))
        else
          OkC (lhs, st)
      -- 右 section `(e op)`。只消费 op；`)` 由外层 `(` 分支消费。
      _ => OkC (lhs, st)

parseLhs : Int -> PState -> Int -> Check (Expr, PState)
parseLhs fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TSym "\\") p => parseLambda (fuel - 1) st blockCol
      PTok (TKw "let") p => parseLet (fuel - 1) st blockCol
      PTok (TKw "case") p => parseCase (fuel - 1) st blockCol
      PTok (TKw "if") p => parseIf (fuel - 1) st blockCol
      PTok (TKw "do") p => parseDo (fuel - 1) st blockCol
      PTok (TKw "perform") p => parsePerform (fuel - 1) st blockCol
      PTok (TKw "handle") p => parseHandle (fuel - 1) st blockCol
      -- 一元负号：前缀位置才成立（表达式开头 / 运算符后 / `(` 等之后），所以 `f - 1`
      -- 仍是减法。字面量直接成为负字面量；其它表达式走 `negate`。
      PTok (TSym "-") p => parseNegation (fuel - 1) st blockCol
      _ => parseApplication (fuel - 1) st blockCol

parseNegation : Int -> PState -> Int -> Check (Expr, PState)
parseNegation fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTokAt st 1 of
      Just (PTok (TInt n) _) => OkC (EInt (0 - n) (detachedNodeRef (spanOf st (advance (advance st)))), advance (advance st))
      Just (PTok (TFloat raw) _) => OkC (EFloat ("-" ++ raw) (detachedNodeRef (spanOf st (advance (advance st)))), advance (advance st))
      _ => Vuna.Compiler.Base.Common.step (parseApplication (fuel - 1) (advance st) blockCol) (\e, st1 => OkC (EApp (EVar "negate" (detachedNodeRef (spanOf st (advance st)))) [e] (detachedNodeRef (spanOf st st1)), st1))

parseApplication : Int -> PState -> Int -> Check (Expr, PState)
parseApplication fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step (parseAtom (fuel - 1) st blockCol) (
        \first, st1 =>
          if atSym st1 "@" then
            Vuna.Compiler.Base.Common.step (parseAtPayload (fuel - 1) (advance st1) blockCol) (\payload, st2 => Vuna.Compiler.Base.Common.step (parseArgs (fuel - 1) st2 blockCol) (\args, st3 => OkC (EApp (EVar (reservedText RsAppAt) (detachedNodeRef (spanOf st st3))) (first :: payload :: args) (detachedNodeRef (spanOf st st3)), st3)))
          else
            Vuna.Compiler.Base.Common.step (parseArgs (fuel - 1) st1 blockCol) (
                \args, st2 =>
                  case args of
                    [] => OkC (first, st2)
                    _ =>
                      let
                        app = EApp first args (detachedNodeRef (spanOf st st2))
                      in if atSym st2 "@" then Vuna.Compiler.Base.Common.step (parseAtPayload (fuel - 1) (advance st2) blockCol) (\payload, st3 => OkC (EApp (EVar (reservedText RsRowAt) (detachedNodeRef (spanOf st st3))) [app, payload] (detachedNodeRef (spanOf st st3)), st3)) else OkC (app, st2)
              )
      )

-- `@` 后面的 payload 与行 `@` 同一规则：裸标识符是名字字面量，字符串/数字/括号表达式原样。
-- 「是不是裸标识符」看**源码书写形态**：括号在 AST 里不建节点（见 `Frontend.Cst`），
-- 所以必须在解析前用当前 token 判定，否则 `@(n)` 会被当成名字字面量 `n`。
parseAtPayload : Int -> PState -> Int -> Check (Expr, PState)
parseAtPayload fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseAtom (fuel - 1) st blockCol)
      (\e, st1 => OkC (if atSym st "(" then e else rowAtNameExpr e, st1))

spanFromExpr : Expr -> PState -> Span
spanFromExpr e st2 =
  let
    sp = exprSpan e
    p1 = lastPos st2
  in Span
    sp.spanFile
    (spanStartLine sp)
    (spanStartCol sp)
    (posLine p1)
    (lastEndCol p1)
    (spanStartOffset sp)
    (posEndOffset p1)

parseArgs : Int -> PState -> Int -> Check (List Expr, PState)
parseArgs fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if startsAtom st && canContinue st blockCol then
    Vuna.Compiler.Base.Common.step
      (parseAtom (fuel - 1) st blockCol)
      (\arg, st1 => Vuna.Compiler.Base.Common.step (parseArgs (fuel - 1) st1 blockCol) (\rest, st2 => OkC ((::) arg rest, st2)))
  else
    OkC ([], st)

parseAtom : Int -> PState -> Int -> Check (Expr, PState)
parseAtom fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseAtomBase (fuel - 1) st blockCol)
      (\base, st1 => parseFieldSuffix (stateFuel st1) st1 blockCol base)

-- 字段访问后缀：`e.f` / `(e).f`；`p.x` 因 lexer 合成单 token 由 loader 拆分。
parseFieldSuffix : Int -> PState -> Int -> Expr -> Check (Expr, PState)
parseFieldSuffix fuel st blockCol base =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "." then
    Vuna.Compiler.Base.Common.bind
      (expectSym st ".")
      (\st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\fname, st2 => parseFieldSuffix (fuel - 1) st2 blockCol (EField base fname (detachedNodeRef (spanFromExpr base st2)))))
  else
    OkC (base, st)

-- 内置宏调用：`name!` 的 `!` 必须与标识符**紧邻**（同行且列号连续）。带空格的
-- `a ! b` 仍是普通中缀运算符，`!=` / `!!` 等更长的符号 token 也不触发。
-- | `name` 后是否紧跟同一行的 `!`（列号连续才算宏调用；空格分隔的 `!` 仍是中缀）。
macroBangAt : PState -> Pos -> String -> Bool
macroBangAt st start name =
  case peekTok st of
    PTok (TSym "!") p => posLine p == posLine start && posCol p == posCol start + strLength name
    _ => False

-- | 宏原子：无实参时是裸标记 `EVar`（交给展开期报 arity），有实参时是标记应用。
macroAtom : String -> List Expr -> Span -> Span -> Expr
macroAtom name [] appSp headSp = EVar (reservedText (RsMacro name)) (detachedNodeRef headSp)
macroAtom name args appSp headSp =
  EApp (EVar (reservedText (RsMacro name)) (detachedNodeRef headSp)) args (detachedNodeRef appSp)

-- | 一次宏调用（`name! args...`）：整段是树的 `macro` 节点，载荷记名字与实参个数。
-- AST 仍是 `EVar` / `EApp` 的保留名标记（没有宏构造子），节点身份只服务语法层工具。
parseMacroAtom : Int -> PState -> Int -> String -> Check (Expr, PState)
parseMacroAtom fuel st blockCol name =
  withExtent
    CstMacroKind
    semMacroAtom
    st
    (\st0 => Vuna.Compiler.Base.Common.bind (expectSym (advance st0) "!") (\st1 => Vuna.Compiler.Base.Common.step (parseArgs fuel st1 blockCol) (\args, st2 => OkC (macroAtom name args (spanOf st st2) (spanOf st st1), st2))))

parseAtomBase : Int -> PState -> Int -> Check (Expr, PState)
parseAtomBase fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      -- `f { r | x = 3 }`：这里的 `{` 是记录更新实参，标识符本身只作应用头返回，
      -- `{` 留给 `parseArgs` 按更新原子解析。记录字面量（`P { x = 1 }`）仍走下面分支。
      PTok (TIdent name) p =>
        let
          st1 = advance st
        in if atSym st1 "{" then if recordUpdateAhead st1 then OkC (EVar name (detachedNodeRef (spanOf st st1)), st1) else Vuna.Compiler.Base.Common.bind (expectSym st1 "{") (\st1b => Vuna.Compiler.Base.Common.step (parseRecordAssignments (fuel - 1) st1b blockCol) (\fields, st2 => OkC (ERecord name fields (detachedNodeRef (spanOf st st2)), st2))) else if macroBangAt st1 p name then parseMacroAtom (fuel - 1) st blockCol name else OkC (EVar name (detachedNodeRef (spanOf st st1)), st1)
      PTok (TInt n) p => OkC (EInt n (detachedNodeRef (spanOf st (advance st))), advance st)
      PTok (TFloat raw) p => OkC (EFloat raw (detachedNodeRef (spanOf st (advance st))), advance st)
      PTok (TStr s) p => OkC (EStr s (detachedNodeRef (spanOf st (advance st))), advance st)
      PTok (TTmpl multi parts endP) p => withExtent CstExprKind semExpr st (\st0 => parseTemplateAtom (fuel - 1) st0 multi parts endP)
      PTok (TKw "Type") p => OkC (EVar "Type" (detachedNodeRef (spanOf st (advance st))), advance st)
      PTok (TSym "(") p =>
        case binderHead (advance st) of
          Just qn => if piArrowAhead (advance st) then parsePiBinder (fuel - 1) st blockCol (firstOf qn) (secondOf qn) False "(" ")" else parseParenAtom (fuel - 1) st blockCol
          -- `(+)` / `(+ e)` section。`(e op)` 由 parseInfix 的右 section 分支处理。
          Nothing =>
            case sectionOpAt st of
              Just op => withExtent CstExprKind semExpr st (\st0 => parseSectionAtom (fuel - 1) st0 blockCol op)
              Nothing => parseParenAtom (fuel - 1) st blockCol
      PTok (TSym "[") p => parseListExpr (fuel - 1) st blockCol
      -- 命名洞 `?name`（`?` 与标识符紧邻）。编码成 `EVar "?name"`（不新增 AST 构造子），
      -- span 覆盖整个 `?name`；精化器据 `isHoleName` 把它当洞。
      PTok (TSym "?") p =>
        case holeAtomAt st of
          Just h => OkC (EVar (firstOf h) (detachedNodeRef (secondOf h)), advance (advance st))
          Nothing => ps0 st ExpectedExpression
      PTok (TSym "{") p =>
        case binderHead (advance st) of
          Just qn => parsePiBinder (fuel - 1) st blockCol (firstOf qn) (secondOf qn) True "{" "}"
          Nothing => Vuna.Compiler.Base.Common.bind (expectSym st "{") (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\base, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 "|") (\st3 => Vuna.Compiler.Base.Common.step (parseRecordAssignments (fuel - 1) st3 blockCol) (\fields, st4 => OkC (ERecUpdate base fields (detachedNodeRef (spanOf st st4)), st4)))))
      _ => ps0 st ExpectedExpression

-- 模板字符串原子。文本块直接成为 `IPText`；插值洞用**洞内 token** 现场解析
-- （token 位置由 lexer 原位给出，仍是绝对源码位置），再组装成 `EInterp`。
-- 字面量结束位置写入 `lastPos`：多行字面量之后的布局判定与 decl span 都依赖它。
parseTemplateAtom : Int -> PState -> Bool -> List TmplPart -> Pos -> Check (Expr, PState)
parseTemplateAtom fuel st multi parts endP =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind (parseTemplateParts (fuel - 1) st (tokSpan st) parts) (
        \parsed =>
          let
            ps = firstOf parsed
            holes = secondOf parsed
            advanced = advance st
            st2 = addInterpMulti (posOffset (peekPos st)) multi (addTemplateHoles st.openNodeId holes (withLastPos endP advanced))
          in OkC (EInterp ps (NodeRef st.openNodeId (spanOf st st2)), st2)
      )

-- 洞内解析交回每个洞的子树（洞内 token 不在主 token 流里，主树看不到它们）。
parseTemplateParts : Int -> PState -> Span -> List TmplPart -> Check (List InterpPart, List CstNode)
parseTemplateParts fuel st fallback parts =
  if fuel <= 0 then
    icFuel "parser"
  else
    case parts of
      [] => OkC ([], [])
      (TPText s) :: rest => Vuna.Compiler.Base.Common.bind (parseTemplateParts (fuel - 1) st fallback rest) (\tail => OkC ((::) (IPText s) (firstOf tail), secondOf tail))
      (TPHole toks) :: rest => Vuna.Compiler.Base.Common.bind (parseTemplateHole (toksFuel toks) st fallback toks) (\hole => Vuna.Compiler.Base.Common.bind (parseTemplateParts (fuel - 1) st fallback rest) (\tail => OkC ((::) (IPHole (firstOf hole)) (firstOf tail), (::) (secondOf hole) (secondOf tail))))

-- 一个插值洞：空 token → `TemplateHoleEmpty`（指向字面量起点的兜底 span）；否则必须
-- 恰好解析成一个表达式。洞内错误自带精确 span，兜底只为「无位置」的诊断补洞位置。
-- 洞内节点用自己的 token 子流 + 事件建成子树，挂在模板节点上（见 `CstSurface.cstHoleTrees`）。
parseTemplateHole : Int -> PState -> Span -> List PTok -> Check (Expr, CstNode)
parseTemplateHole fuel st fallback toks =
  if fuel <= 0 then
    icFuel "parser"
  else
    case toks of
      [] => psErr0At fallback TemplateHoleEmpty
      first :: _ =>
        let
          pos = first.ptokPos
          file = fileOf st
          subState = mkStateAt file st.sourceOf toks pos (length toks) (pmodeOf st) (eventMode st)
        in case parseExpr (fuel - 1) subState 0 of
          ErrC e => ErrC (withFallbackSpan (holeSpan file pos) e)
          OkC (e, st2) =>
            if isEof st2 then
              let
                events = eventsOf st2
                tree = nestToTreeWithSurface (lexTokensOfFrom st.sourceOf pos toks) events (parenEntriesOf toks events) st2.backtickShapes st2.sectionShapes st2.interpMultis st2.templateHoles
              in OkC (e, holeRootOf tree)
            else
              ErrC (withLabel (Label (Just (holeSpan file pos)) "" LabelPrimary Nothing) (psMsg ExpectedEndOfExpr []))

-- 插值洞的位置：洞内 token 的首位置（文件在 lexer 侧已知）。
holeSpan : String -> Pos -> Span
holeSpan file (Pos line col off _) = Span file line col line col off off

-- 洞内 token 的 parser fuel 种子（与 `stateFuel` 同形，按 token 数线性放大）。
toksFuel : List PTok -> Int
toksFuel toks = 128 * length toks + 1024

-- 洞内 token 全是文本块时拼成字符串（多行字面量在**模式**里只允许这种形态）。
textPartsOf : List TmplPart -> Maybe String
textPartsOf [] = Just ""
textPartsOf ((TPText s) :: rest) =
  case textPartsOf rest of
    Nothing => Nothing
    Just t => Just (s ++ t)
textPartsOf ((TPHole toks) :: rest) = Nothing

-- `()` / `(e)` / `(e, f, ...)` / `(e : T)`。进入时在 `(`；Pi binder 与 section 已排除。
parseParenAtom : Int -> PState -> Int -> Check (Expr, PState)
parseParenAtom fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind (expectSym st "(") (
        \st1 =>
          if atSym st1 ")" then
            let
              st2 = advance st1
            in OkC (EVar (reservedText RsTupleUnit) (detachedNodeRef (spanOf st st2)), st2)
          else
            Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\first, st2 => if atSym st2 "," then Vuna.Compiler.Base.Common.step (parseParenTupleRest (fuel - 1) (advance st2) blockCol [first]) (\elems, st3 => OkC (foldPairExprs (detachedNodeRef (spanOf st st3)) elems, st3)) else if atSym st2 ":" then Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) (advance st2) blockCol) (\ty, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 ")") (\st4 => OkC (EApp (EVar (reservedText RsAscribe) (detachedNodeRef (spanOf st st2))) [first, ty] (detachedNodeRef (spanOf st st4)), st4))) else Vuna.Compiler.Base.Common.bind (expectSym st2 ")") (\st3 => OkC (first, st3)))
      )

-- 元组剩余元素：进入时已消费逗号；收齐后要求 `)`。
parseParenTupleRest : Int -> PState -> Int -> List Expr -> Check (List Expr, PState)
parseParenTupleRest fuel st blockCol acc =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseExpr (fuel - 1) st blockCol)
      (\e, st1 => if atSym st1 "," then parseParenTupleRest (fuel - 1) (advance st1) blockCol (e :: acc) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (reverse (e :: acc), st2)))

-- 元组右嵌套：`(a, b, c)` ≡ pair(a, pair(b, c))。
foldPairExprs : NodeRef -> List Expr -> Expr
foldPairExprs sp [] = EVar (reservedText RsTupleUnit) sp
foldPairExprs sp [e] = e
foldPairExprs sp (a :: rest) =
  EApp (EVar (reservedText RsTuplePair) sp) [a, foldPairExprs sp rest] sp

-- section 的 op 值 / 左 section 形态：`(op)` 与 `(op e)`。
-- 进入时已在 `(`，op 已由 sectionOpAt 确认（TSym 且非保留名）。表达式根指向自己的
-- section 节点（`withExtent` 打开的区间），表面写法记在节点上。
parseSectionAtom : Int -> PState -> Int -> String -> Check (Expr, PState)
parseSectionAtom fuel st blockCol op =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind (expectSym st "(") (
        \st1 =>
          Vuna.Compiler.Base.Common.bind (expectSym st1 op) (
              \st2 =>
                if atSym st2 ")" then
                  let
                    sp = spanOf st (advance st2)
                  in OkC (EVar op (NodeRef st.openNodeId sp), addSectionShape (spanStartOffset sp) (SectionOp op) (advance st2))
                else
                  Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (
                      \rhs, st3 =>
                        Vuna.Compiler.Base.Common.bind (expectSym st3 ")") (
                            \st4 =>
                              let
                                sp = spanOf st st4
                              in OkC (sectionLeftExpr op rhs (NodeRef st.openNodeId sp), addSectionShape (spanStartOffset sp) (SectionLeft op) st4)
                          )
                    )
            )
      )

-- section 的 lambda 降级：binder 名源码写不出（`#section`），Loader.Fixity 会稍后
-- 按表面形状折叠立即应用，Elab 只会在 section 当值时看到这个 λ。
sectionLeftExpr : String -> Expr -> NodeRef -> Expr
sectionLeftExpr op operand r =
  ELam
    [(sectionBinderName, nodeRefSpan r)]
    (EApp (EVar op (detachedNodeRef (nodeRefSpan r))) [EVar sectionBinderName (detachedNodeRef (nodeRefSpan r)), operand] (detachedNodeRef (nodeRefSpan r)))
    r

sectionRightExpr : String -> Expr -> NodeRef -> Expr
sectionRightExpr op operand r =
  ELam
    [(sectionBinderName, nodeRefSpan r)]
    (EApp (EVar op (detachedNodeRef (nodeRefSpan r))) [operand, EVar sectionBinderName (detachedNodeRef (nodeRefSpan r))] (detachedNodeRef (nodeRefSpan r)))
    r

-- Pi binder：`(x : A) -> B`、`{x : A} -> B`，以及带 quantity 的 `(0 x : A)` / `(1 x : A)`。
-- 多参数 trait 探针的 `{a b : Type} -> ...` 支持同一 binder 组写多个名字（展开成嵌套 EPi）。
-- 进入时已在开括号处；binder 头（可选 quantity + 名 + `:`）先由 lookahead 确认，再要求 `->`。
parsePiBinder : Int -> PState -> Int -> Maybe Qty -> List String -> Bool -> String -> String -> Check (Expr, PState)
parsePiBinder fuel st blockCol qty names implicit openSym closeSym =
  if fuel <= 0 then
    icFuel "parser"
  else if anyDottedName names then
    ps0 st PiBinderNameNotSimple
  else
    Vuna.Compiler.Base.Common.bind
      (expectSym st openSym)
      (\st1 => Vuna.Compiler.Base.Common.bind (consumeQty st1 qty) (\st2 => Vuna.Compiler.Base.Common.step (parsePiNames (fuel - 1) st2) (\names2, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 ":") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st4 blockCol) (\dom, st5 => Vuna.Compiler.Base.Common.bind (expectSym st5 closeSym) (\st6 => Vuna.Compiler.Base.Common.bind (expectSym st6 "->") (\st7 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st7 blockCol) (\cod, st8 => OkC (foldPiNames names2 implicit qty dom cod (detachedNodeRef (spanOf st st8)), st8)))))))))

-- 连续的标识符（lookahead 已确认它们后面紧跟 `:`）。
parsePiNames : Int -> PState -> Check (List String, PState)
parsePiNames fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (expectIdent st)
      (\name, st1 => parsePiNamesRest (fuel - 1) st1 [name])

parsePiNamesRest : Int -> PState -> List String -> Check (List String, PState)
parsePiNamesRest fuel st acc =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent name) p => parsePiNamesRest (fuel - 1) (advance st) (name :: acc)
      _ => OkC (reverse acc, st)

-- 同名 binder 组展开成嵌套 EPi（外到内 = 源码顺序）。
foldPiNames : List String -> Bool -> Maybe Qty -> Expr -> Expr -> NodeRef -> Expr
foldPiNames [] implicit qty dom cod sp = cod
foldPiNames (n :: rest) implicit qty dom cod sp =
  EPi n implicit qty dom (foldPiNames rest implicit qty dom cod sp) sp

anyDottedName : List String -> Bool
anyDottedName [] = False
anyDottedName (n :: rest) = containsDot n || anyDottedName rest

-- 消费 binder 前缀里的 quantity token（lookahead 已确认；这里只做机械前进）。
consumeQty : PState -> Maybe Qty -> Check PState
consumeQty st Nothing = OkC st
consumeQty st (Just q) =
  case peekTok st of
    PTok (TInt 0) _ => OkC (advance st)
    PTok (TInt 1) _ => OkC (advance st)
    _ => ps0 st ExpectedIdentifier

-- `{ f = e, ... }`：构造与更新的公共字段列表（进入时已在 `{` 之后）。
parseRecordAssignments : Int -> PState -> Int -> Check (List (String, Expr), PState)
parseRecordAssignments fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "}" then
    OkC ([], advance st)
  else
    Vuna.Compiler.Base.Common.step
      (parseRecordAssignList (fuel - 1) st blockCol)
      (\fs, st1 => OkC (fs, st1))

parseRecordAssignList : Int -> PState -> Int -> Check (List (String, Expr), PState)
parseRecordAssignList fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (expectIdent st)
      (\fname, st1 => Vuna.Compiler.Base.Common.bind (expectSym st1 "=") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 blockCol) (\value, st3 => if atSym st3 "," then Vuna.Compiler.Base.Common.step (parseRecordAssignList (fuel - 1) (advance st3) blockCol) (\rest, st4 => OkC ((::) (fname, value) rest, st4)) else Vuna.Compiler.Base.Common.bind (expectSym st3 "}") (\st4 => OkC ([(fname, value)], st4)))))

parseListExpr : Int -> PState -> Int -> Check (Expr, PState)
parseListExpr fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectSym st "[")
      (\st1 => if atSym st1 "]" then OkC (EVar (reservedText RsListNil) (detachedNodeRef (spanOf st (advance st1))), advance st1) else Vuna.Compiler.Base.Common.step (parseListExprElems (fuel - 1) st1 blockCol) (\elems, st2 => OkC (foldCons (detachedNodeRef (spanOf st st2)) elems, st2)))

parseListExprElems : Int -> PState -> Int -> Check (List Expr, PState)
parseListExprElems fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseExpr (fuel - 1) st blockCol)
      (\e0, st0 => Vuna.Compiler.Base.Common.step (parseListElemAt (fuel - 1) e0 st0) (\e, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseListExprElems (fuel - 1) (advance st1) blockCol) (\rest, st2 => OkC ((::) e rest, st2)) else if atSym st1 "]" then OkC ([e], advance st1) else ps0 st1 ExpectedCommaOrBracket))

-- 列表字面量元素里的 `X@name`：`@` 在 vuna 里也是模式的
-- as-pattern，所以只在列表元素位置接受它，不做全局后缀。
parseListElemAt : Int -> Expr -> PState -> Check (Expr, PState)
parseListElemAt fuel e st =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "@" then
    Vuna.Compiler.Base.Common.bind
      (expectSym st "@")
      (\st1 => Vuna.Compiler.Base.Common.step (parseAtom (fuel - 1) st1 0) (\nm, st2 => OkC (EApp (EVar (reservedText RsRowAt) (detachedNodeRef (spanFromExpr e st2))) [e, rowAtNameExpr nm] (detachedNodeRef (spanFromExpr e st2)), st2)))
  else
    OkC (e, st)

-- | 把元素列表折叠成 `cons` 保留名的右嵌套链（空表是 `nil` 保留名）。
foldCons : NodeRef -> List Expr -> Expr
foldCons sp [] = EVar (reservedText RsListNil) sp
foldCons sp (e :: rest) = EApp (EVar (reservedText RsListCons) sp) [e, foldCons sp rest] sp

parseLambda : Int -> PState -> Int -> Check (Expr, PState)
parseLambda fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectSym st "\\")
      (\st1 => Vuna.Compiler.Base.Common.step (parseLambdaParam st1) (\first, st2 => Vuna.Compiler.Base.Common.step (parseLambdaParams (stateFuel st2) st2 [first]) (\params, st3 => Vuna.Compiler.Base.Common.bind (expectSym st3 "=>") (\st4 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st4 blockCol) (\body, st5 => OkC (ELam params body (detachedNodeRef (spanOf st st5)), st5))))))

-- | 一个 λ 参数：名字 + 名字自身的 span（单 token）。
parseLambdaParam : PState -> Check ((String, Span), PState)
parseLambdaParam st =
  Vuna.Compiler.Base.Common.step (expectIdent st) (\name, st1 => OkC ((name, tokenSpan st), st1))

parseLambdaParams : Int -> PState -> List (String, Span) -> Check (List (String, Span), PState)
parseLambdaParams fuel st acc =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "," then
    Vuna.Compiler.Base.Common.step
      (parseLambdaParam (advance st))
      (\p, st1 => parseLambdaParams (fuel - 1) st1 (append acc [p]))
  else
    OkC (acc, st)

parseLet : Int -> PState -> Int -> Check (Expr, PState)
parseLet fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectKw st "let")
      (\st1 => Vuna.Compiler.Base.Common.step (parseLetBindings (fuel - 1) st1 blockCol) (\binds, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "in") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st3 blockCol) (\body, st4 => OkC (ELet binds body False (detachedNodeRef (spanOf st st4)), st4)))))

-- `let` 绑定块：与 `where` 共用 `parseBindingItemsAt` / `bindingItemsToBinds`
-- （签名行可选；函数子句降级成 λ）。块结束于缩进回退或 `in`。
parseLetBindings : Int -> PState -> Int -> Check (List Binding, PState)
parseLetBindings fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    ps0 st ExpectedLetBinding
  else if atKw st "in" then
    ps0 st ExpectedLetBinding
  else
    case peekPos st of
      Pos line col _ _ => if col <= blockCol then ps0 st LetBindingNotIndented else Vuna.Compiler.Base.Common.step (parseBindingItemsAt (fuel - 1) st col) (\items, st1 => Vuna.Compiler.Base.Common.bind (bindingItemsToBinds items) (\binds => OkC (binds, st1)))

parseCase : Int -> PState -> Int -> Check (Expr, PState)
parseCase fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectKw st "case")
      (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\scrut, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "of") (\st3 => Vuna.Compiler.Base.Common.step (parseCaseAlts (fuel - 1) st3 blockCol) (\alts, st4 => OkC (ECase scrut alts (detachedNodeRef (spanOf st st4)), st4)))))

parseCaseAlts : Int -> PState -> Int -> Check (List Alt, PState)
parseCaseAlts fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    ps0 st CaseNeedsAlternative
  else
    case peekPos st of
      Pos line col _ _ =>
        if col <= blockCol then
          ps0 st CaseAltNotIndented
        else
          Vuna.Compiler.Base.Common.step (parseAltList (fuel - 1) st col) (
              \alts, st2 =>
                if badCaseIndent st2 col then
                  ps0 st2 UnexpectedIndentAfterCaseAlt
                else
                  case alts of
                    [] => ps0 st2 CaseNeedsAlternative
                    _ => OkC (alts, st2)
            )

parseAltList : Int -> PState -> Int -> Check (List Alt, PState)
parseAltList fuel st altCol =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC ([], st)
  else
    case peekPos st of
      Pos line col _ _ => if col == altCol then Vuna.Compiler.Base.Common.step (parseAlt (fuel - 1) st altCol) (\alt, st1 => Vuna.Compiler.Base.Common.step (parseAltList (fuel - 1) st1 altCol) (\rest, st2 => OkC ((::) alt rest, st2))) else OkC ([], st)

-- | 一条 case 分支（`pat => body`）；分支自身是 `alt` 节点（注释锚点）。
parseAlt : Int -> PState -> Int -> Check (Alt, PState)
parseAlt fuel st altCol =
  withExtent
    CstAltKind
    semAlt
    st
    (\st0 => Vuna.Compiler.Base.Common.step (parseAltBody fuel st0 altCol) (\alt, st1 => OkC (Alt alt.altPat alt.altBody (NodeRef st0.openNodeId (spanOf st st1)), st1)))

parseAltBody : Int -> PState -> Int -> Check (Alt, PState)
parseAltBody fuel st altCol =
  Vuna.Compiler.Base.Common.step
    (parsePatternSingle (stateFuel st) st altCol)
    (\pat, st1 => Vuna.Compiler.Base.Common.bind (checkBindersAt st [pat]) (\_ => Vuna.Compiler.Base.Common.bind (expectSym st1 "=>") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 altCol) (\body, st3 => OkC ((Alt pat body (NodeRef st.openNodeId (spanOf st st3))), st3)))))

-- `@` 后面的裸标识符是实例名**字面量**（`[Console@audit]` → 名字 "audit"）；字符串原样。
rowAtNameExpr : Expr -> Expr
rowAtNameExpr (EVar nm sp) = EStr nm sp
rowAtNameExpr e = e

-- `perform <expr>`：保留名单实参应用；Elab 侧按 op 族
-- 推导 key / 实例名 / 效应签名后降级到 `Base.Effect.Core.performCore`，不新增 AST 构造子。
parsePerform : Int -> PState -> Int -> Check (Expr, PState)
parsePerform fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectKw st "perform")
      (\st1 => Vuna.Compiler.Base.Common.step (parseApplication (fuel - 1) st1 blockCol) (\operand, st2 => OkC (EApp (EVar (reservedText RsPerform) (detachedNodeRef (spanOf st st2))) [operand] (detachedNodeRef (spanOf st st2)), st2)))

-- ---------------------------------------------------------------
-- `handle <comp> { ... }`
-- ---------------------------------------------------------------
-- 表面语法：
--   handle <comp> { return x -> <expr>
--                   C p1 .. pn k -> <expr>
--                   ... }
-- 编码（不新增 Expr 构造子）：`EApp (EVar "@vuna@handle") [comp, ret, opH]`
--   * ret = `ELam [x] body`；缺 return 子句时是哨兵 `EVar "@vuna@handle@noret"`；
--   * opH = `ELam [i, o, k] (ECase (EVar o) alts)`：alt pattern 只含构造子实参（续延 binder
--     是 λ 的第三个参数，第二个是结果索引 binder）；op 族、实例名、效应签名全部由 Elab 从 clause 构造子推导。
-- | 一个 `handle` op 子句：构造子名、实参模式、子句 span、续延 binder 名、子句体。
data HandleOp : Type where
  HandleOp : String -> List Pat -> NodeRef -> NodeRef -> String -> Expr -> HandleOp

-- | `handle` 块：可选 return 子句（binder 名 + 体 + 该子句的 `alt` 节点）与 op 子句列表。
data HandleBlock : Type where
  HandleBlock : Maybe (String, Expr, NodeRef) -> List HandleOp -> HandleBlock

-- | `handle comp { return? op-clause+ }`：解析并降到保留名标记。
parseHandle : Int -> PState -> Int -> Check (Expr, PState)
parseHandle fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind (expectKw st "handle") (
        \st1 =>
          Vuna.Compiler.Base.Common.step (parseHandleComp (fuel - 1) st1 blockCol) (
              \comp, st2 =>
                Vuna.Compiler.Base.Common.bind (expectSym st2 "{") (
                    \st3 =>
                      Vuna.Compiler.Base.Common.step (parseHandleBody (fuel - 1) st3 blockCol) (
                          \blk, st4 =>
                            case handleExpr comp blk (detachedNodeRef (spanOf st st4)) of
                              ErrC e => ErrC e
                              OkC expr => OkC (expr, st4)
                        )
                  )
            )
      )

-- | 解析被 handle 包裹的 comp：裸标识符紧跟 `{` 时直接收成 `EVar`（避免记录字面量歧义）。
parseHandleComp : Int -> PState -> Int -> Check (Expr, PState)
parseHandleComp fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent name) p =>
        case peekTokAt st 1 of
          Just (PTok (TSym "{") _) => OkC (EVar name (detachedNodeRef (spanOf st (advance st))), advance st)
          _ => parseExpr (fuel - 1) st blockCol
      _ => parseExpr (fuel - 1) st blockCol

-- | 解析 handle 块体：可选的 return 子句 + op 子句列表，随后消费 `}`。
parseHandleBody : Int -> PState -> Int -> Check (HandleBlock, PState)
parseHandleBody fuel st handleCol =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "}" then
    ps0 st HandleNeedsOpClause
  else
    case peekPos st of
      Pos line col _ _ =>
        if col <= handleCol then
          ps0 st HandleClauseNotIndented
        else
          Vuna.Compiler.Base.Common.step (parseHandleClauses (fuel - 1) st col Nothing []) (
              \p, st2 =>
                case p of
                  (retOpt, ops) => Vuna.Compiler.Base.Common.bind (expectSym st2 "}") (\st3 => OkC (HandleBlock retOpt ops, st3))
            )

-- | 子句头是否是 return 子句（`return` 不是全局关键字，只在子句头按标识符识别）。
isReturnClauseHead : PState -> Bool
isReturnClauseHead stat =
  case peekTok stat of
    PTok (TIdent nm) _ => nm == "return"
    _ => False

-- | handle 子句循环：同列续行；遇 `}` 或缩进回退结束。
parseHandleClauses : Int -> PState -> Int -> Maybe (String, Expr, NodeRef) -> List HandleOp -> Check ((Maybe (String, Expr, NodeRef), List HandleOp), PState)
parseHandleClauses fuel st clauseCol retOpt acc =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    ps0 st UnexpectedEndOfInput
  else if atSym st "}" then
    OkC ((retOpt, reverse acc), st)
  else
    case peekPos st of
      Pos line col _ _ =>
        if col == clauseCol then
          if isReturnClauseHead st then
            case retOpt of
              Just _ => ps0 st HandleReturnMisplaced
              Nothing =>
                case acc of
                  _ :: _ => ps0 st HandleReturnMisplaced
                  [] =>
                    Vuna.Compiler.Base.Common.step (parseHandleRetClause (fuel - 1) st clauseCol) (
                        \p, st2 =>
                          case p of
                            (x, body, rsp) => parseHandleClauses (fuel - 1) st2 clauseCol (Just (x, body, rsp)) acc
                      )
          else
            Vuna.Compiler.Base.Common.step (parseHandleOpClause (fuel - 1) st clauseCol) (\op, st2 => parseHandleClauses (fuel - 1) st2 clauseCol retOpt (op :: acc))
        else
          OkC ((retOpt, reverse acc), st)

-- | 解析 `return x -> body` 子句（子句自身是 `alt` 节点：注释挂载点）。
parseHandleRetClause : Int -> PState -> Int -> Check ((String, Expr, NodeRef), PState)
parseHandleRetClause fuel st clauseCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    withExtent
      CstAltKind
      semHandleRet
      st
      (\st0 => Vuna.Compiler.Base.Common.step (expectIdent st0) (\_kw, st1 => Vuna.Compiler.Base.Common.step (expectIdent st1) (\x, st2 => Vuna.Compiler.Base.Common.bind (expectSym st2 "->") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st3 clauseCol) (\body, st4 => OkC ((x, body, NodeRef st0.openNodeId (spanOf st0 st4)), st4))))))

-- | 解析一个 op 子句头：构造子模式 + 尾部续延 binder（`_` 允许，统一成 `_`）。
parseHandleOpClause : Int -> PState -> Int -> Check (HandleOp, PState)
parseHandleOpClause fuel st clauseCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    withExtent
      CstAltKind
      semHandleOp
      st
      (\st0 => parseHandleOpClauseBody fuel st0 clauseCol st0.openNodeId)

-- | op 子句体（`nid` 是子句的 `alt` 节点 id）。
parseHandleOpClauseBody : Int -> PState -> Int -> Int -> Check (HandleOp, PState)
parseHandleOpClauseBody fuel st clauseCol nid =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step (parsePatternSingle (stateFuel st) st clauseCol) (
        \pat, st1 =>
          Vuna.Compiler.Base.Common.bind (checkBindersAt st [pat]) (
              \_ =>
                case pat of
                  PCon cname args psp =>
                    case reverse args of
                      [] => psErr0At (nodeRefSpan psp) HandleClauseNeedsCtor
                      last :: revRest =>
                        case last of
                          PVar kname _ => handleOpTail (fuel - 1) st st1 clauseCol cname (reverse revRest) psp nid kname
                          PWild _ => handleOpTail (fuel - 1) st st1 clauseCol cname (reverse revRest) psp nid "_"
                          _ => psErr0At (nodeRefSpan psp) HandleClauseNeedsCtor
                  _ => ps0 st HandleClauseNeedsCtor
            )
      )

-- | op 子句的 `-> body` 尾段。
handleOpTail : Int -> PState -> PState -> Int -> String -> List Pat -> NodeRef -> Int -> String -> Check (HandleOp, PState)
handleOpTail fuel stStart st clauseCol cname pats psp nid kname =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectSym st "->")
      (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 clauseCol) (\body, st2 => OkC ((HandleOp cname pats psp (NodeRef nid (spanOf stStart st2)) kname body), st2)))

-- | op 子句的续延 binder 名。
handleOpKName : HandleOp -> String
handleOpKName (HandleOp _ _ _ _ k _) = k

-- | 找出与基准不同的续延 binder 名（都一致则 Nothing）。
firstOtherKName : List HandleOp -> String -> Maybe String
firstOtherKName [] k = Nothing
firstOtherKName (op :: rest) k =
  let
    k2 = handleOpKName op
  in if k2 == k then firstOtherKName rest k else Just k2

-- | HandleOp → 合成 case 的 alt（pattern 只含构造子实参；分支身份是子句的 `alt` 节点）。
handleAlt : HandleOp -> Alt
handleAlt (HandleOp cname pats psp hopRef _ body) = Alt (PCon cname pats psp) body hopRef

-- | ret 实参表达式（缺 return 子句时用哨兵）。
handleRetExpr : Maybe (String, Expr, NodeRef) -> NodeRef -> Expr
handleRetExpr Nothing sp = EVar (reservedText RsHandleNoRet) sp
handleRetExpr (Just (x, body, retRef)) sp = ELam [(x, nodeRefSpan retRef)] body retRef

-- | 合成 op λ：`\o, k => case o of alts`。
handleOpLam : List HandleOp -> String -> NodeRef -> Expr
handleOpLam ops kname sp =
  ELam
    [(handleOpIndexBinderName, spanEmpty), (handleOpBinderName, spanEmpty), (kname, spanEmpty)]
    (ECase (EVar handleOpBinderName sp) (map handleAlt ops) sp)
    sp

-- | 校验子句并合成 `EApp (EVar "@vuna@handle") [comp, ret, opH]`。
handleExpr : Expr -> HandleBlock -> NodeRef -> Check Expr
handleExpr comp (HandleBlock retOpt []) sp = psErr0At (nodeRefSpan sp) HandleNeedsOpClause
handleExpr comp (HandleBlock retOpt (first :: rest)) sp =
  case firstOtherKName rest (handleOpKName first) of
    Nothing =>
      OkC
        (EApp (EVar (reservedText RsHandle) sp) [comp, handleRetExpr retOpt sp, handleOpLam (first :: rest) (handleOpKName first) sp] sp)
    Just k1 =>
      psErrAt
        (nodeRefSpan sp)
        (HandleContinuationNameMismatch (handleOpKName first) k1)
        [handleOpKName first, k1]

parseIf : Int -> PState -> Int -> Check (Expr, PState)
parseIf fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectKw st "if")
      (\st1 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st1 blockCol) (\cond, st2 => Vuna.Compiler.Base.Common.bind (expectKw st2 "then") (\st3 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st3 blockCol) (\yes, st4 => Vuna.Compiler.Base.Common.bind (expectKw st4 "else") (\st5 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st5 blockCol) (\no, st6 => OkC (EIf cond yes no (detachedNodeRef (spanOf st st6)), st6)))))))

-- do 块：`do` + 缩进对齐的语句，语句是 `let pat = e`、`pat <- expr` 或裸表达式；
-- 最后一条必须是裸表达式（do 本身不引入 pure，最后表达式即块结果）。
parseDo : Int -> PState -> Int -> Check (Expr, PState)
parseDo fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind (expectKw st "do") (
        \st1 =>
          if isEof st1 then
            ps0 st1 DoBlockNeedsStatement
          else
            case peekPos st1 of
              Pos line col _ _ =>
                if col <= blockCol then
                  ps0 st1 DoStatementNotIndented
                else
                  Vuna.Compiler.Base.Common.step (parseDoStmts (fuel - 1) st1 col []) (
                      \stmts, st2 =>
                        case reverse stmts of
                          (DExpr lastExpr lastSp) :: rest => OkC (EDo stmts (detachedNodeRef (spanOf st st2)), st2)
                          _ => ps0 st2 DoBlockMustEndWithExpr
                    )
      )

parseDoStmts : Int -> PState -> Int -> List DoStmt -> Check (List DoStmt, PState)
parseDoStmts fuel st stmtCol acc =
  if fuel <= 0 then
    icFuel "parser"
  else if isEof st then
    OkC (reverse acc, st)
  else
    case peekPos st of
      Pos line col _ _ =>
        if col < stmtCol then
          OkC (reverse acc, st)
        else if col > stmtCol then
          ps0 st UnexpectedIndentInDo
        else
          Vuna.Compiler.Base.Common.step (parseDoStmt (fuel - 1) st stmtCol) (
              \stmt, st1 =>
                case peekPos st1 of
                  Pos line2 col2 _ _ => if isEof st1 then OkC (reverse (stmt :: acc), st1) else if col2 < stmtCol then OkC (reverse (stmt :: acc), st1) else if col2 > stmtCol then ps0 st1 UnexpectedIndentInDo else parseDoStmts (fuel - 1) st1 stmtCol (stmt :: acc)
            )

-- | 一条 do 语句的建树节点。
parseDoStmt : Int -> PState -> Int -> Check (DoStmt, PState)
parseDoStmt fuel st stmtCol =
  withExtent CstDoStmtKind semDoStmt st (\st0 => parseDoStmtBody fuel st0 stmtCol st0.openNodeId)

-- `<-` 绑定判定用的语句级 token 谓词：模式能出现的东西继续扫描，`<-` 直接定论为绑定；
-- 表达式独有的关键字 / 符号（`if`、`\`、`+`、`?` 等）定论为不是绑定。
bindArrowTok : PTok -> Maybe Bool
bindArrowTok (PTok (TSym "<-") _) = Just True
bindArrowTok (PTok (TIdent _) _) = Nothing
bindArrowTok (PTok (TInt _) _) = Nothing
bindArrowTok (PTok (TFloat _) _) = Nothing
bindArrowTok (PTok (TStr _) _) = Nothing
bindArrowTok (PTok (TTmpl _ _ _) _) = Nothing
bindArrowTok (PTok (TSym "@") _) = Nothing
bindArrowTok (PTok (TSym "::") _) = Nothing
bindArrowTok (PTok (TSym ",") _) = Nothing
bindArrowTok _ = Just False

-- | 当前 do 语句是否会走到 `<-` 绑定：模式原子 / 括号组之后直到语句边界出现 `<-`。
-- 模式解析失败时用它区分「绑定写错了」与「这条语句本来就不是绑定」。
doStmtBindsAhead : PState -> Int -> Bool
doStmtBindsAhead st stmtCol = scanDoStmtLevel st stmtCol bindArrowTok

parseDoStmtBody : Int -> PState -> Int -> Int -> Check (DoStmt, PState)
parseDoStmtBody fuel st stmtCol nid =
  if fuel <= 0 then
    icFuel "parser"
  else if atKw st "let" then
    doLetOrExpr fuel st stmtCol nid
  else
    case parsePatternSingle (stateFuel st) st stmtCol of
      OkC (pat, st1) => if atSym st1 "<-" then Vuna.Compiler.Base.Common.bind (checkBindersAt st [pat]) (\_ => Vuna.Compiler.Base.Common.bind (expectSym st1 "<-") (\st2 => Vuna.Compiler.Base.Common.step (parseExpr (fuel - 1) st2 stmtCol) (\e, st3 => OkC (DBind pat e (NodeRef nid (spanOf st st3)), st3)))) else parseDoExprStmt (fuel - 1) st stmtCol nid
      -- 语句里确实有 `<-` ⇒ 模式错误是真的（左值不是模式）；否则这条语句是表达式，
      -- 从原状态按表达式重解。
      ErrC e => if doStmtBindsAhead st stmtCol then ErrC e else parseDoExprStmt (fuel - 1) st stmtCol nid

-- do 语句位置的 `let`：do-let（绑定块后没有 `in`）或 `let ... in ...` 表达式语句。
-- 两者共享同一个 `let` 前缀，只能在绑定块之后按是否出现 `in` 区分；判定为表达式时从原状态重新解析。
--
-- 绑定块失败即真错误：`let ... in` 表达式与 do-let 从同一个起点、同一个 blockCol 解析
-- 绑定块，按表达式重解只会再失败一次，把签名 / 缩进 / 模式错误换成无关诊断。
doLetOrExpr : Int -> PState -> Int -> Int -> Check (DoStmt, PState)
doLetOrExpr fuel st stmtCol nid =
  if fuel <= 0 then
    icFuel "parser"
  else
    case expectKw st "let" of
      ErrC e => ErrC e
      OkC st1 =>
        case parseLetBindings (fuel - 1) st1 stmtCol of
          ErrC e => ErrC e
          OkC (binds, st2) => if atKw st2 "in" then parseDoExprStmt (fuel - 1) st stmtCol nid else OkC (DLet binds (NodeRef nid (spanOf st st2)), st2)

parseDoExprStmt : Int -> PState -> Int -> Int -> Check (DoStmt, PState)
parseDoExprStmt fuel st stmtCol nid =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parseExpr (fuel - 1) (sameLineState st) stmtCol)
      (\e, st1 => OkC (DExpr e (NodeRef nid (spanOf st st1)), st1))

-- ---------------------------------------------------------------
-- 非线性格检查（模式绑定名唯一性）
-- ---------------------------------------------------------------
-- 同一个绑定作用域（一条函数子句的**全部**参数模式 / 一个 case 分支 / 一条 let(where)
-- 绑定 / 一条 do-bind）里，一个名字只能绑定一次。当前不实现相等约束：重复绑定名在
-- 解析后直接拒绝，而不是被 `Elab.Match` 当作新 binder 静默重命名。
-- case 分支的 as-pattern、let 的嵌套模式等都在模式解析完成后走同一检查；不同子句 /
-- 分支 / 绑定是不同作用域，复用同名 binder 合法。
-- | 模式里按从左到右出现顺序的 (绑定名, span)：PVar 与 as 名算绑定，构造子 / 记录
-- 模式递归，通配与字面量不绑定。
patBinderBindings : Pat -> List (String, Span)
patBinderBindings (PVar name sp) = [(name, nodeRefSpan sp)]
patBinderBindings (PAs name inner sp) = (::) (name, nodeRefSpan sp) (patBinderBindings inner)
patBinderBindings (PCon cname pats _) = concatMap patBinderBindings pats
patBinderBindings (PRecord rname fields _) = concatMap (\f => patBinderBindings (secondOf f)) fields
patBinderBindings (PWild _) = []
patBinderBindings (PInt n _) = []
patBinderBindings (PStr s _) = []

-- | 从左到右第一个重复绑定：返回第二次出现的 (名字, span)；没有重复返回 Nothing。
firstRepeatedBinding : List (String, Span) -> Maybe (String, Span)
firstRepeatedBinding binds = firstRepeatedBindingGo binds []

-- | `firstRepeatedBinding` 的累加器版本（seen = 已出现的名字）。
firstRepeatedBindingGo : List (String, Span) -> List String -> Maybe (String, Span)
firstRepeatedBindingGo [] seen = Nothing
firstRepeatedBindingGo ((name, sp) :: rest) seen =
  if memName name seen then Just (name, sp) else firstRepeatedBindingGo rest ((::) name seen)

-- | 非线性格检查：一个绑定作用域的模式列表里出现重复绑定名 → 在第二次出现处报
-- 语法错误（带位置与名字）；合法时原样返回模式列表（便于与后续解析组合）。
-- | 非线性格检查的入口：工具模式（fmt/lint/index/doc/LSP）跳过。
-- 编译器路径仍然拒绝——精化器没有相等约束，放过去会静默改名。
checkBindersAt : PState -> List Pat -> Check (List Pat)
checkBindersAt st pats =
  case pmodeOf st of
    PmTool => OkC pats
    PmStrict => checkNoRepeatedBinders pats

checkNoRepeatedBinders : List Pat -> Check (List Pat)
checkNoRepeatedBinders pats =
  case firstRepeatedBinding (concatMap patBinderBindings pats) of
    Nothing => OkC pats
    Just (name, sp) =>
      ErrC
        (withLabel (Label (Just sp) "" LabelPrimary Nothing) (appendMessage " (repeated name: `${name}`)" (psMsg RepeatedPatternBinder [])))

-- | 一个模式的建树节点。
parsePatternSingle : Int -> PState -> Int -> Check (Pat, PState)
parsePatternSingle fuel st blockCol =
  withExtent
    CstPatKind
    semPat
    st
    (\st0 => Vuna.Compiler.Base.Common.step (parsePatternSingleBody fuel st0 blockCol) (\p, st1 => OkC (withPatId st0.openNodeId p, st1)))

parsePatternSingleBody : Int -> PState -> Int -> Check (Pat, PState)
parsePatternSingleBody fuel st blockCol =
  if fuel <= 0 then icFuel "parser" else parsePatternCons (fuel - 1) st blockCol

parsePatternCons : Int -> PState -> Int -> Check (Pat, PState)
-- pattern 里的 `::` 直接使用同名构造子（`Base.Data.List` 声明的就是 `(::)`）。
parsePatternCons fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parsePatternHead (fuel - 1) st blockCol)
      (\lhs, st1 => if atSym st1 "::" && canContinue st1 blockCol then Vuna.Compiler.Base.Common.step (parsePatternCons (fuel - 1) (advance st1) blockCol) (\rhs, st2 => OkC (PCon "::" [lhs, rhs] (detachedNodeRef (spanOf st st2)), st2)) else OkC (lhs, st1))

parsePatternHead : Int -> PState -> Int -> Check (Pat, PState)
parsePatternHead fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent name) p =>
        let
          st1 = advance st
        in if ctorPatternStart name && atSym st1 "{" then Vuna.Compiler.Base.Common.step (parseRecordPatternFields (fuel - 1) st1 blockCol) (\fields, st2 => OkC (PRecord name fields (detachedNodeRef (spanOf st st2)), st2)) else if ctorPatternStart name then Vuna.Compiler.Base.Common.step (parsePatternAtoms (fuel - 1) st1 blockCol) (\args, st2 => OkC (PCon name args (detachedNodeRef (spanOf st st2)), st2)) else parsePatternAtom (fuel - 1) st blockCol
      -- 符号构造子：`(sym) p1 p2`（无参时 `(sym)` 本身是空构造子模式）。
      PTok (TSym "(") _ =>
        case peekTokAt st 1 of
          Just (PTok (TSym sym) _) =>
            if isReservedValueName sym then
              parsePatternAtom (fuel - 1) st blockCol
            else
              case peekTokAt st 2 of
                Just (PTok (TSym ")") _) => Vuna.Compiler.Base.Common.step (parsePatternAtoms (fuel - 1) (advance (advance (advance st))) blockCol) (\args, st2 => OkC (PCon sym args (detachedNodeRef (spanOf st st2)), st2))
                _ => parsePatternAtom (fuel - 1) st blockCol
          _ => parsePatternAtom (fuel - 1) st blockCol
      _ => parsePatternAtom (fuel - 1) st blockCol

parseRecordPatternFields : Int -> PState -> Int -> Check (List (String, Pat), PState)
parseRecordPatternFields fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectSym st "{")
      (\st1 => parseRecordPatternList (fuel - 1) st1 blockCol)

parseRecordPatternList : Int -> PState -> Int -> Check (List (String, Pat), PState)
parseRecordPatternList fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st "}" then
    OkC ([], advance st)
  else
    Vuna.Compiler.Base.Common.step
      (parseRecordPatternField (fuel - 1) st blockCol)
      (\f, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseRecordPatternList (fuel - 1) (advance st1) blockCol) (\rest, st2 => OkC ((::) f rest, st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 "}") (\st2 => OkC ([f], st2)))

parseRecordPatternField : Int -> PState -> Int -> Check ((String, Pat), PState)
parseRecordPatternField fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent fname) p =>
        let
          st1 = advance st
        in if atSym st1 "=" then Vuna.Compiler.Base.Common.bind (expectSym st1 "=") (\st2 => Vuna.Compiler.Base.Common.step (parsePatternSingle (fuel - 1) st2 blockCol) (\pat, st3 => OkC ((fname, pat), st3))) else OkC ((fname, PVar fname (detachedNodeRef (Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p) (posOffset p) (posOffset p)))), st1)
      _ => ps0 st ExpectedRecordFieldPattern

parsePatternAtoms : Int -> PState -> Int -> Check (List Pat, PState)
parsePatternAtoms fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if startsPatternAtom st && canContinue st blockCol then
    Vuna.Compiler.Base.Common.step
      (parsePatternAtom (fuel - 1) st blockCol)
      (\pat, st1 => Vuna.Compiler.Base.Common.step (parsePatternAtoms (fuel - 1) st1 blockCol) (\rest, st2 => OkC ((::) pat rest, st2)))
  else
    OkC ([], st)

parsePatternAtom : Int -> PState -> Int -> Check (Pat, PState)
parsePatternAtom fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parsePatternAtomBase (fuel - 1) st blockCol)
      (\base, st1 => finishAsPattern (fuel - 1) st base st1 blockCol)

-- as-pattern：`x@pat`（前缀）与 `(pat)@x`（后缀）；`_@x` 等价于 `x@_`。
finishAsPattern : Int -> PState -> Pat -> PState -> Int -> Check (Pat, PState)
finishAsPattern fuel st base st1 blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else if atSym st1 "@" && canContinue st1 blockCol then
    case base of
      PVar "_" psp => Vuna.Compiler.Base.Common.step (parseAsName (fuel - 1) (advance st1)) (\name, st2 => OkC (PAs name (PWild psp) (detachedNodeRef (spanOf st st2)), st2))
      PVar name _ => Vuna.Compiler.Base.Common.step (parsePatternAtom (fuel - 1) (advance st1) blockCol) (\rhs, st2 => OkC (PAs name rhs (detachedNodeRef (spanOf st st2)), st2))
      _ => Vuna.Compiler.Base.Common.step (parseAsName (fuel - 1) (advance st1)) (\name, st2 => OkC (PAs name base (detachedNodeRef (spanOf st st2)), st2))
  else
    OkC (base, st1)

parseAsName : Int -> PState -> Check (String, PState)
parseAsName fuel st =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent name) p => if name == "_" then ps0 st ExpectedPattern else OkC (name, advance st)
      _ => ps0 st ExpectedPattern

parsePatternAtomBase : Int -> PState -> Int -> Check (Pat, PState)
parsePatternAtomBase fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    case peekTok st of
      PTok (TIdent "_") p => OkC (PWild (detachedNodeRef (spanOf st (advance st))), advance st)
      PTok (TIdent name) p => if ctorPatternStart name then OkC (PCon name [] (detachedNodeRef (spanOf st (advance st))), advance st) else OkC (PVar name (detachedNodeRef (spanOf st (advance st))), advance st)
      PTok (TInt n) p => OkC (PInt n (detachedNodeRef (spanOf st (advance st))), advance st)
      PTok (TStr s) p => OkC (PStr s (detachedNodeRef (spanOf st (advance st))), advance st)
      -- 多行字面量模式只允许**无洞**（等价于普通字符串字面量模式）；带洞不支持。
      PTok (TTmpl multi parts endP) p =>
        case textPartsOf parts of
          Just s =>
            let
              advanced = advance st
              st2 = withLastPos endP advanced
            in OkC (PStr s (detachedNodeRef (spanOf st st2)), st2)
          Nothing => ps0 st TemplateInPattern
      PTok (TSym "(") p =>
        if atSym (advance st) ")" then
          let
            st2 = advance (advance st)
          in OkC (PCon (reservedText RsTupleUnit) [] (detachedNodeRef (spanOf st st2)), st2)
        else
          Vuna.Compiler.Base.Common.step (parsePatternSingle (fuel - 1) (advance st) blockCol) (\first, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parsePatternTupleRest (fuel - 1) (advance st1) blockCol [first]) (\pats, st2 => OkC (foldPairPats (detachedNodeRef (spanOf st st2)) pats, st2)) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (first, st2)))
      PTok (TSym "[") p => parseListPattern (fuel - 1) st blockCol
      _ => ps0 st ExpectedPattern

parseListPattern : Int -> PState -> Int -> Check (Pat, PState)
parseListPattern fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.bind
      (expectSym st "[")
      (\st1 => if atSym st1 "]" then OkC (PCon (reservedText RsListNil) [] (detachedNodeRef (spanOf st (advance st1))), advance st1) else Vuna.Compiler.Base.Common.step (parseListPatternElems (fuel - 1) st1 blockCol) (\pats, st2 => OkC (foldPCon (detachedNodeRef (spanOf st st2)) pats, st2)))

parseListPatternElems : Int -> PState -> Int -> Check (List Pat, PState)
parseListPatternElems fuel st blockCol =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parsePatternSingle (fuel - 1) st blockCol)
      (\pat, st1 => if atSym st1 "," then Vuna.Compiler.Base.Common.step (parseListPatternElems (fuel - 1) (advance st1) blockCol) (\rest, st2 => OkC ((::) pat rest, st2)) else if atSym st1 "]" then OkC ([pat], advance st1) else ps0 st1 ExpectedCommaOrBracket)

-- | 把模式列表折叠成 `cons` 保留名的右嵌套链（空表是 `nil` 保留名）。
foldPCon : NodeRef -> List Pat -> Pat
foldPCon sp [] = PCon (reservedText RsListNil) [] sp
foldPCon sp (p :: rest) = PCon (reservedText RsListCons) [p, foldPCon sp rest] sp

-- 元组模式的剩余元素：进入时已消费逗号；收齐后要求 `)`。
parsePatternTupleRest : Int -> PState -> Int -> List Pat -> Check (List Pat, PState)
parsePatternTupleRest fuel st blockCol acc =
  if fuel <= 0 then
    icFuel "parser"
  else
    Vuna.Compiler.Base.Common.step
      (parsePatternSingle (fuel - 1) st blockCol)
      (\p, st1 => if atSym st1 "," then parsePatternTupleRest (fuel - 1) (advance st1) blockCol (p :: acc) else Vuna.Compiler.Base.Common.bind (expectSym st1 ")") (\st2 => OkC (reverse (p :: acc), st2)))

-- 元组模式右嵌套：`(a, b, c)` ≡ pair(a, pair(b, c))。
foldPairPats : NodeRef -> List Pat -> Pat
foldPairPats sp [] = PCon (reservedText RsTupleUnit) [] sp
foldPairPats sp [p] = p
foldPairPats sp (p :: rest) = PCon (reservedText RsTuplePair) [p, foldPairPats sp rest] sp

-- 文件加载专用：开启解析恢复（收集多个语法错误），调用范围外恢复短路。
-- 返回「(解析结果, fixity 事实) + 恢复期收集到的非致命诊断」（诊断按出现顺序；空 = 没有语法错误）。
-- | 文件加载专用：开启解析恢复并显式返回多条语法错误。
export parseSourceRecovering : String -> String -> Check ((SourceFile, FixityFacts), List Diagnostic)
parseSourceRecovering file source =
  Vuna.Compiler.Base.Common.bind
    (lexSource source)
    (\toks => parseSourceRecoveringTokens file source PmStrict toks)

-- 从**已有 token 流**解析（加载路径复用同一次词法）：与 `parseSourceRecovering` 逐字节等价，
-- 只是跳过 lex。位置全部来自 token 自身，因此诊断 span 与冷路径一致。
--
-- 加载器只需要中缀重排的三条表面事实，不需要树（树带 token 文本，按模块保留太重）：
-- 括号表项从事件流单趟算，反引号 / section 是 parser 在解析点登记的；模板洞的子树在
-- 解析时已经建好（洞内 token 不在主流里），直接并入事实。token 流不带注释（加载器不渲染）。
export parseSourceRecoveringTokens : String -> String -> ParseMode -> List PTok -> Check ((SourceFile, FixityFacts), List Diagnostic)
parseSourceRecoveringTokens file source mode toks =
  let
    st0 = mkState file source toks mode EvLayout
  in Vuna.Compiler.Base.Common.bind (parseSourceFile True st0) (
      \p =>
        let
          fin = secondOf (firstOf p)
          events = eventsOf fin
          parens = parenEntriesOf toks events
          holes = concatMap secondOf fin.templateHoles
          facts = fixityFactsOfParts parens fin.backtickShapes fin.sectionShapes holes
        in OkC ((firstOf (firstOf p), facts), secondOf p)
    )
