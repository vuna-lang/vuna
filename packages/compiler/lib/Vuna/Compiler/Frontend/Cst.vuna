-- | 无损 CST：携带前置 trivia 的 token 流，外加一层由缩进与括号决定的节点树。
module Vuna.Compiler.Frontend.Cst where

-- Vuna.Compiler.Frontend.Cst：**无损**具体语法层（token + trivia + 节点树）。
--
-- 为什么需要它（宏/工具的 span 来源）：parser 只把 span 写进 AST，注释与原始空白
-- 在 parser 里被丢弃；格式化器、LSP、重构与**宏展开**都需要「源码原文 + 每个 token 的
-- 精确 span + 注释归属」。把这些信息在词法层一次性物化成 CST（token 携带其前置
-- trivia），工具侧就不必再从字节偏移反推文本，宏也能直接拿原始片段做 span 映射。
--
-- 两层表示：
--   * token 流（`lexCst`）：无损还原的最小信息，LSP 等只要 token 的消费者用这一层；
--   * 节点树（`buildCst`）：在 token 流之上按**布局**（行首缩进）与括号配对建节点，
--     每个节点只有 kind / span / children，叶节点就是 token。offside 布局规则
--     （`canContinue` / 块起始列）在本模块实现一次，parser 与格式化器共用。
-- 节点树不复制 token 文本：叶节点直接持有 `CstToken`，所以 `renderCstTree` 与
-- `renderCst` 对同一份源码逐字节一致。
--
-- **核心不变量**：对任意 `lexSource` 成功的源码 s，`renderCst (lexCst s) == s`，
-- 即「所有 trivia 文本按顺序拼接 + 所有 token 原文拼接 == s」。为守住它：
--   * token 文本一律取**源码原文**，不用解码值（`TInt` 贪心重扫数字，`007` 的
--     解码值 `7` 与原文不等；字符串重扫原始字面量以保留转义；模板由 token 自带的
--     `endPos`（结束引号位置）定界）；
--   * token 之间的字节 = 「上一 token 结束偏移 → 当前 token 起始偏移」的**全部字节**，
--     按注释表切成注释项，剩下的每一段都是空白项；
--   * `TEof` 是最后一个 token（原文为空串），它把文件末尾的 trivia 也收进 `cstLeading`。
--
-- **复杂度**：偏移由一条**单调前进**的行/列游标给出（`advanceTo` / `advanceBy`）：
-- token、注释都按源码顺序处理，整份文件只扫一遍（O(bytes)）。旧实现用「行表 + 每个
-- token 从行首累加」求偏移，是 O(tokens × lines)，大文件上会退化。
-- token 流与注释表来自 lexer 的**同一次扫描**（`lexSourceWithComments`），本模块不再
-- 触发第二次全量词法。
--
-- 位置约定与 lexer 一致：行、列从 1 开始，列 = UTF-8 字节（`strUnpack` 给字节）。
-- 本模块的 span 文件字段统一为 `""`，由调用方在需要时注入真实路径。
import Base.Data.Bool as Bool
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.ObsSpan as ObsSpan
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Lexer

-- | trivia 的种类：空白、行注释、块注释。
export data TriviaKind(..) : Type where
  -- | 空白（空格 / tab / 换行 / 回车）。
  TrivSpace : TriviaKind
  -- | `--` 行注释（不含行尾换行）。
  TrivLineComment : TriviaKind
  -- | `{- ... -}` 块注释（可嵌套）。
  TrivBlockComment : TriviaKind

-- | 一段 trivia：种类 + 源码原文 + span。
export record Trivia(..) where
  -- | trivia 的种类。
  triviaKind : TriviaKind
  -- | 该 trivia 在源码里的原始文本（逐字节）。
  triviaText : String
  -- | 该 trivia 的 span（文件字段为 `""`）。
  triviaSpan : Span

-- | 一个 CST token：形态 tag + 源码原文 + span + 前置 trivia。
export record CstToken(..) where
  -- | token 形态：`ident` / `kw` / `int` / `float` / `str` / `tmpl` / `sym` / `eof`。
  cstTag : String
  -- | 该 token 在源码里的原始文本（逐字节）。
  cstText : String
  -- | token 的 span（文件字段为 `""`；结束位置 = 起点 + 文本长度）。
  cstSpan : Span
  -- | token 之前、上一个 token 之后的 trivia（源码顺序）。
  cstLeading : List Trivia

-- ---------------------------------------------------------------
-- 行/列 + 字节偏移的单调游标
-- ---------------------------------------------------------------
-- | 位置 + 字节偏移。token 与注释在源码里单向排列，所以游标只前进不后退：
-- 整份文件的所有偏移由一次前向扫描算出（O(bytes)），不需要行表。
record LineCur where
  lcOff : Int
  lcLine : Int
  lcCol : Int
  lcOffset : Int

lineCurStart : LineCur
lineCurStart = LineCur 0 1 1 0

curPos : LineCur -> Pos
curPos c = Pos c.lcLine c.lcCol c.lcOffset c.lcOffset

-- | 前进一个字节（换行把列复位）。
stepCur : String -> LineCur -> LineCur
stepCur src c =
  if strAt src c.lcOff == 10 then
    LineCur (c.lcOff + 1) (c.lcLine + 1) 1 (c.lcOffset + 1)
  else
    LineCur (c.lcOff + 1) c.lcLine (c.lcCol + 1) (c.lcOffset + 1)

-- | 前进到目标位置（目标在游标之后；已在目标或越界时钳住）。
-- | fuel 是终止性证据（游标前进不体现在参数结构上）；调用方给「剩余字节数」量级的值。
advanceTo : Int -> String -> LineCur -> Pos -> LineCur
advanceTo fuel src c target =
  if fuel <= 0 then
    c
  else if c.lcLine > posLine target || c.lcLine == posLine target && c.lcCol >= posCol target then
    c
  else if c.lcOff >= strLength src then c else advanceTo (fuel - 1) src (stepCur src c) target

-- | 前进 `n` 个字节（用于按原文长度求 token 结束位置）。
advanceBy : Int -> String -> LineCur -> Int -> LineCur
advanceBy fuel src c n =
  if fuel <= 0 then
    c
  else if n <= 0 then
    c
  else if c.lcOff >= strLength src then c else advanceBy (fuel - 1) src (stepCur src c) (n - 1)

-- | `[from, to)` 的源码原文（空区间给空串）。
sliceText : String -> Int -> Int -> String
sliceText src from to = if to <= from then "" else strSubstring from (to - from) src

-- ---------------------------------------------------------------
-- token 原文（贪心 extent）
-- ---------------------------------------------------------------
-- | 数字串结束偏移：从 `start` 贪心扫数字（`007` 的原文与解码值不同，必须重扫）。
scanDigitsEnd : Int -> String -> Int -> Int
scanDigitsEnd fuel src i =
  if fuel <= 0 then i else if isDigit (strAt src i) then scanDigitsEnd (fuel - 1) src (i + 1) else i

-- | 单行字符串结束偏移（尾后）：`i` 在开引号之后；`\` 后的下一字节整体跳过，
-- 未转义的 `"` 是结束引号（含在文本里）。
scanStringEnd : Int -> String -> Int -> Int
scanStringEnd fuel src i =
  if fuel <= 0 then
    i
  else if strAt src i == 92 then
    scanStringEnd (fuel - 2) src (i + 2)
  else if strAt src i == 34 then i + 1 else scanStringEnd (fuel - 1) src (i + 1)

-- | token 形态 tag（`TEof` 是空串原文）。
tokTag : Tok -> String
tokTag (TIdent _) = "ident"
tokTag (TKw _) = "kw"
tokTag (TInt _) = "int"
tokTag (TFloat _) = "float"
tokTag (TStr _) = "str"
tokTag (TTmpl _ _ _) = "tmpl"
tokTag (TSym _) = "sym"
tokTag TEof = "eof"

-- | 一个 token 的源码原文与尾后偏移。模板用 token 自带的 `endPos`（结束引号位置）
-- 定界（多行文本里含换行，按位置推进才能算对）。
tokText : String -> LineCur -> Tok -> Pair String Int
tokText src c (TIdent s) = Pair s (c.lcOff + strLength s)
tokText src c (TKw s) = Pair s (c.lcOff + strLength s)
tokText src c (TSym s) = Pair s (c.lcOff + strLength s)
tokText src c (TFloat s) = Pair s (c.lcOff + strLength s)
tokText src c (TInt _) =
  let
    end = scanDigitsEnd (strLength src) src c.lcOff
  in Pair (sliceText src c.lcOff end) end
tokText src c (TStr _) =
  let
    end = scanStringEnd (strLength src) src (c.lcOff + 1)
  in Pair (sliceText src c.lcOff end) end
tokText src c (TTmpl _ _ endPos) =
  let
    endCur = advanceTo (strLength src) src c endPos
    end = endCur.lcOff + 1
  in Pair (sliceText src c.lcOff end) end
tokText src c TEof = Pair "" c.lcOff

-- ---------------------------------------------------------------
-- trivia 切分
-- ---------------------------------------------------------------
-- | 注释的预计算区间：`tcommStart` 含首字符，`tcommEnd` 是尾后偏移。
record TrivComment where
  tcommKind : CKind
  tcommSpan : Span
  tcommStart : Int
  tcommEnd : Int

-- | `Comment` → 预计算区间。注释按源码顺序，游标只前进（每条一次位置推进 + 1 字节）。
toTrivComments : Int -> String -> LineCur -> List Comment -> Pair (List TrivComment) LineCur
toTrivComments fuel src cur [] = Pair [] cur
toTrivComments fuel src cur ((Comment kind _ sp) :: rest) =
  let
    c1 = advanceTo fuel src cur (spanStartOf sp)
    c2 = advanceTo fuel src c1 (spanEndOf sp)
    c3 = advanceBy fuel src c2 1
    tailRes = toTrivComments fuel src c3 rest
  in Pair (TrivComment kind sp c1.lcOff c3.lcOff :: firstOf tailRes) (secondOf tailRes)

-- | 注释 span 的起点（`Span` 的字段投影写成具名 helper，避免模式匹配噪音）。
spanStartOf : Span -> Pos
spanStartOf sp = Pos (spanStartLine sp) (spanStartCol sp) (spanStartOffset sp) (spanStartOffset sp)

spanEndOf : Span -> Pos
spanEndOf sp = Pos (spanEndLine sp) (spanEndCol sp) (spanEndOffset sp) (spanEndOffset sp)

-- | 空白 trivia：区间非空时一项；span 用区间两端的位置。
spaceTrivia : String -> Pair Int Pos -> Pair Int Pos -> List Trivia
spaceTrivia src from to =
  let
    fo = firstOf from
    to2 = firstOf to
  in if to2 <= fo then
    []
  else
    let
      fp = secondOf from
      tp = secondOf to
    in [Trivia TrivSpace (sliceText src fo to2) (Span "" (posLine fp) (posCol fp) (posLine tp) (posCol tp) (posOffset fp) (posOffset tp))]

-- | `CKind` → `TriviaKind`。
commentTriviaKind : CKind -> TriviaKind
commentTriviaKind CLine = TrivLineComment
commentTriviaKind CBlock = TrivBlockComment

-- | 注释 trivia：文本取源码 `[start, end)` 原文（`commentText` 被 trim 过，不能用）；
-- | span 直接用 lexer 给出的那份。
commentTrivia : String -> TrivComment -> Trivia
commentTrivia src tc =
  let
    start = tc.tcommStart
  in Trivia (commentTriviaKind tc.tcommKind) (sliceText src start tc.tcommEnd) tc.tcommSpan

-- | 注释尾后位置（`tcommEnd` 是尾后偏移，最后一个正文字符不是换行 ⇒ 列 +1）。
commentEndPos : TrivComment -> Pair Int Pos
commentEndPos tc =
  let
    endSp = tc.tcommSpan
  in Pair tc.tcommEnd (advanceChar 0 (spanEndOf endSp))

-- | 把 gap `[from, to)` 切成 trivia 列表：注释之间是空白。
gapTrivia : String -> Pair Int Pos -> Pair Int Pos -> List TrivComment -> List Trivia
gapTrivia src from to [] = spaceTrivia src from to
gapTrivia src from to (c :: rest) =
  let
    cStart = Pair c.tcommStart (spanStartOf c.tcommSpan)
  in append
    (spaceTrivia src from cStart)
    (append [commentTrivia src c] (gapTrivia src (commentEndPos c) to rest))

-- | 取起始偏移严格小于 `bound` 的注释前缀，其余留给后续 token。
takeCommentsBefore : Int -> List TrivComment -> Pair (List TrivComment) (List TrivComment)
takeCommentsBefore bound [] = Pair [] []
takeCommentsBefore bound (c :: rest) =
  if c.tcommStart < bound then
    let
      taken = takeCommentsBefore bound rest
    in Pair (c :: firstOf taken) (secondOf taken)
  else
    Pair [] (c :: rest)

-- | 丢弃落在上一 token 内部的注释（保守过滤；模板洞内的注释本就不报告）。
commentStartsAtOrAfter : Int -> TrivComment -> Bool
commentStartsAtOrAfter bound c = c.tcommStart >= bound

-- ---------------------------------------------------------------
-- 组装 token 流
-- ---------------------------------------------------------------
-- | 单个 token 的 CST 节点 + 结束游标。`prevEnd` 是上一 token 的（尾后偏移, 位置），
-- | `comments` 是本 gap 内（上一 token 之后、本 token 之前）的注释。
tokenNode : String -> LineCur -> Pair Int Pos -> List TrivComment -> Tok -> Pair CstToken LineCur
tokenNode src curStart prevEnd comments tok =
  let
    textEnd = tokText src curStart tok
    text = firstOf textEnd
    end = secondOf textEnd
    curEnd = advanceBy (strLength src) src curStart (end - curStart.lcOff)
    startPos = curPos curStart
    sp =
      Span
        ""
        (posLine startPos)
        (posCol startPos)
        (posLine (curPos curEnd))
        (posCol (curPos curEnd))
        (posOffset startPos)
        (posOffset (curPos curEnd))
  in Pair
    (CstToken (tokTag tok) text sp (gapTrivia src prevEnd (Pair curStart.lcOff startPos) comments))
    curEnd

-- | 逐个 token 组装：文本/span/前置 trivia，并把注释游标与 `prevEnd` 传给下一个 token。
buildTokens : String -> List TrivComment -> LineCur -> Pair Int Pos -> List PTok -> List CstToken
buildTokens src comments cur prevEnd [] = []
buildTokens src comments cur prevEnd (t :: rest) =
  let
    curStart = advanceTo (strLength src) src cur t.ptokPos
    start = curStart.lcOff
    before = takeCommentsBefore start comments
    live = filter (commentStartsAtOrAfter (firstOf prevEnd)) (firstOf before)
    node = tokenNode src curStart prevEnd live t.ptokTok
    curEnd = secondOf node
  in firstOf node
    :: buildTokens src (secondOf before) curEnd (Pair curEnd.lcOff (curPos curEnd)) rest

-- | 由**已完成的一次词法**（token 流 + 注释表）组装无损 token 流。
--
-- 工具路径（parser 的 `parseSourceDetailed`）用这一份：它已经为语法分析付过一次词法，
-- 不应为了 trivia 再扫一遍源码。纯组装，不再触发词法。
export lexTokensOf : String -> List PTok -> List Comment -> List CstToken
lexTokensOf source toks comments =
  let
    fuel = strLength source + 1
    tcs = toTrivComments fuel source lineCurStart comments
  in buildTokens source (firstOf tcs) lineCurStart (Pair 0 (Pos 1 1 0 0)) toks

-- | 把源码切成无损 token 流（每个 token 带前置 trivia）；编译器 lexer 拒绝源码
-- （词法错误）时返回 `Nothing`。
export lexCst : String -> Maybe (List CstToken)
lexCst source =
  case lexSourceWithComments source of
    ErrC _ => Nothing
    OkC (Pair toks comments) =>
      Just (obsSpan "vuna.parse.cst" "vuna.phase" (\_ => lexTokensOf source toks comments))

-- | 取 trivia 的原文（`renderCst` 用；具名函数而非 lambda，字段投影需要已知的记录类型）。
triviaTextOf : Trivia -> String
triviaTextOf tr = tr.triviaText

-- | 单个 token 的渲染片段：前置 trivia 原文 + token 原文。
renderParts : CstToken -> List String
renderParts t = append (map triviaTextOf t.cstLeading) [t.cstText]

-- | 把 token 流逐字节还原成源码。
export renderCst : List CstToken -> String
renderCst toks = strConcatMany (concatMap renderParts toks)

-- | `renderCst (lexCst s)` 是否逐字节等于 `s`；词法失败时为 `False`。
export roundtripOk : String -> Bool
roundtripOk s =
  case lexCst s of
    Nothing => False
    Just toks => renderCst toks == s

-- ---------------------------------------------------------------
-- 节点树
-- ---------------------------------------------------------------
-- | 节点种类：文件根、顶层声明、缩进块、括号组。叶节点是 token，没有 kind。
export data CstKind(..) : Type where
  -- | 文件根（children 是顶层声明）。
  CstFileKind : CstKind
  -- | 行首缩进开启的布局块。
  CstBlockKind : CstKind
  -- | 顶层声明（根的直接子节点）。
  CstDeclKind : CstKind
  -- | `(` / `[` / `{` 括号组。
  CstGroupKind : CstKind

-- | 节点：叶是 token，分支是 kind + span + 有序 children。
export data CstNode(..) : Type where
  -- | 叶：一个 token（含其前置 trivia）。
  CstLeaf : CstToken -> CstNode
  -- | 分支：kind / span / 按源码顺序排列的 children。
  CstBranch : CstKind -> Span -> List CstNode -> CstNode

-- | 节点的 span（叶取 token span）。
export nodeSpan : CstNode -> Span
nodeSpan (CstLeaf t) = t.cstSpan
nodeSpan (CstBranch _ sp _) = sp

-- | 节点的 kind；叶节点给 `Nothing`。
export nodeKind : CstNode -> Maybe CstKind
nodeKind (CstLeaf _) = Nothing
nodeKind (CstBranch k _ _) = Just k

-- | 节点的 children；叶节点为空列表。
export nodeChildren : CstNode -> List CstNode
nodeChildren (CstLeaf _) = []
nodeChildren (CstBranch _ _ kids) = kids

-- | 叶 token；分支给 `Nothing`。
export nodeToken : CstNode -> Maybe CstToken
nodeToken (CstLeaf t) = Just t
nodeToken (CstBranch _ _ _) = Nothing

-- | 节点种类的短名（`"file"` / `"decl"` / `"block"` / `"group"`，叶为 `"leaf"`）；
-- 工具侧做结构断言与 dump 时不需要对 `CstKind` 自建相等。
export nodeKindTag : CstNode -> String
nodeKindTag (CstLeaf _) = "leaf"
nodeKindTag (CstBranch k _ _) = cstKindTag k

cstKindTag : CstKind -> String
cstKindTag CstFileKind = "file"
cstKindTag CstDeclKind = "decl"
cstKindTag CstBlockKind = "block"
cstKindTag CstGroupKind = "group"

-- ---------------------------------------------------------------
-- 布局 + 括号分组
-- ---------------------------------------------------------------
-- | 建树时打开的节点：尚未定 span 的分支。
record Frame where
  frameKind : CstKind
  frameCol : Int
  frameStart : Pos
  frameEnd : Pos
  frameKids : List CstNode
  frameStarted : Bool
  frameClose : String

-- | 叶节点并进 frame（children 逆序累积；span 取首 token 起点到末 token 终点）。
attachLeaf : CstToken -> Frame -> Frame
attachLeaf t f =
  let
    sp = t.cstSpan
    start = Pos (spanStartLine sp) (spanStartCol sp) (spanStartOffset sp) (spanStartOffset sp)
    end = Pos (spanEndLine sp) (spanEndCol sp) (spanEndOffset sp) (spanEndOffset sp)
  in Frame
    f.frameKind
    f.frameCol
    (if f.frameStarted then f.frameStart else start)
    end
    (CstLeaf t :: f.frameKids)
    True
    f.frameClose

-- | 叶节点并进栈顶 frame（栈为空时原样返回）。
attachLeafTop : CstToken -> List Frame -> List Frame
attachLeafTop t (f :: rest) = attachLeaf t f :: rest
attachLeafTop t [] = []

-- | 关闭一个 frame：children 反转成源码顺序，span 由累积的首尾位置给出。
closeFrame : Frame -> CstNode
closeFrame f =
  CstBranch
    f.frameKind
    (Span "" (posLine f.frameStart) (posCol f.frameStart) (posLine f.frameEnd) (posCol f.frameEnd) (posOffset f.frameStart) (posOffset f.frameEnd))
    (reverse f.frameKids)

-- | 子节点并进父 frame（子节点已按源码顺序）。
attachNode : CstNode -> Frame -> Frame
attachNode node f =
  let
    sp = nodeSpan node
    start = Pos (spanStartLine sp) (spanStartCol sp) (spanStartOffset sp) (spanStartOffset sp)
    end = Pos (spanEndLine sp) (spanEndCol sp) (spanEndOffset sp) (spanEndOffset sp)
  in Frame
    f.frameKind
    f.frameCol
    (if f.frameStarted then f.frameStart else start)
    end
    (node :: f.frameKids)
    True
    f.frameClose

-- | 关闭栈顶 frame，把结果并入父 frame。
closeTop : List Frame -> List Frame
closeTop (f :: parent :: rest) = attachNode (closeFrame f) parent :: rest
closeTop frames = frames

-- | 关掉所有缩进块（当前 token 列小于块的起始列）。
closeBlocks : Int -> Int -> List Frame -> List Frame
closeBlocks fuel col frames =
  if fuel <= 0 then
    frames
  else
    case frames of
      f :: parent :: rest => if kindIsBlock f.frameKind && col < f.frameCol then closeBlocks (fuel - 1) col (attachNode (closeFrame f) parent :: rest) else frames
      _ => frames

-- | 关掉顶层声明（当前 token 列不大于声明的起始列）。
closeDecls : Int -> Int -> List Frame -> List Frame
closeDecls fuel col frames =
  if fuel <= 0 then
    frames
  else
    case frames of
      f :: parent :: rest => if kindIsDecl f.frameKind && col <= f.frameCol then closeDecls (fuel - 1) col (attachNode (closeFrame f) parent :: rest) else frames
      _ => frames

kindIsBlock : CstKind -> Bool
kindIsBlock CstBlockKind = True
kindIsBlock _ = False

kindIsDecl : CstKind -> Bool
kindIsDecl CstDeclKind = True
kindIsDecl _ = False

kindIsGroup : CstKind -> Bool
kindIsGroup CstGroupKind = True
kindIsGroup _ = False

kindIsFile : CstKind -> Bool
kindIsFile CstFileKind = True
kindIsFile _ = False

-- | frame 栈长（`List.length` 给 `Nat`，fuel 要 `Int`；同 `cstTokCount`）。
frameCount : List Frame -> Int
frameCount [] = 0
frameCount (_ :: rest) = 1 + frameCount rest

-- | 行首 token 的布局处理：先按列关闭块/声明，再按相对列打开新块或新声明。
-- 每次关闭调用最多关「栈长 − 1」个 frame，因此 fuel = 栈长是精确界。
layoutStep : Int -> List Frame -> List Frame
layoutStep col frames =
  let
    f1 = closeBlocks (frameCount frames) col frames
    f2 = closeDecls (frameCount f1) col f1
  in case f2 of
    f :: rest =>
      if kindIsGroup f.frameKind then
        f2
      else if kindIsFile f.frameKind then
        Frame CstDeclKind col (Pos 1 1 0 0) (Pos 1 1 0 0) [] False "" :: f2
      else if col > f.frameCol then
        Frame CstBlockKind col (Pos 1 1 0 0) (Pos 1 1 0 0) [] False "" :: f2
      else
        f2
    [] => f2

-- | 开括号 → 对应的闭括号。
groupCloseOf : String -> Maybe String
groupCloseOf "(" = Just ")"
groupCloseOf "[" = Just "]"
groupCloseOf "{" = Just "}"
groupCloseOf _ = Nothing

-- | token 原文是否等于给定符号（`cstText` 对符号就是原文）。
isSymText : String -> CstToken -> Bool
isSymText s t = t.cstText == s

-- | 当前 token 是否在源码里另起一行（首 token 恒为「新行」）。
isLineStart : Int -> CstToken -> Bool
isLineStart prevLine t = spanStartLine t.cstSpan > prevLine

-- | 逐 token 建树：括号组优先闭合，其次处理行首布局，最后并入叶节点。
buildFrames : Int -> List Frame -> Int -> List CstToken -> List Frame
buildFrames fuel frames prevLine toks =
  if fuel <= 0 then
    frames
  else
    case toks of
      [] => frames
      t :: rest =>
        case frames of
          [] => buildFrames (fuel - 1) frames prevLine rest
          f :: topRest =>
            if kindIsGroup f.frameKind && isSymText f.frameClose t then
              buildFrames (fuel - 1) (closeTop (attachLeafTop t frames)) (spanStartLine t.cstSpan) rest
            else
              let
                line = spanStartLine t.cstSpan
                frames1 = if isLineStart prevLine t && not (t.cstTag == "eof") then layoutStep (spanStartCol t.cstSpan) frames else frames
              in case groupCloseOf t.cstText of
                Just close => buildFrames (fuel - 1) (attachLeafTop t (Frame CstGroupKind 0 (Pos 1 1 0 0) (Pos 1 1 0 0) [] False close :: frames1)) line rest
                Nothing => buildFrames (fuel - 1) (attachLeafTop t frames1) line rest

-- | 关闭剩余 frame，留下文件根。
closeAll : Int -> List Frame -> List Frame
closeAll fuel frames =
  if fuel <= 0 then
    frames
  else
    case frames of
      [f] => [f]
      _ => closeAll (fuel - 1) (closeTop frames)

-- | token 流 → 节点树（根是 `CstFileKind`）。空流得到空根。
export buildCst : List CstToken -> CstNode
buildCst toks =
  let
    root = Frame CstFileKind 1 (Pos 1 1 0 0) (Pos 1 1 0 0) [] False ""
    -- `buildFrames` 每 token 恰消耗 1 步（+1 留边界）；`closeAll` 最多关「栈长 − 1」次。
    frames0 = buildFrames (cstTokCount toks + 1) [root] 0 toks
    frames = closeAll (frameCount frames0) frames0
  in case frames of
    f :: rest => closeFrame f
    [] => CstBranch CstFileKind (Span "" 1 1 1 1 0 0) []

-- | token 数量（`List.length` 给 `Nat`，建树 fuel 要 `Int`）。
cstTokCount : List CstToken -> Int
cstTokCount [] = 0
cstTokCount (t :: rest) = 1 + cstTokCount rest

-- | 节点树逐字节还原源码（叶按源码顺序输出前置 trivia + token 原文）。
export renderCstTree : CstNode -> String
renderCstTree (CstLeaf t) = strConcatMany (renderParts t)
renderCstTree (CstBranch _ _ kids) = strConcatMany (map renderCstTree kids)

-- | `renderCstTree (buildCst (lexCst s)) == s`；词法失败时为 `False`。
export treeRoundtripOk : String -> Bool
treeRoundtripOk s =
  case lexCst s of
    Nothing => False
    Just toks => renderCstTree (buildCst toks) == s
