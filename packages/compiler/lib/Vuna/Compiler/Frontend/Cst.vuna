-- | 无损 CST：携带前置 trivia 的 token 流，外加一层由解析区间驱动的节点树。
module Vuna.Compiler.Frontend.Cst where

-- Vuna.Compiler.Frontend.Cst：**无损**具体语法层（token + trivia + 节点树）。
--
-- 为什么需要它（宏/工具的 span 来源）：parser 只把 span 写进 AST，注释与原始空白
-- 在 parser 里被丢弃；格式化器、LSP、重构与**宏展开**都需要「源码原文 + 每个 token 的
-- 精确 span + 注释归属」。把这些信息在词法层一次性物化成 CST（token 携带其前置
-- trivia），工具侧就不必再从字节偏移反推文本，宏也能直接拿原始片段做 span 映射。
--
-- 两层表示：
--   * token 流（`lexCst`）：无损还原的最小信息，LSP 等只要 token 的消费者用这一层；
--   * 节点树（`nestToTree`）：在 token 流之上按 **parser 给出的 token 区间**建节点。
--     parser 在每个解析点发一条打开/关闭事件（`NodeEvent`），区间由它的递归栈配对，
--     所以事件流天然真嵌套；本模块只做一遍线性组装，**不从缩进或括号反推布局**。
--     offside 布局是文法的一部分（块起始列、case 分支列、`canContinue`），只有 parser
--     知道自己在哪个块里；让 token 流自己猜就是第二套布局语义，会静默漂移。
--     分支节点还带该区间产出的 AST 值（语义载荷 `CstSem`，`EvSem` 在关闭前挂上），
--     AST 因此是树上的投影（`Frontend.AstView.ofTree`），不是并行的第二份结构。
-- 节点树不复制 token 文本：叶节点直接持有 `CstToken`，所以 `renderCstTree` 与
-- `renderCst` 对同一份源码逐字节一致。
--
-- **核心不变量**：对任意 `lexSource` 成功的源码 s，`renderCst (lexCst s) == s`，
-- 即「所有 trivia 文本按顺序拼接 + 所有 token 原文拼接 == s」。为守住它：
--   * token 文本一律取**源码原文**，不用解码值（`TInt` 贪心重扫数字，`007` 的
--     解码值 `7` 与原文不等；字符串重扫原始字面量以保留转义；模板由 token 自带的
--     `endPos`（结束引号位置）定界）；
--   * token 之间的字节 = 「上一 token 结束偏移 → 当前 token 起始偏移」的**全部字节**，
--     按注释表切成注释项，剩下的每一段都是空白项；
--   * `TEof` 是最后一个 token（原文为空串），它把文件末尾的 trivia 也收进 `cstLeading`。
--
-- **复杂度**：偏移由一条**单调前进**的行/列游标给出（`advanceTo` / `advanceBy`）：
-- token、注释都按源码顺序处理，整份文件只扫一遍（O(bytes)）。旧实现用「行表 + 每个
-- token 从行首累加」求偏移，是 O(tokens × lines)，大文件上会退化。
-- token 流与注释表来自 lexer 的**同一次扫描**（`lexSourceWithComments`），本模块不再
-- 触发第二次全量词法。
--
-- 位置约定与 lexer 一致：行、列从 1 开始，列 = UTF-8 字节（`strUnpack` 给字节）。
-- 本模块的 span 文件字段统一为 `""`，由调用方在需要时注入真实路径。
import Base.Container.HashMap as HashMap
import Base.Data.Bool as Bool
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Vuna.Compiler.Base.Obs
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer

-- | trivia 的种类：空白、行注释、块注释。
export data TriviaKind(..) : Type where
  -- | 空白（空格 / tab / 换行 / 回车）。
  TrivSpace : TriviaKind
  -- | `--` 行注释（不含行尾换行）。
  TrivLineComment : TriviaKind
  -- | `{- ... -}` 块注释（可嵌套）。
  TrivBlockComment : TriviaKind

-- | 一段 trivia：种类 + 源码原文 + span。
export record Trivia(..) where
  -- | trivia 的种类。
  triviaKind : TriviaKind
  -- | 该 trivia 在源码里的原始文本（逐字节）。
  triviaText : String
  -- | 该 trivia 的 span（文件字段为 `""`）。
  triviaSpan : Span

-- | 一个 CST token：形态 tag + 源码原文 + span + 前置 trivia。
export record CstToken(..) where
  -- | token 形态：`ident` / `kw` / `int` / `float` / `str` / `tmpl` / `sym` / `eof`。
  cstTag : String
  -- | 该 token 在源码里的原始文本（逐字节）。
  cstText : String
  -- | token 的 span（文件字段为 `""`；结束位置 = 起点 + 文本长度）。
  cstSpan : Span
  -- | token 之前、上一个 token 之后的 trivia（源码顺序）。
  cstLeading : List Trivia

-- ---------------------------------------------------------------
-- 行/列 + 字节偏移的单调游标
-- ---------------------------------------------------------------
-- | 位置 + 字节偏移。token 与注释在源码里单向排列，所以游标只前进不后退：
-- 整份文件的所有偏移由一次前向扫描算出（O(bytes)），不需要行表。
record LineCur where
  lcOff : Int
  lcLine : Int
  lcCol : Int
  lcOffset : Int

lineCurStart : LineCur
lineCurStart = LineCur 0 1 1 0

curPos : LineCur -> Pos
curPos c = Pos c.lcLine c.lcCol c.lcOffset c.lcOffset

-- | 前进一个字节（换行把列复位）。
stepCur : String -> LineCur -> LineCur
stepCur src c =
  if strAt src c.lcOff == 10 then
    LineCur (c.lcOff + 1) (c.lcLine + 1) 1 (c.lcOffset + 1)
  else
    LineCur (c.lcOff + 1) c.lcLine (c.lcCol + 1) (c.lcOffset + 1)

-- | 前进到目标位置（目标在游标之后；已在目标或越界时钳住）。
-- | fuel 是终止性证据（游标前进不体现在参数结构上）；调用方给「剩余字节数」量级的值。
advanceTo : Int -> String -> LineCur -> Pos -> LineCur
advanceTo fuel src c target =
  if fuel <= 0 then
    c
  else if c.lcLine > posLine target || c.lcLine == posLine target && c.lcCol >= posCol target then
    c
  else if c.lcOff >= strLength src then c else advanceTo (fuel - 1) src (stepCur src c) target

-- | 前进 `n` 个字节（用于按原文长度求 token 结束位置）。
advanceBy : Int -> String -> LineCur -> Int -> LineCur
advanceBy fuel src c n =
  if fuel <= 0 then
    c
  else if n <= 0 then
    c
  else if c.lcOff >= strLength src then c else advanceBy (fuel - 1) src (stepCur src c) (n - 1)

-- | `[from, to)` 的源码原文（空区间给空串）。
sliceText : String -> Int -> Int -> String
sliceText src from to = if to <= from then "" else strSubstring from (to - from) src

-- ---------------------------------------------------------------
-- token 原文（贪心 extent）
-- ---------------------------------------------------------------
-- | 数字串结束偏移：从 `start` 贪心扫数字（`007` 的原文与解码值不同，必须重扫）。
scanDigitsEnd : Int -> String -> Int -> Int
scanDigitsEnd fuel src i =
  if fuel <= 0 then i else if isDigit (strAt src i) then scanDigitsEnd (fuel - 1) src (i + 1) else i

-- | 单行字符串结束偏移（尾后）：`i` 在开引号之后；`\` 后的下一字节整体跳过，
-- 未转义的 `"` 是结束引号（含在文本里）。
scanStringEnd : Int -> String -> Int -> Int
scanStringEnd fuel src i =
  if fuel <= 0 then
    i
  else if strAt src i == 92 then
    scanStringEnd (fuel - 2) src (i + 2)
  else if strAt src i == 34 then i + 1 else scanStringEnd (fuel - 1) src (i + 1)

-- | token 形态 tag（`TEof` 是空串原文）。
tokTag : Tok -> String
tokTag (TIdent _) = "ident"
tokTag (TKw _) = "kw"
tokTag (TInt _) = "int"
tokTag (TFloat _) = "float"
tokTag (TStr _) = "str"
tokTag (TTmpl _ _ _) = "tmpl"
tokTag (TSym _) = "sym"
tokTag TEof = "eof"

-- | 一个 token 的源码原文与尾后偏移。模板用 token 自带的 `endPos`（结束引号位置）
-- 定界（多行文本里含换行，按位置推进才能算对）。
tokText : String -> LineCur -> Tok -> (String, Int)
tokText src c (TIdent s) = (s, c.lcOff + strLength s)
tokText src c (TKw s) = (s, c.lcOff + strLength s)
tokText src c (TSym s) = (s, c.lcOff + strLength s)
tokText src c (TFloat s) = (s, c.lcOff + strLength s)
tokText src c (TInt _) =
  let
    end = scanDigitsEnd (strLength src) src c.lcOff
  in (sliceText src c.lcOff end, end)
tokText src c (TStr _) =
  let
    end = scanStringEnd (strLength src) src (c.lcOff + 1)
  in (sliceText src c.lcOff end, end)
tokText src c (TTmpl _ _ endPos) =
  let
    endCur = advanceTo (strLength src) src c endPos
    end = endCur.lcOff + 1
  in (sliceText src c.lcOff end, end)
tokText src c TEof = ("", c.lcOff)

-- ---------------------------------------------------------------
-- trivia 切分
-- ---------------------------------------------------------------
-- | 注释的预计算区间：`tcommStart` 含首字符，`tcommEnd` 是尾后偏移。
record TrivComment where
  tcommKind : CKind
  tcommSpan : Span
  tcommStart : Int
  tcommEnd : Int

-- | `Comment` → 预计算区间。注释按源码顺序，游标只前进（每条一次位置推进 + 1 字节）。
toTrivComments : Int -> String -> LineCur -> List Comment -> (List TrivComment, LineCur)
toTrivComments fuel src cur [] = ([], cur)
toTrivComments fuel src cur ((Comment kind _ sp) :: rest) =
  let
    c1 = advanceTo fuel src cur (spanStartOf sp)
    c2 = advanceTo fuel src c1 (spanEndOf sp)
    c3 = advanceBy fuel src c2 1
    tailRes = toTrivComments fuel src c3 rest
  in (TrivComment kind sp c1.lcOff c3.lcOff :: firstOf tailRes, secondOf tailRes)

-- | 注释 span 的起点（`Span` 的字段投影写成具名 helper，避免模式匹配噪音）。
spanStartOf : Span -> Pos
spanStartOf sp = Pos (spanStartLine sp) (spanStartCol sp) (spanStartOffset sp) (spanStartOffset sp)

spanEndOf : Span -> Pos
spanEndOf sp = Pos (spanEndLine sp) (spanEndCol sp) (spanEndOffset sp) (spanEndOffset sp)

-- | 空白 trivia：区间非空时一项；span 用区间两端的位置。
spaceTrivia : String -> (Int, Pos) -> (Int, Pos) -> List Trivia
spaceTrivia src from to =
  let
    fo = firstOf from
    to2 = firstOf to
  in if to2 <= fo then
    []
  else
    let
      fp = secondOf from
      tp = secondOf to
    in [Trivia TrivSpace (sliceText src fo to2) (Span "" (posLine fp) (posCol fp) (posLine tp) (posCol tp) (posOffset fp) (posOffset tp))]

-- | `CKind` → `TriviaKind`。
commentTriviaKind : CKind -> TriviaKind
commentTriviaKind CLine = TrivLineComment
commentTriviaKind CBlock = TrivBlockComment

-- | 注释 trivia：文本取源码 `[start, end)` 原文（`commentText` 被 trim 过，不能用）；
-- | span 直接用 lexer 给出的那份。
commentTrivia : String -> TrivComment -> Trivia
commentTrivia src tc =
  let
    start = tc.tcommStart
  in Trivia (commentTriviaKind tc.tcommKind) (sliceText src start tc.tcommEnd) tc.tcommSpan

-- | 注释尾后位置（`tcommEnd` 是尾后偏移，最后一个正文字符不是换行 ⇒ 列 +1）。
commentEndPos : TrivComment -> (Int, Pos)
commentEndPos tc =
  let
    endSp = tc.tcommSpan
  in (tc.tcommEnd, advanceChar 0 (spanEndOf endSp))

-- | 把 gap `[from, to)` 切成 trivia 列表：注释之间是空白。
gapTrivia : String -> (Int, Pos) -> (Int, Pos) -> List TrivComment -> List Trivia
gapTrivia src from to [] = spaceTrivia src from to
gapTrivia src from to (c :: rest) =
  let
    cStart = (c.tcommStart, spanStartOf c.tcommSpan)
  in append
    (spaceTrivia src from cStart)
    (append [commentTrivia src c] (gapTrivia src (commentEndPos c) to rest))

-- | 取起始偏移严格小于 `bound` 的注释前缀，其余留给后续 token。
takeCommentsBefore : Int -> List TrivComment -> (List TrivComment, List TrivComment)
takeCommentsBefore bound [] = ([], [])
takeCommentsBefore bound (c :: rest) =
  if c.tcommStart < bound then
    let
      taken = takeCommentsBefore bound rest
    in (c :: firstOf taken, secondOf taken)
  else
    ([], c :: rest)

-- | 丢弃落在上一 token 内部的注释（保守过滤；模板洞内的注释本就不报告）。
commentStartsAtOrAfter : Int -> TrivComment -> Bool
commentStartsAtOrAfter bound c = c.tcommStart >= bound

-- ---------------------------------------------------------------
-- 组装 token 流
-- ---------------------------------------------------------------
-- | 单个 token 的 CST 节点 + 结束游标。`prevEnd` 是上一 token 的（尾后偏移, 位置），
-- | `comments` 是本 gap 内（上一 token 之后、本 token 之前）的注释。
tokenNode : String -> LineCur -> (Int, Pos) -> List TrivComment -> Tok -> (CstToken, LineCur)
tokenNode src curStart prevEnd comments tok =
  let
    textEnd = tokText src curStart tok
    text = firstOf textEnd
    end = secondOf textEnd
    curEnd = advanceBy (strLength src) src curStart (end - curStart.lcOff)
    startPos = curPos curStart
    sp =
      Span
        ""
        (posLine startPos)
        (posCol startPos)
        (posLine (curPos curEnd))
        (posCol (curPos curEnd))
        (posOffset startPos)
        (posOffset (curPos curEnd))
  in (CstToken (tokTag tok) text sp (gapTrivia src prevEnd (curStart.lcOff, startPos) comments),
    curEnd)

-- | 逐个 token 组装：文本/span/前置 trivia，并把注释游标与 `prevEnd` 传给下一个 token。
buildTokens : String -> List TrivComment -> LineCur -> (Int, Pos) -> List PTok -> List CstToken
buildTokens src comments cur prevEnd [] = []
buildTokens src comments cur prevEnd (t :: rest) =
  let
    curStart = advanceTo (strLength src) src cur t.ptokPos
    start = curStart.lcOff
    before = takeCommentsBefore start comments
    live = filter (commentStartsAtOrAfter (firstOf prevEnd)) (firstOf before)
    node = tokenNode src curStart prevEnd live t.ptokTok
    curEnd = secondOf node
  in firstOf node :: buildTokens src (secondOf before) curEnd (curEnd.lcOff, curPos curEnd) rest

-- | 由**已完成的一次词法**（token 流 + 注释表）组装无损 token 流。
--
-- 工具路径（parser 的 `parseSourceDetailed`）用这一份：它已经为语法分析付过一次词法，
-- 不应为了 trivia 再扫一遍源码。纯组装，不再触发词法。
export lexTokensOf : String -> List PTok -> List Comment -> List CstToken
lexTokensOf source toks comments =
  let
    fuel = strLength source + 1
    tcs = toTrivComments fuel source lineCurStart comments
  in buildTokens source (firstOf tcs) lineCurStart (0, Pos 1 1 0 0) toks

-- | 从某个位置开始的 token 流（模板洞的子树用）：起始游标 = 给定位置，只扫洞内那段字节；
-- 洞内不报告注释，gap 一律按原文切片（渲染仍逐字节等价）。
export lexTokensOfFrom : String -> Pos -> List PTok -> List CstToken
lexTokensOfFrom source start toks =
  buildTokens source [] (lineCurAt start) (posOffset start, start) toks

-- | 位置的游标形态（`Pos` 的四个分量在此处一一对应）。
lineCurAt : Pos -> LineCur
lineCurAt p = LineCur (posOffset p) (posLine p) (posCol p) (posOffset p)

-- | 把源码切成无损 token 流（每个 token 带前置 trivia）；编译器 lexer 拒绝源码
-- （词法错误）时返回 `Nothing`。
export lexCst : String -> Maybe (List CstToken)
lexCst source =
  case lexSourceWithComments source of
    ErrC _ => Nothing
    OkC (toks, comments) => Just (obsPure "vuna.parse.cst" (\_ => lexTokensOf source toks comments))

-- | 取 trivia 的原文（`renderCst` 用；具名函数而非 lambda，字段投影需要已知的记录类型）。
triviaTextOf : Trivia -> String
triviaTextOf tr = tr.triviaText

-- | 单个 token 的渲染片段：前置 trivia 原文 + token 原文。
renderParts : CstToken -> List String
renderParts t = append (map triviaTextOf t.cstLeading) [t.cstText]

-- | 把 token 流逐字节还原成源码。
export renderCst : List CstToken -> String
renderCst toks = strConcatMany (concatMap renderParts toks)

-- | `renderCst (lexCst s)` 是否逐字节等于 `s`；词法失败时为 `False`。
export roundtripOk : String -> Bool
roundtripOk s =
  case lexCst s of
    Nothing => False
    Just toks => renderCst toks == s

-- ---------------------------------------------------------------
-- 节点树：由 parser 发出的区间组装
-- ---------------------------------------------------------------
-- | 节点种类。**由 parser 在解析点声明**，不由 token 流的缩进或括号推断：
-- offside 布局（块起始列、case 分支列、`canContinue`）是文法的一部分，只有 parser
-- 知道自己在哪个块里；让 token 流自己猜就是第二套布局语义，会静默漂移。
export data CstKind(..) : Type where
  -- | 文件根（children 是模块头 / import / 声明）。
  CstFileKind : CstKind
  -- | `module ... where` 模块头。
  CstModHeadKind : CstKind
  -- | `import ...` / `export import ...` / `export module ...`。
  CstImportKind : CstKind
  -- | `infixl` / `infixr` / `infix` 声明。
  CstFixityKind : CstKind
  -- | 模块头导出列表里的一项。
  CstExportItemKind : CstKind
  -- | 一条顶层声明（含 `export` / `opaque` 前缀；instance 方法各自成节点）。
  CstDeclKind : CstKind
  -- | `data` 的一个构造器。
  CstCtorKind : CstKind
  -- | `record` 的一个字段。
  CstFieldKind : CstKind
  -- | `trait` 的一条方法签名。
  CstMethodKind : CstKind
  -- | `let` / `where` / `do let` 的一条绑定（签名行或子句各算一条）。
  CstBindingKind : CstKind
  -- | `case` 的一个分支。
  CstAltKind : CstKind
  -- | 一个表达式。
  CstExprKind : CstKind
  -- | 一个模式。
  CstPatKind : CstKind
  -- | `do` 块里的一条语句。
  CstDoStmtKind : CstKind

-- | 表面形状（「怎么写」而不是「是什么」）。挂在产生它的分支节点上。
export record CstSurface(..) where
  -- | 源码里包着这个表达式的括号层数（`(e)` = 1，`((e))` = 2）。
  cstParenDepth : Int
  -- | 这一层是不是**反引号写法**的中缀链步（``a `f` b``）。
  cstBacktick : Bool
  -- | 这一层是不是 section 写法，以及 op 值 / 左 / 右。
  cstSection : Maybe SectionShape
  -- | 模板字面量是否 `"""` 形式。
  cstInterpMulti : Maybe Bool
  -- | 模板节点内部每个洞的**子树**（其它节点为空）。
  --
  -- 洞是独立 token 子流（`PState.subStream`）：洞内节点的 span / id 都在主文件坐标系里，
  -- 但它的 token 已经被 `TTmpl` 这个叶覆盖，所以不能进 `children`（否则字节重复）。
  -- 挂在这里的子树与主树同形，表面事实同样在节点字段上，索引与事实派生都会一起走。
  cstHoleTrees : List CstNode

export emptyCstSurface : CstSurface
emptyCstSurface = CstSurface 0 False Nothing Nothing []

-- | 节点：叶是 token，分支是 kind + id + span + 表面形状 + 语义载荷 + 有序 children。
--
-- 分支的 id 是**先序序号**（文件根 = 0，按 parser 的 `withExtent` 打开顺序递增），
-- 它是节点的身份：span 可以被改写（宏展开、编辑），id 在一次解析内不变。叶节点
-- 没有身份（它们的位置由所属分支与 token 流给出）。
--
-- `CstSem` 是分支的**语义载荷**：parser 在关闭节点时把该区间产出的 AST 值挂上去。
-- AST 因此不是与树并行的第二份结构，而是树上的类型化投影（`Frontend.AstView.ofTree`
-- 只按树节点收集载荷）；工具拿到树节点后直接读它的语法值，不需要再按 id 回查另一棵树。
export data CstNode(..) : Type where
  -- | 叶：一个 token（含其前置 trivia）。
  CstLeaf : CstToken -> CstNode
  -- | 分支：kind / 节点 id / span / 表面形状 / 语义载荷 / 按源码顺序排列的 children。
  CstBranch : CstKind -> Int -> Span -> CstSurface -> Maybe CstSem -> List CstNode -> CstNode

-- | 分支节点的语义载荷：parser 在该区间产出的 AST 值。
--
-- 载荷只在**产生它的那一个节点**上：类型 / 条目节点带 `Decl` / `Import` / `Ctor` 等，
-- 表达式 / 模式 / 绑定 / 分支 / do 语句各自带自己的构造子。文件级投影
-- （`Frontend.AstView.ofTree`）只读顶层节点的载荷；嵌套节点的载荷供工具做
-- 「源码位置 → 语法位置」与后续宏展开使用。
--
-- `SemDecl` 的后两个字段是该声明携带的逐定义导出 / 归约修饰（同一条 `export ...`
-- 只产生一个 `decl` 节点，两者都是这次解析的产物）。
--
-- 载荷是 parser 在该节点**直接产出**的值：后续对 AST 的变换（相邻同名子句合并、
-- 宏展开）不回写树；需要「变换后视图」的消费者仍以自己的 AST 为准。
export data CstSem(..) : Type where
  SemModHead : ModDecl -> CstSem
  SemImport : Import -> CstSem
  -- | `export import B (...)`：普通 import + 重导出项。
  SemReexportImport : Import -> List ExportItem -> CstSem
  -- | `export module C [as X]`：只产生重导出项，没有 `Import`。
  SemExportNamespace : ExportItem -> CstSem
  -- | 模块头里的一个导出项。
  SemExportItem : ExportItem -> CstSem
  SemFixity : FixityDecl -> CstSem
  -- | 顶层 / instance 方法声明；后两个字段是逐定义导出与归约修饰。
  SemDecl : Decl -> Maybe ExportSpec -> Maybe OpacitySpec -> CstSem
  SemCtor : Ctor -> CstSem
  SemField : Field -> CstSem
  SemMethod : TraitMethod -> CstSem
  SemBinding : Binding -> CstSem
  -- | `let` / `where` 的签名行（名字 + 类型 + 该 `binding` 节点的身份）。
  SemBindingSig : String -> Expr -> NodeRef -> CstSem
  SemAlt : Alt -> CstSem
  SemExpr : Expr -> CstSem
  SemPat : Pat -> CstSem
  SemDoStmt : DoStmt -> CstSem

-- | 分支节点的语义载荷；叶节点没有。
export nodeSem : CstNode -> Maybe CstSem
nodeSem (CstLeaf _) = Nothing
nodeSem (CstBranch _ _ _ _ sem _) = sem

-- | 节点的 span（叶取 token span）。
export nodeSpan : CstNode -> Span
nodeSpan (CstLeaf t) = t.cstSpan
nodeSpan (CstBranch _ _ sp _ _ _) = sp

-- | 分支节点的表面形状；叶节点没有。
export nodeSurface : CstNode -> CstSurface
nodeSurface (CstLeaf _) = emptyCstSurface
nodeSurface (CstBranch _ _ _ surface _ _) = surface

-- | 分支节点的 id；叶节点没有身份。
export nodeId : CstNode -> Maybe Int
nodeId (CstLeaf _) = Nothing
nodeId (CstBranch _ nid _ _ _ _) = Just nid

-- | 节点的 kind；叶节点给 `Nothing`。
export nodeKind : CstNode -> Maybe CstKind
nodeKind (CstLeaf _) = Nothing
nodeKind (CstBranch k _ _ _ _ _) = Just k

-- | 节点的 children；叶节点为空列表。
export nodeChildren : CstNode -> List CstNode
nodeChildren (CstLeaf _) = []
nodeChildren (CstBranch _ _ _ _ _ kids) = kids

-- | 叶 token；分支给 `Nothing`。
export nodeToken : CstNode -> Maybe CstToken
nodeToken (CstLeaf t) = Just t
nodeToken (CstBranch _ _ _ _ _ _) = Nothing

-- | 节点种类的短名（叶为 `"leaf"`）；工具侧做结构断言与 dump 时不需要对
-- `CstKind` 自建相等。
export nodeKindTag : CstNode -> String
nodeKindTag (CstLeaf _) = "leaf"
nodeKindTag (CstBranch k _ _ _ _ _) = cstKindTag k

export cstKindTag : CstKind -> String
cstKindTag CstFileKind = "file"
cstKindTag CstModHeadKind = "modhead"
cstKindTag CstImportKind = "import"
cstKindTag CstFixityKind = "fixity"
cstKindTag CstExportItemKind = "exportItem"
cstKindTag CstDeclKind = "decl"
cstKindTag CstCtorKind = "ctor"
cstKindTag CstFieldKind = "field"
cstKindTag CstMethodKind = "method"
cstKindTag CstBindingKind = "binding"
cstKindTag CstAltKind = "alt"
cstKindTag CstExprKind = "expr"
cstKindTag CstPatKind = "pat"
cstKindTag CstDoStmtKind = "doStmt"

-- ---------------------------------------------------------------
-- 建树：由 parser 给出的区间组装
-- ---------------------------------------------------------------
-- | parser 发出的建树事件，用 token 下标（半开区间）描述节点范围。
--
-- 为什么不是「按缩进建树」：offside 布局（块起始列、`canContinue`、case 分支列）
-- 是文法的一部分，只有 parser 知道自己在哪个块里。让 token 流按行首缩进自己猜块，
-- 就是第二套布局语义，会静默漂移。所以区间由 parser 的递归栈配对发出，
-- 本模块只做一遍线性组装。
export data NodeEvent(..) : Type where
  -- | 在 token 下标 `at` 打开节点 `nid`：起点是第 `at` 个 token 的起点。
  -- `nid` 由 parser 分配（文件根 0，其余按 `withExtent` 打开顺序递增），AST 侧存的是同一个值。
  EvOpen : CstKind -> Int -> Int -> NodeEvent
  -- | 给栈顶节点挂语义载荷（body 成功回流、`EvClose` 之前发一次）。
  EvSem : Int -> CstSem -> NodeEvent
  -- | 关闭最近一个打开的节点：终点是 token 下标（半开，`at` = 最后一个成员之后）。
  EvClose : Int -> NodeEvent

-- | 建树时的打开帧：kind + id + 起点 span + children（逆序累积）+ 语义载荷。
record NestFrame where
  nfKind : CstKind
  nfId : Int
  nfStart : Span
  nfKids : List CstNode
  nfSem : Maybe CstSem

-- | 两个 span 的合并：取前者的起点、后者的终点。
spanFrom : Span -> Span -> Span
spanFrom a b =
  Span
    ""
    (spanStartLine a)
    (spanStartCol a)
    (spanEndLine b)
    (spanEndCol b)
    (spanStartOffset a)
    (spanEndOffset b)

-- | 空区间的兜底 span（退化节点不该出现；用它而不是崩掉）。
degenerateSpan : Span
degenerateSpan = Span "" 1 1 1 1 0 0

-- | 一份列表里最后一个 span（空列表给 `d`）。
lastSpanOfList : Span -> List Span -> Span
lastSpanOfList d [] = d
lastSpanOfList d (s :: rest) = lastSpanOfList s rest

-- | 一组节点的末节点终点（空列表给 `d`）。
lastSpanOf : Span -> List CstNode -> Span
lastSpanOf d kids = lastSpanOfList d (map nodeSpan kids)

-- | 当前剩余 token 里首 token 的 span（空列表给 `d`）。
headSpan : Span -> List CstToken -> Span
headSpan d [] = d
headSpan d (t :: _) = t.cstSpan

-- | 关闭一帧：children 反转成源码顺序，span 从起点到末 child 的终点。
finishFrame : NestFrame -> CstNode
finishFrame f =
  let
    kids = reverse f.nfKids
    endSp = lastSpanOf f.nfStart kids
  in CstBranch f.nfKind f.nfId (spanFrom f.nfStart endSp) emptyCstSurface f.nfSem kids

-- | 叶节点并进栈顶帧（栈为空时丢弃：框架外的事件由收尾统一处理）。
pushLeaves : List CstNode -> List NestFrame -> List NestFrame
pushLeaves nodes [] = []
pushLeaves nodes (f :: rest) =
  NestFrame f.nfKind f.nfId f.nfStart (append (reverse nodes) f.nfKids) f.nfSem :: rest

-- | 子节点并进单个帧。
pushInto : CstNode -> NestFrame -> NestFrame
pushInto node f = NestFrame f.nfKind f.nfId f.nfStart (node :: f.nfKids) f.nfSem

-- | 子节点并进栈顶帧。
pushNode : CstNode -> List NestFrame -> List NestFrame
pushNode node [] = []
pushNode node (f :: rest) = pushInto node f :: rest

-- | 给栈顶帧挂语义载荷（`EvSem` 在 `EvClose` 之前发出，栈顶就是刚解析完的节点）。
attachSem : CstSem -> List NestFrame -> List NestFrame
attachSem sem [] = []
attachSem sem (f :: rest) = NestFrame f.nfKind f.nfId f.nfStart f.nfKids (Just sem) :: rest

-- | 关闭栈顶帧：并入它的父帧。根帧（栈底）不关闭。
closeTopFrame : List NestFrame -> List NestFrame
closeTopFrame [] = []
closeTopFrame [f] = [f]
closeTopFrame (f :: parent :: rest) = (pushInto (finishFrame f) parent) :: rest

-- | 帧栈长（`List.length` 给 `Nat`，收尾的 fuel 要 `Int`）。
nestFrameCount : List NestFrame -> Int
nestFrameCount [] = 0
nestFrameCount (_ :: rest) = 1 + nestFrameCount rest

-- | 收尾：把剩余 token 并入栈顶帧，再逐层并入父帧，直到只剩根帧。
closeAllFrames : Int -> List NestFrame -> List NestFrame
closeAllFrames fuel frames =
  if fuel <= 0 then
    frames
  else
    case frames of
      _ :: _ :: _ => closeAllFrames (fuel - 1) (closeTopFrame frames)
      _ => frames

-- | 事件携带的 token 下标。
eventIndex : NodeEvent -> Int
eventIndex (EvOpen _ at _) = at
eventIndex (EvSem _ _) = 0
eventIndex (EvClose at) = at

-- | 遍历事件流：`live` 是尚未并入树的 token，`cursor` 是已并入的个数；事件里的下标是
-- **绝对** token 下标，所以每个事件先并入 `at - cursor` 个叶，再把 `live` / `cursor` 前推，
-- 最后开 / 关帧。`frames` 的栈底恒为文件根，未被任何区间覆盖的 token（解析恢复跳过的
-- 区段、文件末尾 trivia）因此留在根上，不丢字节。区间与节点 id 都由 parser 的递归栈给出，
-- 事件流天然真嵌套；本函数不做合法性修补。
nestEvents : List CstToken -> Int -> List NestFrame -> List NodeEvent -> List NestFrame
nestEvents live cursor frames [] =
  closeAllFrames (nestFrameCount frames + 1) (pushLeaves (map (\t => CstLeaf t) live) frames)
nestEvents live cursor frames ((EvSem _ sem) :: rest) =
  nestEvents live cursor (attachSem sem frames) rest
nestEvents live cursor frames (ev :: rest) =
  let
    at = eventIndex ev
    n = at - cursor
    live2 = drop n live
    frames1 = pushLeaves (map (\t => CstLeaf t) (take n live)) frames
  in case ev of
    EvSem _ sem => nestEvents live2 at (attachSem sem frames1) rest
    EvOpen kind _ nid =>
      nestEvents
        live2
        at
        (NestFrame kind nid (headSpan degenerateSpan live2) [] Nothing :: frames1)
        rest
    EvClose _ => nestEvents live2 at (closeTopFrame frames1) rest

-- | 根帧收尾：children 反转成源码顺序，span 用整份 token 流。
finishRoot : Span -> List NestFrame -> CstNode
finishRoot sp (f :: _) = CstBranch CstFileKind f.nfId sp emptyCstSurface f.nfSem (reverse f.nfKids)
finishRoot sp [] = CstBranch CstFileKind 0 sp emptyCstSurface Nothing []

-- | 单个 token 的 span（字段投影写成具名 helper，`map` 里需要已知类型）。
tokenSpanOf : CstToken -> Span
tokenSpanOf t = t.cstSpan

-- | token 流的整体 span（首 token 起点 → 末 token 终点）。
tokensSpan : List CstToken -> Span
tokensSpan [] = degenerateSpan
tokensSpan (t :: rest) = spanFrom t.cstSpan (lastSpanOfList t.cstSpan (map tokenSpanOf rest))

-- | token 流 + parser 事件 → 节点树。根是 `CstFileKind`，children 是事件给出的顶层节点。
--
-- **核心不变量**：`collectLeaves (nestToTree toks evs) == toks`（叶序列 == token 序列）
-- 与 `renderCstTree (nestToTree toks evs) == renderCst toks`（逐字节还原）。
export nestToTree : List CstToken -> List NodeEvent -> CstNode
nestToTree toks events =
  let
    root = NestFrame CstFileKind 0 (headSpan degenerateSpan toks) [] Nothing
    frames = nestEvents toks 0 [root] events
    sp = tokensSpan toks
  in finishRoot sp frames

-- | 子流（模板洞）的根：`nestToTree` 的文件根下只有一个表达式节点时取它，否则保留根。
-- 洞内节点本来就在主文件坐标系里（span / id 都不冲突），不需要文件根这层壳。
export holeRootOf : CstNode -> CstNode
holeRootOf node =
  case nodeChildren node of
    [kid] => kid
    _ => node

-- | 把 parser 声明的三类表项（反引号链步 / section / 模板多行）、括号派生结果与每个模板
-- 节点自己的洞子树写进 `CstBranch` 的 `CstSurface`。键是节点 id / 区间起点；
-- 之后 `CstIndex`（工具）与 `FixityFacts`（加载器）都只是这棵树上的定位 / 派生视图。
export nestToTreeWithSurface : List CstToken -> List NodeEvent -> List (Int, Int) -> List (Int, Bool) -> List (Int, SectionShape) -> List (Int, Bool) -> List (Int, List CstNode) -> CstNode
nestToTreeWithSurface toks events parenEntries backticks sections interps holeTrees =
  let
    parens = HashMap.fromList parenEntries
  in applySurfaceTree parens backticks sections interps holeTrees (nestToTree toks events)

applySurfaceTree : HashMap Int Int -> List (Int, Bool) -> List (Int, SectionShape) -> List (Int, Bool) -> List (Int, List CstNode) -> CstNode -> CstNode
applySurfaceTree parens backticks sections interps holeTrees (CstLeaf t) = CstLeaf t
applySurfaceTree parens backticks sections interps holeTrees (CstBranch kind nid sp _ sem kids) =
  let
    parenDepth =
      case HashMap.lookup nid parens of
        Just n => n
        Nothing => 0
    surface =
      CstSurface
        parenDepth
        (lookupBacktick nid backticks)
        (lookupSection (spanStartOffset sp) sections)
        (if lookupInterp (spanStartOffset sp) interps then Just True else Nothing)
        (
          case lookupHoleTrees nid holeTrees of
            Just trees => trees
            Nothing => []
        )
  in CstBranch
    kind
    nid
    sp
    surface
    sem
    (map (applySurfaceTree parens backticks sections interps holeTrees) kids)

lookupHoleTrees : Int -> List (Int, List CstNode) -> Maybe (List CstNode)
lookupHoleTrees nid [] = Nothing
lookupHoleTrees nid ((k, trees) :: rest) = if k == nid then Just trees else lookupHoleTrees nid rest

-- | 保留到建树之后仍要用的表面事实：fixity 重排靠它认括号边界 / 反引号链步 / section。
--
-- 加载器逐文件解析、拿到事实后就丢掉树（树带 token 文本，按模块保留太重），所以这三条
-- 只读事实作为**派生投影**保留下来；它们不是第二个源：从树派生走 `fixityFactsOf`，
-- 加载路径不建主树，直接从 parser 的三张表派生（`fixityFactsOfParts`）。
-- 模板 `"""` 不在这里：只有 Fmt 需要，而 Fmt 有树。
export record FixityFacts(..) where
  ffParens : HashMap Int Int
  ffBackticks : List (Int, Bool)
  ffSections : List (Int, SectionShape)

-- 空 HashMap 的**字面量**在 OCaml 侧会退化成弱类型变量（codegen 不写类型标注），所以用一条
-- `-1` 哨兵钉住类型再删掉它：`-1` 是 `noNodeRef` 的 id（永远不查），表确实是空的。
emptyParenTable : HashMap Int Int
emptyParenTable = HashMap.remove emptyKey (HashMap.fromList [(emptyKey, 0)])

emptyKey : Int
emptyKey = 0 - 1

export emptyFixityFacts : FixityFacts
emptyFixityFacts = FixityFacts emptyParenTable [] []

-- | 从树派生 fixity 需要的事实（主树 + 模板洞子树）。
export fixityFactsOf : CstNode -> FixityFacts
fixityFactsOf root =
  let
    entries = factsGo root emptyFactEntries
  in FixityFacts (HashMap.fromList entries.feParens) entries.feBackticks entries.feSections

-- | 查一个表达式节点的括号层数（没有条目 = 0）。
export parenDepthOfFacts : FixityFacts -> Int -> Int
parenDepthOfFacts f nid =
  case HashMap.lookup nid f.ffParens of
    Just n => n
    Nothing => 0

-- | 这一层是不是**反引号写法**的中缀链步。
export backtickOfFacts : FixityFacts -> Int -> Bool
backtickOfFacts f nid = lookupBacktick nid f.ffBackticks

lookupBacktick : Int -> List (Int, Bool) -> Bool
lookupBacktick nid [] = False
lookupBacktick nid (p :: rest) = if firstOf p == nid then secondOf p else lookupBacktick nid rest

-- | 按 span 起点查 section 写法（同一起点上的条目一致：建树时按起点统一写入）。
export sectionOfFacts : FixityFacts -> Span -> Maybe SectionShape
sectionOfFacts f sp = lookupSection (spanStartOffset sp) f.ffSections

lookupSection : Int -> List (Int, SectionShape) -> Maybe SectionShape
lookupSection off [] = Nothing
lookupSection off (p :: rest) =
  if firstOf p == off then Just (secondOf p) else lookupSection off rest

-- | 模板 `"""` 标记的按区间起点查表。
lookupInterp : Int -> List (Int, Bool) -> Bool
lookupInterp off [] = False
lookupInterp off (p :: rest) = if firstOf p == off then secondOf p else lookupInterp off rest

record FactEntries where
  feParens : List (Int, Int)
  feBackticks : List (Int, Bool)
  feSections : List (Int, SectionShape)

emptyFactEntries : FactEntries
emptyFactEntries = FactEntries [] [] []

factsGo : CstNode -> FactEntries -> FactEntries
factsGo (CstLeaf _) acc = acc
factsGo (CstBranch _ nid sp surface _ kids) acc =
  let
    acc1 =
      if surface.cstParenDepth > 0 then
        { acc | feParens = (nid, surface.cstParenDepth) :: acc.feParens }
      else
        acc
    acc2 =
      if surface.cstBacktick then { acc1 | feBackticks = (nid, True) :: acc1.feBackticks } else acc1
    acc3 =
      case surface.cstSection of
        Just shape => { acc2 | feSections = (spanStartOffset sp, shape) :: acc2.feSections }
        Nothing => acc2
  in factsGoList surface.cstHoleTrees (factsGoList kids acc3)

factsGoList : List CstNode -> FactEntries -> FactEntries
factsGoList [] acc = acc
factsGoList (n :: rest) acc = factsGoList rest (factsGo n acc)

-- | 不建主树，直接从 parser 直出的三张表 + 模板洞子树派生事实。
--
-- 括号表项由 `parenEntriesOf` 在事件流上单趟给出（与建树时写进 `cstParenDepth` 的是同一份），
-- 反引号与 section 由 parser 在解析点登记；只有模板洞必须留子树（洞内 token 不在主 token
-- 流里，洞的括号层数只能从洞自己的事件流算）。与 `fixityFactsOf` 同源同值。
export fixityFactsOfParts : List (Int, Int) -> List (Int, Bool) -> List (Int, SectionShape) -> List CstNode -> FixityFacts
fixityFactsOfParts parens backticks sections holeRoots =
  let
    holes = factsGoList holeRoots emptyFactEntries
    liveParens = List.filter (\p => secondOf p > 0) parens
    liveBackticks = List.filter (\p => secondOf p) backticks
    parenEntries = List.append liveParens holes.feParens
    backtickEntries = List.append liveBackticks holes.feBackticks
    sectionEntries = List.append sections holes.feSections
  in FixityFacts (HashMap.fromList parenEntries) backtickEntries sectionEntries

-- | 树的叶序列（源码顺序）。无损断言用它对齐 token 流。
export collectLeaves : CstNode -> List CstToken
collectLeaves (CstLeaf t) = [t]
collectLeaves (CstBranch _ _ _ _ _ kids) = concatMap collectLeaves kids

-- | 先序的分支节点表（id → 节点）。
nodeTable : CstNode -> List (Int, CstNode)
nodeTable (CstLeaf _) = []
nodeTable (n@(CstBranch _ nid _ _ _ kids)) = (nid, n) :: concatMap nodeTable kids

-- | 整棵树的「id → 节点」索引。节点身份只此一处：span、kind、children 都从这里取，
-- 而不是再按区间比较。
export nodeIndex : CstNode -> HashMap Int CstNode
nodeIndex tree = HashMap.fromList (nodeTable tree)

-- | 表面事实的查询索引：`id → 节点` 与 `span 起点 → 节点`。只做定位，不复制事实
-- （事实在节点字段 `CstSurface` 上）。
--
-- 只收**带事实**的节点（有括号层数或反引号 → id 表；有 section 或模板标记 → span 表），
-- 所以表的大小与事实条数同阶；主树与模板洞的子树一起走。
export record CstIndex(..) where
  ciById : HashMap Int CstNode
  ciBySpan : HashMap Int CstNode

record IndexAcc where
  iaById : List (Int, CstNode)
  iaBySpan : List (Int, CstNode)

emptyIndexAcc : IndexAcc
emptyIndexAcc = IndexAcc [] []

export cstIndexOf : CstNode -> CstIndex
cstIndexOf root =
  let
    acc = indexGo root emptyIndexAcc
  in CstIndex (HashMap.fromList acc.iaById) (HashMap.fromList acc.iaBySpan)

indexGo : CstNode -> IndexAcc -> IndexAcc
indexGo (CstLeaf _) acc = acc
indexGo (n@(CstBranch _ nid sp surface _ kids)) acc =
  let
    hasIdFact = surface.cstParenDepth > 0 || surface.cstBacktick
    hasSpanFact =
      case surface.cstSection of
        Just _ => True
        Nothing =>
          case surface.cstInterpMulti of
            Just _ => True
            Nothing => False
    acc1 = if hasIdFact then { acc | iaById = (nid, n) :: acc.iaById } else acc
    acc2 =
      if hasSpanFact then { acc1 | iaBySpan = (spanStartOffset sp, n) :: acc1.iaBySpan } else acc1
  in indexGoList surface.cstHoleTrees (indexGoList kids acc2)

indexGoList : List CstNode -> IndexAcc -> IndexAcc
indexGoList [] acc = acc
indexGoList (n :: rest) acc = indexGoList rest (indexGo n acc)

-- | 空索引（没有源码位置的位置：接口解码出来的 AST、合成节点）。
export emptyCstIndex : CstIndex
emptyCstIndex = CstIndex emptyNodeTable emptyNodeTable

-- 空 HashMap 的字面量在 OCaml 侧会退化成弱类型变量（同 `emptyParenTable`）：用一条 `-1`
-- 哨兵钉住类型再删掉它。
emptyNodeTable : HashMap Int CstNode
emptyNodeTable =
  HashMap.remove
    emptyKey
    (HashMap.fromList [(emptyKey, CstBranch CstFileKind emptyKey spanEmpty emptyCstSurface Nothing [])])

-- | 表达式节点的括号层数（没有条目 = 0）。
export parenDepthOfIndex : CstIndex -> Int -> Int
parenDepthOfIndex ix nid =
  case HashMap.lookup nid ix.ciById of
    Just n =>
      let
        s = nodeSurface n
      in s.cstParenDepth
    Nothing => 0

-- | 这一层是不是**反引号写法**的中缀链步。
export backtickOfIndex : CstIndex -> Int -> Bool
backtickOfIndex ix nid =
  case HashMap.lookup nid ix.ciById of
    Just n =>
      let
        s = nodeSurface n
      in s.cstBacktick
    Nothing => False

-- | 按 span 起点查 section 写法（同一起点上的节点字段一致：建树时按起点统一写入）。
export sectionOfIndex : CstIndex -> Span -> Maybe SectionShape
sectionOfIndex ix sp =
  case HashMap.lookup (spanStartOffset sp) ix.ciBySpan of
    Just n =>
      let
        s = nodeSurface n
      in s.cstSection
    Nothing => Nothing

-- | 按 span 起点查模板是否 `"""` 形式；没有条目按单行形式。
export interpMultiOfIndex : CstIndex -> Span -> Bool
interpMultiOfIndex ix sp =
  case HashMap.lookup (spanStartOffset sp) ix.ciBySpan of
    Just n =>
      let
        s = nodeSurface n
      in case s.cstInterpMulti of
        Just True => True
        _ => False
    Nothing => False

-- | 节点树逐字节还原源码（叶按源码顺序输出前置 trivia + token 原文）。
export renderCstTree : CstNode -> String
renderCstTree (CstLeaf t) = strConcatMany (renderParts t)
renderCstTree (CstBranch _ _ _ _ _ kids) = strConcatMany (map renderCstTree kids)

-- ---------------------------------------------------------------
-- 条目锚点（注释归属的挂载点）
-- ---------------------------------------------------------------
-- | 树上 kind 满足 `keep` 的条目节点（先序）：给出 `(id, span)`。
--
-- 锚点集合就是渲染器的挂载点；注释归属按节点 id 查槽，顺序无关（调用方会按起点排序）。
export anchorRefsOfTree : (CstKind -> Bool) -> CstNode -> List (Int, Span)
anchorRefsOfTree keep (CstLeaf _) = []
anchorRefsOfTree keep (CstBranch kind nid sp _ _ kids) =
  append (if keep kind then [(nid, sp)] else []) (concatMap (anchorRefsOfTree keep) kids)

-- ---------------------------------------------------------------
-- 表面形状（从建树事件 + 词法 token 派生）
-- ---------------------------------------------------------------

-- | section 的书写形态：op 值 / 左 section / 右 section。括号与操作数由 AST/树提供，
-- 这里只存「这一层是 section、运算符怎么写」；键是 section 区间的起点字节偏移。
export data SectionShape(..) : Type where
  SectionOp : String -> SectionShape
  SectionLeft : String -> SectionShape
  SectionRight : String -> SectionShape

export sectionOpOf : SectionShape -> String
sectionOpOf (SectionOp op) = op
sectionOpOf (SectionLeft op) = op
sectionOpOf (SectionRight op) = op

-- ---------------------------------------------------------------
-- 派生：事件流上的括号层数
-- ---------------------------------------------------------------
-- 括号以两种形态出现在 token 流里，两种都要数到同一个 `(节点 id, 层数)` 上：
--
--   * **包装节点**：表达式从 `(` 开始解析（定义体 / 中缀右操作数 / 括号内层），
--     树里有一个表达式节点覆盖整个 `( ... )`，唯一子节点正好填满括号之间；
--   * **原子位置的括号**：`(f x) y` / `f (a)` / 中缀链左端这类位置不另开表达式节点，
--     内层表达式节点的**前一个 token** 是 `(`、**后一个 token** 是 `)`。
--
-- 第二种是第一种的子节点（包装节点的唯一子节点邻居也是那两个括号），所以层数按
-- `总层数 = 包装层数 + 相邻括号层数` 计算；`structD` 只沿包装链累加，相邻层数不传给父节点。
-- | 派生用的帧：只记括号判定需要的量（种类 / id / 起点 token 下标 / 首尾邻居 token /
-- 直接子节点个数与唯一子节点的包装层数），不收集 children。
record ParenFrame where
  pfKind : CstKind
  pfId : Int
  pfOpen : Int
  pfFirst : Maybe Tok
  pfPrev : Maybe Tok
  pfKids : Int
  pfKidKind : Maybe CstKind
  pfKidOpen : Int
  pfKidEnd : Int
  pfKidStructDepth : Int

openFrame : CstKind -> Int -> Int -> Maybe Tok -> Maybe Tok -> ParenFrame
openFrame kind nid at first prev = ParenFrame kind nid at first prev 0 Nothing 0 0 0

-- | 子节点关闭时并进父帧（区间口径与 `Cst.nestToTree` 一致：open 下标 → close 下标）。
addKid : CstKind -> Int -> Int -> Int -> ParenFrame -> ParenFrame
addKid kind open end structD f =
  ParenFrame f.pfKind f.pfId f.pfOpen f.pfFirst f.pfPrev (f.pfKids + 1) (Just kind) open end structD

-- | 包装节点：区间根是表达式、恰好一个直接子节点、子节点正好填满 `(` 与 `)` 之间的 token
-- （多一个逗号 / 冒号 / 运算符就不算）。
isParenFrame : Int -> Maybe Tok -> ParenFrame -> Bool
isParenFrame endIdx lastTok f =
  case f.pfKind of
    CstExprKind =>
      case f.pfKids of
        1 =>
          case f.pfKidKind of
            Just CstExprKind =>
              isOpenParen f.pfFirst
                && isCloseParen lastTok && f.pfKidOpen == f.pfOpen + 1 && f.pfKidEnd == endIdx - 1
            _ => False
        _ => False
    _ => False

isOpenParen : Maybe Tok -> Bool
isOpenParen (Just (TSym "(")) = True
isOpenParen _ = False

isCloseParen : Maybe Tok -> Bool
isCloseParen (Just (TSym ")")) = True
isCloseParen _ = False

isExprFrame : CstKind -> Bool
isExprFrame CstExprKind = True
isExprFrame _ = False

-- | 原子位置的括号：表达式节点被一对 `(` `)` 紧贴包着（不含包装节点自己那对）。
adjacentParenDepth : CstKind -> Maybe Tok -> Maybe Tok -> Int
adjacentParenDepth kind prev next =
  if isExprFrame kind && isOpenParen prev && isCloseParen next then 1 else 0

-- | 消费 `n` 个 token：返回（剩余 token, 最后一个被消费的 token）。
consumeParen : Int -> Maybe Tok -> List PTok -> (List PTok, Maybe Tok)
consumeParen n last toks =
  if n <= 0 then
    (toks, last)
  else
    case toks of
      [] => ([], last)
      t :: rest => consumeParen (n - 1) (Just t.ptokTok) rest

headTokOf : List PTok -> Maybe Tok
headTokOf [] = Nothing
headTokOf (t :: _) = Just t.ptokTok

-- | 事件流 → `(节点 id, 括号层数)` 表项（逆序累积；键不重复）。
parenWalk : List (Int, Int) -> List ParenFrame -> Int -> Maybe Tok -> List PTok -> List NodeEvent -> List (Int, Int)
parenWalk acc frames cursor lastTok toks [] = acc
parenWalk acc frames cursor lastTok toks ((EvSem _ _) :: rest) =
  parenWalk acc frames cursor lastTok toks rest
parenWalk acc frames cursor lastTok toks ((EvOpen kind at nid) :: rest) =
  let
    step = consumeParen (at - cursor) lastTok toks
    live = firstOf step
    last2 = secondOf step
  in parenWalk acc (openFrame kind nid at (headTokOf live) last2 :: frames) at last2 live rest
parenWalk acc frames cursor lastTok toks ((EvClose at) :: rest) =
  let
    step = consumeParen (at - cursor) lastTok toks
    live = firstOf step
    last2 = secondOf step
  in case frames of
    [] => parenWalk acc [] at last2 live rest
    f :: outer =>
      let
        structD = if isParenFrame at last2 f then f.pfKidStructDepth + 1 else 0
        total = structD + adjacentParenDepth f.pfKind f.pfPrev (headTokOf live)
        acc2 = if total > 0 then (f.pfId, total) :: acc else acc
        outer2 =
          case outer of
            [] => []
            p :: ps => addKid f.pfKind f.pfOpen at structD p :: ps
      in parenWalk acc2 outer2 at last2 live rest

-- | 只取括号表项（事件 + token 流；建树前先算，写进节点的 `cstParenDepth`）。
export parenEntriesOf : List PTok -> List NodeEvent -> List (Int, Int)
parenEntriesOf toks events = parenWalk [] [] 0 Nothing toks events
