# matrix: effect-native
# 105e) native 后端：尾调用、闭包与标量代码生成。
#     尾位置内联、自递归循环、高阶参数特化、闭包静态化、范围信息、浮点树与标量内联。
# 9ab) 尾调用：互递归（even/odd）400 万层在默认 8 MiB 栈上跑完（不尾调用会栈溢出）。
run: sh -c 'd="$TMPDIR/tcomutual"; mkdir -p "$d/app"; printf "[package]\nname = \"tcomutual\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "even : Int -> Bool\neven n = if n <= 0 then True else odd (n - 1)\n\nodd : Int -> Bool\nodd n = if n <= 0 then False else even (n - 1)\n\nmain : Int\nmain = if even 4000000 then 1 else 0\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcomutual-out" "$d"'
exit: 0
run: "$TMPDIR/tcomutual-out/bin/tcomutual" 2>&1
exit: 0
out-equals: 1
file-contains: $TMPDIR/tcomutual-out/Main.s jmp .L
run: sh -c '! grep -q "vuna_odd" "$TMPDIR/tcomutual-out/Main.s"'

# 9ac) 自递归尾调用：9 参自递归（3 个栈参数）走本地循环，常量栈跑完 100 万层；
#      循环回边是函数内 label，不再 `jmp vuna_step`。
run: sh -c 'd="$TMPDIR/tcowide"; mkdir -p "$d/app"; printf "[package]\nname = \"tcowide\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "step : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\nstep a b c d e f g h n =\n  if n <= 0 then a + b + c + d + e + f + g + h\n  else step (a + 1) b c d e f g h (n - 1)\n\nmain : Int\nmain = step 0 0 0 0 0 0 0 1 1000000\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcowide-out" "$d"'
exit: 0
run: "$TMPDIR/tcowide-out/bin/tcowide" 2>&1
exit: 0
out-equals: 1000001
file-contains: $TMPDIR/tcowide-out/Main.s jmp .L
run: sh -c '! grep -q "jmp vuna_step$" "$TMPDIR/tcowide-out/Main.s"'

# 9ad) 尾位置穿透 `if` / `case` / `natCase`：三种形状的深递归都在常量栈上跑完。
run: sh -c 'd="$TMPDIR/tcopos"; mkdir -p "$d/app"; printf "[package]\nname = \"tcopos\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\ndata Chain : Type where\n  Nil2 : Chain\n  Cons2 : Chain -> Chain\n\nbuild : Int -> Chain -> Chain\nbuild n acc = if n <= 0 then acc else build (n - 1) (Cons2 acc)\n\nifTail : Int -> Int\nifTail n = if n <= 0 then 0 else ifTail (n - 1)\n\nchainTail : Chain -> Int\nchainTail c = case c of\n  Nil2 => 0\n  Cons2 k => chainTail k\n\nnatTail : Nat -> Int\nnatTail n = case n of\n  Zero => 0\n  Succ k => natTail k\n\nmain : Int\nmain = ifTail 300000 + chainTail (build 300000 Nil2) + natTail (natFromInt 300000)\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcopos-out" "$d"'
exit: 0
run: "$TMPDIR/tcopos-out/bin/tcopos" 2>&1
exit: 0
out-equals: 0

# 9ae) 来参区不够且被调不可尾内联时：窄函数尾调 8 参宽函数回退普通 `call`，语义不变；
#      `Main.s` 里该调用点是 `call`，而宽函数尾调窄函数（够用）仍是 `jmp`。
run: sh -c 'd="$TMPDIR/tcofb"; mkdir -p "$d/app"; printf "[package]\nname = \"tcofb\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "narrow : Int -> Int\nnarrow n = if n <= 0 then 42 else wide8 (n - 1) (strLength \"x\") 2 3 4 5 6 n\n\nwide8 : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\nwide8 n a b c d e f g = narrow n\n\nmain : Int\nmain = narrow 50000\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcofb-out" "$d"'
exit: 0
run: "$TMPDIR/tcofb-out/bin/tcofb" 2>&1
exit: 0
out-equals: 42
run: sh -c 'grep -q "call vuna_wide8" "$TMPDIR/tcofb-out/Main.s"'
exit: 0
run: sh -c '! grep -q "jmp vuna_wide8" "$TMPDIR/tcofb-out/Main.s"'
exit: 0
run: sh -c 'grep -q "jmp vuna_narrow" "$TMPDIR/tcofb-out/Main.s"'
exit: 0

# 9ae2) Nat 前驱就地更新：`Succ k` 的 k 写回 scrutinee 的槽，尾递归循环没有临时槽
#       往返；饱和加法走分支，热路径的循环携带链只有一次 `add`。
run: sh -c 'd="$TMPDIR/natloop"; mkdir -p "$d/app"; printf "[package]\nname = \"natloop\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nloop : Nat -> Nat -> Nat\nloop acc 0 = acc\nloop acc (Succ k) = loop (Nat.plus acc k) k\n\nmain : Int\nmain = Nat.toInt (loop 0 (Nat.fromIntClamp 100000))\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/natloop-out" "$d"'
exit: 0
run: "$TMPDIR/natloop-out/bin/natloop" 2>&1
exit: 0
out-equals: 4999950000
run: sh -c '! awk '"'"'/vuna_loop_x36_sumfast_x36_loop:/"{f=1;next} f&&/^  \.L/{g=1} f&&/^\.globl/{exit} g{print}'"'"' "$TMPDIR/natloop-out/Main.s" | grep -q "\[rbp"'
exit: 0
run: sh -c '! grep -q "call rt_nat_add" "$TMPDIR/natloop-out/Main.s"'
exit: 0
file-contains: $TMPDIR/natloop-out/Main.s jle .L

# 9ae3) Nat 乘常数：`Nat.fromIntClamp 3` 在编译期折成 3，`Nat.mult` 的 0..4 常量走
#       `imul` + 无符号 `cmova`（不再有通用 NatMul 的 `cmovno`）。
run: sh -c 'd="$TMPDIR/natmul"; mkdir -p "$d/app"; printf "[package]\nname = \"natmul\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nloop : Nat -> Nat -> Nat\nloop acc 0 = acc\nloop acc (Succ k) = loop (Nat.plus acc (Nat.mult k 3)) k\n\nmain : Int\nmain = Nat.toInt (loop 0 (Nat.fromIntClamp 800000))\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/natmul-out" "$d"'
exit: 0
run: "$TMPDIR/natmul-out/bin/natmul" 2>&1
exit: 0
out-equals: 959998800000
run: sh -c '! grep -q "cmovno" "$TMPDIR/natmul-out/Main.s"'
exit: 0

# 9ae4) 循环归纳变量消去：`(n - 5000000) / 1000` 与 `n - 1` 同步递减，只保留
#        `m = n - 5000000`；守卫变成 `cmp m, -5000000`，循环里不再重算 `n - 5000000`。
run: sh -c 'd="$TMPDIR/lsr"; mkdir -p "$d/app"; printf "[package]\nname = \"lsr\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "loop : Int -> Int -> Int\nloop acc n = if n <= 0 then acc else loop (acc + (n - 5000000) / 1000) (n - 1)\n\nmain : Int\nmain = loop 0 1000000\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/lsr-out" "$d"'
exit: 0
run: "$TMPDIR/lsr-out/bin/lsr" 2>&1
exit: 0
out-equals: -4499500000
run: sh -c 'grep -Eq "  cmp r[a-z0-9]+, -5000000" "$TMPDIR/lsr-out/Main.s"'
exit: 0
run: sh -c '! grep -q "sub rax, 5000000" "$TMPDIR/lsr-out/Main.s"'
exit: 0

# 9af) 尾调用 × 续延 × GC：resume 之后的尾递归循环在 `GC_STRESS` 下输出一致。
run: sh -c 'd="$TMPDIR/tcoeff"; mkdir -p "$d/app"; printf "[package]\nname = \"tcoeff\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Nat as Nat\nimport Base.Data.String as String\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nloop : Nat -> Int -> Int\nloop n acc = case n of\n  Zero => acc\n  Succ k => loop k (acc + strLength (strFromInt k))\n\nwork : Eff [POp] Int\nwork = do\n  x <- perform (P 1)\n  pure (loop (natFromInt 20000) x)\n\nmain : Int\nmain = runPure (handle work { P n k -> k n })\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcoeff-out" "$d"'
exit: 0
run: "$TMPDIR/tcoeff-out/bin/tcoeff" 2>&1
exit: 0
out-equals: 88891
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/tcoeff-out/bin/tcoeff" 2>&1'
exit: 0
out-equals: 88891

# 9ag) 尾调用不影响确定性：带尾调用的程序两次 compile 的文件集逐字节一致。
run: sh -c 'timeout 120 "$VUNA" compile "$TMPDIR/tcowide/app/Main.vuna" "$TMPDIR/dettco-a" --target native; timeout 120 "$VUNA" compile "$TMPDIR/tcowide/app/Main.vuna" "$TMPDIR/dettco-b" --target native; diff -r "$TMPDIR/dettco-a" "$TMPDIR/dettco-b"'
exit: 0

# 9ah) 闭包体的来参区按闭包 ABI 算（`rdi` 占掉一个寄存器）：8 参 lambda 尾调 10 参函数
#      正好用满 32 字节来参区，仍然发 `jmp`；wide10 自己的递归走本地循环。
#      lambda 捕获 `k`，避免高阶参数特化把闭包消掉（特化后按标准 ABI 算来参区，只够回退 call）。
run: sh -c 'd="$TMPDIR/tcolam"; mkdir -p "$d/app"; printf "[package]\nname = \"tcolam\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "wide10 : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\nwide10 a b c d e f g h i n =\n  if n <= 0 then a + b + c + d + e + f + g + h + i\n  else wide10 a b c d e f g h i (n - 1)\n\napply8 : (Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int) -> Int\napply8 f = f 1 2 3 4 5 6 7 8\n\nrun : Int -> Int\nrun k = apply8 (\\\\a, b, c, d, e, f, g, h => wide10 a b c d e f g h k 100000)\n\nmain : Int\nmain = run 0\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcolam-out" "$d"'
exit: 0
run: "$TMPDIR/tcolam-out/bin/tcolam" 2>&1
exit: 0
out-equals: 36
run: sh -c 'grep -c "jmp vuna_wide10$" "$TMPDIR/tcolam-out/Main.s"'
out-equals: 1

# 9aj) 范围信息：守卫支配的计数器递减不再 wrap，非负常量除法走一条 `shr`。
run: sh -c 'd="$TMPDIR/rangeloop"; mkdir -p "$d/app"; printf "[package]\nname = \"rangeloop\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Bits as Bits\n\nloop : Int -> Int -> Int\nloop acc n = if n <= 0 then acc else loop (bxor acc (n / 2)) (n - 1)\n\nmain : Int\nmain = loop 0 20000000\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/rangeloop-out" "$d"'
exit: 0
run: "$TMPDIR/rangeloop-out/bin/rangeloop" 2>&1
exit: 0
out-equals: 10000000
run: sh -c 'grep -q "shr " "$TMPDIR/rangeloop-out/Main.s"'
exit: 0
run: sh -c '! grep -q "cmovns" "$TMPDIR/rangeloop-out/Main.s"'
exit: 0
run: sh -c '! grep -q "shl rax, 1" "$TMPDIR/rangeloop-out/Main.s"'
exit: 0

# 9ak) 没有守卫时仍要付 63-bit 的账：wrap 与符号修正都在。
run: sh -c 'd="$TMPDIR/rangenguard"; mkdir -p "$d/app"; printf "[package]\nname = \"rangenguard\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.String as String\n\nf : Int -> Int\nf n = (n - 1) + (n / 2)\n\nmain : Int\nmain = f (strLength \"abc\")\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/rangenguard-out" "$d"'
exit: 0
run: "$TMPDIR/rangenguard-out/bin/rangenguard" 2>&1
exit: 0
out-equals: 3
run: sh -c 'grep -q "cmovns" "$TMPDIR/rangenguard-out/Main.s"'
exit: 0
run: sh -c 'grep -q "shl rax, 1" "$TMPDIR/rangenguard-out/Main.s"'
exit: 0

# 9al) then 分支的事实不得漏到 else：两个分支各自保留一次 wrap。
run: sh -c 'd="$TMPDIR/rangleak"; mkdir -p "$d/app"; printf "[package]\nname = \"rangleak\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.String as String\n\nf : Int -> Int\nf n = if n <= 0 then n - 1 else n + 1\n\nmain : Int\nmain = f (strLength \"abc\")\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/rangleak-out" "$d"'
exit: 0
run: "$TMPDIR/rangleak-out/bin/rangleak" 2>&1
exit: 0
out-equals: 4
run: sh -c 'test "$(grep -c "shl rax, 1" "$TMPDIR/rangleak-out/Main.s")" -eq 2'
exit: 0

# 9ai) 源级 let 的立即 lambda 内联：循环体不再分配闭包、不再走 `call r11`。
run: sh -c 'd="$TMPDIR/tcolet"; mkdir -p "$d/app"; printf "[package]\nname = \"tcolet\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nloop : Nat -> Int\nloop n = case n of\n  Zero => 0\n  Succ k => let x = 1 in loop k\n\nmain : Int\nmain = loop (natFromInt 1000)\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcolet-out" "$d"'
exit: 0
run: "$TMPDIR/tcolet-out/bin/tcolet" 2>&1
exit: 0
out-equals: 0
run: sh -c '! grep -q "vuna_loop_lam" "$TMPDIR/tcolet-out/Main.s"'
exit: 0
run: sh -c '! grep -q "call r11" "$TMPDIR/tcolet-out/Main.s"'
exit: 0

# 9aj) 闭包尾调用 + wrapper 尾跳：函数值递归在默认 8 MiB 栈上跑 20 万层，GC_STRESS 一致。
run: sh -c 'd="$TMPDIR/tcoclosure"; mkdir -p "$d/app"; printf "[package]\nname = \"tcoclosure\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.List as List\nimport Base.Data.Nat as Nat\n\napply : (Int -> Int) -> Int -> Int\napply f k = f k\n\nbuild : Nat -> List Int -> List Int\nbuild n acc = case n of\n  Zero => acc\n  Succ k => build k (0 :: acc)\n\ngo : List Int -> Int\ngo xs = case xs of\n  [] => 0\n  y :: ys => apply (\\\\u => go ys) 0\n\nmain : Int\nmain = go (build (natFromInt 200000) [])\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcoclosure-out" "$d"'
exit: 0
run: "$TMPDIR/tcoclosure-out/bin/tcoclosure" 2>&1
exit: 0
out-equals: 0
run: sh -c 'grep -q "jmp r11" "$TMPDIR/tcoclosure-out/Main.s"'
exit: 0

# 9aj2) 闭包尾调用的 GC 压力：小规模深递归，确认保守 GC 不破坏迭代值。
run: sh -c 'd="$TMPDIR/tcoclosuregc"; mkdir -p "$d/app"; printf "[package]\nname = \"tcoclosuregc\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.List as List\nimport Base.Data.Nat as Nat\n\napply : (Int -> Int) -> Int -> Int\napply f k = f k\n\nbuild : Nat -> List Int -> List Int\nbuild n acc = case n of\n  Zero => acc\n  Succ k => build k (0 :: acc)\n\ngo : List Int -> Int\ngo xs = case xs of\n  [] => 0\n  y :: ys => apply (\\\\u => go ys) 0\n\nmain : Int\nmain = go (build (natFromInt 30000) [])\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcoclosuregc-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/tcoclosuregc-out/bin/tcoclosuregc" 2>&1'
exit: 0
out-equals: 0

# 9ak) 运行时符号尾调用：饱和 runtime 调用在结果位置发 `jmp rt_*`。
run: sh -c 'd="$TMPDIR/tcort"; mkdir -p "$d/app"; printf "[package]\nname = \"tcort\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\nimport Base.Data.String as String\n\nrtTail : Nat -> Int\nrtTail n = case n of\n  Zero => 0\n  Succ k => strLength (strFromInt k)\n\nmain : Int\nmain = rtTail (natFromInt 10)\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcort-out" "$d"'
exit: 0
run: "$TMPDIR/tcort-out/bin/tcort" 2>&1
exit: 0
out-equals: 1
run: sh -c 'grep -q "jmp rt_str_length" "$TMPDIR/tcort-out/Main.s"'
exit: 0

# 9al) 顶层函数值闭包静态化：函数值经 List 逃逸，调用点解析不到 head，
#      创建点是 `.rodata` 里的 `lea`，不是每轮 `rt_alloc`。
run: sh -c 'd="$TMPDIR/tcostatic"; mkdir -p "$d/app"; printf "[package]\nname = \"tcostatic\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.List as List\nimport Base.Data.Nat as Nat\n\ndirect : Nat -> Int\ndirect n = case n of\n  Zero => 0\n  Succ k => direct k\n\npick : List (Nat -> Int) -> Nat -> Int\npick fs n = case fs of\n  f :: _ => f n\n  [] => 0\n\nmain : Int\nmain = pick [direct] (natFromInt 1000)\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/tcostatic-out" "$d"'
exit: 0
run: "$TMPDIR/tcostatic-out/bin/tcostatic" 2>&1
exit: 0
out-equals: 0
run: sh -c 'grep -q "vuna_static" "$TMPDIR/tcostatic-out/runtime.s"'
exit: 0
run: sh -c 'grep -q "lea rax, \\[rip + vuna_static" "$TMPDIR/tcostatic-out/Main.s"'
exit: 0
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/tcostatic-out/bin/tcostatic" 2>&1'
exit: 0
out-equals: 0

# 9am) 零参别名直调：`Nat.plus` / `Nat.mult` / `Nat.toInt` 这类 η-收缩定义在调用点
#      解析到运行时叶子，不再把 CAF 闭包交给 `rt_apply`；标量叶子（含饱和乘法）
#      在饱和应用处内联，热点路径不再有 `call rt_nat_*`。
run: sh -c 'd="$TMPDIR/alias"; mkdir -p "$d/app"; printf "[package]\nname = \"alias\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nmain : Int\nmain =\n  let\n    a = Nat.fromIntClamp 800000\n  in Nat.toInt (Nat.plus (Nat.fromIntClamp 1) (Nat.mult a (Nat.fromIntClamp 2)))\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/alias-out" "$d"'
exit: 0
run: "$TMPDIR/alias-out/bin/alias" 2>&1
exit: 0
out-equals: 1600001
file-contains: $TMPDIR/alias-out/Main.s cmova
run: sh -c '! grep -q "cmovno" "$TMPDIR/alias-out/Main.s"'
exit: 0
run: sh -c '! grep -q "call rt_nat_add" "$TMPDIR/alias-out/Main.s"'
exit: 0
run: sh -c '! grep -q "call rt_nat_mul" "$TMPDIR/alias-out/Main.s"'
exit: 0
run: sh -c '! grep -q "call rt_apply" "$TMPDIR/alias-out/Main.s"'
exit: 0

# 9an) 闭包去虚拟化：局部 let 绑定的 lambda 在调用点直调（跳过 arity 检查与
# `rt_apply`）；无捕获的 lambda 静态化（不分配）；绑定到顶层函数的 let 走标准 ABI 直调。
run: sh -c 'd="$TMPDIR/devirt"; mkdir -p "$d/app"; printf "[package]\nname = \"devirt\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "dbl : Int -> Int\ndbl x = x * 2\n\nplain : Int -> Int\nplain x =\n  let\n    g : Int -> Int\n    g = \\\\y => y + 3\n  in g x\n\ncaptured : Int -> Int\ncaptured x =\n  let\n    g : Int -> Int\n    g = \\\\y => y + x\n  in g (g 1)\n\nglobal : Int -> Int\nglobal x =\n  let\n    g : Int -> Int\n    g = dbl\n  in g x\n\nmain : Int\nmain = plain 39 + captured 5 + global 4\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/devirt-out" "$d"'
exit: 0
run: "$TMPDIR/devirt-out/bin/devirt" 2>&1
exit: 0
out-equals: 61
run: sh -c '! grep -q "call rt_apply" "$TMPDIR/devirt-out/Main.s"'
exit: 0
run: sh -c 'grep -q "jmp vuna_dbl" "$TMPDIR/devirt-out/Main.s"'
exit: 0
run: sh -c 'grep -q "vuna_static_vuna_plain_lam" "$TMPDIR/devirt-out/runtime.s"'
exit: 0

