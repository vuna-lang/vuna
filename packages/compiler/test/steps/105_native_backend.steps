# matrix: effect-native
# 105) native 后端机制：x86-64 汇编 -> 静态可执行、产物形状、确定性、trap、ABI 与拒绝面。
#
# 共享语义（算术 / 字符串 / data / record / List 桥接 / 闭包 / 高阶 API）由
# `109_backend_parity.steps` 对拍三端；这里只保留 native 特有的机制性用例。
# 依赖 PATH 里的 cc（devShell / e2e 的 ocamlTools）。

# 0) 工具链探针：缺 cc 时给出明确失败，而不是让后续链接报 127。
run: command -v cc
exit: 0

# 1) 最小可执行：产物形状（runtime.s + Main.s / build.sh / 可链接二进制）与入口打印。
run: sh -c 'd="$TMPDIR/min"; mkdir -p "$d/app"; printf "[package]\nname = \"min\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = 42\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/min-out" "$d"'
exit: 0
file-exists: $TMPDIR/min-out/Main.s
file-exists: $TMPDIR/min-out/runtime.s
file-exists: $TMPDIR/min-out/build.sh
file-contains: $TMPDIR/min-out/Main.s .intel_syntax noprefix
file-contains: $TMPDIR/min-out/Main.s .globl _start
file-contains: $TMPDIR/min-out/runtime.s .section .bss
run: "$TMPDIR/min-out/bin/min" 2>&1
exit: 0
out-equals: 42

# 2) 多个函数各自的内部 label 不得撞名（label 编号在模块内累加；模块文件之间可重号）。
run: sh -c 'd="$TMPDIR/labels"; mkdir -p "$d/app"; printf "[package]\nname = \"labels\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "f : Int -> Int\nf x = if x > 0 then 1 else 0\n\ng : Int -> Int\ng x = if x > 5 then 2 else 0\n\nmain : Int\nmain = f 1 + g 6\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/labels-out" "$d"'
exit: 0
run: "$TMPDIR/labels-out/bin/labels" 2>&1
out-equals: 3

# 3) 除零：编译通过，运行 exit 2 并输出运行时错误前缀。
run: sh -c 'd="$TMPDIR/dz"; mkdir -p "$d/app"; printf "[package]\nname = \"dz\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = 1 / 0\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/dz-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/dz-out/bin/dz" 2>&1'
exit: 2
out-contains: vuna: runtime error: division by zero

# 4) 确定性：同一程序两次 compile 的文件集逐字节一致（含字符串字面量池）。
run: sh -c 'd="$TMPDIR/det"; mkdir -p "$d/app"; printf "[package]\nname = \"det\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : String\nmain = \"a\" ++ strFromInt 42 ++ \"b\"\n" > "$d/app/Main.vuna"; "$VUNA" compile "$d/app/Main.vuna" "$TMPDIR/det-a" --target native; "$VUNA" compile "$d/app/Main.vuna" "$TMPDIR/det-b" --target native; diff -r "$TMPDIR/det-a" "$TMPDIR/det-b"'
exit: 0

# 5) 可增长 arena：超过初始 1 MiB 时 mmap 新段，不再 OOM。
run: sh -c 'd="$TMPDIR/oom"; mkdir -p "$d/app"; printf "[package]\nname = \"oom\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nrep : Nat -> String -> String\nrep n s = case n of\n  Zero => \"\"\n  Succ k => s ++ rep k s\n\nmain : Int\nmain = strLength (rep (natFromInt 5000) \"0123456789abcdef\")\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/oom-out" "$d"'
exit: 0
run: "$TMPDIR/oom-out/bin/oom" 2>&1
out-equals: 80000

# 6) 运行时错误文本：assert / prim_fail / todo 统一走报告器格式（stderr + exit 2）。
run: sh -c 'd="$TMPDIR/traps"; mkdir -p "$d/app"; printf "[package]\nname = \"traps\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = assert False \"bad\" 9\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/traps-as" "$d"'
exit: 0
run: sh -c '"$TMPDIR/traps-as/bin/traps" 2>&1'
exit: 2
out-equals: vuna: runtime error: assertion failed: bad
run: sh -c 'printf "main : Int\nmain = prim_fail \"boom\"\n" > "$TMPDIR/traps/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/traps-pf" "$TMPDIR/traps"'
exit: 0
run: sh -c '"$TMPDIR/traps-pf/bin/traps" 2>&1'
exit: 2
out-equals: vuna: runtime error: boom
run: sh -c 'printf "main : Int\nmain = todo \"later\"\n" > "$TMPDIR/traps/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/traps-todo" "$TMPDIR/traps"'
exit: 0
run: sh -c '"$TMPDIR/traps-todo/bin/traps" 2>&1'
exit: 2
out-equals: vuna: runtime error: TODO: later

# 7) 数组越界：trap 文本与 OCaml 报告器首行一致（native 没有位置行），exit 2。
run: sh -c 'd="$TMPDIR/arr"; mkdir -p "$d/app"; printf "[package]\nname = \"arr\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Container.Array as Array\n\nmain : Int\nmain = arrayGet (fromList [1, 2]) 5\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/arr-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/arr-out/bin/arr" 2>&1'
exit: 2
out-equals: vuna: runtime error: Invalid_argument("index out of bounds")

# 7) dbg! 的运行时原语：关闭时返回 43 且不求值。
run: sh -c 'd="$TMPDIR/dbg"; mkdir -p "$d/app"; printf "[package]\nname = \"dbg\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = let _ = dbg! \"x\" in 43\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/dbg-out" "$d"'
exit: 0
run: "$TMPDIR/dbg-out/bin/dbg" 2>&1
out-equals: 43

# 8) 栈传参（arity > 6）：前 6 个走寄存器，第 7 个起压栈。
run: sh -c 'd="$TMPDIR/argv"; mkdir -p "$d/app"; printf "[package]\nname = \"argv\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "poly : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\npoly a b c d e f g h i = a * 100000000 + b * 10000000 + c * 1000000 + d * 100000 + e * 10000 + f * 1000 + g * 100 + h * 10 + i\n\nmain : Int\nmain = poly 1 2 3 4 5 6 7 8 9\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/argv-out" "$d"'
exit: 0
run: "$TMPDIR/argv-out/bin/argv" 2>&1
out-equals: 123456789
# 奇数个栈参数（7 参）走对齐空洞；返回值必须原样。
run: sh -c 'd="$TMPDIR/argv"; printf "poly : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\npoly a b c d e f g = a + b + c + d + e + f + g\n\nmain : Int\nmain = poly 1 2 3 4 5 6 7\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/argv7-out" "$d"'
exit: 0
run: "$TMPDIR/argv7-out/bin/argv" 2>&1
out-equals: 28
# 栈传参 + 递归：每层都要读自己栈帧上的第 7 个参数。
run: sh -c 'd="$TMPDIR/argv"; printf "import Base.Data.Nat as Nat\n\ng : Nat -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\ng a b c d e f h i = case a of\n  Zero => i\n  Succ k => g k b c d e f h (i + 1)\n\nmain : Int\nmain = g (natFromInt 5) 1 2 3 4 5 6 7\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/argvrec-out" "$d"'
exit: 0
run: "$TMPDIR/argvrec-out/bin/argv" 2>&1
out-equals: 12

# 9) 动作入口：`main : Eff [ConsoleOp] a` 在入口处跑，纯返回 1。
run: sh -c 'd="$TMPDIR/effpure"; mkdir -p "$d/app"; printf "[package]\nname = \"effpure\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Console as EffConsole\n\nmain : Eff [ConsoleOp] Int\nmain = pure 1\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effpure-out" "$d"'
exit: 0
run: "$TMPDIR/effpure-out/bin/effpure" 2>&1
out-equals: 1

# 9a) 入口宿主 handler：consolePrint 打印后把字节数交回动作，结果 2。
run: sh -c 'd="$TMPDIR/effhost"; mkdir -p "$d/app"; printf "[package]\nname = \"effhost\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Console as EffConsole\nimport Base.Data.Nat as Nat\n\nmain : Eff [ConsoleOp] Nat\nmain = do\n  n <- consolePrint \"hi\"\n  pure (n + 10)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effhost-out" "$d"'
exit: 0
run: "$TMPDIR/effhost-out/bin/effhost" 2>&1
out-equals: hi12

# 9b) 两次 perform + 续延恢复：第二次 perform 在恢复后的栈上重新找 handler。
run: sh -c 'd="$TMPDIR/efftwo"; mkdir -p "$d/app"; printf "[package]\nname = \"efftwo\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Console as EffConsole\nimport Base.Data.Nat as Nat\n\nmain : Eff [ConsoleOp] Nat\nmain = do\n  a <- consolePrint \"a\"\n  b <- consolePrint \"b\"\n  pure (a * 10 + b)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/efftwo-out" "$d"'
exit: 0
run: "$TMPDIR/efftwo-out/bin/efftwo" 2>&1
out-equals: ab11

# 9c) mock handler：resume 后 handler 还能用返回值继续计算（k 结果 + 100）。
run: sh -c 'd="$TMPDIR/effresume"; mkdir -p "$d/app"; printf "[package]\nname = \"effresume\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nmain : Int\nmain = runPure (handle (perform (P 3)) { P n k -> k (n + 1) + 100 })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effresume-out" "$d"'
exit: 0
run: "$TMPDIR/effresume-out/bin/effresume" 2>&1
out-equals: 104

# 9d) abort（不恢复续延）：handler 直接返回 42，后续计算丢弃。
run: sh -c 'd="$TMPDIR/effabort"; mkdir -p "$d/app"; printf "[package]\nname = \"effabort\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nmain : Int\nmain = runPure (handle (do\n  a <- perform (P 3)\n  pure (a * 2)\n) { P n k -> 42 })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effabort-out" "$d"'
exit: 0
run: "$TMPDIR/effabort-out/bin/effabort" 2>&1
out-equals: 42

# 9e) one-shot：resume 两次在运行期 trap（exit 2）。
run: sh -c 'd="$TMPDIR/efftwice"; mkdir -p "$d/app"; printf "[package]\nname = \"efftwice\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nmain : Int\nmain = runPure (handle (perform (P 3)) { P n k -> k (n + 1) + k 0 })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/efftwice-out" "$d"'
exit: 0
run: "$TMPDIR/efftwice-out/bin/efftwice" 2>&1
exit: 2
out-contains: continuation already resumed

# 9f) Exit 宿主 handler：exitWith 3 走宿主叶子，进程 exit 3。
run: sh -c 'd="$TMPDIR/effexit"; mkdir -p "$d/app"; printf "[package]\nname = \"effexit\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Exit as EffExit\n\nmain : Eff [ExitOp] Int\nmain = do\n  _ <- exitWith 3\n  pure 0\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effexit-out" "$d"'
exit: 0
run: "$TMPDIR/effexit-out/bin/effexit" 2>&1
exit: 3

# 9g) 同一 handler 节点在自己的续延内再次 perform（外层交替另一个 handler）：
#     perform 入口要清掉节点上的「当前 resume 记录」并在 opH 返回时恢复，否则内层
#     resume 覆盖外层的记录后，外层 opH 返回时会把答案交给已放弃的续延栈段。
run: sh -c 'd="$TMPDIR/effnest"; mkdir -p "$d/app"; printf "[package]\nname = \"effnest\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "hi" > "$TMPDIR/effnest-in.txt"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Fs as EffFs\nimport Base.Data.Int as Int\nimport Base.Data.String as String\n\nmain : Eff [FsOp, ArgsOp] Int\nmain = do\n  s <- fsReadFile \"$TMPDIR/effnest-in.txt\"\n  _ <- argsGetArgs\n  t <- fsReadFile \"$TMPDIR/effnest-in.txt\"\n  _ <- argsGetArgs\n  pure (strLength s + strLength t)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effnest-out" "$d"'
exit: 0
run: "$TMPDIR/effnest-out/bin/effnest" 2>&1
out-equals: 4

# 9g) 连续 500 次 perform：续延反复迁移/恢复，handler 链与返回值保持。
run: sh -c 'd="$TMPDIR/effmany"; mkdir -p "$d/app"; printf "[package]\nname = \"effmany\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Nat as Nat\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nmany : Nat -> Eff [POp] Int\nmany n = case n of\n  Zero => pure 0\n  Succ m => do\n    x <- perform (P 1)\n    y <- many m\n    pure (x + y)\n\nmain : Int\nmain = runPure (handle (many (natFromInt 500)) { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effmany-out" "$d"'
exit: 0
run: "$TMPDIR/effmany-out/bin/effmany" 2>&1
out-equals: 500

# 9h) 嵌套 handler（外层未被触发）：恢复内层时链上仍有外层节点。
run: sh -c 'd="$TMPDIR/effnest"; mkdir -p "$d/app"; printf "[package]\nname = \"effnest\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\n\ndata AOp : Type -> Type where\n  A : Int -> AOp Int\n\ndata BOp : Type -> Type where\n  B : Int -> BOp Int\n\nprog : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int\nprog = do\n  x <- perform (A 1)\n  pure x\n\ninner : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int -> Eff (Named \"b\" BOp :: []) Int\ninner comp = handle comp {\n  A n k -> k (n + 10)\n}\n\nmain : Int\nmain = runPure (handle (inner prog) { B n k -> k (n * 100) })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effnest-out" "$d"'
exit: 0
run: "$TMPDIR/effnest-out/bin/effnest" 2>&1
out-equals: 11

# 9i) 显式 return：answer 类型与 comp 结果类型不同（Nat -> Int）。
run: sh -c 'd="$TMPDIR/effret"; mkdir -p "$d/app"; printf "[package]\nname = \"effret\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Console as EffConsole\nimport Base.Data.Nat as Nat\n\nmain : Int\nmain = runPure (handle (perform (Print \"x\")) {\n  return n -> natToInt n\n  Print s k -> k (natFromInt 5)\n  EPrint s k -> k (natFromInt 7)\n})\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effret-out" "$d"'
exit: 0
run: "$TMPDIR/effret-out/bin/effret" 2>&1
out-equals: 5

# 9j) 恢复后深递归：续延栈段留出的向下增长空间（128 KiB）覆盖约 500 帧。
run: sh -c 'd="$TMPDIR/effdeep"; mkdir -p "$d/app"; printf "[package]\nname = \"effdeep\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Nat as Nat\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nsum : Nat -> Eff [POp] Int\nsum n = case n of\n  Zero => pure 0\n  Succ m => do\n    y <- sum m\n    pure (y + 1)\n\nprog : Eff [POp] Int\nprog = do\n  x <- perform (P 1)\n  y <- sum (natFromInt 500)\n  pure (x + y)\n\nmain : Int\nmain = runPure (handle prog { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effdeep-out" "$d"'
exit: 0
run: "$TMPDIR/effdeep-out/bin/effdeep" 2>&1
out-equals: 501

# 9k) 嵌套 handler 的内层恢复段里触发外层 perform：整段栈迁移后仍回到 211。
run: sh -c 'd="$TMPDIR/effnested"; mkdir -p "$d/app"; printf "[package]\nname = \"effnested\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\n\ndata AOp : Type -> Type where\n  A : Int -> AOp Int\n\ndata BOp : Type -> Type where\n  B : Int -> BOp Int\n\nprog : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int\nprog = do\n  x <- perform (A 1)\n  y <- perform (B 2)\n  pure (x + y)\n\ninner : Eff (Named \"a\" AOp :: (Named \"b\" BOp :: [])) Int -> Eff (Named \"b\" BOp :: []) Int\ninner comp = handle comp {\n  A n k -> k (n + 10)\n}\n\nmain : Int\nmain = runPure (handle (inner prog) { B n k -> k (n * 100) })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effnested-out" "$d"'
exit: 0
run: "$TMPDIR/effnested-out/bin/effnested" 2>&1
out-equals: 211

# 9l) （已删除）续延栈段不再存在：库机器没有捕获/迁移栈段，深 CPS 递归只受
#     native 栈大小限制；深递归的正向覆盖见 9m（20000 层）。

# 9m) 单次捕获超过堆初始段（1 MiB）：perform 在 20000 帧深处，捕获缓冲必须按
#     请求放大 mmap，而不是落进 1 MiB 段尾。
run: sh -c 'd="$TMPDIR/effcap"; mkdir -p "$d/app"; printf "[package]\nname = \"effcap\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Nat as Nat\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nsum : Nat -> Eff [POp] Int\nsum n = case n of\n  Zero => perform (P 1)\n  Succ m => do\n    y <- sum m\n    pure (y + 1)\n\nmain : Int\nmain = runPure (handle (sum (natFromInt 20000)) { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/effcap-out" "$d"'
exit: 0
run: "$TMPDIR/effcap-out/bin/effcap" 2>&1
out-equals: 20001

# 9n) 高阶观测原语：`@vuna@obs@span` 不写事件，但必须调 thunk 并返回其结果。
run: sh -c 'd="$TMPDIR/obsspan"; mkdir -p "$d/app"; printf "[package]\nname = \"obsspan\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.ObsSpan as ObsSpan\n\nmain : Int\nmain = obsSpan \"vuna.probe\" \"vuna.user\" (\\_ => 42)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/obsspan-out" "$d"'
exit: 0
run: "$TMPDIR/obsspan-out/bin/obsspan" 2>&1
out-equals: 42

# 10) --no-compile：只写汇编文件集 + build.sh；build.sh 可独立链接并运行。
run: sh -c 'd="$TMPDIR/nc"; mkdir -p "$d/app"; printf "[package]\nname = \"nc\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : String\nmain = \"n\" ++ strFromInt 7\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --no-compile --out "$TMPDIR/nc-out" "$d"'
exit: 0
file-exists: $TMPDIR/nc-out/Main.s
file-exists: $TMPDIR/nc-out/runtime.s
file-exists: $TMPDIR/nc-out/build.sh
file-absent: $TMPDIR/nc-out/bin/nc
run: sh -c 'cd "$TMPDIR/nc-out" && sh build.sh >/dev/null && ./bin/nc'
exit: 0
out-equals: "n7"

# 9o) 宿主入参/环境/目录/时钟：argv 不含 argv[0]，envp 键值扫描，cwd/execPath 非空，
#     sleep 后时间不倒退；结果 2+5+1+1+1 = 10。
run: sh -c 'd="$TMPDIR/hostargs"; mkdir -p "$d/app"; printf "[package]\nname = \"hostargs\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Clock as EffClock\nimport Base.Effect.Env as EffEnv\nimport Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.String as String\n\nmain : Eff [ArgsOp, ClockOp, EnvOp] Int\nmain = do\n  args <- argsGetArgs\n  home <- envGetEnv \"VUNA_TEST_ENV\"\n  cwd <- envGetCwd\n  exe <- envExecPath\n  t0 <- clockNow\n  _ <- clockSleepMicros 1000\n  t1 <- clockNow\n  pure (length args + strLength home + (if strLength cwd > 0 then 1 else 0) + (if strLength exe > 0 then 1 else 0) + (if t1 >= t0 then 1 else 0))\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/hostargs-out" "$d"'
exit: 0
run: sh -c 'VUNA_TEST_ENV=hello "$TMPDIR/hostargs-out/bin/hostargs" one two 2>&1'
exit: 0
out-equals: 10

# 9p) bracket/finally：cleanup 登记表 push/pop（正常路径；abort 不运行，与 wasm 同边界）。
run: sh -c 'd="$TMPDIR/bracket"; mkdir -p "$d/app"; printf "[package]\nname = \"bracket\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Int as Int\n\nmain : Int\nmain = runPure (bracket (pure 7) (\\\\_ => pure 0) (\\\\r => pure (r * 6)))\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/bracket-out" "$d"'
exit: 0
run: "$TMPDIR/bracket-out/bin/bracket" 2>&1
out-equals: 42

# 9q) 宿主 fs：建/写/读/原子写/目录列举（排序）/stat/rename/symlink/递归删除。
#     a="hello"(5) + b="atomic"(6) + entries 2 + isDir 1 + exists 1 + size 5 + mtime 1 = 21。
run: sh -c 'd="$TMPDIR/fsops"; mkdir -p "$d/app"; printf "[package]\nname = \"fsops\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Bool as Bool\nimport Base.Effect.Core as Eff\nimport Base.Effect.Fs as EffFs\nimport Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.Maybe as Maybe\nimport Base.Data.Nat as Nat\nimport Base.Data.String as String\n\ndir : String\ndir = \"$TMPDIR/fs-tree\"\n\nmain : Eff [FsOp] Int\nmain = do\n  _ <- fsRemoveTree dir\n  _ <- fsMakeDir dir\n  _ <- fsWriteFile (dir ++ \"/a.txt\") \"hello\"\n  _ <- fsWriteFileAtomic (dir ++ \"/b.txt\") \"atomic\"\n  a <- fsReadFile (dir ++ \"/a.txt\")\n  b <- fsReadFile (dir ++ \"/b.txt\")\n  entries <- fsReadDir dir\n  isd <- fsIsDirectory dir\n  ex <- fsFileExists (dir ++ \"/a.txt\")\n  sz <- fsFileSize (dir ++ \"/a.txt\")\n  mt <- fsFileMtime (dir ++ \"/a.txt\")\n  _ <- fsRename (dir ++ \"/b.txt\") (dir ++ \"/c.txt\")\n  _ <- fsSymlink (dir ++ \"/a.txt\") (dir ++ \"/link\")\n  _ <- fsRemoveFile (dir ++ \"/c.txt\")\n  _ <- fsRemoveTree dir\n  pure (strLength a + strLength b + length entries + (if isd then 1 else 0) + (if ex then 1 else 0) + maybe 0 (\\\\n => natToInt n) sz + maybe 0 (\\\\_ => 1) mt)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/fsops-out" "$d"'
exit: 0
run: "$TMPDIR/fsops-out/bin/fsops" 2>&1
out-equals: 21
run: sh -c 'test ! -e "$TMPDIR/fs-tree" && echo cleaned'
out-equals: cleaned

# 9r) readDir 按字典序（`Sys.readdir` + `sort compare` 语义）：建 c/a/b -> "abc"。
#     GC_STRESS 下再跑一遍：名字在转成 Vuna String 前不能只躺在 GC 不扫的 .bss 数组里。
run: sh -c 'd="$TMPDIR/fsdir"; mkdir -p "$d/app"; printf "[package]\nname = \"fsdir\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Fs as EffFs\nimport Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.String as String\n\ndir : String\ndir = \"$TMPDIR/fs-dir\"\n\nmain : Eff [FsOp] String\nmain = do\n  _ <- fsRemoveTree dir\n  _ <- fsMakeDir dir\n  _ <- fsWriteFile (dir ++ \"/c\") \"\"\n  _ <- fsWriteFile (dir ++ \"/a\") \"\"\n  _ <- fsWriteFile (dir ++ \"/b\") \"\"\n  xs <- fsReadDir dir\n  pure (case xs of\n    x :: y :: z :: _ => x ++ y ++ z\n    _ => \"?\")\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/fsdir-out" "$d"'
exit: 0
run: "$TMPDIR/fsdir-out/bin/fsdir" 2>&1
out-equals: "abc"
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/fsdir-out/bin/fsdir" 2>&1'
out-equals: "abc"
run: sh -c 'test "$(grep -c "call rt_write_barrier" "$TMPDIR/fsdir-out/runtime.s")" -ge 4'
exit: 0

# 9s) fs 失败路径：读不存在的文件 -> typed error 收口（诊断 + exit 1），不伪造内容。
run: sh -c 'd="$TMPDIR/fsmiss"; mkdir -p "$d/app"; printf "[package]\nname = \"fsmiss\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Fs as EffFs\nimport Base.Data.Int as Int\nimport Base.Data.String as String\n\nmain : Eff [FsOp] Int\nmain = do\n  s <- fsReadFile \"$TMPDIR/fs-missing-file\"\n  pure (strLength s)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/fsmiss-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/fsmiss-out/bin/fsmiss" 2>&1'
exit: 1
out-contains: fs: readFile

# 9t) 内存预算：缺省 1 GiB（`runtime.s` 里的常量），`VUNA_NATIVE_MEM_LIMIT` 生效时
#     trap `memory limit exceeded` + exit 2；未超限时输出不变。
run: sh -c 'd="$TMPDIR/memlim"; mkdir -p "$d/app"; printf "[package]\nname = \"memlim\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nrep : Nat -> String -> String\nrep n s = case n of\n  Zero => \"\"\n  Succ k => s ++ rep k s\n\nmain : Int\nmain = strLength (rep (natFromInt 5000) \"0123456789abcdef\")\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/memlim-out" "$d"'
exit: 0
file-contains: $TMPDIR/memlim-out/runtime.s 1073741824
run: "$TMPDIR/memlim-out/bin/memlim" 2>&1
out-equals: 80000
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=1000 "$TMPDIR/memlim-out/bin/memlim" 2>&1'
exit: 2
out-equals: vuna: runtime error: memory limit exceeded

# 9u) 总超时：`VUNA_NATIVE_TIMEOUT_MS` 到点由 SIGALRM 写固定文本 + exit 2
#     （阻塞在 nanosleep 里也能被打断）。
run: sh -c 'd="$TMPDIR/sleepy"; mkdir -p "$d/app"; printf "[package]\nname = \"sleepy\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Clock as EffClock\n\nmain : Eff [ClockOp] Int\nmain = do\n  _ <- clockSleepMicros 1000000\n  pure 0\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/sleepy-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=100 "$TMPDIR/sleepy-out/bin/sleepy" 2>&1'
exit: 2
out-equals: vuna: runtime error: timeout exceeded

# 9u2) 超时连带子进程组：`runIn` 起的 `/bin/sh` 在超时生效时 `setpgid(0, 0)` 自成一组，
#      SIGALRM 里 `kill(-pid)` 把它的后台 `sleep` 一起收掉（不能只剩父进程 exit 2）。
run: sh -c 'd="$TMPDIR/timeoutkill"; mkdir -p "$d/app"; printf "[package]\nname = \"timeoutkill\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [ProcessOp] Int\nmain = processRunIn \".\" [\"sh\", \"-c\", \"sleep 300 & echo \$! > \$TMPDIR/child.pid; wait\"]\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/timeoutkill-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=300 "$TMPDIR/timeoutkill-out/bin/timeoutkill" 2>&1'
exit: 2
out-equals: vuna: runtime error: timeout exceeded
run: sh -c 'pid=$(cat "$TMPDIR/child.pid" 2>/dev/null); [ -n "$pid" ] || { echo "no child pid recorded"; exit 1; }; st=$(awk "{print \$3}" "/proc/$pid/stat" 2>/dev/null || echo gone); [ "$st" != S ] || { echo "child $pid still running"; exit 1; }; echo swept'
out-equals: swept

# 9u3) 未装定时器时不改进程组：`runIn` 的子进程 pgid 仍等于父进程（steps 自己的 shell）的
#      pgid，保持 Ctrl-C 的原有语义。产物还会打印 main 的返回值，取首行比较。
run: sh -c 'd="$TMPDIR/pgid"; mkdir -p "$d/app"; printf "[package]\nname = \"pgid\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [ProcessOp] Int\nmain = processRunIn \".\" [\"sh\", \"-c\", \"ps -o pgid= -p \$\$\"]\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/pgid-out" "$d"'
exit: 0
run: sh -c 'out=$("$TMPDIR/pgid-out/bin/pgid" | head -n 1 | tr -d " "); me=$(ps -o pgid= -p $$ | tr -d " "); [ "$out" = "$me" ] || { echo "pgid $out != $me"; exit 1; }; echo same-group'
out-equals: same-group

# 9u4) 并发 spawn：两个 `processSpawn` 各自成组，只 `processWait` 第一个；超时 handler 必须
#      遍历 pid 槽把**两组**都收掉（先返回的 wait 不能清掉另一组的槽）。native 的 `spawn` 是
#      `execve(/proc/self/exe, args)`，所以子进程按 argv 变成 worker，再从 worker 里起
#      `/bin/sh`：这样每组都带一个后台 `sleep`，能验证整组（不只是直接子进程）被收掉。
run: sh -c 'd="$TMPDIR/spawnslots"; mkdir -p "$d/app"; printf "[package]\nname = \"spawnslots\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.String as String\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Core as Eff\nimport Base.Effect.Env as EffEnv\nimport Base.Effect.Fs as EffFs\nimport Base.Effect.Process as EffProcess\n\nworker : String -> Eff [EnvOp, ProcessOp] String\nworker c = do\n  _ <- processRunIn \".\" [\"sh\", \"-c\", c]\n  pure \"worker\"\n\nparent : Eff [EnvOp, FsOp, ProcessOp] String\nparent = do\n  tmp <- envGetEnv \"TMPDIR\"\n  secs <- envGetEnv \"SLOTS_SLEEP\"\n  p1 <- processSpawn [\"sleep \" ++ secs ++ \" & echo \$! > \" ++ tmp ++ \"/s1.pid; wait\"]\n  p2 <- processSpawn [\"sleep \" ++ secs ++ \" & echo \$! > \" ++ tmp ++ \"/s2.pid; wait\"]\n  _ <- fsWriteFile (tmp ++ \"/c1.pid\") (strFromInt p1)\n  _ <- fsWriteFile (tmp ++ \"/c2.pid\") (strFromInt p2)\n  _ <- processWait p1\n  _ <- processWait p2\n  pure \"done\"\n\nmain : Eff [ArgsOp, EnvOp, FsOp, ProcessOp] String\nmain = do\n  args <- argsGetArgs\n  case args of\n    c :: _ => worker c\n    [] => parent\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/spawnslots-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=500 SLOTS_SLEEP=300 "$TMPDIR/spawnslots-out/bin/spawnslots" 2>&1'
exit: 2
out-equals: vuna: runtime error: timeout exceeded
run: sh -c 'for f in c1 c2 s1 s2; do pid=$(cat "$TMPDIR/$f.pid" 2>/dev/null); [ -n "$pid" ] || { echo "no $f pid"; exit 1; }; st=$(awk "{print \$3}" "/proc/$pid/stat" 2>/dev/null || echo gone); [ "$st" != S ] || { echo "$f $pid still running"; exit 1; }; done; echo swept-both'
out-equals: swept-both
# 反向：不设超时时同产物能正常等两次并 exit 0（spawn 语义或屏蔽/解除屏蔽接线坏了会在这里挂住）。
run: sh -c 'SLOTS_SLEEP=0 "$TMPDIR/spawnslots-out/bin/spawnslots" 2>&1'
exit: 0
out-contains: done

# 9v) 核数：`VUNA_NATIVE_CPUS=1` 把进程钉到一个可用核上（`Cpus_allowed_list` 单项）。
run: sh -c 'VUNA_NATIVE_CPUS=1 "$TMPDIR/sleepy-out/bin/sleepy" >/dev/null & p=$!; sleep 0.3; taskset -pc $p | sed "s/.*: //" | awk -F, "{print NF}"; wait'
out-equals: 1

# 9w) 限制相关 env 不传给 `runIn` / `spawn` 的子进程；`VUNA_NATIVE_INHERIT=1` 才继承。
#     子命令 `printenv KEY` 的存在与否直接反映为退出码（不依赖 shell 变量展开）。
run: sh -c 'd="$TMPDIR/envinh"; mkdir -p "$d/app"; printf "[package]\nname = \"envinh\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [ProcessOp] Int\nmain = processRunIn \".\" [\"sh\", \"-c\", \"printenv VUNA_NATIVE_MEM_LIMIT >/dev/null\"]\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/envinh-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=12345 "$TMPDIR/envinh-out/bin/envinh"'
out-equals: 1
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=12345 VUNA_NATIVE_INHERIT=1 "$TMPDIR/envinh-out/bin/envinh"'
out-equals: 0

# 9x) 限制只在启动时读 env：设与不设生成的文件集逐字节一致。
run: sh -c '"$VUNA" compile "$TMPDIR/memlim/app/Main.vuna" "$TMPDIR/detlim-a" --target native; VUNA_NATIVE_MEM_LIMIT=1 VUNA_NATIVE_CPUS=1 "$VUNA" compile "$TMPDIR/memlim/app/Main.vuna" "$TMPDIR/detlim-b" --target native; diff -r "$TMPDIR/detlim-a" "$TMPDIR/detlim-b"'
exit: 0

# 9y) GC 回收：高 churn、低存活集的程序在 1 MiB live 预算下跑完（累计分配约 3.8 MB），
#     输出与无预算时逐字一致；`VUNA_NATIVE_GC_LOG` 打出的诊断行含次数与 live 字节。
run: sh -c 'd="$TMPDIR/gcgrow"; mkdir -p "$d/app"; printf "[package]\nname = \"gcgrow\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\nimport Base.Data.String as String\n\nwork : Int -> Int\nwork x = strLength (\"abcdefghij\" ++ strFromInt x) + strLength (strFromInt (x + 1))\n\ngo : Nat -> Int -> Int\ngo n acc = case n of\n  Zero => acc\n  Succ k => go k (acc + work k)\n\nmain : Int\nmain = go (natFromInt 40000) 0\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/gcgrow-out" "$d"'
exit: 0
run: "$TMPDIR/gcgrow-out/bin/gcgrow" 2>&1
out-equals: 777784
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=1048576 "$TMPDIR/gcgrow-out/bin/gcgrow" 2>&1'
exit: 0
out-equals: 777784
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=1048576 VUNA_NATIVE_GC_LOG=1 "$TMPDIR/gcgrow-out/bin/gcgrow" 2>&1'
out-contains: gc n=
out-contains: live=

# 9z) `VUNA_NATIVE_GC_STRESS=1`（每次分配都完整 GC）：续延 + List + 字符串的程序
#     输出与正常模式一致，说明根集（栈 / handler / 续延记录 / 捕获缓冲）没有漏项。
run: sh -c 'd="$TMPDIR/gcstress"; mkdir -p "$d/app"; printf "[package]\nname = \"gcstress\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Nat as Nat\nimport Base.Data.String as String\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\npad : String -> Int\npad s = strLength (s ++ \"0123456789\")\n\nmany : Nat -> Eff [POp] Int\nmany n = case n of\n  Zero => pure 0\n  Succ m => do\n    x <- perform (P (pad \"abc\"))\n    y <- many m\n    pure (x + y)\n\nmain : Int\nmain = runPure (handle (many (natFromInt 12)) { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/gcstress-out" "$d"'
exit: 0
run: "$TMPDIR/gcstress-out/bin/gcstress" 2>&1
out-equals: 156
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/gcstress-out/bin/gcstress" 2>&1'
exit: 0
out-equals: 156

# 9aa) GC 的 env 开关也不进 codegen：`GC_MIN` / `GC_LOG` / `GC_STRESS` 不影响产物。
run: sh -c '"$VUNA" compile "$TMPDIR/gcgrow/app/Main.vuna" "$TMPDIR/detgc-a" --target native; VUNA_NATIVE_GC_MIN=4096 VUNA_NATIVE_GC_LOG=1 VUNA_NATIVE_GC_STRESS=1 "$VUNA" compile "$TMPDIR/gcgrow/app/Main.vuna" "$TMPDIR/detgc-b" --target native; diff -r "$TMPDIR/detgc-a" "$TMPDIR/detgc-b"'
exit: 0

# 9aa1) 超大块（> 64 MiB）走后段 + rt_huge_free：分配后丢掉，下一次 GC 把它挂回
#       链表；再分配仍能正常结束（回归：清扫曾把链表头当槽地址解引用 → SIGSEGV）。
run: sh -c 'd="$TMPDIR/gchuge"; mkdir -p "$d/app"; printf "[package]\nname = \"gchuge\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Container.Array as Array\nimport Base.Data.Int as Int\nimport Base.Data.Nat as Nat\nimport Base.Data.String as String\n\nmain : Eff [] Int\nmain = do\n  a <- pure (Array.length (Array.make (natFromInt 8400000) 7))\n  n <- pure (strLength (strFromInt 10000000))\n  pure (if a == natFromInt 8400000 && n >= 0 then 1 else 0)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/gchuge-out" "$d"'
exit: 0
run: "$TMPDIR/gchuge-out/bin/gchuge" 2>&1
out-equals: 1
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/gchuge-out/bin/gchuge" 2>&1'
out-equals: 1

# 9aa2) 分代 GC 的记集：老代 IORef 写进年轻代值后，写屏障把它登记进记集，年轻代回收
#       从记集出发扫到这个值。`GC_MIN` 压小让回收密集发生；`rem>=1` 的行证明某次年轻代
#       回收确实从记集出发（只断言输出区分不出来：值也能经 Eff 闭包链活着）。
run: sh -c 'd="$TMPDIR/gcrem"; mkdir -p "$d/app"; printf "[package]\nname = \"gcrem\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Pure.IORef as IORef\nimport Base.Data.Int as Int\nimport Base.Data.String as String\n\nchurn : Int -> Int -> Int\nchurn n acc = if n <= 0 then acc else churn (n - 1) (acc + strLength (strFromInt (10000000 + n)))\n\npad : Int -> String -> String\npad n s = if n <= 0 then s else pad (n - 1) (s ++ \"ab\")\n\nmain : Eff [] Int\nmain = do\n  cell <- newRef \"seed\"\n  n1 <- pure (churn 3000 0)\n  m <- pure (strLength (pad 20000 \"xy\"))\n  n0 <- pure (churn 1 0)\n  _ <- writeRef cell (pad 5 \"xy\")\n  n2 <- pure (churn 3000 0)\n  v <- readRef cell\n  pure (if n1 >= 0 && n2 >= 0 && m >= 0 && n0 >= 0 then strLength v else 0 - 1)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/gcrem-out" "$d"'
exit: 0
run: "$TMPDIR/gcrem-out/bin/gcrem" 2>&1
out-equals: 12
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/gcrem-out/bin/gcrem" 2>&1'
out-equals: 12
run: sh -c 'VUNA_NATIVE_GC_MIN=1000 VUNA_NATIVE_GC_LOG=1 "$TMPDIR/gcrem-out/bin/gcrem" >/dev/null 2>"$TMPDIR/gcrem.log"; grep -q "gen=minor" "$TMPDIR/gcrem.log" && grep -q "rem=[1-9]" "$TMPDIR/gcrem.log"'
exit: 0
run: sh -c 'grep -q "call rt_write_barrier" "$TMPDIR/gcrem-out/runtime.s"'
exit: 0

# 9ab) 尾调用：互递归（even/odd）400 万层在默认 8 MiB 栈上跑完（不尾调用会栈溢出）。
run: sh -c 'd="$TMPDIR/tcomutual"; mkdir -p "$d/app"; printf "[package]\nname = \"tcomutual\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "even : Int -> Bool\neven n = if n <= 0 then True else odd (n - 1)\n\nodd : Int -> Bool\nodd n = if n <= 0 then False else even (n - 1)\n\nmain : Int\nmain = if even 4000000 then 1 else 0\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcomutual-out" "$d"'
exit: 0
run: "$TMPDIR/tcomutual-out/bin/tcomutual" 2>&1
exit: 0
out-equals: 1
file-contains: $TMPDIR/tcomutual-out/Main.s jmp vuna_odd

# 9ac) 自递归尾调用：9 参自递归（3 个栈参数）走本地循环，常量栈跑完 100 万层；
#      循环回边是函数内 label，不再 `jmp vuna_step`。
run: sh -c 'd="$TMPDIR/tcowide"; mkdir -p "$d/app"; printf "[package]\nname = \"tcowide\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "step : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\nstep a b c d e f g h n =\n  if n <= 0 then a + b + c + d + e + f + g + h\n  else step (a + 1) b c d e f g h (n - 1)\n\nmain : Int\nmain = step 0 0 0 0 0 0 0 1 1000000\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcowide-out" "$d"'
exit: 0
run: "$TMPDIR/tcowide-out/bin/tcowide" 2>&1
exit: 0
out-equals: 1000001
file-contains: $TMPDIR/tcowide-out/Main.s jmp .L
run: sh -c '! grep -q "jmp vuna_step" "$TMPDIR/tcowide-out/Main.s"'

# 9ad) 尾位置穿透 `if` / `case` / `natCase`：三种形状的深递归都在常量栈上跑完。
run: sh -c 'd="$TMPDIR/tcopos"; mkdir -p "$d/app"; printf "[package]\nname = \"tcopos\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\ndata Chain : Type where\n  Nil2 : Chain\n  Cons2 : Chain -> Chain\n\nbuild : Int -> Chain -> Chain\nbuild n acc = if n <= 0 then acc else build (n - 1) (Cons2 acc)\n\nifTail : Int -> Int\nifTail n = if n <= 0 then 0 else ifTail (n - 1)\n\nchainTail : Chain -> Int\nchainTail c = case c of\n  Nil2 => 0\n  Cons2 k => chainTail k\n\nnatTail : Nat -> Int\nnatTail n = case n of\n  Zero => 0\n  Succ k => natTail k\n\nmain : Int\nmain = ifTail 300000 + chainTail (build 300000 Nil2) + natTail (natFromInt 300000)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcopos-out" "$d"'
exit: 0
run: "$TMPDIR/tcopos-out/bin/tcopos" 2>&1
exit: 0
out-equals: 0

# 9ae) 来参区不够时不发尾调用：窄函数尾调 8 参宽函数回退普通 `call`，语义不变；
#      `Main.s` 里该调用点是 `call`，而宽函数尾调窄函数（够用）仍是 `jmp`。
run: sh -c 'd="$TMPDIR/tcofb"; mkdir -p "$d/app"; printf "[package]\nname = \"tcofb\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "narrow : Int -> Int\nnarrow n = if n <= 0 then 42 else wide8 (n - 1) 1 2 3 4 5 6 n\n\nwide8 : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\nwide8 n a b c d e f g = narrow n\n\nmain : Int\nmain = narrow 50000\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcofb-out" "$d"'
exit: 0
run: "$TMPDIR/tcofb-out/bin/tcofb" 2>&1
exit: 0
out-equals: 42
run: sh -c 'grep -q "call vuna_wide8" "$TMPDIR/tcofb-out/Main.s"'
exit: 0
run: sh -c '! grep -q "jmp vuna_wide8" "$TMPDIR/tcofb-out/Main.s"'
exit: 0
run: sh -c 'grep -q "jmp vuna_narrow" "$TMPDIR/tcofb-out/Main.s"'
exit: 0

# 9af) 尾调用 × 续延 × GC：resume 之后的尾递归循环在 `GC_STRESS` 下输出一致。
run: sh -c 'd="$TMPDIR/tcoeff"; mkdir -p "$d/app"; printf "[package]\nname = \"tcoeff\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Nat as Nat\nimport Base.Data.String as String\n\ndata POp : Type -> Type where\n  P : Int -> POp Int\n\nloop : Nat -> Int -> Int\nloop n acc = case n of\n  Zero => acc\n  Succ k => loop k (acc + strLength (strFromInt k))\n\nwork : Eff [POp] Int\nwork = do\n  x <- perform (P 1)\n  pure (loop (natFromInt 20000) x)\n\nmain : Int\nmain = runPure (handle work { P n k -> k n })\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcoeff-out" "$d"'
exit: 0
run: "$TMPDIR/tcoeff-out/bin/tcoeff" 2>&1
exit: 0
out-equals: 88891
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/tcoeff-out/bin/tcoeff" 2>&1'
exit: 0
out-equals: 88891

# 9ag) 尾调用不影响确定性：带尾调用的程序两次 compile 的文件集逐字节一致。
run: sh -c '"$VUNA" compile "$TMPDIR/tcowide/app/Main.vuna" "$TMPDIR/dettco-a" --target native; "$VUNA" compile "$TMPDIR/tcowide/app/Main.vuna" "$TMPDIR/dettco-b" --target native; diff -r "$TMPDIR/dettco-a" "$TMPDIR/dettco-b"'
exit: 0

# 9ah) 闭包体的来参区按闭包 ABI 算（`rdi` 占掉一个寄存器）：8 参 lambda 尾调 10 参函数
#      正好用满 32 字节来参区，仍然发 `jmp`；wide10 自己的递归走本地循环。
run: sh -c 'd="$TMPDIR/tcolam"; mkdir -p "$d/app"; printf "[package]\nname = \"tcolam\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "wide10 : Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int\nwide10 a b c d e f g h i n =\n  if n <= 0 then a + b + c + d + e + f + g + h + i\n  else wide10 a b c d e f g h i (n - 1)\n\napply8 : (Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int) -> Int\napply8 f = f 1 2 3 4 5 6 7 8\n\nmain : Int\nmain = apply8 (\\\\a, b, c, d, e, f, g, h => wide10 a b c d e f g h 0 100000)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcolam-out" "$d"'
exit: 0
run: "$TMPDIR/tcolam-out/bin/tcolam" 2>&1
exit: 0
out-equals: 36
run: sh -c 'grep -c "jmp vuna_wide10" "$TMPDIR/tcolam-out/Main.s"'
out-equals: 1

# 9ai) 源级 let 的立即 lambda 内联：循环体不再分配闭包、不再走 `call r11`。
run: sh -c 'd="$TMPDIR/tcolet"; mkdir -p "$d/app"; printf "[package]\nname = \"tcolet\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nloop : Nat -> Int\nloop n = case n of\n  Zero => 0\n  Succ k => let x = 1 in loop k\n\nmain : Int\nmain = loop (natFromInt 1000)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcolet-out" "$d"'
exit: 0
run: "$TMPDIR/tcolet-out/bin/tcolet" 2>&1
exit: 0
out-equals: 0
run: sh -c '! grep -q "vuna_loop_lam" "$TMPDIR/tcolet-out/Main.s"'
exit: 0
run: sh -c '! grep -q "call r11" "$TMPDIR/tcolet-out/Main.s"'
exit: 0

# 9aj) 闭包尾调用 + wrapper 尾跳：函数值递归在默认 8 MiB 栈上跑 20 万层，GC_STRESS 一致。
run: sh -c 'd="$TMPDIR/tcoclosure"; mkdir -p "$d/app"; printf "[package]\nname = \"tcoclosure\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.List as List\nimport Base.Data.Nat as Nat\n\napply : (Int -> Int) -> Int -> Int\napply f k = f k\n\nbuild : Nat -> List Int -> List Int\nbuild n acc = case n of\n  Zero => acc\n  Succ k => build k (0 :: acc)\n\ngo : List Int -> Int\ngo xs = case xs of\n  [] => 0\n  y :: ys => apply (\\\\u => go ys) 0\n\nmain : Int\nmain = go (build (natFromInt 200000) [])\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcoclosure-out" "$d"'
exit: 0
run: "$TMPDIR/tcoclosure-out/bin/tcoclosure" 2>&1
exit: 0
out-equals: 0
run: sh -c 'grep -q "jmp r11" "$TMPDIR/tcoclosure-out/Main.s"'
exit: 0

# 9aj2) 闭包尾调用的 GC 压力：小规模深递归，确认保守 GC 不破坏迭代值。
run: sh -c 'd="$TMPDIR/tcoclosuregc"; mkdir -p "$d/app"; printf "[package]\nname = \"tcoclosuregc\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.List as List\nimport Base.Data.Nat as Nat\n\napply : (Int -> Int) -> Int -> Int\napply f k = f k\n\nbuild : Nat -> List Int -> List Int\nbuild n acc = case n of\n  Zero => acc\n  Succ k => build k (0 :: acc)\n\ngo : List Int -> Int\ngo xs = case xs of\n  [] => 0\n  y :: ys => apply (\\\\u => go ys) 0\n\nmain : Int\nmain = go (build (natFromInt 30000) [])\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcoclosuregc-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/tcoclosuregc-out/bin/tcoclosuregc" 2>&1'
exit: 0
out-equals: 0

# 9ak) 运行时符号尾调用：饱和 runtime 调用在结果位置发 `jmp rt_*`。
run: sh -c 'd="$TMPDIR/tcort"; mkdir -p "$d/app"; printf "[package]\nname = \"tcort\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\nimport Base.Data.String as String\n\nrtTail : Nat -> Int\nrtTail n = case n of\n  Zero => 0\n  Succ k => strLength (strFromInt k)\n\nmain : Int\nmain = rtTail (natFromInt 10)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcort-out" "$d"'
exit: 0
run: "$TMPDIR/tcort-out/bin/tcort" 2>&1
exit: 0
out-equals: 1
run: sh -c 'grep -q "jmp rt_str_length" "$TMPDIR/tcort-out/Main.s"'
exit: 0

# 9al) 顶层函数值闭包静态化：引用点是 `lea`，不是每轮 `rt_alloc`。
run: sh -c 'd="$TMPDIR/tcostatic"; mkdir -p "$d/app"; printf "[package]\nname = \"tcostatic\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\ndirect : Nat -> Int\ndirect n = case n of\n  Zero => 0\n  Succ k => direct k\n\napply : (Nat -> Int) -> Nat -> Int\napply f n = f n\n\nmain : Int\nmain = apply direct (natFromInt 1000)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/tcostatic-out" "$d"'
exit: 0
run: "$TMPDIR/tcostatic-out/bin/tcostatic" 2>&1
exit: 0
out-equals: 0
run: sh -c 'grep -q "vuna_static" "$TMPDIR/tcostatic-out/runtime.s"'
exit: 0
run: sh -c 'grep -q "lea rax, \\[rip + vuna_static" "$TMPDIR/tcostatic-out/Main.s"'
exit: 0
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/tcostatic-out/bin/tcostatic" 2>&1'
exit: 0
out-equals: 0

# 11) 文件集按模块切分：改一个模块只重写该模块的 `.s`，其它模块与 runtime 逐字节不变。
run: sh -c 'd="$TMPDIR/loc"; mkdir -p "$d/app" "$d/lib"; printf "[package]\nname = \"loc\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "module Util where\n\nexport answer : Int\nanswer = 41\n" > "$d/lib/Util.vuna"; printf "import Util\n\nmain : Int\nmain = answer + 1\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --no-compile --out "$TMPDIR/loc-a" "$d"'
exit: 0
file-exists: $TMPDIR/loc-a/Util.s
file-exists: $TMPDIR/loc-a/Main.s
file-exists: $TMPDIR/loc-a/runtime.s
run: sh -c 'd="$TMPDIR/loc"; printf "module Util where\n\nexport answer : Int\nanswer = if 1 == 1 then 42 else 0\n" > "$d/lib/Util.vuna"; "$VUNA" build --target native --no-compile --out "$TMPDIR/loc-b" "$d"'
exit: 0
run: sh -c 'cmp "$TMPDIR/loc-a/Main.s" "$TMPDIR/loc-b/Main.s" && cmp "$TMPDIR/loc-a/runtime.s" "$TMPDIR/loc-b/runtime.s"'
exit: 0
run: sh -c '! cmp -s "$TMPDIR/loc-a/Util.s" "$TMPDIR/loc-b/Util.s"'
exit: 0

# 12) build.sh 增量：内容哈希不变就不重编，改一个模块只重编该模块；产物仍可运行。
run: sh -c 'd="$TMPDIR/inc"; mkdir -p "$d/app" "$d/lib"; printf "[package]\nname = \"inc\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "module Util where\n\nexport answer : Int\nanswer = 41\n" > "$d/lib/Util.vuna"; printf "import Util\n\nmain : Int\nmain = answer + 1\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --no-compile --out "$TMPDIR/inc-out" "$d"'
exit: 0
run: sh -c 'cd "$TMPDIR/inc-out" && sh build.sh'
out-contains: native-build: compiled 3 of 3
run: sh -c 'cd "$TMPDIR/inc-out" && sh build.sh'
out-contains: native-build: compiled 0 of 3
run: "$TMPDIR/inc-out/bin/inc" 2>&1
out-equals: 42
run: sh -c 'd="$TMPDIR/inc"; printf "module Util where\n\nexport answer : Int\nanswer = if 1 == 1 then 41 else 0\n" > "$d/lib/Util.vuna"; "$VUNA" build --target native --no-compile --out "$TMPDIR/inc-out" "$d" && cd "$TMPDIR/inc-out" && sh build.sh'
out-contains: native-build: compiled 1 of 3
run: "$TMPDIR/inc-out/bin/inc" 2>&1
out-equals: 42

# 9u) 深目录递归删除：每层栈帧有下界守卫——400 层 trap（exit 2），不再 SIGSEGV（139）。
run: sh -c 'p="$TMPDIR/deep-tree"; rm -rf "$p"; i=0; while [ $i -lt 400 ]; do p="$p/d"; i=$((i+1)); done; mkdir -p "$p"'
run: sh -c 'd="$TMPDIR/deeptree"; mkdir -p "$d/app"; printf "[package]\nname = \"deeptree\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Fs as EffFs\nimport Base.Effect.Core as Eff\n\nmain : Eff [FsOp] Int\nmain = fsRemoveTree \"$TMPDIR/deep-tree\"\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/deeptree-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/deeptree-out/bin/deeptree" 2>&1'
exit: 2
out-contains: directory tree too deep

# 9v) 非 try 宿主符号失败：必须显式可见（exit 2），且首行与 OCaml 后端逐字一致。
#     `try*` 叶子仍返回默认值 + 状态码（库的 Fs handler 走那条路）。
run: sh -c 'd="$TMPDIR/strictfs"; mkdir -p "$d/app"; printf "[package]\nname = \"strictfs\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\n\nmain : Eff [] Int\nmain = do\n  s <- prim_eff_readFile \"/nonexistent-vuna-strict\"\n  pure (strLength s)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/strictfs-n" "$d"'
exit: 0
run: sh -c 'd="$TMPDIR/strictfs"; "$VUNA" build --out "$TMPDIR/strictfs-o" "$d"'
exit: 0
run: sh -c '"$TMPDIR/strictfs-n/bin/strictfs" 2> "$TMPDIR/strictfs-n.err"; echo $?'
out-equals: 2
run: sh -c '"$TMPDIR/strictfs-o/bin/strictfs" 2> "$TMPDIR/strictfs-o.err"; echo $?'
out-equals: 2
run: sh -c 'head -1 "$TMPDIR/strictfs-n.err"'
out-equals: vuna: runtime error: readFile: /nonexistent-vuna-strict: No such file or directory
run: sh -c 'head -1 "$TMPDIR/strictfs-n.err" > "$TMPDIR/strictfs-n.line"; head -1 "$TMPDIR/strictfs-o.err" > "$TMPDIR/strictfs-o.line"; cmp "$TMPDIR/strictfs-n.line" "$TMPDIR/strictfs-o.line"'
exit: 0

# 9w) 大文件读取：没有固定缓冲上界（12 MiB > 8 MiB 旧上界），按 stat 尺寸一次分配再读到 EOF。
run: sh -c 'dd if=/dev/zero of="$TMPDIR/big-read.dat" bs=1024 count=12288 2>/dev/null'
run: sh -c 'd="$TMPDIR/bigread"; mkdir -p "$d/app"; printf "[package]\nname = \"bigread\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Fs as EffFs\n\nmain : Eff [FsOp] Int\nmain = do\n  s <- fsReadFile \"$TMPDIR/big-read.dat\"\n  pure (strLength s)\n" > "$d/app/Main.vuna"; "$VUNA" build --target native --out "$TMPDIR/bigread-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/bigread-out/bin/bigread" 2>&1'
out-equals: 12582912
