# store-isolated: 断言对象库行为，使用 case 私有 store。
# 79) 依赖身份：依赖方只消费依赖根的源闭包 + manifest（没有独立身份对象）。
#     依赖源码变化（含注释）都会换依赖方地址；透明体/接口变化仍然判脏。
run: sh -c 'S="$TMPDIR/di"; rm -rf "$S"; mkdir -p "$S/dep/lib" "$S/mid/lib" "$S/mid/app"; printf "[package]\nname = \"dep\"\n[export]\nmodules = [\"D\"]\n" > "$S/dep/vuna.toml"; printf "module D where\n\nexport f : Int -> Int\nf x = x\n" > "$S/dep/lib/D.vuna"; printf "[package]\nname = \"mid\"\n[export]\nmodules = [\"M\"]\n\n[dependencies.dep]\npath = \"../dep\"\n" > "$S/mid/vuna.toml"; printf "module M where\n\nimport D\n\nexport g : Int\ng = f 1\n" > "$S/mid/lib/M.vuna"; printf "import M\n\nmain : Int\nmain = g\n" > "$S/mid/app/Main.vuna"; VUNA_STORE="$S/store" "$VUNA" check "$S/dep" >/dev/null 2>&1 && VUNA_STORE="$S/store" "$VUNA" check "$S/mid" >/dev/null 2>&1'
exit: 0

# 依赖源码追加注释（语义面不变）⇒ 依赖方复用干净模块。
run: sh -c 'S="$TMPDIR/di"; printf "module D where\n\n-- harmless note\nexport f : Int -> Int\nf x = x\n" > "$S/dep/lib/D.vuna"; VUNA_STORE="$S/store" "$VUNA" check "$S/dep" >/dev/null 2>&1; VUNA_LOG=debug VUNA_STORE="$S/store" "$VUNA" check "$S/mid" 2>&1'
exit: 0
out-contains: dep-identity=dep verdict=manifest

# 依赖 manifest 追加注释（非语义配置）⇒ 依赖方复用干净模块。
run: sh -c 'S="$TMPDIR/di"; printf "\n# dep note\n" >> "$S/dep/vuna.toml"; VUNA_STORE="$S/store" "$VUNA" check "$S/dep" >/dev/null 2>&1; VUNA_LOG=debug VUNA_STORE="$S/store" "$VUNA" check "$S/mid" 2>&1'
exit: 0

# 依赖的透明定义体变化（接口语义面变化）⇒ 依赖方重新精化。
run: sh -c 'S="$TMPDIR/di"; printf "module D where\n\n-- harmless note\nexport f : Int -> Int\nf x = 1\n" > "$S/dep/lib/D.vuna"; VUNA_STORE="$S/store" "$VUNA" check "$S/dep" >/dev/null 2>&1; VUNA_LOG=debug VUNA_STORE="$S/store" "$VUNA" check "$S/mid" 2>&1'
exit: 0

# 依赖新增导出（接口变化）⇒ 依赖方重新精化；随后只改 opaque 体 ⇒ 依赖方复用。
run: sh -c 'S="$TMPDIR/di"; printf "module D where\n\n-- harmless note\nexport f : Int -> Int\nf x = 1\n\nexport opaque h : Int\nh = 7\n" > "$S/dep/lib/D.vuna"; VUNA_STORE="$S/store" "$VUNA" check "$S/dep" >/dev/null 2>&1; VUNA_LOG=debug VUNA_STORE="$S/store" "$VUNA" check "$S/mid" 2>&1'
exit: 0

run: sh -c 'S="$TMPDIR/di"; printf "module D where\n\n-- harmless note\nexport f : Int -> Int\nf x = 1\n\nexport opaque h : Int\nh = 8\n" > "$S/dep/lib/D.vuna"; VUNA_STORE="$S/store" "$VUNA" check "$S/dep" >/dev/null 2>&1; VUNA_LOG=debug VUNA_STORE="$S/store" "$VUNA" check "$S/mid" 2>&1'
exit: 0

# 没有身份对象：删掉中间对象目录后仍能检查（地址只由源码 + manifest 决定）。
run: sh -c 'S="$TMPDIR/di"; rm -rf "$S/store/objects/pkg-summary"; VUNA_STORE="$S/store" "$VUNA" check "$S/mid" >/dev/null 2>&1'
exit: 0

# 热 store：依赖源码改了但依赖没重跑 ⇒ 依赖方必须重算并报错，不能假命中。
# 回退身份含该根源闭包摘要，所以「依赖已 check 过」也挡不住源码变化。
run: sh -c 'S="$TMPDIR/dsw"; rm -rf "$S"; mkdir -p "$S/dep/lib" "$S/mid/lib" "$S/mid/app"; printf "[package]\nname = \"dep\"\n[export]\nmodules = [\"D\"]\n" > "$S/dep/vuna.toml"; printf "module D where\n\nexport f : Int -> Int\nf x = x\n" > "$S/dep/lib/D.vuna"; printf "[package]\nname = \"mid\"\n[export]\nmodules = [\"M\"]\n\n[dependencies.dep]\npath = \"../dep\"\n" > "$S/mid/vuna.toml"; printf "module M where\n\nimport D\n\nexport g : Int\ng = f 1\n" > "$S/mid/lib/M.vuna"; printf "import M\n\nmain : Int\nmain = g\n" > "$S/mid/app/Main.vuna"; VUNA_STORE="$S/store" "$VUNA" check "$S/dep" >/dev/null 2>&1 && VUNA_STORE="$S/store" "$VUNA" check "$S/mid" >/dev/null 2>&1'
exit: 0

run: sh -c 'S="$TMPDIR/dsw"; printf "module D where\n\nexport f : Int -> String\nf x = \"s\"\n" > "$S/dep/lib/D.vuna"; VUNA_LOG=debug VUNA_STORE="$S/store" "$VUNA" check "$S/mid" 2>&1'
exit: 1
out-contains: TC_TypeMismatch

# 冷 store：依赖从未 check、依赖方先 check；随后改依赖源码仍必须重算。
run: sh -c 'S="$TMPDIR/dsc"; rm -rf "$S"; mkdir -p "$S/dep/lib" "$S/mid/lib" "$S/mid/app"; printf "[package]\nname = \"dep\"\n[export]\nmodules = [\"D\"]\n" > "$S/dep/vuna.toml"; printf "module D where\n\nexport f : Int -> Int\nf x = x\n" > "$S/dep/lib/D.vuna"; printf "[package]\nname = \"mid\"\n[export]\nmodules = [\"M\"]\n\n[dependencies.dep]\npath = \"../dep\"\n" > "$S/mid/vuna.toml"; printf "module M where\n\nimport D\n\nexport g : Int\ng = f 1\n" > "$S/mid/lib/M.vuna"; printf "import M\n\nmain : Int\nmain = g\n" > "$S/mid/app/Main.vuna"; VUNA_LOG=debug VUNA_STORE="$S/store" VUNA_PKG_STATE="$S/state" "$VUNA" check "$S/mid" 2>&1'
exit: 0
out-contains: dep-build=dep

run: sh -c 'S="$TMPDIR/dsc"; printf "module D where\n\nexport f : Int -> String\nf x = \"s\"\n" > "$S/dep/lib/D.vuna"; VUNA_LOG=debug VUNA_STORE="$S/store" VUNA_PKG_STATE="$S/state" "$VUNA" check "$S/mid" 2>&1'
exit: 1
out-contains: TC_TypeMismatch

# 依赖接口缺件（状态目录被清）⇒ 递归构建依赖后继续，而不是整包回退。
run: sh -c 'S="$TMPDIR/dsc"; rm -rf "$S/state"; VUNA_LOG=debug VUNA_STORE="$S/store" VUNA_PKG_STATE="$S/state" "$VUNA" check "$S/mid" 2>&1'
exit: 1
out-contains: dep-build=dep
out-contains: TC_TypeMismatch
