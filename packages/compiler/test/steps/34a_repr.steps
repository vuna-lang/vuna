# 34a) DT 核心路径的产物表示断言。
# Nat 零开销表示：产物里不得出现 Nat 变体类型/构造子，算术走 bi_nat*。
# 夹具：$VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/73_nat_repr.vuna。
run: "$VUNA" compile $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/73_nat_repr.vuna "$TMPDIR/nat-repr" 2>&1
exit: 0
out-equals:
run: sh -c 'grep -qE "(^|[^A-Za-z0-9_])t_Nat([^A-Za-z0-9_]|$)|(^|[^A-Za-z0-9_])C_Nat_" "$TMPDIR/nat-repr"/*.ml'
exit: nonzero
read: $TMPDIR/nat-repr/Main.ml
out-contains: bi_natAdd
# 表现层：含类型族（不可命名的擦除依赖）的程序必须生成不透明运行时值
# （Obj.t 字段）+ 表现层 cast（Obj.magic）；不含类型族的程序两者都不得出现。
# 夹具：$VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/82_eff_cps.vuna（含类型族）/ $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/01_id.vuna（不含）。
run: "$VUNA" compile $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/82_eff_cps.vuna "$TMPDIR/d27-opaque" 2>&1
exit: 0
out-equals:
read: $TMPDIR/d27-opaque/Main.ml
out-contains: Obj.t
out-contains: Obj.magic
run: "$VUNA" compile $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/01_id.vuna "$TMPDIR/d27-plain" 2>&1
exit: 0
out-equals:
run: sh -c 'grep -qE "Obj\.magic|Obj\.t" "$TMPDIR/d27-plain/Main.ml"'
exit: nonzero
# 精化期未解 meta 终解成不可命名类型：binder 的使用点同样要 cast。
# 夹具：$VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/39_meta_cast.vuna
# 的 λ 参数先建元变量，体不约束它，直到 `xs : List (resOp GetS)` 参与合一才解成
# 类型族应用（不可命名）——`s` 的每次使用必须带 `prim_erase`（OCaml 侧 `Obj.magic`）。
run: "$VUNA" compile $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/39_meta_cast.vuna "$TMPDIR/d27-meta" 2>&1
exit: 0
out-equals:
read: $TMPDIR/d27-meta/Main.ml
out-contains: (Obj.magic s)