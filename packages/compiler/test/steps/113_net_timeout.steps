# matrix: effect-ocaml
# 113) net 超时与句柄失效：
#      - `netAcceptWithin` / `netRecvWithin` 到点给 `StepTimeout`（不阻塞）；
#        `netSendWithin` 对小载荷正常完成（`StepOk`）。
#      - 句柄失效（重复 close）是 typed `NetBadHandle`：entry 收口成诊断 + 退出码 1。
run: sh -c 'rm -rf "$TMPDIR/n113"; mkdir -p "$TMPDIR/n113/app"; printf "[package]\nname = \"n113\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$TMPDIR/n113/vuna.toml"; printf "%s\n" "import Prelude" "import Base.Effect.Core as Eff" "import Base.Effect.Net as EffNet" "import Base.Effect.Console as EffConsole" "import Base.Effect.Env as EffEnv" "import Base.Effect.Args as EffArgs" "" "tagI : NetStep Int -> String" "tagI (StepOk _) = \"ok\"" "tagI StepClosed = \"closed\"" "tagI StepTimeout = \"timeout\"" "" "tagS : NetStep String -> String" "tagS (StepOk _) = \"ok\"" "tagS StepClosed = \"closed\"" "tagS StepTimeout = \"timeout\"" "" "timeoutCase : Eff [ConsoleOp, EnvOp, ArgsOp, NetOp] Int" "timeoutCase = do" "  sock <- envGetEnv \"VUNA_N113_SOCK\"" "  h <- netListen \"unix:\${sock}\"" "  c <- netConnect \"unix:\${sock}\"" "  _ <- netAccept h" "  a <- netAcceptWithin h 200000" "  r <- netRecvWithin c 16 200000" "  s <- netSendWithin c \"x\" 200000" "  _ <- netClose c" "  _ <- netClose h" "  _ <- consolePrint \"accept2=\${tagI a} recv=\${tagS r} send=\${tagI s}\\n\"" "  pure 0" "" "badCase : Eff [ConsoleOp, EnvOp, ArgsOp, NetOp] Int" "badCase = do" "  h <- netListen \"tcp:127.0.0.1:0\"" "  _ <- netClose h" "  c <- netClose h" "  pure c" "" "main : Eff [ConsoleOp, EnvOp, ArgsOp, NetOp] Int" "main = do" "  args <- argsGetArgs" "  case args of" "    [\"timeout\"] => timeoutCase" "    [\"badhandle\"] => badCase" "    _ => pure 2" > "$TMPDIR/n113/app/Main.vuna"'
exit: 0
run: "$VUNA" build "$TMPDIR/n113" >/dev/null 2>&1
exit: 0
# 超时：先建一个连接（accept 有 pending），第二次 accept 与 recv 都没进展 → timeout；
# 小载荷 send 有缓冲空间 → ok。
run: sh -c 'rm -f "$TMPDIR/n113.sock"; VUNA_N113_SOCK="$TMPDIR/n113.sock" "$TMPDIR/n113/.output/bin/n113" timeout 2>&1'
exit: 0
out-contains: accept2=timeout recv=timeout send=ok
# 句柄失效：重复 close → NetBadHandle，entry 收口（exit 1）。
run: "$TMPDIR/n113/.output/bin/n113" badhandle 2>&1
exit: 1
out-contains: vuna: net: close handle 1: invalid handle