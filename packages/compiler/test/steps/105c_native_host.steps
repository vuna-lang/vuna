# matrix: effect-native
# 105c) native 后端：宿主效应、进程边界与资源限制。
#     argv / env / cwd / clock、bracket 清理、fs 全族与失败路径、内存预算、总超时、
#     spawn 的进程组与 argv 边界、自带栈、核数钉住、限制类 env 不外传。
# 9o) 宿主入参/环境/目录/时钟：argv 不含 argv[0]，envp 键值扫描，cwd/execPath 非空，
#     sleep 后时间不倒退；结果 2+5+1+1+1 = 10。
run: sh -c 'd="$TMPDIR/hostargs"; mkdir -p "$d/app"; printf "[package]\nname = \"hostargs\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Clock as EffClock\nimport Base.Effect.Env as EffEnv\nimport Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.String as String\n\nmain : Eff [ArgsOp, ClockOp, EnvOp] Int\nmain = do\n  args <- argsGetArgs\n  home <- envGetEnv \"VUNA_TEST_ENV\"\n  cwd <- envGetCwd\n  exe <- envExecPath\n  t0 <- clockNow\n  _ <- clockSleepMicros 1000\n  t1 <- clockNow\n  pure (length args + strLength home + (if strLength cwd > 0 then 1 else 0) + (if strLength exe > 0 then 1 else 0) + (if t1 >= t0 then 1 else 0))\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/hostargs-out" "$d"'
exit: 0
run: sh -c 'VUNA_TEST_ENV=hello "$TMPDIR/hostargs-out/bin/hostargs" one two 2>&1'
exit: 0
out-equals: 10

# 9p) bracket/finally：cleanup 登记表 push/pop（正常路径；abort 不运行，与 wasm 同边界）。
run: sh -c 'd="$TMPDIR/bracket"; mkdir -p "$d/app"; printf "[package]\nname = \"bracket\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Data.Int as Int\n\nmain : Int\nmain = runPure (bracket (pure 7) (\\\\_ => pure 0) (\\\\r => pure (r * 6)))\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/bracket-out" "$d"'
exit: 0
run: "$TMPDIR/bracket-out/bin/bracket" 2>&1
out-equals: 42

# 9q) 宿主 fs：建/写/读/原子写/目录列举（排序）/stat/rename/symlink/递归删除。
#     a="hello"(5) + b="atomic"(6) + entries 2 + isDir 1 + exists 1 + size 5 + mtime 1 = 21。
run: sh -c 'd="$TMPDIR/fsops"; mkdir -p "$d/app"; printf "[package]\nname = \"fsops\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Bool as Bool\nimport Base.Effect.Core as Eff\nimport Base.Effect.Fs as EffFs\nimport Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.Maybe as Maybe\nimport Base.Data.Nat as Nat\nimport Base.Data.String as String\n\ndir : String\ndir = \"$TMPDIR/fs-tree\"\n\nmain : Eff [FsOp] Int\nmain = do\n  _ <- fsRemoveTree dir\n  _ <- fsMakeDir dir\n  _ <- fsWriteFile (dir ++ \"/a.txt\") \"hello\"\n  _ <- fsWriteFileAtomic (dir ++ \"/b.txt\") \"atomic\"\n  a <- fsReadFile (dir ++ \"/a.txt\")\n  b <- fsReadFile (dir ++ \"/b.txt\")\n  entries <- fsReadDir dir\n  isd <- fsIsDirectory dir\n  ex <- fsFileExists (dir ++ \"/a.txt\")\n  sz <- fsFileSize (dir ++ \"/a.txt\")\n  mt <- fsFileMtime (dir ++ \"/a.txt\")\n  _ <- fsRename (dir ++ \"/b.txt\") (dir ++ \"/c.txt\")\n  _ <- fsSymlink (dir ++ \"/a.txt\") (dir ++ \"/link\")\n  _ <- fsRemoveFile (dir ++ \"/c.txt\")\n  _ <- fsRemoveTree dir\n  pure (strLength a + strLength b + length entries + (if isd then 1 else 0) + (if ex then 1 else 0) + maybe 0 (\\\\n => natToInt n) sz + maybe 0 (\\\\_ => 1) mt)\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/fsops-out" "$d"'
exit: 0
run: "$TMPDIR/fsops-out/bin/fsops" 2>&1
out-equals: 21
run: sh -c 'test ! -e "$TMPDIR/fs-tree" && echo cleaned'
out-equals: cleaned

# 9r) readDir 按字典序（`Sys.readdir` + `sort compare` 语义）：建 c/a/b -> "abc"。
#     GC_STRESS 下再跑一遍：名字在转成 Vuna String 前不能只躺在 GC 不扫的 .bss 数组里。
run: sh -c 'd="$TMPDIR/fsdir"; mkdir -p "$d/app"; printf "[package]\nname = \"fsdir\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Fs as EffFs\nimport Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.String as String\n\ndir : String\ndir = \"$TMPDIR/fs-dir\"\n\nmain : Eff [FsOp] String\nmain = do\n  _ <- fsRemoveTree dir\n  _ <- fsMakeDir dir\n  _ <- fsWriteFile (dir ++ \"/c\") \"\"\n  _ <- fsWriteFile (dir ++ \"/a\") \"\"\n  _ <- fsWriteFile (dir ++ \"/b\") \"\"\n  xs <- fsReadDir dir\n  pure (case xs of\n    x :: y :: z :: _ => x ++ y ++ z\n    _ => \"?\")\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/fsdir-out" "$d"'
exit: 0
run: "$TMPDIR/fsdir-out/bin/fsdir" 2>&1
out-equals: "abc"
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/fsdir-out/bin/fsdir" 2>&1'
out-equals: "abc"
run: sh -c 'test "$(grep -c "call rt_write_barrier" "$TMPDIR/fsdir-out/runtime.s")" -ge 3'
# 3 = `sort_list` 一处 + `insert_sorted` 两处（fsReadDir → 排序路径）；可变单元的写屏障
# （`mref_write`）只在用到 MutRef 时才会进产物（运行时函数按 `_start` 可达性裁剪）。
exit: 0

# 9s) fs 失败路径：读不存在的文件 -> typed error 收口（诊断 + exit 1），不伪造内容。
run: sh -c 'd="$TMPDIR/fsmiss"; mkdir -p "$d/app"; printf "[package]\nname = \"fsmiss\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Fs as EffFs\nimport Base.Data.Int as Int\nimport Base.Data.String as String\n\nmain : Eff [FsOp] Int\nmain = do\n  s <- fsReadFile \"$TMPDIR/fs-missing-file\"\n  pure (strLength s)\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/fsmiss-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/fsmiss-out/bin/fsmiss" 2>&1'
exit: 1
out-contains: fs: readFile

# 9t) 内存预算：缺省是 `max(1 GiB, 2 × live + 256 MiB)`（常量在 `runtime.s`；
#     缺省模式下每次回收后按 live 抬高），`VUNA_NATIVE_MEM_LIMIT` 显式设置时是硬上限：
#     超限 trap `memory limit exceeded` + exit 2；未超限时输出不变。
run: sh -c 'd="$TMPDIR/memlim"; mkdir -p "$d/app"; printf "[package]\nname = \"memlim\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\nrep : Nat -> String -> String\nrep n s = case n of\n  Zero => \"\"\n  Succ k => s ++ rep k s\n\nmain : Int\nmain = strLength (rep (natFromInt 5000) \"0123456789abcdef\")\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/memlim-out" "$d"'
exit: 0
file-contains: $TMPDIR/memlim-out/runtime.s 1073741824
run: "$TMPDIR/memlim-out/bin/memlim" 2>&1
out-equals: 80000
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=1000 "$TMPDIR/memlim-out/bin/memlim" 2>&1'
exit: 2
out-equals: vuna: runtime error: memory limit exceeded

# 9u) 总超时：`VUNA_NATIVE_TIMEOUT_MS` 到点由 SIGALRM 写固定文本 + exit 2
#     （阻塞在 nanosleep 里也能被打断）。
run: sh -c 'd="$TMPDIR/sleepy"; mkdir -p "$d/app"; printf "[package]\nname = \"sleepy\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Clock as EffClock\n\nmain : Eff [ClockOp] Int\nmain = do\n  _ <- clockSleepMicros 1000000\n  pure 0\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/sleepy-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=100 "$TMPDIR/sleepy-out/bin/sleepy" 2>&1'
exit: 2
out-equals: vuna: runtime error: timeout exceeded

# 9u2) 超时连带子进程组：`runIn` 起的 `/bin/sh` 在超时生效时 `setpgid(0, 0)` 自成一组，
#      SIGALRM 里 `kill(-pid)` 把它的后台 `sleep` 一起收掉（不能只剩父进程 exit 2）。
run: sh -c 'd="$TMPDIR/timeoutkill"; mkdir -p "$d/app"; printf "[package]\nname = \"timeoutkill\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [ProcessOp] Int\nmain = processRunIn \".\" [\"sh\", \"-c\", \"sleep 300 & echo \$! > \$TMPDIR/child.pid; wait\"]\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/timeoutkill-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=300 "$TMPDIR/timeoutkill-out/bin/timeoutkill" 2>&1'
exit: 2
out-equals: vuna: runtime error: timeout exceeded
run: sh -c 'pid=$(cat "$TMPDIR/child.pid" 2>/dev/null); [ -n "$pid" ] || { echo "no child pid recorded"; exit 1; }; st=$(awk "{print \$3}" "/proc/$pid/stat" 2>/dev/null || echo gone); [ "$st" != S ] || { echo "child $pid still running"; exit 1; }; echo swept'
out-equals: swept

# 9u3) 未装定时器时不改进程组：`runIn` 的子进程 pgid 仍等于父进程（steps 自己的 shell）的
#      pgid，保持 Ctrl-C 的原有语义。产物还会打印 main 的返回值，取首行比较。
run: sh -c 'd="$TMPDIR/pgid"; mkdir -p "$d/app"; printf "[package]\nname = \"pgid\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [ProcessOp] Int\nmain = processRunIn \".\" [\"sh\", \"-c\", \"ps -o pgid= -p \$\$\"]\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/pgid-out" "$d"'
exit: 0
run: sh -c 'out=$("$TMPDIR/pgid-out/bin/pgid" | head -n 1 | tr -d " "); me=$(ps -o pgid= -p $$ | tr -d " "); [ "$out" = "$me" ] || { echo "pgid $out != $me"; exit 1; }; echo same-group'
out-equals: same-group

# 9u3b) runIn 不改进程级 cwd：`cd` 在子进程里做，父进程前后的 `envGetCwd` 必须一致
#       （多线程下父进程 cwd 被改会让别的线程的相对路径落到别人的目录）。
run: sh -c 'd="$TMPDIR/runincwd"; mkdir -p "$d/app"; printf "[package]\nname = \"runincwd\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Env as EffEnv\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [EnvOp, ProcessOp] Int\nmain = do\n  before <- envGetCwd\n  _ <- processRunIn \"/tmp\" [\"pwd\"]\n  after <- envGetCwd\n  pure (if before == after then 1 else 0)\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/runincwd-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/runincwd-out/bin/runincwd" 2>&1 | tail -n 1'
out-equals: 1

# 9u3c) runIn 的目录进不去：子进程把 errno 经管道回传，父进程报 `ProcessNoDir`
#       （typed error 收口，exit 1），不是静默返回 shell 的失败码。
run: sh -c 'd="$TMPDIR/runinmiss"; mkdir -p "$d/app"; printf "[package]\nname = \"runinmiss\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [ProcessOp] Int\nmain = processRunIn \"$TMPDIR/no-such-runin-dir\" [\"true\"]\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/runinmiss-out" "$d"'
exit: 0
run: "$TMPDIR/runinmiss-out/bin/runinmiss" 2>&1
exit: 1
out-contains: no such directory

# 9u4) 并发 spawn：两个 `processSpawn` 各自成组，只 `processWait` 第一个；超时 handler 必须
#      遍历 pid 槽把**两组**都收掉（先返回的 wait 不能清掉另一组的槽）。native 的 `spawn` 是
#      `execve(/proc/self/exe, args)`，所以子进程按 argv 变成 worker，再从 worker 里起
#      `/bin/sh`：这样每组都带一个后台 `sleep`，能验证整组（不只是直接子进程）被收掉。
run: sh -c 'd="$TMPDIR/spawnslots"; mkdir -p "$d/app"; printf "[package]\nname = \"spawnslots\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.String as String\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Core as Eff\nimport Base.Effect.Env as EffEnv\nimport Base.Effect.Fs as EffFs\nimport Base.Effect.Process as EffProcess\n\nworker : String -> Eff [EnvOp, ProcessOp] String\nworker c = do\n  _ <- processRunIn \".\" [\"sh\", \"-c\", c]\n  pure \"worker\"\n\nparent : Eff [EnvOp, FsOp, ProcessOp] String\nparent = do\n  tmp <- envGetEnv \"TMPDIR\"\n  secs <- envGetEnv \"SLOTS_SLEEP\"\n  p1 <- processSpawn [\"sleep \" ++ secs ++ \" & echo \$! > \" ++ tmp ++ \"/s1.pid; wait\"]\n  p2 <- processSpawn [\"sleep \" ++ secs ++ \" & echo \$! > \" ++ tmp ++ \"/s2.pid; wait\"]\n  _ <- fsWriteFile (tmp ++ \"/c1.pid\") (strFromInt p1)\n  _ <- fsWriteFile (tmp ++ \"/c2.pid\") (strFromInt p2)\n  _ <- processWait p1\n  _ <- processWait p2\n  pure \"done\"\n\nmain : Eff [ArgsOp, EnvOp, FsOp, ProcessOp] String\nmain = do\n  args <- argsGetArgs\n  case args of\n    c :: _ => worker c\n    [] => parent\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/spawnslots-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=500 SLOTS_SLEEP=300 "$TMPDIR/spawnslots-out/bin/spawnslots" 2>&1'
exit: 2
out-equals: vuna: runtime error: timeout exceeded
run: sh -c 'for f in c1 c2 s1 s2; do pid=$(cat "$TMPDIR/$f.pid" 2>/dev/null); [ -n "$pid" ] || { echo "no $f pid"; exit 1; }; st=$(awk "{print \$3}" "/proc/$pid/stat" 2>/dev/null || echo gone); [ "$st" != S ] || { echo "$f $pid still running"; exit 1; }; done; echo swept-both'
out-equals: swept-both
# 反向：不设超时时同产物能正常等两次并 exit 0（spawn 语义或屏蔽/解除屏蔽接线坏了会在这里挂住）。
run: sh -c 'SLOTS_SLEEP=0 "$TMPDIR/spawnslots-out/bin/spawnslots" 2>&1'
exit: 0
out-contains: done

# 9u4b) 子进程表容量：32 个并发 spawn（超过旧实现的 8 槽）在超时时必须**全部**被收掉。
#      每个 worker 在 `runIn` 里起 `/bin/sh`，sh 再起后台 `sleep` 并写下它的 pid：
#      漏记的组会作为孤儿活到 `sleep` 结束（这里 300s），检查会读到 S 状态。
#      anchor 让父进程停在 wait 里，超时才有意义。
run: sh -c 'd="$TMPDIR/spawnmany"; mkdir -p "$d/app"; printf "[package]\nname = \"spawnmany\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Int as Int\nimport Base.Data.List as List\nimport Base.Data.String as String\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Core as Eff\nimport Base.Effect.Env as EffEnv\nimport Base.Effect.Process as EffProcess\n\nworker : String -> Eff [ProcessOp] Int\nworker c = do\n  _ <- processRunIn \".\" [\"sh\", \"-c\", c]\n  pure 0\n\ncmd : String -> Int -> String\ncmd tmp k = \"sleep 300 & echo \$! > \" ++ tmp ++ \"/m\" ++ strFromInt k ++ \".pid; wait\"\n\nspawnLoop : Int -> String -> Eff [ProcessOp] Int\nspawnLoop k tmp =\n  if k <= 0 then pure 0\n  else do\n    _ <- processSpawn [cmd tmp k]\n    spawnLoop (k - 1) tmp\n\nmain : Eff [ArgsOp, EnvOp, ProcessOp] Int\nmain = do\n  args <- argsGetArgs\n  case args of\n    c :: _ => worker c\n    [] => do\n      tmp <- envGetEnv \"TMPDIR\"\n      anchor <- processSpawn [cmd tmp 0]\n      _ <- spawnLoop 32 tmp\n      _ <- processWait anchor\n      pure 0\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/spawnmany-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=800 "$TMPDIR/spawnmany-out/bin/spawnmany" 2>&1'
exit: 2
out-equals: vuna: runtime error: timeout exceeded
run: sh -c 'n=0; for k in $(seq 0 32); do pid=$(cat "$TMPDIR/m$k.pid" 2>/dev/null); [ -n "$pid" ] || { echo "no m$k pid"; exit 1; }; st=$(awk "{print \$3}" "/proc/$pid/stat" 2>/dev/null || echo gone); [ "$st" != S ] || { echo "m$k $pid still running"; exit 1; }; n=$((n + 1)); done; echo "swept $n"'
out-equals: swept 33

# 9u4c) 子进程表溢出：装了总超时又并发 spawn 出比槽数更多的子进程时，超时机制跟踪不到
#      新子进程，必须**收掉它并报启动失败**（不能静默丢弃——那会让总超时失效）。
#      64 个槽：第 65 个 spawn 走溢出分支，typed error 收口 exit 1。
run: sh -c 'd="$TMPDIR/spawnfull"; mkdir -p "$d/app"; printf "[package]\nname = \"spawnfull\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Int as Int\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nspawnLoop : Int -> Eff [ProcessOp] Int\nspawnLoop k =\n  if k <= 0 then pure 0\n  else do\n    _ <- processSpawn [\"child\"]\n    spawnLoop (k - 1)\n\nmain : Eff [ArgsOp, ProcessOp] Int\nmain = do\n  args <- argsGetArgs\n  case args of\n    [] => spawnLoop 65\n    _ => pure 0\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/spawnfull-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_TIMEOUT_MS=5000 "$TMPDIR/spawnfull-out/bin/spawnfull" 2>"$TMPDIR/spawnfull.err" >/dev/null'
exit: 1
run: sh -c 'cat "$TMPDIR/spawnfull.err"'
out-equals: vuna: process: spawn: too many concurrent child processes

# 9u5) spawn 的多实参按 argv 边界逐项 NUL 分隔：子进程必须看到三个独立实参，
#      而不是一个拼接串。粘连时子进程走 fallback 并 exit 3，父进程报 spawn-argv-fail。
run: sh -c 'd="$TMPDIR/spawnargv"; mkdir -p "$d/app"; printf "[package]\nname = \"spawnargv\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Args as EffArgs\nimport Base.Effect.Exit as EffExit\nimport Base.Effect.Process as EffProcess\nimport Base.Data.Int as Int\n\nmain : Eff [ArgsOp, ExitOp, ProcessOp] String\nmain = do\n  args <- argsGetArgs\n  case args of\n    \"alpha\" :: \"beta\" :: \"gamma\" :: _ => pure \"child-argv-ok\"\n    [] => do\n      pid <- processSpawn [\"alpha\", \"beta\", \"gamma\"]\n      code <- processWait pid\n      pure (if code == 0 then \"spawn-argv-ok\" else \"spawn-argv-fail\")\n    _ => do\n      _ <- exitWith 3\n      pure \"unreachable\"\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/spawnargv-out" "$d"'
exit: 0
run: "$TMPDIR/spawnargv-out/bin/spawnargv" 2>&1
exit: 0
out-contains: child-argv-ok
out-contains: spawn-argv-ok
out-not-contains: spawn-argv-fail

# 9u6) 部分应用的实参根：`rt_apply` 慢路径把实参压成调用栈数组，`apply` 里分配
#      （部分闭包）会触发回收；调用方帧里的实参槽必须在根集里，否则被收掉。
run: sh -c 'd="$TMPDIR/applyroots"; mkdir -p "$d/app"; printf "[package]\nname = \"applyroots\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Int as Int\nimport Base.Data.String as String\n\nf : String -> String -> String\nf a b = a ++ b\n\nmain : Int\nmain =\n  let s = \"keep\" ++ \"-\" ++ \"me\" in\n  let g = f s in\n  strLength (g \"!\")\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/applyroots-out" "$d"'
exit: 0
run: "$TMPDIR/applyroots-out/bin/applyroots" 2>&1
exit: 0
out-equals: 8
run: sh -c 'VUNA_NATIVE_GC_STRESS=1 "$TMPDIR/applyroots-out/bin/applyroots" 2>&1'
exit: 0
out-equals: 8

# 9u7) 自带栈：40 万层非尾递归在 `ulimit -s 8192`（默认 8 MiB）下仍能跑完。
#      生成的二进制启动时 mmap 自己的栈（512 MiB 虚拟，按需提交），不依赖宿主栈上限。
run: sh -c 'd="$TMPDIR/deepstack"; mkdir -p "$d/app"; printf "[package]\nname = \"deepstack\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Int as Int\n\nsumTo : Int -> Int\nsumTo n = if n <= 0 then 0 else n + sumTo (n - 1)\n\nmain : Int\nmain = sumTo 400000\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/deepstack-out" "$d"'
exit: 0
run: sh -c 'ulimit -s 8192 && exec "$TMPDIR/deepstack-out/bin/deepstack"'
exit: 0
out-equals: 80000200000

# 9v) 核数：`VUNA_NATIVE_CPUS=1` 把进程钉到一个可用核上（`Cpus_allowed_list` 单项）。
run: sh -c 'VUNA_NATIVE_CPUS=1 "$TMPDIR/sleepy-out/bin/sleepy" >/dev/null & p=$!; sleep 0.3; taskset -pc $p | sed "s/.*: //" | awk -F, "{print NF}"; wait'
out-equals: 1

# 9w) 限制相关 env 不传给 `runIn` / `spawn` 的子进程；`VUNA_NATIVE_INHERIT=1` 才继承。
#     子命令 `printenv KEY` 的存在与否直接反映为退出码（不依赖 shell 变量展开）。
run: sh -c 'd="$TMPDIR/envinh"; mkdir -p "$d/app"; printf "[package]\nname = \"envinh\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Effect.Core as Eff\nimport Base.Effect.Process as EffProcess\n\nmain : Eff [ProcessOp] Int\nmain = processRunIn \".\" [\"sh\", \"-c\", \"printenv VUNA_NATIVE_MEM_LIMIT >/dev/null\"]\n" > "$d/app/Main.vuna"; timeout 120 "$VUNA" build --target native --out "$TMPDIR/envinh-out" "$d"'
exit: 0
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=12345 "$TMPDIR/envinh-out/bin/envinh"'
out-equals: 1
run: sh -c 'VUNA_NATIVE_MEM_LIMIT=12345 VUNA_NATIVE_INHERIT=1 "$TMPDIR/envinh-out/bin/envinh"'
out-equals: 0

# 9x) 限制只在启动时读 env：设与不设生成的文件集逐字节一致。
run: sh -c 'timeout 120 "$VUNA" compile "$TMPDIR/memlim/app/Main.vuna" "$TMPDIR/detlim-a" --target native; VUNA_NATIVE_MEM_LIMIT=1 VUNA_NATIVE_CPUS=1 VUNA_NATIVE_STACK_MB=64 timeout 120 "$VUNA" compile "$TMPDIR/memlim/app/Main.vuna" "$TMPDIR/detlim-b" --target native; diff -r "$TMPDIR/detlim-a" "$TMPDIR/detlim-b"'
exit: 0

