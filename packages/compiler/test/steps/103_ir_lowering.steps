# 103) IR 降低：Core → IR → OCaml 是唯一 codegen 链路，Lowering 按节点结构递归、无固定预算。
#
# $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_deep 是深度夹具：150 层嵌套应用、
# 长约 300 的算子链与 let 链。精化入口的预算按表达式规模派生（`Rast.exprBudget`），
# 所以这些深度不会报 `IC_FuelExhausted`（项本身完全合法），产物也必须能真跑。
#
# IR 的结构边界（后端只消费 IR、IR 不 import 上游）由 `checks.ir-boundary`
# （`nix/checks/lib/ir-boundary.sh`）在 `nix flake check` 里守；本 steps 用例只钉产物行为。
run: "$VUNA" check $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_deep 2>&1
exit: 0
out-not-contains: IC_FuelExhausted

run: "$VUNA" compile $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_deep "$TMPDIR/dt-deep" 2>&1
exit: 0
file-exists: $TMPDIR/dt-deep/Main.ml
file-contains: $TMPDIR/dt-deep/Main.ml let v_deep =

# 产物必须真能跑：150 层 step + sum(0..299) + 最后一个 let 绑定。
run: cd "$TMPDIR/dt-deep" && sh build.sh prog 2>&1
exit: 0
run: "$TMPDIR/dt-deep/prog" 2>&1
exit: 0
out-equals: 45299
# 尾位置标记：`vuna dev ir dump --after machine` 是 `Ir.Tail` 之后的共享视图。
# native / wasm 的 TCO 都消费同一份标记；这里钉住标记的形状与负例。
run: sh -c 'd="$TMPDIR/irtail"; mkdir -p "$d/app"; printf "[package]\nname = \"irtail\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\nimport Base.Data.String as String\n\nloop : Nat -> Int\nloop n = case n of\n  Zero => 0\n  Succ k => loop k\n\nnontail : Nat -> Int\nnontail n = case n of\n  Zero => 0\n  Succ k => 1 + nontail k\n\napply : (Nat -> Int) -> Nat -> Int\napply f x = f x\n\nrtTail : Nat -> Int\nrtTail n = case n of\n  Zero => 0\n  Succ k => strLength (strFromInt k)\n\nmain : Int\nmain = loop (natFromInt 10) + nontail (natFromInt 10) + apply loop (natFromInt 10) + rtTail (natFromInt 10)\n" > "$d/app/Main.vuna"; "$VUNA" dev ir dump --after machine "$d" > "$TMPDIR/irtail.ir"'
exit: 0
run: sh -c 'grep "def loop/1" "$TMPDIR/irtail.ir" | grep -q "(tail (app"'
exit: 0
run: sh -c '! grep "def nontail/1" "$TMPDIR/irtail.ir" | grep -q "(tail (app .*g:nontail"'
exit: 0
run: sh -c 'grep "def apply/2" "$TMPDIR/irtail.ir" | grep -q "(tail (app"'
exit: 0
run: sh -c 'grep "def rtTail/1" "$TMPDIR/irtail.ir" | grep -q "(tail (rtapp strLength"'
exit: 0
run: sh -c '"$VUNA" dev ir dump --after machine "$TMPDIR/irtail" > "$TMPDIR/irtail2.ir"; cmp "$TMPDIR/irtail.ir" "$TMPDIR/irtail2.ir"'

# 机器链中间步骤：`ir.tail.annotate` 与 `machine` 是同一整链输出；中间步骤可见且更早。
run: sh -c '"$VUNA" dev ir dump --after ir.tail.annotate "$TMPDIR/irtail" > "$TMPDIR/irtail-pass.ir"; cmp "$TMPDIR/irtail.ir" "$TMPDIR/irtail-pass.ir"'
exit: 0
run: sh -c '"$VUNA" dev ir dump --after ir.machine.handlers "$TMPDIR/irtail" > "$TMPDIR/irtail-mid.ir"; test -s "$TMPDIR/irtail-mid.ir"; ! cmp -s "$TMPDIR/irtail.ir" "$TMPDIR/irtail-mid.ir"'
exit: 0
run: sh -c '"$VUNA" dev ir dump --after ir.no.such.pass "$TMPDIR/irtail" 2>&1 | grep -q "unknown pass"'
# Eff 的 CPS 形态：`Eff` 就是 thunk，`case e of MkEff f` 规范化成 `let f = e`。
# 三端 codegen 都吃这个形态；留着 `IrCase` 会让 native / wasm 对闭包做 tag 分派。
run: sh -c 'd="$TMPDIR/effcase"; mkdir -p "$d/app"; printf "[package]\nname = \"effcase\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "%s\n" "import Base.Effect.Core as Eff" "" "main : Eff [] Int" "main = do" "  x <- pure 1" "  pure (x + 1)" > "$d/app/Main.vuna"; "$VUNA" dev ir dump --after cps "$d" > "$TMPDIR/effcase.ir"'
exit: 0
run: sh -c '! grep -q "(case .*MkEff" "$TMPDIR/effcase.ir"'
exit: 0

# `--only`：整条机器链照常跑，只打印点名 pass；可重复，未知名字显式报错。
run: sh -c '"$VUNA" dev ir dump --only ir.cps "$TMPDIR/irtail" > "$TMPDIR/irtail-only.ir"; grep -q "^== ir.cps ==" "$TMPDIR/irtail-only.ir"; ! grep -q "^== ir.tail.annotate ==" "$TMPDIR/irtail-only.ir"'
exit: 0
run: sh -c '"$VUNA" dev ir dump --only ir.cps --only ir.tail.annotate "$TMPDIR/irtail" > "$TMPDIR/irtail-only2.ir"; grep -q "^== ir.cps ==" "$TMPDIR/irtail-only2.ir"; grep -q "^== ir.tail.annotate ==" "$TMPDIR/irtail-only2.ir"'
exit: 0
run: sh -c '"$VUNA" dev ir dump --only ir.no.such.pass "$TMPDIR/irtail" 2>&1 | grep -q "unknown pass"'
exit: 0
run: sh -c '"$VUNA" dev ir dump --after machine --only ir.cps "$TMPDIR/irtail" > /dev/null 2>&1; test $? -eq 2'
exit: 0
