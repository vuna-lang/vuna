-- `==` / `/=` / `<` 等就是 `Eq` / `Ord` 的方法名本身；
-- Int / String 走内建特化，Bool 走 Base.Trait.Eq / Base.Trait.Ord 的模式匹配实例，用户 data 走
-- deriving 生成的实例（中缀与 `(==)` 前缀写法必须得到同一结果）。
import Prelude

data Color : Type where
  Red : Color
  Blue : Color
deriving (Eq, Ord)

main : String
main =
  let
    a = 1 == 1
    b = (==) 1 1
    c = "x" == "x"
    d = (==) "x" "y"
    e = Red == Red
    f = Red == Blue
    g = True == False
    h = 1 < 2
    i = (<) 1 2
    j = False < True
    k = mem 1 [1, 2]
  in show a
    ++ show b
    ++ show c
    ++ show d
    ++ show e
    ++ show f
    ++ show g
    ++ show h
    ++ show i
    ++ show j
    ++ show k
