-- 参数化 op 族（Reader 的 k = 1）；结果行删除 Reader 条目。
import Base.Effect.Core as Eff
import Base.Effect.Reader as EffReader

askEnv : Eff [ReaderOp String@env] String
askEnv = perform Ask

run : {r : Row} -> Eff (Named "env" (ReaderOp String) :: r) String -> Eff r String
run comp = handle comp {
  Ask k -> k "hello"
}

main : String
main = runPure (run askEnv)
