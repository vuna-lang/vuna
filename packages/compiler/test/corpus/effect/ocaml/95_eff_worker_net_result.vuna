-- worker 里跑默认 Net 行的闭合 runner：listen/port/close 收成 Ok，失效句柄收成 Err。
-- 单线程执行（ocaml 的句柄表不是线程安全的）。
import Base.Data.Bool
import Base.Data.Pair
import Base.Data.Result
import Base.Effect.Console as EffConsole
import Base.Effect.Core
import Base.Effect.Exit as EffExit
import Base.Effect.Net as EffNet
import Base.Trait.Monad
import Base.Thread as Thread

listenPort : Eff [NetOp] Int
listenPort =
  do
    h <- netListen "tcp:127.0.0.1:0"
    p <- netPort h
    _ <- netClose h
    pure p

worker : Eff [] (Pair (Result Int) (Result Int))
worker =
  do
    good <- runNetResult listenPort
    bad <- runNetResult (netPort 99999)
    pure (Pair good bad)

main : Eff [ConsoleOp, ExitOp] Int
main =
  do
    t <- Thread.spawn worker
    res <- Thread.join t
    case res of
      Pair good bad =>
        do
          let
            okGood =
              case good of
                Ok p => p > 0
                Err _ => False
            okBad =
              case bad of
                Err _ => True
                Ok _ => False
          if okGood && okBad then
            do
              _ <- consolePrint "ok\n"
              pure 0
          else
            do
              _ <- consolePrint "bad\n"
              _ <- exitWith 1
              pure 1
