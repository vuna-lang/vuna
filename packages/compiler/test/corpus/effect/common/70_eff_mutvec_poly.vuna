-- MutVec：多态 helper 的句柄载荷取自行条目的第二个实参（`MutVecOp n a`）。
import Base.Effect.MutVec as MutVec
import Base.Effect.Core as Eff
import Base.Data.Vec
import Base.Data.Nat
import Base.Data.Fin

writeAt : {a : Type} -> {n : Nat} -> {r : Row} -> Fin n -> a -> Eff (Named "xs" (MutVecOp n a) :: r) Unit
writeAt i v = MutVec.set@xs i v

readAt : {a : Type} -> {n : Nat} -> {r : Row} -> Fin n -> Eff (Named "xs" (MutVecOp n a) :: r) a
readAt i = MutVec.get@xs i

main : Int
main =
  MutVec.withMutVecPure "xs" (VCons 1 (VCons 2 Nil)) (
      do
        writeAt FZero 40
        writeAt (FSucc FZero) 2
        readAt FZero
    )