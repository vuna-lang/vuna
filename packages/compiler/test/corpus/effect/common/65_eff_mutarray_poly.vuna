-- MutArray：多态 helper 的句柄类型带元素类型 `a`，读写仍要求 `MutOp`。
import Base.Effect.Core as Eff
import Base.Effect.Mut
import Base.Container.MutArray as MutArray
import Base.Trait.Monad

writeFirst : {a : Type} -> {r : Row} -> {w : Member MutOp r} -> MutArray a -> a -> Eff r Unit
writeFirst dst v = MutArray.set dst 0 v

readFirst : {a : Type} -> {r : Row} -> {w : Member MutOp r} -> MutArray a -> Eff r a
readFirst dst = MutArray.get dst 0

main : Int
main =
  MutArray.withMutArrayPure 2 0 (\dst =>
      do
        writeFirst dst 42
        readFirst dst
  )