-- `firstSuccess` 命中即停：命中之后的候选动作只构造、不执行；
-- 全部失败时才会逐个执行。用 MutRef 单元记录「候选是否跑过」。
import Prelude
import Base.Effect.Core as Eff
import Base.Effect.Types
import Base.Effect.MutRef as MutRef
import Base.Trait.Monad

afterHit : {r : Row} -> {w : Member (Named "hit" (MutRefOp Int)) r} -> Eff r (Maybe Int)
afterHit =
  do
    MutRef.write@hit 1
    pure (Just 8)

failAfter : {r : Row} -> {w : Member (Named "miss" (MutRefOp Int)) r} -> Eff r (Maybe Int)
failAfter =
  do
    MutRef.write@miss 1
    pure Nothing

main : Int
main =
  runPure (
      MutRef.withMutRef "hit" 0 (
          MutRef.withMutRef "miss" 0 (
              do
                hit <- firstSuccess [pure Nothing, pure (Just 7), afterHit]
                hitRan <- MutRef.read@hit
                miss <- firstSuccess [pure Nothing, failAfter]
                missRan <- MutRef.read@miss
                pure (
                    (
                      (
                        (
                          (
                            case hit of
                              Just n => n
                              Nothing => 0
                          ) * 1000
                        ) + hitRan * 100
                      ) + (if isNothing miss then 10 else 0)
                    ) + missRan
                  )
            )
        )
    )
