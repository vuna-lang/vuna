-- `firstSuccess` 命中即停：命中之后的候选动作只构造、不执行；
-- 全部失败时才会逐个执行。用值句柄记录「候选是否跑过」。
import Prelude
import Base.Effect.Core as Eff
import Base.Effect.Mut
import Base.Container.MutRef as MutRef
import Base.Trait.Monad

afterHit : {r : Row} -> {w : Member MutOp r} -> MutRef Int -> Eff r (Maybe Int)
afterHit hit =
  do
    MutRef.write hit 1
    pure (Just 8)

failAfter : {r : Row} -> {w : Member MutOp r} -> MutRef Int -> Eff r (Maybe Int)
failAfter miss =
  do
    MutRef.write miss 1
    pure Nothing

main : Int
main =
  runPure (
      MutRef.withMutRef 0 (\hit =>
          MutRef.withMutRef 0 (\missCell =>
              do
                found <- firstSuccess [pure Nothing, pure (Just 7), afterHit hit]
                hitRan <- MutRef.read hit
                missRes <- firstSuccess [pure Nothing, failAfter missCell]
                missRan <- MutRef.read missCell
                pure (
                    (
                      (
                        (
                          (
                            case found of
                              Just n => n
                              Nothing => 0
                          ) * 1000
                        ) + hitRan * 100
                      ) + (if isNothing missRes then 10 else 0)
                    ) + missRan
                  )
            )
        )
    )