-- MutDynArray：push 原地追加（容量按倍数增长）、get/set/size/clear。
import Base.Effect.Core as Eff
import Base.Effect.Mut
import Base.Container.MutDynArray as MutDynArray
import Base.Data.Nat
import Base.Trait.Monad

main : Int
main =
  MutDynArray.withMutDynArrayPure (\xs =>
      do
        MutDynArray.push xs 1
        MutDynArray.push xs 2
        MutDynArray.push xs 3
        MutDynArray.push xs 4
        MutDynArray.push xs 5
        MutDynArray.push xs 6
        MutDynArray.push xs 7
        MutDynArray.push xs 8
        MutDynArray.push xs 9
        MutDynArray.push xs 10
        MutDynArray.push xs 11
        MutDynArray.push xs 12
        MutDynArray.push xs 13
        MutDynArray.push xs 14
        MutDynArray.push xs 15
        MutDynArray.push xs 16
        MutDynArray.push xs 17
        MutDynArray.push xs 18
        MutDynArray.push xs 19
        MutDynArray.push xs 20
        n <- MutDynArray.size xs
        a <- MutDynArray.get xs 0
        b <- MutDynArray.get xs 19
        MutDynArray.set xs 0 100
        c <- MutDynArray.get xs 0
        MutDynArray.clear xs
        m <- MutDynArray.size xs
        pure (c * 1000 + a * 100 + b + natToInt (n + m) * 10000)
  )