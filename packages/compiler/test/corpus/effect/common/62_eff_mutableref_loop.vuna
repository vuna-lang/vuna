-- MutableRef：循环里原地累加，每次 write 改的是同一块存储。
import Base.Effect.MutableRef as MutableRef
import Base.Effect.Types
import Base.Data.Nat as Nat

loop : Nat -> Eff [Named "sum" (MutableRefOp Int)] Int
loop n =
  case n of
    Zero => pure 0
    Succ m =>
      do
        s <- MutableRef.read
        MutableRef.write (s + 1)
        loop m

main : Int
main =
  MutableRef.withMutableRefPure "sum" 0 (
      do
        _ <- loop (natFromInt 1000)
        MutableRef.read
    )
