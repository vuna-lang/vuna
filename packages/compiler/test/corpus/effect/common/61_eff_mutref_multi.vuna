-- MutRef：两个单元是普通值；跨函数传句柄，读写要求 `MutOp` 标记。
import Base.Effect.Core as Eff
import Base.Effect.Mut
import Base.Container.MutRef as MutRef
import Base.Trait.Monad

bumpRight : {r : Row} -> {w : Member MutOp r} -> MutRef Int -> Int -> Eff r Int
bumpRight right k =
  do
    v <- MutRef.read right
    MutRef.write right (v + k)
    MutRef.read right

main : Int
main =
  MutRef.withMutRefPure 1 (\left =>
      MutRef.withMutRef 2 (\right =>
          do
            _ <- bumpRight right 10
            l <- MutRef.read left
            r <- MutRef.read right
            pure (l * 100 + r)
        )
  )