-- MutVec：类型层定长的原地向量；Fin 下标，越界在编译期不可能。
import Base.Effect.Core as Eff
import Base.Effect.Mut
import Base.Container.MutVec as MutVec
import Base.Data.Vec
import Base.Data.Fin
import Base.Data.Nat
import Base.Trait.Monad

main : Int
main =
  MutVec.withMutVecPure (VCons 10 (VCons 20 (VCons 30 Nil))) (\xs =>
      do
        MutVec.set xs FZero 7
        MutVec.set xs (FSucc FZero) 9
        a <- MutVec.get xs FZero
        b <- MutVec.get xs (FSucc FZero)
        c <- MutVec.get xs (FSucc (FSucc FZero))
        n <- MutVec.size xs
        pure (a * 1000 + b * 100 + c * 10 + natToInt n)
  )