-- 延迟 answer 的库 handler：`handleState` 的 `ret` / `opH` 返回「等待 state 的函数」，
-- resume 发生在 `MkHandle` 返回之后（三端共享期望）。
import Base.Effect.Core as Eff
import Base.Effect.State as EffState
import Base.Data.Pair as Pair

prog : Eff [StateOp Int@n] Int
prog = do
  x <- get "n" Int
  _ <- put "n" Int (x + 1)
  get "n" Int

ret : Int -> Int -> Pair Int Int
ret a s = Pair a s

opH : (i : Type) -> (o : StateOp Int i) -> (Eff.resIdx i o -> Int -> Pair Int Int) -> Int -> Pair Int Int
opH i op k s = case op of
  Get => k s s
  Put x => k 0 x

main : Eff [] Int
main = pure (case runPure (handleState "n" Int ret opH prog) 41 of
  Pair a s => a + s
)