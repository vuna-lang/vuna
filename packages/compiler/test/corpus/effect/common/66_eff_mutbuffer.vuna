-- MutBuffer：追加 / 追加字节 / 长度 / 取快照 / 清空。
import Base.Effect.Core as Eff
import Base.Effect.Mut
import Base.Container.MutBuffer as MutBuffer
import Base.Data.String
import Base.Trait.Monad

main : Int
main =
  MutBuffer.withMutBufferPure (\out =>
      do
        MutBuffer.append out "abc"
        MutBuffer.appendChar out 100
        n1 <- MutBuffer.size out
        s1 <- MutBuffer.toString out
        MutBuffer.clear out
        n2 <- MutBuffer.size out
        s2 <- MutBuffer.toString out
        MutBuffer.append out s1
        n3 <- MutBuffer.size out
        pure (n1 * 10000 + n2 * 1000 + n3 * 100 + strLength s2 + strAt s1 3)
  )