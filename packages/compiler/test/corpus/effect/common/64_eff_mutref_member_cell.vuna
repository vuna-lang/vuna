-- 约束驱动的单元：行多态 helper 通过 Member 约束拿到单元（跨函数），不必把行写成具体条目。
import Base.Effect.Core
import Base.Effect.Types
import Base.Effect.MutRef as MutRef
import Base.Trait.Monad
import Base.Trait.Num

bump : {r : Row} -> {w : Member (Named "n" (MutRefOp Int)) r} -> Int -> Eff r Int
bump k =
  do
    v <- MutRef.read@n
    MutRef.write@n (v + k)
    MutRef.read@n

main : Int
main = MutRef.withMutRefPure "n" 40 (bump 2)
