-- MutVec：两个向量用 `@name` 消歧；跨函数经行条目传隐藏句柄（长度索引入行条目）。
import Base.Effect.MutVec as MutVec
import Base.Effect.Core as Eff
import Base.Data.Vec
import Base.Data.Fin
import Base.Data.Nat

bump : {n : Nat} -> {r : Row} -> Fin n -> Eff (Named "acc" (MutVecOp n Int) :: r) Int
bump i =
  do
    v <- MutVec.get@acc i
    MutVec.set@acc i (v + 1)
    MutVec.get@acc i

main : Int
main =
  MutVec.withMutVecPure "other" (VCons 5 (VCons 6 Nil)) (
      MutVec.withMutVec "acc" (VCons 0 (VCons 0 Nil)) (
          do
            _ <- bump FZero
            b <- bump (FSucc FZero)
            o <- MutVec.get@other (FSucc FZero)
            n <- MutVec.size@acc
            pure (b * 100 + o * 10 + natToInt n)
        )
    )