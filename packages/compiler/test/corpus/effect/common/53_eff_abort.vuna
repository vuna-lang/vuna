-- 效应基准：每轮 bracket 的 use 都 abort，release（cleanup）恰好执行一次。
-- 计数器用 MutRef 单元（作用域在整轮循环外，cleanup 写它）。
import Base.Effect.Core as Eff
import Base.Effect.Types
import Base.Effect.Exn as EffExn
import Base.Effect.MutRef as MutRef
import Base.Data.Nat as Nat
import Base.Trait.Monad
import Base.Trait.Num

bump : {r : Row} -> {w : Member (Named "n" (MutRefOp Int)) r} -> Int -> Eff r Int
bump k =
  do
    v <- MutRef.read@n
    MutRef.write@n (v + 1)
    pure k

abortOnce : {r : Row} -> {w : Member (Named "n" (MutRefOp Int)) r} -> Int -> Eff r Int
abortOnce k =
  do
    _ <-
      runExn "boom" (
          bracket (pure 0) (\_ => bump 0) (
              \_ =>
                do
                  _ <- throwExn "boom" "x"
                  pure k
            )
        )
    pure k

loop : Nat -> Eff [Named "n" (MutRefOp Int)] Int
loop n =
  case n of
    Zero => pure 0
    Succ m =>
      do
        _ <- abortOnce m
        loop m

main : Int
main =
  MutRef.withMutRefPure "n" 0 (
      do
        _ <- loop (natFromInt 2000)
        MutRef.read
    )
