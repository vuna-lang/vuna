-- MutableRef：两个同类型单元用 `@name` 消歧；跨函数经行条目传递。
import Base.Effect.MutableRef as MutableRef
import Base.Effect.Core as Eff

bumpRight : {r : Row} -> Int -> Eff (Named "right" (MutableRefOp Int) :: r) Int
bumpRight k =
  do
    v <- MutableRef.read@right
    MutableRef.write@right (v + k)
    MutableRef.read@right

main : Int
main =
  MutableRef.withMutableRefPure "left" 1 (
      MutableRef.withMutableRef "right" 2 (
          do
            _ <- bumpRight 10
            l <- MutableRef.read@left
            r <- MutableRef.read@right
            pure (l * 100 + r)
        )
    )
