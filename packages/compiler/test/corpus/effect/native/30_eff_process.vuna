-- process 效应标签（命名实例）——mock handler 给固定 args/退出码；
-- real 路径走入口自动预装的行 handler（含 argv 与 runIn 的退出码 0）。
import Base.Effect.Core as Eff
import Base.Effect.Process as EffProcess
import Base.Effect.Console as EffConsole
import Base.Data.List as List

prog : (n : String) -> Eff (Named n ProcessOp :: []) String
prog n =
  do
    args <- processArgs@(n)
    code <- processRunIn@(n) "." ["true"]
    pure (join "," args ++ "|" ++ strFromInt code)

progReal : Eff [ConsoleOp, ProcessOp] String
progReal =
  do
    args <- processArgs
    code <- processRunIn "." ["true"]
    pure (join "," args ++ "|" ++ strFromInt code)

mret : String -> String
mret a = a

mopH : (i : Type) -> (o : ProcessOp i) -> (Eff.resIdx i o -> String) -> String
mopH i op k =
  case op of
    Args => k ("a" :: "b" :: [])
    Exit c => k c
    RunIn dir args => k 3
    Spawn args => k 9
    Wait h => k 0

main : Eff [ConsoleOp, ProcessOp] Int
main =
  case runPure (handleProcess "mock" mret mopH (prog "mock")) of
    mockLog =>
      do
        _ <- consolePrint ("mock " ++ mockLog ++ "\n")
        realLog <- progReal
        _ <- consolePrint ("real " ++ realLog ++ "\n")
        pure 0
