-- 建树不靠缩进猜测：区间由 parser 的递归栈发出（`NodeEvent`），组装只做一遍线性遍历。
-- 这里用合成事件流验证机制本身：嵌套层数不受硬上限约束，叶序列逐 token 对齐。
import Prelude
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Cst

tokenAtLine : Int -> CstToken
tokenAtLine i = CstToken "ident" "x" (Span "" i i i i i i) []

-- 结构递归：每行一个 token，列号递增（每层 block 一个 token）。
deepTokens : Int -> Int -> List CstToken
deepTokens i n = if n <= 0 then [] else tokenAtLine i :: deepTokens (i + 1) (n - 1)

-- 每行开一层 block，最后一层在最后一行关闭：深度 = 4100。
deepEvents : Int -> Int -> List NodeEvent
deepEvents i n = if n <= 0 then [] else EvOpen CstDeclKind (i - 1) :: deepEvents (i + 1) (n - 1)

closingEvents : Int -> List NodeEvent
closingEvents n = if n <= 0 then [] else EvClose 4100 :: closingEvents (n - 1)

events : List NodeEvent
events = append (deepEvents 1 4100) (closingEvents 4100)

main : Int
main =
  let
    toks = deepTokens 1 4100
    tree = nestToTree toks events
  in if renderCstTree tree == renderCst toks then 1 else 0
