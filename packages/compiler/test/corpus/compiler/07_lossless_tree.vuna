-- parser 发射的无损树：叶序列 == token 序列、逐字节还原、嵌套区间互不交叉。
--
-- 这是 D18「parser 发射无损树」的第一条等价证据：树的区间来自 parser 的递归点
-- （`NodeEvent`），而不是从缩进或括号反推；AST 与 canonical 编码在这一步不变。
import Prelude
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Parser

sample : String
sample =
  "-- 模块头 + import + 各类声明\n"
    ++ "module M (f, T(..)) where\n"
    ++ "\n"
    ++ "import Base.Data.List as List\n"
    ++ "import Base.Data.Pair\n"
    ++ "export import Base.Data.Pair (fst)\n"
    ++ "\n"
    ++ "infixl 6 <+>\n"
    ++ "\n"
    ++ "-- data 与构造子\n"
    ++ "data T : Type where\n"
    ++ "  MkT : Int -> T\n"
    ++ "  MkU : T\n"
    ++ "\n"
    ++ "record P where\n"
    ++ "  x : Int\n"
    ++ "  y : Int\n"
    ++ "\n"
    ++ "-- trait 与方法签名\n"
    ++ "trait Show a where\n"
    ++ "  show : a -> String\n"
    ++ "\n"
    ++ "f : Int -> Int\n"
    ++ "f n = n + 1\n"
    ++ "\n"
    ++ "g : Int\n"
    ++ "g =\n"
    ++ "  let\n"
    ++ "    h : Int\n"
    ++ "    h = 2\n"
    ++ "  in case f h of\n"
    ++ "       0 => 0\n"
    ++ "       _ => if h > 1 then 3 else 4\n"
    ++ "\n"
    ++ "-- 局部函数子句（每个 clause 记自己的 binding 节点）\n"
    ++ "j : Int -> Int\n"
    ++ "j x =\n"
    ++ "  let\n"
    ++ "    k : Int -> Int\n"
    ++ "    k 0 = 1\n"
    ++ "    k n = n + 1\n"
    ++ "  in k x\n"
    ++ "\n"
    ++ "-- do 块里的语句（供 `doStmt` 节点）\n"
    ++ "k : Int\n"
    ++ "k =\n"
    ++ "  do\n"
    ++ "    x <- pure 1\n"
    ++ "    let y = x + 1\n"
    ++ "    pure y\n"
    ++ "\n"
    ++ "-- 修饰符前缀属于声明自己的区间（与建树节点同一区间）\n"
    ++ "export hidden : Int\n"
    ++ "hidden = 7\n"
    ++ "export opaque sealed : Int\n"
    ++ "sealed = 8\n"
    ++ "opaque blind : Int\n"
    ++ "blind = 9\n"
    ++ "export data E : Type where\n"
    ++ "  MkE : E\n"
    ++ "\n"
    ++ "-- instance 体的方法也是 decl 节点（自己的 id）\n"
    ++ "instance Show Int where\n" ++ "  show n = show n\n"

-- | 相邻兄弟按源码顺序：前一个的终点不晚于后一个的起点。
orderedKids : List CstNode -> Bool
orderedKids [] = True
orderedKids (a :: rest) = orderedKidsFrom (nodeSpan a) rest

-- | `orderedKids` 的续段：逐个比对相邻兄弟（结构递归）。
orderedKidsFrom : Span -> List CstNode -> Bool
orderedKidsFrom prev [] = True
orderedKidsFrom prev (b :: rest) =
  spanEndOffset prev <= spanStartOffset (nodeSpan b) && orderedKidsFrom (nodeSpan b) rest

-- | children 全部落在分支的字节区间内。
kidsInside : Span -> List CstNode -> Bool
kidsInside sp [] = True
kidsInside sp (k :: rest) =
  spanStartOffset (nodeSpan k)
    >= spanStartOffset sp && spanEndOffset (nodeSpan k) <= spanEndOffset sp && kidsInside sp rest

-- | 递归：每个分支的 children 有序、都在自己的区间里，且自身也被父层检查过。
nestedOk : CstNode -> Bool
nestedOk (CstLeaf _) = True
nestedOk (CstBranch _ _ sp kids) =
  orderedKids kids && kidsInside sp kids && List.length kids > 0 && nestedAll kids

nestedAll : List CstNode -> Bool
nestedAll [] = True
nestedAll (k :: rest) = nestedOk k && nestedAll rest

-- | 树上出现过的节点种类（前序）。fuel 界是树高（结构递归经 `concatMap` 时 SCT
-- 看不到下降，显式给界）。
kindTagsAt : Int -> CstNode -> List String
kindTagsAt fuel n =
  if fuel <= 0 then
    []
  else
    case n of
      CstLeaf _ => []
      CstBranch _ _ _ kids => nodeKindTag n :: concatMap (kindTagsAt (fuel - 1)) kids

-- | 每层至少 1 个 token，所以 token 数是树高的安全上界。
kindTags : List CstToken -> CstNode -> List String
kindTags toks tree = kindTagsAt (List.length toks) tree

-- | 顶层指定 kind 的节点（源码顺序）。
nodesOfKind : String -> List CstNode -> List CstNode
nodesOfKind tag [] = []
nodesOfKind tag (n :: rest) =
  if nodeKindTag n == tag then n :: nodesOfKind tag rest else nodesOfKind tag rest

-- | 两段 span 的顺序与字节区间完全一致（同一构造只能有一个区间来源）。
sameSpan : Span -> Span -> Bool
sameSpan a b =
  spanStartLine a
    == spanStartLine b
    && spanStartCol a
    == spanStartCol b
    && spanStartOffset a
    == spanStartOffset b
    && spanEndLine a
    == spanEndLine b && spanEndCol a == spanEndCol b && spanEndOffset a == spanEndOffset b

-- | 两段 span 起点一致（重导出把成员列表放在 `importSpan` 之外，终点可以不同）。
sameStart : Span -> Span -> Bool
sameStart a b =
  spanStartLine a
    == spanStartLine b && spanStartCol a == spanStartCol b && spanStartOffset a == spanStartOffset b

-- | 树里的顶层声明节点与 AST 的声明一一对应：同样多、同样顺序、同一区间。
-- 这是迁移期的漂移锁：树多建 / 少建 / 起点或终点挪位都会在这里炸。
declsAlign : List CstNode -> List Decl -> Bool
declsAlign [] [] = True
declsAlign [] (_ :: _) = False
declsAlign (_ :: _) [] = False
declsAlign (n :: nodes) (d :: decls) =
  nodeId n
    == Just (nodeRefId (declRef d))
    && sameSpan (nodeSpan n) (nodeRefSpan (declRef d)) && declsAlign nodes decls

-- | 一个 `NodeRef` 在树索引里指回 kind 与区间都一致的节点。
refOk : HashMap Int CstNode -> String -> NodeRef -> Bool
refOk index tag r =
  case HashMap.lookup (nodeRefId r) index of
    Nothing => False
    Just n => nodeKindTag n == tag && sameSpan (nodeSpan n) (nodeRefSpan r)

refsOk : HashMap Int CstNode -> String -> List NodeRef -> Bool
refsOk index tag [] = True
refsOk index tag (r :: rest) = refOk index tag r && refsOk index tag rest

ctorRefOf : Ctor -> NodeRef
ctorRefOf c = c.ctorRef

fieldRefOf : Field -> NodeRef
fieldRefOf f = f.fieldRef

traitMethodRefOf : TraitMethod -> NodeRef
traitMethodRefOf m = m.traitMethodRef

fixityRefOf : FixityDecl -> NodeRef
fixityRefOf d = d.fixityRef

-- | 成员（构造子 / 字段 / trait 方法）的 id 在树里各自指回同 kind 的节点。
declMembersOk : HashMap Int CstNode -> Decl -> Bool
declMembersOk index (DData _ _ _ ctors _ _ _ _ _) = refsOk index "ctor" (map ctorRefOf ctors)
declMembersOk index (DRecord _ _ fields _ _ _ _ _) = refsOk index "field" (map fieldRefOf fields)
declMembersOk index (DTrait _ _ _ methods _) = refsOk index "method" (map traitMethodRefOf methods)
declMembersOk index _ = True

declsMembersOk : HashMap Int CstNode -> List Decl -> Bool
declsMembersOk index [] = True
declsMembersOk index (d :: rest) = declMembersOk index d && declsMembersOk index rest

-- | fixity 声明 id 指回 fixity 节点。
fixitiesOk : HashMap Int CstNode -> List FixityDecl -> Bool
fixitiesOk index fx = refsOk index "fixity" (map fixityRefOf fx)

-- ---------------------------------------------------------------
-- 表达式 / 模式的身份：parseExpr / parsePatternSingle 的区间出口各建一个节点，
-- 只有这些「区间根」带 id（更内层的构造子是同一区间的多个视图，没有独立节点）。
-- where/let 签名行投影的是 `Binding.bindSig.sigRef` 的 `binding` 节点，不是 `expr` 节点。
-- ---------------------------------------------------------------
-- | AST 节点 → 它投影的树节点：(期望 kind 标签, 统计角色, 引用)。
-- 角色 `expr` 只要求「终点相同 + 区间落在节点内」；`sig`（签名行）与 `clause`（局部函数
-- 子句）都投影 `binding` 节点，要求区间完全相同。
record Site where
  siteTag : String
  siteRole : String
  siteRef : NodeRef

siteTagOf : Site -> String
siteTagOf sg = sg.siteTag

siteRoleOf : Site -> String
siteRoleOf sg = sg.siteRole

siteRefOf : Site -> NodeRef
siteRefOf sg = sg.siteRef

-- | 一个表达式树上所有带身份的区间根（含自身）。
exprSitesAt : Int -> Expr -> List Site
exprSitesAt fuel e =
  if fuel <= 0 then
    []
  else
    let
      rest =
        case e of
          EVar n r => []
          EInt n r => []
          EStr s r => []
          EFloat raw r => []
          EInterp multi parts r => concatMap (interpSites (fuel - 1)) parts
          ELam ps body r => exprSitesAt (fuel - 1) body
          EApp fn args r => append (exprSitesAt (fuel - 1) fn) (concatMap (exprSitesAt (fuel - 1)) args)
          EPi n i q dom cod r => append (exprSitesAt (fuel - 1) dom) (exprSitesAt (fuel - 1) cod)
          ELet binds body rec_ r => append (concatMap (bindingSites (fuel - 1)) binds) (exprSitesAt (fuel - 1) body)
          ECase scrut alts r => append (exprSitesAt (fuel - 1) scrut) (concatMap (altSites (fuel - 1)) alts)
          EIf c t el r => append (exprSitesAt (fuel - 1) c) (append (exprSitesAt (fuel - 1) t) (exprSitesAt (fuel - 1) el))
          EField base f r => exprSitesAt (fuel - 1) base
          ERecord name fields r => concatMap (fieldValueSites (fuel - 1)) fields
          ERecUpdate base fields r => append (exprSitesAt (fuel - 1) base) (concatMap (fieldValueSites (fuel - 1)) fields)
          EDo stmts r => concatMap (stmtSites (fuel - 1)) stmts
    in Site "expr" "expr" (exprRef e) :: rest

interpSites : Int -> InterpPart -> List Site
interpSites fuel part =
  if fuel <= 0 then
    []
  else
    case part of
      IPText s => []
      IPHole e => exprSitesAt (fuel - 1) e

-- 一条绑定：签名行（`bindSig`）+ 定义行。局部函数组的绑定节点由首条子句自带，
-- 不重复收（与注释锚点同一口径）。
bindingSites : Int -> Binding -> List Site
bindingSites fuel b =
  if fuel <= 0 then
    []
  else
    append (bindingSigSites (fuel - 1) b.bindSig) (bindingDefSites (fuel - 1) b)

bindingSigSites : Int -> Maybe BindingSig -> List Site
bindingSigSites fuel sig =
  if fuel <= 0 then
    []
  else
    case sig of
      Nothing => []
      Just s => Site "binding" "sig" s.sigRef :: exprSitesAt (fuel - 1) s.sigType

bindingDefSites : Int -> Binding -> List Site
bindingDefSites fuel b =
  if fuel <= 0 then
    []
  else
    case b.bindValue of
      BClauses clauses => concatMap (localClauseSites (fuel - 1)) clauses
      BVal value => Site "binding" "def" b.bindRef :: exprSitesAt (fuel - 1) value

localClauseSites : Int -> LocalClause -> List Site
localClauseSites fuel clause =
  if fuel <= 0 then
    []
  else
    Site "binding" "clause" clause.lcRef :: exprSitesAt (fuel - 1) clause.lcBody

altSites : Int -> Alt -> List Site
altSites fuel alt =
  if fuel <= 0 then [] else Site "alt" "alt" alt.altRef :: exprSitesAt (fuel - 1) alt.altBody

fieldValueSites : Int -> Pair String Expr -> List Site
fieldValueSites fuel (Pair fname value) = if fuel <= 0 then [] else exprSitesAt (fuel - 1) value

stmtSites : Int -> DoStmt -> List Site
stmtSites fuel stmt =
  if fuel <= 0 then
    []
  else
    case stmt of
      DBind pat value r => exprSitesAt (fuel - 1) value
      DExpr value r => exprSitesAt (fuel - 1) value
      DLet binds r => concatMap (bindingSites (fuel - 1)) binds

declExprSites : Int -> Decl -> List Site
declExprSites fuel d =
  if fuel <= 0 then
    []
  else
    case d of
      DData _ _ kind ctors _ _ _ _ _ => append (exprSitesAt (fuel - 1) kind) (concatMap (ctorTypeSites (fuel - 1)) ctors)
      DAxiom _ ty _ => exprSitesAt (fuel - 1) ty
      DExtern _ _ ty _ => exprSitesAt (fuel - 1) ty
      DSig _ ctx ty _ => append (concatMap (exprSitesAt (fuel - 1)) ctx) (exprSitesAt (fuel - 1) ty)
      DFun _ pats body _ => exprSitesAt (fuel - 1) body
      DRecord _ _ fields _ _ _ _ _ => concatMap (fieldTypeSites (fuel - 1)) fields
      DTrait _ params supers methods _ => append (concatMap (traitParamSites (fuel - 1)) params) (append (concatMap (exprSitesAt (fuel - 1)) supers) (concatMap (methodTypeSites (fuel - 1)) methods))
      DInstance ctx head methods _ => append (concatMap (exprSitesAt (fuel - 1)) ctx) (append (exprSitesAt (fuel - 1) head) (concatMap (declExprSites (fuel - 1)) methods))

ctorTypeSites : Int -> Ctor -> List Site
ctorTypeSites fuel (Ctor _ ty _ r) = if fuel <= 0 then [] else exprSitesAt (fuel - 1) ty

fieldTypeSites : Int -> Field -> List Site
fieldTypeSites fuel f = if fuel <= 0 then [] else exprSitesAt (fuel - 1) (fieldType f)

methodTypeSites : Int -> TraitMethod -> List Site
methodTypeSites fuel m = if fuel <= 0 then [] else exprSitesAt (fuel - 1) (methodTy m)

methodTy : TraitMethod -> Expr
methodTy m = m.traitMethodType

traitParamSites : Int -> TraitParam -> List Site
traitParamSites fuel param =
  if fuel <= 0 then
    []
  else
    case param.traitParamKind of
      Nothing => []
      Just k => exprSitesAt (fuel - 1) k

allExprSites : List Decl -> List Site
allExprSites decls = concatMap (declExprSites 64) decls

siteRefsOfRole : String -> List Site -> List NodeRef
siteRefsOfRole role sites = map siteRefOf (filter (\sg => siteRoleOf sg == role) sites)

-- | 表达式区间根：id 指回 `expr` 节点，**终点相同、AST 区间落在节点区间内**
-- （中缀链步的 span 从运算符起，比树节点窄）。签名行要求 kind 与区间都精确相同。
siteOk : HashMap Int CstNode -> Site -> Bool
siteOk index site =
  case HashMap.lookup (nodeRefId (siteRefOf site)) index of
    Nothing => False
    -- 表达式区间根：AST 构造子的 span 可以比树节点窄（中缀链步从运算符起）；
    -- 条目节点（绑定 / 分支 / 子句 / 签名行）要求区间完全相同。
    Just n =>
      nodeKindTag n
        == siteTagOf site
        && spanEndOffset (nodeSpan n)
        == spanEndOffset (nodeRefSpan (siteRefOf site))
        && (
          if siteRoleOf site == "expr" then
            spanStartOffset (nodeSpan n) <= spanStartOffset (nodeRefSpan (siteRefOf site))
          else
            spanStartOffset (nodeSpan n) == spanStartOffset (nodeRefSpan (siteRefOf site))
        ) && spanEndOffset (nodeRefSpan (siteRefOf site)) <= spanEndOffset (nodeSpan n)

sitesOk : HashMap Int CstNode -> List Site -> Bool
sitesOk index [] = True
sitesOk index (site :: rest) =
  (if nodeRefId (siteRefOf site) < 0 then True else siteOk index site) && sitesOk index rest

-- | 带身份的引用条数与树上该 kind 的节点数相等（区间根一一对应，不多不少）。
countTagged : String -> List CstNode -> Int
countTagged tag nodes = List.length (nodesOfKindDeep tag nodes)

nodesOfKindDeep : String -> List CstNode -> List CstNode
nodesOfKindDeep tag [] = []
nodesOfKindDeep tag (n :: rest) =
  append (if nodeKindTag n == tag then [n] else []) (
      case n of
        CstLeaf _ => nodesOfKindDeep tag rest
        CstBranch _ _ _ kids => append (nodesOfKindDeep tag kids) (nodesOfKindDeep tag rest)
    )

countIdentified : List NodeRef -> Int
countIdentified refs = List.length (filter (\r => nodeRefId r >= 0) refs)

-- | 签名行的 `binding` 节点没有 `pat` 子节点（定义行的 binding 有）。
isEmpty : List a -> Bool
isEmpty [] = True
isEmpty (_ :: _) = False

countSigBindings : List CstNode -> Int
countSigBindings nodes =
  List.length
    (filter (\n => nodeKindTag n == "binding" && isEmpty (nodesOfKind "pat" (nodeChildren n))) (nodesOfKindDeep "binding" nodes))

exprIdsOk : HashMap Int CstNode -> CstNode -> List Decl -> Bool
exprIdsOk index tree decls =
  let
    sites = allExprSites decls
    exprRefs = siteRefsOfRole "expr" sites
    sigRefs = siteRefsOfRole "sig" sites
    bindingRefs =
      append
        (siteRefsOfRole "def" sites)
        (append (siteRefsOfRole "sig" sites) (siteRefsOfRole "clause" sites))
    altRefs = siteRefsOfRole "alt" sites
  in sitesOk index sites
    && countIdentified exprRefs
    == countTagged "expr" (nodeChildren tree)
    && countIdentified sigRefs
    == countSigBindings (nodeChildren tree)
    && countIdentified (distinctIds bindingRefs)
    == countTagged "binding" (nodeChildren tree)
    && countIdentified altRefs == countTagged "alt" (nodeChildren tree)

-- | 带身份的引用（id >= 0）必须指回同 kind、同区间的树节点。
refsInIndexOk : HashMap Int CstNode -> String -> List NodeRef -> Bool
refsInIndexOk index tag [] = True
refsInIndexOk index tag (r :: rest) =
  (if nodeRefId r < 0 then True else refOk index tag r) && refsInIndexOk index tag rest

allPatRefs : List Decl -> List NodeRef
allPatRefs decls = concatMap patRefsOfDecl decls

patRefsOfDecl : Decl -> List NodeRef
patRefsOfDecl d =
  case d of
    DFun _ pats body _ => append (map patRef pats) (bodyPatRefs body)
    DInstance _ _ methods _ => concatMap patRefsOfDecl methods
    _ => []

bodyPatRefs : Expr -> List NodeRef
bodyPatRefs e =
  case e of
    ELet binds body rec_ _ =>
      append
        (concatMap bindingPatRefs binds)
        (append (concatMap bindingBodyPatRefs binds) (bodyPatRefs body))
    ECase scrut alts _ => append (bodyPatRefs scrut) (concatMap altPatRefs alts)
    ELam ps body _ => append (map (\p => detachedNodeRef (secondOf p)) ps) (bodyPatRefs body)
    EApp fn args _ => append (bodyPatRefs fn) (concatMap bodyPatRefs args)
    EIf c t el _ => append (bodyPatRefs c) (append (bodyPatRefs t) (bodyPatRefs el))
    EField base f _ => bodyPatRefs base
    EPi n i q dom cod _ => append (bodyPatRefs dom) (bodyPatRefs cod)
    ERecord name fields _ => concatMap (\fv => bodyPatRefs (secondOf fv)) fields
    ERecUpdate base fields _ =>
      append (bodyPatRefs base) (concatMap (\fv => bodyPatRefs (secondOf fv)) fields)
    EDo stmts _ => concatMap stmtPatRefs stmts
    EFloat raw _ => []
    EInt n _ => []
    EStr s _ => []
    EVar n _ => []
    EInterp multi parts _ => []

-- | 一条绑定 / 一个分支贡献的 pat 引用（分支体 / 绑定值继续递归）。
bindingPatRefs : Binding -> List NodeRef
bindingPatRefs b = [patRef b.bindPat]

bindingBodyPatRefs : Binding -> List NodeRef
bindingBodyPatRefs b = bindingValuePatRefs b.bindValue

bindingValuePatRefs : BindingValue -> List NodeRef
bindingValuePatRefs (BVal e) = bodyPatRefs e
bindingValuePatRefs (BClauses clauses) = concatMap clausePatRefs clauses

altPatRefs : Alt -> List NodeRef
altPatRefs alt = append [patRef alt.altPat] (bodyPatRefs alt.altBody)

clausePatRefs : LocalClause -> List NodeRef
clausePatRefs clause = clause.lcHead :: bodyPatRefs clause.lcBody

stmtPatRefs : DoStmt -> List NodeRef
stmtPatRefs stmt =
  case stmt of
    DBind pat value r => patRef pat :: bodyPatRefs value
    DExpr value r => bodyPatRefs value
    DLet binds r => append (concatMap bindingPatRefs binds) (concatMap bindingBodyPatRefs binds)

-- | 带身份的引用（id >= 0）必须指回同 kind、同区间的树节点。
patIdsOk : HashMap Int CstNode -> CstNode -> List Decl -> Bool
patIdsOk index tree decls =
  let
    refs = allPatRefs decls
  in refsInIndexOk index "pat" refs
    && countIdentified (distinctIds refs) == countTagged "pat" (nodeChildren tree)

-- | 按 id 去重（局部函数首条子句的头模式与绑定自身的模式是同一个 `pat` 节点）。
distinctIds : List NodeRef -> List NodeRef
distinctIds [] = []
distinctIds (r :: rest) =
  if memId (nodeRefId r) rest then distinctIds rest else (::) r (distinctIds rest)

memId : Int -> List NodeRef -> Bool
memId n [] = False
memId n (x :: rest) = nodeRefId x == n || memId n rest

-- | do 语句 id 指回 doStmt 节点（专用小样例，取 EDo 的直接语句表）。
doStmtRef : DoStmt -> NodeRef
doStmtRef (DBind _ _ r) = r
doStmtRef (DExpr _ r) = r
doStmtRef (DLet _ r) = r

doSample : String
doSample = "f =\n  do\n    x <- pure 1\n    pure x\n"

doStmtsOk : Bool
doStmtsOk =
  case parseSourceDetailed "<do>" doSample of
    ErrC _ => False
    OkC p =>
      let
        toks = lexTokensOf doSample p.parsedRawToks p.parsedComments
        index = nodeIndex (nestToTree toks p.parsedEvents)
      in case p.parsedFile.sourceFileDecls of
        [DFun _ _ (EDo stmts _) _] => refsOk index "doStmt" (map doStmtRef stmts)
        _ => False

-- | 反向：声明 id 在树索引里指回同一个节点（身份 → 节点，而不是只有节点 → 身份）。
declRefsInIndex : HashMap Int CstNode -> List Decl -> Bool
declRefsInIndex index [] = True
declRefsInIndex index (d :: rest) =
  case HashMap.lookup (nodeRefId (declRef d)) index of
    Nothing => False
    Just n =>
      nodeKindTag n
        == "decl" && sameSpan (nodeSpan n) (nodeRefSpan (declRef d)) && declRefsInIndex index rest

-- | 树里的顶层 `import` 节点与 AST 的 import 一一对应：同样多、同样顺序、同一起点。
importsAlign : List CstNode -> List Import -> Bool
importsAlign [] [] = True
importsAlign [] (_ :: _) = False
importsAlign (_ :: _) [] = False
importsAlign (n :: nodes) (i :: imports) =
  nodeId n
    == Just (nodeRefId i.importRef)
    && sameStart (nodeSpan n) (importSpan i) && importsAlign nodes imports

-- | 先序的分支 id 序列（含文件根）。
nodeIds : CstNode -> List Int
nodeIds (CstLeaf _) = []
nodeIds (CstBranch _ nid _ kids) = nid :: concatMap nodeIds kids

-- | `from` 起的连续序列。
idsFrom : Int -> List Int -> Bool
idsFrom n [] = True
idsFrom n (x :: rest) = x == n && idsFrom (n + 1) rest

-- | id 恰好是 0..n-1：先序分配、没有洞也没有重复。
idsContiguous : CstNode -> Bool
idsContiguous tree =
  case nodeIds tree of
    [] => False
    x :: rest => x == 0 && idsFrom 1 rest

-- | 模块头与导出项：id 指回同 kind、同区间的树节点。
headerIdsOk : HashMap Int CstNode -> Maybe ModDecl -> Bool
headerIdsOk index Nothing = False
headerIdsOk index (Just m) =
  sameSpanIn index "modhead" m.modDeclRef
    && refsOk index "exportItem" (map exportItemRef m.modDeclExportItems)

sameSpanIn : HashMap Int CstNode -> String -> NodeRef -> Bool
sameSpanIn index tag r =
  case HashMap.lookup (nodeRefId r) index of
    Nothing => False
    Just n => nodeKindTag n == tag && sameSpan (nodeSpan n) (nodeRefSpan r)

-- | 每种结构都得真的建出来了：只靠「根是 file」会放过把 token 全平铺在根上的实现。
hasKinds : List String -> Bool
hasKinds tags =
  memName "modhead" tags
    && memName "exportItem" tags
    && memName "import" tags
    && memName "fixity" tags
    && memName "decl" tags
    && memName "ctor" tags
    && memName "field" tags
    && memName "method" tags
    && memName "binding" tags
    && memName "alt" tags && memName "doStmt" tags && memName "expr" tags && memName "pat" tags

main : Int
main =
  case parseSourceDetailed "<tree>" sample of
    ErrC _ => 0
    OkC p =>
      let
        toks = lexTokensOf sample p.parsedRawToks p.parsedComments
        tree = nestToTree toks p.parsedEvents
      in (if renderCstTree tree == sample then 1 else 0)
        + (if List.length (collectLeaves tree) == List.length toks then 2 else 0)
        + (if nestedOk tree then 4 else 0)
        + (if hasKinds (kindTags toks tree) then 8 else 0)
        + (
          if declsAlign (nodesOfKind "decl" (nodeChildren tree)) p.parsedFile.sourceFileDecls then
            16
          else
            0
        )
        + (
          if importsAlign (nodesOfKind "import" (nodeChildren tree)) p.parsedFile.sourceFileImports then
            32
          else
            0
        )
        + (if idsContiguous tree then 64 else 0)
        + (if declRefsInIndex (nodeIndex tree) p.parsedFile.sourceFileDecls then 2048 else 0)
        + (if fixitiesOk (nodeIndex tree) p.parsedFile.sourceFileFixities then 4096 else 0)
        + (if declsMembersOk (nodeIndex tree) p.parsedFile.sourceFileDecls then 8192 else 0)
        + (if doStmtsOk then 16384 else 0)
        + (if exprIdsOk (nodeIndex tree) tree p.parsedFile.sourceFileDecls then 32768 else 0)
        + (if patIdsOk (nodeIndex tree) tree p.parsedFile.sourceFileDecls then 65536 else 0)
        + (if headerIdsOk (nodeIndex tree) p.parsedFile.sourceFileModDecl then 131072 else 0)
