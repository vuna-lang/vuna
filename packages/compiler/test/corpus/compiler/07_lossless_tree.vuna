-- parser 发射的无损树：叶序列 == token 序列、逐字节还原、嵌套区间互不交叉。
--
-- 这是 D18「parser 发射无损树」的第一条等价证据：树的区间来自 parser 的递归点
-- （`NodeEvent`），而不是从缩进或括号反推；AST 与 canonical 编码在这一步不变。
import Prelude
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Parser

sample : String
sample =
  "-- 模块头 + import + 各类声明\n"
    ++ "module M (f, T(..)) where\n"
    ++ "\n"
    ++ "import Base.Data.List as List\n"
    ++ "import Base.Data.Pair\n"
    ++ "export import Base.Data.Pair (fst)\n"
    ++ "\n"
    ++ "infixl 6 <+>\n"
    ++ "\n"
    ++ "-- data 与构造子\n"
    ++ "data T : Type where\n"
    ++ "  MkT : Int -> T\n"
    ++ "  MkU : T\n"
    ++ "\n"
    ++ "record P where\n"
    ++ "  x : Int\n"
    ++ "  y : Int\n"
    ++ "\n"
    ++ "-- trait 与方法签名\n"
    ++ "trait Show a where\n"
    ++ "  show : a -> String\n"
    ++ "\n"
    ++ "f : Int -> Int\n"
    ++ "f n = n + 1\n"
    ++ "\n"
    ++ "g : Int\n"
    ++ "g =\n"
    ++ "  let\n"
    ++ "    h : Int\n"
    ++ "    h = 2\n"
    ++ "  in case f h of\n"
    ++ "       0 => 0\n"
    ++ "       _ => if h > 1 then 3 else 4\n"
    ++ "\n"
    ++ "-- do 块里的语句（供 `doStmt` 节点）\n"
    ++ "k : Int\n"
    ++ "k =\n"
    ++ "  do\n"
    ++ "    x <- pure 1\n"
    ++ "    let y = x + 1\n"
    ++ "    pure y\n"
    ++ "\n"
    ++ "-- 修饰符前缀属于声明自己的区间（与建树节点同一区间）\n"
    ++ "export hidden : Int\n"
    ++ "hidden = 7\n"
    ++ "export opaque sealed : Int\n"
    ++ "sealed = 8\n"
    ++ "opaque blind : Int\n"
    ++ "blind = 9\n"
    ++ "export data E : Type where\n"
    ++ "  MkE : E\n"
    ++ "\n"
    ++ "-- instance 体的方法也是 decl 节点（自己的 id）\n"
    ++ "instance Show Int where\n" ++ "  show n = show n\n"

-- | 相邻兄弟按源码顺序：前一个的终点不晚于后一个的起点。
orderedKids : List CstNode -> Bool
orderedKids [] = True
orderedKids (a :: rest) = orderedKidsFrom (nodeSpan a) rest

-- | `orderedKids` 的续段：逐个比对相邻兄弟（结构递归）。
orderedKidsFrom : Span -> List CstNode -> Bool
orderedKidsFrom prev [] = True
orderedKidsFrom prev (b :: rest) =
  spanEndOffset prev <= spanStartOffset (nodeSpan b) && orderedKidsFrom (nodeSpan b) rest

-- | children 全部落在分支的字节区间内。
kidsInside : Span -> List CstNode -> Bool
kidsInside sp [] = True
kidsInside sp (k :: rest) =
  spanStartOffset (nodeSpan k)
    >= spanStartOffset sp && spanEndOffset (nodeSpan k) <= spanEndOffset sp && kidsInside sp rest

-- | 递归：每个分支的 children 有序、都在自己的区间里，且自身也被父层检查过。
nestedOk : CstNode -> Bool
nestedOk (CstLeaf _) = True
nestedOk (CstBranch _ _ sp kids) =
  orderedKids kids && kidsInside sp kids && List.length kids > 0 && nestedAll kids

nestedAll : List CstNode -> Bool
nestedAll [] = True
nestedAll (k :: rest) = nestedOk k && nestedAll rest

-- | 树上出现过的节点种类（前序）。fuel 界是树高（结构递归经 `concatMap` 时 SCT
-- 看不到下降，显式给界）。
kindTagsAt : Int -> CstNode -> List String
kindTagsAt fuel n =
  if fuel <= 0 then
    []
  else
    case n of
      CstLeaf _ => []
      CstBranch _ _ _ kids => nodeKindTag n :: concatMap (kindTagsAt (fuel - 1)) kids

-- | 每层至少 1 个 token，所以 token 数是树高的安全上界。
kindTags : List CstToken -> CstNode -> List String
kindTags toks tree = kindTagsAt (List.length toks) tree

-- | 顶层指定 kind 的节点（源码顺序）。
nodesOfKind : String -> List CstNode -> List CstNode
nodesOfKind tag [] = []
nodesOfKind tag (n :: rest) =
  if nodeKindTag n == tag then n :: nodesOfKind tag rest else nodesOfKind tag rest

-- | 两段 span 的顺序与字节区间完全一致（同一构造只能有一个区间来源）。
sameSpan : Span -> Span -> Bool
sameSpan a b =
  spanStartLine a
    == spanStartLine b
    && spanStartCol a
    == spanStartCol b
    && spanStartOffset a
    == spanStartOffset b
    && spanEndLine a
    == spanEndLine b && spanEndCol a == spanEndCol b && spanEndOffset a == spanEndOffset b

-- | 两段 span 起点一致（重导出把成员列表放在 `importSpan` 之外，终点可以不同）。
sameStart : Span -> Span -> Bool
sameStart a b =
  spanStartLine a
    == spanStartLine b && spanStartCol a == spanStartCol b && spanStartOffset a == spanStartOffset b

-- | 树里的顶层声明节点与 AST 的声明一一对应：同样多、同样顺序、同一区间。
-- 这是迁移期的漂移锁：树多建 / 少建 / 起点或终点挪位都会在这里炸。
declsAlign : List CstNode -> List Decl -> Bool
declsAlign [] [] = True
declsAlign [] (_ :: _) = False
declsAlign (_ :: _) [] = False
declsAlign (n :: nodes) (d :: decls) =
  nodeId n
    == Just (nodeRefId (declRef d))
    && sameSpan (nodeSpan n) (nodeRefSpan (declRef d)) && declsAlign nodes decls

-- | 一个 `NodeRef` 在树索引里指回 kind 与区间都一致的节点。
refOk : HashMap Int CstNode -> String -> NodeRef -> Bool
refOk index tag r =
  case HashMap.lookup (nodeRefId r) index of
    Nothing => False
    Just n => nodeKindTag n == tag && sameSpan (nodeSpan n) (nodeRefSpan r)

refsOk : HashMap Int CstNode -> String -> List NodeRef -> Bool
refsOk index tag [] = True
refsOk index tag (r :: rest) = refOk index tag r && refsOk index tag rest

ctorRefOf : Ctor -> NodeRef
ctorRefOf c = c.ctorRef

fieldRefOf : Field -> NodeRef
fieldRefOf f = f.fieldRef

traitMethodRefOf : TraitMethod -> NodeRef
traitMethodRefOf m = m.traitMethodRef

fixityRefOf : FixityDecl -> NodeRef
fixityRefOf d = d.fixityRef

-- | 成员（构造子 / 字段 / trait 方法）的 id 在树里各自指回同 kind 的节点。
declMembersOk : HashMap Int CstNode -> Decl -> Bool
declMembersOk index (DData _ _ _ ctors _ _ _ _ _) = refsOk index "ctor" (map ctorRefOf ctors)
declMembersOk index (DRecord _ _ fields _ _ _ _ _) = refsOk index "field" (map fieldRefOf fields)
declMembersOk index (DTrait _ _ _ methods _) = refsOk index "method" (map traitMethodRefOf methods)
declMembersOk index _ = True

declsMembersOk : HashMap Int CstNode -> List Decl -> Bool
declsMembersOk index [] = True
declsMembersOk index (d :: rest) = declMembersOk index d && declsMembersOk index rest

-- | fixity 声明 id 指回 fixity 节点。
fixitiesOk : HashMap Int CstNode -> List FixityDecl -> Bool
fixitiesOk index fx = refsOk index "fixity" (map fixityRefOf fx)

-- ---------------------------------------------------------------
-- 表达式 / 模式的身份：parseExpr / parsePatternSingle 的区间出口各建一个节点，
-- 只有这些「区间根」带 id（更内层的构造子是同一区间的多个视图，没有独立节点）。
-- ---------------------------------------------------------------
-- | 一个表达式树上所有带身份的区间根（含自身）。
exprRefsAt : Int -> Expr -> List NodeRef
exprRefsAt fuel e =
  if fuel <= 0 then
    []
  else
    let
      rest =
        case e of
          EVar n r => []
          EInt n r => []
          EStr s r => []
          EFloat raw r => []
          EInterp multi parts r => concatMap (interpRefs (fuel - 1)) parts
          ELam ps body r => exprRefsAt (fuel - 1) body
          EApp fn args r => append (exprRefsAt (fuel - 1) fn) (concatMap (exprRefsAt (fuel - 1)) args)
          EPi n i q dom cod r => append (exprRefsAt (fuel - 1) dom) (exprRefsAt (fuel - 1) cod)
          ELet binds body rec_ r => append (concatMap (bindingRefs (fuel - 1)) binds) (exprRefsAt (fuel - 1) body)
          ELocalFun clauses r => concatMap (localClauseRefs (fuel - 1)) clauses
          ECase scrut alts r => append (exprRefsAt (fuel - 1) scrut) (concatMap (altRefs (fuel - 1)) alts)
          EIf c t el r => append (exprRefsAt (fuel - 1) c) (append (exprRefsAt (fuel - 1) t) (exprRefsAt (fuel - 1) el))
          EField base f r => exprRefsAt (fuel - 1) base
          ERecord name fields r => concatMap (fieldValueRefs (fuel - 1)) fields
          ERecUpdate base fields r => append (exprRefsAt (fuel - 1) base) (concatMap (fieldValueRefs (fuel - 1)) fields)
          EDo stmts r => concatMap (stmtRefs (fuel - 1)) stmts
          EAnn inner ty r => append (exprRefsAt (fuel - 1) inner) (exprRefsAt (fuel - 1) ty)
          EInfix op l rhs r => append (exprRefsAt (fuel - 1) l) (exprRefsAt (fuel - 1) rhs)
          EParen inner r => exprRefsAt (fuel - 1) inner
          EBacktick nm l rhs r => append (exprRefsAt (fuel - 1) l) (exprRefsAt (fuel - 1) rhs)
          ESectOp op r => []
          ESectL op inner r => exprRefsAt (fuel - 1) inner
          ESectR inner op r => exprRefsAt (fuel - 1) inner
    in exprRef e :: rest

interpRefs : Int -> InterpPart -> List NodeRef
interpRefs fuel part =
  if fuel <= 0 then
    []
  else
    case part of
      IPText s => []
      IPHole e => exprRefsAt (fuel - 1) e

bindingRefs : Int -> Pair Pat Expr -> List NodeRef
bindingRefs fuel (Pair pat value) = if fuel <= 0 then [] else exprRefsAt (fuel - 1) value

localClauseRefs : Int -> Pair (List Pat) Expr -> List NodeRef
localClauseRefs fuel (Pair pats body) = if fuel <= 0 then [] else exprRefsAt (fuel - 1) body

altRefs : Int -> Pair Pat Expr -> List NodeRef
altRefs fuel (Pair pat body) = if fuel <= 0 then [] else exprRefsAt (fuel - 1) body

fieldValueRefs : Int -> Pair String Expr -> List NodeRef
fieldValueRefs fuel (Pair fname value) = if fuel <= 0 then [] else exprRefsAt (fuel - 1) value

stmtRefs : Int -> DoStmt -> List NodeRef
stmtRefs fuel stmt =
  if fuel <= 0 then
    []
  else
    case stmt of
      DBind pat value r => exprRefsAt (fuel - 1) value
      DExpr value r => exprRefsAt (fuel - 1) value
      DLet binds r => concatMap (bindingRefs (fuel - 1)) binds

declExprRefs : Int -> Decl -> List NodeRef
declExprRefs fuel d =
  if fuel <= 0 then
    []
  else
    case d of
      DData _ _ kind ctors _ _ _ _ _ => append (exprRefsAt (fuel - 1) kind) (concatMap (ctorTypeRefs (fuel - 1)) ctors)
      DAxiom _ ty _ => exprRefsAt (fuel - 1) ty
      DExtern _ _ ty _ => exprRefsAt (fuel - 1) ty
      DSig _ ctx ty _ => append (concatMap (exprRefsAt (fuel - 1)) ctx) (exprRefsAt (fuel - 1) ty)
      DFun _ pats body _ => exprRefsAt (fuel - 1) body
      DRecord _ _ fields _ _ _ _ _ => concatMap (fieldTypeRefs (fuel - 1)) fields
      DTrait _ params supers methods _ => append (concatMap (traitParamRefs (fuel - 1)) params) (append (concatMap (exprRefsAt (fuel - 1)) supers) (concatMap (methodTypeRefs (fuel - 1)) methods))
      DInstance ctx head methods _ => append (concatMap (exprRefsAt (fuel - 1)) ctx) (append (exprRefsAt (fuel - 1) head) (concatMap (declExprRefs (fuel - 1)) methods))

ctorTypeRefs : Int -> Ctor -> List NodeRef
ctorTypeRefs fuel (Ctor _ ty _ r) = if fuel <= 0 then [] else exprRefsAt (fuel - 1) ty

fieldTypeRefs : Int -> Field -> List NodeRef
fieldTypeRefs fuel f = if fuel <= 0 then [] else exprRefsAt (fuel - 1) (fieldType f)

methodTypeRefs : Int -> TraitMethod -> List NodeRef
methodTypeRefs fuel m = if fuel <= 0 then [] else exprRefsAt (fuel - 1) (methodTy m)

methodTy : TraitMethod -> Expr
methodTy m = m.traitMethodType

traitParamRefs : Int -> TraitParam -> List NodeRef
traitParamRefs fuel param =
  if fuel <= 0 then
    []
  else
    case param.traitParamKind of
      Nothing => []
      Just k => exprRefsAt (fuel - 1) k

allExprRefs : List Decl -> List NodeRef
allExprRefs decls = concatMap (declExprRefs 64) decls

allPatRefs : List Decl -> List NodeRef
allPatRefs decls = concatMap patRefsOfDecl decls

patRefsOfDecl : Decl -> List NodeRef
patRefsOfDecl d =
  case d of
    DFun _ pats body _ => append (map patRef pats) (bodyPatRefs body)
    DInstance _ _ methods _ => concatMap patRefsOfDecl methods
    _ => []

bodyPatRefs : Expr -> List NodeRef
bodyPatRefs e =
  case e of
    ELet binds body rec_ _ =>
      append
        (map (\b => patRef (firstOf b)) binds)
        (append (concatMap (\b => bodyPatRefs (secondOf b)) binds) (bodyPatRefs body))
    ECase scrut alts _ =>
      append
        (bodyPatRefs scrut)
        (concatMap (\a => append [patRef (firstOf a)] (bodyPatRefs (secondOf a))) alts)
    ELam ps body _ => append (map (\p => detachedNodeRef (secondOf p)) ps) (bodyPatRefs body)
    EApp fn args _ => append (bodyPatRefs fn) (concatMap bodyPatRefs args)
    EIf c t el _ => append (bodyPatRefs c) (append (bodyPatRefs t) (bodyPatRefs el))
    EField base f _ => bodyPatRefs base
    EPi n i q dom cod _ => append (bodyPatRefs dom) (bodyPatRefs cod)
    ERecord name fields _ => concatMap (\fv => bodyPatRefs (secondOf fv)) fields
    ERecUpdate base fields _ =>
      append (bodyPatRefs base) (concatMap (\fv => bodyPatRefs (secondOf fv)) fields)
    EDo stmts _ => concatMap stmtPatRefs stmts
    ELocalFun clauses _ => concatMap (\c => bodyPatRefs (secondOf c)) clauses
    EAnn v t _ => append (bodyPatRefs v) (bodyPatRefs t)
    EFloat raw _ => []
    EInt n _ => []
    EStr s _ => []
    EVar n _ => []
    EBacktick nm l r _ => append (bodyPatRefs l) (bodyPatRefs r)
    ESectOp op _ => []
    ESectL op inner _ => bodyPatRefs inner
    ESectR inner op _ => bodyPatRefs inner
    EInfix op l r _ => append (bodyPatRefs l) (bodyPatRefs r)
    EParen inner _ => bodyPatRefs inner
    EInterp multi parts _ => []

stmtPatRefs : DoStmt -> List NodeRef
stmtPatRefs stmt =
  case stmt of
    DBind pat value r => patRef pat :: bodyPatRefs value
    DExpr value r => bodyPatRefs value
    DLet binds r =>
      append
        (map (\b => patRef (firstOf b)) binds)
        (concatMap (\b => bodyPatRefs (secondOf b)) binds)

-- | 带身份的引用（id >= 0）必须指回同 kind、同区间的树节点。
refsInIndexOk : HashMap Int CstNode -> String -> List NodeRef -> Bool
refsInIndexOk index tag [] = True
refsInIndexOk index tag (r :: rest) =
  (if nodeRefId r < 0 then True else refOk index tag r) && refsInIndexOk index tag rest

-- | 表达式区间根：id 指回 `expr` 节点，**终点相同、AST 区间落在节点区间内**。
-- `EInfix` / `EBacktick` 的 span 从运算符起（诊断指向运算符），比树节点窄。
exprRefOk : HashMap Int CstNode -> NodeRef -> Bool
exprRefOk index r =
  case HashMap.lookup (nodeRefId r) index of
    Nothing => False
    Just n =>
      nodeKindTag n
        == "expr"
        && spanEndOffset (nodeSpan n)
        == spanEndOffset (nodeRefSpan r)
        && spanStartOffset (nodeSpan n)
        <= spanStartOffset (nodeRefSpan r)
        && spanEndOffset (nodeRefSpan r) <= spanEndOffset (nodeSpan n)

exprRefsOk : HashMap Int CstNode -> List NodeRef -> Bool
exprRefsOk index [] = True
exprRefsOk index (r :: rest) =
  (if nodeRefId r < 0 then True else exprRefOk index r) && exprRefsOk index rest

-- | 带身份的引用条数与树上该 kind 的节点数相等（区间根一一对应，不多不少）。
countTagged : String -> List CstNode -> Int
countTagged tag nodes = List.length (nodesOfKindDeep tag nodes)

nodesOfKindDeep : String -> List CstNode -> List CstNode
nodesOfKindDeep tag [] = []
nodesOfKindDeep tag (n :: rest) =
  append (if nodeKindTag n == tag then [n] else []) (
      case n of
        CstLeaf _ => nodesOfKindDeep tag rest
        CstBranch _ _ _ kids => append (nodesOfKindDeep tag kids) (nodesOfKindDeep tag rest)
    )

countIdentified : List NodeRef -> Int
countIdentified refs = List.length (filter (\r => nodeRefId r >= 0) refs)

exprIdsOk : HashMap Int CstNode -> CstNode -> List Decl -> Bool
exprIdsOk index tree decls =
  let
    refs = allExprRefs decls
  in exprRefsOk index refs
    && countIdentified refs == countTagged "expr" (nodeChildren tree)

patIdsOk : HashMap Int CstNode -> CstNode -> List Decl -> Bool
patIdsOk index tree decls =
  let
    refs = allPatRefs decls
  in refsInIndexOk index "pat" refs && countIdentified refs == countTagged "pat" (nodeChildren tree)

-- | do 语句 id 指回 doStmt 节点（专用小样例，取 EDo 的直接语句表）。
doStmtRef : DoStmt -> NodeRef
doStmtRef (DBind _ _ r) = r
doStmtRef (DExpr _ r) = r
doStmtRef (DLet _ r) = r

doSample : String
doSample = "f =\n  do\n    x <- pure 1\n    pure x\n"

doStmtsOk : Bool
doStmtsOk =
  case parseSourceDetailed "<do>" doSample of
    ErrC _ => False
    OkC p =>
      let
        toks = lexTokensOf doSample p.parsedRawToks p.parsedComments
        index = nodeIndex (nestToTree toks p.parsedEvents)
      in case p.parsedFile.sourceFileDecls of
        [DFun _ _ (EDo stmts _) _] => refsOk index "doStmt" (map doStmtRef stmts)
        _ => False

-- | 反向：声明 id 在树索引里指回同一个节点（身份 → 节点，而不是只有节点 → 身份）。
declRefsInIndex : HashMap Int CstNode -> List Decl -> Bool
declRefsInIndex index [] = True
declRefsInIndex index (d :: rest) =
  case HashMap.lookup (nodeRefId (declRef d)) index of
    Nothing => False
    Just n =>
      nodeKindTag n
        == "decl" && sameSpan (nodeSpan n) (nodeRefSpan (declRef d)) && declRefsInIndex index rest

-- | 树里的顶层 `import` 节点与 AST 的 import 一一对应：同样多、同样顺序、同一起点。
importsAlign : List CstNode -> List Import -> Bool
importsAlign [] [] = True
importsAlign [] (_ :: _) = False
importsAlign (_ :: _) [] = False
importsAlign (n :: nodes) (i :: imports) =
  nodeId n
    == Just (nodeRefId i.importRef)
    && sameStart (nodeSpan n) (importSpan i) && importsAlign nodes imports

-- | 先序的分支 id 序列（含文件根）。
nodeIds : CstNode -> List Int
nodeIds (CstLeaf _) = []
nodeIds (CstBranch _ nid _ kids) = nid :: concatMap nodeIds kids

-- | `from` 起的连续序列。
idsFrom : Int -> List Int -> Bool
idsFrom n [] = True
idsFrom n (x :: rest) = x == n && idsFrom (n + 1) rest

-- | id 恰好是 0..n-1：先序分配、没有洞也没有重复。
idsContiguous : CstNode -> Bool
idsContiguous tree =
  case nodeIds tree of
    [] => False
    x :: rest => x == 0 && idsFrom 1 rest

-- | 声明的起点偏移解析到唯一 id，且该节点的 kind / 区间与 AST 一致。
declIdOk : HashMap Int Int -> HashMap Int CstNode -> Decl -> Bool
declIdOk offsets index d =
  case HashMap.lookup (spanStartOffset (declSpan d)) offsets of
    Nothing => False
    Just nid =>
      case HashMap.lookup nid index of
        Nothing => False
        Just n => nodeKindTag n == "decl" && sameSpan (nodeSpan n) (declSpan d)

declIdsOk : HashMap Int Int -> HashMap Int CstNode -> List Decl -> Bool
declIdsOk offsets index [] = True
declIdsOk offsets index (d :: rest) = declIdOk offsets index d && declIdsOk offsets index rest

-- | import 的起点偏移解析到 import 节点（重导出尾在 `importSpan` 之外，只比起点）。
importIdOk : HashMap Int Int -> HashMap Int CstNode -> Import -> Bool
importIdOk offsets index i =
  case HashMap.lookup (spanStartOffset (importSpan i)) offsets of
    Nothing => False
    Just nid =>
      case HashMap.lookup nid index of
        Nothing => False
        Just n => nodeKindTag n == "import" && sameStart (nodeSpan n) (importSpan i)

importIdsOk : HashMap Int Int -> HashMap Int CstNode -> List Import -> Bool
importIdsOk offsets index [] = True
importIdsOk offsets index (i :: rest) = importIdOk offsets index i && importIdsOk offsets index rest

-- 没有模块头时首个声明从字节 0 开始：身份索引必须跳过文件根，否则偏移 0 会被根占住。
noHeader : String
noHeader = "f : Int\nf = 1\n"

noHeaderDeclIds : Bool
noHeaderDeclIds =
  case parseSourceDetailed "<noheader>" noHeader of
    ErrC _ => False
    OkC p =>
      let
        toks = lexTokensOf noHeader p.parsedRawToks p.parsedComments
        tree = nestToTree toks p.parsedEvents
      in declIdsOk (nodeIdAtOffset tree) (nodeIndex tree) p.parsedFile.sourceFileDecls

-- | 每种结构都得真的建出来了：只靠「根是 file」会放过把 token 全平铺在根上的实现。
hasKinds : List String -> Bool
hasKinds tags =
  memName "modhead" tags
    && memName "exportItem" tags
    && memName "import" tags
    && memName "fixity" tags
    && memName "decl" tags
    && memName "ctor" tags
    && memName "field" tags
    && memName "method" tags
    && memName "binding" tags
    && memName "alt" tags && memName "doStmt" tags && memName "expr" tags && memName "pat" tags

main : Int
main =
  case parseSourceDetailed "<tree>" sample of
    ErrC _ => 0
    OkC p =>
      let
        toks = lexTokensOf sample p.parsedRawToks p.parsedComments
        tree = nestToTree toks p.parsedEvents
      in (if renderCstTree tree == sample then 1 else 0)
        + (if List.length (collectLeaves tree) == List.length toks then 2 else 0)
        + (if nestedOk tree then 4 else 0)
        + (if hasKinds (kindTags toks tree) then 8 else 0)
        + (
          if declsAlign (nodesOfKind "decl" (nodeChildren tree)) p.parsedFile.sourceFileDecls then
            16
          else
            0
        )
        + (
          if importsAlign (nodesOfKind "import" (nodeChildren tree)) p.parsedFile.sourceFileImports then
            32
          else
            0
        )
        + (if idsContiguous tree then 64 else 0)
        + (
          if declIdsOk (nodeIdAtOffset tree) (nodeIndex tree) p.parsedFile.sourceFileDecls then
            128
          else
            0
        )
        + (
          if importIdsOk (nodeIdAtOffset tree) (nodeIndex tree) p.parsedFile.sourceFileImports then
            256
          else
            0
        )
        + (if noHeaderDeclIds then 512 else 0)
        + (if declRefsInIndex (nodeIndex tree) p.parsedFile.sourceFileDecls then 2048 else 0)
        + (if fixitiesOk (nodeIndex tree) p.parsedFile.sourceFileFixities then 4096 else 0)
        + (if declsMembersOk (nodeIndex tree) p.parsedFile.sourceFileDecls then 8192 else 0)
        + (if doStmtsOk then 16384 else 0)
        + (if exprIdsOk (nodeIndex tree) tree p.parsedFile.sourceFileDecls then 32768 else 0)
        + (if patIdsOk (nodeIndex tree) tree p.parsedFile.sourceFileDecls then 65536 else 0)
