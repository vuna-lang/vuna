-- parser 发射的无损树：叶序列 == token 序列、逐字节还原、嵌套区间互不交叉。
--
-- 这是 D18「parser 发射无损树」的第一条等价证据：树的区间来自 parser 的递归点
-- （`NodeEvent`），而不是从缩进或括号反推；AST 与 canonical 编码在这一步不变。
import Prelude
import Base.Container.HashMap as HashMap
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Parser

sample : String
sample =
  "-- 模块头 + import + 各类声明\n"
    ++ "module M (f, T(..)) where\n"
    ++ "\n"
    ++ "import Base.Data.List as List\n"
    ++ "import Base.Data.Pair\n"
    ++ "export import Base.Data.Pair (fst)\n"
    ++ "\n"
    ++ "infixl 6 <+>\n"
    ++ "\n"
    ++ "-- data 与构造子\n"
    ++ "data T : Type where\n"
    ++ "  MkT : Int -> T\n"
    ++ "  MkU : T\n"
    ++ "\n"
    ++ "record P where\n"
    ++ "  x : Int\n"
    ++ "  y : Int\n"
    ++ "\n"
    ++ "-- trait 与方法签名\n"
    ++ "trait Show a where\n"
    ++ "  show : a -> String\n"
    ++ "\n"
    ++ "f : Int -> Int\n"
    ++ "f n = n + 1\n"
    ++ "\n"
    ++ "g : Int\n"
    ++ "g =\n"
    ++ "  let\n"
    ++ "    h : Int\n"
    ++ "    h = 2\n"
    ++ "  in case f h of\n"
    ++ "       0 => 0\n"
    ++ "       _ => if h > 1 then 3 else 4\n"
    ++ "\n"
    ++ "-- do 块里的语句（供 `doStmt` 节点）\n"
    ++ "k : Int\n"
    ++ "k =\n"
    ++ "  do\n"
    ++ "    x <- pure 1\n"
    ++ "    let y = x + 1\n"
    ++ "    pure y\n"
    ++ "\n"
    ++ "-- 修饰符前缀属于声明自己的区间（与建树节点同一区间）\n"
    ++ "export hidden : Int\n"
    ++ "hidden = 7\n"
    ++ "export opaque sealed : Int\n"
    ++ "sealed = 8\n"
    ++ "opaque blind : Int\n" ++ "blind = 9\n" ++ "export data E : Type where\n" ++ "  MkE : E\n"

-- | 相邻兄弟按源码顺序：前一个的终点不晚于后一个的起点。
orderedKids : List CstNode -> Bool
orderedKids [] = True
orderedKids (a :: rest) = orderedKidsFrom (nodeSpan a) rest

-- | `orderedKids` 的续段：逐个比对相邻兄弟（结构递归）。
orderedKidsFrom : Span -> List CstNode -> Bool
orderedKidsFrom prev [] = True
orderedKidsFrom prev (b :: rest) =
  spanEndOffset prev <= spanStartOffset (nodeSpan b) && orderedKidsFrom (nodeSpan b) rest

-- | children 全部落在分支的字节区间内。
kidsInside : Span -> List CstNode -> Bool
kidsInside sp [] = True
kidsInside sp (k :: rest) =
  spanStartOffset (nodeSpan k)
    >= spanStartOffset sp && spanEndOffset (nodeSpan k) <= spanEndOffset sp && kidsInside sp rest

-- | 递归：每个分支的 children 有序、都在自己的区间里，且自身也被父层检查过。
nestedOk : CstNode -> Bool
nestedOk (CstLeaf _) = True
nestedOk (CstBranch _ _ sp kids) =
  orderedKids kids && kidsInside sp kids && List.length kids > 0 && nestedAll kids

nestedAll : List CstNode -> Bool
nestedAll [] = True
nestedAll (k :: rest) = nestedOk k && nestedAll rest

-- | 树上出现过的节点种类（前序）。fuel 界是树高（结构递归经 `concatMap` 时 SCT
-- 看不到下降，显式给界）。
kindTagsAt : Int -> CstNode -> List String
kindTagsAt fuel n =
  if fuel <= 0 then
    []
  else
    case n of
      CstLeaf _ => []
      CstBranch _ _ _ kids => nodeKindTag n :: concatMap (kindTagsAt (fuel - 1)) kids

-- | 每层至少 1 个 token，所以 token 数是树高的安全上界。
kindTags : List CstToken -> CstNode -> List String
kindTags toks tree = kindTagsAt (List.length toks) tree

-- | 顶层指定 kind 的节点（源码顺序）。
nodesOfKind : String -> List CstNode -> List CstNode
nodesOfKind tag [] = []
nodesOfKind tag (n :: rest) =
  if nodeKindTag n == tag then n :: nodesOfKind tag rest else nodesOfKind tag rest

-- | 两段 span 的顺序与字节区间完全一致（同一构造只能有一个区间来源）。
sameSpan : Span -> Span -> Bool
sameSpan a b =
  spanStartLine a
    == spanStartLine b
    && spanStartCol a
    == spanStartCol b
    && spanStartOffset a
    == spanStartOffset b
    && spanEndLine a
    == spanEndLine b && spanEndCol a == spanEndCol b && spanEndOffset a == spanEndOffset b

-- | 两段 span 起点一致（重导出把成员列表放在 `importSpan` 之外，终点可以不同）。
sameStart : Span -> Span -> Bool
sameStart a b =
  spanStartLine a
    == spanStartLine b && spanStartCol a == spanStartCol b && spanStartOffset a == spanStartOffset b

-- | 树里的顶层声明节点与 AST 的声明一一对应：同样多、同样顺序、同一区间。
-- 这是迁移期的漂移锁：树多建 / 少建 / 起点或终点挪位都会在这里炸。
declsAlign : List CstNode -> List Decl -> Bool
declsAlign [] [] = True
declsAlign [] (_ :: _) = False
declsAlign (_ :: _) [] = False
declsAlign (n :: nodes) (d :: decls) = sameSpan (nodeSpan n) (declSpan d) && declsAlign nodes decls

-- | 树里的顶层 `import` 节点与 AST 的 import 一一对应：同样多、同样顺序、同一起点。
importsAlign : List CstNode -> List Import -> Bool
importsAlign [] [] = True
importsAlign [] (_ :: _) = False
importsAlign (_ :: _) [] = False
importsAlign (n :: nodes) (i :: imports) =
  sameStart (nodeSpan n) i.importSpan && importsAlign nodes imports

-- | 先序的分支 id 序列（含文件根）。
nodeIds : CstNode -> List Int
nodeIds (CstLeaf _) = []
nodeIds (CstBranch _ nid _ kids) = nid :: concatMap nodeIds kids

-- | `from` 起的连续序列。
idsFrom : Int -> List Int -> Bool
idsFrom n [] = True
idsFrom n (x :: rest) = x == n && idsFrom (n + 1) rest

-- | id 恰好是 0..n-1：先序分配、没有洞也没有重复。
idsContiguous : CstNode -> Bool
idsContiguous tree =
  case nodeIds tree of
    [] => False
    x :: rest => x == 0 && idsFrom 1 rest

-- | 声明的起点偏移解析到唯一 id，且该节点的 kind / 区间与 AST 一致。
declIdOk : HashMap Int Int -> HashMap Int CstNode -> Decl -> Bool
declIdOk offsets index d =
  case HashMap.lookup (spanStartOffset (declSpan d)) offsets of
    Nothing => False
    Just nid =>
      case HashMap.lookup nid index of
        Nothing => False
        Just n => nodeKindTag n == "decl" && sameSpan (nodeSpan n) (declSpan d)

declIdsOk : HashMap Int Int -> HashMap Int CstNode -> List Decl -> Bool
declIdsOk offsets index [] = True
declIdsOk offsets index (d :: rest) = declIdOk offsets index d && declIdsOk offsets index rest

-- | import 的起点偏移解析到 import 节点（重导出尾在 `importSpan` 之外，只比起点）。
importIdOk : HashMap Int Int -> HashMap Int CstNode -> Import -> Bool
importIdOk offsets index i =
  case HashMap.lookup (spanStartOffset i.importSpan) offsets of
    Nothing => False
    Just nid =>
      case HashMap.lookup nid index of
        Nothing => False
        Just n => nodeKindTag n == "import" && sameStart (nodeSpan n) i.importSpan

importIdsOk : HashMap Int Int -> HashMap Int CstNode -> List Import -> Bool
importIdsOk offsets index [] = True
importIdsOk offsets index (i :: rest) = importIdOk offsets index i && importIdsOk offsets index rest

-- 没有模块头时首个声明从字节 0 开始：身份索引必须跳过文件根，否则偏移 0 会被根占住。
noHeader : String
noHeader = "f : Int\nf = 1\n"

noHeaderDeclIds : Bool
noHeaderDeclIds =
  case parseSourceDetailed "<noheader>" noHeader of
    ErrC _ => False
    OkC p =>
      let
        toks = lexTokensOf noHeader p.parsedRawToks p.parsedComments
        tree = nestToTree toks p.parsedEvents
      in declIdsOk (nodeIdAtOffset tree) (nodeIndex tree) p.parsedFile.sourceFileDecls

-- | 每种结构都得真的建出来了：只靠「根是 file」会放过把 token 全平铺在根上的实现。
hasKinds : List String -> Bool
hasKinds tags =
  memName "modhead" tags
    && memName "exportItem" tags
    && memName "import" tags
    && memName "fixity" tags
    && memName "decl" tags
    && memName "ctor" tags
    && memName "field" tags
    && memName "method" tags
    && memName "binding" tags
    && memName "alt" tags && memName "doStmt" tags && memName "expr" tags && memName "pat" tags

main : Int
main =
  case parseSourceDetailed "<tree>" sample of
    ErrC _ => 0
    OkC p =>
      let
        toks = lexTokensOf sample p.parsedRawToks p.parsedComments
        tree = nestToTree toks p.parsedEvents
      in (if renderCstTree tree == sample then 1 else 0)
        + (if List.length (collectLeaves tree) == List.length toks then 2 else 0)
        + (if nestedOk tree then 4 else 0)
        + (if hasKinds (kindTags toks tree) then 8 else 0)
        + (
          if declsAlign (nodesOfKind "decl" (nodeChildren tree)) p.parsedFile.sourceFileDecls then
            16
          else
            0
        )
        + (
          if importsAlign (nodesOfKind "import" (nodeChildren tree)) p.parsedFile.sourceFileImports then
            32
          else
            0
        )
        + (if idsContiguous tree then 64 else 0)
        + (
          if declIdsOk (nodeIdAtOffset tree) (nodeIndex tree) p.parsedFile.sourceFileDecls then
            128
          else
            0
        )
        + (
          if importIdsOk (nodeIdAtOffset tree) (nodeIndex tree) p.parsedFile.sourceFileImports then
            256
          else
            0
        ) + (if noHeaderDeclIds then 512 else 0)
