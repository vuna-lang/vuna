-- 括号表面形状（`Frontend.Cst`）：括号不在 AST 里，层数由建树事件 + 词法 token 派生，
-- 写在树节点字段上，用 `CstIndex` 按节点 id / span 查。覆盖四种位置：
--   * 包装节点（定义体 / 中缀右操作数 / 括号内层，`(a)` / `((a))`）；
--   * 原子位置括号（应用实参 / 中缀链左端，`f (a)` / `(f a) b` / `(a + b) * c`）；
--   * 不该算括号的邻近 token（元组 / ascribe / section / 列表）；
--   * section 写法在节点字段上（按区间起点查），右 section 也有自己的原子节点；
--   * 模板洞（独立 token 子流，子树挂在模板节点上，索引一起走）。
import Prelude
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser

-- | 解析 `x = <src>`，取定义体与树索引。
parseBody : String -> Maybe (CstIndex, Expr)
parseBody src =
  case parseSourceDetailed "<paren>" ("x = " ++ src ++ "\n") of
    ErrC _ => Nothing
    OkC p =>
      case p.parsedFile.sourceFileDecls of
        [DFun _ _ body _] => Just (cstIndexOf p.parsedCst, body)
        _ => Nothing

-- | 表达式节点的括号层数。
depthOf : CstIndex -> Expr -> Int
depthOf ix e = parenDepthOfIndex ix (nodeRefId (exprRef e))

-- | 表达式节点是不是中缀链步：符号名作函数的 2 参应用（前缀写法必须加括号，所以只可能
-- 来自中缀降级），或节点字段里记下的反引号写法。
infixStep : CstIndex -> Expr -> Bool
infixStep ix e =
  case sectionOfIndex ix (exprSpan e) of
    Just _ => False
    Nothing =>
      case e of
        EApp (EVar op _) ([_, _]) _ => isSymbolName op || infixBacktick ix e
        EApp (EVar _ _) ([_, _]) _ => infixBacktick ix e
        _ => False

-- | 表达式节点是不是反引号写的链步。
infixBacktick : CstIndex -> Expr -> Bool
infixBacktick ix e = backtickOfIndex ix (nodeRefId (exprRef e))

-- | `(a)`：包装节点，1 层。
wrappedOk : Bool
wrappedOk =
  case parseBody "(a)" of
    Just (s, body) => depthOf s body == 1
    Nothing => False

-- | `((a))`：两层包装叠在同一个区间根上。
nestedOk : Bool
nestedOk =
  case parseBody "((a))" of
    Just (s, body) => depthOf s body == 2
    Nothing => False

-- | `(f a) b`：函数位置的括号（原子位置，不另开表达式节点）。
fnParenOk : Bool
fnParenOk =
  case parseBody "(f a) b" of
    Just (s, body) =>
      case body of
        EApp fn args _ => depthOf s fn == 1 && depthOf s body == 0
        _ => False
    Nothing => False

-- | `f (a)`：实参位置的括号。
argParenOk : Bool
argParenOk =
  case parseBody "f (a)" of
    Just (s, body) =>
      case body of
        EApp _ (arg :: _) _ => depthOf s arg == 1
        _ => False
    Nothing => False

-- | `(a, b)`：元组自带括号，但不是「表达式被括号包住」。
tupleOk : Bool
tupleOk =
  case parseBody "(a, b)" of
    Just (s, body) =>
      case body of
        EApp _ args _ => depthOf s body == 0 && allZero s args
        _ => False
    Nothing => False

allZero : CstIndex -> List Expr -> Bool
allZero s [] = True
allZero s (e :: rest) = depthOf s e == 0 && allZero s rest

-- | `a * (b + c)`：右操作数是括号边界（重排不能把它并进链）。
infixRhsOk : Bool
infixRhsOk =
  case parseBody "a * (b + c)" of
    Just (s, body) =>
      case body of
        EApp (EVar "*" _) ([l, r]) _ => depthOf s l == 0 && depthOf s r == 1 && infixStep s body
        _ => False
    Nothing => False

-- | `(a + b) * c`：中缀链左端也能认出括号（这里没有包装节点）。
infixLhsOk : Bool
infixLhsOk =
  case parseBody "(a + b) * c" of
    Just (s, body) =>
      case body of
        EApp (EVar "*" _) ([l, r]) _ => depthOf s l == 1 && depthOf s r == 0
        _ => False
    Nothing => False

-- | 链步登记：`a * b` 的区间根在表面形状里是链步，普通应用 `f a` 不是。
infixShapeOk : Bool
infixShapeOk =
  case parseBody "a * b" of
    Just (s, body) =>
      case parseBody "f a" of
        Just (s2, app) => infixStep s body && not (infixStep s2 app)
        Nothing => False
    Nothing => False

-- | 反引号写法也记在表面形状里（``a `f` b``）。
backtickOk : Bool
backtickOk =
  case parseBody "a `f` b" of
    Just (s, body) => infixBacktick s body
    Nothing => False

-- | `(+)`：section 自带的括号不是表面括号。
sectionOk : Bool
sectionOk =
  case parseBody "(+)" of
    Just (s, body) =>
      case body of
        EVar name _ => name == "+" && depthOf s body == 0
        _ => False
    Nothing => False

-- | section 写法按区间起点登记，与 AST 构造子无关：op 值 / 左 / 右三种形态。
sectionShapeOk : Bool
sectionShapeOk =
  let
    leftOk =
      case parseBody "(+ 1)" of
        Just (s, body) =>
          case sectionOfIndex s (exprSpan body) of
            Just (SectionLeft "+") => True
            _ => False
        Nothing => False
    rightOk =
      case parseBody "(1 +)" of
        Just (s, body) =>
          case sectionOfIndex s (exprSpan body) of
            Just (SectionRight "+") => True
            _ => False
        Nothing => False
    opOk =
      case parseBody "(+)" of
        Just (s, body) =>
          case sectionOfIndex s (exprSpan body) of
            Just (SectionOp "+") => True
            _ => False
        Nothing => False
  in leftOk && rightOk && opOk

-- | section / 模板原子各自有 CST 表达式节点（表面事实以后挂在这些节点上）。
sectionNodeOk : Bool
sectionNodeOk =
  case parseTree "(+ 1)" of
    Just t => countExprNodes t >= 2
    Nothing => False

templateNodeOk : Bool
templateNodeOk =
  case parseTree "\"\"\"\${(a + b) * c}\"\"\"" of
    Just t => countExprNodes t >= 2
    Nothing => False

parseTree : String -> Maybe CstNode
parseTree src =
  let
    full = "x = " ++ src ++ "\n"
  in case parseSourceDetailed "<paren>" full of
    ErrC _ => Nothing
    OkC p => Just p.parsedCst

-- | 树 + 从树建的查询索引（事实在节点字段上）。
parseTreeSurface : String -> Maybe (CstIndex, CstNode)
parseTreeSurface src =
  case parseTree src of
    Nothing => Nothing
    Just tree => Just (cstIndexOf tree, tree)

-- | 先序找第一个满足谓词的节点。
findNode : (CstNode -> Bool) -> CstNode -> Maybe CstNode
findNode pred n = if pred n then Just n else findInKids pred (nodeChildren n)

findInKids : (CstNode -> Bool) -> List CstNode -> Maybe CstNode
findInKids pred [] = Nothing
findInKids pred (k :: rest) =
  case findNode pred k of
    Just n => Just n
    Nothing => findInKids pred rest

-- | 右 section 的写法挂在它自己的表达式节点上：节点 span 从运算符起，用这个 span 能查回
-- 同一条形状（不需要旁路的额外输入）。
rightSectionNodeOk : Bool
rightSectionNodeOk =
  case parseTreeSurface "(1 +)" of
    Just (surface, tree) =>
      let
        isRight : CstNode -> Bool
        isRight n =
          let
            surf = nodeSurface n
          in case surf.cstSection of
            Just (SectionRight _) => True
            _ => False
      in case findNode isRight tree of
        Nothing => False
        Just n =>
          case sectionOfIndex surface (nodeSpan n) of
            Just (SectionRight "+") => True
            _ => False
    Nothing => False

-- | 模板洞的子树挂在模板节点上（洞内节点不在主树的 children 里）。
holeOnTemplateNodeOk : Bool
holeOnTemplateNodeOk =
  case parseTreeSurface "\"\"\"\${(a + b) * c}\"\"\"" of
    Just (_, tree) => hasHoleTree tree
    Nothing => False

hasHoleTree : CstNode -> Bool
hasHoleTree n =
  case n of
    CstLeaf _ => False
    CstBranch _ _ _ surface kids => holeTreesPresent surface.cstHoleTrees || anyHoleTree kids

anyHoleTree : List CstNode -> Bool
anyHoleTree [] = False
anyHoleTree (k :: rest) = hasHoleTree k || anyHoleTree rest

holeTreesPresent : List CstNode -> Bool
holeTreesPresent [] = False
holeTreesPresent (_ :: _) = True

-- | 只从树派生的表面缓存也知道洞内括号（不需要洞的子解析再交一遍）。
holeFromTreeOk : Bool
holeFromTreeOk =
  case (parseBody "\"\"\"\${(a + b) * c}\"\"\"", parseTreeSurface "\"\"\"\${(a + b) * c}\"\"\"") of
    (Just (_, body), Just (surface, _)) =>
      case body of
        EInterp ((IPHole hole) :: _) _ =>
          case hole of
            EApp (EVar "*" _) ([l, r]) _ => depthOf surface l == 1 && depthOf surface r == 0
            _ => False
        _ => False
    _ => False

countExprNodes : CstNode -> Int
countExprNodes node =
  case node of
    CstLeaf _ => 0
    CstBranch kind _ _ _ kids => (if kindTagIsExpr kind then 1 else 0) + sumExprNodes kids

sumExprNodes : List CstNode -> Int
sumExprNodes [] = 0
sumExprNodes (n :: rest) = countExprNodes n + sumExprNodes rest

kindTagIsExpr : CstKind -> Bool
kindTagIsExpr CstExprKind = True
kindTagIsExpr _ = False

-- | `[a]`：方括号不是圆括号。
listOk : Bool
listOk =
  case parseBody "[a]" of
    Just (s, body) =>
      case body of
        EApp _ (elem :: _) _ => depthOf s body == 0 && depthOf s elem == 0
        _ => False
    Nothing => False

-- | `"""${(a + b) * c}"""`：洞内表达式的括号由洞的子解析派生，事实挂在模板节点上。
holeOk : Bool
holeOk =
  case parseBody "\"\"\"\${(a + b) * c}\"\"\"" of
    Just (s, body) =>
      case body of
        EInterp ((IPHole hole) :: _) _ =>
          case hole of
            EApp (EVar "*" _) ([l, r]) _ => depthOf s l == 1 && depthOf s r == 0
            _ => False
        _ => False
    Nothing => False

bit : Bool -> Int -> Int
bit ok w = if ok then w else 0

main : Int
main =
  bit wrappedOk 1
    + bit nestedOk 2
    + bit fnParenOk 4
    + bit argParenOk 8
    + bit tupleOk 16
    + bit infixRhsOk 32
    + bit infixLhsOk 64
    + bit sectionOk 128
    + bit listOk 256
    + bit holeOk 512
    + bit infixShapeOk 1024
    + bit backtickOk 2048
    + bit sectionShapeOk 4096
    + bit sectionNodeOk 8192
    + bit templateNodeOk 16384
    + bit rightSectionNodeOk 32768 + bit holeOnTemplateNodeOk 65536 + bit holeFromTreeOk 131072
