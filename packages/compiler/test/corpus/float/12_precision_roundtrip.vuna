-- 浮点值在核心求值里保持 double 精度：展示文本（12 位有效数字）只用于输出，
-- 不参与算术 / 比较。两条形状在「文本往返」实现下会与编译产物不一致：
--   * `1.0 / 3.0 * 3.0` 往返成 `0.999999999999`（产物是 `1.0`）；
--   * `0.1 + 0.2 == 0.3` 两侧都折成 `0.3`（产物按 IEEE 判 `False`）。
main : String
main =
  strFromFloat (1.0 / 3.0 * 3.0)
    ++ "|"
    ++ show (1.0 / 3.0 * 3.0 == 1.0)
    ++ "|"
    ++ show (0.1 + 0.2 == 0.3)
    ++ "|" ++ show ((0.1 + 0.2) - 0.3 == 0.0) ++ "|" ++ strFromFloat (0.0 - 1.0 / 3.0 * 3.0)
