-- 定义参数少于签名时不做 η 展开：body 的类型必须已经是剩余 Pi（`inc2 = inc`、`add2 = addFn`
-- 都是 body 本身就是函数值）。参数不足且 body 不是函数值时按普通类型不匹配报错。
inc : Int -> Int
inc x = x + 1

-- 零子句定义：body 是函数值，直接按签名检查（IR 里不额外生成闭包）。
inc2 : Int -> Int
inc2 = inc

addFn : Int -> Int -> Int
addFn x y = x + y

-- 两个剩余参数：同样 body 本身就是函数值。
add2 : Int -> Int -> Int
add2 = addFn

main : Int
main = inc2 1 + add2 2 3
