-- 高阶 kind + 一般约束泛化。`bindPair : m a -> m b -> m (Pair a b)` 的
-- 签名里 m 是类型构造器变量；调用点分别传入 Maybe 与 LList 的字典。
trait Monad m where
  (>>=) : m a -> (a -> m b) -> m b
  pure : a -> m a

data Maybe a : Type where
  Nothing : Maybe a
  Just : a -> Maybe a

data LList a : Type where
  LNil : LList a
  (::) : a -> LList a -> LList a

data Pair a b : Type where
  Pair : a -> b -> Pair a b

append : LList a -> LList a -> LList a
append LNil ys = ys
append (x :: xs) ys = x :: append xs ys

concatMap : (a -> LList b) -> LList a -> LList b
concatMap f LNil = LNil
concatMap f (x :: xs) = append (f x) (concatMap f xs)

instance Monad Maybe where
  (>>=) m f =
    case m of
      Nothing => Nothing
      Just x => f x
  pure x = Just x

instance Monad LList where
  (>>=) xs f = concatMap f xs
  pure x = x :: LNil

bindPair : m a -> m b -> m (Pair a b)
bindPair ma mb =
  do
    a <- ma
    b <- mb
    pure (Pair a b)

showM : Maybe (Pair Int Int) -> String
showM m =
  case m of
    Nothing => "Nothing"
    Just (Pair a b) => "Just " ++ strFromInt a ++ ":" ++ strFromInt b

showL : LList (Pair Int Int) -> String
showL LNil = "[]"
showL ((Pair a b) :: rest) = strFromInt a ++ ":" ++ strFromInt b ++ " " ++ showL rest

main : String
main = showM (bindPair (Just 1) (Just 2)) ++ "/" ++ showL (bindPair (1 :: 2 :: LNil) (3 :: LNil))
