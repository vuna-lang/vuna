-- 反例：do 模式绑定要求不可反驳模式；`Just x` 缺 `Nothing` 分支。
trait Monad m where
  (>>=) : m a -> (a -> m b) -> m b
  pure : a -> m a

data Maybe a : Type where
  Nothing : Maybe a
  Just : a -> Maybe a

instance Monad Maybe where
  (>>=) m f =
    case m of
      Nothing => Nothing
      Just x => f x
  pure x = Just x

main : Maybe Int
main =
  do
    Just x <- pure (Just 1)
    pure x
