-- 构造子包装的状态推进（lexer 形态：`Chars rest ...`）。
-- 第 0 个实参是 `Chars rest (p + 1)`：rest 的路径是 [0, 1]（Chars 字段 0 的
-- Cons 字段 1），首段 0 == 包装字段 0，所以「形参 cs 字段 0 的子树大小」严格下降。
-- （下降按路径判定：形参 cs 字段 0 的子树大小严格下降即通过。）
import Prelude

data Chars : Type where
  Chars : List Int -> Int -> Chars

data Tok : Type where
  TK : Int -> Tok

collect : Chars -> List Tok
collect (Chars [] p) = []
collect (Chars (c :: rest) p) = (::) (TK c) (collect (Chars rest (p + 1)))

main : Int
main = 0
