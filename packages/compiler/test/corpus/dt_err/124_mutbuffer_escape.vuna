-- MutBuffer：闭包把追加捕获进 `Eff []` 行时，缓冲条目的 `Member` 约束不成立（逃逸被拒）。
import Base.Effect.MutBuffer as MutBuffer
import Base.Effect.Core as Eff
import Base.Effect.Types
import Base.Trait.Monad
import Base.Data.Unit

leak : Unit -> Eff [] Unit
leak = MutBuffer.withMutBufferPure "x" (pure (\_ => MutBuffer.append@x "boom"))