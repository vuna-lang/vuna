-- MutDynArray：同名嵌套引入在 concrete 行前缀里重复，报 TC_DuplicateInstance。
import Base.Effect.MutDynArray as MutDynArray
import Base.Effect.Core as Eff
import Base.Trait.Monad

bad : Int
bad =
  MutDynArray.withMutDynArrayPure "x" (
      MutDynArray.withMutDynArray "x" (
          do
            MutDynArray.push 1
            MutDynArray.get 0
        )
    )