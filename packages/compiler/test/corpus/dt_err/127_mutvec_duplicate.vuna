-- MutVec：同名嵌套引入在 concrete 行前缀里重复，报 TC_DuplicateInstance。
import Base.Effect.MutVec as MutVec
import Base.Effect.Core as Eff
import Base.Data.Vec
import Base.Data.Fin
import Base.Trait.Monad

bad : Int
bad =
  MutVec.withMutVecPure "x" (VCons 0 Nil) (
      MutVec.withMutVec "x" (VCons 0 Nil) (
          do
            MutVec.set FZero 1
            MutVec.get FZero
        )
    )