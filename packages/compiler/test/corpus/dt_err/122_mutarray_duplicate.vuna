-- MutArray：同名嵌套引入在 concrete 行前缀里重复，报 TC_DuplicateInstance。
import Base.Effect.MutArray as MutArray
import Base.Effect.Core as Eff
import Base.Trait.Monad

bad : Int
bad =
  MutArray.withMutArrayPure "x" 1 0 (
      MutArray.withMutArray "x" 1 0 (
          do
            MutArray.set 0 1
            MutArray.get 0
        )
    )