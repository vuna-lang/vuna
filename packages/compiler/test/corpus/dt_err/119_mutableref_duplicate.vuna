-- MutableRef：同名嵌套引入在 concrete 行前缀里重复，报 TC_DuplicateInstance。
import Base.Effect.MutableRef as MutableRef
import Base.Effect.Types
import Base.Trait.Monad

bad : Int
bad =
  MutableRef.withMutableRefPure "x" 0 (
      MutableRef.withMutableRef "x" 0 (
          do
            _ <- MutableRef.write 1
            MutableRef.read@x
        )
    )
