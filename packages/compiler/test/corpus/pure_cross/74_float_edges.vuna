-- Float 边界：`-0.0` 与 `0.0` 相等但展示不同；NaN 与任何值（包括自己）比较都是 False；
-- 除零得到 inf；`intFromFloat` 向零截断。
import Base.Data.Float as Float
import Base.Data.List as List
import Base.Data.String as String

nan : Float
nan = 0.0 / 0.0

inf : Float
inf = 1.0 / 0.0

negInf : Float
negInf = 0.0 - (1.0 / 0.0)

zero : Float
zero = 0.0

-- 负零用 `(-1) * 0.0` 构造（`-1.0` 这样的负字面量在 wasm/native 会丢符号）。
negZero : Float
negZero = (0.0 - 1.0) * 0.0

main : String
main =
  unlines
    [show zero, show negZero, show (negZero == zero), show (negZero < zero), show nan, show (nan == nan), show (nan /= nan), show (nan < 1.0), show (1.0 < nan), show inf, show negInf, show (inf > 1000000.0), show (intFromFloat (0.0 - 2.7)), show (intFromFloat (0.0 - 2.0)), show (intFromFloat 2.7), show (floatFromInt 42), show (intFromFloat (floatFromInt (0 - 42))), show (abs (0.0 - 3.5)), show (abs 3.5), show (sqrt 16.0), show (sqrt 2.0)]
