-- 负数字面量必须原样（而不是被读成减法）：作实参、作集合元素、与正数混排、
-- 以及 Int / Float 两类字幕面。
import Base.Data.String as String

main : String
main =
  let
    ints = [(-3), (-1), 0, 1]
    floats = [(-1.5), (-1.0), (-0.0), 0.0]
  in String.join
    ","
    [show (-7), strFromInt (-9), show (10 + (-3)), show (10 - (-3)), show ((-2) * (-3)), String.join "/" (map show ints), show (map show floats)]
