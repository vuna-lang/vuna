-- `bracket` 的 release 恰好执行一次：正常返回一次、abort 一次（不同 bracket），
-- 且 abort 路径的退出钩子不会与带内 pop 重复执行。
import Base.Effect.Core as Eff
import Base.Effect.Types
import Base.Effect.Exn as EffExn
import Base.Effect.MutRef as MutRef
import Base.Data.Result as Result
import Base.Trait.Monad
import Base.Trait.Num

bump : {r : Row} -> {w : Member (Named "n" (MutRefOp Int)) r} -> Eff r Int
bump =
  do
    v <- MutRef.read@n
    MutRef.write@n (v + 1)
    pure (v + 1)

main : Int
main =
  MutRef.withMutRefPure "n" 0 (
      do
        _ <- runExn "boom" (bracket (pure 0) (\_ => bump) (\_ => pure 5))
        _ <- runExn "boom" (bracket (pure 0) (\_ => bump) (\_ => throwExn "boom" "x"))
        MutRef.read
    )
