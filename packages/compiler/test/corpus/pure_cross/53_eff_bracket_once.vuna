-- `bracket` 的 release 恰好执行一次：正常返回一次、abort 一次（不同 bracket），
-- 且 abort 路径的退出钩子不会与带内 pop 重复执行。
import Base.Effect.Core as Eff
import Base.Effect.Mut
import Base.Container.MutRef as MutRef
import Base.Effect.Exn as EffExn
import Base.Data.Result as Result
import Base.Trait.Monad
import Base.Trait.Num

bump : {r : Row} -> {w : Member MutOp r} -> MutRef Int -> Eff r Int
bump counter =
  do
    v <- MutRef.read counter
    MutRef.write counter (v + 1)
    pure (v + 1)

main : Int
main =
  MutRef.withMutRefPure 0 (\counter =>
      do
        _ <- runExn "boom" (bracket (pure 0) (\_ => bump counter) (\_ => pure 5))
        _ <- runExn "boom" (bracket (pure 0) (\_ => bump counter) (\_ => throwExn "boom" "x"))
        MutRef.read counter
  )