-- `Base.Effect.Core.handleSelf`：`Try` 的子计算在同一 exn handler 下重跑（无 fuel）。
import Base.Effect.Core as Eff
import Base.Effect.Exn as EffExn
import Base.Data.Nat as Nat
import Base.Data.Result as Result

prog : Eff [ExnOp@boom] Nat
prog =
  do
    r <- tryWith "boom" (throwExn "boom" "inner")
    case r of
      Ok n => pure n
      Err _ => pure 7

main : Nat
main =
  case runPure (runExn "boom" prog) of
    Ok n => n
    Err _ => 0
