-- 名字编码的卫生性：`@vuna@` 是保留命名空间，`#` 合成名源码根本写不出。
--
-- 两个前缀都不能作为标识符起始字符：`#…` 在词法期直接报错；`@` 只有紧跟 `vuna@`
-- 时才并入同一个标识符（`@foo` 仍是运算符 + 名字）。这两条是「编译器合成的名字不会
-- 与用户名字撞车」的唯一依据，改词法时先看这里。
import Base
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Reserved
import Base.Effect.Console
import Base.Effect.Exit

main : Eff [ConsoleOp, ExitOp] String
main =
  case filter (\p => not (secondOf p)) results of
    [] => pure ""
    bad =>
      do
        _ <- consolePrint ("reserved names failed: " ++ join "; " (map firstOf bad) ++ "\n")
        _ <- exitWith 1
        pure ""

results : List (Pair String Bool)
results =
  [
    Pair "synth-prefix" (synthNamePrefix == "#"),
    Pair "synth-ctors-are-synth" (allTrue (map isSynthName synthSamples)),
    Pair "user-name-not-synth" (not (isSynthName "section")),
    Pair "synth-not-internal" (not (isInternalSyntaxName sectionBinderName)),
    Pair "internal-not-synth" (not (isSynthName (reservedText (RsMacro "dbg")))),
    Pair "reserved-roundtrip" (allTrue (map reservedRoundtrip allReserved)),
    Pair
      "reserved-not-intrinsic"
      (not (isSurfaceName "@vuna@prim_eff_print" || isSurfaceName "@vuna@Cell" || isSurfaceName "@vuna@obs@level" || isSurfaceName "@vuna@do@pat")),
    Pair
      "parser-surface-narrow"
      (isParserSurface RsListNil && isParserSurface RsPerform && isParserSurface RsHandle && isParserSurface RsRowAt && isParserSurface RsAppAt && not (isParserSurface (RsOverCtor "X" ["A.B.C"])) && not (isParserSurface (RsOverValue "f" ["A.B.g"])) && not (isParserSurface (RsMacro "dbg")) && not (isParserSurface (RsDoBind "Base.Trait.Monad.bind"))),
    Pair "hash-not-ident-start" (not (isIdentStart 35)),
    Pair "hash-not-ident-char" (not (isIdentChar 35)),
    Pair "at-not-ident-start" (not (isIdentStart 64)),
    Pair "at-not-ident-char" (not (isIdentChar 64)),
    Pair "lex-hash-name-rejected" (lexRejected "#section"),
    Pair "lex-user-name-accepted" (lexAccepted "section"),
    Pair "lex-internal-name-one-token" (lexAccepted "@vuna@consolePrint"),
    Pair "lex-at-op-accepted" (lexAccepted "x@y")
  ]

synthSamples : List String
synthSamples =
  [
    sectionBinderName,
    dictBinderName 0,
    dictBinderName 12,
    etaBinderName 1,
    teleProbeBinderName,
    ovProbeName 2
  ]

-- 每个表面标记各一个样本（带载荷形态覆盖有载荷 / 空载荷两种）。
allReserved : List Reserved
allReserved =
  [
    RsListNil,
    RsListCons,
    RsTuplePair,
    RsTupleUnit,
    RsAscribe,
    RsPerform,
    RsHandle,
    RsHandleNoRet,
    RsRowAt,
    RsAppAt,
    RsInstArg,
    RsOverCtor "Foo" ["A.B.C", "D.E.F"],
    RsOverCtor "Foo" [],
    RsOverValue "f" ["A.B.g", "C.D.h"],
    RsMacro "dbg",
    RsDoBind "Base.Trait.Monad.bind",
    RsDoIgnore "Base.Trait.Monad.bind"
  ]

-- | 线上编码与分类互逆（`reservedText` / `classify` 是唯一一对编解码）。
reservedRoundtrip : Reserved -> Bool
reservedRoundtrip r =
  case classify (reservedText r) of
    Just r2 => reservedText r2 == reservedText r
    Nothing => False

-- | 名字是否是表面标记（`classify` 认出的形态）。
isSurfaceName : String -> Bool
isSurfaceName name =
  case classify name of
    Just _ => True
    Nothing => False

allTrue : List Bool -> Bool
allTrue [] = True
allTrue (b :: rest) = b && allTrue rest

lexAccepted : String -> Bool
lexAccepted src =
  case lexSource src of
    OkC _ => True
    ErrC _ => False

-- `#` 既不是标识符字符也不是运算符字符：词法期就报 `LX_UnexpectedCharacter`。
lexRejected : String -> Bool
lexRejected src =
  case lexSource src of
    OkC _ => False
    ErrC d => d.diagCode == "LX_UnexpectedCharacter"
