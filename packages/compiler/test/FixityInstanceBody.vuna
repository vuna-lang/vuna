-- instance 体只允许方法签名与方法子句（parser 用 `ExpectedInstanceMethod` 挡其它形状）。
-- 若 AST 被别的路径塞进别的 Decl，重排这一步要报内部不变量违例，而不是原样放行到后续 pass。
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Base.Common
import Base
import Base.Effect.Console
import Base.Effect.Exit

main : Eff [ConsoleOp, ExitOp] String
main =
  case reorderProgram (tableOf emptyFixityFacts []) [badInstance] of
    ErrC d =>
      if d.diagCode == "IC_InvariantViolated" then
        pure ""
      else
        do
          _ <- consolePrint ("unexpected diagnostic: " ++ d.diagCode ++ "\n")
          _ <- exitWith 1
          pure ""
    OkC _ =>
      do
        _ <- consolePrint "instance body with a non-method declaration was accepted\n"
        _ <- exitWith 1
        pure ""

badInstance : Decl
badInstance =
  DInstance [] (EVar "C" noNodeRef) [DAxiom "x" (EVar "Int" noNodeRef) noNodeRef] noNodeRef
