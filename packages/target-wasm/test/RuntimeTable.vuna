-- wasm 运行时符号表 ↔ `Ir.Runtime` 契约（CG-17）。
--
-- 两道门禁：
--   1. 契约声明了 arity 的符号（`irInlineArity > 0`）必须由同一 arity 的 `RtFunc` 实现；
--      `RtValue` 落在会被应用的位置会静默退化成部分应用。
--   2. 未实现的符号必须逐条登记在 `runtimeGaps`：新增契约符号不能悄悄缺席，关闭缺口
--      时要删掉登记项（否则本测试报「listed as a gap but implemented」）。
--
-- 缺口语义与理由见 docs/reference/wasm.md §8。
import Base
import Base.Data.List as List
import Base.Effect.Core
import Base.Effect.Console
import Base.Effect.Exit
import Vuna.Ir.Model
import Vuna.Ir.Runtime
import Vuna.Target.Wasm.Runtime

main : Eff [ConsoleOp, ExitOp] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- consolePrint ("wasm runtime table drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- exitWith 1
        pure ""

problems : List String
problems =
  append
    (append (append (concatMap arityProblems irRtNames) missingProblems) extraProblems)
    permanentProblems

-- 契约 arity > 0 时，后端表必须给出同一个 arity。
arityProblems : String -> List String
arityProblems sym =
  let
    a = irInlineArity sym
  in if a <= 0 then
    []
  else
    case rtImplOf sym of
      RtFunc n _ => if n == a then [] else ["arity " ++ sym ++ ": table " ++ strFromInt n ++ ", contract " ++ strFromInt a]
      RtValue _ => ["shape " ++ sym ++ ": value where contract arity is " ++ strFromInt a]
      RtUnsupported => ["arity " ++ sym ++ ": not implemented"]

missingProblems : List String
missingProblems =
  map
    (\sym => "not implemented and not listed: " ++ sym)
    (filter (\sym => not (memName sym runtimeGaps)) (filter (\sym => not (memName sym permanentUnsupported)) gaps))

extraProblems : List String
extraProblems =
  map
    (\sym => "listed as a gap but implemented: " ++ sym)
    (filter (\sym => not (memName sym gaps)) runtimeGaps)

-- 同步原语（Mutex / Condvar / Atomic）是 wasm 的**明确非目标**（单线程下无意义），
-- 不是待补缺口。每条必须在契约里且仍然 `RtUnsupported`；实现了或拼错名字都在这里显形。
-- 调度子集（spawn / join / yield / id / parallelism）不在此列：wasm 上按单线程顺序退化。
permanentProblems : List String
permanentProblems =
  concatMap
    (\sym => if not (irRtIsKnown sym) then ["permanent-unsupported symbol missing from contract: " ++ sym] else if isGap sym then [] else ["permanent-unsupported symbol is implemented: " ++ sym])
    permanentUnsupported

permanentUnsupported : List String
permanentUnsupported =
  [
    "@vuna@prim_eff_mutexNew",
    "@vuna@prim_eff_mutexLock",
    "@vuna@prim_eff_mutexTryLock",
    "@vuna@prim_eff_mutexUnlock",
    "@vuna@prim_eff_condvarNew",
    "@vuna@prim_eff_condvarWait",
    "@vuna@prim_eff_condvarSignal",
    "@vuna@prim_eff_condvarBroadcast",
    "@vuna@prim_eff_atomicNew",
    "@vuna@prim_eff_atomicLoad",
    "@vuna@prim_eff_atomicStore",
    "@vuna@prim_eff_atomicFetchAdd",
    "@vuna@prim_eff_atomicExchange",
    "@vuna@prim_eff_atomicCompareExchange"
  ]

gaps : List String
gaps = filter isGap irRtNames

isGap : String -> Bool
isGap sym =
  case rtImplOf sym of
    RtUnsupported => True
    _ => False

-- 当前未实现（`RtUnsupported`）的契约符号；按契约声明顺序排列。
runtimeGaps : List String
runtimeGaps =
  [
    "prim_effectPerformId",
    "prim_effectHandleId",
    "prim_effectSelf",
    "prim_schedNewScope",
    "prim_schedFork",
    "prim_schedYield",
    "prim_schedIsCancelled",
    "prim_schedAwait",
    "prim_schedTaskResult",
    "prim_schedTaskError",
    "prim_schedCancelTask",
    "prim_schedCancelScope",
    "prim_schedScopeWait",
    "prim_schedScopeWaitTimeout",
    "prim_schedScopeError",
    "prim_schedScopeCount",
    "strFromFloat",
    "effTimeUs",
    "@vuna@host@tryNetListen",
    "@vuna@host@tryNetPort",
    "@vuna@host@tryNetAccept",
    "@vuna@host@tryNetRecv",
    "@vuna@host@tryNetSend",
    "@vuna@host@tryNetClose",
    "@vuna@host@tryNetConnect",
    "@vuna@host@tryNetAcceptWithin",
    "@vuna@host@tryNetRecvWithin",
    "@vuna@host@tryNetSendWithin",
    "@vuna@prim_eff_runIn",
    "@ir@showFloat"
  ]
