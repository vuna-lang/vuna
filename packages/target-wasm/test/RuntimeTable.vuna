-- wasm 运行时符号表 ↔ `Ir.Runtime` 契约（CG-17）。
--
-- 两道门禁：
--   1. 契约声明了 arity 的符号（`irInlineArity > 0`）必须由同一 arity 的 `RtFunc` 实现；
--      `RtValue` 落在会被应用的位置会静默退化成部分应用。
--   2. 未实现的符号必须逐条登记在 `runtimeGaps`：新增契约符号不能悄悄缺席，关闭缺口
--      时要删掉登记项（否则本测试报「listed as a gap but implemented」）。
--
-- 缺口语义与理由见 docs/reference/wasm.md §8。
import Base
import Base.Data.List as List
import Base.Effect.Core
import Base.Effect.Console
import Base.Effect.Exit
import Vuna.Ir.Model
import Vuna.Ir.Runtime
import Vuna.Target.Wasm.Runtime

main : Eff [ConsoleOp, ExitOp] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- consolePrint ("wasm runtime table drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- exitWith 1
        pure ""

problems : List String
problems = append (append (concatMap arityProblems irRtNames) missingProblems) extraProblems

-- 契约 arity > 0 时，后端表必须给出同一个 arity。
arityProblems : String -> List String
arityProblems sym =
  let
    a = irInlineArity sym
  in if a <= 0 then
    []
  else
    case rtImplOf sym of
      RtFunc n _ => if n == a then [] else ["arity " ++ sym ++ ": table " ++ strFromInt n ++ ", contract " ++ strFromInt a]
      RtValue _ => ["shape " ++ sym ++ ": value where contract arity is " ++ strFromInt a]
      RtUnsupported => ["arity " ++ sym ++ ": not implemented"]

missingProblems : List String
missingProblems =
  map
    (\sym => "not implemented and not listed: " ++ sym)
    (filter (\sym => not (memName sym runtimeGaps)) gaps)

extraProblems : List String
extraProblems =
  map
    (\sym => "listed as a gap but implemented: " ++ sym)
    (filter (\sym => not (memName sym gaps)) runtimeGaps)

gaps : List String
gaps = filter isGap irRtNames

isGap : String -> Bool
isGap sym =
  case rtImplOf sym of
    RtUnsupported => True
    _ => False

-- 当前未实现（`RtUnsupported`）的契约符号；按契约声明顺序排列。
runtimeGaps : List String
runtimeGaps =
