-- | lint 的规则实现：AST 驱动的 dispatch 规则（`literal-if-chain`、`dispatch-lift`）与字面量
-- 归一规则（`list-literal`、`pair-sugar`、`nat-literal`），以及从源码切片的辅助工具。
--
-- `lintSourceWith` 先 parseSource 得到 AST，规则判定全部走 AST；需要源码原文（字面量、模式、
-- 分支体）时用 span 加 token 边界从源码切片，不重新渲染字符串字面量。产出的编辑用行范围表示
-- （起始行、结束行、替换行），由 [Vuna.Lint.Fix] 应用。源码原文与 token 边界来自同一次词法
-- （`parseSourceDetailed`），不再为切片单独词法。
--
-- 改写目标统一为「把 dispatch 提升进外层模式」。`literal-if-chain` 处理 if 分派（`x == 字面量`
-- 链，或 Bool 变量的 if/else-if）：scrutinee 是外层 clause/alt 的模式变量时提升成多条 clause
-- 或更细的 alt，字面量链提升不了时回退成 case。`dispatch-lift` 处理 case / let 分派：单 alt
-- 替换外层变量，多 alt 拆 clause 或拆 alt。`list-literal` 把表达式与类型位置的闭合 cons 链
-- （`::` / `Cons` 加 `[]` / `Nil`）以及裸 `Nil` 改写成 `[a, b]` / `[]`，模式匹配不动。
-- `pair-sugar` 把表达式 / 类型 / 模式位置的显式 `Pair` 应用改写成元组语法 `(a, b)`。
-- `nat-literal` 把表达式 / 类型 / 模式位置的闭合 `Zero` / `Succ` 链改写成十进制字面量，
-- 开放链（`Succ n`）与带模块前缀的名字不动。
--
-- 提升只发生在 clause/alt 的直接体上；嵌在表达式里的 dispatch 需要 case-of-case 上下文分发，
-- 会复制代码，因此不做。clause 拆分要求该名字只有一条 clause，alt 拆分/替换要求该 alt 是最后
-- 一个，判据不满足时只报告、不给编辑。
--
-- 候选按（行, 列）排序，编辑范围被更大编辑包含的内层 finding 会被丢弃，避免同一条链或同一次
-- 折叠产生互相冲突的编辑。
module Vuna.Lint.Rules where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser
import Vuna.Lint.Config
import Vuna.Lint.Diagnostics
import Vuna.Lint.Suppress

-- | 源码上下文：原文、行表、行首偏移与 token 流。文本切片只走字节偏移。
record LintSrc where
  lintSrcText : String
  lintSrcLines : List String
  lintSrcToks : List PTok
  lintSrcLineStarts : List Int

-- | 构造源码上下文（行表仍供 edit 行范围渲染；span 切片走偏移）。
mkLintSrc : String -> List PTok -> LintSrc
mkLintSrc source toks = LintSrc source (splitLines source) toks (lineStartsOf source)

-- | 内部：每行行首字节偏移（0 基，第一行 0）。
lineStartsOf : String -> List Int
lineStartsOf source = reverse (lineStartsGo (strUnpack source) 0 [0])

lineStartsGo : List Int -> Int -> List Int -> List Int
lineStartsGo [] _ acc = acc
lineStartsGo (c :: rest) i acc =
  if c == 10 then lineStartsGo rest (i + 1) (i + 1 :: acc) else lineStartsGo rest (i + 1) acc

-- | 内部：第 n 个元素（0 基；越界给默认值）。
nthInt : Int -> List Int -> Int -> Int
nthInt n [] d = d
nthInt n (x :: rest) d = if n <= 0 then x else nthInt (n - 1) rest d

-- | 内部：行列 → 字节偏移（列 1 基、UTF-8 字节）。
offsetOfLineCol : LintSrc -> Int -> Int -> Int
offsetOfLineCol src line col = nthInt (line - 1) src.lintSrcLineStarts 0 + (col - 1)

-- | 内部：从 start 取到 end（开区间）。
sliceOffsets : LintSrc -> Int -> Int -> String
sliceOffsets src start end =
  if end <= start then "" else strSubstring start (end - start) src.lintSrcText

-- | 内部：起点字节偏移上的 token；没有给 `Nothing`。
tokenAtOffset : LintSrc -> Int -> Maybe PTok
tokenAtOffset src off = tokenAtOffsetGo off src.lintSrcToks

tokenAtOffsetGo : Int -> List PTok -> Maybe PTok
tokenAtOffsetGo off [] = Nothing
tokenAtOffsetGo off (t :: rest) =
  if posOffset t.ptokPos == off then Just t else tokenAtOffsetGo off rest

-- | 内部：span 右边界（落在末 token 的起点）→ 该 token 的结束偏移。
-- 先找「起点正好等于 off」的 token：紧贴前一个 token 的符号（`]` / `)`）与前一个
-- token 之间没有空白，只按区间覆盖判断会命中前一个 token，把右边界停在符号之前
-- （`[1, 2]` 被切成 `[1, 2`）。找不到精确起点时才回落到区间覆盖。
tokenEndAt : LintSrc -> Int -> Int
tokenEndAt src off =
  case tokenAtOffset src off of
    Just t => posEndOffset t.ptokPos
    Nothing => tokenEndCovering off src.lintSrcToks

tokenEndCovering : Int -> List PTok -> Int
tokenEndCovering off [] = off
tokenEndCovering off (t :: rest) =
  if posOffset t.ptokPos <= off && posEndOffset t.ptokPos >= off then
    posEndOffset t.ptokPos
  else
    tokenEndCovering off rest

-- | 内部：起点严格大于 off 的第一个 token。
nextTokenAfterOffset : LintSrc -> Int -> Maybe PTok
nextTokenAfterOffset src off = nextTokenAfterOffsetGo off src.lintSrcToks

nextTokenAfterOffsetGo : Int -> List PTok -> Maybe PTok
nextTokenAfterOffsetGo off [] = Nothing
nextTokenAfterOffsetGo off (t :: rest) =
  if posOffset t.ptokPos > off then Just t else nextTokenAfterOffsetGo off rest

-- | 内部：工具链 fuel 耗尽说明内部不变量被破坏，按硬失败处理（与编译器一致）。
lintFuelExhausted : String -> a
lintFuelExhausted what = prim_fail "vuna: internal: lint ${what} fuel exhausted"

-- | 一次源码改写：把 1 基行区间 `[editStart, editEnd]` 整体替换成 `editLines`。
export record Edit(..) where
  -- | 替换区间的起始行（1 基，含）。
  editStart : Int
  -- | 替换区间的结束行（1 基，含）。
  editEnd : Int
  -- | 替换后的完整行（不含行尾换行）。
  editLines : List String

-- | 一条 lint 结果：位置、规则标识、消息、严重度，以及可选的自动修复。
export record Finding(..) where
  -- | finding 所在行（1 基）。
  findingLine : Int
  -- | finding 所在列（1 基）。
  findingCol : Int
  -- | finding 结束行（1 基；LSP/JSON 用）。
  findingEndLine : Int
  -- | finding 结束列（1 基、开区间；LSP/JSON 用）。
  findingEndCol : Int
  -- | 规则的稳定符号（`LN_` 前缀）。
  findingCode : String
  -- | 规则的 kebab 短名（CLI 输出用）。
  findingRule : String
  -- | 人读消息，由 [Vuna.Lint.Diagnostics] 的消息模板生成。
  findingMessage : String
  -- | 规则的严重度（配置可覆盖；off 的 finding 不会产出）。
  findingSeverity : LintSeverity
  -- | 可自动修复时的编辑方案；`Nothing` 表示只能报告。
  findingEdit : Maybe Edit

-- | 外层模式上下文：候选提升的目标位置。
--
-- `LClause` 是顶层子句（`isSingle` 标记该名字是否只有一条 clause，`isLast` 标记是否最后
-- 一条）；`LAlt` 是 case 的一个 alt（`isLast` 标记是否最后一个 alt）。
data Lane : Type where
  -- | 顶层 clause：head 行号、clause 的模式列表、是否最后一条、是否该名字唯一的 clause。
  LClause : Int -> List Pat -> Bool -> Bool -> Lane
  -- | case 的 alt：head 行号、alt 模式、是否最后一个 alt。
  LAlt : Int -> Pat -> Bool -> Lane

-- | 字面量 if 链的一个分支：匹配的字面量原文、then 分支原文、then 表达式。
record ChainItem where
  -- | 该分支比较的字面量原文（如 `"a"`、`1`）。
  chainItemLit : String
  -- | then 分支的源码原文；无法单行切片时为空串。
  chainItemThenText : String
  -- | then 分支的表达式。
  chainItemThen : Expr

-- | 字面量 if 链的提取结果：scrutinee 名、各分支、default 分支的模式与表达式。
record ChainRes where
  -- | 链上所有条件共同比较的变量名。
  chainResName : String
  -- | 按源码顺序排列的分支。
  chainResItems : List ChainItem
  -- | default 分支的模式原文；提取不到时为 `"_"`。
  chainResDefaultPat : String
  -- | default 分支的源码原文。
  chainResDefaultText : String
  -- | default 分支的表达式。
  chainResDefaultExpr : Expr

-- | 内部：遍历与位置扫描的 fuel 初值；递归函数每层递减，耗尽即硬失败。
lintFuel : Int
lintFuel = 1000000

-- | 列表是否为空：判定某个 alt 或 clause 是不是最后一个。
export isNilList : List a -> Bool
isNilList [] = True
isNilList (x :: rest) = False

-- | 内部：列表是否至少有两个元素。
atLeastTwo : List a -> Bool
atLeastTwo (x :: y :: rest) = True
atLeastTwo _ = False

-- ---------------------------------------------------------------
-- 行 / 字符工具
-- ---------------------------------------------------------------
-- | 内部：字符码是否为空格或制表符。
isSpaceChar : Int -> Bool
isSpaceChar c = c == 32 || c == 9

-- | 内部：n 个空格字符的列表（n <= 0 时为空）。
spaceChars : Int -> List Int
spaceChars n = if n <= 0 then [] else 32 :: spaceChars (n - 1)

-- | 内部：n 个空格组成的字符串。
spaces : Int -> String
spaces n = strPack (spaceChars n)

-- | 内部：行首缩进宽度（空格与制表符各算一列）。
indentOf : String -> Int
indentOf line = indentChars (strUnpack line)

-- | 内部：从行首字符数缩进，遇到非空白字符即停。
indentChars : List Int -> Int
indentChars [] = 0
indentChars (c :: rest) =
  case c of
    32 => 1 + indentChars rest
    9 => 1 + indentChars rest
    _ => 0

-- | 内部：字符序列是否全为空白。
blankChars : List Int -> Bool
blankChars [] = True
blankChars (c :: rest) = isSpaceChar c && blankChars rest

-- | 按换行切分源码；每行不含换行符，末尾换行会补出一个空行。
export splitLines : String -> List String
splitLines source = splitLinesFrom (strUnpack source) [] []

-- | 内部：`splitLines` 的累加器实现（当前行按字符逆序累积）。
splitLinesFrom : List Int -> List String -> List Int -> List String
splitLinesFrom [] acc cur = reverse (strPack (reverse cur) :: acc)
splitLinesFrom (c :: rest) acc cur =
  if c == 10 then
    splitLinesFrom rest (strPack (reverse cur) :: acc) []
  else
    splitLinesFrom rest acc (c :: cur)

-- | `splitLines` 的逆操作：单元素不追加换行，避免以换行结尾的源码每轮修复都多写一个行尾换行。
export joinLines : List String -> String
joinLines [] = ""
joinLines ([line]) = line
joinLines (line :: rest) = "${line}\n${joinLines rest}"

-- | 内部：取第 n 行（1 基）；越界返回空串。
nthLine : List String -> Int -> String
nthLine [] n = ""
nthLine (line :: rest) n = if n <= 1 then line else nthLine rest (n - 1)

-- | 内部：按 1 基行号取行（`nthLine` 的同义入口）。
lineAt : List String -> Int -> String
lineAt lines n = nthLine lines n

-- | 内部：前 n 个元素（n <= 0 时为空）。
takeChars : Int -> List a -> List a
takeChars n [] = []
takeChars n (c :: rest) = if n <= 0 then [] else c :: takeChars (n - 1) rest

-- | 内部：去掉前 n 个元素。
dropChars : Int -> List a -> List a
dropChars n chars =
  if n <= 0 then
    chars
  else
    case chars of
      [] => []
      c :: rest => dropChars (n - 1) rest

-- | 内部：从 start 起取 count 个元素。
sliceChars : Int -> Int -> List a -> List a
sliceChars start count chars = takeChars count (dropChars start chars)

-- | 内部：行内按字符位置切片（0 基起始、count 个字符）。
sliceLine : Int -> Int -> String -> String
sliceLine start count line = strPack (sliceChars start count (strUnpack line))

-- | 内部：去掉行首 n 个字符。
dropIndent : Int -> String -> String
dropIndent n line = strPack (dropChars n (strUnpack line))

-- | 内部：源码列 col（1 基）之前的行首部分。
prefixBeforeCol : String -> Int -> String
prefixBeforeCol line col = sliceLine 0 (col - 1) line

-- | 内部：从列 col（1 基，含该列字符）到行尾的原文。
tailFromCol : String -> Int -> String
tailFromCol line col = strPack (dropChars (col - 1) (strUnpack line))

-- | 内部：列区间 `[c1, c2)` 的原文（1 基、左闭右开）。
sliceBetween : String -> Int -> Int -> String
sliceBetween line c1 c2 = sliceLine (c1 - 1) (c2 - c1) line

-- | 内部：第 i 个字符码（0 基）；越界返回 0。
nthChar : Int -> List Int -> Int
nthChar i [] = 0
nthChar i (c :: rest) = if i <= 0 then c else nthChar (i - 1) rest

-- | 内部：去掉尾部空白后的长度。
trimLen : List Int -> Int -> Int
trimLen chars n =
  if n <= 0 then 0 else if isSpaceChar (nthChar (n - 1) chars) then trimLen chars (n - 1) else n

-- | 内部：去掉行尾空白。
trimEnd : String -> String
trimEnd line =
  strPack (takeChars (trimLen (strUnpack line) (length (strUnpack line))) (strUnpack line))

-- | 内部：字符序列 `p` 是否是 `text` 的前缀。
prefixChars : List Int -> List Int -> Bool
prefixChars [] text = True
prefixChars (p :: prest) text =
  case text of
    [] => False
    t :: trest => p == t && prefixChars prest trest

-- | 内部：字符序列里是否包含某个子串。
containsSubChars : List Int -> List Int -> Bool
containsSubChars pat [] = False
containsSubChars pat (text@(c :: rest)) = prefixChars pat text || containsSubChars pat rest

-- | 内部：字符序列里是否出现某个字符码。
containsChar : Int -> List Int -> Bool
containsChar c [] = False
containsChar c (x :: rest) = x == c || containsChar c rest

-- | 内部：行内是否出现 `--` 或 `{-`（含注释的行不参与自动修复）。
hasComment : String -> Bool
hasComment line =
  containsSubChars (strUnpack "--") (strUnpack line)
    || containsSubChars (strUnpack "{-") (strUnpack line)

-- | 内部：行内是否含制表符或回车（含则不自动修复）。
hasTabOrCR : String -> Bool
hasTabOrCR line = containsChar 9 (strUnpack line) || containsChar 13 (strUnpack line)

-- | 内部：去掉前 n 个元素（n <= 0 时原样返回）。
dropIndex : Int -> List a -> List a
dropIndex n lines =
  if n <= 0 then
    lines
  else
    case lines of
      [] => []
      x :: rest => dropIndex (n - 1) rest

-- | 内部：前 n 个元素（n <= 0 时为空）。
takeIndex : Int -> List a -> List a
takeIndex n lines =
  if n <= 0 then
    []
  else
    case lines of
      [] => []
      x :: rest => x :: takeIndex (n - 1) rest

-- | 内部：取 1 基闭区间 `[start, stop]` 的行。
rangeLines : List String -> Int -> Int -> List String
rangeLines lines start stop = takeIndex (stop - start + 1) (dropIndex (start - 1) lines)

-- | 内部：取行区间并统一去掉 n 个行首字符。
dedentRange : List String -> Int -> Int -> Int -> List String
dedentRange lines start stop n = map (\line => dropIndent n line) (rangeLines lines start stop)

-- | 内部：行区间内没有注释、制表符与回车（自动修复的先行条件）。
linesCleanRange : List String -> Int -> Int -> Bool
linesCleanRange lines start stop = linesCleanGo (rangeLines lines start stop)

-- | 内部：`linesCleanRange` 的逐行判定。
linesCleanGo : List String -> Bool
linesCleanGo [] = True
linesCleanGo (line :: rest) =
  if hasComment line || hasTabOrCR line then False else linesCleanGo rest

-- | 内部：把多行 body 按目标缩进重排：以 body 真实首行缩进为基准统一 dedent，再补 target
-- 个空格；body 与位置同行时只取该表达式本身的原文。
blockBodyLines : List String -> Expr -> Int -> List String
blockBodyLines lines body target =
  let
    start = exprStartLine body
    stop = spanEndLine (exprSpan body)
    startCol = exprStartCol body
    firstIndent = indentOf (lineAt lines start)
    inline = startCol > firstIndent + 1
    raw =
      if inline then
        append [tailFromCol (lineAt lines start) startCol] (rangeLines lines (start + 1) stop)
      else
        rangeLines lines start stop
  in case raw of
    [] => []
    first :: rest =>
      let
        firstText = if inline then first else dropIndent firstIndent first
      in append
        [spaces target ++ firstText]
        (map (\line => spaces target ++ dropIndent firstIndent line) rest)

-- ---------------------------------------------------------------
-- token 工具
-- ---------------------------------------------------------------
-- | 内部：token 的起始行。
tokLine : PTok -> Int
tokLine tok = posLine tok.ptokPos

-- | 内部：token 的起始列。
tokCol : PTok -> Int
tokCol tok = posCol tok.ptokPos

-- | 内部：token 是否是指定关键字的 `TKw`。
tokIsKw : PTok -> String -> Bool
tokIsKw (PTok (TKw x) p) key = x == key
tokIsKw _ key = False

-- | 内部：token 是标识符时取出名字。
tokIdentOf : PTok -> Maybe String
tokIdentOf (PTok (TIdent x) p) = Just x
tokIdentOf _ = Nothing

-- | 内部：token 是否是 EOF。
tokIsEof : PTok -> Bool
tokIsEof (PTok TEof p) = True
tokIsEof _ = False

-- | 内部：列表首元素（空列表为 `Nothing`）。
headToken : List a -> Maybe a
headToken [] = Nothing
headToken (t :: rest) = Just t

-- | 内部：按（行, 列）精确位置查 token（偏移不可用时的回落）。
tokenAt : List PTok -> Int -> Int -> Maybe PTok
tokenAt [] line col = Nothing
tokenAt (t :: rest) line col =
  if tokLine t == line && tokCol t == col then Just t else tokenAt rest line col

-- | 内部：token 的源码长度（行列路径回落用）。
tokLen : PTok -> Int
tokLen (PTok (TSym s) p) = strLength s
tokLen (PTok (TIdent s) p) = strLength s
tokLen (PTok (TKw s) p) = strLength s
tokLen (PTok (TInt n) p) = strLength (strFromInt n)
tokLen (PTok (TFloat raw) p) = strLength raw
tokLen (PTok (TStr s) p) = strLength s + 2
tokLen (PTok (TTmpl multi parts endP) p) = 0
tokLen (PTok TEof p) = 0

-- | 内部：按 span 查 token；偏移缺失时回落到行列。
tokenAtSpan : LintSrc -> Span -> Maybe PTok
tokenAtSpan src sp =
  case tokenAtOffset src (spanStartOffset sp) of
    Just t => Just t
    Nothing => tokenAt src.lintSrcToks (spanStartLine sp) (spanStartCol sp)

-- | 内部：旧行列路径的下一 token（仅用于偏移不完整的历史 span 回落）。
nextTokAfter : List PTok -> Int -> Int -> Maybe PTok
nextTokAfter [] line col = Nothing
nextTokAfter (t :: rest) line col =
  if tokLine t > line then
    Just t
  else if tokLine t == line && tokCol t > col then Just t else nextTokAfter rest line col

-- | 内部：span 的单行源码原文；右边界取 span 末 token 之后的下一个 token（或行尾），跨行
-- 时返回空串。
spanText : LintSrc -> Span -> String
spanText src sp =
  if spanStartLine sp /= spanEndLine sp then
    ""
  else
    let
      start = spanStartOffset sp
      end = tokenEndAt src (spanEndOffset sp)
    in if end <= start || start == 0 && spanStartLine sp > 1 then spanTextLine src sp else trimEnd (sliceOffsets src start end)

-- | 内部：行列路径的 span 文本（偏移不可用时的回落）。
spanTextLine : LintSrc -> Span -> String
spanTextLine src sp =
  let
    line = lineAt src.lintSrcLines (spanStartLine sp)
    col = spanStartCol sp
  in case nextTokAfter src.lintSrcToks (spanEndLine sp) sp.spanEndCol of
    Nothing => trimEnd (tailFromCol line col)
    Just t =>
      if tokIsEof t then
        trimEnd (tailFromCol line col)
      else if tokLine t == spanEndLine sp then
        trimEnd (sliceBetween line col (tokCol t))
      else
        trimEnd (tailFromCol line col)

-- | 内部：模式的单行源码原文。
patText : LintSrc -> Pat -> String
patText src pat = spanTextLine src (patSpan pat)

-- | 内部：span 是否落在同一行。
spanSingleLine : Span -> Bool
spanSingleLine sp = spanStartLine sp == spanEndLine sp

-- | 内部：表达式的真实起始位置。parser 给中缀表达式（`a + b`）的 span 从运算符开始，起点
-- 会比 `a` 晚，所以取整棵子树里最靠前的 span 起点。
exprStartPos : Expr -> (Int, Int)
exprStartPos e = startExpr lintFuel e

-- | 内部：两对坐标里按（行, 列）较小的一对。
minPair : (Int, Int) -> (Int, Int) -> (Int, Int)
minPair (a@(la, ca)) (b@(lb, cb)) = if la < lb then a else if la == lb && ca <= cb then a else b

-- | 内部：span 起点作为坐标对。
startFromSpan : Span -> (Int, Int)
startFromSpan sp = (spanStartLine sp, spanStartCol sp)

-- | 内部：按构造子递归求表达式的最小起始位置（覆盖中缀链、括号、section 等 parser 中间
-- 产物，不落到兜底坐标）。
startExpr : Int -> Expr -> (Int, Int)
startExpr fuel e =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case e of
      EVar n sp => startFromSpan (nodeRefSpan sp)
      EInt n sp => startFromSpan (nodeRefSpan sp)
      EStr s sp => startFromSpan (nodeRefSpan sp)
      EFloat raw sp => startFromSpan (nodeRefSpan sp)
      EInterp parts sp => startFromSpan (nodeRefSpan sp)
      ELam ps body sp => minPair (startFromSpan (nodeRefSpan sp)) (startExpr (fuel - 1) body)
      EApp fn args sp => minPair (startFromSpan (nodeRefSpan sp)) (minPair (startExpr (fuel - 1) fn) (startExprs (fuel - 1) args))
      EPi n implicit _ dom cod sp => minPair (startFromSpan (nodeRefSpan sp)) (minPair (startExpr (fuel - 1) dom) (startExpr (fuel - 1) cod))
      ELet binds body recFlag sp => minPair (startFromSpan (nodeRefSpan sp)) (minPair (startBinds (fuel - 1) binds) (startExpr (fuel - 1) body))
      ECase scrut alts sp => minPair (startFromSpan (nodeRefSpan sp)) (minPair (startExpr (fuel - 1) scrut) (startAlts (fuel - 1) alts))
      EIf c t el sp => minPair (startFromSpan (nodeRefSpan sp)) (minPair (startExpr (fuel - 1) c) (minPair (startExpr (fuel - 1) t) (startExpr (fuel - 1) el)))
      EField base f sp => minPair (startFromSpan (nodeRefSpan sp)) (startExpr (fuel - 1) base)
      ERecord rn fields sp => minPair (startFromSpan (nodeRefSpan sp)) (startFields (fuel - 1) fields)
      ERecUpdate base fields sp => minPair (startFromSpan (nodeRefSpan sp)) (minPair (startExpr (fuel - 1) base) (startFields (fuel - 1) fields))
      EDo stmts sp => minPair (startFromSpan (nodeRefSpan sp)) (startStmts (fuel - 1) stmts)

-- | 内部：一组表达式的最小起始位置；空列表返回极大坐标。
startExprs : Int -> List Expr -> (Int, Int)
startExprs fuel exprs =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case exprs of
      [] => (1000000000, 1000000000)
      e :: rest => minPair (startExpr (fuel - 1) e) (startExprs (fuel - 1) rest)

-- | 内部：record 字段值的最小起始位置。
startFields : Int -> List (String, Expr) -> (Int, Int)
startFields fuel fields =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case fields of
      [] => (1000000000, 1000000000)
      (f, e) :: rest => minPair (startExpr (fuel - 1) e) (startFields (fuel - 1) rest)

-- | 内部：单条绑定的最小起始位置（值 + 可选签名行；签名行自己的位置在签名节点上）。
bindingStart : Int -> Binding -> (Int, Int)
bindingStart fuel b =
  let
    valueStart =
      case b.bindValue of
        BVal e => startExpr (fuel - 1) e
        BClauses clauses =>
          minPair (startFromSpan (nodeRefSpan b.bindRef)) (startLocalClauses (fuel - 1) clauses)
    sigStart =
      case b.bindSig of
        Just sig =>
          minPair (startFromSpan (nodeRefSpan sig.sigRef)) (startExpr (fuel - 1) sig.sigType)
        Nothing => (1000000000, 1000000000)
  in minPair valueStart sigStart

-- | 内部：let 绑定右值的最小起始位置。
startBinds : Int -> List Binding -> (Int, Int)
startBinds fuel binds =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case binds of
      [] => (1000000000, 1000000000)
      b :: rest => minPair (bindingStart (fuel - 1) b) (startBinds (fuel - 1) rest)

-- | 内部：case alt 体的最小起始位置。
startAlts : Int -> List Alt -> (Int, Int)
startAlts fuel alts =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case alts of
      [] => (1000000000, 1000000000)
      a :: rest => minPair (startExpr (fuel - 1) a.altBody) (startAlts (fuel - 1) rest)

-- | 内部：局部函数 clause 体的最小起始位置。
startLocalClauses : Int -> List LocalClause -> (Int, Int)
startLocalClauses fuel clauses =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case clauses of
      [] => (1000000000, 1000000000)
      clause :: rest => minPair (startExpr (fuel - 1) clause.lcBody) (startLocalClauses (fuel - 1) rest)

-- | 内部：do 语句的最小起始位置。
startStmts : Int -> List DoStmt -> (Int, Int)
startStmts fuel stmts =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case stmts of
      [] => (1000000000, 1000000000)
      stmt :: rest => minPair (startStmt (fuel - 1) stmt) (startStmts (fuel - 1) rest)

-- | 内部：单条 do 语句的最小起始位置。
startStmt : Int -> DoStmt -> (Int, Int)
startStmt fuel stmt =
  if fuel <= 0 then
    lintFuelExhausted "expression position"
  else
    case stmt of
      DBind pat e sp => startExpr (fuel - 1) e
      DExpr e sp => startExpr (fuel - 1) e
      DLet binds r => minPair (startFromSpan (nodeRefSpan r)) (startBinds (fuel - 1) binds)

-- | 内部：表达式的真实起始行。
exprStartLine : Expr -> Int
exprStartLine e =
  case exprStartPos e of
    (line, col) => line

-- | 内部：表达式的真实起始列。
exprStartCol : Expr -> Int
exprStartCol e =
  case exprStartPos e of
    (line, col) => col

-- | 内部：表达式的真实单行性（起点用子树最小位置，覆盖中缀 span 起点偏后的情况）。
exprSingleLine : Expr -> Bool
exprSingleLine e = exprStartLine e == spanEndLine (exprSpan e)

-- | 内部：表达式的单行源码原文；左边界用真实起点，右边界取 span 末 token 之后的下一个
-- token，跨行时返回空串。
-- | 内部：范围内括号 token 的净差（`)` 数 - `(` 数）。
parenDeficit : LintSrc -> Int -> Int -> Int
parenDeficit src start end = parenDeficitGo src.lintSrcToks start end 0

parenDeficitGo : List PTok -> Int -> Int -> Int -> Int
parenDeficitGo [] start end acc = acc
parenDeficitGo (t :: rest) start end acc =
  let
    off = posOffset t.ptokPos
  in if off < start || off >= end then
    parenDeficitGo rest start end acc
  else
    case t of
      PTok (TSym "(") _ => parenDeficitGo rest start end (acc - 1)
      PTok (TSym ")") _ => parenDeficitGo rest start end (acc + 1)
      _ => parenDeficitGo rest start end acc

-- | 内部：表达式 span 不保证含源码括号（括号不在 AST 里、也不是表达式的语义位置），
-- 所以父节点由子 span 派生的区间可能从括号内部开始；直接按 span 切会漏掉左括号、留下
-- 孤立的 `)`。按 token 净差把紧邻的 `(`（或 `)`）补回切片。
widenStart : LintSrc -> Int -> Int -> Int
widenStart src start end =
  let
    deficit = parenDeficit src start end
  in if deficit <= 0 then start else widenStartGo (reverse src.lintSrcToks) start deficit

widenStartGo : List PTok -> Int -> Int -> Int
widenStartGo [] start n = start
widenStartGo (t :: rest) start n =
  if n <= 0 then
    start
  else if posOffset t.ptokPos >= start then
    widenStartGo rest start n
  else
    case t of
      PTok (TSym "(") _ => widenStartGo rest (posOffset t.ptokPos) (n - 1)
      _ => start

-- | 内部：反向不平衡（切片里多出左括号）时把紧跟的 `)` 补进末偏移。
widenEnd : LintSrc -> Int -> Int -> Int
widenEnd src start end =
  let
    deficit = parenDeficit src start end
  in if deficit >= 0 then end else widenEndGo src.lintSrcToks end deficit

widenEndGo : List PTok -> Int -> Int -> Int
widenEndGo [] end n = end
widenEndGo (t :: rest) end n =
  if n >= 0 then
    end
  else if posOffset t.ptokPos < end then
    widenEndGo rest end n
  else
    case t of
      PTok (TSym ")") _ => widenEndGo rest (posEndOffset t.ptokPos) (n + 1)
      _ => end

exprText : LintSrc -> Expr -> String
exprText src e =
  if not (exprSingleLine e) then
    ""
  else
    let
      start0 = offsetOfLineCol src (exprStartLine e) (exprStartCol e)
      end0 = tokenEndAt src (offsetOfLineCol src (spanEndLine (exprSpan e)) (spanEndCol (exprSpan e)))
      start = if end0 <= start0 then start0 else widenStart src start0 end0
      end = if end0 <= start0 then end0 else widenEnd src start0 end0
    in if end <= start then exprTextLine src e else trimEnd (sliceOffsets src start end)

-- | 内部：行列路径的表达式文本（偏移不可用时的回落）。
exprTextLine : LintSrc -> Expr -> String
exprTextLine src e =
  let
    line = lineAt src.lintSrcLines (exprStartLine e)
    col = exprStartCol e
    endLine = spanEndLine (exprSpan e)
  in case nextTokAfter src.lintSrcToks endLine (exprSpan e).spanEndCol of
    Nothing => trimEnd (tailFromCol line col)
    Just t =>
      if tokIsEof t then
        trimEnd (tailFromCol line col)
      else if tokLine t == endLine then
        trimEnd (sliceBetween line col (tokCol t))
      else
        trimEnd (tailFromCol line col)

-- | 内部：范围内方括号净差（`]` 数 - `[` 数）。
bracketDeficit : LintSrc -> Int -> Int -> Int
bracketDeficit src start end = bracketDeficitGo src.lintSrcToks start end 0

bracketDeficitGo : List PTok -> Int -> Int -> Int -> Int
bracketDeficitGo [] start end acc = acc
bracketDeficitGo (t :: rest) start end acc =
  let
    off = posOffset t.ptokPos
  in if off < start || off >= end then
    bracketDeficitGo rest start end acc
  else
    case t of
      PTok (TSym "[") _ => bracketDeficitGo rest start end (acc - 1)
      PTok (TSym "]") _ => bracketDeficitGo rest start end (acc + 1)
      _ => bracketDeficitGo rest start end acc

-- | 内部：范围里 `[` 多于 `]` 时把紧跟的 `]` 补进末偏移（列表字面量的 span 末尾不含 `]`）。
widenBracketEnd : LintSrc -> Int -> Int -> Int
widenBracketEnd src start end =
  let
    deficit = bracketDeficit src start end
  in if deficit >= 0 then end else widenBracketEndGo src.lintSrcToks end deficit

widenBracketEndGo : List PTok -> Int -> Int -> Int
widenBracketEndGo [] end n = end
widenBracketEndGo (t :: rest) end n =
  if n >= 0 then
    end
  else if posOffset t.ptokPos < end then
    widenBracketEndGo rest end n
  else
    case t of
      PTok (TSym "]") _ => widenBracketEndGo rest (posEndOffset t.ptokPos) (n + 1)
      _ => end

-- | 内部：表达式是否收束在自己的行片段末尾：同行后随 token 只能是 `else`（inline 链尾）或
-- 没有。
segmentOk : LintSrc -> Expr -> Bool
segmentOk src e =
  if not (exprSingleLine e) then
    False
  else
    case nextTokenAfterOffset src (spanEndOffset (exprSpan e)) of
      Nothing => True
      Just t => if tokIsEof t then True else if tokLine t == spanEndLine (exprSpan e) then tokIsKw t "else" else True

-- | 内部：表达式是否真的结束所在行（同行不再有任何 token，包括 `else`）。
--
-- 整行替换的修复（链改写成 `case`）会丢掉链尾之后的同行内容；`if a then <链> else b` 里
-- 链尾后紧跟外层 `else`，此时改写会留下没有 `else` 的 `if`，因此这类形状不产出修复
-- （`segmentOk` 允许 `else` 只适用于会被改写消费掉的链内 then 分支）。
segmentEndOk : LintSrc -> Expr -> Bool
segmentEndOk src e =
  if not (exprSingleLine e) then
    False
  else
    case nextTokenAfterOffset src (spanEndOffset (exprSpan e)) of
      Nothing => True
      Just t => tokIsEof t || tokLine t /= spanEndLine (exprSpan e)

-- | 内部：把行内某个标识符 token 的出现替换成新文本。
replaceIdentInLine : String -> PTok -> String -> String
replaceIdentInLine line tok replacement =
  let
    col = tokCol tok
    name = identText tok
    prefix = sliceLine 0 (col - 1) line
    suffix = tailFromCol line (col + strLength name)
  in prefix ++ replacement ++ suffix

-- | 内部：token 的标识符名字；非标识符为空串。
identText : PTok -> String
identText tok =
  case tokIdentOf tok of
    Just x => x
    Nothing => ""

-- | 内部：该位置之前是否只有空白（即名字独占行首）。
startsOwnLine : List String -> Int -> Int -> Bool
startsOwnLine lines line col = blankChars (strUnpack (prefixBeforeCol (lineAt lines line) col))

-- ---------------------------------------------------------------
-- 模式工具（带 fuel，便于相互递归的 SCT 证明）
-- ---------------------------------------------------------------
-- | 内部：模式列表里绑定的变量名。
patVars : List Pat -> List String
patVars pats = patVarsFuel lintFuel pats

-- | 内部：`patVars` 的 fuel 版本。
patVarsFuel : Int -> List Pat -> List String
patVarsFuel fuel pats =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case pats of
      [] => []
      p :: rest => append (patVarFuel (fuel - 1) p) (patVarsFuel (fuel - 1) rest)

-- | 内部：单个模式绑定的变量名。
patVarFuel : Int -> Pat -> List String
patVarFuel fuel pat =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case pat of
      PVar name _ => [name]
      PAs name inner _ => name :: patVarFuel (fuel - 1) inner
      PWild _ => []
      PCon name args _ => patVarsFuel (fuel - 1) args
      PInt n _ => []
      PStr s _ => []
      PRecord name fields _ => patFieldVarsFuel (fuel - 1) fields

-- | 内部：record 模式各字段绑定的变量名。
patFieldVarsFuel : Int -> List (String, Pat) -> List String
patFieldVarsFuel fuel fields =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case fields of
      [] => []
      (f, pat) :: rest => append (patVarFuel (fuel - 1) pat) (patFieldVarsFuel (fuel - 1) rest)

-- | 内部：某个变量名在模式列表里出现的次数。
countVar : String -> List Pat -> Int
countVar name pats = countPatsFuel lintFuel name pats

-- | 内部：`countVar` 的模式列表实现。
countPatsFuel : Int -> String -> List Pat -> Int
countPatsFuel fuel name pats =
  if fuel <= 0 then
    lintFuelExhausted "count"
  else
    case pats of
      [] => 0
      p :: rest => countPatFuel (fuel - 1) name p + countPatsFuel (fuel - 1) name rest

-- | 内部：单个模式里某变量名出现的次数（只看变量、构造子参数与 record 字段）。
countPatFuel : Int -> String -> Pat -> Int
countPatFuel fuel name pat =
  if fuel <= 0 then
    lintFuelExhausted "count"
  else
    case pat of
      PVar n _ => if n == name then 1 else 0
      PCon n args _ => countPatsFuel (fuel - 1) name args
      PRecord n fields _ => countFieldsFuel (fuel - 1) name fields
      _ => 0

-- | 内部：record 模式字段里某变量名出现的次数。
countFieldsFuel : Int -> String -> List (String, Pat) -> Int
countFieldsFuel fuel name fields =
  if fuel <= 0 then
    lintFuelExhausted "count"
  else
    case fields of
      [] => 0
      (f, pat) :: rest => countPatFuel (fuel - 1) name pat + countFieldsFuel (fuel - 1) name rest

-- | 内部：模式里某变量名第一次出现的 span。
patVarSpan : String -> Pat -> Maybe Span
patVarSpan name pat = patVarSpanFuel lintFuel name pat

-- | 内部：`patVarSpan` 的 fuel 版本。
patVarSpanFuel : Int -> String -> Pat -> Maybe Span
patVarSpanFuel fuel name pat =
  if fuel <= 0 then
    lintFuelExhausted "pattern variable"
  else
    case pat of
      PVar n sp => if n == name then Just (nodeRefSpan sp) else Nothing
      PCon n args _ => patVarSpanInPatsFuel (fuel - 1) name args
      PRecord n fields _ => patVarSpanInFieldsFuel (fuel - 1) name fields
      _ => Nothing

-- | 内部：模式列表里某变量名第一次出现的 span。
patVarSpanInPats : String -> List Pat -> Maybe Span
patVarSpanInPats name pats = patVarSpanInPatsFuel lintFuel name pats

-- | 内部：`patVarSpanInPats` 的 fuel 版本。
patVarSpanInPatsFuel : Int -> String -> List Pat -> Maybe Span
patVarSpanInPatsFuel fuel name pats =
  if fuel <= 0 then
    lintFuelExhausted "pattern variable"
  else
    case pats of
      [] => Nothing
      p :: rest =>
        case patVarSpanFuel (fuel - 1) name p of
          Just sp => Just sp
          Nothing => patVarSpanInPatsFuel (fuel - 1) name rest

-- | 内部：record 模式字段里某变量名第一次出现的 span。
patVarSpanInFieldsFuel : Int -> String -> List (String, Pat) -> Maybe Span
patVarSpanInFieldsFuel fuel name fields =
  if fuel <= 0 then
    lintFuelExhausted "pattern variable"
  else
    case fields of
      [] => Nothing
      (f, pat) :: rest =>
        case patVarSpanFuel (fuel - 1) name pat of
          Just sp => Just sp
          Nothing => patVarSpanInFieldsFuel (fuel - 1) name rest

-- | 内部：两个名字列表是否有交集。
intersectsNames : List String -> List String -> Bool
intersectsNames [] ys = False
intersectsNames (x :: rest) ys = memName x ys || intersectsNames rest ys

-- | 内部：从名字列表里删除所有同名项。
removeName : String -> List String -> List String
removeName name [] = []
removeName name (x :: rest) = if x == name then removeName name rest else x :: removeName name rest

-- | 内部：该模式能否作为提升目标：构造子（含参数）、字面量、record 模式。
liftablePat : Pat -> Bool
liftablePat (PCon name args _) = True
liftablePat (PInt n _) = True
liftablePat (PStr s _) = True
liftablePat (PRecord name fields _) = True
liftablePat _ = False

-- | 内部：模式放进 clause 参数位置时是否需要加括号：带参数构造子与 record 模式需要，否则
-- 会被解析成多个参数模式（0 元构造子与后续模式分开）；无参数构造子、字面量、变量不需要。
-- 元组模式自带括号，不需要再加。
patNeedsParen : Pat -> Bool
patNeedsParen (PCon name args _) = if isTuplePairSyntax name then False else notEmptyPatList args
patNeedsParen (PRecord _ _ _) = True
patNeedsParen _ = False

-- | 内部：模式列表是否非空。
notEmptyPatList : List Pat -> Bool
notEmptyPatList [] = False
notEmptyPatList _ = True

-- ---------------------------------------------------------------
-- 表达式 / 模式的自由名引用
-- ---------------------------------------------------------------
-- | 内部：表达式是否引用了某个自由名（不区分绑定作用域）。
exprMentions : String -> Expr -> Bool
exprMentions name e = mentionsExpr lintFuel name e

-- | 内部：`exprMentions` 的 fuel 版本，覆盖全部表达式构造子。
mentionsExpr : Int -> String -> Expr -> Bool
mentionsExpr fuel name e =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case e of
      EVar n _ => n == name
      EInt n _ => False
      EStr s _ => False
      EFloat raw _ => False
      ELam ps body _ => mentionsExpr (fuel - 1) name body
      EApp fn args _ => mentionsExpr (fuel - 1) name fn || mentionsExprs (fuel - 1) name args
      EPi n implicit _ dom cod _ => mentionsExpr (fuel - 1) name dom || mentionsExpr (fuel - 1) name cod
      ELet binds body recFlag _ => mentionsBinds (fuel - 1) name binds || mentionsExpr (fuel - 1) name body
      ECase scrut alts _ => mentionsExpr (fuel - 1) name scrut || mentionsAlts (fuel - 1) name alts
      EIf cond yes no _ => mentionsExpr (fuel - 1) name cond || mentionsExpr (fuel - 1) name yes || mentionsExpr (fuel - 1) name no
      EField base f _ => mentionsExpr (fuel - 1) name base
      ERecord rname fields _ => mentionsFields (fuel - 1) name fields
      ERecUpdate base fields _ => mentionsExpr (fuel - 1) name base || mentionsFields (fuel - 1) name fields
      EDo stmts _ => mentionsStmts (fuel - 1) name stmts
      -- 模板字面量：洞内引用照常算 mention（否则 where 变量会被误报未使用）。
      EInterp parts _ => mentionsInterpParts (fuel - 1) name parts

-- | 内部：模板字面量各段里的引用（洞内表达式参与扫描）。
mentionsInterpParts : Int -> String -> List InterpPart -> Bool
mentionsInterpParts fuel name parts =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case parts of
      [] => False
      (IPText s) :: rest => mentionsInterpParts (fuel - 1) name rest
      (IPHole e) :: rest => mentionsExpr (fuel - 1) name e || mentionsInterpParts (fuel - 1) name rest

-- | 内部：任一表达式是否引用该名字。
mentionsExprs : Int -> String -> List Expr -> Bool
mentionsExprs fuel name exprs =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case exprs of
      [] => False
      e :: rest => mentionsExpr (fuel - 1) name e || mentionsExprs (fuel - 1) name rest

-- | 内部：record 字段值是否引用该名字。
mentionsFields : Int -> String -> List (String, Expr) -> Bool
mentionsFields fuel name fields =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case fields of
      [] => False
      (f, e) :: rest => mentionsExpr (fuel - 1) name e || mentionsFields (fuel - 1) name rest

-- | 内部：单条绑定的值或签名类型是否引用该名字。
bindingMentions : Int -> String -> Binding -> Bool
bindingMentions fuel name b =
  bindingValueMentions (fuel - 1) name b.bindValue || case b.bindSig of
      Just sig => mentionsExpr (fuel - 1) name sig.sigType
      Nothing => False

-- | 内部：绑定右值是否引用该名字（局部函数组逐 clause 查）。
bindingValueMentions : Int -> String -> BindingValue -> Bool
bindingValueMentions fuel name (BVal e) = mentionsExpr (fuel - 1) name e
bindingValueMentions fuel name (BClauses clauses) = mentionsClauses (fuel - 1) name clauses

-- | 内部：let 绑定右值是否引用该名字。
mentionsBinds : Int -> String -> List Binding -> Bool
mentionsBinds fuel name binds =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case binds of
      [] => False
      b :: rest => bindingMentions (fuel - 1) name b || mentionsBinds (fuel - 1) name rest

-- | 内部：任一 case alt 体是否引用该名字。
mentionsAlts : Int -> String -> List Alt -> Bool
mentionsAlts fuel name alts =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case alts of
      [] => False
      a :: rest => mentionsExpr (fuel - 1) name a.altBody || mentionsAlts (fuel - 1) name rest

-- | 内部：任一局部函数 clause 体是否引用该名字。
mentionsClauses : Int -> String -> List LocalClause -> Bool
mentionsClauses fuel name clauses =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case clauses of
      [] => False
      clause :: rest => mentionsExpr (fuel - 1) name clause.lcBody || mentionsClauses (fuel - 1) name rest

-- | 内部：任一 do 语句是否引用该名字。
mentionsStmts : Int -> String -> List DoStmt -> Bool
mentionsStmts fuel name stmts =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case stmts of
      [] => False
      stmt :: rest => mentionsStmt (fuel - 1) name stmt || mentionsStmts (fuel - 1) name rest

-- | 内部：单条 do 语句是否引用该名字。
mentionsStmt : Int -> String -> DoStmt -> Bool
mentionsStmt fuel name stmt =
  if fuel <= 0 then
    lintFuelExhausted "mention scan"
  else
    case stmt of
      DBind pat e sp => mentionsExpr (fuel - 1) name e
      DExpr e sp => mentionsExpr (fuel - 1) name e
      DLet binds sp => mentionsBinds (fuel - 1) name binds

-- ---------------------------------------------------------------
-- 规则 1：literal-if-chain
-- ---------------------------------------------------------------
-- | 内部：识别 `x == 字面量` 形式的条件，返回 scrutinee 名与字面量原文；其他条件返回
-- `Nothing`。
condShape : LintSrc -> Expr -> Maybe (String, String)
condShape src (EApp (EVar op _) args _) =
  if op == "==" then
    case args of
      [lhs, rhs] =>
        case lhs of
          EVar name _ =>
            case rhs of
              EStr s _ => Just (name, spanText src (exprSpan rhs))
              EInt n _ => Just (name, spanText src (exprSpan rhs))
              EFloat raw _ => Just (name, spanText src (exprSpan rhs))
              _ => Nothing
          _ => Nothing
      _ => Nothing
  else
    Nothing
condShape src _ = Nothing

-- | 内部：从 if 表达式提取字面量分派链；条件不是 `==` 字面量比较时返回 `Nothing`。
chainOf : LintSrc -> Expr -> Maybe ChainRes
chainOf src (EIf cond yes no _) =
  case condShape src cond of
    Nothing => Nothing
    Just (name, lit) => Just (chainCollect src name [ChainItem lit (exprText src yes) yes] no)
chainOf src _ = Nothing

-- | 内部：沿 else 分支收集同 scrutinee 的 if/else-if 链。
chainCollect : LintSrc -> String -> List ChainItem -> Expr -> ChainRes
chainCollect src name acc expr = chainCollectFuel lintFuel src name acc expr

-- | 内部：`chainCollect` 的 fuel 版本；scrutinee 变化或遇到非 if 时把剩余表达式当作
-- default 分支。
chainCollectFuel : Int -> LintSrc -> String -> List ChainItem -> Expr -> ChainRes
chainCollectFuel fuel src name acc expr =
  if fuel <= 0 then
    lintFuelExhausted "chain collection"
  else
    case expr of
      EIf cond yes no _ =>
        case condShape src cond of
          Just (other, lit) => if other == name then chainCollectFuel (fuel - 1) src name (ChainItem lit (exprText src yes) yes :: acc) no else ChainRes name (reverse acc) "_" (exprText src expr) expr
          Nothing => ChainRes name (reverse acc) "_" (exprText src expr) expr
      _ => ChainRes name (reverse acc) "_" (exprText src expr) expr

-- | 内部：渲染一条 case 分支（`indent + 2` 个空格下的 `字面量 => then 原文`）。
renderChainItem : Int -> ChainItem -> String
renderChainItem indent (ChainItem lit thenText expr) = "${spaces (indent + 2)}${lit} => ${thenText}"

-- | 内部：链上每个 then 分支都能安全地收束在自己的行片段末尾。
itemsSegmentsOk : LintSrc -> List ChainItem -> Bool
itemsSegmentsOk src [] = True
itemsSegmentsOk src ((ChainItem lit thenText expr) :: rest) =
  segmentOk src expr && itemsSegmentsOk src rest

-- | 内部：字面量链可安全改写成 case 的判据：行区间干净、各 then 分支收束行尾（后随 `else`
-- 属于链本身、会被改写消费）、default 分支结束整行（链尾之后不能再有外层 `else`）。
chainFixable : LintSrc -> Span -> List ChainItem -> Expr -> Bool
chainFixable src sp items defaultExpr =
  linesCleanRange src.lintSrcLines (spanStartLine sp) (spanEndLine sp)
    && itemsSegmentsOk src items && segmentEndOk src defaultExpr

-- | 内部：`literal-if-chain` 的 case 回退：链至少两个分支且可修复时，产出把整条链改写成
-- `case scrut of` 的 finding；否则不产出（仍可能由提升分支处理）。
chainFindings : LintSrc -> Span -> String -> List ChainItem -> String -> String -> Expr -> List Finding
chainFindings src sp name items defaultPat defaultText defaultExpr =
  if not (atLeastTwo items) then
    []
  else if not (chainFixable src sp items defaultExpr) then
    []
  else
    let
      startLine = spanStartLine sp
      endLine = spanEndLine sp
      line = lineAt src.lintSrcLines startLine
      indent = indentOf line
      prefix = prefixBeforeCol line (spanStartCol sp)
      newLines = append ["${prefix}case ${name} of"] (append (map (\item => renderChainItem indent item) items) ["${spaces (indent + 2)}${defaultPat} => ${defaultText}"])
      edit = Just (Edit startLine endLine newLines)
    in [mkFinding sp LiteralIfChain (lintMsg LiteralIfChain name) edit]

-- | 内部：继续遍历各 then 分支，链内部的 dispatch 仍要检查。
walkChainItems : Bool -> Int -> LintSrc -> List ChainItem -> List Finding
walkChainItems allow fuel src items =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case items of
      [] => []
      item :: rest => append (walkExprGo allow (fuel - 1) src item.chainItemThen) (walkChainItems allow (fuel - 1) src rest)

-- ---------------------------------------------------------------
-- 规则 1b：if dispatch 提升（Bool 变量 / 字面量链）
--
-- 一个 if 分派 = scrutinee + 若干（模式, body）叶子。当它正好是外层 clause/alt 的直接体、
-- 且 scrutinee 是外层模式变量时，把叶子提升进外层模式：clause → 多条同名 clause（要求该
-- 名字只有一条 clause），alt → 更细的 alt 模式（要求该 alt 是最后一个）。提升是 lift 语义，
-- 不经过 case；字面量链提升失败时仍由 `walkIf` 走 case 回退。
-- ---------------------------------------------------------------
-- | 提升后的一条叶子：外层模式变量的替换表，加上该叶子的 body。
record LiftLeaf where
  -- | 变量名 → 替换后的模式原文（如 `True`、`"a"`、`Just x`）。
  leafSubsts : List (String, String)
  -- | 提升到 clause/alt 体位置的表达式。
  leafBody : Expr

-- | 内部：替换表里是否已经有该变量名。
hasSubst : String -> List (String, String) -> Bool
hasSubst name substs = memName name (map (\p => firstOf p) substs)

-- | 内部：外层上下文能否承接拆分：clause 要求是该名字唯一的 clause，alt 要求是最后一个。
laneSplitOk : Lane -> Bool
laneSplitOk (LClause line pats last single) = single
laneSplitOk (LAlt line pat last) = last

-- | 内部：把变量名替换成模式文本：body 引用该变量时用 `name@pat`（`_` 模式保留原名），
-- 否则只用模式本身。
substReplacement : String -> String -> Expr -> String
substReplacement name pat body =
  if exprMentions name body then if pat == "_" then name else "${name}@${pat}" else pat

-- | 内部：把替换表映射成（外层模式里的变量 token, 替换文本）对；变量在外层模式里定位不到
-- token 的项直接跳过。
substTokenPairs : LintSrc -> Lane -> List (String, String) -> Expr -> List (PTok, String)
substTokenPairs src lane [] body = []
substTokenPairs src lane ((name, pat) :: rest) body =
  case laneVarSpan name lane of
    Nothing => substTokenPairs src lane rest body
    Just sp =>
      case tokenAtSpan src sp of
        Nothing => substTokenPairs src lane rest body
        Just tok => (tok, substReplacement name pat body) :: substTokenPairs src lane rest body

-- | 内部：替换表里的每个变量都能在外层模式里定位到 token（否则不能应用替换）。
substsApplicable : LintSrc -> Lane -> List (String, String) -> Bool
substsApplicable src lane [] = True
substsApplicable src lane ((name, pat) :: rest) =
  case laneVarSpan name lane of
    Nothing => False
    Just sp =>
      case tokenAtSpan src sp of
        Nothing => False
        Just tok => substsApplicable src lane rest

-- | 内部：按列号降序排序替换对（同一行内从右往左替换，避免列偏移）。
sortSubstDesc : List (PTok, String) -> List (PTok, String)
sortSubstDesc [] = []
sortSubstDesc (x :: rest) = insertSubstDesc x (sortSubstDesc rest)

-- | 内部：把一个替换对按列号降序插入已排序列表。
insertSubstDesc : (PTok, String) -> List (PTok, String) -> List (PTok, String)
insertSubstDesc x [] = [x]
insertSubstDesc x (y :: rest) =
  if tokCol (firstOf x) > tokCol (firstOf y) then x :: y :: rest else y :: insertSubstDesc x rest

-- | 内部：按给定顺序把替换对逐个应用到一行文本。
applySubstPairs : List (PTok, String) -> String -> String
applySubstPairs [] headText = headText
applySubstPairs ((tok, repl) :: rest) headText =
  applySubstPairs rest (replaceIdentInLine headText tok repl)

-- | 内部：生成该叶子的 clause/alt 头文本（在外层 head 里替换被提升的变量）。
leafHeadText : LintSrc -> Lane -> String -> LiftLeaf -> String
leafHeadText src lane headText leaf =
  applySubstPairs (sortSubstDesc (substTokenPairs src lane leaf.leafSubsts leaf.leafBody)) headText

-- | 内部：为每个叶子生成「头 + body」行；任一 body 不是可切片的单行时整体放弃（`Nothing`）。
liftLeafLines : LintSrc -> Lane -> String -> List LiftLeaf -> Maybe (List String)
liftLeafLines src lane headText [] = Just []
liftLeafLines src lane headText (leaf :: rest) =
  let
    head = leafHeadText src lane headText leaf
    body = leaf.leafBody
  in if not (exprSingleLine body) then
    Nothing
  else
    let
      bodyText = exprText src body
    in if bodyText == "" then
      Nothing
    else
      case liftLeafLines src lane headText rest of
        Nothing => Nothing
        Just tailLines => Just ("${head} ${bodyText}" :: tailLines)

-- | 内部：叶子 body 在原位置能否安全改写到新位置。
leafPlacementOk : LintSrc -> LiftLeaf -> Bool
leafPlacementOk src leaf = segmentOk src leaf.leafBody

-- | 内部：全部叶子都可放置，且替换表都能在外层模式里定位。
leavesOk : LintSrc -> Lane -> List LiftLeaf -> Bool
leavesOk src lane [] = True
leavesOk src lane (leaf :: rest) =
  leafPlacementOk src leaf && substsApplicable src lane leaf.leafSubsts && leavesOk src lane rest

-- | 内部：if 提升可安全应用：外层 head 单行、行区间干净、全部叶子可放置。
liftLeavesFixable : LintSrc -> Lane -> List LiftLeaf -> Span -> Bool
liftLeavesFixable src lane leaves sp =
  laneHeadSingleLine lane
    && linesCleanRange src.lintSrcLines (laneHeadLine lane) (spanEndLine sp)
    && leavesOk src lane leaves

-- | 内部：构造把外层 head 行到 if 结束行整体替换的编辑；生成失败时 `Nothing`。
liftLeavesEdit : LintSrc -> Lane -> List LiftLeaf -> Span -> Maybe Edit
liftLeavesEdit src lane leaves sp =
  let
    headText = laneHeadText src.lintSrcLines lane (spanStartLine sp) (spanStartCol sp)
  in case liftLeafLines src lane headText leaves of
    Nothing => Nothing
    Just newLines => Just (Edit (laneHeadLine lane) (spanEndLine sp) newLines)

-- | 内部：把 Bool 变量 if / else-if 链展开成笛卡尔叶子（True 进 then、False 进 else）。遇到
-- 非变量条件、已替换过的 scrutinee 或外层出现多次的变量时，把剩余表达式当作叶子体（保留
-- 原 if）。
boolIfLeaves : Lane -> List (String, String) -> Expr -> List LiftLeaf
boolIfLeaves lane substs (EIf cond yes no sp) =
  case cond of
    EVar name _ =>
      if hasSubst name substs || countLaneVar name lane /= 1 then
        [LiftLeaf substs (EIf cond yes no sp)]
      else
        append
          [LiftLeaf (append substs [(name, "True")]) yes]
          (boolIfLeaves lane (append substs [(name, "False")]) no)
    _ => [LiftLeaf substs (EIf cond yes no sp)]
boolIfLeaves lane substs expr = [LiftLeaf substs expr]

-- | 内部：识别可提升的 if 分派，返回 scrutinee 名与叶子：Bool 变量走 `boolIfLeaves`，其余
-- 走字面量链。
ifDispatchLeaves : LintSrc -> Lane -> Expr -> Maybe (String, List LiftLeaf)
ifDispatchLeaves src lane (EIf cond yes no sp) =
  case cond of
    EVar name _ =>
      if countLaneVar name lane == 1 then
        let
          leaves = boolIfLeaves lane [] (EIf cond yes no sp)
        in if atLeastTwo leaves then Just (name, leaves) else Nothing
      else
        literalIfLeaves src lane (EIf cond yes no sp)
    _ => literalIfLeaves src lane (EIf cond yes no sp)
ifDispatchLeaves src lane _ = Nothing

-- | 内部：把一个字面量链分支转成提升叶子。
literalChainLeaf : String -> ChainItem -> LiftLeaf
literalChainLeaf name item = LiftLeaf [(name, item.chainItemLit)] item.chainItemThen

-- | 内部：字面量链转提升叶子（default 分支也是一条叶子）；不足两个分支或变量在外层出现
-- 多次时放弃。
literalIfLeaves : LintSrc -> Lane -> Expr -> Maybe (String, List LiftLeaf)
literalIfLeaves src lane expr =
  case chainOf src expr of
    Nothing => Nothing
    Just (ChainRes name items defPat _ defExpr) =>
      if not (atLeastTwo items) || countLaneVar name lane /= 1 then
        Nothing
      else
        Just (name, append (map (literalChainLeaf name) items) [LiftLeaf [(name, defPat)] defExpr])

-- | 内部：`literal-if-chain` 的提升分支：判据与编辑都成立时产出 finding，否则留给 `walkIf`
-- 的 case 回退。
ifLiftFindings : LintSrc -> Lane -> Expr -> List Finding
ifLiftFindings src lane expr =
  case ifDispatchLeaves src lane expr of
    Nothing => []
    Just (name, leaves) =>
      if not (laneSplitOk lane) then
        []
      else if not (liftLeavesFixable src lane leaves (exprSpan expr)) then
        []
      else
        case liftLeavesEdit src lane leaves (exprSpan expr) of
          Nothing => []
          Just edit => [mkFinding (exprSpan expr) LiteralIfChain (lintMsg LiteralIfChain name) (Just edit)]

-- ---------------------------------------------------------------
-- 规则 2：dispatch-lift（case / let）
-- 单 alt 替换外层变量；多 alt 拆 clause / alt。渲染与安全判据共用同一套 lane 工具。
-- ---------------------------------------------------------------
-- | 内部：外层 head 的行号。
laneHeadLine : Lane -> Int
laneHeadLine (LClause line pats last single) = line
laneHeadLine (LAlt line pat last) = line

-- | 内部：该 clause/alt 是否是最后一个。
laneLast : Lane -> Bool
laneLast (LClause line pats last single) = last
laneLast (LAlt line pat last) = last

-- | 内部：外层模式绑定的全部变量名。
laneVars : Lane -> List String
laneVars (LClause line pats last single) = patVars pats
laneVars (LAlt line pat last) = patVarFuel lintFuel pat

-- | 内部：某变量名在外层模式里出现的次数。
countLaneVar : String -> Lane -> Int
countLaneVar name (LClause line pats last single) = countVar name pats
countLaneVar name (LAlt line pat last) = countPatFuel lintFuel name pat

-- | 内部：某变量名在外层模式里第一次出现的 span。
laneVarSpan : String -> Lane -> Maybe Span
laneVarSpan name (LClause line pats last single) = patVarSpanInPats name pats
laneVarSpan name (LAlt line pat last) = patVarSpan name pat

-- | 内部：外层 head 的文本：被提升表达式嵌在同一行时只取它之前的行前缀，否则取整行。
laneHeadText : List String -> Lane -> Int -> Int -> String
laneHeadText lines lane startLine startCol =
  let
    line = laneHeadLine lane
  in if startLine == line then
    trimEnd (prefixBeforeCol (lineAt lines line) startCol)
  else
    lineAt lines line

-- | 内部：一组模式是否都落在同一行。
patsOnLine : List Pat -> Int -> Bool
patsOnLine [] line = True
patsOnLine (p :: rest) line =
  spanStartLine (patSpan p) == line && spanEndLine (patSpan p) == line && patsOnLine rest line

-- | 内部：外层 head（clause 的模式 / alt 的模式）是否单行。
laneHeadSingleLine : Lane -> Bool
laneHeadSingleLine (LClause line pats last single) = patsOnLine pats line
laneHeadSingleLine (LAlt line pat last) = spanSingleLine (patSpan pat)

-- | 内部：把外层 head 里的被提升变量替换成新模式。`startLine` / `startCol` 是被提升表达式
-- 的起点：表达式嵌在 head 行内时只保留它之前的前缀（避免把 `case p of` 留在 clause 头）。
laneReplace : LintSrc -> Lane -> String -> String -> Int -> Int -> String
laneReplace src lane name replacement startLine startCol =
  let
    headText = laneHeadText src.lintSrcLines lane startLine startCol
  in case laneVarSpan name lane of
    Nothing => headText
    Just sp =>
      case tokenAtSpan src sp of
        Nothing => headText
        Just tok => replaceIdentInLine headText tok replacement

-- | 内部：体在原位置的放置是否可安全改写：单行体要收束行片段，多行体要求从独立行开始。
liftBodyPlacementOk : LintSrc -> Pat -> Expr -> Bool
liftBodyPlacementOk src altPat body =
  if exprSingleLine body then
    segmentOk src body
  else if exprStartLine body > spanStartLine (patSpan altPat) then
    True
  else
    exprStartCol body > indentOf (lineAt src.lintSrcLines (exprStartLine body)) + 1

-- | 内部：case 提升的可行判据：alt 是最后一个、head 与 alt 模式单行、行区间干净、body
-- 放置安全。
liftFixable : LintSrc -> Lane -> Pat -> Expr -> Span -> Bool
liftFixable src lane pat body sp =
  laneLast lane
    && laneHeadSingleLine lane
    && spanSingleLine (patSpan pat)
    && linesCleanRange src.lintSrcLines (laneHeadLine lane) (spanEndLine sp)
    && liftBodyPlacementOk src pat body

-- | 内部：构造单 alt 提升的编辑：head 里替换变量，body 按单行/多行贴到 head 后或缩进成块。
liftEdit : LintSrc -> Lane -> Pat -> Expr -> String -> Span -> Edit
liftEdit src lane pat body name sp =
  let
    headLine = laneHeadLine lane
    ownLine = startsOwnLine src.lintSrcLines (spanStartLine sp) (spanStartCol sp)
    patTextValue = if exprMentions name body then asPatText src name pat else patReplacement src pat
    newHead = laneReplace src lane name patTextValue (spanStartLine sp) (spanStartCol sp)
    target =
      if ownLine then spanStartCol sp - 1 else indentOf (lineAt src.lintSrcLines headLine) + 2
    newLines =
      if ownLine then
        if exprSingleLine body then
          [newHead, spaces target ++ exprText src body]
        else
          newHead :: blockBodyLines src.lintSrcLines body target
      else if exprSingleLine body then
        ["${newHead} ${exprText src body}"]
      else
        newHead :: blockBodyLines src.lintSrcLines body target
  in Edit headLine (spanEndLine sp) newLines

-- | 内部：单 alt case 提升的判据与 finding：变量在外层只出现一次、模式可提升、模式变量不与
-- 外层其他变量冲突且可安全改写。
liftCaseOk : LintSrc -> Lane -> Pat -> Expr -> String -> Span -> List Finding
liftCaseOk src lane pat body name sp =
  if countLaneVar name lane == 1 && True && not (intersectsNames (patVarFuel lintFuel pat) (removeName name (laneVars lane))) && liftablePat pat && liftFixable src lane pat body sp then
    [
      mkFinding
        sp
        DispatchLift
        (lintMsg DispatchLift name)
        (Just (liftEdit src lane pat body name sp))
    ]
  else
    []

-- | 内部：外层上下文是否是顶层 clause。
laneIsClause : Lane -> Bool
laneIsClause (LClause line pats last single) = True
laneIsClause (LAlt line pat last) = False

-- | 内部：不需要保留绑定时，模式放进 clause 参数位置的形式（自带括号的元组不再包一层）。
patReplacement : LintSrc -> Pat -> String
patReplacement src pat = if patNeedsParen pat then "(${patText src pat})" else patText src pat

-- | 内部：`name@pat` 形式的模式文本；带参数或 record 模式加括号。
asPatText : LintSrc -> String -> Pat -> String
asPatText src name pat =
  if patNeedsParen pat then "${name}@(${patText src pat})" else "${name}@${patText src pat}"

-- | 内部：对 `case x of` 单 alt 形式的提升；scrutinee 不是变量或 alt 不止一个时不产出。
liftCase : LintSrc -> Lane -> Expr -> Expr -> List Alt -> Span -> List Finding
liftCase src lane caseExpr scrut ([alt]) sp =
  case scrut of
    EVar name _ => liftCaseOk src lane alt.altPat alt.altBody name sp
    _ => []
liftCase src lane caseExpr scrut _ sp = []

-- | 内部：对 `let pat = x` 的提升；右值不是变量或模式不可提升时不产出。
liftLet : LintSrc -> Lane -> Span -> Pat -> Expr -> Expr -> List Finding
liftLet src lane sp pat (EVar name _) body =
  if liftablePat pat && countLaneVar name lane == 1 && True && not (intersectsNames (patVarFuel lintFuel pat) (removeName name (laneVars lane))) && liftLetFixable src lane pat body sp then
    [
      mkFinding
        sp
        DispatchLift
        (lintMsg DispatchLift name)
        (Just (liftLetEdit src lane pat body name sp))
    ]
  else
    []
liftLet src lane sp pat _ body = []

-- | 内部：let 提升的可行判据：alt 是最后一个、head 与 let 模式单行、行区间干净、body 放置
-- 安全。
liftLetFixable : LintSrc -> Lane -> Pat -> Expr -> Span -> Bool
liftLetFixable src lane pat body sp =
  laneLast lane
    && laneHeadSingleLine lane
    && spanSingleLine (patSpan pat)
    && linesCleanRange src.lintSrcLines (laneHeadLine lane) (spanEndLine sp)
    && liftLetPlacementOk src sp body

-- | 内部：let 提升后 body 的放置判据：单行要收束行片段，多行要另起一行。
liftLetPlacementOk : LintSrc -> Span -> Expr -> Bool
liftLetPlacementOk src sp body =
  if exprSingleLine body then segmentOk src body else exprStartLine body > spanStartLine sp

-- | 内部：构造 let 提升的编辑：单行 body 与 head 同行，多行 body 按缩进成块。
liftLetEdit : LintSrc -> Lane -> Pat -> Expr -> String -> Span -> Edit
liftLetEdit src lane pat body name sp =
  let
    headLine = laneHeadLine lane
    patTextValue = if exprMentions name body then asPatText src name pat else patReplacement src pat
    newHead = laneReplace src lane name patTextValue (spanStartLine sp) (spanStartCol sp)
    target = indentOf (lineAt src.lintSrcLines headLine) + 2
    -- let 解构没有既有语料约束，单行 body 直接按 fmt 规范形态与 clause/alt 头同行。
    newLines =
      if exprSingleLine body then
        ["${newHead} ${exprText src body}"]
      else
        newHead :: blockBodyLines src.lintSrcLines body target
  in Edit headLine (spanEndLine sp) newLines

-- | 内部：对直接体分派到 case 提升或 let 提升（递归 let 不处理）。
liftFindings : LintSrc -> Lane -> Expr -> List Finding
liftFindings src lane (expr@(ECase scrut alts sp)) =
  liftCase src lane expr scrut alts (nodeRefSpan sp)
liftFindings src lane (ELet binds body recFlag sp) =
  if not recFlag then
    case binds of
      -- 带签名行的绑定保持原形（签名行不是可提升的右值）。
      [b] =>
        case b.bindSig of
          Just _ => []
          Nothing =>
            case b.bindValue of
              BVal value => liftLet src lane (nodeRefSpan sp) b.bindPat value body
              BClauses _ => []
      _ => []
  else
    []
liftFindings src lane _ = []

-- ---------------------------------------------------------------
-- 规则 3：dispatch-lift 的多 alt 拆分（顶层 case → 多 clause）
-- ---------------------------------------------------------------
-- 判据不再语法层证明穷尽性：lint 的输入应视为能通过 `vuna check` 的程序，
-- 而 DT 已强制 `case` 穷尽；`case` 与多 clause 的匹配语义等价（分支/clause 顺序一致）。
-- 纯映射表（分支体不引用 scrutinee）同样拆成多 clause。
-- | 内部：模式是否是通配 `_`。
isWildPat : Pat -> Bool
isWildPat (PWild _) = True
isWildPat _ = False

-- | 内部：该 alt 能否搬进 clause：模式变量不与外层其他变量冲突；引用 scrutinee 时模式必须
-- 是通配或可提升模式。
caseAltLiftableOk : String -> List String -> Alt -> Bool
caseAltLiftableOk x others alt =
  not (intersectsNames (patVarFuel lintFuel alt.altPat) others)
    && (if exprMentions x alt.altBody then isWildPat alt.altPat || liftablePat alt.altPat else True)

-- | 内部：逐个 alt 检查可拆分性。
altsLiftableGo : String -> List String -> List Alt -> Bool
altsLiftableGo x others [] = True
altsLiftableGo x others (alt :: rest) =
  caseAltLiftableOk x others alt && altsLiftableGo x others rest

-- | 内部：全部 alt 都可拆分（外层变量取 clause head 绑定的名字）。
altsLiftable : String -> List Pat -> List Alt -> Bool
altsLiftable x pats alts = altsLiftableGo x (removeName x (patVars pats)) alts

-- | 内部：把一个 alt 渲染成 clause 行：head 里替换 scrutinee，body 按单行/多行放置。
caseAltClauseLines : LintSrc -> String -> PTok -> String -> Int -> Pat -> Expr -> List String
caseAltClauseLines src headPrefix varTok x headIndent pat body =
  let
    replacement =
      if exprMentions x body then
        if isWildPat pat then x else asPatText src x pat
      else
        patReplacement src pat
    newHead = replaceIdentInLine headPrefix varTok replacement
  in if exprSingleLine body then
    ["${newHead} ${exprText src body}"]
  else
    newHead :: blockBodyLines src.lintSrcLines body (headIndent + 2)

-- | 内部：把全部 alt 渲染成多条 clause 行。
clausesForAlts : LintSrc -> String -> PTok -> String -> Int -> List Alt -> List String
clausesForAlts src headPrefix varTok x headIndent [] = []
clausesForAlts src headPrefix varTok x headIndent (alt :: rest) =
  append
    (caseAltClauseLines src headPrefix varTok x headIndent alt.altPat alt.altBody)
    (clausesForAlts src headPrefix varTok x headIndent rest)

-- | 内部：每个 alt 的 body 在原位置都可安全放置。
altsPlacementOk : LintSrc -> List Alt -> Bool
altsPlacementOk src [] = True
altsPlacementOk src (alt :: rest) =
  liftBodyPlacementOk src alt.altPat alt.altBody && altsPlacementOk src rest

-- | 内部：case 拆 clause 的可行判据：head 模式单行、行区间干净、各 body 可放置。
caseToClausesFixable : LintSrc -> List Pat -> Int -> Span -> List Alt -> Bool
caseToClausesFixable src pats headLine sp alts =
  patsOnLine pats headLine
    && linesCleanRange src.lintSrcLines headLine (spanEndLine sp)
    && altsPlacementOk src alts && altsUnshadowed alts

-- 前一个 alt 的模式蕴含后一个时，拆成 clause 会得到 `PS_ClauseShadowed` / `TC_ClauseUnreachable`
-- 拒绝的源。`countVar x pats == 1` 保证被替换的位置只有一处，其余位置在各 clause 间相同，
-- 所以只比 alt 模式本身即可。
altsUnshadowed : List Alt -> Bool
altsUnshadowed [] = True
altsUnshadowed (alt :: rest) = not (anySubsumedBy alt.altPat rest) && altsUnshadowed rest

anySubsumedBy : Pat -> List Alt -> Bool
anySubsumedBy p [] = False
anySubsumedBy p (alt :: rest) = patSubsumes p alt.altPat || anySubsumedBy p rest

-- | 内部：构造把整个顶层 case 表达式替换成多条 clause 的编辑。
caseToClausesEdit : LintSrc -> String -> List Pat -> Int -> Span -> List Alt -> Edit
caseToClausesEdit src x pats headLine sp alts =
  let
    headText = lineAt src.lintSrcLines headLine
    caseStartLine = spanStartLine sp
    headPrefix =
      if caseStartLine == headLine then
        trimEnd (prefixBeforeCol headText (spanStartCol sp))
      else
        trimEnd headText
    varTok =
      case laneVarSpan x (LClause headLine pats False False) of
        Nothing => PTok TEof (Pos 1 1 0 0)
        Just vsp =>
          case tokenAtOffset src (spanStartOffset vsp) of
            Nothing => PTok TEof (Pos 1 1 0 0)
            Just tok => tok
    headIndent = indentOf headText
  in Edit headLine (spanEndLine sp) (clausesForAlts src headPrefix varTok x headIndent alts)

-- | 内部：函数体是 `case x of`、x 在 head 只出现一次且该名字只有一条 clause 时，产出拆成
-- 多条同名 clause 的 finding。
caseToClauses : LintSrc -> Int -> String -> List Pat -> Expr -> Bool -> List Finding
caseToClauses src headLine name pats (ECase scrut alts sp) singleClause =
  case scrut of
    EVar x _ =>
      if singleClause && countVar x pats == 1 && atLeastTwo alts && altsLiftable x pats alts && caseToClausesFixable src pats headLine (nodeRefSpan sp) alts then
        [
          mkFinding
            (nodeRefSpan sp)
            DispatchLift
            (lintMsg DispatchLift x)
            (Just (caseToClausesEdit src x pats headLine (nodeRefSpan sp) alts))
        ]
      else
        []
    _ => []
caseToClauses src headLine name pats _ singleClause = []

-- ---------------------------------------------------------------
-- AST 遍历（覆盖全部 Expr 构造子；局部函数组在 `BindingValue` 里单独遍历）
--
-- 相互递归组统一把 fuel 放在第 0 形参并 `if fuel <= 0` 守卫：这是编译器
-- `tryFuelThread` 判据能接受的形态（每个环至少一条 `fuel - k` 严格下降边）。
-- ---------------------------------------------------------------
-- | 内部：遍历 clause/alt 的直接体：先尝试 dispatch 提升，成功即不再下沉，否则继续递归并
-- 报告可回退的改写。
scanBodyPos : Int -> LintSrc -> Maybe Lane -> Expr -> List Finding
scanBodyPos fuel src maybeLane expr =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case maybeLane of
      Nothing => walkExpr fuel src expr
      Just lane =>
        let
          lifted = ifLiftFindings src lane expr
        in if not (isNilList lifted) then append lifted (liftFindings src lane expr) else append (liftFindings src lane expr) (walkExpr fuel src expr)

-- | 内部：识别 `handle` 标记载荷（comp / return / op 子句），编码见 `Frontend/Ast.handleSyntax`。
handlePartsOf : Expr -> Maybe (Expr, Expr, Expr)
handlePartsOf (EApp (EVar name _) ([comp, ret, opH]) _) =
  if isHandleSyntax name then Just (comp, ret, opH) else Nothing
handlePartsOf _ = Nothing

-- | 内部：只遍历 handle 里用户写的部分（comp、return 体、op 子句体），不把 parser 合成的
-- case 当成 lane 来源。
walkHandlePayload : Bool -> Int -> LintSrc -> Expr -> Expr -> Expr -> List Finding
walkHandlePayload allow fuel src comp ret opH =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    let
      retFindings =
        case ret of
          ELam ps body _ => walkExprGo allow (fuel - 1) src body
          _ => []
      opFindings =
        case opH of
          ELam ps (ECase _ alts _) _ => walkHandleAlts allow (fuel - 1) src alts
          ELam ps body _ => walkExprGo allow (fuel - 1) src body
          _ => []
    in append (append (walkExprGo allow (fuel - 1) src comp) retFindings) opFindings

-- | 内部：遍历 op 处理器各 alt 的模式与体。
walkHandleAlts : Bool -> Int -> LintSrc -> List Alt -> List Finding
walkHandleAlts allow fuel src alts =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case alts of
      [] => []
      alt :: rest => append (walkPairPat allow (fuel - 1) src alt.altPat) (append (walkExprGo allow (fuel - 1) src alt.altBody) (walkHandleAlts allow (fuel - 1) src rest))

-- | 内部：裸 `Zero` / `Nil` 的 finding（表达式与类型位置共用）。
zeroOrNilFindings : LintSrc -> Expr -> String -> List Finding
zeroOrNilFindings src e "Zero" = natExprFindings src e 0
zeroOrNilFindings src e "Nil" = nilFinding src e
zeroOrNilFindings src e name = []

-- | 内部：按构造子遍历表达式，收集各规则的 finding（不静默丢子树）。
walkExpr : Int -> LintSrc -> Expr -> List Finding
walkExpr fuel src e = walkExprGo True fuel src e

walkExprGo : Bool -> Int -> LintSrc -> Expr -> List Finding
walkExprGo allow fuel src e =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case e of
      EVar name _ => if allow then zeroOrNilFindings src e name else []
      EInt n _ => []
      EStr s _ => []
      EFloat raw _ => []
      ELam ps body _ => walkExprGo allow (fuel - 1) src body
      -- `handle` 标记的载荷是 parser 合成的 λ + case；合成 case
      -- 不能当 dispatch-lift 的 lane 来源，否则会给出改写子句头的错误建议。只遍历用户写的
      -- comp、return 体和各 op 子句体。
      EApp fn args sp =>
        case handlePartsOf (EApp fn args sp) of
          Just (comp, ret, opH) => walkHandlePayload allow (fuel - 1) src comp ret opH
          Nothing => if allow then walkAppList allow (fuel - 1) src e else append (walkExprGo allow (fuel - 1) src fn) (walkExprs allow (fuel - 1) src args)
      EPi name implicit _ dom cod _ => append (walkExprGo allow (fuel - 1) src dom) (walkExprGo allow (fuel - 1) src cod)
      ELet binds body recFlag _ => append (walkBinds allow (fuel - 1) src binds) (walkExprGo allow (fuel - 1) src body)
      ECase scrut alts _ => append (walkExprGo allow (fuel - 1) src scrut) (walkAlts allow (fuel - 1) src alts)
      EIf cond yes no _ => append (constantIfFindings src e) (walkIf allow (fuel - 1) src e cond yes no)
      EField base f _ => walkExprGo allow (fuel - 1) src base
      ERecord rname fields _ => walkFields allow (fuel - 1) src fields
      ERecUpdate base fields _ => append (walkExprGo allow (fuel - 1) src base) (walkFields allow (fuel - 1) src fields)
      EDo stmts _ => walkStmts allow (fuel - 1) src stmts
      -- section（keep 模式下保留原形）：结构递归，不静默丢子树。
      -- 模板字面量：洞内表达式同样参与规则遍历。
      EInterp parts _ => walkInterpParts allow (fuel - 1) src parts

-- | 内部：应用位置的字面量归一检查（nat-literal / list-literal / pair-sugar）；闭合链只产出
-- 一次并继续遍历元素。
walkAppList : Bool -> Int -> LintSrc -> Expr -> List Finding
walkAppList allow fuel src e =
  case natChainCount fuel e of
    Just n => natExprFindings src e n
    Nothing =>
      case pairSugarElems fuel e of
        Just elems => append (pairFindings src e elems) (walkExprs allow fuel src elems)
        Nothing =>
          case consHeadOf e of
            Just (h, t) =>
              case consElems fuel e of
                Just elems => append (consFindings src e elems) (walkExprs allow fuel src elems)
                Nothing => append (walkExprGo allow fuel src h) (walkExprGo allow fuel src t)
            Nothing =>
              case e of
                EApp fn args _ =>
                  append (walkExprGo allow fuel src fn) (walkExprs allow fuel src args)
                _ => []

-- | 内部：遍历模板字面量各段里的洞表达式。
walkInterpParts : Bool -> Int -> LintSrc -> List InterpPart -> List Finding
walkInterpParts allow fuel src parts =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case parts of
      [] => []
      (IPText s) :: rest => walkInterpParts allow (fuel - 1) src rest
      (IPHole e) :: rest => append (walkExprGo False (fuel - 1) src e) (walkInterpParts allow (fuel - 1) src rest)

-- | 内部：处理 if：可识别的字面量链走 case 回退 finding，否则照常遍历条件与两个分支。
walkIf : Bool -> Int -> LintSrc -> Expr -> Expr -> Expr -> Expr -> List Finding
walkIf allow fuel src e cond yes no =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case chainOf src e of
      Nothing => append (walkExprGo allow (fuel - 1) src cond) (append (walkExprGo allow (fuel - 1) src yes) (walkExprGo allow (fuel - 1) src no))
      Just (ChainRes name items defPat defText defExpr) => if not (atLeastTwo items) then append (walkExprGo allow (fuel - 1) src cond) (append (walkExprGo allow (fuel - 1) src yes) (walkExprGo allow (fuel - 1) src no)) else append (chainFindings src (exprSpan e) name items defPat defText defExpr) (append (walkChainItems allow (fuel - 1) src items) (walkExprGo allow (fuel - 1) src defExpr))

-- | 内部：遍历一组表达式。
walkExprs : Bool -> Int -> LintSrc -> List Expr -> List Finding
walkExprs allow fuel src exprs =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case exprs of
      [] => []
      e :: rest => append (walkExprGo allow (fuel - 1) src e) (walkExprs allow (fuel - 1) src rest)

-- | 内部：遍历 record 字段值。
walkFields : Bool -> Int -> LintSrc -> List (String, Expr) -> List Finding
walkFields allow fuel src fields =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case fields of
      [] => []
      (f, e) :: rest => append (walkExprGo allow (fuel - 1) src e) (walkFields allow (fuel - 1) src rest)

-- | 内部：单条绑定的模式 + 值 + 可选签名类型。
walkBinding : Bool -> Int -> LintSrc -> Binding -> List Finding
walkBinding allow fuel src b =
  append (walkPairPat allow (fuel - 1) src b.bindPat) (
      append (walkBindingValue allow (fuel - 1) src b.bindValue) (
          case b.bindSig of
            Just sig => walkExprGo allow (fuel - 1) src sig.sigType
            Nothing => []
        )
    )

-- | 内部：绑定右值（普通表达式递归；局部函数组逐 clause 查）。
walkBindingValue : Bool -> Int -> LintSrc -> BindingValue -> List Finding
walkBindingValue allow fuel src (BVal e) = walkExprGo allow (fuel - 1) src e
walkBindingValue allow fuel src (BClauses clauses) = walkLocalClauses allow (fuel - 1) src clauses

-- | 内部：遍历 let 绑定右值与绑定模式。
walkBinds : Bool -> Int -> LintSrc -> List Binding -> List Finding
walkBinds allow fuel src binds =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case binds of
      [] => []
      b :: rest => append (walkBinding allow (fuel - 1) src b) (walkBinds allow (fuel - 1) src rest)

-- | 内部：逐个 alt 的模式与体按 lane 上下文扫描（最后一个 alt 标记为 isLast）。
walkAlts : Bool -> Int -> LintSrc -> List Alt -> List Finding
walkAlts allow fuel src alts =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case alts of
      [] => []
      alt :: rest =>
        let
          lane = LAlt (spanStartLine (patSpan alt.altPat)) alt.altPat (isNilList rest)
        in append (walkPairPat allow (fuel - 1) src alt.altPat) (append (scanBodyPos (fuel - 1) src (Just lane) alt.altBody) (walkAlts allow (fuel - 1) src rest))

-- | 内部：遍历局部函数 clause 的模式与体（不提供 lane，因此不做 clause 级提升）。
walkLocalClauses : Bool -> Int -> LintSrc -> List LocalClause -> List Finding
walkLocalClauses allow fuel src clauses =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case clauses of
      [] => []
      clause :: rest => append (walkPairPats allow (fuel - 1) src clause.lcPats) (append (walkExprGo allow (fuel - 1) src clause.lcBody) (walkLocalClauses allow (fuel - 1) src rest))

-- | 内部：遍历 do 语句列表。
walkStmts : Bool -> Int -> LintSrc -> List DoStmt -> List Finding
walkStmts allow fuel src stmts =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case stmts of
      [] => []
      stmt :: rest => append (walkStmt allow (fuel - 1) src stmt) (walkStmts allow (fuel - 1) src rest)

-- | 内部：遍历单条 do 语句的绑定模式与表达式。
walkStmt : Bool -> Int -> LintSrc -> DoStmt -> List Finding
walkStmt allow fuel src stmt =
  if fuel <= 0 then
    lintFuelExhausted "traversal"
  else
    case stmt of
      DBind pat e sp => append (walkPairPat allow (fuel - 1) src pat) (walkExprGo allow (fuel - 1) src e)
      DExpr e sp => walkExprGo allow (fuel - 1) src e
      DLet binds sp => walkBinds allow (fuel - 1) src binds

-- ---------------------------------------------------------------
-- 规则 4：list-literal（闭合 cons 链 / 裸 Nil → 列表字面量）
--
-- 只遍历表达式与类型表达式，不进入 pattern：模式里的 `::` / `Cons` 是匹配形态，
-- 不在本规则范围。闭链判据：`::` 或显式 `Cons` 的右嵌套链，尾部是 `[]` 或 `Nil`。
-- 模板插值洞（`EInterp` 的 `IPHole`）跳过：lint 的顶层 token 列表不含洞内 token，
-- 无法用 `exprText` 可靠切片（已知边界，见 docs/reference/lint.md）。
-- ---------------------------------------------------------------
-- | 内部：去掉行首空白。
trimStart : String -> String
trimStart s = strPack (dropLeadingSpace (strUnpack s))

-- | 内部：去掉开头的空白字符。
dropLeadingSpace : List Int -> List Int
dropLeadingSpace [] = []
dropLeadingSpace (c :: rest) = if isSpaceChar c then dropLeadingSpace rest else c :: rest

-- | 内部：字符串首个字符码；空串为 `Nothing`。
firstChar : String -> Maybe Int
firstChar s =
  case strUnpack s of
    c :: rest => Just c
    [] => Nothing

-- | 内部：字符串最后一个字符码；空串为 `Nothing`。
lastChar : String -> Maybe Int
lastChar s =
  case reverse (strUnpack s) of
    c :: rest => Just c
    [] => Nothing

-- | 内部：去掉最后一个字符。
dropLastChar : String -> String
dropLastChar s = strPack (takeChars (strLength s - 1) (strUnpack s))

-- | 内部：去掉第一个字符。
dropFirstChar : String -> String
dropFirstChar s = strPack (dropChars 1 (strUnpack s))

-- | 内部：剥掉紧邻表达式的前后缀成对括号（可多层）：`f (a :: [])` → `f [a]`，而
-- `f (g (a :: []))` 只剥最内层，不会误删属于 `g` 的外层括号。
stripParens : Int -> String -> String -> (String, String)
stripParens fuel prefix suffix =
  if fuel <= 0 then
    (prefix, suffix)
  else
    let
      p = trimEnd prefix
    in case lastChar p of
      Just 40 =>
        case firstChar (trimStart suffix) of
          Just 41 => stripParens (fuel - 1) (dropLastChar p) (dropFirstChar (trimStart suffix))
          _ => (prefix, suffix)
      _ => (prefix, suffix)

-- | 内部：span 末 token 结束列之后的位置（1 基）；找不到末 token 时 `Nothing`。
-- | 内部：把整个单行表达式替换成 replacement 的编辑；跨行、行区间不干净或定位不到结束列时
-- `Nothing`。
exprEdit : LintSrc -> Expr -> String -> Maybe Edit
exprEdit src e replacement =
  if not (exprSingleLine e) then
    Nothing
  else if not (linesCleanRange src.lintSrcLines (exprStartLine e) (spanEndLine (exprSpan e))) then
    Nothing
  else
    let
      endCol = (exprSpan e).spanEndCol
      line = lineAt src.lintSrcLines (exprStartLine e)
      prefix = prefixBeforeCol line (exprStartCol e)
      suffix = tailFromCol line endCol
      stripped = stripParens (strLength line + 1) prefix suffix
    in Just (Edit (exprStartLine e) (exprStartLine e) [firstOf stripped ++ replacement ++ secondOf stripped])

-- | 内部：识别 `::` / `Cons` 应用，返回头与尾。
consHeadOf : Expr -> Maybe (Expr, Expr)
consHeadOf (EApp (EVar name _) ([h, t]) _) =
  if name == "::" || name == "Cons" then Just (h, t) else Nothing
consHeadOf _ = Nothing

-- | 内部：表达式是否为空列表（`Nil` 或 `[]`）。
isNilExpr : Expr -> Bool
isNilExpr (EVar name _) = name == "Nil" || isListNilSyntax name
isNilExpr _ = False

-- | 内部：闭合 cons 链的元素列表；开放链或非链返回 `Nothing`。
consElems : Int -> Expr -> Maybe (List Expr)
consElems fuel e =
  if fuel <= 0 then
    Nothing
  else
    case consHeadOf e of
      Just (h, t) =>
        case consElems (fuel - 1) t of
          Just rest => Just (h :: rest)
          Nothing => Nothing
      Nothing => if isNilExpr e then Just [] else Nothing

-- | 内部：所有切片文本都非空（为空则无法安全生成字面量）。
allNonEmpty : List String -> Bool
allNonEmpty [] = True
allNonEmpty (s :: rest) = s /= "" && allNonEmpty rest

-- | 内部：闭合 cons 链的 finding 与编辑：元素原文齐全时改写成 `[a, b]`，否则只报告 `[...]`。
consFindings : LintSrc -> Expr -> List Expr -> List Finding
consFindings src e elems =
  let
    texts = map (exprText src) elems
    suggestion = if allNonEmpty texts then "[" ++ join ", " texts ++ "]" else "[...]"
    edit = if allNonEmpty texts then exprEdit src e suggestion else Nothing
  in [
    mkFindingAt
      (exprStartLine e)
      (exprStartCol e)
      (exprSpan e)
      ListLiteral
      (lintMsg ListLiteral suggestion)
      edit
  ]

-- | 内部：裸 `Nil` 的 finding 与编辑（改写成 `[]`）。
nilFinding : LintSrc -> Expr -> List Finding
nilFinding src e =
  [
    mkFindingAt
      (exprStartLine e)
      (exprStartCol e)
      (exprSpan e)
      ListLiteral
      (lintMsg ListLiteral "[]")
      (exprEdit src e "[]")
  ]

-- ---------------------------------------------------------------
-- 规则 5：pair-sugar（显式 Pair 应用 → 元组语法）
--
-- `Pair a b` 在值 / 类型位置是 `EApp (EVar "Pair") [a, b]`，在模式位置是
-- `PCon "Pair" [a, b]`；元组语法 `(a, b)` 由 parser 编成保留名、由 Loader 还原成同一个
-- `Pair` 应用 / 模式，所以这条改写只换语法、不改名字解析结果。只认裸名 `Pair`，不做作用域
-- 名字解析；恰好两个实参之外（部分应用 / 值传递）与模板插值洞不处理。
-- ---------------------------------------------------------------
-- | 内部：pair 链的元素表：`e` 是 `Pair` / 元组保留名应用时右嵌套展开，否则就是单元素。
pairTailElems : Int -> Expr -> List Expr
pairTailElems fuel e =
  if fuel <= 0 then
    lintFuelExhausted "pair chain"
  else
    case e of
      EApp (EVar name _) ([a, b]) _ => if name == "Pair" || isTuplePairSyntax name then a :: pairTailElems (fuel - 1) b else [e]
      _ => [e]

-- | 内部：显式 `Pair` 应用的元素表（头部必须是裸 `Pair`）；元组语法本身不报。
pairSugarElems : Int -> Expr -> Maybe (List Expr)
pairSugarElems fuel e =
  if fuel <= 0 then
    lintFuelExhausted "pair chain"
  else
    case e of
      EApp (EVar name _) ([a, b]) _ => if name == "Pair" then Just (a :: pairTailElems (fuel - 1) b) else Nothing
      _ => Nothing

-- | 内部：pair 元素的单行原文。起点取 `startExpr` 的真实起点（中缀 span 从运算符开始），
-- 终点先把元素的末 token 补齐（空字符串 / 列表字面量的 span 末尾可能短一位），再按括号净差
-- 把紧邻的 `(` / `)` / `[` / `]` 补回；跨行时为空串。
pairElemText : LintSrc -> Expr -> String
pairElemText src e =
  if not (exprSingleLine e) then
    ""
  else
    let
      start0 = offsetOfLineCol src (exprStartLine e) (exprStartCol e)
      raw = spanEndOffset (exprSpan e)
      end0 = if raw <= start0 then raw else tokenEndCovering (raw - 1) src.lintSrcToks
      start = widenStart src start0 end0
      end1 = widenEnd src start0 end0
      end = widenBracketEnd src start0 end1
    in if end <= start then exprText src e else trimEnd (sliceOffsets src start end)

-- | 内部：把单行表达式 `e` 整体替换成 `replacement` 的编辑。切片走字节偏移（span 末尾对空
-- 字符串等短一位时按 token 覆盖修正），并剥离紧邻的成对括号；跨行、含注释或偏移缺失时
-- `Nothing`。
subtreeEdit : LintSrc -> Expr -> String -> Maybe Edit
subtreeEdit src e replacement =
  let
    lineNo = exprStartLine e
    line = lineAt src.lintSrcLines lineNo
    lineStart = offsetOfLineCol src lineNo 1
    lineEnd = lineStart + byteLength line
    start0 = offsetOfLineCol src lineNo (exprStartCol e)
    raw = spanEndOffset (exprSpan e)
    end1 = if raw <= start0 then raw else tokenEndCovering (raw - 1) src.lintSrcToks
    end0 = widenBracketEnd src start0 (widenEnd src start0 end1)
  in if not (exprSingleLine e) then
    Nothing
  else if not (linesCleanRange src.lintSrcLines lineNo lineNo) then
    Nothing
  else if raw <= start0 then
    Nothing
  else
    let
      prefix = sliceOffsets src lineStart start0
      suffix = sliceOffsets src end0 lineEnd
      stripped = stripParens (strLength line + 1) prefix suffix
    in Just (Edit lineNo lineNo [firstOf stripped ++ replacement ++ secondOf stripped])

-- | 内部：pair 应用的单行 finding 与编辑：元素原文齐全时改写成 `(a, b)`，否则只报告 `(...)`。
pairFindings : LintSrc -> Expr -> List Expr -> List Finding
pairFindings src e elems =
  let
    texts = map (pairElemText src) elems
    suggestion = if allNonEmpty texts then "(" ++ join ", " texts ++ ")" else "(...)"
    edit = if allNonEmpty texts then subtreeEdit src e suggestion else Nothing
  in [
    mkFindingAt
      (exprStartLine e)
      (exprStartCol e)
      (exprSpan e)
      PairSugar
      (lintMsg PairSugar suggestion)
      edit
  ]

-- | 内部：pair 模式的元素表：`p` 是 `Pair` / 元组保留名模式时右嵌套展开，否则就是单元素。
pairPatTailElems : Int -> Pat -> List Pat
pairPatTailElems fuel p =
  if fuel <= 0 then
    lintFuelExhausted "pair pattern chain"
  else
    case p of
      PCon name ([a, b]) _ => if name == "Pair" || isTuplePairSyntax name then a :: pairPatTailElems (fuel - 1) b else [p]
      _ => [p]

-- | 内部：显式 `Pair` 模式应用的元素表（头部必须是裸 `Pair`）；元组模式本身不报。
pairPatSugarElems : Int -> Pat -> Maybe (List Pat)
pairPatSugarElems fuel p =
  if fuel <= 0 then
    lintFuelExhausted "pair pattern chain"
  else
    case p of
      PCon name ([a, b]) _ => if name == "Pair" then Just (a :: pairPatTailElems (fuel - 1) b) else Nothing
      _ => Nothing

-- | 内部：模式的单行原文；按字节偏移切片（span 末尾对空字符串 / 列表模式可能短一位时按
-- token 覆盖修正），未闭合的 `[` 用紧跟的 `]` 补回；偏移缺失时回落到行列路径。跨行时为空串。
patText1 : LintSrc -> Pat -> String
patText1 src pat =
  let
    sp = patSpan pat
    start = spanStartOffset sp
    raw = spanEndOffset sp
    end0 = if raw <= start then raw else tokenEndCovering (raw - 1) src.lintSrcToks
    end = widenBracketEnd src start end0
  in if not (spanSingleLine sp) then
    ""
  else if end <= start || start == 0 && spanStartCol sp > 1 then
    patText src pat
  else
    trimEnd (sliceOffsets src start end)

-- | 内部：把单行模式替换成 replacement 的编辑。切片走字节偏移（span 末尾短一位时按 token
-- 覆盖修正），并剥离紧邻的成对括号；跨行、含注释或偏移缺失时 `Nothing`。
patSubtreeEdit : LintSrc -> Pat -> String -> Maybe Edit
patSubtreeEdit src pat replacement =
  let
    sp = patSpan pat
    lineNo = spanStartLine sp
    line = lineAt src.lintSrcLines lineNo
    lineStart = offsetOfLineCol src lineNo 1
    lineEnd = lineStart + byteLength line
    start0 = spanStartOffset sp
    raw = spanEndOffset sp
    end1 = if raw <= start0 then raw else tokenEndCovering (raw - 1) src.lintSrcToks
    end0 = widenBracketEnd src start0 (widenEnd src start0 end1)
  in if not (spanSingleLine sp) then
    Nothing
  else if not (linesCleanRange src.lintSrcLines lineNo lineNo) then
    Nothing
  else if raw <= start0 then
    Nothing
  else
    let
      prefix = sliceOffsets src lineStart start0
      suffix = sliceOffsets src end0 lineEnd
      stripped = stripParens (strLength line + 1) prefix suffix
    in Just (Edit lineNo lineNo [firstOf stripped ++ replacement ++ secondOf stripped])

-- | 内部：pair 模式的 finding 与编辑：元素原文齐全时改写成 `(a, b)`，否则只报告 `(...)`。
pairPatFindings : LintSrc -> Pat -> List Pat -> List Finding
pairPatFindings src pat elems =
  let
    texts = map (patText1 src) elems
    suggestion = if allNonEmpty texts then "(" ++ join ", " texts ++ ")" else "(...)"
    edit = if allNonEmpty texts then patSubtreeEdit src pat suggestion else Nothing
    sp = patSpan pat
  in [
    mkFindingAt
      (spanStartLine sp)
      (spanStartCol sp)
      sp
      PairSugar
      (lintMsg PairSugar suggestion)
      edit
  ]

-- ---------------------------------------------------------------
-- 规则 6：nat-literal（闭合 Zero / Succ 链 → Nat 字面量）
--
-- 只认裸名 `Zero` / `Succ`：闭合链（以 `Zero` 收尾）改写成十进制字面量，开放链
-- （`Succ n` / `Succ (f x)`）不是可展开的字面量，不报。模式位置同样适用：精化器把
-- Nat 字面量模式展开成构造子模式，两种写法落到同一个模式矩阵。
-- ---------------------------------------------------------------
-- | 内部：闭合 Nat 构造子链的层数（`Zero` = 0，`Succ ..` = +1）；开放链 / 非链给 `Nothing`。
natChainCount : Int -> Expr -> Maybe Int
natChainCount fuel e =
  if fuel <= 0 then
    lintFuelExhausted "nat chain"
  else
    case e of
      EVar name _ => if name == "Zero" then Just 0 else Nothing
      EApp (EVar name _) ([arg]) _ =>
        if name == "Succ" then
          case natChainCount (fuel - 1) arg of
            Just n => Just (n + 1)
            Nothing => Nothing
        else
          Nothing
      _ => Nothing

-- | 内部：闭合 Nat 链表达式的 finding 与编辑（替换成十进制字面量）。
natExprFindings : LintSrc -> Expr -> Int -> List Finding
natExprFindings src e n =
  let
    suggestion = strFromInt n
  in [
    mkFindingAt
      (exprStartLine e)
      (exprStartCol e)
      (exprSpan e)
      NatLiteral
      (lintMsg NatLiteral suggestion)
      (subtreeEdit src e suggestion)
  ]

-- | 内部：闭合 Nat 构造子模式链的层数；开放链 / 非链给 `Nothing`。
natPatCount : Int -> Pat -> Maybe Int
natPatCount fuel p =
  if fuel <= 0 then
    lintFuelExhausted "nat pattern chain"
  else
    case p of
      PCon name [] _ => if name == "Zero" then Just 0 else Nothing
      PCon name ([arg]) _ =>
        if name == "Succ" then
          case natPatCount (fuel - 1) arg of
            Just n => Just (n + 1)
            Nothing => Nothing
        else
          Nothing
      _ => Nothing

-- | 内部：闭合 Nat 模式链的 finding 与编辑（替换成十进制字面量）。
natPatFindings : LintSrc -> Pat -> Int -> List Finding
natPatFindings src pat n =
  let
    suggestion = strFromInt n
    sp = patSpan pat
  in [
    mkFindingAt
      (spanStartLine sp)
      (spanStartCol sp)
      sp
      NatLiteral
      (lintMsg NatLiteral suggestion)
      (patSubtreeEdit src pat suggestion)
  ]

-- | 内部：模式位置的字面量归一（nat-literal / pair-sugar）；`emit` 为假时只递归
-- （模板插值洞）。
walkPairPat : Bool -> Int -> LintSrc -> Pat -> List Finding
walkPairPat emit fuel src pat =
  if fuel <= 0 then
    lintFuelExhausted "pattern traversal"
  else
    case natPatCount (fuel - 1) pat of
      Just n => if emit then natPatFindings src pat n else []
      Nothing =>
        case pairPatSugarElems (fuel - 1) pat of
          Just elems => if emit then append (pairPatFindings src pat elems) (walkPairPats emit (fuel - 1) src elems) else walkPairPats emit (fuel - 1) src elems
          Nothing =>
            case pat of
              PAs name inner _ => walkPairPat emit (fuel - 1) src inner
              PCon name args _ => walkPairPats emit (fuel - 1) src args
              PRecord name fields _ => walkPairPatFields emit (fuel - 1) src fields
              _ => []

-- | 内部：模式列表的字面量归一（nat-literal / pair-sugar）。
walkPairPats : Bool -> Int -> LintSrc -> List Pat -> List Finding
walkPairPats emit fuel src pats =
  if fuel <= 0 then
    lintFuelExhausted "pattern traversal"
  else
    case pats of
      [] => []
      p :: rest => append (walkPairPat emit (fuel - 1) src p) (walkPairPats emit (fuel - 1) src rest)

-- | 内部：record 模式字段的字面量归一（nat-literal / pair-sugar）。
walkPairPatFields : Bool -> Int -> LintSrc -> List (String, Pat) -> List Finding
walkPairPatFields emit fuel src fields =
  if fuel <= 0 then
    lintFuelExhausted "pattern traversal"
  else
    case fields of
      [] => []
      (f, p) :: rest => append (walkPairPat emit (fuel - 1) src p) (walkPairPatFields emit (fuel - 1) src rest)

-- | 内部：按构造子遍历表达式，收集类型位置的语法归一 finding（list-literal / pair-sugar /
-- nat-literal；不进入模式）。
walkTypeSyntax : Int -> LintSrc -> Expr -> List Finding
walkTypeSyntax fuel src e =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case e of
      EVar name _ => zeroOrNilFindings src e name
      EInt n _ => []
      EStr s _ => []
      EFloat raw _ => []
      ELam ps body _ => walkTypeSyntax (fuel - 1) src body
      EApp fn args _ =>
        case natChainCount (fuel - 1) e of
          Just n => natExprFindings src e n
          Nothing =>
            case pairSugarElems (fuel - 1) e of
              Just elems => append (pairFindings src e elems) (walkTypeSyntaxExprs (fuel - 1) src elems)
              Nothing =>
                case consHeadOf e of
                  Just (h, t) =>
                    case consElems (fuel - 1) e of
                      Just elems => append (consFindings src e elems) (walkTypeSyntaxExprs (fuel - 1) src elems)
                      Nothing => append (walkTypeSyntax (fuel - 1) src h) (walkTypeSyntax (fuel - 1) src t)
                  Nothing => append (walkTypeSyntax (fuel - 1) src fn) (walkTypeSyntaxExprs (fuel - 1) src args)
      EPi name implicit qty dom cod _ => append (walkTypeSyntax (fuel - 1) src dom) (walkTypeSyntax (fuel - 1) src cod)
      ELet binds body recFlag _ => append (walkTypeSyntaxBinds (fuel - 1) src binds) (walkTypeSyntax (fuel - 1) src body)
      ECase scrut alts _ => append (walkTypeSyntax (fuel - 1) src scrut) (walkTypeSyntaxAlts (fuel - 1) src alts)
      EIf cond yes no _ => append (walkTypeSyntax (fuel - 1) src cond) (append (walkTypeSyntax (fuel - 1) src yes) (walkTypeSyntax (fuel - 1) src no))
      EField base f _ => walkTypeSyntax (fuel - 1) src base
      ERecord rname fields _ => walkTypeSyntaxFields (fuel - 1) src fields
      ERecUpdate base fields _ => append (walkTypeSyntax (fuel - 1) src base) (walkTypeSyntaxFields (fuel - 1) src fields)
      EDo stmts _ => walkTypeSyntaxStmts (fuel - 1) src stmts
      -- 模板插值洞：token 切片不可靠，跳过（见本段头注释）。
      EInterp parts _ => []

-- | 内部：遍历一组表达式的类型位置语法归一。
walkTypeSyntaxExprs : Int -> LintSrc -> List Expr -> List Finding
walkTypeSyntaxExprs fuel src exprs =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case exprs of
      [] => []
      e :: rest => append (walkTypeSyntax (fuel - 1) src e) (walkTypeSyntaxExprs (fuel - 1) src rest)

-- | 内部：遍历 record 字段值的类型位置语法归一。
walkTypeSyntaxFields : Int -> LintSrc -> List (String, Expr) -> List Finding
walkTypeSyntaxFields fuel src fields =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case fields of
      [] => []
      (f, e) :: rest => append (walkTypeSyntax (fuel - 1) src e) (walkTypeSyntaxFields (fuel - 1) src rest)

-- | 内部：单条绑定的值 + 可选签名类型（类型位置语法归一）。
walkTypeSyntaxBinding : Int -> LintSrc -> Binding -> List Finding
walkTypeSyntaxBinding fuel src b =
  append (walkTypeSyntaxBindingValue (fuel - 1) src b.bindValue) (
      case b.bindSig of
        Just sig => walkTypeSyntax (fuel - 1) src sig.sigType
        Nothing => []
    )

-- | 内部：绑定右值的类型位置语法归一（局部函数组逐 clause 查）。
walkTypeSyntaxBindingValue : Int -> LintSrc -> BindingValue -> List Finding
walkTypeSyntaxBindingValue fuel src (BVal e) = walkTypeSyntax (fuel - 1) src e
walkTypeSyntaxBindingValue fuel src (BClauses clauses) =
  walkTypeSyntaxLocalClauses (fuel - 1) src clauses

-- | 内部：遍历 let 绑定右值的类型位置语法归一。
walkTypeSyntaxBinds : Int -> LintSrc -> List Binding -> List Finding
walkTypeSyntaxBinds fuel src binds =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case binds of
      [] => []
      b :: rest => append (walkTypeSyntaxBinding (fuel - 1) src b) (walkTypeSyntaxBinds (fuel - 1) src rest)

-- | 内部：遍历 case alt 体的类型位置语法归一。
walkTypeSyntaxAlts : Int -> LintSrc -> List Alt -> List Finding
walkTypeSyntaxAlts fuel src alts =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case alts of
      [] => []
      alt :: rest => append (walkTypeSyntax (fuel - 1) src alt.altBody) (walkTypeSyntaxAlts (fuel - 1) src rest)

-- | 内部：遍历局部函数 clause 体的类型位置语法归一。
walkTypeSyntaxLocalClauses : Int -> LintSrc -> List LocalClause -> List Finding
walkTypeSyntaxLocalClauses fuel src clauses =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case clauses of
      [] => []
      clause :: rest => append (walkTypeSyntax (fuel - 1) src clause.lcBody) (walkTypeSyntaxLocalClauses (fuel - 1) src rest)

-- | 内部：遍历 do 语句的类型位置语法归一。
walkTypeSyntaxStmts : Int -> LintSrc -> List DoStmt -> List Finding
walkTypeSyntaxStmts fuel src stmts =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case stmts of
      [] => []
      stmt :: rest => append (walkTypeSyntaxStmt (fuel - 1) src stmt) (walkTypeSyntaxStmts (fuel - 1) src rest)

-- | 内部：遍历单条 do 语句的类型位置语法归一。
walkTypeSyntaxStmt : Int -> LintSrc -> DoStmt -> List Finding
walkTypeSyntaxStmt fuel src stmt =
  if fuel <= 0 then
    lintFuelExhausted "type syntax traversal"
  else
    case stmt of
      DBind pat e sp => walkTypeSyntax (fuel - 1) src e
      DExpr e sp => walkTypeSyntax (fuel - 1) src e
      DLet binds sp => walkTypeSyntaxBinds (fuel - 1) src binds

-- ---------------------------------------------------------------
-- 声明遍历与结果整理
-- ---------------------------------------------------------------
-- | 内部：同一名字在后续声明里还有没有函数子句（用于判断是否最后一条 clause）。
laterHasFun : String -> List Decl -> Bool
laterHasFun name [] = False
laterHasFun name (d :: rest) =
  case d of
    DFun n pats body sp => n == name || laterHasFun name rest
    _ => laterHasFun name rest

-- | 内部：类型里是否出现隐式 Pi（`{n : Nat} -> ...`）。
--
-- 这类签名的函数跳过 clause 级改写：parser 的 clause 模式是所有显式参数，隐式参数由精化器
-- 插入，把 case 折叠进 clause 模式会改变模式矩阵与隐式 Pi 的对齐。literal-if-chain 与函数
-- 参数无关，不受影响。
hasImplicitPi : Expr -> Bool
hasImplicitPi (EPi name implicit _ dom cod _) = implicit || hasImplicitPi cod
hasImplicitPi (EApp (EVar "->" _) ([dom, cod]) _) = hasImplicitPi dom || hasImplicitPi cod
hasImplicitPi _ = False

-- | 内部：按名字查类型签名。
sigTyOf : String -> List Decl -> Maybe Expr
sigTyOf name [] = Nothing
sigTyOf name (d :: rest) =
  case d of
    DSig n ctx ty sp => if n == name then Just ty else sigTyOf name rest
    _ => sigTyOf name rest

-- | 内部：该函数的签名是否含隐式 Pi。
hasImplicitSig : String -> List Decl -> Bool
hasImplicitSig name decls =
  case sigTyOf name decls of
    Nothing => False
    Just ty => hasImplicitPi ty

-- | 内部：某名字的函数子句条数。
countFunClauses : String -> List Decl -> Int
countFunClauses name [] = 0
countFunClauses name (d :: rest) =
  case d of
    DFun n pats body sp => (if n == name then 1 else 0) + countFunClauses name rest
    _ => countFunClauses name rest

-- | 内部：扫描 instance 方法：方法体走 dispatch 规则，模式走 pair-sugar，签名与类型位置走
-- 类型位置的语法归一。
scanMethodDecls : LintSrc -> List Decl -> List Finding
scanMethodDecls src [] = []
scanMethodDecls src (d :: rest) =
  case d of
    DFun name pats body sp =>
      append
        (walkPairPats True lintFuel src pats)
        (append (walkExpr lintFuel src body) (scanMethodDecls src rest))
    DSig name ctx ty sp =>
      append
        (walkTypeSyntaxExprs lintFuel src ctx)
        (append (walkTypeSyntax lintFuel src ty) (scanMethodDecls src rest))
    DAxiom name ty sp => append (walkTypeSyntax lintFuel src ty) (scanMethodDecls src rest)
    _ => scanMethodDecls src rest

-- | 内部：record 各字段的类型表达式。
fieldTypes : List Field -> List Expr
fieldTypes [] = []
fieldTypes (f :: rest) = fieldType f :: fieldTypes rest

-- | 内部：data 各构造子的类型表达式。
ctorTypes : List Ctor -> List Expr
ctorTypes [] = []
ctorTypes (c :: rest) = ctorType c :: ctorTypes rest

-- | 内部：trait 各方法的类型表达式。
traitMethodTypes : List TraitMethod -> List Expr
traitMethodTypes [] = []
traitMethodTypes (m :: rest) = m.traitMethodType :: traitMethodTypes rest

-- | 内部：trait 参数的 kind 表达式（未标注 kind 的参数跳过）。
traitParamKinds : List TraitParam -> List Expr
traitParamKinds [] = []
traitParamKinds ((TraitParam name kind) :: rest) =
  case kind of
    Just e => e :: traitParamKinds rest
    Nothing => traitParamKinds rest

-- | 内部：只保留结构不变的语法归一 finding（nat-literal / list-literal / pair-sugar）。
-- 隐式 Pi 签名的函数跳过 clause 级改写（会改变模式矩阵与隐式 Pi 的对齐），但这些规则只换
-- 语法、不动 clause 结构，因此其体仍扫描。
onlySyntaxFindings : List Finding -> List Finding
onlySyntaxFindings [] = []
onlySyntaxFindings (f :: rest) =
  if f.findingCode == lintCode NatLiteral || f.findingCode == lintCode ListLiteral || f.findingCode == lintCode PairSugar then
    f :: onlySyntaxFindings rest
  else
    onlySyntaxFindings rest

-- | 内部：单条声明的 finding：函数子句做 clause 拆分、直接体扫描与模式 pair-sugar（隐式 Pi
-- 签名跳过 clause 级改写），签名、axiom、extern、data、record、trait、instance 的类型位置走
-- 类型位置的语法归一。
declFindings : LintSrc -> List Decl -> Decl -> List Decl -> List Finding
declFindings src allDecls (DFun name pats body r) rest =
  let
    line = spanStartLine (nodeRefSpan r)
    bodyFindings =
      if hasImplicitSig name allDecls then
        onlySyntaxFindings (walkExpr lintFuel src body)
      else
        let
          lastForName = not (laterHasFun name rest)
          singleClause = countFunClauses name allDecls == 1
          lane = LClause line pats lastForName singleClause
        in append (caseToClauses src line name pats body singleClause) (scanBodyPos lintFuel src (Just lane) body)
  in append (walkPairPats True lintFuel src pats) bodyFindings
declFindings src allDecls (DSig name ctx ty sp) rest =
  append (walkTypeSyntaxExprs lintFuel src ctx) (walkTypeSyntax lintFuel src ty)
declFindings src allDecls (DAxiom name ty sp) rest = walkTypeSyntax lintFuel src ty
declFindings src allDecls (DExtern name cName ty sp) rest = walkTypeSyntax lintFuel src ty
declFindings src allDecls (DData name params kind ctors derivings viaField repr lin sp) rest =
  append (walkTypeSyntax lintFuel src kind) (walkTypeSyntaxExprs lintFuel src (ctorTypes ctors))
declFindings src allDecls (DRecord name params fields derivings viaField repr lin sp) rest =
  walkTypeSyntaxExprs lintFuel src (fieldTypes fields)
declFindings src allDecls (DTrait name params supers methods sp) rest =
  append
    (walkTypeSyntaxExprs lintFuel src supers)
    (append (walkTypeSyntaxExprs lintFuel src (traitParamKinds params)) (walkTypeSyntaxExprs lintFuel src (traitMethodTypes methods)))
declFindings src allDecls (DInstance ctxE head methods sp) rest =
  append
    (walkTypeSyntaxExprs lintFuel src ctxE)
    (append (walkTypeSyntax lintFuel src head) (scanMethodDecls src methods))

-- | 内部：逐条声明收集 finding。
scanDecls : LintSrc -> List Decl -> List Decl -> List Finding
scanDecls src allDecls [] = []
scanDecls src allDecls (d :: rest) =
  append (declFindings src allDecls d rest) (scanDecls src allDecls rest)

-- | 内部：用主体 span 构造一条 finding（start/end 与默认严重度）。
mkFinding : Span -> LintRule -> String -> Maybe Edit -> Finding
mkFinding sp rule msg edit = mkFindingAt (spanStartLine sp) (spanStartCol sp) sp rule msg edit

-- | 内部：显式起始位置（中缀链的 span 从运算符开始，展示位置仍取子树真实起点）。
mkFindingAt : Int -> Int -> Span -> LintRule -> String -> Maybe Edit -> Finding
mkFindingAt line col sp rule msg edit =
  Finding
    line
    col
    (spanEndLine sp)
    (spanEndCol sp + 1)
    (lintCode rule)
    (lintRule rule)
    msg
    (lintDefaultSeverity rule)
    edit

-- | 内部：按（行, 列）升序排序 finding（插入排序）。
sortFindings : List Finding -> List Finding
sortFindings [] = []
sortFindings (f :: rest) = insertFinding f (sortFindings rest)

-- | 内部：把一个 finding 按（行, 列）顺序插入。
insertFinding : Finding -> List Finding -> List Finding
insertFinding f [] = [f]
insertFinding f (g :: rest) =
  if f.findingLine < g.findingLine then
    f :: g :: rest
  else if f.findingLine == g.findingLine && f.findingCol <= g.findingCol then
    f :: g :: rest
  else
    g :: insertFinding f rest

-- | 内部：big 的替换行范围是否严格包含 small（两端都相等不算包含）。
editContains : Edit -> Edit -> Bool
editContains big small =
  big.editStart
    <= small.editStart
    && big.editEnd
    >= small.editEnd && (big.editStart < small.editStart || big.editEnd > small.editEnd)

-- | 内部：该 edit 是否被任一外层 edit 包含。
coveredByEdit : List Edit -> Edit -> Bool
coveredByEdit [] e = False
coveredByEdit (outer :: rest) e = editContains outer e || coveredByEdit rest e

-- | 内部：丢弃起点已过当前行的外层 edit（它们不可能再包含后续 finding）。
pruneOpen : Int -> List Edit -> List Edit
pruneOpen line [] = []
pruneOpen line (e :: rest) =
  if e.editEnd >= line then e :: pruneOpen line rest else pruneOpen line rest

-- | 内部：按 finding 顺序去重；只保留仍可能包含当前 finding 的外层 edit。
dedupFindings : List Finding -> List Finding
dedupFindings findings = dedupGo [] findings

-- | 内部：`dedupFindings` 的累加器实现。
dedupGo : List Edit -> List Finding -> List Finding
dedupGo open [] = []
dedupGo open (f :: rest) =
  let
    open2 = pruneOpen f.findingLine open
  in case f.findingEdit of
    Nothing => f :: dedupGo open2 rest
    Just e => if coveredByEdit open2 e then dedupGo open2 rest else f :: dedupGo (e :: open2) rest

-- | 内部：`if True/False` 常量条件（默认关闭）。
constantIfFindings : LintSrc -> Expr -> List Finding
constantIfFindings src (EIf cond yes no sp) =
  case cond of
    EVar "True" _ => branchFinding src (EIf cond yes no sp) yes
    EVar "False" _ => branchFinding src (EIf cond yes no sp) no
    _ => []
constantIfFindings src _ = []

-- | 内部：用选中分支替换整个 if；无法切片时只报告。
branchFinding : LintSrc -> Expr -> Expr -> List Finding
branchFinding src whole branch =
  let
    text = exprText src branch
  in if text == "" then
    []
  else
    [
      mkFindingAt
        (exprStartLine whole)
        (exprStartCol whole)
        (exprSpan whole)
        RedundantIf
        (lintMsg RedundantIf text)
        (exprEdit src whole text)
    ]

-- | 内部：注释里的 TODO / FIXME / XXX 标记（每个注释最多一条）。
todoFindings : List Comment -> List Finding
todoFindings [] = []
todoFindings (c :: rest) =
  case markerOf c.commentText of
    Nothing => todoFindings rest
    Just marker =>
      mkFindingAt
        (spanStartLine c.commentSpan)
        (spanStartCol c.commentSpan)
        c.commentSpan
        TodoMarker
        (lintMsg TodoMarker marker)
        Nothing :: todoFindings rest

-- | 内部：识别注释文本里的标记（按固定顺序取第一个）。
markerOf : String -> Maybe String
markerOf text =
  if contains "TODO" text then
    Just "TODO"
  else if contains "FIXME" text then
    Just "FIXME"
  else if contains "XXX" text then Just "XXX" else Nothing

-- | 解析源码并按配置/抑制过滤后返回 finding（按（行, 列）排序、去掉被包含的内层结果）。
--
-- 规则看 AST 的中缀结构，所以重排必须与程序级 fixity 一致：`programFixities` 是本文件的
-- `infix` 声明加上 import 闭包可见的声明（由调用方算），这里把它放在本文件声明（parse
-- 得到的 env）之前，本地优先，与 loader 的顺序一致。缺声明时严格报 unknown fixity，不静默
-- 按默认优先级重排。
export lintSourceWithConfig : LintConfig -> List FixityDecl -> String -> Check (List Finding)
lintSourceWithConfig cfg programFixities source =
  case parseSourceDetailed "<lint>" source of
    ErrC e => ErrC e
    OkC p => lintParsedWithConfig cfg programFixities source p

-- | 同 `lintSourceWithConfig`，但源码**已经**解析过（调用方要和 fixity 上下文共用同一次词法）。
export lintParsedWithConfig : LintConfig -> List FixityDecl -> String -> ParsedSource -> Check (List Finding)
lintParsedWithConfig cfg programFixities source parsed =
  case parsed.parsedFile of
    SourceFile _ _ fx decls0 _ _ _ =>
      let
        comments = parsed.parsedComments
        rawToks = parsed.parsedRawToks
      in case parseSuppression comments of
        ErrC e => ErrC e
        OkC suppression =>
          case reorderProgram (tableOfKeepOpsCst parsed.parsedCst (append programFixities fx)) decls0 of
            ErrC e => ErrC e
            OkC decls =>
              let
                src = mkLintSrc source rawToks
                raw =
                  append
                    (dedupFindings (sortFindings (scanDecls src decls decls)))
                    (todoFindings comments)
                filtered = filterFindings cfg suppression raw
              in OkC filtered

-- | 内部：按配置严重度与源码抑制过滤 finding。
filterFindings : LintConfig -> Suppression -> List Finding -> List Finding
filterFindings cfg suppression [] = []
filterFindings cfg suppression (f :: rest) =
  case lintRuleOfName f.findingRule of
    Nothing => filterFindings cfg suppression rest
    Just rule =>
      if lintRuleSeverity cfg rule == LintOff then
        filterFindings cfg suppression rest
      else if isSuppressed suppression f.findingLine rule then
        filterFindings cfg suppression rest
      else
        { f | findingSeverity = lintRuleSeverity cfg rule } :: filterFindings cfg suppression rest

-- | 解析源码并按默认配置返回 finding（兼容入口）。
export lintSourceWith : List FixityDecl -> String -> Check (List Finding)
lintSourceWith = lintSourceWithConfig defaultLintConfig
