-- | 目录遍历工具（fmt / doc / test / Index 共用）。
--
-- 遍历骨架在 [Vuna.Compiler.Base.Walk]：`.gitignore` 生效（`result-*` / `.direnv` 等
-- 生成物由仓库规则排除），本模块只提供 `skipGenerated` 名单与后缀谓词。
-- 路径拆分（`splitPath` / `baseName`）在 `Vuna.Compiler.Base.Common`，供编译器驱动与工具共用。
--
-- 内建 `fsIsDirectory` 对**不存在的路径**会抛异常（直接终止进程），所以任何来自用户输入的
-- 路径都必须先用 [Vuna.Files.pathExistsDir] 判存在，不要直接调用 `fsIsDirectory`。
--
-- 目录遍历、存在性判定与读文件全部显式在 `Eff r` 里，纯过滤/路径/名称逻辑
-- （`skipGenerated` 等）保持纯函数。
module Vuna.Files where

import Base.Effect.Types as EffTypes
import Base.Effect.Fs as EffFs
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Walk

-- | 内部：效果列表遍历（本模块自用；顺序与纯 `map` 一致）。
mapEff : {r : Row} -> (a -> Eff r b) -> List a -> Eff r (List b)
mapEff f [] = pure []
mapEff f (x :: rest) =
  do
    y <- f x
    ys <- mapEff f rest
    pure (y :: ys)

-- | 遍历时按条目名跳过的目录：生成物、本地缓存、工具产物与夹具目录。它们可能包含符号链接或
-- 超大文件，既不该被格式化，也不该被 doc / test 扫描；`corpus` 下的 `.vuna` 大量是故意
-- 不合法的源码（解析 / 缩进 / 类型错误用例），格式化器与文档生成器不应扫到。
skipGenerated : String -> Bool
skipGenerated name =
  name
    == ".git"
    || name
    == ".local"
    || name
    == ".output"
    || name
    == ".direnv"
    || name
    == "node_modules"
    || name
    == ".vscode"
    || name == "_scratch" || name == ".dsh-plugins" || name == "result" || name == "corpus"

-- | 递归收集目录下所有 `.vuna` 文件（跳过 `.git`、`.gitignore` 命中项与 `skipGenerated`
-- 命中的目录；目录不存在返回空列表）。
export collectVunaFiles : Member n FsOp r => String -> Eff r (List String)
collectVunaFiles dir = collectFilesEff skipGenerated (\name => endsWith ".vuna" name) dir

-- | 递归收集目录下所有非隐藏项（文件与目录，同样跳过 `.gitignore` 命中项与
-- `skipGenerated`）；用于不按后缀筛选的通用遍历。目录不存在返回空列表。
export collectSourceFiles : Member n FsOp r => String -> Eff r (List String)
collectSourceFiles dir = collectFilesEff skipGenerated (\_ => True) dir

-- | 安全的目录判定：不存在返回 `False`，而不是抛异常（`fsIsDirectory` 的前置守卫）。
export pathExistsDir : Member n FsOp r => String -> Eff r Bool
pathExistsDir path =
  do
    exists <- pathExistsFile path
    if exists then fsIsDirectory path else pure False

-- | 路径存在性判定（文件或目录均可）。
export pathExistsFile : Member n FsOp r => String -> Eff r Bool
pathExistsFile path = fsFileExists path

-- ---------------------------------------------------------------
-- 诊断码 → 示例夹具（`explain`/`gen-errors` 共用；生成物不参与门禁）
-- ---------------------------------------------------------------
-- | 内部：各包的 suite corpus 目录（相对仓库根）。
corpusDirs : List String
corpusDirs =
  [
    "packages/compiler/test/corpus",
    "packages/base/test/corpus",
    "packages/cli/test/corpus",
    "packages/web-cli/test/corpus"
  ]

-- | 在包 suite 的 corpus（及旧 `test/corpus` / cwd 下的 `corpus`）找第一个包含该码的
-- `.diag.json`；返回路径按 `corpus/...` 归一，`explain` / `gen-errors` 输出不随仓库布局变化。
export exampleOf : Member n FsOp r => String -> Eff r (Maybe String)
exampleOf code =
  do
    found <-
      firstDiagExample
        (append (append corpusDirs (map (\d => "../${d}") corpusDirs)) (append (map (\d => "../../${d}") corpusDirs) (append (map (\d => "../../../${d}") corpusDirs) ["test/corpus", "corpus", "../test/corpus"])))
        code
    pure (fmap corpusRelPath found)

-- | 内部：按顺序找第一个命中的目录。
firstDiagExample : Member n FsOp r => List String -> String -> Eff r (Maybe String)
firstDiagExample [] code = pure Nothing
firstDiagExample (dir :: rest) code =
  do
    found <- findDiagExample 512 dir code
    case found of
      Just p => pure (Just p)
      Nothing => firstDiagExample rest code

-- | 内部：绝对/仓库相对路径 → `corpus/...`（已经是该形状时原样返回）。
corpusRelPath : String -> String
corpusRelPath path =
  if startsWith "test/" path then
    substring 5 (byteLength path - 5) path
  else
    case split "/test/" path of
      before :: rest =>
        case rest of
          after :: _ => after
          [] => path
      [] => path

-- | 内部：带 fuel 的递归搜索；每个条目按字典序展开，先命中的先返回。
findDiagExample : Member n FsOp r => Int -> String -> String -> Eff r (Maybe String)
findDiagExample fuel dir code =
  if fuel <= 0 then
    pure Nothing
  else
    do
      exists <- pathExistsDir dir
      if not exists then
        pure Nothing
      else
        do
          names <- fsReadDir dir
          fmap firstJustExamples (mapEff (oneEntry (fuel - 1) dir code) names)

-- | 内部：`findDiagExample` 的单条目步进——目录递归，`.diag.json` 文件按文本里的
-- `"code":"<码>"` 匹配。
oneEntry : Member n FsOp r => Int -> String -> String -> String -> Eff r (Maybe String)
oneEntry fuel dir code name =
  if name == "." || name == ".." || name == ".git" || name == ".local" then
    pure Nothing
  else
    let
      path = "${dir}/${name}"
    in do
      exists <- pathExistsDir path
      if exists then
        findDiagExample fuel path code
      else if not (endsWith ".diag.json" name) then
        pure Nothing
      else
        do
          isFile <- pathExistsFile path
          if isFile then
            do
              text <- fsReadFile path
              pure (if contains "\"code\":\"${code}\"" text then Just path else Nothing)
          else
            pure Nothing

-- | 内部：取第一个 `Just`。
firstJustExamples : List (Maybe String) -> Maybe String
firstJustExamples [] = Nothing
firstJustExamples ((Just x) :: rest) = Just x
firstJustExamples (Nothing :: rest) = firstJustExamples rest
