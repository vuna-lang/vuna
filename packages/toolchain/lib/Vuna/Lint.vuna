-- | vuna 源码风格检查与自动修复（`vuna lint`）的 CLI 门面。
--
-- 本模块负责参数解析、目标展开、逐文件读盘、配置/抑制应用、输出与 `--fix` 循环；
-- 规则扫描与源码切片在 [Vuna.Lint.Rules]，配置在 [Vuna.Lint.Config]，抑制指令在
-- [Vuna.Lint.Suppress]，编辑应用在 [Vuna.Lint.Fix]，规则元数据在
-- [Vuna.Lint.Diagnostics]。
--
-- 退出码：0 表示没有达到失败阈值；1 表示有 error finding 或 warning 超过
-- `max-warnings`；2 表示用法错误、配置/读盘/解析/fixity 上下文错误。
module Vuna.Lint where

import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Result
import Base.Data.Sort as Sort
import Base.Data.String as String
import Base.Effect.Fs as EffFs
import Base.Effect.Console as EffConsole
import Base.Effect.Types as EffTypes
import Base.Effect.Env as EffEnv
import Base.Effect.Process as EffProcess
import Base.Effect.Stdin as EffStdin
import Base.Thread as Thread
import Base.Thread.Par as Par
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Hash
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Frontend.Parser
import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Spec
import Vuna.Files
import Vuna.FixityEnv
import Vuna.Json
import Vuna.Lint.Config
import Vuna.Lint.Diagnostics
import Vuna.Lint.Fix
import Vuna.Lint.Rules

-- ---------------------------------------------------------------
-- 输出格式
-- ---------------------------------------------------------------
-- | CLI 输出格式。
data LintFormat : Type where
  -- | 现有 `路径:行:列: [CODE] rule: message` 文本。
  LintText : LintFormat
  -- | 稳定 JSON（CI/编辑器消费）。
  LintJson : LintFormat
  -- | GitHub Actions 注解。
  LintGithub : LintFormat
  -- | SARIF 2.1.0（CI 代码扫描）。
  LintSarif : LintFormat

-- | 内部：是否 JSON 输出（避免为格式枚举引入 Eq）。
isJsonFormat : LintFormat -> Bool
isJsonFormat LintJson = True
isJsonFormat _ = False

-- | 一次 CLI 运行的选项。
record LintOpts where
  lintOptFix : Bool
  lintOptDry : Bool
  lintOptQuiet : Bool
  lintOptFormat : LintFormat
  lintOptMaxPasses : Int
  lintOptNoConfig : Bool
  lintOptConfigPath : Maybe String
  lintOptSelect : List String
  lintOptIgnore : List String
  lintOptMaxWarnings : Maybe Int
  lintOptDiff : Bool

defaultLintOpts : LintOpts
defaultLintOpts = LintOpts False False False LintText 8 False Nothing [] [] Nothing False

-- | 单个文件的结果。
record FileOutcome where
  fileOutcomePath : String
  fileOutcomeFindings : List Finding
  fileOutcomeFixed : Int
  fileOutcomeError : Maybe String
  -- | `--fix --diff` 的（原文, 修复后）；由父线程按文件顺序打印。
  fileOutcomeDiff : Maybe (String, String)

-- | 一次 lint 运行内跨文件复用的上下文：fixity 模块图与配置缓存。
record LintRunEnv where
  lintRunFixity : FixityEnv
  lintRunConfig : LintConfigEnv

emptyLintRunEnv : LintRunEnv
emptyLintRunEnv = LintRunEnv emptyFixityEnv emptyLintConfigEnv

-- ---------------------------------------------------------------
-- finding 渲染 / 打印
-- ---------------------------------------------------------------
-- | 把一条 finding 渲染成 `path:line:col: [code] rule: message`；`fixMode` 为真时追加
-- `(not auto-fixable)` 标记。CLI 打印与测试断言共用这一份格式。
export renderFinding : String -> Bool -> Finding -> String
renderFinding path fixMode f =
  let
    suffix = if fixMode then " (not auto-fixable)" else ""
  in "${path}:${f.findingLine}:${f.findingCol}: [${f.findingCode}] ${f.findingRule}: ${f.findingMessage}${suffix}"

-- | `--fix` 的「已修复 N 条」报告行：`path: fixed N finding(s)`。
-- | `--fix --dry-run` 的「将修复 N 条」报告行。
renderDryFixReport : String -> Int -> String
renderDryFixReport path count = "${path}: would fix ${count} finding(s)"

export renderFixReport : String -> Int -> String
renderFixReport path count = "${path}: fixed ${count} finding(s)"

-- | 内部：打印一条 finding（带换行），返回 0。
printFinding : Member nConsole ConsoleOp r => String -> Bool -> Finding -> Eff r Int
printFinding path fixMode f =
  do
    _ <- consolePrint "${renderFinding path fixMode f}\n"
    pure 0

-- | 内部：按顺序打印全部 finding，返回 0。
printFindings : Member nConsole ConsoleOp r => String -> Bool -> List Finding -> Eff r Int
printFindings path fixMode [] = pure 0
printFindings path fixMode (f :: rest) =
  do
    _ <- printFinding path fixMode f
    printFindings path fixMode rest

-- | 内部：打印 findings（兼容测试侧入口；不改变文本格式）。
export reportFindings : Member nConsole ConsoleOp r => String -> Bool -> List Finding -> Eff r Int
reportFindings path fixMode findings =
  do
    _ <- printFindings path fixMode findings
    pure 0

-- ---------------------------------------------------------------
-- 计数 / 严重度
-- ---------------------------------------------------------------
-- | 内部：FileOutcome 字段投影（避免裸 lambda 里依赖字段推断）。
fileFindings : FileOutcome -> List Finding
fileFindings o = o.fileOutcomeFindings

fileFixed : FileOutcome -> Int
fileFixed o = o.fileOutcomeFixed

fileError : FileOutcome -> Maybe String
fileError o = o.fileOutcomeError

-- | 内部：统计某个严重度的 finding 数。
countSeverity : LintSeverity -> List Finding -> Int
countSeverity sev [] = 0
countSeverity sev (f :: rest) = (if f.findingSeverity == sev then 1 else 0) + countSeverity sev rest

-- | 内部：全部 finding 的计数。
countErrors : List FileOutcome -> Int
countErrors outcomes = foldl (\n, o => n + countSeverity LintError (fileFindings o)) 0 outcomes

countWarnings : List FileOutcome -> Int
countWarnings outcomes = foldl (\n, o => n + countSeverity LintWarn (fileFindings o)) 0 outcomes

countFindings : List FileOutcome -> Int
countFindings outcomes = foldl (\n, o => n + length (fileFindings o)) 0 outcomes

countFixed : List FileOutcome -> Int
countFixed outcomes = foldl (\n, o => n + fileFixed o) 0 outcomes

-- | 内部：finding 是否可自动修复。
isFixable : Finding -> Bool
isFixable f = isJust f.findingEdit

-- | 内部：某条 finding 是否应该打印（quiet 只隐藏 warning）。
visibleFinding : Bool -> Finding -> Bool
visibleFinding True f = f.findingSeverity == LintError
visibleFinding False f = True

-- ---------------------------------------------------------------
-- 目标展开
-- ---------------------------------------------------------------
-- | 内部：展开一个位置参数：目录递归收集 `.vuna`，文件原样保留。
expandLintPath : Member nFs FsOp r => String -> Eff r (List String)
expandLintPath path =
  do
    isDir <- pathExistsDir path
    if isDir then collectVunaFiles path else pure [path]

-- | 内部：按用户顺序展开路径。
expandLintPaths : Member nFs FsOp r => List String -> Eff r (List String)
expandLintPaths [] = pure []
expandLintPaths (path :: rest) =
  do
    here <- expandLintPath path
    there <- expandLintPaths rest
    pure (append here there)

-- | 内部：去重并保持首次出现顺序。
dedupePaths : List String -> List String
dedupePaths [] = []
dedupePaths (path :: rest) =
  if memName path rest then dedupePaths rest else path :: dedupePaths rest

-- | 内部：包的源码目标（默认不扫 test，避免把故意不干净的夹具当门禁）。
packageLintTargets : Package -> List String
packageLintTargets pkg = ["${packageDir pkg}/lib", "${packageDir pkg}/app"]

-- | 内部：workspace 默认目标：各包的 lib/app 中真实存在的目录。
defaultLintTargets : Member nFs FsOp r, Member nEnv EnvOp r => Eff r (Check (List String))
defaultLintTargets =
  do
    found <- findManifestDirMaybe "."
    case found of
      Nothing => pure (err "not inside a vuna workspace (no vuna.toml found); pass PATH explicitly")
      Just dir =>
        do
          pkgsR <- workspacePackages dir
          case pkgsR of
            ErrC e => pure (ErrC e)
            OkC pkgs =>
              do
                targets <- existingDirs (concatMap packageLintTargets pkgs) []
                files <- expandLintPaths targets
                pure (OkC (dedupePaths files))

-- | 内部：保留真实存在的目录。
existingDirs : Member nFs FsOp r => List String -> List String -> Eff r (List String)
existingDirs [] acc = pure (reverse acc)
existingDirs (path :: rest) acc =
  do
    exists <- pathExistsDir path
    if exists then existingDirs rest (path :: acc) else existingDirs rest acc

-- ---------------------------------------------------------------
-- 配置
-- ---------------------------------------------------------------
-- | 内部：配置的来源（显式文件 / 默认 / 就近 manifest），走目录级缓存。
configForFile : Member nFs FsOp r => LintOpts -> LintConfigEnv -> String -> Eff r (LintConfigEnv, Check LintConfig)
configForFile opts cfgEnv path =
  case opts.lintOptConfigPath of
    Just p =>
      do
        cfg <- loadLintConfigAt p
        pure (cfgEnv, cfg)
    Nothing =>
      if opts.lintOptNoConfig then
        pure (cfgEnv, OkC defaultLintConfig)
      else
        lintConfigForFileCached cfgEnv path

-- | 内部：整次运行的配置（`max-warnings` 的阈值来源）。取运行根（cwd）的 manifest 链；
-- 每个文件的配置只决定该文件的规则严重度与 exclude。
configForRun : Member nFs FsOp r => LintOpts -> LintConfigEnv -> Eff r (LintConfigEnv, Check LintConfig)
configForRun opts cfgEnv =
  case opts.lintOptConfigPath of
    Just p =>
      do
        cfg <- loadLintConfigAt p
        pure (cfgEnv, cfg)
    Nothing =>
      if opts.lintOptNoConfig then
        pure (cfgEnv, OkC defaultLintConfig)
      else
        lintConfigForDirCached cfgEnv "."

-- | 内部：命令行覆盖（select / ignore / max-warnings）。
applyOpts : LintOpts -> LintConfig -> Check LintConfig
applyOpts opts cfg =
  let
    selected =
      if length opts.lintOptSelect == 0 then OkC cfg else selectRules opts.lintOptSelect cfg
  in case selected of
    ErrC e => ErrC e
    OkC cfg1 =>
      let
        ignored =
          if length opts.lintOptIgnore == 0 then OkC cfg1 else ignoreRules opts.lintOptIgnore cfg1
      in case ignored of
        ErrC e => ErrC e
        OkC cfg2 =>
          OkC (
              case opts.lintOptMaxWarnings of
                Just n => withMaxWarnings n cfg2
                Nothing => cfg2
            )

-- | 内部：读完整 stdin（分块，最多 64 MiB 量级）。
readStdinAll : Member nStdin StdinOp r => Eff r String
readStdinAll = readStdinGo 1024 []

readStdinGo : Member nStdin StdinOp r => Int -> List String -> Eff r String
readStdinGo fuel acc =
  if fuel <= 0 then
    pure (join "" (reverse acc))
  else
    do
      chunk <- stdinReadBytes 65536
      case chunk of
        Nothing => pure (join "" (reverse acc))
        Just s => if s == "" then pure (join "" (reverse acc)) else readStdinGo (fuel - 1) (s :: acc)

-- ---------------------------------------------------------------
-- 调度：目标 / 分组 / 装箱
-- ---------------------------------------------------------------
-- | 内部：一个 lint 目标。`index` 是它在输入里的位置，父线程按它恢复输出顺序。
record LintTarget where
  lintTargetIndex : Int
  lintTargetPath : String
  -- | 分组键：Ok 上下文用 `contextDir`，Err 用文件所在目录。
  lintTargetGroup : String
  -- | 目录级预解析结果；在 fixity 阶段才收口，被 exclude / 解析失败的文件不碰它。
  lintTargetContext : Check PackageContext
  -- | 源字节数；装箱权重（大文件近似更贵）。
  lintTargetSize : Int

-- | 内部：同一分组键下的一组目标。
record LintGroup where
  lintGroupKey : String
  lintGroupTargets : List LintTarget

-- | 内部：一个 worker 顺序处理的一块文件（同一包上下文）。
record LintUnit where
  lintUnitContext : Check PackageContext
  lintUnitTargets : List LintTarget

-- | 内部：一个 worker 的装载（若干 unit 顺序执行）。
record LintBin where
  lintBinWeight : Int
  lintBinUnits : List LintUnit

-- | 内部：每单元文件数上限。单包过大时切开，避免一个包钉住一个 worker；切块各自加载
-- 一次模块图，所以上限远大于常见包大小。
lintUnitFiles : Int
lintUnitFiles = 128

-- | 内部：worker 数上限。并行度再高时每个 worker 重载自己的上下文模块图、GC 并行开销
-- 会抵消收益。
lintMaxWorkers : Int
lintMaxWorkers = 8

-- | 内部：按输入位置枚举目标。
enumerateTargets : List String -> List (Int, String)
enumerateTargets paths = enumerateTargetsGo 0 paths

enumerateTargetsGo : Int -> List String -> List (Int, String)
enumerateTargetsGo _ [] = []
enumerateTargetsGo i (path :: rest) = (i, path) :: enumerateTargetsGo (i + 1) rest

isStdinTarget : (Int, String) -> Bool
isStdinTarget t = secondOf t == "-"

-- | 内部：按目录缓存 `contextForFile`（键与 `FixityEnv` 的 `dirKey` 一致）。
resolveTargets : Member nFs FsOp r, Member nEnv EnvOp r => List (Int, String) -> Eff r (List LintTarget)
resolveTargets targets = resolveTargetsGo targets [] []

resolveTargetsGo : Member nFs FsOp r, Member nEnv EnvOp r => List (Int, String) -> List (String, Check PackageContext) -> List LintTarget -> Eff r (List LintTarget)
resolveTargetsGo [] _ acc = pure (reverse acc)
resolveTargetsGo (t :: rest) cache acc =
  let
    path = secondOf t
    dir = parentOf path
  in case lookupContext dir cache of
    Just ctxR =>
      do
        size <- targetSize path
        resolveTargetsGo rest cache (mkTarget t dir ctxR size :: acc)
    Nothing =>
      do
        ctxR <- contextForFile path
        size <- targetSize path
        resolveTargetsGo rest ((dir, ctxR) :: cache) (mkTarget t dir ctxR size :: acc)

-- | 内部：源字节数（缺失按 0 计；只影响装箱权重）。
targetSize : Member nFs FsOp r => String -> Eff r Int
targetSize path =
  do
    sizeR <- fsFileSize path
    pure (
        case sizeR of
          Just n => natToInt n
          Nothing => 0
      )

lookupContext : String -> List (String, Check PackageContext) -> Maybe (Check PackageContext)
lookupContext _ [] = Nothing
lookupContext key ((k, v) :: rest) = if k == key then Just v else lookupContext key rest

mkTarget : (Int, String) -> String -> Check PackageContext -> Int -> LintTarget
mkTarget t dir ctxR size =
  let
    key =
      case ctxR of
        OkC ctx => "ctx:${contextDir ctx}"
        ErrC _ => "dir:${dir}"
  in LintTarget (firstOf t) (secondOf t) key ctxR size

-- | 内部：按分组键聚合（保持首次出现顺序与组内输入顺序）。
groupTargets : List LintTarget -> List LintGroup
groupTargets targets = foldl addGroup [] targets

addGroup : List LintGroup -> LintTarget -> List LintGroup
addGroup [] t = [LintGroup t.lintTargetGroup [t]]
addGroup (g :: rest) t =
  if g.lintGroupKey == t.lintTargetGroup then
    LintGroup g.lintGroupKey (append g.lintGroupTargets [t]) :: rest
  else
    g :: addGroup rest t

-- | 内部：切块（每块 ≤ `size`，保持输入顺序）；`fuel` 是剩余块数上界。
chunkTargets : Int -> List LintTarget -> List (List LintTarget)
chunkTargets size xs =
  let
    width = if size < 1 then 1 else size
  in chunkTargetsGo width (natToInt (length xs)) xs

chunkTargetsGo : Int -> Int -> List LintTarget -> List (List LintTarget)
chunkTargetsGo size fuel xs =
  if fuel <= 0 then
    []
  else
    case xs of
      [] => []
      _ => take size xs :: chunkTargetsGo size (fuel - 1) (drop size xs)

-- | 内部：组 → 单元。
groupUnits : LintGroup -> List LintUnit
groupUnits g =
  case g.lintGroupTargets of
    [] => []
    first :: _ =>
      map
        (\chunk => LintUnit first.lintTargetContext chunk)
        (chunkTargets lintUnitFiles g.lintGroupTargets)

-- | 内部：每个单元加载一次模块图的固定开销（折算成字节，参与装箱）。
lintContextWeight : Int
lintContextWeight = 200000

targetWeight : LintTarget -> Int
targetWeight t = t.lintTargetSize

-- | 内部：装箱权重 = 源字节数 + 每个上下文的固定开销。大文件 / 大包近似更贵。
unitWeight : LintUnit -> Int
unitWeight u = foldl (\n, t => n + targetWeight t) 0 u.lintUnitTargets + lintContextWeight

emptyBins : Int -> List LintBin
emptyBins n = if n <= 0 then [] else LintBin 0 [] :: emptyBins (n - 1)

minBinWeight : List LintBin -> Int
minBinWeight [] = 0
minBinWeight (b :: rest) = minBinWeightGo b.lintBinWeight rest

minBinWeightGo : Int -> List LintBin -> Int
minBinWeightGo m [] = m
minBinWeightGo m (b :: rest) =
  minBinWeightGo (if b.lintBinWeight < m then b.lintBinWeight else m) rest

placeUnitAt : Int -> Int -> LintUnit -> List LintBin -> List LintBin
placeUnitAt _ _ _ [] = []
placeUnitAt target weight u (b :: rest) =
  if b.lintBinWeight == target then
    LintBin (b.lintBinWeight + weight) (append b.lintBinUnits [u]) :: rest
  else
    b :: placeUnitAt target weight u rest

placeUnit : LintUnit -> List LintBin -> List LintBin
placeUnit u bins = placeUnitAt (minBinWeight bins) (unitWeight u) u bins

hasUnits : LintBin -> Bool
hasUnits b =
  case b.lintBinUnits of
    [] => False
    _ => True

-- | 内部：LPT 装箱：大块优先，放进当前最轻的 bin。
assignUnits : Int -> List LintUnit -> List LintBin
assignUnits jobs units =
  let
    sorted = Sort.sortBy (\a, b => unitWeight a >= unitWeight b) units
    bins = foldl (\bs, u => placeUnit u bs) (emptyBins jobs) sorted
  in filter hasUnits bins

-- ---------------------------------------------------------------
-- 单文件
-- ---------------------------------------------------------------
-- | 内部：对一份已知源码做 lint；上下文由调用方按目录预解析，fixity 阶段才收口。
lintText : Member nFs FsOp r => LintOpts -> LintRunEnv -> Check PackageContext -> String -> String -> String -> Eff r (LintRunEnv, FileOutcome)
lintText opts env ctxR displayPath configPath source =
  do
    cfgR <- configForFile opts env.lintRunConfig configPath
    let env1 = { env | lintRunConfig = firstOf cfgR }
    case secondOf cfgR of
      ErrC e => pure (env1, FileOutcome displayPath [] 0 (Just (diagText e)) Nothing)
      OkC cfg0 =>
        case applyOpts opts cfg0 of
          ErrC e => pure (env1, FileOutcome displayPath [] 0 (Just (diagText e)) Nothing)
          OkC cfg =>
            if lintExcluded displayPath cfg then
              pure (env1, FileOutcome displayPath [] 0 Nothing Nothing)
            else
              case parseSourceDetailed configPath source of
                ErrC e => pure (env1, FileOutcome displayPath [] 0 (Just (diagText e)) Nothing)
                OkC parsed =>
                  case ctxR of
                    ErrC e => pure (env1, FileOutcome displayPath [] 0 (Just (diagText e)) Nothing)
                    OkC ctx =>
                      do
                        looked <- fixitiesForCtx env1.lintRunFixity ctx configPath parsed.parsedFile
                        let env2 = { env1 | lintRunFixity = firstOf looked }
                        case secondOf looked of
                          ErrC e => pure (env2, FileOutcome displayPath [] 0 (Just (diagText e)) Nothing)
                          OkC programFixities =>
                            let
                              importedDecls = importedDeclsOf env2.lintRunFixity configPath parsed.parsedFile
                            in case lintParsedWithImports cfg programFixities importedDecls source parsed of
                              ErrC e => pure (env2, FileOutcome displayPath [] 0 (Just (diagText e)) Nothing)
                              OkC findings =>
                                do
                                  fixedR <- if opts.lintOptFix then fixFileWith opts cfg displayPath programFixities importedDecls source findings else pure (OkC (findings, 0, Nothing))
                                  pure (
                                      case fixedR of
                                        ErrC e => (env2, FileOutcome displayPath [] 0 (Just (diagText e)) Nothing)
                                        OkC (remaining, fixed, diff) => (env2, FileOutcome displayPath remaining fixed Nothing diff)
                                    )

-- | 内部：lint 一个文件目标（上下文已预解析）。
lintTargetFile : Member nFs FsOp r => LintOpts -> LintRunEnv -> LintTarget -> Eff r (LintRunEnv, FileOutcome)
lintTargetFile opts env t =
  do
    textR <- readText t.lintTargetPath
    case textR of
      ErrC e => pure (env, FileOutcome t.lintTargetPath [] 0 (Just (diagText e)) Nothing)
      OkC source => lintText opts env t.lintTargetContext t.lintTargetPath t.lintTargetPath source

-- | 内部：lint stdin（配置路径按 `stdin.vuna` 解析）。
lintStdinTarget : Member nStdin StdinOp r, Member nFs FsOp r => LintOpts -> LintRunEnv -> Check PackageContext -> Eff r (LintRunEnv, FileOutcome)
lintStdinTarget opts env ctxR =
  do
    source <- readStdinAll
    lintText opts env ctxR "<stdin>" "stdin.vuna" source

-- | 内部：打印 `--diff`（外部 `diff -u`；只用于人读，不影响退出码）。
printDiff : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> String -> Eff r Int
printDiff path oldSource newSource =
  do
    tmp0 <- envGetEnv "TMPDIR"
    tmp <- pure (if tmp0 == "" then "/tmp" else tmp0)
    base <- pure "${tmp}/vuna-lint-diff-${contentAddress path}"
    oldPath <- pure "${base}.old"
    newPath <- pure "${base}.new"
    outPath <- pure "${base}.out"
    cmd <- pure "diff -u '${oldPath}' '${newPath}' > '${outPath}' || true"
    _ <- fsWriteFile oldPath oldSource
    _ <- fsWriteFile newPath newSource
    _ <- processRunIn "." ["sh", "-c", cmd]
    exists <- fsFileExists outPath
    text <- if exists then fsReadFile outPath else pure ""
    msg <- pure (if text == "" then "" else "${text}\n")
    _ <- consolePrint msg
    _ <- fsRemoveFile oldPath
    _ <- fsRemoveFile newPath
    _ <- if exists then fsRemoveFile outPath else pure 0
    pure 0

-- | 内部：fix 单文件（dry-run / 原子写 / 重新 lint 聚在一处）。`--diff` 只带回修复前后的
-- 文本，打印由父线程按文件顺序完成。
fixFileWith : Member nFs FsOp r => LintOpts -> LintConfig -> String -> List FixityDecl -> List Decl -> String -> List Finding -> Eff r (Check (List Finding, Int, Maybe (String, String)))
fixFileWith opts cfg path programFixities importedDecls source findings =
  case fixLoop cfg programFixities importedDecls source findings opts.lintOptMaxPasses 0 of
    ErrC e => pure (ErrC e)
    OkC (count, newSource) =>
      if count == 0 then
        pure (OkC (findings, 0, Nothing))
      else if opts.lintOptDiff then
        pure (OkC (findings, count, Just (source, newSource)))
      else if opts.lintOptDry then
        pure (OkC (findings, count, Nothing))
      else
        do
          _ <- fsWriteFileAtomic path newSource
          pure (
              case lintSourceWithImports cfg programFixities importedDecls newSource of
                ErrC e => ErrC e
                OkC remaining => OkC (remaining, count, Nothing)
            )

-- ---------------------------------------------------------------
-- 多文件 / 输出
-- ---------------------------------------------------------------
-- | 内部：worker 里按单元顺序 lint，返回（输入位置, 结果）；env 在单元间复用。
lintUnitRun : Member nFs FsOp r => LintOpts -> LintRunEnv -> LintUnit -> Eff r (LintRunEnv, List (Int, FileOutcome))
lintUnitRun opts env u = lintUnitGo opts env u.lintUnitTargets []

lintUnitGo : Member nFs FsOp r => LintOpts -> LintRunEnv -> List LintTarget -> List (Int, FileOutcome) -> Eff r (LintRunEnv, List (Int, FileOutcome))
lintUnitGo _ env [] acc = pure (env, reverse acc)
lintUnitGo opts env (t :: rest) acc =
  do
    stepped <- lintTargetFile opts env t
    lintUnitGo opts (firstOf stepped) rest ((t.lintTargetIndex, secondOf stepped) :: acc)

-- | 内部：worker 里 lint 一个 bin（unit 间共享 fixity 模块图 / 配置缓存）。
lintBin : Member nFs FsOp r => LintOpts -> LintBin -> Eff r (List (Int, FileOutcome))
lintBin opts b = lintBinGo opts emptyLintRunEnv b.lintBinUnits []

lintBinGo : Member nFs FsOp r => LintOpts -> LintRunEnv -> List LintUnit -> List (Int, FileOutcome) -> Eff r (List (Int, FileOutcome))
lintBinGo _ _ [] acc = pure (reverse acc)
lintBinGo opts env (u :: rest) acc =
  do
    stepped <- lintUnitRun opts env u
    lintBinGo opts (firstOf stepped) rest (append (secondOf stepped) acc)

-- | 内部：父线程处理 stdin（`-`；`--fix` 直接拒绝）。
lintStdinMaybe : Member nStdin StdinOp r, Member nFs FsOp r, Member nEnv EnvOp r => LintOpts -> List (Int, String) -> Eff r (List (Int, FileOutcome))
lintStdinMaybe _ [] = pure []
lintStdinMaybe opts (t :: _) =
  if opts.lintOptFix then
    pure [(firstOf t, FileOutcome "<stdin>" [] 0 (Just "--fix does not support stdin") Nothing)]
  else
    do
      ctxR <- contextForFile "stdin.vuna"
      stepped <- lintStdinTarget opts emptyLintRunEnv ctxR
      pure [(firstOf t, secondOf stepped)]

-- | 内部：收集 worker 结果；chunk 级宿主失败（写盘等）汇总成工具错误。
collectBins : List (Result (List (Int, FileOutcome))) -> List (Int, FileOutcome) -> List String -> (List (Int, FileOutcome), List String)
collectBins [] acc errs = (acc, reverse errs)
collectBins (r :: rest) acc errs =
  case r of
    Ok xs => collectBins rest (append acc xs) errs
    Err msg => collectBins rest acc (msg :: errs)

-- | 内部：按输入位置恢复输出顺序。
orderOutcomes : List (Int, FileOutcome) -> List FileOutcome
orderOutcomes pairs = map secondOf (Sort.sortBy (\a, b => firstOf a <= firstOf b) pairs)

-- | 内部：并行 lint——父线程解析上下文、按包分组并装箱，worker 只装 fs 行。
-- 返回（按输入顺序的结果, worker 级宿主错误）。
lintFiles : Member nFs FsOp r, Member nEnv EnvOp r, Member nStdin StdinOp r => LintOpts -> List String -> Eff r (List FileOutcome, List String)
lintFiles opts paths =
  do
    par <- Thread.parallelism
    let
      jobsCap = if par > lintMaxWorkers then lintMaxWorkers else par
      indexed = enumerateTargets paths
      files = filter (\t => not (isStdinTarget t)) indexed
      stdinTargets = filter isStdinTarget indexed
    stdinOutcomes <- lintStdinMaybe opts stdinTargets
    resolved <- resolveTargets files
    let
      groups = groupTargets resolved
      units = concatMap groupUnits groups
      jobs = jobsCap
      unitCount = natToInt (length units)
      jobCount = if jobs > unitCount then unitCount else jobs
      bins = assignUnits jobCount units
    ran <- Par.parMapEffWith jobs runFsResult (lintBin opts) bins
    let collected = collectBins ran stdinOutcomes []
    pure (orderOutcomes (firstOf collected), secondOf collected)

-- | 内部：文本/注解输出。
printOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printOutcomes opts outcomes =
  case opts.lintOptFormat of
    LintText => printTextOutcomes opts outcomes
    LintGithub => printGithubOutcomes opts outcomes
    LintJson => pure 0
    LintSarif => pure 0

printTextOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printTextOutcomes opts [] = pure 0
printTextOutcomes opts (o :: rest) =
  case o.fileOutcomeError of
    Just msg =>
      do
        _ <- consoleEprint "${o.fileOutcomePath}: error: ${msg}\n"
        printTextOutcomes opts rest
    Nothing =>
      do
        _ <-
          if o.fileOutcomeFixed > 0 then
            fmap
              natToInt
              (consolePrint "${if opts.lintOptDry then renderDryFixReport o.fileOutcomePath o.fileOutcomeFixed else renderFixReport o.fileOutcomePath o.fileOutcomeFixed}\n")
          else
            pure 0
        _ <-
          printFindings
            o.fileOutcomePath
            (opts.lintOptFix && not opts.lintOptDry)
            (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)
        printTextOutcomes opts rest

printGithubOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printGithubOutcomes opts [] = pure 0
printGithubOutcomes opts (o :: rest) =
  case o.fileOutcomeError of
    Just msg =>
      do
        _ <- consoleEprint "${o.fileOutcomePath}: error: ${msg}\n"
        printGithubOutcomes opts rest
    Nothing =>
      do
        _ <-
          printGithubFindings
            o.fileOutcomePath
            (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)
        printGithubOutcomes opts rest

printGithubFindings : Member nConsole ConsoleOp r => String -> List Finding -> Eff r Int
printGithubFindings path [] = pure 0
printGithubFindings path (f :: rest) =
  let
    level = if f.findingSeverity == LintError then "error" else "warning"
    msg =
      "::${level} file=${path},line=${f.findingLine},col=${f.findingCol},endLine=${f.findingEndLine},endColumn=${f.findingEndCol},title=${f.findingCode}::${f.findingRule}: ${f.findingMessage}"
  in do
    _ <- consolePrint "${msg}\n"
    printGithubFindings path rest

-- | 内部：JSON 输出（stdout 只输出一个 JSON 对象）。
printJsonOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printJsonOutcomes opts outcomes =
  do
    _ <- consolePrint "${renderJson (outcomeJson opts outcomes)}\n"
    pure 0

-- | 内部：SARIF 2.1.0 输出。
printSarifOutcomes : Member nConsole ConsoleOp r => LintOpts -> List FileOutcome -> Eff r Int
printSarifOutcomes opts outcomes =
  do
    _ <- consolePrint "${renderJson (sarifJson opts outcomes)}\n"
    pure 0

-- | 内部：SARIF 文档。
sarifJson : LintOpts -> List FileOutcome -> Json
sarifJson opts outcomes =
  JObj
    [("version", JStr "2.1.0"), ("$schema", JStr "https://json.schemastore.org/sarif-2.1.0.json"), ("runs", JArr [JObj [("tool", JObj [("driver", JObj [("name", JStr "vuna-lint"), ("rules", JArr (map sarifRule lintAll))])]), ("results", JArr (concatMap (sarifResults opts) outcomes))]])]

sarifRule : LintEntry -> Json
sarifRule e =
  JObj
    [("id", JStr e.lintEntryCode), ("name", JStr e.lintEntryRule), ("shortDescription", JObj [("text", JStr e.lintEntryDesc)]), ("properties", JObj [("fixable", JBool e.lintEntryFixable)])]

sarifResults : LintOpts -> FileOutcome -> List Json
sarifResults opts o =
  map
    (sarifFinding o.fileOutcomePath)
    (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)

sarifFinding : String -> Finding -> Json
sarifFinding path f =
  JObj
    [("ruleId", JStr f.findingCode), ("level", JStr (if f.findingSeverity == LintError then "error" else "warning")), ("message", JObj [("text", JStr "${f.findingRule}: ${f.findingMessage}")]), ("locations", JArr [JObj [("physicalLocation", JObj [("artifactLocation", JObj [("uri", JStr path)]), ("region", JObj [("startLine", JNum f.findingLine), ("startColumn", JNum f.findingCol), ("endLine", JNum f.findingEndLine), ("endColumn", JNum f.findingEndCol)])])]])]

-- | 内部：JSON 对象。
outcomeJson : LintOpts -> List FileOutcome -> Json
outcomeJson opts outcomes =
  JObj
    [("version", JNum 1), ("findings", JArr (concatMap (outcomeFindingsJson opts) outcomes)), ("errors", JArr (mapMaybe outcomeErrorJson outcomes)), ("summary", JObj [("files", JNum (length outcomes)), ("errors", JNum (countErrors outcomes)), ("warnings", JNum (countWarnings outcomes)), ("fixable", JNum (countFixable outcomes)), ("fixed", JNum (countFixed outcomes))])]

outcomeFindingsJson : LintOpts -> FileOutcome -> List Json
outcomeFindingsJson opts o =
  map
    (findingJson o.fileOutcomePath)
    (filter (visibleFinding opts.lintOptQuiet) o.fileOutcomeFindings)

outcomeErrorJson : FileOutcome -> Maybe Json
outcomeErrorJson o =
  case o.fileOutcomeError of
    Nothing => Nothing
    Just msg => Just (JObj [("path", JStr o.fileOutcomePath), ("message", JStr msg)])

findingJson : String -> Finding -> Json
findingJson path f =
  JObj
    [("path", JStr path), ("line", JNum f.findingLine), ("column", JNum f.findingCol), ("endLine", JNum f.findingEndLine), ("endColumn", JNum f.findingEndCol), ("code", JStr f.findingCode), ("rule", JStr f.findingRule), ("severity", JStr (if f.findingSeverity == LintError then "error" else "warning")), ("message", JStr f.findingMessage), ("fixable", JBool (isJust f.findingEdit))]

-- | 内部：可修复 finding 数。
countFixable : List FileOutcome -> Int
countFixable outcomes = foldl (\n, o => n + length (filter isFixable (fileFindings o))) 0 outcomes

-- | 内部：退出码：工具错误 2 > error/超限 warning 1 > 0。
outcomeCode : LintOpts -> LintConfig -> List FileOutcome -> Int
outcomeCode opts cfg outcomes =
  if anyError outcomes then
    2
  else if countErrors outcomes > 0 then
    1
  else if opts.lintOptMaxWarnings /= Nothing then
    warningLimitCode opts outcomes
  else if lintMaxWarnings cfg >= 0 && countWarnings outcomes > lintMaxWarnings cfg then 1 else 0

warningLimitCode : LintOpts -> List FileOutcome -> Int
warningLimitCode opts outcomes =
  case opts.lintOptMaxWarnings of
    Just n => if n < 0 then 0 else if countWarnings outcomes > n then 1 else 0
    Nothing => 0

anyError : List FileOutcome -> Bool
anyError outcomes = length (filter (\o => fileError o /= Nothing) outcomes) > 0

-- | 内部：按文件顺序打印 `--diff` 载荷（父线程；worker 不碰进程级 cwd）。
printDiffs : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List FileOutcome -> Eff r Int
printDiffs [] = pure 0
printDiffs (o :: rest) =
  do
    _ <-
      case o.fileOutcomeDiff of
        Nothing => pure 0
        Just pair => printDiff o.fileOutcomePath (firstOf pair) (secondOf pair)
    printDiffs rest

-- | 内部：worker 级宿主失败（写盘 / 读盘竞态）按工具错误报告。
printToolErrors : Member nConsole ConsoleOp r => List String -> Eff r Int
printToolErrors [] = pure 0
printToolErrors (msg :: rest) =
  do
    _ <- consoleEprint "error: ${msg}\n"
    printToolErrors rest

-- | 内部：输出全部结果并给出退出码。阈值取整次运行的配置（`configForRun`），不随
-- 第一个文件所在包变化。
finishLint : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => LintOpts -> List FileOutcome -> Eff r Int
finishLint opts outcomes =
  do
    _ <- printDiffs outcomes
    _ <-
      case opts.lintOptFormat of
        LintJson => printJsonOutcomes opts outcomes
        LintSarif => printSarifOutcomes opts outcomes
        _ => printOutcomes opts outcomes
    case outcomes of
      [] => pure 0
      _ =>
        do
          cfgR <- configForRun opts emptyLintConfigEnv
          case secondOf cfgR of
            ErrC e =>
              do
                _ <- consoleEprint "error: ${diagText e}\n"
                pure 2
            OkC cfg0 =>
              case applyOpts opts cfg0 of
                ErrC e =>
                  do
                    _ <- consoleEprint "error: ${diagText e}\n"
                    pure 2
                OkC cfg => pure (outcomeCode opts cfg outcomes)

-- ---------------------------------------------------------------
-- 规则信息
-- ---------------------------------------------------------------
-- | 内部：打印规则清单。
printRuleList : Member nConsole ConsoleOp r => Eff r Int
printRuleList = printRules lintAll

printRules : Member nConsole ConsoleOp r => List LintEntry -> Eff r Int
printRules [] = pure 0
printRules (e :: rest) =
  do
    _ <- consolePrint "${e.lintEntryCode}  ${e.lintEntryRule}  ${e.lintEntryDesc}\n"
    printRules rest

-- | 内部：打印单条规则的详细信息。
printRuleExplain : Member nConsole ConsoleOp r => String -> Eff r Int
printRuleExplain name =
  case lintRuleOfName name of
    Nothing =>
      do
        _ <- consoleEprint "error: unknown lint rule: ${name}\n"
        pure 2
    Just rule =>
      do
        _ <- consolePrint "${lintCode rule}\n"
        _ <- consolePrint "  rule: ${lintRule rule}\n"
        _ <- consolePrint "  description: ${lintDesc rule}\n"
        _ <- consolePrint "  fixable: ${if lintFixable rule then "yes" else "no"}\n"
        _ <- consolePrint "  edit: ${lintEdit rule}\n"
        pure 0

-- ---------------------------------------------------------------
-- 参数
-- ---------------------------------------------------------------
-- | 内部：`vuna lint` 的用法文本。
lintUsage : String
lintUsage = """usage: vuna lint [OPTIONS] [PATH]...
  PATH 可为文件或目录，`-` 表示 stdin；省略时扫 workspace 各包的 lib/ 与 app/
  --fix                 应用可自动修复的 finding（原子写）
  --dry-run             与 --fix 同用：只报告会修复多少条，不写盘
  --diff                与 --fix 同用：打印 unified diff，不写盘
  --format FORMAT       text（默认）| json | github | sarif
  --max-warnings N      warning 超过 N 条时 exit 1（-1 = 不限）
  --quiet               只打印 error finding
  --select RULE         只启用给定规则（可重复）
  --ignore RULE         关闭给定规则（可重复）
  --config PATH         使用显式 vuna.toml 的 [lint]
  --no-config           不读 vuna.toml，使用默认配置
  --max-passes N        --fix 最多迭代 N 轮（默认 8）
  --list                列出规则
  --explain RULE        解释单条规则
"""

lintUsageError : Member nConsole ConsoleOp r => Int -> Eff r Int
lintUsageError _ =
  do
    _ <- consoleEprint lintUsage
    pure 2

-- | 内部：解析非负/`-1` 整数。
parseIntArg : String -> Maybe Int
parseIntArg s =
  case strUnpack s of
    45 :: rest =>
      case readDigits rest of
        Just n => Just (0 - n)
        Nothing => Nothing
    _ => readDigits (strUnpack s)

readDigits : List Int -> Maybe Int
readDigits [] = Nothing
readDigits (c :: rest) = if c >= 48 && c <= 57 then readMoreDigits rest (c - 48) else Nothing

readMoreDigits : List Int -> Int -> Maybe Int
readMoreDigits [] acc = Just acc
readMoreDigits (c :: rest) acc =
  if c >= 48 && c <= 57 then readMoreDigits rest (acc * 10 + (c - 48)) else Nothing

-- | 内部：解析选项；格式/整数非法给 `Nothing`。
parseLintOpts : Parsed -> Maybe LintOpts
parseLintOpts parsed =
  case formatOf (flagValue parsed "format") of
    Nothing => Nothing
    Just fmt =>
      case intOf (flagValue parsed "max-warnings") (0 - 2) of
        Nothing => Nothing
        Just maxWarnings =>
          case intOf (flagValue parsed "max-passes") 8 of
            Nothing => Nothing
            Just maxPasses =>
              if maxPasses <= 0 || maxWarnings /= -2 && maxWarnings < -1 then
                Nothing
              else
                Just
                  (LintOpts (flagSet parsed "fix") (flagSet parsed "dry-run") (flagSet parsed "quiet") fmt maxPasses (flagSet parsed "no-config") (flagValue parsed "config") (flagValues parsed "select") (flagValues parsed "ignore") (if maxWarnings == -2 then Nothing else Just maxWarnings) (flagSet parsed "diff"))

formatOf : Maybe String -> Maybe LintFormat
formatOf Nothing = Just LintText
formatOf (Just "text") = Just LintText
formatOf (Just "json") = Just LintJson
formatOf (Just "github") = Just LintGithub
formatOf (Just "sarif") = Just LintSarif
formatOf _ = Nothing

intOf : Maybe String -> Int -> Maybe Int
intOf Nothing d = Just d
intOf (Just s) d = parseIntArg s

-- | `vuna lint` 的入口。
export runLint : Member nConsole ConsoleOp r, Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nStdin StdinOp r => List String -> Eff r Int
runLint args =
  case parseCmdArgs ["lint"] args of
    ErrC e =>
      do
        _ <- consoleEprint "error: ${diagText e}\n"
        pure 2
    OkC parsed =>
      if flagSet parsed "list" then
        printRuleList
      else
        case flagValue parsed "explain" of
          Just rule => printRuleExplain rule
          Nothing =>
            case parseLintOpts parsed of
              Nothing =>
                do
                  _ <- consoleEprint "error: invalid lint option value\n"
                  pure 2
              Just opts =>
                do
                  targetsR <- if length parsed.positionals == 0 then defaultLintTargets else fmap (\xs => OkC xs) (expandLintPaths parsed.positionals)
                  case targetsR of
                    ErrC e =>
                      do
                        _ <- consoleEprint "error: ${diagText e}\n"
                        pure 2
                    OkC targets =>
                      if length (dedupePaths targets) == 0 then
                        do
                          _ <- consoleEprint "error: no vuna sources found\n"
                          pure 2
                      else
                        do
                          ran <- lintFiles opts (dedupePaths targets)
                          _ <- printToolErrors (secondOf ran)
                          code <- finishLint opts (firstOf ran)
                          pure (if length (secondOf ran) > 0 then 2 else code)
