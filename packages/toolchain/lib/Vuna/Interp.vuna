-- | 工具链侧的核心求值 facade（编译入口见 [Vuna.Compiler.Driver.Compile]）。
--
-- 语义是**精化后的核心求值**：按包上下文（最近 `vuna.toml` 的依赖闭包；无 manifest 时
-- base-only）加载，经 DT 精化器检查，再用 Core 的 NbE 求 `main` 的值。因此子句元数、类型、
-- 覆盖性等错误都在求值前报出，错误位置与 `check` 一致。
--
-- 入口吃 `PackageContext`（没有环境根 / `List Root`）；调用方（REPL / test runner）
-- 负责从文件、cwd 或包构造上下文。求值是**纯**的：不执行效果，`main : Eff r a` 一律报错；
-- 真正带 `consolePrint` / 文件效果的 `main` 请用 `compile` + 运行产物。
--
-- 工具链能力（都不属于编译器 seed 闭包）：`evalExprInfoWithAux`（表达式值 + zonk 后
-- 类型文本，REPL 用类型判断是否动作）、`inferDefTypes` / `bindingTypes` / `checkProgram`。
-- 动作程序（`main : Eff r a`）的执行入口是 [Vuna.EffectRun.runEffectSource]。
module Vuna.Interp where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Driver.Compile
import Base.Effect.Core
import Base.Effect.Clock as EffClock
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes
import Base.Effect.Args as EffArgs
import Base.Effect.Exit as EffExit

-- | 求值一个入口文件：成功返回值的渲染文本，失败返回 `error: <诊断>` 文本。
export interpretFile : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r String
interpretFile ctx entry =
  do
    result <- dtEvalFile ctx entry
    pure (
        case result of
          ErrC e => "error: ${diagText e}"
          OkC output => output
      )

-- | 值文本 + zonk 后的类型文本（`showTerm` 渲染，可直接写回合成签名），并带回可复用的
-- `AuxCache`。类型文本形如 `((Base.Effect.Core.Eff Base.Effect.Core.Row.Nil) Int)`（canonical 全名）；
-- REPL 据此决定是否走效果执行。缓存复用依赖包 decls 的 record / deriving 预处理结果，
-- key 由接口哈希决定（依赖接口不变时一直命中），失败路径不缓存。
export evalExprInfoWithAux : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => PackageContext -> String -> String -> Maybe AuxCache -> Eff r (Check ((String, String), Maybe AuxCache))
evalExprInfoWithAux ctx program expr aux =
  do
    ifaces <- depIfacesForToolProgram ctx program
    case ifaces of
      Just ifaces2 => dtEvalExprInfoWithAuxCache ctx program expr ifaces2 aux
      Nothing =>
        do
          info <- dtEvalExprInfo ctx program expr
          pure (
              case info of
                ErrC e => ErrC e
                OkC i => OkC (i, aux)
            )

-- ---------------------------------------------------------------
-- REPL v2：定义工具（自动签名 / 绑定类型 / 回写签名复查）
-- ---------------------------------------------------------------
-- | 为缺签名的顶层 DFun 推断可回读的签名；`targets` 由 REPL 选出（块内无签名、且缓冲里
-- 也没有只含签名的块）。失败返回可读错误，由 REPL 加提示后保持会话状态不变。
export inferDefTypes : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> List String -> String -> Eff r (Check (List (String, String)))
inferDefTypes ctx program targets defSource = dtInferDefTypes ctx program targets defSource

-- | `program` 里每个顶层定义的名字 + zonk 后类型文本（`:defs` / `:info` 用）。
export bindingTypes : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Check (List (String, String)))
bindingTypes ctx program = dtBindingTypes ctx program

-- | 内存 `program` 的整程序检查（自动签名写回后的复查；也用于 `:load` 模块的立即校验）。
export checkProgram : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Eff r (Check (List Diagnostic))
checkProgram ctx program = dtCheckSource ctx "<repl>" program
