-- | `vuna map` / `vuna api` 的文本渲染。
--
-- 纯字符串拼装，不读源码；符号 doc 由 [Vuna.Doc] 按源码 + `[export]` 渲染后随索引带过来。
module Vuna.Index.Render where

import Vuna.Compiler.Base.Common
import Vuna.Index.Types

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
-- | 总览：按包分组的模块表（`vuna map` 的默认输出）。
export renderOverview : Index -> String
renderOverview index =
  let
    ms = indexModules index
    pkgs = distinct (map modPackage ms)
  in "${join "\n" (map (overviewSection ms) pkgs)}\n"

-- | 内部：一个包的小节，`## 包名` 加每个模块的「名字、字节数、声明数」；包名为空串时
-- 标题用 `(no package)`。
overviewSection : List ModuleInfo -> String -> String
overviewSection ms pkg =
  let
    mine = filter (\m => modPackage m == pkg) ms
    title = if pkg == "" then "(no package)" else pkg
  in "\n## ${title}\n\n${join "\n" (map (\m => "  ${modName m}  ${modBytes m}B  ${modDecls m} decls") mine)}"

-- | 模块清单：每行「模块名、源文件路径」（`vuna map`）。
export renderModules : Index -> String
renderModules index =
  "${join "\n" (map (\m => "${modName m}  ${modPath m}") (indexModules index))}\n"

-- | 某模块的 API 面：模块 docstring + 每个符号一行（签名、行号、doc）。
--
-- 模块是否存在以 `indexModules` 为准：没有符号的模块也给标题与文档，不报错。
export renderApi : Index -> String -> Check String
renderApi index modQuery =
  case filter (\m => modName m == modQuery) index.indexModules of
    [] => err "no such module: ${modQuery}"
    mi :: rest =>
      let
        syms = filter (\s => symModule s == modQuery) index.indexSymbols
        docBlock =
          case modDoc mi of
            "" => ""
            d => "\n\n${join "\n" (map (\l => "  ${l}") (lines d))}"
        symBlock = if length syms == 0 then "" else "\n\n${join "\n" (map apiRow syms)}"
      in OkC "## ${modQuery}${docBlock}${symBlock}"

-- | 内部：一个符号的 API 行（`名字 : 签名  -- line 行号`），有 doc 时缩进续写。
apiRow : Sym -> String
apiRow s =
  "  ${symName s} : ${symSig s}  -- line ${symLine s}${if s.symDoc == "" then "" else "\n${join "\n" (map (\l => "      ${l}") (lines s.symDoc))}"}"
