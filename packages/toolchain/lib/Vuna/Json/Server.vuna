-- | JSON-RPC 连接循环：一串 `Content-Length` 帧上的「读帧 → 分发 → 发帧 → 再读」。
--
-- 本模块只负责机械循环与传输层错误分类，**不解释请求语义、不决定退出码**。读写函数由调用方传入
-- （LSP 用 `readChunk` + `consolePrint`，REPL socket server 用 `netRecv conn` + `netSend conn`）；
-- 坏 JSON 或无 `Content-Length` 的帧交给调用方的告警回调记日志，并可选地回错误帧（LSP 选择丢帧
-- 不回，REPL server 回 `-32700` 让客户端不空等）。分发返回 `(shouldExit, (新状态, 待发帧))`，
-- 待发帧在继续循环前依次写出。退出原因用 `ServerExit` 交给调用方映射（LSP：EOF→1、exit→
-- shutdown 决定；REPL：EOF 只关连接、shutdown 让进程退 0）。
--
-- 上界：单帧 / 缓冲 16 MiB、循环 fuel 1G 次；超限走 `ExitFatal`，由调用方决定是终止进程
-- （LSP）还是只关掉这个连接继续服务（REPL server）。
module Vuna.Json.Server where

import Vuna.Compiler.Base.Common
import Vuna.Json
import Vuna.Json.Frame
import Base.Effect.Types as EffTypes
import Base.Effect.Console as EffConsole
import Base.Effect.Net as EffNet

-- | 连接结束的原因；**不含退出码**——同一个原因在不同 server 里映射不同。
export data ServerExit(..) : Type where
  -- | 分发要求退出（LSP `exit` / REPL `shutdown`、`:quit`）。
  ExitRequested : ServerExit
  -- | 读端 EOF：stdio 的 stdin 关闭 / socket 的对端关闭。
  ExitClosed : ServerExit
  -- | 传输层致命错误（超大帧 / fuel 耗尽），附带原因文本。
  ExitFatal : String -> ServerExit

-- 帧循环是无限状态机；用显式 fuel 守卫。
-- | 每次 `serveConnection` 允许的读 / 切帧步数上界（1G）。
serverFuelBound : Int
serverFuelBound = 1073741824

-- | 依次写出一组帧，忽略单次写入的返回值，最后给 0。
writeFrames : {r : Row} -> (String -> Eff r Int) -> List Json -> Eff r Int
writeFrames writeS [] = pure 0
writeFrames writeS (f :: rest) =
  do
    _ <- writeS (renderFrame f)
    writeFrames writeS rest

-- | 在一个连接上服务任意多帧，直到分发要求退出、对端关闭或传输层致命错误。
--
-- `readN` 读一块（`Nothing` = EOF），`writeS` 写字节，`warn` 是传输告警回调
-- （`(消息, 状态) → (新状态, 待发帧)`，各 server 决定坏帧要不要回错误帧），`dispatch` 是分发
-- （`(消息, 状态) → (是否退出, (新状态, 待发帧))`），`state` 是初始状态。返回
-- `(结束原因, 最终状态)`；退出码由调用方映射。
export serveConnection : {r : Row} -> (Int -> Eff r (Maybe String)) -> (String -> Eff r Int) -> (String -> s -> Eff r (s, List Json)) -> (Json -> s -> Eff r (Bool, s, List Json)) -> s -> Eff r (ServerExit, s)
serveConnection readN writeS warn dispatch state =
  connLoop serverFuelBound "" readN writeS warn dispatch state

-- | 内部：主循环；`pending` 是还没切出完整帧的缓冲。
connLoop : {r : Row} -> Int -> String -> (Int -> Eff r (Maybe String)) -> (String -> Eff r Int) -> (String -> s -> Eff r (s, List Json)) -> (Json -> s -> Eff r (Bool, s, List Json)) -> s -> Eff r (ServerExit, s)
connLoop fuel pending readN writeS warn dispatch state =
  if fuel <= 0 then
    pure (ExitFatal "frame fuel exhausted (internal)", state)
  else if strLength pending > maxFrameBytes then
    pure (ExitFatal "frame buffer exceeded limit", state)
  else
    case splitHeaderBlock pending of
      -- 还没有完整 header：继续读。
      Nothing => feedMore fuel pending readN writeS warn dispatch state
      Just (headerBlock, afterHeaders) =>
        case contentLengthOf headerBlock of
          -- header 里没有可用的 Content-Length：丢掉这段 header，避免无限等待。
          Nothing =>
            do
              w <- warn "frame header without Content-Length dropped" state
              _ <- writeFrames writeS (secondOf w)
              connLoop (fuel - 1) afterHeaders readN writeS warn dispatch (firstOf w)
          Just len => frameBody fuel pending afterHeaders len readN writeS warn dispatch state

-- | 内部：header 有效后等 body；body 不够就再读，够了就解码一帧。
frameBody : {r : Row} -> Int -> String -> String -> Int -> (Int -> Eff r (Maybe String)) -> (String -> Eff r Int) -> (String -> s -> Eff r (s, List Json)) -> (Json -> s -> Eff r (Bool, s, List Json)) -> s -> Eff r (ServerExit, s)
frameBody fuel pending afterHeaders len readN writeS warn dispatch state =
  if len > maxFrameBytes then
    pure (ExitFatal "frame too large", state)
  else if strLength afterHeaders < len then
    feedMore fuel pending readN writeS warn dispatch state
  else
    decodeFrame fuel len afterHeaders readN writeS warn dispatch state

-- | 内部：切出 `len` 字节的 body（body 后没有换行），解析、分发并继续下一帧。
decodeFrame : {r : Row} -> Int -> Int -> String -> (Int -> Eff r (Maybe String)) -> (String -> Eff r Int) -> (String -> s -> Eff r (s, List Json)) -> (Json -> s -> Eff r (Bool, s, List Json)) -> s -> Eff r (ServerExit, s)
decodeFrame fuel len afterHeaders readN writeS warn dispatch state =
  let
    body = substring 0 (natFromInt len) afterHeaders
    rest = substring (natFromInt len) (natFromInt (strLength afterHeaders - len)) afterHeaders
  in case parseJson body of
    ErrC e =>
      do
        w <- warn "malformed frame: ${diagText e}" state
        _ <- writeFrames writeS (secondOf w)
        connLoop (fuel - 1) rest readN writeS warn dispatch (firstOf w)
    OkC msg =>
      do
        result <- dispatch msg state
        let
          shouldExit = firstOf result
          after = secondOf result
          state2 = firstOf after
          frames = secondOf after
        in do
          _ <- writeFrames writeS frames
          if shouldExit then pure (ExitRequested, state2) else connLoop (fuel - 1) rest readN writeS warn dispatch state2

-- | 内部：缓冲里还没有完整的一帧就再读一块（可能只到几个字节）；`Nothing` 表示对端关闭。
feedMore : {r : Row} -> Int -> String -> (Int -> Eff r (Maybe String)) -> (String -> Eff r Int) -> (String -> s -> Eff r (s, List Json)) -> (Json -> s -> Eff r (Bool, s, List Json)) -> s -> Eff r (ServerExit, s)
feedMore fuel pending readN writeS warn dispatch state =
  do
    chunk <- readN frameChunkSize
    case chunk of
      Nothing => pure (ExitClosed, state)
      Just bytes => connLoop (fuel - 1) (pending ++ bytes) readN writeS warn dispatch state
