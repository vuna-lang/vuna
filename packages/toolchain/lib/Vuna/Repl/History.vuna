-- | REPL 会话历史文件的编解码：一个输入单元 ↔ 一行文本。
--
-- 文件格式（v2）：首行固定 `historyHeader`，其后每行一个编码后的单元；
-- 单元内 `\`（0x5C）→ `\\`，换行（0x0A）→ `\n`（反斜杠 + 字母 n 两个字符）。因此每行仍是
-- 「一个单元」、单元内不会有裸换行；条目按写入顺序排列（先旧后新）。
--
-- 两种格式都可读（v1 = 纯文本一行一条、没有首行头）：读取按首行判别——首行等于
-- `historyHeader` 才按 v2 解码，否则整份文件按 v1 原样读入（v1 文件里的 `\` 与 `\n` 字面量
-- 不会被误解码）；写入统一用 v2（parse v1 → 追加 → 写出 v2）。
--
-- 已知边界：v1 单元本身含裸换行时无法区分（v1 只写单行，故不会出现）；v2 首行与用户实际
-- 输入单元同名的概率可忽略（判别只看首行，首行必须是头）。
--
-- 编解码逐字节处理、不做 UTF-8 解码，因此对任意字节串互为逆。
module Vuna.Repl.History where

import Vuna.Compiler.Base.Common

-- | 历史文件首行标识；同时是 v2 与 v1 的判别依据。
export historyHeader : String
historyHeader = "vuna-repl-history 2"

-- | 反斜杠的字节值。
backslash : Int
backslash = 92

-- | 换行的字节值。
newline : Int
newline = 10

-- | 解析整份历史文件（空行一律丢弃），返回旧→新的单元列表；首行去掉首尾空白后等于
-- `historyHeader` 时按 v2 解码，否则整份按 v1 纯文本读入。
export parseHistoryFile : String -> List String
parseHistoryFile text =
  case lines text of
    [] => []
    first :: rest =>
      if trim first == historyHeader then
        filterNonEmpty (map decodeUnit rest)
      else
        filterNonEmpty (first :: rest)

-- | 渲染成 v2 文件文本：首行头 + 每条一行，总是以换行结尾（空历史也写出头，保证格式判别
-- 稳定）。
export renderHistoryFile : List String -> String
renderHistoryFile units = "${historyHeader}\n${join "\n" (map encodeUnit units)}\n"

-- | 内部：丢掉空串条目（历史文件里的空行）。
filterNonEmpty : List String -> List String
filterNonEmpty [] = []
filterNonEmpty (x :: rest) = if x == "" then filterNonEmpty rest else x :: filterNonEmpty rest

-- ---------------------------------------------------------------
-- 编码 / 解码（纯；逐字节处理，不做 UTF-8 解码，因此对任意字节串是恒等的逆）
-- ---------------------------------------------------------------
-- | 内部：把一个单元编码成一行文本（转义 `\` 与换行）。
encodeUnit : String -> String
encodeUnit s = encodeChars (strUnpack s)

-- | 内部：`encodeUnit` 的逐字节实现。
encodeChars : List Int -> String
encodeChars [] = ""
encodeChars (c :: rest) =
  if c == newline then
    "${strPack [backslash]}n${encodeChars rest}"
  else if c == backslash then
    "${strPack [backslash]}${strPack [backslash]}${encodeChars rest}"
  else
    "${strPack [c]}${encodeChars rest}"

-- | 内部：把一行文本解码回单元（v2 反转义）。
decodeUnit : String -> String
decodeUnit s = strPack (decodeChars (strUnpack s) [])

-- | 内部：`decodeUnit` 的逐字节实现（`acc` 逆序累积，最后 reverse）；`\` 后面不是 `n` / `\`
-- 时按字面保留（宽容解码，不报错）。
decodeChars : List Int -> List Int -> List Int
decodeChars [] acc = reverse acc
decodeChars (c :: rest) acc =
  if c == backslash then
    case rest of
      next :: rest2 => if next == 110 then decodeChars rest2 (newline :: acc) else if next == backslash then decodeChars rest2 (backslash :: acc) else decodeChars rest (c :: acc)
      [] => reverse (backslash :: acc)
  else
    decodeChars rest (c :: acc)
