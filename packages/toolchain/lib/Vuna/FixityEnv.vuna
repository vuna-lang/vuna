-- | 工具链（fmt / lint / LSP）的 per-file **程序级 fixity** 解析器。
--
-- parser 只产出中缀链，Loader 重排需要「本文件 `infix*` 声明 ++ 该文件 import 闭包可见声明」。
-- 昂贵部分是**按包上下文加载模块图**（每个文件重复加载会退化成 O(#文件 × #模块)）；声明表
-- 本身必须逐文件重算——不同文件 imports 不同，跨文件复用声明表会让 `::` / `+` 等被判
-- unknown fixity 或打出错误括号。
--
-- 缓存键都是文件所在目录（见 `dirKey`）：目录映射到该目录最近 manifest 的
-- `PackageContext`（避免逐文件重读/解析 `vuna.toml`），包目录（`contextDir`）映射到已加载
-- 模块图（同包多文件只加载一次，声明表仍逐文件算）。
--
-- 上下文解析与加载失败是**硬错误**：fixity 无法确定时调用方必须拒绝格式化/lint，不能静默用
-- 本地表继续（那会退化成 unknown fixity 或错优先级）。本模块只属于工具链，不进 seed 闭包。
module Vuna.FixityEnv where

import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Flatten
import Vuna.Compiler.Loader.Modules
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Frontend.Parser
import Base.Effect.Types as EffTypes
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs

-- | per-file fixity 解析的缓存。表示抽象：只有 [Vuna.FixityEnv.emptyFixityEnv] 与
-- [Vuna.FixityEnv.fixitiesForFile] 能构造与推进它。
export record FixityEnv where
  -- | 文件所在目录 -> 该目录最近 manifest 的包上下文。
  fixityEnvCtxCache : List (String, PackageContext)
  -- | 包目录（`contextDir`）-> 已加载的模块图。
  fixityEnvModCache : List (String, List Module)

-- | 空缓存。
export emptyFixityEnv : FixityEnv
emptyFixityEnv = FixityEnv [] []

-- | 内部：缓存键——文件所在**目录**（无 `/` 时用 `"."`）。同一目录的文件共享上下文；
-- 相对/绝对路径写法不同只会造成一次缓存 miss，不影响正确性。
--
-- 必须按**最后一个** `/` 拆：workspace 成员目录可以嵌套（如 `packages/cli`），按首个路径段取键会在
-- 嵌套包目录下把不同包的文件并到同一个键，串用首个文件的包上下文。
dirKey : String -> String
dirKey path = parentOf path

-- | 内部：按键查缓存（同名键取最近写入的一条）。
cacheLookup : String -> List (String, a) -> Maybe a
cacheLookup key [] = Nothing
cacheLookup key ((k, v) :: rest) = if k == key then Just v else cacheLookup key rest

-- | 内部：删掉某个键的全部条目（写入前先清重复，保证一键一条）。
cacheForget : String -> List (String, a) -> List (String, a)
cacheForget key [] = []
cacheForget key ((k, v) :: rest) =
  if k == key then cacheForget key rest else (k, v) :: cacheForget key rest

-- | 内部：写入缓存，同名键只保留最新一条（新条目置顶）。
cachePut : String -> a -> List (String, a) -> List (String, a)
cachePut key value entries = (key, value) :: cacheForget key entries

-- | 取一个文件的程序级 fixity：`Pair env' (Check (List FixityDecl))`。
--
-- `env'` 带回推进后的缓存（即使本次失败，已成功的上下文缓存仍可复用）。上下文解析与模块图
-- 加载是宿主动作，显式在 `Eff r` 里；缓存推进仍是纯数据。
export fixitiesForFile : Member nFs FsOp r, Member nEnv EnvOp r => FixityEnv -> String -> String -> Eff r (FixityEnv, Check (List FixityDecl))
fixitiesForFile env path source =
  case parseSourceWithComments path source of
    ErrC e => pure (env, ErrC e)
    OkC (sf, _) => fixitiesForParsed env path sf

-- | 同 `fixitiesForFile`，但源码**已经**解析过：不重复语法分析，只加载模块图并拼声明表。
--
-- 工具（lint / index / doc）本来就要为规则或 docstring 解析一遍；再为 fixity 解析一遍是
-- 同一份源码的第二次完整语法分析。
export fixitiesForParsed : Member nFs FsOp r, Member nEnv EnvOp r => FixityEnv -> String -> SourceFile -> Eff r (FixityEnv, Check (List FixityDecl))
fixitiesForParsed (FixityEnv ctxCache modCache) path sf =
  let
    dir = dirKey path
  in do
    ctxRes <-
      case cacheLookup dir ctxCache of
        Just ctx => pure (OkC ctx)
        Nothing => contextForFile path
    case ctxRes of
      ErrC e => pure (FixityEnv ctxCache modCache, ErrC e)
      OkC ctx =>
        let
          ctxCache2 = cachePut dir ctx ctxCache
          modKey = contextDir ctx
          mods =
            case cacheLookup modKey modCache of
              Just ms => ms
              Nothing => []
        in do
          fxR <- fixitiesFromParsed ctx mods path sf
          pure (
              case fxR of
                ErrC e => (FixityEnv ctxCache2 modCache, ErrC e)
                OkC (mods2, fx) => (FixityEnv ctxCache2 (cachePut modKey mods2 modCache), OkC fx)
            )

-- | 已解析上下文的 fixity：调用方（lint worker）按目录预先解析 `PackageContext`，这里只推进
-- 模块图缓存；上下文解析的失败由调用方在 fixity 阶段收口。
export fixitiesForCtx : Member nFs FsOp r => FixityEnv -> PackageContext -> String -> SourceFile -> Eff r (FixityEnv, Check (List FixityDecl))
fixitiesForCtx (FixityEnv ctxCache modCache) ctx path sf =
  let
    modKey = contextDir ctx
    mods =
      case cacheLookup modKey modCache of
        Just ms => ms
        Nothing => []
  in do
    fxR <- fixitiesFromParsed ctx mods path sf
    pure (
        case fxR of
          ErrC e => (FixityEnv ctxCache modCache, ErrC e)
          OkC (mods2, fx) => (FixityEnv ctxCache (cachePut modKey mods2 modCache), OkC fx)
      )
