-- | vuna 源码格式化器门面（parse → 规范打印）。
--
-- 输出约定：2 空格缩进、顶层声明之间一个空行、文件末尾一个换行、无行尾空白；
-- `format(parse(x))` 可重新 parse 且幂等（`format(format(x)) == format(x)`）。
--
-- 导出列表：导出项按字面文本的 ASCII 字典序排序，`module B` 整模块重导出统一排最后；
-- 空白与换行由 [Vuna.Fmt.Doc] 的 `group` 一次决定（`maxWidth` 列预算），
-- 缩进由 `nest` 承担。项级注释随项移动。
--
-- 注释不在 AST 里：格式化器从 CST 的 token trivia 取前置 / 行尾注释（含注释间空行），
-- 按条目 span 直接挂载；实现见 [Vuna.Fmt.Comment]。
--
-- 中缀与括号按**源码顺序与源码括号**打印：不重排中缀链、不按优先级补括号，因此
-- 格式化不需要 fixity 闭包（`infix*` 声明原样保留）。语法糖只从 parser 的保留名
-- （`@vuna@…`）还原：裸 `Nil` / `Cons` 是普通构造子名，不当列表字面量改写。
-- 需要补括号的两处例外都是语义要求：块结构作中缀链的非末尾操作数（布局括号），
-- 符号名构造子的前缀模式（`((<=>) x y)`：名字括号 + 整段括号，否则无法回读）。
--
-- 本模块只是门面：表达式/模式打印在 Vuna.Fmt.Expr，声明/模块头在 Vuna.Fmt.Decl，
-- 注释挂载在 Vuna.Fmt.Comment，共用小工具在 Vuna.Fmt.Util，文档代数在 Vuna.Fmt.Doc。
module Vuna.Fmt where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Parser
import Vuna.Fmt.Comment
import Vuna.Fmt.Decl
import Vuna.Fmt.Doc
import Vuna.Fmt.Util
import Base.Data.String as String

-- | 格式化一段源码：解析（一次词法同时给出注释与 trivia token）、重写模块头，最后组装
-- 成一份 `Doc` 渲染。任何一步失败都是 `Err`，调用方据此拒绝写盘。
export formatSourceWith : String -> Check String
formatSourceWith source =
  case parseSourceDetailed "<fmt>" source of
    ErrC e => ErrC e
    OkC (ParsedSource (SourceFile hdr imports fx decls exports reexports opacity) comments rawToks cst) =>
      let
        toks = lexTokensOf source rawToks comments
        plan = fmtCtxOf (cstIndexOf cst) (anchorRefs cst) toks
        ctx = firstOf plan
        eofComments = secondOf plan
        hdr2 =
          case hdr of
            Just m =>
              Just
                (ModDecl m.modDeclName m.modDeclHasExportList m.modDeclExportItems exports reexports opacity m.modDeclRef)
            Nothing =>
              case exports of
                [] =>
                  case reexports of
                    [] => Nothing
                    _ =>
                      Just
                        (ModDecl "" False [] exports reexports opacity (detachedNodeRef dummySpan))
                _ =>
                  Just (ModDecl "" False [] exports reexports opacity (detachedNodeRef dummySpan))
        doc = renderSourceSections [] hdr2 imports fx decls ctx eofComments
      in if isDocEmpty doc then
        OkC ""
      else
        let
          rendered = render maxWidth doc
        in OkC (if endsWith "\n" rendered then rendered else rendered ++ "\n")
