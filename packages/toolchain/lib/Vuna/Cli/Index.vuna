-- | 源码索引类命令：`vuna map`（模块总览 / 符号定位 / 影响面）、`vuna api`、`vuna goal`。
--
-- 索引会话对象落在 `$VUNA_STORE/objects/tool-context/`，每次调用按输入摘要判定新鲜度，没有
-- 「刷新索引」命令（详见 `Vuna.Index` / `Vuna.Tool.Session`）。`goal` 走容错入口，
-- 未解洞不让查询失败。
module Vuna.Cli.Index where

import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Err
import Vuna.Cli.Spec
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Elab.Driver
import Vuna.Compiler.Elab.Term
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Loader.Fixity
import Vuna.Files
import Vuna.FixityEnv
import Vuna.Index
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes

-- | `vuna map` 的入口：`find` / `impact` 是子命令，无子命令时打印模块总览。
export mapArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
mapArgs ("find" :: more) = findArgs more
mapArgs ("impact" :: more) = impactArgs more
mapArgs rest =
  case parseCmdArgs ["map"] rest of
    ErrC e => toolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [] => printOverview
        _ => usageErrorFor ["map"]

-- | 内部：`vuna map find <Module.name>`——恰好一个查询串。
findArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
findArgs more =
  case parseCmdArgs ["map", "find"] more of
    ErrC e => toolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [query] => runFind query
        _ => usageErrorFor ["map", "find"]

-- | 内部：`vuna map impact <Module.name>`——恰好一个查询串。
impactArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
impactArgs more =
  case parseCmdArgs ["map", "impact"] more of
    ErrC e => toolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [query] => runImpact query
        _ => usageErrorFor ["map", "impact"]

-- | 内部：在 workspace 根上构建（或复用缓存的）源码索引后执行回调；非 workspace 是输入错误
-- （exit 2），不会输出空索引。
withIndex : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => (Index -> Eff r Int) -> Eff r Int
withIndex f =
  do
    found <- findManifestDirMaybe "."
    case found of
      Nothing =>
        do
          cwd <- envGetCwd
          toolError "not inside a vuna workspace (no vuna.toml found from ${cwd}); run `vuna map` from a package or workspace root"
      Just _ =>
        do
          built <- loadOrBuild "."
          case built of
            ErrC e => toolError (diagText e)
            OkC index => f index

-- | 内部：打印模块总览。
printOverview : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Eff r Int
printOverview =
  withIndex (
      \index =>
        do
          _ <- consolePrint "${renderOverview index}\n"
          pure 0
    )

-- | 内部：逐行打印全部命中（返回 0；命中数为 0 也返回 0，由调用方决定退出码）。
printSymLines : Member nConsole ConsoleOp r => List Sym -> Eff r Int
printSymLines [] = pure 0
printSymLines (s :: rest) =
  do
    _ <- consolePrint "${symLineText s}\n"
    printSymLines rest

-- | 内部：定位符号——先逐行打印命中，再按命中数给退出码：0 唯一命中、1 无命中、2 多个候选。
runFind : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r Int
runFind query =
  withIndex (
      \index =>
        case findSymbol index query of
          ErrC e => toolFailure (diagText e)
          OkC hits =>
            do
              _ <- printSymLines hits
              case hits of
                [] => pure 1
                [_] => pure 0
                _ =>
                  do
                    _ <- consolePrint "ambiguous: ${length hits} candidates, use a full Module.name\n"
                    pure 2
    )

-- | 内部：一行命中的文本——全名 + `(行:列)` + 签名（签名为空则省略）。
symLineText : Sym -> String
symLineText s =
  "${symFullName s}  (${symLine s}:${symCol s})${if symSig s == "" then "" else "  ${symSig s}"}"

-- | 内部：打印某符号的改动影响面（受影响模块 + 测试标签）；查询失败 exit 1。
runImpact : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r Int
runImpact query =
  withIndex (
      \index =>
        case impactOf index query of
          ErrC e => toolFailure (diagText e)
          OkC text =>
            do
              _ <- consolePrint "${text}\n"
              pure 0
    )

-- | `vuna api <Module.name>` 的入口：恰好一个模块名。
export apiArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
apiArgs rest =
  case parseCmdArgs ["api"] rest of
    ErrC e => toolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [modName] => runApi modName
        _ => usageErrorFor ["api"]

-- | 内部：打印某模块的签名面（含注释与行号）；模块不存在 exit 1。
runApi : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r Int
runApi modName =
  withIndex (
      \index =>
        case renderApi index modName of
          ErrC e => toolFailure (diagText e)
          OkC text =>
            do
              _ <- consolePrint "${text}\n"
              pure 0
    )

-- | `vuna goal <file.vuna>` 的入口：恰好一个 DT 源文件。
export goalArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
goalArgs rest =
  case parseCmdArgs ["goal"] rest of
    ErrC e => toolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [file] => goalRun file
        _ => usageErrorFor ["goal"]

-- | 内部：列出文件里每个洞 `_` 的位置、目标类型与上下文；没有洞时只打印
-- `<file>: no holes`。
goalRun : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r Int
goalRun file =
  do
    textR <- readText file
    case textR of
      ErrC e => toolError (diagText e)
      OkC source =>
        case parseSourceDetailed file source of
          ErrC e => toolFailure (diagText e)
          OkC parsed =>
            case parsed.parsedFile of
              SourceFile _ _ fx decls0 _ _ _ =>
                do
                  looked <- fixitiesForFile emptyFixityEnv file source
                  case secondOf looked of
                    ErrC e => toolFailure (diagText e)
                    OkC programFixities =>
                      case reorderProgram (tableOfKeepOpsCst parsed.parsedCst (append programFixities fx)) decls0 of
                        ErrC e => toolFailure (diagText e)
                        OkC decls =>
                          case goalsOfProgramTolerant (decls) of
                            ErrC e => toolFailure (diagText e)
                            OkC infos =>
                              do
                                _ <- consolePrint (goalHeader file (length infos) ++ renderGoals file infos)
                                pure 0

-- | 内部：逐个洞渲染 `位置: goal <标签>` 行，后接上下文变量行。
renderGoals : String -> List DtGoalInfo -> String
renderGoals file [] = ""
renderGoals file (i :: rest) =
  "${showSpanLoc i.dtGoalInfoSpan}: goal ${goalLabel i}\n${renderGoalCtx i.dtGoalInfoCtx}${renderGoals file rest}"

-- | 内部：命名洞显示 `?name : <目标类型>`；匿名洞只显示 `<目标类型>`。
goalLabel : DtGoalInfo -> String
goalLabel i =
  if i.dtGoalInfoName == "" then i.dtGoalInfoGoal else "${i.dtGoalInfoName} : ${i.dtGoalInfoGoal}"

-- | 内部：渲染洞的上下文（每条 `  <变量> : <类型>` 一行，保持给定顺序）。
renderGoalCtx : List (String, String) -> String
renderGoalCtx [] = ""
renderGoalCtx ((n, ty) :: rest) = "  ${n} : ${ty}\n${renderGoalCtx rest}"

-- | 内部：没有洞时的提示行（有洞时返回空串，由 `renderGoals` 逐条输出）。
goalHeader : String -> Int -> String
goalHeader file n = if n == 0 then "${file}: no holes\n" else ""
