-- | 工具命令的统一错误出口：0（成功）/ 1（语义失败）/ 2（用法或前提不满足）。
--
-- 所有工具命令都从这里打印——文案前缀只有一处，退出码语义只有一处。参数解析错误由
-- [Vuna.Cli.Spec.parseCmdArgs] 给出文本，命令只负责选 1 还是 2。
module Vuna.Cli.Err where

import Vuna.Cli.Help
import Vuna.Cli.Suggest
import Vuna.Plugin.Command
import Vuna.Plugin.Help
import Base.Effect.Console as EffConsole
import Base.Effect.Types as EffTypes

-- | 用法 / 前提错误：打印并返回 2。
export toolError : Member nConsole ConsoleOp r => String -> Eff r Int
toolError e =
  do
    _ <- consolePrint "error: ${e}\n"
    pure 2

-- | 被检查代码或查询的语义失败：打印并返回 1。
export toolFailure : Member nConsole ConsoleOp r => String -> Eff r Int
toolFailure e =
  do
    _ <- consolePrint "error: ${e}\n"
    pure 1

-- | 输入路径存在性守卫：打印第一个缺失路径并返回 2。
export missingPathError : Member nConsole ConsoleOp r => String -> Eff r Int
missingPathError path = toolError "no such file: ${path}"

-- | 用法错误：打印该命令的用法行与帮助入口，返回 2。
export usageErrorFor : Member nConsole ConsoleOp r => List String -> Eff r Int
usageErrorFor path =
  do
    _ <- consolePrint (usageText path)
    pure 2

-- | 内部：`usage:` 段——已登记的命令给 synopsis + 帮助提示，未登记的给总览。
usageText : List String -> String
usageText path =
  case synopsisOf path of
    Just line => "usage:\n  ${line}\nrun `vuna help ${joinWords path}` for details\n"
    Nothing => overviewText

-- | 用法错误（给定命令表）：插件自己的命令表用。
export usageErrorForIn : Member nConsole ConsoleOp r => List Cmd -> List String -> Eff r Int
usageErrorForIn cmds path =
  do
    _ <- consolePrint (usageTextIn cmds path)
    pure 2

-- | 内部：`usage:` 段（给定命令表）。
usageTextIn : List Cmd -> List String -> String
usageTextIn cmds path =
  case synopsisIn cmds path of
    Just line => "usage:\n  ${line}\nrun `vuna help ${joinWords path}` for details\n"
    Nothing => renderOverview cmds

-- | 内部：命令路径用空格拼接。
joinWords : List String -> String
joinWords [] = ""
joinWords ([one]) = one
joinWords (one :: rest) = "${one} ${joinWords rest}"

-- | 未知子命令：打印候选建议与帮助入口，返回 2。
export unknownSubcommand : Member nConsole ConsoleOp r => List String -> String -> List String -> Eff r Int
unknownSubcommand parent bad candidates =
  do
    _ <- consolePrint (unknownSubcommandText (joinWords parent) bad candidates)
    pure 2

-- | 内部：未知子命令文案（有近邻就补一句建议）。
unknownSubcommandText : String -> String -> List String -> String
unknownSubcommandText parent bad candidates =
  case suggestOne candidates bad of
    Just guess =>
      "error: unknown `vuna ${parent}` subcommand `${bad}`; did you mean `${guess}`?\nrun `vuna help ${parent}`\n"
    Nothing => "error: unknown `vuna ${parent}` subcommand `${bad}`\nrun `vuna help ${parent}`\n"

-- | 已移除 / 已改名的命令：打印迁移提示并返回 2。
export removedCommand : Member nConsole ConsoleOp r => String -> String -> Eff r Int
removedCommand name hint =
  do
    _ <- consolePrint "error: `${name}` has been removed; ${hint}\n"
    pure 2
