-- | 工具命令的参数解析门面与输入/输出路径守卫。
--
-- 纯解析在 [Vuna.Plugin.Args]（不依赖编译器）；本模块只做三件事：把解析失败转成
-- `Check` 文案、提供工具侧「已删 flag」提示表（其余回落编译器包的真源）、以及读盘守卫
-- 与路径工具。
--
-- 读盘守卫：内建 `fsIsDirectory` 对不存在的路径会抛宿主异常，所以所有来自用户的路径都必须
-- 先 `fsFileExists` 再 `fsIsDirectory`；[Vuna.Cli.Args.readText] /
-- [Vuna.Cli.Args.requireExists] / [Vuna.Cli.Args.requireDirectory] 是唯一入口。这些守卫与
-- 目录创建显式在 `Eff r` 里（错误仍用 `Check` 携带）；纯 flag 解析 API 保持纯函数。
module Vuna.Cli.Args where

import Vuna.Plugin.Args
import Vuna.Plugin.Command
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Driver.CompilerCli
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes
import Base.Effect.Process as EffProcess

-- | 工具命令共用入口：`cmd` 只用于错误文案，`specs` 是允许的 flag 表，`args` 是去掉子命令后
-- 的参数。
export parseToolArgs : String -> List ArgSpec -> List String -> Check Parsed
parseToolArgs cmd specs args =
  case Vuna.Plugin.Args.parseToolArgsOut cmd specs args of
    POk parsed => OkC parsed
    PErr e => err (Vuna.Plugin.Args.argErrText cmd e)

-- | 与 [parseToolArgs] 相同，但对未知 flag 追加「最近候选」建议与已删提示。
export parseCmdArgsOf : String -> List ArgSpec -> List String -> Check Parsed
parseCmdArgsOf cmd specs args =
  case Vuna.Plugin.Args.parseCmdArgsOut cmd specs args of
    POk parsed => OkC parsed
    PErr e => err (Vuna.Plugin.Args.argErrTextHinted removedHintFor cmd specs e)

-- | 内部：拼出带 `--` 前缀的 flag 原文。
dashFlag : String -> String
dashFlag name = "--${name}"

-- | 内部：工具命令侧已删 / 已迁移的 flag → 迁移提示。编译器 flag 的真源仍是
-- `CompilerCli.removedFlagHint`；这里只放「只属于工具命令」的条目。
toolRemovedFlagHint : String -> Maybe String
toolRemovedFlagHint flag =
  if flag == dashFlag "with-comments" then
    Just "doc renders doc comments by default; drop the flag"
  else if flag == dashFlag "suite" then
    Just "run `vuna dev suite [FILE]` instead"
  else if flag == dashFlag "listen" then
    Just "run `vuna repl serve --listen ADDR` instead"
  else if flag == dashFlag "client" then
    Just "run `vuna repl client --addr ADDR` instead"
  else if flag == dashFlag "find" then
    Just "run `vuna map find <Module.name>` instead"
  else if flag == dashFlag "impact" then
    Just "run `vuna map impact <Module.name>` instead"
  else if flag == dashFlag "modules" then
    Just "run `vuna map` (module overview is the default)"
  else
    Nothing

-- | 内部：先查工具侧 hint 表，再回落编译器包的真源。
removedHintFor : String -> Maybe String
removedHintFor flag =
  case toolRemovedFlagHint flag of
    Just hint => Just hint
    Nothing => removedFlagHint flag

-- ---------------------------------------------------------------
-- 读盘守卫（禁止在不存在路径上调 fsIsDirectory）
-- ---------------------------------------------------------------
-- | 读一个文本文件：先判存在、再判目录，最后才读。
export readText : Member nFs FsOp r => String -> Eff r (Check String)
readText path =
  do
    exists <- fsFileExists path
    if exists then
      do
        isDir <- fsIsDirectory path
        if isDir then
          pure (err "is a directory: ${path}")
        else
          do
            content <- fsReadFile path
            pure (OkC content)
    else
      pure (err "no such file: ${path}")

-- | 要求路径存在（文件或目录均可）。
export requireExists : Member nFs FsOp r => String -> Eff r (Check Int)
requireExists path =
  do
    exists <- fsFileExists path
    pure (if exists then OkC 0 else err "no such file: ${path}")

-- | 要求路径存在且是目录。
export requireDirectory : Member nFs FsOp r => String -> Eff r (Check Int)
requireDirectory path =
  do
    exists <- fsFileExists path
    if exists then
      do
        isDir <- fsIsDirectory path
        pure (if isDir then OkC 0 else err "not a directory: ${path}")
    else
      pure (err "no such directory: ${path}")

-- ---------------------------------------------------------------
-- 目录创建（fsMakeDir 只建一层）
-- ---------------------------------------------------------------
-- | 路径的父目录：无 `/` 且非绝对路径给 `"."`，绝对路径的根给 `"/"`。
export parentOf : String -> String
parentOf path =
  let
    parent = parentText path
  in if parent == "" then if startsWith "/" path then "/" else "." else parent

-- | 内部：按最后一个 `/` 拆出父目录文本（可能为空，由 [Vuna.Cli.Args.parentOf] 兜底）。
parentText : String -> String
parentText path =
  case splitLastSlash (strUnpack path) [] [] of
    (parent, _) => parent

-- | 内部：在最后一个 `/` 处把路径拆成 `Pair 父 名`，两段都按原字节还原。
splitLastSlash : List Int -> List Int -> List String -> (String, String)
splitLastSlash [] current parts = (joinSlashParts parts, strPack (reverse current))
splitLastSlash (c :: rest) current parts =
  if c == 47 then
    splitLastSlash rest [] (strPack (reverse current) :: parts)
  else
    splitLastSlash rest (c :: current) parts

-- | 内部：把按 `/` 拆出的片段拼回。`parts` 是倒序累积的，拼接前先 reverse（否则绝对路径会
-- 丢首斜杠）。
joinSlashParts : List String -> String
joinSlashParts parts = joinSlashPartsGo (reverse parts)

-- | 内部：`joinSlashParts` 的正序拼接。
joinSlashPartsGo : List String -> String
joinSlashPartsGo [] = ""
joinSlashPartsGo ([part]) = part
joinSlashPartsGo (part :: rest) = "${part}/${joinSlashPartsGo rest}"

-- | 递归创建所有缺失的目录；已存在返回 0，fuel 耗尽返回 1（`fsMakeDir` 对已存在路径返回 0）。
--
-- 递归不沿输入结构下降（[Vuna.Cli.Args.parentOf] 返回 `String`），用显式 fuel（字节长度
-- 上界）守卫。
export ensureDirPath : Member nFs FsOp r, Member nProcess ProcessOp r => String -> Eff r Int
ensureDirPath path = ensureDirPathGo (strLength path + 2) path

-- | 内部：`ensureDirPath` 的带 fuel 递归实现（`""` / `"."` / `"/"` 视为已到根）。
ensureDirPathGo : Member nFs FsOp r => Int -> String -> Eff r Int
ensureDirPathGo fuel path =
  if fuel <= 0 then
    pure 1
  else if path == "" || path == "." || path == "/" then
    pure 0
  else
    do
      safe <- pathExistsDirSafe path
      if safe then
        pure 0
      else
        do
          _ <- ensureDirPathGo (fuel - 1) (parentOf path)
          safe2 <- pathExistsDirSafe path
          if safe2 then pure 0 else fsMakeDir path

-- | 内部：路径存在且是目录；不存在返回 `False`（不抛异常）。
pathExistsDirSafe : Member nFs FsOp r => String -> Eff r Bool
pathExistsDirSafe path =
  do
    exists <- fsFileExists path
    if exists then fsIsDirectory path else pure False
