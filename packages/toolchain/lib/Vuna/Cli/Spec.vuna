      []
  ]

-- | 按路径精确查找一条命令。
export findCmd : List String -> Maybe Cmd
findCmd path = findCmdIn path commands

-- | 内部：`findCmd` 的线性扫描。
findCmdIn : List String -> List Cmd -> Maybe Cmd
findCmdIn path [] = Nothing
findCmdIn path (c :: rest) = if c.cmdPath == path then Just c else findCmdIn path rest

-- | 从 argv 前缀匹配最长的已登记命令路径，返回命令与剩余参数。
export matchCommand : List String -> Maybe (Cmd, List String)
matchCommand args = matchDepth 3 args

-- | 内部：按深度从 3 到 1 尝试精确路径匹配（最长优先）。
matchDepth : Int -> List String -> Maybe (Cmd, List String)
matchDepth n args =
  if n <= 0 then
    Nothing
  else
    case findCmd (take n args) of
      Just c => Just (c, drop n args)
      Nothing => matchDepth (n - 1) args

-- | 一条命令允许的 flag 形态。
export flagSpecsOf : Cmd -> List ArgSpec
flagSpecsOf c = flagSpecsIn c.cmdFlags

-- | 内部：把帮助条目摊成解析形态（保持声明顺序）。
flagSpecsIn : List FlagDoc -> List ArgSpec
flagSpecsIn [] = []
flagSpecsIn (f :: rest) = f.flagSpec :: flagSpecsIn rest

-- | 一条命令允许的 flag 名（不带 `--`）。
export flagNamesOf : Cmd -> List String
flagNamesOf c = map specName (flagSpecsOf c)

-- | 全部命令路径（帮助与测试共用）。
export commandPaths : List (List String)
commandPaths = pathsOf commands

-- | 内部：按表顺序收集路径。
pathsOf : List Cmd -> List (List String)
pathsOf [] = []
pathsOf (c :: rest) = c.cmdPath :: pathsOf rest

-- | 按路径解析工具命令参数：flag 表来自本表，未知 flag 附带最近候选。
export parseCmdArgs : List String -> List String -> Check Parsed
parseCmdArgs = parseCmdArgsIn commands

-- | 按路径在**给定命令表**里解析参数（插件自己的表用）。
export parseCmdArgsIn : List Cmd -> List String -> List String -> Check Parsed
parseCmdArgsIn cmds path args =
  case findCmdIn path cmds of
    Nothing => err "internal: command not described: ${commandLabel path}"
    Just c => parseCmdArgsOf "vuna ${commandLabel path}" (flagSpecsOf c) args

-- | 内部：命令路径的显示文本。
commandLabel : List String -> String
commandLabel path = join " " path
