-- | 产品命令的接线表：路径 → 实现。
--
-- 分发只查这张表，不再按首段字符串写 `case` 链；命令的元数据仍在 [Vuna.Cli.Spec]。
-- 表里每一条都显式写出路径，`test/suite` 的 `cli` 章节逐条跑 `vuna help <path>` 与
-- 分组命令，漏接线会红。
module Vuna.Cli.Registry where

import Vuna.Cli.Help
import Vuna.Cli.Err
import Vuna.Cli.Fmt
import Vuna.Cli.Index
import Vuna.Cli.Repl
import Vuna.Cli.Spec
import Vuna.Cli.Test
import Vuna.Plugin.Command
import Vuna.Plugin.Describe
import Vuna.Plugin.Help
import Vuna.Plugin.Suggest
import Vuna.Add
import Vuna.Clean
import Vuna.Doc
import Vuna.Explain
import Vuna.Fetch
import Vuna.Lint
import Vuna.Lsp
import Vuna.Run
import Vuna.Search
import Base.Effect.Types as EffTypes
import Base.Effect.Args as EffArgs
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Env as EffEnv
import Base.Effect.Exit as EffExit
import Base.Effect.Fs as EffFs
import Base.Effect.Net as EffNet
import Base.Effect.Process as EffProcess
import Base.Effect.Stdin as EffStdin

-- | 一条命令的接线：路径 + 实现（实现收到路径之后的剩余参数）。
export record Handler(..) where
  -- | 命令路径（不含程序名）。
  handlerPath : List String
  -- | 实现；效应行是 CLI 入口实际用到的全部标签。
  handlerRun : List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int

-- | 产品命令表。编译器命令把 argv 原样转交 `CompilerCli`（flag 真源在编译器包里）。
export handlers : List Handler
handlers =
  [
    Handler ["run"] (\rest => Vuna.Run.runRun rest),
    Handler ["test"] (\rest => testArgs rest),
    Handler ["fmt"] (\rest => fmtArgs rest),
    Handler ["lint"] (\rest => Vuna.Lint.runLint rest),
    Handler ["doc"] (\rest => Vuna.Doc.runDoc rest),
    Handler ["search"] (\rest => Vuna.Search.runSearch rest),
    Handler ["map"] (\rest => mapArgs rest),
    Handler ["api"] (\rest => apiArgs rest),
    Handler ["goal"] (\rest => goalArgs rest),
    Handler ["errors"] (\rest => errorsArgs rest),
    Handler ["deps"] (\rest => depsArgs rest),
    Handler ["store"] (\rest => storeArgs rest),
    Handler ["repl"] (\rest => replArgs rest),
    Handler ["lsp"] (\rest => Vuna.Lsp.runLspTool rest)
  ]

-- | 插件入口：读 argv，处理 describe / help，其余交给接线表。
export runPlugin : Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int
runPlugin =
  do
    args <- argsGetArgs
    runArgs args

-- | 按 argv 执行一条命令；`--vuna-describe [FILE]` 与 `--help` 优先。
export runArgs : List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int
runArgs raw = runArgsClean (withoutPerfFlag raw)

-- | 内部：`runArgs` 的主体（已去掉隐藏旗标）。
runArgsClean : List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int
runArgsClean args =
  case args of
    ["--vuna-describe"] => printText (Describe.render "toolchain" commands)
    "--vuna-describe" :: file :: more => writeDescribe file
    _ =>
      case helpPathIn 3 commands args of
        Just path => printHelp path
        Nothing => dispatch args

-- | 内部：把命令表写到 `file`（入口据此收集插件的命令面）。
writeDescribe : String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int
writeDescribe file =
  do
    _ <- fsWriteFileAtomic file (Describe.render "toolchain" commands)
    pure 0

-- | 内部：打印某路径的帮助；未登记给未知命令。
printHelp : List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int
printHelp path =
  case helpForPath path of
    Just text => printText text
    Nothing => printText (unknownCommandText (join " " path))

-- | 内部：分派——查接线表，未知命令给建议。
dispatch : List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int
dispatch args =
  case args of
    [] =>
      do
        _ <- consolePrint overviewText
        pure 2
    arg :: _ =>
      case matchHandler args of
        Just (Pair h rest) => h.handlerRun rest
        Nothing => printText (unknownCommandText arg)

-- | 内部：打印文本并返回 0。
printText : String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp] Int
printText text =
  do
    _ <- consolePrint text
    pure 0

-- | 内部：未知命令文案（附最近候选）。
unknownCommandText : String -> String
unknownCommandText arg =
  case suggestOne (topLevelNamesOf commands) arg of
    Just guess => "error: unknown command `${arg}`; did you mean `${guess}`?\nrun `vuna help`\n"
    Nothing => "error: unknown command `${arg}`\nrun `vuna help`\n"

-- | 按最长前缀匹配一条命令（最多 3 段），返回实现与剩余参数。
export matchHandler : List String -> Maybe (Pair Handler (List String))
matchHandler args = matchDepth 3 args

-- | 内部：按深度从 3 到 1 尝试精确路径匹配（最长优先）。
matchDepth : Int -> List String -> Maybe (Pair Handler (List String))
matchDepth n args =
  if n <= 0 then
    Nothing
  else
    case findHandler (take n args) of
      Just h => Just (Pair h (drop n args))
      Nothing => matchDepth (n - 1) args

-- | 内部：按路径精确查找实现。
findHandler : List String -> Maybe Handler
findHandler path = findHandlerIn path handlers

-- | 内部：`findHandler` 的线性扫描。
findHandlerIn : List String -> List Handler -> Maybe Handler
findHandlerIn path [] = Nothing
findHandlerIn path (h :: rest) = if h.handlerPath == path then Just h else findHandlerIn path rest

-- | 内部：`vuna errors` 子命令。
errorsArgs : Member nFs FsOp r, Member nConsole ConsoleOp r => List String -> Eff r Int
errorsArgs ("list" :: more) = Vuna.Explain.runExplainList more
errorsArgs ("explain" :: more) = Vuna.Explain.runExplainCode more
errorsArgs [] = usageErrorFor ["errors"]
errorsArgs (bad :: _) = unknownSubcommand ["errors"] bad ["list", "explain"]

-- | 内部：`vuna deps` 子命令。
depsArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
depsArgs ("add" :: more) = Vuna.Add.runAdd more
depsArgs ("fetch" :: more) = Vuna.Fetch.runFetch more
depsArgs ("pin" :: more) = Vuna.Fetch.runPin more
depsArgs [] = usageErrorFor ["deps"]
depsArgs (bad :: _) = unknownSubcommand ["deps"] bad ["add", "fetch", "pin"]

-- | 内部：`vuna store` 子命令。
storeArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
storeArgs ("gc" :: more) = Vuna.Clean.runStoreGc more
storeArgs ("clean" :: more) = Vuna.Clean.runClean more
storeArgs [] = usageErrorFor ["store"]
storeArgs (bad :: _) = unknownSubcommand ["store"] bad ["gc", "clean"]

-- | 内部：去掉隐藏的性能旗标（runtime 从原始 argv 读取，命令解析要忽略）。
withoutPerfFlag : List String -> List String
withoutPerfFlag [] = []
withoutPerfFlag (a :: rest) =
  if a == "--debug-perf" then withoutPerfFlag rest else a :: withoutPerfFlag rest
