-- | 把源码解析成文档模型（工具链；永不进 seed 闭包）。
--
-- 输入是一组源文件路径与包名，输出 `DocBook`（模块 -> 条目/成员 + docstring）。
-- 不跑类型检查：签名 / 类型 / data 形状都来自 parse 级 AST，docstring 来自
-- [Vuna.Doc.Comments]；`[export]` 过滤在 [Vuna.Doc.Run]，HTML 渲染在 [Vuna.Doc.Html]。
module Vuna.Doc.Model where

import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Loader.Fixity
import Vuna.Doc.Comments
import Vuna.Doc.Types
import Vuna.FixityEnv
import Vuna.Sig
import Base.Effect.Types as EffTypes
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Data.Sort
import Base.Thread.Par as Par

-- ---------------------------------------------------------------
-- 数据模型
-- ---------------------------------------------------------------
-- | 文档里的一个条目：一个顶层声明，或某个类型的成员（构造子 / 字段 / trait 方法）。
export record DocItem(..) where
  -- | 条目名（成员条目是成员名）。
  itemName : String
  -- | 条目种类：`fun` / `data` / `record` / `trait` / `axiom` / `extern` / `ctor` / `field` / `method`。
  itemKind : String
  -- | 渲染好的签名文本；成员条目形如 `name : Type`。
  itemSignature : String
  -- | docstring 正文；空串表示没有。
  itemDoc : String
  -- | 源码起始行号（1 基）。
  itemLine : Int
  -- | 成员条目（构造子 / 字段 / 方法）；顶层条目为空表。
  itemMembers : List DocItem

-- | 一个模块的文档：包名、模块全名、源路径、模块 docstring 与条目列表。
export record DocModule(..) where
  -- | 所属包名；单目录模式为空串。
  modulePackage : String
  -- | 模块全名；没有 `module` 头时取文件名去掉 `.vuna`。
  moduleName : String
  -- | 源文件路径（`--check` 定位与缓存键用）。
  modulePath : String
  -- | 模块头 docstring；空串表示没有。
  moduleDoc : String
  -- | 顶层条目，顺序与源码一致。
  moduleItems : List DocItem

-- | 整份文档：按包与文件顺序排列的模块列表。
export record DocBook(..) where
  -- | 模块列表；顺序由构建时的 scope 与文件顺序决定。
  bookModules : List DocModule

-- ---------------------------------------------------------------
-- 构建
-- ---------------------------------------------------------------
-- | 一个 scope 的构建输入：展示用包名（单目录模式为空串）与源文件。
export record DocScopeInput(..) where
  docScopeInputPackage : String
  docScopeInputPaths : List String

-- | 内部：单个文件的构建输入（已展开 scope / 文件下标）。
record DocPending where
  docPendingScope : Int
  docPendingIndex : Int
  docPendingPackage : String
  docPendingPath : String

-- | 内部：目录上下文已解析、权重已测好的文件目标。
record DocTarget where
  docTargetScope : Int
  docTargetIndex : Int
  docTargetPackage : String
  docTargetPath : String
  docTargetGroup : String
  docTargetCtx : Check PackageContext
  docTargetSize : Int

-- | 内部：一个 worker 单元（同一包上下文的连续文件）。
record DocUnit where
  docUnitTargets : List DocTarget

-- | 内部：一个 worker 的装载。
record DocBin where
  docBinWeight : Int
  docBinUnits : List DocUnit

-- | 内部：每单元文件数上限。单包过大时切开，避免一个包钉住一个 worker；切块各自加载一次
-- 模块图，所以上限远大于常见包大小（与 lint 同口径）。
docUnitFiles : Int
docUnitFiles = 128

-- | 内部：worker 数上限。并行度再高时每个 worker 重载自己的上下文模块图、GC 并行开销
-- 会抵消收益（与 lint 同口径）。
docMaxWorkers : Int
docMaxWorkers = 8

-- | 内部：每个单元加载一次模块图的固定开销（折算成字节，参与装箱）。
docContextWeight : Int
docContextWeight = 200000

-- | 并行构建全部 scope 的模块：结果与输入一一对应且保持 scope / 文件顺序；按该顺序的
-- 首个错误返回。上下文解析在父线程完成，worker 只读文件（`runFsResult` 收口）。
export buildScopeModules : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List DocScopeInput -> Eff r (Check (List (List DocModule)))
buildScopeModules inputs =
  do
    targets <- resolveDocTargets (flattenDocInputs inputs)
    let
      units = concatMap docUnitsOfGroup (docGroupTargets targets)
      bins = docAssignUnits docMaxWorkers units
    in do
      if length bins == 0 then
        pure (OkC (map docEmptyGroup inputs))
      else
        do
          ran <- Par.parMapEff runFsResult docBin bins
          case docJoinResults ran of
            ErrC e => pure (ErrC e)
            OkC rows => pure (assembleDocGroups (map docCountOfInput inputs) (Sort.sortBy docResultLe rows))

-- | 内部：每个输入的源文件数（结果按 scope 切分）。
docCountOfInput : DocScopeInput -> Int
docCountOfInput input = natToInt (length input.docScopeInputPaths)

-- | 内部：空分组（所有 scope 都没有源文件时）。
docEmptyGroup : DocScopeInput -> List DocModule
docEmptyGroup _ = []

-- | 内部：把 scope 输入展开成带下标的目标。
flattenDocInputs : List DocScopeInput -> List DocPending
flattenDocInputs inputs = flattenDocInputsGo 0 inputs []

flattenDocInputsGo : Int -> List DocScopeInput -> List DocPending -> List DocPending
flattenDocInputsGo _ [] acc = reverse acc
flattenDocInputsGo scopeIdx (input :: rest) acc =
  flattenDocInputsGo (scopeIdx + 1) rest (append acc (pendingsOfScope scopeIdx input))

pendingsOfScope : Int -> DocScopeInput -> List DocPending
pendingsOfScope scopeIdx input =
  pendingsOfFiles scopeIdx input.docScopeInputPackage 0 input.docScopeInputPaths

pendingsOfFiles : Int -> String -> Int -> List String -> List DocPending
pendingsOfFiles _ _ _ [] = []
pendingsOfFiles scopeIdx pkg index (path :: rest) =
  DocPending scopeIdx index pkg path :: pendingsOfFiles scopeIdx pkg (index + 1) rest

-- | 内部：按目录缓存 `contextForFile`，逐文件解析包上下文并测源字节数（只影响装箱权重）。
resolveDocTargets : Member nFs FsOp r, Member nEnv EnvOp r => List DocPending -> Eff r (List DocTarget)
resolveDocTargets pending = resolveDocTargetsGo pending [] []

resolveDocTargetsGo : Member nFs FsOp r, Member nEnv EnvOp r => List DocPending -> List (String, Check PackageContext) -> List DocTarget -> Eff r (List DocTarget)
resolveDocTargetsGo [] _ acc = pure (reverse acc)
resolveDocTargetsGo (p :: rest) cache acc =
  let
    dir = parentOf p.docPendingPath
  in case lookupDocContext dir cache of
    Just ctxR =>
      do
        size <- docFileSize p.docPendingPath
        resolveDocTargetsGo rest cache (mkDocTarget p ctxR size :: acc)
    Nothing =>
      do
        ctxR <- contextForFile p.docPendingPath
        size <- docFileSize p.docPendingPath
        resolveDocTargetsGo rest ((dir, ctxR) :: cache) (mkDocTarget p ctxR size :: acc)

lookupDocContext : String -> List (String, Check PackageContext) -> Maybe (Check PackageContext)
lookupDocContext _ [] = Nothing
lookupDocContext key ((k, v) :: rest) = if k == key then Just v else lookupDocContext key rest

docFileSize : Member nFs FsOp r => String -> Eff r Int
docFileSize path =
  do
    sizeR <- fsFileSize path
    pure (
        case sizeR of
          Just n => natToInt n
          Nothing => 0
      )

mkDocTarget : DocPending -> Check PackageContext -> Int -> DocTarget
mkDocTarget p ctxR size =
  let
    dir = parentOf p.docPendingPath
    key =
      case ctxR of
        OkC ctx => "ctx:${contextDir ctx}"
        ErrC _ => "dir:${dir}"
  in DocTarget
    p.docPendingScope
    p.docPendingIndex
    p.docPendingPackage
    p.docPendingPath
    key
    ctxR
    size

-- | 内部：按分组键聚合（保持首次出现顺序与组内输入顺序）。
docGroupTargets : List DocTarget -> List (String, List DocTarget)
docGroupTargets targets = foldl docAddGroup [] targets

docAddGroup : List (String, List DocTarget) -> DocTarget -> List (String, List DocTarget)
docAddGroup [] t = [(t.docTargetGroup, [t])]
docAddGroup ((k, ts) :: rest) t =
  if k == t.docTargetGroup then (k, append ts [t]) :: rest else (k, ts) :: docAddGroup rest t

-- | 内部：组 → 单元（每单元 ≤ `docUnitFiles` 个文件，保持输入顺序）。
docUnitsOfGroup : (String, List DocTarget) -> List DocUnit
docUnitsOfGroup pair = map (\chunk => DocUnit chunk) (docChunkTargets docUnitFiles (secondOf pair))

-- | 内部：切块；`fuel` 是剩余块数上界。
docChunkTargets : Int -> List DocTarget -> List (List DocTarget)
docChunkTargets size xs =
  let
    width = if size < 1 then 1 else size
  in docChunkTargetsGo width (natToInt (length xs)) xs

docChunkTargetsGo : Int -> Int -> List DocTarget -> List (List DocTarget)
docChunkTargetsGo size fuel xs =
  if fuel <= 0 || length xs == 0 then
    []
  else
    take size xs :: docChunkTargetsGo size (fuel - 1) (drop size xs)

-- | 内部：装箱权重 = 源字节数 + 每个上下文的固定开销。
docUnitWeight : DocUnit -> Int
docUnitWeight u = foldl (\n, t => n + docTargetWeight t) 0 u.docUnitTargets + docContextWeight

docTargetWeight : DocTarget -> Int
docTargetWeight t = t.docTargetSize

docEmptyBins : Int -> List DocBin
docEmptyBins n = if n <= 0 then [] else DocBin 0 [] :: docEmptyBins (n - 1)

docMinBinWeight : List DocBin -> Int
docMinBinWeight [] = 0
docMinBinWeight (b :: rest) = docMinBinWeightGo b.docBinWeight rest

docMinBinWeightGo : Int -> List DocBin -> Int
docMinBinWeightGo m [] = m
docMinBinWeightGo m (b :: rest) =
  docMinBinWeightGo (if b.docBinWeight < m then b.docBinWeight else m) rest

docPlaceUnitAt : Int -> Int -> DocUnit -> List DocBin -> List DocBin
docPlaceUnitAt _ _ _ [] = []
docPlaceUnitAt target weight u (b :: rest) =
  if b.docBinWeight == target then
    DocBin (b.docBinWeight + weight) (append b.docBinUnits [u]) :: rest
  else
    b :: docPlaceUnitAt target weight u rest

docPlaceUnit : DocUnit -> List DocBin -> List DocBin
docPlaceUnit u bins = docPlaceUnitAt (docMinBinWeight bins) (docUnitWeight u) u bins

docHasUnits : DocBin -> Bool
docHasUnits b =
  case b.docBinUnits of
    [] => False
    _ => True

-- | 内部：LPT 装箱：大块优先，放进当前最轻的 bin。
docAssignUnits : Int -> List DocUnit -> List DocBin
docAssignUnits jobs units =
  let
    sorted = Sort.sortBy (\a, b => docUnitWeight a >= docUnitWeight b) units
    bins = foldl (\bs, u => docPlaceUnit u bs) (docEmptyBins jobs) sorted
  in filter docHasUnits bins

-- | 内部：一个 worker——单元与单元内文件都顺序执行，`FixityEnv` 在文件之间串接
-- （同包模块图只加载一次，与 lint 的 bin 同形）。
docBin : DocBin -> Eff [FsOp] (List (Int, Int, Check DocModule))
docBin b = docBinGo b.docBinUnits emptyFixityEnv []

docBinGo : List DocUnit -> FixityEnv -> List (Int, Int, Check DocModule) -> Eff [FsOp] (List (Int, Int, Check DocModule))
docBinGo [] _ acc = pure (reverse acc)
docBinGo (u :: rest) env acc =
  case u.docUnitTargets of
    [] => docBinGo rest env acc
    _ =>
      do
        stepped <- docUnitGo u.docUnitTargets env acc
        docBinGo rest (firstOf stepped) (secondOf stepped)

docUnitGo : List DocTarget -> FixityEnv -> List (Int, Int, Check DocModule) -> Eff [FsOp] (FixityEnv, List (Int, Int, Check DocModule))
docUnitGo [] env acc = pure (env, acc)
docUnitGo (t :: rest) env acc =
  do
    stepped <- docTargetBuild t env
    docUnitGo rest (firstOf stepped) ((t.docTargetScope, t.docTargetIndex, secondOf stepped) :: acc)

-- | 内部：一个文件——读盘、解析、按已解析上下文取 fixity，再交给纯构建。
docTargetBuild : DocTarget -> FixityEnv -> Eff [FsOp] (FixityEnv, Check DocModule)
docTargetBuild t env =
  do
    textR <- readText t.docTargetPath
    case textR of
      ErrC e => pure (env, ErrC e)
      OkC source =>
        case parseSourceDetailed t.docTargetPath source of
          ErrC e => pure (env, err "${t.docTargetPath}: ${diagText e}")
          OkC parsed =>
            case t.docTargetCtx of
              ErrC e => pure (buildModuleWith t.docTargetPackage t.docTargetPath source parsed (env, ErrC e))
              OkC ctx =>
                do
                  looked <- fixitiesForCtx env ctx t.docTargetPath parsed.parsedFile
                  pure (buildModuleWith t.docTargetPackage t.docTargetPath source parsed looked)

-- | 内部：worker 级失败（host 读写）与逐文件错误分开：前者按 bin 顺序取第一个。
docJoinResults : List (Result (List (Int, Int, Check DocModule))) -> Check (List (Int, Int, Check DocModule))
docJoinResults [] = OkC []
docJoinResults (r :: rest) =
  case r of
    Err msg => err msg
    Ok rows =>
      case docJoinResults rest of
        ErrC e => ErrC e
        OkC more => OkC (append rows more)

-- | 内部：结果按（scope, 文件）下标排序，再做稳定拆分。
docResultLe : (Int, Int, Check DocModule) -> (Int, Int, Check DocModule) -> Bool
docResultLe a b =
  let
    sa = firstOf a
    sb = firstOf b
    ia = firstOf (secondOf a)
    ib = firstOf (secondOf b)
  in if sa < sb then True else if sa > sb then False else ia <= ib

-- | 内部：按每个 scope 的文件数切回分组；按该顺序的首个错误返回。
assembleDocGroups : List Int -> List (Int, Int, Check DocModule) -> Check (List (List DocModule))
assembleDocGroups [] _ = OkC []
assembleDocGroups (n :: rest) rows =
  case takeDocModules n rows [] of
    ErrC e => ErrC e
    OkC (mods, more) =>
      case assembleDocGroups rest more of
        ErrC e => ErrC e
        OkC groups => OkC (mods :: groups)

takeDocModules : Int -> List (Int, Int, Check DocModule) -> List DocModule -> Check (List DocModule, List (Int, Int, Check DocModule))
takeDocModules n [] acc = OkC (reverse acc, [])
takeDocModules n (r :: rest) acc =
  if n <= 0 then
    OkC (reverse acc, r :: rest)
  else
    case r of
      (_, _, result) =>
        case result of
          ErrC e => ErrC e
          OkC m => takeDocModules (n - 1) rest (m :: acc)

-- | 内部：把已解析的源码转成 `DocModule`；fixity 重排失败带路径进 `ErrC`。
buildModuleWith : String -> String -> String -> ParsedSource -> (FixityEnv, Check (List FixityDecl)) -> (FixityEnv, Check DocModule)
buildModuleWith pkg path source parsed looked =
  let
    env2 = firstOf looked
  in case secondOf looked of
    ErrC e => (env2, err "${path}: cannot load package fixity context: ${diagText e}")
    OkC programFixities =>
      case parsed.parsedFile of
        SourceFile hdr imports fx decls0 _ _ _ =>
          case reorderProgram (tableOfKeepOpsCst parsed.parsedCst (append programFixities fx)) decls0 of
            ErrC e => (env2, err "${path}: ${diagText e}")
            OkC decls =>
              let
                comments = parsed.parsedComments
                table = docTableOf hdr decls comments
              in (env2,
                OkC
                  (DocModule pkg (moduleNameOfPath path hdr) path (docTableModuleDoc table) (itemsOfDecls table decls)))

-- | 内部：优先取 `module X where` 的名字；没有模块头时用文件名去掉 `.vuna`。
moduleNameOfPath : String -> Maybe ModDecl -> String
moduleNameOfPath path (Just (ModDecl name hasList items _ _ _ sp)) = name
moduleNameOfPath path Nothing = stripVunaSuffix (baseName path)

-- | 内部：去掉文件名末尾的 `.vuna`。
stripVunaSuffix : String -> String
stripVunaSuffix name =
  if endsWith ".vuna" name then substring 0 (byteLength name - 5) name else name

-- ---------------------------------------------------------------
-- 条目
-- ---------------------------------------------------------------
-- | 内部：把声明表按源码顺序展开成条目，并按名字去重。
itemsOfDecls : DocTable -> List Decl -> List DocItem
itemsOfDecls table decls = dedupeItems (concatMap (itemsOfDecl table decls) decls)

-- | 内部：一个声明对应的条目。
--
-- 私有（`_` 开头）跳过；`DFun` 在有同名签名时跳过（签名条目已覆盖）；`instance` 不产生条目。
itemsOfDecl : DocTable -> List Decl -> Decl -> List DocItem
itemsOfDecl table decls (DSig name ctx ty sp) =
  if isPrivate name then
    []
  else
    [
      DocItem
        name
        "fun"
        "${name} : ${renderTypeInCtx ctx ty}"
        (docForDecl table name)
        (spanStartLine (nodeRefSpan sp))
        []
    ]
itemsOfDecl table decls (DFun name pats body sp) =
  if isPrivate name || hasSig name decls then
    []
  else
    [
      DocItem
        name
        "fun"
        "${name} : ${renderType (EVar name (detachedNodeRef (nodeRefSpan sp)))}"
        (docForDecl table name)
        (spanStartLine (nodeRefSpan sp))
        []
    ]
itemsOfDecl table decls (DData name params kind ctors derivings viaField repr lin sp) =
  if isPrivate name then
    []
  else
    [
      DocItem
        name
        "data"
        (dataSignature name params kind ctors derivings)
        (docForDecl table name)
        (spanStartLine (nodeRefSpan sp))
        (ctorItems table name ctors)
    ]
itemsOfDecl table decls (DRecord name params fields derivings viaField repr lin sp) =
  if isPrivate name then
    []
  else
    [
      DocItem
        name
        "record"
        (recordSignature name params fields derivings)
        (docForDecl table name)
        (spanStartLine (nodeRefSpan sp))
        (fieldItems table name fields)
    ]
itemsOfDecl table decls (DTrait name params supers methods sp) =
  if isPrivate name then
    []
  else
    [
      DocItem
        name
        "trait"
        (traitSignature name params supers methods)
        (docForDecl table name)
        (spanStartLine (nodeRefSpan sp))
        (methodItems table name methods)
    ]
itemsOfDecl table decls (DAxiom name ty sp) =
  if isPrivate name then
    []
  else
    [
      DocItem
        name
        "axiom"
        "axiom ${name} : ${renderType ty}"
        (docForDecl table name)
        (spanStartLine (nodeRefSpan sp))
        []
    ]
itemsOfDecl table decls (DExtern name cName ty sp) =
  if isPrivate name then
    []
  else
    [
      DocItem
        name
        "extern"
        "extern ${name} : ${renderType ty}"
        (docForDecl table name)
        (spanStartLine (nodeRefSpan sp))
        []
    ]
itemsOfDecl table decls (DInstance ctxE head methods sp) = []

-- | 内部：声明表里是否有该名字的顶层签名。
--
-- 顶层签名是语言要求；缺签名时 `DFun` 用一个占位签名进文档，避免 doc 静默丢条目
-- （`vuna check` 会先报缺签名）。
hasSig : String -> List Decl -> Bool
hasSig name [] = False
hasSig name (d :: rest) =
  case d of
    DSig n ctx ty sp => if n == name then True else hasSig name rest
    _ => hasSig name rest

-- | 内部：按名字去重，保留首次出现。
dedupeItems : List DocItem -> List DocItem
dedupeItems items = dedupeItemsGo items []

-- | 内部：`dedupeItems` 的 `seen` 累加实现。
dedupeItemsGo : List DocItem -> List String -> List DocItem
dedupeItemsGo [] seen = []
dedupeItemsGo (i :: rest) seen =
  if memName (itemName i) seen then
    dedupeItemsGo rest seen
  else
    i :: dedupeItemsGo rest (itemName i :: seen)

-- | 内部：名字是否以 `_` 开头（私有项不收录）。
isPrivate : String -> Bool
isPrivate name =
  case strUnpack name of
    c :: rest => c == 95
    [] => False

-- ---------------------------------------------------------------
-- 签名块
-- ---------------------------------------------------------------
-- | 内部：类型参数后缀；无参数时为空串。
paramSuffix : List String -> String
paramSuffix [] = ""
paramSuffix params = " ${join " " params}"

-- | 内部：`deriving (...)` 行；没有 deriving 时为空表。
derivingLines : List String -> List String
derivingLines [] = []
derivingLines derivings = ["deriving (${join ", " derivings})"]

-- | 内部：`data ... where` 签名块（构造子 + deriving）。
dataSignature : String -> List String -> Expr -> List Ctor -> List String -> String
dataSignature name params kind ctors derivings =
  join
    "\n"
    ("data ${name}${paramSuffix params} : ${renderType kind} where" :: append (map ctorLine ctors) (derivingLines derivings))

-- | 内部：`record ... where` 签名块（字段 + deriving）。
recordSignature : String -> List String -> List Field -> List String -> String
recordSignature name params fields derivings =
  join
    "\n"
    ("record ${name}${paramSuffix params} where" :: append (map fieldLine fields) (derivingLines derivings))

-- | 内部：`trait` 签名块（父类上下文 + 方法）。
traitSignature : String -> List TraitParam -> List Expr -> List TraitMethod -> String
traitSignature name params supers methods =
  join
    "\n"
    ("trait ${ctxText supers}${name}${traitParamSuffix params} where" :: map methodLine methods)

-- | 内部：trait 的父类上下文前缀；没有父类时为空串。
ctxText : List Expr -> String
ctxText [] = ""
ctxText supers = join ", " (map renderType supers) ++ " => "

-- | 内部：trait 参数后缀；无参数时为空串。
traitParamSuffix : List TraitParam -> String
traitParamSuffix [] = ""
traitParamSuffix params = " " ++ join " " (map traitParamText params)

-- | 内部：单个 trait 参数的渲染（匿名名，或 `(n : kind)`）。
traitParamText : TraitParam -> String
traitParamText (TraitParam n Nothing) = n
traitParamText (TraitParam n (Just k)) = "(${n} : ${renderType k})"

-- | 内部：一行构造子声明。
ctorLine : Ctor -> String
ctorLine (Ctor name ty arity sp) = "  ${name} : ${renderType ty}"

-- | 内部：一行字段声明。
fieldLine : Field -> String
fieldLine (Field name ty sp) = "  ${name} : ${renderType ty}"

-- | 内部：一行 trait 方法声明。
methodLine : TraitMethod -> String
methodLine m = "  ${traitMethodName m} : ${renderType m.traitMethodType}"

-- ---------------------------------------------------------------
-- 成员条目
-- ---------------------------------------------------------------
-- | 内部：把构造子转成 `ctor` 成员条目。
ctorItems : DocTable -> String -> List Ctor -> List DocItem
ctorItems table parent ctors =
  map
    (\c => DocItem (ctorName c) "ctor" "${ctorName c} : ${renderType (ctorType c)}" (docForMember table parent (ctorName c)) (spanStartLine (ctorSpan c)) [])
    ctors

-- | 内部：把字段转成 `field` 成员条目。
fieldItems : DocTable -> String -> List Field -> List DocItem
fieldItems table parent fields =
  map
    (\f => DocItem (fieldName f) "field" "${fieldName f} : ${renderType (fieldType f)}" (docForMember table parent (fieldName f)) (spanStartLine (fieldSpan f)) [])
    fields

-- | 内部：把 trait 方法转成 `method` 成员条目。
methodItems : DocTable -> String -> List TraitMethod -> List DocItem
methodItems table parent methods =
  map
    (\m => DocItem (traitMethodName m) "method" "${traitMethodName m} : ${renderType m.traitMethodType}" (docForMember table parent (traitMethodName m)) (spanStartLine (traitMethodSpan m)) [])
    methods
