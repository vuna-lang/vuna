-- | 从 `lexComments` 的原始注释里识别 docstring 并关联到声明。
--
-- 识别（只有这几种是 docstring，普通注释永远不进入文档）：行块首行 `-- | ...`（前置）或
-- `-- ^ ...`（尾随），同列、行号连续的 `--` 续行，空行结束；块注释 `{- | ... -}` /
-- `{-| ... -}`（前置）与 `{- ^ ... -}`（尾随），剥离首部标记后按最小公共缩进 dedent。
--
-- 关联：前置 doc block 归到第一个行号更大、列相同、行距不超过 2 行、中间没有其他注释的目标
-- （模块头 / 顶层声明 / 构造子 / 字段 / trait 方法）；尾随 doc block 归到同一行、列在注释
-- 左侧的目标（模块头不参与）。两种位置同时存在时前置优先，孤儿 doc 忽略。
--
-- 顶层签名 `DSig` 与同名 `DFun`：doc 写在签名前或首子句前都归到该名字（先出现者优先）。
module Vuna.Doc.Comments where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Doc.Types

-- ---------------------------------------------------------------
-- 目标
-- ---------------------------------------------------------------
-- | 一个可挂 docstring 的目标：模块头、顶层声明或类型成员。
--
-- `kind` 取 `module` / `decl` / `member`；成员的 parent 是所属 `data` / `record` / `trait` 名。
record DocTarget where
  -- | 目标起始行号（1 基）。
  targetLine : Int
  -- | 目标起始列号（1 基）；前置关联要求列与 doc block 相同。
  targetCol : Int
  -- | 目标种类：`module` / `decl` / `member`。
  targetKind : String
  -- | 目标名：模块名、顶层名或成员名。
  targetName : String
  -- | 成员所属的类型名；非成员为空串。
  targetParent : String

-- | 内部：目标起始行号。
targetLine : DocTarget -> Int
targetLine (DocTarget line col kind name parent) = line

-- | 内部：目标起始列号。
targetCol : DocTarget -> Int
targetCol (DocTarget line col kind name parent) = col

-- | 内部：目标种类。
targetKind : DocTarget -> String
targetKind (DocTarget line col kind name parent) = kind

-- | 内部：目标名。
targetName : DocTarget -> String
targetName (DocTarget line col kind name parent) = name

-- | 内部：成员所属的类型名。
targetParent : DocTarget -> String
targetParent (DocTarget line col kind name parent) = parent

-- | 内部：目标的文本键（种类、父名、名字、行、列用制表符连接）。
targetKey : DocTarget -> String
targetKey t = "${targetKind t}\t${targetParent t}\t${targetName t}\t${targetLine t}\t${targetCol t}"

-- | 模块头目标；没有模块声明时为空表。
moduleTargets : Maybe ModDecl -> List DocTarget
moduleTargets Nothing = []
moduleTargets (Just (ModDecl name hasList items _ _ _ sp)) =
  [DocTarget (spanStartLine sp) (spanStartCol sp) "module" name ""]

-- | 内部：逐个声明展开目标表。
targetsOfDecls : List Decl -> List DocTarget
targetsOfDecls [] = []
targetsOfDecls (d :: rest) = append (targetsOfDecl d) (targetsOfDecls rest)

-- | 一个声明的目标：`data` / `record` / `trait` 连同成员，其余声明一个顶层目标，`instance` 不产生目标。
targetsOfDecl : Decl -> List DocTarget
targetsOfDecl (DData name params kind ctors derivings viaField repr lin sp) =
  DocTarget (spanStartLine (nodeRefSpan sp)) 1 "decl" name "" :: ctorTargets name ctors
targetsOfDecl (DRecord name params fields derivings viaField repr lin sp) =
  DocTarget (spanStartLine (nodeRefSpan sp)) 1 "decl" name "" :: fieldTargets name fields
targetsOfDecl (DTrait name params supers methods sp) =
  DocTarget (spanStartLine (nodeRefSpan sp)) 1 "decl" name "" :: methodTargets name methods
targetsOfDecl (DSig name ctx ty sp) = [DocTarget (spanStartLine (nodeRefSpan sp)) 1 "decl" name ""]
targetsOfDecl (DFun name pats body sp) =
  [DocTarget (spanStartLine (nodeRefSpan sp)) 1 "decl" name ""]
targetsOfDecl (DAxiom name ty sp) = [DocTarget (spanStartLine (nodeRefSpan sp)) 1 "decl" name ""]
targetsOfDecl (DExtern name cName ty sp) =
  [DocTarget (spanStartLine (nodeRefSpan sp)) 1 "decl" name ""]
targetsOfDecl (DInstance ctxE head methods sp) = []

-- | 内部：把 `data` 的构造子展开成成员目标。
ctorTargets : String -> List Ctor -> List DocTarget
ctorTargets parent [] = []
ctorTargets parent (c :: rest) =
  DocTarget (spanStartLine (ctorSpan c)) (spanStartCol (ctorSpan c)) "member" (ctorName c) parent
    :: ctorTargets parent rest

-- | 内部：把 `record` 的字段展开成成员目标。
fieldTargets : String -> List Field -> List DocTarget
fieldTargets parent [] = []
fieldTargets parent (f :: rest) =
  DocTarget (spanStartLine (fieldSpan f)) (spanStartCol (fieldSpan f)) "member" (fieldName f) parent
    :: fieldTargets parent rest

-- | 内部：把 `trait` 的方法展开成成员目标。
methodTargets : String -> List TraitMethod -> List DocTarget
methodTargets parent [] = []
methodTargets parent (m :: rest) =
  DocTarget
    (spanStartLine (traitMethodSpan m))
    (spanStartCol (traitMethodSpan m))
    "member"
    (traitMethodName m)
    parent :: methodTargets parent rest

-- ---------------------------------------------------------------
-- 识别 doc block
-- ---------------------------------------------------------------
-- | 正在收集的行 doc 块：已收的正文行、首末行号与该块要求的列。
record OpenLineBlock where
  -- | 已收的正文行（尚未用换行拼接）。
  openLines : List String
  -- | 块首行行号。
  openStartLine : Int
  -- | 已收的末行行号；下一行必须紧接它。
  openEndLine : Int
  -- | 块起始列；续行必须同列。
  openCol : Int

-- | 前置 doc block（`-- |` / `{- | -}`），按源码顺序。
--
-- 两轮收集互不混淆：遇到另一轮的标记时当前块就收尾，该标记交给对应的收集轮
-- （否则 `-- ^` 会被当成 `-- |` 块的续行）。
docBlocksOf : List Comment -> List DocBlock
docBlocksOf comments = reverse (docBlocksGo "|" comments Nothing [])

-- | 尾随 doc block（`-- ^` / `{- ^ -}`），按源码顺序；续行与收尾规则与前置相同。
trailBlocksOf : List Comment -> List DocBlock
trailBlocksOf comments = reverse (docBlocksGo "^" comments Nothing [])

-- | 内部：收集 `marker`（`"|"` 或 `"^"`）这一轮的 doc block；行块按同列连续行续接，块注释整体成块。
docBlocksGo : String -> List Comment -> Maybe OpenLineBlock -> List DocBlock -> List DocBlock
docBlocksGo marker [] open acc = closeOpenBlock open acc
docBlocksGo marker (c :: rest) open acc =
  case c.commentKind of
    CLine =>
      case lineDocMarker c.commentText of
        Just (Pair m body) =>
          if not (m == marker) then
            docBlocksGo marker rest Nothing (closeOpenBlock open acc)
          else
            case open of
              Just ob => if continuesOpen ob c then docBlocksGo marker rest (Just (appendOpenLine ob body)) acc else docBlocksGo marker rest (Just (newOpenBlock body c)) (closeOpenBlock open acc)
              Nothing => docBlocksGo marker rest (Just (newOpenBlock body c)) acc
        Nothing =>
          case open of
            Just ob =>
              if continuesOpen ob c then
                docBlocksGo marker rest (Just (appendOpenLine ob (stripOneSpace c.commentText))) acc
              else
                docBlocksGo marker rest Nothing (closeOpenBlock open acc)
            Nothing => docBlocksGo marker rest Nothing acc
    CBlock =>
      case blockDocMarker c.commentText of
        Just (Pair m body) =>
          if m == marker then
            docBlocksGo
              marker
              rest
              Nothing
              (DocBlock body (spanStartLine (commentSpan c)) (spanStartLine (commentSpan c)) (spanStartCol (commentSpan c)) :: closeOpenBlock open acc)
          else
            docBlocksGo marker rest Nothing (closeOpenBlock open acc)
        Nothing => docBlocksGo marker rest Nothing (closeOpenBlock open acc)

-- | 内部：该注释是否延续当前行块（同列且行号连续）。
continuesOpen : OpenLineBlock -> Comment -> Bool
continuesOpen ob c =
  spanStartLine (commentSpan c) == openEndLine ob + 1 && spanStartCol (commentSpan c) == openCol ob

-- | 内部：用注释首行开一个新的行块。
newOpenBlock : String -> Comment -> OpenLineBlock
newOpenBlock body c =
  OpenLineBlock
    [body]
    (spanStartLine (commentSpan c))
    (spanStartLine (commentSpan c))
    (spanStartCol (commentSpan c))

-- | 内部：给行块追加一行并推进末行号。
appendOpenLine : OpenLineBlock -> String -> OpenLineBlock
appendOpenLine ob body =
  OpenLineBlock (append ob.openLines [body]) ob.openStartLine (ob.openEndLine + 1) ob.openCol

-- | 内部：把打开的行块收尾成 `DocBlock`（正文右侧去空白）；没有打开的块时原样返回。
closeOpenBlock : Maybe OpenLineBlock -> List DocBlock -> List DocBlock
closeOpenBlock Nothing acc = acc
closeOpenBlock (Just ob) acc =
  DocBlock (trimRight (join "\n" ob.openLines)) ob.openStartLine ob.openEndLine ob.openCol :: acc

-- | 内部：识别行注释的 `|` / `^` 标记，返回（标记, 正文）；普通注释返回 `Nothing`。
--
-- `text` 是 `--` 之后的原文，正文可能以 ` | body` 形式出现。
lineDocMarker : String -> Maybe (Pair String String)
lineDocMarker text =
  let
    t = trimLeft text
  in if startsWith "|" t then
    Just (Pair "|" (stripOneSpace (dropFirstChar t)))
  else if startsWith "^" t then Just (Pair "^" (stripOneSpace (dropFirstChar t))) else Nothing

-- | 内部：去掉一个前导空格；更深的缩进保留给代码块。
stripOneSpace : String -> String
stripOneSpace s =
  case strUnpack s of
    32 :: rest => strPack rest
    _ => s

-- | 内部：去掉第一个字符。
dropFirstChar : String -> String
dropFirstChar s =
  case strUnpack s of
    c :: rest => strPack rest
    [] => s

-- | 内部：识别块注释的 `|` / `^` 标记，返回（标记, dedent 后的正文）。
--
-- `text` 是 `{-` 与 `-}` 之间的原文。
blockDocMarker : String -> Maybe (Pair String String)
blockDocMarker text =
  let
    t = trimLeft text
  in if startsWith "|" t then
    Just (Pair "|" (dedent (dropFirstChar t)))
  else if startsWith "^" t then Just (Pair "^" (dedent (dropFirstChar t))) else Nothing

-- | 内部：去掉首尾空行，再按非空行的最小前导空格整体左移（块注释常整体缩进在 record/trait 内）。
dedent : String -> String
dedent text =
  let
    ls0 = dropTrailingEmpty (dropLeadingEmpty (lines text))
    indent = minIndent ls0
  in trimRight (join "\n" (map (dropLeadingSpaces indent) ls0))

-- | 内部：去掉开头的空行。
dropLeadingEmpty : List String -> List String
dropLeadingEmpty [] = []
dropLeadingEmpty (l :: rest) = if trim l == "" then dropLeadingEmpty rest else l :: rest

-- | 内部：去掉结尾的空行。
dropTrailingEmpty : List String -> List String
dropTrailingEmpty ls = reverse (dropLeadingEmpty (reverse ls))

-- | 内部：非空行的最小前导缩进；没有非空行时为 0。
minIndent : List String -> Int
minIndent ls = minIndentGo ls 1000000

-- | 内部：`minIndent` 的累加实现，初始哨兵是 1000000。
minIndentGo : List String -> Int -> Int
minIndentGo [] acc = if acc == 1000000 then 0 else acc
minIndentGo (l :: rest) acc =
  if trim l == "" then
    minIndentGo rest acc
  else
    let
      n = leadingSpaces l
    in if n < acc then minIndentGo rest n else minIndentGo rest acc

-- | 内部：前导空格与制表符的个数。
leadingSpaces : String -> Int
leadingSpaces s = leadingSpacesChars (strUnpack s) 0

-- | 内部：逐字符数前导空格与制表符。
leadingSpacesChars : List Int -> Int -> Int
leadingSpacesChars [] acc = acc
leadingSpacesChars (32 :: rest) acc = leadingSpacesChars rest (acc + 1)
leadingSpacesChars (9 :: rest) acc = leadingSpacesChars rest (acc + 1)
leadingSpacesChars _ acc = acc

-- | 内部：去掉至多 n 个前导空格或制表符。
dropLeadingSpaces : Int -> String -> String
dropLeadingSpaces n s = strPack (dropLeadingSpacesChars n (strUnpack s))

-- | 内部：`dropLeadingSpaces` 的字符层实现。
dropLeadingSpacesChars : Int -> List Int -> List Int
dropLeadingSpacesChars n [] = []
dropLeadingSpacesChars n chars =
  if n <= 0 then
    chars
  else
    case chars of
      c :: rest => if c == 32 || c == 9 then dropLeadingSpacesChars (n - 1) rest else chars
      [] => []

-- ---------------------------------------------------------------
-- 关联
-- ---------------------------------------------------------------
-- | 关联结果：已被占用的目标下标、顶层 doc 表、成员 doc 表与模块 doc。
record Assign where
  -- | 已被 doc block 占用的目标下标，保证一个目标只收一份 doc。
  assignUsed : List Int
  -- | 顶层名 -> docstring。
  assignDecls : List (Pair String String)
  -- | `父名<TAB>成员名` -> docstring。
  assignMembers : List (Pair String String)
  -- | 模块头 docstring；空串表示还没有。
  assignModuleDoc : String

-- | 内部：行块已收的正文行。
openLines : OpenLineBlock -> List String
openLines (OpenLineBlock ls start end col) = ls

-- | 内部：行块首行行号。
openStartLine : OpenLineBlock -> Int
openStartLine (OpenLineBlock ls start end col) = start

-- | 内部：行块末行行号。
openEndLine : OpenLineBlock -> Int
openEndLine (OpenLineBlock ls start end col) = end

-- | 内部：行块起始列。
openCol : OpenLineBlock -> Int
openCol (OpenLineBlock ls start end col) = col

-- | 内部：已被占用的目标下标。
assignUsed : Assign -> List Int
assignUsed (Assign used decls members mdoc) = used

-- | 内部：顶层 doc 表。
assignDecls : Assign -> List (Pair String String)
assignDecls (Assign used decls members mdoc) = decls

-- | 内部：成员 doc 表。
assignMembers : Assign -> List (Pair String String)
assignMembers (Assign used decls members mdoc) = members

-- | 内部：模块头 docstring。
assignModuleDoc : Assign -> String
assignModuleDoc (Assign used decls members mdoc) = mdoc

-- | 内部：逐块做前置关联，返回累积结果。
assignBlocks : List Comment -> List (Pair Int DocTarget) -> List DocBlock -> Assign
assignBlocks comments targets blocks = assignBlocksGo comments targets blocks (Assign [] [] [] "")

-- | 内部：前置关联主循环；模块头只认第一个 doc，成员键是 `父名<TAB>成员名`。
assignBlocksGo : List Comment -> List (Pair Int DocTarget) -> List DocBlock -> Assign -> Assign
assignBlocksGo comments targets [] acc = acc
assignBlocksGo comments targets (b :: rest) acc =
  case pickTarget comments targets acc.assignUsed b of
    Nothing => assignBlocksGo comments targets rest acc
    Just (Pair idx t) =>
      let
        acc2 =
          case targetKind t of
            "module" =>
              if acc.assignModuleDoc == "" then
                Assign acc.assignUsed acc.assignDecls acc.assignMembers b.docBlockText
              else
                acc
            "member" =>
              Assign
                acc.assignUsed
                acc.assignDecls
                (insertDoc "${targetParent t}\t${targetName t}" b.docBlockText acc.assignMembers)
                acc.assignModuleDoc
            _ =>
              Assign
                acc.assignUsed
                (insertDoc (targetName t) b.docBlockText acc.assignDecls)
                acc.assignMembers
                acc.assignModuleDoc
      in assignBlocksGo
        comments
        targets
        rest
        (Assign (idx :: acc2.assignUsed) acc2.assignDecls acc2.assignMembers acc2.assignModuleDoc)

-- | 内部：为该块选第一个合格的前置目标（行号更大、同列、行距不超过 2、中间无其他注释），已占用的目标跳过。
pickTarget : List Comment -> List (Pair Int DocTarget) -> List Int -> DocBlock -> Maybe (Pair Int DocTarget)
pickTarget comments [] used b = Nothing
pickTarget comments ((Pair idx t) :: rest) used b =
  if memInt idx used then
    pickTarget comments rest used b
  else if targetLine t > b.docBlockEndLine && targetCol t == b.docBlockCol && targetLine t - b.docBlockEndLine <= 2 && not (commentStartsBetween comments b.docBlockEndLine (targetLine t)) then
    Just (Pair idx t)
  else
    pickTarget comments rest used b

-- | 内部：在前置关联的结果上追加尾随 doc；只认非模块目标（模块头不参与），被前置占用的
-- 目标不复用。同一目标两种位置都有时前置优先（`insertDoc` 先到先得）。
assignTrailBlocks : List Comment -> List (Pair Int DocTarget) -> List DocBlock -> Assign -> Assign
assignTrailBlocks comments targets blocks acc = assignTrailBlocksGo comments targets blocks acc

-- | 内部：尾随关联主循环。
assignTrailBlocksGo : List Comment -> List (Pair Int DocTarget) -> List DocBlock -> Assign -> Assign
assignTrailBlocksGo comments targets [] acc = acc
assignTrailBlocksGo comments targets (b :: rest) acc =
  case pickTrailTarget comments targets acc.assignUsed b of
    Nothing => assignTrailBlocksGo comments targets rest acc
    Just (Pair idx t) =>
      let
        acc2 =
          case targetKind t of
            "member" =>
              Assign
                acc.assignUsed
                acc.assignDecls
                (insertDoc "${targetParent t}\t${targetName t}" b.docBlockText acc.assignMembers)
                acc.assignModuleDoc
            _ =>
              Assign
                acc.assignUsed
                (insertDoc (targetName t) b.docBlockText acc.assignDecls)
                acc.assignMembers
                acc.assignModuleDoc
      in assignTrailBlocksGo
        comments
        targets
        rest
        (Assign (idx :: acc2.assignUsed) acc2.assignDecls acc2.assignMembers acc2.assignModuleDoc)

-- | 内部：选最近的合格尾随目标（同一行、列在目标右侧）。
pickTrailTarget : List Comment -> List (Pair Int DocTarget) -> List Int -> DocBlock -> Maybe (Pair Int DocTarget)
pickTrailTarget comments targets used b = pickTrailTargetGo used b targets Nothing

-- | 内部：`pickTrailTarget` 的扫描实现，`best` 保存当前最近的目标。
pickTrailTargetGo : List Int -> DocBlock -> List (Pair Int DocTarget) -> Maybe (Pair Int DocTarget) -> Maybe (Pair Int DocTarget)
pickTrailTargetGo used b [] best = best
pickTrailTargetGo used b ((Pair idx t) :: rest) best =
  if memInt idx used || targetKind t == "module" then
    pickTrailTargetGo used b rest best
  else if not (trailAdjacent b t) then
    pickTrailTargetGo used b rest best
  else
    case best of
      Nothing => pickTrailTargetGo used b rest (Just (Pair idx t))
      Just (Pair _ bt) => if targetAfter t bt then pickTrailTargetGo used b rest (Just (Pair idx t)) else pickTrailTargetGo used b rest best

-- | 内部：`t` 是否比 `bt` 更靠近注释（行号更大；同行取列更大）。
targetAfter : DocTarget -> DocTarget -> Bool
targetAfter t bt =
  if targetLine t > targetLine bt then
    True
  else if targetLine t == targetLine bt then targetCol t > targetCol bt else False

-- | 内部：尾随关系只接受与目标同一行、且列在目标右侧的块。
--
-- 不支持「写在目标下一行」的尾随形式：fmt 把单独成行的注释统一挂到下一条目作为前置注释，
-- 会静默改变文档归属。
trailAdjacent : DocBlock -> DocTarget -> Bool
trailAdjacent b t = targetLine t == b.docBlockStartLine && targetCol t < b.docBlockCol

-- | 内部：整数列表的成员判断。
memInt : Int -> List Int -> Bool
memInt n [] = False
memInt n (x :: rest) = if x == n then True else memInt n rest

-- | 内部：两个行号之间（不含两端）是否有注释起始行；普通注释也阻断关联。
commentStartsBetween : List Comment -> Int -> Int -> Bool
commentStartsBetween [] start end = False
commentStartsBetween (c :: rest) start end =
  let
    line = spanStartLine (commentSpan c)
  in if line > start && line < end then True else commentStartsBetween rest start end

-- | 内部：写入一条 doc；同一键先到先得，已有非空 doc 时不覆盖，空 doc 可被非空替换。
insertDoc : String -> String -> List (Pair String String) -> List (Pair String String)
insertDoc key doc entries =
  case lookupDoc key entries of
    Nothing => Pair key doc :: entries
    Just old => if old == "" && doc /= "" then Pair key doc :: removeDoc key entries else entries

-- | 内部：按键查 doc。
lookupDoc : String -> List (Pair String String) -> Maybe String
lookupDoc key [] = Nothing
lookupDoc key ((Pair k v) :: rest) = if k == key then Just v else lookupDoc key rest

-- | 内部：按键删除条目，保留其余顺序。
removeDoc : String -> List (Pair String String) -> List (Pair String String)
removeDoc key [] = []
removeDoc key ((Pair k v) :: rest) = if k == key then rest else Pair k v :: removeDoc key rest

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
-- | 入口：从模块头、声明与注释构造 `DocTable`。
--
-- 前置关联先跑、尾随关联后跑，因此同一目标两种位置都有 doc 时前置优先；输出顺序与源码一致。
export docTableOf : Maybe ModDecl -> List Decl -> List Comment -> DocTable
docTableOf hdr decls comments =
  let
    blocks = docBlocksOf comments
    trailBlocks = trailBlocksOf comments
    targets = indexTargets (append (moduleTargets hdr) (targetsOfDecls decls)) 0 []
    assigned = assignBlocks comments targets blocks
    assigned2 = assignTrailBlocks comments targets trailBlocks assigned
  in DocTable
    assigned2.assignModuleDoc
    (reverse assigned2.assignDecls)
    (reverse assigned2.assignMembers)

-- | 内部：给目标表编号，供 `assignUsed` 标记已占用目标。
indexTargets : List DocTarget -> Int -> List (Pair Int DocTarget) -> List (Pair Int DocTarget)
indexTargets [] n acc = reverse acc
indexTargets (t :: rest) n acc = indexTargets rest (n + 1) (Pair n t :: acc)
