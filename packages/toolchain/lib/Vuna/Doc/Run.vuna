-- | `vuna doc` 的参数解析、包发现、`[export]` 过滤、HTML 写出与 `--check`。
--
-- 用法：`vuna doc [--check] [--package NAME] [DIR [OUT]]`。默认 OUT：DIR 为 `.` 时是
-- `docs/api.html`，其他 DIR 时是 `DIR/docs/api.html`。`--check` 不写文件，只报告缺失
-- docstring 的顶层条目（构造子 / 字段 / 方法不计；退出 1）。
module Vuna.Doc.Run where

import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Spec
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Doc.Html
import Vuna.Doc.Model
import Vuna.Files
import Base.Effect.Console as EffConsole
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes
import Base.Effect.Env as EffEnv
import Base.Effect.Process as EffProcess

-- | 入口：解析参数并执行；用法错误退出 2。
export runDoc : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
runDoc args =
  case parseCmdArgs ["doc"] args of
    ErrC e => docError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [] => docRun "." (docDefaultOut ".") (flagSet parsed "check") (flagValue parsed "package")
        [dir] =>
          docRun dir (docDefaultOut dir) (flagSet parsed "check") (flagValue parsed "package")
        [dir, out] =>
          if flagSet parsed "check" then
            docError "--check does not take an OUT argument"
          else
            docRun dir out False (flagValue parsed "package")
        _ => docError "usage: vuna doc [--check] [--package NAME] [DIR [OUT]]"

-- | 内部：默认输出路径（`DIR` 为 `.` 时落在 `docs/api.html`）。
docDefaultOut : String -> String
docDefaultOut dir = if dir == "." then "docs/api.html" else "${dir}/docs/api.html"

-- | 一个文档 scope：一个包（或单目录）及其要输出的模块列表。
record DocScope where
  -- | 源码根目录。
  scopeDir : String
  -- | 包名；单目录模式为空串。
  scopeName : String
  -- | `[export].modules` 的模块名列表；`Nothing` 表示不过滤。
  scopeExports : Maybe (List String)

-- | 内部：源码根目录。
scopeDir : DocScope -> String
scopeDir (DocScope dir name exports) = dir

-- | 内部：包名。
scopeName : DocScope -> String
scopeName (DocScope dir name exports) = name

-- | 内部：导出模块列表。
scopeExports : DocScope -> Maybe (List String)
scopeExports (DocScope dir name exports) = exports

-- | 内部：校验目录、发现 scope、收集源文件后进入构建。
docRun : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> String -> Bool -> Maybe String -> Eff r Int
docRun dir out check pkgFilter =
  do
    dirR <- requireDirectory dir
    case dirR of
      ErrC e => docError (diagText e)
      OkC _ =>
        do
          sc <- scopesFor dir pkgFilter
          case sc of
            ErrC e => docError (diagText e)
            OkC [] => docError "no such package: ${maybeText pkgFilter}"
            OkC scopes =>
              do
                filesR <- filesForScopes scopes
                case filesR of
                  ErrC e => docError (diagText e)
                  OkC files => docWithFiles out check scopes files

-- | 内部：没有源文件时报错；`--check` 走缺失检查，否则渲染并写出。
docWithFiles : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Bool -> List DocScope -> List (DocScope, List String) -> Eff r Int
docWithFiles out check scopes files =
  if length (filesOf files) == 0 then
    docError "no vuna sources found under the given directory; pass a package or source directory"
  else if check then
    do
      bookR <- buildBook scopes files
      case bookR of
        ErrC e => docError (diagText e)
        OkC book => runCheck book
  else
    do
      bookR <- buildBook scopes files
      case bookR of
        ErrC e => docError (diagText e)
        OkC book =>
          let
            content = renderPage book
          in do
            _ <- writeDocFile out content
            _ <- consolePrint "wrote ${out} (${length (bookModules book)} modules)\n"
            pure 0

-- | 内部：建父目录后写文件。
writeDocFile : Member nFs FsOp r, Member nProcess ProcessOp r => String -> String -> Eff r Int
writeDocFile out content =
  do
    _ <- ensureDirPath (parentOf out)
    _ <- fsWriteFile out content
    pure 0

-- | 内部：为每个 scope 收集源文件，结果与 scope 一一对应且顺序稳定。
filesForScopes : Member nFs FsOp r => List DocScope -> Eff r (Check (List (DocScope, List String)))
filesForScopes scopes = traverseScopes scopes []

-- | 内部：`filesForScopes` 的遍历实现。
traverseScopes : Member nFs FsOp r => List DocScope -> List (DocScope, List String) -> Eff r (Check (List (DocScope, List String)))
traverseScopes [] acc = pure (OkC (reverse acc))
traverseScopes (s :: rest) acc =
  do
    files <- scopeSourceFiles s
    traverseScopes rest ((s, files) :: acc)

-- | 内部：scope 的源文件：优先 `DIR/lib`，没有再退回 `DIR` 本身，都不存在时为空表。
scopeSourceFiles : Member nFs FsOp r => DocScope -> Eff r (List String)
scopeSourceFiles s =
  let
    root = "${scopeDir s}/lib"
  in do
    hasLib <- pathExistsDir root
    if hasLib then
      collectVunaFiles root
    else
      do
        hasDir <- pathExistsDir (scopeDir s)
        if hasDir then collectVunaFiles (scopeDir s) else pure []

-- | 内部：汇总所有 scope 的源文件，只用于空输入检查（构建仍按 scope 分组）。
filesOf : List (DocScope, List String) -> List String
filesOf pairs = concatMap secondOf pairs

-- | 内部：按 scope 构建模块并应用 `[export]` 过滤，最后组装成 `DocBook`。
buildBook : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List DocScope -> List (DocScope, List String) -> Eff r (Check DocBook)
buildBook scopes files = buildBookGo scopes files []

-- | 内部：逐 scope 构建；没有文件表的 scope 跳过，首个错误即返回。
buildBookGo : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List DocScope -> List (DocScope, List String) -> List DocModule -> Eff r (Check DocBook)
buildBookGo [] files acc = pure (OkC (DocBook (reverse acc)))
buildBookGo (scope :: restScopes) files acc =
  case lookupScopeFiles scope files of
    Nothing => buildBookGo restScopes files acc
    Just paths =>
      do
        modulesR <- buildModules (scopeName scope) paths
        case modulesR of
          ErrC e => pure (ErrC e)
          OkC modules0 =>
            case selectModules (scopeExports scope) modules0 of
              ErrC e => pure (ErrC e)
              OkC modules1 => buildBookGo restScopes files (append modules1 acc)

-- | 内部：按 scope 身份（名字 + 目录）查源文件表。
lookupScopeFiles : DocScope -> List (DocScope, List String) -> Maybe (List String)
lookupScopeFiles scope [] = Nothing
lookupScopeFiles scope ((s, paths) :: rest) =
  if scopeName s == scopeName scope && scopeDir s == scopeDir scope then
    Just paths
  else
    lookupScopeFiles scope rest

-- | 内部：按 `[export].modules` 与 manifest 顺序挑选模块；`Nothing` 表示全部输出。
--
-- 缺模块是配置错误（退出 2）。
selectModules : Maybe (List String) -> List DocModule -> Check (List DocModule)
selectModules Nothing modules0 = OkC modules0
selectModules (Just names) modules0 = selectModulesGo names modules0 []

-- | 内部：按名字逐个挑选；缺模块时返回错误。
selectModulesGo : List String -> List DocModule -> List DocModule -> Check (List DocModule)
selectModulesGo [] modules0 acc = OkC (reverse acc)
selectModulesGo (name :: rest) modules0 acc =
  case findDocModule name modules0 of
    Nothing => err "exported module not found in sources: ${name} (from [export].modules)"
    Just m => selectModulesGo rest modules0 (m :: acc)

-- | 内部：按模块全名查模块。
findDocModule : String -> List DocModule -> Maybe DocModule
findDocModule name [] = Nothing
findDocModule name (m :: rest) = if moduleName m == name then Just m else findDocModule name rest

-- ---------------------------------------------------------------
-- 包发现
-- ---------------------------------------------------------------
-- | 内部：有 `vuna.toml` 时按 workspace 包发现，否则把 DIR 当成单个匿名 scope；`--package` 只做过滤。
scopesFor : Member nFs FsOp r, Member nEnv EnvOp r => String -> Maybe String -> Eff r (Check (List DocScope))
scopesFor dir pkgFilter =
  do
    hasManifest <- fsFileExists "${dir}/vuna.toml"
    if hasManifest then
      do
        packagesR <- workspacePackages dir
        pure (
            case packagesR of
              ErrC e => ErrC e
              OkC packages => OkC (filterScopes pkgFilter (mapToScopes packages))
          )
    else
      pure (OkC (filterScopes pkgFilter [DocScope dir "" Nothing]))

-- | 内部：包列表 -> scope 列表。
mapToScopes : List Package -> List DocScope
mapToScopes [] = []
mapToScopes (p :: rest) =
  DocScope (packageDir p) (packageName p) (packageExports p) :: mapToScopes rest

-- | 内部：按 `--package` 过滤；`Nothing` 不过滤。
filterScopes : Maybe String -> List DocScope -> List DocScope
filterScopes Nothing scopes = scopes
filterScopes (Just name) scopes = filter (\s => scopeName s == name) scopes

-- ---------------------------------------------------------------
-- --check
-- ---------------------------------------------------------------
-- | 内部：`--check` 的判定：没有缺失时打印 ok 并返回 0，否则逐条打印缺失项并返回 1。
runCheck : Member nConsole ConsoleOp r => DocBook -> Eff r Int
runCheck book =
  if length (missingDocs book) == 0 then
    do
      _ <- consolePrint "docstrings ok (${length (bookModules book)} modules)\n"
      pure 0
  else
    do
      _ <- printMissing (missingDocs book)
      _ <- consolePrint "${length (missingDocs book)} missing docstring(s)\n"
      pure 1

-- | 内部：逐行打印缺失项。
printMissing : Member nConsole ConsoleOp r => List String -> Eff r Int
printMissing [] = pure 0
printMissing (line :: rest) =
  do
    _ <- consolePrint "${line}\n"
    printMissing rest

-- | 内部：全部缺失 docstring 的顶层条目，每项形如 `模块.条目 (路径:行)`。
missingDocs : DocBook -> List String
missingDocs book = concatMap missingInModule (bookModules book)

-- | 内部：一个模块内缺失 docstring 的条目。
missingInModule : DocModule -> List String
missingInModule m = concatMap (missingInItem m) (moduleItems m)

-- | 内部：条目本身缺 docstring 时的报告行；成员缺失不在这里检查。
missingInItem : DocModule -> DocItem -> List String
missingInItem m item =
  if itemDoc item == "" then
    ["missing docstring: ${moduleName m}.${itemName item} (${modulePath m}:${itemLine item})"]
  else
    []

-- ---------------------------------------------------------------
-- 写出
-- ---------------------------------------------------------------
-- | 内部：统一错误出口：打印后返回退出码 2。
docError : Member nConsole ConsoleOp r => String -> Eff r Int
docError e =
  do
    _ <- consolePrint "error: ${e}\n"
    pure 2

-- | 内部：`Maybe String` 的显示文本；`Nothing` 显示为 `(none)`。
maybeText : Maybe String -> String
maybeText Nothing = "(none)"
maybeText (Just s) = s
