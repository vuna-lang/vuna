-- | 效果程序的唯一执行入口：把「带 main 的完整入口源码」编译进 store 视图再运行。
--
-- 与 `vuna build` 同一条链路：`compileToDir` 产出 `.ml` + `build.sh`（内部已按源码 / 依赖
-- 摘要进对象库），链接后把产物发布成 `views/effectbin/<digest>`；digest 覆盖编译器指纹、
-- 工具链标识、包根内容、入口源码与 `printResult`。命中视图直接运行，不再重编译。
--
-- 合成包只存在于 store scratch 的输入目录（`<scratch>/pkg/{vuna.toml,app/Main.vuna}`）：
-- 内容按 digest 寻址、可重复写，不落 `$TMPDIR`，也不向对象库登记会被 GC 裁剪的临时项目根。
module Vuna.EffectRun where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Store
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Compiler.Loader.Fingerprint
import Vuna.Files
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes

-- | 产物视图种类：`$VUNA_STORE/views/effectbin/<digest>/bin/vuna-effect`。
export effectBinKind : String
effectBinKind = "effectbin"

-- | 合成包输入目录的 scratch 种类（只存 manifest 与入口源码，不发布）。
effectSrcKind : String
effectSrcKind = "effectbin-src"

-- | 合成包的固定包名（manifest 的 `[package] name`）。
effectPackageName : String
effectPackageName = "vuna-effect"

-- | 产物里的可执行文件名。
effectBinaryName : String
effectBinaryName = "vuna-effect"

-- | 编译并运行一段入口源码，返回进程退出码（非 0 是程序结果，不是工具失败）。
export runEffectSource : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Bool -> Eff r (Check Int)
runEffectSource ctx source printResult =
  do
    digest <- effectSourceDigest ctx source printResult
    pid <- projectIdOf ctx
    proj <- absolutePath (contextDir ctx)
    _ <- storeRootAppendEff pid proj [digest]
    view <- storeViewPathEff effectBinKind digest
    cached <- storeViewValidEff effectBinKind digest
    if cached then
      runEffectIn view
    else
      do
        claimed <- storeScratchClaimEff effectBinKind digest
        if claimed then
          do
            out <- storeScratchPathOfClaim effectBinKind digest
            srcRoot <- effectSrcDirOf digest
            res <- buildEffectSource ctx source printResult srcRoot out
            case res of
              ErrC e =>
                do
                  _ <- storeScratchDropEff effectBinKind digest
                  pure (ErrC e)
              OkC _ =>
                do
                  _ <- storeViewPublishEff effectBinKind digest
                  runEffectIn view
        else
          do
            -- 并发构建者占用同一 digest：不等待，退回私有目录构建（不发布）。
            base <- tempBase 0
            now <- clockNow
            dir <- freshTempDir 1000 "${base}/vuna-effectbin-${strFromInt now}"
            _ <- fsMakeDir dir
            res <- buildEffectSource ctx source printResult "${dir}/src" dir
            case res of
              ErrC e => cleanupDir dir (ErrC e)
              OkC _ =>
                do
                  code <- runEffectIn dir
                  cleanupDir dir code

-- | 内部：跑已发布的产物视图（cwd = 视图根，相对路径 `bin/vuna-effect`）。
runEffectIn : Member nProcess ProcessOp r => String -> Eff r (Check Int)
runEffectIn dir =
  do
    code <- processRunIn dir ["bin/${effectBinaryName}"]
    pure (OkC code)

-- | 内部：合成包输入目录（内容按入口源码 digest 寻址，重复写是幂等的）。
effectSrcDirOf : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> Eff r String
effectSrcDirOf digest = storeScratchPathEff effectSrcKind digest

-- | 内部：构建入口源码 → 可执行文件（写在 `out` 里，`bin/vuna-effect`）。
-- `srcRoot` 是合成包输入目录的根（其下写 `pkg/`）。
buildEffectSource : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Bool -> String -> String -> Eff r (Check String)
buildEffectSource ctx source printResult srcRoot out =
  do
    manifest <- effectManifest ctx
    _ <- fsMakeDir srcRoot
    _ <- fsMakeDir "${srcRoot}/pkg"
    _ <- fsMakeDir "${srcRoot}/pkg/app"
    _ <- fsWriteFile "${srcRoot}/pkg/vuna.toml" manifest
    _ <- fsWriteFile "${srcRoot}/pkg/app/Main.vuna" source
    ctxR <- contextForDir "${srcRoot}/pkg"
    case ctxR of
      ErrC e => pure (ErrC e)
      OkC pkgCtx =>
        do
          compiled <- compileToDir pkgCtx "${srcRoot}/pkg/app/Main.vuna" printResult out
          case compiled of
            ErrC e => pure (ErrC e)
            OkC _ =>
              do
                _ <- fsMakeDir "${out}/bin"
                has <- hasOcamlopt 0
                if has then
                  do
                    built <- runBuildScript out "bin/${effectBinaryName}" effectBinaryName
                    case built of
                      ErrC e => pure (ErrC e)
                      OkC _ => pure (OkC out)
                else
                  pure (err noOcamloptMessage)

-- | 内部：删除私有构建目录后返回结果。
cleanupDir : Member nProcess ProcessOp r => String -> Check Int -> Eff r (Check Int)
cleanupDir dir result =
  do
    _ <- processRunIn "/" ["rm", "-rf", dir]
    pure result

-- | 入口源码的缓存 key：编译器指纹 + 工具链标识 + 包根内容 + 源码 + 打印策略。
effectSourceDigest : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => PackageContext -> String -> Bool -> Eff r String
effectSourceDigest ctx source printResult =
  do
    fp <- toolCompilerFingerprint
    roots <- hashRoots (map (\r => rootDir r) (contextRoots ctx))
    tool <- toolchainIdEff
    let
      input = "effectbin 1|${strOfInt fp}|${strOfInt roots}|${strOfInt (absInt (textHashOf source))}|${if printResult then "1" else "0"}|${tool}"
    in pure (strOfInt (absInt (textHashOf input)))

-- | 内部：整数绝对值。
absInt : Int -> Int
absInt n = if n < 0 then 0 - n else n

-- | 内部：`Int` → 十进制文本。
strOfInt : Int -> String
strOfInt n = strFromInt n

-- | 包根内容摘要：对每个目录先收集源码文件再混哈希（调用方顺序稳定）。
export hashRoots : Member nFs FsOp r => List String -> Eff r Int
hashRoots dirs = hashRootsGo 0 dirs

hashRootsGo : Member nFs FsOp r => Int -> List String -> Eff r Int
hashRootsGo acc [] = pure acc
hashRootsGo acc (d :: rest) =
  do
    files <- collectSourceFiles d
    h <- hashFilesContent files
    hashRootsGo (acc * 1000003 + h) rest

hashFilesContent : Member nFs FsOp r => List String -> Eff r Int
hashFilesContent files = hashFilesGo 0 files

hashFilesGo : Member nFs FsOp r => Int -> List String -> Eff r Int
hashFilesGo acc [] = pure acc
hashFilesGo acc (f :: rest) =
  do
    text <- fsReadFile f
    hashFilesGo (acc * 1000003 + absInt (textHashOf text)) rest

-- ---------------------------------------------------------------
-- 合成包：从调用方上下文继承依赖（manifest 的 `[dependencies]`）
-- ---------------------------------------------------------------
-- | 内部：对列表逐项做效应计算并保持顺序。
mapEff : {r : Row} -> (a -> Eff r b) -> List a -> Eff r (List b)
mapEff f [] = pure []
mapEff f (x :: rest) =
  do
    y <- f x
    ys <- mapEff f rest
    pure (y :: ys)

-- | 内部：临时目录根：`$TMPDIR`（去尾部 `/`），没有就用 `/tmp`。
export tempBase : Member nEnv EnvOp r => Int -> Eff r String
tempBase _ =
  do
    env <- envGetEnv "TMPDIR"
    pure
      (if env == "" then "/tmp" else if endsWith "/" env then substring 0 (byteLength env - 1) env else env)

-- | 内部：从 `base-fuel` 往下找第一个不存在的目录名；`fuel` 用完就退回 `base`。
export freshTempDir : Member nFs FsOp r => Int -> String -> Eff r String
freshTempDir fuel base =
  if fuel <= 0 then
    pure base
  else
    do
      exists <- fsFileExists "${base}-${fuel}"
      if exists then freshTempDir (fuel - 1) base else pure "${base}-${fuel}"

-- | 内部：上下文依赖根 → 临时包的 `[dependencies]` 条目（包名 → 包目录）。
effectDeps : Member nEnv EnvOp r => PackageContext -> Eff r (List (String, String))
effectDeps ctx =
  case contextRoots ctx of
    [] => pure []
    roots =>
      if contextPackageName ctx == "" then
        mapEff effectDep roots
      else
        mapEff effectDep (drop 1 roots)

effectDep : Member nEnv EnvOp r => Root -> Eff r (String, String)
effectDep root =
  do
    dir <- absoluteDir (rootPackageDir (rootDir root))
    pure (rootName root, dir)

-- | 内部：模块根固定是 `<包目录>/lib`；去掉后缀得到包目录（manifest 的 `[dependencies]`
-- 吃包目录）。
rootPackageDir : String -> String
rootPackageDir dir = if endsWith "/lib" dir then substring 0 (byteLength dir - 4) dir else dir

-- | 内部：相对路径按 cwd 补成绝对路径（合成包不在调用方的工作目录下）。
absoluteDir : Member nEnv EnvOp r => String -> Eff r String
absoluteDir dir =
  do
    cwd <- envGetCwd
    pure (if startsWith "/" dir then dir else "${cwd}/${dir}")

-- | 内部：TOML 双引号字符串。
tomlQuote : String -> String
tomlQuote s = "\"${tomlEscaped (strUnpack s)}\""

tomlEscaped : List Int -> String
tomlEscaped [] = ""
tomlEscaped (c :: rest) = tomlChar c ++ tomlEscaped rest

-- | 内部：单字符的 TOML 转义（`"` 与 `\`），其余原样。
tomlChar : Int -> String
tomlChar 34 = "\\\""
tomlChar 92 = "\\\\"
tomlChar c = strPack [c]

-- | 内部：依赖行（裸 key + 双引号绝对路径）。
depLine : (String, String) -> String
depLine dep = "${firstOf dep} = ${tomlQuote (secondOf dep)}\n"

depsSection : List (String, String) -> String
depsSection [] = ""
depsSection deps = """

[dependencies]
${join "" (map depLine deps)}"""

-- | 内部：合成包的 manifest 文本：`[package]` 段 + 从调用方上下文继承的依赖。
effectManifest : Member nEnv EnvOp r => PackageContext -> Eff r String
effectManifest ctx =
  do
    deps <- effectDeps ctx
    pure ("""[package]
name = ${tomlQuote effectPackageName}
${depsSection deps}""")

-- | 内部：`ocamlopt` 是否在 PATH 里（链接阶段需要）。探针的 stdout / stderr 全部丢弃。
hasOcamlopt : Member nProcess ProcessOp r => Int -> Eff r Bool
hasOcamlopt _ =
  do
    code <- processRunIn "." ["sh", "-c", "command -v ocamlopt >/dev/null 2>&1"]
    pure (code == 0)

-- | 内部：缺 `ocamlopt` 时的可操作提示。
noOcamloptMessage : String
noOcamloptMessage =
  "`ocamlopt` not found in PATH; run the toolchain inside `nix develop` (or install OCaml) to compile effect programs"
