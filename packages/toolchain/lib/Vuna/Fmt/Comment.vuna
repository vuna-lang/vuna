-- | 注释保留：注释不在 AST 里，格式化器从 CST 的 token trivia 取注释，按源码位置挂到
-- 最近的「条目」上。
--
-- 可挂注释的条目：顶部声明 / import / `infix*` 声明 / 构造器 / 记录字段 / trait 方法 /
-- let 与 where 绑定 / case 分支 / do 语句。单独成行的注释成为下一条目的前置注释，
-- 写在同一行末尾的注释成为该条目的行尾注释；多行块注释只作前置注释。
-- 前置注释之间的源码空行保留（至多一级）；表达式内部的注释前移到最内层包含它的条目
-- （没有则前移到下一条目；文件末尾的注释保留在文件末尾）。
--
-- 注释列表在 `formatSourceWith` 里按 `anchorRefs` 单趟归属（行尾优先、否则下一条目）：
-- 锚点直接来自 parser 的事件流（条目类树节点，不遍历 AST、不建整棵树），按起点排序；
-- 注释按源码顺序前进，维护已打开锚点的栈（最内层容器）与本行已结束锚点的候选池。
-- 渲染时用条目的 `NodeRef` 直接查 `FmtCtx`（键是节点 id，不是 span 起点）。
module Vuna.Fmt.Comment where

import Base.Container.HashMap as HashMap
import Base.Data.Sort as Sort
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Lexer
import Vuna.Fmt.Doc
import Vuna.Fmt.Util

-- ---------------------------------------------------------------
-- 注释：渲染与「条目」定位
--
-- 注释行插入规则（保证幂等）：
-- - 前置注释在条目缩进处单独成行，条目原有内容不变；
-- - 行尾注释（仅单行注释）追加在该条目最后一行末尾；
-- - 多行块注释一律以「前置」形式插入（不挂在行尾）。
-- ---------------------------------------------------------------
-- | 内部：是否行注释（`--` 而非 `{- -}`）。
isLineComment : Comment -> Bool
isLineComment c =
  case c.commentKind of
    CLine => True
    CBlock => False

-- | 内部：注释文本是否含换行。
containsNewline : String -> Bool
containsNewline s = hasNewlineChar (strUnpack s)

-- | 内部：字符码表里是否有换行（10）。
hasNewlineChar : List Int -> Bool
hasNewlineChar [] = False
hasNewlineChar (c :: rest) = c == 10 || hasNewlineChar rest

-- | 内部：注释文本不含换行（行尾注释只接受这种）。
isSingleLineComment : Comment -> Bool
isSingleLineComment c = not (containsNewline c.commentText)

-- | 内部：行尾注释的原文（行注释 `--...`，块注释 `{-...-}`）。
inlineCommentText : Comment -> String
inlineCommentText c =
  case c.commentKind of
    CLine => "--${c.commentText}"
    CBlock => "{-${c.commentText}-}"

-- | 内部：去掉行尾空格与制表符。
trimRightSpaces : String -> String
trimRightSpaces s = strPack (reverse (dropReverseSpaces (reverse (strUnpack s))))

-- | 内部：从（逆序的）字符表头部丢弃空格 / 制表符。
dropReverseSpaces : List Int -> List Int
dropReverseSpaces [] = []
dropReverseSpaces (c :: rest) = if c == 32 || c == 9 then dropReverseSpaces rest else c :: rest

-- | 内部：按 `\n` 切分，保留末尾空段（块注释原文用）。
splitOnNewline : String -> List String
splitOnNewline s = splitNewlineChars (strUnpack s) [] []

-- | 内部：`splitOnNewline` 的字符级累加器。
splitNewlineChars : List Int -> List String -> List Int -> List String
splitNewlineChars [] acc seg = reverse (strPack (reverse seg) :: acc)
splitNewlineChars (c :: rest) acc seg =
  if c == 10 then
    splitNewlineChars rest (strPack (reverse seg) :: acc) []
  else
    splitNewlineChars rest acc (c :: seg)

-- | 内部：去掉至多 `n` 个前导空格（块注释续行的公共缩进）。
dropSpacesUpTo : Int -> String -> String
dropSpacesUpTo n line =
  if n <= 0 then
    line
  else
    case strUnpack line of
      c :: rest => if c == 32 then dropSpacesUpTo (n - 1) (strPack rest) else line
      [] => line

-- | 内部：块注释续行：去掉原起始列缩进与行尾空白（缩进交给 `Doc.nest`）。
commentContinuation : Int -> String -> String
commentContinuation stripN line = trimRightSpaces (dropSpacesUpTo stripN line)

-- | 内部：块注释末行：去掉起始列缩进后补 `-}`。
commentTailLines : Int -> List String -> List String
commentTailLines stripN [] = ["-}"]
commentTailLines stripN ([line]) = ["${commentContinuation stripN line}-}"]
commentTailLines stripN (line :: rest) =
  commentContinuation stripN line :: commentTailLines stripN rest

-- | 内部：多行块注释的正文行（无缩进；首行 `{-...`，末行补 `-}`）。
blockCommentLines : Comment -> List String
blockCommentLines c =
  let
    textLines = splitOnNewline c.commentText
    stripN = spanStartCol (commentSpan c) - 1
  in case textLines of
    [] => ["{- -}"]
    first :: rest => "{-${trimRightSpaces first}" :: commentTailLines stripN rest

-- | 内部：空行标记（`commentText` 为 NUL；源码里不可能出现）。
isBlankMarker : Comment -> Bool
isBlankMarker c = c.commentText == strPack [0]

-- | 注释作为前置文档：行注释 `--...`；单行块注释 `{-...-}`；多行块注释逐行输出，
-- 缩进由调用方的 `nest` 承担；空行标记输出空行。
export commentLeadDoc : Comment -> Doc
commentLeadDoc c = if isBlankMarker c then empty else vsep (map text (commentLeadLines c))

-- | 内部：注释的前置文本行（无缩进）。
commentLeadLines : Comment -> List String
commentLeadLines c =
  if isBlankMarker c then
    [""]
  else
    case c.commentKind of
      CLine => ["--${c.commentText}"]
      CBlock => if containsNewline c.commentText then blockCommentLines c else ["{-${c.commentText}-}"]

-- 位置比较与附件表 ------------------------------------------------
-- | 内部：(行, 列) 严格先后比较。
posBefore : Int -> Int -> Int -> Int -> Bool
posBefore l1 c1 l2 c2 = l1 < l2 || l1 == l2 && c1 < c2

-- | 内部：按条目节点 id 查附件槽。
lookupSlot : HashMap Int (List Comment, List Comment) -> Int -> Maybe (List Comment, List Comment)
lookupSlot at nid = HashMap.lookup nid at

-- | 内部：条目的前置注释列表（无槽时为空）。
leadOf : HashMap Int (List Comment, List Comment) -> Int -> List Comment
leadOf at nid =
  case lookupSlot at nid of
    Nothing => []
    Just slot => firstOf slot

-- | 内部：条目的行尾注释列表（无槽时为空）。
trailOf : HashMap Int (List Comment, List Comment) -> Int -> List Comment
trailOf at nid =
  case lookupSlot at nid of
    Nothing => []
    Just slot => secondOf slot

-- | 内部：把注释追加到该条目的前置或行尾列表；无槽时新建。
addToSlot : Int -> Bool -> Comment -> HashMap Int (List Comment, List Comment) -> HashMap Int (List Comment, List Comment)
addToSlot nid isTrail comment at =
  case HashMap.lookup nid at of
    Nothing =>
      if isTrail then
        HashMap.insert nid ([], [comment]) at
      else
        HashMap.insert nid ([comment], []) at
    Just slot =>
      let
        newSlot =
          if isTrail then
            (firstOf slot, append (secondOf slot) [comment])
          else
            (append (firstOf slot) [comment], secondOf slot)
      in HashMap.insert nid newSlot at

-- | 内部：锚点按起点偏移升序（稳定排序：同起点的锚点保持收集顺序）。
sortAnchors : List NodeRef -> List NodeRef
sortAnchors anchors = Sort.sortBy anchorBefore anchors

anchorBefore : NodeRef -> NodeRef -> Bool
anchorBefore a b = spanStartOffset (nodeRefSpan a) <= spanStartOffset (nodeRefSpan b)

-- | 内部：行尾注释候选池：同一行里已结束的锚点；换行即清空。
record TrailPool where
  tpLine : Int
  tpAnchors : List NodeRef

emptyTrailPool : TrailPool
emptyTrailPool = TrailPool 0 []

-- | 内部：把本行新结束的锚点并进候选池（换行清空）。
poolAtLine : TrailPool -> Int -> List NodeRef -> TrailPool
poolAtLine pool line ended =
  let
    kept = if pool.tpLine == line then pool.tpAnchors else []
  in TrailPool line (append ended kept)

-- | 内部：行尾候选择优：结束列更大者优先，同列取起点更晚者（更深层条目）。
betterTrail : NodeRef -> NodeRef -> Bool
betterTrail r b =
  let
    sp = nodeRefSpan r
    bsp = nodeRefSpan b
    ec = sp.spanEndCol
    bc = bsp.spanEndCol
  in if ec > bc then
    True
  else if ec < bc then
    False
  else
    posBefore (spanStartLine bsp) (spanStartCol bsp) (spanStartLine sp) (spanStartCol sp)

-- | 内部：本行里结束于注释起点之前的最近锚点。
bestTrailIn : List NodeRef -> Int -> Maybe NodeRef
bestTrailIn cands col = trailPick Nothing cands col

trailPick : Maybe NodeRef -> List NodeRef -> Int -> Maybe NodeRef
trailPick best [] col = best
trailPick best (r :: rest) col =
  if spanEndCol (nodeRefSpan r) < col then
    case best of
      Nothing => trailPick (Just r) rest col
      Just b => if betterTrail r b then trailPick (Just r) rest col else trailPick best rest col
  else
    trailPick best rest col

-- | 内部：打开起点不晚于 `off` 的锚点；返回 (剩余锚点, 打开的栈)。
openUpTo : List NodeRef -> List NodeRef -> Int -> (List NodeRef, List NodeRef)
openUpTo [] open _ = ([], open)
openUpTo (r :: rest) open off =
  if spanStartOffset (nodeRefSpan r) <= off then
    openUpTo rest (r :: open) off
  else
    (r :: rest, open)

-- | 内部：弹掉已结束的锚点；返回 (剩余栈, 本行结束的锚点)。
closeBefore : List NodeRef -> Int -> Int -> (List NodeRef, List NodeRef)
closeBefore [] line off = ([], [])
closeBefore (r :: rest) line off =
  if spanEndOffset (nodeRefSpan r) < off then
    let
      p = closeBefore rest line off
      ended = if spanEndLine (nodeRefSpan r) == line then [r] else []
    in (firstOf p, append ended (secondOf p))
  else
    (r :: rest, [])

-- | 内部：前置注释的归属：下一条目；下一条目跳出最内层包含条目时改用包含条目
-- （函数体末尾的注释回到该函数上方，而不是下一位函数上方）。
leadTarget : List NodeRef -> List NodeRef -> Span -> Maybe NodeRef
leadTarget future open csp =
  let
    next =
      case future of
        [] => Nothing
        r :: _ => Just r
    enclosing =
      case open of
        [] => Nothing
        r :: _ => Just r
  in case next of
    Nothing => enclosing
    Just nr =>
      case enclosing of
        Nothing => Just nr
        Just er =>
          if spanStartOffset (nodeRefSpan nr) <= spanEndOffset (nodeRefSpan er) then
            Just nr
          else
            Just er

-- | 注释归属（单趟）：锚点按起点排序、注释按源码顺序前进；`open` 是已打开锚点的栈
-- （头为最内层），`pool` 收集本行已结束的锚点（行尾候选）。每条注释只付栈操作与
-- 「同行已结束的锚点」的线性扫，不再对全部锚点做前后扫描。
assignComments : List NodeRef -> List Comment -> HashMap Int (List Comment, List Comment) -> List Comment -> (HashMap Int (List Comment, List Comment), List Comment)
assignComments anchors comments at eof =
  assignGo (sortAnchors anchors) [] emptyTrailPool comments at eof

assignGo : List NodeRef -> List NodeRef -> TrailPool -> List Comment -> HashMap Int (List Comment, List Comment) -> List Comment -> (HashMap Int (List Comment, List Comment), List Comment)
assignGo future open pool [] at eof = (at, eof)
assignGo future open pool (c :: rest) at eof =
  let
    csp = commentSpan c
    line = spanStartLine csp
    col = spanStartCol csp
    opened = openUpTo future open (spanStartOffset csp)
    future2 = firstOf opened
    closed = closeBefore (secondOf opened) line (spanStartOffset csp)
    open2 = firstOf closed
    pool2 = poolAtLine pool line (secondOf closed)
    trail =
      if isBlankMarker c then
        Nothing
      else if isSingleLineComment c then bestTrailIn pool2.tpAnchors col else Nothing
  in case trail of
    Just r => assignGo future2 open2 pool2 rest (addToSlot (nodeRefId r) True c at) eof
    Nothing =>
      case leadTarget future2 open2 csp of
        Just r => assignGo future2 open2 pool2 rest (addToSlot (nodeRefId r) False c at) eof
        Nothing => assignGo future2 open2 pool2 rest at (append eof [c])

-- ---------------------------------------------------------------
-- 锚点：从建树事件取条目节点
-- ---------------------------------------------------------------
-- | 可挂注释的树节点种类：模块头 / 导出项 / import / `infix*` / 声明 / 构造器 / 字段 /
-- trait 方法 / do 语句 / 绑定 / 分支。表达式与模式不是挂载点（注释前移到最近的条目）。
isAnchorKind : CstKind -> Bool
isAnchorKind CstModHeadKind = True
isAnchorKind CstExportItemKind = True
isAnchorKind CstImportKind = True
isAnchorKind CstFixityKind = True
isAnchorKind CstDeclKind = True
isAnchorKind CstCtorKind = True
isAnchorKind CstFieldKind = True
isAnchorKind CstMethodKind = True
isAnchorKind CstDoStmtKind = True
isAnchorKind CstBindingKind = True
isAnchorKind CstAltKind = True
isAnchorKind _ = False

-- | 整份文件的注释锚点（节点身份）：树上按种类取出条目节点。锚点集合就是渲染器的
-- 挂载点；渲染时用同一个 id 查槽。
export anchorRefs : CstNode -> List NodeRef
anchorRefs tree = map toNodeRef (Cst.anchorRefsOfTree isAnchorKind tree)

-- | 内部：`(id, span)` → `NodeRef`。
toNodeRef : (Int, Span) -> NodeRef
toNodeRef (nid, sp) = NodeRef nid sp

-- | 内部：条目的前置注释文档（无注释时为空）。
leadingDoc : HashMap Int (List Comment, List Comment) -> NodeRef -> Doc
leadingDoc at r =
  let
    cs = leadOf at (nodeRefId r)
  in if isNilList cs then empty else vsep (map commentLeadDoc cs) `appendDoc` hard

-- | 内部：把行尾注释逐个追加到条目最后一行末尾。
trailingDoc : HashMap Int (List Comment, List Comment) -> NodeRef -> Doc -> Doc
trailingDoc at r doc =
  case trailOf at (nodeRefId r) of
    [] => doc
    cs => foldl (\acc, c => acc `appendDoc` (text " ${inlineCommentText c}")) doc cs

-- | 把条目的注释贴到渲染结果上：前置注释在上，行尾注释追加到最后一行。
attachAtTable : HashMap Int (List Comment, List Comment) -> NodeRef -> Doc -> Doc
attachAtTable at r doc = trailingDoc at r (leadingDoc at r `appendDoc` doc)

-- | 内部：导出项是否挂了注释（前置或行尾）。
itemHasComments : HashMap Int (List Comment, List Comment) -> ExportItem -> Bool
itemHasComments at item =
  case lookupSlot at (nodeRefId (exportItemRef item)) of
    Nothing => False
    Just slot => not (isNilList (firstOf slot)) || not (isNilList (secondOf slot))

-- | 任一导出项挂了注释：有则导出列表强制多行，避免单行把后续项注释掉。
anyItemHasCommentsTable : HashMap Int (List Comment, List Comment) -> List ExportItem -> Bool
anyItemHasCommentsTable at [] = False
anyItemHasCommentsTable at (item :: rest) =
  itemHasComments at item || anyItemHasCommentsTable at rest

-- | 去掉列表开头的空行标记（空行只保留在两条注释之间）。
stripLeadingBlanks : List Comment -> List Comment
stripLeadingBlanks [] = []
stripLeadingBlanks (c :: rest) = if isBlankMarker c then stripLeadingBlanks rest else c :: rest

-- ---------------------------------------------------------------
-- CST trivia → 注释计划
-- ---------------------------------------------------------------
-- | 注释计划：附件表（节点 id → 前置 / 行尾注释）+ 文件末尾注释。
export record FmtCtx where
  -- | 条目节点 id → (前置注释, 行尾注释)。
  ctxAt : HashMap Int (List Comment, List Comment)
  -- | 树索引：括号层数等「怎么写」的信息在树节点字段上（AST 不携带，按节点 id / span 查）。
  ctxCst : CstIndex

-- | 内部：空附件表。
emptySlotTable : HashMap Int (List Comment, List Comment)
emptySlotTable = HashMap.fromList []

-- | 空计划（模板洞等没有源码位置的位置）。
export emptyFmtCtx : FmtCtx
emptyFmtCtx = FmtCtx emptySlotTable emptyCstIndex

-- | 去掉注释原文的定界符（`--` / `{- -}`），得到旧注释模型的正文。
stripLineDelim : String -> String
stripLineDelim s = trimRightSpaces (strPack (dropN 2 (strUnpack s)))

stripBlockDelim : String -> String
stripBlockDelim s =
  let
    cs = strUnpack s
    inner = dropN 2 cs
    withoutTail = dropLastN 2 inner
  in strPack withoutTail

dropN : Int -> List Int -> List Int
dropN n xs =
  if n <= 0 then
    xs
  else
    case xs of
      [] => []
      _ :: rest => dropN (n - 1) rest

dropLastN : Int -> List Int -> List Int
dropLastN n xs = reverse (dropN n (reverse xs))

-- | 一条 trivia 注释 → 旧注释模型；不是注释给 `Nothing`。
triviaComment : Trivia -> Maybe Comment
triviaComment tr =
  case tr.triviaKind of
    TrivLineComment => Just (Comment CLine (stripLineDelim tr.triviaText) tr.triviaSpan)
    TrivBlockComment => Just (Comment CBlock (stripBlockDelim tr.triviaText) tr.triviaSpan)
    TrivSpace => Nothing

-- | trivia → 注释列表（含空行标记）；`nl` 是距上一 token / 注释的换行数。
triviaComments : List Trivia -> List Comment
triviaComments trivs = reverse (triviaCommentsGo trivs 0 [])

triviaCommentsGo : List Trivia -> Int -> List Comment -> List Comment
triviaCommentsGo [] nl acc = acc
triviaCommentsGo (tr :: rest) nl acc =
  case tr.triviaKind of
    TrivSpace => triviaCommentsGo rest (nl + countNewlines tr.triviaText) acc
    _ =>
      case triviaComment tr of
        Nothing => triviaCommentsGo rest nl acc
        Just c =>
          if nl >= 2 then
            triviaCommentsGo rest 0 (c :: blankComment tr :: acc)
          else
            triviaCommentsGo rest 0 (c :: acc)

-- | 空行标记（NUL 文本；源码里不出现）。
blankComment : Trivia -> Comment
blankComment tr = Comment CLine (strPack [0]) tr.triviaSpan

-- | 换行数。
countNewlines : String -> Int
countNewlines s = countNewlinesChars (strUnpack s)

countNewlinesChars : List Int -> Int
countNewlinesChars [] = 0
countNewlinesChars (c :: rest) = (if c == 10 then 1 else 0) + countNewlinesChars rest

-- | 从 CST trivia 建注释计划：先按锚点分配（行尾优先、否则下一条目），再返回附件表与
-- 文件末尾注释。
export fmtCtxOf : CstIndex -> List NodeRef -> List CstToken -> (FmtCtx, List Comment)
fmtCtxOf cst anchors toks =
  let
    assigned = assignComments anchors (concatMap tokComments toks) emptySlotTable []
  in (FmtCtx (firstOf assigned) cst, stripLeadingBlanks (secondOf assigned))

-- | 把条目的注释贴到渲染结果上（按节点 id 查槽）。
export attachAt : FmtCtx -> NodeRef -> Doc -> Doc
attachAt ctx r doc = attachAtTable ctx.ctxAt r doc

-- | 任一导出项挂了注释。
export anyItemHasComments : FmtCtx -> List ExportItem -> Bool
anyItemHasComments ctx items = anyItemHasCommentsTable ctx.ctxAt items

-- | 文件末尾注释的文档（顶格）。
export eofCommentsDoc : List Comment -> Doc
eofCommentsDoc comments = vsep (map commentLeadDoc (stripLeadingBlanks comments))

-- | 单个 token 的前置 trivia 里的注释（每个 token 单独计数空行，避免跨 token 累加）。
export tokComments : CstToken -> List Comment
tokComments t = triviaComments t.cstLeading

-- | 顶层条目的前置注释（丢掉最前面的空行标记，顶层空行由 section / 声明间距负责）。
export attachAtTop : FmtCtx -> NodeRef -> Doc -> Doc
attachAtTop ctx r doc =
  let
    cs = stripLeadingBlanks (leadOf ctx.ctxAt (nodeRefId r))
    lead = if isNilList cs then empty else vsep (map commentLeadDoc cs) `appendDoc` hard
  in trailingDoc ctx.ctxAt r (lead `appendDoc` doc)
