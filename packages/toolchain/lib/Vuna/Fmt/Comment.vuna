-- | 注释保留：注释不在 AST 里，格式化器从 CST 的 token trivia 取注释，按源码位置挂到
-- 最近的「条目」上。
--
-- 可挂注释的条目：顶部声明 / import / `infix*` 声明 / 构造器 / 记录字段 / trait 方法 /
-- let 与 where 绑定 / case 分支 / do 语句。单独成行的注释成为下一条目的前置注释，
-- 写在同一行末尾的注释成为该条目的行尾注释；多行块注释只作前置注释。
-- 前置注释之间的源码空行保留（至多一级）；表达式内部的注释前移到最内层包含它的条目
-- （没有则前移到下一条目；文件末尾的注释保留在文件末尾）。
--
-- 注释列表在 `formatSourceWith` 里按 `anchorSpans` 做一次归属分配（行尾优先、否则下一条目），
-- 渲染时按条目 span 直接查 `TriviaCtx`。
module Vuna.Fmt.Comment where

import Base.Container.HashMap as HashMap
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Frontend.Lexer
import Vuna.Fmt.Doc
import Vuna.Fmt.Util

-- ---------------------------------------------------------------
-- 注释：渲染与「条目」定位
--
-- 注释行插入规则（保证幂等）：
-- - 前置注释在条目缩进处单独成行，条目原有内容不变；
-- - 行尾注释（仅单行注释）追加在该条目最后一行末尾；
-- - 多行块注释一律以「前置」形式插入（不挂在行尾）。
-- ---------------------------------------------------------------
-- | 内部：是否行注释（`--` 而非 `{- -}`）。
isLineComment : Comment -> Bool
isLineComment c =
  case c.commentKind of
    CLine => True
    CBlock => False

-- | 内部：注释文本是否含换行。
containsNewline : String -> Bool
containsNewline s = hasNewlineChar (strUnpack s)

-- | 内部：字符码表里是否有换行（10）。
hasNewlineChar : List Int -> Bool
hasNewlineChar [] = False
hasNewlineChar (c :: rest) = c == 10 || hasNewlineChar rest

-- | 内部：注释文本不含换行（行尾注释只接受这种）。
isSingleLineComment : Comment -> Bool
isSingleLineComment c = not (containsNewline c.commentText)

-- | 内部：行尾注释的原文（行注释 `--...`，块注释 `{-...-}`）。
inlineCommentText : Comment -> String
inlineCommentText c =
  case c.commentKind of
    CLine => "--${c.commentText}"
    CBlock => "{-${c.commentText}-}"

-- | 内部：去掉行尾空格与制表符。
trimRightSpaces : String -> String
trimRightSpaces s = strPack (reverse (dropReverseSpaces (reverse (strUnpack s))))

-- | 内部：从（逆序的）字符表头部丢弃空格 / 制表符。
dropReverseSpaces : List Int -> List Int
dropReverseSpaces [] = []
dropReverseSpaces (c :: rest) = if c == 32 || c == 9 then dropReverseSpaces rest else c :: rest

-- | 内部：按 `\n` 切分，保留末尾空段（块注释原文用）。
splitOnNewline : String -> List String
splitOnNewline s = splitNewlineChars (strUnpack s) [] []

-- | 内部：`splitOnNewline` 的字符级累加器。
splitNewlineChars : List Int -> List String -> List Int -> List String
splitNewlineChars [] acc seg = reverse (strPack (reverse seg) :: acc)
splitNewlineChars (c :: rest) acc seg =
  if c == 10 then
    splitNewlineChars rest (strPack (reverse seg) :: acc) []
  else
    splitNewlineChars rest acc (c :: seg)

-- | 内部：去掉至多 `n` 个前导空格（块注释续行的公共缩进）。
dropSpacesUpTo : Int -> String -> String
dropSpacesUpTo n line =
  if n <= 0 then
    line
  else
    case strUnpack line of
      c :: rest => if c == 32 then dropSpacesUpTo (n - 1) (strPack rest) else line
      [] => line

-- | 内部：块注释续行：去掉原起始列缩进与行尾空白（缩进交给 `Doc.nest`）。
commentContinuation : Int -> String -> String
commentContinuation stripN line = trimRightSpaces (dropSpacesUpTo stripN line)

-- | 内部：块注释末行：去掉起始列缩进后补 `-}`。
commentTailLines : Int -> List String -> List String
commentTailLines stripN [] = ["-}"]
commentTailLines stripN ([line]) = ["${commentContinuation stripN line}-}"]
commentTailLines stripN (line :: rest) =
  commentContinuation stripN line :: commentTailLines stripN rest

-- | 内部：多行块注释的正文行（无缩进；首行 `{-...`，末行补 `-}`）。
blockCommentLines : Comment -> List String
blockCommentLines c =
  let
    textLines = splitOnNewline c.commentText
    stripN = spanStartCol (commentSpan c) - 1
  in case textLines of
    [] => ["{- -}"]
    first :: rest => "{-${trimRightSpaces first}" :: commentTailLines stripN rest

-- | 内部：空行标记（`commentText` 为 NUL；源码里不可能出现）。
isBlankMarker : Comment -> Bool
isBlankMarker c = c.commentText == strPack [0]

-- | 注释作为前置文档：行注释 `--...`；单行块注释 `{-...-}`；多行块注释逐行输出，
-- 缩进由调用方的 `nest` 承担；空行标记输出空行。
export commentLeadDoc : Comment -> Doc
commentLeadDoc c = if isBlankMarker c then empty else vsep (map text (commentLeadLines c))

-- | 内部：注释的前置文本行（无缩进）。
commentLeadLines : Comment -> List String
commentLeadLines c =
  if isBlankMarker c then
    [""]
  else
    case c.commentKind of
      CLine => ["--${c.commentText}"]
      CBlock => if containsNewline c.commentText then blockCommentLines c else ["{-${c.commentText}-}"]

-- 位置比较与附件表 ------------------------------------------------
-- | 内部：(行, 列) 严格先后比较。
posBefore : Int -> Int -> Int -> Int -> Bool
posBefore l1 c1 l2 c2 = l1 < l2 || l1 == l2 && c1 < c2

-- | 内部：(行, 列) 不晚于比较。
posBeforeOrEq : Int -> Int -> Int -> Int -> Bool
posBeforeOrEq l1 c1 l2 c2 = l1 < l2 || l1 == l2 && c1 <= c2

-- | 内部：位置是否落在该 span 内（含两个端点）。
containsPos : Span -> Int -> Int -> Bool
containsPos sp line col =
  posBeforeOrEq (spanStartLine sp) (spanStartCol sp) line col
    && posBeforeOrEq line col (spanEndLine sp) sp.spanEndCol

-- | 内部：包含该位置的条目中起点最晚者（即最内层条目）。
innermostEnclosing : List Span -> Span -> Maybe Span
innermostEnclosing anchors csp = enclosingFold Nothing anchors csp

-- | 内部：`innermostEnclosing` 的折叠。
enclosingFold : Maybe Span -> List Span -> Span -> Maybe Span
enclosingFold best [] csp = best
enclosingFold best (sp :: rest) csp =
  if containsPos sp (spanStartLine csp) (spanStartCol csp) then
    case best of
      Nothing => enclosingFold (Just sp) rest csp
      Just b => if betterNext sp b then enclosingFold (Just sp) rest csp else enclosingFold best rest csp
  else
    enclosingFold best rest csp

-- | 内部：按条目起点偏移查附件槽。
lookupSlot : HashMap Int (Pair (List Comment) (List Comment)) -> Int -> Maybe (Pair (List Comment) (List Comment))
lookupSlot at off = HashMap.lookup off at

-- | 内部：条目的前置注释列表（无槽时为空）。
leadOf : HashMap Int (Pair (List Comment) (List Comment)) -> Int -> List Comment
leadOf at off =
  case lookupSlot at off of
    Nothing => []
    Just slot => firstOf slot

-- | 内部：条目的行尾注释列表（无槽时为空）。
trailOf : HashMap Int (Pair (List Comment) (List Comment)) -> Int -> List Comment
trailOf at off =
  case lookupSlot at off of
    Nothing => []
    Just slot => secondOf slot

-- | 内部：把注释追加到该条目的前置或行尾列表；无槽时新建。
addToSlot : Int -> Bool -> Comment -> HashMap Int (Pair (List Comment) (List Comment)) -> HashMap Int (Pair (List Comment) (List Comment))
addToSlot off isTrail comment at =
  case HashMap.lookup off at of
    Nothing =>
      if isTrail then
        HashMap.insert off (Pair [] [comment]) at
      else
        HashMap.insert off (Pair [comment] []) at
    Just slot =>
      let
        newSlot =
          if isTrail then
            Pair (firstOf slot) (append (secondOf slot) [comment])
          else
            Pair (append (firstOf slot) [comment]) (secondOf slot)
      in HashMap.insert off newSlot at

-- | 内部：能否作为行尾锚点：与注释同行且结束于注释起点之前。
trailCandidate : Span -> Span -> Bool
trailCandidate sp csp = spanEndLine sp == spanStartLine csp && sp.spanEndCol < spanStartCol csp

-- | 内部：行尾候选择优：结束列更大者优先，同列取起点更晚者（更深层条目）。
betterTrail : Span -> Span -> Bool
betterTrail sp b =
  let
    ec = sp.spanEndCol
    bc = b.spanEndCol
  in if ec > bc then
    True
  else if ec < bc then
    False
  else
    posBefore (spanStartLine b) (spanStartCol b) (spanStartLine sp) (spanStartCol sp)

-- | 内部：行尾注释的锚点（无候选为 `Nothing`）。
bestTrailAnchor : List Span -> Span -> Maybe Span
bestTrailAnchor anchors csp = trailFold Nothing anchors csp

-- | 内部：`bestTrailAnchor` 的折叠。
trailFold : Maybe Span -> List Span -> Span -> Maybe Span
trailFold best [] csp = best
trailFold best (sp :: rest) csp =
  if trailCandidate sp csp then
    case best of
      Nothing => trailFold (Just sp) rest csp
      Just b => if betterTrail sp b then trailFold (Just sp) rest csp else trailFold best rest csp
  else
    trailFold best rest csp

-- | 内部：条目起点是否严格晚于注释起点。
isLaterAnchor : Span -> Span -> Bool
isLaterAnchor sp csp =
  posBefore (spanStartLine csp) (spanStartCol csp) (spanStartLine sp) (spanStartCol sp)

-- | 内部：候选择优：起点更早者优先。
betterNext : Span -> Span -> Bool
betterNext sp b = posBefore (spanStartLine sp) (spanStartCol sp) (spanStartLine b) (spanStartCol b)

-- | 内部：注释之后最近的条目（无则为 `Nothing`）。
bestNextAnchor : List Span -> Span -> Maybe Span
bestNextAnchor anchors csp = nextFold Nothing anchors csp

-- | 内部：`bestNextAnchor` 的折叠。
nextFold : Maybe Span -> List Span -> Span -> Maybe Span
nextFold best [] csp = best
nextFold best (sp :: rest) csp =
  if isLaterAnchor sp csp then
    case best of
      Nothing => nextFold (Just sp) rest csp
      Just b => if betterNext sp b then nextFold (Just sp) rest csp else nextFold best rest csp
  else
    nextFold best rest csp

-- | 把注释分配到条目附件表：单行注释优先挂行尾锚点，否则走前置路径；
-- 返回 (附件表, 文件末尾注释)。
assignComments : List Span -> List Comment -> HashMap Int (Pair (List Comment) (List Comment)) -> List Comment -> Pair (HashMap Int (Pair (List Comment) (List Comment))) (List Comment)
assignComments anchors [] at eof = Pair at eof
assignComments anchors (c :: rest) at eof =
  let
    csp = commentSpan c
  in if isBlankMarker c then
    assignNextComment anchors c rest at eof
  else if isSingleLineComment c then
    case bestTrailAnchor anchors csp of
      Just sp => assignComments anchors rest (addToSlot (spanStartOffset sp) True c at) eof
      Nothing => assignNextComment anchors c rest at eof
  else
    assignNextComment anchors c rest at eof

-- | 内部：前置路径：挂到下一条目；没有下一条目就落到文件末尾注释。
assignNextComment : List Span -> Comment -> List Comment -> HashMap Int (Pair (List Comment) (List Comment)) -> List Comment -> Pair (HashMap Int (Pair (List Comment) (List Comment))) (List Comment)
assignNextComment anchors c rest at eof =
  case nextAnchorWithFallback anchors (commentSpan c) of
    Just sp => assignComments anchors rest (addToSlot (spanStartOffset sp) False c at) eof
    Nothing => assignComments anchors rest at (append eof [c])

-- | 内部：下一条目；若下一条目跳出最内层包含条目，则改用该包含条目
-- （函数体末尾的注释回到该函数上方，而不是下一位函数上方）。
nextAnchorWithFallback : List Span -> Span -> Maybe Span
nextAnchorWithFallback anchors csp =
  case bestNextAnchor anchors csp of
    Nothing =>
      case innermostEnclosing anchors csp of
        Nothing => Nothing
        Just enc => Just enc
    Just sp =>
      case innermostEnclosing anchors csp of
        Nothing => Just sp
        Just enc =>
          if posBeforeOrEq (spanStartLine enc) (spanStartCol enc) (spanStartLine sp) (spanStartCol sp) && posBeforeOrEq (spanStartLine sp) (spanStartCol sp) (spanEndLine enc) enc.spanEndCol then
            Just sp
          else
            Just enc

-- | 内部：trait 方法的锚点用方法签名 span（方法名到类型结束）。
traitMethodAnchor : TraitMethod -> Span
traitMethodAnchor m = traitMethodSpan m

-- | 内部：import 的锚点。
importAnchor : Import -> Span
importAnchor imp = (importSpan imp)

-- | 内部：模块头与其导出项的锚点。
headerAnchors : Maybe ModDecl -> List Span
headerAnchors Nothing = []
headerAnchors (Just m) = append [m.modDeclSpan] (modDeclItemAnchors m)

-- | 内部：导出项锚点（排序时项注释随项移动）。
modDeclItemAnchors : ModDecl -> List Span
modDeclItemAnchors (ModDecl _ _ items _ _ _ _) = map exportItemSpan items

-- | 内部：一个声明自身的锚点 + 其内部条目（构造器 / 记录字段 / trait 方法 / 子表达式）。
declAnchors : Decl -> List Span
declAnchors (DData name params kind ctors derivings viaField repr lin r) =
  nodeRefSpan r :: map ctorSpan ctors
declAnchors (DAxiom name ty r) = [nodeRefSpan r]
declAnchors (DExtern name cName ty r) = [nodeRefSpan r]
declAnchors (DSig name ctx ty r) = [nodeRefSpan r]
declAnchors (DFun name pats body r) = nodeRefSpan r :: exprAnchors body
declAnchors (DRecord name params fields derivings viaField repr lin r) =
  nodeRefSpan r :: map fieldSpan fields
declAnchors (DTrait name params supers methods r) = nodeRefSpan r :: map traitMethodAnchor methods
declAnchors (DInstance ctxE head methods r) = nodeRefSpan r :: concatMap declAnchors methods

-- | 内部：let 绑定的锚点（模式 span）。
bindingAnchor : Pair Pat Expr -> Span
bindingAnchor (Pair pat value) = patSpan pat

-- | 内部：let 绑定值里的表达式锚点。
bindingValueAnchors : Pair Pat Expr -> List Span
bindingValueAnchors (Pair pat value) = exprAnchors value

-- | 内部：case 分支的锚点（模式 span）。
altAnchor : Pair Pat Expr -> Span
altAnchor (Pair pat body) = patSpan pat

-- | 内部：case 分支体内的表达式锚点。
altBodyAnchors : Pair Pat Expr -> List Span
altBodyAnchors (Pair pat body) = exprAnchors body

-- | 内部：记录字段值的表达式锚点。
fieldExprAnchors : Pair String Expr -> List Span
fieldExprAnchors (Pair fname value) = exprAnchors value

-- | 内部：do 语句的锚点（语句 span + 值里的表达式锚点）。
doStmtAnchors : DoStmt -> List Span
doStmtAnchors (DBind pat value r) = nodeRefSpan r :: exprAnchors value
doStmtAnchors (DExpr value r) = nodeRefSpan r :: exprAnchors value
doStmtAnchors (DLet binds r) =
  nodeRefSpan r :: append (map bindingAnchor binds) (concatMap bindingValueAnchors binds)

-- | 内部：表达式里可挂注释的条目（let 绑定、case 分支、do 语句、签名行、局部函数
-- clause 等），按源码顺序。
exprAnchors : Expr -> List Span
exprAnchors e =
  case e of
    EVar name sp => []
    EInt n sp => []
    EStr s sp => []
    EFloat raw sp => []
    ELam ps body sp => exprAnchors body
    EApp fn args sp => append (exprAnchors fn) (concatMap exprAnchors args)
    EPi name implicit _ dom cod sp => append (exprAnchors dom) (exprAnchors cod)
    ELet binds body rec_ sp =>
      append
        (append (map bindingAnchor binds) (concatMap bindingValueAnchors binds))
        (exprAnchors body)
    ECase scrut alts sp =>
      append (exprAnchors scrut) (append (map altAnchor alts) (concatMap altBodyAnchors alts))
    EIf c t el sp => append (exprAnchors c) (append (exprAnchors t) (exprAnchors el))
    EField base f sp => exprAnchors base
    ERecord name fields sp => concatMap fieldExprAnchors fields
    ERecUpdate base fields sp => append (exprAnchors base) (concatMap fieldExprAnchors fields)
    EDo stmts sp => concatMap doStmtAnchors stmts
    -- where 绑定签名行（`g : Int -> Int`）本身是注释锚点（前置/行尾注释挂签名行）。
    EAnn value ty sp => sp :: exprAnchors value
    -- where/let 多 clause 局部函数：每个 clause body 的表达式锚点。
    ELocalFun clauses sp => concatMap localClauseAnchors clauses
    EInfix op l r sp => append (exprAnchors l) (exprAnchors r)
    EParen inner sp => exprAnchors inner
    -- 反引号中缀 / section 是 parse 后中间产物；子表达式里的注释仍要前移。
    EBacktick name l r sp => append (exprAnchors l) (exprAnchors r)
    ESectOp op sp => []
    ESectL op inner sp => exprAnchors inner
    ESectR inner op sp => exprAnchors inner
    -- 模板字面量：洞内表达式的注释锚点照常收集（注释仍在字面量内，但会被提升到
    -- 外层条目——注释在 `${...}` 里不进 AST，见 Lexer 的说明）。
    EInterp multi parts sp => concatMap interpPartAnchors parts

-- | 内部：模板片段里洞表达式的锚点（文本块没有锚点）。
interpPartAnchors : InterpPart -> List Span
interpPartAnchors (IPText s) = []
interpPartAnchors (IPHole e) = exprAnchors e

-- | 内部：局部函数 clause 体的锚点。
localClauseAnchors : Pair (List Pat) Expr -> List Span
localClauseAnchors (Pair pats body) = exprAnchors body

-- | 收集整个文件的注释锚点（源码顺序）：模块头 / 导出项 / import / `infix*` 声明 /
-- 声明及其内部条目。
export anchorSpans : Maybe ModDecl -> List Import -> List FixityDecl -> List Decl -> List Span
anchorSpans hdr imports fixities decls =
  append
    (headerAnchors hdr)
    (append (map importAnchor imports) (append (map fixitySpan fixities) (concatMap declAnchors decls)))

-- | 内部：条目的前置注释文档（无注释时为空）。
leadingDoc : HashMap Int (Pair (List Comment) (List Comment)) -> Span -> Doc
leadingDoc at sp =
  let
    cs = leadOf at (spanStartOffset sp)
  in if isNilList cs then empty else vsep (map commentLeadDoc cs) `appendDoc` hard

-- | 内部：把行尾注释逐个追加到条目最后一行末尾。
trailingDoc : HashMap Int (Pair (List Comment) (List Comment)) -> Span -> Doc -> Doc
trailingDoc at sp doc =
  case trailOf at (spanStartOffset sp) of
    [] => doc
    cs => foldl (\acc, c => acc `appendDoc` (text " ${inlineCommentText c}")) doc cs

-- | 把条目的注释贴到渲染结果上：前置注释在上，行尾注释追加到最后一行。
attachAtTable : HashMap Int (Pair (List Comment) (List Comment)) -> Span -> Doc -> Doc
attachAtTable at sp doc = trailingDoc at sp (leadingDoc at sp `appendDoc` doc)

-- | 内部：导出项是否挂了注释（前置或行尾）。
itemHasComments : HashMap Int (Pair (List Comment) (List Comment)) -> ExportItem -> Bool
itemHasComments at item =
  let
    sp = exportItemSpan item
  in case lookupSlot at (spanStartOffset sp) of
    Nothing => False
    Just slot => not (isNilList (firstOf slot)) || not (isNilList (secondOf slot))

-- | 任一导出项挂了注释：有则导出列表强制多行，避免单行把后续项注释掉。
anyItemHasCommentsTable : HashMap Int (Pair (List Comment) (List Comment)) -> List ExportItem -> Bool
anyItemHasCommentsTable at [] = False
anyItemHasCommentsTable at (item :: rest) =
  itemHasComments at item || anyItemHasCommentsTable at rest

-- | 去掉列表开头的空行标记（空行只保留在两条注释之间）。
stripLeadingBlanks : List Comment -> List Comment
stripLeadingBlanks [] = []
stripLeadingBlanks (c :: rest) = if isBlankMarker c then stripLeadingBlanks rest else c :: rest

-- ---------------------------------------------------------------
-- CST trivia → 注释计划
-- ---------------------------------------------------------------
-- | 注释计划：附件表（与条目起点对齐）+ 文件末尾注释。渲染时按条目 span 查表。
export record TriviaCtx where
  ctxAt : HashMap Int (Pair (List Comment) (List Comment))

-- | 内部：空附件表。
emptySlotTable : HashMap Int (Pair (List Comment) (List Comment))
emptySlotTable = HashMap.fromList []

-- | 空计划（模板洞等没有源码位置的位置）。
export emptyTrivia : TriviaCtx
emptyTrivia = TriviaCtx emptySlotTable

-- | 去掉注释原文的定界符（`--` / `{- -}`），得到旧注释模型的正文。
stripLineDelim : String -> String
stripLineDelim s = trimRightSpaces (strPack (dropN 2 (strUnpack s)))

stripBlockDelim : String -> String
stripBlockDelim s =
  let
    cs = strUnpack s
    inner = dropN 2 cs
    withoutTail = dropLastN 2 inner
  in strPack withoutTail

dropN : Int -> List Int -> List Int
dropN n xs =
  if n <= 0 then
    xs
  else
    case xs of
      [] => []
      _ :: rest => dropN (n - 1) rest

dropLastN : Int -> List Int -> List Int
dropLastN n xs = reverse (dropN n (reverse xs))

-- | 一条 trivia 注释 → 旧注释模型；不是注释给 `Nothing`。
triviaComment : Trivia -> Maybe Comment
triviaComment tr =
  case tr.triviaKind of
    TrivLineComment => Just (Comment CLine (stripLineDelim tr.triviaText) tr.triviaSpan)
    TrivBlockComment => Just (Comment CBlock (stripBlockDelim tr.triviaText) tr.triviaSpan)
    TrivSpace => Nothing

-- | trivia → 注释列表（含空行标记）；`nl` 是距上一 token / 注释的换行数。
triviaComments : List Trivia -> List Comment
triviaComments trivs = reverse (triviaCommentsGo trivs 0 [])

triviaCommentsGo : List Trivia -> Int -> List Comment -> List Comment
triviaCommentsGo [] nl acc = acc
triviaCommentsGo (tr :: rest) nl acc =
  case tr.triviaKind of
    TrivSpace => triviaCommentsGo rest (nl + countNewlines tr.triviaText) acc
    _ =>
      case triviaComment tr of
        Nothing => triviaCommentsGo rest nl acc
        Just c =>
          if nl >= 2 then
            triviaCommentsGo rest 0 (c :: blankComment tr :: acc)
          else
            triviaCommentsGo rest 0 (c :: acc)

-- | 空行标记（NUL 文本；源码里不出现）。
blankComment : Trivia -> Comment
blankComment tr = Comment CLine (strPack [0]) tr.triviaSpan

-- | 换行数。
countNewlines : String -> Int
countNewlines s = countNewlinesChars (strUnpack s)

countNewlinesChars : List Int -> Int
countNewlinesChars [] = 0
countNewlinesChars (c :: rest) = (if c == 10 then 1 else 0) + countNewlinesChars rest

-- | 从 CST trivia 建注释计划：先按锚点分配（行尾优先、否则下一条目），再返回附件表与文件末尾注释。
export triviaCtxOf : List Span -> List CstToken -> Pair TriviaCtx (List Comment)
triviaCtxOf anchors toks =
  let
    assigned = assignComments anchors (concatMap tokComments toks) emptySlotTable []
  in Pair (TriviaCtx (firstOf assigned)) (stripLeadingBlanks (secondOf assigned))

-- | 把条目的注释贴到渲染结果上。
export attachAt : TriviaCtx -> Span -> Doc -> Doc
attachAt ctx sp doc = attachAtTable ctx.ctxAt sp doc

-- | 该条目是否挂了注释（前置或行尾）；导出列表据此强制多行。
export spanHasComments : TriviaCtx -> Span -> Bool
spanHasComments ctx sp =
  case lookupSlot ctx.ctxAt (spanStartOffset sp) of
    Nothing => False
    Just slot =>
      not (isNilList (stripLeadingBlanks (firstOf slot))) || not (isNilList (secondOf slot))

-- | 任一导出项挂了注释。
export anyItemHasComments : TriviaCtx -> List ExportItem -> Bool
anyItemHasComments ctx items = anyItemHasCommentsTable ctx.ctxAt items

-- | 文件末尾注释的文档（顶格）。
export eofCommentsDoc : List Comment -> Doc
eofCommentsDoc comments = vsep (map commentLeadDoc (stripLeadingBlanks comments))

-- | 单个 token 的前置 trivia 里的注释（每个 token 单独计数空行，避免跨 token 累加）。
export tokComments : CstToken -> List Comment
tokComments t = triviaComments t.cstLeading

-- | 顶层条目的前置注释（丢掉最前面的空行标记，顶层空行由 section / 声明间距负责）。
export attachAtTop : TriviaCtx -> Span -> Doc -> Doc
attachAtTop ctx sp doc =
  let
    cs = stripLeadingBlanks (leadOf ctx.ctxAt (spanStartOffset sp))
    lead = if isNilList cs then empty else vsep (map commentLeadDoc cs) `appendDoc` hard
  in trailingDoc ctx.ctxAt sp (lead `appendDoc` doc)
