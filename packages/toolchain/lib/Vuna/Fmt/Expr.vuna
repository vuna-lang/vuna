-- | 表达式 / 模式 / 块级布局的打印。
--
-- 单行形式（`inlinePrecGo` 按运算符优先级补括号）与 `Doc` 形式共用同一份模式与中缀表；
-- `group` 按当前列一次决定展平还是换行，缩进由 `nest` 承担。注释锚点由
-- [Vuna.Fmt.Comment] 的 `attachAt` 提供；递归用显式 fuel 守卫，对外入口以
-- `formatFuelBound` 作为固定预算。
module Vuna.Fmt.Expr where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Surface
import Vuna.Fmt.Comment
import Vuna.Fmt.Doc
import Vuna.Fmt.Util

-- | 内部：绑定体与 `=` 的分隔：块结构强制另起一行，其余交给 group。
bodySep : Expr -> Doc
bodySep value = if multilineExpr value then hard else line

-- | 内部：表达式是否必须多行（块结构，或包含块结构的包装形式）。
multilineExpr : Expr -> Bool
multilineExpr (ELet binds body recFlag _) = True
multilineExpr (ECase scrut alts _) = True
multilineExpr (EDo stmts _) = True
multilineExpr (EIf c t el _) = multilineExpr t || multilineExpr el
multilineExpr (ELam ps body _) = multilineExpr body
multilineExpr (EApp fn args _) = multilineExpr fn || anyMultiline args
multilineExpr (EField base f _) = multilineExpr base
multilineExpr (ERecord name fields _) = anyMultilineFields fields
multilineExpr (ERecUpdate base fields _) = multilineExpr base || anyMultilineFields fields
multilineExpr (ESectL op inner _) = multilineExpr inner
multilineExpr (ESectR inner op _) = multilineExpr inner
multilineExpr _ = False

-- | 内部：表达式在源码里被几层括号包着（表面形状来自树，AST 里没有括号构造子）。
parenDepth : FmtCtx -> Expr -> Int
parenDepth at e = parenDepthOf at.ctxSurface (nodeRefId (exprRef e))

-- | 内部：这一层是不是**中缀链步**。parser 把中缀降级成 `EApp (EVar op) [l, r]`：符号名
-- 作函数的 2 参应用只可能来自中缀（前缀写法必须加括号），反引号写法由表面形状记。
isInfixStep : FmtCtx -> Expr -> Bool
isInfixStep at e =
  case sectionShapeOfSpan at.ctxSurface (exprSpan e) of
    Just _ => False
    Nothing =>
      case e of
        EApp (EVar op _) ([_, _]) _ => isSymbolName op || backtickMark at e
        EApp (EVar _ _) ([_, _]) _ => backtickMark at e
        _ => False

-- | 内部：链步当时是否反引号写法（``a `f` b``）。
infixBacktick : FmtCtx -> Expr -> Bool
infixBacktick at e = backtickMark at e

-- | 内部：表面形状里记的反引号链步。
backtickMark : FmtCtx -> Expr -> Bool
backtickMark at e =
  case backtickShapeOf at.ctxSurface (nodeRefId (exprRef e)) of
    Just _ => True
    Nothing => False

-- | 内部：实际要打印的括号层数。section 自带一对括号（`(+)` / `(+ e)` / `(e +)`），
-- 表面形状记的那层已经由 section 自己打出来，不再重复。
parensToPrint : FmtCtx -> Expr -> Int -> Int
parensToPrint at e n = if n <= 0 then 0 else if isSection e then n - 1 else n

-- | 内部：`n` 层括号包住文本。
wrapParens : Int -> String -> String
wrapParens n s = if n <= 0 then s else "(${wrapParens (n - 1) s})"

-- | 内部：`n` 层可展平的括号（放得下一行就一行）。
parenDocN : Int -> Doc -> Doc
parenDocN n d = if n <= 0 then d else parenDoc (parenDocN (n - 1) d)

-- | 内部：`n` 层括号包块布局（块结构必须整体另起一行）。
blockParenN : Int -> Doc -> Doc
blockParenN n d = if n <= 0 then d else blockParenDoc (blockParenN (n - 1) d)

-- | 内部：列表里是否有必须多行的表达式。
anyMultiline : List Expr -> Bool
anyMultiline [] = False
anyMultiline (e :: rest) = multilineExpr e || anyMultiline rest

-- | 内部：记录字段里是否有必须多行的值。
anyMultilineFields : List (String, Expr) -> Bool
anyMultilineFields [] = False
anyMultilineFields ((name, value) :: rest) = multilineExpr value || anyMultilineFields rest

-- ---------------------------------------------------------------
-- 字符串字面量：按 lexer 支持的转义重新编码
-- ---------------------------------------------------------------
-- | 内部：单个字符的转义（`"`、反斜杠、换行、制表、回车）。
escapeChar : Int -> String
escapeChar 34 = strPack [92, 34]
escapeChar 92 = strPack [92, 92]
escapeChar 10 = strPack [92, 110]
escapeChar 9 = strPack [92, 116]
escapeChar 13 = strPack [92, 114]
escapeChar c = strPack [c]

-- | 内部：单行字符串字面量（加双引号并按 lexer 支持的转义重新编码）。
renderStr : String -> String
renderStr s = "\"${renderTemplateText False s}\""

-- ---------------------------------------------------------------
-- 模板 / 多行字面量
--
-- 规范形：
--   * 单行形式（`multi = False`、以及普通 `EStr`）：`"..."`，换行/制表转义；
--   * 多行形式（`multi = True`，来自源码 `"""`）：`"""..."""`，内容换行原样保留；
--   * 文本里的 `$` 紧跟 `{` 时写成 `\$`，否则会被重新解析成插值洞；
--   * 与 lexer「丢掉紧跟开引号的一个换行」互逆：首块以换行开头时先补一个换行。
-- 洞内表达式照常格式化；非单行可渲的洞（case/do/let）换到多行布局（换行只出现在
-- `${...}` 内部，仍属于代码，不影响字面量文本）。
-- ---------------------------------------------------------------
-- | 内部：文本块编码（`multi` 决定换行 / 制表 / 回车是否原样保留）。
renderTemplateText : Bool -> String -> String
renderTemplateText multi s = strPack (reverse (renderTemplateTextGo multi (strUnpack s) []))

-- | 内部：`renderTemplateText` 的字符级累加器（逆序输出）。
renderTemplateTextGo : Bool -> List Int -> List Int -> List Int
renderTemplateTextGo multi [] acc = acc
renderTemplateTextGo multi (c :: rest) acc =
  if c == 92 then
    renderTemplateTextGo multi rest (92 :: 92 :: acc)
  else if c == 34 then
    renderTemplateTextGo multi rest (34 :: 92 :: acc)
  else if c == 10 then
    if multi then renderTemplateTextGo multi rest (10 :: acc) else renderTemplateTextGo multi rest (110 :: 92 :: acc)
  else if c == 9 then
    if multi then renderTemplateTextGo multi rest (9 :: acc) else renderTemplateTextGo multi rest (116 :: 92 :: acc)
  else if c == 13 then
    if multi then renderTemplateTextGo multi rest (13 :: acc) else renderTemplateTextGo multi rest (114 :: 92 :: acc)
  else if c == 36 then
    case rest of
      c2 :: rest2 => if c2 == 123 then renderTemplateTextGo multi rest2 (123 :: 36 :: 92 :: acc) else renderTemplateTextGo multi rest (36 :: acc)
      [] => renderTemplateTextGo multi rest (36 :: acc)
  else
    renderTemplateTextGo multi rest (c :: acc)

-- | 内部：文本是否以换行开头。
startsWithNewline : String -> Bool
startsWithNewline s =
  case strUnpack s of
    10 :: rest => True
    _ => False

-- | 内部：开引号；多行形式下首块以换行开头时补一个换行（与 lexer「丢掉紧跟开引号的
-- 一个换行」互逆）。
interpOpen : Bool -> List InterpPart -> String
interpOpen multi parts =
  if multi then
    case parts of
      (IPText s) :: rest => if startsWithNewline s then "\"\"\"\n" else "\"\"\""
      _ => "\"\"\""
  else
    "\""

-- | 内部：闭引号（多行形式 `"""`，否则 `"`）。
interpClose : Bool -> String
interpClose True = "\"\"\""
interpClose False = "\""

-- | 内部：按换行切行（内容换行是字面量内容，不参与外层布局）。
splitOnNewline : String -> List String
splitOnNewline s = splitOnNewlineGo (strUnpack s) []

-- | 内部：`splitOnNewline` 的字符级实现。
splitOnNewlineGo : List Int -> List Int -> List String
splitOnNewlineGo [] acc = [strPack (reverse acc)]
splitOnNewlineGo (c :: rest) acc =
  if c == 10 then
    strPack (reverse acc) :: splitOnNewlineGo rest []
  else
    splitOnNewlineGo rest (c :: acc)

-- | 内部：模板片段的单行渲染；任一洞需要块布局时整体返回 `Nothing`。
interpPiecesInline : Int -> List FixityDecl -> FmtCtx -> Bool -> List InterpPart -> Maybe (List String)
interpPiecesInline fuel env at multi parts =
  if fuel <= 0 then
    Nothing
  else
    case parts of
      [] => Just []
      (IPText s) :: rest =>
        case interpPiecesInline (fuel - 1) env at multi rest of
          Nothing => Nothing
          Just ss => Just (renderTemplateText multi s :: ss)
      (IPHole e) :: rest =>
        case inlinePrecGo (fuel - 1) env at 0 e of
          Nothing => Nothing
          Just s =>
            case interpPiecesInline (fuel - 1) env at multi rest of
              Nothing => Nothing
              Just ss => Just ("\${${s}}" :: ss)

-- ---------------------------------------------------------------
-- 模式（模式没有块结构，统一输出单行，必要时加括号）
-- ---------------------------------------------------------------
-- | 内部：是否列表 cons 拼写：中缀 `::`、`Cons`，或 parser 的列表语法形式。
consPatName : String -> Bool
consPatName name = name == "Cons" || name == "::" || isListConsSyntax name

-- | 内部：把 cons / `Nil` 形式展开成元素列表（不是列表形式则为 `Nothing`）。
patListElemsOf : String -> List Pat -> Maybe (List Pat)
patListElemsOf name pats =
  if name == "Nil" || isListNilSyntax name then
    if isNilList pats then Just [] else Nothing
  else if consPatName name then
    case pats of
      [a, rest] =>
        case patListElems rest of
          Just elems => Just (a :: elems)
          Nothing => Nothing
      _ => Nothing
  else
    Nothing

-- | 内部：模式若是列表形式则展开成元素列表。
patListElems : Pat -> Maybe (List Pat)
patListElems (PCon name pats _) = patListElemsOf name pats
patListElems _ = Nothing

-- 显式结构递归：`map renderPatGo` 的 λ 没有 size 关系，SCT 会判成无下降环。
-- | 内部：列表元素逐个渲染并逗号连接。
renderPatElemsGo : Int -> List Pat -> String
renderPatElemsGo fuel pats =
  if fuel <= 0 then
    ""
  else
    case pats of
      [] => ""
      [p] => renderPatGo (fuel - 1) p
      p :: rest => "${renderPatGo (fuel - 1) p}, ${renderPatElemsGo (fuel - 1) rest}"

-- | 内部：构造子实参逐个前置空格拼接（原子位置）。
renderPatAtomsSpacedGo : Int -> List Pat -> String
renderPatAtomsSpacedGo fuel pats =
  if fuel <= 0 then
    ""
  else
    case pats of
      [] => ""
      p :: rest => " ${renderPatAtomGo (fuel - 1) p}${renderPatAtomsSpacedGo (fuel - 1) rest}"

-- | 内部：记录模式字段逗号连接。
renderRecPatFieldsGo : Int -> List (String, Pat) -> String
renderRecPatFieldsGo fuel fields =
  if fuel <= 0 then
    ""
  else
    case fields of
      [] => ""
      [f] => renderRecPatFieldGo (fuel - 1) f
      f :: rest => "${renderRecPatFieldGo (fuel - 1) f}, ${renderRecPatFieldsGo (fuel - 1) rest}"

-- | 内部：模式的单行渲染（顶层位置，不加外层括号）。
renderPatGo : Int -> Pat -> String
renderPatGo fuel pat =
  if fuel <= 0 then
    ""
  else
    case pat of
      PVar name _ => name
      PAs name inner _ => "${name}@${renderPatAtomGo (fuel - 1) inner}"
      PWild _ => "_"
      PInt n _ => strFromInt n
      PStr s _ => renderStr s
      PCon name pats _ => renderConPatGo (fuel - 1) name pats
      PRecord name fields _ => renderRecPatGo (fuel - 1) name fields

-- | 内部：构造子模式（`[a, b]` 列表形式 / `(a, b)` 元组形式 / 中缀 cons / 前缀应用）。
renderConPatGo : Int -> String -> List Pat -> String
renderConPatGo fuel name pats =
  if fuel <= 0 then
    ""
  else if isTupleUnitSyntax name then
    "()"
  else
    case tuplePatElemsOf name pats of
      Just elems => "(${renderPatElemsGo (fuel - 1) elems})"
      Nothing =>
        case patListElemsOf name pats of
          Just elems => "[${renderPatElemsGo (fuel - 1) elems}]"
          Nothing => if consPatName name then renderConsPatGo (fuel - 1) pats else if (name == "Nil" || isListNilSyntax name) && isNilList pats then "[]" else if isNilList pats then name else name ++ renderPatAtomsSpacedGo (fuel - 1) pats

-- | 内部：cons 模式 `a :: b`（两个实参）；其它实参数按前缀形式渲染。
renderConsPatGo : Int -> List Pat -> String
renderConsPatGo fuel pats =
  if fuel <= 0 then
    ""
  else
    case pats of
      [a, b] => "${renderPatAtomGo (fuel - 1) a} :: ${renderPatConsTailGo (fuel - 1) b}"
      _ => "Cons${renderPatAtomsSpacedGo (fuel - 1) pats}"

-- | 内部：cons 链的尾部（右结合，继续展开成 `a :: b :: ...`）。
renderPatConsTailGo : Int -> Pat -> String
renderPatConsTailGo fuel pat =
  if fuel <= 0 then
    ""
  else
    case pat of
      PCon name pats _ =>
        if consPatName name then
          case pats of
            [a, b] => "${renderPatAtomGo (fuel - 1) a} :: ${renderPatConsTailGo (fuel - 1) b}"
            _ => renderPatAtomGo (fuel - 1) pat
        else
          renderPatAtomGo (fuel - 1) pat
      _ => renderPatAtomGo (fuel - 1) pat

-- | 内部：原子位置的模式（需要时加括号）。
renderPatAtomGo : Int -> Pat -> String
renderPatAtomGo fuel pat =
  if fuel <= 0 then
    ""
  else
    case pat of
      PVar name _ => name
      PAs name inner _ => "(${name}@${renderPatAtomGo (fuel - 1) inner})"
      PWild _ => "_"
      PInt n _ => strFromInt n
      PStr s _ => renderStr s
      PCon name [] _ => if isTupleUnitSyntax name then "()" else if name == "Nil" || isListNilSyntax name then "[]" else name
      PCon name pats _ =>
        if isTupleUnitSyntax name then
          "()"
        else
          case tuplePatElemsOf name pats of
            Just elems => "(${renderPatElemsGo (fuel - 1) elems})"
            Nothing => "(${renderConPatGo (fuel - 1) name pats})"
      PRecord name fields _ => "(${renderRecPatGo (fuel - 1) name fields})"

-- | 内部：记录模式 `Name { f = p }`（无字段时 `Name { }`）。
renderRecPatGo : Int -> String -> List (String, Pat) -> String
renderRecPatGo fuel name fields =
  if fuel <= 0 then
    ""
  else if isNilList fields then
    "${name} { }"
  else
    "${name} { ${renderRecPatFieldsGo (fuel - 1) fields} }"

-- | 内部：记录模式字段 `f = p`（模式就是同名变量时只写名字）。
renderRecPatFieldGo : Int -> (String, Pat) -> String
renderRecPatFieldGo fuel (fname, pat) =
  if fuel <= 0 then
    ""
  else
    case pat of
      PVar n _ => if n == fname then fname else "${fname} = ${renderPatGo (fuel - 1) pat}"
      _ => "${fname} = ${renderPatGo (fuel - 1) pat}"

-- ---------------------------------------------------------------
-- 单行表达式：inlineExprGo / inlinePrecGo / inlineAtomGo
-- inlinePrecGo 按运算符优先级决定是否补括号；块结构（case/let/do）返回 Nothing。
-- ---------------------------------------------------------------
-- | 内部：运算符的可见声明：只查名字本身（没有反向别名）。
opDeclOf : List FixityDecl -> String -> Maybe FixityDecl
opDeclOf env op = lookupFixityDecl (tableOfKeepOps emptySurface env) op

-- | 内部：中缀打印用的 (优先级, 结合性)：1 = 右，0 = 左/未知。
infixPrecOf : List FixityDecl -> String -> Maybe (Int, Int)
infixPrecOf env op =
  case opDeclOf env op of
    Just d => Just (d.fixityLevel, if d.fixityAssoc == 2 then 1 else 0)
    Nothing => if isSymbolName op then Just (9, 0) else Nothing

-- | 内部：打印侧优先级查询（只用于应用位置的符号名兜底；中缀链不走这里）。
infixPrec : List FixityDecl -> String -> (Int, Int)
infixPrec env op =
  case infixPrecOf env op of
    Just fx => fx
    Nothing => (9, 0)

-- | 内部：反引号中缀的运算符标签 `` `name` ``。
backtickLabel : String -> String
backtickLabel name = "`${name}`"

-- | 内部：`perform <op>` 的保留名编码还原出 `<op>`（不是该形态则为 `Nothing`）。
performOperand : Expr -> Maybe Expr
performOperand (EApp (EVar name _) ([op]) _) = if isPerformSyntax name then Just op else Nothing
performOperand _ = Nothing

-- | 内部：行字面量的实例名文本。合法的标识符可以去掉引号（`@"audit"` 与 `@audit` 同义），
-- 其余（`"process-error"`、数字开头、含空格）必须保留字符串字面量，否则重写出的源码无法再解析。
rowAtNameText : Expr -> Maybe String
rowAtNameText (EStr s _) = Just (instanceNameText s)
rowAtNameText (EVar n _) = Just n
rowAtNameText _ = Nothing

-- | 实例名文本：能写成单个标识符 token 的才去引号，否则用字符串字面量。
instanceNameText : String -> String
instanceNameText s = if identNameOk s then s else renderStr s

-- | 实例名是否能作为标识符 token 写出（与 lexer 的 `collectIdent` 同规则，允许 `.` 分段）。
identNameOk : String -> Bool
identNameOk s =
  case strUnpack s of
    [] => False
    c :: rest => if isIdentStart c then identNameOkGo rest else False

identNameOkGo : List Int -> Bool
identNameOkGo [] = True
identNameOkGo (c :: rest) =
  if isIdentChar c then identNameOkGo rest else if c == 46 then identNameOkDot rest else False

identNameOkDot : List Int -> Bool
identNameOkDot [] = False
identNameOkDot (c :: rest) = if isIdentStart c then identNameOkGo rest else False

-- | 内部：行字面量 `X@name` 的 (类型, 实例名)（不是该形态则为 `Nothing`）。
rowAtParts : Expr -> Maybe (Expr, Expr)
rowAtParts (EApp (EVar name _) ([e, n]) _) = if isRowAtSyntax name then Just (e, n) else Nothing
rowAtParts _ = Nothing

-- | 内部：实例名调用糖 `f@name args` 的 (函数, (实例名, 实参列表))；
-- 编码见 `Frontend/Ast.appAtSyntax`。
appAtParts : Expr -> Maybe (Expr, Expr, List Expr)
appAtParts (EApp (EVar name _) (f :: nm :: rest) _) =
  if isAppAtSyntax name then Just (f, nm, rest) else Nothing
appAtParts _ = Nothing

-- | 内部：`handle` 标记的 (comp, (ret, op handler))。编码见 `Frontend/Ast.handleSyntax`：
-- `EApp (EVar "@vuna@handle") [comp, ret, opH]`；ret 缺失时是哨兵。
-- | 内部：handle 子句模式的逐项渲染（无前导空格）。合成形态把结果索引与续延 binder 拆成了
-- λ 的前两个参数，所以 alt 的 pattern 就是构造子的全部实参；续延名由调用方另行拼上。
renderHandlePats : Int -> List Pat -> String
renderHandlePats fuel pats = renderHandlePatsGo fuel pats

-- | 内部：`renderHandlePats` 的首项（无前置空格）。
renderHandlePatsGo : Int -> List Pat -> String
renderHandlePatsGo fuel [] = ""
renderHandlePatsGo fuel (p :: rest) = "${renderPatGo fuel p}${renderHandlePatsTail fuel rest}"

-- | 内部：`renderHandlePats` 的后续项（前置空格）。
renderHandlePatsTail : Int -> List Pat -> String
renderHandlePatsTail fuel [] = ""
renderHandlePatsTail fuel (p :: rest) = " ${renderPatGo fuel p}${renderHandlePatsTail fuel rest}"

listExprElems : Expr -> Maybe (List Expr)
listExprElems (EVar name _) = if name == "Nil" || isListNilSyntax name then Just [] else Nothing
listExprElems (EApp (EVar name _) ([a, rest]) _) =
  if isListConsSyntax name then listExprCons a rest else Nothing
listExprElems _ = Nothing

-- | 内部：cons 链展开的辅助：把 `a : rest` 接在 `rest` 展开出的元素前面。
listExprCons : Expr -> Expr -> Maybe (List Expr)
listExprCons a rest =
  case listExprElems rest of
    Just elems => Just (a :: elems)
    Nothing => Nothing

-- 元组语法（parser 保留名）右嵌套展开成元素表；`Nothing` = 不是元组语法。
tupleExprElems : Expr -> Maybe (List Expr)
tupleExprElems (EApp (EVar name _) ([a, b]) _) =
  if isTuplePairSyntax name then
    case tupleExprElems b of
      Just rest => Just (a :: rest)
      Nothing => Just [a, b]
  else
    Nothing
tupleExprElems _ = Nothing

-- 类型标注 `(e : T)` 的保留名展开。
ascribeParts : Expr -> Maybe (Expr, Expr)
ascribeParts (EApp (EVar name _) ([v, t]) _) = if isAscribeSyntax name then Just (v, t) else Nothing
ascribeParts _ = Nothing

-- 元组模式（parser 保留名）右嵌套展开成元素表。
tuplePatElemsOf : String -> List Pat -> Maybe (List Pat)
tuplePatElemsOf name pats =
  if isTuplePairSyntax name then
    case pats of
      [a, b] =>
        case tuplePatElems b of
          Just rest => Just (a :: rest)
          Nothing => Just [a, b]
      _ => Nothing
  else
    Nothing

tuplePatElems : Pat -> Maybe (List Pat)
tuplePatElems (PCon name pats _) = tuplePatElemsOf name pats
tuplePatElems _ = Nothing

-- | 内部：单行渲染入口：能单行就给 `Just`，含块结构或 fuel 用尽给 `Nothing`。
inlineExprGo : Int -> List FixityDecl -> FmtCtx -> Expr -> Maybe String
inlineExprGo fuel env at e = if fuel <= 0 then Nothing else inlinePrecGo (fuel - 1) env at 0 e

-- | 内部：单行渲染。源码里的括号先在**外面**整体包上：括号让表达式成为原子，外层优先级
-- 要求因此不再适用（与源码一致，也不按优先级丢括号）。
inlinePrecGo : Int -> List FixityDecl -> FmtCtx -> Int -> Expr -> Maybe String
inlinePrecGo fuel env at minPrec e =
  if fuel <= 0 then
    Nothing
  else
    case parensToPrint at e (parenDepth at e) of
      0 => inlineBareGo fuel env at minPrec e
      n =>
        case inlineBareGo (fuel - 1) env at 0 e of
          Nothing => Nothing
          Just s => Just (wrapParens n s)

-- | 内部：单行渲染并按上下文优先级补括号（不含源码括号，见 `inlinePrecGo`）；
-- `minPrec` 是外层要求的最低优先级。case / let / do / handle / 局部函数等块结构返回
-- `Nothing`（交给块级布局）。
inlineBareGo : Int -> List FixityDecl -> FmtCtx -> Int -> Expr -> Maybe String
inlineBareGo fuel env at minPrec e =
  if fuel <= 0 then
    Nothing
  else
    case e of
      EVar name _ =>
        case macroNameOf name of
          -- 内置宏标记回渲染成 `name!`（编码见 `Frontend/Ast.macroSyntaxName`）。
          Just macroName => Just "${macroName}!"
          Nothing => if isTupleUnitSyntax name then Just "()" else if name == "Nil" || isListNilSyntax name then Just "[]" else if isSymbolName name then Just "(${name})" else Just name
      EInt n _ => Just (strFromInt n)
      EStr s _ => Just (renderStr s)
      EFloat raw _ => Just raw
      -- 模板字面量。文本块转义；洞优先单行内联，洞需要块布局时放弃（交给块渲染）。
      EInterp multi parts _ =>
        case interpPiecesInline (fuel - 1) env at multi parts of
          Nothing => Nothing
          Just pieces =>
            let
              body = concatStrings pieces
              text = interpOpen multi parts ++ body ++ interpClose multi
            in if textHasNewline text then Nothing else Just text
      ELam ps body _ =>
        case inlinePrecGo (fuel - 1) env at 0 body of
          Nothing => Nothing
          Just b => Just (wrapPrec (minPrec > 0) "\\${joinComma (map firstOf ps)} => ${b}")
      EApp fn args sp =>
        case appAtParts (EApp fn args sp) of
          Just (f, nm, rest) =>
            case inlineExprGo (fuel - 1) env at f of
              Nothing => Nothing
              Just fs =>
                case nm of
                  EStr s _ =>
                    case mapMaybeStrings (\x => inlineExprGo (fuel - 1) env at x) rest of
                      Nothing => Nothing
                      Just ss => Just (wrapPrec (minPrec > 0) (fs ++ "@" ++ instanceNameText s ++ joinSpace ss))
                  EVar vn _ =>
                    case mapMaybeStrings (\x => inlineExprGo (fuel - 1) env at x) rest of
                      Nothing => Nothing
                      Just ss => Just (wrapPrec (minPrec > 0) (fs ++ "@(" ++ vn ++ ")" ++ joinSpace ss))
                  _ =>
                    if parenDepth at nm > 0 then
                      case inlineExprGo (fuel - 1) env at nm of
                        Nothing => Nothing
                        Just ns =>
                          case mapMaybeStrings (\x => inlineExprGo (fuel - 1) env at x) rest of
                            Nothing => Nothing
                            Just ss => Just (wrapPrec (minPrec > 0) (fs ++ "@" ++ ns ++ joinSpace ss))
                    else
                      case inlineExprGo (fuel - 1) env at nm of
                        Nothing => Nothing
                        Just ns =>
                          case mapMaybeStrings (\x => inlineExprGo (fuel - 1) env at x) rest of
                            Nothing => Nothing
                            Just ss => Just (wrapPrec (minPrec > 0) (fs ++ "@(" ++ ns ++ ")" ++ joinSpace ss))
          Nothing =>
            case handleParts (EApp fn args sp) of
              Just _ => Nothing
              Nothing =>
                case rowAtParts (EApp fn args sp) of
                  Just (lbl, nm) =>
                    case inlineExprGo (fuel - 1) env at lbl of
                      Nothing => Nothing
                      Just ls =>
                        case rowAtNameText nm of
                          Just ns => Just "${ls}@${ns}"
                          Nothing => Nothing
                  Nothing =>
                    case performOperand (EApp fn args sp) of
                      Just op =>
                        case inlineExprGo (fuel - 1) env at op of
                          Nothing => Nothing
                          Just os => Just (wrapPrec (minPrec > 0) "perform ${os}")
                      Nothing =>
                        case listExprElems (EApp fn args sp) of
                          Just elems =>
                            case mapMaybeStrings (\x => inlineExprGo (fuel - 1) env at x) elems of
                              Nothing => Nothing
                              Just ss => Just "[${joinComma ss}]"
                          Nothing =>
                            case tupleExprElems (EApp fn args sp) of
                              Just elems =>
                                case mapMaybeStrings (\x => inlineExprGo (fuel - 1) env at x) elems of
                                  Nothing => Nothing
                                  Just ss => Just "(${joinComma ss})"
                              Nothing =>
                                case ascribeParts (EApp fn args sp) of
                                  Just (v, t) =>
                                    case inlineExprGo (fuel - 1) env at v of
                                      Nothing => Nothing
                                      Just vs =>
                                        case inlineExprGo (fuel - 1) env at t of
                                          Nothing => Nothing
                                          Just ts => Just "(${vs} : ${ts})"
                                  Nothing => inlineAppGo (fuel - 1) env at minPrec (EApp fn args sp) fn args
      EPi name implicit qty dom cod _ => inlinePiGo (fuel - 1) env at minPrec qty name implicit dom cod
      ELet binds body rec_ _ => Nothing
      ECase scrut alts _ => Nothing
      EIf c t el _ =>
        case inlinePrecGo (fuel - 1) env at 0 c of
          Nothing => Nothing
          Just cs =>
            case inlinePrecGo (fuel - 1) env at 0 t of
              Nothing => Nothing
              Just ts =>
                case inlinePrecGo (fuel - 1) env at 0 el of
                  Nothing => Nothing
                  Just es => Just (wrapPrec (minPrec > 0) "if ${cs} then ${ts} else ${es}")
      EField base f _ =>
        case inlineAtomGo (fuel - 1) env at base of
          Nothing => Nothing
          Just b => Just "${b}.${f}"
      ERecord name fields _ =>
        case inlineFieldsGo (fuel - 1) env at fields of
          Nothing => Nothing
          Just ss =>
            case fields of
              [] => Just "${name} { }"
              _ => Just "${name} { ${joinComma ss} }"
      ERecUpdate base fields _ =>
        case inlinePrecGo (fuel - 1) env at 0 base of
          Nothing => Nothing
          Just b =>
            case inlineFieldsGo (fuel - 1) env at fields of
              Nothing => Nothing
              Just ss =>
                case fields of
                  [] => Just "{ ${b} }"
                  _ => Just "{ ${b} | ${joinComma ss} }"
      EDo stmts _ => Nothing
      ESectOp op _ => Just "(${op})"
      ESectL op inner _ =>
        case inlinePrecGo (fuel - 1) env at 0 inner of
          Nothing => Nothing
          Just s => Just "(${op} ${s})"
      -- 右 section 的 inner 必须按**原子**打印：`((a + b) +)` 才能重新 parse 成
      -- `ESectR (a + b) +`（否则最后一个 `+` 会被解析成更内层的右 section）。
      ESectR inner op _ =>
        case inlineAtomGo (fuel - 1) env at inner of
          Nothing => Nothing
          Just s => Just "(${s} ${op})"
      _ => Nothing

-- | 内部：`needParen` 为真时把文本包进一对括号。
wrapPrec : Bool -> String -> String
wrapPrec True s = "(${s})"
wrapPrec False s = s

-- | 内部：记录字段 `f = e` 的单行列表（任一字段渲不出则为 `Nothing`）。
inlineFieldsGo : Int -> List FixityDecl -> FmtCtx -> List (String, Expr) -> Maybe (List String)
inlineFieldsGo fuel env at fields =
  if fuel <= 0 then
    Nothing
  else
    case fields of
      [] => Just []
      (fname, value) :: rest =>
        case inlinePrecGo (fuel - 1) env at 0 value of
          Nothing => Nothing
          Just v =>
            case inlineFieldsGo (fuel - 1) env at rest of
              Nothing => Nothing
              Just ss => Just ("${fname} = ${v}" :: ss)

-- | 内部：Pi 类型 `(x : A) -> B` / 隐式 `{x : A} -> B`；`->` 右结合。
inlinePiGo : Int -> List FixityDecl -> FmtCtx -> Int -> Maybe Qty -> String -> Bool -> Expr -> Expr -> Maybe String
inlinePiGo fuel env at minPrec qty name implicit dom cod =
  if fuel <= 0 then
    Nothing
  else
    case inlinePrecGo (fuel - 1) env at 0 dom of
      Nothing => Nothing
      Just d =>
        case inlinePrecGo (fuel - 1) env at 1 cod of
          Nothing => Nothing
          Just c =>
            let
              binder = if implicit then "{${qtyPrefix qty}${name} : ${d}}" else "(${qtyPrefix qty}${name} : ${d})"
            in Just (wrapPrec (minPrec > 1) "${binder} -> ${c}")

-- | 内部：quantity 前缀（`0 ` / `1 `）；缺省不打印。
qtyPrefix : Maybe Qty -> String
qtyPrefix Nothing = ""
qtyPrefix (Just Q0) = "0 "
qtyPrefix (Just Q1) = "1 "

-- | 内部：应用的单行渲染：符号名 / canonical 别名的两参应用还原成中缀 `a op b`
-- （哪怕无声明也按 9 左打印），其余按应用形式。中缀链步按源码顺序打印。
inlineAppGo : Int -> List FixityDecl -> FmtCtx -> Int -> Expr -> Expr -> List Expr -> Maybe String
inlineAppGo fuel env at minPrec whole fn args =
  if fuel <= 0 then
    Nothing
  else if isInfixStep at whole then
    inlineInfixChain (fuel - 1) env at whole
  else
    case fn of
      -- 符号名当作中缀运算符：两参应用还原成 `a op b`（哪怕无声明也按 9 左打印）。
      -- 普通标识符保持应用形式。
      EVar op _ =>
        if isSymbolName op then
          case args of
            [a, b] =>
              let
                fx = infixPrec env op
              in inlineInfixGo (fuel - 1) env at minPrec (firstOf fx) (secondOf fx) op a b
            _ => inlineApplyGo (fuel - 1) env at minPrec fn args
        else
          inlineApplyGo (fuel - 1) env at minPrec fn args
      _ => inlineApplyGo (fuel - 1) env at minPrec fn args

-- | 内部：中缀 `a op b` 的单行渲染；按结合性给两侧最低优先级，优先级不足时加括号。
inlineInfixGo : Int -> List FixityDecl -> FmtCtx -> Int -> Int -> Int -> String -> Expr -> Expr -> Maybe String
inlineInfixGo fuel env at minPrec p assoc label a b =
  if fuel <= 0 then
    Nothing
  else
    let
      leftMin = if assoc == 0 then p else p + 1
      rightMin = if assoc == 0 then p + 1 else p
    in case inlinePrecGo (fuel - 1) env at leftMin a of
      Nothing => Nothing
      Just lhsText =>
        case inlinePrecGo (fuel - 1) env at rightMin b of
          Nothing => Nothing
          Just rhsText => Just (wrapPrec (p < minPrec) "${lhsText} ${label} ${rhsText}")

-- | 内部：普通应用 `f a b` 的单行渲染（实参按原子位置打印，整体优先级 9）。
inlineApplyGo : Int -> List FixityDecl -> FmtCtx -> Int -> Expr -> List Expr -> Maybe String
inlineApplyGo fuel env at minPrec fn args =
  if fuel <= 0 then
    Nothing
  else
    case inlineApplyHeadGo (fuel - 1) env at fn of
      Nothing => Nothing
      Just headText =>
        case mapMaybeStrings (\a => inlineAtomGo (fuel - 1) env at a) args of
          Nothing => Nothing
          Just argTexts => Just (wrapPrec (9 < minPrec) (headText ++ concatStrings (map (\a => " ${a}") argTexts)))

-- | 内部：应用头按原子位置渲染（`f a` 里的 `f`）。
inlineApplyHeadGo : Int -> List FixityDecl -> FmtCtx -> Expr -> Maybe String
inlineApplyHeadGo fuel env at fn =
  if fuel <= 0 then
    Nothing
  else
    case fn of
      _ => inlineAtomGo (fuel - 1) env at fn

-- | 内部：原子位置的渲染：本身是原子形式就用原文本，否则加括号。
inlineAtomGo : Int -> List FixityDecl -> FmtCtx -> Expr -> Maybe String
inlineAtomGo fuel env at e =
  if fuel <= 0 then
    Nothing
  else
    case inlinePrecGo (fuel - 1) env at 0 e of
      Nothing => Nothing
      Just s => if parenDepth at e > 0 || atomForm e then Just s else Just "(${s})"

-- | 内部：该表达式本身是否已是原子形式（原子位置无需再加括号）。
atomForm : Expr -> Bool
atomForm (EVar name _) = True
atomForm (EInt n _) = True
atomForm (EStr s _) = True
atomForm (EFloat raw _) = True
atomForm (EInterp multi parts _) = True
atomForm (EField base f _) = True
atomForm (ERecord name fields _) = True
atomForm (ERecUpdate base fields _) = True
atomForm (EApp fn args sp) =
  case listExprElems (EApp fn args sp) of
    Just elems => True
    Nothing =>
      case tupleExprElems (EApp fn args sp) of
        Just _ => True
        Nothing =>
          case ascribeParts (EApp fn args sp) of
            Just _ => True
            Nothing => False
-- section 自带括号，永远是原子；反引号中缀是运算符形式（最低优先级）。
atomForm (ESectOp op _) = True
atomForm (ESectL op inner _) = True
atomForm (ESectR inner op _) = True
atomForm _ = False

-- ---------------------------------------------------------------
-- 块级表达式：Doc
--
-- 缩进由 `nest` / `align` 承担；换行与否由最近的 `group` 按当前列一次决定。
-- 不再有「单行版 + 块版」两套渲染，也没有 `lineInd` 参数。
--
-- 每个递归函数都带显式 fuel：渲染既沿 AST 子项下降，也经 `map` / `concatMap`
-- 的 λ 前进，SCT 看不到结构下降。
-- ---------------------------------------------------------------
-- | 内部：可展平的文本；渲不出时为空文档。
flatDoc : List FixityDecl -> FmtCtx -> Expr -> Doc
flatDoc env at e =
  case inlinePrecGo formatFuelBound env at 0 e of
    Just s => verbatim s
    Nothing => empty

-- | 内部：括号包块布局（块结构必须整体另起一行，闭合括号也独占一行）。
blockParenDoc : Doc -> Doc
blockParenDoc d =
  appendDoc (text "(") (appendDoc (nest 2 (appendDoc hard d)) (appendDoc hard (text ")")))

-- | 内部：可展平的括号（内部不是块结构时用）。
parenDoc : Doc -> Doc
parenDoc d =
  group (appendDoc (text "(") (appendDoc (nest 2 (appendDoc soft d)) (appendDoc soft (text ")"))))

-- | 内部：能单行就写 `(s)`，否则括号独占行。源码已带括号时单行形式就是源码括号。
parenInlineOrBlock : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
parenInlineOrBlock fuel env at e =
  if fuel <= 0 then
    empty
  else if parenDepth at e > 0 then
    case inlineExprGo formatFuelBound env at e of
      Just s => verbatim s
      Nothing => exprDoc (fuel - 1) env at e
  else
    case inlineExprGo formatFuelBound env at e of
      Just s => text "(${s})"
      Nothing => blockParenDoc (exprDoc (fuel - 1) env at e)

-- | 内部：块位置的括号包装；源码已带括号时不再加一层（`exprDoc` 会打出它们）。
blockWrapDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
blockWrapDoc fuel env at e =
  if fuel <= 0 then
    empty
  else if parenDepth at e > 0 then
    exprDoc (fuel - 1) env at e
  else
    blockParenDoc (exprDoc (fuel - 1) env at e)

-- | 内部：原子位置的文档（需要时加括号）。
atomDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
atomDoc fuel env at e =
  if fuel <= 0 then
    empty
  else
    case inlineAtomGo formatFuelBound env at e of
      Just s => verbatim s
      Nothing => blockWrapDoc (fuel - 1) env at e

-- | 内部：`case` / `if` 的被检查表达式：优先单行，否则括号包块布局。
scrutDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
scrutDoc fuel env at e =
  if fuel <= 0 then
    empty
  else
    case inlineExprGo formatFuelBound env at e of
      Just s => verbatim s
      Nothing => blockWrapDoc (fuel - 1) env at e

-- | 内部：类型文本（签名 / 字段 / kind）：保持单行；渲不出时把块布局压成原样文本。
typeText : Int -> List FixityDecl -> FmtCtx -> Expr -> String
typeText fuel env at e =
  if fuel <= 0 then
    ""
  else
    case inlinePrecGo formatFuelBound env at 0 e of
      Just s => s
      Nothing => render maxWidth (exprDoc (fuel - 1) env at e)

-- | 内部：按上下文最低优先级渲染操作数（优先级不足时括号保持单行）。
operandDoc : Int -> List FixityDecl -> FmtCtx -> Int -> Expr -> Doc
operandDoc fuel env at minPrec e =
  if fuel <= 0 then
    empty
  else if minPrec > 0 then
    case inlinePrecGo formatFuelBound env at minPrec e of
      Just s => verbatim s
      Nothing => blockWrapDoc (fuel - 1) env at e
  else
    exprDoc (fuel - 1) env at e

-- | 内部：逗号分隔的文档列表（展平时 `, `，断行时逗号留在行尾）。
commaDocs : List Doc -> Doc
commaDocs [] = empty
commaDocs ([d]) = d
commaDocs (d :: rest) = appendDoc d (appendDoc (text ",") (appendDoc line (commaDocs rest)))

-- | 表达式文档；调用方决定是否用 `group` 把整段当作可展平区域。源码括号在**外面**
-- 按层数整体包上（块结构用独占行的括号形式，其余可展平）。
exprDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
exprDoc fuel env at e =
  if fuel <= 0 then
    empty
  else
    case parensToPrint at e (parenDepth at e) of
      0 => exprDocBare fuel env at e
      n =>
        let
          innerD = exprDocBare (fuel - 1) env at e
        in if multilineExpr e then blockParenN n innerD else parenDocN n innerD

-- | 表达式文档（不含源码括号，见 `exprDoc`）。
exprDocBare : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
exprDocBare fuel env at e =
  if fuel <= 0 then
    empty
  else
    case e of
      ECase scrut alts _ => appendDoc (text "case ") (appendDoc (scrutDoc (fuel - 1) env at scrut) (appendDoc (text " of") (nest 2 (appendDoc hard (altsDoc (fuel - 1) env at alts)))))
      ELet binds body recFlag _ => letDoc (fuel - 1) env at binds body
      EIf c t el _ => ifDoc (fuel - 1) env at c t el
      EApp fn args sp =>
        case tupleExprElems (EApp fn args sp) of
          Just elems => group (appendDoc (text "(") (appendDoc (nest 2 (commaDocs (map (\x => exprDoc (fuel - 1) env at x) elems))) (text ")")))
          Nothing =>
            case ascribeParts (EApp fn args sp) of
              Just (v, t) => group (appendDoc (text "(") (appendDoc (nest 2 (appendDoc (exprDoc (fuel - 1) env at v) (appendDoc (text " : ") (exprDoc (fuel - 1) env at t)))) (text ")")))
              Nothing => appDoc (fuel - 1) env at (EApp fn args sp) fn args
      EPi name implicit qty dom cod _ => piDoc (fuel - 1) env at qty implicit name dom cod
      ELam ps body _ => group (appendDoc (text ("\\" ++ joinComma (map firstOf ps) ++ " =>")) (nest 2 (appendDoc (bodySep body) (exprDoc (fuel - 1) env at body))))
      EField base f _ => appendDoc (atomDoc (fuel - 1) env at base) (text ".${f}")
      ERecord name fields _ => recordDoc (fuel - 1) env at name fields
      ERecUpdate base fields _ => recUpdateDoc (fuel - 1) env at base fields
      EDo stmts _ => appendDoc (text "do") (nest 2 (appendDoc hard (stmtsDoc (fuel - 1) env at stmts)))
      ESectOp op _ => text "(${op})"
      ESectL op inner _ => group (appendDoc (text "(${op} ") (appendDoc (exprDoc (fuel - 1) env at inner) (text ")")))
      ESectR inner op _ => group (appendDoc (text "(") (appendDoc (exprDoc (fuel - 1) env at inner) (text " ${op})")))
      EInterp multi parts _ => verbatim (interpText (fuel - 1) env at multi parts)
      _ => flatDoc env at e

-- | 内部：`case` 分支序列。
altsDoc : Int -> List FixityDecl -> FmtCtx -> List Alt -> Doc
altsDoc fuel env at alts = if fuel <= 0 then empty else vsep (map (altDoc (fuel - 1) env at) alts)

-- | 内部：单个 case 分支 `pat => body`。
altDoc : Int -> List FixityDecl -> FmtCtx -> Alt -> Doc
altDoc fuel env at alt =
  if fuel <= 0 then
    empty
  else
    let
      headD = text (renderPatGo formatFuelBound alt.altPat ++ " =>")
      bodyD = exprDoc (fuel - 1) env at alt.altBody
    in attachAt at alt.altRef (if multilineExpr alt.altBody then appendDoc headD (nest 2 (appendDoc hard bodyD)) else group (appendDoc headD (nest 2 (appendDoc line bodyD))))

-- | 内部：`let` 绑定块 + `in`。
letDoc : Int -> List FixityDecl -> FmtCtx -> List Binding -> Expr -> Doc
letDoc fuel env at binds body =
  if fuel <= 0 then
    empty
  else
    let
      bindsD = if isNilList binds then empty else appendDoc hard (vsep (map (bindingDoc (fuel - 1) env at) binds))
    in appendDoc (text "let") (appendDoc (nest 2 bindsD) (appendDoc hard (appendDoc (text "in ") (exprDoc (fuel - 1) env at body))))

-- | 内部：`if ... then ... else ...`；整段能放下时展平成一行。
ifDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Expr -> Expr -> Doc
ifDoc fuel env at c t el =
  if fuel <= 0 then
    empty
  else
    let
      blocky = multilineExpr t || multilineExpr el
      thenBreak = if blocky then hard else bodySep t
      elseBreak = if blocky then hard else line
    in group (appendDoc (text "if ") (appendDoc (scrutDoc (fuel - 1) env at c) (appendDoc (text " then") (appendDoc (nest 2 (appendDoc thenBreak (exprDoc (fuel - 1) env at t))) (appendDoc elseBreak (elsePartDoc blocky (fuel - 1) env at el))))))

-- | 内部：`else` 分支；`else if` 紧接在同一行。
elsePartDoc : Bool -> Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
elsePartDoc blocky fuel env at el =
  if fuel <= 0 then
    empty
  else
    case el of
      EIf c t el2 _ => appendDoc (text "else ") (exprDoc (fuel - 1) env at el)
      _ => appendDoc (text "else") (nest 2 (appendDoc (if blocky then hard else bodySep el) (exprDoc (fuel - 1) env at el)))

-- | 内部：应用 / 语法糖 / 中缀的分发。
appDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Expr -> List Expr -> Doc
appDoc fuel env at whole fn args =
  if fuel <= 0 then
    empty
  else if isInfixStep at whole then
    sourceInfixDoc (fuel - 1) env at whole
  else
    case appAtParts whole of
      Just (f, nm, rest) => appAtDoc (fuel - 1) env at whole f nm rest
      Nothing =>
        case handleParts whole of
          Just (comp, ret, opH) => handleDoc (fuel - 1) env at comp ret opH
          Nothing =>
            case rowAtParts whole of
              Just (lbl, nm) => flatDoc env at whole
              Nothing =>
                case performOperand whole of
                  Just op => group (appendDoc (text "perform ") (atomDoc (fuel - 1) env at op))
                  Nothing =>
                    case listExprElems whole of
                      Just elems => listDoc (fuel - 1) env at elems
                      Nothing => infixOrApply (fuel - 1) env at fn args

-- | 内部：两参符号名 / canonical 别名走中缀，其余走应用形式。
infixOrApply : Int -> List FixityDecl -> FmtCtx -> Expr -> List Expr -> Doc
infixOrApply fuel env at fn args =
  if fuel <= 0 then
    empty
  else
    case fn of
      EVar op _ =>
        if isSymbolName op then
          case args of
            [a, b] =>
              let
                fx = infixPrec env op
              in infixDoc (fuel - 1) env at (firstOf fx) (secondOf fx) op a b
            _ => applyDoc (fuel - 1) env at fn args
        else
          applyDoc (fuel - 1) env at fn args
      _ => applyDoc (fuel - 1) env at fn args

-- | 内部：普通应用；断行时每个实参一行（缩进 2）。
applyDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> List Expr -> Doc
applyDoc fuel env at fn args =
  if fuel <= 0 then
    empty
  else
    group
      (appendDoc (atomDoc (fuel - 1) env at fn) (nest 2 (hcat (map (\a => appendDoc line (atomDoc (fuel - 1) env at a)) args))))

-- | 内部：把中缀链按源码顺序摊平成「操作数表 + 运算符表」。
-- parser 把链步降级成 `EApp (EVar op) [l, r]`，这里按表面形状认出来；源码括号是链的
-- 边界：被括号包住的子链整体作为一个操作数（括号由它自己的渲染打出来）。
sourceInfixParts : FmtCtx -> Expr -> (List Expr, List String)
sourceInfixParts at (e@(EApp (EVar op _) ([l, r]) _)) =
  if isInfixStep at e then
    let
      lp = infixPartsOperand at l
      rp = infixPartsOperand at r
      label = if infixBacktick at e then "`" ++ op ++ "`" else op
    in (append (firstOf lp) (firstOf rp), append (secondOf lp) (append [label] (secondOf rp)))
  else
    ([e], [])
sourceInfixParts at e = ([e], [])

-- | 内部：链上的一个操作数；带源码括号时不再展开（括号即边界）。
infixPartsOperand : FmtCtx -> Expr -> (List Expr, List String)
infixPartsOperand at e = if parenDepth at e > 0 then ([e], []) else sourceInfixParts at e

-- | 内部：中缀链的单行渲染（操作数之间 ` op `）。
inlineInfixChain : Int -> List FixityDecl -> FmtCtx -> Expr -> Maybe String
inlineInfixChain fuel env at e =
  if fuel <= 0 then
    Nothing
  else
    case sourceInfixParts at e of
      ([], ops) => Just ""
      (first :: rest, ops) =>
        case inlinePrecGo (fuel - 1) env at 0 first of
          Nothing => Nothing
          Just s =>
            case inlineInfixTail (fuel - 1) env at ops rest of
              Nothing => Nothing
              Just tail => Just (s ++ tail)

-- | 内部：中缀链余项的单行渲染。
inlineInfixTail : Int -> List FixityDecl -> FmtCtx -> List String -> List Expr -> Maybe String
inlineInfixTail fuel env at ops elems =
  if fuel <= 0 then
    Nothing
  else
    case ops of
      [] => Just ""
      op :: restOps =>
        case elems of
          [] => Nothing
          x :: restElems =>
            case inlinePrecGo (fuel - 1) env at 0 x of
              Nothing => Nothing
              Just s =>
                case inlineInfixTail (fuel - 1) env at restOps restElems of
                  Nothing => Nothing
                  Just tail => Just (" ${op} ${s}${tail}")

-- | 内部：按源码顺序打印中缀链（不查 fixity、不补括号）。
sourceInfixDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
sourceInfixDoc fuel env at e =
  if fuel <= 0 then
    empty
  else
    case sourceInfixParts at e of
      ([], ops) => empty
      (first :: rest, ops) => group (appendDoc (exprDoc (fuel - 1) env at first) (nest 2 (sourceInfixTailDoc (fuel - 1) env at ops rest)))

-- | 内部：中缀链余项的文档（每个运算符另起一行，缩进 2）。
sourceInfixTailDoc : Int -> List FixityDecl -> FmtCtx -> List String -> List Expr -> Doc
sourceInfixTailDoc fuel env at ops elems =
  if fuel <= 0 then
    empty
  else
    case ops of
      [] => empty
      op :: restOps =>
        case elems of
          [] => empty
          x :: restElems => group (appendDoc line (appendDoc (text (op ++ " ")) (appendDoc (exprDoc (fuel - 1) env at x) (sourceInfixTailDoc (fuel - 1) env at restOps restElems))))

-- | 内部：中缀；断行时运算符在续行行首。
infixDoc : Int -> List FixityDecl -> FmtCtx -> Int -> Int -> String -> Expr -> Expr -> Doc
infixDoc fuel env at p assoc label a b =
  if fuel <= 0 then
    empty
  else
    let
      leftMin = if assoc == 0 then p else p + 1
      rightMin = if assoc == 0 then p + 1 else p
    in group (appendDoc (operandDoc (fuel - 1) env at leftMin a) (nest 2 (appendDoc line (appendDoc (text (label ++ " ")) (operandDoc (fuel - 1) env at rightMin b)))))

-- | 内部：实例名调用的后缀（`@name` / `@(expr)`）。
instanceSuffix : List FixityDecl -> FmtCtx -> Expr -> Maybe String
instanceSuffix env at nm =
  if parenDepth at nm > 0 then
    case inlineExprGo formatFuelBound env at nm of
      Just s => Just ("@" ++ s)
      Nothing => Nothing
  else
    case nm of
      EStr s _ => Just ("@" ++ instanceNameText s)
      EVar vn _ => Just ("@(" ++ vn ++ ")")
      _ =>
        case inlineExprGo formatFuelBound env at nm of
          Just ns => Just ("@(" ++ ns ++ ")")
          Nothing => Nothing

-- | 内部：实例名调用 `f@name args`。
appAtDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Expr -> Expr -> List Expr -> Doc
appAtDoc fuel env at whole f nm rest =
  if fuel <= 0 then
    empty
  else
    case instanceSuffix env at nm of
      Just sfx => group (appendDoc (atomDoc (fuel - 1) env at f) (appendDoc (text sfx) (nest 2 (hcat (map (\a => appendDoc line (atomDoc (fuel - 1) env at a)) rest)))))
      Nothing => flatDoc env at whole

-- | 内部：列表字面量。
listDoc : Int -> List FixityDecl -> FmtCtx -> List Expr -> Doc
listDoc fuel env at elems =
  if fuel <= 0 then
    empty
  else
    case elems of
      [] => text "[]"
      _ => group (appendDoc (text "[") (appendDoc (nest 2 (appendDoc soft (commaDocs (map (exprDoc (fuel - 1) env at) elems)))) (appendDoc soft (text "]"))))

-- | 内部：记录字面量 `Name { f = e, ... }`。
recordDoc : Int -> List FixityDecl -> FmtCtx -> String -> List (String, Expr) -> Doc
recordDoc fuel env at name fields =
  if fuel <= 0 then
    empty
  else
    case fields of
      [] => text "${name} { }"
      _ => group (appendDoc (text "${name} {") (appendDoc (nest 2 (appendDoc line (fieldDocs (fuel - 1) env at fields))) (appendDoc line (text "}"))))

-- | 内部：记录字段 `f = e`（逗号分隔）。
fieldDocs : Int -> List FixityDecl -> FmtCtx -> List (String, Expr) -> Doc
fieldDocs fuel env at fields =
  if fuel <= 0 then empty else commaDocs (map (fieldDoc (fuel - 1) env at) fields)

-- | 内部：单个记录字段。
fieldDoc : Int -> List FixityDecl -> FmtCtx -> (String, Expr) -> Doc
fieldDoc fuel env at (fname, value) =
  if fuel <= 0 then
    empty
  else
    group
      (appendDoc (text "${fname} =") (nest 2 (appendDoc line (exprDoc (fuel - 1) env at value))))

-- | 内部：记录更新 `{ base | f = e, ... }`。
recUpdateDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> List (String, Expr) -> Doc
recUpdateDoc fuel env at base fields =
  if fuel <= 0 then
    empty
  else
    case fields of
      [] => group (appendDoc (text "{ ") (appendDoc (atomDoc (fuel - 1) env at base) (text " }")))
      _ => group (appendDoc (text "{ ") (appendDoc (atomDoc (fuel - 1) env at base) (appendDoc (nest 2 (appendDoc line (appendDoc (text "| ") (fieldDocs (fuel - 1) env at fields)))) (appendDoc line (text "}")))))

-- | 内部：`do` 语句序列。
stmtsDoc : Int -> List FixityDecl -> FmtCtx -> List DoStmt -> Doc
stmtsDoc fuel env at stmts =
  if fuel <= 0 then empty else vsep (map (stmtDoc (fuel - 1) env at) stmts)

-- | 内部：单条 do 语句（`pat <- value` 或裸表达式）。
stmtDoc : Int -> List FixityDecl -> FmtCtx -> DoStmt -> Doc
stmtDoc fuel env at stmt =
  if fuel <= 0 then
    empty
  else
    case stmt of
      DBind pat value r =>
        let
          headD = text (renderPatGo formatFuelBound pat ++ " <-")
          valueD = exprDoc (fuel - 1) env at value
        in attachAt at r (if multilineExpr value then appendDoc headD (nest 2 (appendDoc hard valueD)) else group (appendDoc headD (nest 2 (appendDoc line valueD))))
      DExpr value r => attachAt at r (group (exprDoc (fuel - 1) env at value))
      DLet binds r =>
        attachAt at r (
            case binds of
              [b] => if inlineLetBind b then appendDoc (text "let ") (bindingDoc (fuel - 1) env at b) else letBlockDoc (fuel - 1) env at binds
              _ => letBlockDoc (fuel - 1) env at binds
          )

-- | 内部：`do` 里的 `let` 绑定块（`let` + 缩进 2 的绑定表）。
letBlockDoc : Int -> List FixityDecl -> FmtCtx -> List Binding -> Doc
letBlockDoc fuel env at binds =
  appendDoc (text "let") (nest 2 (appendDoc hard (vsep (map (bindingDoc (fuel - 1) env at) binds))))

-- 单条绑定能否写成 `let pat = value`：签名行、局部函数组与块结构值必须走绑定块，
-- 因为它们的后续行要与绑定列对齐。
-- | 内部：单条 `let` 绑定是否可以内联成 `let pat = value`。
inlineLetBind : Binding -> Bool
inlineLetBind b =
  case b.bindSig of
    Just _ => False
    Nothing =>
      case b.bindValue of
        BClauses _ => False
        BVal value => not (multilineExpr value)

-- | 内部：绑定（`name = value`，可带签名行 / 局部函数 clause）。签名行挂签名行的
-- `binding` 节点，定义行挂绑定自己的节点；局部函数组由各子句自带挂载，外层不再重复挂。
bindingDoc : Int -> List FixityDecl -> FmtCtx -> Binding -> Doc
bindingDoc fuel env at binding =
  if fuel <= 0 then
    empty
  else
    case binding.bindSig of
      Just sig =>
        let
          sigD = attachAt at sig.sigRef (text (renderPatGo formatFuelBound binding.bindPat ++ " : " ++ typeText (fuel - 1) env at sig.sigType))
          defD = bindingDefDoc (fuel - 1) env at binding.bindPat binding.bindRef binding.bindValue
        in vsep [sigD, defD]
      Nothing => bindingDefDoc (fuel - 1) env at binding.bindPat binding.bindRef binding.bindValue

-- | 内部：定义行的形态（局部函数 / λ 还原成子句 / 普通值）。
bindingDefDoc : Int -> List FixityDecl -> FmtCtx -> Pat -> NodeRef -> BindingValue -> Doc
bindingDefDoc fuel env at pat ref value =
  if fuel <= 0 then
    empty
  else
    case value of
      BClauses clauses => localFunDoc (fuel - 1) env at (renderPatGo formatFuelBound pat) clauses
      BVal inner =>
        case inner of
          ELam ps body _ => attachAt at ref (localFunDoc (fuel - 1) env at (renderPatGo formatFuelBound pat) [LocalClause (map (\p => PVar (firstOf p) (detachedNodeRef (secondOf p))) ps) body noNodeRef noNodeRef])
          _ => attachAt at ref (bindingValueDoc (fuel - 1) env at (renderPatGo formatFuelBound pat) inner)

-- | 内部：`lhs = value`（能一行就一行，否则值缩进 2）。
bindingValueDoc : Int -> List FixityDecl -> FmtCtx -> String -> Expr -> Doc
bindingValueDoc fuel env at lhs value =
  if fuel <= 0 then
    empty
  else
    let
      headD = text (lhs ++ " =")
      valueD = exprDoc (fuel - 1) env at value
    in if multilineExpr value then appendDoc headD (nest 2 (appendDoc hard valueD)) else group (appendDoc headD (nest 2 (appendDoc line valueD)))

-- | 内部：where / let 的多 clause 局部函数。
localFunDoc : Int -> List FixityDecl -> FmtCtx -> String -> List LocalClause -> Doc
localFunDoc fuel env at headText clauses =
  if fuel <= 0 then empty else vsep (map (localClauseDoc (fuel - 1) env at headText) clauses)

-- | 内部：单条局部函数 clause（注释挂在该子句的 `binding` 节点上）。
localClauseDoc : Int -> List FixityDecl -> FmtCtx -> String -> LocalClause -> Doc
localClauseDoc fuel env at headText clause =
  if fuel <= 0 then
    empty
  else
    attachAt
      at
      clause.lcRef
      (bindingValueDoc (fuel - 1) env at (headText ++ joinSpace (map renderPatAtom clause.lcPats)) clause.lcBody)

-- | 内部：`handle comp { ... }`。
handleDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Expr -> Expr -> Doc
handleDoc fuel env at comp ret op =
  if fuel <= 0 then
    empty
  else
    let
      headD = appendDoc (text "handle ") (appendDoc (handleCompDoc (fuel - 1) env at comp) (text " {"))
      retDs =
        case ret of
          ELam ([(x, _)]) body r => [handleRetDoc (fuel - 1) env at x body r]
          _ => []
      opDs =
        case op of
          ELam (_ :: _ :: (k, _) :: _) (ECase _ alts _) _ => map (handleAltDoc (fuel - 1) env at k) alts
          _ => []
      clauses = append retDs opDs
    in appendDoc headD (appendDoc (nest 2 (appendDoc hard (vsep clauses))) (appendDoc hard (text "}")))

-- | 内部：handle 的 comp：原子保持原样，复杂表达式加括号。
handleCompDoc : Int -> List FixityDecl -> FmtCtx -> Expr -> Doc
handleCompDoc fuel env at comp =
  if fuel <= 0 then
    empty
  else
    case comp of
      EVar name _ => verbatim name
      EInt n _ => verbatim (strFromInt n)
      EStr s _ => verbatim (renderStr s)
      EFloat raw _ => verbatim raw
      _ => parenInlineOrBlock (fuel - 1) env at comp

-- | 内部：`return x -> body` 子句（注释挂在子句的 `alt` 节点上）。
handleRetDoc : Int -> List FixityDecl -> FmtCtx -> String -> Expr -> NodeRef -> Doc
handleRetDoc fuel env at x body r =
  if fuel <= 0 then
    empty
  else
    attachAt
      at
      r
      (group (appendDoc (text ("return " ++ x ++ " ->")) (nest 2 (appendDoc line (exprDoc (fuel - 1) env at body)))))

-- | 内部：operator handler 子句 `Op p1 p2 k -> body`。
handleAltDoc : Int -> List FixityDecl -> FmtCtx -> String -> Alt -> Doc
handleAltDoc fuel env at k alt =
  if fuel <= 0 then
    empty
  else
    let
      parts =
        case alt.altPat of
          PCon c ps _ => (c, renderHandlePats formatFuelBound ps)
          _ => ("_", "")
      cname = firstOf parts
      patsTxt = secondOf parts
      headText = if patsTxt == "" then "${cname} ${k} ->" else "${cname} ${patsTxt} ${k} ->"
    in attachAt at alt.altRef (group (appendDoc (text headText) (nest 2 (appendDoc line (exprDoc (fuel - 1) env at alt.altBody)))))

-- | 内部：Pi 类型 `(x : A) -> B` / 隐式 `{x : A} -> B`。
piDoc : Int -> List FixityDecl -> FmtCtx -> Maybe Qty -> Bool -> String -> Expr -> Expr -> Doc
piDoc fuel env at qty implicit name dom cod =
  if fuel <= 0 then
    empty
  else
    let
      openTxt = if implicit then "{" else "("
      closeTxt = if implicit then "}" else ")"
    in group (appendDoc (text (openTxt ++ qtyPrefix qty ++ name ++ " : ")) (appendDoc (verbatim (typeText (fuel - 1) env at dom)) (appendDoc (text (closeTxt ++ " ->")) (nest 2 (appendDoc line (verbatim (typeText (fuel - 1) env at cod)))))))

-- | 内部：模板字面量原文；洞优先单行，块结构按缩进 2 拼进字面量。
interpText : Int -> List FixityDecl -> FmtCtx -> Bool -> List InterpPart -> String
interpText fuel env at multi parts =
  interpOpen multi parts
    ++ concatStrings (map (interpPieceText (fuel - 1) env at multi) parts) ++ interpClose multi

-- | 内部：单个模板片段。
interpPieceText : Int -> List FixityDecl -> FmtCtx -> Bool -> InterpPart -> String
interpPieceText fuel env at multi part =
  if fuel <= 0 then
    ""
  else
    case part of
      IPText s => renderTemplateText multi s
      IPHole e =>
        case inlinePrecGo formatFuelBound env at 0 e of
          Just s => "\${${s}}"
          Nothing => "\${${indentContinuation 2 (render maxWidth (exprDoc (fuel - 1) env at e))}}"

-- | 内部：把文本的续行统一缩进 `n` 个空格。
indentContinuation : Int -> String -> String
indentContinuation n s = join "\n" (indentLines n (splitOnNewline s))

indentLines : Int -> List String -> List String
indentLines n [] = []
indentLines n (l :: rest) = (spaces n ++ l) :: indentLines n rest

-- | 内部：显式递归预算的上界（块布局经 `map` / `concatMap` 的 λ 前进，SCT 看不到下降）。
formatFuelBound : Int
formatFuelBound = 1073741824

-- | 把表达式渲染成可断行的文档（整体是一个可展平的组）。
export renderExpr : List FixityDecl -> FmtCtx -> Expr -> Doc
renderExpr env at e = group (exprDoc formatFuelBound env at e)

-- | 渲染类型表达式：保持单行（签名 / 字段类型不折行）。
export renderTypeExpr : List FixityDecl -> FmtCtx -> Expr -> String
renderTypeExpr env at e = typeText formatFuelBound env at e

-- | 渲染绑定体 `lhs = value`。
export renderBindingValue : List FixityDecl -> FmtCtx -> String -> Expr -> Doc
renderBindingValue env at lhs value = bindingValueDoc formatFuelBound env at lhs value

-- | 把表达式按块布局渲染并用一对括号包起来。
export parenWrap : List FixityDecl -> FmtCtx -> Expr -> Doc
parenWrap env at e = blockParenDoc (exprDoc formatFuelBound env at e)

-- | 单行渲染；含块结构（case / let / do 等）时返回 `Nothing`。
export inlineExpr : List FixityDecl -> FmtCtx -> Expr -> Maybe String
inlineExpr env at e = inlineExprGo formatFuelBound env at e

-- | 按上下文最低优先级单行渲染；渲不出时返回 `Nothing`。
export inlinePrec : List FixityDecl -> FmtCtx -> Int -> Expr -> Maybe String
inlinePrec env at minPrec e = inlinePrecGo formatFuelBound env at minPrec e

-- | 渲染模式（单行，顶层位置不加外层括号）。
export renderPat : Pat -> String
renderPat pat = renderPatGo formatFuelBound pat

-- | 渲染原子位置的模式（带实参的构造子 / 记录模式 / `as` 模式加括号）。
export renderPatAtom : Pat -> String
renderPatAtom pat = renderPatAtomGo formatFuelBound pat

-- | 渲染 let / where 绑定（带签名行时先输出签名，局部函数展开成多 clause）。
export renderBinding : List FixityDecl -> FmtCtx -> Binding -> Doc
renderBinding env at binding = bindingDoc formatFuelBound env at binding

-- | 内部：section 自带括号（表面形状记的额外括号要少算一层）。
isSection : Expr -> Bool
isSection (ESectOp op _) = True
isSection (ESectL op inner _) = True
isSection (ESectR inner op _) = True
isSection _ = False

-- | 内部：字符串是否含换行。
textHasNewline : String -> Bool
textHasNewline s = scanNewline (strUnpack s)

scanNewline : List Int -> Bool
scanNewline [] = False
scanNewline (c :: rest) = c == 10 || scanNewline rest
