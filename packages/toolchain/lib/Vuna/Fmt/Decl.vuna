-- | 声明 / 模块头 / import / `infix*` 声明的打印与文件组装。
--
-- 布局约定：2 空格缩进、顶层声明之间一个空行、文件末尾一个换行、无行尾空白；
-- `infix*` 声明放在 imports 之后、第一个声明之前（源码顺序，每行一条），单独成一个
-- section（与 imports / 声明之间各空一行）；导出列表按字面文本 ASCII 字典序排序
-- （`module B` 整模块重导出排最后），超宽或含注释时逐项一行（逗号前置）。
-- where 块按 parser 的 `ELet .. True` 形态还原成 where 写法（带签名绑定先输出签名行）。
--
-- 渲染全部返回 `Doc`：缩进由 `nest` 承担，换行由最近的 `group` 决定；文件只渲染一次。
-- `env` 只用于应用位置符号名的兜底打印；fmt 门面传空表（中缀按源码顺序打印）。
module Vuna.Fmt.Decl where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Cst
import Vuna.Fmt.Comment
import Vuna.Fmt.Doc
import Vuna.Fmt.Expr
import Vuna.Fmt.Util
import Base.Data.Sort as Sort
import Base.Data.String as String

-- ---------------------------------------------------------------
-- 声明前缀
-- ---------------------------------------------------------------
-- | 内部：线性声明前缀（`linear ` / 空串）。
linearPrefix : Bool -> String
linearPrefix True = "linear "
linearPrefix False = ""

-- | 内部：声明前缀 = 表示档位前缀 + 线性前缀（如 `alias record`）。
declPrefix : ReprTier -> Bool -> String
declPrefix tier lin = reprPrefix tier ++ linearPrefix lin

-- | 模块头带来的逐定义渲染修饰：`export` / opacity 前缀与导出成员规格，均按声明名索引。
record FmtDeclMods where
  -- | 声明名 → 渲染前缀（`export ` / `export opaque ` 等；无前缀的声明不在表里）。
  fdmPrefix : List (Pair String String)
  -- | 声明名 → 导出成员规格（`(..)` / `(a, b)`）；缺省表示不带成员后缀。
  fdmMembers : List (Pair String ExportMembers)

-- | 空修饰表（无模块头或模块头没有导出声明的透明情况）。
emptyFmtDeclMods : FmtDeclMods
emptyFmtDeclMods = FmtDeclMods [] []

-- | 内部：opacity 关键字文本（`opaque ` / `transparent ` / `abstract `）。
opacityWord : Opacity -> String
opacityWord OpacityOpaque = "opaque "
opacityWord OpacityTransparent = "transparent "
opacityWord OpacityAbstract = "abstract "

-- | 内部：按名字查前缀文本（查不到为空串）。
lookupText : String -> List (Pair String String) -> String
lookupText name [] = ""
lookupText name ((Pair n p) :: rest) = if n == name then p else lookupText name rest

-- | 内部：按名字查导出成员规格。
lookupMembersText : String -> List (Pair String ExportMembers) -> Maybe ExportMembers
lookupMembersText name [] = Nothing
lookupMembersText name ((Pair n m) :: rest) =
  if n == name then Just m else lookupMembersText name rest

-- | 内部：按名字查 opacity 关键字（没有该名字的 opacity 声明时为空串）。
lookupOpacityByName : String -> List OpacitySpec -> String
lookupOpacityByName name [] = ""
lookupOpacityByName name (o :: rest) =
  if o.opacityName == name then opacityWord o.opacityKind else lookupOpacityByName name rest

-- | 内部：导出列表里是否有这个名字。
anyExportOf : String -> List ExportSpec -> Bool
anyExportOf name [] = False
anyExportOf name (e :: rest) = exportSpecName e == name || anyExportOf name rest

-- | 内部：导出项的渲染前缀：`export ` + 该名字的 opacity 关键字。
exportPrefixOf : List OpacitySpec -> ExportSpec -> Pair String String
exportPrefixOf opacity e =
  Pair (exportSpecName e) ("export " ++ lookupOpacityByName (exportSpecName e) opacity)

-- | 内部：只声明了 opacity、没有出现在导出列表里的名字（这些声明也要加前缀）。
opacityOnlyOf : List ExportSpec -> OpacitySpec -> List (Pair String String)
opacityOnlyOf exports o =
  if anyExportOf o.opacityName exports then [] else [Pair o.opacityName (opacityWord o.opacityKind)]

-- | 内部：`type T(..)` 这类导出项的成员规格（其它导出项没有成员）。
membersOfSpec : ExportSpec -> List (Pair String ExportMembers)
membersOfSpec (ESType name m sp) = [Pair name m]
membersOfSpec _ = []

-- | 内部：从模块头建立前缀 / 成员表（没有模块头时为空表）。
buildFmtDeclMods : Maybe ModDecl -> FmtDeclMods
buildFmtDeclMods Nothing = emptyFmtDeclMods
buildFmtDeclMods (Just (ModDecl _ _ _ exports _ opacity _)) =
  let
    opacityOnly = concatMap (opacityOnlyOf exports) opacity
    members = concatMap membersOfSpec exports
  in FmtDeclMods (append (map (exportPrefixOf opacity) exports) opacityOnly) members

-- | 内部：导出成员后缀（`(..)` / `(a, b)`；没有成员时为空串）。
membersSuffix : Maybe ExportMembers -> String
membersSuffix Nothing = ""
membersSuffix (Just EMNone) = ""
membersSuffix (Just EMAll) = "(..)"
membersSuffix (Just (EMOnly ms)) = "(${joinComma ms})"

-- ---------------------------------------------------------------
-- 声明渲染
-- ---------------------------------------------------------------
-- | 内部：渲染单个声明并贴上它的注释。
renderDeclAt : FmtDeclMods -> List FixityDecl -> TriviaCtx -> Decl -> Doc
renderDeclAt mods env at decl = attachAtTop at (declSpan decl) (renderDeclBody mods env at decl)

-- | 内部：声明头 + 缩进 2 的体（空体只输出头）。
bodyBlock : String -> List Doc -> Doc
bodyBlock header docs =
  if isNilList docs then
    text header
  else
    appendDoc (text header) (nest 2 (appendDoc hard (vsep docs)))

-- | 内部：`deriving` 行（顶格，空列表为空）。
derivingBlock : List Doc -> Doc
derivingBlock docs = if isNilList docs then empty else appendDoc hard (vsep docs)

-- | 内部：按声明种类分发到具体渲染。
renderDeclBody : FmtDeclMods -> List FixityDecl -> TriviaCtx -> Decl -> Doc
renderDeclBody mods env at (DData name params kind ctors derivings viaField repr lin sp) =
  let
    prefix = lookupText name mods.fdmPrefix ++ declPrefix repr lin
    members = membersSuffix (lookupMembersText name mods.fdmMembers)
    header =
      "${prefix}data ${name}${joinSpace params}${members} : ${renderTypeExpr env at kind} where"
    ctorDocs = map (renderCtorDecl env at) ctors
    derivDocs = renderDerivings viaField derivings
    bodyDocs = ctorDocs
  in appendDoc (bodyBlock header bodyDocs) (derivingBlock derivDocs)
renderDeclBody mods env at (DAxiom name ty sp) =
  text
    (lookupText name mods.fdmPrefix ++ "axiom " ++ declNameText name ++ " : " ++ renderTypeExpr env at ty)
renderDeclBody mods env at (DExtern name cName ty sp) =
  text
    (lookupText name mods.fdmPrefix ++ "extern ${name} ${strShow cName} : " ++ renderTypeExpr env at ty)
renderDeclBody mods env at (DSig name ctx ty sp) =
  text
    (lookupText name mods.fdmPrefix ++ declNameText name ++ " : " ++ renderInstanceCtx env ctx ++ renderTypeExpr env at ty)
renderDeclBody mods env at (DFun name pats body sp) = renderClause env at name pats body
renderDeclBody mods env at (DRecord name params fields derivings viaField repr lin sp) =
  let
    prefix = lookupText name mods.fdmPrefix ++ declPrefix repr lin
    members = membersSuffix (lookupMembersText name mods.fdmMembers)
    header = "${prefix}record ${name}${joinSpace params}${members} where"
    fieldDocs = map (renderRecordField env at) fields
    derivDocs = renderDerivings viaField derivings
    bodyDocs = fieldDocs
  in appendDoc (bodyBlock header bodyDocs) (derivingBlock derivDocs)
renderDeclBody mods env at (DTrait name params supers methods sp) =
  let
    members = membersSuffix (lookupMembersText name mods.fdmMembers)
    header =
      "${lookupText name mods.fdmPrefix}trait ${renderInstanceCtx env supers}${name}${joinSpace (map (traitParamText env at) params)}${members} where"
    methodDocs = map (renderMethodSig env at) methods
  in if isNilList methodDocs then
    text header
  else
    appendDoc (text header) (nest 2 (appendDoc hard (vsep methodDocs)))
renderDeclBody mods env at (DInstance ctxE head methods sp) =
  let
    headD = appendDoc (text "instance ${renderInstanceCtx env ctxE}") (renderExpr env at head)
    header = appendDoc headD (text " where")
    methodDocs = map (renderDeclAt emptyFmtDeclMods env at) methods
  in if isNilList methodDocs then
    header
  else
    appendDoc header (nest 2 (appendDoc hard (vsep methodDocs)))

-- | 内部：声明位的运算符名要带括号（`(==) : ...` / `(::) : ...`）。
declNameText : String -> String
declNameText name =
  case strUnpack name of
    c :: rest => if isNameStart c then name else "(${name})"
    [] => name

-- | 内部：字符码能否作为标识符首字符（字母或下划线）。
isNameStart : Int -> Bool
isNameStart c = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

-- | 内部：构造器行 `Ctor : Ty`（缩进 2）并贴上其注释。
renderCtorDecl : List FixityDecl -> TriviaCtx -> Ctor -> Doc
renderCtorDecl env at (Ctor cname ty arity r) =
  attachAt at (nodeRefSpan r) (text "${declNameText cname} : ${renderTypeExpr env at ty}")

-- | 内部：`deriving (...)` / `deriving via field (...)` 行（无派生项时为空）。
renderDerivings : Bool -> List String -> List Doc
renderDerivings viaField [] = []
renderDerivings viaField names =
  if viaField then
    [text "deriving via field (${joinComma names})"]
  else
    [text "deriving (${joinComma names})"]

-- | 内部：字段行 `name : Ty`（缩进 2）并贴上其注释。
renderRecordField : List FixityDecl -> TriviaCtx -> Field -> Doc
renderRecordField env at f =
  attachAt at (fieldSpan f) (text "${fieldName f} : ${renderTypeExpr env at (fieldType f)}")

-- | 内部：trait 参数文本（无 kind 时只写名字，有 kind 时 `(a : K)`）。
traitParamText : List FixityDecl -> TriviaCtx -> TraitParam -> String
traitParamText env at (TraitParam n Nothing) = n
traitParamText env at (TraitParam n (Just k)) = "(${n} : ${renderTypeExpr env at k})"

-- | 内部：trait 方法签名行 `name : Ty`（缩进 2）并贴上其注释。
renderMethodSig : List FixityDecl -> TriviaCtx -> TraitMethod -> Doc
renderMethodSig env at m =
  attachAt
    at
    (traitMethodSpan m)
    (text "${declNameText (traitMethodName m)} : ${renderTypeExpr env at m.traitMethodType}")

-- | 内部：实例上下文 `C a, C b => `（空上下文输出空串）。
renderInstanceCtx : List FixityDecl -> List Expr -> String
renderInstanceCtx env [] = ""
renderInstanceCtx env ctxE = "${joinTexts ", " (map (renderOneCtx env) ctxE)} => "

-- | 内部：用分隔串连接字符串列表（单元素不追加分隔串）。
joinTexts : String -> List String -> String
joinTexts sep [] = ""
joinTexts sep ([x]) = x
joinTexts sep (x :: rest) = x ++ sep ++ joinTexts sep rest

-- | 内部：单条上下文文本；渲不出单行时给占位 `…`。
renderOneCtx : List FixityDecl -> Expr -> String
renderOneCtx env e =
  case inlineExpr env e of
    Just s => s
    Nothing => "…"

-- | 内部：函数子句（顶层 / instance 方法 / where 绑定共用）；body 是 `ELet .. True`
-- 时按 where 形式还原。
renderClause : List FixityDecl -> TriviaCtx -> String -> List Pat -> Expr -> Doc
renderClause env at name pats body =
  let
    header = "${declNameText name}${joinSpace (map renderPatAtom pats)}"
  in case body of
    ELet binds inner recFlag sp =>
      if recFlag && not (isNilList binds) then
        let
          bodyD = group (appendDoc (text (header ++ " =")) (nest 2 (appendDoc (if multilineExpr inner then hard else line) (renderExpr env at inner))))
          bindDocs = map (renderBinding env at) binds
        in appendDoc bodyD (nest 2 (appendDoc hard (appendDoc (text "where") (nest 2 (appendDoc hard (vsep bindDocs))))))
      else
        renderBindingValue env at header body
    _ => renderBindingValue env at header body

-- ---------------------------------------------------------------
-- 顶层声明序列
-- ---------------------------------------------------------------
-- | 内部：顶层声明序列：不同函数之间一个空行；类型签名紧贴同名函数子句。
renderTopDecls : FmtDeclMods -> List FixityDecl -> TriviaCtx -> List Decl -> Doc
renderTopDecls mods env at [] = empty
renderTopDecls mods env at (d :: rest) =
  appendDoc (renderDeclAt mods env at d) (renderTopRest mods env at d rest)

-- | 内部：渲染余下声明，按 `attachDecl` 决定是否与上一条之间空行。
renderTopRest : FmtDeclMods -> List FixityDecl -> TriviaCtx -> Decl -> List Decl -> Doc
renderTopRest mods env at prev [] = empty
renderTopRest mods env at prev (d :: rest) =
  let
    sep = if attachDecl prev d then hard else appendDoc hard hard
  in appendDoc sep (appendDoc (renderDeclAt mods env at d) (renderTopRest mods env at d rest))

-- | 内部：下一条是否紧贴上一条（同名的函数子句，不空行）。
attachDecl : Decl -> Decl -> Bool
attachDecl prev (DFun n pats body sp) = declNamed prev n
attachDecl prev _ = False

-- | 内部：声明是否以该名字命名（函数子句或类型签名）。
declNamed : Decl -> String -> Bool
declNamed (DFun m pats body sp) n = m == n
declNamed (DSig m ctx ty sp) n = m == n
declNamed _ n = False

-- ---------------------------------------------------------------
-- 模块头 / import / `infix*` 声明 / 文件组装
-- ---------------------------------------------------------------
-- | 内部：模块头：显式导出列表（排序后输出）或 `module M where`。
renderModDecl : TriviaCtx -> ModDecl -> Doc
renderModDecl at (ModDecl name True items _ _ _ sp) =
  renderExplicitModDecl at name (sortExports items)
renderModDecl at (ModDecl name False items _ _ _ sp) = text "module ${name} where"

-- | 内部：显式导出列表：空列表与短列表保持单行；超宽或含项注释时逐项一行。
renderExplicitModDecl : TriviaCtx -> String -> List ExportItem -> Doc
renderExplicitModDecl at name [] = text "module ${name} () where"
renderExplicitModDecl at name sorted =
  if anyItemHasComments at sorted then
    renderExportListBlock at name sorted
  else
    group (appendDoc (text "module ${name} (") (appendDoc (commaItems at sorted) (text ") where")))

-- | 内部：导出项逐个用 `, ` 连接（展平用）。
commaItems : TriviaCtx -> List ExportItem -> Doc
commaItems at [] = empty
commaItems at ([item]) = renderExportItemDoc at item
commaItems at (item :: rest) =
  appendDoc
    (renderExportItemDoc at item)
    (appendDoc (text ",") (appendDoc line (commaItems at rest)))

-- | 内部：多行导出列表（逗号前置）：首项 `( a`，其余 `, b`，收尾 `) where`。
renderExportListBlock : TriviaCtx -> String -> List ExportItem -> Doc
renderExportListBlock at name [] = text "module ${name} () where"
renderExportListBlock at name (first :: rest) =
  appendDoc
    (text "module ${name}")
    (nest 2 (appendDoc hard (appendDoc (appendDoc (text "( ") (renderExportItemDoc at first)) (appendDoc (hcat (map (\item => appendDoc hard (appendDoc (text ", ") (renderExportItemDoc at item))) rest)) (appendDoc hard (text ") where"))))))

-- | 内部：单条导出项（贴上该项的注释）。
renderExportItemDoc : TriviaCtx -> ExportItem -> Doc
renderExportItemDoc at item = attachAt at (exportItemSpan item) (text (renderExportItem item))

-- | 内部：导出项文本（`name` / `name(..)` / `name(a, b)` / `module M`）。
renderExportItem : ExportItem -> String
renderExportItem (XBare name _) = name
renderExportItem (XTypeAll name _) = "${name}(..)"
renderExportItem (XTypeSome name members _) = "${name}(${joinComma members})"
renderExportItem (XModule name _) = "module ${name}"
renderExportItem (XNamespace name _ _) = "module ${name}"

-- | 内部：排序分组前缀（`module B` 整模块重导出 = 1，其余 = 0）。
exportRank : ExportItem -> Int
exportRank (XModule _ _) = 1
exportRank (XNamespace _ _ _) = 2
exportRank _ = 0

-- | 内部：排序键 = 分组前缀 ++ 项的字面文本（稳定排序保证幂等）。
exportKey : ExportItem -> String
exportKey item = strFromInt (exportRank item) ++ renderExportItem item

-- | 内部：字符码表的字典序比较（前缀更短者在前）。
strLeChars : List Int -> List Int -> Bool
strLeChars [] [] = True
strLeChars [] (y :: ys) = True
strLeChars (x :: xs) [] = False
strLeChars (x :: xs) (y :: ys) = x < y || (if x > y then False else strLeChars xs ys)

-- | 内部：字符串的 ASCII 字典序比较。
strLe : String -> String -> Bool
strLe a b = strLeChars (strUnpack a) (strUnpack b)

-- | 内部：导出项排序谓词（按 `exportKey`）。
exportKeyLe : ExportItem -> ExportItem -> Bool
exportKeyLe a b = strLe (exportKey a) (exportKey b)

-- | 内部：按 `exportKey` 稳定排序导出列表。
sortExports : List ExportItem -> List ExportItem
sortExports items = sortBy exportKeyLe items

-- | 内部：import 行文本：`import` + 可选 `qualified` + 模块名 + 可选 ` as 别名`。
renderImport : Import -> String
renderImport (Import name isQualified alias sp) =
  "import ${if isQualified then "qualified " else ""}${name}${aliasSuffix alias}"

-- | 内部：导入别名后缀 ` as Alias`（无别名时为空串）。
aliasSuffix : Maybe String -> String
aliasSuffix Nothing = ""
aliasSuffix (Just a) = " as ${a}"

-- | 内部：结合性关键字（`FixityDecl` 编码：1 = 左 `infixl`，2 = 右 `infixr`，其余 `infix`）。
assocKeyword : Int -> String
assocKeyword 1 = "infixl"
assocKeyword 2 = "infixr"
assocKeyword n = "infix"

-- | 内部：`infix*` 声明行，规范写法 `infixl 6 +` / `infixr 5 ::`。
renderFixityDecl : FixityDecl -> String
renderFixityDecl (FixityDecl op level assoc sp) = "${assocKeyword assoc} ${level} ${op}"

-- | 内部：单条 `infix*` 声明行（贴上该声明的注释）。
renderFixityLine : TriviaCtx -> FixityDecl -> Doc
renderFixityLine at d = attachAtTop at (fixitySpan d) (text (renderFixityDecl d))

-- | 内部：模块头 section（匿名 / 无名模块不输出）。
renderHeader : TriviaCtx -> Maybe ModDecl -> Doc
renderHeader at Nothing = empty
renderHeader at (Just m) =
  if m.modDeclName == "" then empty else attachAtTop at m.modDeclSpan (renderModDecl at m)

-- | 内部：单条 import 行（贴上该 import 的注释）。
renderImportLine : TriviaCtx -> Import -> Doc
renderImportLine at imp = attachAtTop at (importSpan imp) (text (renderImport imp))

-- | 内部：模块头里的 `export import` 重导出项（`export import` 行由它派生）。
headerReexports : Maybe ModDecl -> List ExportItem
headerReexports Nothing = []
headerReexports (Just (ModDecl _ _ _ _ reexports _ _)) = reexports

-- | 内部：import 的前缀（有别名用别名，否则用模块名）。
importPrefixText : Import -> String
importPrefixText imp =
  case imp.importAlias of
    Just alias => alias
    Nothing => imp.importName

-- | 内部：文本以 `prefix` 开头时去掉它，否则原样返回。
dropPrefixText : String -> String -> String
dropPrefixText prefix text =
  if startsWith prefix text then strPack (dropNChars (strLength prefix) (strUnpack text)) else text

-- | 内部：丢掉前 `n` 个字符。
dropNChars : Int -> List Int -> List Int
dropNChars n xs =
  if n <= 0 then
    xs
  else
    case xs of
      [] => []
      _ :: rest => dropNChars (n - 1) rest

-- | 内部：导出项是否属于该 import 前缀（整模块重导出匹配模块名，其余匹配 `prefix.`）。
itemMatchesPrefix : String -> ExportItem -> Bool
itemMatchesPrefix prefix item =
  let
    dotted = "${prefix}."
  in case item of
    XModule n _ => n == prefix
    XNamespace _ _ _ => False
    XBare n _ => startsWith dotted n
    XTypeAll n _ => startsWith dotted n
    XTypeSome n _ _ => startsWith dotted n

-- | 内部：属于该 import 的重导出项。
itemsForImport : Import -> List ExportItem -> List ExportItem
itemsForImport imp items = filter (itemMatchesPrefix (importPrefixText imp)) items

-- | 内部：选择性重导出项文本（去掉 import 前缀）。
renderSelectiveItem : String -> ExportItem -> String
renderSelectiveItem prefix item =
  let
    p = "${prefix}."
  in case item of
    XBare n _ => dropPrefixText p n
    XTypeAll n _ => "${dropPrefixText p n}(..)"
    XTypeSome n members _ => "${dropPrefixText p n}(${joinComma members})"
    XModule n _ => n
    XNamespace n _ _ => n

-- | 内部：是否整模块重导出（`module M`）。
isWholeModuleReexport : ExportItem -> Bool
isWholeModuleReexport (XModule _ _) = True
isWholeModuleReexport _ = False

-- | 内部：重导出项里是否有整模块重导出。
anyWholeModule : List ExportItem -> Bool
anyWholeModule [] = False
anyWholeModule (i :: rest) = isWholeModuleReexport i || anyWholeModule rest

-- | 内部：`export import ...` 行：整模块重导出用普通 import 形式，选择性重导出带括号列表。
renderReexportLine : Import -> List ExportItem -> String
renderReexportLine imp items =
  if anyWholeModule items then
    "export ${renderImport imp}"
  else
    "export ${renderImport imp} (${joinComma (map (renderSelectiveItem (importPrefixText imp)) items)})"

-- | 内部：是否 `export module ...` 命名空间重导出。
isNamespaceReexport : ExportItem -> Bool
isNamespaceReexport (XNamespace _ _ _) = True
isNamespaceReexport _ = False

-- | 内部：`export module C [as X]` 行。
renderNamespaceReexport : ExportItem -> String
renderNamespaceReexport (XNamespace target alias _) =
  case alias of
    Just name => "export module ${target} as ${name}"
    Nothing => "export module ${target}"
renderNamespaceReexport _ = ""

-- | 内部：import section；带重导出项的 import 渲染成 `export import` 行，
-- `export module` 行单独追加在 import 之后。
renderImportLines : TriviaCtx -> Maybe ModDecl -> List Import -> Doc
renderImportLines at hdr imports =
  let
    importDocs =
      map (
          \imp =>
            case itemsForImport imp (headerReexports hdr) of
              [] => renderImportLine at imp
              items => attachAtTop at (importSpan imp) (text (renderReexportLine imp items))
        ) imports
    nsDocs =
      map
        (\item => attachAtTop at (exportItemSpan item) (text (renderNamespaceReexport item)))
        (filter isNamespaceReexport (headerReexports hdr))
  in vsep (append importDocs nsDocs)

-- | 内部：文件末尾的注释（顶格）。
renderEofComments : List Comment -> Doc
renderEofComments comments = eofCommentsDoc comments

-- | 文件组装的五个 section：模块头 / imports / `infix*` 声明 / 声明 / 文件末尾注释；
-- 非空 section 之间空一行。
export renderSourceSections : List FixityDecl -> Maybe ModDecl -> List Import -> List FixityDecl -> List Decl -> TriviaCtx -> List Comment -> Doc
renderSourceSections env hdr imports fixities decls at eof =
  sectionsDoc
    [renderHeader at hdr, renderImportLines at hdr imports, vsep (map (renderFixityLine at) fixities), renderTopDecls (buildFmtDeclMods hdr) env at decls, renderEofComments eof]

-- | 内部：丢掉空 section，非空 section 之间空一行。
sectionsDoc : List Doc -> Doc
sectionsDoc sections = sectionsDocGo (filter (\d => not (isDocEmpty d)) sections)

sectionsDocGo : List Doc -> Doc
sectionsDocGo [] = empty
sectionsDocGo ([d]) = d
sectionsDocGo (d :: rest) = appendDoc d (appendDoc hard (appendDoc hard (sectionsDocGo rest)))

-- | 内部：表达式是否以块结构开头（绑定值要另起一行，缩进才稳定）。
multilineExpr : Expr -> Bool
multilineExpr (ELet binds body recFlag sp) = True
multilineExpr (ECase scrut alts sp) = True
multilineExpr (EDo stmts sp) = True
multilineExpr (EIf c t el sp) = multilineExpr t || multilineExpr el
multilineExpr _ = False
