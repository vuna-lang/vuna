-- | LSP 服务器：状态机、文本同步、capabilities、请求分发与 stdin 字节帧循环。
--
-- 传输 / URI / 帧在 [Vuna.Lsp.Protocol]，诊断链在 [Vuna.Lsp.Diagnostics]，各查询方法在
-- [Vuna.Lsp.Query]，模块名与局部绑定在 [Vuna.Lsp.Bindings]；本模块只持有服务器状态机：
-- initialize / initialized / shutdown / exit、textDocument/didOpen|didChange|didClose
-- （Full 同步，kind = 1）、capabilities 与 method → handler 分发。`runLsp` / `runLspTool`
-- 是 CLI 入口（由 Vuna.Cli 插入分发）。
--
-- 查询管线：hover 走洞目标 → Bindings（模块引用 / 局部绑定）→ Index 符号；definition 走
-- Bindings → Index 符号 → 同文件缓冲兜底。Bindings 是 parse 级的，不触发索引构建；模块引用
-- 与符号的 docstring 以打开中的缓冲为准（`bufferTexts`），未打开的目标才读盘，因此同一模块
-- 不会出现两个版本的文档字符串。rename / prepareRename 在 [Vuna.Lsp.Rename]；codeAction 除
-- lint quick fix 外还有洞的 case split（`refactor.rewrite`，构造子解析在 Query）与
-- `vuna.fixAllLint` command（`workspace/executeCommand` → 服务器发 `workspace/applyEdit`）。
-- semanticTokens/full 在 [Vuna.Lsp.Semantic]，documentHighlight 在 [Vuna.Lsp.Highlight]，
-- foldingRange 在 [Vuna.Lsp.Folding]。
--
-- 协议约束：stdout 只写协议帧，日志走 stderr（内存累积、退出时一次写出）；读取按
-- `Content-Length` 精确切字节（`readChunk`），不能按行读——标准 LSP 帧的 body 后面没有换行，
-- 客户端在拿到响应前也不发下一帧，行级读会在 `initialize` 互等死锁。收到 shutdown 后的 exit
-- 退 0，否则（EOF / 未 shutdown）退 1。
--
-- 缓存：打开的文档表、惰性 Index（一次构建并缓存）、日志缓冲、按内容寻址的单文件分析缓存
-- （`DocCache`：洞目标 / 诊断 suggestion / semanticTokens 结果）与诊断帧缓存。洞精化只在光标
-- 所在行有 `_` / `?name` 时触发，洞目标与 suggestion 按 (uri, 内容哈希) 复用，同一 buffer 的
-- 重复 hover / codeAction 不会每个请求重跑精化。
--
-- 已知边界：didChange 在 push 客户端上跑一次 DT 检查（同 uri + 内容命中进程内诊断帧缓存），
-- 大文件逐个按键变更可能较慢；编辑未保存的依赖模块时精化仍从磁盘读依赖；Index 只反映磁盘
-- 内容、不随 didChange 刷新（hover 的 docstring 例外），构建失败则相关方法退化返回空结果；
-- 首次索引查找可能触发全量重建，期间请求排队；本机 iface 对象缺失时洞精化退化为只精化当前
-- buffer（跨模块名字按源文本呈现）；主循环串行，`$/cancelRequest` 只能阻止尚未开始的请求；
-- 多根 workspace 未支持（workspace/symbol 用首个打开文档推断工作区根）。
module Vuna.Lsp where

import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Spec
import Vuna.Compiler.Base.Common
import Vuna.Index
import Vuna.Json
import Vuna.Json.Server
import Vuna.Lsp.Bindings
import Vuna.Lsp.Diagnostics
import Vuna.Lsp.Folding
import Vuna.Lsp.Highlight
import Vuna.Lsp.Protocol
import Vuna.Lsp.Query
import Vuna.Lsp.Rename
import Vuna.Lsp.Semantic
import Base.Effect.Console as EffConsole
import Base.Effect.Types as EffTypes
import Base.Effect.Args as EffArgs
import Base.Effect.Clock as EffClock
import Base.Effect.Env as EffEnv
import Base.Effect.Exit as EffExit
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Stdin as EffStdin
import Base.Data.Nat as Nat
import Obs as Obs
import Vuna.Compiler.Elab.Driver
import Vuna.Compiler.Elab.Term

-- ---------------------------------------------------------------
-- 常量
-- ---------------------------------------------------------------
-- | `serverInfo` 里的服务器名。
lspServerName : String
lspServerName = "vuna-lsp"

-- | `serverInfo` 里的版本号。
lspServerVersion : String
lspServerVersion = "0.3.0"

-- | `TextDocumentSyncKind.Full` 的值。
syncKindFull : Int
syncKindFull = 1

-- ---------------------------------------------------------------
-- 打开的文档表
-- ---------------------------------------------------------------
-- | 一个打开的文档。
record Doc where
  -- | 文档 URI（客户端原样给出，使用处经 `decodeUri` 解码成路径）。
  docUri : String
  -- | 客户端给的版本号（didChange 未带版本时沿用旧值）。
  docVersion : Int
  -- | 当前全文。
  docText : String

-- | 内部：按 uri 找打开的文档。
docLookup : String -> List Doc -> Maybe Doc
docLookup uri [] = Nothing
docLookup uri (d :: rest) = if d.docUri == uri then Just d else docLookup uri rest

-- | 内部：写入文档，同 uri 替换，否则追加到末尾。
docSet : Doc -> List Doc -> List Doc
docSet d [] = [d]
docSet d (x :: rest) = if x.docUri == d.docUri then d :: rest else x :: docSet d rest

-- | 内部：移除该 uri 的文档。
docRemove : String -> List Doc -> List Doc
docRemove uri [] = []
docRemove uri (x :: rest) = if x.docUri == uri then docRemove uri rest else x :: docRemove uri rest

-- ---------------------------------------------------------------
-- 服务器状态
-- ---------------------------------------------------------------
-- | 服务器状态：打开的文档、生命周期标志、惰性 Index、日志与分析缓存。
record LspState where
  -- | 打开的文档（按 uri 去重）。
  stateDocs : List Doc
  -- | 是否已收到 shutdown。
  stateShutdown : Bool
  -- | 客户端是否声明了 `textDocument.diagnostic` pull 能力。为 True 时只响应 pull 请求、
  -- 不再 push：客户端会为 push / pull 各建一个诊断集合，两套同时用会让每条诊断出现两遍。
  stateClientPull : Bool
  -- | 惰性构建的索引（`Nothing` = 尚未成功构建）。
  stateIndex : Maybe Index
  -- | 是否尝试过构建索引（失败一次后不再重试）。
  stateIndexTried : Bool
  -- | 工作区根线索：首个打开文档的 uri（`workspace/symbol` 用它推断根）。
  stateRootHint : Maybe String
  -- | 内存累积的日志行（退出时一次写出）。
  stateLogs : List String
  -- | 诊断帧 / pull 报告缓存：key = uri + 内容哈希，上限 32 条。
  stateDiagCache : List (Int, Json)
  -- | 诊断链的会话对象（跨请求复用）。
  stateDiagSession : Maybe DiagCache
  -- | 单文件分析结果缓存：key = uri + 内容哈希（文本一变即失效），上限 8 条。
  stateDocCache : List (Int, DocCache)
  -- | 已收到 `$/cancelRequest` 的请求 id：串行循环里取消只意味着「不再开始」。
  stateCanceled : List Int

-- | 同一份 buffer 内容的分析结果（惰性填充：没算过的项是 `Nothing`）。
record DocCache where
  -- | 洞目标；`Bool` = 依赖是否完整（只精化当前 buffer 的结果不能直接用于 case split）。
  dcGoals : Maybe (Bool, List DtGoalInfo)
  -- | 诊断 suggestion：`(0-based 起行, 止行)` → quickfix 动作列表。
  dcSuggestions : Maybe (List ((Int, Int), List Json))
  -- | semanticTokens/full 的结果对象（`{data:[...]}`），避免每次请求重跑词法 + parse。
  dcTokens : Maybe Json

-- | 内部：替换打开的文档表。
setDocs : List Doc -> LspState -> LspState
setDocs docs (LspState _ s pull idx tried hint logs dc dsess gs canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：设置 shutdown 标志。
setShutdown : Bool -> LspState -> LspState
setShutdown s (LspState docs _ pull idx tried hint logs dc dsess gs canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：记录客户端的 pull 诊断能力。
setClientPull : Bool -> LspState -> LspState
setClientPull pull (LspState docs s _ idx tried hint logs dc dsess gs canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：写入索引。
setIndex : Maybe Index -> LspState -> LspState
setIndex idx (LspState docs s pull _ tried hint logs dc dsess gs canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：记录是否已尝试构建索引。
setIndexTried : Bool -> LspState -> LspState
setIndexTried tried (LspState docs s pull idx _ hint logs dc dsess gs canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：仅在还没有根线索时写入。
setRootHintIfEmpty : String -> LspState -> LspState
setRootHintIfEmpty hint (LspState docs s pull idx tried (existing@(Just prev)) logs dc dsess gs canc) =
  LspState docs s pull idx tried existing logs dc dsess gs canc
setRootHintIfEmpty hint (LspState docs s pull idx tried Nothing logs dc dsess gs canc) =
  LspState docs s pull idx tried (Just hint) logs dc dsess gs canc

-- | 内部：替换诊断帧缓存。
setDiagCache : List (Int, Json) -> LspState -> LspState
setDiagCache dc (LspState docs s pull idx tried hint logs _ dsess gs canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：替换诊断会话对象。
setDiagSession : Maybe DiagCache -> LspState -> LspState
setDiagSession dsess (LspState docs s pull idx tried hint logs dc _ gs canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：替换单文件分析缓存。
setDocCache : List (Int, DocCache) -> LspState -> LspState
setDocCache gs (LspState docs s pull idx tried hint logs dc dsess _ canc) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：替换取消集合。
setCanceled : List Int -> LspState -> LspState
setCanceled canc (LspState docs s pull idx tried hint logs dc dsess gs _) =
  LspState docs s pull idx tried hint logs dc dsess gs canc

-- | 内部：前插一条诊断帧（上限 32 条）。
pushDiag : Int -> Json -> LspState -> LspState
pushDiag key frame (LspState docs s pull idx tried hint logs dc dsess gs canc) =
  LspState docs s pull idx tried hint logs (truncateCache 32 ((key, frame) :: dc)) dsess gs canc

-- | 内部：缓存 key，uri 与文本内容的哈希组合（诊断帧与洞目标共用同一口径）。
contentKeyOf : String -> String -> Int
contentKeyOf uri text = strHash uri * 1000003 + strHash text

-- | 内部：按内容 key 查单文件分析结果。
lookupDocCache : Int -> List (Int, DocCache) -> Maybe DocCache
lookupDocCache k [] = Nothing
lookupDocCache k ((k2, v) :: rest) = if k == k2 then Just v else lookupDocCache k rest

-- | 内部：替换同 key 条目（其余条目的字段保留），否则前插；上限 8 条。
upsertDocCache : Int -> DocCache -> LspState -> LspState
upsertDocCache key entry st =
  let
    rest = filter (\kv => firstOf kv /= key) st.stateDocCache
  in setDocCache (truncateCache 8 ((key, entry) :: rest)) st

-- | 内部：取已有条目，缺失给空缓存。
cacheEntryOf : Int -> LspState -> DocCache
cacheEntryOf key st =
  case lookupDocCache key st.stateDocCache of
    Just e => e
    Nothing => DocCache Nothing Nothing Nothing

-- | 内部：记下取消的请求 id（只保留最近 64 个）。
rememberCancel : Int -> LspState -> LspState
rememberCancel i st = setCanceled (takeCanceled 64 (i :: st.stateCanceled)) st

-- | 内部：取列表前 `n` 个。
takeCanceled : Int -> List Int -> List Int
takeCanceled n [] = []
takeCanceled n (x :: rest) = if n <= 0 then [] else x :: takeCanceled (n - 1) rest

-- | 内部：该请求是否已取消。
isCanceled : Int -> LspState -> Bool
isCanceled i st = containsInt i st.stateCanceled

-- | 内部：整数列表是否包含该值。
containsInt : Int -> List Int -> Bool
containsInt x [] = False
containsInt x (y :: rest) = if x == y then True else containsInt x rest

-- | 内部：派发后清掉该 id 的取消记录。
forgetCancel : Int -> LspState -> LspState
forgetCancel i st = setCanceled (filter (\x => x /= i) st.stateCanceled) st

-- | 内部：取列表前 `n` 个。
truncateCache : Int -> List a -> List a
truncateCache n [] = []
truncateCache n (x :: rest) = if n <= 0 then [] else x :: truncateCache (n - 1) rest

-- | 内部：前插一行日志。
logTo : String -> LspState -> LspState
logTo line (LspState docs s pull idx tried hint logs dc dsess gs canc) =
  LspState docs s pull idx tried hint (line :: logs) dc dsess gs canc

-- | 内部：退出时一次写出内存累积的日志（[Vuna.Lsp.Protocol] 的 `flushLogLines`）。
flushLogs : Member nConsole ConsoleOp r => LspState -> Eff r Int
flushLogs st = flushLogLines st.stateLogs

-- | 内部：首次需要索引时构建；失败一次后不再重试（避免每个请求都全量扫描磁盘）。
ensureIndex : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> LspState -> Eff r (LspState, Maybe Index)
ensureIndex uri st =
  case st.stateIndex of
    Just idx => pure (st, Just idx)
    Nothing =>
      if st.stateIndexTried then
        pure (st, Nothing)
      else
        do
          root <- workspaceRoot uri
          r <- loadOrBuild root
          case r of
            OkC idx =>
              let
                st1 = logTo "index ready: ${root}" (setIndexTried True (setIndex (Just idx) st))
              in pure (st1, Just idx)
            ErrC e =>
              let
                st1 = logTo "index unavailable: ${diagText e}" (setIndexTried True st)
              in pure (st1, Nothing)

-- | 内部：打开的文档文本（未打开 → ""）。
textForUri : String -> LspState -> String
textForUri uri st =
  case docLookup uri st.stateDocs of
    Nothing => ""
    Just d => d.docText

-- | 内部：打开中的文档 → (路径, 文本)。模块 hover / definition 用它判断模块的最新文本，避免同一
-- 模块的 docstring 在它自己的文件与引用它的文件里显示成不同版本。
bufferTexts : LspState -> List (String, String)
bufferTexts st = map docToPair st.stateDocs

-- | 内部：`Doc` → (解码后的路径, 文本)。
docToPair : Doc -> (String, String)
docToPair d = (decodeUri d.docUri, d.docText)

-- ---------------------------------------------------------------
-- capabilities（全套；含 refactor.rewrite 与 executeCommand）
-- ---------------------------------------------------------------
-- | 服务器能力声明：同步方式、各查询 provider、语义 token legend 与 pull 诊断。
serverCapabilities : Json
serverCapabilities =
  let
    legend =
      JObj
        [("tokenTypes", JArr (map JStr semanticTokenTypes)), ("tokenModifiers", JArr (map JStr semanticTokenModifiers))]
  in JObj
    [("textDocumentSync", JObj [("openClose", JBool True), ("change", JNum syncKindFull)]), ("completionProvider", JObj [("triggerCharacters", JArr [JStr "."]), ("resolveProvider", JBool False)]), ("definitionProvider", JBool True), ("referencesProvider", JBool True), ("renameProvider", JObj [("prepareProvider", JBool True)]), ("documentSymbolProvider", JBool True), ("documentFormattingProvider", JBool True), ("documentHighlightProvider", JBool True), ("foldingRangeProvider", JBool True), ("semanticTokensProvider", JObj [("legend", legend), ("full", JBool True)]), ("workspaceSymbolProvider", JBool True), ("hoverProvider", JBool True), ("codeActionProvider", JObj [("codeActionKinds", JArr [JStr "quickfix", JStr "refactor.rewrite"])]), ("executeCommandProvider", JObj [("commands", JArr [JStr fixAllLintCommand])]), ("diagnosticProvider", JObj [("interleaved", JBool False), ("workspaceDiagnostics", JBool False)])]

-- ---------------------------------------------------------------
-- 请求分发
-- ---------------------------------------------------------------
-- | 内部：`params.textDocument.uri`（缺失给 ""）。
uriOfParams : Json -> String
uriOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "uri"] params >>= jsonAsStr)

-- | 内部：`params.textDocument.version`（缺失给 0）。
versionOfParams : Json -> Int
versionOfParams params = fromMaybe 0 (jsonGetIn ["textDocument", "version"] params >>= jsonAsInt)

-- | 内部：`params.textDocument.text`（缺失给 ""）。
textOfParams : Json -> String
textOfParams params = fromMaybe "" (jsonGetIn ["textDocument", "text"] params >>= jsonAsStr)

-- | 内部：`params.position.line`（0-based；缺失给 0）。
lineOfParams : Json -> Int
lineOfParams params = fromMaybe 0 (jsonGetIn ["position", "line"] params >>= jsonAsInt)

-- | 内部：`params.position.character`（0-based；缺失给 0）。
colOfParams : Json -> Int
colOfParams params = fromMaybe 0 (jsonGetIn ["position", "character"] params >>= jsonAsInt)

-- | 内部：列表最后一个元素。
lastJson : List Json -> Maybe Json
lastJson [] = Nothing
lastJson (x :: rest) =
  case rest of
    [] => Just x
    _ => lastJson rest

-- | Full 同步下取的全文：`contentChanges` 最后一个 `text`（缺失给 ""）。
changedText : Json -> String
changedText params =
  case jsonGetIn ["contentChanges"] params >>= jsonAsArr of
    Nothing => ""
    Just changes =>
      case lastJson changes of
        Nothing => ""
        Just change => jsonStrOr "" (fromMaybe JNull (jsonGet "text" change))

-- | 内部：`initialize` 的成功响应，capabilities + serverInfo。
initializeResult : Json -> Json
initializeResult msg =
  responseOk
    (idOf msg)
    (JObj [("capabilities", serverCapabilities), ("serverInfo", JObj [("name", JStr lspServerName), ("version", JStr lspServerVersion)])])

-- | 内部：客户端是否在 `initialize` 声明了 pull 诊断能力（`textDocument.diagnostic` 是能力对象）。
-- 声明了 ⇒ 只走 pull（服务器不再 push，避免同一诊断显示两份）；没声明 ⇒ push。
clientSupportsPull : Json -> Bool
clientSupportsPull msg =
  case jsonGetIn ["params", "capabilities", "textDocument", "diagnostic"] msg of
    Just (JObj _) => True
    _ => False

-- | didOpen：登记文档并推诊断（同 uri + 内容命中缓存则不重跑精化）；pull 客户端只登记。
handleDidOpen : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleDidOpen msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    version = versionOfParams params
    text = textOfParams params
    docs = docSet (Doc uri version text) state.stateDocs
  in if state.stateClientPull then
    pure (False, setRootHintIfEmpty uri (setDocs docs state), [])
  else
    do
      pair <- diagnoseCached uri version text state
      pure (False, setRootHintIfEmpty uri (setDocs docs (firstOf pair)), [secondOf pair])

-- | didChange（Full 同步）：覆盖全文并重推诊断；pull 客户端只更新文档表。
handleDidChange : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleDidChange msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    oldVersion =
      case docLookup uri state.stateDocs of
        Nothing => 0
        Just d => d.docVersion
    version =
      case jsonGetIn ["textDocument", "version"] params >>= jsonAsInt of
        Nothing => oldVersion
        Just v => v
    text = changedText params
    docs = docSet (Doc uri version text) state.stateDocs
  in if state.stateClientPull then
    pure (False, setDocs docs state, [])
  else
    do
      pair <- diagnoseCached uri version text state
      pure (False, setDocs docs (firstOf pair), [secondOf pair])

-- | 内部：按 (uri, 内容哈希) 取诊断帧；未命中才跑完整精化并写缓存。
diagnoseCached : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => String -> Int -> String -> LspState -> Eff r (LspState, Json)
diagnoseCached uri version text state =
  let
    key = contentKeyOf uri text
  in case lookupDiag key state.stateDiagCache of
    Just frame => pure (state, frame)
    Nothing =>
      do
        result <- publishDiagnosticsCached state.stateDiagSession uri version text
        let
          frame = secondOf result
          state1 = pushDiag key frame (setDiagSession (firstOf result) state)
        in pure (state1, frame)

-- | 内部：按 key 查诊断帧。
lookupDiag : Int -> List (Int, Json) -> Maybe Json
lookupDiag key [] = Nothing
lookupDiag key ((k, v) :: rest) = if k == key then Just v else lookupDiag key rest

-- | didClose：移除文档；push 模式清空诊断（pull 客户端由客户端侧自行清理）。
handleDidClose : Json -> LspState -> (Bool, LspState, List Json)
handleDidClose msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    docs = docRemove uri state.stateDocs
  in if state.stateClientPull then
    (False, setDocs docs state, [])
  else
    (False, setDocs docs state, [publishDiagnosticsEmpty uri 0])

-- | pull diagnostics（LSP 3.17）：与 push 同一条诊断链，返回完整报告，不额外发布通知。
handlePullDiagnostics : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handlePullDiagnostics msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
    -- pull 报告与 push 帧共用一张缓存表，key 用 `pull|` 前缀区分内容域：已缓存的 push
    -- 通知帧不能当成 pull 报告返回。
    key = contentKeyOf uri ("pull|" ++ text)
  in case lookupDiag key state.stateDiagCache of
    Just report => pure (False, state, [responseOk (idOf msg) report])
    Nothing =>
      do
        result <- diagnosticsForCached state.stateDiagSession uri text
        let
          labeled = secondOf result
          report = diagReportJson uri text (secondOf labeled)
          state1 = pushDiag key report (setDiagSession (firstOf result) state)
        in pure (False, state1, [responseOk (idOf msg) report])

-- | 内部：按 (uri, 内容) 记忆化的洞目标；`allowFull` 为真时只复用依赖完整的结果，
-- 否则重算。
goalsCached : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Bool -> Bool -> LspState -> String -> String -> Eff r (LspState, List DtGoalInfo)
goalsCached allowFull allowBuild state uri text =
  let
    key = contentKeyOf uri text
    entry = cacheEntryOf key state
  in case entry.dcGoals of
    Just (complete, gs) =>
      if not allowFull || complete then
        pure (state, gs)
      else
        goalsCompute allowFull allowBuild state uri text key entry
    Nothing => goalsCompute allowFull allowBuild state uri text key entry

-- | 内部：跑一次洞精化并写回缓存（保留已有的 suggestion / token 项）。
goalsCompute : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Bool -> Bool -> LspState -> String -> String -> Int -> DocCache -> Eff r (LspState, List DtGoalInfo)
goalsCompute allowFull allowBuild state uri text key entry =
  do
    pair <- goalsForDoc allowFull allowBuild state.stateDiagSession uri text
    let
      state1 = upsertDocCache key (DocCache (Just (secondOf pair)) entry.dcSuggestions entry.dcTokens) (setDiagSession (firstOf pair) state)
    in pure (state1, secondOf (secondOf pair))

-- | 内部：诊断 suggestion（codeAction 的 quickfix 来源）按 (uri, 内容) 记忆化；同内容只跑
-- 一次诊断。
suggestionsCached : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => LspState -> String -> String -> Eff r (LspState, List ((Int, Int), List Json))
suggestionsCached state uri text =
  let
    key = contentKeyOf uri text
    entry = cacheEntryOf key state
  in case entry.dcSuggestions of
    Just sug => pure (state, sug)
    Nothing =>
      do
        pair <- suggestionsForDoc state.stateDiagSession uri text
        let
          state1 = upsertDocCache key (DocCache entry.dcGoals (Just (secondOf pair)) entry.dcTokens) (setDiagSession (firstOf pair) state)
        in pure (state1, secondOf pair)

-- | hover：洞目标（包上下文）→ 模块引用 / 局部绑定（parse 级）→ Index 符号的签名与注释。
handleHover : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleHover msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    holePair <-
      if lineHasHole text line then
        do
          gp <- goalsCached False False state uri text
          pure (firstOf gp, holeHoverFrom line col (secondOf gp))
      else
        pure (state, Nothing)
    case secondOf holePair of
      Just hover => pure (False, firstOf holePair, [responseOk (idOf msg) hover])
      Nothing => handleHoverFallback msg (firstOf holePair) uri line col text

-- | 内部：hover 的第二段，模块引用 / 局部绑定（parse 级），未命中再看 Index 符号。
handleHoverFallback : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> String -> Int -> Int -> String -> Eff r (Bool, LspState, List Json)
handleHoverFallback msg state uri line col text =
  do
    bindHover <- bindingHoverAt (bufferTexts state) uri line col text
    case bindHover of
      Just hover => pure (False, state, [responseOk (idOf msg) hover])
      Nothing =>
        do
          indexPair <- ensureIndex uri state
          let
            state1 = firstOf indexPair
            midx = secondOf indexPair
          in pure (False, state1, [responseOk (idOf msg) (symbolHoverResult (bufferTexts state) uri line col text midx)])

-- | formatting：`formatSourceWith` 成功且内容有变化 ⇒ 全文 `TextEdit`，否则空数组；
-- 格式化不需要 fixity 闭包（中缀按源码顺序打印），失败时返回空 edits。
handleFormatting : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleFormatting msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in do
    edits <- formattingEdits uri text
    pure (False, state, [responseOk (idOf msg) (JArr edits)])

-- ---------------------------------------------------------------
-- codeAction（lint quick fix；洞 case split + fix all 的 Command 形式）
-- ---------------------------------------------------------------
-- | 内部：`range.<key>.line`（0-based；缺失给 0）。Query 侧用 1-based 行 / 列，调用点统一 +1。
rangeLineOf : String -> Json -> Int
rangeLineOf key params = fromMaybe 0 (jsonGetIn ["range", key, "line"] params >>= jsonAsInt)

-- | 内部：`range.<key>.character`（0-based；缺失给 0）。
rangeCharOf : String -> Json -> Int
rangeCharOf key params = fromMaybe 0 (jsonGetIn ["range", key, "character"] params >>= jsonAsInt)

-- | 内部：`context.only` 的 CodeActionKind 列表（`Nothing` = 不限制）。
onlyKindsOf : Json -> Maybe (List String)
onlyKindsOf params =
  case jsonGetIn ["context", "only"] params >>= jsonAsArr of
    Nothing => Nothing
    Just kinds => Just (mapMaybe jsonAsStr kinds)

-- | codeAction：当前缓冲 → lint quick fix / fix all command / 洞 case split（纯查询）。洞目标与
-- 诊断 suggestion 都按 (uri, 内容) 缓存，客户端光标移动时反复请求也只有第一次付出计算成本。
handleCodeAction : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleCodeAction msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
    only = onlyKindsOf params
    startLine = rangeLineOf "start" params + 1
    startCol = rangeCharOf "start" params + 1
    endLine = rangeLineOf "end" params + 1
    endCol = rangeCharOf "end" params + 1
  in do
    goalPair <-
      if caseSplitWanted text startLine startCol endLine endCol only then
        do
          gp <- goalsCached True True state uri text
          pure (firstOf gp, Just (secondOf gp))
      else
        pure (state, Nothing)
    let
      state0 = firstOf goalPair
    in do
      suggPair <- if quickfixWanted only then suggestionsCached state0 uri text else pure (state0, [])
      let
        state1 = firstOf suggPair
      in do
        actions <- codeActionsFor (secondOf goalPair) (secondOf suggPair) uri text startLine startCol endLine endCol only
        pure (False, state1, [responseOk (idOf msg) (JArr actions)])

-- ---------------------------------------------------------------
-- workspace/executeCommand（fix all 的 command 形式）
-- ---------------------------------------------------------------
-- | 内部：服务器 → 客户端请求的 id，按 (uri, 当前文本) 派生，避免同一会话里两次 fix all 复用同一个
-- 未决 id（客户端按 id 配对响应）。
applyEditRequestId : String -> String -> String
applyEditRequestId uri text = "vuna-apply-${strFromInt (strHash (uri ++ text))}"

-- | 内部：`workspace/applyEdit` 请求帧。
applyEditFrame : String -> Json -> Json
applyEditFrame reqId edit =
  JObj
    [("jsonrpc", JStr "2.0"), ("id", JStr reqId), ("method", JStr "workspace/applyEdit"), ("params", JObj [("edit", edit)])]

-- | 内部：`arguments[0]` 的字符串值（缺失给 ""）。
firstCommandArg : List Json -> String
firstCommandArg [] = ""
firstCommandArg (arg :: rest) = fromMaybe "" (jsonAsStr arg)

-- | `workspace/executeCommand`：`vuna.fixAllLint`（arguments = [文档 uri]）重算整文档修正并经
-- `workspace/applyEdit` 推给客户端（executeCommand 的结果不会被自动应用）；未知 command
-- → -32602。
handleExecuteCommand : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleExecuteCommand msg state =
  let
    params = paramsOf msg
    command = fromMaybe "" (jsonGet "command" params >>= jsonAsStr)
    args = fromMaybe [] (jsonGet "arguments" params >>= jsonAsArr)
    uri = firstCommandArg args
    text = textForUri uri state
  in if command == fixAllLintCommand then
    do
      editR <- fixAllLintWorkspaceEdit uri text
      case editR of
        Nothing => pure (False, state, [responseOk (idOf msg) JNull])
        Just edit => pure (False, state, [applyEditFrame (applyEditRequestId uri text) edit, responseOk (idOf msg) JNull])
  else
    pure (False, state, [responseErr (idOf msg) errInvalidParams "unknown command: ${command}"])

-- | documentSymbol：当前缓冲的 AST 声明树（不要求文件已在磁盘上）。
handleDocumentSymbol : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleDocumentSymbol msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in do
    symbols <- documentSymbols uri text
    pure (False, state, [responseOk (idOf msg) (JArr symbols)])

-- | semanticTokens/full：CST 词法流 + 声明表（[Vuna.Lsp.Semantic]）；结果按 (uri, 内容) 缓存，
-- 重复请求不再重跑词法 + parse。
handleSemanticTokens : {r : Row} -> Json -> LspState -> Eff r (Bool, LspState, List Json)
handleSemanticTokens msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
    key = contentKeyOf uri text
    entry = cacheEntryOf key state
  in case entry.dcTokens of
    Just cached => pure (False, state, [responseOk (idOf msg) cached])
    Nothing =>
      let
        tokens = semanticTokensJson text
        state1 = upsertDocCache key (DocCache entry.dcGoals entry.dcSuggestions (Just tokens)) state
      in pure (False, state1, [responseOk (idOf msg) tokens])

-- | documentHighlight：局部绑定走作用域解析，顶层符号用当前文件的同名 ident token。
handleDocumentHighlight : {r : Row} -> Json -> LspState -> Eff r (Bool, LspState, List Json)
handleDocumentHighlight msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in pure (False, state, [responseOk (idOf msg) (JArr (documentHighlights line col text))])

-- | foldingRange：按行首缩进的 offside 块（[Vuna.Lsp.Folding]）。
handleFoldingRange : {r : Row} -> Json -> LspState -> Eff r (Bool, LspState, List Json)
handleFoldingRange msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    text = textForUri uri state
  in pure (False, state, [responseOk (idOf msg) (JArr (foldingRangesJson text))])

-- | definition：模块引用 / 局部绑定（parse 级）→ Index 符号 → 同文件缓冲兜底。
handleDefinition : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleDefinition msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    bindLoc <- bindingDefinitionAt (bufferTexts state) uri line col text
    case bindLoc of
      Just loc => pure (False, state, [responseOk (idOf msg) loc])
      Nothing =>
        do
          indexPair <- ensureIndex uri state
          let
            state1 = firstOf indexPair
            midx = secondOf indexPair
          in pure (False, state1, [responseOk (idOf msg) (definitionResult uri line col text midx)])

-- | references：定义位置 + Index 记录的出现位置。
handleReferences : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleReferences msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in pure (False, state1, [responseOk (idOf msg) (JArr (referencesResult uri line col text midx))])

-- | prepareRename：光标 token 的范围 + 占位名（无法改名 → null）。
handlePrepareRename : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handlePrepareRename msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in do
      json <- prepareRenameAt uri line col text midx
      pure (False, state1, [responseOk (idOf msg) json])

-- | rename：局部绑定只改当前文档；顶层符号额外改目标模块与 import 它的模块。
handleRename : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleRename msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params + 1
    col = colOfParams params + 1
    newName = fromMaybe "" (jsonGet "newName" params >>= jsonAsStr)
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in do
      json <- renameAt uri line col text newName midx
      pure (False, state1, [responseOk (idOf msg) json])

-- | completion：关键字 + 当前缓冲顶层名 + Index 符号；`.` 后按模块过滤。
handleCompletion : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleCompletion msg state =
  let
    params = paramsOf msg
    uri = uriOfParams params
    line = lineOfParams params
    col = colOfParams params
    text = textForUri uri state
  in do
    indexPair <- ensureIndex uri state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in pure (False, state1, [responseOk (idOf msg) (JArr (completionItems (bufferTexts state) text line col midx))])

-- | workspace/symbol：Index 过滤（空 query = 全部，上限 200）。
handleWorkspaceSymbol : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleWorkspaceSymbol msg state =
  let
    params = paramsOf msg
    query = fromMaybe "" (jsonGet "query" params >>= jsonAsStr)
    hint = fromMaybe "" state.stateRootHint
  in do
    indexPair <- ensureIndex hint state
    let
      state1 = firstOf indexPair
      midx = secondOf indexPair
    in pure (False, state1, [responseOk (idOf msg) (JArr (workspaceSymbols midx query))])

-- | 处理一帧，返回 (是否退出, 新状态, 待发送帧)。
--
-- 取消：主循环串行且读 stdin 是阻塞的，运行中的计算无法打断，能做的是「不再开始」——
-- `$/cancelRequest` 先记账，派发前发现该 id 已取消就直接回 RequestCancelled。
handleFrame : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Json -> LspState -> Eff r (Bool, LspState, List Json)
handleFrame msg state =
  case jsonGet "method" msg of
    Nothing => pure (False, state, []) -- 客户端对我们请求的响应：忽略
    Just m =>
      case jsonAsStr m of
        Nothing => pure (False, state, [])
        Just methodName =>
          if methodName == "$/cancelRequest" then
            handleCancel msg state
          else
            let
              reqId = idIntOf msg
            in if reqId /= 0 && isCanceled reqId state then
              pure (False, forgetCancel reqId state, [responseErr (idOf msg) errRequestCancelled "cancelled"])
            else
              do
                tok <- pure (obsSpanBegin "lsp.${methodName}" "vuna.lsp")
                r <- dispatch methodName msg state
                _ <- pure (obsSpanEnd tok)
                pure r

-- | 内部：请求 id 的整数值（非整数 / 缺失给 0）。
idIntOf : Json -> Int
idIntOf msg = fromMaybe 0 (jsonGet "id" msg >>= jsonAsInt)

-- | 记下 `$/cancelRequest` 的 id（id 不可读时忽略）。
handleCancel : {r : Row} -> Json -> LspState -> Eff r (Bool, LspState, List Json)
handleCancel msg state =
  let
    canceled = fromMaybe 0 (jsonGetIn ["params", "id"] msg >>= jsonAsInt)
    state1 = if canceled == 0 then state else rememberCancel canceled state
  in pure (False, state1, [])

-- | method 名 → handler；未知 method 回 `MethodNotFound`（`$/` 前缀的通知静默忽略）。
dispatch : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => String -> Json -> LspState -> Eff r (Bool, LspState, List Json)
dispatch "initialize" msg state =
  pure (False, setClientPull (clientSupportsPull msg) state, [initializeResult msg])
dispatch "initialized" msg state = pure (False, state, [])
dispatch "shutdown" msg state = pure (False, setShutdown True state, [responseOk (idOf msg) JNull])
dispatch "exit" msg state = pure (True, state, [])
dispatch "textDocument/didOpen" msg state = handleDidOpen msg state
dispatch "textDocument/didChange" msg state = handleDidChange msg state
dispatch "textDocument/didClose" msg state = pure (handleDidClose msg state)
dispatch "textDocument/diagnostic" msg state = handlePullDiagnostics msg state
dispatch "textDocument/hover" msg state = handleHover msg state
dispatch "textDocument/completion" msg state = handleCompletion msg state
dispatch "textDocument/definition" msg state = handleDefinition msg state
dispatch "textDocument/references" msg state = handleReferences msg state
dispatch "textDocument/prepareRename" msg state = handlePrepareRename msg state
dispatch "textDocument/rename" msg state = handleRename msg state
dispatch "textDocument/documentSymbol" msg state = handleDocumentSymbol msg state
dispatch "textDocument/semanticTokens/full" msg state = handleSemanticTokens msg state
dispatch "textDocument/documentHighlight" msg state = handleDocumentHighlight msg state
dispatch "textDocument/foldingRange" msg state = handleFoldingRange msg state
dispatch "textDocument/formatting" msg state = handleFormatting msg state
dispatch "textDocument/codeAction" msg state = handleCodeAction msg state
dispatch "workspace/executeCommand" msg state = handleExecuteCommand msg state
dispatch "workspace/symbol" msg state = handleWorkspaceSymbol msg state
-- 客户端能力注册（fileEvents 等）服务器不消费，但必须回成功，否则客户端会把注册失败刷成错误。
dispatch "client/registerCapability" msg state = pure (False, state, [responseOk (idOf msg) JNull])
dispatch "client/unregisterCapability" msg state =
  pure (False, state, [responseOk (idOf msg) JNull])
dispatch "$/cancelRequest" msg state = pure (False, state, [])
dispatch methodName msg state =
  if startsWith "$/" methodName then
    pure (False, state, [])
  else
    pure
      (False, state, [responseErr (idOf msg) errMethodNotFound "method not found: ${methodName}"])

-- ---------------------------------------------------------------
-- 主循环
-- ---------------------------------------------------------------
-- | 内部：写一帧到 stdout（stdout 只用于协议帧）。
writeStdout : Member nConsole ConsoleOp r => String -> Eff r Int
writeStdout s = fmap natToInt (consolePrint s)

-- | 内部：传输告警，丢帧 + 写日志（不回错误帧）。
lspWarn : String -> LspState -> (LspState, List Json)
lspWarn m st = (logTo m st, [])

-- | 内部：正常退出，flush 日志，收到过 shutdown 则退 0、否则退 1。
exitCodeOf : Member nConsole ConsoleOp r => LspState -> Eff r Int
exitCodeOf state =
  do
    _ <- flushLogs state
    pure (if state.stateShutdown then 0 else 1)

-- | 内部：非正常结束（stdin EOF / 传输层致命错误），flush 日志后一律退 1。
-- 不能把 `flushLogs` 的写入字节数当退出码。
abnormalExit : Member nConsole ConsoleOp r => LspState -> Eff r Int
abnormalExit state =
  do
    _ <- flushLogs state
    pure 1

-- 零参顶层值在模块初始化时求值：入口若留成零参值，任何子命令启动都会跑帧循环。
-- | LSP 入口：跑 stdin 帧循环，按退出原因给出退出码。连接循环（字节级切帧、坏帧丢弃、
-- 16 MiB / fuel 上界）在 [Vuna.Json.Server] 的 `serveConnection`，本模块只决定退出策略。
export runLsp : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nStdin StdinOp r, Member nArgs ArgsOp r => Int -> Eff r Int
runLsp _ =
  do
    outcome <-
      serveConnection
        readChunk
        writeStdout
        (\m => \s => pure (lspWarn m s))
        (\m => \s => handleFrame m s)
        (logTo "starting" (LspState [] False False Nothing False Nothing [] [] Nothing [] []))
    let
      exitM = firstOf outcome
      state = secondOf outcome
    in case exitM of
      ExitRequested => exitCodeOf state
      ExitClosed => abnormalExit state
      ExitFatal msg => abnormalExit (logTo msg state)

-- | CLI 入口：只接受位置参数为空的调用；`--stdio` 是空操作（LSP 客户端惯例会追加它，
-- 例如 vscode-languageclient 在 transport=stdio 时），由 Vuna.Cli 插入分发。
export runLspTool : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nStdin StdinOp r, Member nArgs ArgsOp r => List String -> Eff r Int
runLspTool args =
  case parseCmdArgs ["lsp"] args of
    ErrC e => lspToolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [] => runLsp 0
        _ => lspToolError "usage: vuna lsp [--stdio]"

-- | 内部：`vuna lsp` 的用法错误出口（exit 2）。写 stderr：stdout 是协议通道，
-- 客户端只会把 stderr 显示到日志面板。
lspToolError : Member nConsole ConsoleOp r => String -> Eff r Int
lspToolError msg =
  do
    _ <- consoleEprint "error: ${msg}\n"
    pure 2
