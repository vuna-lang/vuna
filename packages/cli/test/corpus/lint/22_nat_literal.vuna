-- nat-literal：表达式 / 类型 / 模式位置的闭合 Zero / Succ 链应写成 Nat 字面量。
import Base.Data.Nat as Nat

data TcErr : Nat -> Type where
  ZeroArity : TcErr Zero
  OneArity : TcErr (Succ Zero)
  TwoArity : TcErr (Succ (Succ Zero))

sig : Vec (Succ Zero) Int -> Vec (Succ (Succ Zero)) Int
sig xs = xs

open : (n : Nat) -> Vec (Succ n) Int -> Vec n Int
open n xs = xs

clause : Nat -> Int
clause (Succ Zero) = 1
clause Zero = 0
clause _ = 2

nestedPat : Nat -> Int
nestedPat n =
  (
    \m =>
      case m of
        Succ Zero => 1
        Succ k => 2
        Zero => 0
  ) n

expr : Nat
expr = Succ (Succ Zero)

bare : Nat
bare = Zero

prefixed : Nat
prefixed = Nat.Zero

partial : Nat -> Nat
partial = Succ

multi : Vec (Succ Zero) Int
multi = []

commented : Nat
commented = Succ Zero -- keep
