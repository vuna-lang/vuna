-- `vuna run` 参数透传夹具：无参数时输出 "no args"（供包夹具循环比对）；
-- 有参数时输出第一个参数（`vuna run <pkg> -- a b` 应输出 "a"）。
import Base.Effect.Exit as EffExit
import Base.Effect.Args as EffArgs
import Base.Effect.Console as EffConsole
import Base.Trait.Monad as Monad
import Base.Effect.Core as Eff

firstArg : List String -> String
firstArg [] = "no args"
firstArg (a :: _) = a

main : Eff [ConsoleOp, ExitOp, ArgsOp] Int
main = do
  args <- argsGetArgs
  consolePrint ((firstArg args) ++ "\n")
  exitWith 0
