-- Eff 是唯一动作类型；宿主原语是 `Eff [HostOp]` 叶子（`runHost` 关闭宿主行）。
-- `effTimeUs`（微秒）探针断言真实推进时间；`exitWith 0` 让 golden 只含业务输出。
import Base.Effect.Clock as EffClock
import Base.Effect.Exit as EffExit
import Base.Effect.Console as EffConsole
import Base.Effect.Host
import Base.Effect.Core as Eff

main : Eff [ConsoleOp, ClockOp, ExitOp] Int
main =
  do
    _ <- consolePrint "hi\n"
    t0 <- pure (runHost effTimeUs)
    _ <- clockSleepMicros 5000
    t1 <- pure (runHost effTimeUs)
    _ <- consolePrint (if t1 - t0 >= 3000 then "slept\n" else "early\n")
    exitWith 0
