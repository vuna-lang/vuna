# store-isolated: 断言缓存/对象库行为，使用 case 私有 store。
# 75) `vuna store gc`：缓存对象按宽限窗口 + 容量上限淘汰；包对象族 `objects/pkg/`
#     永不进入候选（包对象要靠 fetch 重建，不是缓存）。

run: sh -c 'rm -rf "$TMPDIR/gc-store"; VUNA_STORE="$TMPDIR/gc-store" "$VUNA" check "$VUNA_BASE" >/dev/null 2>&1; test "$(find "$TMPDIR/gc-store/objects/module-iface" -type f | wc -l)" -gt 0'
exit: 0
# 包对象：永远不进入候选（靠 fetch 重建，不是缓存）。
run: sh -c 'mkdir -p "$TMPDIR/gc-store/objects/pkg"; printf x >"$TMPDIR/gc-store/objects/pkg/pkgobj"; touch -d "2020-01-01" "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0
# 宽限窗口内的对象不删（默认 3600s）；包对象即使很旧也不动。
run: sh -c 'VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc'
exit: 0
out-contains: store-gc:
run: sh -c 'test -n "$(find "$TMPDIR/gc-store/objects/module-iface" -type f | head -1)" && test -f "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0
# 宽限窗口外：缓存对象被删，包对象保留。
run: sh -c 'find "$TMPDIR/gc-store/objects/module-iface" -type f -exec touch -d "2020-01-01" {} +; VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 >/dev/null 2>&1; test ! -d "$TMPDIR/gc-store/objects/module-iface" || test -z "$(find "$TMPDIR/gc-store/objects/module-iface" -type f | head -1)"; test -f "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0
# dry-run 不改盘。
run: sh -c 'VUNA_STORE="$TMPDIR/gc-store" "$VUNA" check "$VUNA_BASE" >/dev/null 2>&1; find "$TMPDIR/gc-store/objects/module-iface" -type f -exec touch -d "2020-01-01" {} +; n1=$(find "$TMPDIR/gc-store/objects/module-iface" -type f | wc -l); VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 --dry-run >/dev/null; n2=$(find "$TMPDIR/gc-store/objects/module-iface" -type f | wc -l); [ "$n1" -eq "$n2" ] && [ "$n1" -gt 0 ]'
exit: 0
# 容量上限：只留到上限以下；包对象不动。
run: sh -c 'VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 --max-size 0 >/dev/null 2>&1; test ! -d "$TMPDIR/gc-store/objects/module-iface" || test -z "$(find "$TMPDIR/gc-store/objects/module-iface" -type f | head -1)"; test -f "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0