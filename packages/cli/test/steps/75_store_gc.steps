# store-isolated: 断言缓存/包状态目录行为，使用 case 私有 store。
# 75) `vuna store gc`：先裁死项目根，再按宽限窗口 + 容量上限淘汰 `objects/` 下的缓存
#     对象（模块接口迁到包内 `.vuna/iface` 后，这里只剩遗留 kind 目录）；取包对象族
#     `objects/pkg/` 永不进入候选（包对象要靠 fetch 重建，不是缓存）。

# 遗留缓存对象 + 取包对象各一个（都很旧）。
run: sh -c 'rm -rf "$TMPDIR/gc-store"; mkdir -p "$TMPDIR/gc-store/objects/module-iface" "$TMPDIR/gc-store/objects/pkg"; printf x > "$TMPDIR/gc-store/objects/module-iface/legacy-cache"; printf x > "$TMPDIR/gc-store/objects/pkg/pkgobj"; touch -d "2020-01-01" "$TMPDIR/gc-store/objects/module-iface/legacy-cache" "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0
# 宽限窗口内的对象不删（默认 3600s 按 mtime 算，这里现造一个「新」对象）。
run: sh -c 'touch "$TMPDIR/gc-store/objects/module-iface/legacy-cache"; VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc'
exit: 0
out-contains: store-gc:
run: sh -c 'test -f "$TMPDIR/gc-store/objects/module-iface/legacy-cache" && test -f "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0
# 宽限窗口外：缓存对象被删，取包对象保留。
run: sh -c 'touch -d "2020-01-01" "$TMPDIR/gc-store/objects/module-iface/legacy-cache"; VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 >/dev/null 2>&1; test ! -d "$TMPDIR/gc-store/objects/module-iface" || test -z "$(find "$TMPDIR/gc-store/objects/module-iface" -type f | head -1)"; test -f "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0
# dry-run 不改盘。
run: sh -c 'mkdir -p "$TMPDIR/gc-store/objects/module-iface"; printf x > "$TMPDIR/gc-store/objects/module-iface/legacy-cache2"; touch -d "2020-01-01" "$TMPDIR/gc-store/objects/module-iface/legacy-cache2"; n1=$(find "$TMPDIR/gc-store/objects/module-iface" -type f | wc -l); VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 --dry-run >/dev/null; n2=$(find "$TMPDIR/gc-store/objects/module-iface" -type f | wc -l); [ "$n1" -eq "$n2" ] && [ "$n1" -gt 0 ]'
exit: 0
# 容量上限：只留到上限以下；取包对象不动。
run: sh -c 'VUNA_STORE="$TMPDIR/gc-store" "$VUNA" store gc --older-than 0 --max-size 0 >/dev/null 2>&1; test ! -d "$TMPDIR/gc-store/objects/module-iface" || test -z "$(find "$TMPDIR/gc-store/objects/module-iface" -type f | head -1)"; test -f "$TMPDIR/gc-store/objects/pkg/pkgobj"'
exit: 0