# 44h) codegen 单元级缓存：改入口后重建——依赖单元命中缓存，产物与干净重建逐字节一致。
#      夹具 $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m34_summary 复制到 $TMPDIR（不改工作树），副本内所有
#      vuna.toml 的 `vuna-base =` 行重写为 $VUNA_BASE。
#
#      **store 显式隔离**：单元缓存住在 `$VUNA_STORE/units`，而 `--jobs N` 会并行跑多个
#      case；共用默认 store 时别的 case 的桶间 GC（`unitCacheGc` 只保留当前 entry 桶）会把
#      本 case 刚写的单元删掉，第二次构建就不再有 `unit-cache-hit`（实测 flaky）。
#      这里给前两次构建一个私有 store；第三次「干净重建」再换另一个，才真的是空缓存。
run: sh -c 'rm -rf "$TMPDIR/unit-pkg" "$TMPDIR/unit-cache" "$TMPDIR/unit-store" "$TMPDIR/unit-gen1" "$TMPDIR/unit-gen2"; cp -r $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m34_summary "$TMPDIR/unit-pkg"; for mf in "$TMPDIR/unit-pkg"/*/vuna.toml; do sed -i "s|^vuna-base = .*|vuna-base = \"$VUNA_BASE\"|" "$mf"; done; cache="$TMPDIR/unit-cache"; store="$TMPDIR/unit-store"; TMPDIR="$cache" VUNA_STORE="$store" VUNA_UNIT_CACHE=1 "$VUNA" build --no-compile --out "$TMPDIR/unit-gen1" "$TMPDIR/unit-pkg/root" >/dev/null 2>&1'
# 改入口后原地重建：依赖单元命中缓存（日志含 unit-cache-hit）。
run: sh -c 'printf "\nunitProbe : Int\nunitProbe = 1\n" >> "$TMPDIR/unit-pkg/root/app/Main.vuna"; cache="$TMPDIR/unit-cache"; store="$TMPDIR/unit-store"; TMPDIR="$cache" VUNA_STORE="$store" VUNA_UNIT_CACHE=1 VUNA_LOG=debug "$VUNA" build --no-compile --out "$TMPDIR/unit-gen1" "$TMPDIR/unit-pkg/root" 2>&1 | tee "$TMPDIR/unit.log"'
out-contains: unit-cache-hit
# 独立缓存干净重建 → 产物逐字节一致。
run: sh -c 'rm -rf "$TMPDIR/unit-fresh-cache" "$TMPDIR/unit-fresh-store" "$TMPDIR/unit-gen2"; cache="$TMPDIR/unit-fresh-cache"; store="$TMPDIR/unit-fresh-store"; TMPDIR="$cache" VUNA_STORE="$store" VUNA_UNIT_CACHE=1 "$VUNA" build --no-compile --out "$TMPDIR/unit-gen2" "$TMPDIR/unit-pkg/root" >/dev/null 2>&1'
run: diff -r "$TMPDIR/unit-gen1" "$TMPDIR/unit-gen2"
