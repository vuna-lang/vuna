# 30) fmt：格式化后仍通过类型检查且幂等。
#     格式化副本放进一个带 manifest 的临时包（= corpus 包同样的 base 上下文），
#     这样 check 看到的可见性与原文件一致（无 manifest 时是 base-only 上下文）。
#     $VUNA_SUITE_ROOT/packages/compiler/test/corpus/run/01_arithmetic.vuna、$VUNA_SUITE_ROOT/packages/cli/test/corpus/fmt/run/07_wrap.vuna 等路径保留以认领夹具。
run: sh -c 'mkdir -p "$TMPDIR/fmt-pkg"; printf "[package]\nname = \"fmt-roundtrip\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" >"$TMPDIR/fmt-pkg/vuna.toml"'
for-each: $VUNA_SUITE_ROOT/packages/compiler/test/corpus/run/01_arithmetic.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/run/03_data_case.vuna $VUNA_SUITE_ROOT/packages/cli/test/corpus/fmt/run/07_wrap.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/monad/01_do_maybe.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/traits/03_deriving_show_eq_enum.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/91_symbol_method.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt/58b_case_absurd.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/53_ctor_overload_resolve.vuna
  run: sh -c 'cp "{item}" "$TMPDIR/fmt-pkg/src.vuna"; chmod u+w "$TMPDIR/fmt-pkg/src.vuna"; "$VUNA" fmt "$TMPDIR/fmt-pkg/src.vuna" >/dev/null 2>&1'
  run: "$VUNA" check "$TMPDIR/fmt-pkg/src.vuna" 2>&1
  exit: 0
  run: "$VUNA" fmt --check "$TMPDIR/fmt-pkg/src.vuna" >/dev/null 2>&1
end:
# 行字面量的非标识符实例名：`@"fs-error"` 的引号不能被 fmt 吃掉（`@fs-error` 无法再解析），
# 格式化后仍可 check，且二次 fmt 幂等。
run: sh -c 'printf "%s\n" "import Base.Effect.Core as Eff" "import Base.Effect.Fs as EffFs" "" "r : Row" "r = [FsErrorOp@\"fs-error\"]" "" "main : Int" "main = 0" > "$TMPDIR/fmt-pkg/label.vuna"'
run: "$VUNA" fmt "$TMPDIR/fmt-pkg/label.vuna" >/dev/null 2>&1
exit: 0
file-contains: $TMPDIR/fmt-pkg/label.vuna FsErrorOp@"fs-error"
run: "$VUNA" check "$TMPDIR/fmt-pkg/label.vuna" 2>&1
exit: 0
run: "$VUNA" fmt --check "$TMPDIR/fmt-pkg/label.vuna" >/dev/null 2>&1
exit: 0
# handle 语法的 fmt 往返：格式化后仍能 check，且二次 fmt 幂等。
for-each: $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/76_eff_handle_syntax.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/77_eff_handle_answer.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/78_eff_handle_state.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/79_eff_handle_reader.vuna $VUNA_SUITE_ROOT/packages/compiler/test/corpus/dt_base/80_eff_handle_unknown_row.vuna
  run: sh -c 'cp "{item}" "$TMPDIR/fmt-pkg/handle.vuna"; chmod u+w "$TMPDIR/fmt-pkg/handle.vuna"; "$VUNA" fmt "$TMPDIR/fmt-pkg/handle.vuna" >/dev/null 2>&1'
  exit: 0
  run: "$VUNA" check "$TMPDIR/fmt-pkg/handle.vuna" 2>&1
  exit: 0
  run: "$VUNA" fmt --check "$TMPDIR/fmt-pkg/handle.vuna" >/dev/null 2>&1
  exit: 0
end:
