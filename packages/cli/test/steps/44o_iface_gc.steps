# store-isolated: 断言缓存/包状态目录行为，使用 case 私有 store 与状态目录。
# 44o) 接口不落树内可见产物路径（`.output/iface` / `*.iface` / `.vuna-iface`）：
#      默认落在包内 `.vuna/iface`（`VUNA_PKG_STATE` 可整体重定向），共享 store 里不再有
#      `objects/module-iface`（那只留给遗留清理）。
run: sh -c 'rm -rf "$TMPDIR/44o-pkg" "$TMPDIR/44o-store" "$TMPDIR/44o-cache"; cp -R $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m34_iface_audit "$TMPDIR/44o-pkg"'
run: sh -c 'for mf in "$TMPDIR/44o-pkg"/*/vuna.toml; do sed "s|vuna-base = \"[^\"]*\"|vuna-base = \"$VUNA_BASE\"|" "$mf" > "$mf.tmp" && mv "$mf.tmp" "$mf"; done'
# 不设 `VUNA_PKG_STATE`：状态落在包目录自己的 `.vuna`。
run: sh -c 'env -u VUNA_PKG_STATE VUNA_STORE="$TMPDIR/44o-store" TMPDIR="$TMPDIR/44o-cache" "$VUNA" check "$TMPDIR/44o-pkg/dep"'
exit: 0
run: sh -c 'find "$TMPDIR/44o-pkg" -name "*.iface" -o -name ".vuna-iface" | wc -l | tr -d " "'
out-equals: 0
run: sh -c 'test ! -d "$TMPDIR/44o-pkg/dep/.output/iface"; echo ok'
out-equals: ok
# 默认状态目录在包内：接口按地址平铺在 `.vuna/iface`。
run: sh -c 'test -d "$TMPDIR/44o-pkg/dep/.vuna/iface"; echo state-ok'
out-equals: state-ok
# 共享 store 不再承接接口对象。
run: sh -c 'test ! -d "$TMPDIR/44o-store/objects/module-iface"; echo store-clean'
out-equals: store-clean
# 读路径与写路径同一口径：不设 `VUNA_PKG_STATE` 时第二次 check 命中包内接口
# （摘要路径 + 本包模块干净），不从模块根（`lib/`）推导状态目录。
run: sh -c 'env -u VUNA_PKG_STATE VUNA_STORE="$TMPDIR/44o-store" TMPDIR="$TMPDIR/44o-cache" VUNA_LOG=debug "$VUNA" check "$TMPDIR/44o-pkg/dep"'
exit: 0
out-contains: cache-path=summary
out-contains: cache-own-clean=
out-not-contains: cache-path=full
out-not-contains: iface-reject=dep-iface-missing