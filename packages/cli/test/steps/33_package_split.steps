# 33) 包级 split：`vuna compile <pkg> OUTDIR` 走 DT 逐模块 codegen
#     → OUTDIR/<Module>.ml... + Main.ml + build.sh；build.sh 增量编译（无改动不重编；
#     改内容只重编受影响者）。入口 data 也在产物 Main.ml 里。
#     每单元只 `open Vuna_runtime`（无 open 链），跨单元引用全限定（`Unit.name`）；
#     build.sh 末尾的 `VUNA_UNIT_TABLE` 每行只列直接依赖与并行层（`@`），层内并行、
#     每模块 stamp 只含直接依赖。
#     夹具 $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/[01][0-9]_*/ 先复制到 case 私有 $TMPDIR 并重写 vuna-base。
for-each: $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/[01][0-9]_*/
  run: mkdir -p "$TMPDIR/pkgs"; dst="$TMPDIR/pkgs/{name}"; rm -rf "$dst"; cp -R "$VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/{name}" "$dst"; find "$dst" -name vuna.toml -exec sed -i 's|^vuna-base = .*|vuna-base = "'"$VUNA_BASE"'"|' {} +
  exit: 0
  run: "$VUNA" compile "$TMPDIR/pkgs/{name}" "$TMPDIR/split-{name}" 2>&1
  exit: 0
  file-exists: $TMPDIR/split-{name}/Main.ml
  file-exists: $TMPDIR/split-{name}/build.sh
  run: bad=$(for ml in "$TMPDIR/split-{name}"/*.ml; do case "$(basename "$ml")" in Vuna_runtime.ml) continue ;; esac; grep -H '^open ' "$ml" 2>/dev/null | grep -v 'open Vuna_runtime$'; done | sed -n '1,3p'); [ -z "$bad" ] || { printf '%s\n' "$bad"; exit 1; }
  exit: 0
  run: cd "$TMPDIR/split-{name}" && mkdir -p bin && sh build.sh bin/prog 2>&1
  exit: 0
  run: "$TMPDIR/split-{name}/bin/prog" 2>&1
  exit: 0
  out-equals-file: $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/{name}/expected.out
end:
# 入口 data 必须进 split 产物 Main.ml（$VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/05_entry_data / 06_entry_trait）。
for-each: $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/05_entry_data/ $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/06_entry_trait/
  run: sh -c 'test -f "$TMPDIR/split-{name}/Main.ml"'
  exit: 0
  file-contains: $TMPDIR/split-{name}/Main.ml C_Color_Red
end:
# 增量构建行为用 $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/01_workspace 的副本验证（编译单元 = sanitizeName 后模块名）。
run: cd "$TMPDIR/split-01_workspace" && sh build.sh bin/prog 2>&1
exit: 0
out-not-contains: compile
run: printf '\n(* incremental probe *)\n' >>"$TMPDIR/split-01_workspace/Vuna_dHello.ml"
exit: 0
run: cd "$TMPDIR/split-01_workspace" && sh build.sh bin/prog 2>&1
exit: 0
out-contains: compile Vuna_dHello
out-not-contains: compile Vuna_runtime
out-not-contains: compile Dep
out-not-contains: compile Prelude
out-not-contains: compile Base_dIO
# 跨单元引用必须是 OCaml 限定名 `Unit.name`（不用 open 链写裸名）。
read: $TMPDIR/split-01_workspace/Main.ml
out-contains: Vuna_dHello.v_hello
out-contains: Dep.v_depText
out-contains: Dep.C_DepTag_DepTagA
out-contains: dtp_sched_main
run: grep -hoE '[A-Z][A-Za-z0-9_]*\.C_[A-Za-z0-9_]+' "$TMPDIR/split-01_workspace"/*.ml | sed -n '1,3p'
out-contains: .C_
run: sh -c '! grep -qE "(^|[^A-Za-z0-9_.])v_hello" "$TMPDIR/split-01_workspace/Main.ml"'
exit: 0
run: sh -c '! grep -qE "(^|[^A-Za-z0-9_.])C_DepTag_DepTagA" "$TMPDIR/split-01_workspace/Main.ml"'
exit: 0
# build.sh 的单元表只列直接依赖（Vuna_dHello 只列 Vuna_runtime）。
run: grep -E '^Vuna_dHello( |$)' "$TMPDIR/split-01_workspace/build.sh"
out-equals: Vuna_dHello Vuna_runtime
run: ml=$(ls "$TMPDIR/split-01_workspace"/*.ml | wc -l); u=$(awk '/done <<.VUNA_UNIT_TABLE.$/{t=1;next} /^VUNA_UNIT_TABLE$/{t=0} t&&!/^@$/{n++} END{print n+0}' "$TMPDIR/split-01_workspace/build.sh"); [ "$ml" = "$u" ]
exit: 0
# 单元表由 each_unit 逐层驱动：层内 `&`，层末逐个 wait。
read: $TMPDIR/split-01_workspace/build.sh
out-contains: each_unit parallel
out-contains: wait "$p"