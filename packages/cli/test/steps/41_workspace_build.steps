# 41) workspace 检查/构建单元 + 确定性/增量构建
run: "$VUNA" check $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m30_ws_member_error 2>&1
exit: nonzero
out-contains: [bad]
run: "$VUNA" build --out "$TMPDIR/ws1" $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m30_ws_build 2>&1
exit: 0
out-contains: skipped (library): member
run: "$TMPDIR/ws1/ws-build/bin/ws-build" 2>&1
exit: 0
out-equals: "hello from member"
run: "$VUNA" build --out "$TMPDIR/ws1" $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m30_ws_build 2>&1
out-contains: up to date:
run: "$VUNA" build --package member --out "$TMPDIR/ws-pkg" $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m30_ws_build 2>&1
exit: 0
out-contains: skipped (library): member
run: sh -c '"$VUNA" build --out "$TMPDIR/ws2" $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m30_ws_build >/dev/null 2>&1 && for f in "$TMPDIR/ws1/ws-build"/*.ml "$TMPDIR/ws1/ws-build/build.sh" "$TMPDIR/ws1/ws-build/build-meta.json"; do cmp -s "$f" "$TMPDIR/ws2/ws-build/$(basename "$f")" || exit 1; done'
exit: 0
# examples/multi：多包 workspace（根包 + 成员库 + base 路径依赖）的 build/test/fmt/doc 冒烟。
# 复制到 case 私有目录并重写 vuna-base 绝对路径，避免往仓库工作树写 .output。
run: rm -rf "$TMPDIR/multi"; cp -R $VUNA_SUITE_ROOT/examples/multi "$TMPDIR/multi"; find "$TMPDIR/multi" -name vuna.toml -exec sed -i 's|^vuna-base = .*|vuna-base = "'"$VUNA_BASE"'"|' {} +
exit: 0
run: "$VUNA" build "$TMPDIR/multi" 2>&1
exit: 0
run: "$TMPDIR/multi/.output/bin/multi" 2>&1
exit: 0
out-equals: hi hi hi|n2 n1
run: "$VUNA" test "$TMPDIR/multi" 2>&1
exit: 0
out-contains: 1 passed, 0 failed
run: "$VUNA" fmt --check "$TMPDIR/multi" 2>&1
exit: 0
run: "$VUNA" doc "$TMPDIR/multi/greet" "$TMPDIR/api.html" 2>&1
exit: 0
run: grep -q Greet "$TMPDIR/api.html"
exit: 0

# 虚拟 workspace 根（只有 [workspace]，没有 [package]）：check/build/run/test/fmt/lint/doc
# 都按成员展开；根自己的 [lint] 被成员继承。
run: rm -rf "$TMPDIR/vws"; cp -R $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m40_virtual_ws "$TMPDIR/vws"; find "$TMPDIR/vws" -name vuna.toml -exec sed -i 's|^vuna-base = .*|vuna-base = "'"$VUNA_BASE"'"|' {} +
exit: 0
run: "$VUNA" check "$TMPDIR/vws" 2>&1
exit: 0
out-not-contains: [PKG_
run: "$VUNA" build --out "$TMPDIR/vws-out" "$TMPDIR/vws" 2>&1
exit: 0
out-contains: skipped (library): wmlib
run: "$TMPDIR/vws-out/wmapp/bin/wmapp" 2>&1
exit: 0
out-contains: hello from wmapp
run: "$VUNA" run "$TMPDIR/vws" -- 2>&1
exit: 0
out-contains: hello from wmapp
run: "$VUNA" test "$TMPDIR/vws" 2>&1
exit: 0
out-contains: workspace: 2 package(s)
out-contains: 1 passed, 0 failed
run: "$VUNA" fmt --check "$TMPDIR/vws" 2>&1
exit: 0
run: "$VUNA" lint "$TMPDIR/vws" 2>&1
exit: 0
run: "$VUNA" doc "$TMPDIR/vws" "$TMPDIR/vws-api.html" 2>&1
exit: 0
file-contains: $TMPDIR/vws-api.html WmLib
# 单成员虚拟根：test 走单包路径，不做 workspace 聚合。
run: rm -rf "$TMPDIR/vone"; cp -R $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m41_virtual_ws_single "$TMPDIR/vone"; find "$TMPDIR/vone" -name vuna.toml -exec sed -i 's|^vuna-base = .*|vuna-base = "'"$VUNA_BASE"'"|' {} +
exit: 0
run: "$VUNA" check "$TMPDIR/vone" 2>&1
exit: 0
run: "$VUNA" test "$TMPDIR/vone" 2>&1
exit: 0
out-not-contains: workspace:
out-contains: 1 passed, 0 failed
# 负例：既没有 [package] 也没有 [workspace]。
run: sh -c 'rm -rf "$TMPDIR/vbad1"; mkdir -p "$TMPDIR/vbad1"; : > "$TMPDIR/vbad1/vuna.toml"; "$VUNA" check "$TMPDIR/vbad1" 2>&1'
exit: 1
out-contains: PKG_MissingPackageName
# 负例：虚拟根没有 members。
run: sh -c 'rm -rf "$TMPDIR/vbad2"; mkdir -p "$TMPDIR/vbad2"; printf "[workspace]\nmembers = []\n" > "$TMPDIR/vbad2/vuna.toml"; "$VUNA" check "$TMPDIR/vbad2" 2>&1'
exit: 1
out-contains: PKG_EmptyWorkspace
# 负例：虚拟根不能声明包语义段（不静默忽略）。
run: sh -c 'rm -rf "$TMPDIR/vbad3"; mkdir -p "$TMPDIR/vbad3"; printf "[workspace]\nmembers = [\"x\"]\n\n[dependencies]\ny = \"../y\"\n" > "$TMPDIR/vbad3/vuna.toml"; "$VUNA" check "$TMPDIR/vbad3" 2>&1'
exit: 1
out-contains: PKG_PackageSectionInWorkspaceRoot
# 负例：虚拟根不能当包使用（compile 的目录入口要求可执行包）。
run: "$VUNA" compile "$TMPDIR/vws" "$TMPDIR/vws-c" 2>&1
exit: 1
out-contains: PKG_NotPackage
