# 76) 共享对象库：同一 VUNA_STORE 连续 check 复用 module-iface，且对象落盘。
#     本 case 自己指定临时 store（不依赖 suite 状态），验证 runner 透传的
#     VUNA_STORE 可被命令行覆盖。
run: sh -c 'rm -rf "$TMPDIR/share-store" "$TMPDIR/share-pkg"; mkdir -p "$TMPDIR/share-pkg/app"; printf "[package]\nname = \"share-pkg\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$TMPDIR/share-pkg/vuna.toml"; printf "main : Int\nmain = 1\n" > "$TMPDIR/share-pkg/app/Main.vuna"'
exit: 0
run: sh -c 'VUNA_STORE="$TMPDIR/share-store" "$VUNA" check "$TMPDIR/share-pkg" >/dev/null 2>&1'
exit: 0
run: sh -c 'n1=$(find "$TMPDIR/share-store/objects" -type f | wc -l); VUNA_STORE="$TMPDIR/share-store" "$VUNA" check "$TMPDIR/share-pkg" >/dev/null 2>&1; n2=$(find "$TMPDIR/share-store/objects" -type f | wc -l); [ "$n1" -eq "$n2" ] && [ "$n1" -gt 0 ]'
exit: 0

# 两个内容相同的包目录（一个 store）：模块接口按输入地址复用。
run: sh -c 'S="$TMPDIR/uni"; rm -rf "$S"; mkdir -p "$S/a/app" "$S/b/app"; for d in a b; do mkdir -p "$S/$d/lib"; printf "[package]\nname = \"uni\"\n[export]\nmodules = [\"M\"]\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$S/$d/vuna.toml"; printf "module M where\n\nexport one : Int\none = 1\n" > "$S/$d/lib/M.vuna"; printf "import M\n\nmain : Int\nmain = one\n" > "$S/$d/app/Main.vuna"; done'
exit: 0
run: sh -c 'S="$TMPDIR/uni"; VUNA_STORE="$S/store" "$VUNA" check "$S/a" >/dev/null 2>&1; n1=$(find "$S/store/objects/module-iface" -type f | wc -l); VUNA_STORE="$S/store" "$VUNA" check "$S/b" >/dev/null 2>&1; n2=$(find "$S/store/objects/module-iface" -type f | wc -l); [ "$n1" -gt 0 ] && [ "$n1" -eq "$n2" ]'
exit: 0

# 默认 build 写入当前包目录的 `.output`（真目录，不是共享视图）。
run: sh -c 'S="$TMPDIR/uni"; VUNA_STORE="$S/store" "$VUNA" build "$S/a" >/dev/null 2>&1; test -x "$S/a/.output/bin/uni"; test ! -L "$S/a/.output"'
exit: 0
run: sh -c 'S="$TMPDIR/uni"; VUNA_STORE="$S/store" "$VUNA" build "$S/a" 2>&1 | grep -q "up to date"'
exit: 0

# 项目根裁剪：legacy（无 `.project`）与目录已消失的项目根都被删；活项目保留。
run: sh -c 'S="$TMPDIR/uni"; store="$S/store"; mkdir -p "$store/roots/live-root"; printf "%s" "$S/a" > "$store/roots/live-root/.project"; mkdir -p "$store/roots/legacy-root"; : > "$store/roots/legacy-root/deadbeef"; mkdir -p "$store/roots/gone-root"; printf "%s" "$S/does-not-exist" > "$store/roots/gone-root/.project"; : > "$store/roots/gone-root/deadbeef"; VUNA_STORE="$store" "$VUNA" store gc 2>&1 | grep -q "2 dead project root(s)"; test ! -e "$store/roots/legacy-root" && test ! -e "$store/roots/gone-root" && test -d "$store/roots/live-root"'
exit: 0

# 默认根：`VUNA_STORE` 未设 ⇒ `$HOME/.vuna/store`（`XDG_DATA_HOME` 也未设）。
run: sh -c 'S="$TMPDIR/uni"; H="$S/home"; rm -rf "$H"; mkdir -p "$H"; env -u VUNA_STORE -u XDG_DATA_HOME HOME="$H" "$VUNA" check "$S/b" >/dev/null 2>&1; test -n "$(find "$H/.vuna/store/objects" -type f | head -1)"'
exit: 0