# store-isolated: 断言缓存/对象库行为，使用 case 私有 store。
# 77) 并发安全：同一输入的两个 `check` 进程同时写共享 store（模块接口是输入寻址 + 原子写）。
run: sh -c 'rm -rf "$TMPDIR/con-pkg" "$TMPDIR/con-store"; mkdir -p "$TMPDIR/con-pkg/lib" "$TMPDIR/con-pkg/app"; printf "[package]\nname = \"con-pkg\"\n[export]\nmodules = [\"M\"]\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$TMPDIR/con-pkg/vuna.toml"; printf "module M where\n\nexport one : Int\none = 1\n" > "$TMPDIR/con-pkg/lib/M.vuna"; printf "import M\n\nmain : Int\nmain = one\n" > "$TMPDIR/con-pkg/app/Main.vuna"'
exit: 0
run: sh -c 'VUNA_STORE="$TMPDIR/con-store" "$VUNA" check "$TMPDIR/con-pkg" >/dev/null 2>&1 & p1=$!; VUNA_STORE="$TMPDIR/con-store" "$VUNA" check "$TMPDIR/con-pkg" >/dev/null 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; [ "$r1" -eq 0 ] && [ "$r2" -eq 0 ]'
exit: 0
run: sh -c 'test -n "$(find "$TMPDIR/con-store/objects/module-iface" -type f | head -1)"; VUNA_STORE="$TMPDIR/con-store" "$VUNA" check "$TMPDIR/con-pkg" >/dev/null 2>&1'
exit: 0