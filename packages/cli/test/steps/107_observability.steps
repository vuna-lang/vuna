# 107) 可观测性（`docs/reference/observability.md`）：语言层 obs 原语 + 生成运行时 +
#      `vuna dev obs` 工具链 + `#line` 注入。依赖 PATH 里的 readelf（devShell/e2e 已提供）。
#
# 覆盖：关闭口径不产 trace；`log!` 文本日志与 `mark!` 结构化事件各自独立；
# `VUNA_OBS=2` trace 的结构与 `obs validate`；`#line` 是包相对 `.vuna` 路径、产物可跑；
# DWARF `.debug_line` 指向 `.vuna`；运行时错误回栈落到 `.vuna`；`VUNA_OBS=3` 采样；
# convert（cpuprofile/folded/speedscope）与 render 的确定性；summarize --json / --baseline；
# 非 OCaml 后端：叶子原语 no-op 桩；wasm / native 的 obsSpan 直接应用 thunk 并返回值。

run: command -v readelf
exit: 0

# ---------------------------------------------------------------- fixtures
# 一个带 obs span 的可执行包（多条断言复用）。
run: sh -c 'd="$TMPDIR/app"; mkdir -p "$d/app"; printf "[package]\nname = \"obsapp\"\n\n[dependencies]\nvuna-base = \"%s\"\nvuna-obs = \"%s\"\n" "$VUNA_BASE" "$VUNA_OBS_PKG" > "$d/vuna.toml"; printf "import Obs as ObsSpan\n\nmain : Int\nmain = obsSpan \"app.work\" \"vuna.user\" (\\_ => 7)\n" > "$d/app/Main.vuna"; "$VUNA" build --out "$TMPDIR/app-out" "$d"'
exit: 0
file-exists: $TMPDIR/app-out/bin/obsapp

# 宏夹具：log! 文本与 mark! 事件同时出现。
run: sh -c 'd="$TMPDIR/mac"; mkdir -p "$d/app"; printf "[package]\nname = \"mac\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain =\n  let\n    _ = log! \"debug\" \"legacy\"\n    _ = log! \"info\" \"structured\"\n    _ = mark! \"checkpoint\"\n  in 0\n" > "$d/app/Main.vuna"; "$VUNA" build --out "$TMPDIR/mac-out" "$d"'
exit: 0

# let 组夹具（`#line` 在 `let rec` / `and` 上也要写）。
run: sh -c 'd="$TMPDIR/grp"; mkdir -p "$d/app"; printf "[package]\nname = \"grp\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "import Base.Data.Nat as Nat\n\neven : Nat -> Bool\neven n = case n of\n  Zero => True\n  Succ k => odd k\n\nodd : Nat -> Bool\nodd n = case n of\n  Zero => False\n  Succ k => even k\n\nmain : Int\nmain = if even (Succ (Succ (Succ (Succ Zero)))) then 1 else 0\n" > "$d/app/Main.vuna"; "$VUNA" compile "$d" "$TMPDIR/grp-split"'
exit: 0

# ---------------------------------------------------------------- 1) 关闭口径
run: sh -c 'unset VUNA_OBS; VUNA_OBS_DIR="$TMPDIR/trace-unset" "$TMPDIR/app-out/bin/obsapp"'
exit: 0
out-equals: 7
run: sh -c 'test ! -e "$TMPDIR/trace-unset" || test -z "$(find "$TMPDIR/trace-unset" -type f 2>/dev/null)"'
exit: 0

run: sh -c 'VUNA_OBS=0 VUNA_OBS_DIR="$TMPDIR/trace-zero" "$TMPDIR/app-out/bin/obsapp"'
exit: 0
out-equals: 7
run: sh -c 'test ! -e "$TMPDIR/trace-zero" || test -z "$(find "$TMPDIR/trace-zero" -type f 2>/dev/null)"'
exit: 0

# 打开必须产出（反证上面两条不是「从来没工作」）。
run: sh -c 'VUNA_OBS=1 VUNA_OBS_DIR="$TMPDIR/trace-on" "$TMPDIR/app-out/bin/obsapp"'
exit: 0
out-equals: 7
run: sh -c 'find "$TMPDIR/trace-on" -name "*.jsonl" -type f | head -1'
exit: 0
out-contains: vuna-

# ---------------------------------------------------------------- 2) log! 文本 / mark! 事件
run: sh -c 'VUNA_LOG=debug VUNA_OBS=0 "$TMPDIR/mac-out/bin/mac" 2>&1 >/dev/null'
exit: 0
out-contains: DEBUG Main legacy
out-contains: INFO Main structured

run: sh -c 'VUNA_OBS=2 VUNA_OBS_DIR="$TMPDIR/mac-trace" "$TMPDIR/mac-out/bin/mac" 2>/dev/null'
exit: 0
run: sh -c 'grep -l "checkpoint" "$TMPDIR"/mac-trace/*.jsonl'
exit: 0

# ---------------------------------------------------------------- 3) 结构 + validate
run: sh -c '"$VUNA" dev obs validate "$TMPDIR"/mac-trace/*.jsonl'
exit: 0
out-contains: verified

run: sh -c 'head -1 "$TMPDIR"/mac-trace/*.jsonl'
exit: 0
out-contains: "ph":"M"
out-contains: "schema":"vuna-obs 1"

# 人为破坏：倒挂时间戳拒绝（exit 1，消息可读）。
run: sh -c 'printf "%s\n" "{\"ph\":\"M\",\"name\":\"vuna.obs.schema\",\"pid\":1,\"tid\":0,\"args\":{\"schema\":\"vuna-obs 1\"}}" "{\"ph\":\"i\",\"ts\":200,\"pid\":1,\"tid\":0,\"name\":\"vuna.mark.probe\"}" "{\"ph\":\"i\",\"ts\":100,\"pid\":1,\"tid\":0,\"name\":\"vuna.mark.probe\"}" > "$TMPDIR/bad-order.jsonl"; "$VUNA" dev obs validate "$TMPDIR/bad-order.jsonl"'
exit: 1
out-contains: goes backwards

# ---------------------------------------------------------------- 4) #line
run: sh -c 'grep -cE "^# [0-9]+ \"[^\"]*[.]vuna\"" "$TMPDIR/grp-split/Main.ml"'
exit: 0
run: sh -c 'grep -cE "^# [0-9]+ \"/" "$TMPDIR/grp-split/Main.ml" || true'
exit: 0
out-equals: 0
# `let rec` / `and` 组里的指令也要有（每组至少一条）。
run: sh -c 'grep -A1 -E "^let rec " "$TMPDIR/grp-split/Main.ml" | grep -cE "^# [0-9]+" || true'
exit: 0
run: sh -c 'grep -B1 -E "^and " "$TMPDIR/grp-split/Main.ml" | grep -cE "^# [0-9]+" || true'
exit: 0
run: sh -c 'cd "$TMPDIR/grp-split" && sh build.sh prog >/dev/null 2>&1 && ./prog'
exit: 0
out-equals: 1

# ---------------------------------------------------------------- 5) DWARF 指向 .vuna
run: sh -c 'readelf --debug-dump=decodedline "$TMPDIR/grp-split/prog" 2>/dev/null | grep -c "Main[.]vuna"'
exit: 0
run: sh -c 'readelf --debug-dump=decodedline "$TMPDIR/grp-split/prog" 2>/dev/null | grep "Main[.]vuna" | head -1'
exit: 0
out-contains: Main.vuna

run: sh -c 'd="$TMPDIR/boom"; mkdir -p "$d/app"; printf "[package]\nname = \"boom\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "boom : List Int -> Int\nboom Nil = 1 / 0\nboom (x :: xs) = x + boom xs\n\nmain : Int\nmain = boom [1, 2, 3]\n" > "$d/app/Main.vuna"; "$VUNA" build --out "$TMPDIR/boom-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/boom-out/bin/boom" 2>&1 >/dev/null'
exit: nonzero
out-contains: vuna: runtime error
out-contains: app/Main.vuna

run: sh -c 'd="$TMPDIR/sam"; mkdir -p "$d/app"; printf "[package]\nname = \"sam\"\n\n[dependencies]\nvuna-base = \"%s\"\nvuna-obs = \"%s\"\n" "$VUNA_BASE" "$VUNA_OBS_PKG" > "$d/vuna.toml"; printf "import Base.Data.List as List\nimport Obs as ObsSpan\n\nwork : List Int -> Int\nwork Nil = 0\nwork (x :: xs) = x * 3 + work xs\n\nmain : Int\nmain = obsSample \"both\" 1000 (\\_ => work (range 0 400000))\n" > "$d/app/Main.vuna"; "$VUNA" build --out "$TMPDIR/sam-out" "$d"'
exit: 0
run: sh -c 'VUNA_OBS=3 VUNA_OBS_DIR="$TMPDIR/sam-trace" "$TMPDIR/sam-out/bin/sam" >/dev/null'
exit: 0
run: sh -c 'grep -c "vuna[.]sample[.]cpu" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
run: sh -c 'grep -c "vuna[.]sample[.]mem" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
run: sh -c '"$VUNA" dev obs validate "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
out-contains: verified
run: sh -c '"$VUNA" dev obs summarize "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
out-contains: samples:cpu

# 工具链自采样：`vuna` 自己也是被观测程序（`VUNA_OBS_SAMPLE` 驱动 Main 的
# sampleStart/Stop）。`check` 的真实工作在 `vuna-compiler` 子进程里，`--out` 必须把
# 整棵进程树的 trace 合并成一份（不是最后 flush 的进程覆盖）；顺带验证 reservoir
# 把抽样前总数写进 `vuna.counter.sample.mem`。
run: sh -c 'VUNA_STORE="$TMPDIR/tool-store" "$VUNA" dev obs run --level 1 --sample mem --out "$TMPDIR/tool-trace.jsonl" -- "$VUNA" check "$VUNA_BASE" >/dev/null'
exit: 0
run: sh -c '"$VUNA" dev obs validate "$TMPDIR/tool-trace.jsonl"'
exit: 0
out-contains: verified
run: sh -c 'grep -q "vuna[.]parse[.]lex" "$TMPDIR/tool-trace.jsonl" && echo compiler-span'
exit: 0
out-contains: compiler-span
run: sh -c 'pids=$(grep -o "\"pid\":[0-9]*" "$TMPDIR/tool-trace.jsonl" | sort -u | wc -l); test "$pids" -ge 2 && echo "pids $pids"'
exit: 0
out-contains: pids
run: sh -c 'n=$(grep -c "vuna[.]sample[.]mem" "$TMPDIR/tool-trace.jsonl"); test "$n" -gt 100 && echo "mem $n"'
exit: 0
out-contains: mem
# reservoir 的替换分支：抽样前总数 > 保留的 8192 槽（`check base` 的分配量足够大）。
run: sh -c 'v=$(grep "vuna[.]counter[.]sample[.]mem" "$TMPDIR/tool-trace.jsonl" | grep -o "\"value\":[0-9]*" | cut -d: -f2 | sort -n | tail -1); test "$v" -gt 8192 && echo "sampled $v"'
exit: 0
out-contains: sampled

# ---------------------------------------------------------------- 8) convert / render
run: sh -c '"$VUNA" dev obs convert --to cpuprofile --out "$TMPDIR/a.cpuprofile" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
run: sh -c '"$VUNA" dev obs convert --to cpuprofile --out "$TMPDIR/b.cpuprofile" "$TMPDIR"/sam-trace/*.jsonl'
run: sh -c 't=$(find "$TMPDIR/mac-trace" -name "*.jsonl" | head -1); "$VUNA" dev obs summarize "$t"'
exit: 0
exit: 0
file-contains: $TMPDIR/a.cpuprofile "nodes"
file-contains: $TMPDIR/a.cpuprofile "timeDeltas"

run: sh -c '"$VUNA" dev obs convert --to folded --out "$TMPDIR/a.folded" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
run: sh -c '"$VUNA" dev obs convert --to folded --out "$TMPDIR/b.folded" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
run: sh -c 'cmp "$TMPDIR/a.folded" "$TMPDIR/b.folded"'
exit: 0
run: sh -c 'awk -F"\t" "NF == 2" "$TMPDIR/a.folded" | head -1'
exit: 0
out-contains: ;

run: sh -c '"$VUNA" dev obs convert --to speedscope --out "$TMPDIR/a.speedscope.json" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
file-contains: $TMPDIR/a.speedscope.json speedscope.app

run: sh -c '"$VUNA" dev obs render --out "$TMPDIR/a.html" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
run: sh -c '"$VUNA" dev obs render --out "$TMPDIR/b.html" "$TMPDIR"/sam-trace/*.jsonl'
exit: 0
run: sh -c 'cmp "$TMPDIR/a.html" "$TMPDIR/b.html"'
exit: 0
file-contains: $TMPDIR/a.html vuna-obs-data
run: sh -c 'grep -c "https[:]//" "$TMPDIR/a.html" || true'
exit: 0
out-equals: 0

# ---------------------------------------------------------------- 9) summarize --json / baseline
run: sh -c '"$VUNA" dev obs summarize --json "$TMPDIR"/mac-trace/*.jsonl | wc -l | tr -d " "'
exit: 0
out-equals: 1
run: sh -c '"$VUNA" dev obs summarize --json "$TMPDIR"/mac-trace/*.jsonl'
exit: 0
out-contains: "spans"

# 自比对：差值 0 通过。
run: sh -c 't=$(find "$TMPDIR/mac-trace" -name "*.jsonl" | head -1); "$VUNA" dev obs summarize --baseline "$t" "$t"'
exit: 0

# ---------------------------------------------------------------- 10) 非 OCaml 后端
run: sh -c 'd="$TMPDIR/wobs"; mkdir -p "$d/app"; printf "[package]\nname = \"wobs\"\n\n[dependencies]\nvuna-base = \"%s\"\nvuna-obs = \"%s\"\n" "$VUNA_BASE" "$VUNA_OBS_PKG" > "$d/vuna.toml"; printf "import Obs as Obs\n\nmain : Int\nmain =\n  let\n    _ = obsLevel 0\n    _ = log! \"info\" \"wasm\"\n  in 9\n" > "$d/app/Main.vuna"; "$VUNA" build --target wasm --out "$TMPDIR/wobs-out" "$d"'
exit: 0
file-exists: $TMPDIR/wobs-out/main.wat

run: sh -c 'd="$TMPDIR/wspan"; mkdir -p "$d/app"; printf "[package]\nname = \"wspan\"\n\n[dependencies]\nvuna-base = \"%s\"\nvuna-obs = \"%s\"\n" "$VUNA_BASE" "$VUNA_OBS_PKG" > "$d/vuna.toml"; printf "import Obs as ObsSpan\n\nmain : Int\nmain = obsSpan \"x\" \"vuna.user\" (\\_ => 1)\n" > "$d/app/Main.vuna"; "$VUNA" build --target wasm --out "$TMPDIR/wspan-out" "$d"'
exit: 0
run: sh -c 'cd "$TMPDIR/wspan-out" && node "$VUNA_SUITE_ROOT/wasm-host/run.mjs" main.wasm'
exit: 0
out-equals: 1

run: sh -c 'd="$TMPDIR/nspan"; mkdir -p "$d/app"; printf "[package]\nname = \"nspan\"\n\n[dependencies]\nvuna-base = \"%s\"\nvuna-obs = \"%s\"\n" "$VUNA_BASE" "$VUNA_OBS_PKG" > "$d/vuna.toml"; printf "import Obs as ObsSpan\n\nmain : Int\nmain = obsSpan \"x\" \"vuna.user\" (\\_ => 1)\n" > "$d/app/Main.vuna"; VUNA_OBS=1 VUNA_OBS_SAMPLE=mem VUNA_OBS_DIR="$TMPDIR/nspan-trace" "$VUNA" build --target native --out "$TMPDIR/nspan-out" "$d"'
exit: 0
run: sh -c '"$TMPDIR/nspan-out/bin/nspan"'
exit: 0
out-equals: 1
# 后端插件入口也自采样：codegen 在 `vuna-target-native` 子进程里，trace 必须带分配栈
# （`--vuna-describe` 那次调用也会写一份空 trace，所以扫全部文件）。
run: sh -c 'for f in "$TMPDIR"/nspan-trace/*.jsonl; do grep -q "vuna-target-native" "$f" && grep -q "vuna[.]sample[.]mem" "$f" && echo native-sampled && break; done'
exit: 0
out-contains: native-sampled

# ---------------------------------------------------------------- 对象库读写 span
# `Store` 的对象读/写是工作单元：`VUNA_OBS=1` 的 trace 必须出现 vuna.cache.lookup /
# vuna.cache.write 的 ph:"X" 事件（不是零宽 mark）。
run: sh -c 'VUNA_STORE="$TMPDIR/cache-store" VUNA_OBS=1 VUNA_OBS_DIR="$TMPDIR/cache-trace" "$VUNA" check "$TMPDIR/app" >/dev/null 2>&1'
exit: 0
run: sh -c 'grep -q "\"name\":\"vuna.cache.lookup\"" "$TMPDIR"/cache-trace/*.jsonl && grep -q "\"name\":\"vuna.cache.write\"" "$TMPDIR"/cache-trace/*.jsonl'
exit: 0
