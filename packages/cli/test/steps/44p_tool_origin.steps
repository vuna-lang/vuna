# store-isolated: 断言缓存/对象库行为，使用 case 私有 store 与包状态目录。
# 44p) 工具写回与整包写共用同一对象地址：LSP 冷启动的单模块写回落在
#      `$VUNA_PKG_STATE/iface/<输入摘要>`，随后命令行 check 直接复用（零重写、无 miss）。
#      对象地址由输入决定，谁写的都一样（LSP 与整包写共用同一地址）。
#      夹具 $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m34_iface_audit 复制到 $TMPDIR，vuna.toml 的 base 改到本仓库。
run: sh -c 'rm -rf "$TMPDIR/org-pkg" "$TMPDIR/org-store" "$TMPDIR/org-state" "$TMPDIR/org-cache"; cp -R $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m34_iface_audit "$TMPDIR/org-pkg"'
run: sh -c 'for mf in "$TMPDIR/org-pkg"/*/vuna.toml; do sed "s|vuna-base = \"[^\"]*\"|vuna-base = \"$VUNA_BASE\"|" "$mf" > "$mf.tmp" && mv "$mf.tmp" "$mf"; done'
# 预热依赖：base 与 dep 的接口先落到 case 私有状态目录（消费者只读依赖接口，不代写）。
run: sh -c 'VUNA_STORE="$TMPDIR/org-store" VUNA_PKG_STATE="$TMPDIR/org-state" TMPDIR="$TMPDIR/org-cache" "$VUNA" check "$VUNA_BASE" && VUNA_STORE="$TMPDIR/org-store" VUNA_PKG_STATE="$TMPDIR/org-state" TMPDIR="$TMPDIR/org-cache" "$VUNA" check "$TMPDIR/org-pkg/dep"'
exit: 0
# LSP 冷启动：不清状态目录（复用预热好的依赖接口），只清 LSP 侧缓存；mid 还没被 check 过。
run: sh -c 'mkdir -p "$TMPDIR/org-lsp-cache"'
# 构造 JSON-RPC 帧（每行一个紧凑 JSON；text 里换行必须是转义序列 \n）。
run: pkg="$TMPDIR/org-pkg/mid"; src="$pkg/lib/Mid.vuna"; { jq -cn --arg uri "file://$pkg" '{jsonrpc:"2.0",id:1,method:"initialize",params:{rootUri:$uri,capabilities:{}}}'; jq -cn '{jsonrpc:"2.0",method:"initialized",params:{}}'; jq -cn --arg uri "file://$src" --rawfile text "$src" '{jsonrpc:"2.0",id:2,method:"textDocument/didOpen",params:{textDocument:{uri:$uri,languageId:"vuna",version:1,text:$text}}}'; jq -cn '{jsonrpc:"2.0",id:3,method:"shutdown"}'; jq -cn '{jsonrpc:"2.0",method:"exit"}'; } > "$TMPDIR/lsp-org.jsonl"; LC_ALL=C awk '{ printf "Content-Length: %d\r\n\r\n%s", length($0), $0 }' "$TMPDIR/lsp-org.jsonl" > "$TMPDIR/lsp-org.frames"
run: sh -c 'VUNA_STORE="$TMPDIR/org-store" VUNA_PKG_STATE="$TMPDIR/org-state" TMPDIR="$TMPDIR/org-lsp-cache" "$VUNA" lsp < "$TMPDIR/lsp-org.frames" > /dev/null 2>&1'
exit: 0
# LSP 写回产生了 mid 的接口对象。
run: sh -c 'test -n "$(find "$TMPDIR/org-state/iface" -type f | head -1)"'
exit: 0
# 命令行 check 复用这些对象：包级判定命中 ⇒ 不重写接口、不出现
# 「依赖接口缺件 ⇒ 全量回退」的信号。
run: sh -c 'VUNA_STORE="$TMPDIR/org-store" VUNA_PKG_STATE="$TMPDIR/org-state" TMPDIR="$TMPDIR/org-cache" VUNA_LOG=debug "$VUNA" check "$TMPDIR/org-pkg/mid" 2>&1'
exit: 0
out-not-contains: iface-miss
out-contains: iface-write=0/1