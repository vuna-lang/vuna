# store-isolated: 断言缓存/包状态目录行为，使用 case 私有 store 与状态目录。
# 44n) 包环境进地址：语义清单变化（包名/依赖/export）必须让本包接口地址变化 ⇒ 重新精化；
#      纯显示配置（注释 / [diagnostics]）不进身份；之后重跑收敛（零重写、零新增接口）。
#      夹具 $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m34_iface_audit 复制到 $TMPDIR，vuna.toml 的 base 改到本仓库。
run: sh -c 'rm -rf "$TMPDIR/env-pkg" "$TMPDIR/env-cache" "$TMPDIR/env-store" "$TMPDIR/env-state"; cp -R $VUNA_SUITE_ROOT/packages/cli/test/corpus/packages/m34_iface_audit "$TMPDIR/env-pkg"'
run: sh -c 'for mf in "$TMPDIR/env-pkg"/*/vuna.toml; do sed "s|vuna-base = \"[^\"]*\"|vuna-base = \"$VUNA_BASE\"|" "$mf" > "$mf.tmp" && mv "$mf.tmp" "$mf"; done'
run: sh -c 'VUNA_STORE="$TMPDIR/env-store" VUNA_PKG_STATE="$TMPDIR/env-state" TMPDIR="$TMPDIR/env-cache" "$VUNA" check "$TMPDIR/env-pkg/dep" && VUNA_STORE="$TMPDIR/env-store" VUNA_PKG_STATE="$TMPDIR/env-state" TMPDIR="$TMPDIR/env-cache" "$VUNA" check "$TMPDIR/env-pkg/mid"'
exit: 0
# 非语义变化（注释 + [diagnostics] 显示配置），模块源码不变 ⇒ **不进**语义身份。
run: sh -c 'printf "\n# env probe\n[diagnostics]\nformat = \"short\"\n" >> "$TMPDIR/env-pkg/mid/vuna.toml"; rm -rf "$TMPDIR/env-cache"'
run: sh -c 'VUNA_STORE="$TMPDIR/env-store" VUNA_PKG_STATE="$TMPDIR/env-state" TMPDIR="$TMPDIR/env-cache" VUNA_LOG=debug "$VUNA" check "$TMPDIR/env-pkg/mid"'
exit: 0
out-contains: iface-write=
# 收敛：地址没变，再跑一遍零重写。
run: sh -c 'rm -rf "$TMPDIR/env-cache"; VUNA_STORE="$TMPDIR/env-store" VUNA_PKG_STATE="$TMPDIR/env-state" TMPDIR="$TMPDIR/env-cache" VUNA_LOG=debug "$VUNA" check "$TMPDIR/env-pkg/mid"'
exit: 0
out-contains: iface-write=0/
# 语义变化（包名）：地址变化 ⇒ 必须重算并写回接口。
run: sh -c 'sed -i "s/name = \"iface-audit-mid\"/name = \"iface-audit-mid2\"/" "$TMPDIR/env-pkg/mid/vuna.toml"; rm -rf "$TMPDIR/env-cache"'
run: sh -c 'VUNA_STORE="$TMPDIR/env-store" VUNA_PKG_STATE="$TMPDIR/env-state" TMPDIR="$TMPDIR/env-cache" VUNA_LOG=debug "$VUNA" check "$TMPDIR/env-pkg/mid"'
exit: 0
out-not-contains: iface-write=0/
# 收敛：再跑一遍，状态目录里的接口文件数不变。
run: sh -c 'n1=$(find "$TMPDIR/env-state/iface" -type f | wc -l); rm -rf "$TMPDIR/env-cache"; VUNA_STORE="$TMPDIR/env-store" VUNA_PKG_STATE="$TMPDIR/env-state" TMPDIR="$TMPDIR/env-cache" VUNA_LOG=debug "$VUNA" check "$TMPDIR/env-pkg/mid" >/dev/null 2>&1; n2=$(find "$TMPDIR/env-state/iface" -type f | wc -l); [ "$n1" -eq "$n2" ]'