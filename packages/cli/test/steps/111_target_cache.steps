# 111) 后端产物缓存：每目标产物（键里有 IR 内容哈希 + target + 后端身份）。
#
# 第一次构建 miss（起插件），同 store 同目标第二次 hit（不启动插件，只物化文件）；
# 换目标必须 miss（键里有 target）；hit 的产物与冷构建逐字节一致。

run: sh -c 'd="$TMPDIR/tc/min"; mkdir -p "$d/app"; printf "[package]\nname = \"tcmin\"\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$d/vuna.toml"; printf "main : Int\nmain = 42\n" > "$d/app/Main.vuna"'
exit: 0

# 111a) wasm：冷构建 miss。
run: sh -c 'VUNA_STORE="$TMPDIR/tc/store" VUNA_LOG=debug "$VUNA" build --target wasm --no-compile --out "$TMPDIR/tc/out" "$TMPDIR/tc/min" 2>&1'
out-contains: target-cache=miss

# 111b) 同 store 同目标：hit。
run: sh -c 'VUNA_STORE="$TMPDIR/tc/store" VUNA_LOG=debug "$VUNA" build --target wasm --no-compile --out "$TMPDIR/tc/out" "$TMPDIR/tc/min" 2>&1'
out-contains: target-cache=hit

# 111c) hit 的产物与冷构建一致：删掉输出目录后用缓存重建。
run: sh -c 'a=$(cksum < "$TMPDIR/tc/out/main.wat"); rm -rf "$TMPDIR/tc/out"; VUNA_STORE="$TMPDIR/tc/store" "$VUNA" build --target wasm --no-compile --out "$TMPDIR/tc/out" "$TMPDIR/tc/min" >/dev/null 2>&1; b=$(cksum < "$TMPDIR/tc/out/main.wat"); [ "$a" = "$b" ]'
exit: 0

# 111e) 换目标：键里有 target，必须 miss；第二次 hit。
run: sh -c 'VUNA_STORE="$TMPDIR/tc/store" VUNA_LOG=debug "$VUNA" build --target native --no-compile --out "$TMPDIR/tc/outn" "$TMPDIR/tc/min" 2>&1'
out-contains: target-cache=miss
run: sh -c 'VUNA_STORE="$TMPDIR/tc/store" VUNA_LOG=debug "$VUNA" build --target native --no-compile --out "$TMPDIR/tc/outn" "$TMPDIR/tc/min" 2>&1'
out-contains: target-cache=hit
