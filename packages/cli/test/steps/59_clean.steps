# store-isolated: 断言缓存/包状态目录行为，使用 case 私有 store。
# 59) `vuna store clean`：一个 store 根、两类生命周期。
#     --store     清缓存族（遗留 `objects/module-iface`、`views`、`.tmp`），保留取包对象族与 roots
#     --packages  清取包对象族（`objects/pkg`、`pkgs`、`tmp`），保留缓存族与 roots
#     --gc        与 --packages 连用：只删未被工作区/项目 roots 引用的包对象
#     不带 flag 时只清缓存族；--dry-run 只报数量。
#     模块接口已迁到包内 `<pkg>/.vuna/iface`，所以 `--store` 对它是**遗留清理**。
run: sh -c 'rm -rf "$TMPDIR/clean-store"; export VUNA_STORE="$TMPDIR/clean-store"; mkdir -p "$VUNA_STORE/objects/module-iface" "$VUNA_STORE/views" "$VUNA_STORE/objects/pkg" "$VUNA_STORE/pkgs/fake"; printf x > "$VUNA_STORE/objects/module-iface/legacy"; printf x > "$VUNA_STORE/objects/pkg/fake"; printf fake > "$VUNA_STORE/pkgs/fake/.complete"'
exit: 0
run: sh -c 'printf "user note\n" >"$TMPDIR/keep.txt"; export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" store clean --store --dry-run'
exit: 0
out-contains: would remove
run: sh -c 'export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" store clean --store'
exit: 0
out-contains: removed
# 缓存族清空；取包对象族与物化视图必须存活。
run: sh -c 'test ! -d "$TMPDIR/clean-store/objects/module-iface" && test ! -d "$TMPDIR/clean-store/views" && test -f "$TMPDIR/clean-store/objects/pkg/fake" && test -f "$TMPDIR/clean-store/pkgs/fake/.complete"'
exit: 0
file-exists: $TMPDIR/keep.txt
# 恢复缓存族（遗留接口目录），再清取包对象族：缓存族必须存活。
run: sh -c 'mkdir -p "$TMPDIR/clean-store/objects/module-iface"; printf x > "$TMPDIR/clean-store/objects/module-iface/legacy2"'
exit: 0
run: sh -c 'export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" store clean --packages'
exit: 0
out-contains: removed
run: sh -c 'test ! -d "$TMPDIR/clean-store/objects/pkg" && test ! -d "$TMPDIR/clean-store/pkgs" && test -d "$TMPDIR/clean-store/objects/module-iface"'
exit: 0
# 裸 `vuna store clean` 只清缓存族：取包对象族不动。
run: sh -c 'mkdir -p "$TMPDIR/clean-store/objects/pkg"; printf x > "$TMPDIR/clean-store/objects/pkg/fake2"; export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" store clean'
exit: 0
out-contains: removed
run: sh -c 'test -f "$TMPDIR/clean-store/objects/pkg/fake2" && test ! -d "$TMPDIR/clean-store/objects/module-iface"'
exit: 0
run: sh -c 'export VUNA_STORE="$TMPDIR/clean-store"; "$VUNA" store clean --store'
exit: 0
out-contains: removed 0 file(s)