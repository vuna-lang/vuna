# 39) lint 产品面：vuna.toml [lint] 配置、源码抑制、JSON 输出、未知规则只由 lint 认领。
run: sh -c 'p="$TMPDIR/lint-pkg"; mkdir -p "$p/lib"; printf "[package]\nname = \"lint-pkg\"\n\n[dependencies]\nvuna-base = \"%s\"\n\n[lint]\npreset = \"recommended\"\nmax-warnings = 0\n" "$VUNA_BASE" > "$p/vuna.toml"; printf "%s\n" "module Probe where" "" "probe : Int -> Int" "probe x = if x == 1 then 1 else if x == 2 then 2 else 3" > "$p/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 1
out-contains: LN_LiteralIfChain
out-contains: :4:11:
run: sh -c 'printf "%s\n" "module Probe where" "" "probe : Int -> Int" "-- vuna-lint: disable-next-line literal-if-chain" "probe x = if x == 1 then 1 else if x == 2 then 2 else 3" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
run: sh -c 'printf "%s\n" "module Probe where" "" "probe : Int -> Int" "probe x = if x == 1 then 1 else if x == 2 then 2 else 3" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --format json "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 1
out-contains: "code":"LN_LiteralIfChain"
out-contains: "endLine":4
out-contains: "fixable":true
run: sh -c 'printf "[package]\nname = \"lint-pkg\"\n\n[dependencies]\nvuna-base = \"%s\"\n\n[lint]\n[lint.rules]\nunknown-rule = \"error\"\n" "$VUNA_BASE" > "$TMPDIR/lint-pkg/vuna.toml"'
exit: 0
run: "$VUNA" check "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
run: "$VUNA" lint "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 2
out-contains: unknown lint rule: unknown-rule
run: sh -c 'printf "[package]\nname = \"lint-pkg\"\n\n[dependencies]\nvuna-base = \"%s\"\n\n[lint]\npreset = \"recommended\"\nmax-warnings = 0\n" "$VUNA_BASE" > "$TMPDIR/lint-pkg/vuna.toml"; printf "%s\n" "module Probe where" "" "-- TODO: remove before merge" "probe : Int -> Int" "probe x = x" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
run: "$VUNA" lint --select todo-marker --max-warnings 0 "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 1
out-contains: LN_TodoMarker
out-contains: TODO
run: sh -c 'printf "%s\n" "module Probe where" "" "probe : Int -> Int" "probe x = if True then 1 else 2" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --select redundant-if --max-warnings 0 "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 1
out-contains: LN_RedundantIf
run: "$VUNA" lint --fix --select redundant-if "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna probe x = 1
# pair-sugar：显式 Pair 应用（值 / 类型 / 模式）改写成元组语法，右嵌套链展平；默认关闭，
# --select 启用。
run: sh -c 'printf "%s\n" "module Probe where" "" "import Base.Data.Pair as Pair" "" "pairTy : Pair Int String" "pairTy = Pair 1 \"a\"" "" "unpair : Pair Int String -> Int" "unpair (Pair n _) = n" "" "nested : Pair Int (Pair Int Int)" "nested = Pair 1 (Pair 2 3)" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --select pair-sugar --max-warnings 0 "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 1
out-contains: LN_PairSugar
out-contains: `(Int, String)`
run: "$VUNA" lint --fix --select pair-sugar "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna pairTy : (Int, String)
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna pairTy = (1, "a")
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna unpair (n, _) = n
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna nested = (1, 2, 3)
run: "$VUNA" lint --select pair-sugar --max-warnings 0 "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
run: "$VUNA" check "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
run: sh -c 'printf "%s\n" "module Probe where" "" "probe : Int -> Int" "probe x = if True then 1 else 2" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --format sarif --select redundant-if "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 1
out-contains: "version":"2.1.0"
out-contains: "ruleId":"LN_RedundantIf"
run: sh -c 'printf "%s\n" "module Probe where" "" "probe : Int -> Int" "probe x = if x == 1 then 1 else if x == 2 then 2 else 3" | "$VUNA" lint -'
exit: 1
out-contains: <stdin>:4:11
out-contains: LN_LiteralIfChain
run: sh -c 'printf "%s\n" "module Probe where" "" "probe : Int -> Int" "probe x = if x == 1 then 1 else if x == 2 then 2 else 3" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --fix --diff "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 1
out-contains: ---
out-contains: +++
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna probe x = if x == 1
# --fix 的切片回归：AST span 会漏掉括号（EParen 取内层）、右边界落在紧贴前一个
# token 的符号上（`]` / `)`）、中缀 span 从运算符开始。任一处漏掉都会产出不能解析
# 的代码，修复必须整体拒绝写回。
run: sh -c 'printf "%s\n" "module Probe where" "" "count : List Int -> Int" "count xs = case xs of" "  [] => 0" "  y :: ys => (if y == 1 then 1 else 0) + count ys" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --fix "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna count (y :: ys) = (if y == 1 then 1 else 0) + count ys
run: sh -c 'printf "%s\n" "module Probe where" "" "pick : List Int -> List Int" "pick xs = case xs of" "  [] => [0]" "  _ => [1, 2]" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --fix "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna pick _ = [1, 2]
run: sh -c 'printf "%s\n" "module Probe where" "" "label : Int -> String" "label n = case n of" "  1 =>" "    \"one\"" "      ++ \"!\"" "  _ => \"other\"" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --fix "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna label 1 =
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna "one"
run: "$VUNA" lint --max-warnings 0 "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
# 链尾后紧跟外层 `else` 时不能整行替换：改写会留下没有 `else` 的 `if`。修复只能处理
# 行尾的链（`probe2` 的 else 分支），`if a && b then <链> else 6` 必须原样保留。
run: sh -c 'printf "%s\n" "module Probe where" "" "probe : Bool -> Bool -> Int -> Int" "probe a b x = if a && b then if x == 8 then 3 else if x == 9 then 4 else 5 else 6" "" "probe2 : Bool -> Bool -> Int -> Int" "probe2 a b x = if a && b then if x == 8 then 3 else if x == 9 then 4 else 5 else if x == 0 then 6 else if x == 1 then 7 else 8" > "$TMPDIR/lint-pkg/lib/Probe.vuna"'
exit: 0
run: "$VUNA" lint --fix "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna probe a b x = if a && b then if x == 8 then 3 else if x == 9 then 4 else 5 else 6
file-contains: $TMPDIR/lint-pkg/lib/Probe.vuna else case x of
run: "$VUNA" lint --max-warnings 0 "$TMPDIR/lint-pkg/lib/Probe.vuna" 2>&1
exit: 0
# 目录扫描遵守 `.gitignore`：被忽略的源码不进入 lint / fmt；`result-*` 这类前缀规则
# 也要在任意深度生效（否则会扫进 nix 的 result-* 软链）。
run: sh -c 'p="$TMPDIR/ignore-scan"; mkdir -p "$p/lib/ignored" "$p/lib/result-cache"; printf "ignored/\nresult-*\n" > "$p/.gitignore"; printf "[package]\nname = \"ignore-scan\"\n\n[export]\nmodules = [\"Clean\"]\n\n[dependencies]\nvuna-base = \"%s\"\n\n[lint]\npreset = \"recommended\"\nmax-warnings = 0\n" "$VUNA_BASE" > "$p/vuna.toml"; printf "%s\n" "module Clean where" "" "clean : Int -> Int" "clean x = x" > "$p/lib/Clean.vuna"; printf "%s\n" "module Bad where" "" "bad = (" > "$p/lib/ignored/Bad.vuna"; printf "%s\n" "module Worse where" "" "worse = (" > "$p/lib/result-cache/Worse.vuna"'
exit: 0
run: "$VUNA" lint "$TMPDIR/ignore-scan" 2>&1
exit: 0
run: "$VUNA" fmt --check "$TMPDIR/ignore-scan" 2>&1
exit: 0
run: "$VUNA" check "$TMPDIR/ignore-scan" 2>&1
exit: 0
# 去掉 ignore 文件后 lint 会读到故意损坏的夹具。
run: sh -c 'rm "$TMPDIR/ignore-scan/.gitignore"'
exit: 0
run: "$VUNA" lint "$TMPDIR/ignore-scan" 2>&1
exit: nonzero
# 锚定、`**` 与取反：`lib/Anchored.vuna` 只匹配锚定路径，`**/Deep.vuna` 匹配任意深度，
# `!lib/Keep.gen.vuna` 从 `*.gen.vuna` 里重新包含。
run: sh -c 'p="$TMPDIR/ignore-patterns"; mkdir -p "$p/lib/sub"; printf "**/Deep.vuna\nlib/Anchored.vuna\n*.gen.vuna\n!lib/Keep.gen.vuna\n" > "$p/.gitignore"; printf "[package]\nname = \"ignore-patterns\"\n\n[export]\nmodules = [\"Clean\"]\n\n[dependencies]\nvuna-base = \"%s\"\n" "$VUNA_BASE" > "$p/vuna.toml"; printf "%s\n" "module Clean where" "" "clean : Int -> Int" "clean x = x" > "$p/lib/Clean.vuna"; printf "%s\n" "module Deep where" "" "deep = (" > "$p/lib/Deep.vuna"; printf "%s\n" "module Deep2 where" "" "deep2 = (" > "$p/lib/sub/Deep.vuna"; printf "%s\n" "module Anchored where" "" "anchored = (" > "$p/lib/Anchored.vuna"; printf "%s\n" "module Bad where" "" "bad = (" > "$p/lib/Bad.gen.vuna"; printf "%s\n" "module Keep where" "" "-- TODO: keep this visible" "keep : Int -> Int" "keep x = x" > "$p/lib/Keep.gen.vuna"'
exit: 0
run: "$VUNA" lint --select todo-marker --max-warnings 0 "$TMPDIR/ignore-patterns" 2>&1
exit: 1
out-contains: Keep.gen.vuna
out-contains: LN_TodoMarker
# `max-warnings` 是整次运行的阈值：取运行根（cwd）的 manifest 链，不随首个文件所在包变化。
# 成员包各自声明 `-1` 时，从 workspace 根 lint 两个包仍按根配置的 0 失败；在成员包目录内
# 运行才用该包的 `-1`。
run: sh -c 'p="$TMPDIR/lint-ws"; mkdir -p "$p/a/lib" "$p/b/lib"; printf "[workspace]\nmembers = [\"a\", \"b\"]\n\n[lint]\npreset = \"recommended\"\nmax-warnings = 0\n" > "$p/vuna.toml"; printf "[package]\nname = \"a\"\n\n[dependencies]\nvuna-base = \"%s\"\n\n[lint]\nmax-warnings = -1\n" "$VUNA_BASE" > "$p/a/vuna.toml"; printf "[package]\nname = \"b\"\n\n[dependencies]\nvuna-base = \"%s\"\n\n[lint]\nmax-warnings = -1\n" "$VUNA_BASE" > "$p/b/vuna.toml"; printf "%s\n" "module A where" "" "a : Int -> Int" "a x = if x == 1 then 1 else if x == 2 then 2 else 3" > "$p/a/lib/A.vuna"; printf "%s\n" "module B where" "" "b : Int -> Int" "b x = if x == 1 then 1 else if x == 2 then 2 else 3" > "$p/b/lib/B.vuna"'
exit: 0
run: sh -c 'cd "$TMPDIR/lint-ws" && "$VUNA" lint a/lib/A.vuna b/lib/B.vuna 2>&1'
exit: 1
out-contains: A.vuna:4:7: [LN_LiteralIfChain]
run: sh -c 'cd "$TMPDIR/lint-ws/a" && "$VUNA" lint lib/A.vuna 2>&1'
exit: 0
