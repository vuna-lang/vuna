-- | 最小 JSON 读写（LSP 与 REPL 用；**永不进 seed 闭包**）。
--
-- 只做 JSON-RPC 需要的子集：null / bool / number / string / array / object。数字统一用 `Int`
-- 表示，小数部分与指数在解析时被读取校验后截断（LSP 的位置、长度、id 都是整数）。
--
-- 解析是单遍递归下降，输入是 `List Int`（`strUnpack` 后的字节游标），错误只报位置无关的简短
-- 原因（调用方把它写进 stderr 日志，不需要富诊断）。
--
-- 字符串转义：解析接受 `\"` `\\` `\/` `\b` `\f` `\n` `\r` `\t` 与 `\uXXXX`（按 UTF-8 编码，
-- 代理对不合并）；输出把 < 0x20 的控制字符转成 `\u00XX`，其余字符原样输出。
module Vuna.Json where

import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Vuna.Compiler.Base.Common
import Base.Data.String as String

-- ---------------------------------------------------------------
-- 数据模型
-- ---------------------------------------------------------------
-- | JSON 值：JSON-RPC 所需的全部形态。
export data Json(..) : Type where
  -- | `null`。
  JNull : Json
  -- | `true` / `false`。
  JBool : Bool -> Json
  -- | 数字；小数与指数在解析时被截断，值保持整数。
  JNum : Int -> Json
  -- | 字符串（UTF-8 字节串）。
  JStr : String -> Json
  -- | 数组。
  JArr : List Json -> Json
  -- | 对象：成员按出现顺序保存，重复键原样保留（读取时命中第一个）。
  JObj : List (Pair String Json) -> Json

-- | 构造单键对象（构造响应时常用）。
export jsonObjSingle : String -> Json -> Json
jsonObjSingle k v = JObj [Pair k v]

-- ---------------------------------------------------------------
-- 访问器
-- ---------------------------------------------------------------
-- | 取对象字段；缺失或值不是对象时给 `Nothing`（重复键命中第一个）。
export jsonGet : String -> Json -> Maybe Json
jsonGet key (JObj kvs) = lookupKV key kvs
jsonGet key _ = Nothing

-- | 内部：在成员表里线性查找第一个匹配键。
lookupKV : String -> List (Pair String Json) -> Maybe Json
lookupKV key [] = Nothing
lookupKV key ((Pair k x) :: rest) = if k == key then Just x else lookupKV key rest

-- | 按路径逐层取值，例如 `jsonGetIn ["params", "textDocument", "uri"] v`；空路径返回原值。
export jsonGetIn : List String -> Json -> Maybe Json
jsonGetIn [] v = Just v
jsonGetIn (k :: rest) v =
  case jsonGet k v of
    Nothing => Nothing
    Just inner => jsonGetIn rest inner

-- | 取字符串值；不是字符串给 `Nothing`。
export jsonAsStr : Json -> Maybe String
jsonAsStr (JStr s) = Just s
jsonAsStr _ = Nothing

-- | 取数字值（整数）；不是数字给 `Nothing`。
export jsonAsInt : Json -> Maybe Int
jsonAsInt (JNum n) = Just n
jsonAsInt _ = Nothing

-- | 取布尔值；不是布尔给 `Nothing`。
export jsonAsBool : Json -> Maybe Bool
jsonAsBool (JBool b) = Just b
jsonAsBool _ = Nothing

-- | 取数组元素；不是数组给 `Nothing`。
export jsonAsArr : Json -> Maybe (List Json)
jsonAsArr (JArr xs) = Just xs
jsonAsArr _ = Nothing

-- | 取对象成员表；不是对象给 `Nothing`。
export jsonAsObj : Json -> Maybe (List (Pair String Json))
jsonAsObj (JObj kvs) = Just kvs
jsonAsObj _ = Nothing

-- | 取字符串值，不是字符串时用默认值 `d`。
export jsonStrOr : String -> Json -> String
jsonStrOr d (JStr s) = s
jsonStrOr d _ = d

-- | 取数字值，不是数字时用默认值 `d`。
export jsonIntOr : Int -> Json -> Int
jsonIntOr d (JNum n) = n
jsonIntOr d _ = d

-- | 取布尔值，不是布尔时用默认值 `d`。
export jsonBoolOr : Bool -> Json -> Bool
jsonBoolOr d (JBool b) = b
jsonBoolOr d _ = d

-- ---------------------------------------------------------------
-- 渲染
-- ---------------------------------------------------------------
-- | 渲染成紧凑 JSON：没有空白，数组与对象的成员顺序就是列表顺序。
export renderJson : Json -> String
renderJson JNull = "null"
renderJson (JBool b) = if b then "true" else "false"
renderJson (JNum n) = strFromInt n
renderJson (JStr s) = renderJsonString s
renderJson (JArr xs) = "[${join "," (map renderJson xs)}]"
renderJson (JObj kvs) = "{${join "," (map renderMember kvs)}}"

-- | 内部：渲染一个 `键:值` 成员。
renderMember : Pair String Json -> String
renderMember kv = "${renderJsonString (firstOf kv)}:${renderJson (secondOf kv)}"

-- | 内部：渲染带引号与转义的字符串字面量。
renderJsonString : String -> String
renderJsonString s =
  let
    body = join "" (map escapeChunk (strUnpack s))
  in "\"${body}\""

-- | 内部：单个字符的转义片段（无需转义时就是该字符本身）；控制字符走 `\u00XX`。
escapeChunk : Int -> String
escapeChunk 34 = "\\\""
escapeChunk 92 = "\\\\"
escapeChunk 10 = "\\n"
escapeChunk 9 = "\\t"
escapeChunk 13 = "\\r"
escapeChunk 8 = "\\b"
escapeChunk 12 = "\\f"
escapeChunk c = if c < 32 then "\\u${pad4 (hexLower c)}" else strPack [c]

-- | 内部：左侧补 `0` 到 4 位（`\uXXXX` 的宽度）。
pad4 : String -> String
pad4 s = repeat (4 - byteLength s) "0" ++ s

-- | 内部：字节值转两位小写十六进制。
hexLower : Int -> String
hexLower n = strPack [hexDigit (n / 16), hexDigit (n - n / 16 * 16)]

-- | 内部：0–15 转对应的小写十六进制字符码。
hexDigit : Int -> Int
hexDigit d = if d < 10 then 48 + d else 87 + d

-- ---------------------------------------------------------------
-- 解析
-- ---------------------------------------------------------------
-- 递归下降的互递归组经「返回剩余输入再递归」，SCT 看不到跨函数的结构下降，因此必须带 fuel
-- 守卫，并在同参数位递减。每步至少消费一个字符，初值按输入长度线性放大即可覆盖。
-- | 内部：解析器的 fuel 初值。
jsonFuel : List Int -> Int
jsonFuel chars = 8 * length chars + 64

-- | 解析整串 JSON：语法错误、尾随非空白字符、fuel 耗尽都返回 `Check` 错误（消息带 `json:` 前缀）。
export parseJson : String -> Check Json
parseJson source =
  let
    chars = skipJsonWs (strUnpack source)
  in case parseValue (jsonFuel chars) chars of
    ErrC e => err "json: ${diagText e}"
    OkC (Pair v rest) =>
      if length (skipJsonWs rest) == 0 then OkC v else err "json: trailing characters"

-- | 内部：跳过 JSON 允许的空白（空格 / 制表 / 换行 / 回车）。
skipJsonWs : List Int -> List Int
skipJsonWs [] = []
skipJsonWs (c :: rest) =
  if c == 32 || c == 9 || c == 10 || c == 13 then skipJsonWs rest else c :: rest

-- | 内部：按首字符分派到对象 / 数组 / 字符串 / 字面量 / 数字，返回（值, 剩余输入）。
parseValue : Int -> List Int -> Check (Pair Json (List Int))
parseValue fuel chars =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case chars of
      [] => err "unexpected end of input"
      c :: rest =>
        case c of
          123 => parseObject (fuel - 1) rest
          91 => parseArray (fuel - 1) rest
          34 => parseStringBody (fuel - 1) rest []
          116 => parseLiteral "true" (JBool True) chars
          102 => parseLiteral "false" (JBool False) chars
          110 => parseLiteral "null" JNull chars
          _ => if isDigitChar c || c == 45 then parseNumber chars else err "unexpected character ${c}"

-- | 内部：字节是否为 ASCII 数字。
isDigitChar : Int -> Bool
isDigitChar c = c >= 48 && c <= 57

-- | 内部：匹配固定字面量（`true` / `false` / `null`）并返回对应值。
parseLiteral : String -> Json -> List Int -> Check (Pair Json (List Int))
parseLiteral want value chars =
  case splitAtCharCount (strLength want) chars of
    Nothing => err "expected ${want}"
    Just (Pair got rest) =>
      if strPack got == want then OkC (Pair value rest) else err "expected ${want}"

-- | 内部：解析对象，把成员表包成 `JObj`。
parseObject : Int -> List Int -> Check (Pair Json (List Int))
parseObject fuel chars =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case parseObjectMembers (fuel - 1) chars [] of
      ErrC e => ErrC e
      OkC (Pair kvs rest) => OkC (Pair (JObj kvs) rest)

-- | 内部：解析对象成员序列（逆序累积），`}` 结束。
parseObjectMembers : Int -> List Int -> List (Pair String Json) -> Check (Pair (List (Pair String Json)) (List Int))
parseObjectMembers fuel chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case skipJsonWs chars of
      [] => err "unterminated object"
      c :: rest =>
        case c of
          125 => OkC (Pair (reverse acc) rest)
          34 => parseObjectPair (fuel - 1) rest acc
          _ => err "expected a string key in object"

-- | 内部：解析一个键（字符串）与其后的 `:`。
parseObjectPair : Int -> List Int -> List (Pair String Json) -> Check (Pair (List (Pair String Json)) (List Int))
parseObjectPair fuel chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case parseStringBody (fuel - 1) chars [] of
      ErrC e => ErrC e
      OkC (Pair keyJson rest) =>
        case skipJsonWs rest of
          [] => err "unterminated object"
          c :: rest2 => if c == 58 then parseObjectValue (fuel - 1) (jsonStrOr "" keyJson) (skipJsonWs rest2) acc else err "expected : in object"

-- | 内部：解析 `:` 之后的值，再按 `,` / `}` 决定继续或结束。
parseObjectValue : Int -> String -> List Int -> List (Pair String Json) -> Check (Pair (List (Pair String Json)) (List Int))
parseObjectValue fuel key chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case parseValue (fuel - 1) chars of
      ErrC e => ErrC e
      OkC (Pair v rest) =>
        case skipJsonWs rest of
          [] => err "unterminated object"
          c :: rest2 =>
            case c of
              44 => parseObjectMembers (fuel - 1) rest2 (Pair key v :: acc)
              125 => OkC (Pair (reverse (Pair key v :: acc)) rest2)
              _ => err "expected , or } in object"

-- | 内部：解析数组，把元素表包成 `JArr`。
parseArray : Int -> List Int -> Check (Pair Json (List Int))
parseArray fuel chars =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case parseArrayItems (fuel - 1) chars [] of
      ErrC e => ErrC e
      OkC (Pair items rest) => OkC (Pair (JArr items) rest)

-- | 内部：解析数组元素序列（逆序累积），`]` 结束。
parseArrayItems : Int -> List Int -> List Json -> Check (Pair (List Json) (List Int))
parseArrayItems fuel chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case skipJsonWs chars of
      [] => err "unterminated array"
      c :: rest => if c == 93 then OkC (Pair (reverse acc) rest) else parseArrayValue (fuel - 1) (c :: rest) acc

-- | 内部：解析一个数组元素，再按 `,` / `]` 决定继续或结束。
parseArrayValue : Int -> List Int -> List Json -> Check (Pair (List Json) (List Int))
parseArrayValue fuel chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case parseValue (fuel - 1) chars of
      ErrC e => ErrC e
      OkC (Pair v rest) =>
        case skipJsonWs rest of
          [] => err "unterminated array"
          c :: rest2 =>
            case c of
              44 => parseArrayItems (fuel - 1) rest2 (v :: acc)
              93 => OkC (Pair (reverse (v :: acc)) rest2)
              _ => err "expected , or ] in array"

-- | 内部：解析字符串体（起始引号已被消费；`acc` 是逆序字符）。
parseStringBody : Int -> List Int -> List Int -> Check (Pair Json (List Int))
parseStringBody fuel chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case chars of
      [] => err "unterminated string"
      c :: rest =>
        case c of
          34 => OkC (Pair (JStr (strPack (reverse acc))) rest)
          92 => parseEscape (fuel - 1) rest acc
          _ => parseStringBody (fuel - 1) rest (c :: acc)

-- | 内部：解析一个转义序列，把解码后的字符（或 UTF-8 字节）压回 `acc`。
parseEscape : Int -> List Int -> List Int -> Check (Pair Json (List Int))
parseEscape fuel chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case chars of
      [] => err "unterminated string"
      c :: rest =>
        case c of
          34 => parseStringBody (fuel - 1) rest (34 :: acc)
          92 => parseStringBody (fuel - 1) rest (92 :: acc)
          47 => parseStringBody (fuel - 1) rest (47 :: acc)
          98 => parseStringBody (fuel - 1) rest (8 :: acc)
          102 => parseStringBody (fuel - 1) rest (12 :: acc)
          110 => parseStringBody (fuel - 1) rest (10 :: acc)
          114 => parseStringBody (fuel - 1) rest (13 :: acc)
          116 => parseStringBody (fuel - 1) rest (9 :: acc)
          117 => parseUnicodeEscape (fuel - 1) rest acc
          _ => err "invalid escape \\${strPack [c]}"

-- | 内部：解析 `\uXXXX`，把码点按 UTF-8 编码后压回 `acc`（代理对不合并）。
parseUnicodeEscape : Int -> List Int -> List Int -> Check (Pair Json (List Int))
parseUnicodeEscape fuel chars acc =
  if fuel <= 0 then
    err "json: parser fuel exhausted (internal)"
  else
    case splitAtCharCount 4 chars of
      Nothing => err "invalid \\u escape"
      Just (Pair digits rest) =>
        case parseHex4 digits of
          Nothing => err "invalid \\u escape"
          Just code => parseStringBody (fuel - 1) rest (append (reverse (encodeUtf8 code)) acc)

-- | 内部：解析恰好 4 位十六进制数。
parseHex4 : List Int -> Maybe Int
parseHex4 digits = parseHex4Go digits 0 0

-- | 内部：逐位累加十六进制数；位数不等于 4 或遇到非十六进制字符给 `Nothing`。
parseHex4Go : List Int -> Int -> Int -> Maybe Int
parseHex4Go [] code count = if count == 4 then Just code else Nothing
parseHex4Go (c :: rest) code count =
  case hexVal c of
    Nothing => Nothing
    Just d => parseHex4Go rest (code * 16 + d) (count + 1)

-- | 内部：十六进制字符码对应的数值（接受 0-9 / a-f / A-F）。
hexVal : Int -> Maybe Int
hexVal c =
  if c >= 48 && c <= 57 then
    Just (c - 48)
  else if c >= 97 && c <= 102 then
    Just (c - 87)
  else if c >= 65 && c <= 70 then Just (c - 55) else Nothing

-- | 内部：码点的 UTF-8 编码（只处理 BMP；代理码点按 3 字节原样编码）。
encodeUtf8 : Int -> List Int
encodeUtf8 code =
  if code < 128 then
    [code]
  else if code < 2048 then
    [192 + code / 64, 128 + code - code / 64 * 64]
  else
    [224 + code / 4096, 128 + code / 64 - code / 4096 * 64, 128 + code - code / 64 * 64]

-- | 内部：解析数字（可选负号 + 整数部分 + 可选小数 / 指数）。
parseNumber : List Int -> Check (Pair Json (List Int))
parseNumber chars =
  case signOf chars of
    Pair negative rest1 =>
      case parseIntDigits rest1 0 0 of
        Pair value (Pair count rest2) =>
          if count == 0 then
            err "invalid number"
          else
            let
              signed = if negative then 0 - value else value
            in case skipNumberTail rest2 of
              Pair rest3 True => OkC (Pair (JNum signed) rest3)
              Pair rest3 False => err "invalid number"

-- | 内部：剥掉可选的负号，返回（是否为负, 剩余输入）。
signOf : List Int -> Pair Bool (List Int)
signOf (chars@(c :: rest)) = if c == 45 then Pair True rest else Pair False chars
signOf [] = Pair False []

-- | 内部：累加十进制整数，返回（数值, (位数, 余下输入)）。
parseIntDigits : List Int -> Int -> Int -> Pair Int (Pair Int (List Int))
parseIntDigits (c :: rest) acc count =
  if isDigitChar c then
    parseIntDigits rest (acc * 10 + (c - 48)) (count + 1)
  else
    Pair acc (Pair count (c :: rest))
parseIntDigits [] acc count = Pair acc (Pair count [])

-- | 内部：校验并丢弃小数与指数部分（值保持整数），返回（余下输入, 语法是否合法）。
skipNumberTail : List Int -> Pair (List Int) Bool
skipNumberTail (chars@(c :: rest)) =
  if c == 46 then
    case parseIntDigits rest 0 0 of
      Pair value (Pair count rest2) => if count == 0 then Pair chars False else skipExponent rest2
  else
    skipExponent chars
skipNumberTail [] = Pair [] True

-- | 内部：校验并丢弃指数部分（`e` / `E` + 可选符号 + 至少一位数字）。
skipExponent : List Int -> Pair (List Int) Bool
skipExponent (chars@(c :: rest)) =
  if c == 101 || c == 69 then
    let
      afterSign =
        case rest of
          s :: rest2 => if s == 43 || s == 45 then rest2 else rest
          [] => []
    in case parseIntDigits afterSign 0 0 of
      Pair value (Pair count rest3) => if count == 0 then Pair chars False else Pair rest3 True
  else
    Pair chars True
skipExponent [] = Pair [] True

-- | 内部：取前 `n` 个字符；不足 `n` 个给 `Nothing`。
splitAtCharCount : Int -> List Int -> Maybe (Pair (List Int) (List Int))
splitAtCharCount n chars = takeCount chars n []

-- | 内部：`splitAtCharCount` 的累加实现（`acc` 是逆序前缀）。
takeCount : List Int -> Int -> List Int -> Maybe (Pair (List Int) (List Int))
takeCount chars n acc =
  if n <= 0 then
    Just (Pair (reverse acc) chars)
  else
    case chars of
      [] => Nothing
      c :: rest => takeCount rest (n - 1) (c :: acc)
