-- | 产品 CLI 入口（`vuna`）：命令发现、帮助总览与路由。
--
-- 本二进制不 import 任何工具实现：`--vuna-describe` 从同目录 / `$VUNA_EXEC_PATH` / `PATH`
-- 上的 `vuna-*` 插件收集命令表，`vuna <cmd>` 原样转交给拥有该命令的插件进程。
-- 自带的命令只有 `help` 与 `version`。
module Vuna.Cli where

import Vuna.Cli.Discover
import Vuna.Plugin.Command
import Vuna.Plugin.Describe
import Vuna.Plugin.Err
import Vuna.Plugin.Help
import Vuna.Plugin.Suggest
import Vuna.Compiler.Base.Version
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Base.Data.Bool as Bool
import Base.Effect.Args as EffArgs
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Env as EffEnv
import Base.Effect.Exit as EffExit
import Base.Effect.Fs as EffFs
import Base.Effect.Net as EffNet
import Base.Effect.Process as EffProcess
import Base.Effect.Stdin as EffStdin
import Base.Effect.Types as EffTypes
import Base.Effect.Tty as EffTty

-- | 入口自带的命令（其余全部来自插件）。
ownCommands : List Cmd
ownCommands =
  [
    topCmd ["version"] GMeta "显示版本" "vuna version | --version" [] [],
    topCmd ["help"] GMeta "显示帮助" "vuna help [<command>...]" [] []
  ]

-- | 合并命令表：插件命令在前，自带命令插在 `dev` 分节之前（保持帮助分节顺序）。
tableOf : List Plugin -> List Cmd
tableOf plugins = insertOwn (concatCommands plugins)

-- | 内部：把自带命令插到第一个 `dev` 命令之前。
insertOwn : List Cmd -> List Cmd
insertOwn cmds = append (takeNonDev cmds) (append ownCommands (dropNonDev cmds))

-- | 内部：`dev` 分节之前的命令。
takeNonDev : List Cmd -> List Cmd
takeNonDev [] = []
takeNonDev (c :: rest) = if isDevCmd c then [] else c :: takeNonDev rest

-- | 内部：从第一个 `dev` 命令开始（含）。
dropNonDev : List Cmd -> List Cmd
dropNonDev [] = []
dropNonDev (c :: rest) = if isDevCmd c then c :: rest else dropNonDev rest

-- | 内部：是否属于 `dev` 分节。
isDevCmd : Cmd -> Bool
isDevCmd c = groupName c.cmdGroup == "dev"

-- | 内部：拼接各插件的命令。
concatCommands : List Plugin -> List Cmd
concatCommands [] = []
concatCommands (p :: rest) = append p.pluginCommands (concatCommands rest)

-- | CLI 总入口：版本与帮助优先，其余路由到插件。
export runCli : List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
runCli args =
  case args of
    ["version"] => printVersion
    ["--version"] => printVersion
    _ =>
      do
        plugins <- discoverPlugins
        let
          cmds = tableOf plugins
        in let
          route = args
        in case helpPathIn 3 cmds route of
          Just path => helpOut plugins cmds path
          Nothing => dispatch plugins cmds args route

-- | 内部：分发——元命令就地处理，其余查插件。
dispatch : List Plugin -> List Cmd -> List String -> List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
dispatch plugins cmds args route =
  case route of
    [] =>
      do
        _ <- consolePrint (renderOverview cmds)
        pure 2
    "help" :: rest => helpCommand plugins cmds rest
    ["--vuna-describe"] => printText (Describe.render "vuna" cmds)
    "--vuna-describe" :: file :: more => writeDescribe file cmds
    arg :: _ =>
      case findOwner 3 route plugins of
        Just p => processRunIn "." (append [p.pluginBinary] args)
        Nothing =>
          case removedHint arg of
            Just hint => removedCommand arg hint
            Nothing =>
              if startsWith "-" arg then compilerFallback plugins args else unknownCommand cmds arg

-- | 内部：`vuna help <command>...`——解析成已登记路径后打印。
helpCommand : List Plugin -> List Cmd -> List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
helpCommand plugins cmds [] = helpOut plugins cmds []
helpCommand plugins cmds rest =
  case matchCommandIn 3 rest cmds of
    Just (c, _) => helpOut plugins cmds c.cmdPath
    Nothing => unknownCommand cmds (join " " rest)

-- | 内部：打印某路径的帮助。`[]` 是总览；delegated 命令转交插件（它才知道编译器 flag）。
helpOut : List Plugin -> List Cmd -> List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
helpOut plugins cmds path =
  if path == [] then
    printText (renderOverview cmds)
  else
    case findCmdIn path cmds of
      Nothing => unknownCommand cmds (join " " path)
      Just c => if c.cmdDelegated then delegatedHelpOut plugins c else localHelp cmds path

-- | 内部：本地渲染（表里已有全部元数据）。
localHelp : List Cmd -> List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
localHelp cmds path =
  case helpForPathIn cmds noDelegated path of
    Just text => printText text
    Nothing => unknownCommand cmds (join " " path)

-- | 内部：delegated 命令的帮助——转交拥有它的插件（`<path> --help`）。
delegatedHelpOut : List Plugin -> Cmd -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
delegatedHelpOut plugins c =
  do
    _ <- consolePrint (delegatedHeader c)
    case findOwner 3 c.cmdPath plugins of
      Just p => processRunIn "." (append [p.pluginBinary] (append c.cmdPath ["--help"]))
      Nothing => pure 2

-- | 内部：delegated 命令的帮助抬头（正文由插件打印）。
delegatedHeader : Cmd -> String
delegatedHeader c = "${c.cmdSynopsis}\n\n${c.cmdSummary}。flag 由编译器实现解析：\n\n"

-- | 内部：永远不会被调用的 delegated 正文（delegated 命令走转发）。
noDelegated : Cmd -> String
noDelegated _ = ""

-- | 内部：按最长前缀找拥有该命令的插件（最多 3 段）。
findOwner : Int -> List String -> List Plugin -> Maybe Plugin
findOwner depth args plugins =
  if depth <= 0 then
    Nothing
  else
    case ownerAt (take depth args) plugins of
      Just p => Just p
      Nothing => findOwner (depth - 1) args plugins

-- | 内部：某个路径的拥有者。
ownerAt : List String -> List Plugin -> Maybe Plugin
ownerAt path [] = Nothing
ownerAt path (p :: rest) =
  case findCmdIn path p.pluginCommands of
    Just _ => Just p
    Nothing => ownerAt path rest

-- | 内部：把合并命令表写到 `file`（`--vuna-describe FILE`）。
writeDescribe : String -> List Cmd -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
writeDescribe file cmds =
  do
    _ <- fsWriteFile file (Describe.render "vuna" cmds)
    pure 0

-- | 内部：打印文本并返回 0。
printText : String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
printText text =
  do
    _ <- consolePrint text
    pure 0

-- | 内部：打印版本号并返回 0。版本唯一真源在编译器包（`Vuna.Compiler.Base.Version`）。
printVersion : Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
printVersion = printText "vuna ${vunaVersion}\n"

-- | 内部：已改名命令的迁移提示（旧名字不再分发）。
removedHint : String -> Maybe String
removedHint name =
  if name == "seed" then
    Just "use `vuna build --out OUT [DIR]` or `vuna compile DIR OUT`"
  else if name == "gen-errors" then
    Just "run `vuna dev errors gen [ROOT]`"
  else if name == "explain" then
    Just "run `vuna errors explain <CODE>` or `vuna errors list`"
  else if name == "fetch" then
    Just "run `vuna deps fetch`"
  else if name == "add" then
    Just "run `vuna deps add <name>[@<version>] [DIR]`"
  else if name == "pin" then
    Just "run `vuna deps pin [DIR]`"
  else if name == "clean" then Just "run `vuna store clean`" else Nothing

-- | 内部：未知命令文案（附最近候选）。
unknownCommandText : List Cmd -> String -> String
unknownCommandText cmds arg =
  case suggestOne (topLevelNamesOf cmds) arg of
    Just guess => "error: unknown command `${arg}`; did you mean `${guess}`?\nrun `vuna help`\n"
    Nothing => "error: unknown command `${arg}`\nrun `vuna help`\n"

-- | 内部：未知命令（附最近候选与帮助提示），返回 2。
unknownCommand : List Cmd -> String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
unknownCommand cmds arg =
  do
    _ <- consolePrint (unknownCommandText cmds arg)
    pure 2

-- | 内部：裸 flag（`vuna --typed` 这类）转给编译器插件——已删 flag 的提示真源在它那里。
compilerFallback : List Plugin -> List String -> Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, StdinOp, ArgsOp, NetOp, TtyOp] Int
compilerFallback plugins args =
  case findByDomain "compiler" plugins of
    Just p => processRunIn "." (append [p.pluginBinary] args)
    Nothing =>
      do
        _ <-
          consolePrint
            "error: no compiler plugin installed (vuna-compiler is required for compiler commands)\n"
        pure 2

-- | 内部：按域找插件（裸 flag 转交用）。
findByDomain : String -> List Plugin -> Maybe Plugin
findByDomain domain [] = Nothing
findByDomain domain (p :: rest) =
  if p.pluginDomain == domain then Just p else findByDomain domain rest
