-- | 产品 CLI（`vuna`）：命令分发与帮助入口。
--
-- 命令面的元数据（摘要、用法、flag 表）在 `Vuna.Cli.Spec`，帮助渲染在 `Vuna.Cli.Help`，
-- 工具命令的错误出口在 `Vuna.Cli.Err`；本模块只做两件事：解析 argv 走到对应实现，
-- 以及 `help` / `--version` / 未知命令这类元命令。
--
-- 编译器命令（`compile` / `check` / `build`）的 argv 原样转交
-- `Vuna.Compiler.Driver.CompilerCli`（flag 真源在编译器包里）；工具命令在各自的
-- `Vuna.Cli.*` / 工具模块里解析。`vuna dev` 是本仓库专用的开发命名空间（`Vuna.Cli.Dev`）。
--
-- 退出码：0 成功 / 1 被检查代码或查询的语义失败 / 2 用法、参数、输入路径或不满足命令前提。
module Vuna.Cli where

import Vuna.Cli.Args
import Vuna.Cli.Dev
import Vuna.Cli.Err
import Vuna.Cli.Fmt
import Vuna.Cli.Help
import Vuna.Cli.Index
import Vuna.Cli.Repl
import Vuna.Cli.Spec
import Vuna.Cli.Suggest
import Vuna.Cli.Test
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Driver.CompilerCli
import Vuna.Compiler.Base.Version
import Vuna.Add
import Vuna.Clean
import Vuna.Doc
import Vuna.Explain
import Vuna.Fetch
import Vuna.Lint
import Vuna.Lsp
import Vuna.Run
import Vuna.Search
import Base.Pair
import Base.EffArgs
import Base.EffClock
import Base.EffConsole
import Base.EffEnv
import Base.EffExit
import Base.EffFs
import Base.EffNet
import Base.EffProcess
import Base.EffStdin
import Base.Eff.Types

-- | CLI 总入口：去掉隐藏的性能旗标，`-h` / `--help` 优先，其余交给命令分发。
export runCli : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nStdin StdinOp r, Member nArgs ArgsOp r, Member nNet NetOp r => List String -> Eff r Int
runCli args = case helpPath args of
  Just path => printHelp path
  Nothing => dispatch (stripPerfFlags args)

-- | 内部：`--debug-perf` 由 runtime 原语读原始 argv/env，不参与子命令分发。
stripPerfFlags : List String -> List String
stripPerfFlags [] = []
stripPerfFlags (a :: rest) =
  if a == "--debug-perf" then stripPerfFlags rest else (::) a (stripPerfFlags rest)

-- | 内部：`-h` / `--help` 之前的可见参数（`--` 之后不参与），解析成命令路径。
--
-- `vuna lint --help` → `["lint"]`；`vuna --help` → `[]`；`vuna run pkg -- --help`
-- 的 `--help` 在 `--` 之后，不触发帮助。
helpPath : List String -> Maybe (List String)
helpPath args = case beforeHelp (helpSurface args) of
  Nothing => Nothing
  Just tokens => Just (resolvedPath tokens)

-- | 内部：帮助扫描的可见区间——`--` 之前的部分。
helpSurface : List String -> List String
helpSurface [] = []
helpSurface ("--" :: rest) = []
helpSurface (arg :: rest) = (::) arg (helpSurface rest)

-- | 内部：帮助旗标之前的参数（保持顺序）；没有帮助旗标给 `Nothing`。
beforeHelp : List String -> Maybe (List String)
beforeHelp [] = Nothing
beforeHelp ("-h" :: _) = Just []
beforeHelp ("--help" :: _) = Just []
beforeHelp (arg :: rest) = case beforeHelp rest of
  Nothing => Nothing
  Just prior => Just (arg :: prior)

-- | 内部：把帮助旗标之前的参数收敛成已登记的命令路径（匹配不到就是总览）。
resolvedPath : List String -> List String
resolvedPath tokens = case matchCommand tokens of
  Just (Pair c _) => c.cmdPath
  Nothing => []

-- | 内部：打印某个路径的帮助；`[]` 是总览。
printHelp : Member nConsole ConsoleOp r => List String -> Eff r Int
printHelp [] = printText overviewText
printHelp path = case helpForPath path of
  Just text => printText text
  Nothing => unknownCommand (joinWords path)

-- | 内部：打印文本并返回 0。
printText : Member nConsole ConsoleOp r => String -> Eff r Int
printText text = do
  _ <- consolePrint text
  pure 0

-- | 内部：打印一行并返回 0。
consoleLine : Member nConsole ConsoleOp r => String -> Eff r Int
consoleLine msg = consolePrint msg >>= (\_ => pure 0)

-- | 内部：打印版本号并返回 0。版本唯一真源在编译器包（`Vuna.Compiler.Base.Version`）。
printVersion : Member nConsole ConsoleOp r => Int -> Eff r Int
printVersion _ = consoleLine "vuna ${vunaVersion}\n"

-- | 内部：命令分发表——每条命令一行；编译器命令原样转交 `CompilerCli`。
dispatch : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nStdin StdinOp r, Member nArgs ArgsOp r, Member nNet NetOp r => List String -> Eff r Int
dispatch args = case args of
  [] => do
    _ <- consolePrint overviewText
    pure 2
  "help" :: rest => helpCommand rest
  "version" :: _ => printVersion 0
  "--version" :: _ => printVersion 0
  "compile" :: rest => runCompilerCliFor "vuna" ("compile" :: rest)
  "check" :: rest => runCompilerCliFor "vuna" ("check" :: rest)
  "build" :: rest => runCompilerCliFor "vuna" ("build" :: rest)
  "run" :: rest => Vuna.Run.runRun rest
  "test" :: rest => testArgs rest
  "fmt" :: rest => fmtArgs rest
  "lint" :: rest => Vuna.Lint.runLint rest
  "doc" :: rest => Vuna.Doc.runDoc rest
  "search" :: rest => Vuna.Search.runSearch rest
  "map" :: rest => mapArgs rest
  "api" :: rest => apiArgs rest
  "goal" :: rest => goalArgs rest
  "errors" :: rest => errorsArgs rest
  "deps" :: rest => depsArgs rest
  "store" :: rest => storeArgs rest
  "repl" :: rest => replArgs rest
  "lsp" :: rest => Vuna.Lsp.runLspTool rest
  "dev" :: rest => devArgs rest
  arg :: _ => case removedHint arg of
    Just hint => removedCommand arg hint
    Nothing => if startsWith "-" arg then runCompilerCliFor "vuna" args else unknownCommand arg

-- | 内部：`vuna help <command>...`——解析成已登记路径后打印。
helpCommand : Member nConsole ConsoleOp r => List String -> Eff r Int
helpCommand [] = printText overviewText
helpCommand rest = case matchCommand rest of
  Just (Pair c _) => printHelp c.cmdPath
  Nothing => unknownCommand (joinWords rest)

-- | 内部：`vuna errors` 子命令。
errorsArgs : Member nFs FsOp r, Member nConsole ConsoleOp r => List String -> Eff r Int
errorsArgs ("list" :: more) = Vuna.Explain.runExplainList more
errorsArgs ("explain" :: more) = Vuna.Explain.runExplainCode more
errorsArgs [] = usageErrorFor ["errors"]
errorsArgs (bad :: _) = unknownSubcommand ["errors"] bad ["list", "explain"]

-- | 内部：`vuna deps` 子命令。
depsArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
depsArgs ("add" :: more) = Vuna.Add.runAdd more
depsArgs ("fetch" :: more) = Vuna.Fetch.runFetch more
depsArgs ("pin" :: more) = Vuna.Fetch.runPin more
depsArgs [] = usageErrorFor ["deps"]
depsArgs (bad :: _) = unknownSubcommand ["deps"] bad ["add", "fetch", "pin"]

-- | 内部：`vuna store` 子命令。
storeArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
storeArgs ("gc" :: more) = Vuna.Clean.runStoreGc more
storeArgs ("clean" :: more) = Vuna.Clean.runClean more
storeArgs [] = usageErrorFor ["store"]
storeArgs (bad :: _) = unknownSubcommand ["store"] bad ["gc", "clean"]

-- | 内部：已改名命令的迁移提示（旧名字不再分发）。
removedHint : String -> Maybe String
removedHint name =
  if name == "seed" then Just "use `vuna build --out OUT [DIR]` or `vuna compile DIR OUT`"
  else if name == "gen-errors" then Just "run `vuna dev errors gen [ROOT]`"
  else if name == "explain" then Just "run `vuna errors explain <CODE>` or `vuna errors list`"
  else if name == "fetch" then Just "run `vuna deps fetch`"
  else if name == "add" then Just "run `vuna deps add <name>[@<version>] [DIR]`"
  else if name == "pin" then Just "run `vuna deps pin [DIR]`"
  else if name == "clean" then Just "run `vuna store clean`" else Nothing

-- | 内部：未知命令（附最近候选与帮助提示），返回 2。
unknownCommand : Member nConsole ConsoleOp r => String -> Eff r Int
unknownCommand arg = do
  _ <- consolePrint (unknownCommandText arg)
  pure 2

-- | 内部：未知命令文案。
unknownCommandText : String -> String
unknownCommandText arg = case suggestOne topLevelNames arg of
  Just guess => "error: unknown command `${arg}`; did you mean `${guess}`?\nrun `vuna help`\n"
  Nothing => "error: unknown command `${arg}`\nrun `vuna help`\n"

-- | 内部：路径用空格拼接。
joinWords : List String -> String
joinWords [] = ""
joinWords (one :: rest) = if rest == [] then one else "${one} ${joinWords rest}"
