-- | `vuna dev`：本仓库专用的开发/维护命令（suite、观测、错误码文档生成）。
--
-- 这些命令的输入是 vuna 自己的仓库布局与内部词汇（`test/suite.toml`、`VUNA_OBS` span、
-- 错误码枚举），普通用户的项目里不成立，因此在帮助里单独成节，并且是唯一被
-- `Vuna.Cli.Product` 隔离的命名空间（`nix/checks/lib/product-boundary.sh` 保证产品侧
-- 模块不 import 本模块）。
module Vuna.Cli.Dev where

import Vuna.Cli.Args
import Vuna.Cli.Err
import Vuna.Cli.Spec
import Vuna.Cli.Suite
import Vuna.Compiler.Base.Common
import Vuna.Cli.IrDump
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.GenErrors
import Vuna.Obs
import Base.Effect.Args as EffArgs
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Env as EffEnv
import Base.Effect.Exit as EffExit
import Base.Effect.Fs as EffFs
import Base.Effect.Net as EffNet
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes

-- | `vuna dev <sub>` 的入口。
export devArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r, Member nNet NetOp r => List String -> Eff r Int
devArgs ("suite" :: more) = suiteArgs more
devArgs ("obs" :: more) = runObs more
devArgs ("ir" :: "dump" :: more) = irDumpArgs more
devArgs ("errors" :: "gen" :: genArgs) = genErrorsArgs genArgs
devArgs (["errors"]) = usageErrorFor ["dev", "errors"]
devArgs ("errors" :: bad :: _) = unknownSubcommand ["dev", "errors"] bad ["gen"]
devArgs [] = usageErrorFor ["dev"]
devArgs (bad :: _) = unknownSubcommand ["dev"] bad ["suite", "obs", "errors", "ir"]

-- | `vuna dev ir dump [--out FILE] DIR`：检查 + lowering 后打印确定性 IR。
irDumpArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
irDumpArgs rest = dumpGo Nothing "raw" [] rest

dumpGo : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Maybe String -> String -> List String -> List String -> Eff r Int
dumpGo out after dirs rest =
  case rest of
    "--out" :: path :: more => dumpGo (Just path) after dirs more
    "--after" :: a :: more => dumpGo out a dirs more
    x :: more => dumpGo out after (x :: dirs) more
    [] =>
      case reverse dirs of
        [dir] => runDump out after dir
        _ => usageErrorFor ["dev", "ir", "dump"]

runDump : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Maybe String -> String -> String -> Eff r Int
runDump out after dir =
  do
    pkgR <- loadPackage dir
    case pkgR of
      ErrC e => toolError (diagText e)
      OkC pkg =>
        do
          r <- dumpIr after (packageContext pkg) (packageEntry pkg)
          case r of
            ErrC e => toolError (diagText e)
            OkC text =>
              case out of
                Just path =>
                  do
                    _ <- fsWriteFile path text
                    _ <- consolePrint "wrote ${path}\n"
                    pure 0
                Nothing =>
                  do
                    _ <- consolePrint (text ++ "\n")
                    pure 0

-- | 内部：`vuna dev errors gen [ROOT]`——ROOT 默认 `.`。
genErrorsArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => List String -> Eff r Int
genErrorsArgs rest =
  case parseCmdArgs ["dev", "errors", "gen"] rest of
    ErrC e => toolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [] => runGenErrors "."
        [root] => runGenErrors root
        _ => usageErrorFor ["dev", "errors", "gen"]
