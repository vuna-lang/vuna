-- | CLI 命令面的单一真源：分组、摘要、用法、flag 表与帮助元数据。
--
-- 帮助文本、未知 flag 的校验都从这里读：命令实现只调用 [Vuna.Cli.Spec.parseCmdArgs]，
-- 不再各自维护一份 flag 列表。分发（`Vuna.Cli`）按命令路径显式接线，和本表共享同一组
-- 路径字符串；新增命令时两处都要改，`test/suite` 的 `cli` 章节会逐条跑 `vuna help <path>`
-- 与 `vuna <path>` 把漏接线暴露出来。
--
-- 编译器命令（`check` / `build` / `compile`）的 flag 由编译器包解析，本表只记摘要与
-- 用法；它们的详细帮助由 [Vuna.Cli.Help] 转发编译器用法文本（零重复）。
module Vuna.Cli.Spec where

import Vuna.Cli.Args
import Vuna.Compiler.Base.Common
import Base.Data.List as List
import Base.Data.String as String
import Base.Data.Bool as Bool

-- | 帮助里的一节。
export data Group(..) : Type where
  -- | 日常循环。
  GCore : Group
  -- | 文档与导航。
  GInspect : Group
  -- | 依赖与缓存。
  GDeps : Group
  -- | 交互与服务。
  GService : Group
  -- | 帮助与版本。
  GMeta : Group
  -- | 开发/维护（默认只列出入口一行）。
  GDev : Group

-- | 一节的标题（顺序由 [Vuna.Cli.Help] 固定）。
export groupTitle : Group -> String
groupTitle GCore = "核心循环"
groupTitle GInspect = "文档与导航"
groupTitle GDeps = "依赖与缓存"
groupTitle GService = "交互与服务"
groupTitle GMeta = "帮助与版本"
groupTitle GDev = "开发与维护"

-- | 一个 flag 的帮助条目：解析形态 + 取值占位（开关为空串）+ 一行说明。
export record FlagDoc(..) where
  -- | 解析形态（名字不带 `--`）。
  flagSpec : ArgSpec
  -- | 取值占位（`<Module.name>` / `<N>` / `cpu|mem`）；开关为空串。
  flagMeta : String
  -- | 一行说明。
  flagHelp : String

-- | 一条命令（或命令分支）的帮助元数据。
export record Cmd(..) where
  -- | 命令路径（不含程序名），如 `["map", "find"]`。
  cmdPath : List String
  -- | 所属帮助分组。
  cmdGroup : Group
  -- | 一行摘要。
  cmdSummary : String
  -- | 用法行（含程序名）。
  cmdSynopsis : String
  -- | 允许的 flag。
  cmdFlags : List FlagDoc
  -- | 补充说明（逐行）。
  cmdNotes : List String
  -- | 是否出现在总览里（子命令只在 `vuna help <父>` 里列）。
  cmdInOverview : Bool
  -- | flag 与帮助由编译器实现提供（`check` / `build` / `compile`）。
  cmdDelegated : Bool

-- | 内部：开关类 flag。
boolFlag : String -> String -> FlagDoc
boolFlag name help = FlagDoc (BoolFlag name) "" help

-- | 内部：取单值 flag。
valueFlag : String -> String -> String -> FlagDoc
valueFlag name meta help = FlagDoc (ValueFlag name) meta help

-- | 内部：可重复取值 flag。
multiFlag : String -> String -> String -> FlagDoc
multiFlag name meta help = FlagDoc (MultiValueFlag name) meta help

-- | 内部：构造一条命令。
mkCmd : List String -> Group -> String -> String -> List FlagDoc -> List String -> Bool -> Bool -> Cmd
mkCmd path group summary synopsis flags notes overview delegated =
  Cmd path group summary synopsis flags notes overview delegated

-- | 内部：构造一条不接线的子命令（帮助里有、总览里不列）。
subCmd : List String -> Group -> String -> String -> List FlagDoc -> List String -> Cmd
subCmd path group summary synopsis flags notes =
  mkCmd path group summary synopsis flags notes False False

-- | 内部：构造一条总览里的命令。
topCmd : List String -> Group -> String -> String -> List FlagDoc -> List String -> Cmd
topCmd path group summary synopsis flags notes =
  mkCmd path group summary synopsis flags notes True False

-- | 内部：构造一条归编译器解析的命令。
delegatedCmd : String -> String -> String -> Cmd
delegatedCmd name summary synopsis = mkCmd [name] GCore summary synopsis [] [] True True

