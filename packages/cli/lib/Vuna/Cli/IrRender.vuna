module Vuna.Cli.IrRender where

-- IR 的确定性调试文本（`vuna dev ir dump` 用）。
-- 只用于 diff / 观测，不是后端输入，也不承诺稳定 ABI；随 IrDump 一起留在 cli 包。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Compiler.Ir.Model

bNameText : IrBName -> String
bNameText (IrBUser s) = s
bNameText (IrBArm i) = "a" ++ strFromInt i
bNameText (IrBNat i) = "n" ++ strFromInt i
bNameText IrBWild = "_"

binderText : IrBinder -> String
binderText b =
  if b.irBinderErased then
    "_"
  else
    case b.irBinderTy of
      Nothing => bNameText b.irBinderName
      Just ty => bNameText b.irBinderName ++ ":" ++ tyTextMaybe (Just ty)

binderList : List IrBinder -> String
binderList bs = String.join " " (map binderText bs)

ctorText : Maybe (Pair String String) -> String
ctorText Nothing = "*"
ctorText (Just p) = firstOf p ++ "." ++ secondOf p

tyText : IrTy -> String
tyText (IrTyVar i) = "'" ++ strFromInt i
tyText IrTyInt = "Int"
tyText IrTyStr = "String"
tyText IrTyBool = "Bool"
tyText IrTyFloat = "Float"
tyText IrTyOpaque = "Opaque"
tyText (IrTyArray x) = "Array " ++ tyText x
tyText (IrTyRef x) = "Ref " ++ tyText x
tyText (IrTyData n args) = n ++ " " ++ String.join " " (map tyText args)
tyText (IrTyFun a b) = "(" ++ tyText a ++ " -> " ++ tyText b ++ ")"

tyTextMaybe : Maybe IrTy -> String
tyTextMaybe Nothing = "?"
tyTextMaybe (Just ty) = tyText ty

tyListText : Maybe (List IrTy) -> String
tyListText Nothing = "?"
tyListText (Just tys) = "[" ++ String.join "," (map tyText tys) ++ "]"

appTyText : Maybe (Pair IrTy IrTy) -> String
appTyText Nothing = "?"
appTyText (Just p) = tyText (firstOf p) ++ "->" ++ tyText (secondOf p)

renderAlt : Int -> IrAlt -> String
renderAlt fuel a =
  if fuel <= 0 then
    "..."
  else
    "("
      ++ ctorText a.irAltCtor
      ++ "[" ++ binderList a.irAltBinders ++ "] " ++ renderIr (fuel - 1) a.irAltBody ++ ")"

renderAltM : Int -> Maybe IrAlt -> String
renderAltM fuel m =
  if fuel <= 0 then
    "..."
  else
    case m of
      Nothing => "-"
      Just a => renderAlt (fuel - 1) a

renderList : Int -> List Ir -> String
renderList fuel xs =
  if fuel <= 0 then
    "..."
  else
    case xs of
      [] => ""
      [x] => renderIr (fuel - 1) x
      x :: rest => renderIr (fuel - 1) x ++ " " ++ renderList (fuel - 1) rest

renderFields : Int -> List (Pair String Ir) -> String
renderFields fuel fs =
  if fuel <= 0 then
    "..."
  else
    case fs of
      [] => ""
      p :: rest => firstOf p ++ "=" ++ renderIr (fuel - 1) (secondOf p) ++ " " ++ renderFields (fuel - 1) rest

renderApp : Int -> Ir -> Pair String String
renderApp fuel e =
  if fuel <= 0 then
    Pair "..." ""
  else
    case e of
      IrApp _ f a =>
        let
          p = renderApp (fuel - 1) f
        in Pair (firstOf p) (secondOf p ++ " " ++ renderIr (fuel - 1) a)
      _ => Pair (renderIr (fuel - 1) e) ""

renderIr : Int -> Ir -> String
renderIr fuel e =
  if fuel <= 0 then
    "..."
  else
    case e of
      IrVar b => "v:" ++ binderText b
      IrGlobal n => "g:" ++ n
      IrCtor fam ctor tys args => "(ctor " ++ fam ++ "." ++ ctor ++ " " ++ tyListText tys ++ " " ++ renderList (fuel - 1) args ++ ")"
      IrRecord fam resTy fs => "(record " ++ fam ++ ":" ++ tyTextMaybe resTy ++ " " ++ renderFields (fuel - 1) fs ++ ")"
      IrProj b fam f resTy => "(proj " ++ renderIr (fuel - 1) b ++ " " ++ fam ++ "." ++ f ++ ":" ++ tyTextMaybe resTy ++ ")"
      IrRecUpd b fam fs resTy => "(upd " ++ renderIr (fuel - 1) b ++ " " ++ fam ++ ":" ++ tyTextMaybe resTy ++ " " ++ renderFields (fuel - 1) fs ++ ")"
      IrRt s => "rt:" ++ s
      IrRtApp s args => "(rtapp " ++ s ++ " " ++ renderList (fuel - 1) args ++ ")"
      IrCast cFrom cTo x => "(cast " ++ tyTextMaybe cFrom ++ "->" ++ tyTextMaybe cTo ++ " " ++ renderIr (fuel - 1) x ++ ")"
      IrInt n => "i" ++ strFromInt n
      IrStr s => "s:" ++ s
      IrBool b => if b then "true" else "false"
      IrFloatLit s => "f:" ++ s
      IrLet bs rhs body => "(let [" ++ binderList bs ++ "] " ++ renderIr (fuel - 1) rhs ++ " " ++ renderIr (fuel - 2) body ++ ")"
      IrLam bs rt body => "(lam [" ++ binderList bs ++ "]:" ++ tyTextMaybe rt ++ " " ++ renderIr (fuel - 1) body ++ ")"
      IrApp appTy _ _ =>
        let
          p = renderApp (fuel - 1) e
        in "(app " ++ appTyText appTy ++ " " ++ firstOf p ++ " " ++ secondOf p ++ ")"
      IrIf c t el => "(if " ++ renderIr (fuel - 1) c ++ " " ++ renderIr (fuel - 2) t ++ " " ++ renderIr (fuel - 3) el ++ ")"
      IrCase caseTy resultTy s alts => "(case " ++ tyTextMaybe caseTy ++ "->" ++ tyTextMaybe resultTy ++ " " ++ renderIr (fuel - 1) s ++ " " ++ String.join " " (map (renderAlt (fuel - 2)) alts) ++ ")"
      IrNatCase s _ z su ca => "(natcase " ++ renderIr (fuel - 1) s ++ " " ++ renderAltM (fuel - 2) z ++ " " ++ renderAltM (fuel - 2) su ++ " " ++ renderAltM (fuel - 2) ca ++ ")"
      IrConcatMany xs => "(cat " ++ renderList (fuel - 1) xs ++ ")"
      IrEffThunk fam ctor _ arity prim => "(effthunk " ++ fam ++ "." ++ ctor ++ "/" ++ strFromInt arity ++ " " ++ renderIr (fuel - 1) prim ++ ")"
      IrEffBind fam ctor _ => "(effbind " ++ fam ++ "." ++ ctor ++ ")"

export renderDef : IrDef -> String
renderDef (IrExternDef n ty c _) = "extern " ++ n ++ " : " ++ tyText ty ++ " = " ++ c

defSigText : Maybe IrTy -> String
defSigText Nothing = ""
defSigText (Just t) = " : " ++ tyText t

renderDef (IrDef n ar _ ty body _ _ _) =
  "def " ++ n ++ "/" ++ strFromInt ar ++ defSigText ty ++ " = " ++ renderIr 2000 body

renderTyDecl : IrTyDecl -> String
renderTyDecl (IrVariantDecl n p ctors) =
  "variant "
    ++ n
    ++ "/"
    ++ strFromInt p
    ++ " "
    ++ String.join
      " "
      (map (\c => firstOf c ++ "(" ++ String.join "," (map tyText (secondOf c)) ++ ")") ctors)
renderTyDecl (IrRecordDecl n p _ tys) =
  "record " ++ n ++ "/" ++ strFromInt p ++ " " ++ String.join "," (map tyText tys)
renderTyDecl (IrUnboxedDecl n p ty) = "unboxed " ++ n ++ "/" ++ strFromInt p ++ " " ++ tyText ty

export renderDefs : List IrDef -> String
renderDefs defs = String.join "\n" (map renderDef defs)

export renderProgram : IrProgram -> String
renderProgram p =
  let
    u = irProgUnitOf p
    defs = concatMap irGroupDefs u.irUnitGroups
    entry =
      case u.irUnitEntry of
        Nothing => "entry none"
        Just e =>
          "entry main="
            ++ irEntryMainOf e
            ++ " action="
            ++ (if irEntryIsActionOf e then "1" else "0")
            ++ " rows=[" ++ String.join "," (irEntryRowTagsOf e) ++ "]"
  in String.join
    "\n"
    (append (append ["-- types"] (map renderTyDecl u.irUnitTyDecls)) (append ["-- entry", entry, "-- defs"] (map renderDef defs)))
