-- | `vuna test`：包内 `test/*.vuna` 的参数面与目录 / workspace 展开。
--
-- 执行器在 `Vuna.TestRunner`；本模块只解析参数、校验目录、决定单包还是逐成员运行。
-- 仓库原生 suite 不在这里（见 `vuna dev suite`）。
module Vuna.Cli.Test where

import Vuna.Cli.Args
import Vuna.Cli.Err
import Vuna.Cli.Parse
import Vuna.Cli.Spec
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.TestRunner
import Base.EffClock
import Base.EffConsole
import Base.EffEnv
import Base.EffFs
import Base.EffProcess
import Base.Eff.Types

-- | `vuna test [DIR]` 的入口：位置参数至多一个目录（缺省 `.`）。
export testArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
testArgs rest = case parseCmdArgs ["test"] rest of
  ErrC e => toolError (diagText e)
  OkC parsed => case testJobsOf parsed of
    ErrC e => toolError (diagText e)
    OkC jobs => case parsed.positionals of
      [] => testRun (testOptsOf parsed jobs) "."
      [dir] => testRun (testOptsOf parsed jobs) dir
      _ => usageErrorFor ["test"]

-- | 内部：包模式的 `--jobs N`——缺省 1；必须是 >= 1 的十进制整数。
testJobsOf : Parsed -> Check Int
testJobsOf parsed = case flagValue parsed "jobs" of
  Nothing => OkC 1
  Just text => case parsePositiveInt text of
    Nothing => err "--jobs requires a positive integer (>= 1), got `${text}`"
    Just n => OkC n

-- | 内部：把解析结果摊平成包内测试选项——`--only-file` 出现时强制单进程。
testOptsOf : Parsed -> Int -> TestOpts
testOptsOf parsed jobs =
  TestOpts (flagValues parsed "filter") (flagSet parsed "list") (flagSet parsed "verbose")
    (flagSet parsed "fail-fast") (if flagSet parsed "only-file" then 1 else jobs)
    (flagValue parsed "only-file")

-- | 内部：在一个目录上运行包内测试——目录必须先存在（exit 2），manifest 载入失败 exit 1。
-- 虚拟 workspace 根没有包：对成员逐个跑（只有一个成员时按单包跑）。
testRun : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => TestOpts -> String -> Eff r Int
testRun opts dir = do
  dirR <- requireDirectory dir
  case dirR of
    ErrC e => toolError (diagText e)
    OkC _ => do
      workspaceR <- loadWorkspace dir
      case workspaceR of
        ErrC e => toolFailure (diagText e)
        OkC workspace => case workspace.workspaceRoot of
          Just pkg => runTests opts pkg
          Nothing => case workspace.workspaceMembers of
            [] => toolFailure "workspace has no packages"
            [only] => runTests opts only
            pkgs => runWorkspaceTests opts pkgs
