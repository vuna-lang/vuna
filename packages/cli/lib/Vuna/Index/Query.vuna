-- | 符号查找（全名 / 裸名 / 后缀）、位置查询（`referencesAt`）与改动影响面。
--
-- 影响面直接读 [Vuna.Index.Scan] 预先算好的 refs 反向边，不重新解析源码；本模块全是纯函数。
module Vuna.Index.Query where

import Vuna.Compiler.Base.Common
import Vuna.Index.Types

-- ---------------------------------------------------------------
-- 查找
-- ---------------------------------------------------------------
-- | 按查询串查符号：先精确匹配全名，未命中退到裸名，再退到后缀（`.查询串`）。
--
-- 全名命中返回全部命中项；三种匹配都没结果时是 `ErrC`。
export findSymbol : Index -> String -> Check (List Sym)
findSymbol index query =
  let
    syms = index.indexSymbols
    exact = filter (\s => symFullName s == query) syms
  in case exact of
    _ :: _ => OkC exact
    [] => findByBare syms query

-- | 内部：按裸名（`symName`）匹配；未命中再交给 `findBySuffix`。
findByBare : List Sym -> String -> Check (List Sym)
findByBare syms query =
  let
    bare = filter (\s => symName s == query) syms
  in case bare of
    _ :: _ => OkC bare
    [] => findBySuffix syms query

-- | 内部：按 `.查询串` 后缀匹配全名；仍无命中即 `ErrC`。
findBySuffix : List Sym -> String -> Check (List Sym)
findBySuffix syms query =
  let
    suffix = ".${query}"
    hits = filter (\s => endsWith suffix (symFullName s)) syms
  in case hits of
    [] => err "no such symbol: ${query}"
    _ => OkC hits

-- | 某模块里给定行/列上的符号，即「光标位置 → 定义」。
--
-- 先按行收窄；多候选时优先列完全一致的，否则取该行第一个符号；该行没有符号即 `ErrC`。
export symbolAt : Index -> String -> Int -> Int -> Check Sym
symbolAt index modQuery queryLine queryCol =
  let
    onLine = filter (\s => symModule s == modQuery && symLine s == queryLine) index.indexSymbols
  in case onLine of
    [] => err "no symbol at ${modQuery}:${queryLine}:${queryCol}"
    [s] => OkC s
    _ =>
      case filter (\s => symCol s == queryCol) onLine of
        s :: _ => OkC s
        [] =>
          case onLine of
            s :: _ => OkC s
            [] => err "no symbol at ${modQuery}:${queryLine}:${queryCol}"

-- | 位置上的符号被哪些地方引用（refs 的 line/col 是引用出现处）。
export referencesAt : Index -> String -> Int -> Int -> Check (List Ref)
referencesAt index modQuery queryLine queryCol =
  case symbolAt index modQuery queryLine queryCol of
    ErrC e => ErrC e
    OkC sym => OkC (refsNamed (symName sym) index.indexRefs)

-- | 内部：按名字过滤引用表。
refsNamed : String -> List Ref -> List Ref
refsNamed name refs = filter (\r => refName r == name) refs

-- | 按名/全名查引用点（LSP references 的按名视图；`referencesAt` 是先由位置找符号再按名查）。
export findReferences : Index -> String -> Check (List Ref)
findReferences index query =
  case findSymbol index query of
    ErrC e => ErrC e
    OkC syms => OkC (refsForNames (map symName syms) index.indexRefs)

-- | 内部：留名字在给定集合里的引用。
refsForNames : List String -> List Ref -> List Ref
refsForNames names refs = filter (\r => memName (refName r) names) refs

-- ---------------------------------------------------------------
-- 影响面
-- ---------------------------------------------------------------
-- | 改动影响面：引用该符号的模块（refs 反向边）+ 建议测试标签。
--
-- 结果是一段文本，含 `symbol`（命中符号全名）、`readers`（引用方模块，去重保序）与
-- `tests`（建议的测试章节）三行。
export impactOf : Index -> String -> Check String
impactOf index query =
  case findSymbol index query of
    ErrC e => ErrC e
    OkC syms =>
      let
        names = map symName syms
        refs = filter (\r => memName (refName r) names) index.indexRefs
        readers = distinct (map refModule refs)
      in OkC
        "symbol: ${join ", " (map symFullName syms)}\nreaders: ${join ", " readers}\ntests: ${testTagsFor syms}\n"

-- | 内部：由命中符号的种类得到建议测试标签。
testTagsFor : List Sym -> String
testTagsFor syms = tagsOfKinds (map symKind syms)

-- | 内部：种类 → 测试标签（含 trait 走 `traits, run`，data/record 走 `records, run`，
-- 其余 `run, stdlib`）。
tagsOfKinds : List String -> String
tagsOfKinds kinds =
  if memName "trait" kinds then
    "traits, run"
  else if memName "data" kinds || memName "record" kinds then "records, run" else "run, stdlib"

-- | 索引里的全部符号（原样返回，顺序即扫描顺序）。
export listAllSymbols : Index -> List Sym
listAllSymbols index = index.indexSymbols
