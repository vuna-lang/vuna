-- | vuna 源码格式化器门面（parse → 规范打印）。
--
-- 输出约定：2 空格缩进、顶层声明之间一个空行、文件末尾一个换行、无行尾空白；
-- `format(parse(x))` 可重新 parse 且幂等（`format(format(x)) == format(x)`）。
--
-- 导出列表：导出项按字面文本的 ASCII 字典序排序，`module B` 整模块重导出统一排最后；
-- 空白与换行由 [Vuna.Fmt.Doc] 的 `group` 一次决定（`maxWidth` 列预算），
-- 缩进由 `nest` 承担。项级注释随项移动。
--
-- 注释不在 AST 里：格式化器单独 lex 出注释，按源码位置挂到最近的「条目」（顶部声明 /
-- import / `infix*` 声明 / 构造器 / 记录字段 / trait 方法 / let 与 where 绑定 / case 分支 /
-- do 语句）；实现见 [Vuna.Fmt.Comment]。
--
-- 中缀与括号按**源码顺序与源码括号**打印：不重排中缀链、不按优先级补括号，因此
-- 格式化不需要程序级 fixity 闭包（`infix*` 声明原样保留）。
--
-- 本模块只是门面：表达式/模式打印在 Vuna.Fmt.Expr，声明/模块头在 Vuna.Fmt.Decl，
-- 注释挂载在 Vuna.Fmt.Comment，共用小工具在 Vuna.Fmt.Util，文档代数在 Vuna.Fmt.Doc。
module Vuna.Fmt where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser
import Vuna.Fmt.Comment
import Vuna.Fmt.Decl
import Vuna.Fmt.Doc
import Vuna.Fmt.Util

-- | 格式化一段源码：解析（带注释）、挂载注释、重写模块头，最后组装成一份 `Doc` 渲染。
-- 任何一步失败都是 `Err`，调用方据此拒绝写盘。
export formatSourceWith : String -> Check String
formatSourceWith source =
  case parseSourceWithComments "<fmt>" source of
    ErrC e => ErrC e
    OkC (Pair (SourceFile hdr imports fx decls exports reexports opacity) comments) =>
      case assignComments (anchorSpans hdr imports fx decls) comments [] [] of
        Pair at eof =>
          let
            hdr2 =
              case hdr of
                Just m =>
                  Just
                    (ModDecl m.modDeclName m.modDeclHasExportList m.modDeclExportItems exports reexports opacity m.modDeclSpan)
                Nothing =>
                  case exports of
                    [] =>
                      case reexports of
                        [] => Nothing
                        _ => Just (ModDecl "" False [] exports reexports opacity dummySpan)
                    _ => Just (ModDecl "" False [] exports reexports opacity dummySpan)
            doc = renderSourceSections [] hdr2 imports fx decls at eof
          in if isDocEmpty doc then OkC "" else OkC (render maxWidth doc ++ "\n")
