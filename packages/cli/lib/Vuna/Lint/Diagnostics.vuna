-- | lint 规则的单一真源：规则枚举、`LN_` 符号、kebab 短名、消息模板与修复描述。
--
-- 每条规则只声明一个构造子：`lintCode` 给出稳定符号（文档与索引的键），`lintRule` 给出
-- CLI 与 finding 输出用的 kebab 短名，两者都由构造子派生，规则名不在别处手写，避免漂移。
--
-- 本模块属于产品 CLI 包（`vuna`）的工具链，不在 compiler 包内：编译期诊断（`TC_` / `CG_`）在
-- `Vuna.Compiler.Base.Diagnostics`，lint 诊断（`LN_`）在这里，依赖方向只有 `vuna` →
-- compiler。
module Vuna.Lint.Diagnostics where

import Base.Data.Bool as Bool
import Base.Trait.Eq as Eq
import Base.Data.List as List
import Base.Data.String as String

-- | 规则枚举，按 dispatch 源划分：`literal-if-chain` 处理 if 分派（字面量链 / Bool 变量），
-- 提升进外层模式，字面量链提升失败时回退成 case；`dispatch-lift` 处理 case / let 分派，
-- 提升进外层模式（单 alt 替换、多 alt 拆分）；`list-literal` 处理表达式与类型位置的闭合
-- cons 链（`::` / `Cons` 加 `Nil` / `[]`）以及裸 `Nil`，改写成列表字面量，模式匹配不在范围内。
export data LintRule(..) : Type where
  -- | if 分派（`x == 字面量` 链 / Bool 变量）可提升进外层模式，失败时回退为 case。
  LiteralIfChain : LintRule
  -- | case / let 分派可提升进外层模式（单 alt 替换、多 alt 拆分）。
  DispatchLift : LintRule
  -- | 闭合 cons 链与裸 `Nil` 应写成列表字面量。
  ListLiteral : LintRule
  -- | 注释里出现 TODO / FIXME / XXX 标记（默认关闭，all 预设可选）。
  TodoMarker : LintRule
  -- | `if True` / `if False` 常量条件（默认关闭，all 预设可选）。
  RedundantIf : LintRule

-- | 规则的稳定符号（`LN_` 前缀 + 驼峰），文档与索引按它引用规则。
export lintCode : LintRule -> String
lintCode LiteralIfChain = "LN_LiteralIfChain"
lintCode DispatchLift = "LN_DispatchLift"
lintCode ListLiteral = "LN_ListLiteral"
lintCode TodoMarker = "LN_TodoMarker"
lintCode RedundantIf = "LN_RedundantIf"

-- | 规则的 kebab 短名，用于 CLI 与 finding 输出；与 `lintCode` 一一对应。
export lintRule : LintRule -> String
lintRule LiteralIfChain = "literal-if-chain"
lintRule DispatchLift = "dispatch-lift"
lintRule ListLiteral = "list-literal"
lintRule TodoMarker = "todo-marker"
lintRule RedundantIf = "redundant-if"

-- | 由 `LN_` code 反查 kebab 短名（gen-errors 与输出层按 code 反查时用）；未知 code 返回空串。
export lintRuleCode : String -> String
lintRuleCode code =
  if code == lintCode LiteralIfChain then lintRule LiteralIfChain
  else if code == lintCode DispatchLift then lintRule DispatchLift
  else if code == lintCode ListLiteral then lintRule ListLiteral
  else if code == lintCode TodoMarker then lintRule TodoMarker
  else if code == lintCode RedundantIf then lintRule RedundantIf else ""

-- | 规则的消息模板；参数是被检查主体的描述，模板里用它插值。
export lintMsg : LintRule -> String -> String
lintMsg LiteralIfChain scrutinee =
  "if dispatch on `${scrutinee}` can be lifted into the enclosing pattern or rewritten as a case"
lintMsg DispatchLift scrutinee =
  "dispatch on `${scrutinee}` can be lifted into the enclosing pattern"
lintMsg ListLiteral suggestion = "list construction can be written as `${suggestion}`"
lintMsg TodoMarker marker = "comment contains `${marker}` marker"
lintMsg RedundantIf branch = "conditional on a constant Bool can be simplified to `${branch}`"

-- | 规则的修复动作描述（`vuna lint --explain` 与文档用）。
export lintEdit : LintRule -> String
lintEdit LiteralIfChain =
  "把 if 分派提升进外层 clause/alt 模式；提升不了的字面量链改写为 case"
lintEdit DispatchLift =
  "把 case / let 分派提升进外层模式（单 alt 替换；多 alt 拆 clause 或拆 alt）"
lintEdit ListLiteral =
  "把闭合 `::` / `Cons` 链与裸 `Nil` 改写为 `[a, b]` / `[]`（模式匹配不动）"
lintEdit TodoMarker = "删除或处理注释里的 TODO / FIXME / XXX 标记"
lintEdit RedundantIf = "把 `if True/False then a else b` 化简为对应分支"

-- | 规则的一句话说明（文档用）。
export lintDesc : LintRule -> String
lintDesc LiteralIfChain =
  "if 分派（字面量链 / Bool 变量）可提升进外层 clause/alt 模式；字面量链可回退为 case。"
lintDesc DispatchLift =
  "case / let 分派可提升进外层 clause/alt 模式（单 alt 替换、多 alt 拆分）。"
lintDesc ListLiteral =
  "表达式/类型位置的闭合 cons 链与裸 `Nil` 应写成 `[a, b]` / `[]`；模式匹配里的 `::`/`Cons` 不受影响。"
lintDesc TodoMarker =
  "注释里的 TODO / FIXME / XXX 标记应在合入前处理；默认关闭，all 预设或 --select 启用。"
lintDesc RedundantIf =
  "`if True` / `if False` 的常量条件可直接化简；默认关闭，all 预设或 --select 启用。"

-- | 该规则是否可自动修复（可修复的规则会派生 `FX_` 修复码）。
export lintFixable : LintRule -> Bool
lintFixable LiteralIfChain = True
lintFixable DispatchLift = True
lintFixable ListLiteral = True
lintFixable TodoMarker = False
lintFixable RedundantIf = True

-- | 规则的严重度：off 不参与扫描，warn 只报告，error 计入退出码。
export data LintSeverity(..) : Type where
  -- | 关闭。
  LintOff : LintSeverity
  -- | 警告。
  LintWarn : LintSeverity
  -- | 错误。
  LintError : LintSeverity

instance Eq LintSeverity where
  (==) LintOff LintOff = True
  (==) LintWarn LintWarn = True
  (==) LintError LintError = True
  (==) _ _ = False
  (/=) a b = not (a == b)

-- | 严重度的配置名。
export lintSeverityName : LintSeverity -> String
lintSeverityName LintOff = "off"
lintSeverityName LintWarn = "warn"
lintSeverityName LintError = "error"

-- | 由配置名解析严重度；未知值给 `Nothing`。
export lintSeverityOfName : String -> Maybe LintSeverity
lintSeverityOfName "off" = Just LintOff
lintSeverityOfName "warn" = Just LintWarn
lintSeverityOfName "error" = Just LintError
lintSeverityOfName _ = Nothing

-- | 由 kebab 短名或 `LN_` code 反查规则；未知给 `Nothing`。
export lintRuleOfName : String -> Maybe LintRule
lintRuleOfName name = lookupRuleName name lintAllRules

-- | 内部：按 kebab 短名或 code 查规则。
lookupRuleName : String -> List LintRule -> Maybe LintRule
lookupRuleName name [] = Nothing
lookupRuleName name (r :: rest) =
  if name == lintRule r || name == lintCode r then Just r else lookupRuleName name rest

-- | 规则的默认严重度（未写配置时）。
export lintDefaultSeverity : LintRule -> LintSeverity
lintDefaultSeverity LiteralIfChain = LintWarn
lintDefaultSeverity DispatchLift = LintWarn
lintDefaultSeverity ListLiteral = LintWarn
lintDefaultSeverity TodoMarker = LintWarn
lintDefaultSeverity RedundantIf = LintWarn

-- | 全部规则（配置与默认预设的遍历源）。
export lintAllRules : List LintRule
lintAllRules = [LiteralIfChain, DispatchLift, ListLiteral, TodoMarker, RedundantIf]

-- | 规则是否属于 recommended 预设。
export lintRecommended : LintRule -> Bool
lintRecommended LiteralIfChain = True
lintRecommended DispatchLift = True
lintRecommended ListLiteral = True
lintRecommended TodoMarker = False
lintRecommended RedundantIf = False

-- | 一条规则的文档条目：code、kebab 短名、说明、是否可修复与修复动作描述。
export record LintEntry(..) where
  -- | 规则符号（`LN_` 前缀）。
  lintEntryCode : String
  -- | 规则 kebab 短名。
  lintEntryRule : String
  -- | 规则说明。
  lintEntryDesc : String
  -- | 是否可自动修复。
  lintEntryFixable : Bool
  -- | 修复动作描述。
  lintEntryEdit : String

-- | 全部规则；新增规则必须在此登记，否则文档缺条目。
export lintAll : List LintEntry
lintAll =
  [ LintEntry (lintCode LiteralIfChain) (lintRule LiteralIfChain) (lintDesc LiteralIfChain) (lintFixable LiteralIfChain) (lintEdit LiteralIfChain),
    LintEntry (lintCode DispatchLift) (lintRule DispatchLift) (lintDesc DispatchLift) (lintFixable DispatchLift) (lintEdit DispatchLift),
    LintEntry (lintCode ListLiteral) (lintRule ListLiteral) (lintDesc ListLiteral) (lintFixable ListLiteral) (lintEdit ListLiteral),
    LintEntry (lintCode TodoMarker) (lintRule TodoMarker) (lintDesc TodoMarker) (lintFixable TodoMarker) (lintEdit TodoMarker),
    LintEntry (lintCode RedundantIf) (lintRule RedundantIf) (lintDesc RedundantIf) (lintFixable RedundantIf) (lintEdit RedundantIf)
  ]
