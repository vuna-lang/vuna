-- | suite 文件（`test/suite.toml`）的模型、校验与 case discovery。
--
-- `[suite]` 只放全局默认（name / jobs / timeout / min_cases）；`[family.<name>]` 按
-- 目录约定展开成一批 golden / error / lint / fix / steps case，避免为每个夹具手写一段
-- TOML。
--
-- 本模块不做执行，只做「文件 / TOML → `List Case`」的数据转换：读盘经 Eff 效果，
-- TOML 解析与 case 建模保持纯。对外入口是 `parseSuiteFile` / `discoverCases`。
module Vuna.Test.Suite where

import Vuna.Compiler.Base.Common
import Vuna.Compiler.Frontend.Toml
import Vuna.Files
import Vuna.Cli.Args
import Base.Effect.EffEnv as EffEnv
import Base.Effect.EffFs as EffFs
import Base.Effect.EffTypes as EffTypes

-- | `vuna dev suite` 的选项；jobs = 0 表示 auto（由 runner 探测全部可用核）。
export record SuiteOpts(..) where
  -- | suite 文件路径（`--suite`）。
  suitePath : String
  -- | 并行 job 数（`--jobs`；0 = auto）。
  suiteJobs : Int
  -- | `--list`：只列 case，不执行。
  suiteListOnly : Bool
  -- | `--verbose`：结果行尾追加耗时。
  suiteVerbose : Bool
  -- | `--fail-fast`：首个失败即停止（并行时只在出错的 worker 内停止剩余 case）。
  suiteFailFast : Bool
  -- | `--json`：汇总以 JSON 输出（同时抑制逐条结果行）。
  suiteJSON : Bool
  -- | `--only`：按章节或 id 前缀过滤（可重复）。
  suiteOnly : List String
  -- | `--filter`：对 case id / tag 做子串过滤（可重复，多值 OR）。
  suiteFilter : List String
  -- | `--timeout` 的解析值（0 = 不超时）；case 预算当前取 family 的 `familyTimeout`，本字段尚未参与判定。
  suiteTimeout : Int
  -- | `Just (i, n)` 是父进程 spawn 出来的 worker 模式：默认只跑 index mod n == i 的 case；LPT 分桶模式下只跑自己那一桶。
  suiteWorker : Maybe (Pair Int Int)
  -- | 结果落盘目录（`--results-dir`）。
  suiteResultsDir : Maybe String
  -- | `--quiet`：抑制逐条结果行。
  suiteQuiet : Bool
  -- | `--last-failed`：只跑上次失败的 case。
  suiteLastFailed : Bool
  -- | `--bless`：把实际输出写回 golden 期望文件。
  suiteBless : Bool
  -- | `--bless-diag`：把实际诊断写回 `.diag.json` 期望文件。
  suiteBlessDiag : Bool
  -- | `--changed`：只跑与给定 revision 有差异的输入相关 case。
  suiteChanged : Maybe String
  -- | 结果缓存与构建桶的根（`--cache-dir`）。
  suiteCacheDir : Maybe String
  -- | `--watch`：检测到变化后整轮重跑 suite。
  suiteWatch : Bool
  -- | `--timings`：打印最慢 10 个 case 的耗时。
  suiteTimings : Bool
  -- | `--strict-skips`：跳过的 case 计入失败。
  suiteStrictSkips : Bool
  -- | `--audit`：做 suite 覆盖审计而不是跑 case。
  suiteAudit : Bool
  -- | 可重复的 `--tier`；空 = 全部。
  suiteTiers : List String
  -- | 可重复的 `--matrix`；空 = 全部。
  suiteMatrices : List String
  -- | 可重复的 `--backend`；空 = 只跑声明里的默认目标（ocaml）。
  suiteBackends : List String

-- | 一个 family：目录约定 + 各阶段的上限开关（后缀决定实际参与；family 旗标是上限，关掉即不跑，但 `.interp.out` 分支例外——它强制 interp）。
export record Family(..) where
  -- | family 名（`[family.<name>]` 的 `<name>`）。
  familyName : String
  -- | case id 的章节前缀（`section` 键，缺省空串）。
  familySection : String
  -- | 夹具目录（`dir` 键，相对 suite 根，必填）。
  familyDir : String
  -- | case 种类：`auto` / `golden` / `error` / `check-ok` / `check-error` / `lint` /
  -- `fix` / `steps`。
  familyKind : String
  -- | 目录型 family 的入口文件名；设置时每个子目录一个 case。
  familyEntry : Maybe String
  -- | 是否允许 interp 阶段。
  familyInterp : Bool
  -- | 是否允许 check 阶段。
  familyCheck : Bool
  -- | 是否允许 compile 阶段。
  familyCompile : Bool
  -- | 是否允许 run 阶段。
  familyRun : Bool
  -- | 是否要求 interp 与 run 输出一致。
  familyCompareInterp : Bool
  -- | 附加到每个 case 的 tag。
  familyTags : List String
  -- | case 超时秒数（缺省取 suite 默认）。
  familyTimeout : Int
  -- | 文件名子串排除表（命中即跳过）。
  familyExclude : List String
  -- | 文件名子串白名单（非空时只收命中的文件）。
  familyInclude : List String
  -- | 后端矩阵分类（`matrix` 键）：`tool`（缺省，不产生目标代码）/ `pure` /
  -- `pure-cross` / `effect-common` / `effect-native` / `effect-wasm`。
  familyMatrix : String

-- | suite 全局配置与解析出的 family 列表。
export record Suite(..) where
  -- | suite 名（`[suite].name`，缺省 `vuna`）。
  suiteName : String
  -- | suite 根目录（suite 文件的上两级）。
  suiteRoot : String
  -- | 默认并行数（`[suite].jobs`，0 = auto）。
  suiteDefaultJobs : Int
  -- | family 未设置时的默认超时秒数（`[suite].timeout`，缺省 300）。
  suiteDefaultTimeout : Int
  -- | 解析出的 family（按首次出现顺序）。
  suiteFamilies : List Family
  -- | case 数下限：family 整族从配置里消失时，孤儿审计（只看已声明目录）也看不到它，
  -- 用总数下限兜底。0 = 不检查。
  suiteMinCases : Int

-- | 一个 case 的种类与参数（`source` 是夹具源文件路径）。
export data CaseKind(..) : Type where
  -- | golden 用例：source expected interp check compile run compareInterp。
  CGolden : String -> String -> Bool -> Bool -> Bool -> Bool -> Bool -> CaseKind
  -- | 负例：source diagPath wantInterp wantCheck wantCompile（期望载体是结构化诊断）。
  CError : String -> String -> Bool -> Bool -> Bool -> CaseKind
  -- | check 断言：source wantOk diagPath（wantOk 时 diagPath 为空）。
  CCheck : String -> Bool -> String -> CaseKind
  -- | lint 用例：source expected（findings 的 golden 文本）。
  CLint : String -> String -> CaseKind
  -- | fix 用例：source expected（修复后的源码）。
  CFix : String -> String -> CaseKind
  -- | 运行用例：source expectedErr expectExit（退出码语义见 `wantCaseWith`）。
  CRuntime : String -> String -> Int -> CaseKind
  -- | seed 自举用例：source expected。
  CSeed : String -> String -> CaseKind
  -- | 声明式用例：`*.steps` 文件（`run:` / `read:` 指令与 `exit:` / `out-*` / `file-*` 断言），由 runner 解释执行。
  CSteps : String -> CaseKind
  -- | 无法建模的用例；消息即失败原因。
  CBroken : String -> CaseKind

-- | 一个可执行的用例。
export record Case(..) where
  -- | 用例 id（`<section>/<family>/<相对路径>`）。
  caseId : String
  -- | 章节（`--only` 的数字前缀与分组按它匹配）。
  caseSection : String
  -- | tag 列表。
  caseTags : List String
  -- | 种类与参数。
  caseKind : CaseKind
  -- | 超时秒数。
  caseTimeout : Int
  -- | fast | integration | e2e | tools（用于 --tier 过滤与 CI 分层）。
  caseTier : String
  -- | 后端矩阵分类（见 `Family.familyMatrix`）。
  caseMatrix : String

-- ---------------------------------------------------------------
-- 路径与读盘
-- ---------------------------------------------------------------
-- | 内部：按顺序对每个元素跑效果并拼接结果列表（discovery 唯一的读取路径）。
concatMapEff : {r : Row} -> (a -> Eff r (List b)) -> List a -> Eff r (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

-- | 内部：读文本文件；文件不存在或是目录时返回 `ErrC`。
readTextFile : Member nFs FsOp r => String -> Eff r (Check String)
readTextFile path = do
  exists <- pathExistsFile path
  if exists then do
    isDir <- pathExistsDir path
    if isDir then pure (err "is a directory: ${path}") else fmap OkC (fsReadFile path)
  else pure (err "no such file: ${path}")

-- | 内部：suite 文件在 `<root>/test/suite.toml`；root = 上两级。
suiteFileRoot : String -> String
suiteFileRoot path = parentOf (parentOf path)

-- ---------------------------------------------------------------
-- TOML 取值（类型错误显式报错，不静默回落默认）
-- ---------------------------------------------------------------
-- | 内部：错误消息里的章节后缀（` in [a.b]`）。
sectionText : List String -> String
sectionText [] = ""
sectionText section = " in [${joinDots section}]"

-- | 内部：两段 TOML 章节路径是否逐段相同。
samePathText : List String -> List String -> Bool
samePathText [] [] = True
samePathText (x :: xs) (y :: ys) = if x == y then samePathText xs ys else False
samePathText _ _ = False

-- | 内部：统一格式的类型错误消息。
fieldErr : List String -> String -> String -> String
fieldErr section key msg = "wrong type for `${key}`${sectionText section}: ${msg}"

-- | 内部：取字符串字段（缺失给 `Nothing`，类型不符报错）。
getStr : List String -> String -> List TomlEntry -> Check (Maybe String)
getStr section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TStr s) => OkC (Just s)
  Just _ => err (fieldErr section key "expected a string")

-- | 内部：取整数字段（缺失给 `Nothing`，类型不符报错）。
getInt : List String -> String -> List TomlEntry -> Check (Maybe Int)
getInt section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TInt n) => OkC (Just n)
  Just _ => err (fieldErr section key "expected an integer")

-- | 内部：取布尔字段（缺失给 `Nothing`，类型不符报错）。
getBool : List String -> String -> List TomlEntry -> Check (Maybe Bool)
getBool section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TBool b) => OkC (Just b)
  Just _ => err (fieldErr section key "expected a boolean")

-- | 内部：取字符串数组字段（缺失给 `Nothing`，元素非字符串或类型不符报错）。
getList : List String -> String -> List TomlEntry -> Check (Maybe (List String))
getList section key entries = case lookupEntry section key entries of
  Nothing => OkC Nothing
  Just (TArray xs) => case arrayStrings xs of
    Nothing => err (fieldErr section key "expected an array of strings")
    Just ys => OkC (Just ys)
  Just _ => err (fieldErr section key "expected an array of strings")

-- | 内部：字符串字段的缺省解包（缺失才用默认值，类型错误已由 `getStr` 报出）。
strOr : String -> Maybe String -> String
strOr d m = fromMaybe d m

-- | 内部：整数字段的缺省解包。
intOr : Int -> Maybe Int -> Int
intOr d m = fromMaybe d m

-- | 内部：布尔字段的缺省解包。
boolOr : Bool -> Maybe Bool -> Bool
boolOr d m = fromMaybe d m

-- | 内部：字符串数组字段的缺省解包。
listOr : List String -> Maybe (List String) -> List String
listOr d m = fromMaybe d m

-- ---------------------------------------------------------------
-- family 解析
-- ---------------------------------------------------------------
-- | family 段落允许的键（未知键报错）。
familyKeys : List String
familyKeys =
  [ "section",
    "dir",
    "kind",
    "entry",
    "interp",
    "check",
    "compile",
    "run",
    "compare_interp",
    "tags",
    "timeout",
    "exclude",
    "include",
    "matrix"
  ]

-- | 矩阵分类的合法取值（第一个是缺省值）。
export matrixClasses : List String
matrixClasses =
  ["tool", "pure", "pure-cross", "effect-common", "effect-native", "effect-wasm", "effect-ocaml"]

-- | 矩阵分类 → 层次标签（`pure` / `effect` / `tool`）。
export matrixLayer : String -> String
matrixLayer "pure" = "pure"
matrixLayer "pure-cross" = "pure"
matrixLayer "effect-common" = "effect"
matrixLayer "effect-native" = "effect"
matrixLayer "effect-wasm" = "effect"
matrixLayer "effect-ocaml" = "effect"
matrixLayer _ = "tool"

-- | 矩阵分类 → 该用例要执行的目标（含 ocaml oracle；`tool` / `pure` 只在 ocaml 跑）。
export matrixTargets : String -> List String
matrixTargets "pure-cross" = ["ocaml", "wasm", "native"]
matrixTargets "effect-common" = ["ocaml", "wasm", "native"]
matrixTargets "effect-native" = ["ocaml", "native"]
matrixTargets "effect-wasm" = ["ocaml", "wasm"]
matrixTargets _ = ["ocaml"]

-- | 派生 tag：`layer:<层次>` 与 `matrix:<分类>`，让 `--filter` 也能按分层筛选。
export matrixTags : String -> List String
matrixTags matrix = ["layer:${matrixLayer matrix}", "matrix:${matrix}"]

-- | 内部：校验 family 段落的键都在 `familyKeys` 里（其它段落的条目忽略）。
checkFamilyKeys : List String -> List TomlEntry -> Check Int
checkFamilyKeys section entries = checkFamilyKeysGo section entries

-- | 内部：`checkFamilyKeys` 的递归主体。
checkFamilyKeysGo : List String -> List TomlEntry -> Check Int
checkFamilyKeysGo section [] = OkC 0
checkFamilyKeysGo section (e :: rest) =
  if samePathText e.tomlEntrySection section then
    if memName e.tomlEntryKey familyKeys then checkFamilyKeysGo section rest
    else err "${sectionText section}: unknown key `${e.tomlEntryKey}`"
  else checkFamilyKeysGo section rest

-- option 读取拆成两段：单条 `>>=` 链过长会触发推断 fuel / 指数级问题（Result 管道
-- 每层 bind 都带字典插入）。拆分后每段 ≤7 层。
-- | family 的 `kind` / `entry` 原始取值（`Nothing` = 未配置）。
record FamilyOpts where
  -- | `kind` 键（缺省按 `auto` 处理）。
  familyOptKind : Maybe String
  -- | `entry` 键（目录型 family 的入口文件名）。
  familyOptEntry : Maybe String
  -- | `matrix` 键（缺省按 `tool` 处理）。
  familyOptMatrix : Maybe String

-- | family 的各阶段旗标、tag 与超时的原始取值（`Nothing` = 未配置）。
record FamilyFlags where
  -- | `interp` 键。
  familyFlagInterp : Maybe Bool
  -- | `check` 键。
  familyFlagCheck : Maybe Bool
  -- | `compile` 键。
  familyFlagCompile : Maybe Bool
  -- | `run` 键。
  familyFlagRun : Maybe Bool
  -- | `compare_interp` 键。
  familyFlagCompare : Maybe Bool
  -- | `tags` 键。
  familyFlagTags : Maybe (List String)
  -- | `timeout` 键。
  familyFlagTimeout : Maybe Int

-- | 内部：读 `kind` / `entry` / `matrix`。
readFamilyOpts : List String -> List TomlEntry -> Check FamilyOpts
readFamilyOpts section entries =
  getStr section "kind" entries
    >>= (\kindOpt => getStr section "entry" entries >>= (\entryOpt => getStr section "matrix" entries >>= (\matrixOpt => OkC (FamilyOpts kindOpt entryOpt matrixOpt))))

-- | 内部：读各阶段旗标、`compare_interp`、`tags` 与 `timeout`。
readFamilyFlags : List String -> List TomlEntry -> Check FamilyFlags
readFamilyFlags section entries =
  getBool section "interp" entries
    >>= (\interpOpt => getBool section "check" entries >>= (\checkOpt => getBool section "compile" entries >>= (\compileOpt => getBool section "run" entries >>= (\runOpt => getBool section "compare_interp" entries >>= (\compareOpt => getList section "tags" entries >>= (\tagsOpt => getInt section "timeout" entries >>= (\timeoutOpt => OkC (FamilyFlags interpOpt checkOpt compileOpt runOpt compareOpt tagsOpt timeoutOpt))))))))

-- 长 `>>=` 链在 Result 管道上会触发推断 fuel 问题；这里用显式 case 展开。
-- | 内部：由 `[family.<name>]` 条目构造 `Family`；缺 `dir` 或 `kind` 非法报错。
buildFamily : Suite -> List TomlEntry -> String -> Check Family
buildFamily suite entries name =
  let
    section = ["family", name]
  in case checkFamilyKeys section entries of
    ErrC e => ErrC e
    OkC _ => case getStr section "section" entries of
      ErrC e => ErrC e
      OkC sectionOpt => case getStr section "dir" entries of
        ErrC e => ErrC e
        OkC dirOpt => case dirOpt of
          Nothing => err "family `${name}` needs `dir`"
          Just dir => case readFamilyOpts section entries of
            ErrC e => ErrC e
            OkC opts => case readFamilyFlags section entries of
              ErrC e => ErrC e
              OkC flags =>
                let
                  excludeList = case lookupEntry section "exclude" entries of
                    Just (TArray xs) => fromMaybe [] (arrayStrings xs)
                    _ => []
                  includeList = case lookupEntry section "include" entries of
                    Just (TArray xs) => fromMaybe [] (arrayStrings xs)
                    _ => []
                  kind = strOr "auto" opts.familyOptKind
                  matrix = strOr "tool" opts.familyOptMatrix
                  tags = append (listOr [] flags.familyFlagTags) (matrixTags matrix)
                in if kind == "auto" || kind == "golden" || kind == "error" || kind == "check-ok" || kind == "check-error" || kind == "lint" || kind == "fix" || kind == "steps" then
                  if memName matrix matrixClasses then OkC
                    (Family name (strOr "" sectionOpt) dir kind opts.familyOptEntry (boolOr True flags.familyFlagInterp) (boolOr False flags.familyFlagCheck) (boolOr True flags.familyFlagCompile) (boolOr True flags.familyFlagRun) (boolOr True flags.familyFlagCompare) tags (intOr suite.suiteDefaultTimeout flags.familyFlagTimeout) excludeList includeList matrix)
                  else err
                    (sectionText section ++ ": matrix must be tool/pure/pure-cross/effect-common/effect-native/effect-wasm/effect-ocaml, got `${matrix}`")
                else err
                  (sectionText section ++ ": kind must be auto/golden/error/check-ok/check-error/lint/fix/steps, got `${kind}`")

-- | 内部：从 entries 收集 family 名（保持首次出现顺序）。
familyNames : List TomlEntry -> List String
familyNames entries = familyNamesGo entries []

-- | 内部：`familyNames` 的递归主体（逆序累积，最后反转）。
familyNamesGo : List TomlEntry -> List String -> List String
familyNamesGo [] acc = reverse acc
familyNamesGo (e :: rest) acc = case e.tomlEntrySection of
  ["family", name] =>
    if memName name acc then familyNamesGo rest acc else familyNamesGo rest (name :: acc)
  _ => familyNamesGo rest acc

-- ---------------------------------------------------------------
-- suite 解析
-- ---------------------------------------------------------------
-- | 内部：由 TOML 条目构造 `Suite`——先取 `[suite]` 默认值，再逐个构造 family。
buildSuiteWithEntries : String -> List TomlEntry -> Check Suite
buildSuiteWithEntries path entries =
  let
    root = suiteFileRoot path
    section = ["suite"]
  in case getStr section "name" entries of
    ErrC e => ErrC e
    OkC nameOpt => case getInt section "jobs" entries of
      ErrC e => ErrC e
      OkC jobsOpt => case getInt section "timeout" entries of
        ErrC e => ErrC e
        OkC timeoutOpt => case getInt section "min_cases" entries of
          ErrC e => ErrC e
          OkC minOpt =>
            let
              draft =
                Suite (strOr "vuna" nameOpt) root (intOr 0 jobsOpt) (intOr 300 timeoutOpt) []
                  (intOr 0 minOpt)
            in buildFamiliesWith draft entries (familyNames entries)
              >>= (\families => OkC (Suite draft.suiteName draft.suiteRoot draft.suiteDefaultJobs draft.suiteDefaultTimeout families draft.suiteMinCases))

-- | 内部：按名列表逐个构造 family。
buildFamiliesWith : Suite -> List TomlEntry -> List String -> Check (List Family)
buildFamiliesWith suite entries [] = OkC []
buildFamiliesWith suite entries (name :: rest) = case buildFamily suite entries name of
  ErrC e => ErrC e
  OkC family => buildFamiliesWith suite entries rest >>= (\more => OkC (family :: more))

-- ---------------------------------------------------------------
-- discovery
-- ---------------------------------------------------------------
-- | 内部：去掉 `.vuna` 后缀。
stripVuna : String -> String
stripVuna name = if endsWith ".vuna" name then substring 0 (byteLength name - 5) name else name

-- | 内部：夹具文件名——以 `.vuna` 结尾且不以 `_` 开头。
isFixtureName : String -> Bool
isFixtureName name = endsWith ".vuna" name && not (startsWith "_" name)

-- ---------------------------------------------------------------
-- 期望文件：`<base>.diag.json`（负例）与 `<base>.out` 系列（正例）
-- ---------------------------------------------------------------
-- | 一个夹具名下探测到的期望文件（`Nothing` = 该形态不存在）。
--
-- check / compile 类负例的期望载体是结构化诊断 `.diag.json`；run 类负例用 `.run.err` /
-- `.run.exit`。阶段参与由「后缀存在性」推导，family 旗标只是上限（关掉即不跑）；矛盾组合
-- 显式 `CBroken`，不静默跳过。
record FixtureWant where
  -- | 结构化诊断期望（`.diag.json`）。
  fwDiag : Maybe String
  -- | interp golden（`.interp.out`）。
  fwInterpOut : Maybe String
  -- | run golden（`.run.out`）。
  fwRunOut : Maybe String
  -- | 运行期输出片段期望（`.run.err`）。
  fwRunErr : Maybe String
  -- | 期望退出码文件（`.run.exit`）。
  fwRunExit : Maybe String
  -- | interp 与 run 共享的 golden（`.out`），断言两者输出一致。
  fwSharedOut : Maybe String

-- | 内部：`Maybe` 是否有值。
hasOpt : Maybe a -> Bool
hasOpt (Just _) = True
hasOpt Nothing = False

-- | 内部：两个 `Maybe` 取第一个有值的。
orOpt : Maybe a -> Maybe a -> Maybe a
orOpt (Just x) _ = Just x
orOpt Nothing b = b

-- | 内部：探测夹具 base 名下的全部期望文件。阶段限定后缀优先；裸 `.out` 是 interp +
-- run 共享的 golden。
parseWant : Member nFs FsOp r => String -> Eff r FixtureWant
parseWant base = do
  diag <- firstExisting ["${base}.diag.json"]
  interpOut <- firstExisting ["${base}.interp.out"]
  runOut <- firstExisting ["${base}.run.out"]
  runErr <- firstExisting ["${base}.run.err"]
  runExit <- firstExisting ["${base}.run.exit"]
  sharedOut <- firstExisting ["${base}.out"]
  pure (FixtureWant diag interpOut runOut runErr runExit sharedOut)

-- | 内部：读 `.run.exit` 的期望退出码（取前导十进制数字；没有数字时 0）。
readExitCode : Member nFs FsOp r => String -> Eff r Int
readExitCode path = fmap (\text => parseExitDigits (strUnpack (trim text)) 0 0) (fsReadFile path)

-- | 内部：解析十进制数字直到首个非数字；没有数字时给 0。
parseExitDigits : List Int -> Int -> Int -> Int
parseExitDigits [] acc seen = if seen == 0 then 0 else acc
parseExitDigits (c :: rest) acc seen =
  if c >= 48 && c <= 57 then parseExitDigits rest (acc * 10 + (c - 48)) 1
  else if seen == 0 then parseExitDigits rest acc 0 else acc

-- | 内部：目录型夹具的期望文件（`expected.*`；`expected.diag.json` 是 check / compile 类负例的载体）。
dirWant : Member nFs FsOp r => String -> Eff r FixtureWant
dirWant caseDir = do
  diag <- firstExisting ["${caseDir}/expected.diag.json"]
  interpOut <- firstExisting ["${caseDir}/expected.interp.out"]
  runOut <- firstExisting ["${caseDir}/expected.run.out"]
  runErr <- firstExisting ["${caseDir}/expected.run.err"]
  runExit <- firstExisting ["${caseDir}/expected.run.exit"]
  sharedOut <- firstExisting ["${caseDir}/expected.out"]
  pure (FixtureWant diag interpOut runOut runErr runExit sharedOut)

-- | 内部：按顺序返回第一个存在的文件。
firstExisting : Member nFs FsOp r => List String -> Eff r (Maybe String)
firstExisting [] = pure Nothing
firstExisting (p :: rest) = do
  exists <- pathExistsFile p
  if exists then pure (Just p) else firstExisting rest

-- | 内部：从 want 推导 case。`.run.exit` 的读取是本函数内唯一的效果；读完后的判定保持纯。
wantCase : Member nFs FsOp r => Family -> String -> String -> FixtureWant -> Eff r (Check Case)
wantCase family source id want = do
  exitCode <- case want.fwRunExit of
    Just p => readExitCode p
    Nothing => pure 0
  pure (wantCaseWith family source id want exitCode)

-- | 内部：纯判定部分——矛盾组合 / family 不允许的阶段显式 `ErrC`（→ `CBroken`）；
-- 退出码哨兵 256 表示断言恰好 0，0 表示断言非 0。
wantCaseWith : Family -> String -> String -> FixtureWant -> Int -> Check Case
wantCaseWith family source id want exitCode =
  let
    negRun = hasOpt want.fwRunErr || hasOpt want.fwRunExit
    negAny = hasOpt want.fwDiag || negRun
    posAny = hasOpt want.fwInterpOut || hasOpt want.fwSharedOut || hasOpt want.fwRunOut
  in if posAny && negAny then
    err "conflicting expect: golden (`.out`/`.interp.out`/`.run.out`) with `.diag.json`/`.run.err`"
  else if hasOpt want.fwRunOut && negRun then
    err "conflicting expect: `.run.out` with `.run.err`/`.run.exit`"
  else if negRun then
    if not family.familyRun then err "family does not allow run expectations"
    else
      let
        expect = fromMaybe "" want.fwRunErr
        -- `.run.exit` 语义：0 → 256 哨兵（vuna 没有负字面量；256 超出真实退出码
        -- 0–255 范围）= 断言恰好退出 0；n > 0 → 断言恰好 n。无 `.run.exit` 时
        -- 0 = 遗留语义（断言非 0）。
        code = if hasOpt want.fwRunExit then if exitCode == 0 then 256 else exitCode else 0
      in OkC
        (Case id family.familySection family.familyTags (CRuntime source expect code) family.familyTimeout "integration" family.familyMatrix)
  else if hasOpt want.fwDiag then
    let
      diagPath = fromMaybe "" want.fwDiag
      interpOn = family.familyInterp
      compileOn = family.familyCompile
    in OkC
      (Case id family.familySection family.familyTags (CError source diagPath interpOn family.familyCheck family.familyCompile) family.familyTimeout "fast" family.familyMatrix)
  else if hasOpt want.fwRunOut then
    if not family.familyCompile || not family.familyRun then err "family does not allow compile+run"
    else OkC
      (Case id family.familySection family.familyTags (CGolden source (fromMaybe "" want.fwRunOut) False family.familyCheck True True False) family.familyTimeout "fast" family.familyMatrix)
  else if hasOpt want.fwSharedOut then OkC
    (Case id family.familySection family.familyTags (CGolden source (fromMaybe "" want.fwSharedOut) family.familyInterp family.familyCheck family.familyCompile family.familyRun family.familyCompareInterp) family.familyTimeout "fast" family.familyMatrix)
  else if hasOpt want.fwInterpOut then OkC
    (Case id family.familySection family.familyTags (CGolden source (fromMaybe "" want.fwInterpOut) True family.familyCheck False False False) family.familyTimeout "fast" family.familyMatrix)
  else err "no expect file (need `.out` / `.interp.out` / `.run.out` / `.diag.json`)"

-- | 内部：负例期望路径 `<base>.diag.json`（结构化诊断是唯一真源）。
expectPath : Member nFs FsOp r => String -> Eff r String
expectPath base = do
  exists <- pathExistsFile "${base}.diag.json"
  if exists then pure "${base}.diag.json" else pure "${base}.diag.json"

-- | 内部：目录型 family——`entry` 配置时每个子目录一个 case；目录缺失给一个
-- `CBroken` 占位 case。
discoverDirFamily : Member nFs FsOp r => Suite -> Family -> String -> Eff r (List Case)
discoverDirFamily suite family entry =
  let
    dir = "${suite.suiteRoot}/${family.familyDir}"
  in do
    exists <- pathExistsDir dir
    if not exists then pure [brokenFamilyCase family "family dir not found: ${dir}"]
    else do
      names <- fsReadDir dir
      concatMapEff (oneDir family dir entry) names

-- | 内部：为一个子目录建 case——目录与入口文件都存在才算夹具，其余跳过。
oneDir : Member nFs FsOp r => Family -> String -> String -> String -> Eff r (List Case)
oneDir family dir entry name =
  let
    caseDir = "${dir}/${name}"
    source = "${caseDir}/${entry}"
    id = "${family.familySection}/${family.familyName}/${name}"
  in do
    isDir <- pathExistsDir caseDir
    isFile <- if isDir then pathExistsFile source else pure False
    if isDir && isFile then do
      want <- dirWant caseDir
      derived <- wantCase family source id want
      pure (case derived of
        ErrC msg => [brokenFamilyCase family (diagText msg)]
        OkC c => [c]
      )
    else pure []

-- | 内部：文件型 family——每个夹具 `*.vuna` 一个 case；目录缺失给一个 `CBroken`
-- 占位 case。
discoverFileFamily : Member nFs FsOp r => Suite -> Family -> Eff r (List Case)
discoverFileFamily suite family =
  let
    dir = "${suite.suiteRoot}/${family.familyDir}"
  in do
    exists <- pathExistsDir dir
    if not exists then pure [brokenFamilyCase family "family dir not found: ${dir}"]
    else do
      names <- fsReadDir dir
      concatMapEff (oneFile family dir) names

-- | 内部：文件名是否命中 family 的 `exclude`。
matchesExclude : Family -> String -> Bool
matchesExclude family name = matchesAnyExclude family.familyExclude name

-- | 内部：任一模式是文件名的子串即命中。
matchesAnyExclude : List String -> String -> Bool
matchesAnyExclude [] name = False
matchesAnyExclude (pat :: rest) name =
  if contains pat name then True else matchesAnyExclude rest name

-- | 内部：文件名是否命中 family 的 `include`。
matchesInclude : Family -> String -> Bool
matchesInclude family name = matchesAnyExclude family.familyInclude name

-- | 内部：`include` 非空时启用白名单过滤。
includeActive : Family -> Bool
includeActive family = case family.familyInclude of
  [] => False
  _ => True

-- | 内部：为一个夹具文件建 case——跳过非夹具、被 `exclude` 排除与未命中 `include`
-- 的文件。
oneFile : Member nFs FsOp r => Family -> String -> String -> Eff r (List Case)
oneFile family dir name = if isFixtureName name then
  if matchesExclude family name then pure []
  else if includeActive family && not (matchesInclude family name) then pure []
  else
    let
      source = "${dir}/${name}"
    in do
      derived <- fileCase family source (stripVuna source) (stripVuna name)
      pure (case derived of
        ErrC msg => [brokenFamilyCase family (diagText msg)]
        OkC c => [c]
      )
else pure []

-- | 内部：按 `kind` 选 case 形态——lint 用 `<base>.out`，fix 用 `<base>.expected`，
-- check-error 用 `<base>.diag.json`；check-ok 无期望文件；其余走 `parseWant` + `wantCase`
-- （`steps` 由 `discoverStepsFamily` 处理，不走这里）。
fileCase : Member nFs FsOp r => Family -> String -> String -> String -> Eff r (Check Case)
fileCase family source base rel =
  let
    id = "${family.familySection}/${family.familyName}/${rel}"
  in if family.familyKind == "lint" then
    let
      expected = "${base}.out"
    in do
      exists <- pathExistsFile expected
      if exists then pure
        (OkC (Case id family.familySection family.familyTags (CLint source expected) family.familyTimeout "fast" family.familyMatrix))
      else pure (err "expected file not found: ${expected}")
  else if family.familyKind == "fix" then
    let
      expected = "${base}.expected"
    in do
      exists <- pathExistsFile expected
      if exists then pure
        (OkC (Case id family.familySection family.familyTags (CFix source expected) family.familyTimeout "fast" family.familyMatrix))
      else pure (err "expected file not found: ${expected}")
  else if family.familyKind == "steps" then pure
    (OkC (Case id family.familySection family.familyTags (CSteps source) family.familyTimeout "e2e" family.familyMatrix))
  else if family.familyKind == "check-ok" then pure
    (OkC (Case id family.familySection family.familyTags (CCheck source True "") family.familyTimeout "fast" family.familyMatrix))
  else if family.familyKind == "check-error" then do
    expected <- expectPath base
    exists <- pathExistsFile expected
    if exists then pure
      (OkC (Case id family.familySection family.familyTags (CCheck source False expected) family.familyTimeout "fast" family.familyMatrix))
    else pure (err "expected file not found: ${expected}")
  else do
    want <- parseWant base
    wantCase family source id want

-- | 内部：family 级错误的占位 case（id 以 `__missing__` 结尾，tier 记 `e2e`）。
brokenFamilyCase : Family -> String -> Case
brokenFamilyCase family msg =
  Case "${family.familySection}/${family.familyName}/__missing__" family.familySection
    family.familyTags (CBroken msg) family.familyTimeout "e2e" family.familyMatrix

-- | 内部：steps family——目录里每个 `*.steps` 一个声明式 case。
discoverStepsFamily : Member nFs FsOp r => Suite -> Family -> Eff r (List Case)
discoverStepsFamily suite family =
  let
    dir = "${suite.suiteRoot}/${family.familyDir}"
  in do
    exists <- pathExistsDir dir
    if not exists then pure [brokenFamilyCase family "family dir not found: ${dir}"]
    else do
      names <- fsReadDir dir
      concatMapEff (stepCaseOf family dir) names

-- | 内部：一个 `*.steps` 文件对应的 case（tier 取文件头声明）。
stepCaseOf : Member nFs FsOp r => Family -> String -> String -> Eff r (List Case)
stepCaseOf family dir name = if not (endsWith ".steps" name) then pure []
else do
  text <- fsReadFile "${dir}/${name}"
  let
    rel = substring 0 (byteLength name - 6) name
    id = "${family.familySection}/${family.familyName}/${rel}"
  in pure
    [Case id family.familySection family.familyTags (CSteps "${dir}/${name}") family.familyTimeout (stepsTierOf text) (stepsMatrixOf family.familyMatrix text)]

-- | steps 文件任意位置出现 `# tier: tools|integration|fast` 即覆盖默认 tier；没有声明则归 `e2e`。
stepsTierOf : String -> String
stepsTierOf text =
  if contains "# tier: tools" text then "tools"
  else if contains "# tier: integration" text then "integration"
  else if contains "# tier: fast" text then "fast" else "e2e"

-- | steps 文件的 `# matrix: <分类>` 覆盖 family 的矩阵分类；没有声明就用 family 的。
stepsMatrixOf : String -> String -> String
stepsMatrixOf familyMatrix text =
  if contains "# matrix: effect-common" text then "effect-common"
  else if contains "# matrix: effect-native" text then "effect-native"
  else if contains "# matrix: effect-wasm" text then "effect-wasm"
  else if contains "# matrix: pure-cross" text then "pure-cross"
  else if contains "# matrix: pure" text then "pure"
  else if contains "# matrix: effect-ocaml" text then "effect-ocaml" else familyMatrix

-- | 内部：按 kind 与 entry 选 discovery 方式（steps → 目录里找 `*.steps`；有 entry →
-- 目录型；否则文件型）。
discoverFamily : Member nFs FsOp r => Suite -> Family -> Eff r (List Case)
discoverFamily suite family = if family.familyKind == "steps" then discoverStepsFamily suite family
else case family.familyEntry of
  Just entry => discoverDirFamily suite family entry
  Nothing => discoverFileFamily suite family

-- ---------------------------------------------------------------
-- 对外入口
-- ---------------------------------------------------------------
-- | 对外入口：解析 suite 文件；相对路径按 cwd 补成绝对路径。
export parseSuiteFile : Member nFs FsOp r, Member nEnv EnvOp r => String -> Eff r (Check Suite)
parseSuiteFile path = do
  cwd <- envGetCwd
  let
    absPath = if startsWith "/" path then path else "${cwd}/${path}"
  in parseSuiteAt absPath

-- | 内部：读文件 → 解析 TOML → 构造 `Suite`。
parseSuiteAt : Member nFs FsOp r => String -> Eff r (Check Suite)
parseSuiteAt absPath = do
  contents <- readTextFile absPath
  case contents of
    ErrC e => pure (ErrC e)
    OkC text => case parseTomlAt absPath text of
      ErrC e => pure (ErrC e)
      OkC entries => pure (buildSuiteWithEntries absPath entries)

-- | 对外入口：把每个 family 展开成 case；`test/corpus/run/12_fact.vuna` 存在时追加
-- 一个固定的 seed 自举 case（id `13/seed`）。
export discoverCases : Member nFs FsOp r => Suite -> Eff r (List Case)
discoverCases suite =
  let
    seedPath = "${suite.suiteRoot}/test/corpus/run/12_fact.vuna"
    seed =
      [ Case "13/seed" "13" ["seed"] (CSeed seedPath "${suite.suiteRoot}/test/corpus/run/12_fact.out") 900 "integration" "tool"
      ]
  in do
    base <- concatMapEff (discoverFamily suite) suite.suiteFamilies
    hasSeed <- pathExistsFile seedPath
    pure (append base (if hasSeed then seed else []))
