-- | LSP 的传输与通用工具层：JSON-RPC 帧与信封、URI 编解码、位置换算、日志与光标小工具。
--
-- JSON-RPC 2.0 的唯一实现在 [Vuna.Json.Frame]（字节级切帧 / 发帧）与 [Vuna.Json.Rpc]
-- （`id` / `method` / `params` 读取，`result` / `error` / 通知构造，错误码）；本模块只重导出
-- 它们，调用点保持 `sendFrame` / `responseOk` / `idOf` 等名字。连接循环（读帧 → 分发 → 发帧）
-- 在 [Vuna.Json.Server]，LSP 与 REPL server 共用这份机械层，各自的请求语义与错误策略留在
-- 各自模块。
--
-- 位置换算：vuna 的 `Span` 从 1 开始，LSP 从 0 开始；`lspPosition` / `lspRange` 负责下行，
-- `spanRange` 直接把 `Span` 转成 LSP `Range`。
module Vuna.Lsp.Protocol where

import Vuna.Compiler.Base.Common
import Vuna.Json
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes
export module Vuna.Json.Frame
export module Vuna.Json.Rpc

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
-- | 两值取较大者。
export maxInt : Int -> Int -> Int
maxInt a b = if a >= b then a else b

-- | 把 `v` 夹到闭区间 `[lo, hi]`。
export clampInt : Int -> Int -> Int -> Int
clampInt lo hi v = if v < lo then lo else if v > hi then hi else v

-- | 列表是否为空。
export isEmptyList : List a -> Bool
isEmptyList [] = True
isEmptyList _ = False

-- | 字节是否为 ASCII 标识符字符（字母、数字、下划线）。
export isWordCode : Int -> Bool
isWordCode c = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

-- | 从列表头开始连续标识符字符的个数（从光标向左扫描用）。
export wordPrefixLen : List Int -> Int
wordPrefixLen [] = 0
wordPrefixLen (c :: rest) = if isWordCode c then 1 + wordPrefixLen rest else 0

-- | 从列表头开始连续标识符字符或 `.` 的个数（用于限定名的左侧部分）。
export qualPrefixLen : List Int -> Int
qualPrefixLen [] = 0
qualPrefixLen (c :: rest) = if isWordCode c || c == 46 then 1 + qualPrefixLen rest else 0

-- | 第 `i` 个字符的字节码（0-based）；越界返回 -1。
export nthCode : List Int -> Int -> Int
nthCode [] i = 0 - 1
nthCode (c :: rest) i = if i <= 0 then c else nthCode rest (i - 1)

-- | 去掉列表头部的连续 `.`。
export dropDotCodes : List Int -> List Int
dropDotCodes [] = []
dropDotCodes (c :: rest) = if c == 46 then dropDotCodes rest else c :: rest

-- | 去掉字符串末尾的连续 `.`（`Base.Data.List.` → `Base.Data.List`）。
export stripTrailingDots : String -> String
stripTrailingDots s = strPack (reverse (dropDotCodes (reverse (strUnpack s))))

-- | 列表最后一个元素。
export lastElem : List a -> Maybe a
lastElem [] = Nothing
lastElem (x :: rest) = case rest of
  [] => Just x
  _ => lastElem rest

-- | 点分名的最后一段（`Base.Data.List.map` → `map`）。
export lastSegment : String -> String
lastSegment token = case lastElem (splitOnDot token) of
  Nothing => token
  Just x => x

-- ---------------------------------------------------------------
-- URI：file:// + %XX 解码/编码
-- ---------------------------------------------------------------
-- | `file://` URI 前缀。
export fileScheme : String
fileScheme = "file://"

-- | 十六进制字符的数值；非十六进制字符返回 -1。
export hexValue : Int -> Int
hexValue c =
  if c >= 48 && c <= 57 then c - 48
  else if c >= 97 && c <= 102 then c - 87 else if c >= 65 && c <= 70 then c - 55 else 0 - 1

-- | 0..15 → 小写十六进制字符的字节码。
export hexDigitCode : Int -> Int
hexDigitCode v = if v < 10 then 48 + v else 87 + v

-- | 解码 `%XX` 转义；非法转义原样保留 `%`。
export percentDecode : String -> String
percentDecode s = percentDecodeChars (strUnpack s) []

-- | `percentDecode` 的字符级实现（`acc` 逆序累积）。
export percentDecodeChars : List Int -> List Int -> String
percentDecodeChars [] acc = strPack (reverse acc)
percentDecodeChars (c :: rest) acc = if c == 37 then case rest of
  h :: l :: more =>
    let
      hv = hexValue h
      lv = hexValue l
    in if hv >= 0 && lv >= 0 then percentDecodeChars more (hv * 16 + lv :: acc)
    else percentDecodeChars rest (37 :: acc)
  _ => percentDecodeChars rest (37 :: acc)
else percentDecodeChars rest (c :: acc)

-- | URI 路径里无需编码的字符（字母数字、`/`、`.`、`-`、`~`）。
export uriSafe : Int -> Bool
uriSafe c = isWordCode c || c == 47 || c == 46 || c == 45 || c == 126

-- | 把路径里的非安全字符编码成 `%XX`。
export percentEncode : String -> String
percentEncode s = strPack (reverse (percentEncodeChars (strUnpack s) []))

-- | `percentEncode` 的字符级实现（逆序累积）。
export percentEncodeChars : List Int -> List Int -> List Int
percentEncodeChars [] acc = acc
percentEncodeChars (c :: rest) acc =
  if uriSafe c then percentEncodeChars rest (c :: acc)
  else
    percentEncodeChars rest (hexDigitCode (c - c / 16 * 16) :: hexDigitCode (c / 16) :: 37 :: acc)

-- | 文件系统路径 → `file://` URI（非安全字符走 %XX）。
export pathToUri : String -> String
pathToUri path = fileScheme ++ percentEncode path

-- | `file://` URI → 文件系统路径；不是 `file://` 前缀时返回 ""。
export decodeUri : String -> String
decodeUri uri =
  if startsWith fileScheme uri then percentDecode (substring 7 (byteLength uri - 7) uri) else ""

-- 路径工具按**最后一个** `/` 切：`Vuna.Compiler.Base.Common.splitPath` 按第一个 `/` 切，
-- 取不了目录 / basename。
-- | 扫描字节找最后一个 `/` 的下标（找不到 -1）。
export lastSlashGo : List Int -> Int -> Int -> Int
lastSlashGo [] idx last = last
lastSlashGo (c :: rest) idx last = lastSlashGo rest (idx + 1) (if c == 47 then idx else last)

-- | 最后一个 `/` 的字节下标；没有则 -1。
export lastSlashIndex : String -> Int
lastSlashIndex s = lastSlashGo (strUnpack s) 0 (0 - 1)

-- | 目录部分（无 `/` 时返回 "."；根 `/` 返回 "/"）。
export dirOfPath : String -> String
dirOfPath path = case lastSlashIndex path of
  i => if i < 0 then "." else if i == 0 then "/" else substring 0 (natFromInt i) path

-- | 最后一段（文件名或目录名）。
export fileNameOf : String -> String
fileNameOf path = case lastSlashIndex path of
  i =>
    if i < 0 then path
    else substring (natFromInt (i + 1)) (natFromInt (strLength path - i - 1)) path

-- | 上一级目录（已在根上时原样返回）。
export parentDir : String -> String
parentDir path =
  let
    d = dirOfPath path
  in if d == path then path else d

-- ---------------------------------------------------------------
-- 位置换算：vuna 的 Span 从 1 开始，LSP 从 0 开始
-- ---------------------------------------------------------------
-- | 1-based 行 / 列 → LSP `Position`（0-based，夹到非负）。
export lspPosition : Int -> Int -> Json
lspPosition line col =
  JObj [Pair "line" (JNum (maxInt 0 (line - 1))), Pair "character" (JNum (maxInt 0 (col - 1)))]

-- | 1-based 起止行列 → LSP `Range`。
export lspRange : Int -> Int -> Int -> Int -> Json
lspRange sl sc el ec = JObj [Pair "start" (lspPosition sl sc), Pair "end" (lspPosition el ec)]

-- | `Span`（1-based，含端点）→ LSP `Range`。
export spanRange : Span -> Json
spanRange sp = lspRange (spanStartLine sp) (spanStartCol sp) (spanEndLine sp) sp.spanEndCol

-- ---------------------------------------------------------------
-- 文档位置上的 token / 名字
-- ---------------------------------------------------------------
-- | 第 `line` 行（1-based）的文本；越界返回 ""。
export lineText : String -> Int -> String
lineText text line = lineAt1 (split "\n" text) line

-- | 1-based 取行。
export lineAt1 : List String -> Int -> String
lineAt1 [] n = ""
lineAt1 (x :: rest) n = if n <= 1 then x else lineAt1 rest (n - 1)

-- | 光标（1-based 行 / 列）处的名字：允许限定名（`Base.Data.List.map`）并去掉尾部 `.`；
-- 返回 (起始列, 名字)，不在名字上给 `Nothing`。
export tokenAtCursor : String -> Int -> Int -> Maybe (Pair Int String)
tokenAtCursor text line col =
  let
    ln = lineText text line
    chars = strUnpack ln
    p0 = clampInt 0 (col - 1) (length chars)
    left = reverse (take p0 chars)
    right = drop p0 chars
    startP = p0 - qualPrefixLen left
    endP = p0 + qualPrefixLen right
  in if endP - startP <= 0 then Nothing
  else
    let
      token = stripTrailingDots (substring (natFromInt startP) (natFromInt (endP - startP)) ln)
    in if token == "" then Nothing else Just (Pair (startP + 1) token)

-- ---------------------------------------------------------------
-- span / 文本定位小工具（Bindings / Query 共用）
-- ---------------------------------------------------------------
-- | (l1, c1) 是否不晚于 (l2, c2)。
export posBeforeOrEq : Int -> Int -> Int -> Int -> Bool
posBeforeOrEq l1 c1 l2 c2 = l1 < l2 || l1 == l2 && c1 <= c2

-- | 1-based 位置是否落在 span 内（含端点；与 `Fmt.Comment.containsPos` 同口径）。
export spanContainsPos : Span -> Int -> Int -> Bool
spanContainsPos sp line col =
  posBeforeOrEq (spanStartLine sp) (spanStartCol sp) line col
    && posBeforeOrEq line col (spanEndLine sp) sp.spanEndCol

-- | 子串首次出现的字节偏移；找不到返回 -1。
export findSubstring : String -> String -> Int
findSubstring needle hay = findSubGo (strUnpack needle) (strUnpack hay) 0

-- | `findSubstring` 的游标实现（字节偏移逐位前进）。
export findSubGo : List Int -> List Int -> Int -> Int
findSubGo needle [] idx = 0 - 1
findSubGo needle (c :: rest) idx =
  if isPrefixChars needle (c :: rest) then idx else findSubGo needle rest (idx + 1)

-- | `needle` 是否为 `hay` 的前缀。
export isPrefixChars : List Int -> List Int -> Bool
isPrefixChars [] _ = True
isPrefixChars _ [] = False
isPrefixChars (x :: xs) (y :: ys) = x == y && isPrefixChars xs ys

-- | 在 span 覆盖的行范围里找名字的起始位置（1-based line / col）。
export findNamePos : List String -> Span -> String -> Maybe (Pair Int Int)
findNamePos lines sp name =
  scanNameLines (spanStartLine sp) True (spanStartCol sp) (spanEndLine sp)
    (drop (spanStartLine sp - 1) lines) name

-- | 逐行扫描名字；首行从 `spanStartCol` 起找，之后每行从行首起找。
export scanNameLines : Int -> Bool -> Int -> Int -> List String -> String -> Maybe (Pair Int Int)
scanNameLines lineNo isFirst firstCol lastLine remaining name = if lineNo > lastLine then Nothing
else case remaining of
  [] => Nothing
  ln :: rest =>
    let
      from0 = clampInt 0 (if isFirst then firstCol - 1 else 0) (strLength ln)
      tailPart = substring (natFromInt from0) (natFromInt (strLength ln - from0)) ln
    in case findSubstring name tailPart of
      hit =>
        if hit >= 0 then Just (Pair lineNo (hit + from0 + 1))
        else scanNameLines (lineNo + 1) False firstCol lastLine rest name

-- 逐行写 `/dev/stderr` 每次打开都会截断前面的行，所以内存累积、退出时 join 一次。
-- | 日志行前缀（`[vuna-lsp] ...`）。
export logLine : String -> String
logLine s = "[vuna-lsp] ${s}\n"

-- | 逆序累积的日志行 → 单次写 `/dev/stderr`，返回写入字节数。
export flushLogLines : Member nFs FsOp r => List String -> Eff r Int
flushLogLines [] = pure 0
flushLogLines logs =
  fmap natToInt (fsWriteFile "/dev/stderr" (join "" (map logLine (reverse logs))))
