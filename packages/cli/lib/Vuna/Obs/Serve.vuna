-- | `vuna dev obs serve --cdp ADDR [--allow-slow] [TRACE...]`：一个 CDP Profiler 子集 server，
-- 把离线 trace 里的 CPU 采样换算成 CDP Profile 交给客户端。
--
-- 传输是 Content-Length JSON-RPC over socket（`Vuna.Json.Server.serveConnection`，与 REPL
-- server / LSP 共用帧层）。ADDR 只接受 `tcp:127.0.0.1:PORT`（`PORT=0` 用临时端口）或
-- `unix:PATH`：能连上端点就等于能驱动这个进程，任意地址等于任意代码执行。vuna 侧不做
-- WebSocket，CDP 握手（`Sec-WebSocket-Accept`）由工具侧资产 `test/corpus/obs-cdp/bridge.mjs`
-- 完成。
--
-- 语义是离线的：数据源是启动时读入的 TRACE 文件（0..N 份）；`Profiler.start` 只记一个
-- `startTimestamp`（进程内记账，不采样正在运行的进程），`Profiler.stop` 把 trace 里
-- `vuna.sample.cpu` 的整份采样换算成 CDP Profile 回给客户端（复用
-- [Vuna.Obs.Convert.cpuProfileOf] 这一个构造点）。这不是「附加到运行中进程做 live
-- sampling」。
--
-- 方法表：`Profiler.enable` / `Profiler.disable` / `Profiler.setSamplingInterval` → `{}`；
-- `Profiler.start` → `{}`；`Profiler.stop` → `{"profile": <cpuprofile>}`；
-- `Runtime.getIsolateId` → `{"id": "vuna-<pid>"}`，`<pid>` 是数据源 trace 的 pid（缺 trace
-- 时为 0）。其余方法一律 `-32601`；内容性失败（没配 trace、没 start 就 stop、trace 里没有
-- CPU 采样）回 `-32000` 并在 stderr 记一行诊断。
--
-- 生命周期：单连接、串行——listen → stdout 一行 `listening <ADDR>`（`PORT=0` 时打印实际
-- 端口）→ accept 一个连接 → 逐帧分发直到客户端断开或传输层致命错误 → 关连接与监听、清理
-- unix socket → 退出；不做并发连接。退出码：0 = 正常结束；1 = 会话里出现过内容性失败；
-- 2 = 用法 / 参数 / 输入前提错误（flag、ADDR 格式、TRACE 不存在或结构坏、空 trace、
-- 传输层致命错误）。`--allow-slow` 接受并忽略：本子命令没有墙钟阈值，保留 flag 只为固定
-- 命令行形状。规范见 `docs/reference/observability.md` §7 `serve --cdp`。
module Vuna.Obs.Serve where

import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Cli.Args
import Vuna.Cli.Spec
import Vuna.Compiler.Base.Common
import Vuna.Json
import Vuna.Json.Rpc
import Vuna.Json.Server
import Vuna.Obs.Convert
import Vuna.Obs.Read
import Vuna.Obs.Types
import Base.Effect.EffClock as EffClock
import Base.Effect.EffConsole as EffConsole
import Base.Effect.EffFs as EffFs
import Base.Effect.EffNet as EffNet
import Base.Effect.EffTypes as EffTypes

-- | JSON-RPC 2.0 保留的 server-error 区间起点：内容性失败（没有采样 / 没 start 就 stop）。
errServer : Int
errServer = 0 - 32000

-- | 内部：用法行。
serveUsage : String
serveUsage = "usage: vuna dev obs serve --cdp ADDR [--allow-slow] [TRACE...]"

-- | 内部：用法行 + ADDR / TRACE 的说明（`--cdp` 缺失时打印）。
serveAdvice : String
serveAdvice =
  "${serveUsage}\n  ADDR = tcp:127.0.0.1:PORT | unix:PATH（PORT=0 用临时端口）\n  TRACE = vuna-obs 1 trace（可给多份：CPU 采样按命令行顺序拼接）；省略则只能服 Profiler.enable / Runtime.getIsolateId"

-- ---------------------------------------------------------------
-- 会话状态
-- ---------------------------------------------------------------
-- | 一个连接的状态：启动时读入的 trace 事件（stop 时换算）、`Profiler.start` 的记账、
-- 以及内容性失败计数（决定进程退出码）。
export record ServeState(..) where
  -- | 全部数据源 trace 的事件（多份按命令行顺序拼接）。
  serveRows : List (Pair Int ObsEvent)
  -- | 当前连接是否已 `Profiler.start`（stop 的前置条件）。
  serveStarted : Bool
  -- | `Profiler.start` 记下的时钟读数（不进入响应体）。
  serveStartTs : Int
  -- | 会话内内容性失败次数；非 0 则进程退出码为 1。
  serveFailures : Int
  -- | `Runtime.getIsolateId` 回报的 pid（数据源 trace 的生产者）。
  serveTargetPid : Int
  -- | 客户端最近一次 `Profiler.setSamplingInterval` 的参数（只记录，不参与换算）。
  serveInterval : Maybe Int

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
-- | `vuna dev obs serve` 的入口；参数/输入前提错误退出码 2。
export runObsServe : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nNet NetOp r => List String -> Eff r Int
runObsServe args = case parseCmdArgs ["dev", "obs", "serve"] args of
  ErrC e => serveFail 2 (diagText e)
  OkC parsed => case flagValue parsed "cdp" of
    Nothing => serveFail 2 serveAdvice
    Just addr => case checkCdpAddr addr of
      ErrC e => serveFail 2 (diagText e)
      OkC _ => serveStart parsed.positionals addr

-- | 内部：先按命令行顺序读入全部 TRACE（失败即退出 2，不进入监听），再 listen + 打印就绪行 +
-- accept 一个连接。`--allow-slow` 没有分支读它。
serveStart : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nNet NetOp r => List String -> String -> Eff r Int
serveStart paths addr = do
  tracesR <- readServeTraces paths
  case tracesR of
    ErrC e => serveFail 2 (diagText e)
    OkC traces => do
      let
        targetPid = targetPidOf traces
      in do
        h <- netListen addr
        ready <- listeningText addr h
        _ <- consolePrint "listening ${ready}\n"
        serveOne (ServeState (concatRows traces) False 0 0 targetPid Nothing) addr h

-- | 内部：地址校验（只允许本机端点：`unix:PATH` 或 `tcp:127.0.0.1:PORT`）。
checkCdpAddr : String -> Check String
checkCdpAddr addr =
  if startsWith "unix:" addr && strLength addr > 5 then OkC addr
  else if startsWith "tcp:127.0.0.1:" addr && strLength addr > 14 then OkC addr
  else err
    "ADDR must be unix:PATH or tcp:127.0.0.1:PORT (loopback / Unix socket only; a reachable endpoint = arbitrary code execution)"

-- | 内部：逐份读入 trace；任一失败即停（错误带路径前缀，不静默跳过坏输入）。空 trace
-- （没有事件）也算前提失败：没有可换算的数据源。
readServeTraces : Member nFs FsOp r => List String -> Eff r (Check (List ObsTrace))
readServeTraces paths = readServeTracesGo paths []

-- | 内部：`readServeTraces` 的累积循环（逆序累积、结束时翻转）。
readServeTracesGo : Member nFs FsOp r => List String -> List ObsTrace -> Eff r (Check (List ObsTrace))
readServeTracesGo [] acc = pure (OkC (reverse acc))
readServeTracesGo (path :: rest) acc = do
  traceR <- readTraceFull path
  case traceR of
    ErrC e => pure (err "${path}: ${diagText e}")
    OkC trace =>
      if length trace.traceEvents == 0 then pure (err "${path}: empty trace (no events)")
      else readServeTracesGo rest (trace :: acc)

-- | 内部：多份 trace 的事件按命令行顺序拼接（不重排、不重编号）。跨机器的 `ts` 基准不可比，
-- 因此拼出来的 profile 时间轴不可比（要合并先 `vuna dev obs merge`）。
concatRows : List ObsTrace -> List (Pair Int ObsEvent)
concatRows traces = concatMap traceRowsOf traces

-- | 内部：一份 trace 的事件表。
traceRowsOf : ObsTrace -> List (Pair Int ObsEvent)
traceRowsOf trace = trace.traceEvents

-- | 内部：`Runtime.getIsolateId` 的 `<pid>`——数据源 trace 元数据里的 pid（产生这份 profile
-- 的进程）。多份 trace 取第一份的；没有 trace = 0。
targetPidOf : List ObsTrace -> Int
targetPidOf (first :: _) = eventPidOf first.traceEvents
targetPidOf [] = 0

-- | 内部：事件表首个事件的 pid；空表 = 0。
eventPidOf : List (Pair Int ObsEvent) -> Int
eventPidOf [] = 0
eventPidOf ((Pair _ ev) :: _) = eventPid ev

-- ---------------------------------------------------------------
-- 单连接循环
-- ---------------------------------------------------------------
-- | 内部：accept 一个连接 → `serveConnection` 逐帧分发 → 关连接与监听、清理地址 →
-- 按会话状态映射退出码（传输层致命错误 2，有内容性失败 1，否则 0）。
serveOne : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nNet NetOp r => ServeState -> String -> Int -> Eff r Int
serveOne st0 addr h = do
  conn <- netAccept h
  outcome <- serveConnection (netRecv conn) (\s => netSend conn s) cdpWarn handleCdp st0
  _ <- netClose conn
  _ <- netClose h
  _ <- cleanupAddr addr
  let
    final = secondOf outcome
  in case firstOf outcome of
    ExitFatal msg => do
      _ <- consoleEprint "[vuna-obs-cdp] ${msg}\n"
      pure 2
    _ => pure (if final.serveFailures > 0 then 1 else 0)

-- | 内部：就绪行里显示的地址——`tcp:...:0` 换成实际绑定的临时端口，便于脚本 / 桥从就绪行
-- 解析真实端口。
listeningText : Member nNet NetOp r => String -> Int -> Eff r String
listeningText addr h = do
  port <- netPort h
  pure
    (if endsWith ":0" addr then "${substring 0 (natFromInt (strLength addr - 1)) addr}${strFromInt port}" else addr)

-- | 内部：`unix:PATH` 里的路径部分（去掉 5 字符前缀）。
unixPathOf : String -> String
unixPathOf addr = substring (natFromInt 5) (natFromInt (strLength addr - 5)) addr

-- | 内部：unix socket 地址在退出前删掉监听文件；tcp 地址无事可做。
cleanupAddr : Member nFs FsOp r => String -> Eff r Int
cleanupAddr addr = if startsWith "unix:" addr then fsRemoveFile (unixPathOf addr) else pure 0

-- | 内部：传输告警——stderr 一行诊断 + 回 `-32700`，让客户端不会空等。
cdpWarn : Member nFs FsOp r, Member nConsole ConsoleOp r => String -> ServeState -> Eff r (Pair ServeState (List Json))
cdpWarn m st = do
  _ <- consoleEprint "[vuna-obs-cdp] ${m}\n"
  pure (Pair st [responseErr JNull errParse "parse error / bad frame: ${m}"])

-- ---------------------------------------------------------------
-- 分发
-- ---------------------------------------------------------------
-- | 内部：按方法名分发一帧。未知名回 `-32601`（不结束进程）；本子命令没有「请求退出」的帧，
-- 客户端断开或传输层致命错误才结束。
handleCdp : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r => Json -> ServeState -> Eff r (Pair Bool (Pair ServeState (List Json)))
handleCdp msg st = case methodOf msg of
  Nothing => pure (Pair False (Pair st [responseErr (idOf msg) errInvalidRequest "missing method"]))
  Just "Profiler.enable" => pure (Pair False (Pair st [responseOk (idOf msg) (JObj [])]))
  Just "Profiler.disable" =>
    pure (Pair False (Pair (resetStart st) [responseOk (idOf msg) (JObj [])]))
  Just "Profiler.start" => profilerStart msg st
  Just "Profiler.stop" => profilerStop msg st
  Just "Profiler.setSamplingInterval" => profilerSamplingInterval msg st
  Just "Runtime.getIsolateId" =>
    pure (Pair False (Pair st [responseOk (idOf msg) (isolateJson st.serveTargetPid)]))
  Just m =>
    pure (Pair False (Pair st [responseErr (idOf msg) errMethodNotFound "method not found: ${m}"]))

-- | 内部：`Runtime.getIsolateId` 的响应体（`vuna-<pid>`）。
isolateJson : Int -> Json
isolateJson pid = JObj [Pair "id" (JStr "vuna-${strFromInt pid}")]

-- | 内部：清掉 start 标记（`Profiler.disable` / 成功 stop 之后）。
resetStart : ServeState -> ServeState
resetStart st = { st | serveStarted = False }

-- | 内部：只记 `startTimestamp`——离线语义，不附加、不采样正在运行的进程。
profilerStart : Member nFs FsOp r, Member nClock ClockOp r => Json -> ServeState -> Eff r (Pair Bool (Pair ServeState (List Json)))
profilerStart msg st = do
  now <- clockNow
  let
    st2 = { st | serveStarted = True, serveStartTs = now }
  in pure (Pair False (Pair st2 [responseOk (idOf msg) (JObj [])]))

-- | 内部：整份 trace 的 CPU 采样换算成 CDP Profile（`Convert.cpuProfileOf`）；没 start 就
-- stop、或 trace 里没有 CPU 采样 = 内容性失败。
profilerStop : Member nFs FsOp r, Member nConsole ConsoleOp r => Json -> ServeState -> Eff r (Pair Bool (Pair ServeState (List Json)))
profilerStop msg st = if not st.serveStarted then
  stopError msg st "Profiler.start was not called on this connection before Profiler.stop"
else case cpuProfileOf st.serveRows of
  ErrC e => stopError msg st "Profiler.stop: ${diagText e}"
  OkC profile =>
    let
      st2 = resetStart st
    in pure (Pair False (Pair st2 [responseOk (idOf msg) (JObj [Pair "profile" profile])]))

-- | 内部：内容性失败的统一出口——stderr 诊断 + `-32000` + 计数（退出码 1 的来源），并清掉
-- start 标记（重试需要重新 start）。
stopError : Member nFs FsOp r, Member nConsole ConsoleOp r => Json -> ServeState -> String -> Eff r (Pair Bool (Pair ServeState (List Json)))
stopError msg st m = do
  _ <- consoleEprint "[vuna-obs-cdp] ${m}\n"
  let
    st2 = { st | serveStarted = False, serveFailures = st.serveFailures + 1 }
  in pure (Pair False (Pair st2 [responseErr (idOf msg) errServer m]))

-- | 内部：接受并忽略采样间隔——离线换算用 trace 里已有的采样，参数只记下来，不影响输出；
-- 缺 `params.interval` 或类型不对也照样回 `{}`。
profilerSamplingInterval : {r : Row} -> Json -> ServeState -> Eff r (Pair Bool (Pair ServeState (List Json)))
profilerSamplingInterval msg st =
  let
    iv = case jsonGetIn ["params", "interval"] msg of
      Just v => jsonAsInt v
      Nothing => Nothing
    st2 = { st | serveInterval = iv }
  in pure (Pair False (Pair st2 [responseOk (idOf msg) (JObj [])]))

-- ---------------------------------------------------------------
-- 错误出口（用法/参数/前提 = 退出码 2；内容性失败在会话内计数，见 serveOne）
-- ---------------------------------------------------------------
-- | 内部：打印 `error: ...` 并返回给定退出码。
serveFail : Member nConsole ConsoleOp r => Int -> String -> Eff r Int
serveFail code e = do
  _ <- consolePrint "error: ${e}\n"
  pure code
