    "vuna.elab.coverage",
    "vuna.elab.term",
    "vuna.elab.post",
    "vuna.elab.term.body",
    "vuna.elab.term.goals",
    "vuna.elab.term.retry",
    "vuna.elab.term.infer",
    "vuna.elab.term.core",
    "vuna.elab.instbodies",
    "vuna.elab.tail",
    "vuna.elab.incr.clean",
    "vuna.elab.incr.dirty",
    "vuna.elab.incr.decls",
    "vuna.lsp.goals.incremental",
    "vuna.lsp.goals.local",
    "vuna.lsp.goals.full",
    "vuna.lsp.goals.fallback",
    "vuna.lsp.goals.setup",
    "vuna.lsp.goals.elab",
    "vuna.lsp.session.clean",
    "vuna.lsp.session.ownNeeded",
    "vuna.lsp.session.unavailable",
    "vuna.lsp.session.skipped",
    "vuna.tool.clean.cands",
    "vuna.tool.clean.read",
    "vuna.tool.clean.kept",
    "vuna.tool.clean.reject.self",
    "vuna.tool.clean.reject.fresh",
    "vuna.tool.clean.reject.cached",
    "vuna.tool.clean.reject.missingdep",
    "vuna.tool.clean.reject.deps",
    "vuna.tool.ifaces.lookup",
    "vuna.tool.ifaces.ready",
    "vuna.tool.ifaces.missing",
    "vuna.tool.ifaces.disabled",
    "vuna.iface.compute",
    "vuna.iface.write",
    "vuna.codegen.check",
    "vuna.codegen.lower",
    "vuna.codegen.gen",
    "vuna.codegen.env",
    "vuna.codegen.prepare",
    "vuna.codegen.unit",
    "vuna.codegen.entry",
    "vuna.codegen.split",
