-- | 持久包 store：内容寻址对象 + 可重建的物化视图。
--
-- `$VUNA_STORE` 下的两类生命周期（一个根、两个族）：
--
--   objects/pkg/<64hex>  不可变对象：`pkg-source 1` 规范编码，地址 = 内容摘要（SHA-256）。
--                        对象是**唯一真源**；写入原子替换（`fsWriteFileAtomic`）。
--   pkgs/<64hex>/        物化视图：从对象解出的文件树，最后写 `.complete`（内容 = 摘要）
--                        作为提交点。视图可删可重建；读前校验 `.complete`，不符就重建。
--
-- 包对象放在 `objects/pkg/` 这个 kind 目录下，而不是 `objects/<hex>`：缓存族按
-- `objects/<kind>/` 分目录，`clean --store` / `store gc` 才能按族作用域，不会误删包对象。
-- 对象 framing 复用 [Vuna.Compiler.Base.Store]（同样的 magic / codec / 长度 / 内容地址校验），
-- 但 tag 不含编译器指纹：包对象跨编译器版本复用（它们只是源码字节）。本模块只做读写与
-- 物化；**取包**（git / url）在 [Vuna.Fetch]，两者都不进 seed。
module Vuna.PackageStore where

import Vuna.Compiler.Frontend.Canonical.Pkg
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Frontend.Packages.Source
import Vuna.Compiler.Base.Store
import Base.Data.List as List
import Base.Data.String as String
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes
import Base.Effect.Env as EffEnv
import Base.Effect.Process as EffProcess

-- | 持久 store 根（`VUNA_STORE` → XDG → `~/.vuna/store`）。
export storeRootEff : Member nEnv EnvOp r => Eff r String
storeRootEff = storeDataRootEff

-- | 对象文件路径（包对象族：`objects/pkg/<digest>`）。
export objectPathOf : String -> String -> String
objectPathOf root digest = "${root}/objects/pkg/${digest}"

-- | 包对象族的目录（写侧建目录、clean/gc 的族边界）。
export packageObjectsDir : String -> String
packageObjectsDir root = "${root}/objects/pkg"

-- | 物化视图目录。
export materializedDir : String -> String -> String
materializedDir root digest = "${root}/pkgs/${digest}"

-- | 对象 tag（`pkg-source/1`）：管载荷 schema 版本，不含编译器指纹。
packageTag : String
packageTag = "pkg-source/1"

-- | 对象 codec 名：`storeEncodeAs` / `storeReadAsEff` 的编解码器标识。
packageCodec : String
packageCodec = "pkg-source 1"

-- | 写对象（原子替换；地址由调用方给出并已在写前校验）。
export writeObjectEff : Member nFs FsOp r, Member nProcess ProcessOp r => String -> String -> List PackageFile -> Eff r Int
writeObjectEff root digest files = do
  _ <- ensureDirPath (packageObjectsDir root)
  let
    payload = encPackageContent files
  in do
    _ <-
      fsWriteFileAtomic (objectPathOf root digest)
        (storeEncodeAs packageTag packageCodec digest payload)
    pure 0

-- | 读对象（framing + 内容地址校验后解码）；缺失/损坏 ⇒ `Nothing`。
export readObjectEff : Member nFs FsOp r => String -> String -> Eff r (Maybe (List PackageFile))
readObjectEff root digest = do
  payload <- storeReadAsEff packageTag packageCodec digest (objectPathOf root digest)
  pure (case payload of
    Nothing => Nothing
    Just raw => decPackageContent raw
  )

-- | 物化视图是否完整（`.complete` 内容必须等于摘要）。
export isMaterializedEff : Member nFs FsOp r => String -> String -> Eff r Bool
isMaterializedEff root digest = do
  let
    marker = "${materializedDir root digest}/.complete"
  in do
    exists <- fsFileExists marker
    if exists then do
      text <- fsReadFile marker
      pure (text == digest)
    else pure False

-- | 物化：逐文件写盘，最后写 `.complete`（提交点）；并发重复物化是幂等的。
export materializeEff : Member nFs FsOp r, Member nProcess ProcessOp r => String -> String -> List PackageFile -> Eff r Int
materializeEff root digest files = do
  let
    dir = materializedDir root digest
  in do
    _ <- ensureDirPath dir
    _ <- writePackageFiles dir files
    _ <- fsWriteFileAtomic "${dir}/.complete" digest
    pure 0

-- | 内部：把包文件列表逐个写进物化目录，每个文件前先建好父目录。
writePackageFiles : Member nFs FsOp r, Member nProcess ProcessOp r => String -> List PackageFile -> Eff r Int
writePackageFiles dir [] = pure 0
writePackageFiles dir (f :: rest) = do
  _ <- ensureDirPath (parentDirOf "${dir}/${f.pfPath}")
  _ <- fsWriteFileAtomic "${dir}/${f.pfPath}" f.pfContent
  writePackageFiles dir rest

-- | 内部：路径的父目录（无 `/` ⇒ `"."`，即当前目录）。
parentDirOf : String -> String
parentDirOf path = case split "/" path of
  [] => "."
  [only] => "."
  parts => join "/" (take (listLen parts - 1) parts)

-- | 内部：列表长度。
listLen : List a -> Int
listLen [] = 0
listLen (_ :: rest) = 1 + listLen rest
