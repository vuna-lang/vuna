-- | `Semigroup`（`mappend`）与 `Monoid`（`mempty`）两个 trait。
--
-- 两者刻意**无父子关系**：泛型代码同时约束 `Monoid m, Semigroup m =>`，结合运算与单位元各自独立。
--
-- 方法名用 `mappend` / `mempty`（与 `Base.Data.List.append`、`Base.Container.Map.empty` 错开），避免 Prelude 自动注入后的短名歧义。
module Base.Trait.Monoid where

-- | 结合二元运算 trait：`mappend` 可结合（List 拼接、String 拼接、Nat 加法等）。
export trait Semigroup a(..) where
  -- | 结合二元运算（`List` 拼接、`String` 拼接、`Nat` 加法等）。
  mappend : a -> a -> a

-- | 单位元 trait：`mempty` 与 `Semigroup.mappend` 配合（无父类，泛型代码同时约束两者）。
export trait Monoid a(..) where
  -- | 单位元：`mappend mempty x` 与 `mappend x mempty` 都等于 `x`。
  mempty : a
