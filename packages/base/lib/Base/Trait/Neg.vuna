module Base.Trait.Neg where

-- Base.Trait.Neg：一元取负（前缀 `-` 的语义来源）。
--
-- 前缀 `-` 在 parser 里展开成 `negate x`；`negate` 是独立 trait，不放进 `Num`：
-- `Nat` 没有加法逆元，`-x : Nat` 必须是类型错误（而不是静默截断成 0）。
-- 实例跟类型模块走：`Int` 在 `Base.Data.Int`、`Float` 在 `Base.Data.Float`。
export trait Neg a(..) where
  -- | 加法逆元：`negate x` 满足 `negate x + x == 0`。
  negate : a -> a
