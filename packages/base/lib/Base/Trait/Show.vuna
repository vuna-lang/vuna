-- | `Show` trait 与 `String` 实例：把值渲染为可读文本。
--
-- 方法面与编译器内建 `Show` 逐位对齐（方法名 / 参数顺序 / 返回类型），`deriving (Show)` 展开出的实例体直接落在本 trait 上，无需额外语义。
--
-- 实例按「实例跟类型模块走」分布：`Int` 的实例在 `Base.Data.Int`、`Bool` 的实例在 `Base.Data.Bool`。`String` 例外留在本模块——`show : a -> String` 直接依赖 `String`，而 `Base.Data.String → Base.Trait.Interp → Base.Trait.Show` 已构成 import 环，`Show String` 放进 `Base.Data.String` 会成环。
module Base.Trait.Show where

-- | 把值渲染为可读 String 的 trait，只有一个方法 `show`。
export trait Show a(..) where
  -- | 把值渲染为可读字符串（面向阅读，不是可解析的序列化格式）。
  show : a -> String

-- 与 runtime 展示共用同一实现（`strShow` 是唯一转义源）。
instance Show String where
  show s = strShow s

-- | 调试展示 trait：默认实现由 `Show` 派生，因此**所有 `Show` 实例自动获得
-- `DebugShow`**（blanket instance）；需要不同调试格式的类型可另写实例。
export trait DebugShow a(..) where
  -- | 输出调试表示；默认即 `show`，需要更稳定或可解析格式的类型可覆盖。
  debugShow : a -> String

-- | 默认实现：直接用 `show`。blanket instance 的约束由实例 ctx 承担（`Show a`）。
instance Show a => DebugShow a where
  debugShow x = show x

-- | 调试打印：把 `debugShow x` 交给内置宏 `dbg!`（受 `--debug-perf` / `VUNA_DEBUG_PERF=1`
-- 门控，带时间戳写 stderr）后返回 `x`；值语义不变，只用于调试。
-- 见 docs/reference/debugging.md §3。
export dbgShow : DebugShow a => a -> a
dbgShow x =
  let
    _ = dbg! (debugShow x)
  in x
