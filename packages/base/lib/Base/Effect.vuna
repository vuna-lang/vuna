-- | 效应门面：`Eff` 运行时核心、类型面、handler 原语与宿主效应模块。
-- 只提供路径（`import Base.Effect.Fs as Fs`），不扁平重导出：`Core` 与 `Types`
-- 覆盖面重叠，多个模块还有同名 handler 入口。
--
-- `Pure` 子树是纯表示（无运行时 handler），见 [Base.Effect.Pure]。
module Base.Effect where

export module Base.Effect.Core as Core
export module Base.Effect.Host as Host
export module Base.Effect.Types as Types
export module Base.Effect.State as State
export module Base.Effect.Reader as Reader
export module Base.Effect.Error as Error
export module Base.Effect.Exn as Exn
export module Base.Effect.MutArray as MutArray
export module Base.Effect.MutBuffer as MutBuffer
export module Base.Effect.MutRef as MutRef
export module Base.Effect.MutVec as MutVec
export module Base.Effect.MutDynArray as MutDynArray
export module Base.Effect.Cursor as Cursor
export module Base.Effect.Fs as Fs
export module Base.Effect.Console as Console
export module Base.Effect.Clock as Clock
export module Base.Effect.Env as Env
export module Base.Effect.Args as Args
export module Base.Effect.Stdin as Stdin
export module Base.Effect.Tty as Tty
export module Base.Effect.Exit as Exit
export module Base.Effect.Net as Net
export module Base.Effect.Process as Process
export module Base.Effect.Pure as Pure
