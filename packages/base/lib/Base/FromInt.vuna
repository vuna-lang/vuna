-- | 整数字面量转换 trait：期望类型不是 `Int` 且存在本实例时，整数字面量降级成 `fromInt n`。
--
-- 字面量本身没有一元负号（负数写 `0 - n`），实例收到的值是非负的。
--
-- 期望类型是 `Nat` 时字面量仍展开成 `Zero`/`Succ` 链，不走本 trait；显式 Int→Nat 用 `Base.Nat.fromInt`。
module Base.FromInt where

-- | 把整数字面量转换为 `a`：期望类型为 `a` 且存在本实例时，`42` 等价于 `fromInt 42`。
export trait FromInt a(..) where
  -- | 由 `Int` 构造 `a`；`n` 非负，负数写法由调用方用 `0 - n` 表达。
  fromInt : Int -> a

-- `Int` 是字面量的默认类型：恒等转换。
instance FromInt Int where
  fromInt n = n
