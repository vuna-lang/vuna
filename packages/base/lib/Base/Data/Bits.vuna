-- | 位运算：命名入口 + 32-bit 固定宽度包装。`Int` 是 63-bit 二进制补码；移位计数 `n < 0 || n >= 63` 时结果为 0，`shr` 是逻辑右移（高位补 0）。宽度策略留在库里、不进原语：SHA-256 / 编码 / 校验和这类算法用 `mask32` / `add32` / `rotr32` 表达固定 32-bit 算术。
module Base.Data.Bits where

import Base.Trait.Num

-- | 按位与（63-bit）。
export band : Int -> Int -> Int
band a b = bitAnd a b

-- | 按位或（63-bit）。
export bor : Int -> Int -> Int
bor a b = bitOr a b

-- | 按位异或（63-bit）。
export bxor : Int -> Int -> Int
bxor a b = bitXor a b

-- | 按位取反（63-bit）：`bnot x = -x - 1`。
export bnot : Int -> Int
bnot a = bitNot a

-- | 左移（63-bit，低位补 0）；计数越界返回 0。
export shl : Int -> Int -> Int
shl a n = bitShl a n

-- | 逻辑右移（63-bit，高位补 0）；计数越界返回 0。
export shr : Int -> Int -> Int
shr a n = bitShr a n

-- | 取低 32 位。
export mask32 : Int -> Int
mask32 x = band x 4294967295

-- | 取低 8 位（一个字节）。
export mask8 : Int -> Int
mask8 x = band x 255

-- `x < 2^32` 时 `x << 31` 越过 63-bit 范围，由随后的 `mask32` 截回低 32 位。
-- | 32-bit 左移（先移位再取低 32 位）。
export shl32 : Int -> Int -> Int
shl32 x n = mask32 (shl x n)

-- | 32-bit 逻辑右移（输入按低 32 位处理，结果 < 2^32）。
export shr32 : Int -> Int -> Int
shr32 x n = shr (mask32 x) n

-- | 32-bit 加法（模 2^32）。
export add32 : Int -> Int -> Int
add32 a b = mask32 (a + b)

-- | 32-bit 循环右移；`n` 先对 32 取模（按非负计数使用）。
export rotr32 : Int -> Int -> Int
rotr32 x n =
  let
    m = n - n / 32 * 32
    low = band x (shl 1 m - 1)
  in bor (shr32 x m) (shl low (32 - m))

-- | 32-bit 循环左移；`n` 先对 32 取模。
export rol32 : Int -> Int -> Int
rol32 x n =
  let
    m = n - n / 32 * 32
    low = shl32 x m
    high = shr32 x (32 - m)
  in bor low high
