-- | `Float` primitive 类型的宿主模块（实例 + 字面量转换 trait + 转换 helper）。运行时表示是 OCaml IEEE-754 double（编译器内建，没有 data 声明）。本模块随 `Prelude` 自动导出：`FromFloat`、转换 helper 与 `Eq` / `Ord` / `Show Float` 实例都不需要显式 import（显式 import 仍允许）。代价是 Prelude 闭包包含本模块，所有程序生成的运行时都会带浮点 helper；`main` 不含浮点的纯程序在核心求值路径（`vuna test` 纯测试 / REPL）下不受影响，细节见 docs/reference/floats.md。
module Base.Data.Float where

import Base.Trait.Eq
import Base.Data.Bool
import Base.Data.List
import Base.Data.Maybe
import Base.Data.Nat
import Base.Trait.Neg
import Base.Trait.Num
import Base.Trait.Ord
import Base.Data.Pair
import Base.Trait.Show
import Base.Data.String

-- | 把 `Float` 字面量转换为 `a`：期望类型为 `a` 且存在本实例时，`1.5` 等价于
-- `fromFloat 1.5`（与 `FromString` / `FromInt` 同一套 checking 位置降级规则）。
export trait FromFloat a(..) where
  -- | 把 `Float` 转成 `a`。
  fromFloat : Float -> a

-- `Float` 是字面量的默认类型：恒等转换。
instance FromFloat Float where
  fromFloat x = x

instance Eq Float where
  (==) x y = x == y
  (/=) x y = x /= y

instance Ord Float where
  (<) x y = x < y
  (<=) x y = x <= y
  (>) x y = x > y
  (>=) x y = x >= y

-- 方法体写内建运算符，由精化器特化成 `bi_*_float`（`+` 是 `add` 别名，不自递归）。
instance Num Float where
  (+) x y = x + y
  (-) x y = x - y
  (*) x y = x * y
  (/) x y = x / y

-- `strFromFloat` 在编译期落成 `floatRender`（与 `%.12g` 对齐）；interp 直接用内建归约。
instance Neg Float where
  negate x = 0.0 - x

instance Show Float where
  show x = strFromFloat x

-- | 浮点绝对值（对应 OCaml `abs_float`）。
export abs : Float -> Float
abs = floatAbs

-- | 浮点平方根（对应 OCaml `sqrt`）。
export sqrt : Float -> Float
sqrt = floatSqrt

-- | Int → Float（有损：超出 2^53 的整数会舍入；对应 OCaml `float_of_int`）。
export intToFloat : Int -> Float
intToFloat = floatFromInt

-- | Float → Int，向零截断。NaN / ±inf / 超界时结果由后端 `intFromFloat` 决定；
-- 需要定义良好的边界行为时用 `floatToIntSat` 或 `floatToIntMaybe`。
export floatToIntTrunc : Float -> Int
floatToIntTrunc = intFromFloat

-- | Float → Int，向零截断后饱和：NaN → 0，≥ 2^62 → max_int，< -2^62 → min_int。
export floatToIntSat : Float -> Int
floatToIntSat x =
  if x /= x then
    0
  else if x >= 4611686018427387903.0 then
    4611686018427387903
  else if x < 0.0 - 4611686018427387903.0 then 0 - 4611686018427387903 - 1 else floatToIntTrunc x

-- | Float → Int，可表示才给 `Just`：`-2^62 <= x < 2^62` 且非 NaN / ±inf；向零截断。
export floatToIntMaybe : Float -> Maybe Int
floatToIntMaybe x =
  if x /= x then
    Nothing
  else if x >= 4611686018427387903.0 then
    Nothing
  else if x < 0.0 - 4611686018427387903.0 then Nothing else Just (floatToIntTrunc x)

-- | 向零截断后夹到 `Nat`：NaN 与负数都变成 0。
export floatToNat : Float -> Nat
floatToNat x = natFromInt (floatToIntSat x)

-- | 向零截断后转 `Nat`：负数、NaN、±inf、超界都返回 `Nothing`。
export floatToNatMaybe : Float -> Maybe Nat
floatToNatMaybe x =
  if x < 0.0 then
    Nothing
  else
    case floatToIntMaybe x of
      Nothing => Nothing
      Just n => Just (natFromInt n)

-- | 是否 NaN（NaN 不等于自身）。
export isNaN : Float -> Bool
isNaN x = x /= x

-- | 是否 ±inf。
export isInfinite : Float -> Bool
isInfinite x = abs x == 1.0 / 0.0

-- | 是否有限（非 NaN、非 ±inf）。
export isFinite : Float -> Bool
isFinite x = not (isNaN x) && not (isInfinite x)

-- ---------------------------------------------------------------
-- 取整（全部不引入新原语：绝对值 ≥ 2^52 的 double 已经是整数）
-- ---------------------------------------------------------------
-- | 2^52：double 的 ulp 到 1，绝对值不小于它的浮点值已经是整数。
_integralLimit : Float
_integralLimit = 4503599627370496.0

-- | 负零没有字面量形式，用 `-1.0 * 0.0` 构造。
_negZero : Float
_negZero = (0.0 - 1.0) * 0.0

-- | 结果为零时保留输入符号：`trunc (-0.5)` 是 `-0.` 而不是 `0.`。
_keepZeroSign : Float -> Float -> Float
_keepZeroSign x y = if y == 0.0 && 1.0 / x < 0.0 then _negZero else y

-- | 截断到整数（向零），返回 `Float`；NaN / ±inf / 绝对值 ≥ 2^52 时原样返回。
export trunc : Float -> Float
trunc x =
  if x /= x then
    x
  else if abs x >= _integralLimit then x else _keepZeroSign x (intToFloat (floatToIntTrunc x))

-- | 向下取整，返回 `Float`；NaN / ±inf / 绝对值 ≥ 2^52 时原样返回。
export floor : Float -> Float
floor x =
  if x /= x then
    x
  else if abs x >= _integralLimit then
    x
  else
    let
      t = trunc x
    in _keepZeroSign x (if t > x then t - 1.0 else t)

-- | 向上取整，返回 `Float`；NaN / ±inf / 绝对值 ≥ 2^52 时原样返回。
export ceil : Float -> Float
ceil x =
  if x /= x then
    x
  else if abs x >= _integralLimit then
    x
  else
    let
      t = trunc x
    in _keepZeroSign x (if t < x then t + 1.0 else t)

-- | 四舍五入到整数（`.5` 远离零），返回 `Float`；NaN / ±inf / 绝对值 ≥ 2^52 时原样返回。
export round : Float -> Float
round x =
  if x /= x then
    x
  else if abs x >= _integralLimit then
    x
  else
    let
      t = trunc x
      d = x - t
    in _keepZeroSign x (if d >= 0.5 then t + 1.0 else if d <= 0.0 - 0.5 then t - 1.0 else t)

-- | `floor` 后转 `Int`；不可表示 → `Nothing`。
export floorToInt : Float -> Maybe Int
floorToInt x = floatToIntMaybe (floor x)

-- | `ceil` 后转 `Int`；不可表示 → `Nothing`。
export ceilToInt : Float -> Maybe Int
ceilToInt x = floatToIntMaybe (ceil x)

-- | `round` 后转 `Int`；不可表示 → `Nothing`。
export roundToInt : Float -> Maybe Int
roundToInt x = floatToIntMaybe (round x)

-- ---------------------------------------------------------------
-- 展示（`%.12g`）
-- ---------------------------------------------------------------
-- 只用 Float / Int 运算与 String 拼接；`Show Float` 与 `main : Float` 入口在三个后端共用这一份代码。
-- | 内部：规格化的单步——`m >= 10` 时除以 10、`m < 1` 时乘以 10，指数同步 ±1；第一个参数是 `Pair 指数 尾数`。
normStep : (Int, Float) -> Int -> (Int, Float)
normStep p _ =
  let
    e = firstOf p
    m = secondOf p
  in if m >= 10.0 then (e + 1, m / 10.0) else if m < 1.0 then (e - 1, m * 10.0) else p

-- | 内部：取尾数的整数位作为一个数字，把余数乘 10 交给下一位；状态是 `Pair 尾数 已取数字`。
digStep : (Float, List Int) -> Int -> (Float, List Int)
digStep p _ =
  let
    m = firstOf p
    ds = secondOf p
    d = floatToIntTrunc m
  in ((m - intToFloat d) * 10.0, append ds [d])

-- | 内部：逆序数字串上的进位；`Nothing` 表示溢出（`9.99… → 10.00…`）。
carryRev : List Int -> Maybe (List Int)
carryRev [] = Nothing
carryRev (d :: rest) =
  if d == 9 then
    case carryRev rest of
      Nothing => Nothing
      Just r => Just (0 :: r)
  else
    Just (d + 1 :: rest)

-- | 内部：去掉逆序数字串的前导零。
trimZerosRev : List Int -> List Int
trimZerosRev [] = []
trimZerosRev (d :: rest) = if d == 0 then trimZerosRev rest else d :: rest

-- | 内部：去掉正序数字串尾部的零；全零时保留单个 `0`。
trimZeros : List Int -> List Int
trimZeros ds =
  case reverse (trimZerosRev (reverse ds)) of
    [] => [0]
    r => r

-- | 内部：数字串长度。
dsLen : List Int -> Int
dsLen [] = 0
dsLen (_ :: rest) = 1 + dsLen rest

-- | 内部：把每个数字转成字符并拼接（仅用于 0..9）。
digitsText : List Int -> String
digitsText ds = foldl (\acc => \d => acc ++ strFromInt d) "" ds

-- | 内部：`n` 个 `0` 的文本；`n <= 0` 时为空。
zerosText : Int -> String
zerosText n = digitsText (map (\_ => 0) (range 0 n))

-- | 内部：科学计数法的指数后缀（`e+05` / `e-05`，指数至少两位）。
expSuffix : Int -> String
expSuffix e =
  let
    n = if e < 0 then 0 - e else e
    sign = if e < 0 then "-" else "+"
  in sign ++ (if n < 10 then "0" ++ strFromInt n else strFromInt n)

-- | 内部：科学计数法正文 `d.ddde±xx`（只有一位整数位；空数字串退化为 `0e+00`）。
expForm : Int -> List Int -> String
expForm e (d :: rest) =
  case rest of
    [] => strFromInt d ++ "e" ++ expSuffix e
    _ => strFromInt d ++ "." ++ digitsText rest ++ "e" ++ expSuffix e
expForm e [] = "0e+00"

-- | 内部：定点正文（按指数决定小数点位置，缺位补零、多余位截断；负指数时整数部分为 `0`）。
fixedForm : Int -> List Int -> String
fixedForm e ds =
  if e >= 0 then
    let
      intLen = e + 1
      len = dsLen ds
    in if len <= intLen then digitsText ds ++ zerosText (intLen - len) ++ "." else digitsText (take intLen ds) ++ "." ++ digitsText (drop intLen ds)
  else
    "0." ++ zerosText (0 - e - 1) ++ digitsText ds

-- | `Float` 的规范展示文本：与 `%.12g` 对齐（12 位有效数字，指数 `e < -4` 或 `e >= 12` 时用科学计数法）；`nan` / `inf` / `-inf` / `-0.` 特判。
export floatRender : Float -> String
floatRender x =
  if x /= x then
    "nan"
  else
    let
      inf = 1.0 / 0.0
    in if x == inf then
      "inf"
    else if x == 0.0 - inf then
      "-inf"
    else if x == 0.0 then
      if 1.0 / x < 0.0 then "-0." else "0."
    else
      let
        neg = x < 0.0
        a = if neg then 0.0 - x else x
        p = foldl (\q => \i => normStep q i) (0, a) (range 0 700)
        e0 = firstOf p
        m0 = secondOf p
        dp = foldl (\q => \i => digStep q i) (m0, []) (range 0 12)
        d13 = floatToIntTrunc (firstOf dp)
        raw = secondOf dp
        ed =
          if d13 >= 5 then
            case carryRev (reverse raw) of
              Just r => (e0, trimZeros (reverse r))
              Nothing => (e0 + 1, trimZeros (1 :: map (\_ => 0) (range 0 11)))
          else
            (e0, trimZeros raw)
        e = firstOf ed
        ds = secondOf ed
        body = if e < 0 - 4 || e >= 12 then expForm e ds else fixedForm e ds
      in if neg then "-" ++ body else body
