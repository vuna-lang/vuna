-- | 字符串工具。长度以 UTF-8 字节计（`Nat`）；底层只使用字符串原语（`strUnpack` / `strPack` / `strLength` / `strConcatMany` / `strSubstring` / `++`，以及 `Hashable` 用的 `strHash`）与 [Base.Data.List]。`split` 用显式 fuel 计步（上界 `2*len(text)+len(sep)+2`），使 `splitAcc` / `skipSep` 的互递归满足终止性检查；空分隔符退化为逐字符切分。`Eq` / `Ord` / `Hashable` / `Semigroup` / `Monoid` 实例落在本模块。
module Base.Data.String where

import Base.Data.List
import Base.Data.Bool
-- `String` 是 primitive 类型，Eq / Ord 实例跟类型模块走（落点规则见 Base/Eq.vuna）。
import Base.Trait.Eq
import Base.Trait.Hashable
import Base.Trait.Ord
-- `+` / `-` / `*` / `/` 的 fixity 在 Base.Internal.Operator；本模块的算术运算符需要它进入闭包。
import Base.Data.Int
import Base.Data.Nat
-- 模板字符串降级引用 Base.Trait.Interp.interp（split 依赖需要显式 import）。
import Base.Trait.Interp
import Base.Trait.Monoid
import Base.Trait.Num
import Base.Internal.Operator

-- | UTF-8 字节长度（度量是 `Nat`；底层 `strLength` 仍是 Int 原语）。
export byteLength : String -> Nat
byteLength s = natFromInt (strLength s)

-- | 按分隔符切分，分隔符本身不保留；空分隔符退化为逐字符切分。用显式 fuel 计步（`2*len(text)+len(sep)+2`）让终止性可证。
export split : String -> String -> List String
split sep text =
  if strLength sep == 0 then
    map (\c => strPack [c]) (strUnpack text)
  else
    splitAcc (strUnpack sep) (strUnpack text) (2 * strLength text + strLength sep + 2) [] []

-- | 内部：`split` 的扫描循环——每次消费一个字符，命中分隔符时交给 `skipSep`；`fuel` 每步减一保证终止。
splitAcc : List Int -> List Int -> Int -> List Int -> List String -> List String
splitAcc sep [] fuel acc parts = reverse (strPack (reverse acc) :: parts)
splitAcc sep (chars@(c :: rest)) fuel acc parts =
  if fuel <= 0 then
    reverse (strPack (reverse acc) :: parts)
  else if _startsWithChars sep chars then
    skipSep sep chars (fuel - 1) (length sep) [] (strPack (reverse acc) :: parts)
  else
    splitAcc sep rest (fuel - 1) (c :: acc) parts

-- | 内部：`split` 命中分隔符后逐个跳过 `n` 个字符，然后回到 `splitAcc`。
skipSep : List Int -> List Int -> Int -> Int -> List Int -> List String -> List String
skipSep sep [] fuel n acc parts = reverse (strPack (reverse acc) :: parts)
skipSep sep (chars@(c :: rest)) fuel n acc parts =
  if fuel <= 0 then
    reverse (strPack (reverse acc) :: parts)
  else if n <= 0 then
    splitAcc sep chars (fuel - 1) acc parts
  else
    skipSep sep rest (fuel - 1) (n - 1) acc parts

-- | 用 `sep` 连接字符串列表（一次 `strConcatMany` 单遍分配，避免逐段拼接的 O(n²) 拷贝）。
export join : String -> List String -> String
join sep xs = strConcatMany (_interleave sep xs)

-- | 内部：把 `sep` 插到相邻元素之间，结果交给一次 `strConcatMany`。
_interleave : String -> List String -> List String
_interleave sep [] = []
_interleave sep [x] = [x]
_interleave sep (x :: rest) = x :: sep :: _interleave sep rest

-- | 按 `\n` 切分成行；与 `split` 一致，末尾换行会产生一个空串尾元素。
export lines : String -> List String
lines s = split "\n" s

-- | 每行补 `\n` 后拼接（`lines` 的逆操作，空列表得到空串）。
export unlines : List String -> String
unlines [] = ""
unlines xs = strConcatMany (map (\x => "${x}\n") xs)

-- | 去掉左侧空白（空格 / `\t` / `\n` / `\r`）。
export trimLeft : String -> String
trimLeft s = strPack (_dropSpace (strUnpack s))

-- | 去掉右侧空白。
export trimRight : String -> String
trimRight s = strPack (reverse (_dropSpace (reverse (strUnpack s))))

-- | 去掉两端空白。
export trim : String -> String
trim s = trimLeft (trimRight s)

-- | `text` 是否包含子串 `needle`。
export contains : String -> String -> Bool
contains needle text = _containsChars (strUnpack needle) (strUnpack text)

-- | `text` 是否以 `prefix` 开头（逐字节比较，不经 `List Int`）。
export startsWith : String -> String -> Bool
startsWith prefix text =
  let
    lp = strLength prefix
  in if lp > strLength text then False else sameBytes 0 prefix text 0 lp lp

-- | `text` 是否以 `suffix` 结尾。
export endsWith : String -> String -> Bool
endsWith suffix text =
  let
    ls = strLength suffix
    ltLen = strLength text
  in if ls > ltLen then False else sameBytes (ltLen - ls) suffix text 0 ls ls

-- | 从 `off` 起比较 `pat[0..n)` 与 `text[off..off+n)`；`fuel` 只用于终止性检查。
sameBytes : Int -> String -> String -> Int -> Int -> Int -> Bool
sameBytes off pat text i n fuel =
  if fuel <= 0 then
    True
  else if i >= n then
    True
  else if strAt pat i == strAt text (off + i) then
    sameBytes off pat text (i + 1) n (fuel - 1)
  else
    False

-- | 把 `s` 重复 `n` 次（一次 `strConcatMany`，避免 O(n²) 拷贝）。
export repeat : Nat -> String -> String
repeat n s = strConcatMany (map (\_ => s) (range 0 (natToInt n)))

-- | 取子串 `(start, len)`；越界由 `strSubstring` 原语 clamp，不走 List 桥接。
export substring : Nat -> Nat -> String -> String
substring start len s = strSubstring (natToInt start) (natToInt len) s

-- | 内部：空格 / `\t` / `\n` / `\r` 的字节判定。
_isSpace : Int -> Bool
_isSpace c = c == 32 || c == 9 || c == 10 || c == 13

-- | 内部：去掉字符列表左侧的空白。
_dropSpace : List Int -> List Int
_dropSpace [] = []
_dropSpace (c :: rest) = if _isSpace c then _dropSpace rest else c :: rest

-- | 内部：字符列表版本的前缀判定。
_startsWithChars : List Int -> List Int -> Bool
_startsWithChars [] text = True
_startsWithChars (p :: prest) text =
  case text of
    [] => False
    t :: trest => p == t && _startsWithChars prest trest

-- | 内部：字符列表版本的子串判定（逐位置试前缀）。
_containsChars : List Int -> List Int -> Bool
_containsChars needle text =
  if _startsWithChars needle text then
    True
  else
    case text of
      [] => False
      c :: rest => _containsChars needle rest

-- primitive 没有构造子：实例体写内建运算符，由编译器特化，不会自递归。
instance Eq String where
  (==) x y = x == y
  (/=) x y = x /= y

instance Ord String where
  (<) x y = x < y
  (<=) x y = x <= y
  (>) x y = x > y
  (>=) x y = x >= y

-- 哈希：String 用 `hashStr`（intrinsic `strHash` 的 0..1023 公式）。
instance Hashable String where
  hash s = hashStr s

instance Semigroup String where
  mappend x y = x ++ y

instance Monoid String where
  mempty = ""
