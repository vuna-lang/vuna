-- | 字符串工具。长度以 UTF-8 字节计（`Nat`）；底层只使用字符串原语（`strAt` / `strLength` / `strSubstring` / `strConcatMany` / `++`，以及 `Hashable` 用的 `strHash`）与 [Base.Data.List]。`split` / `trim` / `contains` / `parseInt` / `parseNat` 都按**字节索引**扫描，不建 `List Int` 中间链（`strUnpack` / `strPack` 只留给真正需要字节列表的调用方）；`split` 用显式 fuel 计步（上界 `2*len(text)+len(sep)+2`）满足终止性检查，空分隔符退化为逐字节切分。`Eq` / `Ord` / `Hashable` / `Semigroup` / `Monoid` 实例落在本模块。
module Base.Data.String where

import Base.Data.List
import Base.Data.Bool
import Base.Data.Maybe
-- `String` 是 primitive 类型，Eq / Ord 实例跟类型模块走（落点规则见 Base/Eq.vuna）。
import Base.Trait.Eq
import Base.Trait.Hashable
import Base.Trait.Ord
-- `+` / `-` / `*` / `/` 的 fixity 在 Base.Internal.Operator；本模块的算术运算符需要它进入闭包。
import Base.Data.Int
import Base.Data.Nat
-- 模板字符串降级引用 Base.Trait.Interp.interp（split 依赖需要显式 import）。
import Base.Trait.Interp
import Base.Trait.Monoid
import Base.Trait.Num
import Base.Internal.Operator

-- | UTF-8 字节长度（度量是 `Nat`；底层 `strLength` 仍是 Int 原语）。
export byteLength : String -> Nat
byteLength s = natFromInt (strLength s)

-- | 按分隔符切分，分隔符本身不保留；空分隔符退化为逐字节切分。用显式 fuel 计步
-- （`2*len(text)+len(sep)+2`）让扫描循环满足终止性检查；按索引扫描，不经过 `List Int`。
export split : String -> String -> List String
split sep text =
  let
    lt = strLength text
    ls = strLength sep
  in if ls == 0 then
    splitChars text 0 lt (2 * lt + 2) []
  else
    splitSep sep text 0 0 lt ls (2 * lt + ls + 2) []

-- | 内部：空分隔符的逐字节切分。
splitChars : String -> Int -> Int -> Int -> List String -> List String
splitChars s i n fuel acc =
  if fuel <= 0 then
    reverse acc
  else if i >= n then reverse acc else splitChars s (i + 1) n (fuel - 1) (strSubstring i 1 s :: acc)

-- | 内部：`split` 的扫描循环。`start` 是当前段起点，`i` 是扫描位置；命中分隔符时
-- 收下当前段并跳到分隔符之后。
splitSep : String -> String -> Int -> Int -> Int -> Int -> Int -> List String -> List String
splitSep sep text start i n ls fuel acc =
  if fuel <= 0 then
    reverse (strSubstring start (n - start) text :: acc)
  else if i >= n then
    reverse (strSubstring start (n - start) text :: acc)
  else if _sepAt sep text i n ls then
    splitSep sep text (i + ls) (i + ls) n ls (fuel - 1) (strSubstring start (i - start) text :: acc)
  else
    splitSep sep text start (i + 1) n ls (fuel - 1) acc

-- | 内部：`text` 从 `i` 起是否匹配整个分隔符。
_sepAt : String -> String -> Int -> Int -> Int -> Bool
_sepAt sep text i n ls = i + ls <= n && sameBytes i sep text 0 ls ls

-- | 用 `sep` 连接字符串列表（一次 `strConcatMany` 单遍分配，避免逐段拼接的 O(n²) 拷贝）。
export join : String -> List String -> String
join sep xs = strConcatMany (_interleave sep xs)

-- | 内部：把 `sep` 插到相邻元素之间，结果交给一次 `strConcatMany`。
_interleave : String -> List String -> List String
_interleave sep [] = []
_interleave sep [x] = [x]
_interleave sep (x :: rest) = x :: sep :: _interleave sep rest

-- | 按 `\n` 切分成行；与 `split` 一致，末尾换行会产生一个空串尾元素。
export lines : String -> List String
lines s = split "\n" s

-- | 每行补 `\n` 后拼接（`lines` 的逆操作，空列表得到空串）。
export unlines : List String -> String
unlines [] = ""
unlines xs = strConcatMany (map (\x => "${x}\n") xs)

-- | 去掉左侧空白（空格 / `\t` / `\n` / `\r`）。
export trimLeft : String -> String
trimLeft s = trimLeftGo s 0 (strLength s) (strLength s + 1)

-- | 内部：从左端起找到第一个非空白字节。
trimLeftGo : String -> Int -> Int -> Int -> String
trimLeftGo s i n fuel =
  if fuel <= 0 then
    strSubstring i (n - i) s
  else if i >= n then
    strSubstring i (n - i) s
  else if _isSpace (strAt s i) then trimLeftGo s (i + 1) n (fuel - 1) else strSubstring i (n - i) s

-- | 去掉右侧空白。
export trimRight : String -> String
trimRight s = trimRightGo s (strLength s - 1) (strLength s + 1)

-- | 内部：从右端起找到最后一个非空白字节。
trimRightGo : String -> Int -> Int -> String
trimRightGo s i fuel =
  if fuel <= 0 then
    strSubstring 0 (i + 1) s
  else if i < 0 then
    strSubstring 0 (i + 1) s
  else if _isSpace (strAt s i) then trimRightGo s (i - 1) (fuel - 1) else strSubstring 0 (i + 1) s

-- | 去掉两端空白。
export trim : String -> String
trim s = trimLeft (trimRight s)

-- | `text` 是否包含子串 `needle`（按索引逐位置试前缀，不经过 `List Int`）。
export contains : String -> String -> Bool
contains needle text =
  let
    ln = strLength needle
    lt = strLength text
  in _containsAt needle text 0 ln lt (lt + 1)

-- | 内部：从 `i` 起逐位置试匹配；`fuel` 只用于终止性检查。
_containsAt : String -> String -> Int -> Int -> Int -> Int -> Bool
_containsAt needle text i ln lt fuel =
  if fuel <= 0 then
    False
  else if i + ln > lt then
    False
  else if sameBytes i needle text 0 ln ln then
    True
  else
    _containsAt needle text (i + 1) ln lt (fuel - 1)

-- | `text` 是否以 `prefix` 开头（逐字节比较，不经 `List Int`）。
export startsWith : String -> String -> Bool
startsWith prefix text =
  let
    lp = strLength prefix
  in if lp > strLength text then False else sameBytes 0 prefix text 0 lp lp

-- | `text` 是否以 `suffix` 结尾。
export endsWith : String -> String -> Bool
endsWith suffix text =
  let
    ls = strLength suffix
    ltLen = strLength text
  in if ls > ltLen then False else sameBytes (ltLen - ls) suffix text 0 ls ls

-- | 从 `off` 起比较 `pat[0..n)` 与 `text[off..off+n)`；`fuel` 只用于终止性检查。
sameBytes : Int -> String -> String -> Int -> Int -> Int -> Bool
sameBytes off pat text i n fuel =
  if fuel <= 0 then
    True
  else if i >= n then
    True
  else if strAt pat i == strAt text (off + i) then
    sameBytes off pat text (i + 1) n (fuel - 1)
  else
    False

-- | 把 `s` 重复 `n` 次：按二进制倍增拼接，只做 O(log n) 次拼接（不建长度 n 的列表）。
export repeat : Nat -> String -> String
repeat n s =
  let
    k = natToInt n
  in if k <= 0 then "" else repeatGo k s "" (k + 1)

-- | 内部：`block` 是 `s` 的 2^i 次重复；`k` 的每个二进制位决定是否并入 `acc`。
repeatGo : Int -> String -> String -> Int -> String
repeatGo k block acc fuel =
  if fuel <= 0 then
    acc
  else if k <= 0 then
    acc
  else if k - k / 2 * 2 == 1 then
    repeatGo (k / 2) (block ++ block) (block ++ acc) (fuel - 1)
  else
    repeatGo (k / 2) (block ++ block) acc (fuel - 1)

-- | 取子串 `(start, len)`；越界由 `strSubstring` 原语 clamp，不走 List 桥接。
export substring : Nat -> Nat -> String -> String
substring start len s = strSubstring (natToInt start) (natToInt len) s

-- | 十进制非负整数解析：只接受 `[+]?[0-9]+`；空串、负号、非数字、溢出 → `Nothing`。
export parseNat : String -> Maybe Nat
parseNat s =
  let
    n = strLength s
  in if n == 0 then
    Nothing
  else if strAt s 0 == 43 then
    if n == 1 then Nothing else _natDigits s 1 n (n + 1)
  else
    _natDigits s 0 n (n + 1)

-- | 内部：非负数字串（索引扫描）→ `Nat`；空数字段、非数字或溢出给 `Nothing`。
_natDigits : String -> Int -> Int -> Int -> Maybe Nat
_natDigits s i n fuel =
  if fuel <= 0 then
    Nothing
  else if i >= n then
    Nothing
  else
    case _digitsToInt s i n 0 (n - i + 1) of
      Nothing => Nothing
      Just v => Just (natFromInt v)

-- | 十进制整数解析：只接受 `[+-]?[0-9]+`；空串、非数字、溢出 → `Nothing`。
export parseInt : String -> Maybe Int
parseInt s =
  let
    n = strLength s
  in if n == 0 then
    Nothing
  else
    let
      c = strAt s 0
    in case c of
      45 => if n == 1 then Nothing else _digitsToNegInt s 1 n 0 (n + 1)
      43 => if n == 1 then Nothing else _digitsToInt s 1 n 0 (n + 1)
      _ => _digitsToInt s 0 n 0 (n + 1)

-- | `parseInt` 的默认值版：解析失败给 `d`。
export parseIntOr : Int -> String -> Int
parseIntOr d s =
  case parseInt s of
    Nothing => d
    Just n => n

-- | 内部：`min_int`（没有 `-2^62` 的字面量，用减法构造）。
_minInt : Int
_minInt = 0 - 4611686018427387903 - 1

-- | 内部：逐位累加非负十进制数；超过 max_int 或遇到非数字给 `Nothing`。
_digitsToInt : String -> Int -> Int -> Int -> Int -> Maybe Int
_digitsToInt s i n acc fuel =
  if fuel <= 0 then
    Nothing
  else if i >= n then
    Just acc
  else
    let
      c = strAt s i
    in if c < 48 || c > 57 then
      Nothing
    else
      let
        d = c - 48
      in if acc > (4611686018427387903 - d) / 10 then Nothing else _digitsToInt s (i + 1) n (acc * 10 + d) (fuel - 1)

-- | 内部：逐位累加负数（`acc` 保持负号）；低于 min_int 或遇到非数字给 `Nothing`。
_digitsToNegInt : String -> Int -> Int -> Int -> Int -> Maybe Int
_digitsToNegInt s i n acc fuel =
  if fuel <= 0 then
    Nothing
  else if i >= n then
    Just acc
  else
    let
      c = strAt s i
    in if c < 48 || c > 57 then
      Nothing
    else
      let
        d = c - 48
      in if acc < (_minInt + d) / 10 then Nothing else _digitsToNegInt s (i + 1) n (acc * 10 - d) (fuel - 1)

-- | 内部：空格 / `\t` / `\n` / `\r` 的字节判定。
_isSpace : Int -> Bool
_isSpace c = c == 32 || c == 9 || c == 10 || c == 13

-- primitive 没有构造子：实例体写内建运算符，由编译器特化，不会自递归。
instance Eq String where
  (==) x y = x == y
  (/=) x y = x /= y

instance Ord String where
  (<) x y = x < y
  (<=) x y = x <= y
  (>) x y = x > y
  (>=) x y = x >= y

-- 哈希：String 用 `hashStr`（intrinsic `strHash` 的 0..1023 公式）。
instance Hashable String where
  hash s = hashStr s

instance Semigroup String where
  mappend x y = x ++ y

instance Monoid String where
  mempty = ""
