-- | 二元组类型与投影函数。按「实例跟类型模块走」的落点规则承载 `Show` / `Eq` / `Ord` / `Hashable` 实例，因此依赖 [Base.Trait.Show] / [Base.Trait.Eq] / [Base.Trait.Ord] / [Base.Trait.Hashable]；`Bool` 构造子与 `&&` / `||` 的 fixity 来自 [Base.Data.Bool]。
module Base.Data.Pair where

import Base.Data.Bool
import Base.Trait.Eq
import Base.Trait.Hashable
import Base.Trait.Ord
import Base.Trait.Show

-- | 二元组 `Pair a b`；构造子与字段 `first` / `second` 都导出，可直接模式匹配取分量。`Eq` / `Ord` 逐分量比较，`Ord` 是字典序（先比 `first`，相等再比 `second`）。
export record Pair a b(..) where
  -- | 第一个分量。
  first : a
  -- | 第二个分量。
  second : b

-- | 取第一个分量。
export firstOf : (a, b) -> a
firstOf (a, b) = a

-- | 取第二个分量。
export secondOf : (a, b) -> b
secondOf (a, b) = b

-- 容器 `Show` 实例；`Interp` 经 blanket `Show a => Interp a` 自动获得。
-- 拼接用 `++` 的反引号形式：`Pair` 不能 import `Base.Data.List`（List → Pair 已存在），
-- 而 `++` 是恒可见的 String intrinsic。
instance Show a, Show b => Show (a, b) where
  show p =
    case p of
      (x, y) => "(" `++` show x `++` ", " `++` show y `++` ")"

-- 逐分量比较；`Ord` 是字典序（先比第一个分量，相等再比第二个）。
instance Eq a, Eq b => Eq (a, b) where
  (==) (a1, b1) (a2, b2) = a1 == a2 && b1 == b2
  (/=) p q = if p == q then False else True

instance Ord a, Ord b => Ord (a, b) where
  (<) (a1, b1) (a2, b2) = if a1 < a2 then True else if a2 < a1 then False else b1 < b2
  (<=) p q = p < q || not (q < p)
  (>) p q = q < p
  (>=) p q = q <= p

instance Hashable a, Hashable b => Hashable (a, b) where
  hash p =
    case p of
      (a, b) => hashCombine (hash a) (hash b)
