-- | 单元素类型（「无有意义返回值」的惯用类型）。只有 `MkUnit` 一个构造子；用于 `Eff [] Unit` 风格的动作结果占位。`Eq` / `Ord` / `Show` / `Hashable` / `Monoid` 实例都是穷尽、零分配的（只模式匹配一个构造子）。
module Base.Data.Unit where

import Base.Data.Bool
import Base.Trait.Eq
import Base.Trait.Hashable
import Base.Trait.Monoid
import Base.Trait.Ord
import Base.Trait.Show

-- | 单元素类型：唯一的值是 `MkUnit`，所有 `Unit` 值相等、顺序上互不小于对方，常作「无有意义返回值」的占位。
export data Unit(..) : Type where
  -- | 唯一的值。
  MkUnit : Unit

instance Eq Unit where
  (==) MkUnit MkUnit = True
  (/=) MkUnit MkUnit = False

instance Ord Unit where
  (<) _ _ = False
  (<=) _ _ = True
  (>) _ _ = False
  (>=) _ _ = True

instance Show Unit where
  show MkUnit = "MkUnit"

instance Hashable Unit where
  hash MkUnit = 0

instance Semigroup Unit where
  mappend MkUnit MkUnit = MkUnit

instance Monoid Unit where
  mempty = MkUnit
