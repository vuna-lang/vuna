-- | 函数组合子与低优先级应用：`id` / `const` / `flip` / `compose`，以及 `$`（右结合应用）
-- 与 `|>`（正向管道）。运算符只是普通名字：fixity 声明在 [Base.Internal.Operator]。
module Base.Data.Function where

import Base.Internal.Operator

-- | 恒等函数。
export id : a -> a
id x = x

-- | 常函数：忽略第二个参数。
export const : a -> b -> a
const x _ = x

-- | 交换二元函数的前两个参数。
export flip : (a -> b -> c) -> b -> a -> c
flip f x y = f y x

-- | 函数组合：`compose f g x` ≡ `f (g x)`。
export compose : (b -> c) -> (a -> b) -> a -> c
compose f g x = f (g x)

-- | 低优先级应用：`f $ x` ≡ `f x`（`infixr 0`，省掉尾部括号）。
export ($) : (a -> b) -> a -> b
($) f x = f x

-- | 正向管道：`x |> f` ≡ `f x`（`infixl 1`，从左到右读）。
export (|>) : a -> (a -> b) -> b
(|>) x f = f x
