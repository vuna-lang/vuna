-- | 成功/失败结果类型与组合子。构造子 `Ok` / `Err` 导出；`Err` 携带 `String` 错误消息。组合统一用 `fmap` / `bind` / `pure` / `do`，不提供 `andThen` / `mapResult` 这类重复入口。本模块刻意不提供 `Ord` 实例：成功与失败之间没有有意义的顺序（与 [Base.Data.Maybe] 不同）。[Base.Data.Result.step] 额外依赖 [Base.Data.Pair]（它同时解构 `Pair`，不是 `bind` 的别名）；容器的 `Show` 实例依赖 [Base.Trait.Show]，`Err` 的相等依赖 `Eq String`。
module Base.Data.Result where

import Base.Data.Bool
import Base.Trait.Eq
import Base.Trait.Hashable
import Base.Data.List
import Base.Trait.Foldable
import Base.Trait.Monad
import Base.Trait.Traversable
import Base.Data.Pair
-- 容器 `Show` 实例（`Interp` 由 Base.Trait.Interp 的 blanket 实例免费获得）。
import Base.Trait.Show
-- `Err` 的相等要比 String：`Eq String` 实例在类型模块 Base.Data.String（不能反向 import）。
import Base.Data.String

-- | 成功 `Ok x` 或失败 `Err message`；构造子导出，可直接模式匹配。
export data Result a(..) : Type where
  -- | 成功。
  Ok : a -> Result a
  -- | 失败（错误消息）。
  Err : String -> Result a

instance Functor Result where
  fmap f (Ok x) = Ok (f x)
  fmap f (Err e) = Err e

instance Monad Result where
  (>>=) (Ok x) k = k x
  (>>=) (Err e) k = Err e

instance Applicative Result where
  pure = Ok
  ap mf mx =
    case mf of
      Ok g =>
        case mx of
          Ok b => Ok (g b)
          Err e => Err e
      Err e => Err e
  liftA2 f (Ok x) (Ok y) = Ok (f x y)
  liftA2 f (Err e) _ = Err e
  liftA2 f _ (Err e) = Err e

-- | 对列表逐项执行 `Result` 计算；遇到第一个 `Err` 立即返回。
export traverse : (a -> Result b) -> List a -> Result (List b)
traverse f [] = Ok []
traverse f (x :: xs) =
  case f x of
    Err e => Err e
    Ok y =>
      case traverse f xs of
        Err e => Err e
        Ok ys => Ok (y :: ys)

-- `do` 的 pattern 只支持变量/通配，因此不能写成 `bind` 别名。
-- | 处理 `Result (Pair a b)` 的双参数绑定（常用作状态传递）：解构 `Pair`，把两个分量一起交给 `k`，`Err` 直接短路。
export step : Result (a, b) -> (a -> b -> Result c) -> Result c
step (Ok (x, st)) k = k x st
step (Err e) k = Err e

-- | 映射错误消息。
export mapError : (String -> String) -> Result a -> Result a
mapError f (Ok x) = Ok x
mapError f (Err e) = Err (f e)

-- | 成功取值，失败返回默认值。
export withDefault : a -> Result a -> a
withDefault d (Ok x) = x
withDefault d (Err e) = d

-- 容器 `Show` 实例；`Interp` 经 blanket `Show a => Interp a` 自动获得。
-- `Err` 的消息按 `Show String` 加引号转义（`Err "bad"`）；拼接用 `++` intrinsic。
instance Show a => Show (Result a) where
  show r =
    case r of
      Ok x => "Ok " `++` show x
      Err e => "Err " `++` show e

-- 同构造子比 payload：`Ok` 用 `Eq a`，`Err` 用 `Eq String`。
instance Eq a => Eq (Result a) where
  (==) (Ok x) (Ok y) = x == y
  (==) (Err x) (Err y) = x == y
  (==) _ _ = False
  (/=) r s = if r == s then False else True

instance Hashable a => Hashable (Result a) where
  hash r =
    case r of
      Ok x => hashCombine 1 (hash x)
      Err e => hashCombine 2 (hashStr e)

instance Foldable Result where
  fold f z r =
    case r of
      Ok x => f x z
      Err _ => z

instance Applicative f => Traversable Result f where
  mapM fun r =
    case r of
      Ok x => liftA2 (\y, _ => Ok y) (fun x) (pure x)
      Err e => pure (Err e)
