-- | 可变引用：内建类型构造子 `IORef`，OCaml 表示 `'a ref`。
--
-- 本地可变存储位于 `Eff []` 内（后台机制，**不是**行效应）：操作都只是对宿主原语的 `raise`（`modifyRef` 由 `readRef` + `writeRef` 组合），对任意行都可行，因此既能用在纯 `Eff []`，也能出现在 `Eff r` 动作里而不必给调用方加 `RefOp` 约束。
module Base.Effect.Pure.IORef where

import Base.Effect.Types
import Base.Trait.Monad

-- | 创建初值为 `x` 的新引用。
export newRef : {r : Row} -> a -> Eff r (IORef a)
newRef x = raise (@vuna@prim_eff_newRef x)

-- | 读取引用当前值。
export readRef : {r : Row} -> IORef a -> Eff r a
readRef r = raise (@vuna@prim_eff_readRef r)

-- | 写入新值，返回底层原语的 `Int` 结果（写入本身无有意义的返回值，通常忽略）。
export writeRef : {r : Row} -> IORef a -> a -> Eff r Int
writeRef r v = raise (@vuna@prim_eff_writeRef r v)

-- | 读-改-写一次完成：读到当前值、应用 `f` 后写回，返回写入原语的 `Int` 结果。
export modifyRef : {r : Row} -> IORef a -> (a -> a) -> Eff r Int
modifyRef r f = do
  x <- readRef r
  writeRef r (f x)
