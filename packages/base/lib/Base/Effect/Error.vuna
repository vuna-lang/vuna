-- | 一阶 Error 效应 + 作用域 catch：`catch n comp fallback` 在 comp 内安装临时 Error handler，`Throw` 截获后不恢复续延（一次性续延直接丢弃），返回 `Result` 给外层，再在 handler 之外执行 `fallback`。
module Base.Effect.Error where

import Base.Effect.Core
import Base.Trait.Monad
import Base.Data.Result

-- | error 操作只有 `Throw`，携带错误消息 `String`。
export data ErrorOp(..) : Type -> Type where
  -- | 抛出错误消息。
  Throw : {a : Type} -> String -> ErrorOp a

-- | 通过命名实例抛出错误；返回类型任意（直接丢弃续延，不恢复）。
export throw : Member n ErrorOp r => String -> Eff r a
throw msg = sendCore (Named n ErrorOp) "error" n (Throw msg)

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `ErrorOp`。
export handleError : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> (a -> b) -> ((i : Type) -> (o : ErrorOp i) -> (Base.Effect.Core.resIdx i o -> b) -> b) -> Eff r a -> Eff (rowRem (Named n ErrorOp) r) b
handleError n ret opH comp = handleCore (Named n ErrorOp) "error" n ret opH comp

-- | 内部：默认 `ret`——成功值包装成 `Ok`。
errorRet : {a : Type} -> a -> Result a
errorRet a = Ok a

-- | 内部：默认 `opH`——`Throw s` 直接变成 `Err s`（不恢复续延）。
errorOpH : {a : Type} -> (i : Type) -> (o : ErrorOp i) -> (Base.Effect.Core.resIdx i o -> Result a) -> Result a
errorOpH i op k = case op of
  Throw s => Err s

-- | 内部：`catch` 的续段——`Ok a` 原样返回，`Err s` 交给 fallback。
catchResult : (n : String) -> {a : Type} -> {r : Row} -> (String -> Eff (Named n ErrorOp :: r) a) -> Result a -> Eff (Named n ErrorOp :: r) a
catchResult n fallback res = case res of
  Ok a => pure a
  Err s => fallback s

-- | 把 `ErrorOp` 收成 `Result`：`Ok a` / `Err msg`；结果行删除 `ErrorOp`。
export runError : (n : String) -> {a : Type} -> {r : Row} -> Eff (Named n ErrorOp :: r) a -> Eff r (Result a)
runError n comp = handleCoreAt (Named n ErrorOp) "error" n errorRet errorOpH comp

-- | 作用域 catch：在 `comp` 内安装临时 handler；Throw 截获后丢弃续延、在 handler 之外执行 `fallback`，成功时原样返回。
export catch : (n : String) -> {a : Type} -> {r : Row} -> Eff (Named n ErrorOp :: r) a -> (String -> Eff (Named n ErrorOp :: r) a) -> Eff (Named n ErrorOp :: r) a
catch n comp fallback = do
  res <- weaken (handleError n errorRet errorOpH comp)
  catchResult n fallback res
