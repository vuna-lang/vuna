-- | 定长原地可变数组：行条目 `Named n (MutArrayOp a)` 是唯一的语言级表示。
--
-- 长度在引入时确定（`withMutArray` 的容量），读写都是原地操作：`set` 写穿到同一块存储，
-- 不返回新数组。元素类型 `a` 是行条目的一部分，因此同一个作用域里不同元素类型的数组
-- 是不同的行条目（`Member` 证明按元素类型区分）。
--
-- 用户面的 `get` / `set` / `size` / `withMutArray` 是**声明**（没有运行时实现）：精化器在
-- 编译期把实例名绑定到作用域里的数组，并把调用改写成下面 `marr*` 入口。
-- `get@name` / `set@name` 用实例名覆盖消歧；省略名字时取作用域里唯一的同族数组。
module Base.Effect.MutArray where

import Base.Effect.Core
import Base.Effect.Types
import Base.Trait.Monad
import Base.Data.Unit
import Base.Data.Nat

-- | 数组操作：`Get` 的结果是元素类型 `a`，`Set` 无有意义返回值（`Unit`），
-- `Size` 返回容量（定长数组的长度）。
export data MutArrayOp(..) : Type -> Type -> Type where
  -- | 按下标读元素；越界是宿主 trap（与 `arrayGet` 一致）。
  Get : {a : Type} -> Nat -> MutArrayOp a a
  -- | 按下标原地写元素；越界是宿主 trap（与 `arrayGet` 一致）。
  Set : {a : Type} -> Nat -> a -> MutArrayOp a Unit
  -- | 数组长度（引入时给定的容量）。
  Size : {a : Type} -> MutArrayOp a Nat

-- | 读作用域里的数组 `n` 的第 `i` 个元素。
export axiom get : {n : String} -> {a : Type} -> {r : Row} -> {w : Member (Named n (MutArrayOp a)) r} -> Nat -> Eff r a

-- | 原地写作用域里的数组 `n` 的第 `i` 个元素；结果 `Unit`。
export axiom set : {n : String} -> {a : Type} -> {r : Row} -> {w : Member (Named n (MutArrayOp a)) r} -> Nat -> a -> Eff r Unit

-- | 数组 `n` 的长度（容量）。
export axiom size : {n : String} -> {a : Type} -> {r : Row} -> {w : Member (Named n (MutArrayOp a)) r} -> Eff r Nat

-- | 引入一个长度 `cap`、元素全为 `init` 的数组：body 结束后条目消失、内容丢弃。
export axiom withMutArray : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> Nat -> a -> Eff (Named n (MutArrayOp a) :: r) b -> Eff r b

-- | 纯端点：body 只剩这一个条目，执行完丢弃数组。
export axiom withMutArrayPure : {a : Type} -> {b : Type} -> (n : String) -> Nat -> a -> Eff [Named n (MutArrayOp a)] b -> b

-- | 内部入口：精化器把 `get` 改写成它（数组由编译期绑定给出）。
-- 行约束仍然保留：闭包把数组捕获进更窄的行（例如 `Eff []`）时类型检查会拒绝。
export marrGetOp : {n : String} -> {a : Type} -> {r : Row} -> {w : Member (Named n (MutArrayOp a)) r} -> (@vuna@MArray a) -> Nat -> Eff r a
marrGetOp a i = raise (@vuna@prim_marrGet a (natToInt i))

-- | 内部入口：精化器把 `set` 改写成它。
export marrSetOp : {n : String} -> {a : Type} -> {r : Row} -> {w : Member (Named n (MutArrayOp a)) r} -> (@vuna@MArray a) -> Nat -> a -> Eff r Unit
marrSetOp a i v =
  do
    _ <- raise (@vuna@prim_marrSet a (natToInt i) v)
    pure MkUnit

-- | 内部入口：精化器把 `size` 改写成它。
export marrLenOp : {n : String} -> {a : Type} -> {r : Row} -> {w : Member (Named n (MutArrayOp a)) r} -> (@vuna@MArray a) -> Eff r Nat
marrLenOp a = pure (natFromInt (@vuna@prim_marrLen a))

-- | 内部入口：精化器把 `withMutArray` 改写成它；body 拿到编译期绑定的数组。
-- 结果行保留被引入的条目，由精化器用 `dropEffHead` 收掉（运行时恒等）。
export marrWith : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> Nat -> a -> ((@vuna@MArray a) -> Eff (Named n (MutArrayOp a) :: r) b) -> Eff (Named n (MutArrayOp a) :: r) b
marrWith n cap init body = body (@vuna@prim_marrNew (natToInt cap) init)

-- | 内部入口：`withMutArrayPure` 的降级目标（结果行由精化器收口）。
export marrWithPure : {a : Type} -> {b : Type} -> (n : String) -> Nat -> a -> ((@vuna@MArray a) -> Eff [Named n (MutArrayOp a)] b) -> Eff [Named n (MutArrayOp a)] b
marrWithPure n cap init body = body (@vuna@prim_marrNew (natToInt cap) init)
