-- | 一阶 console 效应：行标签 = `ConsoleOp`，实例名在行的 `Named n ConsoleOp :: r` 条目里，操作只有 `Print` / `EPrint`。
--
-- 同一程序里可以同时安装多个 console handler（例如 "mock" = 收集器、"real" = 真实
-- stdout/stderr），行里按实例名区分。真实 handler 直调 `@vuna@prim_eff_print` /
-- `@vuna@prim_eff_eprint`；`runConsoleHost` 是 entry 预装用的已展平宿主 handler。
module Base.Effect.Console where

import Base.Effect.Core
import Base.Data.Nat
import Base.Trait.Monad

-- | console 操作：`Print` / `EPrint` 各带一个 `String`，结果类型是构造子索引。
export data ConsoleOp(..) : Type -> Type where
  -- | 写 stdout（结果：写入字节数 `Nat`）。
  Print : String -> ConsoleOp Nat
  -- | 写 stderr（结果：仍返回 `Int`，`@vuna@prim_eff_eprint` 未做 Nat 归一化）。
  EPrint : String -> ConsoleOp Int

-- | 通过命名实例 `n` 发送 `Print`；返回写入字节数（`Nat`）。行里需要 `Member (Named n ConsoleOp) r` 证明（由精化器按行结构构造）。
export consolePrint : Member n ConsoleOp r => String -> Eff r Nat
consolePrint s = sendCore (Named n ConsoleOp) "console" n (Print s)

-- | 通过命名实例 `n` 发送 `EPrint`（stderr）；其余同 `consolePrint`。
export consoleEprint : Member n ConsoleOp r => String -> Eff r Int
consoleEprint s = sendCore (Named n ConsoleOp) "console" n (EPrint s)

-- | 一阶 handler：`ret` 处理正常返回、`opH` 解释每个操作，结果行删除 `Console n`。`(key, name)` 与对应的 send 匹配。
export handleConsole : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member (Named n ConsoleOp) r} -> (a -> b) -> ((i : Type) -> (o : ConsoleOp i) -> (Base.Effect.Core.resIdx i o -> b) -> b) -> Eff r a -> Eff (rowRem (Named n ConsoleOp) r) b
handleConsole n ret opH comp = handleCore (Named n ConsoleOp) "console" n ret opH comp

-- | 真实 handler 的操作解释：在续延前执行 `@vuna@prim_eff_print` / `@vuna@prim_eff_eprint`（answer 是 `Eff []` 动作；`Print` 的结果在边界转回 `Nat`）。
consoleOpHIO : {a : Type} -> (i : Type) -> (o : ConsoleOp i) -> (Base.Effect.Core.resIdx i o -> Eff [] a) -> Eff [] a
consoleOpHIO i op k =
  case op of
    Print s =>
      do
        r <- fmap natFromInt (@vuna@prim_eff_print s)
        k r
    EPrint s =>
      do
        r <- @vuna@prim_eff_eprint s
        k r

-- ---------------------------------------------------------------
-- 带行的真实 handler（entry 自动预装用；不导出，用户拿不到）
-- ---------------------------------------------------------------
-- | entry 的 op 解释：宿主原语同步执行，answer 是裸值。
consoleOpHIOHost : {a : Type} -> (i : Type) -> (o : ConsoleOp i) -> (Base.Effect.Core.resIdx i o -> a) -> a
consoleOpHIOHost i op k =
  case op of
    Print s => k (natFromInt (runPure (@vuna@host@print s)))
    EPrint s => k (runPure (@vuna@prim_eff_eprint s))

-- | entry 宿主 handler：删掉 ConsoleOp 标签，结果是裸值。
handleConsoleHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Named n ConsoleOp :: r) a -> Eff r a
handleConsoleHostHost n comp =
  handleCoreAt (Named n ConsoleOp) "console" n (\a => a) consoleOpHIOHost comp

-- | entry 自动预装用：把行头 ConsoleOp 的 send 翻译成宿主 intrinsic，并把该标签删掉。
runConsoleHost : {r : Row} -> {a : Type} -> Eff (Named "default" ConsoleOp :: r) a -> Eff r a
runConsoleHost comp = handleConsoleHostHost "default" comp
