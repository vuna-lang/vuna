-- | 类型层定长的原地可变向量：行条目 `Named name (MutVecOp n a)` 是唯一的语言级表示。
--
-- 长度 `n` 在类型层锁定（与 `Vec n a` 一致），下标是 `Fin n`：越界在编译期不可能，
-- 运行时没有边界检查。存储是定长数组，`set` 写穿同一块存储，不返回新向量。
--
-- 用户面的 `get` / `set` / `size` / `withMutVec` 是**声明**（没有运行时实现）：精化器在
-- 编译期把实例名绑定到作用域里的向量，并把调用改写成下面 `mvec*` 入口。
-- `get@name` / `set@name` 用实例名覆盖消歧；省略名字时取作用域里唯一的同族向量。
--
-- 长度索引是 Rig0（运行时擦除），所以引入时的运行时长度来自种子 `Vec n a` 的构造子
-- 结构（`vecToList`），不额外要求调用方重复传长度。
module Base.Effect.MutVec where

import Base.Effect.Core
import Base.Effect.Types
import Base.Trait.Monad
import Base.Data.Unit
import Base.Data.Nat
import Base.Data.Fin
import Base.Data.Vec

-- | 向量操作：`Get` 的结果是元素类型 `a`，`Set` 无有意义返回值（`Unit`），
-- `Size` 返回长度（= 类型索引 `n` 的运行时读数）。
export data MutVecOp(..) : Nat -> Type -> Type -> Type where
  -- | 按 `Fin n` 读元素；越界在类型层不可能。
  Get : {n : Nat} -> {a : Type} -> Fin n -> MutVecOp n a a
  -- | 按 `Fin n` 原地写元素。
  Set : {n : Nat} -> {a : Type} -> Fin n -> a -> MutVecOp n a Unit
  -- | 向量长度（类型索引 `n`，运行时从存储读出）。
  Size : {n : Nat} -> {a : Type} -> MutVecOp n a Nat

-- | 读作用域里的向量 `name` 的第 `i` 个元素。
export axiom get : {name : String} -> {n : Nat} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutVecOp n a)) r} -> Fin n -> Eff r a

-- | 原地写作用域里的向量 `name` 的第 `i` 个元素；结果 `Unit`。
export axiom set : {name : String} -> {n : Nat} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutVecOp n a)) r} -> Fin n -> a -> Eff r Unit

-- | 向量 `name` 的长度。
export axiom size : {name : String} -> {n : Nat} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutVecOp n a)) r} -> Eff r Nat

-- | 引入一个内容来自种子 `Vec n a` 的向量：body 结束后条目消失、内容丢弃。
export axiom withMutVec : {n : Nat} -> {a : Type} -> {b : Type} -> {r : Row} -> (name : String) -> Vec n a -> Eff (Named name (MutVecOp n a) :: r) b -> Eff r b

-- | 纯端点：body 只剩这一个条目，执行完丢弃向量。
export axiom withMutVecPure : {n : Nat} -> {a : Type} -> {b : Type} -> (name : String) -> Vec n a -> Eff [Named name (MutVecOp n a)] b -> b

-- | 内部入口：精化器把 `get` 改写成它（向量由编译期绑定给出）。
-- 行约束仍然保留：闭包把向量捕获进更窄的行（例如 `Eff []`）时类型检查会拒绝。
export mvecGetOp : {name : String} -> {n : Nat} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutVecOp n a)) r} -> (@vuna@MArray a) -> Fin n -> Eff r a
mvecGetOp arr i = raise (@vuna@prim_marrGet arr (natToInt (finToNat i)))

-- | 内部入口：精化器把 `set` 改写成它。
export mvecSetOp : {name : String} -> {n : Nat} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutVecOp n a)) r} -> (@vuna@MArray a) -> Fin n -> a -> Eff r Unit
mvecSetOp arr i v =
  do
    _ <- raise (@vuna@prim_marrSet arr (natToInt (finToNat i)) v)
    pure MkUnit

-- | 内部入口：精化器把 `size` 改写成它。
export mvecLenOp : {name : String} -> {n : Nat} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutVecOp n a)) r} -> (@vuna@MArray a) -> Eff r Nat
mvecLenOp arr = pure (natFromInt (@vuna@prim_marrLen arr))

-- | 内部入口：精化器把 `withMutVec` 改写成它；body 拿到编译期绑定的向量。
-- 结果行保留被引入的条目，由精化器用 `dropEffHead` 收掉（运行时恒等）。
export mvecWith : {n : Nat} -> {a : Type} -> {b : Type} -> {r : Row} -> (name : String) -> Vec n a -> ((@vuna@MArray a) -> Eff (Named name (MutVecOp n a) :: r) b) -> Eff (Named name (MutVecOp n a) :: r) b
mvecWith name seed body = body (@vuna@prim_marrFromList (vecToList seed))

-- | 内部入口：`withMutVecPure` 的降级目标（结果行由精化器收口）。
export mvecWithPure : {n : Nat} -> {a : Type} -> {b : Type} -> (name : String) -> Vec n a -> ((@vuna@MArray a) -> Eff [Named name (MutVecOp n a)] b) -> Eff [Named name (MutVecOp n a)] b
mvecWithPure name seed body = body (@vuna@prim_marrFromList (vecToList seed))
