-- | 高阶 / 作用域 Error：行标签 = `ExnOp`（以结果类型为最后索引），操作 `ThrowExn` 与 `Try`。
--
-- `Try` 携带一个 `Scoped a` 一等子计算；handler 用 `handleScoped` 在同一 handler 下
-- 重新运行它，实现 scoped handler——其余效应仍由外层运行时 handler 处理。
module Base.Effect.Exn where

import Base.Effect.Core
import Base.Trait.Monad
import Base.Data.Result

-- | exn 操作：`ThrowExn msg`（结果索引任意，不恢复续延）与 `Try sub`（结果 `Result a`）。
export data ExnOp(..) : Type -> Type where
  -- | 抛出错误消息。
  ThrowExn : {a : Type} -> String -> ExnOp a
  -- | 在同一 exn handler 下运行子计算 `sub`，返回 `Result a`。
  Try : {a : Type} -> Scoped a -> ExnOp (Result a)

-- | 通过命名实例抛异常；返回类型任意（不恢复续延）。
export throwExn : (n : String) -> String -> {a : Type} -> {r : Row} -> Eff (Named n ExnOp :: r) a
throwExn n msg = sendCore (Named n ExnOp) "exn" n (ThrowExn msg)

-- | 把子计算 `comp` 包成 `Try` 操作交给 handler，返回 `Result a`（`Ok` 值 / `Err` 消息）。
export tryWith : (n : String) -> {a : Type} -> {r : Row} -> Eff (Named n ExnOp :: r) a -> Eff (Named n ExnOp :: r) (Result a)
tryWith n comp = sendCore (Named n ExnOp) "exn" n (Try (scope comp))

-- | 一阶 handler：`ret` / `opH` 由调用方给出；结果行删除 `ExnOp`。
export handleExn : (n : String) -> {a : Type} -> {b : Type} -> {r : Row} -> (a -> b) -> ((i : Type) -> (o : ExnOp i) -> (Base.Effect.Core.resIdx i o -> b) -> b) -> Eff (Named n ExnOp :: r) a -> Eff r b
handleExn n ret opH comp = handleCoreAt (Named n ExnOp) "exn" n ret opH comp

-- | 内部：handler 的操作解释——`ThrowExn` 变 `Err`；`Try` 用 `handleScoped` 在同一 handler 下运行子计算。
exnOpH : {a : Type} -> (i : Type) -> (o : ExnOp i) -> (Base.Effect.Core.resIdx i o -> Result a) -> Result a
exnOpH i op k =
  case op of
    ThrowExn s => Err s
    Try sub => k (handleScoped sub)

-- | 把 `ExnOp` 收成 `Result`；结果行删除 `ExnOp`。
export runExn : (n : String) -> {a : Type} -> {r : Row} -> Eff (Named n ExnOp :: r) a -> Eff r (Result a)
runExn n comp = handleExn n (\a => Ok a) exnOpH comp

-- | 作用域 catch：成功原样返回，`Err s` 交给 `fallback`（仍在该 exn handler 下继续）。
export catchExn : (n : String) -> {a : Type} -> {r : Row} -> Eff (Named n ExnOp :: r) a -> (String -> Eff (Named n ExnOp :: r) a) -> Eff (Named n ExnOp :: r) a
catchExn n comp fallback =
  do
    res <- tryWith n comp
    case res of
      Ok a => pure a
      Err s => fallback s

-- | exn 版 bracket：acquire → use → release；use 成功或抛异常都会 release，异常在 release 之后重新抛出。
export bracketExn : (n : String) -> {res : Type} -> {a : Type} -> {r : Row} -> Eff (Named n ExnOp :: r) res -> (res -> Eff (Named n ExnOp :: r) Int) -> (res -> Eff (Named n ExnOp :: r) a) -> Eff (Named n ExnOp :: r) a
bracketExn n acquire release use =
  do
    res <- acquire
    r <- tryWith n (use res)
    case r of
      Ok a =>
        do
          _ <- release res
          pure a
      Err s =>
        do
          _ <- release res
          throwExn n s
