-- | 显式记忆化的单值延迟：首次 `force` 求值并写入缓存，之后直接读缓存。
--
-- `lazy` 收的是**纯** thunk（`Unit -> a`），所以缓存对观察者等价于重算，只省时间与分配；
-- 需要缓存效应结果时先在 thunk 外面把动作跑完，再 memo 结果值。行带 `RefOp`：`Eff []`
-- 里的代码不能 `force`，缓存不是隐藏的可变状态。没有 blackholing：在某个 `Lazy` 自己的
-- thunk 里 `force` 它自己会一直转下去。
module Base.Effect.Lazy where

import Base.Effect.Core
import Base.Effect.Ref
import Base.Data.Maybe
import Base.Data.Unit
import Base.Trait.Monad

-- | 延迟求值的单元格：`IORef` 存缓存，`Unit -> a` 是未求值的 thunk。
export data Lazy a : Type where
  MkLazy : IORef (Maybe a) -> (Unit -> a) -> Lazy a

-- | 建立延迟值：此时不求值 thunk。
export lazy : (Unit -> a) -> Eff [RefOp] (Lazy a)
lazy th =
  do
    cell <- refNew Nothing
    pure (MkLazy cell th)

-- | 取缓存；没有就求值一次并写入。
export force : Lazy a -> Eff [RefOp] a
force (MkLazy cell th) = refRead cell >>= forceStep cell th

forceStep : IORef (Maybe a) -> (Unit -> a) -> Maybe a -> Eff [RefOp] a
forceStep _ _ (Just x) = pure x
forceStep cell th Nothing =
  do
    x <- pure (th MkUnit)
    _ <- refWrite cell (Just x)
    pure x
