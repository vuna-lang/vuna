-- | 一阶环境效应：标签 = `EnvOp`（实例名在行的 `Named n EnvOp :: r` 条目里），操作 `GetEnv` /
-- `GetCwd` / `ExecPath` / `RealPath` 都返回 `String`。
--
-- 真实 handler 直调对应原语：`@vuna@prim_eff_getenv` / `@vuna@prim_eff_getcwd` /
-- `@vuna@prim_eff_execPath` / `@vuna@prim_eff_realPath`。
module Base.Effect.Env where

import Base.Effect.Core
import Base.Effect.Host
import Base.Trait.Eq
import Base.Data.Maybe
import Base.Trait.Monad

-- | env 操作：`GetEnv` 带变量名、`GetCwd`、`ExecPath`、`RealPath`。
export data EnvOp(..) : Type -> Type where
  -- | 读环境变量（参数是变量名）。
  GetEnv : String -> EnvOp String
  -- | 读当前工作目录。
  GetCwd : EnvOp String
  -- | 读可执行文件路径。
  ExecPath : EnvOp String
  -- | 把路径解析成真实路径（逐段展开符号链接 + `..` 归约）。失败（不存在 / 无权限 /
  -- 链接成环）原样返回入参——需要「同一目录的两种写法落到同一个字符串」的调用方用它，
  -- 不需要自己判断路径是否存在。
  RealPath : String -> EnvOp String

-- | 通过命名实例取环境变量；真实 handler 走 `@vuna@prim_eff_getenv`（未设置或为空串都返回空串）。
export envGetEnv : Member n EnvOp r => String -> Eff r String
envGetEnv k = sendCore (Named n EnvOp) "env" n (GetEnv k)

-- | 取环境变量，未设置或为空串时给 `Nothing`：原语无法区分「未设置」与「空串」，
-- 需要「有值才算命中」的调用方（路径类）用这个，而不是比较空串。
export envGetEnvNonEmpty : Member n EnvOp r => String -> Eff r (Maybe String)
envGetEnvNonEmpty k =
  do
    v <- envGetEnv k
    pure (if v == "" then Nothing else Just v)

-- | 通过命名实例取当前工作目录。
export envGetCwd : Member n EnvOp r => Eff r String
envGetCwd = sendCore (Named n EnvOp) "env" n GetCwd

-- | 通过命名实例取可执行文件路径。
export envExecPath : Member n EnvOp r => Eff r String
envExecPath = sendCore (Named n EnvOp) "env" n ExecPath

-- | 通过命名实例把路径解析成真实路径：符号链接与 `..` 都展开（相对路径按 cwd 解析）。
-- 失败原样返回入参。
export envRealPath : Member n EnvOp r => String -> Eff r String
envRealPath path = sendCore (Named n EnvOp) "env" n (RealPath path)

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `EnvOp`。
export handleEnv : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member (Named n EnvOp) r} -> (a -> b) -> ((i : Type) -> (o : EnvOp i) -> (Base.Effect.Core.resIdx i o -> b) -> b) -> Eff r a -> Eff (rowRem (Named n EnvOp) r) b
handleEnv n ret opH comp = handleCore (Named n EnvOp) "env" n ret opH comp

-- ---------------------------------------------------------------
-- 带行 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
-- | 带 `EnvOp` 行的 op 解释：宿主原语取值后写穿继续（answer 行是宿主行 `[HostOp]`）。
envOpHIOHost : {a : Type} -> (i : Type) -> (o : EnvOp i) -> (Base.Effect.Core.resIdx i o -> Eff [HostOp] a) -> Eff [HostOp] a
envOpHIOHost i op k =
  case op of
    GetEnv name =>
      do
        v <- @vuna@host@getenv name
        k v
    GetCwd =>
      do
        v <- @vuna@host@getcwd
        k v
    ExecPath =>
      do
        v <- @vuna@host@execPath
        k v
    RealPath path =>
      do
        v <- @vuna@host@realPath path
        k v

-- | 带行的宿主 handler：删掉 `EnvOp`，answer 是 `Eff [HostOp]`（不导出）。
handleEnvHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Named n EnvOp :: r) a -> Eff r (Eff [HostOp] a)
handleEnvHostHost n comp = handleCoreAt (Named n EnvOp) "env" n (\a => pure a) envOpHIOHost comp

-- | entry 自动预装用（泛化 r）：把行头 `EnvOp` 的 send 翻译成宿主 intrinsic。
runEnvHost : {r : Row} -> {a : Type} -> Eff (Named "default" EnvOp :: r) a -> Eff (rowAppend r [HostOp]) a
runEnvHost comp = joinEff (handleEnvHostHost "default" comp)

-- | worker / 子计算用：安装默认实例的真实 handler，把宿主行收成 `Eff []`。
export runEnvEff : {a : Type} -> Eff [EnvOp] a -> Eff [] a
runEnvEff comp = hostSync (runEnvHost comp)
