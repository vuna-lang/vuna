-- | 一阶网络效应（命名实例，与 Fs / Console / Process 一致）：操作经 `sendCore` 派发，因此可以装 mock handler（内存表）或真实 handler；entry 会为 `main` 行里的 `NetOp` 自动预装真实 handler。
--
-- 真实 handler 用 `@vuna@host@tryNet*`：宿主失败时读宿主状态槽并抛 `NetErrorOp`（typed；
-- entry 收口的 `runNetErrorHost` 打印 `vuna: net: <上下文>: <原因>` 并 exit 1），想局部恢复
-- 的调用方用 `runNetError` 收成 `Result`。
--
-- 「对端关闭」不是错误：`netRecv` 返回 `Maybe String`，EOF 是 `Nothing`。句柄失效映射成
-- typed `NetBadHandle`（宿主状态码 8），由 `runNetError` / entry 收口处理。地址格式：
-- `tcp:HOST:PORT` 或 `unix:PATH`（解析见 `dtp_net_parse`）。
module Base.Effect.Net where

import Base.Effect.Core
import Base.Trait.Eq
import Base.Data.Maybe
import Base.Trait.Monad
import Base.Data.Nat
import Base.Data.Result
import Base.Data.String

-- | 网络操作描述：监听 / 取端口 / 接受 / 收 / 发 / 关 / 连接。
export data NetOp(..) : Type -> Type where
  -- | 绑定并监听地址 `addr`。
  Listen : String -> NetOp Int
  -- | 取监听句柄 `h` 的端口。
  Port : Int -> NetOp Int
  -- | 在监听句柄 `h` 上接受连接。
  Accept : Int -> NetOp Int
  -- | 从句柄 `h` 最多收 `n` 字节。
  Recv : Int -> Int -> NetOp (Maybe String)
  -- | 向句柄 `h` 发送整串 `s`。
  Send : Int -> String -> NetOp Int
  -- | 关闭句柄 `h`（幂等）。
  Close : Int -> NetOp Int
  -- | 连接地址 `addr`。
  Connect : String -> NetOp Int
  -- | 在句柄 `h` 上带超时 `micros`（微秒）接受连接。
  AcceptWithin : Int -> Int -> NetOp (NetStep Int)
  -- | 从句柄 `h` 最多收 `bytes` 字节，超时 `micros`（微秒）。
  RecvWithin : Int -> Int -> Int -> NetOp (NetStep String)
  -- | 向句柄 `h` 发送整串 `s`，超时 `micros`（微秒）。
  SendWithin : Int -> String -> Int -> NetOp (NetStep Int)

-- | 带超时的单步结果：正常完成 / 对端关闭 / 超时。
export data NetStep a(..) : Type where
  -- | 正常完成。
  StepOk : a -> NetStep a
  -- | 对端关闭（读 / 写）。
  StepClosed : NetStep a
  -- | 到超时为止没有进展。
  StepTimeout : NetStep a

-- | 绑定并监听地址，返回句柄。
export netListen : Member n NetOp r => String -> Eff r Int
netListen addr = do
  sendCore (Named n NetOp) "net" n (Listen addr)

-- | 取监听句柄的端口（`unix:` 地址给 0）。
export netPort : Member n NetOp r => Int -> Eff r Int
netPort h = do
  sendCore (Named n NetOp) "net" n (Port h)

-- | 接受连接，返回新句柄。
export netAccept : Member n NetOp r => Int -> Eff r Int
netAccept h = do
  sendCore (Named n NetOp) "net" n (Accept h)

-- | 最多接收 `n` 字节；对端关闭给 `Nothing`。
export netRecv : Member n NetOp r => Int -> Int -> Eff r (Maybe String)
netRecv h bytes = do
  sendCore (Named n NetOp) "net" n (Recv h bytes)

-- | 发送整个字符串，返回写入字节数。
export netSend : Member n NetOp r => Int -> String -> Eff r Int
netSend h s = do
  sendCore (Named n NetOp) "net" n (Send h s)

-- | 关闭句柄（幂等）。
export netClose : Member n NetOp r => Int -> Eff r Int
netClose h = do
  sendCore (Named n NetOp) "net" n (Close h)

-- | 连接地址，返回句柄。
export netConnect : Member n NetOp r => String -> Eff r Int
netConnect addr = do
  sendCore (Named n NetOp) "net" n (Connect addr)

-- | 带超时（微秒）接受连接：超时给 `StepTimeout`，不阻塞到对端出现。
export netAcceptWithin : Member n NetOp r => Int -> Int -> Eff r (NetStep Int)
netAcceptWithin h micros = do
  sendCore (Named n NetOp) "net" n (AcceptWithin h micros)

-- | 带超时接收：区分「读到数据 / 对端关闭 / 超时」。
export netRecvWithin : Member n NetOp r => Int -> Int -> Int -> Eff r (NetStep String)
netRecvWithin h bytes micros = do
  sendCore (Named n NetOp) "net" n (RecvWithin h bytes micros)

-- | 带超时发送整个字符串：超时给 `StepTimeout`（可能已写出前缀）。
export netSendWithin : Member n NetOp r => Int -> String -> Int -> Eff r (NetStep Int)
netSendWithin h s micros = do
  sendCore (Named n NetOp) "net" n (SendWithin h s micros)

-- | 宿主网络失败的种类：带上下文（地址或 `handle N`）。
export data NetError(..) : Type where
  -- | 对端拒绝连接。
  NetRefused : String -> NetError
  -- | 连接 / 读写超时。
  NetTimeout : String -> NetError
  -- | 连接被对端关闭（写已断的 socket）。
  NetClosed : String -> NetError
  -- | 地址已被占用（监听）。
  NetAddrInUse : String -> NetError
  -- | 地址格式非法。
  NetBadAddr : String -> NetError
  -- | 句柄失效（已关闭 / 伪造的句柄下标）。
  NetBadHandle : String -> NetError
  -- | 其它宿主网络错误。
  NetIo : String -> NetError

-- | 网络错误效应：单操作 `NetFail`（abort，不恢复续延）。
export data NetErrorOp(..) : Type -> Type where
  -- | 抛出网络失败。
  NetFail : {a : Type} -> NetError -> NetErrorOp a

-- | 抛出一个网络失败（由真实 handler 使用；想局部恢复的调用方 catch 它）。
export netFail : Member n NetErrorOp r => NetError -> Eff r a
netFail e = sendCore (Named n NetErrorOp) "net-error" n (NetFail e)

-- | 宿主状态码 → 失败种类（0 = 成功、1 = 对端关闭；码表见 `dtp_netStatus`）。
export netErrorOfCode : String -> Int -> NetError
netErrorOfCode ctx 2 = NetRefused ctx
netErrorOfCode ctx 3 = NetTimeout ctx
netErrorOfCode ctx 4 = NetClosed ctx
netErrorOfCode ctx 5 = NetAddrInUse ctx
netErrorOfCode ctx 6 = NetBadAddr ctx
netErrorOfCode ctx 7 = NetTimeout ctx
netErrorOfCode ctx 8 = NetBadHandle ctx
netErrorOfCode ctx _ = NetIo ctx

-- | 失败种类的人类可读文本（诊断输出用）。
export netErrorText : NetError -> String
netErrorText (NetRefused ctx) = "net: ${ctx}: connection refused"
netErrorText (NetTimeout ctx) = "net: ${ctx}: timed out"
netErrorText (NetClosed ctx) = "net: ${ctx}: connection closed"
netErrorText (NetAddrInUse ctx) = "net: ${ctx}: address already in use"
netErrorText (NetBadAddr ctx) = "net: ${ctx}: invalid address"
netErrorText (NetBadHandle ctx) = "net: ${ctx}: invalid handle (closed or unknown)"
netErrorText (NetIo ctx) = "net: ${ctx}: host I/O error"

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `NetOp`。
export handleNet : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member (Named n NetOp) r} -> (a -> b) -> ((i : Type) -> (o : NetOp i) -> (Base.Effect.Core.resIdx i o -> b) -> b) -> Eff r a -> Eff (rowRem (Named n NetOp) r) b
handleNet n ret opH comp = handleCore (Named n NetOp) "net" n ret opH comp

-- | 宿主状态槽（`@vuna@prim_eff_hostStatus`）：try 原语把失败码留在这里。
netHostStatus : {r : Row} -> Eff r Int
netHostStatus = raise @vuna@prim_eff_hostStatus

-- | 句柄类失败的上下文文本。
handleContext : Int -> String
handleContext h = "handle ${strFromInt h}"

-- | 带 `NetOp` 行的 op 解释：try 原语失败时读状态槽抛 typed error，答案行是 `[NetErrorOp]`。
netOpHIOHost : {a : Type} -> (i : Type) -> (o : NetOp i) -> (Base.Effect.Core.resIdx i o -> Eff [NetErrorOp@"net-error"] a) -> Eff [NetErrorOp@"net-error"] a
netOpHIOHost i op k = case op of
  Listen addr => do
    h <- raise (@vuna@host@tryNetListen addr)
    ok <- netHostStatus
    if ok /= 0 then netFail (netErrorOfCode "listen ${addr}" ok) else k h
  Port h => do
    p <- raise (@vuna@host@tryNetPort h)
    ok <- netHostStatus
    if ok /= 0 then netFail (netErrorOfCode "port ${handleContext h}" ok) else k p
  Accept h => do
    c <- raise (@vuna@host@tryNetAccept h)
    ok <- netHostStatus
    if ok /= 0 then netFail (netErrorOfCode "accept ${handleContext h}" ok) else k c
  Recv h n => do
    s <- raise (@vuna@host@tryNetRecv h n)
    ok <- netHostStatus
    if ok == 0 then k (Just s)
    else if ok == 1 then k Nothing else netFail (netErrorOfCode "recv ${handleContext h}" ok)
  Send h s => do
    n <- raise (@vuna@host@tryNetSend h s)
    ok <- netHostStatus
    if ok /= 0 then netFail (netErrorOfCode "send ${handleContext h}" ok) else k n
  Close h => do
    _ <- raise (@vuna@host@tryNetClose h)
    ok <- netHostStatus
    if ok /= 0 then netFail (netErrorOfCode "close ${handleContext h}" ok) else k 0
  Connect addr => do
    c <- raise (@vuna@host@tryNetConnect addr)
    ok <- netHostStatus
    if ok /= 0 then netFail (netErrorOfCode "connect ${addr}" ok) else k c
  AcceptWithin h micros => do
    c <- raise (@vuna@host@tryNetAcceptWithin h micros)
    ok <- netHostStatus
    if ok == 0 then k (StepOk c)
    else if ok == 7 then k StepTimeout else netFail (netErrorOfCode "acceptWithin ${handleContext h}" ok)
  RecvWithin h bytes micros => do
    s <- raise (@vuna@host@tryNetRecvWithin h bytes micros)
    ok <- netHostStatus
    if ok == 0 then k (StepOk s)
    else if ok == 1 then k StepClosed
    else if ok == 7 then k StepTimeout else netFail (netErrorOfCode "recvWithin ${handleContext h}" ok)
  SendWithin h s micros => do
    n <- raise (@vuna@host@tryNetSendWithin h s micros)
    ok <- netHostStatus
    if ok == 0 then k (StepOk n)
    else if ok == 7 then k StepTimeout else netFail (netErrorOfCode "sendWithin ${handleContext h}" ok)

-- | 带 `NetOp` 行的宿主 handler：删掉 `NetOp`，answer 是 `Eff [NetErrorOp]`（不导出）。
handleNetHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Named n NetOp :: r) a -> Eff r (Eff [NetErrorOp@"net-error"] a)
handleNetHostHost n comp = handleCoreAt (Named n NetOp) "net" n (\a => pure a) netOpHIOHost comp

-- | entry 自动预装用（泛化 r）：把行头 `NetOp` 的 send 翻译成宿主 intrinsic。
runNetHost : {r : Row} -> {a : Type} -> Eff (Named "default" NetOp :: r) a -> Eff (rowAppend r [NetErrorOp@"net-error"]) a
runNetHost comp = joinEff (handleNetHostHost "default" comp)

-- | 内部：`runNetError` 的成功侧 `ret`——值包装成 `Ok`。
netErrorRet : {a : Type} -> a -> Result a
netErrorRet a = Ok a

-- | 内部：`runNetError` 的 op 解释——`NetFail e` 直接变 `Err (netErrorText e)`（不恢复续延）。
netErrorOpHR : {a : Type} -> (i : Type) -> (o : NetErrorOp i) -> (Base.Effect.Core.resIdx i o -> Result a) -> Result a
netErrorOpHR i op _ = case op of
  NetFail e => Err (netErrorText e)

-- | 把网络失败折叠成 `Result`：`Ok a` / `Err` 携带渲染后的文本；结果行删除 `NetErrorOp`。
export runNetError : (n : String) -> {a : Type} -> {r : Row} -> Eff (Named n NetErrorOp :: r) a -> Eff r (Result a)
runNetError n comp = handleCoreAt (Named n NetErrorOp) "net-error" n netErrorRet netErrorOpHR comp

-- | entry 预装的失败收口：打印诊断并以退出码 1 结束（不导出）。
runNetErrorHost : {r : Row} -> {a : Type} -> Eff (Named "net-error" NetErrorOp :: r) a -> Eff r a
runNetErrorHost comp = do
  res <- runNetError "net-error" comp
  case res of
    Ok a => pure a
    Err msg => do
      _ <- raise (@vuna@prim_eff_eprint "vuna: ${msg}\n")
      _ <- raise (@vuna@prim_eff_exit 1)
      prim_fail "unreachable: net error handler"
