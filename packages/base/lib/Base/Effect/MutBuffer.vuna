-- | 变长字节缓冲：行条目 `Named n MutBufferOp` 是唯一的语言级表示。
--
-- 元素固定为字节，所以操作族没有元素类型参数；追加是原地操作（容量不够时按倍数增长），
-- `toString` 取一次快照（复制成新字符串，之后继续追加不影响已取出的串）。
--
-- 用户面的 `append` / `appendChar` / `length` / `clear` / `toString` / `withMutBuffer` 是
-- **声明**（没有运行时实现）：精化器在编译期把实例名绑定到作用域里的缓冲，并把调用改写成
-- 下面 `mbuf*` 入口。`append@name` 用实例名覆盖消歧；省略名字时取作用域里唯一的缓冲。
module Base.Effect.MutBuffer where

import Base.Effect.Core
import Base.Effect.Types
import Base.Trait.Monad
import Base.Data.Unit
import Base.Data.Nat
import Base.Data.Int

-- | 缓冲操作。`AppendChar` 的参数是字节值（`0..255`）。
export data MutBufferOp(..) : Type -> Type where
  -- | 追加一个字符串的字节。
  Append : String -> MutBufferOp Unit
  -- | 追加一个字节。
  AppendChar : Int -> MutBufferOp Unit
  -- | 当前字节数。
  Length : MutBufferOp Nat
  -- | 清空内容（容量保留）。
  Clear : MutBufferOp Unit
  -- | 取当前内容的快照字符串。
  ToString : MutBufferOp String

-- | 追加字符串 `s` 的字节。
export axiom append : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> String -> Eff r Unit

-- | 追加一个字节。
export axiom appendChar : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> Int -> Eff r Unit

-- | 当前字节数。
export axiom length : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> Eff r Nat

-- | 清空内容（容量保留）。
export axiom clear : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> Eff r Unit

-- | 取内容快照。
export axiom toString : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> Eff r String

-- | 引入一个空缓冲：body 结束后条目消失、内容丢弃。
export axiom withMutBuffer : {b : Type} -> {r : Row} -> (n : String) -> Eff (Named n MutBufferOp :: r) b -> Eff r b

-- | 纯端点：body 只剩这一个条目，执行完丢弃缓冲。
export axiom withMutBufferPure : {b : Type} -> (n : String) -> Eff [Named n MutBufferOp] b -> b

-- | 内部入口：精化器把 `append` 改写成它（缓冲由编译期绑定给出）。
-- 行约束仍然保留：闭包把缓冲捕获进更窄的行（例如 `Eff []`）时类型检查会拒绝。
export mbufAppendOp : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> (@vuna@MBuffer) -> String -> Eff r Unit
mbufAppendOp b s =
  do
    _ <- raise (@vuna@prim_mbufAppend b s)
    pure MkUnit

-- | 内部入口：精化器把 `appendChar` 改写成它。
export mbufAppendCharOp : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> (@vuna@MBuffer) -> Int -> Eff r Unit
mbufAppendCharOp b c =
  do
    _ <- raise (@vuna@prim_mbufAppendChar b c)
    pure MkUnit

-- | 内部入口：精化器把 `length` 改写成它。
export mbufLenOp : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> (@vuna@MBuffer) -> Eff r Nat
mbufLenOp b = pure (natFromInt (@vuna@prim_mbufLen b))

-- | 内部入口：精化器把 `clear` 改写成它。
export mbufClearOp : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> (@vuna@MBuffer) -> Eff r Unit
mbufClearOp b =
  do
    _ <- raise (@vuna@prim_mbufClear b)
    pure MkUnit

-- | 内部入口：精化器把 `toString` 改写成它。
export mbufToStringOp : {n : String} -> {r : Row} -> {w : Member (Named n MutBufferOp) r} -> (@vuna@MBuffer) -> Eff r String
mbufToStringOp b = pure (@vuna@prim_mbufToString b)

-- | 内部入口：精化器把 `withMutBuffer` 改写成它；body 拿到编译期绑定的缓冲。
-- 结果行保留被引入的条目，由精化器用 `dropEffHead` 收掉（运行时恒等）。
export mbufWith : {b : Type} -> {r : Row} -> (n : String) -> ((@vuna@MBuffer) -> Eff (Named n MutBufferOp :: r) b) -> Eff (Named n MutBufferOp :: r) b
mbufWith n body = body (@vuna@prim_mbufNew (natToInt 0))

-- | 内部入口：`withMutBufferPure` 的降级目标（结果行由精化器收口）。
export mbufWithPure : {b : Type} -> (n : String) -> ((@vuna@MBuffer) -> Eff [Named n MutBufferOp] b) -> Eff [Named n MutBufferOp] b
mbufWithPure n body = body (@vuna@prim_mbufNew (natToInt 0))
