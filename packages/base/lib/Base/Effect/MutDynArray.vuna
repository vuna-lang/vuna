-- | 可变长元素容器：行条目 `Named name (MutDynArrayOp a)` 是唯一的语言级表示。
--
-- 与 `MutArray` 的区别是长度在运行时（`Nat` 下标 + 越界 trap）：`push` 原地追加，
-- 容量不足时按倍数增长；`size` 是已用长度。元素类型在行条目里，`set`/`push` 与存储
-- 的元素类型绑定。
--
-- 用户面的 `get` / `set` / `push` / `size` / `clear` / `withMutDynArray` 是**声明**
-- （没有运行时实现）：精化器在编译期把实例名绑定到作用域里的容器，并把调用改写成
-- 下面 `dyn*` 入口。`push@name` 用实例名覆盖消歧；省略名字时取作用域里唯一的同族容器。
module Base.Effect.MutDynArray where

import Base.Effect.Core
import Base.Effect.Types
import Base.Trait.Monad
import Base.Data.Unit
import Base.Data.Nat

-- | 可变长数组操作：`Get` 的结果是元素类型 `a`，`Set`/`Push`/`Clear` 无有意义返回值
-- （`Unit`），`Size` 返回已用长度。
export data MutDynArrayOp(..) : Type -> Type -> Type where
  -- | 按下标读元素；越界是宿主 trap（与 `arrayGet` 一致）。
  Get : {a : Type} -> Nat -> MutDynArrayOp a a
  -- | 按下标原地写元素；越界是宿主 trap。
  Set : {a : Type} -> Nat -> a -> MutDynArrayOp a Unit
  -- | 在末尾原地追加元素（必要时增长容量）。
  Push : {a : Type} -> a -> MutDynArrayOp a Unit
  -- | 已用长度。
  Size : {a : Type} -> MutDynArrayOp a Nat
  -- | 清空内容（容量保留）。
  Clear : {a : Type} -> MutDynArrayOp a Unit

-- | 读作用域里的容器 `name` 的第 `i` 个元素。
export axiom get : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> Nat -> Eff r a

-- | 原地写作用域里的容器 `name` 的第 `i` 个元素；结果 `Unit`。
export axiom set : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> Nat -> a -> Eff r Unit

-- | 在容器末尾追加元素；结果 `Unit`。
export axiom push : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> a -> Eff r Unit

-- | 容器 `name` 的已用长度。
export axiom size : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> Eff r Nat

-- | 清空内容（容量保留）；结果 `Unit`。
export axiom clear : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> Eff r Unit

-- | 引入一个空容器：body 结束后条目消失、内容丢弃。
export axiom withMutDynArray : {a : Type} -> {b : Type} -> {r : Row} -> (name : String) -> Eff (Named name (MutDynArrayOp a) :: r) b -> Eff r b

-- | 纯端点：body 只剩这一个条目，执行完丢弃容器。
export axiom withMutDynArrayPure : {a : Type} -> {b : Type} -> (name : String) -> Eff [Named name (MutDynArrayOp a)] b -> b

-- | 内部入口：精化器把 `get` 改写成它（容器由编译期绑定给出）。
-- 行约束仍然保留：闭包把容器捕获进更窄的行（例如 `Eff []`）时类型检查会拒绝。
export dynGetOp : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> (@vuna@MDynArray a) -> Nat -> Eff r a
dynGetOp arr i = raise (@vuna@prim_dynGet arr (natToInt i))

-- | 内部入口：精化器把 `set` 改写成它。
export dynSetOp : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> (@vuna@MDynArray a) -> Nat -> a -> Eff r Unit
dynSetOp arr i v =
  do
    _ <- raise (@vuna@prim_dynSet arr (natToInt i) v)
    pure MkUnit

-- | 内部入口：精化器把 `push` 改写成它。
export dynPushOp : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> (@vuna@MDynArray a) -> a -> Eff r Unit
dynPushOp arr v =
  do
    _ <- raise (@vuna@prim_dynPush arr v)
    pure MkUnit

-- | 内部入口：精化器把 `size` 改写成它。
export dynLenOp : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> (@vuna@MDynArray a) -> Eff r Nat
dynLenOp arr = pure (natFromInt (@vuna@prim_dynLen arr))

-- | 内部入口：精化器把 `clear` 改写成它。
export dynClearOp : {name : String} -> {a : Type} -> {r : Row} -> {w : Member (Named name (MutDynArrayOp a)) r} -> (@vuna@MDynArray a) -> Eff r Unit
dynClearOp arr =
  do
    _ <- raise (@vuna@prim_dynClear arr)
    pure MkUnit

-- | 内部入口：精化器把 `withMutDynArray` 改写成它；body 拿到编译期绑定的容器。
-- 结果行保留被引入的条目，由精化器用 `dropEffHead` 收掉（运行时恒等）。
export dynWith : {a : Type} -> {b : Type} -> {r : Row} -> (name : String) -> ((@vuna@MDynArray a) -> Eff (Named name (MutDynArrayOp a) :: r) b) -> Eff (Named name (MutDynArrayOp a) :: r) b
dynWith name body = body (@vuna@prim_dynNew (natToInt 0))

-- | 内部入口：`withMutDynArrayPure` 的降级目标（结果行由精化器收口）。
export dynWithPure : {a : Type} -> {b : Type} -> (name : String) -> ((@vuna@MDynArray a) -> Eff [Named name (MutDynArrayOp a)] b) -> Eff [Named name (MutDynArrayOp a)] b
dynWithPure name body = body (@vuna@prim_dynNew (natToInt 0))
