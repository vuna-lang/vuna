-- | 键泛型、值泛型的持久哈希映射（1024 桶，两层 32 叉 `Array`）。键要求 `Eq` + `Hashable`：`hash` 归一化到 0..1023（负数与 `min_int` 都安全），相等的键必定落在同一桶。`Array.get` 是 O(1)；`insert` 的 `Array.set` 是 copy-on-write（每次 insert 复制两个 32 元素数组），返回新表。`insert` **即去重**：同键只保留最新值（桶内命中就替换），因此 `size` 由计数字段 O(1) 读取、`toList` 不必再去重；`remove` 从桶内摘除并减计数。`toList` 按桶序展开，**不保证插入序**。与 [Base.Container.Map] 的分工：Map 是 assoc list（小表、语义简单），HashMap 适合构造后频繁查找的大表。构造器不导出。
module Base.Container.HashMap where

-- base 模块不自动注入 Prelude，`==` / `<` / `/` 的方法名与实例需要显式 import。
import Base.Container.Array
import Base.Data.Bool
import Base.Trait.Eq
import Base.Trait.Hashable
import Base.Data.Int
import Base.Data.List
import Base.Data.Maybe
import Base.Data.Nat
import Base.Trait.Ord
import Base.Data.Pair
import Base.Trait.Show
import Base.Data.String
import Base.Trait.Num

-- | 键泛型的持久哈希映射：1024 桶（两层 32 叉 `Array`）结构；构造器不导出，只能经本模块 API 使用。
export record HashMap k v where
  -- | 桶数组（两层 32 叉）；空表用 `[||]` 表示，首次 `insert` 才分配 32×32 桶。
  hashMapBuckets : Array (Array (List (k, v)))
  -- | 键值对个数（`size` 的 O(1) 来源；`insert` 去重、`remove` 摘除时维护）。
  hashMapCount : Int

-- | 内部：哈希值归一化到 0..1023 桶号（负数补 1024，`min_int` 也安全）。
_bucketOf : Int -> Int
_bucketOf n =
  let
    m = n - n / 1024 * 1024
  in if m < 0 then m + 1024 else m

-- | 内部：桶内插入或替换；返回「是否新建键」（`True` 才增加计数）。
_bucketInsert : Eq k => k -> v -> List (k, v) -> (Bool, List (k, v))
_bucketInsert key v [] = (True, [(key, v)])
_bucketInsert key v ((k2, v2) :: rest) =
  if key == k2 then
    (False, (key, v) :: rest)
  else
    case _bucketInsert key v rest of
      (added, rest2) => (added, (k2, v2) :: rest2)

-- | 内部：桶内删除；返回「是否真的删掉了」。
_bucketRemove : Eq k => k -> List (k, v) -> (Bool, List (k, v))
_bucketRemove key [] = (False, [])
_bucketRemove key ((k2, v2) :: rest) =
  if key == k2 then
    (True, rest)
  else
    case _bucketRemove key rest of
      (removed, rest2) => (removed, (k2, v2) :: rest2)

-- | 内部：桶内线性查找第一个匹配键。
_lookupAssoc : Eq k => k -> List (k, v) -> Maybe v
_lookupAssoc key [] = Nothing
_lookupAssoc key ((k, v) :: rest) = if key == k then Just v else _lookupAssoc key rest

-- 空表用 `[||]`（non-expansive，可泛化）；`Array.make` 是函数应用，会触发弱类型变量。
-- | 插入键值；同键替换为最新值（桶内命中即替换）。`Array.set` 是 copy-on-write，返回新表。
export insert : Eq k, Hashable k => k -> v -> HashMap k v -> HashMap k v
insert key v (HashMap outers n) =
  let
    base =
      if Base.Container.Array.length outers == 0 then
        Base.Container.Array.make 32 (Base.Container.Array.make 32 [])
      else
        outers
    b = _bucketOf (hash key)
    qi = b / 32
    oi = natFromInt qi
    ii = natFromInt (b - qi * 32)
    outer = Base.Container.Array.get base oi
    inner = Base.Container.Array.get outer ii
  in case _bucketInsert key v inner of
    (added, inner2) =>
      HashMap
        (Base.Container.Array.set base oi (Base.Container.Array.set outer ii inner2))
        (if added then n + 1 else n)

-- | 删除键；键不存在时原样返回。计数只在实际删掉时减一。
export remove : Eq k, Hashable k => k -> HashMap k v -> HashMap k v
remove key (t@(HashMap outers n)) =
  if Base.Container.Array.length outers == 0 then
    t
  else
    let
      b = _bucketOf (hash key)
      qi = b / 32
      oi = natFromInt qi
      ii = natFromInt (b - qi * 32)
      outer = Base.Container.Array.get outers oi
      inner = Base.Container.Array.get outer ii
    in case _bucketRemove key inner of
      (False, _) => t
      (True, inner2) => HashMap (Base.Container.Array.set outers oi (Base.Container.Array.set outer ii inner2)) (n - 1)

-- | 按键查找，返回 `Maybe v`；桶内命中第一个匹配即返回（该键最新值）。
export lookup : Eq k, Hashable k => k -> HashMap k v -> Maybe v
lookup key (HashMap outers _) =
  if Base.Container.Array.length outers == 0 then
    Nothing
  else
    let
      b = _bucketOf (hash key)
      qi = b / 32
      oi = natFromInt qi
      ii = natFromInt (b - qi * 32)
    in _lookupAssoc key (Base.Container.Array.get (Base.Container.Array.get outers oi) ii)

-- | 键是否存在（`lookup` 后判 `Just`）。
export member : Eq k, Hashable k => k -> HashMap k v -> Bool
member key t =
  case lookup key t of
    Just _ => True
    Nothing => False

-- | 批量插入 `Pair` 列表：**后面的条目覆盖前面的**（与 `fromList` 的优先顺序相反）。
export insertAll : Eq k, Hashable k => List (k, v) -> HashMap k v -> HashMap k v
insertAll [] t = t
insertAll ((k, v) :: rest) t = insertAll rest (insert k v t)

-- | 从 `Pair` 列表构造：**前面的条目优先**（先递归 rest，再插头部），与 [Base.Container.HashMap.insertAll] 的「后者覆盖前者」相反。
export fromList : Eq k, Hashable k => List (k, v) -> HashMap k v
fromList [] = HashMap arrayEmpty 0
fromList ((k, v) :: rest) = insert k v (fromList rest)

-- | 名字集合的成员判定表：每个名字映射到 True。
export ofNames : List String -> HashMap String Bool
ofNames xs = insertAll (map (\n => (n, True)) xs) (fromList [])

-- | 按桶序展开所有键值对（同键只有一条）；**不保证插入序**。
export toList : HashMap k v -> List (k, v)
toList (HashMap outers _) =
  concatMap
    (\outer => concatMap (\inner => inner) (Base.Container.Array.toList outer))
    (Base.Container.Array.toList outers)

-- | 键的个数（`Nat`，计数字段 O(1)）。
export size : HashMap k v -> Nat
size (HashMap _ n) = natFromInt n

-- 经 `toList` 展示（构造器不导出；桶序展开，不保证插入序）。
instance Show k, Show v => Show (HashMap k v) where
  show m = "fromList " `++` show (toList m)
