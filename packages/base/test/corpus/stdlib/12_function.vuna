-- `$` / `|>` 与组合子：id / const / flip / compose。
inc : Int -> Int
inc x = x + 1

add : Int -> Int -> Int
add x y = x + y

ident : Int
ident = id 4

consted : Int
consted = const 7 9

composed : Int
composed = compose inc inc 1

dollar : Int
dollar = inc $ 1 + 1

pipe : Int
pipe = 1 + 1 |> inc

flipped : Int
flipped = flip add 1 2

main : String
main =
  show ident
    ++ "/"
    ++ show consted
    ++ "/" ++ show composed ++ "/" ++ show dollar ++ "/" ++ show pipe ++ "/" ++ show flipped
