-- stdlib：持久游标；takeC / foldC 都返回剩余游标，消费进度显式接住（没有内部 IORef）。
import Base.Effect.Core
import Base.Effect.Cursor as Cursor
import Base.Effect.Console as EffConsole
import Base.Trait.Monad
import Base.Data.List as List
import Base.Data.Pair

sumL : List Int -> Int
sumL xs = List.foldl (\acc, x => acc + x) 0 xs

main : Eff [ConsoleOp] Int
main =
  do
    p1 <- Cursor.takeC 2 (Cursor.ofList [1, 2, 3, 4])
    p2 <- Cursor.takeC 5 (secondOf p1)
    p3 <- Cursor.foldC 2 (\acc, x => acc + x) 0 (Cursor.ofList [10, 20, 30])
    _ <-
      consolePrint
        (strFromInt (sumL (firstOf p1)) ++ "/" ++ strFromInt (sumL (firstOf p2)) ++ "/" ++ strFromInt (firstOf p3) ++ "\n")
    pure (sumL (firstOf p1) + sumL (firstOf p2) + firstOf p3)
