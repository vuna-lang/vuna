-- stdlib：Functor 实例（Maybe / List）与 fmap。
import Base.Trait.Monad as Monad
import Base.Data.Maybe as Maybe
import Base.Data.List as List

showMaybe : Maybe Int -> String
showMaybe m = case m of
  Nothing => "Nothing"
  Just n => "Just " ++ strFromInt n

sum : List Int -> Int
sum [] = 0
sum (x :: xs) = x + sum xs

main : String
main =
  let
    m = fmap (\x => x + 1) (Just 41)
  in let
    xs = fmap (\x => x * 2) ((::) 1 ((::) 2 []))
  in showMaybe m ++ "/" ++ strFromInt (sum xs)
