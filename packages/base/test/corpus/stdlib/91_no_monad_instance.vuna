-- 反例：显式 `import Base.Trait.Monad` 只让 trait/方法可见，不提供实例。
-- `data Box a` 没有 `Monad` 实例 → do 的实例字典解不出来。
-- 负例断言的是「缺实例」：Prelude 恒注入，bind 可见性不构成错误面；
-- 同类覆盖由 monad/90、stdlib/92/93 共同承担。
import Base.Trait.Monad as Monad

data Box a : Type where
  MkBox : a -> Box a

main : Box Int
main = do
  x <- MkBox 1
  pure (x + 1)
