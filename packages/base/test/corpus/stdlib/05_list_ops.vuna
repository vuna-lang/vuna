-- stdlib：Base.Data.List 常用操作。
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.Maybe as Maybe

showBool : Bool -> String
showBool b = if b then "True" else "False"

showIntList : List Int -> String
showIntList [] = "[]"
showIntList (x :: xs) = "[" ++ strFromInt x ++ showIntTail xs

showIntTail : List Int -> String
showIntTail [] = "]"
showIntTail (x :: xs) = "," ++ strFromInt x ++ showIntTail xs

showStrList : List String -> String
showStrList [] = "[]"
showStrList (x :: xs) = "[" ++ x ++ showStrTail xs

showStrTail : List String -> String
showStrTail [] = "]"
showStrTail (x :: xs) = "," ++ x ++ showStrTail xs

showMaybeInt : Maybe Int -> String
showMaybeInt m = case m of
  Nothing => "Nothing"
  Just x => "Just " ++ strFromInt x

main : String
main =
  "a="
    ++ showIntList (append ((::) 1 ((::) 2 [])) ((::) 3 []))
    ++ " r="
    ++ showIntList (reverse ((::) 1 ((::) 2 ((::) 3 []))))
    ++ " l="
    ++ strFromInt (length (range 2 6))
    ++ " m="
    ++ showIntList (map (\x => x * 3) (range 1 4))
    ++ " f="
    ++ showIntList (filter (\x => x > 2) (range 1 5))
    ++ " fl="
    ++ strFromInt (foldl (\a, b => a + b) 0 (range 1 5))
    ++ " fr="
    ++ strFromInt (foldr (\a, b => a - b) 0 ((::) 1 ((::) 2 ((::) 3 []))))
    ++ " cm="
    ++ showIntList (concatMap (\x => (::) x ((::) (x * 10) [])) ((::) 1 ((::) 2 [])))
    ++ " fm="
    ++ showIntList ((::) 1 ((::) 2 []) >>= (\x => (::) x ((::) (x + 100) [])))
    ++ " mem="
    ++ showBool (mem 3 (range 1 5))
    ++ " zip="
    ++ showStrList (map (\p => strFromInt (firstOf p) ++ secondOf p) (zip ((::) 1 ((::) 2 [])) ((::) "a" ((::) "b" []))))
    ++ " tk="
    ++ showIntList (take 2 (range 1 5))
    ++ " dp="
    ++ showIntList (drop 3 (range 1 5))
    ++ " mm="
    ++ showIntList (mapMaybe (\x => if x > 2 then Just (x * 2) else Nothing) (range 1 4))
    ++ " mn="
    ++ showBool (memName "b" ((::) "a" ((::) "b" [])))
    ++ " lp="
    ++ showMaybeInt (lookupPair "k" ((::) (Pair "k" 9) []))
