-- stdlib：显式记忆化；两次 force 同一 Lazy 拿同一个值，缓存行是 RefOp。
import Base.Effect.Core
import Base.Effect.Lazy as Lazy
import Base.Effect.Ref
import Base.Effect.Console as EffConsole
import Base.Trait.Monad

main : Eff [ConsoleOp, RefOp] Int
main =
  do
    l <- Lazy.lazy (\_ => 21 + 21)
    a <- Lazy.force l
    b <- Lazy.force l
    _ <- consolePrint (strFromInt a ++ "\n")
    pure (a + b)
