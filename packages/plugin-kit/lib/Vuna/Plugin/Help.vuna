-- | 帮助渲染：全部从调用方给的命令表派生（入口与插件共用）。
--
-- 三种形态：总览（按分组列出顶层命令）、分支帮助（列出直接子命令）、单命令帮助
-- （用法 + options + 补充说明）。`delegated` 命令的正文由调用方提供（插件里转发编译器
-- 用法文本），本模块不绑定任何具体实现。
module Vuna.Plugin.Help where

import Vuna.Plugin.Command
import Base.Data.List as List
import Base.Data.String as String
import Base.Data.Bool as Bool

-- | 总览帮助（`vuna help` / `vuna --help` / 无参数）。
--
-- 分节顺序固定（与命令表来自哪个插件无关）：命令表按插件拼接，顺序不保证分组连续，
-- 因此这里按分组过滤，而不是「按表顺序遇到新标题就换节」。
export renderOverview : List Cmd -> String
renderOverview cmds =
  "vuna — Vuna 编译器与工具链\n\nusage:\n  vuna <command> [options]\n  vuna dev <command> [options]\n"
    ++ renderGroupSections groupOrder cmds
    ++ "\n运行 `vuna help <command>` 或 `vuna <command> --help` 查看某条命令的完整用法。\n"

-- | 内部：总览的分节顺序。
groupOrder : List Group
groupOrder = [GCore, GInspect, GDeps, GService, GMeta, GDev]

-- | 内部：按固定分组逐个渲染（每组只列 `cmdInOverview` 的命令）。
renderGroupSections : List Group -> List Cmd -> String
renderGroupSections [] cmds = ""
renderGroupSections (g :: rest) cmds =
  let
    rows = filter (inGroup g) cmds
  in if emptyCmds rows then
    renderGroupSections rest cmds
  else
    "\n${groupTitle g}\n" ++ renderRows rows ++ renderGroupSections rest cmds

-- | 内部：命令是否属于该分组且进总览。
inGroup : Group -> Cmd -> Bool
inGroup g c = c.cmdInOverview && groupName c.cmdGroup == groupName g

-- | 内部：逐行渲染总览里的命令。
renderRows : List Cmd -> String
renderRows [] = ""
renderRows (c :: rest) = "${rowText c}${renderRows rest}"

-- | 总览里的顶层命令名（未知命令的候选建议用）。
export topLevelNamesOf : List Cmd -> List String
topLevelNamesOf cmds = nubNames (map headName (overviewCommands cmds))

-- | 帮助旗标之前的参数收敛成已登记的命令路径；`Nothing` = 没有帮助请求。
-- `[]` = 总览。`--` 之后不参与；`-h` / `--help` 优先。
export helpPathIn : Int -> List Cmd -> List String -> Maybe (List String)
helpPathIn depth cmds args =
  case beforeHelp (helpSurface args) of
    Nothing => Nothing
    Just tokens =>
      case matchCommandIn depth tokens cmds of
        Just (Pair c _) => Just c.cmdPath
        Nothing => Just []

-- | 某命令路径的帮助正文；`delegated` 决定 flag 正文由谁提供。
export helpForPathIn : List Cmd -> (Cmd -> String) -> List String -> Maybe String
helpForPathIn cmds delegated path =
  case findCmdIn path cmds of
    Nothing => Nothing
    Just c => Just (if c.cmdDelegated then delegated c else commandHelp cmds c)

-- | 某个命令路径的用法行（`Nothing` = 未登记）。
export synopsisIn : List Cmd -> List String -> Maybe String
synopsisIn cmds path =
  case findCmdIn path cmds of
    Nothing => Nothing
    Just c => Just c.cmdSynopsis

-- | 内部：帮助扫描的可见区间——`--` 之前的部分。
helpSurface : List String -> List String
helpSurface [] = []
helpSurface ("--" :: rest) = []
helpSurface (arg :: rest) = (::) arg (helpSurface rest)

-- | 内部：帮助旗标之前的参数（保持顺序）；没有帮助旗标给 `Nothing`。
beforeHelp : List String -> Maybe (List String)
beforeHelp [] = Nothing
beforeHelp ("-h" :: _) = Just []
beforeHelp ("--help" :: _) = Just []
beforeHelp (arg :: rest) =
  case beforeHelp rest of
    Nothing => Nothing
    Just prior => Just (arg :: prior)

-- | 内部：路径的第一段。
headName : Cmd -> String
headName c =
  case c.cmdPath of
    [] => ""
    name :: _ => name

-- | 内部：总览里的一行——命令名左对齐到固定宽度，后接摘要。
rowText : Cmd -> String
rowText c = "  ${padRight 20 (join " " c.cmdPath)} ${c.cmdSummary}\n"

-- | 内部：单条命令（或分支）的帮助正文。
commandHelp : List Cmd -> Cmd -> String
commandHelp cmds c =
  "${join " " c.cmdPath} — ${c.cmdSummary}\n\nusage:\n  ${c.cmdSynopsis}\n"
    ++ renderChildren (childrenIn c.cmdPath cmds)
    ++ renderFlags c.cmdFlags ++ renderNotes c.cmdNotes

-- | 内部：`childrenOf` 的线性扫描。
childrenIn : List String -> List Cmd -> List Cmd
childrenIn path [] = []
childrenIn path (c :: rest) =
  if isDirectChild path c.cmdPath then c :: childrenIn path rest else childrenIn path rest

-- | 内部：总览里的命令（保持表顺序）。
overviewCommands : List Cmd -> List Cmd
overviewCommands [] = []
overviewCommands (c :: rest) =
  if c.cmdInOverview then c :: overviewCommands rest else overviewCommands rest

-- | 内部：`child` 是否是 `parent` 的直接子命令（多出恰好一层）。
isDirectChild : List String -> List String -> Bool
isDirectChild parent child = prefixOf parent child && extraOne parent child

-- | 内部：`child` 去掉 `parent` 前缀后是否只剩一项。
extraOne : List String -> List String -> Bool
extraOne [] child =
  case child of
    [] => False
    [_] => True
    _ => False
extraOne (_ :: ps) child =
  case child of
    [] => False
    _ :: cs => extraOne ps cs

-- | 内部：是否空表。
isEmpty : List String -> Bool
isEmpty [] = True
isEmpty _ = False

-- | 内部：`prefix` 是否逐项等于 `xs` 的前缀。
prefixOf : List String -> List String -> Bool
prefixOf [] _ = True
prefixOf (_ :: _) [] = False
prefixOf (p :: ps) (x :: xs) = if p == x then prefixOf ps xs else False

-- | 内部：子命令小节。
renderChildren : List Cmd -> String
renderChildren [] = ""
renderChildren kids = "\ncommands:\n" ++ renderChildRows kids

-- | 内部：逐行渲染子命令。
renderChildRows : List Cmd -> String
renderChildRows [] = ""
renderChildRows (c :: rest) =
  "  ${padRight 20 (childLabel c)} ${c.cmdSummary}\n${renderChildRows rest}"

-- | 内部：子命令显示名——路径最后一段 + 用法里剩下的占位。
childLabel : Cmd -> String
childLabel c =
  case lastOf c.cmdPath of
    "" => join " " c.cmdPath
    name => name

-- | 内部：路径最后一段。
lastOf : List String -> String
lastOf [] = ""
lastOf (x :: rest) = if isEmpty rest then x else lastOf rest

-- | 内部：options 小节。
renderFlags : List FlagDoc -> String
renderFlags [] = ""
renderFlags flags = "\noptions:\n" ++ renderFlagRows flags

-- | 内部：逐行渲染 flag。
renderFlagRows : List FlagDoc -> String
renderFlagRows [] = ""
renderFlagRows (f :: rest) = "  ${padRight 26 (flagUsage f)} ${f.flagHelp}\n${renderFlagRows rest}"

-- | 内部：flag 的用法片段——开关只有名字，取值 flag 带占位（可重复的加 `...`）。
flagUsage : FlagDoc -> String
flagUsage f =
  case f.flagSpec of
    BoolFlag name => "--${name}"
    ValueFlag name => if f.flagMeta == "" then "--${name} VALUE" else "--${name} ${f.flagMeta}"
    MultiValueFlag name =>
      if f.flagMeta == "" then "--${name} VALUE..." else "--${name} ${f.flagMeta}..."

-- | 内部：notes 小节。
renderNotes : List String -> String
renderNotes [] = ""
renderNotes notes = "\nnotes:\n" ++ renderNoteRows notes

-- | 内部：逐行渲染补充说明。
renderNoteRows : List String -> String
renderNoteRows [] = ""
renderNoteRows (note :: rest) = "  ${note}\n${renderNoteRows rest}"

-- | 内部：右侧补空格到 `width`（按 UTF-8 字节计；中文摘要不参与对齐）。
padRight : Int -> String -> String
padRight width text =
  if strLength text >= width then text else "${text}${spaces (width - strLength text)}"

-- | 内部：`n` 个空格。
spaces : Int -> String
spaces n = if n <= 0 then "" else " " ++ spaces (n - 1)

-- | 内部：命令表是否为空。
emptyCmds : List Cmd -> Bool
emptyCmds [] = True
emptyCmds _ = False
