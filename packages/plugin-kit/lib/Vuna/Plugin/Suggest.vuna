-- | 未知命令 / 未知 flag 的「是不是想输入」建议。
--
-- 只做两类近距离判定（同一长度差一位、短一串前缀）；不引入编辑距离矩阵——命令与 flag
-- 都是短标识符，这两类覆盖实际拼写错误，且失败时只是不给建议，不影响退出码。
module Vuna.Plugin.Suggest where

import Base.Data.List as List
import Base.Data.String as String
import Base.Data.Bool as Bool

-- | 在候选里找与输入最近的一个；没有就 `Nothing`（空输入与单字符输入不建议）。
export suggestOne : List String -> String -> Maybe String
suggestOne candidates input =
  if strLength input < 2 then
    Nothing
  else
    firstJust (map (\c => if closeEnough input c then Just c else Nothing) candidates)

-- | 内部：两个标识符是否近到值得提示。
closeEnough : String -> String -> Bool
closeEnough input candidate =
  strLength candidate
    >= 2
    && (startsWith input candidate || startsWith candidate input) || oneEditApart input candidate

-- | 内部：长度相同且只差一位，或长度差一且删掉一位就相同。
oneEditApart : String -> String -> Bool
oneEditApart a b =
  if strLength a == strLength b then
    differOnce (strUnpack a) (strUnpack b)
  else if strLength a + 1 == strLength b then
    deletionApart a b
  else if strLength b + 1 == strLength a then deletionApart b a else False

-- | 内部：逐字符比较，最多允许一处不同。
differOnce : List Int -> List Int -> Bool
differOnce [] [] = False
differOnce (x :: xs) (y :: ys) = if x == y then differOnce xs ys else xs == ys
differOnce _ _ = False

-- | 内部：`short` 是否等于 `long` 删掉恰好一个字符。
deletionApart : String -> String -> Bool
deletionApart short long = deletionGo (strUnpack short) (strUnpack long)

-- | 内部：`deletionApart` 的扫描——允许且只允许跳过 `long` 的一个字符，之后必须逐位相同。
deletionGo : List Int -> List Int -> Bool
deletionGo [] [] = False
deletionGo [] (_ :: _) = True
deletionGo (_ :: _) [] = False
deletionGo (s :: ss) (l :: ls) = if s == l then deletionGo ss ls else s :: ss == ls
