-- | HTTP/1.1 响应消息模型与常见状态码文本。
module Http.Response where

import Base
import Http.Header as Header

-- | 一条响应：状态码 + 原因短语 + 头部 + 体（`String` 是字节串）。
export record Response(..) where
  -- | 状态码。
  status : Int
  -- | 原因短语（渲染时使用；解析时保留原样）。
  reason : String
  -- | 头部（顺序即发送顺序）。
  headers : List (Pair String String)
  -- | 消息体。
  body : String

-- | 按状态码取原因短语；未知码给空串（渲染仍合法）。
export statusText : Int -> String
statusText 200 = "OK"
statusText 201 = "Created"
statusText 204 = "No Content"
statusText 301 = "Moved Permanently"
statusText 302 = "Found"
statusText 304 = "Not Modified"
statusText 400 = "Bad Request"
statusText 404 = "Not Found"
statusText 405 = "Method Not Allowed"
statusText 408 = "Request Timeout"
statusText 413 = "Payload Too Large"
statusText 431 = "Request Header Fields Too Large"
statusText 500 = "Internal Server Error"
statusText 501 = "Not Implemented"
statusText 503 = "Service Unavailable"
statusText _ = ""

-- | 用状态码与其标准原因短语构造响应。
export response : Int -> String -> Response
response code body = Response code (statusText code) [] body

-- | 取同名头部的值（大小写不敏感）。
export header : String -> Response -> Maybe String
header name r = Header.headerValue name r.headers
