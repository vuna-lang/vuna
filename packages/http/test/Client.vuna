-- 回环 e2e：客户端渲染请求 → 内存 duplex → 服务循环 → 客户端读响应。
import Base
import Base.Effect.Core
import Base.Effect.MutRef as MutRef
import Http.Client as C
import Http.Connection as Conn
import Http.Request as Req
import Http.Response as Res
import Http.Render as R
import Base.Effect.Console
import Base.Effect.Exit

main : Eff [ConsoleOp, ExitOp] String
main =
  MutRef.withMutRef "toServer" "" (
      MutRef.withMutRef "toClient" "" (
          do
            _ <- Conn.writeAllOf clientSide (R.renderRequest (Req.request "GET" "/x"))
            served <- Conn.serveWith serverSide 1 (handlerOf "got ")
            exchange <- C.readResponse clientSide ""
            case failuresOf served exchange of
              [] => pure ""
              bad =>
                do
                  _ <- consolePrint ("http client failed: " ++ join "; " bad ++ "\n")
                  _ <- exitWith 1
                  pure ""
        )
    )

-- | 写 `toServer`、读 `toClient`；反向的 duplex 见 `serverSide`。
clientSide : {r : Row} -> {rc : Member (Named "toClient" (MutRefOp String)) r} -> {rs : Member (Named "toServer" (MutRefOp String)) r} -> Conn.Duplex r
clientSide = Conn.Dup readSomeFromClient writeAllToServer (pure 0)

-- | 写 `toClient`、读 `toServer`。
serverSide : {r : Row} -> {rc : Member (Named "toClient" (MutRefOp String)) r} -> {rs : Member (Named "toServer" (MutRefOp String)) r} -> Conn.Duplex r
serverSide = Conn.Dup readSomeFromServer writeAllToClient (pure 0)

-- | 从 `toClient` 取至多 `n` 字节，余量写回。
readSomeFromClient : {r : Row} -> {w : Member (Named "toClient" (MutRefOp String)) r} -> Int -> Eff r String
readSomeFromClient n =
  do
    s <- MutRef.read@toClient
    MutRef.write@toClient (dropBytes n s)
    pure (takeBytes n s)

-- | 从 `toServer` 取至多 `n` 字节，余量写回。
readSomeFromServer : {r : Row} -> {w : Member (Named "toServer" (MutRefOp String)) r} -> Int -> Eff r String
readSomeFromServer n =
  do
    s <- MutRef.read@toServer
    MutRef.write@toServer (dropBytes n s)
    pure (takeBytes n s)

-- | 把整段字节追加到 `toServer`。
writeAllToServer : {r : Row} -> {w : Member (Named "toServer" (MutRefOp String)) r} -> String -> Eff r Int
writeAllToServer s =
  do
    cur <- MutRef.read@toServer
    MutRef.write@toServer (cur ++ s)
    pure (strLength s)

-- | 把整段字节追加到 `toClient`。
writeAllToClient : {r : Row} -> {w : Member (Named "toClient" (MutRefOp String)) r} -> String -> Eff r Int
writeAllToClient s =
  do
    cur <- MutRef.read@toClient
    MutRef.write@toClient (cur ++ s)
    pure (strLength s)

-- | 取前 `n` 字节（不足则整串）。
takeBytes : Int -> String -> String
takeBytes n s = strSubstring 0 (if strLength s > n then n else strLength s) s

-- | 去掉前 `n` 字节（不足则空串）。
dropBytes : Int -> String -> String
dropBytes n s =
  let
    k = if strLength s > n then n else strLength s
  in strSubstring k (strLength s - k) s

-- | 回声 handler：把请求目标写进响应体。
handlerOf : {r : Row} -> String -> Req.Request -> Eff r Res.Response
handlerOf prefix req = pure (Res.response 200 (prefix ++ req.target))

-- | 断言：一条请求被服务，客户端拿到同一响应体。
failuresOf : Int -> C.Exchange -> List String
failuresOf served exchange =
  append (check "served" (served == 1)) (
      case exchange of
        C.GotResponse resp rest => append (check "status" (resp.status == 200)) (append (check "body" (resp.body == "got /x")) (check "rest" (rest == "")))
        _ => ["response"]
    )

-- | 一条命名检查。
check : String -> Bool -> List String
check name ok = if ok then [] else [name]
