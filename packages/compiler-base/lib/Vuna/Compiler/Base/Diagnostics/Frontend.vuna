      "期望在该列出现一个声明",
    PsEntry
      (psCode (ExpectedToken ""))
      (psTemplate (ExpectedToken ""))
      "期望指定符号或关键字",
    PsEntry
      (psCode (WhereSigBeforeClause ""))
      (psTemplate (WhereSigBeforeClause ""))
