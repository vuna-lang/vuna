      (psTemplate (DefinitionDuplicate ""))
      "零参定义只能有一条子句",
    PsEntry
      (psCode (ClauseShadowed ""))
      (psTemplate (ClauseShadowed ""))
      "子句被前面的子句完全覆盖"
  ]

-- ---------------------------------------------------------------
-- throw：构造结构化诊断。**必须给位置**：词法错误用字符游标处的 span（文件名由
-- `Loader.Flatten` 的 parse 入口经 `withSpanFileIfEmpty` 注入），语法错误用当前 token
-- 的 span。这里只有带位置的出口。
-- ---------------------------------------------------------------
export lexMsg : {n : Nat} -> LexDiag n -> Vec n String -> Diagnostic
lexMsg e args = mkDiag SevError PhLex CatSyntax (lexCode e) (diagBody (lexTemplate e) args)

export psMsg : {n : Nat} -> PsDiag n -> Vec n String -> Diagnostic
psMsg e args = mkDiag SevError PhParse CatSyntax (psCode e) (diagBody (psTemplate e) args)

-- | 带位置的词法诊断：span 的 `file` 可以为空（由入口注入）。
export lexErrAt : Span -> {n : Nat} -> LexDiag n -> Vec n String -> Check a
lexErrAt sp e args = ErrC (withLabel (Label (Just sp) "" LabelPrimary Nothing) (lexMsg e args))

-- | 带位置的语法诊断。
export psErrAt : Span -> {n : Nat} -> PsDiag n -> Vec n String -> Check a
psErrAt sp e args =
  case e of
    ExpectedToken s =>
      ErrC
        (withLabel (Label (Just sp) "" LabelPrimary Nothing) (withField (FieldExpected s) (psMsg e args)))
    _ => ErrC (withLabel (Label (Just sp) "" LabelPrimary Nothing) (psMsg e args))

-- | 零元词法诊断（带位置）。
export lexErr0At : Span -> LexDiag Zero -> Check a
lexErr0At sp e = lexErrAt sp e []

-- | 零元语法诊断（带位置）。
export psErr0At : Span -> PsDiag Zero -> Check a
psErr0At sp e = psErrAt sp e []

-- | 一元语法诊断（带位置，实参填 `<0>`）。
export psErr1At : Span -> PsDiag (Succ Zero) -> String -> Check a
psErr1At sp e a0 = psErrAt sp e [a0]
