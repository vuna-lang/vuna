      "case 分支后出现意外缩进",
    PsEntry
      (psCode UnexpectedIndentInData)
      (psTemplate UnexpectedIndentInData)
      "data 块内出现意外缩进",
    PsEntry
      (psCode UnexpectedIndentInDo)
