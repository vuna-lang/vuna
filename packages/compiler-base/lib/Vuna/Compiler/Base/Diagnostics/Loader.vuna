module Vuna.Compiler.Base.Diagnostics.Loader where

-- Vuna.Compiler.Base.Diagnostics.Loader：模块加载 / 包图诊断的域枚举。
--
-- 域 `LD_`：模块解析（Flatten/Modules/Resolve 的加载期错误）。这些诊断**无 Span**
-- （错误发生在文件/模块粒度而非 token 粒度），输出 `[CODE] 消息`（无位置前缀）。
-- 与 TC_/CG_/LX_/PS_/LN_ 同构：arity 由 `Nat` 索引在编译期锁定。
-- `DT: internal:` 的 fuel 耗尽等内部不变量不占符号。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics.Common
import qualified Base.Data.Vec as Vec
-- 只重导出除 `Base.Data.Vec` 外的数据模块：Vec 的 `(::)` 与 List 的 `::` 同名，
-- 重导出会让推断位的 `(::)` 变成 `TC_AmbiguousCtor`；需要 Vec 的模块显式 import。
export module Base.Data.Pair
export module Base.Data.Pair as Pair
export module Base.Data.Function
export module Base.Data.Function as Function
export module Base.Data.Bool
export module Base.Data.Bool as Bool
export module Base.Data.List
export module Base.Data.List as List
export module Base.Data.Maybe
export module Base.Data.Maybe as Maybe
export module Base.Data.Result
export module Base.Data.Result as Result
export module Base.Data.String
export module Base.Data.String as String
export module Base.Data.Unit
export module Base.Data.Unit as Unit
export module Base.Data.Fin
export module Base.Data.Fin as Fin
export module Base.Data.Nat
export module Base.Data.Nat as Nat
export module Base.Data.Int
export module Base.Data.Int as Int
export module Base.Data.Float
export module Base.Data.Float as Float
export module Base.Data.Bits
export module Base.Data.Bits as Bits
export module Base.Data.Sha1
export module Base.Data.Sha1 as Sha1
export module Base.Data.Base64
export module Base.Data.Base64 as Base64
export module Base.Data.Sort
export module Base.Data.Sort as Sort
export module Base.Data.Stream as Stream
export module Base.Data.Log
export module Base.Data.Log as Log

export data LdDiag(..) : Nat -> Type where
  -- arity 1
  EntryFileNotFound : String -> LdDiag 1
  ImportCycle : String -> LdDiag 1
  InvalidModuleName : String -> LdDiag 1
  ModuleHeaderInEntryFile : String -> LdDiag 1
  ModuleHeaderInEntrySource : String -> LdDiag 1
  -- arity 2
  ModuleNotFound : String -> String -> LdDiag 2
  ModuleNotExported : String -> String -> LdDiag 2
  -- arity 4
  LayerViolation : LdDiag 4

export ldCode : {n : Nat} -> LdDiag n -> String
ldCode (EntryFileNotFound _) = "LD_EntryFileNotFound"
ldCode (ImportCycle _) = "LD_ImportCycle"
ldCode (InvalidModuleName _) = "LD_InvalidModuleName"
ldCode (ModuleHeaderInEntryFile _) = "LD_ModuleHeaderInEntryFile"
ldCode (ModuleHeaderInEntrySource _) = "LD_ModuleHeaderInEntrySource"
ldCode (ModuleNotFound _ _) = "LD_ModuleNotFound"
ldCode (ModuleNotExported _ _) = "LD_ModuleNotExported"
ldCode LayerViolation = "LD_LayerViolation"

export ldTemplate : {n : Nat} -> LdDiag n -> String
ldTemplate (EntryFileNotFound _) = "entry file not found: <0>"
ldTemplate (ImportCycle _) = "import cycle: <0>"
ldTemplate (InvalidModuleName _) = "invalid module name: <0>"
ldTemplate (ModuleHeaderInEntryFile _) = "module header is not supported in the entry file (<0>)"
ldTemplate (ModuleHeaderInEntrySource _) =
  "module header is not supported in the entry source (<0>)"
ldTemplate (ModuleNotFound _ _) = "cannot find module <0> (roots: <1>)"
ldTemplate (ModuleNotExported _ _) = "module <0> is not exported by package <1>"
ldTemplate LayerViolation = "module <0> (layer <2>) cannot import <1> (layer <3>)"

export record LdEntry(..) where
  ldEntryCode : String
  ldEntryTemplate : String
  ldEntryDesc : String

export ldAll : List LdEntry
ldAll =
  [
    LdEntry
      (ldCode (EntryFileNotFound ""))
      (ldTemplate (EntryFileNotFound ""))
      "入口文件不存在",
    LdEntry (ldCode (ImportCycle "")) (ldTemplate (ImportCycle "")) "导入循环",
    LdEntry (ldCode (InvalidModuleName "")) (ldTemplate (InvalidModuleName "")) "非法模块名",
    LdEntry
      (ldCode (ModuleHeaderInEntryFile ""))
      (ldTemplate (ModuleHeaderInEntryFile ""))
      "入口文件不允许模块头",
    LdEntry
      (ldCode (ModuleHeaderInEntrySource ""))
      (ldTemplate (ModuleHeaderInEntrySource ""))
      "入口源码不允许模块头",
    LdEntry (ldCode (ModuleNotFound "" "")) (ldTemplate (ModuleNotFound "" "")) "模块未找到",
    LdEntry
      (ldCode (ModuleNotExported "" ""))
      (ldTemplate (ModuleNotExported "" ""))
      "模块未被包导出",
    LdEntry (ldCode LayerViolation) (ldTemplate LayerViolation) "跨层导入"
  ]

export ldMsg : {n : Nat} -> LdDiag n -> Vec.Vec n String -> Diagnostic
ldMsg e args = mkDiag SevError PhLoad CatPackage (ldCode e) (diagBody (ldTemplate e) args)

export ldErr : {n : Nat} -> LdDiag n -> Vec.Vec n String -> Check a
ldErr e args = ErrC (ldMsg e args)

-- | 零元加载诊断（`Check` 里直接是 `ErrC`）。
export ldErr0 : LdDiag 0 -> Check a
ldErr0 e = ldErr e []

-- | 一元加载诊断（实参填 `<0>`）。
export ldErr1 : LdDiag 1 -> String -> Check a
ldErr1 e a0 = ldErr e [a0]

-- | 四元加载诊断（实参填 `<0>`..`<3>`）。
export ldErr4 : LdDiag 4 -> String -> String -> String -> String -> Check a
ldErr4 e a0 a1 a2 a3 = ldErr e [a0, a1, a2, a3]

-- | 二元加载诊断（实参填 `<0>` / `<1>`）。
export ldErr2 : LdDiag 2 -> String -> String -> Check a
ldErr2 e a0 a1 = ldErr e [a0, a1]
