-- | RN_ 域：名字解析（import/export/限定名/构造子/类型名）与内置宏展开诊断。
module Vuna.Compiler.Base.Diagnostics.Rn where

-- Vuna.Compiler.Base.Diagnostics.Rn：名字解析阶段（phase = Resolve，category = Names）。
--
-- 这些错误发生在 import/export/限定名/构造子解析与内置宏展开，语义是「名字不可用/
-- 不唯一」或「宏调用形状不对」，与模块图加载（LD_）和类型检查（TC_）分开。消息体与旧
-- 实现逐字一致（旧 label 前缀由 span/上下文承载，不再拼进消息）。
-- 宏展开错误也归入本域：展开发生在名字解析之前、同样只依赖名字与 span，足够同构。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Diagnostics.Common
import Base.Data.Nat as Nat
import Base.Data.Vec as Vec

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.RnErr（目录/模板见 diagnostics.md）。
export data RnErr(..) : Nat -> Type where
  -- arity 0
  DuplicateImport : RnErr 0
  -- arity 1
  AmbiguousConstructorExport : String -> RnErr 1
  AmbiguousModule : String -> String -> RnErr 2
  -- | 同一运算符在程序里声明了不止一次 fixity（符号的 fixity 全程序唯一）。
  DuplicateFixity : String -> RnErr 1
  -- | 内建运算符（`->` / `&&` / `||`）的 fixity 由编译器固定，不能声明。
  BuiltinFixity : String -> RnErr 1
  CannotExportUnknownName : String -> RnErr 1
  DuplicateExport : String -> RnErr 1
  DuplicateModuleAlias : String -> RnErr 1
  InvalidModuleAlias : String -> RnErr 1
  InvalidTopLevelName : String -> RnErr 1
  InvalidTypeExpression : String -> RnErr 1
  InvalidVariableName : String -> RnErr 1
  ModuleAliasConflict : String -> RnErr 1
  ModuleNameMismatch : String -> RnErr 1
  ModuleNotImported : String -> RnErr 1
  TypeHasNoConstructor : String -> String -> RnErr 2
  UnknownConstructor : String -> RnErr 1
  UnknownInterface : String -> RnErr 1
  UnknownType : String -> RnErr 1
  UnknownFixity : String -> RnErr 1
  UnknownVariable : String -> RnErr 1
  -- | 内置宏调用用了未注册的宏名。
  UnknownMacro : String -> RnErr 1
  -- | `log!` 的级别不在 `error` / `warn` / `info` / `debug` / `trace` 里。
  LogLevelUnknown : String -> RnErr 1
  -- | `log!` 的级别必须是字符串字面量。
  LogLevelNotLiteral : RnErr 0
  AmbiguousPrelude : String -> RnErr 1
  -- arity 2
  AmbiguousConstructor : String -> String -> RnErr 2
  AmbiguousConstructorInExport : String -> String -> RnErr 2
  TypeNotExported : String -> String -> RnErr 2
  ValueNotExported : String -> String -> RnErr 2
  -- arity 3
  -- | 内置宏的实参个数与注册 arity 不符。
  MacroArity : String -> String -> String -> RnErr 3
  -- | 两个 import 提供了同名但 target 不同的条目（种类 / 名字 / 来源模块）。
  AmbiguousName : String -> String -> String -> RnErr 3

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnCode（目录/模板见 diagnostics.md）。
export rnCode : {n : Nat} -> RnErr n -> String
rnCode DuplicateImport = "RN_DuplicateImport"
rnCode (AmbiguousConstructorExport _) = "RN_AmbiguousConstructorExport"
rnCode (AmbiguousModule _ _) = "RN_AmbiguousModule"
rnCode (DuplicateFixity _) = "RN_DuplicateFixity"
rnCode (BuiltinFixity _) = "RN_BuiltinFixity"
rnCode (CannotExportUnknownName _) = "RN_CannotExportUnknownName"
rnCode (DuplicateExport _) = "RN_DuplicateExport"
rnCode (DuplicateModuleAlias _) = "RN_DuplicateModuleAlias"
rnCode (InvalidModuleAlias _) = "RN_InvalidModuleAlias"
rnCode (InvalidTopLevelName _) = "RN_InvalidTopLevelName"
rnCode (InvalidTypeExpression _) = "RN_InvalidTypeExpression"
rnCode (InvalidVariableName _) = "RN_InvalidVariableName"
rnCode (ModuleAliasConflict _) = "RN_ModuleAliasConflict"
rnCode (ModuleNameMismatch _) = "RN_ModuleNameMismatch"
rnCode (ModuleNotImported _) = "RN_ModuleNotImported"
rnCode (TypeHasNoConstructor _ _) = "RN_TypeHasNoConstructor"
rnCode (UnknownConstructor _) = "RN_UnknownConstructor"
rnCode (UnknownInterface _) = "RN_UnknownInterface"
rnCode (UnknownType _) = "RN_UnknownType"
rnCode (UnknownFixity _) = "RN_UnknownFixity"
rnCode (UnknownVariable _) = "RN_UnknownVariable"
rnCode (UnknownMacro _) = "RN_UnknownMacro"
rnCode (LogLevelUnknown _) = "RN_LogLevelUnknown"
rnCode LogLevelNotLiteral = "RN_LogLevelNotLiteral"
rnCode (AmbiguousPrelude _) = "RN_AmbiguousPrelude"
rnCode (AmbiguousConstructor _ _) = "RN_AmbiguousConstructor"
rnCode (AmbiguousConstructorInExport _ _) = "RN_AmbiguousConstructorInExport"
rnCode (TypeNotExported _ _) = "RN_TypeNotExported"
rnCode (ValueNotExported _ _) = "RN_ValueNotExported"
rnCode (MacroArity _ _ _) = "RN_MacroArity"
rnCode (AmbiguousName _ _ _) = "RN_AmbiguousName"

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnTemplate（目录/模板见 diagnostics.md）。
export rnTemplate : {n : Nat} -> RnErr n -> String
rnTemplate DuplicateImport = "duplicate import"
rnTemplate (AmbiguousConstructorExport _) =
  "ambiguous constructor export <0> (write T(..) or qualify it)"
rnTemplate (AmbiguousModule _ _) = "ambiguous module <0> (found in: <1>)"
rnTemplate (CannotExportUnknownName _) = "cannot export unknown name <0>"
rnTemplate (DuplicateExport _) = "duplicate export <0>"
rnTemplate (DuplicateModuleAlias _) = "duplicate module alias <0>"
rnTemplate (InvalidModuleAlias _) = "invalid module alias <0>"
rnTemplate (InvalidTopLevelName _) = "invalid top-level name <0>"
rnTemplate (InvalidTypeExpression _) = "invalid type expression (<0>)"
rnTemplate (InvalidVariableName _) = "invalid variable name <0>"
rnTemplate (ModuleAliasConflict _) = "module alias <0> conflicts with an imported module"
rnTemplate (ModuleNameMismatch _) = "module name mismatch: source declares <0>"
rnTemplate (ModuleNotImported _) = "module <0> is not imported"
rnTemplate (TypeHasNoConstructor _ _) = "type <0> has no constructor <1>"
rnTemplate (UnknownConstructor _) = "unknown constructor <0>"
rnTemplate (UnknownInterface _) = "unknown interface <0>"
rnTemplate (UnknownType _) = "unknown type <0>"
rnTemplate (UnknownFixity _) =
  "unknown fixity for operator <0> (declare it with infixl/infixr/infix)"
rnTemplate (DuplicateFixity _) =
  "operator <0> has more than one fixity declaration (a symbol must have exactly one precedence/associativity in a program)"
rnTemplate (BuiltinFixity _) =
  "the fixity of built-in operator <0> is fixed by the compiler (remove the declaration)"
rnTemplate (UnknownVariable _) = "unbound variable <0>"
rnTemplate (UnknownMacro _) = "unknown macro <0>"
rnTemplate (LogLevelUnknown _) =
  "unknown log level <0> (expected error, warn, info, debug, or trace)"
rnTemplate LogLevelNotLiteral = "log! level must be a string literal"
rnTemplate (AmbiguousPrelude _) = "ambiguous implicit Prelude (found in: <0>)"
rnTemplate (AmbiguousConstructor _ _) = "ambiguous constructor <0> (qualify it as <1>)"
rnTemplate (AmbiguousConstructorInExport _ _) =
  "ambiguous constructor <0> in <1> (export T(..) instead)"
rnTemplate (TypeNotExported _ _) = "type <0> is not exported by <1>"
rnTemplate (ValueNotExported _ _) = "<0> is not exported by <1>"
rnTemplate (MacroArity _ _ _) = "macro <0> expects <1> argument(s), got <2>"
rnTemplate (AmbiguousName _ _ _) =
  "ambiguous <0> <1> (imported from <2>; qualify it at the use site)"

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnMsg（目录/模板见 diagnostics.md）。
export rnMsg : {n : Nat} -> RnErr n -> Vec n String -> Diagnostic
rnMsg e args = diagNoLoc SevError PhResolve CatNames (rnCode e) (diagBody (rnTemplate e) args)

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnErr（目录/模板见 diagnostics.md）。
export rnErr : Span -> {n : Nat} -> RnErr n -> Vec n String -> Check a
rnErr sp e args = ErrC (withLabel (Label (Just sp) "" LabelPrimary Nothing) (rnMsg e args))

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnNoLoc（目录/模板见 diagnostics.md）。
rnNoLoc : {n : Nat} -> RnErr n -> Vec n String -> Check a
rnNoLoc e args = ErrC (rnMsg e args)

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnAt0（目录/模板见 diagnostics.md）。
export rnAt0 : Span -> RnErr 0 -> Check a
rnAt0 sp e = rnErr sp e []

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnAt1（目录/模板见 diagnostics.md）。
export rnAt1 : Span -> RnErr 1 -> String -> Check a
rnAt1 sp e a0 = rnErr sp e [a0]

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnAt2（目录/模板见 diagnostics.md）。
export rnAt2 : Span -> RnErr 2 -> String -> String -> Check a
rnAt2 sp e a0 a1 = rnErr sp e [a0, a1]

-- | 带三个插值实参、带 span 的报错（宏 arity 错误用）。
export rnAt3 : Span -> RnErr 3 -> String -> String -> String -> Check a
rnAt3 sp e a0 a1 a2 = rnErr sp e [a0, a1, a2]

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnNoLoc0（目录/模板见 diagnostics.md）。
export rnNoLoc0 : RnErr 0 -> Check a
rnNoLoc0 e = rnNoLoc e []

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnNoLoc1（目录/模板见 diagnostics.md）。
export rnNoLoc1 : RnErr 1 -> String -> Check a
rnNoLoc1 e a0 = rnNoLoc e [a0]

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnNoLoc2（目录/模板见 diagnostics.md）。
export rnNoLoc2 : RnErr 2 -> String -> String -> Check a
rnNoLoc2 e a0 a1 = rnNoLoc e [a0, a1]

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnNoLoc3（目录/模板见 diagnostics.md）。
export rnNoLoc3 : RnErr 3 -> String -> String -> String -> Check a
rnNoLoc3 e a0 a1 a2 = rnNoLoc e [a0, a1, a2]

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.RnEntry（目录/模板见 diagnostics.md）。
export record RnEntry(..) where
  rnEntryCode : String
  rnEntryTemplate : String
  rnEntryDesc : String

-- | 诊断域实现：Vuna.Compiler.Base.Diagnostics.Rn.rnAll（目录/模板见 diagnostics.md）。
export rnAll : List RnEntry
rnAll =
  [
    RnEntry (rnCode DuplicateImport) (rnTemplate DuplicateImport) "重复导入",
    RnEntry
      (rnCode (AmbiguousConstructorExport ""))
      (rnTemplate (AmbiguousConstructorExport ""))
      "导出的构造子名有歧义",
    RnEntry (rnCode (AmbiguousModule "" "")) (rnTemplate (AmbiguousModule "" "")) "模块名歧义",
    RnEntry
      (rnCode (CannotExportUnknownName ""))
      (rnTemplate (CannotExportUnknownName ""))
      "导出未知名字",
    RnEntry (rnCode (DuplicateExport "")) (rnTemplate (DuplicateExport "")) "重复导出",
    RnEntry
      (rnCode (DuplicateModuleAlias ""))
      (rnTemplate (DuplicateModuleAlias ""))
      "重复模块别名",
    RnEntry
      (rnCode (InvalidModuleAlias ""))
      (rnTemplate (InvalidModuleAlias ""))
      "非法模块别名",
    RnEntry
      (rnCode (InvalidTopLevelName ""))
      (rnTemplate (InvalidTopLevelName ""))
      "非法顶层名",
    RnEntry
      (rnCode (InvalidTypeExpression ""))
      (rnTemplate (InvalidTypeExpression ""))
      "非法类型表达式",
    RnEntry
      (rnCode (InvalidVariableName ""))
      (rnTemplate (InvalidVariableName ""))
      "非法变量名",
    RnEntry
      (rnCode (ModuleAliasConflict ""))
      (rnTemplate (ModuleAliasConflict ""))
      "模块别名与导入冲突",
    RnEntry
      (rnCode (ModuleNameMismatch ""))
      (rnTemplate (ModuleNameMismatch ""))
      "模块名不匹配",
    RnEntry (rnCode (ModuleNotImported "")) (rnTemplate (ModuleNotImported "")) "模块未被导入",
    RnEntry
      (rnCode (TypeHasNoConstructor "" ""))
      (rnTemplate (TypeHasNoConstructor "" ""))
      "类型没有该构造子",
    RnEntry (rnCode (UnknownConstructor "")) (rnTemplate (UnknownConstructor "")) "未知构造子",
    RnEntry (rnCode (UnknownInterface "")) (rnTemplate (UnknownInterface "")) "未知接口",
    RnEntry (rnCode (UnknownType "")) (rnTemplate (UnknownType "")) "未知类型",
    RnEntry (rnCode (UnknownFixity "")) (rnTemplate (UnknownFixity "")) "未知运算符 fixity",
    RnEntry
      (rnCode (DuplicateFixity ""))
      (rnTemplate (DuplicateFixity ""))
      "运算符 fixity 重复声明",
    RnEntry
      (rnCode (BuiltinFixity ""))
      (rnTemplate (BuiltinFixity ""))
      "内建运算符 fixity 由编译器固定",
    RnEntry (rnCode (UnknownVariable "")) (rnTemplate (UnknownVariable "")) "未绑定变量",
    RnEntry (rnCode (UnknownMacro "")) (rnTemplate (UnknownMacro "")) "未知宏",
    RnEntry (rnCode (LogLevelUnknown "")) (rnTemplate (LogLevelUnknown "")) "未知日志级别",
    RnEntry
      (rnCode LogLevelNotLiteral)
      (rnTemplate LogLevelNotLiteral)
      "日志级别必须是字符串字面量",
    RnEntry
      (rnCode (AmbiguousPrelude ""))
      (rnTemplate (AmbiguousPrelude ""))
      "隐式 Prelude 歧义",
    RnEntry
      (rnCode (AmbiguousConstructor "" ""))
      (rnTemplate (AmbiguousConstructor "" ""))
      "构造子歧义",
    RnEntry
      (rnCode (AmbiguousConstructorInExport "" ""))
      (rnTemplate (AmbiguousConstructorInExport "" ""))
      "导出中构造子歧义",
    RnEntry
      (rnCode (TypeNotExported "" ""))
      (rnTemplate (TypeNotExported "" ""))
      "类型未被导出",
    RnEntry
      (rnCode (ValueNotExported "" ""))
      (rnTemplate (ValueNotExported "" ""))
      "值未被导出",
    RnEntry
      (rnCode (MacroArity "" "" ""))
      (rnTemplate (MacroArity "" "" ""))
      "宏实参个数不匹配",
    RnEntry
      (rnCode (AmbiguousName "" "" ""))
      (rnTemplate (AmbiguousName "" "" ""))
      "导入的条目名歧义"
  ]
