module Vuna.Compiler.Base.Obs where

-- Vuna.Compiler.Base.Obs：编译器自身的观测插桩（阶段 span / 计数 / 标记 / 采样）。
--
-- 直接包隐藏运行时原语 `@vuna@obs@*`：编译器在 seed 闭包里，不依赖应用面观测库。
-- 规范见 `docs/reference/observability.md`。
--
-- `Check a`（`OkC` / `ErrC`）的阶段跨度把「求值 + 构造 Check」整体放进 thunk 里，
-- 错误路径也照样写出带 `args.error` 的 `X` 事件。`Eff r` 的动作不能被纯跨度包住
-- （执行发生在 runner 里），那些边界用 `vuna.mark.*` 瞬时标记记录（`obsMark`），
-- 时间轴上是零宽度点。
--
-- 关闭时全部退化为一次 `Lazy.force` + 直接调用（见规范 §6）。
import Base.Data.List as List
import Vuna.Compiler.Base.Common
import Base.Effect.Core
import Base.Effect.Types as EffTypes
import Base.Trait.Monad

-- ---------------------------------------------------------------
-- 原语包装
-- ---------------------------------------------------------------
-- | 当前观测级别（`0` 关 / `1` 阶段 / `2` 逐定义 / `3` 采样）。
obsLevel : Int -> Int
obsLevel n = @vuna@obs@level n

-- | 计数器读数（`ph:"C"`，`args.value`）。
export obsCounter : String -> Int -> Int
obsCounter name v = @vuna@obs@counter name v

-- | 瞬时标记（`ph:"i"`）：零宽度事件。
export obsMark : String -> Int
obsMark name = @vuna@obs@mark name

-- | 一个带分类的纯跨度：执行 `f 0` 并记录 `name` / `cat` 的 `ph:"X"` 事件。
export obsSpan : String -> String -> (Int -> a) -> a
obsSpan name cat f = @vuna@obs@span name cat f

-- | 包住一个 `Eff` 动作的跨度：begin → action → end，`finally` 保证 abort 路径也结束跨度。
export obsSpanEff : {r : Row} -> {a : Type} -> String -> String -> Eff r a -> Eff r a
obsSpanEff name cat action =
  do
    tok <- pure (@vuna@obs@spanBegin name cat)
    finally action (pure (@vuna@obs@spanEnd tok))

-- | 开始采样：`mode` 为 `"cpu"` / `"mem"` / `"both"`，`intervalUs` 是采样间隔。
export obsSampleStart : String -> Int -> Int
obsSampleStart mode intervalUs = @vuna@obs@sampleStart mode intervalUs

-- | 停止采样并 flush trace。
export obsSampleStop : Int -> Int
obsSampleStop n = @vuna@obs@sampleStop n

-- ---------------------------------------------------------------
-- Check 形态的阶段 span
-- ---------------------------------------------------------------
-- | 把一个 `Check a` 的求值放进 `ph:"X"` 跨度：`name` 用规范词汇表（`vuna.elab.*` /
-- `vuna.codegen.*` / `vuna.iface.*` …），`cat` 一般 `vuna.phase`。
export obsCheck : String -> (Int -> Check a) -> Check a
obsCheck name f = obsSpan name "vuna.phase" f

-- | 纯变换的阶段跨度：`rezonk` / 额外定义生成这类收尾工作不返回 `Check`，用这个包
-- （分类与 `obsCheck` 一致）。关闭时只付一次 `Lazy.force` + 直接调用。
export obsPure : String -> (Int -> a) -> a
obsPure name f = obsSpan name "vuna.phase" f

-- | 高频计数器（`ph:"C"`）：`minLevel` 是发事件的最低观测级别。一次 check 里 conv /
-- 求值的调用量是 10^5–10^6 级，默认压到 level 3，避免把 level 2 的 trace 撑大。
-- 调用方给常量 `v`（关闭时不跳过实参求值）。关闭路径 = 一次 `Lazy.force` + 分支。
export obsCountAt : Int -> String -> Int -> Int
obsCountAt minLevel name v = if obsLevel 0 >= minLevel then obsCounter name v else 0

-- | 逐定义 span（规范 §2：**level >= 2** 才有），`args.def` 携带定义名
-- （位置由产物侧 `#line` 承担）：`vuna.def.elab` 等。关闭 / 级别不够时直接 `f 0`
-- （一次 `Lazy.force` + 分支，零额外分配）。
export obsDefCheckAt : Int -> String -> String -> (Int -> Check a) -> Check a
obsDefCheckAt minLevel name def f =
  if obsLevel 0 >= minLevel then @vuna@obs@spanLab name "vuna.def" def (\u => f u) else f 0

-- | 逐定义 span 的常用档位（level >= 2）。
export obsDefCheck : String -> String -> (Int -> Check a) -> Check a
obsDefCheck name def f = obsDefCheckAt 2 name def f

-- | 带分类的 Effect 阶段标记（`Eff r` 边界用；零宽度 instant）。
export obsMarkEff : {r : Row} -> String -> Eff r Int
obsMarkEff name = effPrim (\_ => obsMark name)

-- | `Eff r` 边界上的计数（`ph:"C"`，`args.value`）：用于缓存命中 / 落盘这类
-- 「发生了几次」的归因。关闭时与 `obsMarkEff` 同口径（一次 `Lazy.force` + 分支）。
-- 实参 `v` 由调用方给常量，别传 O(n) 表达式（关闭时也不会跳过实参求值）。
export obsCountEff : {r : Row} -> String -> Int -> Eff r Int
obsCountEff name v = effPrim (\_ => obsCounter name v)
