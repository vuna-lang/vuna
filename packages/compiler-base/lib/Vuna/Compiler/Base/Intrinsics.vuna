-- | 多线程原语（`Base.Thread` 的宿主层）：线程句柄、互斥、条件变量、原子单元。
--
-- 单独成表是为了让每段列表字面量留在 seed 的 fuel 内（同 `floatIntrinsics`）。
-- 每个原语都有可见名（宿主层逃生口）与 `@vuna@` 隐藏别名（base 库使用）。
-- 语义见 docs/reference/primitives.md；OCaml/native 实现，wasm 在 IR 符号层拒绝。
threadIntrinsics : List Intrinsic
threadIntrinsics =
  [
    Intrinsic
      "@vuna@prim_eff_threadSpawn"
      (IPi "a" (IFun (IFun IInt (IVar "a")) (IEff (IThread (IVar "a")))))
      OpNone
      False,
    Intrinsic
      "@vuna@prim_eff_threadJoin"
      (IPi "a" (IFun (IThread (IVar "a")) (IEff (IVar "a"))))
      OpNone
      False,
    Intrinsic "@vuna@prim_eff_threadYield" (IEff IInt) OpNone False,
    Intrinsic "@vuna@prim_eff_threadId" (IEff IInt) OpNone False,
    Intrinsic "@vuna@prim_eff_threadParallelism" (IEff IInt) OpNone False,
    Intrinsic "@vuna@prim_eff_mutexNew" (IEff IMutex) OpNone False,
    Intrinsic "@vuna@prim_eff_mutexLock" (IFun IMutex (IEff IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_mutexTryLock" (IFun IMutex (IEff IBool)) OpNone False,
    Intrinsic "@vuna@prim_eff_mutexUnlock" (IFun IMutex (IEff IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_condvarNew" (IEff ICondvar) OpNone False,
    Intrinsic "@vuna@prim_eff_condvarWait" (IFun ICondvar (IFun IMutex (IEff IInt))) OpNone False,
    Intrinsic "@vuna@prim_eff_condvarSignal" (IFun ICondvar (IEff IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_condvarBroadcast" (IFun ICondvar (IEff IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_atomicNew" (IFun IInt (IEff IAtomic)) OpNone False,
    Intrinsic "@vuna@prim_eff_atomicLoad" (IFun IAtomic (IEff IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_atomicStore" (IFun IAtomic (IFun IInt (IEff IInt))) OpNone False,
    Intrinsic "@vuna@prim_eff_atomicFetchAdd" (IFun IAtomic (IFun IInt (IEff IInt))) OpNone False,
    Intrinsic "@vuna@prim_eff_atomicExchange" (IFun IAtomic (IFun IInt (IEff IInt))) OpNone False,
    Intrinsic
      "@vuna@prim_eff_atomicCompareExchange"
      (IFun IAtomic (IFun IInt (IFun IInt (IEff IInt))))
      OpNone
      False
  ]

-- | 线程原语名（全部隐藏；`Base.Thread` 是唯一用户面入口）。
export threadIntrinsicNames : List String
threadIntrinsicNames = map intrinsicName threadIntrinsics

-- | 文本日志 / 可观测性的隐藏原语（`visible = False`）：只由内置宏 `log!` / `mark!`
-- 展开与 `Base.Data.Log` / 生态库 `Obs` 引用，用户源码不可写。签名在此表；
-- `Elab.Prelude` 会把它们补进 prelude globals（不进用户可见名单），`Core.Eval`
-- 在 interp 里归约为 no-op。
export internalIntrinsics : List Intrinsic
internalIntrinsics =
  append
    [Intrinsic logOnIntrinsicName (IFun IInt (IFun IStr IBool)) OpNone False, Intrinsic logEmitIntrinsicName (IFun IInt (IFun IStr (IFun IStr IInt))) OpNone False, Intrinsic obsLevelIntrinsicName (IFun IInt IInt) OpNone False, Intrinsic obsSpanIntrinsicName (IPi "a" (IFun IStr (IFun IStr (IFun (IFun IInt (IVar "a")) (IVar "a"))))) OpNone False, Intrinsic obsSpanLabIntrinsicName (IPi "a" (IFun IStr (IFun IStr (IFun IStr (IFun (IFun IInt (IVar "a")) (IVar "a")))))) OpNone False, Intrinsic obsCounterIntrinsicName (IFun IStr (IFun IInt IInt)) OpNone False, Intrinsic obsMarkIntrinsicName (IFun IStr IInt) OpNone False, Intrinsic obsSpanBeginIntrinsicName (IFun IStr (IFun IStr IInt)) OpNone False, Intrinsic obsSpanEndIntrinsicName (IFun IInt IInt) OpNone False, Intrinsic obsSampleStartIntrinsicName (IFun IStr (IFun IInt IInt)) OpNone False, Intrinsic obsSampleStopIntrinsicName (IFun IInt IInt) OpNone False]
    (append (filter (\i => not (intrinsicVisible i)) effIntrinsics) (filter (\i => not (intrinsicVisible i)) threadIntrinsics))

-- | 文本日志原语名：codegen 据此按需追加文本日志 runtime（`usesTrace`）。
export logIntrinsicNames : List String
logIntrinsicNames = [logOnIntrinsicName, logEmitIntrinsicName]

-- | 可观测性原语名：codegen 据此按需追加 obs runtime 文本（`usesObs`）。
--
-- `obs` 与 `log` 分开：`log!` 的程序不该为此背上事件缓冲/文件 sink 的代码，反之亦然。
export obsIntrinsicNames : List String
obsIntrinsicNames =
  [
    obsLevelIntrinsicName,
    obsSpanIntrinsicName,
    obsSpanLabIntrinsicName,
    obsCounterIntrinsicName,
    obsMarkIntrinsicName,
    obsSpanBeginIntrinsicName,
    obsSpanEndIntrinsicName,
    obsSampleStartIntrinsicName,
    obsSampleStopIntrinsicName
  ]

-- | 隐藏原语名清单：iface 覆盖性检查把它们视作 prelude 名字（不归属任何模块）。
export internalIntrinsicNames : List String
internalIntrinsicNames = map intrinsicName internalIntrinsics

-- | 所有内建声明：基础表 + 浮点表 + 宿主效应表 + 编译器 tracing 表。
export allIntrinsics : List Intrinsic
allIntrinsics =
  append baseIntrinsics (append floatIntrinsics (append effIntrinsics internalIntrinsics))

-- | 全部与 Float 有关的内建名（字面量/算术/比较/转换/格式化）：核心求值/REPL 的
-- 求值 guard 与 codegen 的按需 runtime helper 都按它判定「程序是否使用浮点」。
export floatIntrinsicNames : List String
floatIntrinsicNames =
  [
    "strFromFloat",
    "floatFromInt",
    "intFromFloat",
    "floatAbs",
    "floatSqrt",
    "bi_add_float",
    "bi_sub_float",
    "bi_mul_float",
    "bi_div_float",
    "bi_eq_float",
    "bi_neq_float",
    "bi_lt_float",
    "bi_le_float",
    "bi_gt_float",
    "bi_ge_float"
  ]

-- | 单线程 fiber 调度器原语（`Base.EffSched`）。它们不占效应行，所以「纯程序」也可能
-- 用到；OCaml 后端据此决定是否追加调度器 runtime。
export schedIntrinsicNames : List String
schedIntrinsicNames =
  [
    "prim_schedNewScope",
    "prim_schedFork",
    "prim_schedYield",
    "prim_schedIsCancelled",
    "prim_schedAwait",
    "prim_schedTaskResult",
    "prim_schedTaskError",
    "prim_schedCancelTask",
    "prim_schedCancelScope",
    "prim_schedScopeWait",
    "prim_schedScopeWaitTimeout",
    "prim_schedScopeError",
    "prim_schedScopeCount"
  ]

-- | 效应机器原语：`perform` / `handle` / `self` 与 bracket 的 cleanup 登记。
-- OCaml 后端据此决定是否追加 `dtEffRuntime`（`Perform` 效应 + `Effect.Deep` 的
-- handler 壳 + cleanup 表）；不碰效应的纯程序因此不带这套 runtime。
export effIntrinsicNames : List String
effIntrinsicNames =
  [
    "prim_effectPerformId",
    "effectId",
    "prim_effectHandleId",
    "prim_effectSelf",
    "prim_cleanupPush",
    "prim_cleanupPop"
  ]

-- | 需要 OCaml `unix.cmxa` 的隐藏原语：宿主文件 / 进程 / 网络 / 时钟 / 线程。
-- 只用于 OCaml 后端决定是否追加 `dtHostRuntime`（以及产物是否链接 `unix.cmxa`）；
-- 多列无害（多链接一个库），少列会让生成程序编译失败。调度器原语不在内：调度器
-- 运行时本身不依赖 Unix。
export hostIntrinsicNames : List String
hostIntrinsicNames =
  append
    ["effTimeUs", "effTimeUs_host", "@vuna@prim_eff_sleep", "@vuna@prim_eff_spawn", "@vuna@prim_eff_wait", "@vuna@prim_eff_runIn", "@vuna@prim_eff_execPath", "@vuna@prim_eff_realPath", "@vuna@host@sleep", "@vuna@host@fileMtime", "@vuna@host@fileSize", "@vuna@host@execPath", "@vuna@host@realPath", "@vuna@host@tryRunIn", "@vuna@host@tryReadFileRange", "@vuna@host@tryReadFile", "@vuna@host@tryWriteFile", "@vuna@host@tryWriteFileAtomic", "@vuna@host@tryReadDir", "@vuna@host@tryIsDirectory", "@vuna@host@tryMakeDir", "@vuna@host@tryRemoveFile", "@vuna@host@tryRemoveTree", "@vuna@host@tryRename", "@vuna@host@trySymlink", "@vuna@host@tryMakeDirExclusive", "@vuna@host@isTty", "@vuna@host@tryNetListen", "@vuna@host@tryNetPort", "@vuna@host@tryNetAccept", "@vuna@host@tryNetRecv", "@vuna@host@tryNetSend", "@vuna@host@tryNetClose", "@vuna@host@tryNetConnect", "@vuna@host@tryNetAcceptWithin", "@vuna@host@tryNetRecvWithin", "@vuna@host@tryNetSendWithin"]
    threadIntrinsicNames

-- | 名字 → 内建声明的查询表（由 `allIntrinsics` 一次性建好，供 `findIntrinsic` 用）。
intrinsicTbl : HashMap String Intrinsic
intrinsicTbl =
  HashMap.insertAll (map (\i => (intrinsicName i, i)) allIntrinsics) (HashMap.fromList [])

-- | 按名字查内建声明（内部用 `HashMap` 表）；内部 `bi_*` 名也能查到。
export findIntrinsic : String -> Maybe Intrinsic
findIntrinsic name = HashMap.lookup name intrinsicTbl

-- | 名字是否是**对用户源码可见**的内建（内部 `bi_*` 返回 `False`）。
export isIntrinsicName : String -> Bool
isIntrinsicName name =
  case findIntrinsic name of
    Just i => intrinsicVisible i
    Nothing => False

-- | 用户可见的内建声明子集（进 Loader / prelude）。
export userIntrinsics : List Intrinsic
userIntrinsics = filter intrinsicVisible allIntrinsics

-- | 用户可见的内建值名字（prelude 全局与「禁止重定义」名单共用）。
export preludeValueNames : List String
preludeValueNames = map intrinsicName userIntrinsics

-- | 效应派发的运行时 id 内建名（源码可见；基库与 IR pass 共用）。
export dispatchIdIntrinsicName : String
dispatchIdIntrinsicName = "effectId"

-- | 字符串 → 派发 id：FNV-1a 32 位，最后取低 30 位。
-- 与 OCaml / native / wasm 三端运行时的实现一致（见 primitives.md）；
-- 取低 30 位是为了让三端 `Int`（OCaml 63 位、wasm 装箱 i64）得到同一个非负值。
export dispatchIdOf : String -> Int
dispatchIdOf s = dispatchIdChars (strUnpack s) 2166136261

dispatchIdChars : List Int -> Int -> Int
dispatchIdChars [] h = bitAnd h 1073741823
dispatchIdChars (c :: rest) h = dispatchIdChars rest (bitAnd ((bitXor h c) * 16777619) 4294967295)
