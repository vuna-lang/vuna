-- | 内建声明的唯一真源：内建/原语的名字、签名形状、interp 归约标签与可见性。
module Vuna.Compiler.Base.Intrinsics where

-- **内建声明的唯一真源**。
--
-- 这里只有目标中立的纯数据：内建/原语的名字、签名形状（IType）、interp 归约标签
-- （IntrinsicOp）、是否对用户源码可见。运行时文本属于后端，见 `Ir.Runtime`（契约）
-- 与 `Target.Ocaml.Runtime`（OCaml 实现）。
-- 消费方：
--   - `Loader.Resolve`：名字解析（arity）、DT prelude 放行；
--   - `Elab.Prelude`：构造 prelude globals（签名）；
--   - `Lowering`：全局名 → IR 运行时符号（契约 `Ir.Runtime`）；
--   - `Core.Eval`：按 IntrinsicOp 归约。
--
-- 身份规则：内置实体按**声明的 symbol**判定，不按短名/lastName：
--   - Int / String 是语言 primitive 类型；动作类型由 base 的 `Base.Effect.Core.Eff` 承载；
--   - Bool / List / Nat 是 base 的普通 data，身份 = 完整限定名
--     `Base.Data.Bool.Bool` / `Base.Data.List.List` / `Base.Data.Nat.Nat`（见 `Loader`/`Codegen` 的常量）；
--   - 隐藏的内部名（`bi_*`）只供 codegen 映射，不对用户源码可见。
import Vuna.Compiler.Base.Common
import Base.Data.String as String
import Base.Container.HashMap as HashMap

-- ---------------------------------------------------------------
-- 签名形状：只表达内建签名需要的形状（不含依赖 pi / 多态细节）
-- ---------------------------------------------------------------
-- | 内建签名形状：只表达内建签名需要的形状（不含依赖 pi / 多态细节）。
export data IType(..) : Type where
  -- 宇宙 `Type`（类型构造子 / 类型变量参数的域）
  ITy : IType
  IInt : IType
  IStr : IType
  IBool : IType
  -- `Base.Data.Nat.Nat`：canonical 归纳族，运行时表示是 OCaml `int`（见 Codegen）。
  INat : IType
  -- `Base.Data.List.List <arg>`：族身份固定为 base 的普通 data 声明
  IList : IType -> IType
  -- `Base.Effect.Core.Eff Base.Effect.Core.Row.Nil arg`：统一动作类型；codegen 包一层 `MkEff`。
  IEff : IType -> IType
  -- `Base.Effect.Core.Eff (Base.Effect.Host.HostOp :: Nil) arg`：宿主原语的类型（会碰外部世界）。
  IEffHost : IType -> IType
  IFun : IType -> IType -> IType
  -- 参数 binder 为 1 的函数（线性 continuation）；只给底层原语用。
  IFun1 : IType -> IType -> IType
  -- 内建类型构造子与签名里的类型变量（必须由外层 `IPi` 绑定；`checkRuntimeContract` 自证）。
  IVar : String -> IType
  IArray : IType -> IType
  -- `@vuna@Cell a`：`Base.Effect.MutRef` 私有的可变单元类型（源码写不出）。
  ICell : IType -> IType
  -- `@vuna@MArray a`：`Base.Effect.MutArray` 私有的定长原地数组类型（源码写不出）。
  IMArray : IType -> IType
  -- `@vuna@MDynArray a`：`Base.Effect.MutDynArray` 私有的可变长容器类型（源码写不出）。
  IMDynArray : IType -> IType
  -- `@vuna@MBuffer`：`Base.Effect.MutBuffer` 私有的变长字节缓冲类型（源码写不出）。
  IMBuffer : IType
  -- 多线程句柄与同步原语的内建类型构造子（`Thread a` / `Mutex` / `Condvar` / `Atomic`）。
  -- IR 运行时类型统一落 `IrTyOpaque`，OCaml runtime helper 用 `Obj.t` 承载。
  IThread : IType -> IType
  IMutex : IType
  ICondvar : IType
  IAtomic : IType
  -- 隐式类型参数绑定（`{a : Type} -> ...`）；不进函数 arity。
  IPi : String -> IType -> IType
  -- `Float` primitive 类型的签名形状（保持已有 tag 顺序；新构造子只追加在它之后）。
  IFloat : IType
  -- `IGlobal` 引用一个全局类型名。
  IGlobal : String -> IType

-- | 签名形状的函数 arity：`IFun`/`IFun1` 各计 1，隐式 `IPi` 不计，其余为 0。
export arityOfType : IType -> Int
arityOfType (IFun _ cod) = 1 + arityOfType cod
arityOfType (IFun1 _ cod) = 1 + arityOfType cod
arityOfType (IPi _ cod) = arityOfType cod
arityOfType _ = 0

-- ---------------------------------------------------------------
-- 内建类型构造子
-- ---------------------------------------------------------------
-- 与 `Int` / `String` 两个 primitive 类型名不同，这些是**带参数的**类型构造子：
-- 名字恒可见（prelude 类型层），codegen 按固定 OCaml 类型渲染（见 Target.Ocaml.Decl）。
-- 参数个数的唯一真源在此；Elab.Prelude 据此生成 kind，Target.Ocaml.Decl 据此渲染。
-- | 内建类型构造子：带参数的类型构造子，名字恒可见，参数个数在此定。
export record TypeIntrinsic(..) where
  -- | 构造子的源码名字（`Array` / `@vuna@Cell` 等）。
  typeIntrinsicCtorName : String
  -- | 类型参数个数。
  typeIntrinsicCtorArity : Int

-- | 内建类型构造子的源码名（`Elab` / `Lowering` 的判定与渲染共用，避免同一字面串多处手写）。
export arrayTypeName : String
arrayTypeName = "Array"

-- | `@vuna@Cell a`：`Base.Effect.MutRef` 私有的可变单元类型（源码写不出）。
export cellTypeName : String
cellTypeName = "@vuna@Cell"

-- | `@vuna@MArray a`：`Base.Effect.MutArray` 私有的定长原地数组类型（源码写不出）。
export marrayTypeName : String
marrayTypeName = "@vuna@MArray"

-- | `@vuna@MDynArray a`：`Base.Effect.MutDynArray` 私有的可变长容器类型（源码写不出）。
export mdynArrayTypeName : String
mdynArrayTypeName = "@vuna@MDynArray"

-- | `@vuna@MBuffer`：`Base.Effect.MutBuffer` 私有的变长字节缓冲类型（源码写不出）。
export mbufferTypeName : String
mbufferTypeName = "@vuna@MBuffer"

-- | 线程句柄 `Thread a`（native / OCaml 多线程运行时）。
export threadTypeName : String
threadTypeName = "Thread"

-- | 互斥锁 `Mutex`。
export mutexTypeName : String
mutexTypeName = "Mutex"

-- | 条件变量 `Condvar`。
export condvarTypeName : String
condvarTypeName = "Condvar"

-- | 原子单元 `Atomic`。
export atomicTypeName : String
atomicTypeName = "Atomic"

-- | 全部内建类型构造子及其 arity（Elab.Prelude 生成 kind、Target.Ocaml.Decl 渲染的唯一真源）。
export typeIntrinsicArities : List TypeIntrinsic
typeIntrinsicArities =
  [
    TypeIntrinsic arrayTypeName 1,
    TypeIntrinsic cellTypeName 1,
    TypeIntrinsic marrayTypeName 1,
    TypeIntrinsic mdynArrayTypeName 1,
    TypeIntrinsic mbufferTypeName 0,
    TypeIntrinsic threadTypeName 1,
    TypeIntrinsic mutexTypeName 0,
    TypeIntrinsic condvarTypeName 0,
    TypeIntrinsic atomicTypeName 0
  ]

-- | 名字对应的内建类型构造子 arity；不是内建类型构造子时返回 `-1`。
export typeIntrinsicArityOf : String -> Int
typeIntrinsicArityOf name = typeIntrinsicArityOfRest name typeIntrinsicArities

-- | `typeIntrinsicArityOf` 的递归实现：在 arity 表里线性找名字。
typeIntrinsicArityOfRest : String -> List TypeIntrinsic -> Int
typeIntrinsicArityOfRest name [] = 0 - 1
typeIntrinsicArityOfRest name (t :: rest) =
  if typeIntrinsicCtorName t == name then
    typeIntrinsicCtorArity t
  else
    typeIntrinsicArityOfRest name rest

-- | 所有内建类型构造子的名字列表（类型位置放行面用）。
export typeIntrinsicCtorNames : List String
typeIntrinsicCtorNames = map typeIntrinsicCtorName typeIntrinsicArities

-- | 运行时「可命名类型头」的唯一真源：primitive 类型 + 内建类型构造子 + 内建效应类型。
-- 其它类型头（类型族 / axiom / 未知全局）在运行时不可命名，按擦除依赖类型处理。
export isTypeConstructorName : String -> Bool
isTypeConstructorName name =
  name
    == intTypeName || name == strTypeName || name == floatTypeName || typeIntrinsicArityOf name >= 0

-- | 内建宿主 handler 的接入方式（entry 预装与后端静态直连的唯一分类）。
export data HostClass(..) : Type where
  -- | 只能由 entry 预装 `runXHost`、走库机器（默认路径）。
  HostHandled : HostClass
  -- | 另有直连路径：`sendCore key … op` 改写成 `runMain (opH op pureK)`（同步宿主叶子）。
  HostDirect : String -> String -> HostClass
  -- | 另有直连收口：`sendCore key … op` 改写成「打印 `text op` 后 exit 1」，不恢复续延。
  HostAbort : String -> String -> HostClass

-- | 内建宿主效应：标签全名 → entry 预装的 handler + 直连分类。
record BuiltinEffect where
  -- | 行标签的全名（base 的 op 族类型）。
  beTag : String
  -- | entry 预装的正常 handler 实现名（空串 = 只允许行、没有 handler）。
  beImpl : String
  -- | 正常 handler 的接入方式。
  beHost : HostClass
  -- | entry 预装的失败收口 handler 实现名（空串 = 该家族没有失败通道）。
  beErrorImpl : String
  -- | 失败收口 handler 的接入方式。
  beErrorHost : HostClass

-- | 全部内建宿主效应（标签 + runXHost + 直连分类）。未实现的条目先占位，entry 只对
-- 已实现的表项自动预装；用户自定义效应仍须自己 handle 成 Nil。
export builtinEffects : List BuiltinEffect
builtinEffects =
  [
    BuiltinEffect
      "Base.Effect.Console.ConsoleOp"
      "Base.Effect.Console.runConsoleHost"
      (HostDirect "console" "Base.Effect.Console.consoleOpHIOHost")
      ""
      HostHandled,
    BuiltinEffect
      "Base.Effect.Fs.FsOp"
      "Base.Effect.Fs.runFsHost"
      (HostDirect "fs" "Base.Effect.Fs.fsOpHIOHost")
      "Base.Effect.Fs.runFsErrorHost"
      (HostAbort "fs-error" "Base.Effect.Fs.fsErrorText"),
    BuiltinEffect
      "Base.Effect.Clock.ClockOp"
      "Base.Effect.Clock.runClockHost"
      (HostDirect "clock" "Base.Effect.Clock.clockOpHIOHost")
      ""
      HostHandled,
    BuiltinEffect
      "Base.Effect.Env.EnvOp"
      "Base.Effect.Env.runEnvHost"
      (HostDirect "env" "Base.Effect.Env.envOpHIOHost")
      ""
      HostHandled,
    BuiltinEffect
      "Base.Effect.Process.ProcessOp"
      "Base.Effect.Process.runProcessHost"
      HostHandled
      "Base.Effect.Process.runProcessErrorHost"
      HostHandled,
    BuiltinEffect
      "Base.Effect.Exit.ExitOp"
      "Base.Effect.Exit.runExitHost"
      (HostDirect "exit" "Base.Effect.Exit.exitOpHIOHost")
      ""
      HostHandled,
    BuiltinEffect
      "Base.Effect.Stdin.StdinOp"
      "Base.Effect.Stdin.runStdinHost"
      (HostDirect "stdin" "Base.Effect.Stdin.stdinOpHIOHost")
      ""
      HostHandled,
    BuiltinEffect
      "Base.Effect.Args.ArgsOp"
      "Base.Effect.Args.runArgsHost"
      (HostDirect "args" "Base.Effect.Args.argsOpHIOHost")
      ""
      HostHandled,
    BuiltinEffect "Base.Effect.Tty.TtyOp" "Base.Effect.Tty.runTtyHost" HostHandled "" HostHandled,
    BuiltinEffect
      "Base.Effect.Net.NetOp"
      "Base.Effect.Net.runNetHost"
      HostHandled
      "Base.Effect.Net.runNetErrorHost"
      HostHandled
  ]

-- | 标签对应的 `runXHost` 实现名；不是内建宿主效应时返回空串。
export builtinEffectImplOf : String -> String
builtinEffectImplOf tag = builtinEffectImplOfRest tag builtinEffects

builtinEffectImplOfRest : String -> List BuiltinEffect -> String
builtinEffectImplOfRest tag [] = ""
builtinEffectImplOfRest tag (e :: rest) =
  if e.beTag == tag then e.beImpl else builtinEffectImplOfRest tag rest

-- | 标签对应的失败收口 handler；该家族没有失败通道时返回空串。
export builtinEffectErrorRunHostOf : String -> String
builtinEffectErrorRunHostOf tag = builtinEffectErrorRunHostOfRest tag builtinEffects

builtinEffectErrorRunHostOfRest : String -> List BuiltinEffect -> String
builtinEffectErrorRunHostOfRest tag [] = ""
builtinEffectErrorRunHostOfRest tag (e :: rest) =
  if e.beTag == tag then e.beErrorImpl else builtinEffectErrorRunHostOfRest tag rest

-- | entry 预装项（`runXHost` / `runXErrorHost`）的接入方式；不认识的实现名返回 Nothing。
export hostClassOf : String -> Maybe HostClass
hostClassOf name = hostClassOfRest name builtinEffects

hostClassOfRest : String -> List BuiltinEffect -> Maybe HostClass
hostClassOfRest name [] = Nothing
hostClassOfRest name (e :: rest) =
  if name == e.beImpl && e.beImpl /= "" then
    Just e.beHost
  else if name == e.beErrorImpl && e.beErrorImpl /= "" then
    Just e.beErrorHost
  else
    hostClassOfRest name rest

-- | `sendCore` 的 key → 直连方式（`HostDirect` / `HostAbort` 都带 key；正常与失败收口
--   两列都查）。
export hostClassOfSendKey : String -> Maybe HostClass
hostClassOfSendKey key = hostClassOfSendKeyRest key builtinEffects

hostClassOfSendKeyRest : String -> List BuiltinEffect -> Maybe HostClass
hostClassOfSendKeyRest key [] = Nothing
hostClassOfSendKeyRest key (e :: rest) =
  case directClassForKey key e.beHost of
    Just c => Just c
    Nothing =>
      case directClassForKey key e.beErrorHost of
        Just c => Just c
        Nothing => hostClassOfSendKeyRest key rest

directClassForKey : String -> HostClass -> Maybe HostClass
directClassForKey key (c@(HostDirect k _)) = if k == key then Just c else Nothing
directClassForKey key (c@(HostAbort k _)) = if k == key then Just c else Nothing
directClassForKey key HostHandled = Nothing

-- | 该标签是否是内建宿主效应（`beImpl` 为空表示只允许行、无需预装 handler）。
export isBuiltinEffectTag : String -> Bool
isBuiltinEffectTag tag = builtinEffectExistsRest tag builtinEffects

builtinEffectExistsRest : String -> List BuiltinEffect -> Bool
builtinEffectExistsRest tag [] = False
builtinEffectExistsRest tag (e :: rest) =
  if e.beTag == tag then True else builtinEffectExistsRest tag rest

-- ---------------------------------------------------------------
-- 内建宿主能力矩阵：标签 × 后端
-- ---------------------------------------------------------------
-- | 三个产品后端（`build --target` 的取值）。
export hostTargetNames : List String
hostTargetNames = ["ocaml", "native", "wasm"]

-- | 内建宿主标签在某个后端上的实现程度。
--
-- `full` = 标签下全部 op 都有宿主实现；`partial` = 至少一条 op 缺实现；
-- `none` = 该后端没有这个家族的宿主实现。未知标签 / 未知后端一律 `none`。
--
-- 证据（改表时必须同步核对）：
--   * native：`Target.Native.Runtime.hostLeafGroups` 覆盖 fs / clock / process / env /
--     args / exit，没有 stdin / net；
--   * wasm：只有 console / 相对 FS（preopen）/ env / args / exit / clock.Now；`ProcessOp`、
--     `StdinOp`、`NetOp` 没有宿主实现，`FsOp` 缺 symlink、`mtime` 恒 `Nothing`，
--     `ClockOp` 缺 `SleepMicros`，`EnvOp` 的 execPath 恒空（常量，不算缺 op）。
export hostSupportOf : String -> String -> String
hostSupportOf target tag = pickHostSupport target (findHostSupport tag hostSupportTable)

-- | 某个后端上不可依赖（非 `full`）的标签子集，保持输入顺序（含 `partial`）。
export unsupportedHostTags : String -> List String -> List String
unsupportedHostTags target tags = filter (\t => hostSupportOf target t /= "full") tags

record HostSupport where
  hsTag : String
  hsOcaml : String
  hsNative : String
  hsWasm : String

unknownHostSupport : HostSupport
unknownHostSupport = HostSupport "" "none" "none" "none"

-- | 标签 → 三端实现程度。`partial` 的具体缺项写在 `hostSupportOf` 的注释里。
hostSupportTable : List HostSupport
hostSupportTable =
  [
    HostSupport "Base.Effect.Console.ConsoleOp" "full" "full" "full",
    HostSupport "Base.Effect.Fs.FsOp" "full" "full" "partial",
    HostSupport "Base.Effect.Clock.ClockOp" "full" "full" "partial",
    HostSupport "Base.Effect.Env.EnvOp" "full" "full" "full",
    HostSupport "Base.Effect.Process.ProcessOp" "full" "full" "none",
    HostSupport "Base.Effect.Exit.ExitOp" "full" "full" "full",
    HostSupport "Base.Effect.Stdin.StdinOp" "full" "none" "none",
    HostSupport "Base.Effect.Args.ArgsOp" "full" "full" "full",
    HostSupport "Base.Effect.Net.NetOp" "full" "none" "none",
    HostSupport "Base.Effect.Tty.TtyOp" "full" "full" "full"
  ]

findHostSupport : String -> List HostSupport -> HostSupport
findHostSupport tag [] = unknownHostSupport
findHostSupport tag (s :: rest) = if s.hsTag == tag then s else findHostSupport tag rest

pickHostSupport : String -> HostSupport -> String
pickHostSupport "ocaml" s = s.hsOcaml
pickHostSupport "native" s = s.hsNative
pickHostSupport "wasm" s = s.hsWasm
pickHostSupport _ s = "none"

-- | `sendCore` 的两种名字：派发前的源码形与派发 pass 之后的 `*Id` 形；后端的静态
-- 直连改写必须同时认（`isSendCoreName`）。
export effSendCoreName : String
effSendCoreName = "Base.Effect.Core.sendCore"

export effSendCoreIdName : String
effSendCoreIdName = "Base.Effect.Core.sendCoreId"

-- | 是否是 `sendCore` 入口（两种名字）。
export isSendCoreName : String -> Bool
isSendCoreName name = name == effSendCoreName || name == effSendCoreIdName

-- | `perform` 降级的目标：`Base.Effect.Core.performCore`。
export effPerformCoreName : String
effPerformCoreName = "Base.Effect.Core.performCore"

-- | handle 的效应签名包装：`Base.Effect.Core.sigFn`。
export effSigFnName : String
effSigFnName = "Base.Effect.Core.sigFn"

-- | handle 降级的目标（rowRem 版）：`Base.Effect.Core.handleWith`。
export effHandleWithName : String
effHandleWithName = "Base.Effect.Core.handleWith"

-- | handle 降级的目标（行首条目版）：`Base.Effect.Core.handleWithAt`。
export effHandleWithAtName : String
effHandleWithAtName = "Base.Effect.Core.handleWithAt"

-- | 行扩展入口：`Base.Effect.Core.weaken`（运行时恒等，只改类型）。
export effWeakenName : String
effWeakenName = "Base.Effect.Core.weaken"

-- | 行内操作执行入口：`Base.Effect.Core.raise`。
export effRaiseName : String
effRaiseName = "Base.Effect.Core.raise"

-- | Eff 版线性绑定（当前无库调用方）：`Eff [] a` 的线性 continuation。
-- runtime 由 codegen 专门生成（装箱 `MkEff` 的 match），不能复用 eager 包装。
export primEffBind1Name : String
primEffBind1Name = "@vuna@prim_eff_bind1"

-- | 表现层 cast：精化器在「运行时位置出现不可命名的擦除依赖类型」时插入
-- （见 docs/reference/effects.md §5/§6）。隐藏 intrinsic：只供精化器引用，
-- 不对用户源码可见；求值期由 `IntrinsicOp.OpIdentity` 归约成参数本身。
export primEraseName : String
primEraseName = "prim_erase"

-- | 非内建 `main` 类型的 Show 展示定义名：Elab 收尾合成
-- `@vuna@main_show : T -> String`，codegen 的 main 钩子与 interp 的 main 展示按它取用；
-- 名字里的 `@` 不在用户标识符语法里，不会与用户定义冲突。
export mainShowDefName : String
mainShowDefName = "@vuna@main_show"

-- | 关闭动作入口（`Base.Effect.Core.runPure : Eff [] a -> a`）的 canonical 名（协议常量）。
export effRunName : String
effRunName = "Base.Effect.Core.runPure"

-- | main 入口的隐藏执行名（`Base.Effect.Core.runMain`，未导出）：codegen 的 main 钩子引用它，
-- 用于执行带内建宿主效应行的 `main`（`runPure` 只收 Nil）。
export effMainRunName : String
effMainRunName = "Base.Effect.Core.runMain"

-- ---------------------------------------------------------------
-- 调试构造：语言级 debug 名字
-- ---------------------------------------------------------------
-- 这些是**编译器内建的调试构造**，不是库函数、不需要 import：
--   * `assert cond "msg" x`：debug-only；失败走 failwith（main 钩子渲染），release
--     构建由 `Loader.Resolve` 拒绝；
--   * `todo "msg"`：debug-only 的未实现占位，语义同 assert(False, msg)。
-- 用户面调试输出统一走内置宏 `log!`（见 `docs/reference/logging.md`）；`DebugShow` 在
-- `Base.Trait.Show`、`dbgShow` 在 `Base.Data.Log`（基于 `log! "debug"` 的库层）。
-- ---------------------------------------------------------------
-- ---------------------------------------------------------------
-- 文本日志（`log!`）隐藏原语
-- ---------------------------------------------------------------
-- 规范见 `docs/reference/logging.md`。`log!` 只由 `Loader.Expand` 展开时引用：名字以
-- `@vuna@` 开头 ⇒ `Loader.Resolve` 直通、`Elab.Prelude` 只补签名、`Core.Eval` 归约成
-- 静默、`Ir.Runtime` 契约 + 三后端表 + `Target.Ocaml.Term` 运行时文本四处对齐。
--
-- 门控与 scope 都走 `on`：scope 被 `VUNA_LOG_SCOPE` 过滤掉时，消息实参不求值
-- （宏展开成 `if on level scope then emit level scope msg else 0`）。
-- | `log!` 的开关查询（级别 + 模块 scope）。
export logOnIntrinsicName : String
logOnIntrinsicName = "@vuna@log@on"

-- | `log!` 的发射（级别、模块 scope、文本；返回 0）。
export logEmitIntrinsicName : String
logEmitIntrinsicName = "@vuna@log@emit"

-- ---------------------------------------------------------------
-- 可观测性（`obs`）隐藏原语
-- ---------------------------------------------------------------
-- 规范见 `docs/reference/observability.md`。与文本日志同一策略：`@vuna@` 前缀 ⇒
-- `Loader.Resolve` 直通、`Elab.Prelude` 只补签名（用户源码写不出来）、`Core.Eval`
-- 归约成 no-op、`Ir.Runtime` 契约 + `Target.Ocaml.Runtime` 表 + `Target.Ocaml.Term` 运行时文本
-- 三处对齐（漏一处 `checkRuntimeContract` 直接报内部错）。
--
-- **所有原语返回 `Int`**（信息量靠 `0` 承载）：这样纯核心的深部探针不需要把签名
-- effect 化（debt D68），关闭时也只是 `Lazy.force` + 返回 0。
-- `span` 是唯一高阶原语：`name -> cat -> (Int -> a) -> a`，关闭时直接 `f 0`。
-- | 当前观测级别（`0`..`3`；哑 `Int` 实参承载开关查询）。
export obsLevelIntrinsicName : String
obsLevelIntrinsicName = "@vuna@obs@level"

-- | 高阶跨度原语：`name -> cat -> (Int -> a) -> a`。
export obsSpanIntrinsicName : String
obsSpanIntrinsicName = "@vuna@obs@span"

-- | 带 label 的高阶跨度原语：`name -> cat -> label -> (Int -> a) -> a`。
--
-- 与 `obsSpan` **并列**而不是改它的 arity：`name` 只能用事件词汇表里的 `vuna.*`，
-- 逐定义 span 需要把定义名放进 `args.def`（规范 §3.2），label 就是这个位置。
export obsSpanLabIntrinsicName : String
obsSpanLabIntrinsicName = "@vuna@obs@spanLab"

-- | 计数器事件（`args.value`）。
export obsCounterIntrinsicName : String
obsCounterIntrinsicName = "@vuna@obs@counter"

-- | 瞬时标记事件（`ph:"i"`）。
export obsMarkIntrinsicName : String
obsMarkIntrinsicName = "@vuna@obs@mark"

-- | `Eff` 跨度开始：`name -> cat -> token`。
export obsSpanBeginIntrinsicName : String
obsSpanBeginIntrinsicName = "@vuna@obs@spanBegin"

-- | `Eff` 跨度结束：`token -> 0`。
export obsSpanEndIntrinsicName : String
obsSpanEndIntrinsicName = "@vuna@obs@spanEnd"

-- | 开始采样：`"cpu"|"mem"|"both" -> 间隔(us) -> 0`。
export obsSampleStartIntrinsicName : String
obsSampleStartIntrinsicName = "@vuna@obs@sampleStart"

-- | 停止采样并 flush：`Int -> 0`。
export obsSampleStopIntrinsicName : String
obsSampleStopIntrinsicName = "@vuna@obs@sampleStop"

-- | `assert`：debug-only 断言（release 构建拒绝）。
export assertIntrinsicName : String
assertIntrinsicName = "assert"

-- | `todo`：debug-only 未实现占位（release 构建拒绝）。
export todoIntrinsicName : String
todoIntrinsicName = "todo"

-- | 是否是 release 构建要拒绝的 debug-only 构造名（assert / todo）。
export isDebugOnlyName : String -> Bool
isDebugOnlyName name = name == assertIntrinsicName || name == todoIntrinsicName

-- ---------------------------------------------------------------
-- 效果协议：库层效应编码的 canonical 身份
-- ---------------------------------------------------------------
-- 通用效应系统把行/成员证明/行删除编码在 `vuna-base` 的数据里；编译器
-- 按**这些全名**识别该编码（不是内建：base 是唯一真源，名字集中在此处，不再散落）。
-- 消费方：`Core/Eval.rowRemReduce`（行删除归约）、`Elab/Dict`（行成员证明构造）。
-- 形状：`Row : Type 1`（`Nil` / `(::)`；二元行的标签可包 `Named`），
-- `Member` 3 索引（实例名、标签、行）或 2 索引（标签、行），
-- `rowRem : Type -> Row -> Row`（axiom，由编译器按标签值结构相等归约）。
-- | 效应行族 `Base.Effect.Core.Row`（Type-1 数据）。
export effRowFamilyName : String
effRowFamilyName = "Base.Effect.Core.Row"

-- | 空行构造子 `Base.Effect.Core.Row.Nil`。
export effRowNilCtor : String
effRowNilCtor = "Base.Effect.Core.Row.Nil"

-- | 行扩展构造子 `Base.Effect.Core.Row.(::)`（标签 + 尾行）。
export effRowConsCtor : String
effRowConsCtor = "Base.Effect.Core.Row.::"

-- | 命名标签 `Base.Effect.Core.Named`（二元行）：`Named n e` 把实例名并进标签类型。
export effNamedName : String
effNamedName = "Base.Effect.Core.Named"

-- | 行删除 `Base.Effect.Core.rowRem`（axiom，由编译器归约）。
export effRowRemName : String
effRowRemName = "Base.Effect.Core.rowRem"

-- | 行拼接 `Base.Effect.Core.rowAppend`（axiom，由编译器归约：Nil 单位 + `::` 递归）。
export effRowAppendName : String
effRowAppendName = "Base.Effect.Core.rowAppend"

-- | 行成员证明族 `Base.Effect.Core.Member`（Type-1 归纳族）。
export effMemberFamilyName : String
effMemberFamilyName = "Base.Effect.Core.Member"

-- | 行成员证明构造子 `Base.Effect.Core.Member.Here`（头部命中）。
export effMemberHereCtor : String
effMemberHereCtor = "Base.Effect.Core.Member.Here"

-- | 行成员证明构造子 `Base.Effect.Core.Member.There`（跳过头部）。
export effMemberThereCtor : String
effMemberThereCtor = "Base.Effect.Core.Member.There"

-- | 效应动作类型 `Base.Effect.Core.Eff`（`Eff : Row -> Type -> Type`，用户面效果类型）。
export effTypeName : String
effTypeName = "Base.Effect.Core.Eff"

-- | 宿主行标记 `Base.Effect.Host.HostOp`：出现在行里表示可能碰外部世界；
-- 宿主原语类型固定为 `Eff (HostOp :: Nil) a`，`rowRem` 不对它归约。
export effHostOpName : String
effHostOpName = "Base.Effect.Host.HostOp"

-- | `Base.Effect.Core.EffUnit`：Eff 的 dummy thunk 参数类型（codegen 包 `MkEff` 时用作
-- `fun (_ : EffUnit) -> ...` 的标注；不进求值语义）。
export effUnitTypeName : String
effUnitTypeName = "Base.Effect.Core.EffUnit"

-- | `Base.Effect.Core.Eff.MkEff`：Eff 的唯一构造子（codegen 构造宿主原语动作时引用）。
export effMkCtor : String
effMkCtor = "Base.Effect.Core.Eff.MkEff"

-- | 默认实例名：裸标签条目 `Named "default" e :: Nil` 与 `handleWithAt` 共用；
-- 单点定义在 `Base.Effect.Core.defaultInstance`，此处是编译器侧的镜像常量。
export effDefaultInstance : String
effDefaultInstance = "default"

-- | prelude 类型层名字：primitive 类型 + 内建类型构造子（禁止重定义 + Loader 放行）。
export preludeTypeNames : List String
preludeTypeNames = append typeIntrinsicNames typeIntrinsicCtorNames

-- ---------------------------------------------------------------
-- interp 归约标签（Core.Eval 按它归约；OpNone = 不在 interp 归约）
-- ---------------------------------------------------------------
-- | interp 归约标签（`Core.Eval` 按它归约；`OpNone` = 不在 interp 归约）。
export data IntrinsicOp(..) : Type where
  OpNone : IntrinsicOp
  OpAdd : IntrinsicOp
  OpSub : IntrinsicOp
  OpMul : IntrinsicOp
  OpDiv : IntrinsicOp
  OpEqInt : IntrinsicOp
  OpNeqInt : IntrinsicOp
  OpLtInt : IntrinsicOp
  OpLeInt : IntrinsicOp
  OpGtInt : IntrinsicOp
  OpGeInt : IntrinsicOp
  OpEqStr : IntrinsicOp
  OpNeqStr : IntrinsicOp
  -- 值级比较：`String` / `Bool` 的特化共用（interp 按运行时值类型分派）。
  OpLtValue : IntrinsicOp
  OpLeValue : IntrinsicOp
  OpGtValue : IntrinsicOp
  OpGeValue : IntrinsicOp
  OpConcat : IntrinsicOp
  OpAnd : IntrinsicOp
  OpOr : IntrinsicOp
  OpStrFromInt : IntrinsicOp
  OpStrLength : IntrinsicOp
  OpStrUnpack : IntrinsicOp
  OpStrPack : IntrinsicOp
  OpStrConcatMany : IntrinsicOp
  OpStrSubstTemplate : IntrinsicOp
  OpStrHash : IntrinsicOp
  OpStrDispatchId : IntrinsicOp
  OpStrAt : IntrinsicOp
  OpStrSubstring : IntrinsicOp
  OpStrShow : IntrinsicOp
  -- Nat 的纯原语：饱和/截断语义与生成 runtime 的 bi_nat* 一致。
  OpNatAdd : IntrinsicOp
  OpNatSub : IntrinsicOp
  OpNatMul : IntrinsicOp
  OpNatDiv : IntrinsicOp
  OpNatToInt : IntrinsicOp
  OpNatFromInt : IntrinsicOp
  -- Float 的纯原语（IEEE-754 double；与编译产物的 OCaml 运算符同语义）。
  OpAddF : IntrinsicOp
  OpSubF : IntrinsicOp
  OpMulF : IntrinsicOp
  OpDivF : IntrinsicOp
  OpEqF : IntrinsicOp
  OpNeqF : IntrinsicOp
  OpLtF : IntrinsicOp
  OpLeF : IntrinsicOp
  OpGtF : IntrinsicOp
  OpGeF : IntrinsicOp
  OpFloatAbs : IntrinsicOp
  OpFloatSqrt : IntrinsicOp
  OpStrFromFloat : IntrinsicOp
  OpFloatFromInt : IntrinsicOp
  OpIntFromFloat : IntrinsicOp
  -- 表现层 cast（`prim_erase`）：运行时不产生任何操作，归约成唯一实参本身。
  -- interp / 定义性相等都必须看穿它（否则 cast 会改变归约结果）。
  OpIdentity : IntrinsicOp
  -- 位运算：Int 的 **63-bit 二进制补码**语义（与宿主 OCaml int 一致，是语言契约而
  -- 不是实现细节；wasm 后端需按 63-bit 模拟）。移位计数 `n < 0 || n >= 63` 时结果为 0。
  -- 内容寻址依赖它们跨后端逐字节一致，因此宽度必须固定。
  OpBitAnd : IntrinsicOp
  OpBitOr : IntrinsicOp
  OpBitXor : IntrinsicOp
  OpBitNot : IntrinsicOp
  OpBitShl : IntrinsicOp
  OpBitShr : IntrinsicOp

-- ---------------------------------------------------------------
-- 内建声明
-- ---------------------------------------------------------------
--
-- 字段：名字、签名形状、interp 归约标签、是否对用户源码可见。
-- 运行时文本（OCaml 表达式）不在本模块：它是后端的实现细节，住在
-- `Target.Ocaml.Runtime`；本模块只声明目标中立的语义（名字/签名/arity/归约/可见性）。
-- | 内建声明：名字、签名形状、interp 归约标签、可见性。
export record Intrinsic where
  -- | 内建的源码名字（如 `+`、`strFromInt`）。
  intrinsicName : String
  -- | 签名形状（`IType`）。
  intrinsicSignature : IType
  -- | interp 归约标签。
  intrinsicOp : IntrinsicOp
  -- | 是否对用户源码可见（`False` = 只供 codegen 映射的内部名 `bi_*`）。
  intrinsicVisible : Bool

-- | canonical 族（base 的 data 声明）必须由 vuna-base 以固定的构造子集合声明；
-- 其它同名声明是非法伪造。
export canonicalCtorsFor : String -> Maybe (List String)
canonicalCtorsFor name =
  case findCanonicalFamily name of
    Just f => Just (cfCtors f)
    Nothing => Nothing

-- | 内建的函数 arity（按 `arityOfType (intrinsicSignature i)` 计算）。
export intrinsicArity : Intrinsic -> Int
intrinsicArity i = arityOfType (intrinsicSignature i)

-- thunk 模式是 `fun args -> fun _ -> rt args`：
-- 零参原语因此是真正的值而不是每次求值的表达式。
-- | 该内建是否返回 Eff 动作（`IEff` 在签名尾部）。
export intrinsicReturnsEff : Intrinsic -> Bool
intrinsicReturnsEff i = typeReturnsEff (intrinsicSignature i)

-- | `IType` 尾部是否为 `IEff` / `IEffHost`（供 codegen 包 `MkEff`）。
typeReturnsEff : IType -> Bool
typeReturnsEff (IEff _) = True
typeReturnsEff (IEffHost _) = True
typeReturnsEff (IFun _ cod) = typeReturnsEff cod
typeReturnsEff (IFun1 _ cod) = typeReturnsEff cod
typeReturnsEff (IPi _ cod) = typeReturnsEff cod
typeReturnsEff _ = False

-- | 语言 primitive 类型名（Bool 不在其中：它是 base 的普通 data 声明）。
export typeIntrinsicNames : List String
typeIntrinsicNames = [intTypeName, strTypeName, floatTypeName]

-- | `Int` primitive 类型的源码名字。
export intTypeName : String
intTypeName = "Int"

-- | `String` primitive 类型的源码名字。
export strTypeName : String
strTypeName = "String"

-- | `Float` primitive 类型的源码名字（运行时是 OCaml IEEE-754 double，无 data 声明）。
export floatTypeName : String
floatTypeName = "Float"

-- | Bool 的完整符号身份：它是 base 里的普通 data 声明，身份 = `Base.Data.Bool.Bool`。
export boolTypeName : String
boolTypeName = "Base.Data.Bool.Bool"

-- | canonical `True` 构造子的完整符号。
export boolTrueCtor : String
boolTrueCtor = "Base.Data.Bool.Bool.True"

-- | canonical `False` 构造子的完整符号。
export boolFalseCtor : String
boolFalseCtor = "Base.Data.Bool.Bool.False"

-- | Nat 的完整符号身份（`Base.Data.Nat.Nat`）；运行时表示固定为 OCaml `int`
-- （Zero=0、Succ n=n+1 饱和），所以**不生成**变体类型（见 Target.Ocaml.Decl）。
export natTypeName : String
natTypeName = "Base.Data.Nat.Nat"

-- | canonical `Zero` 构造子的完整符号。
export natZeroCtor : String
natZeroCtor = "Base.Data.Nat.Nat.Zero"

-- | canonical `Succ` 构造子的完整符号。
export natSuccCtor : String
natSuccCtor = "Base.Data.Nat.Nat.Succ"

-- | Fin 的完整符号身份（`Base.Data.Fin.Fin`）；和 Nat 一样运行时表示固定为
-- OCaml `int`（FZero=0、FSucc n=n+1 饱和），所以**不生成**变体类型。
export finTypeName : String
finTypeName = "Base.Data.Fin.Fin"

-- | canonical `FZero` 构造子的完整符号。
export finZeroCtor : String
finZeroCtor = "Base.Data.Fin.Fin.FZero"

-- | canonical `FSucc` 构造子的完整符号。
export finSuccCtor : String
finSuccCtor = "Base.Data.Fin.Fin.FSucc"

-- | `finToNat`（`Fin n -> Nat`）：Fin 已是 int，运行时就是恒等。
export finToNatName : String
finToNatName = "Base.Data.Fin.finToNat"

-- | 类型位置的放行面：primitive 类型名 + 内建类型构造子。
export isIntrinsicTypeName : String -> Bool
isIntrinsicTypeName name = memName name preludeTypeNames

-- | List 的完整符号身份（base 里普通 data 声明，不是短名）：List 的判定只认它。
export listFamilyName : String
listFamilyName = "Base.Data.List.List"

-- | canonical `Nil` 构造子的完整符号。
export listNilCtor : String
listNilCtor = "Base.Data.List.List.Nil"

-- | canonical cons 构造子（`::`）的完整符号。
export listConsCtor : String
listConsCtor = "Base.Data.List.List.::"

-- | 记录字段标签族（`Base.Trait.Field.Field : String -> Type`）的完整符号。
export hasFieldLabelName : String
hasFieldLabelName = "Base.Trait.Field.Field"

-- | `HasField` trait 的完整符号：自动生成的记录字段实例挂在这个 trait 下。
export hasFieldTraitName : String
hasFieldTraitName = "Base.Trait.Record.HasField"

-- | `HasField` 方法 / 投影的完整符号。
export hasFieldGetFieldName : String
hasFieldGetFieldName = "Base.Trait.Record.getField"

-- | `HasField` 方法的短名（实例声明的 `DFun` 用）。
export hasFieldMethodName : String
hasFieldMethodName = "getField"

-- ---------------------------------------------------------------
-- canonical 族表
-- ---------------------------------------------------------------
-- | canonical 族的运行时表示类别（目标中立；具体 IR 类型由 codegen 映射）。
export data FamilyRepr(..) : Type where
  -- | OCaml `bool` / IR `IrTyBool`：不生成变体声明。
  FamReprBool : FamilyRepr
  -- | OCaml `int` / IR `IrTyInt`：`Zero` = 0、`Succ n` = `n + 1` 饱和；不生成变体声明。
  FamReprNat : FamilyRepr
  -- | 普通 data：按声明的构造子布局。
  FamReprBoxed : FamilyRepr

-- | 一个 canonical 族：完整符号、固定构造子、运行时表示类别。
export record CanonicalFamily where
  cfName : String
  cfCtors : List String
  cfRepr : FamilyRepr

-- | canonical 族表：身份、构造子与表示的唯一真源；新增族只改这里。
export canonicalFamilies : List CanonicalFamily
canonicalFamilies =
  [
    CanonicalFamily boolTypeName [boolTrueCtor, boolFalseCtor] FamReprBool,
    CanonicalFamily natTypeName [natZeroCtor, natSuccCtor] FamReprNat,
    CanonicalFamily finTypeName [finZeroCtor, finSuccCtor] FamReprNat,
    CanonicalFamily listFamilyName [listNilCtor, listConsCtor] FamReprBoxed
  ]

-- | 按完整符号查 canonical 族。
export findCanonicalFamily : String -> Maybe CanonicalFamily
findCanonicalFamily name = findCanonicalFamilyGo name canonicalFamilies

findCanonicalFamilyGo : String -> List CanonicalFamily -> Maybe CanonicalFamily
findCanonicalFamilyGo name [] = Nothing
findCanonicalFamilyGo name (f :: rest) =
  if cfName f == name then Just f else findCanonicalFamilyGo name rest

-- | 该族的运行时表示类别；非 canonical 族为 `Nothing`。
export canonicalReprOf : String -> Maybe FamilyRepr
canonicalReprOf name =
  case findCanonicalFamily name of
    Just f => Just (cfRepr f)
    Nothing => Nothing

-- | 运行时表示不是普通 data 变体的 canonical 族（当前为 Bool / Nat）。
export isUnboxedCanonical : String -> Bool
isUnboxedCanonical name =
  case canonicalReprOf name of
    Just FamReprBoxed => False
    Just _ => True
    Nothing => False

-- | 该名字是否为 canonical Bool 族。
export isBoolCanonical : String -> Bool
isBoolCanonical name =
  case canonicalReprOf name of
    Just FamReprBool => True
    _ => False

-- | 比较运算符可特化的类型名：其它类型的 `<` / `<=` / `>` / `>=` 走 `Ord` 字典。
export cmpSpecializedTyNames : List String
cmpSpecializedTyNames = [intTypeName, strTypeName, floatTypeName, boolTypeName]

-- | 受限 FFI 允许的标量类型（`extern` 的参数 / 结果 / `Array` 元素）。
export ffiScalarNames : List String
ffiScalarNames = [intTypeName, strTypeName, boolTypeName]

-- | 该类型名是否是 FFI 允许的标量。
export isFfiScalarName : String -> Bool
isFfiScalarName name = memName name ffiScalarNames

-- | 模板字符串插值的 trait 的 canonical 名。编译器把 `${e}` 降级成对
-- `interp` 方法投影的调用（`Loader.Resolve`），转换语义完全由 base 里的实例决定。
export interpTypeName : String
interpTypeName = "Base.Trait.Interp.Interp"

-- | 模板插值 trait 的 `interp` 方法的 canonical 名。
export interpMethodName : String
interpMethodName = "Base.Trait.Interp.interp"

-- | 字面量转换：`FromString` trait 的 canonical 名（checking 位置的字符串字面量按
-- 期望类型降级时用；声明在 base 的 `Base.Trait.FromString`）。
export fromStringTypeName : String
fromStringTypeName = "Base.Trait.FromString.FromString"

-- | `FromString` 的方法投影 canonical 名。
export fromStringMethodName : String
fromStringMethodName = "Base.Trait.FromString.fromString"

-- | 字面量转换：`FromInt` trait 的 canonical 名（声明在 base 的 `Base.Trait.FromInt`）。
export fromIntTypeName : String
fromIntTypeName = "Base.Trait.FromInt.FromInt"

-- | `FromInt` 的方法投影 canonical 名。
export fromIntMethodName : String
fromIntMethodName = "Base.Trait.FromInt.fromInt"

-- | 字面量转换：`FromFloat` trait 的 canonical 名（声明在 base 的 `Base.Data.Float`）。
export fromFloatTypeName : String
fromFloatTypeName = "Base.Data.Float.FromFloat"

-- | `FromFloat` 的方法投影 canonical 名。
export fromFloatMethodName : String
fromFloatMethodName = "Base.Data.Float.fromFloat"

-- | 所有内建声明（基础表；浮点表另立，见 `floatIntrinsics`）。用户可见项进 Loader/prelude；
-- 内部 `bi_*` 只服务 codegen。分成两张表是为了让每段列表字面量的项大小留在
-- seed 擦除检查的 fuel 内（bootstrap 约束，见 docs/reference/bootstrap.md）。
baseIntrinsics : List Intrinsic
-- 效果原语（`prim_*` 名；任何包可直接使用，推荐经 `Base.Effect.Core` 标签 + handler）。
-- 精化器合成的比较/相等特化名（内部：不对用户源码可见）。
-- 内建类型构造子 Array 的原语（纯函数，不触碰外部世界）。
-- 空数组字面量：non-expansive 的 OCaml `[||]`，让 `HashMap` 的空表这类零参多态值可泛化。
-- 字节切片（clamp 语义与 Base.Data.String.substring 一致），避免 List 桥接。
-- 编译器内部缓存原语（Marshal 纯数据；含闭包会在运行期失败）。
-- 异步子进程（workspace 并行 check）。spawn 返回 pid，wait 返回退出码。
-- Nat 度量/算术：运行时表示是 OCaml int（Zero=0、Succ 饱和 +1）。
-- 语义：add/mul 饱和到 max_int，sub 截断到 0，div 除零与 Int 同文案失败。
-- 运行时诊断原语。`@vuna@prim_eff_eprint` 写 stderr 并 flush（报告器/调试输出用）；
-- `prim_fail` 抛 Failure（报告器把它渲染成 "vuna: runtime error: ..."）。`@vuna@prim_eff_eprint`
-- 供工具链的 stderr 报告使用；`prim_fail` 供工具链的 fuel 耗尽路径使用。
-- 内部 cast（`visible = False`）：只由精化器插入，runtime 是 OCaml 的 `%identity`；
-- 运行时位置的不透明擦除依赖值靠它进出（见 docs/reference/effects.md §5/§6）。
-- 运行时续延：一次性 effect handler，只供 `Base.Effect.Core` 的包装使用；类型在源码层由 Base.Effect.Core 的 API 收紧，
-- 运行时表达式用 Obj.magic 桥接（与不透明 cast 同一套表示）。
-- 最小并发（OCaml 5 Domain）。只允许在 main 域 fork/await；任务体应是
-- 行已被处理干净的 Eff（Base.EffAsync 的 API 强制 Nil）。
-- 单线程 fiber 调度器原语（Base.EffSched 的信任边界；runtime = dtp_sched_*）。
-- 原生睡眠：微秒；真实实现是 `Unix.sleepf`（阻塞，非忙等）。
-- clock 族（与 effTimeUs 同族）；interp 不归约（OpNone），效果程序只 compile+run。
-- `Base.Effect.Clock` 与工具链的 sleep 都直接使用它。
-- 语言级调试构造（不经过宿主层；assert/todo 由 Resolve 在 release 构建拒绝）。
-- `+ - * /` 只作为 codegen / interp 的映射目标（源码里的 `+` 等由 Loader
-- 换成 `Base.Trait.Num` 的方法别名，精化期再特化回这四个内建），因此不再对用户源码可见。
-- 位运算（可见：库与编译器直接用；语义见 `IntrinsicOp` 的注释与 primitives.md）。
-- 显式效应机器的装箱/拆箱（运行时恒等；见 Base.Internal.Obj）。
baseIntrinsics =
  [
    Intrinsic "+" (IFun IInt (IFun IInt IInt)) OpAdd False,
    Intrinsic "-" (IFun IInt (IFun IInt IInt)) OpSub False,
    Intrinsic "*" (IFun IInt (IFun IInt IInt)) OpMul False,
    Intrinsic "/" (IFun IInt (IFun IInt IInt)) OpDiv False,
    Intrinsic "bitAnd" (IFun IInt (IFun IInt IInt)) OpBitAnd True,
    Intrinsic "bitOr" (IFun IInt (IFun IInt IInt)) OpBitOr True,
    Intrinsic "bitXor" (IFun IInt (IFun IInt IInt)) OpBitXor True,
    Intrinsic "bitNot" (IFun IInt IInt) OpBitNot True,
    Intrinsic "bitShl" (IFun IInt (IFun IInt IInt)) OpBitShl True,
    Intrinsic "bitShr" (IFun IInt (IFun IInt IInt)) OpBitShr True,
    Intrinsic "++" (IFun IStr (IFun IStr IStr)) OpConcat True,
    Intrinsic "&&" (IFun IBool (IFun IBool IBool)) OpAnd True,
    Intrinsic "||" (IFun IBool (IFun IBool IBool)) OpOr True,
    Intrinsic "strFromInt" (IFun IInt IStr) OpStrFromInt True,
    Intrinsic "strUnpack" (IFun IStr (IList IInt)) OpStrUnpack True,
    Intrinsic "strPack" (IFun (IList IInt) IStr) OpStrPack True,
    Intrinsic "strLength" (IFun IStr IInt) OpStrLength True,
    Intrinsic "strConcatMany" (IFun (IList IStr) IStr) OpStrConcatMany True,
    Intrinsic "strSubstTemplate" (IFun IStr (IFun (IList IStr) IStr)) OpStrSubstTemplate True,
    Intrinsic "strHash" (IFun IStr IInt) OpStrHash True,
    Intrinsic "effectId" (IFun IStr IInt) OpStrDispatchId True,
    Intrinsic "strAt" (IFun IStr (IFun IInt IInt)) OpStrAt True,
    Intrinsic "strSubstring" (IFun IInt (IFun IInt (IFun IStr IStr))) OpStrSubstring True,
    Intrinsic "strShow" (IFun IStr IStr) OpStrShow True,
    Intrinsic primEraseName (IPi "a" (IFun (IVar "a") (IVar "a"))) OpIdentity False,
    Intrinsic "natAdd" (IFun INat (IFun INat INat)) OpNatAdd True,
    Intrinsic "natSub" (IFun INat (IFun INat INat)) OpNatSub True,
    Intrinsic "natMul" (IFun INat (IFun INat INat)) OpNatMul True,
    Intrinsic "natDiv" (IFun INat (IFun INat INat)) OpNatDiv True,
    Intrinsic "natToInt" (IFun INat IInt) OpNatToInt True,
    Intrinsic "natFromInt" (IFun IInt INat) OpNatFromInt True,
    Intrinsic "arrayLength" (IPi "a" (IFun (IArray (IVar "a")) IInt)) OpNone True,
    Intrinsic "arrayEmpty" (IPi "a" (IArray (IVar "a"))) OpNone True,
    Intrinsic "arrayGet" (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IVar "a")))) OpNone True,
    Intrinsic
      "arraySet"
      (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IArray (IVar "a"))))))
      OpNone
      True,
    Intrinsic "arrayMake" (IPi "a" (IFun IInt (IFun (IVar "a") (IArray (IVar "a"))))) OpNone True,
    Intrinsic "arrayFromList" (IPi "a" (IFun (IList (IVar "a")) (IArray (IVar "a")))) OpNone True,
    Intrinsic "arrayToList" (IPi "a" (IFun (IArray (IVar "a")) (IList (IVar "a")))) OpNone True,
    Intrinsic
      "prim_effectPerformId"
      (IPi "a" (IPi "b" (IFun IStr (IFun IStr (IFun IInt (IFun IInt (IFun (IVar "a") (IVar "b"))))))))
      OpNone
      True,
    Intrinsic
      "prim_effectHandleId"
      (IPi "u" (IPi "a" (IPi "b" (IPi "ret" (IPi "h" (IFun IStr (IFun IStr (IFun IInt (IFun IInt (IFun (IVar "ret") (IFun (IVar "h") (IFun (IFun (IVar "u") (IVar "a")) (IFun (IVar "u") (IVar "b"))))))))))))))
      OpNone
      True,
    Intrinsic
      "prim_effectSelf"
      (IPi "a" (IPi "b" (IFun (IFun IInt (IVar "a")) (IVar "b"))))
      OpNone
      True,
    Intrinsic "prim_cleanupPush" (IFun (IFun IInt IInt) IInt) OpNone True,
    Intrinsic "prim_cleanupPop" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedNewScope" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedFork" (IPi "a" (IFun IInt (IFun (IFun IInt (IVar "a")) IInt))) OpNone True,
    Intrinsic "prim_schedYield" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedIsCancelled" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedAwait" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedTaskResult" (IPi "a" (IFun IInt (IVar "a"))) OpNone True,
    Intrinsic "prim_schedTaskError" (IFun IInt IStr) OpNone True,
    Intrinsic "prim_schedCancelTask" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedCancelScope" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedScopeWait" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_schedScopeWaitTimeout" (IFun IInt (IFun IInt IInt)) OpNone True,
    Intrinsic "prim_schedScopeError" (IFun IInt IStr) OpNone True,
    Intrinsic "prim_schedScopeCount" (IFun IInt IInt) OpNone True,
    Intrinsic "prim_fail" (IPi "a" (IFun IStr (IVar "a"))) OpNone True,
    Intrinsic
      assertIntrinsicName
      (IPi "a" (IFun IBool (IFun IStr (IFun (IVar "a") (IVar "a")))))
      OpNone
      True,
    Intrinsic todoIntrinsicName (IPi "a" (IFun IStr (IVar "a"))) OpNone True,
    Intrinsic "bi_eq_int" (IFun IInt (IFun IInt IBool)) OpEqInt False,
    Intrinsic "bi_neq_int" (IFun IInt (IFun IInt IBool)) OpNeqInt False,
    Intrinsic "bi_eq_str" (IFun IStr (IFun IStr IBool)) OpEqStr False,
    Intrinsic "bi_neq_str" (IFun IStr (IFun IStr IBool)) OpNeqStr False,
    Intrinsic "bi_lt_int" (IFun IInt (IFun IInt IBool)) OpLtInt False,
    Intrinsic "bi_le_int" (IFun IInt (IFun IInt IBool)) OpLeInt False,
    Intrinsic "bi_gt_int" (IFun IInt (IFun IInt IBool)) OpGtInt False,
    Intrinsic "bi_ge_int" (IFun IInt (IFun IInt IBool)) OpGeInt False,
    Intrinsic "bi_lt_str" (IFun IStr (IFun IStr IBool)) OpLtValue False,
    Intrinsic "bi_le_str" (IFun IStr (IFun IStr IBool)) OpLeValue False,
    Intrinsic "bi_gt_str" (IFun IStr (IFun IStr IBool)) OpGtValue False,
    Intrinsic "bi_ge_str" (IFun IStr (IFun IStr IBool)) OpGeValue False,
    Intrinsic "bi_lt_bool" (IFun IBool (IFun IBool IBool)) OpLtValue False,
    Intrinsic "bi_le_bool" (IFun IBool (IFun IBool IBool)) OpLeValue False,
    Intrinsic "bi_gt_bool" (IFun IBool (IFun IBool IBool)) OpGtValue False,
    Intrinsic "bi_ge_bool" (IFun IBool (IFun IBool IBool)) OpGeValue False
  ]

-- | 浮点相关内建（字面量转换/算术/比较/格式化）。单独成表（见 `baseIntrinsics` 的
-- 表拆分说明）；顺序上追加在基础表之后。
floatIntrinsics : List Intrinsic
floatIntrinsics =
  [
    Intrinsic "strFromFloat" (IFun IFloat IStr) OpStrFromFloat True,
    Intrinsic "floatFromInt" (IFun IInt IFloat) OpFloatFromInt True,
    Intrinsic "intFromFloat" (IFun IFloat IInt) OpIntFromFloat True,
    Intrinsic "floatAbs" (IFun IFloat IFloat) OpFloatAbs True,
    Intrinsic "floatSqrt" (IFun IFloat IFloat) OpFloatSqrt True,
    Intrinsic "bi_add_float" (IFun IFloat (IFun IFloat IFloat)) OpAddF False,
    Intrinsic "bi_sub_float" (IFun IFloat (IFun IFloat IFloat)) OpSubF False,
    Intrinsic "bi_mul_float" (IFun IFloat (IFun IFloat IFloat)) OpMulF False,
    Intrinsic "bi_div_float" (IFun IFloat (IFun IFloat IFloat)) OpDivF False,
    Intrinsic "bi_eq_float" (IFun IFloat (IFun IFloat IBool)) OpEqF False,
    Intrinsic "bi_neq_float" (IFun IFloat (IFun IFloat IBool)) OpNeqF False,
    Intrinsic "bi_lt_float" (IFun IFloat (IFun IFloat IBool)) OpLtF False,
    Intrinsic "bi_le_float" (IFun IFloat (IFun IFloat IBool)) OpLeF False,
    Intrinsic "bi_gt_float" (IFun IFloat (IFun IFloat IBool)) OpGtF False,
    Intrinsic "bi_ge_float" (IFun IFloat (IFun IFloat IBool)) OpGeF False
  ]

-- | Eff 动作版本的宿主原语：名字是隐藏的 `@vuna@prim_eff_*`，
-- 类型为 `Eff [] a`。单独成表是为了让每段列表字面量
-- 留在 seed 的 fuel 内（同 `floatIntrinsics`）。
effIntrinsics : List Intrinsic
-- 内建 ConsoleOp 宿主打印（宿主原语叶子不在行里）。
-- 带内建 FsOp 行的宿主原语（entry 自动预装用）。
-- 带内建效应行的宿主原语（Clock/Env/Process/Exit/Stdin/Args）。
-- Net 的带行宿主原语。
-- 显式效应机器的装箱/拆箱（运行时恒等；见 Base.Effect.Core.Obj）。
-- MutRef 的私有单元原语：类型 `@vuna@Cell a` 不对用户开放，
-- 只能由精化器在 `withMutRef` 作用域里合成引用。
-- MutArray 的私有原地数组原语：类型 `@vuna@MArray a` 不对用户开放，
-- 只能由精化器在 `withMutArray` 作用域里合成数组。`marrSet` 是唯一原地写的入口
-- （不可变 `arraySet` 是 copy-on-write，不能复用）。
-- MutBuffer 的私有字节缓冲原语：类型 `@vuna@MBuffer` 不对用户开放。
effIntrinsics =
  [
    Intrinsic
      "@vuna@prim@toObj"
      (IPi "a" (IFun (IVar "a") (IGlobal "Base.Effect.Core.Obj")))
      OpNone
      False,
    Intrinsic
      "@vuna@prim@fromObj"
      (IPi "a" (IFun (IGlobal "Base.Effect.Core.Obj") (IVar "a")))
      OpNone
      False,
    Intrinsic
      primEffBind1Name
      (IPi "a" (IPi "b" (IFun1 (IEff (IVar "a")) (IFun1 (IFun1 (IVar "a") (IEff (IVar "b"))) (IEff (IVar "b"))))))
      OpNone
      False,
    Intrinsic "effTimeUs" (IEffHost IInt) OpNone True,
    Intrinsic "@vuna@prim_eff_sleep" (IFun IInt (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@prim_mrefNew" (IPi "a" (IFun (IVar "a") (ICell (IVar "a")))) OpNone False,
    Intrinsic
      "@vuna@prim_mrefRead"
      (IPi "a" (IFun (ICell (IVar "a")) (IEff (IVar "a"))))
      OpNone
      False,
    Intrinsic
      "@vuna@prim_mrefWrite"
      (IPi "a" (IFun (ICell (IVar "a")) (IFun (IVar "a") (IEff IInt))))
      OpNone
      False,
    Intrinsic
      "@vuna@prim_marrNew"
      (IPi "a" (IFun IInt (IFun (IVar "a") (IMArray (IVar "a")))))
      OpNone
      False,
    Intrinsic
      "@vuna@prim_marrGet"
      (IPi "a" (IFun (IMArray (IVar "a")) (IFun IInt (IEff (IVar "a")))))
      OpNone
      False,
    Intrinsic
      "@vuna@prim_marrSet"
      (IPi "a" (IFun (IMArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IEff IInt)))))
      OpNone
      False,
    Intrinsic "@vuna@prim_marrLen" (IPi "a" (IFun (IMArray (IVar "a")) IInt)) OpNone False,
    Intrinsic
      "@vuna@prim_marrFromList"
      (IPi "a" (IFun (IList (IVar "a")) (IMArray (IVar "a"))))
      OpNone
      False,
    Intrinsic "@vuna@prim_dynNew" (IPi "a" (IFun IInt (IMDynArray (IVar "a")))) OpNone False,
    Intrinsic
      "@vuna@prim_dynGet"
      (IPi "a" (IFun (IMDynArray (IVar "a")) (IFun IInt (IEff (IVar "a")))))
      OpNone
      False,
    Intrinsic
      "@vuna@prim_dynSet"
      (IPi "a" (IFun (IMDynArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IEff IInt)))))
      OpNone
      False,
    Intrinsic
      "@vuna@prim_dynPush"
      (IPi "a" (IFun (IMDynArray (IVar "a")) (IFun (IVar "a") (IEff IInt))))
      OpNone
      False,
    Intrinsic "@vuna@prim_dynLen" (IPi "a" (IFun (IMDynArray (IVar "a")) IInt)) OpNone False,
    Intrinsic
      "@vuna@prim_dynClear"
      (IPi "a" (IFun (IMDynArray (IVar "a")) (IEff IInt)))
      OpNone
      False,
    Intrinsic "@vuna@prim_mbufNew" (IFun IInt IMBuffer) OpNone False,
    Intrinsic "@vuna@prim_mbufAppend" (IFun IMBuffer (IFun IStr (IEff IInt))) OpNone False,
    Intrinsic "@vuna@prim_mbufAppendChar" (IFun IMBuffer (IFun IInt (IEff IInt))) OpNone False,
    Intrinsic "@vuna@prim_mbufLen" (IFun IMBuffer IInt) OpNone False,
    Intrinsic "@vuna@prim_mbufClear" (IFun IMBuffer (IEff IInt)) OpNone False,
    Intrinsic "@vuna@prim_mbufToString" (IFun IMBuffer IStr) OpNone False,
    Intrinsic "@vuna@prim_eff_print" (IFun IStr (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@host@print" (IFun IStr (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_eprint" (IFun IStr (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_readLine" (IEffHost IStr) OpNone False,
    Intrinsic "@vuna@prim_eff_readBytes" (IFun IInt (IEffHost IStr)) OpNone False,
    Intrinsic "@vuna@prim_eff_getArgs" (IEffHost (IList IStr)) OpNone False,
    Intrinsic
      "@vuna@host@tryReadFileRange"
      (IFun IStr (IFun IInt (IFun IInt (IEffHost IStr))))
