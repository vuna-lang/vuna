    Intrinsic "@vuna@host@tryWriteFile" (IFun IStr (IFun IStr (IEffHost IInt))) OpNone False,
    Intrinsic "@vuna@host@tryWriteFileAtomic" (IFun IStr (IFun IStr (IEffHost IInt))) OpNone False,
    Intrinsic "@vuna@host@tryReadDir" (IFun IStr (IEffHost (IList IStr))) OpNone False,
    Intrinsic "@vuna@host@tryIsDirectory" (IFun IStr (IEffHost IBool)) OpNone False,
    Intrinsic "@vuna@host@tryMakeDir" (IFun IStr (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@host@tryRemoveFile" (IFun IStr (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@host@tryRemoveTree" (IFun IStr (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@host@tryRename" (IFun IStr (IFun IStr (IEffHost IInt))) OpNone False,
    Intrinsic "@vuna@host@trySymlink" (IFun IStr (IFun IStr (IEffHost IInt))) OpNone False,
    Intrinsic "@vuna@host@tryMakeDirExclusive" (IFun IStr (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@host@isTty" (IEffHost IBool) OpNone False,
    Intrinsic "@vuna@host@tryRunIn" (IFun IStr (IFun (IList IStr) (IEffHost IInt))) OpNone False,
    Intrinsic "@vuna@prim_eff_exit" (IFun IInt (IEffHost IInt)) OpNone False,
    Intrinsic "@vuna@prim_eff_runIn" (IFun IStr (IFun (IList IStr) (IEffHost IInt))) OpNone False,
    Intrinsic "effTimeUs_host" (IEffHost IInt) OpNone True,
    Intrinsic "@vuna@host@sleep" (IFun IInt (IEffHost IInt)) OpNone False,
