-- | 后端能力：内建宿主效应标签在某个目标上是否可用。
module Vuna.Compiler.Base.Capabilities where

-- 内建效应家族的清单在 `Vuna.Compiler.Base.Intrinsics`（`builtinEffects`）；这里只声明
-- 目标对标签的可用性。粒度是**家族**：`CapUnavailable` 表示该家族的核心操作在目标上会
-- 运行期 trap；`CapAvailable` 表示核心可用，逐操作缺口（例如 wasm 的 symlink / mtime /
-- 阻塞 sleep）记在 `docs/reference/wasm.md` §8.1，不在告警层重复。
--
-- 值来源（改运行时实现表时必须同步本表）：
--   wasm   → `Vuna.Target.Wasm.Runtime` 的 `rtImplOf`
--   ocaml  → `Vuna.Target.Ocaml.Runtime` 的 `dtp_*`
--   native → `Vuna.Target.Native.Runtime` 的 `nativeRtTargetHost`
import Vuna.Compiler.Base.Common
import Base.Data.String as String

-- | 目标对某个内建效应标签的可用性。
export data Capability(..) : Type where
  CapAvailable : Capability
  CapUnavailable : Capability

-- | 目标 × 内建效应标签 → 能力。未列出的目标按全部可用处理。
export capabilityOf : String -> String -> Capability
capabilityOf target tag = if target == "wasm" then wasmCapabilityOf tag else CapAvailable

-- wasm 的不可用面：进程派生 / stdin / raw 网络没有浏览器宿主实现；`ProcessOp` 的
-- Args / Exit 可用，但家族按 spawn/wait/runIn 判为不可用。
wasmCapabilityOf : String -> Capability
wasmCapabilityOf "Base.Effect.Process.ProcessOp" = CapUnavailable
wasmCapabilityOf "Base.Effect.Stdin.StdinOp" = CapUnavailable
wasmCapabilityOf "Base.Effect.Net.NetOp" = CapUnavailable
wasmCapabilityOf _ = CapAvailable
