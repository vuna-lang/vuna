-- | 编译器底层源码位置与路径工具（不含 `Result`；诊断结果类型在 `Diag`）。
module Vuna.Compiler.Base.Source where

-- 位置/路径层。
--
-- 分层原因：`Diag` 需要 `Span` 构造诊断，`Common` 需要 `Diag` 提供
-- 结构化 `Result`；若 `Span` 与 `Result` 同处 `Common` 就会成环。这里只保留与错误
-- 通道无关的纯数据与路径/近似名工具，供 `Diag` 与 `Common` 共用。
--
-- 位置约定：行、列均从 1 开始；列 = UTF-8 字节（与 lexer 的 `advanceChar` 一致）。
-- LSP 的 UTF-16 换算只在 LSP 适配器做。
-- | 源码位置：行、列、字节偏移，均从 1 开始（偏移从 0 开始）。
export record Pos(..) where
  -- | 行号（从 1 开始）。
  posLine : Int
  -- | 列号（从 1 开始；UTF-8 字节）。
  posCol : Int
  -- | 从源码起始算起的 UTF-8 字节偏移（从 0 开始）。
  posOffset : Int
  -- | token 的结束字节偏移（从 0 开始，开区间）；非 token 位置等于 `posOffset`。
  posEndOffset : Int

-- | 源码 span：文件、起始行列、结束行列与字节偏移。文件在解析时由调用方注入，
-- 供跨模块 flatten 后仍能追溯每个表达式来自哪个源文件。
--
-- 偏移是 `[start, end)` 的字节区间，`spanEndOffset` / `spanEndLine` / `spanEndCol`
-- 指向**最后一个成员 token 之后**：span 覆盖的就是这段源码原文，可直接按偏移切片。
export record Span(..) where
  -- | 该 span 所在的源文件路径。
  spanFile : String
  -- | 起始行（从 1 开始）。
  spanStartLine : Int
  -- | 起始列（从 1 开始）。
  spanStartCol : Int
  -- | 结束行（从 1 开始）。
  spanEndLine : Int
  -- | 结束列（从 1 开始）。
  spanEndCol : Int
  -- | 起始字节偏移（从 0 开始）。
  spanStartOffset : Int
  -- | 结束字节偏移（从 0 开始；开区间，指向最后一个成员 token 之后）。
  spanEndOffset : Int

-- | 把 span 渲染成 `文件:行:列`（错误信息前缀）。
export showSpanLoc : Span -> String
showSpanLoc (Span f sl sc el ec so eo) = "${f}:${sl}:${sc}"

-- | 合成节点的占位 span：没有源码来源的 binder / 项用它，诊断侧再回落到外层位置。
export spanEmpty : Span
spanEmpty = Span "" 0 0 0 0 0 0

-- | 是否是占位 span（`spanEmpty`）。
export isSpanEmpty : Span -> Bool
isSpanEmpty sp = spanStartLine sp == 0

-- | binder 名的 span：接受**恰好覆盖该名字**的 span，也接受「只有起点」的合成 span
-- （按名字长度展开，列按 UTF-8 字节）。其它形状（借用外层节点的合成 span、或宽度与名字
-- 不符）返回 `spanEmpty`——调用方回落到外层位置，也不会给出可能毁掉源码的替换编辑。
export spanAtName : String -> Span -> Span
spanAtName name sp =
  if isSpanEmpty sp then
    sp
  else if spanStartOffset sp == spanEndOffset sp then
    Span
      (spanFile sp)
      (spanStartLine sp)
      (spanStartCol sp)
      (spanStartLine sp)
      (spanStartCol sp + strLength name)
      (spanStartOffset sp)
      (spanStartOffset sp + strLength name)
  else if spanEndOffset sp - spanStartOffset sp == strLength name then sp else spanEmpty

-- | 字符（字节码）是否在列表里；线性扫描，用于小字符集判断。
memChar : Int -> List Int -> Bool
memChar c [] = False
memChar c (x :: rest) = x == c || memChar c rest

-- | 从 `i` 起找字节 `c`：直接走 `strAt`，不把整串摊成 `List Int`。
-- `fuel` 只用于终止性检查（每步前进一个字节）。
scanFor : Int -> String -> Int -> Int -> Int -> Bool
scanFor c s i n fuel =
  if fuel <= 0 then
    False
  else if i >= n then False else if strAt s i == c then True else scanFor c s (i + 1) n (fuel - 1)

-- | 字符串是否含 `.`（模块路径判定的快速路径）。
export containsDot : String -> Bool
containsDot s = scanFor 46 s 0 (strLength s) (strLength s)

-- | 按 `.` 拆分模块路径 `A.B.C` → `["A","B","C"]`。
export splitOnDot : String -> List String
splitOnDot s = splitOnChar 46 s

-- | 按任意分隔字符切分（`splitOnDot` 的泛化；内部标记名解码用）。
export splitOnChar : Int -> String -> List String
splitOnChar sep s = splitOnCharGo sep s 0 0 (strLength s) (strLength s + 1) []

-- | 逐字节扫描并切段：段用 `strSubstring` 取，空段照旧保留。
-- `fuel` 只用于终止性检查（每步前进一个字节，上界 = 字节数 + 1）。
splitOnCharGo : Int -> String -> Int -> Int -> Int -> Int -> List String -> List String
splitOnCharGo sep s start i n fuel acc =
  if fuel <= 0 then
    reverse (strSubstring start (n - start) s :: acc)
  else if i >= n then
    reverse (strSubstring start (i - start) s :: acc)
  else if strAt s i == sep then
    splitOnCharGo sep s (i + 1) (i + 1) n (fuel - 1) (strSubstring start (i - start) s :: acc)
  else
    splitOnCharGo sep s start (i + 1) n (fuel - 1) acc

-- | 把已拆分的段列表的**最后一段**单独分出来：`["A","B"]` → `(["A"], "B")`；
-- 空列表返回 `([], "")`。
export splitLastDot : List String -> (List String, String)
splitLastDot parts =
  case reverse parts of
    [] => ([], "")
    last :: rest => (reverse rest, last)

-- | 用 `.` 拼接模块路径段；空列表得空串，单段原样返回。
export joinDots : List String -> String
joinDots xs = strConcatMany (joinDotsParts xs)

-- 分片形式（差列表）：顶层只 `strConcatMany` 一次，避免 `"${x}.${...}"` 的逐层拷贝。
joinDotsParts : List String -> List String
joinDotsParts [] = []
joinDotsParts (x :: rest) = x :: dotsRest rest

dotsRest : List String -> List String
dotsRest [] = []
dotsRest (x :: rest) = "." :: x :: dotsRest rest

-- | 名字的**末段**（`Base.Trait.Monad.fmap` → `fmap`；无点时返回原名本身）。
-- 名字末段/前缀的唯一入口：`Elab.Meta.baseNameOf`、`Elab.Prelude` 的短名比较、
-- `Elab.Term.Impl.shortGlobalName`、`Frontend.Ast.ctorShortName` 都转发到这里。
-- 从右往左扫 `.`，只分配末段本身（不切整串）。
export lastSeg : String -> String
lastSeg name = lastSegGo name (strLength name - 1) (strLength name + 1)

lastSegGo : String -> Int -> Int -> String
lastSegGo name i fuel =
  if fuel <= 0 then
    strSubstring (i + 1) (strLength name - i - 1) name
  else if i < 0 then
    name
  else if strAt name i == 46 then
    strSubstring (i + 1) (strLength name - i - 1) name
  else
    lastSegGo name (i - 1) (fuel - 1)

-- | 名字的**模块前缀**（`Base.Trait.Monad.fmap` → `Base.Trait.Monad`；无点时返回 `""`）。
export prefixOfName : String -> String
prefixOfName name =
  case splitLastDot (splitOnDot name) of
    (revSegs, _) => joinDots revSegs

-- | 用 `/` 拼接文件路径段；空列表得空串，单段原样返回。
export joinSlashes : List String -> String
joinSlashes [] = ""
joinSlashes [x] = x
joinSlashes (x :: rest) = "${x}/${joinSlashes rest}"

-- | 用 ` -> ` 拼接类型/签名片段（展示用）；空列表得空串，单段原样返回。
export joinArrows : List String -> String
joinArrows [] = ""
joinArrows [x] = x
joinArrows (x :: rest) = "${x} -> ${joinArrows rest}"

-- | 路径拆分：返回去掉最后一段的目录与最后一段（无 "/" 时目录为 ""）。
-- 编译器驱动（创建输出文件父目录）与 doc 共用，因此放在 Base 而不是工具模块。
export splitPath : String -> (String, String)
splitPath path = splitPathChars (strUnpack path) []

-- | `splitPath` 的码点级实现：遇 `/`（47）即切成目录与剩余（含最后一段）。
splitPathChars : List Int -> List Int -> (String, String)
splitPathChars [] acc =
  let
    chars = reverse acc
  in ("", strPack chars)
splitPathChars (c :: rest) acc =
  if c == 47 then (strPack (reverse acc), strPack rest) else splitPathChars rest (c :: acc)

-- | 取路径最后一段（文件名/模块名），等价 `secondOf (splitPath path)`。
export baseName : String -> String
baseName path = secondOf (splitPath path)

-- | 去掉最后一段（`a/b/c` -> `a/b`；无 `/` -> "."；绝对路径的父仍绝对）。
-- 与 `splitPath` 不同：这里切**最后**一个 `/`。
export parentOfPath : String -> String
parentOfPath path =
  let
    chars = strUnpack path
    rev = reverse chars
    after = dropPastSlash rev
  in if length after == length rev then
    "."
  else
    let
      parent = strPack (reverse after)
    in if parent == "" then if startsWith "/" path then "/" else "." else if startsWith "/" path && not (startsWith "/" parent) then "/${parent}" else parent

dropPastSlash : List Int -> List Int
dropPastSlash [] = []
dropPastSlash (c :: rest) = if c == 47 then rest else dropPastSlash rest

-- ---------------------------------------------------------------
-- 目录路径归一（包 / manifest 侧的唯一口径）
-- ---------------------------------------------------------------

-- 把段列表按 lexical 规则折叠；acc 为反向累积的已处理段。
-- `..` 分支内联在同一个对 `segments` 的结构递归里（每个分支都只递归到 rest），
-- 终止性可直接证明。
normalizeSegments : Bool -> List String -> List String -> List String
normalizeSegments absolute [] acc = acc
normalizeSegments absolute (seg :: rest) acc =
  case seg of
    "" => normalizeSegments absolute rest acc
    "." => normalizeSegments absolute rest acc
    ".." =>
      case acc of
        [] =>
          if absolute then
            normalizeSegments absolute rest []
          else
            normalizeSegments absolute rest [".."]
        prev :: prevRest =>
          if prev == ".." then
            normalizeSegments absolute rest (".." :: acc)
          else
            normalizeSegments absolute rest prevRest
    _ => normalizeSegments absolute rest (seg :: acc)

-- | 目录字符串 lexical 规范化（不解析符号链接）：合并 `//`、消去 `.` 与 `..`、
-- 去掉尾 `/`。"a/./b/../c/" -> "a/c"；相对路径空结果归一为 "."，绝对路径为 "/"。
-- 依赖路径、workspace 成员、包目录与 manifest 目录的拼接都走这一条。
export normalizePath : String -> String
normalizePath path =
  if startsWith "/" path then
    case normalizeSegments True (splitOnChar 47 path) [] of
      [] => "/"
      segments => "/${joinSlashes (reverse segments)}"
  else
    case normalizeSegments False (splitOnChar 47 path) [] of
      [] => "."
      segments => joinSlashes (reverse segments)

-- | 路径拼接 + 归一：`rel` 是绝对路径时忽略 `base`。
export joinPath : String -> String -> String
joinPath base rel = if startsWith "/" rel then normalizePath rel else normalizePath "${base}/${rel}"

-- ---------------------------------------------------------------
-- 位置路径归一（生成产物里的 `#line` 与位置表共用）
-- ---------------------------------------------------------------

-- | 去掉 `prefix/` 前缀；不匹配原样返回。
export stripPathPrefix : String -> String -> String
stripPathPrefix prefix path =
  if prefix == "" then
    path
  else if startsWith "${prefix}/" path then
    strSubstring (strLength "${prefix}/") (strLength path - strLength "${prefix}/") path
  else
    path

-- | 依次尝试前缀，首个命中即去掉。
export stripRootsPath : List String -> String -> String
stripRootsPath [] path = path
stripRootsPath (root :: rest) path =
  if startsWith "${root}/" path then stripPathPrefix root path else stripRootsPath rest path

-- | 去掉开头的 `./`。
export stripDotSlashPath : String -> String
stripDotSlashPath path =
  if startsWith "./" path then strSubstring 2 (strLength path - 2) path else path

-- | 位置路径归一：先按模块根去前缀，再按包目录去前缀，最后去掉 `./`。
-- 写接口时用它把 `miDefLocs` 存成与调用方 CWD 无关的形式；读侧再用同一函数即可幂等。
export locationPathUnder : List String -> String -> String -> String
locationPathUnder roots dir path =
  stripDotSlashPath (stripPathPrefix dir (stripRootsPath roots path))

-- | 候选建议：与出错名相似的名字（诊断）。无相似项返回空串。
export suggest : String -> List String -> String
suggest name [] = ""
suggest name (c :: rest) =
  if _similarName name c then " (did you mean ${c}?)" else suggest name rest

-- | 近似名判定（供 `suggest`）：相等不算（那是精确命中），其余按前缀包含、
-- 长度差 ≤2 且公共前缀 ≥2 判为相似。
_similarName : String -> String -> Bool
_similarName a b =
  if a == b then
    False
  else if startsWith a b then
    True
  else if startsWith b a then
    True
  else
    let
      la = strUnpack a
    in let
      lb = strUnpack b
    in lengthDiffLE (length la) (length lb) 2 && prefixLen2 la lb >= 2

-- | 两个码点列表的公共前缀长度。
prefixLen2 : List Int -> List Int -> Int
prefixLen2 [] _ = 0
prefixLen2 _ [] = 0
prefixLen2 (x :: xs) (y :: ys) = if x == y then 1 + prefixLen2 xs ys else 0

-- | 两个长度的差是否 ≤ n（无符号比较的安全写法）。
lengthDiffLE : Int -> Int -> Int -> Bool
lengthDiffLE la lb n = if la >= lb then la - lb <= n else lb - la <= n
