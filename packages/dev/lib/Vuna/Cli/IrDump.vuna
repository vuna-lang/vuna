module Vuna.Cli.IrDump where

-- `vuna dev ir dump`：检查 + lowering 后输出确定性 IR 调试文本。
-- 只服务工具链/调试，不写产物；属于 cli 包（`Vuna.Cli.*`），不进 seed。
import Base.Effect.Types as EffTypes
import Base.Data.Pair as Pair
import Vuna.Compiler.Base.Common
import Vuna.Target.Ocaml.Decl
import Vuna.Target.Ocaml.Render
import Vuna.Target.Ocaml.Term
import Vuna.Target.Native.Repr
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Frontend.Packages.Pkg
import Vuna.Ir.Anf
import Vuna.Ir.Codec
import Vuna.Ir.Cps
import Vuna.Ir.Model
import Vuna.Cli.IrRender
import Vuna.Compiler.Lowering.Program
import Base.Effect.Fs as EffFs
import Base.Effect.Env as EffEnv
import Base.Effect.Process as EffProcess

export dumpIr : Member nFs FsOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => String -> PackageContext -> String -> Eff r (Check String)
dumpIr after ctx entry =
  do
    checked <- dtCheckWithProgramParts ctx entry
    pure (
        case checked of
          ErrC e => ErrC e
          OkC pair =>
            let
              pkg = secondOf pair
            in case lowerProgramOf pkg.checkedProgram.dtProgDatas pkg.checkedProgram.dtProgDefs pkg.checkedProgram.dtProgGlobals of
              ErrC e => ErrC e
              OkC program => dumpAfter after program
      )

-- | `vuna dev ir decode FILE`：把后端插件收到的 IR 载荷（`Ir.Codec` 文本）解回渲染形式。
-- 用于把「dump 看到的 IR」与「插件实际拿到的 IR」对齐：载荷里的 def 集是后端可达子集。
export decodeIrFile : Member nFs FsOp r => String -> Eff r String
decodeIrFile path =
  do
    text <- EffFs.fsReadFile path
    pure (
        case decodeProgram (strLength text + 1) text of
          Nothing => "decode failed: ${path}"
          Just program => renderDefs (concatMap irGroupDefs (irProgUnitOf program).irUnitGroups)
      )

dumpAfter : String -> IrProgram -> Check String
dumpAfter "cps" program = dumpCps program
dumpAfter "machine" program = dumpMachine program
dumpAfter "anf" program = dumpAnf 1 program
dumpAfter "anf2" program = dumpAnf 2 program
dumpAfter "ocaml" program = dumpOcaml program
dumpAfter "repr" program = dumpRepr "raw" program
dumpAfter "repr-cps" program = dumpReprCps program
dumpAfter _ program = OkC (renderProgram program)

-- | 槽/值 kind 分布：lowering 之后（`raw`）与 native 实际输入的 CPS 之后（`cps`）。
dumpRepr : String -> IrProgram -> Check String
dumpRepr mode program =
  let
    unit = program.irProgUnit
    defs = concatMap irGroupDefs unit.irUnitGroups
  in OkC (nReprReport mode unit.irUnitTyDecls defs)

dumpReprCps : IrProgram -> Check String
dumpReprCps program =
  let
    unit = program.irProgUnit
    defs = concatMap irGroupDefs unit.irUnitGroups
  in case cpsDefsMachine defs of
    Err msg => OkC ("repr-cps: " ++ msg)
    Ok switched => OkC (nReprReport "cps" unit.irUnitTyDecls switched)

-- | OCaml 后端视图：类型声明 + 每个顶层的 `name = <渲染后的 OTerm>`。
-- 名字编码与前缀是完整的（`v_` / `C_` / `f_`），check 路径的 `noQual` 因此不写跨单元限定。
dumpOcaml : IrProgram -> Check String
dumpOcaml program =
  let
    unit = program.irProgUnit
    st = mkGenStWith (\p => p) noQual program.irProgShared
    types = irTypeDeclsText noQual unit.irUnitTyDecls
  in case genGroups st unit.irUnitGroups of
    ErrC e => OkC ("OCAML ERROR: " ++ diagText e)
    OkC (bodies, _) => OkC (types ++ joinWith "\n\n" bodies)

dumpMachine : IrProgram -> Check String
dumpMachine program =
  let
    defs = concatMap irGroupDefs program.irProgUnit.irUnitGroups
  in case cpsDefsMachine defs of
    Err msg => OkC ("MACHINE ERROR: " ++ msg)
    Ok ds => OkC (renderDefs ds)

dumpCps : IrProgram -> Check String
dumpCps program =
  case cpsUnit program.irProgUnit of
    Err msg => OkC ("CPS ERROR: " ++ msg)
    Ok u1 =>
      let
        shared = program.irProgShared
      in OkC (renderProgram (IrProgram shared u1))

-- | ANF 幂等门禁的调试面：`--after anf` / `--after anf2` 分别对定义做 1 / 2 次
-- `anfProgramDefs`，两份文本逐字节相同才算幂等。
dumpAnf : Int -> IrProgram -> Check String
dumpAnf times program =
  let
    defs = concatMap irGroupDefs program.irProgUnit.irUnitGroups
  in case anfTimes times defs of
    Err msg => OkC ("ANF ERROR: " ++ msg)
    Ok ds => OkC (renderDefs ds)

anfTimes : Int -> List IrDef -> Result (List IrDef)
anfTimes n defs =
  if n <= 0 then
    Ok defs
  else
    case anfProgramDefs defs of
      Err msg => Err msg
      Ok ds => anfTimes (n - 1) ds
