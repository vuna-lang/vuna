-- | `vuna dev suite`：仓库原生 suite（`test/suite.toml`）的参数面与校验。
--
-- suite 的 family / tier / matrix 词汇是 vuna 自己的 conformance 语义，所以命令挂在
-- `vuna dev` 下；执行器在 `Vuna.Test.Run`，本模块只做参数校验与选项摊平。
module Vuna.Cli.Suite where

import Vuna.Cli.Args
import Vuna.Cli.Spec
import Vuna.Dev.Spec as DevSpec
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Err
import Vuna.Cli.Parse
import Vuna.Compiler.Base.Common
import Vuna.Test.Suite
import Vuna.Test.Run
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Args as EffArgs
import Base.Effect.Env as EffEnv
import Base.Effect.Exit as EffExit
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes
import Base.Data.String as String

-- | `vuna dev suite [FILE] [--all]` 的入口；省略 FILE 或 `--all` 时按
-- `test/suite.toml` 的 driver 清单依次跑各包 suite。
export suiteArgs : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => List String -> Eff r Int
suiteArgs rest =
  case parseCmdArgsIn DevSpec.commands ["dev", "suite"] rest of
    ErrC e => toolError (diagText e)
    OkC parsed =>
      case parsed.positionals of
        [] => suiteAll parsed
        [path] =>
          if flagSet parsed "all" then
            toolError "--all 不接受 FILE 参数"
          else
            suiteRun parsed path
        _ => usageErrorForIn DevSpec.commands ["dev", "suite"]

-- | 内部：`--all`：读 driver 清单，逐个独立 suite 调用（共享 store 与预热由调用方负责）。
suiteAll : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Parsed -> Eff r Int
suiteAll parsed =
  case suiteWorkerOf parsed of
    ErrC e => toolError (diagText e)
    OkC (Just _) => toolError "--worker 不能与 --all 同用"
    OkC Nothing =>
      do
        loaded <- parseSuiteFile "test/suite.toml"
        case loaded of
          ErrC e => toolError (diagText e)
          OkC driver => runSuites parsed driver.suiteSuites

-- | 内部：依次跑清单里的 suite；任一失败整体非 0，其余仍跑完。
runSuites : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Parsed -> List String -> Eff r Int
runSuites parsed [] = pure 0
runSuites parsed (path :: rest) =
  do
    rc <- suiteRun parsed path
    more <- runSuites parsed rest
    pure (if rc /= 0 then rc else more)

-- | 内部：校验 `--jobs` / `--timeout` / `--worker`，再解析 suite 文件并运行。
suiteRun : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r, Member nExit ExitOp r, Member nArgs ArgsOp r => Parsed -> String -> Eff r Int
suiteRun parsed suitePath =
  case suiteJobsOf parsed of
    ErrC e => toolError (diagText e)
    OkC jobs =>
      case suiteTimeoutOf parsed of
        ErrC e => toolError (diagText e)
        OkC timeout =>
          case suiteWorkerOf parsed of
            ErrC e => toolError (diagText e)
            OkC worker =>
              do
                loaded <- parseSuiteFile suitePath
                case loaded of
                  ErrC e => toolError (diagText e)
                  OkC suite => runSuite (suiteOptsOf parsed jobs timeout worker suitePath) suite

-- | 内部：把解析结果摊平成 suite 运行选项。
suiteOptsOf : Parsed -> Int -> Int -> Maybe (Int, Int) -> String -> SuiteOpts
suiteOptsOf parsed jobs timeout worker suitePath =
  SuiteOpts
    suitePath
    jobs
    (flagSet parsed "list")
    (flagSet parsed "verbose")
    (flagSet parsed "fail-fast")
    (flagSet parsed "json")
    (flagValues parsed "only")
    (flagValues parsed "filter")
    timeout
    worker
    (flagValue parsed "results-dir")
    (flagSet parsed "quiet")
    (flagSet parsed "last-failed")
    (flagSet parsed "bless")
    (flagSet parsed "bless-diag")
    (flagValue parsed "changed")
    (flagValue parsed "cache-dir")
    (flagSet parsed "watch")
    (flagSet parsed "timings")
    (flagSet parsed "strict-skips")
    (flagSet parsed "audit")
    (flagValues parsed "tier")
    (flagValues parsed "matrix")
    (flagValues parsed "backend")

-- | 内部：suite 的 `--jobs`——缺省 0（未给出，用 `[suite].jobs`）；`auto` = -1（强制自动探测）。
suiteJobsOf : Parsed -> Check Int
suiteJobsOf parsed =
  case flagValue parsed "jobs" of
    Nothing => OkC 0
    Just "auto" => OkC (0 - 1)
    Just text =>
      case parsePositiveInt text of
        Nothing => err "--jobs requires a positive integer (>= 1) or `auto`, got `${text}`"
        Just n => OkC n

-- | 内部：suite 的 `--timeout`——缺省 0（未给出，沿用 family / `[suite].timeout`）；
-- 否则必须是 >= 1 的整数（秒），作为每个 case 预算的上限（更紧的 family 值仍然生效）。
suiteTimeoutOf : Parsed -> Check Int
suiteTimeoutOf parsed =
  case flagValue parsed "timeout" of
    Nothing => OkC 0
    Just text =>
      case parsePositiveInt text of
        Nothing => err "--timeout requires a positive integer (seconds), got `${text}`"
        Just n => OkC n

-- | 内部：`--worker i/N`（`i` 从 0 开始且必须小于 `N`）。
suiteWorkerOf : Parsed -> Check (Maybe (Int, Int))
suiteWorkerOf parsed =
  case flagValue parsed "worker" of
    Nothing => OkC Nothing
    Just text =>
      case split "/" text of
        [iText, nText] =>
          case parseNonNegInt iText of
            Nothing => err "--worker requires i/N with non-negative integers, got `${text}`"
            Just i =>
              case parsePositiveInt nText of
                Nothing => err "--worker requires i/N with non-negative integers, got `${text}`"
                Just n => if i < n then OkC (Just (i, n)) else err "--worker index must be < N"
        _ => err "--worker requires i/N, got `${text}`"
