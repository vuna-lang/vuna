-- | `vuna dev obs run [--level N] [--sample cpu|mem|both] [--interval US] [--out FILE] [--] <cmd...>`：
-- 在开启观测的前提下透明执行用户命令，结束后打印 trace 路径，并原样返回子命令退出码。
--
-- 本进程不 `setenv`（仓库没有该宿主原语），改用「env 前置命令」范式：把
-- `["env", "VUNA_OBS=...", ...]` 拼在用户命令前交给 `processRunIn`（先 chdir 再
-- `Sys.command`，子进程继承这组 env）。用户命令与参数在 `--` 之后原样透传，不做 argv
-- 注入、不拼 shell 片段。
--
-- `--level` 缺省 2（`--level 0` 显式关闭观测，用于关闭口径的对照）；`--sample` 与
-- `--interval` 分别映射到 `VUNA_OBS_SAMPLE` / `VUNA_OBS_INTERVAL`。
--
-- 输出位置：子进程一律拿到本次运行专属的 `VUNA_OBS_DIR`（每进程一份
-- `vuna-<pid>.jsonl`，互不截断）。`--out FILE` 是**最终产物**：只产出一份时逐字节写到
-- FILE，多份时按成员合并成一份合法 trace 再写入；没有 `--out` 时逐行打印各分文件路径。
--
-- 只覆盖 `VUNA_OBS*` 这组 env；`--obs` / `--obs-level` 是运行时 argv，由子命令自己读，
-- 这里不透传也不注入。子进程没产出 trace（level 0 / 忽略 env / 在开文件前失败退出）不是
-- 错误：打印 `no trace file produced` 后仍返回子命令退出码。规范见
-- `docs/reference/observability.md` §2（开关）与 §7 `run`。
module Vuna.Obs.Run where

import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Spec
import Vuna.Dev.Spec as DevSpec
import Vuna.Compiler.Base.Common
import Vuna.Files
import Vuna.Obs.Merge
import Base.Data.Nat as Nat
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Process as EffProcess
import Base.Effect.Types as EffTypes

-- | `vuna dev obs run` 的选项（解析后的形态）。
export record RunOpts(..) where
  -- | 观测级别（0..3，缺省 2）。
  runOptsLevel : Int
  -- | 采样种类（`cpu` / `mem` / `both`；空串 = 不要求采样）。
  runOptsSample : String
  -- | 采样间隔（微秒）；缺省 = `Nothing`（用被观测进程自己的缺省）。
  runOptsInterval : Maybe Int
  -- | 精确的输出文件路径（已绝对化）；缺省 = `Nothing`（改用临时目录）。
  runOptsOut : Maybe String

-- | 执行 `vuna dev obs run`：打印 trace 路径，返回子命令退出码；用法错误返回 2。
export runObsRun : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => List String -> Eff r Int
runObsRun args =
  case parseCmdArgsIn DevSpec.commands ["dev", "obs", "run"] args of
    ErrC e => obsRunError (diagText e)
    OkC parsed =>
      case runOptsOf parsed of
        ErrC e => obsRunError (diagText e)
        OkC opts =>
          case parsed.positionals of
            [] =>
              obsRunError
                "usage: vuna dev obs run [--level N] [--sample cpu|mem|both] [--interval US] [--out FILE] [--] <cmd...>"
            cmd :: rest => runChild opts (cmd :: rest)

-- ---------------------------------------------------------------
-- 选项校验
-- ---------------------------------------------------------------
-- | 内部：把命令行 flag 校验并解析成 `RunOpts`。
runOptsOf : Parsed -> Check RunOpts
runOptsOf parsed =
  do
    level <- levelOf parsed
    sample <- sampleOf parsed
    interval <- intervalOf parsed
    out <- outOf parsed
    pure (RunOpts level sample interval out)

-- | 内部：`--level`（0..3，缺省 2）。
levelOf : Parsed -> Check Int
levelOf parsed =
  case flagValue parsed "level" of
    Nothing => OkC 2
    Just text =>
      case parseIntText text of
        Just n => if n >= 0 && n <= 3 then OkC n else err "--level must be 0..3, got `${text}`"
        Nothing => err "--level is not an integer: `${text}`"

-- | 内部：`--sample`（`cpu` / `mem` / `both`；缺省空串 = 不设置该 env）。
sampleOf : Parsed -> Check String
sampleOf parsed =
  case flagValue parsed "sample" of
    Nothing => OkC ""
    Just text =>
      if text == "cpu" || text == "mem" || text == "both" then
        OkC text
      else
        err "--sample must be cpu, mem or both, got `${text}`"

-- | 内部：`--interval`（正整数微秒）。
intervalOf : Parsed -> Check (Maybe Int)
intervalOf parsed =
  case flagValue parsed "interval" of
    Nothing => OkC Nothing
    Just text =>
      case parseIntText text of
        Just n =>
          if n > 0 then
            OkC (Just n)
          else
            err "--interval must be a positive integer (microseconds), got `${text}`"
        Nothing => err "--interval is not an integer: `${text}`"

-- | 内部：`--out`（非空路径）。
outOf : Parsed -> Check (Maybe String)
outOf parsed =
  case flagValue parsed "out" of
    Nothing => OkC Nothing
    Just text => if text == "" then err "--out requires a non-empty file path" else OkC (Just text)

-- | 内部：十进制整数解析；空串或含非数字（前导 `-` 除外）= `Nothing`。
parseIntText : String -> Maybe Int
parseIntText s = if s == "" then Nothing else parseDigits (strUnpack s) 0 False

-- | 内部：逐字符累积十进制数字，返回解析结果；非法字符 = `Nothing`。
parseDigits : List Int -> Int -> Bool -> Maybe Int
parseDigits [] acc neg = Just (if neg then 0 - acc else acc)
parseDigits (c :: rest) acc neg =
  if c == 45 && not neg then
    parseDigits rest acc True
  else if c >= 48 && c <= 57 then parseDigits rest (acc * 10 + (c - 48)) neg else Nothing

-- ---------------------------------------------------------------
-- 执行
-- ---------------------------------------------------------------
-- | 内部：算好输出位置与 env 前缀，跑子进程，打印 trace 路径并返回其退出码。
runChild : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => RunOpts -> List String -> Eff r Int
runChild opts argv =
  do
    cwd <- envGetCwd
    target <- targetOf opts cwd
    envArgs <- envArgsOf opts cwd target
    code <- processRunIn cwd (append envArgs argv)
    _ <- printTracePaths target
    pure code

-- | 内部：输出目标是 `Pair (Maybe 最终文件) 本次运行目录`——`--out` 时第一项是绝对文件
-- 路径、否则 `Nothing`；第二项永远是本次运行专属目录（子进程只拿 `VUNA_OBS_DIR`）。
targetOf : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => RunOpts -> String -> Eff r (Maybe String, String)
targetOf opts cwd =
  do
    dir <- freshRunDir
    case opts.runOptsOut of
      Nothing => pure (Nothing, dir)
      Just out =>
        do
          path <- absoluteOut out cwd
          _ <- ensureDirPath (parentOf path)
          pure (Just path, dir)

-- | 内部：`--out` 相对化——相对路径按调用方 cwd 拼成绝对路径（`runIn` 会先 chdir）。
absoluteOut : {r : Row} -> String -> String -> Eff r String
absoluteOut out cwd = pure (if startsWith "/" out then out else "${cwd}/${out}")

-- | 内部：本次运行的临时目录 `${TMPDIR:-/tmp}/vuna-obs-run-<epoch-us>`；时间戳保证唯一，
-- 不会混入上一轮的 trace。
freshRunDir : Member nFs FsOp r, Member nClock ClockOp r, Member nEnv EnvOp r, Member nProcess ProcessOp r => Eff r String
freshRunDir =
  do
    tmp <- envGetEnv "TMPDIR"
    stamp <- clockNow
    dir <- runDirPath tmp stamp
    _ <- ensureDirPath dir
    pure dir

-- | 内部：临时目录路径（`TMPDIR` 为空用 `/tmp`，末尾斜杠先去掉）。
runDirPath : {r : Row} -> String -> Int -> Eff r String
runDirPath tmp stamp =
  let
    base =
      if tmp == "" then
        "/tmp"
      else if endsWith "/" tmp then
        substring (natFromInt 0) (natFromInt (strLength tmp - 1)) tmp
      else
        tmp
  in pure "${base}/vuna-obs-run-${strFromInt stamp}"

-- | 内部：前置 `env VAR=VAL ...` 参数（`processRunIn` 经 shell 执行，子进程继承）。
envArgsOf : {r : Row} -> RunOpts -> String -> (Maybe String, String) -> Eff r (List String)
envArgsOf opts cwd target =
  do
    vars <- envVarsOf opts target
    pure (append ["env"] (map envPairText vars))

-- | 内部：变量集 = 级别 + 输出目录（`VUNA_OBS_DIR`，每进程一份文件）+ 采样。
envVarsOf : {r : Row} -> RunOpts -> (Maybe String, String) -> Eff r (List (String, String))
envVarsOf opts target =
  let
    levelText = if opts.runOptsLevel <= 0 then "0" else strFromInt opts.runOptsLevel
    vars =
      append
        [("VUNA_OBS", levelText)]
        (append (sinkVars target) (append (sampleVar opts) (intervalVar opts)))
  in pure vars

-- | 内部：输出位置对应的 env：子进程只拿 `VUNA_OBS_DIR`（每进程一份文件）。
sinkVars : (Maybe String, String) -> List (String, String)
sinkVars target = [("VUNA_OBS_DIR", secondOf target)]

-- | 内部：`VUNA_OBS_SAMPLE`；未指定采样种类时不设置。
sampleVar : RunOpts -> List (String, String)
sampleVar opts = if opts.runOptsSample == "" then [] else [("VUNA_OBS_SAMPLE", opts.runOptsSample)]

-- | 内部：`VUNA_OBS_INTERVAL`；未指定间隔时不设置。
intervalVar : RunOpts -> List (String, String)
intervalVar opts =
  case opts.runOptsInterval of
    Just us => [("VUNA_OBS_INTERVAL", strFromInt us)]
    Nothing => []

-- | 内部：`VAR=VAL` 文本（`env` 命令的参数形态）。
envPairText : (String, String) -> String
envPairText kv = "${firstOf kv}=${secondOf kv}"

-- | 内部：跑完打印 trace 路径——`--out` 时把本次运行的进程 trace 合成单文件；否则列目录
-- 里的 `vuna-*.jsonl`（多进程 = 多个文件）。
printTracePaths : Member nFs FsOp r, Member nConsole ConsoleOp r => (Maybe String, String) -> Eff r Int
printTracePaths target =
  case firstOf target of
    Just out => writeTraceOut out (secondOf target)
    Nothing => printDirTraces (secondOf target)

-- | 内部：`--out` 收尾：没有分文件时给「没产出」诊断；一份时逐字节拷贝；多份时合并。
writeTraceOut : Member nFs FsOp r, Member nConsole ConsoleOp r => String -> String -> Eff r Int
writeTraceOut out dir =
  do
    exists <- pathExistsDir dir
    if not exists then
      noTraceOut out
    else
      do
        names <- fsReadDir dir
        case tracePaths dir names of
          [] => noTraceOut out
          [path] => copyTraceOut out path
          paths => mergeTraceOut out paths

-- | 内部：`--out` 模式的「没产出」诊断（仍不算错误）。
noTraceOut : Member nConsole ConsoleOp r => String -> Eff r Int
noTraceOut out =
  obsLine "no trace file produced: ${out} (level 0, or the command did not honor VUNA_OBS*)"

-- | 内部：单进程 trace 逐字节写到 `--out`。先读再原子写，不用 `rename`：run 目录在
-- `TMPDIR` 下，`--out` 可能落在别的文件系统。
copyTraceOut : Member nFs FsOp r, Member nConsole ConsoleOp r => String -> String -> Eff r Int
copyTraceOut out path =
  do
    content <- fsReadFile path
    _ <- fsWriteFileAtomic out content
    obsLine "trace: ${out}"

-- | 内部：多进程 trace 合并成一份合法 trace 写到 `--out`；合并失败时打印 `error:` 与分文件
-- 路径（退出码仍由子命令决定）。
mergeTraceOut : Member nFs FsOp r, Member nConsole ConsoleOp r => String -> List String -> Eff r Int
mergeTraceOut out paths =
  do
    textR <- mergedTextOfPaths paths
    case textR of
      OkC text =>
        do
          _ <- fsWriteFileAtomic out text
          obsLine "trace: ${out}"
      ErrC e =>
        do
          _ <- obsLine "error: trace merge failed: ${diagText e}"
          obsLines (map (\p => "trace: ${p}") paths)

-- | 内部：目录里的 trace 文件完整路径（`vuna-` 前缀 + `.jsonl` 后缀）。
tracePaths : String -> List String -> List String
tracePaths dir names = map (traceLinePath dir) (filter isTraceName names)

-- | 内部：一条 `trace: <dir>/<name>` 行。
traceLine : String -> String -> String
traceLine dir name = "trace: ${traceLinePath dir name}"

-- | 内部：拼接 `<dir>/<name>`。
traceLinePath : String -> String -> String
traceLinePath dir name = "${dir}/${name}"

-- | 内部：临时目录模式的收尾行：目录不存在或没有 trace 文件也打印诊断。
printDirTraces : Member nFs FsOp r, Member nConsole ConsoleOp r => String -> Eff r Int
printDirTraces dir =
  do
    exists <- pathExistsDir dir
    if not exists then
      obsLine "no trace file produced (obs dir was not created: ${dir})"
    else
      do
        names <- fsReadDir dir
        printer <- pure (tracesAfter dir names)
        printer

-- | 内部：过滤目录里的 trace 文件名；一个都没有则打印「没产出」，否则逐行打印路径。
tracesAfter : Member nConsole ConsoleOp r => String -> List String -> Eff r Int
tracesAfter dir names =
  do
    printers <- pure (map (traceLine dir) (filter isTraceName names))
    if length printers == 0 then
      obsLine "no trace file produced in ${dir} (level 0, or the command did not honor VUNA_OBS*)"
    else
      obsLines printers

-- | 内部：目录项是否是 trace 文件（`vuna-` 前缀 + `.jsonl` 后缀）。
isTraceName : String -> Bool
isTraceName name = startsWith "vuna-" name && endsWith ".jsonl" name

-- ---------------------------------------------------------------
-- 输出（与其它工具命令一致：直接 print，退出码由调用方给）
-- ---------------------------------------------------------------
-- | 内部：打印一行并返回退出码 0。
obsLine : Member nConsole ConsoleOp r => String -> Eff r Int
obsLine s =
  do
    _ <- consolePrint "${s}\n"
    pure 0

-- | 内部：逐行打印，返回退出码 0。
obsLines : Member nConsole ConsoleOp r => List String -> Eff r Int
obsLines [] = pure 0
obsLines (s :: rest) =
  do
    _ <- obsLine s
    obsLines rest

-- | 内部：打印 `error: ...` 并返回用法错误的退出码 2。
obsRunError : Member nConsole ConsoleOp r => String -> Eff r Int
obsRunError e =
  do
    _ <- consolePrint "error: ${e}\n"
    pure 2
