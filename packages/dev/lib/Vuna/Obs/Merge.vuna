-- | 多份 trace 合并成一份合法 JSONL：`vuna dev obs merge [--out FILE] TRACE...`。
--
-- 输入是 N 份 trace（典型来源：workspace 多成员 / 每进程一份的 `vuna-<pid>.jsonl`）。
-- 合并顺序按每份 trace 的 `t0`（元数据 `args.t0`；缺失则取该文件里第一个带 `ts` 的事件；
-- 再缺则 0）稳定升序，`t0` 相同保持命令行顺序。
--
-- 输出是一份能被 `validate` 接受的 trace：首行是 `t0` 最小的那份 trace 的元数据（逐字保留，
-- schema 不变）；紧跟其后是每份 trace 一条成员行（`ph:"i"`、`ts:0`、
-- `name:"vuna.mark.merge-member"`、`args:{member, t0, pid, level, argv}`——`vuna.mark.*` 是
-- `validate` 显式放行的前缀，而 `M` 行只允许出现在首行，所以成员信息写成瞬时事件，`ts=0`
-- 不干扰时序检查）；然后按 trace 分组输出事件（组内保持文件顺序），组间按 `t0` 升序。
--
-- 这是与「按 `t0` 逐事件混排」的取舍：跨机器/跨进程的 `ts` 基准不可比，逐事件混排会造出
-- 假的时间轴；分组保留「哪段属于哪个进程」，且产物仍是合法 trace。
--
-- `pid` 保留原值（不重编号）；首份以外的事件加 `args.member`（值与成员行同键），这样两个
-- 进程 pid 撞车（不同机器同 pid）也能区分。`member` = 元数据 `exec` 的 basename（缺 `exec`
-- 时用 pid）。
--
-- 事件分组意味着同一 `pid`/`tid` 跨组出现时仍要求 `ts` 单调：同一台机器的多进程 trace 满足
-- （`t0` 排序 + 组内文件序），跨机器合并不保证（分组本身就是不混排这些时钟的理由）。
--
-- 输出：`--out` 省略 → stdout；否则先建父目录、写文件，再打印 `wrote <path> (<N> trace(s))`。
module Vuna.Obs.Merge where

import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.Sort as Sort
import Base.Data.String as String
import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Spec
import Vuna.Dev.Spec as DevSpec
import Vuna.Compiler.Base.Common
import Vuna.Json
import Vuna.Obs.Read
import Vuna.Obs.Types
import Base.Effect.Console as EffConsole
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes
import Base.Effect.Process as EffProcess

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
-- | `merge` 的用法文本。
mergeUsage : String
mergeUsage = "usage: vuna dev obs merge [--out FILE] TRACE..."

-- | `vuna dev obs merge` 的入口；参数错误 / 读盘失败 / 空 trace 文件都是退出码 2。
export runObsMerge : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nProcess ProcessOp r => List String -> Eff r Int
runObsMerge args =
  case parseCmdArgsIn DevSpec.commands ["dev", "obs", "merge"] args of
    ErrC e => mergeFail 2 (diagText e)
    OkC parsed =>
      case outOf parsed of
        ErrC e => mergeFail 2 (diagText e)
        OkC out =>
          case parsed.positionals of
            [] => mergeFail 2 mergeUsage
            paths => mergeTraces out paths

-- | 内部：读 `--out`（空串 = 用法错误）。
outOf : Parsed -> Check (Maybe String)
outOf parsed =
  case flagValue parsed "out" of
    Nothing => OkC Nothing
    Just text =>
      if text == "" then err "`--out` requires a non-empty file path" else OkC (Just text)

-- | 内部：打印 `error: ...` 并返回给定退出码。
mergeFail : Member nConsole ConsoleOp r => Int -> String -> Eff r Int
mergeFail code e =
  do
    _ <- consolePrint "error: ${e}\n"
    pure code

-- ---------------------------------------------------------------
-- 读入 + 排序
-- ---------------------------------------------------------------
-- | 合并输入的一份 trace：路径 + 已读事件 + 排序键 `t0`。
export record MergeMember(..) where
  -- | trace 文件路径（错误信息与调试用）。
  memberPath : String
  -- | 已读入的事件（含元数据）。
  memberTrace : ObsTrace
  -- | 排序键：元数据 `args.t0`，缺失时取首个带 `ts` 的事件，再缺为 0。
  memberT0 : Int

-- | 内部：逐份读入、按 `t0` 排序后产出；任一文件失败即停（错误带路径前缀，不静默跳过
-- 坏 trace）。
mergeTraces : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nProcess ProcessOp r => Maybe String -> List String -> Eff r Int
mergeTraces out paths =
  do
    membersR <- readMembers paths []
    case membersR of
      ErrC e => mergeFail 2 (diagText e)
      OkC members => emitMerged out (sortMembers members)

-- | 内部：递归读入成员；空 trace 文件、读盘失败都记为该路径的错误。
readMembers : Member nFs FsOp r => List String -> List MergeMember -> Eff r (Check (List MergeMember))
readMembers [] acc = pure (OkC (reverse acc))
readMembers (path :: rest) acc =
  do
    traceR <- readTraceFull path
    case traceR of
      ErrC e => pure (err "${path}: ${diagText e}")
      OkC trace => if length trace.traceEvents == 0 then pure (err "${path}: empty trace (no events)") else readMembers rest (MergeMember path trace (t0Of trace) :: acc)

-- | 内部：`t0`：元数据 `args.t0` 优先；缺失取首个带 `ts` 的事件；都没有 = 0。
t0Of : ObsTrace -> Int
t0Of trace =
  case trace.traceEvents of
    (Pair _ (ObsMetaEvent m)) :: rest =>
      case m.metaT0 of
        Just t0 => t0
        Nothing => firstTsOf rest
    rows => firstTsOf rows

-- | 内部：首个带 `ts` 的事件时间戳；没有则 0。
firstTsOf : List (Pair Int ObsEvent) -> Int
firstTsOf [] = 0
firstTsOf ((Pair _ ev) :: rest) =
  case eventTs ev of
    Just ts => ts
    Nothing => firstTsOf rest

-- | 内部：按 `t0` 稳定升序（相同 `t0` 保持命令行顺序）。
sortMembers : List MergeMember -> List MergeMember
sortMembers members = sortBy memberLe members

-- | 内部：成员排序谓词（按 `t0` 比较）。
memberLe : MergeMember -> MergeMember -> Bool
memberLe a b = a.memberT0 <= b.memberT0

-- ---------------------------------------------------------------
-- 产出
-- ---------------------------------------------------------------
-- | 内部：`--out` 省略则整份内容打到 stdout；否则建父目录、写文件，并打印写入路径与
-- 成员条数。
emitMerged : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nProcess ProcessOp r => Maybe String -> List MergeMember -> Eff r Int
emitMerged out members =
  let
    content = mergedText members
  in case out of
    Nothing =>
      do
        _ <- consolePrint content
        pure 0
    Just path =>
      do
        _ <- ensureDirPath (parentOf path)
        _ <- fsWriteFile path content
        _ <- consolePrint "wrote ${path} (${strFromInt (length members)} trace(s))\n"
        pure 0

-- | 合并文本（纯；键序固定、无时间戳、无绝对路径 ⇒ 同一组输入逐字节一致）。
export mergedText : List MergeMember -> String
mergedText members =
  let
    lines0 = mergeLines members
  in if length lines0 == 0 then "" else join "\n" lines0 ++ "\n"

-- | 内部：拼出整份合并文本的行：首份元数据 + 每份一条成员行 + 首份事件 + 其余成员分组事件。
mergeLines : List MergeMember -> List String
mergeLines [] = []
mergeLines (first :: rest) =
  append
    [schemaLine first]
    (append (map memberLine (first :: rest)) (append (firstMemberLines first) (memberBlockLines 1 rest)))

-- | 内部：首份 trace 的元数据行（逐字保留，含 schema / level / argv / t0）；首行不是元数据
-- 时为空串。
schemaLine : MergeMember -> String
schemaLine member =
  case memberTraceOf member of
    (Pair _ (ObsMetaEvent _)) :: _ => renderRowLine (headRow member)
    _ => ""

-- | 内部：首行事件；事件表为空时给一条占位元数据，避免越界。
headRow : MergeMember -> Pair Int ObsEvent
headRow member =
  case member.memberTrace.traceEvents of
    row :: _ => row
    [] =>
      Pair 0 (ObsMetaEvent (ObsMetaData "vuna.obs.schema" obsSchemaVersion "" 0 "" [] Nothing 0 0))

-- | 内部：成员的事件列表。
memberTraceOf : MergeMember -> List (Pair Int ObsEvent)
memberTraceOf member = member.memberTrace.traceEvents

-- | 内部：成员行：`ph:"i"` + `vuna.mark.merge-member`（`vuna.mark.*` 前缀 validate 放行，
-- `M` 只允许首行，故成员信息走瞬时事件；`ts:0` 不干扰时序检查）。键序：`member` / `t0` /
-- `pid` / `level` / `argv`。
memberLine : MergeMember -> String
memberLine member =
  case memberTraceOf member of
    (Pair _ (ObsMetaEvent m)) :: _ => renderJson (memberJson m (memberKeyOf member) member.memberT0)
    _ => ""

-- | 内部：成员行的 JSON 构造（键序见 `memberLine`）。
memberJson : ObsMetaData -> String -> Int -> Json
memberJson m key t0 =
  JObj
    [Pair "ph" (JStr "i"), Pair "ts" (JNum 0), Pair "pid" (JNum m.metaPid), Pair "tid" (JNum m.metaTid), Pair "name" (JStr "vuna.mark.merge-member"), Pair "args" (JObj [Pair "member" (JStr key), Pair "t0" (JNum t0), Pair "pid" (JNum m.metaPid), Pair "level" (JNum m.metaLevel), Pair "argv" (JArr (map JStr m.metaArgv))])]

-- | 内部：首份成员的事件行：不加 `args.member`（它就是「本机」那一份）。
firstMemberLines : MergeMember -> List String
firstMemberLines member = map renderRowLine (dropMeta member.memberTrace.traceEvents)

-- | 内部：其余成员的事件行：组内保持文件顺序，组间的先后沿用已排好的成员顺序；编号从
-- `start` 起。
memberBlockLines : Int -> List MergeMember -> List String
memberBlockLines index members = concatMap memberBlockLinesOf (zipIndices members index)

-- | 内部：一份成员的事件行（丢掉元数据，逐行渲染）。
memberBlockLinesOf : Pair Int MergeMember -> List String
memberBlockLinesOf (Pair index member) =
  map (eventLineOf index member) (dropMeta member.memberTrace.traceEvents)

-- | 内部：渲染一个事件行；`index <= 1` 视为首份、不加 `args.member`，否则加上该成员的 key。
eventLineOf : Int -> MergeMember -> Pair Int ObsEvent -> String
eventLineOf index member row =
  if index <= 1 then
    renderRowLine row
  else
    renderEventLine (withMemberArg (memberKeyOf member) (secondOf row))

-- | 内部：丢掉元数据事件（`M` 只保留首份那一行）。
dropMeta : List (Pair Int ObsEvent) -> List (Pair Int ObsEvent)
dropMeta [] = []
dropMeta ((row@(Pair _ ev)) :: rest) =
  case ev of
    ObsMetaEvent _ => dropMeta rest
    _ => row :: dropMeta rest

-- | 内部：成员标识（`args.member` 的值）：元数据 `exec` 的 basename；缺 `exec` 用 `pid`；
-- 没有元数据时为 `"0"`。
memberKeyOf : MergeMember -> String
memberKeyOf member =
  case memberTraceOf member of
    (Pair _ (ObsMetaEvent m)) :: _ =>
      if m.metaExec == "" then strFromInt m.metaPid else baseNameOf m.metaExec
    _ => "0"

-- | 内部：路径最后一段（`/a/b/c` → `c`；无 `/` 时原样）。
baseNameOf : String -> String
baseNameOf path = strPack (reverse (lastSegment (strUnpack path) []))

-- | 内部：扫描到末尾的「最后一段」：遇 `/` 就清空累积（尾递归，反向积累）。
lastSegment : List Int -> List Int -> List Int
lastSegment [] acc = acc
lastSegment (c :: rest) acc = if c == 47 then lastSegment rest [] else lastSegment rest (c :: acc)

-- | 内部：给单个事件加 `args.member`（已有该键则覆盖：合并产物里它只由 merge 决定）。
withMemberArg : String -> ObsEvent -> ObsEvent
withMemberArg key (ObsMetaEvent m) = ObsMetaEvent m
withMemberArg key (ObsSpanEvent base dur) = ObsSpanEvent (withMemberArgs key base) dur
withMemberArg key (ObsCounterEvent base value) = ObsCounterEvent (withMemberArgs key base) value
withMemberArg key (ObsInstantEvent base) = ObsInstantEvent (withMemberArgs key base)

-- | 内部：在 `args` 最前面插入 `member` 键（先删掉旧值）。
withMemberArgs : String -> ObsBase -> ObsBase
withMemberArgs key base =
  ObsBase
    base.baseTs
    base.basePid
    base.baseTid
    base.baseName
    base.baseCat
    (Pair "member" (JStr key) :: dropMemberPair base.baseArgs)

-- | 内部：删掉 `args` 里已有的 `member` 键。
dropMemberPair : List (Pair String Json) -> List (Pair String Json)
dropMemberPair [] = []
dropMemberPair ((kv@(Pair name _)) :: rest) =
  if name == "member" then dropMemberPair rest else kv :: dropMemberPair rest

-- | 内部：给成员列表编号（从 `start` 起）。
zipIndices : List MergeMember -> Int -> List (Pair Int MergeMember)
zipIndices members start = zipIndicesGo members start []

-- | 内部：`zipIndices` 的尾递归实现（反向累积后反转）。
zipIndicesGo : List MergeMember -> Int -> List (Pair Int MergeMember) -> List (Pair Int MergeMember)
zipIndicesGo [] _ acc = reverse acc
zipIndicesGo (m :: rest) index acc = zipIndicesGo rest (index + 1) (Pair index m :: acc)

-- | 内部：事件行渲染（丢弃行号）。
renderRowLine : Pair Int ObsEvent -> String
renderRowLine row = renderEventLine (secondOf row)

-- ---------------------------------------------------------------
-- golden（`_scratch/t/`，不提交）
--
-- `b.jsonl` = `_scratch/r2/vuna-6.jsonl` 的副本（pid 6→9、t0 +1000）：
--   `merge a b --out m.jsonl` 的首行是 a 的元数据（逐字），第 2/3 行是两条
--   `{"ph":"i","ts":0,...,"name":"vuna.mark.merge-member",...}` 成员行（t0 升序），
--   随后 a 的 4 个事件（不加 member）与 b 的 4 个事件（`args` 里多 `"member":"vuna"`），
--   `obs validate m.jsonl` 通过（0 error）；两次 merge md5 相同；
--   `--out` 省略时整份内容打到 stdout；空 trace 文件 = error + 退出码 2。
-- ---------------------------------------------------------------
