-- | `vuna dev obs symbols [--out FILE] [OUTDIR]`：从 split 产物抽符号表，把 OCaml 绑定名映射回
-- `.vuna` 文件与行号。
--
-- 输入是 `vuna build --no-compile --out OUTDIR` / `vuna compile <pkg> OUTDIR` 的 split 产物
-- 目录（每个模块一个 `<Unit>.ml`）。codegen 在每个 `let` / `let rec` / `and` / `external`
-- 绑定前写一行 `# <line> "<包相对路径>"`，因此纯文本扫描即可建立映射，不依赖 DWARF，
-- 也不需要编译。
--
-- 抽取规则：只认行首的 `# <line> "<file>"` 指令，且只认紧跟在它后面的第一条绑定行
-- （两条指令之间没有绑定的不产出条目）；绑定行取首个标识符。`unit` 是 `.ml` 文件名去扩展名
-- （`Main.ml` → `Main`），`ocaml` 是产物里的原始绑定名（mangling 后的 `v_Module_dName`，
-- 正是 `perf` / `gdb` 看到的名字），`file` / `line` 直接来自指令。条目按 `ocaml` 升序排序，
-- 同名再按 `unit` / `file` / `line` 升序，两次运行逐字节一致。`--out` 省略时打到 stdout。
-- 规范见 `docs/reference/observability.md` §5 与 §7 `symbols`。
module Vuna.Obs.Symbols where

import Base.Data.List as List
import Base.Data.Sort as Sort
import Base.Data.String as String
import Vuna.Cli.Args
import Vuna.Plugin.Command
import Vuna.Plugin.Args
import Vuna.Cli.Spec
import Vuna.Dev.Spec as DevSpec
import Vuna.Compiler.Base.Common
import Vuna.Files
import Vuna.Json
import Vuna.Obs.Path
import Base.Effect.Console as EffConsole
import Base.Effect.Fs as EffFs
import Base.Effect.Types as EffTypes
import Base.Effect.Process as EffProcess

-- | 一条符号定义（`vuna-symbols 1` 的 `defs` 元素）。
export record SymbolDef(..) where
  -- | 产物里的原始 OCaml 绑定名（mangling 后，`perf` / `gdb` 看到的名字）。
  symbolOcaml : String
  -- | 所属编译单元（`.ml` 文件名去扩展名）。
  symbolUnit : String
  -- | 定义所在的 `.vuna` 包相对路径。
  symbolFile : String
  -- | 定义所在行号（1-based，来自 `#line` 指令）。
  symbolLine : Int

-- | 符号表载荷的 schema 版本。
export symbolsSchemaVersion : String
symbolsSchemaVersion = "vuna-symbols 1"

-- | `vuna dev obs symbols` 的入口：解析 `--out` 与可选 OUTDIR，写出或打印符号表。
export runObsSymbols : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nProcess ProcessOp r => List String -> Eff r Int
runObsSymbols args =
  case parseCmdArgsIn DevSpec.commands ["dev", "obs", "symbols"] args of
    ErrC e => symbolsFail 2 (diagText e)
    OkC parsed =>
      case outOf parsed of
        ErrC e => symbolsFail 2 (diagText e)
        OkC out =>
          case parsed.positionals of
            [] => symbolsDir out ".output"
            [dir] => symbolsDir out dir
            _ => symbolsFail 2 "usage: vuna dev obs symbols [--out FILE] [OUTDIR]"

-- | 内部：`--out`（非空文件路径）。
outOf : Parsed -> Check (Maybe String)
outOf parsed =
  case flagValue parsed "out" of
    Nothing => OkC Nothing
    Just text =>
      if text == "" then err "`--out` requires a non-empty file path" else OkC (Just text)

-- | 内部：打印 `error: ...` 并返回给定退出码。
symbolsFail : Member nConsole ConsoleOp r => Int -> String -> Eff r Int
symbolsFail code e =
  do
    _ <- consolePrint "error: ${e}\n"
    pure code

-- ---------------------------------------------------------------
-- 读取产物目录
-- ---------------------------------------------------------------
-- | 内部：读产物目录里的全部 `.ml`、逐文件取符号定义，再排序输出；目录不存在或没有 `.ml`
-- 都按用法错误退出 2，读盘失败退出 1。
symbolsDir : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nProcess ProcessOp r => Maybe String -> String -> Eff r Int
symbolsDir out dir =
  do
    dirR <- requireDirectory dir
    case dirR of
      ErrC e => symbolsFail 2 (diagText e)
      OkC _ =>
        do
          files <- collectSourceFiles dir
          units <- mlFilesOf (filter isMlName files)
          if length units == 0 then
            symbolsFail 2 "no .ml split artifacts under ${dir} (run `vuna build --no-compile --out ${dir} <pkg>` first)"
          else
            do
              -- 没有 `.ml` 时给出可操作提示，而不是「成功但空表」。
              defsR <- scanUnits (sortBy unitLe units) []
              case defsR of
                ErrC e => symbolsFail 1 (diagText e)
                OkC defs => emitSymbols out (sortDefs defs)

-- | 内部：路径是否是 `.ml` 文件。
isMlName : String -> Bool
isMlName path = endsWith ".ml" path

-- | 内部：`Pair (unit, path)` 列表；unit 只取决于文件名（split 产物的模块名就是文件名）。
mlFilesOf : {r : Row} -> List String -> Eff r (List (String, String))
mlFilesOf paths = pure (map unitPairOf paths)

-- | 内部：路径 -> `Pair (单元名, 路径)`，单元名 = 去扩展名的文件名。
unitPairOf : String -> (String, String)
unitPairOf path = (dropMlSuffix (baseNameOf path), path)

-- | 内部：按单元名升序（确定扫描顺序）。
unitLe : (String, String) -> (String, String) -> Bool
unitLe a b = firstOf a <= firstOf b

-- | 内部：逐文件扫描并累积定义；唯一的错误来源是读盘失败，原样交给调用方。
scanUnits : Member nFs FsOp r => List (String, String) -> List SymbolDef -> Eff r (Check (List SymbolDef))
scanUnits [] acc = pure (OkC (reverse acc))
scanUnits ((unit, path) :: rest) acc =
  do
    textR <- readText path
    case textR of
      ErrC e => pure (ErrC e)
      OkC text => scanUnits rest (append (defsOfUnit unit (lines text)) acc)

-- | 内部：输出符号表——`--out` 省略时打印 JSON，否则写文件并只打印
-- `wrote <path> (<N> defs)`。
emitSymbols : Member nFs FsOp r, Member nConsole ConsoleOp r, Member nProcess ProcessOp r => Maybe String -> List SymbolDef -> Eff r Int
emitSymbols out defs =
  let
    payload = renderJson (symbolsJson defs)
  in case out of
    Nothing =>
      do
        _ <- consolePrint "${payload}\n"
        pure 0
    Just path =>
      do
        _ <- ensureDirPath (parentOf path)
        _ <- fsWriteFile path "${payload}\n"
        _ <- consolePrint "wrote ${path} (${strFromInt (length defs)} defs)\n"
        pure 0

-- ---------------------------------------------------------------
-- 文本抽取（纯）
-- ---------------------------------------------------------------
-- | 一个 `.ml` 文本 -> 符号定义（按文件中出现顺序）。
export defsOfUnit : String -> List String -> List SymbolDef
defsOfUnit unit textLines = defsOfUnitGo unit textLines Nothing []

-- | 内部：逐行扫描 `.ml` 文本并累积符号定义。`pending` 是上一条行首指令的位置，只对紧接着的
-- 下一行生效（中间隔了别的行就作废），这样 `#line` 与绑定名严格配对，不会跨声明错配。
defsOfUnitGo : String -> List String -> Maybe (String, Int) -> List SymbolDef -> List SymbolDef
defsOfUnitGo unit [] pending acc = reverse acc
defsOfUnitGo unit (line :: rest) pending acc =
  case directiveOf line of
    Just position => defsOfUnitGo unit rest (Just position) acc
    Nothing =>
      case bindingNameOf line of
        Just name =>
          case pending of
            Just (file, srcLine) =>
              defsOfUnitGo unit rest Nothing (SymbolDef name unit file srcLine :: acc)
            Nothing => defsOfUnitGo unit rest Nothing acc
        Nothing => defsOfUnitGo unit rest Nothing acc

-- | `# <line> "<file>"`（行首 `#` + 空白 + 十进制 + 空白 + 双引号字符串）。
export directiveOf : String -> Maybe (String, Int)
directiveOf line =
  let
    trimmed = trimLeft line
  in case strUnpack trimmed of
    35 :: rest => directiveTailLine rest
    _ => Nothing

-- | 内部：`#` 之后的部分——跳过空白后必须是十进制数字。
directiveTailLine : List Int -> Maybe (String, Int)
directiveTailLine chars =
  case skipBlanks chars of
    [] => Nothing
    c :: _ => if isDigitChar c then digitsDirective (skipBlanks chars) else Nothing

-- | 内部：取行号后跳过空白，要求紧跟双引号包裹的文件名。
digitsDirective : List Int -> Maybe (String, Int)
digitsDirective chars =
  case takeDigits chars [] of
    (n, rest) =>
      case skipBlanks rest of
        [] => Nothing
        c :: quoteRest =>
          if c == 34 then
            case takeUntilQuote quoteRest [] of
              Nothing => Nothing
              Just (fileChars, _) => Just (strPack fileChars, n)
          else
            Nothing

-- | 内部：跳过空格与制表符。
skipBlanks : List Int -> List Int
skipBlanks (c :: rest) = if c == 32 || c == 9 then skipBlanks rest else c :: rest
skipBlanks [] = []

-- | 内部：字符是否是 ASCII 十进制数字。
isDigitChar : Int -> Bool
isDigitChar c = c >= 48 && c <= 57

-- | 内部：取十进制数字（正序），返回解析出的整数与剩余字符。
takeDigits : List Int -> List Int -> (Int, List Int)
takeDigits (c :: rest) acc =
  if isDigitChar c then takeDigits rest (c :: acc) else (digitsToInt (reverse acc) 0, c :: rest)
takeDigits [] acc = (digitsToInt (reverse acc) 0, [])

-- | 内部：十进制数字逐位累积成整数。
digitsToInt : List Int -> Int -> Int
digitsToInt [] acc = acc
digitsToInt (c :: rest) acc = digitsToInt rest (acc * 10 + (c - 48))

-- | 内部：取到下一个双引号为止（不含引号，正序）；没有闭合引号 = `Nothing`。
takeUntilQuote : List Int -> List Int -> Maybe (List Int, List Int)
takeUntilQuote [] _ = Nothing
takeUntilQuote (c :: rest) acc =
  if c == 34 then Just (reverse acc, rest) else takeUntilQuote rest (c :: acc)

-- | 绑定行取首个标识符：`let` / `let rec` / `and` / `external`。
export bindingNameOf : String -> Maybe String
bindingNameOf line =
  let
    trimmed = trimLeft line
    words0 = split " " trimmed
  in case words0 of
    "let" :: "rec" :: name :: _ => justIdent name
    "let" :: name :: _ => justIdent name
    "and" :: name :: _ => justIdent name
    "external" :: name :: _ => justIdent name
    _ => Nothing

-- | 内部：标识符必须是 `[A-Za-z_][A-Za-z0-9_']*`（排除 `=` / `:` 等混入的形态）。
justIdent : String -> Maybe String
justIdent s = if s == "" then Nothing else if identChars (strUnpack s) then Just s else Nothing

-- | 内部：标识符字符判定（单个字符）。
identChars : List Int -> Bool
identChars [] = False
identChars (c :: rest) =
  if isLetterChar c || c == 95 then True else if isDigitChar c || c == 39 then True else False

-- | 内部：字符是否是 ASCII 字母。
isLetterChar : Int -> Bool
isLetterChar c = c >= 65 && c <= 90 || c >= 97 && c <= 122

-- ---------------------------------------------------------------
-- 排序 / JSON
-- ---------------------------------------------------------------
-- | 内部：符号定义排序（`ocaml` 升序，同名再按 `unit` / `file` / `line` 升序）。
sortDefs : List SymbolDef -> List SymbolDef
sortDefs defs = sortBy defLe defs

-- | 内部：符号定义的排序谓词（`ocaml` → `unit` → `file` → `line`）。
defLe : SymbolDef -> SymbolDef -> Bool
defLe a b =
  if a.symbolOcaml == b.symbolOcaml then
    if a.symbolUnit == b.symbolUnit then
      if a.symbolFile == b.symbolFile then
        a.symbolLine <= b.symbolLine
      else
        a.symbolFile <= b.symbolFile
    else
      a.symbolUnit <= b.symbolUnit
  else
    a.symbolOcaml <= b.symbolOcaml

-- | 内部：符号表载荷（`{"schema":"vuna-symbols 1","defs":[...]}`，键序固定）。
symbolsJson : List SymbolDef -> Json
symbolsJson defs = JObj [("schema", JStr symbolsSchemaVersion), ("defs", JArr (map defJson defs))]

-- | 内部：一条符号定义的 JSON 对象。
defJson : SymbolDef -> Json
defJson d =
  JObj
    [("ocaml", JStr d.symbolOcaml), ("unit", JStr d.symbolUnit), ("file", JStr d.symbolFile), ("line", JNum d.symbolLine)]

-- ---------------------------------------------------------------
-- golden（`_scratch/sw` = `vuna build --no-compile --out _scratch/sw compiler`，不提交）
--
-- 150 个 `.ml`、5568 条 `# <line> "<file>"` 指令；其中紧跟绑定行的 5568 条被抽成
-- 定义（let / let rec / and；本产物没有 `external`）。`type t_*` 数据声明组没有指令，
-- 因此不出现在符号表里。`defsOfUnit "Main" ["# 16 \"app/Main.vuna\"", "let v_main = ..."]`
-- → `[SymbolDef "v_main" "Main" "app/Main.vuna" 16]`。
-- 两次运行输出逐字节一致（按 ocaml 名排序 + 固定键序）。
-- ---------------------------------------------------------
