-- Web.Route 的包内测试：切段、百分号解码、参数匹配、方法与 405 的 Allow。
import Base
import Base.Effect.Core
import Base.Effect.Clock as EffClock
import Base.Effect.Console as EffConsole
import Base.Effect.Env as EffEnv
import Base.Effect.Fs as EffFs
import Base.Effect.Net as EffNet
import Web.Route as R
import Web.View as V
import Base.Effect.Exit

main : Eff [ConsoleOp, ExitOp] String
main =
  case filter (\p => not (isPassing p)) results of
    [] => pure ""
    bad =>
      do
        _ <- consolePrint ("web route failed: " ++ join "; " (map nameOf bad) ++ "\n")
        _ <- exitWith 1
        pure ""

-- | 一条检查是否通过。
isPassing : Pair String Bool -> Bool
isPassing p = p.second

-- | 检查名。
nameOf : Pair String Bool -> String
nameOf p = p.first

routes : List R.Route
routes =
  [
    R.route "GET" "/" home,
    R.route "GET" "/users/:id" userPage,
    R.route "POST" "/users/:id" userPost
  ]

home : List (Pair String String) -> Eff [FsOp, EnvOp, ClockOp, NetOp, ConsoleOp] V.View
home _ = pure (V.Text "home")

userPage : List (Pair String String) -> Eff [FsOp, EnvOp, ClockOp, NetOp, ConsoleOp] V.View
userPage params = pure (V.Text (paramOf params))

-- | 第一个参数的值（没有参数时为空串）。
paramOf : List (Pair String String) -> String
paramOf params =
  case params of
    p :: _ => p.second
    [] => ""

userPost : List (Pair String String) -> Eff [FsOp, EnvOp, ClockOp, NetOp, ConsoleOp] V.View
userPost _ = pure (V.Text "post")

results : List (Pair String Bool)
results =
  [
    Pair "split-query" (R.splitPath "/a/b?x=1" == ["a", "b"]),
    Pair "split-trailing" (R.splitPath "/a/" == ["a"]),
    Pair "split-root" (R.splitPath "/" == []),
    Pair "split-double" (R.splitPath "//a//b" == ["a", "b"]),
    Pair "decode" (R.decodeSegment "%41%42" == "AB"),
    Pair "decode-bad" (R.decodeSegment "%ZZ" == "%ZZ"),
    Pair "decode-space" (R.decodeSegment "a%20b" == "a b"),
    Pair "match-param" (R.matchSegments ["users", ":id"] ["users", "42"] == Just [Pair "id" "42"]),
    Pair "match-literal-miss" (R.matchSegments ["users"] ["posts"] == Nothing),
    Pair "match-arity-miss" (R.matchSegments ["a"] ["a", "b"] == Nothing),
    Pair "route-hit" (isJust (R.matchRoute routes "GET" "/users/42")),
    Pair "route-trailing" (isJust (R.matchRoute routes "GET" "/users/42/")),
    Pair "route-method-miss" (not (isJust (R.matchRoute routes "DELETE" "/users/42"))),
    Pair "route-method-case" (isJust (R.matchRoute routes "get" "/")),
    Pair "allow-list" (R.allowedMethods routes "/users/42" == ["GET", "POST"]),
    Pair "allow-empty" (R.allowedMethods routes "/nope" == [])
  ]
