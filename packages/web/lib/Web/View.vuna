-- | HTML 视图：视图是数据，渲染是纯函数。文本与属性值默认转义，`Raw` 是唯一的显式逃逸口。
-- | 渲染结果只取决于输入（无时间、无随机、无环境），因此可以逐字节比较。
module Web.View where

import Base

-- | 一个视图节点。
export data View(..) : Type where
  -- | 文本节点（渲染时转义 `& < > " '`）。
  Text : String -> View
  -- | 元素：名字（小写）+ 属性（按给定顺序渲染）+ 子节点。
  Element : String -> List (Pair String String) -> List View -> View
  -- | 没有自身标签的片段（多个节点的串联）。
  Fragment : List View -> View
  -- | 原样片段：调用方自证已转义。
  Raw : String -> View

-- | 渲染成 HTML 文本。
export renderView : View -> String
renderView v =
  case v of
    Text s => escapeHtml s
    Raw s => s
    Fragment vs => renderChildren vs
    Element name attrs children =>
      "<" ++ name ++ renderAttrsPart attrs ++ ">" ++ renderChildren children ++ closeTag name

-- | 一个完整的 HTML 文档骨架。
export document : String -> List View -> View
document title children =
  Fragment
    [Raw "<!doctype html>\n", Element "html" [] [Element "head" [] [Element "meta" [Pair "charset" "utf-8"] [], Element "title" [] [Text title]], Element "body" [] children]]

-- | 渲染子节点列表。
renderChildren : List View -> String
renderChildren vs = strConcatMany (map renderView vs)

-- | 属性部分（含前导空格）。
renderAttrsPart : List (Pair String String) -> String
renderAttrsPart attrs =
  case safeAttrs attrs of
    [] => ""
    hs => " " ++ join " " (map renderAttr hs)

-- | 丢弃名字不合法的属性（只允许字母、数字、`-`、`_`）。
safeAttrs : List (Pair String String) -> List (Pair String String)
safeAttrs attrs = filter isSafeAttr attrs

-- | 单个属性名是否可渲染。
isSafeAttr : Pair String String -> Bool
isSafeAttr a = strLength a.first > 0 && allNameBytes (strUnpack a.first)

-- | 全部字节都满足元素 / 属性名规则。
allNameBytes : List Int -> Bool
allNameBytes xs =
  case xs of
    [] => True
    c :: rest => if isNameByte c then allNameBytes rest else False

-- | 属性 / 元素名允许的字节。
isNameByte : Int -> Bool
isNameByte c = c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 45 || c == 95

-- | 一个属性：`name="值"`（值转义）。
renderAttr : Pair String String -> String
renderAttr a = a.first ++ "=\"" ++ escapeHtml a.second ++ "\""

-- | 闭合标签；void 元素没有。
closeTag : String -> String
closeTag name = if isVoid name then "" else "</" ++ name ++ ">"

-- | HTML void 元素（不写闭合标签）。
export voids : List String
voids =
  [
    "area",
    "base",
    "br",
    "col",
    "embed",
    "hr",
    "img",
    "input",
    "link",
    "meta",
    "source",
    "track",
    "wbr"
  ]

-- | 是否是 void 元素。
isVoid : String -> Bool
isVoid name = mem name voids

-- | 按字节转义 HTML 特殊字符。
export escapeHtml : String -> String
escapeHtml s = strConcatMany (map escapeByte (strUnpack s))

-- | 单个字节的转义。
escapeByte : Int -> String
escapeByte c =
  if c == 38 then
    "&amp;"
  else if c == 60 then
    "&lt;"
  else if c == 62 then
    "&gt;"
  else if c == 34 then "&quot;" else if c == 39 then "&#39;" else strPack [c]
