module Vuna.Target.Ocaml.Decl where

-- OCaml 名字编码 + 跨单元限定 + IR 类型/声明渲染。
--
-- 这里是 codegen 的最底层叶子，只有**纯文本**职责：
--   * 标识符渲染（sanitizeName / valueName / typeName / ctorOcamlName /
--     recordFieldLabel / ocamlString / 保留字转义 / binder 名）；
--   * 跨单元限定（`QualCtx`：名字 → 归属单元，渲染成 `Unit.name`）；
--   * `IrTy` / `IrTyDecl` → OCaml 类型文本。
-- 不消费 `DtData` / `DtDef` / `Value`：表示决策（族参数槽、keep flags、不透明字段、
-- record 字段表、去装箱族）全部由 `Lowering` 在 IR 里定好。边界由
-- `checks.ir-boundary` 守护。
import Vuna.Compiler.Base.Common
import Vuna.Compiler.Base.Source as Source
import Base.Container.HashMap as HashMap
import Vuna.Ir.Model
import Vuna.Ir.Analysis
import Vuna.Ir.Runtime
import Vuna.Target.Ocaml.Model
import Vuna.Target.Ocaml.Render as Render

-- | 构造子全名的最后一段（`Module.Data.Ctor` → `Ctor`）。
ctorShortName : String -> String
ctorShortName name = Source.lastSeg name

-- ---------------------------------------------------------------
-- 名字编码
-- ---------------------------------------------------------------
-- 除 `[A-Za-z0-9]` 外的任意字符都必须转义成 `_x<code>_`——用户符号名函数
-- （`<+>`、`>>=` 之外的声明名）会直接进 OCaml 值名，原样输出是非法标识符。
-- 与既有编码不冲突：字面标识符里的 `_` 已映射成 `_u`，输出里除转义序列外不会出现裸 `_`，
-- 因此不会与字面名冲突（`Lowering.ensureUniqueOcamlNamesIn` 仍是最后一道防线）。
isAsciiAlphaNum : Int -> Bool
isAsciiAlphaNum c = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57

sanitizeChar : Int -> List Int
-- `#` 出现在编译器合成的名字里（`#section` / `#dict…` / `#eta…`），OCaml 标识符不允许。
sanitizeChar 46 = [95, 100]
sanitizeChar 95 = [95, 117]
sanitizeChar 39 = [95, 112]
sanitizeChar 35 = [95, 104]
sanitizeChar c = if isAsciiAlphaNum c then [c] else strUnpack "_x${c}_"

export sanitizeName : String -> String
sanitizeName name = strPack (concatMap sanitizeChar (strUnpack name))

ocamlPad3 : String -> String
ocamlPad3 s = if strLength s == 1 then "00${s}" else if strLength s == 2 then "0${s}" else s

ocamlEscapeChar : Int -> List Int
ocamlEscapeChar 34 = [92, 34]
ocamlEscapeChar 92 = [92, 92]
ocamlEscapeChar 10 = [92, 110]
ocamlEscapeChar 9 = [92, 116]
ocamlEscapeChar 13 = [92, 114]
ocamlEscapeChar c = if c >= 32 && c <= 126 then [c] else strUnpack "\\${ocamlPad3 (strFromInt c)}"

export ocamlString : String -> String
ocamlString s = "\"${strPack (concatMap ocamlEscapeChar (strUnpack s))}\""

-- | 名字的**本地段**：`A.B.foo` → `foo`；无点时原样返回。
--
-- 值 / 类型 / 构造子 / 字段的 OCaml 名只编码这一段。切分单元时每个单元只装属于自己
-- 模块的声明（`SplitGen` 的归属表），因此单元内所有名字共享同一个模块前缀，剥掉它
-- 不会造成单元内重名；跨单元引用由 `qualPrefix` 写成 `Unit.name`，模块路径也只写一次。
-- 单元内重名由 `Lowering.ensureUniqueOcamlNamesIn` 在生成前报错，不会退化成 OCaml 的
-- 静默 shadowing。
export localName : String -> String
localName name = secondOf (Source.splitLastDot (Source.splitOnDot name))

export valueName : String -> String
valueName name = "v_${sanitizeName (localName name)}"

-- 单独提出来：OCaml `if` 直接作构造子实参时 早期 codegen 的括号处理不可靠，
-- 这里把它包成一个命名函数，保证自举编译本文件时生成的 OCaml 合法。
export boolText : Bool -> String
boolText True = "true"
boolText False = "false"

-- 族 → OCaml 变体类型名；构造子 → 带族前缀的变体构造子名（避免同单元内跨族重名）。
export typeName : String -> String
typeName name = "t_${sanitizeName (localName name)}"

-- | 构造子的 OCaml 名（族名 + 构造子短名）。
export ctorOcamlName : String -> String -> String
ctorOcamlName family ctor =
  "C_${sanitizeName (localName family)}_${sanitizeName (ctorShortName ctor)}"

-- | record 字段的 OCaml record label（按 record 名前缀，避免同单元内不同 record 撞标签）。
export recordFieldLabel : String -> String -> String
recordFieldLabel family field = "f_${sanitizeName (localName family)}_${sanitizeName field}"

-- ---------------------------------------------------------------
-- 跨单元引用限定
-- ---------------------------------------------------------------
--
-- split 产物里每个单元只 `open Vuna_runtime`（运行时 helper 是唯一共享前缀），
-- 其余跨单元引用（值 `v_*` / 构造子 `C_*` / 类型 `t_*`）一律渲染成 OCaml 限定名
-- `Unit.name`；同单元引用仍是裸名（`let rec` 组与类型声明内部不写自限定）。
-- `Unit` = `Driver.SplitGen` 给出的单元名（模块路径的包内部分，同时是文件名），
-- 必须已编译 —— 每单元只依赖**实际引用**
-- 到的单元（见 `typeDepsOf` 与 `Target.Ocaml.Term` 的 dep 累积），依赖图因此是精确
-- DAG 而不是「所有前序单元」的全序。
--
-- `QualCtx` 只承载「名字 → 归属单元」这两张表与当前单元；`noQual` 是 check 路径
-- （单文件装配、文本丢弃）用的空表，所有引用都回落成裸名。
export record QualCtx(..) where
  qcUnit : String
  qcDefs : HashMap String String
  qcDatas : HashMap String String

export noQual : QualCtx
noQual = QualCtx "" (HashMap.fromList []) (HashMap.fromList [])

export unitTblOf : List (String, String) -> HashMap String String
unitTblOf pairs = HashMap.insertAll pairs (HashMap.fromList [])

export unitOfTbl : HashMap String String -> String -> String
unitOfTbl tbl name =
  case HashMap.lookup name tbl of
    Just u => u
    Nothing => ""

export qualOf : String -> List (String, String) -> List (String, String) -> QualCtx
qualOf unit defs datas = QualCtx unit (unitTblOf defs) (unitTblOf datas)

-- 跨单元引用前缀：同单元 / 未知归属（内建名由调用方先处理）→ 裸名 + 无依赖。
qualPrefix : QualCtx -> String -> String -> (String, String)
qualPrefix qc owner text =
  if owner == "" || owner == qc.qcUnit then (text, "") else ("${owner}.${text}", owner)

-- (OCaml 文本, 依赖单元或 "")
export qualValueText : QualCtx -> String -> (String, String)
qualValueText qc name = qualPrefix qc (unitOfTbl qc.qcDefs name) (valueName name)

export qualCtorText : QualCtx -> String -> String -> (String, String)
qualCtorText qc family ctor =
  qualPrefix qc (unitOfTbl qc.qcDatas family) (ctorOcamlName family ctor)

export qualTypeText : QualCtx -> String -> (String, String)
qualTypeText qc name = qualPrefix qc (unitOfTbl qc.qcDatas name) (typeName name)

-- lambda binder 是唯一直接写裸标识符的地方（值/类型/构造子名都有 v_/t_/C_ 前缀，
-- 不会撞 OCaml 保留字）。vuna 允许 `method` / `type` 一类标识符，OCaml 不允许，这里统一
-- 加后缀 `_` 转义，保证「能 check 就能 compile」。
ocamlReservedWords : List String
ocamlReservedWords =
  [
    "and",
    "as",
    "assert",
    "asr",
    "begin",
    "class",
    "constraint",
    "do",
    "done",
    "downto",
    "else",
    "end",
    "exception",
    "external",
    "false",
    "for",
    "fun",
    "function",
    "functor",
    "if",
    "in",
    "include",
    "inherit",
    "initializer",
    "land",
    "lazy",
    "let",
    "lor",
    "lsl",
    "lsr",
    "lxor",
    "match",
    "method",
    "mod",
    "module",
    "mutable",
    "new",
    "nonrec",
    "object",
    "of",
    "open",
    "or",
    "private",
    "rec",
    "sig",
    "struct",
    "then",
    "to",
    "true",
    "try",
    "type",
    "val",
    "virtual",
    "when",
    "while",
    "with"
  ]

export ocamlBinderName : String -> String
ocamlBinderName name =
  let
    oc = sanitizeName name
  in if memName oc ocamlReservedWords then "${oc}_" else oc

-- ---------------------------------------------------------------
-- IR 类型 / 类型声明 → OCaml 文本
-- ---------------------------------------------------------------
--
-- `IrTy` 是 Lowering 决策后的签名级运行时类型：族参数槽（`IrTyVar i` → `'a<i>`）、
-- primitive、内建类型构造子、程序数据族、显式函数、不可命名值（`Obj.t`）。这里只
-- 做文本渲染与跨单元限定，**不含**任何表示判据。
export irBinderText : IrBinder -> String
irBinderText (IrBinder _ (IrBUser name) erased _) = ocamlBinderName name
irBinderText (IrBinder _ (IrBArm n) erased _) = "dtb__${strFromInt n}"
irBinderText (IrBinder _ (IrBNat n) erased _) = "dtnat__${strFromInt n}"
irBinderText (IrBinder _ IrBWild erased _) = "_"

export irTyText : QualCtx -> IrTy -> String
irTyText qc ty = Render.renderTy (qualFamOf qc) (toOTy ty)

-- | 族名 → 已限定的类型名（同单元裸名，跨单元 `Unit.t_*`）。
qualFamOf : QualCtx -> String -> String
qualFamOf qc fam = firstOf (qualTypeText qc fam)

toOTy : IrTy -> OTy
toOTy (IrTyVar i) = OTVar i
toOTy IrTyInt = OTInt
toOTy IrTyStr = OTStr
toOTy IrTyBool = OTBool
toOTy IrTyFloat = OTFloat
toOTy IrTyOpaque = OTOpaque
toOTy (IrTyArray a) = OTArray (toOTy a)
toOTy (IrTyRef a) = OTRef (toOTy a)
toOTy (IrTyFun d c) = OTFun (toOTy d) (toOTy c)
toOTy (IrTyData fam args) = OTData fam (map toOTy args)

toODecl : IrTyDecl -> ODecl
-- `Eff` 在 OCaml 后端用不透明表示：单个构造子 `MkEff` 只有 thunk 字段，运行时值就是
-- 该闭包本身（`Obj.repr` 恒等），类型写成 `Obj.t`。不写成函数类型别名是有意的：
-- 零参顶层定义会因值限制出现弱类型变量。别的后端（native/wasm）仍按装箱 data 处理，
-- 各自的 CPS/机器代码不需要区分。
toODecl (IrVariantDecl name n ctors) =
  if name == irEffTypeName then
    ODAlias n (typeName name) OTOpaque
  else
    ODVariant n (typeName name) (map (toOCtor name) ctors)
toODecl (IrRecordDecl name n fields tys) =
  ODRecord n (typeName name) (recordFieldsOf name fields tys)
toODecl (IrUnboxedDecl name n ty) = ODAlias n (typeName name) (toOTy ty)

toOCtor : String -> (String, List IrTy) -> OCtor
toOCtor family (ctor, tys) = OCtor (ctorOcamlName family ctor) (map toOTy tys)

recordFieldsOf : String -> List (Int, String) -> List IrTy -> List (String, OTy)
recordFieldsOf family [] tys = []
recordFieldsOf family (f :: fs) tys =
  case tys of
    [] => []
    t :: ts => (recordFieldLabel family (secondOf f), toOTy t) :: recordFieldsOf family fs ts

-- | 一个单元的类型声明块：空表 → ""；否则 `type ... \nand ...\n\n`（末尾空行固定，保证产物逐字节稳定）。
export irTypeDeclsText : QualCtx -> List IrTyDecl -> String
irTypeDeclsText qc decls = Render.renderDecls (qualFamOf qc) (map toODecl decls)

-- | 类型声明里引用到的**运行时族**归属单元（去重、首现顺序；同单元与未知归属跳过）。
export irTyDeclDeps : QualCtx -> List IrTy -> List String
irTyDeclDeps qc tys = irTyDepsGo qc (concatMap irTyGlobalNames tys) []

irTyGlobalNames : IrTy -> List String
irTyGlobalNames (IrTyVar i) = []
irTyGlobalNames IrTyInt = []
irTyGlobalNames IrTyStr = []
irTyGlobalNames IrTyBool = []
irTyGlobalNames IrTyFloat = []
irTyGlobalNames IrTyOpaque = []
irTyGlobalNames (IrTyArray a) = irTyGlobalNames a
irTyGlobalNames (IrTyRef a) = irTyGlobalNames a
irTyGlobalNames (IrTyFun d c) = append (irTyGlobalNames d) (irTyGlobalNames c)
irTyGlobalNames (IrTyData fam args) = fam :: concatMap irTyGlobalNames args

irTyDepsGo : QualCtx -> List String -> List String -> List String
irTyDepsGo qc [] acc = reverse acc
irTyDepsGo qc (n :: rest) acc =
  let
    owner = unitOfTbl qc.qcDatas n
  in if owner == "" || owner == qc.qcUnit then
    irTyDepsGo qc rest acc
  else if memName owner acc then irTyDepsGo qc rest acc else irTyDepsGo qc rest (owner :: acc)
