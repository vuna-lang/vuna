module Vuna.Target.Ocaml.Assembly where

-- split 产物的**唯一装配实现**。
--
-- 本模块只消费 IR：`genUnitParts` 把 `IrUnit`（类型声明 + 分组 +
-- List 族标志）装成「open 头 + 类型声明 + List 桥接 + 分组正文」的片段与生成状态。
-- 准备阶段（擦除检查 / 名字护栏 / SCC 分组）在 `Lowering`；main 钩子
-- 统一由 `Codegen.Term.genEntryHook` 渲染。check 路径在 `Driver.Dt` 里走
-- `Lower.lowerProgramOf` + `genUnitParts` 并丢弃文本（`buildText=False`）。
--
-- 单元文件头只 `open Vuna_runtime`，其余跨单元引用一律由 `Codegen.Decl` /
-- `Codegen.Term` 生成 `Unit.name` 全限定名；`UnitParts` 同时带出该单元**直接引用**
-- 到的依赖单元（`unitPartsDeps`），供 `Driver.SplitGen` 写进 `SplitFile` 与 build.sh。
import Vuna.Compiler.Base.Common
import Vuna.Ir.Model
import Vuna.Ir.Analysis
import Vuna.Ir.Runtime
import Vuna.Target.Ocaml.Decl
import Vuna.Target.Ocaml.Term
import Vuna.Target.Ocaml.Render

-- 运行时前缀单元：`Vuna_runtime.ml` 只有 `dtRuntime`，是唯一被其余单元 open 的单元。
export runtimeUnit : String
runtimeUnit = "Vuna_runtime"

-- 装配片段：文件头（open 头）、类型声明、List 桥接、按 SCC 顺序的正文，外加生成状态
-- 与该单元的直接依赖单元。构造子不导出：调用方只能经 `genUnitText` / `unitPartsDeps`
-- 读取，避免各处重复实现拼接顺序。
export record UnitParts where
  unitPartsFragments : List String
  unitPartsBodies : List String
  unitPartsState : GenSt
  unitPartsDeps : List String

export unitPartsDeps : UnitParts -> List String
unitPartsDeps (UnitParts fragments bodies st deps) = deps

-- 单个单元的装配片段。
--   qc     ：跨单元限定上下文（当前单元 + 名字归属表；check 路径用 `noQual`）
--   shared ：程序级共享元数据（Lowering 一次算好）
--   unitIr ：本单元的 IR（类型声明 / 分组 / List 族标志）
--
-- `#line` 的路径归一函数由调用方给（split 路径用包相对路径，check 路径文本被丢弃，
-- 用恒等即可）。见 `docs/reference/observability.md` §5。
export genUnitParts : QualCtx -> IrShared -> IrUnit -> Check UnitParts
genUnitParts qc shared unitIr = genUnitPartsWith (\p => p) qc shared unitIr

export genUnitPartsWith : (String -> String) -> QualCtx -> IrShared -> IrUnit -> Check UnitParts
genUnitPartsWith norm qc shared unitIr =
  Vuna.Compiler.Base.Common.bind (genTypePart qc unitIr) (
      \typeText =>
        let
          _ = dbg! "cg-typedecls-done"
        in case genGroups (mkGenStWith norm qc shared) unitIr.irUnitGroups of
          ErrC e => ErrC e
          OkC (Pair bodies st) =>
            let
              _ = dbg! "cg-genGroups-done"
              deps = uniqueDeps (append (append [runtimeUnit] (typeRefDeps qc unitIr.irUnitTypeRefs)) st.gsDeps)
            in OkC (UnitParts [openHeader qc, typeText, listBridgeFor shared unitIr] bodies st deps)
    )

-- | check 路径的结构检查：只验证「每个运行时定义都有体」（生成期唯一的错误点），
-- 不拼任何文本。文本生成是纯渲染（`Codegen.Term` 只有这一处 `ErrC`），
-- 因此跳过它不削弱「能 check 就能 build」。
export checkUnitParts : IrShared -> IrUnit -> Check Int
checkUnitParts shared unitIr = checkGroupsForBuild unitIr.irUnitGroups

checkGroupsForBuild : List IrGroup -> Check Int
checkGroupsForBuild [] = OkC 0
checkGroupsForBuild (g :: rest) =
  Vuna.Compiler.Base.Common.bind
    (checkDefsForBuild (irGroupDefs g))
    (\_ => checkGroupsForBuild rest)

checkDefsForBuild : List IrDef -> Check Int
checkDefsForBuild [] = OkC 0
checkDefsForBuild (d :: rest) =
  case irDefExtern d of
    Just _ => checkDefsForBuild rest
    Nothing =>
      case irDefBody d of
        Nothing =>
          ErrC
            (withContext (irDefSpan d) (irDefName d) (diagNoLoc SevError PhInternal CatInternal "IC_AxiomRuntime" "axiom reached runtime code generation (partition must erase it)"))
        Just _ => checkDefsForBuild rest

genTypePart : QualCtx -> IrUnit -> Check String
genTypePart qc unitIr = OkC (irTypeDeclsText qc unitIr.irUnitTyDecls)

-- 依赖清单去重（保持首次出现顺序；生成期只按引用顺序累积）。
addDep : List String -> String -> List String
addDep acc dep = if dep == "" || memName dep acc then acc else append acc [dep]

uniqueDeps : List String -> List String
uniqueDeps deps = foldl addDep [] deps

-- 片段拼接：open 头 + 类型 + 桥接 + 正文（正文之间空行分隔，末尾不带换行；
-- 调用方按需要补换行/钩子）。
export genUnitText : UnitParts -> String
genUnitText (UnitParts fragments bodies st deps) =
  strConcatMany (append fragments [joinWith "\n\n" bodies])

-- 单元文件头：只 open 运行时单元（其余跨单元引用都是 `Unit.name` 全限定，没有
-- open 链，因此文件顺序不再决定可见性，只看 `unitPartsDeps`）。check 路径（`noQual`，
-- qcUnit="") 不写 open。
export openHeader : QualCtx -> String
openHeader qc = if qc.qcUnit == "" then "" else "open ${runtimeUnit}\n"

-- List 族桥接只写进声明该族的单元；其它单元通过 `Unit.dtp_*` 全限定名引用。
listBridgeFor : IrShared -> IrUnit -> String
listBridgeFor shared unitIr =
  if unitIr.irUnitHasListFamily then dtListBridge shared.irSharedListFam else ""

-- 类型声明里引用到的**族名** → 归属单元（去重、首现顺序；同单元与未知归属跳过）。
-- 输入是 `IrUnit.irUnitTypeRefs`（Lowering 已按声明顺序收集好的全局族名表）。
typeRefDeps : QualCtx -> List String -> List String
typeRefDeps qc [] = []
typeRefDeps qc (n :: rest) =
  let
    owner = unitOfTbl qc.qcDatas n
  in if owner == "" || owner == qc.qcUnit then
    typeRefDeps qc rest
  else if memName owner (typeRefDeps qc rest) then
    typeRefDeps qc rest
  else
    owner :: typeRefDeps qc rest
