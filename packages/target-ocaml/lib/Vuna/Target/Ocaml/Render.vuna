-- | OCaml 后端的文本渲染：把 [Vuna.Target.Ocaml.Model] 的类型面渲染成
-- OCaml 文本。这里只做括号、分隔符与布局，不做任何表示决策。
--
-- `qualFamily` 由调用方给：族名 → 该族在本单元里的类型名（同单元裸名，跨单元
-- `Unit.t_*`）。渲染器不持有归属表。
module Vuna.Target.Ocaml.Render where

import Vuna.Compiler.Base.Common
import Vuna.Target.Ocaml.Model

-- | 一次性线性拼接：先插分隔符成列表，再用运行时 `String.concat` 单遍拼出。
export joinWith : String -> List String -> String
joinWith sep xs = strConcatMany (interpose sep xs)

interpose : String -> List String -> List String
interpose sep [] = []
interpose sep ([x]) = [x]
interpose sep (x :: rest) = x :: sep :: interpose sep rest

typeParamName : Int -> String
typeParamName i = "'a${strFromInt i}"

typeParamDecl : Int -> String
typeParamDecl 0 = ""
typeParamDecl n =
  case map typeParamName (range 0 n) of
    [only] => "${only} "
    names => "(${joinWith ", " names}) "

familyTy : String -> List String -> String
familyTy name [] = name
familyTy name ([a]) = "${a} ${name}"
familyTy name args = "(${joinWith ", " args}) ${name}"

-- | 渲染类型表达式；`qualFamily` 把族名映射成已限定的类型名。
export renderTy : (String -> String) -> OTy -> String
renderTy qual (OTVar i) = typeParamName i
renderTy qual OTInt = "int"
renderTy qual OTStr = "string"
renderTy qual OTBool = "bool"
renderTy qual OTFloat = "float"
renderTy qual OTOpaque = "Obj.t"
renderTy qual (OTArray a) = "(${renderTy qual a} array)"
renderTy qual (OTRef a) = "(${renderTy qual a} ref)"
renderTy qual (OTFun d c) = "(${renderTy qual d}) -> ${renderTy qual c}"
renderTy qual (OTData fam args) = familyTy (qual fam) (map (renderTy qual) args)

ctorDecl : (String -> String) -> OCtor -> String
ctorDecl qual c =
  case c.ocFields of
    [] => c.ocName
    [t] => "${c.ocName} of (${renderTy qual t})"
    ts => "${c.ocName} of ${joinWith " * " (map (\t => "(${renderTy qual t})") ts)}"

-- | 单条声明（不带 `type ` 前缀与 `and ` 连接符）。
export renderDecl : (String -> String) -> ODecl -> String
renderDecl qual (ODVariant n name []) = "${typeParamDecl n}${name} = |"
renderDecl qual (ODVariant n name ctors) =
  "${typeParamDecl n}${name} = ${joinWith " | " (map (ctorDecl qual) ctors)}"
renderDecl qual (ODRecord n name fields) =
  "${typeParamDecl n}${name} = { ${joinWith "; " (map (fieldDecl qual) fields)} }"
renderDecl qual (ODAlias n name ty) = "${typeParamDecl n}${name} = ${renderTy qual ty}"

fieldDecl : (String -> String) -> (String, OTy) -> String
fieldDecl qual (label, ty) = "${label} : ${renderTy qual ty}"

-- | 一个单元的类型声明块：空表 → `""`；否则 `type ... \nand ...\n\n`（末尾空行固定）。
export renderDecls : (String -> String) -> List ODecl -> String
renderDecls qual [] = ""
renderDecls qual decls = "type ${joinWith "\nand " (map (renderDecl qual) decls)}\n\n"

-- ---------------------------------------------------------------
-- 项面
-- ---------------------------------------------------------------
-- 括号策略与既有产物一致：应用、λ、let、if、match、cast、投影都自带括号，因此
-- 调用方不需要再关心优先级。
export renderPat : OPat -> String
renderPat (OPVar n) = n
renderPat OPWild = "_"
renderPat (OPCtorPat c []) = c
renderPat (OPCtorPat c ps) = "${c} (${joinWith ", " (map renderPat ps)})"
renderPat (OPRecordPat fields) = "{ ${joinWith "; " (map fieldAssign fields)} }"

fieldAssign : (String, OPat) -> String
fieldAssign (label, p) = "${label} = ${renderPat p}"

binderText : (String, Maybe String) -> String
binderText (name, Nothing) = name
binderText (name, Just t) = "(${name} : ${t})"

export renderTerm : OTerm -> String
renderTerm (OName s) = s
renderTerm (ORaw s) = s
renderTerm (OApp f a) = "(${renderTerm f} ${renderTerm a})"
renderTerm (OLam [] body) = renderTerm body
renderTerm (OLam ps body) = "(fun ${joinWith " " (map binderText ps)} -> ${renderTerm body})"
renderTerm (OLet pat scrut body) =
  "(let ${renderPat pat} = ${renderTerm scrut} in ${renderTerm body})"
renderTerm (OIf c th el) = "(if ${renderTerm c} then ${renderTerm th} else ${renderTerm el})"
renderTerm (OMatch scrut arms fallback) =
  let
    body = joinWith "" (map renderArm arms)
    fb = if fallback then "" else "  | _ -> failwith \"DT: impossible branch\"\n"
  in "(match ${renderTerm scrut} with\n${body}${fb})"
renderTerm (OCtorApp c []) = c
renderTerm (OCtorApp c ([a])) = "(${c} (${renderTerm a}))"
renderTerm (OCtorApp c args) = "(${c} (${joinWith ", " (map renderTerm args)}))"
renderTerm (ORecordCon fields) = "{ ${joinWith "; " (recordFields fields)} }"
renderTerm (ORecordUpd base fields) =
  "{ ${renderTerm base} with ${joinWith "; " (recordFields fields)} }"
renderTerm (OProj base label) = "(${renderTerm base}).${label}"
renderTerm (OConcatStr parts) = "(String.concat \"\" [${joinWith "; " (map renderTerm parts)}])"
renderTerm (OCast e) = "(Obj.magic ${renderTerm e})"
renderTerm (OAnnot e ty) = "(${renderTerm e} : ${ty})"

renderArm : (OPat, OTerm) -> String
renderArm (pat, body) = "  | ${renderPat pat} -> ${renderTerm body}\n"

recordField : (String, OTerm) -> String
recordField (label, v) = "${label} = ${renderTerm v}"

recordFields : List (String, OTerm) -> List String
recordFields fields = map recordField fields
