module Vuna.Target.Native.Select where

-- native 后端的标量指令选择。
--
-- 把白名单里**不分配、不触发 GC、只碰 rax/r11** 的运行时叶子在调用点展开成机器
-- 序列：`Module` 用 [scalarPlanOf] 判断能否内联，用 [scalarInstrs] 发射。语义与
-- `Native.Runtime` 的同名模板逐条对应（算术的 63-bit wrap、位运算不 wrap、
-- Nat 饱和/夹取、比较返回 0/1），
-- 词表只有这里一份；`RuntimeTable` 单测用 [scalarPlanOf] 第二项与
-- `Runtime.nativeRtTarget` 交叉校验。
--
-- 边界：只 import Base 与 `Native.{Abi,Model}`；不依赖 IR。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Model

-- | 一个可内联的标量叶子。
export data ScalarOp(..) : Type where
  -- | 63-bit wrap 的算术二元指令（`add` / `sub` / `imul`）。
  ScalarWrap : String -> ScalarOp
  -- | 位运算二元指令（`and` / `or` / `xor`）：规范化对位运算封闭，不需要 wrap。
  ScalarBitOp : String -> ScalarOp
  -- | 比较：`cmp` + `setcc` + `movzx`，结果 0/1。
  ScalarCmp : String -> ScalarOp
  -- | `xor -1`（`bitNot`）：同样对规范化封闭。
  ScalarBitNot : ScalarOp
  -- | Nat 饱和加法。
  ScalarNatAdd : ScalarOp
  -- | Nat 截断减法（下溢到 0）。
  ScalarNatSub : ScalarOp
  -- | Int -> Nat（负数夹到 0）。
  ScalarNatFromInt : ScalarOp
  -- | Nat -> Int（恒等）。
  ScalarNatToInt : ScalarOp
  -- | 恒返回常量的零参桩（调试 / 可观测性叶子）。
  ScalarConst : Int -> ScalarOp

-- | IR 符号 -> 内联计划 + 对应运行时标签（后者只用于一致性测试）。
export scalarPlanOf : String -> Maybe (Pair ScalarOp String)
scalarPlanOf "+" = Just (Pair (ScalarWrap "add") (nativeRtLabel "add"))
scalarPlanOf "-" = Just (Pair (ScalarWrap "sub") (nativeRtLabel "sub"))
scalarPlanOf "*" = Just (Pair (ScalarWrap "imul") (nativeRtLabel "mul"))
scalarPlanOf "bitAnd" = Just (Pair (ScalarBitOp "and") (nativeRtLabel "bit_and"))
scalarPlanOf "bitOr" = Just (Pair (ScalarBitOp "or") (nativeRtLabel "bit_or"))
scalarPlanOf "bitXor" = Just (Pair (ScalarBitOp "xor") (nativeRtLabel "bit_xor"))
scalarPlanOf "bitNot" = Just (Pair ScalarBitNot (nativeRtLabel "bit_not"))
scalarPlanOf "bi_eq_int" = Just (Pair (ScalarCmp "sete") (nativeRtLabel "eq_int"))
scalarPlanOf "bi_neq_int" = Just (Pair (ScalarCmp "setne") (nativeRtLabel "neq_int"))
scalarPlanOf "bi_lt_int" = Just (Pair (ScalarCmp "setl") (nativeRtLabel "lt_int"))
scalarPlanOf "bi_le_int" = Just (Pair (ScalarCmp "setle") (nativeRtLabel "le_int"))
scalarPlanOf "bi_gt_int" = Just (Pair (ScalarCmp "setg") (nativeRtLabel "gt_int"))
scalarPlanOf "bi_ge_int" = Just (Pair (ScalarCmp "setge") (nativeRtLabel "ge_int"))
scalarPlanOf "bi_lt_bool" = Just (Pair (ScalarCmp "setl") (nativeRtLabel "lt_int"))
scalarPlanOf "bi_le_bool" = Just (Pair (ScalarCmp "setle") (nativeRtLabel "le_int"))
scalarPlanOf "bi_gt_bool" = Just (Pair (ScalarCmp "setg") (nativeRtLabel "gt_int"))
scalarPlanOf "bi_ge_bool" = Just (Pair (ScalarCmp "setge") (nativeRtLabel "ge_int"))
scalarPlanOf "natToInt" = Just (Pair ScalarNatToInt (nativeRtLabel "nat_to_int"))
scalarPlanOf "natFromInt" = Just (Pair ScalarNatFromInt (nativeRtLabel "nat_from_int"))
scalarPlanOf "natAdd" = Just (Pair ScalarNatAdd (nativeRtLabel "nat_add"))
scalarPlanOf "natSub" = Just (Pair ScalarNatSub (nativeRtLabel "nat_sub"))
scalarPlanOf "@vuna@debug@on" = Just (Pair (ScalarConst 0) (nativeRtLabel "debug_on"))
scalarPlanOf "@vuna@debug@line" = Just (Pair (ScalarConst 0) (nativeRtLabel "debug_line"))
scalarPlanOf "@vuna@obs@level" = Just (Pair (ScalarConst 0) (nativeRtLabel "obs_level"))
scalarPlanOf "@vuna@obs@log" = Just (Pair (ScalarConst 0) (nativeRtLabel "obs_log"))
scalarPlanOf "@vuna@obs@counter" = Just (Pair (ScalarConst 0) (nativeRtLabel "obs_counter"))
scalarPlanOf "@vuna@obs@mark" = Just (Pair (ScalarConst 0) (nativeRtLabel "obs_mark"))
scalarPlanOf "@vuna@obs@spanBegin" = Just (Pair (ScalarConst 0) (nativeRtLabel "obs_span_begin"))
scalarPlanOf "@vuna@obs@spanEnd" = Just (Pair (ScalarConst 0) (nativeRtLabel "obs_span_end"))
scalarPlanOf "@vuna@obs@sampleStart" =
  Just (Pair (ScalarConst 0) (nativeRtLabel "obs_sample_start"))
scalarPlanOf "@vuna@obs@sampleStop" = Just (Pair (ScalarConst 0) (nativeRtLabel "obs_sample_stop"))
scalarPlanOf _ = Nothing

-- | 展开序列：`a` / `b` 是实参寄存器（一元 / 零元的 `b` 只作 scratch），返回结果
--   寄存器与指令。可能改写两个实参寄存器，调用方把两者都当临时寄存器回收。
export scalarInstrs : ScalarOp -> Reg -> Reg -> Pair Reg (List Instr)
scalarInstrs (ScalarWrap op) a b =
  Pair a [IBinReg op a (OpReg b), IBinReg "shl" a (OpImm 1), IBinReg "sar" a (OpImm 1)]
-- | 两个操作数都是规范化（63-bit 符号扩展）值时，按位结果也规范化。
scalarInstrs (ScalarBitOp op) a b = Pair a [IBinReg op a (OpReg b)]
scalarInstrs (ScalarCmp cond) a b = Pair Rax [ICmp (OpReg a) (OpReg b), ISetcc cond Rax, IMovzxAl]
scalarInstrs ScalarBitNot a _ = Pair a [IBinReg "xor" a (OpImm (0 - 1))]
scalarInstrs ScalarNatAdd a b =
  Pair
    a
    [IBinReg "add" a (OpReg b), IMov (OpReg b) (OpImm nativeMaxInt), ICmp (OpReg a) (OpReg b), ICmov "cmovg" a (OpReg b)]
scalarInstrs ScalarNatSub a b =
  Pair a [IBinReg "sub" a (OpReg b), IMov (OpReg b) (OpImm 0), ICmov "cmovl" a (OpReg b)]
scalarInstrs ScalarNatFromInt a b =
  Pair a [IMov (OpReg b) (OpImm 0), ICmp (OpReg a) (OpReg b), ICmov "cmovl" a (OpReg b)]
scalarInstrs ScalarNatToInt a _ = Pair a []
scalarInstrs (ScalarConst n) a _ = Pair a [IMov (OpReg a) (OpImm n)]

-- | 与 [scalarInstrs] 相同，但省掉算术的 63-bit wrap。只在这个值**随后只被 mod 2^63
--   语义的操作（加减乘）或清高位的掩码消费**时可用：两层 wrap 之间其它的运算只影响
--   高位，最终结果不变。
export scalarInstrsNoWrap : ScalarOp -> Reg -> Reg -> Pair Reg (List Instr)
scalarInstrsNoWrap (ScalarWrap op) a b = Pair a [IBinReg op a (OpReg b)]
scalarInstrsNoWrap op a b = scalarInstrs op a b

-- ---------------------------------------------------------------
-- 除以编译期常量
-- ---------------------------------------------------------------
-- | 常量除法的展开计划。`d = 0` / `d = -1` 不内联：除零要 trap、`min_int / -1` 在
--   运行时返回 `min_int`（不触发 x86 `#DE`），这两条语义留给 `rt_div`。
export data DivPlan(..) : Type where
  -- | `d = 2^k`：符号修正移位 `(x + (x >> 63 & (d-1))) >> k`（向零截断）。
  DivShift : Int -> DivPlan
  -- | 其它常量：`cqo` + `idiv`（除数装进 scratch 寄存器）。
  DivIdiv : Int -> DivPlan

-- | 常数除数 → 展开计划；不是正 2 的幂且不在 `idiv` 的可用范围时返回 `Nothing`。
export divPlanOf : Int -> Maybe DivPlan
divPlanOf d =
  if d == 0 || d == 0 - 1 then
    Nothing
  else if d < 0 then
    Nothing
  else if d > 2147483647 then
    Nothing
  else
    case pow2Shift 64 d 0 of
      -- 负数常量除数也能展开，但收益只在这些热点上出现；留给运行时，避免符号修正写错。
      Just k => Just (DivShift k)
      Nothing => Just (DivIdiv d)

pow2Shift : Int -> Int -> Int -> Maybe Int
pow2Shift fuel d k =
  if fuel <= 0 then
    Nothing
  else if d == 1 then
    Just k
  else if d - d / 2 * 2 == 0 then pow2Shift (fuel - 1) (d / 2) (k + 1) else Nothing

-- | 标量比较的反向跳转条件（`IrIf` 的条件直接发 `cmp` + `jcc`，不再物化 0/1）。
export branchInverse : String -> Maybe String
branchInverse "bi_eq_int" = Just "jne"
branchInverse "bi_neq_int" = Just "je"
branchInverse "bi_lt_int" = Just "jge"
branchInverse "bi_le_int" = Just "jg"
branchInverse "bi_gt_int" = Just "jle"
branchInverse "bi_ge_int" = Just "jl"
branchInverse "bi_eq_bool" = Just "jne"
branchInverse "bi_neq_bool" = Just "je"
branchInverse "bi_lt_bool" = Just "jge"
branchInverse "bi_le_bool" = Just "jg"
branchInverse "bi_gt_bool" = Just "jle"
branchInverse "bi_ge_bool" = Just "jl"
branchInverse _ = Nothing

-- ---------------------------------------------------------------
-- 浮点比较
-- ---------------------------------------------------------------
-- | 有序比较的 0/1 物化：`ucomisd xmm<a>, xmm<b>` 之后先看 PF（NaN ⇒ 一律 false）。
--   与 `Native.Runtime` 的 `float_*` 模板共用同一份序列（Runtime 从这里取）。
export floatOrderedCmpAt : Int -> Int -> String -> List Instr
floatOrderedCmpAt a b cc =
  [
    IXmmCmp a b,
    ISetcc "setnp" Rax,
    IMovzxAl,
    ISetcc cc Rdx,
    IBinReg "and" Rdx (OpImm 1),
    IBinReg "and" Rax (OpReg Rdx)
  ]

export floatOrderedCmp : String -> List Instr
floatOrderedCmp cc = floatOrderedCmpAt 0 1 cc

-- | `!=`：NaN 参与时结果为 true（与 OCaml `<>` 一致）。
export floatNeqCmpAt : Int -> Int -> List Instr
floatNeqCmpAt a b =
  [
    IXmmCmp a b,
    ISetcc "setne" Rax,
    IMovzxAl,
    ISetcc "setp" Rdx,
    IBinReg "and" Rdx (OpImm 1),
    IBinReg "or" Rax (OpReg Rdx)
  ]

export floatNeqCmp : List Instr
floatNeqCmp = floatNeqCmpAt 0 1

-- | IR 的浮点比较符号 → 0/1 物化序列（操作数已装在两个 xmm 寄存器）。
export floatCompareInstrsAt : Int -> Int -> String -> Maybe (List Instr)
floatCompareInstrsAt a b "bi_eq_float" = Just (floatOrderedCmpAt a b "sete")
floatCompareInstrsAt a b "bi_neq_float" = Just (floatNeqCmpAt a b)
floatCompareInstrsAt a b "bi_lt_float" = Just (floatOrderedCmpAt a b "setb")
floatCompareInstrsAt a b "bi_le_float" = Just (floatOrderedCmpAt a b "setbe")
floatCompareInstrsAt a b "bi_gt_float" = Just (floatOrderedCmpAt a b "seta")
floatCompareInstrsAt a b "bi_ge_float" = Just (floatOrderedCmpAt a b "setae")
floatCompareInstrsAt _ _ _ = Nothing

export floatCompareInstrs : String -> Maybe (List Instr)
floatCompareInstrs sym = floatCompareInstrsAt 0 1 sym

-- ---------------------------------------------------------------
-- 窥孔：只做局部、可证明安全的合并
-- ---------------------------------------------------------------
-- | 槽写完又立刻读回（rax 里的值没变）时删掉读。
-- | `jmp` 的目标就是下一条标签时删掉跳转；立即数装进 scratch 后只被下一条
--   二元/比较指令消费时，把 scratch 折进立即数操作数。
export peephole : List Instr -> List Instr
peephole [] = []
peephole ([one]) = [one]
peephole (i :: rest) =
  case rest of
    next :: more =>
      case i of
        IMov (OpMem Rbp s1) (OpReg Rax) =>
          case next of
            IMov (OpReg Rax) (OpMem Rbp s2) =>
              if s1 == s2 then peephole (i :: more) else i :: peephole rest
            _ => i :: peephole rest
        IJmp target =>
          case next of
            ILabel here => if target == here then peephole rest else i :: peephole rest
            _ => i :: peephole rest
        IMov (OpReg scratch) (OpImm n) =>
          if not (immFits32 n) || not (isScratchReg scratch) then
            i :: peephole rest
          else
            case next of
              IBinReg op dst (OpReg src) => if sameReg src scratch && not (sameReg dst scratch) && regFreeAhead scratch more then IBinReg op dst (OpImm n) :: peephole more else i :: peephole rest
              IBin op (OpReg src) => if sameReg src scratch && regFreeAhead scratch more then IBin op (OpImm n) :: peephole more else i :: peephole rest
              ICmp left (OpReg src) => if sameReg src scratch && regFreeAhead scratch more then ICmp left (OpImm n) :: peephole more else i :: peephole rest
              _ => i :: peephole rest
        _ => i :: peephole rest
    [] => [i]

-- | 只折叠选择器自己分配的 scratch：其它寄存器可能有更远的用途。
isScratchReg : Reg -> Bool
isScratchReg r = sameReg r R10 || sameReg r R11

immFits32 : Int -> Bool
immFits32 n = n >= 0 - 2147483648 && n <= 2147483647

-- | scratch 在后续直线上是否在「先读」之前先被重写。块边界视为自由：`r10` / `r11` 只作
--   块内临时，跨块的值一律走帧槽（生成器不在块之间保留 scratch）。
regFreeAhead : Reg -> List Instr -> Bool
regFreeAhead _ [] = True
regFreeAhead r (i :: rest) =
  if instrReadsReg r i then
    False
  else if instrWritesReg r i then True else if isBlockBoundary i then True else regFreeAhead r rest

isBlockBoundary : Instr -> Bool
isBlockBoundary (ILabel _) = True
isBlockBoundary (IJmp _) = True
isBlockBoundary (IJmpReg _) = True
isBlockBoundary (IJcc _ _) = True
isBlockBoundary IRet = True
isBlockBoundary _ = False

operandReadsReg : Reg -> Operand -> Bool
operandReadsReg r (OpReg x) = sameReg r x
operandReadsReg r (OpMem base _) = sameReg r base
operandReadsReg r (OpMemX base idx _) = sameReg r base || sameReg r idx
operandReadsReg _ (OpImm _) = False
operandReadsReg _ (OpRip _) = False

instrReadsReg : Reg -> Instr -> Bool
instrReadsReg r (IMov _ src) = operandReadsReg r src
instrReadsReg r (IMovByteRegOp _ src) = sameReg r src
instrReadsReg r (IMovzx _ src) = operandReadsReg r src
instrReadsReg r (ILeaMem _ base _) = sameReg r base
instrReadsReg r (IBin _ src) = operandReadsReg r src
instrReadsReg r (IBinReg _ dst src) = sameReg r dst || operandReadsReg r src
instrReadsReg r (ICmp a b) = operandReadsReg r a || operandReadsReg r b
instrReadsReg r (ICmov _ _ src) = operandReadsReg r src
instrReadsReg r (ITest a b) = sameReg r a || sameReg r b
instrReadsReg r (INeg x) = sameReg r x
instrReadsReg r (IDiv x) = sameReg r x
instrReadsReg r (IDivUnsigned x) = sameReg r x
instrReadsReg r (IJmpReg x) = sameReg r x
instrReadsReg r (ICallReg x) = sameReg r x
instrReadsReg r (IPush x) = sameReg r x
instrReadsReg r (IXmmLoad _ op) = operandReadsReg r op
instrReadsReg r (IXmmStore op _) = operandReadsReg r op
instrReadsReg r (IXmmFromInt _ x) = sameReg r x
instrReadsReg r (IXmmFromReg _ x) = sameReg r x
instrReadsReg _ _ = False

instrWritesReg : Reg -> Instr -> Bool
instrWritesReg r (IMov (OpReg dst) _) = sameReg r dst
instrWritesReg r (IMovzx dst _) = sameReg r dst
instrWritesReg r (IBinReg _ dst _) = sameReg r dst
instrWritesReg r (ISetcc _ dst) = sameReg r dst
instrWritesReg r (ICmov _ dst _) = sameReg r dst
instrWritesReg r (INeg x) = sameReg r x
instrWritesReg r (IPop x) = sameReg r x
instrWritesReg r (IXmmToInt x _) = sameReg r x
instrWritesReg _ (ICall _) = True
instrWritesReg _ (ICallReg _) = True
instrWritesReg _ _ = False
