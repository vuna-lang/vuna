module Vuna.Target.Native.Select where

-- native 后端的标量指令选择。
--
-- 把白名单里**不分配、不触发 GC、只碰 rax/r11** 的运行时叶子在调用点展开成机器
-- 序列：`Module` 用 [scalarPlanOf] 判断能否内联，用 [scalarInstrs] 发射。语义与
-- `Native.Runtime` 的同名模板逐条对应（算术的 63-bit wrap、位运算不 wrap、
-- Nat 饱和/夹取、比较返回 0/1），
-- 词表只有这里一份；`RuntimeTable` 单测用 [scalarPlanOf] 第二项与
-- `Runtime.nativeRtTarget` 交叉校验。
--
-- 边界：只 import Base 与 `Native.{Abi,Model}`；不依赖 IR。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Container.HashMap as HashMap
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Model

-- | 一个可内联的标量叶子。
export data ScalarOp(..) : Type where
  -- | 63-bit wrap 的算术二元指令（`add` / `sub` / `imul`）。
  ScalarWrap : String -> ScalarOp
  -- | 位运算二元指令（`and` / `or` / `xor`）：规范化对位运算封闭，不需要 wrap。
  ScalarBitOp : String -> ScalarOp
  -- | 比较：`cmp` + `setcc` + `movzx`，结果 0/1。
  ScalarCmp : String -> ScalarOp
  -- | `xor -1`（`bitNot`）：同样对规范化封闭。
  ScalarBitNot : ScalarOp
  -- | Nat 饱和加法。
  ScalarNatAdd : ScalarOp
  -- | Nat 饱和乘法。
  ScalarNatMul : ScalarOp
  -- | Nat 截断减法（下溢到 0）。
  ScalarNatSub : ScalarOp
  -- | Int -> Nat（负数夹到 0）。
  ScalarNatFromInt : ScalarOp
  -- | Nat -> Int（恒等）。
  ScalarNatToInt : ScalarOp
  -- | 恒返回常量的零参桩（调试 / 可观测性叶子）。
  ScalarConst : Int -> ScalarOp

-- | IR 符号 -> 内联计划 + 对应运行时标签（后者只用于一致性测试）。
export scalarPlanOf : String -> Maybe (ScalarOp, String)
scalarPlanOf "+" = Just (ScalarWrap "add", nativeRtLabel "add")
scalarPlanOf "-" = Just (ScalarWrap "sub", nativeRtLabel "sub")
scalarPlanOf "*" = Just (ScalarWrap "imul", nativeRtLabel "mul")
scalarPlanOf "bitAnd" = Just (ScalarBitOp "and", nativeRtLabel "bit_and")
scalarPlanOf "bitOr" = Just (ScalarBitOp "or", nativeRtLabel "bit_or")
scalarPlanOf "bitXor" = Just (ScalarBitOp "xor", nativeRtLabel "bit_xor")
scalarPlanOf "bitNot" = Just (ScalarBitNot, nativeRtLabel "bit_not")
scalarPlanOf "bi_eq_int" = Just (ScalarCmp "sete", nativeRtLabel "eq_int")
scalarPlanOf "bi_neq_int" = Just (ScalarCmp "setne", nativeRtLabel "neq_int")
scalarPlanOf "bi_lt_int" = Just (ScalarCmp "setl", nativeRtLabel "lt_int")
scalarPlanOf "bi_le_int" = Just (ScalarCmp "setle", nativeRtLabel "le_int")
scalarPlanOf "bi_gt_int" = Just (ScalarCmp "setg", nativeRtLabel "gt_int")
scalarPlanOf "bi_ge_int" = Just (ScalarCmp "setge", nativeRtLabel "ge_int")
scalarPlanOf "bi_lt_bool" = Just (ScalarCmp "setl", nativeRtLabel "lt_int")
scalarPlanOf "bi_le_bool" = Just (ScalarCmp "setle", nativeRtLabel "le_int")
scalarPlanOf "bi_gt_bool" = Just (ScalarCmp "setg", nativeRtLabel "gt_int")
scalarPlanOf "bi_ge_bool" = Just (ScalarCmp "setge", nativeRtLabel "ge_int")
scalarPlanOf "natToInt" = Just (ScalarNatToInt, nativeRtLabel "nat_to_int")
scalarPlanOf "natFromInt" = Just (ScalarNatFromInt, nativeRtLabel "nat_from_int")
scalarPlanOf "natAdd" = Just (ScalarNatAdd, nativeRtLabel "nat_add")
scalarPlanOf "natMul" = Just (ScalarNatMul, nativeRtLabel "nat_mul")
scalarPlanOf "natSub" = Just (ScalarNatSub, nativeRtLabel "nat_sub")
scalarPlanOf "@vuna@log@on" = Just (ScalarConst 0, nativeRtLabel "log_on")
scalarPlanOf "@vuna@log@emit" = Just (ScalarConst 0, nativeRtLabel "log_emit")
scalarPlanOf "@vuna@obs@level" = Just (ScalarConst 0, nativeRtLabel "obs_level")
scalarPlanOf "@vuna@obs@counter" = Just (ScalarConst 0, nativeRtLabel "obs_counter")
scalarPlanOf "@vuna@obs@mark" = Just (ScalarConst 0, nativeRtLabel "obs_mark")
scalarPlanOf "@vuna@obs@spanBegin" = Just (ScalarConst 0, nativeRtLabel "obs_span_begin")
scalarPlanOf "@vuna@obs@spanEnd" = Just (ScalarConst 0, nativeRtLabel "obs_span_end")
scalarPlanOf "@vuna@obs@sampleStart" = Just (ScalarConst 0, nativeRtLabel "obs_sample_start")
scalarPlanOf "@vuna@obs@sampleStop" = Just (ScalarConst 0, nativeRtLabel "obs_sample_stop")
scalarPlanOf _ = Nothing

-- | 展开序列：`a` / `b` 是实参寄存器（一元 / 零元的 `b` 只作 scratch），返回结果
--   寄存器与指令。可能改写两个实参寄存器，调用方把两者都当临时寄存器回收。
export scalarInstrs : ScalarOp -> Reg -> Reg -> (Reg, List Instr)
scalarInstrs (ScalarWrap op) a b =
  (a, [IBinReg op a (OpReg b), IBinReg "shl" a (OpImm 1), IBinReg "sar" a (OpImm 1)])
-- | 两个操作数都是规范化（63-bit 符号扩展）值时，按位结果也规范化。
scalarInstrs (ScalarBitOp op) a b = (a, [IBinReg op a (OpReg b)])
scalarInstrs (ScalarCmp cond) a b = (Rax, [ICmp (OpReg a) (OpReg b), ISetcc cond Rax, IMovzxAl])
scalarInstrs ScalarBitNot a _ = (a, [IBinReg "xor" a (OpImm (0 - 1))])
scalarInstrs ScalarNatAdd a b =
  (a,
    [
      IBinReg "add" a (OpReg b),
      IMov (OpReg b) (OpImm nativeMaxInt),
      ICmp (OpReg a) (OpReg b),
      ICmov "cmovg" a (OpReg b)
    ])
-- | 饱和乘法：`imul` 的 OF 抓 64-bit 溢出，再用 `cmp` 夹到 63-bit max。
scalarInstrs ScalarNatMul a b =
  (a,
    [
      IBinReg "imul" a (OpReg b),
      IMov (OpReg b) (OpImm nativeMaxInt),
      ICmov "cmovno" b (OpReg a),
      IMov (OpReg a) (OpImm nativeMaxInt),
      ICmp (OpReg b) (OpReg a),
      ICmov "cmovle" a (OpReg b)
    ])
scalarInstrs ScalarNatSub a b =
  (a, [IBinReg "sub" a (OpReg b), IMov (OpReg b) (OpImm 0), ICmov "cmovl" a (OpReg b)])
scalarInstrs ScalarNatFromInt a b =
  (a, [IMov (OpReg b) (OpImm 0), ICmp (OpReg a) (OpReg b), ICmov "cmovl" a (OpReg b)])
scalarInstrs ScalarNatToInt a _ = (a, [])
scalarInstrs (ScalarConst n) a _ = (a, [IMov (OpReg a) (OpImm n)])

-- | 与 [scalarInstrs] 相同，但省掉算术的 63-bit wrap。只在这个值**随后只被 mod 2^63
--   语义的操作（加减乘）或清高位的掩码消费**时可用：两层 wrap 之间其它的运算只影响
--   高位，最终结果不变。
export scalarInstrsNoWrap : ScalarOp -> Reg -> Reg -> (Reg, List Instr)
scalarInstrsNoWrap (ScalarWrap op) a b = (a, [IBinReg op a (OpReg b)])
scalarInstrsNoWrap op a b = scalarInstrs op a b

-- ---------------------------------------------------------------
-- 除以编译期常量
-- ---------------------------------------------------------------
-- | 常量除法的展开计划。`d = 0` / `d = -1` 不内联：除零要 trap、`min_int / -1` 在
--   运行时返回 `min_int`（不触发 x86 `#DE`），这两条语义留给 `rt_div`。
export data DivPlan(..) : Type where
  -- | `d = 2^k`：符号修正移位 `(x + (x >> 63 & (d-1))) >> k`（向零截断）。
  DivShift : Int -> DivPlan
  -- | 其它常量：有符号 magic 乘法 + 算术右移 + 符号修正（`d`、magic、shift）。
  DivMagic : Int -> Int -> Int -> DivPlan
  -- | magic 不可用时回退 `cqo` + `idiv`（除数装进 scratch 寄存器）。
  DivIdiv : Int -> DivPlan

-- | 常数除数 → 展开计划；不是正 2 的幂且不在 `idiv` 的可用范围时返回 `Nothing`。
export divPlanOf : Int -> Maybe DivPlan
divPlanOf d =
  if d == 0 || d == 0 - 1 then
    Nothing
  else if d < 0 then
    Nothing
  else if d > 2147483647 then
    Nothing
  else
    case pow2Shift 64 d 0 of
      -- 负数常量除数也能展开，但收益只在这些热点上出现；留给运行时，避免符号修正写错。
      Just k => Just (DivShift k)
      Nothing =>
        case signedMagicOf d of
          Just p => Just (DivMagic d (firstOf p) (secondOf p))
          Nothing => Just (DivIdiv d)

-- | 有符号常量除法的 magic：返回 `(M, s)`，序列是
--   `q = ((x * M) >> 64) >> s; q -= (x >> 63)`（向零截断）。
--   `M = ceil(2^(64+s)/d)`；挑最大的 s 使 M 落在 63-bit Int 内。
--   d < 5 时 M 超出 63-bit，返回 Nothing（回退 idiv）。
signedMagicOf : Int -> Maybe (Int, Int)
signedMagicOf d =
  if d < 5 then
    Nothing
  else
    let
      n62 = 4611686018427387903
      q0 = n62 / d
      r0 = n62 - q0 * d
      fourR0 = 4 * r0
      q1 = fourR0 / d
      r1 = fourR0 - q1 * d
      rem0 = r1 + 4
      q64 = if rem0 >= d then 4 * q0 + q1 + 1 else 4 * q0 + q1
      rem64 = if rem0 >= d then rem0 - d else rem0
    in pickMagicShift 32 0 1 q64 rem64 d Nothing

-- | 从 s = 0 往上试，保留最后一个 M 仍落在 63-bit 内的 s。
pickMagicShift : Int -> Int -> Int -> Int -> Int -> Int -> Maybe (Int, Int) -> Maybe (Int, Int)
pickMagicShift fuel s p2 q64 rem d best =
  if fuel <= 0 then
    best
  else if q64 > nativeMaxInt / p2 || rem > nativeMaxInt / p2 then
    best
  else
    let
      num = rem * p2
      m = q64 * p2 + ceilDiv num d
    in if m > nativeMaxInt then
      best
    else
      let
        rA = num - (num / d) * d
        err = if rA == 0 then 0 else d - rA
      in if err <= 4 * p2 then pickMagicShift (fuel - 1) (s + 1) (2 * p2) q64 rem d (Just (m, s)) else pickMagicShift (fuel - 1) (s + 1) (2 * p2) q64 rem d best

ceilDiv : Int -> Int -> Int
ceilDiv a d =
  let
    q = a / d
  in if a - q * d == 0 then q else q + 1

pow2Shift : Int -> Int -> Int -> Maybe Int
pow2Shift fuel d k =
  if fuel <= 0 then
    Nothing
  else if d == 1 then
    Just k
  else if d - d / 2 * 2 == 0 then pow2Shift (fuel - 1) (d / 2) (k + 1) else Nothing

-- | 标量比较的反向跳转条件（`IrIf` 的条件直接发 `cmp` + `jcc`，不再物化 0/1）。
export branchInverse : String -> Maybe String
branchInverse "bi_eq_int" = Just "jne"
branchInverse "bi_neq_int" = Just "je"
branchInverse "bi_lt_int" = Just "jge"
branchInverse "bi_le_int" = Just "jg"
branchInverse "bi_gt_int" = Just "jle"
branchInverse "bi_ge_int" = Just "jl"
branchInverse "bi_eq_bool" = Just "jne"
branchInverse "bi_neq_bool" = Just "je"
branchInverse "bi_lt_bool" = Just "jge"
branchInverse "bi_le_bool" = Just "jg"
branchInverse "bi_gt_bool" = Just "jle"
branchInverse "bi_ge_bool" = Just "jl"
branchInverse _ = Nothing

-- ---------------------------------------------------------------
-- 浮点比较
-- ---------------------------------------------------------------
-- | 有序比较的 0/1 物化：`ucomisd xmm<a>, xmm<b>` 之后先看 PF（NaN ⇒ 一律 false）。
--   与 `Native.Runtime` 的 `float_*` 模板共用同一份序列（Runtime 从这里取）。
export floatOrderedCmpAt : Int -> Int -> String -> List Instr
floatOrderedCmpAt a b cc =
  [
    IXmmCmp a b,
    ISetcc "setnp" Rax,
    IMovzxAl,
    ISetcc cc Rdx,
    IBinReg "and" Rdx (OpImm 1),
    IBinReg "and" Rax (OpReg Rdx)
  ]

export floatOrderedCmp : String -> List Instr
floatOrderedCmp cc = floatOrderedCmpAt 0 1 cc

-- | `!=`：NaN 参与时结果为 true（与 OCaml `<>` 一致）。
export floatNeqCmpAt : Int -> Int -> List Instr
floatNeqCmpAt a b =
  [
    IXmmCmp a b,
    ISetcc "setne" Rax,
    IMovzxAl,
    ISetcc "setp" Rdx,
    IBinReg "and" Rdx (OpImm 1),
    IBinReg "or" Rax (OpReg Rdx)
  ]

export floatNeqCmp : List Instr
floatNeqCmp = floatNeqCmpAt 0 1

-- | IR 的浮点比较符号 → 0/1 物化序列（操作数已装在两个 xmm 寄存器）。
export floatCompareInstrsAt : Int -> Int -> String -> Maybe (List Instr)
floatCompareInstrsAt a b "bi_eq_float" = Just (floatOrderedCmpAt a b "sete")
floatCompareInstrsAt a b "bi_neq_float" = Just (floatNeqCmpAt a b)
floatCompareInstrsAt a b "bi_lt_float" = Just (floatOrderedCmpAt a b "setb")
floatCompareInstrsAt a b "bi_le_float" = Just (floatOrderedCmpAt a b "setbe")
floatCompareInstrsAt a b "bi_gt_float" = Just (floatOrderedCmpAt a b "seta")
floatCompareInstrsAt a b "bi_ge_float" = Just (floatOrderedCmpAt a b "setae")
floatCompareInstrsAt _ _ _ = Nothing

export floatCompareInstrs : String -> Maybe (List Instr)
floatCompareInstrs sym = floatCompareInstrsAt 0 1 sym

-- ---------------------------------------------------------------
-- 窥孔：只做局部、可证明安全的合并
-- ---------------------------------------------------------------
-- | 槽写完又立刻读回（rax 里的值没变）时删掉读。
-- | `jmp` 的目标就是下一条标签时删掉跳转；立即数装进 scratch 后只被下一条
--   二元/比较指令消费时，把 scratch 折进立即数操作数。
export peephole : List Instr -> List Instr
peephole [] = []
peephole ([one]) = [one]
peephole (i :: rest) =
  case rest of
    next :: more =>
      case i of
        IMov (OpMem Rbp s1) (OpReg Rax) =>
          case next of
            IMov (OpReg Rax) (OpMem Rbp s2) =>
              if s1 == s2 then peephole (i :: more) else i :: peephole rest
            _ => i :: peephole rest
        IJmp target =>
          case next of
            ILabel here => if target == here then peephole rest else i :: peephole rest
            _ => i :: peephole rest
        IMov (OpReg scratch) (OpImm n) =>
          if not (immFits32 n) || not (isScratchReg scratch) then
            i :: peephole rest
          else
            case next of
              IBinReg op dst (OpReg src) => if sameReg src scratch && not (sameReg dst scratch) && regFreeAhead scratch more then IBinReg op dst (OpImm n) :: peephole more else i :: peephole rest
              IBin op (OpReg src) => if sameReg src scratch && regFreeAhead scratch more then IBin op (OpImm n) :: peephole more else i :: peephole rest
              ICmp left (OpReg src) => if sameReg src scratch && regFreeAhead scratch more then ICmp left (OpImm n) :: peephole more else i :: peephole rest
              _ => i :: peephole rest
        _ => i :: peephole rest
    [] => [i]

-- | 只折叠选择器自己分配的 scratch：其它寄存器可能有更远的用途。
isScratchReg : Reg -> Bool
isScratchReg r = sameReg r R10 || sameReg r R11

-- ---------------------------------------------------------------
-- 提升之后的清理
-- ---------------------------------------------------------------
-- | 在槽提升之后跑：把 `mov rax, r; cmp rax, 0` 折成 `cmp r, 0` / `test r, r`，
--   把 `mov rax, <imm|槽>; mov r, rax` 折成 `mov r, <imm|槽>`，并删掉无条件跳转/返回
--   之后直到下一个被引用标签的不可达指令。
--   只折 callee-saved 源寄存器；凡是要丢掉 rax 旧值的折叠都先问 `raxSafeAfter`——
--   `rax` 是生成器的 scratch，常数除法的符号修正会 `add rax, s` 继续读它。
export cleanup : List Instr -> List Instr
cleanup instrs =
  let
    folded = cleanupFix 8 instrs
    copied = switchCopy folded
    tested = dropRedundantTests (jumpTargets copied) copied
  in if hasJumpTable tested then tested else dropUnreachable tested

-- | `sub r, 1; test r, r; jg` 里的 `test` 是冗余的：上一条 `add`/`sub`/逻辑运算
--   已经按结果 r 设置了 ZF/SF。两个例外：
--   * 标签是跳转目标：别的路径跳到这里时上一条指令没执行过，`test` 必须重建标志位；
--   * `add`/`sub` 的 OF 与 `test`（恒 0）不同，读 OF 的 `jg`/`jge`/`jl`/`jle` 不折；
--     逻辑运算同样把 OF 清 0，四类条件都可以折。
dropRedundantTests : HashMap String Bool -> List Instr -> List Instr
dropRedundantTests targets [] = []
dropRedundantTests targets (i :: rest) =
  case rest of
    (ILabel l) :: more =>
      case more of
        (ITest r1 r2) :: (IJcc cc target) :: tail =>
          if sameReg r1 r2 && not (HashMap.member l targets) && flagReuseSafe cc i r1 then
            i :: ILabel l :: IJcc cc target :: dropRedundantTests targets tail
          else
            i :: dropRedundantTests targets rest
        _ => i :: dropRedundantTests targets rest
    (ITest r1 r2) :: (IJcc cc target) :: tail =>
      if sameReg r1 r2 && flagReuseSafe cc i r1 then
        i :: IJcc cc target :: dropRedundantTests targets tail
      else
        i :: dropRedundantTests targets rest
    _ => i :: dropRedundantTests targets rest

-- | `test r, r` 之后的 jcc 能否直接复用上一条指令的标志位。
flagReuseSafe : String -> Instr -> Reg -> Bool
flagReuseSafe cc i r = setsFlagsFor r i && ((isLogicOp i && signedJcc cc) || zfSfJcc cc)

isLogicOp : Instr -> Bool
isLogicOp (IBinReg op _ _) = op == "and" || op == "or" || op == "xor"
isLogicOp (IBin op _) = op == "and" || op == "or" || op == "xor"
isLogicOp _ = False

zfSfJcc : String -> Bool
zfSfJcc cc = cc == "je" || cc == "jne" || cc == "jz" || cc == "jnz" || cc == "js" || cc == "jns"

signedJcc : String -> Bool
signedJcc cc =
  cc
    == "je"
    || cc
    == "jne"
    || cc
    == "jz"
    || cc
    == "jnz" || cc == "jg" || cc == "jge" || cc == "jl" || cc == "jle" || cc == "js" || cc == "jns"

setsFlagsFor : Reg -> Instr -> Bool
setsFlagsFor r (IBinReg op dst _) = sameReg r dst && flagOp op
setsFlagsFor r (IBin op _) = sameReg r Rax && flagOp op
setsFlagsFor _ _ = False

flagOp : String -> Bool
flagOp op = op == "add" || op == "sub" || op == "and" || op == "or" || op == "xor"

-- | 跳转表分派头的 `mov rax, r; cmp rax, k; ... jmp [base+rax*8]` 直接用 r 作
--   cmp 操作数与索引，省掉一次搬运。只认 `isCalleeSaved` 源，避免和 scratch 冲突；
--   臂与兜底块从各自标签进入，生成器保证块入口不读 `rax`（跨块的值一律走帧槽），
--   所以丢掉这条 `mov` 不需要再做活跃性检查。
switchCopy : List Instr -> List Instr
switchCopy ((IMov (OpReg Rax) (OpReg r)) :: (ICmp (OpReg Rax) (OpImm k)) :: jcc :: lea :: (IJmpMem (OpMemS base Rax 8)) :: rest) =
  if isCalleeSaved r then
    ICmp (OpReg r) (OpImm k) :: jcc :: lea :: IJmpMem (OpMemS base r 8) :: switchCopy rest
  else
    IMov (OpReg Rax) (OpReg r) :: switchCopy rest
switchCopy (i :: rest) = i :: switchCopy rest
switchCopy [] = []

-- | 跳转表块里先不做不可达删除：`.quad` 的表项引用 arm 标签，块内的控制流不是
--   普通 `jmp` 图；保留全部 arm 比在这里重新实现一遍标签活跃性更安全。
hasJumpTable : List Instr -> Bool
hasJumpTable [] = False
hasJumpTable ((IQuadLabel _) :: _) = True
hasJumpTable (_ :: rest) = hasJumpTable rest

cleanupFix : Int -> List Instr -> List Instr
cleanupFix fuel instrs =
  if fuel <= 0 then
    instrs
  else
    let
      once = cleanupOnce instrs
    in if length once == length instrs then once else cleanupFix (fuel - 1) once

cleanupOnce : List Instr -> List Instr
cleanupOnce [] = []
cleanupOnce (i :: rest) =
  case rest of
    next :: more =>
      case (i, next) of
        (IMov (OpReg Rax) (OpImm k), IMov (OpReg r) (OpReg Rax)) =>
          if sameReg r Rax then
            i :: cleanupOnce rest
          else if raxSafeAfter more then
            IMov (OpReg r) (OpImm k) :: cleanupOnce more
          else
            i :: cleanupOnce rest
        (IMov (OpReg Rax) (OpMem base off), IMov (OpReg r) (OpReg Rax)) =>
          if sameReg r Rax then
            i :: cleanupOnce rest
          else if raxSafeAfter more then
            IMov (OpReg r) (OpMem base off) :: cleanupOnce more
          else
            i :: cleanupOnce rest
        (IMov (OpReg Rax) (OpReg r), ICmp (OpReg Rax) (OpImm k)) =>
          if isCalleeSaved r && raxSafeAfter more then
            ICmp (OpReg r) (OpImm k) :: cleanupOnce more
          else
            i :: cleanupOnce rest
        (IMov (OpReg Rax) (OpReg r), ITest Rax Rax) =>
          if isCalleeSaved r && raxSafeAfter more then
            ITest r r :: cleanupOnce more
          else
            i :: cleanupOnce rest
        (IMov (OpReg r1) (OpReg r2), _) =>
          if sameReg r1 r2 then cleanupOnce rest else i :: cleanupOnce rest
        (ICmp (OpReg r) (OpImm 0), _) => ITest r r :: cleanupOnce rest
        _ => i :: cleanupOnce rest
    [] => [i]

-- | 折叠掉 rax 的旧值后它是否可以丢：后续在写 rax 之前不能读它。
--   switch 的 `mov rax, [table+rax*8]` 会读 rax，必须拦住。
raxSafeAfter : List Instr -> Bool
raxSafeAfter [] = True
raxSafeAfter (IRet :: _) = False
raxSafeAfter ((IJcc _ _) :: rest) =
  case rest of
    n :: _ => instrWritesReg Rax n && not (instrReadsReg Rax n)
    [] => False
raxSafeAfter (i :: rest) =
  if instrReadsReg Rax i then
    False
  else if instrWritesReg Rax i then True else if isBlockBoundary i then False else raxSafeAfter rest

isCalleeSaved : Reg -> Bool
isCalleeSaved r = sameReg r Rbx || sameReg r R12 || sameReg r R13 || sameReg r R14 || sameReg r R15

-- | 删掉 `jmp` / `ret` / `jmp reg` 之后、下一个被引用标签之前的指令。
--   未被引用的标签本身也可以删；它们只可能是不可达尾部的 fallthrough。
dropUnreachable : List Instr -> List Instr
dropUnreachable instrs = dropUnreachableGo False (jumpTargets instrs) instrs

dropUnreachableGo : Bool -> HashMap String Bool -> List Instr -> List Instr
dropUnreachableGo _ _ [] = []
dropUnreachableGo dead targets (i :: rest) =
  case i of
    ILabel l =>
      if dead && not (HashMap.member l targets) then
        dropUnreachableGo True targets rest
      else
        i :: dropUnreachableGo False targets rest
    IAlign _ => i :: dropUnreachableGo dead targets rest
    _ =>
      if dead then
        dropUnreachableGo True targets rest
      else
        case i of
          IJmp _ => i :: dropUnreachableGo True targets rest
          IJmpReg _ => i :: dropUnreachableGo True targets rest
          IRet => i :: dropUnreachableGo True targets rest
          _ => i :: dropUnreachableGo False targets rest

-- | 被引用的标签集合（`jmp` / `jcc` / `lea` / 跳转表项）。单趟左折建表：
--   逐项「先算子结果、再判重、再取一次子结果」会把每层算两遍，标签一多就指数增长。
jumpTargets : List Instr -> HashMap String Bool
jumpTargets instrs = foldl (\acc, i => addJumpTarget i acc) (HashMap.ofNames []) instrs

addJumpTarget : Instr -> HashMap String Bool -> HashMap String Bool
addJumpTarget (IJmp l) acc = HashMap.insert l True acc
addJumpTarget (IJcc _ l) acc = HashMap.insert l True acc
addJumpTarget (ILea _ l) acc = HashMap.insert l True acc
addJumpTarget (IQuadLabel l) acc = HashMap.insert l True acc
addJumpTarget _ acc = acc

immFits32 : Int -> Bool
immFits32 n = n >= 0 - 2147483648 && n <= 2147483647

-- | scratch 在后续直线上是否在「先读」之前先被重写。块边界视为自由：`rax` / `r10` /
--   `r11` 只作块内临时，跨块的值一律走帧槽（生成器不在块之间保留 scratch）。
export regFreeAhead : Reg -> List Instr -> Bool
regFreeAhead _ [] = True
regFreeAhead r (i :: rest) =
  if instrReadsReg r i then
    False
  else if instrWritesReg r i then True else if isBlockBoundary i then True else regFreeAhead r rest

isBlockBoundary : Instr -> Bool
isBlockBoundary (ILabel _) = True
isBlockBoundary (IJmp _) = True
isBlockBoundary (IJmpReg _) = True
isBlockBoundary (IJmpMem _) = True
isBlockBoundary (IJcc _ _) = True
isBlockBoundary IRet = True
isBlockBoundary _ = False

operandReadsReg : Reg -> Operand -> Bool
operandReadsReg r (OpReg x) = sameReg r x
operandReadsReg r (OpMem base _) = sameReg r base
operandReadsReg r (OpMemX base idx _) = sameReg r base || sameReg r idx
operandReadsReg r (OpMemS base idx _) = sameReg r base || sameReg r idx
operandReadsReg _ (OpImm _) = False
operandReadsReg _ (OpRip _) = False

export instrReadsReg : Reg -> Instr -> Bool
instrReadsReg r (IMov _ src) = operandReadsReg r src
instrReadsReg r (IMovByteRegOp _ src) = sameReg r src
instrReadsReg r (IMovzx _ src) = operandReadsReg r src
instrReadsReg r (ILeaMem _ base _) = sameReg r base
instrReadsReg r (IBin _ src) = operandReadsReg r src
instrReadsReg r (IBinReg _ dst src) = sameReg r dst || operandReadsReg r src
instrReadsReg r (ICmp a b) = operandReadsReg r a || operandReadsReg r b
instrReadsReg r (ICmov _ _ src) = operandReadsReg r src
instrReadsReg r (ITest a b) = sameReg r a || sameReg r b
instrReadsReg r (INeg x) = sameReg r x
instrReadsReg r (IDiv x) = sameReg r x
instrReadsReg r (IDivUnsigned x) = sameReg r x
instrReadsReg r (IMulSigned x) = sameReg r x || sameReg r Rax
instrReadsReg r (IJmpReg x) = sameReg r x
instrReadsReg r (IJmpMem op) = operandReadsReg r op
instrReadsReg r (ICallReg x) = sameReg r x
instrReadsReg r (IPush x) = sameReg r x
instrReadsReg r (IXmmLoad _ op) = operandReadsReg r op
instrReadsReg r (IXmmStore op _) = operandReadsReg r op
instrReadsReg r (IXmmFromInt _ x) = sameReg r x
instrReadsReg r (IXmmFromReg _ x) = sameReg r x
instrReadsReg _ _ = False

export instrWritesReg : Reg -> Instr -> Bool
instrWritesReg r (IMov (OpReg dst) _) = sameReg r dst
instrWritesReg r (IMovzx dst _) = sameReg r dst
instrWritesReg r (IBinReg _ dst _) = sameReg r dst
instrWritesReg r (ISetcc _ dst) = sameReg r dst
instrWritesReg r (ICmov _ dst _) = sameReg r dst
instrWritesReg r (INeg x) = sameReg r x
instrWritesReg r (IPop x) = sameReg r x
instrWritesReg r (IXmmToInt x _) = sameReg r x
instrWritesReg _ (ICall _) = True
instrWritesReg _ (ICallReg _) = True
instrWritesReg r (IMulSigned _) = sameReg r Rax || sameReg r Rdx
instrWritesReg r (IDiv _) = sameReg r Rax || sameReg r Rdx
instrWritesReg r (IDivUnsigned _) = sameReg r Rax || sameReg r Rdx
instrWritesReg r ICqo = sameReg r Rdx
instrWritesReg _ ISyscall = True
instrWritesReg _ _ = False
