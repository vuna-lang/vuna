module Vuna.Target.Native.Module where

-- Vuna.Target.Native.Module：IrProgram -> NativeProgram（x86-64 汇编）。
--
-- 覆盖 Int/Nat/Bool 纯值与 `String`（字面量、`++`、`strFromInt`、`strLength`、
-- `strAt`、`strHash`、`strShow`、`strSubstring`、`bi_eq_str` / `bi_neq_str`、`IrConcatMany`、
-- String 入口）。字符串是**指向长度头的指针**，由运行时从 bump 堆分配。
-- 用户 `data`（变体对象 `[0]`=tag + 8 字节字段）、record（纯字段对象）、
-- 通用 `IrCase`（tag 线性分派）、`IrProj` / `IrRecUpd`。
--
-- 生成策略（见 docs/reference/native.md）：
--   * 从 entry main 沿 `irDefDeps` 收集可达定义，只生成可达函数；不可达的 base
--     定义不检查（与 wasm 的 `collectNeeded` 同策略）；
--   * 不做寄存器分配：binder 与中间值都走 `[rbp - 8*(slot+1)]`；
--   * 调用约定在 `Native.Abi`；运行时符号在 `Native.Runtime`；
--   * 每个模块一个汇编文件（`runtime.s` + 模块路径目录）；字符串字面量按模块池
--     内容去重进该文件的 `.rodata`（首现顺序编号），`IrStr` 求值成 `lea`；
--   * 内部 label（`.L<n>`）是文件局部符号，编号在模块内跨定义累加；
--   * 生成器带 fuel，越界报 `NativeInternal`，不 panic。
--
-- 边界：只 import Base、`Vuna.Ir` 与 `Native.*`。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Ir.Model
import Vuna.Ir.Cps
import Vuna.Ir.Analysis
import Vuna.Ir.Runtime
import Vuna.Ir.Tail
import Vuna.Ir.Synthetic as Synthetic
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Audit
import Vuna.Target.Native.Model
import Vuna.Target.Native.Repr
import Vuna.Target.Native.Runtime
import Vuna.Target.Native.Select

-- ---------------------------------------------------------------
-- 结果类型：区分「目标不支持」与「生成器不变式破坏」
-- -----------------------------------------------------------
export data NRes a(..) : Type where
  NOk : a -> NRes a
  NFail : NativeErr -> NRes a

-- | 零参别名的解析目标：运行时叶子，或另一个（有 arity 的）顶级定义。
data AliasTarget : Type where
  AliasRt : String -> AliasTarget
  AliasGlobal : String -> AliasTarget

-- | 调用点静态已知的被调用者。`KDirect` 走标准 ABI 直调（不需要闭包值）；
--   `KClosure` 只知道闭包 arity，调用点仍从槽里取闭包，但可以跳过运行时 arity 检查
--   与 `rt_apply` 回退。
export data KnownCallee(..) : Type where
  KDirect : String -> Int -> KnownCallee
  KClosure : Int -> KnownCallee

export calleeArity : KnownCallee -> Int
calleeArity (KDirect _ n) = n
calleeArity (KClosure n) = n

nbind : NRes a -> (a -> NRes b) -> NRes b
nbind (NOk x) k = k x
nbind (NFail e) _ = NFail e

unsupported : String -> NRes a
unsupported msg = NFail (NativeUnsupported msg)

internal : String -> NRes a
internal msg = NFail (NativeInternal msg)

-- ---------------------------------------------------------------
-- 模块归属
-- -----------------------------------------------------------
-- | 定义的全限定名 -> 模块路径。无模块头的定义（ad-hoc 文件）归入入口模块 `Main`。
modulePathOf : String -> List String
modulePathOf name =
  let
    parts = split "." name
  in case dropLast parts of
    [] => ["Main"]
    ms => ms

dropLast : List a -> List a
dropLast [] = []
dropLast ([_]) = []
dropLast (x :: rest) = x :: dropLast rest

-- ---------------------------------------------------------------
-- 生成状态与栈槽
-- -----------------------------------------------------------
record FGen where
  fgDefs : List IrDef
  fgPool : List (Pair String String)
  fgSlots : List (Pair IrBinder Int)
  -- | 槽序号 → 运行时 kind（捕获槽继承父帧的 kind；GC 不用它）。
  --   槽不复用，所以这张表只增不减。
  fgSlotCls : List (Pair Int NCls)
  fgFams : List IrTyDecl
  fgNextSlot : Int
  fgNextLabel : Int
  -- | 本次生成中遇到的闭包函数（每个 `IrLam` 值一个），最后并入 `npFuncs`。
  fgLams : List NativeFunc
  -- | 本函数**来参区**可复用的字节数（调用方压的栈实参 + 对齐洞）。
  --   尾调用把新实参写回 `[rbp+16...]`，超过这段就会踩调用者的帧，只能回退普通调用。
  fgTailRoom : Int
  -- | 当前生成所属的模块路径（闭包函数继承它）。
  fgModule : List String
  -- | 当前定义的全限定名（闭包标签由它派生，跨定义稳定）。
  fgOwner : String
  -- | 当前函数的标签；自递归尾调用只在它非空时启用。
  fgSelfLabel : String
  -- | 自递归尾调用的回边标签；空串表示当前函数没有循环头。
  fgSelfLoop : String
  -- | 自递归尾调用要写回的形参槽（按参数顺序）。
  fgSelfParams : List Int
  -- | 本次生成收集到的静态闭包对象（无捕获的函数值）。
  fgStatics : List NativeClosure
  -- | binder id -> 调用点静态已知的被调用者（见 `KnownCallee`）。binder 身份在
  --   整个 lowering 产物里唯一，所以表只增不减；跨闭包边界时按捕获集合筛一遍。
  fgKnown : List (Pair Int KnownCallee)

freshSlot : FGen -> Pair Int FGen
freshSlot st =
  let
    slot = st.fgNextSlot
    st1 = { st | fgNextSlot = st.fgNextSlot + 1 }
  in Pair slot st1

freshSlotCls : NCls -> FGen -> Pair Int FGen
freshSlotCls cls st =
  let
    p = freshSlot st
  in Pair (firstOf p) (setSlotCls (firstOf p) cls (secondOf p))

freshLabel : FGen -> Pair String FGen
freshLabel st =
  let
    label = nativeJumpLabel st.fgNextLabel
    st1 = { st | fgNextLabel = st.fgNextLabel + 1 }
  in Pair label st1

storeSlot : Int -> List Instr
storeSlot slot = [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]

loadSlot : Int -> List Instr
loadSlot slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot))]

loadReg : Reg -> Int -> List Instr
loadReg r slot = [IMov (OpReg r) (OpMem Rbp (nativeSlotOff slot))]

-- ---------------------------------------------------------------
-- binder
-- -----------------------------------------------------------
binderEq : IrBinder -> IrBinder -> Bool
binderEq a b = sameBinderId a b

lookupBinder : IrBinder -> List (Pair IrBinder Int) -> Maybe Int
lookupBinder _ [] = Nothing
lookupBinder b (p :: rest) =
  if binderEq b (firstOf p) then Just (secondOf p) else lookupBinder b rest

pushBinder : IrBinder -> Int -> FGen -> FGen
pushBinder b slot st = { st | fgSlots = Pair b slot :: st.fgSlots }

-- ---------------------------------------------------------------
-- 槽 kind（GC 栈图的输入）
-- ---------------------------------------------------------------
-- | 登记槽的 kind。kind 来自 `Native.Repr`：binder 的声明类型优先，缺类型时只信
--   绑定点的值（字面量 / 已绑定 binder / 结果类型已知的符号），推不出来就记
--   `NClsMissing`——按「可能是指针」处理，照样进栈图。
setSlotCls : Int -> NCls -> FGen -> FGen
setSlotCls slot cls st = { st | fgSlotCls = Pair slot cls :: st.fgSlotCls }

pushBinderCls : IrBinder -> Int -> NCls -> FGen -> FGen
pushBinderCls b slot cls st = setSlotCls slot cls (pushBinder b slot st)

slotClsAt : Int -> List (Pair Int NCls) -> NCls
slotClsAt _ [] = NClsMissing
slotClsAt slot (p :: rest) = if firstOf p == slot then secondOf p else slotClsAt slot rest

isScalarCls : NCls -> Bool
isScalarCls NClsScalar = True
isScalarCls _ = False

clsOfTy : FGen -> Maybe IrTy -> NCls
clsOfTy st mty = nKindOfTy st.fgFams mty

-- | binder 的 kind：声明类型优先，`Nothing` 时用绑定点的推断值。
binderCls : FGen -> Maybe NCls -> IrBinder -> NCls
binderCls st fallback b =
  case nKindOfTy st.fgFams b.irBinderTy of
    NClsMissing =>
      case fallback of
        Just cls => cls
        Nothing => NClsMissing
    cls => cls

-- | 值位置的 kind。`IrCast` 只在源/目标都是标量时按标量算（native 把 cast 渲染成
--   恒等，两边 kind 不一致时不能信任何一边）。
valueCls : FGen -> Ir -> NCls
valueCls st (IrVar b) = binderCls st Nothing b
valueCls st (IrCast from to _) =
  if isScalarCls (clsOfTy st from) && isScalarCls (clsOfTy st to) then NClsScalar else NClsMissing
valueCls st ir =
  case nValueCls st.fgFams st.fgDefs [] ir of
    Just cls => cls
    Nothing => NClsMissing

isErasedBinder : IrBinder -> Bool
isErasedBinder b = b.irBinderErased

-- | 结束一个 binder 作用域：只恢复 binder 表；slot/label 计数器不回退（槽不复用）。
restoreBinderScope : FGen -> List (Pair IrBinder Int) -> FGen
restoreBinderScope st slots = { st | fgSlots = slots }

runtimeBinders : List IrBinder -> List IrBinder
runtimeBinders bs = filter (\b => not (isErasedBinder b)) bs

-- ---------------------------------------------------------------
-- 定义查找 / 可达性
-- -----------------------------------------------------------
findDef : String -> List IrDef -> Maybe IrDef
findDef _ [] = Nothing
findDef name (d :: rest) = if irDefName d == name then Just d else findDef name rest

memStr : String -> List String -> Bool
memStr _ [] = False
memStr s (x :: rest) = s == x || memStr s rest

-- ---------------------------------------------------------------
-- 字符串字面量池
-- -----------------------------------------------------------
addLit : List (Pair String String) -> String -> List (Pair String String)
addLit pool s =
  if memStr s (map (\p => firstOf p) pool) then
    pool
  else
    append pool [Pair s (nativeStrLitLabel (length pool))]

poolOfDefs : List IrDef -> List (Pair String String)
poolOfDefs defs = foldl addLit [] (concatMap irStringsOfDef defs)

-- | 模块 key（用 `.` 连接路径段；`modulePathOf` 的逆）。
moduleKeyOf : String -> String
moduleKeyOf name = join "." (modulePathOf name)

-- | 每个模块一份字面量池（模块按首现顺序；池内首现顺序固定）。`.Llit_<n>` 是文件局部
--   标签，所以字面量池按模块切分，新增字面量不会重编号其它模块。
modulePools : List IrDef -> List (Pair String (List (Pair String String)))
modulePools defs = foldl addDefToPools [] defs

addDefToPools : List (Pair String (List (Pair String String))) -> IrDef -> List (Pair String (List (Pair String String)))
addDefToPools pools d =
  let
    k = moduleKeyOf (irDefName d)
    pool = foldl addLit (modulePoolOf k pools) (irStringsOfDef d)
  in putPool k pool pools

putPool : String -> List (Pair String String) -> List (Pair String (List (Pair String String))) -> List (Pair String (List (Pair String String)))
putPool key pool [] = [Pair key pool]
putPool key pool (p :: rest) =
  if firstOf p == key then Pair key pool :: rest else p :: putPool key pool rest

modulePoolOf : String -> List (Pair String (List (Pair String String))) -> List (Pair String String)
modulePoolOf _ [] = []
modulePoolOf key (p :: rest) = if firstOf p == key then secondOf p else modulePoolOf key rest

poolLabelOf : String -> List (Pair String String) -> Maybe String
poolLabelOf _ [] = Nothing
poolLabelOf s (p :: rest) = if firstOf p == s then Just (secondOf p) else poolLabelOf s rest

poolItems : List (Pair String String) -> List NativeStrLit
poolItems [] = []
poolItems ((Pair text label) :: rest) = NativeStrLit label text :: poolItems rest

-- ---------------------------------------------------------------
-- 参数
-- -----------------------------------------------------------
loadArgRegs : List Reg -> List Int -> List Instr
loadArgRegs [] _ = []
loadArgRegs _ [] = []
loadArgRegs (r :: rs) (s :: ss) = append (loadReg r s) (loadArgRegs rs ss)

argRegAt : Int -> Maybe Reg
argRegAt i = argRegAtIn i nativeArgRegs

argRegAtIn : Int -> List Reg -> Maybe Reg
argRegAtIn _ [] = Nothing
argRegAtIn i (r :: rest) = if i == 0 then Just r else argRegAtIn (i - 1) rest

-- ---------------------------------------------------------------
-- 表达式
-- -----------------------------------------------------------
genArgs : Int -> FGen -> List Ir -> NRes (Pair (List Instr) (Pair (List Int) FGen))
genArgs _ st [] = NOk (Pair [] (Pair [] st))
genArgs fuel st (a :: rest) =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genExpr (fuel - 1) st a) (
        \p =>
          let
            st1 = secondOf p
            slotP = freshSlotCls (valueCls st1 a) st1
            slot = firstOf slotP
            st2 = secondOf slotP
          in nbind (genArgs (fuel - 1) st2 rest) (
              \q =>
                let
                  qInstrs = firstOf q
                  qSlots = firstOf (secondOf q)
                  st3 = secondOf (secondOf q)
                in NOk (Pair (append (firstOf p) (append (storeSlot slot) qInstrs)) (Pair (slot :: qSlots) st3))
            )
      )

-- | 饱和调用：实参左→右求值到槽；前 6 个装参数寄存器，其余逆序压栈（SysV AMD64）。
--   调用前 `rsp` 必须 16 字节对齐：栈参数个数为奇数时先 `sub rsp, 8` 补空洞
--   （空洞在参数**上方**，被调用方忽略）；返回后一次性 `add rsp, 8*k + pad`。
genSaturatedCall : Int -> FGen -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genSaturatedCall fuel st label args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genArgs (fuel - 1) st args) (
        \p =>
          let
            slots = firstOf (secondOf p)
            st1 = secondOf (secondOf p)
          in NOk (Pair (append (firstOf p) (callSlotsInstrs label slots)) st1)
      )

-- | 尾位置的饱和直调：实参求值到槽后写回来参区、拆帧并 `jmp`（不返回）。
genTailCall : Int -> FGen -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genTailCall fuel st label args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind
      (genArgs (fuel - 1) st args)
      (\p => NOk (Pair (append (firstOf p) (tailCallSlotsInstrs label (firstOf (secondOf p)))) (secondOf (secondOf p))))

-- | 以**已求值到槽**的实参调用：前 6 个装参数寄存器，其余逆序压栈（SysV AMD64）。
--   调用前 `rsp` 必须 16 字节对齐：栈参数个数为奇数时先 `sub rsp, 8` 补空洞
--   （空洞在参数**上方**，被调用方忽略）；返回后一次性 `add rsp, 8*k + pad`。
callSlotsInstrs : String -> List Int -> List Instr
callSlotsInstrs label slots =
  let
    regSlots = take nativeMaxArgs slots
    stackSlots = drop nativeMaxArgs slots
    k = length stackSlots
    pad = nativeStackPadBytes k
    popped = 8 * k + pad
  in append
    (pushStackArgs stackSlots)
    (append (loadArgRegs nativeArgRegs regSlots) (append [ICall label] (if popped == 0 then [] else [IBinReg "add" Rsp (OpImm popped)])))

-- | 栈参数压栈：逆序（最后一个先压），第 7 个参数最终位于 `[rbp+16]`。
--   `slots` 已按实参顺序排列（从第 7 个起）。先 `sub rsp, 8` 补对齐空洞（若需要）。
pushStackArgs : List Int -> List Instr
pushStackArgs slots =
  let
    k = length slots
    pad = if nativeStackPadBytes k == 0 then [] else [IBinReg "sub" Rsp (OpImm 8)]
    pushes = concatMap pushOne (reverse slots)
  in append pad pushes

pushOne : Int -> List Instr
pushOne slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot)), IPush Rax]

-- ---------------------------------------------------------------
-- 尾调用
-- ---------------------------------------------------------------
-- | 空间判据：把 `kOut` 个栈实参写回调用者来参区所需的字节数不超过 `fgTailRoom`。
--   不满足时回退普通调用（语义不变，只丢优化）。
tailCallFits : FGen -> Int -> Bool
tailCallFits st kOut = 8 * kOut <= st.fgTailRoom

-- | 第 `i`（从 0 起）个实参的栈槽 → 调用者来参区的第 `i-6` 个槽位。
--   源全在 `rbp` 以下、目标在 `rbp+16` 以上，两者不重叠，拷贝顺序无关。
tailStackArgMoves : Int -> Int -> List Int -> List Instr
tailStackArgMoves _ _ [] = []
tailStackArgMoves regs i (slot :: rest) =
  append
    [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot)), IMov (OpMem Rbp (16 + 8 * (i - regs))) (OpReg Rax)]
    (tailStackArgMoves regs (i + 1) rest)

-- | 尾调用：栈实参搬进来参区 → 装参数寄存器 → 拆本帧 → `jmp`。
--   `pop rbp` 之后 `rsp` 正好落在返回地址槽，与 `call` 刚进入时同构（`rsp ≡ 8 mod 16`），
--   所以尾调用自己不需要补对齐洞；返回地址仍是本函数自己的那一个。
tailCallSlotsInstrs : String -> List Int -> List Instr
tailCallSlotsInstrs label slots =
  let
    regSlots = take nativeMaxArgs slots
    stackSlots = drop nativeMaxArgs slots
  in append
    (tailStackArgMoves nativeMaxArgs nativeMaxArgs stackSlots)
    (append (loadArgRegs nativeArgRegs regSlots) [IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp, IJmp label])

-- ---------------------------------------------------------------
-- 函数值（顶层函数 / 运行时符号）
-- ---------------------------------------------------------------
nativeFuncLabelOf : NativeFunc -> String
nativeFuncLabelOf f = f.nfLabel

hasFuncLabel : String -> List NativeFunc -> Bool
hasFuncLabel label fs =
  foldl (\acc, f => if nativeFuncLabelOf f == label then True else acc) False fs

-- | 闭包 ABI（rdi=闭包、实参从 rsi 起）里第 i 个实参的装载指令。
closureArgLoad : Int -> List Instr
closureArgLoad i =
  case argRegAt (i + 1) of
    Just reg => [IMov (OpReg Rax) (OpReg reg)]
    Nothing => [IMov (OpReg Rax) (OpMem Rbp (nativeStackArgOff (i + 1)))]

-- | 函数值 wrapper：把闭包实参搬进本帧槽，再按标准 ABI 调目标函数。
--   每个（函数 / 运行时符号）只生成一次，标签由 `Native.Abi` 的命名派生。
valueWrapperFunc : List String -> String -> Int -> String -> NativeFunc
valueWrapperFunc modPath label arity target =
  let
    slots = range 0 arity
    loads =
      concatMap
        (\i => append (closureArgLoad i) [IMov (OpMem Rbp (nativeSlotOff i)) (OpReg Rax)])
        slots
    frame = nativeFrameBytes arity
  in NativeFunc
    label
    frame
    (append (nativePrologue frame) (append loads (tailCallSlotsInstrs target slots)))
    modPath

nativeStaticClosureLabel : String -> Int -> String
nativeStaticClosureLabel label arity = "vuna_static_${nativeName label}_${strFromInt arity}"

hasNativeClosure : String -> List NativeClosure -> Bool
hasNativeClosure _ [] = False
hasNativeClosure label (c :: rest) =
  if c.ncLabel == label then True else hasNativeClosure label rest

-- | 零参顶层定义的 CAF 槽：每个 `IrDef` arity 0 一格，`_start` 求值一次后写入；
--   GC 按 `[rt_caf_begin, rt_caf_end)` 扫根（见 `Gc.gcCollectFn`）。
cafBssOf : List IrDef -> List NativeBss
cafBssOf defs =
  append
    [NativeBss nativeCafBeginLabel 0 8]
    (append (concatMap cafCellOf defs) [NativeBss nativeCafEndLabel 0 8])

cafCellOf : IrDef -> List NativeBss
cafCellOf d = if isCafDef d then [NativeBss (nativeCafCellLabel (irDefName d)) 8 8] else []

-- | 有体的零参定义（extern 的 `irDefArity` 也是 0，但没有可求值的体）。
isCafDef : IrDef -> Bool
isCafDef d =
  case irDefBody d of
    Just _ => irDefArity d == 0
    Nothing => False

-- | 入口要预先求值的零参定义（`main` 由入口单独调用）。
cafNamesOf : String -> List IrDef -> List String
cafNamesOf mainName defs =
  concatMap (\d => if isCafDef d && irDefName d /= mainName then [irDefName d] else []) defs

-- | 把「顶层函数 / 运行时符号」求值成闭包对象：`[code][arity]`（无捕获）。
--   无捕获闭包是只读静态对象，引用点只 `lea`，不分配堆。
genValueClosure : FGen -> List String -> String -> Int -> String -> NRes (Pair (List Instr) FGen)
genValueClosure st modPath label arity target =
  let
    staticLabel = nativeStaticClosureLabel label arity
    st1 =
      if hasFuncLabel label st.fgLams then
        st
      else
        { st | fgLams = append st.fgLams [valueWrapperFunc modPath label arity target] }
    st2 =
      if hasNativeClosure staticLabel st1.fgStatics then
        st1
      else
        { st1 | fgStatics = append st1.fgStatics [NativeClosure staticLabel label arity] }
    body = [ILea Rax staticLabel]
  in NOk (Pair body st2)

-- | 运行时符号作为值时的 arity：`nativeRtValueArity` 优先，其次内建饱和应用 arity。
rtValueArityOf : String -> Int
rtValueArityOf sym =
  if nativeRtValueArity sym > 0 then nativeRtValueArity sym else irInlineArity sym

-- | 饱和闭包调用（闭包 ABI：`rdi` = 闭包、实参从 `rsi` 起，第 6 个起压栈）。
closureCallSlotsInstrs : Int -> List Int -> List Instr
closureCallSlotsInstrs clo slots =
  let
    regSlots = take (length closureArgRegs) slots
    stackSlots = drop (length closureArgRegs) slots
    k = length stackSlots
    pad = nativeStackPadBytes k
    popped = 8 * k + pad
  in append
    (pushStackArgs stackSlots)
    (append (loadArgRegs closureArgRegs regSlots) (append [IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff clo)), IMov (OpReg R11) (OpMem Rdi 0)] (append [ICallReg R11] (if popped == 0 then [] else [IBinReg "add" Rsp (OpImm popped)]))))

-- | 饱和闭包尾调用：栈实参写回来参区 → 装闭包 ABI 寄存器 → 拆帧 → `jmp [clo]`。
closureTailCallSlotsInstrs : Int -> List Int -> List Instr
closureTailCallSlotsInstrs clo slots =
  let
    regSlots = take (length closureArgRegs) slots
    stackSlots = drop (length closureArgRegs) slots
  in append
    (tailStackArgMoves (length closureArgRegs) (length closureArgRegs) stackSlots)
    (append (loadArgRegs closureArgRegs regSlots) [IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff clo)), IMov (OpReg R11) (OpMem Rdi 0), IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp, IJmpReg R11])

-- | 统一应用：运行时先按闭包 arity 走**饱和直调**快路径（栈开销与闭包 ABI 引入前一致），
--   arity 不匹配才把实参按逆序压栈成升序数组交给 `rt_apply`（部分 / 过度应用）。
genApplyCall : FGen -> Bool -> Int -> List Int -> NRes (Pair (List Instr) FGen)
genApplyCall st isTail clo args =
  let
    k = length args
    idx = st.fgNextLabel
    lSlow = nativeJumpLabel idx
    lEnd = nativeJumpLabel (idx + 1)
    st1 = { st | fgNextLabel = idx + 2 }
    pad = nativeStackPadBytes k
    pushes = concatMap pushOne (reverse args)
    head = if pad == 0 then [] else [IBinReg "sub" Rsp (OpImm 8)]
    slowPart =
      append
        head
        (append pushes (append [IMov (OpReg Rdx) (OpReg Rsp), IMov (OpReg Rsi) (OpImm k), IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff clo))] [ICall (nativeRtLabel "apply"), IBinReg "add" Rsp (OpImm (8 * k + pad))]))
    tailFits = isTail && tailCallFits st (nativeStackArgCount k (length closureArgRegs))
    fastPart =
      append
        [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff clo)), IMov (OpReg Rax) (OpMem Rax 8), ICmp (OpReg Rax) (OpImm k), IJcc "jne" lSlow]
        (if tailFits then closureTailCallSlotsInstrs clo args else append (closureCallSlotsInstrs clo args) [IJmp lEnd])
  in NOk (Pair (append fastPart (append [ILabel lSlow] (append slowPart [ILabel lEnd]))) st1)

-- | 求值 head + 实参后统一应用（部分 / 过度 / 运行时闭包都走这里）。
genApplyHead : Int -> FGen -> Bool -> Ir -> List Ir -> NRes (Pair (List Instr) FGen)
genApplyHead fuel st isTail head args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genExpr (fuel - 1) st head) (
        \p =>
          let
            cloP = freshSlot (secondOf p)
            clo = firstOf cloP
            st1 = secondOf cloP
          in nbind (genArgs (fuel - 1) st1 args) (\q => nbind (genApplyCall (secondOf (secondOf q)) isTail clo (firstOf (secondOf q))) (\r => NOk (Pair (cat [firstOf p, storeSlot clo, firstOf q, firstOf r]) (secondOf r))))
      )

-- | 自递归尾调用：实参已求值到 fresh slots，逐项写回形参槽后回到循环头。
selfSlotMoves : List Int -> List Int -> List Instr
selfSlotMoves [] _ = []
selfSlotMoves _ [] = []
selfSlotMoves (src :: ss) (dst :: ds) =
  append
    [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff src)), IMov (OpMem Rbp (nativeSlotOff dst)) (OpReg Rax)]
    (selfSlotMoves ss ds)

genSelfTailCall : Int -> FGen -> List Ir -> NRes (Pair (List Instr) FGen)
genSelfTailCall fuel st args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genArgs (fuel - 1) st args) (
        \p =>
          let
            argSlots = firstOf (secondOf p)
          in if length argSlots == length st.fgSelfParams then NOk (Pair (append (firstOf p) (append (selfSlotMoves argSlots st.fgSelfParams) [IJmp st.fgSelfLoop])) (secondOf (secondOf p))) else internal "self tail call arity mismatch"
      )

-- | 沿零参定义解析别名链（`f = rt:add` / `f = g`）。`fuel` 防环；不是别名的零参
--   CAF（真实计算/分配）返回 Nothing，调用方回退 `rt_apply`。
aliasTargetOf : Int -> List IrDef -> String -> Maybe AliasTarget
aliasTargetOf fuel defs name =
  if fuel <= 0 then
    Nothing
  else
    case findDef name defs of
      Nothing => Nothing
      Just d =>
        if irDefArity d /= 0 then
          Just (AliasGlobal name)
        else
          case irDefBody d of
            Just b =>
              case stripTail b of
                IrRt sym => Just (AliasRt sym)
                IrGlobal g => aliasTargetOf (fuel - 1) defs g
                _ => Nothing
            Nothing => Nothing

-- | 调用点静态已知的被调用者。
--
--   来源只有「构造点可知」的形态：顶层函数 / 运行时叶子 / 立即 lambda / 绑定点上能
--   解析到这些的 binder，以及它们的部分应用（`rt_apply` 的 shim 把 arity 减掉）。
--   函数参数、case 字段与投影一律未知：运行时 arity 可以小于静态类型的箭头数
--   （η-收缩定义当值时，wrapper 的 arity 是定义参数个数），所以不能只凭类型推 arity。
export knownCalleeOf : List IrDef -> List (Pair Int KnownCallee) -> Ir -> Maybe KnownCallee
knownCalleeOf defs known ir = knownCalleeFuel 256 defs known ir

knownCalleeFuel : Int -> List IrDef -> List (Pair Int KnownCallee) -> Ir -> Maybe KnownCallee
knownCalleeFuel fuel defs known ir =
  if fuel <= 0 then
    Nothing
  else
    case ir of
      IrGlobal name => globalCallee (fuel - 1) defs name
      IrRt sym => rtLeafCallee sym
      IrLam bs _ _ =>
        let
          n = length (runtimeBinders bs)
        in if n > 0 then Just (KClosure n) else Nothing
      IrVar b => lookupKnown b.irBinderId known
      IrCast _ _ inner => knownCalleeFuel (fuel - 1) defs known inner
      IrTail inner => knownCalleeFuel (fuel - 1) defs known inner
      IrApp _ _ _ =>
        case flattenApp ir of
          Pair head args => partialCallee (knownCalleeFuel (fuel - 1) defs known head) (length args)
      _ => Nothing

lookupKnown : Int -> List (Pair Int KnownCallee) -> Maybe KnownCallee
lookupKnown _ [] = Nothing
lookupKnown id (p :: rest) = if firstOf p == id then Just (secondOf p) else lookupKnown id rest

rtLeafCallee : String -> Maybe KnownCallee
rtLeafCallee sym =
  case nativeRtTarget sym of
    Nothing => Nothing
    Just label =>
      let
        a = rtValueArityOf sym
      in if a > 0 then Just (KDirect label a) else Nothing

globalCallee : Int -> List IrDef -> String -> Maybe KnownCallee
globalCallee fuel defs name =
  if fuel <= 0 then
    Nothing
  else
    case findDef name defs of
      Nothing => Nothing
      Just d =>
        let
          arity = irDefArity d
        in if arity > 0 then
          Just (KDirect (nativeFuncLabel name) arity)
        else
          case irDefBody d of
            Nothing => Nothing
            Just b =>
              case stripTail b of
                IrRt sym => rtLeafCallee sym
                IrGlobal g => if g == name then Nothing else globalCallee (fuel - 1) defs g
                IrLam bs _ _ =>
                  let
                    n = length (runtimeBinders bs)
                  in if n > 0 then Just (KClosure n) else Nothing
                IrApp _ _ _ =>
                  case flattenApp (stripTail b) of
                    Pair h args => partialCallee (knownCalleeFuel (fuel - 1) defs [] h) (length args)
                _ => Nothing

-- | 已知闭包被部分应用后的剩余 arity（与 `rt_apply` 的 shim 同口径）；不是部分应用时未知。
partialCallee : Maybe KnownCallee -> Int -> Maybe KnownCallee
partialCallee Nothing _ = Nothing
partialCallee (Just kc) k =
  let
    a = calleeArity kc
  in if k < a then Just (KClosure (a - k)) else Nothing

-- | 闭包体只看得到自己的捕获值：已知表按捕获集合筛一遍。
filterKnown : List (Pair IrBinder Int) -> List (Pair Int KnownCallee) -> List (Pair Int KnownCallee)
filterKnown caps known = filter (knownKept caps) known

knownKept : List (Pair IrBinder Int) -> Pair Int KnownCallee -> Bool
knownKept caps (Pair id _) = anyCap id caps

anyCap : Int -> List (Pair IrBinder Int) -> Bool
anyCap _ [] = False
anyCap id ((Pair b _) :: rest) = if b.irBinderId == id then True else anyCap id rest

-- | 饱和的已知调用：`KDirect` 不生成闭包值，直接标准 ABI 调用；`KClosure` 仍从槽取
--   闭包（`rdi`），但跳过运行时 arity 检查与 `rt_apply` 回退。
genKnownApply : Int -> FGen -> Bool -> Ir -> List Ir -> KnownCallee -> NRes (Pair (List Instr) FGen)
genKnownApply fuel st isTail head args kc =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case kc of
      KDirect label arity => if isTail && tailCallFits st (nativeStackArgCount arity nativeMaxArgs) then genTailCall (fuel - 1) st label args else genSaturatedCall (fuel - 1) st label args
      KClosure arity =>
        nbind (genExpr (fuel - 1) st head) (
            \p =>
              let
                cloP = freshSlot (secondOf p)
                clo = firstOf cloP
              in nbind (genArgs (fuel - 1) (secondOf cloP) args) (
                  \q =>
                    let
                      slots = firstOf (secondOf q)
                      callIns = if isTail && tailCallFits st (nativeStackArgCount arity (length closureArgRegs)) then closureTailCallSlotsInstrs clo slots else closureCallSlotsInstrs clo slots
                    in NOk (Pair (cat [firstOf p, storeSlot clo, firstOf q, callIns]) (secondOf (secondOf q)))
                )
          )

-- | 全局应用。`irDefArity` 为 0 的定义是 η-收缩后的别名（body 本身就是函数值）：
--   别名链解析到运行时叶子或目标定义时直接调用（饱和则内联标量叶子），否则
--   取它的值再应用实参（与 wasm 侧 `genGlobalRef` 同口径）。
genGlobalCall : Int -> FGen -> Bool -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genGlobalCall fuel st isTail name args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case findDef name st.fgDefs of
      Nothing => internal "undefined global in native codegen: ${name}"
      Just d =>
        let
          arity = irDefArity d
        in if isTail && st.fgSelfLoop /= "" && st.fgSelfLabel == nativeFuncLabel name && arity == length args then
          genSelfTailCall (fuel - 1) st args
        else if arity == length args then
          if isTail && tailCallFits st (nativeStackArgCount arity nativeMaxArgs) then genTailCall (fuel - 1) st (nativeFuncLabel name) args else genSaturatedCall (fuel - 1) st (nativeFuncLabel name) args
        else if arity == 0 then
          case aliasTargetOf (length st.fgDefs) st.fgDefs name of
            Just (AliasRt sym) => genRtValueCall (fuel - 1) st isTail sym args
            Just (AliasGlobal g) => if g == name then genApplyHead (fuel - 1) st isTail (IrGlobal name) args else genGlobalCall (fuel - 1) st isTail g args
            Nothing =>
              case knownCalleeOf st.fgDefs st.fgKnown (IrGlobal name) of
                Just kc => if length args == calleeArity kc then genKnownApply (fuel - 1) st isTail (IrGlobal name) args kc else genApplyHead (fuel - 1) st isTail (IrGlobal name) args
                Nothing => genApplyHead (fuel - 1) st isTail (IrGlobal name) args
        else
          genApplyHead (fuel - 1) st isTail (IrGlobal name) args

genNatSuccCall : Int -> FGen -> Bool -> Ir -> NRes (Pair (List Instr) FGen)
genNatSuccCall fuel st isTail arg =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else if isTail then
    genTailCall (fuel - 1) st (nativeRtLabel "nat_succ") [arg]
  else
    nbind
      (genExpr (fuel - 1) st arg)
      (\p => NOk (Pair (append (firstOf p) [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "nat_succ")]) (secondOf p)))

-- ---------------------------------------------------------------
-- 标量运行时叶子的调用点展开
-- ---------------------------------------------------------------
memReg : Reg -> List Reg -> Bool
memReg _ [] = False
memReg r (x :: rest) = if sameReg r x then True else memReg r rest

dropReg : Reg -> List Reg -> List Reg
dropReg _ [] = []
dropReg r (x :: rest) = if sameReg r x then rest else x :: dropReg r rest

-- | 可用临时寄存器池：调用点前后都空闲的 caller-saved 寄存器。`r10` 只被
--   annotation 在 call 前两条指令里写，内联序列没有 call，所以也能用。
scalarRegs : List Reg
scalarRegs = [Rax, R11, R10, R8, R9]

-- | 把纯标量表达式选进寄存器：只接受字面量、槽变量、标量 cast 与白名单 `IrRtApp`；
--   返回结果寄存器、指令与回收后的寄存器池。其它形态返回 Nothing（整棵子树回退）。
genScalarInto : FGen -> List Reg -> Ir -> Maybe (Pair Reg (Pair (List Instr) (List Reg)))
genScalarInto st pool (IrInt n) =
  case pool of
    r :: rest => Just (Pair r (Pair [IMov (OpReg r) (OpImm n)] rest))
    [] => Nothing
genScalarInto st pool (IrVar b) =
  case lookupBinder b st.fgSlots of
    Just slot =>
      case pool of
        r :: rest => Just (Pair r (Pair [IMov (OpReg r) (OpMem Rbp (nativeSlotOff slot))] rest))
        [] => Nothing
    Nothing => Nothing
genScalarInto st pool (IrCast from to inner) =
  if isScalarCls (clsOfTy st from) && isScalarCls (clsOfTy st to) then
    genScalarInto st pool inner
  else
    Nothing
genScalarInto st pool (IrRtApp sym args) =
  case scalarPlanOf sym of
    Nothing => Nothing
    Just plan =>
      if length args /= irInlineArity sym then Nothing else genScalarOp st pool (firstOf plan) args
genScalarInto _ _ _ = Nothing

-- | 白名单算子的寄存器选择；`ScalarCmp` 的结果固定在 rax（`setcc` + `movzx rax, al`）。
genScalarOp : FGen -> List Reg -> ScalarOp -> List Ir -> Maybe (Pair Reg (Pair (List Instr) (List Reg)))
genScalarOp st pool (ScalarConst n) _ =
  case pool of
    r :: rest => Just (Pair r (Pair [IMov (OpReg r) (OpImm n)] rest))
    [] => Nothing
genScalarOp st pool (ScalarCmp cc) args =
  if not (memReg Rax pool) then
    Nothing
  else
    case args of
      [a, b] =>
        case genScalarInto st (dropReg Rax pool) a of
          Just pa =>
            case genScalarInto st (secondOf (secondOf pa)) b of
              Just pb =>
                let
                  rA = firstOf pa
                  inA = firstOf (secondOf pa)
                  rB = firstOf pb
                  inB = firstOf (secondOf pb)
                  rest = secondOf (secondOf pb)
                  res = scalarInstrs (ScalarCmp cc) rA rB
                in Just (Pair (firstOf res) (Pair (append inA (append inB (secondOf res))) (rA :: rB :: rest)))
              Nothing => Nothing
          Nothing => Nothing
      _ => Nothing
genScalarOp st pool ScalarNatFromInt args =
  case args of
    [a] =>
      case pool of
        r :: rest =>
          case genScalarInto st (r :: rest) a of
            Just pa =>
              case secondOf (secondOf pa) of
                s :: rest2 =>
                  let
                    res = scalarInstrs ScalarNatFromInt (firstOf pa) s
                  in Just
                    (Pair (firstOf res) (Pair (append (firstOf (secondOf pa)) (secondOf res)) (s :: rest2)))
                [] => Nothing
            Nothing => Nothing
        [] => Nothing
    _ => Nothing
genScalarOp st pool op args =
  case args of
    [] =>
      case pool of
        r :: rest =>
          let
            res = scalarInstrs op r r
          in Just (Pair (firstOf res) (Pair (secondOf res) (r :: rest)))
        [] => Nothing
    [a] =>
      case pool of
        r :: rest =>
          case genScalarInto st (r :: rest) a of
            Just pa =>
              let
                res = scalarInstrs op (firstOf pa) (firstOf pa)
              in Just
                (Pair (firstOf res) (Pair (append (firstOf (secondOf pa)) (secondOf res)) (secondOf (secondOf pa))))
            Nothing => Nothing
        [] => Nothing
    [a, b] =>
      case pool of
        r :: rest =>
          case genScalarInto st (r :: rest) a of
            Just pa =>
              case genScalarInto st (secondOf (secondOf pa)) b of
                Just pb =>
                  let
                    rA = firstOf pa
                    inA = firstOf (secondOf pa)
                    rB = firstOf pb
                    inB = firstOf (secondOf pb)
                    restB = secondOf (secondOf pb)
                    res = scalarInstrs op rA rB
                  in Just
                    (Pair (firstOf res) (Pair (append inA (append inB (secondOf res))) (rB :: restB)))
                Nothing => Nothing
            Nothing => Nothing
        [] => Nothing
    _ => Nothing

-- | `IrRtApp` 的标量选择：命中返回以 rax 收尾的指令序列，否则 Nothing（调用方回退）。
genInlineRt : FGen -> String -> List Ir -> Maybe (List Instr)
genInlineRt st sym args =
  case scalarPlanOf sym of
    Nothing => Nothing
    Just plan =>
      if length args /= irInlineArity sym then
        Nothing
      else
        case genScalarOp st scalarRegs (firstOf plan) args of
          Nothing => Nothing
          Just p =>
            let
              r = firstOf p
              instrs = firstOf (secondOf p)
            in Just (if sameReg r Rax then instrs else append instrs [IMov (OpReg Rax) (OpReg r)])

-- | 零参常量桩（调试 / 可观测性叶子）的内联值。
scalarConstOf : String -> Maybe Int
scalarConstOf sym =
  case scalarPlanOf sym of
    Nothing => Nothing
    Just plan =>
      case firstOf plan of
        ScalarConst n => Just n
        _ => Nothing

genRtApp : Int -> FGen -> Bool -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genRtApp fuel st isTail sym args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case sym of
      "&&" => genBoolChain (fuel - 1) st args True
      "||" => genBoolChain (fuel - 1) st args False
      _ =>
        case genInlineRt st sym args of
          Just instrs => NOk (Pair instrs st)
          Nothing =>
            case nativeRtTarget sym of
              Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
              Just label => if length args /= irInlineArity sym then internal "runtime symbol arity mismatch: ${sym}" else if isTail then genTailCall (fuel - 1) st label args else genSaturatedCall (fuel - 1) st label args

-- | `IrApp (IrRt sym) args`：运行时常量函数值的应用（`irInlineArity = 0` 的那些）。
--   标量叶子先走内联选择；其余饱和走直调，部分/过度应用先求值成闭包再交给 `rt_apply`。
genRtValueCall : Int -> FGen -> Bool -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genRtValueCall fuel st isTail sym args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case genInlineRt st sym args of
      Just instrs => NOk (Pair instrs st)
      Nothing =>
        let
          arity = rtValueArityOf sym
        in if arity <= 0 then
          unsupported "native target: runtime function values are not supported yet"
        else if length args == arity then
          case nativeRtTarget sym of
            Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
            Just label => if isTail then genTailCall (fuel - 1) st label args else genSaturatedCall (fuel - 1) st label args
        else
          genApplyHead (fuel - 1) st isTail (IrRt sym) args

-- | `IrConcatMany`：左→右两两拼接（与 OCaml 的 `String.concat ""` 语义一致）。
--   `parts` 至少 3 项（Lowering 的门槛），空/单元素的兜底只防空指针。
genConcatMany : Int -> FGen -> List Ir -> NRes (Pair (List Instr) FGen)
genConcatMany fuel st parts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case parts of
      [] => internal "empty string concatenation in native codegen"
      [one] => genExpr (fuel - 1) st one
      first :: rest =>
        nbind (genExpr (fuel - 1) st first) (
            \p =>
              let
                slotP = freshSlot (secondOf p)
                slot = firstOf slotP
                st1 = secondOf slotP
              in nbind (genConcatRest (fuel - 1) st1 slot rest) (\q => NOk (Pair (append (firstOf p) (append (storeSlot slot) (firstOf q))) (secondOf q)))
          )

-- | 累加器在 `slot`；对每个后续片段求值后与累加值拼接，结果回写累加器。
genConcatRest : Int -> FGen -> Int -> List Ir -> NRes (Pair (List Instr) FGen)
genConcatRest _ st slot [] = NOk (Pair (loadSlot slot) st)
genConcatRest fuel st slot (part :: rest) =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind
      (genExpr (fuel - 1) st part)
      (\p => nbind (genConcatRest (fuel - 1) (secondOf p) slot rest) (\q => NOk (Pair (append (firstOf p) (append [IMov (OpReg Rsi) (OpReg Rax)] (append (loadReg Rdi slot) (append [ICall (nativeRtLabel "str_concat"), IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)] (firstOf q))))) (secondOf q))))

listHasStr : String -> List String -> Bool
listHasStr _ [] = False
listHasStr x (y :: rest) = if x == y then True else listHasStr x rest

-- | `Show Float` 的实现（`Base.Data.Float.floatRender`）；入口展示与用户 `show` 共用。
floatRenderName : String
floatRenderName = "Base.Data.Float.floatRender"

-- ---------------------------------------------------------------
-- 浮点字面量
-- ---------------------------------------------------------------
-- 字面量原文是数字、一个小数点与可选的前导 `-`。用 `int / 10^k` 在运行期算成
-- double：分子分母都 < 2^53 时与宿主解析同一舍入结果；更长的字面量按 Int 精度截断。
-- 符号单独折成 `-1.0 * mag`，`-0.0` 才能得到 IEEE 负零。
floatDigitsOf : String -> Int
floatDigitsOf s = floatDigitsGo (strUnpack s) 0

floatDigitsGo : List Int -> Int -> Int
floatDigitsGo [] acc = acc
floatDigitsGo (c :: rest) acc =
  if c >= 48 && c <= 57 then floatDigitsGo rest (acc * 10 + (c - 48)) else floatDigitsGo rest acc

floatPow10 : Int -> Int
floatPow10 n = if n <= 0 then 1 else 10 * floatPow10 (n - 1)

floatLitNegative : String -> Bool
floatLitNegative s = strAt s 0 == 45

negateFloatInstrs : Int -> List Instr
negateFloatInstrs slot =
  [
    IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax),
    IMov (OpReg Rdi) (OpImm (-1)),
    ICall (nativeRtLabel "float_from_int"),
    IMov (OpReg Rsi) (OpReg Rax),
    IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff slot)),
    ICall (nativeRtLabel "float_mul")
  ]

finishFloatLit : Bool -> FGen -> List Instr -> NRes (Pair (List Instr) FGen)
finishFloatLit False st is = NOk (Pair is st)
finishFloatLit True st is =
  let
    slotP = freshSlot st
  in NOk (Pair (append is (negateFloatInstrs (firstOf slotP))) (secondOf slotP))

genFloatLit : FGen -> String -> NRes (Pair (List Instr) FGen)
genFloatLit st raw =
  case String.split "." raw of
    [ip, fp] =>
      let
        num = floatDigitsOf (ip ++ fp)
        den = floatPow10 (strLength fp)
      in if den == 1 then
        finishFloatLit (floatLitNegative raw) st [IMov (OpReg Rdi) (OpImm num), ICall (nativeRtLabel "float_from_int")]
      else
        let
          slotP = freshSlot st
          slot = firstOf slotP
        in finishFloatLit (floatLitNegative raw) (secondOf slotP) [IMov (OpReg Rdi) (OpImm num), ICall (nativeRtLabel "float_from_int"), IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax), IMov (OpReg Rdi) (OpImm den), ICall (nativeRtLabel "float_from_int"), IMov (OpReg Rsi) (OpReg Rax), IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff slot)), ICall (nativeRtLabel "float_div")]
    _ =>
      finishFloatLit
        (floatLitNegative raw)
        st
        [IMov (OpReg Rdi) (OpImm (floatDigitsOf raw)), ICall (nativeRtLabel "float_from_int")]

-- ---------------------------------------------------------------
-- Eff thunk（效应原语包装成 `MkEff (fun _ => prim args)`）
-- ---------------------------------------------------------------
-- | 效应原语包装成 `MkEff (\_ => prim args)`（构造细节在 `Ir.Synthetic`）；
-- native 额外把新合成的 lambda 重新标尾位置。
nativeArityOf : FGen -> String -> Maybe Int
nativeArityOf st name =
  case findDef name st.fgDefs of
    Just d => Just (irDefArity d)
    Nothing => Nothing

genEffThunk : Int -> FGen -> String -> String -> Int -> Ir -> NRes (Pair (List Instr) FGen)
genEffThunk fuel st family ctor arity prim =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    genExpr
      (fuel - 1)
      st
      (annotateBody (nativeArityOf st) (Synthetic.effThunkIr family ctor arity prim))

-- | 生成预算按定义体规模派生（每节点最多几步递归，与 `Ir.Cps` 的 `cpsFuelOfBody` 同口径）。
--   固定 100000 会让大定义体在没有任何不变式被破坏时报 fuel exhausted。
nativeFuelOfBody : Ir -> Int
nativeFuelOfBody body = 64 + 16 * irSize body

-- | 值位置生成：结果留在 `rax`，任何调用都正常返回。
genExpr : Int -> FGen -> Ir -> NRes (Pair (List Instr) FGen)
genExpr fuel st ir = genExprAt fuel st False ir

-- | `isTail` 表示结果位置。只有「结果就是本函数返回值」的位置才允许尾调用：
--   `IrLet` 的 body、`IrIf` 两支、`IrCase` / `IrNatCase` 各臂、`IrCast` 内层与
--   `IrApp` 是透明位置；实参、scrutinee、构造字段一律按值位置生成。
genExprAt : Int -> FGen -> Bool -> Ir -> NRes (Pair (List Instr) FGen)
genExprAt fuel st isTail ir =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case ir of
      IrVar b =>
        case lookupBinder b st.fgSlots of
          Just slot => NOk (Pair (loadSlot slot) st)
          Nothing => internal "unbound runtime binder in native codegen"
      IrGlobal name =>
        case findDef name st.fgDefs of
          Nothing => internal "undefined global in native codegen: ${name}"
          Just d => if isCafDef d then NOk (Pair [IMov (OpReg Rax) (OpRip (nativeCafCellLabel name))] st) else if irDefArity d == 0 then if isTail then NOk (Pair (tailCallSlotsInstrs (nativeFuncLabel name) []) st) else NOk (Pair [ICall (nativeFuncLabel name)] st) else genValueClosure st (modulePathOf name) (nativeGlobalValueLabel name) (irDefArity d) (nativeFuncLabel name)
      IrInt n => if n < 0 - 4611686018427387903 - 1 || n > 4611686018427387903 then unsupported "native target: integer literal outside the 63-bit range" else NOk (Pair [IMov (OpReg Rax) (OpImm n)] st)
      IrStr s =>
        case poolLabelOf s st.fgPool of
          Nothing => internal "string literal missing from native pool"
          Just label => NOk (Pair [ILea Rax label] st)
      IrBool b => NOk (Pair [IMov (OpReg Rax) (OpImm (if b then 1 else 0))] st)
      IrCast cFrom cTo inner => genExprAt (fuel - 1) st isTail inner
      IrLet bs scrut body =>
        nbind (genExpr (fuel - 1) st scrut) (
            \p =>
              let
                rbs = runtimeBinders bs
                st1 = secondOf p
              in case rbs of
                [] => nbind (genExprAt (fuel - 1) st1 isTail body) (\q => NOk (Pair (append (firstOf p) (firstOf q)) (secondOf q)))
                [b] =>
                  let
                    slotP = freshSlot st1
                    slot = firstOf slotP
                    st2 = secondOf slotP
                    st3 = rememberCallee b scrut st2
                  in nbind (genExprAt (fuel - 1) (pushBinderCls b slot (binderCls st1 (Just (valueCls st1 scrut)) b) st3) isTail body) (\q => NOk (Pair (append (firstOf p) (append (storeSlot slot) (firstOf q))) (restoreBinderScope (secondOf q) st1.fgSlots)))
                _ => unsupported "native target: let with more than one runtime binder is not supported yet"
          )
      IrIf c t e =>
        nbind (genExpr (fuel - 1) st c) (
            \p =>
              let
                lElseP = freshLabel (secondOf p)
                lElse = firstOf lElseP
                st1 = secondOf lElseP
                lEndP = freshLabel st1
                lEnd = firstOf lEndP
                st2 = secondOf lEndP
              in nbind (genExprAt (fuel - 1) st2 isTail t) (
                  \pt =>
                    nbind (genExprAt (fuel - 1) (secondOf pt) isTail e) (
                        \pe =>
                          let
                            body = append (firstOf p) (append [ITest Rax Rax, IJcc "je" lElse] (append (firstOf pt) (append [IJmp lEnd, ILabel lElse] (append (firstOf pe) [ILabel lEnd]))))
                          in NOk (Pair body (secondOf pe))
                      )
                )
          )
      IrCtor family ctor _ args => genCtor (fuel - 1) st family ctor args
      IrRecord family _ fields => genRecord (fuel - 1) st family fields
      IrProj base family field _ => genProj (fuel - 1) st base family field
      IrRecUpd base family fields _ => genRecUpd (fuel - 1) st base family fields
      IrCase caseTy _ scrut alts => genCase (fuel - 1) st isTail caseTy scrut alts
      IrApp _ _ _ => genApp (fuel - 1) st isTail ir
      IrRtApp sym args => genRtApp (fuel - 1) st isTail sym args
      IrConcatMany parts => genConcatMany (fuel - 1) st parts
      IrNatCase scrut _fresh zero succ catch => genNatCase (fuel - 1) st isTail scrut zero succ catch
      IrLam bs _ body => genLamValue (fuel - 1) st bs body
      IrRt sym =>
        let
          arity = rtValueArityOf sym
        in case nativeRtTarget sym of
          Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
          Just label =>
            if arity <= 0 then
              case scalarConstOf sym of
                Just n => NOk (Pair [IMov (OpReg Rax) (OpImm n)] st)
                Nothing => if isTail then NOk (Pair (tailCallSlotsInstrs label []) st) else NOk (Pair [ICall label] st)
            else
              genValueClosure st nativeRuntimeModule (nativeRtValueLabel sym) arity label
      IrFloatLit raw => genFloatLit st raw
      IrEffThunk family ctor _unitTy arity prim => genEffThunk (fuel - 1) st family ctor arity prim
      IrTail inner => genExprAt (fuel - 1) st True inner
      IrEffBind _ _ _ => unsupported "native target: effect bindings are not supported yet"

-- `&&` / `||`：短路；a 为 0/1，b 为 Bool。
genBoolChain : Int -> FGen -> List Ir -> Bool -> NRes (Pair (List Instr) FGen)
genBoolChain fuel st args isAnd =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case args of
      [a, b] =>
        nbind (genExpr (fuel - 1) st a) (
            \p =>
              let
                lEndP = freshLabel (secondOf p)
                lEnd = firstOf lEndP
                st1 = secondOf lEndP
                cond = if isAnd then "je" else "jne"
              in nbind (genExpr (fuel - 1) st1 b) (\q => NOk (Pair (append (firstOf p) (append [ITest Rax Rax, IJcc cond lEnd] (append (firstOf q) [ILabel lEnd]))) (secondOf q)))
          )
      _ => internal "`&&`/`||` must have exactly two arguments"

-- 应用：flatten 左脊，支持饱和顶层调用、`@ir@natSucc`、运行时值函数。
--
-- | 立即应用的 lambda：参数求值到槽后把体就地内联。体内残留的 `IrTail` 是「函数体
--   结果位置」的注解，内联后已不在尾位置，必须用 `IrTail.stripTail` 去掉（只保留嵌套
--   lambda 体里的标记，那是它们自己的函数体）；内联点的尾位置由调用方的 `isTail` 决定。
genLamApp : Int -> FGen -> Bool -> List IrBinder -> List Ir -> Ir -> NRes (Pair (List Instr) FGen)
genLamApp fuel st isTail bs args body =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genArgs (fuel - 1) st args) (
        \p =>
          let
            st1 = bindLamArgs (secondOf (secondOf p)) bs args (firstOf (secondOf p))
          in nbind (genExprAt (fuel - 1) st1 isTail (stripTail body)) (\q => NOk (Pair (append (firstOf p) (firstOf q)) (restoreBinderScope (secondOf q) st.fgSlots)))
      )

-- | 把已求值到槽的形参绑定进作用域：槽 kind 与「已知被调用者」都跟过来。
bindLamArgs : FGen -> List IrBinder -> List Ir -> List Int -> FGen
bindLamArgs st [] args slots = st
bindLamArgs st (b :: brest) [] slots = st
bindLamArgs st (b :: brest) (a :: arest) [] = st
bindLamArgs st (b :: brest) (a :: arest) (s :: srest) =
  let
    st1 = pushBinderCls b s (binderCls st (Just (valueCls st a)) b) st
    st2 = rememberCallee b a st1
  in bindLamArgs st2 brest arest srest

-- | 记下 binder 的静态已知被调用者（如果有）。
rememberCallee : IrBinder -> Ir -> FGen -> FGen
rememberCallee b value st =
  case knownCalleeOf st.fgDefs st.fgKnown value of
    Just kc => { st | fgKnown = Pair b.irBinderId kc :: st.fgKnown }
    Nothing => st

genApp : Int -> FGen -> Bool -> Ir -> NRes (Pair (List Instr) FGen)
genApp fuel st isTail ir =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case flattenApp ir of
      Pair head args =>
        case head of
          IrGlobal name => genGlobalCall (fuel - 1) st isTail name args
          IrLam bs _ body =>
            let
              rbs = runtimeBinders bs
            in if length args > 0 && length rbs == length args then genLamApp (fuel - 1) st isTail rbs args body else genApplyHead (fuel - 1) st isTail head args
          IrRt s =>
            if s == irRtNatSucc then
              case args of
                [a] => genNatSuccCall (fuel - 1) st isTail a
                _ => internal "Nat Succ must have exactly one argument"
            else if s == "prim_erase" || s == "@vuna@prim@toObj" || s == "@vuna@prim@fromObj" then
              case args of
                [] => internal "prim_erase needs an argument"
                x :: rest => genExprAt (fuel - 1) st isTail (Synthetic.applyAllIr x rest)
            else
              genRtValueCall (fuel - 1) st isTail s args
          -- 动态 head：构造点已知（lambda / 顶层函数 / 运行时叶子 / 它们的部分应用）时
          -- 直接调用；其余求值成闭包后交给 `rt_apply`（饱和 / 部分 / 过度统一处理）。
          _ =>
            case knownCalleeOf st.fgDefs st.fgKnown head of
              Just kc => if length args == calleeArity kc then genKnownApply (fuel - 1) st isTail head args kc else genApplyHead (fuel - 1) st isTail head args
              Nothing => genApplyHead (fuel - 1) st isTail head args

-- ---------------------------------------------------------------
-- 闭包
-- ---------------------------------------------------------------
-- 表示（与 wasm 侧同一决策）：闭包 = 堆对象 `[code ptr][captured...]`。
-- 调用约定：`rdi` = 闭包自身（env 基址），实参从 `rsi` 起（第 6 个起压栈）。
-- 捕获策略：只把 body 真正引用到的（含嵌套 lambda 递归可见的）binder 拷进闭包；
-- 没有捕获时闭包是只读常量（`vuna_static_*`），不分配。
closureArgRegs : List Reg
closureArgRegs = [Rsi, Rdx, Rcx, R8, R9]

-- | 表达式引用到的 binder id（含嵌套 lambda 的体：外层闭包必须把内层闭包要用的值
--   一并留在自己的帧里）。只收集身份，不区分绑定层级。
export binderRefsOf : Ir -> List Int
binderRefsOf (IrVar b) = [b.irBinderId]
binderRefsOf (IrTail inner) = binderRefsOf inner
binderRefsOf ir = binderRefsChildren ir

binderRefsChildren : Ir -> List Int
binderRefsChildren (IrCtor _ _ _ args) = binderRefsList args
binderRefsChildren (IrRecord _ _ fields) = binderRefsFields fields
binderRefsChildren (IrProj base _ _ _) = binderRefsOf base
binderRefsChildren (IrRecUpd base _ fields _) = append (binderRefsOf base) (binderRefsFields fields)
binderRefsChildren (IrRtApp _ args) = binderRefsList args
binderRefsChildren (IrCast _ _ inner) = binderRefsOf inner
binderRefsChildren (IrLet _ scrut body) = append (binderRefsOf scrut) (binderRefsOf body)
binderRefsChildren (IrLam _ _ body) = binderRefsOf body
binderRefsChildren (IrApp _ f a) = append (binderRefsOf f) (binderRefsOf a)
binderRefsChildren (IrIf c t e) = append (binderRefsOf c) (append (binderRefsOf t) (binderRefsOf e))
binderRefsChildren (IrCase _ _ scrut alts) = append (binderRefsOf scrut) (binderRefsAlts alts)
binderRefsChildren (IrNatCase scrut _ zero succ catch) =
  append
    (binderRefsOf scrut)
    (append (binderRefsAlt zero) (append (binderRefsAlt succ) (binderRefsAlt catch)))
binderRefsChildren (IrConcatMany parts) = binderRefsList parts
binderRefsChildren (IrEffThunk _ _ _ _ prim) = binderRefsOf prim
binderRefsChildren _ = []

binderRefsList : List Ir -> List Int
binderRefsList [] = []
binderRefsList (ir :: rest) = append (binderRefsOf ir) (binderRefsList rest)

binderRefsFields : List (Pair String Ir) -> List Int
binderRefsFields [] = []
binderRefsFields (p :: rest) = append (binderRefsOf (secondOf p)) (binderRefsFields rest)

binderRefsAlts : List IrAlt -> List Int
binderRefsAlts [] = []
binderRefsAlts (alt :: rest) = append (binderRefsOf (irAltBodyOf alt)) (binderRefsAlts rest)

binderRefsAlt : Maybe IrAlt -> List Int
binderRefsAlt Nothing = []
binderRefsAlt (Just alt) = binderRefsOf (irAltBodyOf alt)

-- | 当前作用域里真正被 `body` 引用（含嵌套 lambda）的 binder；顺序与入参一致。
--   闭包只捕获这些值：无捕获时闭包是只读常量，不需要分配。
export captureList : List (Pair IrBinder Int) -> Ir -> List (Pair IrBinder Int)
captureList caps body =
  let
    refs = binderRefsOf body
  in filter (capUsed refs) caps

capUsed : List Int -> Pair IrBinder Int -> Bool
capUsed refs (Pair b _) = memBinderId b.irBinderId refs

memBinderId : Int -> List Int -> Bool
memBinderId _ [] = False
memBinderId id (x :: rest) = if id == x then True else memBinderId id rest

-- | 闭包函数入口：把捕获值从 `[rdi + 8 + 8*i]` 拷进本帧槽并绑定 binder。
--   `parentCls` 是创建处（父帧）的槽 kind 表：捕获值搬过来，kind 也跟过来。
bindCaptures : FGen -> List (Pair Int NCls) -> List (Pair IrBinder Int) -> Int -> NRes (Pair (List Instr) FGen)
bindCaptures st _ [] _ = NOk (Pair [] st)
bindCaptures st parentCls ((Pair b src) :: rest) i =
  let
    slotP = freshSlot st
    slot = firstOf slotP
    st1 = pushBinderCls b slot (slotClsAt src parentCls) (secondOf slotP)
    ins =
      [IMov (OpReg Rax) (OpMem Rdi (16 + 8 * i)), IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]
  in nbind
    (bindCaptures st1 parentCls rest (i + 1))
    (\q => NOk (Pair (append ins (firstOf q)) (secondOf q)))

storeCloCode : Int -> String -> List Instr
storeCloCode obj label =
  [ILea Rax label, IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpMem Rdx 0) (OpReg Rax)]

storeCloArity : Int -> Int -> List Instr
storeCloArity obj n =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpMem Rdx 8) (OpImm n)]

storeCapsAt : Int -> Int -> List (Pair IrBinder Int) -> List Instr
storeCapsAt obj i [] = []
storeCapsAt obj i (p :: rest) =
  append (setObjFromSlot obj (16 + 8 * i) (secondOf p)) (storeCapsAt obj (i + 1) rest)

-- | `IrLam` 作为值：生成闭包函数体并构造闭包对象。body 的尾位置由 `IrTail` 标记。
--   只捕获 body 真正引用的 binder：无捕获时闭包是只读常量（`vuna_static_*`），不分配。
genLamValue : Int -> FGen -> List IrBinder -> Ir -> NRes (Pair (List Instr) FGen)
genLamValue fuel st bs body =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else if length (runtimeBinders bs) == 0 then
    genExpr (fuel - 1) st body
  else
    let
      rbs = runtimeBinders bs
      -- 同 wasm：env 按「最外层 → 最内层」排，入口 pushBinder 后最内层同名 binder 在表头。
      caps = captureList (reverse st.fgSlots) body
      ncap = length caps
      arity = length rbs
      idx = st.fgNextLabel
      lamName = "vuna_${nativeName st.fgOwner}_lam${strFromInt idx}"
      st1 = { st | fgNextLabel = idx + 1 }
      -- 闭包体自己的来参区由闭包 ABI 决定（`rdi` 是闭包自身，实参从 `rsi` 起）。
      lamRoom = nativeTailRoomBytes (nativeStackArgCount arity (length closureArgRegs))
      stBody = FGen st1.fgDefs st1.fgPool [] [] st1.fgFams 0 st1.fgNextLabel [] lamRoom st1.fgModule st1.fgOwner "" "" [] [] (filterKnown caps st.fgKnown)
    in nbind (bindCaptures stBody st.fgSlotCls caps 0) (
        \cp =>
          nbind (bindArgsGo rbs 1 (secondOf cp)) (
              \bp =>
                nbind (genExpr (fuel - 1) (secondOf bp) body) (
                    \q =>
                      let
                        stF = secondOf q
                        frame = nativeFrameBytes stF.fgNextSlot
                        lamBody = append (firstOf cp) (append (firstOf bp) (firstOf q))
                        lamFunc = NativeFunc lamName frame (append (nativePrologue frame) (append (peephole lamBody) nativeEpilogue)) st.fgModule
                        lams = append st1.fgLams (append stF.fgLams [lamFunc])
                      in if ncap == 0 then
                        let
                          staticLabel = nativeStaticClosureLabel lamName arity
                          st2 = { st1 | fgLams = lams, fgStatics = append st1.fgStatics (append stF.fgStatics [NativeClosure staticLabel lamName arity]) }
                          st3 = { st2 | fgNextLabel = stF.fgNextLabel }
                        in NOk (Pair [ILea Rax staticLabel] st3)
                      else
                        let
                          allocP = genAlloc st1 (2 + ncap)
                          obj = firstOf (secondOf allocP)
                          st2 = secondOf (secondOf allocP)
                          bodyIns = append (firstOf allocP) (append (storeCloCode obj lamName) (append (storeCloArity obj arity) (append (storeCapsAt obj 0 caps) (getLocal obj))))
                          st3 = { st2 | fgLams = lams, fgStatics = append st2.fgStatics stF.fgStatics }
                          -- 闭包函数体里用掉的内部 label 必须回写：否则父函数继续编号会撞名。
                          st4 = { st3 | fgNextLabel = stF.fgNextLabel }
                        in NOk (Pair bodyIns st4)
                  )
            )
      )

-- ---------------------------------------------------------------
-- data / record
-- ---------------------------------------------------------------
-- 对象布局（与 wasm 侧同一表示决策）：
--   * 变体 = 堆对象：`[obj+0]` = tag（i64），`[obj+8]` 起 = 运行时字段（i64，按最大 arity 补齐）；
--   * record = 堆对象：`[obj+0]` 起就是字段（没有 tag）。
-- 分配走 bump 堆（`rt_alloc`）；对象只写后读，不做初始化。
cat : List (List Instr) -> List Instr
cat xs = concatMap (\x => x) xs

listLengthI : List a -> Int
listLengthI [] = 0
listLengthI (_ :: rest) = 1 + listLengthI rest

setLocal : Int -> List Instr
setLocal slot = [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]

getLocal : Int -> List Instr
getLocal slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot))]

-- | 写对象字段：rax ← 槽 `fromSlot`，rdx ← 对象基址，`[rdx+off]` ← rax。
setObjFromSlot : Int -> Int -> Int -> List Instr
setObjFromSlot obj off fromSlot =
  [
    IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff fromSlot)),
    IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)),
    IMov (OpMem Rdx off) (OpReg Rax)
  ]

setObjImm : Int -> Int -> Int -> List Instr
setObjImm obj off imm =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpMem Rdx off) (OpImm imm)]

getObjField : Int -> Int -> List Instr
getObjField obj off =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpReg Rax) (OpMem Rdx off)]

-- | 分配 `slots` 个 8 字节槽的对象；返回 (分配指令, 对象槽)。
genAlloc : FGen -> Int -> Pair (List Instr) (Pair Int FGen)
genAlloc st slots =
  let
    slotP = freshSlot st
    obj = firstOf slotP
    st1 = secondOf slotP
    instrs =
      [
        IMov (OpReg Rdi) (OpImm (8 * slots)),
        ICall (nativeRtLabel "alloc"),
        IMov (OpMem Rbp (nativeSlotOff obj)) (OpReg Rax)
      ]
  in Pair instrs (Pair obj st1)

declOf : String -> List IrTyDecl -> Maybe IrTyDecl
declOf _ [] = Nothing
declOf family (d :: rest) = if declName d == family then Just d else declOf family rest

declName : IrTyDecl -> String
declName (IrVariantDecl name _ _) = name
declName (IrRecordDecl name _ _ _) = name
declName (IrUnboxedDecl name _ _) = name

ctorTagIn : List (Pair String (List IrTy)) -> String -> Maybe Int
ctorTagIn ctors ctor = ctorTagGo ctors ctor 0

ctorTagGo : List (Pair String (List IrTy)) -> String -> Int -> Maybe Int
ctorTagGo [] _ _ = Nothing
ctorTagGo (p :: rest) name i = if firstOf p == name then Just i else ctorTagGo rest name (i + 1)

ctorArityIn : List (Pair String (List IrTy)) -> String -> Maybe Int
ctorArityIn [] _ = Nothing
ctorArityIn (p :: rest) name =
  if firstOf p == name then Just (listLengthI (secondOf p)) else ctorArityIn rest name

maxArityIn : List (Pair String (List IrTy)) -> Int
maxArityIn [] = 0
maxArityIn (p :: rest) =
  let
    n = listLengthI (secondOf p)
    m = maxArityIn rest
  in if n > m then n else m

recordPosOf : List (Pair Int String) -> String -> Maybe Int
recordPosOf fields name = recordPosGo fields name 0

recordPosGo : List (Pair Int String) -> String -> Int -> Maybe Int
recordPosGo [] _ _ = Nothing
recordPosGo (p :: rest) name i =
  if secondOf p == name then Just i else recordPosGo rest name (i + 1)

storeSlotFields : Int -> Int -> List Int -> List Instr
storeSlotFields obj idx [] = []
storeSlotFields obj idx (s :: rest) =
  append (setObjFromSlot obj (8 * idx) s) (storeSlotFields obj (idx + 1) rest)

padObjZero : Int -> Int -> Int -> List Instr
padObjZero obj idx maxIdx = concatMap (\i => setObjImm obj (8 * i) 0) (range idx maxIdx)

-- | 变体构造：分配 `1 + maxArity` 槽；写 tag，按实参顺序写字段，尾部补 0。
genCtor : Int -> FGen -> String -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genCtor fuel st family ctor args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case declOf family st.fgFams of
      Nothing => internal "unknown data family in native codegen: ${family}"
      Just (IrVariantDecl _ _ ctors) => genCtorGo fuel st ctors ctor args
      _ => internal "constructor `${ctor}` does not belong to a variant family: ${family}"

genCtorGo : Int -> FGen -> List (Pair String (List IrTy)) -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genCtorGo fuel st ctors ctor args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case ctorTagIn ctors ctor of
      Nothing => internal "unknown constructor in native codegen: ${ctor}"
      Just tag =>
        case ctorArityIn ctors ctor of
          Nothing => internal "unknown constructor in native codegen: ${ctor}"
          Just n => if listLengthI args /= n then internal "constructor `${ctor}` applied to the wrong number of arguments" else nbind (genArgs (fuel - 1) st args) (\p => genCtorFinish n tag p ctors)

-- | 纯指令拼装（不再递归进 genExpr）：分配 + 写 tag + 写字段 + 补齐。
genCtorFinish : Int -> Int -> Pair (List Instr) (Pair (List Int) FGen) -> List (Pair String (List IrTy)) -> NRes (Pair (List Instr) FGen)
genCtorFinish n tag p ctors =
  let
    st = secondOf (secondOf p)
    maxF = maxArityIn ctors
    allocP = genAlloc st (1 + maxF)
    obj = firstOf (secondOf allocP)
    body =
      cat
        [firstOf p, firstOf allocP, setObjImm obj 0 tag, storeSlotFields obj 1 (firstOf (secondOf p)), padObjZero obj (1 + n) (1 + maxF), getLocal obj]
  in NOk (Pair body (secondOf (secondOf allocP)))

-- | record 构造：按运行时字段顺序求值后写入新对象。
genRecord : Int -> FGen -> String -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genRecord fuel st family fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case declOf family st.fgFams of
      Nothing => internal "unknown record family in native codegen: ${family}"
      Just (IrRecordDecl _ _ flds _) => if listLengthI fields /= listLengthI flds then internal "record `${family}` constructed with the wrong number of fields" else nbind (genArgs (fuel - 1) st (map (\p => secondOf p) fields)) (\p => genRecordFinish p flds)
      _ => internal "family `${family}` is not a record"

genRecordFinish : Pair (List Instr) (Pair (List Int) FGen) -> List (Pair Int String) -> NRes (Pair (List Instr) FGen)
genRecordFinish p flds =
  let
    st = secondOf (secondOf p)
    slots = firstOf (secondOf p)
    allocP = genAlloc st (listLengthI flds)
    obj = firstOf (secondOf allocP)
    body = cat [firstOf p, firstOf allocP, storeSlotFields obj 0 slots, getLocal obj]
  in NOk (Pair body (secondOf (secondOf allocP)))

genProj : Int -> FGen -> Ir -> String -> String -> NRes (Pair (List Instr) FGen)
genProj fuel st base family field =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case declOf family st.fgFams of
      Nothing => internal "unknown record family in native codegen: ${family}"
      Just (IrRecordDecl _ _ flds _) =>
        case recordPosOf flds field of
          Nothing => internal "unknown record field in native codegen: `${family}.${field}`"
          Just idx => nbind (genExpr (fuel - 1) st base) (\p => genProjFinish p idx)
      _ => internal "family `${family}` is not a record"

genProjFinish : Pair (List Instr) FGen -> Int -> NRes (Pair (List Instr) FGen)
genProjFinish p idx =
  let
    slotP = freshSlot (secondOf p)
    slot = firstOf slotP
    body = cat [firstOf p, setLocal slot, getObjField slot (8 * idx)]
  in NOk (Pair body (secondOf slotP))

-- | record 更新：分配新对象；逐字段写（被改字段求新值，其余从旧对象复制）。
genRecUpd : Int -> FGen -> Ir -> String -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genRecUpd fuel st base family fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case declOf family st.fgFams of
      Nothing => internal "unknown record family in native codegen: ${family}"
      Just (IrRecordDecl _ _ flds _) => nbind (genExpr (fuel - 1) st base) (\p => genRecUpdStart fuel (firstOf p) (secondOf p) flds fields)
      _ => internal "family `${family}` is not a record"

genRecUpdStart : Int -> List Instr -> FGen -> List (Pair Int String) -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genRecUpdStart fuel baseInstrs st flds fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    let
      baseP = freshSlot st
      baseSlot = firstOf baseP
      allocP = genAlloc (secondOf baseP) (listLengthI flds)
      obj = firstOf (secondOf allocP)
    in nbind (genUpdFields (fuel - 1) (secondOf (secondOf allocP)) baseSlot obj 0 flds fields) (\q => NOk (Pair (cat [baseInstrs, setLocal baseSlot, firstOf allocP, firstOf q, getLocal obj]) (secondOf q)))

genUpdFields : Int -> FGen -> Int -> Int -> Int -> List (Pair Int String) -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genUpdFields fuel st baseSlot obj idx flds fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case flds of
      [] => NOk (Pair [] st)
      (Pair _ name) :: rest =>
        case lookupFieldIr name fields of
          Just ir =>
            nbind (genExpr (fuel - 1) st ir) (
                \p =>
                  let
                    valP = freshSlot (secondOf p)
                    val = firstOf valP
                  in nbind (genUpdFields (fuel - 1) (secondOf valP) baseSlot obj (idx + 1) rest fields) (\q => NOk (Pair (cat [firstOf p, setLocal val, setObjFromSlot obj (8 * idx) val, firstOf q]) (secondOf q)))
              )
          Nothing =>
            let
              srcP = freshSlot st
              src = firstOf srcP
            in nbind (genUpdFields (fuel - 1) (secondOf srcP) baseSlot obj (idx + 1) rest fields) (\q => NOk (Pair (cat [getObjField baseSlot (8 * idx), setLocal src, setObjFromSlot obj (8 * idx) src, firstOf q]) (secondOf q)))

lookupFieldIr : String -> List (Pair String Ir) -> Maybe Ir
lookupFieldIr _ [] = Nothing
lookupFieldIr name (p :: rest) =
  if firstOf p == name then Just (secondOf p) else lookupFieldIr name rest

-- ---------------------------------------------------------------
-- 通用 case
-- ---------------------------------------------------------------
-- | 变体按 tag 分派（线性 compare 链）；record 没有 tag，直接按字段序绑定。
genCase : Int -> FGen -> Bool -> Maybe IrTy -> Ir -> List IrAlt -> NRes (Pair (List Instr) FGen)
genCase fuel st isTail caseTy scrut alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genExpr (fuel - 1) st scrut) (
        \p =>
          let
            scP = freshSlotCls (clsOfTy st caseTy) (secondOf p)
            sc = firstOf scP
          in nbind (genCaseAlts (fuel - 1) (secondOf scP) isTail caseTy sc alts) (\q => NOk (Pair (cat [firstOf p, setLocal sc, firstOf q]) (secondOf q)))
      )

genCaseAlts : Int -> FGen -> Bool -> Maybe IrTy -> Int -> List IrAlt -> NRes (Pair (List Instr) FGen)
genCaseAlts fuel st isTail caseTy sc alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case caseFamilyOf caseTy alts of
      Nothing => genDefault fuel st isTail sc alts
      Just family =>
        case declOf family st.fgFams of
          Nothing => internal "unknown data family in native codegen: ${family}"
          Just (IrVariantDecl _ _ ctors) => genVariantAlts fuel st isTail sc ctors alts
          Just (IrRecordDecl _ _ _ _) => genRecordAlts fuel st isTail sc alts
          _ => internal "case on an unboxed family is not supported yet"

caseFamilyOf : Maybe IrTy -> List IrAlt -> Maybe String
caseFamilyOf (Just (IrTyData family _)) _ = Just family
caseFamilyOf _ alts = caseFamilyOfAlts alts

caseFamilyOfAlts : List IrAlt -> Maybe String
caseFamilyOfAlts [] = Nothing
caseFamilyOfAlts (alt :: rest) =
  case irAltCtorOf alt of
    Nothing => caseFamilyOfAlts rest
    Just p => Just (firstOf p)

findCatchAll : List IrAlt -> Maybe IrAlt
findCatchAll [] = Nothing
findCatchAll (alt :: rest) =
  case irAltCtorOf alt of
    Nothing => Just alt
    Just _ => findCatchAll rest

trapImpossible : List Instr
trapImpossible = [ICall (nativeRtLabel "trap_impossible")]

genDefault : Int -> FGen -> Bool -> Int -> List IrAlt -> NRes (Pair (List Instr) FGen)
genDefault fuel st isTail sc alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case findCatchAll alts of
      Nothing => NOk (Pair trapImpossible st)
      Just alt => genArm fuel st isTail sc alt

genArm : Int -> FGen -> Bool -> Int -> IrAlt -> NRes (Pair (List Instr) FGen)
genArm fuel st isTail sc alt =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case runtimeBinders (irAltBindersOf alt) of
      [] => genExprAt (fuel - 1) st isTail (irAltBodyOf alt)
      [b] =>
        let
          slotP = freshSlot st
          slot = firstOf slotP
        in nbind (genExprAt (fuel - 1) (pushBinderCls b slot (slotClsAt sc st.fgSlotCls) (secondOf slotP)) isTail (irAltBodyOf alt)) (\q => NOk (Pair (cat [getLocal sc, setLocal slot, firstOf q]) (restoreBinderScope (secondOf q) st.fgSlots)))
      _ => internal "case arm has more than one runtime binder"

tagOfScrut : Int -> List Instr
tagOfScrut sc = cat [getLocal sc, [IMov (OpReg Rdx) (OpReg Rax), IMov (OpReg Rax) (OpMem Rdx 0)]]

-- | 变体分支链：跳过 catch-all（它只作默认臂），其余按 tag 线性比较。
--   `all` 是原始分支表：链尾必须回到它，才能让 catch-all 兜底（否则嵌套 pattern
--   的兜底分支会被丢掉，运行时掉进 `trap_impossible`）。
genVariantAlts : Int -> FGen -> Bool -> Int -> List (Pair String (List IrTy)) -> List IrAlt -> NRes (Pair (List Instr) FGen)
genVariantAlts fuel st isTail sc ctors alts = genVariantAltsGo fuel st isTail sc ctors alts alts

genVariantAltsGo : Int -> FGen -> Bool -> Int -> List (Pair String (List IrTy)) -> List IrAlt -> List IrAlt -> NRes (Pair (List Instr) FGen)
genVariantAltsGo fuel st isTail sc ctors alts all =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case alts of
      [] => genDefault (fuel - 1) st isTail sc all
      alt :: rest =>
        case irAltCtorOf alt of
          Nothing => genVariantAltsGo (fuel - 1) st isTail sc ctors rest all
          Just (Pair _ ctor) =>
            case ctorTagIn ctors ctor of
              Nothing => internal "unknown constructor in native codegen: ${ctor}"
              Just tag =>
                let
                  lNextP = freshLabel st
                  lNext = firstOf lNextP
                  lEndP = freshLabel (secondOf lNextP)
                  lEnd = firstOf lEndP
                in nbind (genVariantArm (fuel - 1) (secondOf lEndP) isTail sc alt) (\a => nbind (genVariantAltsGo (fuel - 1) (secondOf a) isTail sc ctors rest all) (\r => NOk (Pair (cat [tagOfScrut sc, [ICmp (OpReg Rax) (OpImm tag), IJcc "jne" lNext], firstOf a, [IJmp lEnd, ILabel lNext], firstOf r, [ILabel lEnd]]) (secondOf r))))

-- | 变体分支：按 keep 形状绑定字段（tag 占 index 0），再求值分支体。
genVariantArm : Int -> FGen -> Bool -> Int -> IrAlt -> NRes (Pair (List Instr) FGen)
genVariantArm fuel st isTail sc alt =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind
      (bindFields st sc 1 (runtimeBinders (irAltBindersOf alt)))
      (\bp => nbind (genExprAt (fuel - 1) (secondOf bp) isTail (irAltBodyOf alt)) (\q => NOk (Pair (append (firstOf bp) (firstOf q)) (restoreBinderScope (secondOf q) st.fgSlots))))

bindFields : FGen -> Int -> Int -> List IrBinder -> NRes (Pair (List Instr) FGen)
bindFields st _ _ [] = NOk (Pair [] st)
bindFields st sc idx (b :: rest) =
  let
    slotP = freshSlot st
    slot = firstOf slotP
  in nbind
    (bindFields (pushBinderCls b slot (binderCls st Nothing b) (secondOf slotP)) sc (idx + 1) rest)
    (\q => NOk (Pair (cat [getObjField sc (8 * idx), setLocal slot, firstOf q]) (secondOf q)))

-- | record 分支只有一个（按字段序绑定）；catch-all 兜底。
genRecordAlts : Int -> FGen -> Bool -> Int -> List IrAlt -> NRes (Pair (List Instr) FGen)
genRecordAlts fuel st isTail sc alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case alts of
      [] => genDefault (fuel - 1) st isTail sc []
      alt :: rest =>
        case irAltCtorOf alt of
          Nothing => genDefault (fuel - 1) st isTail sc alts
          Just _ => nbind (bindFields st sc 0 (runtimeBinders (irAltBindersOf alt))) (\bp => nbind (genExprAt (fuel - 1) (secondOf bp) isTail (irAltBodyOf alt)) (\q => NOk (Pair (append (firstOf bp) (firstOf q)) (restoreBinderScope (secondOf q) st.fgSlots))))

genNatArm : Int -> FGen -> Bool -> Maybe IrAlt -> String -> Int -> NRes (Pair (List Instr) FGen)
genNatArm _ st _ Nothing _ _ = NOk (Pair [] st)
genNatArm fuel st isTail (Just alt) mode srcSlot =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    let
      bs = runtimeBinders (irAltBindersOf alt)
    in case bs of
      [] => genExprAt (fuel - 1) st isTail (irAltBodyOf alt)
      [b] =>
        if mode == "none" then
          internal "Nat case arm has a binder but no runtime binding"
        else
          let
            slotP = freshSlot st
            slot = firstOf slotP
            st1 = secondOf slotP
            bindInstrs = if mode == "pred" then append (loadSlot srcSlot) [IBin "sub" (OpImm 1)] else loadSlot srcSlot
          in nbind (genExprAt (fuel - 1) (pushBinderCls b slot NClsScalar st1) isTail (irAltBodyOf alt)) (\q => NOk (Pair (append bindInstrs (append (storeSlot slot) (firstOf q))) (restoreBinderScope (secondOf q) st.fgSlots)))
      _ => internal "Nat case arm has more than one runtime binder"

hasNatBranch : Maybe IrAlt -> Maybe IrAlt -> Bool
hasNatBranch (Just _) _ = True
hasNatBranch Nothing (Just _) = True
hasNatBranch Nothing Nothing = False

genNatCase : Int -> FGen -> Bool -> Ir -> Maybe IrAlt -> Maybe IrAlt -> Maybe IrAlt -> NRes (Pair (List Instr) FGen)
genNatCase fuel st isTail scrut zero succ catch =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genExpr (fuel - 1) st scrut) (
        \p =>
          let
            st1 = secondOf p
            slotP = freshSlotCls NClsScalar st1
            slotSc = firstOf slotP
            st2 = secondOf slotP
            lzP = freshLabel st2
            lz = firstOf lzP
            st3 = secondOf lzP
            lendP = freshLabel st3
            lend = firstOf lendP
            st4 = secondOf lendP
            zeroAlt =
              case zero of
                Just z => Just z
                Nothing => catch
            zeroMode =
              case zero of
                Just _ => "none"
                Nothing => "sc"
            succAlt =
              case succ of
                Just s => Just s
                Nothing => catch
            succMode =
              case succ of
                Just _ => "pred"
                Nothing => "sc"
          in if not (hasNatBranch zero catch) then
            internal "Nat case has no zero/catch branch"
          else if not (hasNatBranch succ catch) then
            internal "Nat case has no succ/catch branch"
          else
            nbind (genNatArm (fuel - 1) st4 isTail zeroAlt zeroMode slotSc) (
                \z =>
                  nbind (genNatArm (fuel - 1) (secondOf z) isTail succAlt succMode slotSc) (
                      \s =>
                        let
                          body = append (firstOf p) (append (storeSlot slotSc) (append [ICmp (OpMem Rbp (nativeSlotOff slotSc)) (OpImm 0), IJcc "je" lz] (append (firstOf s) (append [IJmp lend, ILabel lz] (append (firstOf z) [ILabel lend])))))
                        in NOk (Pair body (secondOf s))
                    )
              )
      )

-- ---------------------------------------------------------------
-- 定义
-- -----------------------------------------------------------
bindArgs : List IrBinder -> FGen -> NRes (Pair (List Instr) FGen)
bindArgs bs st = bindArgsGo bs 0 st

slotsOfBinders : List IrBinder -> List (Pair IrBinder Int) -> List Int
slotsOfBinders [] _ = []
slotsOfBinders (b :: rest) slots =
  case lookupBinder b slots of
    Just slot => slot :: slotsOfBinders rest slots
    Nothing => slotsOfBinders rest slots

-- | 绑定形参：前 6 个来自参数寄存器，其余来自调用方压栈（`[rbp+16]` 起）。
bindArgsGo : List IrBinder -> Int -> FGen -> NRes (Pair (List Instr) FGen)
bindArgsGo [] _ st = NOk (Pair [] st)
bindArgsGo (b :: rest) i st =
  let
    src =
      case argRegAt i of
        Just reg => [IMov (OpReg Rax) (OpReg reg)]
        Nothing => [IMov (OpReg Rax) (OpMem Rbp (nativeStackArgOff i))]
    slotP = freshSlot st
    slot = firstOf slotP
    st1 = secondOf slotP
    store = append src [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]
  in nbind
    (bindArgsGo rest (i + 1) (pushBinderCls b slot (binderCls st Nothing b) st1))
    (\q => NOk (Pair (append store (firstOf q)) (secondOf q)))

-- | 生成一个定义；返回函数与该定义之后**模块内** label/slot 计数（`.L` 是文件局部
--   符号，计数按模块保存；重编号不会跨模块扩散）。
genDefFunc : List IrDef -> List (Pair String (List (Pair String String))) -> List IrTyDecl -> Int -> IrDef -> NRes (Pair (List NativeFunc) (Pair Int (List NativeClosure)))
genDefFunc _defs _pools _fams _nextLabel (IrExternDef name _ _ _) =
  unsupported "native target: extern definition `${name}` is not supported yet"
genDefFunc defs pools fams nextLabel (IrDef name arity _ _ body _ _ _) =
  let
    -- 本函数来参区：零参定义没有调用者压的栈实参，其余按标准 ABI 推算。
    room = nativeTailRoomBytes (nativeStackArgCount arity nativeMaxArgs)
    modPath = modulePathOf name
    pool = modulePoolOf (moduleKeyOf name) pools
    st0 = FGen defs pool [] [] fams 0 nextLabel [] room modPath name "" "" [] [] []
  in if arity == 0 then
    nbind (genExpr (nativeFuelOfBody body) st0 body) (
        \p =>
          let
            st1 = secondOf p
            frame = nativeFrameBytes st1.fgNextSlot
            instrs = append (peephole (firstOf p)) nativeEpilogue
            mainF = NativeFunc (nativeFuncLabel name) frame (append (nativePrologue frame) instrs) modPath
          in NOk (Pair (append st1.fgLams [mainF]) (Pair st1.fgNextLabel st1.fgStatics))
      )
  else
    case body of
      IrLam bs _ inner =>
        let
          rbs = runtimeBinders bs
        in if length rbs /= arity then
          internal "function body lambda arity mismatch: ${name}"
        else
          nbind (bindArgs rbs st0) (
              \bp =>
                let
                  stB = secondOf bp
                  loopP = freshLabel stB
                  loopLabel = firstOf loopP
                  stLoop = { (secondOf loopP) | fgSelfLabel = nativeFuncLabel name, fgSelfLoop = loopLabel, fgSelfParams = slotsOfBinders rbs stB.fgSlots }
                in nbind (genExpr (nativeFuelOfBody inner) stLoop inner) (
                    \q =>
                      let
                        st1 = secondOf q
                        frame = nativeFrameBytes st1.fgNextSlot
                        body0 = append (firstOf bp) (append [ILabel loopLabel] (firstOf q))
                        instrs = append (peephole body0) nativeEpilogue
                        mainF = NativeFunc (nativeFuncLabel name) frame (append (nativePrologue frame) instrs) modPath
                      in NOk (Pair (append st1.fgLams [mainF]) (Pair st1.fgNextLabel st1.fgStatics))
                  )
            )
      _ => internal "function body is not a lambda: ${name}"

-- | 每个模块的 `.L` 编号计数（`.L` 是文件局部符号，编号在模块内累加；同一模块的定义可能
--   在可达性顺序里不连续，所以计数必须按模块保存而不是靠「上一个定义」判断）。
labelCountOf : String -> List (Pair String Int) -> Int
labelCountOf _ [] = 0
labelCountOf key (p :: rest) = if firstOf p == key then secondOf p else labelCountOf key rest

putLabelCount : String -> Int -> List (Pair String Int) -> List (Pair String Int)
putLabelCount key n [] = [Pair key n]
putLabelCount key n (p :: rest) =
  if firstOf p == key then Pair key n :: rest else p :: putLabelCount key n rest

genDefs : List IrDef -> List (Pair String (List (Pair String String))) -> List IrTyDecl -> List (Pair String Int) -> List IrDef -> List (List NativeFunc) -> List NativeClosure -> NRes (Pair (List NativeFunc) (Pair Int (List NativeClosure)))
genDefs _all _pools _fams _labels [] acc statAcc =
  NOk (Pair (concatMap (\x => x) (reverse acc)) (Pair 0 statAcc))
genDefs all pools fams labels (d :: rest) acc statAcc =
  let
    key = moduleKeyOf (irDefName d)
    start = labelCountOf key labels
  in nbind (genDefFunc all pools fams start d) (
      \p =>
        let
          next = firstOf (secondOf p)
          statics = secondOf (secondOf p)
        in genDefs all pools fams (putLabelCount key next labels) rest (firstOf p :: acc) (append statics statAcc)
    )

-- | 按标签去重（函数值 wrapper 可能被多个定义分别登记；同标签体相同）。
dedupeFuncs : List NativeFunc -> List NativeFunc
dedupeFuncs [] = []
dedupeFuncs (f :: rest) =
  if hasFuncLabel (nativeFuncLabelOf f) rest then dedupeFuncs rest else f :: dedupeFuncs rest

dedupeClosures : List NativeClosure -> List NativeClosure
dedupeClosures [] = []
dedupeClosures (c :: rest) =
  if hasNativeClosure c.ncLabel rest then dedupeClosures rest else c :: dedupeClosures rest

-- ---------------------------------------------------------------
-- 入口
-- -----------------------------------------------------------
entryShowKind : Ir -> Maybe String
entryShowKind (IrRt s) =
  case s of
    "@ir@showInt" => Just "int"
    "@ir@showNat" => Just "int"
    "@ir@showBool" => Just "bool"
    "@ir@showStr" => Just "str"
    "@ir@showFloat" => Just "float"
    _ => Nothing
entryShowKind _ = Nothing

startFunc : Bool -> String -> String -> Maybe String -> List String -> List String -> NativeFunc
startFunc printResult kind mainName runMainM handlers cafs =
  let
    -- 初始栈：`[rsp]=argc`、`[rsp+8]=argv[0]…`、`argv+8*(argc+1)=envp[0]…`。
    -- 必须在 `and rsp,-16` 之前取。
    captureArgs =
      [
        IMov (OpReg Rax) (OpMem Rsp 0),
        IMov (OpRip argcLabel) (OpReg Rax),
        IBinReg "add" Rax (OpImm 1),
        IBinReg "shl" Rax (OpImm 3),
        ILeaMem Rcx Rsp 8,
        IMov (OpRip argvLabel) (OpReg Rcx),
        IBinReg "add" Rcx (OpReg Rax),
        IMov (OpRip envpLabel) (OpReg Rcx)
      ]
    initHeap =
      [
        ILea Rax nativeHeapSegLabel,
        ILea Rdx nativeHeapLabel,
        IMov (OpReg Rcx) (OpImm 0),
        IMov (OpMem Rax 0) (OpReg Rcx),
        IMov (OpMem Rax 24) (OpReg Rcx),
        ILea Rcx nativeHeapCardsLabel,
        IMov (OpMem Rax 32) (OpReg Rcx),
        IMov (OpRip nativeSegsLabel) (OpReg Rax),
        IMov (OpRip nativeCurSegLabel) (OpReg Rax),
        IMov (OpReg Rcx) (OpReg Rdx),
        IBinReg "add" Rcx (OpImm nativeHeapBytes),
        IMov (OpMem Rax 8) (OpReg Rcx),
        IMov (OpMem Rax 16) (OpReg Rdx),
        IMov (OpRip nativeArenaEndLabel) (OpReg Rcx),
        IMov (OpRip nativeHeapPtrLabel) (OpReg Rdx),
        ICall (nativeRtLabel "seg_index_init")
      ]
    -- 运行时初始化：自带栈（默认 512 MiB 虚拟，独立于 `ulimit -s`）、内存预算 /
    -- auto 核数 / 超时（其余全部来自 env，不进 codegen）。
    initLimits =
      [
        IBinReg "and" Rsp (OpImm (0 - 16)),
        ICall (nativeRtLabel "init_stack"),
        ITest Rax Rax,
        IJcc "jz" ".Lstart_keep_stack",
        IMov (OpReg Rsp) (OpReg Rax),
        ILabel ".Lstart_keep_stack",
        ICall (nativeRtLabel "init_mem"),
        ICall (nativeRtLabel "init_gc"),
        ICall (nativeRtLabel "init_cpus"),
        ICall (nativeRtLabel "init_timeout")
      ]
    runPart =
      case runMainM of
        Just rm => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeFuncLabel rm)]
        Nothing => []
    -- 入口 handler 是普通定义：机器路径不需要「宿主直连」标记（旧的 `rt_next_host`
    -- 只服务已删除的栈拷贝运行时）。
    markHost : String -> List Instr
    markHost h = [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeFuncLabel h)]
    handlerPart = concatMap markHost handlers
    -- 零参顶层定义在入口求值一次：值写回各自的 `.bss` 槽（`IrGlobal` 引用只读槽）。
    -- 依赖顺序由 `cpsOrdered` 的 SCC 序保证（被依赖的定义在前）。
    cafInit =
      concatMap
        (\n => [ICall (nativeFuncLabel n), IMov (OpRip (nativeCafCellLabel n)) (OpReg Rax)])
        cafs
    callMain =
      append
        [IBinReg "and" Rsp (OpImm (0 - 16)), IMov (OpRip nativeStackTopLabel) (OpReg Rsp)]
        (append cafInit (append [ICall (nativeFuncLabel mainName)] (append handlerPart runPart)))
    printer =
      if printResult then
        case kind of
          "bool" => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_bool")]
          "str" => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "show_str"), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_str")]
          "float" => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeFuncLabel floatRenderName), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_str")]
          _ => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_int")]
      else
        []
    exitInstrs = [IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 0), ISyscall]
  in NativeFunc
    nativeEntryLabel
    0
    (append [IBinReg "xor" Rbp (OpReg Rbp)] (append captureArgs (append initHeap (append initLimits (append callMain (append printer exitInstrs))))))
    (modulePathOf mainName)

-- ---------------------------------------------------------------
-- List 桥接：strUnpack / strPack / strConcatMany / strSubstTemplate
-- ---------------------------------------------------------------
-- 复用变体对象表示：`[tag]` + 8 字节字段，按该族最大 arity 补齐。
-- List 的 `head` 是**未装箱**的 Int（native 的 63-bit 立即数）。
record NListDesc where
  nlNilTag : Int
  nlConsTag : Int
  nlConsFields : Int
  nlMaxArity : Int

nlistDescOf : Maybe IrListFam -> List IrTyDecl -> Maybe NListDesc
nlistDescOf Nothing _ = Nothing
nlistDescOf (Just lf) fams =
  case declOf (irListFamilyOf lf) fams of
    Just (IrVariantDecl _ _ ctors) =>
      case ctorTagIn ctors (irListNilOf lf) of
        Nothing => Nothing
        Just nilTag =>
          case ctorTagIn ctors (irListConsOf lf) of
            Nothing => Nothing
            Just consTag =>
              case ctorArityIn ctors (irListConsOf lf) of
                Nothing => Nothing
                Just consN => Just (NListDesc nilTag consTag consN (maxArityIn ctors))
    _ => Nothing

-- | 一个桥接运行时函数：固定 prologue/epilogue（结果在 rax，体内不写 `ret`）。
-- | 同 `bridgeFn`，但把体内 `IRet` 改写成跳到尾部（单出口，与 `Native.Runtime.rtFunc` 同语义）。
bridgeFnExits : String -> Int -> List Instr -> NativeFunc
bridgeFnExits name slots body =
  let
    endLabel = "${nativeRtLabel name}_end"
  in bridgeFn name slots (append (mapRetToLocal endLabel body) [ILabel endLabel])

mapRetToLocal : String -> List Instr -> List Instr
mapRetToLocal label [] = []
mapRetToLocal label (IRet :: rest) = IJmp label :: mapRetToLocal label rest
mapRetToLocal label (i :: rest) = i :: mapRetToLocal label rest

bridgeFn : String -> Int -> List Instr -> NativeFunc
bridgeFn name slots body =
  let
    frame = nativeFrameBytes slots
  in NativeFunc
    (nativeRtLabel name)
    frame
    (append (nativePrologue frame) (append body nativeEpilogue))
    nativeRuntimeModule

nlistCellBytes : NListDesc -> Int
nlistCellBytes d = 8 * (1 + d.nlMaxArity)

-- | `getArgs`：`argv[1..argc-1]` -> `List String`（从后往前构造 cons；不含 argv[0]）。
getArgsFn : NListDesc -> NativeFunc
getArgsFn d =
  let
    cell = nlistCellBytes d
    acc = nativeSlotOff 0
    idx = nativeSlotOff 1
    s = nativeSlotOff 2
  in bridgeFnExits
    "getArgs"
    3
    [IMov (OpReg Rdi) (OpImm cell), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp acc) (OpReg Rax), IMov (OpMem Rax 0) (OpImm d.nlNilTag), IMov (OpReg Rax) (OpRip argcLabel), IBinReg "sub" Rax (OpImm 1), IMov (OpMem Rbp idx) (OpReg Rax), ILabel ".Lrt_getargs_loop", IMov (OpReg Rcx) (OpMem Rbp idx), ICmp (OpReg Rcx) (OpImm 1), IJcc "jl" ".Lrt_getargs_done", IMov (OpReg Rdx) (OpRip argvLabel), IMov (OpReg Rax) (OpReg Rcx), IBinReg "shl" Rax (OpImm 3), IBinReg "add" Rax (OpReg Rdx), IMov (OpReg Rdi) (OpMem Rax 0), ICall (nativeRtLabel "str_from_c"), IMov (OpMem Rbp s) (OpReg Rax), IMov (OpReg Rdi) (OpImm cell), ICall (nativeRtLabel "alloc"), IMov (OpMem Rax 0) (OpImm d.nlConsTag), IMov (OpReg Rcx) (OpMem Rbp s), IMov (OpMem Rax 8) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp acc), IMov (OpMem Rax 16) (OpReg Rcx), IMov (OpMem Rbp acc) (OpReg Rax), IMov (OpReg Rcx) (OpMem Rbp idx), IBinReg "sub" Rcx (OpImm 1), IMov (OpMem Rbp idx) (OpReg Rcx), IJmp ".Lrt_getargs_loop", ILabel ".Lrt_getargs_done", IMov (OpReg Rax) (OpMem Rbp acc)]

-- | 插入排序的一个节点：`rdi` = 已排序表头（nil 是 nil 单元）、`rsi` = 待插入单元
--   （tail 已指向 nil 单元）-> rax = 新表头。改接的是已有单元，写屏障登记被改的容器
