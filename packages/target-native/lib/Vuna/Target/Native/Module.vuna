-- | 程序声明 canonical `List` 族时生成四个桥接函数（+ 内部 `strArgAt`）。
nativeBridgeFuncs : Maybe IrListFam -> List IrTyDecl -> List NativeFunc
nativeBridgeFuncs lfM fams =
  case nlistDescOf lfM fams of
    Nothing => []
    Just d =>
      [
        strUnpackFn d,
        strPackFn d,
        getArgsFn d,
        buildCmdFn d,
        tryRunInFn d,
        spawnSelfFn d,
        sortListFn d,
        insertSortedFn d,
        tryReadDirFn d,
        strConcatManyFn d,
        strArgAtFn,
        strSubstTemplateFn d,
        arrayFromListFn d,
        arrayToListFn d
      ]

-- ---------------------------------------------------------------
-- 装配
-- -----------------------------------------------------------
export build : IrProgram -> Bool -> NativeOutcome
build program printResult =
  let
    unit = irProgUnitOf program
    defs = concatMap irGroupDefs unit.irUnitGroups
  in case unit.irUnitEntry of
    Nothing => NativeRejected (NativeUnsupported "native target: no main definition")
    Just e =>
      let
        mainName = irEntryMainOf e
        runMainM = if irEntryIsActionOf e then irEntryRunMainOf e else Nothing
      in case findDef mainName defs of
        Nothing => NativeRejected (NativeUnsupported "native target: main definition not found")
        Just mainDef =>
          if irDefArity mainDef /= 0 then
            NativeRejected (NativeUnsupported "native target: main must be a zero-argument value")
          else
            let
              kindM = if printResult then entryShowKind (irEntryShowOf e) else Just "none"
            in case kindM of
              Nothing => NativeRejected (NativeUnsupported "native target: custom Show entry is not supported yet")
              Just kind =>
                let
                  -- 机器循环只在 lowering 产出 `@ir@m@run` 时才需要：CPS 把它改写成
                  -- `machineRun`，而那条依赖是 CPS 之后才补的（可达性在 CPS 之前算）。
                  -- 纯程序（无 handler / 无效应）不注入，也就不再整份带进产物。
                  baseSeeds =
                    case runMainM of
                      Just rm => append [mainName, rm] (irEntryHandlersOf e)
                      Nothing => append [mainName] (irEntryHandlersOf e)
                  seeds0 = if kind == "float" then floatRenderName :: baseSeeds else baseSeeds
                  reach0 = reachableDefs seeds0 defs
                  seeds = if usesMachineLoop reach0 then "Base.Effect.Core.machineRun" :: seeds0 else seeds0
                  ordered = if usesMachineLoop reach0 then reachableDefs seeds defs else reach0
                in case cpsDefsMachine ordered of
                  Err msg => NativeRejected (NativeUnsupported msg)
                  Ok cpsOrdered =>
                    let
                      pools = modulePools cpsOrdered
                    in case genDefs cpsOrdered pools unit.irUnitTyDecls [] cpsOrdered [] [] of
                      NFail err => NativeRejected (nativeAuditEnrich err cpsOrdered)
                      NOk pair =>
                        let
                          start = startFunc printResult kind mainName runMainM (irEntryHandlersOf e) (cafNamesOf mainName cpsOrdered)
                          moduleLits = map (\p => Pair (split "." (firstOf p)) (poolItems (secondOf p))) pools
                          statics = dedupeClosures (secondOf (secondOf pair))
                        in NativeOk (NativeProgram nativeRodata (append nativeBss (cafBssOf cpsOrdered)) statics (dedupeFuncs (append (nativeBridgeFuncs (irProgSharedOf program).irSharedListFam unit.irUnitTyDecls) (append nativeRtFuncs (append (firstOf pair) [start])))) moduleLits)
