-- | 程序声明 canonical `List` 族时生成四个桥接函数（+ 内部 `strArgAt`）。
nativeBridgeFuncs : Maybe IrListFam -> List IrTyDecl -> List NativeFunc
nativeBridgeFuncs lfM fams =
  case nlistDescOf lfM fams of
    Nothing => []
    Just d =>
      [
        strUnpackFn d,
        strPackFn d,
        getArgsFn d,
        buildCmdFn d,
        tryRunInFn d,
        spawnSelfFn d,
        sortListFn d,
        insertSortedFn d,
        tryReadDirFn d,
        strConcatManyFn d,
        strArgAtFn,
        strSubstTemplateFn d,
        arrayFromListFn d,
        arrayToListFn d
      ]

-- ---------------------------------------------------------------
-- 装配
-- -----------------------------------------------------------
export build : IrProgram -> Bool -> NativeOutcome
build program printResult =
  let
    unit = irProgUnitOf program
    defs = concatMap irGroupDefs unit.irUnitGroups
  in case unit.irUnitEntry of
    Nothing => NativeRejected (NativeUnsupported "native target: no main definition")
    Just e =>
      let
        mainName = irEntryMainOf e
        runMainM = if irEntryIsActionOf e then irEntryRunMainOf e else Nothing
      in case findDef mainName defs of
        Nothing => NativeRejected (NativeUnsupported "native target: main definition not found")
        Just mainDef =>
          if irDefArity mainDef /= 0 then
            NativeRejected (NativeUnsupported "native target: main must be a zero-argument value")
          else
            let
              kindM = if printResult then entryShowKind (irEntryShowOf e) else Just "none"
            in case kindM of
              Nothing => NativeRejected (NativeUnsupported "native target: custom Show entry is not supported yet")
              Just kind =>
                let
                  -- 机器循环只在 lowering 产出 `@ir@m@run` 时才需要：CPS 把它改写成
                  -- `machineRun`，而那条依赖是 CPS 之后才补的（可达性在 CPS 之前算）。
                  -- 纯程序（无 handler / 无效应）不注入，也就不再整份带进产物。
                  baseSeeds =
                    case runMainM of
                      Just rm => append [mainName, rm] (irEntryHandlersOf e)
                      Nothing => append [mainName] (irEntryHandlersOf e)
                  seeds0 = if kind == "float" then floatRenderName :: baseSeeds else baseSeeds
                  reach0 = reachableDefs seeds0 defs
                  seeds = if usesMachineLoop reach0 then "Base.Effect.Core.machineRun" :: seeds0 else seeds0
                  ordered = if usesMachineLoop reach0 then reachableDefs seeds defs else reach0
                in case cpsDefsMachine ordered of
                  Err msg => NativeRejected (NativeUnsupported msg)
                  Ok cps0 =>
                    let
                      -- 高阶参数特化：已知的闭合函数实参把被调定义的形参替换成直调，
                      -- 克隆按（被调名、形参序号、实参指纹）去重。
                      cpsSpecialized = Specialize.specializeDefs cps0
                      recNames = Specialize.recursiveNamesWithClones (recursiveDefNames unit) cpsSpecialized
                      -- 小函数内联：体够小、非递归、实参平凡的调用点直接代进去。
                      inlined = Inline.inlineDefs recNames cpsSpecialized
                      -- 尾位置内联：把互递归 SCC 沿定义序单向展开成自递归。
                      tailInlined = Inline.inlineTailDefs recNames (firstOf inlined)
                      cps1 = Inline.simplifyDefs (firstOf tailInlined)
                      changed = secondOf inlined || secondOf tailInlined
                      -- 内联后会留下一批没人引用的定义：按「体里真正出现的 `IrGlobal`」重算
                      -- 可达性再丢掉（不跟 `irDefDeps`：那是源码级 term-use 依赖，含已擦除
                      -- 的引用，会把刚内联掉的被调重新钉住）。
                      cpsOrdered = if changed then reachableDefsByRefs (\_ => False) 0 seeds cps1 else cps1
                      -- 零参别名（`Nat.plus = natAdd`）在应用位置展开成 `IrRtApp`，
                      -- 让标量树与调用点内联看到运行时叶子。
                      cpsAliased = map (resolveDefAliases cpsOrdered) cpsOrdered
                      -- Float `let` 代进唯一使用点，让浮点表达式树跨过绑定、只装盒一次。
                      cpsFloatLets = Inline.inlineFloatLetsDefs cpsAliased
                      pools = modulePools cpsOrdered
                      fpools = moduleFloatPools cpsOrdered
                      allocs = allocatingDefNames cpsAliased
                    in case genDefs cpsFloatLets pools fpools recNames allocs unit.irUnitTyDecls [] cpsFloatLets [] [] of
                      NFail err => NativeRejected (nativeAuditEnrich err cpsOrdered)
                      NOk pair =>
                        let
                          progFuncs = firstOf pair
                          statics = dedupeClosures (secondOf (secondOf pair))
                          bridgeFuncs = nativeBridgeFuncs (irProgSharedOf program).irSharedListFam unit.irUnitTyDecls
                          baseFuncs = dedupeFuncs (append bridgeFuncs (append nativeRtFuncs progFuncs))
                          -- 入口打印用到的运行时函数（float 的 render 是程序定义，已在 progFuncs 里）。
                          printerSeeds =
                            case kind of
                              "bool" => ["rt_print_bool"]
                              "str" => ["rt_show_str", "rt_print_str"]
                              "float" => ["rt_print_str"]
                              _ => ["rt_print_int"]
                          renderSeeds = append (map nativeFuncLabelOf progFuncs) printerSeeds
                          needs = initNeeds baseFuncs (reachFuncLabels baseFuncs renderSeeds)
                          start = startFunc printResult kind mainName runMainM (irEntryHandlersOf e) (cafNamesOf mainName cpsOrdered) needs
                          -- 产物只保留 `_start` 与程序代码可达的运行时函数：未用的
                          -- init_* / env 解析 / 文件 / spawn 等不再进二进制。
                          liveFinal = reachFuncLabels baseFuncs (append renderSeeds (funcLabelRefs start))
                          keptFuncs = filter (\f => memName (nativeFuncLabelOf f) liveFinal) baseFuncs
                          moduleLits = map (\p => (split "." (firstOf p), poolItems (secondOf p))) pools
                          moduleFloats = map (\p => (split "." (firstOf p), floatPoolItems (secondOf p))) fpools
                        in NativeOk (NativeProgram nativeRodata (append nativeBss (cafBssOf cpsOrdered)) statics (append keptFuncs [start]) moduleLits moduleFloats)
