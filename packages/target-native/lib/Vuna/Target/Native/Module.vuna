    i = nativeSlotOff 5
    j = nativeSlotOff 6
    k = nativeSlotOff 7
    out = nativeSlotOff 8
    oidx = nativeSlotOff 9
    arg = nativeSlotOff 10
    len = nativeSlotOff 11
