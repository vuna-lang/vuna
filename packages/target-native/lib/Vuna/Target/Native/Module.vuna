module Vuna.Target.Native.Module where

-- Vuna.Target.Native.Module：IrProgram -> NativeProgram（x86-64 汇编）。
--
-- 覆盖 Int/Nat/Bool 纯值与 `String`（字面量、`++`、`strFromInt`、`strLength`、
-- `strAt`、`strHash`、`strShow`、`strSubstring`、`bi_eq_str` / `bi_neq_str`、`IrConcatMany`、
-- String 入口）。字符串是**指向长度头的指针**，由运行时从 bump 堆分配。
-- 用户 `data`（变体对象 `[0]`=tag + 8 字节字段）、record（纯字段对象）、
-- 通用 `IrCase`（tag 线性分派）、`IrProj` / `IrRecUpd`。
--
-- 生成策略（见 docs/reference/native.md）：
--   * 从 entry main 沿 `irDefDeps` 收集可达定义，只生成可达函数；不可达的 base
--     定义不检查（与 wasm 的 `collectNeeded` 同策略）；
--   * 不做寄存器分配：binder 与中间值都走 `[rbp - 8*(slot+1)]`；
--   * 调用约定在 `Native.Abi`；运行时符号在 `Native.Runtime`；
--   * 每个模块一个汇编文件（`runtime.s` + 模块路径目录）；字符串字面量按模块池
--     内容去重进该文件的 `.rodata`（首现顺序编号），`IrStr` 求值成 `lea`；
--   * 内部 label（`.L<n>`）是文件局部符号，编号在模块内跨定义累加；
--   * 生成器带 fuel，越界报 `NativeInternal`，不 panic。
--
-- 边界：只 import Base、`Vuna.Ir` 与 `Native.*`。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Ir.Model
import Vuna.Ir.Kinds as Kinds
import Vuna.Ir.Cps
import Vuna.Ir.Analysis
import Vuna.Ir.Runtime
import Vuna.Ir.Tail
import Vuna.Ir.Synthetic as Synthetic
import Vuna.Ir.Layout as Layout
import Vuna.Ir.Alias as Alias
import Vuna.Ir.FloatLit
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Audit
import Vuna.Target.Native.Dirty
import Vuna.Target.Native.Model
import Vuna.Target.Native.Live
import Vuna.Target.Native.Range
import Vuna.Target.Native.Regs
import Vuna.Target.Native.Repr
import Vuna.Target.Native.Runtime
import Vuna.Target.Native.Select
import Vuna.Target.Native.Specialize
import Vuna.Target.Native.Inline

-- ---------------------------------------------------------------
-- 结果类型：区分「目标不支持」与「生成器不变式破坏」
-- -----------------------------------------------------------
export data NRes a(..) : Type where
  NOk : a -> NRes a
  NFail : NativeErr -> NRes a

-- | 零参别名的解析目标：运行时叶子，或另一个（有 arity 的）顶级定义。
data AliasTarget : Type where
  AliasRt : String -> AliasTarget
  AliasGlobal : String -> AliasTarget

-- | 调用点静态已知的被调用者。`KDirect` 走标准 ABI 直调（不需要闭包值）；
--   `KClosure` 只知道闭包 arity，调用点仍从槽里取闭包，但可以跳过运行时 arity 检查
--   与 `rt_apply` 回退。
export data KnownCallee(..) : Type where
  KDirect : String -> Int -> KnownCallee
  KClosure : Int -> KnownCallee

export calleeArity : KnownCallee -> Int
calleeArity (KDirect _ n) = n
calleeArity (KClosure n) = n

nbind : NRes a -> (a -> NRes b) -> NRes b
nbind (NOk x) k = k x
nbind (NFail e) _ = NFail e

unsupported : String -> NRes a
unsupported msg = NFail (NativeUnsupported msg)

internal : String -> NRes a
internal msg = NFail (NativeInternal msg)

-- ---------------------------------------------------------------
-- 模块归属
-- -----------------------------------------------------------
-- | 定义的全限定名 -> 模块路径。无模块头的定义（ad-hoc 文件）归入入口模块 `Main`。
modulePathOf : String -> List String
modulePathOf name =
  let
    parts = split "." name
  in case dropLast parts of
    [] => ["Main"]
    ms => ms

dropLast : List a -> List a
dropLast [] = []
dropLast [_] = []
dropLast (x :: rest) = x :: dropLast rest

-- ---------------------------------------------------------------
-- 生成状态与栈槽
-- -----------------------------------------------------------
record FGen where
  fgDefs : List IrDef
  fgPool : List (String, String)
  -- | 本模块的浮点字面量池（原文 → `.Lflt_<n>`）；与 `fgPool` 同一切分口径。
  fgFloats : List (String, String)
  fgSlots : List (IrBinder, Int)
  -- | 槽序号 → 运行时 kind（捕获槽继承父帧的 kind；GC 不用它）。
  --   槽不复用，所以这张表只增不减。
  fgSlotCls : List (Int, NCls)
  fgFams : List IrTyDecl
  fgNextSlot : Int
  fgNextLabel : Int
  -- | 本次生成中遇到的闭包函数（每个 `IrLam` 值一个），最后并入 `npFuncs`。
  fgLams : List NativeFunc
  -- | 本函数**来参区**可复用的字节数（调用方压的栈实参 + 对齐洞）。
  --   尾调用把新实参写回 `[rbp+16...]`，超过这段就会踩调用者的帧，只能回退普通调用。
  fgTailRoom : Int
  -- | 当前生成所属的模块路径（闭包函数继承它）。
  fgModule : List String
  -- | 当前定义的全限定名（闭包标签由它派生，跨定义稳定）。
  fgOwner : String
  -- | 当前函数的标签；自递归尾调用只在它非空时启用。
  fgSelfLabel : String
  -- | 自递归尾调用的回边标签；空串表示当前函数没有循环头。
  fgSelfLoop : String
  -- | 自递归尾调用要写回的形参槽（按参数顺序）。
  fgSelfParams : List Int
  -- | 形参 binder（与 `fgSelfParams` 同序）：判断实参求值是否还会读某个形参槽。
  fgSelfBinds : List IrBinder
  -- | binder id -> 已知的整数区间（分支守卫推导；只在被该守卫支配的子树里有效）。
  fgRanges : List (Int, Int, Int)
  -- | 本次生成收集到的静态闭包对象（无捕获的函数值）。
  fgStatics : List NativeClosure
  -- | binder id -> 调用点静态已知的被调用者（见 `KnownCallee`）。binder 身份在
  --   整个 lowering 产物里唯一，所以表只增不减；跨闭包边界时按捕获集合筛一遍。
  fgKnown : List (Int, KnownCallee)
  -- | 当前定义在递归 SCC 里（非尾递归的帧会被层层压着，死槽清零才值得付产物成本）。
  fgReenter : Bool
  -- | 允许携带未归一化 63-bit 值的循环参数槽（`Native.Dirty` 的结论）。
  fgDirtySlots : List Int
  -- | 拆箱形参的 binder id：这些槽里存的是 raw `f64` 位模式（不是堆上的 leaf 指针）。
  --   读点要么直接 `movsd` 进 xmm（浮点运算），要么先装盒再当指针用（逃逸点）。
  fgFloatBinds : List Int
  -- | 正在求值的 self 尾调用实参是否允许保留未归一化值（只对 dirty 目标置位）。
  fgAllowDirty : Bool

freshSlot : FGen -> (Int, FGen)
freshSlot st =
  let
    slot = st.fgNextSlot
    st1 = { st | fgNextSlot = st.fgNextSlot + 1 }
  in (slot, st1)

freshSlotCls : NCls -> FGen -> (Int, FGen)
freshSlotCls cls st =
  let
    p = freshSlot st
  in (firstOf p, setSlotCls (firstOf p) cls (secondOf p))

freshLabel : FGen -> (String, FGen)
freshLabel st =
  let
    label = nativeJumpLabel st.fgNextLabel
    st1 = { st | fgNextLabel = st.fgNextLabel + 1 }
  in (label, st1)

storeSlot : Int -> List Instr
storeSlot slot = [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]

loadSlot : Int -> List Instr
loadSlot slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot))]

loadReg : Reg -> Int -> List Instr
loadReg r slot = [IMov (OpReg r) (OpMem Rbp (nativeSlotOff slot))]

-- ---------------------------------------------------------------
-- binder
-- -----------------------------------------------------------
binderEq : IrBinder -> IrBinder -> Bool
binderEq a b = sameBinderId a b

lookupBinder : IrBinder -> List (IrBinder, Int) -> Maybe Int
lookupBinder _ [] = Nothing
lookupBinder b (p :: rest) =
  if binderEq b (firstOf p) then Just (secondOf p) else lookupBinder b rest

pushBinder : IrBinder -> Int -> FGen -> FGen
pushBinder b slot st = { st | fgSlots = (b, slot) :: st.fgSlots }

-- ---------------------------------------------------------------
-- 槽 kind（GC 栈图的输入）
-- ---------------------------------------------------------------
-- | 登记槽的 kind。kind 来自 `Native.Repr`：binder 的声明类型优先，缺类型时只信
--   绑定点的值（字面量 / 已绑定 binder / 结果类型已知的符号），推不出来就记
--   `NClsMissing`——按「可能是指针」处理，照样进栈图。
setSlotCls : Int -> NCls -> FGen -> FGen
setSlotCls slot cls st = { st | fgSlotCls = (slot, cls) :: st.fgSlotCls }

pushBinderCls : IrBinder -> Int -> NCls -> FGen -> FGen
pushBinderCls b slot cls st = setSlotCls slot cls (pushBinder b slot st)

slotClsAt : Int -> List (Int, NCls) -> NCls
slotClsAt _ [] = NClsMissing
slotClsAt slot (p :: rest) = if firstOf p == slot then secondOf p else slotClsAt slot rest

isScalarCls : NCls -> Bool
isScalarCls NClsScalar = True
isScalarCls _ = False

-- | 绑定点声明的类型是 `Float`（拆箱候选）。
isFloatTy : FGen -> Maybe IrTy -> Bool
isFloatTy st mty =
  case Kinds.irKindOfTy st.fgFams mty of
    Kinds.KFloat => True
    _ => False

-- | binder 是拆箱形参：它所在的槽存 raw `f64` 位，读它当指针用之前必须先装盒。
isFloatBindBinder : FGen -> IrBinder -> Bool
isFloatBindBinder st b = memInt (binderIdOf b) st.fgFloatBinds

-- | 形参 binder 声明为 `Float`（拆箱候选）。
isFloatParamBinder : FGen -> IrBinder -> Bool
isFloatParamBinder st b = isFloatTy st b.irBinderTy

clsOfTy : FGen -> Maybe IrTy -> NCls
clsOfTy st mty = nKindOfTy st.fgFams mty

-- | binder 的 kind：声明类型优先，`Nothing` 时用绑定点的推断值。
binderCls : FGen -> Maybe NCls -> IrBinder -> NCls
binderCls st fallback b =
  case nKindOfTy st.fgFams b.irBinderTy of
    NClsMissing =>
      case fallback of
        Just cls => cls
        Nothing => NClsMissing
    cls => cls

-- | 值位置的 kind。`IrCast` 只在源/目标都是标量时按标量算（native 把 cast 渲染成
--   恒等，两边 kind 不一致时不能信任何一边）。
valueCls : FGen -> Ir -> NCls
valueCls st (IrVar b) = binderCls st Nothing b
valueCls st (IrCast from to _) =
  if isScalarCls (clsOfTy st from) && isScalarCls (clsOfTy st to) then NClsScalar else NClsMissing
valueCls st ir =
  case nValueCls st.fgFams st.fgDefs [] ir of
    Just cls => cls
    Nothing => NClsMissing

isErasedBinder : IrBinder -> Bool
isErasedBinder b = b.irBinderErased

-- | 结束一个 binder 作用域：只恢复 binder 表；slot/label 计数器不回退（槽不复用）。
restoreBinderScope : FGen -> List (IrBinder, Int) -> FGen
restoreBinderScope st slots = { st | fgSlots = slots }

runtimeBinders : List IrBinder -> List IrBinder
runtimeBinders bs = filter (\b => not (isErasedBinder b)) bs

-- ---------------------------------------------------------------
-- 定义查找 / 可达性
-- -----------------------------------------------------------
findDef : String -> List IrDef -> Maybe IrDef
findDef _ [] = Nothing
findDef name (d :: rest) = if irDefName d == name then Just d else findDef name rest

memStr : String -> List String -> Bool
memStr _ [] = False
memStr s (x :: rest) = s == x || memStr s rest

memInt : Int -> List Int -> Bool
memInt _ [] = False
memInt x (y :: rest) = x == y || memInt x rest

binderIdOf : IrBinder -> Int
binderIdOf b = b.irBinderId

-- ---------------------------------------------------------------
-- 字符串字面量池
-- -----------------------------------------------------------
addLit : List (String, String) -> (Int -> String) -> String -> List (String, String)
addLit pool labelOf s =
  if memStr s (map (\p => firstOf p) pool) then pool else append pool [(s, labelOf (length pool))]

poolOfDefs : List IrDef -> List (String, String)
poolOfDefs defs =
  foldl (\pool, s => addLit pool nativeStrLitLabel s) [] (concatMap irStringsOfDef defs)

-- | 模块 key（用 `.` 连接路径段；`modulePathOf` 的逆）。
moduleKeyOf : String -> String
moduleKeyOf name = join "." (modulePathOf name)

-- | 每个模块一份字面量池（模块按首现顺序；池内首现顺序固定）。`.Llit_<n>` / `.Lflt_<n>`
--   是文件局部标签，所以字面量池按模块切分，新增字面量不会重编号其它模块。
modulePools : List IrDef -> List (String, List (String, String))
modulePools defs = modulePoolsOf irStringsOfDef nativeStrLitLabel defs

moduleFloatPools : List IrDef -> List (String, List (String, String))
moduleFloatPools defs = modulePoolsOf irFloatLitsOfDef nativeFloatLitLabel defs

modulePoolsOf : (IrDef -> List String) -> (Int -> String) -> List IrDef -> List (String, List (String, String))
modulePoolsOf litsOf labelOf defs = foldl (addDefToPools litsOf labelOf) [] defs

addDefToPools : (IrDef -> List String) -> (Int -> String) -> List (String, List (String, String)) -> IrDef -> List (String, List (String, String))
addDefToPools litsOf labelOf pools d =
  let
    k = moduleKeyOf (irDefName d)
    pool = foldl (\p0, s => addLit p0 labelOf s) (modulePoolOf k pools) (litsOf d)
  in putPool k pool pools

putPool : String -> List (String, String) -> List (String, List (String, String)) -> List (String, List (String, String))
putPool key pool [] = [(key, pool)]
putPool key pool (p :: rest) =
  if firstOf p == key then (key, pool) :: rest else p :: putPool key pool rest

modulePoolOf : String -> List (String, List (String, String)) -> List (String, String)
modulePoolOf _ [] = []
modulePoolOf key (p :: rest) = if firstOf p == key then secondOf p else modulePoolOf key rest

poolLabelOf : String -> List (String, String) -> Maybe String
poolLabelOf _ [] = Nothing
poolLabelOf s (p :: rest) = if firstOf p == s then Just (secondOf p) else poolLabelOf s rest

poolItems : List (String, String) -> List NativeStrLit
poolItems [] = []
poolItems ((text, label) :: rest) = NativeStrLit label text :: poolItems rest

floatPoolItems : List (String, String) -> List NativeFloatLit
floatPoolItems [] = []
floatPoolItems ((raw, label) :: rest) =
  NativeFloatLit label (irFloatLitText raw) :: floatPoolItems rest

-- ---------------------------------------------------------------
-- 参数
-- -----------------------------------------------------------
loadArgRegs : List Reg -> List Int -> List Instr
loadArgRegs [] _ = []
loadArgRegs _ [] = []
loadArgRegs (r :: rs) (s :: ss) = append (loadReg r s) (loadArgRegs rs ss)

argRegAt : Int -> Maybe Reg
argRegAt i = argRegAtIn i nativeArgRegs

argRegAtIn : Int -> List Reg -> Maybe Reg
argRegAtIn _ [] = Nothing
argRegAtIn i (r :: rest) = if i == 0 then Just r else argRegAtIn (i - 1) rest

-- ---------------------------------------------------------------
-- 表达式
-- -----------------------------------------------------------
-- | 调用 / 构造 / 记录字段的实参：值会离开当前函数的 dirty 链——被调方与堆字段都按
--   归一化值工作——所以这里一律清掉 `fgAllowDirty`，按值 wrap。
genArgs : Int -> FGen -> List Ir -> NRes (List Instr, List Int, FGen)
genArgs _ st [] = NOk ([], [], st)
genArgs fuel st (a :: rest) =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    let
      st0 = { st | fgAllowDirty = False }
    in nbind (genExpr (fuel - 1) st0 a) (
        \p =>
          let
            st1 = secondOf p
            slotP = freshSlotCls (valueCls st1 a) st1
            slot = firstOf slotP
            st2 = secondOf slotP
          in nbind (genArgs (fuel - 1) st2 rest) (
              \q =>
                let
                  qInstrs = firstOf q
                  qSlots = firstOf (secondOf q)
                  st3 = secondOf (secondOf q)
                in NOk (append (firstOf p) (append (storeSlot slot) qInstrs), slot :: qSlots, st3)
            )
      )

-- | 饱和调用：实参左→右求值到槽；前 6 个装参数寄存器，其余逆序压栈（SysV AMD64）。
--   调用前 `rsp` 必须 16 字节对齐：栈参数个数为奇数时先 `sub rsp, 8` 补空洞
--   （空洞在参数**上方**，被调用方忽略）；返回后一次性 `add rsp, 8*k + pad`。
genSaturatedCall : Int -> FGen -> String -> List Ir -> NRes (List Instr, FGen)
genSaturatedCall fuel st label args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genArgs (fuel - 1) st args) (
        \p =>
          let
            slots = firstOf (secondOf p)
            st1 = secondOf (secondOf p)
          in NOk (append (firstOf p) (callSlotsInstrs label slots), st1)
      )

-- | 尾位置的饱和直调：实参求值到槽后写回来参区、拆帧并 `jmp`（不返回）。
genTailCall : Int -> FGen -> String -> List Ir -> NRes (List Instr, FGen)
genTailCall fuel st label args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind
      (genArgs (fuel - 1) st args)
      (\p => NOk (append (firstOf p) (tailCallSlotsInstrs label (firstOf (secondOf p))), secondOf (secondOf p)))

-- | 以**已求值到槽**的实参调用：前 6 个装参数寄存器，其余逆序压栈（SysV AMD64）。
--   调用前 `rsp` 必须 16 字节对齐：栈参数个数为奇数时先 `sub rsp, 8` 补空洞
--   （空洞在参数**上方**，被调用方忽略）；返回后一次性 `add rsp, 8*k + pad`。
callSlotsInstrs : String -> List Int -> List Instr
callSlotsInstrs label slots =
  let
    regSlots = take nativeMaxArgs slots
    stackSlots = drop nativeMaxArgs slots
    k = length stackSlots
    pad = nativeStackPadBytes k
    popped = 8 * k + pad
  in append
    (pushStackArgs stackSlots)
    (append (loadArgRegs nativeArgRegs regSlots) (append [ICall label] (if popped == 0 then [] else [IBinReg "add" Rsp (OpImm popped)])))

-- | 栈参数压栈：逆序（最后一个先压），第 7 个参数最终位于 `[rbp+16]`。
--   `slots` 已按实参顺序排列（从第 7 个起）。先 `sub rsp, 8` 补对齐空洞（若需要）。
pushStackArgs : List Int -> List Instr
pushStackArgs slots =
  let
    k = length slots
    pad = if nativeStackPadBytes k == 0 then [] else [IBinReg "sub" Rsp (OpImm 8)]
    pushes = concatMap pushOne (reverse slots)
  in append pad pushes

pushOne : Int -> List Instr
pushOne slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot)), IPush Rax]

-- ---------------------------------------------------------------
-- 尾调用
-- ---------------------------------------------------------------
-- | 空间判据：把 `kOut` 个栈实参写回调用者来参区所需的字节数不超过 `fgTailRoom`。
--   不满足时回退普通调用（语义不变，只丢优化）。
tailCallFits : FGen -> Int -> Bool
tailCallFits st kOut = 8 * kOut <= st.fgTailRoom

-- | 第 `i`（从 0 起）个实参的栈槽 → 调用者来参区的第 `i-6` 个槽位。
--   源全在 `rbp` 以下、目标在 `rbp+16` 以上，两者不重叠，拷贝顺序无关。
tailStackArgMoves : Int -> Int -> List Int -> List Instr
tailStackArgMoves _ _ [] = []
tailStackArgMoves regs i (slot :: rest) =
  append
    [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot)), IMov (OpMem Rbp (16 + 8 * (i - regs))) (OpReg Rax)]
    (tailStackArgMoves regs (i + 1) rest)

-- | 尾调用：栈实参搬进来参区 → 装参数寄存器 → 拆本帧 → `jmp`。
--   `pop rbp` 之后 `rsp` 正好落在返回地址槽，与 `call` 刚进入时同构（`rsp ≡ 8 mod 16`），
--   所以尾调用自己不需要补对齐洞；返回地址仍是本函数自己的那一个。
tailCallSlotsInstrs : String -> List Int -> List Instr
tailCallSlotsInstrs label slots =
  let
    regSlots = take nativeMaxArgs slots
    stackSlots = drop nativeMaxArgs slots
  in append
    (tailStackArgMoves nativeMaxArgs nativeMaxArgs stackSlots)
    (append (loadArgRegs nativeArgRegs regSlots) [IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp, IJmp label])

-- ---------------------------------------------------------------
-- 函数值（顶层函数 / 运行时符号）
-- ---------------------------------------------------------------
nativeFuncLabelOf : NativeFunc -> String
nativeFuncLabelOf f = f.nfLabel

hasFuncLabel : String -> List NativeFunc -> Bool
hasFuncLabel label fs =
  foldl (\acc, f => if nativeFuncLabelOf f == label then True else acc) False fs

-- | 闭包 ABI（rdi=闭包、实参从 rsi 起）里第 i 个实参的装载指令。
closureArgLoad : Int -> List Instr
closureArgLoad i =
  case argRegAt (i + 1) of
    Just reg => [IMov (OpReg Rax) (OpReg reg)]
    Nothing => [IMov (OpReg Rax) (OpMem Rbp (nativeStackArgOff (i + 1)))]

-- | 函数值 wrapper：把闭包实参搬进本帧槽，再按标准 ABI 调目标函数。
--   每个（函数 / 运行时符号）只生成一次，标签由 `Native.Abi` 的命名派生。
valueWrapperFunc : List String -> String -> Int -> String -> NativeFunc
valueWrapperFunc modPath label arity target =
  if arity <= length closureArgRegs then
    NativeFunc label 0 (append (wrapperShifts arity) [IJmp target]) modPath
  else
    let
      -- 无栈帧 wrapper：闭包 ABI 的实参寄存器（`rsi..r9`）整体下移一格就是标准 ABI
      -- （`rdi..r8`）——按小到大搬，目标寄存器总是更靠前，不会踩掉后面的源。
      -- 少掉 `push rbp` + 槽往返，HOF 的每次间接调用只剩「搬实参 + `jmp`」。
      slots = range 0 arity
      loads = concatMap (\i => append (closureArgLoad i) [IMov (OpMem Rbp (nativeSlotOff i)) (OpReg Rax)]) slots
      frame = nativeFrameBytes arity
      body = append loads (tailCallSlotsInstrs target slots)
    in NativeFunc label frame (append (nativePrologueOf frame (unwrittenSlots frame body)) body) modPath

-- | 闭包 ABI → 标准 ABI 的实参搬运（`arity <= 5` 时全在寄存器里）。
wrapperShifts : Int -> List Instr
wrapperShifts arity =
  concatMap (
      \i =>
        case (argRegAt i, argRegAt (i + 1)) of
          (Just dst, Just src) => [IMov (OpReg dst) (OpReg src)]
          _ => []
    ) (range 0 arity)

nativeStaticClosureLabel : String -> Int -> String
nativeStaticClosureLabel label arity = "vuna_static_${nativeName label}_${strFromInt arity}"

hasNativeClosure : String -> List NativeClosure -> Bool
hasNativeClosure _ [] = False
hasNativeClosure label (c :: rest) =
  if c.ncLabel == label then True else hasNativeClosure label rest

-- | 零参顶层定义的 CAF 槽：每个 `IrDef` arity 0 一格，`_start` 求值一次后写入；
--   GC 按 `[rt_caf_begin, rt_caf_end)` 扫根（见 `Gc.gcCollectFn`）。
cafBssOf : List IrDef -> List NativeBss
cafBssOf defs =
  append
    [NativeBss nativeCafBeginLabel 0 8]
    (append (concatMap cafCellOf defs) [NativeBss nativeCafEndLabel 0 8])

cafCellOf : IrDef -> List NativeBss
cafCellOf d = if isCafDef d then [NativeBss (nativeCafCellLabel (irDefName d)) 8 8] else []

-- | 有体的零参定义（extern 的 `irDefArity` 也是 0，但没有可求值的体）。
isCafDef : IrDef -> Bool
isCafDef d =
  case irDefBody d of
    Just _ => irDefArity d == 0
    Nothing => False

-- | 入口要预先求值的零参定义（`main` 由入口单独调用）。
cafNamesOf : String -> List IrDef -> List String
cafNamesOf mainName defs =
  concatMap (\d => if isCafDef d && irDefName d /= mainName then [irDefName d] else []) defs

-- | 把「顶层函数 / 运行时符号」求值成闭包对象：`[code][arity]`（无捕获）。
--   无捕获闭包是只读静态对象，引用点只 `lea`，不分配堆。
genValueClosure : FGen -> List String -> String -> Int -> String -> NRes (List Instr, FGen)
genValueClosure st modPath label arity target =
  let
    staticLabel = nativeStaticClosureLabel label arity
    st1 =
      if hasFuncLabel label st.fgLams then
        st
      else
        { st | fgLams = append st.fgLams [valueWrapperFunc modPath label arity target] }
    st2 =
      if hasNativeClosure staticLabel st1.fgStatics then
        st1
      else
        { st1 | fgStatics = append st1.fgStatics [NativeClosure staticLabel label arity] }
    body = [ILea Rax staticLabel]
  in NOk (body, st2)

-- | 运行时符号作为值时的 arity：`nativeRtValueArity` 优先，其次内建饱和应用 arity。
rtValueArityOf : String -> Int
rtValueArityOf sym =
  if nativeRtValueArity sym > 0 then nativeRtValueArity sym else irInlineArity sym

-- | 饱和闭包调用（闭包 ABI：`rdi` = 闭包、实参从 `rsi` 起，第 6 个起压栈）。
closureCallSlotsInstrs : Int -> List Int -> List Instr
closureCallSlotsInstrs clo slots =
  let
    regSlots = take (length closureArgRegs) slots
    stackSlots = drop (length closureArgRegs) slots
    k = length stackSlots
    pad = nativeStackPadBytes k
    popped = 8 * k + pad
  in append
    (pushStackArgs stackSlots)
    (append (loadArgRegs closureArgRegs regSlots) (append [IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff clo)), IMov (OpReg R11) (OpMem Rdi 0)] (append [ICallReg R11] (if popped == 0 then [] else [IBinReg "add" Rsp (OpImm popped)]))))

-- | 饱和闭包尾调用：栈实参写回来参区 → 装闭包 ABI 寄存器 → 拆帧 → `jmp [clo]`。
closureTailCallSlotsInstrs : Int -> List Int -> List Instr
closureTailCallSlotsInstrs clo slots =
  let
    regSlots = take (length closureArgRegs) slots
    stackSlots = drop (length closureArgRegs) slots
  in append
    (tailStackArgMoves (length closureArgRegs) (length closureArgRegs) stackSlots)
    (append (loadArgRegs closureArgRegs regSlots) [IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff clo)), IMov (OpReg R11) (OpMem Rdi 0), IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp, IJmpReg R11])

-- | 统一应用：运行时先按闭包 arity 走**饱和直调**快路径（栈开销与闭包 ABI 引入前一致），
--   arity 不匹配才把实参按逆序压栈成升序数组交给 `rt_apply`（部分 / 过度应用）。
genApplyCall : FGen -> Bool -> Int -> List Int -> NRes (List Instr, FGen)
genApplyCall st isTail clo args =
  let
    k = length args
    idx = st.fgNextLabel
    lSlow = nativeJumpLabel idx
    lEnd = nativeJumpLabel (idx + 1)
    st1 = { st | fgNextLabel = idx + 2 }
    pad = nativeStackPadBytes k
    pushes = concatMap pushOne (reverse args)
    head = if pad == 0 then [] else [IBinReg "sub" Rsp (OpImm 8)]
    slowPart =
      append
        head
        (append pushes (append [IMov (OpReg Rdx) (OpReg Rsp), IMov (OpReg Rsi) (OpImm k), IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff clo))] [ICall (nativeRtLabel "apply"), IBinReg "add" Rsp (OpImm (8 * k + pad))]))
    tailFits = isTail && tailCallFits st (nativeStackArgCount k (length closureArgRegs))
    fastPart =
      append
        [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff clo)), IMov (OpReg Rax) (OpMem Rax 8), ICmp (OpReg Rax) (OpImm k), IJcc "jne" lSlow]
        (if tailFits then closureTailCallSlotsInstrs clo args else append (closureCallSlotsInstrs clo args) [IJmp lEnd])
  in NOk (append fastPart (append [ILabel lSlow] (append slowPart [ILabel lEnd])), st1)

-- | 求值 head + 实参后统一应用（部分 / 过度 / 运行时闭包都走这里）。
genApplyHead : Int -> FGen -> Bool -> Ir -> List Ir -> NRes (List Instr, FGen)
genApplyHead fuel st isTail head args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genExpr (fuel - 1) st head) (
        \p =>
          let
            cloP = freshSlot (secondOf p)
            clo = firstOf cloP
            st1 = secondOf cloP
          in nbind (genArgs (fuel - 1) st1 args) (\q => nbind (genApplyCall (secondOf (secondOf q)) isTail clo (firstOf (secondOf q))) (\r => NOk (cat [firstOf p, storeSlot clo, firstOf q, firstOf r], secondOf r)))
      )

-- | 自递归尾调用：实参已求值到 fresh slots，逐项写回形参槽后回到循环头。
selfSlotMoves : List Int -> List Int -> List Instr
selfSlotMoves [] _ = []
selfSlotMoves _ [] = []
selfSlotMoves (src :: ss) (dst :: ds) =
  append
    [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff src)), IMov (OpMem Rbp (nativeSlotOff dst)) (OpReg Rax)]
    (selfSlotMoves ss ds)

-- | 自递归尾调用的实参：目标形参槽不会被**后面的实参**读到时，求值完立即写回去，省掉
--   一个中转槽（`loop (f acc n) (n - 1)` 这类热点循环的常见形状）；否则先落到临时槽，
--   全部求值完再统一搬（保持原来的求值顺序与语义）。
record SelfArgs where
  saInstrs : List Instr
  saState : FGen
  saPending : List (Int, Int)

genSelfTailCall : Int -> FGen -> List Ir -> NRes (List Instr, FGen)
genSelfTailCall fuel st args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else if length args /= length st.fgSelfParams then
    internal "self tail call arity mismatch"
  else
    nbind
      (genSelfArgs (fuel - 1) (SelfArgs [] st []) args st.fgSelfParams st.fgSelfBinds)
      (\q => NOk (append q.saInstrs (append (copyBacks (floatParamSlots st.fgSelfParams st.fgSelfBinds st) q.saPending) [IJmp st.fgSelfLoop]), q.saState))

-- | 自递归形参里被拆箱成 raw `f64` 位的槽（与 `fgSelfParams` 同源的子集）。
floatParamSlots : List Int -> List IrBinder -> FGen -> List Int
floatParamSlots [] _ _ = []
floatParamSlots _ [] _ = []
floatParamSlots (slot :: ss) (b :: bs) st =
  if isFloatBindBinder st b then slot :: floatParamSlots ss bs st else floatParamSlots ss bs st

-- | 单个自递归实参写回：目标是拆箱浮点槽时，优先把浮点树直接算进 xmm（不装盒）。
genSelfFloatArg : Int -> FGen -> Int -> Ir -> NRes (List Instr, FGen)
genSelfFloatArg fuel st dst a =
  case floatTreeIntoXmm0 st a of
    Just ins => NOk (append ins (storeFloatSlot dst), st)
    Nothing =>
      nbind
        (genExpr fuel st a)
        (\q => NOk (append (firstOf q) (storeFloatSlotFromRax dst), secondOf q))

genSelfArgs : Int -> SelfArgs -> List Ir -> List Int -> List IrBinder -> NRes SelfArgs
genSelfArgs _ acc [] _ _ = NOk acc
genSelfArgs _ _ (_ :: _) [] _ = internal "self tail call arity mismatch"
genSelfArgs _ _ (_ :: _) (_ :: _) [] = internal "self tail call arity mismatch"
genSelfArgs fuel acc (a :: rest) (dst :: dsts) (b :: binds) =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else if anyArgRefs b rest then
    let
      p = freshSlot acc.saState
      tmp = firstOf p
      st1 = secondOf p
    in nbind (genExpr (fuel - 1) (dirtyArgState st1 dst a) a) (\q => genSelfArgs (fuel - 1) (SelfArgs (append acc.saInstrs (append (firstOf q) (storeSlot tmp))) (restoreDirty (secondOf q) acc.saState) (append acc.saPending [(tmp, dst)])) rest dsts binds)
  else if isFloatBindBinder acc.saState b then nbind (genSelfFloatArg (fuel - 1) (dirtyArgState acc.saState dst a) dst a) (\q => genSelfArgs (fuel - 1) (SelfArgs (append acc.saInstrs (firstOf q)) (restoreDirty (secondOf q) acc.saState) acc.saPending) rest dsts binds) else nbind (genExpr (fuel - 1) (dirtyArgState acc.saState dst a) a) (\q => genSelfArgs (fuel - 1) (SelfArgs (append acc.saInstrs (append (firstOf q) (storeSlot dst))) (restoreDirty (secondOf q) acc.saState) acc.saPending) rest dsts binds)

-- | 目标是 dirty 参数、且实参是纯标量链时，求值可以保留未归一化值；其它实参照常
--   按归一化值生成（调用边界另有 `genArgs` 兜底）。
dirtyArgState : FGen -> Int -> Ir -> FGen
dirtyArgState st dst a =
  if memInt dst st.fgDirtySlots && Dirty.dirtySafeArg a then { st | fgAllowDirty = True } else st

restoreDirty : FGen -> FGen -> FGen
restoreDirty st base = { st | fgAllowDirty = base.fgAllowDirty }

anyArgRefs : IrBinder -> List Ir -> Bool
anyArgRefs b args = foldl (\acc, a => acc || memBinderId b.irBinderId (binderRefsOf a)) False args

copyBacks : List Int -> List (Int, Int) -> List Instr
copyBacks _ [] = []
copyBacks floats (p :: rest) =
  let
    from = firstOf p
    to = secondOf p
    moves =
      if memInt to floats then
        append [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff from))] (storeFloatSlotFromRax to)
      else
        [
          IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff from)),
          IMov (OpMem Rbp (nativeSlotOff to)) (OpReg Rax)
        ]
  in append moves (copyBacks floats rest)

-- | 沿零参定义解析别名链（`f = rt:add` / `f = g`）：判据与链解析在 `Ir.Alias`。
--   不是别名的零参 CAF（真实计算/分配）返回 Nothing，调用方回退 `rt_apply`。
aliasTargetOf : Int -> List IrDef -> String -> Maybe AliasTarget
aliasTargetOf fuel defs name =
  case irFindDefLocal name defs of
    Nothing => Nothing
    Just d =>
      if irDefArity d /= 0 then
        Just (AliasGlobal name)
      else
        case Alias.irAliasTargetOf fuel defs name of
          Just (Alias.IrAliasRt sym) => Just (AliasRt sym)
          Just (Alias.IrAliasGlobal g) => Just (AliasGlobal g)
          Nothing => Nothing

-- | 本地便捷：按名字查定义（与 `Alias.irFindDef` 同语义，避免重复限定名）。
irFindDefLocal : String -> List IrDef -> Maybe IrDef
irFindDefLocal = Alias.irFindDef

-- | 调用点静态已知的被调用者。
--
--   来源只有「构造点可知」的形态：顶层函数 / 运行时叶子 / 立即 lambda / 绑定点上能
--   解析到这些的 binder，以及它们的部分应用（`rt_apply` 的 shim 把 arity 减掉）。
--   函数参数、case 字段与投影一律未知：运行时 arity 可以小于静态类型的箭头数
--   （η-收缩定义当值时，wrapper 的 arity 是定义参数个数），所以不能只凭类型推 arity。
export knownCalleeOf : List IrDef -> List (Int, KnownCallee) -> Ir -> Maybe KnownCallee
knownCalleeOf defs known ir = knownCalleeFuel 256 defs known ir

knownCalleeFuel : Int -> List IrDef -> List (Int, KnownCallee) -> Ir -> Maybe KnownCallee
knownCalleeFuel fuel defs known ir =
  if fuel <= 0 then
    Nothing
  else
    case ir of
      IrGlobal name => globalCallee (fuel - 1) defs name
      IrRt sym => rtLeafCallee sym
      IrLam bs _ _ =>
        let
          n = length (runtimeBinders bs)
        in if n > 0 then Just (KClosure n) else Nothing
      IrVar b => lookupKnown b.irBinderId known
      IrCast _ _ inner => knownCalleeFuel (fuel - 1) defs known inner
      IrTail inner => knownCalleeFuel (fuel - 1) defs known inner
      IrApp _ _ _ =>
        case flattenApp ir of
          (head, args) => partialCallee (knownCalleeFuel (fuel - 1) defs known head) (length args)
      _ => Nothing

lookupKnown : Int -> List (Int, KnownCallee) -> Maybe KnownCallee
lookupKnown _ [] = Nothing
lookupKnown id (p :: rest) = if firstOf p == id then Just (secondOf p) else lookupKnown id rest

rtLeafCallee : String -> Maybe KnownCallee
rtLeafCallee sym =
  case nativeRtTarget sym of
    Nothing => Nothing
    Just label =>
      let
        a = rtValueArityOf sym
      in if a > 0 then Just (KDirect label a) else Nothing

globalCallee : Int -> List IrDef -> String -> Maybe KnownCallee
globalCallee fuel defs name =
  if fuel <= 0 then
    Nothing
  else
    case findDef name defs of
      Nothing => Nothing
      Just d =>
        let
          arity = irDefArity d
        in if arity > 0 then
          Just (KDirect (nativeFuncLabel name) arity)
        else
          case irDefBody d of
            Nothing => Nothing
            Just b =>
              case stripTail b of
                IrRt sym => rtLeafCallee sym
                IrGlobal g => if g == name then Nothing else globalCallee (fuel - 1) defs g
                IrLam bs _ _ =>
                  let
                    n = length (runtimeBinders bs)
                  in if n > 0 then Just (KClosure n) else Nothing
                IrApp _ _ _ =>
                  case flattenApp (stripTail b) of
                    (h, args) => partialCallee (knownCalleeFuel (fuel - 1) defs [] h) (length args)
                _ => Nothing

-- | 已知闭包被部分应用后的剩余 arity（与 `rt_apply` 的 shim 同口径）；不是部分应用时未知。
partialCallee : Maybe KnownCallee -> Int -> Maybe KnownCallee
partialCallee Nothing _ = Nothing
partialCallee (Just kc) k =
  let
    a = calleeArity kc
  in if k < a then Just (KClosure (a - k)) else Nothing

-- | 闭包体只看得到自己的捕获值：已知表按捕获集合筛一遍。
filterKnown : List (IrBinder, Int) -> List (Int, KnownCallee) -> List (Int, KnownCallee)
filterKnown caps known = filter (knownKept caps) known

knownKept : List (IrBinder, Int) -> (Int, KnownCallee) -> Bool
knownKept caps (id, _) = anyCap id caps

anyCap : Int -> List (IrBinder, Int) -> Bool
anyCap _ [] = False
anyCap id ((b, _) :: rest) = if b.irBinderId == id then True else anyCap id rest

-- | 饱和的已知调用：`KDirect` 不生成闭包值，直接标准 ABI 调用；`KClosure` 仍从槽取
--   闭包（`rdi`），但跳过运行时 arity 检查与 `rt_apply` 回退。
genKnownApply : Int -> FGen -> Bool -> Ir -> List Ir -> KnownCallee -> NRes (List Instr, FGen)
genKnownApply fuel st isTail head args kc =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case kc of
      KDirect label arity => if isTail && tailCallFits st (nativeStackArgCount arity nativeMaxArgs) then genTailCall (fuel - 1) st label args else genSaturatedCall (fuel - 1) st label args
      KClosure arity =>
        nbind (genExpr (fuel - 1) st head) (
            \p =>
              let
                cloP = freshSlot (secondOf p)
                clo = firstOf cloP
              in nbind (genArgs (fuel - 1) (secondOf cloP) args) (
                  \q =>
                    let
                      slots = firstOf (secondOf q)
                      callIns = if isTail && tailCallFits st (nativeStackArgCount arity (length closureArgRegs)) then closureTailCallSlotsInstrs clo slots else closureCallSlotsInstrs clo slots
                    in NOk (cat [firstOf p, storeSlot clo, firstOf q, callIns], secondOf (secondOf q))
                )
          )

-- | 全局应用。`irDefArity` 为 0 的定义是 η-收缩后的别名（body 本身就是函数值）：
--   别名链解析到运行时叶子或目标定义时直接调用（饱和则内联标量叶子），否则
--   取它的值再应用实参（与 wasm 侧 `genGlobalRef` 同口径）。
genGlobalCall : Int -> FGen -> Bool -> String -> List Ir -> NRes (List Instr, FGen)
genGlobalCall fuel st isTail name args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case findDef name st.fgDefs of
      Nothing => internal "undefined global in native codegen: ${name}"
      Just d =>
        let
          arity = irDefArity d
        in if isTail && st.fgSelfLoop /= "" && st.fgSelfLabel == nativeFuncLabel name && arity == length args then
          genSelfTailCall (fuel - 1) st args
        else if arity == length args then
          if isTail && tailCallFits st (nativeStackArgCount arity nativeMaxArgs) then genTailCall (fuel - 1) st (nativeFuncLabel name) args else genSaturatedCall (fuel - 1) st (nativeFuncLabel name) args
        else if arity == 0 then
          case aliasTargetOf (length st.fgDefs) st.fgDefs name of
            Just (AliasRt sym) => genRtValueCall (fuel - 1) st isTail sym args
            Just (AliasGlobal g) => if g == name then genApplyHead (fuel - 1) st isTail (IrGlobal name) args else genGlobalCall (fuel - 1) st isTail g args
            Nothing =>
              case knownCalleeOf st.fgDefs st.fgKnown (IrGlobal name) of
                Just kc => if length args == calleeArity kc then genKnownApply (fuel - 1) st isTail (IrGlobal name) args kc else genApplyHead (fuel - 1) st isTail (IrGlobal name) args
                Nothing => genApplyHead (fuel - 1) st isTail (IrGlobal name) args
        else
          genApplyHead (fuel - 1) st isTail (IrGlobal name) args

genNatSuccCall : Int -> FGen -> Bool -> Ir -> NRes (List Instr, FGen)
genNatSuccCall fuel st isTail arg =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else if isTail then
    genTailCall (fuel - 1) st (nativeRtLabel "nat_succ") [arg]
  else
    nbind
      (genExpr (fuel - 1) st arg)
      (\p => NOk (append (firstOf p) [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "nat_succ")], secondOf p))

-- ---------------------------------------------------------------
-- 标量运行时叶子的调用点展开
-- ---------------------------------------------------------------
memReg : Reg -> List Reg -> Bool
memReg _ [] = False
memReg r (x :: rest) = if sameReg r x then True else memReg r rest

dropReg : Reg -> List Reg -> List Reg
dropReg _ [] = []
dropReg r (x :: rest) = if sameReg r x then rest else x :: dropReg r rest

-- | 可用临时寄存器池：调用点前后都空闲的 caller-saved 寄存器。`r10` 只被
--   annotation 在 call 前两条指令里写，内联序列没有 call，所以也能用。
scalarRegs : List Reg
scalarRegs = [Rax, R11, R10, R8, R9]

-- | 第一个实参要用的寄存器池：若第二个实参里有 `cqo`+`idiv`（需要 rax），把 rax 挪出
--   池首（第一个实参拿池首当结果寄存器，这样 rax 就留给第二个实参）。
pickFirst : List Reg -> Bool -> List Reg
pickFirst pool avoidRax =
  if not avoidRax then
    pool
  else
    case nonRaxIn pool of
      Just r => r :: dropReg r pool
      Nothing => pool

nonRaxIn : List Reg -> Maybe Reg
nonRaxIn [] = Nothing
nonRaxIn (r :: rest) = if sameReg r Rax then nonRaxIn rest else Just r

-- | 表达式树里有没有「需要 rax 的常数除法」（非 2 的幂）。
needsRax : Ir -> Bool
needsRax (IrRtApp sym args) =
  if sym == "/" then
    case args of
      [_dividend, IrInt d] =>
        case divPlanOf d of
          Just (DivIdiv _) => True
          Just (DivMagic _ _ _) => True
          _ => foldl (\acc, a => if acc then True else needsRax a) False args
      _ => foldl (\acc, a => if acc then True else needsRax a) False args
  else
    foldl (\acc, a => if acc then True else needsRax a) False args
needsRax (IrCast _ _ inner) = needsRax inner
needsRax (IrTail inner) = needsRax inner
needsRax _ = False

-- | 把一个原子实参装进寄存器：槽变量 / 整数字面量 / 字符串字面量（`.rodata` 地址）。
atomToReg : FGen -> Reg -> Ir -> Maybe (List Instr)
atomToReg st r (IrVar b) =
  if isFloatBindBinder st b then
    Nothing
  else
    case lookupBinder b st.fgSlots of
      Just slot => Just [IMov (OpReg r) (OpMem Rbp (nativeSlotOff slot))]
      Nothing => Nothing
atomToReg _ r (IrInt n) = Just [IMov (OpReg r) (OpImm n)]
atomToReg st r (IrStr s) =
  case poolLabelOf s st.fgPool of
    Just label => Just [ILea r label]
    Nothing => Nothing
atomToReg _ _ _ = Nothing

-- | 字符串叶子的调用点内联（无分配、无 GC 点）：
--   * `strLength s`：长度头就是 `[s]`；
--   * `strAt s i`：`i < 0` 或 `i >= len` 返回 -1，否则读一个字节（与 `rt_str_at` 同义）。
--   实参不是原子时返回 `Nothing`（回退到运行时调用）。
strInline : FGen -> String -> List Ir -> Maybe (List Instr, FGen)
strInline st sym args =
  if sym == "strLength" then
    case args of
      [a] =>
        case atomToReg st Rax a of
          Just load => Just (append load [IMov (OpReg Rax) (OpMem Rax 0)], st)
          Nothing => Nothing
      _ => Nothing
  else if sym == "strAt" then
    case args of
      [sa, ia] =>
        case (atomToReg st Rax sa, atomToReg st R11 ia) of
          (Just loadS, Just loadI) =>
            let
              slowP = freshLabel st
              slow = firstOf slowP
              doneP = freshLabel (secondOf slowP)
              done = firstOf doneP
              body = append loadS (append loadI [IMov (OpReg R10) (OpMem Rax 0), ICmp (OpReg R11) (OpImm 0), IJcc "jl" slow, ICmp (OpReg R11) (OpReg R10), IJcc "jge" slow, IMovzx Rax (OpMemX Rax R11 8), IJmp done, ILabel slow, IMov (OpReg Rax) (OpImm (0 - 1)), ILabel done])
            in Just (body, secondOf doneP)
          _ => Nothing
      _ => Nothing
  else
    Nothing

-- | 浮点叶子的调用点内联：仍是一次 `alloc_leaf`（Float 是堆上的 leaf 对象），但省掉
--   运行时函数的帧与实参槽往返。装盒先做（此时实参指针都在槽里，`alloc` 触发的 GC 安全），
--   然后新对象只留在 `r10` 里；**之后不再有 call**，所以 `xmm` / `r10` 不需要是根。
-- | 浮点调用的树内联入口：`IrRtApp` 的二元算子与 `IrApp (IrRt …)` 的一元算子都先试整树。
floatTreeOf : FGen -> String -> List Ir -> Maybe (List Instr)
floatTreeOf st sym args =
  if isFloatBin sym then
    floatTreeInline st (IrRtApp sym args)
  else if sym == "floatSqrt" || sym == "floatAbs" || sym == "floatFromInt" then
    case args of
      [a] => floatTreeInline st (IrApp Nothing (IrRt sym) a)
      _ => Nothing
  else
    Nothing

-- | 浮点表达式**树**：整棵树在 `xmm0..3` 上算完，只有根装盒一次。
--   中间结果不装箱，所以 `acc + sqrt(abs (intToFloat n)) * 0.25 - 0.5` 这种形状从
--   每个运算一次 `alloc_leaf` + 一次运行时调用，降到一次 `alloc_leaf`。
--   叶子只接受：槽里的装箱 Float（`movsd` 解引用）、浮点字面量（`.rodata`）、
--   `floatFromInt` 的整数原子。任何别的形态（调用 / 高阶 / 记录字段）返回 `Nothing`，
--   调用方回退到逐运算内联。
--
--   装盒在**树计算之前**：`alloc_leaf` 可能触发 GC，此时实参指针仍只在槽里（保守根）；
--   之后树内不再有 `call`，所以 `xmm` 与装盒对象的寄存器都不需要是根。
floatBinOf : String -> String
floatBinOf "bi_add_float" = "add"
floatBinOf "bi_sub_float" = "sub"
floatBinOf "bi_mul_float" = "mul"
floatBinOf _ = "div"

floatTree : FGen -> List Int -> Ir -> Maybe (Int, List Instr, List Int)
floatTree st [] ir = Nothing
floatTree st (x :: rest) ir =
  case ir of
    IrCast _ _ inner => floatTree st (x :: rest) inner
    IrVar b =>
      case lookupBinder b st.fgSlots of
        Just slot =>
          if isFloatBindBinder st b then
            Just (x, [IXmmLoad x (OpMem Rbp (nativeSlotOff slot))], rest)
          else
            Just
              (x, [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot)), IXmmLoad x (OpMem Rax 0)], rest)
        Nothing => Nothing
    IrFloatLit raw =>
      case poolLabelOf raw st.fgFloats of
        Just label => Just (x, [IXmmLoad x (OpRip label)], rest)
        Nothing => Nothing
    IrRtApp sym args => if isFloatBin sym then floatTreeBin st (x :: rest) sym args else Nothing
    IrApp _ f a => floatTreeApp st (x :: rest) f a
    IrIf c t e => floatTreeCond st (x :: rest) c t e
    _ => Nothing

floatTreeBin : FGen -> List Int -> String -> List Ir -> Maybe (Int, List Instr, List Int)
floatTreeBin st pool sym [a, b] =
  case floatTree st pool a of
    Just pa =>
      let
        da = firstOf pa
        ia = firstOf (secondOf pa)
        restA = secondOf (secondOf pa)
      in case floatLitLabel st b of
        -- 右操作数是字面量：直接当内存操作数，省掉一次 `movsd` 装填。
        Just label => Just (da, append ia [IXmmBinMem (floatBinOf sym) da (OpRip label)], restA)
        Nothing =>
          case floatTree st restA b of
            Just pb =>
              let
                db = firstOf pb
                ib = firstOf (secondOf pb)
                rest = secondOf (secondOf pb)
              in Just (da, append ia (append ib [IXmmBin (floatBinOf sym) da db]), db :: rest)
            Nothing => Nothing
    Nothing => Nothing
floatTreeBin _ _ _ _ = Nothing

-- | 浮点字面量在这次生成里的 `.rodata` 标签。
floatLitLabel : FGen -> Ir -> Maybe String
floatLitLabel st (IrCast _ _ inner) = floatLitLabel st inner
floatLitLabel st (IrFloatLit raw) = poolLabelOf raw st.fgFloats
floatLitLabel _ _ = Nothing

floatTreeApp : FGen -> List Int -> Ir -> Ir -> Maybe (Int, List Instr, List Int)
floatTreeApp st pool f a =
  case floatLeafSymOf st f of
    -- `sqrt` / `abs` / `intToFloat` 是 η-收缩的零参别名（`sqrt = rt:floatSqrt`），
    -- 调用点上解析到运行时叶子后再按一元叶子展开。
    Just sym => floatTreeLeafApp st pool sym a
    Nothing => Nothing

-- | 一元运行时符号的解析：直接是 `IrRt`，或零参别名（`abs = rt:floatAbs`）。
floatLeafSymOf : FGen -> Ir -> Maybe String
floatLeafSymOf _ (IrRt sym) = Just sym
floatLeafSymOf st (IrGlobal name) =
  case aliasTargetOf 8 st.fgDefs name of
    Just (AliasRt sym) => Just sym
    _ => Nothing
floatLeafSymOf _ _ = Nothing

floatTreeLeafApp : FGen -> List Int -> String -> Ir -> Maybe (Int, List Instr, List Int)
floatTreeLeafApp st (x :: rest) sym a =
  if sym == "floatSqrt" then
    floatTreeUn st (x :: rest) "sqrt" a
  else if sym == "floatAbs" then
    if floatNonNegative st a then floatTree st (x :: rest) a else floatTreeUn st (x :: rest) "abs" a
  else if sym == "floatFromInt" then
    case atomToReg st Rax a of
      -- `abs` 对可证非负的操作数是恒等（`intToFloat` 的非负性来自守卫区间）：
      -- 整条省掉，`sqrt (abs (intToFloat n))` 只剩一次 `cvtsi2sd`。
      Just load => Just (x, append load [IXmmFromInt x Rax], rest)
      Nothing => Nothing
  else
    Nothing
floatTreeLeafApp _ [] _ _ = Nothing

-- | 浮点操作数可证明非负：`intToFloat e` 且 `e` 的区间下界 ≥ 0。
floatNonNegative : FGen -> Ir -> Bool
floatNonNegative st (IrCast _ _ inner) = floatNonNegative st inner
floatNonNegative st (IrTail inner) = floatNonNegative st inner
floatNonNegative st (IrRtApp sym args) = floatNonNegLeaf st sym args
floatNonNegative st (IrApp _ f a) =
  case floatLeafSymOf st f of
    Just sym => floatNonNegLeaf st sym [a]
    Nothing => False
floatNonNegative _ _ = False

floatNonNegLeaf : FGen -> String -> List Ir -> Bool
floatNonNegLeaf st sym args =
  if sym == "floatFromInt" then
    case args of
      [a] => nonNegative (rangeOf st.fgRanges a)
      _ => False
  else
    False

floatTreeUn : FGen -> List Int -> String -> Ir -> Maybe (Int, List Instr, List Int)
-- abs：按位清符号位（与 `rt_float_abs` 同一手法），不引入 `andpd`。
floatTreeUn st pool mode a =
  case floatTree st pool a of
    Nothing => Nothing
    Just pa =>
      let
        d = firstOf pa
        ins = firstOf (secondOf pa)
        rest = secondOf (secondOf pa)
      in if mode == "sqrt" then
        Just (d, append ins [IXmmUnop "sqrt" d], rest)
      else
        Just
          (d, append ins [IXmmToReg Rax d, IBinReg "shl" Rax (OpImm 1), IBinReg "shr" Rax (OpImm 1), IXmmFromReg d Rax], rest)

allocLeafToR11 : List Instr
allocLeafToR11 =
  [IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc_leaf"), IMov (OpReg R11) (OpReg Rax)]

-- | 拆箱形参的**逃逸读点**：槽里是 raw `f64` 位，按指针用之前装盒成一个新 leaf。
--   分配在前（可能触发 GC；槽里的位模式不是根），之后不再有 call。
boxFloatSlot : Int -> List Instr
boxFloatSlot slot =
  append
    allocLeafToR11
    [IXmmLoad 0 (OpMem Rbp (nativeSlotOff slot)), IXmmStore (OpMem R11 0) 0, IMov (OpReg Rax) (OpReg R11)]

-- | 拆箱形参的**写点**：把 xmm0 里的值写成槽里的 raw 位（不分配）。
storeFloatSlot : Int -> List Instr
storeFloatSlot slot = [IXmmStore (OpMem Rbp (nativeSlotOff slot)) 0]

-- | 从 rax 里的装箱 Float 拆出 raw 位写进拆箱槽。
storeFloatSlotFromRax : Int -> List Instr
storeFloatSlotFromRax slot =
  [IXmmLoad 0 (OpMem Rax 0), IXmmStore (OpMem Rbp (nativeSlotOff slot)) 0]

-- | 把浮点表达式算进 `xmm0`（不装盒）；不是浮点树时返回 `Nothing`。
floatTreeIntoXmm0 : FGen -> Ir -> Maybe (List Instr)
floatTreeIntoXmm0 st ir =
  case floatTree st [0, 1, 2, 3] ir of
    Just pa => Just (firstOf (secondOf pa))
    Nothing => Nothing

floatTreeInline : FGen -> Ir -> Maybe (List Instr)
floatTreeInline st ir =
  case floatTree st [0, 1, 2, 3] ir of
    Just pa =>
      let
        d = firstOf pa
        ins = firstOf (secondOf pa)
      in Just
        (catInstrs [allocLeafToR11, ins, [IXmmStore (OpMem R11 0) d, IMov (OpReg Rax) (OpReg R11)]])
    Nothing => Nothing

isFloatBin : String -> Bool
isFloatBin sym =
  sym == "bi_add_float" || sym == "bi_sub_float" || sym == "bi_mul_float" || sym == "bi_div_float"

floatInline : FGen -> String -> List Ir -> Maybe (List Instr)
floatInline st sym args =
  if isFloatBin sym then
    floatBinInline st sym args
  else if sym == "floatSqrt" then
    case args of
      [a] =>
        case floatAtomToXmm st 0 a of
          Just la => Just (catInstrs [allocLeafToR10, la, [IXmmUnop "sqrt" 0, IXmmStore (OpMem R10 0) 0, IMov (OpReg Rax) (OpReg R10)]])
          Nothing => Nothing
      _ => Nothing
  else if sym == "floatAbs" then
    case args of
      [a] =>
        case floatAtomToXmm st 0 a of
          Just la => Just (catInstrs [allocLeafToR10, la, [IXmmToReg Rax 0, IBinReg "shl" Rax (OpImm 1), IBinReg "shr" Rax (OpImm 1), IXmmFromReg 0 Rax, IXmmStore (OpMem R10 0) 0, IMov (OpReg Rax) (OpReg R10)]])
          Nothing => Nothing
      _ => Nothing
  else if sym == "floatFromInt" then
    case args of
      [a] =>
        case atomToReg st Rax a of
          Just la => Just (catInstrs [allocLeafToR10, la, [IXmmFromInt 0 Rax, IXmmStore (OpMem R10 0) 0, IMov (OpReg Rax) (OpReg R10)]])
          Nothing => Nothing
      _ => Nothing
  else if sym == "intFromFloat" then
    case args of
      [a] =>
        case floatAtomToXmm st 0 a of
          Just la => Just (catInstrs [la, [IXmmToInt Rax 0]])
          Nothing => Nothing
      _ => Nothing
  else
    Nothing

floatBinInline : FGen -> String -> List Ir -> Maybe (List Instr)
floatBinInline st sym [a, b] =
  case (floatAtomToXmm st 0 a, floatAtomToXmm st 1 b) of
    (Just la, Just lb) =>
      Just
        (catInstrs [allocLeafToR10, la, lb, [IXmmBin (floatBinOf sym) 0 1, IXmmStore (OpMem R10 0) 0, IMov (OpReg Rax) (OpReg R10)]])
    _ => Nothing
floatBinInline _ _ _ = Nothing

catInstrs : List (List Instr) -> List Instr
catInstrs xs = concatMap (\x => x) xs

allocLeafToR10 : List Instr
allocLeafToR10 =
  [IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc_leaf"), IMov (OpReg R10) (OpReg Rax)]

-- | 常数除法：先选被除数，再从剩余池里取 scratch。
-- | 有符号常量除法：先选被除数，再从剩余池里取 scratch。
genDivInto : Int -> FGen -> List Reg -> Ir -> DivPlan -> Maybe (Reg, List Instr, List Reg)
genDivInto bud st pool a (DivShift k) =
  case genScalarIntoW (bud - 1) True st pool a of
    Nothing => Nothing
    Just pa =>
      case secondOf (secondOf pa) of
        s :: rest =>
          let
            r = firstOf pa
            ins = firstOf (secondOf pa)
            -- 非负被除数：`x / 2^k` 就是逻辑右移一条（算术右移结果相同，`shr` 更直白）。
            -- 负数要按符号补 `d-1` 再算术右移（向零截断）：用 `test` + `lea d-1` +
            -- `cmovns` 选回原值，比 `sar 63; and d-1; add` 少一条、关键路径短一拍。
            nonNeg = k == 0 || nonNegative (rangeOf st.fgRanges a)
          in if nonNeg then
            let
              instrs = if k == 0 then ins else append ins [IBinReg "shr" r (OpImm k)]
            in Just (r, instrs, s :: rest)
          else
            let
              instrs = append ins [ITest r r, ILeaMem s r (ipow2 k - 1), ICmov "cmovns" s (OpReg r), IBinReg "sar" s (OpImm k)]
            in Just (s, instrs, r :: rest)
        [] => Nothing
genDivInto bud st pool a (DivMagic _ m shift) =
  case genScalarIntoW (bud - 1) True st pool a of
    Nothing => Nothing
    Just pa =>
      let
        r = firstOf pa
        inInstrs = firstOf (secondOf pa)
        poolAfter = secondOf (secondOf pa)
        -- magic 序列固定占用 rax/rdx，另需三个空闲寄存器：x/q / sign / magic。
        frees = filter (\x => not (sameReg x Rax)) poolAfter
      in case frees of
        s1 :: s2 :: s3 :: _ =>
          let
            shiftIns = if shift == 0 then [] else [IBinReg "sar" s1 (OpImm shift)]
            instrs =
              append
                inInstrs
                (append [IMov (OpReg s1) (OpReg r), IMov (OpReg s2) (OpReg s1), IBinReg "sar" s2 (OpImm 63), IMov (OpReg Rax) (OpReg s1), IMov (OpReg s3) (OpImm m), IMulSigned s3, IMov (OpReg s1) (OpReg Rdx)] (append shiftIns [IBinReg "sub" s1 (OpReg s2)]))
            outPool = s2 :: s3 :: dropReg Rax poolAfter
          in Just (s1, instrs, outPool)
        _ => Nothing
genDivInto bud st pool a (DivIdiv c) =
  if memReg Rax pool then
    case genScalarIntoW (bud - 1) True st (dropReg Rax pool) a of
      -- `cqo` + `idiv` 固定用 rax:rdx，所以 rax 必须还没被更早的实参占住。
      Nothing => Nothing
      Just pa =>
        case secondOf (secondOf pa) of
          s :: rest =>
            let
              r0 = firstOf pa
              toRax = if sameReg r0 Rax then [] else [IMov (OpReg Rax) (OpReg r0)]
              instrs = append (firstOf (secondOf pa)) (append toRax [ICqo, IMov (OpReg s) (OpImm c), IDiv s])
            in Just (Rax, instrs, r0 :: s :: rest)
          [] => Nothing
  else
    Nothing

ipow2 : Int -> Int
ipow2 k = if k <= 0 then 1 else 2 * ipow2 (k - 1)

-- | 标量求值失败后改试「先右后左」/ 溢出到栈的预算：每下沉一层子表达式消耗 1。
--   用尽后只按源码顺序求值、失败即回退通用路径。回溯次数因此被钉在 `3^预算` 倍以内，
--   不会随表达式深度指数增长（右深加法链曾在 `main` 上打出千万次重试）。
scalarRetryBudget : Int
scalarRetryBudget = 5

-- | 把纯标量表达式选进寄存器：只接受字面量、槽变量、标量 cast 与白名单 `IrRtApp`；
--   返回结果寄存器、指令与回收后的寄存器池。其它形态返回 Nothing（整棵子树回退）。
--
-- `wrap` 表示这棵子树的结果要不要 63-bit wrap：根位置总是要；父算子是加减乘（mod 2^63）
-- 或低位掩码时不要——两层 wrap 之间的中间值只影响高位，最后统一 wrap 一次即可。
genScalarInto : FGen -> List Reg -> Ir -> Maybe (Reg, List Instr, List Reg)
genScalarInto st pool ir = genScalarIntoW scalarRetryBudget True st pool ir

genScalarIntoW : Int -> Bool -> FGen -> List Reg -> Ir -> Maybe (Reg, List Instr, List Reg)
genScalarIntoW _ _ st pool (IrInt n) =
  case pool of
    r :: rest => Just (r, [IMov (OpReg r) (OpImm n)], rest)
    [] => Nothing
genScalarIntoW bud wrap st pool (IrVar b) =
  case lookupBinder b st.fgSlots of
    Just slot =>
      case pool of
        r :: rest =>
          let
            base = [IMov (OpReg r) (OpMem Rbp (nativeSlotOff slot))]
            instrs =
              if wrap && memInt slot st.fgDirtySlots then
                append base [IBinReg "shl" r (OpImm 1), IBinReg "sar" r (OpImm 1)]
              else
                base
          in Just (r, instrs, rest)
        [] => Nothing
    Nothing => Nothing
genScalarIntoW bud wrap st pool (IrCast from to inner) =
  if isScalarCls (clsOfTy st from) && isScalarCls (clsOfTy st to) then
    genScalarIntoW bud wrap st pool inner
  else
    Nothing
-- 除以编译期常量：`d = 2^k` 用符号修正移位，其余走内联 `idiv`（都省掉一次调用与
-- 实参槽往返）。除法的操作数必须已 wrap、结果天然在范围内。`d = 0` / `d = -1` 仍走
-- `rt_div`（除零 trap 与 `min_int / -1` 语义）。
genScalarIntoW bud wrap st pool (IrRtApp sym args) =
  if sym == "/" then
    case args of
      [a, IrInt d] =>
        case divPlanOf d of
          Just plan => genDivInto bud st pool a plan
          Nothing => Nothing
      _ => Nothing
  else
    case scalarPlanOf sym of
      Nothing => Nothing
      Just plan => if length args /= irInlineArity sym then Nothing else genScalarOpW bud wrap st pool (firstOf plan) args
-- `if b then 1 else 0` 就是 b（0/1）；作为标量实参时直接取值的计划，父算子继续内联。
genScalarIntoW bud wrap st pool (IrIf c t e) =
  case boolSelectModeOf t e of
    Just mode =>
      case genScalarIntoW bud wrap st pool c of
        Just pa =>
          let
            r = firstOf pa
          in Just
            (r, append (firstOf (secondOf pa)) (boolSelectInstrs mode r), secondOf (secondOf pa))
        Nothing => Nothing
    Nothing => Nothing
genScalarIntoW _ _ _ _ _ = Nothing

-- | 白名单算子的寄存器选择；`ScalarCmp` 的结果固定在 rax（`setcc` + `movzx rax, al`）。
genScalarOp : FGen -> List Reg -> ScalarOp -> List Ir -> Maybe (Reg, List Instr, List Reg)
genScalarOp st pool op args = genScalarOpW scalarRetryBudget True st pool op args

genScalarOpW : Int -> Bool -> FGen -> List Reg -> ScalarOp -> List Ir -> Maybe (Reg, List Instr, List Reg)
genScalarOpW _ _ st pool (ScalarConst n) _ =
  case pool of
    r :: rest => Just (r, [IMov (OpReg r) (OpImm n)], rest)
    [] => Nothing
genScalarOpW bud _ st pool (ScalarCmp cc) args =
  if not (memReg Rax pool) then
    Nothing
  else
    case args of
      [a, b] =>
        case genScalarIntoW (bud - 1) True st (dropReg Rax pool) a of
          Just pa =>
            case genScalarIntoW (bud - 1) True st (secondOf (secondOf pa)) b of
              Just pb =>
                let
                  rA = firstOf pa
                  inA = firstOf (secondOf pa)
                  rB = firstOf pb
                  inB = firstOf (secondOf pb)
                  rest = secondOf (secondOf pb)
                  res = scalarInstrs (ScalarCmp cc) rA rB
                in Just (firstOf res, append [IBinReg "xor" Rax (OpReg Rax)] (append inA (append inB (secondOf res))), rA :: rB :: rest)
              Nothing => Nothing
          Nothing => Nothing
      _ => Nothing
genScalarOpW bud _ st pool ScalarNatFromInt args =
  case args of
    [a] =>
      case pool of
        r :: rest =>
          case genScalarIntoW (bud - 1) True st (r :: rest) a of
            Just pa =>
              case secondOf (secondOf pa) of
                s :: rest2 =>
                  let
                    res = scalarInstrs ScalarNatFromInt (firstOf pa) s
                  in Just (firstOf res, append (firstOf (secondOf pa)) (secondOf res), s :: rest2)
                [] => Nothing
            Nothing => Nothing
        [] => Nothing
    _ => Nothing
-- `band x 常量掩码`：掩码清掉高位（`0 ≤ m ≤ maxInt`），所以 x 不必先 wrap，
-- 结果也天然落在 `[0, m]` 里。
genScalarOpW bud _ st pool (ScalarBitOp "and") [a, IrInt m] =
  if m >= 0 && m <= nativeMaxInt then
    genScalarBinInto
      bud
      False
      True
      st
      pool
      a
      (IrInt m)
      (\rA, rB => (rA, [IBinReg "and" rA (OpReg rB)]))
  else
    genScalarOpGeneric bud False st pool (ScalarBitOp "and") [a, IrInt m]
genScalarOpW bud wrap st pool op args = genScalarOpGeneric bud wrap st pool op args

genScalarOpGeneric : Int -> Bool -> FGen -> List Reg -> ScalarOp -> List Ir -> Maybe (Reg, List Instr, List Reg)
genScalarOpGeneric _ _ st pool op [] =
  case pool of
    r :: rest =>
      let
        res = scalarInstrs op r r
      in Just (firstOf res, secondOf res, r :: rest)
    [] => Nothing
genScalarOpGeneric bud wrap st pool op [a] =
  case pool of
    r :: rest =>
      case genScalarIntoW (bud - 1) (childWrap op) st (r :: rest) a of
        Just pa =>
          let
            res = resOf wrap op (firstOf pa) (firstOf pa)
          in Just
            (firstOf res, append (firstOf (secondOf pa)) (secondOf res), secondOf (secondOf pa))
        Nothing => Nothing
    [] => Nothing
genScalarOpGeneric bud wrap st pool op [a, b] =
  case genScalarBinOrdered bud wrap st pool op a b of
    Just p => Just p
    Nothing => Nothing
genScalarOpGeneric _ _ _ _ _ _ = Nothing

-- | 二元算子：先按源码顺序求值；寄存器池不够（通常是右侧的常数除法占住 rax/rdx）
--   时改试「先右后左」。标量子树无副作用，换序只影响寄存器压力。
--   改序与溢出都要花预算：预算用尽就只按源码顺序试一次，失败回退通用路径。
genScalarBinOrdered : Int -> Bool -> FGen -> List Reg -> ScalarOp -> Ir -> Ir -> Maybe (Reg, List Instr, List Reg)
genScalarBinOrdered bud wrap st pool op a b =
  case genScalarBinLeftFirst bud wrap st pool op a b of
    Just p => Just p
    Nothing =>
      if bud <= 0 then
        Nothing
      else
        case genScalarBinRightFirst bud wrap st pool op a b of
          Just p => Just p
          Nothing => genScalarBinSpill bud wrap st pool op a b

genScalarBinLeftFirst : Int -> Bool -> FGen -> List Reg -> ScalarOp -> Ir -> Ir -> Maybe (Reg, List Instr, List Reg)
genScalarBinLeftFirst bud wrap st pool op a b =
  case genScalarIntoW (bud - 1) (childWrap op) st (pickFirst pool (needsRax b)) a of
    Just pa =>
      case genScalarIntoW (bud - 1) (childWrap op) st (secondOf (secondOf pa)) b of
        Just pb =>
          let
            rA = firstOf pa
            inA = firstOf (secondOf pa)
            rB = firstOf pb
            inB = firstOf (secondOf pb)
            restB = secondOf (secondOf pb)
            res = resOf (wrap && not (rangeSkips st op a b)) op rA rB
          in Just (firstOf res, append inA (append inB (secondOf res)), rB :: restB)
        Nothing => Nothing
    Nothing => Nothing

genScalarBinRightFirst : Int -> Bool -> FGen -> List Reg -> ScalarOp -> Ir -> Ir -> Maybe (Reg, List Instr, List Reg)
genScalarBinRightFirst bud wrap st pool op a b =
  case genScalarIntoW (bud - 1) (childWrap op) st (pickFirst pool (needsRax a)) b of
    Just pb =>
      case genScalarIntoW (bud - 1) (childWrap op) st (secondOf (secondOf pb)) a of
        Just pa =>
          let
            rA = firstOf pa
            inA = firstOf (secondOf pa)
            rB = firstOf pb
            inB = firstOf (secondOf pb)
            restA = secondOf (secondOf pa)
            res = resOf (wrap && not (rangeSkips st op a b)) op rA rB
          in Just (firstOf res, append inB (append inA (secondOf res)), rA :: restA)
        Nothing => Nothing
    Nothing => Nothing

-- | 两种求值顺序都放不下时：先把左值压栈，右值用完整寄存器池求值，再弹回一个空闲
--   寄存器做运算。纯标量子树里没有调用/分配，栈上这个临时值不需要 GC 跟踪。
genScalarBinSpill : Int -> Bool -> FGen -> List Reg -> ScalarOp -> Ir -> Ir -> Maybe (Reg, List Instr, List Reg)
genScalarBinSpill bud wrap st pool op a b =
  case genScalarIntoW (bud - 1) (childWrap op) st (pickFirst pool (needsRax b)) a of
    Just pa =>
      let
        rA = firstOf pa
        inA = firstOf (secondOf pa)
        poolA = secondOf (secondOf pa)
        poolRight = pickFirst (rA :: poolA) (needsRax a)
      in case genScalarIntoW (bud - 1) (childWrap op) st poolRight b of
        Just pb =>
          let
            rB = firstOf pb
            inB = firstOf (secondOf pb)
            restB = secondOf (secondOf pb)
          in case firstNotSame rB restB of
            Just rC =>
              let
                res = resOf (wrap && not (rangeSkips st op a b)) op rC rB
              in Just
                (firstOf res, append inA (append [IPush rA] (append inB (append [IPop rC] (secondOf res)))), rB :: restB)
            Nothing => Nothing
        Nothing => Nothing
    Nothing => Nothing

firstNotSame : Reg -> List Reg -> Maybe Reg
firstNotSame _ [] = Nothing
firstNotSame r (x :: rest) = if sameReg r x then firstNotSame r rest else Just x

-- | 子表达式能否省 wrap：加减乘是 mod 2^63 的运算，中间结果不必 wrap；其它算子要看
--   高位，操作数必须是已 wrap 的值。
childWrap : ScalarOp -> Bool
childWrap (ScalarWrap _) = False
childWrap _ = True

resOf : Bool -> ScalarOp -> Reg -> Reg -> (Reg, List Instr)
resOf True op a b = scalarInstrs op a b
resOf False op a b = scalarInstrsNoWrap op a b

-- | 可证明结果落在 `Int` 域内时，63-bit wrap 是 no-op（值仍然规范化，任何消费者都安全）。
rangeSkips : FGen -> ScalarOp -> Ir -> Ir -> Bool
rangeSkips st (ScalarWrap name) a b =
  case wrapSym name of
    Just sym => overflowFree sym (rangeOf st.fgRanges a) (rangeOf st.fgRanges b)
    Nothing => False
rangeSkips _ _ _ _ = False

wrapSym : String -> Maybe String
wrapSym "add" = Just "+"
wrapSym "sub" = Just "-"
wrapSym "imul" = Just "*"
wrapSym _ = Nothing

-- | 守卫为真的分支：事实只对这个子树有效。
withThen : FGen -> Ir -> FGen
withThen st c = { st | fgRanges = append (factsThen st.fgRanges c) st.fgRanges }

-- | 守卫为假的分支：事实从**外层**环境派生（不能继承 then 分支的事实）。
withElse : FGen -> FGen -> Ir -> FGen
withElse stAfter outer c =
  { stAfter | fgRanges = append (factsElse outer.fgRanges c) outer.fgRanges }

-- | 二元算子的求值：两个操作数按各自的口径求值，指令拼在一起。
genScalarBinInto : Int -> Bool -> Bool -> FGen -> List Reg -> Ir -> Ir -> (Reg -> Reg -> (Reg, List Instr)) -> Maybe (Reg, List Instr, List Reg)
genScalarBinInto bud wrapA wrapB st pool a b mk =
  case genScalarIntoW (bud - 1) wrapA st (pickFirst pool (needsRax b)) a of
    Just pa =>
      case genScalarIntoW (bud - 1) wrapB st (secondOf (secondOf pa)) b of
        Just pb =>
          let
            rA = firstOf pa
            inA = firstOf (secondOf pa)
            rB = firstOf pb
            inB = firstOf (secondOf pb)
            restB = secondOf (secondOf pb)
            res = mk rA rB
          in Just (firstOf res, append inA (append inB (secondOf res)), rB :: restB)
        Nothing => Nothing
    Nothing => Nothing

-- | `IrRtApp` 的标量选择：命中返回以 rax 收尾的指令序列，否则 Nothing（调用方回退）。
genInlineRt : FGen -> String -> List Ir -> Maybe (List Instr)
genInlineRt st sym args =
  if sym == "/" then
    case args of
      [a, IrInt d] =>
        case divPlanOf d of
          Just plan =>
            case genDivInto scalarRetryBudget st scalarRegs a plan of
              Just p =>
                let
                  r = firstOf p
                  instrs = firstOf (secondOf p)
                in Just (if sameReg r Rax then instrs else append instrs [IMov (OpReg Rax) (OpReg r)])
              Nothing => Nothing
          Nothing => Nothing
      _ => Nothing
  else
    case scalarPlanOf sym of
      Nothing => Nothing
      Just plan =>
        if length args /= irInlineArity sym then
          Nothing
        else
          case genScalarOpW scalarRetryBudget (not st.fgAllowDirty) st scalarRegs (firstOf plan) args of
            Nothing => Nothing
            Just p =>
              let
                r = firstOf p
                instrs = firstOf (secondOf p)
              in Just (if sameReg r Rax then instrs else append instrs [IMov (OpReg Rax) (OpReg r)])

-- | 零参常量桩（调试 / 可观测性叶子）的内联值。
scalarConstOf : String -> Maybe Int
scalarConstOf sym =
  case scalarPlanOf sym of
    Nothing => Nothing
    Just plan =>
      case firstOf plan of
        ScalarConst n => Just n
        _ => Nothing

genRtApp : Int -> FGen -> Bool -> String -> List Ir -> NRes (List Instr, FGen)
genRtApp fuel st isTail sym args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case sym of
      "&&" => genBoolChain (fuel - 1) st args True
      "||" => genBoolChain (fuel - 1) st args False
      _ =>
        case floatTreeOf st sym args of
          Just instrs => NOk (instrs, st)
          Nothing =>
            case floatInline st sym args of
              Just instrs => NOk (instrs, st)
              Nothing =>
                case floatCmpInline st sym args of
                  Just instrs => NOk (instrs, st)
                  Nothing =>
                    case strInline st sym args of
                      Just p => NOk p
                      Nothing =>
                        case genInlineRt st sym args of
                          Just instrs => NOk (instrs, st)
                          Nothing =>
                            case nativeRtTarget sym of
                              Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
                              Just label => if length args /= irInlineArity sym then internal "runtime symbol arity mismatch: ${sym}" else if isTail then genTailCall (fuel - 1) st label args else genSaturatedCall (fuel - 1) st label args

-- | `IrApp (IrRt sym) args`：运行时常量函数值的应用（`irInlineArity = 0` 的那些）。
--   标量叶子先走内联选择；其余饱和走直调，部分/过度应用先求值成闭包再交给 `rt_apply`。
genRtValueCall : Int -> FGen -> Bool -> String -> List Ir -> NRes (List Instr, FGen)
genRtValueCall fuel st isTail sym args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else if length args /= rtValueArityOf sym then
    genApplyHead (fuel - 1) st isTail (IrRt sym) args
  else
    case floatTreeOf st sym args of
      -- 部分 / 过度应用：统一走闭包 + `rt_apply`（内联要求饱和）。
      Just instrs => NOk (instrs, st)
      Nothing =>
        case floatInline st sym args of
          Just instrs => NOk (instrs, st)
          Nothing =>
            case floatCmpInline st sym args of
              Just instrs => NOk (instrs, st)
              Nothing =>
                case strInline st sym args of
                  Just p => NOk p
                  Nothing => genRtValueCallFallback (fuel - 1) st isTail sym args

-- | 值形态的剩余路径：标量选择 → 直调 → 部分 / 过度应用。
genRtValueCallFallback : Int -> FGen -> Bool -> String -> List Ir -> NRes (List Instr, FGen)
genRtValueCallFallback fuel st isTail sym args =
  case floatCmpInline st sym args of
    Just instrs => NOk (instrs, st)
    Nothing =>
      case genInlineRt st sym args of
        Just instrs => NOk (instrs, st)
        Nothing =>
          let
            arity = rtValueArityOf sym
          in if arity <= 0 then
            unsupported "native target: runtime function values are not supported yet"
          else if length args == arity then
            case nativeRtTarget sym of
              Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
              Just label => if isTail then genTailCall fuel st label args else genSaturatedCall fuel st label args
          else
            genApplyHead fuel st isTail (IrRt sym) args

-- | `IrConcatMany`：左→右两两拼接（与 OCaml 的 `String.concat ""` 语义一致）。
--   `parts` 至少 3 项（Lowering 的门槛），空/单元素的兜底只防空指针。
genConcatMany : Int -> FGen -> List Ir -> NRes (List Instr, FGen)
genConcatMany fuel st parts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case parts of
      [] => internal "empty string concatenation in native codegen"
      [one] => genExpr (fuel - 1) st one
      first :: rest =>
        nbind (genExpr (fuel - 1) st first) (
            \p =>
              let
                slotP = freshSlot (secondOf p)
                slot = firstOf slotP
                st1 = secondOf slotP
              in nbind (genConcatRest (fuel - 1) st1 slot rest) (\q => NOk (append (firstOf p) (append (storeSlot slot) (firstOf q)), secondOf q))
          )

-- | 累加器在 `slot`；对每个后续片段求值后与累加值拼接，结果回写累加器。
genConcatRest : Int -> FGen -> Int -> List Ir -> NRes (List Instr, FGen)
genConcatRest _ st slot [] = NOk (loadSlot slot, st)
genConcatRest fuel st slot (part :: rest) =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind
      (genExpr (fuel - 1) st part)
      (\p => nbind (genConcatRest (fuel - 1) (secondOf p) slot rest) (\q => NOk (append (firstOf p) (append [IMov (OpReg Rsi) (OpReg Rax)] (append (loadReg Rdi slot) (append [ICall (nativeRtLabel "str_concat"), IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)] (firstOf q)))), secondOf q)))

listHasStr : String -> List String -> Bool
listHasStr _ [] = False
listHasStr x (y :: rest) = if x == y then True else listHasStr x rest

-- | `Show Float` 的实现（`Base.Data.Float.floatRender`）；入口展示与用户 `show` 共用。
floatRenderName : String
floatRenderName = "Base.Data.Float.floatRender"

-- ---------------------------------------------------------------
-- 浮点字面量
-- ---------------------------------------------------------------
-- 字面量原文是数字、一个小数点与可选的前导 `-`。它不是运行期算出来的：`.rodata` 里
-- 每个模块一份 `.double <文本>` 常量池（`Ir.FloatLit` 负责超范围时的 `inf` 改写），
-- 使用点只发一条 `lea`。十进制 → double 的舍入由汇编器按 IEEE 完成，与 OCaml 的
-- 十进制解析同一结果，`-0.0` 也直接得到负零。
--
-- 值的形状与堆上装箱的 Float 叶子（`[f64]`）一致：都是指向 8 字节 double 的指针，
-- 所以消费方（`float_add` / `show` / 亲自 `movsd` 的内联序列）不需要区分来源；
-- `.rodata` 不在堆段内，GC 的候选指针判据天然忽略它。
genFloatLit : FGen -> String -> NRes (List Instr, FGen)
genFloatLit st raw =
  case poolLabelOf raw st.fgFloats of
    Just label => NOk ([ILea Rax label], st)
    Nothing => internal "float literal missing from native pool: ${raw}"

-- ---------------------------------------------------------------
-- Eff thunk（效应原语包装成 `MkEff (fun _ => prim args)`）
-- ---------------------------------------------------------------
-- | 效应原语包装成 `MkEff (\_ => prim args)`（构造细节在 `Ir.Synthetic`）；
-- native 额外把新合成的 lambda 重新标尾位置。
nativeArityOf : FGen -> String -> Maybe Int
nativeArityOf st name =
  case findDef name st.fgDefs of
    Just d => Just (irDefArity d)
    Nothing => Nothing

genEffThunk : Int -> FGen -> String -> String -> Int -> Ir -> NRes (List Instr, FGen)
genEffThunk fuel st family ctor arity prim =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    genExpr
      (fuel - 1)
      st
      (annotateBody (nativeArityOf st) (Synthetic.effThunkIr family ctor arity prim))

-- | 生成预算按定义体规模派生（每节点最多几步递归，与 `Ir.Cps` 的 `cpsFuelOfBody` 同口径）。
--   固定 100000 会让大定义体在没有任何不变式被破坏时报 fuel exhausted。
nativeFuelOfBody : Ir -> Int
nativeFuelOfBody body = 64 + 16 * irSize body

-- | 值位置生成：结果留在 `rax`，任何调用都正常返回。
genExpr : Int -> FGen -> Ir -> NRes (List Instr, FGen)
genExpr fuel st ir = genExprAt fuel st False ir

-- ---------------------------------------------------------------
-- Bool 槽的选择
-- ---------------------------------------------------------------
-- | `if b then 1 else 0` / `if b then 0 else 1` 里的 Bool 选择。native 的 Bool 就是
--   0/1，所以前者直接复用值，后者只翻转最低位——都不需要分支。
export data BoolSelect(..) : Type where
  BoolAsIs : BoolSelect
  BoolInvert : BoolSelect

export boolSelectModeOf : Ir -> Ir -> Maybe BoolSelect
boolSelectModeOf (IrInt 1) (IrInt 0) = Just BoolAsIs
boolSelectModeOf (IrBool True) (IrBool False) = Just BoolAsIs
boolSelectModeOf (IrInt 0) (IrInt 1) = Just BoolInvert
boolSelectModeOf (IrBool False) (IrBool True) = Just BoolInvert
boolSelectModeOf _ _ = Nothing

boolSelectInstrs : BoolSelect -> Reg -> List Instr
boolSelectInstrs BoolAsIs _ = []
boolSelectInstrs BoolInvert r = [IBinReg "xor" r (OpImm 1)]

-- | 条件在 `IrIf` 里直接当分支用：`IrRtApp` 的标量比较 + 原子实参 →
--   (装载+`cmp` 指令, 反向 `jcc`)。实参只接受字面量 / 槽变量（求值无副作用，
--   也不产生新的 GC 点）。
condBranch : FGen -> Ir -> Maybe (List Instr, String)
condBranch st (IrRtApp sym [IrRtApp "-" [a, IrInt c], IrInt 0]) =
  case branchInverse sym of
    Just inv =>
      if c >= 0 && firstOf (rangeOf st.fgRanges a) >= c then
        case atomOperand st a of
          Just op => Just ([ICmp op (OpImm c)], inv)
          Nothing => Nothing
      else
        Nothing
    Nothing => Nothing
condBranch st (IrRtApp sym args) =
  case branchInverse sym of
    Just inv =>
      case args of
        [a, b] =>
          case atomOperand st b of
            Just ob =>
              case genScalarInto st scalarRegs a of
                Just pa => Just (append (firstOf (secondOf pa)) [ICmp (OpReg (firstOf pa)) ob], inv)
                Nothing => Nothing
            Nothing => Nothing
        _ => Nothing
    Nothing =>
      case floatCmpInline st sym args of
        -- 浮点比较：原子实参直接装进 xmm0/xmm1，物化 0/1 后 `test` + `je`；
        -- 不调用运行时、不装箱（NaN 语义在 `Native.Select` 的序列里）。
        Just instrs => Just (append instrs [ITest Rax Rax], "je")
        Nothing => Nothing
condBranch _ _ = Nothing

atomOperand : FGen -> Ir -> Maybe Operand
atomOperand _ (IrInt n) = Just (OpImm n)
atomOperand st (IrVar b) =
  if isFloatBindBinder st b then
    Nothing
  else
    case lookupBinder b st.fgSlots of
      Just slot => Just (OpMem Rbp (nativeSlotOff slot))
      Nothing => Nothing
atomOperand _ _ = Nothing

-- | 浮点原子 → `xmm<reg>`：槽里的装箱 Float（解引用）或浮点字面量（`.rodata`）。
floatAtomToXmm : FGen -> Int -> Ir -> Maybe (List Instr)
floatAtomToXmm st x (IrCast _ _ inner) = floatAtomToXmm st x inner
floatAtomToXmm st x (IrVar b) =
  case lookupBinder b st.fgSlots of
    Just slot =>
      if isFloatBindBinder st b then
        Just [IXmmLoad x (OpMem Rbp (nativeSlotOff slot))]
      else
        Just [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot)), IXmmLoad x (OpMem Rax 0)]
    Nothing => Nothing
floatAtomToXmm st x (IrFloatLit raw) =
  case poolLabelOf raw st.fgFloats of
    Just label => Just [IXmmLoad x (OpRip label)]
    Nothing => Nothing
floatAtomToXmm _ _ _ = Nothing

-- | 浮点比较内联：两个原子实参装进 `xmm0` / `xmm1`，用 `Native.Select` 的序列物化 0/1。
--   不分配、不装箱、不调用；实参不是原子时返回 Nothing（回退运行时）。
floatCmpInline : FGen -> String -> List Ir -> Maybe (List Instr)
floatCmpInline st sym args =
  case floatCompareInstrs sym of
    Nothing => Nothing
    Just tail =>
      case args of
        [a, b] =>
          case (floatAtomToXmm st 0 a, floatAtomToXmm st 1 b) of
            (Just la, Just lb) => Just (cat [la, lb, tail])
            _ => Nothing
        _ => Nothing

-- | 浮点原子 → 指针寄存器（槽里的装箱对象或 `.rodata` 地址），供 floatTree 的
--   无分支选择（`cmov` 指针）使用。拆箱形参的槽不是指针，返回 `Nothing`（选择回退到
--   逐运算内联的装箱路径）。
floatAtomToPtr : FGen -> Reg -> Ir -> Maybe (List Instr)
floatAtomToPtr st r (IrCast _ _ inner) = floatAtomToPtr st r inner
floatAtomToPtr st r (IrVar b) =
  if isFloatBindBinder st b then
    Nothing
  else
    case lookupBinder b st.fgSlots of
      Just slot => Just [IMov (OpReg r) (OpMem Rbp (nativeSlotOff slot))]
      Nothing => Nothing
floatAtomToPtr st r (IrFloatLit raw) =
  case poolLabelOf raw st.fgFloats of
    Just label => Just [ILea r label]
    Nothing => Nothing
floatAtomToPtr _ _ _ = Nothing

-- | 浮点树里的条件选择：`if <浮点比较> then <浮点原子> else <浮点原子>`。
--   比较在 xmm4/xmm5 上做（不占树的 xmm0..3），结果用 `cmov` 选指针后再解引用；
--   没有分支、没有调用，整棵树仍然只装箱一次。
--   实测掩码（`cmpltsd` + `andpd`/`orpd`）版本虽然指令更少、关键路径更短，但在这台
--   机器上把树内的标量指令挤到同一条 FP 端口链上反而慢 ~25%，所以保留 `cmov`。
floatTreeCond : FGen -> List Int -> Ir -> Ir -> Ir -> Maybe (Int, List Instr, List Int)
floatTreeCond st (x :: rest) c t e =
  case c of
    IrRtApp sym args =>
      case floatCompareInstrsAt 4 5 sym of
        Just tail =>
          case args of
            [a, b] =>
              case (floatAtomToXmm st 4 a, floatAtomToXmm st 5 b) of
                (Just la, Just lb) =>
                  case (floatAtomToPtr st Rcx t, floatAtomToPtr st Rdx e) of
                    (Just lt, Just le) =>
                      Just
                        (x, cat [la, lb, tail, [ITest Rax Rax], lt, le, [ICmov "cmovz" Rcx (OpReg Rdx), IXmmLoad x (OpMem Rcx 0)]], rest)
                    _ => Nothing
                _ => Nothing
            _ => Nothing
        Nothing => Nothing
    _ => Nothing
floatTreeCond _ _ _ _ _ = Nothing

-- | `isTail` 表示结果位置。只有「结果就是本函数返回值」的位置才允许尾调用：
--   `IrLet` 的 body、`IrIf` 两支、`IrCase` / `IrNatCase` 各臂、`IrCast` 内层与
--   `IrApp` 是透明位置；实参、scrutinee、构造字段一律按值位置生成。
genExprAt : Int -> FGen -> Bool -> Ir -> NRes (List Instr, FGen)
genExprAt fuel st isTail ir =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case ir of
      IrVar b =>
        case lookupBinder b st.fgSlots of
          Just slot =>
            if isFloatBindBinder st b then
              NOk (boxFloatSlot slot, st)
            else
              let
                instrs = loadSlot slot
              in if memInt slot st.fgDirtySlots && not st.fgAllowDirty then NOk (append instrs [IBinReg "shl" Rax (OpImm 1), IBinReg "sar" Rax (OpImm 1)], st) else NOk (instrs, st)
          Nothing => internal "unbound runtime binder in native codegen"
      IrGlobal name =>
        case findDef name st.fgDefs of
          Nothing => internal "undefined global in native codegen: ${name}"
          Just d => if isCafDef d then NOk ([IMov (OpReg Rax) (OpRip (nativeCafCellLabel name))], st) else if irDefArity d == 0 then if isTail then NOk (tailCallSlotsInstrs (nativeFuncLabel name) [], st) else NOk ([ICall (nativeFuncLabel name)], st) else genValueClosure st (modulePathOf name) (nativeGlobalValueLabel name) (irDefArity d) (nativeFuncLabel name)
      IrInt n => if n < 0 - 4611686018427387903 - 1 || n > 4611686018427387903 then unsupported "native target: integer literal outside the 63-bit range" else NOk ([IMov (OpReg Rax) (OpImm n)], st)
      IrStr s =>
        case poolLabelOf s st.fgPool of
          Nothing => internal "string literal missing from native pool"
          Just label => NOk ([ILea Rax label], st)
      IrBool b => NOk ([IMov (OpReg Rax) (OpImm (if b then 1 else 0))], st)
      IrCast cFrom cTo inner => genExprAt (fuel - 1) st isTail inner
      IrLet bs scrut body =>
        nbind (genExpr (fuel - 1) st scrut) (
            \p =>
              let
                rbs = runtimeBinders bs
                st1 = secondOf p
              in case rbs of
                [] => nbind (genExprAt (fuel - 1) st1 isTail body) (\q => NOk (append (firstOf p) (firstOf q), secondOf q))
                [b] =>
                  let
                    slotP = freshSlot st1
                    slot = firstOf slotP
                    st2 = secondOf slotP
                    st3 = rememberCallee b scrut st2
                  in nbind (genExprAt (fuel - 1) (pushBinderCls b slot (binderCls st1 (Just (valueCls st1 scrut)) b) st3) isTail body) (\q => NOk (append (firstOf p) (append (storeSlot slot) (firstOf q)), restoreBinderScope (secondOf q) st1.fgSlots))
                _ => unsupported "native target: let with more than one runtime binder is not supported yet"
          )
      IrIf c t e =>
        case switchOf (IrIf c t e) of
          Just plan => genSwitch (fuel - 1) st isTail plan
          Nothing =>
            case boolSelectModeOf t e of
              Just mode => nbind (genExpr (fuel - 1) st c) (\p => NOk (append (firstOf p) (boolSelectInstrs mode Rax), secondOf p))
              Nothing =>
                case condBranch st c of
                  Just cb =>
                    let
                      -- 条件是标量比较：直接发 `cmp` + 反向 `jcc`，不再物化 0/1 再 `test`。
                      lElseP = freshLabel st
                      lElse = firstOf lElseP
                      st1 = secondOf lElseP
                      lEndP = freshLabel st1
                      lEnd = firstOf lEndP
                      st2 = secondOf lEndP
                      -- 两个分支各自带上守卫推导出的区间事实；分支结束恢复到外层。
                      thenSt = withThen st2 c
                    in nbind (genExprAt (fuel - 1) thenSt isTail t) (
                        \pt =>
                          nbind (genExprAt (fuel - 1) (withElse (secondOf pt) st c) isTail e) (
                              \pe =>
                                let
                                  body = append (firstOf cb) (append [IJcc (secondOf cb) lElse] (append (firstOf pt) (append [IJmp lEnd, ILabel lElse] (append (firstOf pe) [ILabel lEnd]))))
                                  outSt = { (secondOf pe) | fgRanges = st.fgRanges }
                                in NOk (body, outSt)
                            )
                      )
                  Nothing =>
                    nbind (genExpr (fuel - 1) st c) (
                        \p =>
                          let
                            lElseP = freshLabel (secondOf p)
                            lElse = firstOf lElseP
                            st1 = secondOf lElseP
                            lEndP = freshLabel st1
                            lEnd = firstOf lEndP
                            st2 = secondOf lEndP
                          in nbind (genExprAt (fuel - 1) st2 isTail t) (
                              \pt =>
                                nbind (genExprAt (fuel - 1) (secondOf pt) isTail e) (
                                    \pe =>
                                      let
                                        body = append (firstOf p) (append [ITest Rax Rax, IJcc "je" lElse] (append (firstOf pt) (append [IJmp lEnd, ILabel lElse] (append (firstOf pe) [ILabel lEnd]))))
                                      in NOk (body, secondOf pe)
                                  )
                            )
                      )
      IrCtor family ctor _ args => genCtor (fuel - 1) st family ctor args
      IrRecord family _ fields => genRecord (fuel - 1) st family fields
      IrProj base family field _ => genProj (fuel - 1) st base family field
      IrRecUpd base family fields _ => genRecUpd (fuel - 1) st base family fields
      IrCase caseTy _ scrut alts => genCase (fuel - 1) st isTail caseTy scrut alts
      IrApp _ _ _ => genApp (fuel - 1) st isTail ir
      IrRtApp sym args => genRtApp (fuel - 1) st isTail sym args
      IrConcatMany parts => genConcatMany (fuel - 1) st parts
      IrNatCase scrut _fresh zero succ catch => genNatCase (fuel - 1) st isTail scrut zero succ catch
      IrLam bs _ body => genLamValue (fuel - 1) st bs body
      IrRt sym =>
        let
          arity = rtValueArityOf sym
        in case nativeRtTarget sym of
          Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
          Just label =>
            if arity <= 0 then
              case scalarConstOf sym of
                Just n => NOk ([IMov (OpReg Rax) (OpImm n)], st)
                Nothing => if isTail then NOk (tailCallSlotsInstrs label [], st) else NOk ([ICall label], st)
            else
              genValueClosure st nativeRuntimeModule (nativeRtValueLabel sym) arity label
      IrFloatLit raw => genFloatLit st raw
      IrEffThunk family ctor _unitTy arity prim => genEffThunk (fuel - 1) st family ctor arity prim
      IrTail inner => genExprAt (fuel - 1) st True inner
      IrEffBind _ _ _ => unsupported "native target: effect bindings are not supported yet"

-- `&&` / `||`：短路；a 为 0/1，b 为 Bool。
genBoolChain : Int -> FGen -> List Ir -> Bool -> NRes (List Instr, FGen)
genBoolChain fuel st args isAnd =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case args of
      [a, b] =>
        nbind (genExpr (fuel - 1) st a) (
            \p =>
              let
                lEndP = freshLabel (secondOf p)
                lEnd = firstOf lEndP
                st1 = secondOf lEndP
                cond = if isAnd then "je" else "jne"
              in nbind (genExpr (fuel - 1) st1 b) (\q => NOk (append (firstOf p) (append [ITest Rax Rax, IJcc cond lEnd] (append (firstOf q) [ILabel lEnd])), secondOf q))
          )
      _ => internal "`&&`/`||` must have exactly two arguments"

-- 应用：flatten 左脊，支持饱和顶层调用、`@ir@natSucc`、运行时值函数。
--
-- | 立即应用的 lambda：参数求值到槽后把体就地内联。体内残留的 `IrTail` 是「函数体
--   结果位置」的注解，内联后已不在尾位置，必须用 `IrTail.stripTail` 去掉（只保留嵌套
--   lambda 体里的标记，那是它们自己的函数体）；内联点的尾位置由调用方的 `isTail` 决定。
genLamApp : Int -> FGen -> Bool -> List IrBinder -> List Ir -> Ir -> NRes (List Instr, FGen)
genLamApp fuel st isTail bs args body =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genArgs (fuel - 1) st args) (
        \p =>
          let
            st1 = bindLamArgs (secondOf (secondOf p)) bs args (firstOf (secondOf p))
          in nbind (genExprAt (fuel - 1) st1 isTail (stripTail body)) (\q => NOk (append (firstOf p) (firstOf q), restoreBinderScope (secondOf q) st.fgSlots))
      )

-- | 把已求值到槽的形参绑定进作用域：槽 kind 与「已知被调用者」都跟过来。
bindLamArgs : FGen -> List IrBinder -> List Ir -> List Int -> FGen
bindLamArgs st [] args slots = st
bindLamArgs st (b :: brest) [] slots = st
bindLamArgs st (b :: brest) (a :: arest) [] = st
bindLamArgs st (b :: brest) (a :: arest) (s :: srest) =
  let
    st1 = pushBinderCls b s (binderCls st (Just (valueCls st a)) b) st
    st2 = rememberCallee b a st1
  in bindLamArgs st2 brest arest srest

-- | 记下 binder 的静态已知被调用者（如果有）。
rememberCallee : IrBinder -> Ir -> FGen -> FGen
rememberCallee b value st =
  case knownCalleeOf st.fgDefs st.fgKnown value of
    Just kc => { st | fgKnown = (b.irBinderId, kc) :: st.fgKnown }
    Nothing => st

genApp : Int -> FGen -> Bool -> Ir -> NRes (List Instr, FGen)
genApp fuel st isTail ir =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case flattenApp ir of
      (head, args) =>
        case head of
          IrGlobal name => genGlobalCall (fuel - 1) st isTail name args
          IrLam bs _ body =>
            let
              rbs = runtimeBinders bs
            in if length args > 0 && length rbs == length args then genLamApp (fuel - 1) st isTail rbs args body else genApplyHead (fuel - 1) st isTail head args
          IrRt s =>
            if s == irRtNatSucc then
              case args of
                [a] => genNatSuccCall (fuel - 1) st isTail a
                _ => internal "Nat Succ must have exactly one argument"
            else if s == "prim_erase" || s == "@vuna@prim@toObj" || s == "@vuna@prim@fromObj" then
              case args of
                [] => internal "prim_erase needs an argument"
                x :: rest => genExprAt (fuel - 1) st isTail (Synthetic.applyAllIr x rest)
            else
              genRtValueCall (fuel - 1) st isTail s args
          -- 动态 head：构造点已知（lambda / 顶层函数 / 运行时叶子 / 它们的部分应用）时
          -- 直接调用；其余求值成闭包后交给 `rt_apply`（饱和 / 部分 / 过度统一处理）。
          _ =>
            case knownCalleeOf st.fgDefs st.fgKnown head of
              Just kc => if length args == calleeArity kc then genKnownApply (fuel - 1) st isTail head args kc else genApplyHead (fuel - 1) st isTail head args
              Nothing => genApplyHead (fuel - 1) st isTail head args

-- ---------------------------------------------------------------
-- 闭包
-- ---------------------------------------------------------------
-- 表示（与 wasm 侧同一决策）：闭包 = 堆对象 `[code ptr][captured...]`。
-- 调用约定：`rdi` = 闭包自身（env 基址），实参从 `rsi` 起（第 6 个起压栈）。
-- 捕获策略：只把 body 真正引用到的（含嵌套 lambda 递归可见的）binder 拷进闭包；
-- 没有捕获时闭包是只读常量（`vuna_static_*`），不分配。
closureArgRegs : List Reg
closureArgRegs = [Rsi, Rdx, Rcx, R8, R9]

-- | 表达式引用到的 binder id（含嵌套 lambda 的体：外层闭包必须把内层闭包要用的值
--   一并留在自己的帧里）。只收集身份，不区分绑定层级。
export binderRefsOf : Ir -> List Int
binderRefsOf (IrVar b) = [b.irBinderId]
binderRefsOf (IrTail inner) = binderRefsOf inner
binderRefsOf ir = binderRefsChildren ir

record SwitchPlan where
  swScrut : IrBinder
  swAlts : List (Int, Ir)
  swFallback : Ir

switchOf : Ir -> Maybe SwitchPlan
switchOf (IrIf c t e) =
  case eqTag c of
    Just (v, k) =>
      let
        p = switchCollect v [(k, t)] e
        alts = firstOf p
      in if switchDense alts then Just (SwitchPlan v (reverse alts) (secondOf p)) else Nothing
    Nothing => Nothing
switchOf _ = Nothing

eqTag : Ir -> Maybe (IrBinder, Int)
eqTag (IrRtApp "bi_eq_int" [IrVar v, IrInt k]) = Just (v, k)
eqTag (IrRtApp "bi_eq_int" [IrInt k, IrVar v]) = Just (v, k)
eqTag _ = Nothing

switchCollect : IrBinder -> List (Int, Ir) -> Ir -> (List (Int, Ir), Ir)
switchCollect v acc (ir@(IrIf c t e)) =
  case eqTag c of
    Just (v2, k) =>
      if sameBinderId v v2 && not (memInt k (map firstOf acc)) then
        switchCollect v ((k, t) :: acc) e
      else
        (acc, ir)
    Nothing => (acc, ir)
switchCollect v acc ir = (acc, ir)

switchDense : List (Int, Ir) -> Bool
switchDense alts =
  let
    ks = map firstOf alts
  in if length alts < 4 then
    False
  else if not (memInt 0 ks) then
    False
  else if minList ks < 0 then False else maxList ks <= 2 * length alts + 2

minList : List Int -> Int
minList [] = 0
minList (x :: rest) = minInt2 x (minList rest)

maxList : List Int -> Int
maxList [] = 0
maxList (x :: rest) = maxInt2 x (maxList rest)

genSwitch : Int -> FGen -> Bool -> SwitchPlan -> NRes (List Instr, FGen)
genSwitch fuel st isTail plan =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    let
      span = maxList (map firstOf plan.swAlts)
      count = length plan.swAlts
      lp = allocLabels (count + 3) st
      labels = firstOf lp
      tagLabels = zipTags (map firstOf plan.swAlts) (take count labels)
      tableL = nth count labels
      fbL = nth (count + 1) labels
      endL = nth (count + 2) labels
    in nbind (genExpr (fuel - 1) (secondOf lp) (IrVar plan.swScrut)) (
        \sp =>
          let
            scrutInstrs = firstOf sp
            dispatch = append scrutInstrs [ICmp (OpReg Rax) (OpImm span), IJcc "ja" fbL, ILea R11 tableL, IJmpMem (OpMemS R11 Rax 8), IAlign 3, ILabel tableL]
            table = tableEntries span tagLabels fbL tableL
          in nbind (genSwitchArms (fuel - 1) (secondOf sp) isTail endL plan.swAlts tagLabels) (
              \ap =>
                nbind (genExprAt (fuel - 1) (secondOf ap) isTail plan.swFallback) (
                    \fp =>
                      let
                        body = append dispatch (append table (append (firstOf ap) (append [ILabel fbL] (append (firstOf fp) [ILabel endL]))))
                      in NOk (body, secondOf fp)
                  )
            )
      )

genSwitchArms : Int -> FGen -> Bool -> String -> List (Int, Ir) -> List (Int, String) -> NRes (List Instr, FGen)
genSwitchArms fuel st isTail endL arms tagLabels =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case arms of
      [] => NOk ([], st)
      (k, arm) :: rest =>
        case lookupTagLabel k tagLabels of
          Nothing => internal "switch arm label missing"
          Just l => nbind (genExprAt (fuel - 1) st isTail arm) (\p => nbind (genSwitchArms (fuel - 1) (secondOf p) isTail endL rest tagLabels) (\q => NOk (append [ILabel l] (append (firstOf p) (append [IJmp endL] (firstOf q))), secondOf q)))

tableEntries : Int -> List (Int, String) -> String -> String -> List Instr
tableEntries span tagLabels fbL tableL = tableEntriesList (range 0 (span + 1)) tagLabels fbL tableL

tableEntriesList : List Int -> List (Int, String) -> String -> String -> List Instr
tableEntriesList [] _ _ _ = []
tableEntriesList (i :: rest) tagLabels fbL tableL =
  let
    l =
      case lookupTagLabel i tagLabels of
        Just x => x
        Nothing => fbL
  in IQuadLabel l :: tableEntriesList rest tagLabels fbL tableL

lookupTagLabel : Int -> List (Int, String) -> Maybe String
lookupTagLabel _ [] = Nothing
lookupTagLabel k ((k2, l) :: rest) = if k == k2 then Just l else lookupTagLabel k rest

zipTags : List Int -> List String -> List (Int, String)
zipTags [] _ = []
zipTags _ [] = []
zipTags (k :: ks) (l :: ls) = (k, l) :: zipTags ks ls

allocLabels : Int -> FGen -> (List String, FGen)
allocLabels n st = allocLabelsGo n st []

allocLabelsGo : Int -> FGen -> List String -> (List String, FGen)
allocLabelsGo n st acc =
  if n <= 0 then
    (reverse acc, st)
  else
    let
      p = freshLabel st
    in allocLabelsGo (n - 1) (secondOf p) (firstOf p :: acc)

nth : Int -> List String -> String
nth _ [] = ""
nth n (x :: rest) = if n == 0 then x else nth (n - 1) rest

minInt2 : Int -> Int -> Int
minInt2 a b = if a <= b then a else b

maxInt2 : Int -> Int -> Int
maxInt2 a b = if a >= b then a else b

binderRefsChildren : Ir -> List Int
binderRefsChildren (IrCtor _ _ _ args) = binderRefsList args
binderRefsChildren (IrRecord _ _ fields) = binderRefsFields fields
binderRefsChildren (IrProj base _ _ _) = binderRefsOf base
binderRefsChildren (IrRecUpd base _ fields _) = append (binderRefsOf base) (binderRefsFields fields)
binderRefsChildren (IrRtApp _ args) = binderRefsList args
binderRefsChildren (IrCast _ _ inner) = binderRefsOf inner
binderRefsChildren (IrLet _ scrut body) = append (binderRefsOf scrut) (binderRefsOf body)
binderRefsChildren (IrLam _ _ body) = binderRefsOf body
binderRefsChildren (IrApp _ f a) = append (binderRefsOf f) (binderRefsOf a)
binderRefsChildren (IrIf c t e) = append (binderRefsOf c) (append (binderRefsOf t) (binderRefsOf e))
binderRefsChildren (IrCase _ _ scrut alts) = append (binderRefsOf scrut) (binderRefsAlts alts)
binderRefsChildren (IrNatCase scrut _ zero succ catch) =
  append
    (binderRefsOf scrut)
    (append (binderRefsAlt zero) (append (binderRefsAlt succ) (binderRefsAlt catch)))
binderRefsChildren (IrConcatMany parts) = binderRefsList parts
binderRefsChildren (IrEffThunk _ _ _ _ prim) = binderRefsOf prim
binderRefsChildren _ = []

binderRefsList : List Ir -> List Int
binderRefsList [] = []
binderRefsList (ir :: rest) = append (binderRefsOf ir) (binderRefsList rest)

binderRefsFields : List (String, Ir) -> List Int
binderRefsFields [] = []
binderRefsFields (p :: rest) = append (binderRefsOf (secondOf p)) (binderRefsFields rest)

binderRefsAlts : List IrAlt -> List Int
binderRefsAlts [] = []
binderRefsAlts (alt :: rest) = append (binderRefsOf (irAltBodyOf alt)) (binderRefsAlts rest)

binderRefsAlt : Maybe IrAlt -> List Int
binderRefsAlt Nothing = []
binderRefsAlt (Just alt) = binderRefsOf (irAltBodyOf alt)

-- | 当前作用域里真正被 `body` 引用（含嵌套 lambda）的 binder；顺序与入参一致。
--   闭包只捕获这些值：无捕获时闭包是只读常量，不需要分配。
export captureList : List (IrBinder, Int) -> Ir -> List (IrBinder, Int)
captureList caps body =
  let
    refs = binderRefsOf body
  in filter (capUsed refs) caps

capUsed : List Int -> (IrBinder, Int) -> Bool
capUsed refs (b, _) = memBinderId b.irBinderId refs

memBinderId : Int -> List Int -> Bool
memBinderId _ [] = False
memBinderId id (x :: rest) = if id == x then True else memBinderId id rest

-- | 闭包函数入口：把捕获值从 `[rdi + 8 + 8*i]` 拷进本帧槽并绑定 binder。
--   `parentCls` 是创建处（父帧）的槽 kind 表：捕获值搬过来，kind 也跟过来。
bindCaptures : FGen -> List (Int, NCls) -> List (IrBinder, Int) -> Int -> NRes (List Instr, FGen)
bindCaptures st _ [] _ = NOk ([], st)
bindCaptures st parentCls ((b, src) :: rest) i =
  let
    slotP = freshSlot st
    slot = firstOf slotP
    st1 = pushBinderCls b slot (slotClsAt src parentCls) (secondOf slotP)
    ins =
      [IMov (OpReg Rax) (OpMem Rdi (16 + 8 * i)), IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]
  in nbind
    (bindCaptures st1 parentCls rest (i + 1))
    (\q => NOk (append ins (firstOf q), secondOf q))

storeCloCode : Int -> String -> List Instr
storeCloCode obj label =
  [ILea Rax label, IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpMem Rdx 0) (OpReg Rax)]

storeCloArity : Int -> Int -> List Instr
storeCloArity obj n =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpMem Rdx 8) (OpImm n)]

storeCapsAt : Int -> Int -> List (IrBinder, Int) -> List Instr
storeCapsAt obj i [] = []
storeCapsAt obj i (p :: rest) =
  append (setObjFromSlot obj (16 + 8 * i) (secondOf p)) (storeCapsAt obj (i + 1) rest)

-- | `IrLam` 作为值：生成闭包函数体并构造闭包对象。body 的尾位置由 `IrTail` 标记。
--   只捕获 body 真正引用的 binder：无捕获时闭包是只读常量（`vuna_static_*`），不分配。
genLamValue : Int -> FGen -> List IrBinder -> Ir -> NRes (List Instr, FGen)
genLamValue fuel st bs body =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else if length (runtimeBinders bs) == 0 then
    genExpr (fuel - 1) st body
  else
    let
      rbs = runtimeBinders bs
      -- 同 wasm：env 按「最外层 → 最内层」排，入口 pushBinder 后最内层同名 binder 在表头。
      caps = captureList (reverse st.fgSlots) body
      ncap = length caps
      arity = length rbs
      idx = st.fgNextLabel
      lamName = "vuna_${nativeName st.fgOwner}_lam${strFromInt idx}"
      st1 = { st | fgNextLabel = idx + 1 }
      -- 闭包体自己的来参区由闭包 ABI 决定（`rdi` 是闭包自身，实参从 `rsi` 起）。
      lamRoom = nativeTailRoomBytes (nativeStackArgCount arity (length closureArgRegs))
      stBody = FGen st1.fgDefs st1.fgPool st1.fgFloats [] [] st1.fgFams 0 st1.fgNextLabel [] lamRoom st1.fgModule st1.fgOwner "" "" [] [] [] [] (filterKnown caps st.fgKnown) st1.fgReenter [] [] False
    in nbind (bindCaptures stBody st.fgSlotCls caps 0) (
        \cp =>
          nbind (bindArgsGo rbs 1 (secondOf cp)) (
              \bp =>
                nbind (genExpr (fuel - 1) (secondOf bp) body) (
                    \q =>
                      let
                        stF = secondOf q
                        frame = nativeFrameBytes stF.fgNextSlot
                        lamBody = append (firstOf cp) (append (firstOf bp) (firstOf q))
                        lamPromo = Regs.promoteLoops stF.fgSlotCls (clearDeadSlots stF.fgReenter stF.fgSlotCls (peephole lamBody))
                        lamInstrs = append (cleanup lamPromo.rpBody) (Regs.epilogueOf lamPromo.rpSaved)
                        lamFunc = NativeFunc lamName frame (append (Regs.prologueOf lamPromo.rpSaved) (append (nativePrologueOf frame (unwrittenSlots frame lamInstrs)) lamInstrs)) st.fgModule
                        lams = append st1.fgLams (append stF.fgLams [lamFunc])
                      in if ncap == 0 then
                        let
                          staticLabel = nativeStaticClosureLabel lamName arity
                          st2 = { st1 | fgLams = lams, fgStatics = append st1.fgStatics (append stF.fgStatics [NativeClosure staticLabel lamName arity]) }
                          st3 = { st2 | fgNextLabel = stF.fgNextLabel }
                        in NOk ([ILea Rax staticLabel], st3)
                      else
                        let
                          allocP = genAlloc st1 (2 + ncap)
                          obj = firstOf (secondOf allocP)
                          st2 = secondOf (secondOf allocP)
                          bodyIns = append (firstOf allocP) (append (storeCloCode obj lamName) (append (storeCloArity obj arity) (append (storeCapsAt obj 0 caps) (getLocal obj))))
                          st3 = { st2 | fgLams = lams, fgStatics = append st2.fgStatics stF.fgStatics }
                          -- 闭包函数体里用掉的内部 label 必须回写：否则父函数继续编号会撞名。
                          st4 = { st3 | fgNextLabel = stF.fgNextLabel }
                        in NOk (bodyIns, st4)
                  )
            )
      )

-- ---------------------------------------------------------------
-- data / record
-- ---------------------------------------------------------------
-- 对象布局（与 wasm 侧同一表示决策）：
--   * 变体 = 堆对象：`[obj+0]` = tag（i64），`[obj+8]` 起 = 运行时字段（i64，按最大 arity 补齐）；
--   * record = 堆对象：`[obj+0]` 起就是字段（没有 tag）。
-- 分配走 bump 堆（`rt_alloc`）；对象只写后读，不做初始化。
cat : List (List Instr) -> List Instr
cat xs = concatMap (\x => x) xs

listLengthI : List a -> Int
listLengthI [] = 0
listLengthI (_ :: rest) = 1 + listLengthI rest

setLocal : Int -> List Instr
setLocal slot = [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]

getLocal : Int -> List Instr
getLocal slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot))]

-- | 写对象字段：rax ← 槽 `fromSlot`，rdx ← 对象基址，`[rdx+off]` ← rax。
setObjFromSlot : Int -> Int -> Int -> List Instr
setObjFromSlot obj off fromSlot =
  [
    IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff fromSlot)),
    IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)),
    IMov (OpMem Rdx off) (OpReg Rax)
  ]

setObjImm : Int -> Int -> Int -> List Instr
setObjImm obj off imm =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpMem Rdx off) (OpImm imm)]

getObjField : Int -> Int -> List Instr
getObjField obj off =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpReg Rax) (OpMem Rdx off)]

-- | 分配 `slots` 个 8 字节槽的对象；返回 (分配指令, 对象槽)。
genAlloc : FGen -> Int -> (List Instr, Int, FGen)
genAlloc st slots =
  let
    slotP = freshSlot st
    obj = firstOf slotP
    st1 = secondOf slotP
    instrs =
      [
        IMov (OpReg Rdi) (OpImm (8 * slots)),
        ICall (nativeRtLabel "alloc"),
        IMov (OpMem Rbp (nativeSlotOff obj)) (OpReg Rax)
      ]
  in (instrs, obj, st1)

storeSlotFields : Int -> Int -> List Int -> List Instr
storeSlotFields obj idx [] = []
storeSlotFields obj idx (s :: rest) =
  append (setObjFromSlot obj (8 * idx) s) (storeSlotFields obj (idx + 1) rest)

padObjZero : Int -> Int -> Int -> List Instr
padObjZero obj idx maxIdx = concatMap (\i => setObjImm obj (8 * i) 0) (range idx maxIdx)

-- | 变体构造：分配 `1 + maxArity` 槽；写 tag，按实参顺序写字段，尾部补 0。
genCtor : Int -> FGen -> String -> String -> List Ir -> NRes (List Instr, FGen)
genCtor fuel st family ctor args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case Layout.irDeclOf family st.fgFams of
      Nothing => internal "unknown data family in native codegen: ${family}"
      Just (IrVariantDecl _ _ ctors) => genCtorGo fuel st ctors ctor args
      _ => internal "constructor `${ctor}` does not belong to a variant family: ${family}"

genCtorGo : Int -> FGen -> List (String, List IrTy) -> String -> List Ir -> NRes (List Instr, FGen)
genCtorGo fuel st ctors ctor args =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case Layout.irCtorTagIn ctors ctor of
      Nothing => internal "unknown constructor in native codegen: ${ctor}"
      Just tag =>
        case Layout.irCtorArityIn ctors ctor of
          Nothing => internal "unknown constructor in native codegen: ${ctor}"
          Just n => if listLengthI args /= n then internal "constructor `${ctor}` applied to the wrong number of arguments" else nbind (genArgs (fuel - 1) st args) (\p => genCtorFinish n tag p ctors)

-- | 纯指令拼装（不再递归进 genExpr）：分配 + 写 tag + 写字段 + 补齐。
genCtorFinish : Int -> Int -> (List Instr, List Int, FGen) -> List (String, List IrTy) -> NRes (List Instr, FGen)
genCtorFinish n tag p ctors =
  let
    st = secondOf (secondOf p)
    maxF = Layout.irMaxArityIn ctors
    allocP = genAlloc st (1 + maxF)
    obj = firstOf (secondOf allocP)
    body =
      cat
        [firstOf p, firstOf allocP, setObjImm obj 0 tag, storeSlotFields obj 1 (firstOf (secondOf p)), padObjZero obj (1 + n) (1 + maxF), getLocal obj]
  in NOk (body, secondOf (secondOf allocP))

-- | record 构造：按运行时字段顺序求值后写入新对象。
genRecord : Int -> FGen -> String -> List (String, Ir) -> NRes (List Instr, FGen)
genRecord fuel st family fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case Layout.irDeclOf family st.fgFams of
      Nothing => internal "unknown record family in native codegen: ${family}"
      Just (IrRecordDecl _ _ flds _) => if listLengthI fields /= listLengthI flds then internal "record `${family}` constructed with the wrong number of fields" else nbind (genArgs (fuel - 1) st (map (\p => secondOf p) fields)) (\p => genRecordFinish p flds)
      _ => internal "family `${family}` is not a record"

genRecordFinish : (List Instr, List Int, FGen) -> List (Int, String) -> NRes (List Instr, FGen)
genRecordFinish p flds =
  let
    st = secondOf (secondOf p)
    slots = firstOf (secondOf p)
    allocP = genAlloc st (listLengthI flds)
    obj = firstOf (secondOf allocP)
    body = cat [firstOf p, firstOf allocP, storeSlotFields obj 0 slots, getLocal obj]
  in NOk (body, secondOf (secondOf allocP))

genProj : Int -> FGen -> Ir -> String -> String -> NRes (List Instr, FGen)
genProj fuel st base family field =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case Layout.irDeclOf family st.fgFams of
      Nothing => internal "unknown record family in native codegen: ${family}"
      Just (IrRecordDecl _ _ flds _) =>
        case Layout.irRecordPosOf flds field of
          Nothing => internal "unknown record field in native codegen: `${family}.${field}`"
          Just idx => nbind (genExpr (fuel - 1) st base) (\p => genProjFinish p idx)
      _ => internal "family `${family}` is not a record"

genProjFinish : (List Instr, FGen) -> Int -> NRes (List Instr, FGen)
genProjFinish p idx =
  let
    slotP = freshSlot (secondOf p)
    slot = firstOf slotP
    body = cat [firstOf p, setLocal slot, getObjField slot (8 * idx)]
  in NOk (body, secondOf slotP)

-- | record 更新：分配新对象；逐字段写（被改字段求新值，其余从旧对象复制）。
genRecUpd : Int -> FGen -> Ir -> String -> List (String, Ir) -> NRes (List Instr, FGen)
genRecUpd fuel st base family fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case Layout.irDeclOf family st.fgFams of
      Nothing => internal "unknown record family in native codegen: ${family}"
      Just (IrRecordDecl _ _ flds _) => nbind (genExpr (fuel - 1) st base) (\p => genRecUpdStart fuel (firstOf p) (secondOf p) flds fields)
      _ => internal "family `${family}` is not a record"

genRecUpdStart : Int -> List Instr -> FGen -> List (Int, String) -> List (String, Ir) -> NRes (List Instr, FGen)
genRecUpdStart fuel baseInstrs st flds fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    let
      baseP = freshSlot st
      baseSlot = firstOf baseP
      allocP = genAlloc (secondOf baseP) (listLengthI flds)
      obj = firstOf (secondOf allocP)
    in nbind (genUpdFields (fuel - 1) (secondOf (secondOf allocP)) baseSlot obj 0 flds fields) (\q => NOk (cat [baseInstrs, setLocal baseSlot, firstOf allocP, firstOf q, getLocal obj], secondOf q))

genUpdFields : Int -> FGen -> Int -> Int -> Int -> List (Int, String) -> List (String, Ir) -> NRes (List Instr, FGen)
genUpdFields fuel st baseSlot obj idx flds fields =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case flds of
      [] => NOk ([], st)
      (_, name) :: rest =>
        case lookupFieldIr name fields of
          Just ir =>
            nbind (genExpr (fuel - 1) st ir) (
                \p =>
                  let
                    valP = freshSlot (secondOf p)
                    val = firstOf valP
                  in nbind (genUpdFields (fuel - 1) (secondOf valP) baseSlot obj (idx + 1) rest fields) (\q => NOk (cat [firstOf p, setLocal val, setObjFromSlot obj (8 * idx) val, firstOf q], secondOf q))
              )
          Nothing =>
            let
              srcP = freshSlot st
              src = firstOf srcP
            in nbind (genUpdFields (fuel - 1) (secondOf srcP) baseSlot obj (idx + 1) rest fields) (\q => NOk (cat [getObjField baseSlot (8 * idx), setLocal src, setObjFromSlot obj (8 * idx) src, firstOf q], secondOf q))

lookupFieldIr : String -> List (String, Ir) -> Maybe Ir
lookupFieldIr _ [] = Nothing
lookupFieldIr name (p :: rest) =
  if firstOf p == name then Just (secondOf p) else lookupFieldIr name rest

-- ---------------------------------------------------------------
-- 通用 case
-- ---------------------------------------------------------------
-- | 变体按 tag 分派（线性 compare 链）；record 没有 tag，直接按字段序绑定。
genCase : Int -> FGen -> Bool -> Maybe IrTy -> Ir -> List IrAlt -> NRes (List Instr, FGen)
genCase fuel st isTail caseTy scrut alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genExpr (fuel - 1) st scrut) (
        \p =>
          let
            scP = freshSlotCls (clsOfTy st caseTy) (secondOf p)
            sc = firstOf scP
          in nbind (genCaseAlts (fuel - 1) (secondOf scP) isTail caseTy sc alts) (\q => NOk (cat [firstOf p, setLocal sc, firstOf q], secondOf q))
      )

genCaseAlts : Int -> FGen -> Bool -> Maybe IrTy -> Int -> List IrAlt -> NRes (List Instr, FGen)
genCaseAlts fuel st isTail caseTy sc alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case caseFamilyOf caseTy alts of
      Nothing => genDefault fuel st isTail sc alts
      Just family =>
        case Layout.irDeclOf family st.fgFams of
          Nothing => internal "unknown data family in native codegen: ${family}"
          Just (IrVariantDecl _ _ ctors) => genVariantAlts fuel st isTail sc ctors alts
          Just (IrRecordDecl _ _ _ _) => genRecordAlts fuel st isTail sc alts
          _ => internal "case on an unboxed family is not supported yet"

caseFamilyOf : Maybe IrTy -> List IrAlt -> Maybe String
caseFamilyOf (Just (IrTyData family _)) _ = Just family
caseFamilyOf _ alts = caseFamilyOfAlts alts

caseFamilyOfAlts : List IrAlt -> Maybe String
caseFamilyOfAlts [] = Nothing
caseFamilyOfAlts (alt :: rest) =
  case irAltCtorOf alt of
    Nothing => caseFamilyOfAlts rest
    Just p => Just (firstOf p)

findCatchAll : List IrAlt -> Maybe IrAlt
findCatchAll [] = Nothing
findCatchAll (alt :: rest) =
  case irAltCtorOf alt of
    Nothing => Just alt
    Just _ => findCatchAll rest

trapImpossible : List Instr
trapImpossible = [ICall (nativeRtLabel "trap_impossible")]

genDefault : Int -> FGen -> Bool -> Int -> List IrAlt -> NRes (List Instr, FGen)
genDefault fuel st isTail sc alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case findCatchAll alts of
      Nothing => NOk (trapImpossible, st)
      Just alt => genArm fuel st isTail sc alt

genArm : Int -> FGen -> Bool -> Int -> IrAlt -> NRes (List Instr, FGen)
genArm fuel st isTail sc alt =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case runtimeBinders (irAltBindersOf alt) of
      [] => genExprAt (fuel - 1) st isTail (irAltBodyOf alt)
      [b] =>
        let
          slotP = freshSlot st
          slot = firstOf slotP
        in nbind (genExprAt (fuel - 1) (pushBinderCls b slot (slotClsAt sc st.fgSlotCls) (secondOf slotP)) isTail (irAltBodyOf alt)) (\q => NOk (cat [getLocal sc, setLocal slot, firstOf q], restoreBinderScope (secondOf q) st.fgSlots))
      _ => internal "case arm has more than one runtime binder"

-- | 变体分支链：跳过 catch-all（它只作默认臂），其余按 tag 线性比较。
--   `all` 是原始分支表：链尾必须回到它，才能让 catch-all 兜底（否则嵌套 pattern
--   的兜底分支会被丢掉，运行时掉进 `trap_impossible`）。
genVariantAlts : Int -> FGen -> Bool -> Int -> List (String, List IrTy) -> List IrAlt -> NRes (List Instr, FGen)
genVariantAlts fuel st isTail sc ctors alts =
  let
    -- tag 提到链外一次，之后每个分支只发 `cmp qword ptr [tag-slot], imm`：臂体可能
    -- 改写所有 caller-saved 寄存器，不能把 tag 留在寄存器里。tag 是标量，槽不参与 GC。
    tagP = freshSlotCls NClsScalar st
    tagSlot = firstOf tagP
    setup =
      append
        (getLocal sc)
        (append [IMov (OpReg Rdx) (OpReg Rax), IMov (OpReg Rax) (OpMem Rdx 0)] (storeSlot tagSlot))
  in nbind
    (genVariantAltsGo fuel (secondOf tagP) isTail sc tagSlot ctors alts alts)
    (\q => NOk (append setup (firstOf q), secondOf q))

genVariantAltsGo : Int -> FGen -> Bool -> Int -> Int -> List (String, List IrTy) -> List IrAlt -> List IrAlt -> NRes (List Instr, FGen)
genVariantAltsGo fuel st isTail sc tagSlot ctors alts all =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case alts of
      [] => genDefault (fuel - 1) st isTail sc all
      alt :: rest =>
        case irAltCtorOf alt of
          Nothing => genVariantAltsGo (fuel - 1) st isTail sc tagSlot ctors rest all
          Just (_, ctor) =>
            case Layout.irCtorTagIn ctors ctor of
              Nothing => internal "unknown constructor in native codegen: ${ctor}"
              Just tag =>
                let
                  lNextP = freshLabel st
                  lNext = firstOf lNextP
                  lEndP = freshLabel (secondOf lNextP)
                  lEnd = firstOf lEndP
                in nbind (genVariantArm (fuel - 1) (secondOf lEndP) isTail sc alt) (\a => nbind (genVariantAltsGo (fuel - 1) (secondOf a) isTail sc tagSlot ctors rest all) (\r => NOk (cat [[ICmp (OpMem Rbp (nativeSlotOff tagSlot)) (OpImm tag), IJcc "jne" lNext], firstOf a, [IJmp lEnd, ILabel lNext], firstOf r, [ILabel lEnd]], secondOf r)))

-- | 变体分支：按 keep 形状绑定字段（tag 占 index 0），再求值分支体。
genVariantArm : Int -> FGen -> Bool -> Int -> IrAlt -> NRes (List Instr, FGen)
genVariantArm fuel st isTail sc alt =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind
      (bindFields st sc 1 (runtimeBinders (irAltBindersOf alt)))
      (\bp => nbind (genExprAt (fuel - 1) (secondOf bp) isTail (irAltBodyOf alt)) (\q => NOk (append (firstOf bp) (firstOf q), restoreBinderScope (secondOf q) st.fgSlots)))

bindFields : FGen -> Int -> Int -> List IrBinder -> NRes (List Instr, FGen)
bindFields st _ _ [] = NOk ([], st)
bindFields st sc idx (b :: rest) =
  let
    slotP = freshSlot st
    slot = firstOf slotP
  in nbind
    (bindFields (pushBinderCls b slot (binderCls st Nothing b) (secondOf slotP)) sc (idx + 1) rest)
    (\q => NOk (cat [getObjField sc (8 * idx), setLocal slot, firstOf q], secondOf q))

-- | record 分支只有一个（按字段序绑定）；catch-all 兜底。
genRecordAlts : Int -> FGen -> Bool -> Int -> List IrAlt -> NRes (List Instr, FGen)
genRecordAlts fuel st isTail sc alts =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    case alts of
      [] => genDefault (fuel - 1) st isTail sc []
      alt :: rest =>
        case irAltCtorOf alt of
          Nothing => genDefault (fuel - 1) st isTail sc alts
          Just _ => nbind (bindFields st sc 0 (runtimeBinders (irAltBindersOf alt))) (\bp => nbind (genExprAt (fuel - 1) (secondOf bp) isTail (irAltBodyOf alt)) (\q => NOk (append (firstOf bp) (firstOf q), restoreBinderScope (secondOf q) st.fgSlots)))

genNatArm : Int -> FGen -> Bool -> Maybe IrAlt -> String -> Int -> NRes (List Instr, FGen)
genNatArm _ st _ Nothing _ _ = NOk ([], st)
genNatArm fuel st isTail (Just alt) mode srcSlot =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    let
      bs = runtimeBinders (irAltBindersOf alt)
    in case bs of
      [] => genExprAt (fuel - 1) st isTail (irAltBodyOf alt)
      [b] =>
        if mode == "none" then
          internal "Nat case arm has a binder but no runtime binding"
        else
          let
            slotP = freshSlot st
            slot = firstOf slotP
            st1 = secondOf slotP
            bindInstrs = if mode == "pred" then append (loadSlot srcSlot) [IBin "sub" (OpImm 1)] else loadSlot srcSlot
          in nbind (genExprAt (fuel - 1) (pushBinderCls b slot NClsScalar st1) isTail (irAltBodyOf alt)) (\q => NOk (append bindInstrs (append (storeSlot slot) (firstOf q)), restoreBinderScope (secondOf q) st.fgSlots))
      _ => internal "Nat case arm has more than one runtime binder"

hasNatBranch : Maybe IrAlt -> Maybe IrAlt -> Bool
hasNatBranch (Just _) _ = True
hasNatBranch Nothing (Just _) = True
hasNatBranch Nothing Nothing = False

genNatCase : Int -> FGen -> Bool -> Ir -> Maybe IrAlt -> Maybe IrAlt -> Maybe IrAlt -> NRes (List Instr, FGen)
genNatCase fuel st isTail scrut zero succ catch =
  if fuel <= 0 then
    internal "native codegen fuel exhausted"
  else
    nbind (genExpr (fuel - 1) st scrut) (
        \p =>
          let
            st1 = secondOf p
            slotP = freshSlotCls NClsScalar st1
            slotSc = firstOf slotP
            st2 = secondOf slotP
            lzP = freshLabel st2
            lz = firstOf lzP
            st3 = secondOf lzP
            lendP = freshLabel st3
            lend = firstOf lendP
            st4 = secondOf lendP
            zeroAlt =
              case zero of
                Just z => Just z
                Nothing => catch
            zeroMode =
              case zero of
                Just _ => "none"
                Nothing => "sc"
            succAlt =
              case succ of
                Just s => Just s
                Nothing => catch
            succMode =
              case succ of
                Just _ => "pred"
                Nothing => "sc"
          in if not (hasNatBranch zero catch) then
            internal "Nat case has no zero/catch branch"
          else if not (hasNatBranch succ catch) then
            internal "Nat case has no succ/catch branch"
          else
            nbind (genNatArm (fuel - 1) st4 isTail zeroAlt zeroMode slotSc) (
                \z =>
                  nbind (genNatArm (fuel - 1) (secondOf z) isTail succAlt succMode slotSc) (
                      \s =>
                        let
                          body = append (firstOf p) (append (storeSlot slotSc) (append [ICmp (OpMem Rbp (nativeSlotOff slotSc)) (OpImm 0), IJcc "je" lz] (append (firstOf s) (append [IJmp lend, ILabel lz] (append (firstOf z) [ILabel lend])))))
                        in NOk (body, secondOf s)
                    )
              )
      )

-- ---------------------------------------------------------------
-- 定义
-- -----------------------------------------------------------
bindArgs : List IrBinder -> FGen -> NRes (List Instr, FGen)
bindArgs bs st = bindArgsGo bs 0 st

slotsOfBinders : List IrBinder -> List (IrBinder, Int) -> List Int
slotsOfBinders [] _ = []
slotsOfBinders (b :: rest) slots =
  case lookupBinder b slots of
    Just slot => slot :: slotsOfBinders rest slots
    Nothing => slotsOfBinders rest slots

-- | 绑定形参：前 6 个来自参数寄存器，其余来自调用方压栈（`[rbp+16]` 起）。
bindArgsGo : List IrBinder -> Int -> FGen -> NRes (List Instr, FGen)
bindArgsGo [] _ st = NOk ([], st)
bindArgsGo (b :: rest) i st =
  let
    src =
      case argRegAt i of
        Just reg => [IMov (OpReg Rax) (OpReg reg)]
        Nothing => [IMov (OpReg Rax) (OpMem Rbp (nativeStackArgOff i))]
    slotP = freshSlot st
    slot = firstOf slotP
    st1 = secondOf slotP
    store =
      if isFloatBindBinder st b then
        append src [IXmmLoad 0 (OpMem Rax 0), IXmmStore (OpMem Rbp (nativeSlotOff slot)) 0]
      else
        append src [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]
  in nbind
    (bindArgsGo rest (i + 1) (pushBinderCls b slot (binderCls st Nothing b) st1))
    (\q => NOk (append store (firstOf q), secondOf q))

-- ---------------------------------------------------------------
-- 零参运行时别名解析
-- ---------------------------------------------------------------
-- | `Nat.plus = natAdd` 这类零参别名在应用位置直接改写成运行时叶子应用，
--   让标量树（以及后续内联）看到 `IrRtApp`；实参顺序与求值顺序保持原样。
resolveDefAliases : List IrDef -> IrDef -> IrDef
resolveDefAliases defs (IrDef nm ar deps ty body recOk guard span) =
  IrDef nm ar deps ty (resolveAliasIn (64 + 4 * irSize body) defs body) recOk guard span
resolveDefAliases _ d = d

resolveAliasIn : Int -> List IrDef -> Ir -> Ir
resolveAliasIn fuel defs ir = if fuel <= 0 then ir else resolveAliasStep (fuel - 1) defs ir

resolveAliasStep : Int -> List IrDef -> Ir -> Ir
resolveAliasStep fuel defs (ir@(IrApp _ _ _)) =
  let
    p = flattenApp ir
    head = resolveAliasIn fuel defs (firstOf p)
    args = map (resolveAliasIn fuel defs) (secondOf p)
  in case head of
    IrGlobal name =>
      case Alias.irAliasTargetOf 8 defs name of
        Just (Alias.IrAliasRt sym) =>
          if length args == irInlineArity sym then
            IrRtApp sym args
          else
            Synthetic.applyAllIr head args
        _ => Synthetic.applyAllIr head args
    _ => Synthetic.applyAllIr head args
resolveAliasStep fuel defs (IrCtor f c ty args) =
  IrCtor f c ty (map (resolveAliasIn fuel defs) args)
resolveAliasStep fuel defs (IrRecord f ty fields) =
  IrRecord f ty (map (\p => (firstOf p, resolveAliasIn fuel defs (secondOf p))) fields)
resolveAliasStep fuel defs (IrProj base f fld ty) = IrProj (resolveAliasIn fuel defs base) f fld ty
resolveAliasStep fuel defs (IrRecUpd base f fields ty) =
  IrRecUpd
    (resolveAliasIn fuel defs base)
    f
    (map (\p => (firstOf p, resolveAliasIn fuel defs (secondOf p))) fields)
    ty
resolveAliasStep fuel defs (IrRtApp sym args) = IrRtApp sym (map (resolveAliasIn fuel defs) args)
resolveAliasStep fuel defs (IrCast a b inner) = IrCast a b (resolveAliasIn fuel defs inner)
resolveAliasStep fuel defs (IrLet bs s0 b) =
  IrLet bs (resolveAliasIn fuel defs s0) (resolveAliasIn fuel defs b)
resolveAliasStep fuel defs (IrLam bs ty b) = IrLam bs ty (resolveAliasIn fuel defs b)
resolveAliasStep fuel defs (IrTail inner) = IrTail (resolveAliasIn fuel defs inner)
resolveAliasStep fuel defs (IrIf c t e) =
  IrIf (resolveAliasIn fuel defs c) (resolveAliasIn fuel defs t) (resolveAliasIn fuel defs e)
resolveAliasStep fuel defs (IrCase ty rty scrut alts) =
  IrCase ty rty (resolveAliasIn fuel defs scrut) (map (resolveAlt fuel defs) alts)
resolveAliasStep fuel defs (IrNatCase scrut fresh z s0 c) =
  IrNatCase
    (resolveAliasIn fuel defs scrut)
    fresh
    (resolveAltM fuel defs z)
    (resolveAltM fuel defs s0)
    (resolveAltM fuel defs c)
resolveAliasStep fuel defs (IrConcatMany parts) =
  IrConcatMany (map (resolveAliasIn fuel defs) parts)
resolveAliasStep fuel defs (IrEffThunk f c ty ar prim) =
  IrEffThunk f c ty ar (resolveAliasIn fuel defs prim)
resolveAliasStep _ _ (IrEffBind f c ty) = IrEffBind f c ty
resolveAliasStep _ _ ir = ir

resolveAlt : Int -> List IrDef -> IrAlt -> IrAlt
resolveAlt fuel defs alt =
  IrAlt alt.irAltCtor alt.irAltBinders (resolveAliasIn (fuel - 1) defs alt.irAltBody)

resolveAltM : Int -> List IrDef -> Maybe IrAlt -> Maybe IrAlt
resolveAltM _ _ Nothing = Nothing
resolveAltM fuel defs (Just a) = Just (resolveAlt fuel defs a)

-- ---------------------------------------------------------------
-- 自递归循环体旋转
-- ---------------------------------------------------------------
-- `if cond then exit else self-call` 的朴素布局每轮在末尾 `jmp` 回循环头，再在头部
-- 做条件分支（两次跳转）。旋转后：入口跳到条件检查，循环体落在条件检查之前，回边是
-- 条件分支本身——每轮只剩一次分支。
record LoopRot where
  lrCond : Ir
  lrBody : Ir
  lrExit : Ir
  lrBodyIsElse : Bool

selfTailOf : String -> Ir -> Bool
selfTailOf name ir =
  case flattenApp (stripTail ir) of
    (IrGlobal n, _) => n == name
    _ => False

loopRotateOf : String -> Ir -> Maybe LoopRot
loopRotateOf name (IrIf c t e) =
  if selfTailOf name e && not (selfTailOf name t) then
    Just (LoopRot c e t True)
  else if selfTailOf name t && not (selfTailOf name e) then Just (LoopRot c t e False) else Nothing
loopRotateOf _ _ = Nothing

dropLastSelfJump : String -> List Instr -> Maybe (List Instr)
dropLastSelfJump _ [] = Nothing
dropLastSelfJump label (i :: rest) =
  case rest of
    [] =>
      case i of
        IJmp l => if l == label then Just [] else Nothing
        _ => Nothing
    _ =>
      case dropLastSelfJump label rest of
        Just r => Just (i :: r)
        Nothing => Nothing

genLoopBody : Int -> FGen -> Ir -> String -> String -> NRes (List Instr, FGen)
genLoopBody fuel st inner name loopLabel =
  case loopRotateOf name inner of
    Nothing => genExpr fuel st inner
    Just rot =>
      case condBranch st rot.lrCond of
        Nothing => genExpr fuel st inner
        Just cb =>
          let
            lbP = freshLabel st
            lb = firstOf lbP
            st1 = secondOf lbP
            lcP = freshLabel st1
            lc = firstOf lcP
            st2 = secondOf lcP
            bodySt =
              if rot.lrBodyIsElse then withElse st2 st rot.lrCond else withThen st2 rot.lrCond
          in nbind (genExprAt (fuel - 1) bodySt True rot.lrBody) (
              \pb =>
                let
                  bodyInstrs =
                    case dropLastSelfJump loopLabel (firstOf pb) of
                      Just is => is
                      Nothing => firstOf pb
                  exitBase = { (secondOf pb) | fgRanges = st.fgRanges }
                  exitSt = if rot.lrBodyIsElse then withThen exitBase rot.lrCond else withElse exitBase st rot.lrCond
                in nbind (genExprAt (fuel - 1) exitSt True rot.lrExit) (
                    \pe =>
                      let
                        body = append [IJmp lc, ILabel lb] (append bodyInstrs (append [ILabel lc] (append (firstOf cb) (append [IJcc (secondOf cb) lb] (firstOf pe)))))
                      in NOk (body, { (secondOf pe) | fgRanges = st.fgRanges })
                  )
            )

-- | 生成一个定义；返回函数与该定义之后**模块内** label/slot 计数（`.L` 是文件局部
--   符号，计数按模块保存；重编号不会跨模块扩散）。
genDefFunc : List IrDef -> List (String, List (String, String)) -> List (String, List (String, String)) -> List String -> List String -> List IrTyDecl -> Int -> IrDef -> NRes (List NativeFunc, Int, List NativeClosure)
genDefFunc _defs _pools _floats _recNames _allocs _fams _nextLabel (IrExternDef name _ _ _) =
  unsupported "native target: extern definition `${name}` is not supported yet"
genDefFunc defs pools floats recNames allocs fams nextLabel (IrDef name arity _ _ body _ _ _) =
  let
    -- 本函数来参区：零参定义没有调用者压的栈实参，其余按标准 ABI 推算。
    room = nativeTailRoomBytes (nativeStackArgCount arity nativeMaxArgs)
    modPath = modulePathOf name
    pool = modulePoolOf (moduleKeyOf name) pools
    fpool = modulePoolOf (moduleKeyOf name) floats
    st0 =
      FGen
        defs
        pool
        fpool
        []
        []
        fams
        0
        nextLabel
        []
        room
        modPath
        name
        ""
        ""
        []
        []
        []
        []
        []
        (memStr name recNames)
        []
        []
        False
  in if arity == 0 then
    nbind (genExpr (nativeFuelOfBody body) st0 body) (
        \p =>
          let
            st1 = secondOf p
            frame = nativeFrameBytes st1.fgNextSlot
            promo = Regs.promoteLoops st1.fgSlotCls (clearDeadSlots st1.fgReenter st1.fgSlotCls (peephole (firstOf p)))
            instrs = append (cleanup promo.rpBody) (Regs.epilogueOf promo.rpSaved)
            holes = if memStr name allocs && frameReused st1.fgReenter instrs then unwrittenSlots frame instrs else []
            mainF = NativeFunc (nativeFuncLabel name) frame (append (Regs.prologueOf promo.rpSaved) (append (nativePrologueOf frame holes) instrs)) modPath
          in NOk (append st1.fgLams [mainF], st1.fgNextLabel, st1.fgStatics)
      )
  else
    case body of
      IrLam bs _ inner =>
        let
          rbs = runtimeBinders bs
          -- 浮点形参拆箱：槽里存 raw `f64` 位。浮点运算读点直接 `movsd` 进 xmm，
          -- 逃逸读点先装盒；写点只有来参落位与自递归尾调用写回。
          stB0 = { st0 | fgFloatBinds = concatMap (\b => if isFloatParamBinder st0 b then [binderIdOf b] else []) rbs }
        in if length rbs /= arity then
          internal "function body lambda arity mismatch: ${name}"
        else
          nbind (bindArgs rbs stB0) (
              \bp =>
                let
                  stB = secondOf bp
                  loopP = freshLabel stB
                  loopLabel = firstOf loopP
                  stLoop = { (secondOf loopP) | fgSelfLabel = nativeFuncLabel name, fgSelfLoop = loopLabel, fgSelfParams = slotsOfBinders rbs stB.fgSlots, fgSelfBinds = rbs, fgDirtySlots = slotsOfBinders (filter (\b => memInt (binderIdOf b) (Dirty.dirtyParamIds name rbs inner) && not (isFloatBindBinder stB b)) rbs) stB.fgSlots }
                in nbind (genLoopBody (nativeFuelOfBody inner) stLoop inner name loopLabel) (
                    \q =>
                      let
                        st1 = secondOf q
                        frame = nativeFrameBytes st1.fgNextSlot
                        body0 = append (firstOf bp) (append [ILabel loopLabel] (firstOf q))
                        promo = Regs.promoteLoops st1.fgSlotCls (clearDeadSlots st1.fgReenter st1.fgSlotCls (peephole body0))
                        instrs = append (cleanup promo.rpBody) (Regs.epilogueOf promo.rpSaved)
                        holes = if memStr name allocs && frameReused st1.fgReenter instrs then unwrittenSlots frame instrs else []
                        mainF = NativeFunc (nativeFuncLabel name) frame (append (Regs.prologueOf promo.rpSaved) (append (nativePrologueOf frame holes) instrs)) modPath
                      in NOk (append st1.fgLams [mainF], st1.fgNextLabel, st1.fgStatics)
                  )
            )
      _ => internal "function body is not a lambda: ${name}"

-- | 每个模块的 `.L` 编号计数（`.L` 是文件局部符号，编号在模块内累加；同一模块的定义可能
--   在可达性顺序里不连续，所以计数必须按模块保存而不是靠「上一个定义」判断）。
labelCountOf : String -> List (String, Int) -> Int
labelCountOf _ [] = 0
labelCountOf key (p :: rest) = if firstOf p == key then secondOf p else labelCountOf key rest

putLabelCount : String -> Int -> List (String, Int) -> List (String, Int)
putLabelCount key n [] = [(key, n)]
putLabelCount key n (p :: rest) =
  if firstOf p == key then (key, n) :: rest else p :: putLabelCount key n rest

genDefs : List IrDef -> List (String, List (String, String)) -> List (String, List (String, String)) -> List String -> List String -> List IrTyDecl -> List (String, Int) -> List IrDef -> List (List NativeFunc) -> List NativeClosure -> NRes (List NativeFunc, Int, List NativeClosure)
genDefs _all _pools _floats _recNames _allocs _fams _labels [] acc statAcc =
  NOk (concatMap (\x => x) (reverse acc), 0, statAcc)
genDefs all pools floats recNames allocs fams labels (d :: rest) acc statAcc =
  let
    key = moduleKeyOf (irDefName d)
    start = labelCountOf key labels
  in nbind (genDefFunc all pools floats recNames allocs fams start d) (
      \p =>
        let
          next = firstOf (secondOf p)
          statics = secondOf (secondOf p)
        in genDefs all pools floats recNames allocs fams (putLabelCount key next labels) rest (firstOf p :: acc) (append statics statAcc)
    )

-- | 不会分配堆的运行时符号（整数 / 位运算 / 比较 / 字符串只读 / obs / 打印 / 陷阱）。
--   名单之外的符号一律按「可能分配」处理：`Native.Live.unwrittenSlots` 的清零只在
--   **传递闭包里可能分配**的函数上发，判错方向是多清零（只多花几条 store），不会漏。
pureRtLabels : List String
pureRtLabels =
  [
    nativeRtLabel "add",
    nativeRtLabel "sub",
    nativeRtLabel "mul",
    nativeRtLabel "div",
    nativeRtLabel "bit_and",
    nativeRtLabel "bit_or",
    nativeRtLabel "bit_xor",
    nativeRtLabel "bit_not",
    nativeRtLabel "bit_shl",
    nativeRtLabel "bit_shr",
    nativeRtLabel "eq_int",
    nativeRtLabel "neq_int",
    nativeRtLabel "lt_int",
    nativeRtLabel "le_int",
    nativeRtLabel "gt_int",
    nativeRtLabel "ge_int",
    nativeRtLabel "nat_add",
    nativeRtLabel "nat_sub",
    nativeRtLabel "nat_mul",
    nativeRtLabel "nat_div",
    nativeRtLabel "nat_from_int",
    nativeRtLabel "str_length",
    nativeRtLabel "str_at",
    nativeRtLabel "str_hash",
    nativeRtLabel "str_eq",
    nativeRtLabel "str_neq",
    nativeRtLabel "str_lt",
    nativeRtLabel "str_le",
    nativeRtLabel "str_gt",
    nativeRtLabel "str_ge",
    nativeRtLabel "obs_level",
    nativeRtLabel "obs_counter",
    nativeRtLabel "obs_mark",
    nativeRtLabel "obs_span_begin",
    nativeRtLabel "obs_span_end",
    nativeRtLabel "obs_sample_start",
    nativeRtLabel "obs_sample_stop",
    nativeRtLabel "log_on",
    nativeRtLabel "log_emit",
    nativeRtLabel "effect_id",
    nativeRtLabel "print_int",
    nativeRtLabel "print_bool",
    nativeRtLabel "print_str",
    nativeRtLabel "assert",
    nativeRtLabel "prim_fail",
    nativeRtLabel "todo",
    nativeRtLabel "trap_msg",
    nativeRtLabel "trap_assert",
    nativeRtLabel "trap_todo",
    nativeRtLabel "trap_divzero",
    nativeRtLabel "trap_array_oob",
    nativeRtLabel "trap_impossible",
    nativeRtLabel "trap_oom",
    nativeRtLabel "trap_mem_limit"
  ]

rtMayAllocate : String -> Bool
rtMayAllocate sym =
  case nativeRtTargetBase sym of
    Just label => not (memStr label pureRtLabels)
    Nothing => True

-- | 一个 IR 项是否会分配（`IrGlobal` 的传递性交给依赖闭包补，这里只看本项）。
irMayAllocate : Ir -> Bool
irMayAllocate (IrCtor _ _ _ _) = True
irMayAllocate (IrRecord _ _ _) = True
irMayAllocate (IrRecUpd _ _ _ _) = True
irMayAllocate (IrConcatMany _) = True
irMayAllocate (IrEffThunk _ _ _ _ _) = True
irMayAllocate (IrEffBind _ _ _) = True
irMayAllocate (IrLam _ _ _) = True
irMayAllocate (IrRt sym) = rtMayAllocate sym
irMayAllocate (IrRtApp sym args) = rtMayAllocate sym || anyMayAllocate args
irMayAllocate (IrApp _ head arg) = appMayAllocate head || irMayAllocate arg
irMayAllocate (IrLet _ scrut body) = irMayAllocate scrut || irMayAllocate body
irMayAllocate (IrIf c t e) = irMayAllocate c || irMayAllocate t || irMayAllocate e
irMayAllocate (IrCase _ _ scrut alts) = irMayAllocate scrut || anyMayAllocateAlts alts
irMayAllocate (IrNatCase scrut _ z s c) =
  irMayAllocate scrut || mayAllocateAltM z || mayAllocateAltM s || mayAllocateAltM c
irMayAllocate (IrProj base _ _ _) = irMayAllocate base
irMayAllocate (IrCast _ _ inner) = irMayAllocate inner
irMayAllocate (IrTail inner) = irMayAllocate inner
irMayAllocate _ = False

appMayAllocate : Ir -> Bool
appMayAllocate (IrGlobal _) = False
appMayAllocate (IrRt sym) = rtMayAllocate sym
appMayAllocate _ = True

anyMayAllocate : List Ir -> Bool
anyMayAllocate [] = False
anyMayAllocate (x :: rest) = if irMayAllocate x then True else anyMayAllocate rest

anyMayAllocateAlts : List IrAlt -> Bool
anyMayAllocateAlts [] = False
anyMayAllocateAlts (a :: rest) = if irMayAllocate a.irAltBody then True else anyMayAllocateAlts rest

mayAllocateAltM : Maybe IrAlt -> Bool
mayAllocateAltM Nothing = False
mayAllocateAltM (Just a) = irMayAllocate a.irAltBody

defMayAllocateDirectly : IrDef -> Bool
defMayAllocateDirectly d =
  case irDefBody d of
    Nothing => False
    Just (IrLam _ _ inner) => irMayAllocate inner
    Just other => irMayAllocate other

-- | 传递闭包里可能分配的定义名。帧里的「从不写的槽」只有这类函数需要在 prologue
--   清 0：GC 只在分配点发生，闭包里不分配的函数其帧永远不会被扫到。
allocatingDefNames : List IrDef -> List String
allocatingDefNames defs =
  map
    irDefName
    (reachableDefsByRefs (\_ => True) 0 (map irDefName (filter defMayAllocateDirectly defs)) defs)

-- | 递归 SCC 里的定义名（`unit` 的分组由 Lowering 的 SCC 给出）。死槽清零只在
--   这类帧上付产物成本：非尾递归时每层帧都活着，死槽会一路钉住对象。
recursiveDefNames : IrUnit -> List String
recursiveDefNames unit =
  concatMap (\g => if irGroupIsRec g then map irDefName (irGroupDefs g) else []) unit.irUnitGroups

-- | 按标签去重（函数值 wrapper 可能被多个定义分别登记；同标签体相同）。
dedupeFuncs : List NativeFunc -> List NativeFunc
dedupeFuncs [] = []
dedupeFuncs (f :: rest) =
  if hasFuncLabel (nativeFuncLabelOf f) rest then dedupeFuncs rest else f :: dedupeFuncs rest

dedupeClosures : List NativeClosure -> List NativeClosure
dedupeClosures [] = []
dedupeClosures (c :: rest) =
  if hasNativeClosure c.ncLabel rest then dedupeClosures rest else c :: dedupeClosures rest

-- ---------------------------------------------------------------
-- 入口初始化裁剪
-- ---------------------------------------------------------------
-- `_start` 只为程序用得到的子系统发初始化调用：
--
--   * 堆 / GC / 内存预算：可达代码里出现分配器（`alloc` / `alloc_leaf`）或直接
--     碰堆指针时才有；
--   * 自带栈：可达函数图里有**真递归**（`call` 边上的环）或间接调用/跳转
--     （闭包调用、续延恢复）时才有——尾调用是 `jmp`，不涨栈，不算；
--   * 核数（亲和性）：可达代码里出现子进程原语时才有（子进程继承亲和性）。
--
-- `init_timeout` 总是发：`VUNA_NATIVE_TIMEOUT_MS` 是对任何程序的兜底。
-- 判定只看已发射的指令：运行时函数若新增分配 / spawn 调用，会被自动算进来。
-- 同一 IR 的产物仍然逐字节确定（判定不读 env）。
export record InitNeeds(..) where
  inHeap : Bool
  inStack : Bool
  inCpus : Bool

-- | 操作数里的标签引用（`[rip + label]`）。
operandLabelRefs : Operand -> List String
operandLabelRefs (OpRip l) = [l]
operandLabelRefs _ = []

-- | 指令里的标签引用。`ILabel` 是定义不是引用；间接调用 / 跳转没有标签。
instrLabelRefs : Instr -> List String
instrLabelRefs (IMov dst src) = append (operandLabelRefs dst) (operandLabelRefs src)
instrLabelRefs (IMovByteOp op _) = operandLabelRefs op
instrLabelRefs (IMovByteRegOp op _) = operandLabelRefs op
instrLabelRefs (IMovzx _ src) = operandLabelRefs src
instrLabelRefs IMovzxAl = []
instrLabelRefs (ILea _ l) = [l]
instrLabelRefs (ILeaMem _ _ _) = []
instrLabelRefs (ILeaScale _ _ _ _) = []
instrLabelRefs (ITrunc32 _) = []
instrLabelRefs (IBin _ src) = operandLabelRefs src
instrLabelRefs (IBinReg _ _ src) = operandLabelRefs src
instrLabelRefs (ICmp a b) = append (operandLabelRefs a) (operandLabelRefs b)
instrLabelRefs (ICmov _ _ src) = operandLabelRefs src
instrLabelRefs (ITest _ _) = []
instrLabelRefs (ISetcc _ _) = []
instrLabelRefs (INeg _) = []
instrLabelRefs ICqo = []
instrLabelRefs (IDiv _) = []
instrLabelRefs (IDivUnsigned _) = []
instrLabelRefs (IMulSigned _) = []
instrLabelRefs IRepMovsb = []
instrLabelRefs IRepeCmpsb = []
instrLabelRefs (ILabel _) = []
instrLabelRefs (IJmp l) = [l]
instrLabelRefs (IJmpReg _) = []
instrLabelRefs (IJcc _ l) = [l]
instrLabelRefs (ICall l) = [l]
instrLabelRefs (ICallReg _) = []
instrLabelRefs (IXmmLoad _ op) = operandLabelRefs op
instrLabelRefs (IXmmBinMem _ _ op) = operandLabelRefs op
instrLabelRefs (IXmmStore op _) = operandLabelRefs op
instrLabelRefs (IXmmFromInt _ _) = []
instrLabelRefs (IXmmToInt _ _) = []
instrLabelRefs (IXmmBin _ _ _) = []
instrLabelRefs (IXmmUnop _ _) = []
instrLabelRefs (IXmmCmp _ _) = []
instrLabelRefs (IXmmToReg _ _) = []
instrLabelRefs (IXmmFromReg _ _) = []
instrLabelRefs IRet = []
instrLabelRefs ISyscall = []
instrLabelRefs (IPush _) = []
instrLabelRefs (IPop _) = []
instrLabelRefs (IQuadLabel l) = [l]
instrLabelRefs (IJmpMem op) = operandLabelRefs op
instrLabelRefs (IAlign _) = []
instrLabelRefs INop = []

-- | 指令里的 `call` 边（尾调用是 `jmp`，不涨栈，不算）。
instrCallRefs : Instr -> List String
instrCallRefs (ICall l) = [l]
instrCallRefs _ = []

-- | 间接调用 / 跳转（闭包调用、续延恢复）：帧深度无法静态界定。
instrIndirect : Instr -> Bool
instrIndirect (ICallReg _) = True
instrIndirect (IJmpReg _) = True
instrIndirect (IJmpMem _) = True
instrIndirect _ = False

funcLabelRefs : NativeFunc -> List String
funcLabelRefs f = concatMap instrLabelRefs f.nfBody

funcCallRefs : NativeFunc -> List String
funcCallRefs f = concatMap instrCallRefs f.nfBody

funcHasIndirect : NativeFunc -> Bool
funcHasIndirect f = foldl (\acc, i => acc || instrIndirect i) False f.nfBody

funcsWithLabelIn : List NativeFunc -> List String -> List NativeFunc
funcsWithLabelIn funcs known = filter (\f => memName (nativeFuncLabelOf f) known) funcs

-- | 从种子标签出发，沿指令里的标签引用做不动点；每轮至少多一个函数标签，
-- 因此轮数以函数个数为界（`fuel` 再留一格）。
reachFuncLabelsFuel : Int -> List NativeFunc -> List String -> List String
reachFuncLabelsFuel fuel funcs known =
  if fuel <= 0 then
    known
  else
    let
      refs = concatMap funcLabelRefs (funcsWithLabelIn funcs known)
      next = nubNames (append known refs)
    in if length next == length known then known else reachFuncLabelsFuel (fuel - 1) funcs next

export reachFuncLabels : List NativeFunc -> List String -> List String
reachFuncLabels funcs seeds = reachFuncLabelsFuel (length funcs + 2) funcs (nubNames seeds)

-- | `l` 能否沿 `call` 边（再沿普通引用展开）回到自己。
reachesItself : List NativeFunc -> String -> Bool
reachesItself funcs l =
  let
    seeds = concatMap funcCallRefs (funcsWithLabelIn funcs [l])
  in memName l (reachFuncLabels funcs seeds)

hasCallCycle : List NativeFunc -> List String -> Bool
hasCallCycle funcs labels = foldl (\acc, l => acc || reachesItself funcs l) False labels

-- | 直接碰堆指针（内联 bump）也算分配。
touchesHeapPtr : NativeFunc -> Bool
touchesHeapPtr f = anyMem ["rt_heap_ptr", "rt_arena_end"] (funcLabelRefs f)

anyFuncIndirect : List NativeFunc -> Bool
anyFuncIndirect funcs = foldl (\acc, f => acc || funcHasIndirect f) False funcs

-- | 由可达集合推初始化需求。分配器 / 子进程原语用标签判定；堆指针的**直接**
-- 读写（内联 bump）也按分配算，防止绕过分配器。
export initNeeds : List NativeFunc -> List String -> InitNeeds
initNeeds funcs live =
  let
    liveFuncs = funcsWithLabelIn funcs live
  in InitNeeds
    (anyMem ["rt_alloc", "rt_alloc_leaf"] live || foldl (\acc, f => acc || touchesHeapPtr f) False liveFuncs)
    (hasCallCycle funcs live || anyFuncIndirect liveFuncs)
    (anyMem ["rt_spawn_exec", "rt_cmd_run_sh", "rt_wait_pid", "rt_child_push", "rt_child_drop", "rt_env_filter"] live)

-- ---------------------------------------------------------------
-- 入口
-- -----------------------------------------------------------
entryShowKind : Ir -> Maybe String
entryShowKind (IrRt s) =
  case s of
    "@ir@showInt" => Just "int"
    "@ir@showNat" => Just "int"
    "@ir@showBool" => Just "bool"
    "@ir@showStr" => Just "str"
    "@ir@showFloat" => Just "float"
    _ => Nothing
entryShowKind _ = Nothing

startFunc : Bool -> String -> String -> Maybe String -> List String -> List String -> InitNeeds -> NativeFunc
startFunc printResult kind mainName runMainM handlers cafs needs =
  let
    -- 初始栈：`[rsp]=argc`、`[rsp+8]=argv[0]…`、`argv+8*(argc+1)=envp[0]…`。
    -- 必须在 `and rsp,-16` 之前取。
    captureArgs =
      [
        IMov (OpReg Rax) (OpMem Rsp 0),
        IMov (OpRip argcLabel) (OpReg Rax),
        IBinReg "add" Rax (OpImm 1),
        IBinReg "shl" Rax (OpImm 3),
        ILeaMem Rcx Rsp 8,
        IMov (OpRip argvLabel) (OpReg Rcx),
        IBinReg "add" Rcx (OpReg Rax),
        IMov (OpRip envpLabel) (OpReg Rcx)
      ]
    initHeap =
      if not needs.inHeap then
        []
      else
        [
          ILea Rax nativeHeapSegLabel,
          ILea Rdx nativeHeapLabel,
          IMov (OpReg Rcx) (OpImm 0),
          IMov (OpMem Rax 0) (OpReg Rcx),
          IMov (OpMem Rax 24) (OpReg Rcx),
          ILea Rcx nativeHeapCardsLabel,
          IMov (OpMem Rax 32) (OpReg Rcx),
          IMov (OpRip nativeSegsLabel) (OpReg Rax),
          IMov (OpRip nativeCurSegLabel) (OpReg Rax),
          IMov (OpReg Rcx) (OpReg Rdx),
          IBinReg "add" Rcx (OpImm nativeHeapBytes),
          IMov (OpMem Rax 8) (OpReg Rcx),
          IMov (OpMem Rax 16) (OpReg Rdx),
          IMov (OpRip nativeArenaEndLabel) (OpReg Rcx),
          IMov (OpRip nativeHeapPtrLabel) (OpReg Rdx),
          ICall (nativeRtLabel "seg_index_init")
        ]
    -- 运行时初始化：自带栈（默认 512 MiB 虚拟，独立于 `ulimit -s`）、内存预算 /
    -- auto 核数 / 超时（其余全部来自 env，不进 codegen）。只发程序用得到的部分；
    -- 超时是任何程序都适用的兜底，总是发。
    initStackInstrs =
      if not needs.inStack then
        []
      else
        [
          IBinReg "and" Rsp (OpImm (0 - 16)),
          ICall (nativeRtLabel "init_stack"),
          ITest Rax Rax,
          IJcc "jz" ".Lstart_keep_stack",
          IMov (OpReg Rsp) (OpReg Rax),
          ILabel ".Lstart_keep_stack"
        ]
    initMemGc =
      if not needs.inHeap then
        []
      else
        [ICall (nativeRtLabel "init_mem"), ICall (nativeRtLabel "init_gc")]
    initCpusInstrs = if not needs.inCpus then [] else [ICall (nativeRtLabel "init_cpus")]
    initLimits =
      append
        initStackInstrs
        (append initMemGc (append initCpusInstrs [ICall (nativeRtLabel "init_timeout")]))
    runPart =
      case runMainM of
        Just rm => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeFuncLabel rm)]
        Nothing => []
    -- 入口 handler 是普通定义：机器路径不需要「宿主直连」标记（旧的 `rt_next_host`
    -- 只服务已删除的栈拷贝运行时）。
    markHost : String -> List Instr
    markHost h = [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeFuncLabel h)]
    handlerPart = concatMap markHost handlers
    -- 零参顶层定义在入口求值一次：值写回各自的 `.bss` 槽（`IrGlobal` 引用只读槽）。
    -- 依赖顺序由 `cpsOrdered` 的 SCC 序保证（被依赖的定义在前）。
    cafInit =
      concatMap
        (\n => [ICall (nativeFuncLabel n), IMov (OpRip (nativeCafCellLabel n)) (OpReg Rax)])
        cafs
    callMain =
      append
        [IBinReg "and" Rsp (OpImm (0 - 16)), IMov (OpRip nativeStackTopLabel) (OpReg Rsp)]
        (append cafInit (append [ICall (nativeFuncLabel mainName)] (append handlerPart runPart)))
    printer =
      if printResult then
        case kind of
          "bool" => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_bool")]
          "str" => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "show_str"), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_str")]
          "float" => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeFuncLabel floatRenderName), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_str")]
          _ => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_int")]
      else
        []
    exitInstrs = [IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 0), ISyscall]
  in NativeFunc
    nativeEntryLabel
    0
    (append [IBinReg "xor" Rbp (OpReg Rbp)] (append captureArgs (append initHeap (append initLimits (append callMain (append printer exitInstrs))))))
    (modulePathOf mainName)

-- ---------------------------------------------------------------
-- List 桥接：strUnpack / strPack / strConcatMany / strSubstTemplate
-- ---------------------------------------------------------------
-- 复用变体对象表示：`[tag]` + 8 字节字段，按该族最大 arity 补齐。
-- List 的 `head` 是**未装箱**的 Int（native 的 63-bit 立即数）。
record NListDesc where
  nlNilTag : Int
  nlConsTag : Int
  nlConsFields : Int
  nlMaxArity : Int

nlistDescOf : Maybe IrListFam -> List IrTyDecl -> Maybe NListDesc
nlistDescOf lfM fams =
  case Layout.irListShapeOf lfM fams of
    Nothing => Nothing
    Just sh =>
      Just
        (NListDesc sh.irListShapeNilTag sh.irListShapeConsTag sh.irListShapeConsFields (nlistMaxArityOf lfM fams))

-- | 该族的最大构造子 arity（对象补齐用）。
nlistMaxArityOf : Maybe IrListFam -> List IrTyDecl -> Int
nlistMaxArityOf Nothing _ = 0
nlistMaxArityOf (Just lf) fams =
  case Layout.irDeclOf (irListFamilyOf lf) fams of
    Just d => Layout.irMaxArityIn (Layout.irDeclCtorsOf d)
    Nothing => 0

-- | 一个桥接运行时函数：固定 prologue/epilogue（结果在 rax，体内不写 `ret`）。
-- | 同 `bridgeFn`，但把体内 `IRet` 改写成跳到尾部（单出口，与 `Native.Runtime.rtFunc` 同语义）。
bridgeFnExits : String -> Int -> List Instr -> NativeFunc
bridgeFnExits name slots body =
  let
    endLabel = "${nativeRtLabel name}_end"
  in bridgeFn name slots (append (mapRetToLocal endLabel body) [ILabel endLabel])

mapRetToLocal : String -> List Instr -> List Instr
mapRetToLocal label [] = []
mapRetToLocal label (IRet :: rest) = IJmp label :: mapRetToLocal label rest
mapRetToLocal label (i :: rest) = i :: mapRetToLocal label rest

bridgeFn : String -> Int -> List Instr -> NativeFunc
bridgeFn name slots body =
  let
    frame = nativeFrameBytes slots
    instrs = append body nativeEpilogue
  in NativeFunc
    (nativeRtLabel name)
    frame
    (append (nativePrologueOf frame (unwrittenSlots frame instrs)) instrs)
    nativeRuntimeModule

nlistCellBytes : NListDesc -> Int
nlistCellBytes d = 8 * (1 + d.nlMaxArity)

