module Vuna.Target.Native.Model where

-- native 后端的汇编数据模型。
--
-- 产物是按模块切分的 Intel 语法汇编文件集（`runtime.s` + 每模块一个 `.s`）；本模块
-- 只描述程序结构，渲染在 `Native.Render`，IR -> 程序在 `Native.Module`。模型覆盖
-- Int/Nat/Bool 的纯切片，
-- 加**字符串**（堆对象 = 长度头 + 字节）与最小 bump 堆，因此有：
--   * `.bss` 段（堆缓冲 + 堆指针）；
--   * 带长度头的只读字符串字面量（`NativeStrLit`）；
--   * 字节级读写、`rep movsb` / `repe cmpsb` 与 `[rip + label]` 操作数。
--
-- 边界：本模块只 import Base；不 import Core/Elab/Intrinsics/Codegen（由
-- `checks.ir-boundary` 的 native 规则守护）。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String

-- | native 后端的可预期失败：目标能力限制/不支持的输入。驱动把它变成 CLI 普通错误。
export data NativeErr(..) : Type where
  NativeUnsupported : String -> NativeErr
  NativeInternal : String -> NativeErr

export nativeErrText : NativeErr -> String
nativeErrText (NativeUnsupported msg) = msg
nativeErrText (NativeInternal msg) = "internal native backend error: " ++ msg

-- ---------------------------------------------------------------
-- 寄存器与操作数
-- ---------------------------------------------------------------
-- | x86-64 通用寄存器。`rbx` / `r12`–`r15` 是 callee-saved：运行时不用它们，
--   生成代码只在标量槽提升（`Native.Regs`）时使用，并由函数自己保存恢复。
export data Reg(..) : Type where
  Rax : Reg
  Rcx : Reg
  Rdx : Reg
  Rsi : Reg
  Rdi : Reg
  Rbp : Reg
  Rsp : Reg
  R8 : Reg
  R9 : Reg
  R10 : Reg
  R11 : Reg
  Rbx : Reg
  R12 : Reg
  R13 : Reg
  R14 : Reg
  R15 : Reg

export regText : Reg -> String
regText Rax = "rax"
regText Rcx = "rcx"
regText Rdx = "rdx"
regText Rsi = "rsi"
regText Rdi = "rdi"
regText Rbp = "rbp"
regText Rsp = "rsp"
regText R8 = "r8"
regText R9 = "r9"
regText R10 = "r10"
regText R11 = "r11"
regText Rbx = "rbx"
regText R12 = "r12"
regText R13 = "r13"
regText R14 = "r14"
regText R15 = "r15"

-- | 32 位别名（`mov r32, r32` 就是零扩展到 32 位，用于 `& 0xFFFF_FFFF`）。
export reg32Text : Reg -> String
reg32Text Rax = "eax"
reg32Text Rcx = "ecx"
reg32Text Rdx = "edx"
reg32Text Rsi = "esi"
reg32Text Rdi = "edi"
reg32Text Rbp = "ebp"
reg32Text Rsp = "esp"
reg32Text R8 = "r8d"
reg32Text R9 = "r9d"
reg32Text R10 = "r10d"
reg32Text R11 = "r11d"
reg32Text Rbx = "ebx"
reg32Text R12 = "r12d"
reg32Text R13 = "r13d"
reg32Text R14 = "r14d"
reg32Text R15 = "r15d"

-- | 8-bit 别名（`setcc` / 字节存储用）。
export reg8Text : Reg -> String
reg8Text Rax = "al"
reg8Text Rcx = "cl"
reg8Text Rdx = "dl"
reg8Text Rsi = "sil"
reg8Text Rdi = "dil"
reg8Text Rbp = "bpl"
reg8Text Rsp = "spl"
reg8Text R8 = "r8b"
reg8Text R9 = "r9b"
reg8Text R10 = "r10b"
reg8Text R11 = "r11b"
reg8Text Rbx = "bl"
reg8Text R12 = "r12b"
reg8Text R13 = "r13b"
reg8Text R14 = "r14b"
reg8Text R15 = "r15b"

-- | 操作数：寄存器 / 立即数 / `[base + off]` / `[base + index + off]`（scale 1）/
-- `[rip + label]`。`off` 可为负；索引只用于字节访问（字符串数据）。
export data Operand(..) : Type where
  OpReg : Reg -> Operand
  OpImm : Int -> Operand
  OpMem : Reg -> Int -> Operand
  OpMemX : Reg -> Reg -> Int -> Operand
  -- | `[base + index*scale]`（跳转表用；scale 固定为 8）。
  OpMemS : Reg -> Reg -> Int -> Operand
  OpRip : String -> Operand

-- ---------------------------------------------------------------
-- 指令
-- ---------------------------------------------------------------
-- | 当前指令面。所有二元运算的「左/目标」由构造子决定；`IBin` 固定以 rax 为目标，
-- `IBinReg` 显式给目标寄存器。字节读写用 `rep movsb` / `repe cmpsb`。
export data Instr(..) : Type where
  -- | `mov dst, src`（dst 是内存时渲染 `qword ptr`）。
  IMov : Operand -> Operand -> Instr
  -- | `mov byte ptr <op>, imm8`（字符串缓冲写入）。
  IMovByteOp : Operand -> Int -> Instr
  -- | `mov byte ptr <op>, r8`（字符串缓冲写入）。
  IMovByteRegOp : Operand -> Reg -> Instr
  -- | `movzx dst, byte ptr <op>`（读字符串字节）。
  IMovzx : Reg -> Operand -> Instr
  -- | `movzx rax, al`（`setcc` 之后把 Bool 变成 0/1）。
  IMovzxAl : Instr
  -- | `lea reg, [rip + label]`（只读数据）。
  ILea : Reg -> String -> Instr
  -- | `lea reg, [base + off]`。
  ILeaMem : Reg -> Reg -> Int -> Instr
  -- | `lea dst, [base + base*scale + off]`（乘加强度削减用；scale ∈ 1/2/4/8）。
  ILeaScale : Reg -> Reg -> Int -> Int -> Instr
  -- | `op rax, operand`。
  IBin : String -> Operand -> Instr
  -- | `op reg, operand`。
  IBinReg : String -> Reg -> Operand -> Instr
  -- | `cmp dst, src`。
  ICmp : Operand -> Operand -> Instr
  -- | `cmovcc dst, src`（`dst` 必须是寄存器；`src` 是寄存器/内存）。
  ICmov : String -> Reg -> Operand -> Instr
  -- | `test r1, r2`。
  ITest : Reg -> Reg -> Instr
  -- | `setcc reg8`（结果只有 0/1，需配合 `IMovzxAl`）。
  ISetcc : String -> Reg -> Instr
  -- | `neg reg`。
  INeg : Reg -> Instr
  -- | `cqo`（idiv 前置）。
  ICqo : Instr
  -- | `idiv reg`（有符号）。
  IDiv : Reg -> Instr
  -- | `div reg`（无符号）。
  IDivUnsigned : Reg -> Instr
  -- | `imul reg`（单操作数：`rdx:rax <- rax * reg`，有符号高半）。
  IMulSigned : Reg -> Instr
  -- | `rep movsb`（rdi=目的、rsi=源、rcx=字节数）。
  IRepMovsb : Instr
  -- | `repe cmpsb`（rdi/rsi 为两段字节，rcx=字节数；相等时 ZF=1）。
  IRepeCmpsb : Instr
  -- | 标签定义。
  ILabel : String -> Instr
  -- | `jmp label`。
  IJmp : String -> Instr
  -- | `jmp reg`（续延恢复时的非局部跳转）。
  IJmpReg : Reg -> Instr
  -- | `jcc label`。
  IJcc : String -> String -> Instr
  -- | `call label`。
  ICall : String -> Instr
  -- | `call reg`（寄存器里的代码指针；闭包调用）。
  ICallReg : Reg -> Instr
  -- | `movsd xmm<n>, qword ptr <op>`。
  IXmmLoad : Int -> Operand -> Instr
  -- | `movsd qword ptr <op>, xmm<n>`。
  IXmmStore : Operand -> Int -> Instr
  -- | `cvtsi2sd xmm<n>, <reg>`（Int -> double）。
  IXmmFromInt : Int -> Reg -> Instr
  -- | `cvttsd2si <reg>, xmm<n>`（double -> Int，向零截断）。
  IXmmToInt : Reg -> Int -> Instr
  -- | 双精度二元指令：`<op>sd xmm<dst>, xmm<src>`。
  IXmmBin : String -> Int -> Int -> Instr
  -- | 双精度一元指令：`<op>sd xmm<n>, xmm<n>`。
  IXmmUnop : String -> Int -> Instr
  -- | `ucomisd xmm<a>, xmm<b>`。
  IXmmCmp : Int -> Int -> Instr
  -- | `<op>sd xmm<dst>, qword ptr <op>`：右操作数直接取自 `.rodata` 常量，省掉一次装填。
  IXmmBinMem : String -> Int -> Operand -> Instr
  -- | `mov r32, r32`：写低 32 位并零扩展，等价于 `and r, 0xFFFF_FFFF`。
  ITrunc32 : Reg -> Instr
  -- | `movq <reg>, xmm<n>`（按位搬 64 位）。
  IXmmToReg : Reg -> Int -> Instr
  -- | `movq xmm<n>, <reg>`（按位搬 64 位）。
  IXmmFromReg : Int -> Reg -> Instr
  -- | `ret`。
  IRet : Instr
  -- | `syscall`。
  ISyscall : Instr
  -- | `push reg` / `pop reg`。
  IPush : Reg -> Instr
  IPop : Reg -> Instr
  -- | 空指令（保留给生成器的占位/调试）。
  INop : Instr
  -- | 跳转表条目：`.quad label`（native 固定 no-pie 链接，绝对地址可直接用）。
  IQuadLabel : String -> Instr
  -- | `jmp qword ptr [operand]`（跳转表）。
  IJmpMem : Operand -> Instr
  -- | `.p2align n`。
  IAlign : Int -> Instr

-- ---------------------------------------------------------------
-- 程序
-- ---------------------------------------------------------------
-- | 一个函数：标签、帧大小（字节，16 倍数）、指令体、所属模块路径。
--   `nfModule` 是模块路径段（如 `["Vuna", "Compiler", "Native", "Render"]`）；
--   `["runtime"]` 是运行时/桥接文件，`["Main"]` 是入口（含无模块头的 ad-hoc 文件）。
export record NativeFunc(..) where
  nfLabel : String
  nfFrame : Int
  nfBody : List Instr
  nfModule : List String

-- | 只读数据：标签 + 原始文本（无长度头；只用于运行时常量）。
export record NativeRodata(..) where
  nrLabel : String
  nrText : String

-- | 字符串字面量：标签 + 字节（`.quad <len>` 头 + `.ascii` 体）。运行时值是
-- **指向长度头的指针**，数据紧跟在头之后（8 字节处）。
export record NativeStrLit(..) where
  nsLabel : String
  nsText : String

-- | 浮点字面量：标签 + 汇编文本（`.double <text>`）。运行时值是指向该 8 字节
-- 只读数据的**指针**，与堆上装箱的 Float 叶子（`[f64]`）同一形状，所以消费方
-- 无需区分来源；`.rodata` 不在堆段里，GC 的候选指针判据天然忽略它。
export record NativeFloatLit(..) where
  nflLabel : String
  nflText : String

-- | `.bss` 条目：标签 + 字节数 + 对齐（0 表示不写 `.align`；堆缓冲与堆指针；
-- 零填充，不占文件体积）。
export record NativeBss(..) where
  nbLabel : String
  nbSize : Int
  nbAlign : Int

-- | 静态闭包对象：`[code][arity]`，只读，不占堆，不进 GC 段。
export record NativeClosure(..) where
  ncLabel : String
  ncCode : String
  ncArity : Int

-- | 一个 native 程序（渲染前的结构）。
--   `npFuncs` 的顺序固定：runtime 函数 → 用户函数（按生成顺序）→ `_start`；
--   `npModuleLits` / `npModuleFloats` 是每个模块自己的字符串 / 浮点字面量池
--   （`.Llit_<n>` / `.Lflt_<n>` 是文件局部标签，所以池按模块切分，新增字面量不会
--   重编号其它模块）。
export record NativeProgram(..) where
  npRodata : List NativeRodata
  npBss : List NativeBss
  npClosures : List NativeClosure
  npFuncs : List NativeFunc
  npModuleLits : List (List String, List NativeStrLit)
  npModuleFloats : List (List String, List NativeFloatLit)

export data NativeOutcome(..) : Type where
  NativeOk : NativeProgram -> NativeOutcome
  NativeRejected : NativeErr -> NativeOutcome
