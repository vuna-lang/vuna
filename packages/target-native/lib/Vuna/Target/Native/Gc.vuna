module Vuna.Target.Native.Gc where

-- native 后端的两代标记-清扫 GC（非移动）。
--
-- 根集（单线程）：沿 `rbp` 链逐帧保守扫（帧内每个机器字都当候选指针）、`.bss` 的
-- cleanup 链头与 CAF 求值区。`rt_live_threads > 1` 时改为 STW：置
-- `rt_gc_requested` 等全部 live 线程停车，扫本线程 `[rsp, stack_top)`，再按线程表逐个
-- 扫 `[saved_rsp, stack_top)`（state 3 = 已结束的槽跳过）。扫描上界是 `rt_thread_hi`
-- （已用过的最高槽 + 1，单调）：表容量不必等于并发；槽里解引用 TCB 前核对 magic。
--
-- 两代：
--   * 新分配的块都是年轻代；块头 `nativeOldFlag` 置位即老代；
--   * 年轻代回收只标记/清扫年轻代块，老代块不动；活下来的年轻代块在清扫时晋升；
--   * 老代块指向年轻代块的引用靠写屏障把所在卡片置脏（`rt_write_barrier`），
--     年轻代回收把脏卡片覆盖的区间当额外根；
--   * 连续 `gcMinorRunsLimit` 次年轻代回收、或分配预算压线时做整堆回收。
--
-- 候选指针的判据：指向已注册堆段内某个 16 对齐块头之后的 payload 起点、块头合法且不是
-- 空闲块。非移动清扫，所以保守多留只会多占内存，不会让指针失效。
--
-- 分配器（`Native.Runtime.alloc`）在预算或阈值处调用 `rt_gc_collect`；
-- 空闲块按 2 的幂尺寸类复用，超过 `nativeMaxClassBytes` 的块进 `rt_huge_free`。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.String as String
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Model
import Vuna.Target.Native.Pal

-- ---------------------------------------------------------------
-- 状态槽与只读数据
-- ---------------------------------------------------------------
export gcLiveLabel : String
gcLiveLabel = "rt_gc_live"

export gcSinceLabel : String
gcSinceLabel = "rt_gc_since"

export gcThresholdLabel : String
gcThresholdLabel = "rt_gc_threshold"

export gcMinLabel : String
gcMinLabel = "rt_gc_min"

export gcCountLabel : String
gcCountLabel = "rt_gc_count"

export gcStressLabel : String
gcStressLabel = "rt_gc_stress"

export gcLogLabel : String
gcLogLabel = "rt_gc_logging"

export gcRunningLabel : String
gcRunningLabel = "rt_gc_running"

-- | 标记栈（惰性 mmap，溢出时倍增）。
export markBaseLabel : String
markBaseLabel = "rt_mark_base"

export markTopLabel : String
markTopLabel = "rt_mark_top"

export markEndLabel : String
markEndLabel = "rt_mark_end"

export markSizeLabel : String
markSizeLabel = "rt_mark_size"

-- | `gc_try` 的溢出临时量（标记栈扩容时先存一个候选字）与日志缓冲。
gcTmpLabel : String
gcTmpLabel = "rt_gc_tmp"

-- | 段定位的最近命中缓存：`[lo, hi)` 是上次命中段的块区，`seg` 是段头。
--   一次保守扫描里绝大多数候选字落在同一个段，命中时省掉一次 `seg_find` 二分
--   （每字一次 call/ret + log(段数) 次访存）。
gcCacheLoLabel : String
gcCacheLoLabel = "rt_gc_cache_lo"

gcCacheHiLabel : String
gcCacheHiLabel = "rt_gc_cache_hi"

gcCacheSegLabel : String
gcCacheSegLabel = "rt_gc_cache_seg"

-- | 本次 GC 保守扫描的栈字节数（用于让阈值覆盖一次扫栈成本）。
gcSpanLabel : String
gcSpanLabel = "rt_gc_span"

-- | 诊断行的增量读数（只在 `VUNA_NATIVE_GC_LOG` 打开时计算）：
--   段数 / 已映射堆字节 / live 对象数 / 本次回收起点 / 累计回收耗时（微秒）/ timespec 暂存。
gcSegsLabel : String
gcSegsLabel = "rt_gc_segs"

gcMappedLabel : String
gcMappedLabel = "rt_gc_mapped"

gcObjsLabel : String
gcObjsLabel = "rt_gc_objs"

gcT0Label : String
gcT0Label = "rt_gc_t0"

gcTimeLabel : String
gcTimeLabel = "rt_gc_time"

gcTsLabel : String
gcTsLabel = "rt_gc_ts"

-- | 帧遍历：当前帧 rbp 与保守区下界。
gcFrameLabel : String
gcFrameLabel = "rt_gc_frame"

gcBoundLabel : String
gcBoundLabel = "rt_gc_bound"

-- | 内存预算是不是缺省的（1 = 缺省，按 live 自动抬高；显式 `VUNA_NATIVE_MEM_LIMIT`
--   时是 0 = 硬上限）。`init_mem` 置位，`gc_collect` 每次回收后读它。
export nativeMemAutoLabel : String
nativeMemAutoLabel = "rt_mem_auto"

-- | 本次回收是不是年轻代回收（1 = 是）；`gc_try` / `gc_sweep` / 诊断行都读它。
gcMinorLabel : String
gcMinorLabel = "rt_gc_minor"

-- | 连续年轻代回收次数（整堆回收后清零）。
gcMinorRunsLabel : String
gcMinorRunsLabel = "rt_gc_minor_runs"

-- | 本次回收扫过的脏卡片数（诊断用；整堆回收不扫卡片，恒为 0）。
gcCardsLabel : String
gcCardsLabel = "rt_gc_cards"

-- | 段索引：按块区起点升序的 `{start, seg}` 数组（每项 16 字节）。
--   `gc_try` 对每个候选字都要定位段，线性走 `rt_segs` 在大堆上是主要开销
--   （每字一次链路遍历，且是缓存缺失）；改成二分。
export segIdxLabel : String
segIdxLabel = "rt_seg_idx"

export segIdxCountLabel : String
segIdxCountLabel = "rt_seg_idx_n"

segTmpLabel : String
segTmpLabel = "rt_seg_tmp"

-- | 索引容量（1 MiB 段下可覆盖 32 GiB 堆；超了 trap）。
segIdxCapacity : Int
segIdxCapacity = 32768

-- | 本次年轻代回收晋升的字节数（存活率高就提前安排整堆回收）。
gcPromotedLabel : String
gcPromotedLabel = "rt_gc_promoted"

-- | 连续多少次年轻代回收后做一次整堆回收。
gcMinorRunsLimit : Int
gcMinorRunsLimit = 8

-- | `alloc` 的请求字节数与调用方寄存器快照。`alloc` 不建栈帧，`rsi` / `r8` / `r9`
--   靠这些槽跨 `gc_collect` 保活；它们不是 GC 根（活值在调用方的栈槽里）。
export allocReqLabel : String
allocReqLabel = "rt_alloc_req"

gcBufLabel : String
gcBufLabel = "rt_gc_buf"

export nativeGcBss : List NativeBss
nativeGcBss =
  [
    NativeBss gcLiveLabel 8 8,
    NativeBss gcSinceLabel 8 8,
    NativeBss gcThresholdLabel 8 8,
    NativeBss gcMinLabel 8 8,
    NativeBss gcCountLabel 8 8,
    NativeBss gcStressLabel 8 8,
    NativeBss gcLogLabel 8 8,
    NativeBss gcRunningLabel 8 8,
    NativeBss markBaseLabel 8 8,
    NativeBss markTopLabel 8 8,
    NativeBss markEndLabel 8 8,
    NativeBss markSizeLabel 8 8,
    NativeBss gcTmpLabel 8 8,
    NativeBss gcCacheLoLabel 8 8,
    NativeBss gcCacheHiLabel 8 8,
    NativeBss gcCacheSegLabel 8 8,
    NativeBss gcSpanLabel 8 8,
    NativeBss gcSegsLabel 8 8,
    NativeBss gcMappedLabel 8 8,
    NativeBss gcObjsLabel 8 8,
    NativeBss gcT0Label 8 8,
    NativeBss gcTimeLabel 8 8,
    NativeBss gcTsLabel 16 8,
    NativeBss gcFrameLabel 8 8,
    NativeBss gcBoundLabel 8 8,
    NativeBss gcMinorLabel 8 8,
    NativeBss gcMinorRunsLabel 8 8,
    NativeBss nativeGcForceMajorLabel 8 8,
    NativeBss gcCardsLabel 8 8,
    NativeBss nativeMemAutoLabel 8 8,
    NativeBss segIdxCountLabel 8 8,
    NativeBss segTmpLabel 8 8,
    NativeBss segIdxLabel (16 * segIdxCapacity) 8,
    NativeBss gcPromotedLabel 8 8,
    NativeBss allocReqLabel 8 8,
    NativeBss gcBufLabel 512 8
  ]

export nativeGcRodata : List NativeRodata
nativeGcRodata =
  [
    NativeRodata (nativeDataLabel "env_gc_min") ("VUNA_NATIVE_GC_MIN" ++ strPack [0]),
    NativeRodata (nativeDataLabel "env_gc_log") ("VUNA_NATIVE_GC_LOG" ++ strPack [0]),
    NativeRodata (nativeDataLabel "env_gc_stress") ("VUNA_NATIVE_GC_STRESS" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_n") ("gc n=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_live") (" live=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_alloc") (" alloc=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_cards") (" cards=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_gen_minor") (" gen=minor" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_gen_full") (" gen=full" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_span") (" span=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_segs") (" segs=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_mapped") (" mapped=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_objs") (" objs=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_gcus") (" gcus=" ++ strPack [0]),
    NativeRodata (nativeDataLabel "gc_nl") ("\n" ++ strPack [0])
  ]

-- ---------------------------------------------------------------
-- 初始化：env 只影响运行时行为，不进 codegen
-- ---------------------------------------------------------------
-- | `VUNA_NATIVE_GC_MIN`（字节，缺省 1 MiB；同时是触发阈值下限）、
--   `VUNA_NATIVE_GC_LOG`（存在即开诊断行）、`VUNA_NATIVE_GC_STRESS`（每次分配都 GC）。
initGcFn : NativeFunc
initGcFn =
  rtRawFunc
    "init_gc"
    [ILea Rdi (nativeDataLabel "env_gc_min"), ICall (nativeRtLabel "env_lookup"), ITest Rax Rax, IJcc "jz" ".Lgc_init_def", IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "parse_u64"), ITest Rdx Rdx, IJcc "jnz" ".Lgc_init_min", ILabel ".Lgc_init_def", IMov (OpReg Rax) (OpImm nativeGcMinDefaultBytes), ILabel ".Lgc_init_min", ICmp (OpReg Rax) (OpImm nativeMinBlockBytes), IJcc "jae" ".Lgc_init_min_ok", IMov (OpReg Rax) (OpImm nativeMinBlockBytes), ILabel ".Lgc_init_min_ok", IMov (OpRip gcMinLabel) (OpReg Rax), IMov (OpRip gcThresholdLabel) (OpReg Rax), ILea Rdi (nativeDataLabel "env_gc_log"), ICall (nativeRtLabel "env_lookup"), ITest Rax Rax, IJcc "jz" ".Lgc_init_nolog", IMov (OpReg Rcx) (OpImm 1), IMov (OpRip gcLogLabel) (OpReg Rcx), ILabel ".Lgc_init_nolog", ILea Rdi (nativeDataLabel "env_gc_stress"), ICall (nativeRtLabel "env_lookup"), ITest Rax Rax, IJcc "jz" ".Lgc_init_nostress", IMov (OpReg Rcx) (OpImm 1), IMov (OpRip gcStressLabel) (OpReg Rcx), ILabel ".Lgc_init_nostress", IRet]

-- ---------------------------------------------------------------
-- 标记栈
-- ---------------------------------------------------------------
-- | 标记栈溢出：容量翻倍（首次 1 MiB），把旧内容拷过去，再把 `rt_gc_tmp` 里的 payload
--   推进新栈。只在溢出时走这里。
gcGrowMarkFn : NativeFunc
gcGrowMarkFn =
  rtRawFunc
    "gc_grow_mark"
    [IMov (OpReg R8) (OpRip markSizeLabel), ITest R8 R8, IJcc "jnz" ".Lgc_mark_have", IMov (OpReg R8) (OpImm 1048576), IJmp ".Lgc_mark_size", ILabel ".Lgc_mark_have", IBinReg "shl" R8 (OpImm 1), ILabel ".Lgc_mark_size", IMov (OpRip markSizeLabel) (OpReg R8), IBinReg "xor" Rdi (OpReg Rdi), IMov (OpReg Rsi) (OpReg R8), IMov (OpReg Rdx) (OpImm 3), IMov (OpReg R10) (OpImm 34), IMov (OpReg R8) (OpImm (0 - 1)), IBinReg "xor" R9 (OpReg R9), IMov (OpReg Rax) (OpImm 9), ISyscall, ICmp (OpReg Rax) (OpImm 0), IJcc "jl" (nativeRtLabel "trap_oom"), IMov (OpReg R10) (OpReg Rax), IMov (OpReg R11) (OpRip markBaseLabel), ITest R11 R11, IJcc "jz" ".Lgc_mark_no_copy", IMov (OpReg Rcx) (OpRip markTopLabel), IBinReg "sub" Rcx (OpReg R11), IMov (OpReg Rdi) (OpReg R10), IMov (OpReg Rsi) (OpReg R11), IRepMovsb, ILabel ".Lgc_mark_no_copy", IMov (OpReg Rcx) (OpRip markTopLabel), IMov (OpReg Rdx) (OpRip markBaseLabel), IBinReg "sub" Rcx (OpReg Rdx), IBinReg "add" Rcx (OpReg R10), IMov (OpRip markTopLabel) (OpReg Rcx), IMov (OpRip markBaseLabel) (OpReg R10), IMov (OpReg R9) (OpReg R10), IBinReg "add" R9 (OpRip markSizeLabel), IMov (OpRip markEndLabel) (OpReg R9), IMov (OpReg Rax) (OpRip gcTmpLabel), IMov (OpMem Rcx 0) (OpReg Rax), IBinReg "add" Rcx (OpImm 8), IMov (OpRip markTopLabel) (OpReg Rcx), IRet]

-- ---------------------------------------------------------------
-- 候选指针：标记一块并压进标记栈
-- ---------------------------------------------------------------
-- | `rdi` = 栈/堆里的一个机器字。指向合法块头之后的 payload 就标记并压栈。
--   可能清掉所有 caller-saved 寄存器（标记栈扩容路径）。
gcTryFn : NativeFunc
gcTryFn =
  rtRawFunc
    "gc_try"
    [ITest Rdi Rdi, IJcc "jz" ".Lgc_try_ret", IMov (OpReg R10) (OpReg Rdi), IBinReg "and" R10 (OpImm 7), ITest R10 R10, IJcc "jnz" ".Lgc_try_ret", IMov (OpReg Rax) (OpReg Rdi), IBinReg "sub" Rax (OpImm nativeBlockHeaderBytes), IMov (OpReg R10) (OpReg Rax), IBinReg "and" R10 (OpImm 15), ITest R10 R10, IJcc "jnz" ".Lgc_try_ret", IMov (OpReg R10) (OpReg Rax), IMov (OpReg Rdi) (OpReg R10), ICall (nativeRtLabel "seg_find"), ITest Rax Rax, IJcc "jz" ".Lgc_try_ret", IMov (OpReg Rcx) (OpReg Rax), IMov (OpReg R9) (OpMem Rcx 16), IMov (OpReg Rax) (OpReg R10), IMov (OpReg Rdi) (OpReg R10), IBinReg "add" Rdi (OpImm nativeBlockHeaderBytes), IMov (OpReg R8) (OpMem Rax 0), IMov (OpReg R10) (OpReg R8), IBinReg "and" R10 (OpImm 15), IMov (OpReg R11) (OpReg R10), IBinReg "and" R11 (OpImm nativeFreeFlag), ITest R11 R11, IJcc "jnz" ".Lgc_try_ret", IMov (OpReg R11) (OpRip gcMinorLabel), ITest R11 R11, IJcc "jz" ".Lgc_try_any_gen", IMov (OpReg R11) (OpReg R10), IBinReg "and" R11 (OpImm nativeOldFlag), ITest R11 R11, IJcc "jnz" ".Lgc_try_ret", ILabel ".Lgc_try_any_gen", IMov (OpReg R11) (OpReg R8), IBinReg "and" R11 (OpImm (0 - 16)), ICmp (OpReg R11) (OpImm nativeMinBlockBytes), IJcc "jb" ".Lgc_try_ret", IMov (OpReg Rdx) (OpReg Rax), IBinReg "add" Rdx (OpReg R11), ICmp (OpReg Rdx) (OpReg R9), IJcc "ja" ".Lgc_try_ret", IMov (OpReg R10) (OpReg R8), IBinReg "and" R10 (OpImm nativeMarkFlag), ITest R10 R10, IJcc "jnz" ".Lgc_try_ret", IBinReg "or" R8 (OpImm nativeMarkFlag), IMov (OpMem Rax 0) (OpReg R8), IMov (OpReg Rcx) (OpRip markTopLabel), IMov (OpReg Rdx) (OpRip markEndLabel), ICmp (OpReg Rcx) (OpReg Rdx), IJcc "jae" ".Lgc_try_grow", IMov (OpMem Rcx 0) (OpReg Rdi), IBinReg "add" Rcx (OpImm 8), IMov (OpRip markTopLabel) (OpReg Rcx), ILabel ".Lgc_try_ret", IRet, ILabel ".Lgc_try_grow", IMov (OpRip gcTmpLabel) (OpReg Rdi), ICall (nativeRtLabel "gc_grow_mark"), IRet]

-- ---------------------------------------------------------------
-- 段索引
-- ---------------------------------------------------------------
-- | `rdi` = 块头地址 → `rax` = 所在段（没有则 0）。先查最近命中缓存，未命中再二分，
--   O(log n)。缓存只影响速度：命中判据就是「块区起点 ≤ 块头 < 段尾」，与二分的判据同形，
--   错置时只是多走一次二分。
--   只碰 caller-saved 寄存器；保留 `rdi` 与 `r10`（调用方用它存块头）。
segFindFn : NativeFunc
segFindFn =
  rtRawFunc
    "seg_find"
    [IMov (OpReg Rax) (OpRip gcCacheSegLabel), ITest Rax Rax, IJcc "jz" ".Lsf_slow", ICmp (OpReg Rdi) (OpRip gcCacheLoLabel), IJcc "jb" ".Lsf_slow", ICmp (OpReg Rdi) (OpRip gcCacheHiLabel), IJcc "jb" ".Lsf_hit", ILabel ".Lsf_slow", IMov (OpReg R8) (OpRip segIdxCountLabel), ITest R8 R8, IJcc "jz" ".Lsf_miss", IBinReg "xor" Rcx (OpReg Rcx), IMov (OpReg R9) (OpReg R8), ILabel ".Lsf_loop", ICmp (OpReg Rcx) (OpReg R9), IJcc "jae" ".Lsf_before", IMov (OpReg R11) (OpReg Rcx), IBinReg "add" R11 (OpReg R9), IBinReg "shr" R11 (OpImm 1), IMov (OpReg Rsi) (OpReg R11), IBinReg "shl" Rsi (OpImm 4), ILea Rdx segIdxLabel, IBinReg "add" Rdx (OpReg Rsi), ICmp (OpReg Rdi) (OpMem Rdx 0), IJcc "jb" ".Lsf_upper", IMov (OpReg Rcx) (OpReg R11), IBinReg "add" Rcx (OpImm 1), IJmp ".Lsf_loop", ILabel ".Lsf_upper", IMov (OpReg R9) (OpReg R11), IJmp ".Lsf_loop", ILabel ".Lsf_before", ITest Rcx Rcx, IJcc "jz" ".Lsf_miss", IBinReg "sub" Rcx (OpImm 1), IMov (OpReg Rsi) (OpReg Rcx), IBinReg "shl" Rsi (OpImm 4), ILea Rdx segIdxLabel, IBinReg "add" Rdx (OpReg Rsi), IMov (OpReg Rax) (OpMem Rdx 8), ICmp (OpReg Rdi) (OpMem Rax 16), IJcc "jae" ".Lsf_miss", IMov (OpReg Rcx) (OpReg Rax), IBinReg "add" Rcx (OpImm nativeSegHeaderBytes), IMov (OpRip gcCacheLoLabel) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rax 16), IMov (OpRip gcCacheHiLabel) (OpReg Rcx), IMov (OpRip gcCacheSegLabel) (OpReg Rax), IRet, ILabel ".Lsf_hit", IRet, ILabel ".Lsf_miss", IBinReg "xor" Rax (OpReg Rax), IRet]

-- | `rdi` = 新段（段头地址）。按块区起点插入有序数组；保留全部 caller-saved 寄存器
--   （`alloc` 在段创建点调用它，之后还要用 `rcx` 的块大小等）。
segIndexAddFn : NativeFunc
segIndexAddFn =
  rtRawFunc
    "seg_index_add"
    [IPush Rax, IPush Rcx, IPush Rdx, IPush Rsi, IPush Rdi, IPush R8, IPush R9, IPush R10, IPush R11, IMov (OpReg R8) (OpRip segIdxCountLabel), ICmp (OpReg R8) (OpImm segIdxCapacity), IJcc "jae" (nativeRtLabel "trap_oom"), IMov (OpReg Rcx) (OpReg Rdi), IBinReg "add" Rcx (OpImm nativeSegHeaderBytes), IBinReg "xor" Rdx (OpReg Rdx), ILabel ".Lsa_find", ICmp (OpReg Rdx) (OpReg R8), IJcc "jae" ".Lsa_pos", IMov (OpReg R9) (OpReg Rdx), IBinReg "shl" R9 (OpImm 4), ILea R10 segIdxLabel, IBinReg "add" R10 (OpReg R9), ICmp (OpReg Rcx) (OpMem R10 0), IJcc "jb" ".Lsa_pos", IBinReg "add" Rdx (OpImm 1), IJmp ".Lsa_find", ILabel ".Lsa_pos", IMov (OpReg R9) (OpReg R8), ILabel ".Lsa_shift", ICmp (OpReg R9) (OpReg Rdx), IJcc "jbe" ".Lsa_shift_done", IMov (OpReg R10) (OpReg R9), IBinReg "shl" R10 (OpImm 4), ILea R11 segIdxLabel, IBinReg "add" R11 (OpReg R10), IMov (OpReg R10) (OpMem R11 (0 - 16)), IMov (OpMem R11 0) (OpReg R10), IMov (OpReg R10) (OpMem R11 (0 - 8)), IMov (OpMem R11 8) (OpReg R10), IBinReg "sub" R9 (OpImm 1), IJmp ".Lsa_shift", ILabel ".Lsa_shift_done", IMov (OpReg R10) (OpReg Rdx), IBinReg "shl" R10 (OpImm 4), ILea R11 segIdxLabel, IBinReg "add" R11 (OpReg R10), IMov (OpMem R11 0) (OpReg Rcx), IMov (OpMem R11 8) (OpReg Rdi), IBinReg "add" R8 (OpImm 1), IMov (OpRip segIdxCountLabel) (OpReg R8), IPop R11, IPop R10, IPop R9, IPop R8, IPop Rdi, IPop Rsi, IPop Rdx, IPop Rcx, IPop Rax, IRet]

-- | 清空索引并按 `rt_segs` 现有段重建（`_start` 建好初始段后调用一次）。
segIndexInitFn : NativeFunc
segIndexInitFn =
  rtRawFunc
    "seg_index_init"
    [IBinReg "xor" Rax (OpReg Rax), IMov (OpRip segIdxCountLabel) (OpReg Rax), IMov (OpReg R10) (OpRip nativeSegsLabel), ILabel ".Lsi_loop", ITest R10 R10, IJcc "jz" ".Lsi_done", IMov (OpReg R11) (OpReg R10), IMov (OpReg R10) (OpMem R10 0), IMov (OpRip segTmpLabel) (OpReg R10), IMov (OpReg Rdi) (OpReg R11), ICall (nativeRtLabel "seg_index_add"), IMov (OpReg R10) (OpRip segTmpLabel), IJmp ".Lsi_loop", ILabel ".Lsi_done", IRet]

-- ---------------------------------------------------------------
-- 保守扫描一段内存
-- ---------------------------------------------------------------
-- | `rdi` = lo、`rsi` = hi（不含）；对每个 8 字节字调 `gc_try`。
--   游标与上界放在 `r12` / `r13`（callee-saved，`gc_try` 与它的扩容路径都不碰），
--   所以每个字只是「读一个字 + 一次 call」；放 `.bss` 时每个字要多 4 次访存与一次重载。
gcScanWordsFn : NativeFunc
gcScanWordsFn =
  rtRawFunc
    "gc_scan_words"
    [IPush R12, IPush R13, IMov (OpReg R12) (OpReg Rdi), IMov (OpReg R13) (OpReg Rsi), ICmp (OpReg R12) (OpReg R13), IJcc "jae" ".Lgc_scan_done", ILabel ".Lgc_scanw_loop", IMov (OpReg Rdi) (OpMem R12 0), ICall (nativeRtLabel "gc_try"), IBinReg "add" R12 (OpImm 8), ICmp (OpReg R12) (OpReg R13), IJcc "jb" ".Lgc_scanw_loop", ILabel ".Lgc_scan_done", IPop R13, IPop R12, IRet]

-- ---------------------------------------------------------------
-- 清扫：清标记、回收未标记块、累计 live
-- ---------------------------------------------------------------
gcSweepFn : NativeFunc
gcSweepFn =
  rtFunc
    "gc_sweep"
    64
