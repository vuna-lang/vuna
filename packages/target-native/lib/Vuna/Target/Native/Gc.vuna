-- ---------------------------------------------------------------
-- 写屏障：老代对象 → 脏卡片
-- ---------------------------------------------------------------
-- | `rdi` = 被写的对象（payload 起点）。只标老代对象：年轻代对象会被年轻代回收扫到，
--   老代对象不会，所以指向年轻代的引用必须由卡片表带出来。重复置脏是幂等的。
--   只碰 caller-saved 寄存器，不分配、不触发 GC。
gcWriteBarrierFn : NativeFunc
gcWriteBarrierFn =
  rtRawFunc
    "write_barrier"
    [IMov (OpReg R10) (OpMem Rdi (0 - 8)), IMov (OpReg R11) (OpReg R10), IBinReg "and" R11 (OpImm nativeOldFlag), ITest R11 R11, IJcc "jz" ".Lwb_done", IMov (OpReg R10) (OpReg Rdi), IBinReg "sub" Rdi (OpImm nativeBlockHeaderBytes), ICall (nativeRtLabel "seg_find"), ITest Rax Rax, IJcc "jz" ".Lwb_done", IMov (OpReg R9) (OpReg R10), IBinReg "sub" R9 (OpReg Rax), IBinReg "sub" R9 (OpImm nativeSegHeaderBytes), IBinReg "shr" R9 (OpImm nativeCardShift), IMov (OpReg R8) (OpMem Rax 32), IMovByteOp (OpMemX R8 R9 0) 1, ILabel ".Lwb_done", IRet]

export nativeGcFuncs : List NativeFunc
nativeGcFuncs =
  [
    initGcFn,
    gcCollectFn,
    gcTryFn,
    gcWriteBarrierFn,
    gcScanWordsFn,
    segFindFn,
    segIndexAddFn,
    segIndexInitFn,
    gcGrowMarkFn,
    gcNowUsFn,
    gcLogFn,
    gcSweepFn,
    gcAppendFn
  ]
