bytesEqFn =
  rtFunc
    "bytes_eq"
    0
    [ILabel ".Lrt_beq_loop", ICmp (OpReg Rcx) (OpImm 8), IJcc "jb" ".Lrt_beq_tail", IMov (OpReg R9) (OpMem Rdi 0), ICmp (OpReg R9) (OpMem Rsi 0), IJcc "jne" ".Lrt_beq_no", IBinReg "add" Rdi (OpImm 8), IBinReg "add" Rsi (OpImm 8), IBinReg "sub" Rcx (OpImm 8), IJmp ".Lrt_beq_loop", ILabel ".Lrt_beq_tail", ITest Rcx Rcx, IJcc "jz" ".Lrt_beq_yes", IMovzx R9 (OpMem Rdi 0), IMovzx R10 (OpMem Rsi 0), ICmp (OpReg R9) (OpReg R10), IJcc "jne" ".Lrt_beq_no", IBinReg "add" Rdi (OpImm 1), IBinReg "add" Rsi (OpImm 1), IBinReg "sub" Rcx (OpImm 1), IJmp ".Lrt_beq_tail", ILabel ".Lrt_beq_yes", IMov (OpReg Rax) (OpImm 1), IRet, ILabel ".Lrt_beq_no", IMov (OpReg Rax) (OpImm 0)]

-- | `==`：rdi/rsi = 两个字符串 -> rax = 0/1（先比长度，再比字节）。
strEqFn : NativeFunc
strEqFn =
  rtFunc
    "str_eq"
    0
    [IMov (OpReg Rax) (OpMem Rdi 0), ICmp (OpReg Rax) (OpMem Rsi 0), IJcc "jne" ".Lrt_seq_false", IMov (OpReg Rcx) (OpMem Rdi 0), ILeaMem Rdi Rdi 8, ILeaMem Rsi Rsi 8, ICall (nativeRtLabel "bytes_eq"), IRet, ILabel ".Lrt_seq_false", IMov (OpReg Rax) (OpImm 0)]

-- | `!=`：`str_eq` 的结果取反。
strNeqFn : NativeFunc
strNeqFn = rtFunc "str_neq" 0 [ICall (nativeRtLabel "str_eq"), IBin "xor" (OpImm 1), IRet]

-- | 按字节比较公共前缀（`rdi`/`rsi` = 数据起点、`rcx` = 字节数）→ rax = -1 / 0 / 1。
--   0 表示前缀相同（调用方再比长度）。无符号逐字节，与 `str_compare` 的语义一致。
