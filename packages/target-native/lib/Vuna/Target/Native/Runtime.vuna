    "show_str"
    32
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpReg Rax) (OpMem Rdi 0), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rax), IMov (OpReg Rdi) (OpReg Rax), IBinReg "add" Rdi (OpReg Rax), IBinReg "add" Rdi (OpImm 10), ICall (nativeRtLabel "str_alloc"), IMov (OpReg R11) (OpReg Rax), ILeaMem R8 R11 8, IMovByteOp (OpMem R8 0) 34, IBinReg "add" R8 (OpImm 1), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 0)), IBinReg "add" Rsi (OpImm 8), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 1)), ILabel ".Lrt_ss_loop", ITest Rcx Rcx, IJcc "jz" ".Lrt_ss_end", IMovzx Rax (OpMem Rsi 0), IBinReg "add" Rsi (OpImm 1), IBinReg "sub" Rcx (OpImm 1), ICmp (OpReg Rax) (OpImm 34), IJcc "je" ".Lrt_ss_quote", ICmp (OpReg Rax) (OpImm 92), IJcc "je" ".Lrt_ss_bslash", ICmp (OpReg Rax) (OpImm 10), IJcc "je" ".Lrt_ss_nl", ICmp (OpReg Rax) (OpImm 9), IJcc "je" ".Lrt_ss_tab", ICmp (OpReg Rax) (OpImm 13), IJcc "je" ".Lrt_ss_cr", IMovByteRegOp (OpMem R8 0) Rax, IBinReg "add" R8 (OpImm 1), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_quote", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 34, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_bslash", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 92, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_nl", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 110, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_tab", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 116, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_cr", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 114, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_end", IMovByteOp (OpMem R8 0) 34, IBinReg "add" R8 (OpImm 1), ILeaMem Rax R11 8, IMov (OpReg Rdx) (OpReg R8), IBinReg "sub" Rdx (OpReg Rax), IMov (OpMem R11 0) (OpReg Rdx), IMov (OpReg Rax) (OpReg R11), IRet]

-- ---------------------------------------------------------------
-- 浮点（IEEE-754 double）
-- ---------------------------------------------------------------
-- 表示与 wasm 的 `$float` struct 同一决策：堆对象 `[f64]`。运算在 xmm 上做。
floatBox : List Instr
floatBox =
  [IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc_leaf"), IXmmStore (OpMem Rax 0) 0]

floatFromIntFn : NativeFunc
floatFromIntFn = rtFunc "float_from_int" 0 (append [IXmmFromInt 0 Rdi] floatBox)

intFromFloatFn : NativeFunc
intFromFloatFn =
  rtFunc
    "int_from_float"
    0
    [IXmmLoad 0 (OpMem Rdi 0), IXmmToInt Rax 0, IBinReg "shl" Rax (OpImm 1), IBinReg "sar" Rax (OpImm 1)]

floatBinFn : String -> String -> NativeFunc
floatBinFn name op =
  rtFunc
    name
    0
    (append [IXmmLoad 0 (OpMem Rdi 0), IXmmLoad 1 (OpMem Rsi 0), IXmmBin op 0 1] floatBox)

-- | 有序比较与 `!=` 的 0/1 物化序列在 `Native.Select`（与指令选择共用一份）。
floatCmpFn : String -> List Instr -> NativeFunc
floatCmpFn name tail =
  rtFunc name 0 (append [IXmmLoad 0 (OpMem Rdi 0), IXmmLoad 1 (OpMem Rsi 0)] tail)

-- | `abs`：清掉符号位（按位操作，不碰 xmm）。
floatAbsFn : NativeFunc
floatAbsFn =
  rtFunc
    "float_abs"
    8
    [IMov (OpReg Rax) (OpMem Rdi 0), IBinReg "shl" Rax (OpImm 1), IBinReg "shr" Rax (OpImm 1), IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rax), IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc"), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 0)), IMov (OpMem Rax 0) (OpReg Rdx)]

floatSqrtFn : NativeFunc
floatSqrtFn = rtFunc "float_sqrt" 0 (append [IXmmLoad 0 (OpMem Rdi 0), IXmmUnop "sqrt" 0] floatBox)

-- | 当前 active 栈的栈顶（GC 用它确定保守扫描范围）。
stackTopLabel : String
stackTopLabel = nativeStackTopLabel

trapRmtreeDeepFn : NativeFunc
trapRmtreeDeepFn =
  rtRawFunc
    "trap_rmtree_deep"
    [IMov (OpReg Rax) (OpImm (sysNr "write")), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "rmtree_deep"), IMov (OpReg Rdx) (OpImm (strLength rmtreeDeepMessage)), ISyscall, IMov (OpReg Rax) (OpImm (sysNr "exit")), IMov (OpReg Rdi) (OpImm 2), ISyscall]

-- | 向上取整到 2 的幂（最小 64 B）：`rdi` -> `rax`。堆段按 2 的幂分档，
--   增长时才能复用同一批段，而不是每次都新 mmap。
pow2CeilFn : NativeFunc
pow2CeilFn =
  rtRawFunc
    "pow2_ceil"
    [IMov (OpReg Rax) (OpImm 64), ILabel ".Lrt_pow2_loop", ICmp (OpReg Rax) (OpReg Rdi), IJcc "jae" ".Lrt_pow2_done", IBinReg "shl" Rax (OpImm 1), IJmp ".Lrt_pow2_loop", ILabel ".Lrt_pow2_done", IRet]

-- ---------------------------------------------------------------
-- 效应原语（宿主层叶子 + 可变单元）
-- ---------------------------------------------------------------
-- `Eff` 的运行时壳是 base 的 `MkEff` data；这些原语只负责「做一次宿主操作」。
-- `perform` / `handle` 由库机器（`Base.Effect.Core.Control`）执行，不经 native 运行时。
-- | 可变单元（`@vuna@Cell`）：一个 8 字节槽（`[value]`）。
mrefNewFn : NativeFunc
mrefNewFn =
  rtFunc
    "mref_new"
    8
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc"), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 0)), IMov (OpMem Rax 0) (OpReg Rdx)]

mrefReadFn : NativeFunc
mrefReadFn = rtFunc "mref_read" 0 [IMov (OpReg Rax) (OpMem Rdi 0)]

-- | 写单元：先落值，再登记写屏障（老代单元指向年轻代值时，脏卡片保它）。
mrefWriteFn : NativeFunc
mrefWriteFn =
  rtFunc
    "mref_write"
    0
    [IMov (OpMem Rdi 0) (OpReg Rsi), ICall (nativeRtLabel "write_barrier"), IMov (OpReg Rax) (OpImm 0)]

-- | `print` / `eprint`：写 fd 后返回写出的字节数（OCaml 侧返回 `String.length`）。
effPrintFn : String -> Int -> NativeFunc
effPrintFn name fd =
  rtFunc
    name
    0
    [IMov (OpReg Rdx) (OpMem Rdi 0), ILeaMem Rsi Rdi 8, IMov (OpReg Rdi) (OpImm fd), IMov (OpReg Rax) (OpImm (sysNr "write")), ISyscall]

-- | `prim_erase`：运行时恒等（擦除 cast）。
-- | `@ir@m@runEff th k`：把 thunk 应用到 unit 再把结果交给 k（机器 lowering 的
-- 唯一运行时入口；wasm 侧是 `apply(apply(th, null), k)`）。
mRunEffFn : NativeFunc
mRunEffFn =
  rtFunc
    "m_run_eff"
    8
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rsi), IBinReg "sub" Rsp (OpImm 16), IMov (OpMem Rsp 0) (OpImm 0), IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 0)), IMov (OpReg Rsi) (OpImm 1), IMov (OpReg Rdx) (OpReg Rsp), ICall (nativeRtLabel "apply"), IBinReg "add" Rsp (OpImm 16), IMov (OpReg R8) (OpReg Rax), IBinReg "sub" Rsp (OpImm 16), IMov (OpReg R9) (OpMem Rbp (nativeSlotOff 1)), IMov (OpMem Rsp 0) (OpReg R9), IMov (OpReg Rdi) (OpReg R8), IMov (OpReg Rsi) (OpImm 1), IMov (OpReg Rdx) (OpReg Rsp), ICall (nativeRtLabel "apply"), IBinReg "add" Rsp (OpImm 16)]

eraseFn : NativeFunc
eraseFn = rtFunc "prim_erase" 0 [IMov (OpReg Rax) (OpReg Rdi)]

effExitFn : NativeFunc
effExitFn = rtFunc "prim_eff_exit" 0 [IMov (OpReg Rax) (OpImm (sysNr "exit")), ISyscall, IRet]

-- ---------------------------------------------------------------
-- 数组（不可变、copy-on-write）
-- ---------------------------------------------------------------
-- 布局与 wasm 侧同一决策：`[len][elem0][elem1]...`，每个元素一个机器字
-- （Int 未装箱；String / 对象 / 闭包都是指针）。`arraySet` 复制整块再写，原数组不变。
-- | 空数组 `[||]`：`[0]` = 长度 0（后续 `arraySet` 走 COW，不会原地改它）。
arrayEmptyFn : NativeFunc
arrayEmptyFn =
  rtFunc
    "array_empty"
    0
    [IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc"), IMov (OpMem Rax 0) (OpImm 0)]

arrayLengthFn : NativeFunc
arrayLengthFn = rtFunc "array_length" 0 [IMov (OpReg Rax) (OpMem Rdi 0)]

-- | `arrayGet`：rdi = 数组、rsi = 下标 -> rax = 元素；越界 trap（exit 2）。
