    "wait_pid"
    16
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IBinReg "xor" Rax (OpReg Rax), IMovFsStore nativeTcbHostStatusOff Rax, ILea Rsi statBufLabel, IBinReg "xor" Rdx (OpReg Rdx), IBinReg "xor" R10 (OpReg R10), IMov (OpReg Rax) (OpImm (sysNr "wait4")), ISyscall, IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rax), IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 0)), ICall (nativeRtLabel "child_drop"), IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 1)), ICmp (OpReg Rax) (OpImm 0), IJcc "jl" ".Lrt_wp_fail", ILea Rcx statBufLabel, IMov (OpReg Rax) (OpMem Rcx 0), IMov (OpReg Rcx) (OpReg Rax), IBinReg "and" Rcx (OpImm 127), ICmp (OpReg Rcx) (OpImm 0), IJcc "jne" ".Lrt_wp_signaled", IBinReg "shr" Rax (OpImm 8), IBinReg "and" Rax (OpImm 255), IRet, ILabel ".Lrt_wp_signaled", IMov (OpReg Rax) (OpImm 1), IRet, ILabel ".Lrt_wp_fail", IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "fs_fail"), IMov (OpReg Rax) (OpImm 1)]

-- | `rdi` = 退出码：真实退出进程（不返回）。
exitWithFn : NativeFunc
exitWithFn = rtFunc "exit_with" 0 [IMov (OpReg Rax) (OpImm (sysNr "exit")), ISyscall]

-- ---------------------------------------------------------------
-- 运行时初始化：自带栈 / 内存预算 / 核数（亲和性）/ 总超时
-- ---------------------------------------------------------------
-- `_start` 在 `vuna_main` 之前调用这些 `init_*`（见 `Native.Module.startFunc`）。
-- 配置全部来自 env，不进 codegen：同一 IR 的产物逐字节确定。
--
--   * `VUNA_NATIVE_STACK_MB`（MiB，0 = 沿用进程栈，缺省 512）
--   * `VUNA_NATIVE_MEM_LIMIT`（字节，0 = 不限，缺省 1 GiB）
--   * `VUNA_NATIVE_CPUS`（`auto` 缺省 / `0` 不限 / N）
--   * `VUNA_NATIVE_TIMEOUT_MS`（毫秒，0 = 不限，缺省不限）
--   * `VUNA_NATIVE_INHERIT`（`1` = 子进程继承上述变量）
--
-- 解析失败一律回落缺省，不阻断启动（限制器不能把程序跑不起来）。
--
-- | `rdi` = NUL 结尾的键 → `rax` = 值起点（`=` 之后），未设置时 0。
--   直接在 `envp` 上扫描，不经过分配器（`_start` 早期可用）。
envLookupFn : NativeFunc
envLookupFn =
