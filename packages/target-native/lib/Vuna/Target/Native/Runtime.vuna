heapLockFn =
  rtRawFunc
    "heap_lock_acquire"
    [IBinReg "xor" Rax (OpReg Rax), IMov (OpReg Rdx) (OpImm 1), ILockCmpxchg32 (OpRip heapLockLabel) Rdx, IJcc "je" ".Lrt_hl_done", IMov (OpReg Rax) (OpImm 2), IXchg32 (OpRip heapLockLabel) Rax, ITest Rax Rax, IJcc "jz" ".Lrt_hl_done", ILabel ".Lrt_hl_wait", ICall (nativeRtLabel "block_begin"), ILea Rdi heapLockLabel, IMov (OpReg Rsi) (OpImm futexWaitPrivate), IMov (OpReg Rdx) (OpImm 2), IBinReg "xor" R10 (OpReg R10), IMov (OpReg Rax) (OpImm (sysNr "futex")), ISyscall, ICall (nativeRtLabel "block_end"), ICall (nativeRtLabel "safepoint"), IMov (OpReg Rax) (OpImm 2), IXchg32 (OpRip heapLockLabel) Rax, ITest Rax Rax, IJcc "jnz" ".Lrt_hl_wait", ILabel ".Lrt_hl_done", IRet]

heapUnlockFn : NativeFunc
heapUnlockFn =
  rtRawFunc
    "heap_unlock"
    [IPush Rax, IBinReg "xor" Rax (OpReg Rax), IXchg32 (OpRip heapLockLabel) Rax, ICmp (OpReg Rax) (OpImm 2), IJcc "jne" ".Lrt_hu_done", ILea Rdi heapLockLabel, IMov (OpReg Rsi) (OpImm futexWakePrivate), IMov (OpReg Rdx) (OpImm 1), IMov (OpReg Rax) (OpImm (sysNr "futex")), ISyscall, ILabel ".Lrt_hu_done", IPop Rax, IRet]

