    0
    [IMov (OpReg Rdi) (OpImm 1), IMov (OpReg Rsi) (OpImm ioctlTcgets), ILea Rdx termiosLabel, IMov (OpReg Rax) (OpImm (sysNr "ioctl")), ISyscall, ICmp (OpReg Rax) (OpImm 0), ISetcc "setge" Rax, IMovzxAl]

-- | 宿主状态槽（`try*` 原语写入；0 = 成功）。
hostStatusFn : NativeFunc
hostStatusFn = rtFunc "host_status_get" 0 [IMovFsLoad Rax nativeTcbHostStatusOff]

-- | `prim_cleanupPush f`：把 thunk 压进 LIFO（节点 `[closure][next]`），返回 0。
--   正常路径由 `bracket` 自己 pop；异常/中断路径由效应机器在弹帧前跑（`Base.Effect.Core.dropCleanups`）。
cleanupPushFn : NativeFunc
cleanupPushFn =
  rtFunc
    "cleanup_push"
    8
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpReg Rdi) (OpImm 16), ICall (nativeRtLabel "alloc"), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 0)), IMov (OpMem Rax 0) (OpReg Rcx), IMov (OpReg Rcx) (OpRip cleanupHeadLabel), IMov (OpMem Rax 8) (OpReg Rcx), IMov (OpRip cleanupHeadLabel) (OpReg Rax), IMov (OpReg Rax) (OpImm 0)]

-- | `prim_cleanupPop _`：弹出栈顶（空栈无操作），返回 0。
cleanupPopFn : NativeFunc
cleanupPopFn =
  rtFunc
    "cleanup_pop"
    0
    [IMov (OpReg Rax) (OpRip cleanupHeadLabel), ITest Rax Rax, IJcc "jz" ".Lrt_cpop_done", IMov (OpReg Rax) (OpMem Rax 8), IMov (OpRip cleanupHeadLabel) (OpReg Rax), ILabel ".Lrt_cpop_done", IMov (OpReg Rax) (OpImm 0)]

-- ---------------------------------------------------------------
-- 宿主层：文件系统（syscalls + errno → 状态码）
-- ---------------------------------------------------------------
-- 语义参考 `Target.Ocaml.Term.dtp_try*`：失败不抛，写 `rt_host_status` 后返回默认值。
-- errno → 码表与 `dtp_hostCode` 一致（ENOENT=1、EACCES/EPERM=2、ENOSPC=3、
-- ENOTDIR=4、EISDIR=5、EEXIST=6、其它=9）。
-- | 临时诊断：SIGSEGV 处理（把 RIP/RSP/RBP 原样写到 stderr 后 exit 70）。
-- | errno 码表 → 宿主状态码的比较链（`hostCodeOfErrno` 是唯一真源）。
--   标签按**状态码**分组（`.Lrt_fs_e<code>`），与 `dtp_hostCode` 的分支一一对应。
fsFailCmpInstrs : List Instr
fsFailCmpInstrs =
  concatMap
    (\p => [ICmp (OpReg Rdi) (OpImm (firstOf p)), IJcc "je" (fsCodeLabel (secondOf p))])
    hostCodeOfErrno

fsCodeLabel : Int -> String
fsCodeLabel code = ".Lrt_fs_e" ++ strFromInt code

fsDoneLabel : String
fsDoneLabel = ".Lrt_fs_edone"

-- | 状态码的去重序列（首个出现的顺序即表顺序）。
fsCodeSeen : Int -> List Int -> Bool
fsCodeSeen _ [] = False
fsCodeSeen code (c :: rest) = if c == code then True else fsCodeSeen code rest

fsCodesOf : List (Int, Int) -> List Int
fsCodesOf pairs =
  List.foldl
    (\acc, p => if fsCodeSeen (secondOf p) acc then acc else append acc [secondOf p])
    []
    pairs

-- | 每个状态码的落点：最后一个省掉 `jmp`（直接落到 `fsDoneLabel`）。
fsCodeBodyInstrs : List Int -> List Instr
fsCodeBodyInstrs [] = []
fsCodeBodyInstrs (code :: rest) =
  case rest of
    [] => [ILabel (fsCodeLabel code), IMov (OpReg Rax) (OpImm code)]
    _ =>
      append
        [ILabel (fsCodeLabel code), IMov (OpReg Rax) (OpImm code), IJmp fsDoneLabel]
        (fsCodeBodyInstrs rest)

-- | `rdi` = 负 errno（syscall 返回值）→ rax = 宿主码，并写状态槽。
--   原始 errno 先写进 `rt_host_errno`，供非 try 符号还原 `<reason>` 文本。
fsFailFn : NativeFunc
fsFailFn =
  rtFunc
    "fs_fail"
    0
    (append [INeg Rdi, IMov (OpRip hostErrnoLabel) (OpReg Rdi), IMov (OpReg Rax) (OpImm hostCodeOther)] (append fsFailCmpInstrs (append [IJmp fsDoneLabel] (append (fsCodeBodyInstrs (fsCodesOf hostCodeOfErrno)) [ILabel fsDoneLabel, IMovFsStore nativeTcbHostStatusOff Rax]))))

-- ---------------------------------------------------------------
-- 非 try 宿主符号的严格失败
-- ---------------------------------------------------------------
-- `try*` 叶子把失败变成默认值 + 状态码；非 try 符号必须**显式失败**：报告
-- `vuna: runtime error: <op><path>: <reason>` 后 exit 2。首行与 OCaml `dtp_*` 抛出的
-- `Sys_error` 在 C locale 下逐字一致（native 没有报告器的 `at ...` 行）。
-- | `rdi` = Vuna String → rax = `rt_path_buf` 里的 NUL 结尾副本。
strToCFn : NativeFunc
strToCFn =
  rtFunc
    "str_to_c"
    0
    [IMov (OpReg Rcx) (OpMem Rdi 0), ICmp (OpReg Rcx) (OpImm pathMaxUsable), IJcc "jl" ".Lrt_stc_ok", ICall (nativeRtLabel "trap_path_long"), ILabel ".Lrt_stc_ok", ILeaMem Rsi Rdi 8, ILea Rdi pathBufLabel, IRepMovsb, IMovByteOp (OpMem Rdi 0) 0, ILea Rax pathBufLabel]

-- | 同 `str_to_c`，写到 `rt_path_buf2`。
