strCompareFn =
  rtFunc
    "str_compare"
    16
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rsi), IMov (OpReg Rax) (OpMem Rdi 0), IMov (OpReg Rcx) (OpMem Rsi 0), ICmp (OpReg Rax) (OpReg Rcx), ICmov "cmovle" Rcx (OpReg Rax), ILeaMem Rdi Rdi 8, ILeaMem Rsi Rsi 8, ICall (nativeRtLabel "bytes_cmp"), ICmp (OpReg Rax) (OpImm 0), IJcc "jne" ".Lrt_sc_done", IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 0)), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 1)), IMov (OpReg Rax) (OpMem Rdi 0), ICmp (OpReg Rax) (OpMem Rsi 0), IJcc "jl" ".Lrt_sc_less", IJcc "jg" ".Lrt_sc_greater", IMov (OpReg Rax) (OpImm 0), IJmp ".Lrt_sc_done", ILabel ".Lrt_sc_less", IMov (OpReg Rax) (OpImm (0 - 1)), IJmp ".Lrt_sc_done", ILabel ".Lrt_sc_greater", IMov (OpReg Rax) (OpImm 1), ILabel ".Lrt_sc_done"]

