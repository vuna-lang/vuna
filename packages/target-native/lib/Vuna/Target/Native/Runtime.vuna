    "u64_to_dec"
    32
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rsi), ICmp (OpReg Rdi) (OpImm 0), IJcc "jne" ".Lrt_u64_nonzero", IMovByteOp (OpMem Rsi 0) 48, IMovByteOp (OpMem Rsi 1) 0, IMov (OpReg Rax) (OpReg Rsi), IBinReg "add" Rax (OpImm 1), IRet, ILabel ".Lrt_u64_nonzero", IBinReg "xor" Rcx (OpReg Rcx), IMov (OpReg R8) (OpMem Rbp (nativeSlotOff 0)), ILabel ".Lrt_u64_count", IBinReg "add" Rcx (OpImm 1), IMov (OpReg Rax) (OpReg R8), IBinReg "xor" Rdx (OpReg Rdx), IMov (OpReg R9) (OpImm 10), IDivUnsigned R9, IMov (OpReg R8) (OpReg Rax), ICmp (OpReg R8) (OpImm 0), IJcc "jne" ".Lrt_u64_count", IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 1)), IBinReg "add" Rdi (OpReg Rcx), IMov (OpMem Rbp (nativeSlotOff 2)) (OpReg Rdi), IMovByteOp (OpMem Rdi 0) 0, IMov (OpReg R8) (OpMem Rbp (nativeSlotOff 0)), ILabel ".Lrt_u64_write", IMov (OpReg Rax) (OpReg R8), IBinReg "xor" Rdx (OpReg Rdx), IMov (OpReg R9) (OpImm 10), IDivUnsigned R9, IMov (OpReg R8) (OpReg Rax), IBinReg "add" Rdx (OpImm 48), IBinReg "sub" Rdi (OpImm 1), IMovByteRegOp (OpMem Rdi 0) Rdx, ICmp (OpReg R8) (OpImm 0), IJcc "jne" ".Lrt_u64_write", IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 2))]

