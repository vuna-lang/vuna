-- ---------------------------------------------------------------
-- 宿主层：进程（fork / execve / wait4）
-- ---------------------------------------------------------------
-- | `rdi` = pid：把在跑的子进程记进 `rt_child_pids`。槽满（`childSlots` 个在跑子进程）
--   时新 pid 不入表——超时仍收掉已记的组，入不了表的那个只能靠它自己退出。
childPushFn : NativeFunc
childPushFn =
  rtFunc
    "child_push"
    0
    [IMov (OpReg Rax) (OpRip childCountLabel), ICmp (OpReg Rax) (OpImm childSlots), IJcc "jae" ".Lrt_cp_done", IMov (OpReg Rcx) (OpReg Rax), IBinReg "shl" Rcx (OpImm 3), ILea Rdx childPidsLabel, IMov (OpMemX Rdx Rcx 0) (OpReg Rdi), IBinReg "add" Rax (OpImm 1), IMov (OpRip childCountLabel) (OpReg Rax), ILabel ".Lrt_cp_done", IRet]

-- | `rdi` = pid：按 pid 从 `rt_child_pids` 摘掉（该槽与最后一个槽交换，count 减一）。
--   不在表里时什么都不做（未 armed 的 fork 从未入表）。
