-- | 宿主叶子：一个实现标签 + 它在内建 / IR 里的全部名字（同一实现按名字去重）。
hostLeafGroups : List (String, List String)
hostLeafGroups =
  [
    ("cleanup_pop", ["prim_cleanupPop"]),
    ("cleanup_push", ["prim_cleanupPush"]),
    ("exec_path", ["@vuna@prim_eff_execPath", "@vuna@host@execPath"]),
    ("exit_with", ["@vuna@prim_eff_exit_process_host"]),
    ("file_exists", ["@vuna@host@fileExists"]),
    ("file_mtime", ["@vuna@host@fileMtime"]),
    ("file_size", ["@vuna@host@fileSize"]),
    ("getArgs",
      ["@vuna@prim_eff_getArgs", "@vuna@host@getArgs", "@vuna@prim_eff_getArgs_process_host"]),
    ("getcwd", ["@vuna@prim_eff_getcwd", "@vuna@host@getcwd"]),
    ("getenv", ["@vuna@prim_eff_getenv", "@vuna@host@getenv"]),
    ("host_status_get", ["@vuna@prim_eff_hostStatus"]),
    ("is_tty", ["@vuna@host@isTty"]),
    ("now_us", ["effTimeUs", "effTimeUs_host"]),
    ("prim_eff_eprint", ["@vuna@prim_eff_eprint"]),
    ("prim_eff_exit", ["@vuna@host@exitOp", "@vuna@prim_eff_exit"]),
    ("mref_new", ["@vuna@prim_mrefNew"]),
    ("prim_eff_print", ["@vuna@host@print", "@vuna@prim_eff_print"]),
    ("mref_read", ["@vuna@prim_mrefRead"]),
    ("mref_write", ["@vuna@prim_mrefWrite"]),
    ("sleep_us", ["@vuna@prim_eff_sleep", "@vuna@host@sleep"]),
    ("spawn_self", ["@vuna@prim_eff_spawn"]),
    ("tryReadDir", ["@vuna@host@tryReadDir"]),
    ("tryRunIn", ["@vuna@host@tryRunIn", "@vuna@prim_eff_runIn"]),
    ("try_is_dir", ["@vuna@host@tryIsDirectory"]),
    ("try_make_dir", ["@vuna@host@tryMakeDir"]),
    ("try_make_dir_excl", ["@vuna@host@tryMakeDirExclusive"]),
    ("try_read_file", ["@vuna@host@tryReadFile"]),
    ("try_read_file_range", ["@vuna@host@tryReadFileRange"]),
    ("try_remove_file", ["@vuna@host@tryRemoveFile"]),
    ("try_remove_tree", ["@vuna@host@tryRemoveTree"]),
    ("try_rename", ["@vuna@host@tryRename"]),
    ("try_symlink", ["@vuna@host@trySymlink"]),
    ("try_write_file", ["@vuna@host@tryWriteFile"]),
    ("try_write_file_atomic", ["@vuna@host@tryWriteFileAtomic"]),
    ("wait_pid", ["@vuna@prim_eff_wait"])
  ]

nameInGroup : String -> List String -> Bool
nameInGroup _ [] = False
nameInGroup name (n :: rest) = if n == name then True else nameInGroup name rest

hostLeafTarget : List (String, List String) -> String -> Maybe String
hostLeafTarget [] _ = Nothing
hostLeafTarget (g :: rest) sym =
  if nameInGroup sym (secondOf g) then Just (nativeRtLabel (firstOf g)) else hostLeafTarget rest sym

nativeRtTargetHost : String -> Maybe String
nativeRtTargetHost sym = hostLeafTarget hostLeafGroups sym

export nativeRtTarget : String -> Maybe String
nativeRtTarget sym =
  case nativeRtTargetHost sym of
    Just label => Just label
    Nothing => nativeRtTargetBase sym

-- | 以**运行时值**（非 `IrRtApp`）出现的符号的 arity（`irInlineArity` 为 0 的那些）。
--   `IrApp (IrRt sym) args` 只有饱和到这个 arity 才生成调用；部分应用仍拒绝。
nativeRtValueArityBase : String -> Int
