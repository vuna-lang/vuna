-- 入口打印
-- ---------------------------------------------------------------
-- | 十进制打印 rdi（含负号）+ 换行。缓冲在 rbp-64..rbp-1。
printIntFn : NativeFunc
printIntFn =
  rtFunc
    "print_int"
    64
    [IMov (OpReg R8) (OpReg Rdi), IMov (OpReg R9) (OpImm 0), ITest R8 R8, IJcc "jns" ".Lrt_pi_pos", INeg R8, IMov (OpReg R9) (OpImm 1), ILabel ".Lrt_pi_pos", IMov (OpReg Rcx) (OpReg Rbp), IMov (OpReg Rax) (OpReg R8), IMov (OpReg R10) (OpImm 10), ITest Rax Rax, IJcc "jne" ".Lrt_pi_loop", IBinReg "sub" Rcx (OpImm 1), IMov (OpReg Rdx) (OpImm 48), IMovByteRegOp (OpMem Rcx 0) Rdx, IJmp ".Lrt_pi_sign", ILabel ".Lrt_pi_loop", IBinReg "xor" Rdx (OpReg Rdx), IDivUnsigned R10, IBinReg "add" Rdx (OpImm 48), IBinReg "sub" Rcx (OpImm 1), IMovByteRegOp (OpMem Rcx 0) Rdx, ITest Rax Rax, IJcc "jne" ".Lrt_pi_loop", ILabel ".Lrt_pi_sign", ITest R9 R9, IJcc "jz" ".Lrt_pi_write", IBinReg "sub" Rcx (OpImm 1), IMov (OpReg Rdx) (OpImm 45), IMovByteRegOp (OpMem Rcx 0) Rdx, ILabel ".Lrt_pi_write", ILeaMem Rdx Rbp 0, IBinReg "sub" Rdx (OpReg Rcx), IMov (OpReg Rsi) (OpReg Rcx), IMov (OpReg Rax) (OpImm (sysNr "write")), IMov (OpReg Rdi) (OpImm 1), ISyscall, IMov (OpReg Rax) (OpImm (sysNr "write")), IMov (OpReg Rdi) (OpImm 1), ILea Rsi (nativeDataLabel "nl"), IMov (OpReg Rdx) (OpImm 1), ISyscall, IRet]

-- | 打印 rdi 为 True/False + 换行。
printBoolFn : NativeFunc
printBoolFn =
  rtFunc
    "print_bool"
    0
    [ILea Rsi (nativeDataLabel "false"), IMov (OpReg Rdx) (OpImm (strLength "False")), ITest Rdi Rdi, IJcc "jz" ".Lrt_pb_write", ILea Rsi (nativeDataLabel "true"), IMov (OpReg Rdx) (OpImm (strLength "True")), ILabel ".Lrt_pb_write", IMov (OpReg Rax) (OpImm (sysNr "write")), IMov (OpReg Rdi) (OpImm 1), ISyscall, IMov (OpReg Rax) (OpImm (sysNr "write")), IMov (OpReg Rdi) (OpImm 1), ILea Rsi (nativeDataLabel "nl"), IMov (OpReg Rdx) (OpImm 1), ISyscall, IRet]

-- | 打印 rdi 为 String（原样字节）+ 换行。
printStrFn : NativeFunc
printStrFn =
  rtFunc
    "print_str"
    0
    [IMov (OpReg Rdx) (OpMem Rdi 0), ILeaMem Rsi Rdi 8, IMov (OpReg Rdi) (OpImm 1), IMov (OpReg Rax) (OpImm (sysNr "write")), ISyscall, IMov (OpReg Rax) (OpImm (sysNr "write")), IMov (OpReg Rdi) (OpImm 1), ILea Rsi (nativeDataLabel "nl"), IMov (OpReg Rdx) (OpImm 1), ISyscall, IRet]

-- | 一次分配需要的块尺寸（`rax` = payload + 块头向上取整；`rcx` = 尺寸类；`r8` = 类序号）。
--   payload 字节数在 `rt_alloc_req`（`alloc` 在任何分配/G C 之前存下）。
allocClassInstrs : String -> List Instr
allocClassInstrs tag =
  [
    IMov (OpReg Rax) (OpRip allocReqLabel),
    IBinReg "add" Rax (OpImm (nativeBlockHeaderBytes + 15)),
    IBinReg "and" Rax (OpImm (0 - 16)),
    IMov (OpReg Rcx) (OpImm nativeMinBlockBytes),
    IBinReg "xor" R8 (OpReg R8),
    ILabel ".Lrt_alloc_class_${tag}",
    ICmp (OpReg Rcx) (OpReg Rax),
    IJcc "jae" ".Lrt_alloc_class_${tag}_done",
    IBinReg "shl" Rcx (OpImm 1),
    IBinReg "add" R8 (OpImm 1),
    IJmp ".Lrt_alloc_class_${tag}",
    ILabel ".Lrt_alloc_class_${tag}_done"
  ]

-- | 对象分配：`rdi` = payload 字节数 -> `rax` = 对象地址（块头之后）。
--   预算按 `live + 已分配 + 本次` 检查（超限先强制整堆回收，仍超才 trap）；阈值/压力开关触发 GC；
--   空闲块按尺寸类复用，都不行才在本段 bump，本段不够就开新段。
--   和其它运行时入口一样按 caller-saved 约定：调用方把活值放在栈槽里，GC 从帧保守扫根，
--   寄存器不承担跨调用存活（`rdi` 只用于在 GC 后重读请求尺寸）。
allocFn : NativeFunc
allocFn =
  rtRawFunc
    "alloc"
