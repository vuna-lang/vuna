    64
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rsi), IMov (OpMem Rbp (nativeSlotOff 2)) (OpReg Rdx), ICmp (OpReg Rsi) (OpImm 0), IJcc "jl" (nativeRtLabel "trap_array_oob"), ICmp (OpReg Rsi) (OpMem Rdi 0), IJcc "jge" (nativeRtLabel "trap_array_oob"), IMov (OpReg Rcx) (OpMem Rdi 0), IMov (OpMem Rbp (nativeSlotOff 3)) (OpReg Rcx), IMov (OpReg Rdi) (OpReg Rcx), IBinReg "add" Rdi (OpImm 1), IBinReg "shl" Rdi (OpImm 3), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (nativeSlotOff 4)) (OpReg Rax), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 3)), IMov (OpMem Rax 0) (OpReg Rcx), ILeaMem Rdi Rax 8, IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 0)), ILeaMem Rsi Rsi 8, IBinReg "shl" Rcx (OpImm 3), IRepMovsb, IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 4)), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 2)), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 1)), IBinReg "shl" Rcx (OpImm 3), ILeaMem Rax Rax 8, IMov (OpMemX Rax Rcx 0) (OpReg Rdx), IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 4))]

