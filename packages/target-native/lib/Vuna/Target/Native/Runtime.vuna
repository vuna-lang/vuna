    "str_copy_into"
    8
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rsi), IMov (OpReg Rcx) (OpMem Rdi 0), ILeaMem Rsi Rdi 8, IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 0)), IRepMovsb, IMovByteOp (OpMem Rdi 0) 0, IMov (OpReg Rax) (OpReg Rdi)]

