    "child_drop"
    0
    [IMov (OpReg R9) (OpRip childCountLabel), ITest R9 R9, IJcc "jz" ".Lrt_cd_done", ILea R10 childPidsLabel, IBinReg "xor" Rcx (OpReg Rcx), ILabel ".Lrt_cd_loop", ICmp (OpReg Rcx) (OpReg R9), IJcc "jge" ".Lrt_cd_done", IMov (OpReg Rax) (OpReg Rcx), IBinReg "shl" Rax (OpImm 3), IMov (OpReg Rdx) (OpMemX R10 Rax 0), ICmp (OpReg Rdx) (OpReg Rdi), IJcc "je" ".Lrt_cd_hit", IBinReg "add" Rcx (OpImm 1), IJmp ".Lrt_cd_loop", ILabel ".Lrt_cd_hit", IBinReg "sub" R9 (OpImm 1), IMov (OpReg Rdx) (OpReg R9), IBinReg "shl" Rdx (OpImm 3), IMov (OpReg R8) (OpMemX R10 Rdx 0), IMov (OpMemX R10 Rax 0) (OpReg R8), IMov (OpRip childCountLabel) (OpReg R9), ILabel ".Lrt_cd_done", IRet]

-- | `rt_sigprocmask(SIG_BLOCK, rt_sigalrm_set, NULL, 8)`：fork 之前屏蔽 SIGALRM。
--   集合为 0（未装定时器）时等于不动。
