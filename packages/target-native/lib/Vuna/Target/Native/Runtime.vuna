strToC2Fn =
  rtFunc
    "str_to_c2"
    0
    [IMov (OpReg Rcx) (OpMem Rdi 0), ICmp (OpReg Rcx) (OpImm pathMaxUsable), IJcc "jl" ".Lrt_stc2_ok", ICall (nativeRtLabel "trap_path_long"), ILabel ".Lrt_stc2_ok", ILeaMem Rsi Rdi 8, ILea Rdi pathBuf2Label, IRepMovsb, IMovByteOp (OpMem Rdi 0) 0, ILea Rax pathBuf2Label]

-- | `rdi` = Vuna String、`rsi` = 目的缓冲 → rax = 目的端（指向新 NUL）。
