module Vuna.Target.Native.Render where

-- Vuna.Target.Native.Render：NativeProgram -> Intel 语法汇编文件集。
--
-- 输出是 canonical 的（D16 同构）：段顺序、缩进、指令文本固定；不嵌入时间戳/
-- 绝对路径，同一 IR 的文件集逐字节确定。`.wasm` 之于 wasm 相当于这里的 ELF：
-- 二进制只保证行为（链接工具版本由 Nix 提供）。
--
-- 版面：`runtime.s`（`.rodata` 运行时常量 → `.bss` → `.text` 运行时函数），每个模块一个
-- `<Module/Path>.s`（自己的 `.rodata` 字面量池 + `.text` 函数）；每个文件以
-- `.intel_syntax noprefix` 开头、`.note.GNU-stack` 结尾。
--
-- 边界：只 import Base 与 `Native.{Model,Abi}`。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Target.Native.Model

-- ---------------------------------------------------------------
-- 文本 helper
-- ---------------------------------------------------------------
indent : String -> String
indent line = "  " ++ line

memText : Reg -> Int -> String
memText base off =
  if off == 0 then
    "[${regText base}]"
  else if off < 0 then
    "[${regText base}-${strFromInt (0 - off)}]"
  else
    "[${regText base}+${strFromInt off}]"

memXText : Reg -> Reg -> Int -> String
memXText base idx off =
  if off == 0 then
    "[${regText base}+${regText idx}]"
  else if off < 0 then
    "[${regText base}+${regText idx}-${strFromInt (0 - off)}]"
  else
    "[${regText base}+${regText idx}+${strFromInt off}]"

renderOperand : Operand -> String
renderOperand (OpReg r) = regText r
renderOperand (OpImm n) = strFromInt n
renderOperand (OpMem base off) = memText base off
renderOperand (OpMemX base idx off) = memXText base idx off
renderOperand (OpRip label) = "[rip + ${label}]"

isMemOperand : Operand -> Bool
isMemOperand (OpMem _ _) = True
isMemOperand (OpMemX _ _ _) = True
isMemOperand _ = False

renderMov : Operand -> Operand -> String
renderMov dst src =
  if isMemOperand dst then
    "mov qword ptr ${renderOperand dst}, ${renderOperand src}"
  else
    "mov ${renderOperand dst}, ${renderOperand src}"

isShiftOp : String -> Bool
isShiftOp op = op == "shl" || op == "shr" || op == "sar"

renderBinReg : String -> Reg -> Operand -> String
renderBinReg op r (OpReg Rcx) =
  if isShiftOp op then
    "${op} ${regText r}, cl"
  else
    "${op} ${regText r}, ${renderOperand (OpReg Rcx)}"
renderBinReg op r operand = "${op} ${regText r}, ${renderOperand operand}"

renderByteOp : Operand -> String
renderByteOp op = "byte ptr ${renderOperand op}"

renderInstr : Instr -> String
renderInstr (IMov dst src) = renderMov dst src
renderInstr (IMovByteOp op imm) = "mov ${renderByteOp op}, ${strFromInt imm}"
renderInstr (IMovByteRegOp op src) = "mov ${renderByteOp op}, ${reg8Text src}"
renderInstr (IMovzx dst src) = "movzx ${regText dst}, ${renderByteOp src}"
renderInstr IMovzxAl = "movzx rax, al"
renderInstr (ILea r label) = "lea ${regText r}, [rip + ${label}]"
renderInstr (ILeaMem dst base off) = "lea ${regText dst}, ${memText base off}"
renderInstr (IBin op operand) = "${op} rax, ${renderOperand operand}"
renderInstr (IBinReg op r operand) = renderBinReg op r operand
renderInstr (ICmp dst src) =
  if isMemOperand dst then
    "cmp qword ptr ${renderOperand dst}, ${renderOperand src}"
  else
    "cmp ${renderOperand dst}, ${renderOperand src}"
renderInstr (ITest a b) = "test ${regText a}, ${regText b}"
renderInstr (ISetcc cond r) = "${cond} ${reg8Text r}"
renderInstr (INeg r) = "neg ${regText r}"
renderInstr ICqo = "cqo"
renderInstr (IDiv r) = "idiv ${regText r}"
renderInstr (IDivUnsigned r) = "div ${regText r}"
renderInstr IRepMovsb = "rep movsb"
renderInstr IRepeCmpsb = "repe cmpsb"
renderInstr (ILabel l) = "${l}:"
renderInstr (IJmp l) = "jmp ${l}"
renderInstr (IJmpReg r) = "jmp ${regText r}"
renderInstr (IJcc cond l) = "${cond} ${l}"
renderInstr (ICall l) = "call ${l}"
renderInstr (ICallReg r) = "call ${regText r}"
renderInstr (IXmmLoad n op) = "movsd xmm${strFromInt n}, qword ptr ${renderOperand op}"
renderInstr (IXmmStore op n) = "movsd qword ptr ${renderOperand op}, xmm${strFromInt n}"
renderInstr (IXmmFromInt n r) = "cvtsi2sd xmm${strFromInt n}, ${regText r}"
renderInstr (IXmmToInt r n) = "cvttsd2si ${regText r}, xmm${strFromInt n}"
renderInstr (IXmmBin op d s) = "${op}sd xmm${strFromInt d}, xmm${strFromInt s}"
renderInstr (IXmmUnop op n) = "${op}sd xmm${strFromInt n}, xmm${strFromInt n}"
renderInstr (IXmmCmp a b) = "ucomisd xmm${strFromInt a}, xmm${strFromInt b}"
renderInstr (IXmmToReg r n) = "movq ${regText r}, xmm${strFromInt n}"
renderInstr (IXmmFromReg n r) = "movq xmm${strFromInt n}, ${regText r}"
renderInstr IRet = "ret"
renderInstr ISyscall = "syscall"
renderInstr (IPush r) = "push ${regText r}"
renderInstr (IPop r) = "pop ${regText r}"
renderInstr INop = "nop"

-- ---------------------------------------------------------------
-- 字符串 -> `.ascii` 字面量
-- ---------------------------------------------------------------
-- | 转义：引号与反斜杠用 `\"` / `\\`；可打印 ASCII 原样；其余字节写成三位八进制
-- `\NNN`（固定三位，避免与后续数字粘成一个转义序列）。
asmEscapeChar : Int -> String
asmEscapeChar 34 = "\\\""
asmEscapeChar 92 = "\\\\"
asmEscapeChar c = if c >= 32 && c <= 126 then strPack [c] else "\\${padOct c}"

padOct : Int -> String
padOct c =
  let
    a = c / 64
    b = c / 8 - a * 8
    d = c - a * 64 - b * 8
  in "${strFromInt a}${strFromInt b}${strFromInt d}"

asmString : String -> String
asmString s = strPack (concatMap (\c => strUnpack (asmEscapeChar c)) (strUnpack s))

renderRodata : NativeRodata -> List String
renderRodata d = [".globl ${d.nrLabel}", "${d.nrLabel}:", indent ".ascii \"${asmString d.nrText}\""]

-- | 字符串字面量：长度头（`.quad` 字节数）+ `.ascii` 体；运行时值是头地址。
renderStrLit : NativeStrLit -> List String
renderStrLit l =
  [
    "${l.nsLabel}:",
    indent ".quad ${strFromInt (strLength l.nsText)}",
    indent ".ascii \"${asmString l.nsText}\""
  ]

renderBss : NativeBss -> List String
renderBss b =
  let
    alignLine = if b.nbAlign > 0 then [".align ${strFromInt b.nbAlign}"] else []
    dataLine = if b.nbSize > 0 then [indent ".zero ${strFromInt b.nbSize}"] else []
  in append [".globl ${b.nbLabel}"] (append alignLine (append ["${b.nbLabel}:"] dataLine))

renderClosure : NativeClosure -> List String
renderClosure c =
  [
    ".globl ${c.ncLabel}",
    "${c.ncLabel}:",
    indent ".quad ${c.ncCode}",
    indent ".quad ${strFromInt c.ncArity}"
  ]

-- | GC 栈图：`[count][slot0]…`；标签是文件局部 `.Lgc_<n>`。
renderMap : NativeMap -> List String
renderMap m =
  append
    [".align 8", "${m.nmLabel}:", indent ".quad ${strFromInt (length m.nmSlots)}"]
    (map (\s => indent ".quad ${strFromInt s}") m.nmSlots)

mapsOfFunc : NativeFunc -> List NativeMap
mapsOfFunc f = f.nfMaps

-- | 函数标签跨文件可见（模块之间的调用、`_start` 调 `main`），所以全部 `.globl`。
renderFunc : NativeFunc -> List String
renderFunc f =
  append [".globl ${f.nfLabel}", "${f.nfLabel}:"] (map (\i => indent (renderInstr i)) f.nfBody)

-- ---------------------------------------------------------------
-- 程序
-- ---------------------------------------------------------------
-- | 非空判断（避免输出空的 `.section .rodata` / `.section .bss`）。
isEmpty : List a -> Bool
isEmpty [] = True
isEmpty _ = False

memString : String -> List String -> Bool
memString _ [] = False
memString s (x :: rest) = s == x || memString s rest

moduleKeyOfFunc : NativeFunc -> String
moduleKeyOfFunc f = join "." f.nfModule

pushModuleKey : List String -> String -> List String
pushModuleKey keys k = if memString k keys then keys else append keys [k]

-- | 模块按首次出现顺序；runtime 函数的 `nfModule` 是 `["runtime"]`，所以 `runtime.s` 排第一。
moduleKeysOf : List NativeFunc -> List String
moduleKeysOf fs = foldl pushModuleKey [] (map moduleKeyOfFunc fs)

funcsOfKey : String -> List NativeFunc -> List NativeFunc
funcsOfKey key = filter (\f => moduleKeyOfFunc f == key)

litsOfKey : String -> List (Pair (List String) (List NativeStrLit)) -> List NativeStrLit
litsOfKey _ [] = []
litsOfKey key (p :: rest) = if join "." (firstOf p) == key then secondOf p else litsOfKey key rest

-- | 模块 key -> 相对文件路径：`runtime` -> `runtime.s`，`A.B` -> `A/B.s`。
fileOfKey : String -> String
fileOfKey key = join "/" (split "." key) ++ ".s"

renderProgramFile : NativeProgram -> String -> String
renderProgramFile p key =
  let
    isRuntime = key == "runtime"
    funcs = funcsOfKey key p.npFuncs
    rodataLits = concatMap renderStrLit (litsOfKey key p.npModuleLits)
    rodataMaps = concatMap renderMap (concatMap mapsOfFunc funcs)
    rodataConsts = if isRuntime then concatMap renderRodata p.npRodata else []
    rodataClosures = if isRuntime then concatMap renderClosure p.npClosures else []
    rodataPart = append rodataConsts (append rodataClosures (append rodataLits rodataMaps))
    rodataSection = if isEmpty rodataPart then [] else ".section .rodata" :: rodataPart
    bssPart = if isRuntime then concatMap renderBss p.npBss else []
    bssSection = if isEmpty bssPart then [] else ".section .bss" :: bssPart
    textSection = ".section .text" :: concatMap renderFunc funcs
    body = append [".intel_syntax noprefix"] (append rodataSection (append bssSection textSection))
  in join "\n" (append body [".section .note.GNU-stack,\"\",@progbits"]) ++ "\n"

-- | 程序 -> 文件集（相对路径, 文本）。`runtime.s` 携带 `.rodata` 常量、`.bss` 与
--   运行时函数；每个模块文件携带自己的字面量池与函数。同一 IR 的输出逐字节确定。
export renderFiles : NativeProgram -> List (Pair String String)
renderFiles p = map (\k => Pair (fileOfKey k) (renderProgramFile p k)) (moduleKeysOf p.npFuncs)
