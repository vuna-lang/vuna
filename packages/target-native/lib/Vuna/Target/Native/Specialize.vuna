module Vuna.Target.Native.Specialize where

-- 高阶参数特化：整程序 IR 在手里，调用点上函数实参**静态已知**（无自由变量的 lambda /
-- 顶层函数 / 运行时叶子 / 已知定义的部分应用）时，克隆被调定义并把那个形参替换成已知
-- 函数值，于是 `twice f x = f (f x)` / `foldl f` 里的 `f` 变成直调（不再每次按闭包 arity
-- 分派）。
--
-- 只替换**闭合**的函数值与**闭合**的已知部分应用（`mk 3`）：把带自由变量的值搬进
-- 被调函数体会丢捕获；部分应用的实参只收平凡值或可重复求值的标量表达式，替换复制进
-- 体里才不会重复求值昂贵的表达式。替换后体里的 `(mk k) x` 会由 `flattenApp` 合回
-- `mk k x`，再交给调用点内联。克隆按（被调名、形参序号、实参指纹）去重；每个原始定义
-- 最多 8 个克隆、整程序最多 64 个，超出的调用点保持原样（语义不变，只丢优化）。
-- 被特化的形参已替换进克隆体，克隆不再接收它，调用点相应丢掉那个实参。
--
-- 边界：只 import Base 与 `Ir.Model` / `Ir.Analysis`；不 import 编译器阶段与任何后端。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Ir.Analysis as Analysis
import Vuna.Ir.Model
import Vuna.Ir.Synthetic as Synthetic

-- ---------------------------------------------------------------
-- 自由变量（判断函数值是否闭合）
-- ---------------------------------------------------------------
idsOf : List IrBinder -> List Int
idsOf [] = []
idsOf (b :: rest) = b.irBinderId :: idsOf rest

freeVarsOf : Ir -> List Int
freeVarsOf ir = freeVarsIn [] ir

freeVarsIn : List Int -> Ir -> List Int
freeVarsIn env (IrVar b) = if memInt b.irBinderId env then [] else [b.irBinderId]
freeVarsIn env (IrLam bs _ body) = freeVarsIn (append (idsOf bs) env) body
freeVarsIn env (IrLet bs scrut body) =
  append (freeVarsIn env scrut) (freeVarsIn (append (idsOf bs) env) body)
freeVarsIn env (IrApp _ f a) = append (freeVarsIn env f) (freeVarsIn env a)
freeVarsIn env (IrCase _ _ scrut alts) =
  append (freeVarsIn env scrut) (concatMap (freeVarsAlt env) alts)
freeVarsIn env (IrNatCase scrut _ z s c) =
  append
    (freeVarsIn env scrut)
    (append (freeVarsAltMaybe env z) (append (freeVarsAltMaybe env s) (freeVarsAltMaybe env c)))
freeVarsIn env (IrEffThunk _ _ _ _ prim) = freeVarsIn env prim
freeVarsIn env (IrCtor _ _ _ args) = concatMap (freeVarsIn env) args
freeVarsIn env (IrRecord _ _ fields) = concatMap (freeVarsField env) fields
freeVarsIn env (IrProj base _ _ _) = freeVarsIn env base
freeVarsIn env (IrRecUpd base _ fields _) =
  append (freeVarsIn env base) (concatMap (freeVarsField env) fields)
freeVarsIn env (IrRtApp _ args) = concatMap (freeVarsIn env) args
freeVarsIn env (IrCast _ _ inner) = freeVarsIn env inner
freeVarsIn env (IrTail inner) = freeVarsIn env inner
freeVarsIn env (IrIf c t e) =
  append (freeVarsIn env c) (append (freeVarsIn env t) (freeVarsIn env e))
freeVarsIn env (IrConcatMany parts) = concatMap (freeVarsIn env) parts
freeVarsIn _ _ = []

freeVarsField : List Int -> (String, Ir) -> List Int
freeVarsField env p = freeVarsIn env (secondOf p)

freeVarsAlt : List Int -> IrAlt -> List Int
freeVarsAlt env alt = freeVarsIn (append (idsOf alt.irAltBinders) env) alt.irAltBody

freeVarsAltMaybe : List Int -> Maybe IrAlt -> List Int
freeVarsAltMaybe _ Nothing = []
freeVarsAltMaybe env (Just alt) = freeVarsAlt env alt

-- ---------------------------------------------------------------
-- 结构指纹（去重键与自递归改写共用）
-- ---------------------------------------------------------------
--
-- 特化按「实参指纹」判断两个调用点拿到的是不是同一个值：去重键、以及克隆体里
-- 自递归能否改指克隆，都只靠键相等。因此指纹必须对**所有**参与替换的闭合值可
-- 区分——键相等 ⇒ 值相同。只按 binder 身份记 lambda 是不够的：同一个 lambda 节点
-- 在不同克隆里被替换成不同闭合值后（`\i => f (Succ i)` 逐层嵌套），binder 仍在同一
-- 位置，键会相撞，克隆被复用到别的值上（`Vec.tabulate` 的下标从第二个元素起就错）。
-- 这里编码整棵 IR 的结构；`wrapKey` 给出长度前缀，拼接后不会产生歧义。
-- `IrApp` 的类型槽不进键：`rewriteSelf` 用 `Synthetic.applyAllIr` 重建调用时会把它
-- 归一成 `Nothing`，键必须对这种重建稳定，否则克隆体里的自递归认不出自己、白多建克隆。
wrapKey : String -> String
wrapKey s = strFromInt (strLength s) ++ ":" ++ s

-- | 完整结构指纹：同一份 IR 得到同一串，不同结构得到不同串。
irKey : Ir -> String
irKey ir = wrapKey (irKeyBody ir)

irKeyBody : Ir -> String
irKeyBody (IrVar b) = "v" ++ binderKey b
irKeyBody (IrGlobal n) = "g" ++ wrapKey n
irKeyBody (IrCtor fam ctor ty args) =
  "c" ++ wrapKey fam ++ wrapKey ctor ++ tyListKey ty ++ irsKey args
irKeyBody (IrRecord fam ty fields) = "d" ++ wrapKey fam ++ tyKey ty ++ fieldsKey fields
irKeyBody (IrProj base fam field ty) = "j" ++ irKey base ++ wrapKey fam ++ wrapKey field ++ tyKey ty
irKeyBody (IrRecUpd base fam fields ty) =
  "u" ++ irKey base ++ wrapKey fam ++ fieldsKey fields ++ tyKey ty
irKeyBody (IrRt s) = "t" ++ wrapKey s
irKeyBody (IrRtApp s args) = "T" ++ wrapKey s ++ irsKey args
irKeyBody (IrCast from to inner) = "C" ++ tyKey from ++ tyKey to ++ irKey inner
irKeyBody (IrInt n) = "i" ++ wrapKey (strFromInt n)
irKeyBody (IrStr s) = "s" ++ wrapKey s
irKeyBody (IrBool b) = if b then "B1" else "B0"
irKeyBody (IrFloatLit s) = "f" ++ wrapKey s
irKeyBody (IrLet bs scrut body) = "l" ++ bindersKey bs ++ irKey scrut ++ irKey body
irKeyBody (IrLam bs ty body) = "L" ++ bindersKey bs ++ tyKey ty ++ irKey body
irKeyBody (IrApp _ f a) = "a" ++ irKey f ++ irKey a
irKeyBody (IrTail inner) = "e" ++ irKey inner
irKeyBody (IrIf c t e) = "I" ++ irKey c ++ irKey t ++ irKey e
irKeyBody (IrCase sty rty scrut alts) = "K" ++ tyKey sty ++ tyKey rty ++ irKey scrut ++ altsKey alts
irKeyBody (IrNatCase scrut fresh z s c) =
  "N"
    ++ irKey scrut ++ wrapKey (strFromInt fresh) ++ altMaybeKey z ++ altMaybeKey s ++ altMaybeKey c
irKeyBody (IrConcatMany parts) = "y" ++ irsKey parts
irKeyBody (IrEffThunk fam ctor ty arity prim) =
  "h" ++ wrapKey fam ++ wrapKey ctor ++ tyKey (Just ty) ++ wrapKey (strFromInt arity) ++ irKey prim
irKeyBody (IrEffBind fam ctor ty) = "b" ++ wrapKey fam ++ wrapKey ctor ++ tyKey (Just ty)

-- 子键序列：`0` = 空，`1` = 非空；每个元素键自带长度前缀，拼接无歧义。
irsKey : List Ir -> String
irsKey [] = "0"
irsKey (x :: rest) = "1" ++ irKey x ++ irsKey rest

fieldsKey : List (String, Ir) -> String
fieldsKey [] = "0"
fieldsKey (p :: rest) = "1" ++ wrapKey (firstOf p) ++ irKey (secondOf p) ++ fieldsKey rest

altsKey : List IrAlt -> String
altsKey [] = "0"
altsKey (a :: rest) = "1" ++ altKey a ++ altsKey rest

binderKey : IrBinder -> String
binderKey b =
  wrapKey (strFromInt b.irBinderId) ++ (if b.irBinderErased then "e" else "r") ++ tyKey b.irBinderTy

bindersKey : List IrBinder -> String
bindersKey [] = "0"
bindersKey (b :: rest) = "1" ++ binderKey b ++ bindersKey rest

altKey : IrAlt -> String
altKey alt = wrapKey (ctorKeyOf alt.irAltCtor) ++ bindersKey alt.irAltBinders ++ irKey alt.irAltBody

altMaybeKey : Maybe IrAlt -> String
altMaybeKey Nothing = "0"
altMaybeKey (Just alt) = "1" ++ altKey alt

ctorKeyOf : Maybe (String, String) -> String
ctorKeyOf Nothing = "0"
ctorKeyOf (Just p) = "1" ++ wrapKey (firstOf p) ++ wrapKey (secondOf p)

tyKey : Maybe IrTy -> String
tyKey Nothing = "0"
tyKey (Just t) = "1" ++ tyKey1 t

tyListKey : Maybe (List IrTy) -> String
tyListKey Nothing = "0"
tyListKey (Just ts) = "1" ++ tysKey ts

tysKey : List IrTy -> String
tysKey [] = "0"
tysKey (t :: rest) = "1" ++ tyKey1 t ++ tysKey rest

tyKey1 : IrTy -> String
tyKey1 (IrTyVar i) = "v" ++ wrapKey (strFromInt i)
tyKey1 IrTyInt = "i"
tyKey1 IrTyStr = "s"
tyKey1 IrTyBool = "b"
tyKey1 IrTyFloat = "f"
tyKey1 IrTyOpaque = "o"
tyKey1 (IrTyArray a) = "a" ++ wrapKey (tyKey1 a)
tyKey1 (IrTyRef a) = "r" ++ wrapKey (tyKey1 a)
tyKey1 (IrTyData n args) = "d" ++ wrapKey n ++ tysKey args
tyKey1 (IrTyFun d c) = "F" ++ wrapKey (tyKey1 d) ++ wrapKey (tyKey1 c)

-- ---------------------------------------------------------------
-- 已知的闭合函数值
-- ---------------------------------------------------------------
-- | 一个实参是不是「静态已知的闭合函数值」，是则返回它的结构指纹（克隆去重用）。
--   指纹见 `irKey`：同一个值（含克隆里被复制的同一份）指纹相同，结构不同则指纹不同。
fnKeyOf : List IrDef -> Ir -> Maybe String
fnKeyOf defs ir =
  case ir of
    IrGlobal n => if existsDef n defs then Just (irKey ir) else Nothing
    IrRt s => Just (irKey ir)
    IrLam bs _ body => if isEmptyList (freeVarsIn (idsOf bs) body) then Just (irKey ir) else Nothing
    -- 已知顶层定义的**部分应用**（`mk k`）：把形参换成它之后，体里对形参的饱和应用
    -- 会经 `flattenApp` 合到同一 head 上，再交给调用点内联。只收闭合的部分应用：
    -- 克隆是独立的顶层函数，把调用方的局部 binder 搬进去会变成未绑定。
    IrApp _ _ _ =>
      let
        p = Analysis.flattenApp ir
      in case firstOf p of
        IrGlobal n =>
          case partialArity n defs of
            Just arity =>
              let
                args = secondOf p
              in if not (isEmptyList args) && length args < arity && allSimpleArg args && isEmptyList (freeVarsOf ir) then
                Just (irKey ir)
              else
                Nothing
            Nothing => Nothing
        _ => Nothing
    -- lambda 自己的形参是绑定的：自由变量要看体里引用了**外层**哪些 binder。
    _ => Nothing

-- | 顶层定义在 CPS 后的运行时 binder 数（部分应用判定用）。
partialArity : String -> List IrDef -> Maybe Int
partialArity n defs =
  case findDef n defs of
    Just (IrDef _ _ _ _ (IrLam bs _ _) _ _ _) => Just (length (runtimeBindersOf bs))
    _ => Nothing

-- | 部分应用的实参只收平凡值：特化会把实参复制进体里，复杂表达式不在这里重复求值。
allSimpleArg : List Ir -> Bool
allSimpleArg [] = True
allSimpleArg (a :: rest) = if simpleArg a then allSimpleArg rest else False

simpleArg : Ir -> Bool
simpleArg (IrVar _) = True
simpleArg (IrGlobal _) = True
simpleArg (IrRt _) = True
simpleArg (IrInt _) = True
simpleArg (IrStr _) = True
simpleArg (IrBool _) = True
simpleArg (IrFloatLit _) = True
simpleArg (IrRtApp sym args) =
  if isDivLike sym then
    divisorSafe args && allSimpleArg args
  else
    memStr sym scalarArgSyms && allSimpleArg args
simpleArg _ = False

-- | 可重复求值的标量运行时符号（与 `Inline` 的实参判据同口径）。
scalarArgSyms : List String
scalarArgSyms =
  [
    "+",
    "-",
    "*",
    "bitAnd",
    "bitOr",
    "bitXor",
    "bitNot",
    "bitShl",
    "bitShr",
    "bi_eq_int",
    "bi_neq_int",
    "bi_lt_int",
    "bi_le_int",
    "bi_gt_int",
    "bi_ge_int",
    "bi_eq_bool",
    "bi_neq_bool",
    "bi_lt_bool",
    "bi_le_bool",
    "bi_gt_bool",
    "bi_ge_bool",
    "natAdd",
    "natSub",
    "natMul",
    "natToInt",
    "natFromInt"
  ]

isDivLike : String -> Bool
isDivLike "/" = True
isDivLike "%" = True
isDivLike "mod" = True
isDivLike _ = False

divisorSafe : List Ir -> Bool
divisorSafe [_, IrInt d] = d /= 0
divisorSafe _ = False

-- | 只保留运行时 binder（擦除占位不占参数位）。
runtimeBindersOf : List IrBinder -> List IrBinder
runtimeBindersOf [] = []
runtimeBindersOf (b :: rest) =
  if b.irBinderErased then runtimeBindersOf rest else b :: runtimeBindersOf rest

existsDef : String -> List IrDef -> Bool
existsDef _ [] = False
existsDef n (d :: rest) = if irDefName d == n then True else existsDef n rest

findDef : String -> List IrDef -> Maybe IrDef
findDef _ [] = Nothing
findDef n (d :: rest) = if irDefName d == n then Just d else findDef n rest

-- ---------------------------------------------------------------
-- 形参：函数类型 + 在体里被当 head 应用
-- ---------------------------------------------------------------
isFunTy : Maybe IrTy -> Bool
isFunTy (Just (IrTyFun _ _)) = True
isFunTy _ = False

-- ---------------------------------------------------------------
-- 替换（按 binder 身份）
-- ---------------------------------------------------------------
substIr : Int -> Ir -> Ir -> Ir
substIr id repl (IrVar b) = if b.irBinderId == id then repl else IrVar b
substIr id repl (IrLam bs rt body) = IrLam bs rt (substIr id repl body)
substIr id repl (IrLet bs scrut body) = IrLet bs (substIr id repl scrut) (substIr id repl body)
substIr id repl (IrApp ty f a) = IrApp ty (substIr id repl f) (substIr id repl a)
substIr id repl (IrIf c t e) = IrIf (substIr id repl c) (substIr id repl t) (substIr id repl e)
substIr id repl (IrCase ty k scrut alts) =
  IrCase ty k (substIr id repl scrut) (map (\a => substAlt id repl a) alts)
substIr id repl (IrNatCase scrut f z s c) =
  IrNatCase
    (substIr id repl scrut)
    f
    (substAltMaybe id repl z)
    (substAltMaybe id repl s)
    (substAltMaybe id repl c)
substIr id repl (IrCtor fam ctor ty args) = IrCtor fam ctor ty (map (\x => substIr id repl x) args)
substIr id repl (IrRecord fam ty fields) =
  IrRecord fam ty (map (\p => (firstOf p, substIr id repl (secondOf p))) fields)
substIr id repl (IrProj base fam field ty) = IrProj (substIr id repl base) fam field ty
substIr id repl (IrRecUpd base fam fields ty) =
  IrRecUpd
    (substIr id repl base)
    fam
    (map (\p => (firstOf p, substIr id repl (secondOf p))) fields)
    ty
substIr id repl (IrRtApp sym args) = IrRtApp sym (map (\x => substIr id repl x) args)
substIr id repl (IrCast from to inner) = IrCast from to (substIr id repl inner)
substIr id repl (IrTail inner) = IrTail (substIr id repl inner)
substIr id repl (IrConcatMany parts) = IrConcatMany (map (\x => substIr id repl x) parts)
substIr id repl (IrEffThunk fam ctor ty arity prim) =
  IrEffThunk fam ctor ty arity (substIr id repl prim)
substIr _ _ other = other

substAlt : Int -> Ir -> IrAlt -> IrAlt
substAlt id repl alt = IrAlt alt.irAltCtor alt.irAltBinders (substIr id repl alt.irAltBody)

substAltMaybe : Int -> Ir -> Maybe IrAlt -> Maybe IrAlt
substAltMaybe _ _ Nothing = Nothing
substAltMaybe id repl (Just alt) = Just (substAlt id repl alt)

-- ---------------------------------------------------------------
-- 克隆体里的自递归：同一指纹的调用改指克隆
-- ---------------------------------------------------------------
rewriteSelf : Int -> String -> String -> Int -> String -> Ir -> Ir
rewriteSelf fuel orig clone pos key ir =
  if fuel <= 0 then
    ir
  else
    case ir of
      IrApp _ _ _ =>
        let
          p = Analysis.flattenApp ir
          head = firstOf p
          args = secondOf p
          args2 = map (\a => rewriteSelf (fuel - 1) orig clone pos key a) args
        in case head of
          IrGlobal n => if n == orig && callKeyAt pos args2 == Just key then Synthetic.applyAllIr (IrGlobal clone) (dropAt pos args2) else Synthetic.applyAllIr (IrGlobal n) args2
          _ => Synthetic.applyAllIr (rewriteSelf (fuel - 1) orig clone pos key head) args2
      IrLam bs rt body => IrLam bs rt (rewriteSelf (fuel - 1) orig clone pos key body)
      IrLet bs scrut body => IrLet bs (rewriteSelf (fuel - 1) orig clone pos key scrut) (rewriteSelf (fuel - 1) orig clone pos key body)
      IrIf c t e => IrIf (rewriteSelf (fuel - 1) orig clone pos key c) (rewriteSelf (fuel - 1) orig clone pos key t) (rewriteSelf (fuel - 1) orig clone pos key e)
      IrCase ty k scrut alts => IrCase ty k (rewriteSelf (fuel - 1) orig clone pos key scrut) (map (rewriteAlt (fuel - 1) orig clone pos key) alts)
      IrNatCase scrut f z s c => IrNatCase (rewriteSelf (fuel - 1) orig clone pos key scrut) f (rewriteAltM (fuel - 1) orig clone pos key z) (rewriteAltM (fuel - 1) orig clone pos key s) (rewriteAltM (fuel - 1) orig clone pos key c)
      IrCtor fam ctor ty args => IrCtor fam ctor ty (map (\x => rewriteSelf (fuel - 1) orig clone pos key x) args)
      IrRecord fam ty fields => IrRecord fam ty (map (\p => (firstOf p, rewriteSelf (fuel - 1) orig clone pos key (secondOf p))) fields)
      IrProj base fam field ty => IrProj (rewriteSelf (fuel - 1) orig clone pos key base) fam field ty
      IrRecUpd base fam fields ty => IrRecUpd (rewriteSelf (fuel - 1) orig clone pos key base) fam (map (\p => (firstOf p, rewriteSelf (fuel - 1) orig clone pos key (secondOf p))) fields) ty
      IrRtApp sym args => IrRtApp sym (map (\x => rewriteSelf (fuel - 1) orig clone pos key x) args)
      IrCast from to inner => IrCast from to (rewriteSelf (fuel - 1) orig clone pos key inner)
      IrTail inner => IrTail (rewriteSelf (fuel - 1) orig clone pos key inner)
      IrConcatMany parts => IrConcatMany (map (\x => rewriteSelf (fuel - 1) orig clone pos key x) parts)
      IrEffThunk fam ctor ty arity prim => IrEffThunk fam ctor ty arity (rewriteSelf (fuel - 1) orig clone pos key prim)
      _ => ir

rewriteAlt : Int -> String -> String -> Int -> String -> IrAlt -> IrAlt
rewriteAlt fuel orig clone pos key alt =
  IrAlt alt.irAltCtor alt.irAltBinders (rewriteSelf (fuel - 1) orig clone pos key alt.irAltBody)

rewriteAltM : Int -> String -> String -> Int -> String -> Maybe IrAlt -> Maybe IrAlt
rewriteAltM _ _ _ _ _ Nothing = Nothing
rewriteAltM fuel orig clone pos key (Just alt) = Just (rewriteAlt (fuel - 1) orig clone pos key alt)

dropAt : Int -> List a -> List a
dropAt n xs = if n <= 0 then dropOne xs else dropOneAt n xs

dropOne : List a -> List a
dropOne [] = []
dropOne (_ :: rest) = rest

dropOneAt : Int -> List a -> List a
dropOneAt _ [] = []
dropOneAt n (x :: rest) = if n <= 0 then rest else x :: dropOneAt (n - 1) rest

-- | 从含擦除占位的 binder 表里去掉第 `pos` 个**运行时** binder。
dropRuntimeBinderAt : Int -> List IrBinder -> List IrBinder
dropRuntimeBinderAt pos bs = dropRuntimeGo pos bs

dropRuntimeGo : Int -> List IrBinder -> List IrBinder
dropRuntimeGo _ [] = []
dropRuntimeGo pos (b :: rest) =
  if b.irBinderErased then
    b :: dropRuntimeGo pos rest
  else if pos <= 0 then rest else b :: dropRuntimeGo (pos - 1) rest

callKeyAt : Int -> List Ir -> Maybe String
callKeyAt _ [] = Nothing
callKeyAt pos (a :: rest) = if pos <= 0 then Just (irKey a) else callKeyAt (pos - 1) rest

isEmptyList : List a -> Bool
isEmptyList [] = True
isEmptyList _ = False

memInt : Int -> List Int -> Bool
memInt _ [] = False
memInt x (y :: rest) = if x == y then True else memInt x rest

memStr : String -> List String -> Bool
memStr _ [] = False
memStr x (y :: rest) = if x == y then True else memStr x rest

-- ---------------------------------------------------------------
-- 状态与主流程
-- ---------------------------------------------------------------
record Sp where
  spDefs : List IrDef
  -- | (被调名 @ 形参序号 @ 实参指纹) -> 克隆名。
  spClones : List (String, String)
  spNext : Int
  spCount : Int
  -- | 每个原始定义已建克隆数（防爆炸）。
  spPerDef : List (String, Int)

perDefOf : String -> List (String, Int) -> Int
perDefOf _ [] = 0
perDefOf n (p :: rest) = if firstOf p == n then secondOf p else perDefOf n rest

bumpPerDef : String -> List (String, Int) -> List (String, Int)
bumpPerDef n [] = [(n, 1)]
bumpPerDef n (p :: rest) =
  if firstOf p == n then (n, secondOf p + 1) :: rest else p :: bumpPerDef n rest

cloneBudget : Int
cloneBudget = 64

perDefBudget : Int
perDefBudget = 8

-- | 在实参里找第一个「函数类型形参 + 闭合函数实参 + 体里当 head 应用」的位置。
firstSpecializable : List IrDef -> List IrBinder -> Ir -> List Ir -> Maybe (Int, Int, Ir)
firstSpecializable defs rbs inner args =
  case firstSpecGo defs rbs inner args of
    Just (b, a) => Just (indexOfBinder b rbs, b.irBinderId, a)
    Nothing => Nothing

firstSpecGo : List IrDef -> List IrBinder -> Ir -> List Ir -> Maybe (IrBinder, Ir)
firstSpecGo _ [] _ _ = Nothing
firstSpecGo _ _ _ [] = Nothing
firstSpecGo defs (b :: brest) inner (a :: arest) =
  case fnKeyOf defs a of
    Just _ => if isFunTy b.irBinderTy then Just (b, a) else firstSpecGo defs brest inner arest
    Nothing => firstSpecGo defs brest inner arest

indexOfBinder : IrBinder -> List IrBinder -> Int
indexOfBinder b bs = indexOfId b bs 0

indexOfId : IrBinder -> List IrBinder -> Int -> Int
indexOfId _ [] acc = acc
indexOfId b (x :: rest) acc =
  if x.irBinderId == b.irBinderId then acc else indexOfId b rest (acc + 1)

-- | 处理一个调用点：能特化就返回克隆名与新状态。
specializeCall : Sp -> String -> List Ir -> Maybe (String, Int, Sp)
specializeCall st name args =
  case findDef name st.spDefs of
    Nothing => Nothing
    Just d =>
      case d of
        IrExternDef _ _ _ _ => Nothing
        IrDef _ arity _ _ body _ _ _ =>
          case body of
            IrLam bs lamTy inner =>
              let
                rbs = runtimeBindersOf bs
              in if length rbs /= length args then
                Nothing
              else
                case firstSpecializable st.spDefs rbs inner args of
                  Nothing => Nothing
                  Just hit =>
                    let
                      pos = firstOf hit
                      sub = secondOf hit
                      bId = firstOf sub
                      arg = secondOf sub
                      key = name ++ "@" ++ strFromInt pos ++ "@" ++ irKey arg
                    in case lookupClone key st.spClones of
                      Just cn => Just (cn, pos, st)
                      Nothing =>
                        if st.spCount >= cloneBudget || perDefOf name st.spPerDef >= perDefBudget then
                          Nothing
                        else
                          let
                            cn = name ++ "$s" ++ strFromInt st.spNext
                            body1 = substIr bId arg inner
                            body2 = rewriteSelf (64 + 8 * irSize body1) name cn pos (irKey arg) body1
                            -- 被特化的形参已经替换进体里：克隆**不再接收**它，
                            -- 调用点也把那个实参丢掉（它是静态函数值，求值无副作用）。
                            cloneBs = dropRuntimeBinderAt pos bs
                            cloneArity = length (runtimeBindersOf bs) - 1
                            clone = IrDef cn cloneArity (irDefDeps d) (irDefTy d) (IrLam cloneBs lamTy body2) (irDefRecValueOk d) (irDefInitGuard d) (irDefSpan d)
                            st1 = Sp (append st.spDefs [clone]) ((key, cn) :: st.spClones) (st.spNext + 1) (st.spCount + 1) (bumpPerDef name st.spPerDef)
                          in Just (cn, pos, st1)
            _ => Nothing

lookupClone : String -> List (String, String) -> Maybe String
lookupClone _ [] = Nothing
lookupClone k (p :: rest) = if firstOf p == k then Just (secondOf p) else lookupClone k rest

-- ---------------------------------------------------------------
-- 重写一个定义体
-- ---------------------------------------------------------------
rwIr : Int -> Sp -> Ir -> (Ir, Sp)
rwIr fuel st ir =
  if fuel <= 0 then
    (ir, st)
  else
    case ir of
      IrApp _ _ _ =>
        let
          p = Analysis.flattenApp ir
          head = firstOf p
          args = secondOf p
        in case head of
          IrGlobal name =>
            case specializeCall st name args of
              Just hit =>
                let
                  cn = firstOf hit
                  pos = firstOf (secondOf hit)
                  st1 = secondOf (secondOf hit)
                  argsP = rwList (fuel - 1) st1 args
                in (Synthetic.applyAllIr (IrGlobal cn) (dropAt pos (firstOf argsP)), secondOf argsP)
              Nothing =>
                let
                  hP = rwIr (fuel - 1) st head
                  aP = rwList (fuel - 1) (secondOf hP) args
                in (Synthetic.applyAllIr (firstOf hP) (firstOf aP), secondOf aP)
          _ =>
            let
              hP = rwIr (fuel - 1) st head
              aP = rwList (fuel - 1) (secondOf hP) args
            in (Synthetic.applyAllIr (firstOf hP) (firstOf aP), secondOf aP)
      IrLam bs rt body =>
        let
          p = rwIr (fuel - 1) st body
        in (IrLam bs rt (firstOf p), secondOf p)
      IrLet bs scrut body =>
        let
          s = rwIr (fuel - 1) st scrut
          b = rwIr (fuel - 1) (secondOf s) body
        in (IrLet bs (firstOf s) (firstOf b), secondOf b)
      IrIf c t e =>
        let
          pc = rwIr (fuel - 1) st c
          pt = rwIr (fuel - 1) (secondOf pc) t
          pe = rwIr (fuel - 1) (secondOf pt) e
        in (IrIf (firstOf pc) (firstOf pt) (firstOf pe), secondOf pe)
      IrCase ty k scrut alts =>
        let
          ps = rwIr (fuel - 1) st scrut
          pa = rwAlts (fuel - 1) (secondOf ps) alts
        in (IrCase ty k (firstOf ps) (firstOf pa), secondOf pa)
      IrNatCase scrut f z s c =>
        let
          ps = rwIr (fuel - 1) st scrut
          pz = rwAltM (fuel - 1) (secondOf ps) z
          psm = rwAltM (fuel - 1) (secondOf pz) s
          pc = rwAltM (fuel - 1) (secondOf psm) c
        in (IrNatCase (firstOf ps) f (firstOf pz) (firstOf psm) (firstOf pc), secondOf pc)
      IrCtor fam ctor ty args =>
        let
          p = rwList (fuel - 1) st args
        in (IrCtor fam ctor ty (firstOf p), secondOf p)
      IrRecord fam ty fields =>
        let
          p = rwFields (fuel - 1) st fields
        in (IrRecord fam ty (firstOf p), secondOf p)
      IrProj base fam field ty =>
        let
          p = rwIr (fuel - 1) st base
        in (IrProj (firstOf p) fam field ty, secondOf p)
      IrRecUpd base fam fields ty =>
        let
          b = rwIr (fuel - 1) st base
          f = rwFields (fuel - 1) (secondOf b) fields
        in (IrRecUpd (firstOf b) fam (firstOf f) ty, secondOf f)
      IrRtApp sym args =>
        let
          p = rwList (fuel - 1) st args
        in (IrRtApp sym (firstOf p), secondOf p)
      IrCast from to inner =>
        let
          p = rwIr (fuel - 1) st inner
        in (IrCast from to (firstOf p), secondOf p)
      IrTail inner =>
        let
          p = rwIr (fuel - 1) st inner
        in (IrTail (firstOf p), secondOf p)
      IrConcatMany parts =>
        let
          p = rwList (fuel - 1) st parts
        in (IrConcatMany (firstOf p), secondOf p)
      IrEffThunk fam ctor ty arity prim =>
        let
          p = rwIr (fuel - 1) st prim
        in (IrEffThunk fam ctor ty arity (firstOf p), secondOf p)
      _ => (ir, st)

rwList : Int -> Sp -> List Ir -> (List Ir, Sp)
rwList _ st [] = ([], st)
rwList fuel st (x :: rest) =
  if fuel <= 0 then
    (x :: rest, st)
  else
    let
      px = rwIr (fuel - 1) st x
      pr = rwList (fuel - 1) (secondOf px) rest
    in (firstOf px :: firstOf pr, secondOf pr)

rwFields : Int -> Sp -> List (String, Ir) -> (List (String, Ir), Sp)
rwFields _ st [] = ([], st)
rwFields fuel st (p :: rest) =
  if fuel <= 0 then
    (p :: rest, st)
  else
    let
      pv = rwIr (fuel - 1) st (secondOf p)
      pr = rwFields (fuel - 1) (secondOf pv) rest
    in ((firstOf p, firstOf pv) :: firstOf pr, secondOf pr)

rwAlt : Int -> Sp -> IrAlt -> (IrAlt, Sp)
rwAlt fuel st alt =
  let
    p = rwIr (fuel - 1) st alt.irAltBody
  in (IrAlt alt.irAltCtor alt.irAltBinders (firstOf p), secondOf p)

rwAltM : Int -> Sp -> Maybe IrAlt -> (Maybe IrAlt, Sp)
rwAltM _ st Nothing = (Nothing, st)
rwAltM fuel st (Just alt) =
  let
    p = rwAlt fuel st alt
  in (Just (firstOf p), secondOf p)

rwAlts : Int -> Sp -> List IrAlt -> (List IrAlt, Sp)
rwAlts _ st [] = ([], st)
rwAlts fuel st (a :: rest) =
  if fuel <= 0 then
    (a :: rest, st)
  else
    let
      pa = rwAlt (fuel - 1) st a
      pr = rwAlts (fuel - 1) (secondOf pa) rest
    in (firstOf pa :: firstOf pr, secondOf pr)

-- | 逐定义重写；新克隆追加到 `spDefs` 末尾，并在同一轮里继续处理。
drain : Int -> Sp -> List IrDef -> Sp
drain fuel st [] = st
drain fuel st (d :: rest) =
  if fuel <= 0 then
    st
  else
    case d of
      IrExternDef _ _ _ _ => drain (fuel - 1) st rest
      IrDef _ _ _ _ body _ _ _ =>
        let
          before = length st.spDefs
          p = rwIr (64 + 8 * irSize body) st body
          st1 = secondOf p
          st2 = { st1 | spDefs = replaceDefBody (irDefName d) (firstOf p) st1.spDefs }
        in drain (fuel - 1) st2 (append rest (drop before st2.spDefs))

replaceDefBody : String -> Ir -> List IrDef -> List IrDef
replaceDefBody n body ds =
  map (
      \d =>
        if irDefName d == n then
          case d of
            IrDef nm ar deps ty _ recOk guard span => IrDef nm ar deps ty body recOk guard span
            _ => d
        else
          d
    ) ds

-- | 程序级特化：返回（可能变长的）定义表。
export specializeDefs : List IrDef -> List IrDef
specializeDefs defs = (drain (length defs + cloneBudget + 16) (Sp defs [] 0 0 []) defs).spDefs

-- | 克隆名 `<原定义>$s<n>`（嵌套克隆 `a$s1$s2` 的原定义是 `a`）。
export originOf : String -> Maybe String
originOf name =
  case split "$s" name of
    first :: _ :: _ => Just first
    _ => Nothing

-- | 把「克隆的递归性与原定义一致」并进递归名单：克隆体是原体的复制，递归帧的
--   死槽清零也必须覆盖它们，否则每层残留槽都会钉住对象。
export recursiveNamesWithClones : List String -> List IrDef -> List String
recursiveNamesWithClones recNames defs =
  foldl (
      \acc, d =>
        let
          name = irDefName d
        in case originOf name of
          Just orig => if memStr orig recNames then putIfNew name acc else acc
          Nothing => acc
    ) recNames defs

putIfNew : String -> List String -> List String
putIfNew s xs = if memStr s xs then xs else s :: xs
