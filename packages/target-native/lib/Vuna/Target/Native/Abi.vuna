module Vuna.Target.Native.Abi where

-- x86-64 SysV 的调用约定、栈帧、字符串对象布局、稳定命名。
--
-- 平台契约（见 docs/reference/native.md）：
--   * 参数寄存器按序 rdi, rsi, rdx, rcx, r8, r9；返回 rax；
--   * 每个函数 `push rbp; mov rbp, rsp; sub rsp, frame`，frame 为 16 的倍数；
--   * 所有 binder / 中间值走 `[rbp - 8*(slot+1)]`；热点循环携带的标量槽由
--     `Native.Regs` 提升到 callee-saved `rbx` / `r12`–`r15`（prologue / epilogue 保存）；
--   * 其它生成代码只使用 caller-saved 寄存器，运行时不用 `rbx` / `r12`–`r15`；
--   * 名字由 Vuna 全限定名派生，转义成 `[A-Za-z0-9_]`，不按位置编号。
--
-- 值表示：
--   * `Int` / `Nat` 是 63-bit 有符号；
--   * `String` 值是**指向长度头的指针**：`[ptr]` = 字节数（i64），`[ptr+8 ..]` = 字节；
--     字符串不可变，所有构造都分配新对象；
--   * 堆对象前有一个 8 字节块头 `[size | flags]`（见下），指针指向块头之后的 payload；
--   * 堆是段链表（`.bss` 起始段 + `mmap` 新段），空闲块按尺寸类复用，标记-清扫 GC
--     见 `Vuna.Target.Native.Gc`。
--
-- 边界：只 import Base 与 `Native.Model`。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Target.Native.Model
import Vuna.Target.Native.Pal

-- | 运行时/桥接函数所属的模块路径（渲染成根目录的 `runtime.s`）。
export nativeRuntimeModule : List String
nativeRuntimeModule = ["runtime"]

-- | 参数寄存器（SysV AMD64 的整型前六个）。
export nativeArgRegs : List Reg
nativeArgRegs = [Rdi, Rsi, Rdx, Rcx, R8, R9]

-- | 寄存器传参的个数上限；更多参数走栈（SysV AMD64：第 7 个起在 `[rbp+16]` 起）。
export nativeMaxArgs : Int
nativeMaxArgs = 6

-- | 第 i（从 0 起）个参数在**被调用方**栈帧里的地址（仅 i >= 6 有效）：
--   `[rbp]` = 旧 rbp、`[rbp+8]` = 返回地址、`[rbp+16]` = 第 7 个参数。
--   调用方按**逆序**压栈（最后一个先压），所以第 7 个参数在最低地址。
export nativeStackArgOff : Int -> Int
nativeStackArgOff i = 16 + 8 * (i - nativeMaxArgs)

-- | 帧头保留槽：固定 `[rbp-8]`，prologue 写 0。GC 逐帧保守扫，不读它；保留它是为了
--   槽偏移与帧布局稳定。
export nativeDescriptorOff : Int
nativeDescriptorOff = 0 - 8

-- | slot 序号（从 0 起）-> rbp 偏移（负数）；`[rbp-8]` 是帧头保留槽。
export nativeSlotOff : Int -> Int
nativeSlotOff slot = 0 - 8 * (slot + 2)

-- | 栈帧字节数：一个保留槽 + `slots` 个槽，上取整到 16。
export nativeFrameBytes : Int -> Int
nativeFrameBytes slots =
  let
    raw = 8 * (slots + 1)
  in if raw == 0 then 0 else (raw + 15) / 16 * 16

-- | 走栈的实参个数（`arity` 个实参里前 `regs` 个在寄存器里）。
export nativeStackArgCount : Int -> Int -> Int
nativeStackArgCount arity regs =
  let
    k = arity - regs
  in if k <= 0 then 0 else k

-- | 调用方为 16 字节对齐在栈实参**上方**留的洞：栈实参个数为奇数时 8 字节。
export nativeStackPadBytes : Int -> Int
nativeStackPadBytes k = if k - k / 2 * 2 == 1 then 8 else 0

-- | 尾调用可写进调用方来参区的字节数（栈实参区 + 对齐洞）。
--   尾调用把新实参写回 `[rbp+16...]`；超过这段就会踩调用者的帧。
export nativeTailRoomBytes : Int -> Int
nativeTailRoomBytes k = 8 * k + nativeStackPadBytes k

-- | 63-bit 有符号的上界（与 OCaml `max_int` / `irNatChainMax` 一致）。
export nativeMaxInt : Int
nativeMaxInt = 4611686018427387903

-- | 同上界对应的下界（`min_int = -2^62`；字面量上界是 `2^62-1`，因此写成 `-max - 1`）。
export nativeMinInt : Int
nativeMinInt = -4611686018427387903 - 1

-- | 寄存器身份：槽里没有 `Eq Reg`，渲染文本即身份。
export sameReg : Reg -> Reg -> Bool
sameReg a b = regText a == regText b

-- ---------------------------------------------------------------
-- 字符串对象布局、堆与 GC 布局
-- ---------------------------------------------------------------
-- | 字符串长度头的大小（字节）；数据紧跟在头之后。
export nativeStrHeaderBytes : Int
nativeStrHeaderBytes = 8

-- | 每个堆对象前的块头字节数（对象指针 = 块头 + 8）。
export nativeBlockHeaderBytes : Int
nativeBlockHeaderBytes = 8

-- | 块头低 4 位是标志；高位是块总字节数（16 对齐）。
export nativeMarkFlag : Int
nativeMarkFlag = 1

export nativeFreeFlag : Int
nativeFreeFlag = 2

-- | payload 里没有指针（字符串、Float），标记时不扫。
export nativeLeafFlag : Int
nativeLeafFlag = 4

-- | 老代块：年轻代回收跳过；晋升与整堆回收时置位。
export nativeOldFlag : Int
nativeOldFlag = 8

-- | 最小块（块头 + 8 字节 payload）。
export nativeMinBlockBytes : Int
nativeMinBlockBytes = 16

-- | 尺寸类上限：更大的块进 `rt_huge_free` 首次适配链。
export nativeMaxClassBytes : Int
nativeMaxClassBytes = 67108864

-- | 尺寸类个数（16 B .. 64 MiB，2 的幂）。
export nativeClassCount : Int
nativeClassCount = 23

-- | 尺寸类空闲链表的字节数（按类序号索引）。
export nativeFreeTableBytes : Int
nativeFreeTableBytes = 256

-- | 段头字节数：`[0]=next [8]=end [16]=bump [24]=kind [32]=cards`；
--   块区从段头之后开始（`[40..47]` 是对齐填充）。
export nativeSegHeaderBytes : Int
nativeSegHeaderBytes = 48

-- | 初始堆缓冲大小（1 MiB；`.bss` 零填充，不占 ELF 文件体积）。
export nativeHeapBytes : Int
nativeHeapBytes = 1048576

-- | 卡片大小 2^9 = 512 字节：写屏障按卡片记脏，年轻代回收只扫脏卡片覆盖的区间。
export nativeCardShift : Int
nativeCardShift = 9

export nativeCardBytes : Int
nativeCardBytes = 512

-- | 初始堆段的静态卡片表（每段一张；新段的表在 `alloc` 里 `mmap`）。
export nativeHeapCardsLabel : String
nativeHeapCardsLabel = "rt_heap_cards"

export nativeHeapCardTableBytes : Int
nativeHeapCardTableBytes = (nativeHeapBytes + nativeCardBytes - 1) / nativeCardBytes

-- | 初始堆段的段头标签（紧跟 1 MiB 缓冲）。
export nativeHeapSegLabel : String
nativeHeapSegLabel = "rt_heap_seg"

-- | 堆缓冲标签（`.bss`）。
export nativeHeapLabel : String
nativeHeapLabel = "rt_heap"

-- | 堆结束标签（`.bss` 里紧跟缓冲）。
export nativeHeapEndLabel : String
nativeHeapEndLabel = "rt_heap_end"

-- | 当前段的分配指针（bump）。
export nativeHeapPtrLabel : String
nativeHeapPtrLabel = "rt_heap_ptr"

-- | 当前 arena 段的结束地址。
export nativeArenaEndLabel : String
nativeArenaEndLabel = "rt_arena_end"

-- | 段链表头（新段插在表头）。
export nativeSegsLabel : String
nativeSegsLabel = "rt_segs"

-- | 当前 bump 段（段头地址）。
export nativeCurSegLabel : String
nativeCurSegLabel = "rt_cur_seg"

-- | 尺寸类空闲链表（`nativeClassCount` 项）。
export nativeFreeTableLabel : String
nativeFreeTableLabel = "rt_free_tbl"

-- | 超大块空闲链（首次适配）。
export nativeHugeFreeLabel : String
nativeHugeFreeLabel = "rt_huge_free"

-- | GC 缺省下限（也是缺省触发阈值）：1 MiB。
export nativeGcMinDefaultBytes : Int
nativeGcMinDefaultBytes = 1048576

-- | live 堆预算（`VUNA_NATIVE_MEM_LIMIT`；0 = 不限）。`alloc` 与 `gc_collect` 都读它。
export nativeMemLimitLabel : String
nativeMemLimitLabel = "rt_mem_limit"

-- | 默认内存预算的余量：缺省预算 = `max(1 GiB, 2 × live + 这个值)`，每次回收后按
--   实际 live 抬高（只升不降），让 live 接近上限的进程不必每次分配都做整堆回收。
export nativeMemSlackBytes : Int
nativeMemSlackBytes = 268435456

-- ---------------------------------------------------------------
-- GC 根槽（保守标记的 `.bss` 白名单）
-- ---------------------------------------------------------------
-- | 当前 active 栈的栈顶（GC 扫描 `[rsp, rt_stack_top)`）。
export nativeStackTopLabel : String
nativeStackTopLabel = "rt_stack_top"

-- | 下一次回收强制整堆（分配预算压线时置位；`gc_collect` 读后清零）。
export nativeGcForceMajorLabel : String
nativeGcForceMajorLabel = "rt_gc_force_major"

-- | 活着的子线程数（不含主线程）。`alloc` 据此拿堆锁。
export nativeThreadCountLabel : String
nativeThreadCountLabel = "rt_thread_count"

-- ---------------------------------------------------------------
-- 线程 TCB 与 STW GC 协调槽
-- ---------------------------------------------------------------
-- | 当前线程 TCB 的字段偏移（`%fs` 基址；`Runtime.init_threads` 建立）。
export nativeTcbSelfOff : Int
nativeTcbSelfOff = 0

export nativeTcbStackTopOff : Int
nativeTcbStackTopOff = 8

export nativeTcbSavedRspOff : Int
nativeTcbSavedRspOff = 16

-- | 0 = running，1 = blocked（阻塞在 futex），2 = parked（safepoint），3 = dead。
export nativeTcbStateOff : Int
nativeTcbStateOff = 24

-- | 当前线程的宿主状态槽（fs / process 的 `try*` 写这里，`@vuna@prim_eff_hostStatus` 读）。
--   放在 TCB 里而不是 `.bss`：并行区两个线程各写各的。
export nativeTcbHostStatusOff : Int
nativeTcbHostStatusOff = 32

-- | 当前线程的宿主 scratch 块基址（`init_tcb` / `thread_spawn` 用 mmap 分配；
--   各段偏移见下面的 `scratch*Off`）。fs / process / 时钟 / tty 的固定缓冲都在这里。
export nativeTcbScratchOff : Int
nativeTcbScratchOff = 40

-- | 当前线程的 `bracket` / `finally` cleanup 链头（堆节点 `[closure][next]`，
--   `prim_cleanupPush/Pop` 维护）。放在 TCB 里：cleanup 是线程局部的，
--   并行区不能把别的线程的节点 pop 掉。
export nativeTcbCleanupOff : Int
nativeTcbCleanupOff = 48

-- | 当前线程的逻辑标识（线程表槽号；主线程 = 0）。`@vuna@prim_eff_threadId` 读它。
export nativeTcbIdOff : Int
nativeTcbIdOff = 56

-- ---------------------------------------------------------------
-- 线程私有宿主 scratch 块
-- ---------------------------------------------------------------
-- 宿主叶子（fs / process / 时钟 / tty）需要若干固定缓冲：路径、stat、getdents、命令行、
-- spawn arena、8 MiB 读缓冲、timespec / termios / affinity。它们不能是进程级 `.bss`——
-- 并行区两个线程同用一个缓冲会互相覆盖（路径被改写 ⇒ 操作到别人的文件）。每个线程在
-- `init_tcb` / `thread_spawn` 里 mmap 一块零页区，指针放在 TCB 的 `nativeTcbScratchOff`；
-- 各叶子用 `mov r, fs:[scratch]; add r, <偏移>` 取自己那段。
export scratchPathOff : Int
scratchPathOff = 0

-- | `rename` / `symlink` / 原子写的 tmp 路径要同时持有两个 C 路径。
export scratchPath2Off : Int
scratchPath2Off = scratchPathOff + pathMaxBytes

-- | `stat` / `lstat` 的 `struct stat`。
export scratchStatOff : Int
scratchStatOff = scratchPath2Off + pathMaxBytes

-- | `getdents64` 的读取缓冲（32 KiB）与 `tryReadDir` 的名字数组。
export scratchDirBufOff : Int
scratchDirBufOff = scratchStatOff + statBufBytes

export scratchDirNamesOff : Int
scratchDirNamesOff = scratchDirBufOff + 32768

-- | `runIn` 的 shell 命令行、`getcwd` 备份、`spawn` 的 argv 数组与字符串 arena、
--   以及 `/bin/sh` 自己的 argv 数组。
export scratchCmdOff : Int
scratchCmdOff = scratchDirNamesOff + 32256

export scratchCwdOff : Int
scratchCwdOff = scratchCmdOff + 65536

export scratchSpawnArgvOff : Int
scratchSpawnArgvOff = scratchCwdOff + pathMaxBytes

export scratchSpawnBufOff : Int
scratchSpawnBufOff = scratchSpawnArgvOff + 2048

export scratchShArgvOff : Int
scratchShArgvOff = scratchSpawnBufOff + 65536

-- | `tryReadFileRange` 的读缓冲（单次 `length` 的 8 MiB 上界）。
export scratchReadOff : Int
scratchReadOff = scratchShArgvOff + 32

-- | `clock_gettime` / `nanosleep` 的 timespec 与 `ioctl(TCGETS)` 的 termios。
export scratchTsOff : Int
scratchTsOff = scratchReadOff + 8388608

export scratchTermiosOff : Int
scratchTermiosOff = scratchTsOff + timespecBytes

-- | `sched_getaffinity` 的 CPU 位图（`threadParallelism` 逐位计数）。
export scratchAffinityOff : Int
scratchAffinityOff = scratchTermiosOff + termiosBytes

-- | `env_filter` 给子进程挑环境变量用的数组。
export scratchEnvChildOff : Int
scratchEnvChildOff = scratchAffinityOff + cpuSetBytes

-- | 整块大小（所有段都是 8 字节倍数，mmap 后各段自然对齐）。
export scratchBytes : Int
scratchBytes = scratchEnvChildOff + 8192

-- | 主线程 TCB（`.bss`；子线程 TCB 放在自己的栈顶下方）。
export nativeMainTcbLabel : String
nativeMainTcbLabel = "rt_main_tcb"

-- | 线程表：固定 1024 项，每项一个 TCB 指针（0 = 空槽）。
export nativeThreadTabLabel : String
nativeThreadTabLabel = "rt_thread_tab"

-- | 活线程数（含主线程）。
export nativeLiveThreadsLabel : String
nativeLiveThreadsLabel = "rt_live_threads"

-- | 已 blocked / parked 的线程数（collector 等它等于 `live-1`）。
export nativeParkedLabel : String
nativeParkedLabel = "rt_parked_threads"

-- | 线程状态变化的条件字：每次 live/parked 改变都递增并 futex 唤醒，collector 据此重查。
export nativeThreadEventLabel : String
nativeThreadEventLabel = "rt_thread_event"

-- | GC 的停车请求（1 = 请求所有线程停车）。
export nativeGcRequestedLabel : String
nativeGcRequestedLabel = "rt_gc_requested"

-- | 停车纪元：collector 在回收结束、清请求后递增并 futex 唤醒。
export nativeGcEpochLabel : String
nativeGcEpochLabel = "rt_gc_epoch"

-- | 线程运行时是否已启用（`init_threads` 置 1；GC 用它选择单线程 / STW 路径）。
export nativeThreadedLabel : String
nativeThreadedLabel = "rt_threaded"

-- | 零参顶层定义的缓存区（CAF）：`[caf_begin, caf_end)` 是连续的 8 字节槽，
--   每个零参定义一格，`_start` 求值一次后写入；GC 按这段区间扫根。
export nativeCafBeginLabel : String
nativeCafBeginLabel = "rt_caf_begin"

export nativeCafEndLabel : String
nativeCafEndLabel = "rt_caf_end"

-- | 单个零参定义的缓存槽标签（与 `nativeName` 同编码）。
export nativeCafCellLabel : String -> String
nativeCafCellLabel name = "rt_caf_${nativeName name}"

-- ---------------------------------------------------------------
-- 函数框架
-- ---------------------------------------------------------------
-- | 固定 prologue：push rbp; mov rbp, rsp; sub rsp, frame; 帧头保留槽置 0。
--   `frame=0` 只可能出现在不带保留槽的哨兵函数上（入口 `_start`）。
export nativePrologue : Int -> List Instr
nativePrologue frame = nativePrologueOf frame []

-- | prologue + 把**从不写**的帧槽（正偏移）也清 0：死存储删除留下的洞会残留旧值，
--   逐帧保守扫根会把它当指针。见 `Native.Live.unwrittenSlots`。
export nativePrologueOf : Int -> List Int -> List Instr
nativePrologueOf frame holes =
  append
    [IPush Rbp, IMov (OpReg Rbp) (OpReg Rsp)]
    (append (if frame == 0 then [] else [IBinReg "sub" Rsp (OpImm frame)]) (if frame == 0 then [] else IMov (OpMem Rbp nativeDescriptorOff) (OpImm 0) :: map (\off => IMov (OpMem Rbp (0 - off)) (OpImm 0)) holes))

-- | 固定 epilogue：mov rsp, rbp; pop rbp; ret。
export nativeEpilogue : List Instr
nativeEpilogue = [IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp, IRet]

-- | 把体内 `IRet` 改写成跳到 `endLabel`（单出口）。
export mapRetTo : String -> List Instr -> List Instr
mapRetTo label [] = []
mapRetTo label (i :: rest) =
  case i of
    IRet => IJmp label :: mapRetTo label rest
    _ => i :: mapRetTo label rest

-- | 有 prologue/epilogue 的运行时函数：**单出口**。
export rtFunc : String -> Int -> List Instr -> NativeFunc
rtFunc name frame body =
  let
    endLabel = "${nativeRtLabel name}_end"
    -- 槽偏移从 `[rbp-16]` 起（`[rbp-8]` 是帧头保留槽），帧多一个机器字。
    actual = frame + 8
  in NativeFunc
    (nativeRtLabel name)
    actual
    (append (nativePrologue actual) (append (mapRetTo endLabel body) (append [ILabel endLabel] nativeEpilogue)))
    nativeRuntimeModule

-- | 直接以 ret/exit 结束、无 prologue 的入口/陷阱。
export rtRawFunc : String -> List Instr -> NativeFunc
rtRawFunc name body = NativeFunc (nativeRtLabel name) 0 body nativeRuntimeModule

-- ---------------------------------------------------------------
-- 稳定命名
-- ---------------------------------------------------------------
isNativeNameChar : Int -> Bool
isNativeNameChar c = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

nativeNameChar : Int -> String
nativeNameChar c = if isNativeNameChar c then strPack [c] else "_x${strFromInt c}_"

-- | Vuna 全限定名 -> 汇编标识符片段（只含 `[A-Za-z0-9_]`）。
export nativeName : String -> String
nativeName name = strPack (concatMap (\c => strUnpack (nativeNameChar c)) (strUnpack name))

-- | 用户定义的函数标签。
export nativeFuncLabel : String -> String
nativeFuncLabel name = "vuna_${nativeName name}"

-- | 运行时函数标签。
export nativeRtLabel : String -> String
nativeRtLabel name = "rt_${nativeName name}"

-- | 顶层函数当值时的静态 wrapper 标签（诚实反映「这是函数值」）。
export nativeGlobalValueLabel : String -> String
nativeGlobalValueLabel name = "vuna_gv_${nativeName name}"

-- | 运行时符号当值时的 wrapper 标签。
export nativeRtValueLabel : String -> String
nativeRtValueLabel sym = "rt_gv_${nativeName sym}"

-- | 程序入口标签（固定）。
export nativeEntryLabel : String
nativeEntryLabel = "_start"

-- | 内部 label：按模块内生成顺序编号（同一 IR 的编号稳定）。`.L` 前缀是 GNU as 的
-- **文件局部**符号：不同模块文件可以重号，标签重编号也不会跨文件扩散。
export nativeJumpLabel : Int -> String
nativeJumpLabel n = ".L${strFromInt n}"

-- | 只读数据标签（运行时常量）。
export nativeDataLabel : String -> String
nativeDataLabel name = "rt_data_${nativeName name}"

-- | 字符串字面量标签（带长度头）。字面量池按模块切分，标签是文件局部的 `.Llit_<n>`。
export nativeStrLitLabel : Int -> String
nativeStrLitLabel n = ".Llit_${strFromInt n}"

-- | 浮点字面量标签（`.double` 数据）。同样按模块切分，文件局部 `.Lflt_<n>`。
export nativeFloatLitLabel : Int -> String
nativeFloatLitLabel n = ".Lflt_${strFromInt n}"
