module Vuna.Target.Native.Regs where

-- 标量帧槽提升到 callee-saved 寄存器。
--
-- 帧槽是所有 binder 的统一落点，因此热点循环的每次迭代都在「写槽 → 读回」上绕一圈。
-- 只有**标量**槽（Int / Bool，`NClsScalar`）可以安全地常驻寄存器：GC 的保守扫根只看
-- 栈帧，指针槽必须留在内存里；标量在寄存器里既不会被漏扫，也不会被当成根。
--
-- 判据与范围：
--   * 只处理**有回边**的函数（尾递归循环 / 普通循环）：同一帧跨迭代复用，槽的读写
--     都在热点上；直线函数保持原来的槽布局（避免为一次调用付 push/pop）；
--   * 只提升**循环携带**的槽（循环头 `live_in`）：迭代内定义、迭代内用完的临时值
--     留在槽里更好——提升它们只多出两次寄存器搬运，反而加长关键路径；
--   * 有**栈实参**（`[rbp + 正偏移]`，arity > 6）的函数也提升，正偏移按 prologue
--     的 saveBytes 平移；
--   * 按槽在函数体里出现的次数挑前 `maxPromoted` 个（够用即可，不追求全局最优）；
--   * 被提升的槽在整个函数里都换成寄存器（来参落位、尾调用搬运、返回值都跟着走），
--     所以循环边界上不需要插入拷贝。
--
-- 寄存器用 `rbx` / `r12`–`r15`（callee-saved，prologue/epilogue 保存）；循环体不写
-- `r10`/`r11` 时再把最多两个槽放进这两个 caller-saved scratch（它们不在来参寄存器里，
-- 且函数内没有 call/div/syscall 才会被选中）。
--
-- 边界：只 import Base 与 `Native.{Abi,Live,Model,Repr}`；不改 ABI 与帧大小。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Live
import Vuna.Target.Native.Model
import Vuna.Target.Native.Repr
import Vuna.Target.Native.Select

-- | 一个函数最多提升几个 callee-saved 槽（寄存器池大小）。
maxPromoted : Int
maxPromoted = 5

-- | 有回边且循环体不写 r10/r11 时，再把两个细槽放进 caller-saved scratch。
--   这两个寄存器不会出现在来参寄存器里（x86-64 只用 rdi/rsi/rdx/rcx/r8/r9），
--   所以 bindArgs 的实参落位不会互相覆盖；函数内若有 call/div/syscall，它们会被
--   `instrWritesReg` 判为 clobber，自动放弃。
maxExtraPromoted : Int
maxExtraPromoted = 2

extraPromotableRegs : List Reg
extraPromotableRegs = [R10, R11]

-- | 可用的 callee-saved 寄存器（顺序固定：分数高的槽拿前面的）。
promotableRegs : List Reg
promotableRegs = [Rbx, R12, R13, R14, R15]

-- | 提升结果：重写后的函数体 + 需要在 prologue / epilogue 里保存的寄存器。
export record RegPlan(..) where
  rpBody : List Instr
  rpSaved : List Reg

-- ---------------------------------------------------------------
-- 槽的识别与计分
-- ---------------------------------------------------------------
slotOffOf : Operand -> Maybe Int
slotOffOf (OpMem Rbp off) = Just off
slotOffOf _ = Nothing

collectMaybe : List (Maybe Int) -> List Int
collectMaybe [] = []
collectMaybe (Nothing :: rest) = collectMaybe rest
collectMaybe ((Just x) :: rest) = x :: collectMaybe rest

-- | 指令在**值位置**引用的帧槽（读和写都算，只用于计分）。
--   `movzx` / `mov byte` 的源是字符串字节，不是标量槽，因此不计也不改写。
instrSlotOffs : Instr -> List Int
instrSlotOffs (IMov a b) = collectMaybe [slotOffOf a, slotOffOf b]
instrSlotOffs (IBin _ src) = collectMaybe [slotOffOf src]
instrSlotOffs (IBinReg _ _ src) = collectMaybe [slotOffOf src]
instrSlotOffs (ICmp a b) = collectMaybe [slotOffOf a, slotOffOf b]
instrSlotOffs (ICmov _ _ src) = collectMaybe [slotOffOf src]
instrSlotOffs (IXmmLoad _ src) = collectMaybe [slotOffOf src]
instrSlotOffs (IXmmStore op _) = collectMaybe [slotOffOf op]
instrSlotOffs _ = []

slotScore : List Instr -> Int -> Int
slotScore instrs slot = length (filter (\o => o == slot) (concatMap instrSlotOffs instrs))

-- | 前 `k` 个最常出现的槽（只收访问次数 > 0 的）。
pickTop : Int -> List Int -> List Instr -> List Int
pickTop k candidates instrs =
  if k <= 0 then
    []
  else
    case bestOf candidates instrs Nothing of
      Nothing => []
      Just p =>
        let
          slot = firstOf p
          score = secondOf p
        in if score <= 0 then [] else slot :: pickTop (k - 1) (withoutInt slot candidates) instrs

bestOf : List Int -> List Instr -> Maybe (Int, Int) -> Maybe (Int, Int)
bestOf [] _ best = best
bestOf (s :: rest) instrs best =
  let
    score = slotScore instrs s
  in case best of
    Nothing => bestOf rest instrs (Just (s, score))
    Just b =>
      if score > secondOf b then bestOf rest instrs (Just (s, score)) else bestOf rest instrs best

withoutInt : Int -> List Int -> List Int
withoutInt _ [] = []
withoutInt x (y :: rest) = if x == y then rest else y :: withoutInt x rest

-- ---------------------------------------------------------------
-- 重写
-- ---------------------------------------------------------------
lookupSlot : Int -> List (Int, Reg) -> Maybe Reg
lookupSlot _ [] = Nothing
lookupSlot off (p :: rest) = if firstOf p == off then Just (secondOf p) else lookupSlot off rest

substOperand : List (Int, Reg) -> Operand -> Operand
substOperand reps op =
  case slotOffOf op of
    Nothing => op
    Just off =>
      case lookupSlot off reps of
        Nothing => op
        Just r => OpReg r

-- | 只改写值位置的指令；`IMovzx` / `IMovByte*` 的字节操作数保持原样。
mapValueOperands : (Operand -> Operand) -> Instr -> Instr
mapValueOperands f (IMov a b) = IMov (f a) (f b)
mapValueOperands f (IBin op src) = IBin op (f src)
mapValueOperands f (IBinReg op dst src) = IBinReg op dst (f src)
mapValueOperands f (ICmp a b) = ICmp (f a) (f b)
mapValueOperands f (ICmov cc dst src) = ICmov cc dst (f src)
mapValueOperands f (IXmmLoad n src) = IXmmLoad n (f src)
mapValueOperands f (IXmmStore op n) = IXmmStore (f op) n
mapValueOperands _ i = i

-- ---------------------------------------------------------------
-- 寄存器合并（槽提升之后）
-- ---------------------------------------------------------------
-- 槽提升把 `mov rax, [slot]; ...; mov [slot], rax` 变成 `mov rax, rS; ...; mov rD, rax`。
-- 这里在直线段内做两种局部合并：
--   1. `mov r10/r11, rX` 只被下一条指令读一次 → 折掉中转寄存器；
--   2. `mov rax, rS; <只操作 rax 的链>; mov rD, rax` → 链直接以 rD 为目标
--      （rS == rD 时连首条 mov 一起删）。
-- 两种改写都不跨标签 / 跳转 / 调用，也不动 flags 之外的语义（指令本身不变）。
isScratchReg : Reg -> Bool
isScratchReg r = sameReg r R10 || sameReg r R11

isPromotedReg : Reg -> Bool
isPromotedReg r = sameReg r Rbx || sameReg r R12 || sameReg r R13 || sameReg r R14 || sameReg r R15

blockBoundary : Instr -> Bool
blockBoundary (ILabel _) = True
blockBoundary (IJmp _) = True
blockBoundary (IJmpReg _) = True
blockBoundary (IJcc _ _) = True
blockBoundary IRet = True
blockBoundary (ICall _) = True
blockBoundary (ICallReg _) = True
blockBoundary _ = False

operandUsesReg : Reg -> Operand -> Bool
operandUsesReg r (OpReg x) = sameReg r x
operandUsesReg r (OpMem base _) = sameReg r base
operandUsesReg r (OpMemX base idx _) = sameReg r base || sameReg r idx
operandUsesReg _ _ = False

replaceOperandReg : Reg -> Reg -> Operand -> Operand
replaceOperandReg s src (OpReg x) = if sameReg s x then OpReg src else OpReg x
replaceOperandReg s src (OpMem base off) = if sameReg s base then OpMem src off else OpMem base off
replaceOperandReg s src (OpMemX base idx off) =
  if sameReg s base then
    OpMemX src idx off
  else if sameReg s idx then OpMemX base src off else OpMemX base idx off
replaceOperandReg _ _ op = op

replaceInstrReg : Reg -> Reg -> Instr -> Instr
replaceInstrReg s src (IMov a b) = IMov (replaceOperandReg s src a) (replaceOperandReg s src b)
replaceInstrReg s src (IMovzx d o) = IMovzx d (replaceOperandReg s src o)
replaceInstrReg s src (ILeaMem d base off) = ILeaMem d (if sameReg s base then src else base) off
replaceInstrReg s src (ILeaScale d base scale off) =
  ILeaScale d (if sameReg s base then src else base) scale off
replaceInstrReg s src (ITrunc32 d) = ITrunc32 (if sameReg s d then src else d)
replaceInstrReg s src (IBin op o) = IBin op (replaceOperandReg s src o)
replaceInstrReg s src (IBinReg op d o) = IBinReg op d (replaceOperandReg s src o)
replaceInstrReg s src (ICmp a b) = ICmp (replaceOperandReg s src a) (replaceOperandReg s src b)
replaceInstrReg s src (ICmov c d o) = ICmov c d (replaceOperandReg s src o)
replaceInstrReg s src (IXmmLoad n o) = IXmmLoad n (replaceOperandReg s src o)
replaceInstrReg s src (IXmmStore o n) = IXmmStore (replaceOperandReg s src o) n
replaceInstrReg _ _ i = i

scratchFreeAfter : Reg -> List Instr -> Bool
scratchFreeAfter _ [] = True
scratchFreeAfter r (i :: rest) =
  if instrReadsReg r i then
    False
  else if instrWritesReg r i then
    True
  else if blockBoundary i then True else scratchFreeAfter r rest

scratchFoldPass : List Instr -> List Instr
scratchFoldPass [] = []
scratchFoldPass (i :: rest) =
  case i of
    IMov (OpReg s) (OpReg src) =>
      case rest of
        next :: more =>
          if isScratchReg s && not (sameReg s src) && instrReadsReg s next && not (instrWritesReg s next) && scratchFreeAfter s more then
            replaceInstrReg s src next :: scratchFoldPass more
          else
            i :: scratchFoldPass rest
        [] => [i]
    _ => i :: scratchFoldPass rest

isRaxMiddle : Instr -> Bool
isRaxMiddle (IBinReg _ Rax _) = True
isRaxMiddle (IBin _ _) = True
isRaxMiddle (IMov (OpReg r) _) = isScratchReg r
isRaxMiddle (IBinReg _ r _) = isScratchReg r
isRaxMiddle _ = False

middleOperandUses : Reg -> Instr -> Bool
middleOperandUses r (IBinReg _ _ o) = operandUsesReg r o
middleOperandUses r (IBin _ o) = operandUsesReg r o
middleOperandUses r (IMov _ o) = operandUsesReg r o
middleOperandUses _ _ = True

retargetRax : Reg -> Instr -> Instr
retargetRax d (IBinReg op Rax o) = IBinReg op d o
retargetRax d (IBin op o) = IBinReg op d o
retargetRax _ i = i

takeRaxChain : Int -> List Instr -> List Instr -> Maybe (Reg, List Instr, List Instr)
takeRaxChain fuel acc [] = Nothing
takeRaxChain fuel acc (i :: rest) =
  if fuel <= 0 then
    Nothing
  else
    case i of
      IMov (OpReg d) (OpReg Rax) => if isPromotedReg d && not (anyMiddleTouches d acc) && not (anyMiddleTouches Rax acc) then Just (d, reverse acc, rest) else Nothing
      _ => if isRaxMiddle i then takeRaxChain (fuel - 1) (i :: acc) rest else Nothing

anyMiddleTouches : Reg -> List Instr -> Bool
anyMiddleTouches _ [] = False
anyMiddleTouches r (i :: rest) = if middleOperandUses r i then True else anyMiddleTouches r rest

raxChainPass : List Instr -> List Instr
raxChainPass instrs = raxChainFuel (length instrs + 1) instrs

-- | `mov rax, src; <只碰 rax / scratch 的链>; mov d, rax` 把链直接以 `d` 为目标。
--   改向之后这条 `mov` 不再给 `rax` 赋值，所以只在链之后 `rax` 已不被读（同一块内
--   先被重写，或已到块边界）时才做——紧跟在链后的 `add rax, …` 读的就是它。
raxChainFuel : Int -> List Instr -> List Instr
raxChainFuel fuel [] = []
raxChainFuel fuel (i :: rest) =
  if fuel <= 0 then
    i :: rest
  else
    case i of
      IMov (OpReg Rax) (OpReg src) =>
        case takeRaxChain 16 [] rest of
          Just p =>
            let
              d = firstOf p
              middle = firstOf (secondOf p)
              rest1 = secondOf (secondOf p)
              init = if sameReg src d then [] else [IMov (OpReg d) (OpReg src)]
            in if regFreeAhead Rax rest1 then append init (append (map (retargetRax d) middle) (raxChainFuel (fuel - 1) rest1)) else i :: raxChainFuel (fuel - 1) rest
          Nothing => i :: raxChainFuel (fuel - 1) rest
      _ => i :: raxChainFuel (fuel - 1) rest

-- ---------------------------------------------------------------
-- 保存 / 恢复
-- ---------------------------------------------------------------
-- | prologue 里追加在 `push rbp` 之前的部分：保存用到的寄存器。用到的个数为奇数时
--   补 8 字节空洞，保持 `call` 前的 16 字节对齐。
export prologueOf : List Reg -> List Instr
prologueOf saved =
  append (map IPush saved) (if odd (length saved) then [IBinReg "sub" Rsp (OpImm 8)] else [])

-- | epilogue / 尾调用的恢复序列（`pop rbp` 之后执行）。
teardownInstrs : List Reg -> List Instr
teardownInstrs saved =
  append
    (if odd (length saved) then [IBinReg "add" Rsp (OpImm 8)] else [])
    (map IPop (reverse saved))

-- | 函数正常返回的 epilogue。
export epilogueOf : List Reg -> List Instr
epilogueOf saved =
  append [IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp] (append (teardownInstrs saved) [IRet])

-- | 尾调用：`mov rsp, rbp; pop rbp; jmp …` 在这条序列的 `pop rbp` 之后插入恢复。
restoreTailJumps : List Reg -> List Instr -> List Instr
restoreTailJumps saved [] = []
restoreTailJumps saved (i :: rest) =
  case i of
    IPop Rbp =>
      case rest of
        (IJmp l) :: more =>
          append [IPop Rbp] (append (teardownInstrs saved) (IJmp l :: restoreTailJumps saved more))
        (IJmpReg r) :: more =>
          append
            [IPop Rbp]
            (append (teardownInstrs saved) (IJmpReg r :: restoreTailJumps saved more))
        _ => i :: restoreTailJumps saved rest
    _ => i :: restoreTailJumps saved rest

odd : Int -> Bool
odd n = n - n / 2 * 2 == 1

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
-- | 有回边的函数里，把最热的标量槽换成 callee-saved 寄存器。
--   有栈实参的函数也提升：prologue 的 callee-saved push 会把来参区整体上移，
--   所以提升后把所有正偏移（栈实参读 / 尾调用来参区写）统一加 `saveBytes`。
export promoteLoops : List (Int, NCls) -> List Instr -> RegPlan
promoteLoops slotCls instrs =
  if not (frameReused False instrs) then
    RegPlan instrs []
  else
    let
      carried = loopCarriedSlots instrs
      scalarOffs = map (\p => nativeSlotOff (firstOf p)) (filter (\p => isScalarCls (secondOf p)) slotCls)
      candidates = filter (\off => memIntList off carried) scalarOffs
      top = pickTop maxPromoted candidates instrs
      rest = filterInts top candidates
      extraRegs = take maxExtraPromoted (filter (\r => not (writesRegIn r instrs)) extraPromotableRegs)
      extra = pickTop (length extraRegs) rest instrs
      reps = append (List.zip top promotableRegs) (List.zip extra extraRegs)
      saved = map secondOf (List.zip top promotableRegs)
      saveBytes = 8 * length saved + (if odd (length saved) then 8 else 0)
      body0 = map (\i => mapValueOperands (substOperand reps) i) instrs
      body1 = if saveBytes == 0 then body0 else shiftPositiveOffsets saveBytes body0
      body2 = hoistLoopConsts body1
      body3 = retargetSetccPass body2
      body = raxChainPass (scratchFoldPass body3)
    in RegPlan (restoreTailJumps saved body) saved

-- ---------------------------------------------------------------
-- 比较结果直接落在循环槽寄存器
-- ---------------------------------------------------------------
-- | `xor rax, rax; cmp a, b; setcc al; mov d, rax` 里的 0/1 结果直接写 `d`：
--   省掉每条比较末尾的搬运（比较物化成循环携带值的常见形态）。要求 `d` 是提升后的
--   寄存器、比较不读 `d`，且 `rax` 在搬运之后先被写或被块边界截断。
export retargetSetccPass : List Instr -> List Instr
retargetSetccPass [] = []
retargetSetccPass (i :: rest) =
  case i of
    IBinReg "xor" Rax (OpReg r1) =>
      case rest of
        (ICmp a b) :: (ISetcc cc Rax) :: (IMov (OpReg d) (OpReg Rax)) :: more =>
          if sameReg r1 Rax && isSetccTarget d && not (operandUsesReg d a) && not (operandUsesReg d b) && not (operandUsesReg Rax a) && not (operandUsesReg Rax b) && setccRaxDead more then
            IBinReg "xor" d (OpReg d) :: ICmp a b :: ISetcc cc d :: retargetSetccPass more
          else
            i :: retargetSetccPass rest
        _ => i :: retargetSetccPass rest
    _ => i :: retargetSetccPass rest

-- | 可以直接承接 0/1 结果的寄存器：callee-saved 提升槽 + 两个 caller-saved scratch 槽。
isSetccTarget : Reg -> Bool
isSetccTarget r = isPromotedReg r || sameReg r R10 || sameReg r R11

-- | `rax` 在改向后的比较之后不再被读：自异或（清零）视为覆写，不算读。
setccRaxDead : List Instr -> Bool
setccRaxDead [] = True
setccRaxDead (i :: rest) =
  case i of
    IBinReg "xor" Rax (OpReg Rax) => True
    _ =>
      if instrReadsReg Rax i then
        False
      else if instrWritesReg Rax i then
        True
      else if blockBoundary i then True else setccRaxDead rest

-- ---------------------------------------------------------------
-- 循环内常量提升
-- ---------------------------------------------------------------
-- | 把循环体里只写一次的 64-bit 立即数装载提到循环入口之前：常量除法 / 取模的 magic
--   数不再每轮重新 materialize。判据：函数只有一个回边目标；目标寄存器是 caller-saved
--   scratch（`r8`–`r11`，函数内没有 call / 其它写入），且在常量之前没有被读。
--   提升点是第一条标签之前——来参绑定已经完成，自递归回边与内部回边都从标签之后进入。
hoistLoopConsts : List Instr -> List Instr
hoistLoopConsts instrs =
  if length (backTargetsOf instrs) /= 1 then
    instrs
  else
    case firstLabelIndex instrs of
      Nothing => instrs
      Just li =>
        let
          hoisted = filter (\p => firstOf p > li) (hoistableConsts instrs)
        in if length hoisted == 0 then
          instrs
        else
          let
            consts = map secondOf hoisted
            dropped = map firstOf hoisted
            kept = filter (\p => not (memIndex (firstOf p) dropped)) (indexInstrs instrs)
          in insertAt li consts (map secondOf kept)

-- | 回边目标（不同标签去重）。单回边目标才允许提升。
backTargetsOf : List Instr -> List String
backTargetsOf instrs = backTargetsGo [] [] instrs

backTargetsGo : List String -> List String -> List Instr -> List String
backTargetsGo seen acc [] = acc
backTargetsGo seen acc (i :: rest) =
  case i of
    ILabel l => backTargetsGo (l :: seen) acc rest
    IJmp l => backTargetsGo seen (addBack l seen acc) rest
    IJcc _ l => backTargetsGo seen (addBack l seen acc) rest
    _ => backTargetsGo seen acc rest

addBack : String -> List String -> List String -> List String
addBack l seen acc = if memStr l seen && not (memStr l acc) then l :: acc else acc

firstLabelIndex : List Instr -> Maybe Int
firstLabelIndex instrs = firstLabelGo 0 instrs

firstLabelGo : Int -> List Instr -> Maybe Int
firstLabelGo _ [] = Nothing
firstLabelGo i ((ILabel _) :: _) = Just i
firstLabelGo i (_ :: rest) = firstLabelGo (i + 1) rest

-- | 可以提升的 `mov r, imm64`：立即数装不进 imm32 的装载、目标寄存器只在这里被写、
--   且在它之前没有被读。
hoistableConsts : List Instr -> List (Int, Instr)
hoistableConsts instrs =
  filter (\p => hoistableAt (firstOf p) (secondOf p) instrs) (indexInstrs instrs)

hoistableAt : Int -> Instr -> List Instr -> Bool
hoistableAt i (IMov (OpReg r) (OpImm k)) instrs =
  if isHoistReg r && needsImm64 k && countWrites r instrs == 1 then
    case firstReadIndex r instrs of
      Nothing => True
      Just j => j > i
  else
    False
hoistableAt _ _ _ = False

isHoistReg : Reg -> Bool
isHoistReg r = sameReg r R8 || sameReg r R9 || sameReg r R10 || sameReg r R11

needsImm64 : Int -> Bool
needsImm64 k = k > 2147483647 || k < 0 - 2147483648

countWrites : Reg -> List Instr -> Int
countWrites _ [] = 0
countWrites r (i :: rest) = (if instrWritesReg r i then 1 else 0) + countWrites r rest

firstReadIndex : Reg -> List Instr -> Maybe Int
firstReadIndex r instrs = firstReadGo 0 r instrs

firstReadGo : Int -> Reg -> List Instr -> Maybe Int
firstReadGo _ _ [] = Nothing
firstReadGo i r (ins :: rest) = if instrReadsReg r ins then Just i else firstReadGo (i + 1) r rest

indexInstrs : List Instr -> List (Int, Instr)
indexInstrs xs = indexInstrsGo 0 xs

indexInstrsGo : Int -> List Instr -> List (Int, Instr)
indexInstrsGo _ [] = []
indexInstrsGo i (x :: rest) = (i, x) :: indexInstrsGo (i + 1) rest

memIndex : Int -> List Int -> Bool
memIndex _ [] = False
memIndex i (j :: rest) = i == j || memIndex i rest

insertAt : Int -> List a -> List a -> List a
insertAt n xs ys =
  if n <= 0 then
    append xs ys
  else
    case ys of
      [] => xs
      y :: rest => y :: insertAt (n - 1) xs rest

-- | prologue 压了 callee-saved 之后，`[rbp+正偏移]` 的来参区整体上移。
--   只改正偏移；帧槽是负偏移，不动。
shiftPositiveOffsets : Int -> List Instr -> List Instr
shiftPositiveOffsets bytes = map (shiftInstrOff bytes)

shiftInstrOff : Int -> Instr -> Instr
shiftInstrOff bytes (IMov a b) = IMov (shiftOperandOff bytes a) (shiftOperandOff bytes b)
shiftInstrOff bytes (ICmp a b) = ICmp (shiftOperandOff bytes a) (shiftOperandOff bytes b)
shiftInstrOff bytes (IBin op a) = IBin op (shiftOperandOff bytes a)
shiftInstrOff bytes (IBinReg op r a) = IBinReg op r (shiftOperandOff bytes a)
shiftInstrOff bytes (ICmov cc r a) = ICmov cc r (shiftOperandOff bytes a)
shiftInstrOff _ i = i

shiftOperandOff : Int -> Operand -> Operand
shiftOperandOff bytes (OpMem Rbp off) = if off > 0 then OpMem Rbp (off + bytes) else OpMem Rbp off
shiftOperandOff _ o = o

isScalarCls : NCls -> Bool
isScalarCls NClsScalar = True
isScalarCls _ = False

memStr : String -> List String -> Bool
memStr _ [] = False
memStr s (x :: rest) = s == x || memStr s rest

memIntList : Int -> List Int -> Bool
memIntList _ [] = False
memIntList x (y :: rest) = if x == y then True else memIntList x rest

filterInts : List Int -> List Int -> List Int
filterInts _ [] = []
filterInts drop (x :: rest) =
  if memIntList x drop then filterInts drop rest else x :: filterInts drop rest

writesRegIn : Reg -> List Instr -> Bool
writesRegIn r instrs = foldl (\acc, i => acc || instrWritesReg r i) False instrs
