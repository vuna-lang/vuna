module Vuna.Target.Native.Inline where

-- 已知小函数的调用点内联：特化把函数值形参换成了直调，但直调仍是一次 `call`；
-- 这里把「体足够小、非递归、实参可重复求值」的顶层函数直接代进调用点，连调用都省掉。
--
-- 判据（都成立才内联）：
--   * 被调是非递归的顶层定义（不在递归名单里），没有 init guard；
--   * 体是 lambda，运行时 binder 数与实参个数相同，体节点数 ≤ `inlineSize`；
--   * 所有实参都是可重复求值的值：平凡值（变量 / 字面量 / 运行时叶子 / 顶层函数），
--     或不分配、不产生效应、不会失败的小标量表达式（加减乘 / 位运算 / 比较 / 非零常量
--     除法）——体内重复用到时只重算几条指令；
--   * 整程序内联次数没超预算。
--
-- 代入按 binder 身份做（身份全局唯一，不会捕获），随后丢掉体的结果位置标记：
-- `IrTail` 只对原定义成立，带进非尾位置会让 codegen 提前跳走。
--
-- 边界：只 import Base 与 `Vuna.Ir.*`；不改 ABI、运行时与栈帧布局。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Vuna.Ir.Analysis as Analysis
import Vuna.Ir.Kinds as Kinds
import Vuna.Ir.Model
import Vuna.Ir.Synthetic as Synthetic
import Vuna.Ir.Tail as Tail

-- | 单次内联允许的体节点数（只收直线小函数）。
inlineSize : Int
inlineSize = 16

-- | 整程序内联次数上限（防止代码膨胀）。
inlineBudget : Int
inlineBudget = 400

record Inl where
  inlUsed : Int
  inlCount : Int
  inlRec : List String
  inlOut : List IrDef

-- | 程序级内联：返回（可能去掉死定义前的）定义表与「是否发生过内联」。
export inlineDefs : List String -> List IrDef -> (List IrDef, Bool)
inlineDefs recNames defs =
  let
    st = foldl (\s, d => inlineOne defs s d) (Inl 0 0 recNames []) defs
  in (reverse st.inlOut, st.inlCount > 0)

inlineOne : List IrDef -> Inl -> IrDef -> Inl
inlineOne _ st (IrExternDef name ty sym span) =
  { st | inlOut = IrExternDef name ty sym span :: st.inlOut }
inlineOne defs st (IrDef nm ar deps ty body recOk guard span) =
  let
    p = rw (rwFuelOf body) defs body st
    st2 = secondOf p
    d2 = IrDef nm ar deps ty (firstOf p) recOk guard span
  in { st2 | inlOut = d2 :: st2.inlOut }

rwFuelOf : Ir -> Int
rwFuelOf body = 32 + 4 * irSize body

-- ---------------------------------------------------------------
-- 重写（按调用点）
-- ---------------------------------------------------------------
rw : Int -> List IrDef -> Ir -> Inl -> (Ir, Inl)
rw fuel defs ir st =
  if fuel <= 0 then
    (ir, st)
  else
    case ir of
      IrApp _ _ _ =>
        let
          p = Analysis.flattenApp ir
          head = firstOf p
          args = secondOf p
        in case head of
          -- `(if c then f else g) x` 先分到两支，避免把条件结果当动态 head 走 rt_apply。
          IrIf c t e => rw (fuel - 1) defs (IrIf c (Synthetic.applyAllIr t args) (Synthetic.applyAllIr e args)) st
          -- 立即 lambda 应用：先递归化简体，体只剩标量树时直接 β 归约。
          IrLam bs rt inner =>
            let
              pb = rw (fuel - 1) defs inner st
              inner1 = firstOf pb
            in if length (runtimeBindersOf bs) == length args && scalarOnly inner1 && irSize inner1 <= scalarInlineSize then
              let
                reps = inlineReps (runtimeBindersOf bs) args inner1
              in rw (fuel - 1) defs (wrapInlineLets (secondOf reps) (inlineBody (firstOf reps) inner1)) (secondOf pb)
            else
              rwApp (fuel - 1) defs (IrLam bs rt inner1) args (secondOf pb)
          IrGlobal name =>
            case defRuntimeArity name defs of
              -- 过度应用：按运行时 arity 拆成「先饱和、再应用剩余实参」，
              -- 让第一段能被内联（`pick p x` → `(pick p) x`），不直接掉进 rt_apply。
              Just ar =>
                if length args > ar then
                  let
                    sp = splitAt ar args
                    firstApp = Synthetic.applyAllIr (IrGlobal name) (firstOf sp)
                    p1 = rw (fuel - 1) defs firstApp st
                  in rwApplied (fuel - 1) defs (firstOf p1) (secondOf sp) (secondOf p1)
                else
                  case tryInline defs name args st of
                    -- 内联结果里可能还有刚暴露出来的调用（`apply1$s0` → `mk k acc`），
                    -- 继续在同一预算下改写，否则链式内联只走一层。
                    Just hit => rw (fuel - 1) defs (firstOf hit) (secondOf hit)
                    Nothing => rwApp (fuel - 1) defs head args st
              Nothing =>
                case tryInline defs name args st of
                  Just hit => rw (fuel - 1) defs (firstOf hit) (secondOf hit)
                  Nothing => rwApp (fuel - 1) defs head args st
          _ => rwApp (fuel - 1) defs head args st
      IrCtor fam ctor ty args => mapList (fuel - 1) (IrCtor fam ctor ty) defs args st
      IrRecord fam ty fields => mapFields (fuel - 1) (IrRecord fam ty) defs fields st
      IrProj base fam field ty =>
        let
          p = rw (fuel - 1) defs base st
        in (IrProj (firstOf p) fam field ty, secondOf p)
      IrRecUpd base fam fields ty =>
        let
          b = rw (fuel - 1) defs base st
          f = mapFieldsKeep (fuel - 1) defs fields (secondOf b)
        in (IrRecUpd (firstOf b) fam (firstOf f) ty, secondOf f)
      IrRtApp sym args =>
        let
          p = mapIrs (fuel - 1) defs args st
          args1 = firstOf p
        in case splitIfArgs args1 of
          Just (pre, c, t, e, post) =>
            if memStr sym scalarArgSyms && smallOtherArgs pre post then
              let
                tApp = IrRtApp sym (append pre (append [t] post))
                eApp = IrRtApp sym (append pre (append [e] post))
              in rw (fuel - 1) defs (IrIf c tApp eApp) (secondOf p)
            else
              (IrRtApp sym args1, secondOf p)
          Nothing => (IrRtApp sym args1, secondOf p)
      IrCast from to inner =>
        let
          p = rw (fuel - 1) defs inner st
        in (IrCast from to (firstOf p), secondOf p)
      IrTail inner =>
        let
          p = rw (fuel - 1) defs inner st
        in (IrTail (firstOf p), secondOf p)
      IrLet bs scrut body =>
        let
          s = rw (fuel - 1) defs scrut st
          b = rw (fuel - 1) defs body (secondOf s)
        in (IrLet bs (firstOf s) (firstOf b), secondOf b)
      IrLam bs rt body =>
        let
          p = rw (fuel - 1) defs body st
        in (IrLam bs rt (firstOf p), secondOf p)
      IrIf c t e =>
        let
          pc = rw (fuel - 1) defs c st
          pt = rw (fuel - 1) defs t (secondOf pc)
          pe = rw (fuel - 1) defs e (secondOf pt)
        in (IrIf (firstOf pc) (firstOf pt) (firstOf pe), secondOf pe)
      IrCase ty k scrut alts =>
        let
          ps = rw (fuel - 1) defs scrut st
          pa = mapAlts (fuel - 1) defs alts (secondOf ps)
        in (IrCase ty k (firstOf ps) (firstOf pa), secondOf pa)
      IrNatCase scrut f z s c =>
        let
          ps = rw (fuel - 1) defs scrut st
          pz = mapAltMaybe (fuel - 1) defs z (secondOf ps)
          psm = mapAltMaybe (fuel - 1) defs s (secondOf pz)
          pc = mapAltMaybe (fuel - 1) defs c (secondOf psm)
        in (IrNatCase (firstOf ps) f (firstOf pz) (firstOf psm) (firstOf pc), secondOf pc)
      IrConcatMany parts => mapList (fuel - 1) IrConcatMany defs parts st
      IrEffThunk fam ctor ty arity prim =>
        let
          p = rw (fuel - 1) defs prim st
        in (IrEffThunk fam ctor ty arity (firstOf p), secondOf p)
      _ => (ir, st)

-- | 找第一个 `IrIf` 实参，返回 (前缀, 条件, then, else, 后缀)。
splitIfArgs : List Ir -> Maybe (List Ir, Ir, Ir, Ir, List Ir)
splitIfArgs [] = Nothing
splitIfArgs (a :: rest) =
  case a of
    IrIf c t e => Just ([], c, t, e, rest)
    _ =>
      case splitIfArgs rest of
        Just (pre, c, t, e, post) => Just (a :: pre, c, t, e, post)
        Nothing => Nothing

-- | 分到两支后其余实参会被复制一份代码；只对小的其余实参做，避免代码膨胀。
smallOtherArgs : List Ir -> List Ir -> Bool
smallOtherArgs pre post = irSizeList pre + irSizeList post <= 16

irSizeList : List Ir -> Int
irSizeList [] = 0
irSizeList (x :: rest) = irSize x + irSizeList rest

-- | 把剩余实参接到已经改写过的 head 上；head 是 `if` 时先分到两支。
rwApplied : Int -> List IrDef -> Ir -> List Ir -> Inl -> (Ir, Inl)
rwApplied fuel defs head rest st =
  let
    applied =
      case head of
        IrIf c t e => IrIf c (Synthetic.applyAllIr t rest) (Synthetic.applyAllIr e rest)
        _ => Synthetic.applyAllIr head rest
  in rw (fuel - 1) defs applied st

splitAt : Int -> List a -> (List a, List a)
splitAt n xs =
  if n <= 0 then
    ([], xs)
  else
    case xs of
      [] => ([], [])
      x :: rest =>
        let
          p = splitAt (n - 1) rest
        in (x :: firstOf p, secondOf p)

rwApp : Int -> List IrDef -> Ir -> List Ir -> Inl -> (Ir, Inl)
rwApp fuel defs head args st =
  let
    h = rw (fuel - 1) defs head st
    a = mapIrs (fuel - 1) defs args (secondOf h)
  in (Synthetic.applyAllIr (firstOf h) (firstOf a), secondOf a)

mapList : Int -> (List Ir -> Ir) -> List IrDef -> List Ir -> Inl -> (Ir, Inl)
mapList fuel build defs xs st =
  let
    p = mapIrs fuel defs xs st
  in (build (firstOf p), secondOf p)

mapIrs : Int -> List IrDef -> List Ir -> Inl -> (List Ir, Inl)
mapIrs _ _ [] st = ([], st)
mapIrs fuel defs (x :: rest) st =
  if fuel <= 0 then
    (x :: rest, st)
  else
    let
      px = rw (fuel - 1) defs x st
      pr = mapIrs (fuel - 1) defs rest (secondOf px)
    in (firstOf px :: firstOf pr, secondOf pr)

mapFields : Int -> (List (String, Ir) -> Ir) -> List IrDef -> List (String, Ir) -> Inl -> (Ir, Inl)
mapFields fuel build defs fields st =
  let
    p = mapFieldsKeep fuel defs fields st
  in (build (firstOf p), secondOf p)

mapFieldsKeep : Int -> List IrDef -> List (String, Ir) -> Inl -> (List (String, Ir), Inl)
mapFieldsKeep _ _ [] st = ([], st)
mapFieldsKeep fuel defs (p :: rest) st =
  if fuel <= 0 then
    (p :: rest, st)
  else
    let
      pv = rw (fuel - 1) defs (secondOf p) st
      pr = mapFieldsKeep (fuel - 1) defs rest (secondOf pv)
    in ((firstOf p, firstOf pv) :: firstOf pr, secondOf pr)

mapAlt : Int -> List IrDef -> IrAlt -> Inl -> (IrAlt, Inl)
mapAlt fuel defs alt st =
  let
    p = rw (fuel - 1) defs alt.irAltBody st
  in (IrAlt alt.irAltCtor alt.irAltBinders (firstOf p), secondOf p)

mapAltMaybe : Int -> List IrDef -> Maybe IrAlt -> Inl -> (Maybe IrAlt, Inl)
mapAltMaybe _ _ Nothing st = (Nothing, st)
mapAltMaybe fuel defs (Just alt) st =
  let
    p = mapAlt fuel defs alt st
  in (Just (firstOf p), secondOf p)

mapAlts : Int -> List IrDef -> List IrAlt -> Inl -> (List IrAlt, Inl)
mapAlts _ _ [] st = ([], st)
mapAlts fuel defs (a :: rest) st =
  if fuel <= 0 then
    (a :: rest, st)
  else
    let
      pa = mapAlt fuel defs a st
      pr = mapAlts (fuel - 1) defs rest (secondOf pa)
    in (firstOf pa :: firstOf pr, secondOf pr)

-- ---------------------------------------------------------------
-- 内联判定
-- ---------------------------------------------------------------
tryInline : List IrDef -> String -> List Ir -> Inl -> Maybe (Ir, Inl)
tryInline defs name args st =
  if memStr name st.inlRec then
    Nothing
  else if st.inlUsed >= inlineBudget then
    Nothing
  else
    case findDef name defs of
      Nothing => Nothing
      Just d =>
        case d of
          IrExternDef _ _ _ _ => Nothing
          IrDef _ _ _ _ body _ guard _ =>
            if guard then
              Nothing
            else
              case body of
                IrLam bs _ inner =>
                  let
                    rbs = runtimeBindersOf bs
                  in if length rbs /= length args then
                    Nothing
                  else if not (allInlinableArg defs args) then
                    Nothing
                  else if not (bodySmallEnough inner) then
                    Nothing
                  else if hasLam inner then
                    Nothing
                  else
                    let
                      reps = inlineReps rbs args inner
                      body2 = Tail.stripTail (wrapInlineLets (secondOf reps) (inlineBody (firstOf reps) inner))
                      st2 = { st | inlUsed = st.inlUsed + 1, inlCount = st.inlCount + 1 }
                    in Just (body2, st2)
                _ => Nothing

-- | 体里带 lambda 的定义不内联：把闭包体拖进调用者，既复制代码也放大调用者的帧
--   （保守 GC 的阈值跟栈跨度走，帧变大会推迟回收）。
hasLam : Ir -> Bool
hasLam (IrLam _ _ _) = True
hasLam (IrCtor _ _ _ args) = anyHasLam args
hasLam (IrRecord _ _ fields) = anyHasLamFields fields
hasLam (IrProj base _ _ _) = hasLam base
hasLam (IrRecUpd base _ fields _) = hasLam base || anyHasLamFields fields
hasLam (IrRtApp _ args) = anyHasLam args
hasLam (IrCast _ _ inner) = hasLam inner
hasLam (IrLet _ s b) = hasLam s || hasLam b
hasLam (IrApp _ f a) = hasLam f || hasLam a
hasLam (IrTail inner) = hasLam inner
hasLam (IrIf c t e) = hasLam c || hasLam t || hasLam e
hasLam (IrCase _ _ s alts) = hasLam s || anyHasLamAlts alts
hasLam (IrNatCase s _ z a b) = hasLam s || anyHasLamAltM z || anyHasLamAltM a || anyHasLamAltM b
hasLam (IrConcatMany parts) = anyHasLam parts
hasLam (IrEffThunk _ _ _ _ prim) = hasLam prim
hasLam _ = False

anyHasLam : List Ir -> Bool
anyHasLam [] = False
anyHasLam (x :: rest) = if hasLam x then True else anyHasLam rest

anyHasLamFields : List (String, Ir) -> Bool
anyHasLamFields [] = False
anyHasLamFields (p :: rest) = if hasLam (secondOf p) then True else anyHasLamFields rest

anyHasLamAlts : List IrAlt -> Bool
anyHasLamAlts [] = False
anyHasLamAlts (a :: rest) = if hasLam a.irAltBody then True else anyHasLamAlts rest

anyHasLamAltM : Maybe IrAlt -> Bool
anyHasLamAltM Nothing = False
anyHasLamAltM (Just a) = hasLam a.irAltBody

-- | 实参可以是平凡值、可重复求值的标量表达式，或**同作用域内**的已知定义部分应用
--   （`mk k`）：内联会把形参换成实参表达式，部分应用留在调用方作用域里，不涉及捕获。
allInlinableArg : List IrDef -> List Ir -> Bool
allInlinableArg _ [] = True
allInlinableArg defs (a :: rest) = if inlinableArg defs a then allInlinableArg defs rest else False

inlinableArg : List IrDef -> Ir -> Bool
inlinableArg defs (IrRtApp sym args) =
  (memStr sym scalarArgSyms || (isDivLike sym && divisorSafe args)) && allInlinableArg defs args
inlinableArg defs (IrApp _ f a) =
  case appHeadGlobal f of
    Just n =>
      case defRuntimeArity n defs of
        Just ar => 1 + appArgCount f <= ar && allInlinableArg defs (a :: appArgs f)
        Nothing => False
    Nothing => False
inlinableArg _ ir = trivialArg ir

-- | 已知顶层定义的欠应用（`mk k`）：实参个数小于运行时 binder 数。
appHeadGlobal : Ir -> Maybe String
appHeadGlobal (IrApp _ f _) = appHeadGlobal f
appHeadGlobal (IrGlobal n) = Just n
appHeadGlobal _ = Nothing

appArgCount : Ir -> Int
appArgCount (IrApp _ f _) = 1 + appArgCount f
appArgCount _ = 0

-- | 应用的实参（顺序无关，只用于逐个判可内联）。递归在函数位（直接子项）上。
appArgs : Ir -> List Ir
appArgs (IrApp _ f a) = a :: appArgs f
appArgs _ = []

defRuntimeArity : String -> List IrDef -> Maybe Int
defRuntimeArity n defs =
  case findDef n defs of
    Just (IrDef _ _ _ _ (IrLam bs _ _) _ _ _) => Just (length (runtimeBindersOf bs))
    _ => Nothing

-- | 可以安全重复求值的标量运行时符号。除法 / 取模只收「除数是非零字面量」的形状
--   （其余形状会在运行时 trap，重复求值就改变了失败点的位置）。
scalarArgSyms : List String
scalarArgSyms =
  [
    "+",
    "-",
    "*",
    "bitAnd",
    "bitOr",
    "bitXor",
    "bitNot",
    "bitShl",
    "bitShr",
    "bi_eq_int",
    "bi_neq_int",
    "bi_lt_int",
    "bi_le_int",
    "bi_gt_int",
    "bi_ge_int",
    "bi_eq_bool",
    "bi_neq_bool",
    "bi_lt_bool",
    "bi_le_bool",
    "bi_gt_bool",
    "bi_ge_bool",
    "natAdd",
    "natSub",
    "natMul",
    "natToInt",
    "natFromInt"
  ]

isDivLike : String -> Bool
isDivLike "/" = True
isDivLike "%" = True
isDivLike "mod" = True
isDivLike _ = False

divisorSafe : List Ir -> Bool
divisorSafe [_, IrInt d] = d /= 0
divisorSafe _ = False

-- | 普通内联的上限（`inlineSize`）；纯标量体（全由变量 / 字面量 / 白名单标量叶子组成）
--   放宽到 `scalarInlineSize`：这类体没有分配、调用与分支，展开只是多几条算术。
scalarInlineSize : Int
scalarInlineSize = 64

bodySmallEnough : Ir -> Bool
bodySmallEnough inner =
  if irSize inner <= inlineSize then True else irSize inner <= scalarInlineSize && scalarOnly inner

scalarOnly : Ir -> Bool
scalarOnly (IrVar _) = True
scalarOnly (IrInt _) = True
scalarOnly (IrBool _) = True
scalarOnly (IrFloatLit _) = True
scalarOnly (IrRtApp sym args) = memStr sym scalarArgSyms && allScalar args
scalarOnly (IrCast _ _ inner) = scalarOnly inner
scalarOnly (IrTail inner) = scalarOnly inner
scalarOnly _ = False

allScalar : List Ir -> Bool
allScalar [] = True
allScalar (x :: rest) = if scalarOnly x then allScalar rest else False

countBinderUses : Int -> Ir -> Int
countBinderUses id (IrVar b) = if b.irBinderId == id then 1 else 0
countBinderUses id (IrLam _ _ body) = countBinderUses id body
countBinderUses id (IrLet _ scrut body) = countBinderUses id scrut + countBinderUses id body
countBinderUses id (IrApp _ f a) = countBinderUses id f + countBinderUses id a
countBinderUses id (IrIf c t e) = countBinderUses id c + countBinderUses id t + countBinderUses id e
countBinderUses id (IrCase _ _ scrut alts) = countBinderUses id scrut + sumAltUses id alts
countBinderUses id (IrNatCase scrut _ z s c) =
  countBinderUses id scrut + (altUse id z + altUse id s + altUse id c)
countBinderUses id (IrCtor _ _ _ args) = sumUses id args
countBinderUses id (IrRecord _ _ fields) = sumFieldUses id fields
countBinderUses id (IrProj base _ _ _) = countBinderUses id base
countBinderUses id (IrRecUpd base _ fields _) = countBinderUses id base + sumFieldUses id fields
countBinderUses id (IrRtApp _ args) = sumUses id args
countBinderUses id (IrCast _ _ inner) = countBinderUses id inner
countBinderUses id (IrTail inner) = countBinderUses id inner
countBinderUses id (IrConcatMany parts) = sumUses id parts
countBinderUses id (IrEffThunk _ _ _ _ prim) = countBinderUses id prim
countBinderUses _ _ = 0

sumUses : Int -> List Ir -> Int
sumUses _ [] = 0
sumUses id (x :: rest) = countBinderUses id x + sumUses id rest

sumAltUses : Int -> List IrAlt -> Int
sumAltUses _ [] = 0
sumAltUses id (a :: rest) = countBinderUses id a.irAltBody + sumAltUses id rest

altUse : Int -> Maybe IrAlt -> Int
altUse _ Nothing = 0
altUse id (Just a) = countBinderUses id a.irAltBody

sumFieldUses : Int -> List (String, Ir) -> Int
sumFieldUses _ [] = 0
sumFieldUses id (p :: rest) = countBinderUses id (secondOf p) + sumFieldUses id rest

trivialArg : Ir -> Bool
trivialArg (IrVar _) = True
trivialArg (IrGlobal _) = True
trivialArg (IrRt _) = True
trivialArg (IrInt _) = True
trivialArg (IrStr _) = True
trivialArg (IrBool _) = True
trivialArg (IrFloatLit _) = True
trivialArg _ = False

-- | 平凡或只出现一次的实参直接替换；会复制多次的非平凡实参改成一条 `let`，
--   保证内联不重复求值（也让寄存器压力不随使用次数翻倍）。
inlineReps : List IrBinder -> List Ir -> Ir -> (List (Int, Ir), List (IrBinder, Ir))
inlineReps [] _ _ = ([], [])
inlineReps _ [] _ = ([], [])
inlineReps (b :: brest) (a :: arest) inner =
  let
    rest = inlineReps brest arest inner
  in if trivialArg a || countBinderUses b.irBinderId inner <= 1 then
    ((b.irBinderId, a) :: firstOf rest, secondOf rest)
  else
    (firstOf rest, (b, a) :: secondOf rest)

wrapInlineLets : List (IrBinder, Ir) -> Ir -> Ir
wrapInlineLets [] body = body
wrapInlineLets (p :: rest) body = IrLet [firstOf p] (secondOf p) (wrapInlineLets rest body)

pairBinders : List IrBinder -> List Ir -> List (Int, Ir)
pairBinders [] _ = []
pairBinders _ [] = []
pairBinders (b :: brest) (a :: arest) = (b.irBinderId, a) :: pairBinders brest arest

-- ---------------------------------------------------------------
-- 代入（按 binder 身份）
-- ---------------------------------------------------------------
inlineBody : List (Int, Ir) -> Ir -> Ir
inlineBody reps (IrVar b) =
  case lookupId b.irBinderId reps of
    Just r => r
    Nothing => IrVar b
inlineBody reps (IrLam bs rt body) = IrLam bs rt (inlineBody reps body)
inlineBody reps (IrLet bs scrut body) = IrLet bs (inlineBody reps scrut) (inlineBody reps body)
inlineBody reps (IrApp ty f a) = IrApp ty (inlineBody reps f) (inlineBody reps a)
inlineBody reps (IrIf c t e) = IrIf (inlineBody reps c) (inlineBody reps t) (inlineBody reps e)
inlineBody reps (IrCase ty k scrut alts) =
  IrCase ty k (inlineBody reps scrut) (map (inlineAlt reps) alts)
inlineBody reps (IrNatCase scrut f z s c) =
  IrNatCase (inlineBody reps scrut) f (inlineAltM reps z) (inlineAltM reps s) (inlineAltM reps c)
inlineBody reps (IrCtor fam ctor ty args) = IrCtor fam ctor ty (map (inlineBody reps) args)
inlineBody reps (IrRecord fam ty fields) =
  IrRecord fam ty (map (\p => (firstOf p, inlineBody reps (secondOf p))) fields)
inlineBody reps (IrProj base fam field ty) = IrProj (inlineBody reps base) fam field ty
inlineBody reps (IrRecUpd base fam fields ty) =
  IrRecUpd
    (inlineBody reps base)
    fam
    (map (\p => (firstOf p, inlineBody reps (secondOf p))) fields)
    ty
inlineBody reps (IrRtApp sym args) = IrRtApp sym (map (inlineBody reps) args)
inlineBody reps (IrCast from to inner) = IrCast from to (inlineBody reps inner)
inlineBody reps (IrTail inner) = IrTail (inlineBody reps inner)
inlineBody reps (IrConcatMany parts) = IrConcatMany (map (inlineBody reps) parts)
inlineBody reps (IrEffThunk fam ctor ty arity prim) =
  IrEffThunk fam ctor ty arity (inlineBody reps prim)
inlineBody _ ir = ir

inlineAlt : List (Int, Ir) -> IrAlt -> IrAlt
inlineAlt reps alt = IrAlt alt.irAltCtor alt.irAltBinders (inlineBody reps alt.irAltBody)

inlineAltM : List (Int, Ir) -> Maybe IrAlt -> Maybe IrAlt
inlineAltM _ Nothing = Nothing
inlineAltM reps (Just alt) = Just (inlineAlt reps alt)

lookupId : Int -> List (Int, Ir) -> Maybe Ir
lookupId _ [] = Nothing
lookupId id (p :: rest) = if firstOf p == id then Just (secondOf p) else lookupId id rest

-- ---------------------------------------------------------------
-- 小工具
-- ---------------------------------------------------------------
runtimeBindersOf : List IrBinder -> List IrBinder
runtimeBindersOf [] = []
runtimeBindersOf (b :: rest) =
  if b.irBinderErased then runtimeBindersOf rest else b :: runtimeBindersOf rest

findDef : String -> List IrDef -> Maybe IrDef
findDef _ [] = Nothing
findDef n (d :: rest) = if irDefName d == n then Just d else findDef n rest

memInt : Int -> List Int -> Bool
memInt _ [] = False
memInt x (y :: rest) = if x == y then True else memInt x rest

memStr : String -> List String -> Bool
memStr _ [] = False
memStr s (x :: rest) = if s == x then True else memStr s rest

-- ---------------------------------------------------------------
-- 尾位置内联：把互递归 SCC 变成自递归
-- ---------------------------------------------------------------
-- 只内联**尾位置**、且当前定义在源码顺序上早于被调（每个 SCC 只沿一个方向展开），
-- 这样 `even -> odd` / `narrow -> wide` 会把对方的体代进来，体里回到自己的调用
-- 变成自递归 tail call，随后走 native 已有的自循环帧复用。非尾位置与自调用不动。
export tailInlineSize : Int
tailInlineSize = 128

tailInlineBudget : Int
tailInlineBudget = 32

record TInl where
  tiUsed : Int
  tiChanged : Bool
  tiOut : List IrDef

export inlineTailDefs : List String -> List IrDef -> (List IrDef, Bool)
inlineTailDefs recNames defs =
  let
    order = nameOrder defs 0 []
    st = foldl (\s, d => tailInlineOne recNames order defs s d) (TInl 0 False []) defs
  in (reverse st.tiOut, st.tiChanged)

tailInlineOne : List String -> List (String, Int) -> List IrDef -> TInl -> IrDef -> TInl
tailInlineOne _ _ _ st (IrExternDef name ty sym span) =
  { st | tiOut = IrExternDef name ty sym span :: st.tiOut }
tailInlineOne recNames order defs st (IrDef nm ar deps ty body recOk guard span) =
  if not (memStr nm recNames) then
    { st | tiOut = IrDef nm ar deps ty body recOk guard span :: st.tiOut }
  else
    let
      p = tailRw 4 recNames order defs nm (indexOfName nm order) body st
      d2 = IrDef nm ar deps ty (firstOf p) recOk guard span
    in { (secondOf p) | tiOut = d2 :: (secondOf p).tiOut }

-- | 只有尾位置递归；`IrTail` / `IrIf` 两支 / `IrLet` 体 / case 臂是透明位置。
tailRw : Int -> List String -> List (String, Int) -> List IrDef -> String -> Int -> Ir -> TInl -> (Ir, TInl)
tailRw fuel recNames order defs current meIdx ir st =
  if fuel <= 0 then
    (ir, st)
  else
    case ir of
      IrLam bs rt inner =>
        let
          p = tailRw (fuel - 1) recNames order defs current meIdx inner st
        in (IrLam bs rt (firstOf p), secondOf p)
      IrTail inner =>
        let
          p = tailRw (fuel - 1) recNames order defs current meIdx inner st
        in (IrTail (firstOf p), secondOf p)
      IrIf c t e =>
        let
          pt = tailRw (fuel - 1) recNames order defs current meIdx t st
          pe = tailRw (fuel - 1) recNames order defs current meIdx e (secondOf pt)
        in (IrIf c (firstOf pt) (firstOf pe), secondOf pe)
      IrLet bs scrut body =>
        let
          p = tailRw (fuel - 1) recNames order defs current meIdx body st
        in (IrLet bs scrut (firstOf p), secondOf p)
      IrCast from to inner =>
        let
          p = tailRw (fuel - 1) recNames order defs current meIdx inner st
        in (IrCast from to (firstOf p), secondOf p)
      IrCase ty k scrut alts =>
        let
          pa = tailRwAlts (fuel - 1) recNames order defs current meIdx alts st
        in (IrCase ty k scrut (firstOf pa), secondOf pa)
      IrNatCase scrut f z s c =>
        let
          pz = tailRwAltM (fuel - 1) recNames order defs current meIdx z st
          ps = tailRwAltM (fuel - 1) recNames order defs current meIdx s (secondOf pz)
          pc = tailRwAltM (fuel - 1) recNames order defs current meIdx c (secondOf ps)
        in (IrNatCase scrut f (firstOf pz) (firstOf ps) (firstOf pc), secondOf pc)
      IrApp _ _ _ =>
        let
          flat = Analysis.flattenApp ir
        in case firstOf flat of
          IrGlobal g =>
            if not (memStr g recNames) then
              (ir, st)
            else if g == current then
              (ir, st)
            else if indexOfName g order <= meIdx then
              (ir, st)
            else
              case tryTailInline defs current g (secondOf flat) st of
                Just hit => (firstOf hit, secondOf hit)
                Nothing => (ir, st)
          _ => (ir, st)
      _ => (ir, st)

tailRwAltM : Int -> List String -> List (String, Int) -> List IrDef -> String -> Int -> Maybe IrAlt -> TInl -> (Maybe IrAlt, TInl)
tailRwAltM _ _ _ _ _ _ Nothing st = (Nothing, st)
tailRwAltM fuel recNames order defs current meIdx (Just alt) st =
  let
    p = tailRw fuel recNames order defs current meIdx alt.irAltBody st
  in (Just (IrAlt alt.irAltCtor alt.irAltBinders (firstOf p)), secondOf p)

tailRwAlts : Int -> List String -> List (String, Int) -> List IrDef -> String -> Int -> List IrAlt -> TInl -> (List IrAlt, TInl)
tailRwAlts _ _ _ _ _ _ [] st = ([], st)
tailRwAlts fuel recNames order defs current meIdx (a :: rest) st =
  let
    pa = tailRw fuel recNames order defs current meIdx a.irAltBody st
    pr = tailRwAlts fuel recNames order defs current meIdx rest (secondOf pa)
  in (IrAlt a.irAltCtor a.irAltBinders (firstOf pa) :: firstOf pr, secondOf pr)

tryTailInline : List IrDef -> String -> String -> List Ir -> TInl -> Maybe (Ir, TInl)
tryTailInline defs current name args st =
  if st.tiUsed >= tailInlineBudget then
    Nothing
  else
    case findDef name defs of
      Nothing => Nothing
      Just d =>
        case d of
          IrExternDef _ _ _ _ => Nothing
          IrDef _ _ _ _ body _ guard _ =>
            if guard then
              Nothing
            else
              case body of
                IrLam bs _ inner =>
                  let
                    rbs = runtimeBindersOf bs
                  in if length rbs /= length args then
                    Nothing
                  else if not (allInlinableArg defs args) then
                    Nothing
                  else if irSize inner > tailInlineSize then
                    Nothing
                  else if hasLam inner then
                    Nothing
                  else
                    let
                      body2 = inlineBody (pairBinders rbs args) inner
                      st2 = { st | tiUsed = st.tiUsed + 1, tiChanged = True }
                    in Just (body2, st2)
                _ => Nothing

nameOrder : List IrDef -> Int -> List (String, Int) -> List (String, Int)
nameOrder [] _ acc = acc
nameOrder (d :: rest) i acc = nameOrder rest (i + 1) ((irDefName d, i) :: acc)

indexOfName : String -> List (String, Int) -> Int
indexOfName _ [] = 0 - 1
indexOfName n (p :: rest) = if firstOf p == n then secondOf p else indexOfName n rest

-- ---------------------------------------------------------------
-- 循环归纳变量消去
-- ---------------------------------------------------------------
-- | `loop acc n = if n <= 0 then acc else loop (acc + (n - K) / D) (n - 1)`
--   里的 `n - K` 与 `n` 同步递减。把参数改成 `m = n - K`：所有外部调用点传 `n - K`，
--   守卫变成 `m <= -K`，自调用仍是 `m - 1`，循环里不再每轮重算 `n - K`。
--   判据：`n` 在函数体里恰好出现三次（守卫、`n - K`、自调用实参 `n - 1`），
--   `K > 1`，且每个调用方的函数体里只引用这个定义一次（直接饱和调用，实参是非负字面量）。
--   入口实参限制为字面量，保证 `n - K` 不会在 63-bit 边界上回绕。
record LsrPlan where
  lsrName : String
  lsrArity : Int
  lsrIdx : Int
  lsrId : Int
  lsrK : Int

export lsrDefs : List IrDef -> List IrDef
lsrDefs defs =
  case firstLsrPlan defs of
    Nothing => defs
    Just plan =>
      case lsrCallersOf plan defs of
        Nothing => defs
        Just _ => map (lsrApply plan) defs

firstLsrPlan : List IrDef -> Maybe LsrPlan
firstLsrPlan [] = Nothing
firstLsrPlan (d :: rest) =
  case lsrPlanOf d of
    Just p => Just p
    Nothing => firstLsrPlan rest

lsrPlanOf : IrDef -> Maybe LsrPlan
lsrPlanOf (IrExternDef _ _ _ _) = Nothing
lsrPlanOf (IrDef name arity _ _ body _ _ _) =
  case body of
    IrLam bs _ inner =>
      case inner of
        IrIf (IrRtApp "bi_le_int" [IrVar n, IrInt 0]) _ rest =>
          case lsrSelfArgs name rest of
            Just args =>
              let
                rbs = runtimeBindersOf bs
              in if length args /= arity then
                Nothing
              else
                case lsrCounterIdx rbs args 0 of
                  Just idx =>
                    case lsrNthBinder idx rbs of
                      Just nb =>
                        if nb.irBinderId == n.irBinderId && lsrCountVar nb.irBinderId inner == 3 && lsrCountGlobal name inner == 1 then
                          case lsrSubKs nb.irBinderId inner of
                            [k] => if k > 1 then Just (LsrPlan name arity idx nb.irBinderId k) else Nothing
                            _ => Nothing
                        else
                          Nothing
                      Nothing => Nothing
                  Nothing => Nothing
            Nothing => Nothing
        _ => Nothing
    _ => Nothing

lsrSelfArgs : String -> Ir -> Maybe (List Ir)
lsrSelfArgs name (IrTail inner) = lsrSelfArgs name inner
lsrSelfArgs name (ir@(IrApp _ _ _)) =
  let
    flat = Analysis.flattenApp ir
  in case firstOf flat of
    IrGlobal g => if g == name then Just (secondOf flat) else Nothing
    _ => Nothing
lsrSelfArgs name _ = Nothing

lsrCounterIdx : List IrBinder -> List Ir -> Int -> Maybe Int
lsrCounterIdx _ [] _ = Nothing
lsrCounterIdx [] _ _ = Nothing
lsrCounterIdx (b :: brest) (a :: arest) i =
  case a of
    IrRtApp "-" [IrVar x, IrInt 1] =>
      if x.irBinderId == b.irBinderId then Just i else lsrCounterIdx brest arest (i + 1)
    _ => lsrCounterIdx brest arest (i + 1)

lsrNthBinder : Int -> List IrBinder -> Maybe IrBinder
lsrNthBinder i bs =
  if i <= 0 then
    case bs of
      b :: _ => Just b
      [] => Nothing
  else
    case bs of
      [] => Nothing
      _ :: rest => lsrNthBinder (i - 1) rest

lsrSubKs : Int -> Ir -> List Int
lsrSubKs id (IrRtApp "-" [IrVar b, IrInt k]) =
  if b.irBinderId == id && k > 1 then [k] else lsrSubKsList id [IrVar b, IrInt k]
lsrSubKs id (IrTail x) = lsrSubKs id x
lsrSubKs id (IrCtor _ _ _ args) = lsrSubKsList id args
lsrSubKs id (IrRecord _ _ fields) = lsrSubKsFields id fields
lsrSubKs id (IrProj base _ _ _) = lsrSubKs id base
lsrSubKs id (IrRecUpd base _ fields _) = append (lsrSubKs id base) (lsrSubKsFields id fields)
lsrSubKs id (IrRtApp _ args) = lsrSubKsList id args
lsrSubKs id (IrCast _ _ x) = lsrSubKs id x
lsrSubKs id (IrLet _ s b) = append (lsrSubKs id s) (lsrSubKs id b)
lsrSubKs id (IrLam _ _ b) = lsrSubKs id b
lsrSubKs id (IrApp _ f a) = append (lsrSubKs id f) (lsrSubKs id a)
lsrSubKs id (IrIf c t e) = append (lsrSubKs id c) (append (lsrSubKs id t) (lsrSubKs id e))
lsrSubKs id (IrCase _ _ s alts) = append (lsrSubKs id s) (lsrSubKsAlts id alts)
lsrSubKs id (IrNatCase s _ z su c) =
  append
    (lsrSubKs id s)
    (append (lsrSubKsAltM id z) (append (lsrSubKsAltM id su) (lsrSubKsAltM id c)))
lsrSubKs id (IrConcatMany parts) = lsrSubKsList id parts
lsrSubKs id (IrEffThunk _ _ _ _ prim) = lsrSubKs id prim
lsrSubKs id _ = []

lsrSubKsList : Int -> List Ir -> List Int
lsrSubKsList _ [] = []
lsrSubKsList id (x :: rest) = append (lsrSubKs id x) (lsrSubKsList id rest)

lsrSubKsFields : Int -> List (String, Ir) -> List Int
lsrSubKsFields _ [] = []
lsrSubKsFields id (p :: rest) = append (lsrSubKs id (secondOf p)) (lsrSubKsFields id rest)

lsrSubKsAlts : Int -> List IrAlt -> List Int
lsrSubKsAlts _ [] = []
lsrSubKsAlts id (a :: rest) = append (lsrSubKs id a.irAltBody) (lsrSubKsAlts id rest)

lsrSubKsAltM : Int -> Maybe IrAlt -> List Int
lsrSubKsAltM _ Nothing = []
lsrSubKsAltM id (Just a) = lsrSubKs id a.irAltBody

lsrCountVar : Int -> Ir -> Int
lsrCountVar id (IrVar b) = if b.irBinderId == id then 1 else 0
lsrCountVar id (IrTail x) = lsrCountVar id x
lsrCountVar id (IrCtor _ _ _ args) = lsrCountList id args
lsrCountVar id (IrRecord _ _ fields) = lsrCountFields id fields
lsrCountVar id (IrProj base _ _ _) = lsrCountVar id base
lsrCountVar id (IrRecUpd base _ fields _) = lsrCountVar id base + lsrCountFields id fields
lsrCountVar id (IrRtApp _ args) = lsrCountList id args
lsrCountVar id (IrCast _ _ x) = lsrCountVar id x
lsrCountVar id (IrLet _ s b) = lsrCountVar id s + lsrCountVar id b
lsrCountVar id (IrLam _ _ b) = lsrCountVar id b
lsrCountVar id (IrApp _ f a) = lsrCountVar id f + lsrCountVar id a
lsrCountVar id (IrIf c t e) = lsrCountVar id c + lsrCountVar id t + lsrCountVar id e
lsrCountVar id (IrCase _ _ s alts) = lsrCountVar id s + lsrCountAlts id alts
lsrCountVar id (IrNatCase s _ z su c) =
  lsrCountVar id s + lsrCountAltM id z + lsrCountAltM id su + lsrCountAltM id c
lsrCountVar id (IrConcatMany parts) = lsrCountList id parts
lsrCountVar id (IrEffThunk _ _ _ _ prim) = lsrCountVar id prim
lsrCountVar id _ = 0

lsrCountGlobal : String -> Ir -> Int
lsrCountGlobal name (IrGlobal g) = if g == name then 1 else 0
lsrCountGlobal name (IrTail x) = lsrCountGlobal name x
lsrCountGlobal name (IrCtor _ _ _ args) = lsrCountGlobalList name args
lsrCountGlobal name (IrRecord _ _ fields) = lsrCountGlobalFields name fields
lsrCountGlobal name (IrProj base _ _ _) = lsrCountGlobal name base
lsrCountGlobal name (IrRecUpd base _ fields _) =
  lsrCountGlobal name base + lsrCountGlobalFields name fields
lsrCountGlobal name (IrRtApp _ args) = lsrCountGlobalList name args
lsrCountGlobal name (IrCast _ _ x) = lsrCountGlobal name x
lsrCountGlobal name (IrLet _ s b) = lsrCountGlobal name s + lsrCountGlobal name b
lsrCountGlobal name (IrLam _ _ b) = lsrCountGlobal name b
lsrCountGlobal name (IrApp _ f a) = lsrCountGlobal name f + lsrCountGlobal name a
lsrCountGlobal name (IrIf c t e) =
  lsrCountGlobal name c + lsrCountGlobal name t + lsrCountGlobal name e
lsrCountGlobal name (IrCase _ _ s alts) = lsrCountGlobal name s + lsrCountGlobalAlts name alts
lsrCountGlobal name (IrNatCase s _ z su c) =
  lsrCountGlobal name s
    + lsrCountGlobalAltM name z + lsrCountGlobalAltM name su + lsrCountGlobalAltM name c
lsrCountGlobal name (IrConcatMany parts) = lsrCountGlobalList name parts
lsrCountGlobal name (IrEffThunk _ _ _ _ prim) = lsrCountGlobal name prim
lsrCountGlobal name _ = 0

lsrCountList : Int -> List Ir -> Int
lsrCountList _ [] = 0
lsrCountList id (x :: rest) = lsrCountVar id x + lsrCountList id rest

lsrCountFields : Int -> List (String, Ir) -> Int
lsrCountFields _ [] = 0
lsrCountFields id (p :: rest) = lsrCountVar id (secondOf p) + lsrCountFields id rest

lsrCountAlts : Int -> List IrAlt -> Int
lsrCountAlts _ [] = 0
lsrCountAlts id (a :: rest) = lsrCountVar id a.irAltBody + lsrCountAlts id rest

lsrCountAltM : Int -> Maybe IrAlt -> Int
lsrCountAltM _ Nothing = 0
lsrCountAltM id (Just a) = lsrCountVar id a.irAltBody

lsrCountGlobalList : String -> List Ir -> Int
lsrCountGlobalList _ [] = 0
lsrCountGlobalList name (x :: rest) = lsrCountGlobal name x + lsrCountGlobalList name rest

lsrCountGlobalFields : String -> List (String, Ir) -> Int
lsrCountGlobalFields _ [] = 0
lsrCountGlobalFields name (p :: rest) =
  lsrCountGlobal name (secondOf p) + lsrCountGlobalFields name rest

lsrCountGlobalAlts : String -> List IrAlt -> Int
lsrCountGlobalAlts _ [] = 0
lsrCountGlobalAlts name (a :: rest) = lsrCountGlobal name a.irAltBody + lsrCountGlobalAlts name rest

lsrCountGlobalAltM : String -> Maybe IrAlt -> Int
lsrCountGlobalAltM _ Nothing = 0
lsrCountGlobalAltM name (Just a) = lsrCountGlobal name a.irAltBody

-- | 所有调用方（除目标定义本身）都必须只有一次引用、直接饱和调用、实参是非负字面量。
lsrCallersOf : LsrPlan -> List IrDef -> Maybe Unit
lsrCallersOf plan defs = lsrCallersGo plan defs

lsrCallersGo : LsrPlan -> List IrDef -> Maybe Unit
lsrCallersGo _ [] = Just MkUnit
lsrCallersGo plan (d :: rest) =
  case d of
    IrExternDef _ _ _ _ => lsrCallersGo plan rest
    IrDef name _ _ _ body _ _ _ =>
      if name == plan.lsrName then
        lsrCallersGo plan rest
      else if lsrCountGlobal plan.lsrName body == 0 then
        lsrCallersGo plan rest
      else
        case lsrCallerArgs plan body of
          Just args =>
            if length args == plan.lsrArity then
              case lsrArgAt plan.lsrIdx args of
                Just (IrInt n0) => if n0 >= 0 then lsrCallersGo plan rest else Nothing
                _ => Nothing
            else
              Nothing
          Nothing => Nothing

-- | 调用方里目标定义的实参（要求整个函数体只引用它一次）。
lsrCallerArgs : LsrPlan -> Ir -> Maybe (List Ir)
lsrCallerArgs plan ir =
  if lsrCountGlobal plan.lsrName ir /= 1 then Nothing else lsrFindCallArgs plan.lsrName ir

lsrFindCallArgs : String -> Ir -> Maybe (List Ir)
lsrFindCallArgs name (ir@(IrApp _ _ _)) =
  let
    flat = Analysis.flattenApp ir
  in case firstOf flat of
    IrGlobal g => if g == name then Just (secondOf flat) else lsrFindChildCall name ir
    _ => lsrFindChildCall name ir
lsrFindCallArgs name ir = lsrFindChildCall name ir

lsrFindChildCall : String -> Ir -> Maybe (List Ir)
lsrFindChildCall name (IrTail x) = lsrFindCallArgs name x
lsrFindChildCall name (IrCtor _ _ _ args) = lsrFindInList name args
lsrFindChildCall name (IrRecord _ _ fields) = lsrFindInFields name fields
lsrFindChildCall name (IrProj base _ _ _) = lsrFindCallArgs name base
lsrFindChildCall name (IrRecUpd base _ fields _) =
  lsrFindEither name (lsrFindCallArgs name base) (lsrFindInFields name fields)
lsrFindChildCall name (IrRtApp _ args) = lsrFindInList name args
lsrFindChildCall name (IrCast _ _ x) = lsrFindCallArgs name x
lsrFindChildCall name (IrLet _ s b) =
  lsrFindEither name (lsrFindCallArgs name s) (lsrFindCallArgs name b)
lsrFindChildCall name (IrLam _ _ b) = lsrFindCallArgs name b
lsrFindChildCall name (IrApp _ f a) =
  lsrFindEither name (lsrFindCallArgs name f) (lsrFindCallArgs name a)
lsrFindChildCall name (IrIf c t e) = lsrFindFirst name [c, t, e]
lsrFindChildCall name (IrCase _ _ s alts) =
  lsrFindEither name (lsrFindCallArgs name s) (lsrFindInAlts name alts)
lsrFindChildCall name (IrNatCase s _ z su c) = lsrFindFirstAlt name s z su c
lsrFindChildCall name (IrConcatMany parts) = lsrFindInList name parts
lsrFindChildCall name (IrEffThunk _ _ _ _ prim) = lsrFindCallArgs name prim
lsrFindChildCall _ _ = Nothing

lsrFindEither : String -> Maybe (List Ir) -> Maybe (List Ir) -> Maybe (List Ir)
lsrFindEither _ (Just a) _ = Just a
lsrFindEither _ Nothing (Just x) = Just x
lsrFindEither _ Nothing Nothing = Nothing

lsrFindFirst : String -> List Ir -> Maybe (List Ir)
lsrFindFirst _ [] = Nothing
lsrFindFirst name (x :: rest) =
  case lsrFindCallArgs name x of
    Just a => Just a
    Nothing => lsrFindFirst name rest

lsrFindFirstAlt : String -> Ir -> Maybe IrAlt -> Maybe IrAlt -> Maybe IrAlt -> Maybe (List Ir)
lsrFindFirstAlt name scrut z su c =
  case lsrFindCallArgs name scrut of
    Just a => Just a
    Nothing =>
      case lsrFindAlt name z of
        Just a => Just a
        Nothing =>
          case lsrFindAlt name su of
            Just a => Just a
            Nothing => lsrFindAlt name c

lsrFindAlt : String -> Maybe IrAlt -> Maybe (List Ir)
lsrFindAlt _ Nothing = Nothing
lsrFindAlt name (Just a) = lsrFindCallArgs name a.irAltBody

lsrFindInList : String -> List Ir -> Maybe (List Ir)
lsrFindInList _ [] = Nothing
lsrFindInList name (x :: rest) =
  case lsrFindCallArgs name x of
    Just a => Just a
    Nothing => lsrFindInList name rest

lsrFindInFields : String -> List (String, Ir) -> Maybe (List Ir)
lsrFindInFields _ [] = Nothing
lsrFindInFields name (p :: rest) =
  case lsrFindCallArgs name (secondOf p) of
    Just a => Just a
    Nothing => lsrFindInFields name rest

lsrFindInAlts : String -> List IrAlt -> Maybe (List Ir)
lsrFindInAlts _ [] = Nothing
lsrFindInAlts name (a :: rest) =
  case lsrFindCallArgs name a.irAltBody of
    Just x => Just x
    Nothing => lsrFindInAlts name rest

lsrApply : LsrPlan -> IrDef -> IrDef
lsrApply _ (d@(IrExternDef _ _ _ _)) = d
lsrApply plan (IrDef name ar deps ty body recOk guard span) =
  if name == plan.lsrName then
    IrDef name ar deps ty (lsrRewriteBody plan body) recOk guard span
  else
    IrDef name ar deps ty (lsrRewriteCaller (lsrFuelOf body) plan body) recOk guard span

lsrFuelOf : Ir -> Int
lsrFuelOf ir = 64 + 8 * irSize ir

lsrRewriteBody : LsrPlan -> Ir -> Ir
lsrRewriteBody plan body = lsrRw (lsrFuelOf body) plan.lsrId plan.lsrK body

lsrRw : Int -> Int -> Int -> Ir -> Ir
lsrRw fuel id k ir =
  if fuel <= 0 then
    ir
  else
    case ir of
      IrRtApp "-" [IrVar b, IrInt c] => if b.irBinderId == id && c == k then IrVar b else IrRtApp "-" (map (\x => lsrRw (fuel - 1) id k x) [IrVar b, IrInt c])
      IrRtApp "bi_le_int" [IrVar b, IrInt 0] => if b.irBinderId == id then IrRtApp "bi_le_int" [IrVar b, IrInt (0 - k)] else IrRtApp "bi_le_int" (map (\x => lsrRw (fuel - 1) id k x) [IrVar b, IrInt 0])
      IrTail x => IrTail (lsrRw (fuel - 1) id k x)
      IrCtor fam ctor ty args => IrCtor fam ctor ty (map (\x => lsrRw (fuel - 1) id k x) args)
      IrRecord fam ty fields => IrRecord fam ty (map (\p => (firstOf p, lsrRw (fuel - 1) id k (secondOf p))) fields)
      IrProj base fam field ty => IrProj (lsrRw (fuel - 1) id k base) fam field ty
      IrRecUpd base fam fields ty => IrRecUpd (lsrRw (fuel - 1) id k base) fam (map (\p => (firstOf p, lsrRw (fuel - 1) id k (secondOf p))) fields) ty
      IrRtApp sym args => IrRtApp sym (map (\x => lsrRw (fuel - 1) id k x) args)
      IrCast a b x => IrCast a b (lsrRw (fuel - 1) id k x)
      IrLet bs s b => IrLet bs (lsrRw (fuel - 1) id k s) (lsrRw (fuel - 1) id k b)
      IrLam bs rt b => IrLam bs rt (lsrRw (fuel - 1) id k b)
      IrApp ty a b => IrApp ty (lsrRw (fuel - 1) id k a) (lsrRw (fuel - 1) id k b)
      IrIf c t e => IrIf (lsrRw (fuel - 1) id k c) (lsrRw (fuel - 1) id k t) (lsrRw (fuel - 1) id k e)
      IrCase ty r s alts => IrCase ty r (lsrRw (fuel - 1) id k s) (map (lsrRwAlt (fuel - 1) id k) alts)
      IrNatCase s fr z su c => IrNatCase (lsrRw (fuel - 1) id k s) fr (lsrRwAltM (fuel - 1) id k z) (lsrRwAltM (fuel - 1) id k su) (lsrRwAltM (fuel - 1) id k c)
      IrConcatMany parts => IrConcatMany (map (\x => lsrRw (fuel - 1) id k x) parts)
      IrEffThunk fam ctor ty ar prim => IrEffThunk fam ctor ty ar (lsrRw (fuel - 1) id k prim)
      _ => ir

lsrRwAlt : Int -> Int -> Int -> IrAlt -> IrAlt
lsrRwAlt fuel id k (IrAlt ctor binders body) = IrAlt ctor binders (lsrRw (fuel - 1) id k body)

lsrRwAltM : Int -> Int -> Int -> Maybe IrAlt -> Maybe IrAlt
lsrRwAltM _ _ _ Nothing = Nothing
lsrRwAltM fuel id k (Just a) = Just (lsrRwAlt (fuel - 1) id k a)

lsrRewriteCaller : Int -> LsrPlan -> Ir -> Ir
lsrRewriteCaller fuel plan ir =
  if fuel <= 0 then
    ir
  else
    case ir of
      IrApp ty f a =>
        let
          flat = Analysis.flattenApp ir
        in case firstOf flat of
          IrGlobal g =>
            if g == plan.lsrName then
              case lsrArgAt plan.lsrIdx (secondOf flat) of
                Just (IrInt n0) => Synthetic.applyAllIr (IrGlobal plan.lsrName) (lsrReplaceAt plan.lsrIdx (IrRtApp "-" [IrInt n0, IrInt plan.lsrK]) (secondOf flat))
                _ => ir
            else
              IrApp ty (lsrRewriteCaller (fuel - 1) plan f) (lsrRewriteCaller (fuel - 1) plan a)
          _ => IrApp ty (lsrRewriteCaller (fuel - 1) plan f) (lsrRewriteCaller (fuel - 1) plan a)
      IrTail x => IrTail (lsrRewriteCaller (fuel - 1) plan x)
      IrCtor fam ctor ty args => IrCtor fam ctor ty (map (\x => lsrRewriteCaller (fuel - 1) plan x) args)
      IrRecord fam ty fields => IrRecord fam ty (map (\p => (firstOf p, lsrRewriteCaller (fuel - 1) plan (secondOf p))) fields)
      IrProj base fam field ty => IrProj (lsrRewriteCaller (fuel - 1) plan base) fam field ty
      IrRecUpd base fam fields ty => IrRecUpd (lsrRewriteCaller (fuel - 1) plan base) fam (map (\p => (firstOf p, lsrRewriteCaller (fuel - 1) plan (secondOf p))) fields) ty
      IrRtApp sym args => IrRtApp sym (map (\x => lsrRewriteCaller (fuel - 1) plan x) args)
      IrCast a b x => IrCast a b (lsrRewriteCaller (fuel - 1) plan x)
      IrLet bs s b => IrLet bs (lsrRewriteCaller (fuel - 1) plan s) (lsrRewriteCaller (fuel - 1) plan b)
      IrLam bs rt b => IrLam bs rt (lsrRewriteCaller (fuel - 1) plan b)
      IrIf c t e => IrIf (lsrRewriteCaller (fuel - 1) plan c) (lsrRewriteCaller (fuel - 1) plan t) (lsrRewriteCaller (fuel - 1) plan e)
      IrCase ty r s alts => IrCase ty r (lsrRewriteCaller (fuel - 1) plan s) (map (lsrCallerAlt (fuel - 1) plan) alts)
      IrNatCase s fr z su c => IrNatCase (lsrRewriteCaller (fuel - 1) plan s) fr (lsrCallerAltM (fuel - 1) plan z) (lsrCallerAltM (fuel - 1) plan su) (lsrCallerAltM (fuel - 1) plan c)
      IrConcatMany parts => IrConcatMany (map (\x => lsrRewriteCaller (fuel - 1) plan x) parts)
      IrEffThunk fam ctor ty ar prim => IrEffThunk fam ctor ty ar (lsrRewriteCaller (fuel - 1) plan prim)
      _ => ir

lsrCallerAlt : Int -> LsrPlan -> IrAlt -> IrAlt
lsrCallerAlt fuel plan (IrAlt ctor binders body) =
  IrAlt ctor binders (lsrRewriteCaller (fuel - 1) plan body)

lsrCallerAltM : Int -> LsrPlan -> Maybe IrAlt -> Maybe IrAlt
lsrCallerAltM _ _ Nothing = Nothing
lsrCallerAltM fuel plan (Just a) = Just (lsrCallerAlt (fuel - 1) plan a)

lsrArgAt : Int -> List Ir -> Maybe Ir
lsrArgAt i args =
  if i <= 0 then
    case args of
      a :: _ => Just a
      [] => Nothing
  else
    case args of
      [] => Nothing
      _ :: rest => lsrArgAt (i - 1) rest

lsrReplaceAt : Int -> Ir -> List Ir -> List Ir
lsrReplaceAt i x args =
  if i <= 0 then
    case args of
      _ :: rest => x :: rest
      [] => [x]
  else
    case args of
      [] => []
      a :: rest => a :: lsrReplaceAt (i - 1) x rest

-- ---------------------------------------------------------------
-- 纯条件化简：消掉内联后重复的守卫
-- ---------------------------------------------------------------
-- `if c then a else if c then b else e` 在 `c` 纯时等价于 `if c then a else e`；
-- `if c then (if c then a else b) else e` 等价于 `if c then a else e`。
-- 只认原子条件（变量 / 整数字面量 / 白名单标量比较），不碰带调用或构造子的条件。
export simplifyDefs : List IrDef -> List IrDef
simplifyDefs = map simplifyDef

simplifyDef : IrDef -> IrDef
simplifyDef (IrExternDef name ty sym span) = IrExternDef name ty sym span
simplifyDef (IrDef nm ar deps ty body recOk guard span) =
  IrDef nm ar deps ty (simplifyIr body) recOk guard span

simplifyIr : Ir -> Ir
simplifyIr (IrTail inner) = IrTail (simplifyTail inner)
simplifyIr (IrLam bs rt inner) = IrLam bs rt (simplifyIr inner)
simplifyIr (IrLet bs scrut body) = IrLet bs (simplifyIr scrut) (simplifyIr body)
simplifyIr (IrCast a b inner) = IrCast a b (simplifyIr inner)
simplifyIr (IrIf c t e) =
  let
    c2 = simplifyIr c
    t2 = simplifyIr t
    e2 = simplifyIr e
  in if pureCond c2 then mergeIf c2 t2 e2 else IrIf c2 t2 e2
simplifyIr (IrCase ty k scrut alts) = IrCase ty k (simplifyIr scrut) (map simplifyAlt alts)
simplifyIr (IrNatCase scrut f z s c) =
  IrNatCase (simplifyIr scrut) f (simplifyAltM z) (simplifyAltM s) (simplifyAltM c)
simplifyIr (IrApp ty f a) = IrApp ty (simplifyIr f) (simplifyIr a)
simplifyIr (IrRtApp "natFromInt" [IrInt n]) = IrInt (if n < 0 then 0 else n)
simplifyIr (IrRtApp "natToInt" [IrInt n]) = IrInt n
simplifyIr (IrRtApp "+" [a, b]) = foldAdd (simplifyIr a) (simplifyIr b)
simplifyIr (IrRtApp "-" [a, b]) = foldSub (simplifyIr a) (simplifyIr b)
simplifyIr (IrRtApp "*" [a, b]) = foldMul (simplifyIr a) (simplifyIr b)
simplifyIr (IrRtApp sym args) = IrRtApp sym (map simplifyIr args)
simplifyIr (IrConcatMany parts) = IrConcatMany (map simplifyIr parts)
simplifyIr ir = ir

-- | 常量折叠加结合：`(x + a) + b -> x + (a+b)`，`(x - a) - b -> x - (a+b)`；
--   字面量对直接算。三者在 63-bit 模语义下等价；用于把尾内联带进来的常量链压成一条。
foldAdd : Ir -> Ir -> Ir
foldAdd (IrRtApp "+" [x, IrInt a]) (IrInt b) = IrRtApp "+" [x, IrInt (a + b)]
foldAdd (IrInt a) (IrInt b) = IrInt (a + b)
foldAdd a b = IrRtApp "+" [a, b]

foldSub : Ir -> Ir -> Ir
foldSub (IrRtApp "-" [x, IrInt a]) (IrInt b) = IrRtApp "-" [x, IrInt (a + b)]
foldSub (IrInt a) (IrInt b) = IrInt (a - b)
foldSub a (IrInt 0) = a
foldSub a b = IrRtApp "-" [a, b]

foldMul : Ir -> Ir -> Ir
foldMul (IrRtApp "*" [x, IrInt a]) (IrInt b) = IrRtApp "*" [x, IrInt (a * b)]
foldMul (IrInt a) (IrInt b) = IrInt (a * b)
foldMul a (IrInt 1) = a
foldMul a b = IrRtApp "*" [a, b]

mergeIf : Ir -> Ir -> Ir -> Ir
mergeIf c t (e@(IrIf c2 _ b)) = if sameCond c c2 then IrIf c t b else mergeThen c t e
mergeIf c t (e@(IrTail (IrIf c2 _ b))) =
  if sameCond c c2 then IrIf c t (IrTail b) else mergeThen c t e
mergeIf c t e = mergeThen c t e

mergeThen : Ir -> Ir -> Ir -> Ir
mergeThen c (t@(IrIf c1 a _)) e = if sameCond c c1 then IrIf c a e else IrIf c t e
mergeThen c (t@(IrTail (IrIf c1 a _))) e = if sameCond c c1 then IrIf c (IrTail a) e else IrIf c t e
mergeThen c t e = IrIf c t e

simplifyTail : Ir -> Ir
simplifyTail ir =
  case simplifyIr ir of
    IrIf c t e => mergeIf c t e
    other => other

simplifyAlt : IrAlt -> IrAlt
simplifyAlt alt = IrAlt alt.irAltCtor alt.irAltBinders (simplifyIr alt.irAltBody)

simplifyAltM : Maybe IrAlt -> Maybe IrAlt
simplifyAltM Nothing = Nothing
simplifyAltM (Just alt) = Just (simplifyAlt alt)

pureCond : Ir -> Bool
pureCond (IrVar _) = True
pureCond (IrInt _) = True
pureCond (IrBool _) = True
pureCond (IrRtApp sym args) = memStr sym scalarArgSyms && not (isDivLike sym) && allPure args
pureCond _ = False

allPure : List Ir -> Bool
allPure [] = True
allPure (a :: rest) = pureCond a && allPure rest

sameCond : Ir -> Ir -> Bool
sameCond (IrVar a) (IrVar b) = sameBinderId a b
sameCond (IrInt a) (IrInt b) = a == b
sameCond (IrBool a) (IrBool b) = a == b
sameCond (IrRtApp s1 [a1, b1]) (IrRtApp s2 [a2, b2]) = s1 == s2 && sameCond a1 a2 && sameCond b1 b2
sameCond (IrRtApp s1 [a1]) (IrRtApp s2 [a2]) = s1 == s2 && sameCond a1 a2
sameCond (IrRtApp s1 []) (IrRtApp s2 []) = s1 == s2
sameCond _ _ = False

-- ---------------------------------------------------------------
-- Float let 消除：把纯 Float 表达式从只使用一次的 `let` 直接代进使用点。
--
-- native 的浮点表达式树（`Module.floatTree`）能跨过算术/`sqrt`/`abs`/`intToFloat`
-- 一路留在 `xmm` 上，但遇到 `let` 会先在绑定处装盒一次，再在树里解引用。把
-- `let step = <float tree> in ... step ...` 代进唯一使用点后，整棵树只装盒一次。
-- 只收可判定为 Float、且求值不产生效应/失败的表达式；同一 binder 在嵌套 lambda
-- 内还有引用时不代（避免把计算搬进可能执行多次的闭包体）。
-- ---------------------------------------------------------------
export inlineFloatLetsDefs : List IrDef -> List IrDef
inlineFloatLetsDefs = map inlineFloatLetsDef

inlineFloatLetsDef : IrDef -> IrDef
inlineFloatLetsDef (IrExternDef name ty sym span) = IrExternDef name ty sym span
inlineFloatLetsDef (IrDef nm ar deps ty body recOk guard span) =
  IrDef nm ar deps ty (floatLetsIr body) recOk guard span

floatLetsIr : Ir -> Ir
floatLetsIr (IrLet [b] scrut body) =
  let
    scrut2 = floatLetsIr scrut
    body2 = floatLetsIr body
    id = b.irBinderId
  in if isTotalFloat scrut2 && usesAny id body2 == 1 && usesOutsideLams id body2 == 1 then
    inlineBody [(id, scrut2)] body2
  else
    IrLet [b] scrut2 body2
floatLetsIr (IrLet bs scrut body) = IrLet bs (floatLetsIr scrut) (floatLetsIr body)
floatLetsIr (IrCtor f c ty args) = IrCtor f c ty (map floatLetsIr args)
floatLetsIr (IrRecord f ty fields) =
  IrRecord f ty (map (\p => (firstOf p, floatLetsIr (secondOf p))) fields)
floatLetsIr (IrProj base f fld ty) = IrProj (floatLetsIr base) f fld ty
floatLetsIr (IrRecUpd base f fields ty) =
  IrRecUpd (floatLetsIr base) f (map (\p => (firstOf p, floatLetsIr (secondOf p))) fields) ty
floatLetsIr (IrRtApp sym args) = IrRtApp sym (map floatLetsIr args)
floatLetsIr (IrCast a b inner) = IrCast a b (floatLetsIr inner)
floatLetsIr (IrLam bs ty inner) = IrLam bs ty (floatLetsIr inner)
floatLetsIr (IrApp ty (IrLam [b] lamTy body) a) =
  let
    a2 = floatLetsIr a
    body2 = floatLetsIr body
    id = b.irBinderId
  in if isTotalFloat a2 && usesAny id body2 == 1 && usesOutsideLams id body2 == 1 then
    Tail.stripTail (inlineBody [(id, a2)] body2)
  else
    IrApp ty (IrLam [b] lamTy body2) a2
floatLetsIr (IrApp ty f a) = IrApp ty (floatLetsIr f) (floatLetsIr a)
floatLetsIr (IrTail inner) = IrTail (floatLetsIr inner)
floatLetsIr (IrIf c t e) = IrIf (floatLetsIr c) (floatLetsIr t) (floatLetsIr e)
floatLetsIr (IrCase ty rt scrut alts) = IrCase ty rt (floatLetsIr scrut) (map floatLetsAlt alts)
floatLetsIr (IrNatCase scrut fresh z s c) =
  IrNatCase (floatLetsIr scrut) fresh (floatLetsAltM z) (floatLetsAltM s) (floatLetsAltM c)
floatLetsIr (IrConcatMany parts) = IrConcatMany (map floatLetsIr parts)
floatLetsIr (IrEffThunk f c ty ar prim) = IrEffThunk f c ty ar (floatLetsIr prim)
floatLetsIr ir = ir

floatLetsAlt : IrAlt -> IrAlt
floatLetsAlt alt = IrAlt alt.irAltCtor alt.irAltBinders (floatLetsIr alt.irAltBody)

floatLetsAltM : Maybe IrAlt -> Maybe IrAlt
floatLetsAltM Nothing = Nothing
floatLetsAltM (Just alt) = Just (floatLetsAlt alt)

isFloatBinder : IrBinder -> Bool
isFloatBinder b =
  case Kinds.irKindOfTy [] b.irBinderTy of
    Kinds.KFloat => True
    _ => False

isIntBinder : IrBinder -> Bool
isIntBinder b =
  case Kinds.irKindOfTy [] b.irBinderTy of
    Kinds.KInt => True
    _ => False

-- | 只接受纯 Float 表达式：变量 / 字面量 / 浮点二元运算 / sqrt / abs / intToFloat。
--   这些运算不分配、不产生效应、不失败，搬动求值位置不改变可观察行为。
isTotalFloat : Ir -> Bool
isTotalFloat (IrVar b) = isFloatBinder b
isTotalFloat (IrFloatLit _) = True
isTotalFloat (IrCast _ _ inner) = isTotalFloat inner
isTotalFloat (IrRtApp sym args) = isTotalFloatApp sym args
isTotalFloat (IrApp _ (IrGlobal name) a) = isTotalFloatGlobal name a
isTotalFloat _ = False

isTotalFloatApp : String -> List Ir -> Bool
isTotalFloatApp sym args =
  if isFloatBinSym sym then
    allTotalFloat args
  else
    case args of
      [a] => isTotalFloatLeaf sym a
      _ => False

isTotalFloatGlobal : String -> Ir -> Bool
isTotalFloatGlobal name a =
  if name == "Base.Data.Float.sqrt" || name == "Base.Data.Float.abs" then
    isTotalFloat a
  else if name == "Base.Data.Float.intToFloat" then isIntAtom a else False

isTotalFloatLeaf : String -> Ir -> Bool
isTotalFloatLeaf sym a =
  if sym == "floatSqrt" || sym == "floatAbs" then
    isTotalFloat a
  else if sym == "floatFromInt" then isIntAtom a else False

allTotalFloat : List Ir -> Bool
allTotalFloat [] = True
allTotalFloat (a :: rest) = isTotalFloat a && allTotalFloat rest

isFloatBinSym : String -> Bool
isFloatBinSym sym =
  sym == "bi_add_float" || sym == "bi_sub_float" || sym == "bi_mul_float" || sym == "bi_div_float"

isIntAtom : Ir -> Bool
isIntAtom (IrVar b) = isIntBinder b
isIntAtom (IrInt _) = True
isIntAtom (IrCast _ _ inner) = isIntAtom inner
isIntAtom _ = False

usesAny : Int -> Ir -> Int
usesAny id (IrVar b) = if b.irBinderId == id then 1 else 0
usesAny id (IrCtor _ _ _ args) = usesAnyList id args
usesAny id (IrRecord _ _ fields) = usesAnyList id (map secondOf fields)
usesAny id (IrProj base _ _ _) = usesAny id base
usesAny id (IrRecUpd base _ fields _) = usesAny id base + usesAnyList id (map secondOf fields)
usesAny id (IrRtApp _ args) = usesAnyList id args
usesAny id (IrCast _ _ inner) = usesAny id inner
usesAny id (IrLet _ scrut body) = usesAny id scrut + usesAny id body
usesAny id (IrLam _ _ body) = usesAny id body
usesAny id (IrApp _ f a) = usesAny id f + usesAny id a
usesAny id (IrTail inner) = usesAny id inner
usesAny id (IrIf c t e) = usesAny id c + usesAny id t + usesAny id e
usesAny id (IrCase _ _ scrut alts) = usesAny id scrut + usesAnyAlts id alts
usesAny id (IrNatCase scrut _ z s c) =
  usesAny id scrut + usesAnyAltM id z + usesAnyAltM id s + usesAnyAltM id c
usesAny id (IrConcatMany parts) = usesAnyList id parts
usesAny id (IrEffThunk _ _ _ _ prim) = usesAny id prim
usesAny id _ = 0

usesAnyList : Int -> List Ir -> Int
usesAnyList id xs = foldl (\acc, x => acc + usesAny id x) 0 xs

usesAnyAlts : Int -> List IrAlt -> Int
usesAnyAlts id xs = foldl (\acc, a => acc + usesAnyAlt id a) 0 xs

usesAnyAlt : Int -> IrAlt -> Int
usesAnyAlt id alt = usesAny id alt.irAltBody

usesAnyAltM : Int -> Maybe IrAlt -> Int
usesAnyAltM _ Nothing = 0
usesAnyAltM id (Just (IrAlt _ _ body)) = usesAny id body

-- | 只统计不在嵌套 lambda 里的引用；嵌套 lambda 内的引用会随闭包调用次数变化，
--   不参与单次 `let` 消除。
usesOutsideLams : Int -> Ir -> Int
usesOutsideLams id (IrVar b) = if b.irBinderId == id then 1 else 0
usesOutsideLams id (IrLam _ _ _) = 0
usesOutsideLams id (IrCtor _ _ _ args) = usesOutsideList id args
usesOutsideLams id (IrRecord _ _ fields) = usesOutsideList id (map secondOf fields)
usesOutsideLams id (IrProj base _ _ _) = usesOutsideLams id base
usesOutsideLams id (IrRecUpd base _ fields _) =
  usesOutsideLams id base + usesOutsideList id (map secondOf fields)
usesOutsideLams id (IrRtApp _ args) = usesOutsideList id args
usesOutsideLams id (IrCast _ _ inner) = usesOutsideLams id inner
usesOutsideLams id (IrLet _ scrut body) = usesOutsideLams id scrut + usesOutsideLams id body
usesOutsideLams id (IrApp _ f a) = usesOutsideLams id f + usesOutsideLams id a
usesOutsideLams id (IrTail inner) = usesOutsideLams id inner
usesOutsideLams id (IrIf c t e) = usesOutsideLams id c + usesOutsideLams id t + usesOutsideLams id e
usesOutsideLams id (IrCase _ _ scrut alts) = usesOutsideLams id scrut + usesOutsideAlts id alts
usesOutsideLams id (IrNatCase scrut _ z s c) =
  usesOutsideLams id scrut + usesOutsideAltM id z + usesOutsideAltM id s + usesOutsideAltM id c
usesOutsideLams id (IrConcatMany parts) = usesOutsideList id parts
usesOutsideLams id (IrEffThunk _ _ _ _ prim) = usesOutsideLams id prim
usesOutsideLams id _ = 0

usesOutsideList : Int -> List Ir -> Int
usesOutsideList id xs = foldl (\acc, x => acc + usesOutsideLams id x) 0 xs

usesOutsideAlts : Int -> List IrAlt -> Int
usesOutsideAlts id xs = foldl (\acc, a => acc + usesOutsideAlt id a) 0 xs

usesOutsideAlt : Int -> IrAlt -> Int
usesOutsideAlt id alt = usesOutsideLams id alt.irAltBody

usesOutsideAltM : Int -> Maybe IrAlt -> Int
usesOutsideAltM _ Nothing = 0
usesOutsideAltM id (Just (IrAlt _ _ body)) = usesOutsideLams id body

-- ---------------------------------------------------------------
-- 尾位置 if 合并（同目标、标量实参差常量）
-- ---------------------------------------------------------------
-- `if c then f (x + a) … else f (x + b) …` 的两个尾调用目标相同、其余实参相同：
-- 合成一次调用，把差异实参写成值选择的 `if c then a else b`。控制流从「两个分支 +
-- 回边」变成一条直线（后续的选择在 `Native.Module` 里落到 `xor` / `add`，不再分支）。
-- ---------------------------------------------------------------
-- 尾位置 if 合并（同目标、标量实参差常量）
-- ---------------------------------------------------------------
-- `if c then f (x + a) … else f (x + b) …` 的两个尾调用目标相同、其余实参相同：
-- 合成一次调用，把差异实参写成值选择 `x + select(c, a, b)`。差异值先用 `let`
-- 绑成变量，累加那一步仍是原子的 `+`（能走内联标量算术，而不是 `call rt_add`）；
-- 选择本身由 `Native.Module` 的 `BoolStep` 落成 `xor` / `add`，不再分支。
-- 条件与实参都只求值一次，合并不改变可观察顺序。
export mergeTailIfs : List IrDef -> List IrDef
mergeTailIfs defs = firstOf (mergeDefsGo defs 0)

mergeDefsGo : List IrDef -> Int -> (List IrDef, Int)
mergeDefsGo [] n = ([], n)
mergeDefsGo (d :: rest) n =
  let
    p = mergeTailDef d n
    q = mergeDefsGo rest (secondOf p)
  in (firstOf p :: firstOf q, secondOf q)

mergeTailDef : IrDef -> Int -> (IrDef, Int)
mergeTailDef (IrExternDef n t s sp) k = (IrExternDef n t s sp, k)
mergeTailDef (IrDef n a deps ty body recOk guard span) k =
  let
    p = mergeTailIr body k
  in (IrDef n a deps ty (firstOf p) recOk guard span, secondOf p)

mergeTailIr : Ir -> Int -> (Ir, Int)
mergeTailIr (IrLam bs rt inner) k =
  let
    p = mergeTailIr inner k
  in (IrLam bs rt (firstOf p), secondOf p)
mergeTailIr (IrTail inner) k =
  let
    p = mergeTailIr inner k
  in (IrTail (firstOf p), secondOf p)
mergeTailIr (IrIf c t e) k =
  case tryMergeTail c t e k of
    Just p => p
    Nothing =>
      let
        p = mergeTailIr t k
        q = mergeTailIr e (secondOf p)
      in (IrIf c (firstOf p) (firstOf q), secondOf q)
mergeTailIr ir k = (ir, k)

tryMergeTail : Ir -> Ir -> Ir -> Int -> Maybe (Ir, Int)
tryMergeTail c (IrTail t) (IrTail e) k =
  case Analysis.flattenApp t of
    (IrGlobal g1, a1) =>
      case Analysis.flattenApp e of
        (IrGlobal g2, a2) =>
          if g1 == g2 && length a1 == length a2 then
            case mergeArgs c a1 a2 Nothing k of
              Just p =>
                let
                  call = Synthetic.applyAllIr (IrGlobal g1) (firstOf p)
                in case firstOf (secondOf p) of
                  Nothing => Just (IrTail call, secondOf (secondOf p))
                  Just b => Just (IrLet [firstOf b] (secondOf b) (IrTail call), secondOf (secondOf p))
              Nothing => Nothing
          else
            Nothing
        _ => Nothing
    _ => Nothing
tryMergeTail _ _ _ _ = Nothing

mergeArgs : Ir -> List Ir -> List Ir -> Maybe (IrBinder, Ir) -> Int -> Maybe (List Ir, Maybe (IrBinder, Ir), Int)
mergeArgs c xs ys bind k = mergeArgsGo c xs ys bind [] k

mergeArgsGo : Ir -> List Ir -> List Ir -> Maybe (IrBinder, Ir) -> List Ir -> Int -> Maybe (List Ir, Maybe (IrBinder, Ir), Int)
mergeArgsGo _ [] [] bind acc k = Just (reverse acc, bind, k)
mergeArgsGo c (a :: moreA) (b :: moreB) bind acc k =
  if sameArg a b then
    mergeArgsGo c moreA moreB bind (a :: acc) k
  else
    case bind of
      Just _ => Nothing
      Nothing =>
        case factorArg c a b k of
          Just p => mergeArgsGo c moreA moreB (Just (firstOf p)) (firstOf (secondOf p) :: acc) (secondOf (secondOf p))
          Nothing => Nothing
mergeArgsGo _ _ _ _ _ _ = Nothing

-- | 差异实参：`x op a` vs `x op b`（op ∈ {+,-}），生成 `x op sel` 与 `sel` 的绑定。
factorArg : Ir -> Ir -> Ir -> Int -> Maybe ((IrBinder, Ir), Ir, Int)
factorArg c (IrRtApp op [x, IrInt ka]) (IrRtApp op2 [y, IrInt kb]) k =
  if op == op2 && (op == "+" || op == "-") && sameArg x y then
    let
      sel = IrBinder (Synthetic.backendBinderId (700 + k)) (IrBUser "sel") False (Just IrTyInt)
    in Just ((sel, IrIf c (IrInt ka) (IrInt kb)), IrRtApp op [x, IrVar sel], k + 1)
  else
    Nothing
factorArg _ _ _ _ = Nothing

sameArg : Ir -> Ir -> Bool
sameArg (IrVar a) (IrVar b) = a.irBinderId == b.irBinderId
sameArg (IrInt a) (IrInt b) = a == b
sameArg (IrBool a) (IrBool b) = a == b
sameArg (IrStr a) (IrStr b) = a == b
sameArg (IrFloatLit a) (IrFloatLit b) = a == b
sameArg (IrRt a) (IrRt b) = a == b
sameArg (IrGlobal a) (IrGlobal b) = a == b
sameArg (IrRtApp s1 a1) (IrRtApp s2 a2) = s1 == s2 && sameArgs a1 a2
sameArg (IrCast _ _ a) (IrCast _ _ b) = sameArg a b
sameArg (IrIf c1 t1 e1) (IrIf c2 t2 e2) = sameArg c1 c2 && sameArg t1 t2 && sameArg e1 e2
sameArg _ _ = False

sameArgs : List Ir -> List Ir -> Bool
sameArgs [] [] = True
sameArgs (a :: moreA) (b :: moreB) = sameArg a b && sameArgs moreA moreB
sameArgs _ _ = False

-- ---------------------------------------------------------------
-- let 外提（内联/β 归约留下的 let 回到语句位置）
-- ---------------------------------------------------------------
-- | 把严格上下文（应用实参 / 构造子字段）里的 `let` 提出来：`acc + (let x = K in b)`
--   变成 `let x = K in acc + b`，标量选择才能继续内联。不跨 `if` / `case` 分支与
--   lambda 提（那些位置不一定求值）。
export floatDefs : List IrDef -> List IrDef
floatDefs defs = map floatDef defs

floatDef : IrDef -> IrDef
floatDef (IrExternDef name ty sym span) = IrExternDef name ty sym span
floatDef (IrDef nm ar deps ty body recOk guard span) =
  IrDef nm ar deps ty (floatIr body) recOk guard span

floatIr : Ir -> Ir
floatIr (IrApp ty f a) = floatApp ty (floatIr f) (floatIr a)
floatIr (IrRtApp sym args) = floatRtApp sym (map floatIr args)
floatIr (IrLet bs scrut body) = IrLet bs (floatIr scrut) (floatIr body)
floatIr (IrIf c t e) = IrIf (floatIr c) (floatIr t) (floatIr e)
floatIr (IrCase ty k scrut alts) = IrCase ty k (floatIr scrut) (map floatAlt alts)
floatIr (IrNatCase scrut f z s c) =
  IrNatCase (floatIr scrut) f (floatAltM z) (floatAltM s) (floatAltM c)
floatIr (IrCtor fam ctor ty args) = floatCtor fam ctor ty (floatArgsLift args)
floatIr (IrRecord fam ty fields) = floatRecord fam ty (floatFieldsLift fields)
floatIr (IrProj base fam field ty) = IrProj (floatIr base) fam field ty
floatIr (IrRecUpd base fam fields ty) =
  IrRecUpd (floatIr base) fam (firstOf (floatFieldsLift fields)) ty
floatIr (IrCast from to inner) = IrCast from to (floatIr inner)
floatIr (IrTail inner) = IrTail (floatIr inner)
floatIr (IrConcatMany parts) = floatArgsConcat (floatArgsLift parts)
floatIr (IrLam bs rt body) = IrLam bs rt (floatIr body)
floatIr ir = ir

floatApp : Maybe (IrTy, IrTy) -> Ir -> Ir -> Ir
floatApp ty (IrLet bs scrut body) a = IrLet bs scrut (floatIr (IrApp ty body a))
floatApp ty f (IrLet bs scrut body) = IrLet bs scrut (floatIr (IrApp ty f body))
floatApp ty f a = IrApp ty f a

floatAlt : IrAlt -> IrAlt
floatAlt alt = IrAlt alt.irAltCtor alt.irAltBinders (floatIr alt.irAltBody)

floatAltM : Maybe IrAlt -> Maybe IrAlt
floatAltM Nothing = Nothing
floatAltM (Just alt) = Just (floatAlt alt)

floatRtApp : String -> List Ir -> Ir
floatRtApp sym args = floatRtGo (irSizeList args + 1) sym args

floatRtGo : Int -> String -> List Ir -> Ir
floatRtGo fuel sym args =
  if fuel <= 0 then
    IrRtApp sym args
  else
    case firstLetArg args of
      Just (bs, scrut, args2) => IrLet bs scrut (floatRtGo (fuel - 1) sym args2)
      Nothing => IrRtApp sym args

firstLetArg : List Ir -> Maybe (List IrBinder, Ir, List Ir)
firstLetArg [] = Nothing
firstLetArg (a :: rest) =
  case a of
    IrLet bs scrut body => Just (bs, scrut, body :: rest)
    _ =>
      case firstLetArg rest of
        Just (bs, scrut, rest2) => Just (bs, scrut, a :: rest2)
        Nothing => Nothing

floatArgsLift : List Ir -> (List Ir, List (List IrBinder, Ir))
floatArgsLift xs = floatArgsGo xs []

floatArgsGo : List Ir -> List (List IrBinder, Ir) -> (List Ir, List (List IrBinder, Ir))
floatArgsGo [] lets = ([], lets)
floatArgsGo (x :: rest) lets =
  case x of
    IrLet bs scrut body =>
      let
        p = floatArgsGo rest ((bs, scrut) :: lets)
      in (body :: firstOf p, secondOf p)
    _ =>
      let
        p = floatArgsGo rest lets
      in (x :: firstOf p, secondOf p)

wrapLetsIr : List (List IrBinder, Ir) -> Ir -> Ir
wrapLetsIr [] ir = ir
wrapLetsIr (p :: rest) ir = IrLet (firstOf p) (secondOf p) (wrapLetsIr rest ir)

floatCtor : String -> String -> Maybe (List IrTy) -> (List Ir, List (List IrBinder, Ir)) -> Ir
floatCtor fam ctor ty p = wrapLetsIr (secondOf p) (IrCtor fam ctor ty (firstOf p))

floatRecord : String -> Maybe IrTy -> (List (String, Ir), List (List IrBinder, Ir)) -> Ir
floatRecord fam ty p = wrapLetsIr (secondOf p) (IrRecord fam ty (firstOf p))

floatArgsConcat : (List Ir, List (List IrBinder, Ir)) -> Ir
floatArgsConcat p = wrapLetsIr (secondOf p) (IrConcatMany (firstOf p))

floatFieldsLift : List (String, Ir) -> (List (String, Ir), List (List IrBinder, Ir))
floatFieldsLift fields = floatFieldsGo fields []

floatFieldsGo : List (String, Ir) -> List (List IrBinder, Ir) -> (List (String, Ir), List (List IrBinder, Ir))
floatFieldsGo [] lets = ([], lets)
floatFieldsGo (p :: rest) lets =
  case secondOf p of
    IrLet bs scrut body =>
      let
        q = floatFieldsGo rest ((bs, scrut) :: lets)
      in ((firstOf p, body) :: firstOf q, secondOf q)
    _ =>
      let
        q = floatFieldsGo rest lets
      in ((firstOf p, secondOf p) :: firstOf q, secondOf q)

-- ---------------------------------------------------------------
-- 循环体内的标量公共子表达式消除
-- ---------------------------------------------------------------
-- | 同一次迭代里出现多次的纯标量树只算一次：在体首绑一条 `let`，把重复子树换成
--   变量。只收自由变量全在函数形参里、大小 ≥ 5 且可重复求值的表达式；体太大时
--   整条跳过（线性计数的最坏代价按体规模放大）。
binderIds : List IrBinder -> List Int
binderIds [] = []
binderIds (b :: rest) = b.irBinderId :: binderIds rest

export cseDefs : List IrDef -> List IrDef
cseDefs defs = map cseDef defs

cseDef : IrDef -> IrDef
cseDef (IrExternDef name ty sym span) = IrExternDef name ty sym span
cseDef (IrDef nm ar deps ty body recOk guard span) =
  let
    body1 =
      case body of
        IrLam bs rt inner =>
          if irSize inner > 512 then
            body
          else
            case findCse (binderIds bs) inner inner of
              Just (key, expr) =>
                let
                  b = IrBinder (Synthetic.backendBinderId 500) (IrBUser "__cse") False Nothing
                in IrLam bs rt (IrLet [b] expr (replaceCse key b inner))
              Nothing => body
        _ => body
  in IrDef nm ar deps ty body1 recOk guard span

findCse : List Int -> Ir -> Ir -> Maybe (String, Ir)
findCse params whole (ir@(IrRtApp _ _)) =
  case cseKey params ir of
    Just key => if countCse key whole >= 2 then Just (key, ir) else Nothing
    Nothing => Nothing
findCse params whole (IrLam _ _ body) = findCse params whole body
findCse params whole (IrLet _ scrut body) =
  case findCse params whole scrut of
    Just hit => Just hit
    Nothing => findCse params whole body
findCse params whole (IrApp _ f a) =
  case findCse params whole f of
    Just hit => Just hit
    Nothing => findCse params whole a
findCse params whole (IrIf c t e) =
  case findCse params whole c of
    Just hit => Just hit
    Nothing =>
      case findCse params whole t of
        Just hit => Just hit
        Nothing => findCse params whole e
findCse params whole (IrCase _ _ scrut alts) = findCseAlts params whole scrut alts
findCse params whole (IrNatCase scrut _ z s c) =
  case findCse params whole scrut of
    Just hit => Just hit
    Nothing =>
      case findCseAltM params whole z of
        Just hit => Just hit
        Nothing =>
          case findCseAltM params whole s of
            Just hit => Just hit
            Nothing => findCseAltM params whole c
findCse params whole (IrCtor _ _ _ args) = findCseList params whole args
findCse params whole (IrRecord _ _ fields) = findCseFields params whole fields
findCse params whole (IrProj base _ _ _) = findCse params whole base
findCse params whole (IrRecUpd base _ fields _) =
  case findCse params whole base of
    Just hit => Just hit
    Nothing => findCseFields params whole fields
findCse params whole (IrCast _ _ inner) = findCse params whole inner
findCse params whole (IrTail inner) = findCse params whole inner
findCse params whole (IrConcatMany parts) = findCseList params whole parts
findCse params whole (IrEffThunk _ _ _ _ prim) = findCse params whole prim
findCse _ _ _ = Nothing

findCseList : List Int -> Ir -> List Ir -> Maybe (String, Ir)
findCseList _ _ [] = Nothing
findCseList params whole (x :: rest) =
  case findCse params whole x of
    Just hit => Just hit
    Nothing => findCseList params whole rest

findCseFields : List Int -> Ir -> List (String, Ir) -> Maybe (String, Ir)
findCseFields _ _ [] = Nothing
findCseFields params whole (p :: rest) =
  case findCse params whole (secondOf p) of
    Just hit => Just hit
    Nothing => findCseFields params whole rest

findCseAlts : List Int -> Ir -> Ir -> List IrAlt -> Maybe (String, Ir)
findCseAlts params whole scrut alts =
  case findCse params whole scrut of
    Just hit => Just hit
    Nothing => findCseAltsGo params whole alts

findCseAltsGo : List Int -> Ir -> List IrAlt -> Maybe (String, Ir)
findCseAltsGo _ _ [] = Nothing
findCseAltsGo params whole (a :: rest) =
  case findCse params whole a.irAltBody of
    Just hit => Just hit
    Nothing => findCseAltsGo params whole rest

findCseAltM : List Int -> Ir -> Maybe IrAlt -> Maybe (String, Ir)
findCseAltM _ _ Nothing = Nothing
findCseAltM params whole (Just a) = findCse params whole a.irAltBody

-- | 候选键：只收自由变量都在函数形参里、可重复求值、大小 ≥ 5 的标量树。
cseKey : List Int -> Ir -> Maybe String
cseKey params ir =
  if irSize ir >= 5 && allVarsIn params ir && totalScalar ir then exprKey ir else Nothing

allVarsIn : List Int -> Ir -> Bool
allVarsIn params (IrVar b) = memInt b.irBinderId params
allVarsIn _ (IrInt _) = True
allVarsIn _ (IrBool _) = True
allVarsIn _ (IrFloatLit _) = True
allVarsIn _ (IrStr _) = True
allVarsIn params (IrRtApp _ args) = allVarsInList params args
allVarsIn params (IrCast _ _ inner) = allVarsIn params inner
allVarsIn _ _ = False

allVarsInList : List Int -> List Ir -> Bool
allVarsInList _ [] = True
allVarsInList params (x :: rest) = if allVarsIn params x then allVarsInList params rest else False

totalScalar : Ir -> Bool
totalScalar (IrRtApp sym args) =
  if isDivLike sym then
    divisorSafe args && allTotal args
  else
    memStr sym scalarArgSyms && allTotal args
totalScalar (IrCast _ _ inner) = totalScalar inner
totalScalar _ = False

allTotal : List Ir -> Bool
allTotal [] = True
allTotal (x :: rest) = if totalScalar x || isLit x then allTotal rest else False

isLit : Ir -> Bool
isLit (IrInt _) = True
isLit (IrBool _) = True
isLit (IrVar _) = True
isLit _ = False

altBodiesOf : List IrAlt -> List Ir
altBodiesOf [] = []
altBodiesOf (a :: rest) = a.irAltBody :: altBodiesOf rest

fieldExprs : List (String, Ir) -> List Ir
fieldExprs [] = []
fieldExprs (p :: rest) = secondOf p :: fieldExprs rest

replaceFieldsCse : String -> IrBinder -> List (String, Ir) -> List (String, Ir)
replaceFieldsCse _ _ [] = []
replaceFieldsCse key b (p :: rest) =
  (firstOf p, replaceCse key b (secondOf p)) :: replaceFieldsCse key b rest

-- | 结构键（只覆盖标量树：变量 / 字面量 / 白名单运行时叶子）。
exprKey : Ir -> Maybe String
exprKey (IrVar b) = Just ("v" ++ strFromInt b.irBinderId)
exprKey (IrInt n) = Just ("i" ++ strFromInt n)
exprKey (IrBool b) = Just (if b then "b1" else "b0")
exprKey (IrRtApp sym args) =
  case allKeys args of
    Just ks => Just ("o" ++ sym ++ "(" ++ join "," ks ++ ")")
    Nothing => Nothing
exprKey _ = Nothing

allKeys : List Ir -> Maybe (List String)
allKeys [] = Just []
allKeys (x :: rest) =
  case exprKey x of
    Just k =>
      case allKeys rest of
        Just ks => Just (k :: ks)
        Nothing => Nothing
    Nothing => Nothing

countCse : String -> Ir -> Int
countCse key (ir@(IrRtApp _ _)) =
  (if exprKey ir == Just key then 1 else 0) + sumCount key (childrenOf ir)
countCse key ir = sumCount key (childrenOf ir)

sumCount : String -> List Ir -> Int
sumCount _ [] = 0
sumCount key (x :: rest) = countCse key x + sumCount key rest

childrenOf : Ir -> List Ir
childrenOf (IrLam _ _ body) = [body]
childrenOf (IrLet _ scrut body) = [scrut, body]
childrenOf (IrApp _ f a) = [f, a]
childrenOf (IrIf c t e) = [c, t, e]
childrenOf (IrCase _ _ scrut alts) = scrut :: altBodiesOf alts
childrenOf (IrNatCase scrut _ z s c) = scrut :: altBodies [z, s, c]
childrenOf (IrCtor _ _ _ args) = args
childrenOf (IrRecord _ _ fields) = fieldExprs fields
childrenOf (IrProj base _ _ _) = [base]
childrenOf (IrRecUpd base _ fields _) = base :: fieldExprs fields
childrenOf (IrRtApp _ args) = args
childrenOf (IrCast _ _ inner) = [inner]
childrenOf (IrTail inner) = [inner]
childrenOf (IrConcatMany parts) = parts
childrenOf (IrEffThunk _ _ _ _ prim) = [prim]
childrenOf _ = []

altBodies : List (Maybe IrAlt) -> List Ir
altBodies [] = []
altBodies (Nothing :: rest) = altBodies rest
altBodies ((Just a) :: rest) = a.irAltBody :: altBodies rest

replaceCse : String -> IrBinder -> Ir -> Ir
replaceCse key b (ir@(IrRtApp sym args)) =
  if exprKey ir == Just key then IrVar b else IrRtApp sym (map (replaceCse key b) args)
replaceCse key b (IrLam bs rt body) = IrLam bs rt (replaceCse key b body)
replaceCse key b (IrLet bs scrut body) = IrLet bs (replaceCse key b scrut) (replaceCse key b body)
replaceCse key b (IrApp ty f a) = IrApp ty (replaceCse key b f) (replaceCse key b a)
replaceCse key b (IrIf c t e) = IrIf (replaceCse key b c) (replaceCse key b t) (replaceCse key b e)
replaceCse key b (IrCase ty k scrut alts) =
  IrCase ty k (replaceCse key b scrut) (map (replaceAltCse key b) alts)
replaceCse key b (IrNatCase scrut f z s c) =
  IrNatCase
    (replaceCse key b scrut)
    f
    (replaceAltMCse key b z)
    (replaceAltMCse key b s)
    (replaceAltMCse key b c)
replaceCse key b (IrCtor fam ctor ty args) = IrCtor fam ctor ty (map (replaceCse key b) args)
replaceCse key b (IrRecord fam ty fields) = IrRecord fam ty (replaceFieldsCse key b fields)
replaceCse key b (IrProj base fam field ty) = IrProj (replaceCse key b base) fam field ty
replaceCse key b (IrRecUpd base fam fields ty) =
  IrRecUpd (replaceCse key b base) fam (replaceFieldsCse key b fields) ty
replaceCse key b (IrCast from to inner) = IrCast from to (replaceCse key b inner)
replaceCse key b (IrTail inner) = IrTail (replaceCse key b inner)
replaceCse key b (IrConcatMany parts) = IrConcatMany (map (replaceCse key b) parts)
replaceCse key b (IrEffThunk fam ctor ty arity prim) =
  IrEffThunk fam ctor ty arity (replaceCse key b prim)
replaceCse _ _ ir = ir

replaceAltCse : String -> IrBinder -> IrAlt -> IrAlt
replaceAltCse key b alt = IrAlt alt.irAltCtor alt.irAltBinders (replaceCse key b alt.irAltBody)

replaceAltMCse : String -> IrBinder -> Maybe IrAlt -> Maybe IrAlt
replaceAltMCse _ _ Nothing = Nothing
replaceAltMCse key b (Just alt) = Just (replaceAltCse key b alt)
