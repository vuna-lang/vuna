module Vuna.Target.Native.Repr where

-- 槽与值的运行时 kind 统计（只读分析，不生成代码）。
--
-- 精确栈图与「按 kind 定向清零」都要先知道三件事：这条槽/值是不是堆指针、
-- 是不是只读指针（`.rodata` 静态闭包）、还是未装箱标量。本模块把 binder 与值位置
-- 归到 `Ptr` / `Static` / `Scalar` / `Unknown`，并把 `Unknown` 的来源分开统计
-- （类型变量、`IrTyOpaque`、缺类型、未分类的运行时符号），作为换根集模型的决策输入。
--
-- 分类先读 binder 自带的类型槽；`Nothing` 时按绑定点的值 kind 推断（`let` 的
-- scrutinee、`case` 分支 binder 的构造子字段类型、Nat 分支的标量），因此 CPS 合成的
-- 无类型 binder 能从它的定义值拿到 kind。声明的类型永远优先于推断。
--
-- `IrTyFloat` 是堆上 leaf 对象，因此按 `Ptr` 计；`.rodata` 静态闭包按 `Static` 计。
--
-- 边界：只 import Base 与 `Ir.Model`；不 import 编译器阶段，也不参与 codegen。
import Base.Data.Bool as Bool
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Maybe as Maybe
import Base.Data.Pair as Pair
import Base.Data.String as String
import Vuna.Ir.Model

-- ---------------------------------------------------------------
-- 分类
-- ---------------------------------------------------------------
-- | 一个槽/值的运行时 kind。
export data NKind(..) : Type where
  -- | 堆指针（String / Float / Array / IORef / data / record / 闭包）。
  NKindPtr : NKind
  -- | 只读指针（`.rodata` 静态闭包），GC 不需要扫描或清零。
  NKindStatic : NKind
  -- | 未装箱标量（Int / Nat / Bool）。
  NKindScalar : NKind
  -- | 无法判定。
  NKindUnknown : NKind

-- | 分类结果：三个确定 kind + 四类 `Unknown` 来源。
export data NCls(..) : Type where
  NClsPtr : NCls
  NClsStatic : NCls
  NClsScalar : NCls
  -- | 类型相关：类型参数槽，或结果类型随实参/元素而定的运行时符号。
  NClsVar : NCls
  -- | `IrTyOpaque`（擦除后无法命名的值）。
  NClsOpaque : NCls
  -- | 类型槽缺失且绑定点的 kind 也推不出来。
  NClsMissing : NCls
  -- | 运行时符号没有归类的 kind。
  NClsSymbol : NCls

export nClsText : NCls -> String
nClsText NClsPtr = "ptr"
nClsText NClsStatic = "static"
nClsText NClsScalar = "scalar"
nClsText NClsVar = "unknown:var"
nClsText NClsOpaque = "unknown:opaque"
nClsText NClsMissing = "unknown:missing"
nClsText NClsSymbol = "unknown:symbol"

-- ---------------------------------------------------------------
-- 计数
-- ---------------------------------------------------------------
export record NCounts(..) where
  ncPtr : Int
  ncStatic : Int
  ncScalar : Int
  ncVar : Int
  ncOpaque : Int
  ncMissing : Int
  ncSymbol : Int

nZeroCounts : NCounts
nZeroCounts = NCounts 0 0 0 0 0 0 0

nAddCounts : NCounts -> NCounts -> NCounts
nAddCounts a b =
  NCounts
    (a.ncPtr + b.ncPtr)
    (a.ncStatic + b.ncStatic)
    (a.ncScalar + b.ncScalar)
    (a.ncVar + b.ncVar)
    (a.ncOpaque + b.ncOpaque)
    (a.ncMissing + b.ncMissing)
    (a.ncSymbol + b.ncSymbol)

nBump : NCls -> NCounts -> NCounts
nBump cls c =
  case cls of
    NClsPtr => { c | ncPtr = c.ncPtr + 1 }
    NClsStatic => { c | ncStatic = c.ncStatic + 1 }
    NClsScalar => { c | ncScalar = c.ncScalar + 1 }
    NClsVar => { c | ncVar = c.ncVar + 1 }
    NClsOpaque => { c | ncOpaque = c.ncOpaque + 1 }
    NClsMissing => { c | ncMissing = c.ncMissing + 1 }
    NClsSymbol => { c | ncSymbol = c.ncSymbol + 1 }

nTotal : NCounts -> Int
nTotal c = c.ncPtr + c.ncStatic + c.ncScalar + c.ncVar + c.ncOpaque + c.ncMissing + c.ncSymbol

nUnknown : NCounts -> Int
nUnknown c = c.ncVar + c.ncOpaque + c.ncMissing + c.ncSymbol

-- | 需要清零的槽：堆指针 + 所有未知（`.rodata` 静态指针不清）。
nNeedClear : NCounts -> Int
nNeedClear c = c.ncPtr + nUnknown c

nPct : Int -> Int -> Int
nPct n d = if d <= 0 then 0 else (100 * n) / d

export nCountsText : NCounts -> String
nCountsText c =
  "total="
    ++ strFromInt (nTotal c)
    ++ " ptr="
    ++ strFromInt c.ncPtr
    ++ " static="
    ++ strFromInt c.ncStatic
    ++ " scalar="
    ++ strFromInt c.ncScalar
    ++ " unknown="
    ++ strFromInt (nUnknown c)
    ++ " (var="
    ++ strFromInt c.ncVar
    ++ " opaque="
    ++ strFromInt c.ncOpaque
    ++ " missing="
    ++ strFromInt c.ncMissing
    ++ " symbol="
    ++ strFromInt c.ncSymbol
    ++ ")" ++ " need-clear=" ++ strFromInt (nPct (nNeedClear c) (nTotal c)) ++ "%"

-- ---------------------------------------------------------------
-- 类型 → kind
-- ---------------------------------------------------------------
nDeclOf : String -> List IrTyDecl -> Maybe IrTyDecl
nDeclOf _ [] = Nothing
nDeclOf name (d :: rest) = if nDeclNameOf d == name then Just d else nDeclOf name rest

nDeclNameOf : IrTyDecl -> String
nDeclNameOf (IrVariantDecl fam _ _) = fam
nDeclNameOf (IrRecordDecl fam _ _ _) = fam
nDeclNameOf (IrUnboxedDecl fam _ _) = fam

-- | 运行时类型 → 分类。`Nothing`（未记录）与走不到的深类型都落 `unknown:missing`。
export nKindOfTy : List IrTyDecl -> Maybe IrTy -> NCls
nKindOfTy decls mty = nKindOfTyFuel 64 decls mty

nKindOfTyFuel : Int -> List IrTyDecl -> Maybe IrTy -> NCls
nKindOfTyFuel fuel decls mty =
  if fuel <= 0 then
    NClsMissing
  else
    case mty of
      Nothing => NClsMissing
      Just ty => nKindOfTyGo (fuel - 1) decls ty

nKindOfTyGo : Int -> List IrTyDecl -> IrTy -> NCls
nKindOfTyGo fuel decls ty =
  if fuel <= 0 then
    NClsMissing
  else
    case ty of
      IrTyInt => NClsScalar
      IrTyBool => NClsScalar
      IrTyStr => NClsPtr
      IrTyFloat => NClsPtr
      IrTyArray _ => NClsPtr
      IrTyRef _ => NClsPtr
      IrTyFun _ _ => NClsPtr
      IrTyVar _ => NClsVar
      IrTyOpaque => NClsOpaque
      IrTyData fam args =>
        case nDeclOf fam decls of
          Just (IrUnboxedDecl _ _ fieldTy) => nKindOfTyGo (fuel - 1) decls (irTySubstVars args fieldTy)
          _ => NClsPtr

-- ---------------------------------------------------------------
-- 运行时符号 → kind
-- ---------------------------------------------------------------
-- 只覆盖契约里结果 kind 明确的符号；其余记 `unknown:symbol`——这张表正是
-- `IrRtSym` 缺少的表示契约字段。
export nRtCls : String -> NCls
nRtCls sym =
  if nRtScalar sym then
    NClsScalar
  else if nRtPtr sym then NClsPtr else if nRtUnknown sym then NClsVar else NClsSymbol

nRtScalar : String -> Bool
nRtScalar sym =
  case sym of
    "+" => True
    "-" => True
    "*" => True
    "/" => True
    "&&" => True
    "||" => True
    "bitAnd" => True
    "bitOr" => True
    "bitXor" => True
    "bitNot" => True
    "bitShl" => True
    "bitShr" => True
    "assert" => True
    "bi_eq_int" => True
    "bi_neq_int" => True
    "bi_lt_int" => True
    "bi_le_int" => True
    "bi_gt_int" => True
    "bi_ge_int" => True
    "bi_eq_str" => True
    "bi_neq_str" => True
    "bi_lt_str" => True
    "bi_le_str" => True
    "bi_gt_str" => True
    "bi_ge_str" => True
    "bi_lt_bool" => True
    "bi_le_bool" => True
    "bi_gt_bool" => True
    "bi_ge_bool" => True
    "bi_eq_float" => True
    "bi_neq_float" => True
    "bi_lt_float" => True
    "bi_le_float" => True
    "bi_gt_float" => True
    "bi_ge_float" => True
    "natAdd" => True
    "natSub" => True
    "natMul" => True
    "natDiv" => True
    "natToInt" => True
    "natFromInt" => True
    "@ir@natSucc" => True
    "strLength" => True
    "strAt" => True
    "strHash" => True
    "effectId" => True
    "effTimeUs" => True
    "effTimeUs_host" => True
    "intFromFloat" => True
    "arrayLength" => True
    "prim_eff_print" => True
    "prim_eff_eprint" => True
    "prim_eff_exit" => True
    "prim_eff_sleep" => True
    "prim_eff_writeRef" => True
    "prim_eff_fileMtime" => True
    "prim_eff_fileSize" => True
    "prim_eff_isDirectory" => True
    "prim_eff_fileExists" => True
    "prim_eff_runIn" => True
    "prim_eff_spawn" => True
    "prim_eff_wait" => True
    "@vuna@debug@on" => True
    "@vuna@debug@line" => True
    "@vuna@obs@level" => True
    "@vuna@obs@log" => True
    "@vuna@obs@counter" => True
    "@vuna@obs@mark" => True
    "@vuna@obs@spanBegin" => True
    "@vuna@obs@spanEnd" => True
    "@vuna@obs@sampleStart" => True
    "@vuna@obs@sampleStop" => True
    _ => False

nRtPtr : String -> Bool
nRtPtr sym =
  case sym of
    "++" => True
    "strFromInt" => True
    "strFromFloat" => True
    "strSubstring" => True
    "strShow" => True
    "strConcatMany" => True
    "strPack" => True
    "strSubstTemplate" => True
    "strUnpack" => True
    "@ir@showBool" => True
    "@ir@showFloat" => True
    "arrayEmpty" => True
    "arrayMake" => True
    "arraySet" => True
    "arrayFromList" => True
    "arrayToList" => True
    "floatFromInt" => True
    "floatAbs" => True
    "floatSqrt" => True
    "bi_add_float" => True
    "bi_sub_float" => True
    "bi_mul_float" => True
    "bi_div_float" => True
    "prim_eff_newRef" => True
    "prim_eff_getenv" => True
    "prim_eff_getcwd" => True
    "prim_eff_execPath" => True
    "prim_eff_getArgs" => True
    "prim_eff_readFile" => True
    "prim_eff_readFileRange" => True
    "prim_eff_readDir" => True
    "prim_eff_readLine" => True
    "prim_eff_readBytes" => True
    "@vuna@host@getenv" => True
    "@vuna@host@getcwd" => True
    "@vuna@host@execPath" => True
    "@vuna@host@getArgs" => True
    "@vuna@host@readDir" => True
    "@vuna@host@readFile" => True
    "@vuna@host@readFileRange" => True
    "@vuna@host@readLine" => True
    "@vuna@host@readBytes" => True
    "@ir@m@runEff" => True
    _ => False

-- 结果取决于实参/元素类型的符号：归到「类型层面本就不可判定」。
nRtUnknown : String -> Bool
nRtUnknown sym =
  case sym of
    "prim_erase" => True
    "@vuna@prim@toObj" => True
    "@vuna@prim@fromObj" => True
    "arrayGet" => True
    "prim_eff_readRef" => True
    "@vuna@prim@readRef" => True
    "@vuna@prim@readRef_host" => True
    "@vuna@obs@span" => True
    "@vuna@obs@spanLab" => True
    _ => False

-- ---------------------------------------------------------------
-- 绑定环境（推断）
-- ---------------------------------------------------------------
nBNameEq : IrBName -> IrBName -> Bool
nBNameEq (IrBUser x) (IrBUser y) = x == y
nBNameEq (IrBArm x) (IrBArm y) = x == y
nBNameEq (IrBNat x) (IrBNat y) = x == y
nBNameEq IrBWild IrBWild = True
nBNameEq _ _ = False

nBinderEq : IrBinder -> IrBinder -> Bool
nBinderEq a b = nBNameEq a.irBinderName b.irBinderName && a.irBinderErased == b.irBinderErased

nLookupEnv : IrBinder -> List (Pair IrBinder NCls) -> Maybe NCls
nLookupEnv _ [] = Nothing
nLookupEnv b (p :: rest) = if nBinderEq b (firstOf p) then Just (secondOf p) else nLookupEnv b rest

-- | binder 的 kind：声明类型优先；缺类型时用绑定点的推断值。
nBinderCls : List IrTyDecl -> Maybe NCls -> IrBinder -> NCls
nBinderCls decls fallback b =
  case b.irBinderTy of
    Just ty => nKindOfTy decls (Just ty)
    Nothing =>
      case fallback of
        Just cls => cls
        Nothing => NClsMissing

nIsMissing : NCls -> Bool
nIsMissing cls =
  case cls of
    NClsMissing => True
    _ => False

-- | 把一组 binder 加进环境；返回新环境、这些 binder 的计数（擦除占位不计）
--   与其中缺 kind 的个数。
export record NBind(..) where
  nbEnv : List (Pair IrBinder NCls)
  nbCounts : NCounts
  nbMissing : Int

nBindAll : List IrTyDecl -> List IrBinder -> Maybe NCls -> List (Pair IrBinder NCls) -> NBind
nBindAll decls bs fallback env = nBindAllGo decls bs fallback (NBind env nZeroCounts 0)

nBindAllGo : List IrTyDecl -> List IrBinder -> Maybe NCls -> NBind -> NBind
nBindAllGo decls [] _ acc = acc
nBindAllGo decls (b :: rest) fallback acc =
  if b.irBinderErased then
    nBindAllGo decls rest fallback acc
  else
    let
      cls = nBinderCls decls fallback b
      miss = if nIsMissing cls then acc.nbMissing + 1 else acc.nbMissing
    in nBindAllGo decls rest fallback (NBind (Pair b cls :: acc.nbEnv) (nBump cls acc.nbCounts) miss)

-- ---------------------------------------------------------------
-- 值位置 → 分类
-- ---------------------------------------------------------------
nDefTyIn : String -> List IrDef -> Maybe IrTy
nDefTyIn _ [] = Nothing
nDefTyIn name (d :: rest) =
  case d of
    IrDef nm _ _ ty _ _ _ _ => if nm == name then ty else nDefTyIn name rest
    IrExternDef nm ty _ _ => if nm == name then Just ty else nDefTyIn name rest

-- | 一个值位置的分类；控制构造（`let` / `if` / 尾标记）不产出独立的值，返回 `Nothing`。
export nValueCls : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> Ir -> Maybe NCls
nValueCls decls defs env ir =
  case ir of
    IrVar b =>
      case b.irBinderTy of
        Just ty => Just (nKindOfTy decls (Just ty))
        Nothing =>
          case nLookupEnv b env of
            Just cls => Just cls
            Nothing => Just NClsMissing
    IrGlobal name => Just (nKindOfTy decls (nDefTyIn name defs))
    IrCtor _ _ _ _ => Just NClsPtr
    IrRecord _ resTy _ => Just (nKindOfTy decls resTy)
    IrRecUpd _ _ _ _ => Just NClsPtr
    IrProj _ _ _ resTy => Just (nKindOfTy decls resTy)
    IrRt _ => Just NClsStatic
    IrRtApp sym _ => Just (nRtCls sym)
    IrCast _ to _ => Just (nKindOfTy decls to)
    IrInt _ => Just NClsScalar
    IrStr _ => Just NClsPtr
    IrBool _ => Just NClsScalar
    IrFloatLit _ => Just NClsPtr
    IrLam _ _ _ => Just NClsPtr
    IrApp appTy _ _ =>
      case appTy of
        Just p => Just (nKindOfTy decls (Just (secondOf p)))
        Nothing => Just NClsMissing
    IrCase _ resTy _ _ => Just (nKindOfTy decls resTy)
    IrNatCase _ _ _ _ _ => Just NClsScalar
    IrConcatMany _ => Just NClsPtr
    IrEffThunk _ _ _ _ _ => Just NClsPtr
    IrEffBind _ _ _ => Just NClsPtr
    IrLet _ _ _ => Nothing
    IrTail _ => Nothing
    IrIf _ _ _ => Nothing

-- ---------------------------------------------------------------
-- case 分支 binder：按构造子字段类型推断
-- ---------------------------------------------------------------
nCaseArgsOf : Maybe IrTy -> List IrTy
nCaseArgsOf (Just (IrTyData _ args)) = args
nCaseArgsOf _ = []

nCtorFieldTys : String -> String -> List IrTyDecl -> List IrTy
nCtorFieldTys _ _ [] = []
nCtorFieldTys fam ctor (d :: rest) =
  case d of
    IrVariantDecl f _ ctors =>
      if f == fam then nCtorFieldTysGo ctor ctors else nCtorFieldTys fam ctor rest
    IrRecordDecl f _ _ fields => if f == fam then fields else nCtorFieldTys fam ctor rest
    IrUnboxedDecl _ _ _ => nCtorFieldTys fam ctor rest

nCtorFieldTysGo : String -> List (Pair String (List IrTy)) -> List IrTy
nCtorFieldTysGo _ [] = []
nCtorFieldTysGo ctor (p :: rest) =
  if firstOf p == ctor then secondOf p else nCtorFieldTysGo ctor rest

-- | 分支 binder 的 fallback：有构造子就按字段类型（代入 scrutinee 的类型实参），
--   否则用 scrutinee 自己的 kind。
nAltBinderFallback : List IrTyDecl -> Maybe IrTy -> Maybe (Pair String String) -> Int -> Maybe NCls
nAltBinderFallback decls caseTy mctor idx =
  case mctor of
    Just p =>
      case nDeclOf (firstOf p) decls of
        Just _ =>
          case irTyAt (nCtorFieldTys (firstOf p) (secondOf p) decls) idx of
            Just fieldTy =>
              Just (nKindOfTy decls (Just (irTySubstVars (nCaseArgsOf caseTy) fieldTy)))
            Nothing => Just (nKindOfTy decls caseTy)
        Nothing => Just (nKindOfTy decls caseTy)
    Nothing => Just (nKindOfTy decls caseTy)

nAltEnvGo : List IrTyDecl -> Maybe IrTy -> Maybe (Pair String String) -> List IrBinder -> Int -> NBind -> NBind
nAltEnvGo decls caseTy mctor [] _ acc = acc
nAltEnvGo decls caseTy mctor (b :: rest) idx acc =
  if b.irBinderErased then
    nAltEnvGo decls caseTy mctor rest idx acc
  else
    let
      cls = nBinderCls decls (nAltBinderFallback decls caseTy mctor idx) b
      miss = if nIsMissing cls then acc.nbMissing + 1 else acc.nbMissing
    in nAltEnvGo decls caseTy mctor rest (idx + 1) (NBind (Pair b cls :: acc.nbEnv) (nBump cls acc.nbCounts) miss)

-- ---------------------------------------------------------------
-- 遍历
-- ---------------------------------------------------------------
export record NWalk(..) where
  nwBinders : NCounts
  nwValues : NCounts
  -- | 缺 kind 的 binder，按绑定位置拆开。
  nwMissLam : Int
  nwMissLet : Int
  nwMissAlt : Int
  -- | 缺 kind 的值位置，按节点形状拆开。
  nwMissVar : Int
  nwMissApp : Int
  nwMissOther : Int

nEmptyWalk : NWalk
nEmptyWalk = NWalk nZeroCounts nZeroCounts 0 0 0 0 0 0

nAddWalk : NWalk -> NWalk -> NWalk
nAddWalk a b =
  NWalk
    (nAddCounts a.nwBinders b.nwBinders)
    (nAddCounts a.nwValues b.nwValues)
    (a.nwMissLam + b.nwMissLam)
    (a.nwMissLet + b.nwMissLet)
    (a.nwMissAlt + b.nwMissAlt)
    (a.nwMissVar + b.nwMissVar)
    (a.nwMissApp + b.nwMissApp)
    (a.nwMissOther + b.nwMissOther)

nWalkList : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> List Ir -> NWalk
nWalkList decls defs env xs = nWalkListGo decls defs env xs nEmptyWalk

nWalkListGo : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> List Ir -> NWalk -> NWalk
nWalkListGo decls defs env [] acc = acc
nWalkListGo decls defs env (x :: rest) acc =
  nWalkListGo decls defs env rest (nAddWalk (nWalk decls defs env x) acc)

nWalkFields : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> List (Pair String Ir) -> NWalk
nWalkFields decls defs env fields = nWalkFieldsGo decls defs env fields nEmptyWalk

nWalkFieldsGo : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> List (Pair String Ir) -> NWalk -> NWalk
nWalkFieldsGo decls defs env [] acc = acc
nWalkFieldsGo decls defs env (p :: rest) acc =
  nWalkFieldsGo decls defs env rest (nAddWalk (nWalk decls defs env (secondOf p)) acc)

nWalkAlt : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> Maybe IrTy -> Maybe IrAlt -> NWalk
nWalkAlt decls defs env caseTy Nothing = nEmptyWalk
nWalkAlt decls defs env caseTy (Just alt) =
  let
    bound = nAltEnvGo decls caseTy alt.irAltCtor alt.irAltBinders 0 (NBind env nZeroCounts 0)
    bodyWalk = nWalk decls defs bound.nbEnv alt.irAltBody
  in nAddWalk (NWalk bound.nbCounts nZeroCounts 0 0 bound.nbMissing 0 0 0) bodyWalk

nWalkAlts : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> Maybe IrTy -> List IrAlt -> NWalk
nWalkAlts decls defs env caseTy alts = nWalkAltsGo decls defs env caseTy alts nEmptyWalk

nWalkAltsGo : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> Maybe IrTy -> List IrAlt -> NWalk -> NWalk
nWalkAltsGo decls defs env caseTy [] acc = acc
nWalkAltsGo decls defs env caseTy (a :: rest) acc =
  nWalkAltsGo decls defs env caseTy rest (nAddWalk (nWalkAlt decls defs env caseTy (Just a)) acc)

-- | Nat 分支的 binder（前驱 / 兜底）都是 Nat 标量。
nWalkNatAlt : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> Maybe IrAlt -> NWalk
nWalkNatAlt decls defs env Nothing = nEmptyWalk
nWalkNatAlt decls defs env (Just alt) =
  let
    bound = nBindAll decls alt.irAltBinders (Just NClsScalar) env
    bodyWalk = nWalk decls defs bound.nbEnv alt.irAltBody
  in nAddWalk (NWalk bound.nbCounts nZeroCounts 0 0 bound.nbMissing 0 0 0) bodyWalk

-- | 缺 kind 的值位置：按节点形状记账，决定下一步补哪一类推断。
nMissingValueWalk : Ir -> NWalk
nMissingValueWalk ir =
  case ir of
    IrVar _ => NWalk nZeroCounts (nBump NClsMissing nZeroCounts) 0 0 0 1 0 0
    IrApp _ _ _ => NWalk nZeroCounts (nBump NClsMissing nZeroCounts) 0 0 0 0 1 0
    _ => NWalk nZeroCounts (nBump NClsMissing nZeroCounts) 0 0 0 0 0 1

nWalk : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> Ir -> NWalk
nWalk decls defs env ir =
  let
    kids = nKids decls defs env ir
    ownB =
      case ir of
        IrLam bs _ _ =>
          let
            bound = nBindAll decls bs Nothing env
          in NWalk bound.nbCounts nZeroCounts bound.nbMissing 0 0 0 0 0
        IrLet bs scrut _ =>
          let
            bound = nBindAll decls bs (nValueCls decls defs env scrut) env
          in NWalk bound.nbCounts nZeroCounts 0 bound.nbMissing 0 0 0 0
        _ => nEmptyWalk
    ownV =
      case nValueCls decls defs env ir of
        Just cls =>
          if nIsMissing cls then
            nMissingValueWalk ir
          else
            NWalk nZeroCounts (nBump cls nZeroCounts) 0 0 0 0 0 0
        Nothing => nEmptyWalk
  in nAddWalk (nAddWalk ownB ownV) kids

nKids : List IrTyDecl -> List IrDef -> List (Pair IrBinder NCls) -> Ir -> NWalk
nKids decls defs env ir =
  case ir of
    IrVar _ => nEmptyWalk
    IrGlobal _ => nEmptyWalk
    IrCtor _ _ _ args => nWalkList decls defs env args
    IrRecord _ _ fields => nWalkFields decls defs env fields
    IrProj base _ _ _ => nWalk decls defs env base
    IrRecUpd base _ fields _ =>
      nAddWalk (nWalk decls defs env base) (nWalkFields decls defs env fields)
    IrRt _ => nEmptyWalk
    IrRtApp _ args => nWalkList decls defs env args
    IrCast _ _ inner => nWalk decls defs env inner
    IrInt _ => nEmptyWalk
    IrStr _ => nEmptyWalk
    IrBool _ => nEmptyWalk
    IrFloatLit _ => nEmptyWalk
    IrLet bs scrut body =>
      let
        bound = nBindAll decls bs (nValueCls decls defs env scrut) env
      in nAddWalk (nWalk decls defs env scrut) (nWalk decls defs bound.nbEnv body)
    IrLam bs _ body =>
      let
        bound = nBindAll decls bs Nothing env
      in nWalk decls defs bound.nbEnv body
    IrApp _ f a => nAddWalk (nWalk decls defs env f) (nWalk decls defs env a)
    IrTail inner => nWalk decls defs env inner
    IrIf c th el =>
      nAddWalk
        (nWalk decls defs env c)
        (nAddWalk (nWalk decls defs env th) (nWalk decls defs env el))
    IrCase caseTy _ scrut alts =>
      nAddWalk (nWalk decls defs env scrut) (nWalkAlts decls defs env caseTy alts)
    IrNatCase scrut _ z s c =>
      nAddWalk
        (nWalk decls defs env scrut)
        (nAddWalk (nWalkNatAlt decls defs env z) (nAddWalk (nWalkNatAlt decls defs env s) (nWalkNatAlt decls defs env c)))
    IrConcatMany parts => nWalkList decls defs env parts
    IrEffThunk _ _ _ _ prim => nWalk decls defs env prim
    IrEffBind _ _ _ => nEmptyWalk

nWalkDefs : List IrTyDecl -> List IrDef -> List IrDef -> NWalk
nWalkDefs decls defs defs0 =
  case defs0 of
    [] => nEmptyWalk
    d :: rest =>
      case d of
        IrDef _ _ _ _ body _ _ _ => nAddWalk (nWalk decls defs [] body) (nWalkDefs decls defs rest)
        IrExternDef _ _ _ _ => nWalkDefs decls defs rest

-- | binder（槽）与值位置的 kind 分布。缺类型的 binder 按绑定点推断。
export nReprCounts : List IrTyDecl -> List IrDef -> NWalk
nReprCounts decls defs = nWalkDefs decls defs defs

-- | 确定性报告文本（`vuna dev ir dump --after repr|repr-cps`）。
export nReprReport : String -> List IrTyDecl -> List IrDef -> String
nReprReport mode decls defs =
  let
    w = nReprCounts decls defs
  in "repr["
    ++ mode
    ++ "] defs="
    ++ strFromInt (length defs)
    ++ "\n  binders "
    ++ nCountsText w.nwBinders
    ++ "\n  values  "
    ++ nCountsText w.nwValues
    ++ "\n  miss    lam="
    ++ strFromInt w.nwMissLam
    ++ " let="
    ++ strFromInt w.nwMissLet
    ++ " alt="
    ++ strFromInt w.nwMissAlt
    ++ " var="
    ++ strFromInt w.nwMissVar
    ++ " app=" ++ strFromInt w.nwMissApp ++ " other=" ++ strFromInt w.nwMissOther
