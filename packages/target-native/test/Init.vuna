-- 入口初始化裁剪（`Native.Module.initNeeds`）的单测。
--
-- 锁三件事：尾调用（`jmp`）不算递归，真递归（`call` 环）与间接调用才要自带栈；
-- 分配器按可达引用传递（helper 调 alloc 也算）；子进程原语才要核数（亲和性）。
import Base
import Base.Data.List as List
import Base.Effect.Core
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Model
import Vuna.Target.Native.Module

main : Eff [] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- prim_eff_print ("native init gating drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- prim_eff_exit 1
        pure ""

-- 一个只有标签和指令体的函数；帧大小与模块路径不参与判定。
fn : String -> List Instr -> NativeFunc
fn label body = NativeFunc label 0 body ["test"]

needsOf : List NativeFunc -> List String -> InitNeeds
needsOf funcs seeds = initNeeds funcs (reachFuncLabels funcs seeds)

flag : Bool -> String
flag b = if b then "on" else "off"

-- | 断言 (heap, stack, cpus) 三项。
expectInit : String -> Bool -> Bool -> Bool -> InitNeeds -> List String
expectInit label heap stack cpus n =
  if n.inHeap == heap && n.inStack == stack && n.inCpus == cpus then
    []
  else
    [
      label
        ++ ": expected heap="
        ++ flag heap
        ++ " stack="
        ++ flag stack
        ++ " cpus="
        ++ flag cpus
        ++ ", got heap="
        ++ flag n.inHeap ++ " stack=" ++ flag n.inStack ++ " cpus=" ++ flag n.inCpus
    ]

problems : List String
problems = append (append tailProblems stackProblems) (append heapProblems cpuProblems)

-- 尾递归是函数内回边：不涨栈，不需要自带栈。
tailProblems : List String
tailProblems =
  expectInit
    "tail loop"
    False
    False
    False
    (needsOf [fn "vuna_loop" [ILabel ".Lself", IJmp ".Lself"]] ["vuna_loop"])

-- 直接 `call` 自环 / 互递归 / 间接调用：需要自带栈。
stackProblems : List String
stackProblems =
  append
    (expectInit "self call" False True False (needsOf [fn "vuna_f" [ICall "vuna_f"]] ["vuna_f"]))
    (append (expectInit "mutual call" False True False (needsOf [fn "vuna_even" [ICall "vuna_odd"], fn "vuna_odd" [ICall "vuna_even"]] ["vuna_even"])) (expectInit "indirect call" False True False (needsOf [fn "vuna_g" [ICallReg R11]] ["vuna_g"])))

-- 分配器沿调用边传递；直接读写堆指针也算。
heapProblems : List String
heapProblems =
  append
    (expectInit "transitive alloc" True False False (needsOf [fn "vuna_main" [ICall "rt_helper"], fn "rt_helper" [ICall "rt_alloc"]] ["vuna_main"]))
    (append (expectInit "inline bump" True False False (needsOf [fn "vuna_main" [IMov (OpRip "rt_heap_ptr") (OpReg Rax)]] ["vuna_main"])) (expectInit "alloc_leaf" True False False (needsOf [fn "vuna_main" [ICall "rt_alloc_leaf"]] ["vuna_main"])))

-- 子进程原语才要核数；普通运行时调用不要。
cpuProblems : List String
cpuProblems =
  append
    (expectInit "spawn" False False True (needsOf [fn "vuna_main" [ICall "rt_spawn_exec"]] ["vuna_main"]))
    (expectInit "no spawn" False False False (needsOf [fn "vuna_main" [ICall "rt_print_int"]] ["vuna_main"]))
