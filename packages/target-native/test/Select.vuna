-- 标量指令选择（`Native.Select`）的单测。
--
-- 锁三件事：白名单符号与运行时标签/契约一致；每个算子的寄存器序列形状；
-- 算术的 63-bit wrap、位运算不 wrap、Nat 饱和/夹取与比较结果寄存器
-- （`rax` 先清零再 `setcc`）不被改坏；提升后 cleanup 的拷贝折叠不丢仍被读的 `rax`。
import Base
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Effect.Core
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Model
import Vuna.Target.Native.Runtime
import Vuna.Target.Native.Select

main : Eff [] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- prim_eff_print ("native select drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- prim_eff_exit 1
        pure ""

problems : List String
problems =
  append
    (append (append wrapProblems bitProblems) (append cmpProblems (append natProblems constProblems)))
    (append planProblems (append peepholeProblems (append divProblems (append branchProblems (append noWrapProblems (append floatProblems (append cleanupProblems cleanupTestProblems)))))))

wrapProblems : List String
wrapProblems =
  case scalarInstrs (ScalarWrap "add") R11 R10 of
    Pair R11 ([IBinReg "add" R11 (OpReg R10), IBinReg "shl" R11 (OpImm 1), IBinReg "sar" R11 (OpImm 1)]) =>
      []
    Pair r is => ["wrap add: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

-- 位运算对规范化封闭：只发一条 `and` / `or` / `xor`，不跟 wrap。
bitProblems : List String
bitProblems = append xorBitProblems bitNotProblems

xorBitProblems : List String
xorBitProblems =
  case scalarInstrs (ScalarBitOp "xor") R11 R10 of
    Pair R11 ([IBinReg "xor" R11 (OpReg R10)]) => []
    Pair r is => ["bit xor: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

bitNotProblems : List String
bitNotProblems =
  case scalarInstrs ScalarBitNot R11 R10 of
    Pair R11 ([IBinReg "xor" R11 (OpImm m)]) =>
      if m == 0 - 1 then [] else ["bit not: imm " ++ strFromInt m]
    Pair r is => ["bit not: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

-- 延时 wrap：中间值只被 mod 2^63 的操作消费时省掉本层的 `shl; sar`。
noWrapProblems : List String
noWrapProblems =
  case scalarInstrsNoWrap (ScalarWrap "imul") R11 R10 of
    Pair R11 ([IBinReg "imul" R11 (OpReg R10)]) => []
    Pair r is => ["nowrap imul: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

cmpProblems : List String
cmpProblems =
  case scalarInstrs (ScalarCmp "setl") R11 R10 of
    Pair Rax ([ICmp (OpReg R11) (OpReg R10), ISetcc "setl" Rax]) => []
    Pair r is => ["cmp setl: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

natProblems : List String
natProblems =
  append
    natAddProblems
    (append natMulProblems (append natSubProblems (append natFromProblems natToProblems)))

natAddProblems : List String
natAddProblems =
  case scalarInstrs ScalarNatAdd R11 R10 of
    Pair R11 ([IBinReg "add" R11 (OpReg R10), IMov (OpReg R10) (OpImm m), ICmp (OpReg R11) (OpReg R10), ICmov "cmovg" R11 (OpReg R10)]) =>
      if m == nativeMaxInt then [] else ["nat add: saturation constant drifted"]
    Pair r is => ["nat add: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

natMulProblems : List String
natMulProblems =
  case scalarInstrs ScalarNatMul R11 R10 of
    Pair R11 ([IBinReg "imul" R11 (OpReg R10), IMov (OpReg R10) (OpImm m1), ICmov "cmovno" R10 (OpReg R11), IMov (OpReg R11) (OpImm m2), ICmp (OpReg R10) (OpReg R11), ICmov "cmovle" R11 (OpReg R10)]) =>
      if m1 == nativeMaxInt && m2 == nativeMaxInt then
        []
      else
        ["nat mul: saturation constant drifted"]
    Pair r is => ["nat mul: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

natSubProblems : List String
natSubProblems =
  case scalarInstrs ScalarNatSub R11 R10 of
    Pair R11 ([IBinReg "sub" R11 (OpReg R10), IMov (OpReg R10) (OpImm 0), ICmov "cmovl" R11 (OpReg R10)]) =>
      []
    Pair r is => ["nat sub: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

natFromProblems : List String
natFromProblems =
  case scalarInstrs ScalarNatFromInt R11 R10 of
    Pair R11 ([IMov (OpReg R10) (OpImm 0), ICmp (OpReg R11) (OpReg R10), ICmov "cmovl" R11 (OpReg R10)]) =>
      []
    Pair r is => ["nat from int: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

natToProblems : List String
natToProblems =
  case scalarInstrs ScalarNatToInt R11 R10 of
    Pair R11 [] => []
    Pair r is => ["nat to int: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

constProblems : List String
constProblems =
  case scalarInstrs (ScalarConst 7) Rax R11 of
    Pair Rax ([IMov (OpReg Rax) (OpImm 7)]) => []
    Pair r is => ["const 7: reg " ++ regText r ++ ", " ++ strFromInt (length is) ++ " instrs"]

-- | 内联计划必须指向同一个运行时实现；`RuntimeTable` 也从契约符号方向做同一校验。
expectedPlans : List (Pair String String)
expectedPlans =
  [
    Pair "+" (nativeRtLabel "add"),
    Pair "-" (nativeRtLabel "sub"),
    Pair "*" (nativeRtLabel "mul"),
    Pair "bitAnd" (nativeRtLabel "bit_and"),
    Pair "bitOr" (nativeRtLabel "bit_or"),
    Pair "bitXor" (nativeRtLabel "bit_xor"),
    Pair "bitNot" (nativeRtLabel "bit_not"),
    Pair "bi_eq_int" (nativeRtLabel "eq_int"),
    Pair "bi_lt_int" (nativeRtLabel "lt_int"),
    Pair "bi_ge_bool" (nativeRtLabel "ge_int"),
    Pair "natToInt" (nativeRtLabel "nat_to_int"),
    Pair "natFromInt" (nativeRtLabel "nat_from_int"),
    Pair "natAdd" (nativeRtLabel "nat_add"),
    Pair "natMul" (nativeRtLabel "nat_mul"),
    Pair "natSub" (nativeRtLabel "nat_sub"),
    Pair "@vuna@log@on" (nativeRtLabel "log_on"),
    Pair "@vuna@obs@level" (nativeRtLabel "obs_level")
  ]

planProblems : List String
planProblems = concatMap planProblem expectedPlans

planProblem : Pair String String -> List String
planProblem p =
  let
    sym = firstOf p
    want = secondOf p
  in case scalarPlanOf sym of
    Nothing => ["plan " ++ sym ++ ": missing"]
    Just plan =>
      let
        got = secondOf plan
      in if got == want then [] else ["plan " ++ sym ++ ": " ++ got ++ " /= " ++ want]

peepholeProblems : List String
peepholeProblems =
  append
    storeReloadProblems
    (append jmpNextProblems (append immFoldProblems (append immKeepProblems cmpFoldProblems)))

storeReloadProblems : List String
storeReloadProblems =
  case peephole [IMov (OpMem Rbp (0 - 16)) (OpReg Rax), IMov (OpReg Rax) (OpMem Rbp (0 - 16))] of
    [IMov (OpMem _ _) (OpReg Rax)] => []
    is => ["store/reload: " ++ strFromInt (length is) ++ " instrs"]

jmpNextProblems : List String
jmpNextProblems =
  case peephole [IJmp ".L1", ILabel ".L1", INop] of
    [ILabel ".L1", INop] => []
    is => ["jmp to next label: " ++ strFromInt (length is) ++ " instrs"]

immFoldProblems : List String
immFoldProblems =
  case peephole [IMov (OpReg R11) (OpImm 3), IBinReg "imul" R10 (OpReg R11), INop] of
    [IBinReg "imul" R10 (OpImm 3), INop] => []
    is => ["imm fold: " ++ strFromInt (length is) ++ " instrs"]

cmpFoldProblems : List String
cmpFoldProblems =
  case peephole [IMov (OpReg R10) (OpImm 0), ICmp (OpReg R11) (OpReg R10), INop] of
    [ICmp (OpReg R11) (OpImm 0), INop] => []
    is => ["cmp imm fold: " ++ strFromInt (length is) ++ " instrs"]

-- 折叠后 scratch 还会被读、或立即数超 imm32、或目标是 scratch 自身时必须保留原样。
immKeepProblems : List String
immKeepProblems = append scratchUsedProblems (append bigImmProblems selfFoldProblems)

scratchUsedProblems : List String
scratchUsedProblems =
  case peephole [IMov (OpReg R11) (OpImm 3), IBinReg "imul" R10 (OpReg R11), IBinReg "add" Rax (OpReg R11)] of
    [IMov (OpReg R11) (OpImm 3), IBinReg "imul" R10 (OpReg R11), IBinReg "add" Rax (OpReg R11)] =>
      []
    is => ["scratch still live: " ++ strFromInt (length is) ++ " instrs"]

bigImmProblems : List String
bigImmProblems =
  case peephole [IMov (OpReg R11) (OpImm 4611686018427387903), IBinReg "imul" R10 (OpReg R11)] of
    [IMov (OpReg R11) (OpImm _), IBinReg "imul" R10 (OpReg R11)] => []
    is => ["large imm folded: " ++ strFromInt (length is) ++ " instrs"]

selfFoldProblems : List String
selfFoldProblems =
  case peephole [IMov (OpReg R11) (OpImm 3), IBinReg "add" R11 (OpReg R11)] of
    [IMov (OpReg R11) (OpImm 3), IBinReg "add" R11 (OpReg R11)] => []
    is => ["self fold: " ++ strFromInt (length is) ++ " instrs"]

-- | `cleanup` 只在标志位能安全复用时删 `sub/add/逻辑; test; jcc` 里的 `test`：
--   中间标签不是跳转目标、且 jcc 读的位与上一条指令一致（`add`/`sub` 的 OF 与
--   `test` 恒 0 不同，`ja`/`jb` 读 CF，两类都保留 `test`）。
cleanupTestProblems : List String
cleanupTestProblems =
  append
    (append (append cleanupDropProblems cleanupKeepProblems) (append cleanupTargetProblems (append cleanupOfProblems cleanupLogicProblems)))
    leaProblems

-- | `mov d, s; imul d, k` / `imul d, k; add d, c` 折成一条 `lea`；非 2/3/5/9 倍不动。
leaProblems : List String
leaProblems =
  append
    leaScaleFoldProblems
    (append leaAddFoldProblems (append leaOtherFactorProblems (append leaKeepNextProblems (append leaScale8Problems trunc32Problems))))

leaScaleFoldProblems : List String
leaScaleFoldProblems =
  case cleanup [IMov (OpReg R11) (OpReg Rbx), IBinReg "imul" R11 (OpImm 3), INop] of
    [ILeaScale R11 Rbx 2 0, INop] => []
    is => ["lea scale fold: " ++ strFromInt (length is) ++ " instrs"]

leaAddFoldProblems : List String
leaAddFoldProblems =
  case cleanup [IBinReg "imul" R12 (OpImm 5), IBinReg "add" R12 (OpImm 7), INop] of
    [ILeaScale R12 R12 4 7, INop] => []
    is => ["lea add fold: " ++ strFromInt (length is) ++ " instrs"]

leaOtherFactorProblems : List String
leaOtherFactorProblems =
  case cleanup [IBinReg "imul" R12 (OpImm 6), INop] of
    [IBinReg "imul" R12 (OpImm 6), INop] => []
    is => ["lea keeps other factors: " ++ strFromInt (length is) ++ " instrs"]

-- | `imul` 后面的指令（例如 wrap 的 `shl`）不能被折掉。
leaKeepNextProblems : List String
leaKeepNextProblems =
  case cleanup [IBinReg "imul" R12 (OpImm 5), IBinReg "shl" R12 (OpImm 1)] of
    [ILeaScale R12 R12 4 0, IBinReg "shl" R12 (OpImm 1)] => []
    is => ["lea keeps following instr: " ++ strFromInt (length is) ++ " instrs"]

leaScale8Problems : List String
leaScale8Problems =
  case cleanup [IMov (OpReg R11) (OpReg Rbx), IBinReg "imul" R11 (OpImm 9), INop] of
    [ILeaScale R11 Rbx 8 0, INop] => []
    is => ["lea scale 8: " ++ strFromInt (length is) ++ " instrs"]

-- | `and dst, 0xFFFF_FFFF` 折成一次 32 位写（`mov dst32, dst32`）。
trunc32Problems : List String
trunc32Problems =
  append (
      case cleanup [IMov (OpReg R11) (OpImm 4294967295), IBinReg "and" R12 (OpReg R11), INop] of
        [ITrunc32 R12, INop] => []
        is => ["trunc32 fold: " ++ strFromInt (length is) ++ " instrs"]
    ) (
      case cleanup [IMov (OpReg R11) (OpImm 65535), IBinReg "and" R12 (OpReg R11), INop] of
        [IMov (OpReg R11) (OpImm 65535), IBinReg "and" R12 (OpReg R11), INop] => []
        is => ["trunc32 keeps other masks: " ++ strFromInt (length is) ++ " instrs"]
    )

cleanupDropProblems : List String
cleanupDropProblems =
  case cleanup [IBinReg "sub" Rbx (OpImm 1), ILabel ".L", ITest Rbx Rbx, IJcc "jz" ".Lend"] of
    [IBinReg "sub" Rbx (OpImm 1), ILabel ".L", IJcc "jz" ".Lend"] => []
    is => ["cleanup drop: " ++ strFromInt (length is) ++ " instrs"]

cleanupKeepProblems : List String
cleanupKeepProblems =
  case cleanup [IBinReg "sub" Rbx (OpImm 1), ILabel ".L", ITest Rbx Rbx, IJcc "ja" ".L"] of
    [IBinReg "sub" Rbx (OpImm 1), ILabel ".L", ITest Rbx Rbx, IJcc "ja" ".L"] => []
    is => ["cleanup keep: " ++ strFromInt (length is) ++ " instrs"]

-- | 标签是跳转目标：别的路径跳进来时上一条指令没执行过，`test` 必须重建标志位。
cleanupTargetProblems : List String
cleanupTargetProblems =
  case cleanup [IBinReg "sub" Rbx (OpImm 1), ILabel ".L", ITest Rbx Rbx, IJcc "jz" ".Lend", IJmp ".L", ILabel ".Lend"] of
    out => if hasTest out then [] else ["cleanup target: test dropped"]

-- | `add`/`sub` 可能置 OF（`test` 恒清 0），读 OF 的 `jl`/`jg` 不能折。
cleanupOfProblems : List String
cleanupOfProblems =
  case cleanup [IBinReg "sub" Rbx (OpImm 1), ITest Rbx Rbx, IJcc "jl" ".Lend", ILabel ".Lend"] of
    out => if hasTest out then [] else ["cleanup of: test dropped"]

-- | 逻辑运算和 `test` 一样清 OF：读 OF 的条件也能复用标志位。
cleanupLogicProblems : List String
cleanupLogicProblems =
  case cleanup [IBinReg "and" Rbx (OpImm 1), ITest Rbx Rbx, IJcc "jl" ".Lend", ILabel ".Lend"] of
    out => if hasTest out then ["cleanup logic: test kept"] else []

hasTest : List Instr -> Bool
hasTest instrs = foldl (\acc, i => acc || isTest i) False instrs

isTest : Instr -> Bool
isTest (ITest r1 r2) = sameReg r1 r2
isTest _ = False

-- | 常数除法的展开判据：2 的幂走符号修正移位，其余走 magic 乘法；
--   d = 3（magic 超出 63-bit）与 `0` / `-1` / 负数走 `idiv` / 运行时
--   （除零 trap、`min_int / -1` 语义）。
divProblems : List String
divProblems =
  filter
    (\s => s /= "")
    [divCase "2" 2 (Just (DivShift 1)), divCase "8" 8 (Just (DivShift 3)), divCase "5" 5 (Just (DivMagic 5 3689348814741910324 0)), divCase "1000" 1000 (Just (DivMagic 1000 2361183241434822607 7)), divCase "7" 7 (Just (DivIdiv 7)), divCase "1001" 1001 (Just (DivIdiv 1001)), divCase "3" 3 (Just (DivIdiv 3)), divCase "0" 0 Nothing, divCase "-1" (0 - 1) Nothing, divCase "-1000" (0 - 1000) Nothing]

divCase : String -> Int -> Maybe DivPlan -> String
divCase label d want =
  if planKey want == planKey (divPlanOf d) then
    ""
  else
    label ++ ": want " ++ planKey want ++ ", got " ++ planKey (divPlanOf d)

planKey : Maybe DivPlan -> String
planKey Nothing = "runtime"
planKey (Just (DivShift k)) = "shift " ++ strFromInt k
planKey (Just (DivMagic d m s)) =
  "magic " ++ strFromInt d ++ " " ++ strFromInt m ++ " " ++ strFromInt s
planKey (Just (DivIdiv c)) = "idiv " ++ strFromInt c

-- | `IrIf` 的条件直接发 `cmp` + 反向 `jcc`。
branchProblems : List String
branchProblems =
  filter
    (\s => s /= "")
    [branchCase "le" "bi_le_int" (Just "jg"), branchCase "lt" "bi_lt_int" (Just "jge"), branchCase "eq" "bi_eq_int" (Just "jne"), branchCase "ge bool" "bi_ge_bool" (Just "jl"), branchCase "non-cmp" "+" Nothing]

branchCase : String -> String -> Maybe String -> String
branchCase label sym want =
  if branchKey want == branchKey (branchInverse sym) then
    ""
  else
    label ++ ": want " ++ branchKey want ++ ", got " ++ branchKey (branchInverse sym)

branchKey : Maybe String -> String
branchKey Nothing = "none"
branchKey (Just s) = s

-- | 浮点比较的 0/1 物化序列：有序比较先 `setnp`，`!=` 在 NaN 时为真；
--   寄存器对由调用方给（floatTree 用 xmm4/xmm5，条件分支用 xmm0/xmm1）。
floatProblems : List String
floatProblems =
  filter
    (\s => s /= "")
    [orderedFloatCase "lt" "bi_lt_float" "setb", orderedFloatCase "ge" "bi_ge_float" "setae", neqFloatCase, unknownFloatCase]

orderedFloatCase : String -> String -> String -> String
orderedFloatCase label sym cc =
  case floatCompareInstrsAt 4 5 sym of
    Just ([IXmmCmp 4 5, ISetcc "setnp" Rax, IMovzxAl, ISetcc cc1 Rdx, IBinReg "and" Rdx (OpImm 1), IBinReg "and" Rax (OpReg Rdx)]) =>
      if cc1 == cc then "" else label ++ ": cc " ++ cc1
    _ => label ++ ": unexpected sequence"

neqFloatCase : String
neqFloatCase =
  case floatCompareInstrsAt 0 1 "bi_neq_float" of
    Just ([IXmmCmp 0 1, ISetcc "setne" Rax, IMovzxAl, ISetcc "setp" Rdx, IBinReg "and" Rdx (OpImm 1), IBinReg "or" Rax (OpReg Rdx)]) =>
      ""
    _ => "neq: unexpected sequence"

unknownFloatCase : String
unknownFloatCase =
  case floatCompareInstrs "bi_add_int" of
    Nothing => ""
    Just _ => "unknown float cmp: expected Nothing"

-- | 提升后 cleanup 的拷贝折叠：`mov rax, <imm|槽>; mov r, rax` 只有在 rax 之后
--   不再被读（先被重写）时才能折成 `mov r, <imm|槽>`。常数除法的符号修正
--   `add rax, s` 会继续读它，折掉装载就让被除数变成上一个占用 rax 的值。
cleanupProblems : List String
cleanupProblems =
  append
    (append cleanupSlotProblems cleanupImmKeepProblems)
    (append cleanupFoldProblems cleanupImmFoldProblems)

-- | `mov rax, [slot]; mov r11, rax; …; add rax, r11`：rax 仍被读，装载必须保留。
cleanupSlotProblems : List String
cleanupSlotProblems =
  let
    body =
      [
        IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 0)),
        IMov (OpReg R11) (OpReg Rax),
        IBinReg "sar" R11 (OpImm 63),
        IBinReg "and" R11 (OpImm 1),
        IBinReg "add" Rax (OpReg R11),
        IBinReg "sar" Rax (OpImm 1),
        IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rax)
      ]
    out = cleanup body
  in filter
    (\s => s /= "")
    [if length out == length body then "" else "cleanup kept load: " ++ strFromInt (length out) ++ " instrs", if hasRaxLoad (nativeSlotOff 0) out then "" else "cleanup kept load: rax load dropped"]

-- | 立即数版：rax 是否仍被读同样决定能否折叠。
cleanupImmKeepProblems : List String
cleanupImmKeepProblems =
  let
    body = [IMov (OpReg Rax) (OpImm 3), IMov (OpReg R11) (OpReg Rax), IBinReg "add" Rax (OpReg R11)]
    out = cleanup body
  in filter
    (\s => s /= "")
    [if length out == length body then "" else "cleanup kept imm: " ++ strFromInt (length out) ++ " instrs", if hasRaxImm 3 out then "" else "cleanup kept imm: rax mov dropped"]

-- | rax 已死时折叠照旧发生：`mov rax, [slot]; mov r11, rax` → `mov r11, [slot]`。
cleanupFoldProblems : List String
cleanupFoldProblems =
  case cleanup [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 0)), IMov (OpReg R11) (OpReg Rax), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg R11)] of
    [IMov (OpReg R11) (OpMem Rbp o), IMov (OpMem Rbp _) (OpReg R11)] =>
      if o == nativeSlotOff 0 then [] else ["cleanup fold: wrong slot " ++ strFromInt o]
    is => ["cleanup fold: " ++ strFromInt (length is) ++ " instrs"]

cleanupImmFoldProblems : List String
cleanupImmFoldProblems =
  case cleanup [IMov (OpReg Rax) (OpImm 3), IMov (OpReg R11) (OpReg Rax), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg R11)] of
    [IMov (OpReg R11) (OpImm 3), IMov (OpMem Rbp _) (OpReg R11)] => []
    is => ["cleanup imm fold: " ++ strFromInt (length is) ++ " instrs"]

hasRaxLoad : Int -> List Instr -> Bool
hasRaxLoad off instrs = foldl (\acc, i => acc || isRaxLoad off i) False instrs

isRaxLoad : Int -> Instr -> Bool
isRaxLoad off (IMov (OpReg Rax) (OpMem Rbp o)) = o == off
isRaxLoad _ _ = False

hasRaxImm : Int -> List Instr -> Bool
hasRaxImm n instrs = foldl (\acc, i => acc || isRaxImm n i) False instrs

isRaxImm : Int -> Instr -> Bool
isRaxImm n (IMov (OpReg Rax) (OpImm k)) = k == n
isRaxImm _ _ = False
