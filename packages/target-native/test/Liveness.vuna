-- GC 点活跃槽集合（`Native.Module.nativeLiveSlotsAtCalls`）的单元测试。
--
-- 锁住文本序判定：槽在 call 之后的下一个事件是「读」才算活；读之后被重写、
-- 或者之后再无事件，都不算活。
import Base
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Base.Effect.Core
import Vuna.Target.Native.Model
import Vuna.Target.Native.Module

main : Eff [] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- prim_eff_print ("native liveness drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- prim_eff_exit 1
        pure ""

sample : List Instr
sample =
  [
    IMov (OpMem Rbp (0 - 8)) (OpReg Rax),
    IMov (OpMem Rbp (0 - 16)) (OpReg Rax),
    ICall "f",
    IMov (OpReg Rax) (OpMem Rbp (0 - 8)),
    IMov (OpMem Rbp (0 - 8)) (OpReg Rax),
    ICall "g",
    IMov (OpReg Rax) (OpMem Rbp (0 - 16)),
    ICall "h"
  ]

problems : List String
problems =
  case nativeLiveSlotsAtCalls sample of
    [Pair c0 s0, Pair c1 s1, Pair c2 s2] =>
      filter
        (\s => s /= "")
        [checkEq "call0 index" 2 c0, checkEq "call1 index" 5 c1, checkEq "call2 index" 7 c2, checkSlots "call0 live" [0 - 8, 0 - 16] s0, checkSlots "call1 live" [0 - 16] s1, checkSlots "call2 live" [] s2]
    _ => ["expected three call points"]

checkEq : String -> Int -> Int -> String
checkEq label want got =
  if want == got then "" else label ++ ": want " ++ strFromInt want ++ ", got " ++ strFromInt got

checkSlots : String -> List Int -> List Int -> String
checkSlots label want got =
  if joinInts want == joinInts got then
    ""
  else
    label ++ ": want [" ++ joinInts want ++ "], got [" ++ joinInts got ++ "]"

joinInts : List Int -> String
joinInts xs = String.join "," (map strFromInt xs)
