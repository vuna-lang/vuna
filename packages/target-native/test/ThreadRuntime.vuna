-- 多线程运行时符号表 ↔ `Ir.Runtime` 契约（线程原语全部隐藏，源码只经 `Base.Thread`）：
--   * 19 个隐藏原语都在契约里；调度子集（spawn / join / yield / id / parallelism）在
--     wasm 上按单线程顺序退化，其余同步原语 wasm 拒绝；
--   * native 的标签与值形态 arity 与预期一致（arity 错会让 `IrRt` 值调用静默错配寄存器）。
import Base
import Base.Effect.Core
import Base.Effect.Console
import Base.Effect.Exit
import Vuna.Ir.Runtime
import Vuna.Target.Native.Abi
import Vuna.Target.Native.Model
import Vuna.Target.Native.Runtime

main : Eff [ConsoleOp, ExitOp] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- consolePrint ("native thread runtime drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- exitWith 1
        pure ""

problem : String -> Bool -> List String
problem label ok = if ok then [] else [label ++ ": drifted"]

problems : List String
problems = append (concatMap expectationProblems expectations) gatingProblems

-- 宿主 scratch 只在可达代码用得到时映射：`init_tcb` 不动标志，`init_tcb_scratch`
-- 置位，`thread_spawn` 读它，`thread_join` 按线程对象里的指针判空跳过 munmap。
gatingProblems : List String
gatingProblems =
  append
    (checkFunc "init_tcb keeps scratch unmapped" "rt_init_tcb" (\f => not (hasFlagWrite f)))
    (append (checkFunc "init_tcb_scratch sets flag" "rt_init_tcb_scratch" hasFlagWrite) (append (checkFunc "thread_spawn reads flag" "rt_thread_spawn" hasFlagRead) (append (checkFunc "thread_join skips unmapped scratch" "rt_thread_join" hasJoinSkip) (checkFunc "block_end guard is per-thread" "rt_block_end_if_parallel" hasBlockEndStateGuard))))

checkFunc : String -> String -> (NativeFunc -> Bool) -> List String
checkFunc label fnLabel p =
  case funcByLabel nativeRtFuncs fnLabel of
    Just f => problem label (p f)
    Nothing => [label ++ ": missing " ++ fnLabel]

funcByLabel : List NativeFunc -> String -> Maybe NativeFunc
funcByLabel [] _ = Nothing
funcByLabel (f :: rest) l = if f.nfLabel == l then Just f else funcByLabel rest l

hasInstr : (Instr -> Bool) -> List Instr -> Bool
hasInstr p [] = False
hasInstr p (i :: rest) = p i || hasInstr p rest

hasFlagWrite : NativeFunc -> Bool
hasFlagWrite f = hasInstr isFlagWrite f.nfBody

isFlagWrite : Instr -> Bool
isFlagWrite (IMov (OpRip l) (OpReg Rax)) = l == scratchNeededLabel
isFlagWrite _ = False

hasFlagRead : NativeFunc -> Bool
hasFlagRead f = hasInstr isFlagRead f.nfBody

isFlagRead : Instr -> Bool
isFlagRead (IMov (OpReg Rax) (OpRip l)) = l == scratchNeededLabel
isFlagRead _ = False

hasJoinSkip : NativeFunc -> Bool
hasJoinSkip f = hasInstr isJoinSkip f.nfBody

isJoinSkip : Instr -> Bool
isJoinSkip (IJcc "jz" ".Lrt_tj_noscratch") = True
isJoinSkip _ = False

-- `block_end` 必须按本线程是否真的进入过 block（TCB state）收尾；不能用阻塞期间会变的
-- `rt_thread_count`：最后一个子线程退出会让计数归零。
hasBlockEndStateGuard : NativeFunc -> Bool
hasBlockEndStateGuard f =
  hasInstr isTcbStateLoad f.nfBody && not (hasInstr isThreadCountLoad f.nfBody)

isTcbStateLoad : Instr -> Bool
isTcbStateLoad (IMovFsLoad Rax off) = off == nativeTcbStateOff
isTcbStateLoad _ = False

isThreadCountLoad : Instr -> Bool
isThreadCountLoad (IMov (OpReg Rax) (OpRip l)) = l == nativeThreadCountLabel
isThreadCountLoad _ = False

-- (隐藏原语名, 值形态 arity, native 标签)
expectations : List (String, Int, String)
expectations =
  [
    ("@vuna@prim_eff_threadSpawn", 1, "rt_thread_spawn"),
    ("@vuna@prim_eff_threadJoin", 1, "rt_thread_join"),
    ("@vuna@prim_eff_threadYield", 0, "rt_thread_yield"),
    ("@vuna@prim_eff_threadId", 0, "rt_thread_id"),
    ("@vuna@prim_eff_threadParallelism", 0, "rt_thread_parallelism"),
    ("@vuna@prim_eff_mutexNew", 0, "rt_mutex_new"),
    ("@vuna@prim_eff_mutexLock", 1, "rt_mutex_lock"),
    ("@vuna@prim_eff_mutexTryLock", 1, "rt_mutex_try_lock"),
    ("@vuna@prim_eff_mutexUnlock", 1, "rt_mutex_unlock"),
    ("@vuna@prim_eff_condvarNew", 0, "rt_condvar_new"),
    ("@vuna@prim_eff_condvarWait", 2, "rt_condvar_wait"),
    ("@vuna@prim_eff_condvarSignal", 1, "rt_condvar_signal"),
    ("@vuna@prim_eff_condvarBroadcast", 1, "rt_condvar_broadcast"),
    ("@vuna@prim_eff_atomicNew", 1, "rt_atomic_new"),
    ("@vuna@prim_eff_atomicLoad", 1, "rt_atomic_load"),
    ("@vuna@prim_eff_atomicStore", 2, "rt_atomic_store"),
    ("@vuna@prim_eff_atomicFetchAdd", 2, "rt_atomic_fetch_add"),
    ("@vuna@prim_eff_atomicExchange", 2, "rt_atomic_exchange"),
    ("@vuna@prim_eff_atomicCompareExchange", 3, "rt_atomic_cas")
  ]

-- wasm 能力：调度子集支持（顺序退化），同步原语拒绝。
wasmExpectation : String -> Bool
wasmExpectation name =
  if memName name irRtWasmSeqThreadNames then
    irRtSupports "wasm" name
  else
    not (irRtSupports "wasm" name)

expectationProblems : (String, Int, String) -> List String
expectationProblems e =
  let
    name = firstOf e
    arity = firstOf (secondOf e)
    label = secondOf (secondOf e)
  in append
    (problem (name ++ " known") (irRtIsKnown name))
    (append (problem (name ++ " native") (irRtSupports "native" name)) (append (problem (name ++ " ocaml") (irRtSupports "ocaml" name)) (append (problem (name ++ " wasm") (wasmExpectation name)) (append (problem (name ++ " label") (nativeRtTarget name == Just label)) (problem (name ++ " arity") (nativeRtValueArity name == arity))))))
