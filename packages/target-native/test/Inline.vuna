-- `Native.Inline` 的单元测试：已知小函数调用点内联的边界。
--
-- 锁七件事：小体 + 可重复求值实参 → 代进去且丢掉 `IrTail`；递归定义不内联；
-- 会分配 / 有副作用的实参不内联；可重复求值的小表达式（加减 / 非零常量除法）内联、
-- 除零不内联；体超预算不内联；没有可内联点时定义表原样返回（changed=false）；
-- 零参别名解析重复跑与跑一次等价。
import Base
import Base.Data.Int as Int
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Data.String as String
import Base.Effect.Core
import Vuna.Ir.Model
import Vuna.Ir.Codec
import Vuna.Target.Native.Inline
import Vuna.Target.Native.Module
import Base.Effect.Console
import Base.Effect.Exit

main : Eff [ConsoleOp, ExitOp] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- consolePrint ("native inline drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- exitWith 1
        pure ""

xBinder : IrBinder
xBinder = mkIrBinderTyped 10 "x" IrTyInt

nBinder : IrBinder
nBinder = mkIrBinderTyped 11 "n" IrTyInt

-- inc x = x + 1
incDef : IrDef
incDef =
  IrDef
    "inc"
    1
    []
    (Just (IrTyFun IrTyInt IrTyInt))
    (IrLam [xBinder] Nothing (IrTail (IrRtApp "+" (IrVar xBinder :: IrInt 1 :: []))))
    True
    False
    Nothing

-- | 调用点：`useInc v = 0 + inc v`（实参是变量 → 平凡；调用点在非尾位置）。
useIncDef : IrDef
useIncDef =
  IrDef
    "useInc"
    1
    []
    Nothing
    (IrLam [nBinder] Nothing (IrTail (IrRtApp "+" (IrApp Nothing (IrGlobal "inc") (IrVar nBinder) :: IrInt 0 :: []))))
    True
    False
    Nothing

smallDefs : List IrDef
smallDefs = [incDef, useIncDef]

-- 递归定义：body 里自调用。
loopDef : IrDef
loopDef =
  IrDef
    "loop"
    2
    []
    Nothing
    (IrLam [nBinder, xBinder] Nothing (IrIf (IrRtApp "bi_le_int" (IrVar nBinder :: IrInt 0 :: [])) (IrVar xBinder) (IrTail (IrApp Nothing (IrApp Nothing (IrGlobal "loop") (IrRtApp "-" (IrVar nBinder :: IrInt 1 :: []))) (IrVar xBinder)))))
    True
    False
    Nothing

useLoopDef : IrDef
useLoopDef =
  IrDef
    "useLoop"
    1
    []
    Nothing
    (IrLam [nBinder] Nothing (IrTail (IrApp Nothing (IrApp Nothing (IrGlobal "loop") (IrVar nBinder)) (IrInt 0))))
    True
    False
    Nothing

recDefs : List IrDef
recDefs = [loopDef, useLoopDef]

-- 非平凡实参：`useHard = inc (other 1)`（`other` 是未知调用，可能分配 / 有副作用）。
hardArgDef : IrDef
hardArgDef =
  IrDef
    "useHard"
    0
    []
    Nothing
    (IrTail (IrApp Nothing (IrGlobal "inc") (IrApp Nothing (IrGlobal "other") (IrInt 1))))
    True
    False
    Nothing

hardDefs : List IrDef
hardDefs = [incDef, hardArgDef]

-- 可重复求值的小表达式实参：`useCheap n = inc (n + 1)` 与 `useDiv n = inc (n / 2)`。
cheapArgDef : IrDef
cheapArgDef =
  IrDef
    "useCheap"
    1
    []
    Nothing
    (IrLam [nBinder] Nothing (IrTail (IrApp Nothing (IrGlobal "inc") (IrRtApp "+" (IrVar nBinder :: IrInt 1 :: [])))))
    True
    False
    Nothing

divArgDef : IrDef
divArgDef =
  IrDef
    "useDiv"
    1
    []
    Nothing
    (IrLam [nBinder] Nothing (IrTail (IrApp Nothing (IrGlobal "inc") (IrRtApp "/" (IrVar nBinder :: IrInt 2 :: [])))))
    True
    False
    Nothing

zeroDivArgDef : IrDef
zeroDivArgDef =
  IrDef
    "useZeroDiv"
    1
    []
    Nothing
    (IrLam [nBinder] Nothing (IrTail (IrApp Nothing (IrGlobal "inc") (IrRtApp "/" (IrVar nBinder :: IrInt 0 :: [])))))
    True
    False
    Nothing

cheapDefs : List IrDef
cheapDefs = [incDef, cheapArgDef]

divDefs : List IrDef
divDefs = [incDef, divArgDef]

zeroDivDefs : List IrDef
zeroDivDefs = [incDef, zeroDivArgDef]

-- 体超预算：18 个节点的拼接链。
bigBinder : IrBinder
bigBinder = mkIrBinderTyped 40 "x" IrTyInt

bigInner : Ir
bigInner =
  IrConcatMany
    (IrStr "a" :: IrStr "b" :: IrStr "c" :: IrStr "d" :: IrStr "e" :: IrStr "f" :: IrStr "g" :: IrStr "h" :: IrStr "i" :: IrStr "j" :: IrStr "k" :: IrStr "l" :: IrStr "m" :: IrStr "n" :: IrStr "o" :: IrStr "p" :: IrStr "q" :: [])

bigDef : IrDef
bigDef = IrDef "big" 1 [] Nothing (IrLam [bigBinder] Nothing (IrTail bigInner)) True False Nothing

useBigDef : IrDef
useBigDef =
  IrDef "useBig" 0 [] Nothing (IrTail (IrApp Nothing (IrGlobal "big") (IrInt 1))) True False Nothing

bigDefs : List IrDef
bigDefs = [bigDef, useBigDef]

nonInlinable : List IrDef
nonInlinable = [incDef]

smallOut : Pair (List IrDef) Bool
smallOut = inlineDefs [] smallDefs

recOut : Pair (List IrDef) Bool
recOut = inlineDefs ["loop"] recDefs

hardOut : Pair (List IrDef) Bool
hardOut = inlineDefs [] hardDefs

cheapOut : Pair (List IrDef) Bool
cheapOut = inlineDefs [] cheapDefs

divOut : Pair (List IrDef) Bool
divOut = inlineDefs [] divDefs

zeroDivOut : Pair (List IrDef) Bool
zeroDivOut = inlineDefs [] zeroDivDefs

bigOut : Pair (List IrDef) Bool
bigOut = inlineDefs [] bigDefs

sameOut : Pair (List IrDef) Bool
sameOut = inlineDefs [] nonInlinable

-- Float let 消除：立即 lambda 应用 + 纯 Float 实参 + 单次使用 → 代进去；
-- 两次使用 / 嵌套 lambda 内使用 / 非 Float 实参 → 保留。
fBinder : IrBinder
fBinder = mkIrBinderTyped 50 "f" IrTyFloat

floatExpr : Ir
floatExpr = IrRtApp "bi_mul_float" (IrFloatLit "2.0" :: IrFloatLit "0.5" :: [])

floatOnceDef : IrDef
floatOnceDef =
  IrDef
    "useFloatOnce"
    0
    []
    Nothing
    (IrApp Nothing (IrLam [fBinder] Nothing (IrTail (IrRtApp "bi_add_float" (IrVar fBinder :: IrFloatLit "1.0" :: [])))) floatExpr)
    True
    False
    Nothing

floatTwiceDef : IrDef
floatTwiceDef =
  IrDef
    "useFloatTwice"
    0
    []
    Nothing
    (IrApp Nothing (IrLam [fBinder] Nothing (IrTail (IrRtApp "bi_add_float" (IrVar fBinder :: IrVar fBinder :: [])))) floatExpr)
    True
    False
    Nothing

floatNestedDef : IrDef
floatNestedDef =
  IrDef
    "useFloatNested"
    0
    []
    Nothing
    (IrApp Nothing (IrLam [fBinder] Nothing (IrTail (IrLam [nBinder] Nothing (IrTail (IrVar fBinder))))) floatExpr)
    True
    False
    Nothing

floatIntDef : IrDef
floatIntDef =
  IrDef
    "useIntLet"
    0
    []
    Nothing
    (IrApp Nothing (IrLam [nBinder] Nothing (IrTail (IrRtApp "+" (IrVar nBinder :: IrInt 1 :: [])))) (IrInt 3))
    True
    False
    Nothing

floatOnceOut : List IrDef
floatOnceOut = inlineFloatLetsDefs [floatOnceDef]

floatTwiceOut : List IrDef
floatTwiceOut = inlineFloatLetsDefs [floatTwiceDef]

floatNestedOut : List IrDef
floatNestedOut = inlineFloatLetsDefs [floatNestedDef]

floatIntOut : List IrDef
floatIntOut = inlineFloatLetsDefs [floatIntDef]

problems : List String
problems =
  filter
    (\s => s /= "")
    [check "small call inlined" False (mentionsGlobal "inc" (bodyOf "useInc" (firstOf smallOut))), check "inlined tail stripped" False (hasTail (belowRoot (lamInner (bodyOf "useInc" (firstOf smallOut))))), check "changed flag" True (secondOf smallOut), check "recursive call kept" True (mentionsGlobal "loop" (bodyOf "useLoop" (firstOf recOut))), check "recursive changed flag" False (secondOf recOut), check "non-trivial arg kept" True (mentionsGlobal "inc" (bodyOf "useHard" (firstOf hardOut))), check "cheap arg inlined" False (mentionsGlobal "inc" (bodyOf "useCheap" (firstOf cheapOut))), check "div arg inlined" False (mentionsGlobal "inc" (bodyOf "useDiv" (firstOf divOut))), check "zero-div arg kept" True (mentionsGlobal "inc" (bodyOf "useZeroDiv" (firstOf zeroDivOut))), check "big body kept" True (mentionsGlobal "big" (bodyOf "useBig" (firstOf bigOut))), check "no inline point unchanged" False (secondOf sameOut), check "float let inlined" False (mentionsBinder 50 (bodyOf "useFloatOnce" floatOnceOut)), check "float let expr kept" True (mentionsRtApp "bi_mul_float" (bodyOf "useFloatOnce" floatOnceOut)), check "float twice kept" True (mentionsBinder 50 (bodyOf "useFloatTwice" floatTwiceOut)), check "float nested lambda kept" True (mentionsBinder 50 (bodyOf "useFloatNested" floatNestedOut)), check "int let kept" True (mentionsBinder 11 (bodyOf "useIntLet" floatIntOut)), check "tail if merged" True mergeOk, check "alias applied" True aliasApplied, check "alias idempotent" True aliasIdempotent]

bodyOf : String -> List IrDef -> Ir
bodyOf _ [] = IrInt 0
bodyOf n (d :: rest) =
  if irDefName d == n then
    case d of
      IrDef _ _ _ _ body _ _ _ => body
      _ => IrInt 0
  else
    bodyOf n rest

mentionsGlobal : String -> Ir -> Bool
mentionsGlobal n ir =
  case ir of
    IrGlobal m => m == n
    IrApp _ f a => mentionsGlobal n f || mentionsGlobal n a
    IrTail inner => mentionsGlobal n inner
    IrLet _ s b => mentionsGlobal n s || mentionsGlobal n b
    IrIf c t e => mentionsGlobal n c || mentionsGlobal n t || mentionsGlobal n e
    IrLam _ _ b => mentionsGlobal n b
    _ => False

mentionsBinder : Int -> Ir -> Bool
mentionsBinder id ir =
  case ir of
    IrVar b => b.irBinderId == id
    IrApp _ f a => mentionsBinder id f || mentionsBinder id a
    IrTail inner => mentionsBinder id inner
    IrRtApp _ args => mentionsBinderList id args
    IrLet _ s b => mentionsBinder id s || mentionsBinder id b
    IrIf c t e => mentionsBinder id c || mentionsBinder id t || mentionsBinder id e
    IrLam _ _ b => mentionsBinder id b
    _ => False

mentionsBinderList : Int -> List Ir -> Bool
mentionsBinderList id xs = foldl (\acc, x => acc || mentionsBinder id x) False xs

mentionsRtApp : String -> Ir -> Bool
mentionsRtApp sym ir =
  case ir of
    IrRtApp s args => s == sym || mentionsRtAppList sym args
    IrApp _ f a => mentionsRtApp sym f || mentionsRtApp sym a
    IrTail inner => mentionsRtApp sym inner
    IrLet _ s b => mentionsRtApp sym s || mentionsRtApp sym b
    IrIf c t e => mentionsRtApp sym c || mentionsRtApp sym t || mentionsRtApp sym e
    IrLam _ _ b => mentionsRtApp sym b
    _ => False

mentionsRtAppList : String -> List Ir -> Bool
mentionsRtAppList sym xs = foldl (\acc, x => acc || mentionsRtApp sym x) False xs

lamInner : Ir -> Ir
lamInner ir =
  case ir of
    IrLam _ _ b => b
    _ => ir

belowRoot : Ir -> Ir
belowRoot ir =
  case ir of
    IrTail inner => inner
    _ => ir

hasTail : Ir -> Bool
hasTail ir =
  case ir of
    IrTail _ => True
    IrLam _ _ b => hasTail b
    _ => False

check : String -> Bool -> Bool -> String
check label want got = if want == got then "" else label ++ ": drifted"

-- ---------------------------------------------------------------
-- mergeTailIfs：同目标、实参只差标量常量的两个尾调用合成一次调用 + 值选择
-- ---------------------------------------------------------------
mergeCond : Ir
mergeCond = IrRtApp "bi_gt_int" [IrVar nBinder, IrInt 0]

mergeStep : Ir
mergeStep = IrRtApp "-" [IrVar nBinder, IrInt 1]

mergeCall : Ir -> Ir
mergeCall a = IrTail (IrApp Nothing (IrApp Nothing (IrGlobal "guard") a) mergeStep)

mergeDef : IrDef
mergeDef =
  IrDef
    "guard"
    2
    []
    Nothing
    (IrLam [xBinder, nBinder] Nothing (IrIf (IrRtApp "bi_le_int" [IrVar nBinder, IrInt 0]) (IrVar xBinder) (IrIf mergeCond (mergeCall (IrRtApp "+" [IrVar xBinder, IrInt 1])) (mergeCall (IrRtApp "+" [IrVar xBinder, IrInt 2])))))
    True
    False
    Nothing

mergeBody : Ir
mergeBody = bodyOf "guard" (mergeTailIfs [mergeDef])

containsIf : Ir -> Bool
containsIf ir =
  case ir of
    IrIf _ _ _ => True
    IrRtApp _ args => foldl (\acc, a => acc || containsIf a) False args
    IrApp _ f a => containsIf f || containsIf a
    IrCast _ _ inner => containsIf inner
    _ => False

mergeOk : Bool
mergeOk =
  case mergeBody of
    IrLam _ _ (IrIf _ _ e) =>
      case e of
        IrLet _ scrut _ => containsIf scrut
        _ => False
    _ => False

-- ---------------------------------------------------------------
-- 零参别名解析（`Native.Module.resolveAliasDefs`）：对合法输入重复跑与跑一次等价
-- ---------------------------------------------------------------
-- `Nat.plus = natAdd` 的形状：零参定义体是运行时叶子 `IrRt`。
aliasTargetDef : IrDef
aliasTargetDef = IrDef "natAddAlias" 0 [] Nothing (IrRt "natAdd") False False Nothing

-- 应用位置上的别名：`f x = natAddAlias x x`。
aliasUseDef : IrDef
aliasUseDef =
  IrDef
    "f"
    1
    []
    Nothing
    (IrLam [xBinder] Nothing (IrTail (IrApp Nothing (IrApp Nothing (IrGlobal "natAddAlias") (IrVar xBinder)) (IrVar xBinder))))
    True
    False
    Nothing

aliasSampleDefs : List IrDef
aliasSampleDefs = [aliasTargetDef, aliasUseDef]

aliasOnce : List IrDef
aliasOnce = resolveAliasDefs aliasSampleDefs

-- 同一 IR ⇒ 同一串规范编码（`IrDef` 没有 `Eq`，与 `vuna dev ir dump` 的文本口径一致）。
aliasEncoded : List IrDef -> String
aliasEncoded ds = encodeUnit (IrUnit [] [IrGroup False ds] False [] Nothing)

aliasIdempotent : Bool
aliasIdempotent = aliasEncoded (resolveAliasDefs aliasOnce) == aliasEncoded aliasOnce

aliasApplied : Bool
aliasApplied =
  mentionsRtApp "natAdd" (bodyOf "f" aliasOnce)
    && not (mentionsGlobal "natAddAlias" (bodyOf "f" aliasOnce))
