-- native 运行时符号表 ↔ `Ir.Runtime` 契约（CG-17）。
--
-- 两道门禁：
--   1. 契约声明了 arity 的符号（`irInlineArity > 0`）在作为值出现时，表里的 arity
--      （`nativeRtValueArity`，缺省回落到契约）必须一致；不一致会静默错配寄存器。
--   2. 不在运行时表里的符号必须逐条登记在 `runtimeGaps`（含由生成器特化的 `&&` / `||`、
--      `@ir@natSucc` 与入口 show），新增契约符号不能悄悄缺席。
--
-- 缺口语义与理由见 docs/reference/native.md。
import Base
import Base.Data.List as List
import Base.Data.Pair as Pair
import Base.Effect.Core
import Base.Effect.Console
import Base.Effect.Exit
import Vuna.Ir.Model
import Vuna.Ir.Runtime
import Vuna.Target.Native.Runtime
import Vuna.Target.Native.Select

main : Eff [ConsoleOp, ExitOp] String
main =
  case problems of
    [] => pure ""
    ps =>
      do
        _ <- consolePrint ("native runtime table drifted:\n" ++ join "\n" ps ++ "\n")
        _ <- exitWith 1
        pure ""

problems : List String
problems =
  append
    (append (append (concatMap arityProblems irRtNames) missingProblems) extraProblems)
    inlineProblems

-- `&&` / `||` 由生成器发短路控制流，不作为运行时函数值出现。
generatorSpecial : String -> Bool
generatorSpecial sym = sym == "&&" || sym == "||"

arityProblems : String -> List String
arityProblems sym =
  let
    a = irInlineArity sym
  in if a <= 0 || generatorSpecial sym then
    []
  else
    case nativeRtTarget sym of
      Nothing => ["arity " ++ sym ++ ": not implemented"]
      Just _ =>
        let
          v = nativeRtValueArity sym
        in if v > 0 && v /= a then ["arity " ++ sym ++ ": table " ++ strFromInt v ++ ", contract " ++ strFromInt a] else []

missingProblems : List String
missingProblems =
  map
    (\sym => "not implemented and not listed: " ++ sym)
    (filter (\sym => not (memName sym runtimeGaps)) gaps)

extraProblems : List String
extraProblems =
  map
    (\sym => "listed as a gap but implemented: " ++ sym)
    (filter (\sym => not (memName sym gaps)) runtimeGaps)

-- 内联计划里的运行时标签必须与 `nativeRtTarget` 选中的实现一致；两边任一漂移都会
-- 让调用点的语义与直接调用分叉。
inlineProblems : List String
inlineProblems = concatMap inlineProblem irRtNames

inlineProblem : String -> List String
inlineProblem sym =
  case scalarPlanOf sym of
    Nothing => []
    Just plan =>
      let
        want = secondOf plan
      in case nativeRtTarget sym of
        Nothing => ["inline " ++ sym ++ ": runtime target missing"]
        Just got => if got == want then [] else ["inline " ++ sym ++ ": " ++ want ++ " /= " ++ got]

gaps : List String
gaps = filter isGap irRtNames

isGap : String -> Bool
isGap sym =
  case nativeRtTarget sym of
    Nothing => True
    Just _ => False

-- 当前不在运行时表里的契约符号；按契约声明顺序排列。
runtimeGaps : List String
runtimeGaps =
  [
    "&&",
    "||",
    "prim_effectPerformId",
    "prim_effectHandleId",
    "prim_effectSelf",
    "prim_schedNewScope",
    "prim_schedFork",
    "prim_schedYield",
    "prim_schedIsCancelled",
    "prim_schedAwait",
    "prim_schedTaskResult",
    "prim_schedTaskError",
    "prim_schedCancelTask",
    "prim_schedCancelScope",
    "prim_schedScopeWait",
    "prim_schedScopeWaitTimeout",
    "prim_schedScopeError",
    "prim_schedScopeCount",
    "strFromFloat",
    "@vuna@prim_eff_readLine",
    "@vuna@prim_eff_readBytes",
    "@vuna@host@readLine",
    "@vuna@host@readBytes",
    "@vuna@host@tryNetListen",
    "@vuna@host@tryNetPort",
    "@vuna@host@tryNetAccept",
    "@vuna@host@tryNetRecv",
    "@vuna@host@tryNetSend",
    "@vuna@host@tryNetClose",
    "@vuna@host@tryNetConnect",
    "@vuna@host@tryNetAcceptWithin",
    "@vuna@host@tryNetRecvWithin",
    "@vuna@host@tryNetSendWithin",
    "@ir@natSucc",
    "@ir@showInt",
    "@ir@showNat",
    "@ir@showStr",
    "@ir@showFloat",
    "@ir@showBool",
    "@vuna@prim_eff_threadSpawn",
    "@vuna@prim_eff_threadJoin",
    "@vuna@prim_eff_threadYield",
    "@vuna@prim_eff_threadId",
    "@vuna@prim_eff_threadParallelism",
    "@vuna@prim_eff_mutexNew",
    "@vuna@prim_eff_mutexLock",
    "@vuna@prim_eff_mutexTryLock",
    "@vuna@prim_eff_mutexUnlock",
    "@vuna@prim_eff_condvarNew",
    "@vuna@prim_eff_condvarWait",
    "@vuna@prim_eff_condvarSignal",
    "@vuna@prim_eff_condvarBroadcast",
    "@vuna@prim_eff_atomicNew",
    "@vuna@prim_eff_atomicLoad",
    "@vuna@prim_eff_atomicStore",
    "@vuna@prim_eff_atomicFetchAdd",
    "@vuna@prim_eff_atomicExchange",
    "@vuna@prim_eff_atomicCompareExchange"
  ]
