module Base where

-- Vuna：stdlib 包门面（M11-C）。整模块重导出核心模块，保留各模块的抽象性
-- （例如 Map 的构造器不因门面而公开）。编译器/用户程序可以只 `import Vuna`。
export import Base.Pair
export import Base.Bits
export import Base.Bool
export import Base.Show
export import Base.Eq
export import Base.Ord
-- M31.1：加载 `Int` 的 Eq / Ord 实例（跟类型模块走；仅加载实例，不重导出名字）。
import Base.Int
export import Base.Interp
export import Base.Foldable
export import Base.Float
export import Base.Hashable
export import Base.List
export import Base.Monoid
-- D23：算术运算符 `+ - * /` 是 `Num` 方法的别名（fixity/别名真源在 Base.Num）。
export import Base.Num
export import Base.Maybe
export import Base.Nat
export import Base.Result
export import Base.String
export import Base.Sort
export import Base.Traversable
export import Base.Unit
export import Base.Map
export import Base.Monad
