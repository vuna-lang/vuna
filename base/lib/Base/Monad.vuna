module Base.Monad (Functor(..), Monad(..)) where

-- Base.Monad：Functor / Monad trait（M11-B：支持高阶 kind 与约束泛化）。
-- do 语法糖在 loader 里 desugar 成 bind / lambda；pure、fmap 是普通 trait 方法。
-- 约定方法名固定：Functor.fmap、Monad.bind、Monad.pure。
-- fixity 与别名来自本模块的 `infixr` / `infixl` 声明：`>>=` → bind；`>>` 的 fixity 也在这里，
-- 但**不**是普通别名——`a >> b` 由 Loader 按 do 派生展开成 `bind a (\_ -> b)`（`>>` 需要
-- 「丢弃结果」的适配，且必须用调用点可见的 `bind`；写成全局特化函数会在模块内自定义
-- Monad trait 时绑错）。
infixr 1 >>= = bind
infixl 1 >>

trait Functor f where
  fmap : (a -> b) -> f a -> f b

trait Monad m where
  bind : m a -> (a -> m b) -> m b
  pure : a -> m a
