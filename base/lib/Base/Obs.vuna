module Base.Obs where

import Base.Bool
import Base.Int
import Base.Ord

-- Base.Obs：语言层可观测性 API（**所有 vuna 应用**都用这一层，不只是编译器）。
--
-- 规范、事件模型与成本纪律见 `docs/reference/observability.md`。这一层是隐藏运行时
-- 原语（`@vuna@obs@*`）的**薄包装**：
--   * 默认关闭（`VUNA_OBS=1..3` / `--obs` / `--obs-level N`）；关闭时每次调用只付一次
--     `Lazy.force` + 一个布尔分支，不分配、不读时钟、不碰文件；
--   * 打开后事件写 Chrome Trace Event JSONL（`ph:"X"` 跨度 / `ph:"C"` 计数 /
--     `ph:"i"` 日志与采样），可直接拖进 `chrome://tracing` / Perfetto，或经
--     `vuna obs convert` 换算成 `.cpuprofile` / speedscope / folded；
--   * 全部是**纯函数**（返回 `Int`，无 `Eff`）：深部纯函数照样能埋探针，不需要把签名
--     effect 化（debt D68 的取舍）；开关是 ambient 运行时配置，与 `dbg!` 同形态。
--
-- 本模块只有**叶子**原语，因此任何后端都能构建。**高阶**部分（`obsSpan` / `obsSpanP` /
-- `obsSample`：吃 `Int -> a` thunk）在 `Base.Obs.Span`——OCaml 后端用闭包实现，wasm /
-- native 没有闭包表示、引用点编译期拒绝（见 native.md / wasm.md 的「可观测性」段）。
--
-- 与 `dbg!` 的关系：`dbg!` 保留其 stderr 文本协议（`DEBUG <epoch-us> <text>`，由
-- `--debug-perf` 门控）；本层是结构化事件。需要两者都拿到时用 `obsLog`——它在
-- observability 打开时写事件、并同格式写 stderr。
--
-- 名字词汇表（`docs/reference/observability.md` §3.3）：编译链事件用 `vuna.*`；用户程序
-- 事件用自己的域前缀（如 `app.render`），`vuna obs validate` 只校验 `vuna.*` 前缀。
-- ---------------------------------------------------------------
-- 级别与开关
-- ---------------------------------------------------------------
-- | 当前观测级别（`0` 关 / `1` 阶段 / `2` 逐定义 / `3` 采样）。哑 `Int` 实参承载开关查询，避免在源码层出现「纯值读进程配置」的形态。
export obsLevel : Int -> Int
obsLevel n = @vuna@obs@level n

-- | 观测是否打开（`level >= 1`）。需要自己判开销时用它，避免无谓的事件构造（例如构造日志实参本来就是贵的时候）。
export obsOn : Int -> Bool
obsOn n = if @vuna@obs@level n > 0 then True else False

-- ---------------------------------------------------------------
-- 事件
-- ---------------------------------------------------------------
-- | 一条日志事件（`args.text`），并同格式写 `DEBUG <epoch-us> <text>` 到 stderr；返回 0。
export obsLog : String -> Int
obsLog text = @vuna@obs@log text

-- | 计数器读数（`ph:"C"`，`args.value`）：用于步数 / 命中数 / 规模的归因。
export obsCounter : String -> Int -> Int
obsCounter name value = @vuna@obs@counter name value

-- | 瞬时标记（`ph:"i"`）：不占时间轴宽度的一次性记号，用于「这一刻发生了什么」。
export obsMark : String -> Int
obsMark name = @vuna@obs@mark name

-- ---------------------------------------------------------------
-- 采样
-- ---------------------------------------------------------------
-- | 开始采样：`mode` 为 `"cpu"` / `"mem"` / `"both"`，`intervalUs` 是采样间隔（`<= 0` 用默认 1000us）。CPU 采样走 `ITIMER_PROF` + `SIGPROF`，只计 CPU 时间；内存采样走 `Gc.Memprof` 分配回调。样本在 `obsSampleStop` 时批量写入 trace。
export obsSampleStart : String -> Int -> Int
obsSampleStart mode intervalUs = @vuna@obs@sampleStart mode intervalUs

-- | 停止采样并 flush trace；返回 0。与 `obsSampleStart` 配对使用（多 domain 采样未做，见 debt D41）。
export obsSampleStop : Int -> Int
obsSampleStop n = @vuna@obs@sampleStop n
