-- | 二元组类型与投影函数。
module Base.Pair where

-- Base.Pair：二元组类型与投影函数。按「实例跟类型模块走」的落点规则承载
-- `Show` / `Eq` / `Ord` 实例，因此依赖 Base.Show / Base.Eq / Base.Ord；
-- Bool 构造子与 `&&` / `||` 的 fixity 来自 Base.Bool。
import Base.Bool
import Base.Eq
import Base.Hashable
import Base.Ord
import Base.Show

-- | 二元组 `Pair a b`；构造子字段是 `first` / `second`。
export record Pair a b(..) where
  first : a
  second : b

-- | 取第一个分量。
export firstOf : Pair a b -> a
firstOf (Pair a b) = a

-- | 取第二个分量。
export secondOf : Pair a b -> b
secondOf (Pair a b) = b

-- B31：容器 `Show` 实例；`Interp` 经 blanket `Show a => Interp a` 自动获得。
-- 用 `++` 的反引号形式拼字符串：列表字面量会折叠成 `Cons`/`Nil`，而
-- `Base.List → Base.Pair` 已存在（Pair 不能反向 import List），名字不可见；
-- 反引号中缀不要求 fixity 声明，`++` 又是恒可见的 String intrinsic。
instance Show a, Show b => Show (Pair a b) where
  show p = case p of
    Pair x y => "(" `++` (show x) `++` ", " `++` (show y) `++` ")"

-- 逐分量比较；`Ord` 是字典序（先比第一个分量，相等再比第二个）。
instance Eq a, Eq b => Eq (Pair a b) where
  eq (Pair a1 b1) (Pair a2 b2) = a1 == a2 && b1 == b2
  neq p q = if p == q then False else True

instance Ord a, Ord b => Ord (Pair a b) where
  lt (Pair a1 b1) (Pair a2 b2) = if a1 < a2 then True else if a2 < a1 then False else b1 < b2
  le p q = p < q || not (q < p)
  gt p q = q < p
  ge p q = q <= p

instance Hashable a, Hashable b => Hashable (Pair a b) where
  hash p = case p of
    Pair a b => hashCombine (hash a) (hash b)
