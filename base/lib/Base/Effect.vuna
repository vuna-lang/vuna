module Base.Effect (MonadIO(..)) where

-- Base.Effect：IO 作为效应栈基座的接口（M37）。
--
-- `IO` 是内建效应类型；transformer（StateT / ReaderT / ErrorT）把纯效应叠在任意
-- monad 上。`MonadIO` 让「能在任意 IO 承载的 monad 里执行 IO 动作」成为可约束的
-- 接口：`liftIO : IO a -> m a`。
--
-- 边界（B11/F4）：vuna 的 trait 只支持单参数、没有父类（superclass），所以
--   * `MonadIO` 不声明 `Monad m` 父类——`do` 仍需单独的 `Monad` 字典；
--   * 不能写 `MonadState s m` / `MonadReader e m` 这类多参数效应类；
--     需要效应多态时用具体 transformer + 显式签名约束。
import Base.Monad

trait MonadIO m where
  liftIO : IO a -> m a

-- 基座实例：IO 里的 IO 动作就是它自己。
instance MonadIO IO where
  liftIO io = io
