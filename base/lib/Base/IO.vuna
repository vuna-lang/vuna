module Base.IO
  ( Functor(..)
  , IO
  , Monad(..)
  , exit
  , fileExists
  , fileMtime
  , fileSize
  , getArgs
  , isDirectory
  , makeDir
  , print
  , println
  , readBytes
  , readDir
  , readFile
  , readLine
  , removeFile
  , runIO
  , writeFile
  ) where

-- Base.IO：抽象 IO 动作与效果 API（M11-C / M12.6 / M31）。
-- 表示是「世界令牌 Int -> a」的挂起函数（thunk）；构造器 MkIO 私有。
--
-- M31：效果原语 `prim_*` 本身已经是 IO 动作（`String -> IO String` 等），所以下面
-- 的 print / readFile / … 都是**别名**，不再有 `MkIO (\w => prim_*)` 包装。
--
-- 执行入口只有两个：
--   1. `main : IO a`：运行时在入口用世界令牌 0 执行一次；
--   2. `runIO : IO a -> a`：**特权**逃逸口。只有 manifest `[capabilities] effects`
--      声明了 "unsafe" 的包才能在源码里引用它（`Loader.Resolve.checkEffectsBuiltins`）。
--      工具链（vuna / vuna-compiler）用它把宿主效果放在 main 之外执行；普通包不应
--      使用——`runIO` 会破坏「IO 只在 main 执行」的保证。
--
-- `runIO` 每次调用都重新执行动作（动作值可以复用，效果不缓存）。
import Base.List
import Base.Bool
import Base.Monad
-- `++` 的 fixity 声明在 Base.String；base 模块不自动注入 Prelude，println 需要它。
import Base.String
import Base.Nat

data IO a : Type where
  MkIO : (Int -> a) -> IO a

-- 特权执行入口：`MkIO f` 拿到世界令牌 0 立即执行；能力门控在 Loader.Resolve。
runIO : IO a -> a
runIO (MkIO f) = f 0

-- 内部构造器（不导出）：Functor/Monad 实例的实现细节。
ioPure : a -> IO a
ioPure x = MkIO (\w => x)

ioBind : IO a -> (a -> IO b) -> IO b
ioBind (MkIO f) k = MkIO (\w => case k (f w) of
  MkIO g => g w
)

ioFmap : (a -> b) -> IO a -> IO b
ioFmap f (MkIO g) = MkIO (\w => f (g w))

-- 效果 API：直接别名到 IO 化的原语（M31）。
print : String -> IO Int
print = prim_print

println : String -> IO Int
println s = print (s ++ "\n")

readFile : String -> IO String
readFile = prim_readFile

writeFile : String -> String -> IO Int
writeFile = prim_writeFile

readLine : IO String
readLine = prim_readLine

-- 字节级读取（LSP 帧）：最多读 n 字节；n 是度量 → Nat。
readBytes : Nat -> IO String
readBytes n = prim_readBytes (natToInt n)

readDir : String -> IO (List String)
readDir = prim_readDir

isDirectory : String -> IO Bool
isDirectory = prim_isDirectory

makeDir : String -> IO Int
makeDir = prim_makeDir

removeFile : String -> IO Int
removeFile = prim_removeFile

fileExists : String -> IO Bool
fileExists = prim_fileExists

-- 文件元数据（工具链）：秒级 mtime 与字节数；路径不存在时都返回 0。
-- 供索引器判断「源码是否变化」，避免每次重算内容摘要。
fileMtime : String -> IO Int
fileMtime = prim_fileMtime

fileSize : String -> IO Nat
fileSize path = fmap natFromInt (prim_fileSize path)

getArgs : IO (List String)
getArgs = prim_getArgs

exit : Int -> IO Int
exit = prim_exit

instance Functor IO where
  fmap f io = ioFmap f io

instance Monad IO where
  bind io k = ioBind io k
  pure x = ioPure x
