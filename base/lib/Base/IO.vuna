module Base.IO
  ( Functor(..)
  , Monad(..)
  , exit
  , fileExists
  , fileMtime
  , fileSize
  , getArgs
  , isDirectory
  , makeDir
  , print
  , println
  , readBytes
  , readDir
  , readFile
  , readLine
  , removeFile
  , runIO
  , writeFile
  ) where

-- Base.IO：IO 的公开 API 与 Functor/Monad 实例。
--
-- M37 起 IO 是**编译器内建效应类型**：kind `Type -> Type`，运行时表示是裸 thunk
-- `int -> 'a`，没有构造器（`MkIO` 已删除）。本模块不再声明 `data IO`，只提供：
--   1. 效果 API：print / readFile / …（M31 起就是 IO 化的 `prim_*` 的别名）；
--   2. `runIO : IO a -> a`：**唯一**的 main 外执行入口（`prim_runIO`，需能力
--      `unsafe`；能力门控在 `Loader.Resolve`）。IO 动作只在 main 由运行时执行，
--      `runIO` 每次调用都重新执行动作（动作值可复用、效果不缓存）；
--   3. `Functor` / `Monad` 实例：构造/绑定走内建代数 `prim_pureIO` / `prim_bindIO`。
--
-- `IO` 类型本身恒可见（内建，无需 import）；`import Base.IO` 是为了 API 与实例。
import Base.List
import Base.Bool
import Base.Monad
-- `++` 的 fixity 声明在 Base.String；base 模块不自动注入 Prelude，println 需要它。
import Base.String
import Base.Nat

-- 特权执行入口：`prim_runIO` 拿到世界令牌 0 立即执行；能力门控在 Loader.Resolve。
runIO : IO a -> a
runIO = prim_runIO

-- 效果 API：直接别名到 IO 化的原语（M31）。
print : String -> IO Int
print = prim_print

println : String -> IO Int
println s = print (s ++ "\n")

readFile : String -> IO String
readFile = prim_readFile

writeFile : String -> String -> IO Int
writeFile = prim_writeFile

readLine : IO String
readLine = prim_readLine

-- 字节级读取（LSP 帧）：最多读 n 字节；n 是度量 → Nat。
readBytes : Nat -> IO String
readBytes n = prim_readBytes (natToInt n)

readDir : String -> IO (List String)
readDir = prim_readDir

isDirectory : String -> IO Bool
isDirectory = prim_isDirectory

makeDir : String -> IO Int
makeDir = prim_makeDir

removeFile : String -> IO Int
removeFile = prim_removeFile

fileExists : String -> IO Bool
fileExists = prim_fileExists

-- 文件元数据（工具链）：秒级 mtime 与字节数；路径不存在时都返回 0。
-- 供索引器判断「源码是否变化」，避免每次重算内容摘要。
fileMtime : String -> IO Int
fileMtime = prim_fileMtime

fileSize : String -> IO Nat
fileSize path = fmap natFromInt (prim_fileSize path)

getArgs : IO (List String)
getArgs = prim_getArgs

exit : Int -> IO Int
exit = prim_exit

-- IO 代数：内建原语就是 thunk 构造/绑定，实例只做转接（没有第二套实现）。
instance Functor IO where
  fmap f io = prim_bindIO io (\x => prim_pureIO (f x))

instance Monad IO where
  bind io k = prim_bindIO io k
  pure x = prim_pureIO x
