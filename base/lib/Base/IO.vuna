module Base.IO (IO, print, println, readFile, writeFile, readLine, readDir,
                 isDirectory, makeDir, removeFile, fileExists, getArgs, exit) where

-- Base.IO：抽象 IO 动作与效果 API（M11-C / M12.6）。
-- 表示是「世界令牌 Int -> a」的挂起函数；构造器 MkIO 私有。
-- 没有公开的 runIO / unsafeRunIO：IO 动作只能由运行时在 `main` 处执行。
-- 组合统一用 Functor/Monad trait（fmap/bind/pure、`>>=`、`do`），不导出 bindIO 等。
--
-- 这里的效果函数就是用户可见的 print / readFile / getArgs / exit：
-- 它们直接返回 IO，内部由 prim_* 原语实现；普通包不能调用 prim_*。

import Base.List
import Base.Monad

data IO a : Type where
  MkIO : (Int -> a) -> IO a

-- 内部构造器（不导出）：Functor/Monad 实例的实现细节。
ioPure : a -> IO a
ioPure x = MkIO (\w => x)

ioBind : IO a -> (a -> IO b) -> IO b
ioBind (MkIO f) k =
  MkIO (\w => case k (f w) of
                MkIO g => g w)

ioFmap : (a -> b) -> IO a -> IO b
ioFmap f (MkIO g) = MkIO (\w => f (g w))

print : String -> IO Int
print s = MkIO (\w => prim_print s)

println : String -> IO Int
println s = print (s ++ "\n")

readFile : String -> IO String
readFile path = MkIO (\w => prim_readFile path)

writeFile : String -> String -> IO Int
writeFile path contents = MkIO (\w => prim_writeFile path contents)

readLine : IO String
readLine = MkIO (\w => prim_readLine)

readDir : String -> IO (List String)
readDir path = MkIO (\w => prim_readDir path)

isDirectory : String -> IO Bool
isDirectory path = MkIO (\w => prim_isDirectory path)

makeDir : String -> IO Int
makeDir path = MkIO (\w => prim_makeDir path)

removeFile : String -> IO Int
removeFile path = MkIO (\w => prim_removeFile path)

fileExists : String -> IO Bool
fileExists path = MkIO (\w => prim_fileExists path)

getArgs : IO (List String)
getArgs = MkIO (\w => prim_getArgs)

exit : Int -> IO Int
exit code = MkIO (\w => prim_exit code)

instance Functor IO where
  fmap f io = ioFmap f io

instance Monad IO where
  bind io k = ioBind io k
  pure x = ioPure x
