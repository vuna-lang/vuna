module Base.IO (Functor(..), Monad(..), module Base.Applicative) where

-- Base.IO：IO 的**公开代数**（F3 P2 拆分后）。
--
-- M37 起 IO 是**编译器内建效应类型**：kind `Type -> Type`，运行时表示是裸 thunk
-- `int -> 'a`，没有构造器。本模块只提供：
--   1. `Functor` / `Monad` / `Applicative` 实例：构造/绑定走内建代数
--      `prim_pureIO` / `prim_bindIO`（无宿主能力）；
--   2. 面向 `main : IO a`、`IORef` / `MArray` / `Buffer` / `ST` 这类**进程内 IO** 的
--      代数面。
--
-- 宿主别名（print/readFile/getArgs/…）与 `runIO` 在特权模块 `Base.IO.Host`：
-- 只有 `[package] privileged = true` 的包可以 import（base 真实 handler、编译器、
-- 根包工具链）。用户面宿主效应经 `Base.Eff.*` 标签 + handler 表达，运行入口用
-- `runIOEff : Eff [] a -> IO a`。
import Base.Applicative
import Base.Monad

-- IO 代数：内建原语就是 thunk 构造/绑定，实例只做转接（没有第二套实现）。
instance Functor IO where
  fmap f io = prim_bindIO io (\x => prim_pureIO (f x))

instance Monad IO where
  bind io k = prim_bindIO io k

instance Applicative IO where
  pure x = prim_pureIO x
  ap mf mx = prim_bindIO mf (\g => prim_bindIO mx (\b => prim_pureIO (g b)))
  liftA2 f ma mb = prim_bindIO ma (\a => prim_bindIO mb (\b => prim_pureIO (f a b)))
