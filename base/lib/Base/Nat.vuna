module Base.Nat where

-- Base.Nat：非负整数。
--
-- 类型层仍是普通归纳族 `Zero`/`Succ`（`Vec` 索引、覆盖性、终止性、索引合一全部复用），
-- 但 codegen 的运行时表示是 **OCaml int**：`Zero = 0`、`Succ n = n + 1`（饱和到
-- max_int = 4611686018427387903）。因此 Nat 没有变体分配，模式匹配降成整数比较。
--
-- 算术语义（与 `Vuna.Compiler.Intrinsics` 的 bi_nat* / Core.Eval 的 interp 实现一致）：
--   * `plus` / `mult` 饱和到 max_int；
--   * `minus` 截断到 0（不会产生负数）；
--   * `Num.div`（`/`）向下取整；除零与 Int `/` 同样在运行期 `Failure "division by zero"`。
-- `toInt` 是无损提升（运行时恒等）；`fromInt` 有损（负数 clamp 成 0），需要区分时用
-- `fromIntMaybe`。`+ - * /` 在 Nat 上下文由精化器按 `Num` 方法特化（D23），直接走同一组原语。
import Base.Bool
import Base.Eq
import Base.Int
import Base.Monoid
import Base.Maybe
import Base.Hashable
import Base.Num
import Base.Ord
import Base.Show

-- | 非负整数（归纳族 `Zero` / `Succ`）。类型层是普通归纳族，供 Vec 索引、覆盖性与终止性复用；运行时表示是 OCaml int（`Zero = 0`、`Succ n = n + 1`，饱和到 max_int），没有变体分配。
export data Nat(..) : Type where
  Zero : Nat
  Succ : Nat -> Nat

-- | 加法，结果饱和到 max_int；`+` 在 Nat 上下文由精化器特化到同一原语。
export plus : Nat -> Nat -> Nat
plus = natAdd

-- | 截断减法：结果小于 0 时取 0，永不产生负数。
export minus : Nat -> Nat -> Nat
minus = natSub

-- | 乘法，结果饱和到 max_int。
export mult : Nat -> Nat -> Nat
mult = natMul

-- | 无损提升到 `Int`（运行时恒等）。
export toInt : Nat -> Int
toInt = natToInt

-- | 有损转换：负数 clamp 成 0；需要区分时用 `fromIntMaybe`。
export fromInt : Int -> Nat
fromInt = natFromInt

-- | `fromInt` 的可失败版：负数返回 `Nothing`，否则 `Just`。
export fromIntMaybe : Int -> Maybe Nat
fromIntMaybe n = if n < 0 then Nothing else Just (fromInt n)

-- | 前驱 `minus n 1`：零的前驱仍是零。
export pred : Nat -> Nat
pred n = minus n 1

-- | 是否为 `Zero`（运行时判 `toInt n == 0`）。
export isZero : Nat -> Bool
isZero n = toInt n == 0

instance Eq Nat where
  eq x y = toInt x == toInt y
  neq x y = toInt x /= toInt y

instance Ord Nat where
  lt x y = toInt x < toInt y
  le x y = toInt x <= toInt y
  gt x y = toInt x > toInt y
  ge x y = toInt x >= toInt y

-- D23 Stage1：`Num` 实例，语义沿用 Nat 既有算术（`sub` 截断到 0、`div` 向下取整）。
-- 方法体写内建运算符，由精化器特化成 `natAdd` / `natSub` / `natMul` / `natDiv`；
-- Stage 2 把 `+` 别名到 `add` 后，特化认 `Base.Num` 方法投影，仍然走原语（不自递归）。
instance Num Nat where
  add x y = x + y
  sub x y = x - y
  mul x y = x * y
  div x y = x / y

instance Show Nat where
  show n = strFromInt (toInt n)

instance Hashable Nat where
  hash n = toInt n

instance Semigroup Nat where
  mappend = plus

instance Monoid Nat where
  mempty = 0
