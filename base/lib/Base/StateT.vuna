module Base.StateT (StateT, evalStateT, execStateT, get, modify, put, runStateT) where

-- Base.StateT：IO 之上的 State 效应（M37 效应栈）。
--
-- `StateT s a` = `s -> IO (Pair a s)`：状态随 IO 动作串行推进，handler 是
-- `runStateT` / `evalStateT` / `execStateT`。`MonadIO (StateT s)` 让 IO 动作经
-- `liftIO` 进入本层，与 `get` / `put` 在同一个 `do` 块里组合。
--
-- 边界：vuna 的 record 参数统一按 `Type` kind 降级，且实例头/签名里的自由变量 kind
-- 不能从构造子 kind 反推，所以 transformer 固定以 IO 为基座（不是 `m` 泛化）。
-- 泛化到任意 monad 需要「隐式参数 kind 从构造子 kind 推断」，登记在 debt。
import Base.Effect
import Base.IO.Host
import Base.Monad
import Base.Pair

-- | IO 之上的 State 效应 transformer：`StateT s a` = `s -> IO (Pair a s)`；固定以 IO 为基座（record 参数 kind 限制，泛化到任意 monad 见 debt）。
record StateT s a where
  stateTRun : s -> IO (Pair a s)

-- | 运行并返回「结果 + 最终状态」的 `IO (Pair a s)`；是唯一 handler，其余运行函数基于它。
runStateT : StateT s a -> s -> IO (Pair a s)
runStateT st s = st.stateTRun s

-- | 运行并只取结果（丢弃最终状态）。
evalStateT : StateT s a -> s -> IO a
evalStateT st s = fmap firstOf (runStateT st s)

-- | 运行并只取最终状态（丢弃结果）。
execStateT : StateT s a -> s -> IO s
execStateT st s = fmap secondOf (runStateT st s)

-- | 取当前状态（结果与状态相同）。
get : StateT s s
get = StateT (\s => pure (Pair s s))

-- | 替换状态，返回占位结果 `0`（签名 `StateT s Int`）。
put : s -> StateT s Int
put s = StateT (\_ => pure (Pair 0 s))

-- | 用 `f` 变换状态，返回占位结果 `0`。
modify : (s -> s) -> StateT s Int
modify f = StateT (\s => pure (Pair 0 (f s)))

instance Functor (StateT s) where
  fmap f st = StateT (\s => st.stateTRun s >>= (\p => pure (Pair (f (firstOf p)) (secondOf p))))

instance Monad (StateT s) where
  bind st k = StateT (\s => st.stateTRun s >>= (\p => (k (firstOf p)).stateTRun (secondOf p)))

instance Applicative (StateT s) where
  pure a = StateT (\s => pure (Pair a s))
  liftA2 f sa sb =
    StateT
      (\s => sa.stateTRun s >>= (\pa => sb.stateTRun (secondOf pa) >>= (\pb => pure (Pair (f (firstOf pa) (firstOf pb)) (secondOf pb)))))

instance MonadIO (StateT s) where
  liftIO io = StateT (\s => io >>= (\a => pure (Pair a s)))
