module Base.EffArgs where

-- Base.EffArgs：一阶命令行参数效应（P2c：补 getArgs 标签，供夹具迁移 typed effects）。
--
-- 标签 = `ArgsOp`（实例名在行的 `Cons n ArgsOp r` 条目里）；操作只有 GetArgs，返回 `List String`。
-- 真实 handler 用 `@vuna@prim_eff_getArgs` 实现。
import Base.Eff
import Base.Monad
import Base.List

-- | 参数操作：`GetArgs`（不含 argv[0] 的命令行参数）。
export data ArgsOp(..) : Type where
  GetArgs : ArgsOp

-- | 操作的结果类型族：`GetArgs` 返回 `List String`。
export resArgs : ArgsOp -> Type
resArgs GetArgs = List String

-- | 通过命名实例取命令行参数。
export argsGetArgs : Member n ArgsOp r => Eff r (List String)
argsGetArgs = sendCore ArgsOp "args" n GetArgs

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `ArgsOp`。
export handleArgs : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n ArgsOp r} -> (a -> b) -> ((o : ArgsOp) -> (resArgs o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n ArgsOp r) b
handleArgs n ret opH comp = handleCore ArgsOp "args" n ret opH comp

-- | 真实 handler 的操作解释：取 `@vuna@prim_eff_getArgs` 后继续。
argsOpHIO : {a : Type} -> (o : ArgsOp) -> (resArgs o -> Eff [] a) -> Eff [] a
argsOpHIO op k = case op of
  GetArgs => do
    xs <- @vuna@prim_eff_getArgs
    k xs

-- | 宿主 handler：结果行删除 `ArgsOp`，answer 是已处理干净的 `Eff []` 动作，可用 `joinEff` 展平。
-- ---------------------------------------------------------------
-- 阶段 3：带行 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
argsOpHIOHost : {a : Type} -> (o : ArgsOp) -> (resArgs o -> Eff (Cons "default" ArgsOp []) a) -> Eff (Cons "default" ArgsOp []) a
argsOpHIOHost op k = case op of
  GetArgs => do
    xs <- @vuna@host@getArgs
    k xs

handleArgsHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n ArgsOp r) a -> Eff r (Eff (Cons "default" ArgsOp []) a)
handleArgsHostHost n comp = handleArgs n (\a => pure a) argsOpHIOHost comp

runArgsHost : {r : Row} -> {a : Type} -> Eff (Cons "default" ArgsOp r) a -> Eff (rowAppend r (Cons "default" ArgsOp [])) a
runArgsHost comp = joinEff (handleArgsHostHost "default" comp)
