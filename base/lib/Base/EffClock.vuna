module Base.EffClock
  ( Clock
  , ClockOp(..)
  , clockNow
  , clockSleepMicros
  , handleClock
  , handleClockIO
  , resClock
  , runClock
  ) where

-- Base.EffClock：一阶时钟效应（W10 IO 标签迁移）。
--
-- 标签 `Clock n` 是命名实例；操作 `Now`（微秒时间戳）与 `SleepMicros`
-- （睡 n 微秒）。真实 handler 用 `Base.IO.nowMicros` 与编译器原生原语 `prim_sleep`
-- 实现（W10 收尾：阻塞睡眠，不是忙等）。
--
-- 边界：`Base.EffClock` 与 `Base.IO.Host.sleepMicros` 都已使用原生 `prim_sleep`；
-- 不存在忙等回退（`spinMicros` 已删除）。
import Base.Eff
import Base.IO.Host
import Base.Monad

-- | clock 效应的标签类型 `Clock n`：只做行索引，没有运行时构造子。
data Clock : String -> Type where

-- | clock 操作：`Now`（微秒时间戳）与 `SleepMicros`（睡眠微秒数）。
data ClockOp : Type where
  Now : ClockOp
  SleepMicros : Int -> ClockOp

-- | 操作的结果类型族：`Now` 与 `SleepMicros` 都返回 `Int`。
resClock : ClockOp -> Type
resClock Now = Int
resClock (SleepMicros us) = Int

-- | 通过命名实例读当前时间戳（微秒）。
clockNow : (n : String) -> {r : Row} -> {w : Member (Clock n) r} -> Eff r Int
clockNow n = sendCore (Clock n) "clock" n Now

-- | 通过命名实例睡 `us` 微秒；真实 handler 走编译器原生 `prim_sleep`（阻塞睡眠，不是忙等）。
clockSleepMicros : (n : String) -> Int -> {r : Row} -> {w : Member (Clock n) r} -> Eff r Int
clockSleepMicros n us = sendCore (Clock n) "clock" n (SleepMicros us)

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `Clock n`。
handleClock : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member (Clock n) r} -> (a -> b) -> ((o : ClockOp) -> (resClock o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem (Clock n) r) b
handleClock n ret opH comp = handleCore (Clock n) "clock" n ret opH comp

-- | 真实 handler 的操作解释：`Now` 走 `timeUs`，`SleepMicros` 走 `prim_sleep`（阻塞睡眠）。
clockOpHIO : {a : Type} -> (o : ClockOp) -> (resClock o -> IO a) -> IO a
clockOpHIO op k = case op of
  Now => do
    t <- timeUs
    k t
  SleepMicros us => do
    _ <- prim_sleep us
    k 0

-- | IO-backed handler：结果行删除 `Clock n`，answer 是 IO 动作，可交给 `runIOAnswer`。
handleClockIO : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons (Clock n) r) a -> Eff r (IO a)
handleClockIO n comp = handleClock n (\a => pure a) clockOpHIO comp

-- | 单效应便捷入口（P3）：`handleClockIO n` + `runIOAnswer` 的组合。
runClock : {a : Type} -> (n : String) -> Eff [Clock n] a -> IO a
runClock n comp = runIOAnswer (handleClockIO n comp)
