module Base.EffExn
  ( Exn
  , ExnOp(..)
  , Name(..)
  , bracketExn
  , catchExn
  , exnRes
  , handleExn
  , nameCode
  , runExn
  , throwExn
  , tryWith
  ) where

-- Base.EffExn：高阶/作用域 Error（W6）。
-- `Try` 操作携带一个子计算；handler 用嵌套的 `runExn` + `runEff` 在临时 handler
-- 下运行子计算，实现 scoped handler（其余效应仍由外层运行时 handler 处理）。
import Base.Eff
import Base.Ord
import Base.Result

-- | exn 效应的命名实例 `X1` / `X2`。
data Name : Type where
  X1 : Name
  X2 : Name

-- | 运行时实例码：`X1 = 0`、`X2 = 1`。
nameCode : Name -> Int
nameCode X1 = 0
nameCode X2 = 1

-- | exn 效应的标签类型 `Exn n`：只做行索引，没有运行时构造子。
data Exn : Name -> Type where

-- | exn 操作（高阶）：`ThrowExn msg` 与 `Try sub`——`Try` 携带一个子计算，由 handler 在临时 handler 下运行。
data ExnOp : Name -> Row -> Type -> Type where
  ThrowExn : {n : Name} -> {r : Row} -> {a : Type} -> String -> ExnOp n r a
  Try : {n : Name} -> {r : Row} -> {a : Type} -> Eff (Exn n :: r) a -> ExnOp n r a

-- | 结果族：`ThrowExn` 返回 `Int`，`Try` 返回 `Result a`。
exnRes : (n : Name) -> (r : Row) -> (a : Type) -> ExnOp n r a -> Type
exnRes n r a (ThrowExn s) = Int
exnRes n r a (Try comp) = Result a

-- | 通过命名实例抛异常；返回类型任意（不恢复续延）。
throwExn : (n : Name) -> String -> {a : Type} -> {r : Row} -> Eff (Exn n :: r) a
throwExn n msg = sendCore (Exn n) "exn" (nameCode n) (ThrowExn msg)

-- | 把子计算 `comp` 包成 `Try` 操作交给 handler，返回 `Result a`（`Ok` 值 / `Err` 消息）。
tryWith : (n : Name) -> {a : Type} -> {r : Row} -> Eff (Exn n :: r) a -> Eff (Exn n :: r) (Result a)
tryWith n comp = sendCore (Exn n) "exn" (nameCode n) (Try comp)

-- | 一阶 handler：`ret` / `opH` 由调用方给出；结果行删除 `Exn n`。
handleExn : (n : Name) -> {a : Type} -> {b : Type} -> {r : Row} -> (a -> b) -> ((o : ExnOp n r a) -> (exnRes n r a o -> b) -> b) -> Eff (Exn n :: r) a -> Eff r b
handleExn n ret opH comp = handleCore (Exn n) "exn" (nameCode n) ret opH comp

-- | 内部：handler 的操作解释——`ThrowExn` 变 `Err`；`Try` 用减一的 fuel 嵌套 `runExnFuel`，再把结果交给续延。
exnOpH : (fuel : Int) -> (n : Name) -> {r : Row} -> {a : Type} -> (o : ExnOp n r a) -> (exnRes n r a o -> Result a) -> Result a
exnOpH fuel n op k = if fuel <= 0 then Err "exn: fuel exhausted"
else case op of
  ThrowExn s => Err s
  Try sub => k (runEff (runExnFuel (fuel - 1) n sub))

-- | 内部：带 fuel 的 `runExn` 实现；fuel 耗尽返回 `Err exn: fuel exhausted`（防无限嵌套）。
runExnFuel : (fuel : Int) -> (n : Name) -> {a : Type} -> {r : Row} -> Eff (Exn n :: r) a -> Eff r (Result a)
runExnFuel fuel n comp =
  if fuel <= 0 then pureEff (Err "exn: fuel exhausted")
  else handleExn n (\a => Ok a) (exnOpH (fuel - 1) n) comp

-- | 把 `Exn n` 收成 `Result`（fuel 64）；结果行删除 `Exn n`。
runExn : (n : Name) -> {a : Type} -> {r : Row} -> Eff (Exn n :: r) a -> Eff r (Result a)
runExn n comp = runExnFuel 64 n comp

-- | 作用域 catch：成功原样返回，`Err s` 交给 `fallback`（仍在该 exn handler 下继续）。
catchExn : (n : Name) -> {a : Type} -> {r : Row} -> Eff (Exn n :: r) a -> (String -> Eff (Exn n :: r) a) -> Eff (Exn n :: r) a
catchExn n comp fallback = bindEff (tryWith n comp) (\res => case res of
  Ok a => pureEff a
  Err s => fallback s
)

-- | exn 版 bracket：acquire → use → release；use 成功或抛异常都会 release，异常在 release 之后重新抛出。
bracketExn : (n : Name) -> {res : Type} -> {a : Type} -> {r : Row} -> Eff (Exn n :: r) res -> (res -> Eff (Exn n :: r) Int) -> (res -> Eff (Exn n :: r) a) -> Eff (Exn n :: r) a
bracketExn n acquire release use = bindEff acquire (\res => bindEff (tryWith n (use res)) (\r => case r of
  Ok a => bindEff (release res) (\_ => pureEff a)
  Err s => bindEff (release res) (\_ => throwExn n s)
)
)
