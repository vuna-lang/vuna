module Base.MArray (length, new, read, write) where

-- Base.MArray：`Eff []` 内的可变数组（M33 W3）。内建类型构造子 `MArray`，OCaml 表示
-- `'a array`（与不可变 `Array` 同一表示，靠类型区分可变性）。
--
-- 所有操作返回 `Eff []`；`read` / `write` 越界是宿主 `Invalid_argument`。
-- 尺寸/下标是 **Nat**；底层原语仍是 Int（低层 runtime 接口）。
-- 没有线性 / 唯一性类型前，安全边界是「只在动作里使用」。
import Base.Eff
import Base.Monad
import Base.Nat

-- | 分配长度为 `n`、每个元素初值都是 `v` 的可变数组（`Eff []` 动作）；内部 `Int` 下标由 `Nat` 恒等转换而来。
new : Nat -> a -> Eff [] (MArray a)
new n v = prim_eff_newMArray (natToInt n) v

-- | 可变数组长度（`Nat`）。
length : MArray a -> Eff [] Nat
length a = fmap natFromInt (prim_eff_mArrayLength a)

-- | 读下标 `i` 的元素；越界是宿主 `Invalid_argument`。
read : MArray a -> Nat -> Eff [] a
read a i = prim_eff_readMArray a (natToInt i)

-- | 写下标 `i` 的元素，返回底层原语的 `Int` 结果；越界同 `read`。
write : MArray a -> Nat -> a -> Eff [] Int
write a i v = prim_eff_writeMArray a (natToInt i) v
