module Base.Ord (Ord(..)) where

-- Base.Ord：`Ord` trait 的**声明**（M31.1：trait 声明与实例分离）。
--
-- 实例落点规则同 `Base.Eq`：`Bool` 是 `Ord` 方法签名的一部分（返回类型），实例随
-- trait 留本模块（放 `Base.Bool` 会成环）；`Int` / `String` 的实例在
-- `Base.Int` / `Base.String`。
--
-- `<` / `<=` / `>` / `>=` 不再是编译器内建全局：Loader 把它们解析成 `lt` / `le` /
-- `gt` / `ge` 的别名（M31.1）；Int / String 上的特化是内建实例实现。
-- `<` / `<=` / `>` / `>=` 是 `lt` / `le` / `gt` / `ge` 的 fixity/别名声明（M31.2：
-- 优先级与别名由库声明，Loader 在中缀重排时消费）。
import Base.Bool

trait Ord a where
  lt : a -> a -> Bool
  le : a -> a -> Bool
  gt : a -> a -> Bool
  ge : a -> a -> Bool

-- `Bool` 的顺序用模式匹配直接表达：`False < True`。
instance Ord Bool where
  lt False True = True
  lt _ _ = False
  le False _ = True
  le True x = x
  gt True False = True
  gt _ _ = False
  ge True _ = True
  ge False x = x
