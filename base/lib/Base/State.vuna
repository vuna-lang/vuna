module Base.State (State, evalState, execState, get, modify, put, runState) where

-- Base.State：库级 State monad（M33 W6 落地；M35.1 补 Functor/Monad 实例，`do` 可用）。
--
-- 表示是 `s -> Pair a s` 的纯函数：没有语言级效应，handler 就是 `runState` /
-- `evalState` / `execState`。`bind` / `pure` / `fmap` 走 Base.Monad 的 trait 实例。
import Base.Pair
import Base.Int
import Base.Monad

record State s a where
  stateRun : s -> Pair a s

runState : State s a -> s -> Pair a s
runState (State f) s = f s

evalState : State s a -> s -> a
evalState st s = firstOf (runState st s)

execState : State s a -> s -> s
execState st s = secondOf (runState st s)

instance Functor (State s) where
  fmap f st = State (\s => case st.stateRun s of
    Pair a s2 => Pair (f a) s2
  )

instance Monad (State s) where
  bind st k = State (\s => case st.stateRun s of
    Pair a s2 => (k a).stateRun s2
  )
  pure a = State (\s => Pair a s)

get : State s s
get = State (\s => Pair s s)

put : s -> State s Int
put s = State (\_ => Pair 0 s)

modify : (s -> s) -> State s Int
modify f = State (\s => Pair 0 (f s))
