module Base.EffExit where

-- Base.EffExit：一阶进程退出效应（P2c：补 exit 标签）。
--
-- 标签 `ExitOp` 是命名实例；操作只有 ExitWith（状态码）。真实 handler 调
-- `@vuna@prim_eff_exit` 后不会返回，`k 0` 只是类型上的兜底。
import Base.Eff
import Base.Monad

-- | 退出操作：`ExitWith` 带状态码。
export data ExitOp(..) : Type where
  ExitWith : Int -> ExitOp

-- | 操作的结果类型族：`ExitWith` 声明返回 `Int`（执行即退出，不返回）。
export resExit : ExitOp -> Type
resExit (ExitWith _) = Int

-- | 通过命名实例退出进程（原语类型 `Int -> Eff [] Int`，执行即退出、不返回）。
export exitWith : Member n ExitOp r => Int -> Eff r Int
exitWith code = sendCore ExitOp "exit" n (ExitWith code)

-- | 一阶 handler：结果行删除 `ExitOp`。
export handleExit : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n ExitOp r} -> (a -> b) -> ((o : ExitOp) -> (resExit o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n ExitOp r) b
handleExit n ret opH comp = handleCore ExitOp "exit" n ret opH comp

-- | 真实 handler 的操作解释：执行 `@vuna@prim_eff_exit code`；`k 0` 不可达，只为类型闭合。
exitOpHIO : {a : Type} -> (o : ExitOp) -> (resExit o -> Eff [] a) -> Eff [] a
exitOpHIO op k = case op of
  ExitWith code => do
    _ <- @vuna@prim_eff_exit code
    k 0

-- | 宿主 handler：结果行删除 `ExitOp`，answer 是已处理干净的 `Eff []` 动作，可用 `joinEff` 展平。
-- ---------------------------------------------------------------
-- 阶段 3：带行 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
exitOpHIOHost : {a : Type} -> (o : ExitOp) -> (resExit o -> Eff (Cons "default" ExitOp []) a) -> Eff (Cons "default" ExitOp []) a
exitOpHIOHost op k = case op of
  ExitWith code => do
    _ <- @vuna@host@exitOp code
    k 0

handleExitHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n ExitOp r) a -> Eff r (Eff (Cons "default" ExitOp []) a)
handleExitHostHost n comp = handleExit n (\a => pure a) exitOpHIOHost comp

runExitHost : {r : Row} -> {a : Type} -> Eff (Cons "default" ExitOp r) a -> Eff (rowAppend r (Cons "default" ExitOp [])) a
runExitHost comp = joinEff (handleExitHostHost "default" comp)
