module Base.Array where

-- Base.Array：不可变数组（M33 W3）。内建类型构造子 `Array`，OCaml 表示 `'a array`。
--
-- 构造器不可见：只能经 `fromList` / `make` 构造；`set` 返回**新数组**（copy-on-write），
-- 原数组不变。`get` / `set` 越界是宿主 `Invalid_argument`（与 `strAt` 的 -1 哨兵语义
-- 不同，见 docs/reference/primitives.md）。
--
-- 尺寸/下标是 **Nat**；底层原语仍是 Int（低层 runtime 接口），这里的转换是恒等/单分支。
--
-- `Array` 是没有定义模块的内建类型构造子（实例落点由 `Elab/Trait.vuna` 的
-- `isGlobalHeadType` 放行），`Eq` / `Show` 实例按约定落在本模块；实例体经 `toList`
-- 复用 `List` 的实现。
import Base.Bool
import Base.Eq
import Base.List
import Base.Nat
import Base.Show

-- | 从 `List` 构造不可变数组（列表入口；另一个构造器是 `make`）。
export fromList : List a -> Array a
fromList xs = arrayFromList xs

-- | 把数组转成 `List`（经 List 桥接复制成列表表示）。
export toList : Array a -> List a
toList a = arrayToList a

-- | 数组元素个数（`Nat`）。
export length : Array a -> Nat
length a = natFromInt (arrayLength a)

-- | 按下标 `i` 取元素；越界是宿主 `Invalid_argument`（与 `strAt` 的 -1 哨兵不同）。
export get : Array a -> Nat -> a
get a i = arrayGet a (natToInt i)

-- | 返回**新数组**（copy-on-write），原数组不变；越界同 `get`。
export set : Array a -> Nat -> a -> Array a
set a i v = arraySet a (natToInt i) v

-- | 构造长度为 `n`、每个元素都是 `v` 的数组。
export make : Nat -> a -> Array a
make n v = arrayMake (natToInt n) v

-- | 逐元素相等；经 `toList` 复用 `Eq (List a)`。
instance Eq a => Eq (Array a) where
  eq a b = toList a == toList b
  neq a b = if a == b then False else True

-- | 展示为与 List 相同的 `[a, b, c]`；经 `toList` 复用 `Show (List a)`。
instance Show a => Show (Array a) where
  show a = show (toList a)
