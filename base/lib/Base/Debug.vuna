module Base.Debug (assert, todo, trace, traceShow) where

-- Base.Debug：纯代码调试工具（M38）。
--
-- 这批函数是**调试专用**，不是正式的效应/错误处理通道：
--   - `trace` / `traceShow` 在纯代码求值期把一行写进 stderr 后返回原值，依赖
--     `runIO`（base 的既有内部信任点）执行 `prim_eprint`；
--   - `assert` / `todo` 失败时走 `prim_fail`（抛 Failure），由生成的 main 钩子统一
--     报告为 `vuna: runtime error: ...`、打印 vuna 位置帧并 exit 2。
--
-- 显式 `import Base.Debug` 才可见（不进 Prelude）；生产逻辑请用返回类型 / 效应表达失败。
-- 边界与格式见 docs/reference/debugging.md。
import Base.Bool
import Base.IO
import Base.Show

-- 写一行到 stderr 后返回原值（自动补换行；多段内容先自己拼好）。
trace : String -> a -> a
trace msg x =
  let
    _ = runIO (prim_eprint (msg ++ "\n"))
  in x

-- `trace` 的展示版：先 `show` 再写 stderr，返回原值（需要 Show 实例）。
traceShow : Show a => a -> a
traceShow x = trace (show x) x

-- 断言：失败时以 `assertion failed: <msg>` 终止（main 钩子报告；exit 2）。
assert : Bool -> String -> a -> a
assert ok msg x = if ok then x else prim_fail ("assertion failed: " ++ msg)

-- 未实现占位：以 `TODO: <msg>` 终止（同 assert 的报告路径）。
todo : String -> a
todo msg = prim_fail ("TODO: " ++ msg)
