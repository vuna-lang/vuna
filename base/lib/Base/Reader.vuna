module Base.Reader (Reader, ask, local, runReader) where

-- Base.Reader：库级 Reader monad（M33 W6 落地；M35.1 补 Functor/Monad 实例，`do` 可用）。
--
-- 表示是 `e -> a` 的纯函数：handler 就是 `runReader`；`local` 在局部改写环境。
import Base.Monad

record Reader e a where
  readerRun : e -> a

runReader : Reader e a -> e -> a
runReader (Reader f) e = f e

instance Functor (Reader e) where
  fmap f r = Reader (\e => f (r.readerRun e))

instance Monad (Reader e) where
  bind r k = Reader (\e => (k (r.readerRun e)).readerRun e)
  pure a = Reader (\e => a)

ask : Reader e e
ask = Reader (\e => e)

local : (e -> e) -> Reader e a -> Reader e a
local f r = Reader (\e => r.readerRun (f e))
