-- | 可选值类型：`Nothing` 表示无值，`Just x` 表示有值。
module Base.Maybe (Maybe(..), fromMaybe, isJust, isNothing, maybe) where

-- Base.Maybe：可选值类型与消除/映射函数（不依赖 List）。
-- 依赖 Base.Bool 只为让 `data Bool` 声明进入程序：typed codegen 要求
-- 程序里出现 Bool 声明才能生成 True/False 表达式。
import Base.Bool
import Base.Eq
import Base.Hashable
import Base.Foldable
import Base.Monad
import Base.Monoid
import Base.Traversable
import Base.Ord
-- B31：容器 `Show` 实例（`Interp` 由 Base.Interp 的 blanket 实例免费获得）。
import Base.Show

-- | 可选值。
data Maybe a : Type where
  -- | 无值。
  Nothing : Maybe a
  -- | 有值。
  Just : a -> Maybe a

-- | 有值则返回该值，否则返回默认值。
fromMaybe : a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe d (Just x) = x

-- | 是否 `Just`。
isJust : Maybe a -> Bool
isJust Nothing = False
isJust (Just _) = True

-- | 是否 `Nothing`。
isNothing : Maybe a -> Bool
isNothing Nothing = True
isNothing (Just _) = False

-- | 折叠 `Maybe`：默认值与 `Just` 分支函数。
maybe : b -> (a -> b) -> Maybe a -> b
maybe d f Nothing = d
maybe d f (Just x) = f x

-- M11-C：Functor / Monad 实例。trait 来自 Base.Monad，类型 Maybe 定义在本模块，
-- 因此可以写 default（匿名）实例（孤儿规则允许）。
instance Functor Maybe where
  fmap f m = case m of
    Nothing => Nothing
    Just x => Just (f x)

instance Monad Maybe where
  bind m f = case m of
    Nothing => Nothing
    Just x => f x

instance Applicative Maybe where
  pure x = Just x
  liftA2 f ma mb = case ma of
    Nothing => Nothing
    Just a => case mb of
      Nothing => Nothing
      Just b => Just (f a b)

-- B31：容器 `Show` 实例；`Interp` 经 blanket `Show a => Interp a` 自动获得。
-- 这里用 `++` 的反引号形式拼字符串：列表字面量会折叠成 `Cons`/`Nil`，而
-- `Base.List → Base.Maybe` 已存在（Maybe 不能反向 import List），名字不可见；
-- 反引号中缀不要求 fixity 声明，`++` 又是恒可见的 String intrinsic。
instance Show a => Show (Maybe a) where
  show m = case m of
    Nothing => "Nothing"
    Just x => "Just " `++` (show x)

-- 相等：`Nothing` 只等于 `Nothing`，`Just` 比 payload。
instance Eq a => Eq (Maybe a) where
  eq Nothing Nothing = True
  eq (Just x) (Just y) = x == y
  eq _ _ = False
  neq m n = if m == n then False else True

-- 顺序：`Nothing < Just x`，`Just` 之间比 payload。
instance Ord a => Ord (Maybe a) where
  lt Nothing Nothing = False
  lt Nothing (Just _) = True
  lt (Just _) Nothing = False
  lt (Just x) (Just y) = x < y
  le m n = m < n || not (n < m)
  gt m n = n < m
  ge m n = n <= m

instance Hashable a => Hashable (Maybe a) where
  hash m = case m of
    Nothing => 0
    Just x => hashCombine 1 (hash x)

instance Semigroup a => Semigroup (Maybe a) where
  mappend m n = case m of
    Nothing => Nothing
    Just x => case n of
      Nothing => Nothing
      Just y => Just (mappend x y)

instance Monoid a => Monoid (Maybe a) where
  mempty = Just mempty

instance Foldable Maybe where
  fold f z m = case m of
    Nothing => z
    Just x => f x z

instance Applicative f => Traversable Maybe f where
  mapM fun m = case m of
    Nothing => pure Nothing
    Just x => liftA2 (\y, _ => Just y) (fun x) (pure x)
