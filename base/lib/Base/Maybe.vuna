-- | 可选值类型：`Nothing` 表示无值，`Just x` 表示有值。
module Base.Maybe (Maybe(..), fromMaybe, isJust, isNothing, mapJust, maybe) where

-- Base.Maybe：可选值类型与消除/映射函数（不依赖 List）。
-- 依赖 Base.Bool 只为让 `data Bool` 声明进入程序：typed codegen 要求
-- 程序里出现 Bool 声明才能生成 True/False 表达式。
import Base.Bool
import Base.Monad

-- | 可选值。
data Maybe a : Type where
  -- | 无值。
  Nothing : Maybe a
  -- | 有值。
  Just : a -> Maybe a

-- | 有值则返回该值，否则返回默认值。
fromMaybe : a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe d (Just x) = x

-- | 是否 `Just`。
isJust : Maybe a -> Bool
isJust Nothing = False
isJust (Just _) = True

-- | 是否 `Nothing`。
isNothing : Maybe a -> Bool
isNothing Nothing = True
isNothing (Just _) = False

-- | 折叠 `Maybe`：默认值与 `Just` 分支函数。
maybe : b -> (a -> b) -> Maybe a -> b
maybe d f Nothing = d
maybe d f (Just x) = f x

-- | 映射 `Just` 内的值；`Nothing` 保持 `Nothing`。
mapJust : (a -> b) -> Maybe a -> Maybe b
mapJust f Nothing = Nothing
mapJust f (Just x) = Just (f x)

-- M11-C：Functor / Monad 实例。trait 来自 Base.Monad，类型 Maybe 定义在本模块，
-- 因此可以写 default（匿名）实例（孤儿规则允许）。
instance Functor Maybe where
  fmap f m = case m of
    Nothing => Nothing
    Just x => Just (f x)

instance Monad Maybe where
  bind m f = case m of
    Nothing => Nothing
    Just x => f x
  pure x = Just x
