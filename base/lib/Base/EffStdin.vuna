module Base.EffStdin where

-- Base.EffStdin：一阶标准输入效应（P2c：补 readLine / readBytes 标签）。
--
-- 标签 `StdinOp` 是命名实例；操作 ReadLine（读一行，EOF 返回空串）与
-- ReadBytes（最多读 n 字节，n 是度量 → Nat）。真实 handler 直调 `@vuna@prim_eff_*` 实现。
import Base.Eff
import Base.Monad
import Base.Nat

-- | 标准输入操作：`ReadLine` / `ReadBytes`（最多 n 字节）。
export data StdinOp(..) : Type where
  ReadLine : StdinOp
  ReadBytes : Nat -> StdinOp

-- | 操作的结果类型族：两个操作都返回 `String`。
export resStdin : StdinOp -> Type
resStdin ReadLine = String
resStdin (ReadBytes _) = String

-- | 通过命名实例读一行；EOF 返回空串（与空行不可区分）。
export stdinReadLine : Member n StdinOp r => Eff r String
stdinReadLine = sendCore StdinOp "stdin" n ReadLine

-- | 通过命名实例最多读 `k` 个字节；有数据就立即返回（可能少于 k），EOF 返回空串。
export stdinReadBytes : Member n StdinOp r => Nat -> Eff r String
stdinReadBytes k = sendCore StdinOp "stdin" n (ReadBytes k)

-- | 一阶 handler：结果行删除 `StdinOp`。
export handleStdin : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n StdinOp r} -> (a -> b) -> ((o : StdinOp) -> (resStdin o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n StdinOp r) b
handleStdin n ret opH comp = handleCore StdinOp "stdin" n ret opH comp

-- | 真实 handler 的操作解释：读 stdin 后继续。
stdinOpHIO : {a : Type} -> (o : StdinOp) -> (resStdin o -> Eff [] a) -> Eff [] a
stdinOpHIO op k = case op of
  ReadLine => do
    v <- @vuna@prim_eff_readLine
    k v
  ReadBytes n => do
    v <- @vuna@prim_eff_readBytes (natToInt n)
    k v

-- | 宿主 handler：结果行删除 `StdinOp`，answer 是已处理干净的 `Eff []` 动作，可用 `joinEff` 展平。
-- ---------------------------------------------------------------
-- 阶段 3：带行 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
stdinOpHIOHost : {a : Type} -> (o : StdinOp) -> (resStdin o -> Eff (Cons "default" StdinOp []) a) -> Eff (Cons "default" StdinOp []) a
stdinOpHIOHost op k = case op of
  ReadLine => do
    v <- @vuna@host@readLine
    k v
  ReadBytes n => do
    v <- @vuna@host@readBytes (natToInt n)
    k v

handleStdinHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n StdinOp r) a -> Eff r (Eff (Cons "default" StdinOp []) a)
handleStdinHostHost n comp = handleStdin n (\a => pure a) stdinOpHIOHost comp

runStdinHost : {r : Row} -> {a : Type} -> Eff (Cons "default" StdinOp r) a -> Eff (rowAppend r (Cons "default" StdinOp [])) a
runStdinHost comp = joinEff (handleStdinHostHost "default" comp)
