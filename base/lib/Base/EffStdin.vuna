module Base.EffStdin where

-- Base.EffStdin：一阶标准输入效应（P2c：补 readLine / readBytes 标签）。
--
-- 标签 `StdinOp` 是命名实例；操作 ReadLine（读一行，EOF 返回空串）与
-- ReadBytes（最多读 n 字节，n 是度量 → Nat）。真实 handler 直调 `prim_eff_*` 实现。
import Base.Eff
import Base.Monad
import Base.Nat

-- | 标准输入操作：`ReadLine` / `ReadBytes`（最多 n 字节）。
export data StdinOp(..) : Type where
  ReadLine : StdinOp
  ReadBytes : Nat -> StdinOp

-- | 操作的结果类型族：两个操作都返回 `String`。
export resStdin : StdinOp -> Type
resStdin ReadLine = String
resStdin (ReadBytes _) = String

-- | 通过命名实例读一行；EOF 返回空串（与空行不可区分）。
export stdinReadLine : (n : String) -> {r : Row} -> {w : Member n StdinOp r} -> Eff r String
stdinReadLine n = sendCore StdinOp "stdin" n ReadLine

-- | 通过命名实例最多读 `k` 个字节；有数据就立即返回（可能少于 k），EOF 返回空串。
export stdinReadBytes : (n : String) -> Nat -> {r : Row} -> {w : Member n StdinOp r} -> Eff r String
stdinReadBytes n k = sendCore StdinOp "stdin" n (ReadBytes k)

-- | 一阶 handler：结果行删除 `StdinOp`。
export handleStdin : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n StdinOp r} -> (a -> b) -> ((o : StdinOp) -> (resStdin o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n StdinOp r) b
handleStdin n ret opH comp = handleCore StdinOp "stdin" n ret opH comp

-- | 真实 handler 的操作解释：读 stdin 后继续。
stdinOpHIO : {a : Type} -> (o : StdinOp) -> (resStdin o -> Eff [] a) -> Eff [] a
stdinOpHIO op k = case op of
  ReadLine => do
    v <- prim_eff_readLine
    k v
  ReadBytes n => do
    v <- prim_eff_readBytes (natToInt n)
    k v

-- | 宿主 handler：结果行删除 `StdinOp`，answer 是已处理干净的 `Eff []` 动作，可用 `joinEff` 展平。
export handleStdinHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n StdinOp r) a -> Eff r (Eff [] a)
handleStdinHost n comp = handleStdin n (\a => pure a) stdinOpHIO comp

-- | 单效应便捷入口（P3）：`handleStdinHost n` + `joinEff` 的组合。
export runStdin : {a : Type} -> (n : String) -> Eff (Cons n StdinOp []) a -> Eff [] a
runStdin n comp = joinEff (handleStdinHost n comp)
