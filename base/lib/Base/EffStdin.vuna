module Base.EffStdin
  ( Stdin
  , StdinOp(..)
  , handleStdin
  , handleStdinIO
  , resStdin
  , runStdin
  , stdinReadBytes
  , stdinReadLine
  ) where

-- Base.EffStdin：一阶标准输入效应（P2c：补 readLine / readBytes 标签）。
--
-- 标签 `Stdin n` 是命名实例；操作 ReadLine（读一行，EOF 返回空串）与
-- ReadBytes（最多读 n 字节，n 是度量 → Nat）。真实 handler 用 `Base.IO.Host` 实现。
import Base.Eff
import Base.IO.Host
import Base.Monad
import Base.Nat

-- | 标准输入效应的标签类型 `Stdin n`：只做行索引，没有运行时构造子。
data Stdin : String -> Type where

-- | 标准输入操作：`ReadLine` / `ReadBytes`（最多 n 字节）。
data StdinOp : Type where
  ReadLine : StdinOp
  ReadBytes : Nat -> StdinOp

-- | 操作的结果类型族：两个操作都返回 `String`。
resStdin : StdinOp -> Type
resStdin ReadLine = String
resStdin (ReadBytes _) = String

-- | 通过命名实例读一行；EOF 返回空串（与空行不可区分）。
stdinReadLine : (n : String) -> {r : Row} -> {w : Member (Stdin n) r} -> Eff r String
stdinReadLine n = sendCore (Stdin n) "stdin" n ReadLine

-- | 通过命名实例最多读 `k` 个字节；有数据就立即返回（可能少于 k），EOF 返回空串。
stdinReadBytes : (n : String) -> Nat -> {r : Row} -> {w : Member (Stdin n) r} -> Eff r String
stdinReadBytes n k = sendCore (Stdin n) "stdin" n (ReadBytes k)

-- | 一阶 handler：结果行删除 `Stdin n`。
handleStdin : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member (Stdin n) r} -> (a -> b) -> ((o : StdinOp) -> (resStdin o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem (Stdin n) r) b
handleStdin n ret opH comp = handleCore (Stdin n) "stdin" n ret opH comp

-- | 真实 handler 的操作解释：读 stdin 后继续。
stdinOpHIO : {a : Type} -> (o : StdinOp) -> (resStdin o -> IO a) -> IO a
stdinOpHIO op k = case op of
  ReadLine => do
    v <- readLine
    k v
  ReadBytes n => do
    v <- readBytes n
    k v

-- | IO-backed handler：结果行删除 `Stdin n`，answer 是 IO 动作，可交给 `runIOAnswer`。
handleStdinIO : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons (Stdin n) r) a -> Eff r (IO a)
handleStdinIO n comp = handleStdin n (\a => pure a) stdinOpHIO comp

-- | 单效应便捷入口（P3）：`handleStdinIO n` + `runIOAnswer` 的组合。
runStdin : {a : Type} -> (n : String) -> Eff [Stdin n] a -> IO a
runStdin n comp = runIOAnswer (handleStdinIO n comp)
