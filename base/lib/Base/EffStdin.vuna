-- | 一阶标准输入效应：标签 `StdinOp` 是命名实例，操作 `ReadLine`（读一行）与 `ReadBytes`（最多读 n 字节，n 是度量 → `Nat`）。
--
-- 两者在 EOF 时给 `Nothing`，不把 EOF 与空串混成一个值（空行是 `Just ""`）。真实 handler
-- 直调 `@vuna@prim_eff_*`，EOF 由宿主状态槽区分。
module Base.EffStdin where

import Base.Eff
import Base.Eq
import Base.Maybe
import Base.Monad
import Base.Nat

-- | 标准输入操作：`ReadLine` / `ReadBytes`（最多 n 字节）。
export data StdinOp(..) : Type where
  -- | 读一行。
  ReadLine : StdinOp
  -- | 最多读 `n` 字节。
  ReadBytes : Nat -> StdinOp

-- | 操作的结果类型族：两个操作都返回 `Maybe String`（`Nothing` = EOF）。
export resStdin : StdinOp -> Type
resStdin ReadLine = Maybe String
resStdin (ReadBytes _) = Maybe String

-- | 通过命名实例读一行；EOF 给 `Nothing`（空行是 `Just ""`）。
export stdinReadLine : Member n StdinOp r => Eff r (Maybe String)
stdinReadLine = sendCore (Named n StdinOp) "stdin" n ReadLine

-- | 通过命名实例最多读 `k` 个字节；有数据就立即返回（可能少于 k），EOF 给 `Nothing`。
export stdinReadBytes : Member n StdinOp r => Nat -> Eff r (Maybe String)
stdinReadBytes k = sendCore (Named n StdinOp) "stdin" n (ReadBytes k)

-- | 一阶 handler：结果行删除 `StdinOp`。
export handleStdin : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member (Named n StdinOp) r} -> (a -> b) -> ((o : StdinOp) -> (resStdin o -> b) -> b) -> Eff r a -> Eff (rowRem (Named n StdinOp) r) b
handleStdin n ret opH comp = handleCore (Named n StdinOp) "stdin" n ret opH comp

-- | 真实 handler 的操作解释：读 stdin 后继续。
stdinOpHIO : {a : Type} -> (o : StdinOp) -> (resStdin o -> Eff [] a) -> Eff [] a
stdinOpHIO op k = case op of
  ReadLine => do
    v <- @vuna@prim_eff_readLine
    ok <- @vuna@prim_eff_hostStatus
    if ok == 1 then k Nothing else k (Just v)
  ReadBytes n => do
    v <- @vuna@prim_eff_readBytes (natToInt n)
    ok <- @vuna@prim_eff_hostStatus
    if ok == 1 then k Nothing else k (Just v)

-- ---------------------------------------------------------------
-- 带行 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
-- | 带 `StdinOp` 行的 op 解释：宿主原语读入后按状态槽区分 EOF，再写穿继续（answer 行是 `[StdinOp]`）。
stdinOpHIOHost : {a : Type} -> (o : StdinOp) -> (resStdin o -> Eff [StdinOp] a) -> Eff [StdinOp] a
stdinOpHIOHost op k = case op of
  ReadLine => do
    v <- raise @vuna@host@readLine
    ok <- raise @vuna@prim_eff_hostStatus
    if ok == 1 then k Nothing else k (Just v)
  ReadBytes n => do
    v <- raise (@vuna@host@readBytes (natToInt n))
    ok <- raise @vuna@prim_eff_hostStatus
    if ok == 1 then k Nothing else k (Just v)

-- | 带行的宿主 handler：删掉 `StdinOp`，answer 是 `Eff [StdinOp]`（不导出）。
handleStdinHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Named n StdinOp :: r) a -> Eff r (Eff [StdinOp] a)
handleStdinHostHost n comp =
  handleCoreAt (Named n StdinOp) "stdin" n (\a => pure a) stdinOpHIOHost comp

-- | entry 自动预装用（泛化 r）：把行头 `StdinOp` 的 send 翻译成宿主 intrinsic。
runStdinHost : {r : Row} -> {a : Type} -> Eff (Named "default" StdinOp :: r) a -> Eff (rowAppend r [StdinOp]) a
runStdinHost comp = joinEff (handleStdinHostHost "default" comp)
