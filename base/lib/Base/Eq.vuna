module Base.Eq (Eq(..)) where

-- Base.Eq：`Eq` trait 的**声明**（M31.1：trait 声明与实例分离）。
--
-- 实例落点规则：实例跟类型模块走；唯独 `Bool` 是 `Eq` 方法签名的一部分（返回类型），
-- 放 `Base.Bool` 会形成 `Base.Bool ↔ Base.Eq` 的 import 环（Loader 报 ImportCycle），
-- 所以 Bool 实例随 trait 留在本模块。`Int` / `String` 是 language primitive 类型，
-- 实例在 `Base.Int` / `Base.String`。
--
-- `==` / `/=` 是 `eq` / `neq` 的别名：`a == b`、`eq a b` 是同一个调用；Int / String
-- 上的内建特化（`bi_eq_*`）是这两个类的内建实例实现，而不是运算符的独立语义。
-- fixity 与别名的**唯一来源**是本模块的 `infixl` 声明（Loader 在中缀重排时消费，
-- 不再有编译器内建兜底表）。
import Base.Bool

infixl 4 == = eq
infixl 4 /= = neq

trait Eq a where
  eq : a -> a -> Bool
  neq : a -> a -> Bool

-- `Bool` 的相等用模式匹配直接表达（不依赖 `==` / `eq`，避免实例体自引用）。
instance Eq Bool where
  eq True True = True
  eq True False = False
  eq False True = False
  eq False False = True
  neq True True = False
  neq True False = True
  neq False True = True
  neq False False = False
