module Base.Float (FromFloat(..), abs, floatToInt, intToFloat, sqrt) where

-- Base.Float：`Float` primitive 类型的宿主模块（实例 + 字面量转换 trait + 转换 helper）。
--
-- 运行时表示是 OCaml IEEE-754 double（编译器内建；没有 data 声明）。本模块自
-- 2026-11 rotation 起**随 `Prelude` 自动导出**：`FromFloat`、转换 helper 与
-- `Eq` / `Ord` / `Show Float` 实例都不需要显式 import（显式 import 仍允许）。
--
-- 代价：Prelude 闭包包含本模块，`Codegen.Split` 按全部定义扫描浮点用法，因此所有
-- 程序的 `Vuna_runtime.ml` 都会带浮点 helper（原先「no-float 程序逐字节不变」不再
-- 成立）；`Driver/Dt.programUsesFloat` 仍按 main 可达性判定，纯程序的 `vuna interp`
-- 不受影响。细节与 interp 限制见 docs/reference/floats.md。
import Base.Eq
import Base.Num
import Base.Ord
import Base.Show

-- | 把 `Float` 字面量转换为 `a`：期望类型为 `a` 且存在本实例时，`1.5` 等价于
-- `fromFloat 1.5`（与 `FromString` / `FromInt` 同一套 checking 位置降级规则）。
trait FromFloat a where
  fromFloat : Float -> a

-- `Float` 是字面量的默认类型：恒等转换。
instance FromFloat Float where
  fromFloat x = x

instance Eq Float where
  eq x y = x == y
  neq x y = x /= y

instance Ord Float where
  lt x y = x < y
  le x y = x <= y
  gt x y = x > y
  ge x y = x >= y

-- D23 Stage1：`Num` 实例。方法体写内建运算符，由精化器特化成 `bi_*_float`；
-- Stage 2 把 `+` 别名到 `add` 后，特化认 `Base.Num` 方法投影，仍然走原语（不自递归）。
instance Num Float where
  add x y = x + y
  sub x y = x - y
  mul x y = x * y
  div x y = x / y

-- 与 runtime 展示共用同一实现（`string_of_float`）。
instance Show Float where
  show x = strFromFloat x

-- | 浮点绝对值（对应 OCaml `abs_float`）。
abs : Float -> Float
abs = floatAbs

-- | 浮点平方根（对应 OCaml `sqrt`）。
sqrt : Float -> Float
sqrt = floatSqrt

-- | Int → Float（有损：超出 2^53 的整数会舍入；对应 OCaml `float_of_int`）。
intToFloat : Int -> Float
intToFloat = floatFromInt

-- | Float → Int（向零截断；NaN/无穷/超出范围的行为由 OCaml `int_of_float` 决定）。
floatToInt : Float -> Int
floatToInt = intFromFloat
