module Base.Eff.Reader (ReaderOp(..), ask, handleReader, handleReaderLin, local, resReader) where

-- Base.Eff.Reader：一阶 Reader 效应（Layer 1）。
--
-- 标签 = `ReaderOp s`（s 是环境类型，实例名在行的条目里）；同一 s 可以有多个独立
-- 实例，行里以实例名区分：`Cons "counter" (ReaderOp Int) r` / `Cons "config" (ReaderOp Int) r`。
-- 操作只有 `Ask`；结果族 `resReader s Ask = s`。
import Base.Eff
import Base.Monad

-- | reader 操作只有 `Ask`，按环境类型 `s` 参数化。
data ReaderOp : Type -> Type where
  Ask : {s : Type} -> ReaderOp s

-- | 结果族：`Ask` 返回环境 `s`。
resReader : (s : Type) -> ReaderOp s -> Type
resReader s Ask = s

-- | 通过命名实例读环境；行里需要 `Member n (ReaderOp s) r` 证明。
ask : (n : String) -> (s : Type) -> {r : Row} -> {w : Member n (ReaderOp s) r} -> Eff r s
ask n s = sendCore (ReaderOp s) "reader" n Ask

-- | 内部：`local` 的操作解释——`Ask` 返回 `f env`（即在修改后的环境下读）。
readerLocalOp : {s : Type} -> {a : Type} -> (env : s) -> (s -> s) -> (o : ReaderOp s) -> (resReader s o -> a) -> a
readerLocalOp env f op k = case op of
  Ask => k (f env)

-- | 内部：用给定 env 安装一个只对 `comp` 生效的 handler（`weaken` 把结果行放回原行）。
localWith : (n : String) -> (s : Type) -> {a : Type} -> {r : Row} -> (s -> s) -> (env : s) -> Eff (Cons n (ReaderOp s) r) a -> Eff (Cons n (ReaderOp s) r) a
localWith n s f env comp = weaken n (handleReader n s (\a => a) (readerLocalOp env f) comp)

-- | 在 `f` 修改后的环境下运行 `comp`：先 `ask` 取当前 env，再装作用域 handler；改写不逃逸该动作。
local : (n : String) -> (s : Type) -> {a : Type} -> {r : Row} -> (s -> s) -> Eff (Cons n (ReaderOp s) r) a -> Eff (Cons n (ReaderOp s) r) a
local n s f comp = do
  env <- ask n s
  localWith n s f env comp

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `ReaderOp s`。
handleReader : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> (s : Type) -> {w : Member n (ReaderOp s) r} -> (a -> b) -> ((o : ReaderOp s) -> (resReader s o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n (ReaderOp s) r) b
handleReader n s ret opH comp = handleCore (ReaderOp s) "reader" n ret opH comp

-- W7：线性 handler 版本；续延参数是 quantity 1 的 Cont，resume 两次会被用量检查拒绝。
-- | 线性 handler 版：`opH` 的续延是 quantity 1 的 `Cont`，resume 两次会被用量检查拒绝（W7）。
handleReaderLin : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> (s : Type) -> {w : Member n (ReaderOp s) r} -> (a -> b) -> ((o : ReaderOp s) -> (1 k : Cont (resReader s o) b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n (ReaderOp s) r) b
handleReaderLin n s ret opH comp = handleCoreLin (ReaderOp s) "reader" n ret opH comp
