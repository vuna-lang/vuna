module Base.EffEnv where

-- Base.EffEnv：一阶环境效应（W10 效应标签迁移）。
--
-- 标签 = `EnvOp`（实例名在行的 `Cons n EnvOp r` 条目里）；操作 GetEnv / GetCwd / ExecPath 都返回 String。
-- 真实 handler 直调对应 `@vuna@prim_eff_*` 原语（`@vuna@prim_eff_getenv` / `@vuna@prim_eff_getcwd` / `@vuna@prim_eff_execPath`）。
import Base.Eff
import Base.Monad

-- | env 操作：`GetEnv` 带变量名、`GetCwd`、`ExecPath`。
export data EnvOp(..) : Type where
  GetEnv : String -> EnvOp
  GetCwd : EnvOp
  ExecPath : EnvOp

-- | 操作的结果类型族：三个操作都返回 `String`。
export resEnv : EnvOp -> Type
resEnv (GetEnv k) = String
resEnv GetCwd = String
resEnv ExecPath = String

-- | 通过命名实例取环境变量；真实 handler 走 `@vuna@prim_eff_getenv`（未设置或为空串都返回空串）。
export envGetEnv : Member n EnvOp r => String -> Eff r String
envGetEnv k = sendCore EnvOp "env" n (GetEnv k)

-- | 通过命名实例取当前工作目录。
export envGetCwd : Member n EnvOp r => Eff r String
envGetCwd = sendCore EnvOp "env" n GetCwd

-- | 通过命名实例取可执行文件路径。
export envExecPath : Member n EnvOp r => Eff r String
envExecPath = sendCore EnvOp "env" n ExecPath

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `EnvOp`。
export handleEnv : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n EnvOp r} -> (a -> b) -> ((o : EnvOp) -> (resEnv o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n EnvOp r) b
handleEnv n ret opH comp = handleCore EnvOp "env" n ret opH comp

-- | 真实 handler 的操作解释：把三个操作映射到 `@vuna@prim_eff_getenv` / `@vuna@prim_eff_getcwd` / `@vuna@prim_eff_execPath`。
envOpHIO : {a : Type} -> (o : EnvOp) -> (resEnv o -> Eff [] a) -> Eff [] a
envOpHIO op k = case op of
  GetEnv name => do
    v <- @vuna@prim_eff_getenv name
    k v
  GetCwd => do
    v <- @vuna@prim_eff_getcwd
    k v
  ExecPath => do
    v <- @vuna@prim_eff_execPath
    k v

-- | 宿主 handler：结果行删除 `EnvOp`，answer 是已处理干净的 `Eff []` 动作，可用 `joinEff` 展平。
-- ---------------------------------------------------------------
-- 阶段 3：带行 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
envOpHIOHost : {a : Type} -> (o : EnvOp) -> (resEnv o -> Eff (Cons "default" EnvOp []) a) -> Eff (Cons "default" EnvOp []) a
envOpHIOHost op k = case op of
  GetEnv name => do
    v <- @vuna@host@getenv name
    k v
  GetCwd => do
    v <- @vuna@host@getcwd
    k v
  ExecPath => do
    v <- @vuna@host@execPath
    k v

handleEnvHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n EnvOp r) a -> Eff r (Eff (Cons "default" EnvOp []) a)
handleEnvHostHost n comp = handleEnv n (\a => pure a) envOpHIOHost comp

runEnvHost : {r : Row} -> {a : Type} -> Eff (Cons "default" EnvOp r) a -> Eff (rowAppend r (Cons "default" EnvOp [])) a
runEnvHost comp = joinEff (handleEnvHostHost "default" comp)
