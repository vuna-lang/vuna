module Base.EffEnv
  ( Env
  , EnvOp(..)
  , envExecPath
  , envGetCwd
  , envGetEnv
  , handleEnv
  , handleEnvHost
  , resEnv
  , runEnv
  ) where

-- Base.EffEnv：一阶环境效应（W10 IO 标签迁移）。
--
-- 标签 `Env n` 是命名实例；操作 GetEnv / GetCwd / ExecPath 都返回 String。
-- 真实 handler 用 `Base.IO` 的 `getEnv` / `getCwd` / `execPath` 实现。
import Base.Eff
import Base.Host
import Base.Monad

-- | env 效应的标签类型 `Env n`：只做行索引，没有运行时构造子。
data Env : String -> Type where

-- | env 操作：`GetEnv` 带变量名、`GetCwd`、`ExecPath`。
data EnvOp : Type where
  GetEnv : String -> EnvOp
  GetCwd : EnvOp
  ExecPath : EnvOp

-- | 操作的结果类型族：三个操作都返回 `String`。
resEnv : EnvOp -> Type
resEnv (GetEnv k) = String
resEnv GetCwd = String
resEnv ExecPath = String

-- | 通过命名实例取环境变量；真实 handler 走 `Base.IO.getEnv`（未设置或为空串都返回空串）。
envGetEnv : (n : String) -> String -> {r : Row} -> {w : Member n (Env n) r} -> Eff r String
envGetEnv n k = sendCore (Env n) "env" n (GetEnv k)

-- | 通过命名实例取当前工作目录。
envGetCwd : (n : String) -> {r : Row} -> {w : Member n (Env n) r} -> Eff r String
envGetCwd n = sendCore (Env n) "env" n GetCwd

-- | 通过命名实例取可执行文件路径。
envExecPath : (n : String) -> {r : Row} -> {w : Member n (Env n) r} -> Eff r String
envExecPath n = sendCore (Env n) "env" n ExecPath

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `Env n`。
handleEnv : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n (Env n) r} -> (a -> b) -> ((o : EnvOp) -> (resEnv o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n (Env n) r) b
handleEnv n ret opH comp = handleCore (Env n) "env" n ret opH comp

-- | 真实 handler 的操作解释：把三个操作映射到 `Base.IO` 的 `getEnv` / `getCwd` / `execPath`。
envOpHIO : {a : Type} -> (o : EnvOp) -> (resEnv o -> Eff [] a) -> Eff [] a
envOpHIO op k = case op of
  GetEnv name => do
    v <- getEnv name
    k v
  GetCwd => do
    v <- getCwd
    k v
  ExecPath => do
    v <- execPath
    k v

-- | IO-backed handler：结果行删除 `Env n`，answer 是 IO 动作，可交给 `runIOAnswer`。
handleEnvHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n (Env n) r) a -> Eff r (Eff [] a)
handleEnvHost n comp = handleEnv n (\a => pure a) envOpHIO comp

-- | 单效应便捷入口（P3）：`handleEnvHost n` + `runIOAnswer` 的组合。
runEnv : {a : Type} -> (n : String) -> Eff [Env n] a -> Eff [] a
runEnv n comp = joinEff (handleEnvHost n comp)
