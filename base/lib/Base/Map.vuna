module Base.Map where

-- Base.Map：基于 assoc list 的抽象映射类型。
-- 模块头只导出 Map（不含构造器 Map），跨模块只能通过 API 使用。
--
-- 辅助函数必须定义在公开函数**之前**：`_insertPair` 的 `==` 会把 `Dict_Eq k` 提升成
-- 隐式参数，调用点要看到提升后的签名才能补字典实参（前向引用看到的是旧签名）。
import Base.List
import Base.Pair
import Base.Maybe
import Base.Nat
-- M24.7：`_insertPair` 等对刚性 key 的 `==` 提升成 Dict_Eq（见上），显式 import 保证
-- 类存在与 split 单元顺序。
import Base.Eq
import Base.Show

-- | 基于 assoc list 的持久映射，内部就是 `List (Pair k v)`；构造器不导出，只能经本模块 API 使用（`k` 需 `Eq`）。`lookup` 命中第一个匹配键，`insert` 覆盖时保留原位置。
export record Map k v where
  toList : List (Pair k v)

_insertPair : Eq k => k -> v -> List (Pair k v) -> List (Pair k v)
_insertPair key value [] = [Pair key value]
_insertPair key value ((Pair k2 v2) :: rest) =
  if k2 == key then Pair key value :: rest else Pair k2 v2 :: _insertPair key value rest

_lookupPair : Eq k => k -> List (Pair k v) -> Maybe v
_lookupPair key [] = Nothing
_lookupPair key ((Pair k2 v2) :: rest) = if k2 == key then Just v2 else _lookupPair key rest

_removePair : Eq k => k -> List (Pair k v) -> List (Pair k v)
_removePair key [] = []
_removePair key ((Pair k2 v2) :: rest) =
  if k2 == key then rest else Pair k2 v2 :: _removePair key rest

-- | 空映射。
export empty : Map k v
empty = Map []

-- | 插入键 `key` 的值；键已存在时覆盖值（位置保留为首次出现处）。
export insert : Eq k => k -> v -> Map k v -> Map k v
insert key value (Map pairs) = Map (_insertPair key value pairs)

-- | 按键查找，返回 `Maybe v`；`Nothing` 表示无此键。
export lookup : Eq k => k -> Map k v -> Maybe v
lookup key (Map pairs) = _lookupPair key pairs

-- | 删除键 `key`；键不存在时原样返回。
export remove : Eq k => k -> Map k v -> Map k v
remove key (Map pairs) = Map (_removePair key pairs)

-- | 所有键（按内部关联表顺序，可能含重复键）。
export keys : Map k v -> List k
keys (Map pairs) = map firstOf pairs

-- | 所有值（与 `keys` 同序）。
export values : Map k v -> List v
values (Map pairs) = map secondOf pairs

-- | 键值对个数（`Nat`，线性计数）。
export size : Map k v -> Nat
size (Map pairs) = length pairs

-- | 从 `Pair` 列表直接构造，**不去重也不排序**；有重复键时 `lookup` 命中第一个。
export fromList : List (Pair k v) -> Map k v
fromList pairs = Map pairs

-- | 原样取回内部 `Pair` 列表（`fromList` 的逆操作，可能含重复键）。
export toList : Map k v -> List (Pair k v)
toList (Map pairs) = pairs

-- `Show` 经 `toList`：`Map` 构造器不导出，跨模块不能模式匹配。用反引号 `++`
-- 拼字符串（本模块不 import Base.String，没有 `++` 的 fixity 声明）。
instance Show k, Show v => Show (Map k v) where
  show m = "fromList " `++` (show (toList m))
