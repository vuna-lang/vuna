module Base.Map (Map, empty, insert, lookup, remove, keys, values, size, fromList, toList) where

-- Base.Map：基于 assoc list 的抽象映射类型。
-- 模块头只导出 Map（不含构造器 MkMap），跨模块只能通过 API 使用。
import Base.List
import Base.Pair
import Base.Maybe

data Map k v : Type where
  MkMap : List (Pair k v) -> Map k v

empty : Map k v
empty = MkMap []

insert : k -> v -> Map k v -> Map k v
insert key value (MkMap pairs) = MkMap (_insertPair key value pairs)

lookup : k -> Map k v -> Maybe v
lookup key (MkMap pairs) = _lookupPair key pairs

remove : k -> Map k v -> Map k v
remove key (MkMap pairs) = MkMap (_removePair key pairs)

keys : Map k v -> List k
keys (MkMap pairs) = map firstOf pairs

values : Map k v -> List v
values (MkMap pairs) = map secondOf pairs

size : Map k v -> Int
size (MkMap pairs) = length pairs

fromList : List (Pair k v) -> Map k v
fromList pairs = MkMap pairs

toList : Map k v -> List (Pair k v)
toList (MkMap pairs) = pairs

_insertPair : k -> v -> List (Pair k v) -> List (Pair k v)
_insertPair key value [] = [Pair key value]
_insertPair key value ((Pair k2 v2) :: rest) =
  if k2 == key then Pair key value :: rest else Pair k2 v2 :: _insertPair key value rest

_lookupPair : k -> List (Pair k v) -> Maybe v
_lookupPair key [] = Nothing
_lookupPair key ((Pair k2 v2) :: rest) = if k2 == key then Just v2 else _lookupPair key rest

_removePair : k -> List (Pair k v) -> List (Pair k v)
_removePair key [] = []
_removePair key ((Pair k2 v2) :: rest) =
  if k2 == key then rest else Pair k2 v2 :: _removePair key rest
