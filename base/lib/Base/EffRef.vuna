module Base.EffRef (RefOp(..), refNew, refRead, refWrite) where

-- Base.EffRef：带内建 Ref 行的可变引用（阶段 4）。
--
-- 操作直调带行宿主原语（`prim_eff_*Ref_host`），不经过 sendCore/handler：Ref 是
-- 运行时机制，不提供 mock；`RefOp` 只是行标签，让 `Eff []` 不能执行 ref 操作。
-- 旧的 `Base.IORef`（`Eff []`）保留给编译器/工具链内部。
import Base.Eff

-- | Ref 行标签（无载荷；操作直接映射到带行原语）。
data RefOp : Type where
  RefTag : RefOp

-- | 创建引用（带 `RefOp` 行）。
refNew : a -> Eff [RefOp] (IORef a)
refNew x = prim_eff_newRef_host x

-- | 读引用（带 `RefOp` 行）。
refRead : IORef a -> Eff [RefOp] a
refRead r = prim_eff_readRef_host r

-- | 写引用，返回底层原语的 `Int`（带 `RefOp` 行）。
refWrite : IORef a -> a -> Eff [RefOp] Int
refWrite r v = prim_eff_writeRef_host r v
