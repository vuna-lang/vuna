module Base.ErrorT (ErrorT, catchError, runErrorT, throwError) where

-- Base.ErrorT：IO 之上的 Error 效应（M37 效应栈）。
--
-- `ErrorT e a` 包 `IO (Error e a)`：handler 是 `runErrorT`；`throwError` /
-- `catchError` 是 transformer 版本（与 `Base.Error` 的纯版同名，同时使用时写限定名）。
-- `Base.Error` 只导出 `ok` / `throwError` 等构造面，不暴露 `MkOk` / `MkErr`，这里用
-- `runError` + `ok` / `throwError` 组合。`MonadIO (ErrorT e)` 让 IO 动作经 `liftIO`
-- 进入本层。边界同 StateT：固定以 IO 为基座（record 参数的 kind 限制）。
import Base.Effect
import Base.Error
import Base.IO.Host
import Base.Monad

-- | IO 之上的 Error 效应 transformer：`ErrorT e a` 包一个 `IO (Error e a)`；固定以 IO 为基座（record 参数的 kind 限制）。
record ErrorT e a where
  errorTRun : IO (Error e a)

-- | handler：取出底层 `IO (Error e a)` 动作，由 `Base.Error.runError` 折叠。
runErrorT : ErrorT e a -> IO (Error e a)
runErrorT t = t.errorTRun

-- | 在本层抛出错误（transformer 版；与 `Base.Error.throwError` 同名，同时使用时写限定名）。
throwError : e -> ErrorT e a
throwError e = ErrorT (pure (Base.Error.throwError e))

-- | 在本层恢复错误：成功透传，`MkErr e` 时交给 handler `h`。
catchError : ErrorT e a -> (e -> ErrorT e a) -> ErrorT e a
catchError t h =
  ErrorT (t.errorTRun >>= (\r => runError r (\e => (h e).errorTRun) (\a => pure (Base.Error.ok a))))

instance Functor (ErrorT e) where
  fmap f t =
    ErrorT
      (t.errorTRun >>= (\r => runError r (\e => pure (Base.Error.throwError e)) (\a => pure (Base.Error.ok (f a)))))

instance Monad (ErrorT e) where
  bind t k =
    ErrorT
      (t.errorTRun >>= (\r => runError r (\e => pure (Base.Error.throwError e)) (\a => (k a).errorTRun)))

instance Applicative (ErrorT e) where
  pure a = ErrorT (pure (Base.Error.ok a))
  liftA2 f ta tb =
    ErrorT
      (ta.errorTRun >>= (\ra => runError ra (\e => pure (Base.Error.throwError e)) (\a => tb.errorTRun >>= (\rb => runError rb (\e => pure (Base.Error.throwError e)) (\b => pure (Base.Error.ok (f a b)))))))

instance MonadIO (ErrorT e) where
  liftIO io = ErrorT (io >>= (\a => pure (Base.Error.ok a)))
