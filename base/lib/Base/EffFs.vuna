module Base.EffFs where

-- Base.EffFs：一阶文件系统效应（Layer 1 的宿主-backed 示例；W10 扩到完整 fs 面）。
--
-- 操作是描述；真实 handler 直调 `@vuna@prim_eff_*` 原语实现语义。answer 是 `Eff [] a`，
-- 由 `joinEff` 展平（见 Base.Eff）。`handleFsHost` 是 W10 增加的
-- 可直接 `joinEff` 展平的宿主 handler。
--
-- W10 收尾：`Fs` 改为**命名实例**（`FsOp`，n 是 String 实例名，与 Console/Clock/Env/
-- Process 一致）。同一个程序因此可以同时装 mock handler（如纯 answer 的内存表）与
-- 真实宿主 handler（`handleFsHost "real"`），或用两个 mock 实例做对照；行条目按实例名区分。
-- 所有操作与 handler 都显式带实例名（夹具 dt_base/18、29、40）。
import Base.Eff
import Base.Nat
import Base.Monad
import Base.Bool
import Base.List

-- | fs 操作描述：读 / 写 / 原子写 / 列目录 / 判目录 / 建目录 / 删文件 / 存在性 / mtime / size，各带路径参数。
export data FsOp(..) : Type where
  ReadFile : String -> FsOp
  WriteFile : String -> String -> FsOp
  WriteFileAtomic : String -> String -> FsOp
  ReadDir : String -> FsOp
  IsDirectory : String -> FsOp
  MakeDir : String -> FsOp
  RemoveFile : String -> FsOp
  FileExists : String -> FsOp
  FileMtime : String -> FsOp
  FileSize : String -> FsOp

-- | 操作的结果类型族：读文件 `String`、读目录 `List String`、布尔查询 `Bool`，其余（写入 / 删除 / 元数据）返回 `Int`。
export resFs : FsOp -> Type
resFs (ReadFile p) = String
resFs (WriteFile p s) = Nat
resFs (WriteFileAtomic p s) = Int
resFs (ReadDir p) = List String
resFs (IsDirectory p) = Bool
resFs (MakeDir p) = Int
resFs (RemoveFile p) = Int
resFs (FileExists p) = Bool
resFs (FileMtime p) = Int
resFs (FileSize p) = Nat

-- | 通过命名实例读整个文件为 String；真实 handler 走 `@vuna@prim_eff_readFile`。
export fsReadFile : Member n FsOp r => String -> Eff r String
fsReadFile p = sendCore FsOp "fs" n (ReadFile p)

-- | 通过命名实例把整串写入文件，返回写入字节数（`Nat`，D25）。
export fsWriteFile : Member n FsOp r => String -> String -> Eff r Nat
fsWriteFile p s = sendCore FsOp "fs" n (WriteFile p s)

-- | 通过命名实例原子写（写临时文件后 rename）：并发读者只会看到完整旧内容或完整新内容。
export fsWriteFileAtomic : Member n FsOp r => String -> String -> Eff r Int
fsWriteFileAtomic p s = sendCore FsOp "fs" n (WriteFileAtomic p s)

-- | 通过命名实例列目录（真实 handler 按字符串排序；目录不存在时抛宿主异常）。
export fsReadDir : Member n FsOp r => String -> Eff r (List String)
fsReadDir p = sendCore FsOp "fs" n (ReadDir p)

-- | 通过命名实例判断是否目录（真实 handler 对不存在的路径抛宿主异常）。
export fsIsDirectory : Member n FsOp r => String -> Eff r Bool
fsIsDirectory p = sendCore FsOp "fs" n (IsDirectory p)

-- | 通过命名实例建目录（幂等，已存在时返回 0）。
export fsMakeDir : Member n FsOp r => String -> Eff r Int
fsMakeDir p = sendCore FsOp "fs" n (MakeDir p)

-- | 通过命名实例删文件（幂等，不存在时返回 0）。
export fsRemoveFile : Member n FsOp r => String -> Eff r Int
fsRemoveFile p = sendCore FsOp "fs" n (RemoveFile p)

-- | 通过命名实例判断路径是否存在（不存在返回 False，不抛异常）。
export fsFileExists : Member n FsOp r => String -> Eff r Bool
fsFileExists p = sendCore FsOp "fs" n (FileExists p)

-- | 通过命名实例取 mtime（秒级）；取不到时静默返回 0。
export fsFileMtime : Member n FsOp r => String -> Eff r Int
fsFileMtime p = sendCore FsOp "fs" n (FileMtime p)

-- | 通过命名实例取文件字节数（`Nat`，D25）；取不到时静默返回 0。
export fsFileSize : Member n FsOp r => String -> Eff r Nat
fsFileSize p = sendCore FsOp "fs" n (FileSize p)

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `FsOp`。
export handleFs : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n FsOp r} -> (a -> b) -> ((o : FsOp) -> (resFs o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n FsOp r) b
handleFs n ret opH comp = handleCore FsOp "fs" n ret opH comp

-- | 真实 handler 的操作解释：把每个操作映射到对应 `@vuna@prim_eff_*` 原语（`WriteFile` / `FileSize` 的结果在边界转回 `Nat`）。
fsOpHIO : {a : Type} -> (o : FsOp) -> (resFs o -> Eff [] a) -> Eff [] a
fsOpHIO op k = case op of
  ReadFile p => do
    s <- @vuna@prim_eff_readFile p
    k s
  WriteFile p s => do
    n <- fmap natFromInt (@vuna@prim_eff_writeFile p s)
    k n
  WriteFileAtomic p s => do
    n <- @vuna@prim_eff_writeFileAtomic p s
    k n
  ReadDir p => do
    xs <- @vuna@prim_eff_readDir p
    k xs
  IsDirectory p => do
    b <- @vuna@prim_eff_isDirectory p
    k b
  MakeDir p => do
    n <- @vuna@prim_eff_makeDir p
    k n
  RemoveFile p => do
    n <- @vuna@prim_eff_removeFile p
    k n
  FileExists p => do
    b <- @vuna@prim_eff_fileExists p
    k b
  FileMtime p => do
    n <- @vuna@prim_eff_fileMtime p
    k n
  FileSize p => do
    n <- fmap natFromInt (@vuna@prim_eff_fileSize p)
    k n

-- ---------------------------------------------------------------
-- 阶段 3：带行的真实 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
-- | 带 `FsOp` 行的 op 解释：映射到对应 `@vuna@prim_eff_*_host` 原语。
fsOpHIOHost : {a : Type} -> (o : FsOp) -> (resFs o -> Eff (Cons "default" FsOp []) a) -> Eff (Cons "default" FsOp []) a
fsOpHIOHost op k = case op of
  ReadFile p => do
    s <- @vuna@host@readFile p
    k s
  WriteFile p s => do
    n <- fmap natFromInt (@vuna@host@writeFile p s)
    k n
  WriteFileAtomic p s => do
    n <- @vuna@host@writeFileAtomic p s
    k n
  ReadDir p => do
    xs <- @vuna@host@readDir p
    k xs
  IsDirectory p => do
    b <- @vuna@host@isDirectory p
    k b
  MakeDir p => do
    n <- @vuna@host@makeDir p
    k n
  RemoveFile p => do
    n <- @vuna@host@removeFile p
    k n
  FileExists p => do
    b <- @vuna@host@fileExists p
    k b
  FileMtime p => do
    n <- @vuna@host@fileMtime p
    k n
  FileSize p => do
    n <- fmap natFromInt (@vuna@host@fileSize p)
    k n

-- | 带行的宿主 handler：删掉 `FsOp`，answer 是 `Eff [FsOp]`（不导出）。
handleFsHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n FsOp r) a -> Eff r (Eff (Cons "default" FsOp []) a)
handleFsHostHost n comp = handleFs n (\a => pure a) fsOpHIOHost comp

-- | entry 自动预装用（泛化 r）：把行头 `FsOp` 的 send 翻译成宿主 intrinsic。
runFsHost : {r : Row} -> {a : Type} -> Eff (Cons "default" FsOp r) a -> Eff (rowAppend r (Cons "default" FsOp [])) a
runFsHost comp = joinEff (handleFsHostHost "default" comp)
