module Base.IO.Host
  ( eprint
  , execPath
  , exit
  , fileExists
  , fileMtime
  , fileSize
  , getArgs
  , getCwd
  , getEnv
  , isDirectory
  , makeDir
  , nowMicros
  , print
  , println
  , readBytes
  , readDir
  , readFile
  , readLine
  , removeFile
  , runIO
  , sleepMicros
  , writeFile
  , module Base.IO
  ) where

-- Base.IO.Host：**宿主层**（F3 P2）。只有 `[package] privileged = true` 的包可以
-- import 本模块（`Loader.Flatten` 按 `[package] privileged` 拒绝非特权 import，
-- 错误码 `LD_HostModulePrivileged`）。
--
-- 这里放 `runIO` 与宿主别名（console/fs/process/env/clock 的 `prim_*` 包装）：
--   * base 的真实 handler（`Base.EffConsole` / `Base.EffFs` / …）、`Base.ST`、
--     `Base.IORef` 等实现层；
--   * `vuna-compiler` 与根包工具链。
--
-- 用户面（无特权包 / ad-hoc）只有 `Base.IO` 的 IO 代数/实例 + `Eff r a`；宿主效应
-- 经 `Base.Eff.*` 标签与 handler 表达，运行入口用 `runIOEff : Eff [] a -> IO a`。
-- 本模块 re-export `Base.IO`，所以特权包 `import Base.IO.Host` 即可拿到代数。
import Base.IO
import Base.List
import Base.Bool
import Base.Applicative
import Base.Monad
-- sleepMicros 用 `<=` / `>=`（Ord 方法别名）。
import Base.Ord
-- 模板字符串与 `++` 降级依赖 Base.Interp / Base.String。
import Base.Interp
import Base.String
import Base.Nat

-- 特权执行入口：`prim_runIO` 拿到世界令牌 0 立即执行；能力门控在 Loader.Resolve，
-- 标签名 `Base.IO.Host.runIO` 同时是 base `[trust] unsafe` 的执行入口审计点。
-- | 唯一的 main 外执行入口（`prim_runIO`）：拿世界令牌立即执行动作，需 `unsafe` 能力（门控在 Loader.Resolve）；每次调用都重新执行动作、效果不缓存。
runIO : IO a -> a
runIO = prim_runIO

-- 效果 API：直接别名到 IO 化的原语（M31）。
-- | 向 stdout 写字符串并 flush（不自动换行），返回写入的字节数（`Nat`，D25）。
-- 低层 `prim_print` 仍是 `IO Int`（内部字节计数保留 Int，避免 seed 自举死锁，
-- 见 primitives.md §3.1），所以这里用 `natFromInt` 在边界把它变成 `Nat`。
print : String -> IO Nat
print s = fmap natFromInt (prim_print s)

-- 写 stderr（W10：console 效应标签的真实 handler 用；与 print 对称）。
-- | 向 stderr 写字符串（不自动换行），返回写入的字节数；与 `print` 对称。
eprint : String -> IO Int
eprint = prim_eprint

-- | 向 stdout 写字符串并补 `\n`（返回写入的字节数，`Nat`）。
println : String -> IO Nat
println s = print "${s}\n"

-- | 把整个文件读成字符串（按字节，不做编码转换）；IO 失败抛宿主异常。
readFile : String -> IO String
readFile = prim_readFile

-- | 把整串二进制写入文件，返回写入字节数（`Nat`，D25）；IO 失败抛宿主异常。
-- 低层 `prim_writeFile` 仍是 `IO Int`（原因同 `print`），边界处 `natFromInt`。
writeFile : String -> String -> IO Nat
writeFile path s = fmap natFromInt (prim_writeFile path s)

-- | 从 stdin 读一行；EOF 返回空串（与空行不可区分）。
readLine : IO String
readLine = prim_readLine

-- 字节级读取（LSP 帧）：最多读 n 字节；n 是度量 → Nat。
-- | 最多读 `n` 个字节并返回字符串（LSP 帧读取用）；有数据就立即返回（可能少于 n），EOF 返回空串。
readBytes : Nat -> IO String
readBytes n = prim_readBytes (natToInt n)

-- | 列出目录项，按字符串排序；目录不存在 / 不可读时抛宿主异常。
readDir : String -> IO (List String)
readDir = prim_readDir

-- | 路径是否为目录；**不存在**的路径抛宿主异常（`Sys_error` → `failwith`）。
isDirectory : String -> IO Bool
isDirectory = prim_isDirectory

-- | 创建目录，返回底层 `Int` 结果；幂等（已存在返回 `0`）。
makeDir : String -> IO Int
makeDir = prim_makeDir

-- | 删除文件，返回底层 `Int` 结果；幂等（不存在返回 `0`）。
removeFile : String -> IO Int
removeFile = prim_removeFile

-- | 路径是否存在（不存在为 `False`，不抛异常）。
fileExists : String -> IO Bool
fileExists = prim_fileExists

-- 文件元数据（工具链）：秒级 mtime 与字节数；路径不存在时都返回 0。
-- 供索引器判断「源码是否变化」，避免每次重算内容摘要。
-- | 文件 mtime（秒级）；取不到（含文件不存在）时静默返回 0。供索引器判断源码是否变化。
fileMtime : String -> IO Int
fileMtime = prim_fileMtime

-- | 文件字节数（`Nat`）；取不到（含文件不存在）时静默返回 0。
fileSize : String -> IO Nat
fileSize path = fmap natFromInt (prim_fileSize path)

-- | 命令行参数（不含 `argv[0]`）。
getArgs : IO (List String)
getArgs = prim_getArgs

-- 环境（W10：env 效应标签的真实 handler 用）。getEnv 对不存在的变量返回 ""。
-- | 读环境变量；未设置或为空串都返回 `""`（两者不可区分）。
getEnv : String -> IO String
getEnv = prim_getenv

-- | 当前工作目录；失败时返回 `"."`。
getCwd : IO String
getCwd = prim_getcwd

-- | 当前可执行文件路径：先读 `/proc/self/exe`（Linux 假设），失败回落 `Sys.executable_name`。
execPath : IO String
execPath = prim_execPath

-- | 以给定状态码立即退出进程（原语类型 `Int -> IO Int`，执行即退出、不返回）。
exit : Int -> IO Int
exit = prim_exit

-- 时钟（W10：clock 效应标签的真实 handler 用）。nowMicros 是微秒时间戳；
-- sleepMicros 走编译器原生 `prim_sleep`（`Unix.sleepf`），阻塞睡眠。
-- | 当前时间戳（微秒，`Unix.gettimeofday`）。
nowMicros : IO Int
nowMicros = timeUs

-- | 阻塞睡眠 `us` 微秒（真实睡眠，非忙等）；`us <= 0` 时直接返回 `0`。
sleepMicros : Int -> IO Int
sleepMicros us = if us <= 0 then prim_pureIO 0 else prim_sleep us
