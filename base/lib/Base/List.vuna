-- | 列表类型与常用操作。
module Base.List
  ( List(..)
  , append
  , concatMap
  , drop
  , filter
  , foldl
  , foldr
  , length
  , lookupPair
  , map
  , mapMaybe
  , mem
  , memName
  , range
  , reverse
  , take
  , zip
  ) where

-- Base.List：列表类型与常用操作（Base 语义迁移 + 常用补充）。
-- import Base.Bool 只为让 `data Bool` 声明进入程序（typed codegen 生成 True/False 表达式所需）。
import Base.Pair
import Base.Maybe
import Base.Nat
import Base.Bool
import Base.Foldable
import Base.Monad
import Base.Monoid
import Base.Traversable
-- M24.7：`mem` 的 `==` 在刚性类型上提升成 Dict_Eq；显式 import Base.Eq 既保证类存在，
-- 也让 split 产物有正确的单元依赖顺序（生成代码引用 Base.Eq.eq 投影）。
import Base.Eq
import Base.Hashable
-- M31.1：`==` / `<=` 是 Eq / Ord 方法名的别名，base 模块不自动注入 Prelude，
-- 因此 take/drop/rangeFrom 的 `<=` 需要 Ord 方法名可见。
import Base.Ord
-- `+` / `-` 的 fixity 声明在 Base.Int；base 模块不自动注入 Prelude，
-- range 的算术需要它的声明进入 import 闭包。
import Base.Int
import Base.Show

-- `::` 是 canonical 构造子 `Cons` 的中缀别名（表达式与 pattern 都走这条声明）。
infixr 5 :: = Cons

-- | 列表类型。
data List a : Type where
  -- | 空列表。
  Nil : List a
  -- | 非空列表：头 `a` 与尾 `List a`。
  Cons : a -> List a -> List a

-- | 拼接两个列表。
append : List a -> List a -> List a
append [] ys = ys
append (x :: xs) ys = x :: append xs ys

-- | 内部：把 `xs` 逆序前插到 `acc` 上（尾递归，供 `reverse` / `concatMapGo` 复用）。
reverseOnto : List a -> List a -> List a
reverseOnto [] acc = acc
reverseOnto (x :: xs) acc = reverseOnto xs (x :: acc)

-- | 反转列表。
reverse : List a -> List a
reverse xs = reverseOnto xs []

-- 度量是 Nat；实现内部用 Int 累加，末尾一次 natFromInt，避免逐元素 Nat 加法。
-- | 列表长度（`Nat`）。
length : List a -> Nat
length xs = natFromInt (lengthInt xs)

-- | 内部：以 `Int` 累加的列表长度（`length` 的实现，末尾一次 `natFromInt`，避免逐元素 Nat 加法）。
lengthInt : List a -> Int
lengthInt [] = 0
lengthInt (x :: xs) = 1 + lengthInt xs

-- | 对每个元素应用函数。
map : (a -> b) -> List a -> List b
map f [] = []
map f (x :: xs) = f x :: map f xs

-- | 保留满足谓词的元素。
filter : (a -> Bool) -> List a -> List a
filter p [] = []
filter p (x :: xs) = if p x then x :: filter p xs else filter p xs

-- | 左折叠。
foldl : (b -> a -> b) -> b -> List a -> b
foldl f acc [] = acc
foldl f acc (x :: xs) = foldl f (f acc x) xs

-- | 右折叠。
foldr : (a -> b -> b) -> b -> List a -> b
foldr f acc [] = acc
foldr f acc (x :: xs) = f x (foldr f acc xs)

-- M33 W2：原来的 `append (f x) (concatMap f rest)` 在「每段都较长」时是 O(n²)
-- （每层 append 复制 f x）。改成尾递归 accumulator：把每段逆序前插，最后整体 reverse，
-- 总代价 O(所有段长之和)。终止性仍是结构递归（rest）。
-- | 对每个元素执行返回列表的函数并拼接。
concatMap : (a -> List b) -> List a -> List b
concatMap f xs = concatMapGo f xs []

-- | 内部：`concatMap` 的尾递归 accumulator 实现。每段逆序前插进 `acc`，最后整体 `reverse`，总代价 O(所有段长之和)。
concatMapGo : (a -> List b) -> List a -> List b -> List b
concatMapGo f [] acc = reverse acc
concatMapGo f (x :: rest) acc = concatMapGo f rest (append (reverse (f x)) acc)

-- | 列表成员判断（`Eq` 字典）。
mem : Eq a => a -> List a -> Bool
mem x [] = False
mem x (y :: rest) = x == y || mem x rest

-- | 字符串列表成员判断（`Eq` 的 String 特化）。
memName : String -> List String -> Bool
memName name [] = False
memName name (x :: rest) = x == name || memName name rest

-- | 按键查找 `Pair` 列表中的值。
lookupPair : String -> List (Pair String v) -> Maybe v
lookupPair name [] = Nothing
lookupPair name (p :: rest) = if firstOf p == name then Just (secondOf p) else lookupPair name rest

-- | 把两个列表逐项配对；长度取较短者。
zip : List a -> List b -> List (Pair a b)
zip (x :: xs) (y :: ys) = Pair x y :: zip xs ys
zip _ _ = []

-- | 取前 `n` 个元素（不足则返回全部）。
take : Int -> List a -> List a
take n [] = []
take n (x :: xs) = if n <= 0 then [] else x :: take (n - 1) xs

-- | 丢弃前 `n` 个元素。
drop : Int -> List a -> List a
drop n [] = []
drop n (x :: xs) = if n <= 0 then x :: xs else drop (n - 1) xs

-- M25.2b：原来的升序写法 `i :: range (i + 1) n` 需要「有界计数器」规则才能证明；
-- 改成对「剩余个数」倒计数（`k = n - i`，每次 `k - 1`，由 `k <= 0` 守卫），
-- 终止性由 R2 直接可证；语义与原来一致（`i >= n` 时 `k <= 0` 返回空表）。
-- | 从 0 到 `to`（不含）的整数列表。
range : Int -> Int -> List Int
range i n = rangeFrom i (n - i)

-- | 从 `from` 到 `to`（不含 `to`）的整数列表。
rangeFrom : Int -> Int -> List Int
rangeFrom i k = if k <= 0 then [] else i :: rangeFrom (i + 1) (k - 1)

-- | 映射并丢弃 `Nothing` 元素。
mapMaybe : (a -> Maybe b) -> List a -> List b
mapMaybe f [] = []
mapMaybe f (x :: xs) = case f x of
  Nothing => mapMaybe f xs
  Just y => y :: mapMaybe f xs

-- M11-C：Functor / Monad 实例（trait 来自 Base.Monad，List 定义在本模块）。
instance Functor List where
  fmap f xs = map f xs

instance Monad List where
  bind xs f = concatMap f xs

instance Applicative List where
  pure x = [x]
  liftA2 f xs ys = concatMap (\a => map (\b => f a b) ys) xs

-- B31：容器 `Show` 实例。元素用 `show`（约束实例的 ctx 字典）；拼接只用 `++`
-- intrinsic——`strConcatMany` 等带 List 桥接的 intrinsic 在「声明 List 族的单元」里
-- 会触发 split 生成器的自依赖（bridgeUnit 固定为 List 单元），故避开。
-- `++` 无 fixity 声明时用反引号形式（List 不能 import Base.String，避免成环）。
-- | 内部：把已 `show` 的元素列表拼成 `[a, b, c]` 的正文（不含方括号，供 Show 实例使用）。
showElems : List String -> String
showElems [] = ""
showElems (x :: rest) = x `++` (showElemsTail rest)

-- | 内部：`showElems` 的尾部拼接，每个元素前加 `, `。
showElemsTail : List String -> String
showElemsTail [] = ""
showElemsTail (x :: rest) = ", " `++` x `++` (showElemsTail rest)

instance Show a => Show (List a) where
  show xs = "[" `++` (showElems (map (\x => show x) xs)) `++` "]"

-- 逐元素相等；`[]` 只等于 `[]`。
instance Eq a => Eq (List a) where
  eq [] [] = True
  eq (x :: xs) (y :: ys) = x == y && xs == ys
  eq _ _ = False
  neq xs ys = if xs == ys then False else True

-- 字典序：`[]` 最小，同头再比尾。
instance Ord a => Ord (List a) where
  lt [] [] = False
  lt [] (_ :: _) = True
  lt (_ :: _) [] = False
  lt (x :: xs) (y :: ys) = if x < y then True else if y < x then False else xs < ys
  le xs ys = xs < ys || not (ys < xs)
  gt xs ys = ys < xs
  ge xs ys = ys <= xs

-- 哈希：`[]` = 0，非空为 head/tail 的结构组合。
instance Hashable a => Hashable (List a) where
  hash xs = case xs of
    [] => 0
    x :: rest => hashCombine (hash x) (hash rest)

-- 列表拼接是自由 monoid：`Semigroup` 用 `append`，`Monoid` 单位元是 `[]`。
instance Semigroup (List a) where
  mappend = append

instance Monoid (List a) where
  mempty = []

-- 右折叠与可遍历：`fold` 直接复用 `foldr`；`mapM` 用 Applicative 的 `liftA2`。
instance Foldable List where
  fold f z xs = foldr f z xs

instance Applicative f => Traversable List f where
  mapM fun xs = case xs of
    [] => pure []
    x :: rest => liftA2 (\y, ys => y :: ys) (fun x) (mapM fun rest)
