module Base.IORef where

-- Base.IORef：`Eff []` 内的可变引用（M33 W3）。内建类型构造子 `IORef`，OCaml 表示 `'a ref`。
--
-- 所有操作返回 `Eff []`，在 `main : Eff [] a` 或 handler 里执行。
-- `modifyRef` 读-改-写一次完成，避免调用方手写 do 时的中间绑定。
import Base.Eff
import Base.Monad

-- | 创建初值为 `x` 的新引用（`Eff []` 动作）。
export newRef : a -> Eff [] (IORef a)
newRef x = prim_eff_newRef x

-- | 读取引用当前值。
export readRef : IORef a -> Eff [] a
readRef r = prim_eff_readRef r

-- | 写入新值，返回底层原语的 `Int` 结果（写入本身无有意义的返回值，通常忽略）。
export writeRef : IORef a -> a -> Eff [] Int
writeRef r v = prim_eff_writeRef r v

-- | 读-改-写一次完成：读到当前值、应用 `f` 后写回，返回写入原语的 `Int` 结果。
export modifyRef : IORef a -> (a -> a) -> Eff [] Int
modifyRef r f = do
  x <- readRef r
  writeRef r (f x)
