module Base.IntMap (IntMap, fromList, insert, insertAll, lookup, member, size, toList) where

-- Base.IntMap：Int 键、值泛型的持久哈希映射（1024 桶，两层 32 叉）。
--
-- M33 W3：与 `Base.HashMap` 同步改成 `Array (Array (List (Pair Int a)))` 的桶结构
-- （`Array.get` O(1)，`insert` 两次 32 元素 copy-on-write）。键是 `Int` 且直接取哈希
-- （无字符串编码/哈希开销）：元变量编号（0..n）这类稠密小整数几乎不冲突。
-- 桶内前插，同键**新值优先**。
--
-- 负键与 `min_int` 都要落到 0..1023：`n - n / 1024 * 1024` 在负数时仍为负，
-- 再补 1024；`min_int` 在 63 位回绕后余数为 0，结果仍是合法桶号。
--
-- base 模块不自动注入 Prelude，`==` / `<` 的方法名与 Int 实例需要显式 import。
import Base.Array
import Base.Bool
import Base.Eq
import Base.Int
import Base.List
import Base.Maybe
import Base.Ord
import Base.Pair

data IntMap a : Type where
  MkIntMap : Array (Array (List (Pair Int a))) -> IntMap a

_hashInt : Int -> Int
_hashInt n =
  let
    m = n - n / 1024 * 1024
  in if m < 0 then m + 1024 else m

_lookupAssoc : Int -> List (Pair Int a) -> Maybe a
_lookupAssoc key [] = Nothing
_lookupAssoc key ((Pair k v) :: rest) = if key == k then Just v else _lookupAssoc key rest

-- insert 走「桶内前插」：新值在桶首，lookup 天然新值优先；重复键的历史条目留着，
-- 由 toList 在冷路径去重（保留桶首 = 最新值）。这样热路径 insert 不付去重成本。
_hasKeyIn : Int -> List (Pair Int a) -> Bool
_hasKeyIn key [] = False
_hasKeyIn key ((Pair k v) :: rest) = if key == k then True else _hasKeyIn key rest

_dedupGo : List (Pair Int a) -> List (Pair Int a) -> List (Pair Int a)
_dedupGo [] acc = reverse acc
_dedupGo ((Pair k v) :: rest) acc =
  if _hasKeyIn k acc then _dedupGo rest acc else _dedupGo rest (Pair k v :: acc)

_dedupBucket : List (Pair Int a) -> List (Pair Int a)
_dedupBucket xs = _dedupGo xs []

-- 空表用 `[||]` 字面量表示（non-expansive，`empty` / `fromList []` 在 OCaml 侧可泛化）；
-- 第一次 `insert` 时才分配 32×32 桶。
insert : Int -> a -> IntMap a -> IntMap a
insert key v (MkIntMap outers) =
  let
    base =
      if Base.Array.length outers == 0 then Base.Array.make 32 (Base.Array.make 32 []) else outers
    b = _hashInt key
    oi = b / 32
    ii = b - oi * 32
    outer = Base.Array.get base oi
    inner = Base.Array.get outer ii
  in MkIntMap (Base.Array.set base oi (Base.Array.set outer ii (Pair key v :: inner)))

lookup : Int -> IntMap a -> Maybe a
lookup key (MkIntMap outers) = if Base.Array.length outers == 0 then Nothing
else
  let
    b = _hashInt key
    oi = b / 32
    ii = b - oi * 32
  in _lookupAssoc key (Base.Array.get (Base.Array.get outers oi) ii)

member : Int -> IntMap a -> Bool
member key t = case lookup key t of
  Just _ => True
  Nothing => False

insertAll : List (Pair Int a) -> IntMap a -> IntMap a
insertAll [] t = t
insertAll ((Pair k v) :: rest) t = insertAll rest (insert k v t)

-- 列表**前面**的条目优先（先插 rest 再插头部，与 Base.Map.fromList 的查找语义一致）；
-- `insertAll` 相反：后面的条目覆盖前面的。两个语义都有编译器调用点（历史的
-- `tblFromList` / `tblInsertAll`），不要合并。
fromList : List (Pair Int a) -> IntMap a
fromList [] = MkIntMap arrayEmpty
fromList ((Pair k v) :: rest) = insert k v (fromList rest)

toList : IntMap a -> List (Pair Int a)
toList (MkIntMap outers) =
  concatMap (\outer => concatMap (\inner => _dedupBucket inner) (Base.Array.toList outer))
    (Base.Array.toList outers)

size : IntMap a -> Int
size t = Base.List.length (toList t)
