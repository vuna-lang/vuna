-- | 成功/失败结果类型与组合子。
module Base.Result where

-- Base.Result：成功/失败结果类型与组合子（Base 语义迁移 + 常用补充）。
-- `Functor` / `Monad` 实例：组合统一用 `fmap` / `bind` / `pure` / `do`；库内不再提供
-- `andThen` / `mapResult` 这类重复入口。说明：`step` 处理 `Result (Pair a b)`，额外依赖
-- Base.Pair（叶模块，无环）——它同时解构 `Pair`，不是 `bind` 的别名；B31 的 `Show`
-- 实例依赖 Base.Show（同为叶模块）。
import Base.Bool
import Base.Eq
import Base.Hashable
import Base.List
import Base.Foldable
import Base.Monad
import Base.Monoid
import Base.Traversable
import Base.Pair
-- B31：容器 `Show` 实例（`Interp` 由 Base.Interp 的 blanket 实例免费获得）。
import Base.Show
-- `Err` 的相等要比 String：`Eq String` 实例在类型模块 Base.String（不能反向 import）。
import Base.String

-- | 成功 `Ok x` 或失败 `Err message`。
export data Result a(..) : Type where
  -- | 成功。
  Ok : a -> Result a
  -- | 失败（错误消息）。
  Err : String -> Result a

instance Functor Result where
  fmap f (Ok x) = Ok (f x)
  fmap f (Err e) = Err e

instance Monad Result where
  bind (Ok x) k = k x
  bind (Err e) k = Err e

instance Applicative Result where
  pure = Ok
  ap mf mx = case mf of
    Ok g => case mx of
      Ok b => Ok (g b)
      Err e => Err e
    Err e => Err e
  liftA2 f (Ok x) (Ok y) = Ok (f x y)
  liftA2 f (Err e) _ = Err e
  liftA2 f _ (Err e) = Err e

-- | 对列表逐项执行 `Result` 计算；遇到第一个 `Err` 立即返回。
export traverse : (a -> Result b) -> List a -> Result (List b)
traverse f [] = Ok []
traverse f (x :: xs) = case f x of
  Err e => Err e
  Ok y => case traverse f xs of
    Err e => Err e
    Ok ys => Ok (y :: ys)

-- | 处理 `Result (Pair a b)` 的双参数绑定（常用作状态传递）：同时解构 `Pair`，因此不能写成 `bind` 别名（`do` 的 pattern 只支持变量/通配）。
export step : Result (Pair a b) -> (a -> b -> Result c) -> Result c
step (Ok (Pair x st)) k = k x st
step (Err e) k = Err e

-- | 映射错误消息。
export mapError : (String -> String) -> Result a -> Result a
mapError f (Ok x) = Ok x
mapError f (Err e) = Err (f e)

-- | 成功取值，失败返回默认值。
export withDefault : a -> Result a -> a
withDefault d (Ok x) = x
withDefault d (Err e) = d

-- B31：容器 `Show` 实例；`Interp` 经 blanket `Show a => Interp a` 自动获得。
-- `Err` 里的消息是 `String`，`show e` 按 `Show String` 加引号转义（`Err "bad"`）。
-- 拼接用 `++` 的 intrinsic（interp 可归约），与 Maybe/Pair 保持同一写法。
instance Show a => Show (Result a) where
  show r = case r of
    Ok x => "Ok " `++` show x
    Err e => "Err " `++` show e

-- 相等：同构造子比 payload；`Ok` 的 payload 用 `Eq a`，`Err` 的消息用 `Eq String`。
-- `Result` 刻意不提供 `Ord`：成功/失败之间没有有意义的顺序（与 Maybe 不同）。
instance Eq a => Eq (Result a) where
  eq (Ok x) (Ok y) = x == y
  eq (Err x) (Err y) = x == y
  eq _ _ = False
  neq r s = if r == s then False else True

instance Hashable a => Hashable (Result a) where
  hash r = case r of
    Ok x => hashCombine 1 (hash x)
    Err e => hashCombine 2 (hashStr e)

instance Foldable Result where
  fold f z r = case r of
    Ok x => f x z
    Err _ => z

instance Applicative f => Traversable Result f where
  mapM fun r = case r of
    Ok x => liftA2 (\y, _ => Ok y) (fun x) (pure x)
    Err e => pure (Err e)
