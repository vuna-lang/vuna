-- | 成功/失败结果类型与组合子。
module Base.Result (Result(..), andThen, mapError, mapResult, step, traverse, withDefault) where

-- Base.Result：成功/失败结果类型与组合子（Base 语义迁移 + 常用补充）。
-- 说明：`step` 处理 `Result (Pair a b)`，因此额外依赖 Base.Pair（叶模块，无环）；
-- B31 的 `Show` 实例依赖 Base.Show（同为叶模块）。
import Base.List
import Base.Pair
-- B31：容器 `Show` 实例（`Interp` 由 Base.Interp 的 blanket 实例免费获得）。
import Base.Show

-- | 成功 `Ok x` 或失败 `Err message`。
data Result a : Type where
  -- | 成功。
  Ok : a -> Result a
  -- | 失败（错误消息）。
  Err : String -> Result a

-- | 对列表逐项执行 `Result` 计算；遇到第一个 `Err` 立即返回。
traverse : (a -> Result b) -> List a -> Result (List b)
traverse f [] = Ok []
traverse f (x :: xs) = case f x of
  Err e => Err e
  Ok y => case traverse f xs of
    Err e => Err e
    Ok ys => Ok (y :: ys)

-- | `Result` 的单子绑定：成功继续，失败短路。
andThen : Result a -> (a -> Result b) -> Result b
andThen (Ok x) f = f x
andThen (Err e) f = Err e

-- | 处理 `Result (Pair a b)` 的双参数绑定（常用作状态传递）。
step : Result (Pair a b) -> (a -> b -> Result c) -> Result c
step (Ok (Pair x st)) k = k x st
step (Err e) k = Err e

-- | 映射成功值。
mapResult : (a -> b) -> Result a -> Result b
mapResult f (Ok x) = Ok (f x)
mapResult f (Err e) = Err e

-- | 映射错误消息。
mapError : (String -> String) -> Result a -> Result a
mapError f (Ok x) = Ok x
mapError f (Err e) = Err (f e)

-- | 成功取值，失败返回默认值。
withDefault : a -> Result a -> a
withDefault d (Ok x) = x
withDefault d (Err e) = d

-- B31：容器 `Show` 实例；`Interp` 经 blanket `Show a => Interp a` 自动获得。
-- `Err` 里的消息是 `String`，`show e` 按 `Show String` 加引号转义（`Err "bad"`）。
-- 拼接用 `++` 的 intrinsic（interp 可归约），与 Maybe/Pair 保持同一写法。
instance Show a => Show (Result a) where
  show r = case r of
    Ok x => "Ok " `++` (show x)
    Err e => "Err " `++` (show e)
