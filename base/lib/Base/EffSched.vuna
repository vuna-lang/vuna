module Base.EffSched
  ( Scope
  , Task
  , TaskLin
  , awaitTask
  , awaitTaskLin
  , cancelScope
  , cancelTask
  , cancelTaskLin
  , forkTask
  , forkTaskLin
  , forkTaskWith
  , isCancelled
  , newScope
  , scopeWait
  , scopeWaitTimeout
  , withScope
  , withScopeTimeout
  , yieldNow
  ) where

-- Base.EffSched：Layer 3 单线程协作式调度器（结构化并发）。
--
-- 表示：
--   * 纤程 = OCaml 5 **一次性**续延；调度器是纤程之外的一个循环，用私有运行时
--     效应（SchedYield / SchedAwait / SchedWaitScope*）挂起当前纤程。
--   * `Task a` / `Scope` 是不透明句柄（内部是调度器 id）；构造子不导出。
--   * 任务体是 `Eff Nil a`：任务里的用户效应必须在任务内被 handler 处理干净，
--     不能依赖外层 handler（外层 handler 的运行时栈在父纤程上）。
--   * 调度器原语（`prim_sched*`）是隐藏 intrinsic，运行时是 `dtp_sched_*`；
--     它们不是行里的效应：行 `Nil` 里也能 fork/yield/await。
--
-- 语义（协作式）：
--   * `forkTask` 只入队；子任务在父纤程下一次挂起（yield/await/scopeWait）时才开始跑。
--   * `yieldNow` 返回 0（正常）；返回 1 表示取消已请求，任务应尽快清理并返回。
--   * `awaitTask` 返回 `Ok a` / `Err "cancelled"` / `Err <子任务失败消息>`；
--     `Result` 让取消/失败可观察。任务完成后可重复 await（幂等）。
--   * `cancelScope` 给范围内未结束任务置取消位：已挂起的任务在挂起点恢复并收到
--     取消状态；未开始的任务直接取消（不执行）。取消后仍允许一个清理宽限（步数上限），
--     超过后调度器硬中止该纤程（丢弃续延，不再执行）。
--   * `scopeWait`：等范围内任务全部结束；子任务失败会取消同范围其余任务并返回
--     `Err <首个失败消息>`；有取消但无失败/t 超时返回 `Err "cancelled"`。
--   * `withScope`：body 结束后等待 scope；`Ok a` 表示 body 返回且子任务全部正常结束；
--     `Err` 表示 scope 失败/取消。**边界**：body 若以非返回方式中止（abort），
--     scope 的等待不会执行，残留任务由顶层调度器在 main 结束时统一取消清理。
--   * 超时是**逻辑步数**（调度器步进次数）：`withScopeTimeout n` 在 n 步后取消范围
--     并返回 `Err "timeout"`（不要求真实 sleep / 时钟）。
import Base.Eff
import Base.Monad
import Base.Ord
import Base.Result

-- 任务句柄（不透明）。
-- | 任务句柄（不透明）：内部是调度器 id；构造子不导出，由 `forkTask` 产生、`awaitTask` 消费。
data Task a : Type where
  MkTask : Int -> Task a

-- 作用域句柄（不透明）。
-- | 作用域句柄（不透明）：内部是调度器 id；一般经 `withScope` / `withScopeTimeout` 使用。
data Scope : Type where
  MkScope : Int -> Scope

-- | 取任务句柄内部的调度器 id（内部 / 调试用）。
taskId : {a : Type} -> Task a -> Int
taskId (MkTask i) = i

-- | 取作用域句柄内部的调度器 id（内部 / 调试用）。
scopeId : Scope -> Int
scopeId (MkScope i) = i

-- | 让出一次调度（协作点）。返回 0 正常；1 = 取消已请求。
yieldNow : {r : Row} -> Eff r Int
yieldNow = effPrim (\_ => prim_schedYield 0)

-- | 查询当前纤程是否被请求取消（0/1）。
isCancelled : {r : Row} -> Eff r Int
isCancelled = effPrim (\_ => prim_schedIsCancelled 0)

-- | 新建一个作用域（一般经 withScope/withScopeTimeout 使用）。
newScope : {r : Row} -> Eff r Scope
newScope = effPrim (\_ => MkScope (prim_schedNewScope 0))

-- | 在作用域里 fork 一个任务体（只入队，不同步执行）。
forkTask : {a : Type} -> {r : Row} -> Scope -> Eff [] a -> Eff r (Task a)
forkTask sc child = effPrim (\_ => MkTask (prim_schedFork (scopeId sc) (\_ => runPure child)))

-- | 等待任务结束：Ok 值 / Err "cancelled" / Err 子任务失败消息。可重复 await。
awaitTask : {a : Type} -> {r : Row} -> Task a -> Eff r (Result a)
awaitTask t = case t of
  MkTask id => effPrim (\_ => let
    st = prim_schedAwait id
  in if st <= 0 then Ok (prim_schedTaskResult id)
  else if st <= 1 then Err "cancelled" else Err (prim_schedTaskError id)
  )

-- | 请求取消一个任务（幂等）。
cancelTask : {a : Type} -> {r : Row} -> Task a -> Eff r Int
cancelTask t = case t of
  MkTask id => effPrim (\_ => prim_schedCancelTask id)

-- | 请求取消一个作用域里的所有未结束任务（幂等）。
cancelScope : {r : Row} -> Scope -> Eff r Int
cancelScope sc = effPrim (\_ => prim_schedCancelScope (scopeId sc))

-- | 等待作用域清空：Ok 已完成任务数 / Err（失败、取消或超时）。
scopeWait : {r : Row} -> Scope -> Eff r (Result Int)
scopeWait sc = effPrim (\_ => let
  id = scopeId sc
  st = prim_schedScopeWait id
in if st <= 0 then Ok (prim_schedScopeCount id)
else if st <= 1 then Err (prim_schedScopeError id)
else if st <= 2 then Err "timeout" else Err "cancelled"
)

-- | 带步数预算地等待作用域清空；预算耗尽先取消范围，再等清理，返回 Err "timeout"。
scopeWaitTimeout : {r : Row} -> Int -> Scope -> Eff r (Result Int)
scopeWaitTimeout steps sc = effPrim (\_ => let
  id = scopeId sc
  st = prim_schedScopeWaitTimeout steps id
in if st <= 0 then Ok (prim_schedScopeCount id)
else if st <= 1 then Err (prim_schedScopeError id)
else if st <= 2 then Err "timeout" else Err "cancelled"
)

-- | 结构化作用域：body 返回后取消/等待子任务。
-- Ok x = body 返回 Ok 且子任务全部正常结束；Err m = body 失败（先取消子任务）
-- 或 scope 失败/取消/超时。body 的 Result 与 scope 的 Result 合并成一层。
withScope : {a : Type} -> {r : Row} -> (Scope -> Eff r (Result a)) -> Eff r (Result a)
withScope body = do
  sc <- newScope
  res <- body sc
  case res of
    Ok x => do
      w <- scopeWait sc
      case w of
        Ok _ => pure (Ok x)
        Err m => pure (Err m)
    Err e => do
      _ <- cancelScope sc
      _ <- scopeWait sc
      pure (Err e)

-- | 结构化作用域 + 步数超时（超时取消子任务并返回 Err "timeout"）。
withScopeTimeout : {a : Type} -> {r : Row} -> Int -> (Scope -> Eff r (Result a)) -> Eff r (Result a)
withScopeTimeout steps body = do
  sc <- newScope
  res <- body sc
  case res of
    Ok x => do
      w <- scopeWaitTimeout steps sc
      case w of
        Ok _ => pure (Ok x)
        Err m => pure (Err m)
    Err e => do
      _ <- cancelScope sc
      _ <- scopeWaitTimeout steps sc
      pure (Err e)

-- W9 线性任务句柄：TaskLin 是线性数据，awaitTaskLin/cancelTaskLin 各消费一次；
-- 因此「恰好一次 join 或 cancel」在用量检查阶段生效。普通 Task 保留为可复制 legacy。
-- | 线性任务句柄（W9）：`awaitTaskLin` / `cancelTaskLin` 各消费一次，用量检查保证「恰好一次 join 或 cancel」；普通 `Task` 仍是可复制 legacy。
linear data TaskLin a : Type where
  MkTaskLin : {a : Type} -> Int -> TaskLin a

-- | 在作用域里 fork 一个线性任务句柄（只入队，不同步执行；任务体是 `Eff Nil a`）。
forkTaskLin : {a : Type} -> Scope -> Eff [] a -> TaskLin a
forkTaskLin sc child = MkTaskLin (prim_schedFork (scopeId sc) (\_ => runPure child))

-- | 等待线性任务结束（消费句柄一次），语义同 `awaitTask`。
awaitTaskLin : {a : Type} -> {r : Row} -> (1 t : TaskLin a) -> Eff r (Result a)
awaitTaskLin t = case t of
  MkTaskLin id => awaitTask (MkTask id)

-- | 请求取消线性任务（消费句柄一次，幂等），语义同 `cancelTask`。
cancelTaskLin : {a : Type} -> {r : Row} -> (1 t : TaskLin a) -> Eff r Int
cancelTaskLin t = case t of
  MkTaskLin id => cancelTask (MkTask id)

-- W9 effect-aware fork：父纤程提供显式 handler 把 Effectful task 收成 Nil 后再 fork。
-- 这不是继承父 fiber 的 handler 栈（fiber 根 handler 只拦调度器效应），而是显式、
-- 可捕获的 handler 闭包；因此 task 的 handler 状态是任务局部的（文档 D44）。
-- | effect-aware fork：父纤程提供显式 handler 把带效应的任务收成 `Nil` 后再 fork；handler 状态是任务局部的（不从父纤程继承 handler 栈，见 D44）。
forkTaskWith : {a : Type} -> {r : Row} -> {q : Row} -> Scope -> (Eff r a -> Eff [] a) -> Eff r a -> Eff q (Task a)
forkTaskWith sc handler comp = forkTask sc (handler comp)
