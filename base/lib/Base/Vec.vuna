module Base.Vec (Vec(..), substTemplate, vhead, vlen, vtail) where

-- Base.Vec：长度索引向量，`Vec n a` 的 `n` 是 `Base.Nat` 索引（索引在前、元素类型在末位，
-- 与 `Eff r a` / `Error e a` 同序：值类型放最后，trait 高阶实例才能按 `Vec n` 匹配）。
--
-- 用途：诊断模板的插值向量（arity 锁定）。`a` 由签名自由名量化成隐式参数、`n` 写成
-- 隐式索引 => 两者皆 Rig0，运行时擦除——已验：生成的
-- OCaml 是 `C_Vec_Cons of ('a0) * ('a0 t_Vec)`，零索引字段，arity 编译期锁定、运行时零开销。
--
-- 索引排除不可能分支：`vhead` / `vtail` 只在 `Succ n` 上定义，对 `Nil` 类型不可达，
-- 无需运行时空向量检查。
import Base.Nat
import Base.String
import Base.Pair
import Base.Maybe
import Base.List
import Base.Num

-- | 长度索引向量：`Vec n a` 的索引 `n : Nat` 在类型层锁定元素个数，构造子 `Nil` / `Cons` 与索引同构；`a` / `n` 皆是 Rig0，运行时擦除。索引在前、值类型在末位（与 `Eff r a` / `Error e a` 一致）。
data Vec : Nat -> Type -> Type where
  Nil : {a : Type} -> Vec Zero a
  Cons : {n : Nat} -> {a : Type} -> a -> Vec n a -> Vec (Succ n) a

-- 首元素：长度至少 1（`Succ n`），索引排除空向量。
-- `n` 隐式（Rig0）：递归/调用时由 `Vec (Succ n) a` 的索引反推，不必手写。
-- | 取首元素；签名要求长度至少 1（`Vec (Succ n) a`），`Nil` 分支在类型层被排除，无需运行时空检查。
vhead : {n : Nat} -> Vec (Succ n) a -> a
vhead xs = case xs of
  y :: ys => y

-- 去尾：长度至少 1，结果长度 `n`。
-- | 去掉首元素，结果长度为 `n`；同样只对非空向量定义。
vtail : {n : Nat} -> Vec (Succ n) a -> Vec n a
vtail xs = case xs of
  y :: ys => ys

-- 长度（`n` 是 Rig0 索引，这里走运行时计数，与 `List.length` 同义）。
-- | 返回向量长度（运行时递归计数；`n` 是 Rig0 索引，运行时擦除）。
vlen : {n : Nat} -> Vec n a -> Nat
vlen xs = case xs of
  [] => 0
  y :: ys => 1 + vlen ys

-- ---------------------------------------------------------------
-- 模板渲染：占位符 `<0>` `<1>` `<2>`…（序号 = 实参位置）
-- ---------------------------------------------------------------
-- 通用向量工具（与诊断无关，只对 `Vec n String`）：按序号精确查找占位符并填入对应实参。
-- 选 `<k>` 而非 `{k}`：`{}` 在 record / case 消息里会用到，`<>` 无冲突，且与
-- `docs/reference/tooling.md` §4 的 `<loc>`/`<ty>` 文档观感一致。
-- 按序号查找（不是按 `<` 瞎切），所以模板正文里的字面 `<`/`>` 不受影响。
-- 结构递归（每次吃一个实参 + 前进 after）保证终止性；arity 由 `Vec` 长度索引锁定，
-- 此处只做顺序填充。实参耗尽时占位符原样保留（arity 已在类型层防住，运行时兜底不崩）。
-- 模板占位符替换：实现搬到运行时（OCaml `Buffer` 单遍扫描），vuna 侧只做 Vec → List。
-- 旧实现是 vuna 层 char-list 扫描（strUnpack/append/reverse/strPack），一次消息 ~5–10µs；
-- 诊断消息在「试探-回退」路径上被丢弃前也要付这笔钱，实测占 check 的一半以上。
-- | 按占位符 `<0>` / `<1>` / …（序号 = 实参位置）把实参向量填进模板；实现走运行时单遍 `Buffer` 扫描，vuna 侧只做 Vec → List。实参耗尽时占位符原样保留（arity 已在类型层防住）。
substTemplate : {n : Nat} -> String -> Vec n String -> String
substTemplate template args = strSubstTemplate template (vecToList args)

-- | 内部辅助：把 `Vec n String` 转成 `List String` 交给运行时替换器。
vecToList : {n : Nat} -> Vec n String -> List String
vecToList [] = []
vecToList (x :: rest) = x :: vecToList rest
