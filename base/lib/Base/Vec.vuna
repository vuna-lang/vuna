module Base.Vec (Vec(..), substTemplate, vhead, vlen, vtail) where

-- Base.Vec：长度索引向量，`Vec a n` 的 `n` 是 `Base.Nat` 索引。
--
-- 用途：诊断模板的插值向量（arity 锁定）。`a` 由签名自由名量化成隐式参数、`n` 写成
-- 隐式索引 => 两者皆 Rig0，运行时擦除——已验：生成的
-- OCaml 是 `C_Vec_VCons of ('a0) * ('a0 t_Vec)`，零索引字段，arity 编译期锁定、运行时零开销。
--
-- 索引排除不可能分支：`vhead` / `vtail` 只在 `Succ n` 上定义，对 `Nil` 类型不可达，
-- 无需运行时空向量检查。
import Base.Nat
import Base.String
import Base.Pair
import Base.Maybe
import Base.List

data Vec : Type -> Nat -> Type where
  VNil : {a : Type} -> Vec a Zero
  VCons : {a : Type} -> {n : Nat} -> a -> Vec a n -> Vec a (Succ n)

-- 首元素：长度至少 1（`Succ n`），索引排除空向量。
-- `n` 隐式（Rig0）：递归/调用时由 `Vec a (Succ n)` 的索引反推，不必手写。
vhead : {n : Nat} -> Vec a (Succ n) -> a
vhead xs = case xs of
  VCons y ys => y

-- 去尾：长度至少 1，结果长度 `n`。
vtail : {n : Nat} -> Vec a (Succ n) -> Vec a n
vtail xs = case xs of
  VCons y ys => ys

-- 长度（`n` 是 Rig0 索引，这里走运行时计数，与 `List.length` 同义）。
vlen : {n : Nat} -> Vec a n -> Nat
vlen xs = case xs of
  VNil => 0
  VCons y ys => 1 + vlen ys

-- ---------------------------------------------------------------
-- 模板渲染：占位符 `<0>` `<1>` `<2>`…（序号 = 实参位置）
-- ---------------------------------------------------------------
-- 通用向量工具（与诊断无关，只对 `Vec String`）：按序号精确查找占位符并填入对应实参。
-- 选 `<k>` 而非 `{k}`：`{}` 在 record / case 消息里会用到，`<>` 无冲突，且与
-- `docs/reference/tooling.md` §4 的 `<loc>`/`<ty>` 文档观感一致。
-- 按序号查找（不是按 `<` 瞎切），所以模板正文里的字面 `<`/`>` 不受影响。
-- 结构递归（每次吃一个实参 + 前进 after）保证终止性；arity 由 `Vec` 长度索引锁定，
-- 此处只做顺序填充。实参耗尽时占位符原样保留（arity 已在类型层防住，运行时兜底不崩）。
-- 模板占位符替换：实现搬到运行时（OCaml `Buffer` 单遍扫描），vuna 侧只做 Vec → List。
-- 旧实现是 vuna 层 char-list 扫描（strUnpack/append/reverse/strPack），一次消息 ~5–10µs；
-- 诊断消息在「试探-回退」路径上被丢弃前也要付这笔钱，实测占 check 的一半以上。
substTemplate : {n : Nat} -> String -> Vec String n -> String
substTemplate template args = strSubstTemplate template (vecToList args)

vecToList : {n : Nat} -> Vec String n -> List String
vecToList VNil = []
vecToList (VCons x rest) = x :: vecToList rest
