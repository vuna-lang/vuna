module Base.String
  ( byteLength
  , contains
  , endsWith
  , join
  , lines
  , repeat
  , split
  , startsWith
  , substring
  , trim
  , trimLeft
  , trimRight
  , unlines
  ) where

-- Base.String：字符串工具。底层只使用 strUnpack/strPack/strLength/++ 与 Base.List。
-- import Base.Bool 只为让 `data Bool` 声明进入程序（typed codegen 生成 True/False 表达式所需）。
--
-- split 用显式 fuel 计步（M25.2b，M30/C26 收紧为证明界）：`splitAcc` 每次只吃一个字符，
-- 匹配到分隔符后交给 `skipSep` 逐个跳过；两段都带同一个 fuel 参数并每步 `fuel - 1`
-- （`fuel <= 0` 守卫），终止性由 R2「守卫 Int」判据证明（跨函数互调用已纳入 SCC 检查，
-- 见 docs/reference/type-system.md 的「定义与终止性」一节）。
--
-- **上界证明**（`fuel = 2*len(text) + len(sep) + 2` 永不耗尽）：
--   * 一次 splitAcc 调用恰好消费 1 个字符（`c :: rest`），最后一次（`chars = []`）不消费；
--     沿一条求值路径 splitAcc 至多被调用 len(text)+1 次 ⇒ 至多 len(text)+1 步；
--   * 每次命中分隔符时 skipSep 被调用一次，它消费恰好 len(sep) 个字符、至多递减
--     len(sep) 步；skipSep 消费的字符都属于 text、且都被匹配掉，故所有 skipSep 步数之和
--     ≤ len(text)；
--   * 沿路径总步数 ≤ (len(text)+1) + len(text) = 2*len(text)+1，加 `+1` 兜住末次入口，
--     再加 len(sep)+1 的余量 ⇒ 2*len(text)+len(sep)+2 严格大于上界。
--   空 sep 走单独分支（不消耗 fuel），不受影响；分离器长度不进入逐字符循环的计数。
import Base.List
import Base.Bool
-- M31.1：`String` 是 primitive 类型，Eq / Ord 实例跟类型模块走（落点规则见 Base/Eq.vuna）。
import Base.Eq
import Base.Hashable
import Base.Ord
-- `+` / `-` / `*` / `/` 的 fixity 声明在 Base.Int；base 模块不自动注入 Prelude，
-- 本模块的算术运算符需要它的声明进入 import 闭包。
import Base.Int
import Base.Nat
-- M36 跟进：模板字符串降级引用 Base.Interp.interp（split 依赖需要显式 import）。
import Base.Interp
import Base.Monoid

-- `++` 的 fixity 声明（字符串拼接是内建值）。
infixr 5 ++

-- 字节长度（UTF-8 字节数）是度量 → Nat；strLength 仍是低层 Int 原语。
-- | UTF-8 字节长度（度量是 `Nat`；底层 `strLength` 仍是 Int 原语）。
byteLength : String -> Nat
byteLength s = natFromInt (strLength s)

-- | 按分隔符切分，分隔符本身不保留；空分隔符退化为逐字符切分。用显式 fuel 计步（`2*len(text)+len(sep)+2`）让终止性可证。
split : String -> String -> List String
split sep text =
  if strLength sep == 0 then map (\c => strPack [c]) (strUnpack text)
  else splitAcc (strUnpack sep) (strUnpack text) (2 * strLength text + strLength sep + 2) [] []

-- | 内部：`split` 的扫描循环——每次消费一个字符，命中分隔符时交给 `skipSep`；`fuel` 每步减一保证终止。
splitAcc : List Int -> List Int -> Int -> List Int -> List String -> List String
splitAcc sep [] fuel acc parts = reverse (strPack (reverse acc) :: parts)
splitAcc sep (chars@(c :: rest)) fuel acc parts =
  if fuel <= 0 then reverse (strPack (reverse acc) :: parts)
  else if _startsWithChars sep chars then skipSep sep chars (fuel - 1) (length sep) [] (strPack (reverse acc) :: parts)
  else splitAcc sep rest (fuel - 1) (c :: acc) parts

-- | 内部：`split` 命中分隔符后逐个跳过 `n` 个字符，然后回到 `splitAcc`。
skipSep : List Int -> List Int -> Int -> Int -> List Int -> List String -> List String
skipSep sep [] fuel n acc parts = reverse (strPack (reverse acc) :: parts)
skipSep sep (chars@(c :: rest)) fuel n acc parts =
  if fuel <= 0 then reverse (strPack (reverse acc) :: parts)
  else if n <= 0 then splitAcc sep chars (fuel - 1) acc parts
  else skipSep sep rest (fuel - 1) (n - 1) acc parts

-- | 用 `sep` 连接字符串列表（一次 `strConcatMany` 单遍分配，避免逐段拼接的 O(n²) 拷贝）。
join : String -> List String -> String
join sep xs = strConcatMany (_interleave sep xs)

-- M33 W2：`join` 原来用 `x ++ sep ++ join sep rest` 逐段拼接，总拷贝 O(n²)；
-- 改成一次 `strConcatMany`（runtime `String.concat ""`，单遍分配）。
_interleave : String -> List String -> List String
_interleave sep [] = []
_interleave sep ([x]) = [x]
_interleave sep (x :: rest) = x :: sep :: _interleave sep rest

-- | 按 `\n` 切分成行；与 `split` 一致，末尾换行会产生一个空串尾元素。
lines : String -> List String
lines s = split "\n" s

-- | 每行补 `\n` 后拼接（`lines` 的逆操作，空列表得到空串）。
unlines : List String -> String
unlines [] = ""
unlines xs = strConcatMany (map (\x => "${x}\n") xs)

-- | 去掉左侧空白（空格 / `\t` / `\n` / `\r`）。
trimLeft : String -> String
trimLeft s = strPack (_dropSpace (strUnpack s))

-- | 去掉右侧空白。
trimRight : String -> String
trimRight s = strPack (reverse (_dropSpace (reverse (strUnpack s))))

-- | 去掉两端空白。
trim : String -> String
trim s = trimLeft (trimRight s)

-- | `text` 是否包含子串 `needle`。
contains : String -> String -> Bool
contains needle text = _containsChars (strUnpack needle) (strUnpack text)

-- | `text` 是否以 `prefix` 开头。
startsWith : String -> String -> Bool
startsWith prefix text = _startsWithChars (strUnpack prefix) (strUnpack text)

-- | `text` 是否以 `suffix` 结尾。
endsWith : String -> String -> Bool
endsWith suffix text =
  let
    ls = strLength suffix
  in let
    lt = strLength text
  in if ls > lt then False else _startsWithChars (strUnpack suffix) (drop (lt - ls) (strUnpack text))

-- M33 W4：`repeat` 改成一次 `strConcatMany`（原来 `s ++ repeat (n-1) s` 是 O(n²) 拷贝）。
-- | 把 `s` 重复 `n` 次（一次 `strConcatMany`，避免 O(n²) 拷贝）。
repeat : Nat -> String -> String
repeat n s = strConcatMany (map (\_ => s) (range 0 (natToInt n)))

-- M33 W4：`substring` 直接用 `strSubstring` 原语（runtime `String.sub` + clamp），
-- 不再走 `strUnpack`/`take`/`drop`/`strPack` 的 List 桥接。
-- | 取子串 `(start, len)`；越界由 `strSubstring` 原语 clamp，不走 List 桥接。
substring : Nat -> Nat -> String -> String
substring start len s = strSubstring (natToInt start) (natToInt len) s

_isSpace : Int -> Bool
_isSpace c = c == 32 || c == 9 || c == 10 || c == 13

_dropSpace : List Int -> List Int
_dropSpace [] = []
_dropSpace (c :: rest) = if _isSpace c then _dropSpace rest else c :: rest

_startsWithChars : List Int -> List Int -> Bool
_startsWithChars [] text = True
_startsWithChars (p :: prest) text = case text of
  [] => False
  t :: trest => p == t && _startsWithChars prest trest

_containsChars : List Int -> List Int -> Bool
_containsChars needle text = if _startsWithChars needle text then True
else case text of
  [] => False
  c :: rest => _containsChars needle rest

-- M31.1：primitive 没有构造子，实例实现走编译器内建特化（`bi_eq_str` / 泛型比较运行时），
-- 不会自递归。
instance Eq String where
  eq x y = x == y
  neq x y = x /= y

instance Ord String where
  lt x y = x < y
  le x y = x <= y
  gt x y = x > y
  ge x y = x >= y

-- 哈希：String 用 `hashStr`（intrinsic `strHash` 的 0..1023 公式）。
instance Hashable String where
  hash s = hashStr s

instance Semigroup String where
  mappend x y = x ++ y

instance Monoid String where
  mempty = ""
