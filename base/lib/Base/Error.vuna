-- | 库级 Error monad：`Error e a` 是 `MkOk a` / `MkErr e` 的和，`Functor` / `Monad` 实例齐全，`do` 可用。
--
-- handler 是 `runError`；`catchError` 做错误恢复。错误类型 `e` 泛型；`Base.Result` 固定 String 错误，是另外的专门版，不复用本类型。
module Base.Error where

import Base.Monad

-- | 库级 Error monad 的和类型：成功 `MkOk a` 或失败 `MkErr e`（构造器不导出，用 `ok` / `throwError` 构造）。
export data Error e a : Type where
  -- | 成功分支，携带结果值。
  MkOk : a -> Error e a
  -- | 失败分支，携带错误值。
  MkErr : e -> Error e a

-- | handler：把 `Error e a` 折叠成 `b`，分别给错误分支 `onErr` 与成功分支 `onOk`。
export runError : Error e a -> (e -> b) -> (a -> b) -> b
runError (MkOk a) onErr onOk = onOk a
runError (MkErr e) onErr onOk = onErr e

-- | 抛出错误：构造 `MkErr e`。
export throwError : e -> Error e a
throwError e = MkErr e

-- | 成功构造：构造 `MkOk a`（构造器不导出时用它重建 Ok，`ErrorT` 等组合子需要）。
export ok : a -> Error e a
ok a = MkOk a

instance Functor (Error e) where
  fmap f (MkOk a) = MkOk (f a)
  fmap f (MkErr e) = MkErr e

instance Monad (Error e) where
  bind (MkOk a) k = k a
  bind (MkErr e) k = MkErr e

instance Applicative (Error e) where
  pure a = MkOk a
  ap mf mx = case mf of
    MkOk g => case mx of
      MkOk b => MkOk (g b)
      MkErr e => MkErr e
    MkErr e => MkErr e
  liftA2 f (MkOk a) (MkOk b) = MkOk (f a b)
  liftA2 f (MkErr e) _ = MkErr e
  liftA2 f _ (MkErr e) = MkErr e

-- | 错误恢复：`MkOk` 原样透传，`MkErr e` 时交给 handler `h`。
export catchError : Error e a -> (e -> Error e a) -> Error e a
catchError (MkOk a) h = MkOk a
catchError (MkErr e) h = h e
