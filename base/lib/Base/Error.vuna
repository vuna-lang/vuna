module Base.Error (Error, catchError, ok, runError, throwError) where

-- Base.Error：库级 Error monad（M33 W6 落地；M35.1 补 Functor/Monad 实例，`do` 可用）。
--
-- `Error e a` 是 `Ok a` / `Err e` 的和（错误类型泛型；`Base.Result` 固定 String 错误，
-- 不在这里复用）。handler = `runError`；`catchError` 是错误恢复。
import Base.Monad

-- | 库级 Error monad 的和类型：`MkOk a` / `MkErr e`（错误类型 `e` 泛型，构造器不导出）；`Base.Result` 是固定 String 错误的专门版，不复用本类型。
data Error e a : Type where
  MkOk : a -> Error e a
  MkErr : e -> Error e a

-- | handler：把 `Error e a` 折叠成 `b`，分别给错误分支 `onErr` 与成功分支 `onOk`。
runError : Error e a -> (e -> b) -> (a -> b) -> b
runError (MkOk a) onErr onOk = onOk a
runError (MkErr e) onErr onOk = onErr e

-- | 抛出错误：构造 `MkErr e`。
throwError : e -> Error e a
throwError e = MkErr e

-- 成功构造（`ErrorT` 等组合子需要在不暴露构造器的前提下重建 Ok）。
-- | 成功构造（构造器不导出时用来重建 Ok，`ErrorT` 等组合子需要）。
ok : a -> Error e a
ok a = MkOk a

instance Functor (Error e) where
  fmap f (MkOk a) = MkOk (f a)
  fmap f (MkErr e) = MkErr e

instance Monad (Error e) where
  bind (MkOk a) k = k a
  bind (MkErr e) k = MkErr e

instance Applicative (Error e) where
  pure a = MkOk a
  ap mf mx = case mf of
    MkOk g => case mx of
      MkOk b => MkOk (g b)
      MkErr e => MkErr e
    MkErr e => MkErr e
  liftA2 f (MkOk a) (MkOk b) = MkOk (f a b)
  liftA2 f (MkErr e) _ = MkErr e
  liftA2 f _ (MkErr e) = MkErr e

-- | 错误恢复：`MkOk` 原样透传，`MkErr e` 时交给 handler `h`。
catchError : Error e a -> (e -> Error e a) -> Error e a
catchError (MkOk a) h = MkOk a
catchError (MkErr e) h = h e
