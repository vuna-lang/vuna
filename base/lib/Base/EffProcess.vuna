module Base.EffProcess where

-- Base.EffProcess：一阶进程效应。
--
-- 标签 `ProcessOp` 是命名实例；操作：
--   * `Args`：取进程参数（`@vuna@prim_eff_getArgs`，**不含** argv[0]）；
--   * `Exit`：以状态码退出（`@vuna@prim_eff_exit`，真实 handler 下不返回）；
--   * `RunIn`：在目录 dir 下运行命令（`@vuna@prim_eff_runIn`），返回退出码。
-- 真实 handler 用 `process` 原语。
--
-- `Exit` 可控。`handleProcessHost` 保留「真实退出」语义（`onExit = exit`）；
-- `handleProcessHostWith` 让调用方传入 `onExit`，从而在真实原语路径上**观察**退出码而
-- 不结束进程；`handleProcessHostObserved` 是它的现成实例（`Exit c` 直接作为结果返回，
-- 程序继续执行）。mock handler（`handleProcess`）本来就能观察 `Exit`。
-- 夹具 dt_base/38（mock + observed 两条路径；真实退出路径不触发，避免测试进程退出）。
import Base.Eff
import Base.Eq
import Base.Monad
import Base.List

-- | process 操作：`Args`（取进程参数）、`Exit c`（以状态码 c 退出）、`RunIn dir args`（在目录下运行命令）、
-- `Spawn args`（异步启动并返回句柄）、`Wait h`（等句柄并返回退出码）。
export data ProcessOp(..) : Type where
  Args : ProcessOp
  Exit : Int -> ProcessOp
  RunIn : String -> List String -> ProcessOp
  Spawn : List String -> ProcessOp
  Wait : Int -> ProcessOp

-- | 结果族：`Args` 返回 `List String`，其余（`Exit` / `RunIn` / `Spawn` / `Wait`）返回 `Int`。
export resProcess : ProcessOp -> Type
resProcess Args = List String
resProcess (Exit c) = Int
resProcess (RunIn dir args) = Int
resProcess (Spawn args) = Int
resProcess (Wait h) = Int

-- | 通过命名实例取进程参数（`@vuna@prim_eff_getArgs`，**不含** `argv[0]`）。
export processArgs : Member n ProcessOp r => Eff r (List String)
processArgs = sendCore ProcessOp "process" n Args

-- | 通过命名实例以状态码 `c` 退出；真实 handler 下不返回。
export processExit : Member n ProcessOp r => Int -> Eff r Int
processExit c = sendCore ProcessOp "process" n (Exit c)

-- | 通过命名实例在目录 `dir` 下运行命令 `args`，返回退出码；执行后恢复原 cwd。
export processRunIn : Member n ProcessOp r => String -> List String -> Eff r Int
processRunIn dir args = sendCore ProcessOp "process" n (RunIn dir args)

-- | 通过命名实例异步启动命令 `args`，返回句柄；用 `processWait` 等退出码（并行 jobs 用）。
export processSpawn : Member n ProcessOp r => List String -> Eff r Int
processSpawn args = sendCore ProcessOp "process" n (Spawn args)

-- | 通过命名实例等待 `processSpawn` 返回的句柄，返回退出码。
export processWait : Member n ProcessOp r => Int -> Eff r Int
processWait h = sendCore ProcessOp "process" n (Wait h)

-- | 宿主进程操作失败的种类：命令没能**启动**（不是子进程退出码）。
export data ProcessError(..) : Type where
  -- | 工作目录不存在或不可进入。
  ProcessNoDir : String -> ProcessError
  -- | 启动被系统拒绝（权限 / 资源）。
  ProcessLaunchDenied : String -> ProcessError
  -- | 其它宿主启动错误。
  ProcessHostIo : String -> ProcessError

-- | 进程错误效应：单操作 `ProcessFail`（abort，不恢复续延）。
export data ProcessErrorOp(..) : Type where
  ProcessFail : ProcessError -> ProcessErrorOp

-- | 结果族：`ProcessFail` 不恢复续延，返回类型任意（占位 `Int`）。
export resProcessError : ProcessErrorOp -> Type
resProcessError _ = Int

-- | 抛出一个进程启动失败（由真实 handler 使用）。
export processFail : Member n ProcessErrorOp r => ProcessError -> Eff r a
processFail e = sendCore ProcessErrorOp "process-error" n (ProcessFail e)

-- | 宿主状态码 → 失败种类（0 = 成功；码表见 `@vuna@prim_eff_hostStatus`）。
export processErrorOfCode : String -> Int -> ProcessError
processErrorOfCode path 1 = ProcessNoDir path
processErrorOfCode path 2 = ProcessLaunchDenied path
processErrorOfCode path _ = ProcessHostIo path

-- | 失败种类的人类可读文本（诊断输出用）。
export processErrorText : ProcessError -> String
processErrorText (ProcessNoDir p) = "process: ${p}: no such directory"
processErrorText (ProcessLaunchDenied p) = "process: ${p}: permission denied"
processErrorText (ProcessHostIo p) = "process: ${p}: host I/O error"

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `ProcessOp`。
export handleProcess : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n ProcessOp r} -> (a -> b) -> ((o : ProcessOp) -> (resProcess o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n ProcessOp r) b
handleProcess n ret opH comp = handleCore ProcessOp "process" n ret opH comp

-- | 内部：以 `onExit` 决定 `Exit c` 语义的宿主操作解释——真实路径传 `exit`（进程结束、不返回），观察路径传 `pure`（退出码交给续延）。
processOpHIOWith : (Int -> Eff [] Int) -> {a : Type} -> (o : ProcessOp) -> (resProcess o -> Eff [] a) -> Eff [] a
processOpHIOWith onExit op k = case op of
  Args => do
    xs <- @vuna@prim_eff_getArgs
    k xs
  Exit c => do
    r <- onExit c
    k r
  RunIn dir args => do
    c <- @vuna@prim_eff_runIn dir args
    k c
  Spawn args => do
    h <- @vuna@prim_eff_spawn args
    k h
  Wait h => do
    c <- @vuna@prim_eff_wait h
    k c

-- | 宿主 handler：由调用方传入 `onExit`，结果行删除 `ProcessOp`，answer 是已处理干净的 `Eff []` 动作。
export handleProcessHostWith : {a : Type} -> {r : Row} -> (n : String) -> (Int -> Eff [] Int) -> Eff (Base.Eff.Cons n ProcessOp r) a -> Eff r (Eff [] a)
handleProcessHostWith n onExit comp = handleProcess n (\a => pure a) (processOpHIOWith onExit) comp

-- 真实路径：`Exit` 调用 `@vuna@prim_eff_exit`，进程立即退出、不返回。
-- | 真实路径 handler：`Exit` 调 `@vuna@prim_eff_exit`，进程立即退出、不返回。
-- ---------------------------------------------------------------
-- 带行 handler（entry 自动预装用；不导出）
-- ---------------------------------------------------------------
processOpHIOWithHost : (Int -> Eff (Cons "default" ProcessOp []) Int) -> {a : Type} -> (o : ProcessOp) -> (resProcess o -> Eff (Cons "default" ProcessOp []) a) -> Eff (Cons "default" ProcessOp []) a
processOpHIOWithHost onExit op k = case op of
  Args => do
    xs <- @vuna@prim_eff_getArgs_process_host
    k xs
  Exit c => do
    r <- onExit c
    k r
  RunIn dir args => do
    c <- @vuna@host@runIn dir args
    k c
  Spawn args => do
    h <- raise (@vuna@prim_eff_spawn args)
    k h
  Wait h => do
    c <- raise (@vuna@prim_eff_wait h)
    k c

handleProcessHostWithHost : {a : Type} -> {r : Row} -> (n : String) -> (Int -> Eff (Cons "default" ProcessOp []) Int) -> Eff (Base.Eff.Cons n ProcessOp r) a -> Eff r (Eff (Cons "default" ProcessOp []) a)
handleProcessHostWithHost n onExit comp =
  handleProcess n (\a => pure a) (processOpHIOWithHost onExit) comp

-- | entry 预装的失败收口：打印诊断并以退出码 1 结束（不导出）。
processErrorOpH : {r : Row} -> {a : Type} -> (o : ProcessErrorOp) -> (resProcessError o -> Eff r a) -> Eff r a
processErrorOpH op _ = case op of
  ProcessFail e => do
    _ <- raise (@vuna@prim_eff_eprint "vuna: ${processErrorText e}\n")
    _ <- raise (@vuna@prim_eff_exit 1)
    prim_fail "unreachable: process error handler"

runProcessErrorHost : {r : Row} -> {a : Type} -> Eff (Cons "process-error" ProcessErrorOp r) a -> Eff r a
runProcessErrorHost comp =
  handleCore ProcessErrorOp "process-error" "process-error" (\a => a) processErrorOpH comp

runProcessHost : {r : Row} -> {a : Type} -> Eff (Cons "default" ProcessOp r) a -> Eff (rowAppend r (Cons "default" ProcessOp [])) a
runProcessHost comp =
  joinEff (handleProcessHostWithHost "default" (\c => @vuna@prim_eff_exit_process_host c) comp)
