module Base.EffProcess
  ( ProcessOp(..)
  , handleProcess
  , handleProcessHost
  , handleProcessHostObserved
  , handleProcessHostWith
  , processArgs
  , processExit
  , processRunIn
  , resProcess
  , runProcess
  ) where

-- Base.EffProcess：一阶进程效应（W10 IO 标签迁移）。
--
-- 标签 `ProcessOp` 是命名实例；操作：
--   * `Args`：取进程参数（`prim_eff_getArgs`，**不含** argv[0]）；
--   * `Exit`：以状态码退出（`prim_eff_exit`，真实 handler 下不返回）；
--   * `RunIn`：在目录 dir 下运行命令（`prim_eff_runIn`），返回退出码。
-- 真实 handler 用现有 `process` 能力原语；没有新增原语。
--
-- W10 收尾：`Exit` 可控。`handleProcessHost` 保留「真实退出」语义（`onExit = exit`）；
-- `handleProcessHostWith` 让调用方传入 `onExit`，从而在真实原语路径上**观察**退出码而
-- 不结束进程；`handleProcessHostObserved` 是它的现成实例（`Exit c` 直接作为结果返回，
-- 程序继续执行）。mock handler（`handleProcess`）本来就能观察 `Exit`。
-- 夹具 dt_base/38（mock + observed 两条路径；真实退出路径不触发，避免测试进程退出）。
import Base.Eff
import Base.Host
import Base.Monad
import Base.List

-- | process 操作：`Args`（取进程参数）、`Exit c`（以状态码 c 退出）、`RunIn dir args`（在目录下运行命令）。
data ProcessOp : Type where
  Args : ProcessOp
  Exit : Int -> ProcessOp
  RunIn : String -> List String -> ProcessOp

-- | 结果族：`Args` 返回 `List String`，`Exit` / `RunIn` 返回 `Int`。
resProcess : ProcessOp -> Type
resProcess Args = List String
resProcess (Exit c) = Int
resProcess (RunIn dir args) = Int

-- | 通过命名实例取进程参数（`prim_eff_getArgs`，**不含** `argv[0]`）。
processArgs : (n : String) -> {r : Row} -> {w : Member n ProcessOp r} -> Eff r (List String)
processArgs n = sendCore ProcessOp "process" n Args

-- | 通过命名实例以状态码 `c` 退出；真实 handler 下不返回。
processExit : (n : String) -> Int -> {r : Row} -> {w : Member n ProcessOp r} -> Eff r Int
processExit n c = sendCore ProcessOp "process" n (Exit c)

-- | 通过命名实例在目录 `dir` 下运行命令 `args`，返回退出码；执行后恢复原 cwd。
processRunIn : (n : String) -> String -> List String -> {r : Row} -> {w : Member n ProcessOp r} -> Eff r Int
processRunIn n dir args = sendCore ProcessOp "process" n (RunIn dir args)

-- | 一阶 handler：`ret` / `opH` 由调用方给出，结果行删除 `ProcessOp`。
handleProcess : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n ProcessOp r} -> (a -> b) -> ((o : ProcessOp) -> (resProcess o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n ProcessOp r) b
handleProcess n ret opH comp = handleCore ProcessOp "process" n ret opH comp

-- `onExit` 决定 `Exit c` 的语义：真实路径传 `exit`（进程结束、不返回），
-- 观察路径传 `prim_pureIO`（把退出码交给续延，程序继续）。
-- | 内部：以 `onExit` 决定 `Exit c` 语义的 IO 操作解释——真实路径传 `exit`（进程结束、不返回），观察路径传 `prim_pureIO`（退出码交给续延）。
processOpHIOWith : (Int -> Eff [] Int) -> {a : Type} -> (o : ProcessOp) -> (resProcess o -> Eff [] a) -> Eff [] a
processOpHIOWith onExit op k = case op of
  Args => do
    xs <- getArgs
    k xs
  Exit c => do
    r <- onExit c
    k r
  RunIn dir args => do
    c <- prim_eff_runIn dir args
    k c

-- | IO-backed handler：由调用方传入 `onExit`，结果行删除 `ProcessOp`，answer 是 IO 动作。
handleProcessHostWith : {a : Type} -> {r : Row} -> (n : String) -> (Int -> Eff [] Int) -> Eff (Base.Eff.Cons n ProcessOp r) a -> Eff r (Eff [] a)
handleProcessHostWith n onExit comp = handleProcess n (\a => pure a) (processOpHIOWith onExit) comp

-- 真实路径：`Exit` 调用 `prim_eff_exit`，进程立即退出、不返回。
-- | 真实路径 handler：`Exit` 调 `prim_eff_exit`，进程立即退出、不返回。
handleProcessHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n ProcessOp r) a -> Eff r (Eff [] a)
handleProcessHost n comp = handleProcessHostWith n (\c => exit c) comp

-- 观察路径：`Exit c` 不退出，退出码作为操作结果交还给程序。
-- | 观察路径 handler：`Exit c` 不退出，把退出码作为操作结果交还给程序，程序继续执行。
handleProcessHostObserved : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n ProcessOp r) a -> Eff r (Eff [] a)
handleProcessHostObserved n comp = handleProcessHostWith n (\c => pure c) comp

-- | 单效应便捷入口（P3）：`handleProcessHost n` + `runIOAnswer` 的组合。
runProcess : {a : Type} -> (n : String) -> Eff (Cons n ProcessOp []) a -> Eff [] a
runProcess n comp = joinEff (handleProcessHost n comp)
