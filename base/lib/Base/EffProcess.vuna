module Base.EffProcess
  ( Name(..)
  , Process
  , ProcessOp(..)
  , handleProcess
  , handleProcessIO
  , handleProcessIOObserved
  , handleProcessIOWith
  , nameCode
  , processArgs
  , processExit
  , processRunIn
  , resProcess
  ) where

-- Base.EffProcess：一阶进程效应（W10 IO 标签迁移）。
--
-- 标签 `Process n` 是命名实例；操作：
--   * `Args`：取进程参数（`prim_getArgs`，**不含** argv[0]）；
--   * `Exit`：以状态码退出（`prim_exit`，真实 handler 下不返回）；
--   * `RunIn`：在目录 dir 下运行命令（`prim_runIn`），返回退出码。
-- 真实 handler 用现有 `process` 能力原语；没有新增原语。
--
-- W10 收尾：`Exit` 可控。`handleProcessIO` 保留「真实退出」语义（`onExit = exit`）；
-- `handleProcessIOWith` 让调用方传入 `onExit`，从而在真实原语路径上**观察**退出码而
-- 不结束进程；`handleProcessIOObserved` 是它的现成实例（`Exit c` 直接作为结果返回，
-- 程序继续执行）。mock handler（`handleProcess`）本来就能观察 `Exit`。
-- 夹具 dt_base/38（mock + observed 两条路径；真实退出路径不触发，避免测试进程退出）。
import Base.Eff
import Base.IO
import Base.List

data Name : Type where
  P1 : Name
  P2 : Name

nameCode : Name -> Int
nameCode P1 = 0
nameCode P2 = 1

data Process : Name -> Type where

data ProcessOp : Type where
  Args : ProcessOp
  Exit : Int -> ProcessOp
  RunIn : String -> List String -> ProcessOp

resProcess : ProcessOp -> Type
resProcess Args = List String
resProcess (Exit c) = Int
resProcess (RunIn dir args) = Int

processArgs : (n : Name) -> {r : Row} -> {w : Member (Process n) r} -> Eff r (List String)
processArgs n = sendCore (Process n) "process" (nameCode n) Args

processExit : (n : Name) -> Int -> {r : Row} -> {w : Member (Process n) r} -> Eff r Int
processExit n c = sendCore (Process n) "process" (nameCode n) (Exit c)

processRunIn : (n : Name) -> String -> List String -> {r : Row} -> {w : Member (Process n) r} -> Eff r Int
processRunIn n dir args = sendCore (Process n) "process" (nameCode n) (RunIn dir args)

handleProcess : {a : Type} -> {b : Type} -> {r : Row} -> (n : Name) -> {w : Member (Process n) r} -> (a -> b) -> ((o : ProcessOp) -> (resProcess o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem (Process n) r) b
handleProcess n ret opH comp = handleCore (Process n) "process" (nameCode n) ret opH comp

-- `onExit` 决定 `Exit c` 的语义：真实路径传 `exit`（进程结束、不返回），
-- 观察路径传 `prim_pureIO`（把退出码交给续延，程序继续）。
processOpHIOWith : (Int -> IO Int) -> {a : Type} -> (o : ProcessOp) -> (resProcess o -> IO a) -> IO a
processOpHIOWith onExit op k = case op of
  Args => prim_bindIO getArgs (\xs => k xs)
  Exit c => prim_bindIO (onExit c) (\r => k r)
  RunIn dir args => prim_bindIO (prim_runIn dir args) (\c => k c)

handleProcessIOWith : {a : Type} -> {r : Row} -> (n : Name) -> (Int -> IO Int) -> Eff (RCons (Process n) r) a -> Eff r (IO a)
handleProcessIOWith n onExit comp =
  handleProcess n (\a => prim_pureIO a) (processOpHIOWith onExit) comp

-- 真实路径：`Exit` 调用 `prim_exit`，进程立即退出、不返回。
handleProcessIO : {a : Type} -> {r : Row} -> (n : Name) -> Eff (RCons (Process n) r) a -> Eff r (IO a)
handleProcessIO n comp = handleProcessIOWith n (\c => exit c) comp

-- 观察路径：`Exit c` 不退出，退出码作为操作结果交还给程序。
handleProcessIOObserved : {a : Type} -> {r : Row} -> (n : Name) -> Eff (RCons (Process n) r) a -> Eff r (IO a)
handleProcessIOObserved n comp = handleProcessIOWith n (\c => prim_pureIO c) comp
