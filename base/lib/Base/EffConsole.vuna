module Base.EffConsole where

-- Base.EffConsole：一阶 console 效应（W10 效应标签迁移）。
--
-- 行标签 = `ConsoleOp`（D2），实例名在行的 `Cons n ConsoleOp r` 条目里：同一程序
-- 里可以同时安装多个 console handler（例如 "mock" = 收集器、"real" = 真实
-- stdout/stderr），行里按实例名区分。操作只有 Print / EPrint；真实 handler 直调
-- `@vuna@prim_eff_print` / `@vuna@prim_eff_eprint`，`handleConsoleHost` 是可直接交给 `joinEff` 展平的
-- 宿主 handler。
import Base.Eff
import Base.Nat
import Base.Monad

-- | console 操作：`Print` / `EPrint` 各带一个 `String`。
export data ConsoleOp(..) : Type where
  Print : String -> ConsoleOp
  EPrint : String -> ConsoleOp

-- | 操作的结果类型族：`Print` 返回写入字节数（`Nat`，D25）；`EPrint` 仍返回 `Int`
-- （`@vuna@prim_eff_eprint` 本轮未迁移）。
export resConsole : ConsoleOp -> Type
resConsole (Print s) = Nat
resConsole (EPrint s) = Int

-- | 通过命名实例 `n` 发送 `Print`；返回写入字节数（`Nat`）。行里需要 `Member n ConsoleOp r` 证明（由精化器按行结构构造）。
export consolePrint : (n : String) -> String -> {r : Row} -> {w : Member n ConsoleOp r} -> Eff r Nat
consolePrint n s = sendCore ConsoleOp "console" n (Print s)

-- | 通过命名实例 `n` 发送 `EPrint`（stderr）；其余同 `consolePrint`。
export consoleEprint : (n : String) -> String -> {r : Row} -> {w : Member n ConsoleOp r} -> Eff r Int
consoleEprint n s = sendCore ConsoleOp "console" n (EPrint s)

-- | 一阶 handler：`ret` 处理正常返回、`opH` 解释每个操作，结果行删除 `Console n`。`(key, name)` 与对应的 send 匹配。
export handleConsole : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> {w : Member n ConsoleOp r} -> (a -> b) -> ((o : ConsoleOp) -> (resConsole o -> b) -> b) -> Eff r a -> Eff (Base.Eff.rowRem n ConsoleOp r) b
handleConsole n ret opH comp = handleCore ConsoleOp "console" n ret opH comp

-- 真实 handler 的 op 解释：answer 里直接执行宿主原语。
-- | 真实 handler 的操作解释：在续延前执行 `@vuna@prim_eff_print` / `@vuna@prim_eff_eprint`（answer 是 `Eff []` 动作；`Print` 的结果在边界转回 `Nat`）。
consoleOpHIO : {a : Type} -> (o : ConsoleOp) -> (resConsole o -> Eff [] a) -> Eff [] a
consoleOpHIO op k = case op of
  Print s => do
    r <- fmap natFromInt (@vuna@prim_eff_print s)
    k r
  EPrint s => do
    r <- @vuna@prim_eff_eprint s
    k r

-- ---------------------------------------------------------------
-- 阶段 2：带行的真实 handler（entry 自动预装用；不导出，用户拿不到）
-- ---------------------------------------------------------------
-- | 带 `ConsoleOp` 行的 op 解释：真实打印后写穿继续（answer 行是 `[ConsoleOp]`）。
consoleOpHIOHost : {a : Type} -> (o : ConsoleOp) -> (resConsole o -> Eff (Cons "default" ConsoleOp []) a) -> Eff (Cons "default" ConsoleOp []) a
consoleOpHIOHost op k = case op of
  Print s => do
    r <- fmap natFromInt (@vuna@host@print s)
    k r
  EPrint s => do
    r <- raise (@vuna@prim_eff_eprint s)
    k r

-- | 带行的宿主 handler：删掉 `Console n`，answer 是 `Eff [ConsoleOp]`（不导出）。
handleConsoleHostHost : {a : Type} -> {r : Row} -> (n : String) -> Eff (Base.Eff.Cons n ConsoleOp r) a -> Eff r (Eff (Cons "default" ConsoleOp []) a)
handleConsoleHostHost n comp = handleConsole n (\a => pure a) consoleOpHIOHost comp

-- | entry 自动预装用（泛化 r）：把行头 `ConsoleOp` 的 send 翻译成宿主 intrinsic，
-- 并把该标签移到行尾（`rowAppend r [ConsoleOp]`）。
runConsoleHost : {r : Row} -> {a : Type} -> Eff (Cons "default" ConsoleOp r) a -> Eff (rowAppend r (Cons "default" ConsoleOp [])) a
runConsoleHost comp = joinEff (handleConsoleHostHost "default" comp)
