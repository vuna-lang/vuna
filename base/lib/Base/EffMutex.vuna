module Base.EffMutex
  ( Mutex
  , Semaphore
  , acquire
  , newMutex
  , newSemaphore
  , release
  , semSignal
  , semWait
  ) where

-- Base.EffMutex：W9 单线程协作式 Mutex / Semaphore。
-- 实现是 IORef + yield 忙等（无阻塞原语）；单线程下 read/write 之间不会被打断。
-- 边界：持有者被硬取消时不会自动释放；无优先级/公平性。
import Base.Eff
import Base.EffSched
import Base.Bool
import Base.Eq
import Base.IORef
import Base.Monad
import Base.Ord
import Base.Result
import Base.Num

-- | 单线程协作式互斥锁：内部是取值 0/1 的 `IORef`（构造器不导出）。
data Mutex : Type where
  MkMutex : IORef Int -> Mutex

-- | 新建未加锁的 Mutex（内部计数 0）。
newMutex : Eff [] Mutex
newMutex = do
  r <- newRef 0
  pure (MkMutex r)

-- | 非阻塞尝试加锁：计数为 0 时置 1 并返回 True，否则返回 False。
tryAcquire : Mutex -> Eff [] Bool
tryAcquire (MkMutex r) = do
  v <- readRef r
  if v == 0 then do
    _ <- writeRef r 1
    pure True
  else pure False

-- | 带 fuel 的加锁：被占用时 `yieldNow` 后重试，fuel 耗尽返回 `Err mutex: timeout`。
acquireFuel : Int -> Mutex -> Eff [] (Result Int)
acquireFuel fuel m = if fuel <= 0 then pure (Err "mutex: timeout")
else do
  ok <- tryAcquire m
  if ok then pure (Ok 0)
  else do
    _ <- yieldNow
    acquireFuel (fuel - 1) m

-- | `acquireFuel 256` 的便捷入口（最多轮询 256 次）。
acquire : Mutex -> Eff [] (Result Int)
acquire m = acquireFuel 256 m

-- | 释放锁（计数置 0），返回 `IORef` 写入原语的 `Int` 结果。
release : Mutex -> Eff [] Int
release (MkMutex r) = writeRef r 0

-- | 单线程协作式信号量：内部是计数值 `IORef`（构造器不导出）。
data Semaphore : Type where
  MkSemaphore : IORef Int -> Semaphore

-- | 新建初值为 `n` 的信号量。
newSemaphore : Int -> Eff [] Semaphore
newSemaphore n = do
  r <- newRef n
  pure (MkSemaphore r)

-- | 带 fuel 的 P 操作：计数 > 0 时减一并返回 `Ok`，否则 `yieldNow` 后重试；fuel 耗尽返回 `Err semaphore: timeout`。
semWaitFuel : Int -> Semaphore -> Eff [] (Result Int)
semWaitFuel fuel (MkSemaphore r) = if fuel <= 0 then pure (Err "semaphore: timeout")
else do
  v <- readRef r
  if v > 0 then do
    _ <- writeRef r (v - 1)
    pure (Ok 0)
  else do
    _ <- yieldNow
    semWaitFuel (fuel - 1) (MkSemaphore r)

-- | `semWaitFuel 256` 的便捷入口。
semWait : Semaphore -> Eff [] (Result Int)
semWait s = semWaitFuel 256 s

-- | V 操作：计数加一，返回 `IORef` 写入原语的 `Int` 结果。
semSignal : Semaphore -> Eff [] Int
semSignal (MkSemaphore r) = do
  v <- readRef r
  writeRef r (v + 1)
