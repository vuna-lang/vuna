-- | 布尔类型与逻辑辅助函数。
module Base.Bool (Bool(..), and, bool, not, or, xor) where

-- Base.Bool：布尔类型与逻辑辅助函数。按「实例跟类型模块走」的落点规则承载
-- `Show Bool` 实例（B24），因此依赖 Base.Show；`Eq` / `Ord` 实例随 trait 留在
-- `Base.Eq` / `Base.Ord`（`Bool` 是它们方法的返回类型，放这里会成环）。
import Base.Hashable
import Base.Show

-- `&&` / `||` 的 fixity 声明在本模块（它们是短路内建值，不是 trait 方法）。
infixl 3 &&
infixl 2 ||

-- | 布尔：`False` / `True`。
data Bool : Type where
  -- | 假。
  False : Bool
  -- | 真。
  True : Bool

-- | 逻辑非。
not : Bool -> Bool
not True = False
not False = True

-- | 逻辑与（非短路版本；短路内建是 `&&`）。
and : Bool -> Bool -> Bool
and True b = b
and False b = False

-- | 逻辑或（非短路版本；短路内建是 `||`）。
or : Bool -> Bool -> Bool
or True b = True
or False b = b

-- | 逻辑异或。
xor : Bool -> Bool -> Bool
xor True b = not b
xor False b = b

-- | 布尔消除：先假分支、再真分支。
bool : a -> a -> Bool -> a
bool ifFalse ifTrue True = ifTrue
bool ifFalse ifTrue False = ifFalse

-- B24：`Bool` 的展示用 `if` 输出 True/False（与内建实例一致）；不能写 `show True`，
-- 那会自递归。
instance Show Bool where
  show b = if b then "True" else "False"

-- 哈希：`False` = 0、`True` = 1。
instance Hashable Bool where
  hash b = if b then 1 else 0
