-- | 一阶 State 效应：标签类型 `StateOp s`，操作 `Get` / `Put`，结果类型由构造子索引给出。
--
-- handler 的 answer 类型由调用方选择：经典写法是 `b = s -> Pair a s`，ret 把值配成
-- `Pair a s`，opH 用续延把状态往下传。
module Base.EffState where

import Base.Eff

-- | state 操作：`Get` 与 `Put x`，按状态类型 `s` 参数化；第二个索引是结果类型。
export data StateOp(..) : Type -> Type -> Type where
  -- | 读当前状态（结果：状态 `s`）。
  Get : {s : Type} -> StateOp s s
  -- | 写入新状态（结果：`Int` 占位）。
  Put : {s : Type} -> s -> StateOp s Int

-- | 通过命名实例读状态；行里需要 `Member (Named n (StateOp s)) r` 证明。
export get : (n : String) -> (s : Type) -> {r : Row} -> {w : Member (Named n (StateOp s)) r} -> Eff r s
get n s = sendCore (Named n (StateOp s)) "state" n Get

-- | 通过命名实例写状态，返回占位结果 `Int`。
export put : (n : String) -> (s : Type) -> s -> {r : Row} -> {w : Member (Named n (StateOp s)) r} -> Eff r Int
put n s x = sendCore (Named n (StateOp s)) "state" n (Put x)

-- | 一阶 handler：`ret` / `opH` 由调用方给出（answer 类型 `b` 可选，经典写法 `b = s -> Pair a s` 让续延线程状态），结果行删除 `StateOp s`。
export handleState : {a : Type} -> {b : Type} -> {r : Row} -> (n : String) -> (s : Type) -> {w : Member (Named n (StateOp s)) r} -> (a -> b) -> ((i : Type) -> (o : StateOp s i) -> (Base.Eff.resIdx i o -> b) -> b) -> Eff r a -> Eff (rowRem (Named n (StateOp s)) r) b
handleState n s ret opH comp = handleCore (Named n (StateOp s)) "state" n ret opH comp
