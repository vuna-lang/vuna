module Prelude
  ( module Base.Bool
  , module Base.Eq
  , module Base.Float
  , module Base.Foldable
  , module Base.FromInt
  , module Base.FromString
  , module Base.Hashable
  , module Base.Interp
  , module Base.List
  , module Base.Maybe
  , module Base.Monad
  , module Base.Monoid
  , module Base.Num
  , module Base.Ord
  , module Base.Pair
  , module Base.Result
  , module Base.Show
  , module Base.String
  , module Base.Traversable
  , module Base.Unit
  ) where

-- Prelude：默认导入（自动 import）的精选门面。
--
-- 只重导出最常用的核心模块；Map / Sort 需要显式 import。
-- 宿主层（`prim_eff_*`）是全局内建名，任何模块可直接调用，不需要也不提供别名门面。
-- 需要效果标签 / 运行入口时显式 `import Base.Eff`。
--
-- M24.7：Show / Eq / Ord 的 trait 声明与内建类型实例在库里（Base.Show /
-- Base.Eq / Base.Ord），因此随 Prelude 自动可见，用户程序不必显式 import。
--
-- Base.Float（2026-11 rotation 后提升）：`FromFloat` / 转换 helper 与
-- `Eq` / `Ord` / `Show Float` 实例随 Prelude 可见；代价是 Prelude 闭包包含
-- Base.Float，所有程序的 `Vuna_runtime.ml` 都会带浮点 helper（见 floats.md）。
import Base.Pair
import Base.Bool
import Base.Show
import Base.Eq
import Base.Ord
-- M31.1：加载 `Int` 的 Eq / Ord 实例（跟类型模块走；仅加载实例，不重导出名字）。
import Base.Int
import Base.Interp
import Base.Foldable
import Base.Float
import Base.FromInt
import Base.FromString
import Base.Hashable
import Base.List
import Base.Monoid
-- D23：算术运算符 `+ - * /` 是 `Num` 方法的别名；fixity 与别名真源在 Base.Num。
import Base.Num
import Base.Maybe
import Base.Result
import Base.String
import Base.Monad
import Base.Traversable
-- 保证每个程序都加载 Base.Eff（宿主原语签名与 codegen 的 MkEff 需要它）；
-- 这里只 import、不重导出，短名 Eff/Row 仍需显式 import Base.Eff 才能用。
import Base.Eff
import Base.Unit
