import Greet
import Base.List
import Base.Monad
import Base.Host

-- DT 的 build 会先执行动作、再打印 main 的返回值；do 块末用 `exit 0` 结束，
-- 让示例的输出只含业务内容（不依赖「是否打印返回值」这一 CLI 细节）。
main : Eff [] Int
main = do
  _ <- print (greeting 3 ++ "|" ++ showNames (names 2))
  exit 0

showNames : List String -> String
showNames [] = ""
showNames ([x]) = x
showNames (x :: rest) = x ++ " " ++ showNames rest

names : Int -> List String
names n = do
  i <- countTo n
  pure ("n" ++ strFromInt i)

countTo : Int -> List Int
countTo n = if n <= 0 then [] else signed n

signed : Int -> List Int
signed n = n :: countTo (n - 1)
