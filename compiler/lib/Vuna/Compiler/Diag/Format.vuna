-- | 诊断渲染：short（首行）/ human（源码片段 + notes）/ JSON。
module Vuna.Compiler.Diag.Format where

-- Vuna.Compiler.Diag.Format：诊断的唯一渲染层（诊断重设计 M5/M6）。
--
-- 三个视图共享同一个 `Diagnostic`：
--   * `renderShort`：`file:line:col: [CODE] 消息`（编辑器 / grep / 过渡期夹具）；
--   * `renderHuman`：rustc 风格首行 + 源码片段 + note/help；
--   * `renderJson`：版本化机器格式（LSP / CI / 测试消费）。
-- 禁止任何下游再从文本反解析位置或错误码。
--
-- 列单位沿用编译器内部约定：1-based，UTF-8 字节（见 `Source`）。JSON 同时给出
-- 行/列；LSP 适配器负责转 UTF-16。
import Base.HostRow
import Vuna.Compiler.Source
import Vuna.Compiler.Diag
import qualified Vuna.Compiler.Diagnostics
import Base.Nat
import Base.String
import Vuna.Compiler.Version
import Base.Eff

-- ---------------------------------------------------------------
-- 名称
-- ---------------------------------------------------------------
severityName : Severity -> String
severityName SevError = "error"
severityName SevWarning = "warning"
severityName SevNote = "note"
severityName SevHelp = "help"

phaseName : Phase -> String
phaseName PhLex = "lex"
phaseName PhParse = "parse"
phaseName PhResolve = "resolve"
phaseName PhLoad = "load"
phaseName PhElab = "elab"
phaseName PhUnify = "unify"
phaseName PhCoverage = "coverage"
phaseName PhTermination = "termination"
phaseName PhUsage = "usage"
phaseName PhCodegen = "codegen"
phaseName PhPackage = "package"
phaseName PhDriver = "driver"
phaseName PhTool = "tool"
phaseName PhInternal = "internal"

categoryName : Category -> String
categoryName CatSyntax = "syntax"
categoryName CatNames = "names"
categoryName CatTypes = "types"
categoryName CatUniverses = "universes"
categoryName CatCoverage = "coverage"
categoryName CatTermination = "termination"
categoryName CatQuantity = "quantity"
categoryName CatEffects = "effects"
categoryName CatRecords = "records"
categoryName CatTraits = "traits"
categoryName CatCodegen = "codegen"
categoryName CatPackage = "package"
categoryName CatTool = "tool"
categoryName CatInternal = "internal"

originName : Origin -> String
originName OriginDirect = "direct"
originName (OriginCascade _) = "cascade"

applicabilityName : Applicability -> String
applicabilityName MachineApplicable = "machine-applicable"
applicabilityName MaybeIncorrect = "maybe-incorrect"
applicabilityName HasPlaceholder = "has-placeholder"

-- ---------------------------------------------------------------
-- short：首行（与过渡期 CLI 逐字节兼容）
-- ---------------------------------------------------------------
export renderShort : Diagnostic -> String
renderShort = diagText

-- ---------------------------------------------------------------
-- human
-- ---------------------------------------------------------------
-- 主 span（首个 primary 标签）。
primarySpan : List Label -> Maybe Span
primarySpan [] = Nothing
primarySpan ((Label sp _ LabelPrimary _) :: rest) = sp
primarySpan (_ :: rest) = primarySpan rest

-- 主标签文本。
primaryText : List Label -> String
primaryText [] = ""
primaryText ((Label _ text LabelPrimary _) :: rest) = text
primaryText (_ :: rest) = primaryText rest

-- 行文本（1-based）；越界返回空串。
lineAt : List String -> Int -> String
lineAt [] n = ""
lineAt (x :: rest) n = if n <= 1 then x else lineAt rest (n - 1)

-- tab 显示成单空格（与旧渲染一致）。
displayLine : String -> String
displayLine s = strPack (map tabToSpace (strUnpack s))

tabToSpace : Int -> Int
tabToSpace 9 = 32
tabToSpace c = c

repeatSpace : Int -> String
repeatSpace n = if n <= 0 then "" else " " ++ repeatSpace (n - 1)

padLeft : Int -> String -> String
padLeft n s = if strLength s >= n then s else repeatSpace (n - strLength s) ++ s

-- 插入符宽度：同一行用 end - start；跨行或退化时至少 1。
caretWidth : Span -> Int
caretWidth sp =
  if spanEndLine sp /= spanStartLine sp then 1
  else if spanEndCol sp > spanStartCol sp then spanEndCol sp - spanStartCol sp else 1

-- 单个源码片段块。
snippetOf : Span -> String -> String
snippetOf sp text =
  let
    lines = lines text
    src = lineAt lines (spanStartLine sp)
    display = displayLine src
    lineNumber = strFromInt (spanStartLine sp)
    width = strLength lineNumber
    start = if spanStartCol sp <= 0 then 0 else spanStartCol sp - 1
    carets = caretWidth sp
    gutter = repeatSpace (width + 1) ++ "|"
    numberRow = padLeft width lineNumber ++ " | " ++ display
    caretRow =
      repeatSpace (width + 1) ++ "|" ++ repeatSpace (start + 1) ++ repeat (natFromInt carets) "^"
  in join "\n" ["  --> ${showSpanLoc sp}", gutter, numberRow, caretRow]

-- 文件可读才渲染片段（失败静默退回无片段）。
renderSnippet : Span -> Eff hostRow String
renderSnippet sp = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists (spanFile sp))
  if exists then do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory (spanFile sp))
    if isDir then pure ""
    else do
      text <- raiseToRow hostRow (@vuna@prim_eff_readFile (spanFile sp))
      pure (snippetOf sp text)
  else pure ""

-- 头部：`error[CODE]: 消息`（无 code 时 `error: 消息`）。
localizedMessage : String -> Diagnostic -> String
localizedMessage lang d = if lang == "zh" then case Vuna.Compiler.Diagnostics.diagDescOf d.diagCode of
  Just s => s
  Nothing => d.diagMessage
else d.diagMessage

headerOf : String -> Diagnostic -> String
headerOf lang d =
  let
    msg = localizedMessage lang d
  in if d.diagCode == "" then "${severityName d.diagSeverity}: ${msg}"
  else "${severityName d.diagSeverity}[${d.diagCode}]: ${msg}"

-- `lang` 只是显式参数（`en` / `zh`）：没有 ambient 语言状态；片段读取是 Eff。
export renderHuman : String -> Diagnostic -> Eff hostRow String
renderHuman lang d =
  let
    primary = primarySpan d.diagLabels
    ptext = primaryText d.diagLabels
  in do
    snippet <- case primary of
      Just sp => renderSnippet sp
      Nothing => pure ""
    let
      labelNote = if ptext == "" then "" else "  = note: ${ptext}"
      notes = join "\n" (map (\n => "  = note: ${n}") d.diagNotes)
      descLine = diagDescLine d
      origLine =
        if localizedMessage lang d == d.diagMessage then "" else "  = message: ${d.diagMessage}"
      fieldBlock = join "\n" (map fieldLine d.diagFields)
      traceBlock = join "\n" (traceLines 0 d.diagTrace)
      helpBlock = join "\n" (map suggestionLine d.diagSuggestions)
      block =
        join "\n"
          [headerOf lang d, snippet, labelNote, origLine, notes, fieldBlock, traceBlock, helpBlock, descLine]
    in pure (trim block)

-- ---------------------------------------------------------------
-- JSON
-- ---------------------------------------------------------------
jsonEscapeChar : Int -> String
jsonEscapeChar 34 = "\\\""
jsonEscapeChar 92 = "\\\\"
jsonEscapeChar 10 = "\\n"
jsonEscapeChar 13 = "\\r"
jsonEscapeChar 9 = "\\t"
jsonEscapeChar c = if c < 32 then "\\u00" ++ hex2 c else strPack [c]

hex2 : Int -> String
hex2 n =
  let
    hi = n / 16
    lo = n - hi * 16
  in hexDigit hi ++ hexDigit lo

hexDigit : Int -> String
hexDigit n =
  if n < 10 then substring (natFromInt n) 1 "0123456789abcdef"
  else substring (natFromInt n) 1 "0123456789abcdef"

jsonEscape : String -> String
jsonEscape s = join "" (map jsonEscapeChar (strUnpack s))

jsonStr : String -> String
jsonStr s = "\"${jsonEscape s}\""

jsonPos : Int -> Int -> String
jsonPos line col = "{\"line\":${line},\"column\":${col}}"

jsonSpan : Span -> String
jsonSpan sp =
  "{\"file\":${jsonStr sp.spanFile},\"start\":${jsonPos sp.spanStartLine sp.spanStartCol},\"end\":${jsonPos sp.spanEndLine sp.spanEndCol}}"

jsonLabel : Label -> String
jsonLabel (Label sp text style prov) =
  "{\"span\":${maybeJsonSpan sp},\"style\":${jsonStr (styleName style)},\"text\":${jsonStr text},\"provenance\":${maybeJsonSpan prov}}"

styleName : LabelStyle -> String
styleName LabelPrimary = "primary"
styleName LabelSecondary = "secondary"
styleName LabelContext = "context"

maybeJsonSpan : Maybe Span -> String
maybeJsonSpan Nothing = "null"
maybeJsonSpan (Just sp) = jsonSpan sp

jsonCandidate : Candidate -> String
jsonCandidate c =
  "{\"text\":${jsonStr c.candidateText},\"span\":${maybeJsonSpan c.candidateSpan},\"reason\":${maybeJsonString c.candidateReason}}"

maybeJsonString : Maybe String -> String
maybeJsonString Nothing = "null"
maybeJsonString (Just s) = jsonStr s

jsonField : DiagField -> String
jsonField (FieldExpected s) = "{\"kind\":\"expected\",\"value\":${jsonStr s}}"
jsonField (FieldFound s) = "{\"kind\":\"found\",\"value\":${jsonStr s}}"
jsonField (FieldName s) = "{\"kind\":\"name\",\"value\":${jsonStr s}}"
jsonField (FieldCandidates cs) =
  "{\"kind\":\"candidates\",\"value\":[${join "," (map jsonCandidate cs)}]}"
jsonField (FieldCall c) =
  "{\"kind\":\"call\",\"value\":{\"callee\":${jsonStr c.callCallee},\"arg\":${jsonStr c.callArg},\"relation\":${jsonStr c.callRelation},\"span\":${maybeJsonSpan c.callSpan}}}"
jsonField (FieldQuantity name declared observed) =
  "{\"kind\":\"quantity\",\"value\":{\"name\":${jsonStr name},\"declared\":${declared},\"observed\":${observed}}}"
jsonField (FieldEffect s) = "{\"kind\":\"effect\",\"value\":${jsonStr s}}"
jsonField (FieldModule s) = "{\"kind\":\"module\",\"value\":${jsonStr s}}"
jsonField (FieldSpan name sp) =
  "{\"kind\":\"span\",\"name\":${jsonStr name},\"value\":${jsonSpan sp}}"
jsonField (FieldNote s) = "{\"kind\":\"note\",\"value\":${jsonStr s}}"

jsonDiagEdit : DiagEdit -> String
jsonDiagEdit e = "{\"span\":${jsonSpan e.editSpan},\"newText\":${jsonStr e.editNewText}}"

jsonSuggestion : Suggestion -> String
jsonSuggestion s =
  "{\"title\":${jsonStr s.suggestionTitle},\"applicability\":${jsonStr (applicabilityName s.suggestionApplicability)},\"edits\":[${join "," (map jsonDiagEdit s.suggestionEdits)}]}"

jsonTrace : TraceFrame -> String
jsonTrace t = jsonTraceFuel 64 t

jsonTraceFuel : Int -> TraceFrame -> String
jsonTraceFuel fuel t =
  if fuel <= 0 then "{\"phase\":\"truncated\"}"
  else "{\"phase\":${jsonStr (phaseName t.tracePhase)},\"text\":${jsonStr t.traceText},\"span\":${maybeJsonSpan t.traceSpan},\"children\":[${join "," (map (jsonTraceFuel (fuel - 1)) t.traceChildren)}]}"

jsonIce : IceInfo -> String
jsonIce i =
  "{\"phase\":${jsonStr (phaseName i.icePhase)},\"function\":${jsonStr i.iceFunction},\"invariant\":${jsonStr i.iceInvariant},\"fingerprint\":${jsonStr i.iceFingerprint},\"hint\":${jsonStr i.iceHint}}"

maybeJsonIce : Maybe IceInfo -> String
maybeJsonIce Nothing = "null"
maybeJsonIce (Just i) = jsonIce i

originJson : Origin -> String
originJson OriginDirect = "{\"kind\":\"direct\"}"
originJson (OriginCascade parent) = "{\"kind\":\"cascade\",\"parent\":${maybeParent parent}}"

maybeParent : Maybe Int -> String
maybeParent Nothing = "null"
maybeParent (Just n) = "${n}"

jsonDiag : String -> Diagnostic -> String
jsonDiag lang d =
  join ""
    ["{\"code\":${jsonStr d.diagCode}", ",\"severity\":${jsonStr (severityName d.diagSeverity)}", ",\"phase\":${jsonStr (phaseName d.diagPhase)}", ",\"category\":${jsonStr (categoryName d.diagCategory)}", ",\"message\":${jsonStr d.diagMessage}${localizedJsonField lang d}", ",\"labels\":[${join "," (map jsonLabel d.diagLabels)}]", ",\"fields\":[${join "," (map jsonField d.diagFields)}]", ",\"trace\":[${join "," (map jsonTrace d.diagTrace)}]", ",\"notes\":[${join "," (map jsonStr d.diagNotes)}]", ",\"suggestions\":[${join "," (map jsonSuggestion d.diagSuggestions)}]", ",\"origin\":${originJson d.diagOrigin}", ",\"internal\":${if d.diagInternal then "true" else "false"}", ",\"ice\":${maybeJsonIce d.diagIce}}"]

export renderJson : String -> Diagnostic -> String
renderJson lang d = jsonDiag lang d

export renderJsonList : String -> List Diagnostic -> String
renderJsonList lang ds =
  "{\"version\":1,\"tool\":\"vuna\",\"diagnostics\":[${join "," (map (jsonDiag lang) ds)}]}"

-- ---------------------------------------------------------------
-- SARIF 2.1.0（CI / 代码扫描消费）
-- ---------------------------------------------------------------
sarifLevel : Severity -> String
sarifLevel SevError = "error"
sarifLevel SevWarning = "warning"
sarifLevel SevNote = "note"
sarifLevel SevHelp = "note"

sarifRuleId : Diagnostic -> String
sarifRuleId d = if d.diagCode == "" then "vuna" else d.diagCode

sarifRegion : Span -> String
sarifRegion sp =
  "{\"startLine\":${spanStartLine sp},\"startColumn\":${spanStartCol sp},\"endLine\":${spanEndLine sp},\"endColumn\":${spanEndCol sp}}"

sarifLocation : String -> Span -> String
sarifLocation file sp =
  "{\"physicalLocation\":{\"artifactLocation\":{\"uri\":${jsonStr file}},\"region\":${sarifRegion sp}}}"

sarifRelated : String -> Label -> String
sarifRelated file l = case l.labelSpan of
  Nothing => "{\"message\":{\"text\":${jsonStr l.labelText}}}"
  Just sp =>
    "{\"message\":{\"text\":${jsonStr l.labelText}},\"physicalLocation\":{\"artifactLocation\":{\"uri\":${jsonStr (spanFile sp)}},\"region\":${sarifRegion sp}}}"

sarifResult : Diagnostic -> String
sarifResult d =
  let
    primary = case primarySpan d.diagLabels of
      Nothing => ""
      Just sp => ",\"locations\":[${sarifLocation (spanFile sp) sp}]"
    related = filter (\l => not (isPrimaryLabel l)) d.diagLabels
    relJson =
      if length related == 0 then ""
      else ",\"relatedLocations\":[${join "," (map (sarifRelated (diagFileOf d)) related)}]"
    notesText = join "\n" (map (\n => "note: ${n}") d.diagNotes)
    msg = if notesText == "" then d.diagMessage else "${d.diagMessage}\n${notesText}"
  in "{\"ruleId\":${jsonStr (sarifRuleId d)},\"level\":${jsonStr (sarifLevel d.diagSeverity)},\"message\":{\"text\":${jsonStr msg}}${primary}${relJson},\"properties\":{\"vuna.origin\":${jsonStr (originName d.diagOrigin)}}}"

isPrimaryLabel : Label -> Bool
isPrimaryLabel l = case l.labelStyle of
  LabelPrimary => True
  _ => False

-- 规则表：按 code 去重（首次出现的消息作为 shortDescription）。
sarifRules : List Diagnostic -> String
sarifRules ds = join "," (map ruleJson (uniqueCodes ds))

uniqueCodes : List Diagnostic -> List String
uniqueCodes ds =
  foldl (\acc => \d => if memCode (sarifRuleId d) acc then acc else append acc [sarifRuleId d]) []
    ds

memCode : String -> List String -> Bool
memCode c [] = False
memCode c (x :: xs) = if c == x then True else memCode c xs

ruleJson : String -> String
ruleJson code =
  let
    desc = case Vuna.Compiler.Diagnostics.diagDescOf code of
      Just s => s
      Nothing => code
    sev = Vuna.Compiler.Diagnostics.diagSeverityOf (Vuna.Compiler.Diagnostics.codeDomain code)
    phase = Vuna.Compiler.Diagnostics.diagPhaseOf (Vuna.Compiler.Diagnostics.codeDomain code)
    cat = Vuna.Compiler.Diagnostics.diagCategoryOf (Vuna.Compiler.Diagnostics.codeDomain code)
  in "{\"id\":${jsonStr code},\"shortDescription\":{\"text\":${jsonStr desc}},\"help\":{\"text\":${jsonStr desc}},\"defaultConfiguration\":{\"level\":${jsonStr (sarifLevelName sev)}},\"properties\":{\"tags\":[${jsonStr phase},${jsonStr cat}]}}"

sarifLevelName : String -> String
sarifLevelName "error" = "error"
sarifLevelName "warning" = "warning"
sarifLevelName _ = "note"

-- | SARIF 2.1.0 文档（所有诊断进一个 run）。
export renderSarif : List Diagnostic -> String
renderSarif ds =
  "{\"$schema\":\"https://json.schemastore.org/sarif-2.1.0.json\",\"version\":\"2.1.0\",\"runs\":[{\"tool\":{\"driver\":{\"name\":\"vuna\",\"version\":${jsonStr vunaVersion},\"rules\":[${sarifRules ds}]}},\"results\":[${join "," (map sarifResult ds)}]}]}"

-- ---------------------------------------------------------------
-- i18n：当前仅 human 视图在 zh 下改用目录说明（JSON/short 保持机器稳定）。
-- ---------------------------------------------------------------
-- | human 中文说明行。
diagDescLine : Diagnostic -> String
diagDescLine d = ""

-- ---------------------------------------------------------------
-- human 视图的语义字段/轨迹/建议（与 JSON 同源，不反解析）
-- ---------------------------------------------------------------
fieldLine : DiagField -> String
fieldLine (FieldExpected s) = "  = expected: ${s}"
fieldLine (FieldFound s) = "  = found: ${s}"
fieldLine (FieldName s) = "  = name: ${s}"
fieldLine (FieldCandidates cs) = "  = candidates: ${join ", " (map candidateTextOf (take 8 cs))}"
fieldLine (FieldCall c) =
  "  = call: ${c.callCallee} <- ${c.callArg} (${c.callRelation})" ++ callSpanSuffix c.callSpan
fieldLine (FieldQuantity n declared observed) =
  "  = quantity: ${n} (declared ${showInt declared}, observed ${showInt observed})"
fieldLine (FieldEffect s) = "  = effect: ${s}"
fieldLine (FieldModule s) = "  = module: ${s}"
fieldLine (FieldSpan s sp) = "  = span: ${s} at ${showSpanLoc sp}"
fieldLine (FieldNote s) = "  = note: ${s}"

traceLines : Int -> List TraceFrame -> List String
traceLines depth [] = []
traceLines depth (t :: rest) =
  append ["  = trace[${phaseName t.tracePhase}]: ${t.traceText}"] (traceLines depth rest)

indent : Int -> String
indent n = if n <= 0 then "" else "  " ++ indent (n - 1)

suggestionLine : Suggestion -> String
suggestionLine s = "  = help: ${s.suggestionTitle} (${applicabilityName s.suggestionApplicability})"

showInt : Int -> String
showInt n = strFromInt n

candidateTextOf : Candidate -> String
candidateTextOf c = c.candidateText

-- | human 视图中调用点文件:行号后缀。
callSpanSuffix : Maybe Span -> String
callSpanSuffix Nothing = ""
callSpanSuffix (Just sp) = " at ${sp.spanFile}:${strFromInt sp.spanStartLine}"

localizedJsonField : String -> Diagnostic -> String
localizedJsonField lang d =
  let
    lm = localizedMessage lang d
  in if lm == d.diagMessage then "" else ",\"localizedMessage\":${jsonStr lm}"
