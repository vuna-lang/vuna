module Vuna.Compiler.Compile
  ( checkFile
  , checkFileDt
  , checkFileIn
  , checkLibraryDt
  , checkPackageIn
  , checkProjectDt
  , compileFileDt
  , compileFileTyped
  , compileFileTypedExec
  , compileFileTypedExecIn
  , compileFileTypedIn
  , compileProjectDt
  , dtMainFile
  , dtProjectFiles
  , effectiveRoots
  ) where

-- Vuna.Compiler.Compile：编译入口（供 CompilerCli / CLI / 测试使用）。
--
-- 只保留 typed codegen 一条 HM 路径；checkFile* 只做类型检查与诊断，不生成代码。
-- M13 起另有 DT 单文件路径（compileFileDt / checkFileDt，见 Vuna.Compiler.Dt）。
import Vuna.Compiler.Common
import Vuna.Compiler.Pkg
import Vuna.Compiler.Loader
import Vuna.Compiler.Typecheck
import Vuna.Compiler.TypedCodegen
import Vuna.Compiler.Dt

-- 未显式给 --root 时使用当前目录包的模块根（vuna.toml）；
-- 当前目录不是包则没有默认根，原始文件模式需显式 --root。
effectiveRoots : List Root -> List Root
effectiveRoots [] = currentPackageRoots
effectiveRoots roots = roots

currentPackageRoots : List Root
currentPackageRoots = case loadPackage "." of
  Err _ => []
  Ok pkg => packageRoots pkg

compileFileTyped : List Root -> String -> Bool -> Result String
compileFileTyped roots entry printResult = compileFileTypedIn "" roots entry printResult

compileFileTypedIn : String -> List Root -> String -> Bool -> Result String
compileFileTypedIn entryPkg roots entry printResult = andThen (loadProgram roots entryPkg entry) (\decls => andThen (checkProgramInfoElab decls) (\p => case p of
  Pair globals elabDecls => generateProgramTyped elabDecls globals printResult
)
)

compileFileTypedExec : List Root -> String -> Result String
compileFileTypedExec roots entry = compileFileTypedExecIn "" roots entry

compileFileTypedExecIn : String -> List Root -> String -> Result String
compileFileTypedExecIn entryPkg roots entry = andThen (loadProgram roots entryPkg entry) (\decls => andThen (checkProgramInfoElab decls) (\p => case p of
  Pair globals elabDecls => generateProgramTypedExec elabDecls globals
)
)

-- 诊断：typecheck + 穷尽性/冗余警告（非致命）。返回警告列表。
checkFile : List Root -> String -> Result (List String)
checkFile roots entry = checkFileIn "" roots entry

checkFileIn : String -> List Root -> String -> Result (List String)
checkFileIn entryPkg roots entry = case loadProgram roots entryPkg entry of
  Err e => Err e
  Ok decls => case checkProgramInfoElab decls of
    Err e => Err e
    Ok (Pair globals elabDecls) => Ok (exhaustiveWarningsFor globals elabDecls)

-- 库包检查：以 [export].modules 为根，不走 app/Main.vuna。
checkPackageIn : String -> List Root -> List String -> Result (List String)
checkPackageIn entryPkg roots names = case loadProjectModules roots entryPkg names of
  Err e => Err e
  Ok project => case resolveProject project of
    Err e => Err e
    Ok parts =>
      let
        flat = append (firstOf parts) (concatMap moduleDeclsOf (secondOf parts))
      in case checkProgramInfoElab flat of
        Err e => Err e
        Ok (Pair globals elabDecls) => Ok (exhaustiveWarningsFor globals elabDecls)

-- ---------------------------------------------------------------
-- M20：DT 路径（复用 Loader：多文件 / import / --root / 包目录）
-- ---------------------------------------------------------------
compileFileDt : List String -> String -> Bool -> Result String
compileFileDt roots entry printResult = dtCompileFile roots entry printResult

checkFileDt : List String -> String -> Result (List String)
checkFileDt roots entry = dtCheckFile roots entry

-- M22.1：包目录。roots / entryPkg 由调用方从 Pkg.packageRoots / packageName 取。
checkProjectDt : List Root -> String -> String -> Result (List String)
checkProjectDt roots entryPkg entry = dtCheckProject roots entryPkg entry

compileProjectDt : List Root -> String -> String -> Bool -> Result String
compileProjectDt roots entryPkg entry printResult =
  dtCompileProject roots entryPkg entry printResult

-- 库包（无 app/Main.vuna）：以 [export].modules 为入口集合做 check。
checkLibraryDt : List Root -> String -> List String -> Result (List String)
checkLibraryDt roots entryPkg names = dtCheckLibrary roots entryPkg names

-- ---------------------------------------------------------------
-- M22.3a：DT 输出模型（整程序单文件 main.ml + build.sh）
--
-- DT codegen 目前只产出整程序单文件 OCaml；逐模块 .ml/.mli 切分留 M24 的 seed 切换
-- （见 roadmap「决策变更」）。在此之前 build --dt / build --dt --split / seed --dt
-- 共用这一份输出形状：main.ml（main 结果打印钩子由 printResult 控制）+ build.sh。
-- ---------------------------------------------------------------
dtMainFile : String
dtMainFile = "main.ml"

dtBuildScriptName : String
dtBuildScriptName = "build.sh"

-- 单文件构建脚本：只依赖 ocamlopt；`cd` 到脚本所在目录，便于从仓库根直接
-- `sh OUT/build.sh`（与 HM 的 buildScript 行为对齐）。
dtBuildScript : String
dtBuildScript =
  "#!/bin/sh\n"
    ++ "# 由 vuna 生成：DT 单文件输出（M22.3a；逐模块切分留 M24）。\n"
    ++ "set -e\n"
    ++ "cd \"$(dirname \"$0\")\"\n"
    ++ "ocamlopt -w -a -I +unix unix.cmxa main.ml -o main\n"

-- DT 包输出文件集（文件名 + 内容），供 build --dt --split / seed --dt 落盘。
dtProjectFiles : List Root -> String -> String -> Bool -> Result (List (Pair String String))
dtProjectFiles roots entryPkg entry printResult =
  andThen (dtCompileProject roots entryPkg entry printResult)
    (\code => Ok [Pair dtMainFile code, Pair dtBuildScriptName dtBuildScript])
