module Vuna.Compiler.Loader.Flatten
  ( fixitiesForSource
  , fixitiesForSourceIn
  , implicitPrelude
  , loadModuleSource
  , loadModuleSourceWithPreloaded
  , loadProject
  , loadProjectModules
  , loadProjectModulesWithPreloaded
  , loadProjectSource
  , loadProjectSourceWithPreloaded
  , loadProjectWithPreloaded
  , parseFileWithPath
  , resolveProject
  , resolveProjectKeeping
  ) where

-- Vuna.Compiler.Loader.Flatten：模块导出表计算、加载流程与 flatten（M24 后维护（源码重组）从 Loader.vuna 拆出）。
--
-- 依赖 `Loader.Modules`（模块/导出表）与 `Loader.Resolve`（名字解析）：先算每个模块的
-- 导出表，再按 import 图递归加载（含隐式 Prelude）。
-- M26：入口统一吃 `PackageContext`（最近 manifest 的包 + 依赖闭包 roots）；旧的
-- 旧的历史顺序拼接/flatten 死路径已删除，DT 精化由 `Driver.Dt` 按
-- 「依赖序列 + 入口声明」拼接。
import Base.List
import Base.Host
import Vuna.Compiler.CacheFormat
import Vuna.Compiler.Loader.Diagnostics
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Sink
import Vuna.Compiler.Diagnostics.Warning
import Vuna.Compiler.Diagnostics.Rn
import Base.HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Loader.Fixity
import Vuna.Compiler.Loader.Modules
import Vuna.Compiler.Loader.Resolve
import Vuna.Compiler.Debug
import Vuna.Compiler.Packages.Pkg

-- M31.2：imports 模块的**可见 fixity 表**（Module 里已含各自的 import 闭包）。
-- 本模块声明由调用方放在返回列表最前，查找时第一处匹配生效。
-- M31.2：parse 错误带文件名（前端诊断无位置，加载器知道路径）。
-- M34.5 第 4 步：AST 缓存。parse 结果按「路径 + 源内容」哈希复用——LSP 反复检查同一
-- 文件、workspace 多次 check 时省掉重复 parse。缓存目录随 `$TMPDIR` 清理。
--
-- key 的**强度**必须够：内建 `strHash` 只有 10 bit（运行时 `land 1023`），初版把两路
-- 10-bit + 长度拼起来，实测在测试套件里发生跨文件命中（其它文件的 AST 被当作
-- `corpus/term/05_multi_clause.vuna` 的入口，报 `LD_ModuleHeaderInEntryFile`）。
-- 这里用 5 条独立 lane 拼成 ~50 bit，并把 schema 版本拌进 key；payload 还带源文本做
-- 回读校验（见下）：**改 `Frontend.Ast` 的 Marshal 布局时必须 bump `astCacheSchema`**
-- （否则旧缓存会被按新布局 `prim_unmarshal`）。模板字面量（M36）新增 AST 构造子，schema 4 → 5。
-- M34.6：载荷套上统一 framing（CacheFormat）；**同时 bump schema 6 → 7**——AST key 不含
-- 编译器指纹，若不 bump，旧二进制（seed / 旧 stage1）会按裸 Marshal 读新格式条目而崩溃。
-- bump 后新旧二进制各用各的 key 空间，互不读取。
astCacheSchema : String
astCacheSchema = "vuna-ast-cache 7"

astCacheDir : String
astCacheDir =
  let
    base = runPure (prim_eff_getenv "TMPDIR")
  in "${if base == "" then "/tmp" else base}/vuna-cache/ast"

astKeyOf : String -> String -> String
astKeyOf path src = strFromInt (astStrongHash "${astCacheSchema}\t${path}\t${src}")

-- 5 条**独立** lane（不同乘子 + 不同素数模）拼成 ~50 bit。不能用
-- `strHash (salt ++ ":" ++ s)` 这类「加盐前缀」：内建 strHash 是
-- `h := (h*33 + c) land 1023` 的仿射迭代，换初值只会得到 h_k = A*k + const (mod 1024)，
-- 五条 lane 彼此完全相关（有效熵仍只有 ~10 bit + 长度，实测测试套件里 7x 夹具读到了
-- 15_private_implicit 的 AST，报出本不存在的 `module Priv not found`）。
-- M34.6：五条 lane **同时**推进（一次 strUnpack 遍历）。旧实现每条 lane 各走一遍
-- 字符表，冷路径 parse 前多花 ~21ms（83 文件实测 75 → 54ms）；取值与旧实现逐位相同
-- （缓存 key 不变）。
astStrongHash : String -> Int
astStrongHash s = astStrongHashGo (strUnpack s) 0 7 13 29 61

astStrongHashGo : List Int -> Int -> Int -> Int -> Int -> Int -> Int
astStrongHashGo [] a b c d e = a + b * 1024 + c * 1048576 + d * 1073741824 + e * 1099511627776
astStrongHashGo (ch :: rest) a b c d e =
  astStrongHashGo rest (astLaneStep a 33 1021 ch) (astLaneStep b 131 1019 ch)
    (astLaneStep c 257 1013 ch) (astLaneStep d 65599 1009 ch) (astLaneStep e 16777619 997 ch)

astLaneStep : Int -> Int -> Int -> Int -> Int
astLaneStep acc mult modulus ch =
  let
    v = acc * mult + ch
  in v - v / modulus * modulus

-- 缓存**回读校验**：payload 带原始源文本，命中时逐字节比较——key 即使碰撞也不会把
-- 别的文件的 AST 当成本文件；不匹配就重新 parse 并覆盖该条目（只损失这一条缓存）。
data AstCacheEntry : Type where
  AstCacheEntry : String -> SourceFile -> AstCacheEntry

astCacheSource : AstCacheEntry -> String
astCacheSource (AstCacheEntry src file) = src

astCacheFile : AstCacheEntry -> SourceFile
astCacheFile (AstCacheEntry src file) = file

-- 缓存条目读写（C32 最小硬化）：载荷统一 framing（magic/schema/长度/校验和）。读侧
-- 截断/篡改/旧格式 ⇒ Nothing ⇒ 重新 parse 并覆盖条目；只有通过 framing 校验的字节才
-- 交给 `prim_unmarshal`（坏文件不再让 Marshal 抛异常/解出错类型）。命中仍逐字节比较
-- 源文本（key 碰撞保护）。
readAstCache : String -> Maybe AstCacheEntry
readAstCache cpath = case readFramed astCacheSchema cpath of
  Just payload => Just (prim_unmarshal payload)
  Nothing => Nothing

storeAstCache : String -> String -> SourceFile -> SourceFile
storeAstCache cpath src parsed =
  let
    _ = ensureDirPath astCacheDir
    _ =
      runPure
        (prim_eff_writeFileAtomic cpath (frameEncode astCacheSchema (prim_marshal (AstCacheEntry src parsed))))
  in parsed

ensureDirPath : String -> Int
ensureDirPath path = ensureDirPathFuel 256 path

ensureDirPathFuel : Int -> String -> Int
ensureDirPathFuel fuel path = if fuel <= 0 then 0
else if path == "" || path == "." || path == "/" then 0
else if runPure (prim_eff_fileExists path) then 0
else
  let
    _ = ensureDirPathFuel (fuel - 1) (parentOfPath path)
  in runPure (prim_eff_makeDir path)

parseFileWithPath : String -> String -> Check SourceFile
parseFileWithPath path src =
  let
    cpath = "${astCacheDir}/${astKeyOf path src}"
  in case readAstCache cpath of
    Just entry =>
      if astCacheSource entry == src then OkC (astCacheFile entry)
      else parseAndStoreAt cpath path src
    Nothing => parseAndStoreAt cpath path src

-- 解析错误统一加 `<path>: ` 前缀（parser 诊断本身无位置）；例外：诊断首行已经以本文件
-- 路径开头（parser 侧带 span 的诊断，如 `[PS_RepeatedPatternBinder]`）时不再重复加，
-- 保持 CLI 首行的 `<file>:<line>:<col>: <消息>` 契约（DiagRender 才能追加源码片段）。
parseAndStoreAt : String -> String -> String -> Check SourceFile
parseAndStoreAt cpath path src =
  let
    _ = resetParseErrors 0
  in case parseSourceRecovering path src of
    ErrC e => ErrC (attachParsePath path e)
    OkC parsed =>
      let
        errs = peekParseErrors 0
      in case errs of
        [] => OkC (storeAstCache cpath src parsed)
        e :: _ => ErrC (attachParsePath path e)

-- 解析错误统一加 `<path>: ` 前缀（parser 诊断本身无位置）。
attachParsePath : String -> Diagnostic -> Diagnostic
attachParsePath path e =
  if startsWith "${path}:" (diagText e) then e
  else withLabel (Label Nothing path LabelContext Nothing) e

visibleFixitiesOf : List Module -> List Import -> List FixityDecl
visibleFixitiesOf modules imports = concatMap (\imp => case findModule modules (importName imp) of
  Just m => moduleFixitiesOf m
  Nothing => []
) imports

-- 按运算符去重（保留第一处 = 本地声明优先，其次 import 顺序）。
-- M31.3（B26 暴露）：每个 Module 的 visible 列表原本是「本模块 ++ import 闭包」的**重复
-- 拼接**——import 图里有大量 diamond，路径数随层数指数增长；base 一旦有 `infix*` 声明，
-- 拼接出来的列表长度就爆炸（`append` 递归直接爆栈）。去重后每个模块的可见表只含
-- 不同运算符（O(运算符数)），闭包计算回到线性。
dedupeFixities : List FixityDecl -> List FixityDecl
dedupeFixities ds = dedupeFixitiesGo ds (Base.HashMap.fromList []) []

dedupeFixitiesGo : List FixityDecl -> HashMap String Int -> List FixityDecl -> List FixityDecl
dedupeFixitiesGo [] seen acc = reverse acc
dedupeFixitiesGo (d :: rest) seen acc =
  let
    key = d.fixityOp
  in case Base.HashMap.lookup key seen of
    Just _ => dedupeFixitiesGo rest seen acc
    Nothing => dedupeFixitiesGo rest (Base.HashMap.insert key 1 seen) (d :: acc)

-- ---------------------------------------------------------------
-- 模块导出表计算（M10）
-- ---------------------------------------------------------------
isPrivateName : String -> Bool
isPrivateName name = startsWith "_" name

privateExportMsg : String -> Span -> String -> Diagnostic
privateExportMsg prefix sp name =
  diagAt sp SevError PhLoad CatPackage ""
    "${prefix}: cannot export private name ${name} (names starting with _ are module-private)"

-- 本模块里与导出相关的「数据类型」信息：类型名 + 公开构造器名列表。
-- data / record / trait 都按同一套 T / T(..) 规则导出（trait 的方法是它的「构造器」）。
findOwnData : String -> List Decl -> Maybe (Pair String (List String))
findOwnData name [] = Nothing
findOwnData name (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    if dname == name then Just (Pair dname (map ctorName ctors)) else findOwnData name rest
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then Just (Pair dname [dname]) else findOwnData name rest
  DTrait tname params methods sp =>
    if tname == name then Just (Pair tname (map traitMethodName methods)) else findOwnData name rest
  _ => findOwnData name rest

findOwnFn : String -> List Decl -> Maybe String
findOwnFn name [] = Nothing
findOwnFn name (d :: rest) = case d of
  DFun n pats body sp => if n == name then Just name else findOwnFn name rest
  DSig n ctx ty sp => if n == name then Just name else findOwnFn name rest
  DAxiom n ty sp => if n == name then Just name else findOwnFn name rest
  DExtern n c ty sp => if n == name then Just name else findOwnFn name rest
  _ => findOwnFn name rest

findCtorNamed : String -> List Ctor -> Maybe String
findCtorNamed name [] = Nothing
findCtorNamed name (c :: rest) =
  if ctorName c == name then Just (ctorName c) else findCtorNamed name rest

-- M30（B20）：trait 方法现在带 span，按 `TraitMethod` 取名字即可（不再是 Pair）。
findMethodNamed : String -> List TraitMethod -> Maybe String
findMethodNamed name [] = Nothing
findMethodNamed name ((TraitMethod mname ty msp) :: rest) =
  if mname == name then Just mname else findMethodNamed name rest

-- M41：返回**全部**同名构造子（不同族可同名）。裸名导出/重导出必须检测歧义。
-- | 自动补注（M41 新增导出）：findOwnCtorNames。
findOwnCtorNames : String -> List Decl -> List (Pair String String)
findOwnCtorNames name [] = []
findOwnCtorNames name (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    append (map (\c => Pair dname (ctorName c)) (filter (\c => ctorName c == name) ctors))
      (findOwnCtorNames name rest)
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then Base.List.Cons (Pair dname dname) (findOwnCtorNames name rest)
    else findOwnCtorNames name rest
  DTrait tname params methods sp =>
    append
      (map (\m => Pair tname (traitMethodName m)) (filter (\m => traitMethodName m == name) methods))
      (findOwnCtorNames name rest)
  _ => findOwnCtorNames name rest

-- record / trait 的「构造子」条目：target = parent（构造子名 = 类型名 / 方法名）。
ownCtorEntries : String -> String -> List String -> List ExportEntry
ownCtorEntries prefix dname [] = []
ownCtorEntries prefix dname (cname :: rest) =
  if isPrivateName cname then ownCtorEntries prefix dname rest
  else Base.List.Cons
    ExportEntry { kind = "ctor", public = cname, target = mangle prefix cname, parent = mangle prefix dname }
    (ownCtorEntries prefix dname rest)

-- M41：data 构造子的 canonical target 是 `Module.Data.Ctor`。
-- | 自动补注（M41 新增导出）：ownDataCtorEntries。
ownDataCtorEntries : String -> String -> List String -> List ExportEntry
ownDataCtorEntries prefix dname [] = []
ownDataCtorEntries prefix dname (cname :: rest) =
  if isPrivateName cname then ownDataCtorEntries prefix dname rest
  else Base.List.Cons
    ExportEntry { kind = "ctor", public = cname, target = ctorCanonical prefix dname cname, parent = mangle prefix dname }
    (ownDataCtorEntries prefix dname rest)

-- 本地类型名的完整导出条目（type + 其构造子/方法），供 `T(..)` 导出使用。
-- | 自动补注（M41 新增导出）：ownTypeEntries。
ownTypeEntries : String -> List Decl -> String -> Maybe (List ExportEntry)
ownTypeEntries prefix [] name = Nothing
ownTypeEntries prefix (d :: rest) name = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    if dname == name then Just
      (Base.List.Cons ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" } (ownDataCtorEntries prefix dname (map ctorName ctors)))
    else ownTypeEntries prefix rest name
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then Just
      (Base.List.Cons ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" } (ownCtorEntries prefix dname [dname]))
    else ownTypeEntries prefix rest name
  DTrait tname params methods sp =>
    if tname == name then Just
      (Base.List.Cons ExportEntry { kind = "type", public = tname, target = mangle prefix tname, parent = "" } (ownCtorEntries prefix tname (map traitMethodName methods)))
    else ownTypeEntries prefix rest name
  _ => ownTypeEntries prefix rest name

-- 从某模块的导出表里取某数据类型的构造器条目：重导出 `T(..)` 时只重新公开
-- 源模块本来就公开的构造器，从而保持源模块的抽象性。
ctorEntriesOfType : String -> List ExportEntry -> List ExportEntry
ctorEntriesOfType typeTarget [] = []
ctorEntriesOfType typeTarget (e :: rest) =
  if e.kind == "ctor" && e.parent == typeTarget then Base.List.Cons e (ctorEntriesOfType typeTarget rest)
  else ctorEntriesOfType typeTarget rest

declImplicitExports : String -> Decl -> List ExportEntry
declImplicitExports prefix d = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    if isPrivateName dname then []
    else Base.List.Cons
      ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" }
      (ownDataCtorEntries prefix dname (map ctorName ctors))
  DRecord dname params fields derivings viaField repr lin sp =>
    if isPrivateName dname then []
    else Base.List.Cons
      ExportEntry { kind = "type", public = dname, target = mangle prefix dname, parent = "" }
      (ownCtorEntries prefix dname [dname])
  DTrait tname params methods sp =>
    if isPrivateName tname then []
    else Base.List.Cons
      ExportEntry { kind = "type", public = tname, target = mangle prefix tname, parent = "" }
      (ownCtorEntries prefix tname (map traitMethodName methods))
  -- M29-T2b：命名实例已删除，实例不出现在导出表（字典按实例表注册）。
  DInstance ctxE head methods sp => []
  DSig name ctx ty sp =>
    if isPrivateName name then []
    else [ExportEntry { kind = "val", public = name, target = mangle prefix name, parent = "" }]
  -- M28：axiom 是无体的可擦除顶层，导出层按值条目处理（类型层引用跨模块可见）。
  DAxiom name ty sp =>
    if isPrivateName name then []
    else [ExportEntry { kind = "val", public = name, target = mangle prefix name, parent = "" }]
  DExtern name cName ty sp =>
    if isPrivateName name then []
    else [ExportEntry { kind = "val", public = name, target = mangle prefix name, parent = "" }]
  DFun name pats body sp =>
    if isPrivateName name then []
    else [ExportEntry { kind = "val", public = name, target = mangle prefix name, parent = "" }]

implicitExports : String -> List Decl -> List ExportEntry
implicitExports prefix decls = dedupeImplicitExports (concatMap (declImplicitExports prefix) decls)

-- 没有模块头 = 导出全部：类型签名 DSig 与子句 DFun 会为同一个函数各产生一条
-- val 条目，必须去重，否则重导出该模块时会在 duplicate export 检查里误报。
dedupeImplicitExports : List ExportEntry -> List ExportEntry
dedupeImplicitExports entries = dedupeByPublic entries (Base.HashMap.fromList []) []

-- 按 (kind, public, target) 去重：类型签名与子句会为同一个函数各产生一条 val 条目；
-- M41 起同名不同族的构造子 target 不同，必须两条都保留。
dedupeByPublic : List ExportEntry -> HashMap String Int -> List ExportEntry -> List ExportEntry
dedupeByPublic [] seen acc = reverse acc
dedupeByPublic (e :: rest) seen acc =
  let
    key = "${e.kind}|${e.public}|${e.target}"
  in case Base.HashMap.lookup key seen of
    Just _ => dedupeByPublic rest seen acc
    Nothing => dedupeByPublic rest (Base.HashMap.insert key 1 seen) (e :: acc)

-- 裸名导出时，若名字是 **record 类型** 且与其同名构造器 target 相同，只导出类型、
-- 不导出构造器：抽象记录必须写 T(..) 才公开构造器。（普通 data 里 ctor 与类型同名
-- 的情形保持 v0 语义：裸名两者都导出。）
typeRefDominates : List Module -> List Decl -> String -> Maybe ExportRef -> Maybe ExportRef -> Bool
typeRefDominates modules decls prefix (Just (ExportRef tk tt tp)) vr = case vr of
  Just (ExportRef vk vt vp) =>
    if tk == "type" && vk == "ctor" && tt == vt then isRecordTarget modules decls prefix tt
    else False
  Nothing => False
typeRefDominates modules decls prefix Nothing vr = False

isRecordTarget : List Module -> List Decl -> String -> String -> Bool
isRecordTarget modules decls prefix target = case splitLastDot (splitOnDot target) of
  Pair revPrefix base =>
    let
      m = joinDots revPrefix
    in if m == prefix then isRecordDecl base decls
    else case findModule modules m of
      Just (Module mname mpkg mimports mimps dcs exports mcaps mtrust mfx _) =>
        isRecordDecl base dcs
      Nothing => False

isRecordDecl : String -> List Decl -> Bool
isRecordDecl dname [] = False
isRecordDecl dname (d :: rest) = case d of
  DRecord dn params fields derivings viaField repr lin sp => dn == dname || isRecordDecl dname rest
  _ => isRecordDecl dname rest

refEntryList : String -> Maybe ExportRef -> List ExportEntry
refEntryList pub Nothing = []
refEntryList pub (Just (ExportRef k tgt parent)) =
  [ExportEntry { kind = k, public = pub, target = tgt, parent = parent }]

ownOrImportedTypeRef : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedTypeRef modules prefix decls imports name = case findOwnData name decls of
  Just (Pair dname ctorNames) => OkC (Just (ExportRef "type" (mangle prefix dname) ""))
  Nothing => Vuna.Compiler.Common.bind (modulesExportingType modules imports name) (\pairs => case pairs of
    [] => OkC Nothing
    _ =>
      Vuna.Compiler.Common.bind (unifyEntryPairs prefix "type" name pairs)
        (\p => OkC (Just (ExportRef "type" (secondOf p).target "")))
  )

ownOrImportedValueRef : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedValueRef modules prefix decls imports name = case findOwnFn name decls of
  Just fn => OkC (Just (ExportRef "val" (mangle prefix fn) ""))
  Nothing => ownOrImportedValueRef2 modules prefix decls imports name

-- | 自动补注（M41 新增导出）：ownOrImportedValueRef2。
ownOrImportedValueRef2 : List Module -> String -> List Decl -> List Import -> String -> Check (Maybe ExportRef)
ownOrImportedValueRef2 modules prefix decls imports name = case ownCtorEntriesNamed prefix name decls of
  [e] => OkC (Just (ExportRef "ctor" e.target e.parent))
  _ :: _ :: _ => rnNoLoc1 (AmbiguousConstructorExport name) name
  [] => Vuna.Compiler.Common.bind (modulesExportingValue modules imports name) (\pairs => case pairs of
    [] => OkC Nothing
    _ => Vuna.Compiler.Common.bind (unifyEntryPairs prefix "name" name pairs) (\p => let
      e = secondOf p
    in OkC (Just (ExportRef e.kind e.target e.parent))
    )
  )

-- M41：本模块里名为 name 的构造子导出条目（data 用族限定 target；record/trait 用原名）。
-- | 自动补注（M41 新增导出）：ownCtorEntriesNamed。
ownCtorEntriesNamed : String -> String -> List Decl -> List ExportEntry
ownCtorEntriesNamed prefix name [] = []
ownCtorEntriesNamed prefix name (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    append
      (ownDataCtorEntries prefix dname (map ctorName (filter (\c => ctorName c == name) ctors)))
      (ownCtorEntriesNamed prefix name rest)
  DRecord dname params fields derivings viaField repr lin sp =>
    if dname == name then append (ownCtorEntries prefix dname [dname]) (ownCtorEntriesNamed prefix name rest)
    else ownCtorEntriesNamed prefix name rest
  DTrait tname params methods sp =>
    append
      (ownCtorEntries prefix tname (map traitMethodName (filter (\m => traitMethodName m == name) methods)))
      (ownCtorEntriesNamed prefix name rest)
  _ => ownCtorEntriesNamed prefix name rest

exportBare : List Module -> String -> List Decl -> List Import -> String -> Span -> Check (List ExportEntry)
exportBare modules prefix decls imports name sp = case splitLastDot (splitOnDot name) of
  Pair revPrefix base => case revPrefix of
    [] => if isPrivateName name then ErrC (privateExportMsg prefix sp name)
    else Vuna.Compiler.Common.bind (ownOrImportedTypeRef modules prefix decls imports name) (\tr => Vuna.Compiler.Common.bind (ownOrImportedValueRef modules prefix decls imports name) (\vr => case tr of
      Nothing => case vr of
        Nothing => rnAt1 sp (CannotExportUnknownName name) name
        Just _ => OkC (refEntryList name vr)
      Just _ => case vr of
        Nothing => OkC (refEntryList name tr)
        Just _ =>
          if typeRefDominates modules decls prefix tr vr then OkC (refEntryList name tr)
          else OkC (append (refEntryList name tr) (refEntryList name vr))
    )
    )
    _ =>
      let
        mprefix = joinDots revPrefix
      in case findImportPrefix imports mprefix of
        Nothing => rnAt1 sp (ModuleNotImported mprefix) mprefix
        Just m => exportSelective modules prefix m base name sp

-- | 自动补注（M41 新增导出）：exportSelective。
exportSelective : List Module -> String -> String -> String -> String -> Span -> Check (List ExportEntry)
exportSelective modules prefix m base name sp = Vuna.Compiler.Common.bind (exportsOf modules m) (\es => if length (findExportCtors es base) > 1 then rnAt2 sp (AmbiguousConstructorInExport base m) base m
else case findExportValue es base of
  Just e => case findExportType es base of
    Just te =>
      OkC
        [ExportEntry { kind = e.kind, public = base, target = e.target, parent = e.parent }, ExportEntry { kind = "type", public = base, target = te.target, parent = "" }]
    Nothing =>
      OkC [ExportEntry { kind = e.kind, public = base, target = e.target, parent = e.parent }]
  Nothing => case findExportType es base of
    Just te => OkC [ExportEntry { kind = "type", public = base, target = te.target, parent = "" }]
    Nothing => rnAt1 sp (CannotExportUnknownName name) name
)

exportTypeAll : List Module -> String -> List Decl -> List Import -> String -> Span -> Check (List ExportEntry)
exportTypeAll modules prefix decls imports name sp = case splitLastDot (splitOnDot name) of
  Pair revPrefix base => case revPrefix of
    [] => if isPrivateName name then ErrC (privateExportMsg prefix sp name)
    else case ownTypeEntries prefix decls name of
      Just entries => OkC entries
      Nothing => Vuna.Compiler.Common.bind (modulesExportingType modules imports name) (\pairs => case pairs of
        [] => rnAt1 sp (CannotExportUnknownName name) name
        _ => Vuna.Compiler.Common.bind (unifyEntryPairs prefix "type" name pairs) (\p => let
          m = firstOf p
        in let
          tgt = (secondOf p).target
        in Vuna.Compiler.Common.bind (exportsOf modules m)
          (\es => OkC (Base.List.Cons ExportEntry { kind = "type", public = name, target = tgt, parent = "" } (ctorEntriesOfType tgt es)))
        )
      )
    _ =>
      let
        mprefix = joinDots revPrefix
      in case findImportPrefix imports mprefix of
        Nothing => rnAt1 sp (ModuleNotImported mprefix) mprefix
        Just m => Vuna.Compiler.Common.bind (exportsOf modules m) (\es => case findExportType es base of
          Just e =>
            OkC
              (Base.List.Cons ExportEntry { kind = "type", public = base, target = e.target, parent = "" } (ctorEntriesOfType e.target es))
          Nothing => rnAt2 sp (TypeNotExported base m) base m
        )

exportItemEntries : List Module -> String -> List Decl -> List Import -> ExportItem -> Check (List ExportEntry)
exportItemEntries modules prefix decls imports (XModule name sp) = case findImportPrefix imports name of
  Nothing => rnAt1 sp (ModuleNotImported name) name
  Just m => exportsOf modules m
exportItemEntries modules prefix decls imports (XTypeAll name sp) =
  exportTypeAll modules prefix decls imports name sp
exportItemEntries modules prefix decls imports (XBare name sp) =
  exportBare modules prefix decls imports name sp

hasSamePublicKind : ExportEntry -> List ExportEntry -> Bool
hasSamePublicKind e [] = False
hasSamePublicKind e (e2 :: rest) =
  e.kind == e2.kind && e.public == e2.public || hasSamePublicKind e rest

-- 冲突判定：同名同 kind 但**定义处不同**才算重复导出。同一个定义经两条路径重导出
-- （门面同时导出 Base.Monad 与 Base.IO，两者都重导出 `Functor(..)`）不是冲突。
-- M41：同名不同族的构造子导出不冲突（`module M (A(..), B(..))` 两边都有 `Nil` 合法）；
-- val/type 的重复导出规则不变。
hasConflictingExport : ExportEntry -> List ExportEntry -> Bool
hasConflictingExport e [] = False
hasConflictingExport e (e2 :: rest) =
  if e.kind == "ctor" then False
  else e.kind == e2.kind && e.public == e2.public && e.target /= e2.target || hasConflictingExport e rest

sameExportEntry : ExportEntry -> ExportEntry -> Bool
sameExportEntry e e2 =
  e.kind == e2.kind && e.public == e2.public && e.target == e2.target && e.parent == e2.parent

dedupeExportEntries : List ExportEntry -> List ExportEntry
dedupeExportEntries entries = dedupeByFullKey entries (Base.HashMap.fromList []) []

exportEntryKey : ExportEntry -> String
exportEntryKey e = "${e.kind}|${e.public}|${e.target}|${e.parent}"

dedupeByFullKey : List ExportEntry -> HashMap String Int -> List ExportEntry -> List ExportEntry
dedupeByFullKey [] seen acc = reverse acc
dedupeByFullKey (e :: rest) seen acc =
  let
    key = exportEntryKey e
  in case Base.HashMap.lookup key seen of
    Just _ => dedupeByFullKey rest seen acc
    Nothing => dedupeByFullKey rest (Base.HashMap.insert key 1 seen) (e :: acc)

checkExportDuplicates : String -> List ExportEntry -> Check (List a)
checkExportDuplicates prefix [] = OkC []
checkExportDuplicates prefix (e :: rest) =
  if hasConflictingExport e rest then rnNoLoc1 (DuplicateExport e.public) e.public
  else checkExportDuplicates prefix rest

-- 显式导出列表里「同一个名字写了两遍」是错误（`module M (foo, foo)`）；
-- 但同一个**定义**经不同模块重导出（门面同时导出 Base.Monad 与 Base.IO，两者都
-- 重导出 `Functor(..)`）不是冲突——条目按 target 去重即可。
exportItemKey : ExportItem -> String
exportItemKey (XBare n sp) = "bare:${n}"
exportItemKey (XTypeAll n sp) = "typeall:${n}"
exportItemKey (XModule n sp) = "module:${n}"

duplicateExportItem : List ExportItem -> Maybe String
duplicateExportItem items =
  dupItemKeys (map (\i => Pair (exportItemKey i) (exportItemName i)) items)

-- 键只在入口算一遍：旧实现在内层循环里对每个元素重拼 "bare:"++n（大模块头上是几千万次分配）。
dupItemKeys : List (Pair String String) -> Maybe String
dupItemKeys [] = Nothing
dupItemKeys ((Pair key name) :: rest) = if memFirstOf key rest then Just name else dupItemKeys rest

memFirstOf : String -> List (Pair String String) -> Bool
memFirstOf key [] = False
memFirstOf key ((Pair k n) :: more) = key == k || memFirstOf key more

exportItemName : ExportItem -> String
exportItemName (XBare n sp) = n
exportItemName (XTypeAll n sp) = n
exportItemName (XModule n sp) = n

checkExportItems : String -> List ExportItem -> Check Int
checkExportItems prefix items = case duplicateExportItem items of
  Just n => rnNoLoc1 (DuplicateExport n) n
  Nothing => OkC 0

explicitExports : List Module -> String -> List Decl -> List Import -> List ExportItem -> Check (List ExportEntry)
explicitExports modules prefix decls imports [] = OkC []
explicitExports modules prefix decls imports items =
  Vuna.Compiler.Common.bind (checkExportItems prefix items)
    (\_ => Vuna.Compiler.Common.bind (exportItemsAll modules prefix decls imports items) (\es => OkC (dedupeExportEntries es)))

-- 逐项解析条目。整表只做一次重复检查、最后只去重一次：旧实现在每个导出项上重查剩余
-- 列表并把 append 结果整体去重，合计 O(k³)（k=400 时约 16s）。
exportItemsAll : List Module -> String -> List Decl -> List Import -> List ExportItem -> Check (List ExportEntry)
exportItemsAll modules prefix decls imports [] = OkC []
exportItemsAll modules prefix decls imports (item :: rest) =
  Vuna.Compiler.Common.bind (exportItemEntries modules prefix decls imports item)
    (\es => Vuna.Compiler.Common.bind (exportItemsAll modules prefix decls imports rest) (\tail => OkC (append es tail)))

validateModuleHeader : String -> Maybe ModDecl -> Check (List a)
validateModuleHeader label Nothing = OkC []
validateModuleHeader label (Just (ModDecl declared hasList items sp)) =
  if declared == label then OkC [] else rnAt1 sp (ModuleNameMismatch declared) declared

computeExports : List Module -> String -> Maybe ModDecl -> List Import -> List Decl -> Check (List ExportEntry)
computeExports modules prefix Nothing imports decls = OkC (implicitExports prefix decls)
computeExports modules prefix (Just (ModDecl declared hasList items sp)) imports decls =
  if hasList then Vuna.Compiler.Common.bind (explicitExports modules prefix decls imports items)
    (\es => Vuna.Compiler.Common.bind (checkExportDuplicates prefix es) (\_ => OkC es))
  else OkC (implicitExports prefix decls)

showCycle : String -> List String -> String
showCycle name stack = joinArrows (reverse (name :: stack))

-- 自动注入的 Prelude：从导入方所在包可见的依赖包取。
-- 显式 import Prelude 时不再重复注入；Prelude 自身不注入（避免环）；当前包自己
-- 的 Prelude 不算候选（`implicitPreludeDeps` 按包名过滤）。
-- M26：ad-hoc（importerPkg==""）不再绕过——无 manifest 的单文件同样是包上下文
-- （base-only），自动注入 base 的 Prelude；没有 base 依赖的包没有候选，于是不注入。
implicitPrelude : List Root -> String -> String -> List Import -> Check (List Import)
implicitPrelude roots importerPkg currentName imports =
  if currentName == "Prelude" then OkC []
  else if memName "Prelude" (importModuleNames imports) then OkC []
  else implicitPreludeFrom roots importerPkg

implicitPreludeFrom : List Root -> String -> Check (List Import)
implicitPreludeFrom roots importerPkg = case collectModuleFiles roots "Prelude" importerPkg [] [] of
  Pair allowed hidden =>
    implicitPreludeDeps importerPkg (filter (\c => rootName (secondOf c) /= importerPkg) allowed)

implicitPreludeDeps : String -> List (Pair String Root) -> Check (List Import)
implicitPreludeDeps importerPkg [] = OkC []
implicitPreludeDeps importerPkg ([_]) = OkC [Import "Prelude" False Nothing (Span "" 0 0 0 0)]
implicitPreludeDeps importerPkg deps =
  rnNoLoc1 (AmbiguousPrelude (joinArrows (map (\c => rootName (secondOf c)) deps)))
    (joinArrows (map (\c => rootName (secondOf c)) deps))

-- F3 P2：按包名查模块根的 `[package] privileged`；找不到按非特权处理。
-- | 按包名查模块根的 `[package] privileged`；找不到按非特权处理。
rootPrivilegedOf : List Root -> String -> Bool
rootPrivilegedOf [] name = False
rootPrivilegedOf (root :: rest) name =
  if rootName root == name then rootPrivileged root else rootPrivilegedOf rest name

-- F3 P2：该模块是否属于某个包的 `[privileged] modules`（宿主层模块）。
-- F3 P2：importing 包是否特权。entry（ad-hoc）包的包名为 ""，不在 roots 里，
-- 用 selfPriv（来自 PackageContext.contextPrivileged）。
-- | importing 包是否特权：按包名查 roots，entry（ad-hoc，包名为空）用 `selfPriv`。
importerPrivileged : List Root -> Bool -> String -> Bool
importerPrivileged roots selfPriv importerPkg =
  if rootPrivilegedOf roots importerPkg then True else if importerPkg == "" then selfPriv else False

-- | 该模块名是否属于某个包的 `[privileged] modules`（宿主层模块）。
hostModuleIn : List Root -> String -> Bool
hostModuleIn [] name = False
hostModuleIn (root :: rest) name =
  if memName name (rootHostModules root) then True else hostModuleIn rest name

loadAll : Int -> List Root -> Bool -> String -> List Module -> List String -> List Import -> Check (List Module)
loadAll fuel roots selfPriv importerPkg modules stack imports = if fuel <= 0 then icFuel "loader"
else case imports of
  [] => OkC modules
  imp :: rest =>
    Vuna.Compiler.Common.bind
      (loadModule (fuel - 1) roots selfPriv importerPkg modules stack (importName imp))
      (\modules2 => loadAll (fuel - 1) roots selfPriv importerPkg modules2 stack rest)

loadModule : Int -> List Root -> Bool -> String -> List Module -> List String -> String -> Check (List Module)
loadModule fuel roots selfPriv importerPkg modules stack name = if fuel <= 0 then icFuel "loader"
else case findModule modules name of
  Just m => OkC modules
  Nothing => if memName name stack then ldErr1 (ImportCycle (showCycle name stack)) (showCycle name stack)
  else if hostModuleIn roots name && not (importerPrivileged roots selfPriv importerPkg) then ldErr1 (HostModulePrivileged name) name
  else if validModuleName name then Vuna.Compiler.Common.bind (findModuleFile roots name importerPkg) (\found => let
    -- F3 P2：宿主层模块只允许特权包 import（base 自己/compiler/根工具链）。
    path = firstOf found
  in let
    root = secondOf found
    _ = note "parse-module=${name}"
  in Vuna.Compiler.Common.bind (parseFileWithPath path (runPure (prim_eff_readFile path))) (\src => case src of
    SourceFile hdr imports fixities decls => Vuna.Compiler.Common.bind (validateModuleHeader name hdr) (\_ => Vuna.Compiler.Common.bind (validateImports name imports) (\_ => Vuna.Compiler.Common.bind (implicitPrelude roots (rootName root) name imports) (\implicit => Vuna.Compiler.Common.bind (loadAll (fuel - 1) roots selfPriv (rootName root) modules (name :: stack) (append imports implicit)) (\modules2 => Vuna.Compiler.Common.bind (computeExports modules2 name hdr imports decls) (\exports => let
      visible =
        dedupeFixities (append fixities (visibleFixitiesOf modules2 (append imports implicit)))
    in OkC
      (Base.List.Cons (Module name (rootName root) imports implicit decls exports (rootCapabilities root) (rootTrustUnsafe root) visible (reexportedImportNamesOfHeader imports hdr)) modules2)
    )
    )
    )
    )
    )
  )
  )
  else ldErr1 (InvalidModuleName name) name

-- 包上下文入口：ctx 给出模块根（自己 lib 在最前 + 依赖闭包）与导入方包名
-- （决定同包/跨包导出可见性与 manifest 能力声明）。
-- loadProject 返回 flatten 前的形态（入口声明 + 依赖模块列表），供分离编译使用。
loadProject : PackageContext -> String -> Check Project
loadProject ctx entry = loadProjectWithPreloaded ctx entry []

-- M34.5（S2）：接口模式加载。`preloaded` 是依赖包里**已解析**的模块（来自模块接口），
-- 加载器把它们当「已加载模块」直接命中：不读源码、不 parse、不算导出表。本包模块与入口
-- 仍按源码加载；模块表的顺序约定与 `loadAll` 一致（新加载模块前插，dependents-first），
-- 所以调用方应把 `preloaded` 按 reverse(topo) 传入。
loadProjectWithPreloaded : PackageContext -> String -> List Module -> Check Project
loadProjectWithPreloaded ctx entry preloaded =
  let
    _ = resetWarnings 0
  in if runPure (prim_eff_fileExists entry) then Vuna.Compiler.Common.bind (parseFileWithPath entry (runPure (prim_eff_readFile entry))) (\src => case src of
    SourceFile hdr imports fixities decls => case hdr of
      Just (ModDecl dname hasList items sp) => ldErr1 (ModuleHeaderInEntryFile entry) entry
      Nothing =>
        Vuna.Compiler.Common.bind (validateImports "<entry>" imports)
          (\_ => Vuna.Compiler.Common.bind (implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports) (\implicit => Vuna.Compiler.Common.bind (loadAll 1048576 (contextRoots ctx) (contextPrivileged ctx) (contextPackageName ctx) preloaded [] (append imports implicit)) (\modules => OkC (Project decls imports implicit modules (contextPackageName ctx) (contextCapabilities ctx) (contextTrustUnsafe ctx) False fixities))))
  )
  else ldErr1 (EntryFileNotFound entry) entry

-- 库包入口：不带 app/Main.vuna 的包，以 [export].modules 作为根模块集合。
loadProjectModules : PackageContext -> List String -> Check Project
loadProjectModules ctx names = loadProjectModulesWithPreloaded ctx names []

loadProjectModulesWithPreloaded : PackageContext -> List String -> List Module -> Check Project
loadProjectModulesWithPreloaded ctx names preloaded =
  let
    _ = resetWarnings 0
    entryImports = map (\n => Import n False Nothing (Span "" 0 0 0 0)) names
  in Vuna.Compiler.Common.bind
    (loadAll 1048576 (contextRoots ctx) (contextPrivileged ctx) (contextPackageName ctx) preloaded [] entryImports)
    (\modules => OkC (Project [] [] [] modules (contextPackageName ctx) (contextCapabilities ctx) (contextTrustUnsafe ctx) True []))

-- 入口以**源码字符串**给出（REPL 的表达式求值）：入口不落盘（import 仍按上下文的
-- roots 从磁盘解析）；隐式 Prelude 与文件入口同规则（ad-hoc 单文件也自动注入）。
loadProjectSource : PackageContext -> String -> String -> Check Project
loadProjectSource ctx label source = loadProjectSourceWithPreloaded ctx label source []

-- M34.5（LSP/REPL 消费接口）：入口以源码字符串给出，依赖包模块可预置（零 parse）。
loadProjectSourceWithPreloaded : PackageContext -> String -> String -> List Module -> Check Project
loadProjectSourceWithPreloaded ctx label source preloaded =
  let
    _ = resetWarnings 0
  in Vuna.Compiler.Common.bind (parseFileWithPath label source) (\src => case src of
    SourceFile hdr imports fixities decls => case hdr of
      Just (ModDecl dname hasList items sp) => ldErr1 (ModuleHeaderInEntrySource label) label
      Nothing =>
        Vuna.Compiler.Common.bind (validateImports "<entry>" imports)
          (\_ => Vuna.Compiler.Common.bind (implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports) (\implicit => Vuna.Compiler.Common.bind (loadAll 1048576 (contextRoots ctx) (contextPrivileged ctx) (contextPackageName ctx) preloaded [] (append imports implicit)) (\modules => OkC (Project decls imports implicit modules (contextPackageName ctx) (contextCapabilities ctx) (contextTrustUnsafe ctx) False fixities))))
  )

-- 以**源码字符串**给出一个**库模块**（M30 · LSP）：源码允许带 `module ... where`
-- 头（LSP 打开 lib/ 下的文件时就是这种形态）。模块头存在时，按 import 闭包加载后
-- 把该模块本身作为合成的 `Module` 放进 Project，再交给 `resolveProject` 做名字解析；
-- 无模块头时退化为入口语义（与 `loadProjectSource` 相同）。
-- 入口声明保持为空：调用方（LSP）只需要逐模块已解析的声明。
loadModuleSource : PackageContext -> String -> String -> Check Project
loadModuleSource ctx label source = loadModuleSourceWithPreloaded ctx label source []

-- M34.5（LSP）：依赖包模块可预置（来自接口的 `Module`），只 parse 当前文件与同包源码。
loadModuleSourceWithPreloaded : PackageContext -> String -> String -> List Module -> Check Project
loadModuleSourceWithPreloaded ctx label source preloaded =
  let
    _ = resetWarnings 0
  in Vuna.Compiler.Common.bind (parseFileWithPath label source) (\src => case src of
    SourceFile hdr imports fixities decls => case hdr of
      Nothing => loadProjectSourceWithPreloaded ctx label source preloaded
      Just (ModDecl name hasList items sp) => Vuna.Compiler.Common.bind (validateImports name imports) (\_ => Vuna.Compiler.Common.bind (implicitPrelude (contextRoots ctx) (contextPackageName ctx) name imports) (\implicit => Vuna.Compiler.Common.bind (loadAll 1048576 (contextRoots ctx) (contextPrivileged ctx) (contextPackageName ctx) preloaded [] (append imports implicit)) (\modules => Vuna.Compiler.Common.bind (computeExports modules name hdr imports decls) (\exports => let
        visible =
          dedupeFixities (append fixities (visibleFixitiesOf modules (append imports implicit)))
      in OkC
        (Project [] imports implicit (Module name (contextPackageName ctx) imports implicit decls exports (contextCapabilities ctx) (contextTrustUnsafe ctx) visible (reexportedImportNames imports items) :: modules) (contextPackageName ctx) (contextCapabilities ctx) (contextTrustUnsafe ctx) False [])
      )
      )
      )
      )
  )

-- M31.3（B27）：fmt 用的「程序级 fixity」——本文件的 `infix*` 声明（在前，本地优先）
-- ++ import 闭包可见的声明（Module 里已含各自的 import 闭包）。只 parse + 加载模块图，
-- **不做精化/名字解析**，因此很便宜；有/无模块头都支持。
--
-- `modules` 是调用方可复用的已加载模块表（按包上下文缓存）：同包多文件只加载一次模块图。
-- 但 fixity **声明表必须按文件重算**（local + 该文件自己的 import 闭包）——不同文件的
-- imports 不同，跨文件复用声明表会让 fmt 给 `::`/`+` 等打出错误的括号。
-- 返回值同时带回更新后的模块表，供调用方继续复用。
-- 注意：本函数及其包装进 seed 闭包（compiler 包），保持小而纯。
fixitiesForSourceIn : PackageContext -> List Module -> String -> String -> Check (Pair (List Module) (List FixityDecl))
fixitiesForSourceIn ctx modules0 label source = Vuna.Compiler.Common.bind (parseFileWithPath label source) (\src => case src of
  SourceFile hdr imports fixities decls => case hdr of
    Nothing =>
      Vuna.Compiler.Common.bind (validateImports label imports)
        (\_ => Vuna.Compiler.Common.bind (implicitPrelude (contextRoots ctx) (contextPackageName ctx) "" imports) (\implicit => Vuna.Compiler.Common.bind (loadAll 1048576 (contextRoots ctx) (contextPrivileged ctx) (contextPackageName ctx) modules0 [] (append imports implicit)) (\modules => OkC (Pair modules (dedupeFixities (append fixities (visibleFixitiesOf modules (append imports implicit))))))))
    Just (ModDecl name hasList items sp) =>
      Vuna.Compiler.Common.bind (validateImports name imports)
        (\_ => Vuna.Compiler.Common.bind (implicitPrelude (contextRoots ctx) (contextPackageName ctx) name imports) (\implicit => Vuna.Compiler.Common.bind (loadAll 1048576 (contextRoots ctx) (contextPrivileged ctx) (contextPackageName ctx) modules0 [] (append imports implicit)) (\modules => OkC (Pair modules (dedupeFixities (append fixities (visibleFixitiesOf modules (append imports implicit))))))))
)

-- 单文件便捷入口（LSP formatting / fmt 探针）：不跨调用复用模块表。
fixitiesForSource : PackageContext -> String -> String -> Check (List FixityDecl)
fixitiesForSource ctx label source =
  Vuna.Compiler.Common.bind (fixitiesForSourceIn ctx [] label source) (\p => OkC (secondOf p))

-- 返回逐模块已解析（未 flatten）的声明，供 M12 分离编译使用。
resolveProject : Project -> Check (Pair (List Decl) (List Module))
resolveProject project = resolveProjectKeeping [] project

-- M34.5（S2）：`keep` 里的模块已经解析过（来自接口文件），原样保留、不重解析。
resolveProjectKeeping : List String -> Project -> Check (Pair (List Decl) (List Module))
resolveProjectKeeping keep (Project decls imports implicit modules entryPkg entryCaps entryTrust complete entryFixes) =
  let
    entryTable =
      tableOf
        (dedupeFixities (append entryFixes (visibleFixitiesOf modules (append imports implicit))))
  in let
    _ = resetUsedImports 0
  in Vuna.Compiler.Common.bind (reorderProgram entryTable decls) (\decls2 => Vuna.Compiler.Common.bind (resolveEntry modules entryPkg entryCaps entryTrust (append imports implicit) decls2) (\entryDecls => let
    _ = warnImportsList imports (takeUsedImports 0)
  in Vuna.Compiler.Common.bind (resolveModulesKeep keep modules)
    (\modules2 => Vuna.Compiler.Common.bind (checkTrustPoints entryPkg entryTrust complete entryDecls modules2) (\_ => OkC (Pair entryDecls modules2)))
  )
  )

resolveModulesKeep : List String -> List Module -> Check (List Module)
resolveModulesKeep keep [] = OkC []
resolveModulesKeep keep ((Module name pkg imports implicit decls exports mcaps mtrust fixities reexports) :: rest) = if memName name keep then Vuna.Compiler.Common.bind (resolveModulesKeep keep rest)
  (\d2 => OkC (Base.List.Cons (Module name pkg imports implicit decls exports mcaps mtrust fixities reexports) d2))
else
  let
    _ = resetUsedImports 0
  in Vuna.Compiler.Common.bind (reorderProgram (tableOf fixities) decls) (\decls2 => Vuna.Compiler.Common.bind (resolveProgram (Module name pkg imports implicit decls2 exports mcaps mtrust fixities reexports :: rest) name name (namespacesOf decls2) (append imports implicit) decls2) (\d => Vuna.Compiler.Common.bind (checkEffectsBuiltins name pkg mcaps mtrust d) (\d1 => let
    -- M45：`module X` 重导出使用的 import 在加载期标记、被上面的 reset 清掉，这里补回。
    _ = warnImportsList imports (append (takeUsedImports 0) reexports)
  in Vuna.Compiler.Common.bind (resolveModulesKeep keep rest)
    (\d2 => OkC (Base.List.Cons (Module name pkg imports implicit d1 exports mcaps mtrust fixities reexports) d2))
  )
  )
  )

dropPastSlash : List Int -> List Int
dropPastSlash [] = []
dropPastSlash (c :: rest) = if c == 47 then rest else dropPastSlash rest

parentOfPath : String -> String
parentOfPath path =
  let
    chars = strUnpack path
    rev = reverse chars
    after = dropPastSlash rev
  in if length after == length rev then "."
  else
    let
      parent = strPack (reverse after)
    in if parent == "" then if startsWith "/" path then "/" else "."
    else if startsWith "/" path && not (startsWith "/" parent) then "/${parent}" else parent

-- ---------------------------------------------------------------
-- unused import warning：显式 import 未在所属检查单元的名字解析中被使用。
-- （隐式 Prelude 不参与；按模块重置 used-set，避免跨模块误抑制。）
-- ---------------------------------------------------------------
warnImportsList : List Import -> List String -> Int
warnImportsList [] used = 0
warnImportsList (imp :: rest) used =
  let
    _ =
      if memName imp.importName used then 0
      else warnAt1Mod
        (\d => withSuggestion (Suggestion "remove unused import ${imp.importName}" MachineApplicable [DiagEdit (importRemovalSpan imp.importSpan) ""]) d)
        imp.importSpan (UnusedImport imp.importName) imp.importName
  in warnImportsList rest used

-- 整行删除 import 的编辑 span：从行首到下一行行首（含换行）。
importRemovalSpan : Span -> Span
importRemovalSpan sp = Span (spanFile sp) (spanStartLine sp) 1 (spanStartLine sp + 1) 1
