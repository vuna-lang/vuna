module Vuna.Compiler.Loader.Modules where

-- Vuna.Compiler.Loader.Modules：加载器的**数据与模块图**（叶子层，无跨 Loader 子模块依赖）。
--
-- 只放：Module / Project / ExportEntry / ExportRef 的类型与访问器、import 表的纯函数
-- 校验、模块根查找（`findModuleFile`）、模块表与导出表的查询。名字解析在 Resolve，
-- 导出表计算、加载流程与 flatten 在 Flatten；门面 `Vuna.Compiler.Loader` 保持原 API。
import Vuna.Compiler.Loader.Diagnostics
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Rn
import Base.HashMap
import Base.List
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Base.Eq
import Vuna.Compiler.Packages.Pkg

-- 显式 import 与自动注入的 Prelude（隐式 import）分开保存：
-- 名字解析与 codegen 拓扑序用 all；模块重导出/include 只认显式 import。
-- M31.2：最后一个字段是**可见 fixity 表**（本模块声明 + imports 闭包，查找时本模块优先；
-- 中缀重排见 `Loader.Fixity`）。
export record Module(..) where
  moduleNameOf : String
  modulePackageOf : String
  moduleImportsOf : List Import
  moduleImplicitImportsOf : List Import
  moduleDeclsOf : List Decl
  moduleExportsOf : List ExportEntry
  moduleFixitiesOf : List FixityDecl
  -- | M45：模块头导出列表里 `module X` 重导出的 import 名（`import X` / `import X as Y`
  -- 统一成 `X`）。resolve 期把它们并入 used-import 集合，`UN_UnusedImport` 才不会把
  -- 「只用于重导出」的 import 报成未使用（used-set 在加载期标记、resolve 期被重置）。
  moduleReexportsOf : List String
  -- D11：本模块声明为 opaque 的定义全名（已 mangle）；下游 depStart 不把它们的体放进 deftbl。
  moduleOpaqueOf : List String

-- 已加载项目：入口声明/import + 依赖模块列表（M12 分离编译用；保持 flatten 前的形态）。
-- entryPkg 用于按包限制 effectful 内建（M12.6：普通包只能经 Eff + handler 使用效果）。
-- M31.2：entryFixities 是入口文件自己的 fixity 声明（入口 decls 的重排要用）。
export record Project(..) where
  projectEntryDecls : List Decl
  projectEntryImports : List Import
  projectImplicitImports : List Import
  projectModules : List Module
  projectEntryPkg : String
  projectEntryFixities : List FixityDecl

export moduleNameOf : Module -> String
moduleNameOf (Module n p is imps ds es fx _ _) = n

export modulePackageOf : Module -> String
modulePackageOf (Module n p is imps ds es fx _ _) = p

export moduleAllImportsOf : Module -> List Import
moduleAllImportsOf (Module n p is imps ds es fx _ _) = append is imps

export moduleDeclsOf : Module -> List Decl
moduleDeclsOf (Module n p is imps ds es fx _ _) = ds

export moduleFixitiesOf : Module -> List FixityDecl
moduleFixitiesOf (Module n p is imps ds es fx _ _) = fx

-- | M45：模块重导出的 import 名（见 Module 字段注释）。
export moduleReexportsOf : Module -> List String
moduleReexportsOf (Module n p is imps ds es fx reexports _) = reexports

export moduleOpaqueOf : Module -> List String
moduleOpaqueOf (Module n p is imps ds es fx reexports opacity) = opacity

export projectEntryAllImports : Project -> List Import
projectEntryAllImports (Project ds is imps ms pkg fx) = append is imps

-- M28（B18）：解析期的三个命名空间，与导出表 kind 一一对应，**不再拍平**。
--   values = 值命名空间（DFun / 签名 / 实例名；导出 kind "val"）
--   ctors  = 构造子命名空间（data 构造子 / record 名 / trait 方法；导出 kind "ctor"）
--   types  = 类型命名空间（data / record / trait 的类型名；导出 kind "type"）
-- 解析位置决定查哪个表：类型位置只查 types；值位置按 values → ctors → types（类型当项）。
export record Namespaces(..) where
  nsValues : List String
  nsCtors : List String
  nsTypes : List String
  -- M34：解析期查找的 O(1) 版本（每个 EVar 都会查这三个集合；list 线性查找在几十万
  -- 节点上是主要 resolve 成本）。list 字段保留给错误提示的 suggest。
  nsValueSet : HashMap String Bool
  nsCtorSet : HashMap String Bool
  nsTypeSet : HashMap String Bool
  -- M41：data/record 构造子的候选表（短名 → 未加模块 prefix 的 "Data.Ctor"）。
  -- 同名构造子按族区分；trait 方法不在此表（不是族的构造子）。
  nsCtorCands : List (Pair String String)
  -- release 构建模式：Resolve 的 assert/todo 拒绝检查用（显式传入，不读进程环境）。
  nsRelease : Bool

-- 字段访问按全局唯一字段名解析（Elab 降级成模式绑定）；构造用命名字段。
-- 模块导出表（M10）。每条是「本模块公开名 → 定义处带模块前缀的名字」。
-- kind 用字符串区分两套命名空间：val（函数/值）、ctor（构造器）、type（类型名）。
-- ctor 条目额外记录所属数据类型的定义名，供 `T(..)` 重导出保持源模块的抽象性。
-- 模块导出表条目：公开名、定义处名字、所属类型（仅 ctor）。
export record ExportEntry(..) where
  kind : String
  public : String
  target : String
  parent : String
deriving (Eq)

export record ExportRef(..) where
  refKind : String
  refTarget : String
  refParent : String

allIdentChars : List Int -> Bool
allIdentChars [] = True
allIdentChars (c :: rest) = (isIdentStart c || isDigit c) && allIdentChars rest

validSegment : String -> Bool
validSegment seg = case strUnpack seg of
  [] => False
  c :: rest => isUpperChar c && allIdentChars rest

allSegmentsValid : List String -> Bool
allSegmentsValid [] = False
allSegmentsValid (seg :: rest) = if validSegment seg then case rest of
  [] => True
  _ => allSegmentsValid rest
else False

export validModuleName : String -> Bool
validModuleName name = case splitOnDot name of
  [] => False
  segs => allSegmentsValid segs

export mangle : String -> String -> String
mangle prefix name = if prefix == "" then name else "${prefix}.${name}"

-- M41：构造子 canonical 名 = `Module.Data.Ctor`（entry 文件 `Data.Ctor`）。
-- 不同数据类型的同名构造子因此天然不冲突；裸名按期望类型在候选里选（见 Resolve/Elab）。
-- | 自动补注（M41 新增导出）：ctorCanonical。
export ctorCanonical : String -> String -> String -> String
ctorCanonical prefix dname cname = mangle prefix "${dname}.${cname}"

export importName : Import -> String
importName (Import name isQualified alias sp) = name

export importModuleNames : List Import -> List String
importModuleNames imports = map importName imports

hasDuplicateName : List String -> Bool
hasDuplicateName [] = False
hasDuplicateName (x :: rest) = memName x rest || hasDuplicateName rest

importAliases : List Import -> List (Pair String String)
importAliases [] = []
importAliases (imp :: rest) = case imp.importAlias of
  Nothing => importAliases rest
  Just alias => Pair alias (importName imp) :: importAliases rest

checkImportAliases : String -> List String -> List (Pair String String) -> Check (List a)
checkImportAliases label moduleNames [] = OkC []
checkImportAliases label moduleNames ((Pair alias m) :: rest) =
  if validSegment alias then if memName alias (map firstOf rest) then rnNoLoc1 (DuplicateModuleAlias alias) alias
  else if memName alias moduleNames then if alias == m then checkImportAliases label moduleNames rest
  else rnNoLoc1 (ModuleAliasConflict alias) alias
  else checkImportAliases label moduleNames rest
  else rnNoLoc1 (InvalidModuleAlias alias) alias

export validateImports : String -> List Import -> Check (List a)
validateImports label imports =
  if hasDuplicateName (importModuleNames imports) then rnNoLoc0 DuplicateImport
  else checkImportAliases label (importModuleNames imports) (importAliases imports)

openModuleNames : List Import -> List String
openModuleNames [] = []
openModuleNames (imp :: rest) =
  if imp.importIsQualified then openModuleNames rest
  else Base.List.Cons (importName imp) (openModuleNames rest)

-- 纯查找（不标记 used）：`import X` 或 `import X as Y` 里 `name` 对应的 import 模块名。
export findImportModule : List Import -> String -> Maybe String
findImportModule [] _ = Nothing
findImportModule (imp :: rest) name = if importName imp == name then Just (importName imp)
else case imp.importAlias of
  Just alias => if alias == name then Just (importName imp) else findImportModule rest name
  Nothing => findImportModule rest name

export findImportPrefix : List Import -> String -> Maybe String
findImportPrefix imports prefix = findImportModule imports prefix

-- 模块头导出列表里 `module X` 对应的 import 名（去重、保持出现顺序）。加载期算好放进
-- `Module.moduleReexportsOf`，resolve 期并入 used-import 集合（M45）。
export reexportedImportNames : List Import -> List ExportItem -> List String
reexportedImportNames imports items = reexportedImportNamesGo imports items []

reexportedImportNamesGo : List Import -> List ExportItem -> List String -> List String
reexportedImportNamesGo imports [] acc = Base.List.reverse acc
reexportedImportNamesGo imports ((XModule name _) :: rest) acc = case findImportModule imports name of
  Nothing => reexportedImportNamesGo imports rest acc
  Just m =>
    if memName m acc then reexportedImportNamesGo imports rest acc
    else reexportedImportNamesGo imports rest (Base.List.Cons m acc)
reexportedImportNamesGo imports (_ :: rest) acc = reexportedImportNamesGo imports rest acc

-- | 有显式导出列表时才算重导出；无 module 头 / 隐式导出 = []。
export reexportedImportNamesOfHeader : List Import -> Maybe ModDecl -> List String
reexportedImportNamesOfHeader imports (Just (ModDecl _ True items _ _ _ _)) =
  reexportedImportNames imports items
reexportedImportNamesOfHeader imports _ = []

_joinNames : List String -> String
_joinNames [] = ""
_joinNames ([x]) = x
_joinNames (x :: rest) = "${x}, ${_joinNames rest}"

-- M24.7：查一个**必须已加载**的模块。旧实现把「模块未加载」当成「空表」
-- （`moduleDecls` / `exportsOf` 的 `Nothing => []`）：调用方只看到「没有这个导出」，
-- 于是一个加载器状态不一致被伪装成普通的「名字不存在」，错误被静默吞掉。
-- 现在缺模块直接返回清晰的 Err（这是内部不变量，不是用户源码错误）。
missingModule : String -> Check a
missingModule name =
  icInternal "module ${name} is not loaded (import list and module table disagree)"

export moduleDecls : List Module -> String -> Check (List Decl)
moduleDecls modules name = case findModule modules name of
  Just (Module mname mpkg imports imps decls exports fx _ _) => OkC decls
  Nothing => missingModule name

moduleCtors : List Module -> String -> Check (List String)
moduleCtors modules name =
  Vuna.Compiler.Common.bind (moduleDecls modules name) (\decls => OkC (ctorsOf decls))

export exportsOf : List Module -> String -> Check (List ExportEntry)
exportsOf modules name = case findModule modules name of
  Just (Module mname mpkg imports imps decls exports fx _ _) => OkC exports
  Nothing => missingModule name

-- 按命名空间查公开名：kinds 是允许的 kind 列表（val / ctor / type）。
lookupExport : List String -> String -> List ExportEntry -> Maybe ExportEntry
lookupExport kinds name [] = Nothing
lookupExport kinds name (e :: rest) =
  if memName e.kind kinds && e.public == name then Just e else lookupExport kinds name rest

export findExportValue : List ExportEntry -> String -> Maybe ExportEntry
findExportValue entries name = lookupExport ["val", "ctor"] name entries

export findExportCtor : List ExportEntry -> String -> Maybe ExportEntry
findExportCtor entries name = lookupExport ["ctor"] name entries

-- M41：同名构造子可以有多条导出（不同族、不同 target）。裸名解析要拿全集。
-- | 自动补注（M41 新增导出）：findExportCtors。
export findExportCtors : List ExportEntry -> String -> List ExportEntry
findExportCtors entries name = filterCtors name entries

-- | 自动补注（M41 新增导出）：filterCtors。
filterCtors : String -> List ExportEntry -> List ExportEntry
filterCtors name [] = []
filterCtors name (e :: rest) =
  if e.kind == "ctor" && e.public == name then Base.List.Cons e (filterCtors name rest)
  else filterCtors name rest

export findExportType : List ExportEntry -> String -> Maybe ExportEntry
findExportType entries name = lookupExport ["type"] name entries

modulesExportingValueFrom : List Module -> List String -> String -> Check (List (Pair String ExportEntry))
modulesExportingValueFrom modules [] name = OkC []
modulesExportingValueFrom modules (m :: rest) name = Vuna.Compiler.Common.bind (exportsOf modules m) (\es => case findExportValue es name of
  Just e =>
    Vuna.Compiler.Common.bind (modulesExportingValueFrom modules rest name)
      (\more => OkC (Base.List.Cons (Pair m e) more))
  Nothing => modulesExportingValueFrom modules rest name
)

export modulesExportingValue : List Module -> List Import -> String -> Check (List (Pair String ExportEntry))
modulesExportingValue modules imports name =
  modulesExportingValueFrom modules (openModuleNames imports) name

-- | 自动补注（M41 新增导出）：modulesExportingCtorFrom。
modulesExportingCtorFrom : List Module -> List String -> String -> Check (List (Pair String ExportEntry))
modulesExportingCtorFrom modules [] name = OkC []
modulesExportingCtorFrom modules (m :: rest) name = Vuna.Compiler.Common.bind (exportsOf modules m) (\es => let
  found = findExportCtors es name
in Vuna.Compiler.Common.bind (modulesExportingCtorFrom modules rest name)
  (\more => OkC (append (map (\e => Pair m e) found) more))
)

export modulesExportingCtor : List Module -> List Import -> String -> Check (List (Pair String ExportEntry))
modulesExportingCtor modules imports name =
  modulesExportingCtorFrom modules (openModuleNames imports) name

modulesExportingTypeFrom : List Module -> List String -> String -> Check (List (Pair String ExportEntry))
modulesExportingTypeFrom modules [] name = OkC []
modulesExportingTypeFrom modules (m :: rest) name = Vuna.Compiler.Common.bind (exportsOf modules m) (\es => case findExportType es name of
  Just e =>
    Vuna.Compiler.Common.bind (modulesExportingTypeFrom modules rest name)
      (\more => OkC (Base.List.Cons (Pair m e) more))
  Nothing => modulesExportingTypeFrom modules rest name
)

export modulesExportingType : List Module -> List Import -> String -> Check (List (Pair String ExportEntry))
modulesExportingType modules imports name =
  modulesExportingTypeFrom modules (openModuleNames imports) name

-- 重导出时同名可能来自多个模块；只要 target 相同就不是歧义（门面伞模块常见）。
sameTargetRest : ExportEntry -> List (Pair a ExportEntry) -> Bool
sameTargetRest e [] = True
sameTargetRest e ((Pair m e2) :: rest) = e.target == e2.target && sameTargetRest e rest

export unifyEntryPairs : String -> String -> String -> List (Pair String ExportEntry) -> Check (Pair String ExportEntry)
unifyEntryPairs label kindLabel name [] = icInternal "unifyEntryPairs: empty candidates"
unifyEntryPairs label kindLabel name (p :: rest) =
  if sameTargetRest (secondOf p) rest then OkC p
  else err
    "${label}: ambiguous ${kindLabel} ${name} (imported from ${_joinNames (map firstOf (p :: rest))}); qualify it"

modulePath : Root -> String -> String
modulePath root name = "${rootDir root}/${joinSlashes (splitOnDot name)}.vuna"

-- 当前导入方所在包能否看到该 root 中的模块：同包永远可见；跨包只认 [export] 列表。
rootAllows : String -> Root -> String -> Bool
rootAllows importerPkg root name = case root.rootExports of
  Nothing => True
  Just mods => rootName root == importerPkg || memName name mods

-- M4（效果显式化）：模块根候选的**存在性探测**是宿主动作，显式在 `Eff []` 里；
-- 可见性判定与候选分类保持纯。
export collectModuleFiles : List Root -> String -> String -> List (Pair String Root) -> List String -> Eff [] (Pair (List (Pair String Root)) (List String))
collectModuleFiles [] name importerPkg allowed hidden =
  pure (Pair (reverse allowed) (reverse hidden))
collectModuleFiles (root :: rest) name importerPkg allowed hidden =
  let
    path = modulePath root name
  in do
    exists <- prim_eff_fileExists path
    if exists then if rootAllows importerPkg root name then collectModuleFiles rest name importerPkg (Pair path root :: allowed) hidden
    else collectModuleFiles rest name importerPkg allowed (rootName root :: hidden)
    else collectModuleFiles rest name importerPkg allowed hidden

_joinRootDirs : List Root -> String
_joinRootDirs roots = _joinNames (map rootDir roots)

candidateDir : Pair String Root -> String
candidateDir candidate = rootDir (secondOf candidate)

export findModuleFile : List Root -> String -> String -> Eff [] (Check (Pair String Root))
findModuleFile roots name importerPkg = do
  collected <- collectModuleFiles roots name importerPkg [] []
  let
    allowed = firstOf collected
    hidden = secondOf collected
  in pure (case allowed of
    [] => case hidden of
      [] => ldErr2 (ModuleNotFound name (_joinRootDirs roots)) name (_joinRootDirs roots)
      pkgs => ldErr2 (ModuleNotExported name (_joinNames hidden)) name (_joinNames hidden)
    [only] => OkC only
    candidates =>
      rnNoLoc2 (AmbiguousModule name (_joinNames (map candidateDir allowed))) name
        (_joinNames (map candidateDir allowed))
  )

export findModule : List Module -> String -> Maybe Module
findModule [] name = Nothing
findModule ((Module mname mpkg imports imps decls exports fx reexports opacity) :: rest) name =
  if mname == name then Just (Module mname mpkg imports imps decls exports fx reexports opacity)
  else findModule rest name

-- M41：target 是否是某个 data/record 的构造子（用于把 trait method 从“构造子重载候选”
-- 里排除；trait method 不是族的构造子，仍按原名字解析）。
-- | 自动补注（M41 新增导出）：isDataOrRecordCtorTarget。
export isDataOrRecordCtorTarget : List Module -> String -> Bool
isDataOrRecordCtorTarget [] target = False
isDataOrRecordCtorTarget (m :: rest) target =
  isCtorTargetInDecls (moduleNameOf m) target (moduleDeclsOf m)
    || isDataOrRecordCtorTarget rest target

-- | 自动补注（M41 新增导出）：isCtorTargetInDecls。
isCtorTargetInDecls : String -> String -> List Decl -> Bool
isCtorTargetInDecls mname target [] = False
isCtorTargetInDecls mname target (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp =>
    anyCtorTarget mname dname target ctors || isCtorTargetInDecls mname target rest
  DRecord dname params fields derivings viaField repr lin sp =>
    mangle mname dname == target || isCtorTargetInDecls mname target rest
  _ => isCtorTargetInDecls mname target rest

-- | 自动补注（M41 新增导出）：anyCtorTarget。
anyCtorTarget : String -> String -> String -> List Ctor -> Bool
anyCtorTarget mname dname target [] = False
anyCtorTarget mname dname target (c :: rest) =
  ctorCanonical mname dname (ctorName c) == target || anyCtorTarget mname dname target rest
