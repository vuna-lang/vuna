  , findExportType
  , findExportValue
  , findImportPrefix
  , findModule
  , findModuleFile
  , importModuleNames
  , importName
  , mangle
  , moduleAllImportsOf
  , moduleCapabilities
  , moduleDeclsOf
  , moduleExportsOf
  , moduleImplicitImportsOf
  , moduleImportsOf
  , moduleNameOf
  , modulePackageOf
  , modulesExportingCtor
  , modulesExportingType
  , modulesExportingValue
  , projectEntryAllImports
  , projectEntryCapabilities
