module Vuna.Compiler.Loader.Resolve
  ( checkEffectsBuiltins
  , checkTrustPoints
  , namespacesOf
  , resolveEntry
  , resolveProgram
  ) where

-- Vuna.Compiler.Loader.Resolve：名字解析（M24 后维护（源码重组）从 Loader.vuna 拆出）。
--
-- 从模块/导出表查询（`Loader.Modules`）出发，把 parse 后的声明与表达式解析成带模块前缀
-- 的名字；同时负责 DT prelude 名字放行、effectful 内建的包级限制（原
-- `Vuna.Compiler.Loader.Builtins` 的 `builtinArity` 已按源码重组计划合并进来）。
-- 导出表计算、加载流程与 flatten 在 `Loader.Flatten`。
import Vuna.Compiler.Frontend.Diagnostics
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Loader.Modules
import Vuna.Compiler.Intrinsics

-- 解析器递归的显式 fuel（M30/C27：保留 1G，逐点写清楚 measure 与上界）。
--
-- **为什么不是结构递归**：这里的递归原则上沿 AST 的真子项下降（表达式子项、模式
-- 子项、绑定列表的 tail），但实现经 `andThen` 闭包转发，SCT 判据看不到「同一形参
-- 位置严格递减」；且入口函数在 Decl / Expr / Pat 三种类型间互递归，不存在单一形参
-- 测度。因此保留显式 fuel + 递减（R2「守卫 Int」判据）。
--
-- **measure**：每个带 fuel 的入口在 `if fuel <= 0` 守卫下、每次递归传 `fuel - 1`；
-- 沿任一条调用路径（同一次种子内）步数 ≤ 该路径消费的 AST 节点数 × 小常数
-- （每个 andThen 链接 1 步，无状态机回读）。`resolveFuelBound` 作为**每个子项**
-- 的新种子（`resolvePattern resolveFuelBound` / `resolveTypeExpr resolveFuelBound`
-- 等）：重播种点都位于当前项的真子项上（模式的字段、声明的方法体、ctor 的 kind），
-- 所以不会形成同一项上的自环；子项个数有限 ⇒ 总调用数有限。
--
-- **上界**：1G 远大于任何可由内存构造的 AST 的节点数（单个 AST 节点至少 ~32 字节，
-- 1G 节点 ≥ 32 GiB 不可构造），故合法输入不会耗尽；耗尽时是明确的 internal 错误
-- （`resolve fuel exhausted`），不会静默返回半解析结果。
resolveFuelBound : Int
resolveFuelBound = 1073741824

-- 内建函数的名字与元数：唯一真源是 `Vuna.Compiler.Intrinsics`（M27）。
builtinArity : String -> Maybe Int
builtinArity name = case findIntrinsic name of
  Just i => if intrinsicVisible i then Just (intrinsicArity i) else Nothing
  Nothing => Nothing

isBuiltinName : String -> Bool
isBuiltinName name = case builtinArity name of
  Just arity => True
  Nothing => False

-- DT prelude 里在 Loader 阶段必须放行的名字（M20）。
--
-- DT 单文件时这些名字由 `Elab.Prelude.preludeGlobals` 直接提供，Loader 不参与；M20 起
-- `--dt` 复用 Loader，于是 `Int` / `String` / `Bool` / 运算符号 / `str*` 都要能被解析。
-- 这里只放行**纯解析**，语义仍由 `Elab` 的 prelude 决定。
--
-- M24.7：`show` / `eq` / `neq` / `lt` / `le` / `gt` / `ge` 已从放行表移除——trait 与
-- 实例迁到库（`Base.Show` / `Base.Eq` / `Base.Ord`），裸名必须经 import 的导出表解析。
isDtPreludeName : String -> Bool
isDtPreludeName name = memName name dtPreludeNames

dtPreludeNames : List String
dtPreludeNames = append ["Type", "->", "_"] (append preludeTypeNames preludeValueNames)

-- M31.2：运算符别名替换与中缀重排已由 `Loader.Fixity` 在 resolve **之前**完成
-- （`==` 等已变成 `eq` 等名字），这里不再有运算符别名表。
-- M24.7：trait 迁到库后，缺 import 是最常见的错误来源。除了常规的
-- unbound/unknown 诊断，再给一条可操作提示（单文件 / 未 import 的场景）。
traitImportHint : String -> String
traitImportHint "Show" = " (trait Show is not in scope; add `import Base.Show`)"
traitImportHint "Eq" = " (trait Eq is not in scope; add `import Base.Eq`)"
traitImportHint "Ord" = " (trait Ord is not in scope; add `import Base.Ord`)"
traitImportHint "show" = " (trait method show; add `import Base.Show`)"
traitImportHint "eq" = " (trait method eq; add `import Base.Eq`)"
traitImportHint "neq" = " (trait method neq; add `import Base.Eq`)"
traitImportHint "lt" = " (trait method lt; add `import Base.Ord`)"
traitImportHint "le" = " (trait method le; add `import Base.Ord`)"
traitImportHint "gt" = " (trait method gt; add `import Base.Ord`)"
traitImportHint "ge" = " (trait method ge; add `import Base.Ord`)"
traitImportHint _ = ""

-- ---------------------------------------------------------------
-- M28（B18）：type / value / ctor 三个命名空间（不再拍平成一个表）
-- ---------------------------------------------------------------
-- 本模块声明按 decl 形状归入各自命名空间。旧实现把 `own` 写成
-- 「topNames ++ typeNamesOf」、把 `ownTypes` 写成「ctors ++ 全部名字」，三者混用，
-- 于是类型名在值位置、值名在类型位置都能命中，Elab 再靠「kind 是不是宇宙」兜住。
-- 现在每个解析入口只查与自己位置对应的表（见 `Namespaces`）。
--
-- 注意 trait 方法按**构造子**命名空间处理，与导出表把方法记成 "ctor" kind 一致；
-- record 名同时是类型名与构造子（两处都登记）。
declValueNames : Decl -> List String
declValueNames d = case d of
  DFun name pats body sp => [name]
  DSig name ctx ty sp => [name]
  -- M28：axiom 是无体的值命名空间条目（类型层使用；运行时使用由 Elab/Codegen 拒绝）。
  DAxiom name ty sp => [name]
  DExtern name cName ty sp => [name]
  DInstance ctxE head methods sp => []
  _ => []

-- 值命名空间：DFun / 签名 / 实例名。
valueNamesOf : List Decl -> List String
valueNamesOf decls = concatMap declValueNames decls

-- 从声明列表算出三个命名空间（Loader 入口与 Flatten 的分离编译入口共用）。
-- M41：data/record 构造子的候选表。第二段是**未加模块 prefix**的族限定名：
--   data 构造子 -> "Data.Ctor"；record 构造子 -> "Record"（构造子名 = 类型名）。
-- trait 方法不在其中（不是族的构造子，仍按原名字解析）。
-- | 自动补注（M41 新增导出）：ctorCandsOf。
ctorCandsOf : List Decl -> List (Pair String String)
ctorCandsOf [] = []
ctorCandsOf (d :: rest) = case d of
  DData dname params kind ctors derivings viaField lin sp =>
    append (map (\c => Pair (ctorName c) "${dname}.${ctorName c}") ctors) (ctorCandsOf rest)
  DRecord dname params fields derivings viaField lin sp => Pair dname dname :: ctorCandsOf rest
  _ => ctorCandsOf rest

namespacesOf : List Decl -> Namespaces
namespacesOf decls =
  let
    vals = valueNamesOf decls
    cts = ctorsOf decls
    tys = typeNamesOf decls
    cands = ctorCandsOf decls
  in Namespaces { nsValues = vals, nsCtors = cts, nsTypes = tys, nsValueSet = Base.HashMap.ofNames vals, nsCtorSet = Base.HashMap.ofNames cts, nsTypeSet = Base.HashMap.ofNames tys, nsCtorCands = cands }

-- 本模块内某个短名的构造子 canonical 目标（含 record）。
-- | 自动补注（M41 新增导出）：localCtorTargets。
localCtorTargets : String -> Namespaces -> String -> List String
localCtorTargets prefix ns name =
  map (\p => mangle prefix (secondOf p)) (filter (\p => firstOf p == name) ns.nsCtorCands)

-- | 自动补注（M41 新增导出）：localCtorTarget。
localCtorTarget : String -> Namespaces -> String -> Maybe String
localCtorTarget prefix ns name = case localCtorTargets prefix ns name of
  [t] => Just t
  _ => Nothing

-- M41：构造子候选 = 本模块 data/record 构造子 ∪ 所有 open import 里的
-- data/record 构造子（trait method 不参与；本地不再无条件遮蔽 import）。
-- | 自动补注（M41 新增导出）：dedupeTargets。
dedupeTargets : List String -> List String
dedupeTargets [] = []
dedupeTargets (t :: rest) = if memName t rest then dedupeTargets rest else t :: dedupeTargets rest

-- 从 (module, ExportEntry) 取 target（lambda 里直接字段访问在 vuna 里不可用）。
-- | 自动补注（M41 新增导出）：pairExportTarget。
pairExportTarget : Pair String ExportEntry -> String
pairExportTarget p = (secondOf p).target

-- | 自动补注（M41 新增导出）：pairIsDataCtor。
pairIsDataCtor : List Module -> Pair String ExportEntry -> Bool
pairIsDataCtor modules p = isDataOrRecordCtorTarget modules (pairExportTarget p)

-- | 自动补注（M41 新增导出）：importedCtorTargets。
importedCtorTargets : List Module -> List Import -> String -> Result (List String)
importedCtorTargets modules imports name =
  andThen (modulesExportingCtor modules imports name)
    (\pairs => Ok (dedupeTargets (map pairExportTarget (filter (pairIsDataCtor modules) pairs))))

-- | 自动补注（M41 新增导出）：ctorCandidates。
ctorCandidates : List Module -> String -> Namespaces -> List Import -> String -> Result (List String)
-- 与本地**类型名**同名的构造子（record 构造子 / `data Pair where Pair` 的双命名空间）
-- 保持词法遮蔽：本地优先，不并入 import 候选。纯构造子名（`Nil` 等）才做 union。
ctorCandidates modules prefix ns imports name = andThen (importedCtorTargets modules imports name) (\imp => let
  local = localCtorTargets prefix ns name
in if notEmptyList local && name /= "Nil" && name /= "Cons" then Ok local
else Ok (dedupeTargets (append local imp))
)

-- | 自动补注（M41 新增导出）：notEmptyList。
notEmptyList : List a -> Bool
notEmptyList [] = False
notEmptyList (_ :: rest) = True

resolveQualified : List Module -> String -> List Import -> String -> Result String
resolveQualified modules label imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      prefix = joinDots revPrefix
    in case findImportPrefix imports prefix of
      Nothing => Err "${label}: module ${prefix} is not imported"
      Just m => andThen (exportsOf modules m) (\es => case findExportValue es base of
        Just e => Ok e.target
        Nothing => case findExportCtor es base of
          Just e => Ok e.target
          -- 类型作为项：导入模块的类型名与本地类型名一样可以出现在值位置
          -- （显式 `(a : Type)` 实参），排在值 / 构造子之后。
          Nothing => case findExportType es base of
            Just e => Ok e.target
            Nothing => Err "${label}: ${base} is not exported by ${m}"
      )

-- M41：`Family.Ctor` / `Module.Data.Ctor`：前缀先按类型命名空间解析，再在族里找短名。
-- 本地族从 `nsCtorCands` 直接匹配（entry 文件也适用）；导入族扫描已加载模块的声明。
-- | 自动补注（M41 新增导出）：ctorTargetInDecls。
ctorTargetInDecls : String -> String -> String -> List Decl -> Maybe String
ctorTargetInDecls mname famTarget base [] = Nothing
ctorTargetInDecls mname famTarget base (d :: rest) = case d of
  DData dname params kind ctors derivings viaField lin sp =>
    if mangle mname dname == famTarget then if anyCtorNamed base ctors then Just (ctorCanonical mname dname base) else Nothing
    else ctorTargetInDecls mname famTarget base rest
  DRecord dname params fields derivings viaField lin sp =>
    if mangle mname dname == famTarget && dname == base then Just (mangle mname dname)
    else ctorTargetInDecls mname famTarget base rest
  _ => ctorTargetInDecls mname famTarget base rest

-- | 自动补注（M41 新增导出）：anyCtorNamed。
anyCtorNamed : String -> List Ctor -> Bool
anyCtorNamed name [] = False
anyCtorNamed name (c :: rest) = ctorName c == name || anyCtorNamed name rest

-- | 自动补注（M41 新增导出）：findFamilyCtorInModules。
findFamilyCtorInModules : List Module -> String -> String -> Maybe String
findFamilyCtorInModules [] famTarget base = Nothing
findFamilyCtorInModules (m :: rest) famTarget base = case ctorTargetInDecls (moduleNameOf m) famTarget base (moduleDeclsOf m) of
  Just t => Just t
  Nothing => findFamilyCtorInModules rest famTarget base

-- | 自动补注（M41 新增导出）：ctorRelFamily。
ctorRelFamily : String -> String -> String
ctorRelFamily prefix rel = case splitLastDot (splitOnDot rel) of
  Pair revFam ctor => mangle prefix (joinDots revFam)

-- | 自动补注（M41 新增导出）：ctorTargetInFamily。
ctorTargetInFamily : List Module -> String -> Namespaces -> String -> String -> Maybe String
ctorTargetInFamily modules prefix ns famTarget base = case filter (\p => firstOf p == base && ctorRelFamily prefix (secondOf p) == famTarget) ns.nsCtorCands of
  [Pair _ rel] => Just (mangle prefix rel)
  _ => findFamilyCtorInModules modules famTarget base

-- 族前缀只按**类型命名空间**解析（不回头做构造子退化），避免与 resolveTypeName 形成
-- 终止性上无法证明的互递归。
-- | 自动补注（M41 新增导出）：resolveTypeTarget。
resolveTypeTarget : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveTypeTarget modules label prefix ns imports name = if Base.HashMap.member name ns.nsTypeSet then Ok (mangle prefix name)
else if isIntrinsicTypeName name then Ok name
else if name == "Type" || name == "->" then Ok name
else if containsDot name then resolveDottedTypeTargetOnly modules label imports name
else andThen (modulesExportingType modules imports name) (\pairs => case pairs of
  [] => Err "${label}: unknown type ${name}"
  _ => andThen (unifyEntryPairs label "type" name pairs) (\p => Ok (secondOf p).target)
)

-- | 自动补注（M41 新增导出）：resolveDottedTypeTargetOnly。
resolveDottedTypeTargetOnly : List Module -> String -> List Import -> String -> Result String
resolveDottedTypeTargetOnly modules label imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      typePrefix = joinDots revPrefix
    in case findImportPrefix imports typePrefix of
      Nothing => Err "${label}: module ${typePrefix} is not imported"
      Just m => andThen (exportsOf modules m) (\es => case findExportType es base of
        Just e => Ok e.target
        Nothing => case findExportValue es base of
          Just e => Ok e.target
          Nothing => Err "${label}: type ${base} is not exported by ${m}"
      )

-- | 自动补注（M41 新增导出）：resolveFamilyQualifiedCtor。
resolveFamilyQualifiedCtor : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveFamilyQualifiedCtor modules label prefix ns imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      famName = joinDots revPrefix
    in andThen (resolveTypeTarget modules label prefix ns imports famName) (\famTarget => case ctorTargetInFamily modules prefix ns famTarget base of
      Just t => Ok t
      Nothing => Err "${label}: type ${famName} has no constructor ${base}"
    )

-- 模块限定名里的构造子条目可能有多个同名（不同族）；这时必须用 Family.Ctor 消歧。
-- | 自动补注（M41 新增导出）：exportTarget。
exportTarget : ExportEntry -> String
exportTarget e = e.target

-- | 自动补注（M41 新增导出）：uniqueCtorTarget。
uniqueCtorTarget : String -> String -> List ExportEntry -> Result String
uniqueCtorTarget label name [] = Err "${label}: unknown constructor ${name}"
uniqueCtorTarget label name (e :: rest) =
  if allSameTarget (map exportTarget (e :: rest)) then Ok (exportTarget e)
  else Ok (overCtorName name (dedupeTargets (map exportTarget (e :: rest))))

-- | 自动补注（M41 新增导出）：allSameTarget。
allSameTarget : List String -> Bool
allSameTarget [] = True
allSameTarget (x :: rest) = allEq x rest

-- | 自动补注（M41 新增导出）：allEq。
allEq : String -> List String -> Bool
allEq x [] = True
allEq x (y :: rest) = x == y && allEq x rest

-- 模式里的限定名：import 模块前缀优先，其次 data family 前缀。
-- | 自动补注（M41 新增导出）：resolveCtorDotted。
resolveCtorDotted : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveCtorDotted modules label prefix ns imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      prefixName = joinDots revPrefix
    in case findImportPrefix imports prefixName of
      Just m => andThen (exportsOf modules m) (\es => case findExportCtors es base of
        [] => Err "${label}: ${base} is not exported by ${m}"
        entries => uniqueCtorTarget label base entries
      )
      Nothing => resolveFamilyQualifiedCtor modules label prefix ns imports name

-- 模式里的限定名只认构造器：`M.foo`（foo 是函数）必须报错，不能按值解析成构造器。
resolveQualifiedCtor : List Module -> String -> List Import -> String -> Result String
resolveQualifiedCtor modules label imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      prefix = joinDots revPrefix
    in case findImportPrefix imports prefix of
      Nothing => Err "${label}: module ${prefix} is not imported"
      Just m => andThen (exportsOf modules m) (\es => case findExportCtor es base of
        Just e => Ok e.target
        Nothing => Err "${label}: constructor ${base} is not exported by ${m}"
      )

-- 带点表达式的解析（M10.5）：先按「最长可解析模块前缀」尝试限定名/限定值+字段链，
-- 否则按「变量/顶层名 + 字段链」处理。`p.x`、`M.point.x`、`Vuna.Compiler.Frontend.Parser.parseSource` 都走这里。
resolveDottedExpr : List Module -> String -> String -> Namespaces -> List Import -> List String -> String -> Span -> Result Expr
resolveDottedExpr modules label prefix ns imports scope name sp = case splitOnDot name of
  [] => Err "${label}: invalid dotted name ${name}"
  head :: rest => if memName head scope then Ok (foldFieldChain (EVar head sp) rest sp)
  else andThen (resolveQualifiedPath modules label imports (splitOnDot name) (length (splitOnDot name)) sp) (\q => case q of
    Just e => Ok e
    Nothing => if Base.HashMap.member head ns.nsValueSet then Ok (foldFieldChain (EVar (mangle prefix head) sp) rest sp)
    else if isBuiltinName head then Ok (foldFieldChain (EVar head sp) rest sp)
    else if startsUpperName head then case resolveCtorDotted modules label prefix ns imports name of
      Ok t => Ok (EVar t sp)
      Err _ => Err "${label}: module ${head} is not imported"
    else andThen (resolveGlobal modules label prefix ns imports scope head)
      (\n => Ok (foldFieldChain (EVar n sp) rest sp))
  )

foldFieldChain : Expr -> List String -> Span -> Expr
foldFieldChain base [] sp = base
foldFieldChain base (f :: rest) sp = foldFieldChain (EField base f sp) rest sp

takeSegs : Int -> List a -> List a
takeSegs n [] = []
takeSegs n (x :: rest) = if n <= 0 then [] else x :: takeSegs (n - 1) rest

dropSegs : Int -> List a -> List a
dropSegs n [] = []
dropSegs n (x :: rest) = if n <= 0 then x :: rest else dropSegs (n - 1) rest

resolveQualifiedPath : List Module -> String -> List Import -> List String -> Int -> Span -> Result (Maybe Expr)
resolveQualifiedPath modules label imports segs n sp = if n < 1 then Ok Nothing
else case findImportPrefix imports (joinDots (takeSegs (n - 1) segs)) of
  Just m => andThen (exportsOf modules m) (\es => case dropSegs (n - 1) segs of
    [member] => case findExportValue es member of
      Just e => Ok (Just (EVar e.target sp))
      Nothing => case findExportCtor es member of
        Just e => Ok (Just (EVar e.target sp))
        Nothing => case findExportType es member of
          Just e => Ok (Just (EVar e.target sp))
          Nothing => Err "${label}: ${member} is not exported by ${m}"
    member :: rest => case findExportValue es member of
      Just e => Ok (Just (foldFieldChain (EVar e.target sp) rest sp))
      Nothing => Err "${label}: ${member} is not exported by ${m}"
    [] => Ok Nothing
  )
  Nothing => resolveQualifiedPath modules label imports segs (n - 1) sp

-- 值位置的裸名：值命名空间（def → ctor）优先；**类型作为项**是最后退路
-- （`data T ...` 的 `T` 可以当类型层实参传给显式 `(a : Type)` 参数）。
-- 命名空间分开后，本模块声明的**类型名不再抢走同名的导入值**：先查导入的值/构造子，
-- 再到本模块类型名，最后到导入模块导出的类型名（与类型位置一样，本模块类型名优先）；
-- 这样 `:type Maybe` / `f Bool` 这类「类型构造子当项」对导入名也成立（REPL 依赖它）。
resolveGlobal : List Module -> String -> String -> Namespaces -> List Import -> List String -> String -> Result String
resolveGlobal modules label prefix ns imports scope name = if memName name scope then Ok name
else if Base.HashMap.member name ns.nsValueSet then Ok (mangle prefix name)
else case localCtorTargets prefix ns name of
  t :: rest =>
    andThen (ctorCandidates modules prefix ns imports name)
      (\cands => Ok (pickCtorOrOver name cands))
  [] => if Base.HashMap.member name ns.nsCtorSet then Ok (mangle prefix name)
  else if containsDot name then resolveQualified modules label imports name
  else if isBuiltinName name then Ok name
  else if isDtPreludeName name then Ok name
  else andThen (modulesExportingValue modules imports name) (\pairs => case pairs of
    [] => andThen (ctorCandidates modules prefix ns imports name) (\cands => case cands of
      [] => andThen (modulesExportingCtor modules imports name) (\cpairs => case cpairs of
        [] => if Base.HashMap.member name ns.nsTypeSet then Ok (mangle prefix name)
        else andThen (modulesExportingType modules imports name) (\tpairs => case tpairs of
          [] =>
            Err
              "${label}: unbound variable ${name}${suggest name (append ns.nsValues (append ns.nsCtors (append ns.nsTypes scope)))}${traitImportHint name}"
          _ => andThen (unifyEntryPairs label "name" name tpairs) (\p => Ok (secondOf p).target)
        )
        _ => Ok (pickCtorOrOver name (dedupeTargets (map pairExportTarget cpairs)))
      )
      _ => Ok (pickCtorOrOver name cands)
    )
    _ => case ctorPairTargets modules pairs of
      [] => andThen (unifyEntryPairs label "name" name pairs) (\p => Ok (secondOf p).target)
      targets => Ok (pickCtorOrOver name (dedupeTargets targets))
  )

-- | 自动补注（M41 新增导出）：pickCtorOrOver。
pickCtorOrOver : String -> List String -> String
pickCtorOrOver name [] = overCtorName name []
pickCtorOrOver name ([t]) = t
pickCtorOrOver name cands = overCtorName name cands

-- 构造子位置（模式、record 构造、以及类型位置的索引构造子退化）：候选集 = 本地
-- data/record 构造子 ∪ open import 的 data/record 构造子；trait method 仍按旧名字解析。
-- | 自动补注（M41 新增导出）：resolveCtor。
resolveCtor : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveCtor modules label prefix ns imports name = if containsDot name then resolveCtorDotted modules label prefix ns imports name
else andThen (ctorCandidates modules prefix ns imports name) (\cands => case cands of
  [] => if Base.HashMap.member name ns.nsCtorSet then Ok (mangle prefix name)
  else if isIntrinsicName name then Ok name
  else andThen (modulesExportingCtor modules imports name) (\pairs => case pairs of
    [] => Err "${label}: unknown constructor ${name}${suggest name ns.nsCtors}"
    _ => Ok (pickCtorOrOver name (dedupeTargets (map pairExportTarget pairs)))
  )
  _ => Ok (pickCtorOrOver name cands)
)

checkBinder : String -> String -> Result String
checkBinder label name =
  if containsDot name then Err "${label}: invalid variable name ${name}" else Ok name

checkTopName : String -> String -> Result String
checkTopName label name =
  if name == "_" then Err "${label}: invalid top-level name _ (bare _ is reserved)"
  else if containsDot name then Err "${label}: invalid top-level name ${name}" else Ok name

resolveTopName : String -> String -> String -> Result String
resolveTopName label prefix name = andThen (checkTopName label name) (\_ => Ok (mangle prefix name))

resolvePattern : Int -> List Module -> String -> String -> Namespaces -> List Import -> Pat -> Result (Pair Pat (List String))
resolvePattern fuel modules label prefix ns imports pat = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case pat of
  PWild sp => Ok (Pair (PWild sp) [])
  PVar name sp => andThen (checkBinder label name) (\_ => Ok (Pair (PVar name sp) [name]))
  PAs name inner sp =>
    andThen (resolvePattern (fuel - 1) modules label prefix ns imports inner)
      (\p => Ok (Pair (PAs name (firstOf p) sp) (name :: secondOf p)))
  PInt n sp => Ok (Pair (PInt n sp) [])
  PStr s sp => Ok (Pair (PStr s sp) [])
  PCon name pats sp =>
    if isInternalSyntaxName name then andThen (traverse (\dtv => resolvePattern (fuel - 1) modules label prefix ns imports dtv) pats)
      (\parts => Ok (Pair (PCon name (map firstOf parts) sp) (concatMap secondOf parts)))
    else andThen (resolveCtor modules label prefix ns imports name)
      (\name2 => andThen (traverse (\dtv => resolvePattern (fuel - 1) modules label prefix ns imports dtv) pats) (\parts => Ok (Pair (PCon name2 (map firstOf parts) sp) (concatMap secondOf parts))))
  PRecord name fields sp =>
    andThen (resolveCtor modules label prefix ns imports name)
      (\name2 => andThen (traverse (\dtv => resolveRecordPatternField (fuel - 1) modules label prefix ns imports dtv) fields) (\parts => Ok (Pair (PRecord name2 (map firstOf parts) sp) (concatMap secondOf parts))))

resolveRecordPatternField : Int -> List Module -> String -> String -> Namespaces -> List Import -> Pair String Pat -> Result (Pair (Pair String Pat) (List String))
resolveRecordPatternField fuel modules label prefix ns imports (Pair fname pat) = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else andThen (resolvePattern (fuel - 1) modules label prefix ns imports pat) (\p => case p of
  Pair pat2 bound => Ok (Pair (Pair fname pat2) bound)
)

resolveAlt : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> Pair Pat Expr -> Result (Pair Pat Expr)
resolveAlt fuel modules label prefix ns imports scope (Pair pat body) = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else andThen (resolvePattern resolveFuelBound modules label prefix ns imports pat) (\p => case p of
  Pair pat2 bound =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports (append bound scope) body)
      (\body2 => Ok (Pair pat2 body2))
)

-- A2：局部函数的一个 clause（参数模式列表 + body）；参数绑定累加到 body 的作用域。
resolveLocalClause : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> Pair (List Pat) Expr -> Result (Pair (List Pat) Expr)
resolveLocalClause fuel modules label prefix ns imports scope (Pair pats body) = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else andThen (resolveLocalPats (fuel - 1) modules label prefix ns imports pats) (\p => case p of
  Pair pats2 bound =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports (append bound scope) body)
      (\body2 => Ok (Pair pats2 body2))
)

resolveLocalPats : Int -> List Module -> String -> String -> Namespaces -> List Import -> List Pat -> Result (Pair (List Pat) (List String))
resolveLocalPats fuel modules label prefix ns imports [] =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else Ok (Pair [] [])
resolveLocalPats fuel modules label prefix ns imports (pat :: rest) = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else andThen (resolvePattern (fuel - 1) modules label prefix ns imports pat) (\p => case p of
  Pair pat2 bound => andThen (resolveLocalPats (fuel - 1) modules label prefix ns imports rest) (\r => case r of
    Pair rest2 restBound => Ok (Pair (pat2 :: rest2) (append bound restBound))
  )
)

resolveLet : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> Bool -> List (Pair Pat Expr) -> Expr -> Result (Pair (List (Pair Pat Expr)) Expr)
resolveLet fuel modules label prefix ns imports scope rec_ binds body =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else if rec_ then resolveRecLet (fuel - 1) modules label prefix ns imports scope binds body
  else resolveLetSeq (fuel - 1) modules label prefix ns imports scope binds body

resolveLetSeq : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> List (Pair Pat Expr) -> Expr -> Result (Pair (List (Pair Pat Expr)) Expr)
resolveLetSeq fuel modules label prefix ns imports scope binds body = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case binds of
  [] =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope body)
      (\b => Ok (Pair [] b))
  (Pair pat value) :: rest => andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope value) (\value2 => andThen (resolvePattern resolveFuelBound modules label prefix ns imports pat) (\p => case p of
    Pair pat2 bound => andThen (resolveLetSeq (fuel - 1) modules label prefix ns imports (append bound scope) rest body) (\r => case r of
      Pair binds2 body2 => Ok (Pair (Pair pat2 value2 :: binds2) body2)
    )
  )
  )

-- 递归 let（where 块）：所有绑定名对全部 value 与 body 可见。
resolveRecLet : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> List (Pair Pat Expr) -> Expr -> Result (Pair (List (Pair Pat Expr)) Expr)
resolveRecLet fuel modules label prefix ns imports scope binds body = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case collectRecBinds modules label prefix ns imports binds of
  Err e => Err e
  Ok (Pair names pairs) =>
    let
      scope2 = append names scope
    in andThen (resolveRecValues (fuel - 1) modules label prefix ns imports scope2 pairs)
      (\values2 => andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope2 body) (\b => Ok (Pair values2 b)))

collectRecBinds : List Module -> String -> String -> Namespaces -> List Import -> List (Pair Pat Expr) -> Result (Pair (List String) (List (Pair Pat Expr)))
collectRecBinds modules label prefix ns imports [] = Ok (Pair [] [])
collectRecBinds modules label prefix ns imports ((Pair pat value) :: rest) = andThen (resolvePattern resolveFuelBound modules label prefix ns imports pat) (\pr => case pr of
  Pair pat2 bound => andThen (collectRecBinds modules label prefix ns imports rest) (\r => case r of
    Pair names tail => Ok (Pair (append bound names) (Pair pat2 value :: tail))
  )
)

resolveRecValues : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> List (Pair Pat Expr) -> Result (List (Pair Pat Expr))
resolveRecValues fuel modules label prefix ns imports scope [] =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else Ok []
resolveRecValues fuel modules label prefix ns imports scope ((Pair pat value) :: rest) =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope value)
    (\value2 => andThen (resolveRecValues (fuel - 1) modules label prefix ns imports scope rest) (\tail => Ok (Pair pat value2 :: tail)))

-- M36：模板字符串降级（rename 之后、Elab 之前）。
--
--   * 文本块 → `EStr`（空文本块跳过）；
--   * 洞 → `EApp (EVar "Base.Interp.interp") [e]`：转换语义**完全由 base 的 `Interp`
--     实例决定**（blanket `Show a => Interp a` / `Interp String` / 用户实例），编译器
--     只负责这一步纯语法糖；
--   * 整体用 `++` 左结合链串起来（1 块直接返回；模板通常只有少量块）。
--
-- 生成的名字已是 canonical（`Base.Interp.interp` 由 `Intrinsics` 唯一给出，`++` 是内建名），
-- 不再走二次名字解析。
lowerTemplate : Span -> List InterpPart -> Expr
lowerTemplate sp parts = case templateChunks sp parts of
  [] => EStr "" sp
  first :: rest => concatLeft sp first rest

templateChunks : Span -> List InterpPart -> List Expr
templateChunks sp [] = []
templateChunks sp ((IPText s) :: rest) =
  if s == "" then templateChunks sp rest else EStr s sp :: templateChunks sp rest
templateChunks sp ((IPHole e) :: rest) =
  EApp (EVar interpMethodName (exprSpan e)) [e] (exprSpan e) :: templateChunks sp rest

concatLeft : Span -> Expr -> List Expr -> Expr
concatLeft sp acc [] = acc
concatLeft sp acc (e :: rest) = concatLeft sp (EApp (EVar "++" sp) [acc, e] sp) rest

resolveExpr : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> Expr -> Result Expr
resolveExpr fuel modules label prefix ns imports scope expr = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case expr of
  -- M40：`_` / `?name` 是洞，不是可解析的名字（`_` 也走 `dtPreludeNames`，命名洞必须
  -- 在这里直接放行，否则会报 unbound variable）。
  EVar name sp =>
    if isHoleName name then Ok (EVar name sp)
    else if isInternalSyntaxName name then Ok (EVar name sp)
    else if containsDot name then resolveDottedExpr modules label prefix ns imports scope name sp
    else andThen (resolveGlobal modules label prefix ns imports scope name) (\n => Ok (EVar n sp))
  -- M31.2：`EInfix` / `EParen` 是 parser 的中间产物，正常路径在 Loader 重排里已消除；
  -- 走到这里说明重排漏了（internal error，不静默透传）。
  EInfix op lhs rhs sp => Err "${label}: DT: internal: unreordered infix operator ${op}"
  -- M31.3：同上——反引号中缀与 section 也必须在 Loader.Fixity 重排里消除（严格执行
  -- 契约「rename 后不存在」），走到这里说明重排漏了，显式 internal error 不静默透传。
  EBacktick name lhs rhs sp =>
    Err "${label}: DT: internal: unreordered backtick infix operator ${name}"
  ESectOp op sp => Err "${label}: DT: internal: unreordered operator section (${op})"
  ESectL op rhs sp => Err "${label}: DT: internal: unreordered left operator section (${op})"
  ESectR lhs op sp => Err "${label}: DT: internal: unreordered right operator section (${op})"
  EParen inner sp => resolveExpr (fuel - 1) modules label prefix ns imports scope inner
  EInt n sp => Ok (EInt n sp)
  EStr s sp => Ok (EStr s sp)
  EFloat raw sp => Ok (EFloat raw sp)
  -- M36：模板字面量在 rename 之后降级为纯表达式（文本块 → `EStr`，洞 → `interp e`），
  -- 于是 Elab / codegen 永远看不到 `EInterp`；fmt / lint / index / doc 只做 parse，仍看原形。
  EInterp multi parts sp =>
    andThen (resolveInterpParts (fuel - 1) modules label prefix ns imports scope parts)
      (\ps => Ok (lowerTemplate sp ps))
  ELam params body sp =>
    andThen (traverse (checkBinder label) params)
      (\_ => andThen (resolveExpr (fuel - 1) modules label prefix ns imports (append params scope) body) (\b => Ok (ELam params b sp)))
  EApp fn args sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope fn)
      (\fn2 => andThen (traverse (\a => resolveExpr (fuel - 1) modules label prefix ns imports scope a) args) (\args2 => Ok (EApp fn2 args2 sp)))
  -- M20：`EPi` 只做**结构递归解析**，不在这里判定「是否允许」。M13–M19 的 DT 是单文件、
  -- 不经 Loader，所以这条以前直接拒绝；M20 起 `--dt` 复用 Loader，而依赖类型是 DT 的
  -- 核心语法。放行判定的责任交给下游检查器：早期 HM 的 `Typecheck`（已删除）曾报
  -- `dependent function type requires --dt`（既有行为不变），DT 的 `Elab` 正常精化。
  EPi name implicit qty dom cod sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope dom)
      (\dom2 => andThen (resolveExpr (fuel - 1) modules label prefix ns imports (append [name] scope) cod) (\cod2 => Ok (EPi name implicit qty dom2 cod2 sp)))
  ELet binds body rec_ sp => andThen (resolveLet (fuel - 1) modules label prefix ns imports scope rec_ binds body) (\r => case r of
    Pair binds2 body2 => Ok (ELet binds2 body2 rec_ sp)
  )
  -- A2：where/let 多 clause 局部函数：逐 clause 解析参数模式并累加作用域。
  ELocalFun clauses sp =>
    andThen
      (traverse (\dtv => resolveLocalClause (fuel - 1) modules label prefix ns imports scope dtv) clauses)
      (\clauses2 => Ok (ELocalFun clauses2 sp))
  ECase scrut alts sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope scrut)
      (\scrut2 => andThen (traverse (\dtv => resolveAlt (fuel - 1) modules label prefix ns imports scope dtv) alts) (\alts2 => Ok (ECase scrut2 alts2 sp)))
  EIf c t e sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope c)
      (\c2 => andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope t) (\t2 => andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope e) (\e2 => Ok (EIf c2 t2 e2 sp))))
  EField base fname sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope base)
      (\b => Ok (EField b fname sp))
  ERecord name fields sp =>
    andThen (resolveCtor modules label prefix ns imports name)
      (\name2 => andThen (traverse (\dtv => resolveFieldValue (fuel - 1) modules label prefix ns imports scope dtv) fields) (\fs => Ok (ERecord name2 fs sp)))
  ERecUpdate base fields sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope base)
      (\b => andThen (traverse (\dtv => resolveFieldValue (fuel - 1) modules label prefix ns imports scope dtv) fields) (\fs => Ok (ERecUpdate b fs sp)))
  EDo stmts sp => resolveDo (fuel - 1) modules label prefix ns imports scope stmts
  -- M24：where 绑定签名（`g : Int -> Int`）降级成 `EAnn value ty`；值与类型都做名字解析。
  EAnn value ty sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope value)
      (\v2 => andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope ty) (\t2 => Ok (EAnn v2 t2 sp)))

-- M36：模板片段的名字解析（洞内表达式按普通作用域解析；文本块原样）。
resolveInterpParts : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> List InterpPart -> Result (List InterpPart)
resolveInterpParts fuel modules label prefix ns imports scope parts = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case parts of
  [] => Ok []
  (IPText s) :: rest =>
    andThen (resolveInterpParts (fuel - 1) modules label prefix ns imports scope rest)
      (\ps => Ok (IPText s :: ps))
  (IPHole e) :: rest =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope e)
      (\e2 => andThen (resolveInterpParts (fuel - 1) modules label prefix ns imports scope rest) (\ps => Ok (IPHole e2 :: ps)))

-- do（M11）在这里降级成 bind 的普通应用，后续类型检查与 codegen 无需认识 do。
-- 最后一条裸表达式即块结果（`do e` = `e`）；裸语句用 `bind e (\_ -> rest)` 顺序化。
--
-- S3：`bind` 只在**块作用域**解析一次（`resolveDoBind`，进入任何 do-binder 之前），
-- 之后每一步都用同一个 canonical 名构造 `EVar`。旧实现先把整块降级成带裸名 `bind` 的
-- 链、再交给 `resolveExpr` 解析，于是链上每个 `bind` 都在各自的 lambda 作用域里重新解析：
-- 块里出现名为 `bind` 的 do-binder 时，后续步骤的 bind 会被错误地解析到该 binder。
-- 现在降级与解析合并成一次遍历，链头直接使用块作用域解析好的名字。
resolveDo : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> List DoStmt -> Result Expr
resolveDo fuel modules label prefix ns imports scope stmts = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case stmts of
  [] => psErr0 DoBlockNeedsStatement
  [DExpr e sp] => resolveExpr (fuel - 1) modules label prefix ns imports scope e
  _ =>
    andThen (resolveDoBind modules label prefix ns imports scope)
      (\bindName => resolveDoChain (fuel - 1) modules label prefix ns imports scope bindName stmts)

-- 块作用域里的 `bind`：唯一真源是普通名字解析（局部 trait 方法 / import 的值 / 外层局部
-- 绑定都可能命中），支持「本地自定义 `trait Monad`」的夹具。
resolveDoBind : List Module -> String -> String -> Namespaces -> List Import -> List String -> Result String
resolveDoBind modules label prefix ns imports scope =
  resolveGlobal modules label prefix ns imports scope "bind"

-- 非末条语句的链式降级：`bind` 已解析好，逐条解析语句表达式（do-binder 对后续语句可见，
-- 与旧实现的 lambda 作用域一致；`_` binder 不引入可见名字）。
--
-- S3b：每个节点的头部不是裸 canonical 名，而是携带 canonical 的内部标记
-- `@vuna@do@bind@<canonical>` / `@vuna@do@ignore@<canonical>`（`Ast.doBindSyntaxName` /
-- `doIgnoreSyntaxName`）。标记只由 Loader 在 rename 后产生，用户源码写不出来；Elab 据此把
-- 整块按「一个 monad / 一个字典」精化（`Elab.Term.Impl` 的 do 链解释），不认识的形状则
-- 剥标记回退成普通 bind 应用——与 S3a 的语义完全一致。
resolveDoChain : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> String -> List DoStmt -> Result Expr
resolveDoChain fuel modules label prefix ns imports scope bindName stmts = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case stmts of
  [] => psErr0 DoBlockNeedsStatement
  [DExpr e sp] => resolveExpr (fuel - 1) modules label prefix ns imports scope e
  (DExpr e sp) :: rest =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope e)
      (\e2 => andThen (resolveDoChain (fuel - 1) modules label prefix ns imports scope bindName rest) (\tail => Ok (EApp (EVar (doIgnoreSyntaxName bindName) sp) [e2, ELam ["vuna_do_ignore"] tail sp] sp)))
  (DBind (PVar name psp) e sp) :: rest =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope e)
      (\e2 => andThen (resolveDoChain (fuel - 1) modules label prefix ns imports (name :: scope) bindName rest) (\tail => Ok (EApp (EVar (doBindSyntaxName bindName) sp) [e2, ELam [name] tail sp] sp)))
  (DBind (PWild psp) e sp) :: rest =>
    andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope e)
      (\e2 => andThen (resolveDoChain (fuel - 1) modules label prefix ns imports scope bindName rest) (\tail => Ok (EApp (EVar (doIgnoreSyntaxName bindName) sp) [e2, ELam ["vuna_do_ignore"] tail sp] sp)))
  (DBind pat e sp) :: rest => psErr0 DoBindPattern

resolveFieldValue : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> Pair String Expr -> Result (Pair String Expr)
resolveFieldValue fuel modules label prefix ns imports scope (Pair fname value) =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else andThen (resolveExpr (fuel - 1) modules label prefix ns imports scope value)
    (\v => Ok (Pair fname v))

-- | 自动补注（M41 新增导出）：resolveCtorDecl。
resolveCtorDecl : String -> String -> String -> String -> Result String
resolveCtorDecl label prefix dname ctor =
  andThen (checkTopName label ctor) (\_ => Ok (ctorCanonical prefix dname ctor))

isLowerTypeName : String -> Bool
isLowerTypeName name = case strUnpack name of
  [] => False
  c :: rest => isLowerChar c

startsUpperName : String -> Bool
startsUpperName name = case strUnpack name of
  [] => False
  c :: rest => c >= 65 && c <= 90

-- 类型名解析（M20：本模块声明的类型名**优先于**内建名；M28 起只查类型命名空间）。
--
-- `Base.Bool` 会重新声明 `data Bool`，此时 `Bool` 应解析成 `Base.Bool.Bool`（mangled），
-- 而不是内建 `Bool`——否则构造子检查会报 `constructor False does not return
-- Base.Bool.Bool`（族名对不上）。因此 `nsTypes` 的判定必须排在内建名之前。
--
-- 类型位置**只查类型命名空间**；找不到时按既有约定退化：
--   1. 小写名是类型变量（隐式量化），但本模块同名的**值定义**（类型层 def，
--      如 `sel : Nat -> Type`）与同名的本地构造子仍按旧行为 mangle——这是「值推断」
--      的退化路径，不是把值命名空间并进类型命名空间；
--   2. 非小写名找不到类型时，退化为**索引构造子**（本地构造子 + 跨模块 import 的构造子），
--      最后才是本模块的值定义（大写类型层 def，少见）。
-- | 自动补注（M41 新增导出）：resolveTypeName。
resolveTypeName : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveTypeName modules label prefix ns imports name =
  if Base.HashMap.member name ns.nsTypeSet then Ok (mangle prefix name)
  else if isIntrinsicTypeName name then Ok name
  else if name == "Type" || name == "->" then Ok name
  else if isLowerTypeName name then resolveLowerTypeName modules label prefix ns imports name
  else resolveNonLowerTypeName modules label prefix ns imports name

-- 本地构造子（索引）候选：0 = 继续按导入面找；1 = 命中；>1 = 同名不同族，必须限定。
-- | 自动补注（M41 新增导出）：localCtorResult。
localCtorResult : String -> String -> Namespaces -> String -> Result (Maybe String)
localCtorResult label prefix ns name = case localCtorTargets prefix ns name of
  [t] => Ok (Just t)
  [] => Ok Nothing
  _ => Err "${label}: ambiguous constructor ${name} (qualify it as Data.${name})"

-- | 自动补注（M41 新增导出）：resolveLowerTypeName。
resolveLowerTypeName : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveLowerTypeName modules label prefix ns imports name = if Base.HashMap.member name ns.nsValueSet then Ok (mangle prefix name)
else andThen (localCtorResult label prefix ns name) (\mc => case mc of
  Just t => Ok t
  Nothing => andThen (modulesExportingValue modules imports name) (\vp => case vp of
    [] => andThen (modulesExportingCtor modules imports name) (\cp => case cp of
      [] => andThen (modulesExportingType modules imports name) (\tp => case tp of
        [] => Ok name
        _ => andThen (unifyEntryPairs label "name" name tp) (\p => Ok (secondOf p).target)
      )
      _ => andThen (unifyEntryPairs label "name" name cp) (\p => Ok (secondOf p).target)
    )
    _ => andThen (unifyEntryPairs label "name" name vp) (\p => Ok (secondOf p).target)
  )
)

-- | 自动补注（M41 新增导出）：resolveNonLowerTypeName。
resolveNonLowerTypeName : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveNonLowerTypeName modules label prefix ns imports name = andThen (localCtorResult label prefix ns name) (\mc => case mc of
  Just t => Ok t
  Nothing => if containsDot name then resolveDottedTypeName modules label prefix ns imports name
  else andThen (modulesExportingType modules imports name) (\pairs => case pairs of
    -- M30：类型位置也可能出现**跨模块 import 的构造子**（依赖类型索引，如 `import Base.Nat`
    -- 后 `Vec Zero a` 的 `Zero`）。`modulesExportingType` 只查 `"type"` entry，找不到构造子，
    -- 故退化到 `resolveCtor`（认 `"ctor"` entry；本地构造子已在上面处理）。
    [] => case resolveCtor modules label prefix ns imports name of
      Ok c => Ok c
      Err e => if Base.HashMap.member name ns.nsValueSet then Ok (mangle prefix name) else Err e
    _ => andThen (unifyEntryPairs label "type" name pairs) (\p => Ok (secondOf p).target)
  )
)

-- | 自动补注（M41 新增导出）：resolveDottedTypeName。
resolveDottedTypeName : List Module -> String -> String -> Namespaces -> List Import -> String -> Result String
resolveDottedTypeName modules label prefix ns imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      typePrefix = joinDots revPrefix
    in case findImportPrefix imports typePrefix of
      Nothing => case resolveFamilyQualifiedCtor modules label prefix ns imports name of
        Ok t => Ok t
        Err _ => Err "${label}: module ${typePrefix} is not imported"
      Just m => andThen (exportsOf modules m) (\es => case findExportType es base of
        Just e => Ok e.target
        -- M28：类型位置的值（axiom / 类型层 def）在限定名下也可用；是否为合法类型由 Elab 判定。
        Nothing => case findExportValue es base of
          Just e => Ok e.target
          Nothing => Err "${label}: type ${base} is not exported by ${m}"
      )

-- M32：约束项（签名 ctx / 实例 ctx）的接口名单独报错。`C a` 的 `C` 未绑定时若直接走
-- `resolveTypeExpr`，类型位置会退化成构造子解析并报 "unknown constructor C"——对约束语义
-- 是误导。这里先解析头名，未绑定即报 `unknown interface`；头名合法时其余实参仍按类型解析。
resolveConstraintExpr : List Module -> String -> String -> Namespaces -> List Import -> Expr -> Result Expr
resolveConstraintExpr modules label prefix ns imports cx = case constraintHeadOf cx of
  Just n => case resolveTypeName modules label prefix ns imports n of
    Err _ => Err "${label}: unknown interface ${n}"
    Ok _ => resolveTypeExpr resolveFuelBound modules label prefix ns imports cx
  Nothing => resolveTypeExpr resolveFuelBound modules label prefix ns imports cx

constraintHeadOf : Expr -> Maybe String
constraintHeadOf (EApp (EVar n _) _ _) = Just n
constraintHeadOf (EVar n _) = Just n
constraintHeadOf _ = Nothing

resolveTypeExpr : Int -> List Module -> String -> String -> Namespaces -> List Import -> Expr -> Result Expr
resolveTypeExpr fuel modules label prefix ns imports ty =
  resolveTypeExprScoped fuel modules label prefix ns imports [] ty

-- B33：类型表达式里的显式 Pi binder 必须遮蔽同名 import；`bound` 只含 binder 名，
-- 未绑定的名字才交给 resolveTypeName（本地值定义优先，其次 import 的导出面）。
resolveTypeExprScoped : Int -> List Module -> String -> String -> Namespaces -> List Import -> List String -> Expr -> Result Expr
resolveTypeExprScoped fuel modules label prefix ns imports bound ty = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case ty of
  -- M20：DT 的层级（`Type 1`）与洞（`_`）在这里只做结构放行，语义由下游检查器决定。
  EApp (EVar "Type" _) args _ => Ok ty
  -- 类型表达式里的字面量：Int / String 都放行（`Vec 3 a` / `Reader "books" Int`）；
  -- 其它字面量仍报 invalid type expression。
  EInt n sp => Ok ty
  EStr s sp => Ok ty
  EVar name sp =>
    if memName name bound then Ok ty
    else if isInternalSyntaxName name then Ok ty
    else andThen (resolveTypeName modules label prefix ns imports name) (\n => Ok (EVar n sp))
  EApp fn args sp =>
    andThen (resolveTypeExprScoped (fuel - 1) modules label prefix ns imports bound fn)
      (\fn2 => andThen (traverse (\dtv => resolveTypeExprScoped (fuel - 1) modules label prefix ns imports bound dtv) args) (\args2 => Ok (EApp fn2 args2 sp)))
  -- M20：同上——只做结构递归，允许与否交给下游检查器。
  EPi name implicit qty dom cod sp =>
    andThen (resolveTypeExprScoped (fuel - 1) modules label prefix ns imports bound dom)
      (\dom2 => andThen (resolveTypeExprScoped (fuel - 1) modules label prefix ns imports (name :: bound) cod) (\cod2 => Ok (EPi name implicit qty dom2 cod2 sp)))
  _ => Err "${label}: invalid type expression (${tyShape ty})"

resolveTypeTopName : String -> String -> String -> Result String
resolveTypeTopName label prefix name =
  andThen (checkTopName label name) (\_ => Ok (mangle prefix name))

-- | 自动补注（M41 新增导出）：resolveCtorSpec。
resolveCtorSpec : List Module -> String -> String -> Namespaces -> List Import -> String -> Ctor -> Result Ctor
resolveCtorSpec modules label prefix ns imports dname (Ctor ctor ty arity sp) =
  andThen (resolveCtorDecl label prefix dname ctor)
    (\c2 => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports ty) (\ty2 => Ok (Ctor c2 ty2 arity sp)))

resolveDecl : List Module -> String -> String -> Namespaces -> List Import -> Decl -> Result Decl
resolveDecl modules label prefix ns imports d = case d of
  DData dname params kind ctors derivings viaField lin sp =>
    andThen (resolveTypeTopName label prefix dname)
      (\dn => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports kind) (\kind2 => andThen (traverse (resolveCtorSpec modules label prefix ns imports dname) ctors) (\ctors2 => andThen (traverse (resolveTypeName modules label prefix ns imports) derivings) (\ds2 => Ok (DData dn params kind2 ctors2 ds2 viaField lin sp)))))
  DRecord dname params fields derivings viaField lin sp =>
    andThen (resolveTypeTopName label prefix dname)
      (\dn => andThen (traverse (resolveRecordField modules label prefix ns imports) fields) (\fields2 => andThen (traverse (resolveTypeName modules label prefix ns imports) derivings) (\ds2 => Ok (DRecord dn params fields2 ds2 viaField lin sp))))
  DTrait tname params methods sp =>
    andThen (resolveTypeTopName label prefix tname)
      (\tn => andThen (traverse (resolveTraitMethod modules label prefix ns imports) methods) (\ms => Ok (DTrait tn params ms sp)))
  DInstance ctxE head methods sp =>
    andThen (traverse (\cx => resolveConstraintExpr modules label prefix ns imports cx) ctxE)
      (\ctx2 => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports head) (\head2 => andThen (traverse (resolveInstanceMethod modules label prefix ns imports) methods) (\ms => Ok (DInstance ctx2 head2 ms sp))))
  DSig name ctx ty sp =>
    andThen (resolveTopName label prefix name)
      (\n => andThen (traverse (\cx => resolveConstraintExpr modules label prefix ns imports cx) ctx) (\ctx2 => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports ty) (\ty2 => Ok (DSig n ctx2 ty2 sp))))
  -- M28：axiom 与签名一样解析类型表达式；名字按顶层名 mangle。
  DAxiom name ty sp =>
    andThen (resolveTopName label prefix name)
      (\n => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports ty) (\ty2 => Ok (DAxiom n ty2 sp)))
  DExtern name cName ty sp =>
    andThen (resolveTopName label prefix name)
      (\n => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports ty) (\ty2 => Ok (DExtern n cName ty2 sp)))
  DFun name pats body sp =>
    andThen (resolveTopName label prefix name)
      (\n => andThen (traverse (resolvePattern resolveFuelBound modules label prefix ns imports) pats) (\parts => andThen (resolveExpr resolveFuelBound modules label prefix ns imports (concatMap secondOf parts) body) (\b => Ok (DFun n (map firstOf parts) b sp))))

resolveRecordField : List Module -> String -> String -> Namespaces -> List Import -> Field -> Result Field
resolveRecordField modules label prefix ns imports (Field fname ty sp) =
  andThen (checkBinder label fname)
    (\_ => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports ty) (\ty2 => Ok (Field fname ty2 sp)))

resolveTraitMethod : List Module -> String -> String -> Namespaces -> List Import -> TraitMethod -> Result TraitMethod
resolveTraitMethod modules label prefix ns imports (TraitMethod mname ty sp) =
  andThen (resolveTopName label prefix mname)
    (\n => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports ty) (\ty2 => Ok (TraitMethod n ty2 sp)))

resolveInstanceMethod : List Module -> String -> String -> Namespaces -> List Import -> Decl -> Result Decl
resolveInstanceMethod modules label prefix ns imports (DSig name ctx ty sp) =
  andThen (checkTopName label name)
    (\_ => andThen (traverse (\cx => resolveConstraintExpr modules label prefix ns imports cx) ctx) (\ctx2 => andThen (resolveTypeExpr resolveFuelBound modules label prefix ns imports ty) (\ty2 => Ok (DSig name ctx2 ty2 sp))))
resolveInstanceMethod modules label prefix ns imports (DFun name pats body sp) =
  andThen (checkTopName label name)
    (\_ => andThen (traverse (resolvePattern resolveFuelBound modules label prefix ns imports) pats) (\parts => andThen (resolveExpr resolveFuelBound modules label prefix ns imports (concatMap secondOf parts) body) (\b => Ok (DFun name (map firstOf parts) b sp))))
resolveInstanceMethod modules label prefix ns imports _ =
  Err "${label}: instance body may only contain method signatures/definitions"

resolveProgram : List Module -> String -> String -> Namespaces -> List Import -> List Decl -> Result (List Decl)
resolveProgram modules label prefix ns imports decls =
  traverse (resolveDecl modules label prefix ns imports) decls

-- M41：entry 文件的构造子也按族限定（`Data.Ctor`），同名构造子不再互相覆盖；
-- 原先的「entry 构造子共享一个全局命名空间」防御随 canonical 命名一并删除。
resolveEntry : List Module -> String -> List String -> Maybe (List String) -> List Import -> List Decl -> Result (List Decl)
resolveEntry modules entryPkg entryCaps entryTrust imports decls =
  andThen (resolveProgram modules "<entry>" "" (namespacesOf decls) imports decls)
    (\d => checkEffectsBuiltins "<entry>" entryPkg entryCaps entryTrust d)

resolveModules : List Module -> Result (List Decl)
resolveModules [] = Ok []
resolveModules (modules@((Module name mpkg imports imps decls exports mcaps mtrust fx) :: rest)) =
  andThen
    (andThen (resolveProgram modules name name (namespacesOf decls) (append imports imps) decls) (\d => checkEffectsBuiltins name mpkg mcaps mtrust d))
    (\d1 => andThen (resolveModules rest) (\d2 => Ok (append d1 d2)))

-- ---------------------------------------------------------------
-- 效应能力（M27）：包在 vuna.toml 的 [capabilities].effects 里显式声明能力；
-- 内建所需能力在 Intrinsics 表里。普通包不声明能力，只能经 Base.IO 使用效果；
-- 不存在任何按包名/路由的 allowlist。
-- ---------------------------------------------------------------
capabilityError : String -> String -> Result a
capabilityError label name =
  Err "${label}: unknown capability \"${name}\" (known: ${join ", " capabilityNames})"

checkCapabilities : String -> List String -> Result Int
checkCapabilities label [] = Ok 0
checkCapabilities label (name :: rest) = checkOneCapability label name rest

checkOneCapability : String -> String -> List String -> Result Int
checkOneCapability label name rest = case parseCapability name of
  Just _ => checkCapabilities label rest
  Nothing => capabilityError label name

isEffectfulBuiltin : String -> Bool
isEffectfulBuiltin name = case findIntrinsic name of
  Just i => isEffectfulIntrinsic i
  Nothing => False

allowsEffect : List String -> String -> Bool
allowsEffect caps name = case findIntrinsic name of
  Just i => effectAllowed caps i
  Nothing => True

effectAllowed : List String -> Intrinsic -> Bool
effectAllowed caps i = case intrinsicCapability i of
  Nothing => True
  Just c => memName (capabilityName c) caps

firstEffect : List (Maybe a) -> Maybe a
firstEffect [] = Nothing
firstEffect (Nothing :: rest) = firstEffect rest
firstEffect ((Just n) :: rest) = Just n

-- M31：`runIO` 是唯一的「main 之外执行 IO」入口，要求能力 `unsafe`。
-- 名字是 resolve 后的模块全名（`Base.IO.runIO`）；必须在 `effExpr` 里被认作 effect 名，
-- 否则 `checkEffectsBuiltins` 永远看不到它（不是 intrinsic）。
unsafeExecutorName : String
unsafeExecutorName = "Base.IO.runIO"

isUnsafeExecutor : String -> Bool
isUnsafeExecutor name = name == unsafeExecutorName

effExpr : Expr -> Maybe String
effExpr e = case e of
  EVar n sp => if isEffectfulBuiltin n || isUnsafeExecutor n then Just n else Nothing
  EInt n sp => Nothing
  EStr s sp => Nothing
  EFloat raw sp => Nothing
  ELam ps body sp => effExpr body
  EApp fn args sp => firstEffect [effExpr fn, effExprs args]
  ELet binds body rec_ sp => firstEffect [effBinds binds, effExpr body]
  ELocalFun clauses sp => effLocalClauses clauses
  ECase scrut alts sp => firstEffect [effExpr scrut, effAlts alts]
  EIf c t el sp => firstEffect [effExpr c, effExpr t, effExpr el]
  EField base fname sp => effExpr base
  ERecord name fields sp => effFields fields
  ERecUpdate base fields sp => firstEffect [effExpr base, effFields fields]
  -- M20：`EPi` 是 DT 的核心语法，这里只做结构递归（类型层不算 effect）。
  EPi name implicit qty dom cod sp => firstEffect [effExpr dom, effExpr cod]
  EDo stmts sp => effDos stmts
  -- M36：模板字面量在 rename 后已被降级成 `interp` 调用，正常路径走不到这里；
  -- 仍然结构递归洞内表达式（不丢 effect），防御未来直接喂未降级 AST。
  EInterp multi parts sp => effInterpParts parts
  -- M31.2：parser 中间产物（重排后不应出现；这里只做结构递归）。
  EInfix op l r sp => firstEffect [effExpr l, effExpr r]
  -- M31.3：反引号中缀 / section 同理（重排后不出现，保持结构递归以不丢 effect）。
  EBacktick name l r sp => firstEffect [effExpr l, effExpr r]
  ESectOp op sp => Nothing
  ESectL op rhs sp => effExpr rhs
  ESectR lhs op sp => effExpr lhs
  EParen inner sp => effExpr inner
  -- M24：where 绑定签名 `EAnn value ty`；类型层不算 effect，只看值。
  EAnn value ty sp => effExpr value

-- 列表遍历显式写成结构递归（不用 map + λ）：终止性检查只能看到对列表尾的结构下降。
effExprs : List Expr -> Maybe String
effExprs [] = Nothing
effExprs (e :: rest) = firstEffect [effExpr e, effExprs rest]

effBinds : List (Pair Pat Expr) -> Maybe String
effBinds [] = Nothing
effBinds ((Pair pat value) :: rest) = firstEffect [effExpr value, effBinds rest]

effAlts : List (Pair Pat Expr) -> Maybe String
effAlts [] = Nothing
effAlts ((Pair pat body) :: rest) = firstEffect [effExpr body, effAlts rest]

-- A2：局部函数各 clause 的 body（模式本身不算 effect）。
effLocalClauses : List (Pair (List Pat) Expr) -> Maybe String
effLocalClauses [] = Nothing
effLocalClauses ((Pair pats body) :: rest) = firstEffect [effExpr body, effLocalClauses rest]

effInterpParts : List InterpPart -> Maybe String
effInterpParts [] = Nothing
effInterpParts ((IPText s) :: rest) = effInterpParts rest
effInterpParts ((IPHole e) :: rest) = firstEffect [effExpr e, effInterpParts rest]

effFields : List (Pair String Expr) -> Maybe String
effFields [] = Nothing
effFields ((Pair fname value) :: rest) = firstEffect [effExpr value, effFields rest]

effDo : DoStmt -> Maybe String
effDo (DBind pat value sp) = effExpr value
effDo (DExpr value sp) = effExpr value

effDos : List DoStmt -> Maybe String
effDos [] = Nothing
effDos (s :: rest) = firstEffect [effDo s, effDos rest]

effDecl : Decl -> Maybe String
effDecl (DFun n pats body sp) = effExpr body
effDecl (DTrait n ps methods sp) = Nothing
effDecl (DInstance ctxE headTy methods sp) = effDecls methods
effDecl _ = Nothing

effDecls : List Decl -> Maybe String
effDecls [] = Nothing
effDecls (d :: rest) = firstEffect [effDecl d, effDecls rest]

-- ---------------------------------------------------------------
-- D28：定义级信任点（opt-in 严格模式）
--
-- 包在 manifest 声明 `[trust] unsafe` 后进入严格模式：只有列出的定义可以**直接**
-- 引用 `unsafe` 门控的目标——`intrinsicCapability == Just CapUnsafe` 的内建，或
-- `Base.IO.runIO` 别名（`isUnsafeExecutor`）。非严格包维持原有「能力声明 + 整模块
-- 首个效应」检查，不做定义级限制；没有按包名/路由的 allowlist。
-- ---------------------------------------------------------------
-- | 能力是否是 `unsafe`（CapUnsafe）。
isUnsafeCapability : Capability -> Bool
isUnsafeCapability CapUnsafe = True
isUnsafeCapability _ = False

-- | 名字是否是定义级信任检查的目标：`unsafe` 门控的内建或 `Base.IO.runIO` 别名。
isUnsafeGatedName : String -> Bool
isUnsafeGatedName name = if isUnsafeExecutor name then True
else case findIntrinsic name of
  Just i => case intrinsicCapability i of
    Just c => isUnsafeCapability c
    Nothing => False
  Nothing => False

-- | 表达式里**直接**出现的首个 unsafe 门控名字（结构递归；不做调用图/别名分析，
-- 因此传递调用者不需要信任点，只有真正写出内建/别名的定义需要）。
unsafeExpr : Expr -> Maybe String
unsafeExpr (EVar n sp) = if isUnsafeGatedName n then Just n else Nothing
unsafeExpr (EInt n sp) = Nothing
unsafeExpr (EStr s sp) = Nothing
unsafeExpr (EFloat raw sp) = Nothing
unsafeExpr (ELam ps body sp) = unsafeExpr body
unsafeExpr (EApp fn args sp) = firstEffect [unsafeExpr fn, unsafeExprs args]
unsafeExpr (ELet binds body rec_ sp) = firstEffect [unsafeBinds binds, unsafeExpr body]
unsafeExpr (ELocalFun clauses sp) = unsafeLocalClauses clauses
unsafeExpr (ECase scrut alts sp) = firstEffect [unsafeExpr scrut, unsafeAlts alts]
unsafeExpr (EIf c t el sp) = firstEffect [unsafeExpr c, unsafeExpr t, unsafeExpr el]
unsafeExpr (EField base fname sp) = unsafeExpr base
unsafeExpr (ERecord name fields sp) = unsafeFields fields
unsafeExpr (ERecUpdate base fields sp) = firstEffect [unsafeExpr base, unsafeFields fields]
unsafeExpr (EPi name implicit qty dom cod sp) = firstEffect [unsafeExpr dom, unsafeExpr cod]
unsafeExpr (EDo stmts sp) = unsafeDos stmts
unsafeExpr (EInterp multi parts sp) = unsafeInterpParts parts
unsafeExpr (EInfix op l r sp) = firstEffect [unsafeExpr l, unsafeExpr r]
unsafeExpr (EBacktick name l r sp) = firstEffect [unsafeExpr l, unsafeExpr r]
unsafeExpr (ESectOp op sp) = Nothing
unsafeExpr (ESectL op rhs sp) = unsafeExpr rhs
unsafeExpr (ESectR lhs op sp) = unsafeExpr lhs
unsafeExpr (EParen inner sp) = unsafeExpr inner
unsafeExpr (EAnn value ty sp) = unsafeExpr value

-- | `unsafeExpr` 的列表版（显式结构递归，终止性检查可见下降）。
unsafeExprs : List Expr -> Maybe String
unsafeExprs [] = Nothing
unsafeExprs (e :: rest) = firstEffect [unsafeExpr e, unsafeExprs rest]

-- | `unsafeExpr` 对 let 绑定的 RHS 版。
unsafeBinds : List (Pair Pat Expr) -> Maybe String
unsafeBinds [] = Nothing
unsafeBinds ((Pair pat value) :: rest) = firstEffect [unsafeExpr value, unsafeBinds rest]

-- | `unsafeExpr` 对 case 分支 body 版。
unsafeAlts : List (Pair Pat Expr) -> Maybe String
unsafeAlts [] = Nothing
unsafeAlts ((Pair pat body) :: rest) = firstEffect [unsafeExpr body, unsafeAlts rest]

-- | `unsafeExpr` 对局部函数 clause body 版。
unsafeLocalClauses : List (Pair (List Pat) Expr) -> Maybe String
unsafeLocalClauses [] = Nothing
unsafeLocalClauses ((Pair pats body) :: rest) =
  firstEffect [unsafeExpr body, unsafeLocalClauses rest]

-- | `unsafeExpr` 对模板字符串洞版。
unsafeInterpParts : List InterpPart -> Maybe String
unsafeInterpParts [] = Nothing
unsafeInterpParts ((IPText s) :: rest) = unsafeInterpParts rest
unsafeInterpParts ((IPHole e) :: rest) = firstEffect [unsafeExpr e, unsafeInterpParts rest]

-- | `unsafeExpr` 对 record 字段值版。
unsafeFields : List (Pair String Expr) -> Maybe String
unsafeFields [] = Nothing
unsafeFields ((Pair fname value) :: rest) = firstEffect [unsafeExpr value, unsafeFields rest]

-- | `unsafeExpr` 对 do 语句版。
unsafeDo : DoStmt -> Maybe String
unsafeDo (DBind pat value sp) = unsafeExpr value
unsafeDo (DExpr value sp) = unsafeExpr value

-- | `unsafeExpr` 对 do 块版。
unsafeDos : List DoStmt -> Maybe String
unsafeDos [] = Nothing
unsafeDos (s :: rest) = firstEffect [unsafeDo s, unsafeDos rest]

-- | 定义的信任点名：顶层定义已带模块前缀；实例方法 / 入口定义补前缀
-- （入口定义保持裸名，但 manifest 只接受全限定名，所以入口里的直接使用无法被信任）。
trustNameOf : String -> String -> String
trustNameOf label name = if label == "<entry>" || containsDot name then name else "${label}.${name}"

-- | 严格模式下单个定义的检查：直接引用 unsafe 门控目标且不在信任点里 → 报错。
checkTrustDef : String -> String -> List String -> String -> Expr -> Result Int
checkTrustDef label pkg trusted name body = case unsafeExpr body of
  Nothing => Ok 0
  Just ref =>
    let
      full = trustNameOf label name
    in if memName full trusted then Ok 0
    else Err
      "${label}: definition `${full}` directly references unsafe-gated `${ref}` and is not a trust point of ${packageLabelForEffects pkg}; ${trustFixHint label full}"

-- | 信任违反的修复提示：库定义列进 `[trust] unsafe`；入口定义必须先移进库模块。
trustFixHint : String -> String -> String
trustFixHint label full =
  if label == "<entry>" then "move this definition into a package library module and list its qualified name under [trust] unsafe"
  else "add \"${full}\" to [trust] unsafe in vuna.toml (or route the call through an existing trust point such as Base.IO.runIO)"

-- | 严格模式下列表里逐个定义检查（DFun body 与 instance 方法体）。
checkTrustDecls : String -> String -> List String -> List Decl -> Result Int
checkTrustDecls label pkg trusted [] = Ok 0
checkTrustDecls label pkg trusted (d :: rest) =
  andThen (checkTrustDecl label pkg trusted d) (\_ => checkTrustDecls label pkg trusted rest)

-- | 单个声明的定义级信任检查；非函数定义（data/record/trait/类型签名）没有 body。
checkTrustDecl : String -> String -> List String -> Decl -> Result Int
checkTrustDecl label pkg trusted (DFun name pats body sp) =
  checkTrustDef label pkg trusted name body
checkTrustDecl label pkg trusted (DInstance ctxE head methods sp) =
  checkTrustDecls label pkg trusted methods
checkTrustDecl label pkg trusted d = Ok 0

-- | D28 严格模式入口：`Nothing`（没有 `[trust]` section）= 不做定义级检查。
checkDefinitionTrust : String -> String -> Maybe (List String) -> List Decl -> Result Int
checkDefinitionTrust label pkg Nothing decls = Ok 0
checkDefinitionTrust label pkg (Just trusted) decls = checkTrustDecls label pkg trusted decls

-- ---------------------------------------------------------------
-- D28：信任点存在性（`[trust] unsafe` 的每项必须是本包真实定义）。
-- 只在 **被检查的包**（上下文包）上做：依赖包的模块可能只加载了 import 闭包，
-- 无法判断未加载模块里的定义；依赖包自己 check/build 时已经校验过。
-- ---------------------------------------------------------------
-- | 定义全限定名：顶层定义已带模块前缀，实例方法补模块前缀；`moduleName == ""`
-- 表示入口文件（定义名保持裸名）。
qualifyDefName : String -> String -> String
qualifyDefName moduleName name =
  if moduleName == "" || containsDot name then name else "${moduleName}.${name}"

-- | 单个声明贡献的定义全限定名（只有 DFun / DAxiom 和 instance 的 DFun 方法）。
declDefNames : String -> Decl -> List String
declDefNames moduleName (DFun name pats body sp) = [qualifyDefName moduleName name]
declDefNames moduleName (DAxiom name ty sp) = [qualifyDefName moduleName name]
declDefNames moduleName (DInstance ctxE head methods sp) = methodDefNames moduleName methods
declDefNames moduleName d = []

-- | instance 方法体里的定义全限定名。
methodDefNames : String -> List Decl -> List String
methodDefNames moduleName [] = []
methodDefNames moduleName (m :: rest) = case m of
  DFun name pats body sp => append [qualifyDefName moduleName name] (methodDefNames moduleName rest)
  _ => methodDefNames moduleName rest

-- | 一个模块的全部定义名。
moduleDefNames : String -> List Decl -> List String
moduleDefNames moduleName decls = concatMap (declDefNames moduleName) decls

-- | 上下文包里所有已加载模块的定义名（只算本包模块，不含依赖包）。
ownPackageDefNames : String -> List Module -> List String
ownPackageDefNames pkg [] = []
ownPackageDefNames pkg (m :: rest) =
  let
    here =
      if modulePackageOf m == pkg then moduleDefNames (moduleNameOf m) (moduleDeclsOf m) else []
  in append here (ownPackageDefNames pkg rest)

-- | 本包模块名集合（信任点存在性校验用；不含依赖包模块）。
ownPackageModuleNames : String -> List Module -> List String
ownPackageModuleNames pkg [] = []
ownPackageModuleNames pkg (m :: rest) =
  let
    here = if modulePackageOf m == pkg then [moduleNameOf m] else []
  in append here (ownPackageModuleNames pkg rest)

-- | 信任点名字的模块前缀（`Base.IO.runIO` -> `Base.IO`）。
trustPointModulePrefix : String -> String
trustPointModulePrefix t = case splitLastDot (splitOnDot t) of
  Pair revPrefix base => joinDots revPrefix

-- | 信任点的「不是本包真实定义」错误（完整 / 部分加载共用文案）。
trustPointMissing : String -> String -> Result a
trustPointMissing pkg t =
  Err
    "${pkg}: trust point \"${t}\" is not a definition of this package; [trust] unsafe may only list real definitions (Module.def)"

-- | 完整加载（库包 check/build）时的逐项校验：每项必须落在已知定义名集合里。
checkTrustListFull : String -> List String -> List String -> Result Int
checkTrustListFull pkg [] universe = Ok 0
checkTrustListFull pkg (t :: rest) universe =
  if memName t universe then checkTrustListFull pkg rest universe else trustPointMissing pkg t

-- | 部分加载（入口 / 单文件 / REPL / LSP）时的逐项校验：只校验**本包已加载模块**里的项；
-- 未加载模块的项无法判断（模块名拼错在整包 / 库包 check 时能报出，避免入口闭包误报）。
checkTrustListLoaded : String -> List String -> List String -> List String -> Result Int
checkTrustListLoaded pkg [] universe modNames = Ok 0
checkTrustListLoaded pkg (t :: rest) universe modNames =
  if memName t universe then checkTrustListLoaded pkg rest universe modNames
  else if memName (trustPointModulePrefix t) modNames then trustPointMissing pkg t
  else checkTrustListLoaded pkg rest universe modNames

-- | D28 严格模式的信任点存在性校验：入口定义（裸名）+ 本包模块定义（全限定名）。
-- `complete` 由 Loader 给出：库包 [export] 全量加载 = True（要求每项可解析）；
-- 入口 / 单文件 / REPL / LSP 只加载 import 闭包 = False（只校验已加载模块里的项）。
checkTrustPoints : String -> Maybe (List String) -> Bool -> List Decl -> List Module -> Result Int
checkTrustPoints pkg Nothing complete entryDecls modules = Ok 0
checkTrustPoints pkg (Just trusted) complete entryDecls modules =
  let
    universe = append (concatMap (declDefNames "") entryDecls) (ownPackageDefNames pkg modules)
    modNames = ownPackageModuleNames pkg modules
  in if complete then checkTrustListFull pkg trusted universe
  else checkTrustListLoaded pkg trusted universe modNames

-- 效果被拒的上下文描述：ad-hoc 文件（无 manifest、base-only 上下文）没有包名。
packageLabelForEffects : String -> String
packageLabelForEffects pkg = if pkg == "" then "ad-hoc file (no package)" else "package ${pkg}"

-- | 现有（包级）效应检查：整模块第一个效应必须被能力表放行（unsafe 由能力 `unsafe`
-- 单独放行；定义级信任检查在 `checkDefinitionTrust` 里）。
checkModuleEffects : String -> String -> List String -> List Decl -> Result Int
checkModuleEffects label pkg caps decls = case effDecls decls of
  Nothing => Ok 0
  Just name => if isUnsafeExecutor name then if memName "unsafe" caps then Ok 0
  else Err
    "${label}: `runIO` executes IO outside main; requires capability `unsafe` in ${packageLabelForEffects pkg} (declare [capabilities] effects = [\"unsafe\"])"
  else if allowsEffect caps name then Ok 0
  else case findIntrinsic name of
    Just i => case intrinsicCapability i of
      Just c =>
        Err
          "${label}: effectful builtin `${name}` requires capability `${capabilityName c}` in ${packageLabelForEffects pkg} (declare [capabilities] effects = [\"${capabilityName c}\"] or use Base.IO)"
      Nothing => Ok 0
    Nothing => Ok 0

-- | M27 + D28：包级能力校验 → 整模块首个效应检查 → 严格模式定义级信任检查。
checkEffectsBuiltins : String -> String -> List String -> Maybe (List String) -> List Decl -> Result (List Decl)
checkEffectsBuiltins label pkg caps trust decls =
  andThen (checkCapabilities label caps)
    (\_ => andThen (checkModuleEffects label pkg caps decls) (\_ => andThen (checkDefinitionTrust label pkg trust decls) (\_ => Ok decls)))

tyShape : Expr -> String
tyShape (EVar n _) = "var ${n}"
tyShape (EApp f a _) = "app"
tyShape (EInt n _) = "int"
tyShape (EStr s _) = "str"
tyShape (EFloat raw _) = "float"
tyShape (ELam ps b _) = "lam"
tyShape (ELet bs b _ _) = "let"
tyShape (ECase s alts _) = "case"
tyShape (EIf c t e _) = "if"
tyShape (EDo stmts _) = "do"
tyShape _ = "other"

-- 值命名空间命中里混入的同名构造子条目（含 module 重导出/iface 缓存）：
-- 取 kind=ctor 或 target 是 data/record 构造子的条目，按重载候选处理。
-- | 自动补注（M41 新增导出）：ctorPairTargets。
ctorPairTargets : List Module -> List (Pair String ExportEntry) -> List String
ctorPairTargets modules [] = []
ctorPairTargets modules ((Pair m e) :: rest) =
  let
    isCtor = e.kind == "ctor" || isDataOrRecordCtorTarget modules e.target
  in if isCtor then e.target :: ctorPairTargets modules rest else ctorPairTargets modules rest
