module Vuna.Compiler.Loader.Resolve (checkEffectsBuiltins, resolveEntry, resolveProgram) where

-- Vuna.Compiler.Loader.Resolve：名字解析（M24 后维护（源码重组）从 Loader.vuna 拆出）。
--
-- 从模块/导出表查询（`Loader.Modules`）出发，把 parse 后的声明与表达式解析成带模块前缀
-- 的名字；同时负责 DT prelude 名字放行、effectful 内建的包级限制（原
-- `Vuna.Compiler.Loader.Builtins` 的 `builtinArity` 已按源码重组计划合并进来）。
-- 导出表计算、加载流程与 flatten 在 `Loader.Flatten`。
import Vuna.Compiler.Frontend.Diagnostics
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Loader.Modules

-- 解析器递归显式 fuel：下降证明只认同一参数位置的严格递减，而这里
-- 递归既沿表达式子项也沿绑定列表/作用域前进，单测度表达不了；用 fuel + 递减。
-- 上界远大于任何可由内存构造的 AST 的递归调用数（1G）。
resolveFuelBound : Int
resolveFuelBound = 1073741824

-- 内建函数的名字与元数（原 `Vuna.Compiler.Loader.Builtins`，M24 后维护（源码重组）合并进本模块）。
builtinArity : String -> Maybe Int
builtinArity "+" = Just 2
builtinArity "-" = Just 2
builtinArity "*" = Just 2
builtinArity "/" = Just 2
builtinArity "==" = Just 2
builtinArity "/=" = Just 2
builtinArity "<" = Just 2
builtinArity "<=" = Just 2
builtinArity ">" = Just 2
builtinArity ">=" = Just 2
builtinArity "&&" = Just 2
builtinArity "||" = Just 2
builtinArity "++" = Just 2
builtinArity "bi_show_string" = Just 1
builtinArity "bi_eq_generic" = Just 2
builtinArity "bi_neq_generic" = Just 2
builtinArity "bi_lt_generic" = Just 2
builtinArity "bi_le_generic" = Just 2
builtinArity "bi_gt_generic" = Just 2
builtinArity "bi_ge_generic" = Just 2
builtinArity "bi_eq_int" = Just 2
builtinArity "bi_neq_int" = Just 2
builtinArity "bi_lt_int" = Just 2
builtinArity "bi_le_int" = Just 2
builtinArity "bi_gt_int" = Just 2
builtinArity "bi_ge_int" = Just 2
builtinArity "bi_eq_str" = Just 2
builtinArity "bi_neq_str" = Just 2
builtinArity "bi_eq_bool" = Just 2
builtinArity "bi_neq_bool" = Just 2
builtinArity "strLength" = Just 1
builtinArity "strConcatMany" = Just 1
builtinArity "strSubstTemplate" = Just 2
builtinArity "timeUs" = Just 0
builtinArity "strHash" = Just 1
builtinArity "strAt" = Just 2
builtinArity "strUnpack" = Just 1
builtinArity "strPack" = Just 1
builtinArity "strFromInt" = Just 1
builtinArity "readFile" = Just 1
builtinArity "writeFile" = Just 2
builtinArity "print" = Just 1
builtinArity "getArgs" = Just 0
builtinArity "readLine" = Just 0
builtinArity "readDir" = Just 1
builtinArity "isDirectory" = Just 1
builtinArity "makeDir" = Just 1
builtinArity "removeFile" = Just 1
builtinArity "fileExists" = Just 1
builtinArity "fileMtime" = Just 1
builtinArity "fileSize" = Just 1
builtinArity "exit" = Just 1
-- 效果原语的内部名字：stdlib Base.IO 用它们实现公开的 IO API；
-- 普通包不可直接调用（Loader 的 effectful 包级限制覆盖 prim_*）。
builtinArity "prim_readFile" = Just 1
builtinArity "prim_writeFile" = Just 2
builtinArity "prim_print" = Just 1
builtinArity "prim_getArgs" = Just 0
builtinArity "prim_readLine" = Just 0
builtinArity "prim_readDir" = Just 1
builtinArity "prim_isDirectory" = Just 1
builtinArity "prim_makeDir" = Just 1
builtinArity "prim_removeFile" = Just 1
builtinArity "prim_fileExists" = Just 1
builtinArity "prim_fileMtime" = Just 1
builtinArity "prim_fileSize" = Just 1
builtinArity "prim_exit" = Just 1
builtinArity "prim_runIn" = Just 2
builtinArity _ = Nothing

isBuiltinName : String -> Bool
isBuiltinName name = case builtinArity name of
  Just arity => True
  Nothing => False

-- DT prelude 里在 Loader 阶段必须放行的名字（M20）。
--
-- DT 单文件时这些名字由 `Elab.Prelude.preludeGlobals` 直接提供，Loader 不参与；M20 起
-- `--dt` 复用 Loader，于是 `Int` / `String` / `Bool` / 运算符号 / `str*` 都要能被解析。
-- 这里只放行**纯解析**，语义仍由 `Elab` 的 prelude 决定。
--
-- M24.7：`show` / `eq` / `neq` / `lt` / `le` / `gt` / `ge` 已从放行表移除——trait 与
-- 实例迁到库（`Base.Show` / `Base.Eq` / `Base.Ord`），裸名必须经 import 的导出表解析。
isDtPreludeName : String -> Bool
isDtPreludeName name = memName name dtPreludeNames

dtPreludeNames : List String
dtPreludeNames =
  [ "Type",
    "->",
    "_",
    "Int",
    "String",
    "+",
    "-",
    "*",
    "/",
    "==",
    "/=",
    "<",
    "<=",
    ">",
    ">=",
    "++",
    "&&",
    "||",
    "strFromInt",
    "strUnpack",
    "strPack",
    "strLength",
    "strConcatMany",
    "strSubstTemplate",
    "timeUs",
    "strHash",
    "strAt"
  ]

-- M24.7：trait 迁到库后，缺 import 是最常见的错误来源。除了常规的
-- unbound/unknown 诊断，再给一条可操作提示（单文件 / 未 import 的场景）。
traitImportHint : String -> String
traitImportHint name = case name of
  "Show" => " (trait Show is not in scope; add `import Base.Show`)"
  "Eq" => " (trait Eq is not in scope; add `import Base.Eq`)"
  "Ord" => " (trait Ord is not in scope; add `import Base.Ord`)"
  "show" => " (trait method show; add `import Base.Show`)"
  "eq" => " (trait method eq; add `import Base.Eq`)"
  "neq" => " (trait method neq; add `import Base.Eq`)"
  "lt" => " (trait method lt; add `import Base.Ord`)"
  "le" => " (trait method le; add `import Base.Ord`)"
  "gt" => " (trait method gt; add `import Base.Ord`)"
  "ge" => " (trait method ge; add `import Base.Ord`)"
  _ => ""

resolveQualified : List Module -> String -> List Import -> String -> Result String
resolveQualified modules label imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      prefix = joinDots revPrefix
    in case findImportPrefix imports prefix of
      Nothing => Err (label ++ ": module " ++ prefix ++ " is not imported")
      Just m => if isGlobalCtor base then Ok base
      else andThen (exportsOf modules m) (\es => case findExportValue es base of
        Just e => Ok (entryTarget e)
        Nothing => Err (label ++ ": " ++ base ++ " is not exported by " ++ m)
      )

-- 模式里的限定名只认构造器：`M.foo`（foo 是函数）必须报错，不能按值解析成构造器。
resolveQualifiedCtor : List Module -> String -> List Import -> String -> Result String
resolveQualifiedCtor modules label imports name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      prefix = joinDots revPrefix
    in case findImportPrefix imports prefix of
      Nothing => Err (label ++ ": module " ++ prefix ++ " is not imported")
      Just m => if isGlobalCtor base then Ok base
      else andThen (exportsOf modules m) (\es => case findExportCtor es base of
        Just e => Ok (entryTarget e)
        Nothing => Err (label ++ ": constructor " ++ base ++ " is not exported by " ++ m)
      )

-- 带点表达式的解析（M10.5）：先按「最长可解析模块前缀」尝试限定名/限定值+字段链，
-- 否则按「变量/顶层名 + 字段链」处理。`p.x`、`M.point.x`、`Vuna.Compiler.Frontend.Parser.parseSource` 都走这里。
resolveDottedExpr : List Module -> String -> String -> List String -> List Import -> List String -> String -> Span -> Result Expr
resolveDottedExpr modules label prefix own imports scope name sp = case splitOnDot name of
  [] => Err (label ++ ": invalid dotted name " ++ name)
  head :: rest => if memName head scope then Ok (foldFieldChain (EVar head sp) rest sp)
  else andThen (resolveQualifiedPath modules label imports (splitOnDot name) (length (splitOnDot name)) sp) (\q => case q of
    Just e => Ok e
    Nothing =>
      if memName head own then Ok (foldFieldChain (EVar (mangle prefix head) sp) rest sp)
      else if isBuiltinName head then Ok (foldFieldChain (EVar head sp) rest sp)
      else if startsUpperName head then Err (label ++ ": module " ++ head ++ " is not imported")
      else andThen (resolveGlobal modules label prefix own imports scope head)
        (\n => Ok (foldFieldChain (EVar n sp) rest sp))
  )

foldFieldChain : Expr -> List String -> Span -> Expr
foldFieldChain base [] sp = base
foldFieldChain base (f :: rest) sp = foldFieldChain (EField base f sp) rest sp

takeSegs : Int -> List a -> List a
takeSegs n [] = []
takeSegs n (x :: rest) = if n <= 0 then [] else x :: takeSegs (n - 1) rest

dropSegs : Int -> List a -> List a
dropSegs n [] = []
dropSegs n (x :: rest) = if n <= 0 then x :: rest else dropSegs (n - 1) rest

resolveQualifiedPath : List Module -> String -> List Import -> List String -> Int -> Span -> Result (Maybe Expr)
resolveQualifiedPath modules label imports segs n sp = if n < 1 then Ok Nothing
else case findImportPrefix imports (joinDots (takeSegs (n - 1) segs)) of
  Just m => andThen (exportsOf modules m) (\es => case dropSegs (n - 1) segs of
    [member] => if isGlobalCtor member then Ok (Just (EVar member sp))
    else case findExportValue es member of
      Just e => Ok (Just (EVar (entryTarget e) sp))
      Nothing => Err (label ++ ": " ++ member ++ " is not exported by " ++ m)
    member :: rest => case findExportValue es member of
      Just e => Ok (Just (foldFieldChain (EVar (entryTarget e) sp) rest sp))
      Nothing => Err (label ++ ": " ++ member ++ " is not exported by " ++ m)
    [] => Ok Nothing
  )
  Nothing => resolveQualifiedPath modules label imports segs (n - 1) sp

resolveGlobal : List Module -> String -> String -> List String -> List Import -> List String -> String -> Result String
resolveGlobal modules label prefix own imports scope name = if memName name scope then Ok name
else if isGlobalCtor name then Ok name
else if containsDot name then resolveQualified modules label imports name
else if memName name own then Ok (mangle prefix name)
else if isEffectfulBuiltin name then andThen (modulesExportingValue modules imports name) (\pairs => case pairs of
  [] => Ok name
  _ => andThen (unifyEntryPairs label "name" name pairs) (\p => Ok (entryTarget (secondOf p)))
)
else if isBuiltinName name then Ok name
else if isDtPreludeName name then Ok name
else andThen (modulesExportingValue modules imports name) (\pairs => case pairs of
  [] =>
    Err
      (label ++ ": unbound variable " ++ name ++ suggest name (append own scope) ++ traitImportHint name)
  _ => andThen (unifyEntryPairs label "name" name pairs) (\p => Ok (entryTarget (secondOf p)))
)

resolveCtor : List Module -> String -> String -> List String -> List Import -> String -> Result String
resolveCtor modules label prefix ownCtors imports name = if isGlobalCtor name then Ok name
else if containsDot name then resolveQualifiedCtor modules label imports name
else if memName name ownCtors then Ok (mangle prefix name)
else andThen (modulesExportingCtor modules imports name) (\pairs => case pairs of
  [] => Err (label ++ ": unknown constructor " ++ name ++ suggest name ownCtors)
  _ =>
    andThen (unifyEntryPairs label "constructor" name pairs) (\p => Ok (entryTarget (secondOf p)))
)

checkBinder : String -> String -> Result String
checkBinder label name =
  if containsDot name then Err (label ++ ": invalid variable name " ++ name) else Ok name

checkTopName : String -> String -> Result String
checkTopName label name =
  if name == "_" then Err (label ++ ": invalid top-level name _ (bare _ is reserved)")
  else if containsDot name then Err (label ++ ": invalid top-level name " ++ name) else Ok name

resolveTopName : String -> String -> String -> Result String
resolveTopName label prefix name = andThen (checkTopName label name) (\_ => Ok (mangle prefix name))

resolvePattern : Int -> List Module -> String -> String -> List String -> List Import -> Pat -> Result (Pair Pat (List String))
resolvePattern fuel modules label prefix ownCtors imports pat = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case pat of
  PWild sp => Ok (Pair (PWild sp) [])
  PVar name sp => andThen (checkBinder label name) (\_ => Ok (Pair (PVar name sp) [name]))
  PInt n sp => Ok (Pair (PInt n sp) [])
  PStr s sp => Ok (Pair (PStr s sp) [])
  PCon name pats sp =>
    andThen (resolveCtor modules label prefix ownCtors imports name)
      (\name2 => andThen (traverse (\dtv => resolvePattern (fuel - 1) modules label prefix ownCtors imports dtv) pats) (\parts => Ok (Pair (PCon name2 (map firstOf parts) sp) (concatMap secondOf parts))))
  PRecord name fields sp =>
    andThen (resolveCtor modules label prefix ownCtors imports name)
      (\name2 => andThen (traverse (\dtv => resolveRecordPatternField (fuel - 1) modules label prefix ownCtors imports dtv) fields) (\parts => Ok (Pair (PRecord name2 (map firstOf parts) sp) (concatMap secondOf parts))))

resolveRecordPatternField : Int -> List Module -> String -> String -> List String -> List Import -> Pair String Pat -> Result (Pair (Pair String Pat) (List String))
resolveRecordPatternField fuel modules label prefix ownCtors imports (Pair fname pat) = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else andThen (resolvePattern (fuel - 1) modules label prefix ownCtors imports pat) (\p => case p of
  Pair pat2 bound => Ok (Pair (Pair fname pat2) bound)
)

resolveAlt : Int -> List Module -> String -> String -> List String -> List String -> List Import -> List String -> Pair Pat Expr -> Result (Pair Pat Expr)
resolveAlt fuel modules label prefix own ownCtors imports scope (Pair pat body) = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else andThen (resolvePattern resolveFuelBound modules label prefix ownCtors imports pat) (\p => case p of
  Pair pat2 bound =>
    andThen
      (resolveExpr (fuel - 1) modules label prefix own ownCtors imports (append bound scope) body)
      (\body2 => Ok (Pair pat2 body2))
)

resolveLet : Int -> List Module -> String -> String -> List String -> List String -> List Import -> List String -> Bool -> List (Pair Pat Expr) -> Expr -> Result (Pair (List (Pair Pat Expr)) Expr)
resolveLet fuel modules label prefix own ownCtors imports scope rec_ binds body =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else if rec_ then resolveRecLet (fuel - 1) modules label prefix own ownCtors imports scope binds body
  else resolveLetSeq (fuel - 1) modules label prefix own ownCtors imports scope binds body

resolveLetSeq : Int -> List Module -> String -> String -> List String -> List String -> List Import -> List String -> List (Pair Pat Expr) -> Expr -> Result (Pair (List (Pair Pat Expr)) Expr)
resolveLetSeq fuel modules label prefix own ownCtors imports scope binds body = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case binds of
  [] =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope body)
      (\b => Ok (Pair [] b))
  (Pair pat value) :: rest => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope value) (\value2 => andThen (resolvePattern resolveFuelBound modules label prefix ownCtors imports pat) (\p => case p of
    Pair pat2 bound => andThen (resolveLetSeq (fuel - 1) modules label prefix own ownCtors imports (append bound scope) rest body) (\r => case r of
      Pair binds2 body2 => Ok (Pair (Pair pat2 value2 :: binds2) body2)
    )
  )
  )

-- 递归 let（where 块）：所有绑定名对全部 value 与 body 可见。
resolveRecLet : Int -> List Module -> String -> String -> List String -> List String -> List Import -> List String -> List (Pair Pat Expr) -> Expr -> Result (Pair (List (Pair Pat Expr)) Expr)
resolveRecLet fuel modules label prefix own ownCtors imports scope binds body = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case collectRecBinds modules label prefix ownCtors imports binds of
  Err e => Err e
  Ok (Pair names pairs) =>
    let
      scope2 = append names scope
    in andThen (resolveRecValues (fuel - 1) modules label prefix own ownCtors imports scope2 pairs)
      (\values2 => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope2 body) (\b => Ok (Pair values2 b)))

collectRecBinds : List Module -> String -> String -> List String -> List Import -> List (Pair Pat Expr) -> Result (Pair (List String) (List (Pair Pat Expr)))
collectRecBinds modules label prefix ownCtors imports [] = Ok (Pair [] [])
collectRecBinds modules label prefix ownCtors imports ((Pair pat value) :: rest) = andThen (resolvePattern resolveFuelBound modules label prefix ownCtors imports pat) (\pr => case pr of
  Pair pat2 bound => andThen (collectRecBinds modules label prefix ownCtors imports rest) (\r => case r of
    Pair names tail => Ok (Pair (append bound names) (Pair pat2 value :: tail))
  )
)

resolveRecValues : Int -> List Module -> String -> String -> List String -> List String -> List Import -> List String -> List (Pair Pat Expr) -> Result (List (Pair Pat Expr))
resolveRecValues fuel modules label prefix own ownCtors imports scope [] =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else Ok []
resolveRecValues fuel modules label prefix own ownCtors imports scope ((Pair pat value) :: rest) =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope value)
    (\value2 => andThen (resolveRecValues (fuel - 1) modules label prefix own ownCtors imports scope rest) (\tail => Ok (Pair pat value2 :: tail)))

resolveExpr : Int -> List Module -> String -> String -> List String -> List String -> List Import -> List String -> Expr -> Result Expr
resolveExpr fuel modules label prefix own ownCtors imports scope expr = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case expr of
  EVar name sp =>
    if containsDot name then resolveDottedExpr modules label prefix own imports scope name sp
    else andThen (resolveGlobal modules label prefix own imports scope name) (\n => Ok (EVar n sp))
  EInt n sp => Ok (EInt n sp)
  EStr s sp => Ok (EStr s sp)
  ELam params body sp =>
    andThen (traverse (checkBinder label) params)
      (\_ => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports (append params scope) body) (\b => Ok (ELam params b sp)))
  EApp fn args sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope fn)
      (\fn2 => andThen (traverse (\a => resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope a) args) (\args2 => Ok (EApp fn2 args2 sp)))
  -- M20：`EPi` 只做**结构递归解析**，不在这里判定「是否允许」。M13–M19 的 DT 是单文件、
  -- 不经 Loader，所以这条以前直接拒绝；M20 起 `--dt` 复用 Loader，而依赖类型是 DT 的
  -- 核心语法。放行判定的责任交给下游检查器：早期 HM 的 `Typecheck`（已删除）曾报
  -- `dependent function type requires --dt`（既有行为不变），DT 的 `Elab` 正常精化。
  EPi name implicit dom cod sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope dom)
      (\dom2 => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports (append [name] scope) cod) (\cod2 => Ok (EPi name implicit dom2 cod2 sp)))
  ELet binds body rec_ sp => andThen (resolveLet (fuel - 1) modules label prefix own ownCtors imports scope rec_ binds body) (\r => case r of
    Pair binds2 body2 => Ok (ELet binds2 body2 rec_ sp)
  )
  ECase scrut alts sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope scrut)
      (\scrut2 => andThen (traverse (\dtv => resolveAlt (fuel - 1) modules label prefix own ownCtors imports scope dtv) alts) (\alts2 => Ok (ECase scrut2 alts2 sp)))
  EIf c t e sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope c)
      (\c2 => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope t) (\t2 => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope e) (\e2 => Ok (EIf c2 t2 e2 sp))))
  EField base fname sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope base)
      (\b => Ok (EField b fname sp))
  ERecord name fields sp =>
    andThen (resolveCtor modules label prefix ownCtors imports name)
      (\name2 => andThen (traverse (\dtv => resolveFieldValue (fuel - 1) modules label prefix own ownCtors imports scope dtv) fields) (\fs => Ok (ERecord name2 fs sp)))
  ERecUpdate base fields sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope base)
      (\b => andThen (traverse (\dtv => resolveFieldValue (fuel - 1) modules label prefix own ownCtors imports scope dtv) fields) (\fs => Ok (ERecUpdate b fs sp)))
  EInstSel meth name sp => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope meth) (\m2 => case resolveGlobal modules label prefix own imports scope name of
    Err e => Err (label ++ ": unknown instance name " ++ name ++ " (@" ++ name ++ ")")
    Ok n2 => Ok (EInstSel m2 n2 sp)
  )
  EDo stmts sp =>
    andThen (desugarDo stmts)
      (\e => resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope e)
  -- M24：where 绑定签名（`g : Int -> Int`）降级成 `EAnn value ty`；值与类型都做名字解析。
  EAnn value ty sp =>
    andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope value)
      (\v2 => andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope ty) (\t2 => Ok (EAnn v2 t2 sp)))

-- do（M11）在这里 desugar 成 bind/pure 的普通应用，后续类型检查与 codegen 无需认识 do。
-- 最后一条裸表达式即块结果（`do e` = `e`）；裸语句用 `bind e (\_ -> rest)` 顺序化。
desugarDo : List DoStmt -> Result Expr
desugarDo [] = psErr0 DoBlockNeedsStatement
desugarDo ([DExpr e sp]) = Ok e
desugarDo ((DExpr e sp) :: rest) =
  andThen (desugarDo rest)
    (\tail => Ok (EApp (EVar "bind" sp) [e, ELam ["vuna_do_ignore"] tail sp] sp))
desugarDo ((DBind (PVar name psp) e sp) :: rest) =
  andThen (desugarDo rest) (\tail => Ok (EApp (EVar "bind" sp) [e, ELam [name] tail sp] sp))
desugarDo ((DBind (PWild psp) e sp) :: rest) =
  andThen (desugarDo rest)
    (\tail => Ok (EApp (EVar "bind" sp) [e, ELam ["vuna_do_ignore"] tail sp] sp))
desugarDo ((DBind pat e sp) :: rest) = psErr0 DoBindPattern

resolveFieldValue : Int -> List Module -> String -> String -> List String -> List String -> List Import -> List String -> Pair String Expr -> Result (Pair String Expr)
resolveFieldValue fuel modules label prefix own ownCtors imports scope (Pair fname value) =
  if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
  else andThen (resolveExpr (fuel - 1) modules label prefix own ownCtors imports scope value)
    (\v => Ok (Pair fname v))

resolveCtorDecl : String -> String -> String -> Result String
resolveCtorDecl label prefix ctor =
  if isGlobalCtor ctor then Ok ctor
  else andThen (checkTopName label ctor) (\_ => Ok (mangle prefix ctor))

isLowerTypeName : String -> Bool
isLowerTypeName name = case strUnpack name of
  [] => False
  c :: rest => isLowerChar c

startsUpperName : String -> Bool
startsUpperName name = case strUnpack name of
  [] => False
  c :: rest => c >= 65 && c <= 90

-- 类型名解析（M20：本模块声明的类型名**优先于**内建名）。
--
-- `Base.Bool` 会重新声明 `data Bool`，此时 `Bool` 应解析成 `Base.Bool.Bool`（mangled），
-- 而不是内建 `Bool`——否则构造子检查会报 `constructor False does not return
-- Base.Bool.Bool`（族名对不上）。因此 `ownTypes` 的判定必须排在内建名之前。
resolveTypeName : List Module -> String -> String -> List String -> List Import -> String -> Result String
resolveTypeName modules label prefix ownTypes imports name = if memName name ownTypes then Ok (mangle prefix name)
else if name == "Int" || name == "String" || name == "Bool" || name == "Type" || name == "->" then Ok name
else if isLowerTypeName name then Ok name
else if containsDot name then case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      typePrefix = joinDots revPrefix
    in case findImportPrefix imports typePrefix of
      Nothing => Err (label ++ ": module " ++ typePrefix ++ " is not imported")
      Just m => andThen (exportsOf modules m) (\es => case findExportType es base of
        Just e => Ok (entryTarget e)
        Nothing => Err (label ++ ": type " ++ base ++ " is not exported by " ++ m)
      )
else andThen (modulesExportingType modules imports name) (\pairs => case pairs of
  -- M30：类型位置也可能出现**跨模块 import 的构造子**（依赖类型索引，如 `import Base.Nat`
  -- 后 `Vec a Zero` 的 `Zero`）。`modulesExportingType` 只查 `"type"` entry，找不到构造子，
  -- 故回退到 `resolveCtor`（值位置同款解析，认 `"ctor"` entry）。本地构造子走 `[]`
  -- （本模块 `data` 定义的族，其构造子经 `ownTypes`/内建名处理；且本地构造子按惯例不作索引）。
  [] => andThen (resolveCtor modules label prefix [] imports name) (\c => Ok c)
  _ => andThen (unifyEntryPairs label "type" name pairs) (\p => Ok (entryTarget (secondOf p)))
)

resolveTypeExpr : Int -> List Module -> String -> String -> List String -> List Import -> Expr -> Result Expr
resolveTypeExpr fuel modules label prefix ownTypes imports ty = if fuel <= 0 then Err "DT: resolve fuel exhausted (internal: resolver made no progress)"
else case ty of
  -- M20：DT 的层级（`Type 1`）与洞（`_`）在这里只做结构放行，语义由下游检查器决定。
  EApp (EVar "Type" _) args _ => Ok ty
  EInt n sp => Ok ty
  EVar name sp =>
    andThen (resolveTypeName modules label prefix ownTypes imports name) (\n => Ok (EVar n sp))
  EApp fn args sp =>
    andThen (resolveTypeExpr (fuel - 1) modules label prefix ownTypes imports fn)
      (\fn2 => andThen (traverse (\dtv => resolveTypeExpr (fuel - 1) modules label prefix ownTypes imports dtv) args) (\args2 => Ok (EApp fn2 args2 sp)))
  -- M20：同上——只做结构递归，允许与否交给下游检查器。
  EPi name implicit dom cod sp =>
    andThen (resolveTypeExpr (fuel - 1) modules label prefix ownTypes imports dom)
      (\dom2 => andThen (resolveTypeExpr (fuel - 1) modules label prefix ownTypes imports cod) (\cod2 => Ok (EPi name implicit dom2 cod2 sp)))
  _ => Err (label ++ ": invalid type expression (" ++ tyShape ty ++ ")")

resolveTypeTopName : String -> String -> String -> Result String
resolveTypeTopName label prefix name =
  andThen (checkTopName label name) (\_ => Ok (mangle prefix name))

resolveCtorSpec : List Module -> String -> String -> List String -> List Import -> Ctor -> Result Ctor
resolveCtorSpec modules label prefix ownTypes imports (Ctor ctor ty arity sp) =
  andThen (resolveCtorDecl label prefix ctor)
    (\c2 => andThen (resolveTypeExpr resolveFuelBound modules label prefix ownTypes imports ty) (\ty2 => Ok (Ctor c2 ty2 arity sp)))

resolveDecl : List Module -> String -> String -> List String -> List String -> List String -> List Import -> Decl -> Result Decl
resolveDecl modules label prefix own ownCtors ownTypes imports d = case d of
  DData dname params kind ctors derivings sp =>
    andThen (resolveTypeTopName label prefix dname)
      (\dn => andThen (resolveTypeExpr resolveFuelBound modules label prefix ownTypes imports kind) (\kind2 => andThen (traverse (resolveCtorSpec modules label prefix ownTypes imports) ctors) (\ctors2 => andThen (traverse (resolveTypeName modules label prefix ownTypes imports) derivings) (\ds2 => Ok (DData dn params kind2 ctors2 ds2 sp)))))
  DRecord dname params fields derivings sp =>
    andThen (resolveTypeTopName label prefix dname)
      (\dn => andThen (traverse (resolveRecordField modules label prefix ownTypes imports) fields) (\fields2 => andThen (traverse (resolveTypeName modules label prefix ownTypes imports) derivings) (\ds2 => Ok (DRecord dn params fields2 ds2 sp))))
  DTrait tname params methods sp =>
    andThen (resolveTypeTopName label prefix tname)
      (\tn => andThen (traverse (resolveTraitMethod modules label prefix ownTypes imports) methods) (\ms => Ok (DTrait tn params ms sp)))
  DInstance iname isDefault head methods sp =>
    andThen (resolveInstanceName label prefix iname)
      (\in2 => andThen (resolveTypeExpr resolveFuelBound modules label prefix ownTypes imports head) (\head2 => andThen (traverse (resolveInstanceMethod modules label prefix own ownCtors ownTypes imports) methods) (\ms => Ok (DInstance in2 isDefault head2 ms sp))))
  DSig name ty sp =>
    andThen (resolveTopName label prefix name)
      (\n => andThen (resolveTypeExpr resolveFuelBound modules label prefix ownTypes imports ty) (\ty2 => Ok (DSig n ty2 sp)))
  DFun name pats body sp =>
    andThen (resolveTopName label prefix name)
      (\n => andThen (traverse (resolvePattern resolveFuelBound modules label prefix ownCtors imports) pats) (\parts => andThen (resolveExpr resolveFuelBound modules label prefix own ownCtors imports (concatMap secondOf parts) body) (\b => Ok (DFun n (map firstOf parts) b sp))))

resolveRecordField : List Module -> String -> String -> List String -> List Import -> Field -> Result Field
resolveRecordField modules label prefix ownTypes imports (Field fname ty sp) =
  andThen (checkBinder label fname)
    (\_ => andThen (resolveTypeExpr resolveFuelBound modules label prefix ownTypes imports ty) (\ty2 => Ok (Field fname ty2 sp)))

resolveTraitMethod : List Module -> String -> String -> List String -> List Import -> Pair String Expr -> Result (Pair String Expr)
resolveTraitMethod modules label prefix ownTypes imports (Pair mname ty) =
  andThen (resolveTopName label prefix mname)
    (\n => andThen (resolveTypeExpr resolveFuelBound modules label prefix ownTypes imports ty) (\ty2 => Ok (Pair n ty2)))

-- 未命名实例（default）没有公开名字；给一个模块内私有的内部名字，便于校验孤儿规则。
resolveInstanceName : String -> String -> Maybe String -> Result (Maybe String)
resolveInstanceName label prefix Nothing = Ok (Just (mangle prefix "#default"))
resolveInstanceName label prefix (Just name) =
  andThen (resolveTopName label prefix name) (\n => Ok (Just n))

resolveInstanceMethod : List Module -> String -> String -> List String -> List String -> List String -> List Import -> Decl -> Result Decl
resolveInstanceMethod modules label prefix own ownCtors ownTypes imports d = case d of
  DSig name ty sp =>
    andThen (checkTopName label name)
      (\_ => andThen (resolveTypeExpr resolveFuelBound modules label prefix ownTypes imports ty) (\ty2 => Ok (DSig name ty2 sp)))
  DFun name pats body sp =>
    andThen (checkTopName label name)
      (\_ => andThen (traverse (resolvePattern resolveFuelBound modules label prefix ownCtors imports) pats) (\parts => andThen (resolveExpr resolveFuelBound modules label prefix own ownCtors imports (concatMap secondOf parts) body) (\b => Ok (DFun name (map firstOf parts) b sp))))
  _ => Err (label ++ ": instance body may only contain method signatures/definitions")

resolveProgram : List Module -> String -> String -> List String -> List String -> List String -> List Import -> List Decl -> Result (List Decl)
resolveProgram modules label prefix own ownCtors ownTypes imports decls =
  traverse (resolveDecl modules label prefix own ownCtors ownTypes imports) decls

resolveEntry : List Module -> String -> List Import -> List Decl -> Result (List Decl)
resolveEntry modules entryPkg imports decls =
  andThen
    (resolveProgram modules "<entry>" "" (append (topNames decls) (typeNamesOf decls)) (ctorsOf decls) (append (ctorsOf decls) (append (topNames decls) (typeNamesOf decls))) imports decls)
    (\d => checkEffectsBuiltins "<entry>" entryPkg d)

resolveModules : List Module -> Result (List Decl)
resolveModules modules = case modules of
  [] => Ok []
  (Module name mpkg imports imps decls exports) :: rest =>
    andThen
      (andThen (resolveProgram modules name name (append (topNames decls) (typeNamesOf decls)) (ctorsOf decls) (append (ctorsOf decls) (append (topNames decls) (typeNamesOf decls))) (append imports imps) decls) (\d => checkEffectsBuiltins name mpkg d))
      (\d1 => andThen (resolveModules rest) (\d2 => Ok (append d1 d2)))

-- ---------------------------------------------------------------
-- effectful 内建的包级限制（M12.6）
-- 编译器 / 产品 CLI / stdlib 自己需要直接做文件 IO，允许使用纯内建；
-- 普通用户包只能通过 Base.IO 的 IO API 使用效果，不能在纯代码里直接 print/readFile。
-- （--root 原始模式 entryPkg = ""，保留给解释器/测试夹具的调试路径。）
-- ---------------------------------------------------------------
packageAllowsEffects : String -> Bool
packageAllowsEffects pkg = pkg == "vuna" || pkg == "vuna-compiler" || pkg == "vuna-base"

isEffectfulBuiltin : String -> Bool
isEffectfulBuiltin name =
  name == "print"
    || name == "readFile"
    || name == "writeFile"
    || name == "getArgs"
    || name == "readLine"
    || name == "readDir"
    || name == "isDirectory"
    || name == "makeDir"
    || name == "removeFile"
    || name == "fileExists"
    || name == "fileMtime"
    || name == "fileSize"
    || name == "exit"
    || name == "prim_print"
    || name == "prim_readFile"
    || name == "prim_writeFile"
    || name == "prim_getArgs"
    || name == "prim_readLine"
    || name == "prim_readDir"
    || name == "prim_isDirectory"
    || name == "prim_makeDir"
    || name == "prim_removeFile"
    || name == "prim_fileExists"
    || name == "prim_fileMtime"
    || name == "prim_fileSize"
    || name == "prim_exit"
    || name == "prim_runIn"

firstEffect : List (Maybe a) -> Maybe a
firstEffect [] = Nothing
firstEffect (Nothing :: rest) = firstEffect rest
firstEffect ((Just n) :: rest) = Just n

effExpr : Expr -> Maybe String
effExpr e = case e of
  EVar n sp => if isEffectfulBuiltin n then Just n else Nothing
  EInt n sp => Nothing
  EStr s sp => Nothing
  ELam ps body sp => effExpr body
  EApp fn args sp => firstEffect [effExpr fn, effExprs args]
  ELet binds body rec_ sp => firstEffect [effBinds binds, effExpr body]
  ECase scrut alts sp => firstEffect [effExpr scrut, effAlts alts]
  EIf c t el sp => firstEffect [effExpr c, effExpr t, effExpr el]
  EField base fname sp => effExpr base
  ERecord name fields sp => effFields fields
  ERecUpdate base fields sp => firstEffect [effExpr base, effFields fields]
  EInstSel meth iname sp => Nothing
  -- M20：`EPi` 是 DT 的核心语法，这里只做结构递归（类型层不算 effect）。
  EPi name implicit dom cod sp => firstEffect [effExpr dom, effExpr cod]
  EDo stmts sp => effDos stmts
  -- M24：where 绑定签名 `EAnn value ty`；类型层不算 effect，只看值。
  EAnn value ty sp => effExpr value

-- 列表遍历显式写成结构递归（不用 map + λ）：终止性检查只能看到对列表尾的结构下降。
effExprs : List Expr -> Maybe String
effExprs [] = Nothing
effExprs (e :: rest) = firstEffect [effExpr e, effExprs rest]

effBinds : List (Pair Pat Expr) -> Maybe String
effBinds [] = Nothing
effBinds ((Pair pat value) :: rest) = firstEffect [effExpr value, effBinds rest]

effAlts : List (Pair Pat Expr) -> Maybe String
effAlts [] = Nothing
effAlts ((Pair pat body) :: rest) = firstEffect [effExpr body, effAlts rest]

effFields : List (Pair String Expr) -> Maybe String
effFields [] = Nothing
effFields ((Pair fname value) :: rest) = firstEffect [effExpr value, effFields rest]

effDo : DoStmt -> Maybe String
effDo s = case s of
  DBind pat value sp => effExpr value
  DExpr value sp => effExpr value

effDos : List DoStmt -> Maybe String
effDos [] = Nothing
effDos (s :: rest) = firstEffect [effDo s, effDos rest]

effDecl : Decl -> Maybe String
effDecl d = case d of
  DFun n pats body sp => effExpr body
  DTrait n ps methods sp => Nothing
  DInstance iname isDefault headTy methods sp => effDecls methods
  _ => Nothing

effDecls : List Decl -> Maybe String
effDecls [] = Nothing
effDecls (d :: rest) = firstEffect [effDecl d, effDecls rest]

checkEffectsBuiltins : String -> String -> List Decl -> Result (List Decl)
checkEffectsBuiltins label pkg decls = if packageAllowsEffects pkg then Ok decls
else if pkg == "" && label /= "<entry>" then Ok decls
else case effDecls decls of
  Nothing => Ok decls
  Just name =>
    Err
      (label ++ ": effectful builtin `" ++ name ++ "` is not available in package " ++ pkg ++ " (use Base.IO)")

tyShape : Expr -> String
tyShape ty = case ty of
  EVar n _ => "var " ++ n
  EApp f a _ => "app"
  EInt n _ => "int"
  EStr s _ => "str"
  ELam ps b _ => "lam"
  ELet bs b _ _ => "let"
  ECase s alts _ => "case"
  EIf c t e _ => "if"
  EDo stmts _ => "do"
  _ => "other"
