module Vuna.Compiler.Loader.Expand (expandDecls) where

-- Vuna.Compiler.Loader.Expand：内置宏的 AST→AST 展开 pass。
--
-- 时机：parser 已产出 `name!` 的保留名标记（`@vuna@macro@name`，见 `Frontend/Ast`），
-- `Loader.Flatten` 在 fixity 重排之后、名字解析之前调用本模块。展开后 AST 里不再有
-- 标记，Elab / Codegen / 接口缓存都只看到普通表达式。
--
-- 规则：先递归展开实参，再套用宏；插入节点的 span 一律取调用点 span（实参保留自身
-- span），满足「宏携带 span」不变量。展开结果只引用 `Vuna.Compiler.Debug` 的宏后端
-- 名字（全限定），因此不存在捕获调用方局部名字的问题；调用方必须 import 该模块。
--
-- 目前只有编译器内部探针宏（注册表在 `expandMacro`）：
--   * `dbg! msg`          → 带时间戳的 `DEBUG` 行（`--debug-perf` 门控）
--   * `perfNote! msg`     → `if perfEnabled then debugLine msg else unit`
--   * `perfStamp! label`  → `if perfEnabled then perfMark label else unit`
--   * `perfSample! key l` → perfStamp 的 1/64 确定性采样版
-- `dbg!` 展开到隐藏原语（`@vuna@debug@*`，见 `Intrinsics.internalIntrinsics`），不依赖
-- 任何库模块；其余探针仍引用 `Vuna.Compiler.Debug`（阶段 A 保留，阶段 B 删除）。
-- 用户自定义宏不在本阶段范围内。
import Base.List
import Base.Nat
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Rn
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Intrinsics

-- 展开递归的 fuel：AST 合法输入必然收敛，这里只防实现 bug 造成的死循环（与
-- `Loader.Resolve.resolveFuelBound` 同一量级；耗尽即 internal error，不静默截断）。
expandFuelBound : Int
expandFuelBound = 1073741824

-- | 展开一组声明里的全部内置宏调用；无宏时逐节点重建 AST、语义与 span 不变。
expandDecls : List Decl -> Check (List Decl)
expandDecls decls = expandDeclsGo expandFuelBound decls

expandDeclsGo : Int -> List Decl -> Check (List Decl)
expandDeclsGo fuel decls = if fuel <= 0 then icFuel "macro expansion"
else case decls of
  [] => OkC []
  d :: rest =>
    Vuna.Compiler.Common.bind (expandDecl fuel d)
      (\d2 => Vuna.Compiler.Common.bind (expandDeclsGo (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons d2 rest2)))

expandDecl : Int -> Decl -> Check Decl
expandDecl fuel d = if fuel <= 0 then icFuel "macro expansion"
else case d of
  DData name params kind ctors derivings viaField repr lin sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) kind)
      (\kind2 => Vuna.Compiler.Common.bind (expandCtors (fuel - 1) ctors) (\ctors2 => OkC (DData name params kind2 ctors2 derivings viaField repr lin sp)))
  DAxiom name ty sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) ty) (\ty2 => OkC (DAxiom name ty2 sp))
  DExtern name cname ty sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) ty) (\ty2 => OkC (DExtern name cname ty2 sp))
  DSig name ctx ty sp =>
    Vuna.Compiler.Common.bind (expandExprs (fuel - 1) ctx)
      (\ctx2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) ty) (\ty2 => OkC (DSig name ctx2 ty2 sp)))
  DFun name pats body sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) body) (\body2 => OkC (DFun name pats body2 sp))
  DRecord name params fields derivings viaField repr lin sp =>
    Vuna.Compiler.Common.bind (expandFields (fuel - 1) fields)
      (\fields2 => OkC (DRecord name params fields2 derivings viaField repr lin sp))
  DTrait name params methods sp =>
    Vuna.Compiler.Common.bind (expandTraitMethods (fuel - 1) methods)
      (\methods2 => OkC (DTrait name params methods2 sp))
  DInstance ctxE head methods sp =>
    Vuna.Compiler.Common.bind (expandExprs (fuel - 1) ctxE)
      (\ctx2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) head) (\head2 => Vuna.Compiler.Common.bind (expandDeclsGo (fuel - 1) methods) (\methods2 => OkC (DInstance ctx2 head2 methods2 sp))))

expandCtors : Int -> List Ctor -> Check (List Ctor)
expandCtors fuel ctors = if fuel <= 0 then icFuel "macro expansion"
else case ctors of
  [] => OkC []
  c :: rest =>
    Vuna.Compiler.Common.bind (expandCtor (fuel - 1) c)
      (\c2 => Vuna.Compiler.Common.bind (expandCtors (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons c2 rest2)))

expandCtor : Int -> Ctor -> Check Ctor
expandCtor fuel (Ctor name ty arity sp) =
  Vuna.Compiler.Common.bind (expandExpr (fuel - 1) ty) (\ty2 => OkC (Ctor name ty2 arity sp))

expandFields : Int -> List Field -> Check (List Field)
expandFields fuel fields = if fuel <= 0 then icFuel "macro expansion"
else case fields of
  [] => OkC []
  f :: rest =>
    Vuna.Compiler.Common.bind (expandField (fuel - 1) f)
      (\f2 => Vuna.Compiler.Common.bind (expandFields (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons f2 rest2)))

expandField : Int -> Field -> Check Field
expandField fuel (Field name ty sp) =
  Vuna.Compiler.Common.bind (expandExpr (fuel - 1) ty) (\ty2 => OkC (Field name ty2 sp))

expandTraitMethods : Int -> List TraitMethod -> Check (List TraitMethod)
expandTraitMethods fuel methods = if fuel <= 0 then icFuel "macro expansion"
else case methods of
  [] => OkC []
  m :: rest =>
    Vuna.Compiler.Common.bind (expandTraitMethod (fuel - 1) m)
      (\m2 => Vuna.Compiler.Common.bind (expandTraitMethods (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons m2 rest2)))

expandTraitMethod : Int -> TraitMethod -> Check TraitMethod
expandTraitMethod fuel (TraitMethod name ty sp) =
  Vuna.Compiler.Common.bind (expandExpr (fuel - 1) ty) (\ty2 => OkC (TraitMethod name ty2 sp))

expandExprs : Int -> List Expr -> Check (List Expr)
expandExprs fuel exprs = if fuel <= 0 then icFuel "macro expansion"
else case exprs of
  [] => OkC []
  e :: rest =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) e)
      (\e2 => Vuna.Compiler.Common.bind (expandExprs (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons e2 rest2)))

expandExpr : Int -> Expr -> Check Expr
expandExpr fuel e = if fuel <= 0 then icFuel "macro expansion"
else case e of
  EVar name sp => case macroNameOf name of
    Just macroName => expandMacro macroName [] sp
    Nothing => OkC e
  EApp fn args sp => case fn of
    EVar name _ => case macroNameOf name of
      Just macroName =>
        Vuna.Compiler.Common.bind (expandExprs (fuel - 1) args)
          (\args2 => expandMacro macroName args2 sp)
      Nothing =>
        Vuna.Compiler.Common.bind (expandExpr (fuel - 1) fn)
          (\fn2 => Vuna.Compiler.Common.bind (expandExprs (fuel - 1) args) (\args2 => OkC (EApp fn2 args2 sp)))
    _ =>
      Vuna.Compiler.Common.bind (expandExpr (fuel - 1) fn)
        (\fn2 => Vuna.Compiler.Common.bind (expandExprs (fuel - 1) args) (\args2 => OkC (EApp fn2 args2 sp)))
  EInt n sp => OkC e
  EStr s sp => OkC e
  EFloat raw sp => OkC e
  ELam ps body sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) body) (\body2 => OkC (ELam ps body2 sp))
  EPi name implicit qty dom cod sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) dom)
      (\dom2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) cod) (\cod2 => OkC (EPi name implicit qty dom2 cod2 sp)))
  ELet binds body rec_ sp =>
    Vuna.Compiler.Common.bind (expandPatExprs (fuel - 1) binds)
      (\binds2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) body) (\body2 => OkC (ELet binds2 body2 rec_ sp)))
  ELocalFun clauses sp =>
    Vuna.Compiler.Common.bind (expandClauses (fuel - 1) clauses)
      (\clauses2 => OkC (ELocalFun clauses2 sp))
  ECase scrut alts sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) scrut)
      (\scrut2 => Vuna.Compiler.Common.bind (expandPatExprs (fuel - 1) alts) (\alts2 => OkC (ECase scrut2 alts2 sp)))
  EIf c t el sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) c)
      (\c2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) t) (\t2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) el) (\el2 => OkC (EIf c2 t2 el2 sp))))
  EField base fname sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) base) (\base2 => OkC (EField base2 fname sp))
  ERecord name fields sp =>
    Vuna.Compiler.Common.bind (expandFieldExprs (fuel - 1) fields)
      (\fields2 => OkC (ERecord name fields2 sp))
  ERecUpdate base fields sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) base)
      (\base2 => Vuna.Compiler.Common.bind (expandFieldExprs (fuel - 1) fields) (\fields2 => OkC (ERecUpdate base2 fields2 sp)))
  EDo stmts sp =>
    Vuna.Compiler.Common.bind (expandDoStmts (fuel - 1) stmts) (\stmts2 => OkC (EDo stmts2 sp))
  EInfix op lhs rhs sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) lhs)
      (\lhs2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) rhs) (\rhs2 => OkC (EInfix op lhs2 rhs2 sp)))
  EParen inner sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) inner) (\inner2 => OkC (EParen inner2 sp))
  EBacktick op lhs rhs sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) lhs)
      (\lhs2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) rhs) (\rhs2 => OkC (EBacktick op lhs2 rhs2 sp)))
  ESectOp op sp => OkC e
  ESectL op inner sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) inner) (\inner2 => OkC (ESectL op inner2 sp))
  ESectR inner op sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) inner) (\inner2 => OkC (ESectR inner2 op sp))
  EAnn value ty sp =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) value)
      (\value2 => Vuna.Compiler.Common.bind (expandExpr (fuel - 1) ty) (\ty2 => OkC (EAnn value2 ty2 sp)))
  EInterp multi parts sp =>
    Vuna.Compiler.Common.bind (expandInterpParts (fuel - 1) parts)
      (\parts2 => OkC (EInterp multi parts2 sp))

expandPatExprs : Int -> List (Pair Pat Expr) -> Check (List (Pair Pat Expr))
expandPatExprs fuel pairs = if fuel <= 0 then icFuel "macro expansion"
else case pairs of
  [] => OkC []
  (Pair pat value) :: rest =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) value)
      (\value2 => Vuna.Compiler.Common.bind (expandPatExprs (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons (Pair pat value2) rest2)))

expandClauses : Int -> List (Pair (List Pat) Expr) -> Check (List (Pair (List Pat) Expr))
expandClauses fuel clauses = if fuel <= 0 then icFuel "macro expansion"
else case clauses of
  [] => OkC []
  (Pair pats body) :: rest =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) body)
      (\body2 => Vuna.Compiler.Common.bind (expandClauses (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons (Pair pats body2) rest2)))

expandFieldExprs : Int -> List (Pair String Expr) -> Check (List (Pair String Expr))
expandFieldExprs fuel fields = if fuel <= 0 then icFuel "macro expansion"
else case fields of
  [] => OkC []
  (Pair fname value) :: rest =>
    Vuna.Compiler.Common.bind (expandExpr (fuel - 1) value)
      (\value2 => Vuna.Compiler.Common.bind (expandFieldExprs (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons (Pair fname value2) rest2)))

expandDoStmts : Int -> List DoStmt -> Check (List DoStmt)
expandDoStmts fuel stmts = if fuel <= 0 then icFuel "macro expansion"
else case stmts of
  [] => OkC []
  stmt :: rest => case stmt of
    DBind pat stmtExpr sp =>
      Vuna.Compiler.Common.bind (expandExpr (fuel - 1) stmtExpr)
        (\stmtExpr2 => Vuna.Compiler.Common.bind (expandDoStmts (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons (DBind pat stmtExpr2 sp) rest2)))
    DExpr stmtExpr sp =>
      Vuna.Compiler.Common.bind (expandExpr (fuel - 1) stmtExpr)
        (\stmtExpr2 => Vuna.Compiler.Common.bind (expandDoStmts (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons (DExpr stmtExpr2 sp) rest2)))

expandInterpParts : Int -> List InterpPart -> Check (List InterpPart)
expandInterpParts fuel parts = if fuel <= 0 then icFuel "macro expansion"
else case parts of
  [] => OkC []
  part :: rest => case part of
    IPText text =>
      Vuna.Compiler.Common.bind (expandInterpParts (fuel - 1) rest)
        (\rest2 => OkC (Base.List.Cons (IPText text) rest2))
    IPHole holeExpr =>
      Vuna.Compiler.Common.bind (expandExpr (fuel - 1) holeExpr)
        (\holeExpr2 => Vuna.Compiler.Common.bind (expandInterpParts (fuel - 1) rest) (\rest2 => OkC (Base.List.Cons (IPHole holeExpr2) rest2)))

-- ---------------------------------------------------------------
-- 内置宏注册表与展开
-- ---------------------------------------------------------------
-- 宏后端名（`D` = `Vuna.Compiler.Debug`）：展开结果全限定引用，避免捕获调用方名字。
-- 调用方必须 `import Vuna.Compiler.Debug`，否则名字解析报 `RN_ModuleNotImported`。
debugRef : String -> Span -> Expr
debugRef name sp = EVar "Vuna.Compiler.Debug.${name}" sp

macroCall : String -> List Expr -> Span -> Expr
macroCall name args sp = EApp (debugRef name sp) args sp

-- 统一的开关守卫：关闭时实参不被求值，也不构造字符串。
guardedMacro : Span -> Expr -> Expr
guardedMacro sp body = EIf (debugRef "perfEnabled" sp) body (debugRef "unit" sp) sp

-- 隐藏原语引用（`@vuna@…`）：Resolve 作为内部名直通，签名由 `Elab.Prelude` 提供。
internalRef : String -> Span -> Expr
internalRef name sp = EVar name sp

-- `dbg!` 的开关查询：哑 `Int` 实参 0（宏展开里唯一的实参形态，源码写不出来）。
debugOnRef : Span -> Expr
debugOnRef sp = EApp (internalRef debugOnIntrinsicName sp) [EInt 0 sp] sp

macroArityMismatch : String -> Int -> List Expr -> Span -> Check Expr
macroArityMismatch name expected args sp =
  let
    expectedText = strFromInt expected
    actualText = strFromInt (natToInt (length args))
  in rnAt3 sp (MacroArity name expectedText actualText) name expectedText actualText

-- | 展开一个 `name!` 调用：未知宏 / arity 不符报 `RN_UnknownMacro` / `RN_MacroArity`。
expandMacro : String -> List Expr -> Span -> Check Expr
expandMacro name args sp = if name == "dbg" then case args of
  [msg] =>
    OkC (EIf (debugOnRef sp) (EApp (internalRef debugLineIntrinsicName sp) [msg] sp) (EInt 0 sp) sp)
  _ => macroArityMismatch name 1 args sp
else if name == "perfNote" then case args of
  [msg] => OkC (guardedMacro sp (macroCall "debugLine" [msg] sp))
  _ => macroArityMismatch name 1 args sp
else if name == "perfStamp" then case args of
  [label] => OkC (guardedMacro sp (macroCall "perfMark" [label] sp))
  _ => macroArityMismatch name 1 args sp
else if name == "perfSample" then case args of
  [key, label] =>
    OkC
      (guardedMacro sp (EIf (macroCall "sampled" [key] sp) (macroCall "perfMark" [label] sp) (debugRef "unit" sp) sp))
  _ => macroArityMismatch name 2 args sp
else rnAt1 sp (UnknownMacro name) name
