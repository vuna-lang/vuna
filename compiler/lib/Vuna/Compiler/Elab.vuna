module Vuna.Compiler.Elab where

-- Vuna.Compiler.Elab：DT 精化器门面（双向检查 + 一阶元变量 + 类型级隐式插入 + M14 索引族）。
-- 输入是 parser 的原始声明（不经 Loader）：名字解析在精化器里完成。
-- 状态 Ec 保存下一个元变量编号、已解元变量（含创建深度，zonk 用）与已精化的定义体
-- （供 Core.force 的 delta 展开）；定义体按源顺序精化，delta 只对已精化定义可见。
--
-- 实现按依赖层次拆到 `Elab/` 下的子模块（Types → Meta/Case/Dict → Term → Data/Trait → Driver），
-- 这里只做**选择性重导出**（`子模块.名字`）：对外导出的名字集合与拆分前逐项一致，
-- 抽象性也沿用拆分前语义（v0：与类型同名的 data 构造子随类型名一起导出；record 才抽象）。
export import Vuna.Compiler.Elab.Types as Types (DtClass, DtCtor, DtData, DtDef, DtFieldMeta(..), DtGoal, DtProgram, dtClassName, dtCtorFamily, dtCtorName, dtCtorTelescope, dtCtorType, dtDataCtors, dtDataFields, dtDataIsRecord, dtDataName, dtDefBody, dtDefExtern, dtDefHasBody, dtDefName, dtDefSpan, dtDefType, dtProgDatas, dtProgDefs, dtProgGoals, dtProgSols)
export import Vuna.Compiler.Elab.Meta as Meta (dictCtorName, dictTypeName, isFamilyKindValue, valueOpaqueScoped)
export import Vuna.Compiler.Elab.Data as Data (eraseIndexMask, indexErasureCandidates)
export import Vuna.Compiler.Elab.Trait as Trait (checkInstanceHeads, elabInstanceBodies)
export import Vuna.Compiler.Elab.InstName as InstName (derivedInstName, instanceName)
export import Vuna.Compiler.Elab.Driver as Driver (DtGoalInfo, addClassesEc, addDatasEc, addInstsEc, dtEvalExprIn, dtEvalExprInInfo, ecOfProgram, elabProgram, elabProgramFull, elabProgramFullWith, elabProgramFullWithAux, elabProgramGoWith, elabProgramGoWithAux, goalsOfProgram, goalsOfProgramTolerant, maybeAddHasFieldInstances)
export import Vuna.Compiler.Elab.Derive as Derive (instHead)
export import Vuna.Compiler.Elab.Usage as Usage (checkProgramUsage, isTypeForming)
