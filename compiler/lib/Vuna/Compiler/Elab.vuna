module Vuna.Compiler.Elab (DtDef, dtDefName, dtDefType, dtDefBody, DtCtor, dtCtorName, dtCtorFamily, dtCtorTelescope, dtCtorType, DtData, dtDataName, dtDataParams, dtDataCtors, DtClass, dtClassName, dtClassParams, dtClassMethods, dtClassFieldTys, DtGoal, dtGoalMeta, dtGoalSpan, dtGoalType, dtGoalCtx, DtProgram, dtProgDatas, dtProgDefs, dtProgGoals, dtProgSols, DtGoalInfo, dtGoalInfoSpan, dtGoalInfoGoal, dtGoalInfoCtx, elabProgram, elabProgramFull, goalsOfProgram, checkInstanceHeads, elabInstanceBodies, dictTypeName, dictCtorName, eraseIndexMask, indexErasureCandidates) where

-- Vuna.Compiler.Elab：DT 精化器（双向检查 + 一阶元变量 + 类型级隐式插入 + M14 索引族）。
-- 输入是 parser 的原始声明（不经 Loader）：名字解析在精化器里完成。
-- 状态 Ec 保存下一个元变量编号、已解元变量（含创建深度，zonk 用）与已精化的定义体
-- （供 Core.force 的 delta 展开）；定义体按源顺序精化，delta 只对已精化定义可见。
import Vuna.Compiler.Common
import Vuna.Compiler.Ast
import Vuna.Compiler.DtMatch
import Vuna.Compiler.Core
import Vuna.Compiler.DtPrelude
import Vuna.Compiler.DtKind
import Vuna.Compiler.DtQuant
import Vuna.Compiler.DtDerive
import Vuna.Compiler.DtRecords

-- 一个 DT 定义：名字、类型项、体项（均为闭项；体带擦除标志）。
data DtDef : Type where
  DtDef : String -> Term -> Term -> DtDef

dtDefName (DtDef name ty body) = name

dtDefType (DtDef name ty body) = ty

dtDefBody (DtDef name ty body) = body

-- M14：一个构造子。telescope 是「族参数 + 字段」的完整 binder 表（名字 / 擦除标志），
-- 类型项是闭合的（`{a : Type} -> {n : Nat} -> a -> Vec a n -> Vec a (Succ n)` 形态）。
data DtCtor : Type where
  DtCtor : String -> String -> List (Pair String Rig) -> Term -> DtCtor

dtCtorName (DtCtor name family tele ty) = name

dtCtorFamily (DtCtor name family tele ty) = family

dtCtorTelescope (DtCtor name family tele ty) = tele

dtCtorType (DtCtor name family tele ty) = ty

-- M14：一个归纳族（索引族）。params 来自 kind 的 Pi binder（域是宇宙的擦除）。
data DtData : Type where
  DtData : String -> List (Pair String Rig) -> List DtCtor -> DtData

dtDataName (DtData name params ctors) = name

dtDataParams (DtData name params ctors) = params

dtDataCtors (DtData name params ctors) = ctors

-- M15：一个洞的目标。编号、位置、目标类型（level 形态）、绑定时上下文快照。
data DtGoal : Type where
  DtGoal : Int -> Span -> Value -> List (Pair String Term) -> DtGoal

dtGoalMeta (DtGoal m sp ty ctx) = m

dtGoalSpan (DtGoal m sp ty ctx) = sp

dtGoalType (DtGoal m sp ty ctx) = ty

dtGoalCtx (DtGoal m sp ty ctx) = ctx

-- M15：接口（trait）声明。参数名表、方法（名字 + 完整投影类型项）。
data DtClass : Type where
  DtClass : String -> List String -> List (Pair String Term) -> List Term -> DtClass

dtClassName (DtClass name params projs fieldTys) = name

dtClassParams (DtClass name params projs fieldTys) = params

dtClassMethods (DtClass name params projs fieldTys) = projs

dtClassFieldTys (DtClass name params projs fieldTys) = fieldTys

-- M15：已注册实例：定义名 + 实例头类型项（`Show Int` 这类闭合项）。
data DtInst : Type where
  DtInst : String -> Term -> DtInst

dtInstName (DtInst name head) = name

dtInstHead (DtInst name head) = head

-- 精化状态：下一个元变量编号、已解元变量（level 形态的 Value）、已精化的定义体、
-- 已声明的归纳族（M14：case 精化需要知道族的构造子 telescope）。
-- M22：`dgoals` 是延迟的字典约束——类参数未解时延迟成裸元变量，解后由 `resolveDictGoals` 回填。
data DtDictGoal : Type where
  DtDictGoal : Int -> Value -> DtDictGoal

data Ec : Type where
  Ec : Int -> List (Pair Int Value) -> List (Pair String Term) -> List DtData -> List (Pair Int Int) -> List DtGoal -> List DtInst -> List DtClass -> List DtDictGoal -> Ec

ecNext (Ec next sols defs datas depths goals insts classes dgoals) = next

ecSols (Ec next sols defs datas depths goals insts classes dgoals) = sols

ecDefs (Ec next sols defs datas depths goals insts classes dgoals) = defs

ecDatas (Ec next sols defs datas depths goals insts classes dgoals) = datas

ecDepthOfMeta (Ec next sols defs datas depths goals insts classes dgoals) = depths

ecGoals (Ec next sols defs datas depths goals insts classes dgoals) = goals

ecInsts (Ec next sols defs datas depths goals insts classes dgoals) = insts

ecClasses (Ec next sols defs datas depths goals insts classes dgoals) = classes

ecAddGoal : Ec -> DtGoal -> Ec
ecAddGoal (Ec next sols defs datas depths goals insts classes dgoals) g =
  Ec next sols defs datas depths (append goals [g]) insts classes dgoals

ecAddInst : Ec -> DtInst -> Ec
ecAddInst ec i = if hasInstName (dtInstName i) (ecInsts ec) then ec else ecAddInstRaw ec i

hasInstName name [] = False
hasInstName name (i :: rest) = if dtInstName i == name then True else hasInstName name rest

ecAddInstRaw : Ec -> DtInst -> Ec
ecAddInstRaw (Ec next sols defs datas depths goals insts classes dgoals) i =
  Ec next sols defs datas depths goals (append insts [i]) classes dgoals

ecAddClass : Ec -> DtClass -> Ec
ecAddClass (Ec next sols defs datas depths goals insts classes dgoals) c =
  Ec next sols defs datas depths goals insts (append classes [c]) dgoals

-- M22：延迟的字典约束访问器。
ecDictGoals (Ec next sols defs datas depths goals insts classes dgoals) = dgoals

ecPutDictGoals : Ec -> List DtDictGoal -> Ec
ecPutDictGoals (Ec next sols defs datas depths goals insts classes dgoals) dgoals2 =
  Ec next sols defs datas depths goals insts classes dgoals2

ecAddDictGoal : Ec -> DtDictGoal -> Ec
ecAddDictGoal (Ec next sols defs datas depths goals insts classes dgoals) g =
  Ec next sols defs datas depths goals insts classes (append dgoals [g])

ecEmpty : Ec
ecEmpty = Ec 0 [] [] [] [] [] [] [] []

ecPutSols : Ec -> List (Pair Int Value) -> Ec
ecPutSols (Ec next sols defs datas depths goals insts classes dgoals) sols2 =
  Ec next sols2 defs datas depths goals insts classes dgoals

ecAddDef : Ec -> Pair String Term -> Ec
ecAddDef (Ec next sols defs datas depths goals insts classes dgoals) d =
  Ec next sols (append defs [d]) datas depths goals insts classes dgoals

ecAddData : Ec -> DtData -> Ec
ecAddData (Ec next sols defs datas depths goals insts classes dgoals) d =
  Ec next sols defs (append datas [d]) depths goals insts classes dgoals

-- 局部上下文：最近绑定的在前（名字 + 类型项；类型项在当前上下文里有效）。
-- refinements 是 M14 的索引精化：level ↦ Value（level 形态，可提到更新的 binder，无需 de Bruijn
-- 搬运）。求值环境构造时代入，于是所有类型的求值/相等检查自动享受精化。
data Ctx : Type where
  Ctx : List (Pair String Term) -> List (Pair Int Value) -> Ctx

ctxItems (Ctx items refs) = items

ctxDepth : Ctx -> Int
ctxDepth ctx = length (ctxItems ctx)

ctxBind : String -> Term -> Ctx -> Ctx
ctxBind name ty (Ctx items refs) = Ctx (Pair name ty :: items) refs

-- 把一个 Value 形态的类型重新 quote 成项再入上下文（Pi 值里的域只有 Value）。
ctxBindValue : String -> Value -> Ctx -> Ctx
ctxBindValue name dom ctx = ctxBind name (quote (ctxDepth ctx) dom) ctx

-- 记录一批精化（不做链式化简，代入在 ctxEnv 里做）。
ctxRefine : Ctx -> List (Pair Int Value) -> Ctx
ctxRefine (Ctx items refs) more = Ctx items (append refs more)

ctxLookupAt : String -> List (Pair String Term) -> Int -> Maybe (Pair Int Term)
ctxLookupAt name [] idx = Nothing
ctxLookupAt name ((Pair n ty) :: rest) idx =
  if n == name then Just (Pair idx ty) else ctxLookupAt name rest (idx + 1)

ctxLookup : String -> Ctx -> Maybe (Pair Int Term)
ctxLookup name ctx = ctxLookupAt name (ctxItems ctx) 0

-- 上下文的求值环境：binder 的 level 从底部开始，与 quote 约定一致。
ctxEnvAt : List (Pair String Term) -> Int -> Int -> List Value
ctxEnvAt [] idx depth = []
ctxEnvAt ((Pair name ty) :: rest) idx depth =
  VNeutral (NVar name (depth - idx - 1) []) :: ctxEnvAt rest (idx + 1) depth

ctxEnv : Ctx -> List Value
ctxEnv (Ctx items refs) = ctxEnvAt items 0 (length items)

-- M14：把精化代入一个值。精化是「level ↦ Value」，而求值环境里的 binder 都是中性变量，
-- 求值后做一次重写即可（索引位置上出现的基本是中性变量或构造子值）。resolveLevel 处理链式精化。
refineValue : List (Pair Int Value) -> Int -> Value -> Value
refineValue refs fuel v = if fuel <= 0 then v
else case v of
  VNeutral n => case n of
    NVar name lvl sp =>
      let
        sp2 = map (refineValue refs (fuel - 1)) sp
      in case refineLookup lvl refs of
        Just r => applySpine (refineValue refs (fuel - 1) r) sp2
        Nothing => VNeutral (NVar name lvl sp2)
    NGlobal g sp => VNeutral (NGlobal g (map (refineValue refs (fuel - 1)) sp))
  VCon c args => VCon c (map (refineValue refs (fuel - 1)) args)
  VCase scrut alts => VCase (refineValue refs (fuel - 1) scrut) alts
  VIf c th el =>
    VIf (refineValue refs (fuel - 1) c) (refineValue refs (fuel - 1) th)
      (refineValue refs (fuel - 1) el)
  VMeta m sp => VMeta m (map (refineValue refs (fuel - 1)) sp)
  _ => v

refineLookup : Int -> List (Pair Int Value) -> Maybe Value
refineLookup lvl [] = Nothing
refineLookup lvl ((Pair l v) :: rest) = if l == lvl then Just v else refineLookup lvl rest

-- M21：在取用点把精化代入求值环境再 eval（闭包捕获环境，域/余域递归精化）。见 history.md。
evalCtx : Ctx -> Term -> Value
evalCtx (Ctx items refs) ty =
  eval (map (refineValue refs defaultFuel) (ctxEnvAt items 0 (length items))) ty

-- 局部变量 i 的类型：存储时按「绑定时上下文」，取用时需要 weaken (i+1)。
varTypeValue : Ctx -> Int -> Term -> Value
varTypeValue (Ctx items refs) idx ty =
  eval (map (refineValue refs defaultFuel) (ctxEnvAt items 0 (length items))) (shift 0 (idx + 1) ty)

emptyCtx : Ctx
emptyCtx = Ctx [] []

-- ---------------------------------------------------------------
-- 错误 / 状态 helper
-- ---------------------------------------------------------------
errAt : Span -> String -> Result a
errAt sp msg = Err (showSpanLoc sp ++ ": " ++ msg)

-- M15：新建元变量并记录创建深度（求解时的作用域检查用）。
newMeta : Ctx -> Ec -> Pair Term Ec
newMeta ctx (Ec next sols defs datas depths goals insts classes dgoals) =
  Pair (TMeta next)
    (Ec (next + 1) sols defs datas (Pair next (ctxDepth ctx) :: depths) goals insts classes dgoals)

-- M15：新建一个「洞」元变量：除创建深度外还记下目标类型与上下文快照（供 goal 显示）。
newHoleMeta : Ctx -> Ec -> Span -> Value -> Pair Term Ec
newHoleMeta ctx (Ec next sols defs datas depths goals insts classes dgoals) sp ty =
  let
    goal = DtGoal next sp ty (ctxItems ctx)
  in Pair (TMeta next)
    (Ec (next + 1) sols defs datas (Pair next (ctxDepth ctx) :: depths) (append goals [goal]) insts classes dgoals)

forceVal : Ec -> Value -> Value
forceVal ec v = force (ecDefs ec) (ecSols ec) defaultFuel v

-- 引用零参（无显式参数）构造子时，其隐式类型/族参数必须实例化成元变量；
-- 否则 `inferE (EVar "Nil")` 会给出 `{a}->List a`（函数类型），而 `Nil` 是值。
-- 仅在「整个类型链没有显式 Pi」（纯零参构造子）时实例化；`Cons`/`Just` 等有显式
-- 参数的构造子保持多态类型（应用时由 `inferArgsGo` 实例化）。
hasNoExplicitPi : Ec -> Value -> Bool
hasNoExplicitPi ec v = case forceVal ec v of
  VPi _ True _ dom clo => hasNoExplicitPi ec (applyClosure clo (forceVal ec dom))
  VPi _ False _ dom clo => False
  _ => True

instantiateNullaryCtor : Ec -> Ctx -> Value -> Result (Pair Value Ec)
instantiateNullaryCtor ec ctx v = case forceVal ec v of
  VPi _ True _ dom clo => if isIndexDomain ec dom then case newMeta ctx ec of
    Pair metaTerm ec1 =>
      instantiateNullaryCtor ec1 ctx (applyClosure clo (eval (ctxEnv ctx) metaTerm))
  else Ok (Pair v ec)
  _ => Ok (Pair v ec)

-- M21：Bool 的统一运行时表示。`Base.Bool` / 单文件 `data Bool` 的构造子
-- `True` / `False` 一律精化成核心的 `TBool`，codegen 出 OCaml 的 `true` / `false`；
-- 族本身不生成变体声明（`Bool` 的运行时表示就是 OCaml bool）。
-- 这样 `if`、内建算子返回的 `Bool`、与 `data Bool` 的构造子就是同一个表示。
boolCtorValue : String -> Maybe Bool
boolCtorValue name = case splitLastDot (splitOnDot name) of
  Pair rev base =>
    if base == "True" then Just True else if base == "False" then Just False else Nothing

boolCtorTerm : String -> Term
boolCtorTerm name = case boolCtorValue name of
  Just True => TBool True
  Just False => TBool False
  Nothing => TGlobal name

-- `inferE (EVar ctor)`：零参构造子（`Nil`/`Nothing` 等）的隐式类型参数实例化成元变量，
-- 使其类型为 `List ?m`/`Maybe ?m`（值），而非 `{a}->List a`（函数）。
inferCtorRef : Ec -> Ctx -> String -> Term -> Result (Pair Term (Pair Value Ec))
inferCtorRef ec ctx name tyTerm = case dtCtorLookup name (ecDatas ec) of
  Just ctor => if isBoolBaseName (dtCtorFamily ctor) then Ok (Pair (boolCtorTerm name) (Pair (VNeutral (NGlobal (dtCtorFamily ctor) [])) ec))
  else
    let
      ctorTy = eval [] tyTerm
    in if hasNoExplicitPi ec ctorTy then case instantiateNullaryCtor ec ctx ctorTy of
      Ok (Pair instTy ec1) => Ok (Pair (ctorRefTerm (ecDatas ec) name) (Pair instTy ec1))
      Err e => Err e
    else Ok (Pair (ctorRefTerm (ecDatas ec) name) (Pair ctorTy ec))
  Nothing => Ok (Pair (ctorRefTerm (ecDatas ec) name) (Pair (eval [] tyTerm) ec))

-- `Bool` 的双重身份：prelude 桩 `Bool`（类型注解、内建算子返回类型、内建的 `if`）
-- 与 `Base.Bool` 重新声明的 `Base.Bool.Bool`（`True`/`False` 构造子、`Base.*` 签名）。
-- DT 里二者必须按定义相等处理，否则 `main : Bool` 与 `mem` 的 `Base.Bool.Bool` 对不上。
-- HM 侧仍按内建 `Bool`（Loader 保留内建捷径），不受影响。
boolTypedVal : Ec -> Value -> Bool
boolTypedVal ec v = case forceVal ec v of
  VNeutral (NVar name _ _) => isBoolBaseName name
  VNeutral (NGlobal name _) => isBoolBaseName name
  _ => False

isBoolBaseName : String -> Bool
isBoolBaseName name = case splitLastDot (splitOnDot name) of
  Pair rev base => base == "Bool"

convEc : Ec -> Int -> Value -> Value -> Result Ec
convEc ec depth expected actual = if boolTypedVal ec expected && boolTypedVal ec actual then Ok ec
else case conv (ecDefs ec) (ecSols ec) depth expected actual of
  Err e => Err e
  Ok sols2 => case checkSolsScoped ec sols2 of
    Err e => Err e
    Ok _ => Ok (ecPutSols ec sols2)

-- M15 元变量上下文：新解不得引用「创建该元变量之后才绑定」的局部变量（作用域逃逸）。
-- conv 本身不知道元变量的创建深度，所以解表回来后在这里统一复核新增的解。
checkSolsScoped : Ec -> List (Pair Int Value) -> Result Int
checkSolsScoped ec sols = checkScopedFrom ec (ecDepthOfMeta ec) sols

checkScopedFrom : Ec -> List (Pair Int Int) -> List (Pair Int Value) -> Result Int
checkScopedFrom ec [] sols = Ok 0
checkScopedFrom ec ((Pair m created) :: rest) sols = case metaLookup m sols of
  Nothing => checkScopedFrom ec rest sols
  Just v =>
    if levelEscapes created 0 v then Err ("DT: cannot solve metavariable ?" ++ strFromInt m ++ " (solution would escape its scope)")
    else checkScopedFrom ec rest sols

-- 未解元变量：返回第一个未解的编号。
unsolvedFrom : Int -> Int -> List (Pair Int Value) -> Maybe Int
unsolvedFrom i stop sols = if i >= stop then Nothing
else case metaLookup i sols of
  Just _ => unsolvedFrom (i + 1) stop sols
  Nothing => Just i

unsolvedMeta : Ec -> Maybe Int
unsolvedMeta (Ec next sols defs datas depths goals insts classes dgoals) = unsolvedFrom 0 next sols

maxInt : Int -> Int -> Int
maxInt a b = if a >= b then a else b

globalLookup : String -> List (Pair String Term) -> Maybe Term
globalLookup name [] = Nothing
globalLookup name ((Pair n ty) :: rest) = if name == n then Just ty else globalLookup name rest

-- ---------------------------------------------------------------
memSig [] name = False
memSig ((Pair n ty) :: rest) name = if n == name then True else memSig rest name

memDefName : String -> List (Pair String Term) -> Bool
memDefName name [] = False
memDefName name ((Pair n ty) :: rest) = if n == name then True else memDefName name rest

collectSigs : List Decl -> Result (List (Pair String Expr))
collectSigs decls = collectSigsInto (definedNames decls) [] decls

-- 声明收集（M20：签名里的自由小写名量化为隐式类型参数，见 `DtQuant.quantifyTopSig`）。
-- `allDefs` 是**整个程序**的定义名（不能只看后面：`plus` 可能定义在引用它的签名之前）。
collectSigsInto : List String -> List (Pair String Expr) -> List Decl -> Result (List (Pair String Expr))
collectSigsInto allDefs acc [] = Ok (reverse acc)
collectSigsInto allDefs acc (d :: rest) = case d of
  DSig name ty sp =>
    if memName name preludeNames then errAt sp ("DT: cannot redefine builtin " ++ name)
    else if memSig acc name then errAt sp ("DT: duplicate signature for " ++ name)
    else collectSigsInto allDefs (Pair name (quantifyTopSig allDefs ty sp) :: acc) rest
  DFun name pats body sp => collectSigsInto allDefs acc rest
  DData name params kind ctors derivings sp => collectSigsInto allDefs acc rest
  DRecord name params fields derivings sp => errAt sp "DT: internal: record was not desugared"
  DTrait name params methods sp => collectSigsInto allDefs acc rest
  DInstance mname isDefault head methods sp => collectSigsInto allDefs acc rest

--
-- 已精化的族按源顺序积累在 Ec 的 datas 里（case 精化需要族的 ctor telescope）。
-- 收集 data 声明（按源顺序）。
collectDataDecls : List Decl -> List (Pair Decl Span) -> List (Pair Decl Span)
collectDataDecls [] acc = reverse acc
collectDataDecls (d :: rest) acc = case d of
  DData dname params kind ctors derivings sp => collectDataDecls rest (Pair d sp :: acc)
  _ => collectDataDecls rest acc

-- M22.2：程序里声明的数据族名（Loader 已限定），用于把 prelude 的族短名（`List`）
-- 绑到实际族上。
dataNamesOf : List Decl -> List String
dataNamesOf [] = []
dataNamesOf (d :: rest) = case d of
  DData dname params kind ctors derivings sp => dname :: dataNamesOf rest
  _ => dataNamesOf rest

nonEmpty : List a -> Bool
nonEmpty [] = False
nonEmpty (_ :: _) = True

-- 族的 kind 必须是「箭头链 + 宇宙结尾」。
kindWellFormed : Term -> Bool
kindWellFormed ty = case ty of
  TPi name implicit rig dom cod => kindWellFormed cod
  TType l => True
  _ => False

-- 族的参数/索引 telescope：binder 名 + 是否擦除（域是宇宙）。
splitKind : Term -> List (Pair String Rig)
splitKind ty = case ty of
  TPi name implicit _ dom cod => Pair name (binderRig implicit (eval [] dom)) :: splitKind cod
  _ => []

dtDataLookup : String -> List DtData -> Maybe DtData
dtDataLookup name [] = Nothing
dtDataLookup name (d :: rest) = if dtDataName d == name then Just d else dtDataLookup name rest

findCtorIn : String -> List DtCtor -> Maybe DtCtor
findCtorIn name [] = Nothing
findCtorIn name (c :: rest) = if dtCtorName c == name then Just c else findCtorIn name rest

dtCtorLookup : String -> List DtData -> Maybe DtCtor
dtCtorLookup name [] = Nothing
dtCtorLookup name (d :: rest) = case findCtorIn name (dtDataCtors d) of
  Just c => Just c
  Nothing => dtCtorLookup name rest

-- 构造子类型的 telescope：逐个 binder 求值域。
-- 隐式 binder（族参数/索引）一律擦除；显式 binder 只有在域是宇宙时才擦除。
teleOfType : Term -> List (Pair String Rig)
teleOfType ty = teleOf ty []

teleOf : Term -> List Value -> List (Pair String Rig)
teleOf ty env = case ty of
  TPi name implicit rig dom cod =>
    let
      domVal = eval env dom
      v = VNeutral (NVar name (length env) [])
      rig = binderRig implicit domVal
    in Pair name rig :: teleOf cod (v :: env)
  _ => []

-- 结果类型 `F r1..rk` 的「头 + 实参」。
spineOfType : Term -> Pair String (List Term)
spineOfType t = case t of
  TApp f a erased => case spineOfType f of
    Pair h args => Pair h (append args [a])
  TGlobal g => Pair g []
  _ => Pair "" []

resultSpine : Term -> Pair String (List Term)
resultSpine ty = case ty of
  TPi name implicit rig dom cod => resultSpine cod
  _ => spineOfType ty

-- 精化一个构造子：类型是「Pi 链 → F r1..rk」。
elabCtor : List (Pair String Term) -> String -> Int -> Ec -> Ctor -> Result (Pair DtCtor Ec)
elabCtor globals fam arity ec c = case c of
  Ctor cname tyExpr arityHint csp =>
    let
      -- M20：`data Foo a : Type` 的构造子类型不写 `{a : Type} ->`，这里把族参数补成隐式
      -- `EPi` 再检查（`a -> Foo a` ⇒ `{a : Type} -> a -> Foo a`），与显式写法形状一致。
      famKind = case globalLookup fam globals of
        Just k => k
        Nothing => TType levelZero
      tyExpr2 = if hasFamParams tyExpr then tyExpr else prependFamParams famKind tyExpr csp
    in andThen (checkType globals emptyCtx ec tyExpr2) (\pk => case pk of
      Pair tyTerm (Pair sort ec1) => case resultSpine (dropParams tyTerm) of
        Pair head args =>
          if head /= fam then errAt csp ("DT: constructor " ++ cname ++ " does not return " ++ fam)
          else if length args /= arity then errAt csp ("DT: constructor " ++ cname ++ " has the wrong number of indices for " ++ fam)
          else Ok (Pair (DtCtor cname fam (teleOfType tyTerm) tyTerm) ec1)
    )

-- 族的 kind 里的参数个数，补成隐式 `EPi`。
prependFamParams : Term -> Expr -> Span -> Expr
prependFamParams kindTerm tyExpr sp = case kindTerm of
  TPi n implicit rigB dom cod => EPi n True (EVar "Type" sp) (prependFamParams cod tyExpr sp) sp
  _ => tyExpr

-- 剥掉外层 Pi（`resultSpine` 需要看返回类型）。
dropParams : Term -> Term
dropParams t = case t of
  TPi n implicit rigB dom cod => dropParams cod
  _ => t

elabCtors : List (Pair String Term) -> String -> Int -> Ec -> List Ctor -> Result (Pair (List DtCtor) Ec)
elabCtors globals fam arity ec [] = Ok (Pair [] ec)
elabCtors globals fam arity ec (c :: rest) = andThen (elabCtor globals fam arity ec c) (\p => case p of
  Pair dc ec1 => andThen (elabCtors globals fam arity ec1 rest) (\q => case q of
    Pair dcs ec2 => Ok (Pair (dc :: dcs) ec2)
  )
)

ctorGlobals : List DtCtor -> List (Pair String Term)
ctorGlobals [] = []
ctorGlobals (c :: rest) = Pair (dtCtorName c) (dtCtorType c) :: ctorGlobals rest

-- 精化一个 data 声明：先把族的 kind 放进 globals（构造子要引用它），再精化构造子。
elabData : List (Pair String Term) -> Ec -> Pair Decl Span -> Result (Pair DtData (Pair (List (Pair String Term)) Ec))
elabData globals ec ds = case ds of
  Pair d dsp => case d of
    DData dname writtenParams kindExpr ctors derivings dsp2 => if memName dname preludeNames then errAt dsp2 ("DT: cannot redefine builtin " ++ dname)
    else andThen (checkType globals emptyCtx ec kindExpr) (\pk => case pk of
      Pair kindTerm (Pair kindSort ec1) =>
        let
          -- M20：族名后的参数并进 kind（`data List a : Type`），否则 `List a` 在构造子
          -- 类型里被当成「把非函数应用」。用显式 binder，与 `: Type -> Type` 写法一致。
          fullKind = prependParams writtenParams kindTerm
          tele = splitKind fullKind
          arity = length tele
        in if not (kindWellFormed fullKind) then errAt dsp2 "DT: the kind of a data declaration must be a chain of arrows ending in Type"
        else
          let
            globals2 = append globals [Pair dname fullKind]
          in andThen (elabCtors globals2 dname arity ec1 ctors) (\q => case q of
            Pair dctors ec2 =>
              Ok
                (Pair (DtData dname tele dctors) (Pair (append globals2 (ctorGlobals dctors)) (ecAddData ec2 (DtData dname tele dctors))))
          )
    )

-- 按源顺序精化所有 data 声明。
elabDatas : List (Pair Decl Span) -> List (Pair String Term) -> Ec -> Result (Pair (List DtData) (Pair (List (Pair String Term)) Ec))
elabDatas [] globals ec = Ok (Pair [] (Pair globals ec))
elabDatas (ds :: rest) globals ec = andThen (elabData globals ec ds) (\p => case p of
  Pair dd (Pair globals2 ec2) => andThen (elabDatas rest globals2 ec2) (\q => case q of
    Pair dds (Pair globals3 ec3) => Ok (Pair (dd :: dds) (Pair globals3 ec3))
  )
)

-- ---------------------------------------------------------------
-- M15：接口（trait）与实例（instance）——字典编码
-- ---------------------------------------------------------------
-- 不新增 Core 节点，全部落到既有 data / 隐式 Pi / 构造子上：
-- `trait Show a` ⇒ `data Dict_Show : Type -> Type` + 方法投影
-- `show : {a : Type} -> {d : Dict_Show a} -> a -> String`（字典当隐式参数穿进来）。
-- 实例搜索发生在隐式 binder 的域是接口字典时：在已注册实例里找头能统一到 `Dict_C args`
-- 的那一个并插入；找不到 ⇒ 明确缺失诊断。设计见 `docs/dt-core.md`。
dictTypeName : String -> String
dictTypeName cname = "Dict_" ++ cname

dictCtorName : String -> String
dictCtorName cname = "MkDict_" ++ cname

-- 收集 trait / instance 声明（按源顺序）。
collectTraitDecls : List Decl -> List (Pair Decl Span) -> List (Pair Decl Span)
collectTraitDecls [] acc = reverse acc
collectTraitDecls (d :: rest) acc = case d of
  DTrait tname params methods sp => collectTraitDecls rest (Pair d sp :: acc)
  _ => collectTraitDecls rest acc

collectInstDecls : List Decl -> List (Pair Decl Span) -> List (Pair Decl Span)
collectInstDecls [] acc = reverse acc
collectInstDecls (d :: rest) acc = case d of
  DInstance mname isDefault head methods sp => collectInstDecls rest (Pair d sp :: acc)
  _ => collectInstDecls rest acc

-- 单参数接口的参数名（elabTrait 已校验 length params == 1）。
paramNameOf : List String -> String
paramNameOf [] = "_"
paramNameOf (p :: rest) = p

-- 类参数绑成隐式 binder 后的局部上下文。
-- M19：类参数可以是**高阶 kind**（`trait Mapper f`，方法签名里写 `f a`）。kind 从方法签名推断：
-- 参数名被应用了 k 个实参就当 `Type -> ... -> Type`（k 个箭头），从未被应用就是 `Type`。
bindClassParams : List String -> List (Pair String Expr) -> Ctx -> Ctx
bindClassParams [] methods ctx = ctx
bindClassParams (p :: rest) methods ctx =
  bindClassParams rest methods (ctxBind p (classParamKind p methods) ctx)

-- 每个方法的字段类型（在类参数 binders 之下检查）。
classFieldTys : List (Pair String Term) -> Ec -> List String -> List (Pair String Expr) -> Result (Pair (List Term) Ec)
classFieldTys globals ec params methods =
  classFieldTysGo globals (bindClassParams params methods emptyCtx) ec methods []

classFieldTysGo : List (Pair String Term) -> Ctx -> Ec -> List (Pair String Expr) -> List Term -> Result (Pair (List Term) Ec)
classFieldTysGo globals ctx ec [] acc = Ok (Pair (reverse acc) ec)
classFieldTysGo globals ctx ec (m :: rest) acc = case m of
  Pair mname mexpr => andThen (checkType globals ctx ec (quantifyTraitSig (\nm => isJust (ctxLookup nm ctx)) mexpr (exprSpan mexpr))) (\p => case p of
    -- M20：trait 方法签名里的自由小写名（`fmap` 的 `a`/`b`）量化为隐式类型参数。
    Pair tyTerm (Pair sort ec1) => classFieldTysGo globals ctx ec1 rest (tyTerm :: acc)
  )

-- 批量把定义体塞进 Ec 的 defs 表（delta 展开用）。
foldlAddDef : Ec -> List (Pair String Term) -> Ec
foldlAddDef ec [] = ec
foldlAddDef ec (d :: rest) = foldlAddDef (ecAddDef ec d) rest

-- 字典构造子的字段 Pi 链。**每个字段的域都要按它前面已插入的字段 binder 数移位**：
-- 字段类型是相对「类参数 binder」精化的（类参数在 index 0），第 i 个字段的域在
-- Pi 链里已经跨过 i 个字段 binder，不移位就会把类参数指到前一个字段上
-- （`Eq` / `Ord` 的多方法签名曾因此渲染成 `unit`）。
foldPiFieldTys : List Term -> Term -> Term
foldPiFieldTys fieldTys ty = foldPiFieldTysGo fieldTys 0 ty

foldPiFieldTysGo : List Term -> Int -> Term -> Term
foldPiFieldTysGo [] n ty = ty
foldPiFieldTysGo (f :: rest) n ty =
  TPi "_" False Rig1 (shift 0 n f) (foldPiFieldTysGo rest (n + 1) ty)

-- 精化一个 trait：字典 DtData + 方法投影（签名 + 定义体）+ 类表项。
elabTrait : List (Pair String Term) -> Ec -> Pair Decl Span -> Result (Pair DtData (Pair (List (Pair String Term)) (Pair DtClass Ec)))
elabTrait globals ec ds = case ds of
  Pair d dsp => case d of
    DTrait tname params methods sp => if length params /= 1 then errAt sp "DT: interfaces must have exactly one parameter (M15 limitation)"
    else andThen (classFieldTys globals ec params methods) (\p => case p of
      Pair fieldTys ec1 =>
        let
          pname = paramNameOf params
          -- M19：类参数的 kind 从方法签名推断（`Functor f` 的 `f` 是 `Type -> Type`）。
          pKind = classParamKind pname methods
          dname = dictTypeName tname
          cname = dictCtorName tname
          dapp = foldAppTerms (TGlobal dname) [Pair (TVar pname 0) Rig0]
          ctorTy = TPi pname True Rig0 pKind (foldPiFieldTys fieldTys dapp)
          tele = teleOfType ctorTy
          dd = DtData dname tele [DtCtor cname dname tele ctorTy]
          projs = methodProjections tname pname pKind methods fieldTys
          projBodies = projectionDefs tname pname methods fieldTys (length methods)
          cls = DtClass tname params projs fieldTys
          ec2 = ecAddClass (ecAddData ec1 dd) cls
          ec3 = foldlAddDef ec2 projBodies
        in Ok (Pair dd (Pair projs (Pair cls ec3)))
    )
    _ => errAt dsp "DT: internal: expected a trait declaration"

-- 方法投影的签名与定义体：
--   sig:  `{p : <kind>} -> {d : Dict_C p} -> <方法类型>`
--   body: `\p => \d => case d of MkDict_C f0..fn => fk x1..xar`
-- 字段 fk 对应第 k 个方法（与构造子字段声明顺序一致）。
--
-- M19：`p` 的 kind 由 `classParamKind` 从方法签名推断，高阶 kind（`Functor f` 的
-- `Type -> Type`）也按真实 kind 生成 binder，不再写死 `Type`。
methodProjections : String -> String -> Term -> List (Pair String Expr) -> List Term -> List (Pair String Term)
methodProjections tname pname pKind methods fieldTys =
  methodProjZip tname pname pKind 0 methods fieldTys

methodProjZip : String -> String -> Term -> Int -> List (Pair String Expr) -> List Term -> List (Pair String Term)
methodProjZip tname pname pKind idx [] fieldTys = []
methodProjZip tname pname pKind idx (m :: rest) [] = []
methodProjZip tname pname pKind idx (m :: rest) (t :: rest2) = case m of
  Pair mname mexpr =>
    Pair mname (TPi pname True Rig0 pKind (TPi "_" True Rig0 (foldAppTerms (TGlobal (dictTypeName tname)) [Pair (TVar pname 0) Rig0]) (shift 0 1 t)))
      :: methodProjZip tname pname pKind (idx + 1) rest rest2

-- 投影的定义体：`\p => \d => \x0 .. \x(ar-1) => case d of MkDict_C f0..fn => f_k x0..`
-- 签名 `{p} -> {d : Dict_C p} -> <方法类型>`；de Bruijn 索引：`_d = n+ar`、`_p = n+ar+1`、
-- `f_k = n-1-k`、`x_i = n+(ar-1-i)`（最内层 = 0，分支绑定子 f 在方法参数之内）。
-- `rigs` 是方法显式参数各自的 multiplicity（M19：从方法签名逐 binder 取，`binderRig` 判据与
-- 实例方法体一致）。**lambda 链与应用点必须用同一份 rigs**：擦除位既不生成运行时形参、也不传
-- 实参——两侧都跳过，才能与由 `checkDef` 生成的实例方法体（同样按 rig 跳过擦除位）严格对齐。
projectionBody : String -> Int -> List Rig -> Int -> Term
projectionBody ctor fieldIdx rigs nFields =
  let
    arity = length rigs
    -- scrutinee 在分支绑定子之外求值，所以只跨过方法参数（_p=ar+1、_d=ar）。
    dictIdx = arity
    fieldVar = TVar (fieldVarName fieldIdx) (nFields - 1 - fieldIdx)
    argPairs = methodArgTerms rigs nFields
    applied = foldAppTerms fieldVar argPairs
    binders = fieldBinderNames nFields
    alt = CaseAlt ctor binders applied
    caseTerm = TCase (TVar "_d" dictIdx) [alt]
    lamArgs = methodArgLams rigs 0 caseTerm
  in TLam "_p" Rig0 (TLam "_d" Rig1 lamArgs)

-- 方法参数 x_i 的 (项, rig)：index = n + (ar - 1 - i)。
methodArgTerms : List Rig -> Int -> List (Pair Term Rig)
methodArgTerms rigs nFields = methodArgTermsGo rigs nFields 0 (length rigs)

methodArgTermsGo : List Rig -> Int -> Int -> Int -> List (Pair Term Rig)
methodArgTermsGo rigs nFields i arity = case rigs of
  [] => []
  rig :: rest =>
    Pair (TVar ("x" ++ strFromInt i) (nFields + (arity - 1 - i))) rig
      :: methodArgTermsGo rest nFields (i + 1) arity

-- 逐层 lambda 绑定方法参数（x_0 最外），每层用各自 rig。
methodArgLams : List Rig -> Int -> Term -> Term
methodArgLams [] i body = body
methodArgLams (rig :: rest) i body =
  TLam ("x" ++ strFromInt i) rig (methodArgLams rest (i + 1) body)

-- 方法显式参数的 multiplicity 表：逐 binder 按域判断（域是宇宙 ⇒ Rig0 擦除）。
fieldVarName : Int -> String
fieldVarName i = "f" ++ strFromInt i

fieldBinderNames : Int -> List (Pair String Rig)
fieldBinderNames n = fieldBinderGo n 0 []

fieldBinderGo : Int -> Int -> List (Pair String Rig) -> List (Pair String Rig)
fieldBinderGo n i acc =
  if i >= n then reverse acc else fieldBinderGo n (i + 1) (Pair (fieldVarName i) Rig1 :: acc)

explicitPiArity : Term -> Int
explicitPiArity t = case t of
  TPi n implicit rig dom cod => if implicit then explicitPiArity cod else 1 + explicitPiArity cod
  _ => 0

-- 投影定义表：每个方法一条 `m = <投影定义体>`。
projectionDefs : String -> String -> List (Pair String Expr) -> List Term -> Int -> List (Pair String Term)
projectionDefs tname pname methods fieldTys nFields =
  projectionDefsGo (dictCtorName tname) methods fieldTys 0 nFields

projectionDefsGo : String -> List (Pair String Expr) -> List Term -> Int -> Int -> List (Pair String Term)
projectionDefsGo ctor [] fieldTys idx nFields = []
projectionDefsGo ctor (m :: rest) [] idx nFields = []
projectionDefsGo ctor (m :: rest) (t :: rest2) idx nFields = case m of
  Pair mname mexpr =>
    Pair mname (projectionBody ctor idx (methodArgRigsOf binderRig t) nFields)
      :: projectionDefsGo ctor rest rest2 (idx + 1) nFields

-- 实例头 `Show Int` 的类名与实参。
instanceHeadName : Expr -> Maybe String
instanceHeadName e = case e of
  EVar n sp => Just n
  EApp fn args sp => case fn of
    EVar n fsp => Just n
    _ => Nothing
  _ => Nothing

-- 实例定义名：默认由类名与头实参派生（`Show_Int`），`as name` 覆盖。
--
-- M21：**匿名实例（无 `as`）在 Loader 里已经被加上模块前缀**（`Base.IO.#default`），
-- 所以原来的「名字里带 #」判定看不到匿名性——同一模块里 `instance Functor IO` 与
-- `instance Monad IO` 会得到**同一个** `Base.IO.#default`，字典定义在 defs 表里互相覆盖
-- （观测现象：`bind` 投影拿到 Functor 字典，main 归约卡住）。这里按**类名 + 头实参**
-- 重新派生唯一名（`Base.IO.Monad_IO`），既有 `as name` 与无前缀形态保持原样。
instanceName : String -> Maybe String -> Expr -> String
instanceName cname mname headExpr = case mname of
  Nothing => cname ++ "_" ++ derivedInstName headExpr
  Just n => if anonInstName n then instPrefixOf n ++ cname ++ "_" ++ derivedInstName headExpr else n

anonInstName : String -> Bool
anonInstName name = case splitLastDot (splitOnDot name) of
  Pair rev base => startsWith "#" base

instPrefixOf : String -> String
instPrefixOf name = case splitLastDot (splitOnDot name) of
  Pair rev base => if rev == [] then "" else joinDots rev ++ "."

derivedInstName : Expr -> String
derivedInstName e = case e of
  EApp fn args sp => case fn of
    EVar n fsp => n ++ argSuffix args
    _ => "Inst"
  EVar n sp => n
  _ => "Inst"

argSuffix : List Expr -> String
argSuffix [] = ""
argSuffix (a :: rest) = "_" ++ exprNameFor a ++ argSuffix rest

exprNameFor : Expr -> String
exprNameFor e = case e of
  EVar n sp => n
  EInt n sp => strFromInt n
  EStr s sp => s
  _ => "X"

-- 实例头实参的名字（`Pretty Color` 里的 `Color`）。
argNameOf : Expr -> String
argNameOf e = case e of
  EVar n sp => n
  _ => "Int"

-- 实例体：每个方法子句按方法签名 check，再按声明顺序组成字典构造子应用。
elabInstance : List (Pair String Term) -> List DtClass -> List DtData -> Ec -> Pair Decl Span -> Result (Pair (List (Pair String Term)) Ec)
elabInstance globals classes datas ec ds = case ds of
  Pair d dsp => case d of
    DInstance mname isDefault headExpr methods msp => case instanceHeadName headExpr of
      Nothing => errAt msp "DT: instance head must be an interface application (e.g. Show Int)"
      Just cname => case findClass cname classes of
        Nothing => errAt msp ("DT: unknown interface " ++ cname ++ " in instance head")
        Just cls => andThen (elabInstanceMethods globals cls (instanceHeadTerm headExpr) ec methods msp) (\p => case p of
          Pair fieldTerms (Pair fieldArgs ec1) =>
            let
              iname = instanceName (dtClassName cls) mname headExpr
              headTerm = instanceHeadTerm headExpr
              dctor = dictCtorName (dtClassName cls)
              dictTerm = TCon dctor fieldArgs
              dictTyTerm = ctorResultType cls headTerm
            in Ok
              (Pair [Pair iname dictTyTerm] (ecAddDef (ecAddInst ec1 (DtInst iname dictTyTerm)) (Pair iname dictTerm)))
        )
    _ => errAt dsp "DT: internal: expected an instance declaration"

-- 实例头 `Show Int` 的类型项（`Dict_Show Int`）。
-- 实例头的实参项：`Pretty Color` → `TGlobal "Color"`（M15 只支持单参数接口）。
instanceHeadTerm : Expr -> Term
instanceHeadTerm e = case e of
  EApp fn (a :: rest) sp => TGlobal (argNameOf a)
  EVar n sp => TGlobal n
  _ => TGlobal "Int"

-- 实例注册用的头类型：`Dict_C <arg>`，供实例搜索按头统一。
ctorResultType : DtClass -> Term -> Term
ctorResultType cls arg = foldAppTerms (TGlobal (dictTypeName (dtClassName cls))) [Pair arg Rig0]

findClass : String -> List DtClass -> Maybe DtClass
findClass name [] = Nothing
findClass name (c :: rest) = if dtClassName c == name then Just c else findClass name rest

-- 方法实现：逐个把 `m p1..pn = body` 变成一个 lambda 字段值。
-- 方法签名里的类参数 `a` 要被实例头的实参（如 `Color`）替换：`show : a -> String`
-- 在 `instance Show Color` 里就是 `Color -> String`。
elabInstanceMethods : List (Pair String Term) -> DtClass -> Term -> Ec -> List Decl -> Span -> Result (Pair (List Term) (Pair (List (Pair Term Rig)) Ec))
elabInstanceMethods globals cls headArg ec methods sp =
  elabInstanceMethodsGo globals ec (zipClassFields cls) (paramNameOf (dtClassParams cls)) headArg
    methods [] [] sp

-- 方法名 + 字段类型（方法声明顺序）。
zipClassFields : DtClass -> List (Pair String Term)
zipClassFields cls = zipMethodFields (dtClassMethods cls) (dtClassFieldTys cls)

zipMethodFields : List (Pair String Term) -> List Term -> List (Pair String Term)
zipMethodFields [] fieldTys = []
zipMethodFields (m :: rest) [] = []
zipMethodFields (m :: rest) (t :: rest2) = Pair (firstOf m) t :: zipMethodFields rest rest2

elabInstanceMethodsGo : List (Pair String Term) -> Ec -> List (Pair String Term) -> String -> Term -> List Decl -> List Term -> List (Pair Term Rig) -> Span -> Result (Pair (List Term) (Pair (List (Pair Term Rig)) Ec))
elabInstanceMethodsGo globals ec [] pname headArg decls terms args sp =
  Ok (Pair (reverse terms) (Pair (reverse args) ec))
elabInstanceMethodsGo globals ec ((Pair mname fty) :: rest) pname headArg decls terms args sp =
  let
    clauses = methodClausesNamed mname decls
    instTy = substClassParam pname headArg fty
  in case clauses of
    [] => errAt sp "DT: instance is missing an implementation for an interface method"
    _ => andThen (elabInstanceMethod globals ec instTy clauses) (\p => case p of
      Pair term ec1 =>
        elabInstanceMethodsGo globals ec1 rest pname headArg decls (term :: terms)
          (Pair term Rig1 :: args) sp
    )

-- 把方法类型里对类参数的引用（de Bruijn 0）替换成实例头实参。
-- 字段类型是在 `{a : Type}` 之下检查的闭合项，所以类参数恒为 index 0；
-- 这里按 **索引** 替换（不按名字），避免上游换名失效。
substClassParam : String -> Term -> Term -> Term
substClassParam pname arg ty = substVarAt 0 arg ty

-- 实例体里某个方法的**全部**子句（多 clause 方法：`fmp g (MkBox2 x) = ...` 后紧跟
-- 同名 clause）。M21 起这些子句一起走 `elabFunDef` 的模式矩阵，而不是只取第一条。
methodClausesNamed : String -> List Decl -> List (Pair (List Pat) Expr)
methodClausesNamed mname decls = methodClausesGo mname decls []

methodClausesGo : String -> List Decl -> List (Pair (List Pat) Expr) -> List (Pair (List Pat) Expr)
methodClausesGo mname [] acc = reverse acc
methodClausesGo mname (d :: rest) acc = case d of
  DFun n pats body sp =>
    if baseNameOf n == baseNameOf mname then methodClausesGo mname rest (Pair pats body :: acc)
    else methodClausesGo mname rest acc
  _ => methodClausesGo mname rest acc

-- 单个方法实现：把（已实例化的）方法签名当期望类型。
-- M21：方法子句允许构造子形参（`instance FMap Box2 where fmp g (MkBox2 x) = ...`），
-- 多 clause 也支持；参数全是变量/通配时直接绑定，否则与普通函数一样经 `elabFunDef`
-- 的模式矩阵降级，实例方法因此复用同一套索引精化与覆盖判定。
elabInstanceMethod : List (Pair String Term) -> Ec -> Term -> List (Pair (List Pat) Expr) -> Result (Pair Term Ec)
elabInstanceMethod globals ec mty clauses =
  elabFunDef globals ec clauses (eval [] mty) (clauseSpanOf clauses)

clauseSpanOf : List (Pair (List Pat) Expr) -> Span
clauseSpanOf clauses = case clauses of
  [] => Span "" 0 0 0 0
  c :: rest => exprSpan (secondOf c)

-- ---------------------------------------------------------------
-- M14：索引合一（unifyIdx）
-- ---------------------------------------------------------------
-- 只做索引层面的一阶合一：把 case 分支构造子的结果索引与 scrutinee 的索引对齐。
-- 可合一 ⇒ 产出精化表（level ↦ Value），分支体内所有类型求值都带上它；
-- 不可合一 ⇒ 该分支不可达：省略即合法（覆盖率跳过），写出即报错。
-- 方向约定：优先精化 **level 更大**（更内层）的变量，于是 ctor 一侧的新鲜变量精化成
-- scrutinee 的真实变量（`m ↦ n`），不会把真实变量解到分支作用域外（level 形态，无需 de Bruijn）。
unifyErr : Result a
unifyErr = Err "DT: this branch is impossible (index constraints are unsatisfiable)"

unifyIdxList : Ec -> List (Pair Int Value) -> Int -> Int -> List Value -> List Value -> Result (List (Pair Int Value))
unifyIdxList ec acc depth fuel [] [] = Ok acc
unifyIdxList ec acc depth fuel (x :: xs) (y :: ys) =
  andThen (unifyIdx ec acc depth (fuel - 1) x y)
    (\acc2 => unifyIdxList ec acc2 depth (fuel - 1) xs ys)
unifyIdxList ec acc depth fuel _ _ = unifyErr

unifyIdx : Ec -> List (Pair Int Value) -> Int -> Int -> Value -> Value -> Result (List (Pair Int Value))
unifyIdx ec acc depth fuel a b = if fuel <= 0 then Err "DT: index unification ran out of reduction fuel"
else
  let
    a2 = force (ecDefs ec) (ecSols ec) defaultFuel (refineValue acc defaultFuel a)
    b2 = force (ecDefs ec) (ecSols ec) defaultFuel (refineValue acc defaultFuel b)
  in case a2 of
    VNeutral (NVar an al []) => case b2 of
      VNeutral (NVar bn bl []) =>
        if al == bl then Ok acc
        else if al < bl then if occursLevel bl a2 then unifyErr else Ok (Pair bl a2 :: acc)
        else if occursLevel al b2 then unifyErr else Ok (Pair al b2 :: acc)
      _ => if occursLevel al b2 then unifyErr else Ok (Pair al b2 :: acc)
    _ => case b2 of
      VNeutral (NVar bn bl []) => if occursLevel bl a2 then unifyErr else Ok (Pair bl a2 :: acc)
      _ => unifyIdxRigid ec acc depth a2 b2

-- occurs check：精化成自己会导致无限链。
occursLevel : Int -> Value -> Bool
occursLevel lvl v = case v of
  VNeutral n => case n of
    NVar name l sp => l == lvl || occursLevelList lvl sp
    NGlobal g sp => occursLevelList lvl sp
  VPi name implicit rig dom clo => occursLevel lvl dom || occursLevelClo lvl clo
  VLam name rig clo => occursLevelClo lvl clo
  VMeta m sp => occursLevelList lvl sp
  VCon c args => occursLevelList lvl args
  VCase scrut alts => occursLevel lvl scrut
  VIf c th el => occursLevel lvl c || occursLevel lvl th || occursLevel lvl el
  VType l => False
  VInt n => False
  VStr s => False
  VBool b => False

occursLevelList : Int -> List Value -> Bool
occursLevelList lvl [] = False
occursLevelList lvl (v :: rest) = occursLevel lvl v || occursLevelList lvl rest

occursLevelClo : Int -> Closure -> Bool
occursLevelClo lvl clo = case clo of
  Clos env body => occursLevelList lvl env

-- 刚性位置：构造子/中性头按结构递归，其余回落到 conv 的相等性判定。
unifyIdxRigid : Ec -> List (Pair Int Value) -> Int -> Value -> Value -> Result (List (Pair Int Value))
unifyIdxRigid ec acc depth a b = case a of
  VCon c xs => case b of
    VCon c2 ys => if c == c2 then unifyIdxList ec acc depth defaultFuel xs ys else unifyErr
    _ => unifyErr
  VNeutral (NGlobal g sp) => case b of
    VNeutral (NGlobal g2 sp2) =>
      if g == g2 then unifyIdxList ec acc depth defaultFuel sp sp2
      else unifyIdxConv ec acc depth a b
    _ => unifyIdxConv ec acc depth a b
  VType i => case b of
    VType j => if levelEq i j then Ok acc else unifyErr
    _ => unifyErr
  VInt n => case b of
    VInt m => if n == m then Ok acc else unifyErr
    _ => unifyErr
  VStr s => case b of
    VStr s2 => if s == s2 then Ok acc else unifyErr
    _ => unifyErr
  VBool x => case b of
    VBool y => if x == y then Ok acc else unifyErr
    _ => unifyErr
  _ => unifyIdxConv ec acc depth a b

-- conv 回落：只判定相等（索引里的 meta 求解读 M15）。
unifyIdxConv : Ec -> List (Pair Int Value) -> Int -> Value -> Value -> Result (List (Pair Int Value))
unifyIdxConv ec acc depth a b = case conv (ecDefs ec) (ecSols ec) depth a b of
  Ok sols2 => Ok acc
  Err e => unifyErr

-- 构造子结果索引的新鲜实例（可达性分析 / 分支合一用）。
freshTeleVals : List (Pair String Rig) -> Int -> Int -> List Value
freshTeleVals [] base i = []
freshTeleVals ((Pair name erased) :: rest) base i =
  VNeutral (NVar name (base + i) []) :: freshTeleVals rest base (i + 1)

ctorResultVals : DtCtor -> Int -> List Value
ctorResultVals c base =
  let
    tele = dtCtorTelescope c
    env = reverse (freshTeleVals tele base 0)
  in map (\t => eval env t) (ctorResultTerms c)

-- 分支里的结果索引：用分支上下文（含已绑定的构造子字段）求值。
-- 于是 `Cons b m y ys` 的结果索引 `Vec b (Succ m)` 里出现的就是这些真实 binder，
-- 合一 `b ↦ a`、`Succ m ↦ n` 后分支体的类型自动被精化。
ctorResultValsIn : Ctx -> DtCtor -> List Value
ctorResultValsIn ctx c = map (\t => evalCtx ctx t) (ctorResultTerms c)

ctorResultTerms : DtCtor -> List Term
ctorResultTerms c = case resultSpine (dtCtorType c) of
  Pair head args => args

-- ---------------------------------------------------------------
-- M14：case 精化 + 覆盖率
-- ---------------------------------------------------------------
-- M19：嵌套构造子模式。做法是**把嵌套模式改写成嵌套 case**：
-- `Cons a (Succ k) rest => body` 变成 `Cons a x1 rest => case x1 of Succ k => body`。
-- 不需要新的精化规则或 Core 构造子——内层 case 走既有的索引合一与覆盖率检查，语义与手写
-- 嵌套 case 一致，天然支持任意深度。绑定 telescope 时把非变量子模式收集成「新鲜 binder +
-- 待匹配 (pat, var)」，分支体精化前把待匹配列表折成由内向外的内层 case。
data Pending : Type where
  Pending : Pat -> String -> Pending

pendingPat (Pending p n) = p

pendingName (Pending p n) = n

-- bindCtorGo 的累加器：telescope 绑定子（逆序）+ 待展开的嵌套模式（正序）。
data BindAcc : Type where
  BindAcc : List (Pair String Rig) -> List Pending -> BindAcc

baBinders (BindAcc bs ps) = bs

baPending (BindAcc bs ps) = ps

bindCtorTele : Ctx -> Term -> List Pat -> Result (Pair Ctx (Pair (List (Pair String Rig)) (Pair (List Pending) (List Pat))))
bindCtorTele ctx ty subpats = bindCtorGo ctx ty subpats (BindAcc [] [])

bindCtorGo : Ctx -> Term -> List Pat -> BindAcc -> Result (Pair Ctx (Pair (List (Pair String Rig)) (Pair (List Pending) (List Pat))))
bindCtorGo ctx ty subpats acc = case ty of
  TPi name implicit rig dom cod =>
    let
      domVal = eval (ctxEnv ctx) dom
    in if implicit then
      let
        -- 隐式族参数只服务类型层，用带前缀的新名字绑定，避免和用户模式变量/外层变量同名
        -- 造成遮蔽：嵌套模式的折叠会以内层 case 包住用户体，内层 ctor 的隐式 `a`
        -- 若与用户绑定的 `a` 同名，体里的 `a` 会被解析成 Type。
        famName = name ++ "#fam"
        ctx2 = ctxBindValue famName domVal ctx
      in bindCtorGo ctx2 cod subpats (BindAcc (Pair famName Rig0 :: baBinders acc) (baPending acc))
    else case subpats of
      [] => Err "DT: case branch has too few arguments for its constructor"
      p :: rest => case p of
        PVar pname psp => bindCtorBinder ctx domVal cod pname rest acc
        PWild psp => bindCtorBinder ctx domVal cod "_" rest acc
        PCon cname args psp =>
          let
            -- 嵌套模式：绑一个新鲜名字占位，把 (子模式, 名字) 记下来稍后折成内层 case。
            fresh = freshPatName (length (baPending acc))
            ctx2 = ctxBindValue fresh domVal ctx
          in bindCtorGo ctx2 cod rest
            (BindAcc (Pair fresh (binderRig False domVal) :: baBinders acc) (append (baPending acc) [Pending p fresh]))
        _ => Err "DT: nested patterns must be constructor patterns (M19)"
  _ => Ok (Pair ctx (Pair (reverse (baBinders acc)) (Pair (baPending acc) subpats)))

freshPatName : Int -> String
freshPatName i = "_np" ++ strFromInt i

bindCtorBinder : Ctx -> Value -> Term -> String -> List Pat -> BindAcc -> Result (Pair Ctx (Pair (List (Pair String Rig)) (Pair (List Pending) (List Pat))))
bindCtorBinder ctx domVal cod binderName rest acc =
  let
    ctx2 = ctxBindValue binderName domVal ctx
  in bindCtorGo ctx2 cod rest
    (BindAcc (Pair binderName (binderRig False domVal) :: baBinders acc) (baPending acc))

-- 折成内层 case：`[Pending p1 v1, Pending p2 v2]` + body
-- → `case v1 of p1 => (case v2 of p2 => body)`（收集顺序即由外到内）。
-- **兜底分支要一并下沉**：`case xs of (x :: Nil) => a; _ => b` 里外层已进入 Cons 分支，
-- 尾表不是 Nil 时必须落到 `b`；旧实现只建 `case tail of Nil => a`，覆盖检查报
-- `missing Cons`（且运行时无处可落）。每一层内层 case 都带上同一个兜底体（Expr 而非
-- Term，按名字重新精化，各层上下文自然不同）。
foldPending : Maybe Expr -> List Pending -> Expr -> Expr
foldPending fb [] body = body
foldPending fb (p :: rest) body =
  let
    ps = patSpan (pendingPat p)
    patAlt = Pair (pendingPat p) (foldPending fb rest body)
  in case fb of
    Just fbExpr => ECase (EVar (pendingName p) ps) [patAlt, Pair (PWild ps) fbExpr] ps
    Nothing => ECase (EVar (pendingName p) ps) [patAlt] ps

-- 显式 constructor 分支：绑 telescope → 合一结果索引 → 把嵌套模式折成内层 case →
-- 在精化后的上下文里查分支体。
elabConAlt : Maybe Expr -> List (Pair String Term) -> Ctx -> Ec -> DtData -> List Value -> Value -> String -> List Pat -> Span -> Expr -> Result (Pair CaseAlt Ec)
elabConAlt fb globals ctx ec dd idxs expected cname args psp body = case findCtorIn cname (dtDataCtors dd) of
  Nothing => errAt psp ("DT: unknown constructor " ++ cname ++ " in case " ++ dtDataName dd)
  Just ctor => andThen (bindCtorTele ctx (dtCtorType ctor) args) (\p => case p of
    Pair branchCtx (Pair binders (Pair pending leftover)) => if nonEmpty leftover then errAt psp ("DT: branch for constructor " ++ cname ++ " has too many arguments")
    else case unifyIdxList ec [] (ctxDepth branchCtx) defaultFuel (ctorResultValsIn branchCtx ctor) (map (refineValue [] defaultFuel) idxs) of
      Err e => errAt psp "DT: this branch is impossible (index constraints are unsatisfiable)"
      Ok refs2 =>
        let
          refinedExpected = refineValue refs2 defaultFuel expected
          branchCtx2 = ctxRefine branchCtx refs2
          body2 = foldPending fb pending body
        in andThen (checkE globals branchCtx2 ec body2 refinedExpected) (\pb => case pb of
          Pair bodyTerm ec2 => Ok (Pair (CaseAlt cname binders bodyTerm) ec2)
        )
  )

elabCaseAlts : List (Pair String Term) -> Ctx -> Ec -> DtData -> List Value -> Value -> List (Pair Pat Expr) -> List CaseAlt -> Result (Pair (List CaseAlt) Ec)
elabCaseAlts globals ctx ec dd idxs expected [] acc = Ok (Pair (reverse acc) ec)
elabCaseAlts globals ctx ec dd idxs expected (alt :: rest) acc = case alt of
  Pair pat body => case pat of
    PCon cname args psp => andThen (elabConAlt (findCatchAllBody rest) globals ctx ec dd idxs expected cname args psp body) (\p => case p of
      Pair altTerm ec1 => elabCaseAlts globals ctx ec1 dd idxs expected rest (altTerm :: acc)
    )
    PVar pname psp => elabCatchAll globals ctx ec dd idxs expected rest acc body psp
    PWild psp => elabCatchAll globals ctx ec dd idxs expected rest acc body psp
    _ => errAt (patSpan pat) "DT: only constructor patterns are supported in case (M14)"

-- 兜底分支：只允许出现在最后；体在未精化的上下文里检查。
-- 内部用空名字标记兜底分支（Core / codegen 按空名字识别）。
elabCatchAll : List (Pair String Term) -> Ctx -> Ec -> DtData -> List Value -> Value -> List (Pair Pat Expr) -> List CaseAlt -> Expr -> Span -> Result (Pair (List CaseAlt) Ec)
elabCatchAll globals ctx ec dd idxs expected rest acc body psp = if nonEmpty rest then errAt psp "DT: the catch-all branch must be the last one"
else andThen (checkE globals ctx ec body expected) (\pb => case pb of
  Pair bodyTerm ec2 => Ok (Pair (reverse (CaseAlt "" [] bodyTerm :: acc)) ec2)
)

altNames : List (Pair Pat Expr) -> List String
altNames [] = []
altNames (alt :: rest) = case alt of
  Pair pat body => case pat of
    PCon cname args psp => cname :: altNames rest
    _ => altNames rest

hasCatchAll : List (Pair Pat Expr) -> Bool
hasCatchAll [] = False
hasCatchAll (alt :: rest) = case alt of
  Pair pat body => case pat of
    PCon cname args psp => hasCatchAll rest
    _ => True

hasDupNames : List String -> Bool
hasDupNames [] = False
hasDupNames (x :: rest) = memName x rest || hasDupNames rest

-- 覆盖率：可达的构造子必须都出现；不可达的可以省略（写了会被 elabConAlt 拒）。
checkCoverage : Ec -> Int -> DtData -> List Value -> List (Pair Pat Expr) -> Span -> Result Int
checkCoverage ec depth dd idxs alts sp = checkCovered ec depth dd idxs alts sp (dtDataCtors dd)

checkCovered : Ec -> Int -> DtData -> List Value -> List (Pair Pat Expr) -> Span -> List DtCtor -> Result Int
checkCovered ec depth dd idxs alts sp [] = Ok 0
checkCovered ec depth dd idxs alts sp (ctor :: rest) =
  let
    written = altNames alts
    reachable = case unifyIdxList ec [] depth defaultFuel (ctorResultVals ctor depth) idxs of
      Ok refs => True
      Err e => False
  in if reachable then if memName (dtCtorName ctor) written then checkCovered ec depth dd idxs alts sp rest
  else Err ("DT: case is not exhaustive: missing " ++ dtCtorName ctor)
  else checkCovered ec depth dd idxs alts sp rest

-- case：先验 scrutinee 是归纳族，再逐分支精化，最后查覆盖率。
checkCase : List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair Pat Expr) -> Value -> Span -> Result (Pair Term Ec)
checkCase globals ctx ec scrut alts expected sp = andThen (inferE globals ctx ec scrut) (\ps => case ps of
  Pair scrutTerm (Pair scrutTy ec1) =>
    checkCaseFam globals ctx ec1 scrutTerm scrutTy alts expected sp
)

checkCaseFam : List (Pair String Term) -> Ctx -> Ec -> Term -> Value -> List (Pair Pat Expr) -> Value -> Span -> Result (Pair Term Ec)
checkCaseFam globals ctx ec scrutTerm scrutTy alts expected sp = case forceVal ec scrutTy of
  VNeutral (NGlobal fam idxs) =>
    if isBoolBaseName fam && idxs == [] then checkBoolCase globals ctx ec scrutTerm alts expected sp
    else if fam == "Int" then checkLitCase globals ctx ec scrutTerm "Int" alts expected sp
    else if fam == "String" then checkLitCase globals ctx ec scrutTerm "String" alts expected sp
    else checkCaseOf globals ctx ec scrutTerm fam idxs alts expected sp
  _ => errAt sp "DT: case scrutinee is not an inductive family"

-- M19：Bool 上的 case 降级成 if（`True` / `False` 是零参构造子形态的模式）。
checkBoolCase : List (Pair String Term) -> Ctx -> Ec -> Term -> List (Pair Pat Expr) -> Value -> Span -> Result (Pair Term Ec)
checkBoolCase globals ctx ec scrutTerm alts expected sp = andThen (boolAlt globals ctx ec alts "True" expected sp) (\p => case p of
  Pair trueBody (Pair catchAll ec1) => case catchAll of
    Just falseBody => Ok (Pair (TIf scrutTerm trueBody falseBody) ec1)
    Nothing => andThen (boolAlt globals ctx ec alts "False" expected sp) (\q => case q of
      Pair falseBody (Pair _ ec2) => Ok (Pair (TIf scrutTerm trueBody falseBody) ec2)
    )
)

-- 取 `True` / `False` 分支的体；变量/通配分支作为两边的兜底。
boolAlt : List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> String -> Value -> Span -> Result (Pair Term (Pair (Maybe Term) Ec))
boolAlt globals ctx ec alts target expected sp =
  boolAltGo globals ctx ec alts target expected sp Nothing

boolAltGo : List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> String -> Value -> Span -> Maybe Term -> Result (Pair Term (Pair (Maybe Term) Ec))
boolAltGo globals ctx ec [] target expected sp catchAll = case catchAll of
  Just t => Ok (Pair t (Pair Nothing ec))
  Nothing => errAt sp ("DT: case is not exhaustive: missing " ++ target)
boolAltGo globals ctx ec (alt :: rest) target expected sp catchAll = case alt of
  Pair pat body => case pat of
    PCon cname args psp => if cname == target then andThen (checkE globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 => Ok (Pair bodyTerm (Pair catchAll ec1))
    )
    else boolAltGo globals ctx ec rest target expected sp catchAll
    PVar pname psp => andThen (checkE globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 => boolAltGo globals ctx ec rest target expected sp (Just bodyTerm)
    )
    PWild psp => andThen (checkE globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 => boolAltGo globals ctx ec rest target expected sp (Just bodyTerm)
    )
    _ => errAt (patSpan pat) "DT: case on Bool only accepts True / False / variable patterns (M19)"

-- M19：Int / String 上的字面量模式降级成嵌套 if。
-- `case n of 0 => a; 1 => b; x => c` 变成 `if n == 0 then a else if n == 1 then b else c`。
checkLitCase : List (Pair String Term) -> Ctx -> Ec -> Term -> String -> List (Pair Pat Expr) -> Value -> Span -> Result (Pair Term Ec)
checkLitCase globals ctx ec scrutTerm tyName alts expected sp = andThen (checkLitAlts globals ctx ec scrutTerm tyName alts expected sp) (\p => case p of
  Pair term (Pair hasDefault ec1) =>
    if hasDefault then Ok (Pair term ec1)
    else errAt sp "DT: case on Int / String needs a variable or wildcard branch as fallback (M19)"
)

-- Int / String 字面量列：每个字面量降成 `if n == lit then body else <rest>`；
-- 变量/通配分支提供 fallback（并且把变量绑进上下文，让用户在体里能用它）。
checkLitAlts : List (Pair String Term) -> Ctx -> Ec -> Term -> String -> List (Pair Pat Expr) -> Value -> Span -> Result (Pair Term (Pair Bool Ec))
checkLitAlts globals ctx ec scrutTerm tyName [] expected sp =
  Ok (Pair (TIf (TBool False) (TInt 0) (TInt 0)) (Pair False ec))
checkLitAlts globals ctx ec scrutTerm tyName (alt :: rest) expected sp = case alt of
  Pair pat body => case pat of
    PInt n psp => litAltStep globals ctx ec scrutTerm tyName (TInt n) body rest expected sp
    PStr s psp => litAltStep globals ctx ec scrutTerm tyName (TStr s) body rest expected sp
    PVar pname psp => andThen (checkLitBoundVar globals ctx ec scrutTerm tyName pname body expected sp) (\p => case p of
      Pair bodyTerm ec1 => Ok (Pair bodyTerm (Pair True ec1))
    )
    PWild psp => andThen (checkE globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 => Ok (Pair bodyTerm (Pair True ec1))
    )
    _ =>
      errAt (patSpan pat) "DT: case on Int / String only accepts literals / variable patterns (M19)"

-- 字面量分支：`if n == lit then body else <rest>`（rest 提供 fallback）。
litAltStep : List (Pair String Term) -> Ctx -> Ec -> Term -> String -> Term -> Expr -> List (Pair Pat Expr) -> Value -> Span -> Result (Pair Term (Pair Bool Ec))
litAltStep globals ctx ec scrutTerm tyName litTerm body rest expected sp = andThen (checkE globals ctx ec body expected) (\p => case p of
  Pair bodyTerm ec1 => andThen (checkLitAlts globals ctx ec1 scrutTerm tyName rest expected sp) (\q => case q of
    Pair restTerm (Pair hasDefault ec2) =>
      Ok
        (Pair (TIf (TApp (TApp (TGlobal "==") scrutTerm Rig1) litTerm Rig1) bodyTerm restTerm) (Pair hasDefault ec2))
  )
)

-- fallback 分支的体在「scrutinee 绑成该变量」的上下文里检查。
checkLitBoundVar : List (Pair String Term) -> Ctx -> Ec -> Term -> String -> String -> Expr -> Value -> Span -> Result (Pair Term Ec)
checkLitBoundVar globals ctx ec scrutTerm tyName name body expected sp =
  let
    scrutVal = evalCtx ctx scrutTerm
    ctx2 = ctxBindValue name scrutVal ctx
  in checkE globals ctx2 ec body expected

checkCaseOf : List (Pair String Term) -> Ctx -> Ec -> Term -> String -> List Value -> List (Pair Pat Expr) -> Value -> Span -> Result (Pair Term Ec)
checkCaseOf globals ctx ec scrutTerm fam idxs alts expected sp = case dtDataLookup fam (ecDatas ec) of
  Nothing => errAt sp "DT: case scrutinee is not an inductive family"
  Just dd => if hasDupNames (altNames alts) then errAt sp "DT: duplicate constructor in case"
  else andThen (elabCaseAlts globals ctx ec dd idxs expected alts []) (\p => case p of
    Pair altTerms ec2 => checkCaseDone ec2 ctx dd idxs alts expected sp scrutTerm altTerms
  )

checkCaseDone : Ec -> Ctx -> DtData -> List Value -> List (Pair Pat Expr) -> Value -> Span -> Term -> List CaseAlt -> Result (Pair Term Ec)
checkCaseDone ec ctx dd idxs alts expected sp scrutTerm altTerms =
  if hasCatchAll alts then Ok (Pair (TCase scrutTerm altTerms) ec)
  else andThen (checkCoverage ec (ctxDepth ctx) dd idxs alts sp)
    (\_ => Ok (Pair (TCase scrutTerm altTerms) ec))

-- ---------------------------------------------------------------
-- 精化入口
-- ---------------------------------------------------------------
-- 按源顺序精化签名：每个签名只对「prelude + 之前的签名」可见。
elabSigs : List (Pair String Expr) -> List (Pair String Term) -> Ec -> Result (Pair (List (Pair String Term)) Ec)
elabSigs [] globals ec = Ok (Pair globals ec)
elabSigs ((Pair name tyExpr) :: rest) globals ec = andThen (checkType globals emptyCtx ec tyExpr) (\p => case p of
  Pair tyTerm (Pair sortLvl ec1) => elabSigs rest (append globals [Pair name tyTerm]) ec1
)

-- ---------------------------------------------------------------
-- 泛型实例约束提升（M20 剩余 / M22 前置）
-- ---------------------------------------------------------------
-- 定义体对刚性类参数的字典需求（如 `mem` 的 `Dict_Eq a`）被 `deferEqDict` 延迟成 `?d`+自由目标；
-- 体精化完后 `liftFreeDictGoals` 提升成隐式字典参数：`mem : a -> L a -> Bool` →
-- `mem : {a} -> {d : Dict_Eq a} -> a -> L a -> Bool`，体前插 `TLam d`、`?d` 换 `d`、解孤儿 `?d`。
freeDictGoals : Ec -> List (Pair Int Value)
freeDictGoals ec = freeDictGoalsGo ec (ecDictGoals ec)

freeDictGoalsGo : Ec -> List DtDictGoal -> List (Pair Int Value)
freeDictGoalsGo ec [] = []
freeDictGoalsGo ec (g :: rest) = case g of
  DtDictGoal m dom => if isRigidDictArg ec dom then case metaLookup m (ecSols ec) of
    -- 已提升过的目标不再重复提升（`solveLiftedMeta` 已把 ?m 解成 `d`）；
    -- 否则后续每个定义都会被塞进一个多余的字典 binder（曾把 `xor` 的
    -- `not b` 破坏成一次字典搜索）。
    Just _ => freeDictGoalsGo ec rest
    Nothing => Pair m dom :: freeDictGoalsGo ec rest
  else freeDictGoalsGo ec rest

classArgIndex : Ec -> Value -> Int
classArgIndex ec dom = case dictClassArg ec dom of
  Just arg => case forceVal ec arg of
    VNeutral n => case n of
      NVar name lvl sp => lvl
      _ => 0
    _ => 0
  Nothing => 0

-- 解掉被替换出体的孤儿 `?m`（否则 `unsolvedMeta` 报未解元变量）。
solveLiftedMeta : Ec -> String -> Int -> Ec
solveLiftedMeta ec name m = case solveMeta (ecDefs ec) (ecSols ec) 0 m [] (VNeutral (NVar name 0 [])) of
  Ok sols2 => ecPutSols ec sols2
  Err e => ec

liftFreeDictGoals : String -> Ec -> Term -> Term -> Pair Term (Pair Term Ec)
liftFreeDictGoals defName ec ty body = liftFreeDictGoalsGo defName ec ty body 0 (freeDictGoals ec)

liftFreeDictGoalsGo : String -> Ec -> Term -> Term -> Int -> List (Pair Int Value) -> Pair Term (Pair Term Ec)
liftFreeDictGoalsGo defName ec ty body inserted [] = Pair ty (Pair body ec)
liftFreeDictGoalsGo defName ec ty body inserted ((Pair m dom) :: rest) =
  let
    dName = "d" ++ strFromInt m
    -- `classArgIndex` 取类参数 binder 的 level（绝对位置）；每插入一个字典 binder，
    -- 它之后的位置都后移 1，所以提升后的插入点是 `level + inserted`。
    argIdx = classArgIndex ec dom + inserted
    dictDom =
      substSolvedMetasAt (classArgIndex ec dom + 1) (ecSols ec)
        (quote (classArgIndex ec dom + 1) dom)
    ty2 = insertDictBinder dName argIdx dictDom ty
    body2 = insertLamBinder dName argIdx (substMetaVar m dName (argIdx + 1) body)
    -- M21：体是按**旧签名**（无字典 binder）精化的，自递归调用点少一个字典实参；
    -- 提升后按应用位置补上。字典 binder 插在第 `argIdx` 个 binder 之后，即第
    -- `argIdx + 1` 个 binder / 第 `argIdx + 1` 个应用实参。
    body3 = insertDictCalls defName dName (argIdx + 1) body2
    ec2 = solveLiftedMeta ec dName m
  in liftFreeDictGoalsGo defName ec2 ty2 body3 (inserted + 1) rest

-- ---------------------------------------------------------------
-- 遍历项时跟踪 binder 深度（从最外层数），遇到「头是目标全局」的应用脊时在固定位置
-- 插入 `d` 实参；`TVar d` 的 de Bruijn index = depth - (字典位置 + 1)。
insertDictCalls : String -> String -> Int -> Term -> Term
insertDictCalls defName dName appPos t = injectDictGo defName dName appPos 0 t

injectDictGo : String -> String -> Int -> Int -> Term -> Term
injectDictGo defName dName appPos depth t = case t of
  TLam n r b => TLam n r (injectDictGo defName dName appPos (depth + 1) b)
  TPi n i r d c =>
    TPi n i r (injectDictGo defName dName appPos depth d)
      (injectDictGo defName dName appPos (depth + 1) c)
  TApp f a r => case flattenTaggedApp t of
    Just (Pair g args) => rewriteTaggedSpine defName dName appPos depth g args
    Nothing =>
      TApp (injectDictGo defName dName appPos depth f) (injectDictGo defName dName appPos depth a) r
  TCon c args =>
    TCon c
      (map (\p => Pair (injectDictGo defName dName appPos depth (firstOf p)) (secondOf p)) args)
  TCase scrut alts =>
    TCase (injectDictGo defName dName appPos depth scrut)
      (map (injectAltGo defName dName appPos depth) alts)
  TIf c th el =>
    TIf (injectDictGo defName dName appPos depth c) (injectDictGo defName dName appPos depth th)
      (injectDictGo defName dName appPos depth el)
  _ => t

injectAltGo : String -> String -> Int -> Int -> CaseAlt -> CaseAlt
injectAltGo defName dName appPos depth alt = case alt of
  CaseAlt n bs b => CaseAlt n bs (injectDictGo defName dName appPos (depth + length bs) b)

flattenTaggedApp : Term -> Maybe (Pair String (List (Pair Term Rig)))
flattenTaggedApp t = case t of
  TApp f a rig => case flattenTaggedApp f of
    Just (Pair g args) => Just (Pair g (append args [Pair a rig]))
    Nothing => Nothing
  TGlobal g => Just (Pair g [])
  _ => Nothing

rewriteTaggedSpine : String -> String -> Int -> Int -> String -> List (Pair Term Rig) -> Term
rewriteTaggedSpine defName dName appPos depth g args =
  let
    args2 = map (\p => Pair (injectDictGo defName dName appPos depth (firstOf p)) (secondOf p)) args
  in if g == defName && length args2 > appPos && depth > appPos then foldAppTerms (TGlobal g) (insertArgAt appPos (Pair (TVar dName (depth - appPos - 1)) Rig1) args2)
  else foldAppTerms (TGlobal g) args2

insertArgAt : Int -> a -> List a -> List a
insertArgAt n x xs = append (append (take n xs) [x]) (drop n xs)

-- 提升后的签名要回写 globals：后续定义调用它时按新签名（带字典 binder）走隐式实参插入。
replaceGlobalType : String -> Term -> List (Pair String Term) -> List (Pair String Term)
replaceGlobalType name ty [] = []
replaceGlobalType name ty (p :: rest) =
  if firstOf p == name then Pair name ty :: rest else p :: replaceGlobalType name ty rest

elabBodies : List Decl -> List (Pair String Term) -> List (Pair String Term) -> List DtDef -> Ec -> Result (Pair (List DtDef) Ec)
elabBodies [] globals doneDefs acc ec = Ok (Pair (reverse acc) ec)
elabBodies (d :: rest) globals doneDefs acc ec = case d of
  DFun name pats body sp => case globalLookup name globals of
    Nothing => errAt sp ("DT: expected a type signature for " ++ name)
    Just tyTerm => if memDefName name doneDefs then elabBodies rest globals doneDefs acc ec
    else andThen (elabFunDef globals ec (clausesFor (d :: rest) name) (eval [] tyTerm) sp) (\p => case p of
      Pair bodyTerm ec1 =>
        let
          lifted = liftFreeDictGoals name ec1 tyTerm bodyTerm
          liftedTy = firstOf lifted
          liftedBody = firstOf (secondOf lifted)
          liftedEc = secondOf (secondOf lifted)
          cleanTerm = substDictTerm liftedEc liftedBody
          globals2 = replaceGlobalType name liftedTy globals
        in elabBodies rest globals2 (Pair name liftedTy :: doneDefs)
          (DtDef name liftedTy cleanTerm :: acc) (ecAddDef liftedEc (Pair name cleanTerm))
    )
  _ => elabBodies rest globals doneDefs acc ec

-- 每个签名都必须有定义（M13 不支持公理/未定义顶层）。
checkAllDefined : List (Pair String Expr) -> List (Pair String Term) -> List Decl -> Result (List String)
checkAllDefined [] globals decls = Ok []
checkAllDefined ((Pair name tyExpr) :: rest) globals decls = if hasFunClause name decls then case globalLookup name globals of
  Nothing => Err ("DT: signature for " ++ name ++ " has no definition")
  Just ty => checkAllDefined rest globals decls
else Err ("DT: signature for " ++ name ++ " has no definition")

hasFunClause : String -> List Decl -> Bool
hasFunClause name [] = False
hasFunClause name (d :: rest) = case d of
  DFun n pats body sp => if n == name then True else hasFunClause name rest
  _ => hasFunClause name rest

-- M15：完整精化，额外返回洞目标与最终状态（供 `vuna goal` / LSP 的洞显示）。
data DtProgram : Type where
  DtProgram : List DtData -> List DtDef -> List DtGoal -> List (Pair Int Value) -> DtProgram

dtProgDatas (DtProgram datas defs goals sols) = datas

dtProgDefs (DtProgram datas defs goals sols) = defs

dtProgGoals (DtProgram datas defs goals sols) = goals

dtProgSols (DtProgram datas defs goals sols) = sols

-- 精化入口。M19：先做 record 降级（`DtRecords.prepareDecls`）——record 是纯记法。
elabProgramFull : List Decl -> Result DtProgram
elabProgramFull decls =
  andThen (prepareDecls decls) (\ds => andThen (expandDerivings ds) (\ds2 => elabProgramGo ds2))

elabProgramGo : List Decl -> Result DtProgram
elabProgramGo decls = andThen (collectSigs decls) (\sigs => andThen (elabDatas (collectDataDecls decls []) (preludeGlobalsFor (pickListFamily (dataNamesOf decls))) ecEmpty) (\pd => case pd of
  Pair datas (Pair globals0 ec0) => andThen (elabTraits (append (collectTraitDecls builtinTraitDecls []) (collectTraitDecls decls [])) globals0 ec0) (\pt => case pt of
    Pair classDatas (Pair projGlobals (Pair classes ec1)) =>
      let
        globals1 = append globals0 projGlobals
        datas1 = append datas classDatas
      in andThen (checkInstanceHeads (collectInstDecls (append builtinShowInstances (append builtinEqInstances (append builtinOrdInstances decls))) []) classes globals1 ec1) (\pih => case pih of
        Pair instHeads ec1b =>
          let
            globals2 = append globals1 instHeads
          in andThen (elabSigs sigs globals2 ec1b) (\p => case p of
            Pair globals ec2 => andThen (checkAllDefined sigs globals decls) (\_ => andThen (elabBodies decls globals [] [] ec2) (\q => case q of
              Pair defs ec3 => andThen (elabInstanceBodies (collectInstDecls (append builtinShowInstances (append builtinEqInstances (append builtinOrdInstances decls))) []) classes datas1 globals ec3) (\pi => case pi of
                Pair instDefs ec4 => case unsolvedMeta ec4 of
                  Just m => Err (unsolvedMessage ec4 m)
                  Nothing =>
                    let
                      extra = extraDefsOf globals ec4 (append instDefs defs)
                    in andThen (checkTerminationDecls decls)
                      (\_ => Ok (DtProgram datas1 (append instDefs (append extra defs)) (ecGoals ec4) (ecSols ec4)))
              )
            )
            )
          )
      )
  )
)
)

-- M15：批量注册实例。
foldlAddInst : Ec -> List DtInst -> Ec
foldlAddInst ec [] = ec
foldlAddInst ec (i :: rest) = foldlAddInst (ecAddInst ec i) rest

-- 实例头（`Dict_C <arg>`）的签名先入 globals：实例方法体要按它 check。
checkInstanceHeads : List (Pair Decl Span) -> List DtClass -> List (Pair String Term) -> Ec -> Result (Pair (List (Pair String Term)) Ec)
checkInstanceHeads decls classes globals ec = checkInstanceHeadsGo decls classes globals ec [] []

checkInstanceHeadsGo : List (Pair Decl Span) -> List DtClass -> List (Pair String Term) -> Ec -> List (Pair String Term) -> List DtInst -> Result (Pair (List (Pair String Term)) Ec)
checkInstanceHeadsGo [] classes globals ec acc insts =
  Ok (Pair (reverse acc) (foldlAddInst ec (reverse insts)))
checkInstanceHeadsGo (d :: rest) classes globals ec acc insts = case d of
  Pair decl dsp => case decl of
    DInstance mname isDefault headExpr methods msp => case instanceHeadName headExpr of
      Nothing => errAt msp "DT: instance head must be an interface application (e.g. Show Int)"
      Just cname => case findClass cname classes of
        Nothing => errAt msp ("DT: unknown interface " ++ cname ++ " in instance head")
        Just cls =>
          let
            iname = instanceName (dtClassName cls) mname headExpr
            ty = ctorResultType cls (instanceHeadTerm headExpr)
          in checkInstanceHeadsGo rest classes globals ec (Pair iname ty :: acc)
            (DtInst iname ty :: insts)
    _ => checkInstanceHeadsGo rest classes globals ec acc insts

-- 实例方法体（在顶层定义之后精化）。
elabInstanceBodies : List (Pair Decl Span) -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> Result (Pair (List DtDef) Ec)
elabInstanceBodies decls classes datas globals ec =
  elabInstanceBodiesGo decls classes datas globals ec []

elabInstanceBodiesGo : List (Pair Decl Span) -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> List DtDef -> Result (Pair (List DtDef) Ec)
elabInstanceBodiesGo [] classes datas globals ec acc = Ok (Pair (reverse acc) ec)
elabInstanceBodiesGo (d :: rest) classes datas globals ec acc = andThen (elabInstance globals classes datas ec d) (\p => case p of
  Pair gs ec1 =>
    let
      newDefs = instanceDefsOf ec ec1 gs
    in elabInstanceBodiesGo rest classes datas (append globals gs) ec1 (append newDefs acc)
)

-- 从「精化前后 Ec 的 defs 差集」里取出这一条 instance 生成的定义。
instanceDefsOf : Ec -> Ec -> List (Pair String Term) -> List DtDef
instanceDefsOf ecBefore ecAfter gs =
  map
    (\g => DtDef (firstOf g) (defTypeOrDefault gs (firstOf g)) (substDictTerm ecAfter (defBodyOf (ecDefs ecAfter) (firstOf g))))
    gs

defBodyOf : List (Pair String Term) -> String -> Term
defBodyOf defs name = case defLookup name defs of
  Just body => body
  Nothing => TInt 0

-- 逐条精化 trait，收集字典 data / 投影签名 / 类表。
elabTraits : List (Pair Decl Span) -> List (Pair String Term) -> Ec -> Result (Pair (List DtData) (Pair (List (Pair String Term)) (Pair (List DtClass) Ec)))
elabTraits decls globals ec = elabTraitsGo decls globals ec [] [] []

elabTraitsGo : List (Pair Decl Span) -> List (Pair String Term) -> Ec -> List DtData -> List (Pair String Term) -> List DtClass -> Result (Pair (List DtData) (Pair (List (Pair String Term)) (Pair (List DtClass) Ec)))
elabTraitsGo [] globals ec ds gs cs =
  Ok (Pair (reverse ds) (Pair (reverse gs) (Pair (reverse cs) ec)))
elabTraitsGo (d :: rest) globals ec ds gs cs = andThen (elabTrait globals ec d) (\p => case p of
  Pair dd (Pair projs (Pair cls ec1)) =>
    elabTraitsGo rest (append globals projs) ec1 (dd :: ds) (append projs gs) (cls :: cs)
)

-- 逐条精化 instance：定义体进 Ec 的 defs（实例表），头类型进 globals。
elabInstances : List (Pair Decl Span) -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> Result (Pair (List (Pair String Term)) Ec)
elabInstances decls classes datas globals ec = elabInstancesGo decls classes datas globals ec []

elabInstancesGo : List (Pair Decl Span) -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> List (Pair String Term) -> Result (Pair (List (Pair String Term)) Ec)
elabInstancesGo [] classes datas globals ec acc = Ok (Pair (reverse acc) ec)
elabInstancesGo (d :: rest) classes datas globals ec acc = andThen (elabInstance globals classes datas ec d) (\p => case p of
  Pair gs ec1 => elabInstancesGo rest classes datas (append globals gs) ec1 (append gs acc)
)

-- M15：ecDefs 里那些不是源文件 DFun 的定义（接口投影、实例字典）。
-- 它们的类型从 globals 里查（投影签名 / 实例头类型都在 elabTraits/elabInstances 时入表）。
extraDefsOf : List (Pair String Term) -> Ec -> List DtDef -> List DtDef
extraDefsOf globals ec sourceDefs = extraDefsGo globals (map dtDefName sourceDefs) (ecDefs ec) []

extraDefsGo : List (Pair String Term) -> List String -> List (Pair String Term) -> List DtDef -> List DtDef
extraDefsGo globals sourceNames [] acc = reverse acc
extraDefsGo globals sourceNames (d :: rest) acc =
  if memName (firstOf d) sourceNames then extraDefsGo globals sourceNames rest acc
  else extraDefsGo globals sourceNames rest
    (DtDef (firstOf d) (defTypeOrDefault globals (firstOf d)) (secondOf d) :: acc)

defTypeOrDefault : List (Pair String Term) -> String -> Term
defTypeOrDefault globals name = case globalLookup name globals of
  Just ty => ty
  Nothing => TGlobal "Int"

-- ===============================================================
-- M16：索引擦除分析（诊断级，不改变 codegen）
-- ===============================================================
-- M13/M14 的擦除规则：binder 域是宇宙 ⇒ 擦除；域是归纳族（索引，如 `n : Nat`）⇒ **保留**运行时
-- 表示（`Vec a n` 的每个 Cons 带一个 `t_Nat` 长度字段）。
-- 索引**不能无条件擦**：`vlen a n xs = case xs of Cons b m y ys => 1 + vlen b m ys` 把索引 `m`
-- 当递归参数传下去，运行时**真的被读取**；无条件擦除会让这类定义无法生成代码。
-- 正确擦除需要整程序使用分析，M16 落地的是**分析 + 诊断**：`eraseIndexMask` 给出保守可擦判定，
-- `indexNeedsRuntime` 给出是否真的被用到。详见 `docs/dt-core.md` 的「已知限制」。
eraseIndexMask : DtData -> List Bool
eraseIndexMask dd = eraseMaskGo dd (dtDataParams dd) 0 []

eraseMaskGo : DtData -> List (Pair String Rig) -> Int -> List Bool -> List Bool
eraseMaskGo dd [] i acc = reverse acc
eraseMaskGo dd (p :: rest) i acc =
  eraseMaskGo dd rest (i + 1) (not (paramUsedInFieldTys dd i) :: acc)

paramUsedInFieldTys : DtData -> Int -> Bool
paramUsedInFieldTys dd i = usedInCtors i (length (dtDataParams dd)) (dtDataCtors dd)

usedInCtors : Int -> Int -> List DtCtor -> Bool
usedInCtors i arity [] = False
usedInCtors i arity (c :: rest) = usedInCtor i arity c || usedInCtors i arity rest

usedInCtor : Int -> Int -> DtCtor -> Bool
usedInCtor i arity c = usedInTele i arity 0 (ctorFieldTerms arity (dtCtorType c))

-- 取构造子的字段域项（跳过前 arity 个族参数/索引 binder）。
ctorFieldTerms : Int -> Term -> List Term
ctorFieldTerms arity ty = ctorFieldGo arity ty []

ctorFieldGo : Int -> Term -> List Term -> List Term
ctorFieldGo arity t acc = case t of
  TPi name implicit rig dom cod =>
    if arity > 0 then ctorFieldGo (arity - 1) cod acc else ctorFieldGo 0 cod (dom :: acc)
  _ => reverse acc

usedInTele : Int -> Int -> Int -> List Term -> Bool
usedInTele i arity k ts = usedInTeleGo (k + arity) ts

usedInTeleGo : Int -> List Term -> Bool
usedInTeleGo depth [] = False
usedInTeleGo depth (t :: rest) = termUsesVar depth t || usedInTeleGo depth rest

termUsesVar : Int -> Term -> Bool
termUsesVar depth t = case t of
  TVar n i => i == depth
  TMeta m => False
  TGlobal g => False
  TType l => False
  TPi n implicit rig dom cod => termUsesVar depth dom || termUsesVar (depth + 1) cod
  TLam n erased body => termUsesVar (depth + 1) body
  TApp f a erased => termUsesVar depth f || termUsesVar depth a
  TCon c args => termUsesVarArgs depth args
  TCase scrut alts => termUsesVar depth scrut || termUsesVarAlts depth alts
  TInt n => False
  TStr s => False
  TBool b => False
  TIf c th el => termUsesVar depth c || termUsesVar depth th || termUsesVar depth el

termUsesVarArgs : Int -> List (Pair Term Rig) -> Bool
termUsesVarArgs depth [] = False
termUsesVarArgs depth ((Pair a erased) :: rest) = termUsesVar depth a || termUsesVarArgs depth rest

termUsesVarAlts : Int -> List CaseAlt -> Bool
termUsesVarAlts depth [] = False
termUsesVarAlts depth (alt :: rest) =
  termUsesVar (depth + length (caseAltBinders alt)) (caseAltBody alt) || termUsesVarAlts depth rest

-- 诊断：返回「理论上可擦、但实际仍保留运行时表示」的族参数名表（供文档 / lint 用）。
indexErasureCandidates : List DtData -> List (Pair String (List String))
indexErasureCandidates [] = []
indexErasureCandidates (d :: rest) = candidateOf d :: indexErasureCandidates rest

candidateOf : DtData -> Pair String (List String)
candidateOf d = Pair (dtDataName d) (candidateNames (dtDataParams d) (eraseIndexMask d))

candidateNames : List (Pair String Rig) -> List Bool -> List String
candidateNames [] ms = []
candidateNames (p :: rest) [] = []
candidateNames (p :: rest) (m :: ms) = case p of
  Pair n e => if m then n :: candidateNames rest ms else candidateNames rest ms

-- ===============================================================
-- M16：终止性检查（结构化递归，surface AST）
-- ===============================================================
-- 只分析自递归函数。规则：体内每个自调用必须至少有一个实参是「对应形参的真子项」。
-- size 表：变量名 ↦ (形参下标, 深度)；形参深度 0，构造子字段继承下标、深度+1。
-- `plus a b = case a of Zero => b | Succ k => Succ (plus k b)`：k 的 size=(0,1) ⇒ 下降 ⇒ 通过。
-- `loop n = loop n`：n 的 size=(0,0) ⇒ 拒绝。
checkTerminationDecls : List Decl -> Result Int
checkTerminationDecls decls = checkTermDeclsGo (funDefsOf decls)

funDefsOf : List Decl -> List (Pair String (Pair (List Pat) Expr))
funDefsOf [] = []
funDefsOf (d :: rest) = case d of
  DFun name pats body sp => Pair name (Pair pats body) :: funDefsOf rest
  _ => funDefsOf rest

checkTermDeclsGo : List (Pair String (Pair (List Pat) Expr)) -> Result Int
checkTermDeclsGo [] = Ok 0
checkTermDeclsGo (fd :: rest) = case fd of
  Pair name (Pair pats body) =>
    if funMentions name body then andThen (checkTermOne name pats body) (\_ => checkTermDeclsGo rest)
    else checkTermDeclsGo rest

-- 体里是否出现对自身的调用（名字出现在表达式里）。
funMentions : String -> Expr -> Bool
funMentions name e = case e of
  EVar n sp => n == name
  EInt n sp => False
  EStr s sp => False
  ELam ns b sp => funMentions name b
  EApp fn args sp => funMentions name fn || funMentionsList name args
  EPi n implicit dom cod sp => funMentions name dom || funMentions name cod
  ELet binds b rec_ sp => funMentions name b
  ECase scrut alts sp => funMentions name scrut || funMentionsAlts name alts
  EIf c t el sp => funMentions name c || funMentions name t || funMentions name el
  EField base f sp => funMentions name base
  ERecord rn fields sp => funMentionsFields name fields
  ERecUpdate base fields sp => funMentions name base
  EInstSel meth iname sp => funMentions name meth
  EDo stmts sp => funMentionsStmts name stmts

funMentionsList : String -> List Expr -> Bool
funMentionsList name [] = False
funMentionsList name (e :: rest) = funMentions name e || funMentionsList name rest

funMentionsAlts : String -> List (Pair Pat Expr) -> Bool
funMentionsAlts name [] = False
funMentionsAlts name (a :: rest) = case a of
  Pair p b => funMentions name b || funMentionsAlts name rest

funMentionsFields : String -> List (Pair String Expr) -> Bool
funMentionsFields name [] = False
funMentionsFields name (f :: rest) = case f of
  Pair fn fe => funMentions name fe || funMentionsFields name rest

funMentionsStmts : String -> List DoStmt -> Bool
funMentionsStmts name [] = False
funMentionsStmts name (s :: rest) = funMentions name (doStmtExpr s) || funMentionsStmts name rest

-- 单个自递归定义。
checkTermOne : String -> List Pat -> Expr -> Result Int
checkTermOne fname pats body = checkTermBody fname (patSizeEntries pats) body

-- 顶层形参的尺寸表：递归进构造子模式，给子变量加深度（`Cons y rest` 的 `rest` → (i,1)）。
-- 这样 `mem x (Cons y rest) = ... mem x rest ...` 能证明 `rest` 严格下降。
patSizeEntries : List Pat -> List (Pair String (Pair Int Int))
patSizeEntries pats = patSizeGo pats 0

patSizeGo : List Pat -> Int -> List (Pair String (Pair Int Int))
patSizeGo [] i = []
patSizeGo (p :: rest) i = case p of
  PVar n sp => Pair n (Pair i 0) :: patSizeGo rest (i + 1)
  PWild sp => Pair "_" (Pair i 0) :: patSizeGo rest (i + 1)
  PCon cn ps sp =>
    append (Pair "_" (Pair i 0) :: subSizeEntries (Pair i 0) ps) (patSizeGo rest (i + 1))
  _ => Pair "_" (Pair i 0) :: patSizeGo rest (i + 1)

-- 遍历体：每个对 fname 的调用都必须有下降证据。
checkTermBody : String -> List (Pair String (Pair Int Int)) -> Expr -> Result Int
checkTermBody fname sizes e = case e of
  EApp fn args sp => case callIndexes fname fn args of
    Nothing => checkTermBody fname sizes fn
    Just idxs =>
      if anyDescends idxs args sizes then checkTermArgs fname sizes args
      else Err
        ("DT: cannot prove termination of " ++ fname ++ " (recursive call does not structurally decrease)")
  ECase scrut alts sp =>
    andThen (checkTermBody fname sizes scrut) (\_ => checkTermAlts fname sizes scrut alts)
  EIf c t el sp =>
    andThen (checkTermBody fname sizes c)
      (\_ => andThen (checkTermBody fname sizes t) (\_ => checkTermBody fname sizes el))
  ELam ns b sp => checkTermBody fname sizes b
  ELet binds b rec_ sp => checkTermBody fname sizes b
  _ => Ok 0

checkTermArgs : String -> List (Pair String (Pair Int Int)) -> List Expr -> Result Int
checkTermArgs fname sizes [] = Ok 0
checkTermArgs fname sizes (a :: rest) =
  andThen (checkTermBody fname sizes a) (\_ => checkTermArgs fname sizes rest)

checkTermAlts : String -> List (Pair String (Pair Int Int)) -> Expr -> List (Pair Pat Expr) -> Result Int
checkTermAlts fname sizes scrut [] = Ok 0
checkTermAlts fname sizes scrut (a :: rest) = case a of
  Pair pat body =>
    andThen (checkTermBody fname (extendSizes sizes scrut pat) body)
      (\_ => checkTermAlts fname sizes scrut rest)

-- 调用形态：`fname a1 .. an`（裸 EVar 或无实参都算，索引表给出实参位置）。
callIndexes : String -> Expr -> List Expr -> Maybe (List Int)
callIndexes fname fn args = case fn of
  EVar n sp => if n == fname then Just (rangeInt (length args)) else Nothing
  _ => Nothing

rangeInt : Int -> List Int
rangeInt n = rangeIntGo n 0

rangeIntGo : Int -> Int -> List Int
rangeIntGo n i = if i >= n then [] else i :: rangeIntGo n (i + 1)

-- 至少一个实参在其对应位置严格下降（源自同一形参、且深度 > 0）。
anyDescends : List Int -> List Expr -> List (Pair String (Pair Int Int)) -> Bool
anyDescends [] args sizes = False
anyDescends (i :: rest) args sizes = case nthExpr args i of
  Nothing => anyDescends rest args sizes
  Just a => if argDescendsAt i a sizes then True else anyDescends rest args sizes

argDescendsAt : Int -> Expr -> List (Pair String (Pair Int Int)) -> Bool
argDescendsAt i a sizes = case a of
  EVar n sp => case sizeOfVar n sizes of
    Just sz => case sz of
      Pair base depth => base == i && depth > 0
    Nothing => False
  _ => False

nthExpr : List Expr -> Int -> Maybe Expr
nthExpr [] i = Nothing
nthExpr (e :: rest) i = if i <= 0 then Just e else nthExpr rest (i - 1)

-- 把模式的绑定变量加入 size 表。
extendSizes : List (Pair String (Pair Int Int)) -> Expr -> Pat -> List (Pair String (Pair Int Int))
extendSizes sizes scrut pat = case scrut of
  EVar vname vsp => case sizeOfVar vname sizes of
    Nothing => sizes
    Just base => case pat of
      PCon cname subpats psp => append sizes (subSizeEntries base subpats)
      _ => sizes
  _ => sizes

subSizeEntries : Pair Int Int -> List Pat -> List (Pair String (Pair Int Int))
subSizeEntries base subpats = subSizeGo base subpats

subSizeGo : Pair Int Int -> List Pat -> List (Pair String (Pair Int Int))
subSizeGo base [] = []
subSizeGo base (p :: rest) = case p of
  PVar n sp => case base of
    Pair b d => Pair n (Pair b (d + 1)) :: subSizeGo base rest
  _ => subSizeGo base rest

sizeOfVar : String -> List (Pair String (Pair Int Int)) -> Maybe (Pair Int Int)
sizeOfVar name [] = Nothing
sizeOfVar name (s :: rest) = case s of
  Pair n sz => if n == name then Just sz else sizeOfVar name rest

-- M15：未解元变量若来自洞，报洞的目标（而不是光秃秃的编号）。
unsolvedMessage : Ec -> Int -> String
unsolvedMessage ec m = case findGoal m (ecGoals ec) of
  Just g =>
    "DT: unsolved hole "
      ++ showSpanLoc (dtGoalSpan g)
      ++ " with goal "
      ++ showValueAt (ctxDepthOf g) (dtGoalType g)
  Nothing => "DT: unsolved metavariable ?" ++ strFromInt m

-- 洞目标里的类型是 level 形态，show 时深度取快照上下文的长度。
ctxDepthOf : DtGoal -> Int
ctxDepthOf g = length (dtGoalCtx g)

findGoal : Int -> List DtGoal -> Maybe DtGoal
findGoal m [] = Nothing
findGoal m (g :: rest) = if dtGoalMeta g == m then Just g else findGoal m rest

-- M15：面向工具链的洞目标查询（LSP / `vuna goal` 用）。
data DtGoalInfo : Type where
  DtGoalInfo : Span -> String -> List (Pair String String) -> DtGoalInfo

dtGoalInfoSpan (DtGoalInfo sp goal ctx) = sp

dtGoalInfoGoal (DtGoalInfo sp goal ctx) = goal

dtGoalInfoCtx (DtGoalInfo sp goal ctx) = ctx

goalInfoOf : List (Pair Int Value) -> DtGoal -> DtGoalInfo
goalInfoOf sols g =
  DtGoalInfo (dtGoalSpan g) (showValueAt (ctxDepthOf g) (zonkGoal sols (dtGoalType g)))
    (ctxEntriesOf (dtGoalCtx g))

-- 洞目标里的类型可能仍含已解元变量：用当前解表 force 一遍再 show。
zonkGoal : List (Pair Int Value) -> Value -> Value
zonkGoal sols v = force [] sols defaultFuel v

-- 上下文条目（名字 + 类型）用于显示：类型项按快照深度用中性环境求值后 show。
ctxEntriesOf : List (Pair String Term) -> List (Pair String String)
ctxEntriesOf items = ctxEntriesAt items 0 (length items)

ctxEntriesAt : List (Pair String Term) -> Int -> Int -> List (Pair String String)
ctxEntriesAt [] idx depth = []
ctxEntriesAt ((Pair name ty) :: rest) idx depth =
  Pair name (showValueAt depth (eval (ctxEnvAt (Pair name ty :: rest) 0 depth) (shift 0 (idx + 1) ty)))
    :: ctxEntriesAt rest (idx + 1) depth

goalsOfProgram : List Decl -> Result (List DtGoalInfo)
goalsOfProgram decls =
  andThen (elabProgramFull decls)
    (\prog => Ok (map (goalInfoOf (dtProgSols prog)) (dtProgGoals prog)))

elabProgram : List Decl -> Result (Pair (List DtData) (List DtDef))
elabProgram decls =
  andThen (elabProgramFull decls) (\prog => Ok (Pair (dtProgDatas prog) (dtProgDefs prog)))

-- ---------------------------------------------------------------
-- 定义：签名 + 变量模式 → lambda 化的体
-- ---------------------------------------------------------------
checkDef : List (Pair String Term) -> Ec -> List Pat -> Expr -> Value -> Span -> Result (Pair Term Ec)
checkDef globals ec pats body expected sp = checkBinders globals emptyCtx ec pats body expected sp

checkBinders : List (Pair String Term) -> Ctx -> Ec -> List Pat -> Expr -> Value -> Span -> Result (Pair Term Ec)
checkBinders globals ctx ec [] body expected sp =
  let
    forced = forceVal ec expected
  in case forced of
    VPi name implicit rig dom clo =>
      if implicit then if isIndexDomain ec dom then bindIndexBinder globals ctx ec name dom clo [] body sp
      else errAt sp "DT: implicit parameters must be types or inductive families (M14)"
      else checkBodyAtEnd globals ctx ec body expected sp
    _ => checkE globals ctx ec body expected

-- 隐式索引 binder（`{n : Nat}`）：绑成擦除的 lambda（Rig0），体在扩展上下文里继续。
bindIndexBinder : List (Pair String Term) -> Ctx -> Ec -> String -> Value -> Closure -> List Pat -> Expr -> Span -> Result (Pair Term Ec)
bindIndexBinder globals ctx ec name dom clo pats body sp =
  let
    lvl = ctxDepth ctx
    v = freshVarValue name lvl
    ctx2 = ctxBindValue name dom ctx
    expected2 = applyClosure clo v
  in andThen (checkBinders globals ctx2 ec pats body expected2 sp) (\p => case p of
    Pair inner ec1 => Ok (Pair (TLam name Rig0 inner) ec1)
  )

-- 模式用完后仍剩显式 Pi：body 是 lambda 时按 check 处理，否则是参数个数不足。
checkBodyAtEnd : List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Span -> Result (Pair Term Ec)
checkBodyAtEnd globals ctx ec body expected sp = case body of
  ELam names lambdaBody lambdaSp => checkE globals ctx ec body expected
  _ => errAt sp "DT: definition has fewer parameters than its signature"

checkBinders globals ctx ec (pat :: rest) body expected sp =
  let
    forced = forceVal ec expected
  in case forced of
    VPi name implicit rig dom clo => if implicit then if isIndexDomain ec dom then bindIndexBinder globals ctx ec name dom clo (pat :: rest) body sp
    else errAt sp "DT: implicit parameters must be types or inductive families (M14)"
    else case pat of
      PVar pname psp => bindOnePattern globals ctx ec pname rest body dom clo sp
      PWild psp => bindOnePattern globals ctx ec "_" rest body dom clo sp
      _ => errAt (patSpan pat) "DT: definition parameters must be variables (M13)"
    _ => errAt sp "DT: definition has more parameters than its signature"

bindOnePattern : List (Pair String Term) -> Ctx -> Ec -> String -> List Pat -> Expr -> Value -> Closure -> Span -> Result (Pair Term Ec)
bindOnePattern globals ctx ec pname pats body dom clo sp =
  let
    lvl = ctxDepth ctx
    v = freshVarValue pname lvl
    ctx2 = ctxBindValue pname dom ctx
    erasure = typeLayerRig False dom
  in andThen (checkBinders globals ctx2 ec pats body (applyClosure clo v) sp) (\p => case p of
    Pair inner ec1 => Ok (Pair (TLam pname erasure inner) ec1)
  )

-- M14：隐式 binder 的域可以是：宇宙、已声明归纳族（`{n : Nat}` 这类索引），或**高阶 kind**
-- （`{f : Type -> Type}`，M19 起 `trait Mapper f` 需要）。其它类型（Int/String/…）仍
-- 拒绝：隐式实参不参与运行时计算。
isIndexDomain : Ec -> Value -> Bool
isIndexDomain ec dom =
  isTypeValue dom || isTypeLayerValue dom || isDataHead (ecDatas ec) (forceVal ec dom)

-- ---------------------------------------------------------------
-- 擦除判据（M18.5：全仓唯一入口）
-- ---------------------------------------------------------------
-- 规则：**只有域是宇宙（`Type`）的 binder 才擦除**；隐式 binder 恒擦除（精化器插入隐式实参，
-- 运行时不传）。索引（`{n : Nat}` 这类归纳族域）**保留运行时表示**——它们可能被当成递归参数
-- 读回来（见 `vlen`），安全擦除需要整程序使用分析（M22）。
-- 这个词是全仓唯一判据：`teleOf` / `checkBinders` / `bindOnePattern` / `checkLam` / `inferArgs` /
-- `bindCtorBinder` 六处都必须走它，否则「字段数 / telescope 长度 / 绑定数」三处各自漂移。
binderRig : Bool -> Value -> Rig
binderRig implicit dom = rigOfBinder implicit (isTypeValue dom)

-- 域在「类型层」（M19）：宇宙，或**域全是宇宙的 Pi 链**（`Type -> Type` 这类高阶 kind）。
-- 用于**实参**与**定义参数**的 multiplicity——`applyTwice Box ...` 里的 `Box` 是类型
-- 构造器，必须擦除，否则 codegen 报「type-level name is used at runtime」。
--
-- 判据必须是递归的：值层函数类型 `a -> b` 也是 Pi，但它的域是**类型变量**（不是宇宙），
-- 因此不被误判为类型层（否则函数参数会被擦掉，`03_compose` / `04_apply` 直接崩）。
typeLayerRig : Bool -> Value -> Rig
typeLayerRig implicit dom = if implicit then Rig0 else if isTypeLayerValue dom then Rig0 else Rig1

isTypeLayerValue : Value -> Bool
isTypeLayerValue v = case v of
  VType l => True
  VPi pname implicit rig dom clo =>
    isTypeLayerValue dom && isTypeLayerValue (applyClosure clo (VNeutral (NVar pname 0 [])))
  _ => False

isDataHead : List DtData -> Value -> Bool
isDataHead datas v = case v of
  VNeutral n => case n of
    NGlobal g sp => case dtDataLookup g datas of
      Just _ => True
      Nothing => False
    _ => False
  _ => False

freshVarValue : String -> Int -> Value
freshVarValue name level = VNeutral (NVar name level [])

-- M19：case 出现在推断位置（函数实参、if 分支、let 的 value）。做法是建一个元变量当
-- 期望类型，再按检查模式处理 case——分支逐个 check 会把期望写进这个元变量。
inferCaseE : List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair Pat Expr) -> Span -> Result (Pair Term (Pair Value Ec))
inferCaseE globals ctx ec scrut alts sp =
  let
    pmeta = newMeta ctx ec
  in case pmeta of
    Pair metaTerm ec1 =>
      let
        metaTy = evalCtx ctx metaTerm
      in andThen (checkCase globals ctx ec1 scrut alts metaTy sp) (\p => case p of
        Pair term ec2 => Ok (Pair term (Pair metaTy ec2))
      )

-- ---------------------------------------------------------------
-- 双向检查
-- ---------------------------------------------------------------
-- `if` 条件 / `Bool` 判定：`Bool` 既可以是 prelude 桩（`NGlobal "Bool"`）也可以是
-- `Base.Bool.Bool`（真实布尔），二者都要视为布尔类型（否则 `Base.List.filter` 的
-- `if p x` 会报 expected Bool, got Base.Bool.Bool）。
isBoolType : Value -> Bool
isBoolType v = case v of
  VNeutral n => isBoolGlobal (neutralHeadName n)
  _ => False

neutralHeadName : Neutral -> String
neutralHeadName n = case n of
  NVar name _ _ => name
  NGlobal name _ => name

isBoolGlobal : String -> Bool
isBoolGlobal name = case splitLastDot (splitOnDot name) of
  Pair rev base => base == "Bool"

-- 名字既是构造子又是数据类型（如 `data Pair a b where Pair : a -> b -> Pair a b`）：
-- 在类型位置（expected 是宇宙）应走 `checkAppGeneral`，值位置走 `checkAppCtor`。
isSortVal : Ec -> Value -> Bool
isSortVal ec v = case forceVal ec v of
  VType _ => True
  _ => False

-- `if` 条件：先按 prelude `Bool` 检查——保住 `==`/`/=` 的 Int/String **特化**
-- （推断位会把隐式类型实参留在 spine 上，运行时的 primReduce 归约不了）；失败再按
-- 推断收下真实 `Base.Bool.Bool` 条件（`Base.List.filter` 的 `if p x`）。
checkCondBool : List (Pair String Term) -> Ctx -> Ec -> Expr -> Span -> Result (Pair Term Ec)
checkCondBool globals ctx ec c sp = case checkE globals ctx ec c (VNeutral (NGlobal "Bool" [])) of
  Ok pc => Ok pc
  Err _ => andThen (inferE globals ctx ec c) (\pc => case pc of
    Pair cTerm (Pair cTy ec1) =>
      if isBoolType cTy then Ok (Pair cTerm ec1)
      else errAt sp ("if condition must be Bool (got " ++ showValueAt (ctxDepth ctx) cTy ++ ")")
  )

-- 变量解析顺序：局部上下文 → 本程序的数据构造子 → 全局签名。构造子必须排在全局之前：
-- `True`/`False` 与 prelude 桩同名（`preludeGlobals` 里有 `True : Bool`），先查全局会拿到
-- 桩类型，与 `Base.Bool.Bool` 注解对不上。
inferVarRef : List (Pair String Term) -> Ctx -> Ec -> String -> Span -> Result (Pair Term (Pair Value Ec))
inferVarRef globals ctx ec name sp = case ctxLookup name ctx of
  Just (Pair idx tyTerm) => Ok (Pair (TVar name idx) (Pair (varTypeValue ctx idx tyTerm) ec))
  Nothing => case dtCtorLookup name (ecDatas ec) of
    Just ctor => inferCtorRef ec ctx name (dtCtorType ctor)
    -- M22.2：`Bool` 是族短名。程序里真有 `data Bool` 时按实际族名解析（内建 trait
    -- 声明/内建实例的 AST 仍写裸 `Bool`，它们不经过 Loader）；没有声明时退回
    -- prelude 里的 `Bool` 类型别名（只服务内建 trait 签名，用户代码走 Loader 解析）。
    Nothing => case shortBoolFamily ec name of
      Just fam => Ok (Pair (TGlobal fam) (Pair (VType levelZero) ec))
      Nothing => case globalLookup name globals of
        Just tyTerm => Ok (Pair (ctorRefTerm (ecDatas ec) name) (Pair (eval [] tyTerm) ec))
        Nothing => errAt sp ("DT: unknown name " ++ name)

inferE : List (Pair String Term) -> Ctx -> Ec -> Expr -> Result (Pair Term (Pair Value Ec))
inferE globals ctx ec expr = case expr of
  EVar name sp =>
    if name == "Type" then Ok (Pair (TType levelZero) (Pair (VType (levelSucc levelZero)) ec))
    else if name == "_" then errAt sp "DT: cannot infer the type of a hole; give it an expected type"
    else inferVarRef globals ctx ec name sp
  EInt n sp => Ok (Pair (TInt n) (Pair (VNeutral (NGlobal "Int" [])) ec))
  EStr s sp => Ok (Pair (TStr s) (Pair (VNeutral (NGlobal "String" [])) ec))
  EPi name implicit dom cod sp => inferPi globals ctx ec name implicit dom cod sp
  EApp fn args sp => inferApp globals ctx ec fn args sp
  ELam names body sp => errAt sp "DT: cannot infer the type of a lambda; add a signature"
  EIf c t e sp => andThen (checkCondBool globals ctx ec c sp) (\pc => case pc of
    Pair cTerm ec1 => andThen (inferE globals ctx ec1 t) (\pt => case pt of
      Pair tTerm (Pair tTy ec2) => andThen (inferE globals ctx ec2 e) (\pe => case pe of
        Pair eTerm (Pair eTy ec3) =>
          andThen (convEc ec3 (ctxDepth ctx) tTy eTy)
            (\ec4 => Ok (Pair (TIf cTerm tTerm eTerm) (Pair tTy ec4)))
      )
    )
  )
  ELet binds body rec_ sp => inferLet globals ctx ec binds body rec_ sp
  ECase scrut alts sp => inferCaseE globals ctx ec scrut alts sp
  EField base fname sp => errAt sp "DT: record field access is not supported yet (M15)"
  ERecord rname fields sp => errAt sp "DT: records are not supported yet (M15)"
  ERecUpdate base fields sp => errAt sp "DT: record update is not supported yet (M15)"
  EInstSel meth iname sp => errAt sp "DT: instance selection is not supported yet (M15)"
  EDo stmts sp => errAt sp "DT: do blocks are not supported yet (M19)"

inferPi : List (Pair String Term) -> Ctx -> Ec -> String -> Bool -> Expr -> Expr -> Span -> Result (Pair Term (Pair Value Ec))
inferPi globals ctx ec name implicit dom cod sp = andThen (checkType globals ctx ec dom) (\pd => case pd of
  Pair domTerm (Pair domSort ec1) =>
    let
      lvl = ctxDepth ctx
      ctx2 = ctxBind name domTerm ctx
    in andThen (checkType globals ctx2 ec1 cod) (\pc => case pc of
      Pair codTerm (Pair codSort ec2) =>
        Ok
          (Pair (TPi name implicit (binderRig implicit (eval [] domTerm)) domTerm codTerm) (Pair (VType (levelMax domSort codSort)) ec2))
    )
)

-- 应用：逐个消费显式实参，遇到隐式 Pi 先插入元变量。
inferApp : List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Span -> Result (Pair Term (Pair Value Ec))
inferApp globals ctx ec fn args sp = case fn of
  EVar "->" _ => case args of
    [a, b] => inferPi globals ctx ec "_" False a b sp
    _ => errAt sp "DT: invalid arrow type"
  EVar "Type" tsp => case args of
    [EInt n nsp] =>
      if n < 0 then errAt nsp "DT: universe level must be non-negative"
      else Ok (Pair (TType (levelOfInt n)) (Pair (VType (levelSucc (levelOfInt n))) ec))
    _ => errAt tsp "DT: Type needs exactly one non-negative level (or none)"
  _ => case fn of
    EVar name vsp => case ctxLookup name ctx of
      Just _ => inferAppGeneral globals ctx ec fn args sp
      Nothing => case globalLookup name globals of
        Just tyTerm => andThen (inferArgs globals ctx ec (eval [] tyTerm) args sp) (\pa => case pa of
          Pair argTerms (Pair resTy ec2) =>
            Ok (Pair (ctorAppTerm (ecDatas ec2) (TGlobal name) argTerms) (Pair resTy ec2))
        )
        Nothing => errAt vsp ("DT: unknown name " ++ name)
    _ => inferAppGeneral globals ctx ec fn args sp

inferAppGeneral : List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Span -> Result (Pair Term (Pair Value Ec))
inferAppGeneral globals ctx ec fn args sp = case fn of
  EVar name vsp => andThen (specializeOpApp globals ctx ec name args sp) (\mspec => case mspec of
    Just pair => Ok pair
    Nothing => inferAppGeneralGo globals ctx ec fn args sp
  )
  _ => inferAppGeneralGo globals ctx ec fn args sp

inferAppGeneralGo : List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Span -> Result (Pair Term (Pair Value Ec))
inferAppGeneralGo globals ctx ec fn args sp = andThen (inferE globals ctx ec fn) (\pf => case pf of
  Pair fnTerm (Pair fnTy ec1) => andThen (inferArgs globals ctx ec1 fnTy args sp) (\pa => case pa of
    Pair argTerms (Pair resTy ec2) =>
      Ok (Pair (ctorAppTerm (ecDatas ec2) fnTerm argTerms) (Pair resTy ec2))
  )
)

-- 引用一个名字：零参构造子必须直接是 TCon（否则求值器给不出 VCon，case 命不中）。
ctorRefTerm : List DtData -> String -> Term
ctorRefTerm datas name = case dtCtorLookup name datas of
  Just ctor =>
    if isBoolBaseName (dtCtorFamily ctor) then boolCtorTerm name
    else if dtCtorTelescope ctor == [] then TCon name [] else TGlobal name
  Nothing => TGlobal name

-- 构造子应用必须饱和成 TCon，求值器才能给 case 造出 VCon（中性 NGlobal 命不中分支）。
-- 未饱和的部分应用（柯里化）保持 TApp：此时 case 会卡住，与 HM 语义一致。
ctorAppTerm : List DtData -> Term -> List (Pair Term Rig) -> Term
ctorAppTerm datas (TGlobal g) args = case dtCtorLookup g datas of
  Just ctor =>
    if isBoolBaseName (dtCtorFamily ctor) then boolCtorTerm g
    else if length args >= length (dtCtorTelescope ctor) then TCon g args
    else foldAppTerms (TGlobal g) args
  Nothing => foldAppTerms (TGlobal g) args
ctorAppTerm datas fn args = foldAppTerms fn args

foldAppTerms : Term -> List (Pair Term Rig) -> Term
foldAppTerms fn [] = fn
foldAppTerms fn ((Pair arg erased) :: rest) = foldAppTerms (TApp fn arg erased) rest

inferArgs : List (Pair String Term) -> Ctx -> Ec -> Value -> List Expr -> Span -> Result (Pair (List (Pair Term Rig)) (Pair Value Ec))
inferArgs globals ctx ec ty args sp = inferArgsGo globals ctx ec ty args sp

inferArgsGo : List (Pair String Term) -> Ctx -> Ec -> Value -> List Expr -> Span -> Result (Pair (List (Pair Term Rig)) (Pair Value Ec))
inferArgsGo globals ctx ec ty args sp =
  let
    forced = forceVal ec ty
  in case forced of
    VPi name implicit rig dom clo => if implicit then if isDictDomain ec dom then if dictArgUnsolvedMeta ec dom then deferDictBinder globals ctx ec dom clo args sp
    else andThen (constrainDictDom globals ec ctx dom args sp) (\ec0 => case searchInstance ec0 (forceVal ec0 dom) sp of
      Ok (Pair instTerm ec1) =>
        let
          ty2 = applyClosure clo (evalCtx ctx instTerm)
        in andThen (inferArgsGo globals ctx ec1 ty2 args sp) (\q => case q of
          Pair argTerms (Pair resTy ec2) =>
            Ok (Pair (Pair instTerm Rig1 :: argTerms) (Pair resTy ec2))
        )
      Err e =>
        if hasUnsolvedMetaValue (ecSols ec0) (forceVal ec0 dom) then deferDictBinder globals ctx ec0 dom clo args sp
        else Err e
    )
    else if isIndexDomain ec dom then case newMeta ctx ec of
      Pair metaTerm ec1 => andThen (inferArgsGo globals ctx ec1 (applyClosure clo (eval (ctxEnv ctx) metaTerm)) args sp) (\p => case p of
        Pair argTerms (Pair resTy ec2) =>
          Ok (Pair (Pair metaTerm Rig0 :: argTerms) (Pair resTy ec2))
      )
    else errAt sp "DT: implicit parameters must be types or inductive families (M15)"
    else case args of
      [] => Ok (Pair [] (Pair forced ec))
      a :: rest => andThen (checkE globals ctx ec a dom) (\p => case p of
        Pair aTerm ec1 => andThen (inferArgsGo globals ctx ec1 (applyClosure clo (evalCtx ctx aTerm)) rest sp) (\q => case q of
          Pair argTerms (Pair resTy ec2) =>
            Ok (Pair (Pair aTerm (typeLayerRig False dom) :: argTerms) (Pair resTy ec2))
        )
      )
    _ => case args of
      [] => Ok (Pair [] (Pair forced ec))
      a :: rest => errAt (exprSpan a) "DT: too many arguments (not a function)"

-- 类参数未解且无唯一实例：延迟成裸元变量 + 字典目标，等 `?a` 被实参/结果类型解出来后
-- 由 `resolveDictGoals` 回填（`mem` 的刚性 `a` 也走这里）。抽成函数是为了在
-- 「类参数还是未解元变量」时**跳过实例搜索**——否则会被第一个内建实例提前定死。
deferDictBinder : List (Pair String Term) -> Ctx -> Ec -> Value -> Closure -> List Expr -> Span -> Result (Pair (List (Pair Term Rig)) (Pair Value Ec))
deferDictBinder globals ctx ec dom clo args sp =
  let
    m = ecNext ec
  in case newMeta ctx ec of
    Pair metaTerm ec1 => andThen (inferArgsGo globals ctx (ecAddDictGoal ec1 (DtDictGoal m (forceVal ec1 dom))) (applyClosure clo (eval (ctxEnv ctx) metaTerm)) args sp) (\p => case p of
      Pair argTerms (Pair resTy ec2) => Ok (Pair (Pair metaTerm Rig1 :: argTerms) (Pair resTy ec2))
    )

isDictDomain : Ec -> Value -> Bool
isDictDomain ec dom = isDictValue ec (forceVal ec dom)

isDictValue : Ec -> Value -> Bool
isDictValue ec v = case v of
  VNeutral n => case n of
    NGlobal g sp => isDictFamily ec g
    _ => False
  _ => False

isDictFamily : Ec -> String -> Bool
isDictFamily ec g = memName g (map (\c => dictTypeName (dtClassName c)) (ecClasses ec))

-- 实例搜索：找头能统一到目标字典类型的实例。零个 ⇒ 报缺失，多个 ⇒ 报歧义。
searchInstance : Ec -> Value -> Span -> Result (Pair Term Ec)
searchInstance ec dom sp = case filterInstances ec dom (ecInsts ec) (ecSols ec) of
  Pair [] sols => errAt sp ("DT: no instance found for " ++ showValue dom)
  Pair ([i]) sols => Ok (Pair (TGlobal (dtInstName i)) (ecPutSols ec sols))
  Pair cands sols =>
    errAt sp
      ("DT: ambiguous instance for " ++ showValue dom ++ " (candidates: " ++ joinInstNames cands ++ ")")

-- M22：回填延迟的字典元变量。每个 `DtDictGoal m dom`：类参数已解（非元变量）且能搜到
-- 唯一实例时解 `?m = <实例>`；仍未解或仍歧义则留到下一轮（幂等，可反复调用）。
resolveDictGoals : List (Pair String Term) -> Ec -> Ec
resolveDictGoals globals ec = case ecDictGoals ec of
  [] => ec
  (DtDictGoal m dom) :: rest =>
    let
      ec1 = ecPutDictGoals ec rest
      forced = forceVal ec1 dom
      keep = ecAddDictGoal (resolveDictGoals globals ec1) (DtDictGoal m forced)
    in case dictClassArg ec1 forced of
      Just argTy => if hasUnsolvedMetaValue (ecSols ec1) argTy then keep
      else case searchInstance ec1 forced (Span "" 0 0 0 0) of
        Ok (Pair instTerm ec2) => case solveMeta (ecDefs ec2) (ecSols ec2) 0 m [] (eval [] instTerm) of
          Ok sols2 => resolveDictGoals globals (ecPutSols ec2 sols2)
          Err e => keep
        Err e => keep
      Nothing => keep

-- M22：把「已解且闭」的元变量在项里替换成其实例项（`TMeta m` → `quote 0` 的解）。
-- 字典元变量是运行时实参（Rig1），codegen 会对残留的 `TMeta` 报错；只有擦除的
-- 类型/索引元变量（Rig0）可留在项里。字典解（实例构造子）是闭的，`quote 0` 安全；
-- 带自由变量（非闭）的解跳过——它们只可能是擦除元变量，codegen 跳过。
substDictTerm : Ec -> Term -> Term
substDictTerm ec t = substSolvedMetas (ecSols ec) t

-- 实例表筛选（M22）：接受**可新增解**的头匹配——`Dict_C ?a`（`?a` 未解）与实例头
-- `Dict_C IO` 统一会解出 `?a = IO`，这正是「约束求解」：字典约束本身确定类参数。
-- 每个候选都对照**同一份初始 sols** 试匹配（不把前一个候选的解带进下一个），
-- 否则 `?a` 被第一个候选定死，第二个候选永远匹配不上、歧义漏检。
filterInstances : Ec -> Value -> List DtInst -> List (Pair Int Value) -> Pair (List DtInst) (List (Pair Int Value))
filterInstances ec dom [] sols = Pair [] sols
filterInstances ec dom (i :: rest) sols =
  let
    hd = forceVal ec (eval [] (dtInstHead i))
  in case conv (ecDefs ec) sols 0 dom hd of
    Err e => filterInstances ec dom rest sols
    Ok sols2 => case filterInstances ec dom rest sols of
      Pair more final => Pair (i :: more) sols2

joinInstNames : List DtInst -> String
joinInstNames [] = ""
joinInstNames (i :: rest) = dtInstName i ++ joinRestInstNames rest

joinRestInstNames : List DtInst -> String
joinRestInstNames [] = ""
joinRestInstNames (i :: rest) = ", " ++ dtInstName i ++ joinRestInstNames rest

-- 用后续显式实参约束 `Dict_C ?a` 里的类参数。M22：先取字典族的**类参数 kind**，
-- 实参头部与它 kind 不匹配（`Monad ?m` 被 `41 : Int` 解成 `?m = Int`）或头部不是
-- 具体构造子（`?m' Int`）就不约束——类参数由字典实例 / 结果类型决定。
constrainDictDom : List (Pair String Term) -> Ec -> Ctx -> Value -> List Expr -> Span -> Result Ec
constrainDictDom globals ec ctx dom args sp = case dictClassArg ec dom of
  Nothing => Ok ec
  Just argTy => case dictArgKind ec dom of
    Nothing => Ok ec
    Just argKind => case argTy of
      -- 类参数是裸元变量：在**副本**上推断显式实参以确定它（`MkB` → `?a = B`），
      -- 但只把 `?a` 的解带回真实 ec，`inferE` 新建的孤儿元变量随副本丢弃——
      -- 否则 `bind (pure 41)` 的 `pure` 类参数（`?3`）会变成未解孤儿报 M13。
      VMeta a [] => andThen (constrainDictDomGoK globals ec ctx argTy argKind args sp) (\ecProbe => case metaLookup a (ecSols ecProbe) of
        Just v => case solveMeta (ecDefs ec) (ecSols ec) 0 a [] v of
          Ok sols2 => Ok (ecPutSols ec sols2)
          Err e => Ok ec
        Nothing => Ok ec
      )
      _ => constrainDictDomGoK globals ec ctx argTy argKind args sp

-- 字典族的类参数 kind：字典 data `Dict_C` 的构造子类型第一个 binder 的域
-- （`MkDict_C : {p : K} -> <字段>` 里的 `K`）。
dictArgKind : Ec -> Value -> Maybe Value
dictArgKind ec dom = case dictFamilyNameOf ec dom of
  Nothing => Nothing
  Just fam => case dtDataLookup fam (ecDatas ec) of
    Nothing => Nothing
    Just dd => case dtDataCtors dd of
      [] => Nothing
      c :: _ => case forceVal ec (eval [] (dtCtorType c)) of
        VPi name implicit rig domK clo => Just domK
        _ => Nothing

dictFamilyNameOf : Ec -> Value -> Maybe String
dictFamilyNameOf ec dom = case forceVal ec dom of
  VNeutral (NGlobal g sp) => Just g
  _ => Nothing

constrainDictDomGoK : List (Pair String Term) -> Ec -> Ctx -> Value -> Value -> List Expr -> Span -> Result Ec
constrainDictDomGoK globals ec ctx argTy argKind args sp = case args of
  [] => Ok ec
  a :: rest => case inferE globals ctx ec a of
    Err e => Ok ec
    Ok (Pair aTerm (Pair aTy ec1)) =>
      let
        forced = forceVal ec1 aTy
      in if isTypeValue forced then constrainDictDomGoK globals ec1 ctx argTy argKind rest sp
      else if argHeadMatchesKind globals ec1 ctx forced argKind then case convEc ec1 (ctxDepth ctx) argTy (neutralHeadOrSelf forced) of
        Ok ec2 => Ok ec2
        Err e => constrainDictDomGoK globals ec1 ctx argTy argKind rest sp
      else constrainDictDomGoK globals ec1 ctx argTy argKind rest sp

-- 实参头部 `g` 的 kind 与类参数 kind 一致（`Color` 对 `Show`，`IO` 对 `Monad`）才约束。
-- 头部是元变量（`?m' Int`）或 Pi 都不是具体构造子 ⇒ 不约束。
argHeadMatchesKind : List (Pair String Term) -> Ec -> Ctx -> Value -> Value -> Bool
argHeadMatchesKind globals ec ctx forced argKind = case neutralHeadOrSelf forced of
  VNeutral (NGlobal g []) => case globalLookup g globals of
    Just dictSig => case convEc ec (ctxDepth ctx) argKind (forceVal ec (eval [] dictSig)) of
      Ok ec2 => True
      Err e => False
    Nothing => True
  _ => False

-- 中性应用的头部（`Box Int` ⇒ `Box`）；非应用原样返回。
neutralHeadOrSelf : Value -> Value
neutralHeadOrSelf v = case v of
  VNeutral (NGlobal g (_ :: _)) => VNeutral (NGlobal g [])
  _ => v

dictClassArg : Ec -> Value -> Maybe Value
dictClassArg ec dom = case forceVal ec dom of
  VNeutral (NGlobal g ([arg])) => Just arg
  _ => Nothing

-- 字典域类参数是不是定义体的刚性变量（绑定于当前定义类型，无实例可搜）。
-- `mem` 的 `Dict_Eq a` 走这里；具体类型（`NGlobal`）与元变量不在此列。
isRigidDictArg : Ec -> Value -> Bool
isRigidDictArg ec dom = case dictClassArg ec dom of
  Just arg => case forceVal ec arg of
    VNeutral n => case n of
      NVar name lvl sp => True
      _ => False
    _ => False
  Nothing => False

checkE : List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Result (Pair Term Ec)
checkE globals ctx ec expr expected = case expr of
  EVar name sp => if name == "_" then
    let
      pmeta = newHoleMeta ctx ec sp expected
    in case pmeta of
      Pair metaTerm ec1 => Ok (Pair metaTerm ec1)
  else checkApp globals ctx ec (EVar name sp) [] expected sp
  EInt n sp => checkByInfer globals ctx ec expr expected
  EStr s sp => checkByInfer globals ctx ec expr expected
  ELam names body sp => checkLam globals ctx ec names body expected sp
  EApp (EVar "->" _) args sp => checkByInfer globals ctx ec expr expected
  EApp (EVar "Type" _) args sp => checkByInfer globals ctx ec expr expected
  EApp fn args sp => checkApp globals ctx ec fn args expected sp
  EPi name implicit dom cod sp => checkByInfer globals ctx ec expr expected
  EIf c t e sp => checkByInfer globals ctx ec expr expected
  ECase scrut alts csp => checkCase globals ctx ec scrut alts expected csp
  ELet binds body rec_ sp => checkLet globals ctx ec binds body rec_ expected sp
  _ => checkByInfer globals ctx ec expr expected

-- ---------------------------------------------------------------
-- M19：`let` 表达式
-- ---------------------------------------------------------------
-- 逐条处理：推断绑定值 → 上下文绑名 → 处理后续与 body → `(\x => body) value`（beta 等价）。
-- 不引入 `TLet`（`let` 是纯记法，不是类型论构造）；`rig` 由绑定值类型经 `binderRig` 决定，
-- 与函数参数自动一致。后续绑定可见前面（顺序 let），不互递归；构造子模式 let 等价 case。
checkLet : List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> Expr -> Bool -> Value -> Span -> Result (Pair Term Ec)
checkLet globals ctx ec binds body rec_ expected sp =
  checkLetGo globals ctx ec binds body rec_ expected sp

checkLetGo : List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> Expr -> Bool -> Value -> Span -> Result (Pair Term Ec)
checkLetGo globals ctx ec [] body rec_ expected sp = checkE globals ctx ec body expected
checkLetGo globals ctx ec (bind :: rest) body rec_ expected sp =
  checkLetOne globals ctx ec bind rest body rec_ expected sp

checkLetOne : List (Pair String Term) -> Ctx -> Ec -> Pair Pat Expr -> List (Pair Pat Expr) -> Expr -> Bool -> Value -> Span -> Result (Pair Term Ec)
checkLetOne globals ctx ec bind rest body rec_ expected sp = case firstOf bind of
  PVar name psp =>
    let
      value = secondOf bind
    in andThen (inferE globals ctx ec value) (\pv => case pv of
      Pair valueTerm (Pair valueTy ec1) =>
        let
          rig = binderRig False valueTy
          ctx2 = ctxBindValue name valueTy ctx
        in andThen (checkLetGo globals ctx2 ec1 rest body rec_ expected sp) (\pb => case pb of
          Pair bodyTerm ec2 => Ok (Pair (TApp (TLam name rig bodyTerm) valueTerm rig) ec2)
        )
    )
  PWild psp =>
    let
      value = secondOf bind
    in andThen (inferE globals ctx ec value) (\pv => case pv of
      Pair valueTerm (Pair valueTy ec1) =>
        let
          rig = binderRig False valueTy
        in andThen (checkLetGo globals ctx ec1 rest body rec_ expected sp) (\pb => case pb of
          Pair bodyTerm ec2 => Ok (Pair (TApp (TLam "_" rig bodyTerm) valueTerm rig) ec2)
        )
    )
  _ => errAt (patSpan (firstOf bind)) "DT: let bindings must be simple names or wildcards (M19)"

-- M19：推断位的 `let`（嵌套 let 的 value 位置就是推断位）。
inferLet : List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> Expr -> Bool -> Span -> Result (Pair Term (Pair Value Ec))
inferLet globals ctx ec binds body rec_ sp = case binds of
  [] => inferE globals ctx ec body
  (Pair pat value) :: rest => case pat of
    PVar name psp => inferLetBound globals ctx ec name value rest body rec_ sp
    PWild psp => inferLetIgnored globals ctx ec value rest body rec_ sp
    _ => errAt (patSpan pat) "DT: let bindings must be simple names or wildcards (M19)"

inferLetBound : List (Pair String Term) -> Ctx -> Ec -> String -> Expr -> List (Pair Pat Expr) -> Expr -> Bool -> Span -> Result (Pair Term (Pair Value Ec))
inferLetBound globals ctx ec name value rest body rec_ sp = andThen (inferE globals ctx ec value) (\pv => case pv of
  Pair valueTerm (Pair valueTy ec1) =>
    let
      rig = binderRig False valueTy
      ctx2 = ctxBindValue name valueTy ctx
    in andThen (inferLet globals ctx2 ec1 rest body rec_ sp) (\pb => case pb of
      Pair bodyTerm (Pair bodyTy ec2) =>
        Ok (Pair (TApp (TLam name rig bodyTerm) valueTerm rig) (Pair bodyTy ec2))
    )
)

inferLetIgnored : List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair Pat Expr) -> Expr -> Bool -> Span -> Result (Pair Term (Pair Value Ec))
inferLetIgnored globals ctx ec value rest body rec_ sp = andThen (inferE globals ctx ec value) (\pv => case pv of
  Pair valueTerm (Pair valueTy ec1) =>
    let
      rig = binderRig False valueTy
    in andThen (inferLet globals ctx ec1 rest body rec_ sp) (\pb => case pb of
      Pair bodyTerm (Pair bodyTy ec2) =>
        Ok (Pair (TApp (TLam "_" rig bodyTerm) valueTerm rig) (Pair bodyTy ec2))
    )
)

checkByInfer : List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Result (Pair Term Ec)
checkByInfer globals ctx ec expr expected = case inferE globals ctx ec expr of
  Err e => Err e
  Ok (Pair term (Pair actual ec1)) => case convEc ec1 (ctxDepth ctx) expected actual of
    Err e => Err (showSpanLoc (exprSpan expr) ++ ": " ++ e)
    Ok ec2 => Ok (Pair term (resolveDictGoals globals ec2))

checkLam : List (Pair String Term) -> Ctx -> Ec -> List String -> Expr -> Value -> Span -> Result (Pair Term Ec)
checkLam globals ctx ec [] body expected sp = checkE globals ctx ec body expected
checkLam globals ctx ec (name :: rest) body expected sp =
  let
    forced = forceVal ec expected
  in case forced of
    VPi pname implicit rig dom clo =>
      let
        lvl = ctxDepth ctx
        v = freshVarValue pname lvl
        ctx2 = ctxBindValue name dom ctx
        expected2 = applyClosure clo v
        -- M18.5：lambda 形参与定义参数同一条规则——隐式 binder 恒擦除（隐式实参由
        -- 精化器插入，运行时不传），显式 binder 只有域是宇宙才擦除。
        -- 之前无条件写 True：形参在运行时被使用时硬报错，未被使用时静默少生成一层
        -- `fun`（能 check 不能 compile）。见 docs/reference/dt-parity.md §3。
        lamRig = binderRig implicit dom
      in andThen (checkLam globals ctx2 ec rest body expected2 sp) (\p => case p of
        Pair inner ec1 => Ok (Pair (TLam name lamRig inner) ec1)
      )
    _ => errAt sp "DT: lambda has more parameters than the expected function type"

checkType : List (Pair String Term) -> Ctx -> Ec -> Expr -> Result (Pair Term (Pair Level Ec))
checkType globals ctx ec expr = andThen (inferE globals ctx ec expr) (\p => case p of
  Pair term (Pair ty ec1) =>
    let
      forced = forceVal ec1 ty
    in case typeLevelOf forced of
      Just lvl => Ok (Pair term (Pair lvl ec1))
      Nothing =>
        errAt (exprSpan expr)
          ("DT: expected a type, but this expression has type " ++ showValueAt (ctxDepth ctx) ty)
)

-- 检查方向的应用：构造子的隐式族参数/索引由期望类型反向约束（M14 的索引推断）。
-- 非构造子仍走「先推断再统一」。
checkApp : List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Value -> Span -> Result (Pair Term Ec)
checkApp globals ctx ec fn args expected sp = case fn of
  EVar name vsp => case ctxLookup name ctx of
    Just _ => checkAppGeneral globals ctx ec fn args expected sp
    Nothing => case dtCtorLookup name (ecDatas ec) of
      Just _ =>
        if isSortVal ec expected then checkAppGeneral globals ctx ec fn args expected sp
        else checkAppCtor globals ctx ec name args expected vsp
      Nothing => checkAppGeneral globals ctx ec fn args expected sp
  _ => checkAppGeneral globals ctx ec fn args expected sp

-- M19：`==` / `/=` 的饱和应用按实参类型特化。
-- 返回 `Nothing` 表示「不是泛化比较运算符的饱和应用」，调用方走常规路径。
-- 特化后的项是 `bi_eq_int a b` / `bi_eq_str a b` 这类具体运行时函数应用，
-- 因此 codegen 只需要名字映射（不感知类型），M18.6 的封装不被破坏。
specializeEqApp : List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Result (Maybe (Pair Term (Pair Value Ec)))
specializeEqApp globals ctx ec name args sp = if isEqOp name then case args of
  [a, b] => andThen (inferE globals ctx ec a) (\pa => case pa of
    Pair aTerm (Pair aTy ec1) => andThen (inferE globals ctx ec1 b) (\pb => case pb of
      Pair bTerm (Pair bTy ec2) =>
        andThen (convEc ec2 (ctxDepth ctx) aTy bTy)
          (\ec3 => specializeEqTy globals ctx name aTerm bTerm sp aTy ec3)
    )
  )
  _ => Ok Nothing
else Ok Nothing

-- `==` / `/=` 的饱和应用（M19）。`Int` / `String` 按实参类型特化成具体运行时函数；
-- 其它类型解析成 `Eq` 字典的方法投影（字典由实例搜索插入）——这正是 `deriving (Eq)`
-- 的用处。解析都在精化期完成，codegen 只按名字映射、不需要类型信息。
specializeEqTy : List (Pair String Term) -> Ctx -> String -> Term -> Term -> Span -> Value -> Ec -> Result (Maybe (Pair Term (Pair Value Ec)))
specializeEqTy globals ctx name aTerm bTerm sp aTy ec = case builtinEqTyName (forceVal ec aTy) of
  Just tyName =>
    andThen (eqRuntimeName name tyName)
      (\rt => Ok (Just (Pair (TApp (TApp (TGlobal rt) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal "Bool" [])) ec))))
  Nothing =>
    let
      mname = if name == "==" then "eq" else "neq"
      -- `eq : {a : Type} -> {d : Dict_Eq a} -> a -> a -> Bool`：类型（擦除）+ 字典。
      tyTerm = quote 0 aTy
      dictTy = VNeutral (NGlobal (dictTypeName "Eq") [eval [] tyTerm])
    in if dictArgUnsolvedMeta ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
    else case searchInstance ec dictTy sp of
      Ok (Pair dictTerm ec1) =>
        Ok
          (Just (Pair (TApp (TApp (TApp (TApp (TGlobal mname) tyTerm Rig0) dictTerm Rig1) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal "Bool" [])) ec1)))
      Err e =>
        if isRigidDictArg ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
        else Err e

-- 刚性类参数（如 `mem` 的 `a`）没有可搜实例：延迟成裸元变量 + 记录自由字典目标，
-- 等定义体精化完由 `liftFreeDictGoals` 提升成 `{d : Dict_Eq a}` 隐式参数。
deferEqDict : List (Pair String Term) -> Ctx -> String -> Term -> Term -> Term -> Span -> Value -> Ec -> Result (Maybe (Pair Term (Pair Value Ec)))
deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec =
  let
    m = ecNext ec
  in case newMeta ctx ec of
    Pair metaTerm ec1 =>
      Ok
        (Just (Pair (TApp (TApp (TApp (TApp (TGlobal mname) tyTerm Rig0) metaTerm Rig1) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal "Bool" [])) (ecAddDictGoal ec1 (DtDictGoal m dictTy)))))

-- ---------------------------------------------------------------
-- M22.2：`<` / `<=` / `>` / `>=` 的饱和应用按实参类型特化
-- ---------------------------------------------------------------
-- 与 `==` / `/=` 同构：`Int` 走具体运行时函数；`String` / `Bool` 走 OCaml `compare`
-- 的泛型运行时；其它类型解析成 `Ord` 字典的方法投影（`deriving (Ord)` 生效），
-- 刚性类参数延迟提升成 `{d : Dict_Ord a}`。
cmpOps : List String
cmpOps = ["<", "<=", ">", ">="]

isCmpOp : String -> Bool
isCmpOp name = memName name cmpOps

cmpMethodName : String -> String
cmpMethodName name = case name of
  "<" => "lt"
  "<=" => "le"
  ">" => "gt"
  _ => "ge"

cmpRuntimeName : String -> String -> Result String
cmpRuntimeName name tyName = case tyName of
  "Int" => case name of
    "<" => Ok "bi_lt_int"
    "<=" => Ok "bi_le_int"
    ">" => Ok "bi_gt_int"
    _ => Ok "bi_ge_int"
  "String" => Ok (cmpGenericName name)
  "Bool" => Ok (cmpGenericName name)
  _ => Err ("DT: `" ++ name ++ "` is not defined for " ++ tyName ++ " (Ord instance required)")

cmpGenericName : String -> String
cmpGenericName name = case name of
  "<" => "bi_lt_generic"
  "<=" => "bi_le_generic"
  ">" => "bi_gt_generic"
  _ => "bi_ge_generic"

-- 字典的类参数还是未解元变量时**不做实例搜索**：否则会像 `srt (\x,y => x <= y) xs`
-- 那样被第一个内建实例（Ord Int）提前定死，随后与 `List a` 统一时报 occurs check。
-- 延迟成字典目标，等类参数被实参/结果类型解出来后再回填。
dictArgUnsolvedMeta : Ec -> Value -> Bool
dictArgUnsolvedMeta ec dom = case dictClassArg ec dom of
  Just arg => case forceVal ec arg of
    VMeta m sp => case metaLookup m (ecSols ec) of
      Just _ => False
      Nothing => True
    _ => False
  Nothing => False

specializeCmpApp : List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Result (Maybe (Pair Term (Pair Value Ec)))
specializeCmpApp globals ctx ec name args sp = if isCmpOp name then case args of
  [a, b] => andThen (inferE globals ctx ec a) (\pa => case pa of
    Pair aTerm (Pair aTy ec1) => andThen (inferE globals ctx ec1 b) (\pb => case pb of
      Pair bTerm (Pair bTy ec2) =>
        andThen (convEc ec2 (ctxDepth ctx) aTy bTy)
          (\ec3 => specializeCmpTy globals ctx name aTerm bTerm sp aTy ec3)
    )
  )
  _ => Ok Nothing
else Ok Nothing

specializeCmpTy : List (Pair String Term) -> Ctx -> String -> Term -> Term -> Span -> Value -> Ec -> Result (Maybe (Pair Term (Pair Value Ec)))
specializeCmpTy globals ctx name aTerm bTerm sp aTy ec = case builtinTyName (forceVal ec aTy) of
  Just tyName =>
    andThen (cmpRuntimeName name tyName)
      (\rt => Ok (Just (Pair (TApp (TApp (TGlobal rt) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal "Bool" [])) ec))))
  Nothing =>
    let
      mname = cmpMethodName name
      tyTerm = quote 0 aTy
      dictTy = VNeutral (NGlobal (dictTypeName "Ord") [eval [] tyTerm])
    in if dictArgUnsolvedMeta ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
    else case searchInstance ec dictTy sp of
      Ok (Pair dictTerm ec1) =>
        Ok
          (Just (Pair (TApp (TApp (TApp (TApp (TGlobal mname) tyTerm Rig0) dictTerm Rig1) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal "Bool" [])) ec1)))
      Err e =>
        if isRigidDictArg ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
        else Err e

-- 统一入口：先试 `==` / `/=`，再试比较运算符。
specializeOpApp : List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Result (Maybe (Pair Term (Pair Value Ec)))
specializeOpApp globals ctx ec name args sp = andThen (specializeEqApp globals ctx ec name args sp) (\r => case r of
  Just pair => Ok (Just pair)
  Nothing => specializeCmpApp globals ctx ec name args sp
)

checkAppGeneral globals ctx ec fn args expected sp = case fn of
  EVar name vsp => andThen (specializeOpApp globals ctx ec name args sp) (\mspec => case mspec of
    Just (Pair term (Pair termTy ec1)) =>
      andThen (convEc ec1 (ctxDepth ctx) expected termTy) (\ec2 => Ok (Pair term ec2))
    Nothing => checkByInfer globals ctx ec (EApp fn args sp) expected
  )
  _ => checkByInfer globals ctx ec (EApp fn args sp) expected

-- 构造子应用：先按签名收隐式实参（元变量），再逐个检查显式实参，最后统一结果类型。
-- 用 `dtCtorLookup` 取**构造子类型**（不是 `globalLookup`）：名字与族同名的构造子
-- （如 `data Pair a b where Pair : a -> b -> Pair a b`）的 `globalLookup` 会命中族 kind
-- （`Type -> Type -> Type`）而不是构造子类型，导致隐式族参数丢失。
checkAppCtor : List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Value -> Span -> Result (Pair Term Ec)
checkAppCtor globals ctx ec name args expected sp = case dtCtorLookup name (ecDatas ec) of
  Nothing => errAt sp ("DT: unknown name " ++ name)
  Just ctor => andThen (inferArgs globals ctx ec (eval [] (dtCtorType ctor)) args sp) (\pa => case pa of
    Pair argTerms (Pair resTy ec1) => case convEc ec1 (ctxDepth ctx) expected resTy of
      Ok ec2 => Ok (Pair (ctorAppTerm (ecDatas ec2) (TGlobal name) argTerms) ec2)
      Err e => errAt sp ("DT: constructor " ++ name ++ ": " ++ e)
  )

-- ---------------------------------------------------------------
-- M19：多 clause 与方程左端模式
-- ---------------------------------------------------------------
-- 把 `plus Zero b = b` / `plus (Succ k) b = Succ (plus k b)` 合成：`\mc0 => \mc1 => case mc0 of ...`。
-- 两步：① 按参数个数生成 lambda 链（`mc<i>` 与签名 Pi 链对齐）；② 按**列**递归构建 case 树
-- （标准模式矩阵：整列变量改名继续；有构造子则用该位置名作 scrutinee，同构造子的子模式递归，
-- 变量/通配汇成兜底）。产物是纯 lambda + case，交给既有精化路径，覆盖/索引/擦除全自动。
elabFunDef : List (Pair String Term) -> Ec -> List (Pair (List Pat) Expr) -> Value -> Span -> Result (Pair Term Ec)
elabFunDef globals ec clauses expected sp = case clauses of
  [] => errAt sp "DT: function has no clauses"
  [Pair pats body] =>
    if allVarPats pats then checkDef globals ec pats body expected sp
    else andThen (multiToExpr (ctorFamilyTable ec) clauses)
      (\bodyExpr => checkDef globals ec [] bodyExpr expected sp)
  _ =>
    andThen (multiToExpr (ctorFamilyTable ec) clauses)
      (\bodyExpr => checkDef globals ec [] bodyExpr expected sp)

-- 构造子类型是否已显式带（隐式）类型参数。
hasFamParams : Expr -> Bool
hasFamParams e = case e of
  EPi n implicit dom cod sp => True
  _ => False

-- 模块限定名的最后一段（`Base.Monad.fmap` → `fmap`）。
baseNameOf : String -> String
baseNameOf name = case splitLastDot (splitOnDot name) of
  Pair rev base => base

-- M22.2：构造子名 → 族的全部构造子（`DtMatch` 的模式矩阵用它判断「这一列的构造子
-- 是否已经全覆盖」——全覆盖时不再补通配兜底，避免把剩余列的匹配不全暴露成假覆盖）。
ctorFamilyTable : Ec -> List (Pair String (List String))
ctorFamilyTable ec = map (\d => Pair (dtDataName d) (map dtCtorName (dtDataCtors d))) (ecDatas ec)

-- 后续分支里的兜底体（`case` 最后一个变量/通配分支），供嵌套模式的折叠使用。
findCatchAllBody : List (Pair Pat Expr) -> Maybe Expr
findCatchAllBody [] = Nothing
findCatchAllBody (alt :: rest) = case alt of
  Pair pat body => case pat of
    PCon cname args psp => findCatchAllBody rest
    _ => Just body

-- `Bool` 短名 → 程序里实际声明的 Bool 族（短名匹配；供内建 trait 声明/内建实例使用，
-- 它们不经过 Loader，AST 里写的是裸 `Bool`）。
shortBoolFamily : Ec -> String -> Maybe String
shortBoolFamily ec name = if name == "Bool" then findBoolFamily (ecDatas ec) else Nothing

findBoolFamily : List DtData -> Maybe String
findBoolFamily [] = Nothing
findBoolFamily (d :: rest) =
  if baseNameOf (dtDataName d) == "Bool" then Just (dtDataName d) else findBoolFamily rest
