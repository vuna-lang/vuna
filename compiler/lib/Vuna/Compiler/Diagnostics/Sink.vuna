-- | 诊断告警去重（纯 helper）。进程内收集器已在 M4 删除。
module Vuna.Compiler.Diagnostics.Sink (dedupeWarnings) where

-- Vuna.Compiler.Diagnostics.Sink：warning 去重。
--
-- M4：本模块原有的三个进程内可变登记表（warnings / used-imports / parse-errors）已删除：
--   * Elab 的 warning 经 `Ec.ecWarnings` 显式线程，精化出口挂到 `DtProgram`；
--   * loader 的 unused-import 与 parse 恢复诊断直接作为返回值交给驱动层；
--   * 驱动层（`CompilerCli` / LSP）在输出前用本模块去重（保持旧 `takeWarnings` 的
--     「按首次出现顺序去重」语义）。
import Vuna.Compiler.Common
import Base.List

-- | 诊断域实现：两条诊断是否「同一位置 + 同一码 + 同一消息」（去重用；忽略字段/建议）。
containsDiag : Diagnostic -> List Diagnostic -> Bool
containsDiag d [] = False
containsDiag d (x :: xs) = if sameDiag d x then True else containsDiag d xs

-- | 诊断域实现：按首次出现顺序去重。
dedupeWarnings : List Diagnostic -> List Diagnostic
dedupeWarnings ds =
  reverse (foldl (\acc => \d => if containsDiag d acc then acc else d :: acc) [] ds)
