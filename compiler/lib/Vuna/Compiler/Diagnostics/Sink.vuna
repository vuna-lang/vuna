-- | 诊断告警收集器：编译器在纯检查过程中发射 warning，驱动层在检查结束后取走。
module Vuna.Compiler.Diagnostics.Sink (emitWarning, resetWarnings, takeWarnings) where

-- Vuna.Compiler.Diagnostics.Sink：warning 的进程内收集点。
--
-- 设计边界：`Check` 只有「成功/首个错误」两种形态，warning 不短路检查；在 warning
-- 通道正式进 `Check` 之前，用本模块的 IORef 收集。约束：
--   * 只有**单线程**检查路径使用（`vuna check`/LSP 单请求；包级并行用子进程隔离）；
--   * 每个检查入口（loader）开始时 `resetWarnings`，结束后消费方 `takeWarnings`；
--   * 不跨请求保留状态。
import Base.IO.Host
import Base.IORef
import Base.List
import Vuna.Compiler.Common

-- 用记录包一层：`newRef []` 在模块边界上留弱类型变量（OCaml value restriction），
-- 记录类型让 ref 的载荷在定义处就是单态的。
record WarnBox where
  warnBoxItems : List Diagnostic

warningsRef : IORef WarnBox
warningsRef = runIO (newRef (WarnBox []))

-- | 清空收集器（检查入口调用）。返回 0 便于放在 let 链里。
resetWarnings : Int -> Int
resetWarnings _ = runIO (writeRef warningsRef (WarnBox []))

-- | 追加一条 warning；返回 0 便于放在 let 链里。
emitWarning : Diagnostic -> Int
emitWarning d = runIO (modifyRef warningsRef (\b => WarnBox (append b.warnBoxItems [d])))

-- | 取走当前全部 warning（读取后清空，避免下一次检查串扰）。
takeWarnings : Int -> List Diagnostic
takeWarnings _ =
  let
    b = runIO (readRef warningsRef)
    _ = runIO (writeRef warningsRef (WarnBox []))
  in b.warnBoxItems
