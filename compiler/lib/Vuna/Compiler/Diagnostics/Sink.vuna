-- | 诊断告警收集器：编译器在纯检查过程中发射 warning，驱动层在检查结束后取走。
module Vuna.Compiler.Diagnostics.Sink
  ( emitWarning
  , markImportUsed
  , resetUsedImports
  , resetWarnings
  , takeUsedImports
  , takeWarnings
  ) where

-- Vuna.Compiler.Diagnostics.Sink：warning 的进程内收集点。
--
-- 设计边界：`Check` 只有「成功/首个错误」两种形态，warning 不短路检查；在 warning
-- 通道正式进 `Check` 之前，用本模块的 IORef 收集。约束：
--   * 只有**单线程**检查路径使用（`vuna check`/LSP 单请求；包级并行用子进程隔离）；
--   * 每个检查入口（loader）开始时 `resetWarnings`，结束后消费方 `takeWarnings`；
--   * 不跨请求保留状态。
import Base.IO.Host
import Base.IORef
import Base.List
import Vuna.Compiler.Common

-- 用记录包一层：`newRef []` 在模块边界上留弱类型变量（OCaml value restriction），
-- 记录类型让 ref 的载荷在定义处就是单态的。
record WarnBox where
  warnBoxItems : List Diagnostic
  warnBoxTag : Int

warningsRef : IORef WarnBox
warningsRef = runIO (newRef (WarnBox [] 0))

-- | 清空收集器（检查入口调用）。返回 0 便于放在 let 链里。
resetWarnings : Int -> Int
resetWarnings _ =
  let
    _ = runIO (writeRef warningsRef (WarnBox [] 0))
    _ = runIO (writeRef usedImportsRef (UsedImportsBox [] 0))
  in 0

-- | 追加一条 warning；返回 0 便于放在 let 链里。
emitWarning : Diagnostic -> Int
emitWarning d = runIO (modifyRef warningsRef (\b => WarnBox (append b.warnBoxItems [d]) 0))

-- | 取走当前全部 warning（读取后清空，避免下一次检查串扰）。
takeWarnings : Int -> List Diagnostic
takeWarnings _ =
  let
    b = runIO (readRef warningsRef)
    _ = runIO (writeRef warningsRef (WarnBox [] 0))
  in dedupeWarnings b.warnBoxItems

containsDiag : Diagnostic -> List Diagnostic -> Bool
containsDiag d [] = False
containsDiag d (x :: xs) = if sameDiag d x then True else containsDiag d xs

dedupeWarnings : List Diagnostic -> List Diagnostic
dedupeWarnings ds =
  reverse (foldl (\acc => \d => if containsDiag d acc then acc else d :: acc) [] ds)

-- 本次检查中用到的 import（模块名）：unused-import warning 的数据源。
record UsedImportsBox where
  usedImportNames : List String
  usedImportTag : Int

usedImportsRef : IORef UsedImportsBox
usedImportsRef = runIO (newRef (UsedImportsBox [] 0))

memUsedImport : String -> List String -> Bool
memUsedImport n [] = False
memUsedImport n (x :: xs) = if n == x then True else memUsedImport n xs

markImportUsed : String -> Int
markImportUsed name =
  runIO
    (modifyRef usedImportsRef (\b => if memUsedImport name b.usedImportNames then b else UsedImportsBox (append b.usedImportNames [name]) 0))

takeUsedImports : Int -> List String
takeUsedImports _ =
  let
    b = runIO (readRef usedImportsRef)
  in b.usedImportNames

-- | 清空 import 使用集合（按检查单元/模块重置）。
resetUsedImports : Int -> Int
resetUsedImports _ = runIO (writeRef usedImportsRef (UsedImportsBox [] 0))
