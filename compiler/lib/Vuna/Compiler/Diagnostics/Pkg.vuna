-- | PKG_ 域：`vuna.toml` 清单解析/结构校验/包图诊断。
module Vuna.Compiler.Diagnostics.Pkg
  ( PkgEntry(..)
  , PkgErr(..)
  , pkgAll
  , pkgAt0
  , pkgAt1
  , pkgAt2
  , pkgCode
  , pkgInvalid
  , pkgMsg
  , pkgNoLoc
  , pkgNoLoc1
  , pkgNoLoc2
  , pkgNoLoc3
  , pkgPath0
  , pkgPath1
  , pkgPath2
  , pkgTemplate
  ) where

-- Vuna.Compiler.Diagnostics.Pkg：包清单与包图（phase = Load，category = Package）。
--
-- 位置来自 `vuna.toml` 的行号（列未知，统一取 1）；纯结构校验错误只有文件没有行。
-- 消息体与旧 `atLine/manifestErr` 输出一致（路径/行号搬到 Label，不再拼进消息）。
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Common
import Base.Nat
import Base.Vec

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.PkgErr（目录/模板见 diagnostics.md）。
data PkgErr : Nat -> Type where
  -- arity 0
  EmptyCapability : PkgErr Zero
  EmptyDependencyName : PkgErr Zero
  EmptyMember : PkgErr Zero
  EmptyPackageName : PkgErr Zero
  EmptyTrustPoint : PkgErr Zero
  MissingPackageName : PkgErr Zero
  NonPrivileged : PkgErr Zero
  TrustNeedsUnsafe : PkgErr Zero
  -- arity 1
  DependencyPathNotString : String -> PkgErr (Succ Zero)
  DuplicateCapability : String -> PkgErr (Succ Zero)
  DuplicateDependency : String -> PkgErr (Succ Zero)
  DuplicateTrustPoint : String -> PkgErr (Succ Zero)
  EmptyDependencyPath : String -> PkgErr (Succ Zero)
  ExpectedBool : String -> PkgErr (Succ Zero)
  ExpectedString : String -> PkgErr (Succ Zero)
  ExpectedInt : String -> PkgErr (Succ Zero)
  InvalidDiagFormat : String -> PkgErr (Succ Zero)
  InvalidDiagMaxErrors : String -> PkgErr (Succ Zero)
  InvalidDiagLang : String -> PkgErr (Succ Zero)
  ExpectedStringArray : String -> PkgErr (Succ Zero)
  Invalid : String -> PkgErr (Succ Zero)
  InvalidExportModule : String -> PkgErr (Succ Zero)
  InvalidPackageName : String -> PkgErr (Succ Zero)
  InvalidTrustPoint : String -> PkgErr (Succ Zero)
  MissingManifest : String -> PkgErr (Succ Zero)
  MissingBase : String -> PkgErr (Succ Zero)
  LibraryWithoutEntry : String -> PkgErr (Succ Zero)
  NoManifestUpward : String -> PkgErr (Succ Zero)
  TomlSyntax : String -> PkgErr (Succ Zero)
  UnexpectedTopLevelKey : String -> PkgErr (Succ Zero)
  UnknownSection : String -> PkgErr (Succ Zero)
  -- arity 2
  UnknownKey : String -> String -> PkgErr (Succ (Succ Zero))
  TrustPointMissing : String -> String -> PkgErr (Succ (Succ Zero))
  EffectCapabilityRequired : String -> String -> String -> PkgErr (Succ (Succ (Succ Zero)))

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgCode（目录/模板见 diagnostics.md）。
pkgCode : {n : Nat} -> PkgErr n -> String
pkgCode EmptyCapability = "PKG_EmptyCapability"
pkgCode EmptyDependencyName = "PKG_EmptyDependencyName"
pkgCode EmptyMember = "PKG_EmptyMember"
pkgCode EmptyPackageName = "PKG_EmptyPackageName"
pkgCode EmptyTrustPoint = "PKG_EmptyTrustPoint"
pkgCode MissingPackageName = "PKG_MissingPackageName"
pkgCode NonPrivileged = "PKG_NonPrivileged"
pkgCode TrustNeedsUnsafe = "PKG_TrustNeedsUnsafe"
pkgCode (DependencyPathNotString _) = "PKG_DependencyPathNotString"
pkgCode (DuplicateCapability _) = "PKG_DuplicateCapability"
pkgCode (DuplicateDependency _) = "PKG_DuplicateDependency"
pkgCode (DuplicateTrustPoint _) = "PKG_DuplicateTrustPoint"
pkgCode (EmptyDependencyPath _) = "PKG_EmptyDependencyPath"
pkgCode (ExpectedBool _) = "PKG_ExpectedBool"
pkgCode (ExpectedString _) = "PKG_ExpectedString"
pkgCode (ExpectedInt _) = "PKG_ExpectedInt"
pkgCode (InvalidDiagFormat _) = "PKG_InvalidDiagFormat"
pkgCode (InvalidDiagMaxErrors _) = "PKG_InvalidDiagMaxErrors"
pkgCode (InvalidDiagLang _) = "PKG_InvalidDiagLang"
pkgCode (ExpectedStringArray _) = "PKG_ExpectedStringArray"
pkgCode (Invalid _) = "PKG_Invalid"
pkgCode (InvalidExportModule _) = "PKG_InvalidExportModule"
pkgCode (InvalidPackageName _) = "PKG_InvalidPackageName"
pkgCode (InvalidTrustPoint _) = "PKG_InvalidTrustPoint"
pkgCode (MissingManifest _) = "PKG_MissingManifest"
pkgCode (MissingBase _) = "PKG_MissingBase"
pkgCode (LibraryWithoutEntry _) = "PKG_LibraryWithoutEntry"
pkgCode (NoManifestUpward _) = "PKG_NoManifestUpward"
pkgCode (TomlSyntax _) = "PKG_TomlSyntax"
pkgCode (UnexpectedTopLevelKey _) = "PKG_UnexpectedTopLevelKey"
pkgCode (UnknownSection _) = "PKG_UnknownSection"
pkgCode (UnknownKey _ _) = "PKG_UnknownKey"
pkgCode (TrustPointMissing _ _) = "PKG_TrustPointMissing"
pkgCode (EffectCapabilityRequired _ _ _) = "PKG_EffectCapabilityRequired"

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgTemplate（目录/模板见 diagnostics.md）。
pkgTemplate : {n : Nat} -> PkgErr n -> String
pkgTemplate EmptyCapability = "capability name must not be empty"
pkgTemplate EmptyDependencyName = "dependency name must not be empty"
pkgTemplate EmptyMember = "workspace member must not be empty"
pkgTemplate EmptyPackageName = "package name must not be empty"
pkgTemplate EmptyTrustPoint = "trust point name must not be empty"
pkgTemplate MissingPackageName = "missing [package] name"
pkgTemplate NonPrivileged =
  "non-privileged package declares [capabilities]/[trust]/[privileged]; only [package] privileged = true packages may declare capabilities, trust points or host-layer modules (user code should use Base.Eff.* handlers)"
pkgTemplate TrustNeedsUnsafe =
  "[trust] unsafe requires capability \"unsafe\" in [capabilities] effects"
pkgTemplate (DependencyPathNotString _) = "dependency \"<0>\" must have a string relative path"
pkgTemplate (DuplicateCapability _) = "duplicate capability \"<0>\""
pkgTemplate (DuplicateDependency _) = "duplicate dependency \"<0>\""
pkgTemplate (DuplicateTrustPoint _) = "duplicate trust point \"<0>\""
pkgTemplate (EmptyDependencyPath _) = "dependency \"<0>\" path must not be empty"
pkgTemplate (ExpectedBool _) = "expected a boolean for \"<0>\""
pkgTemplate (ExpectedString _) = "expected a string for \"<0>\""
pkgTemplate (ExpectedInt _) = "expected an integer for \"<0>\""
pkgTemplate (InvalidDiagFormat _) =
  "invalid [diagnostics] format \"<0>\" (expected short|human|json|sarif)"
pkgTemplate (InvalidDiagMaxErrors _) =
  "invalid [diagnostics] max-errors \"<0>\" (expected a positive integer)"
pkgTemplate (InvalidDiagLang _) = "invalid [diagnostics] lang \"<0>\" (expected en|zh)"
pkgTemplate (ExpectedStringArray _) = "expected an array of strings for \"<0>\""
pkgTemplate (Invalid _) = "<0>"
pkgTemplate (InvalidExportModule _) =
  "invalid export module \"<0>\" (segments must match [A-Z][A-Za-z0-9_]*)"
pkgTemplate (InvalidPackageName _) =
  "invalid package name \"<0>\" (allowed characters: a-z, 0-9, '-')"
pkgTemplate (InvalidTrustPoint _) =
  "invalid trust point \"<0>\" (expected a qualified definition name such as \"Base.Eff.runPure\")"
pkgTemplate (MissingManifest _) = "missing vuna.toml in <0>"
pkgTemplate (MissingBase _) =
  "pkg: cannot locate vuna-base (tried: <0>); set VUNA_BASE to a directory containing vuna.toml"
pkgTemplate (LibraryWithoutEntry _) =
  "check: library package <0> has no app/Main.vuna (executable) and no [export].modules (library)"
pkgTemplate (NoManifestUpward _) = "no vuna.toml found from <0> (searched upward)"
pkgTemplate (TomlSyntax _) = "<0>"
pkgTemplate (UnexpectedTopLevelKey _) = "unexpected top-level key \"<0>\""
pkgTemplate (UnknownSection _) = "unknown section [<0>]"
pkgTemplate (UnknownKey _ _) = "unknown key \"<0>\" in [<1>]"
pkgTemplate (TrustPointMissing _ _) =
  "trust point \"<1>\" is not a definition of this package; [trust] unsafe may only list real definitions (Module.def)"
pkgTemplate (EffectCapabilityRequired _ _ _) =
  "effectful builtin `<0>` requires capability `<1>` in <2> (declare [capabilities] effects = [\"<1>\"] or use Base.Eff / typed effects)"

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgMsg（目录/模板见 diagnostics.md）。
pkgMsg : {n : Nat} -> PkgErr n -> Vec n String -> Diagnostic
pkgMsg e args = diagNoLoc SevError PhLoad CatPackage (pkgCode e) (diagBody (pkgTemplate e) args)

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgSpan（目录/模板见 diagnostics.md）。
pkgSpan : String -> Int -> Maybe Span
pkgSpan path line = if path == "" then Nothing else Just (Span path line 1 line 1)

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.atSpan（目录/模板见 diagnostics.md）。
atSpan : Maybe Span -> Diagnostic -> Diagnostic
atSpan Nothing d = d
atSpan (Just sp) d = withLabel (Label (Just sp) "" LabelPrimary Nothing) d

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgAt（目录/模板见 diagnostics.md）。
pkgAt : String -> Int -> {n : Nat} -> PkgErr n -> Vec n String -> Check a
pkgAt path line e args = ErrC (atSpan (pkgSpan path line) (pkgMsg e args))

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgPath（目录/模板见 diagnostics.md）。
pkgPath : String -> {n : Nat} -> PkgErr n -> Vec n String -> Check a
pkgPath path e args = pkgAt path 1 e args

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgNoLoc（目录/模板见 diagnostics.md）。
pkgNoLoc : {n : Nat} -> PkgErr n -> Vec n String -> Check a
pkgNoLoc e args = ErrC (pkgMsg e args)

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgNoLoc1（目录/模板见 diagnostics.md）。
pkgNoLoc1 : PkgErr (Succ Zero) -> String -> Check a
pkgNoLoc1 e a0 = pkgNoLoc e [a0]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgNoLoc2（目录/模板见 diagnostics.md）。
pkgNoLoc2 : PkgErr (Succ (Succ Zero)) -> String -> String -> Check a
pkgNoLoc2 e a0 a1 = pkgNoLoc e [a0, a1]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgAt0（目录/模板见 diagnostics.md）。
pkgAt0 : String -> Int -> PkgErr Zero -> Check a
pkgAt0 path line e = pkgAt path line e []

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgAt1（目录/模板见 diagnostics.md）。
pkgAt1 : String -> Int -> PkgErr (Succ Zero) -> String -> Check a
pkgAt1 path line e a0 = pkgAt path line e [a0]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgAt2（目录/模板见 diagnostics.md）。
pkgAt2 : String -> Int -> PkgErr (Succ (Succ Zero)) -> String -> String -> Check a
pkgAt2 path line e a0 a1 = pkgAt path line e [a0, a1]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgPath0（目录/模板见 diagnostics.md）。
pkgPath0 : String -> PkgErr Zero -> Check a
pkgPath0 path e = pkgPath path e []

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgPath1（目录/模板见 diagnostics.md）。
pkgPath1 : String -> PkgErr (Succ Zero) -> String -> Check a
pkgPath1 path e a0 = pkgPath path e [a0]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgPath2（目录/模板见 diagnostics.md）。
pkgPath2 : String -> PkgErr (Succ (Succ Zero)) -> String -> String -> Check a
pkgPath2 path e a0 a1 = pkgPath path e [a0, a1]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgInvalid（目录/模板见 diagnostics.md）。
pkgInvalid : String -> Check a
pkgInvalid msg = pkgNoLoc (Invalid msg) [msg]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.PkgEntry（目录/模板见 diagnostics.md）。
record PkgEntry where
  pkgEntryCode : String
  pkgEntryTemplate : String
  pkgEntryDesc : String

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgAll（目录/模板见 diagnostics.md）。
pkgAll : List PkgEntry
pkgAll =
  [ PkgEntry (pkgCode EmptyCapability) (pkgTemplate EmptyCapability) "能力名为空",
    PkgEntry (pkgCode EmptyDependencyName) (pkgTemplate EmptyDependencyName) "依赖名为空",
    PkgEntry (pkgCode EmptyMember) (pkgTemplate EmptyMember) "workspace 成员名为空",
    PkgEntry (pkgCode EmptyPackageName) (pkgTemplate EmptyPackageName) "包名为空",
    PkgEntry (pkgCode EmptyTrustPoint) (pkgTemplate EmptyTrustPoint) "信任点名为空",
    PkgEntry (pkgCode MissingPackageName) (pkgTemplate MissingPackageName) "缺 [package] name",
    PkgEntry (pkgCode NonPrivileged) (pkgTemplate NonPrivileged) "非特权包声明特权能力",
    PkgEntry (pkgCode TrustNeedsUnsafe) (pkgTemplate TrustNeedsUnsafe) "[trust] 需要 unsafe 能力",
    PkgEntry (pkgCode (DependencyPathNotString "")) (pkgTemplate (DependencyPathNotString "")) "依赖路径必须是字符串",
    PkgEntry (pkgCode (DuplicateCapability "")) (pkgTemplate (DuplicateCapability "")) "重复能力名",
    PkgEntry (pkgCode (DuplicateDependency "")) (pkgTemplate (DuplicateDependency "")) "重复依赖",
    PkgEntry (pkgCode (DuplicateTrustPoint "")) (pkgTemplate (DuplicateTrustPoint "")) "重复信任点",
    PkgEntry (pkgCode (EmptyDependencyPath "")) (pkgTemplate (EmptyDependencyPath "")) "依赖路径为空",
    PkgEntry (pkgCode (ExpectedBool "")) (pkgTemplate (ExpectedBool "")) "布尔字段类型错误",
    PkgEntry (pkgCode (ExpectedString "")) (pkgTemplate (ExpectedString "")) "字符串字段类型错误",
    PkgEntry (pkgCode (ExpectedInt "")) (pkgTemplate (ExpectedInt "")) "整数字段类型错误",
    PkgEntry (pkgCode (InvalidDiagFormat "")) (pkgTemplate (InvalidDiagFormat "")) "非法诊断格式",
    PkgEntry (pkgCode (InvalidDiagMaxErrors "")) (pkgTemplate (InvalidDiagMaxErrors "")) "非法 max-errors",
    PkgEntry (pkgCode (InvalidDiagLang "")) (pkgTemplate (InvalidDiagLang "")) "非法诊断语言",
    PkgEntry (pkgCode (ExpectedStringArray "")) (pkgTemplate (ExpectedStringArray "")) "字符串数组字段类型错误",
    PkgEntry (pkgCode (Invalid "")) (pkgTemplate (Invalid "")) "通用清单/包图错误",
    PkgEntry (pkgCode (InvalidExportModule "")) (pkgTemplate (InvalidExportModule "")) "非法导出模块名",
    PkgEntry (pkgCode (InvalidPackageName "")) (pkgTemplate (InvalidPackageName "")) "非法包名",
    PkgEntry (pkgCode (InvalidTrustPoint "")) (pkgTemplate (InvalidTrustPoint "")) "非法信任点名",
    PkgEntry (pkgCode (MissingManifest "")) (pkgTemplate (MissingManifest "")) "找不到 vuna.toml",
    PkgEntry (pkgCode (MissingBase "")) (pkgTemplate (MissingBase "")) "找不到 vuna-base",
    PkgEntry (pkgCode (LibraryWithoutEntry "")) (pkgTemplate (LibraryWithoutEntry "")) "库包缺入口/导出",
    PkgEntry (pkgCode (NoManifestUpward "")) (pkgTemplate (NoManifestUpward "")) "向上找不到 vuna.toml",
    PkgEntry (pkgCode (TomlSyntax "")) (pkgTemplate (TomlSyntax "")) "vuna.toml 语法错误",
    PkgEntry (pkgCode (UnexpectedTopLevelKey "")) (pkgTemplate (UnexpectedTopLevelKey "")) "顶层未知 key",
    PkgEntry (pkgCode (UnknownSection "")) (pkgTemplate (UnknownSection "")) "未知 section",
    PkgEntry (pkgCode (UnknownKey "" "")) (pkgTemplate (UnknownKey "" "")) "section 内未知 key",
    PkgEntry (pkgCode (TrustPointMissing "" "")) (pkgTemplate (TrustPointMissing "" "")) "trust point 不是本包定义",
    PkgEntry (pkgCode (EffectCapabilityRequired "" "" "")) (pkgTemplate (EffectCapabilityRequired "" "" "")) "effectful builtin 缺能力声明"
  ]

-- | 诊断域实现：Vuna.Compiler.Diagnostics.Pkg.pkgNoLoc3（目录/模板见 diagnostics.md）。
pkgNoLoc3 : {n : Nat} -> PkgErr (Succ (Succ (Succ Zero))) -> String -> String -> String -> Check a
pkgNoLoc3 e a0 a1 a2 = pkgNoLoc e [a0, a1, a2]
