module Vuna.Compiler.Diagnostics.Common (concatLists, diagDefLoc, diagErr, diagErrAt, diagMsg) where

-- Vuna.Compiler.Diagnostics.Common：TC_/CG_ 两域共享的诊断拼装 helper（M30 B19）。
--
-- 与具体域枚举无关：code / template / arity 的派生在 `Diagnostics.Tc` /
-- `Diagnostics.Cg`，这里只做「`[CODE] 模板替换` 拼装」「位置前缀」「纯 Err」与
-- 「分块拼接」的机械逻辑，两个域共用同一份实现（模板替换仍走 `Base.Vec.substTemplate`）。
-- 本模块不依赖 `Elab/Types`（避免 Elab ↔ Diagnostics 成环）。
import Vuna.Compiler.Common
import Base.Nat
import Base.Vec

-- 拼 `[CODE] 消息`：code 与 template 由调用方从各自域枚举派生，
-- args 的长度由 `Vec String n` 在编译期与 arity 锁定。
diagMsg : {n : Nat} -> String -> String -> Vec String n -> String
diagMsg code template args = "[" ++ code ++ "] " ++ substTemplate template args

-- 纯消息诊断（CG：无位置）。
diagErr : String -> Result a
diagErr msg = Err msg

-- 带 span 前缀的诊断（TC：`文件:行:列: <消息>`，格式与 `Elab/Types.errAt` 一致）。
diagErrAt : Span -> String -> Result a
diagErrAt sp msg = Err (showSpanLoc sp ++ ": " ++ msg)

-- 定义级诊断位置前缀（M29 A14）：`文件:行:列: in `name`: `；没有 span 时退回
-- `in `name`: `（不改变既有夹具断言的子串）。
diagDefLoc : Maybe Span -> String -> String
diagDefLoc span name = case span of
  Just sp => showSpanLoc sp ++ ": in `" ++ name ++ "`: "
  Nothing => "in `" ++ name ++ "`: "

-- 分块拼接：`tcAll` / `cgAll` 按 ≤8 项分块后按顺序还原成一张表。
-- split codegen 把单个列表字面量打成一行，整表字面量会产生超长行（M30 B19）；
-- 拼接保持元素顺序与内容不变。
concatLists : List (List a) -> List a
concatLists [] = []
concatLists (xs :: rest) = append xs (concatLists rest)
