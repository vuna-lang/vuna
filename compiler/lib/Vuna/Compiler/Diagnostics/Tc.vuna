module Vuna.Compiler.Diagnostics.Tc
  ( TcEntry(..)
  , TcErr(..)
  , tcAll
  , tcCode
  , tcErr
  , tcErr0
  , tcErr0NoLoc
  , tcErr1
  , tcErr1NoLoc
  , tcErr2
  , tcErr2NoLoc
  , tcMsg
  , tcTemplate
  ) where

-- Vuna.Compiler.Diagnostics.Tc：TC_ 域（精化 / 终止性 / 覆盖性诊断）。
--
-- 从 `Vuna.Compiler.Diagnostics` 拆出（M30 B19）；对外名字集合不变，门面仍是
-- `Vuna.Compiler.Diagnostics`（选择性重导出，调用点零改动）。
-- arity 由 `TcErr : Nat -> Type` 的构造子索引在编译期锁定（`UnknownName : String ->
-- TcErr (Succ Zero)`），throw 点给 `Vec String n`——arity 拼错**编译失败**。
-- 模板/说明/码的派生都在本模块；`tcAll` 是 `gen-errors` 的文档遍历源。
--
-- 约定：符号语义稳定、只增不删；一个码只承载一种语义；占位符 `<k>` 每个只出现一次。
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Common
import Base.Nat
import Base.Vec

-- ---------------------------------------------------------------
-- TC_：精化 / 终止性 / 覆盖性诊断（Elab）
-- arity = 构造子索引；String payload = 消息模板（占位符 `<0>` `<1>`…）
-- ---------------------------------------------------------------
data TcErr : Nat -> Type where
  -- arity 0
  BoolCaseRestriction : TcErr Zero
  BranchAfterCatchAll : TcErr Zero
  CaseBranchTooFewArgs : TcErr Zero
  CatchAllNotLast : TcErr Zero
  ClauseTooManyPatterns : TcErr Zero
  DataKindArrows : TcErr Zero
  DefFewerParams : TcErr Zero
  DefMoreParams : TcErr Zero
  DefParamsMustBeVars : TcErr Zero
  DoUnsupported : TcErr Zero
  DuplicateCtorInCase : TcErr Zero
  FunctionNoClauses : TcErr Zero
  HoleNoExpectedType : TcErr Zero
  ImplicitParamKind : TcErr Zero
  ImpossibleBranchEmptyCtx : TcErr Zero
  ImpossibleBranchIndex : TcErr Zero
  IndexFuel : TcErr Zero
  InstanceAnnotationWrongUse : TcErr Zero
  InstanceHeadNotApp : TcErr Zero
  ConstraintNotDict : TcErr Zero
  InstanceMissingMethod : TcErr Zero
  InterfaceOneParam : TcErr Zero
  IntStringCaseNeedsFallback : TcErr Zero
  IntStringCaseRestriction : TcErr Zero
  InvalidArrowType : TcErr Zero
  LambdaNoSignature : TcErr Zero
  LambdaTooManyParams : TcErr Zero
  LetBindingPattern : TcErr Zero
  NestedPatterns : TcErr Zero
  NatLiteralOutOfRange : TcErr Zero
  NotInductiveFamily : TcErr Zero
  OnlyCtorPatterns : TcErr Zero
  PatternFuel : TcErr Zero
  RecordFieldAccessUnsupported : TcErr Zero
  RecordsUnsupported : TcErr Zero
  RecordUpdateUnsupported : TcErr Zero
  TooManyArgs : TcErr Zero
  TypeLevelArg : TcErr Zero
  TypeMismatchCaseCount : TcErr Zero
  TypeMismatchCtorArity : TcErr Zero
  UniverseLevelNonNegative : TcErr Zero
  -- arity 1
  AxiomWithDefinition : String -> TcErr (Succ Zero)
  BranchTooManyArgs : String -> TcErr (Succ Zero)
  CannotProveTermination : String -> TcErr (Succ Zero)
  CannotRedefineBuiltin : String -> TcErr (Succ Zero)
  CannotSolveMetavar : String -> TcErr (Succ Zero)
  CannotSolveHigherOrder : String -> TcErr (Succ Zero)
  CannotSolveOccurs : String -> TcErr (Succ Zero)
  TypeMismatchCaseVars : String -> TcErr (Succ Zero)
  DuplicateInstance : String -> TcErr (Succ Zero)
  InstanceContextMissing : String -> TcErr (Succ Zero)
  OverlappingInstances : String -> TcErr (Succ Zero)
  DuplicateSignature : String -> TcErr (Succ Zero)
  ExpectedSignature : String -> TcErr (Succ Zero)
  ExpectedType : String -> TcErr (Succ Zero)
  -- M33 W5：extern 签名超出受限 FFI 子集（基本类型 + 简单 Array）。
  FfiTypeUnsupported : String -> TcErr (Succ Zero)
  EqRequiresEvidence : String -> TcErr (Succ Zero)
  InstanceNotTrait : String -> TcErr (Succ Zero)
  InstanceUnknownMethod : String -> TcErr (Succ Zero)
  NeedsTwoArgs : String -> TcErr (Succ Zero)
  NoInstanceFound : String -> TcErr (Succ Zero)
  -- M36：模板字符串插值（`${e}` → `Base.Interp.interp e`）找不到 `Interp`/`Show` 实例。
  InterpNoInstance : String -> TcErr (Succ Zero)
  NotExhaustive : String -> TcErr (Succ Zero)
  RedundantCtorBranch : String -> TcErr (Succ Zero)
  RedundantLiteralBranch : String -> TcErr (Succ Zero)
  SignatureNoDef : String -> TcErr (Succ Zero)
  UnknownInterface : String -> TcErr (Succ Zero)
  UnknownName : String -> TcErr (Succ Zero)
  UnknownNamedInstance : String -> TcErr (Succ Zero)
  UnsolvedHole : String -> TcErr (Succ Zero)
  UnsolvedMetavarInfer : String -> TcErr (Succ Zero)
  -- M38（QTT）：用量检查。
  LinearUnused : String -> TcErr (Succ Zero)
  LinearOverused : String -> TcErr (Succ Zero)
  ErasedBinderUsed : String -> TcErr (Succ Zero)
  MultiplicityImplicit : String -> TcErr (Succ Zero)
  MultiplicityTypeDomain : String -> TcErr (Succ Zero)
  LinearTypeNeedsOne : String -> TcErr (Succ Zero)
  LinearValueNeedsLinearBinder : String -> TcErr (Succ Zero)
  LinearTopLevel : String -> TcErr (Succ Zero)
  LinearCaptureEscapes : String -> TcErr (Succ Zero)
  -- arity 2
  AmbiguousInstance : String -> String -> TcErr (Succ (Succ Zero))
  AppliedNotType : String -> TcErr (Succ Zero)
  CtorDoesNotReturn : String -> String -> TcErr (Succ (Succ Zero))
  CtorError : String -> String -> TcErr (Succ (Succ Zero))
  CtorWrongIndices : String -> String -> TcErr (Succ (Succ Zero))
  NotTraitMethod : String -> String -> TcErr (Succ (Succ Zero))
  OpNotDefinedFor : String -> String -> TcErr (Succ (Succ Zero))
  OpOnlyIntString : String -> String -> TcErr (Succ (Succ Zero))
  UnknownConstructorInCase : String -> String -> TcErr (Succ (Succ Zero))
  UnsolvedMetavar : String -> String -> TcErr (Succ (Succ Zero))
  TypeMismatch : String -> String -> TcErr (Succ (Succ Zero))
  TypeMismatchCaseBranch : String -> String -> TcErr (Succ (Succ Zero))
  WhereNeedsSig : String -> String -> TcErr (Succ (Succ Zero))

-- ---------------------------------------------------------------
-- code 派生（唯一真源；`gen-errors` 与 throw 都用它）
-- ---------------------------------------------------------------
tcCode : {n : Nat} -> TcErr n -> String
tcCode BoolCaseRestriction = "TC_BoolCaseRestriction"
tcCode BranchAfterCatchAll = "TC_BranchAfterCatchAll"
tcCode CaseBranchTooFewArgs = "TC_CaseBranchTooFewArgs"
tcCode CatchAllNotLast = "TC_CatchAllNotLast"
tcCode ClauseTooManyPatterns = "TC_ClauseTooManyPatterns"
tcCode DataKindArrows = "TC_DataKindArrows"
tcCode DefFewerParams = "TC_DefFewerParams"
tcCode DefMoreParams = "TC_DefMoreParams"
tcCode DefParamsMustBeVars = "TC_DefParamsMustBeVars"
tcCode DoUnsupported = "TC_DoUnsupported"
tcCode DuplicateCtorInCase = "TC_DuplicateCtorInCase"
tcCode FunctionNoClauses = "TC_FunctionNoClauses"
tcCode HoleNoExpectedType = "TC_HoleNoExpectedType"
tcCode ImplicitParamKind = "TC_ImplicitParamKind"
tcCode ImpossibleBranchEmptyCtx = "TC_ImpossibleBranchEmptyCtx"
tcCode ImpossibleBranchIndex = "TC_ImpossibleBranchIndex"
tcCode IndexFuel = "TC_IndexFuel"
tcCode InstanceAnnotationWrongUse = "TC_InstanceAnnotationWrongUse"
tcCode InstanceHeadNotApp = "TC_InstanceHeadNotApp"
tcCode ConstraintNotDict = "TC_ConstraintNotDict"
tcCode InstanceMissingMethod = "TC_InstanceMissingMethod"
tcCode InterfaceOneParam = "TC_InterfaceOneParam"
tcCode IntStringCaseNeedsFallback = "TC_IntStringCaseNeedsFallback"
tcCode IntStringCaseRestriction = "TC_IntStringCaseRestriction"
tcCode InvalidArrowType = "TC_InvalidArrowType"
tcCode LambdaNoSignature = "TC_LambdaNoSignature"
tcCode LambdaTooManyParams = "TC_LambdaTooManyParams"
tcCode LetBindingPattern = "TC_LetBindingPattern"
tcCode NestedPatterns = "TC_NestedPatterns"
tcCode NatLiteralOutOfRange = "TC_NatLiteralOutOfRange"
tcCode NotInductiveFamily = "TC_NotInductiveFamily"
tcCode OnlyCtorPatterns = "TC_OnlyCtorPatterns"
tcCode PatternFuel = "TC_PatternFuel"
tcCode RecordFieldAccessUnsupported = "TC_RecordFieldAccessUnsupported"
tcCode RecordsUnsupported = "TC_RecordsUnsupported"
tcCode RecordUpdateUnsupported = "TC_RecordUpdateUnsupported"
tcCode TooManyArgs = "TC_TooManyArgs"
tcCode TypeLevelArg = "TC_TypeLevelArg"
tcCode TypeMismatchCaseCount = "TC_TypeMismatchCaseCount"
tcCode TypeMismatchCtorArity = "TC_TypeMismatchCtorArity"
tcCode UniverseLevelNonNegative = "TC_UniverseLevelNonNegative"
tcCode (AxiomWithDefinition _) = "TC_AxiomWithDefinition"
tcCode (BranchTooManyArgs _) = "TC_BranchTooManyArgs"
tcCode (CannotProveTermination _) = "TC_CannotProveTermination"
tcCode (CannotRedefineBuiltin _) = "TC_CannotRedefineBuiltin"
tcCode (CannotSolveMetavar _) = "TC_CannotSolveMetavar"
tcCode (CannotSolveHigherOrder _) = "TC_CannotSolveHigherOrder"
tcCode (CannotSolveOccurs _) = "TC_CannotSolveOccurs"
tcCode (LinearUnused _) = "TC_LinearUnused"
tcCode (LinearOverused _) = "TC_LinearOverused"
tcCode (ErasedBinderUsed _) = "TC_ErasedBinderUsed"
tcCode (MultiplicityImplicit _) = "TC_MultiplicityImplicit"
tcCode (MultiplicityTypeDomain _) = "TC_MultiplicityTypeDomain"
tcCode (LinearTypeNeedsOne _) = "TC_LinearTypeNeedsOne"
tcCode (LinearValueNeedsLinearBinder _) = "TC_LinearValueNeedsLinearBinder"
tcCode (LinearTopLevel _) = "TC_LinearTopLevel"
tcCode (LinearCaptureEscapes _) = "TC_LinearCaptureEscapes"
tcCode (TypeMismatchCaseVars _) = "TC_TypeMismatchCaseVars"
tcCode (DuplicateInstance _) = "TC_DuplicateInstance"
tcCode (InstanceContextMissing _) = "TC_InstanceContextMissing"
tcCode (OverlappingInstances _) = "TC_OverlappingInstances"
tcCode (DuplicateSignature _) = "TC_DuplicateSignature"
tcCode (ExpectedSignature _) = "TC_ExpectedSignature"
tcCode (ExpectedType _) = "TC_ExpectedType"
tcCode (FfiTypeUnsupported _) = "TC_FfiTypeUnsupported"
tcCode (EqRequiresEvidence _) = "TC_EqRequiresEvidence"
tcCode (InstanceNotTrait _) = "TC_InstanceNotTrait"
tcCode (InstanceUnknownMethod _) = "TC_InstanceUnknownMethod"
tcCode (NeedsTwoArgs _) = "TC_NeedsTwoArgs"
tcCode (NoInstanceFound _) = "TC_NoInstanceFound"
tcCode (InterpNoInstance _) = "TC_InterpNoInstance"
tcCode (NotExhaustive _) = "TC_NotExhaustive"
tcCode (RedundantCtorBranch _) = "TC_RedundantCtorBranch"
tcCode (RedundantLiteralBranch _) = "TC_RedundantLiteralBranch"
tcCode (SignatureNoDef _) = "TC_SignatureNoDef"
tcCode (UnknownInterface _) = "TC_UnknownInterface"
tcCode (UnknownName _) = "TC_UnknownName"
tcCode (UnknownNamedInstance _) = "TC_UnknownNamedInstance"
tcCode (UnsolvedHole _) = "TC_UnsolvedHole"
tcCode (UnsolvedMetavarInfer _) = "TC_UnsolvedMetavarInfer"
tcCode (AmbiguousInstance _ _) = "TC_AmbiguousInstance"
tcCode (AppliedNotType _) = "TC_AppliedNotType"
tcCode (CtorDoesNotReturn _ _) = "TC_CtorDoesNotReturn"
tcCode (CtorError _ _) = "TC_CtorError"
tcCode (CtorWrongIndices _ _) = "TC_CtorWrongIndices"
tcCode (NotTraitMethod _ _) = "TC_NotTraitMethod"
tcCode (OpNotDefinedFor _ _) = "TC_OpNotDefinedFor"
tcCode (OpOnlyIntString _ _) = "TC_OpOnlyIntString"
tcCode (UnknownConstructorInCase _ _) = "TC_UnknownConstructorInCase"
tcCode (UnsolvedMetavar _ _) = "TC_UnsolvedMetavar"
tcCode (TypeMismatch _ _) = "TC_TypeMismatch"
tcCode (TypeMismatchCaseBranch _ _) = "TC_TypeMismatchCaseBranch"
tcCode (WhereNeedsSig _ _) = "TC_WhereNeedsSig"

-- ---------------------------------------------------------------
-- 模板（构造子 payload，占位符 `<0>`/`<1>`；已去掉旧 `DT: ` 前缀）
-- ---------------------------------------------------------------
tcTemplate : {n : Nat} -> TcErr n -> String
tcTemplate BoolCaseRestriction = "case on Bool only accepts True / False / variable patterns (M19)"
tcTemplate BranchAfterCatchAll = "this branch is unreachable: it follows a catch-all branch"
tcTemplate CaseBranchTooFewArgs = "case branch has too few arguments for its constructor"
tcTemplate CatchAllNotLast = "the catch-all branch must be the last one"
tcTemplate ClauseTooManyPatterns = "clause has more patterns than the function arity"
tcTemplate DataKindArrows =
  "the kind of a data declaration must be a chain of arrows ending in Type"
tcTemplate DefFewerParams = "definition has fewer parameters than its signature"
tcTemplate DefMoreParams = "definition has more parameters than its signature"
tcTemplate DefParamsMustBeVars = "definition parameters must be variables (M13)"
tcTemplate DoUnsupported = "do blocks are not supported yet (M19)"
tcTemplate DuplicateCtorInCase = "duplicate constructor in case"
tcTemplate FunctionNoClauses = "function has no clauses"
tcTemplate HoleNoExpectedType = "cannot infer the type of a hole; give it an expected type"
tcTemplate ImplicitParamKind = "implicit parameters must be types or inductive families (M15)"
tcTemplate ImpossibleBranchEmptyCtx =
  "this branch is impossible (its context contains an empty inductive family)"
tcTemplate ImpossibleBranchIndex = "this branch is impossible (index constraints are unsatisfiable)"
tcTemplate IndexFuel = "index unification ran out of reduction fuel"
tcTemplate InstanceAnnotationWrongUse =
  "@instance can only be used with a trait method (write `method @instance`)"
tcTemplate InstanceHeadNotApp = "instance head must be an interface application (e.g. Show Int)"
tcTemplate ConstraintNotDict =
  "constraint must be a single-parameter interface application (e.g. Eq a)"
tcTemplate InstanceMissingMethod = "instance is missing an implementation for an interface method"
tcTemplate InterfaceOneParam = "interfaces must have exactly one parameter (M15 limitation)"
tcTemplate IntStringCaseNeedsFallback =
  "case on Int / String needs a variable or wildcard branch as fallback (M19)"
tcTemplate IntStringCaseRestriction =
  "case on Int / String only accepts literals / variable patterns (M19)"
tcTemplate InvalidArrowType = "invalid arrow type"
tcTemplate LambdaNoSignature = "cannot infer the type of a lambda; add a signature"
tcTemplate LambdaTooManyParams = "lambda has more parameters than the expected function type"
tcTemplate LetBindingPattern = "let bindings must be simple names or wildcards (M19)"
tcTemplate NestedPatterns = "nested patterns must be constructor patterns (M19)"
tcTemplate NatLiteralOutOfRange = "Nat literal is out of range (max is 4611686018427387903)"
tcTemplate NotInductiveFamily = "case scrutinee is not an inductive family"
tcTemplate OnlyCtorPatterns = "only constructor patterns are supported in case (M14)"
tcTemplate PatternFuel = "pattern matrix recursion ran out of fuel"
tcTemplate RecordFieldAccessUnsupported = "record field access is not supported yet (M15)"
tcTemplate RecordsUnsupported = "records are not supported yet (M15)"
tcTemplate RecordUpdateUnsupported = "record update is not supported yet (M15)"
tcTemplate TooManyArgs = "too many arguments (not a function)"
tcTemplate TypeLevelArg = "Type needs exactly one non-negative level (or none)"
tcTemplate TypeMismatchCaseCount = "type mismatch: case branches differ in number"
tcTemplate TypeMismatchCtorArity = "type mismatch: constructor arguments differ in length"
tcTemplate UniverseLevelNonNegative = "universe level must be non-negative"
tcTemplate (AxiomWithDefinition _) = "axiom `<0>` cannot have a definition"
tcTemplate (BranchTooManyArgs _) = "branch for constructor <0> has too many arguments"
tcTemplate (CannotProveTermination _) = "cannot prove termination of <0>"
tcTemplate (CannotRedefineBuiltin _) = "cannot redefine builtin <0>"
tcTemplate (CannotSolveMetavar _) =
  "cannot solve metavariable ?<0> (solution would escape its scope)"
tcTemplate (CannotSolveHigherOrder _) =
  "cannot solve higher-order metavariable ?<0> (M15 limitation)"
tcTemplate (CannotSolveOccurs _) = "cannot solve metavariable ?<0> (occurs check)"
tcTemplate (TypeMismatchCaseVars _) =
  "type mismatch: case branch <0> binds a different number of variables"
tcTemplate (DuplicateInstance _) = "duplicate instance <0>"
tcTemplate (InstanceContextMissing _) = "instance context cannot be satisfied: <0>"
tcTemplate (OverlappingInstances _) = "overlapping instance <0>"
tcTemplate (DuplicateSignature _) = "duplicate signature for <0>"
tcTemplate (ExpectedSignature _) = "expected a type signature for <0>"
tcTemplate (ExpectedType _) = "expected a type, but this expression has type <0>"
tcTemplate (FfiTypeUnsupported _) = "extern type is outside the supported FFI subset: <0>"
tcTemplate (EqRequiresEvidence _) =
  "cannot use == or /= on values of type <0>: provide an Eq instance (or derive Eq); the Eq trait must be in scope"
tcTemplate (InstanceNotTrait _) = "instance <0> is not an instance of a trait"
tcTemplate (InstanceUnknownMethod _) = "instance has unknown method <0>"
tcTemplate (NeedsTwoArgs _) = "`<0>` needs exactly two arguments"
tcTemplate (NoInstanceFound _) = "no instance found for <0>"
tcTemplate (InterpNoInstance _) =
  "template interpolation needs an `Interp` or `Show` instance for <0> (add `deriving (Show)`, define `instance Interp <0>`, or convert explicitly with `show`/`strFromInt`)"
tcTemplate (NotExhaustive _) = "case is not exhaustive: missing <0>"
tcTemplate (RedundantCtorBranch cname) =
  "redundant constructor branch: `${cname}` is already covered by an earlier branch"
tcTemplate (RedundantLiteralBranch lit) =
  "redundant literal branch: ${lit} is already covered by an earlier branch"
tcTemplate (SignatureNoDef _) = "signature for <0> has no definition"
tcTemplate (UnknownInterface _) = "unknown interface <0> in instance head or constraint"
tcTemplate (UnknownName _) = "unknown name <0>"
tcTemplate (UnknownNamedInstance _) = "unknown named instance <0>"
tcTemplate (UnsolvedHole _) = "unsolved hole <0>"
tcTemplate (UnsolvedMetavarInfer _) =
  "cannot infer a type for this expression (unsolved metavariable ?<0>); add a type annotation"
tcTemplate (AmbiguousInstance _ _) = "ambiguous instance for <0> (candidates: <1>)"
tcTemplate (AppliedNotType _) = "expected a type, but <0> applied to these arguments is not a type"
tcTemplate (CtorDoesNotReturn _ _) = "constructor <0> does not return <1>"
tcTemplate (CtorError _ _) = "constructor <0>: <1>"
tcTemplate (CtorWrongIndices _ _) = "constructor <0> has the wrong number of indices for <1>"
tcTemplate (NotTraitMethod _ _) = "`<0>` is not a method of trait <1>"
tcTemplate (OpNotDefinedFor _ _) = "`<0>` is not defined for <1> (Ord instance required)"
tcTemplate (OpOnlyIntString _ _) = "`<0>` is only defined for Int and String (found <1>; M19)"
tcTemplate (UnknownConstructorInCase _ _) = "unknown constructor <0> in case <1>"
tcTemplate (UnsolvedMetavar _ _) = "unsolved metavariable ?<0><1>"
tcTemplate (TypeMismatch _ _) = "type mismatch: expected <0>, got <1>"
tcTemplate (TypeMismatchCaseBranch _ _) = "type mismatch: case branch <0> vs <1>"
tcTemplate (WhereNeedsSig _ _) =
  "where binding `<0>` needs a type signature (write `<1> : <type>` before the clause)"
tcTemplate (LinearUnused _) =
  "linear binder `<0>` must be used exactly once at runtime, but it is never used"
tcTemplate (LinearOverused _) =
  "linear binder `<0>` must be used exactly once at runtime, but it is used more than once"
tcTemplate (ErasedBinderUsed _) = "binder `<0>` has multiplicity 0, but it is used at runtime"
tcTemplate (MultiplicityImplicit _) = "implicit binder `<0>` must have multiplicity 0"
tcTemplate (MultiplicityTypeDomain _) =
  "binder `<0>` has a type-level domain and must have multiplicity 0"
tcTemplate (LinearTypeNeedsOne _) = "binder `<0>` has a linear type; its multiplicity must be 1"
tcTemplate (LinearValueNeedsLinearBinder _) =
  "linear value `<0>` can only be bound or passed at multiplicity 1"
tcTemplate (LinearTopLevel _) = "top-level `<0>` has a linear type; linear values cannot be global"
tcTemplate (LinearCaptureEscapes _) =
  "lambda `<0>` captures a linear value from its context and may escape"

-- ---------------------------------------------------------------
-- 文档遍历源（同构 List；`gen-errors` 遍历渲染；不承载 arity——arity 在构造子类型里）
-- ---------------------------------------------------------------
record TcEntry where
  tcEntryCode : String
  tcEntryTemplate : String
  tcEntryDesc : String

-- ---------------------------------------------------------------
-- 文档遍历源：**按 ≤8 项分块**（M30 B19）。split codegen 会把单个列表字面量打成一行，
-- 81 项一张表曾产生 ~39 KB 的行；块内顺序 = 文档顺序，拼接保持元素顺序与内容不变
-- （gen-errors 输出因此逐字节不变）。新增构造子必须登记到对应块末尾。
-- ---------------------------------------------------------------
tcChunk0 : List TcEntry
tcChunk0 =
  [ TcEntry (tcCode BoolCaseRestriction) (tcTemplate BoolCaseRestriction) "Bool 的 case 只接受 True/False/变量模式",
    TcEntry (tcCode (AxiomWithDefinition "")) (tcTemplate (AxiomWithDefinition "")) "axiom 不能同时有定义体",
    TcEntry (tcCode BranchAfterCatchAll) (tcTemplate BranchAfterCatchAll) "兜底分支之后的分支不可达",
    TcEntry (tcCode CaseBranchTooFewArgs) (tcTemplate CaseBranchTooFewArgs) "case 分支实参少于构造子字段",
    TcEntry (tcCode CatchAllNotLast) (tcTemplate CatchAllNotLast) "兜底分支必须在最后",
    TcEntry (tcCode ClauseTooManyPatterns) (tcTemplate ClauseTooManyPatterns) "子句模式多于函数元数",
    TcEntry (tcCode DataKindArrows) (tcTemplate DataKindArrows) "data 的 kind 必须是箭头链",
    TcEntry (tcCode DefFewerParams) (tcTemplate DefFewerParams) "定义实参少于签名（M28 起按 η 展开补 λ；保留码但不再触发）"
  ]

tcChunk1 : List TcEntry
tcChunk1 =
  [ TcEntry (tcCode DefMoreParams) (tcTemplate DefMoreParams) "定义实参多于签名",
    TcEntry (tcCode DefParamsMustBeVars) (tcTemplate DefParamsMustBeVars) "定义参数必须是变量",
    TcEntry (tcCode DoUnsupported) (tcTemplate DoUnsupported) "do 块尚不支持",
    TcEntry (tcCode DuplicateCtorInCase) (tcTemplate DuplicateCtorInCase) "case 里重复的构造子",
    TcEntry (tcCode FunctionNoClauses) (tcTemplate FunctionNoClauses) "函数没有子句",
    TcEntry (tcCode HoleNoExpectedType) (tcTemplate HoleNoExpectedType) "洞缺少期望类型",
    TcEntry (tcCode ImplicitParamKind) (tcTemplate ImplicitParamKind) "隐式参数必须是类型",
    TcEntry (tcCode ImpossibleBranchEmptyCtx) (tcTemplate ImpossibleBranchEmptyCtx) "上下文含空归纳族，分支不可达"
  ]

tcChunk2 : List TcEntry
tcChunk2 =
  [ TcEntry (tcCode ImpossibleBranchIndex) (tcTemplate ImpossibleBranchIndex) "索引约束不可满足，分支不可达",
    TcEntry (tcCode IndexFuel) (tcTemplate IndexFuel) "索引归一化耗尽归约燃料",
    TcEntry (tcCode InstanceAnnotationWrongUse) (tcTemplate InstanceAnnotationWrongUse) "@instance 只能用于 trait 方法",
    TcEntry (tcCode InstanceHeadNotApp) (tcTemplate InstanceHeadNotApp) "instance 头必须是接口应用",
    TcEntry (tcCode ConstraintNotDict) (tcTemplate ConstraintNotDict) "约束必须是单参数 trait 应用",
    TcEntry (tcCode InstanceMissingMethod) (tcTemplate InstanceMissingMethod) "instance 缺方法实现",
    TcEntry (tcCode InterfaceOneParam) (tcTemplate InterfaceOneParam) "接口必须恰好一个参数",
    TcEntry (tcCode IntStringCaseNeedsFallback) (tcTemplate IntStringCaseNeedsFallback) "Int/String 的 case 需要兜底分支"
  ]

tcChunk3 : List TcEntry
tcChunk3 =
  [ TcEntry (tcCode IntStringCaseRestriction) (tcTemplate IntStringCaseRestriction) "Int/String 的 case 模式受限",
    TcEntry (tcCode InvalidArrowType) (tcTemplate InvalidArrowType) "非法箭头类型",
    TcEntry (tcCode LambdaNoSignature) (tcTemplate LambdaNoSignature) "lambda 缺签名",
    TcEntry (tcCode LambdaTooManyParams) (tcTemplate LambdaTooManyParams) "lambda 参数多于期望函数类型",
    TcEntry (tcCode LetBindingPattern) (tcTemplate LetBindingPattern) "let 绑定必须是简单名或通配",
    TcEntry (tcCode NatLiteralOutOfRange) (tcTemplate NatLiteralOutOfRange) "Nat 字面量超出范围",
    TcEntry (tcCode NestedPatterns) (tcTemplate NestedPatterns) "嵌套模式必须是构造子模式",
    TcEntry (tcCode NotInductiveFamily) (tcTemplate NotInductiveFamily) "case 被检查项不是归纳族",
    TcEntry (tcCode OnlyCtorPatterns) (tcTemplate OnlyCtorPatterns) "case 只支持构造子模式"
  ]

tcChunk4 : List TcEntry
tcChunk4 =
