-- ---------------------------------------------------------------
-- throw：拼 `[CODE] 消息`（去掉旧 `DT: ` 前缀）；TC 的 Span 经 Common.showSpanLoc 拼在头部
-- ---------------------------------------------------------------
tcMsg : {n : Nat} -> TcErr n -> Vec String n -> String
tcMsg e args = diagMsg (tcCode e) (tcTemplate e) args

-- TC 诊断带位置（`文件:行:列: [CODE] 消息`）。
-- 本模块**不**依赖 `Elab/Types`（避免 Elab ↔ Diagnostics 成环）：位置前缀由
-- Diagnostics.Common 拼，与 `Elab/Types.errAt` 的输出格式一致。
tcErr : {n : Nat} -> Span -> TcErr n -> Vec String n -> Result a
tcErr sp e args = diagErrAt sp (tcMsg e args)

-- ---------------------------------------------------------------
-- 人体工学：按 arity 分档的 throw（调用点不必手搓 Vec）
-- ---------------------------------------------------------------
tcErr0 : Span -> TcErr Zero -> Result a
tcErr0 sp e = tcErr sp e VNil

tcErr1 : Span -> TcErr (Succ Zero) -> String -> Result a
tcErr1 sp e a0 = tcErr sp e (VCons a0 VNil)

tcErr2 : Span -> TcErr (Succ (Succ Zero)) -> String -> String -> Result a
tcErr2 sp e a0 a1 = tcErr sp e (VCons a0 (VCons a1 VNil))

-- ---------------------------------------------------------------
-- 无位置版本：Core（Conv/Eval）等底层诊断拿不到 Span，但仍要走同一套码与模板。
-- 输出形态是无前缀的 `[CODE] 消息`（与带位置的 `文件:行:列: [CODE] 消息` 区分）。
-- ---------------------------------------------------------------
tcErr0NoLoc : TcErr Zero -> Result a
tcErr0NoLoc e = Err (tcMsg e VNil)

tcErr1NoLoc : TcErr (Succ Zero) -> String -> Result a
tcErr1NoLoc e a0 = Err (tcMsg e (VCons a0 VNil))

tcErr2NoLoc : TcErr (Succ (Succ Zero)) -> String -> String -> Result a
tcErr2NoLoc e a0 a1 = Err (tcMsg e (VCons a0 (VCons a1 VNil)))
