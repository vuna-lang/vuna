tcCode ReprTransparentInvalid = "TC_ReprTransparentInvalid"
tcCode RecordDuplicateField = "TC_RecordDuplicateField"
tcCode (RecordMissingField _) = "TC_RecordMissingField"
tcCode (RecordUnknownField _) = "TC_RecordUnknownField"
tcCode (UnknownRecord _) = "TC_UnknownRecord"
tcCode (DeriveCtorFieldCount _) = "TC_DeriveCtorFieldCount"
tcCode (DeriveFieldType _ _ _) = "TC_DeriveFieldType"
