module Vuna.Compiler.Diagnostics.Tc
  ( TcEntry(..)
  , TcErr(..)
  , tcAll
  , tcCode
  , tcCoverageMissing
  , tcErr
  , tcErr0
  , tcErr0NoLoc
  , tcErr1
  , tcErr1NoLoc
  , tcErr2
  , tcErr2NoLoc
  , tcErr3
  , tcMsg
  , tcTemplate
  , tcTypeMismatch
  , tcTypeMismatchNoLoc
  ) where

-- Vuna.Compiler.Diagnostics.Tc：TC_ 域（精化 / 终止性 / 覆盖性诊断）。
--
-- 从 `Vuna.Compiler.Diagnostics` 拆出（M30 B19）；对外名字集合不变，门面仍是
-- `Vuna.Compiler.Diagnostics`（选择性重导出，调用点零改动）。
-- arity 由 `TcErr : Nat -> Type` 的构造子索引在编译期锁定（`UnknownName : String ->
-- TcErr (Succ Zero)`），throw 点给 `Vec n String`——arity 拼错**编译失败**。
-- 模板/说明/码的派生都在本模块；`tcAll` 是 `gen-errors` 的文档遍历源。
--
-- 约定：符号语义稳定、只增不删；一个码只承载一种语义；占位符 `<k>` 每个只出现一次。
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Common
import Base.Nat
import Base.Vec

-- ---------------------------------------------------------------
-- TC_：精化 / 终止性 / 覆盖性诊断（Elab）
-- arity = 构造子索引；String payload = 消息模板（占位符 `<0>` `<1>`…）
-- ---------------------------------------------------------------
data TcErr : Nat -> Type where
  -- arity 0
  BoolCaseRestriction : TcErr Zero
  CaseBranchTooFewArgs : TcErr Zero
  CatchAllNotLast : TcErr Zero
  ClauseTooManyPatterns : TcErr Zero
  DataKindArrows : TcErr Zero
  DefMoreParams : TcErr Zero
  DefParamsMustBeVars : TcErr Zero
  DoUnsupported : TcErr Zero
  FunctionNoClauses : TcErr Zero
  HoleNoExpectedType : TcErr Zero
  ImplicitParamKind : TcErr Zero
  ImpossibleBranchEmptyCtx : TcErr Zero
  ImpossibleBranchIndex : TcErr Zero
  IndexFuel : TcErr Zero
  InstanceHeadNotApp : TcErr Zero
  ConstraintNotDict : TcErr Zero
  InstanceMissingMethod : TcErr Zero
  OrphanInstance : TcErr Zero
  InterfaceNoParam : TcErr Zero
  IntStringCaseNeedsFallback : TcErr Zero
  IntStringCaseRestriction : TcErr Zero
  InvalidArrowType : TcErr Zero
  LambdaNoSignature : TcErr Zero
  LambdaTooManyParams : TcErr Zero
  NestedPatterns : TcErr Zero
  NatLiteralOutOfRange : TcErr Zero
  NotInductiveFamily : TcErr Zero
  OnlyCtorPatterns : TcErr Zero
  PatternFuel : TcErr Zero
  RecordsUnsupported : TcErr Zero
  TooManyArgs : TcErr Zero
  TypeLevelArg : TcErr Zero
  TypeMismatchCaseCount : TcErr Zero
  TypeMismatchCtorArity : TcErr Zero
  UniverseLevelNonNegative : TcErr Zero
  -- arity 1
  AxiomWithDefinition : String -> TcErr (Succ Zero)
  BranchTooManyArgs : String -> TcErr (Succ Zero)
  CannotProveTermination : String -> TcErr (Succ Zero)
  CannotRedefineBuiltin : String -> TcErr (Succ Zero)
  CannotSolveMetavar : String -> TcErr (Succ Zero)
  CannotSolveHigherOrder : String -> TcErr (Succ Zero)
  CannotSolveOccurs : String -> TcErr (Succ Zero)
  TypeMismatchCaseVars : String -> TcErr (Succ Zero)
  DuplicateInstance : String -> TcErr (Succ Zero)
  InstanceContextMissing : String -> TcErr (Succ Zero)
  OverlappingInstances : String -> TcErr (Succ Zero)
  DuplicateSignature : String -> TcErr (Succ Zero)
  ExpectedSignature : String -> TcErr (Succ Zero)
  ExpectedType : String -> TcErr (Succ Zero)
  -- M33 W5：extern 签名超出受限 FFI 子集（基本类型 + 简单 Array）。
  FfiTypeUnsupported : String -> TcErr (Succ Zero)
  EqRequiresEvidence : String -> TcErr (Succ Zero)
  InstanceUnknownMethod : String -> TcErr (Succ Zero)
  NeedsTwoArgs : String -> TcErr (Succ Zero)
  NoInstanceFound : String -> TcErr (Succ Zero)
  -- M36：模板字符串插值（`${e}` → `Base.Interp.interp e`）找不到 `Interp`/`Show` 实例。
  InterpNoInstance : String -> TcErr (Succ Zero)
  NotExhaustive : String -> TcErr (Succ Zero)
  SignatureNoDef : String -> TcErr (Succ Zero)
  UnknownInterface : String -> TcErr (Succ Zero)
  UnknownName : String -> TcErr (Succ Zero)
  UnsolvedHole : String -> TcErr (Succ Zero)
  UnsolvedMetavarInfer : String -> TcErr (Succ Zero)
  -- M38（QTT）：用量检查。
  LinearUnused : String -> TcErr (Succ Zero)
  LinearOverused : String -> TcErr (Succ Zero)
  ErasedBinderUsed : String -> TcErr (Succ Zero)
  MultiplicityImplicit : String -> TcErr (Succ Zero)
  MultiplicityTypeDomain : String -> TcErr (Succ Zero)
  LinearTypeNeedsOne : String -> TcErr (Succ Zero)
  LinearValueNeedsLinearBinder : String -> TcErr (Succ Zero)
  LinearTopLevel : String -> TcErr (Succ Zero)
  LinearCaptureEscapes : String -> TcErr (Succ Zero)
  -- F3-1：效果运行入口仍有未处理效应（行必须为 Nil）。
  UnhandledEffects : String -> TcErr (Succ Zero)
  -- F3 B：release 构建里的 debug-only 构造（assert / todo）。
  DebugConstructInRelease : String -> TcErr (Succ Zero)
  -- D17：入口 `main` 不能带参数（结果类型拆掉 `IO` 后是函数类型即 arity 错误）。
  MainArity : String -> TcErr (Succ Zero)
  -- native-effects N1（ND9）：`perform` 找不到 res 族（`res<族短名>`）。
  EffResFamilyMissing : String -> TcErr (Succ Zero)
  -- arity 2
  AmbiguousCtor : String -> String -> TcErr (Succ (Succ Zero))
  AmbiguousInstance : String -> String -> TcErr (Succ (Succ Zero))
  AppliedNotType : String -> TcErr (Succ Zero)
  CtorDoesNotReturn : String -> String -> TcErr (Succ (Succ Zero))
  CtorError : String -> String -> TcErr (Succ (Succ Zero))
  CtorWrongIndices : String -> String -> TcErr (Succ (Succ Zero))
  NotTraitMethod : String -> String -> TcErr (Succ (Succ Zero))
  OpNotDefinedFor : String -> String -> TcErr (Succ (Succ Zero))
  OpOnlyIntString : String -> String -> TcErr (Succ (Succ Zero))
  UnknownConstructorInCase : String -> String -> TcErr (Succ (Succ Zero))
  UnsolvedMetavar : String -> String -> TcErr (Succ (Succ Zero))
  TypeMismatch : String -> String -> TcErr (Succ (Succ Zero))
  TypeMismatchCaseBranch : String -> String -> TcErr (Succ (Succ Zero))
  WhereNeedsSig : String -> String -> TcErr (Succ (Succ Zero))
  -- M42：`deriving via field` 只允许自动去装箱的单字段包装。
  DerivingViaUnboxedRequired : TcErr Zero
  -- R1（records-v2）：`transparent record` 声明不满足「擦除后恰好一个运行时字段」（含递归）。
  ReprTransparentInvalid : TcErr Zero
  RecordDuplicateField : TcErr Zero
  RecordMissingField : String -> TcErr (Succ Zero)
  RecordUnknownField : String -> TcErr (Succ Zero)
  UnknownRecord : String -> TcErr (Succ Zero)
  DeriveCtorFieldCount : String -> TcErr (Succ Zero)
  DeriveFieldType : String -> String -> String -> TcErr (Succ (Succ (Succ Zero)))
  DeriveSingleCtor : String -> TcErr (Succ Zero)
  DeriveUnsupportedKind : String -> TcErr (Succ Zero)

-- ---------------------------------------------------------------
-- code 派生（唯一真源；`gen-errors` 与 throw 都用它）
-- ---------------------------------------------------------------
-- | 自动补注（M41 新增导出）：tcCode。
tcCode : {n : Nat} -> TcErr n -> String
tcCode BoolCaseRestriction = "TC_BoolCaseRestriction"
tcCode CaseBranchTooFewArgs = "TC_CaseBranchTooFewArgs"
tcCode CatchAllNotLast = "TC_CatchAllNotLast"
tcCode ClauseTooManyPatterns = "TC_ClauseTooManyPatterns"
tcCode DataKindArrows = "TC_DataKindArrows"
tcCode DefMoreParams = "TC_DefMoreParams"
tcCode DefParamsMustBeVars = "TC_DefParamsMustBeVars"
tcCode DoUnsupported = "TC_DoUnsupported"
tcCode FunctionNoClauses = "TC_FunctionNoClauses"
tcCode HoleNoExpectedType = "TC_HoleNoExpectedType"
tcCode ImplicitParamKind = "TC_ImplicitParamKind"
tcCode ImpossibleBranchEmptyCtx = "TC_ImpossibleBranchEmptyCtx"
tcCode ImpossibleBranchIndex = "TC_ImpossibleBranchIndex"
tcCode IndexFuel = "TC_IndexFuel"
tcCode InstanceHeadNotApp = "TC_InstanceHeadNotApp"
tcCode ConstraintNotDict = "TC_ConstraintNotDict"
tcCode InstanceMissingMethod = "TC_InstanceMissingMethod"
tcCode OrphanInstance = "TC_OrphanInstance"
tcCode InterfaceNoParam = "TC_InterfaceNoParam"
tcCode IntStringCaseNeedsFallback = "TC_IntStringCaseNeedsFallback"
tcCode IntStringCaseRestriction = "TC_IntStringCaseRestriction"
tcCode InvalidArrowType = "TC_InvalidArrowType"
tcCode LambdaNoSignature = "TC_LambdaNoSignature"
tcCode LambdaTooManyParams = "TC_LambdaTooManyParams"
tcCode NestedPatterns = "TC_NestedPatterns"
tcCode NatLiteralOutOfRange = "TC_NatLiteralOutOfRange"
tcCode NotInductiveFamily = "TC_NotInductiveFamily"
tcCode OnlyCtorPatterns = "TC_OnlyCtorPatterns"
tcCode PatternFuel = "TC_PatternFuel"
tcCode RecordsUnsupported = "TC_RecordsUnsupported"
tcCode TooManyArgs = "TC_TooManyArgs"
tcCode TypeLevelArg = "TC_TypeLevelArg"
tcCode TypeMismatchCaseCount = "TC_TypeMismatchCaseCount"
tcCode TypeMismatchCtorArity = "TC_TypeMismatchCtorArity"
tcCode UniverseLevelNonNegative = "TC_UniverseLevelNonNegative"
tcCode (AxiomWithDefinition _) = "TC_AxiomWithDefinition"
tcCode (BranchTooManyArgs _) = "TC_BranchTooManyArgs"
tcCode (CannotProveTermination _) = "TC_CannotProveTermination"
tcCode (CannotRedefineBuiltin _) = "TC_CannotRedefineBuiltin"
tcCode (CannotSolveMetavar _) = "TC_CannotSolveMetavar"
tcCode (CannotSolveHigherOrder _) = "TC_CannotSolveHigherOrder"
tcCode (CannotSolveOccurs _) = "TC_CannotSolveOccurs"
tcCode (LinearUnused _) = "TC_LinearUnused"
tcCode (LinearOverused _) = "TC_LinearOverused"
tcCode (ErasedBinderUsed _) = "TC_ErasedBinderUsed"
tcCode (MultiplicityImplicit _) = "TC_MultiplicityImplicit"
tcCode (MultiplicityTypeDomain _) = "TC_MultiplicityTypeDomain"
tcCode (LinearTypeNeedsOne _) = "TC_LinearTypeNeedsOne"
tcCode (LinearValueNeedsLinearBinder _) = "TC_LinearValueNeedsLinearBinder"
tcCode (LinearTopLevel _) = "TC_LinearTopLevel"
tcCode (LinearCaptureEscapes _) = "TC_LinearCaptureEscapes"
tcCode (UnhandledEffects _) = "TC_UnhandledEffects"
tcCode (DebugConstructInRelease _) = "TC_DebugConstructInRelease"
tcCode (MainArity _) = "TC_MainArity"
tcCode (TypeMismatchCaseVars _) = "TC_TypeMismatchCaseVars"
tcCode (DuplicateInstance _) = "TC_DuplicateInstance"
tcCode (InstanceContextMissing _) = "TC_InstanceContextMissing"
tcCode (OverlappingInstances _) = "TC_OverlappingInstances"
tcCode (DuplicateSignature _) = "TC_DuplicateSignature"
tcCode (ExpectedSignature _) = "TC_ExpectedSignature"
tcCode (ExpectedType _) = "TC_ExpectedType"
tcCode (FfiTypeUnsupported _) = "TC_FfiTypeUnsupported"
tcCode (EqRequiresEvidence _) = "TC_EqRequiresEvidence"
tcCode (InstanceUnknownMethod _) = "TC_InstanceUnknownMethod"
tcCode (NeedsTwoArgs _) = "TC_NeedsTwoArgs"
tcCode (NoInstanceFound _) = "TC_NoInstanceFound"
tcCode (InterpNoInstance _) = "TC_InterpNoInstance"
tcCode (NotExhaustive _) = "TC_NotExhaustive"
tcCode (SignatureNoDef _) = "TC_SignatureNoDef"
tcCode (UnknownInterface _) = "TC_UnknownInterface"
tcCode (UnknownName _) = "TC_UnknownName"
tcCode (UnsolvedHole _) = "TC_UnsolvedHole"
tcCode (UnsolvedMetavarInfer _) = "TC_UnsolvedMetavarInfer"
tcCode (EffResFamilyMissing _) = "TC_EffResFamilyMissing"
tcCode (AmbiguousCtor _ _) = "TC_AmbiguousCtor"
tcCode (AmbiguousInstance _ _) = "TC_AmbiguousInstance"
tcCode (AppliedNotType _) = "TC_AppliedNotType"
tcCode (CtorDoesNotReturn _ _) = "TC_CtorDoesNotReturn"
tcCode (CtorError _ _) = "TC_CtorError"
tcCode (CtorWrongIndices _ _) = "TC_CtorWrongIndices"
tcCode (NotTraitMethod _ _) = "TC_NotTraitMethod"
tcCode (OpNotDefinedFor _ _) = "TC_OpNotDefinedFor"
tcCode (OpOnlyIntString _ _) = "TC_OpOnlyIntString"
