-- ---------------------------------------------------------------
-- throw：构造结构化诊断（code/template 仍由本域枚举唯一持有）
-- ---------------------------------------------------------------
tcMsg : {n : Nat} -> TcErr n -> Vec n String -> Diagnostic
tcMsg e args = mkDiag SevError PhElab CatTypes (tcCode e) (diagBody (tcTemplate e) args)

-- TC 诊断带位置（渲染器负责 `文件:行:列: [CODE] 消息`）。
tcErr : {n : Nat} -> Span -> TcErr n -> Vec n String -> Check a
tcErr sp e args = ErrC (withDiagSpan sp (tcMsg e args))

-- ---------------------------------------------------------------
-- 人体工学：按 arity 分档的 throw（调用点不必手搓 Vec）
-- ---------------------------------------------------------------
-- | 自动补注（M41 新增导出）：tcErr0。
tcErr0 : Span -> TcErr Zero -> Check a
tcErr0 sp e = tcErr sp e []

-- | 自动补注（M41 新增导出）：tcErr1。
tcErr1 : Span -> TcErr (Succ Zero) -> String -> Check a
tcErr1 sp e a0 = tcErr sp e [a0]

-- | 自动补注（M41 新增导出）：tcErr2。
tcErr2 : Span -> TcErr (Succ (Succ Zero)) -> String -> String -> Check a
tcErr2 sp e a0 a1 = tcErr sp e [a0, a1]

-- ---------------------------------------------------------------
-- 无位置版本：Core（Conv/Eval）等底层诊断拿不到 Span，但仍要走同一套码与模板。
-- 输出形态是无前缀的 `[CODE] 消息`（与带位置的 `文件:行:列: [CODE] 消息` 区分）。
-- ---------------------------------------------------------------
-- | 自动补注（M41 新增导出）：tcErr0NoLoc。
tcErr0NoLoc : TcErr Zero -> Check a
tcErr0NoLoc e = ErrC (tcMsg e [])

-- | 自动补注（M41 新增导出）：tcErr1NoLoc。
tcErr1NoLoc : TcErr (Succ Zero) -> String -> Check a
tcErr1NoLoc e a0 = ErrC (tcMsg e [a0])

-- | 自动补注（M41 新增导出）：tcErr2NoLoc。
tcErr2NoLoc : TcErr (Succ (Succ Zero)) -> String -> String -> Check a
tcErr2NoLoc e a0 a1 = ErrC (tcMsg e [a0, a1])

-- ---------------------------------------------------------------
-- 类型不匹配：code + expected/found 机器可读字段（LSP/JSON 不解析散文）。
-- ---------------------------------------------------------------
-- | 诊断构造辅助：tcTypeMismatch（code/template 见本模块目录）。
tcTypeMismatch : Span -> String -> String -> Check a
tcTypeMismatch sp expected found =
  ErrC
    (withField (FieldFound found) (withField (FieldExpected expected) (withDiagSpan sp (withTrace (TraceFrame PhUnify "unify: expected ${expected}" Nothing []) (withTrace (TraceFrame PhUnify "unify: found ${found}" Nothing []) (tcMsg (TypeMismatch expected found) [expected, found]))))))

-- | 诊断构造辅助：tcTypeMismatchNoLoc（code/template 见本模块目录）。
tcTypeMismatchNoLoc : String -> String -> Check a
tcTypeMismatchNoLoc expected found =
  ErrC
    (withField (FieldFound found) (withField (FieldExpected expected) (withTrace (TraceFrame PhUnify "unify: expected ${expected}" Nothing []) (withTrace (TraceFrame PhUnify "unify: found ${found}" Nothing []) (tcMsg (TypeMismatch expected found) [expected, found])))))

-- | 诊断构造辅助：tcErr3（code/template 见本模块目录）。
tcErr3 : Span -> TcErr (Succ (Succ (Succ Zero))) -> String -> String -> String -> Check a
tcErr3 sp e a0 a1 a2 = tcErr sp e [a0, a1, a2]

-- | 覆盖性：把所有不可达/未覆盖的构造子一次性列出（每个构造子进 `fields.candidates`）。
-- | 诊断构造辅助：tcCoverageMissing（code/template 见本模块目录）。
tcCoverageMissing : Span -> List String -> Check a
tcCoverageMissing sp names =
  let
    joined = join ", " names
    cands = map (\n => Candidate n Nothing (Just "not covered by any branch")) names
  in ErrC (withField (FieldCandidates cands) (withDiagSpan sp (tcMsg (NotExhaustive joined) [joined])))
