module Vuna.Compiler.CompilerCli (runCompilerCli, runCompilerCliFor, compilerUsageLines) where

-- Vuna.Compiler.CompilerCli：编译器自己的 CLI（vuna-compiler）。
--
-- 只包含“把源码变成 OCaml / seed”需要的命令：compile / check / build / seed；
-- 工具命令（lint / interp / test / fmt / repl / doc）在 Vuna.Cli。
-- compiler/app/Main.vuna 的入口闭包就是 seed 闭包。
--
-- CLI 只有 typed codegen 一条路径；旧的 dynamic 开关（--no-typecheck /
-- --typecheck / --typed）已删除。--no-print 只用于 compile 的调试/测试场景。
import Vuna.Compiler.Common
import Vuna.Compiler.Pkg
import Vuna.Compiler.Compile
import Vuna.Compiler.SplitCli
import Vuna.Compiler.Process

compilerUsageLines : String -> String
compilerUsageLines prog =
  "  "
    ++ prog
    ++ " compile [--dt] [--no-print] [--root DIR]... <entry.vuna> [out.ml]\n"
    ++ "  "
    ++ prog
    ++ " compile --package [--out OUT] [DIR]   包级 codegen 到 OUT（默认 DIR/.output）\n"
    ++ "  "
    ++ prog
    ++ " check [--dt] [--root DIR]... (<entry.vuna> | <package-dir>)\n"
    ++ "  "
    ++ prog
    ++ " build [--no-compile] [DIR]    包级 compile + ocamlopt → .output/bin/<name>\n"
    ++ "  "
    ++ prog
    ++ " build --split OUT [DIR]        分离编译：逐模块 OCaml 源码 + build.sh 写到 OUT\n"
    ++ "  "
    ++ prog
    ++ " seed [OUT [DIR]]               生成多文件 seed（默认 OUT=seed，DIR=.）\n"
    ++ "  --dt                            experimental DT (core TT) single-file pipeline (M13)\n"
    ++ "  "
    ++ prog
    ++ " help, -h\n"

compilerUsage prog = "usage:\n" ++ compilerUsageLines prog

runCompilerCli : List String -> Int
runCompilerCli args = runCompilerCliFor "vuna-compiler" args

runCompilerCliFor : String -> List String -> Int
runCompilerCliFor prog args = if anyHelp args then helpFor prog else runCompilerCliFor1 prog args

runCompilerCliFor1 prog args = case args of
  [] => usageErr prog
  arg :: rest => case arg of
    "compile" => compileArgs prog rest
    "check" => checkArgs prog rest
    "build" => if anyDt rest then dtCmdErr prog else buildArgs prog rest
    "seed" => if anyDt rest then dtCmdErr prog else seedArgs prog rest
    "help" => helpFor prog
    "--no-typecheck" => removedFlag prog arg
    "--typecheck" => removedFlag prog arg
    "--typed" => removedFlag prog arg
    "--out" => removedFlag prog arg
    _ => if startsWith "-" arg then missingCommand prog arg else unknownCommand prog arg

anyHelp : List String -> Bool
anyHelp [] = False
anyHelp (arg :: rest) = if arg == "-h" || arg == "--help" then True else anyHelp rest

helpFor prog =
  let
    _ = print (compilerUsage prog)
  in 0

usageErr prog =
  let
    _ = print (compilerUsage prog)
  in 2

missingCommand prog arg =
  let
    msg =
      "error: missing command before `"
        ++ arg
        ++ "`\n"
        ++ "run `"
        ++ prog
        ++ " help` (or `"
        ++ prog
        ++ " compile ...`)\n"
  in let
    _ = print msg
  in 2

unknownCommand prog arg =
  let
    _ = print ("error: unknown command `" ++ arg ++ "`\n" ++ "run `" ++ prog ++ " help`\n")
  in 2

removedHint flag = case flag of
  "--no-typecheck" => "use `vuna interp` for unchecked execution"
  "--typecheck" => "typed codegen is always enabled"
  "--typed" => "typed codegen is always enabled"
  "--out" => "use the positional OUT argument"
  _ => ""

removedFlag prog flag = case removedHint flag of
  "" => usageErr prog
  hint =>
    let
      _ = print ("error: " ++ flag ++ " has been removed; " ++ hint ++ "\n")
    in 2

invalidFlag prog flag = case flag of
  "--no-print" =>
    let
      _ =
        print "error: --no-print is only valid for `compile`; `build` never prints main's result\n"
    in 2
  _ => removedFlag prog flag

anyDt : List String -> Bool
anyDt [] = False
anyDt (arg :: rest) = if arg == "--dt" then True else anyDt rest

dtCmdErr prog =
  let
    _ = print "error: --dt is only supported by compile/check/interp (M13 single-file mode)\n"
  in 2

dtRootErr prog =
  let
    _ = print "error: --dt does not support --root yet (DT single-file mode)\n"
  in 2

dtDirErr prog =
  let
    _ = print "error: --dt only supports a single file (DT packages come later)\n"
  in 2

-- ---------------------------------------------------------------
-- compile / check（文件模式）
-- ---------------------------------------------------------------
compileArgs prog args = case args of
  "--package" :: rest => packageParse prog Nothing Nothing rest
  _ => compileParse prog True False False [] args

-- compile --package [--out OUT] [DIR]
packageParse prog dir out args = case args of
  [] => packageRun prog (defaultDir dir) (defaultPackageOut dir out)
  arg :: rest => case arg of
    "--out" => packageOutArg prog dir out rest
    "--dt" => dtCmdErr prog
    _ => if startsWith "-" arg then removedFlag prog arg
    else case dir of
      Nothing => packageParse prog (Just arg) out rest
      Just _ => usageErr prog

packageOutArg prog dir out rest = case rest of
  value :: rest2 => case out of
    Nothing => packageParse prog dir (Just value) rest2
    Just _ => usageErr prog
  [] => usageErr prog

defaultPackageOut dir out = case out of
  Just out2 => out2
  Nothing => defaultDir dir ++ "/.output"

packageRun prog dir out = case compilePackage dir out of
  Err e =>
    let
      _ = print ("error: " ++ e ++ "\n")
    in 1
  Ok n =>
    let
      _ = print ("wrote " ++ strFromInt n ++ " files to " ++ out ++ "\n")
    in 0

compileParse prog printResult dt hasRoot roots args = case args of
  [] => usageErr prog
  arg :: rest => case arg of
    "--dt" => compileParse prog printResult True hasRoot roots rest
    "--no-print" => compileParse prog False dt hasRoot roots rest
    "--root" =>
      rootArg prog roots rest (\roots2, rest2 => compileParse prog printResult dt True roots2 rest2)
    _ =>
      if startsWith "-" arg then removedFlag prog arg
      else compileEmit prog printResult dt hasRoot roots arg rest

rootArg prog roots rest k = case rest of
  dir :: rest2 => k (append roots [rawRoot dir]) rest2
  [] => usageErr prog

compileEmit prog printResult dt hasRoot roots entry rest = if dt then case compileFileDt (map rootDir roots) entry printResult of
  Ok code => case rest of
    [] =>
      let
        _ = print code
      in 0
    [out] =>
      let
        _ = writeFile out code
      in 0
    _ => usageErr prog
  Err e =>
    let
      _ = print ("error: " ++ e ++ "\n")
    in 1
else
  let
    actualRoots = effectiveRoots roots
  in case compileFileTyped actualRoots entry printResult of
    Ok code => case rest of
      [] =>
        let
          _ = print code
        in 0
      [out] =>
        let
          _ = writeFile out code
        in 0
      _ => usageErr prog
    Err e =>
      let
        _ = print ("error: " ++ e ++ "\n")
      in 1

checkArgs prog args = checkParse prog False False [] args

checkParse prog dt hasRoot roots args = case args of
  "--dt" :: rest => checkParse prog True hasRoot roots rest
  "--root" :: rest =>
    rootArg prog roots rest (\roots2, rest2 => checkParse prog dt True roots2 rest2)
  [arg] =>
    if startsWith "-" arg then removedFlag prog arg
    else if dt then checkEmitDt (map rootDir roots) arg
    else if isDirectory arg then checkPackage arg else checkEmit (effectiveRoots roots) arg
  _ => usageErr prog

checkEmitDt roots path = case checkFileDt roots path of
  Err e =>
    let
      _ = print ("error: " ++ e ++ "\n")
    in 1
  Ok warnings =>
    let
      _ = printWarnings warnings
    in 0

checkEmit roots path = case checkFile roots path of
  Err e =>
    let
      _ = print ("error: " ++ e ++ "\n")
    in 1
  Ok warnings =>
    let
      _ = printWarnings warnings
    in 0

printWarnings [] = 0
printWarnings (w :: rest) =
  let
    _ = print (w ++ "\n")
  in printWarnings rest

checkPackage dir = case loadPackage dir of
  Err e =>
    let
      _ = print ("error: " ++ e ++ "\n")
    in 1
  Ok pkg => if fileExists (packageEntry pkg) then checkPkgEntry pkg else checkPkgLibrary pkg

checkPkgEntry pkg = case checkFileIn (packageName pkg) (packageRoots pkg) (packageEntry pkg) of
  Err e =>
    let
      _ = print ("error: " ++ e ++ "\n")
    in 1
  Ok warnings =>
    let
      _ = printWarnings warnings
    in 0

checkPkgLibrary pkg = case packageExports pkg of
  Nothing =>
    let
      _ =
        print ("error: check: library package " ++ packageName pkg ++ " has no [export].modules\n")
    in 1
  Just names => case checkPackageIn (packageName pkg) (packageRoots pkg) names of
    Err e =>
      let
        _ = print ("error: " ++ e ++ "\n")
      in 1
    Ok warnings =>
      let
        _ = printWarnings warnings
      in 0

-- ---------------------------------------------------------------
-- build（包模式）
-- ---------------------------------------------------------------
buildArgs prog args = case args of
  ["--split"] => usageErr prog
  "--split" :: outDir :: rest => buildSplitCmd prog outDir rest
  _ => buildParse prog Nothing False args

buildSplitCmd prog outDir args = case args of
  [] => splitRun outDir "."
  [dir] => if startsWith "-" dir then invalidFlag prog dir else splitRun outDir dir
  _ => usageErr prog

splitRun outDir dir =
  let
    _ = makeDir outDir
  in case buildSplit dir outDir of
    Err e =>
      let
        _ = print ("error: " ++ e ++ "\n")
      in 1
    Ok n =>
      let
        _ = print ("wrote " ++ strFromInt n ++ " files to " ++ outDir ++ "\n")
      in 0

seedArgs prog args = case args of
  [] => seedRun "seed" "."
  out :: rest => if startsWith "-" out then invalidFlag prog out
  else case rest of
    [] => seedRun out "."
    [dir] => if startsWith "-" dir then invalidFlag prog dir else seedRun out dir
    _ => usageErr prog

seedRun out dir =
  let
    _ = makeDir out
  in case seedSplit dir out of
    Err e =>
      let
        _ = print ("error: " ++ e ++ "\n")
      in 1
    Ok n =>
      let
        _ = print ("wrote " ++ strFromInt n ++ " files to " ++ out ++ "\n")
      in 0

buildParse prog dir noCompile args = case args of
  [] => buildRun prog (defaultDir dir) noCompile
  arg :: rest => case arg of
    "--no-compile" => buildParse prog dir True rest
    _ => if startsWith "-" arg then invalidFlag prog arg
    else case dir of
      Nothing => buildParse prog (Just arg) noCompile rest
      Just _ => usageErr prog

defaultDir : Maybe String -> String
defaultDir dir = case dir of
  Just dir2 => dir2
  Nothing => "."

defaultOutDir : String -> String
defaultOutDir dir = dir ++ "/.output"

scriptArg : String -> String
scriptArg out = if startsWith "/" out then out else "../" ++ out

buildRun prog dir noCompile = case loadPackage dir of
  Err e =>
    let
      _ = print ("error: " ++ e ++ "\n")
    in 1
  Ok pkg => buildPackage prog dir noCompile pkg

buildPackage prog dir noCompile pkg =
  if fileExists (packageEntry pkg) then buildExecutable dir noCompile pkg else errNoMain

errNoMain =
  let
    _ = print "error: build: package has no app/Main.vuna (use compile --package for libraries)\n"
  in 1

buildExecutable : String -> Bool -> Package -> Int
buildExecutable dir noCompile pkg =
  let
    name = packageName pkg
  in let
    outDir = defaultOutDir dir
  in if noCompile then runBuildScript dir name outDir
  else case compilePackage dir outDir of
    Err e =>
      let
        _ = print ("error: " ++ e ++ "\n")
      in 1
    Ok n =>
      let
        _ = print ("wrote " ++ strFromInt n ++ " files to .output\n")
      in runBuildScript dir name outDir

buildScriptArgs : String -> List String
buildScriptArgs bin = ["sh", ".output/build.sh", scriptArg bin]

runBuildScript : String -> String -> String -> Int
runBuildScript dir name outDir = if fileExists (outDir ++ "/build.sh") then
  let
    bin = ".output/bin/" ++ name
  in let
    code = runIn dir (buildScriptArgs bin)
  in if code == 0 then
    let
      _ = print ("built " ++ dir ++ "/" ++ bin ++ "\n")
    in 0
  else code
else
  let
    _ = print ("error: build: missing " ++ outDir ++ "/build.sh; run compile --package first\n")
  in 1
