-- | 内容寻址摘要原语：SHA-256 + 大输入内容键（预折叠）/ 内容地址。
module Vuna.Compiler.Hash
  ( Digest(..)
  , contentAddress
  , contentKey
  , digestHex
  , digestInt
  , digestIntOf
  , digestLanes
  , digestOfBytes
  , digestOfString
  , prehashOfString
  ) where

-- Vuna.Compiler.Hash：内容寻址的**格式层**（不含查询/缓存策略）。
--
-- 用途：缓存键、包身份（Merkle 根）、产物地址。不用于任何安全用途的密钥派生。
--
-- * 摘要 = **SHA-256**（FIPS 180-4），在本模块用 `Base.Bits` 的 32-bit 包装实现：
--   因此 OCaml 后端、将来的 wasm 后端与 `interp` 都能算出同一份内容地址——这是
--   D2（两端语义一致）与 D5（内容寻址）共同要求的。
-- * `Digest` 的 8 条 lane 就是 SHA-256 的 8 个 32-bit 大端字；`digestHex` 渲染成
--   标准的小写 64 位十六进制，`digestInt` 提供「必须落成 Int」位置的 63-bit 派生键。
-- * 本模块只做**摘要与预哈希**；规范编码（自定界原子文法 + 解码器 roundtrip）在
--   `Vuna.Compiler.Canonical`（D5：格式层，不随编译器/Marshal 漂移）。
import Base.Bits
import Base.List
import Base.String

-- | 8 个 32-bit 摘要字（大端序；即标准 SHA-256 的 64 位十六进制）。
record Digest where
  digestLanes : List Int

-- | 取摘要的 8 条 lane。
digestLanes : Digest -> List Int
digestLanes (Digest lanes) = lanes

-- | 字节序列（每项 0..255）→ 摘要。
digestOfBytes : List Int -> Digest
digestOfBytes bytes = Digest (sha256Bytes bytes)

-- | 字符串 → 摘要（按 UTF-8 字节）。
--
-- 直接按字节下标（`strAt`，O(1)）喂 SHA，**不**先 `strUnpack` 成列表：接口载荷可达
-- 数 MB，逐字节建 cons 会让 iface 哈希成为 check 的新热点。语义与 `digestOfBytes
-- (strUnpack s)` 完全相同（同一组字节、同一算法）。
digestOfString : String -> Digest
digestOfString s = Digest (sha256OfString s)

-- | 渲染成小写十六进制：每条 lane 8 位，共 64 位。
digestHex : Digest -> String
digestHex (Digest lanes) = strConcatMany (map hex8 lanes)

-- | 摘要 → 63-bit 派生键（`Int`）：8 条 lane 依次滚动折叠后掩到 `Int` 正区间。
--
-- 用途：必须落成 `Int` 的位置（排序键、缓存目录/文件名里的短 key、测试 runner 的
-- 分桶）。它是 SHA-256 的派生量，碰撞面约 2^-62，取代旧的 10-bit `strHash` 折叠与
-- 6-lane 盐（60-bit）实现；需要可移植/可展示的内容地址仍用 `digestHex`。
digestInt : Digest -> Int
digestInt (Digest lanes) = band (foldl (\h, lane => h * 1000003 + lane) 0 lanes) 4611686018427387903

-- | 字符串 → 63-bit 派生键（`digestInt` 的便捷入口）；对整串跑 SHA-256，只适合短输入。
digestIntOf : String -> Int
digestIntOf s = digestInt (digestOfString s)

-- | **内容键**（63-bit）`contentKey s = digestIntOf (prehashOfString s)`。
--
-- 用途：需要按内容判等/分桶的**大输入**（源文件、缓存 key 组合串）。先做 4-lane 63-bit
-- 多项式预折叠（O(n) 低常数，与 `payloadDigest` 同一威胁模型：无对手、只防意外碰撞），
-- 再对折叠串跑 SHA-256 并取 63-bit 派生键——因此**不再**对每个源文件逐字节跑语言内
-- SHA（那会让 `check` 的缓存 key 计算从 ~20ms 抬到数百 ms）。
contentKey : String -> Int
contentKey s = digestIntOf (prehashOfString s)

-- | **内容地址**（64 位十六进制）：`digestHex (digestOfString (prehashOfString s))`。
-- 与 `contentKey` 同一折叠，输出可展示/可比较的地址（ast 缓存 key、内容寻址文件名）。
contentAddress : String -> String
contentAddress s = digestHex (digestOfString (prehashOfString s))

-- ---------------------------------------------------------------
-- SHA-256（FIPS 180-4）
-- ---------------------------------------------------------------
-- | SHA-256 初始状态 H0（前 8 个素数平方根小数部分的前 32 位）。
shaInit : List Int
shaInit =
  [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]

-- | SHA-256 轮常量 K（前 64 个素数立方根小数部分的前 32 位）。
shaK : List Int
shaK =
  [ 1116352408,
    1899447441,
    3049323471,
    3921009573,
    961987163,
    1508970993,
    2453635748,
