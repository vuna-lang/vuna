module Vuna.Compiler.Version (vunaVersion) where

-- Vuna.Compiler.Version：vuna 版本号的唯一真源（编译器包进 seed）。
--
-- 用途：`vuna version` / `vuna --version`、`vuna-compiler version`、build meta 的
-- compiler 字段、VSCode 扩展探测服务器。发布前版本只在源码改这一处；Nix 包的
-- version 常量在 nix/common.nix（构建图无法读取 vuna 源码，需人工同步）。
vunaVersion : String
vunaVersion = "0.1.0"
