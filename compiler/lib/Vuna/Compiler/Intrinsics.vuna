module Vuna.Compiler.Intrinsics
  ( Capability(..)
  , IType(..)
  , Intrinsic
  , IntrinsicOp(..)
  , TypeIntrinsic(..)
  , allIntrinsics
  , arityOfType
  , boolFalseCtor
  , boolTrueCtor
  , boolTypeName
  , canonicalCtorsFor
  , capabilityName
  , capabilityNames
  , findIntrinsic
  , intTypeName
  , intrinsicArity
  , intrinsicCapability
  , intrinsicName
  , intrinsicOp
  , intrinsicReturnsIO
  , intrinsicRuntime
  , intrinsicSignature
  , intrinsicVisible
  , ioFamilyName
  , isEffectfulIntrinsic
  , isIntrinsicName
  , isIntrinsicTypeName
  , listConsCtor
  , listFamilyName
  , listNilCtor
  , needsListBridge
  , parseCapability
  , preludeTypeNames
  , preludeValueNames
  , strTypeName
  , typeIntrinsicArities
  , typeIntrinsicArityOf
  , typeIntrinsicCtorArity
  , typeIntrinsicCtorName
  , typeIntrinsicCtorNames
  , typeIntrinsicNames
  , userIntrinsics
  ) where

-- Vuna.Compiler.Intrinsics：**内建声明的唯一真源**（M27）。
--
-- 这里只有纯数据：内建/原语的名字、签名形状（IType）、interp 归约标签（IntrinsicOp）、
-- 所需能力（Capability）、OCaml runtime 名字，以及是否对用户源码可见。
-- 消费方：
--   - `Loader.Resolve`：名字解析（arity）、DT prelude 放行、效应能力检查；
--   - `Elab.Prelude`：构造 prelude globals（签名）；
--   - `Codegen.Term`：全局名 → runtime 表达式；
--   - `Core.Eval`：按 IntrinsicOp 归约。
--
-- 身份规则（M27）：内置实体按**声明的 symbol**判定，不按短名/lastName：
--   - Int / String 是语言 primitive 类型；Bool 是 base 的普通 data，canonical
--     `Base.Bool.Bool`（`True`/`False` 精化成 `TBool`）；
--   - List / IO 是 base 里的普通 data 声明，身份 = 完整限定名
--     `Base.List.List` / `Base.IO.IO`（见 `Loader`/`Codegen` 的常量）；
--   - 隐藏的内部 runtime 名（`bi_*`）只供 codegen 映射，不对用户源码可见。
import Vuna.Compiler.Common
import Base.HashMap

-- ---------------------------------------------------------------
-- 能力（capability）：显式、不可按包名伪造的效应声明面
-- ---------------------------------------------------------------
data Capability : Type where
  CapConsole : Capability
  CapFs : Capability
  CapProcess : Capability
  CapEnv : Capability
  CapClock : Capability
  -- 允许在 main 之外执行 IO 动作（`Base.IO.runIO`；工具链特权，M31）。
  CapUnsafe : Capability

capabilityName : Capability -> String
capabilityName CapConsole = "console"
capabilityName CapFs = "fs"
capabilityName CapProcess = "process"
capabilityName CapEnv = "env"
capabilityName CapClock = "clock"
capabilityName CapUnsafe = "unsafe"

capabilityNames : List String
capabilityNames = map capabilityName allCapabilities

allCapabilities : List Capability
allCapabilities = [CapConsole, CapFs, CapProcess, CapEnv, CapClock, CapUnsafe]

parseCapability : String -> Maybe Capability
parseCapability "console" = Just CapConsole
parseCapability "fs" = Just CapFs
parseCapability "process" = Just CapProcess
parseCapability "env" = Just CapEnv
parseCapability "clock" = Just CapClock
parseCapability "unsafe" = Just CapUnsafe
parseCapability _ = Nothing

-- ---------------------------------------------------------------
-- 签名形状：只表达内建签名需要的形状（不含依赖 pi / 多态细节）
-- ---------------------------------------------------------------
data IType : Type where
  -- 宇宙 `Type`（类型构造子 / 类型变量参数的域）
  ITy : IType
  IInt : IType
  IStr : IType
  IBool : IType
  -- `Base.List.List <arg>`：族身份固定为 base 的普通 data 声明
  IList : IType -> IType
  -- `Base.IO.IO <arg>`：效果原语返回的 IO 动作（M31 起效果原语类型化）
  IIO : IType -> IType
  IFun : IType -> IType -> IType
  -- M33 W3：内建类型构造子与签名里的类型变量。
  IVar : String -> IType
  IArray : IType -> IType
  IRef : IType -> IType
  IMArray : IType -> IType
  IBuf : IType
  -- 隐式类型参数绑定（`{a : Type} -> ...`）；不进函数 arity。
  IPi : String -> IType -> IType

arityOfType : IType -> Int
arityOfType (IFun _ cod) = 1 + arityOfType cod
arityOfType (IPi _ cod) = arityOfType cod
arityOfType _ = 0

-- ---------------------------------------------------------------
-- 内建类型构造子（M33 W3）
-- ---------------------------------------------------------------
-- 与 `Int` / `String` 两个 primitive 类型名不同，这些是**带参数的**类型构造子：
-- 名字恒可见（prelude 类型层），codegen 按固定 OCaml 类型渲染（见 Codegen.Decl）。
-- 参数个数的唯一真源在此；Elab.Prelude 据此生成 kind，Codegen.Decl 据此渲染。
data TypeIntrinsic : Type where
  MkTypeIntrinsic : String -> Int -> TypeIntrinsic

typeIntrinsicCtorName : TypeIntrinsic -> String
typeIntrinsicCtorName (MkTypeIntrinsic name arity) = name

typeIntrinsicCtorArity : TypeIntrinsic -> Int
typeIntrinsicCtorArity (MkTypeIntrinsic name arity) = arity

typeIntrinsicArities : List TypeIntrinsic
typeIntrinsicArities =
  [ MkTypeIntrinsic "Array" 1,
    MkTypeIntrinsic "IORef" 1,
    MkTypeIntrinsic "MArray" 1,
    MkTypeIntrinsic "Buffer" 0
  ]

-- `-1` = 不是内建类型构造子。
typeIntrinsicArityOf : String -> Int
typeIntrinsicArityOf name = typeIntrinsicArityOfRest name typeIntrinsicArities

typeIntrinsicArityOfRest : String -> List TypeIntrinsic -> Int
typeIntrinsicArityOfRest name [] = 0 - 1
typeIntrinsicArityOfRest name (t :: rest) =
  if typeIntrinsicCtorName t == name then typeIntrinsicCtorArity t
  else typeIntrinsicArityOfRest name rest

typeIntrinsicCtorNames : List String
typeIntrinsicCtorNames = map typeIntrinsicCtorName typeIntrinsicArities

-- prelude 类型层名字：primitive 类型 + 内建类型构造子（禁止重定义 + Loader 放行）。
preludeTypeNames : List String
preludeTypeNames = append typeIntrinsicNames typeIntrinsicCtorNames

-- ---------------------------------------------------------------
-- interp 归约标签（Core.Eval 按它归约；OpNone = 不在 interp 归约）
-- ---------------------------------------------------------------
data IntrinsicOp : Type where
  OpNone : IntrinsicOp
  OpAdd : IntrinsicOp
  OpSub : IntrinsicOp
  OpMul : IntrinsicOp
  OpDiv : IntrinsicOp
  OpEqInt : IntrinsicOp
  OpNeqInt : IntrinsicOp
  OpLtInt : IntrinsicOp
  OpLeInt : IntrinsicOp
  OpGtInt : IntrinsicOp
  OpGeInt : IntrinsicOp
  OpEqStr : IntrinsicOp
  OpNeqStr : IntrinsicOp
  OpLtGeneric : IntrinsicOp
  OpLeGeneric : IntrinsicOp
  OpGtGeneric : IntrinsicOp
  OpGeGeneric : IntrinsicOp
  OpConcat : IntrinsicOp
  OpAnd : IntrinsicOp
  OpOr : IntrinsicOp
  OpStrFromInt : IntrinsicOp
  OpStrLength : IntrinsicOp
  OpStrUnpack : IntrinsicOp
  OpStrPack : IntrinsicOp
  OpStrConcatMany : IntrinsicOp
  OpStrSubstTemplate : IntrinsicOp
  OpStrHash : IntrinsicOp
  OpStrAt : IntrinsicOp
  OpStrShow : IntrinsicOp

-- ---------------------------------------------------------------
-- 内建声明
-- ---------------------------------------------------------------
--
-- 字段：名字、签名形状、interp 归约标签、所需能力（Nothing = 纯）、runtime 表达式、
-- 是否对用户源码可见（False = 只供 codegen 映射的内部名）。
data Intrinsic : Type where
  MkIntrinsic : String -> IType -> IntrinsicOp -> Maybe Capability -> String -> Bool -> Intrinsic

intrinsicName : Intrinsic -> String
intrinsicName (MkIntrinsic name sig op cap runtime visible) = name

intrinsicSignature : Intrinsic -> IType
intrinsicSignature (MkIntrinsic name sig op cap runtime visible) = sig

intrinsicOp : Intrinsic -> IntrinsicOp
intrinsicOp (MkIntrinsic name sig op cap runtime visible) = op

intrinsicCapability : Intrinsic -> Maybe Capability
intrinsicCapability (MkIntrinsic name sig op cap runtime visible) = cap

intrinsicRuntime : Intrinsic -> String
intrinsicRuntime (MkIntrinsic name sig op cap runtime visible) = runtime

intrinsicVisible : Intrinsic -> Bool
intrinsicVisible (MkIntrinsic name sig op cap runtime visible) = visible

-- 该内建的 runtime 表达式依赖 canonical `Base.List.List` 桥接 helper（`dtp_*`）。
-- 没有 base 的包用这些内建时，生成前必须报错（而不是产出 Unbound value）。
needsListBridge : Intrinsic -> Bool
needsListBridge i = case intrinsicRuntime i of
  "dtp_unpack" => True
  "dtp_pack" => True
  "dtp_concatMany" => True
  "dtp_substTemplate" => True
  "(fun p -> dtp_listOf (dtp_readDir p))" => True
  "(dtp_listOf (dtp_getArgs ()))" => True
  "(fun dir args -> dtp_runIn dir (dtp_ocamlOf args))" => True
  "(fun xs -> Array.of_list (dtp_ocamlOf xs))" => True
  "(fun a -> dtp_listOf (Array.to_list a))" => True
  _ => False

-- canonical 族必须由 vuna-base 以固定的构造子集合声明；其它同名声明是非法伪造。
canonicalCtorsFor : String -> Maybe (List String)
canonicalCtorsFor name =
  if name == boolTypeName then Just [boolTrueCtor, boolFalseCtor]
  else if name == listFamilyName then Just [listNilCtor, listConsCtor]
  else if name == ioFamilyName then Just [ioMkIoCtor] else Nothing

intrinsicArity : Intrinsic -> Int
intrinsicArity i = arityOfType (intrinsicSignature i)

-- 签名尾部是 `IIO _`：该内建返回 IO 动作，codegen 必须把 runtime 表达式包成
-- `MkIO (fun _ -> …)` 值（M31；零参原语因此成为真正的值而不是每次求值的表达式）。
intrinsicReturnsIO : Intrinsic -> Bool
intrinsicReturnsIO i = typeReturnsIO (intrinsicSignature i)

typeReturnsIO : IType -> Bool
typeReturnsIO (IIO _) = True
typeReturnsIO (IFun _ cod) = typeReturnsIO cod
typeReturnsIO (IPi _ cod) = typeReturnsIO cod
typeReturnsIO _ = False

isEffectfulIntrinsic : Intrinsic -> Bool
isEffectfulIntrinsic i = case intrinsicCapability i of
  Just _ => True
  Nothing => False

-- 语言 primitive 类型名（Bool 不在其中：它是 base 的普通 data 声明）。
typeIntrinsicNames : List String
typeIntrinsicNames = [intTypeName, strTypeName]

intTypeName : String
intTypeName = "Int"

strTypeName : String
strTypeName = "String"

-- Bool 是 base 里的普通 data 声明：身份 = 完整符号 `Base.Bool.Bool`（M27）。
boolTypeName : String
boolTypeName = "Base.Bool.Bool"

boolTrueCtor : String
boolTrueCtor = "Base.Bool.True"

boolFalseCtor : String
boolFalseCtor = "Base.Bool.False"

-- 类型位置的放行面：primitive 类型名 + 内建类型构造子（M33 W3）。
isIntrinsicTypeName : String -> Bool
isIntrinsicTypeName name = memName name preludeTypeNames

-- base 里普通 data 声明的**完整符号身份**（不是短名）：List / IO 的判定只认它们。
listFamilyName : String
listFamilyName = "Base.List.List"

listNilCtor : String
listNilCtor = "Base.List.Nil"

listConsCtor : String
listConsCtor = "Base.List.Cons"

ioFamilyName : String
ioFamilyName = "Base.IO.IO"

ioMkIoCtor : String
ioMkIoCtor = "Base.IO.MkIO"

-- 所有内建声明。用户可见项进 Loader/prelude；内部 `bi_*` 只服务 codegen。
allIntrinsics : List Intrinsic
-- 效果原语（M27：只保留 `prim_*` 名；公开名删除，用户经 Base.IO 或显式能力）。
-- 精化器合成的比较/相等特化名（内部：不对用户源码可见）。
-- M33 W3：内建类型构造子 Array / IORef / MArray / Buffer 的原语。
-- 纯 Array 原语无能力；IORef / MArray / Buffer 都是 IO 动作（无能力：不触碰外部世界）。
-- 空数组字面量：non-expansive 的 OCaml `[||]`，让 `HashMap` 的空表这类零参多态值可泛化。
allIntrinsics =
  [ MkIntrinsic "+" (IFun IInt (IFun IInt IInt)) OpAdd Nothing "bi_add" True,
    MkIntrinsic "-" (IFun IInt (IFun IInt IInt)) OpSub Nothing "bi_sub" True,
    MkIntrinsic "*" (IFun IInt (IFun IInt IInt)) OpMul Nothing "bi_mul" True,
    MkIntrinsic "/" (IFun IInt (IFun IInt IInt)) OpDiv Nothing "bi_div" True,
    MkIntrinsic "++" (IFun IStr (IFun IStr IStr)) OpConcat Nothing "bi_concat" True,
    MkIntrinsic "&&" (IFun IBool (IFun IBool IBool)) OpAnd Nothing "bi_and" True,
    MkIntrinsic "||" (IFun IBool (IFun IBool IBool)) OpOr Nothing "bi_or" True,
    MkIntrinsic "strFromInt" (IFun IInt IStr) OpStrFromInt Nothing "bi_strFromInt" True,
    MkIntrinsic "strUnpack" (IFun IStr (IList IInt)) OpStrUnpack Nothing "dtp_unpack" True,
    MkIntrinsic "strPack" (IFun (IList IInt) IStr) OpStrPack Nothing "dtp_pack" True,
    MkIntrinsic "strLength" (IFun IStr IInt) OpStrLength Nothing "bi_strLength" True,
    MkIntrinsic "strConcatMany" (IFun (IList IStr) IStr) OpStrConcatMany Nothing "dtp_concatMany" True,
    MkIntrinsic "strSubstTemplate" (IFun IStr (IFun (IList IStr) IStr)) OpStrSubstTemplate Nothing "dtp_substTemplate" True,
    MkIntrinsic "timeUs" (IIO IInt) OpNone (Just CapClock) "(dtp_timeUs ())" True,
    MkIntrinsic "strHash" (IFun IStr IInt) OpStrHash Nothing "dtp_strHash" True,
    MkIntrinsic "strAt" (IFun IStr (IFun IInt IInt)) OpStrAt Nothing "dtp_strAt" True,
    MkIntrinsic "strShow" (IFun IStr IStr) OpStrShow Nothing "dt_show_string" True,
    MkIntrinsic "arrayLength" (IPi "a" (IFun (IArray (IVar "a")) IInt)) OpNone Nothing "Array.length" True,
    MkIntrinsic "arrayEmpty" (IPi "a" (IArray (IVar "a"))) OpNone Nothing "[||]" True,
    MkIntrinsic "arrayGet" (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IVar "a")))) OpNone Nothing "Array.get" True,
    MkIntrinsic "arraySet" (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IArray (IVar "a")))))) OpNone Nothing "dtp_arraySet" True,
    MkIntrinsic "arrayMake" (IPi "a" (IFun IInt (IFun (IVar "a") (IArray (IVar "a"))))) OpNone Nothing "Array.make" True,
    MkIntrinsic "arrayFromList" (IPi "a" (IFun (IList (IVar "a")) (IArray (IVar "a")))) OpNone Nothing "(fun xs -> Array.of_list (dtp_ocamlOf xs))" True,
    MkIntrinsic "arrayToList" (IPi "a" (IFun (IArray (IVar "a")) (IList (IVar "a")))) OpNone Nothing "(fun a -> dtp_listOf (Array.to_list a))" True,
    MkIntrinsic "prim_newRef" (IPi "a" (IFun (IVar "a") (IIO (IRef (IVar "a"))))) OpNone Nothing "(fun x -> ref x)" True,
    MkIntrinsic "prim_readRef" (IPi "a" (IFun (IRef (IVar "a")) (IIO (IVar "a")))) OpNone Nothing "(fun r -> !r)" True,
    MkIntrinsic "prim_writeRef" (IPi "a" (IFun (IRef (IVar "a")) (IFun (IVar "a") (IIO IInt)))) OpNone Nothing "(fun r v -> r := v; 0)" True,
    MkIntrinsic "prim_newMArray" (IPi "a" (IFun IInt (IFun (IVar "a") (IIO (IMArray (IVar "a")))))) OpNone Nothing "(fun n v -> Array.make n v)" True,
    MkIntrinsic "prim_readMArray" (IPi "a" (IFun (IMArray (IVar "a")) (IFun IInt (IIO (IVar "a"))))) OpNone Nothing "(fun a i -> Array.get a i)" True,
    MkIntrinsic "prim_writeMArray" (IPi "a" (IFun (IMArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IIO IInt))))) OpNone Nothing "(fun a i v -> Array.set a i v; 0)" True,
    MkIntrinsic "prim_mArrayLength" (IPi "a" (IFun (IMArray (IVar "a")) (IIO IInt))) OpNone Nothing "(fun a -> Array.length a)" True,
    MkIntrinsic "prim_newBuffer" (IIO IBuf) OpNone Nothing "(Buffer.create 16)" True,
    MkIntrinsic "prim_bufferAdd" (IFun IBuf (IFun IStr (IIO IInt))) OpNone Nothing "(fun b s -> Buffer.add_string b s; String.length s)" True,
    MkIntrinsic "prim_bufferContents" (IFun IBuf (IIO IStr)) OpNone Nothing "(fun b -> Buffer.contents b)" True,
    MkIntrinsic "prim_bufferLength" (IFun IBuf (IIO IInt)) OpNone Nothing "(fun b -> Buffer.length b)" True,
    MkIntrinsic "prim_print" (IFun IStr (IIO IInt)) OpNone (Just CapConsole) "dtp_print" True,
    MkIntrinsic "prim_readFile" (IFun IStr (IIO IStr)) OpNone (Just CapFs) "dtp_readFile" True,
    MkIntrinsic "prim_writeFile" (IFun IStr (IFun IStr (IIO IInt))) OpNone (Just CapFs) "dtp_writeFile" True,
    MkIntrinsic "prim_readLine" (IIO IStr) OpNone (Just CapConsole) "(dtp_readLine ())" True,
    MkIntrinsic "prim_readBytes" (IFun IInt (IIO IStr)) OpNone (Just CapConsole) "dtp_readBytes" True,
    MkIntrinsic "prim_getArgs" (IIO (IList IStr)) OpNone (Just CapProcess) "(dtp_listOf (dtp_getArgs ()))" True,
    MkIntrinsic "prim_readDir" (IFun IStr (IIO (IList IStr))) OpNone (Just CapFs) "(fun p -> dtp_listOf (dtp_readDir p))" True,
    MkIntrinsic "prim_isDirectory" (IFun IStr (IIO IBool)) OpNone (Just CapFs) "dtp_isDirectory" True,
    MkIntrinsic "prim_makeDir" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_makeDir" True,
    MkIntrinsic "prim_removeFile" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_removeFile" True,
    MkIntrinsic "prim_fileExists" (IFun IStr (IIO IBool)) OpNone (Just CapFs) "dtp_fileExists" True,
    MkIntrinsic "prim_fileMtime" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_fileMtime" True,
    MkIntrinsic "prim_fileSize" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_fileSize" True,
    MkIntrinsic "prim_exit" (IFun IInt (IIO IInt)) OpNone (Just CapProcess) "dtp_exit" True,
    MkIntrinsic "prim_runIn" (IFun IStr (IFun (IList IStr) (IIO IInt))) OpNone (Just CapProcess) "(fun dir args -> dtp_runIn dir (dtp_ocamlOf args))" True,
    MkIntrinsic "prim_getenv" (IFun IStr (IIO IStr)) OpNone (Just CapEnv) "dtp_getenv" True,
    MkIntrinsic "prim_getcwd" (IIO IStr) OpNone (Just CapEnv) "(dtp_getcwd ())" True,
    MkIntrinsic "prim_execPath" (IIO IStr) OpNone (Just CapEnv) "(dtp_execPath ())" True,
    MkIntrinsic "bi_eq_int" (IFun IInt (IFun IInt IBool)) OpEqInt Nothing "bi_eq_int" False,
    MkIntrinsic "bi_neq_int" (IFun IInt (IFun IInt IBool)) OpNeqInt Nothing "bi_neq_int" False,
    MkIntrinsic "bi_eq_str" (IFun IStr (IFun IStr IBool)) OpEqStr Nothing "bi_eq_str" False,
    MkIntrinsic "bi_neq_str" (IFun IStr (IFun IStr IBool)) OpNeqStr Nothing "bi_neq_str" False,
    MkIntrinsic "bi_lt_int" (IFun IInt (IFun IInt IBool)) OpLtInt Nothing "bi_lt_int" False,
    MkIntrinsic "bi_le_int" (IFun IInt (IFun IInt IBool)) OpLeInt Nothing "bi_le_int" False,
    MkIntrinsic "bi_gt_int" (IFun IInt (IFun IInt IBool)) OpGtInt Nothing "bi_gt_int" False,
    MkIntrinsic "bi_ge_int" (IFun IInt (IFun IInt IBool)) OpGeInt Nothing "bi_ge_int" False,
    MkIntrinsic "bi_lt_generic" (IFun IInt (IFun IInt IBool)) OpLtGeneric Nothing "bi_lt_generic" False,
    MkIntrinsic "bi_le_generic" (IFun IInt (IFun IInt IBool)) OpLeGeneric Nothing "bi_le_generic" False,
    MkIntrinsic "bi_gt_generic" (IFun IInt (IFun IInt IBool)) OpGtGeneric Nothing "bi_gt_generic" False,
    MkIntrinsic "bi_ge_generic" (IFun IInt (IFun IInt IBool)) OpGeGeneric Nothing "bi_ge_generic" False
  ]

intrinsicTbl : HashMap Intrinsic
intrinsicTbl =
  Base.HashMap.insertAll (map (\i => Pair (intrinsicName i) i) allIntrinsics)
    (Base.HashMap.fromList [])

findIntrinsic : String -> Maybe Intrinsic
findIntrinsic name = Base.HashMap.lookup name intrinsicTbl

isIntrinsicName : String -> Bool
isIntrinsicName name = case findIntrinsic name of
  Just i => intrinsicVisible i
  Nothing => False

userIntrinsics : List Intrinsic
userIntrinsics = filter intrinsicVisible allIntrinsics

-- 用户可见的内建值名字（prelude 全局与「禁止重定义」名单共用）。
preludeValueNames : List String
preludeValueNames = map intrinsicName userIntrinsics
