module Vuna.Compiler.Intrinsics
  ( Capability(..)
  , IType(..)
  , Intrinsic
  , IntrinsicOp(..)
  , TypeIntrinsic(..)
  , allIntrinsics
  , arityOfType
  , boolFalseCtor
  , boolTrueCtor
  , boolTypeName
  , canonicalCtorsFor
  , capabilityName
  , capabilityNames
  , findIntrinsic
  , intTypeName
  , interpMethodName
  , interpTypeName
  , intrinsicArity
  , intrinsicCapability
  , intrinsicName
  , intrinsicReturnsIO
  , intrinsicSignature
  , intrinsicVisible
  , ioFamilyName
  , ioTypeName
  , isEffectfulIntrinsic
  , isIOAlgebraName
  , isIntrinsicName
  , isIntrinsicTypeName
  , isTypeConstructorName
  , listConsCtor
  , listFamilyName
  , listNilCtor
  , natSuccCtor
  , natTypeName
  , natZeroCtor
  , needsListBridge
  , parseCapability
  , preludeTypeNames
  , preludeValueNames
  , primBindIO1Name
  , primBindIOName
  , primEraseName
  , primPureIOName
  , primRunIOName
  , strTypeName
  , typeIntrinsicArities
  , typeIntrinsicArityOf
  , typeIntrinsicCtorArity
  , typeIntrinsicCtorName
  , typeIntrinsicCtorNames
  , typeIntrinsicNames
  , userIntrinsics
  ) where

-- Vuna.Compiler.Intrinsics：**内建声明的唯一真源**（M27）。
--
-- 这里只有纯数据：内建/原语的名字、签名形状（IType）、interp 归约标签（IntrinsicOp）、
-- 所需能力（Capability）、OCaml runtime 名字，以及是否对用户源码可见。
-- 消费方：
--   - `Loader.Resolve`：名字解析（arity）、DT prelude 放行、效应能力检查；
--   - `Elab.Prelude`：构造 prelude globals（签名）；
--   - `Codegen.Term`：全局名 → runtime 表达式；
--   - `Core.Eval`：按 IntrinsicOp 归约。
--
-- 身份规则（M27/M37）：内置实体按**声明的 symbol**判定，不按短名/lastName：
--   - Int / String 是语言 primitive 类型；IO 是语言内建效应类型（M37 升格，
--     `ioTypeName`，运行时是裸 thunk，无构造子）；
--   - Bool / List / Nat 是 base 的普通 data，身份 = 完整限定名
--     `Base.Bool.Bool` / `Base.List.List` / `Base.Nat.Nat`（见 `Loader`/`Codegen` 的常量）；
--   - 隐藏的内部 runtime 名（`bi_*`）只供 codegen 映射，不对用户源码可见。
import Vuna.Compiler.Common
import Base.HashMap

-- ---------------------------------------------------------------
-- 能力（capability）：显式、不可按包名伪造的效应声明面
-- ---------------------------------------------------------------
data Capability : Type where
  CapConsole : Capability
  CapFs : Capability
  CapProcess : Capability
  CapEnv : Capability
  CapClock : Capability
  -- 允许在 main 之外执行 IO 动作（`Base.IO.runIO`；工具链特权，M31）。
  CapUnsafe : Capability
  -- 网络（loopback TCP / Unix domain socket；工具链 server 模式用）。
  CapNetwork : Capability

capabilityName : Capability -> String
capabilityName CapConsole = "console"
capabilityName CapFs = "fs"
capabilityName CapProcess = "process"
capabilityName CapEnv = "env"
capabilityName CapClock = "clock"
capabilityName CapUnsafe = "unsafe"
capabilityName CapNetwork = "net"

capabilityNames : List String
capabilityNames = map capabilityName allCapabilities

allCapabilities : List Capability
allCapabilities = [CapConsole, CapFs, CapProcess, CapEnv, CapClock, CapUnsafe, CapNetwork]

parseCapability : String -> Maybe Capability
parseCapability "console" = Just CapConsole
parseCapability "fs" = Just CapFs
parseCapability "process" = Just CapProcess
parseCapability "env" = Just CapEnv
parseCapability "clock" = Just CapClock
parseCapability "unsafe" = Just CapUnsafe
parseCapability "net" = Just CapNetwork
parseCapability _ = Nothing

-- ---------------------------------------------------------------
-- 签名形状：只表达内建签名需要的形状（不含依赖 pi / 多态细节）
-- ---------------------------------------------------------------
data IType : Type where
  -- 宇宙 `Type`（类型构造子 / 类型变量参数的域）
  ITy : IType
  IInt : IType
  IStr : IType
  IBool : IType
  -- `Base.Nat.Nat`：canonical 归纳族，运行时表示是 OCaml `int`（见 Codegen）。
  INat : IType
  -- `Base.List.List <arg>`：族身份固定为 base 的普通 data 声明
  IList : IType -> IType
  -- `IO <arg>`：内建效应类型；效果原语返回 IO 动作（M37 起 IO 是内建类型）
  IIO : IType -> IType
  IFun : IType -> IType -> IType
  -- M38：参数 binder 为 1 的函数（线性 continuation）；只给底层原语用。
  IFun1 : IType -> IType -> IType
  -- M33 W3：内建类型构造子与签名里的类型变量。
  IVar : String -> IType
  IArray : IType -> IType
  IRef : IType -> IType
  IMArray : IType -> IType
  IBuf : IType
  -- 隐式类型参数绑定（`{a : Type} -> ...`）；不进函数 arity。
  IPi : String -> IType -> IType

arityOfType : IType -> Int
arityOfType (IFun _ cod) = 1 + arityOfType cod
arityOfType (IFun1 _ cod) = 1 + arityOfType cod
arityOfType (IPi _ cod) = arityOfType cod
arityOfType _ = 0

-- ---------------------------------------------------------------
-- 内建类型构造子（M33 W3）
-- ---------------------------------------------------------------
-- 与 `Int` / `String` 两个 primitive 类型名不同，这些是**带参数的**类型构造子：
-- 名字恒可见（prelude 类型层），codegen 按固定 OCaml 类型渲染（见 Codegen.Decl）。
-- 参数个数的唯一真源在此；Elab.Prelude 据此生成 kind，Codegen.Decl 据此渲染。
record TypeIntrinsic where
  typeIntrinsicCtorName : String
  typeIntrinsicCtorArity : Int

typeIntrinsicCtorName : TypeIntrinsic -> String
typeIntrinsicCtorName (TypeIntrinsic name arity) = name

typeIntrinsicCtorArity : TypeIntrinsic -> Int
typeIntrinsicCtorArity (TypeIntrinsic name arity) = arity

typeIntrinsicArities : List TypeIntrinsic
typeIntrinsicArities =
  [ TypeIntrinsic "Array" 1,
    TypeIntrinsic "IORef" 1,
    TypeIntrinsic "MArray" 1,
    TypeIntrinsic "Buffer" 0
  ]

-- `-1` = 不是内建类型构造子。
typeIntrinsicArityOf : String -> Int
typeIntrinsicArityOf name = typeIntrinsicArityOfRest name typeIntrinsicArities

typeIntrinsicArityOfRest : String -> List TypeIntrinsic -> Int
typeIntrinsicArityOfRest name [] = 0 - 1
typeIntrinsicArityOfRest name (t :: rest) =
  if typeIntrinsicCtorName t == name then typeIntrinsicCtorArity t
  else typeIntrinsicArityOfRest name rest

typeIntrinsicCtorNames : List String
typeIntrinsicCtorNames = map typeIntrinsicCtorName typeIntrinsicArities

-- IO 的**源级名字**：`IO` 是编译器内建效应类型（不是 base 的 data），恒可见。
-- 源级名字，恒进 prelude 类型名名单（禁止 ad-hoc 重定义 + Loader 放行）；
-- canonical 身份就是它（没有 base data）。
ioTypeName : String
ioTypeName = "IO"

-- 运行时「可命名类型头」的唯一真源：primitive 类型 + 内建类型构造子 + 内建效应类型。
-- 其它类型头（类型族 / axiom / 未知全局）在运行时不可命名，按擦除依赖类型处理。
-- 数据族的身份不在本表里（按各程序自己的 DtData 表判定）。
isTypeConstructorName : String -> Bool
isTypeConstructorName name =
  name == intTypeName || name == strTypeName || name == ioTypeName || typeIntrinsicArityOf name >= 0

-- IO 代数（构造/绑定/执行）的内建名；codegen 需要按名字生成 thunk 组合子。
primPureIOName : String
primPureIOName = "prim_pureIO"

primBindIOName : String
primBindIOName = "prim_bindIO"

primBindIO1Name : String
primBindIO1Name = "prim_bindIO1"

primRunIOName : String
primRunIOName = "prim_runIO"

-- 表现层 cast：精化器在「运行时位置出现不可命名的擦除依赖类型」时插入
-- （见 docs/reference/effects.md §5/§6）。隐藏 intrinsic：只供精化器引用，
-- 不对用户源码可见；运行时是 OCaml 的 `%identity`（`Obj.magic`），求值期由
-- `IntrinsicOp.OpIdentity` 归约成参数本身，因此对定义性相等/正规化透明。
primEraseName : String
primEraseName = "prim_erase"

isIOAlgebraName : String -> Bool
isIOAlgebraName name =
  name == primPureIOName
    || name == primBindIOName
    || name == primBindIO1Name
    || name == primRunIOName

-- prelude 类型层名字：primitive 类型 + 内建类型构造子 + 内建效应类型 IO
-- （禁止重定义 + Loader 放行）。
preludeTypeNames : List String
preludeTypeNames = append typeIntrinsicNames (append typeIntrinsicCtorNames [ioTypeName])

-- ---------------------------------------------------------------
-- interp 归约标签（Core.Eval 按它归约；OpNone = 不在 interp 归约）
-- ---------------------------------------------------------------
data IntrinsicOp : Type where
  OpNone : IntrinsicOp
  OpAdd : IntrinsicOp
  OpSub : IntrinsicOp
  OpMul : IntrinsicOp
  OpDiv : IntrinsicOp
  OpEqInt : IntrinsicOp
  OpNeqInt : IntrinsicOp
  OpLtInt : IntrinsicOp
  OpLeInt : IntrinsicOp
  OpGtInt : IntrinsicOp
  OpGeInt : IntrinsicOp
  OpEqStr : IntrinsicOp
  OpNeqStr : IntrinsicOp
  OpLtGeneric : IntrinsicOp
  OpLeGeneric : IntrinsicOp
  OpGtGeneric : IntrinsicOp
  OpGeGeneric : IntrinsicOp
  OpConcat : IntrinsicOp
  OpAnd : IntrinsicOp
  OpOr : IntrinsicOp
  OpStrFromInt : IntrinsicOp
  OpStrLength : IntrinsicOp
  OpStrUnpack : IntrinsicOp
  OpStrPack : IntrinsicOp
  OpStrConcatMany : IntrinsicOp
  OpStrSubstTemplate : IntrinsicOp
  OpStrHash : IntrinsicOp
  OpStrAt : IntrinsicOp
  OpStrSubstring : IntrinsicOp
  OpStrShow : IntrinsicOp
  -- Nat 的纯原语：饱和/截断语义与生成 runtime 的 bi_nat* 一致。
  OpNatAdd : IntrinsicOp
  OpNatSub : IntrinsicOp
  OpNatMul : IntrinsicOp
  OpNatDiv : IntrinsicOp
  OpNatToInt : IntrinsicOp
  OpNatFromInt : IntrinsicOp
  -- 表现层 cast（`prim_erase`）：运行时不产生任何操作，归约成唯一实参本身。
  -- interp / 定义性相等都必须看穿它（否则 cast 会改变归约结果）。
  OpIdentity : IntrinsicOp

-- ---------------------------------------------------------------
-- 内建声明
-- ---------------------------------------------------------------
--
-- 字段：名字、签名形状、interp 归约标签、所需能力（Nothing = 纯）、runtime 表达式、
-- 是否对用户源码可见（False = 只供 codegen 映射的内部名）。
record Intrinsic where
  intrinsicName : String
  intrinsicSignature : IType
  intrinsicOp : IntrinsicOp
  intrinsicCapability : Maybe Capability
  intrinsicRuntime : String
  intrinsicVisible : Bool

intrinsicName : Intrinsic -> String
intrinsicName (Intrinsic name sig op cap runtime visible) = name

intrinsicSignature : Intrinsic -> IType
intrinsicSignature (Intrinsic name sig op cap runtime visible) = sig

intrinsicCapability : Intrinsic -> Maybe Capability
intrinsicCapability (Intrinsic name sig op cap runtime visible) = cap

intrinsicVisible : Intrinsic -> Bool
intrinsicVisible (Intrinsic name sig op cap runtime visible) = visible

-- 该内建的 runtime 表达式依赖 canonical `Base.List.List` 桥接 helper（`dtp_*`）。
-- 没有 base 的包用这些内建时，生成前必须报错（而不是产出 Unbound value）。
needsListBridge : Intrinsic -> Bool
needsListBridge i = case i.intrinsicRuntime of
  "dtp_unpack" => True
  "dtp_pack" => True
  "dtp_concatMany" => True
  "dtp_substTemplate" => True
  "(fun p -> dtp_listOf (dtp_readDir p))" => True
  "(dtp_listOf (dtp_getArgs ()))" => True
  "(fun dir args -> dtp_runIn dir (dtp_ocamlOf args))" => True
  "(fun args -> dtp_spawn (dtp_ocamlOf args))" => True
  "(fun xs -> Array.of_list (dtp_ocamlOf xs))" => True
  "(fun a -> dtp_listOf (Array.to_list a))" => True
  _ => False

-- canonical 族（base 的 data 声明）必须由 vuna-base 以固定的构造子集合声明；
-- 其它同名声明是非法伪造。IO 不在其中：它是编译器内建效应类型（没有构造子）。
canonicalCtorsFor : String -> Maybe (List String)
canonicalCtorsFor name =
  if name == boolTypeName then Just [boolTrueCtor, boolFalseCtor]
  else if name == listFamilyName then Just [listNilCtor, listConsCtor]
  else if name == natTypeName then Just [natZeroCtor, natSuccCtor] else Nothing

intrinsicArity : Intrinsic -> Int
intrinsicArity i = arityOfType (intrinsicSignature i)

-- 签名尾部是 `IIO _`：该内建返回 IO 动作，codegen 必须把 runtime 表达式包成
-- thunk（C2 内建模式：`fun args -> fun _ -> rt args`；C1 legacy 模式：`MkIO (fun _ -> …)`）。
-- 零参原语因此是真正的值而不是每次求值的表达式。IO 代数原语（pure/bind）的 runtime
-- 本身就是动作值，codegen 走 `isIOAlgebraName` 特判，不套通用包装。
intrinsicReturnsIO : Intrinsic -> Bool
intrinsicReturnsIO i = typeReturnsIO (intrinsicSignature i)

typeReturnsIO : IType -> Bool
typeReturnsIO (IIO _) = True
typeReturnsIO (IFun _ cod) = typeReturnsIO cod
typeReturnsIO (IFun1 _ cod) = typeReturnsIO cod
typeReturnsIO (IPi _ cod) = typeReturnsIO cod
typeReturnsIO _ = False

isEffectfulIntrinsic : Intrinsic -> Bool
isEffectfulIntrinsic i = case intrinsicCapability i of
  Just _ => True
  Nothing => False

-- 语言 primitive 类型名（Bool 不在其中：它是 base 的普通 data 声明）。
typeIntrinsicNames : List String
typeIntrinsicNames = [intTypeName, strTypeName]

intTypeName : String
intTypeName = "Int"

strTypeName : String
strTypeName = "String"

-- Bool 是 base 里的普通 data 声明：身份 = 完整符号 `Base.Bool.Bool`（M27）。
boolTypeName : String
boolTypeName = "Base.Bool.Bool"

boolTrueCtor : String
boolTrueCtor = "Base.Bool.True"

boolFalseCtor : String
boolFalseCtor = "Base.Bool.False"

-- Nat 是 base 里的普通 data 声明（`Base.Nat`），身份 = 完整符号；运行时表示固定为
-- OCaml `int`（Zero=0、Succ n=n+1 饱和），所以**不生成**变体类型（见 Codegen.Decl）。
natTypeName : String
natTypeName = "Base.Nat.Nat"

natZeroCtor : String
natZeroCtor = "Base.Nat.Zero"

natSuccCtor : String
natSuccCtor = "Base.Nat.Succ"

-- 类型位置的放行面：primitive 类型名 + 内建类型构造子（M33 W3）。
isIntrinsicTypeName : String -> Bool
isIntrinsicTypeName name = memName name preludeTypeNames

-- base 里普通 data 声明的**完整符号身份**（不是短名）：List / IO 的判定只认它们。
listFamilyName : String
listFamilyName = "Base.List.List"

listNilCtor : String
listNilCtor = "Base.List.Nil"

listConsCtor : String
listConsCtor = "Base.List.Cons"

-- `IO` 是编译器内建效应类型（与 Int/String 同级的类型构造子，kind `Type -> Type`）：
-- 运行时表示是裸 thunk `int -> 'a`，没有构造子；`Base.IO` 只导出 API 与实例。
-- 身份 = 源级名字 `IO`（M37 IO 升格；此前是 base 的普通 data `Base.IO.IO`）。
ioFamilyName : String
ioFamilyName = ioTypeName

-- M36：模板字符串插值的 trait 与方法（canonical 名）。编译器把 `${e}` 降级成对
-- `interp` 方法投影的调用（`Loader.Resolve`），转换语义完全由 base 里的实例决定。
interpTypeName : String
interpTypeName = "Base.Interp.Interp"

interpMethodName : String
interpMethodName = "Base.Interp.interp"

-- 所有内建声明。用户可见项进 Loader/prelude；内部 `bi_*` 只服务 codegen。
allIntrinsics : List Intrinsic
-- 效果原语（M27：只保留 `prim_*` 名；公开名删除，用户经 Base.IO 或显式能力）。
-- 精化器合成的比较/相等特化名（内部：不对用户源码可见）。
-- M33 W3：内建类型构造子 Array / IORef / MArray / Buffer 的原语。
-- 纯 Array 原语无能力；IORef / MArray / Buffer 都是 IO 动作（无能力：不触碰外部世界）。
-- 空数组字面量：non-expansive 的 OCaml `[||]`，让 `HashMap` 的空表这类零参多态值可泛化。
-- M33 W4：字节切片（clamp 语义与 Base.String.substring 一致），避免 List 桥接。
-- M34.5：编译器内部缓存原语（Marshal 纯数据；含闭包会在运行期失败）。
-- M34.4：异步子进程（workspace 并行 check）。spawn 返回 pid，wait 返回退出码。
-- Nat 度量/算术：运行时表示是 OCaml int（Zero=0、Succ 饱和 +1）。
-- 语义：add/mul 饱和到 max_int，sub 截断到 0，div 除零与 Int 同文案失败。
-- IO 代数（M37 / C1 过渡）：`IO` 是编译器内建效应类型，构造/绑定/执行是内建原语。
-- 这里的 runtime 文本是**内建模式**（IO = 裸 thunk `int -> 'a`）的实现；
-- M38：运行时诊断原语。`prim_eprint` 写 stderr 并 flush（报告器/调试输出用）；
-- `prim_fail` 抛 Failure（报告器把它渲染成 "vuna: runtime error: ..."）。两者先只
-- 进 Intrinsics 表（base 源码在 seed rotation 之后才会使用它们）。
-- 内部 cast（`visible = False`）：只由精化器插入，runtime 是 OCaml 的 `%identity`；
-- 运行时位置的不透明擦除依赖值靠它进出（见 docs/reference/effects.md §5/§6）。
allIntrinsics =
  [ Intrinsic "+" (IFun IInt (IFun IInt IInt)) OpAdd Nothing "bi_add" True,
    Intrinsic "-" (IFun IInt (IFun IInt IInt)) OpSub Nothing "bi_sub" True,
    Intrinsic "*" (IFun IInt (IFun IInt IInt)) OpMul Nothing "bi_mul" True,
    Intrinsic "/" (IFun IInt (IFun IInt IInt)) OpDiv Nothing "bi_div" True,
    Intrinsic "++" (IFun IStr (IFun IStr IStr)) OpConcat Nothing "bi_concat" True,
    Intrinsic "&&" (IFun IBool (IFun IBool IBool)) OpAnd Nothing "bi_and" True,
    Intrinsic "||" (IFun IBool (IFun IBool IBool)) OpOr Nothing "bi_or" True,
    Intrinsic "strFromInt" (IFun IInt IStr) OpStrFromInt Nothing "bi_strFromInt" True,
    Intrinsic "strUnpack" (IFun IStr (IList IInt)) OpStrUnpack Nothing "dtp_unpack" True,
    Intrinsic "strPack" (IFun (IList IInt) IStr) OpStrPack Nothing "dtp_pack" True,
    Intrinsic "strLength" (IFun IStr IInt) OpStrLength Nothing "bi_strLength" True,
    Intrinsic "strConcatMany" (IFun (IList IStr) IStr) OpStrConcatMany Nothing "dtp_concatMany" True,
    Intrinsic "strSubstTemplate" (IFun IStr (IFun (IList IStr) IStr)) OpStrSubstTemplate Nothing "dtp_substTemplate" True,
    Intrinsic "timeUs" (IIO IInt) OpNone (Just CapClock) "(dtp_timeUs ())" True,
    Intrinsic "strHash" (IFun IStr IInt) OpStrHash Nothing "dtp_strHash" True,
    Intrinsic "strAt" (IFun IStr (IFun IInt IInt)) OpStrAt Nothing "dtp_strAt" True,
    Intrinsic "strSubstring" (IFun IInt (IFun IInt (IFun IStr IStr))) OpStrSubstring Nothing "dtp_substring" True,
    Intrinsic "prim_marshal" (IPi "a" (IFun (IVar "a") IStr)) OpNone Nothing "dtp_marshal" True,
    Intrinsic "prim_unmarshal" (IPi "a" (IFun IStr (IVar "a"))) OpNone Nothing "dtp_unmarshal" True,
    Intrinsic "strShow" (IFun IStr IStr) OpStrShow Nothing "dt_show_string" True,
    Intrinsic primEraseName (IPi "a" (IFun (IVar "a") (IVar "a"))) OpIdentity Nothing "Obj.magic" False,
    Intrinsic "natAdd" (IFun INat (IFun INat INat)) OpNatAdd Nothing "bi_natAdd" True,
    Intrinsic "natSub" (IFun INat (IFun INat INat)) OpNatSub Nothing "bi_natSub" True,
    Intrinsic "natMul" (IFun INat (IFun INat INat)) OpNatMul Nothing "bi_natMul" True,
    Intrinsic "natDiv" (IFun INat (IFun INat INat)) OpNatDiv Nothing "bi_natDiv" True,
    Intrinsic "natToInt" (IFun INat IInt) OpNatToInt Nothing "bi_natToInt" True,
    Intrinsic "natFromInt" (IFun IInt INat) OpNatFromInt Nothing "bi_natFromInt" True,
    Intrinsic "arrayLength" (IPi "a" (IFun (IArray (IVar "a")) IInt)) OpNone Nothing "Array.length" True,
    Intrinsic "arrayEmpty" (IPi "a" (IArray (IVar "a"))) OpNone Nothing "[||]" True,
    Intrinsic "arrayGet" (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IVar "a")))) OpNone Nothing "Array.get" True,
    Intrinsic "arraySet" (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IArray (IVar "a")))))) OpNone Nothing "dtp_arraySet" True,
    Intrinsic "arrayMake" (IPi "a" (IFun IInt (IFun (IVar "a") (IArray (IVar "a"))))) OpNone Nothing "Array.make" True,
    Intrinsic "arrayFromList" (IPi "a" (IFun (IList (IVar "a")) (IArray (IVar "a")))) OpNone Nothing "(fun xs -> Array.of_list (dtp_ocamlOf xs))" True,
    Intrinsic "arrayToList" (IPi "a" (IFun (IArray (IVar "a")) (IList (IVar "a")))) OpNone Nothing "(fun a -> dtp_listOf (Array.to_list a))" True,
    Intrinsic primPureIOName (IPi "a" (IFun (IVar "a") (IIO (IVar "a")))) OpNone Nothing "(fun x -> fun _ -> x)" True,
    Intrinsic primBindIOName (IPi "a" (IPi "b" (IFun (IIO (IVar "a")) (IFun (IFun (IVar "a") (IIO (IVar "b"))) (IIO (IVar "b")))))) OpNone Nothing "(fun io k -> fun w -> k (io w) w)" True,
    Intrinsic primBindIO1Name (IPi "a" (IPi "b" (IFun1 (IIO (IVar "a")) (IFun1 (IFun1 (IVar "a") (IIO (IVar "b"))) (IIO (IVar "b")))))) OpNone Nothing "(fun io k -> fun w -> k (io w) w)" True,
    Intrinsic primRunIOName (IPi "a" (IFun (IIO (IVar "a")) (IVar "a"))) OpNone (Just CapUnsafe) "(fun io -> io 0)" True,
    Intrinsic "prim_newRef" (IPi "a" (IFun (IVar "a") (IIO (IRef (IVar "a"))))) OpNone Nothing "(fun x -> ref x)" True,
    Intrinsic "prim_readRef" (IPi "a" (IFun (IRef (IVar "a")) (IIO (IVar "a")))) OpNone Nothing "(fun r -> !r)" True,
    Intrinsic "prim_writeRef" (IPi "a" (IFun (IRef (IVar "a")) (IFun (IVar "a") (IIO IInt)))) OpNone Nothing "(fun r v -> r := v; 0)" True,
    Intrinsic "prim_newMArray" (IPi "a" (IFun IInt (IFun (IVar "a") (IIO (IMArray (IVar "a")))))) OpNone Nothing "(fun n v -> Array.make n v)" True,
    Intrinsic "prim_readMArray" (IPi "a" (IFun (IMArray (IVar "a")) (IFun IInt (IIO (IVar "a"))))) OpNone Nothing "(fun a i -> Array.get a i)" True,
    Intrinsic "prim_writeMArray" (IPi "a" (IFun (IMArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IIO IInt))))) OpNone Nothing "(fun a i v -> Array.set a i v; 0)" True,
    Intrinsic "prim_mArrayLength" (IPi "a" (IFun (IMArray (IVar "a")) (IIO IInt))) OpNone Nothing "(fun a -> Array.length a)" True,
    Intrinsic "prim_newBuffer" (IIO IBuf) OpNone Nothing "(Buffer.create 16)" True,
    Intrinsic "prim_bufferAdd" (IFun IBuf (IFun IStr (IIO IInt))) OpNone Nothing "(fun b s -> Buffer.add_string b s; String.length s)" True,
    Intrinsic "prim_bufferContents" (IFun IBuf (IIO IStr)) OpNone Nothing "(fun b -> Buffer.contents b)" True,
    Intrinsic "prim_bufferLength" (IFun IBuf (IIO IInt)) OpNone Nothing "(fun b -> Buffer.length b)" True,
    Intrinsic "prim_print" (IFun IStr (IIO IInt)) OpNone (Just CapConsole) "dtp_print" True,
    Intrinsic "prim_eprint" (IFun IStr (IIO IInt)) OpNone (Just CapConsole) "(fun s -> prerr_string s; flush stderr; String.length s)" True,
    Intrinsic "prim_fail" (IPi "a" (IFun IStr (IVar "a"))) OpNone Nothing "(fun msg -> failwith msg)" True,
    Intrinsic "prim_readFile" (IFun IStr (IIO IStr)) OpNone (Just CapFs) "dtp_readFile" True,
    Intrinsic "prim_writeFile" (IFun IStr (IFun IStr (IIO IInt))) OpNone (Just CapFs) "dtp_writeFile" True,
    Intrinsic "prim_writeFileAtomic" (IFun IStr (IFun IStr (IIO IInt))) OpNone (Just CapFs) "dtp_writeFileAtomic" True,
    Intrinsic "prim_readLine" (IIO IStr) OpNone (Just CapConsole) "(dtp_readLine ())" True,
    Intrinsic "prim_readBytes" (IFun IInt (IIO IStr)) OpNone (Just CapConsole) "dtp_readBytes" True,
    Intrinsic "prim_getArgs" (IIO (IList IStr)) OpNone (Just CapProcess) "(dtp_listOf (dtp_getArgs ()))" True,
    Intrinsic "prim_readDir" (IFun IStr (IIO (IList IStr))) OpNone (Just CapFs) "(fun p -> dtp_listOf (dtp_readDir p))" True,
    Intrinsic "prim_isDirectory" (IFun IStr (IIO IBool)) OpNone (Just CapFs) "dtp_isDirectory" True,
    Intrinsic "prim_makeDir" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_makeDir" True,
    Intrinsic "prim_removeFile" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_removeFile" True,
    Intrinsic "prim_fileExists" (IFun IStr (IIO IBool)) OpNone (Just CapFs) "dtp_fileExists" True,
    Intrinsic "prim_fileMtime" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_fileMtime" True,
    Intrinsic "prim_fileSize" (IFun IStr (IIO IInt)) OpNone (Just CapFs) "dtp_fileSize" True,
    Intrinsic "prim_exit" (IFun IInt (IIO IInt)) OpNone (Just CapProcess) "dtp_exit" True,
    Intrinsic "prim_runIn" (IFun IStr (IFun (IList IStr) (IIO IInt))) OpNone (Just CapProcess) "(fun dir args -> dtp_runIn dir (dtp_ocamlOf args))" True,
    Intrinsic "prim_spawn" (IFun (IList IStr) (IIO IInt)) OpNone (Just CapProcess) "(fun args -> dtp_spawn (dtp_ocamlOf args))" True,
    Intrinsic "prim_wait" (IFun IInt (IIO IInt)) OpNone (Just CapProcess) "dtp_wait" True,
    Intrinsic "prim_netListen" (IFun IStr (IIO IInt)) OpNone (Just CapNetwork) "dtp_net_listen" True,
    Intrinsic "prim_netPort" (IFun IInt (IIO IInt)) OpNone (Just CapNetwork) "dtp_net_port" True,
    Intrinsic "prim_netAccept" (IFun IInt (IIO IInt)) OpNone (Just CapNetwork) "dtp_net_accept" True,
    Intrinsic "prim_netRecv" (IFun IInt (IFun IInt (IIO IStr))) OpNone (Just CapNetwork) "dtp_net_recv" True,
    Intrinsic "prim_netSend" (IFun IInt (IFun IStr (IIO IInt))) OpNone (Just CapNetwork) "dtp_net_send" True,
    Intrinsic "prim_netClose" (IFun IInt (IIO IInt)) OpNone (Just CapNetwork) "dtp_net_close" True,
    Intrinsic "prim_netConnect" (IFun IStr (IIO IInt)) OpNone (Just CapNetwork) "dtp_net_connect" True,
    Intrinsic "prim_getenv" (IFun IStr (IIO IStr)) OpNone (Just CapEnv) "dtp_getenv" True,
    Intrinsic "prim_getcwd" (IIO IStr) OpNone (Just CapEnv) "(dtp_getcwd ())" True,
    Intrinsic "prim_execPath" (IIO IStr) OpNone (Just CapEnv) "(dtp_execPath ())" True,
    Intrinsic "bi_eq_int" (IFun IInt (IFun IInt IBool)) OpEqInt Nothing "bi_eq_int" False,
    Intrinsic "bi_neq_int" (IFun IInt (IFun IInt IBool)) OpNeqInt Nothing "bi_neq_int" False,
    Intrinsic "bi_eq_str" (IFun IStr (IFun IStr IBool)) OpEqStr Nothing "bi_eq_str" False,
    Intrinsic "bi_neq_str" (IFun IStr (IFun IStr IBool)) OpNeqStr Nothing "bi_neq_str" False,
    Intrinsic "bi_lt_int" (IFun IInt (IFun IInt IBool)) OpLtInt Nothing "bi_lt_int" False,
    Intrinsic "bi_le_int" (IFun IInt (IFun IInt IBool)) OpLeInt Nothing "bi_le_int" False,
    Intrinsic "bi_gt_int" (IFun IInt (IFun IInt IBool)) OpGtInt Nothing "bi_gt_int" False,
    Intrinsic "bi_ge_int" (IFun IInt (IFun IInt IBool)) OpGeInt Nothing "bi_ge_int" False,
    Intrinsic "bi_lt_generic" (IFun IInt (IFun IInt IBool)) OpLtGeneric Nothing "bi_lt_generic" False,
    Intrinsic "bi_le_generic" (IFun IInt (IFun IInt IBool)) OpLeGeneric Nothing "bi_le_generic" False,
    Intrinsic "bi_gt_generic" (IFun IInt (IFun IInt IBool)) OpGtGeneric Nothing "bi_gt_generic" False,
    Intrinsic "bi_ge_generic" (IFun IInt (IFun IInt IBool)) OpGeGeneric Nothing "bi_ge_generic" False
  ]

intrinsicTbl : HashMap Intrinsic
intrinsicTbl =
  Base.HashMap.insertAll (map (\i => Pair (intrinsicName i) i) allIntrinsics)
    (Base.HashMap.fromList [])

findIntrinsic : String -> Maybe Intrinsic
findIntrinsic name = Base.HashMap.lookup name intrinsicTbl

isIntrinsicName : String -> Bool
isIntrinsicName name = case findIntrinsic name of
  Just i => intrinsicVisible i
  Nothing => False

userIntrinsics : List Intrinsic
userIntrinsics = filter intrinsicVisible allIntrinsics

-- 用户可见的内建值名字（prelude 全局与「禁止重定义」名单共用）。
preludeValueNames : List String
preludeValueNames = map intrinsicName userIntrinsics
