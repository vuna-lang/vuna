-- | 内建声明的唯一真源（M27）：内建/原语的名字、签名形状、interp 归约标签与可见性。
module Vuna.Compiler.Intrinsics where

-- Vuna.Compiler.Intrinsics：**内建声明的唯一真源**（M27）。
--
-- 这里只有纯数据：内建/原语的名字、签名形状（IType）、interp 归约标签（IntrinsicOp）、
-- OCaml runtime 名字，以及是否对用户源码可见。
-- 消费方：
--   - `Loader.Resolve`：名字解析（arity）、DT prelude 放行；
--   - `Elab.Prelude`：构造 prelude globals（签名）；
--   - `Codegen.Term`：全局名 → runtime 表达式；
--   - `Core.Eval`：按 IntrinsicOp 归约。
--
-- 身份规则（M27/M37）：内置实体按**声明的 symbol**判定，不按短名/lastName：
--   - Int / String 是语言 primitive 类型；动作类型由 base 的 `Base.Eff.Eff` 承载；
--   - Bool / List / Nat 是 base 的普通 data，身份 = 完整限定名
--     `Base.Bool.Bool` / `Base.List.List` / `Base.Nat.Nat`（见 `Loader`/`Codegen` 的常量）；
--   - 隐藏的内部 runtime 名（`bi_*`）只供 codegen 映射，不对用户源码可见。
import Vuna.Compiler.Common
import Base.HashMap

-- ---------------------------------------------------------------
-- 签名形状：只表达内建签名需要的形状（不含依赖 pi / 多态细节）
-- ---------------------------------------------------------------
-- | 内建签名形状：只表达内建签名需要的形状（不含依赖 pi / 多态细节）。
export data IType(..) : Type where
  -- 宇宙 `Type`（类型构造子 / 类型变量参数的域）
  ITy : IType
  IInt : IType
  IStr : IType
  IBool : IType
  -- `Base.Nat.Nat`：canonical 归纳族，运行时表示是 OCaml `int`（见 Codegen）。
  INat : IType
  -- `Base.List.List <arg>`：族身份固定为 base 的普通 data 声明
  IList : IType -> IType
  -- `Base.Eff.Eff Base.Eff.Row.Nil arg`：统一动作类型；codegen 包一层 `MkEff`。
  IEff : IType -> IType
  IFun : IType -> IType -> IType
  -- M38：参数 binder 为 1 的函数（线性 continuation）；只给底层原语用。
  IFun1 : IType -> IType -> IType
  -- M33 W3：内建类型构造子与签名里的类型变量。
  IVar : String -> IType
  IArray : IType -> IType
  IRef : IType -> IType
  -- 隐式类型参数绑定（`{a : Type} -> ...`）；不进函数 arity。
  IPi : String -> IType -> IType
  -- `Float` primitive 类型的签名形状（保持已有 tag 顺序；新构造子只追加在它之后）。
  IFloat : IType
  -- 内建宿主效应行（阶段 0 spike）：`IRowNil` / `IRowCons name label tail` 构造 Core 的行项；
  -- `IGlobal` 引用一个全局类型名；`IEffRow row result` 是带行的 `Eff row result`。
  IRowNil : IType
  IRowCons : String -> IType -> IType -> IType
  IGlobal : String -> IType
  IEffRow : IType -> IType -> IType

-- | 签名形状的函数 arity：`IFun`/`IFun1` 各计 1，隐式 `IPi` 不计，其余为 0。
export arityOfType : IType -> Int
arityOfType (IFun _ cod) = 1 + arityOfType cod
arityOfType (IFun1 _ cod) = 1 + arityOfType cod
arityOfType (IPi _ cod) = arityOfType cod
arityOfType _ = 0

-- ---------------------------------------------------------------
-- 内建类型构造子（M33 W3）
-- ---------------------------------------------------------------
-- 与 `Int` / `String` 两个 primitive 类型名不同，这些是**带参数的**类型构造子：
-- 名字恒可见（prelude 类型层），codegen 按固定 OCaml 类型渲染（见 Codegen.Decl）。
-- 参数个数的唯一真源在此；Elab.Prelude 据此生成 kind，Codegen.Decl 据此渲染。
-- | 内建类型构造子（M33 W3）：带参数的类型构造子，名字恒可见，参数个数在此定。
export record TypeIntrinsic(..) where
  -- | 构造子的源码名字（`Array` / `IORef`）。
  typeIntrinsicCtorName : String
  -- | 类型参数个数。
  typeIntrinsicCtorArity : Int

-- | 取内建类型构造子的名字。
export typeIntrinsicCtorName : TypeIntrinsic -> String
typeIntrinsicCtorName (TypeIntrinsic name arity) = name

-- | 取内建类型构造子的类型参数个数。
export typeIntrinsicCtorArity : TypeIntrinsic -> Int
typeIntrinsicCtorArity (TypeIntrinsic name arity) = arity

-- | 全部内建类型构造子及其 arity（Elab.Prelude 生成 kind、Codegen.Decl 渲染的唯一真源）。
export typeIntrinsicArities : List TypeIntrinsic
typeIntrinsicArities = [TypeIntrinsic "Array" 1, TypeIntrinsic "IORef" 1]

-- | 名字对应的内建类型构造子 arity；不是内建类型构造子时返回 `-1`。
export typeIntrinsicArityOf : String -> Int
typeIntrinsicArityOf name = typeIntrinsicArityOfRest name typeIntrinsicArities

-- | `typeIntrinsicArityOf` 的递归实现：在 arity 表里线性找名字。
typeIntrinsicArityOfRest : String -> List TypeIntrinsic -> Int
typeIntrinsicArityOfRest name [] = 0 - 1
typeIntrinsicArityOfRest name (t :: rest) =
  if typeIntrinsicCtorName t == name then typeIntrinsicCtorArity t
  else typeIntrinsicArityOfRest name rest

-- | 所有内建类型构造子的名字列表（类型位置放行面用）。
export typeIntrinsicCtorNames : List String
typeIntrinsicCtorNames = map typeIntrinsicCtorName typeIntrinsicArities

-- | 运行时「可命名类型头」的唯一真源：primitive 类型 + 内建类型构造子 + 内建效应类型。
-- 其它类型头（类型族 / axiom / 未知全局）在运行时不可命名，按擦除依赖类型处理。
export isTypeConstructorName : String -> Bool
isTypeConstructorName name =
  name == intTypeName
    || name == strTypeName
    || name == floatTypeName
    || typeIntrinsicArityOf name >= 0

-- | 内建宿主效应（阶段 3）：标签全名 → 未导出的 `runXHost`（entry 自动预装用）。
record BuiltinEffect where
  -- | 行标签的全名（base 的 op 族类型）。
  beTag : String
  -- | entry 自动预装项的编译器内建名（`@vuna@runXHost`；源码写不出）。
  beRunHost : String
  -- | 内建名对应的 base 实现名（`Codegen` 生成引用时用；实现仍是 vuna 代码）。
  beImpl : String
  -- | 默认实例名（`main` 行里裸标签展开成它）。
  beDefaultName : String

-- | 全部内建宿主效应（标签 + runXHost）。未实现的条目先占位，entry 只对已实现的
-- 表项自动预装；用户自定义效应仍须自己 handle 成 Nil。
export builtinEffects : List BuiltinEffect
builtinEffects =
  [ BuiltinEffect "Base.EffConsole.ConsoleOp" "@vuna@runConsoleHost" "Base.EffConsole.runConsoleHost" "default",
    BuiltinEffect "Base.EffFs.FsOp" "@vuna@runFsHost" "Base.EffFs.runFsHost" "default",
    BuiltinEffect "Base.EffClock.ClockOp" "@vuna@runClockHost" "Base.EffClock.runClockHost" "default",
    BuiltinEffect "Base.EffEnv.EnvOp" "@vuna@runEnvHost" "Base.EffEnv.runEnvHost" "default",
    BuiltinEffect "Base.EffProcess.ProcessOp" "@vuna@runProcessHost" "Base.EffProcess.runProcessHost" "default",
    BuiltinEffect "Base.EffExit.ExitOp" "@vuna@runExitHost" "Base.EffExit.runExitHost" "default",
    BuiltinEffect "Base.EffStdin.StdinOp" "@vuna@runStdinHost" "Base.EffStdin.runStdinHost" "default",
    BuiltinEffect "Base.EffArgs.ArgsOp" "@vuna@runArgsHost" "Base.EffArgs.runArgsHost" "default",
    BuiltinEffect "Base.EffNet.NetOp" "" "" "default",
    BuiltinEffect "Base.EffRef.RefOp" "" "" "default"
  ]

-- | 标签对应的 `runXHost` 全名；不是内建宿主效应时返回空串。
export builtinEffectRunHostOf : String -> String
builtinEffectRunHostOf tag = builtinEffectRunHostOfRest tag builtinEffects

builtinEffectRunHostOfRest : String -> List BuiltinEffect -> String
builtinEffectRunHostOfRest tag [] = ""
builtinEffectRunHostOfRest tag (e :: rest) =
  if e.beTag == tag then e.beRunHost else builtinEffectRunHostOfRest tag rest

-- | 内建名对应的 base 实现名（`Codegen` 生成 entry 预装引用时用）。
export builtinEffectImplOf : String -> String
builtinEffectImplOf tag = builtinEffectImplOfRest tag builtinEffects

builtinEffectImplOfRest : String -> List BuiltinEffect -> String
builtinEffectImplOfRest tag [] = ""
builtinEffectImplOfRest tag (e :: rest) =
  if e.beTag == tag then e.beImpl else builtinEffectImplOfRest tag rest

-- | 该标签是否是内建宿主效应（`beRunHost` 为空表示只允许行、无需预装 handler）。
export isBuiltinEffectTag : String -> Bool
isBuiltinEffectTag tag = builtinEffectExistsRest tag builtinEffects

-- | 工具链统一行（`Base.HostRow` 的公理；编译器在 `Core.Eval` 里归约成具体行）。
export hostRowName : String
hostRowName = "Base.HostRow.hostRow"

export hostTailName : String
hostTailName = "Base.HostRow.hostTail"

builtinEffectExistsRest : String -> List BuiltinEffect -> Bool
builtinEffectExistsRest tag [] = False
builtinEffectExistsRest tag (e :: rest) =
  if e.beTag == tag then True else builtinEffectExistsRest tag rest

-- | Eff 版线性绑定（bootstrap 过渡表；当前无库调用方）：`Eff [] a` 的线性 continuation。
-- runtime 由 codegen 专门生成（装箱 `MkEff` 的 match），不能复用 eager 包装。
export primEffBind1Name : String
primEffBind1Name = "prim_eff_bind1"

-- | 表现层 cast：精化器在「运行时位置出现不可命名的擦除依赖类型」时插入
-- （见 docs/reference/effects.md §5/§6）。隐藏 intrinsic：只供精化器引用，
-- 不对用户源码可见；求值期由 `IntrinsicOp.OpIdentity` 归约成参数本身。
export primEraseName : String
primEraseName = "prim_erase"

-- | 非内建 `main` 类型的 Show 展示定义名（D17）：Elab 收尾合成
-- `@vuna@main_show : T -> String`，codegen 的 main 钩子与 interp 的 main 展示按它取用；
-- 名字里的 `@` 不在用户标识符语法里，不会与用户定义冲突。
export mainShowDefName : String
mainShowDefName = "@vuna@main_show"

-- | 关闭动作入口（`Base.Eff.runPure : Eff [] a -> a`）的 canonical 名（协议常量）。
export effRunName : String
effRunName = "Base.Eff.runPure"

-- | main 入口的隐藏执行名（`Base.Eff.runMain`，未导出）：codegen 的 main 钩子引用它，
-- 用于执行带内建宿主效应行的 `main`（`runPure` 只收 Nil）。
export effMainRunName : String
effMainRunName = "Base.Eff.runMain"

-- ---------------------------------------------------------------
-- 调试构造（F3 B）：语言级 debug 名字
-- ---------------------------------------------------------------
-- 这些是**编译器内建的调试构造**，不是库函数、不需要 import：
--   * `assert cond "msg" x`：debug-only；失败走 failwith（main 钩子渲染），release
--     构建由 `Loader.Resolve` 拒绝；
--   * `todo "msg"`：debug-only 的未实现占位，语义同 assert(False, msg)。
-- 用户面调试输出统一走内置宏 `dbg!`（见下方编译器 tracing 段）；`DebugShow` / `dbgShow`
-- 是 `Base.Show` 里基于 `dbg!` 的库层。
-- ---------------------------------------------------------------
-- 编译器 tracing（内置宏 `dbg!` 的隐藏后端）
-- ---------------------------------------------------------------
-- 这两个名字只由 `Loader.Expand` 展开 `dbg!` 时引用：它们以 `@vuna@` 开头，
-- `Loader.Resolve` 作为内部名直通，`Elab.Prelude` 提供签名，`Codegen.Term` 映射到
-- 生成的 `Vuna_runtime`；`visible = False`，源码写不出来。
-- 用哑 `Int` 实参承载开关查询，避免在源码层出现「纯 Bool 值读取进程配置」的形态。
-- | `dbg!` 的开关查询原语（`--debug-perf` / `VUNA_DEBUG_PERF=1`）。
export debugOnIntrinsicName : String
debugOnIntrinsicName = "@vuna@debug@on"

-- | `dbg!` 的发射原语（带时间戳写 stderr，返回 0）。
export debugLineIntrinsicName : String
debugLineIntrinsicName = "@vuna@debug@line"

-- | `assert`：debug-only 断言（release 构建拒绝）。
export assertIntrinsicName : String
assertIntrinsicName = "assert"

-- | `todo`：debug-only 未实现占位（release 构建拒绝）。
export todoIntrinsicName : String
todoIntrinsicName = "todo"

-- | 是否是 release 构建要拒绝的 debug-only 构造名（assert / todo）。
export isDebugOnlyName : String -> Bool
isDebugOnlyName name = name == assertIntrinsicName || name == todoIntrinsicName

-- ---------------------------------------------------------------
-- 效果协议（F3/D3）：库层效应编码的 canonical 身份
-- ---------------------------------------------------------------
-- 通用效应系统（W3–W10）把行/成员证明/行删除编码在 `vuna-base` 的数据里；编译器
-- 按**这些全名**识别该编码（不是内建：base 是唯一真源，名字集中在此处，不再散落）。
-- 消费方：`Core/Eval.rowRemReduce`（行删除归约）、`Elab/Dict`（行成员证明构造）。
-- 形状：`Row : Type 1`（`Nil`/`Cons`），`Member : Type -> Row -> Type 1`（`Here`/`There`），
-- `rowRem : Type -> Row -> Row`（axiom，由编译器按标签值结构相等归约）。
-- | 效应行族 `Base.Eff.Row`（Type-1 数据）。
export effRowFamilyName : String
effRowFamilyName = "Base.Eff.Row"

-- | 空行构造子 `Base.Eff.Row.Nil`。
export effRowNilCtor : String
effRowNilCtor = "Base.Eff.Row.Nil"

-- | 行扩展构造子 `Base.Eff.Row.Cons`（标签 + 尾行）。
export effRowConsCtor : String
effRowConsCtor = "Base.Eff.Row.Cons"

-- | 行删除 `Base.Eff.rowRem`（axiom，由编译器归约）。
export effRowRemName : String
effRowRemName = "Base.Eff.rowRem"

-- | 行拼接 `Base.Eff.rowAppend`（axiom，由编译器归约：Nil 单位 + Cons 递归）。
export effRowAppendName : String
effRowAppendName = "Base.Eff.rowAppend"

-- | 行成员证明族 `Base.Eff.Member`（Type-1 归纳族）。
export effMemberFamilyName : String
effMemberFamilyName = "Base.Eff.Member"

-- | 行成员证明构造子 `Base.Eff.Member.Here`（头部命中）。
export effMemberHereCtor : String
effMemberHereCtor = "Base.Eff.Member.Here"

-- | 行成员证明构造子 `Base.Eff.Member.There`（跳过头部）。
export effMemberThereCtor : String
effMemberThereCtor = "Base.Eff.Member.There"

-- | 效应动作类型 `Base.Eff.Eff`（`Eff : Row -> Type -> Type`，用户面效果类型）。
export effTypeName : String
effTypeName = "Base.Eff.Eff"

-- | `Base.Eff.EffUnit`：Eff 的 dummy thunk 参数类型（codegen 包 `MkEff` 时用作
-- `fun (_ : EffUnit) -> ...` 的标注；不进求值语义）。
export effUnitTypeName : String
effUnitTypeName = "Base.Eff.EffUnit"

-- | `Base.Eff.Eff.MkEff`：Eff 的唯一构造子（codegen 构造宿主原语动作时引用）。
export effMkCtor : String
effMkCtor = "Base.Eff.Eff.MkEff"

-- | 默认实例名（命名行 ND3）：裸标签条目 `Cons "default" e Nil` 与 `handleWithAt` 共用；
-- 单点定义在 `Base.Eff.defaultInstance`，此处是编译器侧的镜像常量。
export effDefaultInstance : String
effDefaultInstance = "default"

-- | prelude 类型层名字：primitive 类型 + 内建类型构造子（禁止重定义 + Loader 放行）。
export preludeTypeNames : List String
preludeTypeNames = append typeIntrinsicNames typeIntrinsicCtorNames

-- ---------------------------------------------------------------
-- interp 归约标签（Core.Eval 按它归约；OpNone = 不在 interp 归约）
-- ---------------------------------------------------------------
-- | interp 归约标签（`Core.Eval` 按它归约；`OpNone` = 不在 interp 归约）。
export data IntrinsicOp(..) : Type where
  OpNone : IntrinsicOp
  OpAdd : IntrinsicOp
  OpSub : IntrinsicOp
  OpMul : IntrinsicOp
  OpDiv : IntrinsicOp
  OpEqInt : IntrinsicOp
  OpNeqInt : IntrinsicOp
  OpLtInt : IntrinsicOp
  OpLeInt : IntrinsicOp
  OpGtInt : IntrinsicOp
  OpGeInt : IntrinsicOp
  OpEqStr : IntrinsicOp
  OpNeqStr : IntrinsicOp
  OpLtGeneric : IntrinsicOp
  OpLeGeneric : IntrinsicOp
  OpGtGeneric : IntrinsicOp
  OpGeGeneric : IntrinsicOp
  OpConcat : IntrinsicOp
  OpAnd : IntrinsicOp
  OpOr : IntrinsicOp
  OpStrFromInt : IntrinsicOp
  OpStrLength : IntrinsicOp
  OpStrUnpack : IntrinsicOp
  OpStrPack : IntrinsicOp
  OpStrConcatMany : IntrinsicOp
  OpStrSubstTemplate : IntrinsicOp
  OpStrHash : IntrinsicOp
  OpStrAt : IntrinsicOp
  OpStrSubstring : IntrinsicOp
  OpStrShow : IntrinsicOp
  -- Nat 的纯原语：饱和/截断语义与生成 runtime 的 bi_nat* 一致。
  OpNatAdd : IntrinsicOp
  OpNatSub : IntrinsicOp
  OpNatMul : IntrinsicOp
  OpNatDiv : IntrinsicOp
  OpNatToInt : IntrinsicOp
  OpNatFromInt : IntrinsicOp
  -- Float 的纯原语（IEEE-754 double；与编译产物的 OCaml 运算符同语义）。
  OpAddF : IntrinsicOp
  OpSubF : IntrinsicOp
  OpMulF : IntrinsicOp
  OpDivF : IntrinsicOp
  OpEqF : IntrinsicOp
  OpNeqF : IntrinsicOp
  OpLtF : IntrinsicOp
  OpLeF : IntrinsicOp
  OpGtF : IntrinsicOp
  OpGeF : IntrinsicOp
  OpFloatAbs : IntrinsicOp
  OpFloatSqrt : IntrinsicOp
  OpStrFromFloat : IntrinsicOp
  OpFloatFromInt : IntrinsicOp
  OpIntFromFloat : IntrinsicOp
  -- 表现层 cast（`prim_erase`）：运行时不产生任何操作，归约成唯一实参本身。
  -- interp / 定义性相等都必须看穿它（否则 cast 会改变归约结果）。
  OpIdentity : IntrinsicOp
  -- 位运算：Int 的 **63-bit 二进制补码**语义（与宿主 OCaml int 一致，是语言契约而
  -- 不是实现细节；wasm 后端需按 63-bit 模拟）。移位计数 `n < 0 || n >= 63` 时结果为 0。
  -- 内容寻址依赖它们跨后端逐字节一致，因此宽度必须固定。
  OpBitAnd : IntrinsicOp
  OpBitOr : IntrinsicOp
  OpBitXor : IntrinsicOp
  OpBitNot : IntrinsicOp
  OpBitShl : IntrinsicOp
  OpBitShr : IntrinsicOp

-- ---------------------------------------------------------------
-- 内建声明
-- ---------------------------------------------------------------
--
-- 字段：名字、签名形状、interp 归约标签、runtime 表达式、是否对用户源码可见
-- （False = 只供 codegen 映射的内部名）。
-- | 内建声明：名字、签名形状、interp 归约标签、runtime 表达式、可见性。
export record Intrinsic where
  -- | 内建的源码名字（如 `+`、`strFromInt`、`prim_eff_print`）。
  intrinsicName : String
  -- | 签名形状（`IType`）。
  intrinsicSignature : IType
  -- | interp 归约标签。
  intrinsicOp : IntrinsicOp
  -- | OCaml runtime 表达式（codegen 全局名 → runtime 的映射目标）。
  intrinsicRuntime : String
  -- | 是否对用户源码可见（`False` = 只供 codegen 映射的内部名 `bi_*`）。
  intrinsicVisible : Bool

-- | 取内建的名字。
export intrinsicName : Intrinsic -> String
intrinsicName (Intrinsic name sig op runtime visible) = name

-- | 取内建的签名形状。
export intrinsicSignature : Intrinsic -> IType
intrinsicSignature (Intrinsic name sig op runtime visible) = sig

-- | 该内建是否对用户源码可见。
export intrinsicVisible : Intrinsic -> Bool
intrinsicVisible (Intrinsic name sig op runtime visible) = visible

-- | 该内建的 runtime 表达式依赖 canonical `Base.List.List` 桥接 helper（`dtp_*`）。
-- 没有 base 的包用这些内建时，生成前必须报错（而不是产出 Unbound value）。
export needsListBridge : Intrinsic -> Bool
needsListBridge i = case i.intrinsicRuntime of
  "dtp_unpack" => True
  "dtp_pack" => True
  "dtp_concatMany" => True
  "dtp_substTemplate" => True
  "(fun p -> dtp_listOf (dtp_readDir p))" => True
  "(dtp_listOf (dtp_getArgs ()))" => True
  "(fun dir args -> dtp_runIn dir (dtp_ocamlOf args))" => True
  "(fun args -> dtp_spawn (dtp_ocamlOf args))" => True
  "(fun xs -> Array.of_list (dtp_ocamlOf xs))" => True
  "(fun a -> dtp_listOf (Array.to_list a))" => True
  _ => False

-- | canonical 族（base 的 data 声明）必须由 vuna-base 以固定的构造子集合声明；
-- 其它同名声明是非法伪造。
export canonicalCtorsFor : String -> Maybe (List String)
canonicalCtorsFor name =
  if name == boolTypeName then Just [boolTrueCtor, boolFalseCtor]
  else if name == listFamilyName then Just [listNilCtor, listConsCtor]
  else if name == natTypeName then Just [natZeroCtor, natSuccCtor] else Nothing

-- | 内建的函数 arity（按 `arityOfType (intrinsicSignature i)` 计算）。
export intrinsicArity : Intrinsic -> Int
intrinsicArity i = arityOfType (intrinsicSignature i)

-- thunk（C2 内建模式：`fun args -> fun _ -> rt args`；C1 legacy 模式：`MkIO (fun _ -> …)`）。
-- 零参原语因此是真正的值而不是每次求值的表达式。
-- | 该内建是否返回 Eff 动作（`IEff` 在签名尾部）。
export intrinsicReturnsEff : Intrinsic -> Bool
intrinsicReturnsEff i = typeReturnsEff (intrinsicSignature i)

-- | `IType` 尾部是否为 `IEff` / `IEffRow`（供 codegen 包 `MkEff`）。
typeReturnsEff : IType -> Bool
typeReturnsEff (IEff _) = True
typeReturnsEff (IEffRow _ _) = True
typeReturnsEff (IFun _ cod) = typeReturnsEff cod
typeReturnsEff (IFun1 _ cod) = typeReturnsEff cod
typeReturnsEff (IPi _ cod) = typeReturnsEff cod
typeReturnsEff _ = False

-- | 语言 primitive 类型名（Bool 不在其中：它是 base 的普通 data 声明）。
export typeIntrinsicNames : List String
typeIntrinsicNames = [intTypeName, strTypeName, floatTypeName]

-- | `Int` primitive 类型的源码名字。
export intTypeName : String
intTypeName = "Int"

-- | `String` primitive 类型的源码名字。
export strTypeName : String
strTypeName = "String"

-- | `Float` primitive 类型的源码名字（运行时是 OCaml IEEE-754 double，无 data 声明）。
export floatTypeName : String
floatTypeName = "Float"

-- | Bool 的完整符号身份：它是 base 里的普通 data 声明，身份 = `Base.Bool.Bool`（M27）。
export boolTypeName : String
boolTypeName = "Base.Bool.Bool"

-- | canonical `True` 构造子的完整符号。
export boolTrueCtor : String
boolTrueCtor = "Base.Bool.Bool.True"

-- | canonical `False` 构造子的完整符号。
export boolFalseCtor : String
boolFalseCtor = "Base.Bool.Bool.False"

-- | Nat 的完整符号身份（`Base.Nat.Nat`）；运行时表示固定为 OCaml `int`
-- （Zero=0、Succ n=n+1 饱和），所以**不生成**变体类型（见 Codegen.Decl）。
export natTypeName : String
natTypeName = "Base.Nat.Nat"

-- | canonical `Zero` 构造子的完整符号。
export natZeroCtor : String
natZeroCtor = "Base.Nat.Nat.Zero"

-- | canonical `Succ` 构造子的完整符号。
export natSuccCtor : String
natSuccCtor = "Base.Nat.Nat.Succ"

-- | 类型位置的放行面：primitive 类型名 + 内建类型构造子（M33 W3）。
export isIntrinsicTypeName : String -> Bool
isIntrinsicTypeName name = memName name preludeTypeNames

-- | List 的完整符号身份（base 里普通 data 声明，不是短名）：List 的判定只认它。
export listFamilyName : String
listFamilyName = "Base.List.List"

-- | canonical `Nil` 构造子的完整符号。
export listNilCtor : String
listNilCtor = "Base.List.List.Nil"

-- | canonical `Cons` 构造子的完整符号。
export listConsCtor : String
listConsCtor = "Base.List.List.Cons"

-- | M36：模板字符串插值的 trait 的 canonical 名。编译器把 `${e}` 降级成对
-- `interp` 方法投影的调用（`Loader.Resolve`），转换语义完全由 base 里的实例决定。
export interpTypeName : String
interpTypeName = "Base.Interp.Interp"

-- | M36：模板插值 trait 的 `interp` 方法的 canonical 名。
export interpMethodName : String
interpMethodName = "Base.Interp.interp"

-- | 字面量转换：`FromString` trait 的 canonical 名（checking 位置的字符串字面量按
-- 期望类型降级时用；声明在 base 的 `Base.FromString`）。
export fromStringTypeName : String
fromStringTypeName = "Base.FromString.FromString"

-- | `FromString` 的方法投影 canonical 名。
export fromStringMethodName : String
fromStringMethodName = "Base.FromString.fromString"

-- | 字面量转换：`FromInt` trait 的 canonical 名（声明在 base 的 `Base.FromInt`）。
export fromIntTypeName : String
fromIntTypeName = "Base.FromInt.FromInt"

-- | `FromInt` 的方法投影 canonical 名。
export fromIntMethodName : String
fromIntMethodName = "Base.FromInt.fromInt"

-- | 字面量转换：`FromFloat` trait 的 canonical 名（声明在 base 的 `Base.Float`）。
export fromFloatTypeName : String
fromFloatTypeName = "Base.Float.FromFloat"

-- | `FromFloat` 的方法投影 canonical 名。
export fromFloatMethodName : String
fromFloatMethodName = "Base.Float.fromFloat"

-- | 所有内建声明（基础表；浮点表另立，见 `floatIntrinsics`）。用户可见项进 Loader/prelude；
-- 内部 `bi_*` 只服务 codegen。分成两张表是为了让每段列表字面量的项大小留在旧 seed
-- 擦除检查的 fuel 内（bootstrap 约束，见 docs/reference/bootstrap.md）。
baseIntrinsics : List Intrinsic
-- 效果原语（`prim_*` 名；任何包可直接使用，推荐经 `Base.Eff` 标签 + handler）。
-- 精化器合成的比较/相等特化名（内部：不对用户源码可见）。
-- M33 W3：内建类型构造子 Array / IORef 的原语。
-- 纯 Array 原语不触碰外部世界；IORef 是 `Eff []` 动作。
-- 空数组字面量：non-expansive 的 OCaml `[||]`，让 `HashMap` 的空表这类零参多态值可泛化。
-- M33 W4：字节切片（clamp 语义与 Base.String.substring 一致），避免 List 桥接。
-- M34.5：编译器内部缓存原语（Marshal 纯数据；含闭包会在运行期失败）。
-- M34.4：异步子进程（workspace 并行 check）。spawn 返回 pid，wait 返回退出码。
-- Nat 度量/算术：运行时表示是 OCaml int（Zero=0、Succ 饱和 +1）。
-- 语义：add/mul 饱和到 max_int，sub 截断到 0，div 除零与 Int 同文案失败。
-- M38：运行时诊断原语。`prim_eff_eprint` 写 stderr 并 flush（报告器/调试输出用）；
-- `prim_fail` 抛 Failure（报告器把它渲染成 "vuna: runtime error: ..."）。`prim_eff_eprint`
-- 供工具链的 stderr 报告使用；`prim_fail` 供工具链的 fuel 耗尽路径使用。
-- 内部 cast（`visible = False`）：只由精化器插入，runtime 是 OCaml 的 `%identity`；
-- 运行时位置的不透明擦除依赖值靠它进出（见 docs/reference/effects.md §5/§6）。
-- 运行时续延（Layer 1）：一次性 effect handler，只供 `Base.Eff` 的包装使用；类型在源码层由 Base.Eff 的 API 收紧，
-- 运行时表达式用 Obj.magic 桥接（与 M39 的不透明 cast 同一套表示）。
-- Layer 3：最小并发（OCaml 5 Domain）。只允许在 main 域 fork/await；任务体应是
-- 行已被处理干净的 Eff（Base.EffAsync 的 API 强制 Nil）。
-- W9：单线程 fiber 调度器原语（Base.EffSched 的信任边界；runtime = dtp_sched_*）。
-- 原生睡眠（W10 收尾）：微秒；真实实现是 `Unix.sleepf`（阻塞，非忙等）。
-- clock 族（与 effTimeUs 同族）；interp 不归约（OpNone），效果程序只 compile+run。
-- `Base.EffClock` 与工具链的 sleep 都直接使用它（`spinMicros` 已删除）。
-- F3 B：语言级调试构造（不经过宿主层；assert/todo 由 Resolve 在 release 构建拒绝）。
-- D23：`+ - * /` 只作为 codegen / interp 的映射目标（源码里的 `+` 等已由 Loader
-- 换成 `Base.Num` 的方法别名，精化期再特化回这四个内建），因此不再对用户源码可见。
-- 位运算（可见：库与编译器直接用；语义见 `IntrinsicOp` 的注释与 primitives.md）。
baseIntrinsics =
  [ Intrinsic "+" (IFun IInt (IFun IInt IInt)) OpAdd "bi_add" False,
    Intrinsic "-" (IFun IInt (IFun IInt IInt)) OpSub "bi_sub" False,
    Intrinsic "*" (IFun IInt (IFun IInt IInt)) OpMul "bi_mul" False,
    Intrinsic "/" (IFun IInt (IFun IInt IInt)) OpDiv "bi_div" False,
    Intrinsic "bitAnd" (IFun IInt (IFun IInt IInt)) OpBitAnd "bi_bitAnd" True,
    Intrinsic "bitOr" (IFun IInt (IFun IInt IInt)) OpBitOr "bi_bitOr" True,
    Intrinsic "bitXor" (IFun IInt (IFun IInt IInt)) OpBitXor "bi_bitXor" True,
    Intrinsic "bitNot" (IFun IInt IInt) OpBitNot "bi_bitNot" True,
    Intrinsic "bitShl" (IFun IInt (IFun IInt IInt)) OpBitShl "bi_bitShl" True,
    Intrinsic "bitShr" (IFun IInt (IFun IInt IInt)) OpBitShr "bi_bitShr" True,
    Intrinsic "++" (IFun IStr (IFun IStr IStr)) OpConcat "bi_concat" True,
    Intrinsic "&&" (IFun IBool (IFun IBool IBool)) OpAnd "bi_and" True,
    Intrinsic "||" (IFun IBool (IFun IBool IBool)) OpOr "bi_or" True,
    Intrinsic "strFromInt" (IFun IInt IStr) OpStrFromInt "bi_strFromInt" True,
    Intrinsic "strUnpack" (IFun IStr (IList IInt)) OpStrUnpack "dtp_unpack" True,
    Intrinsic "strPack" (IFun (IList IInt) IStr) OpStrPack "dtp_pack" True,
    Intrinsic "strLength" (IFun IStr IInt) OpStrLength "bi_strLength" True,
    Intrinsic "strConcatMany" (IFun (IList IStr) IStr) OpStrConcatMany "dtp_concatMany" True,
    Intrinsic "strSubstTemplate" (IFun IStr (IFun (IList IStr) IStr)) OpStrSubstTemplate "dtp_substTemplate" True,
    Intrinsic "strHash" (IFun IStr IInt) OpStrHash "dtp_strHash" True,
    Intrinsic "strAt" (IFun IStr (IFun IInt IInt)) OpStrAt "dtp_strAt" True,
    Intrinsic "strSubstring" (IFun IInt (IFun IInt (IFun IStr IStr))) OpStrSubstring "dtp_substring" True,
    Intrinsic "strShow" (IFun IStr IStr) OpStrShow "dt_show_string" True,
    Intrinsic primEraseName (IPi "a" (IFun (IVar "a") (IVar "a"))) OpIdentity "Obj.magic" False,
    Intrinsic "natAdd" (IFun INat (IFun INat INat)) OpNatAdd "bi_natAdd" True,
    Intrinsic "natSub" (IFun INat (IFun INat INat)) OpNatSub "bi_natSub" True,
    Intrinsic "natMul" (IFun INat (IFun INat INat)) OpNatMul "bi_natMul" True,
    Intrinsic "natDiv" (IFun INat (IFun INat INat)) OpNatDiv "bi_natDiv" True,
    Intrinsic "natToInt" (IFun INat IInt) OpNatToInt "bi_natToInt" True,
    Intrinsic "natFromInt" (IFun IInt INat) OpNatFromInt "bi_natFromInt" True,
    Intrinsic "arrayLength" (IPi "a" (IFun (IArray (IVar "a")) IInt)) OpNone "Array.length" True,
    Intrinsic "arrayEmpty" (IPi "a" (IArray (IVar "a"))) OpNone "[||]" True,
    Intrinsic "arrayGet" (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IVar "a")))) OpNone "Array.get" True,
    Intrinsic "arraySet" (IPi "a" (IFun (IArray (IVar "a")) (IFun IInt (IFun (IVar "a") (IArray (IVar "a")))))) OpNone "dtp_arraySet" True,
    Intrinsic "arrayMake" (IPi "a" (IFun IInt (IFun (IVar "a") (IArray (IVar "a"))))) OpNone "Array.make" True,
    Intrinsic "arrayFromList" (IPi "a" (IFun (IList (IVar "a")) (IArray (IVar "a")))) OpNone "(fun xs -> Array.of_list (dtp_ocamlOf xs))" True,
    Intrinsic "arrayToList" (IPi "a" (IFun (IArray (IVar "a")) (IList (IVar "a")))) OpNone "(fun a -> dtp_listOf (Array.to_list a))" True,
    Intrinsic "prim_effectPerform" (IPi "a" (IPi "b" (IFun IStr (IFun IStr (IFun (IVar "a") (IVar "b")))))) OpNone "(fun key name v -> Obj.obj (Effect.perform (Perform (key, name, Obj.repr v))))" True,
    Intrinsic "prim_effectHandle" (IPi "u" (IPi "a" (IPi "b" (IPi "ret" (IPi "h" (IFun IStr (IFun IStr (IFun (IVar "ret") (IFun (IVar "h") (IFun (IFun (IVar "u") (IVar "a")) (IFun (IVar "u") (IVar "b")))))))))))) OpNone "dtp_effect_handle" True,
    Intrinsic "prim_cleanupPush" (IFun (IFun IInt IInt) IInt) OpNone "dtp_cleanup_push" True,
    Intrinsic "prim_cleanupPop" (IFun IInt IInt) OpNone "dtp_cleanup_pop" True,
    Intrinsic "prim_schedNewScope" (IFun IInt IInt) OpNone "(fun _ -> dtp_sched_new_scope ())" True,
    Intrinsic "prim_schedFork" (IPi "a" (IFun IInt (IFun (IFun IInt (IVar "a")) IInt))) OpNone "(fun sc th -> dtp_sched_fork sc th)" True,
    Intrinsic "prim_schedYield" (IFun IInt IInt) OpNone "(fun _ -> dtp_sched_yield ())" True,
    Intrinsic "prim_schedIsCancelled" (IFun IInt IInt) OpNone "(fun _ -> dtp_sched_is_cancelled ())" True,
    Intrinsic "prim_schedAwait" (IFun IInt IInt) OpNone "dtp_sched_await" True,
    Intrinsic "prim_schedTaskResult" (IPi "a" (IFun IInt (IVar "a"))) OpNone "(fun id -> Obj.obj (dtp_sched_task_result id))" True,
    Intrinsic "prim_schedTaskError" (IFun IInt IStr) OpNone "dtp_sched_task_error" True,
    Intrinsic "prim_schedCancelTask" (IFun IInt IInt) OpNone "dtp_sched_cancel_task_prim" True,
    Intrinsic "prim_schedCancelScope" (IFun IInt IInt) OpNone "dtp_sched_cancel_scope" True,
    Intrinsic "prim_schedScopeWait" (IFun IInt IInt) OpNone "dtp_sched_scope_wait" True,
    Intrinsic "prim_schedScopeWaitTimeout" (IFun IInt (IFun IInt IInt)) OpNone "dtp_sched_scope_wait_timeout" True,
    Intrinsic "prim_schedScopeError" (IFun IInt IStr) OpNone "dtp_sched_scope_error" True,
    Intrinsic "prim_schedScopeCount" (IFun IInt IInt) OpNone "dtp_sched_scope_count" True,
    Intrinsic "prim_fail" (IPi "a" (IFun IStr (IVar "a"))) OpNone "(fun msg -> failwith msg)" True,
    Intrinsic assertIntrinsicName (IPi "a" (IFun IBool (IFun IStr (IFun (IVar "a") (IVar "a"))))) OpNone "(fun b msg x -> if b then x else failwith (\"assertion failed: \" ^ msg))" True,
    Intrinsic todoIntrinsicName (IPi "a" (IFun IStr (IVar "a"))) OpNone "(fun msg -> failwith (\"TODO: \" ^ msg))" True,
    Intrinsic "bi_eq_int" (IFun IInt (IFun IInt IBool)) OpEqInt "bi_eq_int" False,
    Intrinsic "bi_neq_int" (IFun IInt (IFun IInt IBool)) OpNeqInt "bi_neq_int" False,
    Intrinsic "bi_eq_str" (IFun IStr (IFun IStr IBool)) OpEqStr "bi_eq_str" False,
    Intrinsic "bi_neq_str" (IFun IStr (IFun IStr IBool)) OpNeqStr "bi_neq_str" False,
    Intrinsic "bi_lt_int" (IFun IInt (IFun IInt IBool)) OpLtInt "bi_lt_int" False,
    Intrinsic "bi_le_int" (IFun IInt (IFun IInt IBool)) OpLeInt "bi_le_int" False,
    Intrinsic "bi_gt_int" (IFun IInt (IFun IInt IBool)) OpGtInt "bi_gt_int" False,
    Intrinsic "bi_ge_int" (IFun IInt (IFun IInt IBool)) OpGeInt "bi_ge_int" False,
    Intrinsic "bi_lt_generic" (IFun IInt (IFun IInt IBool)) OpLtGeneric "bi_lt_generic" False,
    Intrinsic "bi_le_generic" (IFun IInt (IFun IInt IBool)) OpLeGeneric "bi_le_generic" False,
    Intrinsic "bi_gt_generic" (IFun IInt (IFun IInt IBool)) OpGtGeneric "bi_gt_generic" False,
    Intrinsic "bi_ge_generic" (IFun IInt (IFun IInt IBool)) OpGeGeneric "bi_ge_generic" False
  ]

-- | 浮点相关内建（字面量转换/算术/比较/格式化）。单独成表：见 `baseIntrinsics` 的
-- bootstrap 说明；顺序上追加在基础表之后。
floatIntrinsics : List Intrinsic
floatIntrinsics =
  [ Intrinsic "strFromFloat" (IFun IFloat IStr) OpStrFromFloat "string_of_float" True,
    Intrinsic "floatFromInt" (IFun IInt IFloat) OpFloatFromInt "float_of_int" True,
    Intrinsic "intFromFloat" (IFun IFloat IInt) OpIntFromFloat "int_of_float" True,
    Intrinsic "floatAbs" (IFun IFloat IFloat) OpFloatAbs "abs_float" True,
    Intrinsic "floatSqrt" (IFun IFloat IFloat) OpFloatSqrt "sqrt" True,
    Intrinsic "bi_add_float" (IFun IFloat (IFun IFloat IFloat)) OpAddF "bi_add_float" False,
    Intrinsic "bi_sub_float" (IFun IFloat (IFun IFloat IFloat)) OpSubF "bi_sub_float" False,
    Intrinsic "bi_mul_float" (IFun IFloat (IFun IFloat IFloat)) OpMulF "bi_mul_float" False,
    Intrinsic "bi_div_float" (IFun IFloat (IFun IFloat IFloat)) OpDivF "bi_div_float" False,
    Intrinsic "bi_eq_float" (IFun IFloat (IFun IFloat IBool)) OpEqF "bi_eq_float" False,
    Intrinsic "bi_neq_float" (IFun IFloat (IFun IFloat IBool)) OpNeqF "bi_neq_float" False,
    Intrinsic "bi_lt_float" (IFun IFloat (IFun IFloat IBool)) OpLtF "bi_lt_float" False,
    Intrinsic "bi_le_float" (IFun IFloat (IFun IFloat IBool)) OpLeF "bi_le_float" False,
    Intrinsic "bi_gt_float" (IFun IFloat (IFun IFloat IBool)) OpGtF "bi_gt_float" False,
    Intrinsic "bi_ge_float" (IFun IFloat (IFun IFloat IBool)) OpGeF "bi_ge_float" False
  ]

-- | Eff 动作版本的宿主原语（bootstrap 过渡表）：名字带 `prim_eff_` 前缀，
-- 类型为 `Eff [] a`。单独成表是为了让每段列表字面量
-- 留在旧 seed 的 fuel 内（同 `floatIntrinsics`；迁移完成后本表并改名）。
effIntrinsics : List Intrinsic
-- 阶段 0 spike：带内建 ConsoleOp 行的宿主打印（验证 `IEffRow`/entry/runMain 机制）。
-- 阶段 3：带内建 FsOp 行的宿主原语（entry 自动预装用；与旧原语同 runtime）。
-- 阶段 3：带内建效应行的宿主原语（Clock/Env/Process/Exit/Stdin/Args）。
-- 阶段 4：Ref / Net 的带行宿主原语。
effIntrinsics =
  [ Intrinsic primEffBind1Name (IPi "a" (IPi "b" (IFun1 (IEff (IVar "a")) (IFun1 (IFun1 (IVar "a") (IEff (IVar "b"))) (IEff (IVar "b")))))) OpNone "" True,
    Intrinsic "effTimeUs" (IEff IInt) OpNone "(dtp_timeUs ())" True,
    Intrinsic "prim_eff_sleep" (IFun IInt (IEff IInt)) OpNone "dtp_sleep" True,
    Intrinsic "@vuna@prim_eff_sleep" (IFun IInt (IEff IInt)) OpNone "dtp_sleep" False,
    Intrinsic "prim_eff_newRef" (IPi "a" (IFun (IVar "a") (IEff (IRef (IVar "a"))))) OpNone "(fun x -> ref x)" True,
    Intrinsic "@vuna@prim_eff_newRef" (IPi "a" (IFun (IVar "a") (IEff (IRef (IVar "a"))))) OpNone "(fun x -> ref x)" False,
    Intrinsic "prim_eff_readRef" (IPi "a" (IFun (IRef (IVar "a")) (IEff (IVar "a")))) OpNone "(fun r -> !r)" True,
    Intrinsic "@vuna@prim_eff_readRef" (IPi "a" (IFun (IRef (IVar "a")) (IEff (IVar "a")))) OpNone "(fun r -> !r)" False,
    Intrinsic "prim_eff_writeRef" (IPi "a" (IFun (IRef (IVar "a")) (IFun (IVar "a") (IEff IInt)))) OpNone "(fun r v -> r := v; 0)" True,
    Intrinsic "@vuna@prim_eff_writeRef" (IPi "a" (IFun (IRef (IVar "a")) (IFun (IVar "a") (IEff IInt)))) OpNone "(fun r v -> r := v; 0)" False,
    Intrinsic "prim_eff_print" (IFun IStr (IEff IInt)) OpNone "dtp_print" True,
    Intrinsic "@vuna@prim_eff_print" (IFun IStr (IEff IInt)) OpNone "dtp_print" False,
    Intrinsic "prim_eff_print_host" (IFun IStr (IEffRow (IRowCons "default" (IGlobal "Base.EffConsole.ConsoleOp") IRowNil) IInt)) OpNone "dtp_print" True,
    Intrinsic "@vuna@prim_eff_print_host" (IFun IStr (IEffRow (IRowCons "default" (IGlobal "Base.EffConsole.ConsoleOp") IRowNil) IInt)) OpNone "dtp_print" False,
    Intrinsic "@vuna@host@print" (IFun IStr (IEffRow (IRowCons "default" (IGlobal "Base.EffConsole.ConsoleOp") IRowNil) IInt)) OpNone "dtp_print" False,
    Intrinsic "prim_eff_eprint" (IFun IStr (IEff IInt)) OpNone "(fun s -> prerr_string s; flush stderr; String.length s)" True,
    Intrinsic "@vuna@prim_eff_eprint" (IFun IStr (IEff IInt)) OpNone "(fun s -> prerr_string s; flush stderr; String.length s)" False,
    Intrinsic "prim_eff_readFile" (IFun IStr (IEff IStr)) OpNone "dtp_readFile" True,
    Intrinsic "@vuna@prim_eff_readFile" (IFun IStr (IEff IStr)) OpNone "dtp_readFile" False,
    Intrinsic "prim_eff_writeFile" (IFun IStr (IFun IStr (IEff IInt))) OpNone "dtp_writeFile" True,
    Intrinsic "@vuna@prim_eff_writeFile" (IFun IStr (IFun IStr (IEff IInt))) OpNone "dtp_writeFile" False,
    Intrinsic "prim_eff_writeFileAtomic" (IFun IStr (IFun IStr (IEff IInt))) OpNone "dtp_writeFileAtomic" True,
    Intrinsic "@vuna@prim_eff_writeFileAtomic" (IFun IStr (IFun IStr (IEff IInt))) OpNone "dtp_writeFileAtomic" False,
    Intrinsic "prim_eff_readLine" (IEff IStr) OpNone "(dtp_readLine ())" True,
    Intrinsic "@vuna@prim_eff_readLine" (IEff IStr) OpNone "(dtp_readLine ())" False,
    Intrinsic "prim_eff_readBytes" (IFun IInt (IEff IStr)) OpNone "dtp_readBytes" True,
    Intrinsic "@vuna@prim_eff_readBytes" (IFun IInt (IEff IStr)) OpNone "dtp_readBytes" False,
    Intrinsic "prim_eff_getArgs" (IEff (IList IStr)) OpNone "(dtp_listOf (dtp_getArgs ()))" True,
    Intrinsic "@vuna@prim_eff_getArgs" (IEff (IList IStr)) OpNone "(dtp_listOf (dtp_getArgs ()))" False,
    Intrinsic "prim_eff_readDir" (IFun IStr (IEff (IList IStr))) OpNone "(fun p -> dtp_listOf (dtp_readDir p))" True,
    Intrinsic "@vuna@prim_eff_readDir" (IFun IStr (IEff (IList IStr))) OpNone "(fun p -> dtp_listOf (dtp_readDir p))" False,
    Intrinsic "prim_eff_isDirectory" (IFun IStr (IEff IBool)) OpNone "dtp_isDirectory" True,
    Intrinsic "@vuna@prim_eff_isDirectory" (IFun IStr (IEff IBool)) OpNone "dtp_isDirectory" False,
    Intrinsic "prim_eff_makeDir" (IFun IStr (IEff IInt)) OpNone "dtp_makeDir" True,
    Intrinsic "@vuna@prim_eff_makeDir" (IFun IStr (IEff IInt)) OpNone "dtp_makeDir" False,
    Intrinsic "prim_eff_removeFile" (IFun IStr (IEff IInt)) OpNone "dtp_removeFile" True,
    Intrinsic "@vuna@prim_eff_removeFile" (IFun IStr (IEff IInt)) OpNone "dtp_removeFile" False,
