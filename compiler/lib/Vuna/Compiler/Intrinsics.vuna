  ( IType(..)
  , Intrinsic
  , IntrinsicOp(..)
  , TypeIntrinsic(..)
  , allIntrinsics
  , arityOfType
  , assertIntrinsicName
  , boolFalseCtor
  , boolTrueCtor
  , boolTypeName
  , canonicalCtorsFor
  , debugLineIntrinsicName
  , debugOnIntrinsicName
  , effDefaultInstance
  , effMainRunName
  , effMemberFamilyName
  , effMemberHereCtor
  , effMemberThereCtor
  , effMkCtor
  , effRowAppendName
  , effRowConsCtor
  , effRowFamilyName
  , effRowNilCtor
  , effRowRemName
  , effRunName
  , effTypeName
  , effUnitTypeName
  , findIntrinsic
  , floatIntrinsicNames
  , floatTypeName
  , fromFloatMethodName
  , fromFloatTypeName
  , fromIntMethodName
  , fromIntTypeName
  , fromStringMethodName
  , fromStringTypeName
  , intTypeName
  , internalIntrinsicNames
  , internalIntrinsics
  , interpMethodName
  , interpTypeName
  , intrinsicArity
  , intrinsicName
  , intrinsicReturnsEff
  , intrinsicSignature
  , intrinsicVisible
  , isDebugOnlyName
  , isIntrinsicName
  , isIntrinsicTypeName
  , isTypeConstructorName
  , listConsCtor
  , listFamilyName
  , listNilCtor
  , mainShowDefName
  , natSuccCtor
  , natTypeName
  , natZeroCtor
  , needsListBridge
  , preludeTypeNames
  , preludeValueNames
  , primEffBind1Name
  , primEraseName
