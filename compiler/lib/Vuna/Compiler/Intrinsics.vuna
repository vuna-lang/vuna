-- | 内建声明的唯一真源（M27）：内建/原语的名字、签名形状、interp 归约标签、能力与可见性。
module Vuna.Compiler.Intrinsics
  ( Capability(..)
  , IType(..)
  , Intrinsic
  , IntrinsicOp(..)
  , TypeIntrinsic(..)
  , allIntrinsics
  , arityOfType
  , assertIntrinsicName
  , boolFalseCtor
  , boolTrueCtor
  , boolTypeName
  , canonicalCtorsFor
  , capabilityName
  , capabilityNames
  , dbgIntrinsicName
  , effDefaultInstance
  , effMemberFamilyName
  , effMemberHereCtor
  , effMemberThereCtor
  , effRowConsCtor
  , effRowFamilyName
  , effRowNilCtor
  , effRowRemName
  , effRunName
  , effTypeName
  , findIntrinsic
  , floatIntrinsicNames
  , floatTypeName
  , fromFloatMethodName
  , fromFloatTypeName
  , fromIntMethodName
  , fromIntTypeName
  , fromStringMethodName
  , fromStringTypeName
  , hostUnsafeExecutorName
  , intTypeName
  , interpMethodName
  , interpTypeName
  , intrinsicArity
  , intrinsicCapability
  , intrinsicName
  , intrinsicReturnsIO
  , intrinsicSignature
  , intrinsicVisible
  , ioFamilyName
  , ioTypeName
  , isDebugOnlyName
  , isEffectfulIntrinsic
  , isIOAlgebraName
  , isIntrinsicName
  , isIntrinsicTypeName
  , isTypeConstructorName
  , listConsCtor
  , listFamilyName
  , listNilCtor
  , mainRunDefName
  , mainShowDefName
  , natSuccCtor
  , natTypeName
  , natZeroCtor
  , needsListBridge
  , parseCapability
  , preludeTypeNames
  , preludeValueNames
