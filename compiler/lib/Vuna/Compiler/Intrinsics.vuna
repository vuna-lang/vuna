    Intrinsic "bi_eq_str" (IFun IStr (IFun IStr IBool)) OpEqStr Nothing "bi_eq_str" False,
    Intrinsic "bi_neq_str" (IFun IStr (IFun IStr IBool)) OpNeqStr Nothing "bi_neq_str" False,
    Intrinsic "bi_lt_int" (IFun IInt (IFun IInt IBool)) OpLtInt Nothing "bi_lt_int" False,
    Intrinsic "bi_le_int" (IFun IInt (IFun IInt IBool)) OpLeInt Nothing "bi_le_int" False,
    Intrinsic "bi_gt_int" (IFun IInt (IFun IInt IBool)) OpGtInt Nothing "bi_gt_int" False,
    Intrinsic "bi_ge_int" (IFun IInt (IFun IInt IBool)) OpGeInt Nothing "bi_ge_int" False,
    Intrinsic "bi_lt_generic" (IFun IInt (IFun IInt IBool)) OpLtGeneric Nothing "bi_lt_generic" False,
    Intrinsic "bi_le_generic" (IFun IInt (IFun IInt IBool)) OpLeGeneric Nothing "bi_le_generic" False,
    Intrinsic "bi_gt_generic" (IFun IInt (IFun IInt IBool)) OpGtGeneric Nothing "bi_gt_generic" False,
    Intrinsic "bi_ge_generic" (IFun IInt (IFun IInt IBool)) OpGeGeneric Nothing "bi_ge_generic" False
  ]

-- | 浮点相关内建（字面量转换/算术/比较/格式化）。单独成表：见 `baseIntrinsics` 的
-- bootstrap 说明；顺序上追加在基础表之后。
floatIntrinsics : List Intrinsic
floatIntrinsics =
  [ Intrinsic "strFromFloat" (IFun IFloat IStr) OpStrFromFloat Nothing "string_of_float" True,
    Intrinsic "floatFromInt" (IFun IInt IFloat) OpFloatFromInt Nothing "float_of_int" True,
    Intrinsic "intFromFloat" (IFun IFloat IInt) OpIntFromFloat Nothing "int_of_float" True,
    Intrinsic "floatAbs" (IFun IFloat IFloat) OpFloatAbs Nothing "abs_float" True,
    Intrinsic "floatSqrt" (IFun IFloat IFloat) OpFloatSqrt Nothing "sqrt" True,
    Intrinsic "bi_add_float" (IFun IFloat (IFun IFloat IFloat)) OpAddF Nothing "bi_add_float" False,
    Intrinsic "bi_sub_float" (IFun IFloat (IFun IFloat IFloat)) OpSubF Nothing "bi_sub_float" False,
    Intrinsic "bi_mul_float" (IFun IFloat (IFun IFloat IFloat)) OpMulF Nothing "bi_mul_float" False,
    Intrinsic "bi_div_float" (IFun IFloat (IFun IFloat IFloat)) OpDivF Nothing "bi_div_float" False,
    Intrinsic "bi_eq_float" (IFun IFloat (IFun IFloat IBool)) OpEqF Nothing "bi_eq_float" False,
    Intrinsic "bi_neq_float" (IFun IFloat (IFun IFloat IBool)) OpNeqF Nothing "bi_neq_float" False,
    Intrinsic "bi_lt_float" (IFun IFloat (IFun IFloat IBool)) OpLtF Nothing "bi_lt_float" False,
    Intrinsic "bi_le_float" (IFun IFloat (IFun IFloat IBool)) OpLeF Nothing "bi_le_float" False,
    Intrinsic "bi_gt_float" (IFun IFloat (IFun IFloat IBool)) OpGtF Nothing "bi_gt_float" False,
    Intrinsic "bi_ge_float" (IFun IFloat (IFun IFloat IBool)) OpGeF Nothing "bi_ge_float" False
  ]

-- | 所有内建声明：基础表 + 浮点表。
allIntrinsics : List Intrinsic
allIntrinsics = append baseIntrinsics floatIntrinsics

-- | 全部与 Float 有关的内建名（字面量/算术/比较/转换/格式化）：`vuna interp`/REPL 的
-- 求值 guard 与 codegen 的按需 runtime helper 都按它判定「程序是否使用浮点」。
floatIntrinsicNames : List String
floatIntrinsicNames =
  [ "strFromFloat",
    "floatFromInt",
    "intFromFloat",
    "floatAbs",
    "floatSqrt",
    "bi_add_float",
    "bi_sub_float",
    "bi_mul_float",
    "bi_div_float",
    "bi_eq_float",
    "bi_neq_float",
    "bi_lt_float",
    "bi_le_float",
    "bi_gt_float",
    "bi_ge_float"
  ]

-- | 名字 → 内建声明的查询表（由 `allIntrinsics` 一次性建好，供 `findIntrinsic` 用）。
intrinsicTbl : HashMap String Intrinsic
intrinsicTbl =
  Base.HashMap.insertAll (map (\i => Pair (intrinsicName i) i) allIntrinsics)
    (Base.HashMap.fromList [])

-- | 按名字查内建声明（内部用 `HashMap` 表）；内部 `bi_*` 名也能查到。
findIntrinsic : String -> Maybe Intrinsic
findIntrinsic name = Base.HashMap.lookup name intrinsicTbl

-- | 名字是否是**对用户源码可见**的内建（内部 `bi_*` 返回 `False`）。
isIntrinsicName : String -> Bool
isIntrinsicName name = case findIntrinsic name of
  Just i => intrinsicVisible i
  Nothing => False

-- | 用户可见的内建声明子集（进 Loader / prelude）。
userIntrinsics : List Intrinsic
userIntrinsics = filter intrinsicVisible allIntrinsics

-- | 用户可见的内建值名字（prelude 全局与「禁止重定义」名单共用）。
preludeValueNames : List String
preludeValueNames = map intrinsicName userIntrinsics
