module Vuna.Compiler.Codegen.Term where

-- Vuna.Compiler.Codegen.Term：IR → OCaml 文本 + DT 运行时前缀。
--
-- Track A 第一步之后本模块**只消费 IR**（`Vuna.Compiler.Ir`）：擦除判定、表示决策、
-- Nat 折回、内联形态、入口分类都已在 `Codegen.Lower` 完成。这里只剩：
--   * 运行时文本常量（`dtRuntime` / 报告器 / 浮点与 tracing helper / List 桥接）；
--   * `Ir` 节点 → OCaml 文本（含跨单元限定与依赖累积）；
--   * 分组 → `let` / `let rec ... and ...` 文本；
--   * main 钩子文本。
--
-- 没有 fuel：旧实现的 `genTermFuel` 固定 512 步预算随迁移消失（正常源码的嵌套深度
-- 不再触发 `IC_FuelExhausted (codegen)`）。
import Base.List
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Ir
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Codegen.Runtime

export dtRuntime : String
dtRuntime = """let () =
  let c = Gc.get () in
  Gc.set { c with minor_heap_size = 16 * 1024 * 1024; space_overhead = 200 }
let () =
  if (try Sys.getenv \"VN_PERF_STATS\" with Not_found -> \"\") <> \"\" then
    at_exit (fun () ->
      let s = Gc.quick_stat () in
      Printf.eprintf \"VN_PERF minor_words=%.0f major_words=%.0f minor_collections=%d major_collections=%d top_heap_words=%d\\n\"
        s.Gc.minor_words s.Gc.major_words s.Gc.minor_collections s.Gc.major_collections s.Gc.top_heap_words)
let bi_add a b = a + b
let bi_sub a b = a - b
let bi_mul a b = a * b
let bi_div a b = if b = 0 then failwith \"division by zero\" else a / b
let bi_eq_int (a : int) (b : int) = a = b
let bi_neq_int (a : int) (b : int) = a <> b
let bi_eq_str (a : string) (b : string) = a = b
let bi_neq_str (a : string) (b : string) = a <> b
let bi_strFromInt (n : int) = string_of_int n
let bi_strLength (s : string) = String.length s
let bi_strUnpack (s : string) = List.init (String.length s) (fun i -> Char.code s.[i])
let bi_strPack (cs : int list) =
  let a = Array.of_list cs in
  String.init (Array.length a) (fun i -> Char.chr a.(i))
let bi_lt_int (a : int) (b : int) = a < b
let bi_le_int (a : int) (b : int) = a <= b
let bi_gt_int (a : int) (b : int) = a > b
let bi_ge_int (a : int) (b : int) = a >= b
let bi_lt_generic (a : 'a) (b : 'a) = compare a b < 0
let bi_le_generic (a : 'a) (b : 'a) = compare a b <= 0
let bi_gt_generic (a : 'a) (b : 'a) = compare a b > 0
let bi_ge_generic (a : 'a) (b : 'a) = compare a b >= 0
let bi_concat a b = a ^ b
let bi_and a b = a && b
let bi_or a b = a || b
let bi_bitAnd (a : int) (b : int) = a land b
let bi_bitOr (a : int) (b : int) = a lor b
let bi_bitXor (a : int) (b : int) = a lxor b
let bi_bitNot (a : int) = lnot a
let bi_bitShl (a : int) (n : int) = if n < 0 || n >= 63 then 0 else a lsl n
let bi_bitShr (a : int) (n : int) = if n < 0 || n >= 63 then 0 else a lsr n
let bi_natSucc (n : int) = if n >= max_int then max_int else n + 1
let bi_natAdd (a : int) (b : int) = if a > max_int - b then max_int else a + b
let bi_natSub (a : int) (b : int) = if a <= b then 0 else a - b
let bi_natMul (a : int) (b : int) =
  if a <= 0 || b <= 0 then 0 else if a > max_int / b then max_int else a * b
let bi_natDiv (a : int) (b : int) = if b = 0 then failwith \"division by zero\" else a / b
let bi_natToInt (n : int) = n
let bi_natFromInt (n : int) = if n <= 0 then 0 else n
let dt_show_bool b = if b then \"True\" else \"False\"
let dt_show_string s =
  let buf = Buffer.create 16 in
  Buffer.add_char buf (Char.chr 34);
  String.iter (fun c ->
    let n = Char.code c in
    if n = 34 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 34))
    else if n = 92 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 92))
    else if n = 10 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"n\")
    else if n = 9 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"t\")
    else if n = 13 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"r\")
    else Buffer.add_char buf c) s;
  Buffer.add_char buf (Char.chr 34);
  Buffer.contents buf
${dtPrimRuntime}"""

-- M21：effectful 内建（`prim_*`）的 DT 运行时实现。
-- 签名在 `Vuna.Compiler.Intrinsics`（唯一真源），这里补 OCaml 侧实现（对应
-- `Codegen.Runtime` 的符号表）；`@vuna@prim_eff_getArgs` / `@vuna@prim_eff_readLine` 是零参**值**，
-- 所以在引用点展开成 `dtp_*(()`，与 Codegen 的既有处理一致（每次求值都重新读）。
-- `@vuna@prim_eff_readBytes` 是**函数**（`Int -> String`）：最多读 n 字节、有数据就立即返回
-- （可能少于 n），EOF 返回 `""`——LSP 的帧循环靠它精确读 Content-Length 字节。
dtPrimRuntime : String
dtPrimRuntime = ("""type _ Effect.t += Perform : string * string * Obj.t -> Obj.t Effect.t

(* W7：bracket 的 abort cleanup 登记表（每纤程一份，LIFO）。
   `prim_effectHandle` 在安装 handler 时记下当前深度 mark；handler 正常返回 /
   抛异常 / 丢弃续延（abort）时，把 mark 之上仍未弹出的 cleanup 逐个执行——这些
   正是被丢弃的续延里打开的 bracket。纤程用 `dtp_cleanup_fiber` 区分（调度器在
   运行某个任务时设置它）；非调度器上下文（-1）有一份独立栈。
   注意：cleanup 在 handler 退出点执行，只能访问**外层** handler（当前 handler
   的效应在该点不可用）；执行期异常被吞掉，避免污染 abort 结果。 *)
let dtp_cleanup_fiber = ref (-1)
let dtp_cleanup_stacks : (int, (unit -> unit) list ref) Hashtbl.t = Hashtbl.create 8
let dtp_cleanup_stack_of (fid : int) =
  match Hashtbl.find_opt dtp_cleanup_stacks fid with
  | Some r -> r
  | None ->
    let r = ref [] in
    Hashtbl.replace dtp_cleanup_stacks fid r;
    r
let dtp_cleanup_current () = dtp_cleanup_stack_of !dtp_cleanup_fiber
let dtp_cleanup_mark () = List.length !(dtp_cleanup_current ())
let dtp_cleanup_push (f : int -> int) : int =
  let r = dtp_cleanup_current () in
  r := (fun () -> ignore (f 0)) :: !r;
  0
let dtp_cleanup_pop (_ : int) : int =
  let r = dtp_cleanup_current () in
  (match !r with _ :: rest -> r := rest | [] -> ());
  0
let dtp_cleanup_run_to (mark : int) =
  let r = dtp_cleanup_current () in
  let rec go fuel =
    if fuel <= 0 then ()
    else if List.length !r <= mark then ()
    else match !r with
      | [] -> ()
      | f :: rest -> r := rest; (try f () with _ -> ()); go (fuel - 1)
  in
  go 256
let dtp_cleanup_run_all_for (fid : int) =
  let r = dtp_cleanup_stack_of fid in
  let rec go fuel =
    if fuel <= 0 then ()
    else match !r with
      | [] -> ()
      | f :: rest -> r := rest; (try f () with _ -> ()); go (fuel - 1)
  in
  go 256
let dtp_cleanup_forget (fid : int) = Hashtbl.remove dtp_cleanup_stacks fid
let dtp_cleanup_reset () =
  Hashtbl.reset dtp_cleanup_stacks;
  dtp_cleanup_fiber := -1

(* handler 的运行时壳：与旧内联实现等价，但 handler 退出时清掉其 extent 内残留的
   bracket cleanup（abort = 续延被丢弃，库层 finally 不会再跑）。 *)
let dtp_effect_handle key name ret h th =
  fun u ->
    let mark = dtp_cleanup_mark () in
    let run_cleanups () = dtp_cleanup_run_to mark in
    (* 外层 Obj.magic 与旧内联实现一致：effc 的 continue 返回 Obj.t，去掉它会让
       handler 的 answer 类型被钉成 Obj.t。 *)
    Obj.magic
      (match Effect.Deep.match_with (fun () -> (Obj.magic th) u) ()
        { retc = (fun x -> (Obj.magic ret) x);
          exnc = (fun e -> raise e);
          effc = (fun (type a) (eff : a Effect.t) -> match eff with
            | Perform (k, n, payload) when k = key && n = name ->
              Some (fun (cont : (a, Obj.t) Effect.Deep.continuation) ->
                (Obj.magic h) payload (fun v -> Effect.Deep.continue cont (Obj.repr v)))
            | _ -> None) }
      with
      | r -> run_cleanups (); r
      | exception e -> run_cleanups (); raise e)
let dtp_print s = print_string s; flush stdout; String.length s
let dtp_async_tbl : (int, unit -> Obj.t) Hashtbl.t = Hashtbl.create 16
let dtp_async_next = ref 0
let dtp_async_fork th =
  let id = !dtp_async_next in
  incr dtp_async_next;
  let d = Domain.spawn (fun () -> th 0) in
  Hashtbl.replace dtp_async_tbl id (fun () -> Obj.repr (Domain.join d));
  id
let dtp_async_await (h : int) : Obj.t =
  match Hashtbl.find_opt dtp_async_tbl h with
  | Some join -> join ()
  | None -> failwith \"async: invalid task handle\"
let dtp_readFile path =
  try
    let ch = open_in_bin path in
    Fun.protect ~finally:(fun () -> close_in_noerr ch)
      (fun () -> really_input_string ch (in_channel_length ch))
  with Sys_error msg -> failwith (\"readFile: \" ^ msg)
let dtp_writeFile path contents =
  try
    let ch = open_out_bin path in
    Fun.protect ~finally:(fun () -> close_out_noerr ch)
      (fun () -> output_string ch contents);
    String.length contents
  with Sys_error msg -> failwith (\"writeFile: \" ^ msg)
let dtp_writeFileAtomic path contents =
  let tmp = path ^ \".\" ^ string_of_int (Unix.getpid ()) ^ \".tmp\" in
  let write () =
    let ch = open_out_bin tmp in
    Fun.protect ~finally:(fun () -> close_out_noerr ch) (fun () -> output_string ch contents) in
  (try write (); Sys.rename tmp path; String.length contents
   with e -> (try Sys.remove tmp with _ -> ()); raise e)
let dtp_getArgs () =
  let argv = Sys.argv in
  let n = Array.length argv in
  if n <= 1 then [] else Array.to_list (Array.sub argv 1 (n - 1))
let dtp_readLine () = try input_line stdin with End_of_file -> \"\"
let dtp_readBytes n =
  if n <= 0 then \"\"
  else
    let b = Bytes.create n in
    let k = try input stdin b 0 n with _ -> 0 in
    if k <= 0 then \"\" else Bytes.sub_string b 0 k
let dtp_readDir path =
  try List.sort compare (Array.to_list (Sys.readdir path))
  with Sys_error msg -> failwith (\"readDir: \" ^ msg)
let dtp_isDirectory path =
  try Sys.is_directory path with Sys_error msg -> failwith (\"isDirectory: \" ^ msg)
let dtp_makeDir path =
  try (if Sys.file_exists path then 0 else (Sys.mkdir path 0o755; 0))
  with Sys_error msg -> failwith (\"makeDir: \" ^ msg)
let dtp_removeFile path =
  try (if Sys.file_exists path then (Sys.remove path; 0) else 0)
  with Sys_error msg -> failwith (\"removeFile: \" ^ msg)
let dtp_fileExists path = Sys.file_exists path
let dtp_fileMtime path =
  try int_of_float (Unix.stat path).Unix.st_mtime with _ -> 0
let dtp_fileSize path =
  try (Unix.stat path).Unix.st_size with _ -> 0
let dtp_timeUs () = int_of_float (Unix.gettimeofday () *. 1000000.0)
let dtp_sleep us =
  (if us > 0 then Unix.sleepf (float_of_int us /. 1000000.0));
  0
let dtp_getenv k = try Sys.getenv k with Not_found -> \"\"
let dtp_getcwd () = try Sys.getcwd () with _ -> \".\"
let dtp_execPath () = try Unix.readlink \"/proc/self/exe\" with _ -> Sys.executable_name
let dtp_arraySet (a : 'a array) (i : int) (v : 'a) =
  let b = Array.copy a in
  Array.set b i v; b
let dtp_strHash (s : string) =
  let h = ref 0 in
  String.iter (fun c -> h := ((!h * 33) + Char.code c) land 1023) s;
  !h
let dtp_strAt (s : string) (i : int) = if i < 0 || i >= String.length s then -1 else Char.code s.[i]
let dtp_substring start len s =
  let n = String.length s in
  let st = if start < 0 then 0 else if start > n then n else start in
  let ln = if len < 0 then 0 else if st + len > n then n - st else len in
  String.sub s st ln
let dtp_exit n = exit n
let dtp_runIn dir args =
  let quote s = Filename.quote s in
  let cmd = String.concat \" \" (List.map quote args) in
  let old = Sys.getcwd () in
  Fun.protect ~finally:(fun () -> Sys.chdir old) (fun () -> Sys.chdir dir; Sys.command cmd)
let dtp_spawn (args : string list) : int =
  let prog = Sys.executable_name in
  Unix.create_process prog (Array.of_list (prog :: args)) Unix.stdin Unix.stdout Unix.stderr
let dtp_wait (pid : int) : int =
  let (_, st) = Unix.waitpid [] pid in
  match st with Unix.WEXITED c -> c | _ -> 1
let dtp_net_tbl : (int, Unix.file_descr) Hashtbl.t = Hashtbl.create 16
let dtp_net_next = ref 1
let dtp_net_put (fd : Unix.file_descr) : int =
  let k = !dtp_net_next in
  dtp_net_next := k + 1;
  Hashtbl.replace dtp_net_tbl k fd;
  k
let dtp_net_get (h : int) : Unix.file_descr =
  match Hashtbl.find_opt dtp_net_tbl h with
  | Some fd -> fd
  | None -> failwith \"net: invalid handle\"
let dtp_net_drop (h : int) = (try Hashtbl.remove dtp_net_tbl h with _ -> ())
let dtp_net_error (what : string) (e : exn) : 'a =
  match e with
  | Unix.Unix_error (ue, fn, arg) ->
    failwith (\"net: \" ^ what ^ \": \" ^ Unix.error_message ue ^ (if arg = \"\" then \"\" else \" (\" ^ arg ^ \")\"))
  | _ -> failwith (\"net: \" ^ what ^ \": \" ^ Printexc.to_string e)
let dtp_net_parse (addr : string) =
  let n = String.length addr in
  if n > 5 && String.sub addr 0 5 = \"unix:\" then `Unix (String.sub addr 5 (n - 5))
  else if n > 4 && String.sub addr 0 4 = \"tcp:\" then
    let rest = String.sub addr 4 (n - 4) in
    (match (try Some (String.rindex rest ':') with Not_found -> None) with
     | None -> failwith (\"net: invalid address (want tcp:HOST:PORT or unix:PATH): \" ^ addr)
     | Some i ->
       let host = String.sub rest 0 i in
       let portstr = String.sub rest (i + 1) (String.length rest - i - 1) in
       let port = try int_of_string portstr with _ -> failwith (\"net: invalid port: \" ^ portstr) in
       `Tcp (host, port))
  else failwith (\"net: invalid address (want tcp:HOST:PORT or unix:PATH): \" ^ addr)
let dtp_net_listen (addr : string) : int =
  match dtp_net_parse addr with
  | `Unix path ->
    (try if Sys.file_exists path then Sys.remove path with _ -> ());
    let s = Unix.socket Unix.PF_UNIX Unix.SOCK_STREAM 0 in
    (try Unix.bind s (Unix.ADDR_UNIX path); Unix.listen s 8; dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"listen\" e)
  | `Tcp (host, port) ->
    let s = Unix.socket Unix.PF_INET Unix.SOCK_STREAM 0 in
    (try
       Unix.setsockopt s Unix.SO_REUSEADDR true;
       Unix.bind s (Unix.ADDR_INET (Unix.inet_addr_of_string host, port));
       Unix.listen s 8;
       dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"listen\" e)
let dtp_net_port (h : int) : int =
  match Unix.getsockname (dtp_net_get h) with
  | Unix.ADDR_INET (_, p) -> p
  | Unix.ADDR_UNIX _ -> 0
let dtp_net_accept (h : int) : int =
  (try let (fd, _) = Unix.accept (dtp_net_get h) in dtp_net_put fd
   with e -> dtp_net_error \"accept\" e)
let dtp_net_recv (h : int) (n : int) : string =
  if n <= 0 then \"\"
  else
    let b = Bytes.create n in
    (try
       let k = Unix.read (dtp_net_get h) b 0 n in
       if k <= 0 then \"\" else Bytes.sub_string b 0 k
     with e -> dtp_net_error \"recv\" e)
let dtp_net_send (h : int) (s : string) : int =
  let fd = dtp_net_get h in
  let n = String.length s in
  let rec go off =
    if off >= n then ()
    else
      let k = (try Unix.write_substring fd s off (n - off) with e -> dtp_net_error \"send\" e) in
      if k <= 0 then failwith \"net: send: connection closed\" else go (off + k)
  in
  go 0; n
let dtp_net_close (h : int) : int =
  (try Unix.close (dtp_net_get h) with _ -> ());
  dtp_net_drop h; 0
let dtp_net_connect (addr : string) : int =
  match dtp_net_parse addr with
  | `Unix path ->
    let s = Unix.socket Unix.PF_UNIX Unix.SOCK_STREAM 0 in
    (try Unix.connect s (Unix.ADDR_UNIX path); dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"connect\" e)
  | `Tcp (host, port) ->
    let s = Unix.socket Unix.PF_INET Unix.SOCK_STREAM 0 in
    (try Unix.connect s (Unix.ADDR_INET (Unix.inet_addr_of_string host, port)); dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"connect\" e)
"""
) ++ dtSchedRuntime

-- W9：单线程协作式 fiber 调度器（Layer 3）运行时。
-- 纤程 = OCaml 5 一次性续延；调度器在纤程外的循环里决定下一步跑谁，
-- 挂起经私有运行时效应（SchedYield/SchedAwait/SchedWaitScope*）。任务体是
-- `Eff Nil a`；Base.EffSched 经隐藏 intrinsic 调用 dtp_sched_* 原语。
dtSchedRuntime : String
dtSchedRuntime = """(* ------------------------------------------------------------------ *)
(* W9: single-threaded cooperative fiber scheduler (Layer 3).          *)
(*                                                                     *)
(* Fibers are one-shot OCaml 5 continuations captured by the root      *)
(* Effect.Deep handler installed for every fiber. The scheduler loop   *)
(* outside the fibers decides what runs next; suspension is requested  *)
(* through private runtime effects (SchedYield/SchedAwait/WaitScope).  *)
(* Tasks are `Eff Nil a` thunks: their user effects are handled       *)
(* inside the fiber, and only the scheduler primitives cross fibers.   *)
(* ------------------------------------------------------------------ *)

type _ Effect.t +=
  | SchedYield : int Effect.t
  | SchedAwait : int -> int Effect.t
  | SchedWaitScope : int -> int Effect.t
  | SchedWaitScopeTimeout : int * int -> int Effect.t

type dtp_sched_step =
  | SchedStepYield of Obj.t
  | SchedStepAwait of int * Obj.t
  | SchedStepScope of int * Obj.t
  | SchedStepScopeTimeout of int * int * Obj.t
  | SchedStepDone of Obj.t
  | SchedStepFailed of exn * Printexc.raw_backtrace

type dtp_sched_wait = SchedWaitNone | SchedWaitTask of int | SchedWaitScope of int | SchedWaitTimed

type dtp_sched_state =
  | SchedQueued of Obj.t
  | SchedRunning
  | SchedSuspended
  | SchedDone of Obj.t
  | SchedFailed of exn * Printexc.raw_backtrace
  | SchedCancelled

type dtp_sched_task = {
  sched_tid : int;
  mutable sched_state : dtp_sched_state;
  mutable sched_start : (unit -> Obj.t) option;
  mutable sched_cont : Obj.t option;
  sched_scope : int;
  mutable sched_wait : dtp_sched_wait;
  mutable sched_waiters : int list;
  mutable sched_cancel : bool;
  mutable sched_grace : int;
}

type dtp_sched_scope = {
  sched_sid : int;
  mutable sched_tasks : int list;
  mutable sched_failed : string option;
  mutable sched_waiters : int list;
  mutable sched_timeout : bool;
  mutable sched_completed : int;
}

let dtp_sched_tasks : (int, dtp_sched_task) Hashtbl.t = Hashtbl.create 64
let dtp_sched_scopes : (int, dtp_sched_scope) Hashtbl.t = Hashtbl.create 16
let dtp_sched_ready : int Queue.t = Queue.create ()
let dtp_sched_next_task = ref 0
let dtp_sched_next_scope = ref 0
let dtp_sched_timeouts : (int * int * int) list ref = ref []
let dtp_sched_main_tid = ref 0
let dtp_sched_current = ref (-1)
let dtp_sched_main_result : Obj.t option ref = ref None
let dtp_sched_main_exn : (exn * Printexc.raw_backtrace) option ref = ref None
let dtp_sched_grace_steps = 64

let dtp_sched_reset () =
  Hashtbl.reset dtp_sched_tasks;
  Hashtbl.reset dtp_sched_scopes;
  dtp_cleanup_reset ();
  Queue.clear dtp_sched_ready;
  dtp_sched_next_task := 0;
  dtp_sched_next_scope := 0;
  dtp_sched_timeouts := [];
  dtp_sched_main_tid := 0;
  dtp_sched_current := -1;
  dtp_sched_main_result := None;
  dtp_sched_main_exn := None

let dtp_sched_task id =
  match Hashtbl.find_opt dtp_sched_tasks id with
  | Some t -> t
  | None -> failwith \"scheduler: invalid task handle\"

let dtp_sched_scope id =
  match Hashtbl.find_opt dtp_sched_scopes id with
  | Some s -> s
  | None -> failwith \"scheduler: invalid scope handle\"

let dtp_sched_exn_msg e =
  match e with
  | Effect.Unhandled (Perform (key, name, _)) ->
    Printf.sprintf \"unhandled effect %s (instance %s)\" key name
  | Failure m -> m
  | _ -> Printexc.to_string e

let dtp_sched_task_status t =
  if t.sched_cancel then 1
  else match t.sched_state with
    | SchedDone _ -> 0
    | SchedFailed _ -> 2
    | SchedCancelled -> 1
    | _ -> 0

let dtp_sched_enqueue t v =
  t.sched_state <- SchedQueued v;
  Queue.push t.sched_tid dtp_sched_ready

let dtp_sched_wake_scope s =
  if s.sched_tasks = [] && s.sched_waiters <> [] then begin
    let status =
      if s.sched_timeout then 2
      else if s.sched_failed <> None then 1
      else 0
    in
    let ws = s.sched_waiters in
    s.sched_waiters <- [];
    dtp_sched_timeouts := List.filter (fun (w, _, _) -> not (List.mem w ws)) !dtp_sched_timeouts;
    List.iter (fun wid ->
      let w = dtp_sched_task wid in
      w.sched_wait <- SchedWaitNone;
      dtp_sched_enqueue w (Obj.repr status)) ws
  end

let dtp_sched_finish t st =
  t.sched_state <- st;
  t.sched_wait <- SchedWaitNone;
  let ws = t.sched_waiters in
  t.sched_waiters <- [];
  let status = dtp_sched_task_status t in
  List.iter (fun wid ->
    let w = dtp_sched_task wid in
    w.sched_wait <- SchedWaitNone;
    dtp_sched_enqueue w (Obj.repr status)) ws;
  if t.sched_tid = !dtp_sched_main_tid then begin
    match st with
    | SchedDone v -> dtp_sched_main_result := Some v
    | SchedFailed (e, bt) -> dtp_sched_main_exn := Some (e, bt)
    | _ -> ()
  end;
  match Hashtbl.find_opt dtp_sched_scopes t.sched_scope with
  | Some s ->
    s.sched_tasks <- List.filter (fun x -> x <> t.sched_tid) s.sched_tasks;
    s.sched_completed <- s.sched_completed + 1;
    dtp_sched_wake_scope s
  | None -> ()

let dtp_sched_remove_waiter t =
  match t.sched_wait with
  | SchedWaitTask id ->
    let tg = dtp_sched_task id in
    tg.sched_waiters <- List.filter (fun x -> x <> t.sched_tid) tg.sched_waiters
  | SchedWaitScope id ->
    let s = dtp_sched_scope id in
    s.sched_waiters <- List.filter (fun x -> x <> t.sched_tid) s.sched_waiters
  | SchedWaitTimed | SchedWaitNone -> ()

let dtp_sched_cancel_task t =
  let terminal = match t.sched_state with
    | SchedDone _ | SchedFailed _ | SchedCancelled -> true
    | _ -> false
  in
  if t.sched_cancel || terminal then ()
  else begin
    t.sched_cancel <- true;
    match t.sched_state with
    | SchedQueued _ -> if t.sched_start <> None then dtp_sched_finish t SchedCancelled
      else t.sched_state <- SchedQueued (Obj.repr 1)
    | SchedSuspended ->
      let code = match t.sched_wait with
        | SchedWaitTask _ -> 1
        | SchedWaitScope _ | SchedWaitTimed -> 3
        | SchedWaitNone -> 1
      in
      dtp_sched_remove_waiter t;
      dtp_sched_timeouts := List.filter (fun (w, _, _) -> w <> t.sched_tid) !dtp_sched_timeouts;
      dtp_sched_enqueue t (Obj.repr code)
    | _ -> ()
  end

let dtp_sched_cancel_scope_tasks sid =
  let s = dtp_sched_scope sid in
  List.iter (fun id -> dtp_sched_cancel_task (dtp_sched_task id)) s.sched_tasks

let dtp_sched_effc (type a) (eff : a Effect.t)
  : ((a, Obj.t) Effect.Deep.continuation -> Obj.t) option =
  match eff with
  | SchedYield -> Some (fun k -> Obj.repr (SchedStepYield (Obj.repr k)))
  | SchedAwait id -> Some (fun k -> Obj.repr (SchedStepAwait (id, Obj.repr k)))
  | SchedWaitScope id -> Some (fun k -> Obj.repr (SchedStepScope (id, Obj.repr k)))
  | SchedWaitScopeTimeout (n, id) ->
    Some (fun k -> Obj.repr (SchedStepScopeTimeout (n, id, Obj.repr k)))
  | _ -> None

let dtp_sched_run_fresh t =
  let start = match t.sched_start with
    | Some f -> f
    | None -> failwith \"scheduler: no start thunk\" in
  t.sched_start <- None;
  let r = Effect.Deep.match_with
      (fun () -> start ())
      ()
      { retc = (fun x -> Obj.repr (SchedStepDone x));
        exnc = (fun e -> Obj.repr (SchedStepFailed (e, Printexc.get_raw_backtrace ())));
        effc = dtp_sched_effc } in
  (Obj.obj r : dtp_sched_step)

let dtp_sched_run_resume t v =
  let k = match t.sched_cont with
    | Some rep -> (Obj.magic rep : (Obj.t, Obj.t) Effect.Deep.continuation)
    | None -> failwith \"scheduler: no continuation\" in
  let r = Effect.Deep.continue k v in
  (Obj.obj r : dtp_sched_step)

let dtp_sched_new_task scope start =
  let id = !dtp_sched_next_task in
  dtp_sched_next_task := id + 1;
  let t = {
    sched_tid = id;
    sched_state = SchedQueued (Obj.repr 0);
    sched_start = Some start;
    sched_cont = None;
    sched_scope = scope;
    sched_wait = SchedWaitNone;
    sched_waiters = [];
    sched_cancel = false;
    sched_grace = dtp_sched_grace_steps;
  } in
  Hashtbl.replace dtp_sched_tasks id t;
  (match Hashtbl.find_opt dtp_sched_scopes scope with
   | Some s -> s.sched_tasks <- id :: s.sched_tasks
   | None -> ());
  Queue.push id dtp_sched_ready;
  t

let dtp_sched_new_scope () =
  let id = !dtp_sched_next_scope in
  dtp_sched_next_scope := id + 1;
  Hashtbl.replace dtp_sched_scopes id {
    sched_sid = id;
    sched_tasks = [];
    sched_failed = None;
    sched_waiters = [];
    sched_timeout = false;
    sched_completed = 0;
  };
  id

let dtp_sched_step t =
  if t.sched_cancel then t.sched_grace <- t.sched_grace - 1;
  if t.sched_cancel && t.sched_grace <= 0 then begin
    (* 硬中止：续延被丢弃，bracket 的库层 finally 不会跑；尽力执行未弹出的
       cleanup（它们只能做无效应/自包含的清理：挂起点之外没有 handler 栈）。 *)
    dtp_cleanup_run_all_for t.sched_tid;
    dtp_cleanup_forget t.sched_tid;
    dtp_sched_finish t SchedCancelled;
    None
  end
  else Some (match t.sched_start with
    | Some _ -> dtp_sched_run_fresh t
    | None -> match t.sched_state with
      | SchedQueued v -> t.sched_state <- SchedRunning; dtp_sched_run_resume t v
      | _ -> failwith \"scheduler: bad task state\")

let dtp_sched_apply t (st : dtp_sched_step) =
  match st with
  | SchedStepYield krep ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitNone;
    dtp_sched_enqueue t (Obj.repr (if t.sched_cancel then 1 else 0))
  | SchedStepAwait (id, krep) ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitTask id;
    t.sched_state <- SchedSuspended;
    let tg = dtp_sched_task id in
    tg.sched_waiters <- t.sched_tid :: tg.sched_waiters
  | SchedStepScope (id, krep) ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitScope id;
    t.sched_state <- SchedSuspended;
    let s = dtp_sched_scope id in
    s.sched_waiters <- t.sched_tid :: s.sched_waiters
  | SchedStepScopeTimeout (n, id, krep) ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitTimed;
    t.sched_state <- SchedSuspended;
    let s = dtp_sched_scope id in
    s.sched_waiters <- t.sched_tid :: s.sched_waiters;
    (* n 是「开始等待之后」的调度步预算：武装这次等待的那一步不算。 *)
    dtp_sched_timeouts := (t.sched_tid, id, n + 1) :: !dtp_sched_timeouts
  | SchedStepDone v ->
    (* 正常结束：bracket 已自行弹出；残留（异常边角）也一并清掉。 *)
    dtp_cleanup_run_all_for t.sched_tid;
    dtp_cleanup_forget t.sched_tid;
    dtp_sched_finish t (if t.sched_cancel then SchedCancelled else SchedDone v)
  | SchedStepFailed (e, bt) ->
    (* 异常穿过纤程根 handler：被丢弃的续延里的 bracket cleanup 在这里兜底。 *)
    dtp_cleanup_run_all_for t.sched_tid;
    dtp_cleanup_forget t.sched_tid;
    if t.sched_tid = !dtp_sched_main_tid then dtp_sched_finish t (SchedFailed (e, bt))
    else begin
      let s = dtp_sched_scope t.sched_scope in
      if s.sched_failed = None then s.sched_failed <- Some (dtp_sched_exn_msg e);
      dtp_sched_finish t (SchedFailed (e, bt));
      dtp_sched_cancel_scope_tasks t.sched_scope
    end

let dtp_sched_tick () =
  let expired = ref [] in
  dtp_sched_timeouts := List.map (fun (w, sc, n) -> (w, sc, n - 1)) !dtp_sched_timeouts;
  dtp_sched_timeouts := List.filter (fun (w, sc, n) ->
    if n > 0 then true else (expired := (w, sc) :: !expired; false)) !dtp_sched_timeouts;
  List.iter (fun (_, sc) ->
    let s = dtp_sched_scope sc in
    if not s.sched_timeout then begin
      s.sched_timeout <- true;
      dtp_sched_cancel_scope_tasks sc
    end) !expired

let dtp_sched_runnable t =
  match t.sched_state with SchedQueued _ -> true | _ -> false

let dtp_sched_run_one t =
  if dtp_sched_runnable t then begin
    dtp_sched_current := t.sched_tid;
    dtp_cleanup_fiber := t.sched_tid;
    (match dtp_sched_step t with
     | Some st -> dtp_sched_apply t st
     | None -> ());
    dtp_cleanup_fiber := -1;
    dtp_sched_current := -1
  end

let dtp_sched_deadlock () = failwith \"scheduler: deadlock (no runnable task)\"

let dtp_sched_loop () =
  let rec loop () =
    if !dtp_sched_main_result <> None || !dtp_sched_main_exn <> None then ()
    else if Queue.is_empty dtp_sched_ready then dtp_sched_deadlock ()
    else begin
      let tid = Queue.pop dtp_sched_ready in
      dtp_sched_run_one (dtp_sched_task tid);
      dtp_sched_tick ();
      loop ()
    end
  in loop ()

let dtp_sched_drain () =
  let rec loop () =
    if Queue.is_empty dtp_sched_ready then ()
    else begin
      let tid = Queue.pop dtp_sched_ready in
      dtp_sched_run_one (dtp_sched_task tid);
      loop ()
    end
  in loop ()

let dtp_sched_cancel_leftovers () =
  Hashtbl.iter (fun _ t -> match t.sched_state with
    | SchedDone _ | SchedFailed _ | SchedCancelled -> ()
    | _ -> dtp_sched_cancel_task t) dtp_sched_tasks

let dtp_sched_main (th : unit -> 'a) : 'a =
  dtp_sched_reset ();
  ignore (dtp_sched_new_scope ());
  let main = dtp_sched_new_task 0 (fun () -> Obj.repr (th ())) in
  dtp_sched_main_tid := main.sched_tid;
  (try dtp_sched_loop ()
   with e -> dtp_sched_cancel_leftovers (); dtp_sched_drain (); raise e);
  dtp_sched_cancel_leftovers ();
  dtp_sched_drain ();
  match !dtp_sched_main_exn with
  | Some (e, bt) -> Printexc.raise_with_backtrace e bt
  | None -> match !dtp_sched_main_result with
    | Some v -> (Obj.obj v : 'a)
    | None -> failwith \"scheduler: main did not finish\"

(* scheduler primitives exposed to Base.EffSched through hidden intrinsics *)

let dtp_sched_fork (scope : int) (f : int -> 'a) : int =
  (dtp_sched_new_task scope (fun () -> Obj.repr (f 0))).sched_tid

let dtp_sched_current_task () =
  if !dtp_sched_current < 0 then failwith \"scheduler: no current fiber\"
  else dtp_sched_task !dtp_sched_current

let dtp_sched_yield () : int = Effect.perform SchedYield

let dtp_sched_is_cancelled () : int =
  match Hashtbl.find_opt dtp_sched_tasks !dtp_sched_current with
  | Some t -> if t.sched_cancel then 1 else 0
  | None -> 0

let dtp_sched_await (id : int) : int =
  let self = dtp_sched_current_task () in
  if self.sched_cancel then begin ignore (Effect.perform SchedYield); 1 end
  else begin
    let target = dtp_sched_task id in
    match target.sched_state with
    | SchedDone _ | SchedFailed _ | SchedCancelled -> dtp_sched_task_status target
    | _ -> Effect.perform (SchedAwait id)
  end

let dtp_sched_task_result (id : int) : 'a =
  match (dtp_sched_task id).sched_state with
  | SchedDone v -> Obj.obj v
  | _ -> failwith \"scheduler: task has no result\"

let dtp_sched_task_error (id : int) : string =
  match (dtp_sched_task id).sched_state with
  | SchedFailed (e, _) -> dtp_sched_exn_msg e
  | _ -> \"\"

let dtp_sched_cancel_task_prim (id : int) : int =
  dtp_sched_cancel_task (dtp_sched_task id);
  0

let dtp_sched_cancel_scope (id : int) : int =
  dtp_sched_cancel_scope_tasks id;
  0

let dtp_sched_scope_status (s : dtp_sched_scope) : int =
  if s.sched_timeout then 2
  else if s.sched_failed <> None then 1
  else 0

let dtp_sched_scope_wait (id : int) : int =
  let s = dtp_sched_scope id in
  let self = dtp_sched_current_task () in
  if self.sched_cancel then begin ignore (Effect.perform SchedYield); 3 end
  else if s.sched_tasks = [] then dtp_sched_scope_status s
  else Effect.perform (SchedWaitScope id)

let dtp_sched_scope_wait_timeout (steps : int) (id : int) : int =
  let s = dtp_sched_scope id in
  let self = dtp_sched_current_task () in
  if self.sched_cancel then begin ignore (Effect.perform SchedYield); 3 end
  else if s.sched_tasks = [] then dtp_sched_scope_status s
  else if steps <= 0 then begin
    s.sched_timeout <- true;
    dtp_sched_cancel_scope_tasks id;
    Effect.perform (SchedWaitScope id)
  end else
    Effect.perform (SchedWaitScopeTimeout (steps, id))

let dtp_sched_scope_error (id : int) : string =
  let s = dtp_sched_scope id in
  match s.sched_failed with
  | Some msg -> msg
  | None -> \"\"

let dtp_sched_scope_count (id : int) : int =
  (dtp_sched_scope id).sched_completed
"""

-- M38：运行时错误报告器。位置表的键是 OCaml 值名（如 `v_main`）；回栈帧名形如
-- `Main.v_main`（跨单元调用）或 `Main.v_main.(fun)`（lambda 内联后）。报告器取帧名
-- 最后一个**非 `(fun)`** 的 '.' 分量查表，渲染成 `main (app/Main.vuna:12)`。
-- 命中帧最多打印 12 条，未命中帧（如 `Stdlib.failwith`）跳过。
dtReporterRuntime : String
dtReporterRuntime = """let rec dt_frame_key parts =
  match parts with
  | [] -> None
  | part :: rest -> if part = \"(fun)\" then dt_frame_key rest else Some part
let dt_frame_label slot =
  match Printexc.Slot.name slot with
  | None -> None
  | Some nm ->
    match dt_frame_key (List.rev (String.split_on_char '.' nm)) with
    | None -> None
    | Some key ->
      (match List.assoc_opt key dt_def_locs with
       | Some (display, loc) -> Some (display ^ \" (\" ^ loc ^ \")\")
       | None -> None)
let dt_report_exn e bt =
  let msg = match e with Effect.Unhandled (Perform (key, name, _)) -> Printf.sprintf \"unhandled effect %s (instance %s)\" key name | Failure m -> m | _ -> Printexc.to_string e in
  Printf.eprintf \"vuna: runtime error: %s\\n%!\" msg;
  match Printexc.backtrace_slots bt with
  | None -> ()
  | Some slots ->
    let rec go rest shown =
      if shown >= 12 then ()
      else match rest with
      | [] -> ()
      | slot :: tl ->
        (match dt_frame_label slot with
         | Some s -> Printf.eprintf \"  at %s\\n%!\" s; go tl (shown + 1)
         | None -> go tl shown)
    in go (Array.to_list slots) 0
"""

-- | 浮点 runtime helper（仅在程序使用 Float 时追加；见 `dtRuntimeWith`）。单独的文本块
-- 保证 no-float 程序的 `Vuna_runtime.ml` 与加 Float 之前逐字节一致（bootstrap/缓存）。
dtFloatRuntime : String
dtFloatRuntime = """let bi_add_float (a : float) (b : float) = a +. b
let bi_sub_float (a : float) (b : float) = a -. b
let bi_mul_float (a : float) (b : float) = a *. b
let bi_div_float (a : float) (b : float) = a /. b
let bi_eq_float (a : float) (b : float) = a = b
let bi_neq_float (a : float) (b : float) = a <> b
let bi_lt_float (a : float) (b : float) = a < b
let bi_le_float (a : float) (b : float) = a <= b
let bi_gt_float (a : float) (b : float) = a > b
let bi_ge_float (a : float) (b : float) = a >= b
"""

-- | 编译器 tracing runtime（仅在程序引用 `dbg!` 展开出的隐藏原语时追加；见
-- `dtRuntimeWith` 的 `usesTrace`）。开关是 lazy CAF：第一次探针才读 argv/env，
-- 关闭时每个探针只剩一次 `Lazy.force`；输出走 stderr，行格式
-- `DEBUG <epoch-us> <text>`（逐行 flush）。
dtTraceRuntime : String
dtTraceRuntime = """let dtp_debug_on_lazy = lazy (
  let has f = Array.exists (fun a -> a = f) Sys.argv in
  has \"--debug-perf\" || (try Sys.getenv \"VUNA_DEBUG_PERF\" = \"1\" with Not_found -> false))
let dtp_debug_on (_ : int) = Lazy.force dtp_debug_on_lazy
let dtp_debug_line (s : string) =
  Printf.eprintf \"DEBUG %d %s
%!\" (dtp_timeUs ()) s;
  0
"""

-- | 可观测性运行时（仅在程序引用 `@vuna@obs@*` 隐藏原语时追加；见 `dtRuntimeWith`
-- 的 `usesObs`）。规范见 `docs/reference/observability.md`。
--
-- 默认关闭：`dtp_obs_level_lazy` 是 lazy CAF，关闭时每个探针只剩一次 `Lazy.force` +
-- 一个布尔分支（无时钟读、无分配、不碰文件）。打开后事件写 Chrome Trace Event JSONL
-- （`ph:"M"` 元数据 + `ph:"X"` 跨度 + `ph:"C"` 计数 + `ph:"i"` 日志/采样），sink 是
-- `VUNA_OBS_FILE` 或 `${VUNA_OBS_DIR:-${TMPDIR:-/tmp}/vuna-obs}/vuna-<pid>.jsonl`。
--
-- 文本里**没有反斜杠**（JSON 的 `"` 全部经 `dtp_obs_qc = Char.chr 34` 拼出）：本文件是
-- vuna 源码，多行字符串里每个 `\` 都要再转义一层，省掉它们才能让模板可读可 diff。
-- 采样：CPU 用 `ITIMER_PROF` + `SIGPROF` + `Printexc.get_callstack`（handler 里只抓栈，
-- 不做 I/O/格式化）；内存用 `Gc.Memprof` 分配回调。两处都在停止时批量序列化。
dtObsRuntime : String
dtObsRuntime = """(* ------------------------------------------------------------------ *)
(* vuna observability runtime (generated; see docs/reference/          *)
(* observability.md). Off by default: a probe pays one Lazy.force.     *)
(* Events are Chrome Trace Event JSONL, one object per line.           *)
(*                                                                     *)
(* This text is embedded verbatim in Codegen.Term.dtObsRuntime. It      *)
(* therefore contains NO backslash characters and NO line comments:    *)
(* every quote is built from Char.chr 34 so the surrounding vuna string *)
(* literal stays straightforward to escape.                            *)
(* ------------------------------------------------------------------ *)
let dtp_obs_qc = Char.chr 34
let dtp_obs_bs = Char.chr 92
let dtp_obs_nl = Char.chr 10
let dtp_obs_colon = Char.chr 58
let dtp_obs_comma = Char.chr 44
let dtp_obs_lb = Char.chr 123
let dtp_obs_rb = Char.chr 125
let dtp_obs_ls = Char.chr 91
let dtp_obs_rs = Char.chr 93

let dtp_obs_level_lazy = lazy (
  let env =
    match int_of_string_opt (try Sys.getenv \"VUNA_OBS\" with Not_found -> \"\") with
    | Some n -> n
    | None -> 0
  in
  let rec scan i acc =
    let n = Array.length Sys.argv in
    if i >= n then acc
    else if Sys.argv.(i) = \"--obs\" then scan (i + 1) (if acc > 2 then acc else 2)
    else if Sys.argv.(i) = \"--obs-level\" && i + 1 < n then
      (match int_of_string_opt Sys.argv.(i + 1) with
       | Some v -> scan (i + 2) v
       | None -> scan (i + 2) acc)
    else if String.length Sys.argv.(i) > 11 && String.sub Sys.argv.(i) 0 11 = \"--obs-level\" then
      (match int_of_string_opt (String.sub Sys.argv.(i) 12 (String.length Sys.argv.(i) - 12)) with
       | Some v -> scan (i + 1) v
       | None -> scan (i + 1) acc)
    else scan (i + 1) acc
  in
  let l = scan 1 env in
  if l < 0 then 0 else if l > 3 then 3 else l)

let dtp_obs_level (_ : int) = Lazy.force dtp_obs_level_lazy
let dtp_obs_on () = Lazy.force dtp_obs_level_lazy > 0
let dtp_obs_tid () = let t = !dtp_sched_current in if t < 0 then 0 else t

let dtp_obs_esc b (s : string) =
  String.iter
    (fun c ->
      if Char.code c = 34 then begin Buffer.add_char b dtp_obs_bs; Buffer.add_char b dtp_obs_qc end
      else if Char.code c = 92 then begin Buffer.add_char b dtp_obs_bs; Buffer.add_char b dtp_obs_bs end
      else if Char.code c = 10 then begin Buffer.add_char b dtp_obs_bs; Buffer.add_char b (Char.chr 110) end
      else if Char.code c = 13 then begin Buffer.add_char b dtp_obs_bs; Buffer.add_char b (Char.chr 114) end
      else if Char.code c = 9 then begin Buffer.add_char b dtp_obs_bs; Buffer.add_char b (Char.chr 116) end
      else if Char.code c < 32 then begin
        Buffer.add_char b dtp_obs_bs;
        Buffer.add_char b (Char.chr 117);
        Buffer.add_string b (Printf.sprintf \"%04x\" (Char.code c))
      end
      else Buffer.add_char b c)
    s

let dtp_obs_key b (k : string) =
  Buffer.add_char b dtp_obs_qc;
  dtp_obs_esc b k;
  Buffer.add_char b dtp_obs_qc;
  Buffer.add_char b dtp_obs_colon

let dtp_obs_str b (s : string) =
  Buffer.add_char b dtp_obs_qc;
  dtp_obs_esc b s;
  Buffer.add_char b dtp_obs_qc

let dtp_obs_int b (n : int) = Buffer.add_string b (string_of_int n)


let dtp_obs_sink_path () =
  match Sys.getenv_opt \"VUNA_OBS_FILE\" with
  | Some p when p <> \"\" -> p
  | _ ->
    let d =
      match Sys.getenv_opt \"VUNA_OBS_DIR\" with
      | Some d when d <> \"\" -> d
      | _ -> Filename.concat (Filename.get_temp_dir_name ()) \"vuna-obs\"
    in
    Filename.concat d (\"vuna-\" ^ string_of_int (Unix.getpid ()) ^ \".jsonl\")

let dtp_obs_chan : out_channel option ref = ref None
let dtp_obs_started = ref false
let dtp_obs_warned = ref false
let dtp_obs_count = ref 0
let dtp_obs_buf = Buffer.create 8192

let dtp_obs_open () =
  match !dtp_obs_chan with
  | Some c -> Some c
  | None ->
    let path = dtp_obs_sink_path () in
    let dir = Filename.dirname path in
    (try if not (Sys.file_exists dir) then Unix.mkdir dir 0o755 with _ -> ());
    (match (try Some (open_out_bin path) with _ -> None) with
     | None ->
       if not !dtp_obs_warned then begin
         dtp_obs_warned := true;
         Printf.eprintf \"vuna: obs: cannot write %s, events dropped\" path;
         output_char stderr dtp_obs_nl;
         flush stderr
       end;
       None
     | Some c ->
       dtp_obs_chan := Some c;
       Some c)

let dtp_obs_flush () =
  (match !dtp_obs_chan with
   | None -> ()
   | Some c ->
     if Buffer.length dtp_obs_buf > 0 then Buffer.output_buffer c dtp_obs_buf;
     Buffer.clear dtp_obs_buf;
     (try flush c with _ -> ()));
  dtp_obs_count := 0;
  0

let dtp_obs_hdr b (ph : string) (name : string) (ts : int) =
  Buffer.add_char b dtp_obs_lb;
  dtp_obs_key b \"ph\";
  dtp_obs_str b ph;
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"ts\";
  dtp_obs_int b ts;
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"pid\";
  dtp_obs_int b (Unix.getpid ());
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"tid\";
  dtp_obs_int b (dtp_obs_tid ());
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"name\";
  dtp_obs_str b name

let dtp_obs_meta () =
  let b = Buffer.create 256 in
  Buffer.add_char b dtp_obs_lb;
  dtp_obs_key b \"ph\";
  dtp_obs_str b \"M\";
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"name\";
  dtp_obs_str b \"vuna.obs.schema\";
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"pid\";
  dtp_obs_int b (Unix.getpid ());
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"tid\";
  dtp_obs_int b 0;
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"args\";
  Buffer.add_char b dtp_obs_lb;
  dtp_obs_key b \"schema\";
  dtp_obs_str b \"vuna-obs 1\";
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"level\";
  dtp_obs_int b (dtp_obs_level 0);
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"exec\";
  dtp_obs_str b (try Sys.executable_name with _ -> \"\");
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"argv\";
  Buffer.add_char b dtp_obs_ls;
  Array.iteri
    (fun i a ->
      if i > 0 then Buffer.add_char b dtp_obs_comma;
      dtp_obs_str b a)
    Sys.argv;
  Buffer.add_char b dtp_obs_rs;
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"t0\";
  dtp_obs_int b (dtp_timeUs ());
  Buffer.add_char b dtp_obs_rb;
  Buffer.add_char b dtp_obs_rb;
  Buffer.add_char b dtp_obs_nl;
  Buffer.contents b

let dtp_obs_emit (ev : string) =
  match dtp_obs_open () with
  | None -> 0
  | Some _ ->
    if not !dtp_obs_started then begin
      dtp_obs_started := true;
      Buffer.add_string dtp_obs_buf (dtp_obs_meta ())
    end;
    Buffer.add_string dtp_obs_buf ev;
    incr dtp_obs_count;
    if !dtp_obs_count >= 256 then dtp_obs_flush () else 0

let dtp_obs_shutdown () =
  ignore (dtp_obs_flush ());
  (match !dtp_obs_chan with
   | Some c -> dtp_obs_chan := None; (try close_out c with _ -> ())
   | None -> ())

let () = at_exit dtp_obs_shutdown

let dtp_obs_span (name : string) (cat : string) (f : int -> 'a) : 'a =
  if not (dtp_obs_on ()) then f 0
  else begin
    let t0 = dtp_timeUs () in
    let s0 = Gc.quick_stat () in
    let emit ok =
      let t1 = dtp_timeUs () in
      let s1 = Gc.quick_stat () in
      let b = Buffer.create 192 in
      dtp_obs_hdr b \"X\" name t0;
      Buffer.add_char b dtp_obs_comma;
      dtp_obs_key b \"cat\";
      dtp_obs_str b cat;
      Buffer.add_char b dtp_obs_comma;
      dtp_obs_key b \"dur\";
      dtp_obs_int b (if t1 - t0 < 0 then 0 else t1 - t0);
      Buffer.add_char b dtp_obs_comma;
      dtp_obs_key b \"args\";
      Buffer.add_char b dtp_obs_lb;
      dtp_obs_key b \"allocWords\";
      dtp_obs_int b
        (int_of_float
           (s1.Gc.minor_words -. s0.Gc.minor_words +. (s1.Gc.major_words -. s0.Gc.major_words)));
      Buffer.add_char b dtp_obs_comma;
      dtp_obs_key b \"heapWords\";
      dtp_obs_int b s1.Gc.top_heap_words;
      if not ok then begin
        Buffer.add_char b dtp_obs_comma;
        dtp_obs_key b \"error\";
        Buffer.add_string b \"true\"
      end;
      Buffer.add_char b dtp_obs_rb;
      Buffer.add_char b dtp_obs_rb;
      Buffer.add_char b dtp_obs_nl;
      ignore (dtp_obs_emit (Buffer.contents b))
    in
    let v = try f 0 with e -> emit false; raise e in
    emit true;
    v
  end

let dtp_obs_mark_like (ph : string) (name : string) (cat : string) (kv : (Buffer.t -> unit) option) =
  let b = Buffer.create 160 in
  dtp_obs_hdr b ph name (dtp_timeUs ());
  Buffer.add_char b dtp_obs_comma;
  dtp_obs_key b \"cat\";
  dtp_obs_str b cat;
  (match kv with
   | None -> ()
   | Some put ->
     Buffer.add_char b dtp_obs_comma;
     dtp_obs_key b \"args\";
     Buffer.add_char b dtp_obs_lb;
     put b;
     Buffer.add_char b dtp_obs_rb);
  Buffer.add_char b dtp_obs_rb;
  Buffer.add_char b dtp_obs_nl;
  ignore (dtp_obs_emit (Buffer.contents b));
  0

let dtp_obs_log (text : string) : int =
  if not (dtp_obs_on ()) then 0
  else begin
    Printf.eprintf \"DEBUG %d %s\" (dtp_timeUs ()) text;
    output_char stderr dtp_obs_nl;
    flush stderr;
    dtp_obs_mark_like \"i\" \"vuna.log\" \"vuna.log\"
      (Some (fun b -> dtp_obs_key b \"text\"; dtp_obs_str b text))
  end

let dtp_obs_counter (name : string) (v : int) : int =
  if not (dtp_obs_on ()) then 0
  else dtp_obs_mark_like \"C\" name \"vuna.counter\"
    (Some (fun b -> dtp_obs_key b \"value\"; dtp_obs_int b v))

let dtp_obs_mark (name : string) : int =
  if not (dtp_obs_on ()) then 0
  else dtp_obs_mark_like \"i\" name \"vuna.mark\" None

let dtp_obs_cap = 8192
let dtp_obs_cpu : Printexc.raw_backtrace option array = Array.make 8192 None
let dtp_obs_cpu_n = ref 0
let dtp_obs_cpu_on = ref false

let dtp_obs_cpu_tick (_ : int) =
  if !dtp_obs_cpu_on && !dtp_obs_cpu_n < dtp_obs_cap then begin
    dtp_obs_cpu.(!dtp_obs_cpu_n) <- Some (Printexc.get_callstack 32);
    incr dtp_obs_cpu_n
  end

let dtp_obs_frames b (bt : Printexc.raw_backtrace) =
  let slots = match Printexc.backtrace_slots bt with None -> [||] | Some s -> s in
  Buffer.add_char b dtp_obs_ls;
  let first = ref true in
  Array.iter
    (fun slot ->
      let nm = match Printexc.Slot.name slot with Some n -> n | None -> \"\" in
      let loc =
        match Printexc.Slot.location slot with
        | Some l -> Printf.sprintf \"%s:%d\" l.filename l.line_number
        | None -> \"\"
      in
      if !first then first := false else Buffer.add_char b dtp_obs_comma;
      dtp_obs_str b (if loc = \"\" then nm else nm ^ \"@\" ^ loc))
    slots;
  Buffer.add_char b dtp_obs_rs

let dtp_obs_mem : Printexc.raw_backtrace option array = Array.make 8192 None
let dtp_obs_mem_n = ref 0
let dtp_obs_mem_run : Gc.Memprof.t option ref = ref None

let dtp_obs_mem_add (bt : Printexc.raw_backtrace) =
  if !dtp_obs_mem_n < dtp_obs_cap then begin
    dtp_obs_mem.(!dtp_obs_mem_n) <- Some bt;
    incr dtp_obs_mem_n
  end

let dtp_obs_tracker : (unit, unit) Gc.Memprof.tracker =
  { alloc_minor =
      (fun (i : Gc.Memprof.allocation) -> dtp_obs_mem_add i.callstack; (None : unit option));
    alloc_major =
      (fun (i : Gc.Memprof.allocation) -> dtp_obs_mem_add i.callstack; (None : unit option));
    promote = (fun () -> None);
    dealloc_minor = (fun () -> ());
    dealloc_major = (fun () -> ()) }

let dtp_obs_emit_samples (name : string) (n : int) (get : int -> Printexc.raw_backtrace option) =
  for i = 0 to n - 1 do
    match get i with
    | None -> ()
    | Some bt ->
      let b = Buffer.create 256 in
      dtp_obs_hdr b \"i\" name (dtp_timeUs ());
      Buffer.add_char b dtp_obs_comma;
      dtp_obs_key b \"cat\";
      dtp_obs_str b \"vuna.sample\";
      Buffer.add_char b dtp_obs_comma;
      dtp_obs_key b \"args\";
      Buffer.add_char b dtp_obs_lb;
      dtp_obs_key b \"stack\";
      dtp_obs_frames b bt;
      Buffer.add_char b dtp_obs_rb;
      Buffer.add_char b dtp_obs_rb;
      Buffer.add_char b dtp_obs_nl;
      ignore (dtp_obs_emit (Buffer.contents b))
  done

let dtp_obs_sample_start (mode : string) (interval_us : int) : int =
  if not (dtp_obs_on ()) then 0
  else begin
    let want_cpu = mode = \"cpu\" || mode = \"both\" in
    let want_mem = mode = \"mem\" || mode = \"both\" in
    let iv = if interval_us <= 0 then 1000 else interval_us in
    (if want_cpu then
       try
         Sys.set_signal Sys.sigprof (Sys.Signal_handle dtp_obs_cpu_tick);
         dtp_obs_cpu_on := true;
         ignore
           (Unix.setitimer Unix.ITIMER_PROF
              { Unix.it_interval = float_of_int iv /. 1000000.0;
                it_value = float_of_int iv /. 1000000.0 })
       with _ -> ());
    (if want_mem then
       try
         dtp_obs_mem_run :=
           Some (Gc.Memprof.start ~sampling_rate:1e-4 ~callstack_size:16 dtp_obs_tracker)
       with _ -> ());
    0
  end

let dtp_obs_sample_stop (_ : int) : int =
  if not (dtp_obs_on ()) then 0
  else begin
    (try
       dtp_obs_cpu_on := false;
       ignore (Unix.setitimer Unix.ITIMER_PROF { Unix.it_interval = 0.0; it_value = 0.0 })
     with _ -> ());
    (try (match !dtp_obs_mem_run with Some _ -> Gc.Memprof.stop () | None -> ()) with _ -> ());
    dtp_obs_mem_run := None;
    dtp_obs_emit_samples \"vuna.sample.cpu\" !dtp_obs_cpu_n (fun i -> dtp_obs_cpu.(i));
    dtp_obs_emit_samples \"vuna.sample.mem\" !dtp_obs_mem_n (fun i -> dtp_obs_mem.(i));
    dtp_obs_flush ()
  end
"""

inlineText : String -> List String -> Maybe String
inlineText "+" ([a, b]) = Just "(${a} + ${b})"
inlineText "-" ([a, b]) = Just "(${a} - ${b})"
inlineText "*" ([a, b]) = Just "(${a} * ${b})"
inlineText "/" ([a, b]) = Just "(if ${b} = 0 then failwith \"division by zero\" else ${a} / ${b})"
inlineText "&&" ([a, b]) = Just "(${a} && ${b})"
inlineText "||" ([a, b]) = Just "(${a} || ${b})"
-- 位运算：与 / 或 / 异或 / 取反直接生成 OCaml 位运算符；移位保留 runtime helper
-- （计数越界返回 0 的语义只写一份）。63-bit 补码语义与 `bi_bit*` 一致。
inlineText "bi_bitAnd" ([a, b]) = Just "(${a} land ${b})"
inlineText "bi_bitOr" ([a, b]) = Just "(${a} lor ${b})"
inlineText "bi_bitXor" ([a, b]) = Just "(${a} lxor ${b})"
inlineText "bi_bitNot" ([a]) = Just "(lnot ${a})"
inlineText "++" ([a, b]) = Just "(${a} ^ ${b})"
inlineText "bi_eq_int" ([a, b]) = Just "(${a} = ${b})"
inlineText "bi_neq_int" ([a, b]) = Just "(${a} <> ${b})"
inlineText "bi_eq_str" ([a, b]) = Just "(${a} = ${b})"
inlineText "bi_neq_str" ([a, b]) = Just "(${a} <> ${b})"
inlineText "bi_lt_int" ([a, b]) = Just "(${a} < ${b})"
inlineText "bi_le_int" ([a, b]) = Just "(${a} <= ${b})"
inlineText "bi_gt_int" ([a, b]) = Just "(${a} > ${b})"
inlineText "bi_ge_int" ([a, b]) = Just "(${a} >= ${b})"
inlineText "bi_lt_generic" ([a, b]) = Just "(${a} < ${b})"
inlineText "bi_le_generic" ([a, b]) = Just "(${a} <= ${b})"
inlineText "bi_gt_generic" ([a, b]) = Just "(${a} > ${b})"
inlineText "bi_ge_generic" ([a, b]) = Just "(${a} >= ${b})"
-- Float：算术/比较直接内联到 OCaml 浮点运算符（除零按 IEEE 语义，不失败）。
inlineText "bi_add_float" ([a, b]) = Just "(${a} +. ${b})"
inlineText "bi_sub_float" ([a, b]) = Just "(${a} -. ${b})"
inlineText "bi_mul_float" ([a, b]) = Just "(${a} *. ${b})"
inlineText "bi_div_float" ([a, b]) = Just "(${a} /. ${b})"
inlineText "bi_eq_float" ([a, b]) = Just "(${a} = ${b})"
inlineText "bi_neq_float" ([a, b]) = Just "(${a} <> ${b})"
inlineText "bi_lt_float" ([a, b]) = Just "(${a} < ${b})"
inlineText "bi_le_float" ([a, b]) = Just "(${a} <= ${b})"
inlineText "bi_gt_float" ([a, b]) = Just "(${a} > ${b})"
inlineText "bi_ge_float" ([a, b]) = Just "(${a} >= ${b})"
-- Nat 转换恒等/单分支，直接内联；算术用 runtime helper（饱和/截断逻辑只写一份）。
inlineText "natToInt" ([a]) = Just a
inlineText "natFromInt" ([a]) = Just "(bi_natFromInt ${a})"
inlineText "natAdd" ([a, b]) = Just "(bi_natAdd ${a} ${b})"
inlineText "natSub" ([a, b]) = Just "(bi_natSub ${a} ${b})"
inlineText "natMul" ([a, b]) = Just "(bi_natMul ${a} ${b})"
inlineText "natDiv" ([a, b]) = Just "(bi_natDiv ${a} ${b})"
inlineText _ _ = Nothing

-- 运行时文本 = 既有常量部分（`dtRuntime`） + 注入的定义位置表 + 报告器。
-- `dt_def_locs` 必须定义在报告器之前（报告器读它）；空表写成 `[]`。
-- `usesFloat` / `usesTrace` 为 False 时对应 helper 不出现：不用 Float/tracing 的程序
-- runtime 与引入该功能前**逐字节一致**（旧 seed 固定点/缓存关键）。
-- 运行时文本 = 既有常量部分（`dtRuntime`） + 注入的定义位置表 + 报告器 + 按需 helper。
-- `dt_def_locs` 必须定义在报告器之前（报告器读它）；空表写成 `[]`。
-- `usesFloat` / `usesTrace` / `usesObs` 为 False 时对应 helper 不出现：不用 Float /
-- tracing / 观测的程序 runtime 与引入该功能前**逐字节一致**（旧 seed 固定点/缓存关键）。
export dtRuntimeWith : String -> Bool -> Bool -> Bool -> String
dtRuntimeWith locs usesFloat usesTrace usesObs =
  dtRuntime
    ++ (if usesFloat then dtFloatRuntime else "")
    ++ (if locs == "" then "let dt_def_locs = []\n" else "let dt_def_locs = [\n${locs}]\n")
    ++ dtReporterRuntime
    ++ (if usesTrace then dtTraceRuntime else "")
    ++ (if usesObs then dtObsRuntime else "")

-- M19 / M22.2：`strUnpack` / `strPack` 的运行时桥接。
-- Core 的 `strUnpack` 语义是「OCaml int list」，而 DT 路径里 `List` 是程序自己声明的
-- 归纳族。这些 helper 按实际族名生成，把 int list ↔ 族构造子互转；Lowering 把
-- `strUnpack`/`strPack` 的契约条目带 `irRtBridgesList = True`（桥接只服务 Int 元素）。
export dtListBridge : Maybe IrListFam -> String
dtListBridge Nothing = ""
dtListBridge (Just lf) =
  let
    nilMl = ctorOcamlName (irListFamilyOf lf) (irListNilOf lf)
    consMl = ctorOcamlName (irListFamilyOf lf) (irListConsOf lf)
  in """

let dtp_unpack (s : string) =
  let cs = List.init (String.length s) (fun i -> Char.code s.[i]) in
  List.fold_right (fun x acc -> ${consMl} (x, acc)) cs ${nilMl}
let dtp_pack xs =
  let rec to_list xs = match xs with ${nilMl} -> [] | ${consMl} (x, rest) -> x :: to_list rest in
  let cs = Array.of_list (to_list xs) in
  String.init (Array.length cs) (fun i -> Char.chr cs.(i))

let dtp_listOf xs = List.fold_right (fun x acc -> ${consMl} (x, acc)) xs ${nilMl}
let dtp_ocamlOf xs =
  let rec go l = match l with ${nilMl} -> [] | ${consMl} (x, rest) -> x :: go rest in
  go xs

let dtp_concatMany xs = String.concat \"\" (dtp_ocamlOf xs)

let dtp_substTemplate tmpl xs =
  let args = Array.of_list (dtp_ocamlOf xs) in
  let n = String.length tmpl and na = Array.length args in
  let buf = Buffer.create (n + 32) in
  let rec go i =
    if i >= n then ()
    else if tmpl.[i] = '<' then begin
      let j = ref (i + 1) and k = ref 0 in
      while !j < n && tmpl.[!j] >= '0' && tmpl.[!j] <= '9' do
        k := !k * 10 + (Char.code tmpl.[!j] - 48); incr j
      done;
      if !j < n && tmpl.[!j] = '>' && !j > i + 1 then begin
        (if !k < na then Buffer.add_string buf args.(!k)
         else Buffer.add_string buf (String.sub tmpl i (!j - i + 1)));
        go (!j + 1)
      end else (Buffer.add_char buf '<'; go (i + 1))
    end else (Buffer.add_char buf tmpl.[i]; go (i + 1))
  in go 0; Buffer.contents buf
"""

-- 定义位置表：OCaml 值名 → (vuna 定义名, 文件:行)。
-- `norm` 负责把 span 里的文件路径归一到模块根 / 包目录下（见 `Codegen.Split`）。
-- C51（确定性）：增量路径的干净模块从接口复用，位置行来自接口里持久化的
-- `miDefLocs`；两条路径的拼接顺序不同，所以这里把行**按文本排序**再拼接——
-- 全量/增量产物因此逐字节一致，运行时 `assoc_opt` 查找不依赖顺序。
export dtDefLocTable : (String -> String) -> List (Pair String (Pair String Int)) -> String
dtDefLocTable norm rows = strConcatMany (sortLocRows (map (locRowOf norm) rows))

sortLocRows : List String -> List String
sortLocRows [] = []
sortLocRows (r :: rest) = insertLocRow r (sortLocRows rest)

insertLocRow : String -> List String -> List String
insertLocRow r [] = [r]
insertLocRow r (x :: rest) =
  if r <= x then Base.List.Cons r (Base.List.Cons x rest)
  else Base.List.Cons x (insertLocRow r rest)

locRowOf : (String -> String) -> Pair String (Pair String Int) -> String
locRowOf norm row =
  let
    name = firstOf row
    file = firstOf (secondOf row)
    line = secondOf (secondOf row)
  in "  (${ocamlString (valueName name)}, (${ocamlString name}, ${ocamlString "${norm file}:${strFromInt line}"}));\n"

-- ---------------------------------------------------------------
-- 生成状态
-- ---------------------------------------------------------------
--
-- 程序级表都在 `IrShared`（Lowering 算好）；后端只剩跨单元限定上下文与已引用依赖。
-- ---------------------------------------------------------------
-- 生成状态
-- ---------------------------------------------------------------
--
-- 程序级表都在 `IrShared`（Lowering 算好）；后端只剩跨单元限定上下文、已引用依赖与
-- 源码路径归一。`gsNormPath` 只给 `#line` 指令用：span 里的路径是解析时的原样（绝对
-- 路径或调用方给的相对路径），产物必须只含**包相对**路径才可复现（见
-- `docs/reference/observability.md` §5）。check 路径文本被丢弃，用恒等即可。
export record GenSt(..) where
  gsShared : IrShared
  gsQual : QualCtx
  gsDeps : List String
  gsNormPath : String -> String

export mkGenSt : QualCtx -> IrShared -> GenSt
mkGenSt qc shared = mkGenStWith (\p => p) qc shared

export mkGenStWith : (String -> String) -> QualCtx -> IrShared -> GenSt
mkGenStWith norm qc shared = GenSt shared qc [] norm

-- | 累积依赖单元（前插，`Codegen.Assembly` 再按首现顺序去重归一）。
export gsAddDep : GenSt -> String -> GenSt
gsAddDep st unit =
  if unit == "" || memName unit st.gsDeps then st
  else GenSt st.gsShared st.gsQual (unit :: st.gsDeps) st.gsNormPath

-- | 值引用：文本 + 依赖（跨单元 `Unit.name`）。
export genValueRef : GenSt -> String -> Pair String GenSt
genValueRef st name =
  let
    p = qualValueText st.gsQual name
  in Pair (firstOf p) (gsAddDep st (secondOf p))

-- | 构造子引用：文本 + 依赖（族归属决定单元）。
genCtorRef : GenSt -> String -> String -> Pair String GenSt
genCtorRef st family ctor =
  let
    p = qualCtorText st.gsQual family ctor
  in Pair (firstOf p) (gsAddDep st (secondOf p))

-- 族归属单元（record label / 类型引用）：同单元不记依赖（否则 split 出现自依环）。
export gsDepOfFamily : GenSt -> String -> GenSt
gsDepOfFamily st family =
  let
    unit = unitOfTbl st.gsQual.qcDatas family
  in if unit == "" || unit == st.gsQual.qcUnit then st else gsAddDep st unit

export recordLabelOf : GenSt -> String -> String -> String
recordLabelOf st family label =
  let
    unit = unitOfTbl st.gsQual.qcDatas family
  in if unit == "" || unit == st.gsQual.qcUnit then label else "${unit}.${label}"

-- List 桥接 helper 在**声明 List 族**的单元里；其它单元引用时按该单元限定。
-- helper 名单是契约的一部分，由 `Codegen.Runtime.ocamlRtHelperNames` 提供（单一来源）。
bridgeUnitOf : GenSt -> String
bridgeUnitOf st = case st.gsShared.irSharedListFam of
  Just lf => unitOfTbl st.gsQual.qcDatas (irListFamilyOf lf)
  Nothing => ""

replaceAll : String -> String -> String -> String
replaceAll old new text = join new (split old text)

qualifyBridgeNames : String -> List String -> String -> String
qualifyBridgeNames unit [] text = text
qualifyBridgeNames unit (n :: rest) text =
  qualifyBridgeNames unit rest (replaceAll n "${unit}.${n}" text)

qualifyBridgeText : String -> String -> String
qualifyBridgeText unit text =
  if unit == "" then text else qualifyBridgeNames unit ocamlRtHelperNames text

genBridgeRef : GenSt -> String -> Pair String GenSt
genBridgeRef st text =
  let
    unit = bridgeUnitOf st
  in Pair (qualifyBridgeText unit text) (gsAddDep st unit)

-- `EffUnit` 族的运行时类型文本 + 依赖（族名与 `IrTyData` 里带的一致）。
effUnitTyPair : GenSt -> Pair String GenSt
effUnitTyPair st =
  let
    p = qualTypeText st.gsQual effUnitTypeNameIr
  in Pair (firstOf p) (gsAddDep st (secondOf p))

effUnitTypeNameIr : String
effUnitTypeNameIr = "Base.Eff.EffUnit"

-- ---------------------------------------------------------------
-- IR 节点 → OCaml 文本
-- ---------------------------------------------------------------
export genIr : GenSt -> Ir -> Check (Pair String GenSt)
genIr st node = genIrNode st node

genIrNode : GenSt -> Ir -> Check (Pair String GenSt)
genIrNode st (IrVar b) = OkC (Pair (irBinderText b) st)
genIrNode st (IrGlobal name) =
  let
    p = genValueRef st name
  in OkC (Pair (firstOf p) (secondOf p))
genIrNode st (IrCtor family ctor args) = Vuna.Compiler.Common.bind (genIrArgs st args) (\p => case p of
  Pair texts st1 =>
    let
      r = genCtorRef st1 family ctor
    in OkC (Pair (conAppText (firstOf r) texts) (secondOf r))
)
genIrNode st (IrRecord family fields) = Vuna.Compiler.Common.bind (genAssignedFields st family fields) (\p => case p of
  Pair texts st1 => OkC (Pair "{ ${joinWith "; " texts} }" (gsDepOfFamily st1 family))
)
genIrNode st (IrProj base family field) = Vuna.Compiler.Common.bind (genIr st base) (\p => case p of
  Pair baseText st1 =>
    let
      st2 = gsDepOfFamily st1 family
      label = recordFieldLabel family field
    in OkC (Pair "(${baseText}).${recordLabelOf st2 family label}" st2)
)
genIrNode st (IrRecUpd base family fields) = Vuna.Compiler.Common.bind (genIr st base) (\p => case p of
  Pair baseText st1 => Vuna.Compiler.Common.bind (genAssignedFields st1 family fields) (\q => case q of
    Pair texts st2 =>
      OkC (Pair "{ ${baseText} with ${joinWith "; " texts} }" (gsDepOfFamily st2 family))
  )
)
genIrNode st (IrRt sym) = case ocamlRtText sym of
  Nothing => icInternal "no OCaml runtime text for IR symbol `${sym}`"
  Just text => if irRtBridgesList sym then OkC (genBridgeRef st text) else OkC (Pair text st)
genIrNode st (IrCast inner) = Vuna.Compiler.Common.bind (genIr st inner) (\p => case p of
  Pair text st1 => OkC (Pair "(Obj.magic ${text})" st1)
)
genIrNode st (IrInt n) = OkC (Pair (strFromInt n) st)
genIrNode st (IrStr s) = OkC (Pair (ocamlString s) st)
genIrNode st (IrBool b) = OkC (Pair (boolText b) st)
genIrNode st (IrFloatLit raw) = OkC (Pair raw st)
genIrNode st (IrLet bs scrut body) = Vuna.Compiler.Common.bind (genIr st scrut) (\p => case p of
  Pair scrutText st1 => Vuna.Compiler.Common.bind (genIr st1 body) (\q => case q of
    Pair bodyText st2 => case filter (\n => n /= "") (map nonErasedBinderText bs) of
      [] => OkC (Pair "(let _ = ${scrutText} in ${bodyText})" st2)
      pat :: rest => case rest of
        [] => OkC (Pair "(let ${pat} = ${scrutText} in ${bodyText})" st2)
        _ => icInternal "unboxed case arm has more than one runtime binder"
  )
)
genIrNode st (IrLam bs body) =
  let
    params = filter (\n => n /= "") (map nonErasedBinderText bs)
  in Vuna.Compiler.Common.bind (genIr st body) (\p => case p of
    Pair bodyText st1 => case params of
      [] => OkC (Pair bodyText st1)
      _ => OkC (Pair "(fun ${joinWith " " params} -> ${bodyText})" st1)
  )
genIrNode st (IrApp f a) = Vuna.Compiler.Common.bind (genIr st f) (\p => case p of
  Pair fText st1 => Vuna.Compiler.Common.bind (genIr st1 a) (\q => case q of
    Pair aText st2 => OkC (Pair "(${fText} ${aText})" st2)
  )
)
genIrNode st (IrIf c th el) = Vuna.Compiler.Common.bind (genIr st c) (\p => case p of
  Pair cText st1 => Vuna.Compiler.Common.bind (genIr st1 th) (\q => case q of
    Pair tText st2 => Vuna.Compiler.Common.bind (genIr st2 el) (\r => case r of
      Pair eText st3 => OkC (Pair "(if ${cText} then ${tText} else ${eText})" st3)
    )
  )
)
genIrNode st (IrCase scrut alts) = Vuna.Compiler.Common.bind (genIr st scrut) (\p => case p of
  Pair scrutText st1 => Vuna.Compiler.Common.bind (genArms st1 alts) (\q => case q of
    Pair arms st2 =>
      let
        fallback = if hasCatchAll alts then "" else "  | _ -> failwith \"DT: impossible branch\"\n"
      in OkC (Pair "(match ${scrutText} with\n${arms}${fallback})" st2)
  )
)
genIrNode st (IrNatCase scrut fresh zero succ catch) = Vuna.Compiler.Common.bind (genIr st scrut) (\p => case p of
  Pair scrutText st1 => Vuna.Compiler.Common.bind (genNatBranches st1 fresh zero succ catch) (\q => case q of
    Pair branches st2 =>
      OkC (Pair "(let dtnat__${strFromInt fresh} = ${scrutText} in ${branches})" st2)
  )
)
genIrNode st (IrRtApp name args) = Vuna.Compiler.Common.bind (genIrArgs st args) (\p => case p of
  Pair texts st1 => case inlineText name texts of
    Just text => OkC (Pair text st1)
    Nothing => icInternal "no inline text for builtin `${name}`"
)
genIrNode st (IrConcatMany parts) = Vuna.Compiler.Common.bind (genIrArgs st parts) (\p => case p of
  Pair texts st1 => OkC (Pair "(String.concat \"\" [${joinWith "; " texts}])" st1)
)
genIrNode st (IrEffThunk family ctor unitTy arity prim) = Vuna.Compiler.Common.bind (genIr st prim) (\p => case p of
  Pair primText st1 =>
    let
      ctorP = genCtorRef st1 family ctor
      st2 = gsDepOfFamily (secondOf ctorP) family
    in OkC (Pair (effThunkText (firstOf ctorP) (irTyText st2.gsQual unitTy) primText arity) st2)
)
genIrNode st (IrEffBind family ctor unitTy) =
  let
    ctorP = genCtorRef st family ctor
    st1 = gsDepOfFamily (secondOf ctorP) family
    unitText = irTyText st1.gsQual unitTy
  in OkC
    (Pair "(fun m k -> ${firstOf ctorP} (fun (u : ${unitText}) -> match m with ${firstOf ctorP} f -> (match k (f u) with ${firstOf ctorP} g -> g u)))" st1)

-- Eff 原语：运行时仍是 eager 函数，但结果必须是装箱的 `MkEff`（Eff 是 base data）。
-- 生成 `MkEff (fun (_ : EffUnit) -> rt args)`。
effThunkText : String -> String -> String -> Int -> String
effThunkText ctor unitTy rt arity =
  let
    argText = joinWith " " (takeNames arity ioParamNames)
  in if arity == 0 then "(${ctor} (fun (_ : ${unitTy}) -> ${rt}))"
  else "(fun ${argText} -> ${ctor} (fun (_ : ${unitTy}) -> ${rt} ${argText}))"

-- 原语最多 2 个运行时参数（`@vuna@prim_eff_writeFile` / `@vuna@prim_eff_runIn`）；表比实际用到的长，
-- `takeNames` 按 arity 截断（结构递归在表尾上，终止性检查可见）。
ioParamNames : List String
ioParamNames = ["dtio_0", "dtio_1", "dtio_2", "dtio_3"]

takeNames : Int -> List String -> List String
takeNames n names = if n <= 0 then []
else case names of
  [] => []
  name :: rest => name :: takeNames (n - 1) rest

genIrArgs : GenSt -> List Ir -> Check (Pair (List String) GenSt)
genIrArgs st [] = OkC (Pair [] st)
genIrArgs st (ir :: rest) = Vuna.Compiler.Common.bind (genIr st ir) (\p => case p of
  Pair text st1 => Vuna.Compiler.Common.bind (genIrArgs st1 rest) (\q => case q of
    Pair texts st2 => OkC (Pair (Base.List.Cons text texts) st2)
  )
)

-- record 构造 / 更新的字段赋值表：`f = v`（字段 label 按族所属单元限定）。
genAssignedFields : GenSt -> String -> List (Pair String Ir) -> Check (Pair (List String) GenSt)
genAssignedFields st family [] = OkC (Pair [] st)
genAssignedFields st family (f :: rest) = Vuna.Compiler.Common.bind (genIr st (secondOf f)) (\p => case p of
  Pair text st1 => Vuna.Compiler.Common.bind (genAssignedFields st1 family rest) (\q => case q of
    Pair texts st2 =>
      let
        st3 = gsDepOfFamily st2 family
        label = recordLabelOf st3 family (recordFieldLabel family (firstOf f))
      in OkC (Pair (Base.List.Cons "${label} = ${text}" texts) st3)
  )
)

nonErasedBinderText : IrBinder -> String
nonErasedBinderText (IrBinder nm True) = ""
nonErasedBinderText (IrBinder nm False) = irBinderText (IrBinder nm False)

hasCatchAll : List IrAlt -> Bool
hasCatchAll [] = False
hasCatchAll (alt :: rest) = case irAltCtorOf alt of
  Nothing => True
  Just _ => hasCatchAll rest

genArms : GenSt -> List IrAlt -> Check (Pair String GenSt)
genArms st [] = OkC (Pair "" st)
genArms st (alt :: rest) = Vuna.Compiler.Common.bind (genArm st alt) (\p => case p of
  Pair arm st1 => Vuna.Compiler.Common.bind (genArms st1 rest) (\q => case q of
    Pair arms st2 => OkC (Pair (arm ++ arms) st2)
  )
)

genArm : GenSt -> IrAlt -> Check (Pair String GenSt)
genArm st alt =
  let
    envPats = filter (\n => n /= "") (map nonErasedBinderText (irAltBindersOf alt))
  in Vuna.Compiler.Common.bind (genIr st (irAltBodyOf alt)) (\p => case p of
    Pair bodyText st1 => case irAltCtorOf alt of
      Nothing =>
        let
          pat = case envPats of
            [] => "_"
            p2 :: rest => p2
        in OkC (Pair "  | ${pat} -> ${bodyText}\n" st1)
      Just (Pair family ctor) => case irSharedRecordFieldsOf family st1.gsShared.irSharedRecordFields of
        [] =>
          let
            r = genCtorRef st1 family ctor
          in OkC (Pair "  | ${armPatternText (firstOf r) envPats} -> ${bodyText}\n" (secondOf r))
        fields =>
          OkC
            (Pair "  | ${recordPatText st1 family fields envPats} -> ${bodyText}\n" (gsDepOfFamily st1 family))
  )

-- record 模式 `{ f = p; ... }`（字段表与运行时 binder 按序对齐）。
recordPatText : GenSt -> String -> List (Pair Int String) -> List String -> String
recordPatText st family fields pats =
  "{ ${joinWith "; " (recordPatAssigned st family fields pats)} }"

recordPatAssigned : GenSt -> String -> List (Pair Int String) -> List String -> List String
recordPatAssigned st family [] pats = []
recordPatAssigned st family fields [] = []
recordPatAssigned st family (f :: fs) (p :: ps) =
  "${recordLabelOf st family (recordFieldLabel family (secondOf f))} = ${p}"
    :: recordPatAssigned st family fs ps

armPatternText : String -> List String -> String
armPatternText cname [] = cname
armPatternText cname pats = "${cname} (${joinWith ", " pats})"

-- ---------------------------------------------------------------
-- Nat case 降级：Nat 运行时是 int，不能生成变体 match。
-- ---------------------------------------------------------------
genNatBranches : GenSt -> Int -> Maybe IrAlt -> Maybe IrAlt -> Maybe IrAlt -> Check (Pair String GenSt)
genNatBranches st fresh zero succ catch =
  let
    sc = "dtnat__${strFromInt fresh}"
    predExpr = "(${sc} - 1)"
    impossible = "(failwith \"DT: impossible branch\")"
  in Vuna.Compiler.Common.bind (genNatAlt st zero Nothing) (\pz => case pz of
    Pair zeroText st1 => Vuna.Compiler.Common.bind (genNatAlt st1 succ (Just predExpr)) (\ps => case ps of
      Pair succText st2 => Vuna.Compiler.Common.bind (genNatAlt st2 catch (Just sc)) (\pc => case pc of
        Pair catchText st3 =>
          let
            trueText = case zero of
              Just _ => zeroText
              Nothing => case catch of
                Just _ => catchText
                Nothing => impossible
            falseText = case succ of
              Just _ => succText
              Nothing => case catch of
                Just _ => catchText
                Nothing => impossible
          in OkC (Pair "(if ${sc} = 0 then ${trueText} else ${falseText})" st3)
      )
    )
  )

genNatAlt : GenSt -> Maybe IrAlt -> Maybe String -> Check (Pair String GenSt)
genNatAlt st Nothing bindExpr = OkC (Pair "" st)
genNatAlt st (Just alt) bindExpr = Vuna.Compiler.Common.bind (genIr st (irAltBodyOf alt)) (\p => case p of
  Pair bodyText st1 => case filter (\n => n /= "") (map nonErasedBinderText (irAltBindersOf alt)) of
    [] => OkC (Pair bodyText st1)
    nm :: rest => case rest of
      [] => case bindExpr of
        Just expr => OkC (Pair "(let ${nm} = ${expr} in ${bodyText})" st1)
        Nothing => icInternal "Nat case arm has a binder but no runtime binding"
      _ => icInternal "Nat case arm has more than one runtime binder"
)

-- ---------------------------------------------------------------
-- 分组 → OCaml 定义
-- ---------------------------------------------------------------
-- 定义级 CG 错误带来源位置（`IrDef` 的 `Maybe Span` + 定义名）。
export genGroups : GenSt -> List IrGroup -> Check (Pair (List String) GenSt)
genGroups st [] = OkC (Pair [] st)
genGroups st (g :: rest) = Vuna.Compiler.Common.bind (genGroup st g) (\p => case p of
  Pair text st1 => Vuna.Compiler.Common.bind (genGroups st1 rest) (\q => case q of
    Pair texts st2 => OkC (Pair (Base.List.Cons text texts) st2)
  )
)

genGroup : GenSt -> IrGroup -> Check (Pair String GenSt)
genGroup st group = Vuna.Compiler.Common.bind (genGroupBodies st (irGroupDefs group)) (\p => case p of
  -- 单定义 + extern：`external` 前不能有 `let` 头；指令由 `genDef` 自己写在前面。
  Pair defs st1 => case irGroupDefs group of
    [d] => case irDefExtern d of
      Just _ => OkC (Pair (joinWith "\n" defs) st1)
      Nothing => OkC (Pair (bindGroupOf st1 group defs) st1)
    _ => OkC (Pair (bindGroupOf st1 group defs) st1)
)
-- 分组装配：`#line` 指令在前（自成一行），`let` / `let rec` / `and` 关键字与绑定名
-- 仍在同一行 —— 既有 `^let v_` 断言、快照 grep 与 `letrec` 口径都不受影响。
bindGroupOf : GenSt -> IrGroup -> List String -> String
bindGroupOf st group defs = case Base.List.zip (irGroupDefs group) defs of
  [] => ""
  p :: rest => joinWith "\n" (Base.List.Cons (bindFirstOf st group p) (map (bindAndOf st) rest))

bindFirstOf : GenSt -> IrGroup -> Pair IrDef String -> String
bindFirstOf st group p = lineDirectiveOf st (firstOf p) ++ bindKeywordOf group ++ secondOf p

bindAndOf : GenSt -> Pair IrDef String -> String
bindAndOf st p = lineDirectiveOf st (firstOf p) ++ "and " ++ secondOf p

bindKeywordOf : IrGroup -> String
bindKeywordOf group = if irGroupIsRec group then "let rec " else "let "

-- `#line` 指令（`# <line> "<file>"`，`docs/reference/observability.md` §5）：让 DWARF 的
-- `.debug_line` 直接指向 `.vuna` 源，`gdb` / `perf` / 异常回栈不必再靠 `dt_def_locs`。
--
-- 位置来自 IR 的 `irDefSpan`（Lowering 已保留）；路径经 `gsNormPath` 归一到包相对。
-- 返回文本以换行结尾：指令**自成一行**、放在 `let` / `let rec` / `and` / `external` 之前
-- （指令与关键字同一行在 OCaml 里非法）。`#line` 是「文件 + 行」粒度：同一指令后连续
-- 生成的代码都归到该起始行（表达式级定位不存在，见 debt D33/D80）。
lineDirectiveOf : GenSt -> IrDef -> String
lineDirectiveOf st d = case irDefSpan d of
  Nothing => ""
  Just sp =>
    let
      file = st.gsNormPath sp.spanFile
    in if file == "" then "" else "# ${strFromInt (spanStartLine sp)} ${ocamlString file}\n"

genGroupBodies : GenSt -> List IrDef -> Check (Pair (List String) GenSt)
genGroupBodies st [] = OkC (Pair [] st)
genGroupBodies st (d :: rest) = Vuna.Compiler.Common.bind (genDef st d) (\p => case p of
  Pair text st1 => Vuna.Compiler.Common.bind (genGroupBodies st1 rest) (\q => case q of
    Pair texts st2 => OkC (Pair (Base.List.Cons text texts) st2)
  )
)

genDef : GenSt -> IrDef -> Check (Pair String GenSt)
genDef st d = case irDefExtern d of
  Just (Pair ty cName) =>
    OkC
      (Pair ("external ${valueName (irDefName d)} : ${irTyText st.gsQual ty} = ${ocamlString cName}") st)
  Nothing => case irDefBody d of
    Nothing =>
      ErrC
        (withContext (irDefSpan d) (irDefName d) (diagNoLoc SevError PhInternal CatInternal "IC_AxiomRuntime" "axiom reached runtime code generation (partition must erase it)"))
    Just body => Vuna.Compiler.Common.bind (genIr st body) (\p => case p of
      Pair bodyText st1 =>
        let
          finalText =
            if irDefInitGuard d then "(try ${bodyText} with e -> dt_report_exn e (Printexc.get_raw_backtrace ()); exit 2)"
            else bodyText
        in OkC (Pair ("${valueName (irDefName d)} = ${finalText}") st1)
    )

-- ---------------------------------------------------------------
-- main 钩子
-- ---------------------------------------------------------------
-- main 的类型拆解（动作 vs 普通值）、展示函数、动作行 handler 列表都在 Lowering 决策；
-- 这里只按固定模板把名字渲染进文本。返回文本以换行开头，调用方直接接在正文之后。
-- M38：动作整体包进 `try`——未捕获异常交给运行时报告器（dt_report_exn）打印
-- "vuna: runtime error: ..." + 命中的 vuna 位置帧，然后 exit 2（不再是 OCaml 的
-- Fatal error 形态）。try 只包 main 这一处，不碰 lambda，尾调不受影响。
export genEntryHook : GenSt -> IrEntry -> Bool -> Check (Pair String (List String))
genEntryHook st entry printResult = Vuna.Compiler.Common.bind (genIr st (irEntryShowOf entry)) (\sp => case sp of
  Pair showText st1 => case irEntryIsActionOf entry of
    True => case irEntryRunMainOf entry of
      Nothing => icInternal "action entry has no runMain"
      Just runMain =>
        let
          mainP = genValueRef st1 (irEntryMainOf entry)
          st2 = secondOf mainP
          runP = genValueRef st2 runMain
          st3 = secondOf runP
        in case foldHandlers st3 (firstOf mainP) (irEntryHandlersOf entry) of
          Pair wrappedText st4 =>
            let
              body = "dtp_sched_main (fun () -> ${firstOf runP} ${wrappedText})"
            in OkC (Pair (hookText showText body printResult) st4.gsDeps)
    False =>
      let
        mainP = genValueRef st1 (irEntryMainOf entry)
      in OkC (Pair (hookText showText (firstOf mainP) printResult) (secondOf mainP).gsDeps)
)

-- handlers 左折：`(${hRef} ${acc})`（行顺序：后出现的包在外层）。
foldHandlers : GenSt -> String -> List String -> Pair String GenSt
foldHandlers st acc [] = Pair acc st
foldHandlers st acc (h :: rest) =
  let
    p = genValueRef st h
  in foldHandlers (secondOf p) "(${firstOf p} ${acc})" rest

hookText : String -> String -> Bool -> String
hookText showText body printResult =
  let
    action = if printResult then "print_endline (${showText} (${body}))" else "ignore (${body})"
  in "\nlet () =\n  Printexc.record_backtrace true;\n  try ${action}\n  with e -> dt_report_exn e (Printexc.get_raw_backtrace ()); exit 2\n"

-- OCaml 的多参变体构造子是 **tupled**（`C of t1 * t2` 写作 `C (a, b)`），
-- 不是 curried，所以多实参必须用逗号包成一个元组。
conAppText : String -> List String -> String
conAppText name [] = name
conAppText name ([a]) = "(${name} (${a}))"
conAppText name args = "(${name} (${joinWith ", " args}))"
