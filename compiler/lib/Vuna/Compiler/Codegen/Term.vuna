module Vuna.Compiler.Codegen.Term
  ( GenSt(..)
  , actionResultTy
  , actionRunText
  , dtDefLocTable
  , dtListBridge
  , dtRuntime
  , dtRuntimeWith
  , findListFamilyData
  , genDtHook
  , genGroups
  , mkGenSt
  ) where

-- Vuna.Compiler.Codegen.Term：项 → OCaml（擦除驱动）+ DT 运行时前缀。
--
-- 生成状态 GenSt（族/构造子表、构造子形状、fresh 变量计数）是生成期唯一可变状态；
-- case 分支绑定按构造子形状（keep flags）校验后进入 binder 环境。`dtRuntime`
-- 是产物开头的 OCaml 帮助函数（bi_* / show / dtp_*），`dtListBridge` 只在程序声明了
-- List 族时生成 int list ↔ 变体族的桥接。
import Base.List
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Core
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Elab
import Vuna.Compiler.Intrinsics
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Elab.Representation
import Vuna.Compiler.Codegen.Erase

-- DT runtime：只包含 prelude 里出现的运算与 show（名字/语义与运行时 helper 一致）。
dtRuntime : String
dtRuntime = """let () =
  let c = Gc.get () in
  Gc.set { c with minor_heap_size = 16 * 1024 * 1024; space_overhead = 200 }
let () =
  if (try Sys.getenv \"VN_PERF_STATS\" with Not_found -> \"\") <> \"\" then
    at_exit (fun () ->
      let s = Gc.quick_stat () in
      Printf.eprintf \"VN_PERF minor_words=%.0f major_words=%.0f minor_collections=%d major_collections=%d top_heap_words=%d\\n\"
        s.Gc.minor_words s.Gc.major_words s.Gc.minor_collections s.Gc.major_collections s.Gc.top_heap_words)
let bi_add a b = a + b
let bi_sub a b = a - b
let bi_mul a b = a * b
let bi_div a b = if b = 0 then failwith \"division by zero\" else a / b
let bi_eq_int (a : int) (b : int) = a = b
let bi_neq_int (a : int) (b : int) = a <> b
let bi_eq_str (a : string) (b : string) = a = b
let bi_neq_str (a : string) (b : string) = a <> b
let bi_strFromInt (n : int) = string_of_int n
let bi_strLength (s : string) = String.length s
let bi_strUnpack (s : string) = List.init (String.length s) (fun i -> Char.code s.[i])
let bi_strPack (cs : int list) =
  let a = Array.of_list cs in
  String.init (Array.length a) (fun i -> Char.chr a.(i))
let bi_lt_int (a : int) (b : int) = a < b
let bi_le_int (a : int) (b : int) = a <= b
let bi_gt_int (a : int) (b : int) = a > b
let bi_ge_int (a : int) (b : int) = a >= b
let bi_lt_generic (a : 'a) (b : 'a) = compare a b < 0
let bi_le_generic (a : 'a) (b : 'a) = compare a b <= 0
let bi_gt_generic (a : 'a) (b : 'a) = compare a b > 0
let bi_ge_generic (a : 'a) (b : 'a) = compare a b >= 0
let bi_concat a b = a ^ b
let bi_and a b = a && b
let bi_or a b = a || b
let bi_bitAnd (a : int) (b : int) = a land b
let bi_bitOr (a : int) (b : int) = a lor b
let bi_bitXor (a : int) (b : int) = a lxor b
let bi_bitNot (a : int) = lnot a
let bi_bitShl (a : int) (n : int) = if n < 0 || n >= 63 then 0 else a lsl n
let bi_bitShr (a : int) (n : int) = if n < 0 || n >= 63 then 0 else a lsr n
let bi_natSucc (n : int) = if n >= max_int then max_int else n + 1
let bi_natAdd (a : int) (b : int) = if a > max_int - b then max_int else a + b
let bi_natSub (a : int) (b : int) = if a <= b then 0 else a - b
let bi_natMul (a : int) (b : int) =
  if a <= 0 || b <= 0 then 0 else if a > max_int / b then max_int else a * b
let bi_natDiv (a : int) (b : int) = if b = 0 then failwith \"division by zero\" else a / b
let bi_natToInt (n : int) = n
let bi_natFromInt (n : int) = if n <= 0 then 0 else n
let dt_show_bool b = if b then \"True\" else \"False\"
let dt_show_string s =
  let buf = Buffer.create 16 in
  Buffer.add_char buf (Char.chr 34);
  String.iter (fun c ->
    let n = Char.code c in
    if n = 34 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 34))
    else if n = 92 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 92))
    else if n = 10 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"n\")
    else if n = 9 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"t\")
    else if n = 13 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"r\")
    else Buffer.add_char buf c) s;
  Buffer.add_char buf (Char.chr 34);
  Buffer.contents buf
${dtPrimRuntime}"""

-- M21：effectful 内建（`prim_*`）的 DT 运行时实现。
-- 签名在 `Vuna.Compiler.Intrinsics`（唯一真源），这里补 OCaml 侧实现（对应
-- `intrinsicRuntime` 字段）；`prim_eff_getArgs` / `prim_eff_readLine` 在 Base.Host 里是**值**，
-- 所以在引用点展开成 `dtp_*(()`，与 Codegen 的既有处理一致（每次求值都重新读）。
-- `prim_eff_readBytes` 是**函数**（`Int -> String`）：最多读 n 字节、有数据就立即返回
-- （可能少于 n），EOF 返回 `""`——LSP 的帧循环靠它精确读 Content-Length 字节。
dtPrimRuntime : String
dtPrimRuntime = ("""type _ Effect.t += Perform : string * string * Obj.t -> Obj.t Effect.t

(* W7：bracket 的 abort cleanup 登记表（每纤程一份，LIFO）。
   `prim_effectHandle` 在安装 handler 时记下当前深度 mark；handler 正常返回 /
   抛异常 / 丢弃续延（abort）时，把 mark 之上仍未弹出的 cleanup 逐个执行——这些
   正是被丢弃的续延里打开的 bracket。纤程用 `dtp_cleanup_fiber` 区分（调度器在
   运行某个任务时设置它）；非调度器上下文（-1）有一份独立栈。
   注意：cleanup 在 handler 退出点执行，只能访问**外层** handler（当前 handler
   的效应在该点不可用）；执行期异常被吞掉，避免污染 abort 结果。 *)
let dtp_cleanup_fiber = ref (-1)
let dtp_cleanup_stacks : (int, (unit -> unit) list ref) Hashtbl.t = Hashtbl.create 8
let dtp_cleanup_stack_of (fid : int) =
  match Hashtbl.find_opt dtp_cleanup_stacks fid with
  | Some r -> r
  | None ->
    let r = ref [] in
    Hashtbl.replace dtp_cleanup_stacks fid r;
    r
let dtp_cleanup_current () = dtp_cleanup_stack_of !dtp_cleanup_fiber
let dtp_cleanup_mark () = List.length !(dtp_cleanup_current ())
let dtp_cleanup_push (f : int -> int) : int =
  let r = dtp_cleanup_current () in
  r := (fun () -> ignore (f 0)) :: !r;
  0
let dtp_cleanup_pop (_ : int) : int =
  let r = dtp_cleanup_current () in
  (match !r with _ :: rest -> r := rest | [] -> ());
  0
let dtp_cleanup_run_to (mark : int) =
  let r = dtp_cleanup_current () in
  let rec go fuel =
    if fuel <= 0 then ()
    else if List.length !r <= mark then ()
    else match !r with
      | [] -> ()
      | f :: rest -> r := rest; (try f () with _ -> ()); go (fuel - 1)
  in
  go 256
let dtp_cleanup_run_all_for (fid : int) =
  let r = dtp_cleanup_stack_of fid in
  let rec go fuel =
    if fuel <= 0 then ()
    else match !r with
      | [] -> ()
      | f :: rest -> r := rest; (try f () with _ -> ()); go (fuel - 1)
  in
  go 256
let dtp_cleanup_forget (fid : int) = Hashtbl.remove dtp_cleanup_stacks fid
let dtp_cleanup_reset () =
  Hashtbl.reset dtp_cleanup_stacks;
  dtp_cleanup_fiber := -1

(* handler 的运行时壳：与旧内联实现等价，但 handler 退出时清掉其 extent 内残留的
   bracket cleanup（abort = 续延被丢弃，库层 finally 不会再跑）。 *)
let dtp_effect_handle key name ret h th =
  fun u ->
    let mark = dtp_cleanup_mark () in
    let run_cleanups () = dtp_cleanup_run_to mark in
    (* 外层 Obj.magic 与旧内联实现一致：effc 的 continue 返回 Obj.t，去掉它会让
       handler 的 answer 类型被钉成 Obj.t。 *)
    Obj.magic
      (match Effect.Deep.match_with (fun () -> (Obj.magic th) u) ()
        { retc = (fun x -> (Obj.magic ret) x);
          exnc = (fun e -> raise e);
          effc = (fun (type a) (eff : a Effect.t) -> match eff with
            | Perform (k, n, payload) when k = key && n = name ->
              Some (fun (cont : (a, Obj.t) Effect.Deep.continuation) ->
                (Obj.magic h) payload (fun v -> Effect.Deep.continue cont (Obj.repr v)))
            | _ -> None) }
      with
      | r -> run_cleanups (); r
      | exception e -> run_cleanups (); raise e)
let dtp_print s = print_string s; flush stdout; String.length s
let dtp_async_tbl : (int, unit -> Obj.t) Hashtbl.t = Hashtbl.create 16
let dtp_async_next = ref 0
let dtp_async_fork th =
  let id = !dtp_async_next in
  incr dtp_async_next;
  let d = Domain.spawn (fun () -> th 0) in
  Hashtbl.replace dtp_async_tbl id (fun () -> Obj.repr (Domain.join d));
  id
let dtp_async_await (h : int) : Obj.t =
  match Hashtbl.find_opt dtp_async_tbl h with
  | Some join -> join ()
  | None -> failwith \"async: invalid task handle\"
let dtp_readFile path =
  try
    let ch = open_in_bin path in
    Fun.protect ~finally:(fun () -> close_in_noerr ch)
      (fun () -> really_input_string ch (in_channel_length ch))
  with Sys_error msg -> failwith (\"readFile: \" ^ msg)
let dtp_writeFile path contents =
  try
    let ch = open_out_bin path in
    Fun.protect ~finally:(fun () -> close_out_noerr ch)
      (fun () -> output_string ch contents);
    String.length contents
  with Sys_error msg -> failwith (\"writeFile: \" ^ msg)
let dtp_writeFileAtomic path contents =
  let tmp = path ^ \".\" ^ string_of_int (Unix.getpid ()) ^ \".tmp\" in
  let write () =
    let ch = open_out_bin tmp in
    Fun.protect ~finally:(fun () -> close_out_noerr ch) (fun () -> output_string ch contents) in
  (try write (); Sys.rename tmp path; String.length contents
   with e -> (try Sys.remove tmp with _ -> ()); raise e)
let dtp_getArgs () =
  let argv = Sys.argv in
  let n = Array.length argv in
  if n <= 1 then [] else Array.to_list (Array.sub argv 1 (n - 1))
let dtp_readLine () = try input_line stdin with End_of_file -> \"\"
let dtp_readBytes n =
  if n <= 0 then \"\"
  else
    let b = Bytes.create n in
    let k = try input stdin b 0 n with _ -> 0 in
    if k <= 0 then \"\" else Bytes.sub_string b 0 k
let dtp_readDir path =
  try List.sort compare (Array.to_list (Sys.readdir path))
  with Sys_error msg -> failwith (\"readDir: \" ^ msg)
let dtp_isDirectory path =
  try Sys.is_directory path with Sys_error msg -> failwith (\"isDirectory: \" ^ msg)
let dtp_makeDir path =
  try (if Sys.file_exists path then 0 else (Sys.mkdir path 0o755; 0))
  with Sys_error msg -> failwith (\"makeDir: \" ^ msg)
let dtp_removeFile path =
  try (if Sys.file_exists path then (Sys.remove path; 0) else 0)
  with Sys_error msg -> failwith (\"removeFile: \" ^ msg)
let dtp_fileExists path = Sys.file_exists path
let dtp_fileMtime path =
  try int_of_float (Unix.stat path).Unix.st_mtime with _ -> 0
let dtp_fileSize path =
  try (Unix.stat path).Unix.st_size with _ -> 0
let dtp_timeUs () = int_of_float (Unix.gettimeofday () *. 1000000.0)
let dtp_sleep us =
  (if us > 0 then Unix.sleepf (float_of_int us /. 1000000.0));
  0
let dtp_getenv k = try Sys.getenv k with Not_found -> \"\"
let dtp_getcwd () = try Sys.getcwd () with _ -> \".\"
let dtp_execPath () = try Unix.readlink \"/proc/self/exe\" with _ -> Sys.executable_name
let dtp_arraySet (a : 'a array) (i : int) (v : 'a) =
  let b = Array.copy a in
  Array.set b i v; b
let dtp_strHash (s : string) =
  let h = ref 0 in
  String.iter (fun c -> h := ((!h * 33) + Char.code c) land 1023) s;
  !h
let dtp_strAt (s : string) (i : int) = if i < 0 || i >= String.length s then -1 else Char.code s.[i]
let dtp_substring start len s =
  let n = String.length s in
  let st = if start < 0 then 0 else if start > n then n else start in
  let ln = if len < 0 then 0 else if st + len > n then n - st else len in
  String.sub s st ln
let dtp_exit n = exit n
let dtp_runIn dir args =
  let quote s = Filename.quote s in
  let cmd = String.concat \" \" (List.map quote args) in
  let old = Sys.getcwd () in
  Fun.protect ~finally:(fun () -> Sys.chdir old) (fun () -> Sys.chdir dir; Sys.command cmd)
let dtp_spawn (args : string list) : int =
  let prog = Sys.executable_name in
  Unix.create_process prog (Array.of_list (prog :: args)) Unix.stdin Unix.stdout Unix.stderr
let dtp_wait (pid : int) : int =
  let (_, st) = Unix.waitpid [] pid in
  match st with Unix.WEXITED c -> c | _ -> 1
let dtp_net_tbl : (int, Unix.file_descr) Hashtbl.t = Hashtbl.create 16
let dtp_net_next = ref 1
let dtp_net_put (fd : Unix.file_descr) : int =
  let k = !dtp_net_next in
  dtp_net_next := k + 1;
  Hashtbl.replace dtp_net_tbl k fd;
  k
let dtp_net_get (h : int) : Unix.file_descr =
  match Hashtbl.find_opt dtp_net_tbl h with
  | Some fd -> fd
  | None -> failwith \"net: invalid handle\"
let dtp_net_drop (h : int) = (try Hashtbl.remove dtp_net_tbl h with _ -> ())
let dtp_net_error (what : string) (e : exn) : 'a =
  match e with
  | Unix.Unix_error (ue, fn, arg) ->
    failwith (\"net: \" ^ what ^ \": \" ^ Unix.error_message ue ^ (if arg = \"\" then \"\" else \" (\" ^ arg ^ \")\"))
  | _ -> failwith (\"net: \" ^ what ^ \": \" ^ Printexc.to_string e)
let dtp_net_parse (addr : string) =
  let n = String.length addr in
  if n > 5 && String.sub addr 0 5 = \"unix:\" then `Unix (String.sub addr 5 (n - 5))
  else if n > 4 && String.sub addr 0 4 = \"tcp:\" then
    let rest = String.sub addr 4 (n - 4) in
    (match (try Some (String.rindex rest ':') with Not_found -> None) with
     | None -> failwith (\"net: invalid address (want tcp:HOST:PORT or unix:PATH): \" ^ addr)
     | Some i ->
       let host = String.sub rest 0 i in
       let portstr = String.sub rest (i + 1) (String.length rest - i - 1) in
       let port = try int_of_string portstr with _ -> failwith (\"net: invalid port: \" ^ portstr) in
       `Tcp (host, port))
  else failwith (\"net: invalid address (want tcp:HOST:PORT or unix:PATH): \" ^ addr)
let dtp_net_listen (addr : string) : int =
  match dtp_net_parse addr with
  | `Unix path ->
    (try if Sys.file_exists path then Sys.remove path with _ -> ());
    let s = Unix.socket Unix.PF_UNIX Unix.SOCK_STREAM 0 in
    (try Unix.bind s (Unix.ADDR_UNIX path); Unix.listen s 8; dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"listen\" e)
  | `Tcp (host, port) ->
    let s = Unix.socket Unix.PF_INET Unix.SOCK_STREAM 0 in
    (try
       Unix.setsockopt s Unix.SO_REUSEADDR true;
       Unix.bind s (Unix.ADDR_INET (Unix.inet_addr_of_string host, port));
       Unix.listen s 8;
       dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"listen\" e)
let dtp_net_port (h : int) : int =
  match Unix.getsockname (dtp_net_get h) with
  | Unix.ADDR_INET (_, p) -> p
  | Unix.ADDR_UNIX _ -> 0
let dtp_net_accept (h : int) : int =
  (try let (fd, _) = Unix.accept (dtp_net_get h) in dtp_net_put fd
   with e -> dtp_net_error \"accept\" e)
let dtp_net_recv (h : int) (n : int) : string =
  if n <= 0 then \"\"
  else
    let b = Bytes.create n in
    (try
       let k = Unix.read (dtp_net_get h) b 0 n in
       if k <= 0 then \"\" else Bytes.sub_string b 0 k
     with e -> dtp_net_error \"recv\" e)
let dtp_net_send (h : int) (s : string) : int =
  let fd = dtp_net_get h in
  let n = String.length s in
  let rec go off =
    if off >= n then ()
    else
      let k = (try Unix.write_substring fd s off (n - off) with e -> dtp_net_error \"send\" e) in
      if k <= 0 then failwith \"net: send: connection closed\" else go (off + k)
  in
  go 0; n
let dtp_net_close (h : int) : int =
  (try Unix.close (dtp_net_get h) with _ -> ());
  dtp_net_drop h; 0
let dtp_net_connect (addr : string) : int =
  match dtp_net_parse addr with
  | `Unix path ->
    let s = Unix.socket Unix.PF_UNIX Unix.SOCK_STREAM 0 in
    (try Unix.connect s (Unix.ADDR_UNIX path); dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"connect\" e)
  | `Tcp (host, port) ->
    let s = Unix.socket Unix.PF_INET Unix.SOCK_STREAM 0 in
    (try Unix.connect s (Unix.ADDR_INET (Unix.inet_addr_of_string host, port)); dtp_net_put s
     with e -> (try Unix.close s with _ -> ()); dtp_net_error \"connect\" e)
"""
) ++ dtSchedRuntime

-- W9：单线程协作式 fiber 调度器（Layer 3）运行时。
-- 纤程 = OCaml 5 一次性续延；调度器在纤程外的循环里决定下一步跑谁，
-- 挂起经私有运行时效应（SchedYield/SchedAwait/SchedWaitScope*）。任务体是
-- `Eff Nil a`；Base.EffSched 经隐藏 intrinsic 调用 dtp_sched_* 原语。
dtSchedRuntime : String
dtSchedRuntime = """(* ------------------------------------------------------------------ *)
(* W9: single-threaded cooperative fiber scheduler (Layer 3).          *)
(*                                                                     *)
(* Fibers are one-shot OCaml 5 continuations captured by the root      *)
(* Effect.Deep handler installed for every fiber. The scheduler loop   *)
(* outside the fibers decides what runs next; suspension is requested  *)
(* through private runtime effects (SchedYield/SchedAwait/WaitScope).  *)
(* Tasks are `Eff Nil a` thunks: their user effects are handled       *)
(* inside the fiber, and only the scheduler primitives cross fibers.   *)
(* ------------------------------------------------------------------ *)

type _ Effect.t +=
  | SchedYield : int Effect.t
  | SchedAwait : int -> int Effect.t
  | SchedWaitScope : int -> int Effect.t
  | SchedWaitScopeTimeout : int * int -> int Effect.t

type dtp_sched_step =
  | SchedStepYield of Obj.t
  | SchedStepAwait of int * Obj.t
  | SchedStepScope of int * Obj.t
  | SchedStepScopeTimeout of int * int * Obj.t
  | SchedStepDone of Obj.t
  | SchedStepFailed of exn * Printexc.raw_backtrace

type dtp_sched_wait = SchedWaitNone | SchedWaitTask of int | SchedWaitScope of int | SchedWaitTimed

type dtp_sched_state =
  | SchedQueued of Obj.t
  | SchedRunning
  | SchedSuspended
  | SchedDone of Obj.t
  | SchedFailed of exn * Printexc.raw_backtrace
  | SchedCancelled

type dtp_sched_task = {
  sched_tid : int;
  mutable sched_state : dtp_sched_state;
  mutable sched_start : (unit -> Obj.t) option;
  mutable sched_cont : Obj.t option;
  sched_scope : int;
  mutable sched_wait : dtp_sched_wait;
  mutable sched_waiters : int list;
  mutable sched_cancel : bool;
  mutable sched_grace : int;
}

type dtp_sched_scope = {
  sched_sid : int;
  mutable sched_tasks : int list;
  mutable sched_failed : string option;
  mutable sched_waiters : int list;
  mutable sched_timeout : bool;
  mutable sched_completed : int;
}

let dtp_sched_tasks : (int, dtp_sched_task) Hashtbl.t = Hashtbl.create 64
let dtp_sched_scopes : (int, dtp_sched_scope) Hashtbl.t = Hashtbl.create 16
let dtp_sched_ready : int Queue.t = Queue.create ()
let dtp_sched_next_task = ref 0
let dtp_sched_next_scope = ref 0
let dtp_sched_timeouts : (int * int * int) list ref = ref []
let dtp_sched_main_tid = ref 0
let dtp_sched_current = ref (-1)
let dtp_sched_main_result : Obj.t option ref = ref None
let dtp_sched_main_exn : (exn * Printexc.raw_backtrace) option ref = ref None
let dtp_sched_grace_steps = 64

let dtp_sched_reset () =
  Hashtbl.reset dtp_sched_tasks;
  Hashtbl.reset dtp_sched_scopes;
  dtp_cleanup_reset ();
  Queue.clear dtp_sched_ready;
  dtp_sched_next_task := 0;
  dtp_sched_next_scope := 0;
  dtp_sched_timeouts := [];
  dtp_sched_main_tid := 0;
  dtp_sched_current := -1;
  dtp_sched_main_result := None;
  dtp_sched_main_exn := None

let dtp_sched_task id =
  match Hashtbl.find_opt dtp_sched_tasks id with
  | Some t -> t
  | None -> failwith \"scheduler: invalid task handle\"

let dtp_sched_scope id =
  match Hashtbl.find_opt dtp_sched_scopes id with
  | Some s -> s
  | None -> failwith \"scheduler: invalid scope handle\"

let dtp_sched_exn_msg e =
  match e with
  | Effect.Unhandled (Perform (key, name, _)) ->
    Printf.sprintf \"unhandled effect %s (instance %s)\" key name
  | Failure m -> m
  | _ -> Printexc.to_string e

let dtp_sched_task_status t =
  if t.sched_cancel then 1
  else match t.sched_state with
    | SchedDone _ -> 0
    | SchedFailed _ -> 2
    | SchedCancelled -> 1
    | _ -> 0

let dtp_sched_enqueue t v =
  t.sched_state <- SchedQueued v;
  Queue.push t.sched_tid dtp_sched_ready

let dtp_sched_wake_scope s =
  if s.sched_tasks = [] && s.sched_waiters <> [] then begin
    let status =
      if s.sched_timeout then 2
      else if s.sched_failed <> None then 1
      else 0
    in
    let ws = s.sched_waiters in
    s.sched_waiters <- [];
    dtp_sched_timeouts := List.filter (fun (w, _, _) -> not (List.mem w ws)) !dtp_sched_timeouts;
    List.iter (fun wid ->
      let w = dtp_sched_task wid in
      w.sched_wait <- SchedWaitNone;
      dtp_sched_enqueue w (Obj.repr status)) ws
  end

let dtp_sched_finish t st =
  t.sched_state <- st;
  t.sched_wait <- SchedWaitNone;
  let ws = t.sched_waiters in
  t.sched_waiters <- [];
  let status = dtp_sched_task_status t in
  List.iter (fun wid ->
    let w = dtp_sched_task wid in
    w.sched_wait <- SchedWaitNone;
    dtp_sched_enqueue w (Obj.repr status)) ws;
  if t.sched_tid = !dtp_sched_main_tid then begin
    match st with
    | SchedDone v -> dtp_sched_main_result := Some v
    | SchedFailed (e, bt) -> dtp_sched_main_exn := Some (e, bt)
    | _ -> ()
  end;
  match Hashtbl.find_opt dtp_sched_scopes t.sched_scope with
  | Some s ->
    s.sched_tasks <- List.filter (fun x -> x <> t.sched_tid) s.sched_tasks;
    s.sched_completed <- s.sched_completed + 1;
    dtp_sched_wake_scope s
  | None -> ()

let dtp_sched_remove_waiter t =
  match t.sched_wait with
  | SchedWaitTask id ->
    let tg = dtp_sched_task id in
    tg.sched_waiters <- List.filter (fun x -> x <> t.sched_tid) tg.sched_waiters
  | SchedWaitScope id ->
    let s = dtp_sched_scope id in
    s.sched_waiters <- List.filter (fun x -> x <> t.sched_tid) s.sched_waiters
  | SchedWaitTimed | SchedWaitNone -> ()

let dtp_sched_cancel_task t =
  let terminal = match t.sched_state with
    | SchedDone _ | SchedFailed _ | SchedCancelled -> true
    | _ -> false
  in
  if t.sched_cancel || terminal then ()
  else begin
    t.sched_cancel <- true;
    match t.sched_state with
    | SchedQueued _ -> if t.sched_start <> None then dtp_sched_finish t SchedCancelled
      else t.sched_state <- SchedQueued (Obj.repr 1)
    | SchedSuspended ->
      let code = match t.sched_wait with
        | SchedWaitTask _ -> 1
        | SchedWaitScope _ | SchedWaitTimed -> 3
        | SchedWaitNone -> 1
      in
      dtp_sched_remove_waiter t;
      dtp_sched_timeouts := List.filter (fun (w, _, _) -> w <> t.sched_tid) !dtp_sched_timeouts;
      dtp_sched_enqueue t (Obj.repr code)
    | _ -> ()
  end

let dtp_sched_cancel_scope_tasks sid =
  let s = dtp_sched_scope sid in
  List.iter (fun id -> dtp_sched_cancel_task (dtp_sched_task id)) s.sched_tasks

let dtp_sched_effc (type a) (eff : a Effect.t)
  : ((a, Obj.t) Effect.Deep.continuation -> Obj.t) option =
  match eff with
  | SchedYield -> Some (fun k -> Obj.repr (SchedStepYield (Obj.repr k)))
  | SchedAwait id -> Some (fun k -> Obj.repr (SchedStepAwait (id, Obj.repr k)))
  | SchedWaitScope id -> Some (fun k -> Obj.repr (SchedStepScope (id, Obj.repr k)))
  | SchedWaitScopeTimeout (n, id) ->
    Some (fun k -> Obj.repr (SchedStepScopeTimeout (n, id, Obj.repr k)))
  | _ -> None

let dtp_sched_run_fresh t =
  let start = match t.sched_start with
    | Some f -> f
    | None -> failwith \"scheduler: no start thunk\" in
  t.sched_start <- None;
  let r = Effect.Deep.match_with
      (fun () -> start ())
      ()
      { retc = (fun x -> Obj.repr (SchedStepDone x));
        exnc = (fun e -> Obj.repr (SchedStepFailed (e, Printexc.get_raw_backtrace ())));
        effc = dtp_sched_effc } in
  (Obj.obj r : dtp_sched_step)

let dtp_sched_run_resume t v =
  let k = match t.sched_cont with
    | Some rep -> (Obj.magic rep : (Obj.t, Obj.t) Effect.Deep.continuation)
    | None -> failwith \"scheduler: no continuation\" in
  let r = Effect.Deep.continue k v in
  (Obj.obj r : dtp_sched_step)

let dtp_sched_new_task scope start =
  let id = !dtp_sched_next_task in
  dtp_sched_next_task := id + 1;
  let t = {
    sched_tid = id;
    sched_state = SchedQueued (Obj.repr 0);
    sched_start = Some start;
    sched_cont = None;
    sched_scope = scope;
    sched_wait = SchedWaitNone;
    sched_waiters = [];
    sched_cancel = false;
    sched_grace = dtp_sched_grace_steps;
  } in
  Hashtbl.replace dtp_sched_tasks id t;
  (match Hashtbl.find_opt dtp_sched_scopes scope with
   | Some s -> s.sched_tasks <- id :: s.sched_tasks
   | None -> ());
  Queue.push id dtp_sched_ready;
  t

let dtp_sched_new_scope () =
  let id = !dtp_sched_next_scope in
  dtp_sched_next_scope := id + 1;
  Hashtbl.replace dtp_sched_scopes id {
    sched_sid = id;
    sched_tasks = [];
    sched_failed = None;
    sched_waiters = [];
    sched_timeout = false;
    sched_completed = 0;
  };
  id

let dtp_sched_step t =
  if t.sched_cancel then t.sched_grace <- t.sched_grace - 1;
  if t.sched_cancel && t.sched_grace <= 0 then begin
    (* 硬中止：续延被丢弃，bracket 的库层 finally 不会跑；尽力执行未弹出的
       cleanup（它们只能做无效应/自包含的清理：挂起点之外没有 handler 栈）。 *)
    dtp_cleanup_run_all_for t.sched_tid;
    dtp_cleanup_forget t.sched_tid;
    dtp_sched_finish t SchedCancelled;
    None
  end
  else Some (match t.sched_start with
    | Some _ -> dtp_sched_run_fresh t
    | None -> match t.sched_state with
      | SchedQueued v -> t.sched_state <- SchedRunning; dtp_sched_run_resume t v
      | _ -> failwith \"scheduler: bad task state\")

let dtp_sched_apply t (st : dtp_sched_step) =
  match st with
  | SchedStepYield krep ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitNone;
    dtp_sched_enqueue t (Obj.repr (if t.sched_cancel then 1 else 0))
  | SchedStepAwait (id, krep) ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitTask id;
    t.sched_state <- SchedSuspended;
    let tg = dtp_sched_task id in
    tg.sched_waiters <- t.sched_tid :: tg.sched_waiters
  | SchedStepScope (id, krep) ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitScope id;
    t.sched_state <- SchedSuspended;
    let s = dtp_sched_scope id in
    s.sched_waiters <- t.sched_tid :: s.sched_waiters
  | SchedStepScopeTimeout (n, id, krep) ->
    t.sched_cont <- Some krep;
    t.sched_wait <- SchedWaitTimed;
    t.sched_state <- SchedSuspended;
    let s = dtp_sched_scope id in
    s.sched_waiters <- t.sched_tid :: s.sched_waiters;
    (* n 是「开始等待之后」的调度步预算：武装这次等待的那一步不算。 *)
    dtp_sched_timeouts := (t.sched_tid, id, n + 1) :: !dtp_sched_timeouts
  | SchedStepDone v ->
    (* 正常结束：bracket 已自行弹出；残留（异常边角）也一并清掉。 *)
    dtp_cleanup_run_all_for t.sched_tid;
    dtp_cleanup_forget t.sched_tid;
    dtp_sched_finish t (if t.sched_cancel then SchedCancelled else SchedDone v)
  | SchedStepFailed (e, bt) ->
    (* 异常穿过纤程根 handler：被丢弃的续延里的 bracket cleanup 在这里兜底。 *)
    dtp_cleanup_run_all_for t.sched_tid;
    dtp_cleanup_forget t.sched_tid;
    if t.sched_tid = !dtp_sched_main_tid then dtp_sched_finish t (SchedFailed (e, bt))
    else begin
      let s = dtp_sched_scope t.sched_scope in
      if s.sched_failed = None then s.sched_failed <- Some (dtp_sched_exn_msg e);
      dtp_sched_finish t (SchedFailed (e, bt));
      dtp_sched_cancel_scope_tasks t.sched_scope
    end

let dtp_sched_tick () =
  let expired = ref [] in
  dtp_sched_timeouts := List.map (fun (w, sc, n) -> (w, sc, n - 1)) !dtp_sched_timeouts;
  dtp_sched_timeouts := List.filter (fun (w, sc, n) ->
    if n > 0 then true else (expired := (w, sc) :: !expired; false)) !dtp_sched_timeouts;
  List.iter (fun (_, sc) ->
    let s = dtp_sched_scope sc in
    if not s.sched_timeout then begin
      s.sched_timeout <- true;
      dtp_sched_cancel_scope_tasks sc
    end) !expired

let dtp_sched_runnable t =
  match t.sched_state with SchedQueued _ -> true | _ -> false

let dtp_sched_run_one t =
  if dtp_sched_runnable t then begin
    dtp_sched_current := t.sched_tid;
    dtp_cleanup_fiber := t.sched_tid;
    (match dtp_sched_step t with
     | Some st -> dtp_sched_apply t st
     | None -> ());
    dtp_cleanup_fiber := -1;
    dtp_sched_current := -1
  end

let dtp_sched_deadlock () = failwith \"scheduler: deadlock (no runnable task)\"

let dtp_sched_loop () =
  let rec loop () =
    if !dtp_sched_main_result <> None || !dtp_sched_main_exn <> None then ()
    else if Queue.is_empty dtp_sched_ready then dtp_sched_deadlock ()
    else begin
      let tid = Queue.pop dtp_sched_ready in
      dtp_sched_run_one (dtp_sched_task tid);
      dtp_sched_tick ();
      loop ()
    end
  in loop ()

let dtp_sched_drain () =
  let rec loop () =
    if Queue.is_empty dtp_sched_ready then ()
    else begin
      let tid = Queue.pop dtp_sched_ready in
      dtp_sched_run_one (dtp_sched_task tid);
      loop ()
    end
  in loop ()

let dtp_sched_cancel_leftovers () =
  Hashtbl.iter (fun _ t -> match t.sched_state with
    | SchedDone _ | SchedFailed _ | SchedCancelled -> ()
    | _ -> dtp_sched_cancel_task t) dtp_sched_tasks

let dtp_sched_main (th : unit -> 'a) : 'a =
  dtp_sched_reset ();
  ignore (dtp_sched_new_scope ());
  let main = dtp_sched_new_task 0 (fun () -> Obj.repr (th ())) in
  dtp_sched_main_tid := main.sched_tid;
  (try dtp_sched_loop ()
   with e -> dtp_sched_cancel_leftovers (); dtp_sched_drain (); raise e);
  dtp_sched_cancel_leftovers ();
  dtp_sched_drain ();
  match !dtp_sched_main_exn with
  | Some (e, bt) -> Printexc.raise_with_backtrace e bt
  | None -> match !dtp_sched_main_result with
    | Some v -> (Obj.obj v : 'a)
    | None -> failwith \"scheduler: main did not finish\"

(* scheduler primitives exposed to Base.EffSched through hidden intrinsics *)

let dtp_sched_fork (scope : int) (f : int -> 'a) : int =
  (dtp_sched_new_task scope (fun () -> Obj.repr (f 0))).sched_tid

let dtp_sched_current_task () =
  if !dtp_sched_current < 0 then failwith \"scheduler: no current fiber\"
  else dtp_sched_task !dtp_sched_current

let dtp_sched_yield () : int = Effect.perform SchedYield

let dtp_sched_is_cancelled () : int =
  match Hashtbl.find_opt dtp_sched_tasks !dtp_sched_current with
  | Some t -> if t.sched_cancel then 1 else 0
  | None -> 0

let dtp_sched_await (id : int) : int =
  let self = dtp_sched_current_task () in
  if self.sched_cancel then begin ignore (Effect.perform SchedYield); 1 end
  else begin
    let target = dtp_sched_task id in
    match target.sched_state with
    | SchedDone _ | SchedFailed _ | SchedCancelled -> dtp_sched_task_status target
    | _ -> Effect.perform (SchedAwait id)
  end

let dtp_sched_task_result (id : int) : 'a =
  match (dtp_sched_task id).sched_state with
  | SchedDone v -> Obj.obj v
  | _ -> failwith \"scheduler: task has no result\"

let dtp_sched_task_error (id : int) : string =
  match (dtp_sched_task id).sched_state with
  | SchedFailed (e, _) -> dtp_sched_exn_msg e
  | _ -> \"\"

let dtp_sched_cancel_task_prim (id : int) : int =
  dtp_sched_cancel_task (dtp_sched_task id);
  0

let dtp_sched_cancel_scope (id : int) : int =
  dtp_sched_cancel_scope_tasks id;
  0

let dtp_sched_scope_status (s : dtp_sched_scope) : int =
  if s.sched_timeout then 2
  else if s.sched_failed <> None then 1
  else 0

let dtp_sched_scope_wait (id : int) : int =
  let s = dtp_sched_scope id in
  let self = dtp_sched_current_task () in
  if self.sched_cancel then begin ignore (Effect.perform SchedYield); 3 end
  else if s.sched_tasks = [] then dtp_sched_scope_status s
  else Effect.perform (SchedWaitScope id)

let dtp_sched_scope_wait_timeout (steps : int) (id : int) : int =
  let s = dtp_sched_scope id in
  let self = dtp_sched_current_task () in
  if self.sched_cancel then begin ignore (Effect.perform SchedYield); 3 end
  else if s.sched_tasks = [] then dtp_sched_scope_status s
  else if steps <= 0 then begin
    s.sched_timeout <- true;
    dtp_sched_cancel_scope_tasks id;
    Effect.perform (SchedWaitScope id)
  end else
    Effect.perform (SchedWaitScopeTimeout (steps, id))

let dtp_sched_scope_error (id : int) : string =
  let s = dtp_sched_scope id in
  match s.sched_failed with
  | Some msg -> msg
  | None -> \"\"

let dtp_sched_scope_count (id : int) : int =
  (dtp_sched_scope id).sched_completed
"""

-- M38：运行时错误报告器。位置表的键是 OCaml 值名（如 `v_main`）；回栈帧名形如
-- `Main.v_main`（跨单元调用）或 `Main.v_main.(fun)`（lambda 内联后）。报告器取帧名
-- 最后一个**非 `(fun)`** 的 '.' 分量查表，渲染成 `main (app/Main.vuna:12)`。
-- 命中帧最多打印 12 条，未命中帧（如 `Stdlib.failwith`）跳过。
dtReporterRuntime : String
dtReporterRuntime = """let rec dt_frame_key parts =
  match parts with
  | [] -> None
  | part :: rest -> if part = \"(fun)\" then dt_frame_key rest else Some part
let dt_frame_label slot =
  match Printexc.Slot.name slot with
  | None -> None
  | Some nm ->
    match dt_frame_key (List.rev (String.split_on_char '.' nm)) with
    | None -> None
    | Some key ->
      (match List.assoc_opt key dt_def_locs with
       | Some (display, loc) -> Some (display ^ \" (\" ^ loc ^ \")\")
       | None -> None)
let dt_report_exn e bt =
  let msg = match e with Effect.Unhandled (Perform (key, name, _)) -> Printf.sprintf \"unhandled effect %s (instance %s)\" key name | Failure m -> m | _ -> Printexc.to_string e in
  Printf.eprintf \"vuna: runtime error: %s\\n%!\" msg;
  match Printexc.backtrace_slots bt with
  | None -> ()
  | Some slots ->
    let rec go rest shown =
      if shown >= 12 then ()
      else match rest with
      | [] -> ()
      | slot :: tl ->
        (match dt_frame_label slot with
         | Some s -> Printf.eprintf \"  at %s\\n%!\" s; go tl (shown + 1)
         | None -> go tl shown)
    in go (Array.to_list slots) 0
"""

-- 定义位置表：OCaml 值名 → (vuna 定义名, 文件:行)。无 span 的定义跳过（axiom/生成项
-- 里没有来源的那些）；顺序严格按传入列表，生成是确定性的。`norm` 负责把 span 里的
-- 文件路径归一到模块根 / 包目录下（见 Codegen.Split）。
-- M34.6：旧实现 `row ++ dtDefLocTable norm rest` 是右嵌套 `++`，每层都重拷整段已累积
-- 文本（compiler 包 3086 行 ⇒ 约 430MB 拷贝、~365ms）；改为先 map 出行再一次性
-- `strConcatMany`（runtime `String.concat ""`，单遍分配），输出逐字节不变。
dtDefLocTable : (String -> String) -> List DtDef -> String
dtDefLocTable norm defs = strConcatMany (map (dtDefLocRow norm) defs)

dtDefLocRow : (String -> String) -> DtDef -> String
dtDefLocRow norm d = case dtDefSpan d of
  Nothing => ""
  Just sp =>
    "  (${ocamlString (valueName (dtDefName d))}, (${ocamlString (dtDefName d)}, ${ocamlString "${norm sp.spanFile}:${spanStartLine sp}"}));\n"

-- | 浮点 runtime helper（仅在程序使用 Float 时追加；见 `dtRuntimeWith`）。单独的文本块
-- 保证 no-float 程序的 `Vuna_runtime.ml` 与加 Float 之前逐字节一致（bootstrap/缓存）。
dtFloatRuntime : String
dtFloatRuntime = """let bi_add_float (a : float) (b : float) = a +. b
let bi_sub_float (a : float) (b : float) = a -. b
let bi_mul_float (a : float) (b : float) = a *. b
let bi_div_float (a : float) (b : float) = a /. b
let bi_eq_float (a : float) (b : float) = a = b
let bi_neq_float (a : float) (b : float) = a <> b
let bi_lt_float (a : float) (b : float) = a < b
let bi_le_float (a : float) (b : float) = a <= b
let bi_gt_float (a : float) (b : float) = a > b
let bi_ge_float (a : float) (b : float) = a >= b
"""

-- 运行时文本 = 既有常量部分（`dtRuntime`） + 注入的定义位置表 + 报告器。
-- `dt_def_locs` 必须定义在报告器之前（报告器读它）；空表写成 `[]`。
-- `usesFloat` 为 False 时输出与 Float 之前**逐字节一致**（旧 seed 固定点/缓存关键）。
dtRuntimeWith : String -> Bool -> String
dtRuntimeWith locs usesFloat =
  dtRuntime
    ++ (if usesFloat then dtFloatRuntime else "")
    ++ (if locs == "" then "let dt_def_locs = []\n" else "let dt_def_locs = [\n${locs}]\n")
    ++ dtReporterRuntime

-- M19：`==` / `/=` 的跨类型特化（精化期已按实参类型重写成 `bi_eq_int` / `bi_eq_str`
-- 这类名字），以及 str* 内建。codegen 只做名字映射、不感知类型——M18.6 的
-- M22.2：`strUnpack` / `strPack` 的运行时桥接。
-- Core 的 `strUnpack` 语义是「OCaml int list」，而 DT 路径里 `List` 是程序自己声明的
-- 归纳族（`Base.List.List` 在 OCaml 里是变体类型 `t_Base_dList_dList`）。这两个 helper
-- 按实际族名生成，把 int list ↔ 族构造子互转；`genGlobalRef` 把 `strUnpack`/`strPack`
-- 映射到它们（桥接只服务 Int 元素，与 prelude 签名 `List Int` 一致）。
dtListBridge : List DtData -> String
dtListBridge datas = case findListFamilyData datas of
  Nothing => ""
  Just dd => case findFamilyCtor (dtDataCtors dd) listNilCtor of
    Nothing => ""
    Just nilC => case findFamilyCtor (dtDataCtors dd) listConsCtor of
      Nothing => ""
      Just consC =>
        let
          famName = dtDataName dd
          nilMl = ctorOcamlName famName (dtCtorName nilC)
          consMl = ctorOcamlName famName (dtCtorName consC)
        in """

let dtp_unpack (s : string) =
  let cs = List.init (String.length s) (fun i -> Char.code s.[i]) in
  List.fold_right (fun x acc -> ${consMl} (x, acc)) cs ${nilMl}
let dtp_pack xs =
  let rec to_list xs = match xs with ${nilMl} -> [] | ${consMl} (x, rest) -> x :: to_list rest in
  let cs = Array.of_list (to_list xs) in
  String.init (Array.length cs) (fun i -> Char.chr cs.(i))

let dtp_listOf xs = List.fold_right (fun x acc -> ${consMl} (x, acc)) xs ${nilMl}
let dtp_ocamlOf xs =
  let rec go l = match l with ${nilMl} -> [] | ${consMl} (x, rest) -> x :: go rest in
  go xs

let dtp_concatMany xs = String.concat \"\" (dtp_ocamlOf xs)

let dtp_substTemplate tmpl xs =
  let args = Array.of_list (dtp_ocamlOf xs) in
  let n = String.length tmpl and na = Array.length args in
  let buf = Buffer.create (n + 32) in
  let rec go i =
    if i >= n then ()
    else if tmpl.[i] = '<' then begin
      let j = ref (i + 1) and k = ref 0 in
      while !j < n && tmpl.[!j] >= '0' && tmpl.[!j] <= '9' do
        k := !k * 10 + (Char.code tmpl.[!j] - 48); incr j
      done;
      if !j < n && tmpl.[!j] = '>' && !j > i + 1 then begin
        (if !k < na then Buffer.add_string buf args.(!k)
         else Buffer.add_string buf (String.sub tmpl i (!j - i + 1)));
        go (!j + 1)
      end else (Buffer.add_char buf '<'; go (i + 1))
    end else (Buffer.add_char buf tmpl.[i]; go (i + 1))
  in go 0; Buffer.contents buf
"""

findFamilyCtor : List DtCtor -> String -> Maybe DtCtor
findFamilyCtor [] name = Nothing
findFamilyCtor (c :: rest) name = if dtCtorName c == name then Just c else findFamilyCtor rest name

findListFamilyData : List DtData -> Maybe DtData
findListFamilyData [] = Nothing
findListFamilyData (d :: rest) =
  if dtDataName d == listFamilyName then Just d else findListFamilyData rest

-- 零参 user 构造子作为普通值引用时，OCaml 里就是裸构造子；只有 datas 表知道它是
-- 构造子，所以生成入口先查构造子表，再回落到 Intrinsics/值名。
genGlobalRef : GenSt -> String -> Check (Pair String GenSt)
genGlobalRef st name = if name == natZeroCtor then OkC (Pair "0" st)
else if name == natSuccCtor then OkC (Pair "bi_natSucc" st)
else case lookupPair name st.gsCtors of
  Just family =>
    let
      p = genCtorRef st family name
    in OkC (Pair (firstOf p) (secondOf p))
  Nothing => case findIntrinsic name of
    Just i => if name == primEffBind1Name then effLinearBindText st
    else if intrinsicReturnsEff i then effPrimText st name i
    else if needsListBridge i then if memName listFamilyName st.gsFamilies then
      let
        p = genBridgeRef st i.intrinsicRuntime
      in OkC (Pair (firstOf p) (secondOf p))
    else cgErr1 (ListBridgeRequired name) name
    else OkC (Pair i.intrinsicRuntime st)
    Nothing =>
      let
        p = genValueRef st name
      in OkC (Pair (firstOf p) (secondOf p))

-- Eff 原语：运行时仍是 eager 函数，但结果必须是装箱的 `MkEff`（Eff 是 base data）。
-- 生成 `MkEff (fun (_ : EffUnit) -> rt args)`；ctor 与 EffUnit 类型跨单元限定并记依赖。
effPrimText : GenSt -> String -> Intrinsic -> Check (Pair String GenSt)
effPrimText st name i =
  let
    rtPair =
      if needsListBridge i then genBridgeRef st i.intrinsicRuntime else Pair i.intrinsicRuntime st
    st1 = secondOf rtPair
    unitP = qualTypeText st1.gsQual effUnitTypeName
    st2 = gsAddDep st1 (secondOf unitP)
    ctorP = genCtorRef st2 effTypeName effMkCtor
    st3 = secondOf ctorP
  in OkC (Pair (effThunkText (firstOf ctorP) (firstOf unitP) (firstOf rtPair) (intrinsicArity i)) st3)

effThunkText : String -> String -> String -> Int -> String
effThunkText ctor unitTy rt arity =
  let
    argText = joinWith " " (takeNames arity ioParamNames)
  in if arity == 0 then "(${ctor} (fun (_ : ${unitTy}) -> ${rt}))"
  else "(fun ${argText} -> ${ctor} (fun (_ : ${unitTy}) -> ${rt} ${argText}))"

-- Eff 版线性绑定：装箱 Eff 的 match 实现（ST 的 bindST1 用）。
-- `(fun m k -> MkEff (fun u -> match m with MkEff f -> match k (f u) with MkEff g -> g u))`
effLinearBindText : GenSt -> Check (Pair String GenSt)
effLinearBindText st =
  let
    ctorP = genCtorRef st effTypeName effMkCtor
    st1 = secondOf ctorP
    unitP = qualTypeText st1.gsQual effUnitTypeName
    st2 = gsAddDep st1 (secondOf unitP)
    ctor = firstOf ctorP
    unitTy = firstOf unitP
  in OkC
    (Pair "(fun m k -> ${ctor} (fun (u : ${unitTy}) -> match m with ${ctor} f -> (match k (f u) with ${ctor} g -> g u)))" st2)

-- 原语最多 2 个运行时参数（`prim_eff_writeFile` / `prim_eff_runIn`）；表比实际用到的长，
-- `takeNames` 按 arity 截断（结构递归在表尾上，终止性检查可见）。
ioParamNames : List String
ioParamNames = ["dtio_0", "dtio_1", "dtio_2", "dtio_3"]

takeNames : Int -> List String -> List String
takeNames n names = if n <= 0 then []
else case names of
  [] => []
  name :: rest => name :: takeNames (n - 1) rest

-- 项 → OCaml
-- ---------------------------------------------------------------
--
-- 生成状态：族名表、构造子 → 族表、构造子形状表、fresh 变量计数，外加 C35 的
-- 跨单元限定上下文（`gsQual`）与已引用的依赖单元（`gsDeps`，生成期单调累积）。
-- binder 环境是「最近绑定在前」的 (OCaml 变量名, 是否擦除)，TVar 靠 index 解析。
-- M24.6：`gsCtorShapes` 是构造子字段形状的唯一真源，构造子应用与 case 分支都按它
-- 校验/生成（见 `ctorKeepFlags`）。D27 起再加一张 `gsCtorOpaques`：运行时不可命名的
-- 擦除依赖字段（`Obj.t`），构造子应用处要对该实参生成 `Obj.magic`。
record GenSt where
  gsFamilies : List String
  gsCtors : List (Pair String String)
  gsCtorShapes : List (Pair String (List Bool))
  gsCtorOpaques : List (Pair String (List Bool))
  gsUnboxed : List String
  -- R4：record 族 → 运行时字段（字段声明序号 → OCaml record label）。
  gsRecordFields : List (Pair String (List (Pair Int String)))
  gsNext : Int
  gsQual : QualCtx
  gsDeps : List String

-- | R3：记录投影在生成的 `case` 里使用的字段 binder 名（与 `Elab/Term/Impl` 一致）。
recordProjVar : Int -> String
recordProjVar i = "@vuna@record@proj${i}"

-- | R3：字段 telescope → `case` 绑定子（名字换成本地投影变量，rig 沿用字段）。
projBinders : List (Pair String Rig) -> Int -> List (Pair String Rig)
projBinders [] i = []
projBinders (b :: rest) i = Pair (recordProjVar i) (secondOf b) :: projBinders rest (i + 1)

-- 程序声明的族名表（`strUnpack` / `strPack` 的映射要看有没有 List 族）。
gsNext : GenSt -> Int
gsNext (GenSt families ctors shapes opaques unboxed recfields next qual deps) = next

gsPutNext : GenSt -> Int -> GenSt
gsPutNext (GenSt families ctors shapes opaques unboxed recfields next qual deps) n =
  GenSt families ctors shapes opaques unboxed recfields n qual deps

ctorTableOfData : DtData -> List (Pair String String)
ctorTableOfData d = map (\c => Pair (dtCtorName c) (dtCtorFamily c)) (dtDataCtors d)

ctorTableOf : List DtData -> List (Pair String String)
ctorTableOf [] = []
ctorTableOf (d :: rest) = append (ctorTableOfData d) (ctorTableOf rest)

mkGenSt : QualCtx -> List DtData -> GenSt
mkGenSt qc datas =
  GenSt (map dtDataName datas) (ctorTableOf datas) (ctorShapeOf datas) (ctorOpaqueTableOf datas)
    (unboxedFamilySet datas)
    (map (\d => Pair (dtDataName d) (recordRtFields d)) (filter hasRecordRepr (filter (\d => not (memName (dtDataName d) (unboxedFamilySet datas))) datas)))
    0 qc []

-- ---------------------------------------------------------------
-- C35：跨单元引用限定与依赖累积
-- ---------------------------------------------------------------
--
-- 每个单元只 `open Vuna_runtime`；值 / 构造子引用跨单元时渲染成 `Unit.name`，并把
-- 归属单元记进 `gsDeps`（同单元引用裸名、不计）。依赖清单只在**实际引用**时产生，
-- 因此分文件的编译依赖是精确 DAG，而不是「所有前序单元」的全序。
gsAddDep : GenSt -> String -> GenSt
gsAddDep st unit =
  if unit == "" || memName unit st.gsDeps then st
  else GenSt st.gsFamilies st.gsCtors st.gsCtorShapes st.gsCtorOpaques st.gsUnboxed st.gsRecordFields
    st.gsNext st.gsQual (unit :: st.gsDeps)

genValueRef : GenSt -> String -> Pair String GenSt
genValueRef st name =
  let
    p = qualValueText st.gsQual name
  in Pair (firstOf p) (gsAddDep st (secondOf p))

genCtorRef : GenSt -> String -> String -> Pair String GenSt
genCtorRef st family ctor =
  let
    p = qualCtorText st.gsQual family ctor
  in Pair (firstOf p) (gsAddDep st (secondOf p))

-- List 桥接 helper（`dtp_unpack` / `dtp_pack` / `dtp_listOf` / `dtp_ocamlOf` /
-- `dtp_concatMany` / `dtp_substTemplate`）由 `Codegen.Term.dtListBridge` 生成在
-- **声明 List 族的单元**里；其它单元引用这些 intrinsic runtime 文本时必须按该单元
-- 限定（C35），否则会依赖已删除的 open 链。表必须覆盖 `Intrinsics` 里所有
-- `needsListBridge` 的 runtime 文本引用到的 helper。
bridgeHelperNames : List String
bridgeHelperNames =
  ["dtp_unpack", "dtp_pack", "dtp_listOf", "dtp_ocamlOf", "dtp_concatMany", "dtp_substTemplate"]

bridgeUnitOf : GenSt -> String
bridgeUnitOf st = unitOfTbl st.gsQual.qcDatas listFamilyName

replaceAll : String -> String -> String -> String
replaceAll old new text = join new (split old text)

qualifyBridgeNames : String -> List String -> String -> String
qualifyBridgeNames unit [] text = text
qualifyBridgeNames unit (n :: rest) text =
  qualifyBridgeNames unit rest (replaceAll n "${unit}.${n}" text)

qualifyBridgeText : String -> String -> String
qualifyBridgeText unit text =
  if unit == "" then text else qualifyBridgeNames unit bridgeHelperNames text

-- (桥接文本, 依赖单元)
genBridgeRef : GenSt -> String -> Pair String GenSt
genBridgeRef st text =
  let
    unit = bridgeUnitOf st
  in Pair (qualifyBridgeText unit text) (gsAddDep st unit)

-- 运行时参数个数为 0 的定义（无 TLam 或只有擦除 TLam）。A05 后零参定义就是普通值
-- 绑定（`let v_x = body`，模块初始化时求值），这里只用于递归值守卫的判据。
runtimeArity : Term -> Int
runtimeArity (TLam n r b) = if rigIsErased r then runtimeArity b else 1 + runtimeArity b
runtimeArity _ = 0

-- case 分支的绑定环境：全部 telescope binder 都进环境（擦除的用占位名 + True），
-- 顺序为 telescope 表面顺序的逆序；pattern 只保留未擦除的 fresh 名。
record AltEnv where
  aeEnv : List (Pair String Rig)
  aePats : List String
  aeSt : GenSt

aeEnv : AltEnv -> List (Pair String Rig)
aeEnv (AltEnv env pats st) = env

aePats : AltEnv -> List String
aePats (AltEnv env pats st) = pats

aeSt : AltEnv -> GenSt
aeSt (AltEnv env pats st) = st

altEnvGo : GenSt -> List (Pair String Rig) -> List (Pair String Rig) -> List String -> AltEnv
altEnvGo st env [] pats = AltEnv env (reverse pats) st
altEnvGo st env ((Pair name rig) :: rest) pats = if rigIsErased rig then altEnvGo st (Pair "" Rig0 :: env) rest pats
else
  let
    fresh = gsNext st
    nm = "dtb__${fresh}"
  in altEnvGo (gsPutNext st (fresh + 1)) (Pair nm Rig1 :: env) rest (nm :: pats)

altEnv : GenSt -> List (Pair String Rig) -> List (Pair String Rig) -> AltEnv
altEnv st outer tele = altEnvGo st outer tele []

-- 构造子分支的绑定环境：按**构造子形状**（keep flags）决定哪些 telescope 位置进 pattern。
-- 与实参一样有两种合法约定：
--   1. **全 telescope**（普通 case：`caseAltBinders` 含擦除占位，body 的 de Bruijn index
--      按完整 telescope 数）；
--   2. **仅保留字段**（Elab 生成的字典投影分支：只绑方法字段，body index 按字段数）。
-- 按 binders 长度落在哪个口径选择，并逐位校验 rig 与形状一致。
altEnvChecked : GenSt -> String -> List (Pair String Rig) -> List (Pair String Rig) -> List Bool -> Check AltEnv
altEnvChecked st label outer binders flags =
  if length binders == length flags then altEnvFull st label outer binders flags []
  else if length binders == countKept flags then altEnvKept st label outer binders []
  else err
    "DT: internal: constructor ${label}: case branch binder count matches neither full telescope nor kept fields"

countKept : List Bool -> Int
countKept [] = 0
countKept (k :: rest) = if k then 1 + countKept rest else countKept rest

altEnvFull : GenSt -> String -> List (Pair String Rig) -> List (Pair String Rig) -> List Bool -> List String -> Check AltEnv
altEnvFull st label outer [] flags pats = case flags of
  [] => OkC (AltEnv outer (reverse pats) st)
  _ :: _ => icInternal "constructor ${label}: case branch has fewer binders than its shape"
altEnvFull st label outer ((Pair name rig) :: rest) flags pats = case flags of
  [] => icInternal "constructor ${label}: case branch has more binders than its shape"
  keep :: flags2 => if flagMatchesRig keep rig then if keep then
    let
      fresh = gsNext st
      nm = "dtb__${fresh}"
    in altEnvFull (gsPutNext st (fresh + 1)) label (Pair nm Rig1 :: outer) rest flags2 (nm :: pats)
  else altEnvFull st label (Pair "" Rig0 :: outer) rest flags2 pats
  else icInternal "constructor ${label}: case branch binder rig disagrees with its shape"

altEnvKept : GenSt -> String -> List (Pair String Rig) -> List (Pair String Rig) -> List String -> Check AltEnv
altEnvKept st label outer [] pats = OkC (AltEnv outer (reverse pats) st)
altEnvKept st label outer ((Pair name rig) :: rest) pats = if rigIsErased rig then icInternal "constructor ${label}: kept-field branch has an erased binder"
else
  let
    fresh = gsNext st
    nm = "dtb__${fresh}"
  in altEnvKept (gsPutNext st (fresh + 1)) label (Pair nm Rig1 :: outer) rest (nm :: pats)

-- | R4：把 `TRecord name args` 展开成等价 `TApp` 链（codegen 与改造前逐字节一致）。
recordTermAsApp : Term -> List (Pair Term Rig) -> Term
recordTermAsApp t [] = t
recordTermAsApp t ((Pair a rig) :: rest) = recordTermAsApp (TApp t a rig) rest

genTermFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> Check (Pair String GenSt)
genTermFuel fuel st binders t = if fuel <= 0 then icFuel "codegen"
else case t of
  TVar name i _ => case binderAt i binders of
    Just (Pair oc rig) =>
      if rigIsErased rig then cgErr1 (TypeLevelBindingRuntime name) name else OkC (Pair oc st)
    Nothing => icInternal "unbound runtime variable"
  TGlobal name => genGlobalRef st name
  TInt n => OkC (Pair (strFromInt n) st)
  TStr s => OkC (Pair (ocamlString s) st)
  TFloat raw => OkC (Pair raw st)
  TBool b => OkC (Pair (boolText b) st)
  TIf c th el => Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders c) (\pc => case pc of
    Pair gc st1 => Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st1 binders th) (\pt => case pt of
      Pair gt st2 => Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st2 binders el) (\pe => case pe of
        Pair ge st3 => OkC (Pair "(if ${gc} then ${gt} else ${ge})" st3)
      )
    )
  )
  TLam name rig body => genTermLamFuel (fuel - 1) st binders name rig body
  TApp f a rig => genAppFuel (fuel - 1) st binders f a rig
  TCon c args => genConAppFuel (fuel - 1) st binders c args
  TMk c args => genConAppFuel (fuel - 1) st binders c args
  -- R4：record 类型应用展开回 `TGlobal` 应用脊（产物与改造前逐字节一致）。
  TRecord name args => genTermFuel (fuel - 1) st binders (recordTermAsApp (TGlobal name) args)
  TCase scrut alts => genCaseFuel (fuel - 1) st binders scrut alts
  -- R4：record 族的更新/投影直接用 OCaml record 语法；非 record 仍按 case 形状展开。
  TRecUpd base c tele idxs body => case lookupPair c st.gsRecordFields of
    Just fields => genRecordUpdateFuel (fuel - 1) st binders base c tele fields idxs body
    Nothing => genTermFuel (fuel - 1) st binders (TCase base [CaseAlt c tele body])
  TProj base c tele i fi => case lookupPair c st.gsRecordFields of
    Just fields => case lookupRtLabel fi fields of
      Just label => Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders base) (\p => case p of
        Pair baseText st2 =>
          OkC (Pair "(${baseText}).${recordLabelOf st2 c label}" (gsDepOfFamily st2 c))
      )
      Nothing => genProjAsCaseFuel (fuel - 1) st binders base c tele i fi
    Nothing => genProjAsCaseFuel (fuel - 1) st binders base c tele i fi
  TPi name implicit rig dom cod => cgErr0 TypeUsedAtRuntime
  TType l => cgErr0 TypeUsedAtRuntime
  TMeta m => cgErr1 (UnsolvedMetavarRuntime (showMetaHint m)) (showMetaHint m)

-- M33 W2：多参数 lambda 链合并。
-- 旧实现每个 `TLam` 生成 `(fun x -> (fun y -> body))`；OCaml 把外层看成 arity-1 的
-- 函数，`f x y` 的每次递归调用都会**分配一个 partial-application 闭包**（arith 基准
-- 的 12x 主因，Gc 统计显示每轮约 40 字节分配）。这里把连续的 `TLam` 收成一条链，
-- 擦除 binder 只占 de Bruijn 位置、不作为 OCaml 参数，生成 `(fun x y -> body)`。
record LamChain where
  lamChainBinders : List (Pair String Rig)
  lamChainBody : Term

collectLamChain : Term -> LamChain
collectLamChain (TLam name rig body) = case collectLamChain body of
  LamChain rest inner => LamChain (Pair name rig :: rest) inner
collectLamChain t = LamChain [] t

lamParamPair : Pair String Rig -> Pair String Rig
lamParamPair (Pair name rig) =
  if rigIsErased rig then Pair "" Rig0 else Pair (ocamlBinderName name) Rig1

lamParamName : Pair String Rig -> List String
lamParamName (Pair name rig) = if rigIsErased rig then [] else [ocamlBinderName name]

genTermLamFuel : Int -> GenSt -> List (Pair String Rig) -> String -> Rig -> Term -> Check (Pair String GenSt)
genTermLamFuel fuel st binders name rig body = if fuel <= 0 then icFuel "codegen"
else case collectLamChain (TLam name rig body) of
  LamChain params inner =>
    let
      env = append (reverse (map lamParamPair params)) binders
      names = concatMap lamParamName params
    in Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st env inner) (\p => case p of
      Pair b st2 => case names of
        [] => OkC (Pair b st2)
        _ => OkC (Pair "(fun ${joinWith " " names} -> ${b})" st2)
    )

-- 应用：精化器可能把饱和的构造子应用表示成嵌套 `TApp (TApp (TCon c []) a) b`。
-- 这种形态必须先折叠成 `TCon c [a, b]`，否则 OCaml 侧会把它当成 curried 调用
-- （多变体构造子是 tupled 的，`C 1 2` 类型不对）。
genAppFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> Term -> Rig -> Check (Pair String GenSt)
genAppFuel fuel st binders f a rig = if fuel <= 0 then icFuel "codegen"
else if rigIsErased rig then genTermFuel (fuel - 1) st binders f
else case flattenConApp (TApp f a rig) of
  Just (Pair c args) => genConAppFuel (fuel - 1) st binders c args
  Nothing => genAppOptimizedFuel (fuel - 1) st binders (TApp f a rig)

-- ---------------------------------------------------------------
-- M33 W2：内建饱和应用的内联
-- ---------------------------------------------------------------
-- `bi_*` / 运算符的 runtime 是 Vuna_runtime.ml 里的顶层 OCaml 函数。产物按模块分离
-- 编译，非 flambda 的 ocamlopt **不做跨模块内联**，所以 `bi_add a b` / `bi_eq_int a b`
-- 每次算术 / 比较都是真实调用（arith 基准的首要大成本）。这里对**饱和应用**直接生成
-- OCaml 运算符表达式；部分应用 / 高阶引用仍回落到 runtime 函数（`genGlobalRef`）。
--
-- `++` 另外做链式展平：`a ++ b ++ c` 生成 `String.concat "" [a; b; c]`（>=3 个叶子），
-- 避免逐级 `^` 的 O(n²) 拷贝。只改生成文本，语义与 `bi_*` 一致。
inlineOpArity : String -> Int
inlineOpArity "+" = 2
inlineOpArity "-" = 2
inlineOpArity "*" = 2
inlineOpArity "/" = 2
inlineOpArity "&&" = 2
inlineOpArity "||" = 2
inlineOpArity "bi_bitAnd" = 2
inlineOpArity "bi_bitOr" = 2
inlineOpArity "bi_bitXor" = 2
inlineOpArity "bi_bitNot" = 1
inlineOpArity "++" = 2
inlineOpArity "bi_eq_int" = 2
inlineOpArity "bi_neq_int" = 2
inlineOpArity "bi_eq_str" = 2
inlineOpArity "bi_neq_str" = 2
inlineOpArity "bi_lt_int" = 2
inlineOpArity "bi_le_int" = 2
inlineOpArity "bi_gt_int" = 2
inlineOpArity "bi_ge_int" = 2
inlineOpArity "bi_lt_generic" = 2
inlineOpArity "bi_le_generic" = 2
inlineOpArity "bi_gt_generic" = 2
inlineOpArity "bi_ge_generic" = 2
inlineOpArity "bi_add_float" = 2
inlineOpArity "bi_sub_float" = 2
inlineOpArity "bi_mul_float" = 2
inlineOpArity "bi_div_float" = 2
inlineOpArity "bi_eq_float" = 2
inlineOpArity "bi_neq_float" = 2
inlineOpArity "bi_lt_float" = 2
inlineOpArity "bi_le_float" = 2
inlineOpArity "bi_gt_float" = 2
inlineOpArity "bi_ge_float" = 2
inlineOpArity "natToInt" = 1
inlineOpArity "natFromInt" = 1
inlineOpArity "natAdd" = 2
inlineOpArity "natSub" = 2
inlineOpArity "natMul" = 2
inlineOpArity "natDiv" = 2
inlineOpArity _ = 0

inlineText : String -> List String -> Maybe String
inlineText "+" ([a, b]) = Just "(${a} + ${b})"
inlineText "-" ([a, b]) = Just "(${a} - ${b})"
inlineText "*" ([a, b]) = Just "(${a} * ${b})"
inlineText "/" ([a, b]) = Just "(if ${b} = 0 then failwith \"division by zero\" else ${a} / ${b})"
inlineText "&&" ([a, b]) = Just "(${a} && ${b})"
inlineText "||" ([a, b]) = Just "(${a} || ${b})"
-- 位运算：与 / 或 / 异或 / 取反直接生成 OCaml 位运算符；移位保留 runtime helper
-- （计数越界返回 0 的语义只写一份）。63-bit 补码语义与 `bi_bit*` 一致。
inlineText "bi_bitAnd" ([a, b]) = Just "(${a} land ${b})"
inlineText "bi_bitOr" ([a, b]) = Just "(${a} lor ${b})"
inlineText "bi_bitXor" ([a, b]) = Just "(${a} lxor ${b})"
inlineText "bi_bitNot" ([a]) = Just "(lnot ${a})"
inlineText "++" ([a, b]) = Just "(${a} ^ ${b})"
inlineText "bi_eq_int" ([a, b]) = Just "(${a} = ${b})"
inlineText "bi_neq_int" ([a, b]) = Just "(${a} <> ${b})"
inlineText "bi_eq_str" ([a, b]) = Just "(${a} = ${b})"
inlineText "bi_neq_str" ([a, b]) = Just "(${a} <> ${b})"
inlineText "bi_lt_int" ([a, b]) = Just "(${a} < ${b})"
inlineText "bi_le_int" ([a, b]) = Just "(${a} <= ${b})"
inlineText "bi_gt_int" ([a, b]) = Just "(${a} > ${b})"
inlineText "bi_ge_int" ([a, b]) = Just "(${a} >= ${b})"
inlineText "bi_lt_generic" ([a, b]) = Just "(${a} < ${b})"
inlineText "bi_le_generic" ([a, b]) = Just "(${a} <= ${b})"
inlineText "bi_gt_generic" ([a, b]) = Just "(${a} > ${b})"
inlineText "bi_ge_generic" ([a, b]) = Just "(${a} >= ${b})"
-- Float：算术/比较直接内联到 OCaml 浮点运算符（除零按 IEEE 语义，不失败）。
inlineText "bi_add_float" ([a, b]) = Just "(${a} +. ${b})"
inlineText "bi_sub_float" ([a, b]) = Just "(${a} -. ${b})"
inlineText "bi_mul_float" ([a, b]) = Just "(${a} *. ${b})"
inlineText "bi_div_float" ([a, b]) = Just "(${a} /. ${b})"
inlineText "bi_eq_float" ([a, b]) = Just "(${a} = ${b})"
inlineText "bi_neq_float" ([a, b]) = Just "(${a} <> ${b})"
inlineText "bi_lt_float" ([a, b]) = Just "(${a} < ${b})"
inlineText "bi_le_float" ([a, b]) = Just "(${a} <= ${b})"
inlineText "bi_gt_float" ([a, b]) = Just "(${a} > ${b})"
inlineText "bi_ge_float" ([a, b]) = Just "(${a} >= ${b})"
-- Nat 转换恒等/单分支，直接内联；算术用 runtime helper（饱和/截断逻辑只写一份）。
inlineText "natToInt" ([a]) = Just a
inlineText "natFromInt" ([a]) = Just "(bi_natFromInt ${a})"
inlineText "natAdd" ([a, b]) = Just "(bi_natAdd ${a} ${b})"
inlineText "natSub" ([a, b]) = Just "(bi_natSub ${a} ${b})"
inlineText "natMul" ([a, b]) = Just "(bi_natMul ${a} ${b})"
inlineText "natDiv" ([a, b]) = Just "(bi_natDiv ${a} ${b})"
inlineText _ _ = Nothing

inlineArityMatches : String -> List (Pair Term Rig) -> Bool
inlineArityMatches name args =
  if inlineOpArity name <= 0 then False else length args == inlineOpArity name

-- `f a1 ... an` 的 head 是内建、且每个实参都未擦除时，收集 (名字, 实参)（左→右）。
flattenIntrinsicApp : Term -> Maybe (Pair String (List (Pair Term Rig)))
flattenIntrinsicApp (TApp f a rig) = if rigIsErased rig then Nothing
else case f of
  TGlobal name => if inlineOpArity name > 0 then Just (Pair name [Pair a rig]) else Nothing
  _ => case flattenIntrinsicApp f of
    Just (Pair name args) => Just (Pair name (append args [Pair a rig]))
    Nothing => Nothing
flattenIntrinsicApp _ = Nothing

-- `++` 应用树展平成叶子列表（右结合 / 左结合都吃）；非 `++` 根返回 Nothing。
flattenConcatChain : Term -> Maybe (List Term)
flattenConcatChain (TApp (TApp head l rl) r rr) = if rigIsErased rl || rigIsErased rr then Nothing
else case head of
  TGlobal g => if g == "++" then Just (append (concatLeaves l) (concatLeaves r)) else Nothing
  _ => Nothing
flattenConcatChain _ = Nothing

concatLeaves : Term -> List Term
concatLeaves (TApp (TApp head l rl) r rr) = if rigIsErased rl || rigIsErased rr then [TApp (TApp head l rl) r rr]
else case head of
  TGlobal g =>
    if g == "++" then append (concatLeaves l) (concatLeaves r) else [TApp (TApp head l rl) r rr]
  _ => [TApp (TApp head l rl) r rr]
concatLeaves t = [t]

genAppOptimizedFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> Check (Pair String GenSt)
genAppOptimizedFuel fuel st binders t = if fuel <= 0 then icFuel "codegen"
else case flattenConcatChain t of
  Just parts =>
    if length parts >= 3 then genConcatPartsFuel (fuel - 1) st binders parts
    else genPlainAppFuel fuel st binders t
  Nothing => genPlainAppFuel fuel st binders t

genPlainAppFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> Check (Pair String GenSt)
genPlainAppFuel fuel st binders t = if fuel <= 0 then icFuel "codegen"
else case t of
  TApp f a rig => case flattenIntrinsicApp t of
    Just (Pair name args) =>
      if inlineArityMatches name args then genInlineAppFuel (fuel - 1) st binders name args
      else genPlainAppFallback (fuel - 1) st binders f a rig
    Nothing => genPlainAppFallback (fuel - 1) st binders f a rig
  _ => icInternal "genPlainAppFuel expects an application"

genPlainAppFallback : Int -> GenSt -> List (Pair String Rig) -> Term -> Term -> Rig -> Check (Pair String GenSt)
genPlainAppFallback fuel st binders f a rig = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders f) (\pf => case pf of
  Pair fs st1 => Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st1 binders a) (\pa => case pa of
    Pair at st2 => OkC (Pair "(${fs} ${at})" st2)
  )
)

genInlineAppFuel : Int -> GenSt -> List (Pair String Rig) -> String -> List (Pair Term Rig) -> Check (Pair String GenSt)
genInlineAppFuel fuel st binders name args = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genInlineArgsFuel (fuel - 1) st binders args) (\p => case p of
  Pair texts st2 => case inlineText name texts of
    Just text => OkC (Pair text st2)
    Nothing => icInternal "no inline text for builtin `${name}`"
)

genInlineArgsFuel : Int -> GenSt -> List (Pair String Rig) -> List (Pair Term Rig) -> Check (Pair (List String) GenSt)
genInlineArgsFuel fuel st binders [] = if fuel <= 0 then icFuel "codegen" else OkC (Pair [] st)
genInlineArgsFuel fuel st binders ((Pair arg rig) :: rest) = if fuel <= 0 then icFuel "codegen"
else if rigIsErased rig then icInternal "erased argument in inlined builtin application"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders arg) (\p => case p of
  Pair text st2 => Vuna.Compiler.Common.bind (genInlineArgsFuel (fuel - 1) st2 binders rest) (\q => case q of
    Pair texts st3 => OkC (Pair (Base.List.Cons text texts) st3)
  )
)

genConcatPartsFuel : Int -> GenSt -> List (Pair String Rig) -> List Term -> Check (Pair String GenSt)
genConcatPartsFuel fuel st binders parts = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genConcatPartTexts (fuel - 1) st binders parts) (\p => case p of
  Pair texts st2 => OkC (Pair "(String.concat \"\" [${joinWith "; " texts}])" st2)
)

genConcatPartTexts : Int -> GenSt -> List (Pair String Rig) -> List Term -> Check (Pair (List String) GenSt)
genConcatPartTexts fuel st binders [] = if fuel <= 0 then icFuel "codegen" else OkC (Pair [] st)
genConcatPartTexts fuel st binders (t :: rest) = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders t) (\p => case p of
  Pair text st2 => Vuna.Compiler.Common.bind (genConcatPartTexts (fuel - 1) st2 binders rest) (\q => case q of
    Pair texts st3 => OkC (Pair (Base.List.Cons text texts) st3)
  )
)

-- OCaml 的多参变体构造子是 **tupled**（`C of t1 * t2` 写作 `C (a, b)`），
-- 不是 curried，所以多实参必须用逗号包成一个元组。
conAppText : String -> List String -> String
conAppText name [] = name
conAppText name ([a]) = "(${name} (${a}))"
conAppText name args = "(${name} (${joinWith ", " args}))"

-- 构造子实参对齐（M24.6 第一级）：TCon 的实参有两种合法约定：
--   1. **全 telescope**（含擦除位，普通构造子经 `inferArgs` 插入隐式后如此）；
--   2. **仅保留字段**（字典构造子 `MkDict_C` 只带方法实现，省略擦除的类参数）。
-- 两种都按 shape 归一成「运行时实参列表」（全部非擦除），供 `genConArgs` 生成。
alignCtorArgs : String -> List Bool -> List (Pair Term Rig) -> Check (List (Pair Term Rig))
alignCtorArgs label [] [] = OkC []
alignCtorArgs label [] (_ :: _) =
  icInternal "constructor ${label}: application has more arguments than its shape"
alignCtorArgs label (keep :: flags) [] =
  if keep then icInternal "constructor ${label}: application has fewer arguments than its shape"
  else alignCtorArgs label flags []
alignCtorArgs label (keep :: flags) ((Pair arg rig) :: rest) =
  if keep then if rigIsErased rig then icInternal "constructor ${label}: runtime field marked erased"
  else Vuna.Compiler.Common.bind (alignCtorArgs label flags rest)
    (\ts => OkC (Base.List.Cons (Pair arg rig) ts))
  else if rigIsErased rig then alignCtorArgs label flags rest
  else alignCtorArgs label flags (Pair arg rig :: rest)

genConArgsFuel : Int -> GenSt -> List (Pair String Rig) -> List Bool -> List (Pair Term Rig) -> Check (Pair (List String) GenSt)
genConArgsFuel fuel st binders opqs [] = if fuel <= 0 then icFuel "codegen" else OkC (Pair [] st)
genConArgsFuel fuel st binders [] (_ :: _) =
  icInternal "constructor opaque flags shorter than runtime arguments"
genConArgsFuel fuel st binders (opq :: opqs) ((Pair arg rig) :: rest) = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders arg) (\p => case p of
  Pair text st2 => Vuna.Compiler.Common.bind (genConArgsFuel (fuel - 1) st2 binders opqs rest) (\q => case q of
    Pair texts st3 => OkC (Pair (Base.List.Cons (ctorArgText opq text) texts) st3)
  )
)

-- 运行时不可命名的擦除依赖字段：声明侧是 `Obj.t`，实参在这里做表现层转换。
ctorArgText : Bool -> String -> String
ctorArgText True text = "(Obj.magic ${text})"
ctorArgText False text = text

-- Nat 构造子链的常量折叠：字面量在 Elab 里展开成 Zero/Succ 链，codegen 折回整数。
natChainNext : Int -> Int
natChainNext n = if n >= 4611686018427387903 then 4611686018427387903 else n + 1

natChainValue : Term -> Maybe Int
natChainValue (TCon c args) = if c == natZeroCtor then case args of
  [] => Just 0
  _ => Nothing
else if c == natSuccCtor then case args of
  [Pair a _] => case natChainValue a of
    Just n => Just (natChainNext n)
    Nothing => Nothing
  _ => Nothing
else Nothing
natChainValue _ = Nothing

genConAppFuel : Int -> GenSt -> List (Pair String Rig) -> String -> List (Pair Term Rig) -> Check (Pair String GenSt)
genConAppFuel fuel st binders c args = if fuel <= 0 then icFuel "codegen"
else case natChainValue (TCon c args) of
  Just n => OkC (Pair (strFromInt n) st)
  Nothing => genConAppNonChainFuel fuel st binders c args

genConAppNonChainFuel : Int -> GenSt -> List (Pair String Rig) -> String -> List (Pair Term Rig) -> Check (Pair String GenSt)
genConAppNonChainFuel fuel st binders c args = if fuel <= 0 then icFuel "codegen"
else if c == natZeroCtor then case alignCtorArgs c [] args of
  ErrC e => ErrC e
  OkC runtimeArgs => case runtimeArgs of
    [] => OkC (Pair "0" st)
    _ => icInternal "Nat Zero applied to arguments"
else if c == natSuccCtor then case alignCtorArgs c [True] args of
  ErrC e => ErrC e
  OkC runtimeArgs => Vuna.Compiler.Common.bind (genConArgsFuel (fuel - 1) st binders [False] runtimeArgs) (\p => case p of
    Pair texts st2 => case texts of
      argText :: rest => case rest of
        [] => OkC (Pair "(bi_natSucc ${argText})" st2)
        _ => icInternal "Nat Succ must have exactly one runtime argument"
      [] => icInternal "Nat Succ must have exactly one runtime argument"
  )
else case lookupPair c st.gsCtors of
  Nothing => icInternal "unknown constructor ${c}"
  Just family => case lookupPair c st.gsCtorShapes of
    Nothing => icInternal "no shape for constructor ${c}"
    Just flags => case lookupPair c st.gsCtorOpaques of
      Nothing => icInternal "no opaque shape for constructor ${c}"
      Just opqs => Vuna.Compiler.Common.bind (alignCtorArgs c flags args) (\runtimeArgs => Vuna.Compiler.Common.bind (genConArgsFuel (fuel - 1) st binders (ctorOpaqueKeptFlags flags opqs) runtimeArgs) (\p => case p of
        Pair argTexts st2 => genConAppFinish st2 family c flags opqs argTexts
      )
      )

-- R4：record 族的 OCaml record 文本（构造 / 模式 / 更新共用）。
-- | R4：record 字段 label 的跨单元限定文本。
-- | R4：按 record 族归属单元记依赖（同单元不记，否则 split 会出现自依环）。
gsDepOfFamily : GenSt -> String -> GenSt
gsDepOfFamily st family =
  let
    unit = unitOfTbl st.gsQual.qcDatas family
  in if unit == "" || unit == st.gsQual.qcUnit then st else gsAddDep st unit

-- | R4：record OCaml 表示的 codegen helper。
recordLabelOf : GenSt -> String -> String -> String
recordLabelOf st family label =
  let
    unit = unitOfTbl st.gsQual.qcDatas family
  in if unit == "" || unit == st.gsQual.qcUnit then label else "${unit}.${label}"

-- | R4：构造 `{ f = a; ... }`（字段表与运行时实参按序对齐）。
recordConText : GenSt -> String -> List (Pair Int String) -> List String -> String
recordConText st family fields texts =
  "{ ${joinWith "; " (recordAssigned st family fields texts)} }"

-- | R4：record OCaml 表示的 codegen helper。
recordAssigned : GenSt -> String -> List (Pair Int String) -> List String -> List String
recordAssigned st family [] texts = []
recordAssigned st family fields [] = []
recordAssigned st family (f :: fs) (t :: ts) =
  "${recordLabelOf st family (secondOf f)} = ${t}" :: recordAssigned st family fs ts

-- | R4：record 模式 `{ f = p; ... }`。
recordPatText : GenSt -> String -> List (Pair Int String) -> List String -> String
recordPatText st family fields pats = "{ ${joinWith "; " (recordAssigned st family fields pats)} }"

-- | R4：运行时字段表里按**字段声明序号**找 OCaml label。
lookupRtLabel : Int -> List (Pair Int String) -> Maybe String
lookupRtLabel fi [] = Nothing
lookupRtLabel fi ((Pair i label) :: rest) = if i == fi then Just label else lookupRtLabel fi rest

-- | R4：字段声明序号在运行时字段表里的位置（用于对齐 record 更新实参）。
lookupRtPos : Int -> List (Pair Int String) -> Int -> Maybe Int
lookupRtPos fi [] n = Nothing
lookupRtPos fi ((Pair i label) :: rest) n = if i == fi then Just n else lookupRtPos fi rest (n + 1)

-- | R4：record OCaml 表示的 codegen helper。
lookupRtPositions : List (Pair Int String) -> List Int -> List (Pair Int Int)
lookupRtPositions fields [] = []
lookupRtPositions fields (i :: rest) = case lookupRtPos i fields 0 of
  Just pos => Pair i pos :: lookupRtPositions fields rest
  Nothing => lookupRtPositions fields rest

nthTextOr : Int -> List String -> String
nthTextOr n [] = ""
nthTextOr n (x :: rest) = if n <= 0 then x else nthTextOr (n - 1) rest

-- | R4：record 更新文本 `{ base with f_a = v; ... }`（只取被改字段）。
recordUpdateTextOf : GenSt -> String -> String -> List (Pair Int String) -> List (Pair Int Int) -> List String -> String
recordUpdateTextOf st baseText family fields positions texts =
  "{ ${baseText} with ${joinWith "; " (updateAssigned st family fields positions texts)} }"

-- | R4：record OCaml 表示的 codegen helper。
updateAssigned : GenSt -> String -> List (Pair Int String) -> List (Pair Int Int) -> List String -> List String
updateAssigned st family fields [] texts = []
updateAssigned st family fields positions [] = []
updateAssigned st family fields (p :: rest) (t :: ts) = case lookupRtLabel (firstOf p) fields of
  Just label => "${recordLabelOf st family label} = ${t}" :: updateAssigned st family fields rest ts
  Nothing => updateAssigned st family fields rest ts

-- | R4：record 更新 codegen：base 文本 + 重建体（`TCon`）的运行时实参 → record update 语法。
genRecordUpdateFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> String -> List (Pair String Rig) -> List (Pair Int String) -> List Int -> Term -> Check (Pair String GenSt)
genRecordUpdateFuel fuel st binders base c tele fields idxs body = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders base) (\p => case p of
  Pair baseText st1 => case body of
    TMk c2 args =>
      genRecordUpdateArgsFuel (fuel - 1) st1 (recordAltBinders tele binders) baseText c fields idxs
        args
    TCon c2 args =>
      genRecordUpdateArgsFuel (fuel - 1) st1 (recordAltBinders tele binders) baseText c fields idxs
        args
    _ => icInternal "record update body is not a constructor application"
)

-- | R4：把 record 字段 binder 补进 codegen binder 栈（被改值在 alt 上下文里精化，
-- 其 de Bruijn index 含这些槽位；旧字段 binder 在本路径不生成，故标成 erased 占位）。
recordAltBinders : List (Pair String Rig) -> List (Pair String Rig) -> List (Pair String Rig)
recordAltBinders tele binders = append (reverse (map (\b => Pair (firstOf b) Rig0) tele)) binders

-- | R4：record 更新的实参处理：只生成**被改字段**的实参文本（其余字段由 record update
-- 语法沿用 base，旧 binder 在当前上下文里并不存在）。
genRecordUpdateArgsFuel : Int -> GenSt -> List (Pair String Rig) -> String -> String -> List (Pair Int String) -> List Int -> List (Pair Term Rig) -> Check (Pair String GenSt)
genRecordUpdateArgsFuel fuel st binders baseText c fields idxs args = if fuel <= 0 then icFuel "codegen"
else case lookupPair c st.gsCtorShapes of
  Nothing => icInternal "no shape for constructor ${c}"
  Just flags => case lookupPair c st.gsCtorOpaques of
    Nothing => icInternal "no opaque shape for constructor ${c}"
    Just opqs => Vuna.Compiler.Common.bind (alignCtorArgs c flags args) (\runtimeArgs => let
      positions = lookupRtPositions fields idxs
    in Vuna.Compiler.Common.bind (genUpdTextsFuel (fuel - 1) st binders (ctorOpaqueKeptFlags flags opqs) positions runtimeArgs) (\q => case q of
      Pair texts st2 =>
        OkC (Pair (recordUpdateTextOf st2 baseText c fields positions texts) (gsDepOfFamily st2 c))
    )
    )

-- | R4：按 (字段序号, 运行时实参位置) 取实参并生成文本（只覆盖被改字段）。
genUpdTextsFuel : Int -> GenSt -> List (Pair String Rig) -> List Bool -> List (Pair Int Int) -> List (Pair Term Rig) -> Check (Pair (List String) GenSt)
genUpdTextsFuel fuel st binders opqs [] args =
  if fuel <= 0 then icFuel "codegen" else OkC (Pair [] st)
genUpdTextsFuel fuel st binders opqs (p :: rest) args = if fuel <= 0 then icFuel "codegen"
else case nthOpqArg (secondOf p) opqs args of
  Nothing => icInternal "record update position out of range"
  Just arg => Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders arg) (\q => case q of
    Pair text st2 => Vuna.Compiler.Common.bind (genUpdTextsFuel (fuel - 1) st2 binders opqs rest args) (\r => case r of
      Pair texts st3 => OkC (Pair (Base.List.Cons text texts) st3)
    )
  )

-- | R4：record OCaml 表示的 codegen helper。
nthOpqArg : Int -> List Bool -> List (Pair Term Rig) -> Maybe Term
nthOpqArg n [] args = Nothing
nthOpqArg n (opq :: opqs) [] = Nothing
nthOpqArg n (opq :: opqs) ((Pair a rig) :: rest) =
  if n <= 0 then Just a else nthOpqArg (n - 1) opqs rest

-- | 非 record 的投影仍按原 `case` 形状展开。
genProjAsCaseFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> String -> List (Pair String Rig) -> Int -> Int -> Check (Pair String GenSt)
genProjAsCaseFuel fuel st binders base c tele i fi =
  let
    n = length tele
  in genTermFuel fuel st binders
    (TCase base [CaseAlt c (projBinders tele 0) (TVar (recordProjVar fi) (n - 1 - fi) (Span "" 0 0 0 0))])

-- | 构造子应用的收尾：去装箱族转交 `genUnboxedConAppFinish`；record 族生成 OCaml record；
-- 其余按族取 OCaml 构造子引用并拼上实参文本。
genConAppFinish : GenSt -> String -> String -> List Bool -> List Bool -> List String -> Check (Pair String GenSt)
genConAppFinish st family c flags opqs argTexts = if memName family st.gsUnboxed then genUnboxedConAppFinish st flags opqs argTexts
else case lookupPair family st.gsRecordFields of
  Just fields => OkC (Pair (recordConText st family fields argTexts) (gsDepOfFamily st family))
  Nothing =>
    let
      r = genCtorRef st family c
    in OkC (Pair (conAppText (firstOf r) argTexts) (secondOf r))

-- | 去装箱构造子的应用收尾：要求恰好一个运行时实参，按构造子的 opaque 标志把实参
-- 包成 `ctorArgText`（不需要 OCaml 变体构造）。
genUnboxedConAppFinish : GenSt -> List Bool -> List Bool -> List String -> Check (Pair String GenSt)
genUnboxedConAppFinish st flags opqs [] =
  icInternal "unboxed constructor application has no runtime argument"
genUnboxedConAppFinish st flags opqs (text :: rest) = case rest of
  [] => case ctorOpaqueKeptFlags flags opqs of
    opq :: more => case more of
      [] => OkC (Pair (ctorArgText opq text) st)
      _ => icInternal "unboxed constructor has more than one opaque flag"
    [] => icInternal "unboxed constructor has no opaque flag"
  _ => icInternal "unboxed constructor application has more than one runtime argument"

hasFallbackAlt : List CaseAlt -> Bool
hasFallbackAlt [] = False
hasFallbackAlt (alt :: rest) = caseAltName alt == "" || hasFallbackAlt rest

armPatternText : String -> List String -> String
armPatternText cname [] = cname
armPatternText cname pats = "${cname} (${joinWith ", " pats})"

-- 去装箱族的 case：单构造子 + 单运行时字段，等价于 `let` 绑定字段。
-- | 若整个 case 可降级成 `let`，返回它的首分支：首分支构造子已知且属去装箱族，
-- 其余分支全是 catch-all（去装箱族只有一个构造子）。
unboxedCaseAlt : GenSt -> List CaseAlt -> Maybe CaseAlt
unboxedCaseAlt st [] = Nothing
unboxedCaseAlt st (alt :: rest) = case caseAltName alt of
  "" => Nothing
  name => case lookupPair name st.gsCtors of
    Just family =>
      if memName family st.gsUnboxed then if allCatchAll rest then Just alt else Nothing
      else Nothing
    Nothing => Nothing

-- unboxed 族只有一个构造子：构造子分支之后的 catch-all 分支不可达，可安全丢弃。
-- | 分支列表是否全部是 catch-all（无构造子名）；空列表视为真。
allCatchAll : List CaseAlt -> Bool
allCatchAll [] = True
allCatchAll (alt :: rest) = if caseAltName alt == "" then allCatchAll rest else False

-- | 去装箱 case 的降级入口：取出分支的构造子名后交给 `genUnboxedCaseByName`。
genUnboxedCaseFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> CaseAlt -> Check (Pair String GenSt)
genUnboxedCaseFuel fuel st outer scrut alt = if fuel <= 0 then icFuel "codegen"
else case caseAltName alt of
  "" => icInternal "unboxed case arm has no constructor"
  name => genUnboxedCaseByName (fuel - 1) st outer name scrut alt

-- | 查构造子的运行时字段形状（keep/opaque 标志），再转交 `genUnboxedCaseWithFlags`。
genUnboxedCaseByName : Int -> GenSt -> List (Pair String Rig) -> String -> Term -> CaseAlt -> Check (Pair String GenSt)
genUnboxedCaseByName fuel st outer name scrut alt = if fuel <= 0 then icFuel "codegen"
else case lookupPair name st.gsCtorShapes of
  Nothing => icInternal "no shape for constructor ${name}"
  Just flags => genUnboxedCaseWithFlags (fuel - 1) st outer name scrut alt flags

-- | 先生成 scrutinee 的 OCaml 文本，再带着它转交 `genUnboxedCaseWithScrut`。
genUnboxedCaseWithFlags : Int -> GenSt -> List (Pair String Rig) -> String -> Term -> CaseAlt -> List Bool -> Check (Pair String GenSt)
genUnboxedCaseWithFlags fuel st outer name scrut alt flags = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st outer scrut) (\p => case p of
  Pair scrutText st1 => genUnboxedCaseWithScrut (fuel - 1) st1 outer name alt flags scrutText
)

-- | 按构造子的字段标志为分支 binder 建 AltEnv（擦除字段丢弃），再生成分支体
-- 并组装成 `let`。
genUnboxedCaseWithScrut : Int -> GenSt -> List (Pair String Rig) -> String -> CaseAlt -> List Bool -> String -> Check (Pair String GenSt)
genUnboxedCaseWithScrut fuel st outer name alt flags scrutText =
  if fuel <= 0 then icFuel "codegen"
  else Vuna.Compiler.Common.bind (altEnvChecked st name outer (caseAltBinders alt) flags)
    (\bound => genUnboxedCaseWithBound (fuel - 1) st name alt bound scrutText)

-- | 在已绑定的 AltEnv 下生成分支体文本，交给 `unboxedCaseLet` 拼成 `let` 表达式。
genUnboxedCaseWithBound : Int -> GenSt -> String -> CaseAlt -> AltEnv -> String -> Check (Pair String GenSt)
genUnboxedCaseWithBound fuel st name alt bound scrutText = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
  Pair bodyText st2 => unboxedCaseLet scrutText bound bodyText st2
)

-- | 把分支体包成 `let <binder> = <scrut> in <body>`；无运行时 binder 时用 `_`。
unboxedCaseLet : String -> AltEnv -> String -> GenSt -> Check (Pair String GenSt)
unboxedCaseLet scrutText bound bodyText st2 = case aePats bound of
  [] => OkC (Pair "(let _ = ${scrutText} in ${bodyText})" st2)
  pat :: rest => case rest of
    [] => OkC (Pair "(let ${pat} = ${scrutText} in ${bodyText})" st2)
    _ => icInternal "unboxed case arm has more than one runtime binder"

genArmFuel : Int -> GenSt -> List (Pair String Rig) -> CaseAlt -> Check (Pair String GenSt)
genArmFuel fuel st outer alt = if fuel <= 0 then icFuel "codegen"
else if caseAltName alt == "" then
  let
    bound = altEnv st outer (caseAltBinders alt)
    patText = case aePats bound of
      [] => "_"
      p :: rest => p
  in Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
    Pair b st2 => OkC (Pair "  | ${patText} -> ${b}\n" st2)
  )
else case lookupPair (caseAltName alt) st.gsCtors of
  Nothing => icInternal "unknown constructor ${caseAltName alt}"
  Just family => case lookupPair (caseAltName alt) st.gsCtorShapes of
    Nothing => icInternal "no shape for constructor ${caseAltName alt}"
    Just flags => Vuna.Compiler.Common.bind (altEnvChecked st (caseAltName alt) outer (caseAltBinders alt) flags) (\bound => Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
      Pair b st2 => case lookupPair family st2.gsRecordFields of
        Just fields =>
          OkC
            (Pair "  | ${recordPatText st2 family fields (aePats bound)} -> ${b}\n" (gsDepOfFamily st2 family))
        Nothing =>
          let
            r = genCtorRef st2 family (caseAltName alt)
            patText = armPatternText (firstOf r) (aePats bound)
          in OkC (Pair "  | ${patText} -> ${b}\n" (secondOf r))
    )
    )

genArmsFuel : Int -> GenSt -> List (Pair String Rig) -> List CaseAlt -> Check (Pair String GenSt)
genArmsFuel fuel st binders [] = if fuel <= 0 then icFuel "codegen" else OkC (Pair "" st)
genArmsFuel fuel st binders (alt :: rest) = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genArmFuel (fuel - 1) st binders alt) (\p => case p of
  Pair arm st2 => Vuna.Compiler.Common.bind (genArmsFuel (fuel - 1) st2 binders rest) (\q => case q of
    Pair arms st3 => OkC (Pair (arm ++ arms) st3)
  )
)

-- ---------------------------------------------------------------
-- Nat case 降级：Nat 运行时是 int，不能生成变体 match。
-- 只处理规范形（分支全是 Nat 构造子；嵌套模式已由 Elab.Match 降级成嵌套 case）。
-- ---------------------------------------------------------------
isNatCtorName : String -> Bool
isNatCtorName name = name == natZeroCtor || name == natSuccCtor

natCaseApplies : List CaseAlt -> Bool
natCaseApplies [] = False
natCaseApplies alts = natCaseAllCtors alts && natCaseHasCtor alts

natCaseAllCtors : List CaseAlt -> Bool
natCaseAllCtors [] = True
natCaseAllCtors (alt :: rest) = case caseAltName alt of
  "" => natCaseAllCtors rest
  name => isNatCtorName name && natCaseAllCtors rest

natCaseHasCtor : List CaseAlt -> Bool
natCaseHasCtor [] = False
natCaseHasCtor (alt :: rest) = case caseAltName alt of
  "" => natCaseHasCtor rest
  _ => True

findAltBy : String -> List CaseAlt -> Maybe CaseAlt
findAltBy name [] = Nothing
findAltBy name (alt :: rest) = if caseAltName alt == name then Just alt else findAltBy name rest

findCatchAllAlt : List CaseAlt -> Maybe CaseAlt
findCatchAllAlt [] = Nothing
findCatchAllAlt (alt :: rest) = if caseAltName alt == "" then Just alt else findCatchAllAlt rest

-- Nat 分支体：按其 telescope binder 生成；Succ 的唯一 binder 绑定到 (sc - 1)，
-- 兜底变量绑定到 sc。bindExpr = Nothing 表示该分支不应有保留 binder（Zero）。
genNatAltBodyFuel : Int -> GenSt -> List (Pair String Rig) -> CaseAlt -> Maybe String -> Check (Pair String GenSt)
genNatAltBodyFuel fuel st outer alt bindExpr = if fuel <= 0 then icFuel "codegen"
else
  let
    bound = altEnv st outer (caseAltBinders alt)
  in Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
    Pair body st2 => case aePats bound of
      [] => OkC (Pair body st2)
      nm :: rest => case rest of
        [] => case bindExpr of
          Just expr => OkC (Pair "(let ${nm} = ${expr} in ${body})" st2)
          Nothing => icInternal "Nat case arm has a binder but no runtime binding"
        _ => icInternal "Nat case arm has more than one runtime binder"
  )

genNatCaseFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> List CaseAlt -> Check (Pair String GenSt)
genNatCaseFuel fuel st binders scrut alts = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders scrut) (\p => case p of
  Pair scrutText st1 =>
    let
      fresh = gsNext st1
      sc = "dtnat__${fresh}"
      st2 = gsPutNext st1 (fresh + 1)
      zeroAlt = findAltBy natZeroCtor alts
      succAlt = findAltBy natSuccCtor alts
      catchAlt = findCatchAllAlt alts
      predExpr = "(${sc} - 1)"
    in natCaseBranchesFuel (fuel - 1) st2 binders zeroAlt succAlt catchAlt sc scrutText predExpr
)

-- 组装：true/else 两支取 Zero/Succ；缺的一支用兜底（绑定 scrutinee）或 failwith。
natCaseBranchesFuel : Int -> GenSt -> List (Pair String Rig) -> Maybe CaseAlt -> Maybe CaseAlt -> Maybe CaseAlt -> String -> String -> String -> Check (Pair String GenSt)
natCaseBranchesFuel fuel st binders zeroAlt succAlt catchAlt sc scrutText predExpr = if fuel <= 0 then icFuel "codegen"
else
  let
    impossible = "(failwith \"DT: impossible branch\")"
  in Vuna.Compiler.Common.bind (natAltTextFuel (fuel - 1) st binders zeroAlt Nothing) (\pz => case pz of
    Pair zeroText st1 => Vuna.Compiler.Common.bind (natAltTextFuel (fuel - 1) st1 binders succAlt (Just predExpr)) (\ps => case ps of
      Pair succText st2 => Vuna.Compiler.Common.bind (natAltTextFuel (fuel - 1) st2 binders catchAlt (Just sc)) (\pc => case pc of
        Pair catchText st3 =>
          let
            trueText = case zeroAlt of
              Just _ => zeroText
              Nothing => case catchAlt of
                Just _ => catchText
                Nothing => impossible
            falseText = case succAlt of
              Just _ => succText
              Nothing => case catchAlt of
                Just _ => catchText
                Nothing => impossible
          in OkC
            (Pair "(let ${sc} = ${scrutText} in (if ${sc} = 0 then ${trueText} else ${falseText}))" st3)
      )
    )
  )

natAltTextFuel : Int -> GenSt -> List (Pair String Rig) -> Maybe CaseAlt -> Maybe String -> Check (Pair String GenSt)
natAltTextFuel fuel st binders Nothing bindExpr = OkC (Pair "" st)
natAltTextFuel fuel st binders (Just a) bindExpr = genNatAltBodyFuel fuel st binders a bindExpr

genCaseFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> List CaseAlt -> Check (Pair String GenSt)
genCaseFuel fuel st binders scrut alts = if fuel <= 0 then icFuel "codegen"
else if natCaseApplies alts then genNatCaseFuel (fuel - 1) st binders scrut alts
else case unboxedCaseAlt st alts of
  Just alt => genUnboxedCaseFuel (fuel - 1) st binders scrut alt
  Nothing => genGenericCaseFuel (fuel - 1) st binders scrut alts

-- | 通用 case 降级：生成 scrutinee 与各分支的 `match` 臂；没有 catch-all 时补一条
-- `| _ -> failwith` 兜底，保证 OCaml match 完整。
genGenericCaseFuel : Int -> GenSt -> List (Pair String Rig) -> Term -> List CaseAlt -> Check (Pair String GenSt)
genGenericCaseFuel fuel st binders scrut alts = if fuel <= 0 then icFuel "codegen"
else Vuna.Compiler.Common.bind (genTermFuel (fuel - 1) st binders scrut) (\p => case p of
  Pair scrutText st1 => Vuna.Compiler.Common.bind (genArmsFuel (fuel - 1) st1 binders alts) (\q => case q of
    Pair arms st2 =>
      let
        fallback =
          if hasFallbackAlt alts then "" else "  | _ -> failwith \"DT: impossible branch\"\n"
      in OkC (Pair "(match ${scrutText} with\n${arms}${fallback})" st2)
  )
)

-- ---------------------------------------------------------------
-- 分组 → OCaml 定义
-- ---------------------------------------------------------------
-- M29（A14）：定义级 CG 错误带来源位置（`DtDef` 的 `Maybe Span` + 定义名）。
-- `genTerm` 内部的错误（TypeUsedAtRuntime / TypeLevelBindingRuntime / TypeLevelNameRuntime /
-- UnsolvedMetavarRuntime / ListBridgeRequired / 构造子 arity 内部错等）都在这里统一收口，
-- 生成定义（trait 投影 / instance 字典 / deriving）因此能指回 trait/instance/data 声明行。
-- M38：split 的入口单元名（= `sanitizeName "Main"`，见 `Codegen.Split.entryOwner`）。
-- 只在生成期用于识别「main 的零参值绑定」这一个特例。
mainUnitName : String
mainUnitName = "Main"

-- M38：入口单元里 `main` 的零参值绑定在**模块初始化期**求值，发生在 main 钩子的
-- try 之前，钩子捕不到；这里给它套同一个报告器。动作 main 的求值由钩子完成（`v_main 0`，
-- 在 try 内），不套；`let rec` 的右值不允许 try（OCaml 限制），
-- isRec 时一律跳过；lambda（含擦除 lambda 剥完之后的函数）也不套——try 会破坏尾调。
mainInitWrap : GenSt -> Bool -> String -> Term -> Bool
mainInitWrap st isRec name body =
  if isRec then False
  else if st.gsQual.qcUnit == mainUnitName && name == "main" && runtimeArity body == 0 then True
  else False

genGroupDef : GenSt -> Bool -> DtDef -> Check (Pair String GenSt)
genGroupDef st isRec d = case dtDefExtern d of
  -- M33 W5：受限 FFI → OCaml `external`；C 符号名由 `ffi/*.c` 提供（build.sh 编译链接）。
  Just cName => case genExternTy (dtDefType d) of
    ErrC e => ErrC (withContext (dtDefSpan d) (dtDefName d) e)
    OkC tyText =>
      OkC (Pair "external ${valueName (dtDefName d)} : ${tyText} = ${ocamlString cName}" st)
  Nothing => case dtDefBody d of
    Just body => case genTerm st [] body of
      ErrC e => ErrC (withContext (dtDefSpan d) (dtDefName d) e)
      OkC (Pair bodyText st2) =>
        let
          finalText =
            if mainInitWrap st isRec (dtDefName d) body then "(try ${bodyText} with e -> dt_report_exn e (Printexc.get_raw_backtrace ()); exit 2)"
            else bodyText
        in OkC (Pair "${valueName (dtDefName d)} = ${finalText}" st2)
    Nothing =>
      ErrC
        (withContext (dtDefSpan d) (dtDefName d) (diagNoLoc SevError PhInternal CatInternal "IC_AxiomRuntime" "axiom reached runtime code generation (partition must erase it)"))

-- extern 的类型 → OCaml 类型文本（Int/String/Bool/Array 基本类型；Elab 已限制形状，
-- 这里再护栏一次，fuel 递减保证终止）。
genExternTy : Term -> Check String
genExternTy ty = externTyText 64 0 (eval [] ty)

externTyText : Int -> Int -> Value -> Check String
externTyText fuel lvl (VPi name implicit _ dom clo) =
  if fuel <= 0 then icInternal "extern type is too deep"
  else if implicit then icInternal "extern has an implicit parameter"
  else Vuna.Compiler.Common.bind (externDomText dom)
    (\domText => Vuna.Compiler.Common.bind (externTyText (fuel - 1) (lvl + 1) (applyClosure clo (VNeutral (NVar name lvl [])))) (\resText => OkC "(${domText}) -> ${resText}"))
externTyText fuel lvl v =
  if fuel <= 0 then icInternal "extern type is too deep" else externDomText v

externDomText : Value -> Check String
externDomText (VNeutral (NGlobal "Array" ([elem]))) =
  Vuna.Compiler.Common.bind (externBasicText elem) (\e => OkC "(${e} array)")
externDomText (VNeutral (NGlobal "Array" _)) = icInternal "extern Array needs one type argument"
externDomText v = externBasicText v

externBasicText : Value -> Check String
externBasicText (VNeutral (NGlobal g args)) =
  if g == intTypeName then OkC "int"
  else if g == strTypeName then OkC "string"
  else if g == boolTypeName then OkC "bool" else icInternal "extern type is not basic: ${g}"
externBasicText (VNeutral _) = icInternal "extern type is not a global type"
externBasicText _ = icInternal "extern type is not basic"

genGroupBodies : GenSt -> Bool -> List DtDef -> Check (Pair (List String) GenSt)
genGroupBodies st isRec [] = OkC (Pair [] st)
genGroupBodies st isRec (d :: rest) = Vuna.Compiler.Common.bind (genGroupDef st isRec d) (\p => case p of
  Pair def st2 => Vuna.Compiler.Common.bind (genGroupBodies st2 isRec rest) (\q => case q of
    Pair defs st3 => OkC (Pair (Base.List.Cons def defs) st3)
  )
)

-- 单函数 SCC 且不引用自身时用 let；多函数 SCC（互递归）或自递归才用 let rec。
groupNeedsRec : HashMap String (List String) -> List DtDef -> Bool
groupNeedsRec adjT [] = False
groupNeedsRec adjT ([d]) = memName (dtDefName d) (neighborsOf adjT (dtDefName d))
groupNeedsRec adjT group = True

-- A05：零运行时参数的定义现在是普通值绑定（`let v_x = body`，模块初始化时求值），
-- 而 OCaml 的 `let rec` 只接受函数或构造子应用作右值。递归组里出现其它形态的零参
-- 定义时，环无法安全落地，必须在生成前报 `CG_RecursiveValueDefinition`（带定义名）。
-- 擦除 lambda 会在生成时消失，所以先剥掉再判定「真正落盘的右值形状」。
recursiveValueAllowed : Term -> Bool
recursiveValueAllowed (TLam n rig b) = if rigIsErased rig then recursiveValueAllowed b else True
recursiveValueAllowed (TCon c args) = True
recursiveValueAllowed _ = False

firstBadRecursiveValue : List DtDef -> Maybe String
firstBadRecursiveValue [] = Nothing
firstBadRecursiveValue (d :: rest) = case dtDefBody d of
  -- 只在运行时分组里调用：axiom 无体、不进运行时分组。
  Nothing => Nothing
  Just body =>
    if runtimeArity body == 0 then if recursiveValueAllowed body then firstBadRecursiveValue rest else Just (dtDefName d)
    else firstBadRecursiveValue rest

genGroup : HashMap String (List String) -> GenSt -> List DtDef -> Check (Pair String GenSt)
genGroup adj st group = if groupNeedsRec adj group then case firstBadRecursiveValue group of
  -- M29（A14）：带来源位置（组里按名字找回定义）。
  Just name => case findDtDef name group of
    Just d => cgErrDefAt (dtDefSpan d) name (RecursiveValueDefinition name) [name]
    Nothing => cgErr1 (RecursiveValueDefinition name) name
  Nothing => genGroupLet st group True
else genGroupLet st group False

genGroupLet : GenSt -> List DtDef -> Bool -> Check (Pair String GenSt)
genGroupLet st group isRec = Vuna.Compiler.Common.bind (genGroupBodies st isRec group) (\p => case p of
  Pair defs st2 => case group of
    -- M33 W5：单个 extern 定义直接生成 `external ...`（不能加 `let` 前缀）。
    [d] => case dtDefExtern d of
      Just _ => OkC (Pair (joinWith "\n" defs) st2)
      Nothing => OkC (Pair ((if isRec then "let rec " else "let ") ++ joinWith "\nand " defs) st2)
    _ => OkC (Pair ((if isRec then "let rec " else "let ") ++ joinWith "\nand " defs) st2)
)

genGroups : HashMap String (List String) -> GenSt -> List (List DtDef) -> Check (Pair (List String) GenSt)
genGroups adj st [] = OkC (Pair [] st)
genGroups adj st (g :: rest) = Vuna.Compiler.Common.bind (genGroup adj st g) (\p => case p of
  Pair text st2 => Vuna.Compiler.Common.bind (genGroups adj st2 rest) (\q => case q of
    Pair texts st3 => OkC (Pair (Base.List.Cons text texts) st3)
  )
)

-- main 的展示方式：内建类型用 runtime 展示函数；其它类型用 Elab 收尾合成的
-- `@vuna@main_show : T -> String`（D17，见 `Elab.Driver.synthMainShow`）。
-- 按 canonical 符号识别：Int / String / Float 是 primitive 类型，Bool / Nat 是 base 的 data。
mainShow : List (Pair String Term) -> Term -> Check (Pair String String)
mainShow table tyTerm = case force (Base.HashMap.fromList table) solsEmpty defaultFuel (eval [] tyTerm) of
  VNeutral n => case n of
    NGlobal g [] => mainShowForName g
    _ => mainShowSynth
  _ => mainShowSynth

-- 拆 main 的动作层：返回 ('eff', 内层类型)。
-- Eff 只接受行已经是 Nil 的入口（Elab 的入口检查保证；这里再判一次形态）。
actionResultTy : Term -> Maybe (Pair String Term)
actionResultTy (TApp (TApp fn row _) arg _) = case fn of
  TGlobal g =>
    if g == effTypeName then if isNilRowTermCodegen row then Just (Pair "eff" arg) else Nothing
    else Nothing
  _ => Nothing
actionResultTy _ = Nothing

-- | codegen 侧判 `Base.Eff.Row.Nil`（与 Elab 的 isNilRowTerm 同形）。
isNilRowTermCodegen : Term -> Bool
isNilRowTermCodegen (TGlobal g) = g == effRowNilCtor
isNilRowTermCodegen (TCon g []) = g == effRowNilCtor
isNilRowTermCodegen _ = False

mainShowForName : String -> Check (Pair String String)
mainShowForName g =
  if g == intTypeName then OkC (Pair "string_of_int" "int")
  else if g == natTypeName then OkC (Pair "string_of_int" "int")
  else if g == strTypeName then OkC (Pair "dt_show_string" "string")
  else if g == floatTypeName then OkC (Pair "string_of_float" "float")
  else if g == boolTypeName then OkC (Pair "dt_show_bool" "bool") else mainShowSynth

-- 非内建类型：Elab 已保证合成定义存在（缺 `Show T` 在精化期报 TC 诊断）。
mainShowSynth : Check (Pair String String)
mainShowSynth = OkC (Pair (valueName mainShowDefName) "show")

-- main 钩子：`mainExpr` 是运行时求 main 值的表达式（普通 main 直接是 `v_main`；
-- main : Eff [] a 则是 `v_main 0`），按类型 `tyTerm` 选展示函数。
-- M38：动作整体包进 `try`——未捕获异常交给运行时报告器（dt_report_exn）打印
-- "vuna: runtime error: ..." + 命中的 vuna 位置帧，然后 exit 2（不再是 OCaml 的
-- Fatal error 形态）。try 只包 main 这一处，不碰 lambda，尾调不受影响。
genDtHook : String -> List (Pair String Term) -> Term -> String -> Bool -> Check String
genDtHook bodyText table tyTerm mainExpr printResult = Vuna.Compiler.Common.bind (mainShow table tyTerm) (\showPair => case showPair of
  Pair showFn kind =>
    let
      action =
        if printResult then "print_endline (${showFn} (${mainExpr}))" else "ignore (${mainExpr})"
      hook = """let () =
  Printexc.record_backtrace true;
  try ${action}
  with e -> dt_report_exn e (Printexc.get_raw_backtrace ()); exit 2
"""
    in OkC "${bodyText}\n${hook}"
)

-- 动作 main 的执行表达式：
-- W9：main 动作作为纤程 0 交给调度器（`dtp_sched_main`）：这样 main 里的
-- `yieldNow`/`awaitTask` 也能挂起；没有任务的普通程序只是多一层 match_with。
actionRunText : QualCtx -> Pair (List DtData) (List DtDef) -> String -> String -> Pair String String
actionRunText qc program mainRef kind = if kind == "eff" then
  let
    runRef = qualValueText qc effRunName
  in Pair "dtp_sched_main (fun () -> ${firstOf runRef} ${mainRef})" (secondOf runRef)
else Pair "dtp_sched_main (fun () -> ${mainRef} 0)" ""

genTerm : GenSt -> List (Pair String Rig) -> Term -> Check (Pair String GenSt)
genTerm a1 a2 a3 = genTermFuel 512 a1 a2 a3

genTermLam : GenSt -> List (Pair String Rig) -> String -> Rig -> Term -> Check (Pair String GenSt)
genTermLam a1 a2 a3 a4 a5 = genTermLamFuel 512 a1 a2 a3 a4 a5

genApp : GenSt -> List (Pair String Rig) -> Term -> Term -> Rig -> Check (Pair String GenSt)
genApp a1 a2 a3 a4 a5 = genAppFuel 512 a1 a2 a3 a4 a5

genConApp : GenSt -> List (Pair String Rig) -> String -> List (Pair Term Rig) -> Check (Pair String GenSt)
genConApp a1 a2 a3 a4 = genConAppFuel 512 a1 a2 a3 a4

genConArgs : GenSt -> List (Pair String Rig) -> List Bool -> List (Pair Term Rig) -> Check (Pair (List String) GenSt)
genConArgs a1 a2 a3 a4 = genConArgsFuel 512 a1 a2 a3 a4

genArm : GenSt -> List (Pair String Rig) -> CaseAlt -> Check (Pair String GenSt)
genArm a1 a2 a3 = genArmFuel 512 a1 a2 a3

genArms : GenSt -> List (Pair String Rig) -> List CaseAlt -> Check (Pair String GenSt)
genArms a1 a2 a3 = genArmsFuel 512 a1 a2 a3

genCase : GenSt -> List (Pair String Rig) -> Term -> List CaseAlt -> Check (Pair String GenSt)
genCase a1 a2 a3 a4 = genCaseFuel 512 a1 a2 a3 a4
