module Vuna.Compiler.Codegen.Split (generateDtSplitProgram, generateDtSplitProgramWith) where

-- Vuna.Compiler.Codegen.Split：逐模块 split 生成（`compile` / `build` / `seed` 的唯一输出模型）。
--
-- 把同一份精化结果按「声明归属」切到各模块文件。C35 后每个单元只 `open Vuna_runtime`，
-- 跨单元引用（值 / 构造子 / 类型）由 `Codegen.Decl` / `Codegen.Term` 生成
-- `Unit.name` 全限定名；每个 `SplitFile` 因此带一张**直接依赖单元**表（实际引用到的
-- 单元，由 `Codegen.Assembly.UnitParts` 累积），文件顺序仍是拓扑序但编译不再依赖
-- open 链 —— 依赖图是精确 DAG，可分层/并行编译。
-- 装配（prepare / 类型 / 桥接 / 正文 / main 钩子）全部由 `Codegen.Assembly` 提供，
-- 本模块只做「归属表 + 按归属过滤 + 分文件 + 依赖序校验」。
--
-- 归属表**只从 Loader-resolved 的声明结构派生**（声明名、实例名、派生实例名、trait
-- 方法投影名与 `Dict_<trait>`）；不再有字符串前缀表（`Show_Show_*` / 内建方法名表）。
-- 推导不到的带点名字回落到「模块前缀必须是已知模块」，否则报错。
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Driver.Owner
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Elab
import Vuna.Compiler.Codegen.Assembly
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Codegen.Erase
import Vuna.Compiler.Codegen.Term
import Vuna.Compiler.Core
import Vuna.Compiler.Intrinsics

splitUnitOfModule : String -> String
splitUnitOfModule modName = sanitizeName modName

-- M38：入口单元在定义求值**之前**就开启回栈记录（零参 `main` 在模块初始化期求值，
-- 早于 main 钩子的 try；初始化异常靠当时已开启的回栈打印 vuna 位置帧）。
mainInitPrologue : String
mainInitPrologue = "let () = Printexc.record_backtrace true\n"

-- ---------------------------------------------------------------
-- 按归属过滤 + 生成
-- ---------------------------------------------------------------
-- 名字 → 归属单元的哈希索引。旧实现对**每个**模块把全部 def/data 逐个做
-- `mapOwnerOf`（线性扫 pairs）⇒ O(#模块 × #def × #pairs)，大包上就是几秒。
ownerTblOf : List (Pair String String) -> HashMap String String
ownerTblOf pairs = Base.HashMap.insertAll pairs (Base.HashMap.fromList [])

ownerOfTbl : HashMap String String -> String -> String
ownerOfTbl t name = case Base.HashMap.lookup name t of
  Just o => o
  Nothing => ""

datasInUnit : HashMap String String -> String -> List DtData -> List DtData
datasInUnit ownerT u datas = filter (\d => ownerOfTbl ownerT (dtDataName d) == u) datas

defsInUnit : HashMap String String -> String -> List DtDef -> List DtDef
defsInUnit ownerT u defs = filter (\d => ownerOfTbl ownerT (dtDefName d) == u) defs

-- ---------------------------------------------------------------
-- 依赖序（C35）：每单元的直接依赖必须全部落在更早的模块里。
-- 生成器累积的依赖来自**实际引用**（`QualCtx` 限定 / 类型声明 / List 桥接 / main
-- 钩子），所以这里只需校验拓扑序并按编译顺序排列（build.sh 的分层吃这份顺序）。
-- ---------------------------------------------------------------
-- 位置以 1 起算，0 = 不在表里（vuna 没有负整数字面量，不用 -1 哨兵）。
posOfName : String -> List String -> Int
posOfName name units = posOfNameGo 1 name units

posOfNameGo : Int -> String -> List String -> Int
posOfNameGo i name [] = 0
posOfNameGo i name (u :: rest) = if u == name then i else posOfNameGo (i + 1) name rest

checkDepsOrder : List String -> String -> List String -> Check Int
checkDepsOrder ordered self [] = OkC 0
checkDepsOrder ordered self (d :: rest) =
  let
    selfPos = posOfName self ordered
    depPos = posOfName d ordered
  in if depPos == 0 then icInternal "${self} references unknown unit `${d}`"
  else if selfPos == 0 then icInternal "split unit `${self}` is not in the module order"
  else if depPos >= selfPos then icInternal "split dependency is not in topological order: ${self} -> ${d}"
  else checkDepsOrder ordered self rest

depsInOrder : List String -> String -> List String -> List String
depsInOrder ordered self deps = filter (\u => not (u == self) && memName u deps) ordered

unitDepsOf : List String -> String -> List String -> Check (List String)
unitDepsOf ordered self deps =
  Vuna.Compiler.Common.bind (checkDepsOrder ordered self deps)
    (\_ => OkC (depsInOrder ordered self deps))

-- 分文件生成的共享上下文（归属表一次建好，所有单元复用）。
record SplitGenCtx where
  sgcUsedTbl : List (Pair String (List Int))
  sgcAllDatas : List DtData
  sgcAllDefs : List DtDef
  sgcDefOwnerT : HashMap String String
  sgcDataOwnerT : HashMap String String
  sgcDefUnitT : HashMap String String
  sgcDataUnitT : HashMap String String
  sgcOrdered : List String

mapToUnit : List (Pair String String) -> List (Pair String String)
mapToUnit pairs = map (\q => Pair (firstOf q) (splitUnitOfModule (secondOf q))) pairs

-- ---------------------------------------------------------------
-- 生成前护栏（C08）：模块声明必须已 resolved、入口声明必须是裸名、归属必须全覆盖
-- ---------------------------------------------------------------
checkModuleDeclName : List String -> String -> String -> Check Int
checkModuleDeclName knownModules mname name =
  if containsDot name then if memName (modulePrefixOfName name) knownModules then OkC 0
  else err
    "DT: internal: module ${mname} declares `${name}` whose module prefix `${modulePrefixOfName name}` is not a known module (codegen requires Loader-resolved decls)"
  else err
    "DT: internal: module ${mname} has an unresolved declaration name `${name}` (codegen requires Loader-resolved decls)"

checkModuleDeclNames : List String -> String -> List String -> Check Int
checkModuleDeclNames knownModules mname [] = OkC 0
checkModuleDeclNames knownModules mname (n :: rest) =
  Vuna.Compiler.Common.bind (checkModuleDeclName knownModules mname n)
    (\_ => checkModuleDeclNames knownModules mname rest)

checkModuleDecls : List String -> List (Pair String (List Decl)) -> Check Int
checkModuleDecls knownModules [] = OkC 0
checkModuleDecls knownModules ((Pair mname decls) :: rest) =
  Vuna.Compiler.Common.bind (checkModuleDeclNames knownModules mname (splitDeclNames decls))
    (\_ => checkModuleDecls knownModules rest)

-- 入口的**声明身份**：签名/定义同名是正常形态（DSig + 多 clause DFun），所以只看
-- data/record/trait/sig 这些唯一标识；它们必须是裸名（入口没有模块前缀）。
-- B18：`data T` 与值 `T` 同名是允许的（两个命名空间），因此身份带命名空间标签；
-- 只有同一命名空间内重名才是重复。
entryDeclIdentities : List Decl -> List (Pair Bool String)
entryDeclIdentities [] = []
entryDeclIdentities (d :: rest) = case d of
  DSig name ctx ty sp => Pair False name :: entryDeclIdentities rest
  DExtern name cName ty sp => Pair False name :: entryDeclIdentities rest
  DData name params kind ctors derivings viaField repr lin sp =>
    Pair True name :: entryDeclIdentities rest
  DRecord name params fields derivings viaField repr lin sp =>
    Pair True name :: entryDeclIdentities rest
  DTrait name params methods sp => Pair True name :: entryDeclIdentities rest
  _ => entryDeclIdentities rest

entryDeclKey : Pair Bool String -> String
entryDeclKey (Pair True name) = "type\t${name}"
entryDeclKey (Pair False name) = "value\t${name}"

checkEntryDeclName : List String -> Pair Bool String -> Check Int
checkEntryDeclName seen identity =
  let
    name = secondOf identity
    key = entryDeclKey identity
  in if name == "" then icInternal "entry declaration has an empty name"
  else if containsDot name then err
    "DT: internal: entry declaration `${name}` must not contain a module prefix (codegen requires Loader-resolved decls)"
  else if memName key seen then icInternal "duplicate entry declaration `${name}`" else OkC 0

checkEntryDeclsGo : List String -> List (Pair Bool String) -> Check Int
checkEntryDeclsGo seen [] = OkC 0
checkEntryDeclsGo seen (n :: rest) =
  Vuna.Compiler.Common.bind (checkEntryDeclName seen n)
    (\_ => checkEntryDeclsGo (entryDeclKey n :: seen) rest)

checkEntryDecls : List Decl -> Check Int
checkEntryDecls decls = checkEntryDeclsGo [] (entryDeclIdentities decls)

-- 每个 runtime `DtDef` / `DtData` 都必须有归属（查表命中或带点名字命中已知模块），
-- 在生成前失败并带名字，而不是静默丢定义。
checkDefOwners : SplitMeta -> List DtDef -> Check Int
checkDefOwners meta [] = OkC 0
checkDefOwners meta (d :: rest) =
  Vuna.Compiler.Common.bind (splitDefOwnerOf meta (dtDefName d)) (\_ => checkDefOwners meta rest)

checkDataOwners : SplitMeta -> List DtData -> Check Int
checkDataOwners meta [] = OkC 0
checkDataOwners meta (d :: rest) =
  Vuna.Compiler.Common.bind (splitDataOwnerOf meta d) (\_ => checkDataOwners meta rest)

checkResolvedModules : SplitMeta -> List (Pair String (List Decl)) -> List Decl -> List DtDef -> List DtData -> Check Int
checkResolvedModules meta modules entryDecls runtime datas =
  Vuna.Compiler.Common.bind (checkModuleDecls meta.smKnownModules modules)
    (\_ => Vuna.Compiler.Common.bind (checkEntryDecls entryDecls) (\_ => Vuna.Compiler.Common.bind (checkDefOwners meta runtime) (\_ => checkDataOwners meta datas)))

-- ---------------------------------------------------------------
-- M38：定义位置表（Vuna_runtime.ml 的 dt_def_locs）的路径归一
-- ---------------------------------------------------------------
-- 定义 span 里的路径是解析时的原样：模块文件是 `<rootDir>/<模块路径>.vuna` 的绝对
-- 路径，入口可能是绝对 `<contextDir>/app/Main.vuna` 或调用方给的相对路径。位置表按
-- 「模块根 → 包目录 → 前导 ./」顺序尽量剥成短路径；都不匹配则保留原样。
splitStripPrefix : String -> String -> String
splitStripPrefix prefix path =
  if prefix == "" then path
  else if startsWith "${prefix}/" path then strSubstring (strLength "${prefix}/") (strLength path - strLength "${prefix}/") path
  else path

splitStripRoots : List String -> String -> String
splitStripRoots [] path = path
splitStripRoots (root :: rest) path =
  if startsWith "${root}/" path then splitStripPrefix root path else splitStripRoots rest path

splitStripDotSlash : String -> String
splitStripDotSlash path =
  if startsWith "./" path then strSubstring 2 (strLength path - 2) path else path

splitLocPath : List String -> String -> String -> String
splitLocPath roots contextDir path =
  splitStripDotSlash (splitStripPrefix contextDir (splitStripRoots roots path))

-- roots 是模块根目录（`PackageContext.contextRoots` 的 rootDir），contextDir 是包目录
-- （`PackageContext.contextDir`）；生成位置表用它把 span 路径归一。
noUnitLookup : String -> Eff [] (Maybe SplitFile)
noUnitLookup _ = pure Nothing

noUnitStore : String -> SplitFile -> Eff [] Int
noUnitStore _ _ = pure 0

-- M4（效果显式化）：单元缓存的 lookup/store 是宿主动作，生成外壳显式在 `Eff []` 里；
-- 纯生成逻辑（归属表、分文件、依赖序校验）保持纯函数。
generateDtSplitProgram : List (Pair String (List Decl)) -> List Decl -> DtProgram -> Bool -> List String -> String -> List (Pair String (Pair String Int)) -> Eff [] (Check (List SplitFile))
generateDtSplitProgram modules entryDecls prog printResult roots contextDir extraDefLocs =
  generateDtSplitProgramWith noUnitLookup noUnitStore modules entryDecls prog printResult roots
    contextDir extraDefLocs

-- M34.5（S5）：带**单元级缓存**的生成入口。`lookup` 按模块名（入口用 `__entry__`）
-- 返回上次生成的 `SplitFile`（key 已由调用方算好，含依赖哈希链）；命中即跳过该单元的
-- codegen，`store` 只对重新生成的单元调用。缓存读写留在 Driver 层（本模块不碰 I/O）。
-- 程序（含依赖 defs）是否用到浮点：决定 `Vuna_runtime.ml` 是否追加浮点 helper。
-- no-float（含 compiler 自身）输出与 Float 之前逐字节一致。
-- | 遍历所有定义体，判断是否有定义用到浮点；结果决定 `Vuna_runtime.ml` 是否追加
-- 浮点 helper（no-float 输出保持逐字节一致）。
anyDefUsesFloat : List DtDef -> Bool
anyDefUsesFloat [] = False
anyDefUsesFloat (d :: rest) = case dtDefBody d of
  Nothing => anyDefUsesFloat rest
  Just body => termUsesFloat floatIntrinsicNames body || anyDefUsesFloat rest

-- | 遍历所有定义体，判断是否有定义用到编译器 tracing 隐藏原语（`dbg!` 展开结果）；
-- 结果决定 `Vuna_runtime.ml` 是否追加 `dtTraceRuntime`（不用的程序保持逐字节一致）。
anyDefUsesTrace : List DtDef -> Bool
anyDefUsesTrace [] = False
anyDefUsesTrace (d :: rest) = case dtDefBody d of
  Nothing => anyDefUsesTrace rest
  Just body => termUsesFloat traceIntrinsicNames body || anyDefUsesTrace rest

generateDtSplitProgramWith : (String -> Eff [] (Maybe SplitFile)) -> (String -> SplitFile -> Eff [] Int) -> List (Pair String (List Decl)) -> List Decl -> DtProgram -> Bool -> List String -> String -> List (Pair String (Pair String Int)) -> Eff [] (Check (List SplitFile))
generateDtSplitProgramWith lookup store modules entryDecls prog printResult roots contextDir extraDefLocs =
  let
    -- M34.6：把「精化完成 → prepare 开始」之间的构建独有开销分段（compiler 包约 0.4s，
    -- 旧实现无 stamp 不可归因）；stamp 关闭时只花一次分支。
    _ = dbg! "cg-splitstart"
    allDatas = runtimeDatas (dtProgDatas prog)
    allDefs = dtProgDefs prog
    meta = splitMetaOf modules entryDecls
    _ = dbg! "cg-splitmeta-done"
    -- `extraDefLocs`：增量路径从接口复用的干净模块的位置行（`DtDef` 无 span）。
    locTbl = dtDefLocTable (splitLocPath roots contextDir) allDefs extraDefLocs
    _ = dbg! "cg-deflocs-done"
    usesFloat = anyDefUsesFloat allDefs
    usesTrace = anyDefUsesTrace allDefs
    runtimeText = dtRuntimeWith locTbl usesFloat usesTrace
    _ = dbg! "cg-runtimeText-done"
  in case prepareDtProgram (Pair (dtProgDatas prog) allDefs) of
    ErrC e => pure (ErrC e)
    OkC (Pair runtime groups) =>
      splitProgramFilesWith lookup store modules entryDecls printResult runtime allDatas allDefs
        meta runtimeText

splitProgramFilesWith : (String -> Eff [] (Maybe SplitFile)) -> (String -> SplitFile -> Eff [] Int) -> List (Pair String (List Decl)) -> List Decl -> Bool -> List DtDef -> List DtData -> List DtDef -> SplitMeta -> String -> Eff [] (Check (List SplitFile))
splitProgramFilesWith lookup store modules entryDecls printResult runtime allDatas allDefs meta runtimeText = case checkResolvedModules meta modules entryDecls runtime allDatas of
  ErrC e => pure (ErrC e)
  OkC _ => case nameOwnerPairsOfDefs meta runtime of
    ErrC e => pure (ErrC e)
    OkC defPairs => case nameOwnerPairsOfDatas meta allDatas of
      ErrC e => pure (ErrC e)
      OkC dataPairs =>
        splitWithOwnersWith lookup store modules printResult runtime allDatas allDefs defPairs
          dataPairs runtimeText

splitWithOwnersWith : (String -> Eff [] (Maybe SplitFile)) -> (String -> SplitFile -> Eff [] Int) -> List (Pair String (List Decl)) -> Bool -> List DtDef -> List DtData -> List DtDef -> List (Pair String String) -> List (Pair String String) -> String -> Eff [] (Check (List SplitFile))
splitWithOwnersWith lookup store modules printResult runtime allDatas allDefs defPairs dataPairs runtimeText =
  let
    defUnitT = unitTblOf (mapToUnit defPairs)
    dataUnitT = unitTblOf (mapToUnit dataPairs)
    ordered =
      append (append [runtimeUnit] (map (\q => splitUnitOfModule (firstOf q)) modules))
        [splitUnitOfModule entryOwner]
    ctx =
      SplitGenCtx (usedTableOf allDatas) allDatas runtime (ownerTblOf defPairs)
        (ownerTblOf dataPairs) defUnitT dataUnitT ordered
  in do
    moduleFilesR <- splitModuleFilesWith lookup store ctx modules
    case moduleFilesR of
      ErrC e => pure (ErrC e)
      OkC moduleFiles => do
        mainFileR <- splitMainFileWith lookup store ctx printResult
        pure (case mainFileR of
          ErrC e => ErrC e
          OkC mainFile =>
            OkC (SplitFile "Vuna_runtime.ml" runtimeText [] :: append moduleFiles [mainFile])
        )

splitModuleFilesWith : (String -> Eff [] (Maybe SplitFile)) -> (String -> SplitFile -> Eff [] Int) -> SplitGenCtx -> List (Pair String (List Decl)) -> Eff [] (Check (List SplitFile))
splitModuleFilesWith lookup store ctx [] = pure (OkC [])
splitModuleFilesWith lookup store ctx ((Pair mname decls) :: rest) =
  let
    unit = splitUnitOfModule mname
  in do
    cached <- lookup mname
    case cached of
      Just cachedFile => do
        tailR <- splitModuleFilesWith lookup store ctx rest
        pure (case tailR of
          ErrC e => ErrC e
          OkC tail => OkC (cachedFile :: tail)
        )
      Nothing =>
        let
          unitDatas = datasInUnit ctx.sgcDataOwnerT mname ctx.sgcAllDatas
          unitDefs = defsInUnit ctx.sgcDefOwnerT mname ctx.sgcAllDefs
          qc = QualCtx unit ctx.sgcDefUnitT ctx.sgcDataUnitT
        in case groupRuntimeDefs unitDefs of
          ErrC e => pure (ErrC e)
          OkC groups => case genUnitParts ctx.sgcUsedTbl qc ctx.sgcAllDatas unitDatas groups of
            ErrC e => pure (ErrC e)
            OkC parts => do
              tailR <- splitModuleFilesWith lookup store ctx rest
              case tailR of
                ErrC e => pure (ErrC e)
                OkC tail => case unitDepsOf ctx.sgcOrdered unit (unitPartsDeps parts) of
                  ErrC e => pure (ErrC e)
                  OkC deps =>
                    let
                      sf = SplitFile "${unit}.ml" "${genUnitText parts}\n" deps
                    in do
                      _ <- store mname sf
                      pure (OkC (sf :: tail))

splitMainFileWith : (String -> Eff [] (Maybe SplitFile)) -> (String -> SplitFile -> Eff [] Int) -> SplitGenCtx -> Bool -> Eff [] (Check SplitFile)
splitMainFileWith lookup store ctx printResult = do
  cached <- lookup "__entry__"
  case cached of
    Just cachedFile => pure (OkC cachedFile)
    Nothing =>
      let
        entryUnit = splitUnitOfModule entryOwner
        entryDefs = defsInUnit ctx.sgcDefOwnerT entryOwner ctx.sgcAllDefs
        entryDatas = datasInUnit ctx.sgcDataOwnerT entryOwner ctx.sgcAllDatas
        qc = QualCtx entryUnit ctx.sgcDefUnitT ctx.sgcDataUnitT
      in case groupRuntimeDefs entryDefs of
        ErrC e => pure (ErrC e)
        OkC groups => case genUnitParts ctx.sgcUsedTbl qc ctx.sgcAllDatas entryDatas groups of
          ErrC e => pure (ErrC e)
          OkC parts => case mainHook qc (Pair ctx.sgcAllDatas ctx.sgcAllDefs) ctx.sgcAllDefs printResult of
            ErrC e => pure (ErrC e)
            OkC hook => case unitDepsOf ctx.sgcOrdered entryUnit (append (unitPartsDeps parts) (secondOf hook)) of
              ErrC e => pure (ErrC e)
              OkC deps =>
                let
                  sf =
                    SplitFile "Main.ml" (mainInitPrologue ++ genUnitText parts ++ firstOf hook) deps
                in do
                  _ <- store "__entry__" sf
                  pure (OkC sf)
