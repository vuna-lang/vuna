-- | 契约符号在 OCaml 端的运行时表达式（`IrRt` 作为值原样输出）。
export ocamlRtText : String -> Maybe String
ocamlRtText sym = lookupPair sym ocamlRtTextTable

-- | List 桥接 helper 名；模板里引用它们的符号在跨单元使用时要按 List 族单元限定。
export ocamlRtHelperNames : List String
ocamlRtHelperNames =
  ["dtp_unpack", "dtp_pack", "dtp_listOf", "dtp_ocamlOf", "dtp_concatMany", "dtp_substTemplate"]

rtTextMissing : IrRtSym -> Bool
rtTextMissing s = case ocamlRtText (irRtSymNameOf s) of
  Just _ => False
  Nothing => True

-- | 契约里没有 OCaml 文本的符号（空 = 后端完整）。
export rtTextGaps : List String
rtTextGaps = map irRtSymNameOf (filter rtTextMissing irRtContract)

rtTextExtra : Pair String String -> Bool
rtTextExtra p = case irRtLookup (firstOf p) of
  Just _ => False
  Nothing => True

-- | 表里多出来的、契约没有声明的符号（空 = 没有死表项）。
export rtTextExtras : List String
rtTextExtras = map (\p => firstOf p) (filter rtTextExtra ocamlRtTextTable)
