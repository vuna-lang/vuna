module Vuna.Compiler.Codegen.Decl where

-- Vuna.Compiler.Codegen.Decl：OCaml 名字编码 + 跨单元限定 + IR 类型/声明渲染。
--
-- Track A 第一步之后这里是 codegen 的最底层叶子，只有**纯文本**职责：
--   * 标识符渲染（sanitizeName / valueName / typeName / ctorOcamlName /
--     recordFieldLabel / ocamlString / 保留字转义 / binder 名）；
--   * 跨单元限定（`QualCtx`：名字 → 归属单元，渲染成 `Unit.name`）；
--   * `IrTy` / `IrTyDecl` → OCaml 类型文本。
-- 不再消费 `DtData` / `DtDef` / `Value`：表示决策（族参数槽、keep flags、不透明字段、
-- record 字段表、去装箱族）全部由 `Codegen.Lower` 在 IR 里定好。边界由
-- `checks.ir-boundary` 守护。
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Ir

-- ---------------------------------------------------------------
-- 名字编码
-- ---------------------------------------------------------------
-- M31.3：除 `[A-Za-z0-9]` 外的任意字符都必须转义成 `_x<code>_`——用户符号名函数
-- （`<+>`、`>>=` 之外的声明名）会直接进 OCaml 值名，原样输出是非法标识符。
-- 与既有编码不冲突：字面标识符里的 `_` 已映射成 `_u`，输出里除转义序列外不会出现裸 `_`，
-- 因此不会与字面名冲突（`Codegen.Lower.ensureUniqueOcamlNamesIn` 仍是最后一道防线）。
isAsciiAlphaNum : Int -> Bool
isAsciiAlphaNum c = c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57

sanitizeChar : Int -> List Int
-- `#` 出现在 Loader 生成的匿名实例名里（`#default`、`#fancy`），OCaml 标识符不允许。
sanitizeChar 46 = [95, 100]
sanitizeChar 95 = [95, 117]
sanitizeChar 39 = [95, 112]
sanitizeChar 35 = [95, 104]
sanitizeChar c = if isAsciiAlphaNum c then [c] else strUnpack "_x${c}_"

export sanitizeName : String -> String
sanitizeName name = strPack (concatMap sanitizeChar (strUnpack name))

ocamlPad3 : String -> String
ocamlPad3 s = if strLength s == 1 then "00${s}" else if strLength s == 2 then "0${s}" else s

ocamlEscapeChar : Int -> List Int
ocamlEscapeChar 34 = [92, 34]
ocamlEscapeChar 92 = [92, 92]
ocamlEscapeChar 10 = [92, 110]
ocamlEscapeChar 9 = [92, 116]
ocamlEscapeChar 13 = [92, 114]
ocamlEscapeChar c = if c >= 32 && c <= 126 then [c] else strUnpack "\\${ocamlPad3 (strFromInt c)}"

export ocamlString : String -> String
ocamlString s = "\"${strPack (concatMap ocamlEscapeChar (strUnpack s))}\""

export valueName : String -> String
valueName name = "v_${sanitizeName name}"

-- 单独提出来：OCaml `if` 直接作构造子实参时 早期 codegen 的括号处理不可靠，
-- 这里把它包成一个命名函数，保证自举编译本文件时生成的 OCaml 合法。
export boolText : Bool -> String
boolText True = "true"
boolText False = "false"

-- M14：族 → OCaml 变体类型名；构造子 → 带族前缀的变体构造子名（避免跨族重名）。
export typeName : String -> String
typeName name = "t_${sanitizeName name}"

-- | 自动补注（M41 新增导出）：ctorOcamlName。
export ctorOcamlName : String -> String -> String
ctorOcamlName family ctor = "C_${sanitizeName family}_${sanitizeName (ctorShortName ctor)}"

-- | R4：record 字段的 OCaml record label（按 record 名前缀，避免不同 record 间标签撞车）。
export recordFieldLabel : String -> String -> String
recordFieldLabel family field = "f_${sanitizeName family}_${sanitizeName field}"

-- ---------------------------------------------------------------
-- 跨单元引用限定（C35）
-- ---------------------------------------------------------------
--
-- split 产物里每个单元只 `open Vuna_runtime`（运行时 helper 是唯一共享前缀），
-- 其余跨单元引用（值 `v_*` / 构造子 `C_*` / 类型 `t_*`）一律渲染成 OCaml 限定名
-- `Unit.name`；同单元引用仍是裸名（`let rec` 组与类型声明内部不写自限定）。
-- `Unit` = `sanitizeName` 后的编译单元名，必须已编译 —— 每单元只依赖**实际引用**
-- 到的单元（见 `typeDepsOf` 与 `Codegen.Term` 的 dep 累积），依赖图因此是精确
-- DAG 而不是「所有前序单元」的全序。
--
-- `QualCtx` 只承载「名字 → 归属单元」这两张表与当前单元；`noQual` 是 check 路径
-- （单文件装配、文本丢弃）用的空表，所有引用都回落成裸名。
export record QualCtx(..) where
  qcUnit : String
  qcDefs : HashMap String String
  qcDatas : HashMap String String

export noQual : QualCtx
noQual = QualCtx "" (Base.HashMap.fromList []) (Base.HashMap.fromList [])

export unitTblOf : List (Pair String String) -> HashMap String String
unitTblOf pairs = Base.HashMap.insertAll pairs (Base.HashMap.fromList [])

export unitOfTbl : HashMap String String -> String -> String
unitOfTbl tbl name = case Base.HashMap.lookup name tbl of
  Just u => u
  Nothing => ""

export qualOf : String -> List (Pair String String) -> List (Pair String String) -> QualCtx
qualOf unit defs datas = QualCtx unit (unitTblOf defs) (unitTblOf datas)

-- 跨单元引用前缀：同单元 / 未知归属（内建名由调用方先处理）→ 裸名 + 无依赖。
qualPrefix : QualCtx -> String -> String -> Pair String String
qualPrefix qc owner text =
  if owner == "" || owner == qc.qcUnit then Pair text "" else Pair "${owner}.${text}" owner

-- (OCaml 文本, 依赖单元或 "")
export qualValueText : QualCtx -> String -> Pair String String
qualValueText qc name = qualPrefix qc (unitOfTbl qc.qcDefs name) (valueName name)

export qualCtorText : QualCtx -> String -> String -> Pair String String
qualCtorText qc family ctor =
  qualPrefix qc (unitOfTbl qc.qcDatas family) (ctorOcamlName family ctor)

export qualTypeText : QualCtx -> String -> Pair String String
qualTypeText qc name = qualPrefix qc (unitOfTbl qc.qcDatas name) (typeName name)

-- M24.6：lambda binder 是唯一直接写裸标识符的地方（值/类型/构造子名都有 v_/t_/C_ 前缀，
-- 不会撞 OCaml 保留字）。vuna 允许 `method` / `type` 一类标识符，OCaml 不允许，这里统一
-- 加后缀 `_` 转义，保证「能 check 就能 compile」。
ocamlReservedWords : List String
ocamlReservedWords =
  [ "and",
    "as",
    "assert",
    "asr",
    "begin",
    "class",
    "constraint",
    "do",
    "done",
    "downto",
    "else",
    "end",
    "exception",
    "external",
    "false",
    "for",
    "fun",
    "function",
    "functor",
    "if",
    "in",
    "include",
    "inherit",
    "initializer",
    "land",
    "lazy",
    "let",
    "lor",
    "lsl",
    "lsr",
    "lxor",
    "match",
    "method",
    "mod",
    "module",
    "mutable",
    "new",
    "nonrec",
    "object",
    "of",
    "open",
    "or",
    "private",
    "rec",
    "sig",
    "struct",
    "then",
    "to",
    "true",
    "try",
    "type",
    "val",
    "virtual",
    "when",
    "while",
    "with"
  ]

export ocamlBinderName : String -> String
ocamlBinderName name =
  let
    oc = sanitizeName name
  in if memName oc ocamlReservedWords then "${oc}_" else oc

-- 一次性线性拼接：先插分隔符成列表，再用运行时 `String.concat` 单遍拼出。
-- 旧的 `x ++ sep ++ joinWith sep rest` 在千级片段上是 O(n²) 字节拷贝（build 路径曾占 ~20s）。
export joinWith : String -> List String -> String
joinWith sep xs = strConcatMany (interpose sep xs)

interpose : String -> List String -> List String
interpose sep [] = []
interpose sep ([x]) = [x]
interpose sep (x :: rest) = x :: sep :: interpose sep rest

typeParamName : Int -> String
typeParamName i = "'a${i}"

typeParamNames : Int -> List String
typeParamNames n = map typeParamName (range 0 n)

typeParamDecl : Int -> String
typeParamDecl 0 = ""
typeParamDecl n = case typeParamNames n of
  [only] => "${only} "
  names => "(${joinWith ", " names}) "

familyTyText : QualCtx -> String -> List String -> String
familyTyText qc name [] = firstOf (qualTypeText qc name)
familyTyText qc name ([a]) = "${a} ${firstOf (qualTypeText qc name)}"
familyTyText qc name args = "(${joinWith ", " args}) ${firstOf (qualTypeText qc name)}"

ctorDeclText : String -> List String -> String
ctorDeclText name [] = name
ctorDeclText name ([t]) = "${name} of ${parenOne t}"
ctorDeclText name ts = "${name} of ${joinWith " * " (parenList ts)}"

parenList : List String -> List String
parenList [] = []
parenList (t :: rest) = append [parenOne t] (parenList rest)

parenOne : String -> String
parenOne t = "(${t})"

-- ---------------------------------------------------------------
-- IR 类型 / 类型声明 → OCaml 文本
-- ---------------------------------------------------------------
--
-- `IrTy` 是 Lowering 决策后的签名级运行时类型：族参数槽（`IrTyVar i` → `'a<i>`）、
-- primitive、内建类型构造子、程序数据族、显式函数、不可命名值（`Obj.t`）。这里只
-- 做文本渲染与跨单元限定，**不含**任何表示判据。
export irBinderText : IrBinder -> String
irBinderText (IrBinder (IrBUser name) erased) = ocamlBinderName name
irBinderText (IrBinder (IrBArm n) erased) = "dtb__${strFromInt n}"
irBinderText (IrBinder (IrBNat n) erased) = "dtnat__${strFromInt n}"
irBinderText (IrBinder IrBWild erased) = "_"

export irTyText : QualCtx -> IrTy -> String
irTyText qc (IrTyVar i) = typeParamName i
irTyText qc IrTyInt = "int"
irTyText qc IrTyStr = "string"
irTyText qc IrTyBool = "bool"
irTyText qc IrTyFloat = "float"
irTyText qc IrTyOpaque = "Obj.t"
irTyText qc (IrTyArray a) = "(${irTyText qc a} array)"
irTyText qc (IrTyRef a) = "(${irTyText qc a} ref)"
irTyText qc (IrTyFun d c) = "(${irTyText qc d}) -> ${irTyText qc c}"
irTyText qc (IrTyData fam args) = familyTyText qc fam (map (irTyText qc) args)

-- | 单条 IR 类型声明（不带 `type ` 前缀、不带 `\nand ` 连接符）。
export irTyDeclText : QualCtx -> IrTyDecl -> String
irTyDeclText qc (IrVariantDecl name n ctors) =
  "${typeParamDecl n}${typeName name} = ${ctorBodyOf qc name ctors}"
irTyDeclText qc (IrRecordDecl name n fields tys) =
  "${typeParamDecl n}${typeName name} = { ${joinWith "; " (recordFieldDecls qc name fields tys)} }"
irTyDeclText qc (IrUnboxedDecl name n ty) = "${typeParamDecl n}${typeName name} = ${irTyText qc ty}"

ctorBodyOf : QualCtx -> String -> List (Pair String (List IrTy)) -> String
ctorBodyOf qc family [] = "|"
ctorBodyOf qc family ctors = joinWith " | " (map (ctorDeclOf qc family) ctors)

ctorDeclOf : QualCtx -> String -> Pair String (List IrTy) -> String
ctorDeclOf qc family (Pair ctor tys) =
  ctorDeclText (ctorOcamlName family ctor) (map (irTyText qc) tys)

recordFieldDecls : QualCtx -> String -> List (Pair Int String) -> List IrTy -> List String
recordFieldDecls qc family [] tys = []
recordFieldDecls qc family fields [] = []
recordFieldDecls qc family (f :: fs) (t :: ts) =
  "${recordFieldLabel family (secondOf f)} : ${irTyText qc t}" :: recordFieldDecls qc family fs ts

-- | 一个单元的类型声明块：空表 → ""；否则 `type ... \nand ...\n\n`（末尾空行与迁移前一致）。
export irTypeDeclsText : QualCtx -> List IrTyDecl -> String
irTypeDeclsText qc [] = ""
irTypeDeclsText qc decls = "type ${joinWith "\nand " (map (irTyDeclText qc) decls)}\n\n"

-- | 类型声明里引用到的**运行时族**归属单元（去重、首现顺序；同单元与未知归属跳过）。
export irTyDeclDeps : QualCtx -> List IrTy -> List String
irTyDeclDeps qc tys = irTyDepsGo qc (concatMap irTyGlobalNames tys) []

irTyGlobalNames : IrTy -> List String
irTyGlobalNames (IrTyVar i) = []
irTyGlobalNames IrTyInt = []
irTyGlobalNames IrTyStr = []
irTyGlobalNames IrTyBool = []
irTyGlobalNames IrTyFloat = []
irTyGlobalNames IrTyOpaque = []
irTyGlobalNames (IrTyArray a) = irTyGlobalNames a
irTyGlobalNames (IrTyRef a) = irTyGlobalNames a
irTyGlobalNames (IrTyFun d c) = append (irTyGlobalNames d) (irTyGlobalNames c)
irTyGlobalNames (IrTyData fam args) = fam :: concatMap irTyGlobalNames args

irTyDepsGo : QualCtx -> List String -> List String -> List String
irTyDepsGo qc [] acc = reverse acc
irTyDepsGo qc (n :: rest) acc =
  let
    owner = unitOfTbl qc.qcDatas n
  in if owner == "" || owner == qc.qcUnit then irTyDepsGo qc rest acc
  else if memName owner acc then irTyDepsGo qc rest acc else irTyDepsGo qc rest (owner :: acc)
