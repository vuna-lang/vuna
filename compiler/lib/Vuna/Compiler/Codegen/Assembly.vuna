module Vuna.Compiler.Codegen.Assembly where

-- Vuna.Compiler.Codegen.Assembly：split 产物的**唯一装配实现**（M26；原 Program）。
--
-- Track A 第一步之后本模块只消费 IR：`genUnitParts` 把 `IrUnit`（类型声明 + 分组 +
-- List 族标志）装成「open 头 + 类型声明 + List 桥接 + 分组正文」的片段与生成状态。
-- 准备阶段（擦除检查 / 名字护栏 / SCC 分组）已前置到 `Codegen.Lower`；main 钩子
-- 统一由 `Codegen.Term.genEntryHook` 渲染。check 路径在 `Driver.Dt` 里走
-- `Lower.lowerProgramOf` + `genUnitParts` 并丢弃文本（保留原 `buildText=False` 语义）。
--
-- C35：单元文件头只 `open Vuna_runtime`，其余跨单元引用一律由 `Codegen.Decl` /
-- `Codegen.Term` 生成 `Unit.name` 全限定名；`UnitParts` 同时带出该单元**直接引用**
-- 到的依赖单元（`unitPartsDeps`），供 `Codegen.Split` 写进 `SplitFile` 与 build.sh。
import Vuna.Compiler.Common
import Vuna.Compiler.Ir
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Codegen.Term

-- 运行时前缀单元：`Vuna_runtime.ml` 只有 `dtRuntime`，是唯一被其余单元 open 的单元。
export runtimeUnit : String
runtimeUnit = "Vuna_runtime"

-- 装配片段：文件头（open 头）、类型声明、List 桥接、按 SCC 顺序的正文，外加生成状态
-- 与该单元的直接依赖单元。构造子不导出：调用方只能经 `genUnitText` / `unitPartsDeps`
-- 读取，避免各处重复实现拼接顺序。
export record UnitParts where
  unitPartsFragments : List String
  unitPartsBodies : List String
  unitPartsState : GenSt
  unitPartsDeps : List String

export unitPartsDeps : UnitParts -> List String
unitPartsDeps (UnitParts fragments bodies st deps) = deps

-- 单个单元的装配片段。
--   qc     ：跨单元限定上下文（当前单元 + 名字归属表；check 路径用 `noQual`）
--   shared ：程序级共享元数据（Lowering 一次算好）
--   unitIr ：本单元的 IR（类型声明 / 分组 / List 族标志）
export genUnitParts : QualCtx -> IrShared -> IrUnit -> Check UnitParts
genUnitParts qc shared unitIr = Vuna.Compiler.Common.bind (genTypePart qc unitIr) (\typeText => let
  _ = dbg! "cg-typedecls-done"
in case genGroups (mkGenSt qc shared) unitIr.irUnitGroups of
  ErrC e => ErrC e
  OkC (Pair bodies st) =>
    let
      _ = dbg! "cg-genGroups-done"
      deps =
        uniqueDeps (append (append [runtimeUnit] (typeRefDeps qc unitIr.irUnitTypeRefs)) st.gsDeps)
    in OkC (UnitParts [openHeader qc, typeText, listBridgeFor shared unitIr] bodies st deps)
)

genTypePart : QualCtx -> IrUnit -> Check String
genTypePart qc unitIr = OkC (irTypeDeclsText qc unitIr.irUnitTyDecls)

-- 依赖清单去重（保持首次出现顺序；生成期只按引用顺序累积）。
addDep : List String -> String -> List String
addDep acc dep = if dep == "" || memName dep acc then acc else append acc [dep]

uniqueDeps : List String -> List String
uniqueDeps deps = foldl addDep [] deps

-- 片段拼接：open 头 + 类型 + 桥接 + 正文（正文之间空行分隔，末尾不带换行；
-- 调用方按需要补换行/钩子）。
export genUnitText : UnitParts -> String
genUnitText (UnitParts fragments bodies st deps) =
  strConcatMany (append fragments [joinWith "\n\n" bodies])

-- 单元文件头：只 open 运行时单元（C35：其余跨单元引用都是 `Unit.name` 全限定，没有
-- open 链，因此文件顺序不再决定可见性，只看 `unitPartsDeps`）。check 路径（`noQual`，
-- qcUnit="") 不写 open。
export openHeader : QualCtx -> String
openHeader qc = if qc.qcUnit == "" then "" else "open ${runtimeUnit}\n"

-- List 族桥接只写进声明该族的单元；其它单元通过 `Unit.dtp_*` 全限定名引用（C35）。
listBridgeFor : IrShared -> IrUnit -> String
listBridgeFor shared unitIr =
  if unitIr.irUnitHasListFamily then dtListBridge shared.irSharedListFam else ""

-- 类型声明里引用到的**族名** → 归属单元（去重、首现顺序；同单元与未知归属跳过）。
-- 输入是 `IrUnit.irUnitTypeRefs`（Lowering 已按声明顺序收集好的全局族名表）。
typeRefDeps : QualCtx -> List String -> List String
typeRefDeps qc [] = []
typeRefDeps qc (n :: rest) =
  let
    owner = unitOfTbl qc.qcDatas n
  in if owner == "" || owner == qc.qcUnit then typeRefDeps qc rest
  else if memName owner (typeRefDeps qc rest) then typeRefDeps qc rest else owner :: typeRefDeps qc rest
