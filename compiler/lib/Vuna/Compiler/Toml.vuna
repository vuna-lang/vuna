module Vuna.Compiler.Toml (TomlValue(..), TomlEntry(..), parseToml, parseTomlAt, lookupEntry, lookupEntryLine) where

-- Vuna.Compiler.Toml：TOML 子集解析器（M11.5 包管理基础件）。
-- 支持：# 行注释（字符串内的 # 不算）、空行、[section]、[section.sub]、
-- key = value；value 支持 basic string（转义 \" \\ \n \t \r \b \f）、
-- 可负整数、true/false、字符串数组（可空、可跨行、元素间可带注释/逗号）。
-- key 与 section 段均为裸键 [A-Za-z0-9_-]+。
-- 重复 key、重复 section、语法错误返回带行号的错误：
-- parseToml 的错误形如 `line 3: ...`，parseTomlAt 的错误形如 `path:3: ...`。

import Vuna.Compiler.Common

data TomlValue : Type where
  TStr : String -> TomlValue
  TInt : Int -> TomlValue
  TBool : Bool -> TomlValue
  TList : List String -> TomlValue

-- section path、key、value 与 key 所在行号（从 1 开始）。
data TomlEntry : Type where
  TomlEntry : List String -> String -> TomlValue -> Int -> TomlEntry

-- 字符游标：剩余字符、当前行、当前列（行/列均从 1 开始）。
data TomlCursor : Type where
  TomlCursor : List Int -> Int -> Int -> TomlCursor

cursorChars (TomlCursor chars line col) = chars

cursorLine (TomlCursor chars line col) = line

cursorCol (TomlCursor chars line col) = col

advanceCursor (TomlCursor Nil line col) = TomlCursor Nil line col

advanceCursor (TomlCursor (Cons c rest) line col) =
  if c == 10 then TomlCursor rest (line + 1) 1 else TomlCursor rest line (col + 1)

-- 字符分类（vuna 没有字符字面量，统一用 char code）。
isDigitChar c = c >= 48 && c <= 57

isUpperAlphaChar c = c >= 65 && c <= 90

isLowerAlphaChar c = c >= 97 && c <= 122

isAlphaChar c = isUpperAlphaChar c || isLowerAlphaChar c

isBareKeyChar c = isAlphaChar c || isDigitChar c || c == 95 || c == 45

isBlankChar c = c == 32 || c == 9

-- 统一行尾：去掉 CR，避免 CRLF 把行号数两遍（TOML 基本字符串里本来也不允许裸 CR）。
stripCR Nil = Nil

stripCR (Cons c rest) = if c == 13 then stripCR rest else Cons c (stripCR rest)

locPrefix path line =
  if path == "" then "line " ++ strFromInt line ++ ": "
  else path ++ ":" ++ strFromInt line ++ ": "

failAt path line msg = Err (locPrefix path line ++ msg)

-- 跳过空格/制表符。
skipBlank cs =
  case cursorChars cs of
    Nil => cs
    Cons c rest => if isBlankChar c then skipBlank (advanceCursor cs) else cs

-- 跳过 `#` 开头的行注释，停在行尾换行符（不消费换行）或 EOF。
skipComment cs =
  case cursorChars cs of
    Nil => cs
    Cons c rest => if c == 10 then cs else skipComment (advanceCursor cs)

-- 跳过空白/换行/注释，用于文件顶层与数组内部的间隙。
skipGap cs =
  case cursorChars cs of
    Nil => cs
    Cons c rest =>
      if isBlankChar c || c == 10 then skipGap (advanceCursor cs)
      else if c == 35 then skipGap (skipComment cs)
      else cs

collectBareKey cs acc =
  case cursorChars cs of
    Nil => Pair (strPack (reverse acc)) cs
    Cons c rest =>
      if isBareKeyChar c then collectBareKey (advanceCursor cs) (Cons c acc)
      else Pair (strPack (reverse acc)) cs

parseBareKey path cs =
  case cursorChars cs of
    Nil => failAt path (cursorLine cs) "expected a key"
    Cons c rest =>
      if isBareKeyChar c then
        case collectBareKey cs Nil of
          Pair name after => Ok (Pair name after)
      else failAt path (cursorLine cs) "expected a key"

-- basic string：返回原始字符串与游标（不含两侧引号）。
parseStringValue path cs =
  case cursorChars cs of
    Nil => failAt path (cursorLine cs) "unterminated basic string"
    Cons c rest => parseStringChars path cs (advanceCursor cs) Nil

parseStringChars path startCs cs acc =
  case cursorChars cs of
    Nil => failAt path (cursorLine startCs) "unterminated basic string"
    Cons c rest =>
      if c == 34 then Ok (Pair (strPack (reverse acc)) (advanceCursor cs))
      else if c == 10 then failAt path (cursorLine startCs) "unterminated basic string (newline in string)"
      else if c == 92 then parseStringEscape path startCs (advanceCursor cs) acc
      else parseStringChars path startCs (advanceCursor cs) (Cons c acc)

parseStringEscape path startCs cs acc =
  case cursorChars cs of
    Nil => failAt path (cursorLine startCs) "unterminated escape sequence"
    Cons c rest =>
      if c == 110 then parseStringChars path startCs (advanceCursor cs) (Cons 10 acc)
      else if c == 116 then parseStringChars path startCs (advanceCursor cs) (Cons 9 acc)
      else if c == 114 then parseStringChars path startCs (advanceCursor cs) (Cons 13 acc)
      else if c == 98 then parseStringChars path startCs (advanceCursor cs) (Cons 8 acc)
      else if c == 102 then parseStringChars path startCs (advanceCursor cs) (Cons 12 acc)
      else if c == 34 then parseStringChars path startCs (advanceCursor cs) (Cons 34 acc)
      else if c == 92 then parseStringChars path startCs (advanceCursor cs) (Cons 92 acc)
      else failAt path (cursorLine cs) ("unknown escape sequence \\" ++ strPack (Cons c Nil))

-- 整数：可选前导 '-'，至少一位十进制数字；小数点/尾随字母报错。
parseInteger path cs =
  case cursorChars cs of
    Nil => failAt path (cursorLine cs) "expected an integer"
    Cons c rest =>
      if c == 45 then parseIntegerDigits path cs (advanceCursor cs) 0 0 True
      else if isDigitChar c then parseIntegerDigits path cs cs 0 0 False
      else failAt path (cursorLine cs) "expected an integer"

parseIntegerDigits path startCs cs count acc negative =
  case cursorChars cs of
    Nil => finishInteger path startCs cs count acc negative
    Cons c rest =>
      if isDigitChar c then
        parseIntegerDigits path startCs (advanceCursor cs) (count + 1) (acc * 10 + (c - 48)) negative
      else finishInteger path startCs cs count acc negative

finishInteger path startCs cs count acc negative =
  if count == 0 then failAt path (cursorLine startCs) "expected digits for integer"
  else
    case cursorChars cs of
      Nil => Ok (Pair (makeInteger acc negative) cs)
      Cons c rest =>
        if c == 46 then failAt path (cursorLine startCs) "floating point numbers are not supported"
        else if isBareKeyChar c then failAt path (cursorLine startCs) "invalid integer literal"
        else Ok (Pair (makeInteger acc negative) cs)

makeInteger acc negative = if negative then 0 - acc else acc

parseIntValue path cs =
  case parseInteger path cs of
    Err e => Err e
    Ok (Pair n afterInteger) => Ok (Pair (TInt n) afterInteger)

-- 精确匹配一个 TOML 单词（true/false），且后面不能紧跟裸键字符。
matchChars Nil cs = Just cs

matchChars (Cons want wants) cs =
  case cursorChars cs of
    Nil => Nothing
    Cons c rest => if c == want then matchChars wants (advanceCursor cs) else Nothing

matchWord word cs =
  case matchChars (strUnpack word) cs of
    Nothing => Nothing
    Just after =>
      case cursorChars after of
        Nil => Just after
        Cons c rest => if isBareKeyChar c then Nothing else Just after

-- 字符串数组：字符串可空、可跨行，元素间允许空格/换行/注释，允许尾逗号。
parseStringArray path cs =
  case cursorChars cs of
    Nil => failAt path (cursorLine cs) "unterminated array"
    Cons c rest => parseArrayItems path (advanceCursor cs) Nil

parseArrayItems path cs acc =
  case skipGap cs of
    TomlCursor chars line col =>
      case chars of
        Nil => failAt path line "unterminated array"
        Cons c rest =>
          if c == 93 then Ok (Pair (TList (reverse acc)) (advanceCursor (TomlCursor chars line col)))
          else if c == 34 then parseArrayString path (TomlCursor chars line col) acc
          else failAt path line "expected a string in array"

parseArrayString path cs acc =
  case parseStringValue path cs of
    Err e => Err e
    Ok (Pair s afterString) =>
      case skipGap afterString of
        TomlCursor chars line col =>
          case chars of
            Nil => failAt path line "unterminated array"
            Cons c rest =>
              if c == 44 then parseArrayItems path (advanceCursor (TomlCursor chars line col)) (Cons s acc)
              else if c == 93 then
                Ok (Pair (TList (reverse (Cons s acc))) (advanceCursor (TomlCursor chars line col)))
              else failAt path line "expected ',' or ']' in array"

parseValue path cs =
  case cursorChars cs of
    Nil => failAt path (cursorLine cs) "expected a value"
    Cons c rest =>
      if c == 34 then
        case parseStringValue path cs of
          Err e => Err e
          Ok (Pair s afterString) => Ok (Pair (TStr s) afterString)
      else if c == 91 then parseStringArray path cs
      else if c == 45 then parseIntValue path cs
      else if isDigitChar c then parseIntValue path cs
      else
        case matchWord "true" cs of
          Just afterTrue => Ok (Pair (TBool True) afterTrue)
          Nothing =>
            case matchWord "false" cs of
              Just afterFalse => Ok (Pair (TBool False) afterFalse)
              Nothing => failAt path (cursorLine cs) "expected a value"

-- [section] / [section.sub]：段之间允许空格，例如 [ a . b ]。
parseSectionPath path cs = parseSectionSegments path cs Nil

parseSectionSegments path cs acc =
  case parseBareKey path (skipBlank cs) of
    Err e => Err e
    Ok (Pair seg afterSeg) =>
      case skipBlank afterSeg of
        TomlCursor chars line col =>
          case chars of
            Nil => failAt path line "unterminated section header"
            Cons c rest =>
              if c == 46 then parseSectionSegments path (TomlCursor rest line (col + 1)) (Cons seg acc)
              else if c == 93 then
                Ok (Pair (reverse (Cons seg acc)) (TomlCursor rest line (col + 1)))
              else failAt path line "expected '.' or ']' in section header"

expectEol path cs =
  case skipBlank cs of
    TomlCursor chars line col =>
      case chars of
        Nil => Ok (TomlCursor chars line col)
        Cons c rest =>
          if c == 10 then Ok (TomlCursor rest (line + 1) 1)
          else if c == 35 then expectEolAfterComment path (TomlCursor chars line col)
          else failAt path (cursorLine cs) "unexpected character at end of line"

expectEolAfterComment path cs =
  case skipComment cs of
    TomlCursor chars line col =>
      case chars of
        Nil => Ok (TomlCursor chars line col)
        Cons c rest =>
          if c == 10 then Ok (TomlCursor rest (line + 1) 1)
          else failAt path line "unexpected character after comment"

samePath Nil Nil = True

samePath (Cons x xs) (Cons y ys) = if x == y then samePath xs ys else False

samePath _ _ = False

memSectionPath section seen =
  case seen of
    Nil => False
    Cons s rest => if samePath section s then True else memSectionPath section rest

sectionSuffix section =
  case section of
    Nil => ""
    Cons first rest => " in [" ++ joinDots section ++ "]"

hasEntry section key entries =
  case entries of
    Nil => False
    Cons (TomlEntry s k v line) rest =>
      if samePath section s && k == key then True else hasEntry section key rest

parseEntryValue path cs keyLine key section seen entries =
  case parseValue path (skipBlank cs) of
    Err e => Err e
    Ok (Pair value afterValue) =>
      case expectEol path afterValue of
        Err e => Err e
        Ok afterLine =>
          if hasEntry section key entries then
            failAt path keyLine ("duplicate key \"" ++ key ++ "\"" ++ sectionSuffix section)
          else parseTomlLoop path afterLine section seen (Cons (TomlEntry section key value keyLine) entries)

parseKeyLine path cs section seen entries =
  case parseBareKey path cs of
    Err e => Err e
    Ok (Pair key afterKey) =>
      case skipBlank afterKey of
        TomlCursor chars line col =>
          case chars of
            Nil => failAt path (cursorLine cs) "expected '=' after key"
            Cons c rest =>
              if c == 61 then
                parseEntryValue path (TomlCursor rest line (col + 1)) (cursorLine cs) key section seen entries
              else failAt path (cursorLine cs) ("expected '=' after key \"" ++ key ++ "\"")

parseSectionLine path cs section seen entries =
  case parseSectionPath path (advanceCursor cs) of
    Err e => Err e
    Ok (Pair newSection afterHeader) =>
      if memSectionPath newSection seen then
        failAt path (cursorLine cs) ("duplicate section [" ++ joinDots newSection ++ "]")
      else
        case expectEol path afterHeader of
          Err e => Err e
          Ok afterLine => parseTomlLoop path afterLine newSection (Cons newSection seen) entries

parseTomlLoop path cs section seen entries = parseTomlLoopAt path (skipGap cs) section seen entries

parseTomlLoopAt path cs section seen entries =
  case cursorChars cs of
    Nil => Ok (reverse entries)
    Cons c rest =>
      if c == 91 then parseSectionLine path cs section seen entries
      else parseKeyLine path cs section seen entries

parseToml : String -> Result (List TomlEntry)
parseToml source = parseTomlAt "" source

parseTomlAt : String -> String -> Result (List TomlEntry)
parseTomlAt path source =
  parseTomlLoop path (TomlCursor (stripCR (strUnpack source)) 1 1) Nil Nil Nil

lookupEntry : List String -> String -> List TomlEntry -> Maybe TomlValue
lookupEntry section key entries =
  case entries of
    Nil => Nothing
    Cons (TomlEntry s k v line) rest =>
      if samePath section s && k == key then Just v else lookupEntry section key rest

lookupEntryLine : List String -> String -> List TomlEntry -> Maybe Int
lookupEntryLine section key entries =
  case entries of
    Nil => Nothing
    Cons (TomlEntry s k v line) rest =>
      if samePath section s && k == key then Just line else lookupEntryLine section key rest
