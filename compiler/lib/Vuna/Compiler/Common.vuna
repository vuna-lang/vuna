module Vuna.Compiler.Common
  ( HashTbl
  , Pos
  , Span
  , baseName
  , containsDot
  , hashStr
  , joinArrows
  , joinDots
  , joinSlashes
  , posCol
  , posLine
  , showSpanLoc
  , spanEndCol
  , spanEndLine
  , spanFile
  , spanStartCol
  , spanStartLine
  , splitLastDot
  , splitOnDot
  , splitPath
  , suggest
  , tblEmpty
  , tblFromList
  , tblInsert
  , tblInsertAll
  , tblLookup
  , tblMem
  , tblOfNames
  , module Base.Bool
  , module Base.List
  , module Base.Maybe
  , module Base.Pair
  , module Base.Result
  , module Base.String
  ) where

-- Vuna.Compiler.Common：编译器门面（M11）。
-- 通用类型与 helper 的唯一真源已迁到 stdlib/（Base.Pair/Bool/List/Maybe/Result/String），
-- 这里整模块重导出，保持既有 `import Vuna.Compiler.Common` 的模块零改动；
-- 只保留编译器专属的源码位置（Pos/Span）与模块路径/诊断工具。
import Base.Pair
import Base.Bool
import Base.List
import Base.Maybe
import Base.Result
import Base.String

-- 源码位置（行、列，均从 1 开始）。
data Pos : Type where
  Pos : Int -> Int -> Pos

-- 源码 span：文件、起始行列、结束行列。文件在解析时由调用方注入，
-- 供跨模块 flatten 后仍能追溯每个表达式来自哪个源文件。
data Span : Type where
  Span : String -> Int -> Int -> Int -> Int -> Span

posLine : Pos -> Int
posLine (Pos l c) = l

posCol : Pos -> Int
posCol (Pos l c) = c

spanFile : Span -> String
spanFile (Span f sl sc el ec) = f

spanStartLine : Span -> Int
spanStartLine (Span f sl sc el ec) = sl

spanStartCol : Span -> Int
spanStartCol (Span f sl sc el ec) = sc

spanEndLine : Span -> Int
spanEndLine (Span f sl sc el ec) = el

spanEndCol : Span -> Int
spanEndCol (Span f sl sc el ec) = ec

-- 把 span 渲染成 `文件:行:列`（错误信息前缀）。
showSpanLoc : Span -> String
showSpanLoc (Span f sl sc el ec) = f ++ ":" ++ strFromInt sl ++ ":" ++ strFromInt sc

memChar : Int -> List Int -> Bool
memChar c chars = case chars of
  [] => False
  x :: rest => if x == c then True else memChar c rest

-- 模块路径工具：`A.B.C` 的拆分/拼接（编译器专属）。
containsDot : String -> Bool
containsDot s = memChar 46 (strUnpack s)

splitOnDot : String -> List String
splitOnDot s = splitCharsOnDot (strUnpack s) [] []

splitCharsOnDot : List Int -> List String -> List Int -> List String
splitCharsOnDot chars acc seg = case chars of
  [] => reverse (strPack (reverse seg) :: acc)
  c :: rest =>
    if c == 46 then splitCharsOnDot rest (strPack (reverse seg) :: acc) []
    else splitCharsOnDot rest acc (c :: seg)

splitLastDot : List String -> Pair (List String) String
splitLastDot parts = case reverse parts of
  [] => Pair [] ""
  last :: rest => Pair (reverse rest) last

joinDots : List String -> String
joinDots [] = ""
joinDots ([x]) = x
joinDots (x :: rest) = x ++ "." ++ joinDots rest

joinSlashes : List String -> String
joinSlashes [] = ""
joinSlashes ([x]) = x
joinSlashes (x :: rest) = x ++ "/" ++ joinSlashes rest

joinArrows : List String -> String
joinArrows [] = ""
joinArrows ([x]) = x
joinArrows (x :: rest) = x ++ " -> " ++ joinArrows rest

-- 路径拆分：返回去掉最后一段的目录与最后一段（无 "/" 时目录为 ""）。
-- 编译器驱动（创建输出文件父目录）与 doc 共用，因此放在 Base 而不是工具模块。
splitPath : String -> Pair String String
splitPath path = splitPathChars (strUnpack path) []

splitPathChars : List Int -> List Int -> Pair String String
splitPathChars [] acc =
  let
    chars = reverse acc
  in Pair "" (strPack chars)
splitPathChars (c :: rest) acc =
  if c == 47 then Pair (strPack (reverse acc)) (strPack rest) else splitPathChars rest (c :: acc)

baseName : String -> String
baseName path = secondOf (splitPath path)

-- 候选建议：与出错名相似的名字（诊断）
suggest : String -> List String -> String
suggest name [] = ""
suggest name (c :: rest) =
  if _similarName name c then " (did you mean " ++ c ++ "?)" else suggest name rest

_similarName : String -> String -> Bool
_similarName a b = if a == b then False
else if startsWith a b then True
else if startsWith b a then True
else
  let
    la = strUnpack a
  in let
    lb = strUnpack b
  in lengthDiffLE (length la) (length lb) 2 && prefixLen2 la lb >= 2

prefixLen2 : List Int -> List Int -> Int
prefixLen2 [] _ = 0
prefixLen2 _ [] = 0
prefixLen2 (x :: xs) (y :: ys) = if x == y then 1 + prefixLen2 xs ys else 0

lengthDiffLE : Int -> Int -> Int -> Bool
lengthDiffLE la lb n = if la >= lb then la - lb <= n else lb - la <= n

-- ---------------------------------------------------------------
-- 名字 → 值的持久哈希表：1024 桶（两层 32 叉）。
-- 动机：defs / globals 一类表「每个类型检查节点都要查一次」，用关联列表线性扫让单次
-- 查找成本随程序规模线性增长（总量二次方）。这里单次查找 ~64 步列表遍历 + 桶内 1–2
-- 次字符串比较。桶内前插，语义与旧关联表「新值优先」一致。
-- ---------------------------------------------------------------
data HashTbl a : Type where
  MkHashTbl : List (List (List (Pair String a))) -> HashTbl a

replicate : Int -> a -> List a
replicate n x = if n <= 0 then [] else x :: replicate (n - 1) x

nthOr : Int -> a -> List a -> a
nthOr i d xs = case xs of
  [] => d
  x :: rest => if i <= 0 then x else nthOr (i - 1) d rest

putNth : Int -> a -> List a -> List a
putNth i v xs = case xs of
  [] => []
  x :: rest => if i <= 0 then v :: rest else x :: putNth (i - 1) v rest

mod1024 : Int -> Int
mod1024 x = x - x / 1024 * 1024

-- 字符串哈希 → 0..1023（逐字符取模，天然不溢出）。
hashStr : String -> Int
-- 索引键哈希：走运行时内建 `strHash`（OCaml 单遍、无 char-list 分配）。
-- 旧实现 `hashChars (strUnpack s)` 每次查表都分配一条字符链表：force 每次 delta 展开
-- 都要查 defs 表，实测这是 check 的主要分配来源之一。
hashStr s = strHash s

hashChars : List Int -> Int -> Int
hashChars [] h = h
hashChars (c :: rest) h = hashChars rest (mod1024 (h * 33 + c))

tblEmpty : HashTbl a
tblEmpty = MkHashTbl (replicate 32 (replicate 32 []))

-- 名字集合（成员判定走哈希索引）：编译期大量「这个名字是否已定义/已见」的判定
-- 原来是对 list 做 memName（逐个 O(n)）⇒ 整程序 O(n²)。统一用哈希集合。
tblOfNames : List String -> HashTbl Bool
tblOfNames xs = tblInsertAll (map (\n => Pair n True) xs) tblEmpty

tblMem : String -> HashTbl Bool -> Bool
tblMem n t = case tblLookup n t of
  Just _ => True
  Nothing => False

tblInsert : String -> a -> HashTbl a -> HashTbl a
tblInsert key v tbl = case tbl of
  MkHashTbl outers =>
    let
      b = hashStr key
      oi = b / 32
      ii = b - oi * 32
      outer = nthOr oi (replicate 32 []) outers
      inner = nthOr ii [] outer
    in MkHashTbl (putNth oi (putNth ii (Pair key v :: inner) outer) outers)

lookupAssoc : String -> List (Pair String a) -> Maybe a
lookupAssoc key pairs = case pairs of
  [] => Nothing
  (Pair k v) :: rest => if key == k then Just v else lookupAssoc key rest

tblLookup : String -> HashTbl a -> Maybe a
tblLookup key tbl = case tbl of
  MkHashTbl outers =>
    let
      b = hashStr key
      oi = b / 32
      ii = b - oi * 32
    in lookupAssoc key (nthOr ii [] (nthOr oi [] outers))

tblFromList : List (Pair String a) -> HashTbl a
tblFromList pairs = case pairs of
  [] => tblEmpty
  (Pair k v) :: rest => tblInsert k v (tblFromList rest)

-- 批量插入（用于「按当前列表建表」或把一批新条目并入已有索引）。列表顺序 =
-- 新值优先：先插入前面的条目，后面的同键条目覆盖前面的（与关联表查找语义一致）。
tblInsertAll : List (Pair String a) -> HashTbl a -> HashTbl a
tblInsertAll pairs tbl = case pairs of
  [] => tbl
  (Pair k v) :: rest => tblInsertAll rest (tblInsert k v tbl)
