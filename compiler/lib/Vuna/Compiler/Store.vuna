-- | 缓存载荷的**唯一存储层**：自描述 framing v2 + 原子写 + 目录布局。
module Vuna.Compiler.Store
  ( Frame(..)
  , fCodecOf
  , fPayloadOf
  , fTagOf
  , storeCacheBaseEff
  , storeDecode
  , storeDecodeAs
  , storeDecodeFast
  , storeEncode
  , storeEncodeAs
  , storeEnsureDirEff
  , storeFileExistsEff
  , storeMagic
  , storeParentPathOf
  , storeReadAsEff
  , storeReadEff
  , storeReadFastEff
  , storeRemoveEff
  , storeWriteAsEff
  , storeWriteEff
  , storeWriteIfChangedAsEff
  , storeWriteIfChangedEff
  ) where

-- Vuna.Compiler.Store：磁盘缓存载荷的统一存储层（C32 收口 / D-Q2）。
--
-- 背景：`check` / `split` / `split-units` / `ast` / `iface` 五类载荷过去各自
-- `prim_marshal` + 裸写盘，再在 `CacheFormat` 外层套一层 framing。Marshal 的字节是
-- 「本编译器内存表示」的函数（随字段顺序 / OCaml 版本漂移），且损坏时只能靠
-- `Marshal.from_string` 抛异常——语言里没有 try/catch，进程只能崩。
--
-- 现在的格式（framing v2）：
--
--   vuna-cache-frame 2|<tag>|<codec>|<payload 字节数>|<payload 内容地址>\n<payload>
--
--   - magic   : 格式版本（本模块变更即 bump；旧文件自然拒绝）
--   - tag     : 各缓存自己的 schema / 编译器指纹；版本不符即拒绝旧缓存（无兼容义务）
--   - codec   : `<名字> <版本>`，声明载荷的编码族与版本；读侧按它选解码器，
--               不匹配即拒绝（杜绝「用旧布局解新载荷」）
--   - 长度    : 精确字节数（截断 / 追加都拒绝）
--   - 内容地址: `Hash.contentAddress payload`（4-lane 预折叠 + SHA-256，64 位十六进制）。
--               任意单字节改动都会改变它；构造性「同长同地址」不可行。
--
-- 载荷本身是 `Payload.*` 的**显式规范编码**（自定界原子文法，见 `Canonical.Bytes`），
-- 不随编译器 / OCaml 运行时版本漂移。读侧只在 framing 全部通过后才解码。
--
-- 读侧校验强度分两档（`storeDecode` / `storeDecodeFast`）：
--   * `storeDecode`：magic/tag/codec/长度/**内容地址**全验。用于 payload 的完整性
--     只靠 framing 兜底的载荷（check marker / ast / split / split-units）。
--   * `storeDecodeFast`：跳过内容地址，但仍验 magic/tag/codec/长度。**唯一使用者是
--     iface 载荷**：它自带 Merkle 语义哈希（`hashOfIface` + `miIfaceHash`），读侧随后
--     逐模块自证，比字节级校验更强；对 9 MB 接口载荷再做一次 SHA-256 会让 warm
--     `check compiler` 多 ~20 ms，属于重复防护。
--
-- 代价：写侧多一次内容地址（本机 ~2.2 ms/MB）；读侧同样（fast 档为 0）。check marker
-- 载荷为 0 字节，split/unit 载荷只在 miss 路径写。
import Base.Host
import Vuna.Compiler.Common
import Vuna.Compiler.Hash

-- | framing 版本串；格式变更即 bump（旧文件自然拒绝，不做迁移）。
storeMagic : String
storeMagic = "vuna-cache-frame 2"

-- | 一次成功解码的结果：codec 名与载荷字节。
record Frame where
  fTag : String
  fCodec : String
  fPayload : String

fTagOf : Frame -> String
fTagOf (Frame t c p) = t

fCodecOf : Frame -> String
fCodecOf (Frame t c p) = c

fPayloadOf : Frame -> String
fPayloadOf (Frame t c p) = p

-- 头行（含换行）；payload 从下一字节开始。
frameHeader : String -> String -> Int -> String -> String
frameHeader tag codec len digest = "${storeMagic}|${tag}|${codec}|${len}|${digest}\n"

-- | 载荷 → 可落盘的带自描述头的字节串。`tag` / `codec` 由调用方给出（不含 `|`）。
storeEncode : String -> String -> String -> String
storeEncode tag codec payload =
  frameHeader tag codec (strLength payload) (Vuna.Compiler.Hash.contentAddress payload) ++ payload

-- | 同上，但内容地址由调用方提供。用于**已经算过强哈希**的载荷（iface 模块文件的
-- `miIfaceHash` 就是载荷全量语义面的 SHA-256）：省掉一次 MB 级再哈希，读侧也能用
-- 期望哈希零成本校验（`storeDecodeAs`）。
storeEncodeAs : String -> String -> String -> String -> String
storeEncodeAs tag codec digest payload = frameHeader tag codec (strLength payload) digest ++ payload

-- 头行字段拆分：恰好 5 段（magic/tag/codec/len/digest）。多一段 / 少一段都拒绝。
headerFields : String -> Maybe (Pair String (Pair String (Pair String (Pair String String))))
headerFields line = case split "|" line of
  [m, t, c, l, d] => Just (Pair m (Pair t (Pair c (Pair l d))))
  _ => Nothing

breakFirstNewline : List Int -> List Int -> Maybe (Pair String String)
breakFirstNewline [] _ = Nothing
breakFirstNewline (c :: rest) acc =
  if c == 10 then Just (Pair (strPack (reverse acc)) (strPack rest))
  else breakFirstNewline rest (c :: acc)

-- 头行 + 载荷切分：只在**前 512 字节**里找换行（头行约 160 字节，远小于上限）。
-- 不能对整段载荷做 `strUnpack`：5 MB 载荷会建 500 万个 cons cell 再把列表拼回字符串。
-- 载荷用 `strSubstring` 切一次（一次内存拷贝）。
frameSplit : String -> Maybe (Pair String String)
frameSplit raw =
  let
    n = strLength raw
    headLen = if n < 512 then n else 512
  in case breakFirstNewline (strUnpack (strSubstring 0 headLen raw)) [] of
    Nothing => Nothing
    Just p =>
      let
        header = firstOf p
        start = strLength header + 1
      in Just (Pair header (strSubstring start (n - start) raw))

-- 头行必须同时命中 magic / tag / codec / 长度；四者任一不符即拒绝（不解码任何字节）。
headerOk : String -> String -> String -> String -> Bool
headerOk tag codec header payload = case headerFields header of
  Nothing => False
  Just fields =>
    let
      magic = firstOf fields
      rest1 = secondOf fields
      gotTag = firstOf rest1
      rest2 = secondOf rest1
      gotCodec = firstOf rest2
      rest3 = secondOf rest2
      gotLen = firstOf rest3
    in magic == storeMagic
      && gotTag == tag
      && gotCodec == codec
      && gotLen == strFromInt (strLength payload)

-- 头行里的内容地址字段（未做任何校验）。
headerDigestOf : String -> Maybe String
headerDigestOf header = case headerFields header of
  Nothing => Nothing
  Just fields => Just (secondOf (secondOf (secondOf (secondOf fields))))

-- | 解码 + **完整校验**（含内容地址）。任一不符 ⇒ `Nothing`（调用方回退重算）。
storeDecode : String -> String -> String -> Maybe String
storeDecode tag codec raw = case frameSplit raw of
  Nothing => Nothing
  Just p =>
    let
      payload = secondOf p
    in if headerOk tag codec (firstOf p) payload && headerDigestOf (firstOf p) == Just (Vuna.Compiler.Hash.contentAddress payload) then Just payload
    else Nothing

-- | 解码 + 校验「头里的内容地址 == 调用方期望值」（不重算内容地址）。
--
-- 用于调用方**已持有**载荷字节摘要的场景：iface 模块文件的 manifest 条目记录了写盘
-- 时的载荷摘要（`mePayloadDigest`），读侧只需字符串比对——篡改 / 错位立即拒绝，且
-- 对 9 MB 载荷不产生第二次 SHA-256（warm `check compiler` 的 36 ms 预算里没有这笔钱）。
storeDecodeAs : String -> String -> String -> String -> Maybe String
storeDecodeAs tag codec digest raw = case frameSplit raw of
  Nothing => Nothing
  Just p =>
    let
      payload = secondOf p
    in if headerOk tag codec (firstOf p) payload && headerDigestOf (firstOf p) == Just digest then Just payload
    else Nothing

-- | 解码但不校验内容地址（只验 magic/tag/codec/长度）。仅供**随后会自证**的载荷使用：
-- 解出来的值由调用方按语义哈希逐字段核对（iface 模块文件即如此），字节级摘要留给
-- `storeDecode` / `storeDecodeAs`。
storeDecodeFast : String -> String -> String -> Maybe String
storeDecodeFast tag codec raw = case frameSplit raw of
  Nothing => Nothing
  Just p => if headerOk tag codec (firstOf p) (secondOf p) then Just (secondOf p) else Nothing

-- 缓存根（`VUNA_CACHE_DIR` 覆盖；缺省 `$TMPDIR/vuna-cache`）。
-- Nix 构建的源树只读 ⇒ 缓存放临时目录；本地开发同机 TMPDIR 持久 ⇒ 命中。
storeCacheBaseEff : Eff [] String
storeCacheBaseEff = do
  override <- prim_eff_getenv "VUNA_CACHE_DIR"
  tmp <- prim_eff_getenv "TMPDIR"
  pure (if override /= "" then override else "${if tmp == "" then "/tmp" else tmp}/vuna-cache")

-- | 读 + 完整校验（magic/tag/codec/长度/内容地址）。
storeReadEff : String -> String -> String -> Eff [] (Maybe String)
storeReadEff tag codec path = do
  exists <- prim_eff_fileExists path
  if exists then do
    raw <- prim_eff_readFile path
    pure (storeDecode tag codec raw)
  else pure Nothing

-- | 读 + 快速校验（跳过内容地址；仅供随后自证的载荷，见模块头）。
storeReadFastEff : String -> String -> String -> Eff [] (Maybe String)
storeReadFastEff tag codec path = do
  exists <- prim_eff_fileExists path
  if exists then do
    raw <- prim_eff_readFile path
    pure (storeDecodeFast tag codec raw)
  else pure Nothing

-- | 读 + 校验「头里的内容地址 == 期望值」（不重算；见 `storeDecodeAs`）。
storeReadAsEff : String -> String -> String -> String -> Eff [] (Maybe String)
storeReadAsEff tag codec digest path = do
  exists <- prim_eff_fileExists path
  if exists then do
    raw <- prim_eff_readFile path
    pure (storeDecodeAs tag codec digest raw)
  else pure Nothing

-- | 写（原子替换）。返回写入字节数。
storeWriteEff : String -> String -> String -> String -> Eff [] Int
storeWriteEff tag codec path payload = prim_eff_writeFileAtomic path (storeEncode tag codec payload)

-- | 写，但用调用方给的载荷摘要（已算过强哈希时用，见 `storeEncodeAs`）。
storeWriteAsEff : String -> String -> String -> String -> String -> Eff [] Int
storeWriteAsEff tag codec digest path payload =
  prim_eff_writeFileAtomic path (storeEncodeAs tag codec digest payload)

-- | 内容不变就不写：避免无意义地刷新 mtime / 制造写放大。
storeWriteIfChangedEff : String -> String -> String -> String -> Eff [] Int
storeWriteIfChangedEff tag codec path payload =
  let
    raw = storeEncode tag codec payload
  in do
    exists <- prim_eff_fileExists path
    if exists then do
      old <- prim_eff_readFile path
      if old == raw then pure 0 else prim_eff_writeFileAtomic path raw
    else prim_eff_writeFileAtomic path raw

-- | 同 `storeWriteIfChangedEff`，但内容地址由调用方给出（见 `storeEncodeAs`）。
storeWriteIfChangedAsEff : String -> String -> String -> String -> String -> Eff [] Int
storeWriteIfChangedAsEff tag codec digest path payload =
  let
    raw = storeEncodeAs tag codec digest payload
  in do
    exists <- prim_eff_fileExists path
    if exists then do
      old <- prim_eff_readFile path
      if old == raw then pure 0 else prim_eff_writeFileAtomic path raw
    else prim_eff_writeFileAtomic path raw

storeFileExistsEff : String -> Eff [] Bool
storeFileExistsEff = prim_eff_fileExists

storeRemoveEff : String -> Eff [] Int
storeRemoveEff = prim_eff_removeFile

-- | 逐级创建目录（`prim_eff_makeDir` 只建一层）。路径是文件系统图，用显式 fuel 守卫。
storeEnsureDirEff : String -> Eff [] Int
storeEnsureDirEff path = storeEnsureDirFuel 256 path

storeEnsureDirFuel : Int -> String -> Eff [] Int
storeEnsureDirFuel fuel path = if fuel <= 0 then pure 0
else if path == "" || path == "." || path == "/" then pure 0
else do
  exists <- prim_eff_fileExists path
  if exists then pure 0
  else do
    _ <- storeEnsureDirFuel (fuel - 1) (storeParentOf path)
    prim_eff_makeDir path

storeParentOf : String -> String
storeParentOf path =
  let
    rev = strUnpack path
    after = storeDropPastSlash (reverse rev)
  in if length after == length (reverse rev) then "."
  else
    let
      p = strPack (reverse after)
    in if p == "" then if startsWith "/" path then "/" else "."
    else if startsWith "/" path && not (startsWith "/" p) then "/${p}" else p

-- | 文件路径的父目录（`/a/b` → `/a`；`a` → `.`；`/a` → `/`）。对外导出给缓存路径使用。
storeParentPathOf : String -> String
storeParentPathOf = storeParentOf

storeDropPastSlash : List Int -> List Int
storeDropPastSlash [] = []
storeDropPastSlash (c :: rest) = if c == 47 then rest else storeDropPastSlash rest
