-- | 缓存载荷的**唯一存储层**：自描述 framing v2 + 原子写 + 目录布局。
module Vuna.Compiler.Store where

-- Vuna.Compiler.Store：磁盘缓存载荷的统一存储层（C32 收口 / D-Q2）。
--
-- 背景：`check` / `split` / `split-units` / `ast` / `iface` 五类载荷过去各自
-- `prim_marshal` + 裸写盘，再在 `CacheFormat` 外层套一层 framing。Marshal 的字节是
-- 「本编译器内存表示」的函数（随字段顺序 / OCaml 版本漂移），且损坏时只能靠
-- `Marshal.from_string` 抛异常——语言里没有 try/catch，进程只能崩。
--
-- 现在的格式（framing v2）：
--
--   vuna-cache-frame 2|<tag>|<codec>|<payload 字节数>|<payload 内容地址>\n<payload>
--
--   - magic   : 格式版本（本模块变更即 bump；旧文件自然拒绝）
--   - tag     : 各缓存自己的 schema / 编译器指纹；版本不符即拒绝旧缓存（无兼容义务）
--   - codec   : `<名字> <版本>`，声明载荷的编码族与版本；读侧按它选解码器，
--               不匹配即拒绝（杜绝「用旧布局解新载荷」）
--   - 长度    : 精确字节数（截断 / 追加都拒绝）
--   - 内容地址: `Hash.contentAddress payload`（4-lane 预折叠 + SHA-256，64 位十六进制）。
--               任意单字节改动都会改变它；构造性「同长同地址」不可行。
--
-- 载荷本身是 `Payload.*` 的**显式规范编码**（自定界原子文法，见 `Canonical.Bytes`），
-- 不随编译器 / OCaml 运行时版本漂移。读侧只在 framing 全部通过后才解码。
--
-- 读侧校验强度分两档（`storeDecode` / `storeDecodeFast`）：
--   * `storeDecode`：magic/tag/codec/长度/**内容地址**全验。用于 payload 的完整性
--     只靠 framing 兜底的载荷（check marker / ast / split / split-units）。
--   * `storeDecodeFast`：跳过内容地址，但仍验 magic/tag/codec/长度。**唯一使用者是
--     iface 载荷**：它自带 Merkle 语义哈希（`hashOfIface` + `miIfaceHash`），读侧随后
--     逐模块自证，比字节级校验更强；对 9 MB 接口载荷再做一次 SHA-256 会让 warm
--     `check compiler` 多 ~20 ms，属于重复防护。
--
-- 代价：写侧多一次内容地址（本机 ~2.2 ms/MB）；读侧同样（fast 档为 0）。check marker
-- 载荷为 0 字节，split/unit 载荷只在 miss 路径写。
import Vuna.Compiler.Common
import Vuna.Compiler.Hash
import Base.List
import Base.String
import Base.HostRow

-- | framing 版本串；格式变更即 bump（旧文件自然拒绝，不做迁移）。
export storeMagic : String
storeMagic = "vuna-cache-frame 2"

-- | 一次成功解码的结果：codec 名与载荷字节。
export record Frame(..) where
  fTag : String
  fCodec : String
  fPayload : String

export fTagOf : Frame -> String
fTagOf (Frame t c p) = t

export fCodecOf : Frame -> String
fCodecOf (Frame t c p) = c

export fPayloadOf : Frame -> String
fPayloadOf (Frame t c p) = p

-- 头行（含换行）；payload 从下一字节开始。
frameHeader : String -> String -> Int -> String -> String
frameHeader tag codec len digest = "${storeMagic}|${tag}|${codec}|${len}|${digest}\n"

-- | 载荷 → 可落盘的带自描述头的字节串。`tag` / `codec` 由调用方给出（不含 `|`）。
export storeEncode : String -> String -> String -> String
storeEncode tag codec payload =
  frameHeader tag codec (strLength payload) (Vuna.Compiler.Hash.contentAddress payload) ++ payload

-- | 同上，但内容地址由调用方提供。用于**已经算过强哈希**的载荷（iface 模块文件的
-- `miIfaceHash` 就是载荷全量语义面的 SHA-256）：省掉一次 MB 级再哈希，读侧也能用
-- 期望哈希零成本校验（`storeDecodeAs`）。
export storeEncodeAs : String -> String -> String -> String -> String
storeEncodeAs tag codec digest payload = frameHeader tag codec (strLength payload) digest ++ payload

-- 头行字段拆分：恰好 5 段（magic/tag/codec/len/digest）。多一段 / 少一段都拒绝。
headerFields : String -> Maybe (Pair String (Pair String (Pair String (Pair String String))))
headerFields line = case split "|" line of
  [m, t, c, l, d] => Just (Pair m (Pair t (Pair c (Pair l d))))
  _ => Nothing

breakFirstNewline : List Int -> List Int -> Maybe (Pair String String)
breakFirstNewline [] _ = Nothing
breakFirstNewline (c :: rest) acc =
  if c == 10 then Just (Pair (strPack (reverse acc)) (strPack rest))
  else breakFirstNewline rest (c :: acc)

-- 头行 + 载荷切分：只在**前 512 字节**里找换行（头行约 160 字节，远小于上限）。
-- 不能对整段载荷做 `strUnpack`：5 MB 载荷会建 500 万个 cons cell 再把列表拼回字符串。
-- 载荷用 `strSubstring` 切一次（一次内存拷贝）。
frameSplit : String -> Maybe (Pair String String)
frameSplit raw =
  let
    n = strLength raw
    headLen = if n < 512 then n else 512
  in case breakFirstNewline (strUnpack (strSubstring 0 headLen raw)) [] of
    Nothing => Nothing
    Just p =>
      let
        header = firstOf p
        start = strLength header + 1
      in Just (Pair header (strSubstring start (n - start) raw))

-- 头行必须同时命中 magic / tag / codec / 长度；四者任一不符即拒绝（不解码任何字节）。
headerOk : String -> String -> String -> String -> Bool
headerOk tag codec header payload = case headerFields header of
  Nothing => False
  Just fields =>
    let
      magic = firstOf fields
      rest1 = secondOf fields
      gotTag = firstOf rest1
      rest2 = secondOf rest1
      gotCodec = firstOf rest2
      rest3 = secondOf rest2
      gotLen = firstOf rest3
    in magic == storeMagic
      && gotTag == tag
      && gotCodec == codec
      && gotLen == strFromInt (strLength payload)

-- 头行里的内容地址字段（未做任何校验）。
headerDigestOf : String -> Maybe String
headerDigestOf header = case headerFields header of
  Nothing => Nothing
  Just fields => Just (secondOf (secondOf (secondOf (secondOf fields))))

-- | 解码 + **完整校验**（含内容地址）。任一不符 ⇒ `Nothing`（调用方回退重算）。
export storeDecode : String -> String -> String -> Maybe String
storeDecode tag codec raw = case frameSplit raw of
  Nothing => Nothing
  Just p =>
    let
      payload = secondOf p
    in if headerOk tag codec (firstOf p) payload && headerDigestOf (firstOf p) == Just (Vuna.Compiler.Hash.contentAddress payload) then Just payload
    else Nothing

-- | 解码 + 校验「头里的内容地址 == 调用方期望值」（不重算内容地址）。
--
-- 用于调用方**已持有**载荷字节摘要的场景：iface 模块文件的 manifest 条目记录了写盘
-- 时的载荷摘要（`mePayloadDigest`），读侧只需字符串比对——篡改 / 错位立即拒绝，且
-- 对 9 MB 载荷不产生第二次 SHA-256（warm `check compiler` 的 36 ms 预算里没有这笔钱）。
export storeDecodeAs : String -> String -> String -> String -> Maybe String
storeDecodeAs tag codec digest raw = case frameSplit raw of
  Nothing => Nothing
  Just p =>
    let
      payload = secondOf p
    in if headerOk tag codec (firstOf p) payload && headerDigestOf (firstOf p) == Just digest then Just payload
    else Nothing

-- | 解码但不校验内容地址（只验 magic/tag/codec/长度）。仅供**随后会自证**的载荷使用：
-- 解出来的值由调用方按语义哈希逐字段核对（iface 模块文件即如此），字节级摘要留给
-- `storeDecode` / `storeDecodeAs`。
export storeDecodeFast : String -> String -> String -> Maybe String
storeDecodeFast tag codec raw = case frameSplit raw of
  Nothing => Nothing
  Just p => if headerOk tag codec (firstOf p) (secondOf p) then Just (secondOf p) else Nothing

-- | 存储根（唯一根：对象库 + 视图 + roots）：`VUNA_STORE` → `$XDG_DATA_HOME/vuna/store`
-- → `~/.vuna/store` → `$TMPDIR/vuna-store` → `/tmp/vuna-store`。
--
-- `HOME` 为空或是 `/homeless-shelter`（Nix 构建沙箱）时**不能**用它：那条路径不可写，
-- 会让构建在第一次写对象时崩掉。沙箱内回落到 `$TMPDIR`（构建期缓存，天然可弃）。
export storeDataRootEff : Eff hostRow String
storeDataRootEff = do
  override <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_STORE")
  if override /= "" then pure override
  else do
    xdg <- raiseToRow hostRow (@vuna@prim_eff_getenv "XDG_DATA_HOME")
    if xdg /= "" then pure "${xdg}/vuna/store"
    else do
      home <- raiseToRow hostRow (@vuna@prim_eff_getenv "HOME")
      if home /= "" && home /= "/homeless-shelter" then pure "${home}/.vuna/store"
      else do
        tmp <- raiseToRow hostRow (@vuna@prim_eff_getenv "TMPDIR")
        pure (if tmp == "" then "/tmp/vuna-store" else "${tmp}/vuna-store")

-- | 缓存根 = **对象库根**。历史上是独立的临时缓存根（`$TMPDIR/vuna-cache`，
-- `VUNA_CACHE_DIR` 可覆盖）；合并后只有一棵树：包对象、header、lex、split/unit、
-- 会话索引都在 `$VUNA_STORE` 下，GC 与 roots 才有唯一口径。
export storeCacheBaseEff : Eff hostRow String
storeCacheBaseEff = storeRootReadyEff

-- | 读 + 完整校验（magic/tag/codec/长度/内容地址）。
export storeReadEff : String -> String -> String -> Eff hostRow (Maybe String)
storeReadEff tag codec path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then do
    raw <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
    pure (storeDecode tag codec raw)
  else pure Nothing

-- | 读 + 快速校验（跳过内容地址；仅供随后自证的载荷，见模块头）。
export storeReadFastEff : String -> String -> String -> Eff hostRow (Maybe String)
storeReadFastEff tag codec path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then do
    raw <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
    pure (storeDecodeFast tag codec raw)
  else pure Nothing

-- | 读 + 校验「头里的内容地址 == 期望值」（不重算；见 `storeDecodeAs`）。
export storeReadAsEff : String -> String -> String -> String -> Eff hostRow (Maybe String)
storeReadAsEff tag codec digest path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then do
    raw <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
    pure (storeDecodeAs tag codec digest raw)
  else pure Nothing

-- | 写（原子替换）。返回写入字节数。
export storeWriteEff : String -> String -> String -> String -> Eff hostRow Int
storeWriteEff tag codec path payload =
  raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic path (storeEncode tag codec payload))

-- | 写，但用调用方给的载荷摘要（已算过强哈希时用，见 `storeEncodeAs`）。
export storeWriteAsEff : String -> String -> String -> String -> String -> Eff hostRow Int
storeWriteAsEff tag codec digest path payload =
  raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic path (storeEncodeAs tag codec digest payload))

-- | 内容不变就不写：避免无意义地刷新 mtime / 制造写放大。
export storeWriteIfChangedEff : String -> String -> String -> String -> Eff hostRow Int
storeWriteIfChangedEff tag codec path payload =
  let
    raw = storeEncode tag codec payload
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
    if exists then do
      old <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
      if old == raw then pure 0 else raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic path raw)
    else raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic path raw)

-- | 同 `storeWriteIfChangedEff`，但内容地址由调用方给出（见 `storeEncodeAs`）。
export storeWriteIfChangedAsEff : String -> String -> String -> String -> String -> Eff hostRow Int
storeWriteIfChangedAsEff tag codec digest path payload =
  let
    raw = storeEncodeAs tag codec digest payload
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
    if exists then do
      old <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
      if old == raw then pure 0 else raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic path raw)
    else raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic path raw)

export storeFileExistsEff : String -> Eff hostRow Bool
storeFileExistsEff path = raiseToRow hostRow (@vuna@prim_eff_fileExists path)

export storeRemoveEff : String -> Eff hostRow Int
storeRemoveEff path = raiseToRow hostRow (@vuna@prim_eff_removeFile path)

-- | 逐级创建目录（`@vuna@prim_eff_makeDir` 只建一层）。路径是文件系统图，用显式 fuel 守卫。
export storeEnsureDirEff : String -> Eff hostRow Int
storeEnsureDirEff path = storeEnsureDirFuel 256 path

-- | 建目录（幂等）。
--
-- 并发注意：`vuna test --jobs N` / 并行 workspace check 会有多个进程同时建同一个缓存目录。
-- 「先 exists 再 makeDir」有 TOCTOU 窗口（两个进程都看到不存在，第二个 makeDir 抛
-- `File exists`）——宿主 `makeDir` 不幂等，语言里也没有 try/catch。所以末级创建走
-- `mkdir -p`（幂等 + 一次建完整条链），existence 检查只用于快速短路。
storeEnsureDirFuel : Int -> String -> Eff hostRow Int
storeEnsureDirFuel fuel path = if fuel <= 0 then pure 0
else if path == "" || path == "." || path == "/" then pure 0
else do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then pure 0 else raiseToRow hostRow (@vuna@prim_eff_runIn "." ["mkdir", "-p", path])

storeParentOf : String -> String
storeParentOf path =
  let
    rev = strUnpack path
    after = storeDropPastSlash (reverse rev)
  in if length after == length (reverse rev) then "."
  else
    let
      p = strPack (reverse after)
    in if p == "" then if startsWith "/" path then "/" else "."
    else if startsWith "/" path && not (startsWith "/" p) then "/${p}" else p

-- | 文件路径的父目录（`/a/b` → `/a`；`a` → `.`；`/a` → `/`）。对外导出给缓存路径使用。
export storeParentPathOf : String -> String
storeParentPathOf = storeParentOf

storeDropPastSlash : List Int -> List Int
storeDropPastSlash [] = []
storeDropPastSlash (c :: rest) = if c == 47 then rest else storeDropPastSlash rest

-- ---------------------------------------------------------------
-- 输入寻址对象库（终态存储层）
--
-- 与上面的「路径由调用方给定」这一档并存：调用方把**输入摘要**当路径传进来，于是
-- 「命中」退化为一次路径存在性检查——不需要索引、不需要依赖快照比较、不需要写锁。
-- 载荷自身的完整性仍由 framing 头里的内容地址兜底：读侧重算，不符即 `Nothing`
-- （调用方按 miss 重算并覆盖写同一路径）。
--
--   根/objects/<kind>/<inputDigest>          单文件载荷（0 字节 = 纯存在性标记）
--   根/views/<kind>/<inputDigest>/           目录载荷 + `.complete`（内容 = inputDigest）
--   根/roots/<projectId>                     文本：每行一个受保护 digest（只由项目追加）
--   根/.tmp/<kind>-<inputDigest>/            视图暂存（`mkdir` 原子独占，发布后 rename）
-- ---------------------------------------------------------------
-- | 存储根：持久、跨项目、可复制；也是唯一根（不再有 `$TMPDIR` 缓存根）。
--
-- **可写性兜底**：`$HOME` 可能是只读挂载（沙箱 / CI 容器 / Nix 构建里的
-- `/homeless-shelter`）。所以真正动手写之前先确认根可用：`isDirectory` 命中就直接用；
-- 否则 `mkdir -p`（子进程，能看返回码、不会抛异常）；仍失败则回落到 `$TMPDIR/vuna-store`。
-- 回退是**按环境确定性**的：同一环境下每次都会选同一个根。
export storeRootEff : Eff hostRow String
storeRootEff = storeDataRootEff

fallbackRootEff : Eff hostRow String
fallbackRootEff = do
  tmp <- raiseToRow hostRow (@vuna@prim_eff_getenv "TMPDIR")
  pure (if tmp == "" then "/tmp/vuna-store" else "${tmp}/vuna-store")

-- | 解析并**确保可用**的存储根（先 `isDirectory`，再 `mkdir -p`，最后回落 `$TMPDIR`）。
export storeRootReadyEff : Eff hostRow String
storeRootReadyEff = do
  primary <- storeDataRootEff
  ok <- dirReady primary
  if ok then pure primary
  else do
    alt <- fallbackRootEff
    ok2 <- dirReady alt
    if ok2 then pure alt else pure alt

-- 目录是否存在且是目录（`isDirectory` 在路径不存在时会抛，所以先 `fileExists`）。
dirReady : String -> Eff hostRow Bool
dirReady path = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if not exists then do
    code <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["mkdir", "-p", path])
    pure (code == 0)
  else raiseToRow hostRow (@vuna@prim_eff_isDirectory path)

-- | 对象的 framing tag：kind 参与，使不同载荷族不可能互读。
export storeObjectTag : String -> String
storeObjectTag kind = "vuna-object 1/${kind}"

objectPathIn : String -> String -> String -> String
objectPathIn root kind digest = "${root}/objects/${kind}/${digest}"

export storeObjectPathEff : String -> String -> Eff hostRow String
storeObjectPathEff kind digest = do
  root <- storeRootReadyEff
  pure (objectPathIn root kind digest)

-- | 命中判定：路径存在性（不做内容校验，内容校验在真正读取时做）。
export storeObjectExistsEff : String -> String -> Eff hostRow Bool
storeObjectExistsEff kind digest = do
  path <- storeObjectPathEff kind digest
  raiseToRow hostRow (@vuna@prim_eff_fileExists path)

-- | 读对象 + 全量校验（magic/tag/codec/长度/重算内容地址）。
export storeObjectReadEff : String -> String -> String -> Eff hostRow (Maybe String)
storeObjectReadEff kind codec digest = do
  path <- storeObjectPathEff kind digest
  storeReadEff (storeObjectTag kind) codec path

-- | 写对象（原子替换；内容不变不写）。
export storeObjectWriteEff : String -> String -> String -> String -> Eff hostRow Int
storeObjectWriteEff kind codec digest payload = do
  root <- storeRootReadyEff
  _ <- storeEnsureDirEff "${root}/objects/${kind}"
  path <- storeObjectPathEff kind digest
  storeWriteIfChangedEff (storeObjectTag kind) codec path payload

-- | 列出某 kind 下的全部对象摘要（GC 用；目录不存在 ⇒ 空）。
export storeObjectListEff : String -> Eff hostRow (List String)
storeObjectListEff kind = do
  root <- storeRootReadyEff
  let
    dir = "${root}/objects/${kind}"
  in do
    isDir <- dirReady dir
    if isDir then raiseToRow hostRow (@vuna@prim_eff_readDir dir) else pure []

-- | 删除一个对象；缺失不报错（GC 的删除是幂等的）。
export storeObjectRemoveEff : String -> String -> Eff hostRow Int
storeObjectRemoveEff kind digest = do
  path <- storeObjectPathEff kind digest
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then raiseToRow hostRow (@vuna@prim_eff_removeFile path) else pure 0

-- ---------------------------------------------------------------
-- 目录视图（构建产物 / 物化包源码）
--
-- 目录不能像单文件那样原子替换，所以约定：**只在 `.tmp/` 里建，建完 rename 发布**，
-- `.complete`（内容 = inputDigest）是提交点。读侧先验 `.complete`，不符即视为不存在。
-- 同一 inputDigest 的并发构建由 `mkdir` 原子性互斥（见 `storeScratchClaimEff`）。
-- ---------------------------------------------------------------
export storeViewPathEff : String -> String -> Eff hostRow String
storeViewPathEff kind digest = do
  root <- storeRootReadyEff
  pure "${root}/views/${kind}/${digest}"

export storeViewValidEff : String -> String -> Eff hostRow Bool
storeViewValidEff kind digest = do
  dir <- storeViewPathEff kind digest
  let
    marker = "${dir}/.complete"
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists marker)
    if exists then do
      text <- raiseToRow hostRow (@vuna@prim_eff_readFile marker)
      pure (text == digest)
    else pure False

-- | 默认视图的构建锁：`mkdir` 原子互斥；与 scratch 目录分开，避免把“构建中”误判为
-- 已有完整视图。持锁者**直接在最终 view 路径构建**（保持 codegen 绝对路径稳定）。
export storeViewLockEff : String -> String -> Eff hostRow Bool
storeViewLockEff kind digest = do
  root <- storeRootReadyEff
  let
    path = "${root}/.tmp/lock-${kind}-${digest}"
  in do
    _ <- storeEnsureDirEff (storeParentPathOf path)
    claimAt path

claimAt : String -> Eff hostRow Bool
claimAt path = do
  code <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["mkdir", path])
  if code == 0 then pure True
  else do
    stale <- scratchStale path
    if not stale then pure False
    else do
      _ <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", path])
      code2 <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["mkdir", path])
      pure (code2 == 0)

export storeViewUnlockEff : String -> String -> Eff hostRow Int
storeViewUnlockEff kind digest = do
  root <- storeRootReadyEff
  raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", "${root}/.tmp/lock-${kind}-${digest}"])

-- | 视图暂存目录（同一 inputDigest 唯一）。
storeScratchPathIn : String -> String -> String -> String
storeScratchPathIn root kind digest = "${root}/.tmp/${kind}-${digest}"

export storeScratchPathEff : String -> String -> Eff hostRow String
storeScratchPathEff kind digest = do
  root <- storeRootReadyEff
  pure (storeScratchPathIn root kind digest)

-- 暂存目录过期阈值（秒）：崩溃残留不永久阻塞后来者。
scratchStaleSec : Int
scratchStaleSec = 600

scratchStale : String -> Eff hostRow Bool
scratchStale path = do
  mtime <- raiseToRow hostRow (@vuna@prim_eff_fileMtime path)
  us <- effTimeUs
  pure (mtime + scratchStaleSec < us / 1000000)

-- | 独占一个暂存目录：`mkdir` 原子成功 ⇒ True。已被占用时看是否过期，过期则强删重试一次。
export storeScratchClaimEff : String -> String -> Eff hostRow Bool
storeScratchClaimEff kind digest = do
  path <- storeScratchPathEff kind digest
  _ <- storeEnsureDirEff (storeParentPathOf path)
  code <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["mkdir", path])
  if code == 0 then pure True
  else do
    stale <- scratchStale path
    if not stale then pure False
    else do
      _ <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", path])
      code2 <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["mkdir", path])
      pure (code2 == 0)

export storeScratchPathOfClaim : String -> String -> Eff hostRow String
storeScratchPathOfClaim = storeScratchPathEff

-- | 放弃暂存目录（构建失败或发布失败）。
export storeScratchDropEff : String -> String -> Eff hostRow Int
storeScratchDropEff kind digest = do
  path <- storeScratchPathEff kind digest
  raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", path])

-- | 发布暂存目录：写 `.complete` 后 `mv` 到视图位置。目标已存在（并发先到者）则丢弃暂存。
export storeViewPublishEff : String -> String -> Eff hostRow Int
storeViewPublishEff kind digest = do
  scratch <- storeScratchPathEff kind digest
  view <- storeViewPathEff kind digest
  _ <- storeEnsureDirEff (storeParentPathOf view)
  _ <- raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic "${scratch}/.complete" digest)
  code <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["mv", scratch, view])
  if code == 0 then pure 0
  else do
    _ <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", scratch])
    pure 0

-- ---------------------------------------------------------------
-- roots（GC 的保护集）
--
-- roots 由**项目**追加（逻辑归属），但物理放在 store 里（GC 需要能枚举全部项目）。
-- 项目不需要认识别的项目：它只写自己那一行；GC 读全部 roots 取并集。
-- ---------------------------------------------------------------
export storeRootsPathEff : String -> Eff hostRow String
storeRootsPathEff projectId = do
  root <- storeRootReadyEff
  pure "${root}/roots/${projectId}"

-- 行去重（line 已存在即返回原列表）；roots 文件很小，线性足够。
insertRootLine : String -> List String -> List String
insertRootLine line lines = if memName line lines then lines else line :: lines

mergeRootLines : List String -> List String -> List String
mergeRootLines lines [] = lines
mergeRootLines lines (d :: rest) = mergeRootLines (insertRootLine d lines) rest

-- | 追加受保护摘要。布局 = `roots/<project>/<digest>`，每个摘要一个文件：
-- 并发追加互不覆盖（没有读-改-写），GC 仍按 digest 集合保留。旧布局
-- `roots/<project>`（单文件）在读取侧兼容，写侧只写新布局。
export storeRootAppendEff : String -> List String -> Eff hostRow Int
storeRootAppendEff projectId digests = do
  dir <- storeRootsPathEff projectId
  _ <- storeEnsureDirEff dir
  writeRootFiles dir digests

writeRootFiles : String -> List String -> Eff hostRow Int
writeRootFiles _ [] = pure 0
writeRootFiles dir (d :: rest) = do
  _ <- storeEnsureDirEff dir
  _ <- raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic "${dir}/${d}" "")
  n <- writeRootFiles dir rest
  pure (n + 1)

-- | 读一个项目的 root 摘要：新布局（目录）逐文件读；旧布局（单文件）逐行读。
export storeRootLoadEff : String -> Eff hostRow (List String)
storeRootLoadEff projectId = do
  path <- storeRootsPathEff projectId
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory path)
    if isDir then raiseToRow hostRow (@vuna@prim_eff_readDir path)
    else do
      text <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
      pure (filter (\l => strLength l > 0) (split "\n" text))
  else pure []

-- | 列出全部项目的 roots 文件名（GC 用）。
export storeRootProjectListEff : Eff hostRow (List String)
storeRootProjectListEff = do
  root <- storeRootReadyEff
  let
    dir = "${root}/roots"
  in do
    isDir <- dirReady dir
    if isDir then raiseToRow hostRow (@vuna@prim_eff_readDir dir) else pure []

-- | 删除一个项目的 roots（新布局目录 / 旧布局文件都清）。
export storeRootRemoveEff : String -> Eff hostRow Int
storeRootRemoveEff projectId = do
  path <- storeRootsPathEff projectId
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory path)
    if isDir then raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", path])
    else raiseToRow hostRow (@vuna@prim_eff_removeFile path)
  else pure 0
