-- | 规范编码门面：Core 项 / Frontend AST / 精化产物的内容寻址字节格式。
module Vuna.Compiler.Canonical
  ( module Vuna.Compiler.Canonical.Ast
  , module Vuna.Compiler.Canonical.Bytes
  , module Vuna.Compiler.Canonical.CoreTerm
  , module Vuna.Compiler.Canonical.Elab
  ) where

-- Vuna.Compiler.Canonical：内容寻址的**规范编码**层（D5 / C32 哈希输入侧）。
--
-- 分工：
--   * `Bytes`：原子文法与解码器原语（自定界、累积器风格）；
--   * `Term`：Core `Term`（丢弃 `TVar` 的 span）；
--   * `Ast`：Frontend `Expr`/`Pat`/`Decl`（全部 span 丢弃；codegen 单元 key 用）；
--   * `Elab`：`DtDef`/`DtData`/`DtInst`/`DtClass`/`RecordMeta`/`ExportEntry`/
--     `FixityDecl`/`Import`（iface 哈希的输入域）。
--
-- 为什么不是 `prim_marshal`：Marshal 的字节是「本编译器表示」的函数（含 span、随字段
-- 顺序/版本漂移），而内容寻址要求「同内容 ⇒ 同字节」。编码规则见 `Bytes` 模块注释；
-- roundtrip（`dec` 后重编码逐字节一致）由 `examples/infra` 的 §64 断言。
import Vuna.Compiler.Canonical.Ast
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Canonical.Elab
import Vuna.Compiler.Canonical.CoreTerm
