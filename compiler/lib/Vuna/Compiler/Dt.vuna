module Vuna.Compiler.Dt
  ( dtCheckFile
  , dtCheckLibrary
  , dtCheckProject
  , dtCompileFile
  , dtCompileProject
  , dtEvalFile
  ) where

-- Vuna.Compiler.Dt：DT 路径的 facade（供 Compile / CompilerCli / Interp 使用）。
--
-- M13 时 DT 是单文件自包含：parseSource → Elab →（check / codegen / 核心求值），
-- 不经过 Loader、拒绝模块头与 import。**M20 起改为复用 `Loader`**：多文件、`import`、
-- `--root` 与包目录都能用，名字解析完全交给既有 Loader（不新建平行 Loader）。
--
-- 两条加载形状：
--   - 单文件 / `--root`：`loadProgramRaw`（入口声明 + 依赖模块，历史顺序不变）；
--   - 包目录（M22.1）：`loadProject` / `loadProjectModules` + `resolveProject`，
--     再按**依赖顺序**拼接（见 `dtProjectDecls`）。
-- DT 精化器按**整程序**精化，模块边界对精化不构成约束。
import Vuna.Compiler.Common
import Vuna.Compiler.Ast
import Vuna.Compiler.Parser
import Vuna.Compiler.Pkg
import Vuna.Compiler.Loader
import Vuna.Compiler.Core
import Vuna.Compiler.Elab
import Vuna.Compiler.CoreCodegen

-- 入口 + 全部依赖模块的声明（单文件 / --root 原始模式）。
dtLoad : List String -> String -> Result (List Decl)
dtLoad roots entry = loadProgramRawOrdered roots entry

-- 项目声明的拼接顺序：Loader 的 modules 列表是「依赖在前」的**反序**（依赖者先
-- 出现，被依赖者靠后），DT 精化要求定义先于使用，因此先 reverse modules 再逐模块
-- 拼接，入口声明放最后。
dtProjectDecls : Pair (List Decl) (List Module) -> List Decl
dtProjectDecls parts = append (concatMap moduleDeclsOf (reverse (secondOf parts))) (firstOf parts)

-- 包模式：可执行包（app/Main.vuna 为入口，root/包名来自 Pkg.packageRoots / packageName）。
dtLoadProject : List Root -> String -> String -> Result (List Decl)
dtLoadProject roots entryPkg entry =
  andThen (loadProject roots entryPkg entry)
    (\project => andThen (resolveProject project) (\parts => Ok (dtProjectDecls parts)))

-- 包模式：库包（以 [export].modules 为入口集合，没有 app/Main.vuna）。
dtLoadModuleSet : List Root -> String -> List String -> Result (Pair (List Decl) Bool)
dtLoadModuleSet roots entryPkg names =
  andThen (loadProjectModules roots entryPkg names)
    (\project => andThen (resolveProject project) (\parts => Ok (Pair (dtProjectDecls parts) (dtLibraryTrust entryPkg (secondOf parts)))))

-- 终止性检查的 TCB 信任名单：编译器本体与工具链是执行代码，NbE/重写函数是 fuel 驱动
-- 的（结构递归判据写不出来），对这三包跳过终止性检查；用户包与夹具仍然照查。
-- 与 Loader.packageAllowsEffects 同为「按包名 allowlist」的既有机制。
dtTrustsTermination : String -> Bool
dtTrustsTermination pkg = pkg == "vuna" || pkg == "vuna-compiler" || pkg == "vuna-base"

-- 库包的信任判定：入口包本身在名单里，或**所有被检查模块**都属于名单内的包。
-- 后者服务探针（用一个受信任模块当入口检查闭包，探针包自身不在名单里）；
-- 用户库包有自己的模块，因此不会被误信任。
dtLibraryTrust : String -> List Module -> Bool
dtLibraryTrust entryPkg modules = dtTrustsTermination entryPkg || dtModulesTrusted modules

dtModulesTrusted : List Module -> Bool
dtModulesTrusted modules = case modules of
  [] => True
  m :: rest => if dtTrustsTermination (modulePackageOf m) then dtModulesTrusted rest else False

-- 声明序列的 check / compile 共用尾部（单文件与包模式同一条精化路径）。
dtCheckDecls : Bool -> Result (List Decl) -> Result (List String)
dtCheckDecls trusted loaded =
  andThen loaded
    (\decls => andThen (elabProgramWith trusted decls) (\program => andThen (checkDtProgram program) (\_ => Ok [])))

dtCompileDecls : Bool -> Result (List Decl) -> Bool -> Result String
dtCompileDecls trusted loaded printResult =
  andThen loaded
    (\decls => andThen (elabProgramWith trusted decls) (\program => generateDtProgram program printResult))

dtCheckFile : List String -> String -> Result (List String)
dtCheckFile roots entry = dtCheckDecls False (dtLoad roots entry)

dtCompileFile : List String -> String -> Bool -> Result String
dtCompileFile roots entry printResult = dtCompileDecls False (dtLoad roots entry) printResult

dtCheckProject : List Root -> String -> String -> Result (List String)
dtCheckProject roots entryPkg entry =
  dtCheckDecls (dtTrustsTermination entryPkg) (dtLoadProject roots entryPkg entry)

dtCompileProject : List Root -> String -> String -> Bool -> Result String
dtCompileProject roots entryPkg entry printResult =
  dtCompileDecls (dtTrustsTermination entryPkg) (dtLoadProject roots entryPkg entry) printResult

dtCheckLibrary : List Root -> String -> List String -> Result (List String)
dtCheckLibrary roots entryPkg names = case dtLoadModuleSet roots entryPkg names of
  Err e => Err e
  Ok (Pair decls trust) => dtCheckDecls trust (Ok decls)

-- 核心求值器：精化后用 NbE + delta 求 main 的值并 show（与 codegen 结果对照）。
dtEvalFile : List String -> String -> Result String
dtEvalFile roots entry =
  andThen (dtLoad roots entry)
    (\decls => andThen (elabProgramWith False decls) (\program => evalDtMain program))

-- main : IO a 的执行（M21，对齐 HM ioRunExpr）：先归约 main 到 IO 构造子
-- （`MkIO f`），再对世界令牌 0 应用 `f 0` 并继续归约。IO 的识别按 main 的
-- **类型**（`isIOType`，族名 `IO`，含 `Base.IO.IO` 这类带模块前缀的名字）；
-- 纯值的 main 仍按 VInt/VStr/VBool 直接显示。
evalDtMain : Pair (List DtData) (List DtDef) -> Result String
evalDtMain (Pair _ defs) = case findMainDef defs of
  Nothing => Err "DT: no main definition"
  Just mainDef =>
    let
      table = defTableOf defs
      mainVal = normalize table [] defaultFuel (VNeutral (NGlobal "main" []))
    in if isIOType (dtDefType mainDef) then case mainVal of
      VCon _ args => case reverse args of
        f :: _ => Ok (showValueResult (normalize table [] defaultFuel (applyValue f (VInt 0))))
        [] => Err "DT: main : IO a but its constructor has no arguments"
      _ => Err "DT: main does not reduce to an IO action"
    else case mainVal of
      VInt n => Ok (strFromInt n)
      VStr s => Ok (showValue mainVal)
      VBool b => Ok (showValue mainVal)
      _ => Err "DT: main does not reduce to a value"

-- 族名（去掉模块前缀）：`Base.IO.IO` → `IO`。
lastName : String -> String
lastName name = case splitLastDot (splitOnDot name) of
  Pair rev base => base

-- main 的类型是不是 `IO a`（族名对得上，含模块前缀形态）。
isIOType : Term -> Bool
isIOType t = case t of
  TApp fn _ _ => isIOType fn
  TGlobal g => lastName g == "IO"
  _ => False

-- IO 动作的结果与普通 main 的结果统一显示：Int 用 strFromInt，其余交给 showValue。
showValueResult : Value -> String
showValueResult v = case v of
  VInt n => strFromInt n
  _ => showValue v

findMainDef : List DtDef -> Maybe DtDef
findMainDef [] = Nothing
findMainDef (d :: rest) = if dtDefName d == "main" then Just d else findMainDef rest

defTableOf : List DtDef -> List (Pair String Term)
defTableOf [] = []
defTableOf (d :: rest) = Pair (dtDefName d) (dtDefBody d) :: defTableOf rest
