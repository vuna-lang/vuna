module Vuna.Compiler.Elab.Prelude where

-- Vuna.Compiler.Elab.Prelude：把 `Vuna.Compiler.Intrinsics` 的**唯一内建声明表**翻译成
-- DT 的 prelude globals（签名项）。M27 起这里不再有第二份名字/签名表：
--
--   - `Int` / `String` 是语言 primitive 类型；`Bool` 是 base 的普通 data 声明
--     （canonical `Base.Bool.Bool`，`True`/`False` 精化成 `TBool`）；
--   - `List` 的签名参数固定绑定 base 的普通 data 声明 `Base.List.List`（完整符号，
--     固定为 canonical，不按短名挑选）；
--   - 效果原语只有 `prim_*` 名，签名与能力位都在 Intrinsics 表里。
--
-- 名字解析（arity/放行/能力）在 `Loader.Resolve`，runtime 映射在 `Codegen.Term`，
-- interp 归约在 `Core.Eval`——三处都消费同一张表。
import Vuna.Compiler.Common
import Vuna.Compiler.Core
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Intrinsics

export intTy : Term
intTy = TGlobal intTypeName

export strTy : Term
strTy = TGlobal strTypeName

-- | 内建 `Float` 类型名对应的核心项（`TGlobal floatTypeName`）。
export floatTy : Term
floatTy = TGlobal floatTypeName

boolTy : Term
boolTy = TGlobal boolTypeName

-- `a -> b -> c` 的签名拼接（b/c 按外层 binder 深度移位）。
export fun2 : Term -> Term -> Term -> Term
fun2 a b c = TPi "_" False RigOmega a (TPi "_" False RigOmega (shift 0 1 b) (shift 0 2 c))

-- ---------------------------------------------------------------
-- `eq` / `neq` 的跨类型特化
-- ---------------------------------------------------------------
-- M31.1：`==` / `/=` 已变成 `eq` / `neq` 的解析期别名（Loader），所以特化按**方法短名**
-- （`eq` / `neq`）选 runtime 函数名。特化在精化期完成，codegen 只按名字映射。
-- 内建类型名（`VNeutral (NGlobal g [])` 形态）。
export builtinTyName : Value -> Maybe String
builtinTyName v = case v of
  VNeutral n => case n of
    -- M29：用 `length`（Int 的 `==` 是特化路径），不依赖 List 的泛型结构比较兜底。
    NGlobal g sp => if length sp == 0 then Just g else Nothing
    _ => Nothing
  _ => Nothing

-- 按实参类型 + 方法短名选 runtime 函数名（只有 Int / String 可特化；其它类型走 Eq 字典）。
-- | 自动补注（M41 新增导出）：eqRuntimeName。
export eqRuntimeName : String -> String -> Check String
eqRuntimeName method "Int" = if method == "eq" then OkC "bi_eq_int" else OkC "bi_neq_int"
eqRuntimeName method "String" = if method == "eq" then OkC "bi_eq_str" else OkC "bi_neq_str"
eqRuntimeName method "Float" = if method == "eq" then OkC "bi_eq_float" else OkC "bi_neq_float"
eqRuntimeName method tyName = ErrC (tcMsg (OpOnlyIntString method tyName) [method, tyName])

-- ---------------------------------------------------------------
-- IType → Core Term
-- ---------------------------------------------------------------
-- 签名里的类型变量用名字 + binder 环境换成 de Bruijn（M33 W3：Array / IORef 等
-- 内建类型构造子的签名带隐式 `{a : Type}`）。所有 IType 都是闭项或无自由变量。
indexOfNameGo : String -> List String -> Int -> Maybe Int
indexOfNameGo name [] i = Nothing
indexOfNameGo name (x :: rest) i = if x == name then Just i else indexOfNameGo name rest (i + 1)

indexOfName : String -> List String -> Maybe Int
indexOfName name env = indexOfNameGo name env 0

ityToTerm : IType -> Term
ityToTerm ty = ityToTermEnv [] ty

ityToTermEnv : List String -> IType -> Term
ityToTermEnv env ITy = TType levelZero
ityToTermEnv env IInt = intTy
ityToTermEnv env IStr = strTy
ityToTermEnv env IFloat = floatTy
ityToTermEnv env IBool = boolTy
ityToTermEnv env INat = TGlobal natTypeName
ityToTermEnv env (IList elem) = TApp (TGlobal listFamilyName) (ityToTermEnv env elem) Rig0
-- 统一动作类型入口：`Eff [] a`（行必须是 Nil；宿主原语不携带用户效应）。
ityToTermEnv env (IEff elem) =
  TApp (TApp (TGlobal effTypeName) (TCon effRowNilCtor []) Rig0) (ityToTermEnv env elem) Rig0
-- 阶段 0 spike：内建宿主效应的行项与带行动作（构造 Core 的 `Cons name label tail`）。
ityToTermEnv env IRowNil = TCon effRowNilCtor []
ityToTermEnv env (IRowCons name label tail) =
  TCon effRowConsCtor
    [Pair (TStr name) Rig0, Pair (ityToTermEnv env label) Rig0, Pair (ityToTermEnv env tail) Rig0]
ityToTermEnv env (IGlobal n) = TGlobal n
ityToTermEnv env (IEffRow row elem) =
  TApp (TApp (TGlobal effTypeName) (ityToTermEnv env row) Rig0) (ityToTermEnv env elem) Rig0
-- cod 在 binder 下：env 加匿名占位，保证外层 IVar 的 de Bruijn 索引随 Pi 深度 shift。
ityToTermEnv env (IFun a b) =
  TPi "_" False RigOmega (ityToTermEnv env a) (ityToTermEnv ("_" :: env) b)
ityToTermEnv env (IFun1 a b) = TPi "_" False Rig1 (ityToTermEnv env a) (ityToTermEnv ("_" :: env) b)
ityToTermEnv env (IVar name) = case indexOfName name env of
  Just i => TVar name i (Span "" 0 0 0 0)
  Nothing => TGlobal name
ityToTermEnv env (IArray elem) = TApp (TGlobal "Array") (ityToTermEnv env elem) Rig0
ityToTermEnv env (IRef elem) = TApp (TGlobal "IORef") (ityToTermEnv env elem) Rig0
ityToTermEnv env (IPi name body) =
  TPi name True Rig0 (TType levelZero) (ityToTermEnv (name :: env) body)

-- ---------------------------------------------------------------
-- prelude globals / 名字名单
-- ---------------------------------------------------------------
-- 类型层：primitive 类型名（`Int : Type` 等）+ 内建类型构造子（`Array : Type -> Type`）。
typeCtorKindTerm : Int -> Term
typeCtorKindTerm arity =
  if arity <= 0 then TType levelZero
  else TPi "_" False Rig0 (TType levelZero) (typeCtorKindTerm (arity - 1))

-- | prelude 类型层全局：primitive 类型名 + 内建类型构造子的 kind。
preludeTypeGlobals : List (Pair String Term)
preludeTypeGlobals =
  append (map (\n => Pair n (TType levelZero)) typeIntrinsicNames)
    (map (\t => Pair (typeIntrinsicCtorName t) (typeCtorKindTerm (typeIntrinsicCtorArity t))) typeIntrinsicArities)

export preludeValueGlobals : List (Pair String Term)
preludeValueGlobals =
  map (\i => Pair (intrinsicName i) (ityToTerm (intrinsicSignature i))) userIntrinsics

-- 编译器 tracing 的隐藏原语签名：只进 prelude globals（供 `dbg!` 展开后的
-- `@vuna@…` 类型检查），不进 `preludeValueNames`/用户可见名单。
internalValueGlobals : List (Pair String Term)
internalValueGlobals =
  map (\i => Pair (intrinsicName i) (ityToTerm (intrinsicSignature i))) internalIntrinsics

export preludeGlobals : List (Pair String Term)
preludeGlobals = append preludeTypeGlobals (append preludeValueGlobals internalValueGlobals)

-- 「禁止重定义」名单：primitive 类型名 + 内建类型构造子 + 全部用户可见内建值名。
-- 只在入口（ad-hoc）文件里可能命中——模块内声明会被 mangle 成 `<Module>.name`。
export preludeNames : List String
preludeNames = append preludeTypeNames preludeValueNames

-- 只认内建可特化类型（`Int` / `String`）；其它类型在 DT 里走 `Eq` 实例。
export builtinEqTyName : Value -> Maybe String
builtinEqTyName v = case builtinTyName v of
  Just g =>
    if g == intTypeName then Just intTypeName
    else if g == strTypeName then Just strTypeName
    else if g == floatTypeName then Just floatTypeName else Nothing
  Nothing => Nothing

-- 比较运算符的运行时特化只认 Int / String / canonical Bool；其它类型（用户 data /
-- 刚性变量）必须走 Ord 字典。
export cmpBuiltinTyName : Value -> Maybe String
cmpBuiltinTyName v = case builtinTyName v of
  Just g =>
    if g == intTypeName then Just intTypeName
    else if g == strTypeName then Just strTypeName
    else if g == floatTypeName then Just floatTypeName
    else if g == boolTypeName then Just boolTypeName else Nothing
  Nothing => Nothing

-- 族名后的参数作为**隐式** binder 前置到 kind（`data List a : Type` 的 `a` + `Type`
-- ⇒ `{a : Type} -> Type`）。
export prependParams : List String -> Term -> Term
prependParams [] kindTerm = kindTerm
prependParams (p :: rest) kindTerm =
  TPi p False Rig0 (TType levelZero) (prependParams rest kindTerm)

-- ---------------------------------------------------------------
-- trait 库化后的类/方法查找辅助（放在本模块是为了压 Elab 的行数预算）
-- ---------------------------------------------------------------
baseNameOf : String -> String
baseNameOf name = case splitLastDot (splitOnDot name) of
  Pair rev base => base

-- 类方法（按短名）的投影全局名：Loader 把 trait 方法 mangle 成 `<模块前缀>.<方法短名>`。
export classMethodProjection : List (Pair String Term) -> String -> String
classMethodProjection methods short = classMethodProjectionGo short methods short

classMethodProjectionGo : String -> List (Pair String Term) -> String -> String
classMethodProjectionGo short [] fallback = fallback
classMethodProjectionGo short (m :: rest) fallback =
  if baseNameOf (firstOf m) == short then firstOf m else classMethodProjectionGo short rest fallback
