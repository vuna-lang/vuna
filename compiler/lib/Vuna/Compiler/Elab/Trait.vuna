-- Vuna.Compiler.Elab.Trait：trait/instance 声明与派生：类参数 kind、方法投影、实例头检查、
-- 实例方法体、字典提升、实例体批量调度、定义参数模式绑定与 `elabFunDef`；拆自 M24 的 `Elab.vuna`。
import Base.List
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Debug
import Vuna.Compiler.Core
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Elab.Dict
import Vuna.Compiler.Elab.InstCoherence
import Vuna.Compiler.Elab.InstName
import Vuna.Compiler.Elab.Match
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Sig
import Vuna.Compiler.Elab.Term
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Frontend.Ast

-- 类参数绑成隐式 binder 后的局部上下文。
-- M19：类参数可以是**高阶 kind**（`trait Mapper f`，方法签名里写 `f a`）。kind 从方法签名推断：
-- 参数名被应用了 k 个实参就当 `Type -> ... -> Type`（k 个箭头），从未被应用就是 `Type`。
bindClassParams : List (Pair String Term) -> Ctx -> Ctx
bindClassParams [] ctx = ctx
bindClassParams ((Pair p k) :: rest) ctx = bindClassParams rest (ctxBind p k ctx)

-- 每个方法的字段类型（在类参数 binders 之下检查）。
classFieldTys : List (Pair String Term) -> Ec -> List (Pair String Term) -> List (Pair String Expr) -> Check (Pair (List Term) Ec)
classFieldTys globals ec paramsKinds methods =
  classFieldTysGo globals (bindClassParams paramsKinds emptyCtx) ec methods []

classFieldTysGo : List (Pair String Term) -> Ctx -> Ec -> List (Pair String Expr) -> List Term -> Check (Pair (List Term) Ec)
classFieldTysGo globals ctx ec [] acc = OkC (Pair (reverse acc) ec)
classFieldTysGo globals ctx ec (m :: rest) acc = case m of
  Pair mname mexpr => Vuna.Compiler.Common.bind (checkType globals ctx ec (quantifyTraitSig (\nm => isJust (ctxLookup nm ctx)) mexpr (exprSpan mexpr))) (\p => case p of
    -- M20：trait 方法签名里的自由小写名（`fmap` 的 `a`/`b`）量化为隐式类型参数。
    Pair tyTerm (Pair sort ec1) => classFieldTysGo globals ctx ec1 rest (tyTerm :: acc)
  )

-- 批量把定义体塞进 Ec 的 defs 表（delta 展开用）。
foldlAddDef : Ec -> List (Pair String Term) -> Ec
foldlAddDef ec [] = ec
foldlAddDef ec (d :: rest) = foldlAddDef (ecAddDef ec d) rest

-- 字典构造子的字段 Pi 链。**每个字段的域都要按它前面已插入的字段 binder 数移位**：
-- 字段类型是相对「类参数 binder」精化的（类参数在 index 0），第 i 个字段的域在
-- Pi 链里已经跨过 i 个字段 binder，不移位就会把类参数指到前一个字段上
-- （`Eq` / `Ord` 的多方法签名曾因此渲染成 `unit`）。
foldPiFieldTys : List Term -> Term -> Term
foldPiFieldTys fieldTys ty = foldPiFieldTysGo fieldTys 0 ty

foldPiFieldTysGo : List Term -> Int -> Term -> Term
foldPiFieldTysGo [] n ty = ty
foldPiFieldTysGo (f :: rest) n ty =
  TPi "_" False RigOmega (shift 0 n f) (foldPiFieldTysGo rest (n + 1) ty)

-- 精化一个 trait：字典 DtData + 方法投影（签名 + 定义体）+ 类表项。
-- M29（A14）：额外返回「投影名 → 来源 span」表，供 `extraDefsOf` 给生成定义标来源；
-- M30（B20）方法签名带 span 后，这张表用**方法签名 span**（不再粗粒度到 trait 声明行）。
elabTrait : List (Pair String Term) -> Ec -> Pair Decl Span -> Check (Pair DtData (Pair (List (Pair String Term)) (Pair DtClass (Pair (List (Pair String Span)) Ec))))
elabTrait globals ec (Pair d dsp) = case d of
  DTrait tname params methods sp => if length params == 0 then tcErr0 sp InterfaceNoParam
  else
    let
      -- 方法投影/kind 推断仍吃 (名字, 类型) 对；span 只在 projSpans 里用。
      methodsP = traitMethodPairs methods
    in Vuna.Compiler.Common.bind (traitParamKinds globals ec params methodsP)
      (\pk => elabTraitKinds globals (secondOf pk) tname params methods methodsP (firstOf pk))
  _ => errAt dsp "DT: internal: expected a trait declaration"

-- 拿到类参数 kind 后：字段类型 → 字典族/构造子 → 投影 → 类表项。
elabTraitKinds : List (Pair String Term) -> Ec -> String -> List TraitParam -> List TraitMethod -> List (Pair String Expr) -> List Term -> Check (Pair DtData (Pair (List (Pair String Term)) (Pair DtClass (Pair (List (Pair String Span)) Ec))))
elabTraitKinds globals ec tname params methods methodsP pKinds =
  let
    paramNames = traitParamNames params
    paramsKinds = zip paramNames pKinds
  in Vuna.Compiler.Common.bind (classFieldTys globals ec paramsKinds methodsP)
    (\p => elabTraitFinal globals (secondOf p) tname paramNames methods methodsP pKinds (firstOf p))

elabTraitFinal : List (Pair String Term) -> Ec -> String -> List String -> List TraitMethod -> List (Pair String Expr) -> List Term -> List Term -> Check (Pair DtData (Pair (List (Pair String Term)) (Pair DtClass (Pair (List (Pair String Span)) Ec))))
elabTraitFinal globals ec tname paramNames methods methodsP pKinds fieldTys =
  let
    paramsKinds = zip paramNames pKinds
    dname = dictTypeName tname
    cname = dictCtorName tname
    dapp = dictAppTermOf dname paramNames
    ctorTy = foldParamPis paramsKinds (foldPiFieldTys fieldTys dapp)
    tele = teleOfType ctorTy
    dd =
      DtData dname tele [DtCtor cname dname tele ctorTy Nothing]
        (foldParamPis paramsKinds (TType levelZero)) [] False ReprAuto [] False
    projs = methodProjections tname paramNames pKinds methodsP fieldTys
    projSpans = map (\m => Pair (traitMethodName m) (traitMethodSpan m)) methods
    -- D27：字段（方法类型）在运行时不可表示 ⇒ 该方法的投影体里字典字段的使用要包 cast。
    -- 判定与 codegen 的字段 opaque 标志同源（`Elab.Meta.isOpaqueRuntimeTyIn`），上下文是
    -- 类参数 telescope（字段类型的自由变量正好是这些类参数）。
    fieldCtx = bindClassParams paramsKinds emptyCtx
    opaqueFields = map (\t => isOpaqueRuntimeTyIn ec fieldCtx (eval (ctxEnv fieldCtx) t)) fieldTys
    projBodies =
      projectionDefsOpaque opaqueFields tname (length paramNames) methodsP fieldTys (length methods)
    cls = DtClass tname paramNames projs fieldTys
    ec2 = ecAddClass (ecAddData ec dd) cls
    ec3 = foldlAddDef ec2 projBodies
  in OkC (Pair dd (Pair projs (Pair cls (Pair projSpans ec3))))

-- 逐参数推断 kind（多参数 trait 每个参数独立按它在方法签名里的应用次数定 kind）。
classParamKinds : List String -> List (Pair String Expr) -> List Term
classParamKinds [] methods = []
classParamKinds (p :: rest) methods = classParamKindOf p methods :: classParamKinds rest methods

-- 逐参数 kind：显式 `(p : Kind)` 直接精化；裸参数从方法签名推断。
traitParamNames : List TraitParam -> List String
traitParamNames [] = []
traitParamNames ((TraitParam name _) :: rest) = name :: traitParamNames rest

traitParamKinds : List (Pair String Term) -> Ec -> List TraitParam -> List (Pair String Expr) -> Check (Pair (List Term) Ec)
traitParamKinds globals ec [] methods = OkC (Pair [] ec)
traitParamKinds globals ec ((TraitParam pname pkind) :: rest) methods = case pkind of
  Just kexpr => traitKindExplicit globals ec kexpr rest methods
  Nothing => traitKindInfer globals ec pname rest methods

traitKindExplicit : List (Pair String Term) -> Ec -> Expr -> List TraitParam -> List (Pair String Expr) -> Check (Pair (List Term) Ec)
traitKindExplicit globals ec kexpr rest methods = Vuna.Compiler.Common.bind (checkType globals emptyCtx ec kexpr) (\pk => case pk of
  Pair kterm (Pair _ ec1) => Vuna.Compiler.Common.bind (traitParamKinds globals ec1 rest methods) (\pr => case pr of
    Pair ks ec2 => OkC (Pair (Base.List.Cons kterm ks) ec2)
  )
)

traitKindInfer : List (Pair String Term) -> Ec -> String -> List TraitParam -> List (Pair String Expr) -> Check (Pair (List Term) Ec)
traitKindInfer globals ec pname rest methods = Vuna.Compiler.Common.bind (traitParamKinds globals ec rest methods) (\pr => case pr of
  Pair ks ec2 => OkC (Pair (Base.List.Cons (classParamKindOf pname methods) ks) ec2)
)

-- 类参数 binder 的 Pi 链（外到内 = 声明顺序）。binder 是隐式擦除的（字典的类参数）。
foldParamPis : List (Pair String Term) -> Term -> Term
foldParamPis [] body = body
foldParamPis ((Pair p k) :: rest) body = TPi p True Rig0 k (foldParamPis rest body)

-- `Dict_C p1 .. pn`：实参 de Bruijn 索引按参数 binder 的声明顺序（pn = 0、p1 = n-1）。
dictAppTermOf : String -> List String -> Term
dictAppTermOf dname params = foldAppTerms (TGlobal dname) (dictParamArgs params (length params - 1))

dictParamArgs : List String -> Int -> List (Pair Term Rig)
dictParamArgs [] i = []
dictParamArgs (p :: ps) i = Pair (TVar p i (Span "" 0 0 0 0)) Rig0 :: dictParamArgs ps (i - 1)

-- trait 方法列表 → 旧内部形态（名字, 类型）对。span 走 `traitMethodSpan`。
traitMethodPairs : List TraitMethod -> List (Pair String Expr)
traitMethodPairs [] = []
traitMethodPairs (m :: rest) = Pair (traitMethodName m) m.traitMethodType :: traitMethodPairs rest

-- 方法投影的签名与定义体：
--   sig:  `{p1 : K1} -> ... -> {pn : Kn} -> {d : Dict_C p1..pn} -> <方法类型>`
--   body: `\p1 => ... \pn => \d => case d of MkDict_C f0..fn => fk x1..xar`
-- 字段 fk 对应第 k 个方法（与构造子字段声明顺序一致）。
--
-- M19：每个参数的 kind 由 `classParamKindOf` 从方法签名推断，高阶 kind（`Functor f` 的
-- `Type -> Type`）也按真实 kind 生成 binder，不再写死 `Type`。
methodProjections : String -> List String -> List Term -> List (Pair String Expr) -> List Term -> List (Pair String Term)
methodProjections tname params pKinds methods fieldTys =
  methodProjZip tname params pKinds 0 methods fieldTys

methodProjZip : String -> List String -> List Term -> Int -> List (Pair String Expr) -> List Term -> List (Pair String Term)
methodProjZip tname params pKinds idx [] fieldTys = []
methodProjZip tname params pKinds idx (m :: rest) [] = []
methodProjZip tname params pKinds idx ((Pair mname mexpr) :: rest) (t :: rest2) =
  Pair mname (methodProjType tname params pKinds t)
    :: methodProjZip tname params pKinds (idx + 1) rest rest2

-- 单个方法的投影签名：类参数 Pi 链 + 字典 Pi + 方法类型（按字典 binder 移位）。
methodProjType : String -> List String -> List Term -> Term -> Term
methodProjType tname params pKinds methodTy =
  let
    dictPi = TPi "_" True Rig0 (dictAppTermOf (dictTypeName tname) params) (shift 0 1 methodTy)
  in foldParamPis (zip params pKinds) dictPi

-- 投影的定义体：`\p1 .. \pn => \d => \x0 .. \x(ar-1) => case d of MkDict_C f0..fn => f_k x0..`
-- 签名 `{p1..pn} -> {d : Dict_C p1..pn} -> <方法类型>`；de Bruijn 索引：`_d = ar`（参数
-- binder 在 d 之外，不影响 d 的内层索引）、`f_k = n-1-k`、`x_i = n+(ar-1-i)`（最内层 = 0，
-- 分支绑定子 f 在方法参数之内）。单参数时参数 binder 仍是 `_p`，与历史生成代码逐字节一致。
-- `rigs` 是方法显式参数各自的 multiplicity（M19：从方法签名逐 binder 取，`binderRig` 判据与
-- 实例方法体一致）。**lambda 链与应用点必须用同一份 rigs**：擦除位既不生成运行时形参、也不传
-- 实参——两侧都跳过，才能与由 `checkDef` 生成的实例方法体（同样按 rig 跳过擦除位）严格对齐。
projectionBody : String -> Int -> List Rig -> Int -> Int -> Term
projectionBody ctor fieldIdx rigs nFields nParams =
  projectionBodyOpaque False ctor fieldIdx rigs nFields nParams

-- D27：字典字段（= 方法类型）在运行时不可表示时，字典构造子的字段在 OCaml 里被渲染成
-- 不透明值（`Obj.t`）。源码 case 由 `Elab.Term.Impl.opaqueBranchIndices` 给分支 binder 的
-- 每个使用点包表现层 cast；而这里生成的 `TCase` 不经过精化，所以字段变量的使用要自己包
-- `prim_erase`，否则 OCaml 侧会对 `Obj.t` 直接应用（`This is not a function`）。
projectionBodyOpaque : Bool -> String -> Int -> List Rig -> Int -> Int -> Term
projectionBodyOpaque fieldOpaque ctor fieldIdx rigs nFields nParams =
  let
    arity = length rigs
    -- scrutinee 在分支绑定子之外求值，所以只跨过方法参数（_d=ar；参数 binder 在 _d 之外）。
    dictIdx = arity
    fieldVar = TVar (fieldVarName fieldIdx) (nFields - 1 - fieldIdx) (Span "" 0 0 0 0)
    argPairs = methodArgTerms rigs nFields
    applied0 = foldAppTerms fieldVar argPairs
    applied = if fieldOpaque then wrapOpaqueUses [nFields - 1 - fieldIdx] applied0 else applied0
    binders = fieldBinderNames nFields
    alt = CaseAlt ctor binders applied
    caseTerm = TCase (TVar "_d" dictIdx (Span "" 0 0 0 0)) [alt]
    lamArgs = methodArgLams rigs 0 caseTerm
  in projectionParamLams (projectionParamNames nParams) (TLam "_d" RigOmega lamArgs)

-- 参数 lambda 链：单参数保持历史名字 `_p`，多参数用 `_p0 .. _p{n-1}`。
projectionParamLams : List String -> Term -> Term
projectionParamLams [] body = body
projectionParamLams (nm :: rest) body = TLam nm Rig0 (projectionParamLams rest body)

projectionParamNames : Int -> List String
projectionParamNames n = if n == 1 then ["_p"] else map (\i => "_p${i}") (range 0 n)

explicitPiArity : Term -> Int
explicitPiArity (TPi n implicit rig dom cod) =
  if implicit then explicitPiArity cod else 1 + explicitPiArity cod
explicitPiArity _ = 0

-- 投影定义表：每个方法一条 `m = <投影定义体>`。
projectionDefs : String -> Int -> List (Pair String Expr) -> List Term -> Int -> List (Pair String Term)
projectionDefs tname nParams methods fieldTys nFields =
  projectionDefsOpaque (map (\_ => False) fieldTys) tname nParams methods fieldTys nFields

-- D27：按 `opaqueFields`（与方法同序）决定每个投影体是否给字典字段变量包 cast。
projectionDefsOpaque : List Bool -> String -> Int -> List (Pair String Expr) -> List Term -> Int -> List (Pair String Term)
projectionDefsOpaque flags tname nParams methods fieldTys nFields =
  projectionDefsOpaqueGo flags (dictCtorName tname) nParams methods fieldTys 0 nFields

projectionDefsOpaqueGo : List Bool -> String -> Int -> List (Pair String Expr) -> List Term -> Int -> Int -> List (Pair String Term)
projectionDefsOpaqueGo flags ctor nParams [] fieldTys idx nFields = []
projectionDefsOpaqueGo flags ctor nParams (m :: rest) [] idx nFields = []
projectionDefsOpaqueGo flags ctor nParams ((Pair mname mexpr) :: rest) (t :: rest2) idx nFields =
  Pair mname (projectionBodyOpaque (flagAt idx flags) ctor idx (methodArgRigsOf binderRig t) nFields nParams)
    :: projectionDefsOpaqueGo flags ctor nParams rest rest2 (idx + 1) nFields

flagAt : Int -> List Bool -> Bool
flagAt i [] = False
flagAt i (b :: rest) = if i <= 0 then b else flagAt (i - 1) rest

projectionDefsGo : String -> Int -> List (Pair String Expr) -> List Term -> Int -> Int -> List (Pair String Term)
projectionDefsGo ctor nParams methods fieldTys idx nFields =
  projectionDefsOpaqueGo (map (\_ => False) fieldTys) ctor nParams methods fieldTys idx nFields

-- B23：实例落点静态检查（孤儿实例）。
--
-- 规则：实例可声明在**定义 trait 的模块**，或**定义 head 类型（任一参数）的模块**；
-- 内建类型（Int / String）视为全局可见，允许在任意模块声明实例（`Show Int` 这类
-- base / 用户扩展）。不做该检查时，实例可以散落到任意 import 双方的文件里，实例查找
-- 与 coherence 的可解释性都会变差；文档一直按落点规则描述，现在由精化器强制。
declTopName : Decl -> Maybe String
declTopName (DData n ps kind ctors derivings viaField repr lin sp) = Just n
declTopName (DRecord n ps fields derivings viaField repr lin sp) = Just n
declTopName (DTrait n ps methods sp) = Just n
declTopName _ = Nothing

declNamedInFile : List (Pair Decl Span) -> String -> String -> Bool
declNamedInFile [] name file = False
declNamedInFile ((Pair d sp) :: rest) name file = case declTopName d of
  Just n => if n == name && sp.spanFile == file then True else declNamedInFile rest name file
  Nothing => declNamedInFile rest name file

headTypeNameOf : Expr -> Maybe String
headTypeNameOf (EVar n sp) = Just n
headTypeNameOf (EApp fn args sp) = headTypeNameOf fn
headTypeNameOf _ = Nothing

headTypeNamesOf : List Expr -> List String
headTypeNamesOf [] = []
headTypeNamesOf (e :: rest) = case headTypeNameOf e of
  Just n => n :: headTypeNamesOf rest
  Nothing => headTypeNamesOf rest

-- 全局可见的内建类型（没有定义模块）：`Int` / `String` 与 M33 的内建类型构造子
-- `Array` / `IORef`。它们的实例可以声明在任意模块，
-- `base/lib/Base/{Array,IORef}.vuna` 是约定落点。
isGlobalHeadType : String -> Bool
isGlobalHeadType n = n == "Int" || n == "String" || n == "Float" || n == "Array" || n == "IORef"

instanceHeadTypeNames : Expr -> List String
instanceHeadTypeNames headExpr = case instanceHeadParts headExpr of
  Nothing => []
  Just (Pair cls args) => headTypeNamesOf args

anyDeclInFile : List (Pair Decl Span) -> List String -> String -> Bool
anyDeclInFile decls [] file = False
anyDeclInFile decls (n :: rest) file =
  if declNamedInFile decls n file then True else anyDeclInFile decls rest file

anyGlobalHead : List String -> Bool
anyGlobalHead [] = False
anyGlobalHead (n :: rest) = if isGlobalHeadType n then True else anyGlobalHead rest

instanceLandingOk : List (Pair Decl Span) -> Span -> DtClass -> Expr -> Bool
instanceLandingOk allDecls sp cls headExpr =
  let
    file = sp.spanFile
    headNames = instanceHeadTypeNames headExpr
  in declNamedInFile allDecls (dtClassName cls) file
    || anyDeclInFile allDecls headNames file
    || anyGlobalHead headNames

-- 实例落点通过后的正常实例精化（方法检查 + 字典项构造）。
elabInstanceWithClass : List (Pair String Term) -> List (Pair Decl Span) -> DtClass -> InstSigInfo -> Ec -> Expr -> List Decl -> Span -> Check (Pair (List (Pair String Term)) Ec)
elabInstanceWithClass globals allDecls cls info ec0 headExpr methods msp = case firstUnknownInstanceMethod cls methods of
  Just n => tcErr1 msp (InstanceUnknownMethod n) n
  Nothing => case firstMissingInstanceMethod cls methods of
    Just m => case traitMethodSpanOf (dtClassName cls) m allDecls of
      -- M30（B20）：缺方法指向 trait 里的**方法签名行**，而不是实例声明行。
      Just mspan => tcErr0 mspan InstanceMissingMethod
      Nothing => tcErr0 msp InstanceMissingMethod
    Nothing =>
      let
        bodyCtx = instBodyCtx info
        nCtx = length (instSigCtx info)
        nTele = length (instSigTele info)
        bodyDepth = nTele + nCtx
      in Vuna.Compiler.Common.bind (elabInstanceMethodsCtx globals cls bodyCtx nCtx (instSigArgs info) ec0 methods msp) (\q => case q of
        Pair fieldTerms (Pair fieldArgs ec1) =>
          let
            solvedCtx = solveCtxGoals bodyCtx nCtx nTele ec1 []
            ctxSubs = firstOf solvedCtx
            ec2 = secondOf solvedCtx
            fields1 = map (applyCtxSubstsTo nCtx ctxSubs) fieldTerms
          in Vuna.Compiler.Common.bind (resolveRigidGoals globals bodyCtx msp (ecPending ec2) [] ec2) (\r => case r of
            Pair globSubs ec3 =>
              let
                fields2 = map (applyTermSubstsTo bodyDepth globSubs) fields1
                iname = instanceName (dtClassName cls) headExpr
                dictTerm = instValueOf info (dictCtorName (dtClassName cls)) fields2
                dictTyTerm = instTypeOf info
              in OkC (Pair [Pair iname dictTyTerm] (ecAddDef ec3 (Pair iname dictTerm)))
          )
      )

-- 实例体：每个方法子句按方法签名 check，再按声明顺序组成字典构造子应用。
-- M29-T2b：实例带 telescope（类型参数）与 context（字典约束）：
--   字典类型 = `Π tele(Rig0). Π ctx(Rig1). Dict_C <arg>`；
--   字典值   = `λ tele(Rig0). λ ctx(Rig1). TCon MkDict <fields>`；
--   方法体里对 tele 变量的字典需求先在**声明的 ctx** 里消解，消不掉且仍是刚性 ⇒
--   `TC_InstanceContextMissing`（ctx 不足）；具体类型的临时需求留给程序级字典搜索。
elabInstance : List (Pair Decl Span) -> List (Pair Decl Span) -> List (Pair String Term) -> List DtClass -> List DtData -> Ec -> Pair Decl Span -> Check (Pair (List (Pair String Term)) Ec)
elabInstance instDecls allDecls globals classes datas ec (Pair (DInstance ctxE headExpr methods msp) dsp) = Vuna.Compiler.Common.bind (elabInstanceSig classes globals (definedNames (map firstOf instDecls)) ec msp headExpr ctxE) (\p => case p of
  Pair info ec0 => case findClass (instSigClass info) classes of
    Nothing => tcErr0 msp InstanceHeadNotApp
    Just cls =>
      if instanceLandingOk allDecls msp cls headExpr then elabInstanceWithClass globals allDecls cls info ec0 headExpr methods msp
      else tcErr0 msp OrphanInstance
)
elabInstance instDecls allDecls globals classes datas ec (Pair d dsp) =
  errAt dsp "DT: internal: expected an instance declaration"

-- 实例头/上下文的语法拆分：头是 `C arg`（M29 单参数 trait），约束是 `C arg`。
instanceHeadParts : Expr -> Maybe (Pair String (List Expr))
instanceHeadParts (EVar n sp) = Just (Pair n [])
instanceHeadParts (EApp fn args sp) = case fn of
  EVar n fsp => Just (Pair n args)
  _ => Nothing
instanceHeadParts _ = Nothing

constraintPartsOf : Span -> List Expr -> Check (List (Pair String (List Expr)))
constraintPartsOf sp [] = OkC []
constraintPartsOf sp (e :: rest) = case instanceConstraintParts e of
  Nothing => tcErr0 sp ConstraintNotDict
  Just p => Vuna.Compiler.Common.bind (constraintPartsOf sp rest) (\ps => OkC (Base.List.Cons p ps))

-- 约束 `C a1 .. an`：类名 + 全部头实参（N>=1 参数 trait 的签名约束与实例 ctx 共用）。
instanceConstraintParts : Expr -> Maybe (Pair String (List Expr))
instanceConstraintParts (EApp fn args sp) = case fn of
  EVar n fsp => Just (Pair n args)
  _ => Nothing
instanceConstraintParts (EVar n sp) = Just (Pair n [])
instanceConstraintParts _ = Nothing

-- 实例 signatrue 的精化结果：类名、tele、ctx 字典域、头实参（tele 内）、结果头。
record InstSigInfo where
  instSigClass : String
  instSigTele : List (Pair String Term)
  instSigCtx : List Term
  instSigArgs : List Term
  instSigHead : Term

instSigClass : InstSigInfo -> String
instSigClass (InstSigInfo c tele ctxE args head) = c

instSigTele : InstSigInfo -> List (Pair String Term)
instSigTele (InstSigInfo c tele ctxE args head) = tele

instSigCtx : InstSigInfo -> List Term
instSigCtx (InstSigInfo c tele ctxE args head) = ctxE

instSigArgs : InstSigInfo -> List Term
instSigArgs (InstSigInfo c tele ctxE args head) = args

instSigHead : InstSigInfo -> Term
instSigHead (InstSigInfo c tele ctxE args head) = head

-- 实例头+约束的类型化：
--   1. 自由小写名（head 实参与 ctx 实参里）→ tele，kind 按应用次数推断（Sig.arityFun）；
--   2. 单态实例（tele=[] 且 ctx=[]）走 `closedTypeTerms`，保证 head 类型项与 M15 逐字节一致；
--   3. 参数化实例在 teleCtx 下按每个类参数的 kind 检查头实参，ctx 项同法得到字典域。
-- 实例头的实参个数必须等于 trait 声明的参数个数（N>=1）。
elabInstanceSig : List DtClass -> List (Pair String Term) -> List String -> Ec -> Span -> Expr -> List Expr -> Check (Pair InstSigInfo Ec)
elabInstanceSig classes globals defined ec0 sp headExpr ctxE = case instanceHeadParts headExpr of
  Nothing => tcErr0 sp InstanceHeadNotApp
  Just parts => case findClass (firstOf parts) classes of
    Nothing => tcErr1 sp (UnknownInterface (firstOf parts)) (firstOf parts)
    Just cls => case secondOf parts of
      argExprs =>
        if length argExprs /= length cls.dtClassParams then tcErr0 sp InstanceHeadNotApp
        else Vuna.Compiler.Common.bind (constraintPartsOf sp ctxE)
          (\ctxParts => elabInstanceConstrained classes globals defined ec0 sp cls argExprs ctxParts)

-- 参数化/带 ctx 实例的 head 类型化（在 teleCtx 下按**类参数 kind** 检查头实参与 ctx 实参）。
-- M35.1：head 实参不再是「必须是类型」——`Monad (State s)` / `Monad (ST r)` 这类
-- 类参数 kind 为 `Type -> Type` 的实例头，旧路径用 `checkType` 会报
-- `expected a type, but this expression has type Type -> Type`。
-- 改为从字典族的参数取 kind、用 `checkTypeAtKind` 在 kind 上检查（与 ctx 实参的
-- `dictArgKinds` 同一来源）。
--
-- 多参数 trait 收尾（W3）：tele 变量的 kind 不再只按「被应用次数」推断，而是**先按类参数 kind 定位、
-- 再由实参精化解出**：
--   ① head/ctx 实参里**裸 tele 变量**的位置，kind 就是该类参数的 kind（`Member e ...`
--      的 `e` 取 `Member` 第一个参数的 kind）——单参数 trait 的 `instance Show a` 走这里；
--   ② 其余 tele 变量先绑一只 kind 元变量，实参精化时由构造子的参数 kind 解出
--      （`instance Member e (Cons e r)` 的 `r` 从 `Cons` 第二个参数解成 `Row`）；
--   ③ 仍解不出（元变量自由 / 解里含自由变量）⇒ 回退旧的「应用次数」启发式，
--      保证单参数 trait（Functor/Monad/Eq/Ord/MonadIO）行为不回退。
elabInstanceConstrained : List DtClass -> List (Pair String Term) -> List String -> Ec -> Span -> DtClass -> List Expr -> List (Pair String (List Expr)) -> Check (Pair InstSigInfo Ec)
elabInstanceConstrained classes globals defined ec0 sp cls argExprs ctxParts =
  let
    ctxArgs = concatMap (\p => secondOf p) ctxParts
    banned = topQuantBanned defined
    combined = EApp (EVar "#inst" sp) (append argExprs ctxArgs) sp
    kindMaybe = dictArgKinds ec0 (VNeutral (NGlobal (dictTypeName (dtClassName cls)) []))
  in case kindMaybe of
    Nothing => tcErr0 sp InstanceHeadNotApp
    Just kindVals => if length kindVals /= length argExprs then tcErr0 sp InstanceHeadNotApp
    else
      let
        seeds = append (bareTeleSeeds argExprs kindVals) (ctxBareTeleSeeds classes ec0 ctxParts)
        init = instanceTeleMetas banned combined (append argExprs ctxArgs) seeds ec0
        tele0 = firstOf init
        ec1 = secondOf init
        teleCtx0 = instanceTeleCtx tele0
      in Vuna.Compiler.Common.bind (checkArgsAtKinds globals teleCtx0 ec1 argExprs kindVals sp) (\q => case q of
        Pair argTerms ec2 => Vuna.Compiler.Common.bind (elabConstraintDomains classes globals teleCtx0 ctxParts sp ec2) (\r => case r of
          Pair ctxTys ec3 =>
            let
              tele = resolveTeleKinds combined tele0 ec3
            in OkC
              (Pair (InstSigInfo (dtClassName cls) tele ctxTys argTerms (ctorResultType cls argTerms)) ec3)
        )
      )

-- 逐个头实参按其类参数 kind 检查（N>=1 参数 trait）。
checkArgsAtKinds : List (Pair String Term) -> Ctx -> Ec -> List Expr -> List Value -> Span -> Check (Pair (List Term) Ec)
checkArgsAtKinds globals ctx ec [] [] sp = OkC (Pair [] ec)
checkArgsAtKinds globals ctx ec (a :: arest) (k :: ks) sp = Vuna.Compiler.Common.bind (checkTypeAtKind globals ctx ec a k sp) (\q => case q of
  Pair t ec1 => Vuna.Compiler.Common.bind (checkArgsAtKinds globals ctx ec1 arest ks sp) (\r => case r of
    Pair ts ec2 => OkC (Pair (Base.List.Cons t ts) ec2)
  )
)
checkArgsAtKinds globals ctx ec _ _ sp = tcErr0 sp InstanceHeadNotApp

-- 单态实例头的类型项（`instance Eq (Box Int)` 的头实参是复合类型）。
-- 只做语法 → 核心项的机械转换（EVar → TGlobal、应用落成 Rig0 TApp）；
-- 裸 EVar（`Color` / `Int`）与旧 `instanceHeadTerm` 逐字节一致。
closedTypeTerms : List Expr -> Maybe (List Term)
closedTypeTerms [] = Just []
closedTypeTerms (a :: rest) = case closedTypeTerm a of
  Nothing => Nothing
  Just t => case closedTypeTerms rest of
    Nothing => Nothing
    Just ts => Just (t :: ts)

closedTypeTerm : Expr -> Maybe Term
closedTypeTerm (EVar n sp) = Just (TGlobal n)
closedTypeTerm (EApp fn args sp) = case closedTypeTerm fn of
  Nothing => Nothing
  Just f => case closedTypeArgs args of
    Nothing => Nothing
    Just ts => Just (foldAppTerms f ts)
closedTypeTerm _ = Nothing

closedTypeArgs : List Expr -> Maybe (List (Pair Term Rig))
closedTypeArgs [] = Just []
closedTypeArgs (a :: rest) = case closedTypeTerm a of
  Nothing => Nothing
  Just t => case closedTypeArgs rest of
    Nothing => Nothing
    Just ts => Just (Pair t Rig0 :: ts)

-- 单态实例判定：head 实参里没有自由小写名（`Color` / `Int` / `Box Int` 都算单态）。
instanceMono : Expr -> Bool
instanceMono e = case exprFreeLower e of
  [] => True
  _ => False

isLowerStart : String -> Bool
isLowerStart n = case strUnpack n of
  [] => False
  c :: rest => c >= 97 && c <= 122

-- 实例 tele：裸变量位置先按类参数 kind 定位（seed），其余变量绑 kind 元变量等实参精化解出。
-- tele 顺序与旧实现一致（自由小写名按出现顺序去重，保留最后一次出现的位置）。
instanceTeleMetas : HashMap String Bool -> Expr -> List Expr -> List (Pair String Term) -> Ec -> Pair (List (Pair String Term)) Ec
instanceTeleMetas banned combined exprs seeds ec =
  teleMetasInit (uniqNames (keepOutBanned banned (concatMap exprFreeLower exprs))) seeds ec

teleMetasInit : List String -> List (Pair String Term) -> Ec -> Pair (List (Pair String Term)) Ec
teleMetasInit [] seeds ec = Pair [] ec
teleMetasInit (v :: rest) seeds ec = case seedKindOf v seeds of
  Just k => case teleMetasInit rest seeds ec of
    Pair tele ec1 => Pair (Pair v k :: tele) ec1
  Nothing => case newMeta emptyCtx ec of
    -- kind 是闭项（不引用 tele binder），所以元变量按**顶层深度**创建：解里允许引用
    -- 任意 tele 变量的判定留给下面的「解不含自由变量」检查，而不是 meta 创建深度。
    Pair (TMeta m) ec1 => case teleMetasInit rest seeds ec1 of
      Pair tele ec2 => Pair (Pair v (TMeta m) :: tele) ec2
    Pair k ec1 => case teleMetasInit rest seeds ec1 of
      Pair tele ec2 => Pair (Pair v k :: tele) ec2

seedKindOf : String -> List (Pair String Term) -> Maybe Term
seedKindOf v [] = Nothing
seedKindOf v ((Pair n k) :: rest) = if n == v then Just k else seedKindOf v rest

-- 裸 tele 变量（`EVar` 且小写开头）在实参列表里的 kind seed：与同类参数 kind 逐位对齐。
-- head 实参用本 trait 的参数 kind；ctx 实参用它自己那个约束 trait 的参数 kind。
bareTeleSeeds : List Expr -> List Value -> List (Pair String Term)
bareTeleSeeds [] kinds = []
bareTeleSeeds (e :: rest) (k :: ks) = case e of
  EVar n sp =>
    if isLowerStart n then Base.List.Cons (Pair n (quote 0 k)) (bareTeleSeeds rest ks)
    else bareTeleSeeds rest ks
  _ => bareTeleSeeds rest ks
bareTeleSeeds _ _ = []

ctxBareTeleSeeds : List DtClass -> Ec -> List (Pair String (List Expr)) -> List (Pair String Term)
ctxBareTeleSeeds classes ec [] = []
ctxBareTeleSeeds classes ec ((Pair cname argExprs) :: rest) = case findClass cname classes of
  Nothing => ctxBareTeleSeeds classes ec rest
  Just cls => case dictArgKinds ec (VNeutral (NGlobal (dictTypeName (dtClassName cls)) [])) of
    Nothing => ctxBareTeleSeeds classes ec rest
    Just kinds => append (bareTeleSeeds argExprs kinds) (ctxBareTeleSeeds classes ec rest)

-- 实参精化完后收束 tele 的 kind：已解的元变量换成解（必须闭），未解的回退旧启发式。
resolveTeleKinds : Expr -> List (Pair String Term) -> Ec -> List (Pair String Term)
resolveTeleKinds combined [] ec = []
resolveTeleKinds combined ((Pair v k) :: rest) ec =
  Pair v (resolveTeleKind combined v k ec) :: resolveTeleKinds combined rest ec

resolveTeleKind : Expr -> String -> Term -> Ec -> Term
resolveTeleKind combined v (TMeta m) ec = case solsLookup m (ecSolsP ec) of
  Just val =>
    let
      q = quote 0 val
    in if hasFreeTermVar 0 q then fallbackTeleKind combined v else q
  Nothing => fallbackTeleKind combined v
resolveTeleKind combined v k ec = k

-- 旧启发式（单参数 trait 的历史行为）：变量被应用 k 次就 `Type -> ... -> Type`，否则 `Type`。
fallbackTeleKind : Expr -> String -> Term
fallbackTeleKind combined v = arityFun (exprMaxAppArity v combined) (TType levelZero)

exprFreeLower : Expr -> List String
exprFreeLower (EVar n sp) = if isLowerStart n then [n] else []
exprFreeLower (EApp fn args sp) = append (exprFreeLower fn) (concatMap exprFreeLower args)
exprFreeLower (EPi n i _ dom cod sp) = append (exprFreeLower dom) (exprFreeLower cod)
exprFreeLower (EAnn v ty sp) = append (exprFreeLower v) (exprFreeLower ty)
exprFreeLower _ = []

uniqNames : List String -> List String
uniqNames [] = []
uniqNames (n :: rest) = if memName n rest then uniqNames rest else Base.List.Cons n (uniqNames rest)

keepOutBanned : HashMap String Bool -> List String -> List String
keepOutBanned tbl [] = []
keepOutBanned tbl (n :: rest) =
  if Base.HashMap.member n tbl then keepOutBanned tbl rest
  else Base.List.Cons n (keepOutBanned tbl rest)

-- tele 的局部上下文（声明顺序绑定；`TVar 0` = 最内层 tele）。
instanceTeleCtx : List (Pair String Term) -> Ctx
instanceTeleCtx tele = instanceTeleCtxGo tele emptyCtx

instanceTeleCtxGo : List (Pair String Term) -> Ctx -> Ctx
instanceTeleCtxGo [] ctx = ctx
instanceTeleCtxGo ((Pair n k) :: rest) ctx = instanceTeleCtxGo rest (ctxBindValue n (eval [] k) ctx)

-- 约束实参的字典域精化（实例/签名 ctx 共用）：每个参数按类参数 kind 检查后拼成
-- `Dict_C a1 .. an`（N>=1）。
elabConstraintDomains : List DtClass -> List (Pair String Term) -> Ctx -> List (Pair String (List Expr)) -> Span -> Ec -> Check (Pair (List Term) Ec)
elabConstraintDomains classes globals ctx [] sp ec = OkC (Pair [] ec)
elabConstraintDomains classes globals ctx ((Pair cname argExprs) :: rest) sp ec = case findClass cname classes of
  Nothing => tcErr1 sp (UnknownInterface cname) cname
  Just cls => case dictArgKinds ec (VNeutral (NGlobal (dictTypeName (dtClassName cls)) [])) of
    Nothing => tcErr0 sp ConstraintNotDict
    Just kindVals =>
      let
        _ = perfNote! "constraint-dom: ${cname} args=${length argExprs} kinds=${length kindVals}"
      in if length kindVals /= length argExprs then tcErr0 sp ConstraintNotDict
      else Vuna.Compiler.Common.bind (checkArgsAtKinds globals ctx ec argExprs kindVals sp) (\q => case q of
        Pair argTerms ec1 => Vuna.Compiler.Common.bind (elabConstraintDomains classes globals ctx rest sp ec1) (\r => case r of
          Pair tvs ec2 => OkC (Pair (Base.List.Cons (ctorResultType cls argTerms) tvs) ec2)
        )
      )

-- 实例方法体上下文：tele 之外再绑定 ctx 字典（第 k 个 ctx binder 的名字 `_ctx<k>`）。
instBodyCtx : InstSigInfo -> Ctx
instBodyCtx info = instBodyCtxGo (instanceTeleCtx (instSigTele info)) (instSigCtx info) 0

instBodyCtxGo : Ctx -> List Term -> Int -> Ctx
instBodyCtxGo ctx [] k = ctx
instBodyCtxGo ctx (t :: rest) k =
  instBodyCtxGo (ctxBindValue (ctxDictName k) (eval (ctxEnv ctx) (shift 0 k t)) ctx) rest (k + 1)

ctxDictName : Int -> String
ctxDictName k = "_ctx${k}"

-- 字典值的 λ 链：tele(Rig0) 之外再 λ ctx(Rig1)。
instValueOf : InstSigInfo -> String -> List Term -> Term
instValueOf info ctor fields =
  instTeleLam
    (instCtxLam (TCon ctor (map (\t => Pair t RigOmega) fields)) (length (instSigCtx info)) 0)
    (instSigTele info)

instTeleLam : Term -> List (Pair String Term) -> Term
instTeleLam body [] = body
instTeleLam body ((Pair n k) :: rest) = TLam n Rig0 (instTeleLam body rest)

instCtxLam : Term -> Int -> Int -> Term
instCtxLam body nCtx k = instCtxLamGo body (nCtx - k) k

instCtxLamGo : Term -> Int -> Int -> Term
instCtxLamGo body remaining k =
  if remaining <= 0 then body
  else TLam (ctxDictName k) RigOmega (instCtxLamGo body (remaining - 1) (k + 1))

-- 字典类型：`Π tele(Rig0). Π ctx(Rig1). head`（head/ctx 域里的 tele 引用按嵌在 ctx 之下移位）。
instTypeOf : InstSigInfo -> Term
instTypeOf info =
  let
    nCtx = length (instSigCtx info)
    body0 = shift 0 nCtx (instSigHead info)
    body1 = instTypeCtx body0 (reverse (instSigCtx info)) (nCtx - 1)
  in instTypeTele body1 (instSigTele info)

instTypeCtx : Term -> List Term -> Int -> Term
instTypeCtx body [] j = body
instTypeCtx body (t :: rest) j =
  instTypeCtx (TPi (ctxDictName j) True RigOmega (shift 0 j t) body) rest (j - 1)

instTypeTele : Term -> List (Pair String Term) -> Term
instTypeTele body [] = body
instTypeTele body ((Pair n k) :: rest) = TPi n True Rig0 k (instTypeTele body rest)

-- 实例头 `Show Int` 的类型项（`Dict_Show Int`）。
-- 实例头的实参项：`Pretty Color` → `TGlobal "Color"`（M15 只支持单参数接口）。
instanceHeadTerm : Expr -> Term
instanceHeadTerm (EApp fn (a :: rest) sp) = TGlobal (argNameOf a)
instanceHeadTerm (EVar n sp) = TGlobal n
instanceHeadTerm _ = TGlobal "Int"

-- 实例里出现 trait 没声明的方法 ⇒ 硬错误（旧实现静默忽略多余方法）。
firstUnknownInstanceMethod : DtClass -> List Decl -> Maybe String
firstUnknownInstanceMethod cls methods =
  firstUnknownInstanceMethodGo (map (\m => baseNameOf (firstOf m)) cls.dtClassMethods) methods

firstUnknownInstanceMethodGo : List String -> List Decl -> Maybe String
firstUnknownInstanceMethodGo known [] = Nothing
firstUnknownInstanceMethodGo known (d :: rest) = case d of
  DFun n pats body sp =>
    if memName (baseNameOf n) known then firstUnknownInstanceMethodGo known rest else Just n
  _ => firstUnknownInstanceMethodGo known rest

-- 缺方法要在**精化方法体之前**判定：方法体本身可能还有类型错误（例如跨模块 trait
-- 的泛型方法参数被写错类型），先报体错误会把「缺实现」这个更根本的诊断盖掉。
firstMissingInstanceMethod : DtClass -> List Decl -> Maybe String
firstMissingInstanceMethod cls methods = firstMissingInstanceMethodGo cls.dtClassMethods methods

firstMissingInstanceMethodGo : List (Pair String Term) -> List Decl -> Maybe String
firstMissingInstanceMethodGo [] decls = Nothing
firstMissingInstanceMethodGo (m :: rest) decls =
  if hasMethodClauses (baseNameOf (firstOf m)) decls then firstMissingInstanceMethodGo rest decls
  else Just (firstOf m)

hasMethodClauses : String -> List Decl -> Bool
hasMethodClauses name [] = False
hasMethodClauses name (d :: rest) = case d of
  DFun n pats body sp => baseNameOf n == name || hasMethodClauses name rest
  _ => hasMethodClauses name rest

-- M30（B20）：实例缺方法时把诊断落到 trait 里的**方法签名行**——先按类全名找到
-- trait 声明，再按方法全名找到方法签名 span；找不到（如外部生成的类）返回 Nothing，
-- 调用方回退到实例声明 span。`decls` 是已 resolve 的全程序声明，trait 名与方法名
-- 都是 mangle 后的全名（与 `dtClassMethods` / `firstMissingInstanceMethod` 一致）。
findTraitDecl : String -> List (Pair Decl Span) -> Maybe Decl
findTraitDecl cname [] = Nothing
findTraitDecl cname ((Pair d dsp) :: rest) = case d of
  DTrait tname params methods _ => if tname == cname then Just d else findTraitDecl cname rest
  _ => findTraitDecl cname rest

findTraitMethodSpan : String -> List TraitMethod -> Maybe Span
findTraitMethodSpan mname [] = Nothing
findTraitMethodSpan mname (m :: rest) =
  if traitMethodName m == mname then Just (traitMethodSpan m) else findTraitMethodSpan mname rest

traitMethodSpanOf : String -> String -> List (Pair Decl Span) -> Maybe Span
traitMethodSpanOf cname mname decls = case findTraitDecl cname decls of
  Just (DTrait tname params methods tspan) => findTraitMethodSpan mname methods
  _ => Nothing

-- 实例注册用的头类型：`Dict_C <arg1> .. <argn>`，供实例搜索按头统一。
ctorResultType : DtClass -> List Term -> Term
ctorResultType cls args =
  foldAppTerms (TGlobal (dictTypeName (dtClassName cls))) (map (\a => Pair a Rig0) args)

findClass : String -> List DtClass -> Maybe DtClass
findClass name [] = Nothing
findClass name (c :: rest) = if dtClassName c == name then Just c else findClass name rest

-- 方法实现：逐个把 `m p1..pn = body` 变成一个 lambda 字段值。
-- M29-T2b：期望类型在 bodyCtx（tele + ctx 字典 binder）下求值；方法体精化从 bodyCtx 起步，
-- 于是方法体里对 tele 变量的字典需求能命中局部 ctx binder（`searchInstanceIn` 的 local 分支）。
elabInstanceMethodsCtx : List (Pair String Term) -> DtClass -> Ctx -> Int -> List Term -> Ec -> List Decl -> Span -> Check (Pair (List Term) (Pair (List (Pair Term Rig)) Ec))
elabInstanceMethodsCtx globals cls ctx nCtx headArgs ec methods sp =
  elabInstanceMethodsGo globals ctx nCtx ec (zipClassFields cls) headArgs methods [] [] sp

-- 方法名 + 字段类型（方法声明顺序）。
zipClassFields : DtClass -> List (Pair String Term)
zipClassFields cls = zipMethodFields cls.dtClassMethods cls.dtClassFieldTys

zipMethodFields : List (Pair String Term) -> List Term -> List (Pair String Term)
zipMethodFields [] fieldTys = []
zipMethodFields (m :: rest) [] = []
zipMethodFields (m :: rest) (t :: rest2) = Pair (firstOf m) t :: zipMethodFields rest rest2

-- 把方法签名里的类参数 binder（field type 的最外层 binders）替换成实例头实参 `args`。
-- `args` 按声明顺序（p1 最外、pn 最内）；field type 里的 p_i 索引是 n-1-i。
-- 注意 **嵌套 binder 下要 shift**：`eq : a -> a -> Bool` 的第二个 `a` 在 1 层 Pi 之下，
-- 直接复用 Core.substVarAt 会把实参里的 tele 变量指向方法形参（`Box a` 的 a 指错）。
substInstParams : List Term -> Term -> Term
substInstParams args t = substInstParamsGo (length args) args 0 t

substInstParamsGo : Int -> List Term -> Int -> Term -> Term
substInstParamsGo n args depth (t@(TVar nm i sp)) =
  if i >= depth then if i - depth < n then shift 0 depth (instArgAt (n - 1 - (i - depth)) args) else t
  else t
substInstParamsGo n args depth (TPi nm i r dom cod) =
  TPi nm i r (substInstParamsGo n args depth dom) (substInstParamsGo n args (depth + 1) cod)
substInstParamsGo n args depth (TLam nm r body) =
  TLam nm r (substInstParamsGo n args (depth + 1) body)
substInstParamsGo n args depth (TApp f a r) =
  TApp (substInstParamsGo n args depth f) (substInstParamsGo n args depth a) r
substInstParamsGo n args depth (TCon c cs) =
  TCon c (map (\p => Pair (substInstParamsGo n args depth (firstOf p)) (secondOf p)) cs)
substInstParamsGo n args depth (TMk c cs) =
  TMk c (map (\p => Pair (substInstParamsGo n args depth (firstOf p)) (secondOf p)) cs)
substInstParamsGo n args depth (TCase scrut alts) =
  TCase (substInstParamsGo n args depth scrut)
    (map (\alt => substInstParamsAlt n args depth alt) alts)
substInstParamsGo n args depth (TIf c th el) =
  TIf (substInstParamsGo n args depth c) (substInstParamsGo n args depth th)
    (substInstParamsGo n args depth el)
substInstParamsGo n args depth t = t

substInstParamsAlt : Int -> List Term -> Int -> CaseAlt -> CaseAlt
substInstParamsAlt n args depth (CaseAlt c bs b) =
  CaseAlt c bs (substInstParamsGo n args (depth + length bs) b)

instArgAt : Int -> List Term -> Term
instArgAt k [] = TGlobal "Int"
instArgAt k (a :: rest) = if k <= 0 then a else instArgAt (k - 1) rest

elabInstanceMethodsGo : List (Pair String Term) -> Ctx -> Int -> Ec -> List (Pair String Term) -> List Term -> List Decl -> List Term -> List (Pair Term Rig) -> Span -> Check (Pair (List Term) (Pair (List (Pair Term Rig)) Ec))
elabInstanceMethodsGo globals ctx nCtx ec [] headArgs decls terms args sp =
  OkC (Pair (reverse terms) (Pair (reverse args) ec))
elabInstanceMethodsGo globals ctx nCtx ec ((Pair mname fty) :: rest) headArgs decls terms args sp =
  let
    clauses = methodClausesNamed mname decls
    instTy = shift 0 nCtx (substInstParams headArgs fty)
  in case clauses of
    [] => tcErr0 sp InstanceMissingMethod
    _ => Vuna.Compiler.Common.bind (elabInstanceMethodIn globals ctx ec instTy clauses) (\p => case p of
      Pair term ec1 =>
        elabInstanceMethodsGo globals ctx nCtx ec1 rest headArgs decls (term :: terms)
          (Pair term RigOmega :: args) sp
    )

-- 实例体里某个方法的**全部**子句（多 clause 方法：`fmp g (MkBox2 x) = ...` 后紧跟
-- 同名 clause）。M21 起这些子句一起走 `elabFunDef` 的模式矩阵，而不是只取第一条。
methodClausesNamed : String -> List Decl -> List (Pair (List Pat) Expr)
methodClausesNamed mname decls = methodClausesGo mname decls []

methodClausesGo : String -> List Decl -> List (Pair (List Pat) Expr) -> List (Pair (List Pat) Expr)
methodClausesGo mname [] acc = reverse acc
methodClausesGo mname (d :: rest) acc = case d of
  DFun n pats body sp =>
    if baseNameOf n == baseNameOf mname then methodClausesGo mname rest (Pair pats body :: acc)
    else methodClausesGo mname rest acc
  _ => methodClausesGo mname rest acc

-- 单个方法实现：把（已实例化的）方法签名当期望类型。
-- M21：方法子句允许构造子形参（`instance FMap Box2 where fmp g (MkBox2 x) = ...`），
-- 多 clause 也支持；参数全是变量/通配时直接绑定，否则与普通函数一样经 `elabFunDef`
-- 的模式矩阵降级，实例方法因此复用同一套索引精化与覆盖判定。
elabInstanceMethodIn : List (Pair String Term) -> Ctx -> Ec -> Term -> List (Pair (List Pat) Expr) -> Check (Pair Term Ec)
elabInstanceMethodIn globals ctx ec mty clauses =
  elabFunDefIn globals ctx ec clauses (evalCtx ctx mty) (clauseSpanOf clauses)

elabInstanceMethod : List (Pair String Term) -> Ec -> Term -> List (Pair (List Pat) Expr) -> Check (Pair Term Ec)
elabInstanceMethod globals ec mty clauses = elabInstanceMethodIn globals emptyCtx ec mty clauses

-- ---------------------------------------------------------------
-- M29-T2b：实例 context 的字典消解
-- ---------------------------------------------------------------
-- 方法体精化时对 tele 变量的字典需求被延迟成 `Constraint CkDict m (Dict_C a …)`；这里按**声明的 context**
-- 逐个消解：goal 域与第 i 个 ctx 字典 binder 的类型 conv 相等 ⇒ 该 goal 消解到
-- `_ctx<nCtx-1-i>`（de Bruijn index = i）。返回 (meta, ctx 下标 k) 与已去掉这些 goal 的 Ec。
solveCtxGoals : Ctx -> Int -> Int -> Ec -> List (Pair Int Int) -> Pair (List (Pair Int Int)) Ec
solveCtxGoals ctx nCtx nTele ec acc = solveCtxGoalsGo ctx nCtx ec (ecPending ec) [] acc

solveCtxGoalsGo : Ctx -> Int -> Ec -> List Constraint -> List Constraint -> List (Pair Int Int) -> Pair (List (Pair Int Int)) Ec
solveCtxGoalsGo ctx nCtx ec [] kept acc = Pair (reverse acc) (ecPutPending ec (reverse kept))
solveCtxGoalsGo ctx nCtx ec ((g@(Constraint cid kind m dom cspan cdepth)) :: rest) kept acc = case metaLookup m (ecSolTbl ec) of
  Just _ => solveCtxGoalsGo ctx nCtx ec rest kept acc
  Nothing => case matchCtxDictIdx ctx nCtx dom ec of
    Nothing => solveCtxGoalsGo ctx nCtx ec rest (g :: kept) acc
    Just i =>
      let
        k = nCtx - 1 - i
      in case solveMeta (ecDefTbl ec) (ecSolsP ec) 0 m [] (VNeutral (NVar (ctxDictName k) (ctxDepth ctx - nCtx + k) [])) of
        OkC sols2 =>
          solveCtxGoalsGo ctx nCtx (ecPutSols ec (solsList sols2)) rest kept (Pair m k :: acc)
        ErrC e => solveCtxGoalsGo ctx nCtx ec rest kept acc

matchCtxDictIdx : Ctx -> Int -> Value -> Ec -> Maybe Int
matchCtxDictIdx ctx nCtx dom ec = matchCtxDictIdxGo ctx nCtx dom ec 0 ctx.ctxItems

matchCtxDictIdxGo : Ctx -> Int -> Value -> Ec -> Int -> List (Pair String Term) -> Maybe Int
matchCtxDictIdxGo ctx nCtx dom ec i [] = Nothing
matchCtxDictIdxGo ctx nCtx dom ec i (item :: rest) = if i >= nCtx then Nothing
else case item of
  Pair name ty =>
    if ctxDictDomEqual ec (varTypeValue ctx i ty) dom then Just i
    else matchCtxDictIdxGo ctx nCtx dom ec (i + 1) rest

ctxDictDomEqual : Ec -> Value -> Value -> Bool
ctxDictDomEqual ec a b = case conv (ecDefTbl ec) (ecSolsP ec) 0 (forceVal ec a) (forceVal ec b) of
  OkC _ => True
  ErrC e => False

-- 把 meta 出现替换成 ctx 字典变量：binder k 位于 `nTele + k`，出现点的 index = depth - (nTele+k) - 1，
-- 即 substMetaVar 的 q = nTele + k + 1。
applyCtxSubstsTo : Int -> List (Pair Int Int) -> Term -> Term
applyCtxSubstsTo nCtx [] t = t
applyCtxSubstsTo nCtx ((Pair m k) :: rest) t =
  applyCtxSubstsTo nCtx rest (substMetaVar m (ctxDictName k) (k - nCtx + 1) t)

-- 剩下的 goal：仍刚性 ⇒ 用带局部 ctx 的实例搜索解（`Dict_Eq (Box a)` 靠自实例 + ctx 递归）；
-- 搜不到 ⇒ `TC_InstanceContextMissing`。非刚性（具体类型）的 goal 留给程序级搜索。
resolveRigidGoals : List (Pair String Term) -> Ctx -> Span -> List Constraint -> List (Pair Int Term) -> Ec -> Check (Pair (List (Pair Int Term)) Ec)
resolveRigidGoals globals ctx sp goals acc ec = resolveRigidGoalsGo globals ctx sp goals [] acc ec

resolveRigidGoalsGo : List (Pair String Term) -> Ctx -> Span -> List Constraint -> List Constraint -> List (Pair Int Term) -> Ec -> Check (Pair (List (Pair Int Term)) Ec)
resolveRigidGoalsGo globals ctx sp [] kept acc ec =
  OkC (Pair (reverse acc) (ecPutPending ec (reverse kept)))
resolveRigidGoalsGo globals ctx sp ((g@(Constraint cid kind m dom cspan cdepth)) :: rest) kept acc ec = if isRigidDictArg ec dom then case searchInstanceIn globals ctx ec dom sp of
  ErrC e => tcErr1 sp (InstanceContextMissing (showValue dom)) (showValue dom)
  OkC (Pair rep ec1) => case solveMeta (ecDefTbl ec1) (ecSolsP ec1) 0 m [] (eval (ctxEnv ctx) rep) of
    OkC sols2 =>
      resolveRigidGoalsGo globals ctx sp rest kept (Pair m rep :: acc)
        (ecPutSols ec1 (solsList sols2))
    ErrC e => resolveRigidGoalsGo globals ctx sp rest kept (Pair m rep :: acc) ec1
else resolveRigidGoalsGo globals ctx sp rest (g :: kept) acc ec

-- meta → 任意 term 的替换（term 在 `bodyDepth` 下有效；出现点 depth 更深时整体 shift）。
applyTermSubstsTo : Int -> List (Pair Int Term) -> Term -> Term
applyTermSubstsTo bodyDepth [] t = t
applyTermSubstsTo bodyDepth ((Pair m rep) :: rest) t =
  applyTermSubstsTo bodyDepth rest (substMetaTerm m rep t)

substMetaTerm : Int -> Term -> Term -> Term
substMetaTerm m rep t = substMetaTermGo m rep 0 t

substMetaTermGo : Int -> Term -> Int -> Term -> Term
substMetaTermGo m rep depth (t@(TMeta n)) = if n == m then shift 0 depth rep else t
substMetaTermGo m rep depth (TPi n i r dom cod) =
  TPi n i r (substMetaTermGo m rep depth dom) (substMetaTermGo m rep (depth + 1) cod)
substMetaTermGo m rep depth (TLam n r b) = TLam n r (substMetaTermGo m rep (depth + 1) b)
substMetaTermGo m rep depth (TApp f a r) =
  TApp (substMetaTermGo m rep depth f) (substMetaTermGo m rep depth a) r
substMetaTermGo m rep depth (TCon c args) =
  TCon c (map (\p => Pair (substMetaTermGo m rep depth (firstOf p)) (secondOf p)) args)
substMetaTermGo m rep depth (TMk c args) =
  TMk c (map (\p => Pair (substMetaTermGo m rep depth (firstOf p)) (secondOf p)) args)
substMetaTermGo m rep depth (TRecord c args) =
  TRecord c (map (\p => Pair (substMetaTermGo m rep depth (firstOf p)) (secondOf p)) args)
substMetaTermGo m rep depth (TCase s alts) =
  TCase (substMetaTermGo m rep depth s) (map (\alt => substMetaTermAlt m rep depth alt) alts)
substMetaTermGo m rep depth (TIf c th el) =
  TIf (substMetaTermGo m rep depth c) (substMetaTermGo m rep depth th)
    (substMetaTermGo m rep depth el)
substMetaTermGo m rep depth t = t

substMetaTermAlt : Int -> Term -> Int -> CaseAlt -> CaseAlt
substMetaTermAlt m rep depth (CaseAlt n bs b) =
  CaseAlt n bs (substMetaTermGo m rep (depth + length bs) b)

clauseSpanOf : List (Pair (List Pat) Expr) -> Span
clauseSpanOf [] = Span "" 0 0 0 0
clauseSpanOf (c :: rest) = exprSpan (secondOf c)

-- ---------------------------------------------------------------
-- 泛型实例约束提升（M20 剩余 / M22 前置 / M29 C05）
-- ---------------------------------------------------------------
-- 定义体对刚性类参数的字典需求（如 `mem` 的 `Dict_Eq a`）被 `deferEqDict` 延迟成 `?d`+自由目标；
-- 体精化完后 `liftFreeDictGoals` 提升成隐式字典参数：`mem : a -> L a -> Bool` →
-- `mem : {a} -> {d : Dict_Eq a} -> a -> L a -> Bool`，体前插 `TLam d`、`?d` 换 `d`、解孤儿 `?d`。
--
-- M29（C05）：同一 domain 的多个目标只提升成**一只**字典 binder（否则 `bind ma` / `bind mb` /
-- `pure` 各产生一只 `Dict_Monad m`，arity 膨胀且泛型调用链上继续复制）。
record DictGoalGroup where
  dictGoalGroupRep : Int
  dictGoalGroupDom : Value
  dictGoalGroupExtras : List Int

freeDictGoals : Ec -> List DictGoalGroup
freeDictGoals ec = freeDictGoalsGo ec (ecPending ec) []

freeDictGoalsGo : Ec -> List Constraint -> List DictGoalGroup -> List DictGoalGroup
freeDictGoalsGo ec [] acc = acc
freeDictGoalsGo ec (g :: rest) acc = case g of
  Constraint cid kind m dom cspan cdepth => if isRigidDictArg ec dom then case metaLookup m (ecSolTbl ec) of
    -- 已提升过的目标不再重复提升（`solveLiftedMeta` 已把 ?m 解成 `d`）；否则后续每个
    -- 定义都会被塞进一个多余的字典 binder（曾把 `xor` 的 `not b` 破坏成一次字典搜索）。
    Just _ => freeDictGoalsGo ec rest acc
    Nothing => freeDictGoalsGo ec rest (addDictGoalGroup ec m dom acc)
  else freeDictGoalsGo ec rest acc

-- 按 domain 的定义性相等归组：已提升的列表里第一组匹配即并入（追加到该组尾部）。
addDictGoalGroup : Ec -> Int -> Value -> List DictGoalGroup -> List DictGoalGroup
addDictGoalGroup ec m dom [] = [DictGoalGroup m dom []]
addDictGoalGroup ec m dom ((DictGoalGroup rep repDom extras) :: rest) =
  if domainsEqual ec repDom dom then Base.List.Cons (DictGoalGroup rep repDom (m :: extras)) rest
  else Base.List.Cons (DictGoalGroup rep repDom extras) (addDictGoalGroup ec m dom rest)

domainsEqual : Ec -> Value -> Value -> Bool
domainsEqual ec a b = case conv (ecDefTbl ec) (ecSolsP ec) 0 a b of
  OkC _ => True
  ErrC e => False

-- 签名 Term 的隐式 Pi 前缀长度（`{a} -> {b} -> ...` 的隐式 binder 数）。
leadingImplicitCount : Term -> Int
leadingImplicitCount (TPi n True rig dom cod) = 1 + leadingImplicitCount cod
leadingImplicitCount _ = 0

-- 解掉被替换出体的孤儿 `?m`（否则 `unsolvedMeta` 报未解元变量）。`level` 是该字典 binder
-- 的 de Bruijn level（从最外层数），供后续 quote/zonk 还原正确索引。
-- M28：解的作用域在 Core.Conv 求解点就地检查，这里不再事后复核。
solveLiftedMeta : Ec -> String -> Int -> Int -> Ec
solveLiftedMeta ec name level m = case solveMeta (ecDefTbl ec) (ecSolsP ec) 0 m [] (VNeutral (NVar name level [])) of
  OkC sols2 => ecPutSols ec (solsList sols2)
  ErrC e => ec

liftFreeDictGoals : String -> Ec -> Term -> Term -> Pair Term (Pair Term Ec)
-- M34 冷路径：没有延迟字典目标时整段是恒等（旧实现每次都扫一遍目标表 + 求隐式前缀长）。
liftFreeDictGoals defName ec ty body = case ecPending ec of
  [] => Pair ty (Pair body ec)
  _ =>
    let
      groups = freeDictGoals ec
      nGroups = length groups
      -- M23/M29：字典 binder 插在**原始签名**的最后一个隐式 binder 之后。
      -- `insertDictBinder`/`insertLamBinder` 的 idx 语义是「插在第 idx 个 binder 之后」，
      -- 所以基准是 `隐式前缀长 - 1`，且**只在循环外算一次**：插入后 ty 的隐式前缀会变长，
      -- 再读 `leadingImplicitCount ty` 会把已插入的字典重复计入（C05：第 2、3 只字典被推到
      -- 显式参数之后，`ma` 的引用因此错位）。
      baseIdx = maxInt 0 (leadingImplicitCount ty - 1)
    in liftFreeDictGoalsGo defName ec ty body baseIdx nGroups 0 groups

liftFreeDictGoalsGo : String -> Ec -> Term -> Term -> Int -> Int -> Int -> List DictGoalGroup -> Pair Term (Pair Term Ec)
liftFreeDictGoalsGo defName ec ty body baseIdx nGroups k groups = case groups of
  -- M23：字典 binder 插在**所有隐式 binder 之后**（即第一个显式参数之前）。
  [] => Pair ty (Pair body ec)
  (DictGoalGroup m dom extras) :: rest =>
    let
      dName = "d${m}"
      -- 第 k 组（0-based）的**最终** binder 位置：之后每插入一只更新的字典都把它推深 1
      -- （同位置反复插入 ⇒ 新字典在旧字典外侧）。
      finalPos = baseIdx + 1 + (nGroups - 1 - k)
      -- 域按最终位置 quote：域里的刚性类参数 level l 落在 index `finalPos - l - 1`。
      dictDom = substSolvedMetasAtTbl (ecSolTbl ec) (baseIdx + 1) (quote (baseIdx + 1) dom)
      ty2 = insertDictBinder dName baseIdx dictDom ty
      -- 先插 binder（会把插入点之后的引用整体移位），**再**把孤儿元变量替换成字典变量：
      -- 顺序反过来时被替换出来的 TVar 也会被 shift 再挪一次，索引会偏。
      -- 插入瞬间该字典 binder 恰在 `baseIdx + 1`（q = baseIdx + 2）；之后只在它**外侧**
      -- 插新字典，已替换出来的内侧 index 不变。
      body2 = substMetaVar m dName (baseIdx + 2) (insertLamBinder dName baseIdx body)
      -- M21：体是按**旧签名**（无字典 binder）精化的，自递归调用点少一个字典实参；
      -- 提升后按应用位置补上。字典 binder 的最终位置是 `finalPos`，但插入顺序是
      -- 「新的在外」，所以每次都在第 `baseIdx + 1` 个应用实参处插入（与 binder 同序）。
      body3 = insertDictCalls defName dName (baseIdx + 1) body2
      body4 = substExtraDictMetas dName (baseIdx + 2) extras body3
      ec2 = solveLiftedMeta ec dName finalPos m
      ec3 = solveLiftedMetas ec2 dName finalPos extras
    in liftFreeDictGoalsGo defName ec3 ty2 body4 baseIdx nGroups (k + 1) rest

-- 同域的其余目标都解到同一只字典 binder（去重）。
substExtraDictMetas : String -> Int -> List Int -> Term -> Term
substExtraDictMetas dName q [] t = t
substExtraDictMetas dName q (m :: rest) t =
  substExtraDictMetas dName q rest (substMetaVar m dName q t)

solveLiftedMetas : Ec -> String -> Int -> List Int -> Ec
solveLiftedMetas ec dName level [] = ec
solveLiftedMetas ec dName level (m :: rest) =
  solveLiftedMetas (solveLiftedMeta ec dName level m) dName level rest

-- ---------------------------------------------------------------
-- 遍历项时跟踪 binder 深度（从最外层数），遇到「头是目标全局」的应用脊时在固定位置
-- 插入 `d` 实参；`TVar d` 的 de Bruijn index = depth - (字典位置 + 1)。
insertDictCalls : String -> String -> Int -> Term -> Term
insertDictCalls defName dName appPos t = injectDictGo defName dName appPos 0 t

injectDictGo : String -> String -> Int -> Int -> Term -> Term
injectDictGo defName dName appPos depth t = injectDictGoFuel 128 defName dName appPos depth t

injectDictGoFuel : Int -> String -> String -> Int -> Int -> Term -> Term
injectDictGoFuel fuel defName dName appPos depth t = if fuel <= 0 then t
else case t of
  TLam n r b => TLam n r (injectDictGoFuel (fuel - 1) defName dName appPos (depth + 1) b)
  TPi n i r d c =>
    TPi n i r (injectDictGoFuel (fuel - 1) defName dName appPos depth d)
      (injectDictGoFuel (fuel - 1) defName dName appPos (depth + 1) c)
  TApp f a r => case flattenTaggedApp t of
    Just (Pair g args) => rewriteTaggedSpineFuel (fuel - 1) defName dName appPos depth g args
    Nothing =>
      TApp (injectDictGoFuel (fuel - 1) defName dName appPos depth f)
        (injectDictGoFuel (fuel - 1) defName dName appPos depth a) r
  TCon c args =>
    TCon c
      (map (\p => Pair (injectDictGoFuel (fuel - 1) defName dName appPos depth (firstOf p)) (secondOf p)) args)
  TMk c args =>
    TMk c
      (map (\p => Pair (injectDictGoFuel (fuel - 1) defName dName appPos depth (firstOf p)) (secondOf p)) args)
  TRecord name args =>
    TRecord name
      (map (\p => Pair (injectDictGoFuel (fuel - 1) defName dName appPos depth (firstOf p)) (secondOf p)) args)
  TCase scrut alts =>
    TCase (injectDictGoFuel (fuel - 1) defName dName appPos depth scrut)
      (map (\alt => injectAltGoFuel (fuel - 1) defName dName appPos depth alt) alts)
  TIf c th el =>
    TIf (injectDictGoFuel (fuel - 1) defName dName appPos depth c)
      (injectDictGoFuel (fuel - 1) defName dName appPos depth th)
      (injectDictGoFuel (fuel - 1) defName dName appPos depth el)
  _ => t

injectAltGo : String -> String -> Int -> Int -> CaseAlt -> CaseAlt
injectAltGo defName dName appPos depth alt = injectAltGoFuel 128 defName dName appPos depth alt

injectAltGoFuel : Int -> String -> String -> Int -> Int -> CaseAlt -> CaseAlt
injectAltGoFuel fuel defName dName appPos depth alt = if fuel <= 0 then alt
else case alt of
  CaseAlt n bs b =>
    CaseAlt n bs (injectDictGoFuel (fuel - 1) defName dName appPos (depth + length bs) b)

rewriteTaggedSpine : String -> String -> Int -> Int -> String -> List (Pair Term Rig) -> Term
rewriteTaggedSpine defName dName appPos depth g args =
  rewriteTaggedSpineFuel 128 defName dName appPos depth g args

rewriteTaggedSpineFuel : Int -> String -> String -> Int -> Int -> String -> List (Pair Term Rig) -> Term
rewriteTaggedSpineFuel fuel defName dName appPos depth g args = if fuel <= 0 then TGlobal g
else
  let
    args2 =
      map
        (\p => Pair (injectDictGoFuel (fuel - 1) defName dName appPos depth (firstOf p)) (secondOf p))
        args
  in if g == defName && length args2 > appPos && depth > appPos then foldAppTerms (TGlobal g)
    (insertArgAt appPos (Pair (TVar dName (depth - appPos - 1) (Span "" 0 0 0 0)) RigOmega) args2)
  else foldAppTerms (TGlobal g) args2

insertArgAt : Int -> a -> List a -> List a
insertArgAt n x xs = append (append (take n xs) [x]) (drop n xs)

-- 提升后的签名要回写 globals：后续定义调用它时按新签名（带字典 binder）走隐式实参插入。
replaceGlobalType : String -> Term -> List (Pair String Term) -> List (Pair String Term)
replaceGlobalType name ty [] = []
replaceGlobalType name ty (p :: rest) =
  if firstOf p == name then Base.List.Cons (Pair name ty) rest
  else Base.List.Cons p (replaceGlobalType name ty rest)

-- M15：批量注册实例。
foldlAddInst : Ec -> List DtInst -> Ec
foldlAddInst ec [] = ec
foldlAddInst ec (i :: rest) = foldlAddInst (ecAddInst ec i) rest

-- 实例头（`Dict_C <arg>`）的签名先入 globals：实例方法体要按它 check。
-- M23：同一个 head 只允许注册一次——`deriving` 生成的实例与手写实例、两个模块各自的
-- 默认实例都会撞上；旧实现按**名字**去重且静默丢弃，重复实例被无声接受。现在按 head
-- 定义性相等判定并报 "duplicate instance"。
checkInstanceHeads : List (Pair Decl Span) -> List DtClass -> List (Pair String Term) -> Ec -> Check (Pair (List (Pair String Term)) Ec)
checkInstanceHeads decls classes globals ec = checkInstanceHeadsGo decls classes globals ec [] [] []

checkInstanceHeadsGo : List (Pair Decl Span) -> List DtClass -> List (Pair String Term) -> Ec -> List (Pair String Term) -> List DtInst -> List DtInst -> Check (Pair (List (Pair String Term)) Ec)
checkInstanceHeadsGo [] classes globals ec acc insts seen =
  OkC (Pair (reverse acc) (foldlAddInst ec (reverse insts)))
checkInstanceHeadsGo ((d@(Pair decl dsp)) :: rest) classes globals ec acc insts seen = case decl of
  DInstance ctxE headExpr methods msp => Vuna.Compiler.Common.bind (elabInstanceSig classes globals (definedNames (map firstOf (d :: rest))) ec msp headExpr ctxE) (\p => case p of
    Pair info ec1 =>
      let
        iname = instanceName (instSigClass info) headExpr
        ty = instTypeOf info
        inst = DtInst iname (instSigTele info) (instSigCtx info) (instSigHead info) (Just msp)
      in case findInstanceClash ec1 iname (instSigTele info) (instSigHead info) seen of
        Pair (Just ClashDuplicate) ec2 => tcErr1 msp (DuplicateInstance iname) iname
        Pair (Just ClashOverlap) ec2 => tcErr1 msp (OverlappingInstances iname) iname
        Pair Nothing ec2 =>
          checkInstanceHeadsGo rest classes globals ec2 (Pair iname ty :: acc) (inst :: insts)
            (inst :: seen)
  )
  _ => checkInstanceHeadsGo rest classes globals ec acc insts seen

-- 实例方法体（在顶层定义之后精化）。
-- M30（B20）：入口收**全量已 resolve 声明**（Driver 传入，`List Decl`），内部自己筛出
-- 实例列表；全量声明同时用于「实例缺方法」诊断反查 trait 方法签名 span（`traitMethodSpanOf`）。
elabInstanceBodies : List Decl -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> Check (Pair (List DtDef) Ec)
elabInstanceBodies allDecls classes datas globals ec =
  elabInstanceBodiesGo (collectInstDecls allDecls []) (map (\d => Pair d (declSpan d)) allDecls)
    classes datas globals ec []

elabInstanceBodiesGo : List (Pair Decl Span) -> List (Pair Decl Span) -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> List DtDef -> Check (Pair (List DtDef) Ec)
elabInstanceBodiesGo [] allDecls classes datas globals ec acc = OkC (Pair (reverse acc) ec)
elabInstanceBodiesGo (d :: rest) allDecls classes datas globals ec acc = Vuna.Compiler.Common.bind (elabInstance (d :: rest) allDecls globals classes datas ec d) (\p => case p of
  Pair gs ec1 =>
    let
      -- M29（A14）：实例生成的字典/方法定义统一挂**实例声明 span**（`d` 的 span）。
      newDefs = instanceDefsOf ec ec1 (Just (secondOf d)) gs
      ecTbl = ecPutGlobalsTbl ec1 (Base.HashMap.insertAll gs (ecGlobalsTbl ec1))
    in elabInstanceBodiesGo rest allDecls classes datas (append globals gs) ecTbl (append newDefs acc)
)

-- 从「精化前后 Ec 的 defs 差集」里取出这一条 instance 生成的定义。
-- M29（A14）：`srcSpan` 是该实例声明的位置（`Nothing` 时诊断保持无位置）。
instanceDefsOf : Ec -> Ec -> Maybe Span -> List (Pair String Term) -> List DtDef
instanceDefsOf ecBefore ecAfter srcSpan gs =
  map
    (\g => DtDef (firstOf g) (defTypeOrDefaultTbl (Base.HashMap.fromList gs) (firstOf g)) (substDictTerm ecAfter (defBodyOf (ecDefTbl ecAfter) (firstOf g))) srcSpan)
    gs

defBodyOf : HashMap String Term -> String -> Term
defBodyOf defs name = case defLookup name defs of
  Just body => body
  Nothing => TInt 0

-- 逐条精化 trait，收集字典 data / 投影签名 / 类表 / 投影名→声明 span（A14）。
elabTraits : List (Pair Decl Span) -> List (Pair String Term) -> Ec -> Check (Pair (List DtData) (Pair (List (Pair String Term)) (Pair (List DtClass) (Pair (List (Pair String Span)) Ec))))
elabTraits decls globals ec = elabTraitsGo decls globals ec [] [] [] []

elabTraitsGo : List (Pair Decl Span) -> List (Pair String Term) -> Ec -> List DtData -> List (Pair String Term) -> List DtClass -> List (Pair String Span) -> Check (Pair (List DtData) (Pair (List (Pair String Term)) (Pair (List DtClass) (Pair (List (Pair String Span)) Ec))))
elabTraitsGo [] globals ec ds gs cs ps =
  OkC (Pair (reverse ds) (Pair (reverse gs) (Pair (reverse cs) (Pair (reverse ps) ec))))
elabTraitsGo (d :: rest) globals ec ds gs cs ps = Vuna.Compiler.Common.bind (elabTrait globals ec d) (\p => case p of
  Pair dd (Pair projs (Pair cls (Pair pspans ec1))) =>
    elabTraitsGo rest (append globals projs) ec1 (dd :: ds) (append projs gs) (cls :: cs)
      (append pspans ps)
)

-- 逐条精化 instance：定义体进 Ec 的 defs（实例表），头类型进 globals。
elabInstances : List (Pair Decl Span) -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> Check (Pair (List (Pair String Term)) Ec)
elabInstances decls classes datas globals ec = elabInstancesGo decls classes datas globals ec []

elabInstancesGo : List (Pair Decl Span) -> List DtClass -> List DtData -> List (Pair String Term) -> Ec -> List (Pair String Term) -> Check (Pair (List (Pair String Term)) Ec)
elabInstancesGo [] classes datas globals ec acc = OkC (Pair (reverse acc) ec)
-- 旧批量入口（无全量声明，方法级 span 不可用；保留签名以兼容既有导出）。
elabInstancesGo (d :: rest) classes datas globals ec acc = Vuna.Compiler.Common.bind (elabInstance (d :: rest) [] globals classes datas ec d) (\p => case p of
  Pair gs ec1 => elabInstancesGo rest classes datas (append globals gs) ec1 (append gs acc)
)

-- M15：ecDefs 里那些不是源文件 DFun 的定义（接口投影、实例字典）。
-- 它们的类型从 globals 里查（投影签名 / 实例头类型都在 elabTraits/elabInstances 时入表）。
-- M29（A14）：`srcSpans` 是「名字 → 最近声明 span」表（trait 投影用 trait 声明 span；
-- 找不到的生成项给 `Nothing`，诊断保持无位置）。
extraDefsOf : List (Pair String Term) -> Ec -> List (Pair String Span) -> List DtDef -> List DtDef
extraDefsOf globals ec srcSpans sourceDefs =
  extraDefsGo (ecGlobalsTbl ec) (Base.HashMap.ofNames (map dtDefName sourceDefs)) srcSpans
    (ecDefs ec) []

extraDefsGo : HashMap String Term -> HashMap String Bool -> List (Pair String Span) -> List (Pair String Term) -> List DtDef -> List DtDef
extraDefsGo globalsTbl sourceNames srcSpans [] acc = reverse acc
extraDefsGo globalsTbl sourceNames srcSpans (d :: rest) acc =
  if Base.HashMap.member (firstOf d) sourceNames then extraDefsGo globalsTbl sourceNames srcSpans rest acc
  else extraDefsGo globalsTbl sourceNames srcSpans rest
    (DtDef (firstOf d) (defTypeOrDefaultTbl globalsTbl (firstOf d)) (secondOf d) (spanOfName (firstOf d) srcSpans) :: acc)

spanOfName : String -> List (Pair String Span) -> Maybe Span
spanOfName name [] = Nothing
spanOfName name ((Pair n sp) :: rest) = if n == name then Just sp else spanOfName name rest

defTypeOrDefaultTbl : HashMap String Term -> String -> Term
defTypeOrDefaultTbl tbl name = case Base.HashMap.lookup name tbl of
  Just ty => ty
  Nothing => TGlobal "Int"

-- ---------------------------------------------------------------
-- 定义：签名 + 变量模式 → lambda 化的体
-- ---------------------------------------------------------------
checkDefIn : List (Pair String Term) -> Ctx -> Ec -> List Pat -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkDefIn globals ctx0 ec pats body expected sp =
  checkBinders globals ctx0 ec pats body expected sp

checkDef : List (Pair String Term) -> Ec -> List Pat -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkDef globals ec pats body expected sp = checkDefIn globals emptyCtx ec pats body expected sp

checkBindersFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List Pat -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkBindersFuel fuel globals ctx ec [] body expected sp = if fuel <= 0 then icFuel "binder check"
else
  let
    forced = forceVal ec expected
  in case forced of
    VPi name implicit rig dom clo =>
      if implicit then if isDictDomain ec dom then bindDictBinderFuel (fuel - 1) globals ctx ec rig name dom clo [] body sp
      else if isImplicitDomain ctx ec dom then bindIndexBinderFuel (fuel - 1) globals ctx ec rig name dom clo [] body sp
      else tcErr0 sp ImplicitParamKind
      else Vuna.Compiler.Common.bind (checkBodyAtEndFuel (fuel - 1) globals ctx ec body expected sp)
        (\p => Vuna.Compiler.Common.bind (resolveRowGoalsCtx globals ctx (secondOf p) sp) (\ec2 => OkC (Pair (firstOf p) ec2)))
    _ =>
      Vuna.Compiler.Common.bind (checkE globals ctx ec body expected)
        (\p => Vuna.Compiler.Common.bind (resolveRowGoalsCtx globals ctx (secondOf p) sp) (\ec2 => OkC (Pair (firstOf p) ec2)))

-- M32：显式约束的隐式字典 binder：自动绑定（不消耗 pattern）、绑成 `TLam Rig1`，body 经 `localDictLookup` 命中声明假设。
bindDictBinderFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Rig -> String -> Value -> Closure -> List Pat -> Expr -> Span -> Check (Pair Term Ec)
bindDictBinderFuel fuel globals ctx ec rig name dom clo pats body sp = if fuel <= 0 then icFuel "binder check"
else
  let
    lvl = ctxDepth ctx
    v = freshVarValue name lvl
    ctx2 = ctxBindValue name dom ctx
    expected2 = applyClosure clo v
  in Vuna.Compiler.Common.bind (checkBindersFuel (fuel - 1) globals ctx2 ec pats body expected2 sp) (\p => case p of
    Pair inner ec1 => OkC (Pair (TLam name rig inner) ec1)
  )

-- 隐式索引 binder（`{n : Nat}`）：绑成擦除的 lambda（Rig0），体在扩展上下文里继续。
bindIndexBinderFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Rig -> String -> Value -> Closure -> List Pat -> Expr -> Span -> Check (Pair Term Ec)
bindIndexBinderFuel fuel globals ctx ec rig name dom clo pats body sp = if fuel <= 0 then icFuel "binder check"
else
  let
    lvl = ctxDepth ctx
    v = freshVarValue name lvl
    ctx2 = ctxBindValue name dom ctx
    expected2 = applyClosure clo v
  in Vuna.Compiler.Common.bind (checkBindersFuel (fuel - 1) globals ctx2 ec pats body expected2 sp) (\p => case p of
    Pair inner ec1 => OkC (Pair (TLam name rig inner) ec1)
  )

-- 模式用完后仍剩 Pi（M28 η 展开，决策 5 / D10）：body 是 lambda 时按 check 处理；
-- 否则按签名剩余 Pi 补 `\_arityN`（N 取当前上下文深度保证唯一），并把 body **应用**
-- 到这些新参数，整体按原签名继续 check——`f : A -> B` 配 `f = g` 因此成立。
-- 隐式 binder 沿用既有规则：index 域绑成擦除 λ（隐式实参由精化器插入），其它域仍是
-- ImplicitParamKind。`TC_DefFewerParams` 保留在错误表里但不再触发（见 Diagnostics）。
checkBodyAtEndFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkBodyAtEndFuel fuel globals ctx ec body expected sp = if fuel <= 0 then icFuel "binder check"
else case body of
  ELam names lambdaBody lambdaSp =>
    Vuna.Compiler.Common.bind (checkE globals ctx ec body expected)
      (\p => Vuna.Compiler.Common.bind (resolveRowGoalsCtx globals ctx (secondOf p) sp) (\ec2 => OkC (Pair (firstOf p) ec2)))
  _ => case forceVal ec expected of
    VPi name implicit rig dom clo => if implicit then if isDictDomain ec dom then bindDictBinderFuel (fuel - 1) globals ctx ec rig name dom clo [] body sp
    else if isImplicitDomain ctx ec dom then bindIndexBinderFuel (fuel - 1) globals ctx ec rig name dom clo [] body sp
    else tcErr0 sp ImplicitParamKind
    else
      let
        lvl = ctxDepth ctx
        etaName = "_arity${lvl}"
        v = freshVarValue etaName lvl
        ctx2 = ctxBindValue etaName dom ctx
        body2 = EApp body [EVar etaName sp] sp
      in Vuna.Compiler.Common.bind (rigForLinearDomain ec sp etaName rig dom) (\etaRig => Vuna.Compiler.Common.bind (checkBodyAtEndFuel (fuel - 1) globals ctx2 ec body2 (applyClosure clo v) sp) (\p => case p of
        Pair inner ec1 =>
          let
            inner2 = if isOpaqueRuntimeTyIn ec1 ctx dom then wrapOpaqueUses [0] inner else inner
          in OkC (Pair (TLam etaName etaRig inner2) ec1)
      )
      )
    _ =>
      Vuna.Compiler.Common.bind (checkE globals ctx ec body expected)
        (\p => Vuna.Compiler.Common.bind (resolveRowGoalsCtx globals ctx (secondOf p) sp) (\ec2 => OkC (Pair (firstOf p) ec2)))

checkBindersFuel fuel globals ctx ec (pat :: rest) body expected sp = if fuel <= 0 then icFuel "binder check"
else
  let
    forced = forceVal ec expected
  in case forced of
    VPi name implicit rig dom clo => if implicit then if isDictDomain ec dom then bindDictBinderFuel (fuel - 1) globals ctx ec rig name dom clo (pat :: rest) body sp
    else if isImplicitDomain ctx ec dom then bindIndexBinderFuel (fuel - 1) globals ctx ec rig name dom clo (pat :: rest) body sp
    else tcErr0 sp ImplicitParamKind
    else case pat of
      PVar pname psp => bindOnePatternFuel (fuel - 1) globals ctx ec rig pname rest body dom clo sp
      PWild psp => bindOnePatternFuel (fuel - 1) globals ctx ec rig "_" rest body dom clo sp
      _ => tcErr0 (patSpan pat) DefParamsMustBeVars
    _ => tcErr0 sp DefMoreParams

bindOnePatternFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Rig -> String -> List Pat -> Expr -> Value -> Closure -> Span -> Check (Pair Term Ec)
bindOnePatternFuel fuel globals ctx ec rig pname pats body dom clo sp = if fuel <= 0 then icFuel "binder check"
else
  let
    lvl = ctxDepth ctx
    v = freshVarValue pname lvl
    ctx2 = ctxBindValue pname dom ctx
  in Vuna.Compiler.Common.bind (rigForLinearDomain ec sp pname rig dom) (\erasure => Vuna.Compiler.Common.bind (checkBindersFuel (fuel - 1) globals ctx2 ec pats body (applyClosure clo v) sp) (\p => case p of
    Pair inner ec1 =>
      let
        inner2 = if isOpaqueRuntimeTyIn ec1 ctx dom then wrapOpaqueUses [0] inner else inner
      in OkC (Pair (TLam pname erasure inner2) ec1)
  )
  )

-- ---------------------------------------------------------------
-- M19：多 clause 与方程左端模式
-- ---------------------------------------------------------------
-- 把 `plus Zero b = b` / `plus (Succ k) b = Succ (plus k b)` 合成：`\mc0 => \mc1 => case mc0 of ...`。
-- 两步：① 按参数个数生成 lambda 链（`mc<i>` 与签名 Pi 链对齐）；② 按**列**递归构建 case 树
-- （标准模式矩阵：整列变量改名继续；有构造子则用该位置名作 scrutinee，同构造子的子模式递归，
-- 变量/通配汇成兜底）。产物是纯 lambda + case，交给既有精化路径，覆盖/索引/擦除全自动。
elabFunDefIn : List (Pair String Term) -> Ctx -> Ec -> List (Pair (List Pat) Expr) -> Value -> Span -> Check (Pair Term Ec)
elabFunDefIn globals ctx0 ec clauses expected sp =
  let
    key = strFromInt (spanStartLine sp)
  in case clauses of
    [] => tcErr0 sp FunctionNoClauses
    [Pair pats body] => if allVarPats pats then checkDefIn globals ctx0 ec pats body expected sp
    else
      let
        _ = perfSample! key "MULTI"
      in Vuna.Compiler.Common.bind (resolveOverFunPats ec ctx0 expected clauses) (\r => case r of
        Pair clauses2 ec1 => Vuna.Compiler.Common.bind (multiToExpr (ctorFamilyTable ec1) clauses2) (\bodyExpr => let
          _ = perfSample! key "CHECKDEF"
        in checkDefIn globals ctx0 ec1 [] bodyExpr expected sp
        )
      )
    _ =>
      let
        _ = perfSample! key "MULTI"
      in Vuna.Compiler.Common.bind (resolveOverFunPats ec ctx0 expected clauses) (\r => case r of
        Pair clauses2 ec1 => Vuna.Compiler.Common.bind (multiToExpr (ctorFamilyTable ec1) clauses2) (\bodyExpr => let
          _ = perfSample! key "CHECKDEF"
        in checkDefIn globals ctx0 ec1 [] bodyExpr expected sp
        )
      )

elabFunDef : List (Pair String Term) -> Ec -> List (Pair (List Pat) Expr) -> Value -> Span -> Check (Pair Term Ec)
elabFunDef globals ec clauses expected sp = elabFunDefIn globals emptyCtx ec clauses expected sp

checkBinders : List (Pair String Term) -> Ctx -> Ec -> List Pat -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkBinders a1 a2 a3 a4 a5 a6 a7 = checkBindersFuel 512 a1 a2 a3 a4 a5 a6 a7

bindIndexBinder : List (Pair String Term) -> Ctx -> Ec -> Rig -> String -> Value -> Closure -> List Pat -> Expr -> Span -> Check (Pair Term Ec)
bindIndexBinder a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 =
  bindIndexBinderFuel 512 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10

bindOnePattern : List (Pair String Term) -> Ctx -> Ec -> Rig -> String -> List Pat -> Expr -> Value -> Closure -> Span -> Check (Pair Term Ec)
bindOnePattern a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 =
  bindOnePatternFuel 512 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10
