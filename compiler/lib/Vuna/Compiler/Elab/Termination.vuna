module Vuna.Compiler.Elab.Termination (checkTerminationDecls, checkTerminationDeclsWith) where

-- Vuna.Compiler.Elab.Termination：DT 终止性检查入口（M16 → M25.2a → M25.2b → M25.2c）。
-- 判据细节见 `.Measure`（size/R2/投影/关系/弱环）与 `.Scc`（size-change）。
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Debug
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Elab.Termination.Measure
import Vuna.Compiler.Elab.Termination.Scc

patNames : Pat -> List String
patNames (PVar n sp) = [n]
patNames (PAs n inner sp) = n :: patNames inner
patNames (PCon c ps sp) = concatMap patNames ps
patNames (PRecord rn fields sp) = concatMap (\q => patNames (secondOf q)) fields
patNames (PWild sp) = []
patNames _ = []

patsNames : List Pat -> List String
patsNames ps = concatMap patNames ps

refsOfStmt : List String -> DoStmt -> Pair (List String) (List String)
refsOfStmt bound (DBind pat e sp) = Pair (patNames pat) (exprRefsB bound e)
refsOfStmt bound (DExpr e sp) = Pair [] (exprRefsB bound e)

refsOfStmts : List String -> List DoStmt -> Pair (List String) (List String)
refsOfStmts bound [] = Pair [] []
refsOfStmts bound (st :: rest) = case refsOfStmt bound st of
  Pair newNames refs => case refsOfStmts (append newNames bound) rest of
    Pair newNames2 restRefs => Pair newNames2 (append refs restRefs)

exprRefsB : List String -> Expr -> List String
exprRefsB bound e = case e of
  EVar n sp => if memName n bound then [] else [n]
  EInt n sp => []
  EStr s sp => []
  ELam ns b sp => exprRefsB (append ns bound) b
  EApp fn args sp => append (exprRefsB bound fn) (concatMap (exprRefsB bound) args)
  EPi n implicit dom cod sp => append (exprRefsB bound dom) (exprRefsB (n :: bound) cod)
  ELet binds b rec_ sp =>
    append (concatMap (\bd => exprRefsB bound (secondOf bd)) binds)
      (exprRefsB (append (concatMap (\bd => patNames (firstOf bd)) binds) bound) b)
  ECase scrut alts sp =>
    append (exprRefsB bound scrut)
      (concatMap (\alt => exprRefsB (append (patNames (firstOf alt)) bound) (secondOf alt)) alts)
  EIf c t el sp => append (exprRefsB bound c) (append (exprRefsB bound t) (exprRefsB bound el))
  EField base f sp => exprRefsB bound base
  ERecord rn fields sp => concatMap (\q => exprRefsB bound (secondOf q)) fields
  ERecUpdate base fields sp =>
    append (exprRefsB bound base) (concatMap (\q => exprRefsB bound (secondOf q)) fields)
  EDo stmts sp => secondOf (refsOfStmts bound stmts)
  EAnn value ty sp => append (exprRefsB bound value) (exprRefsB bound ty)
  -- A2：局部函数组：每个 clause 的参数模式绑定在其体内可见。
  ELocalFun clauses sp =>
    concatMap (\c => exprRefsB (append (patsNames (firstOf c)) bound) (secondOf c)) clauses
  _ => []

refsOfDef : List (Pair (List Pat) Expr) -> List String
refsOfDef clauses = dedup (concatMap (\c => exprRefsB (patsNames (firstOf c)) (secondOf c)) clauses)

mapEdges : HashMap Bool -> List (Pair String (List (Pair (List Pat) Expr))) -> List (Pair String (List String))
mapEdges names [] = []
mapEdges names (d :: rest) =
  Pair (firstOf d) (filter (\r => Base.HashMap.member r names) (refsOfDef (secondOf d)))
    :: mapEdges names rest

callGraph : List (Pair String (List (Pair (List Pat) Expr))) -> List (Pair String (List String))
callGraph defs = mapEdges (Base.HashMap.ofNames (defNames defs)) defs

adjOf : String -> HashMap (List String) -> List String
adjOf n g = case Base.HashMap.lookup n g of
  Just xs => xs
  Nothing => []

adjTblOf : List (Pair String (List String)) -> HashMap (List String)
adjTblOf g = Base.HashMap.insertAll g (Base.HashMap.fromList [])

-- 反向邻接表：一次遍历建哈希表（旧 transpose 逐边 lookup/replace 是 O(#边 × #节点)）。
reverseAdjOf : List (Pair String (List String)) -> HashMap (List String)
reverseAdjOf [] = Base.HashMap.fromList []
reverseAdjOf ((Pair src dsts) :: rest) = addSrcs src dsts (reverseAdjOf rest)

addSrcs : String -> List String -> HashMap (List String) -> HashMap (List String)
addSrcs src [] t = t
addSrcs src (dst :: ds) t =
  let
    cur = case Base.HashMap.lookup dst t of
      Just xs => xs
      Nothing => []
  in addSrcs src ds (Base.HashMap.insert dst (src :: cur) t)

replacePair : String -> List String -> List (Pair String (List String)) -> List (Pair String (List String))
replacePair n v [] = []
replacePair n v ((Pair k xs) :: rest) =
  if k == n then Pair n v :: rest else Pair k xs :: replacePair n v rest

addEdge : String -> String -> List (Pair String (List String)) -> List (Pair String (List String))
-- 注意：这里**不做 dedup**。每个新边都对已累积的依赖表 dedup 是 O(k²)（高扇入
-- 时合计 O(k³)）；去重挪到 transpose 结束后整表做一次（dedupTransposed）。
addEdge n m acc = case lookupPair n acc of
  Just xs => replacePair n (m :: xs) acc
  Nothing => Pair n [m] :: acc

addEdges : String -> List String -> List (Pair String (List String)) -> List (Pair String (List String))
addEdges src [] a = a
addEdges src (d :: ds) a = addEdges src ds (addEdge d src a)

transposeGo : List (Pair String (List String)) -> List (Pair String (List String)) -> List (Pair String (List String))
transposeGo [] acc = acc
transposeGo ((Pair src dsts) :: rest) acc = transposeGo rest (addEdges src dsts acc)

transpose : List (Pair String (List String)) -> List (Pair String (List String))
transpose g = dedupTransposed (transposeGo g [])

dedupTransposed : List (Pair String (List String)) -> List (Pair String (List String))
dedupTransposed [] = []
dedupTransposed ((Pair n xs) :: rest) = Pair n (dedup xs) :: dedupTransposed rest

edgeCount : List (Pair String (List String)) -> Int
edgeCount [] = 0
edgeCount ((Pair n ds) :: rest) = length ds + edgeCount rest

graphFuel : List (Pair String (List String)) -> List String -> Int
graphFuel g nodes = 4 * length nodes + 4 * edgeCount g + 16

-- 迭代 DFS 后序：steps 里 (n, False) = 访问，(n, True) = 发射。
dfsPost : List (Pair String Bool) -> Int -> HashMap (List String) -> HashMap Bool -> List String -> Pair (HashMap Bool) (List String)
dfsPost steps fuel g visited post = if fuel <= 0 then Pair visited post
else case steps of
  [] => Pair visited post
  (Pair n emit) :: rest =>
    if emit then dfsPost rest (fuel - 1) g visited (n :: post)
    else if Base.HashMap.member n visited then dfsPost rest (fuel - 1) g visited post
    else dfsPost (append (map (\m => Pair m False) (adjOf n g)) (Pair n True :: rest)) (fuel - 1) g
      (Base.HashMap.insert n True visited) post

dfsAll : List String -> Int -> HashMap (List String) -> HashMap Bool -> List String -> List String
dfsAll [] fuel g visited post = post
dfsAll (n :: rest) fuel g visited post = if fuel <= 0 then post
else if Base.HashMap.member n visited then dfsAll rest (fuel - 1) g visited post
else case dfsPost [Pair n False] fuel g visited post of
  Pair v2 p2 => dfsAll rest (fuel - 1) g v2 p2

postOrder : HashMap (List String) -> List (Pair String (List String)) -> List String -> List String
postOrder gT g nodes = dfsAll nodes (graphFuel g nodes) gT (Base.HashMap.fromList []) []

collectComp : List String -> Int -> HashMap (List String) -> HashMap Bool -> List String -> Pair (HashMap Bool) (List String)
collectComp stack fuel rg assigned comp = if fuel <= 0 then Pair assigned comp
else case stack of
  [] => Pair assigned comp
  m :: rest =>
    if Base.HashMap.member m assigned then collectComp rest (fuel - 1) rg assigned comp
    else collectComp (append (adjOf m rg) rest) (fuel - 1) rg (Base.HashMap.insert m True assigned)
      (m :: comp)

sccOf : List String -> Int -> HashMap (List String) -> HashMap Bool -> List (List String) -> List (List String)
sccOf [] fuel rg assigned comps = comps
sccOf (n :: rest) fuel rg assigned comps = if fuel <= 0 then comps
else if Base.HashMap.member n assigned then sccOf rest (fuel - 1) rg assigned comps
else case collectComp [n] (fuel - 1) rg assigned [] of
  Pair assigned2 comp => sccOf rest (fuel - 1) rg assigned2 (comp :: comps)

strWalk : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> Expr -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalk fuel comp ctors projs p sizes caller facts region e acc = if fuel <= 0 then acc
else case e of
  EApp fn args sp => strWalkEApp (fuel - 1) comp ctors projs p sizes caller facts region fn args acc
  ECase scrut alts sp =>
    strWalkAlts (fuel - 1) comp ctors projs p sizes caller facts region scrut alts
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region scrut acc)
  EIf c t el sp => case guardPosVar c of
    Just v =>
      let
        acc1 = strWalk (fuel - 1) comp ctors projs p sizes caller facts region c acc
        acc2 = strWalk (fuel - 1) comp ctors projs p sizes caller facts region t acc1
      in strWalk (fuel - 1) comp ctors projs p sizes caller facts (v :: region) el acc2
    Nothing =>
      strWalk (fuel - 1) comp ctors projs p sizes caller facts region el
        (strWalk (fuel - 1) comp ctors projs p sizes caller facts region t (strWalk (fuel - 1) comp ctors projs p sizes caller facts region c acc))
  ELam ns b sp => strWalk (fuel - 1) comp ctors projs p sizes caller facts region b acc
  ELet binds body rec_ sp =>
    strWalk (fuel - 1) comp ctors projs p sizes caller facts region body
      (strWalkBinds (fuel - 1) comp ctors projs p sizes caller facts region binds acc)
  EPi n implicit dom cod sp =>
    strWalk (fuel - 1) comp ctors projs p sizes caller facts region cod
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region dom acc)
  EField base f sp => strWalk (fuel - 1) comp ctors projs p sizes caller facts region base acc
  ERecord rn fields sp =>
    strWalkFields (fuel - 1) comp ctors projs p sizes caller facts region fields acc
  ERecUpdate base fields sp =>
    strWalkFields (fuel - 1) comp ctors projs p sizes caller facts region fields
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region base acc)
  EDo stmts sp => strWalkStmts (fuel - 1) comp ctors projs p sizes caller facts region stmts acc
  EAnn value ty sp =>
    strWalk (fuel - 1) comp ctors projs p sizes caller facts region ty
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region value acc)
  -- A2：where/let 多 clause 局部函数的每个 clause body 都要进 STR 遍历（body 里可能
  -- 调用外层递归函数，旧 `_ => acc` 会漏检）。借用 `strWalkBinds`（参数表与 `strWalk`
  -- 完全一致，SCT 可证下降）；模式列表只用来定位，不参与 STR。
  ELocalFun clauses sp =>
    strWalkBinds (fuel - 1) comp ctors projs p sizes caller facts region (localClauseBinds clauses)
      acc
  EVar n sp => if memName n comp then markInvalid acc else acc
  _ => acc

localClauseBinds : List (Pair (List Pat) Expr) -> List (Pair Pat Expr)
localClauseBinds [] = []
localClauseBinds ((Pair pats body) :: rest) =
  Pair (PWild (exprSpan body)) body :: localClauseBinds rest

strWalkEApp : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> Expr -> List Expr -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkEApp fuel comp ctors projs p sizes caller facts region fn args acc = if fuel <= 0 then acc
else case groupHead comp fn of
  Just callee => case argRel p args sizes ctors projs caller facts region of
    Nothing =>
      markInvalid (strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc)
    Just rel =>
      strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args
        (addEdgeMode caller callee rel acc)
  Nothing => case fn of
    EVar nm nsp =>
      if isMapLike nm then strWalkEAppMap (fuel - 1) comp ctors projs p sizes caller facts region fn args acc
      else strWalkApp (fuel - 1) comp ctors projs p sizes caller facts region fn args acc
    _ => strWalkApp (fuel - 1) comp ctors projs p sizes caller facts region fn args acc

strWalkEAppMap : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> Expr -> List Expr -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkEAppMap fuel comp ctors projs p sizes caller facts region fn args acc = if fuel <= 0 then acc
else case args of
  [ELam ([v]) body lamsp, lst] =>
    let
      acc1 = strWalk (fuel - 1) comp ctors projs p sizes caller facts region lst acc
      sizes2 = extendElemSizes sizes lst v
    in strWalk (fuel - 1) comp ctors projs p sizes2 caller facts region body acc1
  [cb, lst] => case cb of
    EApp (EVar g gsp) pargs cbsp =>
      if memName g comp then strWalkMapPartialInline (fuel - 1) comp ctors projs p sizes caller facts region g pargs lst
        cbsp acc
      else strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc
    EVar g gsp =>
      if memName g comp then strWalkMapPartialInline (fuel - 1) comp ctors projs p sizes caller facts region g [] lst gsp
        acc
      else strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc
    _ => strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc
  _ => strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args acc

strWalkMapPartialInline : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> String -> List Expr -> Expr -> Span -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkMapPartialInline fuel comp ctors projs p sizes caller facts region g pargs lst cbsp acc = if fuel <= 0 then acc
else
  let
    acc1 = strWalk (fuel - 1) comp ctors projs p sizes caller facts region lst acc
    elems = extendElemSizes sizes lst "$elem"
    fullArgs = append pargs [EVar "$elem" cbsp]
    acc2 = strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region pargs acc1
  in case argRel p fullArgs elems ctors projs caller facts region of
    Nothing => markInvalid acc2
    Just rel => addEdgeMode caller g rel acc2

strWalkApp : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> Expr -> List Expr -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkApp fuel comp ctors projs p sizes caller facts region fn args acc =
  if fuel <= 0 then acc
  else strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region args
    (strWalk (fuel - 1) comp ctors projs p sizes caller facts region fn acc)

strWalkArgs : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> List Expr -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkArgs fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkArgs fuel comp ctors projs p sizes caller facts region (a :: rest) acc =
  if fuel <= 0 then acc
  else strWalkArgs (fuel - 1) comp ctors projs p sizes caller facts region rest
    (strWalk (fuel - 1) comp ctors projs p sizes caller facts region a acc)

strWalkAlts : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> Expr -> List (Pair Pat Expr) -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkAlts fuel comp ctors projs p sizes caller facts region scrut [] acc =
  if fuel <= 0 then acc else acc
strWalkAlts fuel comp ctors projs p sizes caller facts region scrut ((Pair pat body) :: rest) acc =
  if fuel <= 0 then acc
  else strWalkAlts (fuel - 1) comp ctors projs p sizes caller facts region scrut rest
    (strWalk (fuel - 1) comp ctors projs p (extendSizesStrict sizes scrut pat) caller facts region body acc)

strWalkBinds : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> List (Pair Pat Expr) -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkBinds fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkBinds fuel comp ctors projs p sizes caller facts region ((Pair pat val) :: rest) acc =
  if fuel <= 0 then acc
  else strWalkBinds (fuel - 1) comp ctors projs p sizes caller facts region rest
    (strWalk (fuel - 1) comp ctors projs p sizes caller facts region val acc)

strWalkFields : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> List (Pair String Expr) -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkFields fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkFields fuel comp ctors projs p sizes caller facts region ((Pair fn fe) :: rest) acc =
  if fuel <= 0 then acc
  else strWalkFields (fuel - 1) comp ctors projs p sizes caller facts region rest
    (strWalk (fuel - 1) comp ctors projs p sizes caller facts region fe acc)

strWalkStmts : Int -> List String -> List String -> List (Pair String (List Int)) -> Int -> List (Pair String (Pair Int (Pair Int (List Int)))) -> String -> HashMap (List Int) -> List String -> List DoStmt -> Pair Bool (List (Pair (Pair String String) Int)) -> Pair Bool (List (Pair (Pair String String) Int))
strWalkStmts fuel comp ctors projs p sizes caller facts region [] acc =
  if fuel <= 0 then acc else acc
strWalkStmts fuel comp ctors projs p sizes caller facts region (s :: rest) acc = if fuel <= 0 then acc
else case s of
  DBind pat e sp =>
    strWalkStmts (fuel - 1) comp ctors projs p sizes caller facts region rest
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region e acc)
  DExpr e sp =>
    strWalkStmts (fuel - 1) comp ctors projs p sizes caller facts region rest
      (strWalk (fuel - 1) comp ctors projs p sizes caller facts region e acc)

strClause : List String -> List String -> List (Pair String (List Int)) -> Int -> String -> HashMap (List Int) -> Pair (List Pat) Expr -> Pair Bool (List (Pair (Pair String String) Int))
strClause comp ctors projs p caller facts clause =
  strWalk 100000 comp ctors projs p (strSizeEntries (firstOf clause)) caller facts []
    (secondOf clause) (Pair True [])

-- 终止性失败的描述（<0>）：两种措辞（单函数 / 递归组）统一到 arity 1 的
-- `CannotProveTermination`，描述里保留原来的区分信息。
groupMessage : List String -> String
groupMessage ([f]) = f ++ " (recursive call does not structurally decrease)"
groupMessage comp =
  "recursive group {"
    ++ joinComma comp
    ++ "} (mutual recursion: no parameter position decreases on every recursive call)"

cannotProveMsg : List String -> String
cannotProveMsg comp =
  let
    desc = groupMessage comp
  in tcMsg (CannotProveTermination desc) (VCons desc VNil)

collectClauses : List (Pair (List Pat) Expr) -> List String -> List String -> List (Pair String (List Int)) -> Int -> String -> HashMap (List Int) -> Pair Bool (List (Pair (Pair String String) Int)) -> Result (Pair Bool (List (Pair (Pair String String) Int)))
collectClauses [] comp ctors projs p caller facts acc = Ok acc
collectClauses (cl :: rest) comp ctors projs p caller facts acc = case firstOf acc of
  False => Ok acc
  True => case strClause comp ctors projs p caller facts cl of
    Pair valid edges =>
      if valid then collectClauses rest comp ctors projs p caller facts (Pair True (append (secondOf acc) edges))
      else Ok (Pair False (secondOf acc))

collectMeasure : List String -> HashMap (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> Int -> HashMap (List Int) -> List String -> Pair Bool (List (Pair (Pair String String) Int)) -> Result (Pair Bool (List (Pair (Pair String String) Int)))
collectMeasure comp defTbl ctors projs p facts [] acc = Ok acc
collectMeasure comp defTbl ctors projs p facts (n :: rest) acc =
  andThen (collectClauses (clausesOfDefTbl n defTbl) comp ctors projs p n facts acc)
    (\acc2 => collectMeasure comp defTbl ctors projs p facts rest acc2)

-- 同一对 (caller, callee) 的所有调用点都非零 ⇒ 该边严格。
tryMeasure : List String -> HashMap (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap (List Int) -> Int -> Int -> Result Int
tryMeasure comp defTbl ctors projs facts p maxP =
  tryMeasureGo comp defTbl ctors projs facts (maxP - p) maxP

tryMeasureGo : List String -> HashMap (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap (List Int) -> Int -> Int -> Result Int
tryMeasureGo comp defTbl ctors projs facts remaining maxP = if remaining <= 0 then Err (cannotProveMsg comp)
else
  let
    p = maxP - remaining
  in case collectMeasure comp defTbl ctors projs p facts comp (Pair True []) of
    Err e => Err e
    Ok (Pair valid edges) => if valid then
      let
        modes = filterModes (map secondOf edges)
      in if notEmpty modes then if allSame modes then if hasWeakCycle comp edges then tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP
      else Ok 0
      else tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP
      else tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP
    else tryMeasureGo comp defTbl ctors projs facts (remaining - 1) maxP

checkStrictGroup : List String -> HashMap (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> List (Pair String Int) -> Result Int
checkStrictGroup comp defTbl ctors projs facts =
  let
    factsTbl = posTblOf facts
  in case tryMeasure comp defTbl ctors projs factsTbl 0 (maxArityOf comp defTbl) of
    Ok n => Ok n
    Err e => case tryFuelThread comp defTbl ctors projs factsTbl e of
      Ok n => Ok n
      Err e2 => sctCheck comp defTbl ctors projs factsTbl e2

checkComp : List String -> HashMap (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap (List String) -> List (Pair String Int) -> Result Int
checkComp [] defTbl ctors projs g facts = Ok 0
checkComp (comp@([f])) defTbl ctors projs g facts =
  if memName f (adjOf f g) then checkStrictGroup comp defTbl ctors projs facts else Ok 0
checkComp comp defTbl ctors projs g facts = checkStrictGroup comp defTbl ctors projs facts

-- M34：worklist 不动点——首轮扫所有有出边的 caller，之后只重扫「新 facts 的 callee 的
-- callers」；旧实现每轮全量扫描所有 defs（16 轮 × posWalk），是 check 的最大热点。
computePosFactsWork : List String -> HashMap (List (Pair (List Pat) Expr)) -> HashMap (List String) -> Int -> List (Pair String Int) -> List String -> List (Pair String Int)
computePosFactsWork names defTbl rgT fuel facts work = if fuel <= 0 then facts
else
  let
    scan = posScanNames names defTbl (posTblOf facts) work (Pair [] [])
    fresh = posFilterTbl (firstOf scan) (posTblOf (secondOf scan))
    newFacts = posFilterTbl fresh (posTblOf facts)
    merged = posUnionTbl facts fresh
    nextWork = dedup (concatMap (\n => adjOf n rgT) (map firstOf newFacts))
  in case nextWork of
    [] => merged
    _ => computePosFactsWork names defTbl rgT (fuel - 1) merged nextWork

-- 只报告 own 里定义的函数的终止性失败；其余（依赖包已在自己 check 里验过）只作为
-- 分析上下文参与 SCT（跨包调用/投影/构造子关系需要它们的子句）。全量路径 own = 全部名字。
checkTerminationDecls : List Decl -> Result Int
checkTerminationDecls decls = checkTerminationDeclsWith (dfunNames decls) decls

dfunNames : List Decl -> List String
dfunNames [] = []
dfunNames (d :: rest) = case d of
  DFun name pats body sp => name :: dfunNames rest
  _ => dfunNames rest

checkTerminationDeclsWith : List String -> List Decl -> Result Int
checkTerminationDeclsWith own decls =
  let
    defs = groupDefs decls
    defTbl = Base.HashMap.fromList defs
    ctors = ctorNamesOf decls
    projs = projectionsOf defs
    g = callGraph defs
    gT = adjTblOf g
    nodes = defNames defs
    rgT = reverseAdjOf g
    callerNames = filter (\n => notEmpty (adjOf n gT)) nodes
    facts = computePosFactsWork nodes defTbl rgT 16 [] callerNames
    _ = stamp "term-facts"
    fuel = graphFuel g nodes
    post = postOrder gT g nodes
    comps = sccOf post fuel rgT (Base.HashMap.fromList []) []
  in checkSccsWith own (reverse comps) defTbl ctors projs gT facts

anyOwn : List String -> List String -> Bool
anyOwn own [] = False
anyOwn own (n :: rest) = if memName n own then True else anyOwn own rest

checkSccsWith : List String -> List (List String) -> HashMap (List (Pair (List Pat) Expr)) -> List String -> List (Pair String (List Int)) -> HashMap (List String) -> List (Pair String Int) -> Result Int
checkSccsWith own [] defTbl ctors projs g facts = Ok 0
checkSccsWith own (comp :: rest) defTbl ctors projs g facts =
  if anyOwn own comp then andThen (checkComp comp defTbl ctors projs g facts)
    (\n => andThen (checkSccsWith own rest defTbl ctors projs g facts) (\m => Ok (n + m)))
  else checkSccsWith own rest defTbl ctors projs g facts
