module Vuna.Compiler.Elab.Dict
  ( MemberLookup(..)
  , allocTeleMetas
  , argHeadMatchesKind
  , boolShortCircuit
  , dictArgKind
  , dictArgKinds
  , dictArgUnsolvedMeta
  , dictClassArg
  , dictClassArgs
  , firstUnsolvedDictGoal
  , firstUnsolvedDictGoalMeta
  , firstUnsolvedDictGoalSpan
  , firstUnsolvedInterpGoal
  , firstUnsolvedInterpGoalSpan
  , firstUnsolvedMemberGoal
  , firstUnsolvedMemberGoalSpan
  , hasSpecificInterpInstance
  , isCmpMethod
  , isDictDomain
  , isEqMethod
  , isMemberDomain
  , isRigidDictArg
  , memberLookup
  , neutralHeadOrSelf
  , numMethodOpName
  , resolveDictGoals
  , resolveRowGoalsCtx
  , searchInstanceIn
  , specializeCmpTy
  , specializeEqTy
  , substDictTerm
  , valueDictFamily
  ) where

-- Vuna.Compiler.Elab.Dict：字典编码的**表示与实例搜索**：字典类型/实例头的识别、实例搜索（conv 头匹配）、
-- 延迟字典元变量的回填（resolveDictGoals）、运算符特化（==、<、&& 等降到内建/方法投影）。
-- 这一层必须在 `Elab.Term` 之前：`inferArgs` 的隐式字典插入要调用它。
-- 拆自 M24 的单一 `Elab.vuna`（按真实调用图切；门面仍是 `Vuna.Compiler.Elab`）。
import Base.List
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Core
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Debug
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Representation
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Elab.Sig
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Intrinsics
import Vuna.Compiler.Frontend.Ast

isDictDomain : Ec -> Value -> Bool
isDictDomain ec dom = isDictValue ec (forceVal ec dom)

isDictValue : Ec -> Value -> Bool
isDictValue ec (VNeutral n) = case n of
  NGlobal g sp => isDictFamily ec g
  _ => False
isDictValue ec _ = False

isDictFamily : Ec -> String -> Bool
isDictFamily ec g = memName g (map (\c => dictTypeName (dtClassName c)) (ecClasses ec))

-- 实例搜索（M29-T2a）：
--   1. 先查**局部上下文**里的字典 binder（实例方法体的 tele ctx 字典）；
--   2. 刚性类参数（含结构化：`Box a`）在「全部实例都无 tele/ctx」时可直接判缺失，省掉
--      每个隐式插入点的全实例 conv 扫描（自检热路径）；
--   3. 全局候选按「分配 tele meta → conv 结果头 → 递归解 ctx」匹配；named 实例不参与
--      自动搜索（M23 语义，T2b 删除该特性）。
searchInstanceIn : List (Pair String Term) -> Ctx -> Ec -> Value -> Span -> Check (Pair Term Ec)
searchInstanceIn globals ctx ec dom sp = searchInstFuel globals ctx 16 ec dom sp

-- 兼容入口：无局部上下文（顶层回填路径）。
searchInstance : Ec -> Value -> Span -> Check (Pair Term Ec)
searchInstance ec dom sp = searchInstanceIn [] emptyCtx ec dom sp

record InstMatch where
  instMatchInst : DtInst
  instMatchTerm : Term

instMatchInst : InstMatch -> DtInst
instMatchInst (InstMatch i t) = i

-- 递归深度上限（实例 ctx 链）；`fuel` 在每个递归层减 1。
--
-- M36 blanket 实例（头实参是裸类参数，见 `Elab.Meta.isBlanketInst`）是 fallback：
-- 搜索分两阶段——先只试**具体**实例；一个都没命中时才试 blanket。这样具体实例
-- 优先（`Interp String` 覆盖 blanket `Show a => Interp a`），且 blanket 的 ctx 求解
-- 不会污染具体候选的元变量解。
searchInstFuel : List (Pair String Term) -> Ctx -> Int -> Ec -> Value -> Span -> Check (Pair Term Ec)
searchInstFuel globals ctx fuel ec dom sp = if fuel <= 0 then missingInstance ec dom sp
else
  let
    _ =
      if debugOn then note
        "search: dom=${showValue dom} rigid=${if rigidSearchFast ec dom then "T" else "F"} insts=${length (ecInsts ec)}"
      else 0
  in case localDictLookup ctx 0 dom ec of
    Just pair => OkC pair
    Nothing => if rigidSearchFast ec dom && not (viaCandidateExists ec dom) then missingInstance ec dom sp
    else case matchInstances globals ctx fuel ec dom sp (specificInstances (searchCandidates ec dom)) [] of
      Pair [] ec1 => case tryViaDict globals ctx (fuel - 1) ec1 dom sp of
        OkC (Just pair) => OkC pair
        OkC Nothing => case matchInstances globals ctx fuel ec1 dom sp (blanketInstances (searchCandidates ec dom)) [] of
          Pair matches ec2 => finishInstanceSearch dom sp matches ec2
        ErrC e => ErrC e
      Pair matches ec1 => finishInstanceSearch dom sp matches ec1

-- ---------------------------------------------------------------
-- M42：`deriving via field` 的字典委托（通用 GND：class 集合由底层实例决定）
-- ---------------------------------------------------------------
-- | 按类名在类表里查 DtClass；找不到返回 Nothing。
findClass : String -> List DtClass -> Maybe DtClass
findClass cn [] = Nothing
findClass cn (c :: rest) = if dtClassName c == cn then Just c else findClass cn rest

-- | 由类名求出它的字典类型族名（`Dict_<类>`）；类未声明时返回 Nothing。
famOfClass : Ec -> String -> Maybe String
famOfClass ec cn = case findClass cn (ecClasses ec) of
  Just c => Just (dictTypeName (dtClassName c))
  Nothing => Nothing

-- | 判断类名列表里是否有某个类的字典族名等于给定族名。
anyViaClassFam : Ec -> String -> List String -> Bool
anyViaClassFam ec fam [] = False
anyViaClassFam ec fam (cn :: rest) = case famOfClass ec cn of
  Just f => if f == fam then True else anyViaClassFam ec fam rest
  Nothing => anyViaClassFam ec fam rest

-- | 判断数据族的 `deriving via field` 类集合是否允许给定字典族委托。
viaAllowsFam : Ec -> DtData -> String -> Bool
viaAllowsFam ec d fam = anyViaClassFam ec fam d.dtDataViaClasses

-- | 把数据族的前 n 个参数 Pi 依次应用到实参上；参数不足或形状不符返回 Nothing。
applyDataPis : Ec -> Int -> Value -> List Value -> Maybe Value
applyDataPis ec n v args = if n <= 0 then Just v
else case args of
  [] => Nothing
  a :: rest => case forceVal ec v of
    VPi _ _ _ _ clo => applyDataPis ec (n - 1) (applyClosure clo a) rest
    _ => Nothing

-- | 求 via 字段的类型：用族参数实例化构造子类型后，取紧接着的那个 Pi 域。
viaFieldType : Ec -> DtData -> DtCtor -> List Value -> Maybe Value
viaFieldType ec d c args = if length args /= length d.dtDataParams then Nothing
else case applyDataPis ec (length d.dtDataParams) (eval [] (dtCtorType c)) args of
  Just v => case forceVal ec v of
    VPi _ _ _ dom _ => Just dom
    _ => Nothing
  Nothing => Nothing

-- | 若值是指向某个全局包装族的应用，尝试解析它能提供的 via 字段类型。
viaWrapperOf : Ec -> String -> Value -> Maybe Value
viaWrapperOf ec fam arg = case forceVal ec arg of
  VNeutral (NGlobal w wargs) => viaWrapperData ec fam w wargs
  _ => Nothing

-- | 在数据表里查包装族，并在它允许给定字典族时继续按形状取 via 字段类型。
viaWrapperData : Ec -> String -> String -> List Value -> Maybe Value
viaWrapperData ec fam w wargs = case findDtData w (ecDatas ec) of
  Nothing => Nothing
  Just d => if viaAllowsFam ec d fam then viaWrapperShape ec d wargs else Nothing

-- | 对可去装箱的单构造子包装族，取唯一保留字段的域作为 via 字段类型。
viaWrapperShape : Ec -> DtData -> List Value -> Maybe Value
viaWrapperShape ec d wargs = if memName (dtDataName d) (unboxedFamilySet (ecDatas ec)) then case dtDataCtors d of
  [] => Nothing
  c :: _ => viaFieldType ec d c wargs
else Nothing

-- | 判断实参列表里是否有某个实参能为给定字典族提供 via 字段。
anyViaWrapper : Ec -> String -> List Value -> Bool
anyViaWrapper ec fam [] = False
anyViaWrapper ec fam (a :: rest) = case viaWrapperOf ec fam a of
  Just _ => True
  Nothing => anyViaWrapper ec fam rest

-- | 目标字典值是否有可用的 via 包装候选（用于实例搜索早退）。
viaCandidateExists : Ec -> Value -> Bool
viaCandidateExists ec dom = case forceVal ec dom of
  VNeutral (NGlobal fam args) => anyViaWrapper ec fam args
  _ => False

-- | 把值列表第 i 个元素替换成新值（越界时原样返回已走过的前缀）。
replaceAt : Int -> Value -> List Value -> List Value
replaceAt i x [] = []
replaceAt i x (a :: rest) =
  if i <= 0 then Base.List.Cons x rest else Base.List.Cons a (replaceAt (i - 1) x rest)

-- | 尝试用 `deriving via field` 委托求字典目标：找到包装候选后逐实参定位字段。
tryViaDict : List (Pair String Term) -> Ctx -> Int -> Ec -> Value -> Span -> Check (Maybe (Pair Term Ec))
tryViaDict globals ctx fuel ec dom sp = if fuel <= 0 then OkC Nothing
else case forceVal ec dom of
  VNeutral (NGlobal fam args) =>
    if viaCandidateExists ec dom then tryViaArgs globals ctx (fuel - 1) ec sp fam args 0
    else OkC Nothing
  _ => OkC Nothing

-- | 在目标实参里找可用的 via 包装；用替换后的字段类型重新搜索字典实例。
tryViaArgs : List (Pair String Term) -> Ctx -> Int -> Ec -> Span -> String -> List Value -> Int -> Check (Maybe (Pair Term Ec))
tryViaArgs globals ctx fuel ec sp fam args idx = if fuel <= 0 then OkC Nothing
else case args of
  [] => OkC Nothing
  arg :: rest => case viaWrapperOf ec fam arg of
    Nothing => tryViaArgs globals ctx (fuel - 1) ec sp fam rest (idx + 1)
    Just fieldTy =>
      Vuna.Compiler.Common.bind
        (searchInstFuel globals ctx (fuel - 1) ec (VNeutral (NGlobal fam (replaceAt idx fieldTy args))) sp)
        (\p => OkC (Just p))

-- S5a：实例搜索的候选集合——按 `dom` 的字典族**精确取桶**，不再扫全实例表。
-- 族名取 force 后的头部（`Dict_<类>`）；族名不确定时（未解元变量、非字典头）回落全表：
-- 旧行为依赖 conv 在求解过程中把 dom 解成实例头，此时注册时未知的族不能替它收敛候选。
-- 建桶用注册时的实例头族名（`instFamilyOf`），与这里取的值来自同一符号，故同族必同键。
-- | 按目标字典族精确取实例桶；族名不确定（未解元变量或非字典头）时回落全表。
searchCandidates : Ec -> Value -> List DtInst
searchCandidates ec dom =
  let
    fam = valueDictFamily (forceVal ec dom)
  in if fam == "" then ecInsts ec else ecInstsFamily ec fam

specificInstances : List DtInst -> List DtInst
specificInstances [] = []
specificInstances (i :: rest) =
  if isBlanketInst i then specificInstances rest else Base.List.Cons i (specificInstances rest)

blanketInstances : List DtInst -> List DtInst
blanketInstances [] = []
blanketInstances (i :: rest) =
  if isBlanketInst i then Base.List.Cons i (blanketInstances rest) else blanketInstances rest

finishInstanceSearch : Value -> Span -> List InstMatch -> Ec -> Check (Pair Term Ec)
finishInstanceSearch dom sp [] ec = missingInstance ec dom sp
finishInstanceSearch dom sp ([m]) ec = OkC (Pair m.instMatchTerm ec)
finishInstanceSearch dom sp matches ec =
  let
    _ =
      if debugOn then note
        "search-ambig: dom=${showValue dom} cands=${join "," (map (\x => dtInstName (instMatchInst x)) matches)}"
      else 0
    sd = showValue dom
    names = joinInstNames (map instMatchInst matches)
  in tcErr2 sp (AmbiguousInstance sd names) sd names

missingInstance : Ec -> Value -> Span -> Check a
missingInstance ec dom sp =
  let
    forced = forceVal ec dom
    sd = showValue forced
  in if valueDictFamily forced == dictTypeName interpTypeName then
    let
      td = case dictClassArg ec forced of
        Just argTy => showResolvedValue ec argTy
        Nothing => sd
    in tcErr1 sp (InterpNoInstance td) td
  else tcErr1 sp (NoInstanceFound sd) sd

-- 诊断用：把值按当前解渲染成类型文本。`showValue` 不解元变量，会把已解出的类型显示成
-- `?N`（插值缺实例时最需要的是真实类型名，例如 `Foo`）。
showResolvedValue : Ec -> Value -> String
showResolvedValue ec v = showTerm (zonkTerm ec 0 (quote 0 (forceVal ec v)))

-- M36：未解字典目标里第一个插值目标（诊断用）——`Elab.Driver` 在报“未解元变量”之前
-- 先命中它，给出可操作的 `TC_InterpNoInstance`（类型参数已确定的那些）。
firstUnsolvedInterpGoal : Ec -> Maybe String
firstUnsolvedInterpGoal ec = firstUnsolvedInterpGoalGo ec (ecPending ec)

firstUnsolvedInterpGoalGo : Ec -> List Constraint -> Maybe String
firstUnsolvedInterpGoalGo ec [] = Nothing
firstUnsolvedInterpGoalGo ec ((Constraint cid kind m dom span depth) :: rest) = case metaLookup m (ecSolTbl ec) of
  Just _ => firstUnsolvedInterpGoalGo ec rest
  Nothing =>
    let
      forced = forceVal ec dom
    in if valueDictFamily forced == dictTypeName interpTypeName then Just (case dictClassArg ec forced of
      Just argTy => showResolvedValue ec argTy
      Nothing => showResolvedValue ec forced
    )
    else firstUnsolvedInterpGoalGo ec rest

-- 局部上下文查找：ctxItems 最近的 binder 在前，其 de Bruijn index 就是下标 i。
localDictLookup : Ctx -> Int -> Value -> Ec -> Maybe (Pair Term Ec)
localDictLookup ctx i dom ec = case ctx.ctxItems of
  [] => Nothing
  _ => localDictLookupGo ctx i dom ec ctx.ctxItems

localDictLookupGo : Ctx -> Int -> Value -> Ec -> List (Pair String Term) -> Maybe (Pair Term Ec)
localDictLookupGo ctx i dom ec [] = Nothing
localDictLookupGo ctx i dom ec ((Pair name ty) :: rest) =
  let
    v = forceVal ec (varTypeValue ctx i ty)
  in if isDictValue ec v then case conv (ecDefTbl ec) (ecSolsP ec) 0 v dom of
    OkC sols2 => Just (Pair (TVar name i (Span "" 0 0 0 0)) (ecPutSols ec (solsList sols2)))
    ErrC e => localDictLookupGo ctx (i + 1) dom ec rest
  else localDictLookupGo ctx (i + 1) dom ec rest

-- 刚性类参数快路径：只有当**同一字典族**的实例都是单态（tele/ctx 均空）时才可确定
-- 匹配不上。M36 起按类过滤：blanket 实例（如 `Interp`）只让它自己的类退回全量搜索，
-- 其余类（Eq/Ord/...）仍走快路径（自检热路径）。S5a：候选已是该族的精确桶
-- （`isRigidDictArg` 成立 ⇒ dom 的头是全局名 ⇒ 族名非空），不再需要全表族过滤。
rigidSearchFast : Ec -> Value -> Bool
rigidSearchFast ec dom = isRigidDictArg ec dom && allInstancesMono (searchCandidates ec dom)

-- 字典/实例头的族名（`Dict_<类>`）；非字典形态返回空串。
valueDictFamily : Value -> String
valueDictFamily (VNeutral n) = case n of
  NGlobal g sp => g
  _ => ""
valueDictFamily _ = ""

-- M36 跟进：primitive `interp` 快捷路径的语义护栏——若程序里存在**具体** `Interp <ty>`
-- 实例（如用户自定义 `instance Interp Int`），洞与显式 `interp` 都必须走字典路径，
-- 不能被编译器的 String/Int/Nat 快捷降级静默覆盖。
-- S5a：候选直接取 `Dict_Interp` 的族桶（桶键即实例头族名），不再扫全表。
hasSpecificInterpInstance : Ec -> String -> Bool
hasSpecificInterpInstance ec tyName =
  hasSpecificInterpInstanceGo tyName (ecInstsFamily ec (dictTypeName interpTypeName))

hasSpecificInterpInstanceGo : String -> List DtInst -> Bool
hasSpecificInterpInstanceGo tyName [] = False
hasSpecificInterpInstanceGo tyName (i :: rest) =
  if not (isBlanketInst i) && instHeadArgTypeName i == tyName then True
  else hasSpecificInterpInstanceGo tyName rest

instHeadArgTypeName : DtInst -> String
instHeadArgTypeName i = case flattenTaggedApp i.dtInstHead of
  Just (Pair g (arg :: rest)) => termTypeNameOf (firstOf arg)
  _ => ""

termTypeNameOf : Term -> String
termTypeNameOf (TGlobal g) = g
termTypeNameOf _ = ""

isMonoInst : DtInst -> Bool
isMonoInst i = case i.dtInstTele of
  [] => case i.dtInstCtx of
    [] => True
    _ => False
  _ => False

-- 全部实例都是单态（tele/ctx 均空）：刚性类参数保证匹配不上，可提前返回。
allInstancesMono : List DtInst -> Bool
allInstancesMono [] = True
allInstancesMono (i :: rest) = if isMonoInst i then allInstancesMono rest else False

matchInstances : List (Pair String Term) -> Ctx -> Int -> Ec -> Value -> Span -> List DtInst -> List InstMatch -> Pair (List InstMatch) Ec
matchInstances globals ctx fuel ec dom sp [] acc = Pair (reverse acc) ec
matchInstances globals ctx fuel ec dom sp (i :: rest) acc = case tryMatchInst globals ctx fuel ec i dom sp of
  Just (Pair term ec1) => matchInstances globals ctx fuel ec1 dom sp rest (InstMatch i term :: acc)
  Nothing => matchInstances globals ctx fuel ec dom sp rest acc

-- 单个候选：alloc tele metas → conv 结果头 → 读 tele 解 → 递归解 ctx → 组装
-- `TGlobal inst <typeArgs(Rig0)> <dictArgs(Rig1)>`。
tryMatchInst : List (Pair String Term) -> Ctx -> Int -> Ec -> DtInst -> Value -> Span -> Maybe (Pair Term Ec)
tryMatchInst globals ctx fuel ec inst dom sp = if fuel <= 0 then Nothing
else case allocTeleMetas inst.dtInstSpan ctx ec inst.dtInstTele of
  Pair metas ec1 =>
    let
      _ =
        if debugOn then note
          "inst-try: ${dtInstName inst} head=${showTerm inst.dtInstHead} tele=${length inst.dtInstTele}"
        else 0
      hd = eval (map (\m => VMeta m []) metas) inst.dtInstHead
    in case conv (ecDefTbl ec1) (ecSolsP ec1) 0 dom hd of
      ErrC e =>
        let
          _ =
            if debugOn then note "inst-conv-err: ${dtInstName inst} dom=${showValue dom} hd=${showValue hd}"
            else 0
        in Nothing
      OkC sols2 =>
        let
          ec2 = ecPutSols ec1 (solsList sols2)
        in case solveTeleMetas ec2 metas of
          Nothing => Nothing
          Just solved =>
            let
              teleArgs =
                map (\v => Pair (quote (ctxDepth ctx) (forceVal ec2 v)) Rig0) (reverse solved)
              env2 = map (\v => forceVal ec2 v) solved
              ctxVals = map (\t => forceVal ec2 (eval env2 t)) inst.dtInstCtx
            in case solveDictCtxs globals ctx (fuel - 1) ec2 sp ctxVals [] of
              Nothing => Nothing
              Just (Pair dictArgs ec3) =>
                Just
                  (Pair (foldAppTerms (TGlobal (dtInstName inst)) (append teleArgs dictArgs)) ec3)

allocTeleMetas : Maybe Span -> Ctx -> Ec -> List (Pair String Term) -> Pair (List Int) Ec
allocTeleMetas msp ctx ec [] = Pair [] ec
allocTeleMetas msp ctx ec (t :: rest) = case allocMetaAt msp ctx ec of
  Pair tm ec1 => case allocTeleMetas msp ctx ec1 rest of
    Pair ids ec2 => Pair (termMetaId tm :: ids) ec2

allocMetaAt : Maybe Span -> Ctx -> Ec -> Pair Term Ec
allocMetaAt Nothing ctx ec = newMeta ctx ec
allocMetaAt (Just sp) ctx ec = newMetaAt sp ctx ec

termMetaId : Term -> Int
termMetaId (TMeta m) = m
termMetaId _ = 0

solveTeleMetas : Ec -> List Int -> Maybe (List Value)
solveTeleMetas ec [] = Just []
solveTeleMetas ec (m :: rest) = case metaLookup m (ecSolTbl ec) of
  Nothing => Nothing
  Just v => case solveTeleMetas ec rest of
    Nothing => Nothing
    Just vs => Just (v :: vs)

solveDictCtxs : List (Pair String Term) -> Ctx -> Int -> Ec -> Span -> List Value -> List (Pair Term Rig) -> Maybe (Pair (List (Pair Term Rig)) Ec)
solveDictCtxs globals ctx fuel ec sp [] acc = Just (Pair (reverse acc) ec)
solveDictCtxs globals ctx fuel ec sp (cv :: rest) acc = case searchInstFuel globals ctx fuel ec cv sp of
  ErrC e => Nothing
  OkC (Pair t ec1) => solveDictCtxs globals ctx fuel ec1 sp rest (Pair t RigOmega :: acc)

-- 行成员约束（W3）：把 `rowMem e r` 的隐式证明当作一个特殊的延迟目标。
-- 这些名字来自受信任的 Base.Eff（见 effects.md §8）；编译器只认这三个头名。
data RowProofKind : Type where
  RowProofYes : RowProofKind
  RowProofNo : RowProofKind
  RowProofUnknown : RowProofKind

rowMemDomName : String
rowMemDomName = "Base.Eff.rowMem"

rowYesDomName : String
rowYesDomName = "Base.Eff.Yes"

rowNoDomName : String
rowNoDomName = "Base.Eff.No"

-- | 自动补注（M41 新增导出）：rowYesCtorName。
rowYesCtorName : String
rowYesCtorName = "Base.Eff.Yes.MkYes"

-- 行成员证明（W3）：`Member e r` 是 Type-1 归纳族；精化器按行结构
-- 构造 `Here`/`There` 证明。只认 Base.Eff 的族/构造子名
-- （名字集中在 `Vuna.Compiler.Intrinsics` 的效果协议常量）。
memberDomName : String
memberDomName = effMemberFamilyName

-- | 行成员证明构造子 `Here` 的全名（协议常量在 `Intrinsics`）。
hereCtorName : String
hereCtorName = effMemberHereCtor

-- | 行成员证明构造子 `There` 的全名（协议常量在 `Intrinsics`）。
thereCtorName : String
thereCtorName = effMemberThereCtor

data MemberLookup : Type where
  MemberFound : Value -> Ec -> MemberLookup
  MemberAbsent : MemberLookup
  MemberStuck : MemberLookup
  -- 命名行（ND6）：标签候选 ≥2，推迟到最终化报 TC_AmbiguousInstance；携带候选文本。
  MemberAmbiguous : List String -> MemberLookup

isMemberDomain : Ec -> Value -> Bool
isMemberDomain ec dom = case quote 0 dom of
  -- 命名行（ND1）：`Member n e r`（实例名、标签、行）。
  TApp (TApp (TApp (TGlobal g) _ _) _ _) _ _ => g == memberDomName
  _ => False

-- Member 约束的域形状：3 索引（实例名、标签、行）。
data MemberDom : Type where
  MemberDom3 : Value -> Value -> Value -> MemberDom

memberSpine : Value -> Maybe MemberDom
memberSpine (VNeutral (NGlobal g sp)) = if g == memberDomName then case length sp of
  -- 3 索引用单 Cons 分支，规避旧编译器在深/浅多 Cons 分支回退时的变量串位（debt D53）。
  3 => case sp of
    n :: e :: r :: _ => Just (MemberDom3 n e r)
    _ => Nothing
  _ => Nothing
else Nothing
memberSpine _ = Nothing

ctorValue : Ec -> String -> List Value -> Value
ctorValue ec name vals = case dtCtorLookupEc ec name of
  Just ctor => VCon (dtCtorName ctor) vals
  Nothing => VCon name vals

memberLookup : Int -> Int -> Ec -> Value -> MemberLookup
memberLookup fuel depth ec dom = if fuel <= 0 then MemberStuck
else case memberSpine dom of
  Nothing => MemberStuck
  Just (MemberDom3 nVal eVal rVal) => memberLookupRow fuel depth ec nVal eVal rVal

-- ---------------------------------------------------------------
-- 命名行（native-effects ND1/ND6/ND7）：`Member ?n e r` 的名字槽求解
-- ---------------------------------------------------------------
-- 标签候选扫描（纯比较，不提交 meta 解）：数标签与 eF 结构相等的条目。
-- 返回 (候选文本, 是否到达具体行尾 Nil)。开放行（尾部是刚性行变量）时收束为
-- (已扫到的候选, False)——尾部内容不可知，但具体前缀里的候选仍足以构造
-- Here/There 证明；未解 meta 行返回 Nothing（推迟，不猜）。
namedRowScan : Int -> Sols -> Ec -> Value -> Value -> Maybe (Pair (List String) Bool)
namedRowScan fuel sols ec eF rF = if fuel <= 0 then Nothing
else case forceVal ec rF of
  VCon cname cargs => if cname == effRowNilCtor then Just (Pair [] True)
  else if cname == effRowConsCtor then case cargs of
    n1 :: h :: t :: _ => if hasUnsolvedMetaValue sols h then Nothing
    else case valueEqFuel 64 eF h of
      Nothing => Nothing
      Just False => namedRowScan (fuel - 1) sols ec eF t
      Just True => case namedRowScan (fuel - 1) sols ec eF t of
        Nothing => Nothing
        Just (Pair cands closed) => Just (Pair (Base.List.Cons (showValue h) cands) closed)
    _ => Nothing
  else Nothing
  VNeutral _ => Just (Pair [] False)
  _ => Nothing

-- 证明构造：行条目按 (名字, 标签) 双匹配推进；名字槽用 convEc 合一（ND6：目标名是
-- meta → 解为条目名；条目名是 meta → 两侧合一；两者刚性 → 必须相等）。名字刚性且
-- 头部名字不等时继续往尾部找（There），不贪婪地卡在 Here。
memberLookupRowUnique : Int -> Int -> Ec -> Value -> Value -> Value -> MemberLookup
memberLookupRowUnique fuel depth ec nF eF rF = if fuel <= 0 then MemberStuck
else case forceVal ec rF of
  VCon cname cargs => if cname == effRowNilCtor then MemberAbsent
  else if cname == effRowConsCtor then case cargs of
    n1 :: h :: t :: _ => case valueEqFuel 64 eF h of
      Nothing => MemberStuck
      Just False => case memberLookupRowUnique (fuel - 1) depth ec nF eF t of
        MemberFound subProof ec1 =>
          MemberFound (ctorValue ec1 thereCtorName [nF, eF, n1, h, t, subProof]) ec1
        other => other
      Just True => case convEc ec depth nF n1 of
        OkC ec1 => MemberFound (ctorValue ec1 hereCtorName [nF, eF, t]) ec1
        ErrC _ => case memberLookupRowUnique (fuel - 1) depth ec nF eF t of
          MemberFound subProof ec1 =>
            MemberFound (ctorValue ec1 thereCtorName [nF, eF, n1, h, t, subProof]) ec1
          other => other
    _ => MemberStuck
  else MemberStuck
  _ => MemberStuck

-- 标签里带未解 meta 时的线性合一匹配（perform 语法：标签 = `Xxx ?n`，名字与标签共用
-- 同一个 meta）。逐条 convEc 试标签：成功即在这一条上再 conv 名字；失败跳过（不提交）。
-- 遇到未知尾部即卡住（推迟，不猜）。
memberLookupRowGreedy : Int -> Int -> Ec -> Value -> Value -> Value -> MemberLookup
memberLookupRowGreedy fuel depth ec nF eF rF = if fuel <= 0 then MemberStuck
else case forceVal ec rF of
  VCon cname cargs => if cname == effRowNilCtor then MemberAbsent
  else if cname == effRowConsCtor then case cargs of
    n1 :: h :: t :: _ => case convEc ec depth eF h of
      ErrC _ => memberLookupRowGreedy (fuel - 1) depth ec nF eF t
      OkC ec1 => case convEc ec1 depth nF n1 of
        OkC ec2 => MemberFound (ctorValue ec2 hereCtorName [nF, eF, t]) ec2
        ErrC _ => memberLookupRowGreedy (fuel - 1) depth ec nF eF t
    _ => MemberStuck
  else MemberStuck
  _ => MemberStuck

-- 命名行求解入口（`Member n e r`，ND6 全扫描、拒绝贪婪 Here）：
--   0 候选 + 具体行尾 → 缺效应；0 候选 + 开放尾 → 推迟；
--   ≥2 候选且名字未定 → MemberAmbiguous（最终化报 TC_AmbiguousInstance）；
--   其余（含名字刚性可消歧、开放行前缀候选）→ 名字合一 + Here/There 证明构造。
memberLookupRow : Int -> Int -> Ec -> Value -> Value -> Value -> MemberLookup
memberLookupRow fuel depth ec nVal eVal rVal = if fuel <= 0 then MemberStuck
else
  let
    nF = forceVal ec nVal
    eF = forceVal ec eVal
    sols = ecSolsP ec
  in if hasUnsolvedMetaValue sols eF then memberLookupRowGreedy fuel depth ec nF eF rVal
  else case namedRowScan 64 sols ec eF rVal of
    -- 标签含未解 meta（perform 语法的 `Xxx ?n`，名字与标签共用同一个 meta）：全扫描无法
    -- 做结构计数，改走线性合一匹配（conv 成功即命中，失败跳过）。
    -- 目标名字是未解 meta 不是卡点：唯一标签候选下 conv 把它解为条目名（D6/D7）。
    Nothing => MemberStuck
    Just (Pair cands closed) => case cands of
      [] => if closed then MemberAbsent else MemberStuck
      _ =>
        if length cands >= 2 && hasUnsolvedMetaValue sols nF then MemberAmbiguous cands
        else memberLookupRowUnique (fuel - 1) depth ec nF eF rVal

-- 在局部上下文里找同类型的隐式证明 binder（wrapper 体里 `{w : Member e r}`）。
ctxMemberProofTermGo : List (Pair String Term) -> Int -> String -> Maybe Term
ctxMemberProofTermGo [] idx target = Nothing
ctxMemberProofTermGo ((Pair name ty) :: rest) idx target =
  if showTerm ty == target then Just (TVar name idx (Span "" 0 0 0 0))
  else ctxMemberProofTermGo rest (idx + 1) target

ctxMemberProofTerm : Ctx -> Ec -> Value -> Maybe Term
ctxMemberProofTerm ctx ec dom =
  ctxMemberProofTermGo ctx.ctxItems 0 (showTerm (quote (ctxDepth ctx) dom))

-- 结构 proof 卡住时，用局部 binder 的类型与目标 dom 统一（例如 wrapper 体里
-- `sendCore` 的行元变量尚未与 wrapper 的 r 统一）。
ctxMemberProofUnify : Ctx -> Ec -> Value -> Maybe (Pair Term Ec)
ctxMemberProofUnify ctx ec dom = ctxMemberProofUnifyGo ctx ctx.ctxItems 0 ec dom

ctxMemberProofUnifyGo : Ctx -> List (Pair String Term) -> Int -> Ec -> Value -> Maybe (Pair Term Ec)
ctxMemberProofUnifyGo ctx [] idx ec dom = Nothing
ctxMemberProofUnifyGo ctx ((Pair name ty) :: rest) idx ec dom = case convEc ec (ctxDepth ctx) (evalCtx ctx ty) dom of
  OkC ec2 => Just (Pair (TVar name idx (Span "" 0 0 0 0)) ec2)
  ErrC _ => ctxMemberProofUnifyGo ctx rest (idx + 1) ec dom

solveRowMeta : Ec -> Int -> Value -> Check Ec
solveRowMeta ec m v = case solveMeta (ecDefTbl ec) (ecSolsP ec) 0 m [] v of
  OkC sols2 => OkC (ecPutSols ec (solsList sols2))
  ErrC e => ErrC e

resolveRowGoalsCtx : List (Pair String Term) -> Ctx -> Ec -> Span -> Check Ec
resolveRowGoalsCtx globals ctx ec sp = resolveRowGoalsCtxGo globals ctx sp (ecPending ec) ec []

resolveRowGoalsCtxGo : List (Pair String Term) -> Ctx -> Span -> List Constraint -> Ec -> List Constraint -> Check Ec
resolveRowGoalsCtxGo globals ctx sp [] ec kept = OkC (ecPutPending ec (reverse kept))
resolveRowGoalsCtxGo globals ctx sp ((c@(Constraint cid kind m dom cspan cdepth)) :: rest) ec kept = case isMemberDomain ec dom of
  True => case memberLookup 64 (ctxDepth ctx) ec dom of
    MemberFound proof ec2 => case solveRowMeta ec2 m proof of
      OkC ec3 => resolveRowGoalsCtxGo globals ctx sp rest ec3 kept
      ErrC e => ErrC e
    MemberAbsent => tcErr1 sp (NoInstanceFound "row membership") "row membership"
    -- 命名行（ND5）：同标签多实例且名字未定 → 显式歧义诊断，不再间接退化为缺实例。
    MemberAmbiguous cands =>
      tcErr2 sp (AmbiguousInstance "effect instance" (join ", " cands)) "effect instance"
        (join ", " cands)
    MemberStuck => case ctxMemberProofTerm ctx ec dom of
      Just proofTerm => case solveRowMeta ec m (eval (ctxEnv ctx) proofTerm) of
        OkC ec2 => resolveRowGoalsCtxGo globals ctx sp rest ec2 kept
        ErrC e => ErrC e
      Nothing => case ctxMemberProofUnify ctx ec dom of
        Just (Pair proofTerm ec2) => case solveRowMeta ec2 m (eval (ctxEnv ctx) proofTerm) of
          OkC ec3 => resolveRowGoalsCtxGo globals ctx sp rest ec3 kept
          ErrC e => ErrC e
        Nothing => tcErr1 sp (NoInstanceFound "row membership") "row membership"
  False => case dictClassArgs ec dom of
    [] => resolveRowGoalsCtxGo globals ctx sp rest ec (c :: kept)
    args => if anyUnsolvedMetaArg ec args then resolveRowGoalsCtxGo globals ctx sp rest ec (c :: kept)
    else if isRigidDictArg ec dom && allInstancesMono (ecInsts ec) then resolveRowGoalsCtxGo globals ctx sp rest ec (c :: kept)
    else case searchInstanceIn globals ctx ec (forceVal ec dom) sp of
      OkC (Pair instTerm ec1) => case solveMeta (ecDefTbl ec1) (ecSolsP ec1) 0 m [] (eval (ctxEnv ctx) instTerm) of
        OkC sols2 => resolveRowGoalsCtxGo globals ctx sp rest (ecPutSols ec1 (solsList sols2)) kept
        ErrC e => resolveRowGoalsCtxGo globals ctx sp rest ec (c :: kept)
      ErrC e => resolveRowGoalsCtxGo globals ctx sp rest ec (c :: kept)

resolveDictGoals : List (Pair String Term) -> Ec -> Ec
resolveDictGoals globals ec = resolveDictGoalsFuel (length (ecPending ec) + 1) globals ec

-- 单趟 worklist：逐个处理表头，成功即提交；未解目标按原顺序追加到表尾（保持旧的
-- 旋转语义）。旧实现在严格求值下把“处理尾部”算两遍（keep + 成功分支再递归），
-- 目标同时可解时是 2^k；这里每个目标每趟只处理一次，指数消除。
resolveDictGoalsFuel : Int -> List (Pair String Term) -> Ec -> Ec
resolveDictGoalsFuel fuel globals ec = if fuel <= 0 then ec
else case ecPending ec of
  [] => ec
  (c@(Constraint cid kind m dom cspan cdepth)) :: rest =>
    let
      ec1 = ecPutPending ec rest
    in case metaLookup m (ecSolTbl ec1) of
      -- C4：已解/已提升的约束直接摘除（settled），不再占用后续轮次的扫描。
      Just _ => resolveDictGoalsFuel (fuel - 1) globals ec1
      Nothing =>
        let
          solsNow = length (ecSols ec1)
        in case ecTriedAt ec1 cid of
          -- C4：上次尝试后解表没增长 ⇒ 结果不会变，跳过搜索，原地保留。
          Just tried => if tried == solsNow then
            let
              ec2 = resolveDictGoalsFuel (fuel - 1) globals ec1
            in ecPutPending ec2 (append (ecPending ec2) [c])
          else
            let
              forced = forceVal ec1 dom
              kept =
                Constraint cid kind m (if isMemberDomain ec1 dom then dom else forced) cspan cdepth
              solsTried = length (ecSols ec1)
            in case tryResolveDictGoal globals ec1 c forced of
              Just ec2 => resolveDictGoalsFuel (fuel - 1) globals ec2
              Nothing =>
                let
                  ec2 = resolveDictGoalsFuel (fuel - 1) globals ec1
                  ec3 = ecRecordTried ec2 cid solsTried
                in ecPutPending ec3 (append (ecPending ec3) [kept])
          Nothing =>
            let
              forced = forceVal ec1 dom
              kept =
                Constraint cid kind m (if isMemberDomain ec1 dom then dom else forced) cspan cdepth
              solsTried = length (ecSols ec1)
            in case tryResolveDictGoal globals ec1 c forced of
              Just ec2 => resolveDictGoalsFuel (fuel - 1) globals ec2
              Nothing =>
                let
                  ec2 = resolveDictGoalsFuel (fuel - 1) globals ec1
                  ec3 = ecRecordTried ec2 cid solsTried
                in ecPutPending ec3 (append (ecPending ec3) [kept])

-- | 尝试求解一条延迟约束：行成员走 memberLookup，字典目标走实例搜索并回填元变量。
tryResolveDictGoal : List (Pair String Term) -> Ec -> Constraint -> Value -> Maybe Ec
tryResolveDictGoal globals ec (Constraint cid kind m dom cspan cdepth) forced = if isMemberDomain ec dom then case memberLookup 64 0 ec dom of
  MemberFound proof ec2 => case solveRowMeta ec2 m proof of
    OkC ec3 => Just ec3
    ErrC e => Nothing
  MemberAbsent => Nothing
  MemberAmbiguous _ => Nothing
  MemberStuck => Nothing
else case dictClassArgs ec forced of
  [] => Nothing
  args => if anyUnsolvedMetaArg ec args then Nothing
  else if isRigidDictArg ec forced && allInstancesMono (ecInsts ec) then Nothing
  else case searchInstance ec forced (Span "" 0 0 0 0) of
    OkC (Pair instTerm ec2) => case solveMeta (ecDefTbl ec2) (ecSolsP ec2) 0 m [] (eval [] instTerm) of
      OkC sols2 => Just (ecPutSols ec2 (solsList sols2))
      ErrC e => Nothing
    ErrC e => Nothing

-- M29-T2b：字典解的 term 化要**保留 multiplicity**：参数化实例的字典项形如
-- `TApp (TApp (TGlobal inst) <typeArg>) <dictArg>`，而 Value spine 不含 rig；
-- 直接 `quote 0` 会把 erased 类型实参渲染成运行期实参（OCaml 里出现 `v_Int`）。
-- 这里按实例签名的 Pi 前缀（`Π tele(Rig0). Π ctx(Rig1). head`）恢复每个实参的 rig。
substDictTerm : Ec -> Term -> Term
substDictTerm ec t = substDictTermGo ec 0 t

substDictTermGo : Ec -> Int -> Term -> Term
substDictTermGo ec depth (t@(TMeta m)) = case metaLookup m (ecSolTbl ec) of
  Nothing => t
  Just v => case dictTermOfValueAt ec depth v of
    -- 解按**出现点深度** quote 成项；越界/负索引说明它引用了出现点之外的 binder，保留元变量。
    Just soln => if hasFreeTermVar depth soln || hasNegativeVar soln then t else soln
    Nothing =>
      let
        soln0 = quote depth v
      in if hasFreeTermVar depth soln0 || hasNegativeVar soln0 then t else soln0
substDictTermGo ec depth (TPi n i r dom cod) =
  TPi n i r (substDictTermGo ec depth dom) (substDictTermGo ec (depth + 1) cod)
substDictTermGo ec depth (TLam n r b) = TLam n r (substDictTermGo ec (depth + 1) b)
substDictTermGo ec depth (TApp f a r) =
  TApp (substDictTermGo ec depth f) (substDictTermGo ec depth a) r
substDictTermGo ec depth (TCon c args) =
  TCon c (map (\p => Pair (substDictTermGo ec depth (firstOf p)) (secondOf p)) args)
substDictTermGo ec depth (TMk c args) =
  TMk c (map (\p => Pair (substDictTermGo ec depth (firstOf p)) (secondOf p)) args)
substDictTermGo ec depth (TRecord c args) =
  TRecord c (map (\p => Pair (substDictTermGo ec depth (firstOf p)) (secondOf p)) args)
substDictTermGo ec depth (TCase s alts) =
  TCase (substDictTermGo ec depth s) (map (\alt => substDictTermAlt ec depth alt) alts)
substDictTermGo ec depth (TIf c th el) =
  TIf (substDictTermGo ec depth c) (substDictTermGo ec depth th) (substDictTermGo ec depth el)
substDictTermGo ec depth t = t

substDictTermAlt : Ec -> Int -> CaseAlt -> CaseAlt
substDictTermAlt ec depth (CaseAlt n bs b) = CaseAlt n bs (substDictTermGo ec (depth + length bs) b)

-- 把 Value 里的全局应用脊还原成 Term，并按全局签名恢复每个实参的 rig。
-- 实参按出现点深度 quote（旧实现按 0 quote，binder 下的解会得到负索引/错位索引）。
-- B31：单函数 + 显式 fuel 处理 Value 与 spine 的相互递归；若拆成多个互递归函数，
-- 终止性检查器无法在 Value/List 参数上建立下降环。先看**未 force** 的值：实例字典解
-- 形如 `NGlobal <inst> [tele, ctx]`，先 forceVal 会把定义体 delta 展开成 `VCon`，
-- 失去每个实参的 rig；spine 实参本身也可能是字典解，必须递归重建。
data DictTermTask : Type where
  DictTermValue : Value -> DictTermTask
  DictTermSpine : Term -> List Value -> List Rig -> DictTermTask

dictTermOfValueAt : Ec -> Int -> Value -> Maybe Term
dictTermOfValueAt ec depth v = renderDictTermAt 64 ec depth (DictTermValue v)

renderDictTermAt : Int -> Ec -> Int -> DictTermTask -> Maybe Term
renderDictTermAt fuel ec depth task = if fuel <= 0 then Nothing
else case task of
  DictTermValue v => case v of
    VNeutral n => case n of
      NGlobal g sp =>
        renderDictTermAt (fuel - 1) ec depth (DictTermSpine (TGlobal g) sp (piRigsOfGlobal ec g))
      _ => Nothing
    _ => case forceVal ec v of
      VNeutral n => case n of
        NGlobal g sp =>
          renderDictTermAt (fuel - 1) ec depth (DictTermSpine (TGlobal g) sp (piRigsOfGlobal ec g))
        _ => Nothing
      _ => Nothing
  DictTermSpine fn [] rigs => Just fn
  DictTermSpine fn (v :: rest) rigs =>
    let
      argTerm = case renderDictTermAt (fuel - 1) ec depth (DictTermValue v) of
        Just t => t
        Nothing => quote depth v
      r = case rigs of
        x :: xs => x
        [] => RigOmega
      restRigs = case rigs of
        x :: xs => xs
        [] => []
    in renderDictTermAt (fuel - 1) ec depth (DictTermSpine (TApp fn argTerm r) rest restRigs)

-- 实例字典函数的 Pi 前缀：tele 一律 Rig0（类型参数擦除）、ctx 一律 RigOmega。
-- 先查 `ecInsts`（实例签名的真源），再回退 globals：体阶段 globals 表可能被同名项
-- 覆盖（B18）或尚未含实例头；回退顺序能避免把 tele 实参误判成运行期实参。
piRigsOfInst : Ec -> String -> Maybe (List Rig)
piRigsOfInst ec g = piRigsOfInstGo g (ecInsts ec)

piRigsOfInstGo : String -> List DtInst -> Maybe (List Rig)
piRigsOfInstGo g [] = Nothing
piRigsOfInstGo g (i :: rest) =
  if dtInstName i == g then Just (append (map (\p => Rig0) i.dtInstTele) (map (\t => RigOmega) i.dtInstCtx))
  else piRigsOfInstGo g rest

piRigsOfGlobal : Ec -> String -> List Rig
piRigsOfGlobal ec g = case piRigsOfInst ec g of
  Just rigs => rigs
  Nothing => case Base.HashMap.lookup g (ecGlobalsTbl ec) of
    Just ty => piRigs ty
    Nothing => []

piRigs : Term -> List Rig
piRigs (TPi n i r dom cod) = r :: piRigs cod
piRigs _ = []

joinInstNames : List DtInst -> String
joinInstNames [] = ""
joinInstNames (i :: rest) = dtInstName i ++ joinRestInstNames rest

joinRestInstNames : List DtInst -> String
joinRestInstNames [] = ""
joinRestInstNames (i :: rest) = ", ${dtInstName i}${joinRestInstNames rest}"

-- 字典族的类参数 kind：字典 data `Dict_C` 的构造子类型的前导隐式 Pi 域
-- （`MkDict_C : {p1 : K1} -> {p2 : K2} -> <字段>` 里的 `K1, K2, ...`）。
dictArgKinds : Ec -> Value -> Maybe (List Value)
dictArgKinds ec dom = case dictFamilyNameOf ec dom of
  Nothing => Nothing
  Just fam => case dtDataLookup fam (ecDatas ec) of
    Nothing => Nothing
    Just dd => case dtDataCtors dd of
      [] => Nothing
      c :: _ => Just (ctorParamKinds ec (forceVal ec (eval [] (dtCtorType c))) 0 [])

-- 构造子类型的前导隐式 binder 就是类参数（字段 binder 都显式，`foldPiFieldTys` 保证）。
ctorParamKinds : Ec -> Value -> Int -> List Value -> List Value
ctorParamKinds ec v lvl acc = ctorParamKindsFuel 64 ec v lvl acc

ctorParamKindsFuel : Int -> Ec -> Value -> Int -> List Value -> List Value
ctorParamKindsFuel fuel ec v lvl acc = if fuel <= 0 then reverse acc
else case v of
  VPi name implicit rig dom clo =>
    if implicit then ctorParamKindsFuel (fuel - 1) ec (forceVal ec (applyClosure clo (VNeutral (NVar name lvl []))))
      (lvl + 1) (dom :: acc)
    else reverse acc
  _ => reverse acc

-- 第一个类参数的 kind（单参数路径与历史诊断共用）。
dictArgKind : Ec -> Value -> Maybe Value
dictArgKind ec dom = case dictArgKinds ec dom of
  Just (k :: rest) => Just k
  _ => Nothing

dictFamilyNameOf : Ec -> Value -> Maybe String
dictFamilyNameOf ec dom = case forceVal ec dom of
  VNeutral (NGlobal g sp) => Just g
  _ => Nothing

-- 实参头部 `g` 的 kind 与类参数 kind 一致（`Color` 对 `Show`，`IO` 对 `Monad`）才约束。
-- 头部是元变量（`?m' Int`）或 Pi 都不是具体构造子 ⇒ 不约束。
argHeadMatchesKind : List (Pair String Term) -> Ec -> Ctx -> Value -> Value -> Bool
argHeadMatchesKind globals ec ctx forced argKind = case neutralHeadOrSelf forced of
  VNeutral (NGlobal g []) => case typeHeadLookup globals ec g of
    Just dictSig => case convEc ec (ctxDepth ctx) argKind (forceVal ec (eval [] dictSig)) of
      OkC ec2 => True
      ErrC e => False
    Nothing => True
  _ => False

-- 中性应用的头部（`Box Int` ⇒ `Box`）；非应用原样返回。
neutralHeadOrSelf : Value -> Value
neutralHeadOrSelf (VNeutral (NGlobal g (_ :: _))) = VNeutral (NGlobal g [])
neutralHeadOrSelf v = v

-- 字典域的全部类参数（`Dict_C p1 .. pn` 的 spine）。单参数 trait 只有一个元素；
-- 旧入口 `dictClassArg` 仍返回第一个参数（Interp 等单参数特化路径依赖它）。
dictClassArgs : Ec -> Value -> List Value
dictClassArgs ec dom = case forceVal ec dom of
  VNeutral (NGlobal g sp) => sp
  _ => []

dictClassArg : Ec -> Value -> Maybe Value
dictClassArg ec dom = case dictClassArgs ec dom of
  arg :: rest => Just arg
  [] => Nothing

-- 字典域类参数是否依赖**刚性局部变量**（绑定于当前定义/实例 tele 的类型变量）。
-- M29-T2a：判定改为**结构化**——`a`、`Box a`、`List (Box a)` 都算刚性（旧实现只看裸 NVar，
-- 导致 `mem (Box a)` 这类泛型调用点既搜不到实例、也不提升成隐式字典参数）。
-- 多参数：任一参数含刚性变量，具体实例头就必然匹配不上（全单态实例时）。
isRigidDictArg : Ec -> Value -> Bool
isRigidDictArg ec dom = anyRigidClassArg ec (dictClassArgs ec dom)

anyRigidClassArg : Ec -> List Value -> Bool
anyRigidClassArg ec [] = False
anyRigidClassArg ec (arg :: rest) = isRigidClassArg ec arg || anyRigidClassArg ec rest

-- 已取出的类参数是否含刚性局部变量（resolveDictGoals 里先算 dictClassArg 再判，避免重复 force）。
isRigidClassArg : Ec -> Value -> Bool
isRigidClassArg ec arg = valueHasRigidNVar ec 64 arg

valueHasRigidNVar : Ec -> Int -> Value -> Bool
valueHasRigidNVar ec fuel v = if fuel <= 0 then False
else case forceVal ec v of
  VNeutral n => case n of
    NVar name lvl sp => True
    NGlobal g sp => anyValueHasRigidNVar ec (fuel - 1) sp
  VCon c args => anyValueHasRigidNVar ec (fuel - 1) args
  VApp f a => valueHasRigidNVar ec (fuel - 1) f || valueHasRigidNVar ec (fuel - 1) a
  VCase s alts => valueHasRigidNVar ec (fuel - 1) s
  VIf c t e =>
    valueHasRigidNVar ec (fuel - 1) c
      || valueHasRigidNVar ec (fuel - 1) t
      || valueHasRigidNVar ec (fuel - 1) e
  _ => False

anyValueHasRigidNVar : Ec -> Int -> List Value -> Bool
anyValueHasRigidNVar ec fuel [] = False
anyValueHasRigidNVar ec fuel (v :: rest) =
  valueHasRigidNVar ec fuel v || anyValueHasRigidNVar ec fuel rest

-- M31.1：`==` / `/=` / `<` 等已由 Loader 解析成 Eq / Ord 的**方法名**，Elab 看到的
-- 是方法投影的完整名（如 `Base.Eq.eq`）。特化入口按「名字是否为该类的方法投影」
-- 判定（从类表取投影名，不硬编码模块前缀），不再有运算符名判断。
classHasProjection : String -> String -> String -> Ec -> Bool
classHasProjection className short name ec = case findClassByShortName className (ecClasses ec) of
  Nothing => False
  Just cls => classMethodProjection cls.dtClassMethods short == name

isEqMethod : Ec -> String -> Bool
-- 后两个是**内部生成名**：`Elab.Derive`（deriving 展开）与 `Elab.Match`（字面量模式）
-- 直接构造 `EVar "=="` / `EVar "/="`，不经过 Loader 别名；用户源码的 `==` 一律在
-- Loader 被换成 `eq`，所以内部名不会泄漏到用户语义。
isEqMethod ec name =
  classHasProjection "Eq" "eq" name ec
    || classHasProjection "Eq" "neq" name ec
    || name == "=="
    || name == "/="

isCmpMethod : Ec -> String -> Bool
isCmpMethod ec name =
  classHasProjection "Ord" "lt" name ec
    || classHasProjection "Ord" "le" name ec
    || classHasProjection "Ord" "gt" name ec
    || classHasProjection "Ord" "ge" name ec
    || name == "<"
    || name == "<="
    || name == ">"
    || name == ">="

-- D23 Stage1：`Base.Num.add/sub/mul/div` 的方法投影（四则运算符的方法形态）。
-- 与 `isEqMethod` / `isCmpMethod` 同一套「从类表取投影名」判定，不硬编码模块前缀。
-- 返回规范运算符名（`+` / `-` / `*` / `/`）：Stage 2 把 `+` 别名到 `add` 后，精化器的
-- 算术特化靠它把方法投影映射回内建原语名；泛型 `Num a =>` 代码在具体类型未知时由
-- 调用方回落到普通 trait 应用。
-- | 把 `Base.Num` 的方法投影映射回规范运算符名（`+` / `-` / `*` / `/`）；不是 Num 方法时返回 `Nothing`。
numMethodOpName : Ec -> String -> Maybe String
numMethodOpName ec name =
  if classHasProjection "Num" "add" name ec then Just "+"
  else if classHasProjection "Num" "sub" name ec then Just "-"
  else if classHasProjection "Num" "mul" name ec then Just "*"
  else if classHasProjection "Num" "div" name ec then Just "/" else Nothing

-- 方法投影的**短名**（`Base.Eq.eq` → `eq`）：特化只按短名选 runtime 函数。
methodShortOf : String -> String
methodShortOf name = secondOf (splitLastDot (splitOnDot name))

-- 内部生成名（`==` 等）到方法短名的映射；方法投影完整名直接取最后一段。
eqMethodShortOf : String -> String
eqMethodShortOf "==" = "eq"
eqMethodShortOf "/=" = "neq"
eqMethodShortOf name = methodShortOf name

cmpMethodShortOf : String -> String
cmpMethodShortOf "<" = "lt"
cmpMethodShortOf "<=" = "le"
cmpMethodShortOf ">" = "gt"
cmpMethodShortOf ">=" = "ge"
cmpMethodShortOf name = methodShortOf name

-- `eq` / `neq` 的饱和应用（M19/M29，M31.1 运算符改为方法别名）：`Int` / `String`
-- 特化成具体运行时函数；其它类型解析成 `Eq` 字典的方法投影（手写实例、`deriving (Eq)`、
-- 约束实例都算证据）。
-- M24.7：方法投影名与字典名从库里短名 `Eq` 的类表项取（`Base.Eq.Eq`），不用硬编码 `Dict_Eq`。
-- M31.1：`name` 已是被解析成方法投影的完整名（`Base.Eq.eq` / `.neq`），因此字典分支
-- 直接用它，不再有 `==` → `eq` 的映射。
--
-- M29（决策 A）：**删除泛型结构比较兜底**——程序里没有 `Eq` 类、或具体类型搜不到实例时
-- 在 check 期报错（`TC_EqRequiresEvidence` / `TC_NoInstanceFound`），不再退回
-- `bi_eq_generic`（OCaml 多态相等）或 interp 的另一套 `valueEqDeep`。
specializeEqTy : List (Pair String Term) -> Ctx -> String -> Term -> Term -> Span -> Value -> Ec -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeEqTy globals ctx name aTerm bTerm sp aTy ec = case builtinEqTyName (forceVal ec aTy) of
  Just tyName =>
    Vuna.Compiler.Common.bind (eqRuntimeName (eqMethodShortOf name) tyName)
      (\rt => OkC (Just (Pair (TApp (TApp (TGlobal rt) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal boolTypeName [])) ec))))
  Nothing => case findClassByShortName "Eq" (ecClasses ec) of
    Nothing =>
      let
        st = showValue (forceVal ec aTy)
      in tcErr1 sp (EqRequiresEvidence st) st
    Just cls =>
      let
        mname =
          if name == "==" || name == "/=" then classMethodProjection cls.dtClassMethods (eqMethodShortOf name)
          else name
        -- 类型项必须按**当前上下文深度** quote：`quote 0` 会把刚性变量拍成 level 0，
        -- 字典的类参数就会指向错误的 binder（两个以上类型参数时提到别的参数上）。
        tyTerm = quote (ctxDepth ctx) aTy
        dictTy = VNeutral (NGlobal (dictTypeName (dtClassName cls)) [aTy])
      in if dictArgUnsolvedMeta ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
      else case searchInstanceIn globals ctx ec dictTy sp of
        OkC (Pair dictTerm ec1) =>
          OkC
            (Just (Pair (TApp (TApp (TApp (TApp (TGlobal mname) tyTerm Rig0) dictTerm RigOmega) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal boolTypeName [])) ec1)))
        ErrC e =>
          if isRigidDictArg ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
          else ErrC e

-- 刚性类参数（如 `mem` 的 `a`）没有可搜实例：延迟成裸元变量 + 记录自由字典目标，
-- 等定义体精化完由 `liftFreeDictGoals` 提升成 `{d : Dict_Eq a}` 隐式参数。
deferEqDict : List (Pair String Term) -> Ctx -> String -> Term -> Term -> Term -> Span -> Value -> Ec -> Check (Maybe (Pair Term (Pair Value Ec)))
deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec =
  let
    m = ecNext ec
  in case newMetaAt sp ctx ec of
    Pair metaTerm ec1 =>
      OkC
        (Just (Pair (TApp (TApp (TApp (TApp (TGlobal mname) tyTerm Rig0) metaTerm RigOmega) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal boolTypeName [])) (ecAddConstraint ec1 CkDict m dictTy (Just sp) 0))))

-- ---------------------------------------------------------------
-- M22.2 / M31.1：`lt` / `le` / `gt` / `ge` 的饱和应用按实参类型特化
-- ---------------------------------------------------------------
-- 与 `eq` / `neq` 同构：`Int` 走具体运行时函数；`String` / `Bool` 走 OCaml `compare`
-- 的泛型运行时；其它类型解析成 `Ord` 字典的方法投影（`deriving (Ord)` 生效），
-- 刚性类参数延迟提升成 `{d : Dict_Ord a}`。
-- M31.1：`name` 是方法投影完整名（`Base.Ord.lt` 等），特化只按短名选 runtime 名。
cmpRuntimeName : Span -> String -> String -> Check String
cmpRuntimeName sp method "Int" = case method of
  "lt" => OkC "bi_lt_int"
  "le" => OkC "bi_le_int"
  "gt" => OkC "bi_gt_int"
  _ => OkC "bi_ge_int"
cmpRuntimeName sp method "String" = OkC (cmpGenericName method)
cmpRuntimeName sp method "Float" = case method of
  "lt" => OkC "bi_lt_float"
  "le" => OkC "bi_le_float"
  "gt" => OkC "bi_gt_float"
  _ => OkC "bi_ge_float"
cmpRuntimeName sp method tyName =
  if tyName == boolTypeName then OkC (cmpGenericName method)
  else tcErr2 sp (OpNotDefinedFor method tyName) method tyName

cmpGenericName : String -> String
cmpGenericName "lt" = "bi_lt_generic"
cmpGenericName "le" = "bi_le_generic"
cmpGenericName "gt" = "bi_gt_generic"
cmpGenericName _ = "bi_ge_generic"

-- 字典的类参数还有未解元变量时**不做实例搜索**：否则会像 `srt (\x,y => x <= y) xs`
-- 那样被第一个内建实例（Ord Int）提前定死，随后与 `List a` 统一时报 occurs check。
-- 延迟成字典目标，等类参数被实参/结果类型解出来后再回填。
-- 多参数：任一参数未解就延迟（实例头能同时约束所有参数，提前搜索会定死更多元变量）。
dictArgUnsolvedMeta : Ec -> Value -> Bool
dictArgUnsolvedMeta ec dom = anyUnsolvedMetaArg ec (dictClassArgs ec dom)

-- 结构判定：类参数里**嵌套**的未解 meta 也算未解（`Eff ?r` 的行 meta 是典型）。
-- 旧实现只看裸 `VMeta`，会让 `Monad (Eff ?r)` 在行 meta 解出前就搜索实例，拿到带 meta
-- 的字典项/提升成隐式参数（codegen 阶段单态化失败）。
anyUnsolvedMetaArg : Ec -> List Value -> Bool
anyUnsolvedMetaArg ec [] = False
anyUnsolvedMetaArg ec (arg :: rest) =
  hasUnsolvedMetaValue (ecSolsP ec) (forceVal ec arg) || anyUnsolvedMetaArg ec rest

specializeCmpTy : List (Pair String Term) -> Ctx -> String -> Term -> Term -> Span -> Value -> Ec -> Check (Maybe (Pair Term (Pair Value Ec)))
-- M24.7：`Ord` 类/实例在库（`Base.Ord`），按短名查类并用真实字典名/方法投影名。
-- M31.1：`name` 是方法投影完整名（`Base.Ord.lt` 等），字典分支直接使用。
-- M29：**删除「无 Ord 类 → 任意类型泛型比较」兜底**——没有 `Ord` 证据时在 check 期报错
-- （`Ord instance required`），不再生成 `bi_lt_generic` 等对用户 data 的 `compare`。
specializeCmpTy globals ctx name aTerm bTerm sp aTy ec = case cmpBuiltinTyName (forceVal ec aTy) of
  Just tyName =>
    Vuna.Compiler.Common.bind (cmpRuntimeName sp (cmpMethodShortOf name) tyName)
      (\rt => OkC (Just (Pair (TApp (TApp (TGlobal rt) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal boolTypeName [])) ec))))
  Nothing => case findClassByShortName "Ord" (ecClasses ec) of
    Nothing =>
      let
        st = showValue (forceVal ec aTy)
      in tcErr2 sp (OpNotDefinedFor (cmpMethodShortOf name) st) (cmpMethodShortOf name) st
    Just cls =>
      let
        mname =
          if name == "<" || name == "<=" || name == ">" || name == ">=" then classMethodProjection cls.dtClassMethods (cmpMethodShortOf name)
          else name
        tyTerm = quote (ctxDepth ctx) aTy
        dictTy = VNeutral (NGlobal (dictTypeName (dtClassName cls)) [aTy])
      in if dictArgUnsolvedMeta ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
      else case searchInstanceIn globals ctx ec dictTy sp of
        OkC (Pair dictTerm ec1) =>
          OkC
            (Just (Pair (TApp (TApp (TApp (TApp (TGlobal mname) tyTerm Rig0) dictTerm RigOmega) aTerm Rig1) bTerm Rig1) (Pair (VNeutral (NGlobal boolTypeName [])) ec1)))
        ErrC e =>
          if isRigidDictArg ec dictTy then deferEqDict globals ctx mname tyTerm aTerm bTerm sp dictTy ec
          else ErrC e

boolShortCircuit : String -> Term -> Term -> Term
boolShortCircuit name a b = if name == "&&" then TIf a b (TBool False) else TIf a (TBool True) b

-- W3：收尾检查——仍未解的行成员证明（缺效应，或推断不足）。
firstUnsolvedMemberGoal : Ec -> Maybe String
firstUnsolvedMemberGoal ec = firstUnsolvedMemberGoalGo ec (ecPending ec)

firstUnsolvedMemberGoalGo : Ec -> List Constraint -> Maybe String
firstUnsolvedMemberGoalGo ec [] = Nothing
firstUnsolvedMemberGoalGo ec ((Constraint cid kind m dom cspan cdepth) :: rest) = if isMemberDomain ec dom then case metaLookup m (ecSolTbl ec) of
  Nothing => Just (showValue (forceVal ec dom))
  Just _ => firstUnsolvedMemberGoalGo ec rest
else firstUnsolvedMemberGoalGo ec rest

-- C42：收尾检查——类参数**已解出**但实例搜索确实失败的延迟字典目标。这类目标在收尾时
-- 只剩一个未解 meta，旧实现混在 `unsolved metavariable` 里；这里把它识别成「缺实例」。
-- 跳过三类：Interp/Member 有专门诊断；类参数仍含未解 meta 时保持原 unsolved 文案；
-- 刚性类参数可能是待泛化的延迟目标，不能误报成缺实例。
firstUnsolvedDictGoal : Ec -> Maybe String
firstUnsolvedDictGoal ec = firstUnsolvedDictGoalGo ec (ecPending ec)

firstUnsolvedDictGoalGo : Ec -> List Constraint -> Maybe String
firstUnsolvedDictGoalGo ec [] = Nothing
firstUnsolvedDictGoalGo ec ((Constraint cid kind m dom cspan cdepth) :: rest) = case metaLookup m (ecSolTbl ec) of
  Just _ => firstUnsolvedDictGoalGo ec rest
  Nothing =>
    let
      forced = forceVal ec dom
    in if valueDictFamily forced == dictTypeName interpTypeName then firstUnsolvedDictGoalGo ec rest
    else if isMemberDomain ec forced then firstUnsolvedDictGoalGo ec rest
    else if anyUnsolvedMetaArg ec (dictClassArgs ec forced) then firstUnsolvedDictGoalGo ec rest
    else if isRigidDictArg ec forced then firstUnsolvedDictGoalGo ec rest
    else Just (showResolvedValue ec forced)

-- C5：第一条未解约束的延迟点 span（只用于给诊断加位置；与 `firstUnsolved*` 选中
-- 的第一条未解约束一致：都按 pending 顺序扫描、跳过已解 meta）。
-- D51②：按目标类别精确取第一条未解约束的 span（与 `firstUnsolved*` 选中同一条）。
-- | 第一条未解 Interp 目标的延迟点 span（按 pending 顺序扫描，跳过已解 meta）。
firstUnsolvedInterpGoalSpan : Ec -> Maybe Span
firstUnsolvedInterpGoalSpan ec = firstUnsolvedInterpSpanGo ec (ecPending ec)

-- | firstUnsolvedInterpGoalSpan 的递归实现：只保留 Interp 类目标的 span。
firstUnsolvedInterpSpanGo : Ec -> List Constraint -> Maybe Span
firstUnsolvedInterpSpanGo ec [] = Nothing
firstUnsolvedInterpSpanGo ec ((Constraint cid kind m dom cspan cdepth) :: rest) = case metaLookup m (ecSolTbl ec) of
  Just _ => firstUnsolvedInterpSpanGo ec rest
  Nothing =>
    let
      forced = forceVal ec dom
    in if valueDictFamily forced == dictTypeName interpTypeName then cspan
    else firstUnsolvedInterpSpanGo ec rest

-- | 第一条未解行成员目标的延迟点 span（按 pending 顺序扫描，跳过已解 meta）。
firstUnsolvedMemberGoalSpan : Ec -> Maybe Span
firstUnsolvedMemberGoalSpan ec = firstUnsolvedMemberSpanGo ec (ecPending ec)

-- | firstUnsolvedMemberGoalSpan 的递归实现：只保留行成员目标的 span。
firstUnsolvedMemberSpanGo : Ec -> List Constraint -> Maybe Span
firstUnsolvedMemberSpanGo ec [] = Nothing
firstUnsolvedMemberSpanGo ec ((Constraint cid kind m dom cspan cdepth) :: rest) = if isMemberDomain ec dom then case metaLookup m (ecSolTbl ec) of
  Nothing => cspan
  Just _ => firstUnsolvedMemberSpanGo ec rest
else firstUnsolvedMemberSpanGo ec rest

-- | 第一条未解普通字典目标的延迟点 span（跳过 Interp、行成员、含未解 meta 与刚性参数的目标）。
firstUnsolvedDictGoalSpan : Ec -> Maybe Span
firstUnsolvedDictGoalSpan ec = firstUnsolvedDictSpanGo ec (ecPending ec)

-- | firstUnsolvedDictGoalSpan 的递归实现，按与 firstUnsolvedDictGoal 相同的类别过滤。
firstUnsolvedDictSpanGo : Ec -> List Constraint -> Maybe Span
firstUnsolvedDictSpanGo ec [] = Nothing
firstUnsolvedDictSpanGo ec ((Constraint cid kind m dom cspan cdepth) :: rest) = case metaLookup m (ecSolTbl ec) of
  Just _ => firstUnsolvedDictSpanGo ec rest
  Nothing =>
    let
      forced = forceVal ec dom
    in if valueDictFamily forced == dictTypeName interpTypeName then firstUnsolvedDictSpanGo ec rest
    else if isMemberDomain ec forced then firstUnsolvedDictSpanGo ec rest
    else if anyUnsolvedMetaArg ec (dictClassArgs ec forced) then firstUnsolvedDictSpanGo ec rest
    else if isRigidDictArg ec forced then firstUnsolvedDictSpanGo ec rest else cspan

-- | 第一条未解字典目标对应的元变量 id（供创建点溯源；与 `firstUnsolvedDictGoal` 同一条）。
firstUnsolvedDictGoalMeta : Ec -> Maybe Int
firstUnsolvedDictGoalMeta ec = firstUnsolvedDictGoalMetaGo ec (ecPending ec)

-- | 扫描实现：跳过已解/非字典目标。
firstUnsolvedDictGoalMetaGo : Ec -> List Constraint -> Maybe Int
firstUnsolvedDictGoalMetaGo ec [] = Nothing
firstUnsolvedDictGoalMetaGo ec ((Constraint cid kind m dom cspan cdepth) :: rest) = case metaLookup m (ecSolTbl ec) of
  Just _ => firstUnsolvedDictGoalMetaGo ec rest
  Nothing =>
    let
      forced = forceVal ec dom
    in if valueDictFamily forced == dictTypeName interpTypeName then firstUnsolvedDictGoalMetaGo ec rest
    else if isMemberDomain ec forced then firstUnsolvedDictGoalMetaGo ec rest
    else if anyUnsolvedMetaArg ec (dictClassArgs ec forced) then firstUnsolvedDictGoalMetaGo ec rest
    else if isRigidDictArg ec forced then firstUnsolvedDictGoalMetaGo ec rest else Just m
