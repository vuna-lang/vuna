module Vuna.Compiler.Elab.Records
  ( RecordInfo(..)
  , checkProvidedFields
  , desugarRecords
  , duplicateFieldMsg
  , fieldBinderName
  , fieldIndex
  , fieldNamesOf
  , firstUnknownFieldMsg
  , hasDuplicateFieldNames
  , lookupProvided
  , lookupRecord
  , missingFieldMsg
  , prepareDecls
  , prepareDeclsWith
  , recordDeclToData
  , recordHasFieldInstances
  , recordsOfDecls
  , unknownFieldMsg
  ) where

-- Vuna.Compiler.Records：`record` 的**语法降级**（M19 提取成共享模块）。
--
-- record 在 vuna 里不是独立的核心语言特性，而是**纯记法**：一条 `record R where ...`
-- 等价于「带一个构造子的 data，构造子按声明顺序接收全部字段」，record 的构造、字段
-- 访问、更新与模式匹配都能在 AST 层无歧义地改写成等价的 data 记法。因此降级发生在
-- **精化之前**，HM 与 DT 两条路径共用同一份改写（这也是终态需要的行为——M24 删除 HM
-- 时这条降级留在共享模块里，不需要搬家）。
--
-- 本模块只做 AST → AST 变换，不依赖任何检查器状态（HM 的类型变量表、DT 的元变量上下文
-- 都不进来），因此放在编译器包的中立位置。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast

-- 记录声明信息。第五个字段是**构造子名**：与记录名同名（M23 起；Elab 让值位置先查
-- 构造子表、类型位置走 globals，两者同名不再冲突）。
record RecordInfo where
  recordInfoName : String
  recordInfoParams : List String
  recordInfoFields : List (Pair String Expr)
  recordInfoDerivings : List String
  recordInfoDerivingVia : Bool
  recordInfoCtor : String

lookupRecord : String -> List RecordInfo -> Maybe RecordInfo
lookupRecord name [] = Nothing
lookupRecord name ((RecordInfo rname params fields derivings derivingVia ctor) :: rest) =
  if rname == name then Just (RecordInfo rname params fields derivings derivingVia ctor)
  else lookupRecord name rest

fieldNamesOf : List (Pair a b) -> List a
fieldNamesOf [] = []
fieldNamesOf ((Pair n t) :: rest) = n :: fieldNamesOf rest

fieldIndexAt : Eq a => a -> List (Pair a b) -> Int -> Maybe Int
fieldIndexAt fname [] i = Nothing
fieldIndexAt fname ((Pair n t) :: rest) i =
  if n == fname then Just i else fieldIndexAt fname rest (i + 1)

fieldIndex : Eq a => a -> List (Pair a b) -> Maybe Int
fieldIndex fname fields = fieldIndexAt fname fields 0

lookupProvided : String -> List (Pair String a) -> Maybe a
lookupProvided fname [] = Nothing
lookupProvided fname ((Pair n e) :: rest) = if n == fname then Just e else lookupProvided fname rest

hasDuplicateFieldNames : List (Pair String a) -> Bool
hasDuplicateFieldNames [] = False
hasDuplicateFieldNames ((Pair n e) :: rest) = case lookupProvided n rest of
  Just _ => True
  Nothing => hasDuplicateFieldNames rest

missingFieldMsg : Span -> String -> String
missingFieldMsg sp fname = "${showSpanLoc sp}: missing field ${fname}"

unknownFieldMsg : Span -> String -> String
unknownFieldMsg sp fname = "${showSpanLoc sp}: unknown field ${fname}"

duplicateFieldMsg : Span -> String
duplicateFieldMsg sp = "${showSpanLoc sp}: duplicate field"

hasUnknownFields : List String -> List (Pair String a) -> Bool
hasUnknownFields fieldNames [] = False
hasUnknownFields fieldNames ((Pair n v) :: rest) =
  if memName n fieldNames then hasUnknownFields fieldNames rest else True

firstUnknownFieldMsg : Span -> List String -> List (Pair String a) -> String
firstUnknownFieldMsg sp fieldNames [] = unknownFieldMsg sp ""
firstUnknownFieldMsg sp fieldNames ((Pair n v) :: rest) =
  if memName n fieldNames then firstUnknownFieldMsg sp fieldNames rest else unknownFieldMsg sp n

checkProvidedFields : List String -> List (Pair String a) -> Span -> Result (List b)
checkProvidedFields fieldNames [] sp = Ok []
checkProvidedFields fieldNames ((Pair n v) :: rest) sp =
  if memName n fieldNames then checkProvidedFields fieldNames rest sp
  else Err (unknownFieldMsg sp n)

-- 记录声明抽取：DRecord 记住 RecordInfo，并降级成单构造器 DData。
recordsOfDecls : (String -> String) -> List Decl -> Pair (List RecordInfo) (List Decl)
recordsOfDecls ctorOf [] = Pair [] []
recordsOfDecls ctorOf (d :: rest) = case recordsOfDecls ctorOf rest of
  Pair recs ds => case d of
    DRecord dname params fields derivings viaField lin sp =>
      let
        info =
          RecordInfo dname params (map recordFieldPair fields) derivings viaField (ctorOf dname)
      in Pair (info :: recs) (recordDeclToData d (ctorOf dname) :: ds)
    _ => Pair recs (d :: ds)

recordFieldPair : Field -> Pair String Expr
recordFieldPair (Field fname ty sp) = Pair fname ty

-- 记录的构造子名：`Mk<R>`。
-- 记录声明降级：单构造子 DData。构造子名由 `ctor` 参数给出（见上面的策略说明）。
recordParamVarExprs : List String -> Span -> List Expr
recordParamVarExprs params sp = map (\p => EVar p sp) params

recordRetType : String -> List String -> Span -> Expr
recordRetType dname params sp = EApp (EVar dname sp) (recordParamVarExprs params sp) sp

-- 构造子类型用一等的 `EPi` 表示（不是 `EVar "->"` 的语法编码）：这是记录降级的
-- **输出**，交给下游检查器，不应当依赖某个检查器对箭头语法的特殊处理。
recordArrowType : List Field -> Expr -> Span -> Expr
recordArrowType [] ret sp = ret
recordArrowType (f :: fs) ret sp =
  EPi (fieldBinderName (fieldName f)) False Nothing (fieldType f) (recordArrowType fs ret sp) sp

-- 字段 binder 名带内部前缀：字段类型表达式不能把前序字段名解析成 binder。
fieldBinderPrefix : String
fieldBinderPrefix = "@vuna@record@field@"

fieldBinderName : String -> String
fieldBinderName fname = "${fieldBinderPrefix}${fname}"

-- 记录构造子类型显式带族参数（`elabCtor` 用首 binder 名判断，字段 binder 已不是 `_`）。
recordParamPis : List String -> Expr -> Span -> Expr
recordParamPis [] ret sp = ret
recordParamPis (p :: rest) ret sp =
  EPi p True Nothing (EVar "Type" sp) (recordParamPis rest ret sp) sp

recordCtorType : List String -> List Field -> Expr -> Span -> Expr
recordCtorType params fields ret sp = recordParamPis params (recordArrowType fields ret sp) sp

recordDeclToData : Decl -> String -> Decl
recordDeclToData (DRecord dname params fields derivings viaField lin sp) ctor =
  DData dname params (EVar "Type" sp)
    [Ctor ctor (recordCtorType params fields (recordRetType dname params sp) sp) (length fields) sp]
    derivings viaField lin sp
-- M23：DT 要求函数 clause 覆盖所有构造子（非 record 声明原样返回）。
recordDeclToData d ctor = d

-- 记录语法降级：构造 → 构造器应用；记录模式 → 构造器模式（按声明顺序补 PWild）。
desugarRecords : List RecordInfo -> List Decl -> Result (List Decl)
desugarRecords records decls = traverse (desugarRecordDecl records) decls

desugarRecordDecl : List RecordInfo -> Decl -> Result Decl
desugarRecordDecl records d = case d of
  DFun name pats body sp =>
    Vuna.Compiler.Common.bind (traverse (desugarPattern records) pats)
      (\pats2 => Vuna.Compiler.Common.bind (desugarExpr records body) (\body2 => Ok (DFun name pats2 body2 sp)))
  DData name params kind ctors derivings viaField lin sp => Ok d
  DRecord name params fields derivings viaField lin sp => Ok d
  DTrait name params methods sp => Ok d
  DInstance ctxE head methods sp =>
    Vuna.Compiler.Common.bind (traverse (desugarRecordDecl records) methods)
      (\ms => Ok (DInstance ctxE head ms sp))
  DSig name ctx ty sp => Ok d
  -- M28：axiom 的类型表达式里可能有 record 语法吗？类型位置不走 record 降级
  -- （record 是值层记法），原样返回。
  DAxiom name ty sp => Ok d
  DExtern name cName ty sp => Ok d

desugarPattern : List RecordInfo -> Pat -> Result Pat
desugarPattern records pat = desugarPatternFuel 64 records pat

desugarPatternFuel : Int -> List RecordInfo -> Pat -> Result Pat
desugarPatternFuel fuel records pat = if fuel <= 0 then Ok pat
else case pat of
  PWild sp => Ok (PWild sp)
  PVar n sp => Ok (PVar n sp)
  PAs n inner sp =>
    Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records inner) (\p => Ok (PAs n p sp))
  PInt n sp => Ok (PInt n sp)
  PStr s sp => Ok (PStr s sp)
  PCon name pats sp =>
    Vuna.Compiler.Common.bind (traverse (\x => desugarPatternFuel (fuel - 1) records x) pats)
      (\ps => Ok (PCon name ps sp))
  PRecord name fields sp => case lookupRecord name records of
    Nothing => Err "${showSpanLoc sp}: unknown record: ${name}"
    Just (RecordInfo rname params fdefs derivings derivingVia ctor) =>
      if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
      else if hasUnknownFields (fieldNamesOf fdefs) fields then Err (firstUnknownFieldMsg sp (fieldNamesOf fdefs) fields)
      else Vuna.Compiler.Common.bind (desugarRecordPatternFieldsFuel (fuel - 1) records fdefs fields sp)
        (\ps => Ok (PCon ctor ps sp))

desugarRecordPatternFields : List RecordInfo -> List (Pair String Expr) -> List (Pair String Pat) -> Span -> Result (List Pat)
desugarRecordPatternFields records fdefs provided sp =
  desugarRecordPatternFieldsFuel 64 records fdefs provided sp

desugarRecordPatternFieldsFuel : Int -> List RecordInfo -> List (Pair String Expr) -> List (Pair String Pat) -> Span -> Result (List Pat)
desugarRecordPatternFieldsFuel fuel records fdefs provided sp = if fuel <= 0 then Ok []
else case fdefs of
  [] => Ok []
  (Pair fname fty) :: rest => case lookupProvided fname provided of
    Nothing =>
      Vuna.Compiler.Common.bind (desugarRecordPatternFieldsFuel (fuel - 1) records rest provided sp)
        (\ps => Ok (PWild sp :: ps))
    Just p =>
      Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records p)
        (\p2 => Vuna.Compiler.Common.bind (desugarRecordPatternFieldsFuel (fuel - 1) records rest provided sp) (\ps => Ok (p2 :: ps)))

desugarExprFuel : Int -> List RecordInfo -> Expr -> Result Expr
desugarExprFuel fuel records e = if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted"
else case e of
  EVar n sp => Ok e
  EInt n sp => Ok e
  EStr s sp => Ok e
  EFloat raw sp => Ok e
  ELam ps b sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records b) (\b2 => Ok (ELam ps b2 sp))
  EApp f args sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records f)
      (\f2 => Vuna.Compiler.Common.bind (traverse (desugarExprFuel (fuel - 1) records) args) (\a2 => Ok (EApp f2 a2 sp)))
  ELet binds body rec_ sp =>
    Vuna.Compiler.Common.bind (traverse (desugarBindFuel (fuel - 1) records) binds)
      (\b2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records body) (\body2 => Ok (ELet b2 body2 rec_ sp)))
  -- A2：where/let 多 clause 局部函数：逐 clause 消解记录模式与 body。
  ELocalFun clauses sp =>
    Vuna.Compiler.Common.bind (traverse (desugarLocalClauseFuel (fuel - 1) records) clauses)
      (\c2 => Ok (ELocalFun c2 sp))
  ECase scrut alts sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records scrut)
      (\s2 => Vuna.Compiler.Common.bind (traverse (desugarAltFuel (fuel - 1) records) alts) (\a2 => Ok (ECase s2 (map (expandCaseAs s2) a2) sp)))
  EIf c t el sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records c)
      (\c2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records t) (\t2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records el) (\e2 => Ok (EIf c2 t2 e2 sp))))
  -- 字段访问/更新的消歧需要 base 的类型，留给精化器（字段名不再全局唯一）。
  EField base fname sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records base)
      (\b => Ok (EField b fname sp))
  ERecord name fields sp => case lookupRecord name records of
    Nothing => Err "${showSpanLoc sp}: unknown record: ${name}"
    Just (RecordInfo rname params fdefs derivings derivingVia ctor) =>
      if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
      else if hasUnknownFields (fieldNamesOf fdefs) fields then Err (firstUnknownFieldMsg sp (fieldNamesOf fdefs) fields)
      else Vuna.Compiler.Common.bind (desugarRecordValuesFuel (fuel - 1) records fdefs fields sp)
        (\vs => Ok (EApp (EVar ctor sp) vs sp))
  ERecUpdate base fields sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records base)
      (\b => Vuna.Compiler.Common.bind (traverse (desugarFieldValueFuel (fuel - 1) records) fields) (\fs => Ok (ERecUpdate b fs sp)))
  EDo stmts sp =>
    Vuna.Compiler.Common.bind (traverse (desugarDoStmtFuel (fuel - 1) records) stmts)
      (\s2 => Ok (EDo s2 sp))
  -- EPi 的可用性由各自的检查器判定（HM 报错、DT 支持），降级这里只做结构递归。
  EPi name implicit qty dom cod sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records dom)
      (\d2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records cod) (\c2 => Ok (EPi name implicit qty d2 c2 sp)))
  -- M24：where 绑定签名（`EAnn value ty`）两边都做结构递归（record 可出现在值里）。
  EAnn value ty sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records value)
      (\v2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records ty) (\t2 => Ok (EAnn v2 t2 sp)))
  _ => Err "DT: internal: unreordered infix/paren in elaboration"

desugarDoStmtFuel : Int -> List RecordInfo -> DoStmt -> Result DoStmt
desugarDoStmtFuel fuel records stmt = if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted"
else case stmt of
  DBind p e sp =>
    Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records p)
      (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records e) (\e2 => Ok (DBind p2 e2 sp)))
  DExpr e sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records e) (\e2 => Ok (DExpr e2 sp))

desugarRecordValuesFuel : Int -> List RecordInfo -> List (Pair String Expr) -> List (Pair String Expr) -> Span -> Result (List Expr)
desugarRecordValuesFuel fuel records [] provided sp =
  if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted" else Ok []
desugarRecordValuesFuel fuel records ((Pair fname fty) :: rest) provided sp = if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted"
else case lookupProvided fname provided of
  Nothing => Err (missingFieldMsg sp fname)
  Just v =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records v)
      (\v2 => Vuna.Compiler.Common.bind (desugarRecordValuesFuel (fuel - 1) records rest provided sp) (\vs => Ok (v2 :: vs)))

desugarFieldValueFuel : Int -> List RecordInfo -> Pair String Expr -> Result (Pair String Expr)
desugarFieldValueFuel fuel records (Pair fname v) =
  if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records v) (\v2 => Ok (Pair fname v2))

-- ---------------------------------------------------------------
-- 记录更新 `{ p | x = 40, y = 1 }` 的降级
-- ---------------------------------------------------------------
-- 与字段访问同构：`case base of <ctor> v0 .. vn => <ctor> (更新值 | 旧字段绑定)`。
-- 只改**更新字段**位置，其余字段原样搬运。record 按字段名定位：
--   - 首个更新字段没有任何 record 声明 ⇒ unknown field；
--   - 多个 record 都声明它 ⇒ ambiguous field（与字段访问同一措辞）；
--   - 唯一候选但其余更新字段不在它里面 ⇒ unknown field。
-- 模式绑定子用 `vuna_ru<i>` 前缀，降低与用户表达式里同名变量发生捕获的概率
-- （记录更新右侧表达式按外层作用域求值）。
desugarRecUpdate : List RecordInfo -> Expr -> List (Pair String Expr) -> Span -> Result Expr
desugarRecUpdate records base [] sp =
  Err "${showSpanLoc sp}: record update needs at least one field"
desugarRecUpdate records base (fields@((Pair fname fv) :: rest)) sp = if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
else case recordsWithField fname records of
  [] => Err (unknownFieldMsg sp fname)
  [one] => desugarRecUpdateWith one base fields sp
  _ => Err "${showSpanLoc sp}: ambiguous field ${fname} (declared by multiple records)"

desugarRecUpdateWith : RecordInfo -> Expr -> List (Pair String Expr) -> Span -> Result Expr
desugarRecUpdateWith (RecordInfo rname params fdefs derivings derivingVia ctor) base fields sp = if hasUnknownFields (fieldNamesOf fdefs) fields then Err (firstUnknownFieldMsg sp (fieldNamesOf fdefs) fields)
else
  let
    vars = recUpdateVars (length fdefs)
    pats = map (\v => PVar v sp) vars
    args = recUpdateArgs fdefs fields vars 0 sp
    pat = PCon ctor pats sp
  in Ok (ECase base [Pair pat (EApp (EVar ctor sp) args sp)] sp)

recUpdateVars : Int -> List String
recUpdateVars n = recUpdateVarsAt 0 n

recUpdateVarsAt : Int -> Int -> List String
recUpdateVarsAt i n = recUpdateVarsAtGo (n - i) n

recUpdateVarsAtGo : Int -> Int -> List String
recUpdateVarsAtGo remaining n =
  if remaining <= 0 then [] else "vuna_ru${n - remaining}" :: recUpdateVarsAtGo (remaining - 1) n

recUpdateArgs : List (Pair String Expr) -> List (Pair String Expr) -> List String -> Int -> Span -> List Expr
recUpdateArgs [] provided vars i sp = []
recUpdateArgs fields provided [] i sp = []
recUpdateArgs ((Pair fname fty) :: rest) provided (v :: vs) i sp = (case lookupProvided fname provided of
  Just e => e
  Nothing => EVar v sp
) :: recUpdateArgs rest provided vs (i + 1) sp

desugarBindFuel : Int -> List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarBindFuel fuel records (Pair pat value) =
  if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records pat)
    (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records value) (\v2 => Ok (Pair p2 v2)))

-- A2：局部函数 clause（参数模式列表 + body）。
desugarLocalClauseFuel : Int -> List RecordInfo -> Pair (List Pat) Expr -> Result (Pair (List Pat) Expr)
desugarLocalClauseFuel fuel records clause =
  if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind (traverse (desugarPatternFuel (fuel - 1) records) (firstOf clause))
    (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records (secondOf clause)) (\b2 => Ok (Pair p2 b2)))

desugarAltFuel : Int -> List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarAltFuel fuel records (Pair pat body) =
  if fuel <= 0 then Err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records pat)
    (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records body) (\b2 => Ok (Pair p2 b2)))

-- 声明了该字段的 record 列表（字段访问的语法层消歧用）。
recordsWithField : String -> List RecordInfo -> List RecordInfo
recordsWithField fname [] = []
recordsWithField fname ((r@(RecordInfo rname params fdefs derivings derivingVia ctor)) :: rest) =
  if memName fname (fieldNamesOf fdefs) then r :: recordsWithField fname rest
  else recordsWithField fname rest

-- 字段访问降级：`case base of Mk<R> f0 .. fn => f_k`（缺省位置补通配）。
fieldAccessExpr : RecordInfo -> String -> Expr -> Span -> Expr
fieldAccessExpr (RecordInfo rname params fdefs derivings derivingVia ctor) fname b sp =
  let
    pats = fieldAccessPats fname fdefs
    body = EVar fname sp
    alt = Pair (PCon ctor pats sp) body
  in ECase b [alt] sp

-- 分支模式：命中的字段位置绑定成与字段同名的变量，其余补通配。
fieldAccessPats : String -> List (Pair String Expr) -> List Pat
fieldAccessPats fname [] = []
fieldAccessPats fname ((Pair f alt) :: rest) =
  (if f == fname then PVar f (exprSpan alt) else PWild (exprSpan alt)) :: fieldAccessPats fname rest

-- HasField 实例：为当前模块的 record 字段生成 `instance HasField (Field "f") R T`。
recordHasFieldInstances : List RecordInfo -> List Decl
recordHasFieldInstances [] = []
recordHasFieldInstances (r :: rest) =
  append (recordHasFieldInstancesOf r) (recordHasFieldInstances rest)

recordHasFieldInstancesOf : RecordInfo -> List Decl
recordHasFieldInstancesOf (RecordInfo rname params fields derivings derivingVia ctor) =
  recordHasFieldInstancesGo rname params ctor (length fields) fields 0

recordHasFieldInstancesGo : String -> List String -> String -> Int -> List (Pair String Expr) -> Int -> List Decl
recordHasFieldInstancesGo rname params ctor n [] i = []
recordHasFieldInstancesGo rname params ctor n ((Pair fname fty) :: rest) i =
  hasFieldInstanceDecl rname params ctor n i fname fty
    :: recordHasFieldInstancesGo rname params ctor n rest (i + 1)

recordInstanceVar : Int -> String
recordInstanceVar i = "@vuna@record@hf${i}"

recordInstancePats : Int -> Span -> List Pat
recordInstancePats n sp = recordInstancePatsFrom 0 n sp

recordInstancePatsFrom : Int -> Int -> Span -> List Pat
recordInstancePatsFrom i remaining sp =
  if remaining <= 0 then []
  else PVar (recordInstanceVar i) sp :: recordInstancePatsFrom (i + 1) (remaining - 1) sp

hasFieldInstanceDecl : String -> List String -> String -> Int -> Int -> String -> Expr -> Decl
hasFieldInstanceDecl rname params ctor n fi fname fty =
  let
    fsp = exprSpan fty
    recType = case params of
      [] => EVar rname fsp
      _ => EApp (EVar rname fsp) (map (\p => EVar p fsp) params) fsp
    label = EApp (EVar "Base.Field.Field" fsp) [EStr fname fsp] fsp
    head = EApp (EVar "Base.Record.HasField" fsp) [label, recType, fty] fsp
    pats = recordInstancePats n fsp
    body = ECase (EVar "p" fsp) [Pair (PCon ctor pats fsp) (EVar (recordInstanceVar fi) fsp)] fsp
    meth = DFun "getField" [PVar "p" fsp] body fsp
  in DInstance [] head [meth] fsp

-- DT 的一步式入口：抽取 record 信息并完成全部降级。
-- `Elab.elabProgramFull` 只需 `Vuna.Compiler.Common.bind (prepareDecls decls) elabProgramGo`。
prepareDecls : List Decl -> Result (List Decl)
prepareDecls decls0 = prepareDeclsWith [] decls0

-- M34.5 接口摘要路径：本包的 record 降级需要**依赖包 record 头**参与字段访问/record 更新/
-- 模式降级的消解（依赖包只提供语法头，不精化）；auxDecls 是依赖模块的原始 decls。
prepareDeclsWith : List Decl -> List Decl -> Result (List Decl)
prepareDeclsWith auxDecls decls0 =
  let
    auxSplit = recordsOfDecls ctorName auxDecls
    split = recordsOfDecls ctorName decls0
    records = append (firstOf auxSplit) (firstOf split)
    decls = secondOf split
  in desugarRecords records decls

-- 记录的构造子名：记录名本身。
-- M23：旧实现用 `Mk<R>` 前缀，避免「类型名与构造子同名」被当成「把类型当函数应用」。
-- 现在 Elab 在值位置先查构造子表、类型位置走 globals（`checkType` / `checkAppUnderType`），
-- 同名不再冲突（`data Pair where Pair : ...` 的写法本身也被支持），所以恢复同名——
-- 派生 `Show` 才能输出 `(Point 1 2)` 而不是泄漏内部名 `(MkPoint 1 2)`。
ctorName : String -> String
ctorName dname = dname

desugarAlt : List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarAlt a1 a2 = desugarAltFuel 512 a1 a2

desugarBind : List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarBind a1 a2 = desugarBindFuel 512 a1 a2

desugarFieldValue : List RecordInfo -> Pair String Expr -> Result (Pair String Expr)
desugarFieldValue a1 a2 = desugarFieldValueFuel 512 a1 a2

desugarRecordValues : List RecordInfo -> List (Pair String Expr) -> List (Pair String Expr) -> Span -> Result (List Expr)
desugarRecordValues a1 a2 a3 a4 = desugarRecordValuesFuel 512 a1 a2 a3 a4

desugarDoStmt : List RecordInfo -> DoStmt -> Result DoStmt
desugarDoStmt a1 a2 = desugarDoStmtFuel 512 a1 a2

desugarExpr : List RecordInfo -> Expr -> Result Expr
desugarExpr a1 a2 = desugarExprFuel 512 a1 a2

-- case 分支左端的 as-pattern（`y@pat => body`）：等价于 `pat => let y = <scrutinee> in body`。
-- 纯语言里 scrutinee 可重复求值；常见形态（scrutinee 是变量）无额外开销。
expandCaseAs : Expr -> Pair Pat Expr -> Pair Pat Expr
expandCaseAs scrut (Pair pat body) = expandCaseAsGo scrut pat body

expandCaseAsGo : Expr -> Pat -> Expr -> Pair Pat Expr
expandCaseAsGo scrut (PAs n inner psp) body =
  expandCaseAsGo scrut inner (ELet [Pair (PVar n psp) scrut] body False psp)
expandCaseAsGo scrut pat body = Pair pat body
