module Vuna.Compiler.Elab.Records
  ( RecordFieldMeta(..)
  , RecordMeta(..)
  , desugarRecords
  , duplicateFieldMsg
  , fieldNamesOf
  , firstUnknownFieldMsg
  , hasDuplicateFieldNames
  , lookupProvided
  , lookupRecord
  , missingFieldMsg
  , prepareDecls
  , prepareDeclsWith
  , recordDeclToData
  , recordFieldPairs
  , recordHasFieldInstances
  , recordsOfDecls
  , unknownFieldMsg
  ) where

-- Vuna.Compiler.Elab.Records：`record` 的**语法降级**（M19 提取成共享模块）。
--
-- R2（records-v2）：字段名不再是构造子 binder 名里编码的字符串，而是下面
-- `RecordFieldMeta` 的（名字 / 类型 / 声明序号）三元组；`RecordMeta` 是跨包的
-- 结构化字段表，进 iface（`miRecords`）。降级本身仍是 AST → AST，不依赖检查器状态。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast

-- | R2：一条 record 字段的结构化元数据。`recordFieldIndex` 是声明序号（也是降级后
-- 构造子里的位置参数序号）；`recordFieldType` 仍带源码 span，供 `HasField` 实例生成。
record RecordFieldMeta where
  recordFieldName : String
  recordFieldType : Expr
  recordFieldIndex : Int

-- | R2：一条 record 声明的结构化元数据（名字 / 参数 / 字段表 / 派生 / 表示档位 / 构造子 /
-- 线性标记）。进 iface 后工具与下游包按字段表查表，不再依赖前缀约定或重跑源码解析。
record RecordMeta where
  recordMetaName : String
  recordMetaParams : List String
  recordMetaFields : List RecordFieldMeta
  recordMetaDerivings : List String
  recordMetaDerivingVia : Bool
  -- R1：表示档位（`transparent`/`opaque` 声明；`ReprAuto` = 未声明）。
  recordMetaRepr : ReprTier
  recordMetaCtor : String
  recordMetaLinear : Bool

-- | R2：字段表 → （名字，类型）对（只用于仍需该形状的旧 helper）。
recordFieldPairs : List RecordFieldMeta -> List (Pair String Expr)
recordFieldPairs [] = []
recordFieldPairs (f :: rest) = Pair f.recordFieldName f.recordFieldType :: recordFieldPairs rest

-- | R2：字段表 → 字段名列表。
recordFieldNames : List RecordFieldMeta -> List String
recordFieldNames [] = []
recordFieldNames (f :: rest) = f.recordFieldName :: recordFieldNames rest

-- | R2：按名字查 record 元数据。
lookupRecord : String -> List RecordMeta -> Maybe RecordMeta
lookupRecord name [] = Nothing
lookupRecord name (r :: rest) = if r.recordMetaName == name then Just r else lookupRecord name rest

fieldNamesOf : List (Pair a b) -> List a
fieldNamesOf [] = []
fieldNamesOf ((Pair n t) :: rest) = n :: fieldNamesOf rest

lookupProvided : String -> List (Pair String a) -> Maybe a
lookupProvided fname [] = Nothing
lookupProvided fname ((Pair n e) :: rest) = if n == fname then Just e else lookupProvided fname rest

hasDuplicateFieldNames : List (Pair String a) -> Bool
hasDuplicateFieldNames [] = False
hasDuplicateFieldNames ((Pair n e) :: rest) = case lookupProvided n rest of
  Just _ => True
  Nothing => hasDuplicateFieldNames rest

missingFieldMsg : Span -> String -> Diagnostic
missingFieldMsg sp fname = diagAt sp SevError PhElab CatRecords "" "missing field ${fname}"

unknownFieldMsg : Span -> String -> Diagnostic
unknownFieldMsg sp fname = diagAt sp SevError PhElab CatRecords "" "unknown field ${fname}"

duplicateFieldMsg : Span -> Diagnostic
duplicateFieldMsg sp = diagAt sp SevError PhElab CatRecords "" "duplicate field"

hasUnknownFields : List String -> List (Pair String a) -> Bool
hasUnknownFields fieldNames [] = False
hasUnknownFields fieldNames ((Pair n v) :: rest) =
  if memName n fieldNames then hasUnknownFields fieldNames rest else True

firstUnknownFieldMsg : Span -> List String -> List (Pair String a) -> Diagnostic
firstUnknownFieldMsg sp fieldNames [] = unknownFieldMsg sp ""
firstUnknownFieldMsg sp fieldNames ((Pair n v) :: rest) =
  if memName n fieldNames then firstUnknownFieldMsg sp fieldNames rest else unknownFieldMsg sp n

-- 记录声明抽取：DRecord 记住 RecordMeta，并降级成单构造器 DData。
recordsOfDecls : (String -> String) -> List Decl -> Pair (List RecordMeta) (List Decl)
recordsOfDecls ctorOf [] = Pair [] []
recordsOfDecls ctorOf (d :: rest) = case recordsOfDecls ctorOf rest of
  Pair recs ds => case d of
    DRecord dname params fields derivings viaField repr lin sp =>
      let
        meta =
          RecordMeta dname params (recordFieldsOf fields 0) derivings viaField repr (ctorOf dname)
            lin
      in Pair (meta :: recs) (recordDeclToData d (ctorOf dname) repr :: ds)
    _ => Pair recs (d :: ds)

-- | R2：给字段表标注声明序号（字段名/类型的唯一真源）。
recordFieldsOf : List Field -> Int -> List RecordFieldMeta
recordFieldsOf [] i = []
recordFieldsOf (f :: rest) i =
  RecordFieldMeta (fieldName f) (fieldType f) i :: recordFieldsOf rest (i + 1)

-- 记录的构造子名：`Mk<R>`。
-- 记录声明降级：单构造子 DData。构造子名由 `ctor` 参数给出（见上面的策略说明）。
recordParamVarExprs : List String -> Span -> List Expr
recordParamVarExprs params sp = map (\p => EVar p sp) params

recordRetType : String -> List String -> Span -> Expr
recordRetType dname params sp = EApp (EVar dname sp) (recordParamVarExprs params sp) sp

-- 构造子类型用一等的 `EPi` 表示（不是 `EVar "->"` 的语法编码）：这是记录降级的
-- **输出**，交给下游检查器，不应当依赖某个检查器对箭头语法的特殊处理。
-- R2：binder 名只带**位置**信息（`@vuna@record@arg<i>`），不再编码字段名——字段身份
-- 由 `RecordMeta` / `DtData.dtDataFields` 的结构化字段表承载。
recordArrowType : List Field -> Expr -> Span -> Expr
recordArrowType fields ret sp = recordArrowTypeGo 0 fields ret sp

recordArrowTypeGo : Int -> List Field -> Expr -> Span -> Expr
recordArrowTypeGo i [] ret sp = ret
recordArrowTypeGo i (f :: fs) ret sp =
  EPi "@vuna@record@arg${i}" False Nothing (fieldType f) (recordArrowTypeGo (i + 1) fs ret sp) sp

-- 记录构造子类型显式带族参数（`elabCtor` 用首 binder 名判断，字段 binder 已不是 `_`）。
-- | 把记录族参数包成显式 Pi（implicit=True），供构造子类型使用。
recordParamPis : List String -> Expr -> Span -> Expr
recordParamPis [] ret sp = ret
recordParamPis (p :: rest) ret sp =
  EPi p True Nothing (EVar "Type" sp) (recordParamPis rest ret sp) sp

-- | 组装记录构造子的完整类型：族参数 Pi + 字段箭头 + 返回记录类型。
recordCtorType : List String -> List Field -> Expr -> Span -> Expr
recordCtorType params fields ret sp = recordParamPis params (recordArrowType fields ret sp) sp

recordDeclToData : Decl -> String -> ReprTier -> Decl
recordDeclToData (DRecord dname params fields derivings viaField repr lin sp) ctor tier =
  DData dname params (EVar "Type" sp)
    [Ctor ctor (recordCtorType params fields (recordRetType dname params sp) sp) (length fields) sp]
    derivings viaField tier lin sp
-- M23：DT 要求函数 clause 覆盖所有构造子（非 record 声明原样返回）。
recordDeclToData d ctor tier = d

-- 记录语法降级：构造 → 构造器应用；记录模式 → 构造器模式（按声明顺序补 PWild）。
desugarRecords : List RecordMeta -> List Decl -> Check (List Decl)
desugarRecords records decls = Vuna.Compiler.Common.traverse (desugarRecordDecl records) decls

desugarRecordDecl : List RecordMeta -> Decl -> Check Decl
desugarRecordDecl records d = case d of
  DFun name pats body sp =>
    Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (desugarPattern records) pats)
      (\pats2 => Vuna.Compiler.Common.bind (desugarExpr records body) (\body2 => OkC (DFun name pats2 body2 sp)))
  DData name params kind ctors derivings viaField repr lin sp => OkC d
  DRecord name params fields derivings viaField repr lin sp => OkC d
  DTrait name params methods sp => OkC d
  DInstance ctxE head methods sp =>
    Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (desugarRecordDecl records) methods)
      (\ms => OkC (DInstance ctxE head ms sp))
  DSig name ctx ty sp => OkC d
  -- M28：axiom 的类型表达式里可能有 record 语法吗？类型位置不走 record 降级
  -- （record 是值层记法），原样返回。
  DAxiom name ty sp => OkC d
  DExtern name cName ty sp => OkC d

desugarPattern : List RecordMeta -> Pat -> Check Pat
desugarPattern records pat = desugarPatternFuel 64 records pat

desugarPatternFuel : Int -> List RecordMeta -> Pat -> Check Pat
desugarPatternFuel fuel records pat = if fuel <= 0 then OkC pat
else case pat of
  PWild sp => OkC (PWild sp)
  PVar n sp => OkC (PVar n sp)
  PAs n inner sp =>
    Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records inner) (\p => OkC (PAs n p sp))
  PInt n sp => OkC (PInt n sp)
  PStr s sp => OkC (PStr s sp)
  PCon name pats sp =>
    Vuna.Compiler.Common.bind
      (Vuna.Compiler.Common.traverse (\x => desugarPatternFuel (fuel - 1) records x) pats)
      (\ps => OkC (PCon name ps sp))
  PRecord name fields sp => case lookupRecord name records of
    Nothing => err "${showSpanLoc sp}: unknown record: ${name}"
    Just r =>
      if hasDuplicateFieldNames fields then ErrC (duplicateFieldMsg sp)
      else if hasUnknownFields (recordFieldNames r.recordMetaFields) fields then ErrC (firstUnknownFieldMsg sp (recordFieldNames r.recordMetaFields) fields)
      else Vuna.Compiler.Common.bind
        (desugarRecordPatternFieldsFuel (fuel - 1) records r.recordMetaFields fields sp)
        (\ps => OkC (PCon r.recordMetaCtor ps sp))

desugarRecordPatternFieldsFuel : Int -> List RecordMeta -> List RecordFieldMeta -> List (Pair String Pat) -> Span -> Check (List Pat)
desugarRecordPatternFieldsFuel fuel records fdefs provided sp = if fuel <= 0 then OkC []
else case fdefs of
  [] => OkC []
  f :: rest => case lookupProvided f.recordFieldName provided of
    Nothing =>
      Vuna.Compiler.Common.bind (desugarRecordPatternFieldsFuel (fuel - 1) records rest provided sp)
        (\ps => OkC (PWild sp :: ps))
    Just p =>
      Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records p)
        (\p2 => Vuna.Compiler.Common.bind (desugarRecordPatternFieldsFuel (fuel - 1) records rest provided sp) (\ps => OkC (p2 :: ps)))

desugarExprFuel : Int -> List RecordMeta -> Expr -> Check Expr
desugarExprFuel fuel records e = if fuel <= 0 then err "DT: internal: record desugar fuel exhausted"
else case e of
  EVar n sp => OkC e
  EInt n sp => OkC e
  EStr s sp => OkC e
  EFloat raw sp => OkC e
  ELam ps b sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records b) (\b2 => OkC (ELam ps b2 sp))
  EApp f args sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records f)
      (\f2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (desugarExprFuel (fuel - 1) records) args) (\a2 => OkC (EApp f2 a2 sp)))
  ELet binds body rec_ sp =>
    Vuna.Compiler.Common.bind
      (Vuna.Compiler.Common.traverse (desugarBindFuel (fuel - 1) records) binds)
      (\b2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records body) (\body2 => OkC (ELet b2 body2 rec_ sp)))
  -- A2：where/let 多 clause 局部函数：逐 clause 消解记录模式与 body。
  ELocalFun clauses sp =>
    Vuna.Compiler.Common.bind
      (Vuna.Compiler.Common.traverse (desugarLocalClauseFuel (fuel - 1) records) clauses)
      (\c2 => OkC (ELocalFun c2 sp))
  ECase scrut alts sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records scrut)
      (\s2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (desugarAltFuel (fuel - 1) records) alts) (\a2 => OkC (ECase s2 (map (expandCaseAs s2) a2) sp)))
  EIf c t el sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records c)
      (\c2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records t) (\t2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records el) (\e2 => OkC (EIf c2 t2 e2 sp))))
  -- 字段访问/更新的消歧需要 base 的类型，留给精化期按结构化字段表查表。
  EField base fname sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records base)
      (\b => OkC (EField b fname sp))
  ERecord name fields sp => case lookupRecord name records of
    Nothing => err "${showSpanLoc sp}: unknown record: ${name}"
    Just r =>
      if hasDuplicateFieldNames fields then ErrC (duplicateFieldMsg sp)
      else if hasUnknownFields (recordFieldNames r.recordMetaFields) fields then ErrC (firstUnknownFieldMsg sp (recordFieldNames r.recordMetaFields) fields)
      else Vuna.Compiler.Common.bind
        (desugarRecordValuesFuel (fuel - 1) records r.recordMetaFields fields sp)
        (\vs => OkC (EApp (EVar r.recordMetaCtor sp) vs sp))
  ERecUpdate base fields sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records base)
      (\b => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (desugarFieldValueFuel (fuel - 1) records) fields) (\fs => OkC (ERecUpdate b fs sp)))
  EDo stmts sp =>
    Vuna.Compiler.Common.bind
      (Vuna.Compiler.Common.traverse (desugarDoStmtFuel (fuel - 1) records) stmts)
      (\s2 => OkC (EDo s2 sp))
  -- EPi 的可用性由各自的检查器判定（HM 报错、DT 支持），降级这里只做结构递归。
  EPi name implicit qty dom cod sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records dom)
      (\d2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records cod) (\c2 => OkC (EPi name implicit qty d2 c2 sp)))
  -- M24：where 绑定签名（`EAnn value ty`）两边都做结构递归（record 可出现在值里）。
  EAnn value ty sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records value)
      (\v2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records ty) (\t2 => OkC (EAnn v2 t2 sp)))
  _ => err "DT: internal: unreordered infix/paren in elaboration"

desugarDoStmtFuel : Int -> List RecordMeta -> DoStmt -> Check DoStmt
desugarDoStmtFuel fuel records stmt = if fuel <= 0 then err "DT: internal: record desugar fuel exhausted"
else case stmt of
  DBind p e sp =>
    Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records p)
      (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records e) (\e2 => OkC (DBind p2 e2 sp)))
  DExpr e sp =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records e) (\e2 => OkC (DExpr e2 sp))

desugarRecordValuesFuel : Int -> List RecordMeta -> List RecordFieldMeta -> List (Pair String Expr) -> Span -> Check (List Expr)
desugarRecordValuesFuel fuel records [] provided sp =
  if fuel <= 0 then err "DT: internal: record desugar fuel exhausted" else OkC []
desugarRecordValuesFuel fuel records (f :: rest) provided sp = if fuel <= 0 then err "DT: internal: record desugar fuel exhausted"
else case lookupProvided f.recordFieldName provided of
  Nothing => ErrC (missingFieldMsg sp f.recordFieldName)
  Just v =>
    Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records v)
      (\v2 => Vuna.Compiler.Common.bind (desugarRecordValuesFuel (fuel - 1) records rest provided sp) (\vs => OkC (v2 :: vs)))

desugarFieldValueFuel : Int -> List RecordMeta -> Pair String Expr -> Check (Pair String Expr)
desugarFieldValueFuel fuel records (Pair fname v) =
  if fuel <= 0 then err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records v) (\v2 => OkC (Pair fname v2))

desugarBindFuel : Int -> List RecordMeta -> Pair Pat Expr -> Check (Pair Pat Expr)
desugarBindFuel fuel records (Pair pat value) =
  if fuel <= 0 then err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records pat)
    (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records value) (\v2 => OkC (Pair p2 v2)))

-- A2：局部函数 clause（参数模式列表 + body）。
desugarLocalClauseFuel : Int -> List RecordMeta -> Pair (List Pat) Expr -> Check (Pair (List Pat) Expr)
desugarLocalClauseFuel fuel records clause =
  if fuel <= 0 then err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind
    (Vuna.Compiler.Common.traverse (desugarPatternFuel (fuel - 1) records) (firstOf clause))
    (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records (secondOf clause)) (\b2 => OkC (Pair p2 b2)))

desugarAltFuel : Int -> List RecordMeta -> Pair Pat Expr -> Check (Pair Pat Expr)
desugarAltFuel fuel records (Pair pat body) =
  if fuel <= 0 then err "DT: internal: record desugar fuel exhausted"
  else Vuna.Compiler.Common.bind (desugarPatternFuel (fuel - 1) records pat)
    (\p2 => Vuna.Compiler.Common.bind (desugarExprFuel (fuel - 1) records body) (\b2 => OkC (Pair p2 b2)))

-- HasField 实例：为当前模块的 record 字段生成 `instance HasField (Field "f") R T`。
-- | 为一批记录的每个字段生成 `HasField` 实例声明。
recordHasFieldInstances : List RecordMeta -> List Decl
recordHasFieldInstances [] = []
recordHasFieldInstances (r :: rest) =
  append (recordHasFieldInstancesOf r) (recordHasFieldInstances rest)

-- | 为单个记录的所有字段生成 `HasField` 实例声明。
recordHasFieldInstancesOf : RecordMeta -> List Decl
recordHasFieldInstancesOf r =
  recordHasFieldInstancesGo r.recordMetaName r.recordMetaParams r.recordMetaCtor
    (length r.recordMetaFields) (recordFieldPairs r.recordMetaFields) 0

-- | 逐字段生成 `HasField` 实例的递归辅助（带字段下标）。
recordHasFieldInstancesGo : String -> List String -> String -> Int -> List (Pair String Expr) -> Int -> List Decl
recordHasFieldInstancesGo rname params ctor n [] i = []
recordHasFieldInstancesGo rname params ctor n ((Pair fname fty) :: rest) i =
  hasFieldInstanceDecl rname params ctor n i fname fty
    :: recordHasFieldInstancesGo rname params ctor n rest (i + 1)

-- | `HasField` 实例模式里第 i 个字段绑定变量的名字。
recordInstanceVar : Int -> String
recordInstanceVar i = "@vuna@record@hf${i}"

-- | 生成 n 个字段绑定模式（变量名由 recordInstanceVar 给出）。
recordInstancePats : Int -> Span -> List Pat
recordInstancePats n sp = recordInstancePatsFrom 0 n sp

-- | recordInstancePats 的递归实现：从下标 i 开始生成剩余 remaining 个模式。
recordInstancePatsFrom : Int -> Int -> Span -> List Pat
recordInstancePatsFrom i remaining sp =
  if remaining <= 0 then []
  else PVar (recordInstanceVar i) sp :: recordInstancePatsFrom (i + 1) (remaining - 1) sp

-- | 构造单条 `instance HasField (Field "f") R T` 声明：模式绑定第 fi 个字段并返回它。
hasFieldInstanceDecl : String -> List String -> String -> Int -> Int -> String -> Expr -> Decl
hasFieldInstanceDecl rname params ctor n fi fname fty =
  let
    fsp = exprSpan fty
    recType = case params of
      [] => EVar rname fsp
      _ => EApp (EVar rname fsp) (map (\p => EVar p fsp) params) fsp
    label = EApp (EVar "Base.Field.Field" fsp) [EStr fname fsp] fsp
    head = EApp (EVar "Base.Record.HasField" fsp) [label, recType, fty] fsp
    pats = recordInstancePats n fsp
    body = ECase (EVar "p" fsp) [Pair (PCon ctor pats fsp) (EVar (recordInstanceVar fi) fsp)] fsp
    meth = DFun "getField" [PVar "p" fsp] body fsp
  in DInstance [] head [meth] fsp

-- DT 的一步式入口：抽取 record 信息并完成全部降级。
-- R2：同时返回本包/依赖包的 `RecordMeta` 表，供 `elabDatas` 把字段表写进 `DtData`。
prepareDecls : List Decl -> Check (Pair (List RecordMeta) (List Decl))
prepareDecls decls0 = prepareDeclsWith [] decls0

-- M34.5 接口摘要路径：本包的 record 降级需要**依赖包 record 头**参与字段访问/record 更新/
-- 模式降级的消解（依赖包只提供语法头，不精化）；auxDecls 是依赖模块的原始 decls。
prepareDeclsWith : List Decl -> List Decl -> Check (Pair (List RecordMeta) (List Decl))
prepareDeclsWith auxDecls decls0 =
  let
    auxSplit = recordsOfDecls ctorName auxDecls
    split = recordsOfDecls ctorName decls0
    records = append (firstOf auxSplit) (firstOf split)
    decls = secondOf split
  in Vuna.Compiler.Common.bind (desugarRecords records decls) (\ds => OkC (Pair records ds))

-- 记录的构造子名：记录名本身。
-- M23：旧实现用 `Mk<R>` 前缀，避免「类型名与构造子同名」被当成「把类型当函数应用」。
-- 现在 Elab 在值位置先查构造子表、类型位置走 globals（`checkType` / `checkAppUnderType`），
-- 同名不再冲突（`data Pair where Pair : ...` 的写法本身也被支持），所以恢复同名——
-- 派生 `Show` 才能输出 `(Point 1 2)` 而不是泄漏内部名 `(MkPoint 1 2)`。
ctorName : String -> String
ctorName dname = dname

desugarExpr : List RecordMeta -> Expr -> Check Expr
desugarExpr a1 a2 = desugarExprFuel 512 a1 a2

-- case 分支左端的 as-pattern（`y@pat => body`）：等价于 `pat => let y = <scrutinee> in body`。
-- 纯语言里 scrutinee 可重复求值；常见形态（scrutinee 是变量）无额外开销。
expandCaseAs : Expr -> Pair Pat Expr -> Pair Pat Expr
expandCaseAs scrut (Pair pat body) = expandCaseAsGo scrut pat body

expandCaseAsGo : Expr -> Pat -> Expr -> Pair Pat Expr
expandCaseAsGo scrut (PAs n inner psp) body =
  expandCaseAsGo scrut inner (ELet [Pair (PVar n psp) scrut] body False psp)
expandCaseAsGo scrut pat body = Pair pat body
