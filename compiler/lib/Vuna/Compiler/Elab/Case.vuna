module Vuna.Compiler.Elab.Case
  ( BranchVerdict(..)
  , allCtorsUnsatisfiable
  , allCtorsUnsatisfiableGo
  , altNames
  , anyNestedArg
  , anyNestedPat
  , bindCtorTele
  , branchAfterUnify
  , branchIsReachable
  , branchReachable
  , branchVerdict
  , checkCaseAltsFlat
  , checkCaseDone
  , checkCoverage
  , checkCovered
  , ctorExplicitArity
  , ctorResultTerms
  , ctorResultVals
  , ctorResultValsIn
  , ctorValueIn
  , ctxHasEmptyBinder
  , ctxHasEmptyBinderAt
  , hasCatchAll
  , hasDupNames
  , isEmptyFamilyValue
  , isRigidVal
  , nestedInPat
  , occursLevel
  , occursLevelList
  , patIrrefutable
  , patsAllIrrefutable
  , reflectScrutinee
  , rigidIdxVals
  , teleValsFrom
  , unifyErr
  , unifyIdx
  , unifyIdxConv
  , unifyIdxList
  , unifyIdxListSized
  , unifyIdxRigid
  , wildArgs
  ) where

-- Vuna.Compiler.Elab.Case：case 精化的**基础设施**：索引合一（unifyIdx）、构造子结果值（scrutinee 反射）、
-- 模式 telescope 绑定（bindCtorTele）、分支可达性（BranchVerdict + allCtorsUnsatisfiable）、
-- 覆盖率、以及 case 分支的源级校验（兜底位置 / 重复构造子 / 重复字面量）。
-- case 的检查规则本身与 `checkE` 互递归，留在 `Elab.Term`。
-- 拆自 M24 的单一 `Elab.vuna`（按真实调用图切；门面仍是 `Vuna.Compiler.Elab`）。
--
-- M28（B08）：分支可达性只有**一个**判据 —— `BranchVerdict`。省略一个分支（覆盖率）
-- 与写出一个分支（elabConAlt）都跑同一套「索引合一 + 上下文空族」判定；上下文空族又
-- 统一落到 `allCtorsUnsatisfiable`（`isEmptyFamilyValue` 的唯一实现）。三条精化路径
-- （直接 / 去重降级 / 嵌套模式折叠）也收敛成「先降级成模式矩阵，或直接走规范形」。
import Base.List
import Vuna.Compiler.Common
import Vuna.Compiler.Core
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Diagnostics.Warning
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Intrinsics

-- ---------------------------------------------------------------
-- M14：索引合一（unifyIdx）
-- ---------------------------------------------------------------
-- 只做索引层面的一阶合一：把 case 分支构造子的结果索引与 scrutinee 的索引对齐。
-- 可合一 ⇒ 产出精化表（level ↦ Value），分支体内所有类型求值都带上它；
-- 不可合一 ⇒ 该分支不可达：省略即合法（覆盖率跳过），写出即报错。
-- 方向约定：优先精化 **level 更大**（更内层）的变量，于是 ctor 一侧的新鲜变量精化成
-- scrutinee 的真实变量（`m ↦ n`），不会把真实变量解到分支作用域外（level 形态，无需 de Bruijn）。
-- | 自动补注（M41 新增导出）：unifyErr。
unifyErr : Check a
unifyErr = ErrC (tcMsg ImpossibleBranchIndex [])

unifyIdxList : Ec -> List (Pair Int Value) -> Int -> Int -> List Value -> List Value -> Check (List (Pair Int Value))
unifyIdxList ec acc depth fuel xs ys =
  if fuel <= 0 then unifyErr else unifyIdxListGo ec acc depth fuel xs ys

unifyIdxListGo : Ec -> List (Pair Int Value) -> Int -> Int -> List Value -> List Value -> Check (List (Pair Int Value))
unifyIdxListGo ec acc depth fuel [] [] = OkC acc
unifyIdxListGo ec acc depth fuel (x :: xs) (y :: ys) =
  Vuna.Compiler.Common.bind (unifyIdx ec acc depth (fuel - 1) x y)
    (\acc2 => unifyIdxList ec acc2 depth (fuel - 1) xs ys)
unifyIdxListGo ec acc depth fuel _ _ = unifyErr

-- ---------------------------------------------------------------
-- D24：索引合一入口的 fuel 派生
-- ---------------------------------------------------------------
-- Vec 字面量把长度索引展开成 `Succ` 链；入口固定 512 对 ≥64 层的索引不够（逐层
-- unifyIdx 大约消耗 4 步）。入口按两侧值里的 Nat 链前缀深度派生燃料（上限 `idxFuelMax`
-- 防失控输入）。**只动入口**：递归路径仍按递减 fuel 走，`unifyIdxList` 的 SCT 终止性
-- 证明不受影响。
unifyIdxListSized : Ec -> List (Pair Int Value) -> Int -> List Value -> List Value -> Check (List (Pair Int Value))
unifyIdxListSized ec acc depth xs ys = unifyIdxList ec acc depth (idxFuelFor xs ys) xs ys

idxFuelFor : List Value -> List Value -> Int
idxFuelFor xs ys =
  let
    need = 512 + 4 * (idxNatDepthOfList xs + idxNatDepthOfList ys)
  in if need > idxFuelMax then idxFuelMax else need

idxFuelMax : Int
idxFuelMax = 1000000

idxNatDepthOfList : List Value -> Int
idxNatDepthOfList [] = 0
idxNatDepthOfList (v :: rest) =
  let
    d = idxNatDepthNear v
    r = idxNatDepthOfList rest
  in if d >= r then d else r

-- 浅探：根值或直接参数 / 脊实参里的 Nat 链前缀深度（失败形态是 `Vec (Succ^k Zero) a`，
-- 索引链在直接参数里）。
idxNatDepthNear : Value -> Int
idxNatDepthNear v = if idxIsNatHead v then idxNatPrefixDepth v
else case v of
  VCon c args => idxNatDepthOfList args
  VNeutral n => case n of
    NGlobal g sp => idxNatDepthOfList sp
    NVar name lvl sp => idxNatDepthOfList sp
  VApp f a => if idxIsNatHead a then idxNatPrefixDepth a else 0
  _ => 0

idxIsNatHead : Value -> Bool
idxIsNatHead (VCon c _) = idxIsNatCtor c
idxIsNatHead (VNeutral n) = case n of
  NGlobal c _ => idxIsNatCtor c
  _ => False
idxIsNatHead (VApp f a) = idxIsNatHead f
idxIsNatHead _ = False

idxIsNatCtor : String -> Bool
idxIsNatCtor c = c == natZeroCtor || c == natSuccCtor

-- Nat 链前缀深度 = 前导 `Succ` 层数（不要求以 `Zero` 收尾）。
idxNatPrefixDepth : Value -> Int
idxNatPrefixDepth v = idxNatPrefixGo 100000 v

idxNatPrefixGo : Int -> Value -> Int
idxNatPrefixGo fuel v = if fuel <= 0 then 100000
else case v of
  VCon c args => if c == natSuccCtor then case args of
    [a] => 1 + idxNatPrefixGo (fuel - 1) a
    _ => 0
  else 0
  VNeutral n => case n of
    NGlobal c sp => if c == natSuccCtor then case sp of
      [a] => 1 + idxNatPrefixGo (fuel - 1) a
      _ => 0
    else 0
    _ => 0
  VApp f a => if idxIsNatSuccHead f then 1 + idxNatPrefixGo (fuel - 1) a else 0
  _ => 0

idxIsNatSuccHead : Value -> Bool
idxIsNatSuccHead (VCon c _) = c == natSuccCtor
idxIsNatSuccHead (VNeutral n) = case n of
  NGlobal c _ => c == natSuccCtor
  _ => False
idxIsNatSuccHead _ = False

-- | 自动补注（M41 新增导出）：unifyIdx。
unifyIdx : Ec -> List (Pair Int Value) -> Int -> Int -> Value -> Value -> Check (List (Pair Int Value))
unifyIdx ec acc depth fuel a b = if fuel <= 0 then ErrC (tcMsg IndexFuel [])
else
  let
    a2 = force (ecDefTbl ec) (ecSolsP ec) defaultFuel (refineValue acc defaultFuel a)
    b2 = force (ecDefTbl ec) (ecSolsP ec) defaultFuel (refineValue acc defaultFuel b)
  in case a2 of
    VNeutral (NVar an al []) => case b2 of
      VNeutral (NVar bn bl []) =>
        if al == bl then OkC acc
        else if al < bl then if occursLevel occursFuel depth bl a2 then unifyErr
        else OkC (Base.List.Cons (Pair bl a2) acc)
        else if occursLevel occursFuel depth al b2 then unifyErr
        else OkC (Base.List.Cons (Pair al b2) acc)
      _ =>
        if occursLevel occursFuel depth al b2 then unifyErr
        else OkC (Base.List.Cons (Pair al b2) acc)
    _ => case b2 of
      VNeutral (NVar bn bl []) =>
        if occursLevel occursFuel depth bl a2 then unifyErr
        else OkC (Base.List.Cons (Pair bl a2) acc)
      _ => unifyIdxRigid ec acc depth (fuel - 1) a2 b2

-- occurs check：精化成自己会导致无限链。
-- `depth` 是当前上下文深度：Pi/Lam 的闭包必须用**新鲜变量**实例化后扫描，不能扫
-- `Closure.env`——env 里恰好包含被合一分支的局部 ctx（例如 `Wrap (Int -> Int)` 的构造子
-- tele 变量被精化成捕获局部变量的 Pi），按 env 扫会把「引用了分支作用域内的变量」误判成
-- 「引用了 lvl」，于是索引合一失败、合法分支被报 `TC_ImpossibleBranchIndex`（B42）。
-- 实例化变量用 `_occurs` 这个名字 + 不与 `lvl` 相同的 level（见 occursFreshLevel）。
-- 扫描带 fuel：实例化闭包后递归不再沿值结构下降（SCT 无法证明终止），用递减 fuel 兜底；
-- true 才是真 occurs，fuel 耗尽的 False 只会因为值异常巨大而发生（实际扫描深度 = 值大小）。
occursLevel : Int -> Int -> Int -> Value -> Bool
occursLevel fuel depth lvl v = if fuel <= 0 then False
else case v of
  VNeutral n => case n of
    NVar name l sp => l == lvl || occursLevelList (fuel - 1) depth lvl sp
    NGlobal g sp => occursLevelList (fuel - 1) depth lvl sp
  VPi name implicit rig dom clo =>
    occursLevel (fuel - 1) depth lvl dom
      || occursLevel (fuel - 1) depth lvl (applyClosure clo (VNeutral (NVar "_occurs" (occursFreshLevel depth lvl) [])))
  VLam name rig clo =>
    occursLevel (fuel - 1) depth lvl
      (applyClosure clo (VNeutral (NVar "_occurs" (occursFreshLevel depth lvl) [])))
  VMeta m sp => occursLevelList (fuel - 1) depth lvl sp
  VCon c args => occursLevelList (fuel - 1) depth lvl args
  VApp f a => occursLevel (fuel - 1) depth lvl f || occursLevel (fuel - 1) depth lvl a
  VCase scrut alts => occursLevel (fuel - 1) depth lvl scrut
  VProj base c tele i fi => occursLevel (fuel - 1) depth lvl base
  VIf c th el =>
    occursLevel (fuel - 1) depth lvl c
      || occursLevel (fuel - 1) depth lvl th
      || occursLevel (fuel - 1) depth lvl el
  VType l => False
  VInt n => False
  VStr s => False
  VFloat raw => False
  VBool b => False

-- 实例化 Pi/Lam 用的新鲜变量 level：正常情况下就是 ctx depth（与更内层的 ctx 变量区分）；
-- 但 unify 的「新鲜 tele 变量」也从 depth 起编号，`lvl` 可能恰好等于 depth——那时用 depth
-- 会把新鲜变量自己当成 occurs（误判），退一格用 lvl + 1。
occursFreshLevel : Int -> Int -> Int
occursFreshLevel depth lvl = if depth == lvl then lvl + 1 else depth

occursLevelList : Int -> Int -> Int -> List Value -> Bool
occursLevelList fuel depth lvl [] = False
occursLevelList fuel depth lvl (v :: rest) =
  occursLevel (fuel - 1) depth lvl v || occursLevelList (fuel - 1) depth lvl rest

-- occurs 扫描的 fuel 余量：值可能很大（Nat 字面量索引展开成链），给足上限；真正的递归
-- 深度由值的大小决定，不会到满额。
occursFuel : Int
occursFuel = 1000000

-- 刚性位置：构造子/中性头按结构递归，其余回落到 conv 的相等性判定。
unifyIdxRigid : Ec -> List (Pair Int Value) -> Int -> Int -> Value -> Value -> Check (List (Pair Int Value))
unifyIdxRigid ec acc depth fuel a b = if fuel <= 0 then unifyErr
else case a of
  VCon c xs => case b of
    VCon c2 ys => if c == c2 then unifyIdxList ec acc depth (fuel - 1) xs ys else unifyErr
    _ => unifyErr
  VNeutral (NGlobal g sp) => case b of
    VNeutral (NGlobal g2 sp2) =>
      if g == g2 then unifyIdxList ec acc depth (fuel - 1) sp sp2 else unifyIdxConv ec acc depth a b
    _ => unifyIdxConv ec acc depth a b
  VType i => case b of
    VType j => if levelEq i j then OkC acc else unifyErr
    _ => unifyErr
  VInt n => case b of
    VInt m => if n == m then OkC acc else unifyErr
    _ => unifyErr
  VStr s => case b of
    VStr s2 => if s == s2 then OkC acc else unifyErr
    _ => unifyErr
  VFloat s => case b of
    VFloat s2 => if s == s2 then OkC acc else unifyErr
    _ => unifyErr
  VBool x => case b of
    VBool y => if x == y then OkC acc else unifyErr
    _ => unifyErr
  _ => unifyIdxConv ec acc depth a b

-- conv 回落：只判定相等（索引里的 meta 求解读 M15）。
unifyIdxConv : Ec -> List (Pair Int Value) -> Int -> Value -> Value -> Check (List (Pair Int Value))
unifyIdxConv ec acc depth a b = case conv (ecDefTbl ec) (ecSolsP ec) depth a b of
  OkC sols2 => OkC acc
  ErrC e => unifyErr

-- ---------------------------------------------------------------
-- M28：分支可达性 —— 唯一判据（省略/写出共用）
-- ---------------------------------------------------------------
-- 一个分支不可达只有两种来源，且都产自同一套计算：
--   ① 构造子结果索引与 scrutinee 索引一阶合一失败（`BranchImpossibleIndex`）；
--   ② 分支上下文里某个 binder 的类型是空归纳族（`BranchImpossibleEmptyCtx`）——
--      空族判定唯一实现是 `isEmptyFamilyValue` → `allCtorsUnsatisfiable`。
-- 覆盖率（省略分支）与 elabConAlt（写出分支）都问 `BranchVerdict`，因此不会再出现
-- 「写也错、省也错」：一个分支要么可达（两边都接受），要么不可达（写出报错、省略合法）。
data BranchVerdict : Type where
  BranchOk : BranchVerdict
  BranchImpossibleIndex : BranchVerdict
  BranchImpossibleEmptyCtx : BranchVerdict

branchIsReachable : BranchVerdict -> Bool
branchIsReachable BranchOk = True
branchIsReachable _ = False

-- 索引合一成功之后的判定：上下文空族（与覆盖率完全同一实现）。
branchAfterUnify : Ec -> Ctx -> List (Pair Int Value) -> BranchVerdict
branchAfterUnify ec branchCtx refs =
  if ctxHasEmptyBinder ec (ctxRefine branchCtx refs) then BranchImpossibleEmptyCtx else BranchOk

-- 覆盖率用它模拟一个**未写出**的构造子分支：绑哑通配（只借绑定与求值），不合成分支体。
branchVerdict : Ctx -> Ec -> List Value -> DtCtor -> BranchVerdict
branchVerdict ctx ec idxs ctor = case bindCtorTele ctx (dtCtorType ctor) (wildArgs (ctorExplicitArity (dtCtorType ctor))) of
  ErrC e => BranchOk
  OkC (Pair branchCtx (Pair binders leftover)) => if nonEmpty leftover then BranchOk
  else case unifyIdxListSized ec [] (ctxDepth branchCtx) (ctorResultValsIn branchCtx ctor) (map (\v => refineValue [] defaultFuel v) idxs) of
    ErrC e => BranchImpossibleIndex
    OkC refs => branchAfterUnify ec branchCtx refs

branchReachable : Ctx -> Ec -> List Value -> DtCtor -> Bool
branchReachable ctx ec idxs ctor = branchIsReachable (branchVerdict ctx ec idxs ctor)

wildArgs : Int -> List Pat
wildArgs n = if n <= 0 then [] else Base.List.Cons (PWild (Span "" 0 0 0 0)) (wildArgs (n - 1))

-- 构造子类型的显式 binder 个数 = case 分支要写的模式个数（隐式 binder 由 bindCtorTele 自理）。
ctorExplicitArity : Term -> Int
ctorExplicitArity (TPi n implicit rig dom cod) =
  if implicit then ctorExplicitArity cod else 1 + ctorExplicitArity cod
ctorExplicitArity _ = 0

-- 分支上下文里是否有 binder 的类型求值后是空归纳族。
ctxHasEmptyBinder : Ec -> Ctx -> Bool
ctxHasEmptyBinder ec ctx = ctxHasEmptyBinderAt ec ctx 0 ctx.ctxItems

ctxHasEmptyBinderAt : Ec -> Ctx -> Int -> List (Pair String Term) -> Bool
ctxHasEmptyBinderAt ec ctx idx [] = False
ctxHasEmptyBinderAt ec ctx idx ((Pair name ty) :: rest) =
  isEmptyFamilyValue ec (ctxDepth ctx) (varTypeValue ctx idx ty)
    || ctxHasEmptyBinderAt ec ctx (idx + 1) rest

-- 值是不是「空归纳族」：族已知，且**每个**构造子的结果索引都与这些索引合一失败
-- （`Fin Zero`、零构造子的族都算）。合一是本地试算、不提交，所以只会误判成「非空」（保守）。
isEmptyFamilyValue : Ec -> Int -> Value -> Bool
isEmptyFamilyValue ec depth v = case forceVal ec v of
  VNeutral n => case n of
    -- 只有**索引全刚性**时才敢判空：索引里出现中性项（`Fin (f Zero)`）时，「合一一律失败」
    -- 并不代表类型空（`f Zero` 也许能算到 `Succ k`，只是现在卡住）。这类情况保守判非空，
    -- 于是覆盖率仍要求写分支（宁可多要一个分支，不可放过真的非穷尽）。
    NGlobal g sp => if not (rigidIdxVals sp) then False
    else case dtDataLookup g (ecDatas ec) of
      Just dd => allCtorsUnsatisfiable ec dd sp depth
      Nothing => False
    _ => False
  _ => False

rigidIdxVals : List Value -> Bool
rigidIdxVals [] = True
rigidIdxVals (x :: rest) = isRigidVal x && rigidIdxVals rest

isRigidVal : Value -> Bool
isRigidVal (VCon c args) = rigidIdxVals args
isRigidVal (VType l) = True
isRigidVal (VInt n) = True
isRigidVal (VStr s) = True
isRigidVal (VFloat raw) = True
isRigidVal (VBool b) = True
isRigidVal _ = False

allCtorsUnsatisfiable : Ec -> DtData -> List Value -> Int -> Bool
allCtorsUnsatisfiable ec dd idxs depth = allCtorsUnsatisfiableGo ec (dtDataCtors dd) idxs depth

allCtorsUnsatisfiableGo : Ec -> List DtCtor -> List Value -> Int -> Bool
allCtorsUnsatisfiableGo ec [] idxs depth = True
allCtorsUnsatisfiableGo ec (ctor :: rest) idxs depth = case unifyIdxListSized ec [] depth (ctorResultVals ctor depth) idxs of
  OkC refs => False
  ErrC e => allCtorsUnsatisfiableGo ec rest idxs depth

-- ---------------------------------------------------------------
-- M14/M19：构造子 telescope 绑定 + 构造子结果值
-- ---------------------------------------------------------------
-- M28：这条路径只服务**规范形** case（每个构造子一个分支、子模式全是变量/通配）。
-- 嵌套模式在 `checkCase` 里先降级成模式矩阵（`Elab.Match.multiToCaseExpr`），因此这里
-- 遇到非变量子模式只可能是内部错误，报 `NestedPatterns`。
bindCtorTele : Ctx -> Term -> List Pat -> Check (Pair Ctx (Pair (List (Pair String Rig)) (List Pat)))
bindCtorTele ctx ty subpats = bindCtorGo ctx ty subpats []

bindCtorGo : Ctx -> Term -> List Pat -> List (Pair String Rig) -> Check (Pair Ctx (Pair (List (Pair String Rig)) (List Pat)))
bindCtorGo ctx ty subpats acc = case ty of
  TPi name implicit rig dom cod =>
    let
      domVal = eval (ctxEnv ctx) dom
    in if implicit then
      let
        -- 隐式族参数只服务类型层，用带前缀的新名字绑定，避免和用户模式变量同名造成遮蔽。
        famName = "${name}#fam"
        ctx2 = ctxBindValue famName domVal ctx
      in bindCtorGo ctx2 cod subpats (Pair famName Rig0 :: acc)
    else case subpats of
      [] => ErrC (tcMsg CaseBranchTooFewArgs [])
      p :: rest => case p of
        PVar pname psp => bindCtorField ctx rig domVal cod pname rest acc
        PWild psp => bindCtorField ctx rig domVal cod "_" rest acc
        _ => tcErr0 (patSpan p) NestedPatterns
  _ => OkC (Pair ctx (Pair (reverse acc) subpats))

bindCtorField : Ctx -> Rig -> Value -> Term -> String -> List Pat -> List (Pair String Rig) -> Check (Pair Ctx (Pair (List (Pair String Rig)) (List Pat)))
bindCtorField ctx rig domVal cod binderName rest acc =
  let
    ctx2 = ctxBindValue binderName domVal ctx
  in bindCtorGo ctx2 cod rest (Pair binderName rig :: acc)

-- 构造子结果索引的新鲜实例（可达性分析 / 分支合一用）。
freshTeleVals : List (Pair String Rig) -> Int -> Int -> List Value
freshTeleVals [] base i = []
freshTeleVals ((Pair name erased) :: rest) base i =
  VNeutral (NVar name (base + i) []) :: freshTeleVals rest base (i + 1)

ctorResultVals : DtCtor -> Int -> List Value
ctorResultVals c base =
  let
    tele = dtCtorTelescope c
    env = reverse (freshTeleVals tele base 0)
  in map (\t => eval env t) (ctorResultTerms c)

-- 分支里的结果索引：用分支上下文（含已绑定的构造子字段）求值。
-- 于是 `Cons b m y ys` 的结果索引 `Vec (Succ m) b` 里出现的就是这些真实 binder，
-- 合一 `b ↦ a`、`Succ m ↦ n` 后分支体的类型自动被精化。
ctorResultValsIn : Ctx -> DtCtor -> List Value
ctorResultValsIn ctx c = map (\t => evalCtx ctx t) (ctorResultTerms c)

ctorResultTerms : DtCtor -> List Term
ctorResultTerms c = case resultSpine (dtCtorType c) of
  Pair head args => args

-- M24.5：分支里构造子的**值** `VCon c [telescope 各 binder 的值]`。
-- bindCtorTele 刚把 telescope 绑到分支上下文末尾，binder i（telescope 顺序）的 level 是
-- `depth - n + i`，按该顺序排列即 VCon 实参顺序（与求值器 / TCon 实参对齐约定一致）。
ctorValueIn : Ctx -> DtCtor -> Value
ctorValueIn ctx c =
  VCon (dtCtorName c)
    (teleValsFrom (ctxDepth ctx - length (dtCtorTelescope c)) (length (dtCtorTelescope c)))

teleValsFrom : Int -> Int -> List Value
teleValsFrom low k =
  if k <= 0 then []
  else Base.List.Cons (VNeutral (NVar "_tele" low [])) (teleValsFrom (low + 1) (k - 1))

-- M24.5：**scrutinee 反射**。旧实现只把构造子的结果**索引**与 scrutinee 的索引合一，
-- 于是 `case n of ...`（n 是裸 Nat 形参、族没有索引）或「包装族」上完全拿不到等式，
-- goal 里的 n 不会被精化成 `Zero` / `Succ k`。这里在索引合一之后，再把 scrutinee 的
-- **值**（`evalCtx ctx scrutTerm`）与构造子结果值（`ctorValueIn`）合一，得到的 refs 同时
-- 用于 `refineValue expected` 与 `ctxRefine`。
-- 只对**中性变量**（`NVar` 且 spine 为空）反射：非变量 scrutinee（`f x`、字面量、别的
-- 分支绑定子……）拿不到等式，保持旧行为；Bool/Int/String 的 case 走各自的专用路径，
-- 不会到这里。
reflectScrutinee : Ec -> Int -> List (Pair Int Value) -> Value -> Value -> Check (List (Pair Int Value))
reflectScrutinee ec depth refs ctorVal scrutVal = case force (ecDefTbl ec) (ecSolsP ec) defaultFuel (refineValue refs defaultFuel scrutVal) of
  VNeutral n => case n of
    NVar name lvl [] => unifyIdx ec refs depth defaultFuel (VNeutral n) ctorVal
    _ => OkC refs
  _ => OkC refs

-- ---------------------------------------------------------------
-- M28/B15：case 分支的源级校验（唯一入口 `checkCase` 先跑它）
-- ---------------------------------------------------------------
-- 校验是**家族无关**的：兜底位置 + 重复构造子分支 + 重复字面量分支。
-- 家族相关限制（Bool 只认 True/False、Int/String 只认字面量、归纳族只认构造子）
-- 由各家族的降低函数自己报（保留既有诊断）。
--
-- 「重复」= 不可达：同一构造子分支之前已经有一条**不可反驳**的同构造子分支
-- （子模式全是变量/通配），或同一字面量已经出现过。真正需要模式矩阵的重复
-- （`Just (TStr s)` 之后的 `Just v`）不算重复：矩阵降级会让两条分支都可达。
patIrrefutable : Pat -> Bool
patIrrefutable (PVar name sp) = True
patIrrefutable (PWild sp) = True
patIrrefutable _ = False

patsAllIrrefutable : List Pat -> Bool
patsAllIrrefutable [] = True
patsAllIrrefutable (p :: rest) = patIrrefutable p && patsAllIrrefutable rest

ctorHeadCovered : String -> List (Pair Pat Expr) -> Bool
ctorHeadCovered cname [] = False
ctorHeadCovered cname ((Pair pat body) :: rest) = case pat of
  PCon cn subps psp => cn == cname && patsAllIrrefutable subps || ctorHeadCovered cname rest
  _ => ctorHeadCovered cname rest

litHeadCovered : Pat -> List (Pair Pat Expr) -> Bool
litHeadCovered lit [] = False
litHeadCovered lit ((Pair pat body) :: rest) = litPatEq lit pat || litHeadCovered lit rest

litPatEq : Pat -> Pat -> Bool
litPatEq (PInt n sp) p = case p of
  PInt m sp2 => n == m
  _ => False
litPatEq (PStr s sp) p = case p of
  PStr t sp2 => s == t
  _ => False
litPatEq _ p = False

litLabel : Pat -> String
litLabel (PInt n sp) = strFromInt n
litLabel (PStr s sp) = "\"${s}\""
litLabel _ = ""

-- 源级校验：唯一入口。返回 `Ok 0`（成功）或第一条稳定诊断。
-- 校验前剥掉 head 位置的 as-pattern：`x` 的覆盖性与 `pat` 相同；
-- 这样 `checkCaseAltsGo` 的每个递归调用都在 `rest` 上严格下降（不再构造更大的列表）。
-- | 剥掉 head 位置 as-pattern。
stripAsPat : Pat -> Pat
stripAsPat (PAs name inner sp) = stripAsPat inner
stripAsPat pat = pat

-- | 自动补注（M41 新增导出）：stripAsPats。
stripAsPats : List (Pair Pat Expr) -> List (Pair Pat Expr)
stripAsPats [] = []
stripAsPats ((Pair pat body) :: rest) = Pair (stripAsPat pat) body :: stripAsPats rest

-- | 自动补注（M41 新增导出）：checkCaseAltsFlat。
checkCaseAltsFlat : List (Pair Pat Expr) -> Check Int
checkCaseAltsFlat alts = checkCaseAltsGo [] (stripAsPats alts)

checkCaseAltsGo : List (Pair Pat Expr) -> List (Pair Pat Expr) -> Check Int
checkCaseAltsGo prevs alts = case alts of
  [] => OkC 0
  (Pair pat body) :: rest => case pat of
    PCon cname args psp =>
      if ctorHeadCovered cname prevs then
        let
          _ = warnAt1 psp (WarnRedundantCtorBranch cname) cname
        in checkCaseAltsGo (Pair pat body :: prevs) rest
      else checkCaseAltsGo (Pair pat body :: prevs) rest
    -- as-pattern：覆盖性按内层模式判定（`x@pat` 与 `pat` 的头部相同）。
    PInt n psp =>
      if litHeadCovered pat prevs then
        let
          _ = warnAt1 psp (WarnRedundantLiteralBranch (litLabel pat)) (litLabel pat)
        in checkCaseAltsGo (Pair pat body :: prevs) rest
      else checkCaseAltsGo (Pair pat body :: prevs) rest
    PStr s psp =>
      if litHeadCovered pat prevs then
        let
          _ = warnAt1 psp (WarnRedundantLiteralBranch (litLabel pat)) (litLabel pat)
        in checkCaseAltsGo (Pair pat body :: prevs) rest
      else checkCaseAltsGo (Pair pat body :: prevs) rest
    PAs name inner psp => checkCaseAltsGo (Pair pat body :: prevs) rest
    PVar pname psp => checkCatchAll prevs (Pair pat body) rest psp
    PWild psp => checkCatchAll prevs (Pair pat body) rest psp
    PRecord rn fields psp => checkCaseAltsGo (Pair pat body :: prevs) rest

-- 兜底分支只能最后；后面的字面量分支报 `BranchAfterCatchAll`（B15 新诊断），
-- 其它分支沿用既有 `CatchAllNotLast`。
checkCatchAll : List (Pair Pat Expr) -> Pair Pat Expr -> List (Pair Pat Expr) -> Span -> Check Int
checkCatchAll prevs alt [] sp = OkC 0
checkCatchAll prevs alt rest sp =
  if hasLitHead rest then
    let
      _ = warnAt0 sp WarnBranchAfterCatchAll
    in OkC 0
  else tcErr0 sp CatchAllNotLast

hasLitHead : List (Pair Pat Expr) -> Bool
hasLitHead [] = False
hasLitHead ((Pair pat body) :: rest) = case pat of
  PInt n psp => True
  PStr s psp => True
  _ => hasLitHead rest

-- ---------------------------------------------------------------
-- M19：模式辅助（覆盖面 / 矩阵降级判定）
-- ---------------------------------------------------------------
altNames : List (Pair Pat Expr) -> List String
altNames [] = []
altNames ((Pair pat body) :: rest) = case pat of
  PCon cname args psp => cname :: altNames rest
  _ => altNames rest

hasCatchAll : List (Pair Pat Expr) -> Bool
hasCatchAll [] = False
hasCatchAll ((Pair pat body) :: rest) = case pat of
  PCon cname args psp => hasCatchAll rest
  _ => True

hasDupNames : List String -> Bool
hasDupNames [] = False
hasDupNames (x :: rest) = memName x rest || hasDupNames rest

-- 带**嵌套模式**的 case（`[y]` = `Cons y Nil`）走 `Elab.Match` 的模式矩阵降级：
-- 直接在精化器里把嵌套模式折成内层 case 时，兜底分支的体会被内联到更深的 binder
-- 作用域，体里引用外层绑定会错位。矩阵降级生成的是**表达式**，名字在重新精化时
-- 按作用域解析，不会错位。
anyNestedPat : List (Pair Pat Expr) -> Bool
anyNestedPat [] = False
anyNestedPat ((Pair pat body) :: rest) = nestedInPat pat || anyNestedPat rest

nestedInPat : Pat -> Bool
nestedInPat (PCon c args sp) = anyNestedArg args
nestedInPat _ = False

anyNestedArg : List Pat -> Bool
anyNestedArg [] = False
anyNestedArg (a :: rest) = case a of
  PVar n psp => anyNestedArg rest
  PWild psp => anyNestedArg rest
  _ => True

-- ---------------------------------------------------------------
-- M14：覆盖率
-- ---------------------------------------------------------------
-- 覆盖率：可达的构造子必须都出现；不可达的可以省略（写了会被 elabConAlt 拒）。
-- 性能：**已写出的分支直接跳过**（不跑可达性），只有「没写的构造子」才需要判可达性——
-- 否则每个 case 的每个构造子都要模拟一次分支（绑定 telescope + 上下文空类型检查），
-- 编译器自检会慢 4 倍以上。
checkCoverage : Ctx -> Ec -> DtData -> List Value -> List (Pair Pat Expr) -> Span -> Check Int
checkCoverage ctx ec dd idxs alts sp =
  checkCovered ctx ec dd idxs (altNames alts) alts sp (dtDataCtors dd)

checkCovered : Ctx -> Ec -> DtData -> List Value -> List String -> List (Pair Pat Expr) -> Span -> List DtCtor -> Check Int
checkCovered ctx ec dd idxs written alts sp ctors =
  let
    missing = missingCtors ctx ec idxs written ctors
  in if length missing == 0 then OkC 0 else tcCoverageMissing sp missing

missingCtors : Ctx -> Ec -> List Value -> List String -> List DtCtor -> List String
missingCtors ctx ec idxs written [] = []
missingCtors ctx ec idxs written (ctor :: rest) =
  if memName (dtCtorName ctor) written then missingCtors ctx ec idxs written rest
  else if branchReachable ctx ec idxs ctor then Base.List.Cons (ctorDisplayName (dtCtorName ctor)) (missingCtors ctx ec idxs written rest)
  else missingCtors ctx ec idxs written rest

checkCaseDone : Ec -> Ctx -> DtData -> List Value -> List (Pair Pat Expr) -> Value -> Span -> Term -> List CaseAlt -> Check (Pair Term Ec)
checkCaseDone ec ctx dd idxs alts expected sp scrutTerm altTerms =
  if hasCatchAll alts then OkC (Pair (TCase scrutTerm altTerms) ec)
  else Vuna.Compiler.Common.bind (checkCoverage ctx ec dd idxs alts sp)
    (\_ => OkC (Pair (TCase scrutTerm altTerms) ec))
