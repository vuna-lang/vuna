-- Vuna.Compiler.Elab.Meta：Elab 的共享工具层：值/构造子引用（零参构造子、Bool 专用表示）、convEc 与元变量解的作用域复核、
-- 全局签名表与 UTC 收集、dt data/ctor 查找、telescope 与结果 spine 计算、已解元变量内联、
-- 擦除判据（binderRig / isIndexDomain 等）、以及 trait/instance 的命名辅助。
-- 拆自 M24 的单一 `Elab.vuna`（按真实调用图切；门面仍是 `Vuna.Compiler.Elab`）。
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Debug
import Vuna.Compiler.Core
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Intrinsics
import Vuna.Compiler.Elab.Sig
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Frontend.Ast

-- 引用零参（无显式参数）构造子时，其隐式类型/族参数必须实例化成元变量；
-- 否则 `inferE (EVar "Nil")` 会给出 `{a}->List a`（函数类型），而 `Nil` 是值。
-- 仅在「整个类型链没有显式 Pi」（纯零参构造子）时实例化；`Cons`/`Just` 等有显式
-- 参数的构造子保持多态类型（应用时由 `inferArgsGo` 实例化）。
hasNoExplicitPi : Ec -> Value -> Bool
hasNoExplicitPi ec v = hasNoExplicitPiFuel 128 ec v

hasNoExplicitPiFuel : Int -> Ec -> Value -> Bool
hasNoExplicitPiFuel fuel ec v = if fuel <= 0 then True
else case forceVal ec v of
  VPi _ True _ dom clo => hasNoExplicitPiFuel (fuel - 1) ec (applyClosure clo (forceVal ec dom))
  VPi _ False _ dom clo => False
  _ => True

-- 实例化零参构造子的隐式参数，返回「剩余类型 + 依次新建的元变量项」。
-- 元变量项要作为 `TCon` 的擦除实参保留：核心求值器的 `VCon` 实参表与构造子
-- telescope **逐位对齐**（case 分支按 telescope 绑定子压环境），少一个擦除实参就会让
-- 分支体里的变量索引整体偏移（`foldl` 的 `Nil` 分支取到错误的值）。
instantiateNullaryCtor : Ec -> Ctx -> Value -> Result (Pair Value (Pair (List Term) Ec))
instantiateNullaryCtor ec ctx v = instantiateNullaryCtorFuel 64 ec ctx v

instantiateNullaryCtorFuel : Int -> Ec -> Ctx -> Value -> Result (Pair Value (Pair (List Term) Ec))
instantiateNullaryCtorFuel fuel ec ctx v = if fuel <= 0 then Ok (Pair v (Pair [] ec))
else case forceVal ec v of
  VPi _ True _ dom clo => if isImplicitDomain ctx ec dom then case newMeta ctx ec of
    Pair metaTerm ec1 => Vuna.Compiler.Common.bind (instantiateNullaryCtorFuel (fuel - 1) ec1 ctx (applyClosure clo (eval (ctxEnv ctx) metaTerm))) (\p => case p of
      Pair ty (Pair metas ec2) => Ok (Pair ty (Pair (metaTerm :: metas) ec2))
    )
  else Ok (Pair v (Pair [] ec))
  _ => Ok (Pair v (Pair [] ec))

-- 零参构造子的项：`TCon name [擦除实参...]`。元变量个数必须与 telescope 等长才
-- 能保持 VCon 实参对齐；长度对不上（隐式非索引参数等边缘形态）退回 `TGlobal`。
nullaryCtorTerm : DtCtor -> List Term -> Term
nullaryCtorTerm ctor metas =
  if length metas == length (dtCtorTelescope ctor) then TCon (dtCtorName ctor) (zipTeleRigs metas (dtCtorTelescope ctor))
  else TGlobal (dtCtorName ctor)

zipTeleRigs : List Term -> List (Pair String Rig) -> List (Pair Term Rig)
zipTeleRigs [] bs = []
zipTeleRigs ms [] = []
zipTeleRigs (m :: ms) (b :: bs) = Pair m (secondOf b) :: zipTeleRigs ms bs

-- M27：Bool 是 base 的普通 data 声明，身份 = 完整符号 `Base.Bool.Bool`；canonical 族的
-- `True` / `False` 精化成核心 `TBool`（OCaml bool），用户 `data Bool` 是普通 data。
boolCtorValue : String -> Maybe Bool
boolCtorValue name =
  if name == boolTrueCtor then Just True else if name == boolFalseCtor then Just False else Nothing

boolCtorTerm : String -> Term
boolCtorTerm name = case boolCtorValue name of
  Just True => TBool True
  Just False => TBool False
  Nothing => TGlobal name

isBoolFamilyName : String -> Bool
isBoolFamilyName name = name == boolTypeName

-- `inferE (EVar ctor)`：零参构造子（`Nil`/`Nothing` 等）的隐式类型参数实例化成元变量，
-- 使其类型为 `List ?m`/`Maybe ?m`（值），而非 `{a}->List a`（函数）。
inferCtorRef : Ec -> Ctx -> String -> Term -> Result (Pair Term (Pair Value Ec))
inferCtorRef ec ctx name tyTerm = case dtCtorLookupEc ec name of
  Just ctor => if isBoolFamilyName (dtCtorFamily ctor) then Ok (Pair (boolCtorTerm (dtCtorName ctor)) (Pair (VNeutral (NGlobal boolTypeName [])) ec))
  else
    let
      ctorTy = eval [] tyTerm
    in if hasNoExplicitPi ec ctorTy then case instantiateNullaryCtor ec ctx ctorTy of
      Ok (Pair instTy (Pair metas ec1)) => Ok (Pair (nullaryCtorTerm ctor metas) (Pair instTy ec1))
      Err e => Err e
    else Ok (Pair (ctorRefTerm (ecDatas ec) name) (Pair ctorTy ec))
  Nothing => Ok (Pair (ctorRefTerm (ecDatas ec) name) (Pair (eval [] tyTerm) ec))

-- 定义性相等（唯一入口；Bool 与其它 primitive 类型一样按同名全局比较）。
-- M28：解的作用域在求解点就地检查（Core.Conv.solveMeta*），这里只把解表写回 Ec；
-- 不再事后扫新增解（旧 checkSolsDelta 两段式已删除）。
convEc : Ec -> Int -> Value -> Value -> Result Ec
convEc ec depth expected actual = case conv (ecDefTbl ec) (ecSolsP ec) depth expected actual of
  Err e => Err e
  Ok sols2 => Ok (ecPutSols ec (solsList sols2))

-- 未解元变量：返回第一个未解的编号。
unsolvedFrom : Int -> Int -> HashMap Int Value -> Maybe Int
unsolvedFrom i stop sols = unsolvedFromGo (stop - i) stop sols

unsolvedFromGo : Int -> Int -> HashMap Int Value -> Maybe Int
unsolvedFromGo remaining stop sols = if remaining <= 0 then Nothing
else
  let
    i = stop - remaining
  in case metaLookup i sols of
    Just _ => unsolvedFromGo (remaining - 1) stop sols
    Nothing => Just i

memMetaId : Int -> List Int -> Bool
memMetaId i [] = False
memMetaId i (x :: rest) = x == i || memMetaId i rest

relevantMetas : Ec -> List Int
relevantMetas ec =
  append (concatMap (\d => termMetasRuntime (secondOf d)) (ecDefs ec))
    (concatMap (\d => concatMap termMetasAll (map dtCtorType (dtDataCtors d))) (ecDatas ec))

-- 运行时位置：构造子/函数应用的擦除实参不生成代码，跳过；其余位置都算。
termMetasRuntime : Term -> List Int
termMetasRuntime (TMeta m) = [m]
termMetasRuntime (TVar n i) = []
termMetasRuntime (TGlobal g) = []
termMetasRuntime (TType l) = []
termMetasRuntime (TPi n implicit rig dom cod) = append (termMetasAll dom) (termMetasAll cod)
termMetasRuntime (TLam n rig body) = termMetasRuntime body
termMetasRuntime (TApp f a rig) =
  if rigIsErased rig then termMetasRuntime f else append (termMetasRuntime f) (termMetasRuntime a)
termMetasRuntime (TCon c args) =
  concatMap (\p => if rigIsErased (secondOf p) then [] else termMetasRuntime (firstOf p)) args
termMetasRuntime (TCase scrut alts) =
  append (termMetasRuntime scrut) (concatMap (\alt => termMetasRuntime (caseAltBody alt)) alts)
termMetasRuntime (TInt n) = []
termMetasRuntime (TStr s) = []
termMetasRuntime (TFloat raw) = []
termMetasRuntime (TBool b) = []
termMetasRuntime (TIf c th el) =
  append (termMetasRuntime c) (append (termMetasRuntime th) (termMetasRuntime el))

-- 全部位置（类型里出现的元变量也算）。
termMetasAll : Term -> List Int
termMetasAll (TMeta m) = [m]
termMetasAll (TVar n i) = []
termMetasAll (TGlobal g) = []
termMetasAll (TType l) = []
termMetasAll (TPi n implicit rig dom cod) = append (termMetasAll dom) (termMetasAll cod)
termMetasAll (TLam n rig body) = termMetasAll body
termMetasAll (TApp f a rig) = append (termMetasAll f) (termMetasAll a)
termMetasAll (TCon c args) = concatMap (\p => termMetasAll (firstOf p)) args
termMetasAll (TCase scrut alts) =
  append (termMetasAll scrut) (concatMap (\alt => termMetasAll (caseAltBody alt)) alts)
termMetasAll (TInt n) = []
termMetasAll (TStr s) = []
termMetasAll (TFloat raw) = []
termMetasAll (TBool b) = []
termMetasAll (TIf c th el) = append (termMetasAll c) (append (termMetasAll th) (termMetasAll el))

maxInt : Int -> Int -> Int
maxInt a b = if a >= b then a else b

globalLookup : String -> List (Pair String Term) -> Maybe Term
globalLookup name [] = Nothing
globalLookup name ((Pair n ty) :: rest) = if name == n then Just ty else globalLookup name rest

-- 全局名查找的**热路径**入口：先查 Ec 里的哈希索引（O(1)），未命中再回落到线性扫。
-- 回落是必要的：索引只在 `elabBodies` 之前从当时的 globals 建一次，之前的数据族/trait/
-- 签名阶段索引为空（那些阶段总量小，线性扫可接受）；索引与 globals 不一致时以列表为准。
globalsLookup : String -> List (Pair String Term) -> Ec -> Maybe Term
globalsLookup name globals ec = case Base.HashMap.lookup name (ecGlobalsTbl ec) of
  Just ty => Just ty
  -- 表已完整（bodies 阶段）时，未命中就意味着「不是全局」：省掉线性扫全 globals
  -- 的回落（未命中的绝大多数是数据族名，如 Base.List.List / String / Int）。
  Nothing => if ec.ecGlobalsComplete then Nothing else globalLookup name globals

-- 全局签名表的构造：同名条目**后出现的获胜**。globals 的顺序是「数据族 kind 先登记、
-- 值签名后追加」，因此值位置取到值签名（B18）；类型位置由 `typeHeadLookup` 走
-- `dtDataKind`，不依赖这张表。注意 `Base.HashMap.fromList` 是**先出现获胜**，用它建
-- 这张表会让同名值定义被族 kind 盖掉（旧实现即如此）。
globalsTableOf : List (Pair String Term) -> HashMap String Term
globalsTableOf globals = Base.HashMap.insertAll globals (Base.HashMap.fromList [])

-- ---------------------------------------------------------------
memSig : Eq a => List (Pair a b) -> a -> Bool
memSig [] name = False
memSig ((Pair n ty) :: rest) name = n == name || memSig rest name

memDefName : String -> List (Pair String Term) -> Bool
memDefName name [] = False
memDefName name ((Pair n ty) :: rest) = n == name || memDefName name rest

collectSigs : List Decl -> Result (List (Pair String (Pair (List Expr) (Pair Expr Span))))
collectSigs decls =
  let
    defined = definedNames decls
    -- M30（D18）：banned 表一次性建（一次 O(#defined)），之后每个签名 O(1) 查。
    -- 旧实现每签名扫全 defined 并重建表（O(#sigs × #defined)），实测 collectSigs 12.9 s。
    banned = qualifiedBannedTbl defined
    preludeBanned = topQuantBanned []
  in collectSigsInto banned preludeBanned (Base.HashMap.fromList []) [] decls

-- 声明收集（M20：签名里的自由小写名量化为隐式类型参数，见 `Elab.Sig.quantifyTopSig`）。
-- M28 / C29：banned 集按**签名所属模块**作用域；M30（D18）把这张集合改成共享缓存：
-- `banned` 的键是「模块前缀 \t 名字」（`Sig.qualifiedBannedTbl`），`preludeBanned` 是
-- 全局 prelude 名单，两者都只建一次。
collectSigsInto : HashMap String Bool -> HashMap String Bool -> HashMap String Bool -> List (Pair String (Pair (List Expr) (Pair Expr Span))) -> List Decl -> Result (List (Pair String (Pair (List Expr) (Pair Expr Span))))
collectSigsInto banned preludeBanned seen acc [] = Ok (reverse acc)
collectSigsInto banned preludeBanned seen acc (d :: rest) = case d of
  DSig name ctx ty sp => collectSigOne banned preludeBanned seen acc name ctx ty sp rest
  -- M28：axiom 与签名同一套类型检查/量化；区别只在 `checkAllDefined` 不要求它有体。
  DAxiom name ty sp => collectSigOne banned preludeBanned seen acc name [] ty sp rest
  DExtern name cName ty sp => collectSigOne banned preludeBanned seen acc name [] ty sp rest
  DFun name pats body sp => collectSigsInto banned preludeBanned seen acc rest
  DData name params kind ctors derivings viaField lin sp =>
    collectSigsInto banned preludeBanned seen acc rest
  DRecord name params fields derivings viaField lin sp =>
    errAt sp "DT: internal: record was not desugared"
  DTrait name params methods sp => collectSigsInto banned preludeBanned seen acc rest
  DInstance ctxE head methods sp => collectSigsInto banned preludeBanned seen acc rest

collectSigOne : HashMap String Bool -> HashMap String Bool -> HashMap String Bool -> List (Pair String (Pair (List Expr) (Pair Expr Span))) -> String -> List Expr -> Expr -> Span -> List Decl -> Result (List (Pair String (Pair (List Expr) (Pair Expr Span))))
collectSigOne banned preludeBanned seen acc name ctx ty sp rest =
  if memName name preludeNames then tcErr1 sp (CannotRedefineBuiltin name) name
  else if Base.HashMap.member name seen then tcErr1 sp (DuplicateSignature name) name
  else collectSigsInto banned preludeBanned (Base.HashMap.insert name True seen)
    (Pair name (Pair ctx (Pair (quantifyTopSigCtxCached (modulePrefixOf name) banned preludeBanned ctx ty sp) sp)) :: acc)
    rest

-- 已精化的族按源顺序积累在 Ec 的 datas 里（case 精化需要族的 ctor telescope）。
-- 收集 data 声明（按源顺序）。
collectDataDecls : List Decl -> List (Pair Decl Span) -> List (Pair Decl Span)
collectDataDecls [] acc = reverse acc
collectDataDecls (d :: rest) acc = case d of
  DData dname params kind ctors derivings viaField lin sp =>
    collectDataDecls rest (Pair d sp :: acc)
  _ => collectDataDecls rest acc

-- 绑到实际族上。
dataNamesOf : List Decl -> List String
dataNamesOf [] = []
dataNamesOf (d :: rest) = case d of
  DData dname params kind ctors derivings viaField lin sp => dname :: dataNamesOf rest
  _ => dataNamesOf rest

nonEmpty : List a -> Bool
nonEmpty [] = False
nonEmpty (_ :: _) = True

-- 族的 kind 必须是「Pi 链 + 宇宙结尾」（M28 决策 1：严格分层、非累积）：
-- - 结果必须是 `Type l` 且 `l` 非负（`Type i : Type (i+1)`；不允许 `Type : Type`、
--   也没有 subtyping / cumulativity，所以 `Type i` 与 `Type j`（i≠j）不相等）；
-- - 每个 binder 的域必须是能赋 sort 的类型（宇宙 / 递归 Pi 链）。索引域（归纳族、
--   类型变量、族应用）的类型正确性由 `checkType` 的 Pi formation 保证，这里只复核
--   结构里出现的宇宙层级非负——kind 会被存进 globals 并在别处按域求值，负层级是
--   内部不变量被破坏的信号，必须就地拒绝。
kindWellFormed : Term -> Bool
kindWellFormed (TPi name implicit rig dom cod) = kindDomainWellFormed dom && kindWellFormed cod
kindWellFormed (TType l) = levelToInt l >= 0
kindWellFormed _ = False

-- kind binder 域的防御性复核：宇宙层级非负；Pi 链逐层递归；其余形态（类型变量 /
-- 归纳族 / 族应用）是索引域，类型正确性已由 checkType 保证。
kindDomainWellFormed : Term -> Bool
kindDomainWellFormed (TType l) = levelToInt l >= 0
kindDomainWellFormed (TPi _ _ _ d c) = kindDomainWellFormed d && kindDomainWellFormed c
kindDomainWellFormed _ = True

-- 族的参数/索引 telescope：binder 名 + 声明的 Rig（M38：直接用 TPi 携带的量，不重算）。
splitKind : Term -> List (Pair String Rig)
splitKind (TPi name implicit rig dom cod) = Pair name rig :: splitKind cod
splitKind _ = []

dtDataLookup : String -> List DtData -> Maybe DtData
dtDataLookup name [] = Nothing
dtDataLookup name (d :: rest) = if dtDataName d == name then Just d else dtDataLookup name rest

findCtorIn : String -> List DtCtor -> Maybe DtCtor
findCtorIn name [] = Nothing
findCtorIn name (c :: rest) = if dtCtorName c == name then Just c else findCtorIn name rest

dtCtorLookup : String -> List DtData -> Maybe DtCtor
dtCtorLookup name [] = Nothing
dtCtorLookup name (d :: rest) = case findCtorIn name (dtDataCtors d) of
  Just c => Just c
  Nothing => dtCtorLookup name rest

-- M30（D18）构造子索引的**唯一热路径入口**：先查 `Ec.ecCtorTbl`（O(1)），未命中回落
-- 线性扫族表。索引是可重建缓存（真相仍是 `ecDatas`）：建表前的阶段（data 精化中途）
-- 或者 `ecAddData` 之外的旁路构造都会 miss，回落保证语义不变。
dtCtorLookupEc : Ec -> String -> Maybe DtCtor
dtCtorLookupEc ec name = case Base.HashMap.lookup name ec.ecCtorTbl of
  Just c => Just c
  Nothing => dtCtorLookup name (ecDatas ec)

-- ---------------------------------------------------------------
-- M28（B18）：Elab 侧的**显式命名空间查询**
-- ---------------------------------------------------------------
-- 核心项里的名字是 Loader mangle 过的全局串；同名族与构造子**共享同一个串**
-- （`data Pair a b where Pair : ...` 的族与构造子都叫 `<M>.Pair`），所以「这个名字属于
-- 类型还是值命名空间」不能在调用点靠「kind 是不是宇宙」猜，而要按表查：
--
--   typeLookup  —— 类型命名空间：数据族（含 trait 字典族，字典族也是普通 DtData）与
--                  **类型层全局**（签名是「Pi 链 → 宇宙」的 def，如 `sel : Nat -> Type`）；
--   valueLookup —— 值命名空间：构造子优先（同名时值位置取构造子），再全局定义；
--                  数据族名也在这里命中——它作为「类型作为项」有 kind 当类型。
-- 名字是否在类型命名空间里声明（数据族 / 字典族）。
isDataFamilyName : Ec -> String -> Bool
isDataFamilyName ec name = case dtDataLookup name (ecDatas ec) of
  Just _ => True
  Nothing => False

-- 全局签名是否是类型层：`Type`、`Type -> Type`、`Nat -> Type` 这类 Pi 链 → 宇宙。
isTypeLevelGlobal : List (Pair String Term) -> Ec -> String -> Bool
isTypeLevelGlobal globals ec name = case globalsLookup name globals ec of
  Just ty => kindWellFormed ty
  Nothing => False

isTypeName : List (Pair String Term) -> Ec -> String -> Bool
isTypeName globals ec name = isTypeLevelGlobal globals ec name || isDataFamilyName ec name

-- M41：与族同名的构造子（`data Pair ... where Pair : ...`）。data 构造子的 canonical 名
-- 是 `Module.Data.Ctor`；若族前缀是一个数据族且其短名 == 构造子短名，那么该构造子在
-- 「期望是宇宙」的位置按「类型作为项」解析（B18 双命名空间的既有行为）。
-- | 自动补注（M41 新增导出）：dataShortNameOf。
dataShortNameOf : String -> String
dataShortNameOf name = secondOf (splitLastDot (splitOnDot name))

-- | 自动补注（M41 新增导出）：typeNameOfDualCtor。
typeNameOfDualCtor : Ec -> String -> Maybe String
typeNameOfDualCtor ec name = case splitLastDot (splitOnDot name) of
  Pair revPrefix base =>
    let
      fam = joinDots revPrefix
    in if fam == "" then Nothing
    else if dataShortNameOf fam == base then case dtDataLookup fam (ecDatas ec) of
      Just dd => Just fam
      Nothing => Nothing
    else Nothing

-- | 自动补注（M41 新增导出）：ctorFamilyNameOf。
ctorFamilyNameOf : Ec -> String -> Maybe String
ctorFamilyNameOf ec target = case dtCtorLookupEc ec target of
  Just c => Just (dtCtorFamily c)
  Nothing => Nothing

-- | 自动补注（M41 新增导出）：expectedFamilyOf。
expectedFamilyOf : Ec -> Value -> Maybe String
expectedFamilyOf ec v = expectedFamilyOfFuel 64 ec v

-- | 自动补注（M41 新增导出）：expectedFamilyOfFuel。
expectedFamilyOfFuel : Int -> Ec -> Value -> Maybe String
expectedFamilyOfFuel fuel ec v = if fuel <= 0 then Nothing
else case forceVal ec v of
  VNeutral (NGlobal fam args) => Just fam
  VPi name implicit rig dom clo =>
    expectedFamilyOfFuel (fuel - 1) ec (applyClosure clo (VNeutral (NVar "_over" 0 [])))
  _ => Nothing

-- | 自动补注（M41 新增导出）：overCandidatesText。
overCandidatesText : List String -> String
overCandidatesText targets = join ", " (map ctorDisplayName targets)

-- | 自动补注（M41 新增导出）：dualFamilyOf。
dualFamilyOf : Ec -> String -> List String -> Maybe String
dualFamilyOf ec short [] = Nothing
dualFamilyOf ec short (t :: rest) = case dtCtorLookupEc ec t of
  Just c =>
    if dataShortNameOf (dtCtorFamily c) == short then Just (dtCtorFamily c)
    else dualFamilyOf ec short rest
  Nothing => dualFamilyOf ec short rest

-- | 自动补注（M41 新增导出）：ctorFamilyIs。
ctorFamilyIs : Ec -> String -> String -> Bool
ctorFamilyIs ec target fam = case ctorFamilyNameOf ec target of
  Just f => f == fam
  Nothing => False

-- | 自动补注（M41 新增导出）：candidatesInFamily。
candidatesInFamily : Ec -> Maybe String -> List String -> List String
candidatesInFamily ec Nothing targets = targets
candidatesInFamily ec (Just fam) targets = filter (\t => ctorFamilyIs ec t fam) targets

-- | 自动补注（M41 新增导出）：resolveOverCtor。
resolveOverCtor : Ec -> Span -> Maybe Value -> String -> List String -> Result String
resolveOverCtor ec sp Nothing short targets = defaultOrOver ec sp short targets
resolveOverCtor ec sp (Just expected) short targets = if isSortVal ec expected then case dualFamilyOf ec short targets of
  Just fam => Ok fam
  Nothing => resolveOverCtorGo ec sp (expectedFamilyOf ec expected) short targets
else resolveOverCtorGo ec sp (expectedFamilyOf ec expected) short targets

-- | 自动补注（M41 新增导出）：resolveOverCtorGo。
resolveOverCtorGo : Ec -> Span -> Maybe String -> String -> List String -> Result String
resolveOverCtorGo ec sp Nothing short targets = defaultOrOver ec sp short targets
resolveOverCtorGo ec sp (Just fam) short targets = case candidatesInFamily ec (Just fam) targets of
  [t] => Ok t
  _ =>
    tcErr2 sp (AmbiguousCtor short (overCandidatesText targets)) short (overCandidatesText targets)

-- | 自动补注（M41 新增导出）：defaultOrOver。
defaultOrOver : Ec -> Span -> String -> List String -> Result String
defaultOrOver ec sp short targets = case listCtorTarget ec targets of
  Just t => Ok t
  Nothing => case targets of
    [t] => Ok t
    _ =>
      tcErr2 sp (AmbiguousCtor short (overCandidatesText targets)) short
        (overCandidatesText targets)

-- | 自动补注（M41 新增导出）：listCtorTarget。
listCtorTarget : Ec -> List String -> Maybe String
listCtorTarget ec [] = Nothing
listCtorTarget ec (t :: rest) =
  if ctorFamilyIs ec t listFamilyName then Just t else listCtorTarget ec rest

-- 类型头的签名项：数据族以 `DtData.dtDataKind` 为准。globals 是 name→Term 单表，
-- 同模块同名值定义（`data T` 与 `T : Int`）会覆盖族的 kind；B18 起类型位置不再受
-- 该覆盖影响，值位置仍由 `valueLookup` 取值签名。数据头登记阶段 `ecDatas` 尚未含
-- 当前族，此时回退到 globals 里的 kind，因此前向引用 / 互递归语义不变。
typeHeadLookup : List (Pair String Term) -> Ec -> String -> Maybe Term
typeHeadLookup globals ec name = case dtDataLookup name (ecDatas ec) of
  Just dd => Just (dtDataKind dd)
  Nothing => if isTypeLevelGlobal globals ec name then globalsLookup name globals ec else Nothing

-- 类型位置查类型命名空间：返回该名字的签名项（族的 kind / 类型层 def 的类型）。
typeLookup : List (Pair String Term) -> Ec -> String -> Maybe Term
typeLookup globals ec name = typeHeadLookup globals ec name

-- 值命名空间的查询结果：构造子（值位置优先）或全局定义（含数据族名）。
data ValueEntry : Type where
  VECtor : DtCtor -> ValueEntry
  VEDef : Term -> ValueEntry

-- 值位置查值命名空间（构造子 + 全局定义）：同名时构造子优先——族 kind 与构造子同串，
-- 直接查 globals 会先拿到族 kind（`Type -> ... -> Type`）而不是构造子类型。
valueLookup : List (Pair String Term) -> Ec -> String -> Maybe ValueEntry
valueLookup globals ec name = case dtCtorLookupEc ec name of
  Just ctor => Just (VECtor ctor)
  Nothing => case globalsLookup name globals ec of
    Just ty => Just (VEDef ty)
    Nothing => Nothing

-- 构造子类型的 telescope：逐个 binder 求值域。
-- 隐式 binder（族参数/索引）一律擦除；显式 binder 只有在域是宇宙时才擦除。
teleOfType : Term -> List (Pair String Rig)
teleOfType ty = teleOf ty []

teleOf : Term -> List Value -> List (Pair String Rig)
teleOf (TPi name implicit rig dom cod) env =
  let
    v = VNeutral (NVar name (length env) [])
  in Pair name rig :: teleOf cod (v :: env)
teleOf _ env = []

-- 结果类型 `F r1..rk` 的「头 + 实参」。
spineOfType : Term -> Pair String (List Term)
spineOfType (TApp f a erased) = case spineOfType f of
  Pair h args => Pair h (append args [a])
spineOfType (TGlobal g) = Pair g []
spineOfType _ = Pair "" []

resultSpine : Term -> Pair String (List Term)
resultSpine (TPi name implicit rig dom cod) = resultSpine cod
resultSpine ty = spineOfType ty

-- ---------------------------------------------------------------
-- M28：统一 zonk——把「检查期已解」的元变量替换进**会被存下来**的项
-- （签名 / 构造子类型 / 族 kind）。
-- ---------------------------------------------------------------
-- 典型来源：`data Eq : {a : Type} -> a -> a -> Type` 的构造子写
-- `Refl : {a : Type} -> (x : a) -> Eq x x`——结果类型 `Eq x x` 里隐式族参数由检查器插成
-- 元变量 `?m`，检查时解成构造子自己的 `a`（level 形态的局部变量）。若把 `?m` 留在
-- dtCtorType 里，使用点按另一份上下文求值时解出来的 `a` 就是悬空变量
-- （曾报 `constructor Refl: type mismatch: expected Nat, got a`）。
-- 解是 level 形态：按**当前 binder 深度** quote 成项即可；解里出现越界 index（负数）说明
-- 它引用了当前项作用域外的变量，此时不替换（保守，留原元变量）。
-- M28 起这是**唯一**的「已解元变量 → 项」入口（旧 inlineSolvedMetas/inlineSolvedMetaAlt
-- 合并到这里；解在求解点已保证作用域，所以正常输入不会再出现越界）。
zonkTerm : Ec -> Int -> Term -> Term
zonkTerm ec depth t = zonkTermFuel 64 ec depth t

zonkTermFuel : Int -> Ec -> Int -> Term -> Term
zonkTermFuel fuel ec depth t = if fuel <= 0 then t
else case t of
  TMeta m => case metaLookup m (ecSolTbl ec) of
    Just v =>
      let
        q = quote depth v
      in if hasOutOfScopeVar q then t else zonkTermFuel (fuel - 1) ec depth q
    Nothing => t
  TPi n i r d c =>
    TPi n i r (zonkTermFuel (fuel - 1) ec depth d) (zonkTermFuel (fuel - 1) ec (depth + 1) c)
  TLam n r b => TLam n r (zonkTermFuel (fuel - 1) ec (depth + 1) b)
  TApp f a r => TApp (zonkTermFuel (fuel - 1) ec depth f) (zonkTermFuel (fuel - 1) ec depth a) r
  TCon c args =>
    TCon c (map (\p => Pair (zonkTermFuel (fuel - 1) ec depth (firstOf p)) (secondOf p)) args)
  TCase s alts =>
    TCase (zonkTermFuel (fuel - 1) ec depth s)
      (map (\alt => zonkAltFuel (fuel - 1) ec depth alt) alts)
  TIf c th el =>
    TIf (zonkTermFuel (fuel - 1) ec depth c) (zonkTermFuel (fuel - 1) ec depth th)
      (zonkTermFuel (fuel - 1) ec depth el)
  _ => t

zonkAlt : Ec -> Int -> CaseAlt -> CaseAlt
zonkAlt ec depth alt = zonkAltFuel 64 ec depth alt

zonkAltFuel : Int -> Ec -> Int -> CaseAlt -> CaseAlt
zonkAltFuel fuel ec depth alt0 = if fuel <= 0 then CaseAlt "" [] (TMeta 0)
else case alt0 of
  CaseAlt n bs b => CaseAlt n bs (zonkTermFuel (fuel - 1) ec (depth + length bs) b)

-- quote 出来的项里出现负 index：解引用了当前项作用域外的变量，不能替换。
hasOutOfScopeVar : Term -> Bool
hasOutOfScopeVar (TVar name i) = i < 0
hasOutOfScopeVar (TPi n i r d c) = hasOutOfScopeVar d || hasOutOfScopeVar c
hasOutOfScopeVar (TLam n r b) = hasOutOfScopeVar b
hasOutOfScopeVar (TApp f a r) = hasOutOfScopeVar f || hasOutOfScopeVar a
hasOutOfScopeVar (TCon c args) = hasOutOfScopeVarArgs args
hasOutOfScopeVar (TCase s alts) = hasOutOfScopeVar s || hasOutOfScopeVarAlts alts
hasOutOfScopeVar (TIf c th el) = hasOutOfScopeVar c || hasOutOfScopeVar th || hasOutOfScopeVar el
hasOutOfScopeVar _ = False

hasOutOfScopeVarArgs : List (Pair Term Rig) -> Bool
hasOutOfScopeVarArgs [] = False
hasOutOfScopeVarArgs ((Pair a rig) :: rest) = hasOutOfScopeVar a || hasOutOfScopeVarArgs rest

hasOutOfScopeVarAlts : List CaseAlt -> Bool
hasOutOfScopeVarAlts [] = False
hasOutOfScopeVarAlts ((CaseAlt n bs b) :: rest) = hasOutOfScopeVar b || hasOutOfScopeVarAlts rest

-- 族的 kind 里的参数个数，补成隐式 `EPi`。
prependFamParams : Term -> Expr -> Span -> Expr
prependFamParams (TPi n implicit rigB dom cod) tyExpr sp =
  EPi n True Nothing (EVar "Type" sp) (prependFamParams cod tyExpr sp) sp
prependFamParams _ tyExpr sp = tyExpr

-- 剥掉外层 Pi（`resultSpine` 需要看返回类型）。
dropParams : Term -> Term
dropParams (TPi n implicit rigB dom cod) = dropParams cod
dropParams t = t

ctorGlobals : List DtCtor -> List (Pair String Term)
ctorGlobals [] = []
ctorGlobals (c :: rest) = Pair (dtCtorName c) (dtCtorType c) :: ctorGlobals rest

-- 一个 data 头的两阶段精化结果（M23）：族名、完整 kind、参数个数。
record DataHead where
  dataHeadName : String
  dataHeadKind : Term
  dataHeadArity : Int

lookupDataHead : String -> List DataHead -> Maybe (Pair Term Int)
lookupDataHead name [] = Nothing
lookupDataHead name (h :: rest) =
  if h.dataHeadName == name then Just (Pair h.dataHeadKind h.dataHeadArity)
  else lookupDataHead name rest

-- ---------------------------------------------------------------
-- M15：接口（trait）与实例（instance）——字典编码
-- ---------------------------------------------------------------
-- 不新增 Core 节点，全部落到既有 data / 隐式 Pi / 构造子上：
-- `trait Show a` ⇒ `data Dict_Show : Type -> Type` + 方法投影
-- `show : {a : Type} -> {d : Dict_Show a} -> a -> String`（字典当隐式参数穿进来）。
-- 实例搜索发生在隐式 binder 的域是接口字典时：在已注册实例里找头能统一到 `Dict_C args`
-- 的那一个并插入；找不到 ⇒ 明确缺失诊断。设计见 `docs/reference/core.md`。
dictTypeName : String -> String
dictTypeName cname = "Dict_${cname}"

dictCtorName : String -> String
dictCtorName cname = "MkDict_${cname}"

-- 收集 trait / instance 声明（按源顺序）。
collectTraitDecls : List Decl -> List (Pair Decl Span) -> List (Pair Decl Span)
collectTraitDecls [] acc = reverse acc
collectTraitDecls (d :: rest) acc = case d of
  DTrait tname params methods sp => collectTraitDecls rest (Pair d sp :: acc)
  _ => collectTraitDecls rest acc

collectInstDecls : List Decl -> List (Pair Decl Span) -> List (Pair Decl Span)
collectInstDecls [] acc = reverse acc
collectInstDecls (d :: rest) acc = case d of
  DInstance ctxE head methods sp => collectInstDecls rest (Pair d sp :: acc)
  _ => collectInstDecls rest acc

-- 单参数接口的参数名（elabTrait 已校验 length params == 1）。
paramNameOf : List String -> String
paramNameOf [] = "_"
paramNameOf (p :: rest) = p

-- 方法参数 x_i 的 (项, rig)：index = n + (ar - 1 - i)。
methodArgTerms : List Rig -> Int -> List (Pair Term Rig)
methodArgTerms rigs nFields = methodArgTermsGo rigs nFields 0 (length rigs)

methodArgTermsGo : List Rig -> Int -> Int -> Int -> List (Pair Term Rig)
methodArgTermsGo [] nFields i arity = []
methodArgTermsGo (rig :: rest) nFields i arity =
  Pair (TVar "x${i}" (nFields + (arity - 1 - i))) rig :: methodArgTermsGo rest nFields (i + 1) arity

-- 逐层 lambda 绑定方法参数（x_0 最外），每层用各自 rig。
methodArgLams : List Rig -> Int -> Term -> Term
methodArgLams [] i body = body
methodArgLams (rig :: rest) i body = TLam "x${i}" rig (methodArgLams rest (i + 1) body)

-- 方法显式参数的 multiplicity 表：逐 binder 按域判断（域是宇宙 ⇒ Rig0 擦除）。
fieldVarName : Int -> String
fieldVarName i = "f${i}"

fieldBinderNames : Int -> List (Pair String Rig)
fieldBinderNames n = fieldBinderGo n 0 []

fieldBinderGo : Int -> Int -> List (Pair String Rig) -> List (Pair String Rig)
fieldBinderGo n i acc = fieldBinderGoGo (n - i) n acc

fieldBinderGoGo : Int -> Int -> List (Pair String Rig) -> List (Pair String Rig)
fieldBinderGoGo remaining n acc =
  if remaining <= 0 then reverse acc
  else fieldBinderGoGo (remaining - 1) n (Pair (fieldVarName (n - remaining)) RigOmega :: acc)

-- M24.7：按**短名**查类（库里的类名带模块前缀，如 `Base.Eq.Eq`；`==` / `<` 的字典
-- 查找从 `ecClasses` 按最后一段反查，找不到时调用方退回泛型运行时兜底）。
findClassByShortName : String -> List DtClass -> Maybe DtClass
findClassByShortName short [] = Nothing
findClassByShortName short (c :: rest) =
  if baseNameOf (dtClassName c) == short then Just c else findClassByShortName short rest

-- M36：blanket 实例（fallback 实例）判定——头是 `Dict_C x1 .. xn`，且每个 `x` 都是
-- 本实例自己的**裸 tele 变量**（例如 `instance Show a => Interp a`）。`n` 是 tele 长度，
-- head 在该 n 个 binder 之下，所以合法索引是 0..n-1。多参数 trait 的所有头实参都满足
-- 才算 blanket。
--
-- 用途分两处消费：`Elab/InstCoherence`（coherence：blanket 与具体实例可共存）与
-- `Elab/Dict`（实例搜索：具体实例优先、blanket 兜底）。
isBlanketInstHead : Int -> Term -> Bool
isBlanketInstHead n head = if n <= 0 then False
else case flattenTaggedApp head of
  Just (Pair g args) => nonEmpty args && allTeleArgs n args
  Nothing => False

allTeleArgs : Int -> List (Pair Term Rig) -> Bool
allTeleArgs n [] = True
allTeleArgs n (arg :: rest) = case firstOf arg of
  TVar vname i => i >= 0 && i < n && allTeleArgs n rest
  _ => False

isBlanketInst : DtInst -> Bool
isBlanketInst (DtInst name tele ctx head) = isBlanketInstHead (length tele) head

-- 把方法类型里对类参数的引用（de Bruijn 0）替换成实例头实参。
-- 字段类型是在 `{a : Type}` 之下检查的闭合项，所以类参数恒为 index 0；
-- 这里按 **索引** 替换（不按名字），避免上游换名失效。
substClassParam : String -> Term -> Term -> Term
substClassParam pname arg ty = substVarAt 0 arg ty

-- ---------------------------------------------------------------
-- M38 / W7：线性捕获标记（binder 名编码）
-- ---------------------------------------------------------------
-- 捕获线性值的 λ 不能一律拒绝：当它被**立即按 quantity 1 消费**（函数位应用 /
-- rig-1 实参 / 线性数据的 rig-1 字段）时是安全的。精化期知道 ctx 里哪些 binder 是
-- 线性类型（`termHasOuterLinear`），此时给 λ 的 binder 名加前缀标记；用量检查
-- （`Elab.Usage`）按位置规则接受或拒绝，拒绝时报 `TC_LinearCaptureEscapes`。
-- 名字必须**唯一**：codegen 用 binder 名渲染 OCaml 变量，两个同名的嵌套 λ 会让
-- 内层遮蔽外层（引用外层时解析到内层）。因此把 span + ctx 深度编进名字；`#` 不是
-- 源码标识符字符，`sanitizeName` 会把它变成合法 OCaml 名，用户不可见。
linClosureMark : String
linClosureMark = "#linclos"

linClosureName : Span -> Int -> String -> String
linClosureName sp depth name =
  "${linClosureMark}${strFromInt sp.spanStartLine}_${strFromInt sp.spanStartCol}_${strFromInt depth}:${name}"

isLinClosureName : String -> Bool
isLinClosureName name = startsWith linClosureMark name

linClosureOrigName : String -> String
linClosureOrigName name = if isLinClosureName name then linClosureOrigGo (strUnpack name) else name

linClosureOrigGo : List Int -> String
linClosureOrigGo [] = ""
linClosureOrigGo (c :: rest) = if c == 58 then strPack rest else linClosureOrigGo rest

-- 字面量比较的运行时函数名（`==` 的跨类型特化；codegen 按名字映射）。
litEqName : String -> String
litEqName tyName = if tyName == "String" then "bi_eq_str" else "bi_eq_int"

-- M14：隐式 binder 的域可以是：宇宙、已声明归纳族（`{n : Nat}` 这类索引），或**高阶 kind**
-- （`{f : Type -> Type}`，M19 起 `trait Mapper f` 需要）。其它类型（Int/String/…）仍
-- 拒绝：隐式实参不参与运行时计算。
isIndexDomain : Ec -> Value -> Bool
isIndexDomain ec dom = isTypeDomain dom || isDataHead (ecDatas ec) (forceVal ec dom)

-- M29（B09/D08）：隐式 binder 域的**放行判据**（比 isIndexDomain 宽一档）。
-- 隐式值参数 `{x : a}`（域是类型/索引变量）过去被 isIndexDomain 拒：
--   `a` 求值是 `VNeutral (NVar ...)`，既不是宇宙/Pi 链也不是 data 头。
-- 现在多放行两类域：
--   1) 未解元变量：**使用侧** `{x : a}` 的 `a` 在调用点已被实例化成 meta
--      （`inferArgsGo` 先给 `a` 建 meta，再处理 `x`），必须允许插入隐式实参；
--      meta 的最终域由后续合一决定；若解成运行时类型，运行时使用会被擦除检查拒绝。
--   2) 中性局部变量：**定义侧** `{x : a}` 的 `a` 是上下文里的类型/索引变量；
--      查它的 binder 类型，若 binder 类型本身是 index domain（`Type` / 高阶 kind /
--      `Nat` 之类索引族）则放行。`Int` / `String` 这类非类型域仍拒绝。
-- 放行**不改变擦除判据**：隐式 binder 恒 Rig0（`binderRig`），值只在类型/证明位置可用；
-- 运行时使用由 `Codegen.Erase` 的擦除检查报错（`dt_err/42_implicit_value_runtime`）。
isImplicitDomain : Ctx -> Ec -> Value -> Bool
isImplicitDomain ctx ec dom = if isIndexDomain ec dom then True
else case forceVal ec dom of
  VMeta m sp => True
  VNeutral n => case n of
    NVar name lvl sp => neutralBinderIndexDomain ctx ec lvl
    _ => False
  -- 高阶 kind 形态（`{p : a -> Type}`）：域本身是「类型构造子的 kind」也放行；
  -- 值层函数类型（`a -> b`，cod 不是宇宙）仍拒绝。
  VPi _ _ _ d clo => isKindWithCtx ctx ec (forceVal ec dom)
  _ => False

-- 上下文里 level 为 lvl 的 binder 的类型是不是 index domain。
-- Ctx 项按「最近绑定在前」存；level 0 是最外层 binder，所以位置 = depth - lvl - 1。
neutralBinderIndexDomain : Ctx -> Ec -> Int -> Bool
neutralBinderIndexDomain ctx ec lvl = case neutralBinderType ctx ec lvl of
  Just tyVal => isIndexDomain ec tyVal
  Nothing => False

-- level 为 lvl 的 binder 的类型（在完整上下文里求值）。
neutralBinderType : Ctx -> Ec -> Int -> Maybe Value
neutralBinderType ctx ec lvl =
  let
    d = ctxDepth ctx
    idx = d - lvl - 1
  in if lvl < 0 then Nothing
  else if idx < 0 then Nothing
  else case ctxItemAt idx ctx.ctxItems of
    Nothing => Nothing
    Just item => Just (varTypeValue ctx idx (secondOf item))

-- 「kind 形态」：Pi 链每个域都是类型（type-like），终点是宇宙。
-- 例：`Type`、`Type -> Type`、`a -> Type`（a 是类型变量）、`Nat -> Type`。
isKindWithCtx : Ctx -> Ec -> Value -> Bool
isKindWithCtx ctx ec v = isKindWithCtxFuel 64 ctx ec v

isKindWithCtxFuel : Int -> Ctx -> Ec -> Value -> Bool
isKindWithCtxFuel fuel ctx ec v = if fuel <= 0 then False
else case forceVal ec v of
  VType l => True
  VPi _ _ _ d clo =>
    isTypeLikeWithCtx fuel ctx ec d
      && isKindWithCtxFuel (fuel - 1) ctx ec (applyClosure clo (VNeutral (NVar "kind" 0 [])))
  _ => False

-- 值是不是「类型/类型构造子」（可以当 kind 的域）。
-- 中性类型变量（`a : Type`）与类型构造子变量（`f : Type -> Type`）算；`n : Nat` 这类
-- 值变量不算；未解元变量放行（由后续合一与擦除检查兜底）。
isTypeLikeWithCtx : Int -> Ctx -> Ec -> Value -> Bool
isTypeLikeWithCtx fuel ctx ec v = if fuel <= 0 then False
else case forceVal ec v of
  VType l => True
  VPi _ _ _ d clo =>
    isTypeLikeWithCtx (fuel - 1) ctx ec (applyClosure clo (VNeutral (NVar "ty" 0 [])))
  VNeutral n => case n of
    NVar name lvl sp => case neutralBinderType ctx ec lvl of
      Just tyVal => isTypeDomain tyVal
      Nothing => False
    NGlobal g sp => isDataHead (ecDatas ec) v
    _ => False
  VMeta m sp => True
  _ => False

ctxItemAt : Int -> List (Pair String Term) -> Maybe (Pair String Term)
ctxItemAt i [] = Nothing
ctxItemAt i (x :: rest) = if i <= 0 then Just x else ctxItemAt (i - 1) rest

-- ---------------------------------------------------------------
-- 擦除判据（M18.5 起全仓唯一入口；M28 收成一个谓词）
-- ---------------------------------------------------------------
-- 规则：隐式 / 类型层 binder 擦除（rig 0）；显式 binder 按 quantity：`0` 擦除、`1`/ω 保留。
-- 显式索引 `(n : Nat)` 未标注时是 ω（保留，`vlen` 能读回来）；写成隐式才擦除。
-- M38 起 quantity 由 `rigOfQty` 决定；
-- 用量检查在 `Elab.Usage`（精化后），这里只算擦除 rig。
--
-- `isTypeDomain` 是**唯一的域判据**：宇宙 `Type n`，或「每个域都是类型层的 Pi 链」
-- （`Type -> Type` 这类高阶 kind）。判据必须递归：值层函数类型 `a -> b` 也是 Pi，但它的
-- 域是类型变量而不是宇宙，不能被误判（否则函数参数会被擦掉）。`isTypeValue` 是它的
-- 特例（VType 是空 Pi 链）；M28 之前 `binderRig` 只查裸 `Type`、`typeLayerRig` 才查
-- Pi 链，两个判据在显式高阶类型参数上漂移，现在统一走这里。
-- `binderRig` 是**唯一的 Rig 构造入口**：`teleOf` / `checkBinders` / `bindOnePattern` /
-- `checkLam` / `inferArgs` / `bindCtorBinder` 六处都必须走它。
isTypeDomain : Value -> Bool
isTypeDomain v = isTypeLayerValue v

binderRig : Bool -> Value -> Rig
binderRig implicit dom = rigOfBinder implicit (isTypeDomain dom)

-- M38：源码 quantity → Rig（唯一映射；隐式/类型层域强制 0，标注由上层校验）。
rigOfQty : Bool -> Bool -> Maybe Qty -> Rig
rigOfQty implicit isTypeDom qty = if implicit || isTypeDom then Rig0
else case qty of
  Nothing => RigOmega
  Just Q0 => Rig0
  Just Q1 => Rig1

-- ---------------------------------------------------------------
-- 类型族 kind 与表现层 cast：不可命名的擦除依赖类型（D27 / effects.md §5–§6）
-- ---------------------------------------------------------------
--
-- 运行时类型里出现「卡住的类型族应用」（如 `res op`）时，OCaml 侧无法命名它：
--   * 声明位置（data 字段）→ `Codegen.Decl` 渲染成不透明运行时值（`Obj.t`）；
--   * 表达式位置（binder）→ 每个使用点包 `prim_erase`（运行时 `%identity`，求值期
--     归约成实参本身，对定义性相等透明）。
-- 判据与 `Codegen.Decl` 同源：`valueOpaqueScoped` + 同一「可表示类型头」表。
-- 类型族有两种来源：全局类型头不可表示（类型族定义 / axiom），或**类型族参数**
-- （kind 的 Pi 链里出现非宇宙域，如 `res : f -> Type`）。普通类型构造子参数
-- （`m : Type -> Type`）仍然可表示，字典方法字段 / base 泛型代码不受影响。
-- 运行时不可命名的全局类型头：不是该程序的数据族，也不是 primitive / 内建类型构造子。
isTypeHeadOpaqueEc : Ec -> String -> Bool
isTypeHeadOpaqueEc ec name = not (isDataFamilyName ec name) && not (isTypeConstructorName name)

-- kind 判定：Pi 链里出现非宇宙域 ⇒ 类型族参数（由值决定类型，运行时不可命名）。
isFamilyKindValue : Value -> Bool
isFamilyKindValue v = isFamilyKindFuel 64 v

isFamilyKindFuel : Int -> Value -> Bool
isFamilyKindFuel fuel v = if fuel <= 0 then False
else case v of
  VPi name implicit rig dom clo =>
    not (isUniverseValue dom)
      || isFamilyKindFuel (fuel - 1) (applyClosure clo (VNeutral (NVar name 0 [])))
  _ => False

isUniverseValue : Value -> Bool
isUniverseValue (VType _) = True
isUniverseValue _ = False

-- 通用结构遍历：
--   * `depth` 是已进入的 Pi binder 数；`lvl < depth` 的 NVar 由 `outerNVar` 判定
--     （表达式位置查 ctx；声明位置查已判定的 telescope 类型族参数集）；
--   * 类型内部的 Pi binder 若其 kind 是类型族参数，把它的 level 记进 `famLevels`。
valueOpaqueScoped : (Int -> Bool) -> (String -> Bool) -> Int -> List Int -> Value -> Bool
valueOpaqueScoped outerNVar headOpaque depth famLevels v =
  valueOpaqueGo 128 outerNVar headOpaque depth famLevels v

valueOpaqueGo : Int -> (Int -> Bool) -> (String -> Bool) -> Int -> List Int -> Value -> Bool
valueOpaqueGo fuel outerNVar headOpaque depth famLevels v = if fuel <= 0 then True
else case v of
  VType _ => False
  -- 已知边界：精化期未解 meta 视为可表示（否则隐式实参实例化会触发大量 cast）；
  -- 最终解成类型族时可能漏 cast，见 docs/reference/debt.md（D27 残留）。
  VMeta _ _ => False
  VNeutral n => case n of
    NVar name lvl sp =>
      if lvl < depth then outerNVar lvl else if memLevel lvl famLevels then True else False
    NGlobal g sp =>
      headOpaque g || valueOpaqueTypeSpine fuel outerNVar headOpaque depth famLevels sp
  VPi name implicit rig dom clo =>
    let
      fam2 = if isFamilyKindValue dom then depth :: famLevels else famLevels
    in valueOpaqueGo (fuel - 1) outerNVar headOpaque depth famLevels dom
      || valueOpaqueGo (fuel - 1) outerNVar headOpaque (depth + 1) fam2 (applyClosure clo (VNeutral (NVar name depth [])))
  -- 类型族展开后卡住的形态（VCase/VIf 悬挂在中性值上）、以及不可能出现在类型位置
  -- 的构造子/字面量：都不可命名。
  _ => True

valueOpaqueTypeSpine : Int -> (Int -> Bool) -> (String -> Bool) -> Int -> List Int -> List Value -> Bool
valueOpaqueTypeSpine fuel outerNVar headOpaque depth famLevels sp = if fuel <= 0 then True
else case sp of
  [] => False
  v :: rest =>
    isTypeishValue v && valueOpaqueGo (fuel - 1) outerNVar headOpaque depth famLevels v
      || valueOpaqueTypeSpine (fuel - 1) outerNVar headOpaque depth famLevels rest

-- 类型实参 vs 索引值实参：数据族 / 内建类型构造子的值实参（`Vec (Succ n) a` 的
-- `Succ n`）是擦除后的索引，不进 OCaml 类型，不参与「不可命名」判定。
isTypeishValue : Value -> Bool
isTypeishValue (VType _) = True
isTypeishValue (VPi _ _ _ _ _) = True
isTypeishValue (VNeutral _) = True
isTypeishValue (VMeta _ _) = True
isTypeishValue _ = False

memLevel : Int -> List Int -> Bool
memLevel i [] = False
memLevel i (x :: rest) = if x == i then True else memLevel i rest

-- 表达式位置：外层 ctx binder 的类型族参数判定（kind 从 ctx 取）。
nvarOpaqueCtx : Ctx -> Int -> Bool
nvarOpaqueCtx ctx lvl =
  let
    idx = ctxDepth ctx - 1 - lvl
  in if idx < 0 then False
  else case ctxItemAt idx ctx.ctxItems of
    Just (Pair name ty) => isFamilyKindValue (varTypeValue ctx idx ty)
    Nothing => False

-- 只解元变量、不做 delta：判据必须与 codegen（看不到定义展开）保持同一视角，
-- 否则「声明成 Obj.t、使用处却因 delta 归约没 cast」会错配。
zonkValueOnly : Ec -> Value -> Value
zonkValueOnly ec v = force (Base.HashMap.fromList []) (ecSolsP ec) defaultFuel v

isOpaqueRuntimeTyIn : Ec -> Ctx -> Value -> Bool
isOpaqueRuntimeTyIn ec ctx v =
  valueOpaqueScoped (nvarOpaqueCtx ctx) (isTypeHeadOpaqueEc ec) (ctxDepth ctx) []
    (zonkValueOnly ec v)

castErased : Term -> Term
castErased t = TApp (TGlobal primEraseName) t Rig1

-- 把 root-relative 索引集合对应的 binder 的自由使用逐个包 cast。
-- de Bruijn：目标 binder 在深度 d 下的出现是 `idx + d`；嵌套 binder 只增加深度、
-- 不改变 cast 后的索引（cast 只包住原有 TVar，不移动作用域）。
wrapOpaqueUses : List Int -> Term -> Term
wrapOpaqueUses idxs t = wrapOpaqueUsesFuel 512 0 idxs t

wrapOpaqueUsesFuel : Int -> Int -> List Int -> Term -> Term
wrapOpaqueUsesFuel fuel depth idxs t = if fuel <= 0 then t
else case t of
  TVar name i => wrapOpaqueVar depth idxs name i
  TGlobal name => TGlobal name
  TMeta m => TMeta m
  TType l => TType l
  TInt n => TInt n
  TStr s => TStr s
  TFloat raw => TFloat raw
  TBool b => TBool b
  TPi name implicit rig dom cod =>
    TPi name implicit rig (wrapOpaqueUsesFuel (fuel - 1) depth idxs dom)
      (wrapOpaqueUsesFuel (fuel - 1) (depth + 1) idxs cod)
  TLam name rig body => TLam name rig (wrapOpaqueUsesFuel (fuel - 1) (depth + 1) idxs body)
  TApp f a rig =>
    TApp (wrapOpaqueUsesFuel (fuel - 1) depth idxs f) (wrapOpaqueUsesFuel (fuel - 1) depth idxs a)
      rig
  TCon c args =>
    TCon c
      (map (\p => Pair (wrapOpaqueUsesFuel (fuel - 1) depth idxs (firstOf p)) (secondOf p)) args)
  TCase scrut alts =>
    TCase (wrapOpaqueUsesFuel (fuel - 1) depth idxs scrut)
      (map (\alt => wrapOpaqueAltFuel (fuel - 1) depth idxs alt) alts)
  TIf c th el =>
    TIf (wrapOpaqueUsesFuel (fuel - 1) depth idxs c) (wrapOpaqueUsesFuel (fuel - 1) depth idxs th)
      (wrapOpaqueUsesFuel (fuel - 1) depth idxs el)

wrapOpaqueVar : Int -> List Int -> String -> Int -> Term
wrapOpaqueVar depth idxs name i =
  if i < depth then TVar name i
  else if memLevel (i - depth) idxs then castErased (TVar name i) else TVar name i

wrapOpaqueAltFuel : Int -> Int -> List Int -> CaseAlt -> CaseAlt
wrapOpaqueAltFuel fuel depth idxs (CaseAlt name binders body) =
  CaseAlt name binders (wrapOpaqueUsesFuel (fuel - 1) (depth + length binders) idxs body)

-- M38：线性类型判定（结构保守）：线性族头，或非线性的类型应用带线性实参。
isLinearType : Ec -> Value -> Bool
isLinearType ec v = if ecHasLinear ec then isLinearTypeFuel 64 ec v else False

isLinearTypeFuel : Int -> Ec -> Value -> Bool
isLinearTypeFuel fuel ec v = if fuel <= 0 then False
else case forceVal ec v of
  VNeutral n => case n of
    NGlobal g sp => dataLinearName ec g
    NVar name lvl sp => False
  VCon c args => ctorLinearName ec c
  _ => False

anyLinearVals : Int -> Ec -> List Value -> Bool
anyLinearVals fuel ec [] = False
anyLinearVals fuel ec (v :: rest) = isLinearTypeFuel fuel ec v || anyLinearVals fuel ec rest

dataLinearName : Ec -> String -> Bool
dataLinearName ec g = case dtDataLookup g (ecDatas ec) of
  Just d => dtDataLinear d
  Nothing => False

ctorLinearName : Ec -> String -> Bool
ctorLinearName ec c = case dtCtorLookupEc ec c of
  Just ctor => dataLinearName ec (dtCtorFamily ctor)
  Nothing => False

-- M38：Pi 域若线性，binder 必须是 1；否则保留声明量。
rigForLinearDomain : Ec -> Span -> String -> Rig -> Value -> Result Rig
rigForLinearDomain ec sp name rig dom = if isLinearType ec dom then case rig of
  Rig1 => Ok Rig1
  _ => tcErr1 sp (LinearValueNeedsLinearBinder name) name
else Ok rig

-- case 分支字段：线性域强制 1（构造侧已经检查过；这里防御旧值/unsafe）。
rigCaseField : Ec -> Value -> Rig -> Rig
rigCaseField ec dom rig = if isLinearType ec dom then Rig1 else rig

-- let 绑定：线性值必须按 1 绑定；其余默认 ω。
rigOfLinearValue : Ec -> Value -> Rig
rigOfLinearValue ec dom = if isLinearType ec dom then Rig1 else RigOmega

-- 外层 context 是否含线性类型（决定是否需要对 λ body 做捕获扫描）。
ctxHasLinear : Ec -> Ctx -> Bool
ctxHasLinear ec (Ctx items refs) = ctxHasLinearItems ec (Ctx items refs) items 0

ctxHasLinearItems : Ec -> Ctx -> List (Pair String Term) -> Int -> Bool
ctxHasLinearItems ec ctx [] i = False
ctxHasLinearItems ec ctx ((Pair name ty) :: rest) i =
  isLinearType ec (varTypeValue ctx i ty) || ctxHasLinearItems ec ctx rest (i + 1)

-- λ body 是否引用了外层（非本 λ binder）的线性值。ctx 传当前 binder 已入栈的上下文；
-- 变量 index 与 ctx 的对应：depth 个内层 binder 之后，i > depth 才指向 ctx。
termHasOuterLinear : Ec -> Ctx -> Term -> Bool
termHasOuterLinear ec ctx t = outerScan ec ctx 0 t

outerScan : Ec -> Ctx -> Int -> Term -> Bool
outerScan ec ctx depth (TVar name i) = if i > depth then case ctxItemAt (i - depth) ctx.ctxItems of
  Just (Pair n ty) => isLinearType ec (varTypeValue ctx (i - depth) ty)
  Nothing => False
else False
outerScan ec ctx depth (TPi n i r dom cod) = False
outerScan ec ctx depth (TLam n r b) = outerScan ec ctx (depth + 1) b
outerScan ec ctx depth (TApp f a r) = outerScan ec ctx depth f || outerScan ec ctx depth a
outerScan ec ctx depth (TCon c args) = outerScanArgs ec ctx depth args
outerScan ec ctx depth (TCase s alts) = outerScan ec ctx depth s || outerScanAlts ec ctx depth alts
outerScan ec ctx depth (TIf c th el) =
  outerScan ec ctx depth c || outerScan ec ctx depth th || outerScan ec ctx depth el
outerScan ec ctx depth t = False

outerScanArgs : Ec -> Ctx -> Int -> List (Pair Term Rig) -> Bool
outerScanArgs ec ctx depth [] = False
outerScanArgs ec ctx depth ((Pair a r) :: rest) =
  outerScan ec ctx depth a || outerScanArgs ec ctx depth rest

outerScanAlts : Ec -> Ctx -> Int -> List CaseAlt -> Bool
outerScanAlts ec ctx depth [] = False
outerScanAlts ec ctx depth ((CaseAlt n bs b) :: rest) =
  outerScan ec ctx (depth + natToInt (length bs)) b || outerScanAlts ec ctx depth rest

isTypeLayerValue : Value -> Bool
isTypeLayerValue v = isTypeLayerValueFuel 128 v

isTypeLayerValueFuel : Int -> Value -> Bool
isTypeLayerValueFuel fuel v = if fuel <= 0 then False
else case v of
  VType l => True
  VPi pname implicit rig dom clo =>
    isTypeLayerValueFuel (fuel - 1) dom
      && isTypeLayerValueFuel (fuel - 1) (applyClosure clo (VNeutral (NVar pname 0 [])))
  _ => False

isDataHead : List DtData -> Value -> Bool
isDataHead datas (VNeutral n) = case n of
  NGlobal g sp => case dtDataLookup g datas of
    Just _ => True
    Nothing => False
  _ => False
isDataHead datas _ = False

freshVarValue : String -> Int -> Value
freshVarValue name level = VNeutral (NVar name level [])

-- ---------------------------------------------------------------
-- 双向检查
-- ---------------------------------------------------------------
-- `if` 条件 / `Bool` 判定：只认 canonical `Base.Bool.Bool`（`NGlobal boolTypeName`）。
isBoolType : Value -> Bool
isBoolType (VNeutral n) = isBoolGlobal (neutralHeadName n)
isBoolType _ = False

neutralHeadName : Neutral -> String
neutralHeadName (NVar name _ _) = name
neutralHeadName (NGlobal name _) = name

isBoolGlobal : String -> Bool
isBoolGlobal name = name == boolTypeName

-- 名字既是构造子又是数据类型（如 `data Pair a b where Pair : a -> b -> Pair a b`）：
-- 在类型位置（expected 是宇宙）应走 `checkAppGeneral`，值位置走 `checkAppCtor`。
isSortVal : Ec -> Value -> Bool
isSortVal ec v = case forceVal ec v of
  VType _ => True
  _ => False

-- 引用一个名字：零参构造子必须直接是 TCon（否则求值器给不出 VCon，case 命不中）。
-- M23：**运行时零参**的构造子（telescope 只剩擦除 binder，如 `Nil : {a : Type} -> List a`）
-- 走 `inferCtorRef` 的 `nullaryCtorTerm`——那里能拿到实例化隐式参数用的元变量项，
-- 保证 `TCon` 实参与 telescope 逐位对齐（求值器的 VCon 依赖这个对齐）。
-- M29（B13/D12）：**非零参**构造子的**未饱和引用**做 η 展开（`etaCtorTerm`），不再留
-- `TGlobal`——见 `etaCtorTerm` 注释。
ctorRefTerm : List DtData -> String -> Term
ctorRefTerm datas name = case dtCtorLookup name datas of
  Just ctor =>
    if isBoolFamilyName (dtCtorFamily ctor) then boolCtorTerm (dtCtorName ctor)
    else if length (dtCtorTelescope ctor) == 0 then TCon name [] else etaCtorTerm ctor []
  Nothing => TGlobal name

-- 构造子应用必须饱和成 TCon，求值器才能给 case 造出 VCon（中性 NGlobal 命不中分支）。
-- M29（B13/D12）：未饱和应用做 η 展开（与 `ctorRefTerm` 共用 `etaCtorTerm`），
-- 否则「构造子当函数值传递」会留 TGlobal 脊：精化期 conv 与 VCon 对不上、
-- codegen 也会把裸构造子名当运行期值输出（OCaml 报 should not be a constructor）。
ctorAppTerm : List DtData -> Term -> List (Pair Term Rig) -> Term
ctorAppTerm datas (TGlobal g) args = case dtCtorLookup g datas of
  Just ctor =>
    if isBoolFamilyName (dtCtorFamily ctor) then boolCtorTerm g
    else if length args >= length (dtCtorTelescope ctor) then TCon g args else etaCtorTerm ctor args
  Nothing => foldAppTerms (TGlobal g) args
ctorAppTerm datas fn args = foldAppTerms fn args

-- M29（B13/D12）：构造子**未饱和**引用/应用的 η 展开。
--
-- `cong ... Succ ...` 这类「把构造子当函数值传」原先留 `TGlobal`：求值成 `NGlobal` 脊，
-- 与饱和应用产生的 `VCon` 在 conv 里对不上（报 `expected (Succ n), got (Succ n)`，
-- `Elab/Case.vuna` 的 `ctorValueIn` 用 `_tele` 名字可见）；且 codegen 把裸构造子名
-- 当运行期值输出，OCaml 报 `This expression should not be a constructor`。
-- 这里按 telescope 补 λ：`Succ` ⇒ `\x -> Succ x`、`Cons a` ⇒ `\n -> \x -> \xs -> Cons a n x xs`，
-- 于是精化期 β 归约直接得到 `VCon`，运行期得到合法闭包。
-- 已收到的实参先 `shift` 到 λ 之下（外层 de Bruijn 索引整体 +k）；零参与饱和应用不变。
etaCtorTerm : DtCtor -> List (Pair Term Rig) -> Term
etaCtorTerm ctor args =
  let
    rest = dropCount (length args) (dtCtorTelescope ctor)
    k = length rest
  in etaCtorLa (dtCtorName ctor) 0 rest (shiftCtorArgs k args)

-- 把构造子已收到的实参搬到 k 个 λ 之下（外层 de Bruijn 索引整体 +k）。
shiftCtorArgs : Int -> List (Pair Term Rig) -> List (Pair Term Rig)
shiftCtorArgs n [] = []
shiftCtorArgs n ((Pair a rig) :: rest) = Pair (shift 0 n a) rig :: shiftCtorArgs n rest

-- 逐层搭 λ：第 i 个剩余形参在最终体里的 de Bruijn 索引 = 剩余 binder 数 - 1。
-- binder 名必须**唯一**（用 `#eta<i>`）：telescope 里的匿名字段名都是 `_`，codegen 按
-- binder 名渲染 OCaml 变量、不做 shadow 规避——两个 `_` 都被渲染成 `_u`，体里同时引用
-- 两个形参就会互相捕获（实测 OCaml 类型错误 `'a t_List` vs `'a t_List t_List`）。
-- `#` 不是源码标识符字符（sanitize 成 `_h`），因此不会和用户变量撞名。
etaCtorLa : String -> Int -> List (Pair String Rig) -> List (Pair Term Rig) -> Term
etaCtorLa name i [] args = TCon name args
etaCtorLa name i ((Pair _ rig) :: rest) args =
  let
    binder = "#eta${i}"
  in TLam binder rig (etaCtorLa name (i + 1) rest (append args [Pair (TVar binder (length rest)) rig]))

-- 丢掉列表前 n 个元素（构造子已收到的实参前缀）。
dropCount : Int -> List a -> List a
dropCount n xs = if n <= 0 then xs
else case xs of
  [] => []
  _ :: rest => dropCount (n - 1) rest

foldAppTerms : Term -> List (Pair Term Rig) -> Term
foldAppTerms fn [] = fn
foldAppTerms fn ((Pair arg erased) :: rest) = foldAppTerms (TApp fn arg erased) rest

-- 构造子类型是否已**显式写出**族参数 binder。
-- 判据是「首个 EPi 的 binder 有名字」（显式 `(a : Type) ->` 或隐式 `{a : Type} ->`）：
-- 这类构造子自己绑定了族参数，不能再前置一份（否则出现重复 binder，codegen 的
-- 运行时类型参数表与构造子 telescope 对不上）。record 降级生成的构造子类型用
-- 匿名显式 `EPi "_" False` 写字段，因此仍要走 `prependFamParams`。
hasFamParams : Expr -> Bool
hasFamParams (EPi n implicit _ dom cod sp) = n /= "_"
hasFamParams _ = False

-- 模块限定名的最后一段（`Base.Monad.fmap` → `fmap`）。
baseNameOf : String -> String
baseNameOf name = case splitLastDot (splitOnDot name) of
  Pair rev base => base

-- M22.2：构造子名 → 族的全部构造子（`Elab.Match` 的模式矩阵用它判断「这一列的构造子
-- 是否已经全覆盖」——全覆盖时不再补通配兜底，避免把剩余列的匹配不全暴露成假覆盖）。
ctorFamilyTable : Ec -> List (Pair String (List String))
ctorFamilyTable ec = map (\d => Pair (dtDataName d) (map dtCtorName (dtDataCtors d))) (ecDatas ec)

-- 后续分支里的兜底体（`case` 最后一个变量/通配分支），供嵌套模式的折叠使用。
findCatchAllBody : List (Pair Pat Expr) -> Maybe Expr
findCatchAllBody [] = Nothing
findCatchAllBody ((Pair pat body) :: rest) = case pat of
  PCon cname args psp => findCatchAllBody rest
  _ => Just body
