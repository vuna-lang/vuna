  ( addEdgeMode
  , allEqTo
  , allSame
  , argPositive
  , argRel
  , arithMinus
  , arithMinusBase
  , arithRel
  , clausesOfDef
  , computePosFacts
  , computePosFactsStep
  , ctorNameOf
  , ctorNamesOf
