module Vuna.Compiler.Elab.Representation
  ( UnboxedCand(..)
  , ctorFieldDomainTerm
  , ctorKeepFlags
  , findDtData
  , isSpecialUnboxFamily
  , keptIndices
  , lookupUnboxedInfo
  , termIsFunction
  , termRepresentable
  , unboxedFamilySet
  , unboxedInfoOf
  ) where

-- Vuna.Compiler.Elab.Representation：表示判定的单一真源（R1：声明优先，推断回落）。
-- `ReprBoxed` 强制装箱；`ReprAlias` 强制去装箱（仍要求单保留字段形状）；
-- `ReprAuto` 未声明，回落自动去装箱推断（R1 过渡；终态删除推断）。
-- 这里只做结构与类型项判定，不依赖 Codegen：`Elab` 用它做 via-field 的表示校验，
-- `Codegen.Decl` 用它生成类型别名 / 恒等构造 / case 绑定。判据见 `unboxedCandidateOfData`。
--
-- 这里只做结构与类型项判定，不依赖 Codegen：`Elab` 用它做 via-field 的表示校验，
-- `Codegen.Decl` 用它生成类型别名 / 恒等构造 / case 绑定。判据见 `unboxedCandidateOfData`。
import Vuna.Compiler.Common
import Vuna.Compiler.Core
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Intrinsics

-- | 自动去装箱候选：族名、唯一保留字段所在的构造子，以及该字段在完整 telescope 中的下标。
record UnboxedCand where
  unboxedCandName : String
  unboxedCandCtor : DtCtor
  unboxedCandIndex : Int

-- | 候选的族名。
unboxedCandName : UnboxedCand -> String
unboxedCandName (UnboxedCand name ctor idx) = name

-- | 候选的唯一构造子。
unboxedCandCtor : UnboxedCand -> DtCtor
unboxedCandCtor (UnboxedCand name ctor idx) = ctor

-- | 保留字段在构造子完整 telescope 中的下标。
unboxedCandIndex : UnboxedCand -> Int
unboxedCandIndex (UnboxedCand name ctor idx) = idx

-- 构造子字段形状唯一真源：True = 该 binder 进运行时表示。
-- | 构造子字段形状的唯一真源：为每个 telescope binder 标出是否进入运行时表示（未擦除）。
ctorKeepFlags : DtCtor -> List Bool
ctorKeepFlags c = map (\b => not (rigIsErased (secondOf b))) (dtCtorTelescope c)

-- | 从 keep 标志列表里取出所有保留位置的下标（从 0 开始）。
keptIndices : List Bool -> List Int
keptIndices flags = keptIndicesGo flags 0

-- | keptIndices 的带当前下标累积器实现。
keptIndicesGo : List Bool -> Int -> List Int
keptIndicesGo [] i = []
keptIndicesGo (k :: rest) i =
  if k then i :: keptIndicesGo rest (i + 1) else keptIndicesGo rest (i + 1)

-- | 是否为不可去装箱的内建族（Bool / Nat / Type 构造子）。
isSpecialUnboxFamily : String -> Bool
isSpecialUnboxFamily name =
  name == boolTypeName || name == natTypeName || isTypeConstructorName name

-- 按族名查 data（Representation 自包含，不依赖 Codegen）。
-- | 按族名在数据表里查 DtData；找不到返回 Nothing。
findDtData : String -> List DtData -> Maybe DtData
findDtData name [] = Nothing
findDtData name (d :: rest) = if dtDataName d == name then Just d else findDtData name rest

-- | 类型头是否为可命名类型（Int/Str/Bool/Nat、Type 构造子或已声明数据族）。
knownTypeHead : List DtData -> String -> Bool
knownTypeHead datas g = g == intTypeName || g == strTypeName || g == boolTypeName || g == natTypeName || isTypeConstructorName g || (case findDtData g datas of
  Just _ => True
  Nothing => False
)

-- 运行时字段类型是否可由现有字段渲染规则忠实命名（不做定义性展开）。
-- | 运行时字段类型能否由现有渲染规则忠实命名；函数与未知名保守拒绝。
termRepresentable : List DtData -> Term -> Bool
termRepresentable datas (TPi name implicit rig dom cod) =
  termRepresentable datas dom && termRepresentable datas cod
termRepresentable datas (TApp f a rig) = termAppHeadRepresentable datas f
termRepresentable datas (TGlobal g) = knownTypeHead datas g
-- R4：record 类型应用（`TRecord`）与 `TGlobal` 应用同判——看族头是否可命名。
termRepresentable datas (TRecord name args) = knownTypeHead datas name
termRepresentable datas (TVar name i _) = True
termRepresentable datas t = False

-- | 应用脊的头部是否为可命名类型（沿 App 递归剥到全局头）。
termAppHeadRepresentable : List DtData -> Term -> Bool
termAppHeadRepresentable datas (TGlobal g) = knownTypeHead datas g
termAppHeadRepresentable datas (TApp f a rig) = termAppHeadRepresentable datas f
termAppHeadRepresentable datas t = False

-- 构造子第 i 个 telescope binder 的域（0 基，按完整 telescope 计）。
-- | 取构造子第 i 个 telescope binder 的域（0 基，按完整 telescope 计）。
ctorFieldDomainTerm : DtCtor -> Int -> Maybe Term
ctorFieldDomainTerm c i = ctorFieldDomainTermGo 512 i (dtCtorType c)

-- | ctorFieldDomainTerm 的带 fuel 递归实现：沿 Pi 链走到第 i 个 binder。
ctorFieldDomainTermGo : Int -> Int -> Term -> Maybe Term
ctorFieldDomainTermGo fuel i t = if fuel <= 0 then Nothing
else case t of
  TPi name implicit rig dom cod =>
    if i <= 0 then Just dom else ctorFieldDomainTermGo (fuel - 1) (i - 1) cod
  _ => Nothing

-- 函数 / Pi 字段保持装箱：OCaml 值限制会让零参顶层定义的别名函数类型出现弱类型变量。
-- | 项是否为函数/Pi 类型（这类字段保持装箱，避免 OCaml 弱类型变量）。
termIsFunction : Term -> Bool
termIsFunction (TPi _ _ _ _ _) = True
termIsFunction _ = False

-- 判据（唯一真源）：
--   1. 恰好 1 个构造子；
--   2. `ctorKeepFlags` 恰好 1 个 True，且位置 >= 族参数/索引个数；
--   3. 字段类型可忠实命名（函数 / 未知名保守拒绝）；
--   4. 自身/互递归候选拒绝。
-- | R1：`ReprBoxed` 判定（不引入 Eq 实例）。
reprIsBoxed : ReprTier -> Bool
reprIsBoxed ReprBoxed = True
reprIsBoxed _ = False

-- R1：声明档位优先。`ReprBoxed` 永不去装箱；`ReprAlias` 与 `ReprAuto` 共用同一
-- 形状判据（R1 过渡：transparent 仍要求单保留字段 + 可表示；D52 落地后放开函数字段）。
-- | 判定单个数据族能否去装箱：特殊族、非 record、非单构造子、多保留字段、函数或
-- 未知名、递归候选都拒绝。R4：自动去装箱只服务 `record`；普通 `data` 恒装箱。
unboxedCandidateOfData : List DtData -> DtData -> List UnboxedCand
unboxedCandidateOfData datas d = if not (dtDataIsRecord d) then []
else if isSpecialUnboxFamily (dtDataName d) then []
else if reprIsBoxed (dtDataRepr d) then []
else case dtDataCtors d of
  [] => []
  c :: rest => case rest of
    [] => case keptIndices (ctorKeepFlags c) of
      [] => []
      i :: more => case more of
        [] => if i >= length d.dtDataParams then case ctorFieldDomainTerm c i of
          Just dom =>
            if termIsFunction dom then []
            else if termRepresentable datas dom then [UnboxedCand (dtDataName d) c i] else []
          Nothing => []
        else []
        _ => []
    _ => []

-- | 扫描全部数据族，收集所有可去装箱候选。
unboxedCandidates : List DtData -> List UnboxedCand
unboxedCandidates datas = concatMap (unboxedCandidateOfData datas) datas

-- | 取候选列表的族名列表。
candidateNames : List UnboxedCand -> List String
candidateNames cands = map unboxedCandName cands

-- | 为每个候选建一条「候选族名 → 它字段类型引用到的候选族名」的依赖边。
candidateEdges : List DtData -> List String -> List UnboxedCand -> List (Pair String (List String))
candidateEdges datas names cands =
  map (\cand => Pair (unboxedCandName cand) (candidateRefs datas names cand)) cands

-- | 候选保留字段类型里引用到的其它候选族名（用于递归检测）。
candidateRefs : List DtData -> List String -> UnboxedCand -> List String
candidateRefs datas names cand = case ctorFieldDomainTerm (unboxedCandCtor cand) (unboxedCandIndex cand) of
  Just dom => filter (\n => memName n names) (termGlobalNames dom)
  Nothing => []

-- | 在依赖邻接表里查某个节点的后继列表；未知节点返回空表。
lookupNeighbors : String -> List (Pair String (List String)) -> List String
lookupNeighbors name [] = []
lookupNeighbors name (p :: rest) =
  if firstOf p == name then secondOf p else lookupNeighbors name rest

-- | 沿候选依赖边做有界搜索，判断从 node 出发能否回到 target（燃料耗尽时保守判 True）。
reachesBackTo : Int -> List (Pair String (List String)) -> List String -> String -> String -> Bool
reachesBackTo fuel edges visited target node =
  if fuel <= 0 then True
  else anyReachBack (fuel - 1) edges visited target (lookupNeighbors node edges)

-- | reachesBackTo 的邻居遍历辅助：检查一组后继里是否有能回到 target 的路径。
anyReachBack : Int -> List (Pair String (List String)) -> List String -> String -> List String -> Bool
anyReachBack fuel edges visited target [] = False
anyReachBack fuel edges visited target (n :: rest) =
  if n == target then True
  else if memName n visited then anyReachBack fuel edges visited target rest
  else if fuel <= 0 then True
  else if reachesBackTo (fuel - 1) edges (n :: visited) target n then True
  else anyReachBack (fuel - 1) edges visited target rest

-- | 计算最终可去装箱的族到 (构造子, 保留字段下标) 的映射，滤掉自身或互递归候选。
unboxedInfoOf : List DtData -> List (Pair String (Pair DtCtor Int))
unboxedInfoOf datas =
  let
    cands = unboxedCandidates datas
    names = candidateNames cands
    edges = candidateEdges datas names cands
    fuel = length names + 2
  in map (\cand => Pair (unboxedCandName cand) (Pair (unboxedCandCtor cand) (unboxedCandIndex cand)))
    (filter (\cand => not (reachesBackTo fuel edges [unboxedCandName cand] (unboxedCandName cand) (unboxedCandName cand))) cands)

-- | 可去装箱族的名字集合（unboxedInfoOf 的键）。
unboxedFamilySet : List DtData -> List String
unboxedFamilySet datas = map firstOf (unboxedInfoOf datas)

-- | 在去装箱信息表里按族名查 (构造子, 下标)；未命中返回 Nothing。
lookupUnboxedInfo : String -> List (Pair String (Pair DtCtor Int)) -> Maybe (Pair DtCtor Int)
lookupUnboxedInfo name [] = Nothing
lookupUnboxedInfo name (p :: rest) =
  if firstOf p == name then Just (secondOf p) else lookupUnboxedInfo name rest
