module Vuna.Compiler.Elab.Term.Impl where

-- Vuna.Compiler.Elab.Term.Impl（M25.2c 拆分）：项检查的 fuel 版实现（组内互递归只经 *Fuel 名）。
import Base.List
import Vuna.Compiler.Common
import Base.Nat
import Vuna.Compiler.Core
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Elab.Case
import Vuna.Compiler.Elab.Dict
import Vuna.Compiler.Elab.Match
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.MetaSpans
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Elab.Records
import Vuna.Compiler.Intrinsics
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Term.Support
import Vuna.Compiler.Frontend.Ast

-- M28：规范形分支的单一精化入口。分支可达性统一问 `branchAfterUnify`（与覆盖率的
-- `branchVerdict` 用同一个判据）：不可达分支在精化分支体**之前**就报稳定诊断；可达分支
-- 里的错误就是真错误（不再有「体检查失败就改报 impossible branch」的兜底特判）。
-- 构造子分支 binder 的类型不可命名时（类型族参数出现在运行时位置），分支体里对它的
-- 每个使用包 `prim_erase`：OCaml 里同一个变量可能被不同分支/嵌套 case 推断成不同类型。
-- 返回 body 的 de Bruijn 索引（telescope 表面顺序 → 逆序）。
opaqueBranchIndices : Ec -> Ctx -> Int -> List (Pair String Rig) -> List Int
opaqueBranchIndices ec ctx n tele = opaqueBranchIndicesGo ec ctx n tele 0

opaqueBranchIndicesGo : Ec -> Ctx -> Int -> List (Pair String Rig) -> Int -> List Int
opaqueBranchIndicesGo ec ctx n [] j = []
opaqueBranchIndicesGo ec ctx n (binder :: rest) j =
  if branchBinderOpaque ec ctx (n - 1 - j) then Base.List.Cons (n - 1 - j) (opaqueBranchIndicesGo ec ctx n rest (j + 1))
  else opaqueBranchIndicesGo ec ctx n rest (j + 1)

branchBinderOpaque : Ec -> Ctx -> Int -> Bool
branchBinderOpaque ec ctx i = case ctxItemAt i ctx.ctxItems of
  Just (Pair name ty) =>
    let
      -- 分支 binder 的运行时表示由**构造子 telescope 的字段类型**决定（声明侧），
      -- 而不是 case 精化后的类型：`res x` 在具体索引下可能归约成 Int，但声明仍是
      -- 不透明值。所以这里用未代入 case 精化的类型求值。
      v = eval (ctxEnv ctx) (shift 0 (i + 1) ty)
      r = isOpaqueRuntimeTyIn ec ctx v
    in r
  Nothing => False

export elabConAltFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> DtData -> List Value -> Value -> Value -> String -> List Pat -> Span -> Expr -> Check (Pair CaseAlt Ec)
elabConAltFuel fuel globals ctx ec dd idxs scrutVal expected cname args psp body = if fuel <= 0 then icFuel "inference"
else case findCtorIn cname (dtDataCtors dd) of
  Nothing =>
    tcErr2 psp (UnknownConstructorInCase (ctorDisplayName cname) (dtDataName dd))
      (ctorDisplayName cname) (dtDataName dd)
  Just ctor => Vuna.Compiler.Common.bind (onErrDiag (withFallbackSpan psp) (bindCtorTele ctx (dtCtorType ctor) args)) (\p => case p of
    Pair branchCtx (Pair binders leftover) => if nonEmpty leftover then tcErr1 psp (BranchTooManyArgs (ctorDisplayName cname)) (ctorDisplayName cname)
    else Vuna.Compiler.Common.bind (onErrDiag (withFallbackSpan psp) (unifyIdxListSized ec [] (ctxDepth branchCtx) (ctorResultValsIn branchCtx ctor) (map (\v => refineValue [] defaultFuel v) idxs))) (\refsIdx => case branchAfterUnify ec branchCtx refsIdx of
      BranchImpossibleIndex => tcErr0 psp ImpossibleBranchIndex
      BranchImpossibleEmptyCtx => tcErr0 psp ImpossibleBranchEmptyCtx
      BranchOk => Vuna.Compiler.Common.bind (reflectScrutinee ec (ctxDepth branchCtx) refsIdx (ctorValueIn branchCtx ctor) scrutVal) (\refs2 => let
        refinedExpected = refineValue refs2 defaultFuel expected
        branchCtx2 = ctxRefine branchCtx refs2
      in Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals branchCtx2 ec body refinedExpected) (\pb => case pb of
        Pair bodyTerm ec2 =>
          let
            n = length binders
            opaqueIdxs = opaqueBranchIndices ec2 branchCtx2 n binders
            bodyTerm1 = wrapOpaqueUses opaqueIdxs bodyTerm
            bodyTerm2 =
              if isOpaqueRuntimeTyIn ec2 ctx expected then castErased bodyTerm1 else bodyTerm1
          in OkC (Pair (CaseAlt cname binders bodyTerm2) ec2)
      )
      )
    )
  )

export elabCaseAltsFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Value -> DtData -> List Value -> Value -> Value -> List (Pair Pat Expr) -> List CaseAlt -> Check (Pair (List CaseAlt) Ec)
elabCaseAltsFuel fuel globals ctx ec scrutTy dd idxs scrutVal expected [] acc =
  if fuel <= 0 then icFuel "inference" else OkC (Pair (reverse acc) ec)
elabCaseAltsFuel fuel globals ctx ec scrutTy dd idxs scrutVal expected (alt :: rest) acc = if fuel <= 0 then icFuel "inference"
else case alt of
  Pair pat body => case pat of
    PCon cname args psp => Vuna.Compiler.Common.bind (elabConAltFuel (fuel - 1) globals ctx ec dd idxs scrutVal expected cname args psp body) (\p => case p of
      Pair altTerm ec1 =>
        elabCaseAltsFuel (fuel - 1) globals ctx ec1 scrutTy dd idxs scrutVal expected rest
          (altTerm :: acc)
    )
    PVar pname psp =>
      elabCatchAllFuel (fuel - 1) globals ctx ec scrutTy dd idxs expected rest acc body pname psp
    PWild psp =>
      elabCatchAllFuel (fuel - 1) globals ctx ec scrutTy dd idxs expected rest acc body "_" psp
    _ => tcErr0 (patSpan pat) OnlyCtorPatterns

-- 兜底分支：只允许出现在最后；体在未精化的上下文里检查。
-- 内部用空名字标记兜底分支（Core / codegen 按空名字识别）。
-- M23：变量兜底分支要把变量按 scrutinee 的**类型**绑进上下文
-- （`case xs of [] => 0; ys => length ys`），否则分支体里的变量是未知名字。
export elabCatchAllFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Value -> DtData -> List Value -> Value -> List (Pair Pat Expr) -> List CaseAlt -> Expr -> String -> Span -> Check (Pair (List CaseAlt) Ec)
elabCatchAllFuel fuel globals ctx ec scrutTy dd idxs expected rest acc body pname psp = if fuel <= 0 then icFuel "inference"
else
  let
    ctx2 = if pname == "_" then ctx else ctxBindValue pname scrutTy ctx
  in if nonEmpty rest then tcErr0 psp CatchAllNotLast
  else Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx2 ec body expected) (\pb => case pb of
    Pair bodyTerm ec2 =>
      let
        -- 变量兜底要把变量作为分支 binder 记下来：Core 求值器与 codegen 都按 binder
        -- 绑定 scrutinee（旧实现丢 binder，体里引用变量会变成自由变量）。
        binds = if pname == "_" then [] else [Pair pname (rigOfLinearValue ec scrutTy)]
        -- 兜底 binder 是 scrutinee 类型；不可命名时同分支 binder 一样逐使用 cast。
        bodyTerm1 =
          if pname == "_" then bodyTerm
          else if isOpaqueRuntimeTyIn ec2 ctx scrutTy then wrapOpaqueUses [0] bodyTerm else bodyTerm
        bodyTerm2 = if isOpaqueRuntimeTyIn ec2 ctx expected then castErased bodyTerm1 else bodyTerm1
      in OkC (Pair (reverse (CaseAlt "" binds bodyTerm2 :: acc)) ec2)
  )

-- M28：case 的**唯一入口**，流程固定为三步：
--   ① 源级校验（`checkCaseAltsFlat`：兜底位置 / 重复构造子 / 重复字面量）——与家族无关；
--   ② 需要模式矩阵才能表达的分支形态（嵌套模式、需矩阵消解的重复构造子）先降级成矩阵
--      （`Elab.Match.multiToCaseExpr`）；矩阵生成的 case 天然是规范形，会再回到本入口走 ③；
--   ③ 规范形直接按 scrutinee 家族降低（Bool → if；Int/String → if 链；归纳族 → TCase）。
-- 没有第二条「去重降级」路径，也没有精化器内的嵌套模式折叠。
export checkCaseFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term Ec)
checkCaseFuel fuel globals ctx ec scrut alts expected sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec scrut) (\ps => case ps of
  Pair scrutTerm (Pair scrutTy ec1) => Vuna.Compiler.Common.bind (resolveOverAlts ec1 ctx scrutTy alts) (\q => case q of
    Pair alts2 ec2 =>
      Vuna.Compiler.Common.step (checkCaseAltsFlat ec2 alts2)
        (\_, ec3 => if needsMatrixCase alts2 then checkCaseMatrixFuel (fuel - 1) globals ctx ec3 scrut alts2 expected sp else checkCaseFamFuel (fuel - 1) globals ctx ec3 scrutTerm scrutTy alts2 expected sp)
  )
)

-- 哪些分支形态需要矩阵：嵌套模式（精化器不再自己折叠），以及校验后仍同名的构造子
-- （`Just (TStr s)` 之后的 `Just v`：第二条不是不可达，矩阵会让两条都可达）。
needsMatrixCase : List (Pair Pat Expr) -> Bool
needsMatrixCase alts = anyNestedPat alts || hasDupNames (altNames alts)

-- 去重/嵌套降级：let 绑定 scrutinee（只求值一次）→ 模式矩阵表达式 → 按规范形重新精化。
-- M28：位置名带**上下文深度**（`nd_scrut<depth>`）。矩阵生成的新鲜绑定名以位置名为前缀，
-- 而嵌套 case 会各自降级；若两层都用固定前缀，内层生成的 `_sc_...` 会与外层分支绑定
-- 同名（编译器源码 `binderHeadName` 的 `PTok (TIdent name) p => case ... of Just (PTok ...)`
-- 曾因此串位）。分支体在更深的作用域里检查，所以深度前缀保证不同层的名字不相交。
export checkCaseMatrixFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term Ec)
checkCaseMatrixFuel fuel globals ctx ec scrut alts expected sp = if fuel <= 0 then icFuel "inference"
else
  let
    name = "nd_scrut${ctxDepth ctx}"
    clauses = map (\alt => Pair [firstOf alt] (secondOf alt)) alts
  in Vuna.Compiler.Common.bind (multiToCaseExpr (ctorFamilyTable ec) clauses name)
    (\bodyExpr => checkEFuel (fuel - 1) globals ctx ec (ELet [Pair (PVar name sp) scrut] bodyExpr False sp) expected)

export checkCaseFamFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> Value -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term Ec)
checkCaseFamFuel fuel globals ctx ec scrutTerm scrutTy alts expected sp = if fuel <= 0 then icFuel "inference"
else case forceVal ec scrutTy of
  VNeutral (NGlobal fam idxs) => if fam == boolTypeName && length idxs == 0 then checkBoolCaseFuel (fuel - 1) globals ctx ec scrutTerm alts expected sp
  else if fam == natTypeName then if natLitCaseAlts alts then checkNatLitCaseFuel (fuel - 1) globals ctx ec (natToIntTerm scrutTerm) scrutTerm natTyValue alts
    expected sp
  else checkCaseOfFuel (fuel - 1) globals ctx ec scrutTerm scrutTy fam idxs alts expected sp
  else case fam of
    "Int" => checkLitCaseFuel (fuel - 1) globals ctx ec scrutTerm "Int" alts expected sp
    "String" => checkLitCaseFuel (fuel - 1) globals ctx ec scrutTerm "String" alts expected sp
    _ => checkCaseOfFuel (fuel - 1) globals ctx ec scrutTerm scrutTy fam idxs alts expected sp
  _ => tcErr0 sp NotInductiveFamily

-- M19：Bool 上的 case 降级成 if（`True` / `False` 是零参构造子形态的模式）。
export checkBoolCaseFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term Ec)
checkBoolCaseFuel fuel globals ctx ec scrutTerm alts expected sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (boolAltFuel (fuel - 1) globals ctx ec alts boolTrueCtor expected sp) (\p => case p of
  Pair trueBody (Pair catchAll ec1) => case catchAll of
    Just falseBody => OkC (Pair (TIf scrutTerm trueBody falseBody) ec1)
    Nothing => Vuna.Compiler.Common.bind (boolAltFuel (fuel - 1) globals ctx ec alts boolFalseCtor expected sp) (\q => case q of
      Pair falseBody (Pair _ ec2) => OkC (Pair (TIf scrutTerm trueBody falseBody) ec2)
    )
)

-- 取 `True` / `False` 分支的体；变量/通配分支作为两边的兜底。
export boolAltFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> String -> Value -> Span -> Check (Pair Term (Pair (Maybe Term) Ec))
boolAltFuel fuel globals ctx ec alts target expected sp =
  if fuel <= 0 then icFuel "inference"
  else boolAltGoFuel (fuel - 1) globals ctx ec alts target expected sp Nothing

export boolAltGoFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> String -> Value -> Span -> Maybe Term -> Check (Pair Term (Pair (Maybe Term) Ec))
boolAltGoFuel fuel globals ctx ec [] target expected sp catchAll = if fuel <= 0 then icFuel "inference"
else case catchAll of
  Just t => OkC (Pair t (Pair Nothing ec))
  Nothing => tcErr1 sp (NotExhaustive (ctorDisplayName target)) (ctorDisplayName target)
boolAltGoFuel fuel globals ctx ec (alt :: rest) target expected sp catchAll = if fuel <= 0 then icFuel "inference"
else case alt of
  Pair pat body => case pat of
    PCon cname args psp => if cname == target then Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 => OkC (Pair bodyTerm (Pair catchAll ec1))
    )
    else boolAltGoFuel (fuel - 1) globals ctx ec rest target expected sp catchAll
    PVar pname psp => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 =>
        boolAltGoFuel (fuel - 1) globals ctx ec rest target expected sp (Just bodyTerm)
    )
    PWild psp => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 =>
        boolAltGoFuel (fuel - 1) globals ctx ec rest target expected sp (Just bodyTerm)
    )
    _ => tcErr0 (patSpan pat) BoolCaseRestriction

-- M19：Int / String 上的字面量模式降级成嵌套 if。
-- `case n of 0 => a; 1 => b; x => c` 变成 `if n == 0 then a else if n == 1 then b else c`。
export checkLitCaseFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> String -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term Ec)
checkLitCaseFuel fuel globals ctx ec scrutTerm tyName alts expected sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (checkLitAltsFuel (fuel - 1) globals ctx ec scrutTerm tyName alts expected sp) (\p => case p of
  Pair term (Pair True ec1) => OkC (Pair term ec1)
  Pair term (Pair False ec1) => tcErr0 sp IntStringCaseNeedsFallback
)

-- Int / String 字面量列：每个字面量降成 `if n == lit then body else <rest>`；
-- 变量/通配分支提供 fallback（并且把变量绑进上下文，让用户在体里能用它）。
export checkLitAltsFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> String -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term (Pair Bool Ec))
checkLitAltsFuel fuel globals ctx ec scrutTerm tyName [] expected sp =
  if fuel <= 0 then icFuel "inference"
  else OkC (Pair (TIf (TBool False) (TInt 0) (TInt 0)) (Pair False ec))
checkLitAltsFuel fuel globals ctx ec scrutTerm tyName (alt :: rest) expected sp = if fuel <= 0 then icFuel "inference"
else case alt of
  Pair pat body => case pat of
    PInt n psp =>
      litAltStepFuel (fuel - 1) globals ctx ec scrutTerm tyName (TInt n) body rest expected sp
    PStr s psp =>
      litAltStepFuel (fuel - 1) globals ctx ec scrutTerm tyName (TStr s) body rest expected sp
    PVar pname psp => Vuna.Compiler.Common.bind (checkLitBoundVarFuel (fuel - 1) globals ctx ec scrutTerm tyName pname body expected sp) (\p => case p of
      Pair bodyTerm ec1 => OkC (Pair bodyTerm (Pair True ec1))
    )
    PWild psp => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 => OkC (Pair bodyTerm (Pair True ec1))
    )
    _ => tcErr0 (patSpan pat) IntStringCaseRestriction

-- 字面量分支：`if n == lit then body else <rest>`（rest 提供 fallback）。
export litAltStepFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> String -> Term -> Expr -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term (Pair Bool Ec))
litAltStepFuel fuel globals ctx ec scrutTerm tyName litTerm body rest expected sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec body expected) (\p => case p of
  Pair bodyTerm ec1 => Vuna.Compiler.Common.bind (checkLitAltsFuel (fuel - 1) globals ctx ec1 scrutTerm tyName rest expected sp) (\q => case q of
    Pair restTerm (Pair hasDefault ec2) =>
      OkC
        (Pair (TIf (TApp (TApp (TGlobal (litEqName tyName)) scrutTerm Rig1) litTerm Rig1) bodyTerm restTerm) (Pair hasDefault ec2))
  )
)

-- fallback 分支的体在「scrutinee 绑成该变量」的上下文里检查。
export checkLitBoundVarFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> String -> String -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkLitBoundVarFuel fuel globals ctx ec scrutTerm tyName name body expected sp = if fuel <= 0 then icFuel "inference"
else
  let
    -- M23：ctxBindValue 的第二个参数是**类型值**——这里绑 scrutinee 的类型，不是值本身。
    ctx2 = ctxBindValue name (VNeutral (NGlobal tyName [])) ctx
    rig = binderRig False (VNeutral (NGlobal tyName []))
  in Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx2 ec body expected) (\p => case p of
    -- 兜底变量必须真的绑到 scrutinee 上，否则体里对它的引用会指向不存在的 binder
    -- （擦除检查：index 落到别的 binder 上，报 type-level binding used at runtime）。
    Pair bodyTerm ec2 => OkC (Pair (TApp (TLam name rig bodyTerm) scrutTerm Rig1) ec2)
  )

-- D24：Nat 字面量模式（`case n of 0 => ...; 1 => ...; _ => ...`）。
-- Nat 运行时是 OCaml int，字面量列直接降成 `bi_eq_int (natToInt n) k` 的 if 链；
-- 变量兜底绑回**原始 Nat 项**。仅当全部模式都是 字面量/变量/通配 时走此路径，
-- 与构造子模式（`Zero` / `Succ k`）混用仍由构造子路径报限制。
natLitCaseAlts : List (Pair Pat Expr) -> Bool
natLitCaseAlts [] = True
natLitCaseAlts ((Pair pat body) :: rest) = case pat of
  PInt n sp => natLitCaseAlts rest
  PVar n sp => natLitCaseAlts rest
  PWild sp => natLitCaseAlts rest
  _ => False

checkNatLitCaseFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> Term -> Value -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term Ec)
checkNatLitCaseFuel fuel globals ctx ec cmpTerm bindTerm binderTy alts expected sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (checkNatLitAltsFuel (fuel - 1) globals ctx ec cmpTerm bindTerm binderTy alts expected sp) (\p => case p of
  Pair term (Pair True ec1) => OkC (Pair term ec1)
  Pair term (Pair False ec1) => tcErr0 sp IntStringCaseNeedsFallback
)

checkNatLitAltsFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> Term -> Value -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term (Pair Bool Ec))
checkNatLitAltsFuel fuel globals ctx ec cmpTerm bindTerm binderTy [] expected sp =
  if fuel <= 0 then icFuel "inference"
  else OkC (Pair (TIf (TBool False) (TInt 0) (TInt 0)) (Pair False ec))
checkNatLitAltsFuel fuel globals ctx ec cmpTerm bindTerm binderTy (alt :: rest) expected sp = if fuel <= 0 then icFuel "inference"
else case alt of
  Pair pat body => case pat of
    PInt n psp =>
      natLitAltStepFuel (fuel - 1) globals ctx ec cmpTerm bindTerm binderTy (TInt n) body rest
        expected sp
    PVar pname psp => Vuna.Compiler.Common.bind (checkNatLitBoundVarFuel (fuel - 1) globals ctx ec bindTerm binderTy pname body expected sp) (\p => case p of
      Pair bodyTerm ec1 => OkC (Pair bodyTerm (Pair True ec1))
    )
    PWild psp => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec body expected) (\p => case p of
      Pair bodyTerm ec1 => OkC (Pair bodyTerm (Pair True ec1))
    )
    _ => tcErr0 (patSpan pat) IntStringCaseRestriction

natLitAltStepFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> Term -> Value -> Term -> Expr -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term (Pair Bool Ec))
natLitAltStepFuel fuel globals ctx ec cmpTerm bindTerm binderTy litTerm body rest expected sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec body expected) (\p => case p of
  Pair bodyTerm ec1 => Vuna.Compiler.Common.bind (checkNatLitAltsFuel (fuel - 1) globals ctx ec1 cmpTerm bindTerm binderTy rest expected sp) (\q => case q of
    Pair restTerm (Pair hasDefault ec2) =>
      OkC
        (Pair (TIf (TApp (TApp (TGlobal "bi_eq_int") cmpTerm Rig1) litTerm Rig1) bodyTerm restTerm) (Pair hasDefault ec2))
  )
)

checkNatLitBoundVarFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> Value -> String -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkNatLitBoundVarFuel fuel globals ctx ec bindTerm binderTy name body expected sp = if fuel <= 0 then icFuel "inference"
else
  let
    ctx2 = ctxBindValue name binderTy ctx
    rig = binderRig False binderTy
  in Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx2 ec body expected) (\p => case p of
    Pair bodyTerm ec2 => OkC (Pair (TApp (TLam name rig bodyTerm) bindTerm Rig1) ec2)
  )

export checkCaseOfFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> Value -> String -> List Value -> List (Pair Pat Expr) -> Value -> Span -> Check (Pair Term Ec)
checkCaseOfFuel fuel globals ctx ec scrutTerm scrutTy fam idxs alts expected sp = if fuel <= 0 then icFuel "inference"
else case dtDataLookup fam (ecDatas ec) of
  Nothing => tcErr0 sp NotInductiveFamily
  Just dd => Vuna.Compiler.Common.bind (elabCaseAltsFuel (fuel - 1) globals ctx ec scrutTy dd idxs (evalCtx ctx scrutTerm) expected alts []) (\p => case p of
    Pair altTerms ec2 => checkCaseDone ec2 ctx dd idxs alts expected sp scrutTerm altTerms
  )

-- M19：case 出现在推断位置（函数实参、if 分支、let 的 value）。做法是建一个元变量当
-- 期望类型，再按检查模式处理 case——分支逐个 check 会把期望写进这个元变量。
export inferCaseEFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair Pat Expr) -> Span -> Check (Pair Term (Pair Value Ec))
inferCaseEFuel fuel globals ctx ec scrut alts sp = if fuel <= 0 then icFuel "inference"
else
  let
    pmeta = newMetaAt sp ctx ec
  in case pmeta of
    Pair metaTerm ec1 =>
      let
        metaTy = evalCtx ctx metaTerm
      in Vuna.Compiler.Common.bind (checkCaseFuel (fuel - 1) globals ctx ec1 scrut alts metaTy sp) (\p => case p of
        Pair term ec2 => OkC (Pair term (Pair metaTy ec2))
      )

-- `if` 条件：先按 prelude `Bool` 检查——保住 `==`/`/=` 的 Int/String **特化**
-- （推断位会把隐式类型实参留在 spine 上，运行时的 primReduce 归约不了）；失败再按
-- 推断收下真实 `Base.Bool.Bool` 条件（`Base.List.filter` 的 `if p x`）。
export checkCondBoolFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Span -> Check (Pair Term Ec)
checkCondBoolFuel fuel globals ctx ec c sp = if fuel <= 0 then icFuel "inference"
else case checkEFuel (fuel - 1) globals ctx ec c (VNeutral (NGlobal boolTypeName [])) of
  OkC pc => OkC pc
  ErrC _ => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec c) (\pc => case pc of
    Pair cTerm (Pair cTy ec1) =>
      if isBoolType cTy then OkC (Pair cTerm ec1)
      else errAt sp "if condition must be ${boolTypeName} (got ${showValueAt (ctxDepth ctx) cTy})"
  )

-- 变量解析顺序：局部上下文 → 本程序的数据构造子 → 全局签名。构造子必须排在全局之前：
-- 本程序数据构造子（canonical Bool 的 `Base.Bool.True/False` 精化成 `TBool`）先于全局签名。
-- ---------------------------------------------------------------
-- native-effects N1：`perform <op>` 降级（ND8/ND9）
-- ---------------------------------------------------------------
-- 族约定（D2）：op 族 `M.XxxOp`；标签 = 同族应用（按 kind 的显式参数个数 k 补洞）；res = `M.res<短名>`
-- ↔ 结果族 `M.resXxx`（本提交只做存在性协议校验）；key = op 族规范名。
-- 降级目标：`Base.Eff.performCore <n=洞> "<key>" (<M.Xxx> <n=洞>) <op>`；
-- 名字洞由 `{w : Member n e r}` 隐式求解从行条目合一解出，行里没有该条目即缺实例错误。
data PerfFamily : Type where
  PerfFamily : String -> String -> String -> PerfFamily

-- 短名：去掉 `Op` 后缀（`ConsoleOp` → `Console`）。
perfShortOf : String -> Maybe String
perfShortOf last = if endsWith "Op" last then
  let
    n = strLength last
  in if n > 2 then Just (substring 0 (Base.Nat.fromInt (n - 2)) last) else Nothing
else Nothing

perfFamilyOfCanonical : String -> Maybe PerfFamily
perfFamilyOfCanonical canon = case splitLastDot (splitOnDot canon) of
  Pair parts last => case perfShortOf last of
    Just short => Just (PerfFamily canon (joinDots parts) short)
    Nothing => Nothing

-- op 的类型值必须是全局 data 族的应用（`Base.EffConsole.ConsoleOp`、`StateOp Nat`）；
-- 族参数允许是中性 spine（State/Reader 的 s 由行/期望类型解），族名取 spine head。
perfFamilyOfValue : Ec -> Value -> Maybe PerfFamily
perfFamilyOfValue ec v = case forceVal ec v of
  VNeutral (NGlobal g _) => perfFamilyOfCanonical g
  _ => Nothing

-- `perform` 标记：`EApp (EVar @vuna@perform sp) [op] sp`。
performOperand : Expr -> Maybe (Pair Expr Span)
performOperand (EApp (EVar name sp) ([op]) asp) =
  if isPerformSyntax name then Just (Pair op asp) else Nothing
performOperand _ = Nothing

-- `@` 降级后的隐式实参标记：`EApp (EVar @vuna@inst@arg sp) [payload] sp`。
instArgOperand : Expr -> Maybe Expr
instArgOperand (EApp (EVar name _) ([payload]) _) =
  if isInstArgSyntax name then Just payload else Nothing
instArgOperand _ = Nothing

-- `@` 调用标记：`EApp (EVar @vuna@app@at sp) (f :: name :: args) sp`。
appAtOperand : Expr -> Maybe (Pair Expr (Pair Expr (List Expr)))
appAtOperand (EApp (EVar name _) (f :: nm :: rest) sp) =
  if isAppAtSyntax name then Just (Pair f (Pair nm rest)) else Nothing
appAtOperand _ = Nothing

-- `f@name args` 的 Elab 重写（纯函数）：`f (@vuna@inst@arg name) args`。
appAtCallExpr : Expr -> Check Expr
appAtCallExpr (EApp (EVar _ _) (f :: nm :: rest) sp) =
  OkC (EApp f (EApp (EVar instArgSyntax sp) [nm] sp :: rest) sp)
appAtCallExpr _ = icInternal "malformed @ marker"

qualifyShort : String -> String -> String
qualifyShort mod short = if mod == "" then short else "${mod}.${short}"

-- 由 op 的类型值构造降级调用表达式：`performCore <n=洞> "<key>" <op 族应用> <op>`。
-- 标签 = op 族应用，按显式参数个数（k）补洞：`ConsoleOp` k=0、`StateOp` k=1（族参数由行解）；
-- 标签与 op 同型（D2），`performCore` 的 `o : e` 直接由 op 值约束。
-- 纯函数（不递归、不调精化器），避免把大段逻辑塞进 inferEFuel 体内。
performCallExpr : List (Pair String Term) -> Ec -> Value -> Expr -> Span -> Check Expr
performCallExpr globals ec opTy op sp = case perfFamilyOfValue ec opTy of
  Nothing => tcErr1 sp (EffResFamilyMissing (showValueAt 6 opTy)) (showValueAt 6 opTy)
  Just (PerfFamily canon mod short) =>
    Vuna.Compiler.Common.bind (handleFamilyArityOf globals ec canon mod short sp)
      (\p => OkC (EApp (EVar "Base.Eff.performCore" sp) [EVar "_" sp, EStr canon sp, handleOpArg canon (secondOf p) sp, op] sp))

-- ---------------------------------------------------------------
-- 标记：`EApp (EVar "@vuna@handle") [comp, ret, opH]`（Ast.handleSyntax）。`opH` 是
-- `ELam [o, k] (ECase (EVar o) alts)` 的合成形态；族由 alts 的构造子推出来。
-- 两个降级目标（顺序 = base 侧签名）：
--   * `handleWith`：`n`/标签名是洞，由 `{w : Member n e r}` 行解；结果行 `rowRem n e r`
--     （条目可以在行中任意位置）。
--   * `handleWithAt`：被处理条目在 comp 的行首，名字取默认实例名，结果行就是剩下的行；
--     只在 check 位置 rowRem 版失败后重试（comp 是行多态表达式时用）。
-- 两版都按 `<Op> : <params…> -> Type` 推族参数个数（State/Reader k = 1，标签/结果族
-- 按 k 补洞；标签首参始终是实例名）。
handleOperand : Expr -> Maybe (Pair Expr (Pair Expr Expr))
handleOperand (EApp (EVar name _) ([comp, ret, opH]) _) =
  if isHandleSyntax name then Just (Pair comp (Pair ret opH)) else Nothing
handleOperand _ = Nothing

-- | op 子句构造子 → op 族：Loader 已把 pattern 里的构造子名解析成规范名或 over 名。
handleClauseFamily : Ec -> String -> Span -> Check String
handleClauseFamily ec cname sp =
  if isOverCtorName cname then Vuna.Compiler.Common.bind
    (resolveOverCtor ec sp Nothing (overCtorShort cname) (overCtorTargets cname))
    (\canon => handleFamilyOfCtor ec canon sp)
  else handleFamilyOfCtor ec cname sp

-- | 构造子规范名 → op 族（查 dt 构造子表）。
handleFamilyOfCtor : Ec -> String -> Span -> Check String
handleFamilyOfCtor ec cname sp = case ctorFamilyNameOf ec cname of
  Just fam => OkC fam
  Nothing => tcErr1 sp (UnknownName cname) cname

-- | op 子句 pattern → op 族。
handleClauseFamilyOfPat : Ec -> Pat -> Check String
handleClauseFamilyOfPat ec (PCon cname _ psp) = handleClauseFamily ec cname psp
handleClauseFamilyOfPat ec _ = icInternal "handle mirror case pattern is not a constructor"

-- | 所有 op 子句必须同族（ND10），跨族报 TC_HandleClauseFamilyMismatch。
handleCheckFamilies : Ec -> String -> List (Pair Pat Expr) -> Check String
handleCheckFamilies ec fam [] = OkC fam
handleCheckFamilies ec fam ((Pair pat _) :: rest) = case handleClauseFamilyOfPat ec pat of
  ErrC e => ErrC e
  OkC fam2 =>
    if fam2 == fam then handleCheckFamilies ec fam rest
    else tcErr2 (patSpan pat) (HandleClauseFamilyMismatch fam fam2) fam fam2

-- | 从 handle 的合成 case 分支推出 op 族。
handleClauseFamilies : Ec -> List (Pair Pat Expr) -> Check String
handleClauseFamilies ec [] = icInternal "handle marker has no operation clause"
handleClauseFamilies ec ((Pair pat _) :: rest) = case handleClauseFamilyOfPat ec pat of
  ErrC e => ErrC e
  OkC fam => handleCheckFamilies ec fam rest

-- | op 族 kind 的显式参数个数（链尾必须是 `Type`，且每个显式参数的域必须是宇宙）：
-- `ConsoleOp : Type` → 0，`StateOp : Type -> Type` → 1；`ExnOp : Row -> Type -> Type`
-- 的 `Row` 域在此被拒（Nothing）→ TC_HandleFamilyUnsupported（D54）。
handleOpArity : Term -> Maybe Int
handleOpArity (TPi name implicit rig dom cod) = if implicit then handleOpArity cod
else if isUniverseTerm dom then case handleOpArity cod of
  Just n => Just (n + 1)
  Nothing => Nothing
else Nothing
handleOpArity (TType _) = Just 0
handleOpArity _ = Nothing

-- | 宇宙域判定（op 族显式参数的域必须是 `Type`）。
isUniverseTerm : Term -> Bool
isUniverseTerm (TType _) = True
isUniverseTerm _ = False

-- | kind 里显式 Pi 的个数（不要求链尾是 `Type`；标签/结果族形状校验用）。
handleKindArity : Term -> Int
handleKindArity (TPi name implicit rig dom cod) =
  if implicit then handleKindArity cod else 1 + handleKindArity cod
handleKindArity _ = 0

-- | op 族参数（洞）：`?p1 … ?pk`。
handleHoleArgs : Int -> Span -> List Expr
handleHoleArgs k sp =
  if k <= 0 then Base.List.Nil else Base.List.Cons (EVar "_" sp) (handleHoleArgs (k - 1) sp)

-- | op 类型值：`<Op> ?p1 … ?pk`。
handleOpArg : String -> Int -> Span -> Expr
handleOpArg canon k sp =
  if k <= 0 then EVar canon sp else EApp (EVar canon sp) (handleHoleArgs k sp) sp

-- | 结果族 λ 的 binder 名（保留名，用户写不出）。
handleResBinder : String
handleResBinder = "@vuna@handle@res"

-- | 结果族包装值：`resFn (\o => res<Label> ?p1 … ?pk o)`。必须用 λ 现场解族参数
-- （`resState s op` 的 `s` 由 `o` 的类型定），不能直接传多态族名。
handleResArg : String -> Int -> Span -> Expr
handleResArg resName k sp =
  EApp (EVar "Base.Eff.resFn" sp)
    [ELam [handleResBinder] (EApp (EVar resName sp) (append (handleHoleArgs k sp) [EVar handleResBinder sp]) sp) sp]
    sp

-- | 降级调用构造：`headMode` 选 `handleWith`（rowRem 版）或 `handleWithAt`（行首条目版）。
handleCall : Bool -> String -> String -> Int -> Expr -> Expr -> Expr -> Span -> Expr
handleCall headMode canon resName k comp ret opH sp =
  let
    fnName = if headMode then "Base.Eff.handleWithAt" else "Base.Eff.handleWith"
    nameArg = if headMode then EStr effDefaultInstance sp else EVar "_" sp
  in EApp (EVar fnName sp)
    [nameArg, EStr canon sp, handleOpArg canon k sp, handleResArg resName k sp, comp, handleRetArg ret, opH]
    sp

-- | op 族的 kind：data 族优先（含导入模块），否则查 globals。
handleOpKind : List (Pair String Term) -> Ec -> String -> Maybe Term
handleOpKind globals ec canon = case dtDataLookup canon (ecDatas ec) of
  Just dd => Just (dtDataKind dd)
  Nothing => globalsLookup canon globals ec

-- | 缺 return 子句时补 `\x -> x`（哨兵由 parser 产生）。
handleDefaultRetBinder : String
handleDefaultRetBinder = "@vuna@handle@ret"

-- | ret 实参：无 return 子句的哨兵换成恒等 λ，其余原样。
handleRetArg : Expr -> Expr
handleRetArg (EVar nm rsp) =
  if isHandleNoRetSyntax nm then ELam [handleDefaultRetBinder] (EVar handleDefaultRetBinder rsp) rsp
  else EVar nm rsp
handleRetArg e = e

-- | 结果族形状校验：存在且显式参数个数为 `k + 1`（`<params…> -> <Op> -> Type`）。
handleResFamilyOf : List (Pair String Term) -> Ec -> String -> String -> Int -> Span -> Check (Pair String Int)
handleResFamilyOf globals ec canon resName k sp = case globalsLookup resName globals ec of
  Nothing => tcErr1 sp (EffResFamilyMissing canon) canon
  Just resKind =>
    if handleKindArity resKind == k + 1 then OkC (Pair resName k)
    else tcErr1 sp (HandleFamilyUnsupported canon) canon

-- | 族形状校验：返回 `(结果族名, op 族显式参数个数)`；形状不符报
-- TC_EffResFamilyMissing / TC_HandleFamilyUnsupported。D2 后标签 = op 族应用：
-- `<Op> : <params…> -> Type`、`res<短名> : <params…> -> <Op> -> Type`；
-- State/Reader 的 params 是状态/环境类型（k = 1），Console 等 k = 0；
-- Exn 是作用域/高阶族（op 族 kind 的显式参数域不是 Type）→ TC_HandleFamilyUnsupported。
handleFamilyArityOf : List (Pair String Term) -> Ec -> String -> String -> String -> Span -> Check (Pair String Int)
handleFamilyArityOf globals ec canon mod short sp =
  let
    resName = qualifyShort mod ("res" ++ short)
  in case handleOpKind globals ec canon of
    Nothing => tcErr1 sp (HandleFamilyUnsupported canon) canon
    Just opKind => case handleOpArity opKind of
      Nothing => tcErr1 sp (HandleFamilyUnsupported canon) canon
      Just k => handleResFamilyOf globals ec canon resName k sp

-- | 从 handle 标记构造降级调用；`headMode` 选 rowRem 版（`handleWith`）或行首条目版
-- （`handleWithAt`）。形状校验见 `handleFamilyArityOf`。
handleCallExprWith : List (Pair String Term) -> Ec -> Expr -> Span -> Bool -> Check Expr
handleCallExprWith globals ec expr sp headMode = case handleOperand expr of
  Nothing => icInternal "handle marker expected"
  Just (Pair comp (Pair ret opH)) => case opH of
    ELam (_ :: _ :: _) (ECase _ alts _) _ => Vuna.Compiler.Common.bind (handleClauseFamilies ec alts) (\fam => case perfFamilyOfCanonical fam of
      Nothing => tcErr1 sp (HandleFamilyUnsupported fam) fam
      Just (PerfFamily canon mod short) =>
        Vuna.Compiler.Common.bind (handleFamilyArityOf globals ec canon mod short sp)
          (\p => OkC (handleCall headMode canon (firstOf p) (secondOf p) comp ret opH sp))
    )
    _ => icInternal "malformed handle marker"

-- | rowRem 版降级入口（infer 路径与 check 的首选）。
handleCallExpr : List (Pair String Term) -> Ec -> Expr -> Span -> Check Expr
handleCallExpr globals ec expr sp = handleCallExprWith globals ec expr sp False

-- | 行首条目版降级入口（check 失败后的重试；comp 的行尚未具体化时用）。
handleCallExprAt : List (Pair String Term) -> Ec -> Expr -> Span -> Check Expr
handleCallExprAt globals ec expr sp = handleCallExprWith globals ec expr sp True

export inferEFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Check (Pair Term (Pair Value Ec))
inferEFuel fuel globals ctx ec expr = if fuel <= 0 then icFuel "inference"
else case handleOperand expr of
  Just _ =>
    Vuna.Compiler.Common.bind (handleCallExpr globals ec expr (exprSpan expr))
      (\callExpr => inferEFuel (fuel - 1) globals ctx ec callExpr)
  Nothing => case performOperand expr of
    Just (Pair op _) => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec op) (\p => case p of
      Pair _ (Pair opTy ec1) =>
        Vuna.Compiler.Common.bind (performCallExpr globals ec1 opTy op (exprSpan expr))
          (\callExpr => inferEFuel (fuel - 1) globals ctx ec1 callExpr)
    )
    Nothing => case appAtOperand expr of
      Just _ =>
        Vuna.Compiler.Common.bind (appAtCallExpr expr)
          (\callExpr => inferEFuel (fuel - 1) globals ctx ec callExpr)
      Nothing => case listLitElems expr of
        Just elems =>
          Vuna.Compiler.Common.bind (expandListLit ec listFamilyName elems (exprSpan expr))
            (\e2 => inferEFuel (fuel - 1) globals ctx ec e2)
        Nothing => inferEFuelCore fuel globals ctx ec expr

-- | 自动补注（M41 新增导出）：inferEFuelCore。
inferEFuelCore : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Check (Pair Term (Pair Value Ec))
inferEFuelCore fuel globals ctx ec expr = if fuel <= 0 then icFuel "inference"
else if doMarkerHead expr then case decodeDoBlock expr of
  Just chain => Vuna.Compiler.Common.bind (inferDoBlockFuel (fuel - 1) globals ctx ec chain) (\r => case r of
    Just p => OkC p
    Nothing => inferEFuelCorePlain fuel globals ctx ec (doChainFallback chain)
  )
  Nothing => inferEFuelCorePlain fuel globals ctx ec expr
else inferEFuelCorePlain fuel globals ctx ec expr

-- | 推断模式的形状分派核心：跳过列表字面量与 do 标记链后按表达式构造分派。
inferEFuelCorePlain : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Check (Pair Term (Pair Value Ec))
inferEFuelCorePlain fuel globals ctx ec expr = if fuel <= 0 then icFuel "inference"
else case expr of
  EVar name sp => case name of
    "Type" => OkC (Pair (TType levelZero) (Pair (VType (levelSucc levelZero)) ec))
    -- M40：`_` 与 `?name` 都必须有期望类型（inference 位无法给洞定类型）。
    _ =>
      if isHoleName name then tcErr0 sp HoleNoExpectedType
      else if isOverCtorName name then Vuna.Compiler.Common.bind
        (resolveOverCtor ec sp Nothing (overCtorShort name) (overCtorTargets name))
        (\t => inferVarRef globals ctx ec t sp)
      else inferVarRef globals ctx ec name sp
  EInt n sp => OkC (Pair (TInt n) (Pair (VNeutral (NGlobal "Int" [])) ec))
  EStr s sp => OkC (Pair (TStr s) (Pair (VNeutral (NGlobal "String" [])) ec))
  EFloat raw sp => OkC (Pair (TFloat raw) (Pair (VNeutral (NGlobal floatTypeName [])) ec))
  EPi name implicit qty dom cod sp =>
    inferPiFuel (fuel - 1) globals ctx ec name implicit qty dom cod sp
  EApp (EVar n fsp) args sp =>
    if isInstArgSyntax n then tcErr0 sp NoInstParam
    else inferAppFuel (fuel - 1) globals ctx ec (EVar n fsp) args sp Nothing
  EApp fn args sp => inferAppFuel (fuel - 1) globals ctx ec fn args sp Nothing
  ELam names body sp => tcErr0 sp LambdaNoSignature
  EIf c t e sp => Vuna.Compiler.Common.bind (checkCondBoolFuel (fuel - 1) globals ctx ec c sp) (\pc => case pc of
    Pair cTerm ec1 => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec1 t) (\pt => case pt of
      Pair tTerm (Pair tTy ec2) => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec2 e) (\pe => case pe of
        Pair eTerm (Pair eTy ec3) => if isIntTy ec3 tTy && isNatTy ec3 eTy then OkC (Pair (TIf cTerm tTerm (natToIntTerm eTerm)) (Pair tTy ec3))
        else if isNatTy ec3 tTy && isIntTy ec3 eTy then OkC (Pair (TIf cTerm (natToIntTerm tTerm) eTerm) (Pair intTyValue ec3))
        else Vuna.Compiler.Common.bind (convEc ec3 (ctxDepth ctx) tTy eTy) (\ec4 => let
          branchOpaque = isOpaqueRuntimeTyIn ec4 ctx tTy
          tTerm2 = if branchOpaque then castErased tTerm else tTerm
          eTerm2 = if branchOpaque then castErased eTerm else eTerm
        in OkC (Pair (TIf cTerm tTerm2 eTerm2) (Pair tTy ec4))
        )
      )
    )
  )
  ELet binds body rec_ sp => inferLetFuel (fuel - 1) globals ctx ec binds body rec_ sp
  ELocalFun clauses sp =>
    if clausesHaveOverCtor clauses then tcErr2 sp (AmbiguousCtor "constructor pattern" "local function needs an explicit signature")
      "constructor pattern" "local function needs an explicit signature"
    else Vuna.Compiler.Common.bind (expandLocalFuns ec (ELocalFun clauses sp))
      (\e2 => inferEFuel (fuel - 1) globals ctx ec e2)
  ECase scrut alts sp => inferCaseEFuel (fuel - 1) globals ctx ec scrut alts sp
  EField base fname sp => elabEFieldFuel (fuel - 1) globals ctx ec base fname sp
  ERecord rname fields sp => tcErr0 sp RecordsUnsupported
  ERecUpdate base fields sp => elabERecUpdateFuel (fuel - 1) globals ctx ec base fields sp
  EDo stmts sp => tcErr0 sp DoUnsupported
  EAnn value ty sp => inferAnnFuel (fuel - 1) globals ctx ec value ty sp
  _ => icInternal "unreordered infix/paren in elaboration"

-- ---------------------------------------------------------------
-- 记录字段访问 / 更新（R2：按结构化字段表查表）
-- ---------------------------------------------------------------
-- R4（records-v2）：record 声明直接进精化器（不再降级成单构造子 data），record 身份
-- 由 `DtData.dtDataIsRecord` 判定；字段身份仍由 `DtData.dtDataFields`
-- （名字 / 声明序号 / 外层字段类型）承载。
-- 访问/更新留在精化期：先推断 base 类型，用字段表定位字段，再复用 case 分支精化
-- （bindCtorTele 负责隐式参数、索引合一与 M39 不透明字段的 cast）。
-- | 把类型值解析成单构造子 record（数据族、构造子、索引实参）；否则 Nothing。
recordTypeOf : Ec -> Value -> Maybe (Pair DtData (Pair DtCtor (List Value)))
recordTypeOf ec ty = case forceVal ec ty of
  VNeutral (NGlobal g sp) => case dtDataLookup g (ecDatas ec) of
    Just dd => if dtDataIsRecord dd then case dtDataCtors dd of
      [c] => Just (Pair dd (Pair c sp))
      _ => Nothing
    else Nothing
    Nothing => Nothing
  _ => Nothing

-- | record 投影/更新生成的字段 binder 名（位置序号）。
recordFieldVarName : Int -> String
recordFieldVarName i = "@vuna@record@proj${i}"

-- | 为 record 的 n 个字段生成 PVar 模式列表（binder 名由 recordFieldVarName 给出）。
recordFieldPats : Int -> Span -> List Pat
recordFieldPats n sp = recordFieldPatsFrom 0 n sp

-- | 从序号 i 起生成剩余 remaining 个字段的 PVar 模式。
recordFieldPatsFrom : Int -> Int -> Span -> List Pat
recordFieldPatsFrom i remaining sp =
  if remaining <= 0 then []
  else Base.List.Cons (PVar (recordFieldVarName i) sp) (recordFieldPatsFrom (i + 1) (remaining - 1) sp)

-- | R2：按名字在结构化字段表里查（字段序号 / 字段总数 / 外层字段类型）。
recordFieldLookup : String -> DtData -> Maybe (Pair Int (Pair Int Term))
recordFieldLookup fname dd = recordFieldLookupGo fname (dtDataFields dd) (length (dtDataFields dd))

recordFieldLookupGo : String -> List DtFieldMeta -> Int -> Maybe (Pair Int (Pair Int Term))
recordFieldLookupGo fname [] n = Nothing
recordFieldLookupGo fname (f :: rest) n =
  if f.dtFieldName == fname then Just (Pair f.dtFieldIndex (Pair n f.dtFieldType))
  else recordFieldLookupGo fname rest n

-- | 逐个检查更新字段是否属于该 record，返回第一个未知字段名。
recordUpdateUnknownGo : DtData -> List (Pair String Expr) -> Maybe String
recordUpdateUnknownGo dd [] = Nothing
recordUpdateUnknownGo dd ((Pair fname e) :: rest) = case recordFieldLookup fname dd of
  Nothing => Just fname
  Just _ => recordUpdateUnknownGo dd rest

-- | 报告第一个不属于该 record 的更新字段名；全部已知则返回 Nothing。
recordUpdateUnknown : DtData -> List (Pair String Expr) -> Maybe String
recordUpdateUnknown dd fields = recordUpdateUnknownGo dd fields

-- | R2：在更新字段表里按 record 字段名查找对应的新值表达式。
recordUpdateValueFor : String -> List (Pair String Expr) -> Maybe Expr
recordUpdateValueFor fname [] = Nothing
recordUpdateValueFor fname ((Pair n e) :: rest) =
  if n == fname then Just e else recordUpdateValueFor fname rest

-- | 生成更新后构造子的第 i 个实参：提供新值就用它，否则引用原字段 binder。
recordUpdateArg : Int -> DtFieldMeta -> List (Pair String Expr) -> Span -> Expr
recordUpdateArg i f provided sp = case recordUpdateValueFor f.dtFieldName provided of
  Just e => e
  Nothing => EVar (recordFieldVarName i) sp

-- | 按字段表顺序生成全部字段的更新实参，未提供的字段沿用原 binder。
recordUpdateArgs : Int -> List DtFieldMeta -> List (Pair String Expr) -> Span -> List Expr
recordUpdateArgs i [] provided sp = []
recordUpdateArgs i (f :: rest) provided sp =
  recordUpdateArg i f provided sp :: recordUpdateArgs (i + 1) rest provided sp

-- | R2：更新表达式涉及到的字段序号（结构化标注，供后续原语化复用）。
recordUpdatedIndices : DtData -> List (Pair String Expr) -> List Int
recordUpdatedIndices dd [] = []
recordUpdatedIndices dd ((Pair fname e) :: rest) = case recordFieldLookup fname dd of
  Just (Pair fi _) => fi :: recordUpdatedIndices dd rest
  Nothing => recordUpdatedIndices dd rest

-- 访问/更新的解析计划：纯解析（只查 data/字段表，不递归回精化器），避免把额外 helper
-- 拉进 SCT 递归组；组里只多 elabEFieldFuel / elabERecUpdateFuel 两个入口。
-- R2：计划携带（记录名，字段序号）标注——`EField` / `ERecUpdate` 在精化期消歧后
-- 的显式身份，后续 R3 的 `TProj` 原语直接消费它。
-- | 字段访问解析结果：数据族、构造子、索引、记录名、字段序号/总数与字段类型。
record FieldAccessPlan where
  planData : DtData
  planCtor : DtCtor
  planIdxs : List Value
  planRecord : String
  planField : Int
  planFieldCount : Int
  planType : Value

-- | record 更新解析结果：数据族、构造子、索引、记录名、字段数 / 被改字段序号与重建实参。
record UpdateAccessPlan where
  upData : DtData
  upCtor : DtCtor
  upIdxs : List Value
  upRecord : String
  upFieldCount : Int
  upFieldIndices : List Int
  upBodyArgs : List Expr

-- | 解析字段访问：校验 base 是单构造子 record，按字段表定位字段并求出字段类型。
recordFieldPlan : Ec -> Value -> String -> Span -> Check FieldAccessPlan
recordFieldPlan ec baseTy fname sp = case recordTypeOf ec baseTy of
  Nothing => errAt sp "cannot resolve record type for field ${fname}; add a type signature"
  Just (Pair dd (Pair ctor idxs)) => case recordFieldLookup fname dd of
    Nothing => errAt sp "record type has no field ${fname}"
    Just (Pair fi (Pair nFields dom)) =>
      OkC (FieldAccessPlan dd ctor idxs dd.dtDataName fi nFields (eval (reverse idxs) dom))

-- | 解析 record 更新：校验字段都存在，并为重建构造子生成逐字段实参。
recordUpdatePlan : Ec -> Value -> List (Pair String Expr) -> Span -> Check UpdateAccessPlan
recordUpdatePlan ec baseTy fields sp = case recordTypeOf ec baseTy of
  Nothing => errAt sp "cannot resolve record type for update; add a type signature"
  Just (Pair dd (Pair ctor idxs)) => case recordUpdateUnknown dd fields of
    Just unknown => errAt sp "record type has no field ${unknown}"
    Nothing =>
      let
        fs = dtDataFields dd
        bodyArgs = recordUpdateArgs 0 fs fields sp
      in OkC
        (UpdateAccessPlan dd ctor idxs dd.dtDataName (length fs) (recordUpdatedIndices dd fields) bodyArgs)

-- | `Base.Record.HasField` 字典族的 canonical 名，供上下文查找字段约束使用。
hasFieldDictName : String
hasFieldDictName = dictTypeName "Base.Record.HasField"

-- 在局部上下文里找签名约束提供的 HasField 字典（`{d : Dict_HasField (MkField "f") a t}`）。
-- 类参数顺序固定为 f / a / t；标签按 Field 构造子里的 String 比较。
-- | 在局部上下文里找签名约束提供的 HasField 字典，返回字典项与统一后的字段类型。
ctxHasFieldDict : Ctx -> Ec -> String -> Value -> Maybe (Pair Term (Pair Value Ec))
ctxHasFieldDict ctx ec fname baseTy = ctxHasFieldDictGo ctx.ctxItems 0 ctx ec fname baseTy

-- | 逐项扫描上下文：匹配 HasField 的字段标签并统一 base 类型，命中即返回。
ctxHasFieldDictGo : List (Pair String Term) -> Int -> Ctx -> Ec -> String -> Value -> Maybe (Pair Term (Pair Value Ec))
ctxHasFieldDictGo [] idx ctx ec fname baseTy = Nothing
ctxHasFieldDictGo ((Pair name ty) :: rest) idx ctx ec fname baseTy = case forceVal ec (varTypeValue ctx idx ty) of
  VNeutral (NGlobal g args) => case g == hasFieldDictName of
    False => ctxHasFieldDictGo rest (idx + 1) ctx ec fname baseTy
    True => case args of
      fVal :: aVal :: tVal :: _ => case forceVal ec fVal of
        VNeutral (NGlobal "Base.Field.Field" (label :: _)) => case label of
          VStr nm => case nm == fname of
            False => ctxHasFieldDictGo rest (idx + 1) ctx ec fname baseTy
            True => case convEc ec (ctxDepth ctx) aVal baseTy of
              OkC ec2 => Just (Pair (TVar name idx (Span "" 0 0 0 0)) (Pair tVal ec2))
              ErrC _ => ctxHasFieldDictGo rest (idx + 1) ctx ec fname baseTy
          _ => ctxHasFieldDictGo rest (idx + 1) ctx ec fname baseTy
        _ => ctxHasFieldDictGo rest (idx + 1) ctx ec fname baseTy
      _ => ctxHasFieldDictGo rest (idx + 1) ctx ec fname baseTy
  _ => ctxHasFieldDictGo rest (idx + 1) ctx ec fname baseTy

-- base 类型不是具体 record 时的字段访问：用签名里的 HasField 约束字典。
-- 具体 record 走 RecordAccessPlan（零字典）；这里只处理刚性/未解类型。
-- | base 非具体 record 时的字段访问：用上下文里的 HasField 约束字典投影字段。
hasFieldAccessFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Term -> Value -> String -> Span -> Check (Pair Term (Pair Value Ec))
hasFieldAccessFuel fuel globals ctx ec baseTerm baseTy fname sp = case forceVal ec baseTy of
  VNeutral (NGlobal g sp2) => errAt sp "type ${g} is not a record"
  _ => case ctxHasFieldDict ctx ec fname baseTy of
    Nothing =>
      errAt sp
        "cannot resolve field ${fname}; add a HasField (Field \"${fname}\") constraint or a record type annotation"
    Just (Pair dictTerm (Pair fieldTy ec2)) =>
      let
        d = ctxDepth ctx
        labelTerm = TApp (TGlobal "Base.Field.Field") (TStr fname) Rig0
        proj =
          TApp
            (TApp (TApp (TApp (TApp (TGlobal "Base.Record.getField") labelTerm Rig0) (quote d baseTy) Rig0) (quote d fieldTy) Rig0) dictTerm RigOmega)
            baseTerm RigOmega
      in OkC (Pair proj (Pair fieldTy ec2))

-- | 精化字段访问：base 是具体 record 时按构造子 case 投影，否则回退到 HasField 字典。
elabEFieldFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> String -> Span -> Check (Pair Term (Pair Value Ec))
elabEFieldFuel fuel globals ctx ec base fname sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec base) (\pb => case pb of
  Pair baseTerm (Pair baseTy ec1) => case recordTypeOf ec1 baseTy of
    -- R3：具体 record 的字段访问直接产出 `TProj` 原语（codegen 按原 case 形状展开）；
    -- record 族只有参数、没有索引，因此 projection 不需要再走 `elabConAltFuel` 的
    -- 索引合一 / 不透明字段 cast，字段类型直接来自结构化字段表。
    Just _ => Vuna.Compiler.Common.bind (recordFieldPlan ec1 baseTy fname sp) (\plan => let
      arity = length plan.planData.dtDataParams
      tele = drop arity (dtCtorTelescope plan.planCtor)
      proj = TProj baseTerm (dtCtorName plan.planCtor) tele (arity + plan.planField) plan.planField
    in OkC (Pair proj (Pair plan.planType ec1))
    )
    Nothing => hasFieldAccessFuel (fuel - 1) globals ctx ec1 baseTerm baseTy fname sp
)

-- | 精化 record 更新：把 base 解构成构造子、逐字段换值后重建，结果仍是原 record 类型。
elabERecUpdateFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair String Expr) -> Span -> Check (Pair Term (Pair Value Ec))
elabERecUpdateFuel fuel globals ctx ec base fields sp = if fuel <= 0 then icFuel "inference"
else case fields of
  [] => errAt sp "record update needs at least one field"
  _ => if hasDuplicateFieldNames fields then errAt sp "duplicate field in record update"
  else Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec base) (\pb => case pb of
    Pair baseTerm (Pair baseTy ec1) => Vuna.Compiler.Common.bind (recordUpdatePlan ec1 baseTy fields sp) (\plan => let
      body = EApp (EVar (dtCtorName plan.upCtor) sp) plan.upBodyArgs sp
    in Vuna.Compiler.Common.bind (elabConAltFuel (fuel - 1) globals ctx ec1 plan.upData plan.upIdxs (evalCtx ctx baseTerm) baseTy (dtCtorName plan.upCtor) (recordFieldPats plan.upFieldCount sp) sp body) (\q => case q of
      -- R3：重建体装进 `TRecUpd` 原语（带记录身份）；语义仍是单分支 case。
      Pair alt ec2 =>
        OkC
          (Pair (TRecUpd baseTerm alt.caseAltName alt.caseAltBinders plan.upFieldIndices alt.caseAltBody) (Pair baseTy ec2))
    )
    )
  )

-- 先检查 ty 是合法类型，再把 value 按该类型 check；推导位返回 eval ty 作为类型。
export inferAnnFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Expr -> Span -> Check (Pair Term (Pair Value Ec))
inferAnnFuel fuel globals ctx ec value ty sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (checkTypeFuel (fuel - 1) globals ctx ec ty) (\pt => case pt of
  Pair tyTerm (Pair _ ec1) =>
    let
      tyVal = eval (ctxEnv ctx) tyTerm
    in Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec1 value tyVal) (\p => case p of
      Pair term ec2 => OkC (Pair term (Pair tyVal ec2))
    )
)

export inferPiFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> Bool -> Maybe Qty -> Expr -> Expr -> Span -> Check (Pair Term (Pair Value Ec))
inferPiFuel fuel globals ctx ec name implicit qty dom cod sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (checkTypeFuel (fuel - 1) globals ctx ec dom) (\pd => case pd of
  Pair domTerm (Pair domSort ec1) =>
    let
      domVal = evalCtx ctx domTerm
      isTypeDom = isTypeDomain domVal
      isLinDom = isLinearType ec domVal
      lvl = ctxDepth ctx
      ctx2 = ctxBind name domTerm ctx
      badQty = case qty of
        Just _ => implicit || isTypeDom
        Nothing => False
      badLinQty = case qty of
        Just q => qtyIsZero q && isLinDom
        Nothing => False
    in if badQty then if implicit then tcErr1 sp (MultiplicityImplicit name) name
    else tcErr1 sp (MultiplicityTypeDomain name) name
    else if badLinQty then tcErr1 sp (LinearTypeNeedsOne name) name
    else Vuna.Compiler.Common.bind (checkTypeFuel (fuel - 1) globals ctx2 ec1 cod) (\pc => case pc of
      Pair codTerm (Pair codSort ec2) =>
        OkC
          (Pair (TPi name implicit (if isLinDom then Rig1 else if implicit then implicitBinderRig ec domVal else rigOfQty False isTypeDom qty) domTerm codTerm) (Pair (VType (levelMax domSort codSort)) ec2))
    )
)

-- D23：期望结果类型已知（S2 hint）且名字是 `Base.Num` 方法投影、期望类型又不是内建
-- Int/Nat/Float 时，跳过运算符特化、直接走带 hint 的通用推断：hint 先解出类参数与
-- 结果类型，实参（字面量）随后按该类型 check（可经 FromInt 降级）。否则运算符特化会
-- 先把字面量推成 Int，`1 + 2 : MyNum` 会报 expected MyNum got Int。
-- | 检查/推断方向的跳过判据：`name` 是 `Base.Num` 方法投影、期望类型是**刚性非内建**类型。
-- 期望是元变量（未知）时不跳过：那属于推断位置，保留旧的「先推断实参、Nat/Int 混合提升」
-- 行为（如 `length xs + maxIntList ys`：Nat + Int → Int）。
skipArithSpecForExpected : Ec -> String -> Value -> Bool
skipArithSpecForExpected ec name expected = case numMethodOpName ec name of
  Just _ => if isIntTy ec expected then False
  else if isNatTy ec expected then False
  else if isFloatTy ec expected then False
  else case forceVal ec expected of
    VMeta _ _ => False
    _ => True
  Nothing => False

-- | S2 `hint` 版本的跳过判据（hint 里带期望结果类型）。
skipArithSpecForHint : Ec -> String -> Maybe (Pair Int Value) -> Bool
skipArithSpecForHint ec name Nothing = False
skipArithSpecForHint ec name (Just p) = skipArithSpecForExpected ec name (secondOf p)

-- 应用：逐个消费显式实参，遇到隐式 Pi 先插入元变量。
export inferAppFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Span -> Maybe (Pair Int Value) -> Check (Pair Term (Pair Value Ec))
inferAppFuel fuel globals ctx ec fn args sp hint = if fuel <= 0 then icFuel "inference"
else case fn of
  EVar "->" _ => case args of
    [a, b] => inferPiFuel (fuel - 1) globals ctx ec "_" False Nothing a b sp
    _ => tcErr0 sp InvalidArrowType
  EVar "Type" tsp => case args of
    [EInt n nsp] =>
      if n < 0 then tcErr0 nsp UniverseLevelNonNegative
      else OkC (Pair (TType (levelOfInt n)) (Pair (VType (levelSucc (levelOfInt n))) ec))
    _ => tcErr0 tsp TypeLevelArg
  _ => case fn of
    EVar name vsp => if isOverCtorName name then Vuna.Compiler.Common.bind
      (resolveOverCtor ec vsp Nothing (overCtorShort name) (overCtorTargets name))
      (\t => inferAppFuel (fuel - 1) globals ctx ec (EVar t vsp) args sp hint)
    else case ctxLookup name ctx of
      Just _ => inferAppGeneralFuel (fuel - 1) globals ctx ec fn args sp hint
      -- M23：与类型同名的构造子（`data Pair a b where Pair : a -> b -> ...`）在
      -- 推断位置按**构造子**解释（推断位置是值位置；类型位置由 checkTypeFuel (fuel - 1) / checkAppFuel (fuel - 1)
      -- 的「期望是宇宙」分支先走类型应用，不会到这里）。构造子表优先于 globals：
      -- globals 里同名项先登记的是族的 kind，直接查会拿到 `Type -> ... -> Type`。
      Nothing => case dtCtorLookupEc ec name of
        Just ctor => Vuna.Compiler.Common.bind (inferArgsFuel (fuel - 1) globals ctx ec (eval [] (dtCtorType ctor)) args sp hint) (\pa => case pa of
          Pair argTerms (Pair resTy ec2) =>
            OkC (Pair (ctorAppTerm (ecDatas ec2) (TGlobal name) argTerms) (Pair resTy ec2))
        )
        Nothing => case globalsLookup name globals ec of
          -- M23：推断位置也要走 `==` / `/=` / 比较运算符的特化，否则 term 里留下裸
          -- `==`（codegen 默认映射成 bi_eq_int，字符串比较会生成类型错误的 OCaml）。
          Just tyTerm => if skipArithSpecForHint ec name hint then Vuna.Compiler.Common.bind (inferArgsFuel (fuel - 1) globals ctx ec (eval [] tyTerm) args sp hint) (\pa => case pa of
            Pair argTerms (Pair resTy ec2) =>
              OkC (Pair (ctorAppTerm (ecDatas ec2) (TGlobal name) argTerms) (Pair resTy ec2))
          )
          else Vuna.Compiler.Common.bind (specializeOpAppFuel (fuel - 1) globals ctx ec name args sp) (\mspec => case mspec of
            Just pair => OkC pair
            Nothing => Vuna.Compiler.Common.bind (inferArgsFuel (fuel - 1) globals ctx ec (eval [] tyTerm) args sp hint) (\pa => case pa of
              Pair argTerms (Pair resTy ec2) =>
                OkC (Pair (ctorAppTerm (ecDatas ec2) (TGlobal name) argTerms) (Pair resTy ec2))
            )
          )
          -- M31.1：`==` / `<` 等已不是 prelude globals（用户源码的运算符在 Loader 被
          -- 别名成方法名），但 `Elab.Derive`（deriving 展开）与 `Elab.Match`（字面量
          -- 模式）仍直接构造 `EVar "=="` 这类内部生成名，且实例方法体没有签名、走推断。
          -- 因此推断位置在没有 globals 项时也要先试运算符特化，再报 UnknownName。
          Nothing => Vuna.Compiler.Common.bind (specializeOpAppFuel (fuel - 1) globals ctx ec name args sp) (\mspec => case mspec of
            Just pair => OkC pair
            Nothing => tcErr1 vsp (UnknownName name) name
          )
    _ => inferAppGeneralFuel (fuel - 1) globals ctx ec fn args sp hint

export inferAppGeneralFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Span -> Maybe (Pair Int Value) -> Check (Pair Term (Pair Value Ec))
inferAppGeneralFuel fuel globals ctx ec fn args sp hint = if fuel <= 0 then icFuel "inference"
else case fn of
  EVar name vsp => Vuna.Compiler.Common.bind (specializeOpAppFuel (fuel - 1) globals ctx ec name args sp) (\mspec => case mspec of
    Just pair => OkC pair
    Nothing => inferAppGeneralGoFuel (fuel - 1) globals ctx ec fn args sp hint
  )
  _ => inferAppGeneralGoFuel (fuel - 1) globals ctx ec fn args sp hint

export inferAppGeneralGoFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Span -> Maybe (Pair Int Value) -> Check (Pair Term (Pair Value Ec))
inferAppGeneralGoFuel fuel globals ctx ec fn args sp hint = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec fn) (\pf => case pf of
  Pair fnTerm (Pair fnTy ec1) => Vuna.Compiler.Common.bind (inferArgsFuel (fuel - 1) globals ctx ec1 fnTy args sp hint) (\pa => case pa of
    Pair argTerms (Pair resTy ec2) =>
      OkC (Pair (ctorAppTerm (ecDatas ec2) fnTerm argTerms) (Pair resTy ec2))
  )
)

export inferArgsFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Value -> List Expr -> Span -> Maybe (Pair Int Value) -> Check (Pair (List (Pair Term Rig)) (Pair Value Ec))
inferArgsFuel fuel globals ctx ec ty args sp hint =
  if fuel <= 0 then icFuel "inference" else inferArgsGo 64 globals ctx ec ty args sp hint

-- M41：列表字面量（parser 保留名）按期望族的 Nil/Cons 通用展开；期望未知时默认
-- `Base.List.List`。族内按短名 `Nil`/`Cons` 找构造子（Row/Vec 改名后自然生效）。
-- | 自动补注（M41 新增导出）：listLitElems。
listLitElems : Expr -> Maybe (List Expr)
listLitElems (EVar name sp) = if isListNilSyntax name then Just [] else Nothing
listLitElems (EApp (EVar name csp) ([h, t]) sp) =
  if isListConsSyntax name then listLitConsTail h t else Nothing

-- | 自动补注（M41 新增导出）：listLitConsTail。
listLitConsTail : Expr -> Expr -> Maybe (List Expr)
listLitConsTail h t = case listLitElems t of
  Just rest => Just (h :: rest)
  Nothing => Nothing

listLitElems _ = Nothing

-- | 自动补注（M41 新增导出）：findCtorByShort。
findCtorByShort : String -> List DtCtor -> Maybe DtCtor
findCtorByShort short [] = Nothing
findCtorByShort short (c :: rest) =
  if ctorShortName (dtCtorName c) == short then Just c else findCtorByShort short rest

-- | 自动补注（M41 新增导出）：litFamilyCtor。
litFamilyCtor : Ec -> String -> String -> Maybe DtCtor
litFamilyCtor ec fam short = case dtDataLookup fam (ecDatas ec) of
  Nothing => Nothing
  Just dd => findCtorByShort short (dtDataCtors dd)

-- | 自动补注（M41 新增导出）：expandListLitGo。
expandListLitGo : String -> String -> List Expr -> Span -> Check Expr
expandListLitGo nilName consName [] sp = OkC (EVar nilName sp)
expandListLitGo nilName consName (e :: rest) sp =
  Vuna.Compiler.Common.bind (expandListLitGo nilName consName rest sp)
    (\t => OkC (EApp (EVar consName sp) [e, t] sp))

-- 命名行（D2/ND3/ND4）：行字面量的条目形状是 `Cons <name> <label> <tail>`。
--   * 裸标签（`Fetch`、`ConsoleOp`、`StateOp Nat`）→ 名字取 `defaultInstance`；
--   * `label@name`（`ConsoleOp@audit`、`StateOp Nat@counter`）→ 名字取 `@` 右侧；
--     parser 已把裸标识符名字转成字符串字面量（`[Op@audit]` → 名字 "audit"），
--     变量名必须写 `Cons n label tail`。
rowAtParts : Expr -> Maybe (Pair Expr Expr)
rowAtParts (EApp (EVar name _) ([e, n]) _) = if isRowAtSyntax name then Just (Pair e n) else Nothing
rowAtParts _ = Nothing

appAtParts : Expr -> Maybe (Pair Expr (Pair Expr (List Expr)))
appAtParts (EApp (EVar name _) (f :: nm :: rest) _) =
  if isAppAtSyntax name then Just (Pair f (Pair nm rest)) else Nothing
appAtParts _ = Nothing

-- 行条目（rowAt 或 appAt）：`Pair label name`。appAt 的多余实参是标签应用
-- （`[StateOp@counter Nat]` ⇒ 标签 `StateOp Nat`）。
rowEntryParts : Expr -> Maybe (Pair Expr Expr)
rowEntryParts e = case rowAtParts e of
  Just p => Just p
  Nothing => case appAtParts e of
    Just (Pair label (Pair nm rest)) => Just (Pair (applyExtra label rest) nm)
    Nothing => Nothing

applyExtra : Expr -> List Expr -> Expr
applyExtra label [] = label
applyExtra label args = EApp label args (exprSpan label)

-- 行条目标签：`X@name` 取 X，其余原样（不再把名字塞进标签）。
rowLitLabel : Expr -> Expr
rowLitLabel e = case rowEntryParts e of
  Just (Pair x _) => x
  Nothing => e

rowLitNameArg : Expr -> Maybe Expr
rowLitNameArg e = case rowEntryParts e of
  Just (Pair _ n) => Just n
  Nothing => Nothing

rowLitNameExpr : Expr -> Span -> Expr
rowLitNameExpr e sp = case rowLitNameArg e of
  Just nExpr => nExpr
  Nothing => EStr effDefaultInstance sp

expandRowListLitGo : String -> String -> List Expr -> Span -> Check Expr
expandRowListLitGo nilName consName [] sp = OkC (EVar nilName sp)
expandRowListLitGo nilName consName (e :: rest) sp =
  Vuna.Compiler.Common.bind (expandRowListLitGo nilName consName rest sp)
    (\t => OkC (EApp (EVar consName sp) [rowLitNameExpr e sp, rowLitLabel e, t] sp))

-- | 自动补注（M41 新增导出）：expandListLit。
expandListLit : Ec -> String -> List Expr -> Span -> Check Expr
expandListLit ec fam elems sp = if fam == effRowFamilyName then case litFamilyCtor ec fam "Nil" of
  Nothing => tcErr1 sp (UnknownName fam) fam
  Just nilC => case litFamilyCtor ec fam "Cons" of
    Nothing => tcErr1 sp (UnknownName fam) fam
    Just consC => expandRowListLitGo (dtCtorName nilC) (dtCtorName consC) elems sp
else case litFamilyCtor ec fam "Nil" of
  Nothing => tcErr1 sp (UnknownName fam) fam
  Just nilC => case litFamilyCtor ec fam "Cons" of
    Nothing => tcErr1 sp (UnknownName fam) fam
    Just consC => expandListLitGo (dtCtorName nilC) (dtCtorName consC) elems sp

-- | 自动补注（M41 新增导出）：listLitFamily。
listLitFamily : Ec -> Value -> String
listLitFamily ec expected = case expectedFamilyOf ec expected of
  Just fam => fam
  Nothing => listFamilyName

-- | 自动补注（M41 新增导出）：expandArgListLit。
expandArgListLit : Ec -> Value -> Expr -> Check Expr
expandArgListLit ec dom a = case listLitElems a of
  Just elems => expandListLit ec (listLitFamily ec (forceVal ec dom)) elems (exprSpan a)
  Nothing => OkC a

export inferArgsGo : Int -> List (Pair String Term) -> Ctx -> Ec -> Value -> List Expr -> Span -> Maybe (Pair Int Value) -> Check (Pair (List (Pair Term Rig)) (Pair Value Ec))
inferArgsGo fuel globals ctx ec ty args sp hint = if fuel <= 0 then icFuel "inference"
else
  let
    forced = forceVal ec ty
  in case forced of
    VPi name implicit rig dom clo => if implicit then if isDictDomain ec dom then if dictArgUnsolvedMeta ec dom then deferDictBinderFuel (fuel - 1) globals ctx ec dom clo args sp hint
    else Vuna.Compiler.Common.bind (constrainDictDomFuel (fuel - 1) globals ec ctx dom args sp) (\ec0 => case searchInstanceIn globals ctx ec0 (forceVal ec0 dom) sp of
      OkC (Pair instTerm ec1) =>
        let
          ty2 = applyClosure clo (evalCtx ctx instTerm)
        in Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec1 ty2 args sp hint) (\q => case q of
          Pair argTerms (Pair resTy ec2) =>
            OkC (Pair (Base.List.Cons (Pair instTerm RigOmega) argTerms) (Pair resTy ec2))
        )
      ErrC e =>
        if hasUnsolvedMetaValue (ecSolsP ec0) (forceVal ec0 dom) then deferDictBinderFuel (fuel - 1) globals ctx ec0 dom clo args sp hint
        else if isRigidDictArg ec0 (forceVal ec0 dom) then deferDictBinderFuel (fuel - 1) globals ctx ec0 dom clo args sp hint
        else ErrC e
    )
    else if isMemberDomain ec dom then case memberLookup 64 (ctxDepth ctx) ec dom of
      MemberFound proof ec1 => Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec1 (applyClosure clo proof) args sp hint) (\p => case p of
        Pair argTerms (Pair resTy ec2) =>
          OkC
            (Pair (Base.List.Cons (Pair (quote (ctxDepth ctx) proof) Rig0) argTerms) (Pair resTy ec2))
      )
      MemberAbsent => tcErr1 sp (NoInstanceFound "row membership") "row membership"
      -- 命名行歧义（ND5）：这里先建 meta + 延迟约束；最终化在 resolveRowGoalsCtxGo
      -- 报 TC_AmbiguousInstance（能拿到 span 与候选文本）。
      MemberAmbiguous _ =>
        let
          m = ecNext ec
        in case newMetaAt sp ctx ec of
          Pair metaTerm ec1 =>
            let
              ec2 = ecAddConstraint ec1 CkRow m dom (Just sp) (ctxDepth ctx)
            in Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec2 (applyClosure clo (eval (ctxEnv ctx) metaTerm)) args sp hint) (\p => case p of
              Pair argTerms (Pair resTy ec3) =>
                OkC (Pair (Base.List.Cons (Pair metaTerm Rig0) argTerms) (Pair resTy ec3))
            )
      MemberStuck =>
        let
          m = ecNext ec
        in case newMetaAt sp ctx ec of
          Pair metaTerm ec1 =>
            let
              ec2 = ecAddConstraint ec1 CkRow m dom (Just sp) (ctxDepth ctx)
            in Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec2 (applyClosure clo (eval (ctxEnv ctx) metaTerm)) args sp hint) (\p => case p of
              Pair argTerms (Pair resTy ec3) =>
                OkC (Pair (Base.List.Cons (Pair metaTerm Rig0) argTerms) (Pair resTy ec3))
            )
    else if isImplicitDomain ctx ec dom then if isStringImplicitDomain ec dom then case args of
      a :: rest => case instArgOperand a of
        Just payload => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec payload dom) (\p => case p of
          Pair payloadTerm ec1 => Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec1 (applyClosure clo (evalCtx ctx payloadTerm)) rest sp hint) (\q => case q of
            Pair argTerms (Pair resTy ec2) =>
              OkC (Pair (Base.List.Cons (Pair payloadTerm rig) argTerms) (Pair resTy ec2))
          )
        )
        Nothing => case newMetaAt sp ctx ec of
          Pair metaTerm ec1 => Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec1 (applyClosure clo (evalCtx ctx metaTerm)) args sp hint) (\p => case p of
            Pair argTerms (Pair resTy ec2) =>
              OkC (Pair (Base.List.Cons (Pair metaTerm rig) argTerms) (Pair resTy ec2))
          )
      [] => case newMetaAt sp ctx ec of
        Pair metaTerm ec1 => Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec1 (applyClosure clo (evalCtx ctx metaTerm)) args sp hint) (\p => case p of
          Pair argTerms (Pair resTy ec2) =>
            OkC (Pair (Base.List.Cons (Pair metaTerm rig) argTerms) (Pair resTy ec2))
        )
    else case newMetaAt sp ctx ec of
      Pair metaTerm ec1 => Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec1 (applyClosure clo (evalCtx ctx metaTerm)) args sp hint) (\p => case p of
        Pair argTerms (Pair resTy ec2) =>
          OkC (Pair (Base.List.Cons (Pair metaTerm rig) argTerms) (Pair resTy ec2))
      )
    else tcErr0 sp ImplicitParamKind
    else case args of
      [] => OkC (Pair [] (Pair forced ec))
      a :: rest =>
        let
          ec0 = case hint of
            Nothing => ec
            Just (Pair goals0 expected) => case tryUseHint goals0 ctx expected ec forced of
              Nothing => ec
              Just ec1 => ec1
        in Vuna.Compiler.Common.bind (rigForLinearDomain ec0 sp name rig dom) (\argRig => Vuna.Compiler.Common.bind (expandArgListLit ec0 dom a) (\a2 => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec0 a2 dom) (\p => case p of
          Pair aTerm ec1 => Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx ec1 (applyClosure clo (evalCtx ctx aTerm)) rest sp Nothing) (\q => case q of
            Pair argTerms (Pair resTy ec2) =>
              OkC (Pair (Base.List.Cons (Pair aTerm argRig) argTerms) (Pair resTy ec2))
          )
        )
        )
        )
    _ => case args of
      [] => OkC (Pair [] (Pair forced ec))
      a :: rest => tcErr0 (exprSpan a) TooManyArgs

export deferDictBinderFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Value -> Closure -> List Expr -> Span -> Maybe (Pair Int Value) -> Check (Pair (List (Pair Term Rig)) (Pair Value Ec))
deferDictBinderFuel fuel globals ctx ec dom clo args sp hint = if fuel <= 0 then icFuel "inference"
else
  let
    m = ecNext ec
  in case newMetaAt sp ctx ec of
    Pair metaTerm ec1 => Vuna.Compiler.Common.bind (inferArgsGo (fuel - 1) globals ctx (ecAddConstraint ec1 CkDict m (forceVal ec1 dom) (Just sp) (ctxDepth ctx)) (applyClosure clo (eval (ctxEnv ctx) metaTerm)) args sp hint) (\p => case p of
      Pair argTerms (Pair resTy ec2) =>
        OkC (Pair (Base.List.Cons (Pair metaTerm RigOmega) argTerms) (Pair resTy ec2))
    )

-- 用后续显式实参约束 `Dict_C ?a` 里的类参数。M22：先取字典族的**类参数 kind**，
-- 实参头部与它 kind 不匹配（`Monad ?m` 被 `41 : Int` 解成 `?m = Int`）或头部不是
-- 具体构造子（`?m' Int`）就不约束——类参数由字典实例 / 结果类型决定。
export constrainDictDomFuel : Int -> List (Pair String Term) -> Ec -> Ctx -> Value -> List Expr -> Span -> Check Ec
constrainDictDomFuel fuel globals ec ctx dom args sp = if fuel <= 0 then icFuel "inference"
else case dictClassArg ec dom of
  Nothing => OkC ec
  Just argTy => case dictArgKind ec dom of
    Nothing => OkC ec
    Just argKind => case argTy of
      -- 类参数是裸元变量：在**副本**上推断显式实参以确定它（`MkB` → `?a = B`），
      -- 但只把 `?a` 的解带回真实 ec，`inferEFuel (fuel - 1)` 新建的孤儿元变量随副本丢弃——
      -- 否则 `bind (pure 41)` 的 `pure` 类参数（`?3`）会变成未解孤儿报 M13。
      VMeta a [] => Vuna.Compiler.Common.bind (constrainDictDomGoKFuel (fuel - 1) globals ec ctx argTy argKind args sp) (\ecProbe => case metaLookup a (ecSolTbl ecProbe) of
        Just v => case solveMeta (ecDefTbl ec) (ecSolsP ec) 0 a [] v of
          OkC sols2 => OkC (ecPutSols ec (solsList sols2))
          ErrC e => OkC ec
        Nothing => OkC ec
      )
      _ => constrainDictDomGoKFuel (fuel - 1) globals ec ctx argTy argKind args sp

export constrainDictDomGoKFuel : Int -> List (Pair String Term) -> Ec -> Ctx -> Value -> Value -> List Expr -> Span -> Check Ec
constrainDictDomGoKFuel fuel globals ec ctx argTy argKind args sp = if fuel <= 0 then icFuel "inference"
else case args of
  [] => OkC ec
  a :: rest => case inferEFuel (fuel - 1) globals ctx ec a of
    ErrC e => OkC ec
    OkC (Pair aTerm (Pair aTy ec1)) =>
      let
        forced = forceVal ec1 aTy
      in if isTypeValue forced then constrainDictDomGoKFuel (fuel - 1) globals ec1 ctx argTy argKind rest sp
      else if argHeadMatchesKind globals ec1 ctx forced argKind then case convEc ec1 (ctxDepth ctx) argTy (neutralHeadOrSelf forced) of
        OkC ec2 => OkC ec2
        ErrC e => constrainDictDomGoKFuel (fuel - 1) globals ec1 ctx argTy argKind rest sp
      else constrainDictDomGoKFuel (fuel - 1) globals ec1 ctx argTy argKind rest sp

-- ---------------------------------------------------------------
-- Nat 字面量 / 算术特化 / Nat→Int 隐式提升
-- ---------------------------------------------------------------
-- Nat 的类型层表示仍是 Zero/Succ 链；字面量在**期望类型为 canonical Nat**时展开成链，
-- codegen 再把链折回 OCaml int。`natToInt` 提升是精化期唯一允许的隐式方向。
natLitTermGo : Int -> Term -> Term
natLitTermGo n acc = if n <= 0 then acc else natLitTermGo (n - 1) (TCon natSuccCtor [Pair acc Rig1])

natLitTerm : Int -> Term
natLitTerm n = natLitTermGo n (TCon natZeroCtor [])

-- C40 起十进制字面量在词法期已限定在 0..maxInt（越界报 LX_IntLiteralOutOfRange），
-- 因此这里的负数检查只是防御内部不变量（保留错误码，避免旧路径静默接受非法值）。
natLitResult : Span -> Int -> Check Term
natLitResult sp n = if n < 0 then tcErr0 sp NatLiteralOutOfRange else OkC (natLitTerm n)

natToIntTerm : Term -> Term
natToIntTerm t = TApp (TGlobal "natToInt") t Rig1

intTyValue : Value
intTyValue = VNeutral (NGlobal intTypeName [])

natTyValue : Value
natTyValue = VNeutral (NGlobal natTypeName [])

-- | Float 类型作为 Value 的表示（中性全局 `Float` 零实参）。
floatTyValue : Value
floatTyValue = VNeutral (NGlobal floatTypeName [])

isIntTy : Ec -> Value -> Bool
isIntTy ec v = case forceVal ec v of
  VNeutral (NGlobal g []) => g == intTypeName
  _ => False

isNatTy : Ec -> Value -> Bool
isNatTy ec v = case forceVal ec v of
  VNeutral (NGlobal g []) => g == natTypeName
  _ => False

-- | 判断值是否是内建 Float 类型。
isFloatTy : Ec -> Value -> Bool
isFloatTy ec v = case forceVal ec v of
  VNeutral (NGlobal g []) => g == floatTypeName
  _ => False

-- 只在「期望 Int、实际 Nat」时插入 natToInt；反向没有隐式提升。
coerceTerm : Ec -> Value -> Value -> Term -> Maybe Term
coerceTerm ec expected actual term =
  if isIntTy ec expected && isNatTy ec actual then Just (natToIntTerm term) else Nothing

-- 比较运算符：Nat 值直接按 Int 比较（运行时就是 int），混合时把 Nat 一侧提升。
coerceNatOperands : Ec -> Value -> Value -> Term -> Term -> Maybe (Pair (Pair Value Value) (Pair Term Term))
coerceNatOperands ec aTy bTy aTerm bTerm =
  if isNatTy ec aTy && isNatTy ec bTy then Just (Pair (Pair intTyValue intTyValue) (Pair (natToIntTerm aTerm) (natToIntTerm bTerm)))
  else if isNatTy ec aTy && isIntTy ec bTy then Just (Pair (Pair intTyValue bTy) (Pair (natToIntTerm aTerm) bTerm))
  else if isIntTy ec aTy && isNatTy ec bTy then Just (Pair (Pair aTy intTyValue) (Pair aTerm (natToIntTerm bTerm)))
  else Nothing

-- D23 Stage1：算术运算符名。Stage 1 仍走内建 `+ - * /`；同时认 `Base.Num` 的
-- 方法投影（`add/sub/mul/div`），映射回规范运算符名后复用同一套特化——这样 Stage 2
-- 把 `+` 别名到 `add` 后，实例体 `add x y = x + y` 仍降级成内建原语，不会退化成
-- （自递归的）普通字典方法调用。具体类型不是 Int/Nat/Float 时特化返回 Nothing，
-- 调用方回落到普通 trait 应用（泛型 `Num a =>` 代码走这条）。
-- 只有限定名（方法投影 `Base.Num.add`，含 `.`）才需要查类表；裸运算符名在上面直接
-- 返回，避免给每个普通应用都加 4 次类表扫描。
arithOpNameOf : Ec -> String -> Maybe String
arithOpNameOf ec "+" = Just "+"
arithOpNameOf ec "-" = Just "-"
arithOpNameOf ec "*" = Just "*"
arithOpNameOf ec "/" = Just "/"
arithOpNameOf ec name = if containsDot name then numMethodOpName ec name else Nothing

arithNatName : String -> String
arithNatName "+" = "natAdd"
arithNatName "-" = "natSub"
arithNatName "*" = "natMul"
arithNatName _ = "natDiv"

intApp2 : String -> Term -> Term -> Term
intApp2 name a b = TApp (TApp (TGlobal name) a Rig1) b Rig1

natApp2 : String -> Term -> Term -> Term
natApp2 name a b = TApp (TApp (TGlobal (arithNatName name)) a Rig1) b Rig1

-- 浮点算术：特化到内部 `bi_*_float`（与 Int / Nat 同一条精化期降级路径）。
-- | 把浮点二元运算构造成内部原语应用 `bi_*_float`。
floatApp2 : String -> Term -> Term -> Term
floatApp2 name a b = TApp (TApp (TGlobal (arithFloatName name)) a Rig1) b Rig1

-- | 浮点算术运算符到内部原语名的映射（`+` `-` `*` `/`）。
arithFloatName : String -> String
arithFloatName "+" = "bi_add_float"
arithFloatName "-" = "bi_sub_float"
arithFloatName "*" = "bi_mul_float"
arithFloatName _ = "bi_div_float"

isEIntExpr : Expr -> Maybe Int
isEIntExpr (EInt n sp) = Just n
isEIntExpr _ = Nothing

-- check 模式的算术：期望类型直接决定结果域；期望 Nat 时实参也按 Nat 检查（字面量因此
-- 能写字面量），期望 Int 时 Nat 实参经隐式提升。
-- | 算术特化的 check 入口：先把 `Base.Num` 方法投影规范化成运算符名，再交给具体类型分支。
specializeArithCheckFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Value -> Span -> Check (Maybe (Pair Term Ec))
specializeArithCheckFuel fuel globals ctx ec name args expected sp = if fuel <= 0 then icFuel "inference"
else case arithOpNameOf ec name of
  Just op => specializeArithCheckOpFuel (fuel - 1) globals ctx ec op args expected sp
  Nothing => OkC Nothing

-- | check 方向的算术特化（`op` 已是规范运算符名）：期望类型决定结果域。
specializeArithCheckOpFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Value -> Span -> Check (Maybe (Pair Term Ec))
specializeArithCheckOpFuel fuel globals ctx ec op args expected sp = if fuel <= 0 then icFuel "inference"
else case args of
  [a, b] => if isNatTy ec expected then Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec a natTyValue) (\pa => case pa of
    Pair aTerm ec1 => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec1 b natTyValue) (\pb => case pb of
      Pair bTerm ec2 => OkC (Just (Pair (natApp2 op aTerm bTerm) ec2))
    )
  )
  else if isIntTy ec expected then Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec a intTyValue) (\pa => case pa of
    Pair aTerm ec1 => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec1 b intTyValue) (\pb => case pb of
      Pair bTerm ec2 => OkC (Just (Pair (intApp2 op aTerm bTerm) ec2))
    )
  )
  else if isFloatTy ec expected then Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec a floatTyValue) (\pa => case pa of
    Pair aTerm ec1 => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec1 b floatTyValue) (\pb => case pb of
      Pair bTerm ec2 => OkC (Just (Pair (floatApp2 op aTerm bTerm) ec2))
    )
  )
  else OkC Nothing
  _ => OkC Nothing

-- infer 模式的算术：两侧都 Nat（或 Nat + 整数字面量）→ Nat；任一真正 Int → Int（Nat 提升）。
-- | 算术特化的 infer 入口：先把 `Base.Num` 方法投影规范化成运算符名，再交给具体类型分支。
specializeArithAppFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeArithAppFuel fuel globals ctx ec name args sp = if fuel <= 0 then icFuel "inference"
else case arithOpNameOf ec name of
  Just op => specializeArithAppOpFuel (fuel - 1) globals ctx ec op args sp
  Nothing => OkC Nothing

-- | infer 方向的算术特化（`op` 已是规范运算符名）：按实参类型决定结果域与 Nat 提升。
specializeArithAppOpFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeArithAppOpFuel fuel globals ctx ec op args sp = if fuel <= 0 then icFuel "inference"
else case args of
  [a, b] => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec a) (\pa => case pa of
    Pair aTerm (Pair aTy ec1) => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec1 b) (\pb => case pb of
      Pair bTerm (Pair bTy ec2) => if isNatTy ec2 aTy && isNatTy ec2 bTy then OkC (Just (Pair (natApp2 op aTerm bTerm) (Pair natTyValue ec2)))
      else if isIntTy ec2 aTy && isIntTy ec2 bTy then OkC (Just (Pair (intApp2 op aTerm bTerm) (Pair intTyValue ec2)))
      else if isFloatTy ec2 aTy && isFloatTy ec2 bTy then OkC (Just (Pair (floatApp2 op aTerm bTerm) (Pair floatTyValue ec2)))
      else if isNatTy ec2 aTy && isIntTy ec2 bTy then case isEIntExpr b of
        Just n =>
          Vuna.Compiler.Common.bind (natLitResult (exprSpan b) n)
            (\bNat => OkC (Just (Pair (natApp2 op aTerm bNat) (Pair natTyValue ec2))))
        Nothing => OkC (Just (Pair (intApp2 op (natToIntTerm aTerm) bTerm) (Pair intTyValue ec2)))
      else if isIntTy ec2 aTy && isNatTy ec2 bTy then case isEIntExpr a of
        Just n =>
          Vuna.Compiler.Common.bind (natLitResult (exprSpan a) n)
            (\aNat => OkC (Just (Pair (natApp2 op aNat bTerm) (Pair natTyValue ec2))))
        Nothing => OkC (Just (Pair (intApp2 op aTerm (natToIntTerm bTerm)) (Pair intTyValue ec2)))
      else OkC Nothing
    )
  )
  _ => OkC Nothing

export checkEFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Check (Pair Term Ec)
checkEFuel fuel globals ctx ec expr expected = if fuel <= 0 then icFuel "inference"
else case handleOperand expr of
  -- 首选 rowRem 版（条目可在行中任意位置，名字由 Member 行解）。失败后重试行首条目版：
  -- comp 是行多态表达式（`pure e`/内联 do 块）时 rowRem 的 `r` 仍是未解 meta、结果行在
  -- 调用点 conv 卡住；行首版把期望结果行交给 `{er}`、名字取默认实例名，comp 的行就被定成
  -- `Cons n e er`。comp 的行已具体时行首版只会同样失败，原错误（e1）保留。
  Just _ => Vuna.Compiler.Common.bind (handleCallExpr globals ec expr (exprSpan expr)) (\callExpr => case checkEFuel (fuel - 1) globals ctx ec callExpr expected of
    OkC r => OkC r
    ErrC e1 => Vuna.Compiler.Common.bind (handleCallExprAt globals ec expr (exprSpan expr)) (\callExpr2 => case checkEFuel (fuel - 1) globals ctx ec callExpr2 expected of
      OkC r2 => OkC r2
      ErrC _ => ErrC e1
    )
  )
  Nothing => case performOperand expr of
    Just _ => checkByInferFuel (fuel - 1) globals ctx ec expr expected
    Nothing => case appAtOperand expr of
      Just _ =>
        Vuna.Compiler.Common.bind (appAtCallExpr expr)
          (\callExpr => checkEFuel (fuel - 1) globals ctx ec callExpr expected)
      Nothing => case listLitElems expr of
        Just elems =>
          Vuna.Compiler.Common.bind
            (expandListLit ec (listLitFamily ec (forceVal ec expected)) elems (exprSpan expr))
            (\e2 => checkEFuel (fuel - 1) globals ctx ec e2 expected)
        Nothing => checkEFuelNoRow fuel globals ctx ec expr expected

-- 字面量转换（FromString / FromInt）：期望类型不是内建字面量类型时，若期望类型上存在
-- 对应 trait 的实例，就把字面量降级成 trait 方法应用（`fromString "s"` / `fromInt n`），
-- 交给现有 `EApp` 精化处理隐式类参、字典 binder 与延迟字典目标；搜索失败返回 Nothing，
-- 调用方回退到原推断路径（诊断不变）。探针与随后降级各查一次实例，只有非内建期望类型
-- 位置会走到。
-- | 把内建字面量降级成 FromString / FromInt 等方法应用；无实例时返回 Nothing。
literalTraitLower : List (Pair String Term) -> Ctx -> Ec -> String -> String -> Expr -> Value -> Span -> Maybe (Pair Expr Ec)
literalTraitLower globals ctx ec traitName methodName lit expected sp =
  let
    dictDom = VNeutral (NGlobal (dictTypeName traitName) [forceVal ec expected])
  in case searchInstanceIn globals ctx ec dictDom sp of
    ErrC _ => Nothing
    OkC (Pair _ ec1) => Just (Pair (EApp (EVar methodName sp) [lit] sp) ec1)

checkEFuelNoRow : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Check (Pair Term Ec)
checkEFuelNoRow fuel globals ctx ec expr expected = if fuel <= 0 then icFuel "inference"
else if doMarkerHead expr then case decodeDoBlock expr of
  Just chain => Vuna.Compiler.Common.bind (checkDoBlockFuel (fuel - 1) globals ctx ec chain expected) (\r => case r of
    Just p => OkC p
    Nothing => checkEFuelNoRowPlain fuel globals ctx ec (doChainFallback chain) expected
  )
  Nothing => checkEFuelNoRowPlain fuel globals ctx ec expr expected
else checkEFuelNoRowPlain fuel globals ctx ec expr expected

-- | check 模式的形状分派核心：处理洞、字面量、λ、应用与 let 等，不再试 do 标记链。
checkEFuelNoRowPlain : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Check (Pair Term Ec)
checkEFuelNoRowPlain fuel globals ctx ec expr expected = if fuel <= 0 then icFuel "inference"
else case expr of
  EVar name sp => if isHoleName name then
    let
      pmeta = newHoleMeta ctx ec sp expected (holeNameOf name)
    in case pmeta of
      Pair metaTerm ec1 => OkC (Pair metaTerm ec1)
  else if isOverCtorName name then Vuna.Compiler.Common.bind
    (resolveOverCtor ec sp (Just expected) (overCtorShort name) (overCtorTargets name))
    (\t => checkAppFuel (fuel - 1) globals ctx ec (EVar t sp) [] expected sp)
  else checkAppFuel (fuel - 1) globals ctx ec (EVar name sp) [] expected sp
  EInt n sp => case forceVal ec expected of
    VNeutral (NGlobal g []) => if g == natTypeName then Vuna.Compiler.Common.bind (natLitResult sp n) (\t => OkC (Pair t ec))
    else if g == intTypeName then checkByInferFuel (fuel - 1) globals ctx ec expr expected
    else case literalTraitLower globals ctx ec fromIntTypeName fromIntMethodName expr expected sp of
      Just (Pair lower ec1) => checkEFuel (fuel - 1) globals ctx ec1 lower expected
      Nothing => checkByInferFuel (fuel - 1) globals ctx ec expr expected
    VMeta _ _ => checkByInferFuel (fuel - 1) globals ctx ec expr expected
    _ => case literalTraitLower globals ctx ec fromIntTypeName fromIntMethodName expr expected sp of
      Just (Pair lower ec1) => checkEFuel (fuel - 1) globals ctx ec1 lower expected
      Nothing => checkByInferFuel (fuel - 1) globals ctx ec expr expected
  EStr s sp => case forceVal ec expected of
    VNeutral (NGlobal g []) => if g == strTypeName then OkC (Pair (TStr s) ec)
    else case literalTraitLower globals ctx ec fromStringTypeName fromStringMethodName expr expected sp of
      Just (Pair lower ec1) => checkEFuel (fuel - 1) globals ctx ec1 lower expected
      Nothing => checkByInferFuel (fuel - 1) globals ctx ec expr expected
    VMeta _ _ => checkByInferFuel (fuel - 1) globals ctx ec expr expected
    _ => case literalTraitLower globals ctx ec fromStringTypeName fromStringMethodName expr expected sp of
      Just (Pair lower ec1) => checkEFuel (fuel - 1) globals ctx ec1 lower expected
      Nothing => checkByInferFuel (fuel - 1) globals ctx ec expr expected
  EFloat raw sp => case forceVal ec expected of
    VNeutral (NGlobal g []) => if g == floatTypeName then OkC (Pair (TFloat raw) ec)
    else case literalTraitLower globals ctx ec fromFloatTypeName fromFloatMethodName expr expected sp of
      Just (Pair lower ec1) => checkEFuel (fuel - 1) globals ctx ec1 lower expected
      Nothing => checkByInferFuel (fuel - 1) globals ctx ec expr expected
    VMeta _ _ => checkByInferFuel (fuel - 1) globals ctx ec expr expected
    _ => case literalTraitLower globals ctx ec fromFloatTypeName fromFloatMethodName expr expected sp of
      Just (Pair lower ec1) => checkEFuel (fuel - 1) globals ctx ec1 lower expected
      Nothing => checkByInferFuel (fuel - 1) globals ctx ec expr expected
  ELam names body sp => checkLamFuel (fuel - 1) globals ctx ec names body expected sp
  EApp (EVar "->" _) args sp => checkByInferFuel (fuel - 1) globals ctx ec expr expected
  EApp (EVar "Type" _) args sp => checkByInferFuel (fuel - 1) globals ctx ec expr expected
  EApp (EVar n fsp) args sp =>
    if isInstArgSyntax n then tcErr0 sp NoInstParam
    else checkAppFuel (fuel - 1) globals ctx ec (EVar n fsp) args expected sp
  EApp fn args sp => checkAppFuel (fuel - 1) globals ctx ec fn args expected sp
  EPi name implicit qty dom cod sp => checkByInferFuel (fuel - 1) globals ctx ec expr expected
  EIf c t e sp => checkByInferFuel (fuel - 1) globals ctx ec expr expected
  ECase scrut alts csp => checkCaseFuel (fuel - 1) globals ctx ec scrut alts expected csp
  ELet binds body rec_ sp => checkLetFuel (fuel - 1) globals ctx ec binds body rec_ expected sp
  -- A2：防御分支——正常路径已在绑定块入口展开；普通表达式位置直接降级后重查。
  ELocalFun clauses sp => if clausesHaveOverCtor clauses then Vuna.Compiler.Common.bind (resolveOverFunPats ec ctx expected clauses) (\r => case r of
    Pair clauses2 ec1 =>
      Vuna.Compiler.Common.bind (multiToExpr (ctorFamilyTable ec1) clauses2)
        (\bodyExpr => checkEFuel (fuel - 1) globals ctx ec1 bodyExpr expected)
  )
  else Vuna.Compiler.Common.bind (expandLocalFuns ec (ELocalFun clauses sp))
    (\e2 => checkEFuel (fuel - 1) globals ctx ec e2 expected)
  -- M24：`EAnn` 在 check 位等价于「按标注类型检查内部表达式」。
  EAnn value ty sp => Vuna.Compiler.Common.bind (checkTypeFuel (fuel - 1) globals ctx ec ty) (\pt => case pt of
    Pair tyTerm (Pair _ ec1) =>
      checkEFuel (fuel - 1) globals ctx ec1 value (eval (ctxEnv ctx) tyTerm)
  )
  _ => checkByInferFuel (fuel - 1) globals ctx ec expr expected

-- ---------------------------------------------------------------
-- M19：`let` 表达式
-- ---------------------------------------------------------------
-- 逐条处理：推断绑定值 → 上下文绑名 → 处理后续与 body → `(\x => body) value`（beta 等价）。
-- 不引入 `TLet`（`let` 是纯记法，不是类型论构造）；`rig` 由绑定值类型经 `binderRig` 决定，
-- 与函数参数自动一致。后续绑定可见前面（顺序 let），不互递归；构造子模式 let 等价 case。
-- 统一绑定块（M28）：`let` 与 `where` 走同一套顺序作用域；`where` 多一条记法约束
-- （签名行必填，`checkBindingSigs`）。签名绑定在 parser 里已降级成 `EAnn value ty`，
-- 值一律按签名以 checking 模式精化（`inferEFuel` 的 EAnn 分支），因此这里不再区分来源。
export checkLetFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> Expr -> Bool -> Value -> Span -> Check (Pair Term Ec)
checkLetFuel fuel globals ctx ec binds body rec_ expected sp =
  if fuel <= 0 then icFuel "inference"
  else Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (expandBind ec) binds)
    (\binds2 => Vuna.Compiler.Common.bind (checkBindingSigs rec_ binds2) (\_ => checkLetGoFuel (fuel - 1) globals ctx ec binds2 body rec_ expected sp))

-- A2：把 `ELocalFun`（where/let 多 clause 函数）用 `Elab.Match.multiToExpr` 的模式矩阵
-- 降级成普通表达式（lambda + case/if），与顶层 DFun 的 `elabFunDef` 走同一条路径。
-- 只展开**顶层** `ELocalFun`；结果里嵌套的 `ELocalFun` 由 `checkEFuel`/`inferEFuel` 的
-- `ELocalFun` 分支在继续精化时再展开（结构递归只沿输入表达式的子项，SCT 可证）。
-- | 自动补注（M41 新增导出）：patHasOverCtor。
patHasOverCtor : Pat -> Bool
patHasOverCtor (PCon name args sp) =
  if isInternalSyntaxName name then True else anyPatHasOverCtor args
patHasOverCtor (PAs name inner sp) = patHasOverCtor inner
patHasOverCtor (PRecord name fields sp) = anyFieldHasOverCtor fields
patHasOverCtor _ = False

-- | 自动补注（M41 新增导出）：anyPatHasOverCtor。
anyPatHasOverCtor : List Pat -> Bool
anyPatHasOverCtor [] = False
anyPatHasOverCtor (p :: rest) = patHasOverCtor p || anyPatHasOverCtor rest

-- | 自动补注（M41 新增导出）：anyFieldHasOverCtor。
anyFieldHasOverCtor : List (Pair String Pat) -> Bool
anyFieldHasOverCtor [] = False
anyFieldHasOverCtor ((Pair f p) :: rest) = patHasOverCtor p || anyFieldHasOverCtor rest

-- | 自动补注（M41 新增导出）：clausesHaveOverCtor。
clausesHaveOverCtor : List (Pair (List Pat) Expr) -> Bool
clausesHaveOverCtor [] = False
clausesHaveOverCtor ((Pair pats body) :: rest) = anyPatHasOverCtor pats || clausesHaveOverCtor rest

-- | 自动补注（M41 新增导出）：expandLocalFuns。
expandLocalFuns : Ec -> Expr -> Check Expr
expandLocalFuns ec (ELocalFun clauses sp) =
  if clausesHaveOverCtor clauses then OkC (ELocalFun clauses sp)
  else multiToExpr (ctorFamilyTable ec) clauses
expandLocalFuns ec (EVar name sp) = OkC (EVar name sp)
expandLocalFuns ec (EInt n sp) = OkC (EInt n sp)
expandLocalFuns ec (EStr s sp) = OkC (EStr s sp)
expandLocalFuns ec (EFloat raw sp) = OkC (EFloat raw sp)
expandLocalFuns ec (ELam names body sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec body) (\b2 => OkC (ELam names b2 sp))
expandLocalFuns ec (EApp fn args sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec fn)
    (\fn2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (expandLocalFuns ec) args) (\args2 => OkC (EApp fn2 args2 sp)))
expandLocalFuns ec (EPi name implicit qty dom cod sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec dom)
    (\dom2 => Vuna.Compiler.Common.bind (expandLocalFuns ec cod) (\cod2 => OkC (EPi name implicit qty dom2 cod2 sp)))
expandLocalFuns ec (ELet binds body rec_ sp) =
  Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (expandBind ec) binds)
    (\binds2 => Vuna.Compiler.Common.bind (expandLocalFuns ec body) (\body2 => OkC (ELet binds2 body2 rec_ sp)))
expandLocalFuns ec (ECase scrut alts sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec scrut)
    (\scrut2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (expandBind ec) alts) (\alts2 => OkC (ECase scrut2 alts2 sp)))
expandLocalFuns ec (EIf c t el sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec c)
    (\c2 => Vuna.Compiler.Common.bind (expandLocalFuns ec t) (\t2 => Vuna.Compiler.Common.bind (expandLocalFuns ec el) (\el2 => OkC (EIf c2 t2 el2 sp))))
expandLocalFuns ec (EField base fname sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec base) (\base2 => OkC (EField base2 fname sp))
expandLocalFuns ec (ERecord rname fields sp) =
  Vuna.Compiler.Common.bind
    (Vuna.Compiler.Common.traverse (\fv => Vuna.Compiler.Common.bind (expandLocalFuns ec (secondOf fv)) (\v2 => OkC (Pair (firstOf fv) v2))) fields)
    (\fields2 => OkC (ERecord rname fields2 sp))
expandLocalFuns ec (ERecUpdate base fields sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec base)
    (\base2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (\fv => Vuna.Compiler.Common.bind (expandLocalFuns ec (secondOf fv)) (\v2 => OkC (Pair (firstOf fv) v2))) fields) (\fields2 => OkC (ERecUpdate base2 fields2 sp)))
expandLocalFuns ec (EDo stmts sp) =
  Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (expandDoStmt ec) stmts)
    (\stmts2 => OkC (EDo stmts2 sp))
expandLocalFuns ec (EAnn value ty sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec value) (\value2 => OkC (EAnn value2 ty sp))
expandLocalFuns ec _ = icInternal "unreordered infix/paren in elaboration"

expandBind : Ec -> Pair Pat Expr -> Check (Pair Pat Expr)
expandBind ec (Pair pat value) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec value) (\v2 => OkC (Pair pat v2))

expandDoStmt : Ec -> DoStmt -> Check DoStmt
expandDoStmt ec (DBind pat value sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec value) (\v2 => OkC (DBind pat v2 sp))
expandDoStmt ec (DExpr value sp) =
  Vuna.Compiler.Common.bind (expandLocalFuns ec value) (\v2 => OkC (DExpr v2 sp))

-- M19：推断位的 `let`（嵌套 let 的 value 位置就是推断位）。
export inferLetFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> Expr -> Bool -> Span -> Check (Pair Term (Pair Value Ec))
inferLetFuel fuel globals ctx ec binds body rec_ sp =
  if fuel <= 0 then icFuel "inference"
  else Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (expandBind ec) binds)
    (\binds2 => Vuna.Compiler.Common.bind (checkBindingSigs rec_ binds2) (\_ => inferLetGoFuel (fuel - 1) globals ctx ec binds2 body rec_ sp))

-- M24：where/let 绑定块是**顺序 let**：每个绑定只看得到它之前的绑定；递归放顶层定义组。
export checkLetGoFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> Expr -> Bool -> Value -> Span -> Check (Pair Term Ec)
checkLetGoFuel fuel globals ctx ec [] body rec_ expected sp =
  if fuel <= 0 then icFuel "inference" else checkEFuel (fuel - 1) globals ctx ec body expected
checkLetGoFuel fuel globals ctx ec (bind :: rest) body rec_ expected sp =
  if fuel <= 0 then icFuel "inference"
  else checkLetOneFuel (fuel - 1) globals ctx ec bind rest body rec_ expected sp

export checkLetOneFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Pair Pat Expr -> List (Pair Pat Expr) -> Expr -> Bool -> Value -> Span -> Check (Pair Term Ec)
checkLetOneFuel fuel globals ctx ec bind rest body rec_ expected sp = if fuel <= 0 then icFuel "inference"
else case firstOf bind of
  PVar name psp =>
    let
      value = secondOf bind
    in Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec value) (\pv => case pv of
      Pair valueTerm (Pair valueTy ec1) =>
        let
          rig = rigOfLinearValue ec valueTy
          ctx2 = ctxBindValue name valueTy ctx
        in Vuna.Compiler.Common.bind (checkLetGoFuel (fuel - 1) globals ctx2 ec1 rest body rec_ expected sp) (\pb => case pb of
          Pair bodyTerm ec2 =>
            let
              bodyTerm2 =
                if isOpaqueRuntimeTyIn ec2 ctx valueTy then wrapOpaqueUses [0] bodyTerm
                else bodyTerm
            in OkC (Pair (TApp (TLam name rig bodyTerm2) valueTerm Rig1) ec2)
        )
    )
  PWild psp =>
    let
      value = secondOf bind
    in Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec value) (\pv => case pv of
      Pair valueTerm (Pair valueTy ec1) =>
        let
          rig = rigOfLinearValue ec valueTy
        in Vuna.Compiler.Common.bind (checkLetGoFuel (fuel - 1) globals ctx ec1 rest body rec_ expected sp) (\pb => case pb of
          -- 通配 let 的体是在**不 bind 名字**的上下文里检查的，但落项时仍套一层 TLam "_"：
          -- 体的 de Bruijn 索引必须整体 shift 1，否则所有外层引用都会指向错 binder。
          Pair bodyTerm ec2 =>
            OkC (Pair (TApp (TLam "_" rig (shift 0 1 bodyTerm)) valueTerm Rig1) ec2)
        )
    )
  -- A1：let 模式解构（`let (MkPoint x y) = p in ...`）等价单分支 case：
  -- 模式只能绑定变量/通配以外的形态时，把绑定降级成 `case value of pat => rest`，
  -- 穷尽性交给既有的 case 精化（不可失败模式通过，`Just` 这类非穷尽模式报覆盖性错误）。
  _ =>
    checkEFuel (fuel - 1) globals ctx ec
      (ECase (secondOf bind) [Pair (firstOf bind) (ELet rest body rec_ sp)] (patSpan (firstOf bind)))
      expected

-- M19：推断位的 `let`（嵌套 let 的 value 位置就是推断位）；入口见上方 `inferLetFuel`。
export inferLetGoFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List (Pair Pat Expr) -> Expr -> Bool -> Span -> Check (Pair Term (Pair Value Ec))
inferLetGoFuel fuel globals ctx ec binds body rec_ sp = if fuel <= 0 then icFuel "inference"
else case binds of
  [] => inferEFuel (fuel - 1) globals ctx ec body
  (Pair pat value) :: rest => case pat of
    PVar name psp => inferLetBoundFuel (fuel - 1) globals ctx ec name value rest body rec_ sp
    PWild psp => inferLetIgnoredFuel (fuel - 1) globals ctx ec value rest body rec_ sp
    -- A1：let 模式解构在推断位同样降级为单分支 case（见 checkLetOneFuel 的说明）。
    _ =>
      inferEFuel (fuel - 1) globals ctx ec
        (ECase value [Pair pat (ELet rest body rec_ sp)] (patSpan pat))

export inferLetBoundFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> Expr -> List (Pair Pat Expr) -> Expr -> Bool -> Span -> Check (Pair Term (Pair Value Ec))
inferLetBoundFuel fuel globals ctx ec name value rest body rec_ sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec value) (\pv => case pv of
  Pair valueTerm (Pair valueTy ec1) =>
    let
      rig = rigOfLinearValue ec valueTy
      ctx2 = ctxBindValue name valueTy ctx
    in Vuna.Compiler.Common.bind (inferLetFuel (fuel - 1) globals ctx2 ec1 rest body rec_ sp) (\pb => case pb of
      Pair bodyTerm (Pair bodyTy ec2) =>
        let
          bodyTerm2 =
            if isOpaqueRuntimeTyIn ec2 ctx valueTy then wrapOpaqueUses [0] bodyTerm else bodyTerm
        in OkC (Pair (TApp (TLam name rig bodyTerm2) valueTerm Rig1) (Pair bodyTy ec2))
    )
)

export inferLetIgnoredFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List (Pair Pat Expr) -> Expr -> Bool -> Span -> Check (Pair Term (Pair Value Ec))
inferLetIgnoredFuel fuel globals ctx ec value rest body rec_ sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec value) (\pv => case pv of
  Pair valueTerm (Pair valueTy ec1) =>
    let
      rig = rigOfLinearValue ec valueTy
    in Vuna.Compiler.Common.bind (inferLetFuel (fuel - 1) globals ctx ec1 rest body rec_ sp) (\pb => case pb of
      Pair bodyTerm (Pair bodyTy ec2) =>
        OkC (Pair (TApp (TLam "_" rig (shift 0 1 bodyTerm)) valueTerm Rig1) (Pair bodyTy ec2))
    )
)

-- S2：期望结果类型 hint。把剩余 Pi 链的每个 binder 用刚性占位变量实例化，取“残余结果
-- 类型”；占位变量 level 从 depth 起递增，若结果引用它们（levelEscapes depth 0 res），
-- 说明结果依赖显式实参，不能提前解字典类参数，调用方跳过。
-- | 用新鲜元变量逐个实例化 Pi 链，返回残余结果类型；供字典类参数提前求解使用。
stripPisWithMetas : Int -> Ctx -> Ec -> Value -> Check (Pair Value Ec)
stripPisWithMetas fuel ctx ec v = if fuel <= 0 then icFuel "inference"
else case forceVal ec v of
  VPi _ _ _ _ clo => case newMeta ctx ec of
    Pair metaTerm ec1 =>
      stripPisWithMetas (fuel - 1) ctx ec1 (applyClosure clo (eval (ctxEnv ctx) metaTerm))
  _ => OkC (Pair v ec)

-- | 判断值的头部是否是元变量（含裸元变量与带实参元变量）：S2 的期望结果类型 hint
-- 可以靠 conv 继续求解它。D23 起用户类型算术 `1 + 2 : MyNum` 的残余结果就是**裸**元变量
-- （`add : a -> a -> a` 的结果没有 spine）；旧实现只认带 spine 的元变量，会跳过 hint，
-- 让实参先被推断成 Int。裸元变量同样能靠后续 conv 求解，一并接受。
isMetaHeadedValue : Ec -> Value -> Bool
isMetaHeadedValue ec v = case forceVal ec v of
  VMeta _ _ => True
  _ => False

-- | 判断值的头部是否是刚性构造（全局、变量或构造子），即不是元变量。
isRigidHeadValue : Ec -> Value -> Bool
isRigidHeadValue ec v = case forceVal ec v of
  VNeutral (NGlobal _ _) => True
  VNeutral (NVar _ _ _) => True
  VCon _ _ => True
  _ => False

-- 只在“前导隐式前缀新增了延迟约束 + 残余结果 meta 头 + 期望刚性头”时，先把剩余显式
-- binder 用**新鲜 meta** 实例化取残余结果，再 conv 期望类型；成功就把这次 early solve
-- 带回（`?m`/`?b` 同时解出），失败丢弃整份快照，调用方照常检查实参。
-- | 用期望结果类型提前解出延迟的字典约束：需要时用新鲜 meta 实例化剩余显式 binder，
-- 只有 conv 成功才带回解，失败返回 Nothing。
tryUseHint : Int -> Ctx -> Value -> Ec -> Value -> Maybe Ec
tryUseHint goals0 ctx expected ec piTy = if length (ecPending ec) <= goals0 then Nothing
else case stripPisWithMetas 64 ctx ec piTy of
  ErrC _ => Nothing
  OkC (Pair res ec1) =>
    let
      forcedRes = forceVal ec1 res
    in if isMetaHeadedValue ec1 forcedRes then if isRigidHeadValue ec1 expected then case convEc ec1 (ctxDepth ctx) expected forcedRes of
      ErrC _ => Nothing
      OkC ec2 => Just ec2
    else Nothing
    else Nothing

-- 与 inferEFuel 同形，只对 EApp 把期望结果类型传进 inferAppFuel（其余形状走旧路径）。
-- 不复制 inferAppFuel 的 ctor/over-ctor/运算符分派，避免绕过分派导致的燃料问题。
-- | 与 inferEFuel 同形，但 EApp 会把期望结果类型作为 hint 传进推断入口。
inferEFuelHint : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Check (Pair Term (Pair Value Ec))
inferEFuelHint fuel globals ctx ec expr expected = if fuel <= 0 then icFuel "inference"
else case handleOperand expr of
  -- handle 标记必须先于 perform/EApp 分解拦截（否则标记名会被当普通变量解析）。
  Just _ => inferEFuel (fuel - 1) globals ctx ec expr
  Nothing => case performOperand expr of
    -- perform 标记必须先于 EApp 分解拦截（否则会把标记名当普通变量解析）。
    Just _ => inferEFuel (fuel - 1) globals ctx ec expr
    Nothing => case appAtOperand expr of
      Just _ =>
        Vuna.Compiler.Common.bind (appAtCallExpr expr)
          (\callExpr => inferEFuel (fuel - 1) globals ctx ec callExpr)
      Nothing => case expr of
        EApp fn args sp =>
          inferAppFuel (fuel - 1) globals ctx ec fn args sp
            (Just (Pair (length (ecPending ec)) expected))
        _ => inferEFuel fuel globals ctx ec expr

-- ---------------------------------------------------------------
-- F3-1：运行入口的未处理效应诊断
-- ---------------------------------------------------------------
-- 期望类型是 `Eff [] a`、实际类型是 `Eff r a`（r 为具体非空行）时，报
-- `TC_UnhandledEffects` 并列出标签，而不是裸的 `TC_TypeMismatch`。
-- 触发位置不限于 `runPure`：任何要求 Nil 行的期望都适用。
-- | 从 `Eff row a` 值里取出 (row, a)；不是 Eff 应用返回 Nothing。
effRowAndResult : Value -> Maybe (Pair Value Value)
effRowAndResult (VNeutral (NGlobal g (r :: a :: _))) =
  if g == effTypeName then Just (Pair r a) else Nothing
effRowAndResult _ = Nothing

-- | 从 `Eff row a` 值里取出 row；不是 Eff 应用返回 Nothing。
export effRowOfValue : Value -> Maybe Value
effRowOfValue v = case effRowAndResult v of
  Just p => Just (firstOf p)
  Nothing => Nothing

-- | 行是否为 `Nil`（强归约后）。
export isNilRowValue : Ec -> Value -> Bool
isNilRowValue ec v = case forceVal ec v of
  VCon n _ => n == effRowNilCtor
  _ => False

-- | 命名行条目的 (名字, (标签, 尾行))：`Cons n e t`（3 实参）。不是行条目返回 Nothing。
-- 单个 Cons 分支：规避旧编译器在深/浅两个 Cons 分支回退时的变量串位（debt D53）。
effConsLabelTail : Value -> Maybe (Pair Value (Pair Value Value))
effConsLabelTail (VCon consName (n :: e :: t :: _)) =
  if consName == effRowConsCtor then Just (Pair n (Pair e t)) else Nothing
effConsLabelTail _ = Nothing

-- | 全局名的最后一段（诊断里不显示模块前缀）。
shortGlobalName : String -> String
shortGlobalName g = case splitLastDot (splitOnDot g) of
  Pair _ last => last

-- | 行条目标签的紧凑文本：`ConsoleOp`、`StateOp Nat`（head 去模块前缀，参数按值展示）。
rowLabelText : Ec -> Value -> String
rowLabelText ec v = case forceVal ec v of
  VNeutral (NGlobal g sp) => labelHeadArgs (shortGlobalName g) sp
  _ => showValueAt 6 v

labelHeadArgs : String -> List Value -> String
labelHeadArgs head [] = head
labelHeadArgs head (a :: rest) = labelHeadArgs (head ++ " " ++ showValueAt 6 a) rest

-- | 行条目的实例名文本（String 去引号）。
rowNameText : Ec -> Value -> String
rowNameText ec v = case forceVal ec v of
  VStr s => s
  _ => showValueAt 6 v

-- | 行条目展示：`ConsoleOp@default`、`StateOp Nat@counter`。
rowEntryText : Ec -> Value -> Value -> String
rowEntryText ec n h = rowLabelText ec h ++ "@" ++ rowNameText ec n

-- | 具体行里的标签列表；遇到未解元变量/未知形态返回 Nothing（不猜）。
export rowEffectLabels : Int -> Ec -> Value -> Maybe (List String)
rowEffectLabels fuel ec row = if fuel <= 0 then Nothing
else case forceVal ec row of
  VCon consName cargs => if consName == effRowNilCtor then Just []
  else if consName == effRowConsCtor then case effConsLabelTail (VCon consName cargs) of
    Just (Pair n (Pair h t)) => if hasUnsolvedMetaValue (ecSolsP ec) h then Nothing
    else case rowEffectLabels (fuel - 1) ec t of
      Just labels => Just (Base.List.Cons (rowEntryText ec n h) labels)
      Nothing => Nothing
    Nothing => Nothing
  else Nothing
  _ => Nothing

-- | 标签列表拼成逗号分隔（不引入 Base.String 依赖）。
export joinEffectLabels : List String -> String
joinEffectLabels [] = ""
joinEffectLabels (x :: rest) = case rest of
  [] => x
  _ => x ++ ", " ++ joinEffectLabels rest

-- | 若「期望 Nil 行 / 实际具体非空行」则返回标签文本。
unhandledEffectLabel : Ec -> Value -> Value -> Maybe (List String)
unhandledEffectLabel ec expected actual = case effRowOfValue (forceVal ec expected) of
  Nothing => Nothing
  Just expectedRow => if isNilRowValue ec expectedRow then case effRowOfValue (forceVal ec actual) of
    Nothing => Nothing
    Just actualRow => case rowEffectLabels 64 ec actualRow of
      Just labels => if labels == [] then Nothing else Just labels
      Nothing => Nothing
  else Nothing

-- D51：自动 Effect 行 lift。conv 失配时若「期望 = `Eff (Cons e tail) a`」且「实际的行与
-- tail 相等」，就用 `Base.Eff.weaken` 把实际动作提升到更大的行（运行时是恒等，只是类型
-- 层面的行扩宽）。**不调用 `checkEFuel`**（只构造项，避免与 checkByInferFuel 形成 SCT
-- 互递归）；weaken 不在作用域时不触发，由调用方回退旧诊断（`TC_UnhandledEffects` 或
-- 普通 mismatch）。期望是 `Eff []` 时也不触发：那是未处理效应，必须报 `TC_UnhandledEffects`。
-- 阶段 5：行包含判断（actual 行 ⊆ expected 行，按 label 值相等，无序）。
-- 只在 Elab 内部用；lift 后运行时恒等（Eff 的行擦除），不插入项。
sameLabelValue : Value -> Value -> Bool
sameLabelValue a b = showTerm (quote 0 a) == showTerm (quote 0 b)

rowContainsValue : Ec -> Int -> Value -> Value -> Bool
rowContainsValue ec fuel expected label = if fuel <= 0 then False
else case forceVal ec expected of
  VCon g args => if g == effRowConsCtor then case args of
    _ :: l2 :: tail :: _ =>
      sameLabelValue label l2 || rowContainsValue ec (fuel - 1) (forceVal ec tail) label
    _ => False
  else False
  _ => False

rowSubValue : Ec -> Int -> Value -> Value -> Bool
rowSubValue ec fuel actual expected = if fuel <= 0 then False
else case forceVal ec actual of
  VCon g args => if g == effRowNilCtor then True
  else if g == effRowConsCtor then case args of
    _ :: label :: tail :: _ =>
      rowContainsValue ec (fuel - 1) expected label
        && rowSubValue ec (fuel - 1) (forceVal ec tail) expected
    _ => False
  else False
  _ => False

-- | D51 自动行 lift：`actual : Eff r a` 遇到期望 `Eff (Cons e r) a` 时返回插入
-- `Base.Eff.weaken` 的项与 conv 解出的 Ec；条件不满足 / weaken 不可见 / 期望为空行时
-- 返回 Nothing。
tryEffLift : Ctx -> List (Pair String Term) -> Ec -> Value -> Value -> Term -> Maybe (Pair Term Ec)
tryEffLift ctx globals ec expected actual term = case globalsLookup "Base.Eff.weaken" globals ec of
  Nothing => Nothing
  Just _ =>
    let
      d = ctxDepth ctx
    in case effRowAndResult (forceVal ec expected) of
      Nothing => Nothing
      Just p => case effConsLabelTail (forceVal ec (firstOf p)) of
        Nothing => Nothing
        Just (Pair nV (Pair eV tailV)) =>
          let
            tailF = forceVal ec tailV
          in if hasUnsolvedMetaValue (ecSolsP ec) tailF then Nothing
          else case effRowOfValue (forceVal ec actual) of
            -- 期望的尾行必须已经具体：尾行是未解元变量时不做 lift——否则 conv 会把它解成
            -- 「实际行」，把真正的行不匹配（如 handler 实例名 `Fs "mock"` vs 程序 `Fs
            -- "real"`）伪装成合法 lift，错误被推迟到入口才暴露（dt_err/78 回归）。
            Nothing => Nothing
            Just actualRow => if rowSubValue ec 64 actualRow (firstOf p) then Just (Pair term ec)
            else if isNilRowValue ec actualRow then case globalsLookup "Base.Eff.raise" globals ec of
              -- 阶段 5：行包含 lift（actual 行 ⊆ expected 行）：运行时恒等，直接返回项。
              Nothing => Nothing
              Just _ =>
                Just
                  (Pair (TApp (TApp (TApp (TGlobal "Base.Eff.raise") (quote d (firstOf p)) Rig0) (quote d (secondOf p)) Rig0) term RigOmega) ec)
            else case convEc ec d actualRow tailF of
              ErrC _ => Nothing
              OkC ec2 =>
                Just
                  (Pair (TApp (TApp (TApp (TApp (TApp (TGlobal "Base.Eff.weaken") (quote d nV) Rig0) (quote d eV) Rig0) (quote d tailF) Rig0) (quote d (secondOf p)) Rig0) term RigOmega) ec2)

export checkByInferFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Check (Pair Term Ec)
checkByInferFuel fuel globals ctx ec expr expected = if fuel <= 0 then icFuel "inference"
else case inferEFuelHint (fuel - 1) globals ctx ec expr expected of
  ErrC e => ErrC e
  OkC (Pair term (Pair actual ec1)) => case coerceTerm ec1 expected actual term of
    Just coerced => OkC (Pair coerced (resolveDictGoals globals ec1))
    Nothing => case convEc ec1 (ctxDepth ctx) expected actual of
      ErrC e => case tryEffLift ctx globals ec1 expected actual term of
        Just p => OkC (Pair (firstOf p) (resolveDictGoals globals (secondOf p)))
        Nothing => case unhandledEffectLabel ec1 expected actual of
          Just labels =>
            onErrDiag
              (\d => withEffectLabels labels (withField (FieldEffect "actual: ${showValue actual}") (withField (FieldEffect "expected: ${showValue expected}") d)))
              (tcErr1 (exprSpan expr) (UnhandledEffects (joinEffectLabels labels)) (joinEffectLabels labels))
          Nothing => ErrC (withFallbackSpan (exprSpan expr) e)
      OkC ec2 => OkC (Pair term (resolveDictGoals globals ec2))

export checkLamFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> List String -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkLamFuel fuel globals ctx ec [] body expected sp =
  if fuel <= 0 then icFuel "inference" else checkEFuel (fuel - 1) globals ctx ec body expected
checkLamFuel fuel globals ctx ec (name :: rest) body expected sp = if fuel <= 0 then icFuel "inference"
else
  let
    forced = forceVal ec expected
  in case forced of
    VPi pname implicit rig dom clo =>
      let
        lvl = ctxDepth ctx
        v = freshVarValue pname lvl
        ctx2 = ctxBindValue name dom ctx
        expected2 = applyClosure clo v
      in Vuna.Compiler.Common.bind (rigForLinearDomain ec sp name rig dom) (\lamRig => Vuna.Compiler.Common.bind (checkLamFuel (fuel - 1) globals ctx2 ec rest body expected2 sp) (\p => case p of
        -- M18.5：lambda 形参与定义参数同一条规则——隐式 binder 恒擦除（隐式实参由
        -- 精化器插入，运行时不传），显式 binder 只有域是宇宙才擦除。
        -- M38：线性域的 binder 必须是 1；捕获外层线性值的 λ 不能逃逸。
        Pair inner ec1 =>
          let
            inner2 = if isOpaqueRuntimeTyIn ec1 ctx dom then wrapOpaqueUses [0] inner else inner
            -- W7：捕获线性值的 λ 不在这里直接拒绝——标记 binder 名，由 `Elab.Usage`
            -- 检查它是否落在「立即按 quantity 1 消费」的位置；不落则报
            -- TC_LinearCaptureEscapes（诊断码不变）。
            binderName =
              if ctxHasLinear ec ctx then if termHasOuterLinear ec ctx2 inner then linClosureName sp (ctxDepth ctx) name
              else name
              else name
          in OkC (Pair (TLam binderName lamRig inner2) ec1)
      )
      )
    -- B32：case 在推断位置时结果类型先是元变量；分支体是 λ 没有现成 Pi 可查。
    -- 为 domain/codomain 各建一个元变量，把期望元变量解成 Pi，再按普通 λ 检查。
    -- 仅处理空 spine 的裸元变量；非空 spine 的应用元变量维持原诊断。
    VMeta m [] =>
      let
        lvl = ctxDepth ctx
      in case newMetaAt sp ctx ec of
        Pair domTerm ec1 =>
          let
            domVal = evalCtx ctx domTerm
          in case newMetaAt sp ctx ec1 of
            Pair codTerm ec2 =>
              let
                piVal = VPi "_" False RigOmega domVal (Closure [] codTerm)
              in case solveMeta (ecDefTbl ec2) (ecSolsP ec2) lvl m [] piVal of
                OkC sols2 =>
                  checkLamFuel (fuel - 1) globals ctx (ecPutSols ec2 (solsList sols2))
                    (name :: rest) body piVal sp
                ErrC _ => tcErr0 sp LambdaTooManyParams
    _ => tcErr0 sp LambdaTooManyParams

-- 类型位置的裸名字：与类型同名的零参构造子（`data T : Type where T : ...`）不能抢走
-- 类型名——`inferVarRef` 在值位置优先构造子，所以 `T` 在类型位置若走推断会拿到构造子
-- 类型。M28（B18）起这里**显式查类型命名空间**（`typeLookup`：数据族 + 字典族 +
-- 类型层 def），不再把「全局项的 kind 是不是宇宙」当命名空间判据。
-- | R4：类型命名空间里的族头：record 族用 `TRecord` 前导，其余仍是 `TGlobal`。
typeHeadTerm : Ec -> String -> Term
typeHeadTerm ec name = case dtDataLookup name (ecDatas ec) of
  Just dd => if dtDataIsRecord dd then TRecord name [] else TGlobal name
  Nothing => TGlobal name

-- | R4：record 族的类型应用用 `TRecord`（带实参）；普通 data / 类型层 def 仍 `TApp` 链。
typeAppTerm : Ec -> String -> List (Pair Term Rig) -> Term
typeAppTerm ec name args = case dtDataLookup name (ecDatas ec) of
  Just dd => if dtDataIsRecord dd then TRecord name args else foldAppTerms (TGlobal name) args
  Nothing => foldAppTerms (TGlobal name) args

export checkTypeFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Check (Pair Term (Pair Level Ec))
checkTypeFuel fuel globals ctx ec expr = if fuel <= 0 then icFuel "inference"
else case expr of
  EVar name sp => case ctxLookup name ctx of
    Just _ => checkTypeInferFuel (fuel - 1) globals ctx ec expr
    Nothing => case typeLookup globals ec name of
      Just tyTerm => case typeLevelOf (forceVal ec (eval [] tyTerm)) of
        Just lvl => OkC (Pair (typeHeadTerm ec name) (Pair lvl ec))
        Nothing => checkTypeInferFuel (fuel - 1) globals ctx ec expr
      Nothing => checkTypeInferFuel (fuel - 1) globals ctx ec expr
  -- 族应用在类型位置按该名字在类型命名空间里的 kind 应用（`Pair` 这类与族同名的构造子
  -- 不能在类型位置被当成值构造子）。`->` / `Type` 是内建形式，仍走常规推断。
  EApp (EVar name sp) args asp => if name == "->" || name == "Type" then checkTypeInferFuel (fuel - 1) globals ctx ec expr
  else case ctxLookup name ctx of
    Just _ => checkTypeInferFuel (fuel - 1) globals ctx ec expr
    Nothing => if isTypeName globals ec name then case inferAppUnderTypeFuel (fuel - 1) globals ctx ec name args sp of
      ErrC _ => checkTypeInferFuel (fuel - 1) globals ctx ec expr
      OkC p => OkC p
    else checkTypeInferFuel (fuel - 1) globals ctx ec expr
  _ => checkTypeInferFuel (fuel - 1) globals ctx ec expr

export checkTypeInferFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> Check (Pair Term (Pair Level Ec))
checkTypeInferFuel fuel globals ctx ec expr = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec expr) (\p => case p of
  Pair term (Pair ty ec1) =>
    let
      forced = forceVal ec1 ty
    in case typeLevelOf forced of
      Just lvl => OkC (Pair term (Pair lvl ec1))
      Nothing =>
        tcErr1 (exprSpan expr) (ExpectedType (showValueAt (ctxDepth ctx) ty))
          (showValueAt (ctxDepth ctx) ty)
)

-- 检查方向的应用：构造子的隐式族参数/索引由期望类型反向约束（M14 的索引推断）。
-- 非构造子仍走「先推断再统一」。
export checkAppFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Value -> Span -> Check (Pair Term Ec)
checkAppFuel fuel globals ctx ec fn args expected sp = if fuel <= 0 then icFuel "inference"
else case fn of
  EVar name vsp => if isOverCtorName name then Vuna.Compiler.Common.bind
    (resolveOverCtor ec vsp (Just expected) (overCtorShort name) (overCtorTargets name))
    (\t => checkAppFuel (fuel - 1) globals ctx ec (EVar t vsp) args expected sp)
  else case ctxLookup name ctx of
    Just _ => checkAppGeneralFuel (fuel - 1) globals ctx ec fn args expected sp
    -- M28（B18）：**类型位置 = 期望是宇宙且名字在类型命名空间**。位置本身不能单独决定
    -- 命名空间（`applyTwice Box ...` 里 `Box` 在值位置、期望是 `Type -> Type`），
    -- 所以显式问 `isTypeName`，不再只看期望类型是不是宇宙。
    -- 类型位置可能嵌套在应用实参里（`List (Pair String Int)`），所以这一步必须在
    -- checkAppFuel (fuel - 1) 里，而不只是 checkTypeFuel (fuel - 1)。
    Nothing => if isSortVal ec expected then case typeNameOfDualCtor ec name of
      Just fam => checkAppUnderTypeFuel (fuel - 1) globals ctx ec fam args expected vsp
      Nothing =>
        if isTypeName globals ec name then checkAppUnderTypeFuel (fuel - 1) globals ctx ec name args expected vsp
        else checkAppByValueFuel fuel globals ctx ec fn name args expected sp vsp
    else checkAppByValueFuel fuel globals ctx ec fn name args expected sp vsp
  _ => checkAppGeneralFuel (fuel - 1) globals ctx ec fn args expected sp

-- 值位置的名称应用（非「类型作为项」）：构造子走 ctor 专用检查，其余走通用应用。
-- | 自动补注（M41 新增导出）：checkAppByValueFuel。
checkAppByValueFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> String -> List Expr -> Value -> Span -> Span -> Check (Pair Term Ec)
checkAppByValueFuel fuel globals ctx ec fn name args expected sp vsp = if fuel <= 0 then icFuel "inference"
else case valueLookup globals ec name of
  Just (VECtor _) => checkAppCtorFuel (fuel - 1) globals ctx ec name args expected vsp
  Just (VEDef _) => checkAppGeneralFuel (fuel - 1) globals ctx ec fn args expected sp
  Nothing => checkAppGeneralFuel (fuel - 1) globals ctx ec fn args expected sp

-- 类型位置的应用：名字已在类型命名空间（`checkAppFuel` 的 `isTypeName` 保证），按它的
-- kind 应用；结果必须是宇宙。M28（B18）删掉了「infer 失败退回常规推断」的兜底——
-- 进入这里就说明这是类型位置 + 类型命名空间，退化会把命名空间判断又搅混。
export checkAppUnderTypeFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Value -> Span -> Check (Pair Term Ec)
checkAppUnderTypeFuel fuel globals ctx ec name args expected sp = if fuel <= 0 then icFuel "inference"
else Vuna.Compiler.Common.bind (inferAppUnderTypeFuel (fuel - 1) globals ctx ec name args sp) (\p => case p of
  Pair term (Pair lvl ec1) =>
    Vuna.Compiler.Common.bind (convEc ec1 (ctxDepth ctx) expected (VType lvl))
      (\ec2 => OkC (Pair term ec2))
)

export inferAppUnderTypeFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Pair Term (Pair Level Ec))
inferAppUnderTypeFuel fuel globals ctx ec name args sp = if fuel <= 0 then icFuel "inference"
else case typeHeadLookup globals ec name of
  Nothing => tcErr1 sp (UnknownName name) name
  Just tyTerm => Vuna.Compiler.Common.bind (inferArgsFuel (fuel - 1) globals ctx ec (eval [] tyTerm) args sp Nothing) (\pa => case pa of
    Pair argTerms (Pair resTy ec1) => case typeLevelOf (forceVal ec1 resTy) of
      Just lvl => OkC (Pair (typeAppTerm ec1 name argTerms) (Pair lvl ec1))
      Nothing => tcErr1 sp (AppliedNotType name) name
  )

-- M35.1：实例头实参按**类参数 kind** 精化，并强制走**类型命名空间**。
-- 不能直接用 checkE：值位置优先查构造子，而 record 的构造子与类型同名（M23），
-- `instance Monad (State s)` 里的 `State` 会被解析成构造子再按值应用（kind 错位，
-- 报 `constructor State: expected Type -> Type, got State ?0 ?1`）。
-- 期望 kind 是宇宙时沿用 checkType（旧「头实参必须是类型」语义 + 宇宙检查）；
-- 是箭头 kind 时以「类型名 + 实参」在类型的 kind 上应用实参（同 checkTypeFuel 的
-- EApp 分支），再用 conv 把结果 kind 与期望 kind 对齐。
export checkTypeAtKind : List (Pair String Term) -> Ctx -> Ec -> Expr -> Value -> Span -> Check (Pair Term Ec)
checkTypeAtKind globals ctx ec expr expected sp = case forceVal ec expected of
  VType _ =>
    Vuna.Compiler.Common.bind
      (onErrDiag (withFallbackSpan sp) (checkTypeFuel 256 globals ctx ec expr))
      (\p => OkC (Pair (firstOf p) (secondOf (secondOf p))))
  _ => case expr of
    EVar name _ => if isTypeName globals ec name then case typeHeadLookup globals ec name of
      Nothing => tcErr1 sp (UnknownName name) name
      Just kindTerm =>
        Vuna.Compiler.Common.bind
          (onErrDiag (withFallbackSpan sp) (convEc ec (ctxDepth ctx) expected (eval [] kindTerm)))
          (\ec1 => OkC (Pair (typeHeadTerm ec1 name) ec1))
    else onErrDiag (withFallbackSpan sp) (checkEFuel 256 globals ctx ec expr expected)
    EApp (EVar name _) args _ => if isTypeName globals ec name then case typeHeadLookup globals ec name of
      Nothing => tcErr1 sp (UnknownName name) name
      Just kindTerm => Vuna.Compiler.Common.bind (inferArgsFuel 256 globals ctx ec (eval [] kindTerm) args sp Nothing) (\pa => case pa of
        Pair argTerms (Pair resTy ec1) => case convEc ec1 (ctxDepth ctx) expected resTy of
          OkC ec2 => OkC (Pair (typeAppTerm ec2 name argTerms) ec2)
          ErrC e => tcTypeMismatch sp (showValue expected) (showValue resTy)
      )
    else onErrDiag (withFallbackSpan sp) (checkEFuel 256 globals ctx ec expr expected)
    _ => onErrDiag (withFallbackSpan sp) (checkEFuel 256 globals ctx ec expr expected)

-- M19：`==` / `/=` 的饱和应用按实参类型特化。
-- 返回 `Nothing` 表示「不是泛化比较运算符的饱和应用」，调用方走常规路径。
-- 特化后的项是 `bi_eq_int a b` / `bi_eq_str a b` 这类具体运行时函数应用，
-- 因此 codegen 只需要名字映射（不感知类型），M18.6 的封装不被破坏。
export specializeEqAppFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeEqAppFuel fuel globals ctx ec name args sp = if fuel <= 0 then icFuel "inference"
else if isEqMethod ec name then case args of
  [a, b] => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec a) (\pa => case pa of
    Pair aTerm (Pair aTy ec1) => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec1 b) (\pb => case pb of
      Pair bTerm (Pair bTy ec2) => case coerceNatOperands ec2 aTy bTy aTerm bTerm of
        Just p =>
          specializeEqTy globals ctx name (firstOf (secondOf p)) (secondOf (secondOf p)) sp
            (firstOf (firstOf p)) ec2
        Nothing =>
          Vuna.Compiler.Common.bind (convEc ec2 (ctxDepth ctx) aTy bTy)
            (\ec3 => specializeEqTy globals ctx name aTerm bTerm sp aTy ec3)
    )
  )
  _ => OkC Nothing
else OkC Nothing

export specializeCmpAppFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeCmpAppFuel fuel globals ctx ec name args sp = if fuel <= 0 then icFuel "inference"
else if isCmpMethod ec name then case args of
  [a, b] => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec a) (\pa => case pa of
    Pair aTerm (Pair aTy ec1) => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec1 b) (\pb => case pb of
      Pair bTerm (Pair bTy ec2) => case coerceNatOperands ec2 aTy bTy aTerm bTerm of
        Just p =>
          specializeCmpTy globals ctx name (firstOf (secondOf p)) (secondOf (secondOf p)) sp
            (firstOf (firstOf p)) ec2
        Nothing =>
          Vuna.Compiler.Common.bind (convEc ec2 (ctxDepth ctx) aTy bTy)
            (\ec3 => specializeCmpTy globals ctx name aTerm bTerm sp aTy ec3)
    )
  )
  _ => OkC Nothing
else OkC Nothing

-- 统一入口：先试模板插值的原始类型快捷路径，再试 `==` / `/=`，再试比较运算符，
-- 最后试 `&&` / `||` 的短路降级。
export specializeOpAppFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeOpAppFuel fuel globals ctx ec name args sp = if fuel <= 0 then icFuel "inference"
else if name == interpMethodName then specializeInterpPrimApp (fuel - 1) globals ctx ec name args sp
else Vuna.Compiler.Common.bind (specializeEqAppFuel (fuel - 1) globals ctx ec name args sp) (\r => case r of
  Just pair => OkC (Just pair)
  Nothing => Vuna.Compiler.Common.bind (specializeCmpAppFuel (fuel - 1) globals ctx ec name args sp) (\r2 => case r2 of
    Just pair => OkC (Just pair)
    Nothing => Vuna.Compiler.Common.bind (specializeBoolAppFuel (fuel - 1) globals ctx ec name args sp) (\r3 => case r3 of
      Just pair => OkC (Just pair)
      Nothing => specializeArithAppFuel (fuel - 1) globals ctx ec name args sp
    )
  )
)

-- M36 跟进：模板洞 `${e}` 由 Loader 降级成 `Base.Interp.interp e`。对**原始类型**可以按
-- base 里的实例定义直接降级，省掉每个洞的字典目标与实例搜索（模板密集的源码自检曾因此
-- 退化到分钟级）：
--   * String：具体实例 `interp s = s`（恒等）；
--   * Int：blanket + `Show Int` ⇒ `strFromInt e`；
--   * Nat：blanket + `Show Nat` ⇒ `strFromInt (toInt e)`。
-- 其它类型（用户 ADT 等）仍走正常字典路径，语义不变。
specializeInterpPrimApp : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeInterpPrimApp fuel globals ctx ec name args sp = if fuel <= 0 then icFuel "inference"
else case args of
  [e] => Vuna.Compiler.Common.bind (inferEFuel (fuel - 1) globals ctx ec e) (\pa => case pa of
    Pair eTerm (Pair eTy ec1) =>
      let
        tyv = forceVal ec1 eTy
      in if isStringTyValue tyv then OkC (Just (Pair eTerm (Pair tyv ec1)))
      else if isIntTy ec1 tyv && not (hasSpecificInterpInstance ec1 intTypeName) then OkC (Just (Pair (strFromIntTerm eTerm) (Pair strTyValue ec1)))
      else if isNatTy ec1 tyv && not (hasSpecificInterpInstance ec1 natTypeName) then OkC (Just (Pair (strFromIntTerm (natToIntTerm eTerm)) (Pair strTyValue ec1)))
      else if isFloatTy ec1 tyv then OkC (Just (Pair (strFromFloatTerm eTerm) (Pair strTyValue ec1)))
      else OkC Nothing
  )
  _ => OkC Nothing

-- 原始类型的 `interp` 降级产物：`strFromInt e`（String 恒等直接返回 e）。
strFromIntTerm : Term -> Term
strFromIntTerm t = TApp (TGlobal "strFromInt") t Rig1

-- | 构造内部 `strFromFloat` 应用项，Float 插值降级时使用。
strFromFloatTerm : Term -> Term
strFromFloatTerm t = TApp (TGlobal "strFromFloat") t Rig1

strTyValue : Value
strTyValue = VNeutral (NGlobal strTypeName [])

isStringTyValue : Value -> Bool
isStringTyValue (VNeutral (NGlobal g [])) = g == strTypeName
isStringTyValue _ = False

-- ---------------------------------------------------------------
-- M23：`&&` / `||` 的**短路**降级
-- ---------------------------------------------------------------
-- 旧实现把 `&&` / `||` 当普通全局严格求值：`False && (1/0 == 0)` 会真去算右边，而编译
-- 产物（HM 的 `if`）是短路的——反复求值/异常行为三路不一致。这里在精化期把饱和应用
-- 降成 `TIf`：`a && b` ⇒ `if a then b else False`、`a || b` ⇒ `if a then True else b`。
-- 核心求值器与 codegen 都只需处理 TIf/if，短路语义自动一致，不在 Core/Codegen
-- 各打一份补丁。
export specializeBoolAppFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Span -> Check (Maybe (Pair Term (Pair Value Ec)))
specializeBoolAppFuel fuel globals ctx ec name args sp = if fuel <= 0 then icFuel "inference"
else if name == "&&" || name == "||" then case args of
  [a, b] => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec a (VNeutral (NGlobal boolTypeName []))) (\pa => case pa of
    Pair aTerm ec1 => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec1 b (VNeutral (NGlobal boolTypeName []))) (\pb => case pb of
      Pair bTerm ec2 =>
        OkC
          (Just (Pair (boolShortCircuit name aTerm bTerm) (Pair (VNeutral (NGlobal boolTypeName [])) ec2)))
    )
  )
  _ => tcErr1 sp (NeedsTwoArgs name) name
else OkC Nothing

export checkAppGeneralFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> Expr -> List Expr -> Value -> Span -> Check (Pair Term Ec)
checkAppGeneralFuel fuel globals ctx ec fn args expected sp = if fuel <= 0 then icFuel "inference"
else case fn of
  EVar name vsp => Vuna.Compiler.Common.bind (specializeArithCheckFuel (fuel - 1) globals ctx ec name args expected sp) (\arith => case arith of
    Just (Pair term ec2) => OkC (Pair term ec2)
    Nothing => if skipArithSpecForExpected ec name expected then checkByInferFuel (fuel - 1) globals ctx ec (EApp fn args sp) expected
    else Vuna.Compiler.Common.bind (specializeOpAppFuel (fuel - 1) globals ctx ec name args sp) (\mspec => case mspec of
      Just (Pair term (Pair termTy ec1)) => case coerceTerm ec1 expected termTy term of
        Just coerced => OkC (Pair coerced ec1)
        Nothing =>
          Vuna.Compiler.Common.bind (convEc ec1 (ctxDepth ctx) expected termTy)
            (\ec2 => OkC (Pair term ec2))
      Nothing => checkByInferFuel (fuel - 1) globals ctx ec (EApp fn args sp) expected
    )
  )
  _ => checkByInferFuel (fuel - 1) globals ctx ec (EApp fn args sp) expected

-- 构造子应用：先按签名收隐式实参（元变量），再逐个检查显式实参，最后统一结果类型。
-- 用 `dtCtorLookup` 取**构造子类型**（不是 `globalLookup`）：名字与族同名的构造子
-- （如 `data Pair a b where Pair : a -> b -> Pair a b`）的 `globalLookup` 会命中族 kind
-- （`Type -> Type -> Type`）而不是构造子类型，导致隐式族参数丢失。
-- M35.1：检查方向构造子应用的**族参数反推**（只对恒等结果索引的构造子生效）。
--
-- 旧路径先 `inferArgsFuel`（隐式族参数插元变量）再与期望类型统一。对字段类型依赖
-- 族参数的构造子（CPS `Eff` 的 `(a -> ans) -> ((op : f) -> (res op -> ans) -> ans) -> ans`），
-- 检查字段 lambda 时 `res`/`a` 还是元变量，`alg op k` 会要求解 `?a ≡ res op` 这类
-- flex-flex 约束（`res` 在 λ 内才绑定）→
-- `cannot solve metavariable (solution would escape its scope)`。
-- 这里先把期望类型 `F r1..rk` 的实参喂进 telescope 的前 k 个隐式族 binder，检查字段时
-- 索引已经是具体值。
--
-- 只对**恒等结果索引**生效：结果 `F x1..xk` 的 xi 必须就是第 i 个 binder 本身（如 `Eff`）。
-- `Vec (Succ n) a` 这类非恒等索引的 binder 不等于结果索引，喂进去会造出错误索引
-- （曾把 `Cons` 的 n 喂成结果长度，导致 `Nil` 期望 1 得到 0）。
-- 构造子类型末尾的族应用 `F r1..rk` 的实参（跳过 Pi 链）。
ctorResultArgs : Term -> List Term
ctorResultArgs (TPi _ _ _ _ cod) = ctorResultArgs cod
ctorResultArgs ty = secondOf (ctorSpineOfType ty)

ctorSpineOfType : Term -> Pair String (List Term)
ctorSpineOfType (TApp f a _) = case ctorSpineOfType f of
  Pair h args => Pair h (append args [a])
ctorSpineOfType (TRecord name args) = Pair name (map firstOf args)
ctorSpineOfType (TGlobal g) = Pair g []
ctorSpineOfType _ = Pair "" []

dropPis : Term -> Term
dropPis (TPi _ _ _ _ cod) = dropPis cod
dropPis t = t

identityArgs : Int -> Int -> List Term -> Bool
identityArgs i k [] = True
identityArgs i k (a :: rest) = case a of
  TVar _ idx _ => if idx == k - 1 - i then identityArgs (i + 1) k rest else False
  _ => False

-- 恒等结果索引：`F x1..xk` 且 xi 就是第 i 个族 binder（de Bruijn index = teleLen-1-i）。
ctorIdentitySpine : String -> DtCtor -> Bool
ctorIdentitySpine fam ctor =
  let
    k = length (dtCtorTelescope ctor)
    args = ctorResultArgs (dtCtorType ctor)
  in case ctorSpineOfType (dropPis (dtCtorType ctor)) of
    Pair h _ =>
      if h == fam then if length args > 0 then if length args < k then identityArgs 0 k args else False else False
      else False

-- 取 telescope 前 n 个 binder 的 rig（族参数部分）。
takeRigs : Int -> List (Pair String Rig) -> List Rig
takeRigs n bs = takeRigsGo n bs

takeRigsGo : Int -> List (Pair String Rig) -> List Rig
takeRigsGo n [] = []
takeRigsGo n (b :: bs) = if n <= 0 then [] else Base.List.Cons (secondOf b) (takeRigsGo (n - 1) bs)

ctorFamilyArgs : Ec -> Ctx -> DtCtor -> Value -> Maybe (Pair (List (Pair Term Rig)) (Pair Value Ec))
ctorFamilyArgs ec ctx ctor expected =
  let
    fam = dtCtorFamily ctor
  in if ctorIdentitySpine fam ctor then case forceVal ec expected of
    VNeutral (NGlobal gfam spine) =>
      let
        arity = length (ctorResultArgs (dtCtorType ctor))
      in if gfam == fam then if length spine == arity then ctorFamilyArgsGo ec (eval [] (dtCtorType ctor)) spine (takeRigs arity (dtCtorTelescope ctor))
        (ctxDepth ctx) []
      else Nothing
      else Nothing
    _ => Nothing
  else Nothing

ctorFamilyArgsGo : Ec -> Value -> List Value -> List Rig -> Int -> List (Pair Term Rig) -> Maybe (Pair (List (Pair Term Rig)) (Pair Value Ec))
ctorFamilyArgsGo ec ty [] rigs depth acc = Just (Pair (reverse acc) (Pair ty ec))
ctorFamilyArgsGo ec ty (v :: vs) [] depth acc = Nothing
ctorFamilyArgsGo ec ty (v :: vs) (r :: rs) depth acc = case forceVal ec ty of
  VPi _ implicit _ dom clo =>
    if implicit then ctorFamilyArgsGo ec (applyClosure clo v) vs rs depth (Pair (quote depth v) r :: acc)
    else Nothing
  _ => Nothing

-- ---------------------------------------------------------------
-- M41：重载构造子引用 / 列表字面量的类型导向模式归一化
-- ---------------------------------------------------------------
-- 把 `PCon` 头里的候选集（Loader 的 @vuna@ctor@... 编码）按期望类型/scrutinee 族
-- 解析成 canonical 构造子，并递归解析嵌套模式（用 ctorFamilyArgs 实例化字段类型）。
-- | 自动补注（M41 新增导出）：resolveOverPatFuel。
resolveOverPatFuel : Nat -> Ec -> Ctx -> Value -> Pat -> Check (Pair Pat Ec)
resolveOverPatFuel Zero ec ctx expected pat = icFuel "pattern resolve"
resolveOverPatFuel (Succ k) ec ctx expected pat = case pat of
  PCon name args sp => if isListNilSyntax name then case litFamilyCtor ec (listLitFamily ec expected) "Nil" of
    Just c => resolveCtorPatFuel k ec ctx expected (dtCtorName c) args sp
    Nothing => OkC (Pair (PCon "__list_literal__" args sp) ec)
  else if isListConsSyntax name then case litFamilyCtor ec (listLitFamily ec expected) "Cons" of
    Just c => resolveCtorPatFuel k ec ctx expected (dtCtorName c) args sp
    Nothing => OkC (Pair (PCon "__list_literal__" args sp) ec)
  else if isOverCtorName name then Vuna.Compiler.Common.bind
    (resolveOverCtor ec sp (Just expected) (overCtorShort name) (overCtorTargets name))
    (\target => resolveCtorPatFuel k ec ctx expected target args sp)
  else resolveCtorPatFuel k ec ctx expected name args sp
  PRecord name fields sp => OkC (Pair pat ec)
  _ => OkC (Pair pat ec)

-- | 自动补注（M41 新增导出）：resolveCtorPatFuel。
resolveCtorPatFuel : Nat -> Ec -> Ctx -> Value -> String -> List Pat -> Span -> Check (Pair Pat Ec)
resolveCtorPatFuel Zero ec ctx expected cname args sp = icFuel "pattern resolve"
resolveCtorPatFuel (Succ k) ec ctx expected cname args sp = case dtCtorLookupEc ec cname of
  Nothing => OkC (Pair (PCon cname args sp) ec)
  Just ctor => case ctorFamilyArgs ec ctx ctor expected of
    Nothing => OkC (Pair (PCon cname args sp) ec)
    Just (Pair seedArgs (Pair ty2 ec1)) => Vuna.Compiler.Common.bind (resolvePatArgsFuel k ec1 ctx ty2 args) (\q => case q of
      Pair args2 ec2 => OkC (Pair (PCon cname args2 sp) ec2)
    )

-- | 自动补注（M41 新增导出）：resolvePatArgsFuel。
resolvePatArgsFuel : Nat -> Ec -> Ctx -> Value -> List Pat -> Check (Pair (List Pat) Ec)
resolvePatArgsFuel Zero ec ctx ty args = icFuel "pattern resolve"
resolvePatArgsFuel (Succ k) ec ctx ty args = case args of
  [] => OkC (Pair [] ec)
  a :: rest => case forceVal ec ty of
    VPi name implicit rig dom clo =>
      let
        v = VNeutral (NVar name (ctxDepth ctx) [])
        ctx2 = ctxBindValue name dom ctx
        ty2 = applyClosure clo v
      in if implicit then resolvePatArgsFuel k ec ctx2 ty2 (a :: rest)
      else Vuna.Compiler.Common.bind (resolveOverPatFuel k ec ctx dom a) (\p => case p of
        Pair a2 ec1 => Vuna.Compiler.Common.bind (resolvePatArgsFuel k ec1 ctx2 ty2 rest) (\q => case q of
          Pair rest2 ec2 => OkC (Pair (Base.List.Cons a2 rest2) ec2)
        )
      )
    _ => OkC (Pair args ec)

-- | 自动补注（M41 新增导出）：resolveOverAlts。
resolveOverAlts : Ec -> Ctx -> Value -> List (Pair Pat Expr) -> Check (Pair (List (Pair Pat Expr)) Ec)
resolveOverAlts ec ctx ty alts = resolveOverAltsGo (natFromInt 512) ec ctx ty alts

-- | 自动补注（M41 新增导出）：resolveOverAltsGo。
resolveOverAltsGo : Nat -> Ec -> Ctx -> Value -> List (Pair Pat Expr) -> Check (Pair (List (Pair Pat Expr)) Ec)
resolveOverAltsGo Zero ec ctx ty alts = icFuel "pattern resolve"
resolveOverAltsGo (Succ k) ec ctx ty alts = case alts of
  [] => OkC (Pair [] ec)
  (Pair pat body) :: rest => Vuna.Compiler.Common.bind (resolveOverPatFuel (natFromInt 512) ec ctx ty pat) (\p => case p of
    Pair pat2 ec1 => Vuna.Compiler.Common.bind (resolveOverAltsGo k ec1 ctx ty rest) (\q => case q of
      Pair rest2 ec2 => OkC (Pair (Base.List.Cons (Pair pat2 body) rest2) ec2)
    )
  )

-- 多子句函数 / 实例方法：按签名 Pi 链逐列解析每条 clause 的参数模式。
-- | 自动补注（M41 新增导出）：resolveOverFunPats。
export resolveOverFunPats : Ec -> Ctx -> Value -> List (Pair (List Pat) Expr) -> Check (Pair (List (Pair (List Pat) Expr)) Ec)
resolveOverFunPats ec ctx expected clauses =
  resolveOverFunPatsGo (natFromInt 512) ec ctx expected clauses

-- | 自动补注（M41 新增导出）：resolveOverFunPatsGo。
resolveOverFunPatsGo : Nat -> Ec -> Ctx -> Value -> List (Pair (List Pat) Expr) -> Check (Pair (List (Pair (List Pat) Expr)) Ec)
resolveOverFunPatsGo Zero ec ctx ty clauses = icFuel "pattern resolve"
resolveOverFunPatsGo (Succ k) ec ctx ty clauses = case clauses of
  [] => OkC (Pair [] ec)
  (Pair pats body) :: rest => Vuna.Compiler.Common.bind (resolveClausePatsFuel (natFromInt 512) ec ctx ty pats) (\q => case q of
    Pair pats2 ec1 => Vuna.Compiler.Common.bind (resolveOverFunPatsGo k ec1 ctx ty rest) (\r => case r of
      Pair rest2 ec2 => OkC (Pair (Base.List.Cons (Pair pats2 body) rest2) ec2)
    )
  )

-- | 逐列解析 clause 参数模式（Nat 燃料结构下降）。
resolveClausePatsFuel : Nat -> Ec -> Ctx -> Value -> List Pat -> Check (Pair (List Pat) Ec)
resolveClausePatsFuel Zero ec ctx ty pats = icFuel "pattern resolve"
resolveClausePatsFuel (Succ k) ec ctx ty pats = case pats of
  [] => OkC (Pair [] ec)
  p :: rest => case forceVal ec ty of
    VPi name implicit rig dom clo =>
      let
        v = VNeutral (NVar name (ctxDepth ctx) [])
        ctx2 = ctxBindValue name dom ctx
        ty2 = applyClosure clo v
      in if implicit then resolveClausePatsFuel k ec ctx2 ty2 (p :: rest)
      else Vuna.Compiler.Common.bind (resolveOverPatFuel k ec ctx dom p) (\q => case q of
        Pair p2 ec1 => Vuna.Compiler.Common.bind (resolveClausePatsFuel k ec1 ctx2 ty2 rest) (\r => case r of
          Pair rest2 ec2 => OkC (Pair (Base.List.Cons p2 rest2) ec2)
        )
      )
    _ => OkC (Pair pats ec)

export checkAppCtorFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> String -> List Expr -> Value -> Span -> Check (Pair Term Ec)
checkAppCtorFuel fuel globals ctx ec name args expected sp = if fuel <= 0 then icFuel "inference"
else case dtCtorLookupEc ec name of
  Nothing => tcErr1 sp (UnknownName name) name
  Just ctor => case ctorFamilyArgs ec ctx ctor expected of
    Just (Pair seedArgs (Pair ty2 ec0)) => Vuna.Compiler.Common.bind (inferArgsFuel (fuel - 1) globals ctx ec0 ty2 args sp Nothing) (\pa => case pa of
      Pair argTerms (Pair resTy ec1) =>
        let
          allArgs = append seedArgs argTerms
        in case coerceTerm ec1 expected resTy (ctorAppTerm (ecDatas ec1) (TGlobal name) allArgs) of
          Just coerced => OkC (Pair coerced ec1)
          Nothing => case convEc ec1 (ctxDepth ctx) expected resTy of
            OkC ec2 => OkC (Pair (ctorAppTerm (ecDatas ec2) (TGlobal name) allArgs) ec2)
            ErrC e =>
              tcErr2 sp (CtorError (ctorDisplayName name) (diagText e)) (ctorDisplayName name)
                (diagText e)
    )
    Nothing => Vuna.Compiler.Common.bind (inferArgsFuel (fuel - 1) globals ctx ec (eval [] (dtCtorType ctor)) args sp Nothing) (\pa => case pa of
      Pair argTerms (Pair resTy ec1) =>
        let
          ctorTerm = ctorAppTerm (ecDatas ec1) (TGlobal name) argTerms
        in case coerceTerm ec1 expected resTy ctorTerm of
          Just coerced => OkC (Pair coerced ec1)
          Nothing => case convEc ec1 (ctxDepth ctx) expected resTy of
            OkC ec2 => OkC (Pair (ctorAppTerm (ecDatas ec2) (TGlobal name) argTerms) ec2)
            ErrC e =>
              tcErr2 sp (CtorError (ctorDisplayName name) (diagText e)) (ctorDisplayName name)
                (diagText e)
    )

-- ---------------------------------------------------------------
-- S3b：do 块的内部标记链解释（carrier C）
-- ---------------------------------------------------------------
-- Loader.Resolve 把 do 降级成「语句边界全部编码在 EApp+ELam 链上」的嵌套应用，但每个非末条
-- 节点的头部换成内部标记 `@vuna@do@bind@<canonical>` / `@vuna@do@ignore@<canonical>`
-- （canonical = 块作用域里 resolve 出的 bind 名；标记名用户源码写不出来）。
--
-- 这里把整条链解释成一个 do 块，按**整块一个 monad / 一个字典**精化：
--   * 期望类型能拆成 `m a`（force 后是中性应用、末实参即 a）就直接取 m/a，否则建共享 meta；
--   * 每条语句的 element 类型各建一个 meta，语句按 `m a_i` 检查（复用 checkEFuel）；
--   * 字典整块只建一次（延迟时是 meta + 一个 Constraint（CkDict）），装配出的每个 bind 应用与旧降级
--     逐项一致：隐式 {m}/{Monad m}/{a}/{b}、rig、λ binder 名、语句 span。
-- 形状不认识（bind 不是全局 / 签名不是 `{m}{Monad m}{a}{b} -> m a -> (a -> m b) -> m b` /
-- 链形状不符）⇒ 把标记链重建为普通 bind 链交给既有路径，语义与 S3a 逐字一致。
-- 标记头：`EApp (EVar <do marker>) _ _`。
-- | 判断表达式头部是否是 do 块标记（`@vuna@do@bind` / `@vuna@do@ignore`）应用。
doMarkerHead : Expr -> Bool
doMarkerHead (EApp (EVar name sp) args asp) = case doSyntaxCanonical name of
  Just _ => True
  Nothing => False
doMarkerHead _ = False

-- 链上的一个非末条语句：binder 名 + 语句表达式 + 语句 span。
-- | do 链上的一个非末条语句：binder 名、语句表达式与其 span。
data DoChainStep : Type where
  DoChainStep : String -> Expr -> Span -> DoChainStep

-- 拆出来的 do 块：bind canonical 名 + 语句序列 + 末条表达式 + 块 span（= 首条语句 span）。
-- | 从标记链拆出的 do 块：canonical bind 名、语句序列、末条表达式与块 span。
record DoChain where
  doChainCanonical : String
  doChainSteps : List DoChainStep
  doChainLast : Expr
  doChainSpan : Span

-- 逐层拆链：每层是 `EApp (EVar <marker> sp) [stmt, ELam [binder] tail _] sp`；
-- 遇到非标记表达式就是末条语句。链上的 canonical 必须一致。
-- | 逐层拆开 do 标记链收集非末条语句；链上 canonical 必须一致，否则返回 Nothing。
decodeDoChain : Int -> String -> List DoChainStep -> Expr -> Maybe (Pair (List DoChainStep) Expr)
decodeDoChain fuel canonical acc expr = if fuel <= 0 then Nothing
else case expr of
  EApp (EVar name sp) args asp => case doSyntaxCanonical name of
    Nothing => Just (Pair (reverse acc) expr)
    Just canonical2 => if canonical /= canonical2 then Nothing
    else case args of
      [e, ELam ([binder]) rest lsp] =>
        decodeDoChain (fuel - 1) canonical2 (DoChainStep binder e sp :: acc) rest
      _ => Nothing
  _ => Just (Pair (reverse acc) expr)

-- | 把整个表达式解析成 DoChain；头部不是 do 标记或链形状不合法时返回 Nothing。
decodeDoBlock : Expr -> Maybe DoChain
decodeDoBlock (expr@(EApp (EVar name sp) args asp)) = case doSyntaxCanonical name of
  Just canonical => case decodeDoChain 4096 canonical [] expr of
    Just (Pair steps last) => Just (DoChain canonical steps last sp)
    Nothing => Nothing
  Nothing => Nothing
decodeDoBlock _ = Nothing

-- 回退：把标记链重建为普通 bind 链（与 S3a 产出的 AST 相同），交给既有精化路径。
-- | 把语句序列重建成普通 bind 链：do 标记替换成 canonical bind 名。
doChainBuild : String -> List DoChainStep -> Expr -> Span -> Expr
doChainBuild canonical [] last lastSp = last
doChainBuild canonical ((DoChainStep binder e sp) :: rest) last lastSp =
  EApp (EVar canonical sp) [e, ELam [binder] (doChainBuild canonical rest last lastSp) sp] sp

-- | 把 DoChain 重建为普通 bind 链表达式，交给既有精化路径。
doChainFallback : DoChain -> Expr
doChainFallback chain =
  doChainBuild chain.doChainCanonical chain.doChainSteps chain.doChainLast chain.doChainSpan

-- 期望类型拆 `m a`：force 后是中性应用且 spine 非空 ⇒ (头应用 m, 末实参 a)。
-- 只认中性头；meta 头/其它形状交给共享 meta 路径。
-- | 把中性应用 spine 拆成「头应用 m」与「末实参 a」；空 spine 返回 Nothing。
splitDoSpine : Value -> List Value -> Maybe (Pair Value Value)
splitDoSpine head [] = Nothing
splitDoSpine head (x :: rest) = case splitDoSpine (applyValue head x) rest of
  Nothing => Just (Pair head x)
  Just p => Just p

-- | 尝试把期望类型拆成 `m a`；头部不是中性应用（含 meta 头）时返回 Nothing。
splitDoExpected : Ec -> Value -> Maybe (Pair Value Value)
splitDoExpected ec expected = case forceVal ec expected of
  VNeutral n => case n of
    NVar name lvl sp => splitDoSpine (VNeutral (NVar name lvl [])) sp
    NGlobal g sp => splitDoSpine (VNeutral (NGlobal g [])) sp
  _ => Nothing

-- bind 投影签名的唯一可接受形状：
--   {m} -> {Dict_C m} -> {a} -> {b} -> m a -> (a -> m b) -> m b
-- 返回显式实参 rig、λ 位置 rig、以及 `a -> m b` 里 λ binder 的 rig。
-- | bind 可接受签名里抽出的三个 rig：显式实参、λ 位置与 λ binder。
data DoBindShape : Type where
  DoBindShape : Rig -> Rig -> Rig -> DoBindShape

-- | 匹配 bind 签名 `{m}{Dict}{a}{b} -> m a -> (a -> m b) -> m b`，
-- 返回显式实参、λ 位置与 λ binder 的 rig；形状不符返回 Nothing。
bindShapeOf : Term -> Maybe DoBindShape
bindShapeOf (TPi _ True _ _ (TPi _ True _ (TApp (TGlobal g) (TVar _ imD _) _) (TPi _ True _ _ (TPi _ True _ _ (TPi _ False rigE (TApp (TVar _ imE _) (TVar _ iaE _) _) (TPi _ False rigL (TPi _ False rigInner (TVar _ iaL _) (TApp (TVar _ imM _) (TVar _ ibL _) _)) (TApp (TVar _ imR _) (TVar _ ibR _) _))))))) =
  if imD == 0 && imE == 3 && imM == 5 && imR == 5 then if iaE == 1 && iaL == 2 && ibL == 2 && ibR == 2 then Just (DoBindShape rigE rigL rigInner)
  else if iaE == 0 && iaL == 1 && ibL == 3 && ibR == 3 then Just (DoBindShape rigE rigL rigInner)
  else Nothing
  else Nothing
bindShapeOf _ = Nothing

-- 块头的全局查找：局部 binder 遮蔽 / 不是全局 ⇒ 交给回退路径（局部 bind 的形状不受支持）。
-- | 查块头 bind 的全局项与类型；被局部 binder 遮蔽或不是全局时返回 Nothing。
doBindHeadOf : List (Pair String Term) -> Ctx -> Ec -> String -> Maybe (Pair Term Term)
doBindHeadOf globals ctx ec bindName = case ctxLookup bindName ctx of
  Just _ => Nothing
  Nothing => case globalsLookup bindName globals ec of
    Just tyTerm => Just (Pair (TGlobal bindName) tyTerm)
    Nothing => Nothing

-- 静态形状检查（不改 Ec）：head 项 + bind 签名项 + 形状。
-- | 静态检查 do 块头（不改 Ec）：返回 bind 头项、签名项与抽出的 DoBindShape。
doBlockShapeOf : List (Pair String Term) -> Ctx -> Ec -> String -> Maybe (Pair Term (Pair Term DoBindShape))
doBlockShapeOf globals ctx ec bindName = case doBindHeadOf globals ctx ec bindName of
  Nothing => Nothing
  Just (Pair headTerm bindTyTerm) => case bindShapeOf bindTyTerm of
    Nothing => Nothing
    Just shape => Just (Pair headTerm (Pair bindTyTerm shape))

-- 字典：整块只建一次。已知 m 且类参数无未解 meta 时直接搜实例；否则延迟成
-- meta + 一个 Constraint（CkDict）（与 inferArgsGo 的延迟分支同一语义）。
-- | 为 do 块建延迟字典目标：新鲜 meta 加一条 CkDict 约束，整块共用。
doDictDefer : Ctx -> Ec -> Value -> Span -> Check (Pair Term Ec)
doDictDefer ctx ec dom sp =
  let
    m = ecNext ec
  in case newMetaAt sp ctx ec of
    Pair metaTerm ec1 =>
      OkC (Pair metaTerm (ecAddConstraint ec1 CkDict m (forceVal ec1 dom) (Just sp) (ctxDepth ctx)))

-- | 取得 do 块的字典项：类参数已确定时搜索实例，否则延迟成 meta + 约束。
doDictStep : Int -> List (Pair String Term) -> Ctx -> Ec -> Span -> Value -> Check (Pair Term Ec)
doDictStep fuel globals ctx ec sp dom = if fuel <= 0 then icFuel "inference"
else if dictArgUnsolvedMeta ec dom then doDictDefer ctx ec dom sp
else case searchInstanceIn globals ctx ec (forceVal ec dom) sp of
  OkC (Pair instTerm ec1) => OkC (Pair instTerm ec1)
  ErrC e =>
    if hasUnsolvedMetaValue (ecSolsP ec) (forceVal ec dom) then doDictDefer ctx ec dom sp
    else if isRigidDictArg ec (forceVal ec dom) then doDictDefer ctx ec dom sp else ErrC e

-- do 块的共享解释计划：bind canonical 名、head 项、共享 m（项/值）、块结果类型 a、字典项、
-- 三个 rig、以及字典步之后的 Ec。
-- | do 块的共享解释计划：bind 名、头项、共享 m/a、字典项、三个 rig 与新 Ec。
record DoPlan where
  planBind : String
  planHead : Term
  planMTerm : Term
  planMVal : Value
  planAVal : Value
  planDictTerm : Term
  planRigE : Rig
  planRigL : Rig
  planInnerRig : Rig
  planEc : Ec

-- 在形状已通过的前提下，应用 m 取字典域并决定字典项。只在完全成功时修改 Ec。
-- | 签名形状已通过后，应用 m 得到字典域并求字典项；只有完全成功才推进 Ec。
planDoBlock : Int -> List (Pair String Term) -> Ctx -> Ec -> Span -> String -> Term -> Term -> DoBindShape -> Value -> Value -> Check (Maybe DoPlan)
planDoBlock fuel globals ctx ec sp bindName headTerm bindTyTerm shape mVal aVal = if fuel <= 0 then icFuel "inference"
else case shape of
  DoBindShape rigE rigL rigInner => case forceVal ec (eval [] bindTyTerm) of
    VPi _ True _ _ cloM => case forceVal ec (applyClosure cloM mVal) of
      VPi _ True _ domD _ => if isDictDomain ec domD then Vuna.Compiler.Common.bind (doDictStep (fuel - 1) globals ctx ec sp domD) (\dp => case dp of
        Pair dictTerm ec1 =>
          OkC
            (Just (DoPlan bindName headTerm (quote (ctxDepth ctx) mVal) mVal aVal dictTerm rigE rigL rigInner ec1))
      )
      else OkC Nothing
      _ => OkC Nothing
    _ => OkC Nothing

-- 组装一个 bind 应用：与旧降级逐项一致（隐式 m/dict/a/b、显式 e/λ 的 rig、λ binder 名）。
-- `ecLinear` 是 λ 入口的 Ec（线性捕获判据与 checkLamFuel 同点采样），`ecPaper` 是体精化后的
-- Ec（不透明运行时类型的域判据用解完的 Ec）。
-- | 组装 bind 应用：隐式 m/字典/a/b、显式 e/λ 的 rig 与 binder 名，
-- 并对不透明运行时类型的 binder 做擦除包装。
doBindAppTerm : Ec -> Ec -> Ctx -> Span -> DoPlan -> String -> Value -> Term -> Rig -> Rig -> Term -> Term
doBindAppTerm ecLinear ecPaper ctx sp plan binder aVal eTerm argRig lamRig inner =
  let
    depth = ctxDepth ctx
    ctx2 = ctxBindValue binder aVal ctx
    inner2 = if isOpaqueRuntimeTyIn ecPaper ctx aVal then wrapOpaqueUses [0] inner else inner
    binderName =
      if ctxHasLinear ecLinear ctx then if termHasOuterLinear ecLinear ctx2 inner then linClosureName sp depth binder else binder
      else binder
    lamTerm = TLam binderName lamRig inner2
    args =
      [ Pair plan.planMTerm Rig0,
        Pair plan.planDictTerm RigOmega,
        Pair (quote depth aVal) Rig0,
        Pair (quote depth plan.planAVal) Rig0,
        Pair eTerm argRig,
        Pair lamTerm plan.planRigL
      ]
  in foldAppTerms plan.planHead args

-- 逐条语句的检查与链装配：`bind e_i (\binder -> <后缀>)`。后缀的 monad 与结果类型整块共享
-- （`planAVal`），所以每个 bind 的 b 实参都直接用块结果类型 a。
-- | 逐条检查 do 语句并装配 bind 链：所有语句共享整块的 monad、字典与结果类型。
elabDoChain : Int -> List (Pair String Term) -> Ctx -> Ec -> DoPlan -> List DoChainStep -> Expr -> Check (Pair Term Ec)
elabDoChain fuel globals ctx ec plan steps last = if fuel <= 0 then icFuel "inference"
else case steps of
  [] => checkEFuel (fuel - 1) globals ctx ec last (applyValue plan.planMVal plan.planAVal)
  (DoChainStep binder e sp) :: rest => case newMetaAt sp ctx ec of
    Pair aTerm ec1 =>
      let
        aVal = evalCtx ctx aTerm
        mArgTy = applyValue plan.planMVal aVal
        ctx2 = ctxBindValue binder aVal ctx
      in Vuna.Compiler.Common.bind (rigForLinearDomain ec1 sp "_" plan.planRigE mArgTy) (\argRig => Vuna.Compiler.Common.bind (checkEFuel (fuel - 1) globals ctx ec1 e mArgTy) (\p => case p of
        Pair eTerm ec2 => Vuna.Compiler.Common.bind (rigForLinearDomain ec2 sp binder plan.planInnerRig aVal) (\lamRig => Vuna.Compiler.Common.bind (elabDoChain (fuel - 1) globals ctx2 ec2 plan rest last) (\q => case q of
          Pair inner ec3 =>
            OkC (Pair (doBindAppTerm ec2 ec3 ctx sp plan binder aVal eTerm argRig lamRig inner) ec3)
        )
        )
      )
      )

-- check 方向的 do 块解释：期望能拆 `m a` 就直接用，否则建共享 m/a meta 并在收尾与期望统一。
-- | check 方向的 do 块解释：期望可拆 `m a` 时直接复用，否则建共享 m/a meta，
-- 收尾再把 `m a` 与期望统一。
checkDoBlockFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> DoChain -> Value -> Check (Maybe (Pair Term Ec))
checkDoBlockFuel fuel globals ctx ec chain expected = if fuel <= 0 then icFuel "inference"
else case doBlockShapeOf globals ctx ec chain.doChainCanonical of
  Nothing => OkC Nothing
  Just (Pair headTerm (Pair bindTyTerm shape)) => case splitDoExpected ec expected of
    Just (Pair mVal aVal) => Vuna.Compiler.Common.bind (planDoBlock (fuel - 1) globals ctx ec chain.doChainSpan chain.doChainCanonical headTerm bindTyTerm shape mVal aVal) (\mp => case mp of
      Nothing => OkC Nothing
      Just plan => Vuna.Compiler.Common.bind (elabDoChain (fuel - 1) globals ctx plan.planEc plan chain.doChainSteps chain.doChainLast) (\q => case q of
        Pair term ec1 => OkC (Just (Pair term (resolveDictGoals globals ec1)))
      )
    )
    Nothing => case newMetaAt chain.doChainSpan ctx ec of
      Pair mTerm ec1 => case newMetaAt chain.doChainSpan ctx ec1 of
        Pair aTerm ec2 =>
          let
            mVal = evalCtx ctx mTerm
            aVal = evalCtx ctx aTerm
          in Vuna.Compiler.Common.bind (planDoBlock (fuel - 1) globals ctx ec2 chain.doChainSpan chain.doChainCanonical headTerm bindTyTerm shape mVal aVal) (\mp => case mp of
            Nothing => OkC Nothing
            Just plan => Vuna.Compiler.Common.bind (elabDoChain (fuel - 1) globals ctx plan.planEc plan chain.doChainSteps chain.doChainLast) (\q => case q of
              Pair term ec3 =>
                Vuna.Compiler.Common.bind
                  (convEc ec3 (ctxDepth ctx) expected (applyValue plan.planMVal plan.planAVal))
                  (\ec4 => OkC (Just (Pair term (resolveDictGoals globals ec4))))
            )
          )

-- infer 方向的 do 块解释：没有期望类型，共享 m/a 都建 meta，结果类型 `m a` 交给外层统一。
-- | infer 方向的 do 块解释：共享 m/a 先建 meta，结果 `m a` 交给外层统一。
inferDoBlockFuel : Int -> List (Pair String Term) -> Ctx -> Ec -> DoChain -> Check (Maybe (Pair Term (Pair Value Ec)))
inferDoBlockFuel fuel globals ctx ec chain = if fuel <= 0 then icFuel "inference"
else case doBlockShapeOf globals ctx ec chain.doChainCanonical of
  Nothing => OkC Nothing
  Just (Pair headTerm (Pair bindTyTerm shape)) => case newMetaAt chain.doChainSpan ctx ec of
    Pair mTerm ec1 => case newMetaAt chain.doChainSpan ctx ec1 of
      Pair aTerm ec2 =>
        let
          mVal = evalCtx ctx mTerm
          aVal = evalCtx ctx aTerm
          resultTy = applyValue mVal aVal
        in Vuna.Compiler.Common.bind (planDoBlock (fuel - 1) globals ctx ec2 chain.doChainSpan chain.doChainCanonical headTerm bindTyTerm shape mVal aVal) (\mp => case mp of
          Nothing => OkC Nothing
          Just plan => Vuna.Compiler.Common.bind (elabDoChain (fuel - 1) globals ctx plan.planEc plan chain.doChainSteps chain.doChainLast) (\q => case q of
            Pair term ec3 => OkC (Just (Pair term (Pair resultTy ec3)))
          )
        )
