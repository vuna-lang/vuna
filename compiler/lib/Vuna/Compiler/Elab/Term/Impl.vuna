module Vuna.Compiler.Elab.Term.Impl
  ( boolAltFuel
  , boolAltGoFuel
  , checkAppCtorFuel
  , checkAppFuel
  , checkAppGeneralFuel
  , checkAppUnderTypeFuel
  , checkBoolCaseFuel
  , checkByInferFuel
  , checkCaseDedupFuel
  , checkCaseFamFuel
  , checkCaseFuel
  , checkCaseOfFuel
  , checkCondBoolFuel
  , checkEFuel
  , checkLamFuel
  , checkLetFuel
  , checkLetGoFuel
  , checkLetOneFuel
  , checkLitAltsFuel
  , checkLitBoundVarFuel
  , checkLitCaseFuel
  , checkTypeFuel
  , checkTypeInferFuel
  , constrainDictDomFuel
  , constrainDictDomGoKFuel
  , deferDictBinderFuel
  , elabCaseAltsFuel
  , elabCatchAllFuel
  , elabConAltFuel
  , inferAnnFuel
  , inferAppFuel
  , inferAppGeneralFuel
  , inferAppGeneralGoFuel
  , inferAppUnderTypeFuel
  , inferArgsFuel
  , inferArgsGo
  , inferCaseEFuel
  , inferEFuel
  , inferLetBoundFuel
  , inferLetFuel
  , inferLetGoFuel
  , inferLetIgnoredFuel
  , inferPiFuel
