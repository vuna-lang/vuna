module Vuna.Compiler.Elab.InstName
  ( argNameOf
  , argSuffix
  , argSuffixTail
  , derivedInstName
  , exprNameFor
  , instanceHeadName
  , instanceName
  ) where

-- Vuna.Compiler.Elab.InstName：实例名派生（trait 投影/实例字典的符号名）。
-- 拆自 `Elab/Trait.vuna`（M30 收尾：Trait 单模块超过 context-budget 的 1195 行）。
-- 纯函数、无状态；Trait 与 Codegen.Split 共用 `instanceName` / `derivedInstName`。
import Vuna.Compiler.Common
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Frontend.Ast

-- 实例头 `Show Int` 的类名与实参。
instanceHeadName : Expr -> Maybe String
instanceHeadName (EVar n sp) = Just n
instanceHeadName (EApp fn args sp) = case fn of
  EVar n fsp => Just n
  _ => Nothing
instanceHeadName _ = Nothing

-- 实例定义名：**单类前缀 + 完整 head 名**（`Eq_Int`、`Eq_Base.Bool.Bool`、`Show_Box_a`）。
-- M29-T2b：命名实例（`as name`）已删除，不再有覆盖名；按「类名 + 头实参」派生仍是唯一规则
-- （同一模块的 `instance Functor IO` / `instance Monad IO` 名字不同）。
--
-- M30（B22）：旧实现把类全名同时放进前缀和头名，生成 `Base.Eq.Eq_Base.Eq.Eq_Int`
-- 这类双前缀。现在**类部分只取短名一次**；head 部分保留**完整限定名**：库模块里的
-- data 解析后是 `<模块>.<名字>`（`Base.Bool.Bool`），入口文件里是裸名（`Bool`）。
-- 这样不同模块的同名 data（base 的 `Base.Bool.Bool` 与用户自己的 `Bool`）不再生成
-- 同一个 dict 名——否则 `findInstanceClash` 的名字判重会把两个合法 head 误报成
-- duplicate（monad/01 等夹具的回归）。同一类内的 head 唯一性仍由 coherence 保证
-- （`anyInstanceExact` / `anyInstanceOverlap` 按 head 判定）。
instanceName : String -> Expr -> String
instanceName cname headExpr = baseNameOf cname ++ "_" ++ derivedInstName headExpr

-- 实例头的名字后缀（类名本身不计入，类短名已由 `instanceName` 加过一次）：
-- `Eq Int` → `Int`、`Eq Base.Bool.Bool` → `Base.Bool.Bool`、`Eq (Box a)` → `Box_a`。
derivedInstName : Expr -> String
derivedInstName (EApp fn args sp) = argSuffixTail args
derivedInstName other = exprNameFor other

-- 头实参的完整名序列（首项无前导下划线；嵌套应用递归拼）。
argSuffixTail : List Expr -> String
argSuffixTail [] = ""
argSuffixTail (a :: rest) = exprNameFor a ++ argSuffix rest

argSuffix : List Expr -> String
argSuffix [] = ""
argSuffix (a :: rest) = "_" ++ exprNameFor a ++ argSuffix rest

-- 类型表达式的完整名：`EVar` 直接用解析后的全名（库模块 = `<模块>.<名字>`，入口 = 裸名；
-- 不能再取最后一段，否则不同模块的同名 data 会撞名）。
exprNameFor : Expr -> String
exprNameFor e = case e of
  EVar n sp => n
  EInt n sp => strFromInt n
  EStr s sp => s
  -- M29-T2b：参数化实例名要能区分 `Box a` / `Pair a b`（旧实现一律 "X" → `Eq_X` 撞名）。
  EApp fn args sp => exprNameFor fn ++ argSuffix args
  _ => "X"

-- 实例头实参的名字（`Pretty Color` 里的 `Color`）。
argNameOf : Expr -> String
argNameOf (EVar n sp) = n
argNameOf _ = "Int"
