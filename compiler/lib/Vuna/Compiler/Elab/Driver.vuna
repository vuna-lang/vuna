-- Vuna.Compiler.Elab.Driver：精化入口与程序组装：签名 → data/trait/instance → 定义体 → zonk/终止性检查 → DtProgram；
-- 以及目标（goal）收集与未解元变量的诊断（zonkGoal/goalsOfProgram/elabProgram*）。
-- 拆自 M24 的单一 `Elab.vuna`（按真实调用图切；门面仍是 `Vuna.Compiler.Elab`）。
import Vuna.Compiler.Common
import Base.HashMap
import Base.IntMap
import Vuna.Compiler.Debug
import Vuna.Compiler.Core
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Elab.Data
import Vuna.Compiler.Elab.Derive
import Vuna.Compiler.Elab.Dict
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Elab.Records
import Vuna.Compiler.Elab.Term
import Vuna.Compiler.Elab.Termination
import Vuna.Compiler.Elab.Trait
import Vuna.Compiler.Elab.Usage
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Intrinsics
import Vuna.Compiler.Frontend.Ast

unsolvedMeta : Ec -> Maybe Int
unsolvedMeta ec = unsolvedFromRelevant 0 (ecNext ec) (ecSolTbl ec) (relevantMetas ec) (ecGoals ec)

-- M23：只把「运行时相关位置」出现的元变量当未解错误。HM 生成的签名会把某些类型参数隐式
-- 量化（f : t1 -> List (Pair t1 t2) -> ...），调用点传 Nil 这类多态值时不约束 t2，
-- 于是留一个只出现在擦除位置的元变量——它对运行时没有意义（codegen 不生成该实参），
-- 不应算错误。洞（有 goal 的元变量）永远算未解。
unsolvedFromRelevant : Int -> Int -> IntMap Value -> List Int -> List DtGoal -> Maybe Int
unsolvedFromRelevant i stop sols relevant goals =
  unsolvedFromRelevantGo (stop - i) stop sols relevant goals

unsolvedFromRelevantGo : Int -> Int -> IntMap Value -> List Int -> List DtGoal -> Maybe Int
unsolvedFromRelevantGo remaining stop sols relevant goals = if remaining <= 0 then Nothing
else
  let
    i = stop - remaining
  in case metaLookup i sols of
    Just _ => unsolvedFromRelevantGo (remaining - 1) stop sols relevant goals
    Nothing =>
      if memMetaId i relevant || isJust (findGoal i goals) then Just i
      else unsolvedFromRelevantGo (remaining - 1) stop sols relevant goals

-- ---------------------------------------------------------------
-- 精化入口
-- ---------------------------------------------------------------
-- 按源顺序精化签名：每个签名只对「prelude + 之前的签名」可见。
elabSigs : List (Pair String (Pair (List Expr) (Pair Expr Span))) -> List (Pair String Term) -> Ec -> Result (Pair (List (Pair String Term)) Ec)
elabSigs sigs globals ec =
  elabSigsGo sigs globals (ecSetGlobalsComplete (ecPutGlobalsTbl ec (globalsTableOf globals)) True)
    []

-- 新签名先前插到 acc（末尾一次 reverse 还原源顺序）；后续签名检查要看得到**已收集**的
-- 签名，所以 live（globals 参数）也用前插累积（查找顺序无关语义）。
-- 旧实现逐个 `append globals [sig]` 是 O(#globals)/次 ⇒ 整程序 O(n²)。
elabSigsGo : List (Pair String (Pair (List Expr) (Pair Expr Span))) -> List (Pair String Term) -> Ec -> List (Pair String Term) -> Result (Pair (List (Pair String Term)) Ec)
elabSigsGo [] globals0 ec acc = Ok (Pair (append globals0 (reverse acc)) ec)
elabSigsGo ((Pair name (Pair ctxExprs (Pair tyExpr sigSpan))) :: rest) globals ec acc = andThen (checkType globals emptyCtx ec tyExpr) (\p => case p of
  Pair tyTerm0 (Pair sortLvl ec1) => andThen (elabSigDictBinders globals ec1 tyTerm0 ctxExprs sigSpan) (\q => case q of
    Pair tyTerm1 ec2 =>
      let
        sigTy = zonkTerm ec2 0 tyTerm1
      in elabSigsGo rest (Pair name sigTy :: globals)
        (ecPutGlobalsTbl ec2 (Base.HashMap.insert name sigTy (ecGlobalsTbl ec2)))
        (Pair name sigTy :: acc)
  )
)

-- 顶层签名里的前导隐式 Pi 前缀 → Ctx（`{a : Type} -> {n : Nat} -> ...`）。
leadingImplicitCtx : Term -> Ctx
leadingImplicitCtx ty0 = leadingImplicitCtxGo emptyCtx ty0

leadingImplicitCtxGo : Ctx -> Term -> Ctx
leadingImplicitCtxGo ctx (TPi n True rig dom cod) =
  let
    domVal = eval (ctxEnv ctx) dom
  in leadingImplicitCtxGo (ctxBindValue n domVal ctx) cod
leadingImplicitCtxGo ctx _ = ctx

-- M32：把签名的 trait 约束 `C1 a, C2 b =>` 精化成隐式 Rig1 字典 binder，插在前导隐式
-- binder 之后（与 `liftFreeDictGoals` 的插入点同一规则）。约束域名里的类型变量在此处
-- 正好落在 prefix 的 de Bruijn 环境里，可以直接作为新 Pi 的 domain。
elabSigDictBinders : List (Pair String Term) -> Ec -> Term -> List Expr -> Span -> Result (Pair Term Ec)
elabSigDictBinders globals ec tyTerm [] sp = Ok (Pair tyTerm ec)
elabSigDictBinders globals ec tyTerm ctxExprs sp = andThen (constraintPartsOf sp ctxExprs) (\parts => andThen (elabConstraintDomains (ecClasses ec) globals (leadingImplicitCtx tyTerm) parts sp ec) (\q => let
  doms = firstOf q
  ec1 = secondOf q
in Ok (Pair (insertSigDicts tyTerm doms (leadingImplicitCount tyTerm)) ec1)
)
)

-- 字典 binder 插在前导隐式 binder 之后（与 `liftFreeDictGoals` 同一位置）：
--   * 有类型变量 / 用户隐式 binder（nImp > 0）：逆序插在第 nImp-1 个 binder 之后，
--     后插的在外，最终顺序 = `_ctx0, _ctx1, ...`；`insertDictBinder` 的 shift 负责
--     已插入 binder 的域移位。
--   * 没有前导隐式 binder（nImp == 0，如 `Show Int => ...`）：直接在最外层 prepend。
--     此时域名里没有前缀变量可引用（自由变量都已被量化成隐式 binder），无需 shift。
insertSigDicts : Term -> List Term -> Int -> Term
insertSigDicts ty [] nImp = ty
insertSigDicts ty doms nImp =
  if nImp <= 0 then prependSigDicts ty doms 0
  else insertSigDictsRev ty doms (length doms - 1) (nImp - 1)

prependSigDicts : Term -> List Term -> Int -> Term
prependSigDicts ty [] k = ty
prependSigDicts ty (dom :: rest) k =
  TPi (sigDictName k) True RigOmega dom (prependSigDicts ty rest (k + 1))

insertSigDictsRev : Term -> List Term -> Int -> Int -> Term
insertSigDictsRev ty [] k baseIdx = ty
insertSigDictsRev ty (dom :: rest) k baseIdx =
  insertSigDictsRev (insertDictBinder (sigDictName k) baseIdx dom ty) rest (k - 1) baseIdx

sigDictName : Int -> String
sigDictName k = "_ctx${k}"

-- ---------------------------------------------------------------
-- M32：显式签名约束下的字典目标消解
-- ---------------------------------------------------------------
-- body 精化时，调用点的字典实参在类参数还没解出时被延迟成 `DtDictGoal`（裸 meta）；
-- 若签名声明了 `C a`，这些目标应解到声明的 `_ctx<k>` binder，而不是再被
-- `liftFreeDictGoals` 提升成新的隐式参数。目标域与 binder 类型 conv 相等即命中。
record DeclDictBinder where
  declDictName : String
  declDictLevel : Int
  declDictDom : Value

-- 签名前导隐式前缀里的字典 binder（源码顺序 = level 升序）。
declaredDictBinders : Ec -> Term -> List DeclDictBinder
declaredDictBinders ec ty = declaredDictBindersGo ec emptyCtx ty []

declaredDictBindersGo : Ec -> Ctx -> Term -> List DeclDictBinder -> List DeclDictBinder
declaredDictBindersGo ec ctx (TPi n True rig dom cod) acc =
  let
    domVal = eval (ctxEnv ctx) dom
    acc2 = if isDictDomain ec domVal then DeclDictBinder n (ctxDepth ctx) domVal :: acc else acc
  in declaredDictBindersGo ec (ctxBindValue n domVal ctx) cod acc2
declaredDictBindersGo ec ctx _ acc = reverse acc

-- 消解目标并把 body 里的 `?m` 换成 ctx 字典变量；剩下的目标留给 `liftFreeDictGoals`。
-- M34 冷路径：绝大多数定义体精化后没有任何延迟字典目标（编译器全包 3031 个定义中
-- 只有 9 个非空），先查目标表可以省掉 `declaredDictBinders` 整条隐式 Pi 前缀的求值。
solveDeclaredDictGoals : Ec -> Term -> Term -> Pair Term Ec
solveDeclaredDictGoals ec ty body = case ecDictGoals ec of
  [] => Pair body ec
  _ => case declaredDictBinders ec ty of
    [] => Pair body ec
    binders =>
      let
        solved = solveDeclaredDictGoalsGo ec binders (ecDictGoals ec) [] []
      in Pair (applyDeclaredDictSubsts (firstOf solved) body) (secondOf solved)

record DictSubst where
  dictSubstMeta : Int
  dictSubstName : String
  dictSubstQ : Int

solveDeclaredDictGoalsGo : Ec -> List DeclDictBinder -> List DtDictGoal -> List DtDictGoal -> List DictSubst -> Pair (List DictSubst) Ec
solveDeclaredDictGoalsGo ec binders goals kept acc = case goals of
  [] => Pair (reverse acc) (ecPutDictGoals ec (reverse kept))
  (g@(DtDictGoal m dom)) :: rest => case metaLookup m (ecSolTbl ec) of
    Just _ => solveDeclaredDictGoalsGo ec binders rest (g :: kept) acc
    Nothing => case firstMatchDictBinder ec binders dom of
      Nothing => solveDeclaredDictGoalsGo ec binders rest (g :: kept) acc
      Just b =>
        let
          -- q = level + 1：出现点（term 根下的 lambda 深度 depth）的 index = depth - q，正好等于
          -- 该 binder 在「全部隐式 binder 之外再加 depth 层 λ」处的 de Bruijn index。
          q = b.declDictLevel + 1
        in case solveMeta (ecDefTbl ec) (ecSolsP ec) 0 m [] (VNeutral (NVar b.declDictName b.declDictLevel [])) of
          Ok sols2 =>
            solveDeclaredDictGoalsGo (ecPutSols ec (solsList sols2)) binders rest kept
              (DictSubst m b.declDictName q :: acc)
          Err e => solveDeclaredDictGoalsGo ec binders rest (g :: kept) acc

firstMatchDictBinder : Ec -> List DeclDictBinder -> Value -> Maybe DeclDictBinder
firstMatchDictBinder ec [] dom = Nothing
firstMatchDictBinder ec (b :: rest) dom =
  if dictDomMatches ec b.declDictDom dom then Just b else firstMatchDictBinder ec rest dom

dictDomMatches : Ec -> Value -> Value -> Bool
dictDomMatches ec a b = case conv (ecDefTbl ec) (ecSolsP ec) 0 (forceVal ec a) (forceVal ec b) of
  Ok _ => True
  Err _ => False

applyDeclaredDictSubsts : List DictSubst -> Term -> Term
applyDeclaredDictSubsts [] body = body
applyDeclaredDictSubsts (s :: rest) body =
  applyDeclaredDictSubsts rest (substMetaVar s.dictSubstMeta s.dictSubstName s.dictSubstQ body)

-- 子句表（名字 → 该函数的全部 clause，源顺序）。旧实现每个定义都扫一遍剩余声明
-- （clausesFor）⇒ O(n²)；这里在 bodies 开始时建一次表，查表 O(1)。
clausesTblOf : List Decl -> HashMap (List (Pair (List Pat) Expr))
clausesTblOf decls = clausesTblGo decls (Base.HashMap.fromList [])

clausesTblGo : List Decl -> HashMap (List (Pair (List Pat) Expr)) -> HashMap (List (Pair (List Pat) Expr))
clausesTblGo [] t = t
clausesTblGo (d :: rest) t = case d of
  DFun n pats body sp =>
    let
      cur = case Base.HashMap.lookup n t of
        Just xs => xs
        Nothing => []
    in clausesTblGo rest (Base.HashMap.insert n (append cur [Pair pats body]) t)
  _ => clausesTblGo rest t

clausesOfTbl : Ec -> List Decl -> String -> List (Pair (List Pat) Expr)
clausesOfTbl ec decls name = case Base.HashMap.lookup name ec.ecClausesTbl of
  Just cs => cs
  Nothing => clausesFor decls name

defAlreadyDone : String -> Ec -> Bool
defAlreadyDone name ec = case Base.HashMap.lookup name (ecDefTbl ec) of
  Just _ => True
  Nothing => False

-- 有体的定义（名字 → 体）：axiom 是无体顶层，不能进 delta 展开 / 求值环境。
defBodyPairs : List DtDef -> List (Pair String Term)
defBodyPairs defs = mapMaybe defBodyPair defs

defBodyPair : DtDef -> Maybe (Pair String Term)
defBodyPair d = case dtDefBody d of
  Just body => Just (Pair (dtDefName d) body)
  Nothing => Nothing

-- 之后会有定义体的 DFun 名（实例字典名由 `instHeads` 单独提供）。
declFunNames : List Decl -> List String
declFunNames [] = []
declFunNames (d :: rest) = case d of
  DFun name pats body sp => name :: declFunNames rest
  _ => declFunNames rest

elabBodies : List Decl -> List (Pair String Term) -> List (Pair String Term) -> List DtDef -> Ec -> Result (Pair (List DtDef) Ec)
elabBodies [] globals doneDefs acc ec = Ok (Pair (reverse acc) ec)
elabBodies (d :: rest) globals doneDefs acc ec = case d of
  DFun name pats body sp => case globalsLookup name globals ec of
    Nothing => tcErr1 sp (ExpectedSignature name) name
    Just tyTerm => if defAlreadyDone name ec then elabBodies rest globals doneDefs acc ec
    else
      let
        _ = stampSample (strFromInt (spanStartLine sp)) "DEF ${name}"
      in andThen (elabFunDef globals ec (clausesOfTbl ec (d :: rest) name) (eval [] tyTerm) sp) (\p => let
        _ = stampSample (strFromInt (spanStartLine sp)) "FUN ${name}"
      in case p of
        Pair bodyTerm ec1 =>
          let
            -- M32：先把命中的延迟字典目标解到签名声明的 ctx binder（若有），剩余目标
            -- 才由 liftFreeDictGoals 提升成新的隐式参数。
            solvedDecl = solveDeclaredDictGoals ec1 tyTerm bodyTerm
            bodyTerm1 = firstOf solvedDecl
            ec1b = secondOf solvedDecl
            lifted = liftFreeDictGoals name ec1b tyTerm bodyTerm1
            liftedTy = firstOf lifted
            liftedBody = firstOf (secondOf lifted)
            liftedEc = secondOf (secondOf lifted)
            cleanTerm =
              if termHasAnyMeta liftedBody then substDictTerm liftedEc liftedBody else liftedBody
            -- 正文检查读的是哈希索引：只插表，不逐定义重建 globals list
            -- （replaceGlobalType 是 O(#globals)/定义 ⇒ 整程序 O(n²)；该 list 只在
            -- 签名阶段与最终 DtProgram 里用，正文阶段以表为准）。
            ecGlobals =
              ecPutGlobalsTbl liftedEc (Base.HashMap.insert name liftedTy (ecGlobalsTbl liftedEc))
            ecWithDef = ecAddDef ecGlobals (Pair name cleanTerm)
          in elabBodies rest globals (Pair name liftedTy :: doneDefs)
            (DtDef name liftedTy cleanTerm (Just sp) :: acc) ecWithDef
      )
  -- M28：axiom 只产出无体/不透明的 `DtAxiom`（类型已在签名阶段精化进 globals）；
  -- 不进 Ec 的 defs 表（没有体可 delta 展开），也不进 doneDefs。
  DAxiom name tyExpr sp => case globalsLookup name globals ec of
    Nothing => tcErr1 sp (ExpectedSignature name) name
    Just tyTerm => elabBodies rest globals doneDefs (DtAxiom name tyTerm (Just sp) :: acc) ec
  -- M33 W5：extern 的签名同样已在 globals；这里只做受限 FFI 类型检查并落成 DtExtern。
  DExtern name cName tyExpr sp => case globalsLookup name globals ec of
    Nothing => tcErr1 sp (ExpectedSignature name) name
    Just tyTerm =>
      andThen (checkExternTy sp tyTerm)
        (\_ => elabBodies rest globals doneDefs (DtExtern name tyTerm cName (Just sp) :: acc) ec)
  _ => elabBodies rest globals doneDefs acc ec

-- 每个签名都必须有定义；`axiom`（DAxiom）是无体的可擦除顶层，不要求 DFun。
-- M34 冷路径：decls/globals 的成员查询改为一次性建表。旧实现对每个签名线性扫
-- 全部 decls（hasFunClause ×2 + axiomSpanOf，O(#sigs × #decls) ⇒ 整程序 O(n²)）。
checkAllDefined : List (Pair String (Pair (List Expr) (Pair Expr Span))) -> List (Pair String Term) -> List Decl -> Result (List String)
checkAllDefined sigs globals decls =
  checkAllDefinedGo sigs (Base.HashMap.ofNames (map firstOf globals)) (funNamesTbl decls)
    (axiomSpansTbl decls)

checkAllDefinedGo : List (Pair String (Pair (List Expr) (Pair Expr Span))) -> HashMap Bool -> HashMap Bool -> HashMap Span -> Result (List String)
checkAllDefinedGo [] globalsTbl funTbl axiomTbl = Ok []
checkAllDefinedGo ((Pair name (Pair ctx (Pair tyExpr sigSpan))) :: rest) globalsTbl funTbl axiomTbl = case Base.HashMap.lookup name axiomTbl of
  Just sp =>
    if Base.HashMap.member name funTbl then tcErr1 sp (AxiomWithDefinition name) name
    else checkAllDefinedGo rest globalsTbl funTbl axiomTbl
  Nothing =>
    if Base.HashMap.member name funTbl then if Base.HashMap.member name globalsTbl then checkAllDefinedGo rest globalsTbl funTbl axiomTbl
    else Err (tcMsg (SignatureNoDef name) (name :: []))
    else Err (tcMsg (SignatureNoDef name) (name :: []))

-- DFun 名字集合（`declFunNames` 已在前面定义；表语义 = 集合）。
funNamesTbl : List Decl -> HashMap Bool
funNamesTbl decls = Base.HashMap.ofNames (declFunNames decls)

-- `axiom` / `extern` 声明的名字 → span（保留**首个**声明的 span，与线性首匹配一致：
-- `HashMap.fromList` 同键时先出现的元素覆盖后出现的）。
axiomSpansTbl : List Decl -> HashMap Span
axiomSpansTbl decls = Base.HashMap.fromList (axiomSpanPairs decls)

axiomSpanPairs : List Decl -> List (Pair String Span)
axiomSpanPairs [] = []
axiomSpanPairs (d :: rest) = case d of
  DAxiom n ty sp => Pair n sp :: axiomSpanPairs rest
  DExtern n c ty sp => Pair n sp :: axiomSpanPairs rest
  _ => axiomSpanPairs rest

hasFunClause : String -> List Decl -> Bool
hasFunClause name [] = False
hasFunClause name (d :: rest) = case d of
  DFun n pats body sp => n == name || hasFunClause name rest
  _ => hasFunClause name rest

-- 该名字是否由 `axiom` 声明（有则返回其 span，用于「axiom 不能有定义」诊断）。
axiomSpanOf : String -> List Decl -> Maybe Span
axiomSpanOf name [] = Nothing
axiomSpanOf name (d :: rest) = case d of
  DAxiom n ty sp => if n == name then Just sp else axiomSpanOf name rest
  DExtern n c ty sp => if n == name then Just sp else axiomSpanOf name rest
  _ => axiomSpanOf name rest

-- ---------------------------------------------------------------
-- M33 W5：受限 FFI 类型检查。允许的类型：Int / String / Bool，以及 Array Int /
-- Array String / Array Bool；只允许显式参数（不允许隐式 / 依赖类型 / 回调 / 泛型）。
checkExternTy : Span -> Term -> Result Int
checkExternTy sp tyTerm = checkExternValue sp 64 0 (eval [] tyTerm)

checkExternValue : Span -> Int -> Int -> Value -> Result Int
checkExternValue sp fuel lvl (VPi name implicit _ dom clo) =
  if fuel <= 0 then tcErr1 sp (FfiTypeUnsupported "too many parameters") "too many parameters"
  else if implicit then tcErr1 sp (FfiTypeUnsupported "implicit parameter") "implicit parameter"
  else andThen (checkExternDomain sp dom)
    (\_ => checkExternValue sp (fuel - 1) (lvl + 1) (applyClosure clo (VNeutral (NVar name lvl []))))
checkExternValue sp fuel lvl v =
  if fuel <= 0 then tcErr1 sp (FfiTypeUnsupported "too many parameters") "too many parameters"
  else checkExternDomain sp v

checkExternDomain : Span -> Value -> Result Int
checkExternDomain sp (VNeutral (NGlobal g args)) = if g == intTypeName || g == strTypeName || g == boolTypeName then Ok 0
else if g == "Array" then case args of
  [elem] => checkExternArrayElem sp elem
  _ => tcErr1 sp (FfiTypeUnsupported "Array needs one type argument") "Array"
else tcErr1 sp (FfiTypeUnsupported g) g
checkExternDomain sp (VNeutral _) = tcErr1 sp (FfiTypeUnsupported "non-global type") "non-global"
checkExternDomain sp _ = tcErr1 sp (FfiTypeUnsupported "non-basic type") "non-basic"

checkExternArrayElem : Span -> Value -> Result Int
checkExternArrayElem sp (VNeutral (NGlobal g args)) =
  if g == intTypeName || g == strTypeName || g == boolTypeName then Ok 0
  else tcErr1 sp (FfiTypeUnsupported "Array ${g}") g
checkExternArrayElem sp _ =
  tcErr1 sp (FfiTypeUnsupported "Array element is not a basic type") "array-element"

-- M23：REPL 表达式求值（`Vuna.Compiler.Driver.Dt.dtEvalExpr` 的下半段）
-- ---------------------------------------------------------------
-- 在**已精化程序**的环境（globals / 实例表 / 类表 / 解表）里精化并求值一条表达式。
-- 新元变量从程序的元变量游标之后分配，因此程序阶段遗留的 meta 只可能已解
-- （`elabProgramGo` 已校验过）；表达式自己留下的未解 meta 单独报清晰错误。
-- 字典约束（`==` 等）用与定义体相同的收敛回填，最后在 defs + 解表上归一化并 show。
-- ---------------------------------------------------------------
-- REPL v2：交互式值显示（只用于 REPL；诊断仍用 showValueAt，文案不变）
--
-- 与 `showValue` 的差别：
--   * 按构造子 telescope 的 rig 过滤擦除实参（`Cons Int 1 Nil` → `Cons 1 Nil`）；
--   * 列表 / 元组 / Maybe 语法糖（`[1, 2]`、`(1, 2)`、`Just 1`）；
--   * 函数值显示 `<函数>`，未解元变量显示 `_`。
-- 值先 quote 再 zonk：`showValue` 不会递归替换 spine 里已解的元变量。
-- 渲染组走显式 fuel（互递归不在项结构上严格下降，与 `evalFuel` 同一手法）。
showValueRepl : List DtData -> Ec -> Value -> String
showValueRepl datas ec v = renderReplTerm 512 (allReplCtors datas) (zonkTerm ec 0 (quote 0 v))

allReplCtors : List DtData -> List DtCtor
allReplCtors [] = []
allReplCtors (d :: rest) = append (dtDataCtors d) (allReplCtors rest)

renderReplTerm : Int -> List DtCtor -> Term -> String
renderReplTerm fuel ctors t = if fuel <= 0 then showTerm t
else case t of
  TCon c args => renderReplCtor (fuel - 1) ctors c args
  TLam name rig body => "<函数>"
  TMeta m => "_"
  TGlobal g => replShortName g
  TApp f a r => renderReplApp (fuel - 1) ctors (TApp f a r)
  _ => showTerm t

-- 中性应用：头是全局定义时显示短名 + 实参（`Zero`、`f 1`）；其它回退 showTerm。
renderReplApp : Int -> List DtCtor -> Term -> String
renderReplApp fuel ctors t = if fuel <= 0 then showTerm t
else case spineOf t of
  Pair head args => case head of
    TGlobal g => replShortName g ++ renderReplArgs (fuel - 1) ctors args
    _ => showTerm t

replShortName : String -> String
replShortName g = secondOf (splitLastDot (splitOnDot g))

spineOf : Term -> Pair Term (List Term)
spineOf (TApp f a r) = case spineOf f of
  Pair head args => Pair head (appendLastTerm args a)
  _ => Pair (TApp f a r) []
spineOf t = Pair t []

appendLastTerm : List Term -> Term -> List Term
appendLastTerm xs x = append xs [x]

-- | 自动补注（M41 新增导出）：replNatZeroName。
replNatZeroName : String
replNatZeroName = "Base.Nat.Nat.Zero"

-- | 自动补注（M41 新增导出）：replNatSuccName。
replNatSuccName : String
replNatSuccName = "Base.Nat.Nat.Succ"

replNatValue : Int -> List DtCtor -> Term -> Maybe Int
replNatValue fuel ctors t = if fuel <= 0 then Nothing
else case t of
  TCon c args => if c == replNatZeroName then Just 0
  else if c == replNatSuccName then case keptCtorArgs ctors c args of
    [arg] => case replNatValue (fuel - 1) ctors arg of
      Just n => Just (n + 1)
      Nothing => Nothing
    _ => Nothing
  else Nothing
  _ => Nothing

renderReplCtor : Int -> List DtCtor -> String -> List (Pair Term Rig) -> String
renderReplCtor fuel ctors c args = if fuel <= 0 then "<值>"
else
  let
    kept = keptCtorArgs ctors c args
  in if c == replNatZeroName then "0"
  else if c == replNatSuccName then case kept of
    [arg] => case replNatValue (fuel - 1) ctors arg of
      Just n => strFromInt (n + 1)
      Nothing => renderReplGeneric (fuel - 1) ctors "Succ" kept
    _ => renderReplGeneric (fuel - 1) ctors "Succ" kept
  else if c == replListNilName then "[]"
  else if c == replListConsName then renderReplList (fuel - 1) ctors kept
  else if c == replPairName then renderReplPair (fuel - 1) ctors kept
  else if c == replJustName then renderReplUnary (fuel - 1) ctors "Just" kept
  else if c == replNothingName then "Nothing"
  else renderReplGeneric (fuel - 1) ctors (replShortName c) kept

renderReplList : Int -> List DtCtor -> List Term -> String
renderReplList fuel ctors [] = "[]"
renderReplList fuel ctors (h :: rest) = if fuel <= 0 then "[]"
else case rest of
  [t] => case renderReplListTail (fuel - 1) ctors t of
    Just tailText => "[" ++ renderReplArg (fuel - 1) ctors h ++ tailText
    Nothing => renderReplGeneric (fuel - 1) ctors "Cons" (h :: t :: [])
  _ => renderReplGeneric (fuel - 1) ctors "Cons" (h :: rest)

renderReplListTail : Int -> List DtCtor -> Term -> Maybe String
renderReplListTail fuel ctors t = if fuel <= 0 then Nothing
else case t of
  TCon c args => if c == replListNilName then Just "]"
  else if c == replListConsName then case keptCtorArgs ctors c args of
    [h, t2] => case renderReplListTail (fuel - 1) ctors t2 of
      Just tailText => Just (", " ++ renderReplArg (fuel - 1) ctors h ++ tailText)
      Nothing => Nothing
    _ => Nothing
  else Nothing
  _ => Nothing

renderReplPair : Int -> List DtCtor -> List Term -> String
renderReplPair fuel ctors args = if fuel <= 0 then "<值>"
else case args of
  [a, b] =>
    "(" ++ renderReplArg (fuel - 1) ctors a ++ ", " ++ renderReplArg (fuel - 1) ctors b ++ ")"
  _ => renderReplGeneric (fuel - 1) ctors "Pair" args

renderReplUnary : Int -> List DtCtor -> String -> List Term -> String
renderReplUnary fuel ctors label args = if fuel <= 0 then "<值>"
else case args of
  [a] => label ++ " " ++ renderReplArg (fuel - 1) ctors a
  _ => renderReplGeneric (fuel - 1) ctors label args

renderReplGeneric : Int -> List DtCtor -> String -> List Term -> String
renderReplGeneric fuel ctors label args =
  if fuel <= 0 then "<值>" else label ++ renderReplArgs (fuel - 1) ctors args

renderReplArgs : Int -> List DtCtor -> List Term -> String
renderReplArgs fuel ctors [] = ""
renderReplArgs fuel ctors (a :: rest) =
  if fuel <= 0 then ""
  else " " ++ renderReplArg (fuel - 1) ctors a ++ renderReplArgs (fuel - 1) ctors rest

renderReplArg : Int -> List DtCtor -> Term -> String
renderReplArg fuel ctors t =
  if fuel <= 0 then "<值>"
  else if isReplAtom ctors t then renderReplTerm (fuel - 1) ctors t
  else "(" ++ renderReplTerm (fuel - 1) ctors t ++ ")"

isReplAtom : List DtCtor -> Term -> Bool
isReplAtom ctors (TInt n) = True
isReplAtom ctors (TStr s) = True
isReplAtom ctors (TBool b) = True
isReplAtom ctors (TVar name i) = True
isReplAtom ctors (TGlobal g) = True
isReplAtom ctors (TType l) = True
isReplAtom ctors (TMeta m) = True
isReplAtom ctors (TCon c args) =
  c == replListNilName
    || c == replPairName
    || c == replNothingName
    || natToInt (length (keptCtorArgs ctors c args)) == 0
isReplAtom ctors _ = False

-- 按构造子 telescope 的 rig 过滤擦除实参；找不到构造子时保留全部。
keptCtorArgs : List DtCtor -> String -> List (Pair Term Rig) -> List Term
keptCtorArgs ctors c args = case findCtorIn c ctors of
  Nothing => map (\p => firstOf p) args
  Just ctor => zipKeptArgs (dtCtorTelescope ctor) args

zipKeptArgs : List (Pair String Rig) -> List (Pair Term Rig) -> List Term
zipKeptArgs [] args = map (\p => firstOf p) args
zipKeptArgs (b :: bs) [] = []
zipKeptArgs (b :: bs) ((Pair a rig) :: rest) =
  if rigIsErased (secondOf b) then zipKeptArgs bs rest else a :: zipKeptArgs bs rest

-- | 自动补注（M41 新增导出）：replListNilName。
replListNilName : String
replListNilName = "Base.List.List.Nil"

-- | 自动补注（M41 新增导出）：replListConsName。
replListConsName : String
replListConsName = "Base.List.List.Cons"

replPairName : String
replPairName = "Base.Pair.Pair"

-- | 自动补注（M41 新增导出）：replJustName。
replJustName : String
replJustName = "Base.Maybe.Maybe.Just"

-- | 自动补注（M41 新增导出）：replNothingName。
replNothingName : String
replNothingName = "Base.Maybe.Maybe.Nothing"

dtEvalExprIn : DtProgram -> Expr -> Result String
dtEvalExprIn prog expr = andThen (dtEvalExprInInfo prog expr) (\p => Ok (firstOf p))

-- M30 · REPL：同时返回值文本与 zonk 后的类型文本（类型决定是否走效果执行）。
dtEvalExprInInfo : DtProgram -> Expr -> Result (Pair String String)
dtEvalExprInInfo prog expr = case prog of
  DtProgram datas defs goals sols globals insts classes next defvals depths =>
    let
      -- M28：axiom 无体，不进 delta 展开 / 求值环境（只剩 globals 里的类型）。
      bodies = defBodyPairs defs
      -- M30（D18）：表达式求值与程序同一套环（构造子索引 + 定义值共享缓存）。
      ec0 =
        Ec next sols (reverse bodies) datas [] [] insts classes [] (Base.HashMap.fromList bodies)
          (globalsTableOf globals) (solsToTbl sols) (Base.IntMap.fromList []) True
          (Base.HashMap.fromList []) (ctorTblOfDatas datas) defvals (datasHaveLinear datas)
    in andThen (inferE globals emptyCtx ec0 expr) (\p => case p of
      Pair term (Pair ty ec1) =>
        let
          ec2 = resolveDictGoalsFix globals ec1 8
          sols2 = ecSols ec2
          -- 顶层 `force` 只解开类型头部的元变量，spine 里已解的元变量（如
          -- `List ?97` 的元素类型）不会被递归替换；先 quote 再 zonk 才能把类型
          -- 文本渲染成具体类型（REPL `:type` 与自动签名写回都依赖这一点）。
          tyText =
            showTypeSig
              (zonkTerm ec2 0 (quote 0 (force (Base.HashMap.fromList bodies) (ecSolsP ec2) defaultFuel ty)))
        in case firstUnsolvedInterpGoal ec2 of
          Just td => tcErr1NoLoc (InterpNoInstance td) td
          Nothing => case unsolvedFrom next (ecNext ec2) (ecSolTbl ec2) of
            Just m => tcErr1 (exprSpan expr) (UnsolvedMetavarInfer (strFromInt m)) (strFromInt m)
            Nothing => case normalize (Base.HashMap.fromList bodies) (ecSolsP ec2) defaultFuel (eval [] term) of
              VInt n => Ok (Pair (strFromInt n) tyText)
              v => Ok (Pair (showValueRepl datas ec2 v) tyText)
    )

-- 精化入口。M19：先做 record 降级（`Elab.Records.prepareDecls`）——record 是纯记法。
-- M25：没有 trusted/检查豁免；终止性对每个包、每个模块一致执行。
elabProgramFull : List Decl -> Result DtProgram
elabProgramFull decls =
  andThen (prepareDecls decls) (\ds => andThen (expandDerivings ds) (\ds2 => elabProgramGo ds2))

elabProgramGo : List Decl -> Result DtProgram
elabProgramGo decls = elabProgramGoWith ecEmpty preludeGlobals decls

-- 接口摘要路径的完整入口：与 elabProgramFull 同一条前置降级链（record / deriving），
-- 但起始 Ec / globals 由依赖摘要注入。
elabProgramFullWith : Ec -> List (Pair String Term) -> List Decl -> Result DtProgram
elabProgramFullWith startEc startGlobals decls =
  elabProgramFullWithAux startEc startGlobals [] decls

-- termAux：只供终止性分析使用的「依赖包声明」（跨包投影/构造子/子句关系）；不参与精化。
-- 依赖包自己的终止性已在它自己的 check 里验过（本路径只报告本包函数的失败）。
elabProgramFullWithAux : Ec -> List (Pair String Term) -> List Decl -> List Decl -> Result DtProgram
elabProgramFullWithAux startEc startGlobals termAux decls =
  andThen (prepareDeclsWith termAux decls)
    (\ds => andThen (expandDerivings ds) (\ds2 => andThen (prepareDecls termAux) (\ads => andThen (expandDerivings ads) (\ads2 => elabProgramGoWithAux startEc startGlobals ads2 ds2))))

-- M34.5 接口摘要第一步：起始状态（依赖包的签名 globals + Ec 摘要）参数化，供
-- 「只精化本包 decls、复用依赖包摘要」的调用方注入。行为与 elabProgramGo 完全一致。
elabProgramGoWith : Ec -> List (Pair String Term) -> List Decl -> Result DtProgram
elabProgramGoWith startEc startGlobals decls = elabProgramGoWithAux startEc startGlobals [] decls

-- M40：精化到「定义体 + 实例体」完成的状态。收尾校验（未解洞/用量/终止性）与工具查询
-- （洞目标）都从这里分叉：未解洞只让 strict 收尾失败；`goalsOfProgramTolerant` 仍可读 goals。
record ElabCore where
  coreDatas : List DtData
  coreEc : Ec
  coreDefs : List DtDef
  coreInstDefs : List DtDef
  coreGlobals : List (Pair String Term)
  coreProjSpans : List (Pair String Span)

elabProgramCoreWithAux : Ec -> List (Pair String Term) -> List Decl -> Result ElabCore
elabProgramCoreWithAux startEc startGlobals decls = andThen (collectSigs decls) (\sigs => let
  _ = stamp "collectSigs-done"
in andThen (elabDatas (collectDataDecls decls []) startGlobals startEc) (\pd => case pd of
  Pair datas (Pair globals0 ec0) =>
    let
      -- M30（D18）：data 精化完成后一次性建构造子索引（之后 ecAddData 增量维护）；
      -- 索引 miss 会回落线性扫 `ecDatas`，所以这里只影响速度。
      ec0b = ecPutCtorTbl ec0 (ctorTblOfDatas (ecDatas ec0))
      _ = stamp "datas-done"
    in andThen (elabTraits (collectTraitDecls decls []) globals0 ec0b) (\pt => case pt of
      Pair classDatas (Pair projGlobals (Pair _ (Pair projSpans ec1))) =>
        let
          globals1 = append globals0 projGlobals
          datas1 = append datas classDatas
          -- 接口摘要路径：起始 Ec 已带依赖包的类表；实例头/体必须看**全部**类，
          -- 不能只看本包 `elabTraits` 新声明的那些（否则 `deriving (Eq)` 解析出的
          -- `Base.Eq.Eq` 找不到）。全量路径下两者相同。
          classesAll = ecClasses ec1
          _ = stamp "traits-done"
        in andThen (checkInstanceHeads (collectInstDecls decls []) classesAll globals1 ec1) (\pih => case pih of
          Pair instHeads ec1b =>
            let
              globals2 = append globals1 instHeads
              _ = stamp "instheads-done"
            in andThen (elabSigs sigs globals2 ec1b) (\p => case p of
              Pair globals ec2 =>
                let
                  -- 正文检查前的唯一一次建表：globals 此时已固定（sigs + inst heads）。
                  ec2b =
                    ecPutClausesTbl
                      (ecSetGlobalsComplete (ecPutGlobalsTbl ec2 (globalsTableOf globals)) True)
                      (clausesTblOf decls)
                  _ = stamp "sigs-elab-done"
                in andThen (checkAllDefined sigs globals decls) (\_ => andThen (elabBodies decls globals [] [] ec2b) (\q => case q of
                  Pair defs0 ec3a =>
                    let
                      -- M23：字典目标可能在「类参数刚被解出」之后才有唯一实例，而
                      -- resolveDictGoals 只在 checkByInfer 路径调用；每轮定义体之后先收敛
                      -- 一轮，定义体里的延迟字典实参要被替换成实例项（否则擦除检查会看到
                      -- 运行时位置的 TMeta）。
                      ec3 = resolveDictGoalsFix globals ec3a 8
                      defs = rezonkDefs ec3 defs0
                      _ =
                        stamp
                          "bodies-done g=${length globals} sols=${length (ecSols ec3a)} defs=${length (ecDefs ec3a)} metas=${ecNext ec3a} dgoals=${length (ecDictGoals ec3a)} datas=${length (ecDatas ec3a)} insts=${length (ecInsts ec3a)} classes=${length (ecClasses ec3a)}"
                    in andThen (elabInstanceBodies decls classesAll datas1 globals ec3) (\pi => case pi of
                      Pair instDefs0 ec4a =>
                        let
                          ec4 = resolveDictGoalsFix globals ec4a 8
                          instDefs = rezonkDefs ec4 instDefs0
                          _ = stamp "instbodies-done"
                        in Ok (ElabCore datas1 ec4 defs instDefs globals projSpans)
                    )
                )
                )
            )
        )
    )
)
)

-- 严格收尾：与原来的「未解元变量 / 用量 / 终止性」校验逐字一致，成功才产出 DtProgram。
finishCore : List Decl -> List Decl -> ElabCore -> Result DtProgram
finishCore termAux decls core =
  let
    ec4 = core.coreEc
    datas1 = core.coreDatas
    defs = core.coreDefs
    instDefs = core.coreInstDefs
    globals = core.coreGlobals
    projSpans = core.coreProjSpans
  in case firstUnsolvedMemberGoal ec4 of
    Just md => tcErr1NoLoc (NoInstanceFound md) md
    Nothing => case firstUnsolvedInterpGoal ec4 of
      Just td => tcErr1NoLoc (InterpNoInstance td) td
      Nothing => case unsolvedMeta ec4 of
        -- C42：延迟字典目标里「类参数已解出但实例搜索失败」的，优先报缺实例——
        -- 否则用户只看到 unsolved metavariable，不知道缺的是哪个实例。
        Just m => case firstUnsolvedDictGoal ec4 of
          Just sd => tcErr1NoLoc (NoInstanceFound sd) sd
          Nothing => Err (unsolvedMessage ec4 m)
        Nothing =>
          let
            extra = extraDefsOf globals ec4 projSpans (append instDefs defs)
            allDefs = rezonkDefs ec4 (append instDefs (append extra defs))
            -- bodies 阶段不再逐定义重建 globals（O(n²)）；这里用最终定义集一次性把签名类型
            -- 换成提升后的类型（O(n)）。
            defsTblOut =
              Base.HashMap.insertAll (map (\x => Pair (dtDefName x) (dtDefType x)) allDefs)
                (Base.HashMap.fromList [])
            globalsOut = map (\g => case Base.HashMap.lookup (firstOf g) defsTblOut of
              Just ty => Pair (firstOf g) ty
              Nothing => g
            ) globals
            _ = stamp "extradefs-done"
          in andThen (checkProgramUsage ec4 allDefs) (\_ => andThen (checkTerminationDeclsWith (declFunNames decls) (append termAux decls)) (\_ => let
            _ = stamp "termination-done"
          in Ok
            (DtProgram datas1 allDefs (ecGoals ec4) (ecSols ec4) globalsOut (ecInsts ec4) (ecClasses ec4) (ecNext ec4) (ecDefVals ec4) (Base.IntMap.toList (ecDepthTbl ec4)))
          )
          )

elabProgramGoWithAux : Ec -> List (Pair String Term) -> List Decl -> List Decl -> Result DtProgram
elabProgramGoWithAux startEc startGlobals termAux decls =
  andThen (elabProgramCoreWithAux startEc startGlobals decls)
    (\core => finishCore termAux decls core)

-- 用当前解重新 zonk 定义体（延迟字典元变量 → 实例项）；axiom 无体，原样保留。
rezonkDefs : Ec -> List DtDef -> List DtDef
rezonkDefs ec defs = map (\d => case dtDefBody d of
  Just body =>
    if termHasAnyMeta body then DtDef (dtDefName d) (dtDefType d) (substDictTerm ec body) (dtDefSpan d)
    else d
  Nothing => d
) defs

-- 程序级字典目标收敛：反复回填直到字典目标不再减少（最多 n 轮，防振荡）。
-- M34 冷路径：没有目标时不需要跑（全包在 bodies 收尾处通常只剩个位数目标）。
resolveDictGoalsFix : List (Pair String Term) -> Ec -> Int -> Ec
resolveDictGoalsFix globals ec n = case ecDictGoals ec of
  [] => ec
  _ => resolveDictGoalsFixGo globals ec n

resolveDictGoalsFixGo : List (Pair String Term) -> Ec -> Int -> Ec
resolveDictGoalsFixGo globals ec n =
  let
    ec2 = resolveDictGoals globals ec
  in if n <= 0 then ec2
  else if length (ecDictGoals ec2) < length (ecDictGoals ec) then resolveDictGoalsFixGo globals ec2 (n - 1)
  else ec2

-- M15：未解元变量若来自洞，报洞的目标（而不是光秃秃的编号）。
unsolvedMessage : Ec -> Int -> String
unsolvedMessage ec m = case findGoal m (ecGoals ec) of
  Just g =>
    let
      loc = showSpanLoc g.dtGoalSpan
      -- M40：命名洞在诊断里带上名字（`unsolved hole ?h (/x.vuna:4:7) with goal Int`）。
      spot = if g.dtGoalName == "" then loc else "${g.dtGoalName} (${loc})"
      detail = "${spot} with goal ${showValueAt (ctxDepthOf g) g.dtGoalType}"
    in tcMsg (UnsolvedHole detail) (detail :: [])
  Nothing =>
    let
      num = strFromInt m
      hint = metaOwnerHint ec m
    in tcMsg (UnsolvedMetavar num hint) (num :: hint :: [])

-- 未解元变量的归属提示：扫已精化的定义体与类型，指出它出现在哪个定义里（否则只有 ?m，
-- 在一个上万行的程序里无从定位）。
metaOwnerHint : Ec -> Int -> String
metaOwnerHint ec m = case findDefWithMeta (ecDefs ec) m of
  Just name => " (in `${name}`)"
  Nothing => ""

findDefWithMeta : List (Pair String Term) -> Int -> Maybe String
findDefWithMeta [] m = Nothing
findDefWithMeta ((Pair name body) :: rest) m =
  if termHasMeta m body then Just "${name} body=${showTerm body}" else findDefWithMeta rest m

termHasMeta : Int -> Term -> Bool
termHasMeta m (TMeta k) = k == m
termHasMeta m (TVar n i) = False
termHasMeta m (TGlobal n) = False
termHasMeta m (TType l) = False
termHasMeta m (TPi n implicit rig dom cod) = termHasMeta m dom || termHasMeta m cod
termHasMeta m (TLam n rig body) = termHasMeta m body
termHasMeta m (TApp f a rig) = termHasMeta m f || termHasMeta m a
termHasMeta m (TCon c args) = anyArgHasMeta m args
termHasMeta m (TCase scrut alts) = termHasMeta m scrut || anyAltHasMeta m alts
termHasMeta m (TInt n) = False
termHasMeta m (TStr s) = False
termHasMeta m (TBool b) = False
termHasMeta m (TIf c th el) = termHasMeta m c || termHasMeta m th || termHasMeta m el

anyArgHasMeta : Int -> List (Pair Term Rig) -> Bool
anyArgHasMeta m [] = False
anyArgHasMeta m ((Pair a rig) :: rest) = termHasMeta m a || anyArgHasMeta m rest

anyAltHasMeta : Int -> List CaseAlt -> Bool
anyAltHasMeta m [] = False
anyAltHasMeta m (alt :: rest) = termHasMeta m (caseAltBody alt) || anyAltHasMeta m rest

-- M34：是否存在**任意**未解 meta（只读，不分配）。rezonkDefs / cleanTerm 用它跳过
-- 「本来就无 TMeta」的定义体，避免对全部定义体重建 Term（分配削减）。
termHasAnyMeta : Term -> Bool
termHasAnyMeta (TMeta k) = True
termHasAnyMeta (TVar n i) = False
termHasAnyMeta (TGlobal n) = False
termHasAnyMeta (TType l) = False
termHasAnyMeta (TPi n implicit rig dom cod) = termHasAnyMeta dom || termHasAnyMeta cod
termHasAnyMeta (TLam n rig body) = termHasAnyMeta body
termHasAnyMeta (TApp f a rig) = termHasAnyMeta f || termHasAnyMeta a
termHasAnyMeta (TCon c args) = anyArgHasAnyMeta args
termHasAnyMeta (TCase scrut alts) = termHasAnyMeta scrut || anyAltHasAnyMeta alts
termHasAnyMeta (TInt n) = False
termHasAnyMeta (TStr s) = False
termHasAnyMeta (TBool b) = False
termHasAnyMeta (TIf c th el) = termHasAnyMeta c || termHasAnyMeta th || termHasAnyMeta el

anyArgHasAnyMeta : List (Pair Term Rig) -> Bool
anyArgHasAnyMeta [] = False
anyArgHasAnyMeta ((Pair a rig) :: rest) = termHasAnyMeta a || anyArgHasAnyMeta rest

anyAltHasAnyMeta : List CaseAlt -> Bool
anyAltHasAnyMeta [] = False
anyAltHasAnyMeta (alt :: rest) = termHasAnyMeta (caseAltBody alt) || anyAltHasAnyMeta rest

-- 洞目标里的类型是 level 形态，show 时深度取快照上下文的长度。
ctxDepthOf : DtGoal -> Int
ctxDepthOf g = length g.dtGoalCtx

findGoal : Int -> List DtGoal -> Maybe DtGoal
findGoal m [] = Nothing
findGoal m (g :: rest) = if g.dtGoalMeta == m then Just g else findGoal m rest

-- M15：面向工具链的洞目标查询（LSP / `vuna goal` 用）。
-- M40：`dtGoalInfoName` 是洞的显示名（`_` = 匿名 → `""`；`?name` → `"?name"`）。
record DtGoalInfo where
  dtGoalInfoSpan : Span
  dtGoalInfoGoal : String
  dtGoalInfoCtx : List (Pair String String)
  dtGoalInfoName : String

goalInfoOf : List (Pair Int Value) -> DtGoal -> DtGoalInfo
goalInfoOf sols g =
  DtGoalInfo g.dtGoalSpan (showValueAt (ctxDepthOf g) (zonkGoal sols g.dtGoalType))
    (ctxEntriesOf g.dtGoalCtx) g.dtGoalName

-- 洞目标里的类型可能仍含已解元变量：用当前解表 force 一遍再 show。
zonkGoal : List (Pair Int Value) -> Value -> Value
zonkGoal sols v = force (Base.HashMap.fromList []) (solsFromList sols) defaultFuel v

-- 上下文条目（名字 + 类型）用于显示：类型项按快照深度用中性环境求值后 show。
ctxEntriesOf : List (Pair String Term) -> List (Pair String String)
ctxEntriesOf items = ctxEntriesAt items 0 (length items)

ctxEntriesAt : List (Pair String Term) -> Int -> Int -> List (Pair String String)
ctxEntriesAt [] idx depth = []
ctxEntriesAt ((Pair name ty) :: rest) idx depth =
  Pair name (showValueAt depth (eval (ctxEnvAt (Pair name ty :: rest) 0 depth) (shift 0 (idx + 1) ty)))
    :: ctxEntriesAt rest (idx + 1) depth

goalsOfProgram : List Decl -> Result (List DtGoalInfo)
goalsOfProgram decls =
  andThen (elabProgramFull decls)
    (\prog => Ok (map (goalInfoOf (dtProgSols prog)) (dtProgGoals prog)))

-- M40：工具查询的**容错**入口：洞未解（此时严格收尾会因 TC_UnsolvedHole 失败）时仍返回
-- 洞目标与上下文快照；用量/终止性校验也跳过（它们不影响洞的显示）。
-- 只给 `vuna goal` / LSP hover 用；check / compile / build 仍走 `elabProgramFull` 的严格收尾。
goalsOfProgramTolerant : List Decl -> Result (List DtGoalInfo)
goalsOfProgramTolerant decls =
  andThen (prepareDecls decls)
    (\ds => andThen (expandDerivings ds) (\ds2 => andThen (elabProgramCoreWithAux ecEmpty preludeGlobals ds2) (\core => Ok (map (goalInfoOf (ecSols core.coreEc)) (ecGoals core.coreEc)))))

elabProgram : List Decl -> Result (Pair (List DtData) (List DtDef))
elabProgram decls =
  andThen (elabProgramFull decls) (\prog => Ok (Pair (dtProgDatas prog) (dtProgDefs prog)))

-- M34.5 接口摘要：从依赖包的缓存 DtProgram 重建精化起始状态（datas / insts / classes /
-- sols / next / globals 表）。`elabProgramGoWith` 用它作为 startEc / startGlobals，
-- 调用方只传本包 decls（依赖包的 body 不再重精化）。
-- 注意：调用方需对 datas/insts/classes 去重（依赖闭包里同一个包会被多个包共享）。
ecOfProgram : DtProgram -> Pair Ec (List (Pair String Term))
ecOfProgram prog =
  let
    ec0 = ecEmpty
    ec1 = addDatasEc ec0 (dtProgDatas prog)
    ec2 = addInstsEc ec1 (dtProgInsts prog)
    ec3 = addClassesEc ec2 (dtProgClasses prog)
    ec4 = ecPutCtorTbl ec3 (ctorTblOfDatas (dtProgDatas prog))
    ec5 = ecPutSols ec4 (dtProgSols prog)
    ec6 = ecPutNext ec5 prog.dtProgNext
    ec7 = ecPutGlobalsTbl ec6 (globalsTableOf (dtProgGlobals prog))
  in Pair ec7 (dtProgGlobals prog)

addDatasEc : Ec -> List DtData -> Ec
addDatasEc ec [] = ec
addDatasEc ec (d :: rest) = addDatasEc (ecAddData ec d) rest

addInstsEc : Ec -> List DtInst -> Ec
addInstsEc ec [] = ec
addInstsEc ec (i :: rest) = addInstsEc (ecAddInst ec i) rest

addClassesEc : Ec -> List DtClass -> Ec
addClassesEc ec [] = ec
addClassesEc ec (c :: rest) = addClassesEc (ecAddClass ec c) rest
