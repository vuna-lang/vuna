module Vuna.Compiler.Elab.Derive where

-- Vuna.Compiler.Elab.Derive：`deriving` 的**实例生成**（M19；M24.7 改为库里的 trait）。
--
-- `deriving (Show, Eq)` 不需要新的精化规则：它等价于一条手写 `instance`，方法体按 data
-- 的构造子骨架机械生成。因此这里把它展开成 `DInstance`，交给既有的实例精化（M15 的
-- 字典编码 + 实例搜索）处理。
--
-- M24.7：trait 声明、方法投影与内建类型实例的权威定义都在 `Base.Show` / `Base.Eq` /
-- `Base.Ord`（编译器不再注入内建 trait/实例）。本模块拿到的 derivings 名字已经由
-- Loader 解析过：包模式经 `Prelude` 重导出得到完整类名（`Base.Show.Show`），单文件里
-- 自己声明的 trait 则保持无前缀（`Show`）。因此：
--   - 实例头用**解析后的完整类名**；
--   - 构造子的分派按类名**最后一段**（`Show` / `Eq` / `Ord`）；
--   - 方法体里对同类方法的递归调用（`show` / `eq` / `lt` / `le`）必须用解析后的
--     **投影全局名**（`Base.Show.show` …）：Loader 的短名放行已删除，裸名再也解析不到。
--
-- 生成规则（与 M19 一致，`test/corpus/traits/0{3,4,5}_*` 覆盖）：
--   Show：`show (C x1 ..) = "(" ++ "C" ++ " " ++ show x1 ++ .. ++ ")"`；零参 ⇒ `"C"`。
--   Eq  ：`eq (C x1 ..) (C y1 ..) = x1 == y1 && ..`；不同构造子 ⇒ `False`。
--   Ord ：先按**声明顺序**比构造子索引，同构造子再逐字段比。
import Base.List
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Elab.Records

-- 类名最后一段：`Base.Show.Show` → `Show`；派生规则按它分派（找不到的类报不支持）。
traitShortName : String -> String
traitShortName tname = secondOf (splitLastDot (splitOnDot tname))

-- 类方法的投影全局名：Loader 把 trait 方法 mangle 成 `<模块前缀>.<方法短名>`
-- （`resolveTraitMethod`）；单文件内联 trait 没有模块前缀时就是短名。
traitMethodGlobal : String -> String -> String
traitMethodGlobal tname methodName = case splitLastDot (splitOnDot tname) of
  Pair rev base => case rev of
    [] => methodName
    _ => "${joinDots rev}.${methodName}"

-- ---------------------------------------------------------------
-- 展开 `deriving (T1, T2)` ⇒ 等价 instance 声明
-- ---------------------------------------------------------------
--
-- 两段式：先收集所有派生实例，再整体**追加到声明列表末尾**。不能就地插到 data 之后
-- ——那条 data 的族信息要等 `elabDatas` 阶段才进 `globals`，插在中间会让实例方法体里
-- 的 `case` 拿不到 scrutinee 的类型。
export expandDerivings : List Decl -> Check (List Decl)
expandDerivings decls =
  Vuna.Compiler.Common.bind (collectDerivings decls) (\insts => OkC (append decls insts))

collectDerivings : List Decl -> Check (List Decl)
collectDerivings [] = OkC []
collectDerivings (d :: rest) = case d of
  DData name params kind ctors derivings viaField repr lin sp =>
    if viaField then collectDerivings rest
    else if length derivings == 0 then collectDerivings rest
    else Vuna.Compiler.Common.bind (derivingsFor name params ctors derivings sp)
      (\insts => Vuna.Compiler.Common.bind (collectDerivings rest) (\more => OkC (append insts more)))
  -- R4（records-v2）：record 不再降级成 DData，派生直接从字段表合成单构造子骨架。
  DRecord name params fields derivings viaField repr lin sp =>
    if viaField then collectDerivings rest
    else if length derivings == 0 then collectDerivings rest
    else Vuna.Compiler.Common.bind (recordDerivingsFor name params fields derivings sp)
      (\insts => Vuna.Compiler.Common.bind (collectDerivings rest) (\more => OkC (append insts more)))
  _ => collectDerivings rest

-- | R4：record 的派生骨架——字段箭头（不含族参数 Pi）+ 返回记录类型；构造子名 = record 名。
recordCtorOf : String -> List String -> List Field -> Span -> Ctor
recordCtorOf dname params fields sp =
  Ctor dname (recordArrowType fields (recordRetType dname params sp) sp) (length fields) sp

-- | R4：record 的 `deriving (...)` 展开成与 data 相同的实例规则（合成单构造子）。
recordDerivingsFor : String -> List String -> List Field -> List String -> Span -> Check (List Decl)
recordDerivingsFor dname params fields derivings sp =
  derivingsFor dname params [recordCtorOf dname params fields sp] derivings sp

derivingsFor : String -> List String -> List Ctor -> List String -> Span -> Check (List Decl)
derivingsFor dname params ctors derivings sp = derivingsForGo dname params ctors derivings sp []

derivingsForGo : String -> List String -> List Ctor -> List String -> Span -> List Decl -> Check (List Decl)
derivingsForGo dname params ctors [] sp acc = OkC (reverse acc)
-- M29-T2b：参数化 data 的派生生成**带 context 的实例**（`Eq a => Eq (Box a)`）。
-- ctx 只包含「在某个构造子字段类型里出现过」的类型参数（顺序 = 声明顺序），
-- 与实例 tele 一一对应；`deriving (Ord)` 的字段比较只用 lt/le，因此只要求 Ord ctx。
derivingsForGo dname params ctors (t :: rest) sp acc =
  Vuna.Compiler.Common.bind (deriveInstance dname params ctors t sp)
    (\decl => derivingsForGo dname params ctors rest sp (decl :: acc))

-- ctx 参数：data 参数里在构造子字段类型中出现过的（保持声明顺序）。
deriveCtxParams : List String -> List Ctor -> List String
deriveCtxParams [] ctors = []
deriveCtxParams (p :: rest) ctors =
  if anyCtorMentions p ctors then Base.List.Cons p (deriveCtxParams rest ctors)
  else deriveCtxParams rest ctors

anyCtorMentions : String -> List Ctor -> Bool
anyCtorMentions p [] = False
anyCtorMentions p ((Ctor cn ty ar cnsp) :: rest) = exprMentionsName p ty || anyCtorMentions p rest

exprMentionsName : String -> Expr -> Bool
exprMentionsName p (EVar n sp) = n == p
exprMentionsName p (EApp fn args sp) = exprMentionsName p fn || anyExprMentions p args
exprMentionsName p (EPi n i _ dom cod sp) = exprMentionsName p dom || exprMentionsName p cod
exprMentionsName p (EAnn v ty sp) = exprMentionsName p v || exprMentionsName p ty
exprMentionsName p _ = False

anyExprMentions : String -> List Expr -> Bool
anyExprMentions p [] = False
anyExprMentions p (e :: rest) = exprMentionsName p e || anyExprMentions p rest

-- 单个类的实例声明。`tn` 是 Loader 解析后的完整类名；方法名（`show` / `eq` / ...）由
-- `elabInstance` 按类方法的最后一段匹配，因此实例里仍写短名。
-- M29-T2b：参数化 data 生成带 ctx 的 DInstance（ctx 顺序 = 声明顺序，见 deriveCtxParams）。
deriveInstance : String -> List String -> List Ctor -> String -> Span -> Check Decl
deriveInstance dname params ctors tn sp =
  let
    hd = instHead tn dname params sp
    used = deriveCtxParams params ctors
    ctxExprs = map (\p => EApp (EVar tn sp) [EVar p sp] sp) used
  in case traitShortName tn of
    "Show" =>
      let
        proj = traitMethodGlobal tn "show"
        ms = [DFun "show" [PVar "sx" sp] (showBody proj ctors "sx" sp) sp]
      in OkC (DInstance ctxExprs hd ms sp)
    "Eq" =>
      let
        eqProj = traitMethodGlobal tn "eq"
        ms =
          [ DFun "eq" [PVar "sx" sp, PVar "sy" sp] (eqBody ctors sp) sp,
            DFun "neq" [PVar "sx" sp, PVar "sy" sp] (neqBody eqProj sp) sp
          ]
      in OkC (DInstance ctxExprs hd ms sp)
    "Ord" =>
      let
        ltProj = traitMethodGlobal tn "lt"
        leProj = traitMethodGlobal tn "le"
        ms =
          [ DFun "lt" [PVar "sx" sp, PVar "sy" sp] (ordBody leProj ctors sp) sp,
            DFun "le" [PVar "sx" sp, PVar "sy" sp] (leBody ltProj sp) sp,
            DFun "gt" [PVar "sx" sp, PVar "sy" sp] (gtBody ltProj sp) sp,
            DFun "ge" [PVar "sx" sp, PVar "sy" sp] (geBody leProj sp) sp
          ]
      in OkC (DInstance ctxExprs hd ms sp)
    "Hashable" =>
      let
        hashProj = traitMethodGlobal tn "hash"
        combineProj = traitMethodGlobal tn "hashCombine"
        ms = [DFun "hash" [PVar "sx" sp] (hashBody hashProj combineProj ctors sp) sp]
      in OkC (DInstance ctxExprs hd ms sp)
    "FromString" => deriveWrapper tn "fromString" "String" ctors hd sp
    "FromInt" => deriveWrapper tn "fromInt" "Int" ctors hd sp
    "FromFloat" => deriveWrapper tn "fromFloat" "Float" ctors hd sp
    kind => tcErr1 sp (DeriveUnsupportedKind kind) kind

-- 字面量转换派生（FromString / FromInt / FromFloat）：只接受「一个构造子、一个字段、
-- 字段声明类型就是对应内建类型」的包装类型。记录在 prepareDecls 已降级成单构造子
-- DData，因此这里同时接受手写 data 的箭头链（`EApp (EVar "->")`）与记录降级的 `EPi` 链。
-- 生成 `instance C T where fromX sx = C sx`：不递归调用 trait，因此没有自引用/终止性风险；
-- 跨类型转换（如字段是 Email 而不是 String）需要手写 instance。
-- | 字面量转换派生（`FromString`/`FromInt`/`FromFloat`）：要求「单构造子、单字段、
-- 字段类型就是目标内建类型」，生成 `instance C T where fromX sx = C sx`。
deriveWrapper : String -> String -> String -> List Ctor -> Expr -> Span -> Check Decl
deriveWrapper tn methodName wantTy [] hd sp =
  tcErr1 sp (DeriveSingleCtor (traitShortName tn)) (traitShortName tn)
deriveWrapper tn methodName wantTy (c :: rest) hd sp = case rest of
  [] => deriveWrapperCtor tn methodName wantTy c hd sp
  _ => tcErr1 sp (DeriveSingleCtor (traitShortName tn)) (traitShortName tn)

-- | `deriveWrapper` 的单构造子分支：校验构造子 arity 为 1、字段类型等于目标类型名，
-- 然后生成转发到构造子的实例方法。
deriveWrapperCtor : String -> String -> String -> Ctor -> Expr -> Span -> Check Decl
deriveWrapperCtor tn methodName wantTy (Ctor cn ty ar cnsp) hd sp = if ar == 1 then case deriveFieldTypes ty of
  dom :: rest => case rest of
    [] =>
      if deriveFieldTypeName dom == wantTy then OkC
        (DInstance [] hd [DFun methodName [PVar "sx" sp] (EApp (EVar cn sp) [EVar "sx" sp] sp) sp] sp)
      else tcErr3 sp (DeriveFieldType (traitShortName tn) wantTy (deriveFieldTypeName dom))
        (traitShortName tn) wantTy (deriveFieldTypeName dom)
    _ => tcErr1 sp (DeriveCtorFieldCount (traitShortName tn)) (traitShortName tn)
  [] => tcErr1 sp (DeriveCtorFieldCount (traitShortName tn)) (traitShortName tn)
else tcErr1 sp (DeriveCtorFieldCount (traitShortName tn)) (traitShortName tn)

-- | 把箭头链（`EApp (EVar "->")` 或 `EPi`）拆成字段类型列表：依次取出域类型。
deriveFieldTypes : Expr -> List Expr
deriveFieldTypes (EApp (EVar "->" _) ([dom, cod]) _) = Base.List.Cons dom (deriveFieldTypes cod)
deriveFieldTypes (EPi _ _ _ dom cod _) = dom :: deriveFieldTypes cod
deriveFieldTypes _ = []

-- | 取表达式形态的类型名（`EVar` 或 `EApp` 的头部名），其它形态返回 `"?"`。
deriveFieldTypeName : Expr -> String
deriveFieldTypeName (EVar n sp) = n
deriveFieldTypeName (EApp (EVar n sp) args sp2) = n
deriveFieldTypeName _ = "?"

-- `T <Data> a1 .. an` 形态的实例头（`T` 是解析后的完整类名）。
export instHead : String -> String -> List String -> Span -> Expr
instHead tn dname params sp = EApp (EVar tn sp) [applyTypeParams (EVar dname sp) params sp] sp

-- `Box` 应用到 data 参数上：`Box a b`（单参数 trait 的实例头实参是一个**类型**）。
applyTypeParams : Expr -> List String -> Span -> Expr
applyTypeParams head [] sp = head
applyTypeParams head ps sp = EApp head (map (\p => EVar p sp) ps) sp

-- ---------------------------------------------------------------
-- Show
-- ---------------------------------------------------------------
showBody : String -> List Ctor -> String -> Span -> Expr
showBody proj ctors scrut sp = ECase (EVar scrut sp) (showAlts proj ctors sp) sp

showAlts : String -> List Ctor -> Span -> List (Pair Pat Expr)
showAlts proj [] sp = []
showAlts proj ((Ctor cn ty ar cnsp) :: rest) sp =
  let
    vs = varNames "fa" ar
    pat = PCon cn (map (\v => PVar v sp) vs) sp
  in Pair pat (showCtor proj cn vs sp) :: showAlts proj rest sp

-- 零参 ⇒ `"C"`；否则 `"(C " ++ show f0 ++ " " ++ .. ++ ")"`。
-- | 自动补注（M41 新增导出）：showCtor。
showCtor : String -> String -> List String -> Span -> Expr
showCtor proj cn [] sp = EStr (ctorShortName cn) sp
showCtor proj cn vs sp =
  EApp (EVar "++" sp) [EStr "(${ctorShortName cn} " sp, showFields proj vs sp] sp

showFields : String -> List String -> Span -> Expr
showFields proj [] sp = EStr ")" sp
showFields proj (v :: rest) sp = case rest of
  [] => EApp (EVar "++" sp) [showOne proj v sp, EStr ")" sp] sp
  _ =>
    EApp (EVar "++" sp)
      [showOne proj v sp, EApp (EVar "++" sp) [EStr " " sp, showFields proj rest sp] sp] sp

showOne : String -> String -> Span -> Expr
showOne proj v sp = EApp (EVar proj sp) [EVar v sp] sp

-- ---------------------------------------------------------------
-- Hashable
-- ---------------------------------------------------------------
-- 每个构造子一个分支：`hash (C f0 .. fn) = hashCombine ctorIndex (hashCombine (hash f0) ..)`；
-- 零字段 = 构造子下标。`hashCombine` 由 `Base.Hashable` 导出（完全限定）。
-- | `deriving (Hashable)` 的方法体：对 `sx` 按构造子分派。
hashBody : String -> String -> List Ctor -> Span -> Expr
hashBody proj combineProj ctors sp = ECase (EVar "sx" sp) (hashAlts proj combineProj ctors 0 sp) sp

-- | 每个构造子一个 `hash` 分支（构造子下标 + 字段 hash 的 `hashCombine` 链）。
hashAlts : String -> String -> List Ctor -> Int -> Span -> List (Pair Pat Expr)
hashAlts proj combineProj [] i sp = []
hashAlts proj combineProj ((Ctor cn ty ar cnsp) :: rest) i sp =
  let
    vs = varNames "fa" ar
    pat = PCon cn (map (\v => PVar v sp) vs) sp
    body = hashFields proj combineProj vs (EInt i sp) sp
  in Pair pat body :: hashAlts proj combineProj rest (i + 1) sp

-- | 逐字段把 `hash field` 折进累加器（用完全限定的 `Base.Hashable.hashCombine`）。
hashFields : String -> String -> List String -> Expr -> Span -> Expr
hashFields proj combineProj [] acc sp = acc
hashFields proj combineProj (v :: rest) acc sp =
  hashFields proj combineProj rest
    (EApp (EVar combineProj sp) [acc, EApp (EVar proj sp) [EVar v sp] sp] sp) sp

-- ---------------------------------------------------------------
-- Eq
-- ---------------------------------------------------------------
-- `case sx of C f.. => case sy of C g.. => f0 == g0 && .. | _ => False`
eqBody : List Ctor -> Span -> Expr
eqBody ctors sp = ECase (EVar "sx" sp) (map (\c => eqAlt c sp) ctors) sp

eqAlt : Ctor -> Span -> Pair Pat Expr
eqAlt (Ctor cn ty ar cnsp) sp =
  let
    vs = varNames "fa" ar
    pat = PCon cn (map (\v => PVar v sp) vs) sp
    body = ECase (EVar "sy" sp) (eqInner cn ar sp) sp
  in Pair pat body

eqInner : String -> Int -> Span -> List (Pair Pat Expr)
eqInner cn ar sp =
  [ Pair (PCon cn (map (\v => PVar v sp) (varNames "fb" ar)) sp) (conjFields (varNames "fa" ar) (varNames "fb" ar) sp),
    Pair (PWild sp) (boolFalse sp)
  ]

-- `f0 == g0 && f1 == g1 && ..`；无字段 ⇒ `True`。
conjFields : List String -> List String -> Span -> Expr
conjFields [] gs sp = boolTrue sp
conjFields (f :: fs) (g :: gs) sp = case fs of
  [] => EApp (EVar "==" sp) [EVar f sp, EVar g sp] sp
  _ => EApp (EVar "&&" sp) [EApp (EVar "==" sp) [EVar f sp, EVar g sp] sp, conjFields fs gs sp] sp
conjFields fs gs sp = boolFalse sp

-- `neq sx sy = if eq sx sy then False else True`（`eq` 用解析后的投影名）。
neqBody : String -> Span -> Expr
neqBody eqProj sp =
  EIf (EApp (EVar eqProj sp) [EVar "sx" sp, EVar "sy" sp] sp) (boolFalse sp) (boolTrue sp) sp

-- ---------------------------------------------------------------
-- Ord（构造子按声明顺序为序，同构造子逐字段比）
-- ---------------------------------------------------------------
ordBody : String -> List Ctor -> Span -> Expr
ordBody leProj ctors sp = ECase (EVar "sx" sp) (ordAlts leProj ctors ctors 0 sp) sp

ordAlts : String -> List Ctor -> List Ctor -> Int -> Span -> List (Pair Pat Expr)
ordAlts leProj all [] i sp = []
ordAlts leProj all ((Ctor cn ty ar cnsp) :: rest) i sp =
  let
    vs = varNames "fa" ar
    pat = PCon cn (map (\v => PVar v sp) vs) sp
    body = ECase (EVar "sy" sp) (ordInner leProj i ar all sp) sp
  in Pair pat body :: ordAlts leProj all rest (i + 1) sp

-- 对 `sy` 再分派：索引更小的构造子 ⇒ False，同构造子 ⇒ 逐字段 lt，更大 ⇒ True。
ordInner : String -> Int -> Int -> List Ctor -> Span -> List (Pair Pat Expr)
ordInner leProj i ar all sp = ordInnerGo leProj i ar all 0 sp

ordInnerGo : String -> Int -> Int -> List Ctor -> Int -> Span -> List (Pair Pat Expr)
ordInnerGo leProj i ar [] j sp = []
ordInnerGo leProj i ar ((Ctor cn ty car cnsp) :: rest) j sp =
  let
    gs = varNames "fb" car
    pat = PCon cn (map (\v => PVar v sp) gs) sp
    body =
      if j == i then ltFields leProj (varNames "fa" ar) gs sp
      else if j < i then boolFalse sp else boolTrue sp
  in Pair pat body :: ordInnerGo leProj i ar rest (j + 1) sp

-- 逐字段 `<`：`f0 < g0 || (le f0 g0 && le g0 f0 && (f1 < g1 || ..))`；无字段 ⇒ False。
-- M29-T2b：只用 Ord 的 lt/le（不再用 `==`），因此 `deriving (Ord)` 只需 Ord ctx。
ltFields : String -> List String -> List String -> Span -> Expr
ltFields leProj [] gs sp = boolFalse sp
ltFields leProj (f :: fs) (g :: gs) sp = case fs of
  [] => EApp (EVar "<" sp) [EVar f sp, EVar g sp] sp
  _ =>
    EApp (EVar "||" sp)
      [EApp (EVar "<" sp) [EVar f sp, EVar g sp] sp, EApp (EVar "&&" sp) [EApp (EVar leProj sp) [EVar f sp, EVar g sp] sp, EApp (EVar "&&" sp) [EApp (EVar leProj sp) [EVar g sp, EVar f sp] sp, ltFields leProj fs gs sp] sp] sp]
      sp
-- M23：字段数不匹配的组合走不到（derive 生成的字段表按构造子对齐），但 DT 要求模式矩阵穷尽。
ltFields leProj _ _ sp = boolFalse sp

-- `le sx sy = lt sx sy || !(lt sy sx)`——只用 `lt` 派生，不依赖 `Eq` 实例
-- （`deriving (Ord)` 不要求同时 derive `Eq`）。`lt` 用解析后的投影名。
leBody : String -> Span -> Expr
leBody ltProj sp =
  EApp (EVar "||" sp)
    [EApp (EVar ltProj sp) [EVar "sx" sp, EVar "sy" sp] sp, EIf (EApp (EVar ltProj sp) [EVar "sy" sp, EVar "sx" sp] sp) (boolFalse sp) (boolTrue sp) sp]
    sp

varNames : String -> Int -> List String
varNames prefix n = varNamesAt prefix 0 n

varNamesAt : String -> Int -> Int -> List String
varNamesAt prefix i n = varNamesAtGo (n - i) prefix n

varNamesAtGo : Int -> String -> Int -> List String
varNamesAtGo remaining prefix n =
  if remaining <= 0 then []
  else Base.List.Cons (prefix ++ strFromInt (n - remaining)) (varNamesAtGo (remaining - 1) prefix n)

-- `gt sx sy = lt sy sx`；`ge sx sy = le sy sx`（都用已生成的 `lt` / `le`）。
gtBody : String -> Span -> Expr
gtBody ltProj sp = EApp (EVar ltProj sp) [EVar "sy" sp, EVar "sx" sp] sp

geBody : String -> Span -> Expr
geBody leProj sp = EApp (EVar leProj sp) [EVar "sy" sp, EVar "sx" sp] sp

-- ---------------------------------------------------------------
-- 派生体里产生 Bool 的辅助
-- ---------------------------------------------------------------
-- 派生方法体不再引用源码里的 `True` / `False`（M22.2 已去掉 prelude 的值桩，
-- 权威定义在 `Base.Bool`，而派生实例可能出现在不 import Base.Bool 的程序里）。
-- 用 Int 上的 `==`（精化期特化成 `bi_eq_int`）产生 Bool：`1 == 1` / `0 == 1`。
-- 这样派生 Eq/Ord 与源码是否声明 Bool 构造子无关。
boolTrue : Span -> Expr
boolTrue sp = EApp (EVar "==" sp) [EInt 1 sp, EInt 1 sp] sp

boolFalse : Span -> Expr
boolFalse sp = EApp (EVar "==" sp) [EInt 0 sp, EInt 1 sp] sp
