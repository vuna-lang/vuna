module Vuna.Compiler.Elab.Usage
  ( checkDefUsage
  , checkProgramUsage
  , isTypeForming
  , warnAt0
  , warnAt0Mod
  , warnAt1
  , warnAt1Mod
  ) where

-- Vuna.Compiler.Elab.Usage：M38 QTT 用量检查。
--
-- 精化完成后、组装 `DtProgram` 之前，对每个**运行时** `DtDef` 的 body 做一次结构遍历：
-- 每个 binder 的运行时使用次数必须满足它声明的 Rig（0 恰好 0、1 恰好 1、ω 不限）。
-- 类型位置（`TPi`）与擦除实参（Rig0 的 TApp/TCon 实参）不产生运行时用量；case 分支的
-- 外层用量按 join 合并（线性值必须在每条路径上都被消费）。
--
-- Usage 是「与当前 context 对齐的用量向量」：index 0 = 最内层 binder。进入 λ / case
-- 分支时向量头部就是新 binder；退出时检查并 drop。这样 de Bruijn 搬运由结构遍历本身完成。
--
-- 类型级定义的 body 是类型，不参与用量检查（由 `isTypeForming` 判定）。
import Base.List
import Vuna.Compiler.Common
import Vuna.Compiler.Core
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Diagnostics.Warning

-- 类型级定义的判据：定义**类型** force 后以宇宙收尾（`Type` 或 `... -> Type` 的 Pi 链）。
-- M38 从 Codegen/Erase 上移到 Elab，成为用量检查与 codegen 分区的共同真源。
isTypeForming : Value -> Bool
isTypeForming v = isTypeFormingFuel 128 v

isTypeFormingFuel : Int -> Value -> Bool
isTypeFormingFuel fuel v = if fuel <= 0 then False
else case v of
  VType l => True
  VPi name implicit rig dom clo =>
    isTypeFormingFuel (fuel - 1) (applyClosure clo (VNeutral (NVar name 0 [])))
  _ => False

-- ---------------------------------------------------------------
-- 用量向量
-- ---------------------------------------------------------------
-- 与 context 等长；index 0 是最内层 binder。`Rig0` 表示该 binder 未被使用。
uZeroOf : Int -> List Rig
uZeroOf n = if n <= 0 then [] else Base.List.Cons Rig0 (uZeroOf (n - 1))

uVarAt : Int -> Int -> List Rig
uVarAt depth i = if i < 0 || i >= depth then uZeroOf depth else uVarAtGo depth i

uVarAtGo : Int -> Int -> List Rig
uVarAtGo n i =
  if n <= 0 then [] else Base.List.Cons (if i == 0 then Rig1 else Rig0) (uVarAtGo (n - 1) (i - 1))

uAdd : List Rig -> List Rig -> List Rig
uAdd [] ys = ys
uAdd xs [] = xs
uAdd (x :: xs) (y :: ys) = rigAdd x y :: uAdd xs ys

uScale : Rig -> List Rig -> List Rig
uScale rig us = map (\u => rigScale rig u) us

uJoin : List Rig -> List Rig -> List Rig
uJoin [] ys = ys
uJoin xs [] = xs
uJoin (x :: xs) (y :: ys) = rigJoin x y :: uJoin xs ys

uDrop : Int -> List Rig -> List Rig
uDrop n us = if n <= 0 then us
else case us of
  [] => []
  _ :: rest => uDrop (n - 1) rest

-- 声明与实测是否相符；不符时给 TC 诊断。返回的 Int 只是占位（错误已短路）。
-- `ec` 是当前显式状态：使用点登记在 `Ec.ecUseSpans` 上，诊断在此就地取。
checkBinderRig : Ec -> Span -> String -> Rig -> Rig -> Check Int
checkBinderRig ec sp name Rig0 used =
  if isRigZero used then OkC 0
  else onErrDiag (\d => withUseFields ec name (withField (FieldQuantity name 0 1) d))
    (tcErr1 sp (ErasedBinderUsed name) name)
checkBinderRig ec sp name Rig1 used = case used of
  Rig0 =>
    onErrDiag (\d => withUseFields ec name (withField (FieldQuantity name 1 0) d))
      (tcErr1 sp (LinearUnused name) name)
  Rig1 => OkC 0
  RigOmega =>
    onErrDiag (\d => withUseFields ec name (withField (FieldQuantity name 1 2) d))
      (tcErr1 sp (LinearOverused name) name)
checkBinderRig ec sp name RigOmega used = OkC 0

-- 进入一个 binder：body usage 的头部就是它；检查后 drop（返回更新后的 Ec）。
checkLamBinder : Ec -> Span -> String -> Rig -> List Rig -> Check (Pair (List Rig) Ec)
checkLamBinder ec sp name rig [] = icInternal "usage vector lost lambda binder"
checkLamBinder ec sp name rig (used :: rest) =
  let
    ec1 = if isRigZero used && not (startsWith "_" name) then case rig of
      RigOmega => warnUnusedBinder ec sp name
      _ => ec
    else ec
  in Vuna.Compiler.Common.bind (checkBinderRig ec1 sp name rig used) (\_ => OkC (Pair rest ec1))

-- 外层 env 里是否有同名、且**参与运行时**的 binder 吗（UN_ShadowedBinder 的比较对象）。
--
-- Rig0 的 binder 是擦除的：隐式类型/索引 binder（`f : a -> a` 的 `a`、实例方法签名里
-- 自动量化的 `a`/`b`/`c`、`{n : Nat}`）由精化器在体前插成 `TLam Rig0`，源码里没有可供
-- 用户引用的「外层 binder」。它们与体内同名参数相撞属于正常写法（`f a = a`、`Applicative`
-- 实例的 `ap`/`liftA2`），不算遮蔽；只有两个运行时 binder 重名才告警。
shadowedByRuntime : String -> List (Pair String Rig) -> Bool
shadowedByRuntime name [] = False
shadowedByRuntime name ((Pair n rig) :: rest) =
  if isRigZero rig then shadowedByRuntime name rest else n == name || shadowedByRuntime name rest

-- case 分支：binders 是 telescope 顺序（第一个字段最外），body usage 的前 k 项按
-- 逆序对应它们（index 0 = 最后一个字段）。检查完整体 drop。
checkAltBinders : Ec -> Span -> List (Pair String Rig) -> List Rig -> Check (Pair (List Rig) Ec)
checkAltBinders ec sp binders us = checkAltBindersGo ec sp (reverse binders) us

checkAltBindersGo : Ec -> Span -> List (Pair String Rig) -> List Rig -> Check (Pair (List Rig) Ec)
checkAltBindersGo ec sp [] us = OkC (Pair us ec)
checkAltBindersGo ec sp ((Pair name rig) :: rest) us = case us of
  [] => icInternal "usage vector lost case binder"
  used :: more =>
    let
      ec1 =
        if name /= "_" && shadowedByRuntime name rest then warnAt1 ec sp (ShadowedBinder name) name
        else ec
      ec2 = if isRigZero used && not (startsWith "_" name) then case rig of
        RigOmega => warnUnusedBinder ec1 sp name
        _ => ec1
      else ec1
    in Vuna.Compiler.Common.bind (checkBinderRig ec2 sp name rig used)
      (\_ => checkAltBindersGo ec2 sp rest more)

-- ---------------------------------------------------------------
-- 项遍历（显式线程 `Ec`：使用点登记进 `ecUseSpans`，诊断就地取用）
-- ---------------------------------------------------------------
checkTerm : Ec -> Span -> List (Pair String Rig) -> Term -> Check (Pair (List Rig) Ec)
checkTerm ec sp env t = case t of
  TVar name i usp =>
    let
      ec2 = if usp.spanStartLine == 0 then ec else recordUseSpan ec name usp
    in OkC (Pair (uVarAt (natToInt (length env)) i) ec2)
  TMeta m => OkC (Pair (uZeroOf (natToInt (length env))) ec)
  TGlobal g => OkC (Pair (uZeroOf (natToInt (length env))) ec)
  TType l => OkC (Pair (uZeroOf (natToInt (length env))) ec)
  -- 类型：0-fragment，里面的 binder 不产生运行时用量。
  TPi name implicit rig dom cod => OkC (Pair (uZeroOf (natToInt (length env))) ec)
  TLam name rig body =>
    let
      ecW =
        if name /= "_" && shadowedByRuntime name env then warnAt1 ec sp (ShadowedBinder name) name
        else ec
      env2 = Base.List.Cons (Pair name rig) env
    in Vuna.Compiler.Common.step (checkTerm ecW sp env2 body)
      (\u => \ec2 => Vuna.Compiler.Common.step (checkLamBinder ec2 sp name rig u) (\rest => \ec3 => OkC (Pair rest ec3)))
  TApp f a rig =>
    Vuna.Compiler.Common.step (checkTerm ec sp env f)
      (\uf => \ec1 => if isRigZero rig then OkC (Pair uf ec1) else Vuna.Compiler.Common.step (checkTerm ec1 sp env a) (\ua => \ec2 => OkC (Pair (uAdd uf (uScale rig ua)) ec2)))
  TCon c args => checkArgs ec sp env args
  TMk c args => checkArgs ec sp env args
  TRecord c args => checkArgs ec sp env args
  TProj base c tele i fi => checkTerm ec sp env base
  TRecUpd base c tele idxs body =>
    Vuna.Compiler.Common.step (checkTerm ec sp env base)
      (\ub => \ec1 => Vuna.Compiler.Common.step (checkTerm ec1 sp (append (reverse tele) env) body) (\ua => \ec2 => OkC (Pair (uAdd ub ua) ec2)))
  TCase scrut alts =>
    Vuna.Compiler.Common.step (checkTerm ec sp env scrut)
      (\us => \ec1 => Vuna.Compiler.Common.step (checkAlts ec1 sp env alts) (\ua => \ec2 => OkC (Pair (uAdd us ua) ec2)))
  TIf c th el =>
    Vuna.Compiler.Common.step (checkTerm ec sp env c)
      (\uc => \ec1 => Vuna.Compiler.Common.step (checkTerm ec1 sp env th) (\ut => \ec2 => Vuna.Compiler.Common.step (checkTerm ec2 sp env el) (\ue => \ec3 => OkC (Pair (uAdd uc (uJoin ut ue)) ec3))))
  TInt n => OkC (Pair (uZeroOf (natToInt (length env))) ec)
  TStr s => OkC (Pair (uZeroOf (natToInt (length env))) ec)
  TFloat raw => OkC (Pair (uZeroOf (natToInt (length env))) ec)
  TBool b => OkC (Pair (uZeroOf (natToInt (length env))) ec)

checkArgs : Ec -> Span -> List (Pair String Rig) -> List (Pair Term Rig) -> Check (Pair (List Rig) Ec)
checkArgs ec sp env args = checkArgsGo ec sp env args (uZeroOf (natToInt (length env)))

checkArgsGo : Ec -> Span -> List (Pair String Rig) -> List (Pair Term Rig) -> List Rig -> Check (Pair (List Rig) Ec)
checkArgsGo ec sp env [] acc = OkC (Pair acc ec)
checkArgsGo ec sp env ((Pair arg rig) :: rest) acc =
  if isRigZero rig then checkArgsGo ec sp env rest acc
  else Vuna.Compiler.Common.step (checkTerm ec sp env arg)
    (\ua => \ec1 => checkArgsGo ec1 sp env rest (uAdd acc (uScale rig ua)))

checkAlts : Ec -> Span -> List (Pair String Rig) -> List CaseAlt -> Check (Pair (List Rig) Ec)
checkAlts ec sp env alts = checkAltsGo ec sp env alts Nothing

checkAltsGo : Ec -> Span -> List (Pair String Rig) -> List CaseAlt -> Maybe (List Rig) -> Check (Pair (List Rig) Ec)
checkAltsGo ec sp env [] acc = OkC (Pair (case acc of
  Just u => u
  Nothing => uZeroOf (natToInt (length env))
) ec
)
checkAltsGo ec sp env ((CaseAlt cname binders body) :: rest) acc =
  let
    env2 = append (reverse binders) env
    k = natToInt (length binders)
  in Vuna.Compiler.Common.step (checkTerm ec sp env2 body) (\u => \ec1 => Vuna.Compiler.Common.step (checkAltBinders ec1 sp binders u) (\outer => \ec2 => checkAltsGo ec2 sp env rest (Just (case acc of
    Just prev => uJoin prev outer
    Nothing => outer
  )
  )
  )
  )

-- `Rig` 没有 Eq 实例；这里用显式模式匹配判断「0 实参」。
isRigZero : Rig -> Bool
isRigZero Rig0 = True
isRigZero _ = False

-- 顶层入口：body 是闭项；遍历后应无残留用量（有残留说明存在未绑定变量，作用域护栏会
-- 在 codegen 侧再查；这里只保证不静默）。进入前清空使用点登记（每个定义体一份）。
checkDefUsage : Ec -> Maybe Span -> String -> Term -> Check Ec
checkDefUsage ec msp name body =
  let
    sp = case msp of
      Just s => s
      Nothing => Span "" 0 0 0 0
    ec0 = resetUseSpans ec
  in Vuna.Compiler.Common.step (checkTerm ec0 sp [] body) (\_rest => \ec1 => OkC ec1)

-- ---------------------------------------------------------------
-- W7：线性捕获的「立即消费」规则
-- ---------------------------------------------------------------
-- 精化期给「捕获线性值的 λ」打了 binder 名标记（`Meta.linClosureName`），因为
-- λ 捕获线性值后，闭包一旦被复制就会复制线性值。这里按**位置**判断标记 λ 是否
-- 被立即按 quantity 1 消费：
--   * 函数位置（`(λ..) a`，β 立即发生）：闭包用一次；
--   * 应用实参 / 构造子字段且该位置 multiplicity 是 1：调用方或被构造的线性数据
--     承诺恰好用一次（`Cont` 的 `(1 k : a -> b)` 字段就是这个形态）；
--   * 构造子字段还要求族本身是 `linear data`：否则族值可被复制，字段的一次性
--     承诺会被绕开。
-- 其余位置（定义体返回值、rig-ω 实参/字段、`if`/`case` 的普通位置）一律拒绝。
-- 这是保守但可靠的近似：完整的多重性多态/依赖 multiplicity 未做（qtt.md §9）。
capCheck : Ec -> Span -> Term -> Bool -> Check Int
capCheck ec sp t allowed = capCheckFuel (capCheckFuelFor t) ec sp t allowed

-- | capture check 的 fuel 派生（D24）：固定 2048 对含深 Nat 链/大项的体不够（字面量
-- 展开成链后逐节点遍历）。按项节点数放大（每节点最多几步递归），上限 `capCheckFuelMax`
-- 防失控输入。
capCheckFuelFor : Term -> Int
capCheckFuelFor t =
  let
    scaled = 1024 + 4 * termSize t
  in if scaled > capCheckFuelMax then capCheckFuelMax else scaled

capCheckFuelMax : Int
capCheckFuelMax = 1000000

capCheckFuel : Int -> Ec -> Span -> Term -> Bool -> Check Int
capCheckFuel fuel ec sp t allowed = if fuel <= 0 then icInternal "capture check fuel exhausted"
else case t of
  TVar name i _ => OkC 0
  TGlobal g => OkC 0
  TInt n => OkC 0
  TStr s => OkC 0
  TFloat raw => OkC 0
  TBool b => OkC 0
  TMeta m => OkC 0
  TType l => OkC 0
  -- 类型层项不产生运行时闭包（λ 只在值层出现）。
  TPi name implicit rig dom cod => OkC 0
  TLam name rig body =>
    if isLinClosureName name then if allowed then capCheckFuel (fuel - 1) ec sp body False
    else tcErr1 sp (LinearCaptureEscapes (linClosureOrigName name)) (linClosureOrigName name)
    else capCheckFuel (fuel - 1) ec sp body False
  TApp f a rig =>
    Vuna.Compiler.Common.bind (capCheckFuel (fuel - 1) ec sp f True)
      (\_ => if isRigZero rig then capCheckFuel (fuel - 1) ec sp a False else capCheckFuel (fuel - 1) ec sp a (rigIsLinear rig))
  TCon c args => capArgsFuel fuel ec sp c args
  TMk c args => capArgsFuel fuel ec sp c args
  TRecord c args => capArgsFuel fuel ec sp c args
  TIf c th el =>
    Vuna.Compiler.Common.bind (capCheckFuel (fuel - 1) ec sp c True)
      (\_ => Vuna.Compiler.Common.bind (capCheckFuel (fuel - 1) ec sp th allowed) (\_ => capCheckFuel (fuel - 1) ec sp el allowed))
  TProj base c tele i fi => capCheckFuel (fuel - 1) ec sp base True
  TRecUpd base c tele idxs body =>
    Vuna.Compiler.Common.bind (capCheckFuel (fuel - 1) ec sp base True)
      (\_ => capCheckFuel (fuel - 1) ec sp body allowed)
  TCase scrut alts =>
    Vuna.Compiler.Common.bind (capCheckFuel (fuel - 1) ec sp scrut True)
      (\_ => capAltsFuel fuel ec sp allowed alts)

capArgsFuel : Int -> Ec -> Span -> String -> List (Pair Term Rig) -> Check Int
capArgsFuel fuel ec sp c args = capArgsGo fuel ec sp (ctorFamilyLinear ec c) args

capArgsGo : Int -> Ec -> Span -> Bool -> List (Pair Term Rig) -> Check Int
capArgsGo fuel ec sp famLin [] = OkC 0
capArgsGo fuel ec sp famLin ((Pair arg rig) :: rest) =
  let
    allowed = famLin && rigIsLinear rig
  in Vuna.Compiler.Common.bind (capCheckFuel (fuel - 1) ec sp arg allowed)
    (\_ => capArgsGo (fuel - 1) ec sp famLin rest)

capAltsFuel : Int -> Ec -> Span -> Bool -> List CaseAlt -> Check Int
capAltsFuel fuel ec sp allowed [] = OkC 0
capAltsFuel fuel ec sp allowed ((CaseAlt cname binders body) :: rest) =
  Vuna.Compiler.Common.bind (capCheckFuel (fuel - 1) ec sp body allowed)
    (\_ => capAltsFuel (fuel - 1) ec sp allowed rest)

-- 构造子所属族是不是 `linear data`（决定 rig-1 字段的一次性承诺是否可靠）。
ctorFamilyLinear : Ec -> String -> Bool
ctorFamilyLinear ec c = case dtCtorLookupEc ec c of
  Just ctor => case dtDataLookup (dtCtorFamily ctor) (ecDatas ec) of
    Just d => dtDataLinear d
    Nothing => False
  Nothing => False

-- 顶层入口：定义体是闭项；根位置按「不受限使用」检查（返回值可能被调用方复制）。
checkDefCapture : Ec -> DtDef -> Term -> Check Int
checkDefCapture ec d body = capCheck ec (defSpanOf d) body False

isTypeLevelDef : Ec -> DtDef -> Bool
isTypeLevelDef ec d =
  isTypeForming (force (ecDefTbl ec) (ecSolsP ec) defaultFuel (eval [] (dtDefType d)))

-- 程序级入口：只检查有体的运行时定义（类型级定义跳过）。使用点状态在 Ec 上线程，
-- 返回收尾后的 Ec（调用方把它接回主状态）。
checkProgramUsage : Ec -> List DtDef -> Check Ec
checkProgramUsage ec defs = checkProgramUsageGo ec defs

checkProgramUsageGo : Ec -> List DtDef -> Check Ec
checkProgramUsageGo ec [] = OkC ec
checkProgramUsageGo ec (d :: rest) = if isTypeLevelDef ec d then checkProgramUsageGo ec rest
else if isLinearType ec (eval [] (dtDefType d)) then tcErr1 (defSpanOf d) (LinearTopLevel (dtDefName d)) (dtDefName d)
else case dtDefBody d of
  Nothing => checkProgramUsageGo ec rest
  Just body =>
    Vuna.Compiler.Common.bind (checkDefCapture ec d body)
      (\_ => Vuna.Compiler.Common.bind (checkDefUsage ec (dtDefSpan d) (dtDefName d) body) (\ec2 => checkProgramUsageGo ec2 rest))

defSpanOf : DtDef -> Span
defSpanOf d = case dtDefSpan d of
  Just sp => sp
  Nothing => Span "" 0 0 0 0

-- 未使用 binder → `_<name>` 的 machine-applicable 改名建议（无引用，改名安全）。
-- | 未使用 binder 告警（附改名建议）。
warnUnusedBinder : Ec -> Span -> String -> Ec
warnUnusedBinder ec sp name =
  warnAt1Mod ec
    (\d => withSuggestion (Suggestion "rename unused binder `${name}` to `_${name}`" MachineApplicable [DiagEdit sp "_${name}"]) d)
    sp (UnusedBinder name) name

-- ---------------------------------------------------------------
-- QTT 使用点：Core `TVar` 现在携带源 span；检查期记录到 `Ec.ecUseSpans`，
-- 报告线性/擦除错误时逐条挂 `fields.span name=use`。
-- ---------------------------------------------------------------
-- | 清空 QTT 使用点（每个定义体检查前调用）。
resetUseSpans : Ec -> Ec
resetUseSpans ec = ecPutUseSpans ec []

-- | 记录一次变量使用点（新记录前插；`usesOf` 还原出现顺序）。
recordUseSpan : Ec -> String -> Span -> Ec
recordUseSpan ec name sp = ecPutUseSpans ec (Pair name sp :: ecUseSpans ec)

-- | 取某名字的全部使用点（按出现顺序）。
usesOf : Ec -> String -> List Span
usesOf ec name = reverse (map secondOf (filter (\p => firstOf p == name) (ecUseSpans ec)))

-- | 把某名字的使用点挂成 fields.span。
withUseFields : Ec -> String -> Diagnostic -> Diagnostic
withUseFields ec name d = withUseSpans (usesOf ec name) d

-- | 把一组 span 逐条挂成 fields.span。
withUseSpans : List Span -> Diagnostic -> Diagnostic
withUseSpans [] d = d
withUseSpans (sp :: rest) d = withUseSpans rest (withField (FieldSpan "use" sp) d)

-- ---------------------------------------------------------------
-- warning 发射（Elab 期）：把 warning 目录条目追加进显式状态 `Ec.ecWarnings`。
-- 目录/模板的唯一真源是 `Vuna.Compiler.Diagnostics.Warning`（叶子层，不依赖 Elab）；
-- 这里只做「构造 Diagnostic + 追加进 Ec」。本模块被 Case / Dt 复用（同一份状态语义）。
-- ---------------------------------------------------------------
-- | 在 span 上发一条 warning，追加进显式状态 `Ec`，返回更新后的 Ec。
warnAt : Ec -> Span -> {n : Nat} -> WarnErr n -> Vec n String -> Ec
warnAt ec sp e args = ecAddWarning ec (warnDiagAt sp e args)

-- | arity 0 的 warning。
warnAt0 : Ec -> Span -> WarnErr Zero -> Ec
warnAt0 ec sp e = warnAt ec sp e []

-- | arity 1 的 warning。
warnAt1 : Ec -> Span -> WarnErr (Succ Zero) -> String -> Ec
warnAt1 ec sp e a0 = warnAt ec sp e [a0]

-- | 带后处理（如附加 suggestion）的 arity-1 warning。
warnAt1Mod : Ec -> (Diagnostic -> Diagnostic) -> Span -> WarnErr (Succ Zero) -> String -> Ec
warnAt1Mod ec f sp e a0 = ecAddWarning ec (warnDiagAtMod f sp e [a0])

-- | 带后处理（如附加 suggestion）的 arity-0 warning。
warnAt0Mod : Ec -> (Diagnostic -> Diagnostic) -> Span -> WarnErr Zero -> Ec
warnAt0Mod ec f sp e = ecAddWarning ec (warnDiagAtMod f sp e [])
