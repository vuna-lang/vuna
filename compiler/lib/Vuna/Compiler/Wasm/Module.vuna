module Vuna.Compiler.Wasm.Module where

-- IrProgram -> WasmModule（WAT 文本之前的结构）。
--
-- 从 `main` 沿 `irDefDeps` 求可达闭包，只生成可达定义；支持 Int / Nat /
-- String / Bool 纯值、`let` / `if`、顶层饱和调用、立即 lambda 应用、Nat 结构递归
-- （`IrNatCase`）、`IrConcatMany`、内建饱和应用、入口打印，以及
-- `IrCtor` / `IrRecord` / `IrProj` / `IrRecUpd` / `IrCase`。
-- 表示：统一 anyref；Int/Nat 装箱 i64；Bool i31；String `(array (mut i8))`；
-- 变体 `(struct (field i32 tag) (field anyref...))`；record 纯字段 struct；
-- 闭包 `{code,env}` 与数组类型留在类型表里（当前指令面还不用它们）。
import Base.Bool
import Base.HashMap
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.Result
import Base.String
import Vuna.Compiler.Ir.Model
import Vuna.Compiler.Ir.Analysis
import Vuna.Compiler.Ir.Runtime
import Vuna.Compiler.Wasm.Instr
import Vuna.Compiler.Wasm.Model
import Vuna.Compiler.Wasm.Runtime
import Vuna.Compiler.Wasm.Types

export data WasmOutcome(..) : Type where
  WasmOk : WasmModule -> WasmOutcome
  WasmRejected : WasmErr -> WasmOutcome

record GenState where
  gsFams : List WasmFam
  -- | 族名 / 定义名 / 字符串字面量的查表；生成期只读。
  gsFamTbl : HashMap String WasmFam
  gsDefs : List IrDef
  gsDefTbl : HashMap String IrDef
  gsPool : List (Pair String (Pair Int Int))
  gsPoolTbl : HashMap String (Pair Int Int)
  gsFuncs : List WatFunc
  gsLocals : List (Pair String WatValTy)
  gsNextLocal : Int
  gsScope : List (Pair IrBinder String)
  gsConsts : RtConsts
  -- | `(elem declare func ...)` 的名字表（`ref.func` 需要）。
  gsElems : List String
  -- | 当前表达式是否在函数体的尾位置（用于发 `return_call`，避免尾递归吃栈）。
  gsTail : Bool
  -- | 下一个闭包函数编号。
  gsNextLam : Int

binderNameOf : IrBinder -> IrBName
binderNameOf (IrBinder nm _) = nm

binderErasedOf : IrBinder -> Bool
binderErasedOf (IrBinder _ erased) = erased

bNameEq : IrBName -> IrBName -> Bool
bNameEq (IrBUser x) b = case b of
  IrBUser y => x == y
  _ => False
bNameEq (IrBArm x) b = case b of
  IrBArm y => x == y
  _ => False
bNameEq (IrBNat x) b = case b of
  IrBNat y => x == y
  _ => False
bNameEq IrBWild b = case b of
  IrBWild => True
  _ => False

binderEq : IrBinder -> IrBinder -> Bool
binderEq a b = bNameEq (binderNameOf a) (binderNameOf b) && binderErasedOf a == binderErasedOf b

lookupBinder : IrBinder -> List (Pair IrBinder String) -> Maybe String
lookupBinder _ [] = Nothing
lookupBinder b (p :: rest) =
  if binderEq b (firstOf p) then Just (secondOf p) else lookupBinder b rest

freshLocal : GenState -> WatValTy -> Pair String GenState
freshLocal st ty =
  let
    name = "$l${strFromInt st.gsNextLocal}"
    st1 = { st | gsLocals = append st.gsLocals [Pair name ty], gsNextLocal = st.gsNextLocal + 1 }
  in Pair name st1

pushBinder : IrBinder -> String -> GenState -> GenState
pushBinder b l st = { st | gsScope = Pair b l :: st.gsScope }

-- | 结束一个 binder 作用域：只恢复 binder 表；local 编号不回退（不复用）。
restoreScope : List (Pair IrBinder String) -> GenState -> GenState
restoreScope scope st = { st | gsScope = scope }

-- | 运行时 binder（擦除占位不进作用域）。
runtimeBinders : List IrBinder -> List IrBinder
runtimeBinders bs = filter (\b => not (binderErasedOf b)) bs

-- | 进入一个函数生成作用域：局部表与 binder 表都从空开始（各函数互不共享）。
beginFuncScope : GenState -> GenState
beginFuncScope st =
  let
    st1 = { st | gsLocals = [] }
  in { st1 | gsNextLocal = 0, gsScope = [], gsTail = False }

noTail : GenState -> GenState
noTail st = { st | gsTail = False }

withTail : Bool -> GenState -> GenState
withTail b st = { st | gsTail = b }

-- | 函数生成结束：把外层作用域与局部表还原（函数自己的局部表已取走）。
endFuncScope : GenState -> List (Pair String WatValTy) -> Int -> List (Pair IrBinder String) -> GenState
endFuncScope st locals next scope =
  let
    st1 = { st | gsLocals = locals }
  in { st1 | gsNextLocal = next, gsScope = scope }

-- | `if` / `Nat case` 两臂的合并：局部表、闭包函数与 elem 表都取并集
--   （两臂可能各自分配了不同的局部/闭包；只取较大的一臂会丢声明）。
mergeArmState : GenState -> GenState -> GenState
mergeArmState a b =
  { a | gsLocals = mergeLocals a.gsLocals b.gsLocals, gsNextLocal = if b.gsNextLocal > a.gsNextLocal then b.gsNextLocal else a.gsNextLocal, gsFuncs = mergeFuncs a.gsFuncs b.gsFuncs, gsElems = mergeNames a.gsElems b.gsElems, gsNextLam = if b.gsNextLam > a.gsNextLam then b.gsNextLam else a.gsNextLam }

mergeLocals : List (Pair String WatValTy) -> List (Pair String WatValTy) -> List (Pair String WatValTy)
mergeLocals a b = append a (filter (\p => not (memLocalName (firstOf p) a)) b)

memLocalName : String -> List (Pair String WatValTy) -> Bool
memLocalName _ [] = False
memLocalName n (p :: rest) = n == firstOf p || memLocalName n rest

watFuncNameOfF : WatFunc -> String
watFuncNameOfF f = f.watFuncName

mergeFuncs : List WatFunc -> List WatFunc -> List WatFunc
mergeFuncs a b = append a (filter (\f => not (memFuncName (watFuncNameOfF f) a)) b)

memFuncName : String -> List WatFunc -> Bool
memFuncName _ [] = False
memFuncName n (f :: rest) = n == watFuncNameOfF f || memFuncName n rest

mergeNames : List String -> List String -> List String
mergeNames a b = append a (filter (\n => not (memStr n a)) b)

zipIdx : Int -> List IrBinder -> List (Pair IrBinder String)
zipIdx _ [] = []
zipIdx i (b :: rest) = Pair b ("$p" ++ strFromInt i) :: zipIdx (i + 1) rest

funcParams : Int -> List (Pair String WatValTy)
funcParams n = map (\i => Pair ("$p" ++ strFromInt i) WvAnyRef) (range 0 n)

-- ---------------------------------------------------------------
-- 字符串池
-- ---------------------------------------------------------------
-- 按首现序收集不同字面量：查重走 HashMap，顺序表只追加一次（末尾 reverse）。
poolAdd : String -> Pair (List String) (HashMap String Bool) -> Pair (List String) (HashMap String Bool)
poolAdd s acc =
  if Base.HashMap.member s (secondOf acc) then acc
  else Pair (s :: firstOf acc) (Base.HashMap.insert s True (secondOf acc))

poolOf : List String -> List (Pair String (Pair Int Int))
poolOf strs =
  let
    acc = foldlStrings (\acc => \s => poolAdd s acc) (Pair [] (Base.HashMap.fromList [])) strs
  in poolOffsets (reverse (firstOf acc)) 0

poolOffsets : List String -> Int -> List (Pair String (Pair Int Int))
poolOffsets [] _ = []
poolOffsets (s :: rest) off =
  Pair s (Pair off (strLength s)) :: poolOffsets rest (off + strLength s)

poolLookup : String -> HashMap String (Pair Int Int) -> Maybe (Pair Int Int)
poolLookup s tbl = Base.HashMap.lookup s tbl

poolBytes : List (Pair String (Pair Int Int)) -> String
poolBytes pool = joinWith "" (map (\p => firstOf p) pool)

-- ---------------------------------------------------------------
-- 表达式
-- ---------------------------------------------------------------
boolI31 : Bool -> List Instr
boolI31 b = [IConstI32 (if b then 1 else 0), II31New]

emptyStr : List Instr
emptyStr = [IConstI32 0, IArrayNewDefault "$str"]

-- ---------------------------------------------------------------
-- 浮点字面量
-- ---------------------------------------------------------------
-- 原文只有数字与一个小数点（词法层保证）。用 `int / 10^k` 在运行期算成 double：
-- 分子分母都 < 2^53 时与宿主解析同一舍入结果；更长字面量按 Int 精度截断。
floatDigitsOf : String -> Int
floatDigitsOf s = floatDigitsGo (strUnpack s) 0

floatDigitsGo : List Int -> Int -> Int
floatDigitsGo [] acc = acc
floatDigitsGo (c :: rest) acc =
  if c >= 48 && c <= 57 then floatDigitsGo rest (acc * 10 + (c - 48)) else floatDigitsGo rest acc

floatPow10 : Int -> Int
floatPow10 n = if n <= 0 then 1 else 10 * floatPow10 (n - 1)

genFloatLit : GenState -> String -> Result (Pair (List Instr) GenState)
genFloatLit st raw = case Base.String.split "." raw of
  [ip, fp] =>
    let
      num = floatDigitsOf (ip ++ fp)
      den = floatPow10 (strLength fp)
    in if den == 1 then Ok (Pair [IConstI64 num, IStructNew "$int", ICall "$rt_floatFromInt"] st)
    else case freshLocal st WvAnyRef of
      Pair l st1 =>
        Ok
          (Pair [IConstI64 den, IStructNew "$int", ICall "$rt_floatFromInt", ILocalSet l, IConstI64 num, IStructNew "$int", ICall "$rt_floatFromInt", ILocalGet l, ICall "$rt_floatDiv"] st1)
  _ => Ok (Pair [IConstI64 (floatDigitsOf raw), IStructNew "$int", ICall "$rt_floatFromInt"] st)

-- ---------------------------------------------------------------
-- Eff thunk（效应原语包装成 `MkEff (fun _ => prim args)`）
-- ---------------------------------------------------------------
applyAllIr : Ir -> List Ir -> Ir
applyAllIr f [] = f
applyAllIr f (a :: rest) = applyAllIr (IrApp f a) rest

effUnitBinder : IrBinder
effUnitBinder = IrBinder (IrBUser "effUnitArg") False

effArgBinders : Int -> List IrBinder
effArgBinders n = map (\i => IrBinder (IrBUser ("effArg" ++ strFromInt i)) False) (range 0 n)

genEffThunk : Int -> GenState -> String -> String -> Int -> Ir -> Result (Pair (List Instr) GenState)
genEffThunk fuel st family ctor arity prim = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else
  let
    bs = effArgBinders arity
    applied = applyAllIr prim (map (\b => IrVar b) bs)
    mkEff = IrCtor family ctor [IrLam [effUnitBinder] applied]
    outer = if arity <= 0 then mkEff else IrLam bs mkEff
  in genExpr (fuel - 1) st outer

genExpr : Int -> GenState -> Ir -> Result (Pair (List Instr) GenState)
genExpr fuel st ir = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case ir of
  IrVar b => genVar st b
  IrGlobal name => genGlobalRef (fuel - 1) st name
  IrInt n => Ok (Pair [IConstI64 n, IStructNew "$int"] st)
  IrBool b => Ok (Pair (boolI31 b) st)
  IrStr s => genStr st s
  IrCast inner => genExpr (fuel - 1) st inner
  IrLet bs scrut body => genLet (fuel - 1) st bs scrut body
  IrIf c th el => genIf (fuel - 1) st c th el
  IrRtApp sym args => genRtApp (fuel - 1) st sym args
  IrApp _ _ => genApp (fuel - 1) st ir
  IrNatCase scrut _fresh zero succ catch => genNatCase (fuel - 1) st scrut zero succ catch
  IrConcatMany parts => genConcatMany (fuel - 1) st parts
  IrCtor family ctor args => genCtor (fuel - 1) st family ctor args
  IrRecord family fields => genRecord (fuel - 1) st family fields
  IrProj base family field => genProj (fuel - 1) st base family field
  IrRecUpd base family fields => genRecUpd (fuel - 1) st base family fields
  IrCase scrut alts => genCase (fuel - 1) st scrut alts
  IrLam bs body => genLamValue (fuel - 1) st bs body
  IrEffThunk family ctor _unitTy arity prim => genEffThunk (fuel - 1) st family ctor arity prim
  IrEffBind _ _ _ => Err "wasm target: effect bindings are not supported yet"
  IrFloatLit raw => genFloatLit st raw
  IrRt sym => genRtValue (fuel - 1) st sym

genVar : GenState -> IrBinder -> Result (Pair (List Instr) GenState)
genVar st b = case lookupBinder b st.gsScope of
  Just l => Ok (Pair [ILocalGet l] st)
  Nothing => Err "unbound runtime binder in wasm codegen"

-- | 顶层定义引用：arity 0 读全局；arity > 0 是函数值——eta 展开成柯里化闭包。
genGlobalRef : Int -> GenState -> String -> Result (Pair (List Instr) GenState)
genGlobalRef fuel st name = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case Base.HashMap.lookup name st.gsDefTbl of
  Just d => if irDefArity d == 0 then Ok (Pair [IGlobalGet (watGlobalNameOf name)] st)
  else
    let
      bs = etaBinders (irDefArity d)
    in genLamValue (fuel - 1) st bs (applyAllIr (IrGlobal name) (map (\b => IrVar b) bs))
  Nothing => Err "unknown top-level definition in wasm codegen: `${name}`"

-- | 运行时符号作为值：`RtValue` 直接内联；`RtFunc` eta 展开成闭包。
genRtValue : Int -> GenState -> String -> Result (Pair (List Instr) GenState)
genRtValue fuel st sym = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case rtImplOf sym of
  RtValue instrs => Ok (Pair instrs st)
  RtUnsupported => Err "wasm target: runtime symbol `${sym}` is not supported yet"
  RtFunc n _ =>
    let
      bs = etaBinders n
    in genLamValue (fuel - 1) st bs (IrRtApp sym (map (\b => IrVar b) bs))

etaBinders : Int -> List IrBinder
etaBinders n = map (\i => IrBinder (IrBUser ("__eta" ++ strFromInt i)) False) (range 0 n)

splitAt : Int -> List a -> Pair (List a) (List a)
splitAt n xs = if n <= 0 then Pair [] xs
else case xs of
  [] => Pair [] []
  y :: rest => case splitAt (n - 1) rest of
    Pair a b => Pair (y :: a) b

genStr : GenState -> String -> Result (Pair (List Instr) GenState)
genStr st s = if strLength s == 0 then Ok (Pair emptyStr st)
else case poolLookup s st.gsPoolTbl of
  Nothing => Err "string literal missing from wasm data pool"
  Just p => Ok (Pair [IConstI32 (firstOf p), IConstI32 (secondOf p), IArrayNewData "$str" "$d0"] st)

-- 两臂**顺序**生成：else 臂从 then 臂生成后的状态继续。闭包编号 `gsNextLam` 与函数表是
-- 单调累加的；若两臂都从条件后的状态起步，两臂内各自的 lambda 会拿到同一个 `$lamN`，
-- `mergeArmState` 按名字去重时后一臂的闭包函数被丢掉，else 臂的 `ref.func` 便指向
-- then 臂的函数体。作用域回到条件后的基线，避免 then 臂内 `case` 分支的 binder 泄漏。
resumeArm : GenState -> GenState -> GenState
resumeArm base afterThen = { afterThen | gsScope = base.gsScope }

genIf : Int -> GenState -> Ir -> Ir -> Ir -> Result (Pair (List Instr) GenState)
genIf fuel st c th el = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) c of
  Err e => Err e
  Ok pc =>
    let
      base = withTail st.gsTail (secondOf pc)
    in case genExpr (fuel - 1) base th of
      Err e => Err e
      Ok pt => case genExpr (fuel - 1) (withTail st.gsTail (resumeArm base (secondOf pt))) el of
        Err e => Err e
        Ok pe =>
          let
            merged = withTail st.gsTail (mergeArmState (secondOf pt) (secondOf pe))
          in Ok
            (Pair (append (firstOf pc) [IRefCast "i31", II31GetU, IIf "anyref" (firstOf pt) (firstOf pe)]) merged)

-- | `let`：单运行时 binder；装箱 case 降级的多 binder 走 `genLetBound` 的逐项分支。
genLet : Int -> GenState -> List IrBinder -> Ir -> Ir -> Result (Pair (List Instr) GenState)
genLet fuel st bs scrut body = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else
  let
    runtimeBs = runtimeBinders bs
    savedScope = st.gsScope
  in case genExpr (fuel - 1) (noTail st) scrut of
    Err e => Err e
    Ok ps =>
      genLetBound (fuel - 1) (withTail st.gsTail (secondOf ps)) runtimeBs (firstOf ps) body
        savedScope

genLetBound : Int -> GenState -> List IrBinder -> List Instr -> Ir -> List (Pair IrBinder String) -> Result (Pair (List Instr) GenState)
genLetBound fuel st [] scrutInstrs body savedScope = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) st body of
  Err e => Err e
  Ok pb =>
    Ok
      (Pair (append scrutInstrs (append [IDrop] (firstOf pb))) (restoreScope savedScope (secondOf pb)))
genLetBound fuel st (b :: rest) scrutInstrs body savedScope = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else if listLengthB rest /= 0 then Err "unboxed let has more than one runtime binder"
else case freshLocal st WvAnyRef of
  Pair local st1 => case genExpr (fuel - 1) (pushBinder b local st1) body of
    Err e => Err e
    Ok pb =>
      Ok
        (Pair (append scrutInstrs (append [ILocalSet local] (firstOf pb))) (restoreScope savedScope (secondOf pb)))

listLengthB : List a -> Int
listLengthB [] = 0
listLengthB (_ :: rest) = 1 + listLengthB rest

-- ---------------------------------------------------------------
-- 应用
-- ---------------------------------------------------------------
flattenApp : Ir -> Pair Ir (List Ir)
flattenApp (IrApp f a) =
  let
    p = flattenApp f
  in Pair (firstOf p) (append (secondOf p) [a])
flattenApp x = Pair x []

genApp : Int -> GenState -> Ir -> Result (Pair (List Instr) GenState)
genApp fuel st ir = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case flattenApp ir of
  Pair head args => case head of
    IrGlobal name => genGlobalCall (fuel - 1) st name args
    IrLam bs body => case runtimeBinders bs of
      [b] => case args of
        [a] => genLamApp (fuel - 1) st [b] body [a]
        _ => genApplyValue (fuel - 1) st head args
      _ => genApplyValue (fuel - 1) st head args
    IrRt s => if s == "prim_erase" then case args of
      [] => Err "prim_erase needs an argument"
      x :: rest => genExpr (fuel - 1) st (applyAllIr x rest)
    else genRtApp (fuel - 1) st s args
    _ => genApplyValue (fuel - 1) st head args

genGlobalCall : Int -> GenState -> String -> List Ir -> Result (Pair (List Instr) GenState)
genGlobalCall fuel st name args = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case Base.HashMap.lookup name st.gsDefTbl of
  Nothing => Err "unknown top-level definition in wasm codegen: `${name}`"
  Just d =>
    let
      arity = irDefArity d
      argc = listLengthB args
    in if argc == arity then genArgsThen (fuel - 1) st args
      (if st.gsTail then IReturnCall (watFuncNameOf name) else ICall (watFuncNameOf name))
    else if argc < arity then genApplyValue (fuel - 1) st (IrGlobal name) args
    else case splitAt arity args of
      Pair headArgs rest => case genArgsThen (fuel - 1) st headArgs (ICall (watFuncNameOf name)) of
        Err e => Err e
        Ok p => genApplyArgs (fuel - 1) (secondOf p) (firstOf p) rest

-- ---------------------------------------------------------------
-- 闭包
-- ---------------------------------------------------------------
-- 表示沿用 `$clo = { code: (ref $ft), env: anyref }`：`$ft` 是 (env, arg) -> anyref，
-- 因此闭包是**单参**的（多参 `IrLam` 作为值暂不支持）。env 是 `$env`（anyref 数组）。
-- 捕获策略与 native 侧一致：创建时把当前作用域里的全部 binder 拷进 env。
-- 闭包应用走 `$rt_apply`（逐实参左结合，天然支持柯里化）。
-- | 捕获值的取值指令（按作用域顺序）。
capGetInstrs : List (Pair IrBinder String) -> List Instr
capGetInstrs [] = []
capGetInstrs (p :: rest) = ILocalGet (secondOf p) :: capGetInstrs rest

-- | 把 env 数组里的捕获值拷进本帧局部，并绑定 binder。
bindEnvLocals : GenState -> List (Pair IrBinder String) -> Int -> Result (Pair (List Instr) GenState)
bindEnvLocals st [] _ = Ok (Pair [] st)
bindEnvLocals st ((Pair b _) :: rest) i = case freshLocal st WvAnyRef of
  Pair l st1 => case bindEnvLocals (pushBinder b l st1) rest (i + 1) of
    Err e => Err e
    Ok q =>
      Ok
        (Pair (append [ILocalGet "$p0", IRefCast "$env", IConstI32 i, IArrayGet "$env", ILocalSet l] (firstOf q)) (secondOf q))

-- | `IrLam` 作为值：生成单参闭包函数并构造 `$clo`。
--   先前插、装配时 reverse，避免逐项 append。
addLamFunc : WatFunc -> GenState -> GenState
addLamFunc f st = { st | gsFuncs = f :: st.gsFuncs }

addElemName : String -> GenState -> GenState
addElemName n st = { st | gsElems = n :: st.gsElems }

restoreFuncScope : GenState -> GenState -> GenState
restoreFuncScope outer inner =
  let
    a = { inner | gsScope = outer.gsScope }
    b = { a | gsLocals = outer.gsLocals }
  in { b | gsNextLocal = outer.gsNextLocal, gsTail = outer.gsTail }

-- | `IrLam` 作为值：生成单参闭包函数并构造 `$clo`。
--   多参 lambda 在创建时柯里化成嵌套的单参闭包（与 `$ft` / `$rt_apply` 的单参形状一致）；
--   应用侧逐实参左结合，因此 `\x => \y => ...` 与多 binder lambda 都成立。
genLamValue : Int -> GenState -> List IrBinder -> Ir -> Result (Pair (List Instr) GenState)
genLamValue fuel st bs body = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else
  let
    rbs = runtimeBinders bs
    caps = st.gsScope
    ncap = listLengthB caps
    n = st.gsNextLam
    lamName = "$lam${strFromInt n}"
    st1 = { st | gsNextLam = n + 1 }
  in case rbs of
    [] => genExpr (fuel - 1) st body
    b :: rest => if listLengthB rest > 0 then genLamValue (fuel - 1) st [b] (IrLam rest body)
    else case bindEnvLocals (beginFuncScope st1) caps 0 of
      Err e => Err e
      Ok cp => case freshLocal (secondOf cp) WvAnyRef of
        Pair pl stp => case genExpr (fuel - 1) (pushBinder b pl (withTail True stp)) body of
          Err e => Err e
          Ok q =>
            let
              stF = secondOf q
              lamFunc =
                WatFunc lamName "" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef]
                  stF.gsLocals
                  (append (firstOf cp) (append [ILocalGet "$p1", ILocalSet pl] (firstOf q)))
              capVals = capGetInstrs caps
              envInstrs =
                if ncap == 0 then [IRefNull] else append capVals [IArrayNewFixed "$env" ncap]
              mkClo = append [IRefFunc lamName] (append envInstrs [IStructNew "$clo"])
              stA = addLamFunc lamFunc stF
              stB = addElemName lamName stA
              stC = restoreFuncScope st stB
            in Ok (Pair mkClo stC)
        _ => Err "wasm target: lambda binder shape mismatch"

-- | 通用闭包应用：逐实参 `call $rt_apply`（左结合）。
genApplyValue : Int -> GenState -> Ir -> List Ir -> Result (Pair (List Instr) GenState)
genApplyValue fuel st head args = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) head of
  Err e => Err e
  Ok p => genApplyArgs (fuel - 1) (withTail st.gsTail (secondOf p)) (firstOf p) args

genApplyArgs : Int -> GenState -> List Instr -> List Ir -> Result (Pair (List Instr) GenState)
genApplyArgs _ st acc [] = Ok (Pair acc st)
genApplyArgs fuel st acc (a :: rest) = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) a of
  Err e => Err e
  Ok p =>
    genApplyArgs (fuel - 1) (withTail st.gsTail (secondOf p))
      (append acc (append (firstOf p) [ICall "$rt_apply"])) rest

-- | 立即 lambda 应用：运行时 binder 必须恰好一个、实参恰好一个（`let` 的降级形态）。
genLamApp : Int -> GenState -> List IrBinder -> Ir -> List Ir -> Result (Pair (List Instr) GenState)
genLamApp fuel st bs body args = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else
  let
    rbs = runtimeBinders bs
    savedScope = st.gsScope
  in if listLengthB rbs /= 1 then Err "wasm target: only single-binder lambdas are supported yet"
  else if listLengthB args /= 1 then Err "wasm target: only saturated single-argument lambda application is supported yet"
  else case args of
    [a] => case genExpr (fuel - 1) (noTail st) a of
      Err e => Err e
      Ok pa => case rbs of
        [b] => case freshLocal (withTail st.gsTail (secondOf pa)) WvAnyRef of
          Pair local st1 => case genExpr (fuel - 1) (pushBinder b local (withTail st.gsTail st1)) body of
            Err e => Err e
            Ok pb =>
              Ok
                (Pair (append (firstOf pa) (append [ILocalSet local] (firstOf pb))) (restoreScope savedScope (secondOf pb)))
        _ => Err "wasm target: lambda binder shape mismatch"
    _ => Err "wasm target: lambda application shape mismatch"

-- | 左→右求值全部实参，最后一条 `call`（实参已按序留在栈上）。
genArgsThen : Int -> GenState -> List Ir -> Instr -> Result (Pair (List Instr) GenState)
genArgsThen fuel st [] k = Ok (Pair [k] st)
genArgsThen fuel st (a :: rest) k = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) a of
  Err e => Err e
  Ok p => case genArgsThen (fuel - 1) (withTail st.gsTail (secondOf p)) rest k of
    Err e => Err e
    Ok q => Ok (Pair (append (firstOf p) (firstOf q)) (secondOf q))

genRtApp : Int -> GenState -> String -> List Ir -> Result (Pair (List Instr) GenState)
genRtApp fuel st sym args = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case rtImplOf sym of
  RtUnsupported => Err "wasm target: runtime symbol `${sym}` is not supported yet"
  RtValue instrs =>
    if listLengthB args == 0 then Ok (Pair instrs st)
    else Err "wasm target: runtime value `${sym}` applied to arguments"
  RtFunc n name =>
    let
      argc = listLengthB args
    in if argc == n then genArgsThen (fuel - 1) st args (if st.gsTail then IReturnCall name else ICall name)
    else if argc < n then genApplyValue (fuel - 1) st (IrRt sym) args
    else case splitAt n args of
      Pair headArgs rest => case genArgsThen (fuel - 1) st headArgs (ICall name) of
        Err e => Err e
        Ok p => genApplyArgs (fuel - 1) (secondOf p) (firstOf p) rest

-- ---------------------------------------------------------------
-- Nat case / 字符串拼接
-- ---------------------------------------------------------------
unboxLocalInt : String -> List Instr
unboxLocalInt l = [ILocalGet l, IRefCast "$int", IStructGet "$int" 0]

boxInstr : List Instr
boxInstr = [IStructNew "$int"]

-- | Nat 分支：`valueInstrs` 先求值出一个 anyref（零支 = scrutinee 本身，后继支 = 前驱），
-- 再按 binder 存进 fresh local 并生成分支体。
genNatArm : Int -> GenState -> Maybe IrAlt -> List Instr -> Result (Pair (List Instr) GenState)
genNatArm fuel st alt valueInstrs = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case alt of
  Nothing => Err "wasm target: Nat case has no zero/succ/catch branch"
  Just a => genNatArmAlt fuel st a valueInstrs

genNatArmAlt : Int -> GenState -> IrAlt -> List Instr -> Result (Pair (List Instr) GenState)
genNatArmAlt fuel st a valueInstrs = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else
  let
    bs = runtimeBinders (irAltBindersOf a)
    savedScope = st.gsScope
  in case bs of
    [] => genExpr (fuel - 1) st (irAltBodyOf a)
    [b] => case freshLocal st WvAnyRef of
      Pair local st1 => case genExpr (fuel - 1) (pushBinder b local st1) (irAltBodyOf a) of
        Err e => Err e
        Ok pb =>
          Ok
            (Pair (append valueInstrs (append [ILocalSet local] (firstOf pb))) (restoreScope savedScope (secondOf pb)))
    _ => Err "wasm target: Nat case arm has more than one runtime binder"

genNatCase : Int -> GenState -> Ir -> Maybe IrAlt -> Maybe IrAlt -> Maybe IrAlt -> Result (Pair (List Instr) GenState)
genNatCase fuel st scrut zero succ catch = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) scrut of
  Err e => Err e
  Ok ps => case freshLocal (withTail st.gsTail (secondOf ps)) WvAnyRef of
    Pair scLocal st1 =>
      let
        zeroAlt = case zero of
          Just z => Just z
          Nothing => catch
        succAlt = case succ of
          Just z => Just z
          Nothing => catch
        zeroValue = [ILocalGet scLocal]
        succValue = append (unboxLocalInt scLocal) [IConstI64 1, IBinop "i64.sub"]
        succBoxed = append succValue boxInstr
      in case genNatArm (fuel - 1) st1 zeroAlt zeroValue of
        Err e => Err e
        Ok pz => case genNatArm (fuel - 1) st1 succAlt succBoxed of
          Err e => Err e
          Ok psu =>
            let
              merged = withTail st.gsTail (mergeArmState (secondOf pz) (secondOf psu))
              cond = append (unboxLocalInt scLocal) [IConstI64 0, IBinop "i64.eq"]
            in Ok
              (Pair (append (firstOf ps) (append [ILocalSet scLocal] (append cond [IIf "anyref" (firstOf pz) (firstOf psu)]))) merged)

genConcatMany : Int -> GenState -> List Ir -> Result (Pair (List Instr) GenState)
genConcatMany fuel st parts = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case parts of
  [] => Ok (Pair emptyStr st)
  [a] => genExpr (fuel - 1) (noTail st) a
  a :: rest => case genExpr (fuel - 1) (noTail st) a of
    Err e => Err e
    Ok pa => case genConcatRest (fuel - 1) (secondOf pa) rest of
      Err e => Err e
      Ok pr => Ok (Pair (append (firstOf pa) (firstOf pr)) (secondOf pr))

genConcatRest : Int -> GenState -> List Ir -> Result (Pair (List Instr) GenState)
genConcatRest fuel st [] = Ok (Pair [] st)
genConcatRest fuel st (b :: rest) = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) b of
  Err e => Err e
  Ok p => case genConcatRest (fuel - 1) (withTail st.gsTail (secondOf p)) rest of
    Err e => Err e
    Ok q => Ok (Pair (append (firstOf p) (append [ICall "$rt_strConcat"] (firstOf q))) (secondOf q))

-- ---------------------------------------------------------------
-- data / record
-- ---------------------------------------------------------------
famOrFail : GenState -> String -> Result WasmFam
famOrFail st family = case Base.HashMap.lookup family st.gsFamTbl of
  Just f => Ok f
  Nothing => Err "unknown data family in wasm codegen: `${family}`"

refNullN : Int -> List Instr
refNullN n = if n <= 0 then [] else IRefNull :: refNullN (n - 1)

genExprs : Int -> GenState -> List Ir -> Result (Pair (List Instr) GenState)
genExprs _ st [] = Ok (Pair [] st)
genExprs fuel st (a :: rest) = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) a of
  Err e => Err e
  Ok p => case genExprs (fuel - 1) (withTail st.gsTail (secondOf p)) rest of
    Err e => Err e
    Ok q => Ok (Pair (append (firstOf p) (firstOf q)) (secondOf q))

-- | 构造子：`(struct.new $t_<family> (i32.const tag) (args...) (ref.null any * pad))`。
--   变体族的字段并集按最大 arity 补齐（`Wasm.Types` 定); 短构造子的尾部补 null。
genCtor : Int -> GenState -> String -> String -> List Ir -> Result (Pair (List Instr) GenState)
genCtor fuel st family ctor args = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case famOrFail st family of
  Err e => Err e
  Ok fam => case wasmCtorTagOf fam ctor of
    Nothing => Err "unknown constructor in wasm codegen: `${ctor}`"
    Just tag => case wasmCtorFieldCountOf fam ctor of
      Nothing => Err "unknown constructor in wasm codegen: `${ctor}`"
      Just n => if listLengthB args /= n then Err "constructor `${ctor}` applied to the wrong number of arguments"
      else case genExprs (fuel - 1) st args of
        Err e => Err e
        Ok p =>
          let
            instrs =
              append (IConstI32 tag :: firstOf p)
                (append (refNullN (fam.wasmFamMaxFields - n)) [IStructNew (watFamName family)])
          in Ok (Pair instrs (secondOf p))

-- | record 构造：字段按运行时字段表顺序求值后 `struct.new`。
genRecord : Int -> GenState -> String -> List (Pair String Ir) -> Result (Pair (List Instr) GenState)
genRecord fuel st family fields = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case famOrFail st family of
  Err e => Err e
  Ok fam => if listLengthB fields /= listLengthB fam.wasmFamRecordFields then Err "record `${family}` constructed with the wrong number of fields"
  else case genExprs (fuel - 1) st (map (\p => secondOf p) fields) of
    Err e => Err e
    Ok p => Ok (Pair (append (firstOf p) [IStructNew (watFamName family)]) (secondOf p))

genProj : Int -> GenState -> Ir -> String -> String -> Result (Pair (List Instr) GenState)
genProj fuel st base family field = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case famOrFail st family of
  Err e => Err e
  Ok fam => case wasmRecordFieldIndex fam field of
    Nothing => Err "unknown record field in wasm codegen: `${family}.${field}`"
    Just idx => case genExpr (fuel - 1) (noTail st) base of
      Err e => Err e
      Ok p =>
        Ok
          (Pair (append (firstOf p) [IRefCast (watFamName family), IStructGet (watFamName family) idx]) (withTail st.gsTail (secondOf p)))

-- | 更新：按字段表顺序重建一个 struct；被改字段用新值，其余从旧对象 `struct.get`。
genRecUpd : Int -> GenState -> Ir -> String -> List (Pair String Ir) -> Result (Pair (List Instr) GenState)
genRecUpd fuel st base family fields = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case famOrFail st family of
  Err e => Err e
  Ok fam => case genExpr (fuel - 1) (noTail st) base of
    Err e => Err e
    Ok p => case freshLocal (withTail st.gsTail (secondOf p)) WvAnyRef of
      Pair bLocal st1 => case genUpdFields (fuel - 1) st1 bLocal (watFamName family) fam.wasmFamRecordFields fields of
        Err e => Err e
        Ok q =>
          Ok
            (Pair (append (firstOf p) (append [ILocalSet bLocal] (append (firstOf q) [IStructNew (watFamName family)]))) (secondOf q))

genUpdFields : Int -> GenState -> String -> String -> List (Pair Int String) -> List (Pair String Ir) -> Result (Pair (List Instr) GenState)
genUpdFields _ st _ _ [] _ = Ok (Pair [] st)
genUpdFields fuel st bLocal ty ((Pair idx name) :: rest) fields = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case lookupFieldIr name fields of
  Just ir => case genExpr (fuel - 1) (noTail st) ir of
    Err e => Err e
    Ok p => case genUpdFields (fuel - 1) (withTail st.gsTail (secondOf p)) bLocal ty rest fields of
      Err e => Err e
      Ok q => Ok (Pair (append (firstOf p) (firstOf q)) (secondOf q))
  Nothing => case genUpdFields (fuel - 1) st bLocal ty rest fields of
    Err e => Err e
    Ok q =>
      Ok (Pair (append [ILocalGet bLocal, IRefCast ty, IStructGet ty idx] (firstOf q)) (secondOf q))

lookupFieldIr : String -> List (Pair String Ir) -> Maybe Ir
lookupFieldIr _ [] = Nothing
lookupFieldIr name (p :: rest) =
  if firstOf p == name then Just (secondOf p) else lookupFieldIr name rest

-- | 通用 case：变体族按 tag 分派；record 族没有 tag，直接绑字段。
--   先把 scrutinee 求值到 `scLocal`，再拼上分支体（分支生成器只负责 tag/字段读取）。
genCase : Int -> GenState -> Ir -> List IrAlt -> Result (Pair (List Instr) GenState)
genCase fuel st scrut alts = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genExpr (fuel - 1) (noTail st) scrut of
  Err e => Err e
  Ok p =>
    let
      st1 = ensureLocal scrutSlot WvAnyRef (withTail st.gsTail (secondOf p))
    in case caseFamilyOf alts of
      Nothing =>
        prepend (scrutInstrs p) (restoreTail st (genCatchAllOnly (fuel - 1) st1 scrutSlot alts))
      Just family => case famOrFail st1 family of
        Err e => Err e
        Ok fam => case fam.wasmFamKind of
          FamRecord =>
            prepend (scrutInstrs p)
              (restoreTail st (genRecordCase (fuel - 1) st1 scrutSlot family fam alts))
          _ =>
            prepend (scrutInstrs p)
              (restoreTail st (genVariantCase (fuel - 1) st1 scrutSlot family fam alts))

-- | case 的固定前导槽：scrutinee 求值后 `local.set` 到这里；同名槽在函数内只声明一次。
scrutSlot : String
scrutSlot = "$sc0"

scrutInstrs : Pair (List Instr) GenState -> List Instr
scrutInstrs p = append (firstOf p) [ILocalSet scrutSlot]

memStr : String -> List String -> Bool
memStr _ [] = False
memStr s (x :: rest) = s == x || memStr s rest

ensureLocal : String -> WatValTy -> GenState -> GenState
ensureLocal name ty st =
  if memStr name (map (\q => firstOf q) st.gsLocals) then st
  else { st | gsLocals = append st.gsLocals [Pair name ty] }

prepend : List Instr -> Result (Pair (List Instr) GenState) -> Result (Pair (List Instr) GenState)
prepend ins (Err e) = Err e
prepend ins (Ok q) = Ok (Pair (append ins (firstOf q)) (secondOf q))

restoreTail : GenState -> Result (Pair (List Instr) GenState) -> Result (Pair (List Instr) GenState)
restoreTail _ (Err e) = Err e
restoreTail st (Ok q) = Ok (Pair (firstOf q) (withTail st.gsTail (secondOf q)))

caseFamilyOf : List IrAlt -> Maybe String
caseFamilyOf [] = Nothing
caseFamilyOf (alt :: rest) = case irAltCtorOf alt of
  Nothing => caseFamilyOf rest
  Just p => Just (firstOf p)

-- 全是 catch-all：只绑 scrutinee 本身，求值第一臂。
genCatchAllOnly : Int -> GenState -> String -> List IrAlt -> Result (Pair (List Instr) GenState)
genCatchAllOnly fuel st scLocal alts = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case alts of
  [] => Ok (Pair [IUnreachable] st)
  alt :: _ => case bindScrutBinder (irAltBindersOf alt) scLocal st of
    Err e => Err e
    Ok p => case genExpr (fuel - 1) (secondOf p) (irAltBodyOf alt) of
      Err e => Err e
      Ok q => Ok (Pair (append (firstOf p) (firstOf q)) (secondOf q))

bindScrutBinder : List IrBinder -> String -> GenState -> Result (Pair (List Instr) GenState)
bindScrutBinder bs scLocal st = case runtimeBinders bs of
  [] => Ok (Pair [] st)
  [b] => case freshLocal st WvAnyRef of
    Pair local st1 => Ok (Pair [ILocalGet scLocal, ILocalSet local] (pushBinder b local st1))
  _ => Err "case arm has more than one runtime binder"

genVariantCase : Int -> GenState -> String -> String -> WasmFam -> List IrAlt -> Result (Pair (List Instr) GenState)
genVariantCase fuel st scLocal family fam alts = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case alts of
  [] => Ok (Pair [IUnreachable] st)
  alt :: rest => case irAltCtorOf alt of
    Nothing => case genAltBody (fuel - 1) st scLocal family fam alt of
      Err e => Err e
      Ok p => Ok (Pair (firstOf p) (secondOf p))
    Just (Pair _ ctor) => case wasmCtorTagOf fam ctor of
      Nothing => Err "unknown constructor in wasm codegen: `${ctor}`"
      Just tag => case genAltBody (fuel - 1) st scLocal family fam alt of
        Err e => Err e
        Ok armP => case genVariantCase (fuel - 1) (withTail st.gsTail (secondOf armP)) scLocal family fam rest of
          Err e => Err e
          Ok restP =>
            Ok
              (Pair (append [ILocalGet scLocal, IRefCast (watFamName family), IStructGet (watFamName family) 0, IConstI32 tag, IBinop "i32.eq"] [IIf "anyref" (firstOf armP) (firstOf restP)]) (secondOf restP))

-- 变体分支：catch-all 绑 scrutinee；构造子分支按 keep 形状绑字段（tag 占 index 0）。
genAltBody : Int -> GenState -> String -> String -> WasmFam -> IrAlt -> Result (Pair (List Instr) GenState)
genAltBody fuel st scLocal family fam alt = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case irAltCtorOf alt of
  Nothing => genCatchAllOnly (fuel - 1) st scLocal [alt]
  Just _ => case bindFields (fuel - 1) st scLocal (watFamName family) (runtimeBinders (irAltBindersOf alt)) 1 of
    Err e => Err e
    Ok bp => case genExpr (fuel - 1) (secondOf bp) (irAltBodyOf alt) of
      Err e => Err e
      Ok q => Ok (Pair (append (firstOf bp) (firstOf q)) (secondOf q))

bindFields : Int -> GenState -> String -> String -> List IrBinder -> Int -> Result (Pair (List Instr) GenState)
bindFields _ st _ _ [] _ = Ok (Pair [] st)
bindFields fuel st scLocal ty (b :: rest) idx = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case freshLocal st WvAnyRef of
  Pair local st1 => case bindFields (fuel - 1) (pushBinder b local st1) scLocal ty rest (idx + 1) of
    Err e => Err e
    Ok q =>
      Ok
        (Pair (append [ILocalGet scLocal, IRefCast ty, IStructGet ty idx, ILocalSet local] (firstOf q)) (secondOf q))

genRecordCase : Int -> GenState -> String -> String -> WasmFam -> List IrAlt -> Result (Pair (List Instr) GenState)
genRecordCase fuel st scLocal family fam alts = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case alts of
  [] => Ok (Pair [IUnreachable] st)
  alt :: rest => case irAltCtorOf alt of
    Nothing => genCatchAllOnly (fuel - 1) st scLocal (alt :: rest)
    Just _ => case bindFields (fuel - 1) st scLocal (watFamName family) (runtimeBinders (irAltBindersOf alt)) 0 of
      Err e => Err e
      Ok bp => case genExpr (fuel - 1) (secondOf bp) (irAltBodyOf alt) of
        Err e => Err e
        Ok q => Ok (Pair (append (firstOf bp) (firstOf q)) (secondOf q))

-- ---------------------------------------------------------------
-- 通用结构比较（`bi_*_generic`）
-- ---------------------------------------------------------------
-- 表示层按 WasmGC 的运行时类型分派：i31（Bool）→ `$int` → `$float` → `$str` →
-- `$arr` → 用户族（按声明序逐个 `ref.test`）。只做三向比较，`<` / `<=` 由包装函数
-- 在 `Wasm.Runtime` 里给出。
cmpTrapFunc : RtConsts -> WatFunc
cmpTrapFunc c =
  WatFunc "$rt_cmpTrap" "" [Pair "$a" WvAnyRef, Pair "$b" WvAnyRef] [WvI32] []
    (failWithConst c.rtcHostOff c.rtcHostLen)

cmpStrFunc : WatFunc
cmpStrFunc =
  let
    params = [Pair "$a" WvAnyRef, Pair "$b" WvAnyRef]
    locals =
      [ Pair "$sa" (WvRef "$str"),
        Pair "$sb" (WvRef "$str"),
        Pair "$na" WvI32,
        Pair "$nb" WvI32,
        Pair "$i" WvI32,
        Pair "$ca" WvI32,
        Pair "$cb" WvI32,
        Pair "$r" WvI32
      ]
    body =
      [ ILocalGet "$a",
        IRefCast "$str",
        ILocalSet "$sa",
        ILocalGet "$b",
        IRefCast "$str",
        ILocalSet "$sb",
        ILocalGet "$sa",
        IArrayLen,
        ILocalSet "$na",
        ILocalGet "$sb",
        IArrayLen,
        ILocalSet "$nb",
        IConstI32 0,
        ILocalSet "$i",
        IConstI32 0,
        ILocalSet "$r",
        IBlock "$s_done" "" [ILoop "$s_l" "" [ILocalGet "$i", ILocalGet "$na", IBinop "i32.ge_s", IBrIf "$s_done", ILocalGet "$i", ILocalGet "$nb", IBinop "i32.ge_s", IBrIf "$s_done", ILocalGet "$sa", ILocalGet "$i", IArrayGetU "$str", ILocalSet "$ca", ILocalGet "$sb", ILocalGet "$i", IArrayGetU "$str", ILocalSet "$cb", ILocalGet "$ca", ILocalGet "$cb", IBinop "i32.ne", IIf "" [ILocalGet "$ca", ILocalGet "$cb", IBinop "i32.lt_u", IIf "i32" [IConstI32 (0 - 1)] [IConstI32 1], ILocalSet "$r", IBr "$s_done"] [INop], ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$s_l"]],
        ILocalGet "$r",
        IConstI32 0,
        IBinop "i32.ne",
        IIf "i32" [ILocalGet "$r"] [ILocalGet "$na", ILocalGet "$nb", ICall "$rt_cmpI32"]
      ]
  in WatFunc "$rt_cmpStr" "" params [WvI32] locals body

cmpArrFunc : WatFunc
cmpArrFunc =
  let
    params = [Pair "$a" WvAnyRef, Pair "$b" WvAnyRef]
    locals =
      [ Pair "$sa" (WvRef "$arr"),
        Pair "$sb" (WvRef "$arr"),
        Pair "$na" WvI32,
        Pair "$nb" WvI32,
        Pair "$i" WvI32,
        Pair "$r" WvI32
      ]
    body =
      [ ILocalGet "$a",
        IRefCast "$arr",
        ILocalSet "$sa",
        ILocalGet "$b",
        IRefCast "$arr",
        ILocalSet "$sb",
        ILocalGet "$sa",
        IArrayLen,
        ILocalSet "$na",
        ILocalGet "$sb",
        IArrayLen,
        ILocalSet "$nb",
        IConstI32 0,
        ILocalSet "$i",
        IConstI32 0,
        ILocalSet "$r",
        IBlock "$a_done" "" [ILoop "$a_l" "" [ILocalGet "$i", ILocalGet "$na", IBinop "i32.ge_s", IBrIf "$a_done", ILocalGet "$i", ILocalGet "$nb", IBinop "i32.ge_s", IBrIf "$a_done", ILocalGet "$sa", ILocalGet "$i", IArrayGet "$arr", ILocalGet "$sb", ILocalGet "$i", IArrayGet "$arr", ICall "$rt_compare", ILocalTee "$r", IConstI32 0, IBinop "i32.ne", IIf "" [IBr "$a_done"] [], ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$a_l"]],
        ILocalGet "$r",
        IConstI32 0,
        IBinop "i32.ne",
        IIf "i32" [ILocalGet "$r"] [ILocalGet "$na", ILocalGet "$nb", ICall "$rt_cmpI32"]
      ]
  in WatFunc "$rt_cmpArr" "" params [WvI32] locals body

-- | 变体/record 的字段比较：按声明序，遇到非零就返回。
cmpFields : String -> List Int -> List Instr
cmpFields _ [] = [IConstI32 0]
cmpFields ty (i :: rest) =
  [ ILocalGet "$a",
    IRefCast ty,
    IStructGet ty i,
    ILocalGet "$b",
    IRefCast ty,
    IStructGet ty i,
    ICall "$rt_compare",
    ILocalTee "$c",
    IIf "i32" [ILocalGet "$c"] (cmpFields ty rest)
  ]

cmpFamBody : WasmFam -> List Instr
cmpFamBody fam =
  let
    ty = watFamName fam.wasmFamName
  in case fam.wasmFamKind of
    FamVariant =>
      [ ILocalGet "$a",
        IRefCast ty,
        IStructGet ty 0,
        ILocalGet "$b",
        IRefCast ty,
        IStructGet ty 0,
        ICall "$rt_cmpI32",
        ILocalTee "$c",
        IIf "i32" [ILocalGet "$c"] (cmpFields ty (range 1 (fam.wasmFamMaxFields + 1)))
      ]
    FamRecord => cmpFields ty (range 0 (length fam.wasmFamRecordFields))
    FamUnboxed => [IConstI32 0]

cmpFamFlat : WasmFam -> List Instr
cmpFamFlat fam =
  let
    ty = watFamName fam.wasmFamName
  in [ ILocalGet "$a",
    IRefTest ty,
    IIf "" [ILocalGet "$b", IRefTest ty, IIf "" (append (cmpFamBody fam) [IReturn]) [IConstI32 1, IReturn]] [INop]
  ]

cmpPrimFlat : String -> List Instr -> List Instr
cmpPrimFlat ty body = [ILocalGet "$a", IRefTest ty, IIf "" (append body [IReturn]) [INop]]

isConcreteFam : WasmFam -> Bool
isConcreteFam f = case f.wasmFamKind of
  FamUnboxed => False
  _ => True

cmpDispatch : List WasmFam -> List Instr
cmpDispatch fams =
  let
    concrete = filter isConcreteFam fams
    i31B =
      cmpPrimFlat "i31"
        [ILocalGet "$a", IRefCast "i31", II31GetS, ILocalGet "$b", IRefCast "i31", II31GetS, ICall "$rt_cmpI32"]
    intB =
      cmpPrimFlat "$int"
        [ILocalGet "$a", IRefCast "$int", IStructGet "$int" 0, ILocalGet "$b", IRefCast "$int", IStructGet "$int" 0, ICall "$rt_cmpI64"]
    floatB =
      cmpPrimFlat "$float"
        [ILocalGet "$a", IRefCast "$float", IStructGet "$float" 0, ILocalGet "$b", IRefCast "$float", IStructGet "$float" 0, ICall "$rt_cmpF64"]
    strB = cmpPrimFlat "$str" [ILocalGet "$a", ILocalGet "$b", ICall "$rt_cmpStr"]
    arrB = cmpPrimFlat "$arr" [ILocalGet "$a", ILocalGet "$b", ICall "$rt_cmpArr"]
    famB = concatMap cmpFamFlat concrete
  in append i31B
    (append intB (append floatB (append strB (append arrB (append famB [ILocalGet "$a", ILocalGet "$b", ICall "$rt_cmpTrap"])))))

rtCompareFunc : List WasmFam -> WatFunc
rtCompareFunc fams =
  let
    params = [Pair "$a" WvAnyRef, Pair "$b" WvAnyRef]
    locals = [Pair "$c" WvI32]
    body =
      [ ILocalGet "$a",
        IPlain "ref.is_null",
        IIf "i32" [ILocalGet "$b", IPlain "ref.is_null", IIf "i32" [IConstI32 0] [IConstI32 (0 - 1)]] [ILocalGet "$b", IPlain "ref.is_null", IIf "i32" [IConstI32 1] (cmpDispatch fams)]
      ]
  in WatFunc "$rt_compare" "" params [WvI32] locals body

wasmCompareFuncs : RtConsts -> List WasmFam -> List WatFunc
wasmCompareFuncs c fams = [cmpTrapFunc c, cmpStrFunc, cmpArrFunc, rtCompareFunc fams]

-- ---------------------------------------------------------------
-- List 桥接：strUnpack / strPack / strConcatMany / strSubstTemplate
-- ---------------------------------------------------------------
catI : List (List Instr) -> List Instr
catI xs = concatMap (\x => x) xs

refNulls : Int -> List Instr
refNulls n = if n <= 0 then [] else IRefNull :: refNulls (n - 1)

wasmListTy : WasmListFam -> String
wasmListTy lf = watFamName lf.wasmListFamily

wasmNilCell : WasmListFam -> List Instr
wasmNilCell lf =
  append [IConstI32 lf.wasmListNilTag]
    (append (refNulls lf.wasmListConsFields) [IStructNew (wasmListTy lf)])

wasmBridgeFuncs : Maybe WasmListFam -> List WatFunc
wasmBridgeFuncs Nothing = []
wasmBridgeFuncs (Just lf) =
  [ rtStrUnpackF lf,
    rtStrPackF lf,
    rtStrConcatManyF lf,
    rtStrArgAtF lf,
    rtStrSubstTemplateF lf,
    rtArrayFromListF lf,
    rtArrayToListF lf,
    rtGetArgsF lf,
    rtTryReadDirF lf
  ]

rtStrUnpackF : WasmListFam -> WatFunc
rtStrUnpackF lf =
  let
    ty = wasmListTy lf
    params = [Pair "$p0" WvAnyRef]
    locals =
      [ Pair "$s" (WvRef "$str"),
        Pair "$n" WvI32,
        Pair "$i" WvI32,
        Pair "$acc" WvAnyRef,
        Pair "$b" WvI32
      ]
    body =
      catI
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$s", ILocalGet "$s", IArrayLen, ILocalSet "$n"], wasmNilCell lf, [ILocalSet "$acc", ILocalGet "$n", ILocalSet "$i"], [IBlock "$u_done" "" [ILoop "$u_l" "" [ILocalGet "$i", IPlain "i32.eqz", IBrIf "$u_done", ILocalGet "$i", IConstI32 1, IBinop "i32.sub", ILocalSet "$i", ILocalGet "$s", ILocalGet "$i", IArrayGetU "$str", ILocalSet "$b", IConstI32 lf.wasmListConsTag, ILocalGet "$b", IPlain "i64.extend_i32_u", IStructNew "$int", ILocalGet "$acc", IStructNew ty, ILocalSet "$acc", IBr "$u_l"]]], [ILocalGet "$acc"]]
  in WatFunc "$rt_strUnpack" "" params [WvAnyRef] locals body

rtStrPackF : WasmListFam -> WatFunc
rtStrPackF lf =
  let
    ty = wasmListTy lf
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$cur" WvAnyRef, Pair "$n" WvI32, Pair "$out" (WvRef "$str"), Pair "$idx" WvI32]
    body =
      catI
        [[ILocalGet "$p0", ILocalSet "$cur", IConstI32 0, ILocalSet "$n"], [IBlock "$p_count_done" "" [ILoop "$p_count" "" [ILocalGet "$cur", IRefCast ty, IStructGet ty 0, IConstI32 lf.wasmListNilTag, IBinop "i32.eq", IBrIf "$p_count_done", ILocalGet "$n", IConstI32 1, IBinop "i32.add", ILocalSet "$n", ILocalGet "$cur", IRefCast ty, IStructGet ty 2, ILocalSet "$cur", IBr "$p_count"]]], [ILocalGet "$n", IArrayNewDefault "$str", ILocalSet "$out", IConstI32 0, ILocalSet "$idx", ILocalGet "$p0", ILocalSet "$cur"], [IBlock "$p_fill_done" "" [ILoop "$p_fill" "" [ILocalGet "$cur", IRefCast ty, IStructGet ty 0, IConstI32 lf.wasmListNilTag, IBinop "i32.eq", IBrIf "$p_fill_done", ILocalGet "$out", ILocalGet "$idx", ILocalGet "$cur", IRefCast ty, IStructGet ty 1, IRefCast "$int", IStructGet "$int" 0, IPlain "i32.wrap_i64", IArraySet "$str", ILocalGet "$idx", IConstI32 1, IBinop "i32.add", ILocalSet "$idx", ILocalGet "$cur", IRefCast ty, IStructGet ty 2, ILocalSet "$cur", IBr "$p_fill"]]], [ILocalGet "$out"]]
  in WatFunc "$rt_strPack" "" params [WvAnyRef] locals body

rtStrConcatManyF : WasmListFam -> WatFunc
rtStrConcatManyF lf =
  let
    ty = wasmListTy lf
    params = [Pair "$p0" WvAnyRef]
    locals =
      [ Pair "$cur" WvAnyRef,
        Pair "$total" WvI32,
        Pair "$out" (WvRef "$str"),
        Pair "$idx" WvI32,
        Pair "$src" (WvRef "$str")
      ]
    body =
      catI
        [[ILocalGet "$p0", ILocalSet "$cur", IConstI32 0, ILocalSet "$total"], [IBlock "$c_count_done" "" [ILoop "$c_count" "" [ILocalGet "$cur", IRefCast ty, IStructGet ty 0, IConstI32 lf.wasmListNilTag, IBinop "i32.eq", IBrIf "$c_count_done", ILocalGet "$total", ILocalGet "$cur", IRefCast ty, IStructGet ty 1, IRefCast "$str", IArrayLen, IBinop "i32.add", ILocalSet "$total", ILocalGet "$cur", IRefCast ty, IStructGet ty 2, ILocalSet "$cur", IBr "$c_count"]]], [ILocalGet "$total", IArrayNewDefault "$str", ILocalSet "$out", IConstI32 0, ILocalSet "$idx", ILocalGet "$p0", ILocalSet "$cur"], [IBlock "$c_fill_done" "" [ILoop "$c_fill" "" [ILocalGet "$cur", IRefCast ty, IStructGet ty 0, IConstI32 lf.wasmListNilTag, IBinop "i32.eq", IBrIf "$c_fill_done", ILocalGet "$out", ILocalGet "$idx", ILocalGet "$cur", IRefCast ty, IStructGet ty 1, IRefCast "$str", ILocalTee "$src", IConstI32 0, ILocalGet "$src", IArrayLen, IArrayCopy "$str" "$str", ILocalGet "$idx", ILocalGet "$src", IArrayLen, IBinop "i32.add", ILocalSet "$idx", ILocalGet "$cur", IRefCast ty, IStructGet ty 2, ILocalSet "$cur", IBr "$c_fill"]]], [ILocalGet "$out"]]
  in WatFunc "$rt_strConcatMany" "" params [WvAnyRef] locals body

rtStrArgAtF : WasmListFam -> WatFunc
rtStrArgAtF lf =
  let
    ty = wasmListTy lf
  in WatFunc "$rt_strArgAt" "" [Pair "$p0" WvAnyRef, Pair "$p1" WvI32] [WvAnyRef] []
    (catI [[IBlock "$a_done" "" [ILoop "$a_l" "" [ILocalGet "$p1", IPlain "i32.eqz", IBrIf "$a_done", ILocalGet "$p0", IRefCast ty, IStructGet ty 2, ILocalSet "$p0", ILocalGet "$p1", IConstI32 1, IBinop "i32.sub", ILocalSet "$p1", IBr "$a_l"]]], [ILocalGet "$p0", IRefCast ty, IStructGet ty 1]])

-- | 解析 `<digits>` 的前导（`$i` 指向 `<`）：结果在 `$j`（数字串末尾）与 `$k`（数值）。
stDigits : List Instr
stDigits =
  [ ILocalGet "$i",
    IConstI32 1,
    IBinop "i32.add",
    ILocalSet "$j",
    IConstI32 0,
    ILocalSet "$k",
    IBlock "$d_done" "" [ILoop "$d_l" "" [ILocalGet "$j", ILocalGet "$n", IBinop "i32.ge_s", IBrIf "$d_done", ILocalGet "$t", ILocalGet "$j", IArrayGetU "$str", ILocalSet "$b", ILocalGet "$b", IConstI32 48, IBinop "i32.lt_s", IBrIf "$d_done", ILocalGet "$b", IConstI32 57, IBinop "i32.gt_s", IBrIf "$d_done", ILocalGet "$k", IConstI32 10, IBinop "i32.mul", ILocalGet "$b", IConstI32 48, IBinop "i32.sub", IBinop "i32.add", ILocalSet "$k", ILocalGet "$j", IConstI32 1, IBinop "i32.add", ILocalSet "$j", IBr "$d_l"]]
  ]

-- | 占位符判定失败时跳到 `$name`：`$j >= n`、`tmpl[$j] != '>'` 或 `$j <= $i + 1`。
stNotPlaceholder : String -> List Instr
stNotPlaceholder name =
  [ ILocalGet "$j",
    ILocalGet "$n",
    IBinop "i32.ge_s",
    IBrIf name,
    ILocalGet "$t",
    ILocalGet "$j",
    IArrayGetU "$str",
    IConstI32 62,
    IBinop "i32.ne",
    IBrIf name,
    ILocalGet "$j",
    ILocalGet "$i",
    IConstI32 1,
    IBinop "i32.add",
    IBinop "i32.le_s",
    IBrIf name
  ]

-- | `strSubstTemplate`：`<digits>` 且下标存在则替换，否则原样保留
--   （与 `dtp_substTemplate` 一致）。两遍扫描：先算长度，再分配填充。
rtStrSubstTemplateF : WasmListFam -> WatFunc
-- 初始化：模板 / 实参个数 / 累计长度 / 游标
-- 第一遍：数长度
-- 不是占位符：`<` 按字面处理
-- 分配 + 重置游标（WasmGC array 自带长度，不需要写头）
-- 第二遍：填充
-- 不是占位符：`<` 按字面处理
rtStrSubstTemplateF lf =
  let
    ty = wasmListTy lf
  in WatFunc "$rt_strSubstTemplate" "" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef]
    [Pair "$t" (WvRef "$str"), Pair "$args" WvAnyRef, Pair "$n" WvI32, Pair "$na" WvI32, Pair "$total" WvI32, Pair "$i" WvI32, Pair "$j" WvI32, Pair "$k" WvI32, Pair "$b" WvI32, Pair "$out" (WvRef "$str"), Pair "$oidx" WvI32, Pair "$arg" (WvRef "$str"), Pair "$cur" WvAnyRef]
    (catI [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$t", ILocalGet "$t", IArrayLen, ILocalSet "$n", ILocalGet "$p1", ILocalSet "$args", IConstI32 0, ILocalSet "$na", ILocalGet "$args", ILocalSet "$cur", IBlock "$na_done" "" [ILoop "$na_l" "" [ILocalGet "$cur", IRefCast ty, IStructGet ty 0, IConstI32 lf.wasmListNilTag, IBinop "i32.eq", IBrIf "$na_done", ILocalGet "$na", IConstI32 1, IBinop "i32.add", ILocalSet "$na", ILocalGet "$cur", IRefCast ty, IStructGet ty 2, ILocalSet "$cur", IBr "$na_l"]], IConstI32 0, ILocalSet "$total", IConstI32 0, ILocalSet "$i"], [IBlock "$c_done" "" [ILoop "$c_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_s", IBrIf "$c_done", ILocalGet "$t", ILocalGet "$i", IArrayGetU "$str", IConstI32 60, IBinop "i32.ne", IIf "" [ILocalGet "$total", IConstI32 1, IBinop "i32.add", ILocalSet "$total", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$c_l"] (append [IBlock "$c_skip" "" (append stDigits (append (stNotPlaceholder "$c_skip") [ILocalGet "$k", ILocalGet "$na", IBinop "i32.lt_s", IIf "" [ILocalGet "$total", ILocalGet "$args", ILocalGet "$k", ICall "$rt_strArgAt", IRefCast "$str", IArrayLen, IBinop "i32.add", ILocalSet "$total"] [ILocalGet "$total", ILocalGet "$j", ILocalGet "$i", IBinop "i32.sub", IConstI32 1, IBinop "i32.add", IBinop "i32.add", ILocalSet "$total"], ILocalGet "$j", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$c_l"]))] [ILocalGet "$total", IConstI32 1, IBinop "i32.add", ILocalSet "$total", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$c_l"])]]], [ILocalGet "$total", IArrayNewDefault "$str", ILocalSet "$out", IConstI32 0, ILocalSet "$oidx", IConstI32 0, ILocalSet "$i"], [IBlock "$f_done" "" [ILoop "$f_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_s", IBrIf "$f_done", ILocalGet "$t", ILocalGet "$i", IArrayGetU "$str", IConstI32 60, IBinop "i32.ne", IIf "" [ILocalGet "$out", ILocalGet "$oidx", ILocalGet "$t", ILocalGet "$i", IArrayGetU "$str", IArraySet "$str", ILocalGet "$oidx", IConstI32 1, IBinop "i32.add", ILocalSet "$oidx", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$f_l"] (append [IBlock "$f_skip" "" (append stDigits (append (stNotPlaceholder "$f_skip") [ILocalGet "$k", ILocalGet "$na", IBinop "i32.lt_s", IIf "" [ILocalGet "$out", ILocalGet "$oidx", ILocalGet "$args", ILocalGet "$k", ICall "$rt_strArgAt", IRefCast "$str", ILocalTee "$arg", IConstI32 0, ILocalGet "$arg", IArrayLen, IArrayCopy "$str" "$str", ILocalGet "$oidx", ILocalGet "$arg", IArrayLen, IBinop "i32.add", ILocalSet "$oidx", ILocalGet "$j", IConstI32 1, IBinop "i32.add", ILocalSet "$i"] [IBlock "$lit_done" "" [ILoop "$lit_l" "" [ILocalGet "$i", ILocalGet "$j", IBinop "i32.gt_s", IBrIf "$lit_done", ILocalGet "$out", ILocalGet "$oidx", ILocalGet "$t", ILocalGet "$i", IArrayGetU "$str", IArraySet "$str", ILocalGet "$oidx", IConstI32 1, IBinop "i32.add", ILocalSet "$oidx", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$lit_l"]], ILocalGet "$j", IConstI32 1, IBinop "i32.add", ILocalSet "$i"], IBr "$f_l"]))] [ILocalGet "$out", ILocalGet "$oidx", ILocalGet "$t", ILocalGet "$i", IArrayGetU "$str", IArraySet "$str", ILocalGet "$oidx", IConstI32 1, IBinop "i32.add", ILocalSet "$oidx", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$f_l"])]]], [ILocalGet "$out"]])

-- | `arrayFromList`：List -> `$arr`（先数长度，再分配填充）。
rtArrayFromListF : WasmListFam -> WatFunc
rtArrayFromListF lf =
  let
    ty = wasmListTy lf
    locals = [Pair "$cur" WvAnyRef, Pair "$n" WvI32, Pair "$out" (WvRef "$arr"), Pair "$idx" WvI32]
  in WatFunc "$rt_arrayFromList" "" [Pair "$p0" WvAnyRef] [WvAnyRef] locals
    (catI [[ILocalGet "$p0", ILocalSet "$cur", IConstI32 0, ILocalSet "$n"], [IBlock "$afl_count_done" "" [ILoop "$afl_count" "" [ILocalGet "$cur", IRefCast ty, IStructGet ty 0, IConstI32 lf.wasmListNilTag, IBinop "i32.eq", IBrIf "$afl_count_done", ILocalGet "$n", IConstI32 1, IBinop "i32.add", ILocalSet "$n", ILocalGet "$cur", IRefCast ty, IStructGet ty 2, ILocalSet "$cur", IBr "$afl_count"]]], [ILocalGet "$n", IArrayNewDefault "$arr", ILocalSet "$out", IConstI32 0, ILocalSet "$idx", ILocalGet "$p0", ILocalSet "$cur"], [IBlock "$afl_fill_done" "" [ILoop "$afl_fill" "" [ILocalGet "$cur", IRefCast ty, IStructGet ty 0, IConstI32 lf.wasmListNilTag, IBinop "i32.eq", IBrIf "$afl_fill_done", ILocalGet "$out", ILocalGet "$idx", ILocalGet "$cur", IRefCast ty, IStructGet ty 1, IArraySet "$arr", ILocalGet "$idx", IConstI32 1, IBinop "i32.add", ILocalSet "$idx", ILocalGet "$cur", IRefCast ty, IStructGet ty 2, ILocalSet "$cur", IBr "$afl_fill"]]], [ILocalGet "$out"]])

-- | `arrayToList`：`$arr` -> List（从末元素向前构造 cons）。
rtArrayToListF : WasmListFam -> WatFunc
rtArrayToListF lf =
  let
    ty = wasmListTy lf
    locals = [Pair "$arr" (WvRef "$arr"), Pair "$n" WvI32, Pair "$i" WvI32, Pair "$acc" WvAnyRef]
  in WatFunc "$rt_arrayToList" "" [Pair "$p0" WvAnyRef] [WvAnyRef] locals
    (catI [[ILocalGet "$p0", IRefCast "$arr", ILocalSet "$arr", ILocalGet "$arr", IArrayLen, ILocalSet "$n", ILocalGet "$n", ILocalSet "$i"], wasmNilCell lf, [ILocalSet "$acc", IBlock "$atl_done" "" [ILoop "$atl_l" "" [ILocalGet "$i", IPlain "i32.eqz", IBrIf "$atl_done", ILocalGet "$i", IConstI32 1, IBinop "i32.sub", ILocalSet "$i", IConstI32 lf.wasmListConsTag, ILocalGet "$arr", ILocalGet "$i", IArrayGet "$arr", ILocalGet "$acc", IStructNew ty, ILocalSet "$acc", IBr "$atl_l"]]], [ILocalGet "$acc"]])

-- | `@vuna@host@getArgs`：WASI argv（跳过 argv[0]）→ `List String`。
rtGetArgsF : WasmListFam -> WatFunc
rtGetArgsF lf =
  let
    ty = wasmListTy lf
    locals =
      [ Pair "$count" WvI32,
        Pair "$ptr" WvI32,
        Pair "$buf" WvI32,
        Pair "$i" WvI32,
        Pair "$p" WvI32,
        Pair "$k" WvI32,
        Pair "$acc" WvAnyRef,
        Pair "$err" WvI32,
        Pair "$name" WvAnyRef
      ]
    body =
      append
        [IConstI32 wasiAux, IConstI32 (wasiAux + 4), ICall "$args_sizes_get", ILocalSet "$err", ILocalGet "$err", IConstI32 0, IBinop "i32.ne", IIf "" (append (wasmNilCell lf) [IReturn]) [INop], IConstI32 wasiAux, ILoad32, ILocalSet "$count", IConstI32 (wasiAux + 8), ILocalSet "$ptr", ILocalGet "$ptr", ILocalGet "$count", IConstI32 4, IBinop "i32.mul", IBinop "i32.add", ILocalSet "$buf", ILocalGet "$ptr", ILocalGet "$buf", ICall "$args_get", IDrop]
        (append (wasmNilCell lf) [ILocalSet "$acc", ILocalGet "$count", IConstI32 1, IBinop "i32.sub", ILocalSet "$i", IBlock "$a_done" "" [ILoop "$a_l" "" [ILocalGet "$i", IConstI32 1, IBinop "i32.lt_s", IBrIf "$a_done", ILocalGet "$ptr", ILocalGet "$i", IConstI32 4, IBinop "i32.mul", IBinop "i32.add", ILoad32, ILocalSet "$p", ILocalGet "$p", ILocalSet "$k", IBlock "$nul_done" "" [ILoop "$nul_l" "" [ILocalGet "$k", ILoad8U, IConstI32 0, IBinop "i32.eq", IBrIf "$nul_done", ILocalGet "$k", IConstI32 1, IBinop "i32.add", ILocalSet "$k", IBr "$nul_l"]], ILocalGet "$p", ILocalGet "$k", ILocalGet "$p", IBinop "i32.sub", ICall "$rt_memToStr", ILocalSet "$name", IConstI32 lf.wasmListConsTag, ILocalGet "$name", ILocalGet "$acc", IStructNew ty, ILocalSet "$acc", ILocalGet "$i", IConstI32 1, IBinop "i32.sub", ILocalSet "$i", IBr "$a_l"]], ILocalGet "$acc"])
  in WatFunc "$rt_getArgs" "" [] [WvAnyRef] locals body

-- | `@vuna@host@tryReadDir`：fd_readdir 逐条解析 dirent → `List String`（顺序由 handler 排序）。
rtTryReadDirF : WasmListFam -> WatFunc
rtTryReadDirF lf =
  let
    ty = wasmListTy lf
    locals =
      [ Pair "$fd" WvI32,
        Pair "$err" WvI32,
        Pair "$used" WvI32,
        Pair "$off" WvI32,
        Pair "$namlen" WvI32,
        Pair "$acc" WvAnyRef,
        Pair "$name" WvAnyRef,
        Pair "$cookie" WvI64,
        Pair "$parsed" WvI32
      ]
    body =
      append
        [IConstI32 0, IGlobalSet "$g_hostStatus", ILocalGet "$p0", IConstI32 2, IConstI64 136601638, ICall "$rt_pathOpen", ILocalSet "$fd", ILocalGet "$fd", IConstI32 0, IBinop "i32.lt_s", IIf "" (append (wasmNilCell lf) [IReturn]) [INop]]
        (append (wasmNilCell lf) [ILocalSet "$acc", IConstI64 0, ILocalSet "$cookie", IBlock "$rd_done" "" [ILoop "$rd_l" "" [ILocalGet "$fd", IConstI32 wasiDir, IConstI32 wasiDirCap, ILocalGet "$cookie", IConstI32 wasiAux, ICall "$fd_readdir", ILocalSet "$err", ILocalGet "$err", IConstI32 0, IBinop "i32.ne", IIf "" [ILocalGet "$err", ICall "$rt_errno", IGlobalSet "$g_hostStatus", IBr "$rd_done"] [INop], IConstI32 wasiAux, ILoad32, ILocalSet "$used", ILocalGet "$used", IConstI32 0, IBinop "i32.eq", IBrIf "$rd_done", IConstI32 0, ILocalSet "$off", IConstI32 0, ILocalSet "$parsed", IBlock "$buf_done" "" [ILoop "$buf_l" "" [ILocalGet "$off", IConstI32 24, IBinop "i32.add", ILocalGet "$used", IBinop "i32.gt_s", IBrIf "$buf_done", IConstI32 wasiDir, ILocalGet "$off", IBinop "i32.add", IConstI32 16, IBinop "i32.add", ILoad32, ILocalSet "$namlen", ILocalGet "$off", IConstI32 24, IBinop "i32.add", ILocalGet "$namlen", IBinop "i32.add", ILocalGet "$used", IBinop "i32.gt_s", IBrIf "$buf_done", IConstI32 wasiDir, ILocalGet "$off", IBinop "i32.add", IConstI32 24, IBinop "i32.add", ILocalGet "$namlen", ICall "$rt_memToStr", ILocalSet "$name", IConstI32 lf.wasmListConsTag, ILocalGet "$name", ILocalGet "$acc", IStructNew ty, ILocalSet "$acc", IConstI32 wasiDir, ILocalGet "$off", IBinop "i32.add", ILoad64, ILocalSet "$cookie", ILocalGet "$off", IConstI32 24, IBinop "i32.add", ILocalGet "$namlen", IBinop "i32.add", ILocalSet "$off", IConstI32 1, ILocalSet "$parsed", IBr "$buf_l"]], ILocalGet "$parsed", IConstI32 0, IBinop "i32.eq", IBrIf "$rd_done", IBr "$rd_l"]], ILocalGet "$fd", ICall "$fd_close", IDrop, ILocalGet "$acc"])
  in WatFunc "$rt_tryReadDir" "" [Pair "$p0" WvAnyRef] [WvAnyRef] locals body

genDefFunc : Int -> GenState -> IrDef -> Result (Pair (List WatFunc) GenState)
genDefFunc fuel st (IrExternDef name _ _ _) =
  Err "wasm target: extern definition `${name}` is not supported yet"
genDefFunc fuel st (IrDef name arity _deps body _recOk _initGuard _span) =
  if arity == 0 then Ok (Pair [] st) else genDefFuncBody fuel st name arity body

genDefFuncBody : Int -> GenState -> String -> Int -> Ir -> Result (Pair (List WatFunc) GenState)
genDefFuncBody fuel st name arity body =
  let
    savedLocals = st.gsLocals
    savedNext = st.gsNextLocal
    savedScope = st.gsScope
    st1 = beginFuncScope st
  in case body of
    IrLam bs inner => case runtimeBinders bs of
      rbs =>
        if listLengthB rbs /= arity then Err "wasm target: function body lambda arity mismatch: `${name}`"
        else genDefFuncGo fuel st1 name arity inner (zipIdx 0 rbs) savedLocals savedNext savedScope
    _ => Err "wasm target: function body is not a lambda: `${name}`"

genDefFuncGo : Int -> GenState -> String -> Int -> Ir -> List (Pair IrBinder String) -> List (Pair String WatValTy) -> Int -> List (Pair IrBinder String) -> Result (Pair (List WatFunc) GenState)
genDefFuncGo fuel st name arity inner paramScope savedLocals savedNext savedScope =
  let
    st1 = { st | gsScope = paramScope, gsTail = True }
  in case genExpr (fuel - 1) st1 inner of
    Err e => Err e
    Ok p =>
      let
        bodyState = secondOf p
        func =
          WatFunc (watFuncNameOf name) "" (funcParams arity) [WvAnyRef] bodyState.gsLocals
            (firstOf p)
        st2 = endFuncScope bodyState savedLocals savedNext savedScope
      in Ok (Pair [func] (withTail False st2))

genDefFuncs : Int -> GenState -> List IrDef -> Result (Pair (List WatFunc) GenState)
genDefFuncs fuel st [] = Ok (Pair [] st)
genDefFuncs fuel st (d :: rest) = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genDefFunc fuel st d of
  Err e => Err e
  Ok p => case genDefFuncs (fuel - 1) (secondOf p) rest of
    Err e => Err e
    Ok q => Ok (Pair (append (firstOf p) (firstOf q)) (secondOf q))

-- ---------------------------------------------------------------
-- 顶层初始化（`_start`）
-- ---------------------------------------------------------------
genDefInit : Int -> GenState -> IrDef -> Result (Pair (List Instr) GenState)
genDefInit fuel st (IrExternDef _ _ _ _) = Err "extern definition reached wasm codegen"
genDefInit fuel st (IrDef name arity _deps body _recOk _initGuard _span) = if arity /= 0 then Ok (Pair [] st)
else
  let
    st1 = restoreScope [] st
  in case genExpr (fuel - 1) st1 body of
    Err e => Err e
    Ok p => Ok (Pair (append (firstOf p) [IGlobalSet (watGlobalNameOf name)]) (secondOf p))

genDefsInits : Int -> GenState -> List IrDef -> Result (Pair (List Instr) GenState)
genDefsInits fuel st [] = Ok (Pair [] st)
genDefsInits fuel st (d :: rest) = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case genDefInit (fuel - 1) st d of
  Err e => Err e
  Ok p => case genDefsInits (fuel - 1) (secondOf p) rest of
    Err e => Err e
    Ok q => Ok (Pair (append (firstOf p) (firstOf q)) (secondOf q))

entryShowFunc : Ir -> Maybe String
entryShowFunc (IrRt s) = case s of
  "@ir@showInt" => Just "$rt_strFromInt"
  "@ir@showNat" => Just "$rt_strFromInt"
  "@ir@showBool" => Just "$rt_showBool"
  "@ir@showStr" => Just "$rt_showStr"
  "@ir@showFloat" => Just (watFuncNameOf floatRenderName)
  _ => Nothing
entryShowFunc _ = Nothing

genStartBody : Int -> GenState -> Maybe IrEntry -> Bool -> Result (Pair (List Instr) GenState)
genStartBody fuel st entry printResult = if fuel <= 0 then Err "wasm codegen fuel exhausted"
else case entry of
  Nothing => Ok (Pair [] st)
  Just e =>
    let
      st1 = beginFuncScope st
      runSeeds = case irEntryRunMainOf e of
        Just rm => if irEntryIsActionOf e then [rm] else []
        Nothing => []
      handlerSeeds = irEntryHandlersOf e
      ordered = reachableDefs (append [irEntryMainOf e] (append runSeeds handlerSeeds)) st1.gsDefs
      runInstrs = case irEntryRunMainOf e of
        Just rm => if irEntryIsActionOf e then [ICall (watFuncNameOf rm)] else []
        Nothing => []
      handlerInstrs = concatMap (\h => [ICall (watFuncNameOf h)]) handlerSeeds
      mainInstrs =
        append [IGlobalGet (watGlobalNameOf (irEntryMainOf e))] (append handlerInstrs runInstrs)
    in case genDefsInits (fuel - 1) st1 ordered of
      Err err => Err err
      Ok p => if not printResult then if irEntryIsActionOf e then Ok (Pair (append (firstOf p) (append mainInstrs [IDrop])) (secondOf p))
      else Ok p
      else case entryShowFunc (irEntryShowOf e) of
        Nothing => Err "wasm target: custom Show entry is not supported yet"
        Just showFn =>
          Ok
            (Pair (append (firstOf p) (append mainInstrs [ICall showFn, ICall "$rt_println"])) (secondOf p))

-- ---------------------------------------------------------------
-- 模块装配
-- ---------------------------------------------------------------
baseTypes : List WatType
baseTypes =
  [ WatFuncType "$ft" [WvAnyRef, WvAnyRef] [WvAnyRef],
    WatStructType "$clo" [WatField False (WvRef "$ft"), WatField False WvAnyRef],
    WatArrayType "$env" False WvAnyRef,
    WatStructType "$int" [WatField False WvI64],
    WatStructType "$float" [WatField False WvF64],
    WatArrayType "$str" True WvI8,
    WatArrayType "$arr" True WvAnyRef,
    WatFuncType "$cft" [WvAnyRef] [WvAnyRef],
    WatContType "$ct" "$cft",
    WatStructType "$effK" [WatField False (WvRef "$ct"), WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField False WvAnyRef, WatField True WvI32],
    WatStructType "$clean" [WatField False WvAnyRef, WatField False WvAnyRef]
  ]

baseTags : List WatTag
baseTags = [WatTag "$eff" [WvAnyRef] [WvAnyRef]]

baseImports : List WatImport
baseImports =
  [ WatImport "wasi_snapshot_preview1" "fd_write" "$fd_write" [WvI32, WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "fd_read" "$fd_read" [WvI32, WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "fd_close" "$fd_close" [WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "path_open" "$path_open" [WvI32, WvI32, WvI32, WvI32, WvI32, WvI64, WvI64, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "path_filestat_get" "$path_filestat_get" [WvI32, WvI32, WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "path_create_directory" "$path_create_directory" [WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "path_remove_directory" "$path_remove_directory" [WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "path_unlink_file" "$path_unlink_file" [WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "path_rename" "$path_rename" [WvI32, WvI32, WvI32, WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "path_symlink" "$path_symlink" [WvI32, WvI32, WvI32, WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "fd_readdir" "$fd_readdir" [WvI32, WvI32, WvI32, WvI64, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "environ_sizes_get" "$environ_sizes_get" [WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "environ_get" "$environ_get" [WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "args_sizes_get" "$args_sizes_get" [WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "args_get" "$args_get" [WvI32, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "clock_time_get" "$clock_time_get" [WvI32, WvI64, WvI32] [WvI32],
    WatImport "wasi_snapshot_preview1" "proc_exit" "$proc_exit" [WvI32] []
  ]

-- | 只有零参定义落成全局；函数由 `$f_<name>` 表示。
globalsOf : List IrDef -> List WatGlobal
globalsOf defs = concatMap globalOfDef defs

globalOfDef : IrDef -> List WatGlobal
globalOfDef d =
  if irDefArity d == 0 then [WatGlobal (watGlobalNameOf (irDefName d)) WvAnyRef [IRefNull]] else []

concatMapType : List WasmFam -> List WatType
concatMapType [] = []
concatMapType (f :: rest) = case wasmFamType f of
  Nothing => concatMapType rest
  Just t => t :: concatMapType rest

buildModule : Int -> GenState -> List IrDef -> Maybe IrEntry -> Bool -> Maybe WasmListFam -> Result WasmModule
buildModule fuel st ordered entry printResult listFamM = case genDefFuncs fuel st ordered of
  Err msg => Err msg
  Ok pf =>
    let
      userFuncs = firstOf pf
      stFuncs = secondOf pf
    in case genStartBody (fuel - 1) stFuncs entry printResult of
      Err msg => Err msg
      Ok p =>
        let
          startState = secondOf p
          startFunc = WatFunc "$_start" "" [] [] startState.gsLocals (firstOf p)
          lamFuncs = reverse startState.gsFuncs
          elemNames = append (reverse startState.gsElems) ["$rt_effThunk", "$rt_effResumeClo"]
          funcs =
            append (rtFunctions st.gsConsts)
              (append (wasmCompareFuncs st.gsConsts st.gsFams) (append (wasmBridgeFuncs listFamM) (append userFuncs (append lamFuncs [startFunc]))))
          famTypes = concatMapType st.gsFams
          allTypes = append baseTypes famTypes
          globals =
            append
              [WatGlobal "$g_cleanups" WvAnyRef [IRefNull], WatGlobal "$g_hostStatus" WvI32 [IConstI32 0]]
              (globalsOf ordered)
          dataText = poolBytes st.gsPool
          dataM = if strLength dataText == 0 then Nothing else Just (WatData "$d0" dataText)
        in Ok
          (WasmModule allTypes baseTags baseImports globals funcs elemNames dataM [WatExport "func" "_start" "$_start"] 4)

-- ---------------------------------------------------------------
-- 入口
-- ---------------------------------------------------------------
export build : IrProgram -> Bool -> WasmOutcome
build program printResult =
  let
    unit = irProgUnitOf program
    defs = concatMap irGroupDefs unit.irUnitGroups
    entry = unit.irUnitEntry
    fams = wasmFamsOf unit.irUnitTyDecls
    statics =
      [ "True",
        "False",
        "TODO: ",
        "division by zero",
        "vuna: runtime error: ",
        "assertion failed: ",
        "Invalid_argument(\"index out of bounds\")",
        "continuation already resumed",
        "wasm host operation is not implemented",
        ".tmp",
        "PWD",
        "."
      ]
    users = concatMap irStringsOfDef defs
    offsets = poolOf (append statics users)
    defTbl = Base.HashMap.fromList (map (\d => Pair (irDefName d) d) defs)
    famTbl = Base.HashMap.fromList (map (\f => Pair (famNameOf f) f) fams)
    poolTbl = Base.HashMap.fromList offsets
    consts = mkConsts poolTbl
    st0 = GenState fams famTbl defs defTbl offsets poolTbl [] [] 0 [] consts [] False 0
  in case entry of
    Nothing => WasmRejected (WasmUnsupported "wasm target: no main definition")
    Just e =>
      let
        runSeeds = case irEntryRunMainOf e of
          Just rm => if irEntryIsActionOf e then [rm] else []
          Nothing => []
        handlerSeeds = irEntryHandlersOf e
        ordered = case irEntryShowOf e of
          IrRt "@ir@showFloat" =>
            reachableDefs (append [irEntryMainOf e, floatRenderName] (append runSeeds handlerSeeds))
              defs
          _ => reachableDefs (append [irEntryMainOf e] (append runSeeds handlerSeeds)) defs
        listFamM = wasmListFamFromFams (irProgSharedOf program).irSharedListFam fams
      in case buildModule 100000 st0 ordered (Just e) printResult listFamM of
        Ok m => WasmOk m
        Err msg => WasmRejected (classifyWasmErr msg)

-- | `Show Float` 的实现（`Base.Float.floatRender`）；入口展示与用户 `show` 共用。
floatRenderName : String
floatRenderName = "Base.Float.floatRender"

famNameOf : WasmFam -> String
famNameOf f = f.wasmFamName

-- | 能力限制与内部错分开：`wasm target:` 前缀是显式拒绝，其余是生成器内部错。
classifyWasmErr : String -> WasmErr
classifyWasmErr msg =
  if startsWith "wasm target:" msg then WasmUnsupported msg else WasmInternal msg

foldlStrings : (a -> b -> a) -> a -> List b -> a
foldlStrings _ acc [] = acc
foldlStrings f acc (x :: rest) = foldlStrings f (f acc x) rest

mkConsts : HashMap String (Pair Int Int) -> RtConsts
mkConsts offsets =
  let
    offOf : String -> Int
    offOf s = case poolLookup s offsets of
      Just p => firstOf p
      Nothing => 0
    lenOf : String -> Int
    lenOf s = case poolLookup s offsets of
      Just p => secondOf p
      Nothing => 0
  in RtConsts (offOf "True") (lenOf "True") (offOf "False") (lenOf "False") (offOf "TODO: ")
    (lenOf "TODO: ") (offOf "division by zero") (lenOf "division by zero")
    (offOf "vuna: runtime error: ") (lenOf "vuna: runtime error: ") (offOf "assertion failed: ")
    (lenOf "assertion failed: ") (offOf "Invalid_argument(\"index out of bounds\")")
    (lenOf "Invalid_argument(\"index out of bounds\")") (offOf "continuation already resumed")
    (lenOf "continuation already resumed") (offOf "wasm host operation is not implemented")
    (lenOf "wasm host operation is not implemented") (offOf ".tmp") (lenOf ".tmp") (offOf "PWD")
    (lenOf "PWD") (offOf ".") (lenOf ".")

joinWith : String -> List String -> String
joinWith sep xs = Base.String.join sep xs
