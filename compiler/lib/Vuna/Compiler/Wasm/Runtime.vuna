module Vuna.Compiler.Wasm.Runtime where

-- Vuna.Compiler.Wasm.Runtime：运行时函数的 WAT 指令实现 + IR 符号表。
--
-- 产物只有 WAT；运行时按 `Ir.Runtime` 契约的符号名生成 WAT 函数。子集外的符号映射到
-- `RtUnsupported`，代码生成在引用点报 `WasmUnsupported`（编译期拒绝，不生成坏代码）。
--
-- 表示约定（与 Wasm.Module 一致）：
--   * Int/Nat 是 `(struct (field i64))`，box/unbox 由 `$int` 完成；63-bit 语义。
--   * String 是 `(array (mut i8))`；静态字节在 `$d0` passive data segment。
--   * Bool 是 `i31`；Array 是 `(array (mut anyref))`。
--   * 闭包 `$clo` = { code: (ref $ft), env: anyref }；`$ft` 是 (env, arg) -> anyref。
import Base.Bool
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.String
import Vuna.Compiler.Wasm.Instr
import Vuna.Compiler.Wasm.Model

-- ---------------------------------------------------------------
-- 常量字符串在 `$d0` 里的位置（由 Wasm.Module 计算）
-- ---------------------------------------------------------------
export record RtConsts(..) where
  rtcTrueOff : Int
  rtcTrueLen : Int
  rtcFalseOff : Int
  rtcFalseLen : Int
  rtcTodoOff : Int
  rtcTodoLen : Int
  rtcDivOff : Int
  rtcDivLen : Int
  -- 运行时错误报告器的统一前缀 / 断言前缀（与 OCaml 的 `dt_report_exn` 对齐）。
  rtcErrOff : Int
  rtcErrLen : Int
  rtcAssertOff : Int
  rtcAssertLen : Int
  -- | 数组越界（与 OCaml `Invalid_argument ("index out of bounds")` 的首行一致）。
  rtcOobOff : Int
  rtcOobLen : Int

-- | 运行时符号的实现形态。
export data RtImpl(..) : Type where
  -- | 0 元值：直接把这些指令插到引用点。
  RtValue : List Instr -> RtImpl
  -- | n 元函数：名字 + arity。
  RtFunc : Int -> String -> RtImpl
  -- | 本后端未实现的契约符号：引用点报 `WasmUnsupported`（带符号名）。
  RtUnsupported : RtImpl

-- ---------------------------------------------------------------
-- 指令拼装 helper
-- ---------------------------------------------------------------
cat : List (List Instr) -> List Instr
cat xs = concatMap (\x => x) xs

localP : Int -> String
localP i = "$p${strFromInt i}"

rtFunc : String -> List (Pair String WatValTy) -> List WatValTy -> List (Pair String WatValTy) -> List Instr -> WatFunc
rtFunc name params results locals body = WatFunc name "" params results locals body

rtApply : WatFunc
rtApply =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$code" (WvRef "$ft"), Pair "$env" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "$clo",
        IStructGet "$clo" 0,
        ILocalSet "$code",
        ILocalGet "$p0",
        IRefCast "$clo",
        IStructGet "$clo" 1,
        ILocalSet "$env",
        ILocalGet "$env",
        ILocalGet "$p1",
        ILocalGet "$code",
        ICallRef "$ft"
      ]
  in rtFunc "$rt_apply" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- 数值/布尔 helper
-- ---------------------------------------------------------------
unboxInt : Int -> List Instr
unboxInt i = [ILocalGet (localP i), IRefCast "$int", IStructGet "$int" 0]

boxInt : List Instr
boxInt = [IStructNew "$int"]

wrap63 : List Instr
wrap63 = [IConstI64 1, IBinop "i64.shl", IConstI64 1, IBinop "i64.shr_s"]

binInt : String -> String -> WatFunc
binInt name op =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body = cat [unboxInt 0, unboxInt 1, [IBinop op], wrap63, boxInt]
  in rtFunc name params [WvAnyRef] [] body

cmpInt : String -> String -> WatFunc
cmpInt name op =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body = cat [unboxInt 0, unboxInt 1, [IBinop op, II31New]]
  in rtFunc name params [WvAnyRef] [] body

binBool : String -> String -> WatFunc
binBool name op =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "i31",
        II31GetU,
        ILocalGet "$p1",
        IRefCast "i31",
        II31GetU,
        IBinop op,
        II31New
      ]
  in rtFunc name params [WvAnyRef] [] body

boolValue : Bool -> List Instr
boolValue b = [IConstI32 (if b then 1 else 0), II31New]

-- ---------------------------------------------------------------
-- 字符串/输出 helper
-- ---------------------------------------------------------------
dataSegmentName : String
dataSegmentName = "$d0"

mkString : Int -> Int -> List Instr
mkString off len = [IConstI32 off, IConstI32 len, IArrayNewData "$str" dataSegmentName]

-- | `rt_write(fd, s, nl)`：把字符串复制到线性内存并 write；只用于输出/错误。
rtWrite : WatFunc
rtWrite =
  let
    params = [Pair "$fd" WvI32, Pair "$s" WvAnyRef, Pair "$nl" WvI32]
    locals = [Pair "$n" WvI32, Pair "$i" WvI32]
    copyLoop =
      [ IConstI32 0,
        ILocalSet "$i",
        IBlock "$done" "" [ILoop "$l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_u", IBrIf "$done", IConstI32 16, ILocalGet "$i", IBinop "i32.add", ILocalGet "$s", IRefCast "$str", ILocalGet "$i", IArrayGetU "$str", IStore8, ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$l"]]
      ]
    setNewline =
      [ ILocalGet "$nl",
        IIf "" [IConstI32 16, ILocalGet "$n", IBinop "i32.add", IConstI32 10, IStore8] []
      ]
    iovec =
      [ IConstI32 0,
        IConstI32 16,
        IStore32,
        IConstI32 4,
        ILocalGet "$n",
        ILocalGet "$nl",
        IBinop "i32.add",
        IStore32,
        ILocalGet "$fd",
        IConstI32 0,
        IConstI32 1,
        IConstI32 8,
        ICall "$fd_write",
        IDrop
      ]
    body =
      cat
        [[ILocalGet "$s", IRefCast "$str", IArrayLen, ILocalSet "$n"], copyLoop, setNewline, iovec]
  in rtFunc "$rt_write" params [] locals body

rtPrintln : WatFunc
rtPrintln =
  let
    params = [Pair "$p0" WvAnyRef]
    body = [IConstI32 1, ILocalGet "$p0", IConstI32 1, ICall "$rt_write"]
  in rtFunc "$rt_println" params [] [] body

rtFailStr : RtConsts -> WatFunc
-- 统一前缀 `vuna: runtime error: ` + msg
-- 写 stderr（rt_write 的 nl=1 补换行）
rtFailStr c =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$m" WvAnyRef]
    body =
      cat
        [mkString c.rtcErrOff c.rtcErrLen, [ILocalGet "$p0", ICall "$rt_strConcat", ILocalSet "$m"], [IConstI32 2, ILocalGet "$m", IConstI32 1, ICall "$rt_write"], [IConstI32 2, ICall "$proc_exit", IUnreachable]]
  in rtFunc "$rt_failStr" params [] locals body

-- | 数组越界：固定文本 + exit 2（wasm 没有位置表，因此没有 OCaml 报告器的 `at` 行）。
rtArrayOob : RtConsts -> WatFunc
rtArrayOob c =
  rtFunc "$rt_arrayOob" [] [] []
    (append (failWithConst c.rtcOobOff c.rtcOobLen) [ICall "$rt_failStr", IUnreachable])

-- ---------------------------------------------------------------
-- 效应原语（宿主层叶子 + IORef）
-- ---------------------------------------------------------------
-- `Eff` 的运行时壳是 base 的 `MkEff` data；这些原语只负责「做一次宿主操作」。
-- 续延（`prim_effectPerform` / `prim_effectHandle`）需要栈捕获，仍不支持。
rtEffNewRef : WatFunc
rtEffNewRef =
  rtFunc "$rt_newRef" [Pair "$p0" WvAnyRef] [WvAnyRef] [Pair "$out" (WvRef "$arr")]
    [IConstI32 1, IArrayNewDefault "$arr", ILocalSet "$out", ILocalGet "$out", IConstI32 0, ILocalGet "$p0", IArraySet "$arr", ILocalGet "$out"]

rtEffReadRef : WatFunc
rtEffReadRef =
  rtFunc "$rt_readRef" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$arr", IConstI32 0, IArrayGet "$arr"]

rtEffWriteRef : WatFunc
rtEffWriteRef =
  rtFunc "$rt_writeRef" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$arr", IConstI32 0, ILocalGet "$p1", IArraySet "$arr", IConstI64 0, IStructNew "$int"]

-- | `print` / `eprint`：写 fd 后返回写出的字节数（与 OCaml 的 `String.length` 一致）。
rtEffPrint : String -> Int -> WatFunc
rtEffPrint name fd =
  rtFunc name [Pair "$p0" WvAnyRef] [WvAnyRef] [Pair "$n" WvI32]
    [IConstI32 fd, ILocalGet "$p0", IConstI32 0, ICall "$rt_write", ILocalGet "$p0", IRefCast "$str", IArrayLen, ILocalSet "$n", ILocalGet "$n", IPlain "i64.extend_i32_u", IStructNew "$int"]

rtEffExit : WatFunc
rtEffExit =
  rtFunc "$rt_effExit" [Pair "$p0" WvAnyRef] [] []
    [ILocalGet "$p0", IRefCast "$int", IStructGet "$int" 0, IPlain "i32.wrap_i64", ICall "$proc_exit", IUnreachable]

-- ---------------------------------------------------------------
-- 浮点（IEEE-754 double）
-- ---------------------------------------------------------------
-- 表示沿用 `$float` struct：boxed f64；比较指令本身按 IEEE 语义处理 NaN。
rtFloatFromInt : WatFunc
rtFloatFromInt =
  rtFunc "$rt_floatFromInt" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$int", IStructGet "$int" 0, IPlain "f64.convert_i64_s", IStructNew "$float"]

rtIntFromFloat : WatFunc
rtIntFromFloat =
  rtFunc "$rt_intFromFloat" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$float", IStructGet "$float" 0, IPlain "i64.trunc_f64_s", IStructNew "$int"]

rtFloatBin : String -> String -> WatFunc
rtFloatBin name op =
  rtFunc name [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$float", IStructGet "$float" 0, ILocalGet "$p1", IRefCast "$float", IStructGet "$float" 0, IPlain op, IStructNew "$float"]

rtFloatCmp : String -> String -> WatFunc
rtFloatCmp name op =
  rtFunc name [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$float", IStructGet "$float" 0, ILocalGet "$p1", IRefCast "$float", IStructGet "$float" 0, IPlain op, II31New]

rtFloatAbs : WatFunc
rtFloatAbs =
  rtFunc "$rt_floatAbs" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$float", IStructGet "$float" 0, IPlain "f64.abs", IStructNew "$float"]

rtFloatSqrt : WatFunc
rtFloatSqrt =
  rtFunc "$rt_floatSqrt" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$float", IStructGet "$float" 0, IPlain "f64.sqrt", IStructNew "$float"]

-- ---------------------------------------------------------------
-- 数组（不可变、copy-on-write）
-- ---------------------------------------------------------------
-- 表示沿用 `$arr`（`anyref` 数组）：`array.len` 是长度，元素是任意运行时值。
-- `arraySet` 先整块复制再写，原数组不变；越界读/写走 `$rt_arrayOob`。
rtArrayLength : WatFunc
rtArrayLength =
  rtFunc "$rt_arrayLength" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefCast "$arr", IArrayLen, IPlain "i64.extend_i32_u", IStructNew "$int"]

rtArrayGet : WatFunc
rtArrayGet =
  let
    locals = [Pair "$ix" WvI32]
    oob = [ICall "$rt_arrayOob", IUnreachable]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$arr", IArrayLen, ILocalSet "$ix"], unboxInt 1, [IPlain "i32.wrap_i64", ILocalSet "$ix"], [ILocalGet "$ix", IConstI32 0, IBinop "i32.lt_s", IIf "" oob [], ILocalGet "$ix", ILocalGet "$p0", IRefCast "$arr", IArrayLen, IBinop "i32.ge_s", IIf "" oob [], ILocalGet "$p0", IRefCast "$arr", ILocalGet "$ix", IArrayGet "$arr"]]
  in rtFunc "$rt_arrayGet" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] locals body

rtArraySet : WatFunc
rtArraySet =
  let
    locals = [Pair "$ix" WvI32, Pair "$n" WvI32, Pair "$new" (WvRef "$arr")]
    oob = [ICall "$rt_arrayOob", IUnreachable]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$arr", IArrayLen, ILocalSet "$n"], unboxInt 1, [IPlain "i32.wrap_i64", ILocalSet "$ix"], [ILocalGet "$ix", IConstI32 0, IBinop "i32.lt_s", IIf "" oob [], ILocalGet "$ix", ILocalGet "$n", IBinop "i32.ge_s", IIf "" oob [], ILocalGet "$n", IArrayNewDefault "$arr", ILocalSet "$new", ILocalGet "$new", IConstI32 0, ILocalGet "$p0", IRefCast "$arr", IConstI32 0, ILocalGet "$n", IArrayCopy "$arr" "$arr", ILocalGet "$new", ILocalGet "$ix", ILocalGet "$p2", IArraySet "$arr", ILocalGet "$new"]]
  in rtFunc "$rt_arraySet" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef] [WvAnyRef]
    locals body

rtArrayMake : WatFunc
rtArrayMake =
  let
    locals = [Pair "$n" WvI32, Pair "$out" (WvRef "$arr"), Pair "$i" WvI32]
    body =
      cat
        [unboxInt 0, [IPlain "i32.wrap_i64", ILocalSet "$n", ILocalGet "$n", IArrayNewDefault "$arr", ILocalSet "$out", IConstI32 0, ILocalSet "$i"], [IBlock "$am_done" "" [ILoop "$am_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_s", IBrIf "$am_done", ILocalGet "$out", ILocalGet "$i", ILocalGet "$p1", IArraySet "$arr", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$am_l"]]], [ILocalGet "$out"]]
  in rtFunc "$rt_arrayMake" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] locals body

-- | `strFromInt` / `showInt` / `showNat`。
rtStrFromInt : WatFunc
rtStrFromInt =
  let
    params = [Pair "$p0" WvAnyRef]
    locals =
      [ Pair "$n" WvI64,
        Pair "$neg" WvI32,
        Pair "$m" WvI64,
        Pair "$tmp" WvI64,
        Pair "$digits" WvI32,
        Pair "$len" WvI32,
        Pair "$out" (WvRef "$str"),
        Pair "$i" WvI32,
        Pair "$d" WvI64
      ]
    signPart =
      [ ILocalGet "$n",
        IConstI64 0,
        IBinop "i64.lt_s",
        IIf "" [IConstI32 1, ILocalSet "$neg", IConstI64 0, ILocalGet "$n", IBinop "i64.sub", ILocalSet "$m"] [IConstI32 0, ILocalSet "$neg", ILocalGet "$n", ILocalSet "$m"]
      ]
    digitsPart =
      [ IConstI32 1,
        ILocalSet "$digits",
        ILocalGet "$m",
        ILocalSet "$tmp",
        IBlock "$digits_done" "" [ILoop "$digits_l" "" [ILocalGet "$tmp", IConstI64 10, IBinop "i64.lt_u", IBrIf "$digits_done", ILocalGet "$tmp", IConstI64 10, IBinop "i64.div_u", ILocalSet "$tmp", ILocalGet "$digits", IConstI32 1, IBinop "i32.add", ILocalSet "$digits", IBr "$digits_l"]]
      ]
    allocPart =
      [ ILocalGet "$digits",
        ILocalGet "$neg",
        IBinop "i32.add",
        ILocalSet "$len",
        ILocalGet "$len",
        IArrayNewDefault "$str",
        ILocalSet "$out",
        ILocalGet "$len",
        IConstI32 1,
        IBinop "i32.sub",
        ILocalSet "$i"
      ]
    signOut =
      [ILocalGet "$neg", IIf "" [ILocalGet "$out", IConstI32 0, IConstI32 45, IArraySet "$str"] []]
    fillPart =
      [ IBlock "$fill_done" "" [ILoop "$fill_l" "" [ILocalGet "$m", IConstI64 10, IBinop "i64.rem_u", ILocalSet "$d", ILocalGet "$out", ILocalGet "$i", ILocalGet "$d", IPlain "i32.wrap_i64", IConstI32 48, IBinop "i32.add", IArraySet "$str", ILocalGet "$i", IConstI32 1, IBinop "i32.sub", ILocalSet "$i", ILocalGet "$m", IConstI64 10, IBinop "i64.div_u", ILocalSet "$m", ILocalGet "$m", IConstI64 0, IBinop "i64.gt_u", IBrIf "$fill_l"]]
      ]
    body =
      cat
        [unboxInt 0, [ILocalSet "$n"], signPart, digitsPart, allocPart, signOut, fillPart, [ILocalGet "$out"]]
  in rtFunc "$rt_strFromInt" params [WvAnyRef] locals body

rtShowInt : WatFunc
rtShowInt = rtStrFromInt

rtShowBool : RtConsts -> WatFunc
rtShowBool c =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        IRefCast "i31",
        II31GetU,
        IIf "anyref" (mkString c.rtcTrueOff c.rtcTrueLen) (mkString c.rtcFalseOff c.rtcFalseLen)
      ]
  in rtFunc "$rt_showBool" params [WvAnyRef] [] body

-- | 单字节转义判定：置 `$esc`，并把需要改写字符的 `$c` 换成转义后的可见字符。
-- 与 OCaml 的 `dt_show_string` 逐条对齐：`"`、`\`、换行、制表、回车。
escapePair : Int -> Int -> List Instr
escapePair code mapped =
  [ ILocalGet "$c",
    IConstI32 code,
    IBinop "i32.eq",
    IIf "" [IConstI32 1, ILocalSet "$esc", IConstI32 mapped, ILocalSet "$c"] []
  ]

escapeStepAll : List Instr
escapeStepAll =
  cat
    [[IConstI32 0, ILocalSet "$esc"], escapePair 34 34, escapePair 92 92, escapePair 10 110, escapePair 9 116, escapePair 13 114]

-- | `showStr`：`"` 包裹，按 `dt_show_string` 转义。两遍扫描：先算转义后的长度再填充，
-- 避免预先分配过多、尾部未用字节被 `array.len` 当成内容。
rtShowStr : WatFunc
rtShowStr =
  let
    params = [Pair "$p0" WvAnyRef]
    locals =
      [ Pair "$src" (WvRef "$str"),
        Pair "$n" WvI32,
        Pair "$len" WvI32,
        Pair "$i" WvI32,
        Pair "$o" WvI32,
        Pair "$c" WvI32,
        Pair "$esc" WvI32,
        Pair "$out" (WvRef "$str")
      ]
    loadChar = [ILocalGet "$src", ILocalGet "$i", IArrayGetU "$str", ILocalSet "$c"]
    bumpLen =
      [ ILocalGet "$len",
        ILocalGet "$esc",
        IIf "i32" [IConstI32 2] [IConstI32 1],
        IBinop "i32.add",
        ILocalSet "$len"
      ]
    bumpIdx = [ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i"]
    lengthCond = [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_u", IBrIf "$ss_len_done"]
    lengthStep = append (cat [loadChar, escapeStepAll, bumpLen, bumpIdx]) [IBr "$ss_len_l"]
    lengthLoop = [IBlock "$ss_len_done" "" [ILoop "$ss_len_l" "" (append lengthCond lengthStep)]]
    writeEsc = [ILocalGet "$out", ILocalGet "$o", IConstI32 92, IArraySet "$str"]
    bumpOut = [ILocalGet "$o", IConstI32 1, IBinop "i32.add", ILocalSet "$o"]
    writeChar = [ILocalGet "$out", ILocalGet "$o", ILocalGet "$c", IArraySet "$str"]
    fillCond = [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_u", IBrIf "$ss_fill_done"]
    fillStep =
      append
        (cat [loadChar, escapeStepAll, [ILocalGet "$esc", IIf "" (append writeEsc bumpOut) []], writeChar, bumpOut, bumpIdx])
        [IBr "$ss_fill_l"]
    fillLoop = [IBlock "$ss_fill_done" "" [ILoop "$ss_fill_l" "" (append fillCond fillStep)]]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$src", ILocalGet "$src", IArrayLen, ILocalSet "$n", IConstI32 2, ILocalSet "$len", IConstI32 0, ILocalSet "$i"], lengthLoop, [ILocalGet "$len", IArrayNewDefault "$str", ILocalSet "$out"], [ILocalGet "$out", IConstI32 0, IConstI32 34, IArraySet "$str", IConstI32 0, ILocalSet "$i", IConstI32 1, ILocalSet "$o"], fillLoop, [ILocalGet "$out", ILocalGet "$o", IConstI32 34, IArraySet "$str", ILocalGet "$out"]]
  in rtFunc "$rt_showStr" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- 除法/失败辅助
-- ---------------------------------------------------------------
failWithConst : Int -> Int -> List Instr
failWithConst off len = cat [mkString off len, [ICall "$rt_failStr", IUnreachable]]

rtDiv : RtConsts -> WatFunc
rtDiv c =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$b", IConstI64 0, IBinop "i64.eq", IIf "i64" (failWithConst c.rtcDivOff c.rtcDivLen) [ILocalGet "$a", IConstI64 (0 - 4611686018427387903 - 1), IBinop "i64.eq", ILocalGet "$b", IConstI64 (0 - 1), IBinop "i64.eq", IBinop "i32.and", IIf "i64" [IConstI64 (0 - 4611686018427387903 - 1)] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.div_s"]]], boxInt]
  in rtFunc "$rt_div" params [WvAnyRef] locals body

rtAssert : RtConsts -> WatFunc
rtAssert c =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef]
    locals = [Pair "$m" WvAnyRef]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "i31", II31GetU], [IIf "anyref" [ILocalGet "$p2"] (cat [mkString c.rtcAssertOff c.rtcAssertLen, [ILocalGet "$p1", ICall "$rt_strConcat", ILocalSet "$m"], [ILocalGet "$m", ICall "$rt_failStr", IUnreachable]])]]
  in rtFunc "$rt_assert" params [WvAnyRef] locals body

rtPrimFail : WatFunc
rtPrimFail =
  let
    params = [Pair "$p0" WvAnyRef]
    body = [ILocalGet "$p0", ICall "$rt_failStr", IUnreachable]
  in rtFunc "$rt_primFail" params [WvAnyRef] [] body

rtTodo : RtConsts -> WatFunc
rtTodo c =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      cat
        [mkString c.rtcTodoOff c.rtcTodoLen, [ILocalGet "$p0"], [ICall "$rt_strConcat"], [ICall "$rt_failStr", IUnreachable]]
  in rtFunc "$rt_todo" params [WvAnyRef] [] body

rtErase : WatFunc
rtErase =
  let
    params = [Pair "$p0" WvAnyRef]
  in rtFunc "$rt_erase" params [WvAnyRef] [] [ILocalGet "$p0"]

rtStrConcat : WatFunc
rtStrConcat =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals =
      [ Pair "$a" (WvRef "$str"),
        Pair "$b" (WvRef "$str"),
        Pair "$na" WvI32,
        Pair "$nb" WvI32,
        Pair "$out" (WvRef "$str")
      ]
    body =
      [ ILocalGet "$p0",
        IRefCast "$str",
        ILocalSet "$a",
        ILocalGet "$p1",
        IRefCast "$str",
        ILocalSet "$b",
        ILocalGet "$a",
        IArrayLen,
        ILocalSet "$na",
        ILocalGet "$b",
        IArrayLen,
        ILocalSet "$nb",
        ILocalGet "$na",
        ILocalGet "$nb",
        IBinop "i32.add",
        IArrayNewDefault "$str",
        ILocalSet "$out",
        ILocalGet "$out",
        IConstI32 0,
        ILocalGet "$a",
        IConstI32 0,
        ILocalGet "$na",
        IArrayCopy "$str" "$str",
        ILocalGet "$out",
        ILocalGet "$na",
        ILocalGet "$b",
        IConstI32 0,
        ILocalGet "$nb",
        IArrayCopy "$str" "$str",
        ILocalGet "$out"
      ]
  in rtFunc "$rt_strConcat" params [WvAnyRef] locals body

rtNatSucc : WatFunc
rtNatSucc =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$n"], [ILocalGet "$n", IConstI64 4611686018427387903, IBinop "i64.ge_s", IIf "i64" [IConstI64 4611686018427387903] [ILocalGet "$n", IConstI64 1, IBinop "i64.add"]], boxInt]
  in rtFunc "$rt_natSucc" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- Nat 原语（饱和语义，参考 `Codegen.Term` 的 `bi_nat*`）
-- ---------------------------------------------------------------
maxInt63 : Int
maxInt63 = 4611686018427387903

rtNatAdd : WatFunc
rtNatAdd =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$a", IConstI64 maxInt63, ILocalGet "$b", IBinop "i64.sub", IBinop "i64.gt_s", IIf "i64" [IConstI64 maxInt63] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.add"]], boxInt]
  in rtFunc "$rt_natAdd" params [WvAnyRef] locals body

rtNatSub : WatFunc
rtNatSub =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$a", ILocalGet "$b", IBinop "i64.le_s", IIf "i64" [IConstI64 0] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.sub"]], boxInt]
  in rtFunc "$rt_natSub" params [WvAnyRef] locals body

rtNatMul : WatFunc
rtNatMul =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    inner =
      [ ILocalGet "$a",
        IConstI64 maxInt63,
        ILocalGet "$b",
        IBinop "i64.div_s",
        IBinop "i64.gt_s",
        IIf "i64" [IConstI64 maxInt63] [ILocalGet "$a", ILocalGet "$b", IBinop "i64.mul"]
      ]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$a", IConstI64 0, IBinop "i64.le_s", ILocalGet "$b", IConstI64 0, IBinop "i64.le_s", IBinop "i32.or", IIf "i64" [IConstI64 0] inner], boxInt]
  in rtFunc "$rt_natMul" params [WvAnyRef] locals body

rtNatDiv : RtConsts -> WatFunc
rtNatDiv c =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$b" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$b"], [ILocalGet "$b", IConstI64 0, IBinop "i64.eq", IIf "i64" (failWithConst c.rtcDivOff c.rtcDivLen) [ILocalGet "$a", ILocalGet "$b", IBinop "i64.div_s"]], boxInt]
  in rtFunc "$rt_natDiv" params [WvAnyRef] locals body

-- | `natToInt`：无损提升，表示上恒等。
rtNatToInt : WatFunc
rtNatToInt =
  let
    params = [Pair "$p0" WvAnyRef]
  in rtFunc "$rt_natToInt" params [WvAnyRef] [] [ILocalGet "$p0"]

-- | `natFromInt`：有损，负数钳成 0。
rtNatFromInt : WatFunc
rtNatFromInt =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$n"], [ILocalGet "$n", IConstI64 0, IBinop "i64.le_s", IIf "i64" [IConstI64 0] [ILocalGet "$n"]], boxInt]
  in rtFunc "$rt_natFromInt" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- String 原语（参考 `Codegen.Term` 的 `bi_strLength` / `dtp_str*`）
-- ---------------------------------------------------------------
rtStrLength : WatFunc
rtStrLength =
  let
    params = [Pair "$p0" WvAnyRef]
    body =
      [ILocalGet "$p0", IRefCast "$str", IArrayLen, IPlain "i64.extend_i32_s", IStructNew "$int"]
  in rtFunc "$rt_strLength" params [WvAnyRef] [] body

-- | `strAt`：越界返回 `-1`（对齐 OCaml 的 `dtp_strAt` 哨兵）。
rtStrAt : WatFunc
rtStrAt =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$s" (WvRef "$str"), Pair "$n" WvI32, Pair "$i" WvI64]
    outOfRange =
      [ ILocalGet "$i",
        IConstI64 0,
        IBinop "i64.lt_s",
        ILocalGet "$i",
        ILocalGet "$n",
        IPlain "i64.extend_i32_s",
        IBinop "i64.ge_s",
        IBinop "i32.or"
      ]
    inRange =
      [ ILocalGet "$s",
        ILocalGet "$i",
        IPlain "i32.wrap_i64",
        IArrayGetU "$str",
        IPlain "i64.extend_i32_s"
      ]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$s", ILocalGet "$s", IArrayLen, ILocalSet "$n"], unboxInt 1, [ILocalSet "$i"], outOfRange, [IIf "i64" [IConstI64 (0 - 1)] inRange], boxInt]
  in rtFunc "$rt_strAt" params [WvAnyRef] locals body

-- | `strSubstring(start, len, s)`：参数序与 `Intrinsics` 的类型一致（start, len, s）。
rtSubstring : WatFunc
rtSubstring =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef]
    locals =
      [ Pair "$s" (WvRef "$str"),
        Pair "$n" WvI32,
        Pair "$st" WvI32,
        Pair "$ln" WvI32,
        Pair "$start" WvI64,
        Pair "$len" WvI64,
        Pair "$out" (WvRef "$str")
      ]
    clampStart =
      [ ILocalGet "$start",
        IConstI64 0,
        IBinop "i64.lt_s",
        IIf "i32" [IConstI32 0] [ILocalGet "$start", ILocalGet "$n", IPlain "i64.extend_i32_s", IBinop "i64.gt_s", IIf "i32" [ILocalGet "$n"] [ILocalGet "$start", IPlain "i32.wrap_i64"]]
      ]
    clampLen =
      [ ILocalGet "$len",
        IConstI64 0,
        IBinop "i64.lt_s",
        IIf "i32" [IConstI32 0] [ILocalGet "$st", ILocalGet "$len", IPlain "i32.wrap_i64", IBinop "i32.add", ILocalGet "$n", IBinop "i32.gt_u", IIf "i32" [ILocalGet "$n", ILocalGet "$st", IBinop "i32.sub"] [ILocalGet "$len", IPlain "i32.wrap_i64"]]
      ]
    body =
      cat
        [[ILocalGet "$p2", IRefCast "$str", ILocalSet "$s", ILocalGet "$s", IArrayLen, ILocalSet "$n"], unboxInt 0, [ILocalSet "$start"], unboxInt 1, [ILocalSet "$len"], clampStart, [ILocalSet "$st"], clampLen, [ILocalSet "$ln"], [ILocalGet "$ln", IArrayNewDefault "$str", ILocalSet "$out"], [ILocalGet "$out", IConstI32 0, ILocalGet "$s", ILocalGet "$st", ILocalGet "$ln", IArrayCopy "$str" "$str"], [ILocalGet "$out"]]
  in rtFunc "$rt_substring" params [WvAnyRef] locals body

-- | `strHash`：`(h * 33 + byte) land 1023`，与 OCaml 的 `dtp_strHash` 逐字一致。
rtStrHash : WatFunc
rtStrHash =
  let
    params = [Pair "$p0" WvAnyRef]
    locals = [Pair "$s" (WvRef "$str"), Pair "$n" WvI32, Pair "$i" WvI32, Pair "$h" WvI64]
    loop =
      [ IBlock "$hash_done" "" [ILoop "$hash_l" "" [ILocalGet "$i", ILocalGet "$n", IBinop "i32.ge_u", IBrIf "$hash_done", ILocalGet "$h", IConstI64 33, IBinop "i64.mul", ILocalGet "$s", ILocalGet "$i", IArrayGetU "$str", IPlain "i64.extend_i32_u", IBinop "i64.add", IConstI64 1023, IBinop "i64.and", ILocalSet "$h", ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$hash_l"]]
      ]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$s", ILocalGet "$s", IArrayLen, ILocalSet "$n", IConstI32 0, ILocalSet "$i", IConstI64 0, ILocalSet "$h"], loop, [ILocalGet "$h"], boxInt]
  in rtFunc "$rt_strHash" params [WvAnyRef] locals body

-- | 字符串相等：先比长度，再逐字节短路比较（`bi_eq_str`）。
rtEqStr : WatFunc
rtEqStr =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals =
      [ Pair "$a" (WvRef "$str"),
        Pair "$b" (WvRef "$str"),
        Pair "$na" WvI32,
        Pair "$i" WvI32,
        Pair "$eq" WvI32
      ]
    loop =
      [ IBlock "$eq_done" "" [ILoop "$eq_l" "" [ILocalGet "$i", ILocalGet "$na", IBinop "i32.ge_u", IBrIf "$eq_done", ILocalGet "$a", ILocalGet "$i", IArrayGetU "$str", ILocalGet "$b", ILocalGet "$i", IArrayGetU "$str", IBinop "i32.ne", IIf "" [IConstI32 0, ILocalSet "$eq", IBr "$eq_done"] [], ILocalGet "$i", IConstI32 1, IBinop "i32.add", ILocalSet "$i", IBr "$eq_l"]]
      ]
    lenCheck =
      [ IBlock "$len_done" "" [ILocalGet "$a", IArrayLen, ILocalSet "$na", ILocalGet "$na", ILocalGet "$b", IArrayLen, IBinop "i32.ne", IIf "" [IConstI32 0, ILocalSet "$eq", IBr "$len_done"] []]
      ]
    body =
      cat
        [[ILocalGet "$p0", IRefCast "$str", ILocalSet "$a", ILocalGet "$p1", IRefCast "$str", ILocalSet "$b", IConstI32 1, ILocalSet "$eq", IConstI32 0, ILocalSet "$i"], lenCheck, loop, [ILocalGet "$eq", II31New]]
  in rtFunc "$rt_eqStr" params [WvAnyRef] locals body

-- | 字符串不等：复用 `$rt_eqStr` 再取反（`bi_neq_str`）。
rtNeqStr : WatFunc
rtNeqStr =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    body =
      [ ILocalGet "$p0",
        ILocalGet "$p1",
        ICall "$rt_eqStr",
        IRefCast "i31",
        II31GetU,
        IConstI32 1,
        IBinop "i32.xor",
        II31New
      ]
  in rtFunc "$rt_neqStr" params [WvAnyRef] [] body

rtBoxZero : WatFunc
rtBoxZero =
  let
    params = [Pair "$p0" WvAnyRef]
  in rtFunc "$rt_boxZero" params [WvAnyRef] [] [IConstI64 0, IStructNew "$int"]

rtBoxZero2 : WatFunc
rtBoxZero2 =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
  in rtFunc "$rt_boxZero2" params [WvAnyRef] [] [IConstI64 0, IStructNew "$int"]

rtBitNot : WatFunc
rtBitNot =
  let
    params = [Pair "$p0" WvAnyRef]
    body = cat [unboxInt 0, [IConstI64 (0 - 1), IBinop "i64.xor"], wrap63, boxInt]
  in rtFunc "$rt_bitNot" params [WvAnyRef] [] body

shiftCountOk : List Instr
shiftCountOk =
  [ ILocalGet "$n",
    IConstI64 0,
    IBinop "i64.lt_s",
    ILocalGet "$n",
    IConstI64 63,
    IBinop "i64.ge_s",
    IBinop "i32.or"
  ]

rtBitShl : WatFunc
rtBitShl =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$n"], shiftCountOk, [IIf "i64" [IConstI64 0] (cat [[ILocalGet "$a", ILocalGet "$n", IBinop "i64.shl"], wrap63])], boxInt]
  in rtFunc "$rt_bitShl" params [WvAnyRef] locals body

rtBitShr : WatFunc
rtBitShr =
  let
    params = [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef]
    locals = [Pair "$a" WvI64, Pair "$n" WvI64]
    body =
      cat
        [unboxInt 0, [ILocalSet "$a"], unboxInt 1, [ILocalSet "$n"], shiftCountOk, [IIf "i64" [IConstI64 0] [ILocalGet "$a", IConstI64 1, IBinop "i64.shl", IConstI64 1, IBinop "i64.shr_u", ILocalGet "$n", IBinop "i64.shr_u"]], boxInt]
  in rtFunc "$rt_bitShr" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- 效应 handler（stack switching）
-- ---------------------------------------------------------------
-- 泛型 tag `$eff` 的 payload 是 `$arr [key, name, op]`；`suspend` 的 result 是 resume
-- 时交回的值。comp thunk 的 continuation 类型是 `$cft = (anyref) -> anyref`。
rtEffPerform : WatFunc
rtEffPerform =
  rtFunc "$rt_effPerform" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef, Pair "$p2" WvAnyRef] [WvAnyRef]
    []
    [ILocalGet "$p0", ILocalGet "$p1", ILocalGet "$p2", IArrayNewFixed "$arr" 3, IPlain "suspend $eff"]

rtEffThunk : WatFunc
rtEffThunk =
  WatFunc "$rt_effThunk" "$cft" [Pair "$p0" WvAnyRef] [WvAnyRef] []
    [ILocalGet "$p0", IRefNull, ICall "$rt_apply"]

rtEffResumeClo : WatFunc
rtEffResumeClo =
  let
    locals = [Pair "$ctx" (WvRef "$effK")]
    body =
      [ ILocalGet "$p0",
        IRefCast "$effK",
        ILocalSet "$ctx",
        ILocalGet "$ctx",
        IStructGet "$effK" 0,
        ILocalGet "$p1",
        ILocalGet "$ctx",
        IStructGet "$effK" 1,
        ILocalGet "$ctx",
        IStructGet "$effK" 2,
        ILocalGet "$ctx",
        IStructGet "$effK" 3,
        ILocalGet "$ctx",
        IStructGet "$effK" 4,
        ICall "$rt_handleLoop"
      ]
  in WatFunc "$rt_effResumeClo" "$ft" [Pair "$p0" WvAnyRef, Pair "$p1" WvAnyRef] [WvAnyRef] locals body

rtHandleLoop : WatFunc
rtHandleLoop =
  let
    params =
      [ Pair "$cont" (WvRef "$ct"),
        Pair "$v" WvAnyRef,
        Pair "$ret" WvAnyRef,
        Pair "$opH" WvAnyRef,
        Pair "$key" WvAnyRef,
        Pair "$name" WvAnyRef
      ]
    locals =
      [ Pair "$payload" WvAnyRef,
        Pair "$k" (WvRef "$ct"),
        Pair "$res" WvAnyRef,
        Pair "$op" WvAnyRef,
        Pair "$ctx" (WvRef "$effK"),
        Pair "$kclo" WvAnyRef,
        Pair "$v2" WvAnyRef
      ]
    keyEq =
      [ ILocalGet "$payload",
        IRefCast "$arr",
        IConstI32 0,
        IArrayGet "$arr",
        ILocalGet "$key",
        ICall "$rt_eqStr",
        IRefCast "i31",
        II31GetU
      ]
    nameEq =
      [ ILocalGet "$payload",
        IRefCast "$arr",
        IConstI32 1,
        IArrayGet "$arr",
        ILocalGet "$name",
        ICall "$rt_eqStr",
        IRefCast "i31",
        II31GetU
      ]
    extractOp =
      [ILocalGet "$payload", IRefCast "$arr", IConstI32 2, IArrayGet "$arr", ILocalSet "$op"]
    mkKctx =
      [ ILocalGet "$k",
        ILocalGet "$ret",
        ILocalGet "$opH",
        ILocalGet "$key",
        ILocalGet "$name",
        IStructNew "$effK",
        ILocalSet "$ctx"
      ]
    mkKclo = [IRefFunc "$rt_effResumeClo", ILocalGet "$ctx", IStructNew "$clo", ILocalSet "$kclo"]
    callOpH =
      [ILocalGet "$opH", ILocalGet "$op", ICall "$rt_apply", ILocalGet "$kclo", ICall "$rt_apply"]
    forwardToOuter =
      [ ILocalGet "$payload",
        IPlain "suspend $eff",
        ILocalSet "$v2",
        ILocalGet "$k",
        ILocalGet "$v2",
        ILocalGet "$ret",
        ILocalGet "$opH",
        ILocalGet "$key",
        ILocalGet "$name",
        ICall "$rt_handleLoop"
      ]
    body =
      append
        [IBlock "$on" "anyref (ref $ct)" [ILocalGet "$v", ILocalGet "$cont", IPlain "resume $ct (on $eff $on)", ILocalSet "$res", ILocalGet "$ret", ILocalGet "$res", ICall "$rt_apply", IReturn], ILocalSet "$k", ILocalSet "$payload"]
        (append keyEq (append nameEq [IBinop "i32.and", IIf "anyref" (append extractOp (append mkKctx (append mkKclo callOpH))) forwardToOuter]))
  in rtFunc "$rt_handleLoop" params [WvAnyRef] locals body

rtEffHandle : WatFunc
rtEffHandle =
  let
    params =
      [ Pair "$key" WvAnyRef,
        Pair "$name" WvAnyRef,
        Pair "$ret" WvAnyRef,
        Pair "$opH" WvAnyRef,
        Pair "$comp" WvAnyRef,
        Pair "$u" WvAnyRef
      ]
    locals = [Pair "$cont" (WvRef "$ct")]
    body =
      [ IRefFunc "$rt_effThunk",
        IPlain "cont.new $ct",
        ILocalSet "$cont",
        ILocalGet "$cont",
        ILocalGet "$comp",
        ILocalGet "$ret",
        ILocalGet "$opH",
        ILocalGet "$key",
        ILocalGet "$name",
        ICall "$rt_handleLoop"
      ]
  in rtFunc "$rt_effHandle" params [WvAnyRef] locals body

-- ---------------------------------------------------------------
-- 已实现函数清单（固定顺序）
-- ---------------------------------------------------------------
export rtFunctions : RtConsts -> List WatFunc
rtFunctions c =
  [ rtApply,
    rtEffPerform,
    rtEffThunk,
    rtEffResumeClo,
    rtHandleLoop,
    rtEffHandle,
    rtWrite,
    rtPrintln,
    rtEffNewRef,
    rtEffReadRef,
    rtEffWriteRef,
    rtEffPrint "$rt_effPrint" 1,
    rtEffPrint "$rt_effEprint" 2,
    rtEffExit,
    rtFailStr c,
    rtArrayOob c,
    rtFloatFromInt,
    rtIntFromFloat,
    rtFloatBin "$rt_floatAdd" "f64.add",
    rtFloatBin "$rt_floatSub" "f64.sub",
    rtFloatBin "$rt_floatMul" "f64.mul",
    rtFloatBin "$rt_floatDiv" "f64.div",
    rtFloatCmp "$rt_floatEq" "f64.eq",
    rtFloatCmp "$rt_floatNeq" "f64.ne",
    rtFloatCmp "$rt_floatLt" "f64.lt",
    rtFloatCmp "$rt_floatLe" "f64.le",
    rtFloatCmp "$rt_floatGt" "f64.gt",
    rtFloatCmp "$rt_floatGe" "f64.ge",
    rtFloatAbs,
    rtFloatSqrt,
    rtArrayLength,
    rtArrayGet,
    rtArraySet,
    rtArrayMake,
    rtStrFromInt,
    rtShowBool c,
    rtShowStr,
    rtStrConcat,
    binInt "$rt_add" "i64.add",
    binInt "$rt_sub" "i64.sub",
    binInt "$rt_mul" "i64.mul",
    rtDiv c,
    rtBitNot,
    rtBitShl,
    rtBitShr,
    binInt "$rt_bitAnd" "i64.and",
    binInt "$rt_bitOr" "i64.or",
    binInt "$rt_bitXor" "i64.xor",
    cmpInt "$rt_eqInt" "i64.eq",
    cmpInt "$rt_neqInt" "i64.ne",
    cmpInt "$rt_ltInt" "i64.lt_s",
    cmpInt "$rt_leInt" "i64.le_s",
    cmpInt "$rt_gtInt" "i64.gt_s",
    cmpInt "$rt_geInt" "i64.ge_s",
    binBool "$rt_and" "i32.and",
    binBool "$rt_or" "i32.or",
    rtNatSucc,
    rtNatAdd,
    rtNatSub,
    rtNatMul,
    rtNatDiv c,
    rtNatToInt,
    rtNatFromInt,
    rtStrLength,
    rtStrAt,
    rtSubstring,
    rtStrHash,
    rtEqStr,
    rtNeqStr,
    rtBoxZero,
    rtBoxZero2,
    rtErase,
    rtAssert c,
    rtPrimFail,
    rtTodo c
  ]

-- ---------------------------------------------------------------
-- 符号表
-- ---------------------------------------------------------------
export rtImplOf : String -> RtImpl
-- 可观测性原语（`docs/reference/observability.md` §4.1）：wasm 后端只给**叶子**
-- 原语 no-op 桩（返回盒装 0）；`span` 依赖闭包，本后端不支持闭包 ⇒ 引用点编译期拒绝。
rtImplOf "+" = RtFunc 2 "$rt_add"
rtImplOf "-" = RtFunc 2 "$rt_sub"
rtImplOf "*" = RtFunc 2 "$rt_mul"
rtImplOf "/" = RtFunc 2 "$rt_div"
rtImplOf "++" = RtFunc 2 "$rt_strConcat"
rtImplOf "bitAnd" = RtFunc 2 "$rt_bitAnd"
rtImplOf "bitOr" = RtFunc 2 "$rt_bitOr"
rtImplOf "bitXor" = RtFunc 2 "$rt_bitXor"
rtImplOf "bitNot" = RtFunc 1 "$rt_bitNot"
rtImplOf "bitShl" = RtFunc 2 "$rt_bitShl"
rtImplOf "bitShr" = RtFunc 2 "$rt_bitShr"
rtImplOf "&&" = RtFunc 2 "$rt_and"
rtImplOf "||" = RtFunc 2 "$rt_or"
rtImplOf "strFromInt" = RtFunc 1 "$rt_strFromInt"
rtImplOf "strShow" = RtFunc 1 "$rt_showStr"
rtImplOf "bi_eq_int" = RtFunc 2 "$rt_eqInt"
rtImplOf "bi_neq_int" = RtFunc 2 "$rt_neqInt"
rtImplOf "bi_lt_int" = RtFunc 2 "$rt_ltInt"
rtImplOf "bi_le_int" = RtFunc 2 "$rt_leInt"
rtImplOf "bi_gt_int" = RtFunc 2 "$rt_gtInt"
rtImplOf "bi_ge_int" = RtFunc 2 "$rt_geInt"
rtImplOf "prim_erase" = RtFunc 1 "$rt_erase"
rtImplOf "assert" = RtFunc 3 "$rt_assert"
rtImplOf "prim_fail" = RtFunc 1 "$rt_primFail"
rtImplOf "todo" = RtFunc 1 "$rt_todo"
rtImplOf "@ir@showInt" = RtFunc 1 "$rt_strFromInt"
rtImplOf "@ir@showNat" = RtFunc 1 "$rt_strFromInt"
rtImplOf "@ir@showBool" = RtFunc 1 "$rt_showBool"
rtImplOf "@ir@showStr" = RtFunc 1 "$rt_showStr"
rtImplOf "@vuna@debug@on" = RtValue (boolValue False)
