module Vuna.Compiler.Frontend.Lexer
  ( CBlock
  , CKind
  , CLine
  , Comment(..)
  , PTok(..)
  , TEof
  , TFloat
  , TIdent
  , TInt
  , TKw
  , TStr
  , TSym
  , TTmpl
  , TmplPart(..)
  , Tok
  , commentSpan
  , isDigit
  , isIdentStart
  , isLowerChar
  , isUpperChar
  , lexComments
  , lexSource
  ) where

-- vuna 源码 lexer：字符游标、token 与 pos。
--
-- M36：字符串字面量支持**模板插值**（`"hi ${name}"`）与**多行**（`"""..."""`）。
-- 扫描把字面量切成 `TmplPart`：
--   * `TPText`：文本块（转义已解）；
--   * `TPHole`：插值洞，存**洞内 token 列表**（由 `lexHoleTokens` 原位词法得到，
--     位置仍是绝对源码位置）——parser 直接拿这段 token 解析成表达式，无需二次词法。
-- 洞内注释（`--` / `{- -}`）随洞 token 一起被 `skipTrivia` 跳过：插值洞里的注释
-- **不进入 AST**（fmt 会丢失它们），这是已知边界，见 docs/reference/templates.md。
import Base.List
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Diagnostics

-- 模板字面量的片段（M36）：文本块或插值洞（洞内 token 列表）。
data TmplPart : Type where
  TPText : String -> TmplPart
  TPHole : List PTok -> TmplPart

data Tok : Type where
  TIdent : String -> Tok
  TKw : String -> Tok
  TInt : Int -> Tok
  TStr : String -> Tok
  -- `TTmpl multi parts endPos`：`multi` = 是否 `"""` 形式；`endPos` = 结束引号位置
  -- （多行字面量会把 span 的结束行/列带对，布局与 decl span 依赖它）。
  TTmpl : Bool -> List TmplPart -> Pos -> Tok
  TSym : String -> Tok
  TEof : Tok
  -- `TFloat`：十进制浮点字面量的原始文本（放末尾保持 tag 顺序，bootstrap 兼容）。
  TFloat : String -> Tok

record PTok where
  ptokTok : Tok
  ptokPos : Pos

record Chars where
  charsRemaining : List Int
  charsPos : Pos

advanceChar : Int -> Pos -> Pos
advanceChar c (Pos line col) = if c == 10 then Pos (line + 1) 1 else Pos line (col + 1)

isUpperChar : Int -> Bool
isUpperChar c = c >= 65 && c <= 90

isLowerChar : Int -> Bool
isLowerChar c = c >= 97 && c <= 122

isIdentStart : Int -> Bool
isIdentStart c = isUpperChar c || isLowerChar c || c == 95

isIdentChar : Int -> Bool
isIdentChar c = isIdentStart c || isDigit c || c == 39

isDigit : Int -> Bool
isDigit c = c >= 48 && c <= 57

isSpace : Int -> Bool
isSpace c = c == 32 || c == 9 || c == 10 || c == 13

isOpChar : Int -> Bool
isOpChar c =
  c == 33
    || c == 36
    || c == 37
    || c == 38
    || c == 42
    || c == 43
    || c == 45
    || c == 46
    || c == 47
    || c == 60
    || c == 61
    || c == 62
    || c == 63
    || c == 64
    || c == 92
    || c == 94
    || c == 124
    || c == 126
    || c == 58

-- 关键字表（M28 增 `axiom`；M31.2 增 `infixl` / `infixr` / `infix`）。
isKeyword : String -> Bool
-- records-v2：表示档位前缀（`alias record` / `boxed record`）与 D11 的 `export` /
-- `abstract` 是**软关键字**：只在声明位置的特定上下文识别，不进入该表，避免与用户
-- 已有的同名标识符（编译器源码里就有 `alias` 等 binder）冲突。
-- `transparent` / `opaque` 仍是硬关键字（迁移期兼作旧 record 档位词）。
-- native-effects N1：`perform op`（ND12 保留名编码）。
isKeyword s =
  s == "data"
    || s == "axiom"
    || s == "extern"
    || s == "case"
    || s == "of"
    || s == "let"
    || s == "in"
    || s == "if"
    || s == "then"
    || s == "else"
    || s == "where"
    || s == "linear"
    || s == "transparent"
    || s == "opaque"
    || s == "Type"
    || s == "import"
    || s == "module"
    || s == "qualified"
    || s == "as"
    || s == "record"
    || s == "trait"
    || s == "instance"
    || s == "deriving"
    || s == "do"
    || s == "perform"
    || s == "handle"
    || s == "infixl"
    || s == "infixr"
    || s == "infix"

classifyIdent : String -> Tok
classifyIdent s = if isKeyword s then TKw s else TIdent s

skipLineComment : Chars -> Chars
skipLineComment (Chars [] p) = Chars [] p
skipLineComment (Chars (c :: rest) p) =
  if c == 10 then Chars (c :: rest) p else skipLineComment (Chars rest (advanceChar c p))

skipBlockComment : Int -> Chars -> Check Chars
skipBlockComment depth (Chars [] p) = lexErr0 UnterminatedBlockComment
skipBlockComment depth (Chars (c :: rest) p) = case rest of
  c2 :: rest2 =>
    if c == 123 && c2 == 45 then skipBlockComment (depth + 1) (Chars rest2 (advanceChar c2 (advanceChar c p)))
    else if c == 45 && c2 == 125 then if depth == 1 then OkC (Chars rest2 (advanceChar c2 (advanceChar c p)))
    else skipBlockComment (depth - 1) (Chars rest2 (advanceChar c2 (advanceChar c p)))
    else skipBlockComment depth (Chars rest (advanceChar c p))
  [] => skipBlockComment depth (Chars rest (advanceChar c p))

-- 跳过 trivia。fuel 按字符/注释段递减（M36 起所有扫描器都不再回传 fuel：
-- 主循环与各扫描器各自持有一个够用的显式 fuel，终止性走「守卫 Int + 严格递减」）。
skipTrivia : Int -> Chars -> Check Chars
skipTrivia fuel cs = if fuel <= 0 then icFuel "lexer"
else case cs of
  Chars [] p => OkC cs
  Chars (c :: rest) p => if isSpace c then skipTrivia (fuel - 1) (Chars rest (advanceChar c p))
  else case rest of
    c2 :: rest2 => if c == 45 && c2 == 45 then skipTrivia (fuel - 1) (skipLineComment (Chars rest (advanceChar c p)))
    else if c == 123 && c2 == 45 then case skipBlockComment 1 (Chars rest (advanceChar c p)) of
      ErrC e => ErrC e
      OkC cs2 => skipTrivia (fuel - 1) cs2
    else OkC cs
    [] => OkC cs

collectIdent : Chars -> List Int -> Pair String Chars
collectIdent (Chars [] p) acc = Pair (strPack (reverse acc)) (Chars [] p)
collectIdent (Chars (c :: rest) p) acc = if isIdentChar c then collectIdent (Chars rest (advanceChar c p)) (c :: acc)
else if c == 46 then case rest of
  c2 :: rest2 =>
    if isIdentStart c2 then collectIdent (Chars rest (advanceChar c p)) (c :: acc)
    else Pair (strPack (reverse acc)) (Chars (c :: rest) p)
  [] => Pair (strPack (reverse acc)) (Chars (c :: rest) p)
else Pair (strPack (reverse acc)) (Chars (c :: rest) p)

-- 63 位宿主 int 的上界（2^62 - 1）。字面量累加超过它就无法表示：C40 起在词法期报
-- `LX_IntLiteralOutOfRange`，不再让 `acc * 10 + d` 静默回绕成小值或负数。
maxIntLiteral : Int
maxIntLiteral = 4611686018427387903

-- 十进制字面量的累加。每位先判「再乘 10 加 d 是否会超出 maxIntLiteral」，越界即报错；
-- 因此 `4611686018427387903` 仍合法，`...904` 起报 `LX_IntLiteralOutOfRange`。
collectInt : Chars -> Int -> Check (Pair Int Chars)
collectInt (Chars [] p) acc = OkC (Pair acc (Chars [] p))
collectInt (Chars (c :: rest) p) acc = if isDigit c then
  let
    d = c - 48
  in if acc > (maxIntLiteral - d) / 10 then lexErr0 IntLiteralOutOfRange
  else collectInt (Chars rest (advanceChar c p)) (acc * 10 + d)
else OkC (Pair acc (Chars (c :: rest) p))

-- ---------------------------------------------------------------
-- 浮点字面量（`digits '.' digits`）
-- ---------------------------------------------------------------
-- 先看数字串后面是否是「`.` + 数字」，是才走浮点扫描；否则保持旧的整数扫描
-- （含 `LX_IntLiteralOutOfRange` 语义）。这样普通整数路径没有额外分配。
-- | 数字串后面是否紧跟「`.` + 数字」：是则整段按浮点字面量扫描，否则走整数路径。
digitRunIsFloat : Chars -> Bool
digitRunIsFloat (Chars [] p) = False
digitRunIsFloat (Chars (c :: rest) p) = if isDigit c then digitRunIsFloat (Chars rest (advanceChar c p))
else if c == 46 then case rest of
  d :: rest2 => isDigit d
  [] => False
else False

-- 收集 `digits '.' digits` 的原始文本（首字符已消费，acc 是逆序的数字字符）。
-- | 收集浮点字面量 `digits . digits` 的原始文本；遇到 `.` 后交给 `collectFrac`。
collectFloat : Chars -> List Int -> Pair String Chars
collectFloat (Chars [] p) acc = Pair (strPack (reverse acc)) (Chars [] p)
collectFloat (Chars (c :: rest) p) acc =
  if isDigit c then collectFloat (Chars rest (advanceChar c p)) (c :: acc)
  else if c == 46 then collectFrac (Chars rest (advanceChar c p)) (c :: acc)
  else Pair (strPack (reverse acc)) (Chars (c :: rest) p)

-- | 收集浮点字面量的小数部分（`.` 已消费），遇到非数字即停止。
collectFrac : Chars -> List Int -> Pair String Chars
collectFrac (Chars [] p) acc = Pair (strPack (reverse acc)) (Chars [] p)
collectFrac (Chars (c :: rest) p) acc =
  if isDigit c then collectFrac (Chars rest (advanceChar c p)) (c :: acc)
  else Pair (strPack (reverse acc)) (Chars (c :: rest) p)

collectOp : Chars -> List Int -> Pair String Chars
collectOp (Chars [] p) acc = Pair (strPack (reverse acc)) (Chars [] p)
collectOp (Chars (c :: rest) p) acc =
  if isOpChar c then collectOp (Chars rest (advanceChar c p)) (c :: acc)
  else Pair (strPack (reverse acc)) (Chars (c :: rest) p)

-- ---------------------------------------------------------------
-- 字符串 / 模板字面量（M36）
--
-- 单行 `"..."`：转义 `\n \t \r \" \\ \' \$`；`${expr}` 插值；原始换行是
-- `LX_UnterminatedString`（与旧行为一致）。
-- 多行 `"""..."""`：内容逐字（原始换行 / tab / `"` / `""` 都可以），**紧跟开引号的一个
-- 换行不计入内容**；遇 `"""` 结束；转义与插值同样生效。
--
-- 洞内 token 由同一套词法（`lexHoleTokens` → `lexOneToken`）原位产出，位置天然是绝对
-- 源码位置；洞里的注释随 `skipTrivia` 跳过（不进入 AST，fmt 会丢失它们——已知边界）。
-- ---------------------------------------------------------------
-- 转义字符 → 实际码点（`\$` 是 M36 新增：用来写一个字面 `${`）。
decodeEscape : Int -> Maybe Int
decodeEscape 110 = Just 10
decodeEscape 116 = Just 9
decodeEscape 114 = Just 13
decodeEscape 34 = Just 34
decodeEscape 92 = Just 92
decodeEscape 39 = Just 39
decodeEscape 36 = Just 36
decodeEscape other = Nothing

dropOpeningNewline : Chars -> Chars
dropOpeningNewline (cs@(Chars (c :: rest) p)) = if c == 10 then Chars rest (advanceChar c p) else cs
dropOpeningNewline (cs@(Chars [] p)) = cs

flushText : List Int -> List TmplPart -> List TmplPart
flushText [] parts = parts
flushText acc parts = TPText (strPack (reverse acc)) :: parts

-- 扫描模板正文。`multi` = 是否 `"""`；入口位置在**开引号之后**。
-- 返回：(parts（正序）、(字面量之后的 Chars, 结束引号位置))。
scanTemplateText : Int -> Bool -> Chars -> List Int -> List TmplPart -> Check (Pair (List TmplPart) (Pair Chars Pos))
-- 单行结束 `"`；单行不允许原始换行
scanTemplateText fuel multi cs acc parts = if fuel <= 0 then icFuel "lexer"
else case cs of
  Chars [] p => lexErr0 UnterminatedString
  Chars (c :: rest) p => if c == 36 then case rest of
    -- 插值洞：`${`
    c2 :: rest2 => if c2 == 123 then
      let
        holeStart = advanceChar c2 (advanceChar c p)
      in case lexHoleTokens (fuel - 1) 0 (Chars rest2 holeStart) [] of
        ErrC e => ErrC e
        OkC (Pair toks cs2) => case cs2 of
          Chars (125 :: rest3) p3 =>
            scanTemplateText (fuel - 1) multi (Chars rest3 (advanceChar 125 p3)) []
              (TPHole toks :: flushText acc parts)
          _ => lexErr0 UnterminatedInterpolation
    else scanTemplateText (fuel - 1) multi (Chars rest (advanceChar c p)) (c :: acc) parts
    [] => scanTemplateText (fuel - 1) multi (Chars rest (advanceChar c p)) (c :: acc) parts
  else if c == 92 then case rest of
    -- 转义
    e :: rest2 => case decodeEscape e of
      Nothing => lexErr0 UnknownEscape
      Just d =>
        scanTemplateText (fuel - 1) multi (Chars rest2 (advanceChar e (advanceChar c p))) (d :: acc)
          parts
    [] => lexErr0 UnterminatedString
  else if multi && c == 34 then case rest of
    -- 多行结束 `"""`
    c2 :: rest3 => case rest3 of
      c3 :: rest4 => if c2 == 34 && c3 == 34 then
        let
          pos2 = advanceChar c2 (advanceChar c p)
          pos3 = advanceChar c3 pos2
        in OkC (Pair (reverse (flushText acc parts)) (Pair (Chars rest4 (advanceChar c3 pos3)) pos3))
      else scanTemplateText (fuel - 1) multi (Chars rest (advanceChar c p)) (c :: acc) parts
      [] => lexErr0 UnterminatedString
    [] => lexErr0 UnterminatedString
  else if not multi && c == 34 then OkC (Pair (reverse (flushText acc parts)) (Pair (Chars rest (advanceChar c p)) p))
  else if not multi && c == 10 then lexErr0 UnterminatedString
  else scanTemplateText (fuel - 1) multi (Chars rest (advanceChar c p)) (c :: acc) parts

-- 洞内 token 扫描：从 `${` 之后开始，`{`/`}` 计深度，深度 0 的 `}` 不消费。
-- 内部字符串/注释由 token 词法（`lexOneToken` / `skipTrivia`）整体跳过。
lexHoleTokens : Int -> Int -> Chars -> List PTok -> Check (Pair (List PTok) Chars)
lexHoleTokens fuel depth cs acc = if fuel <= 0 then icFuel "lexer"
else case skipTrivia (fuel - 1) cs of
  ErrC e => ErrC e
  OkC cs2 => case cs2 of
    Chars [] p => lexErr0 UnterminatedInterpolation
    Chars (c :: rest) p => if c == 125 && depth == 0 then OkC (Pair (reverse acc) cs2)
    else case lexOneToken (fuel - 1) cs2 of
      ErrC e => ErrC e
      OkC (Pair tok cs3) => lexHoleTokens (fuel - 1) (depthAfter depth tok.ptokTok) cs3 (tok :: acc)

-- 洞的深度更新：`{` 加深、`}` 变浅；其它 token 不变。
depthAfter : Int -> Tok -> Int
depthAfter depth (TSym "{") = depth + 1
depthAfter depth (TSym "}") = if depth > 0 then depth - 1 else 0
depthAfter depth _ = depth

-- 消费一个 token（调用方保证已 skipTrivia 且输入非空）。
lexOneToken : Int -> Chars -> Check (Pair PTok Chars)
lexOneToken fuel cs = if fuel <= 0 then icFuel "lexer"
else case cs of
  Chars [] p => icInternal "lexOneToken on empty input"
  Chars (c :: rest) p => if isIdentStart c then case collectIdent (Chars rest (advanceChar c p)) [c] of
    Pair name cs2 => OkC (Pair (PTok (classifyIdent name) p) cs2)
  else if isDigit c then if digitRunIsFloat (Chars rest (advanceChar c p)) then
    let
      frac = collectFloat (Chars rest (advanceChar c p)) [c]
    in OkC (Pair (PTok (TFloat (firstOf frac)) p) (secondOf frac))
  else case collectInt (Chars rest (advanceChar c p)) (c - 48) of
    ErrC e => ErrC e
    OkC (Pair n cs2) => OkC (Pair (PTok (TInt n) p) cs2)
  else if c == 34 then lexStringToken (fuel - 1) c rest p
  else if c == 40 || c == 41 || c == 91 || c == 93 || c == 44 || c == 123 || c == 125 then OkC (Pair (PTok (TSym (strPack [c])) p) (Chars rest (advanceChar c p)))
  else if c == 96 then OkC (Pair (PTok (TSym "`") p) (Chars rest (advanceChar c p)))
  else if isOpChar c then case collectOp (Chars rest (advanceChar c p)) [c] of
    -- M31.3：反引号中缀的定界符。`96` 不在 isOpChar 里（否则会与相邻符号粘成一个 token），
    -- 单独识别成 `TSym "`"`，由 parser 配对消费。
    Pair op cs2 => OkC (Pair (PTok (TSym op) p) cs2)
  else lexErr0 UnexpectedCharacter

-- `"..."` / `"""..."""`：判定形式后走模板扫描，再决定 token 形态。
-- 单行且无洞 → `TStr`（保持旧 token 形态）；其余（多行 / 含洞）→ `TTmpl`。
lexStringToken : Int -> Int -> List Int -> Pos -> Check (Pair PTok Chars)
lexStringToken fuel c rest p = if fuel <= 0 then icFuel "lexer"
else case rest of
  c2 :: rest3 => case rest3 of
    c3 :: rest4 => if c2 == 34 && c3 == 34 then
      let
        bodyStart = advanceChar c3 (advanceChar c2 (advanceChar c p))
      in case scanTemplateText (fuel - 1) True (dropOpeningNewline (Chars rest4 bodyStart)) [] [] of
        ErrC e => ErrC e
        OkC (Pair parts (Pair cs2 endP)) => OkC (Pair (PTok (TTmpl True parts endP) p) cs2)
    else lexSingleStringToken (fuel - 1) (Chars rest (advanceChar c p)) p
    [] => lexSingleStringToken (fuel - 1) (Chars rest (advanceChar c p)) p
  [] => lexSingleStringToken (fuel - 1) (Chars rest (advanceChar c p)) p

lexSingleStringToken : Int -> Chars -> Pos -> Check (Pair PTok Chars)
lexSingleStringToken fuel body p = if fuel <= 0 then icFuel "lexer"
else case scanTemplateText (fuel - 1) False body [] [] of
  ErrC e => ErrC e
  OkC (Pair parts (Pair cs2 endP)) => case parts of
    [TPText s] => OkC (Pair (PTok (TStr s) p) cs2)
    _ => OkC (Pair (PTok (TTmpl False parts endP) p) cs2)

-- 主循环：trivia 之后逐个 token，直到 EOF。每个 token 扣 1 步（各扫描器自带够用的
-- fuel：token 内的字符数 ≤ 剩余源码长度，见 `sourceFuel` 的上界说明）。
lexChars : Int -> Chars -> Check (List PTok)
lexChars fuel cs = if fuel <= 0 then icFuel "lexer"
else case skipTrivia fuel cs of
  ErrC e => ErrC e
  OkC cs2 => case cs2 of
    Chars [] p => OkC [PTok TEof p]
    _ => case lexOneToken fuel cs2 of
      ErrC e => ErrC e
      OkC (Pair tok cs3) => case lexChars (fuel - 1) cs3 of
        ErrC e => ErrC e
        OkC toks => OkC (tok :: toks)

lexSource : String -> Check (List PTok)
lexSource source = lexChars (sourceFuel source) (Chars (strUnpack source) (Pos 1 1))

-- 显式 fuel 的初值（M36）。
--
-- **上界说明**：主循环每个 token 扣 1，token 数 T ≤ len；token 内部的模板/洞扫描
-- 每个字符扣 1，且单个 token 的字符数 ≤ len，扫描起点处的存量 fuel 远大于它；
-- 注释扫描每次递归扣 1，每次至少消费 1 个字符 ⇒ 调用次数 ≤ len。
-- 取 4*len+64：任何合法输入都不会耗尽（耗尽即明确的 internal 错误，不静默半途而废）。
sourceFuel : String -> Int
sourceFuel source = 4 * strLength source + 64

-- ---------------------------------------------------------------
-- 注释扫描（fmt 用）：注释不进入 token 流，但格式化器需要保留它们。
-- 与 skipTrivia 使用同一套规则（`--` 行注释、`{- -}` 可嵌套块注释，
-- 字符串字面量里的 `--` / `{-` 不算注释；模板字面量整体按模板扫描跳过）。
-- ---------------------------------------------------------------
data CKind : Type where
  CLine : CKind
  CBlock : CKind

record Comment where
  commentKind : CKind
  commentText : String
  commentSpan : Span

commentSpan : Comment -> Span
commentSpan (Comment kind text sp) = sp

trimTrailingSpace : String -> String
trimTrailingSpace s = strPack (reverse (dropTrailingSpace (reverse (strUnpack s))))

dropTrailingSpace : List Int -> List Int
dropTrailingSpace [] = []
dropTrailingSpace (c :: rest) =
  if c == 32 || c == 9 || c == 13 then dropTrailingSpace rest else Base.List.Cons c rest

-- 行注释正文：从 `--` 之后扫到行尾（不消费换行）；endP 是最后一个正文字符位置。
collectLineBody : Chars -> List Int -> Pos -> Pair String (Pair Chars Pos)
collectLineBody (Chars [] p) acc endP = Pair (strPack (reverse acc)) (Pair (Chars [] p) endP)
collectLineBody (Chars (c :: rest) p) acc endP =
  if c == 10 then Pair (strPack (reverse acc)) (Pair (Chars (c :: rest) p) endP)
  else collectLineBody (Chars rest (advanceChar c p)) (c :: acc) p

-- 块注释正文：深度从 1 开始，返回 `{-` 与 `-}` 之间的原文；endP 是 `}` 的位置。
collectBlockBody : Chars -> Int -> List Int -> Pos -> Check (Pair String (Pair Chars Pos))
collectBlockBody (Chars [] p) depth acc endP = lexErr0 UnterminatedBlockComment
collectBlockBody (Chars (c :: rest) p) depth acc endP = case rest of
  c2 :: rest2 =>
    if c == 123 && c2 == 45 then collectBlockBody (Chars rest2 (advanceChar c2 (advanceChar c p))) (depth + 1) (c2 :: c :: acc)
      (advanceChar c2 p)
    else if c == 45 && c2 == 125 then if depth == 1 then OkC
      (Pair (strPack (reverse acc)) (Pair (Chars rest2 (advanceChar c2 (advanceChar c p))) (advanceChar c2 p)))
    else collectBlockBody (Chars rest2 (advanceChar c2 (advanceChar c p))) (depth - 1) (c2 :: c :: acc)
      (advanceChar c2 p)
    else collectBlockBody (Chars rest (advanceChar c p)) depth (c :: acc) p
  [] => collectBlockBody (Chars rest (advanceChar c p)) depth (c :: acc) p

commentSpanOf : Pos -> Pos -> Span
commentSpanOf startP endP = Span "" (posLine startP) (posCol startP) (posLine endP) (posCol endP)

-- 跳过整段字符串字面量（开引号在 `c`/`p`，`rest` 为其后）。
skipStringLiteral : Int -> Int -> List Int -> Pos -> Check Chars
skipStringLiteral fuel c (rest@(c2 :: rest3)) p = case rest3 of
  c3 :: rest4 => if c2 == 34 && c3 == 34 then
    let
      bodyStart = advanceChar c3 (advanceChar c2 (advanceChar c p))
    in case scanTemplateText (fuel - 1) True (dropOpeningNewline (Chars rest4 bodyStart)) [] [] of
      ErrC e => ErrC e
      OkC (Pair parts (Pair cs2 endP)) => OkC cs2
  else skipSingleStringLiteral fuel (Chars rest (advanceChar c p))
  [] => skipSingleStringLiteral fuel (Chars rest (advanceChar c p))
skipStringLiteral fuel c (rest@[]) p = skipSingleStringLiteral fuel (Chars rest (advanceChar c p))

skipSingleStringLiteral : Int -> Chars -> Check Chars
skipSingleStringLiteral fuel body = case scanTemplateText (fuel - 1) False body [] [] of
  ErrC e => ErrC e
  OkC (Pair parts (Pair cs2 endP)) => OkC cs2

scanComments : Int -> Chars -> List Comment -> Check (List Comment)
scanComments fuel (Chars [] p) acc = if fuel <= 0 then icFuel "lexer" else OkC (reverse acc)
scanComments fuel (Chars (c :: rest) p) acc = if fuel <= 0 then icFuel "lexer"
else if c == 34 then case skipStringLiteral (fuel - 1) c rest p of
  ErrC e => ErrC e
  OkC cs2 => scanComments (fuel - 1) cs2 acc
else case rest of
  c2 :: rest2 => if c == 45 && c2 == 45 then case collectLineBody (Chars rest2 (advanceChar c2 (advanceChar c p))) [] (advanceChar c2 p) of
    Pair text (Pair cs2 endP) =>
      scanComments (fuel - 1) cs2
        (Comment CLine (trimTrailingSpace text) (commentSpanOf p endP) :: acc)
  else if c == 123 && c2 == 45 then case collectBlockBody (Chars rest2 (advanceChar c2 (advanceChar c p))) 1 [] (advanceChar c2 p) of
    ErrC e => ErrC e
    OkC (Pair text (Pair cs2 endP)) =>
      scanComments (fuel - 1) cs2 (Comment CBlock text (commentSpanOf p endP) :: acc)
  else scanComments (fuel - 1) (Chars rest (advanceChar c p)) acc
  [] => OkC (reverse acc)

-- 扫描整段源码里的注释（源码顺序），供格式化器按位置重新插入。
lexComments : String -> Check (List Comment)
lexComments source = scanComments (sourceFuel source) (Chars (strUnpack source) (Pos 1 1)) []
