module Vuna.Compiler.Frontend.Parser.Support where

-- Vuna.Compiler.Frontend.Parser.Support：parser 的状态类型（PState）与 token/游标
-- 辅助（lookahead、advance、span、fuel、infix 表、token 分类）。解析规则留在
-- `Parser.vuna`；拆出本模块是为满足 `nix/context.budget` 的 max_module_lines。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Diagnostics

export record PState(..) where
  fileOf : String
  toksOf : List PTok
  lastPos : Pos
  toksLeft : Int

-- 余下 token 数（O(1) 维护）：stateFuel 旧实现 `128 * length toks + 1024` 每次调用都遍历
-- 剩余 token 列表，而它在每个声明/表达式循环入口都被调用 ⇒ 大文件解析 O(n²)。
-- vuna 源码 parser（offside layout）
-- ---------------------------------------------------------------
export fileOf : PState -> String
fileOf (PState file toks last count) = file

-- 从起始状态 st 到结束状态 st2 的 span：起点=当前 token，终点=最后消费的 token。
export spanOf : PState -> PState -> Span
spanOf st st2 =
  Span (fileOf st) (posLine (peekPos st)) (posCol (peekPos st)) (posLine (lastPos st2))
    (posCol (lastPos st2))

export peekTok : PState -> PTok
peekTok (PState file (t :: rest) last count) = t
peekTok (PState file [] last count) = PTok TEof (Pos 1 1)

export peekPos : PState -> Pos
peekPos st = (peekTok st).ptokPos

-- | 当前 token 的**点 span**（起点=终点，caret 宽度 1）。EOF 退到最后消费的 token：
-- `peekTok` 对空流给出 `Pos 1 1`，直接拿它会指向文件头。
export tokSpan : PState -> Span
tokSpan st = case peekTok st of
  PTok TEof _ =>
    let
      p = lastPos st
    in Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p)
  PTok _ p => Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p)

export lastPos : PState -> Pos
lastPos (PState file toks last count) = last

export advance : PState -> PState
advance (PState file (toks@(t :: rest)) last count) = case t of
  PTok TEof p => PState file toks last count
  _ => PState file rest t.ptokPos (if count > 0 then count - 1 else 0)
advance (PState file (toks@[]) last count) = PState file toks last count

export isEof : PState -> Bool
isEof st = case peekTok st of
  PTok TEof p => True
  _ => False

-- 让下一个 token 视作「与上一 token 同一行」：do 语句块里新起一行的裸表达式
-- 需要这一点，否则首 token 会被 canContinue 判成缩进不足。
-- 显式 fuel（M30/C27 保留，给出证明界）：parser 的递归都经「返回新状态再递归」，
-- 递归实参是**游标状态**而不是某个形参的真子项（PState 不可分解成更小的 token 列表），
-- 所以现有 SCT 判据看不到结构下降；每个解析循环带 fuel 并在入口 `if fuel <= 0` 守卫、
-- 递归传 `fuel - 1`，R2「守卫 Int」判据直接接受。
--
-- **不耗尽证明**（`stateFuel = 128 * 剩余 token 数 + 1024`）：
--   1. 不变量：任一带 fuel 的调用点上，`fuel >= 16 * 剩余 token 数 + 1`；
--   2. 相邻两次 token 消费之间的 fuel 递减数 ≤ 16。逐产生式审计最长的「零 token 递减链」：
--        - 表达式原子：parseExpr→parseLhs→parseApplication→parseAtom→parseAtomBase
--          = 5 步后消费 1 token（括号/列表/记录更新再嵌套，每 token 仍 ≤ 6 步）；
--        - 中缀：parseInfix 每消费 1 个运算符 token 至多 2 步；
--        - case 分支：parseCaseAlts→parseAltList→parsePatternSingle→parsePatternCons
--          →parsePatternHead→parsePatternAtom = 6 步消费 1 token；
--        - 绑定/where/do：parseWhere→parseBindingItemsAt→parseBindingItem →
--          parseBindingDef/parseBindingValue ≈ 5 步；
--      取 16 作统一上界（真实最长链 6）；
--   3. 归纳：种子 `128*N + 1024 >= 16*N + 1`；每消费 1 token 允许 16 步递减，
--      故沿路径 `fuel` 与「16 * 剩余」的差只增不减；路径末尾（EOF）至多再走
--      一个 ≤16 步的收尾链，被 1024 的常数项覆盖。`stateFuel` 在嵌套入口重新取值时
--      也按**当前**剩余 token 数线性放大，不变量保持。
--   于是任何可由内存构造的合法输入都不会触发 `parser fuel exhausted`。
export stateFuel : PState -> Int
stateFuel st = 128 * st.toksLeft + 1024

export sameLineState : PState -> PState
sameLineState st = case peekPos st of
  Pos line col => PState (fileOf st) st.toksOf (Pos line 0) st.toksLeft

export atSym : PState -> String -> Bool
atSym st s = case peekTok st of
  PTok (TSym x) p => x == s
  _ => False

-- 向后看第 n 个 token（0 = 当前）。M13 的 Pi binder 需要 2-token lookahead。
export nthTok : List PTok -> Int -> Maybe PTok
nthTok [] n = Nothing
nthTok (t :: rest) n = if n <= 0 then Just t else nthTok rest (n - 1)

export peekTokAt : PState -> Int -> Maybe PTok
peekTokAt st n = nthTok st.toksOf n

-- M38：Pi binder 头：`标识符 :`、`0 标识符 :`、`1 标识符 :`（`(x : A) -> B` / `{x : A} -> B`）。
-- 多参数 trait 的探针还写 `{a b : Type} -> ...`：同一 binder 组可含多个名字，这里返回
-- 名字列表，`parsePiBinder` 展开成嵌套 EPi。
export binderHead : PState -> Maybe (Pair (Maybe Qty) (List String))
binderHead st = case peekTok st of
  PTok (TIdent name) _ => case binderNameTail 64 st 1 [] of
    Just names => Just (Pair Nothing (name :: names))
    Nothing => Nothing
  PTok (TInt 0) _ => quantifiedHead st Q0
  PTok (TInt 1) _ => quantifiedHead st Q1
  _ => Nothing

-- 从第 n 个 token 起收集连续的标识符，直到 `:`（lookahead 不走状态）。
-- fuel 只是终止性证据：每次向前看一个 token，最多走 token 数步。
binderNameTail : Int -> PState -> Int -> List String -> Maybe (List String)
binderNameTail fuel st n acc = if fuel <= 0 then Nothing
else case peekTokAt st n of
  Just (PTok (TIdent name) _) => binderNameTail (fuel - 1) st (n + 1) (name :: acc)
  Just (PTok (TSym ":") _) => Just (reverse acc)
  _ => Nothing

quantifiedHead : PState -> Qty -> Maybe (Pair (Maybe Qty) (List String))
quantifiedHead st q = case peekTokAt st 1 of
  Just (PTok (TIdent name) _) => case binderNameTail 64 st 2 [] of
    Just names => Just (Pair (Just q) (name :: names))
    Nothing => Nothing
  _ => Nothing

export atKw : PState -> String -> Bool
atKw st k = case peekTok st of
  PTok (TKw x) p => x == k
  _ => False

export canContinue : PState -> Int -> Bool
canContinue st blockCol = case peekPos st of
  Pos line col => case lastPos st of
    Pos lastLine lastCol => line == lastLine || col > blockCol

export expectSym : PState -> String -> Check (Pair Int PState)
expectSym st s = case peekTok st of
  PTok (TSym x) p =>
    if x == s then OkC (Pair 0 (advance st)) else psErr1At (tokSpan st) (ExpectedToken s) s
  _ => psErr1At (tokSpan st) (ExpectedToken s) s

export expectKw : PState -> String -> Check (Pair Int PState)
expectKw st k = case peekTok st of
  PTok (TKw x) p =>
    if x == k then OkC (Pair 0 (advance st)) else psErr1At (tokSpan st) (ExpectedToken k) k
  _ => psErr1At (tokSpan st) (ExpectedToken k) k

export expectIdent : PState -> Check (Pair String PState)
expectIdent st = case peekTok st of
  PTok (TIdent x) p => OkC (Pair x (advance st))
  _ => psErr0At (tokSpan st) ExpectedIdentifier

-- M31.3：值位置名字 = 标识符或非保留符号名。用于用户符号名 def/signature 与反引号
-- 中缀里的名字（`` a `f` b ``）。
export expectValueName : PState -> Check (Pair String PState)
expectValueName st = case peekTok st of
  PTok (TIdent x) p =>
    if isReservedValueName x then psErr1At (tokSpan st) (ExpectedToken "value name") "value name"
    else OkC (Pair x (advance st))
  PTok (TSym op) p =>
    if isReservedValueName op then psErr1At (tokSpan st) (ExpectedToken "value name") "value name"
    else OkC (Pair op (advance st))
  _ => psErr0At (tokSpan st) ExpectedIdentifier

export upperFirst : String -> Bool
upperFirst s = case strUnpack s of
  c :: rest => c >= 65 && c <= 90
  [] => False

-- `_` 前缀私有构造器（如 `_C`）在模式里也要能当构造器用：`_` 开头的标识符
-- 若紧随大写字母，按构造器解析；单独的 `_` 仍是通配符，`_x` 仍是变量。
export underscoreCtorName : String -> Bool
underscoreCtorName s = case strUnpack s of
  c :: rest => if c == 95 then case rest of
    c2 :: rest2 => c2 >= 65 && c2 <= 90
    [] => False
  else False
  [] => False

export ctorPatternStart : String -> Bool
ctorPatternStart name = upperFirst name || underscoreCtorName name

export startsAtom : PState -> Bool
startsAtom st = case peekTok st of
  PTok (TIdent x) p => True
  PTok (TInt x) p => True
  PTok (TFloat x) p => True
  PTok (TStr x) p => True
  PTok (TTmpl m parts ep) p => True
  PTok (TKw "Type") p => True
  PTok (TSym "(") p => True
  PTok (TSym "[") p => True
  PTok (TSym "?") p => case holeAtomAt st of
    Just _ => True
    Nothing => False
  _ => False

-- M40：命名洞 `?name` 的原子：`?` 与紧随的标识符**同行且列号相邻**（`?h`）。
-- 空格分隔的 `?` 仍是普通运算符（`a ? b`、`(? b)`），不受影响。
-- 返回值 = 洞名（带 `?`）+ 覆盖 `?name` 的 span（end 到名字末字节，便于 hover 高亮整个洞）。
export holeAtomAt : PState -> Maybe (Pair String Span)
holeAtomAt st = case peekTok st of
  PTok (TSym "?") p => case peekTokAt st 1 of
    Just (PTok (TIdent n) p2) =>
      if posLine p2 == posLine p && posCol p2 == posCol p + 1 then Just
        (Pair ("?" ++ n) (Span (fileOf st) (posLine p) (posCol p) (posLine p2) (posCol p2 + strLength n)))
      else Nothing
    _ => Nothing
  _ => Nothing

export startsPatternAtom : PState -> Bool
startsPatternAtom st = case peekTok st of
  PTok (TIdent x) p => True
  PTok (TInt x) p => True
  PTok (TStr x) p => True
  PTok (TTmpl m parts ep) p => True
  PTok (TSym "(") p => True
  PTok (TSym "[") p => True
  _ => False

-- M31.2：中缀解析不再有固定优先级表——`infix*` 声明随模块进入 Loader，重排时才消费。
-- 这里只判定「哪些符号在表达式位置属于语法、遇到就停止」，其余 TSym 都当运算符。
export isSyntaxSym : String -> Bool
isSyntaxSym op = case op of
  "=" => True
  ":" => True
  "," => True
  ";" => True
  "|" => True
  "=>" => True
  "<-" => True
  "\\" => True
  "." => True
  ".." => True
  "@" => True
  -- 括号/分隔符：表达式位置出现时是语法边界，不是运算符（否则 `(a + b)` 的 `)` 会被
  -- 当成中缀符号吞掉）。
  "(" => True
  ")" => True
  "[" => True
  "]" => True
  "{" => True
  "}" => True
  _ => False

-- M31.3：保留符号名不能被当作可定义名 / 反引号名字 / 原子 section 的 op。
-- 集合 = 表达式位置的语法符号（`isSyntaxSym`）∪ {`->`, `` ` ``}。
-- `->` 是语法而非用户运算符（fixity 由 Loader.syntaxFixityDecls 恒提供）；反引号是定界符。
export isReservedValueName : String -> Bool
isReservedValueName name = isSyntaxSym name || name == "->" || name == "`"

-- M31.3：右 section 判定——当前 token 是运算符、下一个 token 是 `)`。
-- 不消费 `)`：由外层 `(` 分支统一消费。
export closeParenNext : PState -> Bool
closeParenNext st = case peekTokAt st 1 of
  Just (PTok (TSym ")") p) => True
  _ => False

-- M31.3：`(` 之后的下一个 token 若是非保留符号名，则该括号是 section
-- （`(+)` 或 `(+ e)`），返回该符号名；否则不是 section。
-- M40：`(?h)` 里 `?` 紧邻标识符 ⇒ 是命名洞而不是 `(? h)` section。
export sectionOpAt : PState -> Maybe String
sectionOpAt st = case peekTokAt st 1 of
  Just (PTok (TSym op) p) => if isReservedValueName op then Nothing
  else if op == "?" then case holeAtomAt (advance st) of
    Just _ => Nothing
    Nothing => Just op
  else Just op
  _ => Nothing

export countArrows : Expr -> Int
countArrows (EInfix "->" _ rest _) = 1 + countArrows rest
countArrows (EApp (EVar "->" _) ([x, rest]) _) = 1 + countArrows rest
countArrows _ = 0

export terminatesExpression : PTok -> Bool
terminatesExpression (PTok (TSym ")") p) = True
terminatesExpression (PTok (TSym "]") p) = True
terminatesExpression (PTok (TSym ",") p) = True
terminatesExpression (PTok (TKw "else") p) = True
terminatesExpression (PTok (TKw "in") p) = True
terminatesExpression (PTok (TKw "then") p) = True
terminatesExpression _ = False

export badCaseIndent : PState -> Int -> Bool
badCaseIndent st altCol = if isEof st then False
else case peekPos st of
  Pos line col => if col > altCol then case terminatesExpression (peekTok st) of
    True => False
    False => True
  else False
