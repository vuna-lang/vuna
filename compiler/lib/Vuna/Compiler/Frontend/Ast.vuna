  ( Ctor(..)
  , DAxiom
  , DBind
  , DData
  , DExpr
  , DExtern
  , DFun
  , DInstance
  , DRecord
  , DSig
  , DTrait
  , Decl
  , DoStmt
  , EAnn
  , EApp
  , EBacktick
  , ECase
  , EDo
  , EField
  , EIf
  , EInfix
  , EInt
  , ELam
  , ELet
  , ELocalFun
  , EParen
  , EPi
  , ERecUpdate
  , ERecord
  , ESectL
  , ESectOp
  , ESectR
  , EStr
  , EVar
  , ExportItem
  , Expr
  , Field(..)
  , FixityDecl(..)
  , Import(..)
  , ModDecl(..)
  , PAs
  , PCon
  , PInt
  , PRecord
  , PStr
  , PVar
  , PWild
  , Pat
  , SourceFile(..)
  , TraitMethod(..)
  , XBare
  , XModule
  , XTypeAll
  , clausesFor
  , ctorArity
  , ctorName
  , ctorSpan
  , ctorType
  , ctorsOf
  , declDerivings
  , declNames
  , declSpan
  , doStmtExpr
  , doStmtSpan
  , exportItemSpan
  , exprSpan
