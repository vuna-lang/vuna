-- Vuna.Compiler.Frontend.Ast：core-v0/M10.5 的语法类型与 AST 辅助函数。
import Vuna.Compiler.Common

-- 记录字段：字段名 + 类型表达式 + span（M10.5）。
record Field where
  fieldName : String
  fieldType : Expr
  fieldSpan : Span

-- trait 方法签名：方法名 + 类型表达式 + span（M30 B20：span 覆盖「方法名到类型结束」，
-- 让方法级诊断/符号/注释锚点能落到方法行，而不是整条 trait 声明行）。
record TraitMethod where
  traitMethodName : String
  traitMethodType : Expr
  traitMethodSpan : Span

-- 多参数 trait 的显式 kind 参数：`trait C (a : Type) (r : Row)`；裸参数 kind = Nothing。
record TraitParam where
  traitParamName : String
  traitParamKind : Maybe Expr

data Pat : Type where
  PVar : String -> Span -> Pat
  -- as-pattern（`x@pat` / `(pat)@x`）：匹配内层模式，并把整个匹配值绑定到 x。
  PAs : String -> Pat -> Span -> Pat
  PWild : Span -> Pat
  PCon : String -> List Pat -> Span -> Pat
  PInt : Int -> Span -> Pat
  PStr : String -> Span -> Pat
  PRecord : String -> List (Pair String Pat) -> Span -> Pat

data InterpPart : Type where
  IPText : String -> InterpPart
  IPHole : Expr -> InterpPart

-- M38：显式 binder quantity。源码写法 `(0 x : A)` / `(1 x : A)`；不写 = ω。
-- 只列可写出的两档；`RigOmega` 由「没有 Qty」表示，不引入 ω 字形。
data Qty : Type where
  Q0 : Qty
  Q1 : Qty

qtyIsZero : Qty -> Bool
qtyIsZero Q0 = True
qtyIsZero Q1 = False

-- | R1（records-v2）：记录表示三档声明（`transparent record` / `record` / `opaque record`）。
-- `ReprAuto` = 未声明：回落到自动去装箱推断（R1 过渡；终态删除推断）。
-- `ReprTransparent` = 声明透明别名：构造/投影定义性恒等，要求擦除后恰好一个运行时字段。
-- `ReprOpaque` = 声明强制装箱（FFI/ABI 稳定）。档位进 DtData 与 iface（D7：声明优先）。
data ReprTier : Type where
  ReprAuto : ReprTier
  ReprTransparent : ReprTier
  ReprOpaque : ReprTier

-- | 档位的源码前缀（Fmt 用；`ReprAuto` 无前缀）。
reprPrefix : ReprTier -> String
reprPrefix ReprAuto = ""
reprPrefix ReprTransparent = "transparent "
reprPrefix ReprOpaque = "opaque "

data Expr : Type where
  EVar : String -> Span -> Expr
  EInt : Int -> Span -> Expr
  EStr : String -> Span -> Expr
  ELam : List String -> Expr -> Span -> Expr
  EApp : Expr -> List Expr -> Span -> Expr
  -- DT（M13）命名 Pi：`(x : A) -> B` 与隐式 `{x : A} -> B`。
  -- M38：第三个字段是显式 quantity（`Nothing` = 默认 ω）。
  -- 匿名 `A -> B` 仍沿用 `EApp (EVar "->") [A, B]` 编码（默认 ω）。
  EPi : String -> Bool -> Maybe Qty -> Expr -> Expr -> Span -> Expr
  ELet : List (Pair Pat Expr) -> Expr -> Bool -> Span -> Expr
  -- A2：局部函数组（where/let 内的多 clause 函数）。
  -- 只作为 `ELet` 绑定值出现：每个 clause 是「参数模式列表 + body」。
  -- 由 Elab 用 `Elab.Match.multiToExpr` 降级成 lambda + 模式矩阵（与顶层 DFun 同一路径）。
  ELocalFun : List (Pair (List Pat) Expr) -> Span -> Expr
  ECase : Expr -> List (Pair Pat Expr) -> Span -> Expr
  EIf : Expr -> Expr -> Expr -> Span -> Expr
  EField : Expr -> String -> Span -> Expr
  ERecord : String -> List (Pair String Expr) -> Span -> Expr
  ERecUpdate : Expr -> List (Pair String Expr) -> Span -> Expr
  EDo : List DoStmt -> Span -> Expr
  -- M31.2：中缀链与括号。parser 的**中间产物**：Loader 按 fixity 表重排并消除它们
  -- （`Loader.Resolve.reorderProgram`），Elab / codegen 永远不应看到（残留即 internal
  -- error）；Fmt / Index / Lsp 在 parse 后处理它们。
  EInfix : String -> Expr -> Expr -> Span -> Expr
  EParen : Expr -> Span -> Expr
  -- M31.3：反引号中缀 `` a `f` b ``（f 是普通值名或符号名；Loader 按名字查 fixity）。
  -- 与 EInfix/EParen 同属 parser 中间产物：rename 模式（Loader 正常路径）后不存在。
  EBacktick : String -> Expr -> Expr -> Span -> Expr
  -- M31.3：section：op 值 / 左 section / 右 section。同样是 parser 中间产物，
  -- Loader 在名字解析前消除成 EVar / lambda。
  ESectOp : String -> Span -> Expr
  ESectL : String -> Expr -> Span -> Expr
  ESectR : Expr -> String -> Span -> Expr
  -- M24：表达式类型标注。只由 parser 的 where 绑定签名生成（`g : Int -> Int` 行
  -- 绑定到随后的 `g ... = ...` 子句），Elab 精化时据此把 where 组按签名递归提升；
  -- 普通表达式位置不产生它，Fmt 在非 where 位置把它当透明括号渲染。
  EAnn : Expr -> Expr -> Span -> Expr
  -- M36：模板字符串字面量。`multi` = 是否 `"""` 形式（Fmt 用它保留书写形式；单行
  -- 字面量保持单行转义形式）。`Loader.Resolve` 把它降级成 `Base.Interp.interp`
  -- 调用 + `++` 链；Fmt / Lint / Index / Doc 在 parse 后处理它。
  EInterp : Bool -> List InterpPart -> Span -> Expr
  -- `Float` 字面量：原始十进制文本（放末尾以保持既有构造子 tag 顺序，bootstrap 兼容）。
  EFloat : String -> Span -> Expr

-- M31.2：fixity / 别名声明（`infixl 6 +`、`infixr 5 :: = Cons`、`infix 4 == = eq`）。
-- 只进入 `SourceFile.fixities`，由 Loader 在中缀重排时消费；**不进入 `Decl`**，避免所有
-- Decl 匹配点扩散。
record FixityDecl where
  fixityOp : String
  fixityLevel : Int
  fixityAssoc : Int
  fixityTarget : Maybe String
  fixitySpan : Span

fixitySpan : FixityDecl -> Span
fixitySpan (FixityDecl op level assoc target sp) = sp

-- do 语句（M11）：`pat <- expr` 或裸表达式；最后一条必须是裸表达式。
data DoStmt : Type where
  DBind : Pat -> Expr -> Span -> DoStmt
  DExpr : Expr -> Span -> DoStmt

record Ctor where
  ctorName : String
  ctorType : Expr
  ctorArity : Int
  ctorSpan : Span

data Decl : Type where
  -- M14：`data Name params : kind where`；kind 是索引族的类型表达式（HM 路径只接受 `Type`）。
  -- M38：末位 `Bool` 是 `lin data` 标记。
  -- M42：`derivings` 后的 `Bool` 是 `deriving via field` 标记（仅 record 允许）。
  -- R1：`viaField` 后的 `ReprTier` 是表示档位（data 恒为 `ReprAuto`，record 由
  -- `transparent`/`opaque` 前缀给出）；降级与 DtData 都要携带它。
  DData : String -> List String -> Expr -> List Ctor -> List String -> Bool -> ReprTier -> Bool -> Span -> Decl
  -- M28：`axiom name : Ty` —— 无体的可擦除/不透明顶层（决策 5 / D10）。
  -- 它是**类型层**定义：类型层引用合法，运行时使用由擦除检查报错。
  DAxiom : String -> Expr -> Span -> Decl
  -- M33 W5：受限 FFI：`extern "c_name" : Ty`（无体；运行时由 C 链接提供）。
  DExtern : String -> String -> Expr -> Span -> Decl
  -- M32：顶层签名可带 trait 约束上下文（`f : Eq a, Show b => τ`）；ctx 是约束表达式
  -- （洞形 `C arg`，每个都是单参数 trait 应用）。空 ctx = 无显式约束（旧形态）。
  DSig : String -> List Expr -> Expr -> Span -> Decl
  DFun : String -> List Pat -> Expr -> Span -> Decl
  -- M38：末位 `Bool` 是 `lin record` 标记（降级成 DData 时透传）。
  -- M42：`derivings` 后的 `Bool` 是 `deriving via field` 标记。
  -- R1：`viaField` 后的 `ReprTier` 是表示档位（`transparent`/`opaque` 前缀，缺省 `ReprAuto`）。
  DRecord : String -> List String -> List Field -> List String -> Bool -> ReprTier -> Bool -> Span -> Decl
  DTrait : String -> List TraitParam -> List TraitMethod -> Span -> Decl
  DInstance : List Expr -> Expr -> List Decl -> Span -> Decl

-- M10 模块头与导出项。
-- XBare 是裸名导出，XTypeAll 是 `T(..)`，XModule 是 `module B` 整模块重导出。
data ExportItem : Type where
  XBare : String -> Span -> ExportItem
  XTypeAll : String -> Span -> ExportItem
  XModule : String -> Span -> ExportItem

-- 模块头：模块名、是否写了显式导出列表、导出项、span。
record ModDecl where
  modDeclName : String
  modDeclHasExportList : Bool
  modDeclExportItems : List ExportItem
  modDeclSpan : Span

-- parser 的产物：可选模块头 + imports + fixity/别名声明 + 顶层声明。
record SourceFile where
  sourceFileModDecl : Maybe ModDecl
  sourceFileImports : List Import
  sourceFileFixities : List FixityDecl
  sourceFileDecls : List Decl

-- 各节点的源码 span 访问器。
patSpan : Pat -> Span
patSpan (PVar name sp) = sp
patSpan (PAs name inner sp) = sp
patSpan (PWild sp) = sp
patSpan (PCon name pats sp) = sp
patSpan (PInt n sp) = sp
patSpan (PStr s sp) = sp
patSpan (PRecord name fields sp) = sp

exprSpan : Expr -> Span
exprSpan (EVar name sp) = sp
exprSpan (EInfix op lhs rhs sp) = sp
exprSpan (EParen inner sp) = exprSpan inner
exprSpan (EBacktick name lhs rhs sp) = sp
exprSpan (ESectOp op sp) = sp
exprSpan (ESectL op rhs sp) = sp
exprSpan (ESectR lhs op sp) = sp
exprSpan (EInt n sp) = sp
exprSpan (EStr s sp) = sp
exprSpan (EFloat raw sp) = sp
exprSpan (ELam ps body sp) = sp
exprSpan (EApp fn args sp) = sp
exprSpan (EPi name implicit qty dom cod sp) = sp
exprSpan (ELet binds body _ sp) = sp
exprSpan (ELocalFun clauses sp) = sp
exprSpan (ECase scrut alts sp) = sp
exprSpan (EIf c t e sp) = sp
exprSpan (EField base f sp) = sp
exprSpan (ERecord name fields sp) = sp
exprSpan (ERecUpdate base fields sp) = sp
exprSpan (EDo stmts sp) = sp
exprSpan (EAnn inner ty sp) = sp
exprSpan (EInterp multi parts sp) = sp

doStmtSpan : DoStmt -> Span
doStmtSpan (DBind pat expr sp) = sp
doStmtSpan (DExpr expr sp) = sp

doStmtExpr : DoStmt -> Expr
doStmtExpr (DBind pat expr sp) = expr
doStmtExpr (DExpr expr sp) = expr

declSpan : Decl -> Span
declSpan (DData name params kind ctors derivings viaField repr lin sp) = sp
declSpan (DAxiom name ty sp) = sp
declSpan (DExtern name cName ty sp) = sp
declSpan (DSig name ctx ty sp) = sp
declSpan (DFun name pats body sp) = sp
declSpan (DRecord name params fields derivings viaField repr lin sp) = sp
declSpan (DTrait name params methods sp) = sp
declSpan (DInstance ctxE head methods sp) = sp

ctorSpan : Ctor -> Span
ctorSpan (Ctor name ty arity sp) = sp

fieldSpan : Field -> Span
fieldSpan (Field name ty sp) = sp

fieldName : Field -> String
fieldName (Field name ty sp) = name

fieldType : Field -> Expr
fieldType (Field name ty sp) = ty

traitMethodName : TraitMethod -> String
traitMethodName (TraitMethod name ty sp) = name

traitMethodSpan : TraitMethod -> Span
traitMethodSpan (TraitMethod name ty sp) = sp

record Import where
  importName : String
  importIsQualified : Bool
  importAlias : Maybe String
  importSpan : Span

exportItemSpan : ExportItem -> Span
exportItemSpan (XBare name sp) = sp
exportItemSpan (XTypeAll name sp) = sp
exportItemSpan (XModule name sp) = sp

collectClauses : List Decl -> String -> List (Pair (List Pat) Expr)
collectClauses [] name = []
collectClauses (d :: rest) name = case d of
  DFun n pats body _ =>
    if n == name then Pair pats body :: collectClauses rest name else collectClauses rest name
  _ => collectClauses rest name

clausesFor : List Decl -> String -> List (Pair (List Pat) Expr)
clausesFor decls name = collectClauses decls name

funArity : String -> List Decl -> Maybe Int
funArity name decls = case clausesFor decls name of
  [] => Nothing
  (Pair pats body) :: _ => Just (natToInt (length pats))

ctorName : Ctor -> String
ctorName (Ctor name ty arity _) = name

-- canonical 构造子名的最后一段（短名）。data 构造子的 canonical 形如
-- `Module.Data.Ctor`（entry 文件是 `Data.Ctor`），短名用于族内查找/OCaml 名字/诊断。
-- | 自动补注（M41 新增导出）：ctorShortName。
ctorShortName : String -> String
ctorShortName name = secondOf (splitLastDot (splitOnDot name))

-- 用户可见的构造子名：`FamilyShort.Ctor`（单段名原样返回）。
-- 不用完整的 `Module.Data.Ctor`：那会把模块路径泄漏进诊断。
-- | 自动补注（M41 新增导出）：ctorDisplayName。
ctorDisplayName : String -> String
ctorDisplayName name = case splitLastDot (splitOnDot name) of
  Pair [] base => base
  Pair revPrefix base => case reverse revPrefix of
    [] => base
    fam :: rest => "${fam}.${base}"

ctorType : Ctor -> Expr
ctorType (Ctor name ty arity _) = ty

typeArity : Expr -> Int
typeArity (EApp (EVar "->" _) ([x, rest]) _) = 1 + typeArity rest
typeArity _ = 0

lookupCtorArity : String -> List Ctor -> Maybe Int
lookupCtorArity name [] = Nothing
lookupCtorArity name (c :: rest) =
  if ctorName c == name then Just c.ctorArity else lookupCtorArity name rest

ctorArity : String -> List Decl -> Maybe Int
ctorArity name [] = Nothing
ctorArity name (d :: rest) = case d of
  DData dname params kind ctors derivings viaField repr lin sp => case lookupCtorArity name ctors of
    Just arity => Just arity
    Nothing => ctorArity name rest
  DRecord dname params fields derivings viaField repr lin sp =>
    if name == dname then Just (natToInt (length fields)) else ctorArity name rest
  _ => ctorArity name rest

declNames : Decl -> List String
declNames (DFun name pats body _) = [name]
declNames (DAxiom name ty _) = [name]
declNames (DExtern name cName ty _) = [name]
declNames (DSig name ctx ty _) = [name]
declNames (DData dname params kind ctors derivings viaField repr lin _) = map ctorName ctors
declNames (DRecord dname params fields derivings viaField repr lin _) = [dname]
declNames (DTrait tname params methods _) = map traitMethodName methods
declNames (DInstance ctxE head methods _) = []

-- 顶层可见名字（M20：把 data / record / trait 的**类型名**也算进来）。
-- Loader 用它判断「是不是本模块声明的名字」；DT 的类型名可以在值层位置出现
-- （`Vec n Nat` 的 `Nat`），所以必须一并认出来。语义仍由下游检查器决定。
topNames : List Decl -> List String
topNames decls = concatMap declNames decls

declAllNames : Decl -> List String
declAllNames (DData dname params kind ctors derivings viaField repr lin _) =
  dname :: map ctorName ctors
declAllNames (DRecord dname params fields derivings viaField repr lin _) = [dname]
declAllNames (DTrait tname params methods _) = tname :: map traitMethodName methods
declAllNames d = declNames d

_declCtors : Decl -> List String
_declCtors (DData dname params kind ctors derivings viaField repr lin _) = map ctorName ctors
_declCtors (DRecord dname params fields derivings viaField repr lin _) = [dname]
_declCtors (DTrait tname params methods _) = map traitMethodName methods
_declCtors _ = []

ctorsOf : List Decl -> List String
ctorsOf decls = concatMap _declCtors decls

declTypeNames : Decl -> List String
declTypeNames (DData name params kind ctors derivings viaField repr lin _) = [name]
declTypeNames (DRecord name params fields derivings viaField repr lin _) = [name]
declTypeNames (DTrait name params methods _) = [name]
declTypeNames _ = []

typeNamesOf : List Decl -> List String
typeNamesOf decls = concatMap declTypeNames decls

declDerivings : Decl -> List String
declDerivings (DData name params kind ctors derivings viaField repr lin _) = derivings
declDerivings (DRecord name params fields derivings viaField repr lin _) = derivings
declDerivings _ = []

-- ---------------------------------------------------------------
-- 洞名（M40）：匿名洞是 `_`；命名洞写成 `?name`。
-- parser 把 `?name` 编码成 `EVar "?name"`（**不新增 AST 构造子**，Fmt/Lint/Doc/Usage/
-- Termination/Codegen 的结构遍历因此零改动）；洞名判定是唯一真源，Loader 放行、
-- 精化器建 goal、索引引用过滤都走这里。
-- ---------------------------------------------------------------
isHoleName : String -> Bool
isHoleName name = name == "_" || holeNamed name

holeNamed : String -> Bool
holeNamed name = case strUnpack name of
  63 :: _ :: _ => True
  _ => False

-- 洞的显示名：`_` → ""（匿名）；`?name` → "?name"。
holeNameOf : String -> String
holeNameOf name = if holeNamed name then name else ""

-- ---------------------------------------------------------------
-- M41：Loader → Elab 的内部引用编码
-- ---------------------------------------------------------------
-- 与 `?hole` 同一先例：不新增 AST 构造子，用保留名编码，Fmt/Lint/Doc/Index 等
-- parse 阶段的结构遍历因此零改动（这些名字只在 Loader 之后出现，且不参与用户符号）。
--   `@vuna@ctor@<短名>@<候选 canonical 1>@<候选 canonical 2>...`
-- | 自动补注（M41 新增导出）：internalNamePrefix。
internalNamePrefix : String
internalNamePrefix = "@vuna@"

-- | 自动补注（M41 新增导出）：overCtorPrefix。
overCtorPrefix : String
overCtorPrefix = "@vuna@ctor@"

-- | 自动补注（M41 新增导出）：isInternalSyntaxName。
isInternalSyntaxName : String -> Bool
isInternalSyntaxName name = startsWith internalNamePrefix name

-- | 自动补注（M41 新增导出）：dropNChars。
dropNChars : Int -> List Int -> List Int
dropNChars n xs = if n <= 0 then xs
else case xs of
  [] => []
  _ :: rest => dropNChars (n - 1) rest

-- | 自动补注（M41 新增导出）：dropNamePrefix。
dropNamePrefix : String -> String -> String
dropNamePrefix p name =
  if startsWith p name then strPack (dropNChars (strLength p) (strUnpack name)) else name

-- | 自动补注（M41 新增导出）：joinWithAt。
joinWithAt : List String -> String
joinWithAt [] = ""
joinWithAt ([x]) = x
joinWithAt (x :: rest) = "${x}@${joinWithAt rest}"

-- | 自动补注（M41 新增导出）：overCtorName。
overCtorName : String -> List String -> String
overCtorName short targets = "${overCtorPrefix}${short}@${joinWithAt targets}"

-- | 自动补注（M41 新增导出）：overCtorShort。
overCtorShort : String -> String
overCtorShort name = case splitOnChar 64 (dropNamePrefix overCtorPrefix name) of
  [] => ""
  s :: rest => s

-- | 自动补注（M41 新增导出）：overCtorTargets。
overCtorTargets : String -> List String
overCtorTargets name = case splitOnChar 64 (dropNamePrefix overCtorPrefix name) of
  [] => []
  s :: rest => rest

-- | 自动补注（M41 新增导出）：isOverCtorName。
isOverCtorName : String -> Bool
isOverCtorName name = startsWith overCtorPrefix name

-- M41：列表字面量的保留名（parser 产出；Loader 原样放行；Elab 按期望族的 Nil/Cons
-- 通用展开）。不再借裸 `Nil`/`Cons` 走构造子名字解析。
-- | 自动补注（M41 新增导出）：listNilSyntax。
listNilSyntax : String
listNilSyntax = "@vuna@list@nil"

-- | 自动补注（M41 新增导出）：listConsSyntax。
listConsSyntax : String
listConsSyntax = "@vuna@list@cons"

-- | 自动补注（M41 新增导出）：isListNilSyntax。
isListNilSyntax : String -> Bool
isListNilSyntax name = name == listNilSyntax

-- | 自动补注（M41 新增导出）：isListConsSyntax。
isListConsSyntax : String -> Bool
isListConsSyntax name = name == listConsSyntax

-- ---------------------------------------------------------------
-- S3：do 块的内部标记链（carrier C）
-- ---------------------------------------------------------------
-- 与 `@vuna@ctor@...` 同一先例：不新增 AST 构造子，用保留名编码。`Resolver` 把 do 降级
-- 成嵌套的 `EApp+ELam` 链（语句边界 / binder 名 / 语句 span 都仍编码在这条链上），但把每个
-- 节点的头部换成携带 **块作用域里解析出的 bind canonical 名** 的内部标记：
--
--   `@vuna@do@bind@<canonical>`    —— `pat <- e`（binder 是用户变量名）
--   `@vuna@do@ignore@<canonical>`  —— `_ <- e` / 裸语句 `e`（binder 是丢弃名）
--
-- 标记名只由 Loader 在 rename 之后产生，用户源码无法写出 `@vuna@` 开头的标识符；于是
-- Elab 可以把整块按「一个 monad / 一个字典」精化，而不必逐个节点重新做名字解析。不认识
-- 标记的精化器（以及任何形状不符/回退路径）可以剥掉标记、用 canonical 名还原成普通
-- `bind` 应用——语义与今天的降级逐字一致。
-- native-effects N1（ND12）：`perform <op>` 的保留名编码。parser 产出
-- `EApp (EVar "@vuna@perform") [op]`；Elab 按 op 族推导 key（族规范名）、实例名
-- （行解 / 默认名）与 res 族（`res<族短名>`），再降级到 `Base.Eff.performCore`。
-- 用户源码写不出 `@vuna@` 开头的标识符，所以标记不会与用户名字冲突。
-- | 自动补注（N1 新增导出）：performSyntax。
performSyntax : String
performSyntax = "@vuna@perform"

-- | 自动补注（N1 新增导出）：isPerformSyntax。
isPerformSyntax : String -> Bool
isPerformSyntax name = name == performSyntax

-- native-effects N1（提交 4b）：`handle <comp> { ... }` 的保留名编码（ND12）。parser 产出
-- `EApp (EVar "@vuna@handle") [comp, ret, opH]`：
--   * `comp` 是被 handler 包裹的动作；
--   * `ret` 是 `ELam [x] body`；没有 return 子句时是哨兵 `EVar "@vuna@handle@noret"`
--     （Fmt 据此不打印 return 子句）；
--   * `opH` 是 `ELam [o, k] (ECase (EVar o) alts)`：每个 alt 的 pattern 只含构造子实参，
--     续延 binder `k` 是 λ 的第二个参数（同一 handle 块的所有 op 子句共用这个名字）。
-- Elab 从 clause 构造子推 op 族，再降级到 `Base.Eff.handleWith`。
-- | 自动补注（N1 提交 4b 新增导出）：handleSyntax。
handleSyntax : String
handleSyntax = "@vuna@handle"

-- | 自动补注（N1 提交 4b 新增导出）：isHandleSyntax。
isHandleSyntax : String -> Bool
isHandleSyntax name = name == handleSyntax

-- | 自动补注（N1 提交 4b 新增导出）：handleNoRetSyntax（无 return 子句的哨兵）。
handleNoRetSyntax : String
handleNoRetSyntax = "@vuna@handle@noret"

-- | 自动补注（N1 提交 4b 新增导出）：isHandleNoRetSyntax。
isHandleNoRetSyntax : String -> Bool
isHandleNoRetSyntax name = name == handleNoRetSyntax

-- native-effects N1（ND4）：行字面量里的显式实例名 `X@name`，编码成
-- `EApp (EVar "@vuna@row@at") [X, name]`；只在行字面量展开时被解释。
-- | 自动补注（N1 新增导出）：rowAtSyntax。
rowAtSyntax : String
rowAtSyntax = "@vuna@row@at"

-- | 自动补注（N1 新增导出）：isRowAtSyntax。
isRowAtSyntax : String -> Bool
isRowAtSyntax name = name == rowAtSyntax

-- ---------------------------------------------------------------
-- 内置宏：`name!` 调用的保留名编码
-- ---------------------------------------------------------------
-- 与 `@vuna@perform` / `@vuna@handle` 同一先例：**不新增 AST 构造子**，parser 把
-- `name! args` 编码成 `EApp (EVar "@vuna@macro@name") args`（无参时是裸 `EVar`）。
-- Loader 在名字解析前把标记展开成真正表达式，所以 Elab / Codegen / 缓存 / 无损 CST
-- 都看不到标记；Fmt 反向把标记渲染回 `name!`，Index 过滤标记引用。用户源码写不出
-- `@vuna@` 开头的标识符，标记不会与用户名字冲突。
-- | 宏调用标记的前缀（parser 产出、Loader 展开、Fmt 回渲染共用的唯一真源）。
macroSyntaxPrefix : String
macroSyntaxPrefix = "@vuna@macro@"

-- | 由宏名生成 parser / Loader 之间的标记名。
macroSyntaxName : String -> String
macroSyntaxName name = "${macroSyntaxPrefix}${name}"

-- | 是否是宏调用标记名（`@vuna@macro@<name>`）。
isMacroSyntaxName : String -> Bool
isMacroSyntaxName name = startsWith macroSyntaxPrefix name

-- | 宏调用标记名 → 用户书写的宏名（非标记返回 `Nothing`）。
macroNameOf : String -> Maybe String
macroNameOf name =
  if isMacroSyntaxName name then Just (dropNamePrefix macroSyntaxPrefix name) else Nothing

-- | 自动补注（S3 新增导出）：doBindSyntaxPrefix。
doBindSyntaxPrefix : String
doBindSyntaxPrefix = "@vuna@do@bind@"

-- | 自动补注（S3 新增导出）：doIgnoreSyntaxPrefix。
doIgnoreSyntaxPrefix : String
doIgnoreSyntaxPrefix = "@vuna@do@ignore@"

-- | 自动补注（S3 新增导出）：doBindSyntaxName。
doBindSyntaxName : String -> String
doBindSyntaxName canonical = "${doBindSyntaxPrefix}${canonical}"

-- | 自动补注（S3 新增导出）：doIgnoreSyntaxName。
doIgnoreSyntaxName : String -> String
doIgnoreSyntaxName canonical = "${doIgnoreSyntaxPrefix}${canonical}"

-- | 自动补注（S3 新增导出）：isDoBindSyntaxName。
isDoBindSyntaxName : String -> Bool
isDoBindSyntaxName name = startsWith doBindSyntaxPrefix name

-- | 自动补注（S3 新增导出）：isDoIgnoreSyntaxName。
isDoIgnoreSyntaxName : String -> Bool
isDoIgnoreSyntaxName name = startsWith doIgnoreSyntaxPrefix name

-- 标记头里的 canonical bind 名；不是 do 标记头返回 `Nothing`。
-- | 自动补注（S3 新增导出）：doSyntaxCanonical。
doSyntaxCanonical : String -> Maybe String
doSyntaxCanonical name =
  if isDoBindSyntaxName name then Just (dropNamePrefix doBindSyntaxPrefix name)
  else if isDoIgnoreSyntaxName name then Just (dropNamePrefix doIgnoreSyntaxPrefix name) else Nothing
