module Vuna.Compiler.Frontend.Ast
  ( Ctor
  , DAxiom
  , DBind
  , DData
  , DExpr
  , DFun
  , DInstance
  , DRecord
  , DSig
  , DTrait
  , Decl
  , DoStmt
  , EAnn
  , EApp
  , ECase
  , EDo
  , EField
  , EIf
  , EInstSel
  , EInt
  , ELam
  , ELet
  , EPi
  , ERecUpdate
  , ERecord
  , EStr
  , EVar
  , ExportItem
  , Expr
  , Field
  , Import
  , ModDecl
  , PCon
  , PInt
  , PRecord
  , PStr
  , PVar
  , PWild
  , Pat
  , Source
  , SourceFile
  , XBare
  , XModule
  , XTypeAll
  , clausesFor
  , ctorArity
  , ctorArityOf
  , ctorName
  , ctorSpan
  , ctorType
  , ctorsOf
  , declDerivings
  , declNames
  , declSpan
  , doStmtExpr
  , doStmtSpan
  , exportItemSpan
  , exprSpan
  , fieldName
  , fieldSpan
  , fieldType
  , funArity
  , importSpan
  , modDeclSpan
  , patSpan
  , topNames
  , typeNamesOf
  ) where

-- Vuna.Compiler.Frontend.Ast：core-v0/M10.5 的语法类型与 AST 辅助函数。
import Vuna.Compiler.Common

-- 记录字段：字段名 + 类型表达式 + span（M10.5）。
data Field : Type where
  Field : String -> Expr -> Span -> Field

data Pat : Type where
  PVar : String -> Span -> Pat
  PWild : Span -> Pat
  PCon : String -> List Pat -> Span -> Pat
  PInt : Int -> Span -> Pat
  PStr : String -> Span -> Pat
  PRecord : String -> List (Pair String Pat) -> Span -> Pat

data Expr : Type where
  EVar : String -> Span -> Expr
  EInt : Int -> Span -> Expr
  EStr : String -> Span -> Expr
  ELam : List String -> Expr -> Span -> Expr
  EApp : Expr -> List Expr -> Span -> Expr
  -- DT（M13）命名 Pi：`(x : A) -> B` 与隐式 `{x : A} -> B`。
  -- 匿名 `A -> B` 仍沿用 `EApp (EVar "->") [A, B]` 编码（既有路径零改动）。
  EPi : String -> Bool -> Expr -> Expr -> Span -> Expr
  ELet : List (Pair Pat Expr) -> Expr -> Bool -> Span -> Expr
  ECase : Expr -> List (Pair Pat Expr) -> Span -> Expr
  EIf : Expr -> Expr -> Expr -> Span -> Expr
  EField : Expr -> String -> Span -> Expr
  ERecord : String -> List (Pair String Expr) -> Span -> Expr
  ERecUpdate : Expr -> List (Pair String Expr) -> Span -> Expr
  EInstSel : Expr -> String -> Span -> Expr
  EDo : List DoStmt -> Span -> Expr
  -- M24：表达式类型标注。只由 parser 的 where 绑定签名生成（`g : Int -> Int` 行
  -- 绑定到随后的 `g ... = ...` 子句），Elab 精化时据此把 where 组按签名递归提升；
  -- 普通表达式位置不产生它，Fmt 在非 where 位置把它当透明括号渲染。
  EAnn : Expr -> Expr -> Span -> Expr

-- do 语句（M11）：`pat <- expr` 或裸表达式；最后一条必须是裸表达式。
data DoStmt : Type where
  DBind : Pat -> Expr -> Span -> DoStmt
  DExpr : Expr -> Span -> DoStmt

data Ctor : Type where
  Ctor : String -> Expr -> Int -> Span -> Ctor

data Decl : Type where
  -- M14：`data Name params : kind where`；kind 是索引族的类型表达式（HM 路径只接受 `Type`）。
  DData : String -> List String -> Expr -> List Ctor -> List String -> Span -> Decl
  -- M28：`axiom name : Ty` —— 无体的可擦除/不透明顶层（决策 5 / D10）。
  -- 它是**类型层**定义：类型层引用合法，运行时使用由擦除检查报错。
  DAxiom : String -> Expr -> Span -> Decl
  DSig : String -> Expr -> Span -> Decl
  DFun : String -> List Pat -> Expr -> Span -> Decl
  DRecord : String -> List String -> List Field -> List String -> Span -> Decl
  DTrait : String -> List String -> List (Pair String Expr) -> Span -> Decl
  DInstance : Maybe String -> Bool -> Expr -> List Decl -> Span -> Decl

-- M10 模块头与导出项。
-- XBare 是裸名导出，XTypeAll 是 `T(..)`，XModule 是 `module B` 整模块重导出。
data ExportItem : Type where
  XBare : String -> Span -> ExportItem
  XTypeAll : String -> Span -> ExportItem
  XModule : String -> Span -> ExportItem

-- 模块头：模块名、是否写了显式导出列表、导出项、span。
data ModDecl : Type where
  ModDecl : String -> Bool -> List ExportItem -> Span -> ModDecl

-- parser 的产物：可选模块头 + imports + 顶层声明。
data SourceFile : Type where
  Source : Maybe ModDecl -> List Import -> List Decl -> SourceFile

-- 各节点的源码 span 访问器。
patSpan : Pat -> Span
patSpan pat = case pat of
  PVar name sp => sp
  PWild sp => sp
  PCon name pats sp => sp
  PInt n sp => sp
  PStr s sp => sp
  PRecord name fields sp => sp

exprSpan : Expr -> Span
exprSpan expr = case expr of
  EVar name sp => sp
  EInt n sp => sp
  EStr s sp => sp
  ELam ps body sp => sp
  EApp fn args sp => sp
  EPi name implicit dom cod sp => sp
  ELet binds body _ sp => sp
  ECase scrut alts sp => sp
  EIf c t e sp => sp
  EField base f sp => sp
  ERecord name fields sp => sp
  ERecUpdate base fields sp => sp
  EInstSel meth name sp => sp
  EDo stmts sp => sp
  EAnn inner ty sp => sp

doStmtSpan : DoStmt -> Span
doStmtSpan stmt = case stmt of
  DBind pat expr sp => sp
  DExpr expr sp => sp

doStmtExpr : DoStmt -> Expr
doStmtExpr stmt = case stmt of
  DBind pat expr sp => expr
  DExpr expr sp => expr

declSpan : Decl -> Span
declSpan decl = case decl of
  DData name params kind ctors derivings sp => sp
  DAxiom name ty sp => sp
  DSig name ty sp => sp
  DFun name pats body sp => sp
  DRecord name params fields derivings sp => sp
  DTrait name params methods sp => sp
  DInstance name isDefault head methods sp => sp

ctorSpan : Ctor -> Span
ctorSpan (Ctor name ty arity sp) = sp

fieldSpan : Field -> Span
fieldSpan (Field name ty sp) = sp

fieldName : Field -> String
fieldName (Field name ty sp) = name

fieldType : Field -> Expr
fieldType (Field name ty sp) = ty

data Import : Type where
  Import : String -> Bool -> Maybe String -> Span -> Import

importSpan : Import -> Span
importSpan (Import name isQualified alias sp) = sp

modDeclSpan : ModDecl -> Span
modDeclSpan (ModDecl name explicit items sp) = sp

exportItemSpan : ExportItem -> Span
exportItemSpan item = case item of
  XBare name sp => sp
  XTypeAll name sp => sp
  XModule name sp => sp

collectClauses : List Decl -> String -> List (Pair (List Pat) Expr)
collectClauses [] name = []
collectClauses (d :: rest) name = case d of
  DFun n pats body _ =>
    if n == name then Pair pats body :: collectClauses rest name else collectClauses rest name
  _ => collectClauses rest name

clausesFor : List Decl -> String -> List (Pair (List Pat) Expr)
clausesFor decls name = collectClauses decls name

funArity : String -> List Decl -> Maybe Int
funArity name decls = case clausesFor decls name of
  [] => Nothing
  (Pair pats body) :: _ => Just (length pats)

ctorName : Ctor -> String
ctorName (Ctor name ty arity _) = name

ctorType : Ctor -> Expr
ctorType (Ctor name ty arity _) = ty

typeArity : Expr -> Int
typeArity ty = case ty of
  EApp (EVar "->" _) ([x, rest]) _ => 1 + typeArity rest
  _ => 0

ctorArityOf : Ctor -> Int
ctorArityOf (Ctor name ty arity _) = arity

lookupCtorArity : String -> List Ctor -> Maybe Int
lookupCtorArity name ctors = case ctors of
  [] => Nothing
  c :: rest => if ctorName c == name then Just (ctorArityOf c) else lookupCtorArity name rest

ctorArity : String -> List Decl -> Maybe Int
ctorArity name decls = case decls of
  [] => Nothing
  d :: rest => case d of
    DData dname params kind ctors derivings sp => case lookupCtorArity name ctors of
      Just arity => Just arity
      Nothing => ctorArity name rest
    DRecord dname params fields derivings sp =>
      if name == dname then Just (length fields) else ctorArity name rest
    _ => ctorArity name rest

declNames : Decl -> List String
declNames d = case d of
  DFun name pats body _ => [name]
  DAxiom name ty _ => [name]
  DSig name ty _ => [name]
  DData dname params kind ctors derivings _ => map ctorName ctors
  DRecord dname params fields derivings _ => [dname]
  DTrait tname params methods _ => map firstOf methods
  DInstance name isDefault head methods _ => case name of
    Nothing => []
    Just n => [n]

-- 顶层可见名字（M20：把 data / record / trait 的**类型名**也算进来）。
-- Loader 用它判断「是不是本模块声明的名字」；DT 的类型名可以在值层位置出现
-- （`Vec Nat n` 的 `Nat`），所以必须一并认出来。语义仍由下游检查器决定。
topNames : List Decl -> List String
topNames decls = concatMap declNames decls

declAllNames : Decl -> List String
declAllNames d = case d of
  DData dname params kind ctors derivings _ => dname :: map ctorName ctors
  DRecord dname params fields derivings _ => [dname]
  DTrait tname params methods _ => tname :: map firstOf methods
  _ => declNames d

_declCtors : Decl -> List String
_declCtors d = case d of
  DData dname params kind ctors derivings _ => map ctorName ctors
  DRecord dname params fields derivings _ => [dname]
  DTrait tname params methods _ => map firstOf methods
  _ => []

ctorsOf : List Decl -> List String
ctorsOf decls = concatMap _declCtors decls

declTypeNames : Decl -> List String
declTypeNames d = case d of
  DData name params kind ctors derivings _ => [name]
  DRecord name params fields derivings _ => [name]
  DTrait name params methods _ => [name]
  _ => []

typeNamesOf : List Decl -> List String
typeNamesOf decls = concatMap declTypeNames decls

declDerivings : Decl -> List String
declDerivings d = case d of
  DData name params kind ctors derivings _ => derivings
  DRecord name params fields derivings _ => derivings
  _ => []
