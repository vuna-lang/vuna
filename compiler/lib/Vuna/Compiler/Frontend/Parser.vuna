module Vuna.Compiler.Frontend.Parser (parseExpressionSource, parseSource) where

-- vuna 源码 parser：offside layout，返回 AST 与 imports。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Diagnostics
import Vuna.Compiler.Frontend.Lexer
import Vuna.Compiler.Frontend.Parser.Support

parseSource : String -> String -> Result SourceFile
parseSource file source =
  andThen (lexSource source)
    (\toks => andThen (parseSourceFile (PState file toks (Pos 1 0) (length toks))) (\p => Ok (firstOf p)))

-- 单表达式解析（REPL / 工具用）：整段输入必须恰好是一个表达式。
parseExpressionSource : String -> Result Expr
parseExpressionSource source =
  andThen (lexSource source)
    (\toks => step (parseExpr (stateFuel (PState "<expr>" toks (Pos 1 0) (length toks))) (PState "<expr>" toks (Pos 1 0) (length toks)) 0 0) (\e, st => if isEof st then Ok e else psErr0 ExpectedEndOfExpr))

-- 可选模块头（M10）：`module M (导出项, ...) where`；列表省略 = 导出全部。
parseSourceFile : PState -> Result (Pair SourceFile PState)
parseSourceFile st = step (parseModDecl st) (\hdr, st1 => step (parseImports (stateFuel st1) st1) (\imports, st2 => if isEof st2 then Ok (Pair (Source hdr imports []) st2)
else case peekPos st2 of
  Pos line col =>
    step (parseDecls (stateFuel st2) st2 col)
      (\decls, st3 => if isEof st3 then Ok (Pair (Source hdr imports decls) st3) else psErr0 ExpectedEndOfInput)
)
)

parseModDecl : PState -> Result (Pair (Maybe ModDecl) PState)
parseModDecl st =
  if atKw st "module" then step (expectKw st "module")
    (\_, st1 => step (expectIdent st1) (\name, st2 => if atSym st2 "(" then step (parseExportItems st2) (\items, st3 => step (expectKw st3 "where") (\_, st4 => Ok (Pair (Just (ModDecl name True items (spanOf st st4))) st4))) else step (expectKw st2 "where") (\_, st3 => Ok (Pair (Just (ModDecl name False [] (spanOf st st3))) st3))))
  else Ok (Pair Nothing st)

parseExportItems : PState -> Result (Pair (List ExportItem) PState)
parseExportItems st =
  step (expectSym st "(")
    (\_, st1 => if atSym st1 ")" then Ok (Pair [] (advance st1)) else parseExportItemsFrom (stateFuel st1) st1)

parseExportItemsFrom : Int -> PState -> Result (Pair (List ExportItem) PState)
parseExportItemsFrom fuel st =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parseExportItem st)
    (\item, st1 => if atSym st1 "," then step (parseExportItemsFrom (fuel - 1) (advance st1)) (\rest, st2 => Ok (Pair (item :: rest) st2)) else step (expectSym st1 ")") (\_, st2 => Ok (Pair [item] st2)))

parseExportItem : PState -> Result (Pair ExportItem PState)
parseExportItem st = case peekTok st of
  PTok (TKw "module") p =>
    step (expectKw st "module")
      (\_, st1 => step (expectIdent st1) (\name, st2 => Ok (Pair (XModule name (spanOf st st2)) st2)))
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 "(" then step (expectSym st1 "(")
      (\_, st2 => step (expectSym st2 "..") (\_, st3 => step (expectSym st3 ")") (\_, st4 => Ok (Pair (XTypeAll name (spanOf st st4)) st4))))
    else Ok (Pair (XBare name (spanOf st st1)) st1)
  _ => psErr0 ExpectedExportItem

parseImportSpec : PState -> Result (Pair Import PState)
parseImportSpec st =
  step (expectKw st "import")
    (\_, st1 => if atKw st1 "qualified" then step (expectKw st1 "qualified") (\_, st2 => parseImportAlias st2 True) else parseImportAlias st1 False)

parseImportAlias : PState -> Bool -> Result (Pair Import PState)
parseImportAlias st isQualified =
  step (expectIdent st)
    (\name, st1 => if atKw st1 "as" then step (expectKw st1 "as") (\_, st2 => step (expectIdent st2) (\alias, st3 => Ok (Pair (Import name isQualified (Just alias) (spanOf st st3)) st3))) else Ok (Pair (Import name isQualified Nothing (spanOf st st1)) st1))

parseImports : Int -> PState -> Result (Pair (List Import) PState)
parseImports fuel st =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if atKw st "import" then step (parseImportSpec st)
    (\imp, st1 => step (parseImports (fuel - 1) st1) (\rest, st2 => Ok (Pair (imp :: rest) st2)))
  else Ok (Pair [] st)

parseDecls : Int -> PState -> Int -> Result (Pair (List Decl) PState)
parseDecls fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col == blockCol then step (parseDecl st blockCol)
      (\decl, st1 => step (parseDecls (fuel - 1) st1 blockCol) (\rest, st2 => Ok (Pair (decl :: rest) st2)))
    else psErr1 (ExpectedDeclAtColumn (strFromInt blockCol)) (strFromInt blockCol)

parseDecl : PState -> Int -> Result (Pair Decl PState)
parseDecl st blockCol = case peekTok st of
  PTok (TKw "data") p => parseData st blockCol p
  PTok (TKw "axiom") p => parseAxiom st blockCol p
  PTok (TKw "record") p => parseRecord st blockCol p
  PTok (TKw "trait") p => parseTrait st blockCol p
  PTok (TKw "instance") p => parseInstance st blockCol p
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 ":" then parseSignature st1 blockCol name p else parseClause st1 blockCol name p
  _ => psErr0 ExpectedTopLevelDecl

-- M28 axiom 声明（决策 5 / D10）：`axiom name : Ty`，无 `=` 体。
-- 它是无体的可擦除顶层，只在类型层可用（运行时使用由擦除检查拒绝）。
parseAxiom : PState -> Int -> Pos -> Result (Pair Decl PState)
parseAxiom st blockCol kwPos =
  step (expectKw st "axiom")
    (\_, st1 => step (expectIdent st1) (\name, st2 => step (expectSym st2 ":") (\_, st3 => step (parseExpr (stateFuel st3) st3 blockCol 0) (\ty, st4 => Ok (Pair (DAxiom name ty (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st4)) (posCol (lastPos st4)))) st4)))))

parseSignature : PState -> Int -> String -> Pos -> Result (Pair Decl PState)
parseSignature st blockCol name namePos =
  step (expectSym st ":")
    (\_, st1 => step (parseExpr (stateFuel st1) st1 blockCol 0) (\ty, st2 => Ok (Pair (DSig name ty (Span (fileOf st) (posLine namePos) (posCol namePos) (posLine (lastPos st2)) (posCol (lastPos st2)))) st2)))

parseClause : PState -> Int -> String -> Pos -> Result (Pair Decl PState)
parseClause st blockCol name namePos = step (parseClausePatterns (stateFuel st) st blockCol) (\pats, st1 => step (expectSym st1 "=") (\_, st2 => step (parseExpr (stateFuel st2) st2 blockCol 0) (\body, st3 => step (parseWhere st3 blockCol) (\wheres, st4 => let
  body2 = case wheres of
    [] => body
    _ :: _ => ELet wheres body True (spanOf st st4)
in Ok
  (Pair (DFun name pats body2 (Span (fileOf st) (posLine namePos) (posCol namePos) (posLine (lastPos st4)) (posCol (lastPos st4)))) st4)
)
)
)
)

-- where 块：`body where\n  <bindings>`，解析后 desugar 成 ELet（绑定对 body 可见）。
--
-- ---------------------------------------------------------------
-- 绑定块（M28 统一作用域模型，决策 5）：`where` 与 `let` 共用同一套绑定块解析：
--   * 每个绑定可先写一行签名 `name : Ty`（必须写在同名子句**之前**）；
--   * 子句可以是 `pat = expr` 或函数子句 `name pats = expr`（降级成 λ）。
-- 有签名的绑定把签名贴到紧随其后的同名子句值上（`EAnn value ty`，span 指向签名行），
-- Elab 据此在 checking 模式精化该值。两条记法只差一条：`where` 块**要求**每个绑定都有
-- 签名行（由 Elab 的 `checkBindingSigs` 用一个诊断收口），`let` 的签名是可选的。
-- ---------------------------------------------------------------
parseWhere : PState -> Int -> Result (Pair (List (Pair Pat Expr)) PState)
parseWhere st blockCol = case peekTok st of
  PTok (TKw "where") p =>
    if posCol p > blockCol then step (Ok (Pair 0 (advance st)))
      (\_, st1 => step (parseWhereBindings st1 blockCol) (\binds, st2 => Ok (Pair binds st2)))
    else Ok (Pair [] st)
  _ => Ok (Pair [] st)

parseWhereBindings : PState -> Int -> Result (Pair (List (Pair Pat Expr)) PState)
parseWhereBindings st whereCol = if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col > whereCol then step (parseBindingItemsAt (stateFuel st) st col)
      (\items, st1 => andThen (bindingItemsToBinds items) (\binds => Ok (Pair binds st1)))
    else Ok (Pair [] st)

-- 绑定块的条目：签名行或一条绑定（`pat = expr` / `name pats = expr`）。
data BindingItem : Type where
  BISig : String -> Expr -> Span -> BindingItem
  BIBind : Pair Pat Expr -> BindingItem

parseBindingItemsAt : Int -> PState -> Int -> Result (Pair (List BindingItem) PState)
parseBindingItemsAt fuel st bindCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair [] st)
else if atKw st "in" then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col == bindCol then step (parseBindingItem (fuel - 1) st bindCol)
      (\item, st1 => step (parseBindingItemsAt (fuel - 1) st1 bindCol) (\rest, st2 => Ok (Pair (item :: rest) st2)))
    else if col > bindCol then psErr0 UnexpectedIndentInBinding else Ok (Pair [] st)

parseBindingItem : Int -> PState -> Int -> Result (Pair BindingItem PState)
parseBindingItem fuel st bindCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else step (parsePatternSingle (stateFuel st) st bindCol) (\pat, st1 => case pat of
  PVar name psp =>
    if atSym st1 ":" then step (expectSym st1 ":")
      (\_, st2 => step (parseExpr (fuel - 1) st2 bindCol 0) (\ty, st3 => Ok (Pair (BISig name ty (spanOf st st3)) st3)))
    else parseBindingDef (fuel - 1) st st1 bindCol pat
  _ => parseBindingDef (fuel - 1) st st1 bindCol pat
)

-- 单条绑定：`pat = expr` 或函数子句 `name pats = expr`（desugar 成 λ）。
parseBindingDef : Int -> PState -> PState -> Int -> Pat -> Result (Pair BindingItem PState)
parseBindingDef fuel stStart st bindCol pat = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case pat of
  PVar name _ =>
    if startsPatternAtom st && canContinue st bindCol then step (parseClausePatterns (stateFuel st) st bindCol)
      (\pats, st2 => step (expectSym st2 "=") (\_, st3 => step (parseExpr (fuel - 1) st3 bindCol 0) (\value, st4 => Ok (Pair (BIBind (Pair (PVar name (patSpan pat)) (ELocalFun [Pair pats value] (spanOf stStart st4)))) st4))))
    else step (parseBindingValue (fuel - 1) st pat bindCol) (\b, st2 => Ok (Pair (BIBind b) st2))
  _ => step (parseBindingValue (fuel - 1) st pat bindCol) (\b, st2 => Ok (Pair (BIBind b) st2))

parseBindingValue : Int -> PState -> Pat -> Int -> Result (Pair (Pair Pat Expr) PState)
parseBindingValue fuel st pat blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectSym st "=")
    (\_, st1 => step (parseExpr (fuel - 1) st1 blockCol 0) (\value, st2 => Ok (Pair (Pair pat value) st2)))

-- 条目 → ELet 绑定：把签名贴到同名定义的值上（`EAnn value ty`），并校验布局约束：
-- 签名必须先于同名定义、不能重复、不能悬空。
bindingItemsToBinds : List BindingItem -> Result (List (Pair Pat Expr))
bindingItemsToBinds items = bindingBindsGo items [] [] []

bindingBindsGo : List BindingItem -> List (Pair String (Pair Expr Span)) -> List String -> List (Pair Pat Expr) -> Result (List (Pair Pat Expr))
bindingBindsGo [] sigs bound acc = case firstDanglingSig (reverse sigs) bound of
  Nothing => Ok (reverse acc)
  Just (Pair name sp) =>
    Err (showSpanLoc sp ++ ": " ++ psMsg (WhereSigNoDef name) (VCons name VNil))
bindingBindsGo (item :: rest) sigs bound acc = case item of
  BISig name ty sp =>
    if memName name bound then Err (showSpanLoc sp ++ ": " ++ psMsg (WhereSigBeforeClause name) (VCons name VNil))
    else if hasBindingSig name sigs then Err (showSpanLoc sp ++ ": " ++ psMsg (WhereSigDuplicate name) (VCons name VNil))
    else bindingBindsGo rest (Pair name (Pair ty sp) :: sigs) bound acc
  BIBind (Pair pat value) => case localFunMerge (patBoundName pat) value acc of
    Just merged => bindingBindsGo rest sigs bound merged
    Nothing => case bindingSigOf (patBoundName pat) sigs of
      Just (Pair ty sp) =>
        if memName (patBoundName pat) bound then Err
          (showSpanLoc sp ++ ": " ++ psMsg (WhereSigMultiClause (patBoundName pat)) (VCons (patBoundName pat) VNil))
        else bindingBindsGo rest sigs (patBoundName pat :: bound) (Pair pat (EAnn value ty sp) :: acc)
      Nothing => bindingBindsGo rest sigs (patBoundName pat :: bound) (Pair pat value :: acc)

-- A2：把相邻同名函数子句合并成一个 `ELocalFun` 绑定（where/let 多 clause）。
-- 签名保留在合并后的条目上（`EAnn` 只包裹第一条的 `ELocalFun`）；不连续的同名子句
-- 不合并，仍按旧的 `WhereSigMultiClause` 报错。
localFunMerge : String -> Expr -> List (Pair Pat Expr) -> Maybe (List (Pair Pat Expr))
localFunMerge name value ((Pair (PVar n nsp) (ELocalFun cs0 sp0)) :: rest) = if n == name then case value of
  ELocalFun cs1 sp1 => Just (Pair (PVar n nsp) (ELocalFun (append cs0 cs1) sp0) :: rest)
  _ => Nothing
else Nothing
localFunMerge name value ((Pair (PVar n nsp) (EAnn (ELocalFun cs0 sp0) ty annSp)) :: rest) = if n == name then case value of
  ELocalFun cs1 sp1 =>
    Just (Pair (PVar n nsp) (EAnn (ELocalFun (append cs0 cs1) sp0) ty annSp) :: rest)
  _ => Nothing
else Nothing
localFunMerge name value _ = Nothing

-- 绑定名（非简单变量绑定返回空串，永远匹配不到签名）。
patBoundName : Pat -> String
patBoundName (PVar name sp) = name
patBoundName _ = ""

bindingSigOf : String -> List (Pair String (Pair Expr Span)) -> Maybe (Pair Expr Span)
bindingSigOf name [] = Nothing
bindingSigOf name ((Pair n v) :: rest) = if n == name then Just v else bindingSigOf name rest

hasBindingSig : String -> List (Pair String (Pair Expr Span)) -> Bool
hasBindingSig name sigs = case bindingSigOf name sigs of
  Just _ => True
  Nothing => False

firstDanglingSig : List (Pair String (Pair Expr Span)) -> List String -> Maybe (Pair String Span)
firstDanglingSig [] bound = Nothing
firstDanglingSig ((Pair name (Pair ty sp)) :: rest) bound =
  if memName name bound then firstDanglingSig rest bound else Just (Pair name sp)

-- λ 参数名：绑定块里的函数子句参数必须是简单变量名（A2 起保留模式，见 parseBindingDef）。
parseClausePatterns : Int -> PState -> Int -> Result (Pair (List Pat) PState)
parseClausePatterns fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if startsPatternAtom st && canContinue st blockCol then step (parsePatternAtom (stateFuel st) st blockCol)
    (\pat, st1 => step (parseClausePatterns (fuel - 1) st1 blockCol) (\rest, st2 => Ok (Pair (pat :: rest) st2)))
  else Ok (Pair [] st)

parseData : PState -> Int -> Pos -> Result (Pair Decl PState)
parseData st blockCol kwPos =
  step (expectKw st "data")
    (\_, st1 => step (expectIdent st1) (\name, st2 => step (parseParams (stateFuel st2) st2) (\params, st3 => step (expectSym st3 ":") (\_, st4 => step (parseExpr (stateFuel st4) st4 blockCol 0) (\ty, st5 => step (expectKw st5 "where") (\_, st6 => step (parseCtors st6 blockCol) (\ctors, st7 => step (parseDeriving st7) (\derivings, st8 => Ok (Pair (DData name params ty ctors derivings (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st8)) (posCol (lastPos st8)))) st8)))))))))

-- 记录声明（M10.5）：`record Name params where` + 缩进字段 `f : Ty`，可跟 deriving。
parseRecord : PState -> Int -> Pos -> Result (Pair Decl PState)
parseRecord st blockCol kwPos =
  step (expectKw st "record")
    (\_, st1 => step (expectIdent st1) (\name, st2 => step (parseParams (stateFuel st2) st2) (\params, st3 => step (expectKw st3 "where") (\_, st4 => step (parseFields st4 blockCol) (\fields, st5 => step (parseDeriving st5) (\derivings, st6 => Ok (Pair (DRecord name params fields derivings (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st6)) (posCol (lastPos st6)))) st6)))))))

parseFields : PState -> Int -> Result (Pair (List Field) PState)
parseFields st blockCol = if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col => if col > blockCol then parseFieldList (stateFuel st) st col else Ok (Pair [] st)

parseFieldList : Int -> PState -> Int -> Result (Pair (List Field) PState)
parseFieldList fuel st fieldCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col == fieldCol then step (expectIdent st)
      (\name, st1 => step (expectSym st1 ":") (\_, st2 => step (parseExpr (stateFuel st2) st2 fieldCol 0) (\ty, st3 => step (parseFieldList (fuel - 1) st3 fieldCol) (\rest, st4 => Ok (Pair (Field name ty (spanOf st st3) :: rest) st4)))))
    else if col > fieldCol then psErr0 UnexpectedIndentInRecord else Ok (Pair [] st)

-- deriving (TraitA, TraitB)；可出现在 data/record 的构造器/字段块之后。
parseDeriving : PState -> Result (Pair (List String) PState)
parseDeriving st =
  if atKw st "deriving" then step (expectKw st "deriving")
    (\_, st1 => step (expectSym st1 "(") (\_, st2 => if atSym st2 ")" then Ok (Pair [] (advance st2)) else step (parseDerivingNames (stateFuel st2) st2) (\names, st3 => Ok (Pair names st3))))
  else Ok (Pair [] st)

parseDerivingNames : Int -> PState -> Result (Pair (List String) PState)
parseDerivingNames fuel st =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectIdent st)
    (\name, st1 => if atSym st1 "," then step (parseDerivingNames (fuel - 1) (advance st1)) (\rest, st2 => Ok (Pair (name :: rest) st2)) else step (expectSym st1 ")") (\_, st2 => Ok (Pair [name] st2)))

-- trait 声明（M10.5）：`trait Name params where` + 缩进方法签名 `m : Ty`。
parseTrait : PState -> Int -> Pos -> Result (Pair Decl PState)
parseTrait st blockCol kwPos =
  step (expectKw st "trait")
    (\_, st1 => step (expectIdent st1) (\name, st2 => step (parseParams (stateFuel st2) st2) (\params, st3 => step (expectKw st3 "where") (\_, st4 => step (parseMethodSigs st4 blockCol) (\methods, st5 => Ok (Pair (DTrait name params methods (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st5)) (posCol (lastPos st5)))) st5))))))

parseMethodSigs : PState -> Int -> Result (Pair (List TraitMethod) PState)
parseMethodSigs st blockCol = if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col > blockCol then parseMethodSigList (stateFuel st) st col else Ok (Pair [] st)

parseMethodSigList : Int -> PState -> Int -> Result (Pair (List TraitMethod) PState)
parseMethodSigList fuel st methodCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col == methodCol then step (expectIdent st)
      (\name, st1 => step (expectSym st1 ":") (\_, st2 => step (parseExpr (stateFuel st2) st2 methodCol 0) (\ty, st3 => step (parseMethodSigList (fuel - 1) st3 methodCol) (\rest, st4 => Ok (Pair (TraitMethod name ty (spanOf st st3) :: rest) st4)))))
    else if col > methodCol then psErr0 UnexpectedIndentInTrait else Ok (Pair [] st)

-- instance 声明（M10.5 / M29）：`instance [<ctx> ,... =>] Head where` + 缩进方法定义。
-- ctx 是逗号分隔的字典约束（每个形如 `C arg`；M29 只支持单参数 trait）。
-- M29-T2b：命名实例（`as name`）已删除。
parseInstance : PState -> Int -> Pos -> Result (Pair Decl PState)
parseInstance st blockCol kwPos = step (expectKw st "instance") (\_, st1 => step (parseInstanceHeadCtx (stateFuel st1) st1 blockCol) (\hc, st2 => case hc of
  Pair ctxE head => parseInstanceTail ctxE head st blockCol kwPos st2
)
)

parseInstanceTail : List Expr -> Expr -> PState -> Int -> Pos -> PState -> Result (Pair Decl PState)
parseInstanceTail ctxE head st blockCol kwPos st2 =
  step (expectKw st2 "where")
    (\_, st3 => step (parseInstanceBody st3 blockCol) (\methods, st4 => Ok (Pair (DInstance ctxE head methods (Span (fileOf st) (posLine kwPos) (posCol kwPos) (posLine (lastPos st4)) (posCol (lastPos st4)))) st4)))

parseInstanceHeadCtx : Int -> PState -> Int -> Result (Pair (Pair (List Expr) Expr) PState)
parseInstanceHeadCtx fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parseExpr fuel st blockCol 0)
    (\e1, st1 => if atSym st1 "=>" then step (parseExpr (fuel - 1) (advance st1) blockCol 0) (\hd, st2 => Ok (Pair (Pair [e1] hd) st2)) else if atSym st1 "," then parseInstanceCtxRest (fuel - 1) (advance st1) [e1] blockCol else Ok (Pair (Pair [] e1) st1))

-- ctx 列表的剩余部分：`e , e ... => head`。
parseInstanceCtxRest : Int -> PState -> List Expr -> Int -> Result (Pair (Pair (List Expr) Expr) PState)
parseInstanceCtxRest fuel st acc blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if atSym st "=>" then step (parseExpr (fuel - 1) (advance st) blockCol 0)
    (\hd, st1 => Ok (Pair (Pair (reverse acc) hd) st1))
  else step (parseExpr fuel st blockCol 0)
    (\e, st1 => if atSym st1 "," then parseInstanceCtxRest (fuel - 1) (advance st1) (e :: acc) blockCol else step (expectSym st1 "=>") (\_, st2 => step (parseExpr (fuel - 1) st2 blockCol 0) (\hd, st3 => Ok (Pair (Pair (reverse (e :: acc)) hd) st3))))

parseInstanceBody : PState -> Int -> Result (Pair (List Decl) PState)
parseInstanceBody st blockCol = if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col > blockCol then parseInstanceDeclList (stateFuel st) st col else Ok (Pair [] st)

parseInstanceDeclList : Int -> PState -> Int -> Result (Pair (List Decl) PState)
parseInstanceDeclList fuel st declCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col == declCol then step (parseInstanceDecl st declCol)
      (\decl, st1 => step (parseInstanceDeclList (fuel - 1) st1 declCol) (\rest, st2 => Ok (Pair (decl :: rest) st2)))
    else if col > declCol then psErr0 UnexpectedIndentInInstance else Ok (Pair [] st)

parseInstanceDecl : PState -> Int -> Result (Pair Decl PState)
parseInstanceDecl st blockCol = case peekTok st of
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 ":" then parseSignature st1 blockCol name p else parseClause st1 blockCol name p
  _ => psErr0 ExpectedInstanceMethod

parseParams : Int -> PState -> Result (Pair (List String) PState)
parseParams fuel st = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TIdent name) p =>
    step (parseParams (fuel - 1) (advance st)) (\rest, st1 => Ok (Pair (name :: rest) st1))
  _ => Ok (Pair [] st)

parseCtors : PState -> Int -> Result (Pair (List Ctor) PState)
parseCtors st blockCol = if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col => if col > blockCol then parseCtorList (stateFuel st) st col else Ok (Pair [] st)

parseCtorList : Int -> PState -> Int -> Result (Pair (List Ctor) PState)
parseCtorList fuel st ctorCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col == ctorCol then step (expectIdent st)
      (\name, st1 => step (expectSym st1 ":") (\_, st2 => step (parseExpr (stateFuel st2) st2 ctorCol 0) (\ty, st3 => step (parseCtorList (fuel - 1) st3 ctorCol) (\rest, st4 => Ok (Pair (Ctor name ty (countArrows ty) (spanOf st st3) :: rest) st4)))))
    else if col > ctorCol then psErr0 UnexpectedIndentInData else Ok (Pair [] st)

parseExpr : Int -> PState -> Int -> Int -> Result (Pair Expr PState)
parseExpr fuel st blockCol minPrec =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if isEof st then psErr0 UnexpectedEndOfInput
  else if canContinue st blockCol then step (parseLhs (fuel - 1) st blockCol)
    (\lhs, st1 => parseInfix (fuel - 1) st1 blockCol minPrec lhs)
  else psErr0 ExprNotIndented

parseInfix : Int -> PState -> Int -> Int -> Expr -> Result (Pair Expr PState)
parseInfix fuel st blockCol minPrec lhs = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TSym op) p => case infixInfo op of
    Just (Pair prec assoc) => if prec >= minPrec && canContinue st blockCol then
      let
        rhsPrec = if assoc == 0 then prec + 1 else prec
      in step (parseExpr (fuel - 1) (advance st) blockCol rhsPrec)
        (\rhs, st2 => parseInfix (fuel - 1) st2 blockCol minPrec (mkInfixExpr op lhs rhs (spanOf st st2)))
    else Ok (Pair lhs st)
    Nothing => Ok (Pair lhs st)
  _ => Ok (Pair lhs st)

parseLhs : Int -> PState -> Int -> Result (Pair Expr PState)
parseLhs fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TSym "\\") p => parseLambda (fuel - 1) st blockCol
  PTok (TKw "let") p => parseLet (fuel - 1) st blockCol
  PTok (TKw "case") p => parseCase (fuel - 1) st blockCol
  PTok (TKw "if") p => parseIf (fuel - 1) st blockCol
  PTok (TKw "do") p => parseDo (fuel - 1) st blockCol
  _ => parseApplication (fuel - 1) st blockCol

parseApplication : Int -> PState -> Int -> Result (Pair Expr PState)
parseApplication fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else step (parseAtom (fuel - 1) st blockCol) (\first, st1 => step (parseArgs (fuel - 1) st1 blockCol) (\args, st2 => case args of
  [] => Ok (Pair first st2)
  _ => Ok (Pair (EApp first args (spanOf st st2)) st2)
)
)

spanFromExpr : Expr -> PState -> Span
spanFromExpr e st2 =
  let
    sp = exprSpan e
  in Span (spanFile sp) (spanStartLine sp) (spanStartCol sp) (posLine (lastPos st2))
    (posCol (lastPos st2))

parseArgs : Int -> PState -> Int -> Result (Pair (List Expr) PState)
parseArgs fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if startsAtom st && canContinue st blockCol then step (parseAtom (fuel - 1) st blockCol)
    (\arg, st1 => step (parseArgs (fuel - 1) st1 blockCol) (\rest, st2 => Ok (Pair (arg :: rest) st2)))
  else Ok (Pair [] st)

parseAtom : Int -> PState -> Int -> Result (Pair Expr PState)
parseAtom fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parseAtomBase (fuel - 1) st blockCol)
    (\base, st1 => parseFieldSuffix (stateFuel st1) st1 blockCol base)

-- 字段访问后缀：`e.f` / `(e).f`；`p.x` 因 lexer 合成单 token 由 loader 拆分。
parseFieldSuffix : Int -> PState -> Int -> Expr -> Result (Pair Expr PState)
parseFieldSuffix fuel st blockCol base =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if atSym st "." then step (expectSym st ".")
    (\_, st1 => step (expectIdent st1) (\fname, st2 => parseFieldSuffix (fuel - 1) st2 blockCol (EField base fname (spanFromExpr base st2))))
  else Ok (Pair base st)

parseAtomBase : Int -> PState -> Int -> Result (Pair Expr PState)
parseAtomBase fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if atSym st1 "{" then step (expectSym st1 "{")
      (\_, st1b => step (parseRecordAssignments (fuel - 1) st1b blockCol) (\fields, st2 => Ok (Pair (ERecord name fields (spanOf st st2)) st2)))
    else Ok (Pair (EVar name (spanOf st st1)) st1)
  PTok (TInt n) p => Ok (Pair (EInt n (spanOf st (advance st))) (advance st))
  PTok (TStr s) p => Ok (Pair (EStr s (spanOf st (advance st))) (advance st))
  PTok (TKw "Type") p => Ok (Pair (EVar "Type" (spanOf st (advance st))) (advance st))
  PTok (TSym "(") p => case binderHeadName (advance st) of
    Just name => parsePiBinder (fuel - 1) st blockCol name False "(" ")"
    Nothing =>
      step (parseExpr (fuel - 1) (advance st) blockCol 0)
        (\inner, st1 => step (expectSym st1 ")") (\_, st2 => Ok (Pair inner st2)))
  PTok (TSym "[") p => parseListExpr (fuel - 1) st blockCol
  PTok (TSym "{") p => case binderHeadName (advance st) of
    Just name => parsePiBinder (fuel - 1) st blockCol name True "{" "}"
    Nothing =>
      step (expectSym st "{")
        (\_, st1 => step (parseExpr (fuel - 1) st1 blockCol 0) (\base, st2 => step (expectSym st2 "|") (\_, st3 => step (parseRecordAssignments (fuel - 1) st3 blockCol) (\fields, st4 => Ok (Pair (ERecUpdate base fields (spanOf st st4)) st4)))))
  _ => psErr0 ExpectedExpression

-- DT（M13）Pi binder：`(x : A) -> B` 或 `{x : A} -> B`。
-- 进入时已在开括号处；binder 名先由 lookahead 确认，再要求 `->`。
parsePiBinder : Int -> PState -> Int -> String -> Bool -> String -> String -> Result (Pair Expr PState)
parsePiBinder fuel st blockCol name implicit openSym closeSym =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if containsDot name then psErr0 PiBinderNameNotSimple
  else step (expectSym st openSym)
    (\_, st1 => step (expectIdent st1) (\name2, st2 => step (expectSym st2 ":") (\_, st3 => step (parseExpr (fuel - 1) st3 blockCol 0) (\dom, st4 => step (expectSym st4 closeSym) (\_, st5 => step (expectSym st5 "->") (\_, st6 => step (parseExpr (fuel - 1) st6 blockCol 1) (\cod, st7 => Ok (Pair (EPi name2 implicit dom cod (spanOf st st7)) st7))))))))

-- `{ f = e, ... }`：构造与更新的公共字段列表（进入时已在 `{` 之后）。
parseRecordAssignments : Int -> PState -> Int -> Result (Pair (List (Pair String Expr)) PState)
parseRecordAssignments fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if atSym st "}" then Ok (Pair [] (advance st))
  else step (parseRecordAssignList (fuel - 1) st blockCol) (\fs, st1 => Ok (Pair fs st1))

parseRecordAssignList : Int -> PState -> Int -> Result (Pair (List (Pair String Expr)) PState)
parseRecordAssignList fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectIdent st)
    (\fname, st1 => step (expectSym st1 "=") (\_, st2 => step (parseExpr (fuel - 1) st2 blockCol 0) (\value, st3 => if atSym st3 "," then step (parseRecordAssignList (fuel - 1) (advance st3) blockCol) (\rest, st4 => Ok (Pair (Pair fname value :: rest) st4)) else step (expectSym st3 "}") (\_, st4 => Ok (Pair [Pair fname value] st4)))))

parseListExpr : Int -> PState -> Int -> Result (Pair Expr PState)
parseListExpr fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectSym st "[")
    (\_, st1 => if atSym st1 "]" then Ok (Pair (EVar "Nil" (spanOf st (advance st1))) (advance st1)) else step (parseListExprElems (fuel - 1) st1 blockCol) (\elems, st2 => Ok (Pair (foldCons (spanOf st st2) elems) st2)))

parseListExprElems : Int -> PState -> Int -> Result (Pair (List Expr) PState)
parseListExprElems fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parseExpr (fuel - 1) st blockCol 0)
    (\e, st1 => if atSym st1 "," then step (parseListExprElems (fuel - 1) (advance st1) blockCol) (\rest, st2 => Ok (Pair (e :: rest) st2)) else if atSym st1 "]" then Ok (Pair [e] (advance st1)) else psErr0 ExpectedCommaOrBracket)

foldCons : Span -> List Expr -> Expr
foldCons sp [] = EVar "Nil" sp
foldCons sp (e :: rest) = EApp (EVar "Cons" sp) [e, foldCons sp rest] sp

parseLambda : Int -> PState -> Int -> Result (Pair Expr PState)
parseLambda fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectSym st "\\")
    (\_, st1 => step (expectIdent st1) (\first, st2 => step (parseLambdaParams (stateFuel st2) st2 [first]) (\params, st3 => step (expectSym st3 "=>") (\_, st4 => step (parseExpr (fuel - 1) st4 blockCol 0) (\body, st5 => Ok (Pair (ELam params body (spanOf st st5)) st5))))))

parseLambdaParams : Int -> PState -> List String -> Result (Pair (List String) PState)
parseLambdaParams fuel st acc =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if atSym st "," then step (expectIdent (advance st))
    (\name, st1 => parseLambdaParams (fuel - 1) st1 (append acc [name]))
  else Ok (Pair acc st)

parseLet : Int -> PState -> Int -> Result (Pair Expr PState)
parseLet fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectKw st "let")
    (\_, st1 => step (parseLetBindings (fuel - 1) st1 blockCol) (\binds, st2 => step (expectKw st2 "in") (\_, st3 => step (parseExpr (fuel - 1) st3 blockCol 0) (\body, st4 => Ok (Pair (ELet binds body False (spanOf st st4)) st4)))))

-- `let` 绑定块：与 `where` 共用 `parseBindingItemsAt` / `bindingItemsToBinds`
-- （签名行可选；函数子句降级成 λ）。块结束于缩进回退或 `in`。
parseLetBindings : Int -> PState -> Int -> Result (Pair (List (Pair Pat Expr)) PState)
parseLetBindings fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then psErr0 ExpectedLetBinding
else if atKw st "in" then psErr0 ExpectedLetBinding
else case peekPos st of
  Pos line col =>
    if col <= blockCol then psErr0 LetBindingNotIndented
    else step (parseBindingItemsAt (fuel - 1) st col)
      (\items, st1 => andThen (bindingItemsToBinds items) (\binds => Ok (Pair binds st1)))

parseCase : Int -> PState -> Int -> Result (Pair Expr PState)
parseCase fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectKw st "case")
    (\_, st1 => step (parseExpr (fuel - 1) st1 blockCol 0) (\scrut, st2 => step (expectKw st2 "of") (\_, st3 => step (parseCaseAlts (fuel - 1) st3 blockCol) (\alts, st4 => Ok (Pair (ECase scrut alts (spanOf st st4)) st4)))))

parseCaseAlts : Int -> PState -> Int -> Result (Pair (List (Pair Pat Expr)) PState)
parseCaseAlts fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then psErr0 CaseNeedsAlternative
else case peekPos st of
  Pos line col => if col <= blockCol then psErr0 CaseAltNotIndented
  else step (parseAltList (fuel - 1) st col) (\alts, st2 => if badCaseIndent st2 col then psErr0 UnexpectedIndentAfterCaseAlt
  else case alts of
    [] => psErr0 CaseNeedsAlternative
    _ => Ok (Pair alts st2)
  )

parseAltList : Int -> PState -> Int -> Result (Pair (List (Pair Pat Expr)) PState)
parseAltList fuel st altCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair [] st)
else case peekPos st of
  Pos line col =>
    if col == altCol then step (parsePatternSingle (stateFuel st) st altCol)
      (\pat, st1 => step (expectSym st1 "=>") (\_, st2 => step (parseExpr (fuel - 1) st2 altCol 0) (\body, st3 => step (parseAltList (fuel - 1) st3 altCol) (\rest, st4 => Ok (Pair (Pair pat body :: rest) st4)))))
    else Ok (Pair [] st)

parseIf : Int -> PState -> Int -> Result (Pair Expr PState)
parseIf fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectKw st "if")
    (\_, st1 => step (parseExpr (fuel - 1) st1 blockCol 0) (\cond, st2 => step (expectKw st2 "then") (\_, st3 => step (parseExpr (fuel - 1) st3 blockCol 0) (\yes, st4 => step (expectKw st4 "else") (\_, st5 => step (parseExpr (fuel - 1) st5 blockCol 0) (\no, st6 => Ok (Pair (EIf cond yes no (spanOf st st6)) st6)))))))

-- do 块（M11）：`do` + 缩进对齐的语句，语句是 `pat <- expr` 或裸表达式；
-- 最后一条必须是裸表达式（do 本身不引入 pure，最后表达式即块结果）。
parseDo : Int -> PState -> Int -> Result (Pair Expr PState)
parseDo fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else step (expectKw st "do") (\_, st1 => if isEof st1 then psErr0 DoBlockNeedsStatement
else case peekPos st1 of
  Pos line col => if col <= blockCol then psErr0 DoStatementNotIndented
  else step (parseDoStmts (fuel - 1) st1 col []) (\stmts, st2 => case reverse stmts of
    (DExpr lastExpr lastSp) :: rest => Ok (Pair (EDo stmts (spanOf st st2)) st2)
    _ => psErr0 DoBlockMustEndWithExpr
  )
)

parseDoStmts : Int -> PState -> Int -> List DoStmt -> Result (Pair (List DoStmt) PState)
parseDoStmts fuel st stmtCol acc = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if isEof st then Ok (Pair (reverse acc) st)
else case peekPos st of
  Pos line col => if col < stmtCol then Ok (Pair (reverse acc) st)
  else if col > stmtCol then psErr0 UnexpectedIndentInDo
  else step (parseDoStmt (fuel - 1) st stmtCol) (\stmt, st1 => case peekPos st1 of
    Pos line2 col2 =>
      if isEof st1 then Ok (Pair (reverse (stmt :: acc)) st1)
      else if col2 < stmtCol then Ok (Pair (reverse (stmt :: acc)) st1)
      else if col2 > stmtCol then psErr0 UnexpectedIndentInDo
      else parseDoStmts (fuel - 1) st1 stmtCol (stmt :: acc)
  )

parseDoStmt : Int -> PState -> Int -> Result (Pair DoStmt PState)
parseDoStmt fuel st stmtCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case parsePatternSingle (stateFuel st) st stmtCol of
  Ok (Pair pat st1) =>
    if atSym st1 "<-" then step (expectSym st1 "<-")
      (\_, st2 => step (parseExpr (fuel - 1) st2 stmtCol 0) (\e, st3 => Ok (Pair (DBind pat e (spanOf st st3)) st3)))
    else parseDoExprStmt (fuel - 1) st stmtCol
  Err _ => parseDoExprStmt (fuel - 1) st stmtCol

parseDoExprStmt : Int -> PState -> Int -> Result (Pair DoStmt PState)
parseDoExprStmt fuel st stmtCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parseExpr (fuel - 1) (sameLineState st) stmtCol 0)
    (\e, st1 => Ok (Pair (DExpr e (spanOf st st1)) st1))

parsePatternSingle : Int -> PState -> Int -> Result (Pair Pat PState)
parsePatternSingle fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else parsePatternCons (fuel - 1) st blockCol

parsePatternCons : Int -> PState -> Int -> Result (Pair Pat PState)
parsePatternCons fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parsePatternHead (fuel - 1) st blockCol)
    (\lhs, st1 => if atSym st1 "::" && canContinue st1 blockCol then step (parsePatternCons (fuel - 1) (advance st1) blockCol) (\rhs, st2 => Ok (Pair (PCon "Cons" [lhs, rhs] (spanOf st st2)) st2)) else Ok (Pair lhs st1))

parsePatternHead : Int -> PState -> Int -> Result (Pair Pat PState)
parsePatternHead fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TIdent name) p =>
    let
      st1 = advance st
    in if ctorPatternStart name && atSym st1 "{" then step (parseRecordPatternFields (fuel - 1) st1 blockCol)
      (\fields, st2 => Ok (Pair (PRecord name fields (spanOf st st2)) st2))
    else if ctorPatternStart name then step (parsePatternAtoms (fuel - 1) st1 blockCol)
      (\args, st2 => Ok (Pair (PCon name args (spanOf st st2)) st2))
    else parsePatternAtom (fuel - 1) st blockCol
  _ => parsePatternAtom (fuel - 1) st blockCol

parseRecordPatternFields : Int -> PState -> Int -> Result (Pair (List (Pair String Pat)) PState)
parseRecordPatternFields fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectSym st "{") (\_, st1 => parseRecordPatternList (fuel - 1) st1 blockCol)

parseRecordPatternList : Int -> PState -> Int -> Result (Pair (List (Pair String Pat)) PState)
parseRecordPatternList fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if atSym st "}" then Ok (Pair [] (advance st))
  else step (parseRecordPatternField (fuel - 1) st blockCol)
    (\f, st1 => if atSym st1 "," then step (parseRecordPatternList (fuel - 1) (advance st1) blockCol) (\rest, st2 => Ok (Pair (f :: rest) st2)) else step (expectSym st1 "}") (\_, st2 => Ok (Pair [f] st2)))

parseRecordPatternField : Int -> PState -> Int -> Result (Pair (Pair String Pat) PState)
parseRecordPatternField fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TIdent fname) p =>
    let
      st1 = advance st
    in if atSym st1 "=" then step (expectSym st1 "=")
      (\_, st2 => step (parsePatternSingle (fuel - 1) st2 blockCol) (\pat, st3 => Ok (Pair (Pair fname pat) st3)))
    else Ok
      (Pair (Pair fname (PVar fname (Span (fileOf st) (posLine p) (posCol p) (posLine p) (posCol p)))) st1)
  _ => psErr0 ExpectedRecordFieldPattern

parsePatternAtoms : Int -> PState -> Int -> Result (Pair (List Pat) PState)
parsePatternAtoms fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else if startsPatternAtom st && canContinue st blockCol then step (parsePatternAtom (fuel - 1) st blockCol)
    (\pat, st1 => step (parsePatternAtoms (fuel - 1) st1 blockCol) (\rest, st2 => Ok (Pair (pat :: rest) st2)))
  else Ok (Pair [] st)

parsePatternAtom : Int -> PState -> Int -> Result (Pair Pat PState)
parsePatternAtom fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parsePatternAtomBase (fuel - 1) st blockCol)
    (\base, st1 => finishAsPattern (fuel - 1) st base st1 blockCol)

-- as-pattern：`x@pat`（前缀）与 `(pat)@x`（后缀）；`_@x` 等价于 `x@_`。
finishAsPattern : Int -> PState -> Pat -> PState -> Int -> Result (Pair Pat PState)
finishAsPattern fuel st base st1 blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else if atSym st1 "@" && canContinue st1 blockCol then case base of
  PVar "_" psp =>
    step (parseAsName (fuel - 1) (advance st1))
      (\name, st2 => Ok (Pair (PAs name (PWild psp) (spanOf st st2)) st2))
  PVar name psp =>
    step (parsePatternAtom (fuel - 1) (advance st1) blockCol)
      (\rhs, st2 => Ok (Pair (PAs name rhs (spanOf st st2)) st2))
  _ =>
    step (parseAsName (fuel - 1) (advance st1))
      (\name, st2 => Ok (Pair (PAs name base (spanOf st st2)) st2))
else Ok (Pair base st1)

parseAsName : Int -> PState -> Result (Pair String PState)
parseAsName fuel st = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TIdent name) p =>
    if name == "_" then psErr0 ExpectedPattern else Ok (Pair name (advance st))
  _ => psErr0 ExpectedPattern

parsePatternAtomBase : Int -> PState -> Int -> Result (Pair Pat PState)
parsePatternAtomBase fuel st blockCol = if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
else case peekTok st of
  PTok (TIdent "_") p => Ok (Pair (PWild (spanOf st (advance st))) (advance st))
  PTok (TIdent name) p =>
    if ctorPatternStart name then Ok (Pair (PCon name [] (spanOf st (advance st))) (advance st))
    else Ok (Pair (PVar name (spanOf st (advance st))) (advance st))
  PTok (TInt n) p => Ok (Pair (PInt n (spanOf st (advance st))) (advance st))
  PTok (TStr s) p => Ok (Pair (PStr s (spanOf st (advance st))) (advance st))
  PTok (TSym "(") p =>
    step (parsePatternSingle (fuel - 1) (advance st) blockCol)
      (\inner, st1 => step (expectSym st1 ")") (\_, st2 => Ok (Pair inner st2)))
  PTok (TSym "[") p => parseListPattern (fuel - 1) st blockCol
  _ => psErr0 ExpectedPattern

parseListPattern : Int -> PState -> Int -> Result (Pair Pat PState)
parseListPattern fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (expectSym st "[")
    (\_, st1 => if atSym st1 "]" then Ok (Pair (PCon "Nil" [] (spanOf st (advance st1))) (advance st1)) else step (parseListPatternElems (fuel - 1) st1 blockCol) (\pats, st2 => Ok (Pair (foldPCon (spanOf st st2) pats) st2)))

parseListPatternElems : Int -> PState -> Int -> Result (Pair (List Pat) PState)
parseListPatternElems fuel st blockCol =
  if fuel <= 0 then Err "DT: parser fuel exhausted (internal: parser made no progress)"
  else step (parsePatternSingle (fuel - 1) st blockCol)
    (\pat, st1 => if atSym st1 "," then step (parseListPatternElems (fuel - 1) (advance st1) blockCol) (\rest, st2 => Ok (Pair (pat :: rest) st2)) else if atSym st1 "]" then Ok (Pair [pat] (advance st1)) else psErr0 ExpectedCommaOrBracket)

foldPCon : Span -> List Pat -> Pat
foldPCon sp [] = PCon "Nil" [] sp
foldPCon sp (p :: rest) = PCon "Cons" [p, foldPCon sp rest] sp
