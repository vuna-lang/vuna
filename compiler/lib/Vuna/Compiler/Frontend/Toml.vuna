module Vuna.Compiler.Frontend.Toml
  ( TomlEntry(..)
  , TomlValue(..)
  , lookupEntry
  , lookupEntryLine
  , parseToml
  , parseTomlAt
  ) where

-- Vuna.Compiler.Frontend.Toml：TOML 子集解析器（M11.5 包管理基础件）。
-- 支持：# 行注释（字符串内的 # 不算）、空行、[section]、[section.sub]、
-- key = value；value 支持 basic string（转义 \" \\ \n \t \r \b \f）、
-- 可负整数、true/false、字符串数组（可空、可跨行、元素间可带注释/逗号）。
-- key 与 section 段均为裸键 [A-Za-z0-9_-]+。
-- 重复 key、重复 section、语法错误返回带行号的错误：
-- parseToml 的错误形如 `line 3: ...`，parseTomlAt 的错误形如 `path:3: ...`。
import Vuna.Compiler.Common

data TomlValue : Type where
  TStr : String -> TomlValue
  TInt : Int -> TomlValue
  TBool : Bool -> TomlValue
  TList : List String -> TomlValue

-- section path、key、value 与 key 所在行号（从 1 开始）。
data TomlEntry : Type where
  TomlEntry : List String -> String -> TomlValue -> Int -> TomlEntry

-- 字符游标：剩余字符、当前行、当前列（行/列均从 1 开始）。
data TomlCursor : Type where
  TomlCursor : List Int -> Int -> Int -> TomlCursor

cursorChars : TomlCursor -> List Int
cursorChars (TomlCursor chars line col) = chars

cursorLine : TomlCursor -> Int
cursorLine (TomlCursor chars line col) = line

cursorCol : TomlCursor -> Int
cursorCol (TomlCursor chars line col) = col

advanceCursor : TomlCursor -> TomlCursor
advanceCursor (TomlCursor [] line col) = TomlCursor [] line col
advanceCursor (TomlCursor (c :: rest) line col) =
  if c == 10 then TomlCursor rest (line + 1) 1 else TomlCursor rest line (col + 1)

-- 字符分类（vuna 没有字符字面量，统一用 char code）。
isDigitChar : Int -> Bool
isDigitChar c = c >= 48 && c <= 57

isUpperAlphaChar : Int -> Bool
isUpperAlphaChar c = c >= 65 && c <= 90

isLowerAlphaChar : Int -> Bool
isLowerAlphaChar c = c >= 97 && c <= 122

isAlphaChar : Int -> Bool
isAlphaChar c = isUpperAlphaChar c || isLowerAlphaChar c

isBareKeyChar : Int -> Bool
isBareKeyChar c = isAlphaChar c || isDigitChar c || c == 95 || c == 45

isBlankChar : Int -> Bool
isBlankChar c = c == 32 || c == 9

-- 统一行尾：去掉 CR，避免 CRLF 把行号数两遍（TOML 基本字符串里本来也不允许裸 CR）。
stripCR : List Int -> List Int
stripCR [] = []
stripCR (c :: rest) = if c == 13 then stripCR rest else c :: stripCR rest

locPrefix : String -> Int -> String
locPrefix path line =
  if path == "" then "line " ++ strFromInt line ++ ": " else path ++ ":" ++ strFromInt line ++ ": "

failAt : String -> Int -> String -> Result a
failAt path line msg = Err (locPrefix path line ++ msg)

-- 跳过空格/制表符。
skipBlank : TomlCursor -> TomlCursor
skipBlank cs = case cursorChars cs of
  [] => cs
  c :: rest => if isBlankChar c then skipBlank (advanceCursor cs) else cs

-- 跳过 `#` 开头的行注释，停在行尾换行符（不消费换行）或 EOF。
skipComment : TomlCursor -> TomlCursor
skipComment cs = case cursorChars cs of
  [] => cs
  c :: rest => if c == 10 then cs else skipComment (advanceCursor cs)

-- 跳过空白/换行/注释，用于文件顶层与数组内部的间隙。
skipGap : TomlCursor -> TomlCursor
skipGap cs = case cursorChars cs of
  [] => cs
  c :: rest =>
    if isBlankChar c || c == 10 then skipGap (advanceCursor cs)
    else if c == 35 then skipGap (skipComment cs) else cs

collectBareKey : TomlCursor -> List Int -> Pair String TomlCursor
collectBareKey cs acc = case cursorChars cs of
  [] => Pair (strPack (reverse acc)) cs
  c :: rest =>
    if isBareKeyChar c then collectBareKey (advanceCursor cs) (c :: acc)
    else Pair (strPack (reverse acc)) cs

parseBareKey : String -> TomlCursor -> Result (Pair String TomlCursor)
parseBareKey path cs = case cursorChars cs of
  [] => failAt path (cursorLine cs) "expected a key"
  c :: rest => if isBareKeyChar c then case collectBareKey cs [] of
    Pair name after => Ok (Pair name after)
  else failAt path (cursorLine cs) "expected a key"

-- basic string：返回原始字符串与游标（不含两侧引号）。
parseStringValue : String -> TomlCursor -> Result (Pair String TomlCursor)
parseStringValue path cs = case cursorChars cs of
  [] => failAt path (cursorLine cs) "unterminated basic string"
  c :: rest => parseStringChars path cs (advanceCursor cs) []

parseStringChars : String -> TomlCursor -> TomlCursor -> List Int -> Result (Pair String TomlCursor)
parseStringChars path startCs cs acc = case cursorChars cs of
  [] => failAt path (cursorLine startCs) "unterminated basic string"
  c :: rest =>
    if c == 34 then Ok (Pair (strPack (reverse acc)) (advanceCursor cs))
    else if c == 10 then failAt path (cursorLine startCs) "unterminated basic string (newline in string)"
    else if c == 92 then parseStringEscape path startCs (advanceCursor cs) acc
    else parseStringChars path startCs (advanceCursor cs) (c :: acc)

parseStringEscape : String -> TomlCursor -> TomlCursor -> List Int -> Result (Pair String TomlCursor)
parseStringEscape path startCs cs acc = case cursorChars cs of
  [] => failAt path (cursorLine startCs) "unterminated escape sequence"
  c :: rest =>
    if c == 110 then parseStringChars path startCs (advanceCursor cs) (10 :: acc)
    else if c == 116 then parseStringChars path startCs (advanceCursor cs) (9 :: acc)
    else if c == 114 then parseStringChars path startCs (advanceCursor cs) (13 :: acc)
    else if c == 98 then parseStringChars path startCs (advanceCursor cs) (8 :: acc)
    else if c == 102 then parseStringChars path startCs (advanceCursor cs) (12 :: acc)
    else if c == 34 then parseStringChars path startCs (advanceCursor cs) (34 :: acc)
    else if c == 92 then parseStringChars path startCs (advanceCursor cs) (92 :: acc)
    else failAt path (cursorLine cs) ("unknown escape sequence \\" ++ strPack [c])

-- 整数：可选前导 '-'，至少一位十进制数字；小数点/尾随字母报错。
parseInteger : String -> TomlCursor -> Result (Pair Int TomlCursor)
parseInteger path cs = case cursorChars cs of
  [] => failAt path (cursorLine cs) "expected an integer"
  c :: rest =>
    if c == 45 then parseIntegerDigits path cs (advanceCursor cs) 0 0 True
    else if isDigitChar c then parseIntegerDigits path cs cs 0 0 False
    else failAt path (cursorLine cs) "expected an integer"

parseIntegerDigits : String -> TomlCursor -> TomlCursor -> Int -> Int -> Bool -> Result (Pair Int TomlCursor)
parseIntegerDigits path startCs cs count acc negative = case cursorChars cs of
  [] => finishInteger path startCs cs count acc negative
  c :: rest =>
    if isDigitChar c then parseIntegerDigits path startCs (advanceCursor cs) (count + 1) (acc * 10 + (c - 48)) negative
    else finishInteger path startCs cs count acc negative

finishInteger : String -> TomlCursor -> TomlCursor -> Int -> Int -> Bool -> Result (Pair Int TomlCursor)
finishInteger path startCs cs count acc negative = if count == 0 then failAt path (cursorLine startCs) "expected digits for integer"
else case cursorChars cs of
  [] => Ok (Pair (makeInteger acc negative) cs)
  c :: rest =>
    if c == 46 then failAt path (cursorLine startCs) "floating point numbers are not supported"
    else if isBareKeyChar c then failAt path (cursorLine startCs) "invalid integer literal"
    else Ok (Pair (makeInteger acc negative) cs)

makeInteger : Int -> Bool -> Int
makeInteger acc negative = if negative then 0 - acc else acc

parseIntValue : String -> TomlCursor -> Result (Pair TomlValue TomlCursor)
parseIntValue path cs = case parseInteger path cs of
  Err e => Err e
  Ok (Pair n afterInteger) => Ok (Pair (TInt n) afterInteger)

-- 精确匹配一个 TOML 单词（true/false），且后面不能紧跟裸键字符。
matchChars : List Int -> TomlCursor -> Maybe TomlCursor
matchChars [] cs = Just cs
matchChars (want :: wants) cs = case cursorChars cs of
  [] => Nothing
  c :: rest => if c == want then matchChars wants (advanceCursor cs) else Nothing

matchWord : String -> TomlCursor -> Maybe TomlCursor
matchWord word cs = case matchChars (strUnpack word) cs of
  Nothing => Nothing
  Just after => case cursorChars after of
    [] => Just after
    c :: rest => if isBareKeyChar c then Nothing else Just after

-- 字符串数组：字符串可空、可跨行，元素间允许空格/换行/注释，允许尾逗号。
parseStringArray : String -> TomlCursor -> Result (Pair TomlValue TomlCursor)
parseStringArray path cs = case cursorChars cs of
  [] => failAt path (cursorLine cs) "unterminated array"
  c :: rest => parseArrayItems path (advanceCursor cs) []

parseArrayItems : String -> TomlCursor -> List String -> Result (Pair TomlValue TomlCursor)
parseArrayItems path cs acc = case skipGap cs of
  TomlCursor chars line col => case chars of
    [] => failAt path line "unterminated array"
    c :: rest =>
      if c == 93 then Ok (Pair (TList (reverse acc)) (advanceCursor (TomlCursor chars line col)))
      else if c == 34 then parseArrayString path (TomlCursor chars line col) acc
      else failAt path line "expected a string in array"

parseArrayString : String -> TomlCursor -> List String -> Result (Pair TomlValue TomlCursor)
parseArrayString path cs acc = case parseStringValue path cs of
  Err e => Err e
  Ok (Pair s afterString) => case skipGap afterString of
    TomlCursor chars line col => case chars of
      [] => failAt path line "unterminated array"
      c :: rest =>
        if c == 44 then parseArrayItems path (advanceCursor (TomlCursor chars line col)) (s :: acc)
        else if c == 93 then Ok (Pair (TList (reverse (s :: acc))) (advanceCursor (TomlCursor chars line col)))
        else failAt path line "expected ',' or ']' in array"

parseValue : String -> TomlCursor -> Result (Pair TomlValue TomlCursor)
parseValue path cs = case cursorChars cs of
  [] => failAt path (cursorLine cs) "expected a value"
  c :: rest => if c == 34 then case parseStringValue path cs of
    Err e => Err e
    Ok (Pair s afterString) => Ok (Pair (TStr s) afterString)
  else if c == 91 then parseStringArray path cs
  else if c == 45 then parseIntValue path cs
  else if isDigitChar c then parseIntValue path cs
  else case matchWord "true" cs of
    Just afterTrue => Ok (Pair (TBool True) afterTrue)
    Nothing => case matchWord "false" cs of
      Just afterFalse => Ok (Pair (TBool False) afterFalse)
      Nothing => failAt path (cursorLine cs) "expected a value"

-- [section] / [section.sub]：段之间允许空格，例如 [ a . b ]。
parseSectionPath : String -> TomlCursor -> Result (Pair (List String) TomlCursor)
parseSectionPath path cs = parseSectionSegments path cs []

parseSectionSegments : String -> TomlCursor -> List String -> Result (Pair (List String) TomlCursor)
parseSectionSegments path cs acc = case parseBareKey path (skipBlank cs) of
  Err e => Err e
  Ok (Pair seg afterSeg) => case skipBlank afterSeg of
    TomlCursor chars line col => case chars of
      [] => failAt path line "unterminated section header"
      c :: rest =>
        if c == 46 then parseSectionSegments path (TomlCursor rest line (col + 1)) (seg :: acc)
        else if c == 93 then Ok (Pair (reverse (seg :: acc)) (TomlCursor rest line (col + 1)))
        else failAt path line "expected '.' or ']' in section header"

expectEol : String -> TomlCursor -> Result TomlCursor
expectEol path cs = case skipBlank cs of
  TomlCursor chars line col => case chars of
    [] => Ok (TomlCursor chars line col)
    c :: rest =>
      if c == 10 then Ok (TomlCursor rest (line + 1) 1)
      else if c == 35 then expectEolAfterComment path (TomlCursor chars line col)
      else failAt path (cursorLine cs) "unexpected character at end of line"

expectEolAfterComment : String -> TomlCursor -> Result TomlCursor
expectEolAfterComment path cs = case skipComment cs of
  TomlCursor chars line col => case chars of
    [] => Ok (TomlCursor chars line col)
    c :: rest =>
      if c == 10 then Ok (TomlCursor rest (line + 1) 1)
      else failAt path line "unexpected character after comment"

samePath : List a -> List a -> Bool
samePath [] [] = True
samePath (x :: xs) (y :: ys) = if x == y then samePath xs ys else False
samePath _ _ = False

memSectionPath : List a -> List (List a) -> Bool
memSectionPath section seen = case seen of
  [] => False
  s :: rest => if samePath section s then True else memSectionPath section rest

sectionSuffix : List String -> String
sectionSuffix section = case section of
  [] => ""
  first :: rest => " in [" ++ joinDots section ++ "]"

hasEntry : List String -> String -> List TomlEntry -> Bool
hasEntry section key entries = case entries of
  [] => False
  (TomlEntry s k v line) :: rest =>
    if samePath section s && k == key then True else hasEntry section key rest

parseEntryValue : String -> TomlCursor -> Int -> String -> List String -> List (List String) -> List TomlEntry -> Result (List TomlEntry)
parseEntryValue path cs keyLine key section seen entries = case parseValue path (skipBlank cs) of
  Err e => Err e
  Ok (Pair value afterValue) => case expectEol path afterValue of
    Err e => Err e
    Ok afterLine =>
      if hasEntry section key entries then failAt path keyLine ("duplicate key \"" ++ key ++ "\"" ++ sectionSuffix section)
      else parseTomlLoop path afterLine section seen (TomlEntry section key value keyLine :: entries)

parseKeyLine : String -> TomlCursor -> List String -> List (List String) -> List TomlEntry -> Result (List TomlEntry)
parseKeyLine path cs section seen entries = case parseBareKey path cs of
  Err e => Err e
  Ok (Pair key afterKey) => case skipBlank afterKey of
    TomlCursor chars line col => case chars of
      [] => failAt path (cursorLine cs) "expected '=' after key"
      c :: rest =>
        if c == 61 then parseEntryValue path (TomlCursor rest line (col + 1)) (cursorLine cs) key section seen
          entries
        else failAt path (cursorLine cs) ("expected '=' after key \"" ++ key ++ "\"")

parseSectionLine : String -> TomlCursor -> a -> List (List String) -> List TomlEntry -> Result (List TomlEntry)
parseSectionLine path cs section seen entries = case parseSectionPath path (advanceCursor cs) of
  Err e => Err e
  Ok (Pair newSection afterHeader) => if memSectionPath newSection seen then failAt path (cursorLine cs) ("duplicate section [" ++ joinDots newSection ++ "]")
  else case expectEol path afterHeader of
    Err e => Err e
    Ok afterLine => parseTomlLoop path afterLine newSection (newSection :: seen) entries

parseTomlLoop : String -> TomlCursor -> List String -> List (List String) -> List TomlEntry -> Result (List TomlEntry)
parseTomlLoop path cs section seen entries = parseTomlLoopAt path (skipGap cs) section seen entries

parseTomlLoopAt : String -> TomlCursor -> List String -> List (List String) -> List TomlEntry -> Result (List TomlEntry)
parseTomlLoopAt path cs section seen entries = case cursorChars cs of
  [] => Ok (reverse entries)
  c :: rest =>
    if c == 91 then parseSectionLine path cs section seen entries
    else parseKeyLine path cs section seen entries

parseToml : String -> Result (List TomlEntry)
parseToml source = parseTomlAt "" source

parseTomlAt : String -> String -> Result (List TomlEntry)
parseTomlAt path source = parseTomlLoop path (TomlCursor (stripCR (strUnpack source)) 1 1) [] [] []

lookupEntry : List String -> String -> List TomlEntry -> Maybe TomlValue
lookupEntry section key entries = case entries of
  [] => Nothing
  (TomlEntry s k v line) :: rest =>
    if samePath section s && k == key then Just v else lookupEntry section key rest

lookupEntryLine : List String -> String -> List TomlEntry -> Maybe Int
lookupEntryLine section key entries = case entries of
  [] => Nothing
  (TomlEntry s k v line) :: rest =>
    if samePath section s && k == key then Just line else lookupEntryLine section key rest
