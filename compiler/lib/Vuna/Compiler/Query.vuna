-- | 查询图引擎：按 key 记忆化、依赖快照、early cutoff、动态依赖、可观测 trace。
module Vuna.Compiler.Query where

-- Vuna.Compiler.Query：查询图的**纯核心**（一个 key = 一个缓存单元 = 一个可观测单元）。
--
-- 每次查询只做四步：
--   1. 把调用方声明的 dep 从 db 里取**当前**摘要（快照）；
--   2. 与旧 entry 记录的依赖快照比较：一致即命中，**不调用** compute；
--   3. 否则调用 compute；新值摘要与旧值相同即 early cutoff（只更新依赖快照与命中数，
--      值/摘要保持不变，因此下游对它的命中判据不受「无关重算」影响）；
--   4. 记一行 trace：`hit <key>` / `cutoff <key>` / `miss <key>`，按发生顺序由
--      `dbTrace` 读出。
--
-- **依赖比较是顺序无关的**（D-Q3）：`Entry.entryDeps` 写入前按 dep key 排序，
-- 比较即逐项比排序后的表。旧实现「dep 顺序不同即不同依赖」会制造伪 miss——调用方
-- 常用 `HashMap.toList`（桶序不稳定）拼 dep 列表，顺序一抖动就整链重算。
--
-- **动态依赖**（`queryWith`）：compute 可以返回「我实际读了哪些 key」，这些观测依赖
-- 就是下次的命中判据（TTC / salsa 同款语义）。静态 deps 只用于首次求值与取当前值。
--
-- 刻意的边界：本模块**纯函数、显式 Db、无 I/O、无并行、无取消**。持久化、预算、取消位
-- 与并行调度在 `Vuna.Compiler.Query.Run`（Eff 层）；图内的环也由 run 层用显式栈检测
-- 并记 `cycle <key>`（纯层看不到调用栈，也不引入错误通道）。
--
-- 调用方约定：`deps` 已按拓扑序求过值且都在 db 里；dep 缺失时用 `QBytes <dep-key>`
-- 占位参与计算——不崩，也不会被误判命中（下次真实摘要不同，必然 miss 重算）。
import Base.Bool
import Base.Eq
import Base.HashMap
import Base.Int
import Base.List
import Base.Maybe
import Base.Ord
import Base.Pair
import Base.Sort
import Base.String
import Vuna.Compiler.Hash

-- | 查询值。刻意只有三种形态：
--
--   * `QMarker`：无载荷（「同输入下曾经成功」，如 check 缓存条目）；
--   * `QBytes`：内联载荷（通常 ≤ 64 KB）；
--   * `QRef`：大载荷的内容地址（`Hash.contentAddress`），需要内容时从 `Store` 取
--     （D-Q4：`Db` 不常驻 MB 级产物）。
export data QVal(..) : Type where
  QMarker : QVal
  QBytes : String -> QVal
  QRef : String -> QVal

-- | 一个 key 的缓存条目。
export record Entry(..) where
  -- | 观测依赖快照：dep key + 当时的摘要。**始终按 dep key 升序**（顺序无关比较）。
  entryDeps : List (Pair String String)
  -- | 上次调用**声明**的依赖 key 集合（升序）。声明集合变了 ⇒ 图输入变了 ⇒ 必须
  -- 重算（否则「新增一个 import」这类变化永远看不见：观测依赖里根本没有新 key）。
  entryDeclared : List String
  -- | 值摘要（`digestOfVal`，64 位十六进制）。
  entryDigest : String
  -- | 产物来源：`pkg`（整包 check/build）/ `tool`（LSP/REPL 单模块）——与 iface 的
  -- `meOrigin` 同一语义，命令行只信任 `pkg`。
  entryOrigin : String
  entryVal : QVal
  -- | 命中次数（观测用；写进会话索引便于诊断「节点到底命中没有」）。
  entryHits : Int

-- | 查询图状态：key → entry 的记忆化表 + 按发生顺序排列（读侧 reverse）的 trace。
export record Db where
  dbEntryMap : HashMap String Entry
  dbTraceLines : List String
  -- | 新建 entry 时写入的产物来源（run 层按调用方身份设置：`pkg` / `tool`）。
  dbOrigin : String

-- | 空查询图：无缓存、无 trace，来源 `pkg`。
export dbEmpty : Db
dbEmpty = Db (Base.HashMap.fromList []) [] "pkg"

-- | 设置后续新建条目的产物来源。
export dbWithOrigin : Db -> String -> Db
dbWithOrigin db origin = Db db.dbEntryMap db.dbTraceLines origin

export dbOriginOf : Db -> String
dbOriginOf db = db.dbOrigin

-- | 按**发生顺序**返回 trace 行。
export dbTrace : Db -> List String
dbTrace db = reverse db.dbTraceLines

-- | trace 拼成一行（逗号分隔，无末尾逗号）——`--debug-query` / 测试断言用。
export dbTraceText : Db -> String
dbTraceText db = joinComma (dbTrace db)

joinComma : List String -> String
joinComma [] = ""
joinComma ([x]) = x
joinComma (x :: rest) = "${x},${joinComma rest}"

-- | 条目数。
export dbEntryCount : Db -> Int
dbEntryCount db = Base.HashMap.size db.dbEntryMap

-- | 查一个 key 的当前值。
export dbLookup : Db -> String -> Maybe QVal
dbLookup db key = case Base.HashMap.lookup key db.dbEntryMap of
  Just e => Just e.entryVal
  Nothing => Nothing

-- | 追加一行 trace（run 层用它记 `cycle` / `reject` 等图外事件）。
export dbNote : Db -> String -> Db
dbNote db line = Db db.dbEntryMap (line :: db.dbTraceLines) db.dbOrigin

-- | 载荷的内容地址（64 位十六进制）：`QBytes` / `QRef` 的完整性口径。
export digestOfPayload : String -> String
digestOfPayload payload = Vuna.Compiler.Hash.contentAddress payload

-- | 把 QVal 渲染成**单射**的规范文本（`digestOfVal` 的输入）。
--
-- 每个构造子带独立标签，字符串用「字节长度:内容」前缀编码 ⇒ 不同值不会渲染成同一串，
-- 因此摘要相同的实际内容也相同（cutoff 判据成立）。字段之间不需要分隔符：长度前缀
-- 本身可解析。
export showQVal : QVal -> String
showQVal QMarker = "marker:"
showQVal (QBytes s) = "bytes:${lenPrefixed s}"
showQVal (QRef d) = "ref:${lenPrefixed d}"

-- | 「字节长度:内容」前缀编码（可解析的字符串原子）。
lenPrefixed : String -> String
lenPrefixed s = "${strLength s}:${s}"

-- | 值的摘要（64 位十六进制）。
export digestOfVal : QVal -> String
digestOfVal v = digestOfPayload (showQVal v)

-- ---------------------------------------------------------------
-- 依赖快照
-- ---------------------------------------------------------------
-- | 一个依赖的当前状态。
record DepSnap where
  dsKey : String
  dsDigest : String
  dsValue : QVal

-- 投影走访问器：lambda 形参的类型由推断给出时，直接写 `s.dsKey` 无法解析字段。
dsKeyOf : DepSnap -> String
dsKeyOf s = s.dsKey

dsDigestOf : DepSnap -> String
dsDigestOf s = s.dsDigest

dsValueOf : DepSnap -> QVal
dsValueOf s = s.dsValue

-- | 取一个 dep 的当前快照；缺失时用 `QBytes key` 占位（见模块头约定）。
snapDep : Db -> String -> DepSnap
snapDep db key = case Base.HashMap.lookup key db.dbEntryMap of
  Just e => DepSnap key e.entryDigest e.entryVal
  Nothing => DepSnap key (digestOfVal (QBytes key)) (QBytes key)

snapDeps : Db -> List String -> List DepSnap
snapDeps db [] = []
snapDeps db (key :: rest) = snapDep db key :: snapDeps db rest

-- | 快照 → 排序后的 (key, digest) 表（写入 entry 的规范形态）。
depPairsSorted : List DepSnap -> List (Pair String String)
depPairsSorted snaps = sortByDepKey (map (\s => Pair (dsKeyOf s) (dsDigestOf s)) snaps)

-- | 按 dep key 升序（`Base.Sort.sortBy` 是插入排序，满足 DT 的结构递归检查）。
sortByDepKey : List (Pair String String) -> List (Pair String String)
sortByDepKey ps = sortBy (\p, q => firstOf p <= firstOf q) ps

-- | 依赖快照逐项比较（两侧都已排序 ⇒ 顺序无关比较）。
sameDeps : List (Pair String String) -> List (Pair String String) -> Bool
sameDeps [] [] = True
sameDeps [] (_ :: _) = False
sameDeps (_ :: _) [] = False
sameDeps (p :: ps) (q :: qs) = firstOf p == firstOf q && secondOf p == secondOf q && sameDeps ps qs

-- ---------------------------------------------------------------
-- 查询（三段式：命中判定 / 取依赖值 / 提交结果）
--
-- 拆成三段是为了让 **Eff 层**（`Query.Run`）复用同一套语义：run 层要先做纯命中判定，
-- 命中就完全跳过 compute（compute 可能是真 parse / 真精化）；未命中才在 `Eff` 里算，
-- 算完再回来做纯提交。把这三段各自导出，run 层与纯调用方就共用一份判据。
-- ---------------------------------------------------------------
-- | 静态依赖的查询（最常用形态）：依赖 = 调用方声明的列表。
export query : Db -> String -> List String -> (List QVal -> QVal) -> Pair Db QVal
query db key deps compute = queryWith db key deps (\vals => Pair (compute vals) deps)

-- | 动态依赖的查询：compute 返回「值 + 实际观测到的依赖 key 列表」。
--
-- 观测依赖（而非声明依赖）成为下次的命中判据：compute 少读了一个 dep 就少一条判据，
-- 不会因为「声明里有、实际没用」而伪失效。声明依赖仍用于取当前值。
export queryWith : Db -> String -> List String -> (List QVal -> Pair QVal (List String)) -> Pair Db QVal
queryWith db key deps compute = case queryHit db key deps of
  Just v => Pair (markHit db key) v
  Nothing => queryResolve db key deps (compute (queryDepValues db deps))

-- | 命中判定（纯）：`Just v` = 旧 entry 存在且**它的判据**当前仍成立 ⇒ 不要重算。
--
-- 三条判据都要过：
--   1. **声明集合一致**：调用方这次声明的 dep key 集合与上次相同（升序比较，D-Q3）。
--      声明集合变了说明图的输入面变了（新增 import / 换入口），必须重算——否则
--      「新增一个依赖」这类变化永远看不见（观测依赖里根本没有新 key）。
--   2. **观测依赖摘要未变**：entry 记录的 `entryDeps` 逐项比当前摘要（顺序无关）。
--      「声明了但没读」的 key 因此不参与失效判定（动态依赖的意义）。
--   3. dep 缺失按 `QBytes key` 占位 ⇒ 「dep 还没算」不会误判命中。
export queryHit : Db -> String -> List String -> Maybe QVal
queryHit db key deps = case Base.HashMap.lookup key db.dbEntryMap of
  Nothing => Nothing
  Just old =>
    if sortKeys deps == old.entryDeclared && sameDeps old.entryDeps (depPairsSorted (map (snapDep db) (recordedKeys old.entryDeps))) then Just old.entryVal
    else Nothing

-- | dep key 列表 → 升序（声明集合的规范形态）。
sortKeys : List String -> List String
sortKeys keys = sortBy (\a, b => a <= b) keys

recordedKeys : List (Pair String String) -> List String
recordedKeys [] = []
recordedKeys ((Pair k _) :: rest) = k :: recordedKeys rest

-- | 取声明依赖的当前值（按调用方给的顺序；miss 重算时喂给 compute）。
export queryDepValues : Db -> List String -> List QVal
queryDepValues db deps = map (\s => dsValueOf s) (snapDeps db deps)

-- | 命中记账：命中数 +1，trace 记 `hit <key>`，值不变。
export markHit : Db -> String -> Db
markHit db key = case Base.HashMap.lookup key db.dbEntryMap of
  Nothing => Db db.dbEntryMap ("hit ${key}" :: db.dbTraceLines) db.dbOrigin
  Just old =>
    Db
      (Base.HashMap.insert key (Entry old.entryDeps old.entryDeclared old.entryDigest old.entryOrigin old.entryVal (old.entryHits + 1)) db.dbEntryMap)
      ("hit ${key}" :: db.dbTraceLines) db.dbOrigin

-- | 提交一次重算结果：`result` 是 compute 的产物（值 + 观测依赖）。
--
-- 旧值摘要与新值相同 ⇒ `cutoff`（保留旧值/来源，只更新依赖快照与命中数）；
-- 否则 ⇒ `miss`（写新 entry）。无旧 entry 时一律 `miss`。
export queryResolve : Db -> String -> List String -> Pair QVal (List String) -> Pair Db QVal
queryResolve db key deps result = firstOf (queryResolveTagged db key deps result)

-- | `queryResolve` 的**带标签**形态：额外返回本次提交的类别 `miss` / `cutoff`。
--
-- Eff 层（`Query.Run`）要用它记节点 span 的 outcome：判据与提交只有这一份实现，
-- span 标签不能重新猜（`cutoff` 与 `miss` 的判据就是这里比的两个摘要）。
export queryResolveTagged : Db -> String -> List String -> Pair QVal (List String) -> Pair (Pair Db QVal) String
queryResolveTagged db key deps result =
  let
    val = firstOf result
    declared = sortKeys deps
    observed = depPairsFromKeys db (snapDeps db deps) (secondOf result)
    digest = digestOfVal val
  in case Base.HashMap.lookup key db.dbEntryMap of
    Nothing => Pair (Pair (commitMiss db key declared observed digest val) val) "miss"
    Just old =>
      if old.entryDigest == digest then Pair
        (Pair (Db (Base.HashMap.insert key (Entry observed declared old.entryDigest old.entryOrigin old.entryVal (old.entryHits + 1)) db.dbEntryMap) ("cutoff ${key}" :: db.dbTraceLines) db.dbOrigin) old.entryVal)
        "cutoff"
      else Pair (Pair (commitMiss db key declared observed digest val) val) "miss"

-- | 写新 entry（trace 记 `miss`）。
commitMiss : Db -> String -> List String -> List (Pair String String) -> String -> QVal -> Db
commitMiss db key declared observed digest val =
  Db (Base.HashMap.insert key (Entry observed declared digest db.dbOrigin val 0) db.dbEntryMap)
    ("miss ${key}" :: db.dbTraceLines) db.dbOrigin

-- | 观测依赖 → 排序后的快照表（同轮已拍的声明快照优先，避免重复读 db）。
depPairsFromKeys : Db -> List DepSnap -> List String -> List (Pair String String)
depPairsFromKeys db declared keys = depPairsSorted (map (snapDepWith db declared) keys)

-- | 取观测依赖的当前快照：优先用本次已拍的声明快照（同一轮内一致），否则现拍。
snapDepWith : Db -> List DepSnap -> String -> DepSnap
snapDepWith db declared key = case findSnap declared key of
  Just s => s
  Nothing => snapDep db key

findSnap : List DepSnap -> String -> Maybe DepSnap
findSnap [] _ = Nothing
findSnap (s :: rest) key = if dsKeyOf s == key then Just s else findSnap rest key

-- 手工验证（仓库没有单测框架，`vuna check compiler` 只保证类型/终止性；
-- 集成断言在 `test/suite/steps/64_infra.steps` 与 `72_query_graph.steps`）：
--
--   1) 首次 `query dbEmpty "a" [] (\_ => QBytes "1")` ⇒ trace `["miss a"]`；
--   2) 同 key 同 dep 再查 ⇒ trace 尾 `hit a`，compute 不被调用；
--   3) 上游换 key（`src#4` → `src#5`）⇒ 下游重算但摘要不变 ⇒ 尾 `cutoff b`；
--   4) 上游改且下游输出变 ⇒ 尾 `miss b`；
--   5) 依赖顺序：`["x","y"]` 与 `["y","x"]` 视为同一声明集合（D-Q3）；
--   6) 动态依赖：`queryWith` 只观测 `da` ⇒ 改 `db` 后仍 `hit`。
-- ---------------------------------------------------------------
