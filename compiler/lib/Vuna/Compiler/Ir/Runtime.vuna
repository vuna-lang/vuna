module Vuna.Compiler.Ir.Runtime where

-- Vuna.Compiler.Ir.Runtime：IR ↔ 运行时的**契约**（Track A 第二步）。
--
-- 定位：`Core --Lower--> IR --后端--> 目标文本`。IR 节点里只有**符号**，没有目标文本：
-- `IrRt sym` / `IrRtApp sym args` 的 `sym` 必须在本模块的契约里声明，后端（当前是
-- `Codegen.Runtime` 的 OCaml 表）对契约**全覆盖**才能渲染。
--
-- 为什么需要这一层：迁移后的 IR 仍携带 `Intrinsics.intrinsicRuntime` 的 OCaml 表达式
-- （`bi_add`、`(fun key name v -> Effect.perform ...)` 之类），第二个后端拿不到可实现的
-- 契约。现在符号名 = 内建名（编译器词汇，不是目标文本），目标文本只留在后端。
--
-- 谁能做什么：
--   * `Lower`：产生符号；用 `irRtBridgesList` 决定 List 桥接护栏；在 program-level check
--     上做 `Intrinsics` ↔ 契约 ↔ 后端表的一致性检查（`checkRuntimeContract`）；
--   * `Ir.validateUnit`：校验 IR 里每个符号已声明、饱和应用 arity 与 `irInlineArity` 一致；
--   * 后端：对契约实现「符号 → 目标文本/目标代码」，不得自己猜名字。
--
-- 桥接（`irRtBridgesList = True`）：该符号的运行时模板引用 canonical `Base.List.List`
-- 族的 `dtp_*` helper；只有程序声明了该族时才能使用（诊断 `CG_ListBridgeRequired`），
-- 且渲染时 helper 名要按 List 族的归属单元限定（机制在 OCaml 后端）。
--
-- 合成符号 `@ir@*`：入口展示函数与 Nat 后继，不对应任何内建（见 `irRtSyntheticNames`）。
--
-- 边界：本模块只 import `Ir.Model` 与 Base 的纯数据结构；不 import Core/Elab/Intrinsics
-- 与任何后端（`checks.ir-boundary` 守护）。
import Base.Bool
import Base.List
import Base.Maybe
import Base.Pair
import Vuna.Compiler.Ir.Model

-- | 契约里的一条运行时符号：名字 + 是否需要 canonical List 族桥接。
export record IrRtSym(..) where
  irRtSymName : String
  irRtSymBridgesList : Bool

-- | 符号名。
export irRtSymNameOf : IrRtSym -> String
irRtSymNameOf (IrRtSym name bridges) = name

-- | 是否桥接。
export irRtSymBridgesOf : IrRtSym -> Bool
irRtSymBridgesOf (IrRtSym name bridges) = bridges

-- 合成符号：入口展示（五种内建类型）与 Nat 后继；不对应任何内建。
-- Lowering 用这些常量发节点，避免名字散落。
export irRtNatSucc : String
irRtNatSucc = "@ir@natSucc"

export irRtShowInt : String
irRtShowInt = "@ir@showInt"

export irRtShowNat : String
irRtShowNat = "@ir@showNat"

export irRtShowStr : String
irRtShowStr = "@ir@showStr"

export irRtShowFloat : String
irRtShowFloat = "@ir@showFloat"

export irRtShowBool : String
irRtShowBool = "@ir@showBool"

-- | 合成符号清单（契约一部分；与上面的常量必须同步）。
export irRtSyntheticNames : List String
irRtSyntheticNames =
  [irRtNatSucc, irRtShowInt, irRtShowNat, irRtShowStr, irRtShowFloat, irRtShowBool]

