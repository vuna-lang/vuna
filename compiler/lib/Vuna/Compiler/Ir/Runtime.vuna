-- | 全部契约符号名（无重复；查找用 `irRtLookup`）。
export irRtNames : List String
irRtNames = append irRtPlainNames (append irRtBridgedNames irRtSyntheticNames)

-- | 契约本体：普通内建 + 桥接内建 + 合成符号。
export irRtContract : List IrRtSym
irRtContract =
  append (map (\n => IrRtSym n False) irRtPlainNames)
    (append (map (\n => IrRtSym n True) irRtBridgedNames) (map (\n => IrRtSym n False) irRtSyntheticNames))

irRtLookupGo : String -> List IrRtSym -> Maybe IrRtSym
irRtLookupGo name [] = Nothing
irRtLookupGo name (s :: rest) = if irRtSymNameOf s == name then Just s else irRtLookupGo name rest

-- | 按名字查契约条目。
export irRtLookup : String -> Maybe IrRtSym
irRtLookup name = irRtLookupGo name irRtContract

-- | 名字是否是契约符号。
export irRtIsKnown : String -> Bool
irRtIsKnown name = case irRtLookup name of
  Just _ => True
  Nothing => False

-- | 该符号是否需要 List 族桥接（未声明的名字返回 False）。
export irRtBridgesList : String -> Bool
irRtBridgesList name = case irRtLookup name of
  Just s => irRtSymBridgesOf s
  Nothing => False

-- ---------------------------------------------------------------
-- IR 项的符号引用（纯结构遍历）
-- ---------------------------------------------------------------
--
-- 只收集运行时符号引用：`IrRt`（作为值）与 `IrRtApp`（饱和应用，带实参个数）。
-- 结构递归、无预算（IR 本身没有 fuel 概念）。
-- | 列表长度（本模块不依赖 Compiler 的局部 helper）。
irListLength : List a -> Int
irListLength [] = 0
irListLength (x :: rest) = 1 + irListLength rest

-- | 一个 IR 项引用到的运行时符号（`Nothing` = 作为值引用，`Just n` = 饱和应用 n 个实参）。
export irSymbolsOf : Ir -> List (Pair String (Maybe Int))
irSymbolsOf (IrVar _) = []
irSymbolsOf (IrGlobal _) = []
irSymbolsOf (IrCtor _ _ args) = concatMap irSymbolsOf args
irSymbolsOf (IrRecord _ fields) = concatMap irSymbolsOfField fields
irSymbolsOf (IrProj base _ _) = irSymbolsOf base
irSymbolsOf (IrRecUpd base _ fields) = append (irSymbolsOf base) (concatMap irSymbolsOfField fields)
irSymbolsOf (IrRt sym) = [Pair sym Nothing]
irSymbolsOf (IrRtApp sym args) =
  append [Pair sym (Just (irListLength args))] (concatMap irSymbolsOf args)
irSymbolsOf (IrCast inner) = irSymbolsOf inner
irSymbolsOf (IrInt _) = []
irSymbolsOf (IrStr _) = []
irSymbolsOf (IrBool _) = []
irSymbolsOf (IrFloatLit _) = []
irSymbolsOf (IrLet _ scrut body) = append (irSymbolsOf scrut) (irSymbolsOf body)
irSymbolsOf (IrLam _ body) = irSymbolsOf body
irSymbolsOf (IrApp f a) = append (irSymbolsOf f) (irSymbolsOf a)
irSymbolsOf (IrIf c t e) = append (irSymbolsOf c) (append (irSymbolsOf t) (irSymbolsOf e))
irSymbolsOf (IrCase scrut alts) = append (irSymbolsOf scrut) (concatMap irSymbolsOfAlt alts)
irSymbolsOf (IrNatCase scrut _ z s c) =
  append (irSymbolsOf scrut)
    (append (irSymbolsOfAltMaybe z) (append (irSymbolsOfAltMaybe s) (irSymbolsOfAltMaybe c)))
irSymbolsOf (IrConcatMany parts) = concatMap irSymbolsOf parts
irSymbolsOf (IrEffThunk _ _ _ _ prim) = irSymbolsOf prim
irSymbolsOf (IrEffBind _ _ _) = []

irSymbolsOfField : Pair String Ir -> List (Pair String (Maybe Int))
irSymbolsOfField p = irSymbolsOf (secondOf p)

irSymbolsOfAlt : IrAlt -> List (Pair String (Maybe Int))
irSymbolsOfAlt alt = irSymbolsOf (irAltBodyOf alt)

irSymbolsOfAltMaybe : Maybe IrAlt -> List (Pair String (Maybe Int))
irSymbolsOfAltMaybe Nothing = []
irSymbolsOfAltMaybe (Just alt) = irSymbolsOfAlt alt

irSymbolsOfDef : IrDef -> List (Pair String (Maybe Int))
irSymbolsOfDef d = case irDefBody d of
  Nothing => []
  Just b => irSymbolsOf b

-- | 一个单元的符号引用（全部定义体 + 入口展示节点）。
export irSymbolsOfUnit : IrUnit -> List (Pair String (Maybe Int))
irSymbolsOfUnit u =
  append (concatMap irSymbolsOfDef (concatMap irGroupDefs u.irUnitGroups))
    (irSymbolsOfEntry u.irUnitEntry)

irSymbolsOfEntry : Maybe IrEntry -> List (Pair String (Maybe Int))
irSymbolsOfEntry Nothing = []
irSymbolsOfEntry (Just e) = irSymbolsOf (irEntryShowOf e)
