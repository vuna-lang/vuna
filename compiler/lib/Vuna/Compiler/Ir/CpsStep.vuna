module Vuna.Compiler.Ir.CpsStep where

-- 全片段 CPS（ANF 输入）。每个递归函数都有 `if fuel <= 0` 守卫；fuel 同时用作
-- fresh binder 编号。守卫让 SCT 的「guard Int fuel thread」判据成立：
-- guard 区外所有组内调用传 fuel - k（k > 0），因此同一位置严格下降。
import Base.Bool
import Base.HashMap
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.Result
import Base.String
import Vuna.Compiler.Ir.Model

export irStepDoneName : String
irStepDoneName = "@ir@cps@done"

export irStepPerformName : String
irStepPerformName = "@ir@cps@perform"

export irStepHandleName : String
irStepHandleName = "@ir@cps@handle"

export irStepSelfName : String
irStepSelfName = "@ir@cps@self"

export irStepRunName : String
irStepRunName = "@ir@cps@run"

startFuel : Int
startFuel = 200000

binderErased : IrBinder -> Bool
binderErased b = case b of
  IrBinder _ erased => erased

runtimeBinders : List IrBinder -> List IrBinder
runtimeBinders bs = filter (\b => not (binderErased b)) bs

mkBinder : String -> IrBinder
mkBinder name = mkIrBinder name

freshK : Int -> IrBinder
freshK n = mkBinder ("__cpsK" ++ strFromInt n)

freshV : Int -> IrBinder
freshV n = mkBinder ("__cpsV" ++ strFromInt n)

freshU : Int -> IrBinder
freshU n = mkBinder ("__cpsU" ++ strFromInt n)

freshA : Int -> Int -> IrBinder
freshA n i = mkBinder ("__cpsA" ++ strFromInt n ++ "_" ++ strFromInt i)

applyAll : Ir -> List Ir -> Ir
applyAll f [] = f
applyAll f (a :: rest) = applyAll (IrApp f a) rest

flattenApp : Ir -> Pair Ir (List Ir)
flattenApp (IrApp f a) =
  let
    p = flattenApp f
  in Pair (firstOf p) (append (secondOf p) [a])
flattenApp x = Pair x []

listLen : List a -> Int
listLen [] = 0
listLen (_ :: rest) = 1 + listLen rest

arityLookup : HashMap String Int -> String -> Int
arityLookup tbl name = case Base.HashMap.lookup name tbl of
  Just n => n
  Nothing => 0

externLookup : HashMap String Bool -> String -> Bool
externLookup tbl name = case Base.HashMap.lookup name tbl of
  Just b => b
  Nothing => False

isEffPrim : String -> Bool
isEffPrim s = s == "prim_effectPerform" || s == "prim_effectHandle" || s == "prim_effectSelf"

cpsPrimName : String -> String
cpsPrimName s =
  if s == "prim_effectPerform" then irStepPerformName
  else if s == "prim_effectHandle" then irStepHandleName
  else if s == "prim_effectSelf" then irStepSelfName
  else s

isControl : Ir -> Bool
isControl e = case e of
  IrCase _ _ => True
  IrIf _ _ _ => True
  IrNatCase _ _ _ _ _ => True
  _ => False

isCpsApp : HashMap String Int -> HashMap String Bool -> Ir -> Bool
isCpsApp arities externs e =
  let
    p = flattenApp e
    head = firstOf p
    argc = listLen (secondOf p)
  in case head of
    IrGlobal name =>
      if externLookup externs name then False
      else arityLookup arities name > 0 && argc == arityLookup arities name
    IrVar _ => True
    IrLam bs _ => argc > 0 && argc == listLen (runtimeBinders bs)
    IrRt sym => isEffPrim sym
    _ => False

isCpsRhs : HashMap String Int -> HashMap String Bool -> Ir -> Bool
isCpsRhs arities externs e = case e of
  IrApp _ _ => isCpsApp arities externs e
  _ => False

cpsBody : Int -> HashMap String Int -> HashMap String Bool -> Ir -> Ir -> Pair Ir Int
cpsBody fuel arities externs e k =
  if fuel <= 0 then Pair (IrApp k (IrInt 0)) fuel
  else case e of
    IrLet bs rhs body =>
      let
        v = freshV fuel
        b = cpsBody (fuel - 2) arities externs body k
        cont = IrLam [v] (IrLet bs (IrVar v) (firstOf b))
      in if isControl rhs then cpsBody (fuel - 1) arities externs rhs cont
        else if isCpsRhs arities externs rhs then
          cpsRhs (fuel - 1) arities externs rhs cont
        else
          let
            r = transformDirect (fuel - 1) arities externs rhs
          in Pair (IrLet bs (firstOf r) (firstOf b)) (secondOf b)
    IrCase scrut alts =>
      let
        s = transformDirect (fuel - 1) arities externs scrut
        a = cpsAlts (fuel - 2) arities externs alts k
      in Pair (IrCase (firstOf s) (firstOf a)) (secondOf a)
    IrIf c t el =>
      let
        cc = transformDirect (fuel - 1) arities externs c
        tt = cpsBody (fuel - 2) arities externs t k
        ee = cpsBody (fuel - 3) arities externs el k
      in Pair (IrIf (firstOf cc) (firstOf tt) (firstOf ee)) (secondOf ee)
    IrNatCase scrut fresh zero succ catch =>
      let
        s = transformDirect (fuel - 1) arities externs scrut
        z = cpsAltMaybe (fuel - 2) arities externs zero k
        su = cpsAltMaybe (fuel - 3) arities externs succ k
        ca = cpsAltMaybe (fuel - 4) arities externs catch k
      in Pair (IrNatCase (firstOf s) fresh (firstOf z) (firstOf su) (firstOf ca)) (secondOf ca)
    _ => cpsRhs (fuel - 1) arities externs e k

cpsRhs : Int -> HashMap String Int -> HashMap String Bool -> Ir -> Ir -> Pair Ir Int
cpsRhs fuel arities externs e k =
  if fuel <= 0 then Pair (IrApp k (IrInt 0)) fuel
  else
    let
      p = flattenApp e
      head = firstOf p
      args = secondOf p
      argc = listLen args
    in case head of
      IrGlobal name =>
        if externLookup externs name then
          let
            a = transformList (fuel - 1) arities externs args
          in Pair (IrApp k (applyAll (IrGlobal name) (firstOf a))) (secondOf a)
        else
          let
            n = arityLookup arities name
            a = transformList (fuel - 1) arities externs args
          in if n > 0 && argc == n then
            Pair (applyAll (IrGlobal name) (append (firstOf a) [k])) (secondOf a)
          else Pair (IrApp k (applyAll (IrGlobal name) (firstOf a))) (secondOf a)
      IrVar _ =>
        let
          a = transformList (fuel - 1) arities externs args
        in Pair (applyAll head (append (firstOf a) [k])) (secondOf a)
      IrLam bs body =>
        let
          l = cpsLam (fuel - 1) arities externs bs body
          a = transformList (fuel - 2) arities externs args
        in if argc == listLen (runtimeBinders bs) then
          Pair (applyAll (firstOf l) (append (firstOf a) [k])) (secondOf a)
        else Pair (IrApp k (applyAll (firstOf l) (firstOf a))) (secondOf a)
      IrRt sym =>
        if isEffPrim sym then
          let
            a = transformList (fuel - 1) arities externs args
          in Pair (applyAll (IrRt (cpsPrimName sym)) (append (firstOf a) [k])) (secondOf a)
        else
          let
            a = transformList (fuel - 1) arities externs args
          in Pair (IrApp k (applyAll (IrRt sym) (firstOf a))) (secondOf a)
      _ =>
        let
          a = transformList (fuel - 1) arities externs args
        in Pair (IrApp k (applyAll head (firstOf a))) (secondOf a)

transformDirect : Int -> HashMap String Int -> HashMap String Bool -> Ir -> Pair Ir Int
transformDirect fuel arities externs e =
  if fuel <= 0 then Pair e fuel
  else case e of
    IrLam bs body => cpsLam (fuel - 1) arities externs bs body
    IrCtor family ctor args =>
      let
        a = transformList (fuel - 1) arities externs args
      in Pair (IrCtor family ctor (firstOf a)) (secondOf a)
    IrRecord family fields =>
      let
        f = transformFields (fuel - 1) arities externs fields
      in Pair (IrRecord family (firstOf f)) (secondOf f)
    IrProj base family field =>
      let
        b = transformDirect (fuel - 1) arities externs base
      in Pair (IrProj (firstOf b) family field) (secondOf b)
    IrRecUpd base family fields =>
      let
        b = transformDirect (fuel - 1) arities externs base
        f = transformFields (fuel - 2) arities externs fields
      in Pair (IrRecUpd (firstOf b) family (firstOf f)) (secondOf f)
    IrRtApp sym args =>
      let
        a = transformList (fuel - 1) arities externs args
      in Pair (IrRtApp sym (firstOf a)) (secondOf a)
    IrCast inner =>
      let
        a = transformDirect (fuel - 1) arities externs inner
      in Pair (IrCast (firstOf a)) (secondOf a)
    IrLet bs rhs body =>
      let
        r = transformDirect (fuel - 1) arities externs rhs
        b = transformDirect (fuel - 2) arities externs body
      in Pair (IrLet bs (firstOf r) (firstOf b)) (secondOf b)
    IrApp f a =>
      let
        ff = transformDirect (fuel - 1) arities externs f
        aa = transformDirect (fuel - 2) arities externs a
      in Pair (IrApp (firstOf ff) (firstOf aa)) (secondOf aa)
    IrIf c t el =>
      let
        cc = transformDirect (fuel - 1) arities externs c
        tt = transformDirect (fuel - 2) arities externs t
        ee = transformDirect (fuel - 3) arities externs el
      in Pair (IrIf (firstOf cc) (firstOf tt) (firstOf ee)) (secondOf ee)
    IrCase scrut alts =>
      let
        s = transformDirect (fuel - 1) arities externs scrut
        a = transformAlts (fuel - 2) arities externs alts
      in Pair (IrCase (firstOf s) (firstOf a)) (secondOf a)
    IrNatCase scrut fresh zero succ catch =>
      let
        s = transformDirect (fuel - 1) arities externs scrut
      in Pair
        (IrNatCase (firstOf s) fresh (transformAltMaybe (fuel - 2) arities externs zero)
          (transformAltMaybe (fuel - 3) arities externs succ)
          (transformAltMaybe (fuel - 4) arities externs catch))
        (fuel - 5)
    IrConcatMany parts =>
      let
        a = transformList (fuel - 1) arities externs parts
      in Pair (IrConcatMany (firstOf a)) (secondOf a)
    IrEffThunk family ctor _unitTy arity prim =>
      let
        u = freshU fuel
        k = freshK (fuel - 1)
        argBs = map (\i => freshA (fuel - 2) i) (range 0 arity)
        applied = applyAll (firstOf (transformDirect (fuel - 3) arities externs prim)) (map IrVar argBs)
        effVal = IrCtor family ctor [IrLam [u, k] (IrApp (IrVar k) applied)]
      in if arity <= 0 then Pair effVal (fuel - 4)
        else
          let
            kOuter = freshK (fuel - 4)
          in Pair (IrLam (append argBs [kOuter]) (IrApp (IrVar kOuter) effVal)) (fuel - 4)
    IrVar _ => Pair e fuel
    IrGlobal _ => Pair e fuel
    IrRt _ => Pair e fuel
    IrInt _ => Pair e fuel
    IrStr _ => Pair e fuel
    IrBool _ => Pair e fuel
    IrFloatLit _ => Pair e fuel
    IrEffBind _ _ _ => Pair e fuel

cpsLam : Int -> HashMap String Int -> HashMap String Bool -> List IrBinder -> Ir -> Pair Ir Int
cpsLam fuel arities externs bs body =
  if fuel <= 0 then Pair (IrLam bs body) fuel
  else
    let
      k = freshK fuel
      b = cpsBody (fuel - 1) arities externs body (IrVar k)
    in Pair (IrLam (append bs [k]) (firstOf b)) (secondOf b)

transformList : Int -> HashMap String Int -> HashMap String Bool -> List Ir -> Pair (List Ir) Int
transformList fuel arities externs xs =
  if fuel <= 0 then Pair xs fuel
  else case xs of
    [] => Pair [] fuel
    x :: rest =>
      let
        a = transformDirect (fuel - 1) arities externs x
        r = transformList (fuel - 2) arities externs rest
      in Pair (firstOf a :: firstOf r) (secondOf r)

transformFields : Int -> HashMap String Int -> HashMap String Bool -> List (Pair String Ir) -> Pair (List (Pair String Ir)) Int
transformFields fuel arities externs xs =
  if fuel <= 0 then Pair xs fuel
  else case xs of
    [] => Pair [] fuel
    p :: rest =>
      let
        a = transformDirect (fuel - 1) arities externs (secondOf p)
        r = transformFields (fuel - 2) arities externs rest
      in Pair (Pair (firstOf p) (firstOf a) :: firstOf r) (secondOf r)

cpsAlts : Int -> HashMap String Int -> HashMap String Bool -> List IrAlt -> Ir -> Pair (List IrAlt) Int
cpsAlts fuel arities externs alts k =
  if fuel <= 0 then Pair alts fuel
  else case alts of
    [] => Pair [] fuel
    a :: rest =>
      let
        b = cpsBody (fuel - 1) arities externs a.irAltBody k
        r = cpsAlts (fuel - 2) arities externs rest k
      in Pair (IrAlt a.irAltCtor a.irAltBinders (firstOf b) :: firstOf r) (secondOf r)

cpsAltMaybe : Int -> HashMap String Int -> HashMap String Bool -> Maybe IrAlt -> Ir -> Pair (Maybe IrAlt) Int
cpsAltMaybe fuel arities externs m k =
  if fuel <= 0 then Pair m fuel
  else case m of
    Nothing => Pair Nothing fuel
    Just a =>
      let
        b = cpsBody (fuel - 1) arities externs a.irAltBody k
      in Pair (Just (IrAlt a.irAltCtor a.irAltBinders (firstOf b))) (secondOf b)

transformAlts : Int -> HashMap String Int -> HashMap String Bool -> List IrAlt -> Pair (List IrAlt) Int
transformAlts fuel arities externs alts =
  if fuel <= 0 then Pair alts fuel
  else case alts of
    [] => Pair [] fuel
    a :: rest =>
      let
        b = transformDirect (fuel - 1) arities externs a.irAltBody
        r = transformAlts (fuel - 2) arities externs rest
      in Pair (IrAlt a.irAltCtor a.irAltBinders (firstOf b) :: firstOf r) (secondOf r)

transformAltMaybe : Int -> HashMap String Int -> HashMap String Bool -> Maybe IrAlt -> Maybe IrAlt
transformAltMaybe fuel arities externs m =
  if fuel <= 0 then m
  else case m of
    Nothing => Nothing
    Just a =>
      let
        b = transformDirect (fuel - 1) arities externs a.irAltBody
      in Just (IrAlt a.irAltCtor a.irAltBinders (firstOf b))

cpsDef : Int -> HashMap String Int -> HashMap String Bool -> IrDef -> Pair IrDef Int
cpsDef fuel arities externs d =
  if fuel <= 0 then Pair d fuel
  else case d of
    IrExternDef _ _ _ _ => Pair d fuel
    IrDef name arity deps body recOk initGuard span =>
      case body of
        IrLam bs inner =>
          let
            l = cpsLam (fuel - 1) arities externs bs inner
          in Pair (IrDef name (arity + 1) deps (firstOf l) recOk initGuard span) (secondOf l)
        _ =>
          let
            b = transformDirect (fuel - 1) arities externs body
          in Pair (IrDef name arity deps (firstOf b) recOk initGuard span) (secondOf b)

cpsDefsList : Int -> HashMap String Int -> HashMap String Bool -> List IrDef -> List IrDef
cpsDefsList fuel arities externs defs =
  if fuel <= 0 then defs
  else case defs of
    [] => []
    d :: rest =>
      let
        x = cpsDef (fuel - 1) arities externs d
      in firstOf x :: cpsDefsList (fuel - 1) arities externs rest

externsOf : List IrDef -> List (Pair String Bool)
externsOf defs = case defs of
  [] => []
  d :: rest => case d of
    IrExternDef name _ _ _ => Pair name True :: externsOf rest
    _ => externsOf rest

export cpsStepDefs : List IrDef -> Result (List IrDef)
cpsStepDefs defs =
  let
    arities = Base.HashMap.fromList (map (\d => Pair (irDefName d) (irDefArity d)) defs)
    externs = Base.HashMap.fromList (externsOf defs)
  in Ok (cpsDefsList startFuel arities externs defs)