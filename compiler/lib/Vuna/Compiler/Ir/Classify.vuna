module Vuna.Compiler.Ir.Classify where

-- IR 定义分类：值 / 用户 CPS 函数 / 零参 CPS 计算。
--
-- 全片段 CPS 需要知道一个 `IrDef` 是普通值（字典、数据、MkEff 动作）、函数
-- （body 是 lambda），还是零参计算（body 是调用/控制流，需要 thunk 成 `\k => Step`）。
-- 这里只做保守分类，并把零参计算改写成 `IrLam [] body`，交给 `Ir.CpsStep` 统一
-- 追加 `k`；arity 表中用 -1 标记「零参 CPS 计算」。
import Base.Bool
import Base.HashMap
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Vuna.Compiler.Ir.Model

export data DefKind : Type where
  DefValue : DefKind
  DefCpsFun : DefKind
  DefCpsThunk : DefKind

kindIsCps : DefKind -> Bool
kindIsCps k = case k of
  DefCpsFun => True
  DefCpsThunk => True
  DefValue => False

isEffPrim : String -> Bool
isEffPrim s = s == "prim_effectPerform" || s == "prim_effectHandle" || s == "prim_effectSelf"

-- | 只检查「本定义体本身是否执行 CPS 计算」；lambda 体是值，不递归进去。
usesCps : Int -> HashMap String DefKind -> Ir -> Bool
usesCps fuel kinds e =
  if fuel <= 0 then True
  else case e of
    IrGlobal name => case Base.HashMap.lookup name kinds of
      Just k => kindIsCps k
      Nothing => False
    IrVar _ => False
    IrRt sym => isEffPrim sym
    IrRtApp _ args => anyIr (fuel - 1) kinds args
    IrInt _ => False
    IrStr _ => False
    IrBool _ => False
    IrFloatLit _ => False
    IrCtor _ _ args => anyIr (fuel - 1) kinds args
    IrRecord _ fields => anyField (fuel - 1) kinds fields
    IrProj b _ _ => usesCps (fuel - 1) kinds b
    IrRecUpd b _ fields => if usesCps (fuel - 1) kinds b then True else anyField (fuel - 1) kinds fields
    IrCast inner => usesCps (fuel - 1) kinds inner
    IrLet _ rhs body => if usesCps (fuel - 1) kinds rhs then True else usesCps (fuel - 1) kinds body
    IrLam _ _ => False
    IrApp f a => if usesCps (fuel - 1) kinds f then True else usesCps (fuel - 1) kinds a
    IrIf c t el => if usesCps (fuel - 1) kinds c then True else if usesCps (fuel - 1) kinds t then True else usesCps (fuel - 1) kinds el
    IrCase s alts => if usesCps (fuel - 1) kinds s then True else anyAlt (fuel - 1) kinds alts
    IrNatCase s _ z su c =>
      if usesCps (fuel - 1) kinds s then True
      else if altM (fuel - 1) kinds z then True else if altM (fuel - 1) kinds su then True else altM (fuel - 1) kinds c
    IrConcatMany xs => anyIr (fuel - 1) kinds xs
    IrEffThunk _ _ _ _ _ => False
    IrEffBind _ _ _ => False

anyIr : Int -> HashMap String DefKind -> List Ir -> Bool
anyIr fuel kinds xs = if fuel <= 0 then True else case xs of
  [] => False
  x :: rest => if usesCps (fuel - 1) kinds x then True else anyIr (fuel - 1) kinds rest

anyField : Int -> HashMap String DefKind -> List (Pair String Ir) -> Bool
anyField fuel kinds xs = if fuel <= 0 then True
else case xs of
  [] => False
  p :: rest => if usesCps (fuel - 1) kinds (secondOf p) then True else anyField (fuel - 1) kinds rest

anyAlt : Int -> HashMap String DefKind -> List IrAlt -> Bool
anyAlt fuel kinds xs = if fuel <= 0 then True
else case xs of
  [] => False
  a :: rest => if usesCps (fuel - 1) kinds a.irAltBody then True else anyAlt (fuel - 1) kinds rest

altM : Int -> HashMap String DefKind -> Maybe IrAlt -> Bool
altM fuel kinds m = if fuel <= 0 then True
else case m of
  Nothing => False
  Just a => usesCps (fuel - 1) kinds a.irAltBody

kindOfBody : HashMap String DefKind -> IrDef -> DefKind
kindOfBody kinds d = case d of
  IrExternDef _ _ _ _ => DefValue
  IrDef _ _ _ body _ _ _ => case body of
    IrLam _ _ => DefCpsFun
    _ => if usesCps 100000 kinds body then DefCpsThunk else DefValue

stepKinds : Int -> HashMap String DefKind -> List IrDef -> HashMap String DefKind
stepKinds fuel kinds defs = if fuel <= 0 then kinds
else stepKinds (fuel - 1) (foldlKinds defs kinds) defs

foldlKinds : List IrDef -> HashMap String DefKind -> HashMap String DefKind
foldlKinds defs kinds = case defs of
  [] => kinds
  d :: rest => foldlKinds rest (Base.HashMap.insert (irDefName d) (kindOfBody kinds d) kinds)

prepareDef : HashMap String DefKind -> IrDef -> IrDef
prepareDef kinds d = case d of
  IrExternDef _ _ _ _ => d
  IrDef name arity deps body recOk initGuard span =>
    case Base.HashMap.lookup name kinds of
      Just DefCpsThunk => IrDef name arity deps (IrLam [] body) recOk initGuard span
      _ => d

prepareDefs : HashMap String DefKind -> List IrDef -> List IrDef
prepareDefs kinds defs = case defs of
  [] => []
  d :: rest => prepareDef kinds d :: prepareDefs kinds rest

arityOfPrepared : HashMap String DefKind -> IrDef -> Int
arityOfPrepared kinds d = case d of
  IrExternDef _ _ _ _ => 0
  IrDef name arity _ _ _ _ _ => case Base.HashMap.lookup name kinds of
    Just DefCpsThunk => -1
    _ => arity

arityMap : HashMap String DefKind -> List IrDef -> HashMap String Int
arityMap kinds defs = Base.HashMap.fromList (map (\d => Pair (irDefName d) (arityOfPrepared kinds d)) defs)

-- | 返回 (改写后的 defs, 调用 arity 表)。arity = -1 表示零参 CPS 计算。
export classifyAndPrepare : List IrDef -> Pair (List IrDef) (HashMap String Int)
classifyAndPrepare defs =
  let
    kinds = stepKinds 8 (Base.HashMap.fromList []) defs
    prepared = prepareDefs kinds defs
  in Pair prepared (arityMap kinds prepared)