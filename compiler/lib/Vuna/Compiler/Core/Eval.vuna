  ( applyCaseAlt
  , applyClosure
  , applyClosureBinder
  , applySpine
  , applyTermSpine
  , applyValue
  , argValsAt
  , asBool
  , asInt
  , asNat
  , asStr
  , boolPrim2
  , catchAllEnv
  , cmpInt
  , eval
  , evalAlt
  , evalAlts
  , evalArgTerms
  , evalCase
  , evalIf
  , force
  , freshVar
  , genericCmp
  , genericPrim2
  , intPrim1
  , intPrim2
  , intPrim2Div
  , lookupEnv
  , natValue
  , natValueToInt
  , normalize
  , normalizeCase
  , normalizeIf
  , normalizeNeutral
