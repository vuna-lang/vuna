  ( applyCaseAlt
  , applyClosure
  , applyClosureBinder
  , applySpine
  , applyTermSpine
  , applyValue
  , argValsAt
  , asBool
  , asInt
  , asStr
  , boolPrim2
  , catchAllEnv
  , cmpInt
  , eval
  , evalAlt
  , evalAlts
  , evalArgTerms
  , evalCase
  , evalIf
  , force
  , freshVar
  , genericCmp
  , genericEqPrim
  , genericPrim2
  , intPrim1
  , intPrim2
  , intPrim2Div
  , lookupEnv
  , normalize
  , normalizeCase
  , normalizeIf
  , normalizeNeutral
  , primConst
  , primReduce
  , quote
  , quoteArgValues
  , quoteCaseAlt
  , quoteNeutral
  , showValue
  , showValueAt
  , spineAppend
  , strEq
  , strPrim1
  , strPrim2
  , strPrim3
  , substSolvedAlt
  , substSolvedAltAt
  , substSolvedMetas
