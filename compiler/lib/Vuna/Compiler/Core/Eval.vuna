  ) where

-- Vuna.Compiler.Core.Eval：NbE 求值与 quote。
--
-- 包含：beta 求值（eval/apply*）、delta 展开（force）、prelude 原语归约
-- （primReduce）、深度正规化（normalize，interp 展示 main 用）、quote（值 → 项）
-- 以及「已解元变量代入项」（substSolvedMetas*）。
--
-- 定义性相等（beta + delta + eta）在 Vuna.Compiler.Core.Conv；本模块是它的下游依赖。
-- M24 后维护（源码重组）：从原 Core.vuna 拆出；依赖 Core.Term 的表示层与纯数据操作。
import Vuna.Compiler.Common
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Intrinsics

-- ---------------------------------------------------------------
-- 环境与求值（beta）
-- ---------------------------------------------------------------
lookupEnv : Int -> List Value -> Maybe Value
lookupEnv i [] = Nothing
lookupEnv i (v :: rest) = if i <= 0 then Just v else lookupEnv (i - 1) rest

eval : List Value -> Term -> Value
eval env t = evalFuel 128 env t

evalFuel : Int -> List Value -> Term -> Value
evalFuel fuel env t = if fuel <= 0 then VType levelZero
else case t of
  TVar name i => case lookupEnv i env of
    Just v => v
    Nothing => VNeutral (NVar name i [])
  TMeta m => VMeta m []
  TGlobal g => VNeutral (NGlobal g [])
  TType l => VType l
  TPi name implicit rig dom cod =>
    VPi name implicit rig (evalFuel (fuel - 1) env dom) (Clos env cod)
  TLam name rig body => VLam name rig (Clos env body)
  TApp f a rig => applyValueFuel (fuel - 1) (evalFuel (fuel - 1) env f) (evalFuel (fuel - 1) env a)
  TCon c args => VCon c (evalArgTermsFuel (fuel - 1) env args)
  TCase scrut alts => evalCaseFuel (fuel - 1) (evalFuel (fuel - 1) env scrut) (evalAlts env alts)
  TInt n => VInt n
  TStr s => VStr s
  TBool b => VBool b
  TIf c th el =>
    evalIf (evalFuel (fuel - 1) env c) (evalFuel (fuel - 1) env th) (evalFuel (fuel - 1) env el)

evalAlt : List Value -> CaseAlt -> VCaseAlt
evalAlt env (CaseAlt name binders body) = VCaseAlt name binders (Clos env body)

evalAlts : List Value -> List CaseAlt -> List VCaseAlt
evalAlts env [] = []
evalAlts env (alt :: rest) = evalAlt env alt :: evalAlts env rest

evalArgTerms : List Value -> List (Pair Term Rig) -> List Value
evalArgTerms env args = evalArgTermsFuel 128 env args

evalArgTermsFuel : Int -> List Value -> List (Pair Term Rig) -> List Value
evalArgTermsFuel fuel env args = if fuel <= 0 then []
else case args of
  [] => []
  (Pair a rig) :: rest => evalFuel (fuel - 1) env a :: evalArgTermsFuel (fuel - 1) env rest

-- case 求值：命中构造子则把该构造子的实参绑进分支闭包，否则卡住。
-- 构造子实参按「最近绑定在前」入环境（与 ctxBind 的 de Bruijn 约定一致）。
evalCase : Value -> List VCaseAlt -> Value
evalCase scrut alts = evalCaseFuel 128 scrut alts

evalCaseFuel : Int -> Value -> List VCaseAlt -> Value
evalCaseFuel fuel scrut alts = if fuel <= 0 then VType levelZero
else case scrut of
  VCon c args => applyCaseAltFuel (fuel - 1) c args alts
  _ => VCase scrut alts

applyCaseAlt : String -> List Value -> List VCaseAlt -> Value
applyCaseAlt c args alts = applyCaseAltFuel 128 c args alts

applyCaseAltFuel : Int -> String -> List Value -> List VCaseAlt -> Value
applyCaseAltFuel fuel c args alts = if fuel <= 0 then VType levelZero
else case alts of
  [] => VCase (VCon c args) []
  alt :: rest => if vCaseAltName alt == c then case vCaseAltClosure alt of
    Clos env body => evalFuel (fuel - 1) (append (reverse args) env) body
  else if vCaseAltName alt == "" then case vCaseAltClosure alt of
    -- 兜底分支（源码里写的是变量/通配，精化后名字为空串）。变量兜底带一个 binder，
    -- 要把 scrutinee 压进环境；通配兜底无 binder。
    Clos env body => evalFuel (fuel - 1) (catchAllEnv alt (VCon c args) env) body
  else applyCaseAltFuel (fuel - 1) c args rest

catchAllEnv : VCaseAlt -> Value -> List Value -> List Value
catchAllEnv alt scrut env = case vCaseAltBinders alt of
  [] => env
  _ => scrut :: env

evalIf : Value -> Value -> Value -> Value
evalIf c th el = case c of
  VBool b => if b then th else el
  _ => VIf c th el

spineAppend : Neutral -> Value -> Neutral
spineAppend n a = case n of
  NVar name level sp => NVar name level (append sp [a])
  NGlobal g sp => NGlobal g (append sp [a])

applyValue : Value -> Value -> Value
applyValue f a = applyValueFuel 128 f a

applyValueFuel : Int -> Value -> Value -> Value
applyValueFuel fuel f a = if fuel <= 0 then VType levelZero
else case f of
  VLam name rig (Clos env body) => evalFuel (fuel - 1) (a :: env) body
  VNeutral n => VNeutral (spineAppend n a)
  VMeta m sp => VMeta m (append sp [a])
  _ => VApp f a

applyClosure : Closure -> Value -> Value
applyClosure (Clos env body) v = eval (v :: env) body

applySpine : Value -> List Value -> Value
applySpine v [] = v
applySpine v (a :: rest) = applySpine (applyValue v a) rest

-- ---------------------------------------------------------------
-- delta 展开：已解元变量 + 有定义的全局（带步数上限，避免递归定义挂死）
-- ---------------------------------------------------------------
force : HashTbl Term -> Sols -> Int -> Value -> Value
force defs sols fuel v = if fuel <= 0 then v
else case v of
  VMeta m sp => case solsLookup m sols of
    Just t => force defs sols (fuel - 1) (applySpine t sp)
    Nothing => v
  VCase scrut alts =>
    let
      s2 = force defs sols (fuel - 1) scrut
    in case s2 of
      VCon c args => case alts of
        [] => VCase s2 []
        _ => force defs sols (fuel - 1) (applyCaseAlt c args alts)
      _ => VCase s2 alts
  VApp f a =>
    let
      f2 = force defs sols (fuel - 1) f
    in case f2 of
      VLam name rig clo => force defs sols (fuel - 1) (applyClosure clo a)
      VMeta m sp => force defs sols (fuel - 1) (VMeta m (append sp [a]))
      VNeutral n => force defs sols (fuel - 1) (VNeutral (spineAppend n a))
      _ => VApp f2 a
  VNeutral n => case n of
    NGlobal g sp => case defLookup g defs of
      Just body => force defs sols (fuel - 1) (applySpine (eval [] body) sp)
      Nothing => case primReduce defs sols (fuel - 1) g sp of
        Just v2 => force defs sols (fuel - 1) v2
        Nothing => v
    _ => v
  _ => v

-- ---------------------------------------------------------------
asInt : Value -> Maybe Int
asInt v = case v of
  VInt n => Just n
  _ => Nothing

asStr : Value -> Maybe String
asStr v = case v of
  VStr s => Just s
  _ => Nothing

asBool : Value -> Maybe Bool
asBool v = case v of
  VBool b => Just b
  _ => Nothing

intPrim2 : List Value -> (Int -> Int -> Value) -> Maybe Value
intPrim2 ([a, b]) f = case asInt a of
  Just x => case asInt b of
    Just y => Just (f x y)
    Nothing => Nothing
  Nothing => Nothing
intPrim2 sp f = Nothing

-- M23：除法在除数为 0 时**不归约**。核心求值器表达不了运行时异常（编译产物由 OCaml
-- 抛 `Division_by_zero`），静默返回 0 会与产物/三路对照不一致；不归约让 `main` 报
-- "does not reduce to a value"，把差异限制在「核心求值器不能表达异常」这条已知边界里。
intPrim2Div : List Value -> Maybe Value
intPrim2Div ([a, b]) = case asInt a of
  Just x => case asInt b of
    Just y => if y == 0 then Nothing else Just (VInt (x / y))
    Nothing => Nothing
  Nothing => Nothing
intPrim2Div sp = Nothing

boolPrim2 : List Value -> (Bool -> Bool -> Value) -> Maybe Value
boolPrim2 ([a, b]) f = case asBool a of
  Just x => case asBool b of
    Just y => Just (f x y)
    Nothing => Nothing
  Nothing => Nothing
boolPrim2 sp f = Nothing

-- 零参 prelude 常量：True/False 在 globals 里是 TGlobal，需要在求值时归约成 VBool。
primConst : List Value -> Value -> Maybe Value
primConst [] v = Just v
primConst sp v = Nothing

strPrim2 : List Value -> (String -> String -> Value) -> Maybe Value
strPrim2 ([a, b]) f = case asStr a of
  Just x => case asStr b of
    Just y => Just (f x y)
    Nothing => Nothing
  Nothing => Nothing
strPrim2 sp f = Nothing

intPrim1 : List Value -> (Int -> Value) -> Maybe Value
intPrim1 ([a]) f = case asInt a of
  Just x => Just (f x)
  Nothing => Nothing
intPrim1 sp f = Nothing

strPrim1 : List Value -> (String -> Value) -> Maybe Value
strPrim1 ([a]) f = case asStr a of
  Just x => Just (f x)
  Nothing => Nothing
strPrim1 sp f = Nothing

-- 字符串相等（`==` 的跨类型特化用）。
strEq : String -> String -> Bool
strEq a b = a == b

genericCmp : Value -> Value -> Maybe Int
genericCmp a b = case a of
  VInt x => case b of
    VInt y => Just (cmpInt x y)
    _ => Nothing
  VStr x => case b of
    VStr y => Just (if x == y then 0 else if x < y then 0 - 1 else 1)
    _ => Nothing
  VBool x => case b of
    VBool y => Just (if x == y then 0 else if x then 1 else 0 - 1)
    _ => Nothing
  _ => Nothing

cmpInt : Int -> Int -> Int
cmpInt a b = if a == b then 0 else if a < b then 0 - 1 else 1

genericPrim2 : List Value -> (Int -> Bool) -> Maybe Value
genericPrim2 ([a, b]) pred = case genericCmp a b of
  Just o => Just (VBool (pred o))
  Nothing => Nothing
genericPrim2 sp pred = Nothing

strPrim3 : List Value -> (String -> String -> String -> Value) -> Maybe Value
strPrim3 ([a, b, c]) f = case asStr a of
  Just x => case asStr b of
    Just y => case asStr c of
      Just z => Just (f x y z)
      Nothing => Nothing
    Nothing => Nothing
  Nothing => Nothing
strPrim3 sp f = Nothing

-- 内建归约：唯一真源是 `Vuna.Compiler.Intrinsics` 的名字表 + 归约标签（M27）。
-- 表查找是 O(1) 哈希（不再需要首字符预筛）。
primReduce : HashTbl Term -> Sols -> Int -> String -> List Value -> Maybe Value
primReduce defs sols fuel g sp = if fuel <= 0 then Nothing
else case findIntrinsic g of
  Just i => case intrinsicOp i of
    OpAdd => intPrim2 sp (\a, b => VInt (a + b))
    OpSub => intPrim2 sp (\a, b => VInt (a - b))
    OpMul => intPrim2 sp (\a, b => VInt (a * b))
    OpDiv => intPrim2Div sp
    OpEqInt => intPrim2 sp (\a, b => VBool (a == b))
    OpNeqInt => intPrim2 sp (\a, b => VBool (notBool (a == b)))
    OpLtInt => intPrim2 sp (\a, b => VBool (a < b))
    OpLeInt => intPrim2 sp (\a, b => VBool (a <= b))
    OpGtInt => intPrim2 sp (\a, b => VBool (a > b))
    OpGeInt => intPrim2 sp (\a, b => VBool (a >= b))
    OpEqStr => strPrim2 sp (\a, b => VBool (strEq a b))
    OpNeqStr => strPrim2 sp (\a, b => VBool (notBool (strEq a b)))
    OpLtGeneric => genericPrim2 sp (\o => o < 0)
    OpLeGeneric => genericPrim2 sp (\o => o <= 0)
    OpGtGeneric => genericPrim2 sp (\o => o > 0)
    OpGeGeneric => genericPrim2 sp (\o => o >= 0)
    OpEqGeneric => genericEqPrim defs sols (fuel - 1) sp False
    OpNeqGeneric => genericEqPrim defs sols (fuel - 1) sp True
    OpConcat => strPrim2 sp (\a, b => VStr (a ++ b))
    OpAnd => boolPrim2 sp (\a, b => VBool (a && b))
    OpOr => boolPrim2 sp (\a, b => VBool (a || b))
    OpStrFromInt => intPrim1 sp (\n => VStr (strFromInt n))
    OpStrLength => strPrim1 sp (\s => VInt (strLength s))
    OpStrHash => strPrim1 sp (\s => VInt (strHashOf s))
    OpStrAt => atPrim sp
    OpStrShow => strPrim1 sp (\s => VStr (showCoreString s))
    -- interp 边界（显式分类，见 docs/reference/primitives.md）：List 桥接依赖 base 的
    -- `Base.List.List` 构造子表示，核心求值器无法安全构造；除零/运行期失败同理。
    OpStrUnpack => Nothing
    OpStrPack => Nothing
    OpStrConcatMany => Nothing
    OpStrSubstTemplate => Nothing
    OpNone => Nothing
  Nothing => Nothing

-- `strHash`：固定 1024 桶（与 runtime `dtp_strHash` 同一公式）。
strHashOf : String -> Int
strHashOf s = strHashChars (strUnpack s) 0

strHashChars : List Int -> Int -> Int
strHashChars [] h = h
strHashChars (c :: rest) h = strHashChars rest (h * 33 + c - (h * 33 + c) / 1024 * 1024)

-- `strAt`：按字节取；越界返回 -1（与 runtime `dtp_strAt` 一致）。
atPrim : List Value -> Maybe Value
atPrim sp = case sp of
  [a, b] => case asStr a of
    Just s => case asInt b of
      Just i => Just (VInt (strAtBytes s i))
      Nothing => Nothing
    Nothing => Nothing
  _ => Nothing

strAtBytes : String -> Int -> Int
strAtBytes s i = if i < 0 || i >= strLength s then 0 - 1 else nthByte (strUnpack s) i

nthByte : List Int -> Int -> Int
nthByte [] i = 0 - 1
nthByte (c :: rest) i = if i <= 0 then c else nthByte rest (i - 1)

genericEqPrim : HashTbl Term -> Sols -> Int -> List Value -> Bool -> Maybe Value
genericEqPrim defs sols fuel sp neg = if fuel <= 0 then Nothing
else case sp of
  [ty, a, b] =>
    Just
      (VBool (if neg then notBool (valueEqDeep defs sols (fuel - 1) a b) else valueEqDeep defs sols (fuel - 1) a b))
  _ => Nothing

valueEqDeep : HashTbl Term -> Sols -> Int -> Value -> Value -> Bool
valueEqDeep defs sols fuel a b = if fuel <= 0 then False
else case force defs sols fuel a of
  VInt x => case force defs sols fuel b of
    VInt y => x == y
    _ => False
  VStr x => case force defs sols fuel b of
    VStr y => strEq x y
    _ => False
  VBool x => case force defs sols fuel b of
    VBool y => if x then y else notBool y
    _ => False
  VType x => case force defs sols fuel b of
    VType y => levelToInt x == levelToInt y
    _ => False
  VCon c args => case force defs sols fuel b of
    VCon c2 args2 => if c == c2 then valueListEqDeep defs sols (fuel - 1) args args2 else False
    _ => False
  VApp f a => case force defs sols fuel b of
    VApp f2 a2 => valueEqDeep defs sols (fuel - 1) f f2 && valueEqDeep defs sols (fuel - 1) a a2
    _ => False
  -- 构造子实参表包含**擦除**的类型/索引实参（VCon 不带 rig，比较时无法区分）。它们对
  -- 运行时结构相等没有意义，却常是未解/已解的元变量或类型中立值：按「同一个元变量」
  -- 或「同一个中立值的显示形态」判等即可（`Just2 1 == Just2 1` 的首个实参就是 `?m`）。
  VMeta m sp => case force defs sols fuel b of
    VMeta m2 sp2 => m == m2
    _ => False
  VNeutral n => case force defs sols fuel b of
    VNeutral n2 => showValue (VNeutral n) == showValue (VNeutral n2)
    _ => False
  _ => False

valueListEqDeep : HashTbl Term -> Sols -> Int -> List Value -> List Value -> Bool
valueListEqDeep defs sols fuel xs ys = if fuel <= 0 then False
else case xs of
  [] => case ys of
    [] => True
    _ => False
  a :: rest => case ys of
    [] => False
    b :: rest2 =>
      if valueEqDeep defs sols fuel a b then valueListEqDeep defs sols fuel rest rest2 else False

-- ---------------------------------------------------------------
-- 深度正规化（interp --dt 展示 main 用）：先 force，再递归 spine / if 分支。
-- 与 force 不同，它会继续深入中立项的实参，因此 `inc (dbl 20)` 能算成 41。
-- ---------------------------------------------------------------
normalizeFuel : Int -> HashTbl Term -> Sols -> Int -> Value -> Value
normalizeFuel fuel defs sols fuel v = if fuel <= 0 then v
else if fuel <= 0 then v
else case force defs sols fuel v of
  VNeutral n => normalizeNeutralFuel (fuel - 1) defs sols fuel n
  VIf c th el => normalizeIfFuel (fuel - 1) defs sols fuel c th el
  VCase scrut alts => normalizeCaseFuel (fuel - 1) defs sols fuel scrut alts
  other => other

-- case 正规化：scrutinee 归约到构造子就走该分支并继续正规化（分支体里可能还有
-- case——嵌套模式展开出来的内层匹配就是这种形态）；否则只正规化 scrutinee、保持卡住。
normalizeCaseFuel : Int -> HashTbl Term -> Sols -> Int -> Value -> List VCaseAlt -> Value
normalizeCaseFuel fuel defs sols fuel scrut alts = if fuel <= 0 then VCase scrut alts
else if fuel <= 0 then VCase scrut alts
else case normalizeFuel (fuel - 1) defs sols (fuel - 1) scrut of
  VCon c args => normalizeFuel (fuel - 1) defs sols (fuel - 1) (applyCaseAlt c args alts)
  s2 => VCase s2 alts

normalizeNeutralFuel : Int -> HashTbl Term -> Sols -> Int -> Neutral -> Value
normalizeNeutralFuel fuel defs sols fuel n = if fuel <= 0 then VNeutral n
else if fuel <= 0 then VNeutral n
else case n of
  NVar name level sp =>
    VNeutral (NVar name level (map (normalizeFuel (fuel - 1) defs sols fuel) sp))
  NGlobal g sp =>
    let
      sp2 = map (normalizeFuel (fuel - 1) defs sols fuel) sp
    in case defLookup g defs of
      Just body => normalizeFuel (fuel - 1) defs sols (fuel - 1) (applySpine (eval [] body) sp2)
      Nothing => case primReduce defs sols (fuel - 1) g sp2 of
        Just v2 => normalizeFuel (fuel - 1) defs sols (fuel - 1) v2
        Nothing => VNeutral (NGlobal g sp2)

normalizeIfFuel : Int -> HashTbl Term -> Sols -> Int -> Value -> Value -> Value -> Value
normalizeIfFuel fuel defs sols fuel c th el = if fuel <= 0 then VIf c th el
else if fuel <= 0 then VIf c th el
else case normalizeFuel (fuel - 1) defs sols (fuel - 1) c of
  VBool b => normalizeFuel (fuel - 1) defs sols (fuel - 1) (if b then th else el)
  VNeutral n =>
    VIf (VNeutral n) (normalizeFuel (fuel - 1) defs sols (fuel - 1) th)
      (normalizeFuel (fuel - 1) defs sols (fuel - 1) el)
  other =>
    VIf other (normalizeFuel (fuel - 1) defs sols (fuel - 1) th)
      (normalizeFuel (fuel - 1) defs sols (fuel - 1) el)

-- ---------------------------------------------------------------
-- quote：值 → 项（level 转 de Bruijn index）
-- ---------------------------------------------------------------
quote : Int -> Value -> Term
quote depth v = quoteFuel 64 depth v

quoteFuel : Int -> Int -> Value -> Term
quoteFuel fuel depth v = if fuel <= 0 then TType levelZero
else case v of
  VType l => TType l
  VPi name implicit rig dom cod =>
    TPi name implicit rig (quoteFuel (fuel - 1) depth dom)
      (quoteFuel (fuel - 1) (depth + 1) (applyClosure cod (freshVar name depth)))
  VLam name rig clo =>
    TLam name rig (quoteFuel (fuel - 1) (depth + 1) (applyClosure clo (freshVar name depth)))
  VNeutral n => quoteNeutralFuel (fuel - 1) depth n
  VMeta m sp => applyTermSpine (TMeta m) (map (\a => quoteFuel (fuel - 1) depth a) sp)
  VCon c args => TCon c (quoteArgValuesFuel (fuel - 1) depth args)
  VApp f a => TApp (quoteFuel (fuel - 1) depth f) (quoteFuel (fuel - 1) depth a) Rig1
  VCase scrut alts =>
    TCase (quoteFuel (fuel - 1) depth scrut)
      (map (\alt => quoteCaseAltFuel (fuel - 1) depth alt) alts)
  VInt n => TInt n
  VStr s => TStr s
  VBool b => TBool b
  VIf c th el =>
    TIf (quoteFuel (fuel - 1) depth c) (quoteFuel (fuel - 1) depth th)
      (quoteFuel (fuel - 1) depth el)

-- 分支绑定子的 level 约定：第一个实参 level 最低（quote 后 index 最大）。
quoteCaseAlt : Int -> VCaseAlt -> CaseAlt
quoteCaseAlt depth alt = quoteCaseAltFuel 64 depth alt

quoteCaseAltFuel : Int -> Int -> VCaseAlt -> CaseAlt
quoteCaseAltFuel fuel depth alt0 = if fuel <= 0 then CaseAlt "" [] (TType levelZero)
else case alt0 of
  VCaseAlt name binders clo =>
    let
      n = length binders
      argVals = argValsAt binders depth 0
      body = quoteFuel (fuel - 1) (depth + n) (applyClosureBinder clo argVals)
    in CaseAlt name binders body

quoteArgValues : Int -> List Value -> List (Pair Term Rig)
quoteArgValues depth vs = quoteArgValuesFuel 64 depth vs

quoteArgValuesFuel : Int -> Int -> List Value -> List (Pair Term Rig)
quoteArgValuesFuel fuel depth vs = if fuel <= 0 then []
else case vs of
  [] => []
  a :: rest => Pair (quoteFuel (fuel - 1) depth a) Rig1 :: quoteArgValuesFuel (fuel - 1) depth rest

argValsAt : List (Pair String Rig) -> Int -> Int -> List Value
argValsAt [] depth i = []
argValsAt ((Pair name rig) :: rest) depth i =
  freshVar name (depth + i) :: argValsAt rest depth (i + 1)

-- 逐个把实参喂给闭包：闭包 env 是分支外环境，实参按 arg0 先喂的顺序。
applyClosureBinder : Closure -> List Value -> Value
applyClosureBinder clo [] = VCon "_alt" []
applyClosureBinder clo (a :: rest) = case clo of
  Clos env body => applyClosureBinder (Clos (a :: env) body) rest

freshVar : String -> Int -> Value
freshVar name level = VNeutral (NVar name level [])

quoteNeutral : Int -> Neutral -> Term
quoteNeutral depth n = quoteNeutralFuel 64 depth n

quoteNeutralFuel : Int -> Int -> Neutral -> Term
quoteNeutralFuel fuel depth n = if fuel <= 0 then TType levelZero
else case n of
  NVar name level sp =>
    applyTermSpine (TVar name (varIndex depth level)) (map (\a => quoteFuel (fuel - 1) depth a) sp)
  NGlobal g sp => applyTermSpine (TGlobal g) (map (\a => quoteFuel (fuel - 1) depth a) sp)

-- M24.6 第一级：越界的 level 以前被静默当成最外层变量（index 0），错得无声。
-- quote 是纯函数、不返回 Result；这里对越界返回负 index（-1），后续
-- `binderAt` / 擦除检查会把它报成 "unbound runtime variable" 而不是悄悄指向 0。
-- 正常路径（level < depth）不变。
varIndex : Int -> Int -> Int
varIndex depth level = if level < depth then depth - level - 1 else 0 - 1

applyTermSpine : Term -> List Term -> Term
applyTermSpine head [] = head
applyTermSpine head (a :: rest) = applyTermSpine (TApp head a Rig1) rest

-- M22：把「已解且闭」的元变量在项里替换成其实例项（`TMeta m` → `quote 0` 的解）。
-- 字典元变量是运行时实参（Rig1），codegen 会对残留的 `TMeta` 报错；只有擦除的
-- 类型/索引元变量（Rig0）可留在项里。字典解（实例构造子）是闭的，`quote 0` 安全；
-- 带自由变量（非闭）的解跳过——它们只可能是擦除元变量，codegen 跳过。
substSolvedMetas : List (Pair Int Value) -> Term -> Term
substSolvedMetas sols t = case t of
  TMeta m => case metaLookup m sols of
    Just v =>
      let
        soln = quote 0 v
      in if hasFreeTermVar 0 soln then t else soln
    Nothing => t
  TPi n i r d c => TPi n i r (substSolvedMetas sols d) (substSolvedMetas sols c)
  TLam n r b => TLam n r (substSolvedMetas sols b)
  TApp f a r => TApp (substSolvedMetas sols f) (substSolvedMetas sols a) r
  TCon c args => TCon c (map (\p => Pair (substSolvedMetas sols (firstOf p)) (secondOf p)) args)
  TCase s alts => TCase (substSolvedMetas sols s) (map (substSolvedAlt sols) alts)
  TIf c th el => TIf (substSolvedMetas sols c) (substSolvedMetas sols th) (substSolvedMetas sols el)
  _ => t

substSolvedAlt : List (Pair Int Value) -> CaseAlt -> CaseAlt
substSolvedAlt sols (CaseAlt n bs b) = CaseAlt n bs (substSolvedMetas sols b)

-- M20 字典提升：替换 `?m` 为 `TVar d (depth - q)`（`q` = 插入点外侧绑定子数，含类参数绑定子）。
-- `depth` 是 `?m` 出现处深度（de Bruijn）；用于把延迟的字典元变量变成提升后的字典绑定子变量。
-- M22.2：和 `substSolvedMetas` 相同，但解按**给定深度** quote。字典提升要在定义体的
-- binder 上下文里重写目标类型（`?a` 已解成定义自己的刚性变量），必须按那个深度取
-- de Bruijn index；深度 0 的版本会把解里的 `NVar` 拍成越界变量（`mergeSort` 的
-- 字典签名曾变成 `{d : Dict_Ord ?67}`）。
substSolvedMetasAt : Int -> List (Pair Int Value) -> Term -> Term
substSolvedMetasAt d sols t = case sols of
  [] => t
  _ => substSolvedMetasAtGo d sols t

substSolvedMetasAtGo : Int -> List (Pair Int Value) -> Term -> Term
substSolvedMetasAtGo depth sols t = case t of
  TMeta m => case metaLookup m sols of
    Just v => quote depth v
    Nothing => t
  TPi n i r d c => TPi n i r (substSolvedMetasAtGo depth sols d) (substSolvedMetasAtGo depth sols c)
  TLam n r b => TLam n r (substSolvedMetasAtGo depth sols b)
  TApp f a r => TApp (substSolvedMetasAtGo depth sols f) (substSolvedMetasAtGo depth sols a) r
  TCon c args =>
    TCon c (map (\p => Pair (substSolvedMetasAtGo depth sols (firstOf p)) (secondOf p)) args)
  TCase s alts => TCase (substSolvedMetasAtGo depth sols s) (map (substSolvedAltAt depth sols) alts)
  TIf c th el =>
    TIf (substSolvedMetasAtGo depth sols c) (substSolvedMetasAtGo depth sols th)
      (substSolvedMetasAtGo depth sols el)
  _ => t

substSolvedAltAt : Int -> List (Pair Int Value) -> CaseAlt -> CaseAlt
substSolvedAltAt depth sols (CaseAlt n bs b) = CaseAlt n bs (substSolvedMetasAtGo depth sols b)

isNilList : List a -> Bool
isNilList [] = True
isNilList _ = False

showValueAt : Int -> Value -> String
-- 快速路径：原子值直接给名字，免掉 quote+showTerm 的递归（mismatchAt 在试探路径上
-- 每次 check 会构造 ~600 万条被丢弃的诊断消息，格式化是主要成本之一）。
showValueAt depth v = case v of
  -- M28：宇宙层级参与诊断（严格分层下 `Type 0` 与 `Type 1` 不相等，只说 "Type"
  -- 会让反例无法定位）；0 层仍显示 "Type" 以保持既有文案稳定。
  VType l => if levelToInt l == 0 then "Type" else "Type " ++ strFromInt (levelToInt l)
  VNeutral n1 => case n1 of
    NGlobal g sp => if isNilList sp then g else showTerm (quote depth v)
    NVar name lvl sp => if isNilList sp then name else showTerm (quote depth v)
  VMeta m sp => if isNilList sp then "?" ++ strFromInt m else showTerm (quote depth v)
  _ => showTerm (quote depth v)

showValue : Value -> String
showValue v = showValueAt 0 v

normalize : HashTbl Term -> Sols -> Int -> Value -> Value
normalize a1 a2 a3 a4 = normalizeFuel 1024 a1 a2 a3 a4

normalizeCase : HashTbl Term -> Sols -> Int -> Value -> List VCaseAlt -> Value
normalizeCase a1 a2 a3 a4 a5 = normalizeCaseFuel 1024 a1 a2 a3 a4 a5

normalizeNeutral : HashTbl Term -> Sols -> Int -> Neutral -> Value
normalizeNeutral a1 a2 a3 a4 = normalizeNeutralFuel 1024 a1 a2 a3 a4

normalizeIf : HashTbl Term -> Sols -> Int -> Value -> Value -> Value -> Value
normalizeIf a1 a2 a3 a4 a5 a6 = normalizeIfFuel 1024 a1 a2 a3 a4 a5 a6

-- 与 `substSolvedMetas` 相同，但解表用哈希索引：定义体的 zonk 会逐元变量查解，
-- 关联表在千级解表上是 O(#解) 每次；索引把整次替换降成 O(#元变量)。
-- 同 `substSolvedMetasTbl`，但按给定深度 quote（字典提升路径用；O(1) 查解）。
substSolvedMetasAtTbl : HashTbl Value -> Int -> Term -> Term
substSolvedMetasAtTbl sols depth t = case t of
  TMeta m => case tblLookup (strFromInt m) sols of
    Just v => quote depth v
    Nothing => t
  TPi n i r d c =>
    TPi n i r (substSolvedMetasAtTbl sols depth d) (substSolvedMetasAtTbl sols (depth + 1) c)
  TLam n r b => TLam n r (substSolvedMetasAtTbl sols (depth + 1) b)
  TApp f a r => TApp (substSolvedMetasAtTbl sols depth f) (substSolvedMetasAtTbl sols depth a) r
  TCon c args =>
    TCon c (map (\p => Pair (substSolvedMetasAtTbl sols depth (firstOf p)) (secondOf p)) args)
  TCase sc alts => TCase (substSolvedMetasAtTbl sols depth sc) alts
  TIf c th el =>
    TIf (substSolvedMetasAtTbl sols depth c) (substSolvedMetasAtTbl sols depth th)
      (substSolvedMetasAtTbl sols depth el)
  _ => t

substSolvedMetasTbl : HashTbl Value -> Term -> Term
substSolvedMetasTbl sols t = case t of
  TMeta m => case tblLookup (strFromInt m) sols of
    Just v =>
      let
        soln = quote 0 v
      in if hasFreeTermVar 0 soln then t else soln
    Nothing => t
  TPi n i r d c => TPi n i r (substSolvedMetasTbl sols d) (substSolvedMetasTbl sols c)
  TLam n r b => TLam n r (substSolvedMetasTbl sols b)
  TApp f a r => TApp (substSolvedMetasTbl sols f) (substSolvedMetasTbl sols a) r
  TCon c args => TCon c (map (\p => Pair (substSolvedMetasTbl sols (firstOf p)) (secondOf p)) args)
  TCase s alts => TCase (substSolvedMetasTbl sols s) (map (substSolvedAltTbl sols) alts)
  TIf c th el =>
    TIf (substSolvedMetasTbl sols c) (substSolvedMetasTbl sols th) (substSolvedMetasTbl sols el)
  _ => t

substSolvedAltTbl : HashTbl Value -> CaseAlt -> CaseAlt
substSolvedAltTbl sols (CaseAlt n bs b) = CaseAlt n bs (substSolvedMetasTbl sols b)
