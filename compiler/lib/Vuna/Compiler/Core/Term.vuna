-- Vuna.Compiler.Core.Term：core 类型论的表示层与纯数据操作。
--
-- 这里定义 Term/Value/Neutral/Closure/CaseAlt/VCaseAlt/Rig/Level 等数据（唯一
-- 真源），以及不涉及求值/quote/conv 的项变换（shift/subst/显示/自由变量检查）。
--
-- **表示层定型（M18.6）**：擦除标志用三值 `Rig`（QTT 预留），宇宙层级用不透明
-- `Level`。`Vuna.Compiler.Core` 之外**禁止**解构 `Rig` / `Level`，只能走字段/访问器；
-- 详见 docs/reference/core.md 的映射表与不变量。
--
-- M24 后维护（源码重组）：从原 1227 行 Core.vuna 拆出；本模块是 Core 的叶子，只依赖 Common。
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Intrinsics

-- ---------------------------------------------------------------
-- M18.6：表示层定型（QTT 预留）
-- ---------------------------------------------------------------
--
-- Rig 是「这个 binder 在运行时用几次」的三值格子。M38 起精化器三值都产生（Rig0 / Rig1 / RigOmega）；
-- 擦除与用量判据只读 Rig（`rigIsErased`），codegen 的下游
-- 逻辑（判「是否擦除」）不变。
data Rig : Type where
  -- 运行时零次：类型级 binder、隐式实参。擦除 = 不进运行时表示。
  Rig0 : Rig
  -- 运行时恰好一次：普通值 binder。
  Rig1 : Rig
  -- QTT 预留：不受限使用。当前不产生。
  RigOmega : Rig

-- 「是否擦除」唯一判据：Elab 与 Codegen 都走这里，不直接模式匹配 Rig。
rigIsErased : Rig -> Bool
rigIsErased Rig0 = True
rigIsErased Rig1 = False
rigIsErased RigOmega = False

rigIsLinear : Rig -> Bool
rigIsLinear Rig1 = True
rigIsLinear _ = False

rigIsOmega : Rig -> Bool
rigIsOmega RigOmega = True
rigIsOmega _ = False

-- 精化器的判据：隐式 binder 恒 Rig0；显式 binder 只有域是宇宙才 Rig0；
-- 其余显式值 binder 默认 ω（M38：不再默认 Rig1；1 是显式线性标注）。
-- 注意这是**默认构造**入口；带源码 quantity 的路径走 Elab 的 `rigForPi`。
rigOfBinder : Bool -> Bool -> Rig
rigOfBinder True isTypeDom = Rig0
rigOfBinder False True = Rig0
rigOfBinder False False = RigOmega

defaultExplicitRig : Rig
defaultExplicitRig = RigOmega

-- M38：Rig 三值半环。唯一实现；Elab/Usage 不自己写三值分支。
--   add   ：同一变量多次出现 / 顺序组合
--   scale ：把一段 usage 按 binder quantity 放大
--   join  ：分支合并（0∨1 = ω：线性值必须在每条路径上都被消费）
rigAdd : Rig -> Rig -> Rig
rigAdd Rig0 b = b
rigAdd a Rig0 = a
rigAdd Rig1 Rig1 = RigOmega
rigAdd _ _ = RigOmega

rigScale : Rig -> Rig -> Rig
rigScale Rig0 _ = Rig0
rigScale _ Rig0 = Rig0
rigScale Rig1 u = u
rigScale RigOmega u = RigOmega

rigJoin : Rig -> Rig -> Rig
rigJoin Rig0 Rig0 = Rig0
rigJoin Rig1 Rig1 = Rig1
rigJoin RigOmega _ = RigOmega
rigJoin _ RigOmega = RigOmega
rigJoin _ _ = RigOmega

-- 声明的 quantity 与实测 usage 是否兼容（0/1 精确；ω 任意）。
rigExact : Rig -> Rig -> Bool
rigExact Rig0 Rig0 = True
rigExact Rig0 _ = False
rigExact Rig1 Rig1 = True
rigExact Rig1 _ = False
rigExact RigOmega _ = True

showRig : Rig -> String
showRig Rig0 = "0"
showRig Rig1 = "1"
showRig RigOmega = "ω"

-- 宇宙层级：不透明。`Level` 的表示（现在就是一个非负 Int）只有本模块可见；
-- 其它模块只能经 levelZero / levelSucc / levelMax / levelToInt / levelEq / levelLt
-- 与 `TType` / `VType` 触碰层级，**禁止**自己做 `Int` 算术或模式匹配。
record Level where
  levelToInt : Int

levelZero : Level
levelZero = Level 0

levelSucc : Level -> Level
levelSucc (Level n) = Level (n + 1)

levelMax : Level -> Level -> Level
levelMax (Level a) (Level b) = Level (if a >= b then a else b)

levelToInt : Level -> Int
levelToInt (Level n) = n

-- 只给输入语法 `Type n` 与解析器/测试用；生产路径一律经 levelSucc / levelMax。
levelOfInt : Int -> Level
levelOfInt n = Level n

levelEq : Level -> Level -> Bool
levelEq (Level a) (Level b) = a == b

levelLt : Level -> Level -> Bool
levelLt (Level a) (Level b) = a < b

data Term : Type where
  TVar : String -> Int -> Span -> Term
  TMeta : Int -> Term
  TGlobal : String -> Term
  TType : Level -> Term
  -- Pi：名字、是否隐式、binder 的 multiplicity、域、codomain。
  TPi : String -> Bool -> Rig -> Term -> Term -> Term
  TLam : String -> Rig -> Term -> Term
  TApp : Term -> Term -> Rig -> Term
  -- M14：构造子应用（自携每个实参的 multiplicity，与 TApp 一致）。
  TCon : String -> List (Pair Term Rig) -> Term
  -- R3：record 构造原语（记录构造子名 + 实参）：语义与 TCon 相同，codegen 扩展回 TCon。
  TMk : String -> List (Pair Term Rig) -> Term
  -- M14：依赖模式匹配。CaseAlt 的名字是构造子名（case 已按分支顺序排列）。
  TCase : Term -> List CaseAlt -> Term
  -- R3（records-v2）：记录字段投影原语（base、构造子/记录名、字段序号、字段数）。
  -- 精化期把 `p.x` 从生成的 `case` 改为这个原语；codegen 再按同一形状展开成
  -- 原有 `TCase`（产物逐字节一致），eval/quote/conv 直接消费它（iota + stuck）。
  TProj : Term -> String -> List (Pair String Rig) -> Int -> Int -> Term
  -- R3：记录更新原语（base、构造子名、字段 telescope、被改字段序号、重建体）。
  -- 语义与「单分支 TCase」完全相同（eval 直接按 case 展开），原语只多带记录身份标注。
  TRecUpd : Term -> String -> List (Pair String Rig) -> List Int -> Term -> Term
  TInt : Int -> Term
  TStr : String -> Term
  TBool : Bool -> Term
  TIf : Term -> Term -> Term -> Term
  -- `Float` 字面量（放末尾保持既有 tag 顺序）。
  TFloat : String -> Term
  -- R4（records-v2）：record 族的类型应用前导（记录名 + 实参）。语义 = `TGlobal name`
  -- 的应用脊；只在精化期存在，codegen 展开回 `TApp` 链（产物逐字节一致）。
  TRecord : String -> List (Pair Term Rig) -> Term

-- case 分支：构造子名 + 绑定子（名字 / multiplicity）+ 体。
record CaseAlt where
  caseAltName : String
  caseAltBinders : List (Pair String Rig)
  caseAltBody : Term

caseAltName : CaseAlt -> String
caseAltName (CaseAlt name binders body) = name

caseAltBinders : CaseAlt -> List (Pair String Rig)
caseAltBinders (CaseAlt name binders body) = binders

caseAltBody : CaseAlt -> Term
caseAltBody (CaseAlt name binders body) = body

record Closure where
  closureEnv : List Value
  closureBody : Term

data Neutral : Type where
  NVar : String -> Int -> List Value -> Neutral
  NGlobal : String -> List Value -> Neutral

data Value : Type where
  VType : Level -> Value
  VPi : String -> Bool -> Rig -> Value -> Closure -> Value
  VLam : String -> Rig -> Closure -> Value
  VNeutral : Neutral -> Value
  VMeta : Int -> List Value -> Value
  -- 卡住的应用（头部既不是 lambda 也不是中性 spines 时保留实参，禁止静默丢弃）。
  VApp : Value -> Value -> Value
  -- M14：构造子值（已应用全部参数）。
  VCon : String -> List Value -> Value
  -- M14：卡住的 case（scrutinee 是中性值）。
  VCase : Value -> List VCaseAlt -> Value
  -- R3：卡住的记录投影（base 是中性值）；base 为 VCon 时 eval 直接取字段（iota）。
  VProj : Value -> String -> List (Pair String Rig) -> Int -> Int -> Value
  VInt : Int -> Value
  VStr : String -> Value
  VBool : Bool -> Value
  VIf : Value -> Value -> Value -> Value
  -- `Float` 字面量的值形态（放末尾保持既有 tag 顺序）。
  VFloat : String -> Value

-- case 分支的值形态：绑定子 + 悬挂在「绑定子入环境后」的闭包。
record VCaseAlt where
  vCaseAltName : String
  vCaseAltBinders : List (Pair String Rig)
  vCaseAltClosure : Closure

defaultFuel : Int
defaultFuel = 512

-- ---------------------------------------------------------------
-- D24：Nat 字面量链的表示与项规模
-- ---------------------------------------------------------------
--
-- 字面量在精化期展开成 `Zero` / `Succ` 链（`Elab/Term/Impl.natLitTerm`），Core 里没有
-- 惰性 `TNat`。链是普通构造子应用，任何**逐节点**的遍历（擦除检查 / conv / capture
-- check）成本都随字面量大小线性增长，固定 fuel 因此会在「值 ≥256 / 索引 ≥20」时假报
-- `DT: internal: ... fuel exhausted`（D24）。这里提供两个纯数据 helper：
--   * `natChainValue`：把链 O(1) 折回整数（等价判定与燃料派生用）；
--   * `termSize`：项节点数（把固定 fuel 改成按项规模派生时用）。
-- 链折回的整数上限与运行时 Nat 饱和上限一致（OCaml 63 位 int 的 max_int）。
natChainMax : Int
natChainMax = 4611686018427387903

-- | Nat 字面量链折回整数：`Zero` / `Succ` 构造子（`TCon`、`TGlobal` 形态，允许
-- `TApp` 嵌套的应用脊）折成 `Maybe Int`，非链形态或部分应用返回 `Nothing`。
-- 超过 `natChainMax` 时与运行时 Nat 一样饱和；链深超过内部上限返回 `Nothing`
-- （防失控输入，正常源码字面量远小于该上限）。
natChainValue : Term -> Maybe Int
natChainValue t = natChainGo 1000000 t

natChainGo : Int -> Term -> Maybe Int
natChainGo fuel t = if fuel <= 0 then Nothing
else case flattenTermApp t of
  Pair head args => case head of
    TCon c cargs => natChainArgs (fuel - 1) c (append cargs args)
    TGlobal c => natChainArgs (fuel - 1) c args
    _ => Nothing

natChainArgs : Int -> String -> List (Pair Term Rig) -> Maybe Int
natChainArgs fuel c args = if c == natZeroCtor then case args of
  [] => Just 0
  _ => Nothing
else if c == natSuccCtor then case args of
  [Pair a _] => case natChainGo fuel a of
    Just n => Just (natChainNext n)
    Nothing => Nothing
  _ => Nothing
else Nothing

-- 饱和 +1（与 `Core.Eval.natSatAdd` / codegen 的 nat 折回一致）。
natChainNext : Int -> Int
natChainNext n = if n >= natChainMax then natChainMax else n + 1

-- 应用脊展平：`TApp (TApp f a) b` → `(f, [a, b])`（累积参数，保持线性）。
flattenTermApp : Term -> Pair Term (List (Pair Term Rig))
flattenTermApp t = flattenTermAppGo t []

flattenTermAppGo : Term -> List (Pair Term Rig) -> Pair Term (List (Pair Term Rig))
flattenTermAppGo (TApp f a rig) acc = flattenTermAppGo f (Pair a rig :: acc)
flattenTermAppGo (TRecord name args) acc = Pair (TGlobal name) (append args acc)
flattenTermAppGo t acc = Pair t acc

-- | 项的节点数（`TVar` / 字面量 / binder 各计 1，case 只数 scrutinee 与分支体）。
-- 用一个线性遍历把「固定 fuel」换成「按项规模派生 + 显式上限」，深项不再假报
-- fuel 耗尽；调用方各自再套上限防 DoS。
termSize : Term -> Int
termSize (TVar _ _ _) = 1
termSize (TMeta _) = 1
termSize (TGlobal _) = 1
termSize (TType _) = 1
termSize (TPi _ _ _ dom cod) = 1 + termSize dom + termSize cod
termSize (TLam _ _ body) = 1 + termSize body
termSize (TApp f a _) = 1 + termSize f + termSize a
termSize (TCon _ args) = 1 + termSizeArgs args
termSize (TMk _ args) = 1 + termSizeArgs args
termSize (TRecord _ args) = 1 + termSizeArgs args
termSize (TCase scrut alts) = 1 + termSize scrut + termSizeAlts alts
termSize (TProj base c tele i fi) = 1 + termSize base
termSize (TRecUpd base c tele idxs body) = 1 + termSize base + termSize body
termSize (TInt _) = 1
termSize (TStr _) = 1
termSize (TFloat _) = 1
termSize (TBool _) = 1
termSize (TIf c th el) = 1 + termSize c + termSize th + termSize el

termSizeArgs : List (Pair Term Rig) -> Int
termSizeArgs [] = 0
termSizeArgs ((Pair a _) :: rest) = termSize a + termSizeArgs rest

termSizeAlts : List CaseAlt -> Int
termSizeAlts [] = 0
termSizeAlts (alt :: rest) = termSize (caseAltBody alt) + termSizeAlts rest

-- ---------------------------------------------------------------
-- 元变量 / 定义表（M14：解是 level 形态的 Value，可以提到当前上下文里的局部变量）
-- ---------------------------------------------------------------
-- 热路径入口：查解表的 HashMap Int 索引（O(1)、无 strFromInt 分配）。
metaLookup : Int -> HashMap Int Value -> Maybe Value
metaLookup i t = Base.HashMap.lookup i t

-- 纯 list 场景（只有解表 list、没有索引）的线性兜底；热路径不要用。
metaLookupList : Int -> List (Pair Int Value) -> Maybe Value
metaLookupList i [] = Nothing
metaLookupList i ((Pair j t) :: rest) = if i == j then Just t else metaLookupList i rest

-- ---------------------------------------------------------------
-- Sols：解表 + 其哈希索引（M25 性能）。
-- ---------------------------------------------------------------
-- 解表是权威数据（前插新解），但**线性查找**在大程序上是 O(#元变量)/次：签名期的元变量
-- （隐式参数）在 bodies 阶段每次 force/conv 都要查，逐定义成本随元变量数增长 ⇒ check 超线性。
-- 这里把「list（权威）+ HashMap（索引）+ 元变量创建深度索引」打包成一个值沿调用链传递；
-- 前插新解时同时插入索引，因此查找恒为 O(1)。
--
-- M28：元变量创建深度进入 Sols（`solsDepth`），求解点**就地**检查作用域；不再有
-- 「先存解、事后扫解表」的两段式复核（旧 `checkSolsDelta`）。
--
-- M30（D18）：第 4 个字段 `defVals` 是**定义体求值结果的值共享缓存**（键 = 全局名）。
-- 它是可重建缓存：未命中一律回落 `force` 原来的 defs 表 delta 展开，所以缓存内容
-- 少一点只影响速度、不影响语义。缓存写入只发生在 `Elab.Driver.elabBodies` 的安全
-- 前缀检查之后（闭项、无未解元变量、可达全局名全部已缓存或永不定义），见那里的证明。
record Sols where
  solsTbl : HashMap Int Value
  solsList : List (Pair Int Value)
  solsDepth : HashMap Int Int
  solsDefVals : HashMap String Value

solsEmpty : Sols
solsEmpty = Sols (Base.HashMap.fromList []) [] (Base.HashMap.fromList []) (Base.HashMap.fromList [])

solsFromList : List (Pair Int Value) -> Sols
solsFromList xs =
  Sols (Base.HashMap.insertAll xs (Base.HashMap.fromList [])) xs (Base.HashMap.fromList [])
    (Base.HashMap.fromList [])

-- Elab 侧构造：解表（list 权威）+ 解索引 + 元变量创建深度索引 + 定义值缓存。
solsOf : HashMap Int Value -> List (Pair Int Value) -> HashMap Int Int -> HashMap String Value -> Sols
solsOf t xs d dv = Sols t xs d dv

solsList : Sols -> List (Pair Int Value)
solsList (Sols t xs d dv) = xs

-- 定义值缓存（`force` 的 delta 展开先查它；未命中才回落 defs 表）。
solsPutDefVals : Sols -> HashMap String Value -> Sols
solsPutDefVals (Sols t xs d dv) dv2 = Sols t xs d dv2

-- 元变量创建深度（绑定当时的上下文长度）；未登记的元变量返回 Nothing。
solsDepth : Int -> Sols -> Maybe Int
solsDepth i (Sols t xs d dv) = Base.HashMap.lookup i d

solsLookup : Int -> Sols -> Maybe Value
-- 索引与 list 同步维护（`solsCons`/`ecPutSols` 每次前插都插表），所以 miss 就是「未解」，
-- 不做线性兜底：未解元变量在推断期是**高频**查询，兜底会退化成 O(#解)/次。
solsLookup i (Sols t xs d dv) = Base.HashMap.lookup i t

solsCons : Int -> Value -> Sols -> Sols
solsCons i v (Sols t xs d dv) = Sols (Base.HashMap.insert i v t) (Pair i v :: xs) d dv

-- 项里是否有**未解**元变量（D18 的值共享安全条件之一：含未解 meta 的体不缓存）。
-- 已解的 TMeta 不算：缓存里留下的是已解值，后续求解不会改写既有解。
termHasUnsolvedMeta : Sols -> Term -> Bool
termHasUnsolvedMeta sols (TMeta m) = case solsLookup m sols of
  Just _ => False
  Nothing => True
termHasUnsolvedMeta sols (TVar name i _) = False
termHasUnsolvedMeta sols (TGlobal g) = False
termHasUnsolvedMeta sols (TType l) = False
termHasUnsolvedMeta sols (TPi name implicit rig dom cod) =
  termHasUnsolvedMeta sols dom || termHasUnsolvedMeta sols cod
termHasUnsolvedMeta sols (TLam name rig body) = termHasUnsolvedMeta sols body
termHasUnsolvedMeta sols (TApp f a rig) = termHasUnsolvedMeta sols f || termHasUnsolvedMeta sols a
termHasUnsolvedMeta sols (TCon c args) = termHasUnsolvedMetaArgs sols args
termHasUnsolvedMeta sols (TMk c args) = termHasUnsolvedMetaArgs sols args
termHasUnsolvedMeta sols (TRecord c args) = termHasUnsolvedMetaArgs sols args
termHasUnsolvedMeta sols (TProj base c tele i fi) = termHasUnsolvedMeta sols base
termHasUnsolvedMeta sols (TRecUpd base c tele idxs body) =
  termHasUnsolvedMeta sols base || termHasUnsolvedMeta sols body
termHasUnsolvedMeta sols (TCase scrut alts) =
  termHasUnsolvedMeta sols scrut || termHasUnsolvedMetaAlts sols alts
termHasUnsolvedMeta sols (TInt n) = False
termHasUnsolvedMeta sols (TStr s) = False
termHasUnsolvedMeta sols (TFloat raw) = False
termHasUnsolvedMeta sols (TBool b) = False
termHasUnsolvedMeta sols (TIf c th el) =
  termHasUnsolvedMeta sols c || termHasUnsolvedMeta sols th || termHasUnsolvedMeta sols el

termHasUnsolvedMetaArgs : Sols -> List (Pair Term Rig) -> Bool
termHasUnsolvedMetaArgs sols [] = False
termHasUnsolvedMetaArgs sols ((Pair a rig) :: rest) =
  termHasUnsolvedMeta sols a || termHasUnsolvedMetaArgs sols rest

termHasUnsolvedMetaAlts : Sols -> List CaseAlt -> Bool
termHasUnsolvedMetaAlts sols [] = False
termHasUnsolvedMetaAlts sols (alt :: rest) =
  termHasUnsolvedMeta sols (caseAltBody alt) || termHasUnsolvedMetaAlts sols rest

-- | 项是否含浮点字面量，或引用名字在给定列表里的全局（`floatIntrinsicNames` 等）：
-- interp/REPL 拒绝浮点求值、codegen 按需生成浮点 runtime helper 的共用判据。
termUsesFloat : List String -> Term -> Bool
termUsesFloat names (TFloat raw) = True
termUsesFloat names (TGlobal n) = memName n names
termUsesFloat names (TVar n i _) = False
termUsesFloat names (TMeta m) = False
termUsesFloat names (TType l) = False
termUsesFloat names (TPi n i r dom cod) = termUsesFloat names dom || termUsesFloat names cod
termUsesFloat names (TLam n r b) = termUsesFloat names b
termUsesFloat names (TApp f a r) = termUsesFloat names f || termUsesFloat names a
termUsesFloat names (TCon c args) = anyArgUsesFloat names args
termUsesFloat names (TMk c args) = anyArgUsesFloat names args
termUsesFloat names (TRecord c args) = anyArgUsesFloat names args
termUsesFloat names (TProj base c tele i fi) = termUsesFloat names base
termUsesFloat names (TRecUpd base c tele idxs body) =
  termUsesFloat names base || termUsesFloat names body
termUsesFloat names (TCase s alts) = termUsesFloat names s || anyAltUsesFloat names alts
termUsesFloat names (TInt n) = False
termUsesFloat names (TStr s) = False
termUsesFloat names (TBool b) = False
termUsesFloat names (TIf c th el) =
  termUsesFloat names c || termUsesFloat names th || termUsesFloat names el

-- | 实参列表里是否有任一表达式用到浮点（`termUsesFloat` 的列表版）。
anyArgUsesFloat : List String -> List (Pair Term Rig) -> Bool
anyArgUsesFloat names [] = False
anyArgUsesFloat names ((Pair a rig) :: rest) = termUsesFloat names a || anyArgUsesFloat names rest

-- | case 分支体列表里是否有任一用到浮点（`termUsesFloat` 的列表版）。
anyAltUsesFloat : List String -> List CaseAlt -> Bool
anyAltUsesFloat names [] = False
anyAltUsesFloat names (a :: rest) =
  termUsesFloat names (caseAltBody a) || anyAltUsesFloat names rest

-- | 项里出现的全部 `TGlobal` 名字（不去重；可达性扫描用）。
termGlobalNames : Term -> List String
termGlobalNames (TFloat raw) = []
termGlobalNames (TGlobal n) = [n]
termGlobalNames (TVar n i _) = []
termGlobalNames (TMeta m) = []
termGlobalNames (TType l) = []
termGlobalNames (TPi n i r dom cod) = append (termGlobalNames dom) (termGlobalNames cod)
termGlobalNames (TLam n r b) = termGlobalNames b
termGlobalNames (TApp f a r) = append (termGlobalNames f) (termGlobalNames a)
termGlobalNames (TCon c args) = concatMap (\p => termGlobalNames (firstOf p)) args
termGlobalNames (TMk c args) = concatMap (\p => termGlobalNames (firstOf p)) args
termGlobalNames (TRecord c args) = c :: concatMap (\p => termGlobalNames (firstOf p)) args
termGlobalNames (TProj base c tele i fi) = termGlobalNames base
termGlobalNames (TRecUpd base c tele idxs body) =
  append (termGlobalNames base) (termGlobalNames body)
termGlobalNames (TCase s alts) =
  append (termGlobalNames s) (concatMap (\a => termGlobalNames (caseAltBody a)) alts)
termGlobalNames (TInt n) = []
termGlobalNames (TStr s) = []
termGlobalNames (TBool b) = []
termGlobalNames (TIf c th el) =
  append (termGlobalNames c) (append (termGlobalNames th) (termGlobalNames el))

-- | 从 term 出发沿定义引用做可达性扫描：是否真的触达浮点字面量/浮点内建。
-- interp/REPL 的浮点求值 guard 用它（不能只看程序里“有没有 Base.Float 定义”，否则
-- `import Base` 的正常程序会被误拒）；工作列表 + fuel 限深（不做 visited：defs 环由
-- fuel 兜底）。
termReachesFloat : List (Pair String Term) -> List String -> Term -> Bool
termReachesFloat defs names t = reachesTermsFuel 4096 defs names [t]

-- | 可达性扫描的工作列表步进：命中浮点即真，否则把该项引用的全局定义体加入待查
-- 列表继续；fuel 耗尽返回假，环由 fuel 兜底。
reachesTermsFuel : Int -> List (Pair String Term) -> List String -> List Term -> Bool
reachesTermsFuel fuel defs names [] = False
reachesTermsFuel fuel defs names (t :: rest) =
  if fuel <= 0 then False
  else if termUsesFloat names t then True
  else reachesTermsFuel (fuel - 1) defs names (append rest (bodyTermsOf defs (termGlobalNames t)))

-- 全局名 → 有体定义的体（未知/axiom 跳过）。
-- | 把全局名列表解析成有体定义的定义体列表（未知/无体公理跳过）。
bodyTermsOf : List (Pair String Term) -> List String -> List Term
bodyTermsOf defs [] = []
bodyTermsOf defs (n :: rest) = case lookupPair n defs of
  Just body => body :: bodyTermsOf defs rest
  Nothing => bodyTermsOf defs rest

-- | 在 (名字, 项) 关联表里按名字查第一个匹配项，找不到返回 `Nothing`。
lookupPair : String -> List (Pair String Term) -> Maybe Term
lookupPair name [] = Nothing
lookupPair name ((Pair n v) :: rest) = if n == name then Just v else lookupPair name rest

defLookup : String -> HashMap String Term -> Maybe Term
defLookup name tbl = Base.HashMap.lookup name tbl

-- 闭合项检查：TVar 只有在被 lambda/Pi 绑定时才允许。
hasFreeVar : Int -> Term -> Bool
hasFreeVar depth (TVar name i _) = i >= depth
hasFreeVar depth (TMeta m) = False
hasFreeVar depth (TGlobal g) = False
hasFreeVar depth (TType l) = False
hasFreeVar depth (TPi name implicit rig dom cod) =
  hasFreeVar depth dom || hasFreeVar (depth + 1) cod
hasFreeVar depth (TLam name rig body) = hasFreeVar (depth + 1) body
hasFreeVar depth (TApp f a rig) = hasFreeVar depth f || hasFreeVar depth a
hasFreeVar depth (TCon c args) = hasFreeVarArgs depth args
hasFreeVar depth (TMk c args) = hasFreeVarArgs depth args
hasFreeVar depth (TRecord c args) = hasFreeVarArgs depth args
hasFreeVar depth (TProj base c tele i fi) = hasFreeVar depth base
hasFreeVar depth (TRecUpd base c tele idxs body) =
  hasFreeVar depth base || hasFreeVar (depth + length tele) body
hasFreeVar depth (TCase scrut alts) = hasFreeVar depth scrut || hasFreeVarAlts depth alts
hasFreeVar depth (TInt n) = False
hasFreeVar depth (TStr s) = False
hasFreeVar depth (TFloat raw) = False
hasFreeVar depth (TBool b) = False
hasFreeVar depth (TIf c th el) = hasFreeVar depth c || hasFreeVar depth th || hasFreeVar depth el

hasFreeVarArgs : Int -> List (Pair Term Rig) -> Bool
hasFreeVarArgs depth [] = False
hasFreeVarArgs depth ((Pair a rig) :: rest) = hasFreeVar depth a || hasFreeVarArgs depth rest

hasFreeVarAlts : Int -> List CaseAlt -> Bool
hasFreeVarAlts depth [] = False
hasFreeVarAlts depth (alt :: rest) =
  hasFreeVar (depth + length (caseAltBinders alt)) (caseAltBody alt) || hasFreeVarAlts depth rest

hasMeta : Int -> Int -> Term -> Bool
hasMeta m depth (TMeta j) = m == j
hasMeta m depth (TVar name i _) = False
hasMeta m depth (TGlobal g) = False
hasMeta m depth (TType l) = False
hasMeta m depth (TPi name implicit rig dom cod) = hasMeta m depth dom || hasMeta m (depth + 1) cod
hasMeta m depth (TLam name rig body) = hasMeta m (depth + 1) body
hasMeta m depth (TApp f a rig) = hasMeta m depth f || hasMeta m depth a
hasMeta m depth (TCon c args) = hasMetaArgs m depth args
hasMeta m depth (TMk c args) = hasMetaArgs m depth args
hasMeta m depth (TRecord c args) = hasMetaArgs m depth args
hasMeta m depth (TProj base c tele i fi) = hasMeta m depth base
hasMeta m depth (TRecUpd base c tele idxs body) =
  hasMeta m depth base || hasMeta m (depth + length tele) body
hasMeta m depth (TCase scrut alts) = hasMeta m depth scrut || hasMetaAlts m depth alts
hasMeta m depth (TInt n) = False
hasMeta m depth (TStr s) = False
hasMeta m depth (TFloat raw) = False
hasMeta m depth (TBool b) = False
hasMeta m depth (TIf c th el) = hasMeta m depth c || hasMeta m depth th || hasMeta m depth el

hasMetaArgs : Int -> Int -> List (Pair Term Rig) -> Bool
hasMetaArgs m depth [] = False
hasMetaArgs m depth ((Pair a rig) :: rest) = hasMeta m depth a || hasMetaArgs m depth rest

hasMetaAlts : Int -> Int -> List CaseAlt -> Bool
hasMetaAlts m depth [] = False
hasMetaAlts m depth (alt :: rest) =
  hasMeta m (depth + length (caseAltBinders alt)) (caseAltBody alt) || hasMetaAlts m depth rest

-- ---------------------------------------------------------------
-- de Bruijn 移动：把项从深度 depth 的上下文嵌入到更深上下文（自由变量 +amount）。
-- 局部上下文的类型按「绑定时上下文」存储，取用时需要 shift 0 (idx+1)。
-- ---------------------------------------------------------------
shift : Int -> Int -> Term -> Term
shift depth amount (t@(TVar name i sp)) = if i >= depth then TVar name (i + amount) sp else t
shift depth amount (t@(TMeta m)) = t
shift depth amount (t@(TGlobal g)) = t
shift depth amount (t@(TType l)) = t
shift depth amount (TPi name implicit rig dom cod) =
  TPi name implicit rig (shift depth amount dom) (shift (depth + 1) amount cod)
shift depth amount (TLam name rig body) = TLam name rig (shift (depth + 1) amount body)
shift depth amount (TApp f a rig) = TApp (shift depth amount f) (shift depth amount a) rig
shift depth amount (TCon c args) = TCon c (shiftArgs depth amount args)
shift depth amount (TMk c args) = TMk c (shiftArgs depth amount args)
shift depth amount (TRecord c args) = TRecord c (shiftArgs depth amount args)
shift depth amount (TProj base c tele i fi) = TProj (shift depth amount base) c tele i fi
shift depth amount (TRecUpd base c tele idxs body) =
  TRecUpd (shift depth amount base) c tele idxs (shift (depth + length tele) amount body)
shift depth amount (TCase scrut alts) =
  TCase (shift depth amount scrut) (shiftAlts depth amount alts)
shift depth amount (t@(TInt n)) = t
shift depth amount (t@(TStr s)) = t
shift depth amount (t@(TFloat raw)) = t
shift depth amount (t@(TBool b)) = t
shift depth amount (TIf c th el) =
  TIf (shift depth amount c) (shift depth amount th) (shift depth amount el)

shiftArgs : Int -> Int -> List (Pair Term Rig) -> List (Pair Term Rig)
shiftArgs depth amount [] = []
shiftArgs depth amount ((Pair a rig) :: rest) =
  Pair (shift depth amount a) rig :: shiftArgs depth amount rest

shiftAlts : Int -> Int -> List CaseAlt -> List CaseAlt
shiftAlts depth amount [] = []
shiftAlts depth amount (alt :: rest) = shiftAlt depth amount alt :: shiftAlts depth amount rest

shiftAlt : Int -> Int -> CaseAlt -> CaseAlt
shiftAlt depth amount (CaseAlt name binders body) =
  CaseAlt name binders (shift (depth + length binders) amount body)

-- 把项里对 de Bruijn 索引 `idx` 的变量引用替换成项 `arg`（按索引替换，不按名字）。
substVarAt : Int -> Term -> Term -> Term
substVarAt idx arg (t@(TVar n i _)) = if i == idx then arg else t
substVarAt idx arg (t@(TMeta m)) = t
substVarAt idx arg (t@(TGlobal g)) = t
substVarAt idx arg (t@(TType l)) = t
substVarAt idx arg (TPi n implicit rig dom cod) =
  TPi n implicit rig (substVarAt idx arg dom) (substVarAt (idx + 1) arg cod)
substVarAt idx arg (TLam n erased body) = TLam n erased (substVarAt (idx + 1) arg body)
substVarAt idx arg (TApp f a erased) = TApp (substVarAt idx arg f) (substVarAt idx arg a) erased
substVarAt idx arg (TCon c cargs) =
  TCon c (map (\p => Pair (substVarAt idx arg (firstOf p)) (secondOf p)) cargs)
substVarAt idx arg (TMk c cargs) =
  TMk c (map (\p => Pair (substVarAt idx arg (firstOf p)) (secondOf p)) cargs)
substVarAt idx arg (TRecord c cargs) =
  TRecord c (map (\p => Pair (substVarAt idx arg (firstOf p)) (secondOf p)) cargs)
substVarAt idx arg (TProj base c tele i fi) = TProj (substVarAt idx arg base) c tele i fi
substVarAt idx arg (TRecUpd base c tele idxs body) =
  TRecUpd (substVarAt idx arg base) c tele idxs (substVarAt (idx - length tele) arg body)
substVarAt idx arg (TCase scrut alts) =
  TCase (substVarAt idx arg scrut) (map (substAltAt idx arg) alts)
substVarAt idx arg (t@(TInt n)) = t
substVarAt idx arg (t@(TStr s)) = t
substVarAt idx arg (t@(TFloat raw)) = t
substVarAt idx arg (t@(TBool b)) = t
substVarAt idx arg (TIf c th el) =
  TIf (substVarAt idx arg c) (substVarAt idx arg th) (substVarAt idx arg el)

substAltAt : Int -> Term -> CaseAlt -> CaseAlt
substAltAt idx arg alt =
  CaseAlt (caseAltName alt) (caseAltBinders alt)
    (substVarAt (idx + length (caseAltBinders alt)) arg (caseAltBody alt))

substMetaVar : Int -> String -> Int -> Term -> Term
substMetaVar m name q t = substMetaVarGo m name q 0 t

substMetaVarGo : Int -> String -> Int -> Int -> Term -> Term
substMetaVarGo m name q depth (t@(TMeta n)) =
  if n == m then TVar name (depth - q) (Span "" 0 0 0 0) else t
substMetaVarGo m name q depth (TPi n i r d c) =
  TPi n i r (substMetaVarGo m name q depth d) (substMetaVarGo m name q (depth + 1) c)
substMetaVarGo m name q depth (TLam n r b) = TLam n r (substMetaVarGo m name q (depth + 1) b)
substMetaVarGo m name q depth (TApp f a r) =
  TApp (substMetaVarGo m name q depth f) (substMetaVarGo m name q depth a) r
substMetaVarGo m name q depth (TCon c args) =
  TCon c (map (\p => Pair (substMetaVarGo m name q depth (firstOf p)) (secondOf p)) args)
substMetaVarGo m name q depth (TMk c args) =
  TMk c (map (\p => Pair (substMetaVarGo m name q depth (firstOf p)) (secondOf p)) args)
substMetaVarGo m name q depth (TRecord c args) =
  TRecord c (map (\p => Pair (substMetaVarGo m name q depth (firstOf p)) (secondOf p)) args)
substMetaVarGo m name q depth (TProj base c tele i fi) =
  TProj (substMetaVarGo m name q depth base) c tele i fi
substMetaVarGo m name q depth (TCase s alts) =
  TCase (substMetaVarGo m name q depth s) (map (substMetaVarAlt m name q depth) alts)
substMetaVarGo m name q depth (TIf c th el) =
  TIf (substMetaVarGo m name q depth c) (substMetaVarGo m name q depth th)
    (substMetaVarGo m name q depth el)
substMetaVarGo m name q depth t = t

substMetaVarAlt : Int -> String -> Int -> Int -> CaseAlt -> CaseAlt
substMetaVarAlt m name q depth (CaseAlt bn bs b) =
  CaseAlt bn bs (substMetaVarGo m name q (depth + length bs) b)

-- M20 字典提升：在 `TPi` 链索引 `idx` 的绑定子后插入 `{d : Dict_C a}`（隐式运行时字典）。
-- `dictDom` 里类参数引用插入后索引 +1（`d` 落在类参数绑定子之内）。
insertDictBinder : String -> Int -> Term -> Term -> Term
insertDictBinder name idx dictDom t = insertDictBinderGo name idx dictDom 0 t

-- 在 telescope 里插入 binder（插在第 idx+1 个 binder 之后）：cod 根处深度恰好是 idx+1，
-- 其中 0..idx 号索引都指向插入点之前的 binder，索引全部 +1；`shift 0 1` 在嵌套 binder
-- 内会把 cutoff 自动抬高 1，正好让「插入点之后才绑定的变量」保持不变。
insertDictBinderGo : String -> Int -> Term -> Int -> Term -> Term
insertDictBinderGo name idx dictDom depth (TPi n i r d c) =
  if depth == idx then TPi n i r d (TPi name True RigOmega dictDom (shift 0 1 c))
  else TPi n i r d (insertDictBinderGo name idx dictDom (depth + 1) c)
insertDictBinderGo name idx dictDom depth t = t

-- M29：保留给旧调用面的纯 helper（本模块不再用；导出名保持稳定以免动导出面快照）。
cutoffOf : Int -> Int -> Int
cutoffOf total idx = if total - (idx + 1) <= 0 then 0 else total - (idx + 1)

countPis : Term -> Int
countPis (TPi n i r d c) = 1 + countPis c
countPis _ = 0

-- M20 字典提升：在 `TLam` 链索引 `idx` 的绑定子后插入 `TLam d`。
-- M29（C05）：插入点之后的体 `b` 的自由变量全部位于插入点**外侧**，因此 shift 的 cutoff
-- 必须是 0（`shift` 下钻 binder 时会自动抬高 cutoff，正好保持体内层变量不变）。旧实现
-- 传 `total - (idx + 1)`，导致第 `idx` 个 binder 及一部分外侧变量少移一位——被提升的
-- 字典变量因此可能退化成显式参数（`ma` → `d114` 自应用）。
insertLamBinder : String -> Int -> Term -> Term
insertLamBinder name idx t = insertLamBinderGo name idx 0 t

insertLamBinderGo : String -> Int -> Int -> Term -> Term
insertLamBinderGo name idx depth (TLam n r b) =
  if depth == idx then TLam n r (TLam name RigOmega (shift 0 1 b))
  else TLam n r (insertLamBinderGo name idx (depth + 1) b)
insertLamBinderGo name idx depth t = t

countLams : Term -> Int
countLams (TLam n r b) = 1 + countLams b
countLams _ = 0

-- 项里是否有自由变量（`i >= depth` 的 `TVar`）。闭项无自由变量。
hasFreeTermVar : Int -> Term -> Bool
hasFreeTermVar d (TVar n i _) = i >= d
hasFreeTermVar d (TPi n i r dm cd) = hasFreeTermVar d dm || hasFreeTermVar (d + 1) cd
hasFreeTermVar d (TLam n r b) = hasFreeTermVar (d + 1) b
hasFreeTermVar d (TApp f a r) = hasFreeTermVar d f || hasFreeTermVar d a
hasFreeTermVar d (TCon c args) = anyPairFree d args
hasFreeTermVar d (TMk c args) = anyPairFree d args
hasFreeTermVar d (TRecord c args) = anyPairFree d args
hasFreeTermVar d (TProj base c tele i fi) = hasFreeTermVar d base
hasFreeTermVar d (TRecUpd base c tele idxs body) = hasFreeTermVar d base || hasFreeTermVar d body
hasFreeTermVar d (TCase s alts) = hasFreeTermVar d s || anyAltFree d alts
hasFreeTermVar d (TIf c th el) = hasFreeTermVar d c || hasFreeTermVar d th || hasFreeTermVar d el
hasFreeTermVar d _ = False

anyPairFree : Int -> List (Pair Term Rig) -> Bool
anyPairFree d [] = False
anyPairFree d ((Pair a r) :: rest) = hasFreeTermVar d a || anyPairFree d rest

anyAltFree : Int -> List CaseAlt -> Bool
anyAltFree d [] = False
anyAltFree d ((CaseAlt n bs b) :: rest) = hasFreeTermVar (d + length bs) b || anyAltFree d rest

-- 负 de Bruijn 索引：quote 的越界产物（`varIndex` 对越界 level 返回 -1）。`hasFreeTermVar`
-- 只查上界，负索引会被 `lookupEnv` 的 `i <= 0` 当成**最内层**变量（静默错位），所以
-- 序列化/摘要校验必须单独拒绝它。
hasNegativeVar : Term -> Bool
hasNegativeVar (TVar n i _) = i < 0
hasNegativeVar (TPi n i r d c) = hasNegativeVar d || hasNegativeVar c
hasNegativeVar (TLam n r b) = hasNegativeVar b
hasNegativeVar (TApp f a r) = hasNegativeVar f || hasNegativeVar a
hasNegativeVar (TCon c args) = anyNegativeVarArgs args
hasNegativeVar (TMk c args) = anyNegativeVarArgs args
hasNegativeVar (TRecord c args) = anyNegativeVarArgs args
hasNegativeVar (TProj base c tele i fi) = hasNegativeVar base
hasNegativeVar (TRecUpd base c tele idxs body) = hasNegativeVar base || hasNegativeVar body
hasNegativeVar (TCase s alts) = hasNegativeVar s || anyNegativeVarAlts alts
hasNegativeVar (TIf c th el) = hasNegativeVar c || hasNegativeVar th || hasNegativeVar el
hasNegativeVar _ = False

anyNegativeVarArgs : List (Pair Term Rig) -> Bool
anyNegativeVarArgs [] = False
anyNegativeVarArgs ((Pair a r) :: rest) = hasNegativeVar a || anyNegativeVarArgs rest

anyNegativeVarAlts : List CaseAlt -> Bool
anyNegativeVarAlts [] = False
anyNegativeVarAlts ((CaseAlt n bs b) :: rest) = hasNegativeVar b || anyNegativeVarAlts rest

-- M20：值里是否还有未解元变量（`VMeta m` 未解，或解里仍有未解）。
hasUnsolvedMetaValue : Sols -> Value -> Bool
hasUnsolvedMetaValue sols v = hasUnsolvedMetaValueFuel 64 sols v

hasUnsolvedMetaValueFuel : Int -> Sols -> Value -> Bool
hasUnsolvedMetaValueFuel fuel sols v = if fuel <= 0 then False
else case v of
  VMeta m sp => case solsLookup m sols of
    Just solved => hasUnsolvedMetaValueFuel (fuel - 1) sols solved
    Nothing => True
  VNeutral n => case n of
    NVar name lvl sp => hasUnsolvedMetaListFuel (fuel - 1) sols sp
    NGlobal g sp => hasUnsolvedMetaListFuel (fuel - 1) sols sp
  VPi name implicit rig dom clo =>
    hasUnsolvedMetaValueFuel (fuel - 1) sols dom || hasUnsolvedMetaCloFuel (fuel - 1) sols clo
  VLam name rig clo => hasUnsolvedMetaCloFuel (fuel - 1) sols clo
  VCon c args => hasUnsolvedMetaListFuel (fuel - 1) sols args
  VApp f a =>
    hasUnsolvedMetaValueFuel (fuel - 1) sols f || hasUnsolvedMetaValueFuel (fuel - 1) sols a
  VCase scrut alts => hasUnsolvedMetaValueFuel (fuel - 1) sols scrut
  VProj base c i fi n => hasUnsolvedMetaValueFuel (fuel - 1) sols base
  VIf c th el =>
    hasUnsolvedMetaValueFuel (fuel - 1) sols c
      || hasUnsolvedMetaValueFuel (fuel - 1) sols th
      || hasUnsolvedMetaValueFuel (fuel - 1) sols el
  _ => False

hasUnsolvedMetaList : Sols -> List Value -> Bool
hasUnsolvedMetaList sols vs = hasUnsolvedMetaListFuel 64 sols vs

hasUnsolvedMetaListFuel : Int -> Sols -> List Value -> Bool
hasUnsolvedMetaListFuel fuel sols vs = if fuel <= 0 then False
else case vs of
  [] => False
  v :: rest =>
    hasUnsolvedMetaValueFuel (fuel - 1) sols v || hasUnsolvedMetaListFuel (fuel - 1) sols rest

hasUnsolvedMetaClo : Sols -> Closure -> Bool
hasUnsolvedMetaClo sols clo = hasUnsolvedMetaCloFuel 64 sols clo

hasUnsolvedMetaCloFuel : Int -> Sols -> Closure -> Bool
hasUnsolvedMetaCloFuel fuel sols clo = if fuel <= 0 then False
else case clo of
  Closure env body => hasUnsolvedMetaListFuel (fuel - 1) sols env

-- ---------------------------------------------------------------
-- 宇宙 helper
-- ---------------------------------------------------------------
isTypeValue : Value -> Bool
isTypeValue (VType l) = True
isTypeValue _ = False

typeLevelOf : Value -> Maybe Level
typeLevelOf (VType l) = Just l
typeLevelOf _ = Nothing

-- ---------------------------------------------------------------
-- 打印（错误信息与 interp --dt 结果展示）
-- ---------------------------------------------------------------
-- 解里是否出现 level ≥ limit 的局部变量（即创建该元变量之后才绑定的变量）。
levelEscapes : Int -> Int -> Value -> Bool
levelEscapes limit depth (VNeutral n) = case n of
  NVar name lvl sp => lvl >= limit || levelEscapesList limit sp
  NGlobal g sp => levelEscapesList limit sp
levelEscapes limit depth (VPi name implicit rig dom clo) =
  levelEscapes limit depth dom || levelEscapesClo limit clo
levelEscapes limit depth (VLam name rig clo) = levelEscapesClo limit clo
levelEscapes limit depth (VMeta m sp) = levelEscapesList limit sp
levelEscapes limit depth (VCon c args) = levelEscapesList limit args
levelEscapes limit depth (VApp f a) = levelEscapes limit depth f || levelEscapes limit depth a
levelEscapes limit depth (VCase scrut alts) = levelEscapes limit depth scrut
levelEscapes limit depth (VProj base c i fi n) = levelEscapes limit depth base
levelEscapes limit depth (VIf c th el) =
  levelEscapes limit depth c || levelEscapes limit depth th || levelEscapes limit depth el
levelEscapes limit depth (VType l) = False
levelEscapes limit depth (VInt n) = False
levelEscapes limit depth (VStr s) = False
levelEscapes limit depth (VFloat raw) = False
levelEscapes limit depth (VBool b) = False

levelEscapesList : Int -> List Value -> Bool
levelEscapesList limit [] = False
levelEscapesList limit (v :: rest) = levelEscapes limit 0 v || levelEscapesList limit rest

levelEscapesClo : Int -> Closure -> Bool
levelEscapesClo limit (Closure env body) = levelEscapesList limit env

showTerm : Term -> String
showTerm (TVar name i _) = name
showTerm (TMeta m) = "?${m}"
showTerm (TGlobal g) = g
showTerm (TType l) = if levelToInt l == 0 then "Type" else "Type ${levelToInt l}"
showTerm (TPi name implicit rig dom cod) =
  if name == "_" then "${showTerm dom} -> ${showTerm cod}"
  else if implicit then "{${name} : ${showTerm dom}} -> ${showTerm cod}"
  else "(${name} : ${showTerm dom}) -> ${showTerm cod}"
showTerm (TLam name rig body) = "\\${name} => ${showTerm body}"
showTerm (TApp f a rig) = "(${showTerm f} ${showTerm a})"
showTerm (TCon c args) = "(${c}${showArgTerms args})"
showTerm (TMk c args) = "(${c}${showArgTerms args})"
showTerm (TRecord name args) = recordAppShow name args
showTerm (TProj base c tele i fi) = "${showTerm base}.${c}#${fi}"
showTerm (TRecUpd base c tele idxs body) = "${showTerm base} with ${c} ${showTerm body}"
showTerm (TCase scrut alts) = "case ${showTerm scrut} of ${showCoreAlts alts}"
showTerm (TInt n) = strFromInt n
showTerm (TStr s) = showCoreString s
showTerm (TFloat raw) = raw
showTerm (TBool b) = if b then "True" else "False"
showTerm (TIf c th el) = "if ${showTerm c} then ${showTerm th} else ${showTerm el}"

-- 可回读的类型渲染（REPL 自动签名 / `:type` / 合成动作入口签名写回用）。
-- `showTerm` 不为匿名 Pi 的域补括号：`(Int -> Int) -> Int` 会渲染成
-- `Int -> Int -> Int`（右结合），写回源码会静默改变类型；TApp/TCon 的实参也有
-- 同样问题。这里只在需要时补括号，其余形态委托 `showTerm`（诊断文案不受影响）。
showTypeSig : Term -> String
showTypeSig (TPi name implicit rig dom cod) =
  if name == "_" then showSigParenIfPi dom ++ " -> " ++ showTypeSig cod
  else if implicit then "{" ++ name ++ " : " ++ showTypeSig dom ++ "} -> " ++ showTypeSig cod
  else "(" ++ name ++ " : " ++ showTypeSig dom ++ ") -> " ++ showTypeSig cod
showTypeSig (TCon c []) = c
showTypeSig (TApp f a rig) = "(" ++ showSigParenIfPi f ++ " " ++ showSigParenIfPi a ++ ")"
showTypeSig (TCon c args) = "(" ++ c ++ showSigArgs args ++ ")"
showTypeSig (TRecord name args) = showSigAppText name args
showTypeSig t = showTerm t

showSigParenIfPi : Term -> String
showSigParenIfPi (TPi n i r d c) = "(" ++ showTypeSig (TPi n i r d c) ++ ")"
showSigParenIfPi t = showTypeSig t

showSigArgs : List (Pair Term Rig) -> String
showSigArgs [] = ""
showSigArgs ((Pair a rig) :: rest) = " " ++ showSigParenIfPi a ++ showSigArgs rest

showArgTerms : List (Pair Term Rig) -> String
showArgTerms [] = ""
showArgTerms ((Pair a rig) :: rest) = " ${showTerm a}${showArgTerms rest}"

-- | R4：`TRecord name args` 的显示与等价 `TApp` 链一致（嵌套括号，诊断文案不变）。
recordAppShow : String -> List (Pair Term Rig) -> String
recordAppShow s [] = s
recordAppShow s ((Pair a _) :: rest) = recordAppShow ("(" ++ s ++ " " ++ showTerm a ++ ")") rest

-- | R4：`showTypeSig` 版本（实参按需补 Pi 括号，与 `TApp` 链一致）。
showSigAppText : String -> List (Pair Term Rig) -> String
showSigAppText s [] = s
showSigAppText s ((Pair a _) :: rest) =
  showSigAppText ("(" ++ s ++ " " ++ showSigParenIfPi a ++ ")") rest

showCoreAlts : List CaseAlt -> String
showCoreAlts [] = ""
showCoreAlts (alt :: rest) =
  "${caseAltName alt}${showBinders (caseAltBinders alt)} => ${showTerm (caseAltBody alt)} | ${showCoreAlts rest}"

showBinders : List (Pair String Rig) -> String
showBinders [] = ""
showBinders ((Pair n rig) :: rest) = " ${n}${showBinders rest}"

showCoreString : String -> String
showCoreString s = "\"${showCoreChars (strUnpack s)}\""

showCoreChars : List Int -> String
showCoreChars [] = ""
showCoreChars (c :: rest) = case c of
  34 => "\\\"${showCoreChars rest}"
  92 => "\\\\${showCoreChars rest}"
  10 => "\\n${showCoreChars rest}"
  9 => "\\t${showCoreChars rest}"
  13 => "\\r${showCoreChars rest}"
  _ => strPack [c] ++ showCoreChars rest
