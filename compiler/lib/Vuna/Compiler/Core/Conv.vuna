module Vuna.Compiler.Core.Conv
  ( conv
  , convBoth
  , convCaseAlts
  , convNeutral
  , convOneAlt
  , convSpines
  , convValueLists
  , etaLeft
  , etaRight
  , mismatchAt
  , solveMeta
  , solveMetaNew
  ) where

-- Vuna.Compiler.Core.Conv：定义性相等（beta + delta + eta）与元变量求解。
--
-- 返回更新后的元变量解表。M28：空 spine 就地检查作用域；非空 spine 走 Miller pattern
-- unification（局部中性变量 spine → λ 抽象）；非 pattern 形状明确报错。
-- M24 后维护（源码重组）：从原 Core.vuna 拆出；依赖 Core.Term（表示层）与 Core.Eval（force/quote/show）。
import Base.List
import Vuna.Compiler.Common
import Base.HashMap
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Debug
import Vuna.Compiler.Intrinsics

-- ---------------------------------------------------------------
-- 定义性相等（beta + delta + eta）与一阶元变量求解
-- 返回更新后的元变量解表。
-- ---------------------------------------------------------------
-- 快速相等判定：只认「已经决定相等」的原子形态，**不做 delta 展开**。
-- conv 每个节点都要 force 两侧（默认 fuel=512，深展开），而大量比较是同一类型常量
-- （`String` vs `String`、`Type`、零参构造子、同层局部变量）。命中时直接成功，
-- 省掉两次 force 与后续递归（实测 forceVal 单次 check 被调用 527 万次，占 check 大头）。
fastSame : Value -> Value -> Bool
fastSame a b = case a of
  VType i => case b of
    -- M29：Level 是 `Level` 数据；用 `levelEq`（内部只比 Int 字段）避免在相等
    -- 路径上依赖泛型结构比较兜底（`==` 的兜底将在 M29 删除）。
    VType j => levelEq i j
    _ => False
  VInt i => case b of
    VInt j => i == j
    _ => False
  VStr i => case b of
    VStr j => i == j
    _ => False
  VFloat i => case b of
    VFloat j => i == j
    _ => False
  VBool i => case b of
    VBool j => if i then j else not j
    _ => False
  VNeutral n1 => case b of
    VNeutral n2 =>
      if isNatLikeValue a && isNatLikeValue b then sameNatValue a b else sameNeutralAtom n1 n2
    _ => False
  VCon c1 args1 => case b of
    VCon c2 args2 =>
      if c1 == c2 && isNilList args1 && isNilList args2 then True
      else if isNatCtorName c1 && isNatCtorName c2 then sameNatValue a b else False
    _ => False
  VApp f1 x1 => case b of
    VApp f2 x2 => if isNatLikeValue a && isNatLikeValue b then sameNatValue a b else False
    _ => False
  _ => False

-- ---------------------------------------------------------------
-- D24：Nat 字面量链的判等与 fuel 派生
-- ---------------------------------------------------------------
-- 字面量在精化期展开成 `Zero` / `Succ` 链（`Elab/Term/Impl.natLitTerm`），Core 里没有
-- 惰性 `TNat`。链在 Value 层有三种可能形态：饱和的 `VCon`（求值后的字面量形态）、
-- `VNeutral NGlobal` 脊（引用构造子名的项）、以及 `VApp (VCon Succ []) x`（非饱和
-- 构造子被应用）。逐层比较会线性消耗 conv fuel，深索引（≥20）就会假报
-- `conv fuel exhausted`（D24），所以这里：
--   * 能折回整数的链按整数 O(链深) 判等 / 不等；
--   * 折不动的链（未解 meta / 中性尾巴）在逐层比较前按前缀深度一次性补足 fuel。
isNatCtorName : String -> Bool
isNatCtorName c = c == natZeroCtor || c == natSuccCtor

-- 链折回的整数上限与运行时 Nat 饱和上限一致（OCaml 63 位 int 的 max_int）。
natChainMaxValue : Int
natChainMaxValue = 4611686018427387903

natChainNextValue : Int -> Int
natChainNextValue n = if n >= natChainMaxValue then natChainMaxValue else n + 1

-- 值形态的 Nat 链折回整数：饱和构造子、`NGlobal` 脊、以及 `VApp` 形态的 `Succ` 部分
-- 应用；折不动（未解 meta / 中性尾巴 / 非链 / 部分应用）返回 `Nothing`。
natFoldValue : Value -> Maybe Int
natFoldValue v = natFoldGo 1000000 v

natFoldGo : Int -> Value -> Maybe Int
natFoldGo fuel v = if fuel <= 0 then Nothing
else case v of
  VCon c args => natFoldArgs (fuel - 1) c args
  VNeutral n => case n of
    NGlobal c sp => natFoldArgs (fuel - 1) c sp
    _ => Nothing
  VApp f a => natFoldApplied (fuel - 1) f a
  _ => Nothing

natFoldArgs : Int -> String -> List Value -> Maybe Int
natFoldArgs fuel c args = if c == natZeroCtor then case args of
  [] => Just 0
  _ => Nothing
else if c == natSuccCtor then case args of
  [a] => natFoldSucc fuel a
  _ => Nothing
else Nothing

natFoldApplied : Int -> Value -> Value -> Maybe Int
natFoldApplied fuel (VCon c []) a = if c == natSuccCtor then natFoldSucc fuel a else Nothing
natFoldApplied fuel (VNeutral n) a = case n of
  NGlobal c [] => if c == natSuccCtor then natFoldSucc fuel a else Nothing
  _ => Nothing
natFoldApplied fuel f a = Nothing

natFoldSucc : Int -> Value -> Maybe Int
natFoldSucc fuel a = case natFoldGo fuel a of
  Just n => Just (natChainNextValue n)
  Nothing => Nothing

sameNatValue : Value -> Value -> Bool
sameNatValue a b = case natFoldValue a of
  Just n => case natFoldValue b of
    Just m => n == m
    Nothing => False
  Nothing => False

-- Nat 链的根形态判定（只查头部，O(1)）：用于在热路径上决定是否走上面的折回。
isNatLikeValue : Value -> Bool
isNatLikeValue (VCon c _) = isNatCtorName c
isNatLikeValue (VNeutral n) = case n of
  NGlobal c _ => isNatCtorName c
  _ => False
isNatLikeValue (VApp f a) = isNatLikeHead f
isNatLikeValue _ = False

isNatLikeHead : Value -> Bool
isNatLikeHead (VCon c _) = c == natSuccCtor
isNatLikeHead (VNeutral n) = case n of
  NGlobal c _ => c == natSuccCtor
  _ => False
isNatLikeHead _ = False

-- Nat 链前缀深度 = 前导 `Succ` 层数（不要求以 `Zero` 收尾，覆盖三种形态）。
natPrefixDepth : Value -> Int
natPrefixDepth v = natPrefixGo 100000 v

natPrefixGo : Int -> Value -> Int
natPrefixGo fuel v = if fuel <= 0 then 100000
else case v of
  VCon c args => if c == natSuccCtor then case args of
    [a] => 1 + natPrefixGo (fuel - 1) a
    _ => 0
  else 0
  VNeutral n => case n of
    NGlobal c sp => if c == natSuccCtor then case sp of
      [a] => 1 + natPrefixGo (fuel - 1) a
      _ => 0
    else 0
    _ => 0
  VApp f a => if isNatLikeHead f then 1 + natPrefixGo (fuel - 1) a else 0
  _ => 0

-- ---------------------------------------------------------------
-- D24：conv fuel 派生（按值里的 Nat 链规模）
-- ---------------------------------------------------------------
-- 固定 64 对「字面量展开成的深 Nat 链」不够：链每层要走 convFuel → convBoth →
-- convValueLists 几步，类型索引 ≥20 就会假报 `conv fuel exhausted`。这里只对
-- **Nat 根值**按链深放大（非 Nat 值仍是 64，热路径成本不变）；上限 `convFuelMax`
-- 防失控输入。
-- 浅探：Nat 链深度取「根值」或「直接参数 / 脊实参」里的最大前缀深度。
-- 失败形态 `Vec (Succ^k Zero) Int` 的根不是 Nat，但索引链就在直接参数里；入口燃料
-- 必须覆盖索引链的逐层比较（每层约 3–4 fuel，系数 4 足够）。
convNatNear : Value -> Int
convNatNear v = if isNatLikeValue v then natPrefixDepth v
else case v of
  VCon c args => natPrefixMax args
  VNeutral n => case n of
    NGlobal g sp => natPrefixMax sp
    NVar name lvl sp => natPrefixMax sp
  VApp f a => if isNatLikeValue a then natPrefixDepth a else 0
  _ => 0

natPrefixMax : List Value -> Int
natPrefixMax [] = 0
natPrefixMax (v :: rest) =
  let
    d = if isNatLikeValue v then natPrefixDepth v else 0
    r = natPrefixMax rest
  in if d >= r then d else r

convFuelFor : Value -> Value -> Int
convFuelFor a b =
  let
    d = convNatNear a
    d2 = convNatNear b
  in convNatFuel (if d >= d2 then d else d2)

convFuelMax : Int
convFuelMax = 100000

convNatFuel : Int -> Int
convNatFuel depth = if depth > 24984 then convFuelMax else 64 + 4 * depth

-- Nat 构造子应对：两边都能折成整数时按整数判等 / 不等（O(链深)，不再逐层消耗 fuel）；
-- 折不动（meta / 中性尾巴）才回落到逐层比较，并在回落点补足 fuel。
convNatChains : HashMap String Term -> Sols -> Int -> Value -> Value -> List Value -> List Value -> Int -> Check Sols
convNatChains defs sols depth a b args args2 fuel = case natFoldValue a of
  Just n => case natFoldValue b of
    Just m => if n == m then OkC sols else mismatchAt depth a b
    Nothing => convValueListsFuel (fuel - 1) defs sols depth args args2
  Nothing => convValueListsFuel (fuel - 1) defs sols depth args args2

-- 中性脊形态的 Nat 链判等（与 `convNatChains` 同一规则，回落到 `convNeutralFuel`）。
convNatNeutral : Int -> HashMap String Term -> Sols -> Int -> Neutral -> Neutral -> Value -> Value -> Check Sols
convNatNeutral fuel defs sols depth n1 n2 a b = case natFoldValue a of
  Just x => case natFoldValue b of
    Just y => if x == y then OkC sols else mismatchAt depth a b
    Nothing => convNeutralFuel (fuel - 1) defs sols depth n1 n2 a b
  Nothing => convNeutralFuel (fuel - 1) defs sols depth n1 n2 a b

-- `VApp` 形态的 Nat 链判等：折不动时回落到逐分量比较（同样补足 fuel）。
convNatApplied : Int -> HashMap String Term -> Sols -> Int -> Value -> Value -> Value -> Value -> Value -> Value -> Check Sols
convNatApplied fuel defs sols depth f x f2 x2 a b = case natFoldValue a of
  Just n => case natFoldValue b of
    Just m => if n == m then OkC sols else mismatchAt depth a b
    Nothing =>
      Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth f f2)
        (\sols2 => convFuel (fuel - 1) defs sols2 depth x x2)
  Nothing =>
    Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth f f2)
      (\sols2 => convFuel (fuel - 1) defs sols2 depth x x2)

isNilList : List a -> Bool
isNilList [] = True
isNilList _ = False

sameNeutralAtom : Neutral -> Neutral -> Bool
sameNeutralAtom (NGlobal g1 sp1) n2 = case n2 of
  NGlobal g2 sp2 => g1 == g2 && isNilList sp1 && isNilList sp2
  _ => False
sameNeutralAtom (NVar name1 lvl1 sp1) n2 = case n2 of
  NVar name2 lvl2 sp2 => name1 == name2 && lvl1 == lvl2 && isNilList sp1 && isNilList sp2
  _ => False

convFuel : Int -> HashMap String Term -> Sols -> Int -> Value -> Value -> Check Sols
convFuel fuel defs sols depth a b = if fuel <= 0 then icFuel "conv"
else if fastSame a b then OkC sols
else
  let
    a2 = force defs sols defaultFuel a
    y2 = force defs sols defaultFuel b
  in case a2 of
    VMeta m sp => solveMetaFuel (fuel - 1) defs sols depth m sp y2
    _ => case y2 of
      VMeta m sp => solveMetaFuel (fuel - 1) defs sols depth m sp a2
      _ => convBothFuel (fuel - 1) defs sols depth a2 y2

convBothFuel : Int -> HashMap String Term -> Sols -> Int -> Value -> Value -> Check Sols
convBothFuel fuel defs sols depth a b = if fuel <= 0 then icFuel "conv"
else case a of
  VType i => case b of
    VType j => if levelEq i j then OkC sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VPi name implicit rig dom cod => case b of
    VPi name2 implicit2 rig2 dom2 cod2 => if implicit == implicit2 then Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth dom dom2) (\sols2 => let
      v = freshVar name depth
    in convFuel (fuel - 1) defs sols2 (depth + 1) (applyClosure cod v) (applyClosure cod2 v)
    )
    else mismatchAt depth a b
    _ => mismatchAt depth a b
  VLam name rig clo => case b of
    VLam name2 rig2 clo2 =>
      let
        v = freshVar name depth
      in convFuel (fuel - 1) defs sols (depth + 1) (applyClosure clo v) (applyClosure clo2 v)
    _ => etaRightFuel (fuel - 1) defs sols depth name clo b
  VNeutral n => case b of
    VNeutral n2 =>
      if isNatLikeValue a && isNatLikeValue b then convNatNeutral fuel defs sols depth n n2 a b
      else convNeutralFuel (fuel - 1) defs sols depth n n2 a b
    VLam name2 rig2 clo2 => etaLeftFuel (fuel - 1) defs sols depth a name2 clo2
    _ => mismatchAt depth a b
  VInt n => case b of
    VInt m => if n == m then OkC sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VStr s => case b of
    VStr s2 => if s == s2 then OkC sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VFloat s => case b of
    VFloat s2 => if s == s2 then OkC sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VBool x => case b of
    VBool y => if x == y then OkC sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VCon c args => case b of
    VCon c2 args2 =>
      if c == c2 then if isNatCtorName c then convNatChains defs sols depth a b args args2 fuel
      else convValueListsFuel (fuel - 1) defs sols depth args args2
      else mismatchAt depth a b
    -- R3：卡住的投影与构造子不判等（与卡住的 case 同等保守）。
    _ => mismatchAt depth a b
  VProj base c tele i fi => case b of
    VProj base2 c2 tele2 i2 fi2 =>
      if c == c2 && i == i2 then convFuel (fuel - 1) defs sols depth base base2
      else mismatchAt depth a b
    _ => mismatchAt depth a b
  VApp f x => case b of
    VApp f2 x2 => if isNatLikeValue a && isNatLikeValue b then convNatApplied fuel defs sols depth f x f2 x2 a b
    else
      let
        _ =
          if debugOn then note "vapp: ${showValue a} <> ${showValue b} | x=${showValue x} x2=${showValue x2}"
          else 0
      in Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth f f2)
        (\sols2 => convFuel (fuel - 1) defs sols2 depth x x2)
    _ => mismatchAt depth a b
  VCase scrut alts => case b of
    VCase scrut2 alts2 =>
      Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth scrut scrut2)
        (\sols2 => convCaseAltsFuel (fuel - 1) defs sols2 depth alts alts2)
    _ => mismatchAt depth a b
  VIf c th el => case b of
    VIf c2 th2 el2 =>
      Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth c c2)
        (\sols2 => Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols2 depth th th2) (\sols3 => convFuel (fuel - 1) defs sols3 depth el el2))
    _ => mismatchAt depth a b
  _ => mismatchAt depth a b

etaLeftFuel : Int -> HashMap String Term -> Sols -> Int -> Value -> String -> Closure -> Check Sols
etaLeftFuel fuel defs sols depth a name clo = if fuel <= 0 then icFuel "conv"
else
  let
    v = freshVar name depth
  in convFuel (fuel - 1) defs sols (depth + 1) (applyValue a v) (applyClosure clo v)

etaRightFuel : Int -> HashMap String Term -> Sols -> Int -> String -> Closure -> Value -> Check Sols
etaRightFuel fuel defs sols depth name clo b = if fuel <= 0 then icFuel "conv"
else
  let
    v = freshVar name depth
  in convFuel (fuel - 1) defs sols (depth + 1) (applyClosure clo v) (applyValue b v)

convNeutralFuel : Int -> HashMap String Term -> Sols -> Int -> Neutral -> Neutral -> Value -> Value -> Check Sols
convNeutralFuel fuel defs sols depth n1 n2 v1 v2 = if fuel <= 0 then icFuel "conv"
else case n1 of
  NVar name level sp => case n2 of
    NVar name2 level2 sp2 =>
      if level == level2 then convSpinesFuel (fuel - 1) defs sols depth sp sp2 v1 v2
      else mismatchAt depth v1 v2
    _ => mismatchAt depth v1 v2
  NGlobal g sp => case n2 of
    NGlobal g2 sp2 =>
      if g == g2 then convSpinesFuel (fuel - 1) defs sols depth sp sp2 v1 v2
      else mismatchAt depth v1 v2
    _ => mismatchAt depth v1 v2

convSpinesFuel : Int -> HashMap String Term -> Sols -> Int -> List Value -> List Value -> Value -> Value -> Check Sols
convSpinesFuel fuel defs sols depth [] [] v1 v2 = if fuel <= 0 then icFuel "conv" else OkC sols
convSpinesFuel fuel defs sols depth (a :: xs) (b :: ys) v1 v2 =
  if fuel <= 0 then icFuel "conv"
  else Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth a b)
    (\sols2 => convSpinesFuel (fuel - 1) defs sols2 depth xs ys v1 v2)
convSpinesFuel fuel defs sols depth _ _ v1 v2 =
  if fuel <= 0 then icFuel "conv" else mismatchAt depth v1 v2

convValueListsFuel : Int -> HashMap String Term -> Sols -> Int -> List Value -> List Value -> Check Sols
convValueListsFuel fuel defs sols depth [] [] = if fuel <= 0 then icFuel "conv" else OkC sols
convValueListsFuel fuel defs sols depth (a :: xs) (b :: ys) =
  if fuel <= 0 then icFuel "conv"
  else Vuna.Compiler.Common.bind (convFuel (fuel - 1) defs sols depth a b)
    (\sols2 => convValueListsFuel (fuel - 1) defs sols2 depth xs ys)
convValueListsFuel fuel defs sols depth _ _ =
  if fuel <= 0 then icFuel "conv" else tcErr0NoLoc TypeMismatchCtorArity

-- 卡住的 case 相等：scrutinee 相等 + 每个构造子名的分支绑定数相同且分支体相等。
convCaseAltsFuel : Int -> HashMap String Term -> Sols -> Int -> List VCaseAlt -> List VCaseAlt -> Check Sols
convCaseAltsFuel fuel defs sols depth [] [] = if fuel <= 0 then icFuel "conv" else OkC sols
convCaseAltsFuel fuel defs sols depth (a :: rest) (b :: rest2) = if fuel <= 0 then icFuel "conv"
else if a.vCaseAltName == b.vCaseAltName then if length a.vCaseAltBinders == length b.vCaseAltBinders then case convOneAltFuel (fuel - 1) defs sols depth a b of
  ErrC e => ErrC e
  OkC sols2 => convCaseAltsFuel (fuel - 1) defs sols2 depth rest rest2
else tcErr1NoLoc (TypeMismatchCaseVars a.vCaseAltName) a.vCaseAltName
else tcErr2NoLoc (TypeMismatchCaseBranch a.vCaseAltName b.vCaseAltName) a.vCaseAltName b.vCaseAltName
convCaseAltsFuel fuel defs sols depth _ _ =
  if fuel <= 0 then icFuel "conv" else tcErr0NoLoc TypeMismatchCaseCount

convOneAltFuel : Int -> HashMap String Term -> Sols -> Int -> VCaseAlt -> VCaseAlt -> Check Sols
convOneAltFuel fuel defs sols depth a b = if fuel <= 0 then icFuel "conv"
else
  let
    bs = a.vCaseAltBinders
    n = length bs
    args = argValsAt bs depth 0
  in convFuel (fuel - 1) defs sols (depth + n) (applyClosureBinder a.vCaseAltClosure args)
    (applyClosureBinder b.vCaseAltClosure args)

mismatchAt : Int -> Value -> Value -> Check a
mismatchAt depth a b =
  let
    sa = showValueAt depth a
    sb = showValueAt depth b
  in tcErr2NoLoc (TypeMismatch sa sb) sa sb

-- ---------------------------------------------------------------
-- 元变量求解（M28：Miller pattern unification）
-- ---------------------------------------------------------------
-- 规则：
--   * spine 为空：解 = rhs；就地检查 rhs 的自由变量都早于元变量创建深度（作用域）。
--   * spine 全是互不相同的局部中性变量 `x1..xn`（Miller pattern）：解 = `λx1..xn. body`，
--     rhs 里的 spine 变量被抽象成对应 λ 绑定，其它自由变量必须早于创建深度。
--   * 其余形状（真正的高阶、非 pattern）不再用「头一致」的临时提取特判，直接报
--     CannotSolveHigherOrder，诊断明确。
-- 解的表示：λ 链直接构造成 `VLam`（闭包环境按 level 复原创建点的上下文变量），于是
-- `force` 里既有的 `applySpine` 就能用；quote/conv/codegen 都不需要认识新形态。
--
-- 元变量创建深度随 `Sols` 携带（`solsDepth`），作用域在求解点就地检查；不再事后扫解表。
-- 元变量创建深度；未登记时退回当前深度（只可能出现在没有求解路径的 zonk 上下文）。
metaCreatedDepth : Sols -> Int -> Int -> Int
metaCreatedDepth sols depth m = case solsDepth m sols of
  Just d => d
  Nothing => depth

-- 项在「创建深度 created、quote 深度 depth、已进入 extra 个内部 binder」下是否只引用
-- 本地 binder / 创建深度之前的自由变量 / pattern spine 里的变量。
termScopedTo : Int -> Int -> Int -> List (Pair String Int) -> Term -> Bool
termScopedTo created depth extra levels (TVar name i) = if i < extra then True
else
  let
    level = depth + extra - 1 - i
  in level >= 0 && (level < created || memLevel level levels)
termScopedTo created depth extra levels (TMeta m) = True
termScopedTo created depth extra levels (TGlobal g) = True
termScopedTo created depth extra levels (TType l) = True
termScopedTo created depth extra levels (TPi name implicit rig dom cod) =
  termScopedTo created depth extra levels dom && termScopedTo created depth (extra + 1) levels cod
termScopedTo created depth extra levels (TLam name rig body) =
  termScopedTo created depth (extra + 1) levels body
termScopedTo created depth extra levels (TApp f a rig) =
  termScopedTo created depth extra levels f && termScopedTo created depth extra levels a
termScopedTo created depth extra levels (TCon c args) = argsScopedTo created depth extra levels args
termScopedTo created depth extra levels (TMk c args) = argsScopedTo created depth extra levels args
termScopedTo created depth extra levels (TProj base c tele i fi) =
  termScopedTo created depth extra levels base
termScopedTo created depth extra levels (TRecUpd base c tele idxs body) =
  termScopedTo created depth extra levels base
    && termScopedTo created depth (extra + length tele) levels body
termScopedTo created depth extra levels (TCase scrut alts) =
  termScopedTo created depth extra levels scrut && altsScopedTo created depth extra levels alts
termScopedTo created depth extra levels (TInt n) = True
termScopedTo created depth extra levels (TStr s) = True
termScopedTo created depth extra levels (TFloat raw) = True
termScopedTo created depth extra levels (TBool b) = True
termScopedTo created depth extra levels (TIf c th el) =
  termScopedTo created depth extra levels c
    && termScopedTo created depth extra levels th
    && termScopedTo created depth extra levels el

argsScopedTo : Int -> Int -> Int -> List (Pair String Int) -> List (Pair Term Rig) -> Bool
argsScopedTo created depth extra levels [] = True
argsScopedTo created depth extra levels ((Pair a rig) :: rest) =
  termScopedTo created depth extra levels a && argsScopedTo created depth extra levels rest

altsScopedTo : Int -> Int -> Int -> List (Pair String Int) -> List CaseAlt -> Bool
altsScopedTo created depth extra levels [] = True
altsScopedTo created depth extra levels (alt :: rest) =
  termScopedTo created depth (extra + length (caseAltBinders alt)) levels (caseAltBody alt)
    && altsScopedTo created depth extra levels rest

-- Miller pattern 判据：spine 全是不重复、无实参的局部中性变量。
patternSpineOf : List Value -> Maybe (List (Pair String Int))
patternSpineOf [] = Just []
patternSpineOf (v :: rest) = case v of
  VNeutral n => case n of
    NVar name level sp => if isNilSpine sp then case patternSpineOf rest of
      Just more =>
        if memLevel level more then Nothing else Just (Base.List.Cons (Pair name level) more)
      Nothing => Nothing
    else Nothing
    _ => Nothing
  _ => Nothing

isNilSpine : List Value -> Bool
isNilSpine [] = True
isNilSpine _ = False

memLevel : Int -> List (Pair String Int) -> Bool
memLevel level [] = False
memLevel level ((Pair n l) :: rest) = l == level || memLevel level rest

levelPos : Int -> List Int -> Maybe Int
levelPos level levels = levelPosGo level levels 0

levelPosGo : Int -> List Int -> Int -> Maybe Int
levelPosGo level [] i = Nothing
levelPosGo level (l :: rest) i = if l == level then Just i else levelPosGo level rest (i + 1)

spineLevels : List (Pair String Int) -> List Int
spineLevels [] = []
spineLevels (p :: rest) = secondOf p :: spineLevels rest

-- pattern 抽象：把 quote 出来的 rhs 变成「n 个 λ 之下」的项。索引规则：
--   * spine 第 i 个变量 → `extra + (n - 1 - i)`（λ 链外层是 spine 头部）；
--   * 创建深度之前的自由变量 → `i + n`（n 个新 binder 在外侧）；
--   * 内部 binder 变量（i < extra）保持原索引。
absPatternBody : Int -> Int -> Int -> Int -> List Int -> Term -> Term
absPatternBody n created depth extra levels (t@(TVar name i)) = if i < extra then t
else
  let
    level = depth + extra - 1 - i
  in case levelPos level levels of
    Just pos => TVar name (extra + n - 1 - pos)
    Nothing => TVar name (i + n)
absPatternBody n created depth extra levels (TPi name implicit rig dom cod) =
  TPi name implicit rig (absPatternBody n created depth extra levels dom)
    (absPatternBody n created depth (extra + 1) levels cod)
absPatternBody n created depth extra levels (TLam name rig body) =
  TLam name rig (absPatternBody n created depth (extra + 1) levels body)
absPatternBody n created depth extra levels (TApp f a rig) =
  TApp (absPatternBody n created depth extra levels f)
    (absPatternBody n created depth extra levels a) rig
absPatternBody n created depth extra levels (TCon c args) =
  TCon c
    (map (\p => Pair (absPatternBody n created depth extra levels (firstOf p)) (secondOf p)) args)
absPatternBody n created depth extra levels (TCase scrut alts) =
  TCase (absPatternBody n created depth extra levels scrut)
    (map (\alt => CaseAlt (caseAltName alt) (caseAltBinders alt) (absPatternBody n created depth (extra + length (caseAltBinders alt)) levels (caseAltBody alt))) alts)
absPatternBody n created depth extra levels (TIf c th el) =
  TIf (absPatternBody n created depth extra levels c)
    (absPatternBody n created depth extra levels th)
    (absPatternBody n created depth extra levels el)
absPatternBody n created depth extra levels t = t

-- 解里的 λ 链：spine 头部为最外层绑定。
wrapPatternLams : List (Pair String Int) -> Term -> Term
wrapPatternLams [] body = body
wrapPatternLams ((Pair name lvl) :: rest) body = TLam name RigOmega (wrapPatternLams rest body)

-- 闭包环境：按 level 复原创建点的上下文变量。第一个条目对应 level `depth-1`；创建深度
-- 之后的 level 在作用域检查后不可能被引用（占位 0，避免 levelEscapes 误判）。
-- 结构递归在 `depth` 上递减（守卫可从 `depth <= 0` 的 else 推出 depth > 0）。
patternEnv : Int -> Int -> List Value
patternEnv created depth = if depth <= 0 then []
else
  let
    level = depth - 1
    lvl = if level < created then level else 0
  in Base.List.Cons (VNeutral (NVar "_" lvl [])) (patternEnv created (depth - 1))

patternSolution : List (Pair String Int) -> Int -> Int -> Term -> Value
patternSolution [] created depth body = VType levelZero
patternSolution ((Pair name lvl) :: rest) created depth body =
  VLam name RigOmega (Closure (patternEnv created depth) (wrapPatternLams rest body))

-- 空 spine：直接存解，但先就地检查作用域（自由变量必须早于创建深度）。
-- `?m = ?m`（同一个未解元变量）是恒真约束，不能走 occurs 检查。
solveMetaEmpty : Sols -> Int -> Int -> Value -> Check Sols
solveMetaEmpty sols depth m (rhs@(VMeta n [])) =
  if n == m then OkC sols else solveMetaEmptyStore sols depth m rhs
solveMetaEmpty sols depth m rhs = solveMetaEmptyStore sols depth m rhs

solveMetaEmptyStore : Sols -> Int -> Int -> Value -> Check Sols
solveMetaEmptyStore sols depth m rhs =
  let
    created = metaCreatedDepth sols depth m
    t = quote depth rhs
  in if hasMeta m 0 t then tcErr1NoLoc (CannotSolveOccurs (strFromInt m)) (strFromInt m)
  else if termScopedTo created depth 0 [] t then OkC (solsCons m rhs sols)
  else tcErr1NoLoc (CannotSolveMetavar (strFromInt m)) (strFromInt m)

-- 非空 spine：Miller pattern 才求解，其它形状明确拒绝。
-- 非 pattern 形状的兜底（M28）：旧 M13 扩展的「头一致」提取，仅用于 spine 不是 Miller
-- pattern 的存量场景（如 `?m (e1 e2) = head args`）。这不是合一理论的一部分，只是保守
-- 近似：能提取就提取，其余仍报 CannotSolveHigherOrder；pattern 路径优先，命中时不会走到这里。
splitAtVals : Int -> List Value -> Pair (List Value) (List Value)
splitAtVals 0 xs = Pair [] xs
splitAtVals n [] = Pair [] []
splitAtVals n (x :: xs) = case splitAtVals (n - 1) xs of
  Pair a b => Pair (Base.List.Cons x a) b

solveMetaHoLegacyFuel : Int -> HashMap String Term -> Sols -> Int -> Int -> List Value -> Value -> Check Sols
solveMetaHoLegacyFuel fuel defs sols depth m sp rhs = if fuel <= 0 then icFuel "conv"
else case rhs of
  VMeta n sp2 => case solsLookup n sols of
    Just t => convFuel (fuel - 1) defs sols depth (applySpine (VMeta m sp) []) (applySpine t sp2)
    Nothing =>
      if m == n then convSpinesFuel (fuel - 1) defs sols depth sp sp2 (VMeta m sp) rhs
      else Vuna.Compiler.Common.bind (solveMetaFuel (fuel - 1) defs sols depth m [] (VMeta n []))
        (\sols2 => convSpinesFuel (fuel - 1) defs sols2 depth sp sp2 (VMeta m sp) rhs)
  VNeutral n => case n of
    NGlobal g args =>
      solveMetaHeadLegacyFuel (fuel - 1) defs sols depth m sp (VNeutral n) (VNeutral (NGlobal g []))
        args
    NVar name level args =>
      solveMetaHeadLegacyFuel (fuel - 1) defs sols depth m sp (VNeutral n)
        (VNeutral (NVar name level [])) args
    _ => tcErr1NoLoc (CannotSolveHigherOrder (strFromInt m)) (strFromInt m)
  _ => tcErr1NoLoc (CannotSolveHigherOrder (strFromInt m)) (strFromInt m)

solveMetaHeadLegacyFuel : Int -> HashMap String Term -> Sols -> Int -> Int -> List Value -> Value -> Value -> List Value -> Check Sols
solveMetaHeadLegacyFuel fuel defs sols depth m sp whole headVal args = if fuel <= 0 then icFuel "conv"
else if length args >= length sp then
  let
    extra = length args - length sp
  in case splitAtVals extra args of
    Pair headArgs tailArgs =>
      Vuna.Compiler.Common.bind
        (solveMetaFuel (fuel - 1) defs sols depth m [] (applySpine headVal headArgs))
        (\sols2 => convSpinesFuel (fuel - 1) defs sols2 depth sp tailArgs (VMeta m sp) whole)
else tcErr1NoLoc (CannotSolveHigherOrder (strFromInt m)) (strFromInt m)

solveMetaPattern : Int -> HashMap String Term -> Sols -> Int -> Int -> List Value -> Value -> Check Sols
solveMetaPattern fuel defs sols depth m sp rhs = if fuel <= 0 then icFuel "conv"
else case patternSpineOf sp of
  Nothing => solveMetaHoLegacyFuel (fuel - 1) defs sols depth m sp rhs
  Just pats =>
    let
      created = metaCreatedDepth sols depth m
      t = quote depth rhs
      n = length pats
      levels = spineLevels pats
    in if hasMeta m 0 t then tcErr1NoLoc (CannotSolveOccurs (strFromInt m)) (strFromInt m)
    else if termScopedTo created depth 0 pats t then OkC
      (solsCons m (patternSolution pats created depth (absPatternBody n created depth 0 levels t)) sols)
    else tcErr1NoLoc (CannotSolveMetavar (strFromInt m)) (strFromInt m)

solveMetaFuel : Int -> HashMap String Term -> Sols -> Int -> Int -> List Value -> Value -> Check Sols
solveMetaFuel fuel defs sols depth m sp rhs = if fuel <= 0 then icFuel "conv"
else case solsLookup m sols of
  Just t => convFuel (fuel - 1) defs sols depth (applySpine t sp) rhs
  Nothing => case sp of
    [] => solveMetaEmpty sols depth m rhs
    _ => case rhs of
      -- 同一个元变量：只统一 spine（恒真约束，不能走 occurs 检查）。
      VMeta n sp2 => if n == m then convSpinesFuel (fuel - 1) defs sols depth sp sp2 (VMeta m sp) rhs
      else case solsLookup n sols of
        Just t => solveMetaFuel (fuel - 1) defs sols depth m sp (applySpine t sp2)
        Nothing =>
          Vuna.Compiler.Common.bind (solveMetaFuel (fuel - 1) defs sols depth m [] (VMeta n []))
            (\sols2 => convSpinesFuel (fuel - 1) defs sols2 depth sp sp2 (VMeta m sp) rhs)
      _ => solveMetaPattern (fuel - 1) defs sols depth m sp rhs

solveMetaNew : HashMap String Term -> Sols -> Int -> Int -> Value -> Check Sols
solveMetaNew defs sols depth m rhs = solveMetaEmpty sols depth m rhs

conv : HashMap String Term -> Sols -> Int -> Value -> Value -> Check Sols
conv a1 a2 a3 a4 a5 = if debugOn then
  let
    _ =
      note
        "conv-in: ${showTerm (quote a3 a4)} <> ${showTerm (quote a3 a5)} |v: ${showValueAt a3 a4} <> ${showValueAt a3 a5} @${a3}"
  in convFuel (convFuelFor a4 a5) a1 a2 a3 a4 a5
else convFuel (convFuelFor a4 a5) a1 a2 a3 a4 a5

convBoth : HashMap String Term -> Sols -> Int -> Value -> Value -> Check Sols
convBoth a1 a2 a3 a4 a5 = convBothFuel (convFuelFor a4 a5) a1 a2 a3 a4 a5

convCaseAlts : HashMap String Term -> Sols -> Int -> List VCaseAlt -> List VCaseAlt -> Check Sols
convCaseAlts a1 a2 a3 a4 a5 = convCaseAltsFuel 64 a1 a2 a3 a4 a5

convOneAlt : HashMap String Term -> Sols -> Int -> VCaseAlt -> VCaseAlt -> Check Sols
convOneAlt a1 a2 a3 a4 a5 = convOneAltFuel 64 a1 a2 a3 a4 a5

convValueLists : HashMap String Term -> Sols -> Int -> List Value -> List Value -> Check Sols
convValueLists a1 a2 a3 a4 a5 = convValueListsFuel 64 a1 a2 a3 a4 a5

convNeutral : HashMap String Term -> Sols -> Int -> Neutral -> Neutral -> Value -> Value -> Check Sols
convNeutral a1 a2 a3 a4 a5 a6 a7 = convNeutralFuel 64 a1 a2 a3 a4 a5 a6 a7

convSpines : HashMap String Term -> Sols -> Int -> List Value -> List Value -> Value -> Value -> Check Sols
convSpines a1 a2 a3 a4 a5 a6 a7 = convSpinesFuel 64 a1 a2 a3 a4 a5 a6 a7

etaLeft : HashMap String Term -> Sols -> Int -> Value -> String -> Closure -> Check Sols
etaLeft a1 a2 a3 a4 a5 a6 = etaLeftFuel 64 a1 a2 a3 a4 a5 a6

etaRight : HashMap String Term -> Sols -> Int -> String -> Closure -> Value -> Check Sols
etaRight a1 a2 a3 a4 a5 a6 = etaRightFuel 64 a1 a2 a3 a4 a5 a6

solveMeta : HashMap String Term -> Sols -> Int -> Int -> List Value -> Value -> Check Sols
solveMeta a1 a2 a3 a4 a5 a6 = solveMetaFuel 64 a1 a2 a3 a4 a5 a6
