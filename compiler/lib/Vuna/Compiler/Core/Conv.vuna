module Vuna.Compiler.Core.Conv
  ( conv
  , convBoth
  , convCaseAlts
  , convNeutral
  , convOneAlt
  , convSpines
  , convValueLists
  , etaLeft
  , etaRight
  , isBoolNeutral
  , isBoolTyName
  , mismatchAt
  , solveMeta
  , solveMetaHead
  , solveMetaHo
  , solveMetaNew
  , splitAtVals
  ) where

-- Vuna.Compiler.Core.Conv：定义性相等（beta + delta + eta）与一阶元变量求解。
--
-- 返回更新后的元变量解表。元变量求解是 M13 的一阶子集：只接受空 spine、闭合解、
-- occurs check；高阶元变量与带局部绑定的解报 M13 限制（M15 补齐）。
-- M24 后维护（源码重组）：从原 Core.vuna 拆出；依赖 Core.Term（表示层）与 Core.Eval（force/quote/show）。
import Vuna.Compiler.Common
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Core.Eval
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Debug

-- ---------------------------------------------------------------
-- 定义性相等（beta + delta + eta）与一阶元变量求解
-- 返回更新后的元变量解表。
-- ---------------------------------------------------------------
-- 快速相等判定：只认「已经决定相等」的原子形态，**不做 delta 展开**。
-- conv 每个节点都要 force 两侧（默认 fuel=512，深展开），而大量比较是同一类型常量
-- （`String` vs `String`、`Type`、零参构造子、同层局部变量）。命中时直接成功，
-- 省掉两次 force 与后续递归（实测 forceVal 单次 check 被调用 527 万次，占 check 大头）。
fastSame : Value -> Value -> Bool
fastSame a b = case a of
  VType i => case b of
    VType j => i == j
    _ => False
  VInt i => case b of
    VInt j => i == j
    _ => False
  VStr i => case b of
    VStr j => i == j
    _ => False
  VBool i => case b of
    VBool j => if i then j else notBool j
    _ => False
  VNeutral n1 => case b of
    VNeutral n2 => sameNeutralAtom n1 n2
    _ => False
  VCon c1 args1 => case b of
    VCon c2 args2 => c1 == c2 && isNilList args1 && isNilList args2
    _ => False
  _ => False

isNilList : List a -> Bool
isNilList [] = True
isNilList _ = False

sameNeutralAtom : Neutral -> Neutral -> Bool
sameNeutralAtom n1 n2 = case n1 of
  NGlobal g1 sp1 => case n2 of
    NGlobal g2 sp2 => g1 == g2 && isNilList sp1 && isNilList sp2
    _ => False
  NVar name1 lvl1 sp1 => case n2 of
    NVar name2 lvl2 sp2 => name1 == name2 && lvl1 == lvl2 && isNilList sp1 && isNilList sp2
    _ => False

convFuel : Int -> HashTbl Term -> Sols -> Int -> Value -> Value -> Result Sols
convFuel fuel defs sols depth a b = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else if fastSame a b then Ok sols
else
  let
    a2 = force defs sols defaultFuel a
    y2 = force defs sols defaultFuel b
  in case a2 of
    VMeta m sp => solveMetaFuel (fuel - 1) defs sols depth m sp y2
    _ => case y2 of
      VMeta m sp => solveMetaFuel (fuel - 1) defs sols depth m sp a2
      _ => convBothFuel (fuel - 1) defs sols depth a2 y2

convBothFuel : Int -> HashTbl Term -> Sols -> Int -> Value -> Value -> Result Sols
convBothFuel fuel defs sols depth a b = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else case a of
  VType i => case b of
    VType j => if i == j then Ok sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VPi name implicit rig dom cod => case b of
    VPi name2 implicit2 rig2 dom2 cod2 => if implicit == implicit2 then andThen (convFuel (fuel - 1) defs sols depth dom dom2) (\sols2 => let
      v = freshVar name depth
    in convFuel (fuel - 1) defs sols2 (depth + 1) (applyClosure cod v) (applyClosure cod2 v)
    )
    else mismatchAt depth a b
    _ => mismatchAt depth a b
  VLam name rig clo => case b of
    VLam name2 rig2 clo2 =>
      let
        v = freshVar name depth
      in convFuel (fuel - 1) defs sols (depth + 1) (applyClosure clo v) (applyClosure clo2 v)
    _ => etaRightFuel (fuel - 1) defs sols depth name clo b
  VNeutral n => case b of
    -- 预置 Bool 桩与 Base.Bool.Bool 视为同一类型（嵌套位置也要相等：`Result (Pair Bool _)`）。
    VNeutral n2 =>
      if isBoolNeutral n && isBoolNeutral n2 then Ok sols
      else convNeutralFuel (fuel - 1) defs sols depth n n2 a b
    VLam name2 rig2 clo2 => etaLeftFuel (fuel - 1) defs sols depth a name2 clo2
    _ => mismatchAt depth a b
  VInt n => case b of
    VInt m => if n == m then Ok sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VStr s => case b of
    VStr s2 => if s == s2 then Ok sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VBool x => case b of
    VBool y => if x == y then Ok sols else mismatchAt depth a b
    _ => mismatchAt depth a b
  VCon c args => case b of
    VCon c2 args2 =>
      if c == c2 then convValueListsFuel (fuel - 1) defs sols depth args args2
      else mismatchAt depth a b
    _ => mismatchAt depth a b
  VApp f x => case b of
    VApp f2 x2 =>
      andThen (convFuel (fuel - 1) defs sols depth f f2)
        (\sols2 => convFuel (fuel - 1) defs sols2 depth x x2)
    _ => mismatchAt depth a b
  VCase scrut alts => case b of
    VCase scrut2 alts2 =>
      andThen (convFuel (fuel - 1) defs sols depth scrut scrut2)
        (\sols2 => convCaseAltsFuel (fuel - 1) defs sols2 depth alts alts2)
    _ => mismatchAt depth a b
  VIf c th el => case b of
    VIf c2 th2 el2 =>
      andThen (convFuel (fuel - 1) defs sols depth c c2)
        (\sols2 => andThen (convFuel (fuel - 1) defs sols2 depth th th2) (\sols3 => convFuel (fuel - 1) defs sols3 depth el el2))
    _ => mismatchAt depth a b
  _ => mismatchAt depth a b

etaLeftFuel : Int -> HashTbl Term -> Sols -> Int -> Value -> String -> Closure -> Result Sols
etaLeftFuel fuel defs sols depth a name clo = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else
  let
    v = freshVar name depth
  in convFuel (fuel - 1) defs sols (depth + 1) (applyValue a v) (applyClosure clo v)

etaRightFuel : Int -> HashTbl Term -> Sols -> Int -> String -> Closure -> Value -> Result Sols
etaRightFuel fuel defs sols depth name clo b = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else
  let
    v = freshVar name depth
  in convFuel (fuel - 1) defs sols (depth + 1) (applyClosure clo v) (applyValue b v)

isBoolTyName : String -> Bool
isBoolTyName n = if n == "Bool" then True else n == "Base.Bool.Bool"

isBoolNeutral : Neutral -> Bool
isBoolNeutral n = case n of
  NGlobal g sp => if sp == [] then isBoolTyName g else False
  NVar name lvl sp => if sp == [] then isBoolTyName name else False
  _ => False

convNeutralFuel : Int -> HashTbl Term -> Sols -> Int -> Neutral -> Neutral -> Value -> Value -> Result Sols
convNeutralFuel fuel defs sols depth n1 n2 v1 v2 = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else case n1 of
  NVar name level sp => case n2 of
    NVar name2 level2 sp2 =>
      if level == level2 then convSpinesFuel (fuel - 1) defs sols depth sp sp2 v1 v2
      else mismatchAt depth v1 v2
    _ => mismatchAt depth v1 v2
  NGlobal g sp => case n2 of
    NGlobal g2 sp2 =>
      if g == g2 then convSpinesFuel (fuel - 1) defs sols depth sp sp2 v1 v2
      else mismatchAt depth v1 v2
    _ => mismatchAt depth v1 v2

convSpinesFuel : Int -> HashTbl Term -> Sols -> Int -> List Value -> List Value -> Value -> Value -> Result Sols
convSpinesFuel fuel defs sols depth [] [] v1 v2 =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted" else Ok sols
convSpinesFuel fuel defs sols depth (a :: xs) (b :: ys) v1 v2 =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
  else andThen (convFuel (fuel - 1) defs sols depth a b)
    (\sols2 => convSpinesFuel (fuel - 1) defs sols2 depth xs ys v1 v2)
convSpinesFuel fuel defs sols depth _ _ v1 v2 =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted" else mismatchAt depth v1 v2

convValueListsFuel : Int -> HashTbl Term -> Sols -> Int -> List Value -> List Value -> Result Sols
convValueListsFuel fuel defs sols depth [] [] =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted" else Ok sols
convValueListsFuel fuel defs sols depth (a :: xs) (b :: ys) =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
  else andThen (convFuel (fuel - 1) defs sols depth a b)
    (\sols2 => convValueListsFuel (fuel - 1) defs sols2 depth xs ys)
convValueListsFuel fuel defs sols depth _ _ =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted" else tcErr0NoLoc TypeMismatchCtorArity

-- 卡住的 case 相等：scrutinee 相等 + 每个构造子名的分支绑定数相同且分支体相等。
convCaseAltsFuel : Int -> HashTbl Term -> Sols -> Int -> List VCaseAlt -> List VCaseAlt -> Result Sols
convCaseAltsFuel fuel defs sols depth [] [] =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted" else Ok sols
convCaseAltsFuel fuel defs sols depth (a :: rest) (b :: rest2) = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else if vCaseAltName a == vCaseAltName b then if length (vCaseAltBinders a) == length (vCaseAltBinders b) then case convOneAltFuel (fuel - 1) defs sols depth a b of
  Err e => Err e
  Ok sols2 => convCaseAltsFuel (fuel - 1) defs sols2 depth rest rest2
else tcErr1NoLoc (TypeMismatchCaseVars (vCaseAltName a)) (vCaseAltName a)
else tcErr2NoLoc (TypeMismatchCaseBranch (vCaseAltName a) (vCaseAltName b)) (vCaseAltName a)
  (vCaseAltName b)
convCaseAltsFuel fuel defs sols depth _ _ =
  if fuel <= 0 then Err "DT: internal: conv fuel exhausted" else tcErr0NoLoc TypeMismatchCaseCount

convOneAltFuel : Int -> HashTbl Term -> Sols -> Int -> VCaseAlt -> VCaseAlt -> Result Sols
convOneAltFuel fuel defs sols depth a b = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else
  let
    bs = vCaseAltBinders a
    n = length bs
    args = argValsAt bs depth 0
  in convFuel (fuel - 1) defs sols (depth + n) (applyClosureBinder (vCaseAltClosure a) args)
    (applyClosureBinder (vCaseAltClosure b) args)

mismatchAt : Int -> Value -> Value -> Result a
mismatchAt depth a b =
  let
    sa = showValueAt depth a
    sb = showValueAt depth b
  in tcErr2NoLoc (TypeMismatch sa sb) sa sb

-- 一阶求解：spine 必须为空。解是 level 形态的 Value，可以提到当前上下文里的局部变量
-- （M14 的索引精化需要 `n ↦ Zero` 这类提到分支绑定子的解）；是否越界由精化器按
-- 上下文的允许 level 上界检查（见 Elab.solveIdx）。
-- M13 扩展（更高阶）：`?m sp` 与 `rhs` 头一致时按 head 提取，元-元对齐时解 `?m`。
splitAtVals : Int -> List Value -> Pair (List Value) (List Value)
splitAtVals 0 xs = Pair [] xs
splitAtVals n [] = Pair [] []
splitAtVals n (x :: xs) = case splitAtVals (n - 1) xs of
  Pair a b => Pair (x :: a) b

solveMetaFuel : Int -> HashTbl Term -> Sols -> Int -> Int -> List Value -> Value -> Result Sols
solveMetaFuel fuel defs sols depth m sp rhs = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else case sp of
  [] => case solsLookup m sols of
    Just t => convFuel (fuel - 1) defs sols depth (applySpine t []) rhs
    Nothing => case rhs of
      -- 同一个未解元变量统一自己（`?m` vs `?m`）是恒真约束，不能走 occurs 检查
      -- （那会把 `?m := ?m` 判成无限链）。HOF 实参把带隐式 binder 的签名
      -- 实例化成同两个元变量时会出现（`srt cmp xs` 一类）。
      VMeta n [] => if n == m then Ok sols else solveMetaNew defs sols depth m rhs
      _ => solveMetaNew defs sols depth m rhs
  _ => solveMetaHoFuel (fuel - 1) defs sols depth m sp rhs

solveMetaNew : HashTbl Term -> Sols -> Int -> Int -> Value -> Result Sols
solveMetaNew defs sols depth m rhs =
  let
    t = quote depth rhs
  in if hasMeta m 0 t then tcErr1NoLoc (CannotSolveOccurs (strFromInt m)) (strFromInt m)
  else Ok (solsCons m rhs sols)

-- 更高阶求解（M13 扩展）：只在「头一致」的安全形状上做提取/对齐，其余仍报 M13。
solveMetaHoFuel : Int -> HashTbl Term -> Sols -> Int -> Int -> List Value -> Value -> Result Sols
solveMetaHoFuel fuel defs sols depth m sp rhs = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else case rhs of
  VMeta n sp2 => case solsLookup n sols of
    Just t => convFuel (fuel - 1) defs sols depth (applySpine (VMeta m sp) []) (applySpine t sp2)
    Nothing =>
      if m == n then convSpinesFuel (fuel - 1) defs sols depth sp sp2 (VMeta m sp) rhs
      else andThen (solveMetaFuel (fuel - 1) defs sols depth m [] (VMeta n []))
        (\sols2 => convSpinesFuel (fuel - 1) defs sols2 depth sp sp2 (VMeta m sp) rhs)
  -- `?m sp = ?m sp2`：同头，只统一 spine。
  -- `?m sp = ?n sp2`：元-元对齐，`?m = ?n` 再统一 spine。
  VNeutral n => case n of
    NGlobal g args =>
      solveMetaHeadFuel (fuel - 1) defs sols depth m sp (VNeutral n) (VNeutral (NGlobal g [])) args
    NVar name level args =>
      solveMetaHeadFuel (fuel - 1) defs sols depth m sp (VNeutral n) (VNeutral (NVar name level []))
        args
    _ => tcErr1NoLoc (CannotSolveHigherOrder (strFromInt m)) (strFromInt m)
  _ => tcErr1NoLoc (CannotSolveHigherOrder (strFromInt m)) (strFromInt m)

-- `?m sp = head args`（|args| >= |sp|）：`?m = head (take extra args)` 再统一剩余 spine。
solveMetaHeadFuel : Int -> HashTbl Term -> Sols -> Int -> Int -> List Value -> Value -> Value -> List Value -> Result Sols
solveMetaHeadFuel fuel defs sols depth m sp whole headVal args = if fuel <= 0 then Err "DT: internal: conv fuel exhausted"
else if length args >= length sp then
  let
    extra = length args - length sp
  in case splitAtVals extra args of
    Pair headArgs tailArgs =>
      andThen (solveMetaFuel (fuel - 1) defs sols depth m [] (applySpine headVal headArgs))
        (\sols2 => convSpinesFuel (fuel - 1) defs sols2 depth sp tailArgs (VMeta m sp) whole)
else tcErr1NoLoc (CannotSolveHigherOrder (strFromInt m)) (strFromInt m)

conv : HashTbl Term -> Sols -> Int -> Value -> Value -> Result Sols
conv a1 a2 a3 a4 a5 = convFuel 64 a1 a2 a3 a4 a5

convBoth : HashTbl Term -> Sols -> Int -> Value -> Value -> Result Sols
convBoth a1 a2 a3 a4 a5 = convBothFuel 64 a1 a2 a3 a4 a5

convCaseAlts : HashTbl Term -> Sols -> Int -> List VCaseAlt -> List VCaseAlt -> Result Sols
convCaseAlts a1 a2 a3 a4 a5 = convCaseAltsFuel 64 a1 a2 a3 a4 a5

convOneAlt : HashTbl Term -> Sols -> Int -> VCaseAlt -> VCaseAlt -> Result Sols
convOneAlt a1 a2 a3 a4 a5 = convOneAltFuel 64 a1 a2 a3 a4 a5

convValueLists : HashTbl Term -> Sols -> Int -> List Value -> List Value -> Result Sols
convValueLists a1 a2 a3 a4 a5 = convValueListsFuel 64 a1 a2 a3 a4 a5

convNeutral : HashTbl Term -> Sols -> Int -> Neutral -> Neutral -> Value -> Value -> Result Sols
convNeutral a1 a2 a3 a4 a5 a6 a7 = convNeutralFuel 64 a1 a2 a3 a4 a5 a6 a7

convSpines : HashTbl Term -> Sols -> Int -> List Value -> List Value -> Value -> Value -> Result Sols
convSpines a1 a2 a3 a4 a5 a6 a7 = convSpinesFuel 64 a1 a2 a3 a4 a5 a6 a7

etaLeft : HashTbl Term -> Sols -> Int -> Value -> String -> Closure -> Result Sols
etaLeft a1 a2 a3 a4 a5 a6 = etaLeftFuel 64 a1 a2 a3 a4 a5 a6

etaRight : HashTbl Term -> Sols -> Int -> String -> Closure -> Value -> Result Sols
etaRight a1 a2 a3 a4 a5 a6 = etaRightFuel 64 a1 a2 a3 a4 a5 a6

solveMeta : HashTbl Term -> Sols -> Int -> Int -> List Value -> Value -> Result Sols
solveMeta a1 a2 a3 a4 a5 a6 = solveMetaFuel 64 a1 a2 a3 a4 a5 a6

solveMetaHead : HashTbl Term -> Sols -> Int -> Int -> List Value -> Value -> Value -> List Value -> Result Sols
solveMetaHead a1 a2 a3 a4 a5 a6 a7 a8 = solveMetaHeadFuel 64 a1 a2 a3 a4 a5 a6 a7 a8

solveMetaHo : HashTbl Term -> Sols -> Int -> Int -> List Value -> Value -> Result Sols
solveMetaHo a1 a2 a3 a4 a5 a6 = solveMetaHoFuel 64 a1 a2 a3 a4 a5 a6
