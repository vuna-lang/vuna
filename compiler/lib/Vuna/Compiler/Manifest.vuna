module Vuna.Compiler.Manifest
  ( Manifest(..)
  , manifestDependencies
  , manifestDir
  , manifestEdition
  , manifestExports
  , manifestMembers
  , manifestName
  , manifestPath
  , manifestVersion
  , parseManifest
  , resolveManifestPath
  , validateManifest
  ) where

-- Vuna.Compiler.Manifest：vuna.toml 的语义模型（M11.5 包管理基础件）。
-- 表约定：
--   [package]     name / version / edition（edition 可选）
--   [workspace]   members = ["stdlib", "app"]（可选）
--   [export]      modules = ["Base.List"]（可选；值必须是字符串数组）
--   [dependencies] <dep-name> = "<相对路径>"
-- parseManifest 只解析，不检查文件是否存在；validateManifest 做结构校验。
-- 本模块不做文件 I/O：调用方用自己的 readFile 读入内容后传入。
import Vuna.Compiler.Common
import Vuna.Compiler.Toml

data Manifest : Type where
  Manifest : Maybe String -> Maybe String -> Maybe String -> List String -> Maybe (List String) -> List (Pair String String) -> String -> Manifest

manifestName : Manifest -> Maybe String
manifestName (Manifest name version edition members exports deps path) = name

manifestVersion : Manifest -> Maybe String
manifestVersion (Manifest name version edition members exports deps path) = version

manifestEdition : Manifest -> Maybe String
manifestEdition (Manifest name version edition members exports deps path) = edition

manifestMembers : Manifest -> List String
manifestMembers (Manifest name version edition members exports deps path) = members

manifestExports : Manifest -> Maybe (List String)
manifestExports (Manifest name version edition members exports deps path) = exports

manifestDependencies : Manifest -> List (Pair String String)
manifestDependencies (Manifest name version edition members exports deps path) = deps

manifestPath : Manifest -> String
manifestPath (Manifest name version edition members exports deps path) = path

-- 字符分类（与 Toml 内部约定一致；vuna 无字符字面量，统一用 char code）。
isDigitChar c = c >= 48 && c <= 57

isUpperAlphaChar c = c >= 65 && c <= 90

isLowerAlphaChar c = c >= 97 && c <= 122

-- 错误定位：解析期的错误带 `path:line: `，纯结构校验错误带 `path: `。
atLine path line msg =
  if path == "" then "line " ++ strFromInt line ++ ": " ++ msg
  else path ++ ":" ++ strFromInt line ++ ": " ++ msg

manifestErr path msg = if path == "" then msg else path ++ ": " ++ msg

sameSection [] [] = True
sameSection (x :: xs) (y :: ys) = if x == y then sameSection xs ys else False
sameSection _ _ = False

fieldLoc path section key entries = case lookupEntryLine section key entries of
  Just line =>
    if path == "" then "line " ++ strFromInt line ++ ": "
    else path ++ ":" ++ strFromInt line ++ ": "
  Nothing => if path == "" then "" else path ++ ": "

stringField path section key entries = case lookupEntry section key entries of
  Nothing => Ok Nothing
  Just (TStr s) => Ok (Just s)
  Just value => Err (fieldLoc path section key entries ++ "expected a string for \"" ++ key ++ "\"")

stringListField path section key entries = case lookupEntry section key entries of
  Nothing => Ok Nothing
  Just (TList xs) => Ok (Just xs)
  Just value =>
    Err (fieldLoc path section key entries ++ "expected an array of strings for \"" ++ key ++ "\"")

orEmptyList maybe = case maybe of
  Nothing => []
  Just xs => xs

-- 只接受约定表；未知表 / 未知 key 报带行号的错误（防止字段拼写错误被静默忽略）。
checkOneEntry path (TomlEntry section key value line) =
  if sameSection section [] then Err (atLine path line ("unexpected top-level key \"" ++ key ++ "\""))
  else if sameSection section ["package"] then if key == "name" || key == "version" || key == "edition" then Ok 0
  else Err (atLine path line ("unknown key \"" ++ key ++ "\" in [package]"))
  else if sameSection section ["workspace"] then if key == "members" then Ok 0
  else Err (atLine path line ("unknown key \"" ++ key ++ "\" in [workspace]"))
  else if sameSection section ["export"] then if key == "modules" then Ok 0
  else Err (atLine path line ("unknown key \"" ++ key ++ "\" in [export]"))
  else if sameSection section ["dependencies"] then Ok 0
  else Err (atLine path line ("unknown section [" ++ joinDots section ++ "]"))

checkEntries path entries = case entries of
  [] => Ok 0
  entry :: rest => case checkOneEntry path entry of
    Err e => Err e
    Ok ok => checkEntries path rest

collectDependencies path entries = collectDependenciesAcc path entries []

collectDependenciesAcc path entries acc = case entries of
  [] => Ok (reverse acc)
  (TomlEntry section key value line) :: rest => if sameSection section ["dependencies"] then case value of
    TStr rel => collectDependenciesAcc path rest (Pair key rel :: acc)
    _ => Err (atLine path line ("dependency \"" ++ key ++ "\" must have a string relative path"))
  else collectDependenciesAcc path rest acc

buildManifest path entries =
  andThen (checkEntries path entries)
    (\checked => andThen (stringField path ["package"] "name" entries) (\name => andThen (stringField path ["package"] "version" entries) (\version => andThen (stringField path ["package"] "edition" entries) (\edition => andThen (stringListField path ["workspace"] "members" entries) (\members => andThen (stringListField path ["export"] "modules" entries) (\exports => andThen (collectDependencies path entries) (\deps => Ok (Manifest name version edition (orEmptyList members) exports deps path))))))))

parseManifest : String -> String -> Result Manifest
parseManifest path contents =
  andThen (parseTomlAt path contents) (\entries => buildManifest path entries)

-- 结构校验（不检查文件存在性）。
validPackageName name = validPackageChars (strUnpack name)

validPackageChars [] = True
validPackageChars (c :: rest) =
  if isLowerAlphaChar c || isDigitChar c || c == 45 then validPackageChars rest else False

validModuleName name = validModuleSegments (splitOnDot name)

validModuleSegments [] = True
validModuleSegments (seg :: rest) =
  if validModuleSegment seg then validModuleSegments rest else False

validModuleSegment seg = validModuleSegmentChars (strUnpack seg)

validModuleSegmentChars [] = False
validModuleSegmentChars (c :: rest) = if isUpperAlphaChar c then validModuleTail rest else False

validModuleTail [] = True
validModuleTail (c :: rest) =
  if isUpperAlphaChar c || isLowerAlphaChar c || isDigitChar c || c == 95 then validModuleTail rest
  else False

validateName path name = case name of
  Nothing => Err (manifestErr path "missing [package] name")
  Just n =>
    if n == "" then Err (manifestErr path "package name must not be empty")
    else if validPackageName n then Ok 0
    else Err
      (manifestErr path ("invalid package name \"" ++ n ++ "\" (allowed characters: a-z, 0-9, '-')"))

validateVersion path version = case version of
  Nothing => Err (manifestErr path "missing [package] version")
  Just v => if v == "" then Err (manifestErr path "package version must not be empty") else Ok 0

validateEdition path edition = case edition of
  Nothing => Ok 0
  Just e => if e == "" then Err (manifestErr path "package edition must not be empty") else Ok 0

validateMembers path members = case members of
  [] => Ok 0
  m :: rest =>
    if m == "" then Err (manifestErr path "workspace member must not be empty")
    else validateMembers path rest

validateModules path modules = case modules of
  [] => Ok 0
  m :: rest =>
    if validModuleName m then validateModules path rest
    else Err
      (manifestErr path ("invalid export module \"" ++ m ++ "\" (segments must match [A-Z][A-Za-z0-9_]*)"))

validateExports path exports = case exports of
  Nothing => Ok 0
  Just modules => validateModules path modules

validateDependencies path deps = validateDepsSeen path [] deps

validateDepsSeen path seen deps = case deps of
  [] => Ok 0
  (Pair name rel) :: rest =>
    if name == "" then Err (manifestErr path "dependency name must not be empty")
    else if rel == "" then Err (manifestErr path ("dependency \"" ++ name ++ "\" path must not be empty"))
    else if memName name seen then Err (manifestErr path ("duplicate dependency \"" ++ name ++ "\""))
    else validateDepsSeen path (name :: seen) rest

validateManifest : Manifest -> Result Manifest
validateManifest (Manifest name version edition members exports deps path) =
  andThen (validateName path name)
    (\okName => andThen (validateVersion path version) (\okVersion => andThen (validateEdition path edition) (\okEdition => andThen (validateMembers path members) (\okMembers => andThen (validateExports path exports) (\okExports => andThen (validateDependencies path deps) (\okDeps => Ok (Manifest name version edition members exports deps path)))))))

-- manifest 所在目录：`a/b/vuna.toml` -> `a/b`；没有目录成分 -> "."。
manifestDir : String -> String
manifestDir path = dirFromRev (reverse (strUnpack path))

dirFromRev [] = "."
dirFromRev (c :: rest) = if c == 47 then dirResult (strPack (reverse rest)) else dirFromRev rest

dirResult dir = if dir == "" then "/" else dir

-- 依赖路径的相对解析基础：manifest 目录 + 相对路径。
resolveManifestPath : Manifest -> String -> String
resolveManifestPath manifest rel =
  let
    dir = manifestDir (manifestPath manifest)
  in if startsWith "/" rel then rel else if dir == "." then rel else dir ++ "/" ++ rel
