module Vuna.Compiler.Codegen
  ( module Vuna.Compiler.Codegen.Program
  , module Vuna.Compiler.Codegen.Split
  ) where

-- Vuna.Compiler.Codegen：DT 擦除 codegen 的门面。
--
-- 对外只有三个入口（单文件产物的 `checkDtProgram` / `generateDtProgram` 与逐模块
-- split 的 `generateDtSplitProgram`）；实现按调用图拆在子模块里：
--   - Decl  ：OCaml 名字编码 + 变体类型声明；
--   - Erase ：擦除/作用域/名字护栏、依赖分析与 SCC 分组；
--   - Term  ：项 → OCaml + DT 运行时前缀；
--   - Program：单文件产物装配与两个入口；
--   - Split ：逐模块 split 的归属表与分文件装配。
-- 外部（Driver.Dt）只 import 本门面，不依赖任何子模块。
import Vuna.Compiler.Codegen.Program
import Vuna.Compiler.Codegen.Split
