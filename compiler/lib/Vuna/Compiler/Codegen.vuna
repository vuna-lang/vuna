module Vuna.Compiler.Codegen (checkDtProgram, generateDtProgram, generateDtSplitProgram) where

-- Vuna.Compiler.Codegen：DT 的擦除检查与 OCaml 生成（M14：索引族 + 依赖模式匹配）。
--
-- 与 TypedCodegen（HM 路径）完全独立：只依赖 Vuna.Compiler.Core / Vuna.Compiler.Elab，
-- 自带最小 runtime（bi_* 与 show helper），不引用 HM codegen 的内部 helper。
--
-- 擦除规则（由精化器在项上标好的标志驱动）：
-- - `rigIsErased` 为真的绑定不生成参数；同样为真的实参不生成实参；
-- - 类型级定义（类型 force 后是宇宙）整体不生成运行时定义；
-- - 运行时项里出现被擦除绑定 / 类型级定义 / 类型本身 → 报错（M16 做完整擦除分析）。
--
-- M14 追加：
-- - data 声明 → OCaml 变体类型（每个族一个 `type 'a t_F = ...`）；
-- - TCon → 变体构造子应用（跳过擦除实参）；
-- - TCase → OCaml match（分支绑定变量用去重名，擦除绑定子不进 pattern 但占 index）；
-- - 递归定义 → SCC 分组，自/互递归分量用 `let rec ... and ...` 生成。
import Vuna.Compiler.Common
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Core
import Vuna.Compiler.Elab

-- ---------------------------------------------------------------
-- 构造子应用的标准形态
-- ---------------------------------------------------------------
--
-- 精化器可能把饱和的构造子应用表示成嵌套 `TApp (TApp (TCon c []) a) b`，
-- 也可能直接给 `TCon c [a, b]`。这里统一折叠成 (构造子名, 实参列表)：
-- 擦除/依赖分析按实参自带的擦除标志判断，生成侧好一次性 tupled 出来。
flattenConApp : Term -> Maybe (Pair String (List (Pair Term Rig)))
flattenConApp t = case t of
  TApp f a rig => case flattenConApp f of
    Just (Pair c args) => Just (Pair c (append args [Pair a rig]))
    Nothing => Nothing
  TCon c args => Just (Pair c args)
  _ => Nothing

-- ---------------------------------------------------------------
-- 预处理：分区（类型级 / 运行时）、擦除检查、依赖拓扑排序
-- ---------------------------------------------------------------
defTable : List DtDef -> List (Pair String Term)
defTable [] = []
defTable (d :: rest) = Pair (dtDefName d) (dtDefBody d) :: defTable rest

findDtDef : String -> List DtDef -> Maybe DtDef
findDtDef name [] = Nothing
findDtDef name (d :: rest) = if dtDefName d == name then Just d else findDtDef name rest

-- 类型级定义的判据：定义**类型** force 后以宇宙收尾（`Type` 或 `... -> Type` 的 Pi 链）。
-- 旧实现只看 `isTypeValue`（仅裸 `Type`），于是 `sel : Nat -> Type` 一类类型族被判成
-- 运行时定义，生成的 OCaml 里出现未定义的 `v_Int`/`v_String`（M24.5 发现的预存在 bug）。
isTypeForming : Value -> Bool
isTypeForming v = case v of
  VType l => True
  VPi name implicit rig dom clo => isTypeForming (applyClosure clo (VNeutral (NVar name 0 [])))
  _ => False

isTypeLevelDef : List (Pair String Term) -> DtDef -> Bool
isTypeLevelDef table d = isTypeForming (force table [] defaultFuel (eval [] (dtDefType d)))

partitionDefs : List (Pair String Term) -> List DtDef -> Pair (List DtDef) (List String)
partitionDefs table defs = partitionDefsGo table defs [] []

partitionDefsGo : List (Pair String Term) -> List DtDef -> List DtDef -> List String -> Pair (List DtDef) (List String)
partitionDefsGo table [] runtime typeNames = Pair (reverse runtime) (reverse typeNames)
partitionDefsGo table (d :: rest) runtime typeNames =
  if isTypeLevelDef table d then partitionDefsGo table rest runtime (dtDefName d :: typeNames)
  else partitionDefsGo table rest (d :: runtime) typeNames

checkAllErasure : List String -> List DtDef -> Result Int
checkAllErasure typeNames [] = Ok 0
checkAllErasure typeNames (d :: rest) =
  andThen (checkOneErasure typeNames d) (\_ => checkAllErasure typeNames rest)

-- 报错带上定义名：同一份程序里哪个函数有问题要能一眼看出来。
checkOneErasure : List String -> DtDef -> Result Int
checkOneErasure typeNames d = case checkErasure typeNames [] (dtDefBody d) of
  Err e => Err ("in `" ++ dtDefName d ++ "`: " ++ e)
  Ok n => Ok n

-- binders：最近绑定在前（名字 + 是否擦除）。
showMetaHint : Int -> String
showMetaHint m = " ?" ++ strFromInt m

checkErasure : List String -> List (Pair String Rig) -> Term -> Result Int
checkErasure typeNames binders t = case t of
  TVar name i => case binderAt i binders of
    Just (Pair n rig) =>
      if rigIsErased rig then Err ("DT: type-level binding `" ++ name ++ "` is used at runtime (M13 limitation)")
      else Ok 0
    Nothing =>
      Err
        ("DT: internal: unbound runtime variable " ++ name ++ " (index " ++ strFromInt i ++ ", binders " ++ strFromInt (length binders) ++ ")")
  TGlobal name =>
    if memName name typeNames then Err ("DT: type-level name `" ++ name ++ "` is used at runtime (M13 limitation)")
    else Ok 0
  TType l => Err "DT: a type is used at runtime (M13 limitation)"
  TPi name implicit rig dom cod => Err "DT: a type is used at runtime (M13 limitation)"
  TMeta m => Err ("DT: unsolved metavariable in runtime code" ++ showMetaHint m)
  TLam name rig body => checkErasure typeNames (Pair name rig :: binders) body
  TApp f a rig => case flattenConApp t of
    -- 嵌套在构造子上的应用按构造子实参检查（实参自带擦除标志，比 TApp 的更准）。
    Just (Pair c args) => checkConArgsErasure typeNames binders args
    Nothing =>
      if rigIsErased rig then checkErasure typeNames binders f
      else andThen (checkErasure typeNames binders f) (\_ => checkErasure typeNames binders a)
  -- M14：构造子应用只看非擦除实参（擦除实参是族参数/索引，允许是类型项）。
  TCon c args => checkConArgsErasure typeNames binders args
  -- M14：case 的分支把「完整 telescope（表面顺序）」压栈后再检查分支体。
  TCase scrut alts =>
    andThen (checkErasure typeNames binders scrut) (\_ => checkAltErasure typeNames binders alts)
  TInt n => Ok 0
  TStr s => Ok 0
  TBool b => Ok 0
  TIf c th el =>
    andThen (checkErasure typeNames binders c)
      (\_ => andThen (checkErasure typeNames binders th) (\_ => checkErasure typeNames binders el))

checkConArgsErasure : List String -> List (Pair String Rig) -> List (Pair Term Rig) -> Result Int
checkConArgsErasure typeNames binders [] = Ok 0
checkConArgsErasure typeNames binders ((Pair arg rig) :: rest) =
  if rigIsErased rig then checkConArgsErasure typeNames binders rest
  else andThen (checkErasure typeNames binders arg) (\_ => checkConArgsErasure typeNames binders rest)

checkAltErasure : List String -> List (Pair String Rig) -> List CaseAlt -> Result Int
checkAltErasure typeNames binders [] = Ok 0
checkAltErasure typeNames binders (alt :: rest) =
  let
    altBinders = caseAltBinders alt
    env = append (reverse altBinders) binders
  in andThen (checkErasure typeNames env (caseAltBody alt))
    (\_ => checkAltErasure typeNames binders rest)

binderAt : Int -> List (Pair String Rig) -> Maybe (Pair String Rig)
binderAt i [] = Nothing
binderAt i (b :: rest) = if i <= 0 then Just b else binderAt (i - 1) rest

-- 依赖：运行时会用到的 TGlobal（擦除实参里的不算）。
termDepsInto : List String -> List String -> Term -> List String
termDepsInto runtimeNames acc t = case t of
  TGlobal name => if memName name runtimeNames then addName name acc else acc
  TVar name i => acc
  TMeta m => acc
  TType l => acc
  TPi name implicit rig dom cod => acc
  TLam name rig body => termDepsInto runtimeNames acc body
  TApp f a rig => case flattenConApp t of
    Just (Pair c args) => termDepsArgs runtimeNames acc args
    Nothing =>
      if rigIsErased rig then termDepsInto runtimeNames acc f
      else termDepsInto runtimeNames (termDepsInto runtimeNames acc f) a
  TCon c args => termDepsArgs runtimeNames acc args
  TCase scrut alts => termDepsAlts runtimeNames (termDepsInto runtimeNames acc scrut) alts
  TInt n => acc
  TStr s => acc
  TBool b => acc
  TIf c th el =>
    termDepsInto runtimeNames (termDepsInto runtimeNames (termDepsInto runtimeNames acc c) th) el

termDepsArgs : List String -> List String -> List (Pair Term Rig) -> List String
termDepsArgs runtimeNames acc [] = acc
termDepsArgs runtimeNames acc ((Pair arg rig) :: rest) =
  if rigIsErased rig then termDepsArgs runtimeNames acc rest
  else termDepsArgs runtimeNames (termDepsInto runtimeNames acc arg) rest

termDepsAlts : List String -> List String -> List CaseAlt -> List String
termDepsAlts runtimeNames acc [] = acc
termDepsAlts runtimeNames acc (alt :: rest) =
  termDepsAlts runtimeNames (termDepsInto runtimeNames acc (caseAltBody alt)) rest

addName : String -> List String -> List String
addName name [] = [name]
addName name (x :: rest) = if x == name then x :: rest else x :: addName name rest

runtimeNamesOf : List DtDef -> List String
runtimeNamesOf [] = []
runtimeNamesOf (d :: rest) = dtDefName d :: runtimeNamesOf rest

lookupDtDef : List DtDef -> String -> Maybe DtDef
lookupDtDef defs name = findDtDef name defs

-- ---------------------------------------------------------------
-- SCC 分组（M14：替代 M13 的「递归 = 报错」）
-- ---------------------------------------------------------------
--
-- 与 TypedCodegen 的 Kosaraju 分组同构：先在正向依赖图上求完成顺序，再在反向图
-- 上按该顺序收集分量，最后按依赖就绪顺序排列分量。分量内成员按源码顺序排列，
-- 保证同一输入产出逐字节稳定的 OCaml。
neighborsOf : List (Pair String (List String)) -> String -> List String
neighborsOf adj name = case adj of
  [] => []
  (Pair n ns) :: rest => if n == name then ns else neighborsOf rest name

dependentsOf : String -> List (Pair String (List String)) -> List String
dependentsOf name [] = []
dependentsOf name ((Pair n ns) :: rest) =
  let
    dep = dependentsOf name rest
  in if memName name ns then n :: dep else dep

reverseAdj : List String -> List (Pair String (List String)) -> List (Pair String (List String))
reverseAdj names adj = map (\n => Pair n (dependentsOf n adj)) names

foldNeighborsPost : List (Pair String (List String)) -> List String -> List String -> List String -> Pair (List String) (List String)
foldNeighborsPost adj [] visited order = Pair visited order
foldNeighborsPost adj (m :: rest) visited order = if memName m visited then foldNeighborsPost adj rest visited order
else case dfsPost adj m (m :: visited) order of
  Pair visited2 order2 => foldNeighborsPost adj rest visited2 order2

dfsPost : List (Pair String (List String)) -> String -> List String -> List String -> Pair (List String) (List String)
dfsPost adj n visited order = case foldNeighborsPost adj (neighborsOf adj n) visited order of
  Pair visited2 order2 => Pair visited2 (n :: order2)

postOrder : List (Pair String (List String)) -> List String -> List String -> List String -> Pair (List String) (List String)
postOrder adj nodes visited order = case nodes of
  [] => Pair visited order
  n :: rest => if memName n visited then postOrder adj rest visited order
  else case dfsPost adj n (n :: visited) order of
    Pair visited2 order2 => postOrder adj rest visited2 order2

foldNeighborsCollect : List (Pair String (List String)) -> List String -> List String -> List String -> Pair (List String) (List String)
foldNeighborsCollect revAdj [] visited comp = Pair visited comp
foldNeighborsCollect revAdj (m :: rest) visited comp = if memName m visited then foldNeighborsCollect revAdj rest visited comp
else case dfsCollect revAdj m (m :: visited) comp of
  Pair visited2 comp2 => foldNeighborsCollect revAdj rest visited2 comp2

dfsCollect : List (Pair String (List String)) -> String -> List String -> List String -> Pair (List String) (List String)
dfsCollect revAdj n visited comp = case foldNeighborsCollect revAdj (neighborsOf revAdj n) visited comp of
  Pair visited2 comp2 => Pair visited2 (n :: comp2)

collectComps : List (Pair String (List String)) -> List String -> List String -> List (List String) -> List (List String)
collectComps revAdj nodes visited comps = case nodes of
  [] => comps
  n :: rest => if memName n visited then collectComps revAdj rest visited comps
  else case dfsCollect revAdj n (n :: visited) [] of
    Pair visited2 comp => collectComps revAdj rest visited2 (comp :: comps)

componentOf : List (List String) -> String -> Maybe (List String)
componentOf [] name = Nothing
componentOf (g :: rest) name = if memName name g then Just g else componentOf rest name

-- 按 names 首次出现顺序产出 SCC，组内成员按 names 顺序排列。
groupsFromComps : List (List String) -> List String -> List (List String)
groupsFromComps comps names = groupsFromCompsGo comps names names []

groupsFromCompsGo : List (List String) -> List String -> List String -> List String -> List (List String)
groupsFromCompsGo comps allNames [] emitted = []
groupsFromCompsGo comps allNames (n :: rest) emitted = if memName n emitted then groupsFromCompsGo comps allNames rest emitted
else case componentOf comps n of
  Just g =>
    filterNames (\m => memName m g) allNames
      :: groupsFromCompsGo comps allNames rest (append g emitted)
  Nothing => groupsFromCompsGo comps allNames rest emitted

filterNames : (String -> Bool) -> List String -> List String
filterNames pred names = case names of
  [] => []
  n :: rest => if pred n then n :: filterNames pred rest else filterNames pred rest

notIn : String -> List String -> Bool
notIn name names = if memName name names then False else True

uniqueNames : List String -> List String
uniqueNames [] = []
uniqueNames (name :: rest) =
  if name == "" then uniqueNames rest
  else if memName name rest then uniqueNames rest else name :: uniqueNames rest

groupDeps : List (Pair String (List String)) -> List String -> List String
groupDeps adj group =
  filterNames (\n => notIn n group) (uniqueNames (concatMap (neighborsOf adj) group))

allIn : List String -> List String -> Bool
allIn names allowed = case names of
  [] => True
  n :: rest => if memName n allowed then allIn rest allowed else False

groupReady : List (Pair String (List String)) -> List String -> List String -> Bool
groupReady adj group emitted = allIn (groupDeps adj group) emitted

pickReady : List (Pair String (List String)) -> List (List String) -> List String -> Maybe (Pair (List String) (List (List String)))
pickReady adj groups emitted = pickReadyAcc adj groups [] emitted

pickReadyAcc : List (Pair String (List String)) -> List (List String) -> List (List String) -> List String -> Maybe (Pair (List String) (List (List String)))
pickReadyAcc adj [] before emitted = Nothing
pickReadyAcc adj (g :: rest) before emitted =
  if groupReady adj g emitted then Just (Pair g (append (reverse before) rest))
  else pickReadyAcc adj rest (g :: before) emitted

orderGroups : List (Pair String (List String)) -> List (List String) -> Result (List (List String))
orderGroups adj groups = orderGroupsAcc adj groups []

orderGroupsAcc : List (Pair String (List String)) -> List (List String) -> List String -> Result (List (List String))
orderGroupsAcc adj [] emitted = Ok []
orderGroupsAcc adj remaining emitted = case pickReady adj remaining emitted of
  Nothing => Err "DT: dependency cycle between runtime definitions"
  Just (Pair g rest) =>
    andThen (orderGroupsAcc adj rest (append g emitted)) (\tail => Ok (g :: tail))

-- 运行时定义的依赖邻接表（只保留运行时会用到的 TGlobal 边）。
depAdjacency : List DtDef -> List (Pair String (List String))
depAdjacency defs =
  let
    names = runtimeNamesOf defs
  in map (\d => Pair (dtDefName d) (termDepsInto names [] (dtDefBody d))) defs

groupRuntimeDefs : List DtDef -> Result (List (List DtDef))
groupRuntimeDefs defs =
  let
    names = runtimeNamesOf defs
    adj = depAdjacency defs
    revAdj = reverseAdj names adj
  in case postOrder adj names [] [] of
    Pair _ order =>
      let
        comps = collectComps revAdj order [] []
        groups = groupsFromComps comps names
      in andThen (orderGroups adj groups) (\ordered => Ok (map (groupDefsOf defs) ordered))

groupDefsOf : List DtDef -> List String -> List DtDef
groupDefsOf defs [] = []
groupDefsOf defs (n :: rest) = case lookupDtDef defs n of
  Nothing => groupDefsOf defs rest
  Just d => d :: groupDefsOf defs rest

-- M24.6 第一级：OCaml 名字编码的单射性护栏。`sanitizeName` 的转义是前缀码
-- （'_' 只会以 `_d/_u/_p/_h` 形式出现），理论上已单射；这里仍对**实际生成的**
-- value/type/ctor 名字做去重校验，任何未来改动引入碰撞都在 check 期报错，而不是
-- 静默覆盖（三族前缀 v_/t_/C_ 互不相同，只需族内校验）。
checkNoDupOcamlNames : String -> List String -> Result Int
checkNoDupOcamlNames kind [] = Ok 0
checkNoDupOcamlNames kind (n :: rest) =
  if memName n rest then Err ("DT: internal: OCaml name collision among " ++ kind ++ "s: `" ++ n ++ "`")
  else checkNoDupOcamlNames kind rest

ensureUniqueOcamlNames : List DtData -> List DtDef -> Result Int
ensureUniqueOcamlNames datas defs =
  let
    runtime = runtimeDatas datas
    valueNames = map (\d => valueName (dtDefName d)) defs
    typeNames = map (\d => typeName (dtDataName d)) runtime
    ctorNames =
      concatMap (\d => map (\c => ctorOcamlName (dtCtorFamily c) (dtCtorName c)) (dtDataCtors d))
        runtime
  in andThen (checkNoDupOcamlNames "value" valueNames)
    (\_ => andThen (checkNoDupOcamlNames "type" typeNames) (\_ => checkNoDupOcamlNames "constructor" ctorNames))

-- M24.6 第三级（重新裁定后的最小落地）：de Bruijn index 的作用域护栏。
-- `Core.varIndex` 越界已改为返回 -1（不再静默指向 0）；这里对**全部**定义体
-- （含类型级定义，它们现在整体擦除、不再过擦除检查）做一次作用域验证，任何
-- 越界/负 index 都在 check 期报内部错误，而不是在 codegen/OCaml 阶段才炸。
checkTermScopes : Int -> Term -> Result Int
checkTermScopes depth t = case t of
  TVar name i =>
    if i >= 0 then if i < depth then Ok 0
    else Err
      ("DT: internal: out-of-scope de Bruijn index " ++ strFromInt i ++ " (depth " ++ strFromInt depth ++ ")")
    else Err ("DT: internal: negative de Bruijn index " ++ strFromInt i)
  TGlobal name => Ok 0
  TInt n => Ok 0
  TStr s => Ok 0
  TBool b => Ok 0
  TType l => Ok 0
  TMeta m => Ok 0
  TApp f a rig =>
    if rigIsErased rig then checkTermScopes depth f
    else andThen (checkTermScopes depth f) (\_ => checkTermScopes depth a)
  TCon c args => checkTermScopesArgs depth args
  TLam name rig body => checkTermScopes (depth + 1) body
  TPi name implicit rig dom cod =>
    andThen (checkTermScopes depth dom) (\_ => checkTermScopes (depth + 1) cod)
  TIf c th el =>
    andThen (checkTermScopes depth c)
      (\_ => andThen (checkTermScopes depth th) (\_ => checkTermScopes depth el))
  TCase scrut alts => andThen (checkTermScopes depth scrut) (\_ => checkAltScopes depth alts)

checkTermScopesArgs : Int -> List (Pair Term Rig) -> Result Int
checkTermScopesArgs depth [] = Ok 0
checkTermScopesArgs depth ((Pair arg rig) :: rest) =
  if rigIsErased rig then checkTermScopesArgs depth rest
  else andThen (checkTermScopes depth arg) (\_ => checkTermScopesArgs depth rest)

checkAltScopes : Int -> List CaseAlt -> Result Int
checkAltScopes depth [] = Ok 0
checkAltScopes depth (alt :: rest) =
  andThen (checkTermScopes (depth + length (caseAltBinders alt)) (caseAltBody alt))
    (\_ => checkAltScopes depth rest)

checkAllDefScopes : List DtDef -> Result Int
checkAllDefScopes [] = Ok 0
checkAllDefScopes (d :: rest) =
  andThen (checkTermScopes 0 (dtDefBody d)) (\_ => checkAllDefScopes rest)

-- check / compile 共用的准备阶段：名字护栏 + 分区 + 擦除检查 + SCC 分组。
-- 返回 (运行时定义（源码顺序）, 已按依赖排序的分组)。
prepareDtProgram : Pair (List DtData) (List DtDef) -> Result (Pair (List DtDef) (List (List DtDef)))
prepareDtProgram program =
  let
    datas = firstOf program
    defs = secondOf program
    table = defTable defs
    familyNames = map dtDataName datas
  in case partitionDefs table defs of
    Pair runtime typeNames =>
      let
        allTypeNames = append typeNames familyNames
      in andThen (checkAllDefScopes runtime)
        (\_ => andThen (ensureUniqueOcamlNames datas runtime) (\_ => andThen (checkAllErasure allTypeNames runtime) (\_ => andThen (groupRuntimeDefs runtime) (\groups => Ok (Pair runtime groups)))))

-- ---------------------------------------------------------------
-- OCaml 生成
-- ---------------------------------------------------------------
sanitizeChar : Int -> List Int
-- `#` 出现在 Loader 生成的匿名实例名里（`#default`、`#fancy`），OCaml 标识符不允许。
sanitizeChar c =
  if c == 46 then [95, 100]
  else if c == 95 then [95, 117] else if c == 39 then [95, 112] else if c == 35 then [95, 104] else [c]

sanitizeName : String -> String
sanitizeName name = strPack (concatMap sanitizeChar (strUnpack name))

ocamlPad3 : String -> String
ocamlPad3 s = if strLength s == 1 then "00" ++ s else if strLength s == 2 then "0" ++ s else s

ocamlEscapeChar : Int -> List Int
ocamlEscapeChar c =
  if c == 34 then [92, 34]
  else if c == 92 then [92, 92]
  else if c == 10 then [92, 110]
  else if c == 9 then [92, 116]
  else if c == 13 then [92, 114]
  else if c >= 32 && c <= 126 then [c] else strUnpack ("\\" ++ ocamlPad3 (strFromInt c))

ocamlString : String -> String
ocamlString s = "\"" ++ strPack (concatMap ocamlEscapeChar (strUnpack s)) ++ "\""

valueName : String -> String
valueName name = "v_" ++ sanitizeName name

-- 单独提出来：OCaml `if` 直接作构造子实参时 TypedCodegen 的括号处理不可靠，
-- 这里把它包成一个命名函数，保证自举编译本文件时生成的 OCaml 合法。
boolText : Bool -> String
boolText b = if b then "true" else "false"

-- M14：族 → OCaml 变体类型名；构造子 → 带族前缀的变体构造子名（避免跨族重名）。
typeName : String -> String
typeName name = "t_" ++ sanitizeName name

ctorOcamlName : String -> String -> String
ctorOcamlName family ctor = "C_" ++ sanitizeName family ++ "_" ++ sanitizeName ctor

-- DT runtime：只包含 prelude 里出现的运算与 show（与 TypedCodegen 的 helper 同名/同义）。
dtRuntime : String
dtRuntime =
  "let bi_add a b = a + b\n"
    ++ "let bi_sub a b = a - b\n"
    ++ "let bi_mul a b = a * b\n"
    ++ "let bi_div a b = if b = 0 then failwith \"division by zero\" else a / b\n"
    ++ "let bi_eq_int (a : int) (b : int) = a = b\n"
    ++ "let bi_neq_int (a : int) (b : int) = a <> b\n"
    ++ "let bi_eq_str (a : string) (b : string) = a = b\n"
    ++ "let bi_neq_str (a : string) (b : string) = a <> b\n"
    ++ "let bi_eq_generic (a : 'a) (b : 'a) = a = b\n"
    ++ "let bi_neq_generic (a : 'a) (b : 'a) = a <> b\n"
    ++ "let bi_strFromInt (n : int) = string_of_int n\n"
    ++ "let bi_strLength (s : string) = String.length s\n"
    ++ "let bi_strUnpack (s : string) = List.init (String.length s) (fun i -> Char.code s.[i])\n"
    ++ "let bi_strPack (cs : int list) = String.init (List.length cs) (fun i -> Char.chr (List.nth cs i))\n"
    ++ "let bi_lt_int (a : int) (b : int) = a < b\n"
    ++ "let bi_le_int (a : int) (b : int) = a <= b\n"
    ++ "let bi_gt_int (a : int) (b : int) = a > b\n"
    ++ "let bi_ge_int (a : int) (b : int) = a >= b\n"
    ++ "let bi_lt_generic (a : 'a) (b : 'a) = compare a b < 0\n"
    ++ "let bi_le_generic (a : 'a) (b : 'a) = compare a b <= 0\n"
    ++ "let bi_gt_generic (a : 'a) (b : 'a) = compare a b > 0\n"
    ++ "let bi_ge_generic (a : 'a) (b : 'a) = compare a b >= 0\n"
    ++ "let bi_concat a b = a ^ b\n"
    ++ "let bi_and a b = a && b\n"
    ++ "let bi_or a b = a || b\n"
    ++ "let dt_show_bool b = if b then \"True\" else \"False\"\n"
    ++ "let dt_show_string s =\n"
    ++ "  let buf = Buffer.create 16 in\n"
    ++ "  Buffer.add_char buf (Char.chr 34);\n"
    ++ "  String.iter (fun c ->\n"
    ++ "    let n = Char.code c in\n"
    ++ "    if n = 34 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 34))\n"
    ++ "    else if n = 92 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 92))\n"
    ++ "    else if n = 10 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"n\")\n"
    ++ "    else if n = 9 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"t\")\n"
    ++ "    else if n = 13 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"r\")\n"
    ++ "    else Buffer.add_char buf c) s;\n"
    ++ "  Buffer.add_char buf (Char.chr 34);\n"
    ++ "  Buffer.contents buf\n"
    ++ dtPrimRuntime

-- M21：effectful 内建（`prim_*`）的 DT 运行时实现。
-- 签名在 `DtPrelude.preludeGlobals`（`prim_*` 只进 globals、不进 `preludeNames`），
-- 这里补 OCaml 侧实现；`prim_getArgs` / `prim_readLine` 在 Base.IO 里是**值**，
-- 所以在引用点展开成 `dtp_*(()`，与 HM `TypedCodegen` 的处理一致（每次求值都重新读）。
dtPrimRuntime : String
dtPrimRuntime =
  "let dtp_print s = print_string s; flush stdout; String.length s\n"
    ++ "let dtp_readFile path =\n  try\n    let ch = open_in_bin path in\n    Fun.protect ~finally:(fun () -> close_in_noerr ch)\n      (fun () -> really_input_string ch (in_channel_length ch))\n  with Sys_error msg -> failwith (\"readFile: \" ^ msg)\n"
    ++ "let dtp_writeFile path contents =\n  try\n    let ch = open_out_bin path in\n    Fun.protect ~finally:(fun () -> close_out_noerr ch)\n      (fun () -> output_string ch contents);\n    String.length contents\n  with Sys_error msg -> failwith (\"writeFile: \" ^ msg)\n"
    ++ "let dtp_getArgs () =\n  let argv = Sys.argv in\n  let n = Array.length argv in\n  if n <= 1 then [] else Array.to_list (Array.sub argv 1 (n - 1))\n"
    ++ "let dtp_readLine () = try input_line stdin with End_of_file -> \"\"\n"
    ++ "let dtp_readDir path =\n  try List.sort compare (Array.to_list (Sys.readdir path))\n  with Sys_error msg -> failwith (\"readDir: \" ^ msg)\n"
    ++ "let dtp_isDirectory path =\n  try Sys.is_directory path with Sys_error msg -> failwith (\"isDirectory: \" ^ msg)\n"
    ++ "let dtp_makeDir path =\n  try (if Sys.file_exists path then 0 else (Sys.mkdir path 0o755; 0))\n  with Sys_error msg -> failwith (\"makeDir: \" ^ msg)\n"
    ++ "let dtp_removeFile path =\n  try (if Sys.file_exists path then (Sys.remove path; 0) else 0)\n  with Sys_error msg -> failwith (\"removeFile: \" ^ msg)\n"
    ++ "let dtp_fileExists path = Sys.file_exists path\n"
    ++ "let dtp_fileMtime path =\n  try int_of_float (Unix.stat path).Unix.st_mtime with _ -> 0\n"
    ++ "let dtp_fileSize path =\n  try (Unix.stat path).Unix.st_size with _ -> 0\n"
    ++ "let dtp_exit n = exit n\n"
    ++ "let dtp_runIn dir args =\n  let quote s = Filename.quote s in\n  let cmd = String.concat \" \" (List.map quote args) in\n  let old = Sys.getcwd () in\n  Fun.protect ~finally:(fun () -> Sys.chdir old) (fun () -> Sys.chdir dir; Sys.command cmd)\n"

-- M19：`==` / `/=` 的跨类型特化（精化期已按实参类型重写成 `bi_eq_int` / `bi_eq_str`
-- 这类名字），以及 str* 内建。codegen 只做名字映射、不感知类型——M18.6 的
-- M22.2：`strUnpack` / `strPack` 的运行时桥接。
-- Core 的 `strUnpack` 语义是「OCaml int list」，而 DT 路径里 `List` 是程序自己声明的
-- 归纳族（`Base.List.List` 在 OCaml 里是变体类型 `t_Base_dList_dList`）。这两个 helper
-- 按实际族名生成，把 int list ↔ 族构造子互转；`globalRef` 把 `strUnpack`/`strPack`
-- 映射到它们（桥接只服务 Int 元素，与 prelude 签名 `List Int` 一致）。
dtListBridge : List DtData -> String
dtListBridge datas = case findListFamilyData datas of
  Nothing => ""
  Just dd => case findFamilyCtor "Nil" (dtDataCtors dd) of
    Nothing => ""
    Just nilC => case findFamilyCtor "Cons" (dtDataCtors dd) of
      Nothing => ""
      Just consC =>
        let
          famName = dtDataName dd
          nilMl = ctorOcamlName famName (dtCtorName nilC)
          consMl = ctorOcamlName famName (dtCtorName consC)
        in "\nlet dtp_unpack (s : string) =\n"
          ++ "  let cs = List.init (String.length s) (fun i -> Char.code s.[i]) in\n"
          ++ "  List.fold_right (fun x acc -> "
          ++ consMl
          ++ " (x, acc)) cs "
          ++ nilMl
          ++ "\n"
          ++ "let dtp_pack xs =\n"
          ++ "  let rec to_list xs = match xs with "
          ++ nilMl
          ++ " -> [] | "
          ++ consMl
          ++ " (x, rest) -> x :: to_list rest in\n"
          ++ "  let cs = to_list xs in\n"
          ++ "  String.init (List.length cs) (fun i -> Char.chr (List.nth cs i))\n"
          ++ "\nlet dtp_listOf xs = List.fold_right (fun x acc -> "
          ++ consMl
          ++ " (x, acc)) xs "
          ++ nilMl
          ++ "\n"
          ++ "let dtp_ocamlOf xs =\n"
          ++ "  let rec go l = match l with "
          ++ nilMl
          ++ " -> [] | "
          ++ consMl
          ++ " (x, rest) -> x :: go rest in\n"
          ++ "  go xs\n"

findFamilyCtor : String -> List DtCtor -> Maybe DtCtor
findFamilyCtor _ [] = Nothing
findFamilyCtor n (c :: rest) =
  if lastName (dtCtorName c) == n then Just c else findFamilyCtor n rest

findListFamilyData : List DtData -> Maybe DtData
findListFamilyData [] = Nothing
findListFamilyData (d :: rest) =
  if lastName (dtDataName d) == "List" then Just d else findListFamilyData rest

-- 「codegen 不感知判定来源」不被破坏。
globalRef : String -> Result String
globalRef name = case name of
  "True" => Ok "true"
  "False" => Ok "false"
  "+" => Ok "bi_add"
  "-" => Ok "bi_sub"
  "*" => Ok "bi_mul"
  "/" => Ok "bi_div"
  "==" => Ok "bi_eq_int"
  "/=" => Ok "bi_neq_int"
  "<" => Ok "bi_lt_int"
  "<=" => Ok "bi_le_int"
  ">" => Ok "bi_gt_int"
  ">=" => Ok "bi_ge_int"
  "++" => Ok "bi_concat"
  "&&" => Ok "bi_and"
  "||" => Ok "bi_or"
  "bi_eq_int" => Ok "bi_eq_int"
  "bi_neq_int" => Ok "bi_neq_int"
  "bi_eq_str" => Ok "bi_eq_str"
  "bi_neq_str" => Ok "bi_neq_str"
  "bi_eq_generic" => Ok "bi_eq_generic"
  "bi_neq_generic" => Ok "bi_neq_generic"
  "bi_lt_int" => Ok "bi_lt_int"
  "bi_le_int" => Ok "bi_le_int"
  "bi_gt_int" => Ok "bi_gt_int"
  "bi_ge_int" => Ok "bi_ge_int"
  "bi_lt_generic" => Ok "bi_lt_generic"
  "bi_le_generic" => Ok "bi_le_generic"
  "bi_gt_generic" => Ok "bi_gt_generic"
  "bi_ge_generic" => Ok "bi_ge_generic"
  "strFromInt" => Ok "bi_strFromInt"
  "strUnpack" => Ok "dtp_unpack"
  "strPack" => Ok "dtp_pack"
  "strLength" => Ok "bi_strLength"
  -- M23：效果内建的公开名与 `prim_*` 内部名都映射到同一组 `dtp_*` 运行时函数。
  "print" => Ok "dtp_print"
  "readFile" => Ok "dtp_readFile"
  "writeFile" => Ok "dtp_writeFile"
  "readDir" => Ok "(fun p -> dtp_listOf (dtp_readDir p))"
  "isDirectory" => Ok "dtp_isDirectory"
  "makeDir" => Ok "dtp_makeDir"
  "removeFile" => Ok "dtp_removeFile"
  "fileExists" => Ok "dtp_fileExists"
  "fileMtime" => Ok "dtp_fileMtime"
  "fileSize" => Ok "dtp_fileSize"
  "exit" => Ok "dtp_exit"
  "getArgs" => Ok "(dtp_listOf (dtp_getArgs ()))"
  "readLine" => Ok "(dtp_readLine ())"
  "prim_print" => Ok "dtp_print"
  "prim_readFile" => Ok "dtp_readFile"
  "prim_writeFile" => Ok "dtp_writeFile"
  "prim_readDir" => Ok "(fun p -> dtp_listOf (dtp_readDir p))"
  "prim_isDirectory" => Ok "dtp_isDirectory"
  "prim_makeDir" => Ok "dtp_makeDir"
  "prim_removeFile" => Ok "dtp_removeFile"
  "prim_fileExists" => Ok "dtp_fileExists"
  "prim_fileMtime" => Ok "dtp_fileMtime"
  "prim_fileSize" => Ok "dtp_fileSize"
  "prim_exit" => Ok "dtp_exit"
  "prim_runIn" => Ok "(fun dir args -> dtp_runIn dir (dtp_ocamlOf args))"
  "prim_getArgs" => Ok "(dtp_listOf (dtp_getArgs ()))"
  "prim_readLine" => Ok "(dtp_readLine ())"
  _ => Ok (valueName name)

-- 零参构造子（True/False 之外的 user 构造子）作为普通值引用时，OCaml 里就是裸构造子；
-- 但只有 datas 表知道它是构造子，所以生成入口先查构造子表，再回落到 globalRef。
--
-- M23：`strUnpack` / `strPack` 的映射依赖程序**有没有声明 List 族**：
--   - 有 List 族：走 `dtListBridge` 生成的 `dtp_unpack` / `dtp_pack`（int list ↔ 族构造子）；
--   - 没有 List 族（`run/10_string_pack` 这类单文件程序）：`List` 只是 prelude 签名里的
--     不透明类型，直接用 OCaml int list 的实现 `bi_strUnpack` / `bi_strPack`。
-- 旧实现无条件映射 `dtp_*`，没声明 List 族时那两个 helper 不生成 → 产物有未绑定名。
genGlobalRef : GenSt -> String -> Result (Pair String GenSt)
genGlobalRef st name = case lookupPair name (gsCtors st) of
  Just family => Ok (Pair (ctorOcamlName family name) st)
  Nothing =>
    if memName name (gsThunks st) then Ok (Pair ("(" ++ valueName name ++ " ())") st)
    else if name == "strUnpack" then if hasListFamily (gsFamilies st) then Ok (Pair "dtp_unpack" st) else Ok (Pair "bi_strUnpack" st)
    else if name == "strPack" then if hasListFamily (gsFamilies st) then Ok (Pair "dtp_pack" st) else Ok (Pair "bi_strPack" st)
    else andThen (globalRef name) (\r => Ok (Pair r st))

hasListFamily : List String -> Bool
hasListFamily [] = False
hasListFamily (f :: rest) = if lastName f == "List" then True else hasListFamily rest

-- ---------------------------------------------------------------
-- 变体类型声明（族 → OCaml type）
-- ---------------------------------------------------------------
--
-- 每个族生成 `type ('a0,...) t_F = ...`。类型参数按下面的规则分配（M21）：
--
--   * **族类型参数**（kind 里域是宇宙的参数，如 `List a` 的 `a`）：只有真正出现在
--     运行时字段类型里的才保留。递归出现 `Cons : a -> List a -> List a` 复用同一个
--     参数（渲染成 `'a0 * 'a0 t_List`），否则 `append` 这类递归定义会在 OCaml 里
--     统一出无限类型（occurs check）；
--   * **不透明字段**（函数类型 / Type / 其它静态没法命名的字段类型）：每个字段各占一个
--     **独立**类型参数。字典族的字段类型互不相同（`bind : m a -> (a -> m b) -> m b` /
--     `pure : a -> m a`），共用参数会把它们错误统一；异构 `Pair a b` 同理；
--   * **没被用到的族参数不生成**：`IO a` 的字段是函数 `Int -> a`（整体不透明），
--     所以 `IO` 的 OCaml 类型没有类型参数，也就不会在每个顶层 `IO` 值上留下
--     不可泛化的弱变量（旧实现里 `readFile "x"` 得到 `('a,_weak) t_IO` 直接报错）。
--
-- 「用到」的判定与字段渲染必须用同一张表，否则声明与实参位置会漂移。表用不动点计算
-- （族之间可互相引用）：初始全空，按渲染位置收集引用，单调增长到稳定。
typeParamName : Int -> String
typeParamName i = "'a" ++ strFromInt i

typeParamNames : Int -> List String
typeParamNames n = map typeParamName (range 0 n)

typeParamDecl : Int -> String
typeParamDecl 0 = ""
typeParamDecl n = case typeParamNames n of
  [only] => only ++ " "
  names => "(" ++ joinWith ", " names ++ ") "

-- kind 里的候选类型参数位置（域是宇宙的族参数）。
typeParamLevels : DtData -> List Int
typeParamLevels d = typeParamLevelsGo (dtDataParams d) 0

typeParamLevelsGo : List (Pair String Rig) -> Int -> List Int
typeParamLevelsGo [] i = []
typeParamLevelsGo (p :: rest) i =
  if rigIsErased (secondOf p) then i :: typeParamLevelsGo rest (i + 1)
  else typeParamLevelsGo rest (i + 1)

findDtData : String -> List DtData -> Maybe DtData
findDtData name [] = Nothing
findDtData name (d :: rest) = if dtDataName d == name then Just d else findDtData name rest

memInt : Int -> List Int -> Bool
memInt i [] = False
memInt i (x :: rest) = if x == i then True else memInt i rest

levelSlot : List Int -> Int -> Maybe Int
levelSlot levels lvl = levelSlotGo levels lvl 0

levelSlotGo : List Int -> Int -> Int -> Maybe Int
levelSlotGo [] lvl acc = Nothing
levelSlotGo (x :: rest) lvl acc = if x == lvl then Just acc else levelSlotGo rest lvl (acc + 1)

nthValue : List Value -> Int -> Maybe Value
nthValue [] i = Nothing
nthValue (v :: rest) i = if i <= 0 then Just v else nthValue rest (i - 1)

lookupUsed : List (Pair String (List Int)) -> String -> List Int
lookupUsed [] name = []
lookupUsed (p :: rest) name = if firstOf p == name then secondOf p else lookupUsed rest name

-- 收集「在渲染位置上」引用了当前族哪些候选类型参数。
-- 收集「在渲染位置上」引用了当前族哪些候选类型参数。
-- `lvl` 是当前到达的 binder 深度（给 Pi 的闭包喂 fresh var 用）。
collectUsedLevels : List Int -> List (Pair String (List Int)) -> List DtData -> Int -> Value -> List Int
collectUsedLevels tps table datas lvl v = case v of
  VPi name implicit rig dom clo =>
    if implicit then collectUsedLevels tps table datas (lvl + 1) (applyClosure clo (VNeutral (NVar name lvl [])))
    else append (collectUsedLevels tps table datas lvl dom)
      (collectUsedLevels tps table datas (lvl + 1) (applyClosure clo (VNeutral (NVar name lvl []))))
  VNeutral n => case n of
    NVar name lvl2 sp =>
      append (if memInt lvl2 tps then [lvl2] else []) (collectUsedSpine tps table datas lvl sp)
    NGlobal g sp => case findDtData g datas of
      Just gd => collectFamilyArgs tps table datas lvl (lookupUsed table g) sp
      Nothing => collectUsedSpine tps table datas lvl sp
  _ => []

collectUsedSpine : List Int -> List (Pair String (List Int)) -> List DtData -> Int -> List Value -> List Int
collectUsedSpine tps table datas lvl [] = []
collectUsedSpine tps table datas lvl (v :: rest) =
  append (collectUsedLevels tps table datas lvl v) (collectUsedSpine tps table datas lvl rest)

collectFamilyArgs : List Int -> List (Pair String (List Int)) -> List DtData -> Int -> List Int -> List Value -> List Int
collectFamilyArgs tps table datas lvl usedPats args = case usedPats of
  [] => []
  i :: rest => case nthValue args i of
    Just arg =>
      append (collectUsedLevels tps table datas lvl arg)
        (collectFamilyArgs tps table datas lvl rest args)
    Nothing => collectFamilyArgs tps table datas lvl rest args

ctorUsedLevels : List Int -> List (Pair String (List Int)) -> List DtData -> List (Pair String Rig) -> Int -> Value -> List Int
ctorUsedLevels tps table datas [] lvl v = []
ctorUsedLevels tps table datas ((Pair name rig) :: rest) lvl v = case v of
  VPi pname implicit _ dom clo =>
    let
      next = applyClosure clo (VNeutral (NVar pname lvl []))
    in if rigIsErased rig then ctorUsedLevels tps table datas rest (lvl + 1) next
    else append (collectUsedLevels tps table datas lvl dom)
      (ctorUsedLevels tps table datas rest (lvl + 1) next)
  _ => []

dataUsedLevels : DtData -> List (Pair String (List Int)) -> List DtData -> List Int
dataUsedLevels d table datas =
  let
    raw =
      concatMap
        (\c => ctorUsedLevels (typeParamLevels d) table datas (dtCtorTelescope c) 0 (eval [] (dtCtorType c)))
        (dtDataCtors d)
  in filter (\l => memInt l raw) (typeParamLevels d)

sameLevelTable : List (Pair String (List Int)) -> List (Pair String (List Int)) -> Bool
sameLevelTable [] [] = True
sameLevelTable (a :: rest) (b :: rest2) =
  if firstOf a == firstOf b && secondOf a == secondOf b then sameLevelTable rest rest2 else False
sameLevelTable _ _ = False

usedTableFix : List DtData -> List (Pair String (List Int)) -> List (Pair String (List Int))
usedTableFix datas table =
  let
    next = map (\d => Pair (dtDataName d) (dataUsedLevels d table datas)) datas
  in if sameLevelTable next table then next else usedTableFix datas next

-- 字段/类型实参渲染。
familyTyText : String -> List String -> String
familyTyText name [] = typeName name
familyTyText name ([a]) = a ++ " " ++ typeName name
familyTyText name args = "(" ++ joinWith ", " args ++ ") " ++ typeName name

renderFamilyArgs : List Int -> List (Pair String (List Int)) -> List DtData -> List Int -> List Value -> List String
renderFamilyArgs levels table datas usedPats args = case usedPats of
  [] => []
  i :: rest => case nthValue args i of
    Just arg =>
      renderTypeArg levels table datas arg :: renderFamilyArgs levels table datas rest args
    Nothing => renderFamilyArgs levels table datas rest args

renderTypeArg : List Int -> List (Pair String (List Int)) -> List DtData -> Value -> String
renderTypeArg levels table datas v = case v of
  VNeutral n => case n of
    NVar name lvl sp => case levelSlot levels lvl of
      Just s => typeParamName s
      Nothing => "unit"
    NGlobal g sp => case g of
      "Int" => "int"
      "String" => "string"
      "Bool" => "bool"
      _ => if lastName g == "Bool" then "bool"
      else case findDtData g datas of
        Just gd => familyTyText g (renderFamilyArgs levels table datas (lookupUsed table g) sp)
        Nothing => "unit"
  _ => "unit"

-- 单个字段的 OCaml 类型 + 下一个不透明参数槽。
-- 显式 Pi 字段（`(Int -> a)` 这类）**结构化渲染**：它把族参数（IO 的结果类型）带进
-- OCaml 类型，顶层值就不会留下弱类型变量。带隐式量词的 Pi（trait 方法签名，如
-- `bind : m a -> (a -> m b) -> m b`）整体不透明——方法级多态没法用 OCaml 类型表达。
renderPiTy : List Int -> List (Pair String (List Int)) -> List DtData -> Int -> Value -> String
renderPiTy levels table datas lvl v = case v of
  VPi name implicit rig dom clo =>
    let
      next = applyClosure clo (VNeutral (NVar name lvl []))
    in if rigIsErased rig then renderPiTy levels table datas (lvl + 1) next
    else "("
      ++ renderPiTy levels table datas lvl dom
      ++ ") -> "
      ++ renderPiTy levels table datas (lvl + 1) next
  _ => renderTypeArg levels table datas v

-- 单个字段的 OCaml 类型 + 下一个不透明参数槽。
renderFieldTy : List Int -> List (Pair String (List Int)) -> List DtData -> Int -> Value -> Int -> Pair String Int
renderFieldTy levels table datas lvl dom slot = case dom of
  VPi name implicit rig d clo =>
    if implicit then Pair (typeParamName slot) (slot + 1)
    else Pair (renderPiTy levels table datas lvl dom) slot
  VNeutral n => case n of
    NVar name lvl2 sp => case levelSlot levels lvl2 of
      Just s => Pair (typeParamName s) slot
      Nothing => Pair (typeParamName slot) (slot + 1)
    NGlobal g sp => case g of
      "Int" => Pair "int" slot
      "String" => Pair "string" slot
      "Bool" => Pair "bool" slot
      _ => case findDtData g datas of
        Just gd =>
          Pair (familyTyText g (renderFamilyArgs levels table datas (lookupUsed table g) sp)) slot
        Nothing => Pair (typeParamName slot) (slot + 1)
  _ => Pair (typeParamName slot) (slot + 1)

-- 构造子字段形状的**唯一真源**（M24.6 第一级）：从 telescope 的 rig 算出 keep flags
-- （True = 该 binder 进运行时表示）。类型声明、构造子应用、case 分支绑定三处都消费
-- 同一份 flags，并在使用点校验长度 / 擦除标志一致；三处各自 `if erased` 漂移会静默
-- 错编译（字段数、telescope 长度、绑定数三者没有交叉校验）。
ctorKeepFlags : DtCtor -> List Bool
ctorKeepFlags c = map (\b => not (rigIsErased (secondOf b))) (dtCtorTelescope c)

flagMatchesRig : Bool -> Rig -> Bool
flagMatchesRig keep rig = if keep then not (rigIsErased rig) else rigIsErased rig

ctorShapeOf : List DtData -> List (Pair String (List Bool))
ctorShapeOf [] = []
ctorShapeOf (d :: rest) =
  append (map (\c => Pair (dtCtorName c) (ctorKeepFlags c)) (dtDataCtors d)) (ctorShapeOf rest)

ctorFieldTexts : List Int -> List (Pair String (List Int)) -> List DtData -> List Bool -> List (Pair String Rig) -> Int -> Value -> Int -> Result (Pair (List String) Int)
ctorFieldTexts levels table datas keepFlags [] lvl v slot = Ok (Pair [] slot)
ctorFieldTexts levels table datas [] (_ :: _) lvl v slot =
  Err "DT: internal: constructor shape has more binders than its telescope"
ctorFieldTexts levels table datas (keep :: flags) ((Pair name rig) :: rest) lvl v slot = if flagMatchesRig keep rig then case v of
  VPi pname implicit _ dom clo =>
    let
      next = applyClosure clo (VNeutral (NVar pname lvl []))
    in if keep then case renderFieldTy levels table datas lvl dom slot of
      Pair text slot2 => andThen (ctorFieldTexts levels table datas flags rest (lvl + 1) next slot2) (\p => case p of
        Pair texts slot3 => Ok (Pair (text :: texts) slot3)
      )
    else ctorFieldTexts levels table datas flags rest (lvl + 1) next slot
  _ => Err "DT: internal: constructor telescope does not match its type"
else Err "DT: internal: constructor keep flag disagrees with telescope rig"

ctorArityNeed : List Int -> List (Pair String (List Int)) -> List DtData -> DtCtor -> Result Int
ctorArityNeed levels table datas c =
  andThen
    (ctorFieldTexts levels table datas (ctorKeepFlags c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (length levels))
    (\p => Ok (secondOf p - length levels))

dataArityNeed : List Int -> List (Pair String (List Int)) -> List DtData -> List DtCtor -> Result Int
dataArityNeed levels table datas ctors =
  andThen (traverse (ctorArityNeed levels table datas) ctors)
    (\ns => Ok (length levels + maxIntList ns))

maxIntList : List Int -> Int
maxIntList [] = 0
maxIntList (x :: rest) = if x >= maxIntList rest then x else maxIntList rest

ctorDeclText : String -> List String -> String
ctorDeclText name [] = name
ctorDeclText name ([t]) = name ++ " of " ++ parenOne t
ctorDeclText name ts = name ++ " of " ++ joinWith " * " (parenList ts)

parenList : List String -> List String
parenList [] = []
parenList (t :: rest) = append [parenOne t] (parenList rest)

parenOne : String -> String
parenOne t = "(" ++ t ++ ")"

genCtorDecl : List Int -> List (Pair String (List Int)) -> List DtData -> DtCtor -> Result String
genCtorDecl levels table datas c =
  andThen
    (ctorFieldTexts levels table datas (ctorKeepFlags c) (dtCtorTelescope c) 0 (eval [] (dtCtorType c)) (length levels))
    (\p => Ok (ctorDeclText (ctorOcamlName (dtCtorFamily c) (dtCtorName c)) (firstOf p)))

genDataDecl : List (Pair String (List Int)) -> List DtData -> DtData -> Result String
genDataDecl table datas d =
  let
    levels = lookupUsed table (dtDataName d)
  in andThen (dataArityNeed levels table datas (dtDataCtors d))
    (\arity => andThen (traverse (genCtorDecl levels table datas) (dtDataCtors d)) (\cs => Ok (typeParamDecl arity ++ typeName (dtDataName d) ++ " = " ++ ctorBodyText cs)))

ctorBodyText : List String -> String
ctorBodyText [] = "|"
ctorBodyText cs = joinWith " | " cs

genTypeDecls : List DtData -> Result String
genTypeDecls datas = case datas of
  [] => Ok ""
  _ =>
    let
      table = usedTableFix datas (map (\d => Pair (dtDataName d) []) datas)
    in andThen (traverse (genDataDecl table datas) datas)
      (\parts => Ok ("type " ++ joinWith "\nand " parts ++ "\n\n"))

-- 项 → OCaml
-- ---------------------------------------------------------------
--
-- 生成状态：族名表、构造子 → 族表、构造子形状表、fresh 变量计数、thunk 名表。
-- binder 环境是「最近绑定在前」的 (OCaml 变量名, 是否擦除)，TVar 靠 index 解析。
-- M24.6：`gsCtorShapes` 是构造子字段形状的唯一真源，构造子应用与 case 分支都按它
-- 校验/生成（见 `ctorKeepFlags`）。
data GenSt : Type where
  GenSt : List String -> List (Pair String String) -> List (Pair String (List Bool)) -> Int -> List String -> GenSt

gsCtors : GenSt -> List (Pair String String)
gsCtors (GenSt families ctors shapes next thunks) = ctors

gsCtorShapes : GenSt -> List (Pair String (List Bool))
gsCtorShapes (GenSt families ctors shapes next thunks) = shapes

-- 程序声明的族名表（`strUnpack` / `strPack` 的映射要看有没有 List 族）。
gsFamilies : GenSt -> List String
gsFamilies (GenSt families ctors shapes next thunks) = families

gsNext : GenSt -> Int
gsNext (GenSt families ctors shapes next thunks) = next

-- M23：零运行时参数的顶层定义要像 HM path 一样包成 thunk（`fun () -> body`），
-- 否则带效果的值定义（`help = let _ = print ... in 0`）会在模块初始化时就执行。
gsThunks : GenSt -> List String
gsThunks (GenSt families ctors shapes next thunks) = thunks

gsPutNext : GenSt -> Int -> GenSt
gsPutNext (GenSt families ctors shapes next thunks) n = GenSt families ctors shapes n thunks

ctorTableOfData : DtData -> List (Pair String String)
ctorTableOfData d = map (\c => Pair (dtCtorName c) (dtCtorFamily c)) (dtDataCtors d)

ctorTableOf : List DtData -> List (Pair String String)
ctorTableOf [] = []
ctorTableOf (d :: rest) = append (ctorTableOfData d) (ctorTableOf rest)

mkGenSt : List DtData -> List DtDef -> GenSt
mkGenSt datas defs =
  GenSt (map dtDataName datas) (ctorTableOf datas) (ctorShapeOf datas) 0 (thunkNames defs)

-- 运行时参数个数为 0 的定义（无 TLam 或只有擦除 TLam）→ thunk。
runtimeArity : Term -> Int
runtimeArity t = case t of
  TLam n r b => if rigIsErased r then runtimeArity b else 1 + runtimeArity b
  _ => 0

thunkNames : List DtDef -> List String
thunkNames defs = map (\d => dtDefName d) (filter thunkable defs)

thunkable : DtDef -> Bool
thunkable d = if dtDefName d == "main" then False else runtimeArity (dtDefBody d) == 0

-- M21：Bool 族不进运行时表示。`True` / `False` 与 `if` 统一是 OCaml bool
-- （Elab 把 Bool 族的构造子精化成 `TBool`），所以不生成变体类型与变体构造子，
-- 构造子表里也不放 Bool——引用会回落到 `globalRef` 的 `true` / `false`。
isBoolFamilyName : String -> Bool
isBoolFamilyName name = lastName name == "Bool"

runtimeDatas : List DtData -> List DtData
runtimeDatas datas = filter (\d => if isBoolFamilyName (dtDataName d) then False else True) datas

-- case 分支的绑定环境：全部 telescope binder 都进环境（擦除的用占位名 + True），
-- 顺序为 telescope 表面顺序的逆序；pattern 只保留未擦除的 fresh 名。
data AltEnv : Type where
  AltEnv : List (Pair String Rig) -> List String -> GenSt -> AltEnv

aeEnv : AltEnv -> List (Pair String Rig)
aeEnv (AltEnv env pats st) = env

aePats : AltEnv -> List String
aePats (AltEnv env pats st) = pats

aeSt : AltEnv -> GenSt
aeSt (AltEnv env pats st) = st

altEnvGo : GenSt -> List (Pair String Rig) -> List (Pair String Rig) -> List String -> AltEnv
altEnvGo st env [] pats = AltEnv env (reverse pats) st
altEnvGo st env ((Pair name rig) :: rest) pats = if rigIsErased rig then altEnvGo st (Pair "" Rig0 :: env) rest pats
else
  let
    fresh = gsNext st
    nm = "dtb__" ++ strFromInt fresh
  in altEnvGo (gsPutNext st (fresh + 1)) (Pair nm Rig1 :: env) rest (nm :: pats)

altEnv : GenSt -> List (Pair String Rig) -> List (Pair String Rig) -> AltEnv
altEnv st outer tele = altEnvGo st outer tele []

-- 构造子分支的绑定环境：按**构造子形状**（keep flags）决定哪些 telescope 位置进 pattern。
-- 与实参一样有两种合法约定：
--   1. **全 telescope**（普通 case：`caseAltBinders` 含擦除占位，body 的 de Bruijn index
--      按完整 telescope 数）；
--   2. **仅保留字段**（Elab 生成的字典投影分支：只绑方法字段，body index 按字段数）。
-- 按 binders 长度落在哪个口径选择，并逐位校验 rig 与形状一致。
altEnvChecked : GenSt -> String -> List (Pair String Rig) -> List (Pair String Rig) -> List Bool -> Result AltEnv
altEnvChecked st label outer binders flags =
  if length binders == length flags then altEnvFull st label outer binders flags []
  else if length binders == countKept flags then altEnvKept st label outer binders []
  else Err
    ("DT: internal: constructor " ++ label ++ ": case branch binder count matches neither full telescope nor kept fields")

countKept : List Bool -> Int
countKept [] = 0
countKept (k :: rest) = if k then 1 + countKept rest else countKept rest

altEnvFull : GenSt -> String -> List (Pair String Rig) -> List (Pair String Rig) -> List Bool -> List String -> Result AltEnv
altEnvFull st label outer binders flags pats = case binders of
  [] => case flags of
    [] => Ok (AltEnv outer (reverse pats) st)
    _ :: _ =>
      Err
        ("DT: internal: constructor " ++ label ++ ": case branch has fewer binders than its shape")
  (Pair name rig) :: rest => case flags of
    [] =>
      Err ("DT: internal: constructor " ++ label ++ ": case branch has more binders than its shape")
    keep :: flags2 => if flagMatchesRig keep rig then if keep then
      let
        fresh = gsNext st
        nm = "dtb__" ++ strFromInt fresh
      in altEnvFull (gsPutNext st (fresh + 1)) label (Pair nm Rig1 :: outer) rest flags2 (nm :: pats)
    else altEnvFull st label (Pair "" Rig0 :: outer) rest flags2 pats
    else Err
      ("DT: internal: constructor " ++ label ++ ": case branch binder rig disagrees with its shape")

altEnvKept : GenSt -> String -> List (Pair String Rig) -> List (Pair String Rig) -> List String -> Result AltEnv
altEnvKept st label outer [] pats = Ok (AltEnv outer (reverse pats) st)
altEnvKept st label outer ((Pair name rig) :: rest) pats = if rigIsErased rig then Err ("DT: internal: constructor " ++ label ++ ": kept-field branch has an erased binder")
else
  let
    fresh = gsNext st
    nm = "dtb__" ++ strFromInt fresh
  in altEnvKept (gsPutNext st (fresh + 1)) label (Pair nm Rig1 :: outer) rest (nm :: pats)

genTerm : GenSt -> List (Pair String Rig) -> Term -> Result (Pair String GenSt)
genTerm st binders t = case t of
  TVar name i => case binderAt i binders of
    Just (Pair oc rig) =>
      if rigIsErased rig then Err ("DT: type-level binding `" ++ name ++ "` is used at runtime (M13 limitation)")
      else Ok (Pair oc st)
    Nothing => Err "DT: internal: unbound runtime variable"
  TGlobal name => genGlobalRef st name
  TInt n => Ok (Pair (strFromInt n) st)
  TStr s => Ok (Pair (ocamlString s) st)
  TBool b => Ok (Pair (boolText b) st)
  TIf c th el => andThen (genTerm st binders c) (\pc => case pc of
    Pair gc st1 => andThen (genTerm st1 binders th) (\pt => case pt of
      Pair gt st2 => andThen (genTerm st2 binders el) (\pe => case pe of
        Pair ge st3 => Ok (Pair ("(if " ++ gc ++ " then " ++ gt ++ " else " ++ ge ++ ")") st3)
      )
    )
  )
  TLam name rig body => genTermLam st binders name rig body
  TApp f a rig => genApp st binders f a rig
  TCon c args => genConApp st binders c args
  TCase scrut alts => genCase st binders scrut alts
  TPi name implicit rig dom cod => Err "DT: a type is used at runtime (M13 limitation)"
  TType l => Err "DT: a type is used at runtime (M13 limitation)"
  TMeta m => Err ("DT: unsolved metavariable in runtime code" ++ showMetaHint m)

-- M24.6：lambda binder 是唯一直接写裸标识符的地方（值/类型/构造子名都有 v_/t_/C_ 前缀，
-- 不会撞 OCaml 保留字）。vuna 允许 `method` / `type` 一类标识符，OCaml 不允许，这里统一
-- 加后缀 `_` 转义，保证「能 check 就能 compile」。
ocamlReservedWords : List String
ocamlReservedWords =
  [ "and",
    "as",
    "assert",
    "asr",
    "begin",
    "class",
    "constraint",
    "do",
    "done",
    "downto",
    "else",
    "end",
    "exception",
    "external",
    "false",
    "for",
    "fun",
    "function",
    "functor",
    "if",
    "in",
    "include",
    "inherit",
    "initializer",
    "land",
    "lazy",
    "let",
    "lor",
    "lsl",
    "lsr",
    "lxor",
    "match",
    "method",
    "mod",
    "module",
    "mutable",
    "new",
    "nonrec",
    "object",
    "of",
    "open",
    "or",
    "private",
    "rec",
    "sig",
    "struct",
    "then",
    "to",
    "true",
    "try",
    "type",
    "val",
    "virtual",
    "when",
    "while",
    "with"
  ]

ocamlBinderName : String -> String
ocamlBinderName name =
  let
    oc = sanitizeName name
  in if memName oc ocamlReservedWords then oc ++ "_" else oc

genTermLam : GenSt -> List (Pair String Rig) -> String -> Rig -> Term -> Result (Pair String GenSt)
genTermLam st binders name rig body = if rigIsErased rig then andThen (genTerm st (Pair "" Rig0 :: binders) body) (\p => case p of
  Pair b st2 => Ok (Pair b st2)
)
else
  let
    ocName = ocamlBinderName name
  in andThen (genTerm st (Pair ocName Rig1 :: binders) body) (\p => case p of
    Pair b st2 => Ok (Pair ("(fun " ++ ocName ++ " -> " ++ b ++ ")") st2)
  )

-- 应用：精化器可能把饱和的构造子应用表示成嵌套 `TApp (TApp (TCon c []) a) b`。
-- 这种形态必须先折叠成 `TCon c [a, b]`，否则 OCaml 侧会把它当成 curried 调用
-- （多变体构造子是 tupled 的，`C 1 2` 类型不对）。
genApp : GenSt -> List (Pair String Rig) -> Term -> Term -> Rig -> Result (Pair String GenSt)
genApp st binders f a rig = if rigIsErased rig then genTerm st binders f
else case flattenConApp (TApp f a rig) of
  Just (Pair c args) => genConApp st binders c args
  Nothing => andThen (genTerm st binders f) (\pf => case pf of
    Pair fs st1 => andThen (genTerm st1 binders a) (\pa => case pa of
      Pair at st2 => Ok (Pair ("(" ++ fs ++ " " ++ at ++ ")") st2)
    )
  )

-- OCaml 的多参变体构造子是 **tupled**（`C of t1 * t2` 写作 `C (a, b)`），
-- 不是 curried，所以多实参必须用逗号包成一个元组。
conAppText : String -> List String -> String
conAppText name [] = name
conAppText name ([a]) = "(" ++ name ++ " (" ++ a ++ "))"
conAppText name args = "(" ++ name ++ " (" ++ joinWith ", " args ++ "))"

-- 构造子实参对齐（M24.6 第一级）：TCon 的实参有两种合法约定：
--   1. **全 telescope**（含擦除位，普通构造子经 `inferArgs` 插入隐式后如此）；
--   2. **仅保留字段**（字典构造子 `MkDict_C` 只带方法实现，省略擦除的类参数）。
-- 两种都按 shape 归一成「运行时实参列表」（全部非擦除），供 `genConArgs` 生成。
alignCtorArgs : String -> List Bool -> List (Pair Term Rig) -> Result (List (Pair Term Rig))
alignCtorArgs label [] [] = Ok []
alignCtorArgs label [] (_ :: _) =
  Err ("DT: internal: constructor " ++ label ++ ": application has more arguments than its shape")
alignCtorArgs label (keep :: flags) [] =
  if keep then Err ("DT: internal: constructor " ++ label ++ ": application has fewer arguments than its shape")
  else alignCtorArgs label flags []
alignCtorArgs label (keep :: flags) ((Pair arg rig) :: rest) =
  if keep then if rigIsErased rig then Err ("DT: internal: constructor " ++ label ++ ": runtime field marked erased")
  else andThen (alignCtorArgs label flags rest) (\ts => Ok (Pair arg rig :: ts))
  else if rigIsErased rig then alignCtorArgs label flags rest
  else alignCtorArgs label flags (Pair arg rig :: rest)

genConArgs : GenSt -> List (Pair String Rig) -> List (Pair Term Rig) -> Result (Pair (List String) GenSt)
genConArgs st binders [] = Ok (Pair [] st)
genConArgs st binders ((Pair arg rig) :: rest) = andThen (genTerm st binders arg) (\p => case p of
  Pair text st2 => andThen (genConArgs st2 binders rest) (\q => case q of
    Pair texts st3 => Ok (Pair (text :: texts) st3)
  )
)

genConApp : GenSt -> List (Pair String Rig) -> String -> List (Pair Term Rig) -> Result (Pair String GenSt)
genConApp st binders c args = case lookupPair c (gsCtors st) of
  Nothing => Err ("DT: internal: unknown constructor " ++ c)
  Just family => case lookupPair c (gsCtorShapes st) of
    Nothing => Err ("DT: internal: no shape for constructor " ++ c)
    Just flags => andThen (alignCtorArgs c flags args) (\runtimeArgs => andThen (genConArgs st binders runtimeArgs) (\p => case p of
      Pair argTexts st2 => Ok (Pair (conAppText (ctorOcamlName family c) argTexts) st2)
    )
    )

hasFallbackAlt : List CaseAlt -> Bool
hasFallbackAlt [] = False
hasFallbackAlt (alt :: rest) = if caseAltName alt == "" then True else hasFallbackAlt rest

armPatternText : String -> List String -> String
armPatternText cname [] = cname
armPatternText cname pats = cname ++ " (" ++ joinWith ", " pats ++ ")"

genArm : GenSt -> List (Pair String Rig) -> CaseAlt -> Result (Pair String GenSt)
genArm st outer alt = if caseAltName alt == "" then
  let
    bound = altEnv st outer (caseAltBinders alt)
    patText = case aePats bound of
      [] => "_"
      p :: rest => p
  in andThen (genTerm (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
    Pair b st2 => Ok (Pair ("  | " ++ patText ++ " -> " ++ b ++ "\n") st2)
  )
else case lookupPair (caseAltName alt) (gsCtors st) of
  Nothing => Err ("DT: internal: unknown constructor " ++ caseAltName alt)
  Just family => case lookupPair (caseAltName alt) (gsCtorShapes st) of
    Nothing => Err ("DT: internal: no shape for constructor " ++ caseAltName alt)
    Just flags => andThen (altEnvChecked st (caseAltName alt) outer (caseAltBinders alt) flags) (\bound => andThen (genTerm (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
      Pair b st2 =>
        let
          cname = ctorOcamlName family (caseAltName alt)
          patText = armPatternText cname (aePats bound)
        in Ok (Pair ("  | " ++ patText ++ " -> " ++ b ++ "\n") st2)
    )
    )

genArms : GenSt -> List (Pair String Rig) -> List CaseAlt -> Result (Pair String GenSt)
genArms st binders [] = Ok (Pair "" st)
genArms st binders (alt :: rest) = andThen (genArm st binders alt) (\p => case p of
  Pair arm st2 => andThen (genArms st2 binders rest) (\q => case q of
    Pair arms st3 => Ok (Pair (arm ++ arms) st3)
  )
)

genCase : GenSt -> List (Pair String Rig) -> Term -> List CaseAlt -> Result (Pair String GenSt)
genCase st binders scrut alts = andThen (genTerm st binders scrut) (\p => case p of
  Pair scrutText st1 => andThen (genArms st1 binders alts) (\q => case q of
    Pair arms st2 =>
      let
        fallback =
          if hasFallbackAlt alts then "" else "  | _ -> failwith \"DT: impossible branch\"\n"
      in Ok (Pair ("(match " ++ scrutText ++ " with\n" ++ arms ++ fallback ++ ")") st2)
  )
)

-- ---------------------------------------------------------------
-- 分组 → OCaml 定义
-- ---------------------------------------------------------------
joinWith : String -> List String -> String
joinWith sep [] = ""
joinWith sep ([x]) = x
joinWith sep (x :: rest) = x ++ sep ++ joinWith sep rest

genGroupDef : GenSt -> DtDef -> Result (Pair String GenSt)
genGroupDef st d = andThen (genTerm st [] (dtDefBody d)) (\p => case p of
  Pair body st2 =>
    Ok
      (Pair (valueName (dtDefName d) ++ " = " ++ (if memName (dtDefName d) (gsThunks st) then "fun () -> " else "") ++ body) st2)
)

genGroupBodies : GenSt -> List DtDef -> Result (Pair (List String) GenSt)
genGroupBodies st [] = Ok (Pair [] st)
genGroupBodies st (d :: rest) = andThen (genGroupDef st d) (\p => case p of
  Pair def st2 => andThen (genGroupBodies st2 rest) (\q => case q of
    Pair defs st3 => Ok (Pair (def :: defs) st3)
  )
)

-- 单函数 SCC 且不引用自身时用 let；多函数 SCC（互递归）或自递归才用 let rec。
groupNeedsRec : List (Pair String (List String)) -> List DtDef -> Bool
groupNeedsRec adj [] = False
groupNeedsRec adj ([d]) = memName (dtDefName d) (neighborsOf adj (dtDefName d))
groupNeedsRec adj group = True

genGroup : List (Pair String (List String)) -> GenSt -> List DtDef -> Result (Pair String GenSt)
genGroup adj st group = andThen (genGroupBodies st group) (\p => case p of
  Pair defs st2 =>
    Ok
      (Pair ((if groupNeedsRec adj group then "let rec " else "let ") ++ joinWith "\nand " defs) st2)
)

genGroups : List (Pair String (List String)) -> GenSt -> List (List DtDef) -> Result (Pair (List String) GenSt)
genGroups adj st [] = Ok (Pair [] st)
genGroups adj st (g :: rest) = andThen (genGroup adj st g) (\p => case p of
  Pair text st2 => andThen (genGroups adj st2 rest) (\q => case q of
    Pair texts st3 => Ok (Pair (text :: texts) st3)
  )
)

-- main 的展示方式（类型 force 后必须是 Int/String/Bool）。
-- 按族**短名**识别：Bool 的权威定义是 `Base.Bool.Bool`，也接受单文件 `data Bool`。
mainShow : List (Pair String Term) -> Term -> Result (Pair String String)
mainShow table tyTerm = case force table [] defaultFuel (eval [] tyTerm) of
  VNeutral n => case n of
    NGlobal g [] => mainShowForName g
    _ => mainShowErr
  _ => mainShowErr

-- M21：main : IO a 的执行（对齐 HM ioRunExpr）。先归约 main 到 IO 构造子
-- （`MkIO f`），再对世界令牌 0 应用 `f 0` 并继续归约。IO 的识别按 main 的
-- **类型**（族名 `IO`，含 `Base.IO.IO` 这类带模块前缀的名字）。
lastName : String -> String
lastName name = case splitLastDot (splitOnDot name) of
  Pair rev base => base

-- 把 `IO a` 拆成内层类型 `a`；不是 `IO ...` 则 Nothing。
ioResultTy : Term -> Maybe Term
ioResultTy t = case t of
  TApp fn arg _ => case fn of
    TGlobal g => if lastName g == "IO" then Just arg else Nothing
    _ => Nothing
  _ => Nothing

-- 找 IO 族的（族名, 构造子名），用于生成 `match main with C_IO_MkIO f -> f 0`。
ioCtorOf : List DtData -> Maybe (Pair String String)
ioCtorOf [] = Nothing
ioCtorOf (d :: rest) = if lastName (dtDataName d) == "IO" then firstCtorOf d else ioCtorOf rest

firstCtorOf : DtData -> Maybe (Pair String String)
firstCtorOf d = case dtDataCtors d of
  c :: _ => Just (Pair (dtDataName d) (dtCtorName c))
  [] => Nothing

mainShowForName : String -> Result (Pair String String)
mainShowForName g = case lastName g of
  "Int" => Ok (Pair "string_of_int" "int")
  "String" => Ok (Pair "dt_show_string" "string")
  "Bool" => Ok (Pair "dt_show_bool" "bool")
  _ => mainShowErr

mainShowErr : Result (Pair String String)
mainShowErr = Err "DT: main must return Int, String or Bool (M13 limitation)"

-- 生成主体（不含 main 钩子）：类型声明 + 按 SCC 顺序的函数定义。
-- check / compile 共用这一份，保证两者的判定完全一致。
genProgramBody : Pair (List DtData) (List DtDef) -> Result (Pair String (Pair (List DtDef) (List (Pair String Term))))
genProgramBody program =
  let
    datas = firstOf program
    defs = secondOf program
  in andThen (prepareDtProgram program) (\p => case p of
    Pair runtime groups => andThen (genTypeDecls (runtimeDatas datas)) (\typeText => andThen (genGroups (depAdjacency runtime) (mkGenSt (runtimeDatas datas) runtime) groups) (\q => case q of
      Pair bodies st2 =>
        Ok
          (Pair (dtRuntime ++ "\n" ++ typeText ++ dtListBridge datas ++ joinWith "\n\n" bodies) (Pair runtime (defTable defs)))
    )
    )
  )

generateDtProgram : Pair (List DtData) (List DtDef) -> Bool -> Result String
generateDtProgram program printResult = andThen (genProgramBody program) (\p => case p of
  Pair bodyText (Pair runtime table) => case findDtDef "main" runtime of
    Nothing => Err "DT: no main definition"
    Just mainDef =>
      let
        mainTy = dtDefType mainDef
        mainRef = valueName "main"
      in case ioResultTy mainTy of
        Just innerTy => genDtHook bodyText table innerTy (ioRunText program mainRef) printResult
        Nothing => genDtHook bodyText table mainTy mainRef printResult
)

-- main 钩子：`mainExpr` 是运行时求 main 值的表达式（普通 main 直接是 `v_main`；
-- main : IO a 则是 `match v_main with C_IO_MkIO f -> f 0`），按类型 `tyTerm` 选展示函数。
genDtHook : String -> List (Pair String Term) -> Term -> String -> Bool -> Result String
genDtHook bodyText table tyTerm mainExpr printResult = andThen (mainShow table tyTerm) (\showPair => case showPair of
  Pair showFn kind =>
    let
      hook =
        if printResult then "let () = print_endline (" ++ showFn ++ " (" ++ mainExpr ++ "))\n"
        else "let () = ignore (" ++ mainExpr ++ ")\n"
    in Ok (bodyText ++ "\n" ++ hook)
)

-- `match v_main with C_IO_MkIO f -> f 0`（找不到 IO 构造子时回退为原样引用）。
ioRunText : Pair (List DtData) (List DtDef) -> String -> String
ioRunText program mainRef = case ioCtorOf (firstOf program) of
  Just (Pair family ctor) =>
    "match " ++ mainRef ++ " with " ++ ctorOcamlName family ctor ++ " f -> f 0"

-- `vuna check --dt` 跑一遍完整生成主体（丢弃产物），保证「能 check 就能 compile」：
-- 擦除检查、构造子引用、SCC 分组、类型声明与函数生成都在这一步走到。
-- main 的存在与返回类型只在 generate 阶段要求，这样没有 main 的库文件也能 check。
checkDtProgram : Pair (List DtData) (List DtDef) -> Result Int
checkDtProgram program = andThen (genProgramBody program) (\_ => Ok 0)

-- ===============================================================
-- M24：逐模块 split 生成（`build --split` / `seed` 的输出模型）
-- ===============================================================
--
-- 单文件路径（`generateDtProgram`）保持不变；split 把同一份精化结果按「声明归属」
-- 切到各模块文件。与 HM split 的差异：
--   * 不生成 `.mli`：seed 只保留 `.ml` + `build.sh`；
--   * 内建 Show/Eq/Ord 的字典类型、内建实例与投影集中在 `Vuna_builtins.ml`；
--   * List 族的 int↔族桥接跟在声明 List 的模块末尾（后续模块 open 后即可用）。
-- 跨模块引用靠「全局唯一 OCaml 名字 + open 链」，因此文件顺序即依赖顺序。
splitNoSpan : Span
splitNoSpan = Span "" 0 0 0 0

entryOwner : String
entryOwner = "Main"

builtinOwner : String
builtinOwner = "Vuna_builtins"

runtimeUnit : String
runtimeUnit = "Vuna_runtime"

builtinUnit : String
builtinUnit = "Vuna_builtins"

splitUnitOfModule : String -> String
splitUnitOfModule modName = sanitizeName modName

-- 内建类（DtDerive/DtPrelude 生成）的名字与方法投影名。源码 trait 的方法投影在
-- Loader 处理后带模块前缀（`Base.Monad.fmap`），所以这里只需要覆盖内建类。
builtinClassNames : List String
builtinClassNames = ["Show", "Eq", "Ord"]

builtinMethodNames : List String
builtinMethodNames = ["show", "eq", "neq", "lt", "le", "gt", "ge"]

isBuiltinClassName : String -> Bool
isBuiltinClassName n = memName n builtinClassNames

isBuiltinInstanceName : String -> Bool
isBuiltinInstanceName n =
  startsWith "Show_Show_" n || startsWith "Eq_Eq_" n || startsWith "Ord_Ord_" n

-- ---------------------------------------------------------------
-- 实例/派生实例名（与 Elab.instanceName 同步；M24 收尾时改用 Elab 导出）
-- ---------------------------------------------------------------
splitInstanceName : String -> Maybe String -> Expr -> String
splitInstanceName cname mname headExpr = case mname of
  Nothing => cname ++ "_" ++ splitDerivedInstName headExpr
  Just n =>
    if splitAnonInstName n then splitInstPrefixOf n ++ cname ++ "_" ++ splitDerivedInstName headExpr
    else n

splitAnonInstName : String -> Bool
splitAnonInstName name = case splitLastDot (splitOnDot name) of
  Pair rev base => startsWith "#" base

splitInstPrefixOf : String -> String
splitInstPrefixOf name = case splitLastDot (splitOnDot name) of
  Pair rev base => if rev == [] then "" else joinDots rev ++ "."

splitDerivedInstName : Expr -> String
splitDerivedInstName e = case e of
  EApp fn args sp => case fn of
    EVar n fsp => n ++ splitArgSuffix args
    _ => "Inst"
  EVar n sp => n
  _ => "Inst"

splitArgSuffix : List Expr -> String
splitArgSuffix [] = ""
splitArgSuffix (a :: rest) = "_" ++ splitExprNameFor a ++ splitArgSuffix rest

splitExprNameFor : Expr -> String
splitExprNameFor e = case e of
  EVar n sp => n
  EInt n sp => strFromInt n
  EStr s sp => s
  _ => "X"

headClassName : Expr -> Maybe String
headClassName e = case e of
  EApp fn args sp => case fn of
    EVar n fsp => Just n
    _ => Nothing
  EVar n sp => Just n
  _ => Nothing

modulePrefixOfName : String -> String
modulePrefixOfName name = case splitLastDot (splitOnDot name) of
  Pair rev base => joinDots rev

-- ---------------------------------------------------------------
-- 归属表：声明名 → 模块，实例名 → 模块，数据类型名 → 模块
-- ---------------------------------------------------------------
splitDeclNames : List Decl -> List String
splitDeclNames [] = []
splitDeclNames (d :: rest) = case d of
  DSig name ty sp => name :: splitDeclNames rest
  DFun name pats body sp => name :: splitDeclNames rest
  DData name params kind ctors derivings sp => name :: splitDeclNames rest
  DRecord name params fields derivings sp => name :: splitDeclNames rest
  DTrait name params methods sp => name :: splitDeclNames rest
  _ => splitDeclNames rest

splitDataNames : List Decl -> List String
splitDataNames [] = []
splitDataNames (d :: rest) = case d of
  DData name params kind ctors derivings sp => name :: splitDataNames rest
  DRecord name params fields derivings sp => name :: splitDataNames rest
  _ => splitDataNames rest

splitInstanceOwnerOf : String -> Decl -> List (Pair String String)
splitInstanceOwnerOf owner d = case d of
  DInstance mname isDefault headExpr methods sp => case headClassName headExpr of
    Just c => [Pair (splitInstanceName c mname headExpr) owner]
    Nothing => []
  DData dname params kind ctors derivings sp => splitDerivedOwners owner dname params derivings
  DRecord dname params fields derivings sp => splitDerivedOwners owner dname params derivings
  _ => []

splitDerivedOwners : String -> String -> List String -> List String -> List (Pair String String)
splitDerivedOwners owner dname params [] = []
splitDerivedOwners owner dname params (t :: rest) =
  let
    headExpr =
      EApp (EVar t splitNoSpan) (EVar dname splitNoSpan :: map (\p => EVar p splitNoSpan) params)
        splitNoSpan
  in Pair (splitInstanceName t Nothing headExpr) owner :: splitDerivedOwners owner dname params rest

splitInstanceOwnersGo : String -> List Decl -> List (Pair String String)
splitInstanceOwnersGo owner [] = []
splitInstanceOwnersGo owner (d :: rest) =
  append (splitInstanceOwnerOf owner d) (splitInstanceOwnersGo owner rest)

splitOwnerEntriesOfModules : List (Pair String (List Decl)) -> List (Pair String String)
splitOwnerEntriesOfModules [] = []
splitOwnerEntriesOfModules ((Pair mname decls) :: rest) =
  append (map (\n => Pair n mname) (splitDeclNames decls))
    (append (splitInstanceOwnersGo mname decls) (splitOwnerEntriesOfModules rest))

splitDataOwnerEntriesOfModules : List (Pair String (List Decl)) -> List (Pair String String)
splitDataOwnerEntriesOfModules [] = []
splitDataOwnerEntriesOfModules ((Pair mname decls) :: rest) =
  append (map (\n => Pair n mname) (splitDataNames decls)) (splitDataOwnerEntriesOfModules rest)

-- 内建字典类型的类名：`Dict_Show` → Just "Show"；`Dict_Base.Monad.Monad` → Just "Base.Monad.Monad"。
splitDictClass : String -> Maybe String
splitDictClass name =
  if startsWith "Dict_" name then Just (substring 5 (strLength name - 5) name) else Nothing

lookupModuleOf : List (Pair String String) -> String -> Maybe String
lookupModuleOf pairs name = lookupPair name pairs

knownModuleOrErr : List String -> String -> String -> Result String
knownModuleOrErr knownModules what name =
  let
    prefix = modulePrefixOfName name
  in if memName prefix knownModules then Ok prefix
  else Err
    ("DT split: `" ++ what ++ "` " ++ name ++ " has module prefix `" ++ prefix ++ "` but no such module")

splitDataOwnerOf : List (Pair String String) -> List String -> List String -> DtData -> Result String
splitDataOwnerOf dataOwners knownModules entryDataNames d = case lookupModuleOf dataOwners (dtDataName d) of
  Just o => Ok o
  Nothing => case splitDictClass (dtDataName d) of
    Just cls =>
      if isBuiltinClassName cls then Ok builtinOwner else knownModuleOrErr knownModules "data" cls
    Nothing =>
      if containsDot (dtDataName d) then knownModuleOrErr knownModules "data" (dtDataName d)
      else if memName (dtDataName d) entryDataNames then Ok entryOwner
      else Err ("DT split: cannot determine module for data `" ++ dtDataName d ++ "`")

-- 派生实例名以 `Show_Show_<data>` / `Eq_Eq_<data>` / `Ord_Ord_<data>` 开头，按数据类型反查归属。
splitDerivedOwnerOf : List (Pair String String) -> String -> Maybe String
splitDerivedOwnerOf [] name = Nothing
splitDerivedOwnerOf ((Pair dname owner) :: rest) name =
  if startsWith ("Show_Show_" ++ dname) name then Just owner
  else if startsWith ("Eq_Eq_" ++ dname) name then Just owner
  else if startsWith ("Ord_Ord_" ++ dname) name then Just owner else splitDerivedOwnerOf rest name

splitDefOwnerOf : List (Pair String String) -> List (Pair String String) -> List String -> List String -> String -> Result String
splitDefOwnerOf defOwners dataOwners knownModules entryNames name = case lookupModuleOf defOwners name of
  Just o => Ok o
  Nothing => if memName name builtinMethodNames then Ok builtinOwner
  else case splitDerivedOwnerOf dataOwners name of
    Just o => Ok o
    Nothing =>
      if containsDot name then knownModuleOrErr knownModules "definition" name
      else if memName name entryNames then Ok entryOwner
      else if isBuiltinInstanceName name then Ok builtinOwner
      else Err ("DT split: cannot determine module for definition `" ++ name ++ "`")

-- ---------------------------------------------------------------
-- 按归属过滤 + 生成
-- ---------------------------------------------------------------
data SplitMeta : Type where
  SplitMeta : List (Pair String String) -> List (Pair String String) -> List String -> List String -> SplitMeta

smDefOwners : SplitMeta -> List (Pair String String)
smDefOwners (SplitMeta defOwners dataOwners knownModules entryNames) = defOwners

smDataOwners : SplitMeta -> List (Pair String String)
smDataOwners (SplitMeta defOwners dataOwners knownModules entryNames) = dataOwners

smKnownModules : SplitMeta -> List String
smKnownModules (SplitMeta defOwners dataOwners knownModules entryNames) = knownModules

smEntryNames : SplitMeta -> List String
smEntryNames (SplitMeta defOwners dataOwners knownModules entryNames) = entryNames

splitMetaOf : List (Pair String (List Decl)) -> List Decl -> SplitMeta
splitMetaOf modules entryDecls =
  let
    knownModules = map (\p => firstOf p) modules
    entryNames = splitDeclNames entryDecls
    defOwners =
      append (splitOwnerEntriesOfModules modules)
        (append (map (\n => Pair n entryOwner) entryNames) (splitInstanceOwnersGo entryOwner entryDecls))
    dataOwners =
      append (splitDataOwnerEntriesOfModules modules)
        (map (\n => Pair n entryOwner) (splitDataNames entryDecls))
  in SplitMeta defOwners dataOwners knownModules entryNames

nameOwnerPairsOfDefs : SplitMeta -> List DtDef -> Result (List (Pair String String))
nameOwnerPairsOfDefs meta [] = Ok []
nameOwnerPairsOfDefs meta (d :: rest) =
  andThen
    (splitDefOwnerOf (smDefOwners meta) (smDataOwners meta) (smKnownModules meta) (smEntryNames meta) (dtDefName d))
    (\o => andThen (nameOwnerPairsOfDefs meta rest) (\ps => Ok (Pair (dtDefName d) o :: ps)))

nameOwnerPairsOfDatas : SplitMeta -> List DtData -> Result (List (Pair String String))
nameOwnerPairsOfDatas meta [] = Ok []
nameOwnerPairsOfDatas meta (d :: rest) =
  andThen (splitDataOwnerOf (smDataOwners meta) (smKnownModules meta) (smEntryNames meta) d)
    (\o => andThen (nameOwnerPairsOfDatas meta rest) (\ps => Ok (Pair (dtDataName d) o :: ps)))

mapOwnerOf : List (Pair String String) -> String -> String
mapOwnerOf [] name = ""
mapOwnerOf ((Pair n o) :: rest) name = if n == name then o else mapOwnerOf rest name

datasInUnit : List (Pair String String) -> String -> List DtData -> List DtData
datasInUnit pairs u datas = filter (\d => mapOwnerOf pairs (dtDataName d) == u) datas

defsInUnit : List (Pair String String) -> String -> List DtDef -> List DtDef
defsInUnit pairs u defs = filter (\d => mapOwnerOf pairs (dtDefName d) == u) defs

openHeader : List String -> String
openHeader [] = ""
openHeader (u :: rest) = "open " ++ u ++ "\n" ++ openHeader rest

-- 类型声明：`allDatas` 用于族间参数推断（跨模块字段类型照旧渲染成全局类型名），
-- `subset` 是实际写进本文件的族。
genTypeDeclsOf : List DtData -> List DtData -> Result String
genTypeDeclsOf allDatas subset = case subset of
  [] => Ok ""
  _ =>
    let
      table = usedTableFix allDatas (map (\d => Pair (dtDataName d) []) allDatas)
    in andThen (traverse (genDataDecl table allDatas) subset)
      (\parts => Ok ("type " ++ joinWith "\nand " parts ++ "\n\n"))

-- 单个文件的正文：open 链 + 类型 + 桥接（仅声明 List 的模块）+ 运行时定义。
splitUnitText : List DtData -> List DtDef -> List DtData -> List DtDef -> String -> List String -> Result String
splitUnitText allDatas allDefs unitDatas unitDefs bridgeText opens = andThen (genTypeDeclsOf allDatas unitDatas) (\typeText => andThen (groupRuntimeDefs unitDefs) (\groups => andThen (genGroups (depAdjacency unitDefs) (mkGenSt allDatas allDefs) groups) (\p => case p of
  Pair bodies _ => Ok (openHeader opens ++ typeText ++ bridgeText ++ joinWith "\n\n" bodies ++ "\n")
)
)
)

splitListBridgeFor : List DtData -> List (Pair String String) -> String -> String
splitListBridgeFor allDatas dataPairs unit = case findListFamilyData allDatas of
  Nothing => ""
  Just dd => if mapOwnerOf dataPairs (dtDataName dd) == unit then dtListBridge allDatas else ""

splitModuleFiles : List DtData -> List DtDef -> List (Pair String String) -> List (Pair String String) -> List String -> List (Pair String (List Decl)) -> Result (List SplitFile)
splitModuleFiles allDatas allDefs defPairs dataPairs earlier [] = Ok []
splitModuleFiles allDatas allDefs defPairs dataPairs earlier ((Pair mname decls) :: rest) =
  let
    unit = splitUnitOfModule mname
    unitDatas = datasInUnit dataPairs mname allDatas
    unitDefs = defsInUnit defPairs mname allDefs
    bridge = splitListBridgeFor allDatas dataPairs mname
  in andThen
    (splitUnitText allDatas allDefs unitDatas unitDefs bridge (append [runtimeUnit, builtinUnit] earlier))
    (\text => andThen (splitModuleFiles allDatas allDefs defPairs dataPairs (append earlier [unit]) rest) (\tail => Ok (SplitFile (unit ++ ".ml") text :: tail)))

splitMainHook : List DtData -> List DtDef -> Bool -> Result String
splitMainHook allDatas allDefs printResult = case findDtDef "main" allDefs of
  Nothing => Err "DT: no main definition"
  Just mainDef =>
    let
      table = defTable allDefs
      mainRef = valueName "main"
    in case ioResultTy (dtDefType mainDef) of
      Just innerTy =>
        genDtHook "" table innerTy (ioRunText (Pair allDatas allDefs) mainRef) printResult
      Nothing => genDtHook "" table (dtDefType mainDef) mainRef printResult

splitMainFile : List DtData -> List DtDef -> List (Pair String String) -> List (Pair String String) -> Bool -> List String -> Result SplitFile
splitMainFile allDatas allDefs defPairs dataPairs printResult opens =
  let
    entryDefs = defsInUnit defPairs entryOwner allDefs
    entryDatas = datasInUnit dataPairs entryOwner allDatas
  in andThen (genTypeDeclsOf allDatas entryDatas) (\typeText => andThen (groupRuntimeDefs entryDefs) (\groups => andThen (genGroups (depAdjacency entryDefs) (mkGenSt allDatas allDefs) groups) (\p => case p of
    Pair bodies _ =>
      andThen (splitMainHook allDatas allDefs printResult)
        (\hook => Ok (SplitFile "Main.ml" (openHeader opens ++ typeText ++ joinWith "\n\n" bodies ++ "\n" ++ hook)))
  )
  )
  )

-- M24.6 第二级（重新裁定后的最小落地）：codegen 只接受 **Loader-resolved** 的模块声明。
-- M24 之后 codegen 的单一文件路径只吃 `DtProgram`（Elab 输出），唯一还接触 `Decl`
-- 的是 split 的归属表；这里在该边界上校验「模块声明名必须带模块前缀」（Loader 保证
-- 的 resolved 形态）。任何人把 parse 后的裸声明喂进来都会在这里被拒，而不是生成
-- 归属错误/静默丢定义的 split 产物。单文件/REPL/LSP 的 parsed 入口不经过本函数。
firstUnresolvedDeclName : List String -> Maybe String
firstUnresolvedDeclName [] = Nothing
firstUnresolvedDeclName (n :: rest) = if containsDot n then firstUnresolvedDeclName rest else Just n

checkResolvedModules : List (Pair String (List Decl)) -> Result Int
checkResolvedModules [] = Ok 0
checkResolvedModules ((Pair mname decls) :: rest) = case firstUnresolvedDeclName (splitDeclNames decls) of
  Just n =>
    Err
      ("DT: internal: module " ++ mname ++ " has an unresolved declaration name `" ++ n ++ "` (codegen requires Loader-resolved decls)")
  Nothing => checkResolvedModules rest

generateDtSplitProgram : List (Pair String (List Decl)) -> List Decl -> DtProgram -> Bool -> Result (List SplitFile)
generateDtSplitProgram modules entryDecls prog printResult =
  let
    allDatas = dtProgDatas prog
    allDefs = dtProgDefs prog
    runtimeAll = runtimeDatas allDatas
    table = defTable allDefs
  in andThen (checkResolvedModules modules) (\_ => case partitionDefs table allDefs of
    Pair runtime typeNames =>
      let
        allTypeNames = append typeNames (map dtDataName allDatas)
        meta = splitMetaOf modules entryDecls
      in andThen (checkAllDefScopes runtime) (\_ => andThen (ensureUniqueOcamlNames allDatas runtime) (\_ => andThen (checkAllErasure allTypeNames runtime) (\_ => andThen (nameOwnerPairsOfDefs meta runtime) (\defPairs => andThen (nameOwnerPairsOfDatas meta allDatas) (\dataPairs => let
        builtinDatas = datasInUnit dataPairs builtinOwner runtimeAll
        builtinDefs = defsInUnit defPairs builtinOwner runtime
      in andThen (splitUnitText runtimeAll runtime builtinDatas builtinDefs "" [runtimeUnit]) (\builtinText => andThen (splitModuleFiles runtimeAll runtime defPairs dataPairs [] modules) (\moduleFiles => let
        unitNames = map (\p => splitUnitOfModule (firstOf p)) modules
      in andThen
        (splitMainFile runtimeAll runtime defPairs dataPairs printResult (append [runtimeUnit, builtinUnit] unitNames))
        (\mainFile => Ok (SplitFile "Vuna_runtime.ml" dtRuntime :: SplitFile "Vuna_builtins.ml" builtinText :: append moduleFiles [mainFile]))
      )
      )
      )
      )
      )
      )
      )
  )
