module Vuna.Compiler.Native.Abi where

-- Vuna.Compiler.Native.Abi：x86-64 SysV 的调用约定、栈帧、字符串对象布局、稳定命名（M2）。
--
-- 平台契约（见 docs/reference/native.md）：
--   * 参数寄存器按序 rdi, rsi, rdx, rcx, r8, r9；返回 rax；
--   * 每个函数 `push rbp; mov rbp, rsp; sub rsp, frame`，frame 为 16 的倍数；
--   * 所有 binder / 中间值走 `[rbp - 8*(slot+1)]`，不做寄存器分配；
--   * 生成代码只使用 caller-saved 寄存器，不碰 rbx/r12-r15；
--   * 名字由 Vuna 全限定名派生，转义成 `[A-Za-z0-9_]`，不按位置编号。
--
-- M2 值表示：
--   * `Int` / `Nat` 仍是 63-bit 有符号；
--   * `String` 值是**指向长度头的指针**：`[ptr]` = 字节数（i64），`[ptr+8 ..]` = 字节；
--     字符串不可变，所有构造都分配新对象；
--   * 堆是 `.bss` 里的一段固定缓冲 + 一个 bump 指针（无 GC/RC；耗尽即 trap OOM）。
--
-- 边界：只 import Base 与 `Native.Model`。
import Base.Bool
import Base.Int
import Base.List
import Base.Pair
import Base.String
import Vuna.Compiler.Native.Model

-- | 参数寄存器（SysV AMD64 的整型前六个）。
export nativeArgRegs : List Reg
nativeArgRegs = [Rdi, Rsi, Rdx, Rcx, R8, R9]

-- | 支持的最大 arity（更多参数需要栈传参）。
export nativeMaxArgs : Int
nativeMaxArgs = 6

-- | slot 序号（从 0 起）-> rbp 偏移（负数）。
export nativeSlotOff : Int -> Int
nativeSlotOff slot = 0 - 8 * (slot + 1)

-- | 栈帧字节数：8 * slots 上取整到 16。
export nativeFrameBytes : Int -> Int
nativeFrameBytes slots =
  let
    raw = 8 * slots
  in if raw == 0 then 0 else (raw + 15) / 16 * 16

-- ---------------------------------------------------------------
-- 字符串对象布局与堆
-- ---------------------------------------------------------------
-- | 字符串长度头的大小（字节）；数据紧跟在头之后。
export nativeStrHeaderBytes : Int
nativeStrHeaderBytes = 8

-- | bump 堆缓冲大小（1 MiB；`.bss` 零填充，不占 ELF 文件体积）。
export nativeHeapBytes : Int
nativeHeapBytes = 1048576

-- | 堆缓冲标签（`.bss`）。
export nativeHeapLabel : String
nativeHeapLabel = "rt_heap"

-- | 堆结束标签（`.bss` 里紧跟缓冲；分配时与它比较判 OOM）。
export nativeHeapEndLabel : String
nativeHeapEndLabel = "rt_heap_end"

-- | 堆指针槽标签（`.bss` 里的 8 字节；运行时启动时初始化）。
export nativeHeapPtrLabel : String
nativeHeapPtrLabel = "rt_heap_ptr"

-- ---------------------------------------------------------------
-- 函数框架
-- ---------------------------------------------------------------
-- | 固定 prologue：push rbp; mov rbp, rsp; sub rsp, frame（frame=0 时省略）。
export nativePrologue : Int -> List Instr
nativePrologue frame =
  append [IPush Rbp, IMov (OpReg Rbp) (OpReg Rsp)]
    (if frame == 0 then [] else [IBinReg "sub" Rsp (OpImm frame)])

-- | 固定 epilogue：mov rsp, rbp; pop rbp; ret。
export nativeEpilogue : List Instr
nativeEpilogue = [IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp, IRet]

-- ---------------------------------------------------------------
-- 稳定命名
-- ---------------------------------------------------------------
isNativeNameChar : Int -> Bool
isNativeNameChar c = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

nativeNameChar : Int -> String
nativeNameChar c = if isNativeNameChar c then strPack [c] else "_x${strFromInt c}_"

-- | Vuna 全限定名 -> 汇编标识符片段（只含 `[A-Za-z0-9_]`）。
export nativeName : String -> String
nativeName name = strPack (concatMap (\c => strUnpack (nativeNameChar c)) (strUnpack name))

-- | 用户定义的函数标签。
export nativeFuncLabel : String -> String
nativeFuncLabel name = "vuna_${nativeName name}"

-- | 运行时函数标签。
export nativeRtLabel : String -> String
nativeRtLabel name = "rt_${nativeName name}"

-- | 程序入口标签（固定）。
export nativeEntryLabel : String
nativeEntryLabel = "_start"

-- | 内部 label：按生成顺序编号（同一 IR 的编号稳定）。**全程序唯一**：运行时模板
-- 与用户函数共享同一个编号空间（见 `Native.Module` 里 `_start` 之前的重新编号）。
export nativeJumpLabel : Int -> String
nativeJumpLabel n = ".L${strFromInt n}"

-- | 只读数据标签（运行时常量）。
export nativeDataLabel : String -> String
nativeDataLabel name = "rt_data_${nativeName name}"

-- | 字符串字面量标签（带长度头）。
export nativeStrLitLabel : Int -> String
nativeStrLitLabel n = "rt_lit_${strFromInt n}"
