module Vuna.Compiler.Native.Abi where

-- x86-64 SysV 的调用约定、栈帧、字符串对象布局、稳定命名。
--
-- 平台契约（见 docs/reference/native.md）：
--   * 参数寄存器按序 rdi, rsi, rdx, rcx, r8, r9；返回 rax；
--   * 每个函数 `push rbp; mov rbp, rsp; sub rsp, frame`，frame 为 16 的倍数；
--   * 所有 binder / 中间值走 `[rbp - 8*(slot+1)]`，不做寄存器分配；
--   * 生成代码只使用 caller-saved 寄存器，不碰 rbx/r12-r15；
--   * 名字由 Vuna 全限定名派生，转义成 `[A-Za-z0-9_]`，不按位置编号。
--
-- 值表示：
--   * `Int` / `Nat` 是 63-bit 有符号；
--   * `String` 值是**指向长度头的指针**：`[ptr]` = 字节数（i64），`[ptr+8 ..]` = 字节；
--     字符串不可变，所有构造都分配新对象；
--   * 堆对象前有一个 8 字节块头 `[size | flags]`（见下），指针指向块头之后的 payload；
--   * 堆是段链表（`.bss` 起始段 + `mmap` 新段），空闲块按尺寸类复用，标记-清扫 GC
--     见 `Vuna.Compiler.Native.Gc`。
--
-- 边界：只 import Base 与 `Native.Model`。
import Base.Bool
import Base.Int
import Base.List
import Base.Pair
import Base.String
import Vuna.Compiler.Native.Model

-- | 参数寄存器（SysV AMD64 的整型前六个）。
export nativeArgRegs : List Reg
nativeArgRegs = [Rdi, Rsi, Rdx, Rcx, R8, R9]

-- | 寄存器传参的个数上限；更多参数走栈（SysV AMD64：第 7 个起在 `[rbp+16]` 起）。
export nativeMaxArgs : Int
nativeMaxArgs = 6

-- | 第 i（从 0 起）个参数在**被调用方**栈帧里的地址（仅 i >= 6 有效）：
--   `[rbp]` = 旧 rbp、`[rbp+8]` = 返回地址、`[rbp+16]` = 第 7 个参数。
--   调用方按**逆序**压栈（最后一个先压），所以第 7 个参数在最低地址。
export nativeStackArgOff : Int -> Int
nativeStackArgOff i = 16 + 8 * (i - nativeMaxArgs)

-- | slot 序号（从 0 起）-> rbp 偏移（负数）。
export nativeSlotOff : Int -> Int
nativeSlotOff slot = 0 - 8 * (slot + 1)

-- | 栈帧字节数：8 * slots 上取整到 16。
export nativeFrameBytes : Int -> Int
nativeFrameBytes slots =
  let
    raw = 8 * slots
  in if raw == 0 then 0 else (raw + 15) / 16 * 16

-- ---------------------------------------------------------------
-- 字符串对象布局、堆与 GC 布局
-- ---------------------------------------------------------------
-- | 字符串长度头的大小（字节）；数据紧跟在头之后。
export nativeStrHeaderBytes : Int
nativeStrHeaderBytes = 8

-- | 每个堆对象前的块头字节数（对象指针 = 块头 + 8）。
export nativeBlockHeaderBytes : Int
nativeBlockHeaderBytes = 8

-- | 块头低 4 位是标志；高位是块总字节数（16 对齐）。
export nativeMarkFlag : Int
nativeMarkFlag = 1

export nativeFreeFlag : Int
nativeFreeFlag = 2

-- | payload 里没有指针（字符串、Float），标记时不扫。
export nativeLeafFlag : Int
nativeLeafFlag = 4

-- | 永不回收的块（续延捕获缓冲由 `rt_cap_free` 自己复用）。
export nativePinFlag : Int
nativePinFlag = 8

-- | 最小块（块头 + 8 字节 payload）。
export nativeMinBlockBytes : Int
nativeMinBlockBytes = 16

-- | 尺寸类上限：更大的块进 `rt_huge_free` 首次适配链。
export nativeMaxClassBytes : Int
nativeMaxClassBytes = 67108864

-- | 尺寸类个数（16 B .. 64 MiB，2 的幂）。
export nativeClassCount : Int
nativeClassCount = 23

-- | 尺寸类空闲链表的字节数（按类序号索引）。
export nativeFreeTableBytes : Int
nativeFreeTableBytes = 256

-- | 段头字节数：`[0]=next [8]=end [16]=bump [24]=kind`；块区从段头之后开始。
export nativeSegHeaderBytes : Int
nativeSegHeaderBytes = 32

-- | 初始堆缓冲大小（1 MiB；`.bss` 零填充，不占 ELF 文件体积）。
export nativeHeapBytes : Int
nativeHeapBytes = 1048576

-- | 初始堆段的段头标签（紧跟 1 MiB 缓冲）。
export nativeHeapSegLabel : String
nativeHeapSegLabel = "rt_heap_seg"

-- | 堆缓冲标签（`.bss`）。
export nativeHeapLabel : String
nativeHeapLabel = "rt_heap"

-- | 堆结束标签（`.bss` 里紧跟缓冲）。
export nativeHeapEndLabel : String
nativeHeapEndLabel = "rt_heap_end"

-- | 当前段的分配指针（bump）。
export nativeHeapPtrLabel : String
nativeHeapPtrLabel = "rt_heap_ptr"

-- | 当前 arena 段的结束地址。
export nativeArenaEndLabel : String
nativeArenaEndLabel = "rt_arena_end"

-- | 段链表头（新段插在表头）。
export nativeSegsLabel : String
nativeSegsLabel = "rt_segs"

-- | 当前 bump 段（段头地址）。
export nativeCurSegLabel : String
nativeCurSegLabel = "rt_cur_seg"

-- | 尺寸类空闲链表（`nativeClassCount` 项）。
export nativeFreeTableLabel : String
nativeFreeTableLabel = "rt_free_tbl"

-- | 超大块空闲链（首次适配）。
export nativeHugeFreeLabel : String
nativeHugeFreeLabel = "rt_huge_free"

-- | GC 缺省下限（也是缺省触发阈值）：1 MiB。
export nativeGcMinDefaultBytes : Int
nativeGcMinDefaultBytes = 1048576

-- ---------------------------------------------------------------
-- GC 根槽（保守标记的 `.bss` 白名单）
-- ---------------------------------------------------------------
-- | 最内层 handler 节点（`rt_handlers`，堆对象）。
export nativeHandlersLabel : String
nativeHandlersLabel = "rt_handlers"

-- | 当前 active 栈的栈顶（GC 扫描 `[rsp, rt_stack_top)`）。
export nativeStackTopLabel : String
nativeStackTopLabel = "rt_stack_top"

-- | 当前 opH 所属的 handler 节点（`prim_effectSelf` 用）。
export nativeSelfLabel : String
nativeSelfLabel = "rt_self"

-- | `bracket` / `finally` 的 cleanup 登记表头（堆对象）。
export nativeCleanupHeadLabel : String
nativeCleanupHeadLabel = "rt_cleanups"

-- ---------------------------------------------------------------
-- 函数框架
-- ---------------------------------------------------------------
-- | 固定 prologue：push rbp; mov rbp, rsp; sub rsp, frame（frame=0 时省略）。
export nativePrologue : Int -> List Instr
nativePrologue frame =
  append [IPush Rbp, IMov (OpReg Rbp) (OpReg Rsp)]
    (if frame == 0 then [] else [IBinReg "sub" Rsp (OpImm frame)])

-- | 固定 epilogue：mov rsp, rbp; pop rbp; ret。
export nativeEpilogue : List Instr
nativeEpilogue = [IMov (OpReg Rsp) (OpReg Rbp), IPop Rbp, IRet]

-- | 迁移栈段上的栈溢出守卫：`rt_stack_limit` 为 0 时不触发（主栈）。
export stackGuardInstrs : List Instr
stackGuardInstrs =
  [ICmp (OpReg Rsp) (OpRip "rt_stack_limit"), IJcc "jb" (nativeRtLabel "trap_stack_overflow")]

-- | 把体内 `IRet` 改写成跳到 `endLabel`（单出口）。
export mapRetTo : String -> List Instr -> List Instr
mapRetTo label [] = []
mapRetTo label (i :: rest) = case i of
  IRet => IJmp label :: mapRetTo label rest
  _ => i :: mapRetTo label rest

-- | 有 prologue/epilogue 的运行时函数：**单出口**。
export rtFunc : String -> Int -> List Instr -> NativeFunc
rtFunc name frame body =
  let
    endLabel = "${nativeRtLabel name}_end"
  in NativeFunc (nativeRtLabel name) frame
    (append (nativePrologue frame) (append stackGuardInstrs (append (mapRetTo endLabel body) (append [ILabel endLabel] nativeEpilogue))))

-- | 直接以 ret/exit 结束、无 prologue 的入口/陷阱。
export rtRawFunc : String -> List Instr -> NativeFunc
rtRawFunc name body = NativeFunc (nativeRtLabel name) 0 body

-- ---------------------------------------------------------------
-- 稳定命名
-- ---------------------------------------------------------------
isNativeNameChar : Int -> Bool
isNativeNameChar c = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

nativeNameChar : Int -> String
nativeNameChar c = if isNativeNameChar c then strPack [c] else "_x${strFromInt c}_"

-- | Vuna 全限定名 -> 汇编标识符片段（只含 `[A-Za-z0-9_]`）。
export nativeName : String -> String
nativeName name = strPack (concatMap (\c => strUnpack (nativeNameChar c)) (strUnpack name))

-- | 用户定义的函数标签。
export nativeFuncLabel : String -> String
nativeFuncLabel name = "vuna_${nativeName name}"

-- | 运行时函数标签。
export nativeRtLabel : String -> String
nativeRtLabel name = "rt_${nativeName name}"

-- | 顶层函数当值时的静态 wrapper 标签（诚实反映「这是函数值」）。
export nativeGlobalValueLabel : String -> String
nativeGlobalValueLabel name = "vuna_gv_${nativeName name}"

-- | 运行时符号当值时的 wrapper 标签。
export nativeRtValueLabel : String -> String
nativeRtValueLabel sym = "rt_gv_${nativeName sym}"

-- | 程序入口标签（固定）。
export nativeEntryLabel : String
nativeEntryLabel = "_start"

-- | 内部 label：按生成顺序编号（同一 IR 的编号稳定）。**全程序唯一**：运行时模板
-- 与用户函数共享同一个编号空间（见 `Native.Module` 里 `_start` 之前的重新编号）。
export nativeJumpLabel : Int -> String
nativeJumpLabel n = ".L${strFromInt n}"

-- | 只读数据标签（运行时常量）。
export nativeDataLabel : String -> String
nativeDataLabel name = "rt_data_${nativeName name}"

-- | 字符串字面量标签（带长度头）。
export nativeStrLitLabel : Int -> String
nativeStrLitLabel n = "rt_lit_${strFromInt n}"
