    [IMov (OpReg Rdx) (OpMem Rdi 0), ILeaMem Rsi Rdi 8, IMov (OpReg Rdi) (OpImm 1), IMov (OpReg Rax) (OpImm 1), ISyscall, IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 1), ILea Rsi (nativeDataLabel "nl"), IMov (OpReg Rdx) (OpImm 1), ISyscall, IRet]

-- | 一次分配需要的块尺寸（`rax` = payload + 块头向上取整；`rcx` = 尺寸类；`r8` = 类序号）。
--   payload 字节数在 `rt_alloc_req`（`alloc` 在任何分配/G C 之前存下）。
allocClassInstrs : String -> List Instr
allocClassInstrs tag =
  [ IMov (OpReg Rax) (OpRip allocReqLabel),
    IBinReg "add" Rax (OpImm (nativeBlockHeaderBytes + 15)),
    IBinReg "and" Rax (OpImm (0 - 16)),
    IMov (OpReg Rcx) (OpImm nativeMinBlockBytes),
    IBinReg "xor" R8 (OpReg R8),
    ILabel ".Lrt_alloc_class_${tag}",
    ICmp (OpReg Rcx) (OpReg Rax),
    IJcc "jae" ".Lrt_alloc_class_${tag}_done",
    IBinReg "shl" Rcx (OpImm 1),
    IBinReg "add" R8 (OpImm 1),
    IJmp ".Lrt_alloc_class_${tag}",
    ILabel ".Lrt_alloc_class_${tag}_done"
  ]

-- | 对象分配：`rdi` = payload 字节数 -> `rax` = 对象地址（块头之后）。
--   预算按 `live + 已分配 + 本次` 检查（超限先完整 GC，仍超才 trap）；阈值/压力开关触发 GC；
--   空闲块按尺寸类复用，都不行才在本段 bump，本段不够就开新段。
--   `rdi`/`rsi`/`r8`/`r9` 存在 `.bss` 里（不是栈帧）：GC 把它们当根扫描，因此调用方
--   放在这些寄存器里的指针在回收期间仍然可达。
allocFn : NativeFunc
allocFn =
  rtRawFunc "alloc"
    (append [IMov (OpRip allocReqLabel) (OpReg Rdi), IMov (OpRip allocSaveRdiLabel) (OpReg Rdi), IMov (OpRip allocSaveRsiLabel) (OpReg Rsi), IMov (OpRip allocSaveR8Label) (OpReg R8), IMov (OpRip allocSaveR9Label) (OpReg R9)] (append (allocClassInstrs "init") (append [IMov (OpReg R9) (OpRip gcLiveLabel), IBinReg "add" R9 (OpRip gcSinceLabel), IBinReg "add" R9 (OpReg Rcx), IMov (OpReg R10) (OpRip memLimitLabel), ITest R10 R10, IJcc "jz" ".Lrt_alloc_budget_ok", ICmp (OpReg R9) (OpReg R10), IJcc "jbe" ".Lrt_alloc_budget_ok", ICall (nativeRtLabel "gc_collect"), IJmp ".Lrt_alloc_after_gc", ILabel ".Lrt_alloc_budget_ok", IMov (OpReg R9) (OpRip gcStressLabel), ITest R9 R9, IJcc "jnz" ".Lrt_alloc_do_gc", IMov (OpReg R9) (OpRip gcSinceLabel), ICmp (OpReg R9) (OpRip gcThresholdLabel), IJcc "jbe" ".Lrt_alloc_go", ILabel ".Lrt_alloc_do_gc", ICall (nativeRtLabel "gc_collect"), IJmp ".Lrt_alloc_after_gc", ILabel ".Lrt_alloc_after_gc"] (append (allocClassInstrs "after") (append [IMov (OpReg R10) (OpRip memLimitLabel), ITest R10 R10, IJcc "jz" ".Lrt_alloc_go", IMov (OpReg R9) (OpRip gcLiveLabel), IBinReg "add" R9 (OpReg Rcx), ICmp (OpReg R9) (OpReg R10), IJcc "ja" (nativeRtLabel "trap_mem_limit"), ILabel ".Lrt_alloc_go", ICmp (OpReg Rcx) (OpImm nativeMaxClassBytes), IJcc "ja" ".Lrt_alloc_huge", ILea Rdx nativeFreeTableLabel, IMov (OpReg Rax) (OpReg R8), IBinReg "shl" Rax (OpImm 3), IBinReg "add" Rdx (OpReg Rax), IMov (OpReg Rax) (OpMem Rdx 0), ITest Rax Rax, IJcc "jz" ".Lrt_alloc_bump", IMov (OpReg Rsi) (OpMem Rax 8), IMov (OpMem Rdx 0) (OpReg Rsi), IMov (OpMem Rax 0) (OpReg Rcx), IJmp ".Lrt_alloc_count", ILabel ".Lrt_alloc_bump", IMov (OpReg Rax) (OpRip nativeHeapPtrLabel), IMov (OpReg Rdx) (OpReg Rax), IBinReg "add" Rdx (OpReg Rcx), ICmp (OpReg Rdx) (OpRip nativeArenaEndLabel), IJcc "jbe" ".Lrt_alloc_bump_ok", IMov (OpReg Rdi) (OpReg Rcx), IBinReg "add" Rdi (OpImm (nativeSegHeaderBytes + 15)), ICall (nativeRtLabel "pow2_ceil"), ICmp (OpReg Rax) (OpImm nativeHeapBytes), IJcc "jae" ".Lrt_alloc_seg_size", IMov (OpReg Rax) (OpImm nativeHeapBytes), ILabel ".Lrt_alloc_seg_size", IPush Rax, IMov (OpReg Rsi) (OpReg Rax), IBinReg "xor" Rdi (OpReg Rdi), IMov (OpReg Rdx) (OpImm 3), IMov (OpReg R10) (OpImm 34), IMov (OpReg R8) (OpImm (0 - 1)), IBinReg "xor" R9 (OpReg R9), IMov (OpReg Rax) (OpImm 9), ISyscall, ICmp (OpReg Rax) (OpImm 0), IJcc "jl" (nativeRtLabel "trap_oom"), IPop R8, IMov (OpReg Rdx) (OpReg Rax), IMov (OpReg R9) (OpRip nativeSegsLabel), IMov (OpMem Rdx 0) (OpReg R9), IMov (OpRip nativeSegsLabel) (OpReg Rdx), IMov (OpReg R9) (OpReg Rdx), IBinReg "add" R9 (OpReg R8), IMov (OpMem Rdx 8) (OpReg R9), IMov (OpReg R9) (OpReg Rdx), IBinReg "add" R9 (OpImm nativeSegHeaderBytes), IMov (OpMem Rdx 16) (OpReg R9), IMov (OpReg Rcx) (OpImm 0), IMov (OpMem Rdx 24) (OpReg Rcx), IMov (OpRip nativeCurSegLabel) (OpReg Rdx), IMov (OpRip nativeHeapPtrLabel) (OpReg R9), IMov (OpReg R9) (OpReg Rdx), IBinReg "add" R9 (OpReg R8), IMov (OpRip nativeArenaEndLabel) (OpReg R9)] (append (allocClassInstrs "grow") [IMov (OpReg Rax) (OpRip nativeHeapPtrLabel), IJmp ".Lrt_alloc_bump_ok", ILabel ".Lrt_alloc_bump_ok", IMov (OpMem Rax 0) (OpReg Rcx), IMov (OpReg Rdx) (OpReg Rax), IBinReg "add" Rdx (OpReg Rcx), IMov (OpRip nativeHeapPtrLabel) (OpReg Rdx), IMov (OpReg R9) (OpRip nativeCurSegLabel), IMov (OpMem R9 16) (OpReg Rdx), IJmp ".Lrt_alloc_count", ILabel ".Lrt_alloc_huge", IMov (OpReg Rsi) (OpReg Rax), IBinReg "xor" R11 (OpReg R11), IMov (OpReg Rax) (OpRip nativeHugeFreeLabel), ILabel ".Lrt_alloc_huge_loop", ITest Rax Rax, IJcc "jz" ".Lrt_alloc_huge_fresh", IMov (OpReg R10) (OpMem Rax 0), IBinReg "and" R10 (OpImm (0 - 16)), ICmp (OpReg R10) (OpReg Rsi), IJcc "jae" ".Lrt_alloc_huge_found", IMov (OpReg R11) (OpReg Rax), IMov (OpReg Rax) (OpMem Rax 8), IJmp ".Lrt_alloc_huge_loop", ILabel ".Lrt_alloc_huge_found", IMov (OpReg Rdx) (OpMem Rax 8), ITest R11 R11, IJcc "jz" ".Lrt_alloc_huge_head", IMov (OpMem R11 8) (OpReg Rdx), IJmp ".Lrt_alloc_huge_got", ILabel ".Lrt_alloc_huge_head", IMov (OpRip nativeHugeFreeLabel) (OpReg Rdx), ILabel ".Lrt_alloc_huge_got", IMov (OpMem Rax 0) (OpReg R10), IMov (OpReg Rcx) (OpReg R10), IJmp ".Lrt_alloc_count", ILabel ".Lrt_alloc_huge_fresh", IMov (OpReg Rdi) (OpReg Rsi), IBinReg "add" Rdi (OpImm (nativeSegHeaderBytes + 15)), ICall (nativeRtLabel "pow2_ceil"), IPush Rax, IMov (OpReg Rsi) (OpReg Rax), IBinReg "xor" Rdi (OpReg Rdi), IMov (OpReg Rdx) (OpImm 3), IMov (OpReg R10) (OpImm 34), IMov (OpReg R8) (OpImm (0 - 1)), IBinReg "xor" R9 (OpReg R9), IMov (OpReg Rax) (OpImm 9), ISyscall, ICmp (OpReg Rax) (OpImm 0), IJcc "jl" (nativeRtLabel "trap_oom"), IPop R8, IMov (OpReg Rdx) (OpReg Rax), IMov (OpReg R9) (OpRip nativeSegsLabel), IMov (OpMem Rdx 0) (OpReg R9), IMov (OpRip nativeSegsLabel) (OpReg Rdx), IMov (OpReg R9) (OpReg Rdx), IBinReg "add" R9 (OpReg R8), IMov (OpMem Rdx 8) (OpReg R9), IMov (OpMem Rdx 16) (OpReg R9), IMov (OpReg Rcx) (OpImm 2), IMov (OpMem Rdx 24) (OpReg Rcx), IMov (OpReg Rax) (OpReg Rdx), IBinReg "add" Rax (OpImm nativeSegHeaderBytes), IMov (OpReg Rcx) (OpReg R8), IBinReg "sub" Rcx (OpImm nativeSegHeaderBytes), IMov (OpMem Rax 0) (OpReg Rcx), IJmp ".Lrt_alloc_count", ILabel ".Lrt_alloc_count", IMov (OpReg R9) (OpRip gcSinceLabel), IBinReg "add" R9 (OpReg Rcx), IMov (OpRip gcSinceLabel) (OpReg R9), ILabel ".Lrt_alloc_ret", IBinReg "add" Rax (OpImm nativeBlockHeaderBytes), IMov (OpReg Rdi) (OpRip allocSaveRdiLabel), IMov (OpReg Rsi) (OpRip allocSaveRsiLabel), IMov (OpReg R8) (OpRip allocSaveR8Label), IMov (OpReg R9) (OpRip allocSaveR9Label), IBinReg "xor" R11 (OpReg R11), IMov (OpRip allocSaveRdiLabel) (OpReg R11), IMov (OpRip allocSaveRsiLabel) (OpReg R11), IMov (OpRip allocSaveR8Label) (OpReg R11), IMov (OpRip allocSaveR9Label) (OpReg R11), IRet]))))))

-- | 字符串 / Float：payload 全是字节或位型，标记时不扫。
allocLeafFn : NativeFunc
allocLeafFn =
  rtRawFunc "alloc_leaf"
    [ICall (nativeRtLabel "alloc"), IMov (OpReg R11) (OpMem Rax (0 - 8)), IBinReg "or" R11 (OpImm nativeLeafFlag), IMov (OpMem Rax (0 - 8)) (OpReg R11), IRet]

-- | 续延捕获缓冲：由 `rt_cap_free` 自己复用，标记-清扫不回收。
allocPinnedFn : NativeFunc
