module Vuna.Compiler.Native.Runtime where

-- native 运行时函数（汇编模板）+ IR 符号映射。
--
-- 运行时按 `Ir.Runtime` 契约的符号名实现；白名单之外的符号由 `Native.Module` 拒绝
-- （编译期 `NativeUnsupported`），不做「trap 兜底」。
--
-- 语义参考实现是 `Vuna.Compiler.Codegen.Term` 的 `bi_*` / `dt_show_*` / `dtp_*` 模板：
--   * Int/Nat 是 63-bit 有符号；`+ - *` wrap，`/` 向零截断、除零 exit 2；
--   * Bool 是 0/1；`&&`/`||` 的短路由 `Native.Module` 生成控制流，不在运行时；
--   * Nat 的加法/乘法饱和到 max_int，减法下溢到 0；
--   * String 是**指向长度头的指针**（`[p]` = 字节数，字节从 `p+8` 起），不可变，
--     所有构造都从 bump 堆分配新对象；堆耗尽 trap `out of memory`、exit 2；
--   * 入口打印格式与 OCaml 的 `print_endline (show main)` 一致（String 走 `show`，
--     即带引号与转义的调试形态）。
--
-- 不做 GC/RC：字符串只增不减，堆是 `.bss` 里的固定缓冲 + bump 指针（1 MiB）。
--
-- 边界：只 import Base 与 `Native.{Model,Abi}`。
import Base.Bool
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.String
import Vuna.Compiler.Native.Abi
import Vuna.Compiler.Native.Model

-- ---------------------------------------------------------------
-- 常量与只读数据
-- ---------------------------------------------------------------
-- | 63-bit 有符号的上界（与 OCaml `max_int` / `irNatChainMax` 一致）。
nativeMaxInt : Int
nativeMaxInt = 4611686018427387903

divZeroMessage : String
divZeroMessage = "vuna: runtime error: division by zero\n"

oomMessage : String
oomMessage = "vuna: runtime error: out of memory\n"

-- 运行时错误报告器的统一前缀（与 OCaml 报告器 `dt_report_exn` 的输出逐字对齐）。
errPrefix : String
errPrefix = "vuna: runtime error: "

assertPrefix : String
assertPrefix = "assertion failed: "

todoPrefix : String
todoPrefix = "TODO: "

impossibleMessage : String
impossibleMessage = "vuna: runtime error: impossible branch\n"

-- | 数组越界：与 OCaml `Invalid_argument ("index out of bounds")` 的报告器文本一致
--   （native 没有位置表，因此没有 OCaml 报告器那行 `at ...`）。
arrayOobMessage : String
arrayOobMessage = "vuna: runtime error: Invalid_argument(\"index out of bounds\")\n"

export nativeRodata : List NativeRodata
nativeRodata =
  [ NativeRodata (nativeDataLabel "true") "True",
    NativeRodata (nativeDataLabel "false") "False",
    NativeRodata (nativeDataLabel "nl") "\n",
    NativeRodata (nativeDataLabel "divzero") divZeroMessage,
    NativeRodata (nativeDataLabel "oom") oomMessage,
    NativeRodata (nativeDataLabel "err_prefix") errPrefix,
    NativeRodata (nativeDataLabel "assert_prefix") assertPrefix,
    NativeRodata (nativeDataLabel "todo_prefix") todoPrefix,
    NativeRodata (nativeDataLabel "impossible") impossibleMessage,
    NativeRodata (nativeDataLabel "array_oob") arrayOobMessage,
    NativeRodata (nativeDataLabel "unhandled_effect") unhandledEffectMessage,
    NativeRodata (nativeDataLabel "resume_twice") resumeTwiceMessage,
    NativeRodata (nativeDataLabel "bad_stack") badStackMessage
  ]

-- | `.bss`：bump 堆缓冲 → 堆结束标记 → 堆指针（由 `_start` 初始化）。
export nativeBss : List NativeBss
nativeBss =
  [ NativeBss nativeHeapLabel nativeHeapBytes 16,
    NativeBss nativeHeapEndLabel 0 0,
    NativeBss nativeHeapPtrLabel 8 8,
    NativeBss nativeArenaEndLabel 8 8,
    NativeBss handlersLabel 8 8,
    NativeBss stackTopLabel 8 8
  ]

-- ---------------------------------------------------------------
-- 构架 helper
-- ---------------------------------------------------------------
-- | 有 prologue/epilogue 的运行时函数：**单出口**。函数体里出现的 `IRet` 由这里统一
--   改写成跳到函数尾标签（`mov rsp, rbp; pop rbp; ret`），避免"带栈帧的函数提前 ret"
--   把 rsp 留在 frame 内（那会让我们在返回地址上崩）。手写分支里的 `IRet` 因此可放心写。
rtFunc : String -> Int -> List Instr -> NativeFunc
rtFunc name frame body =
  let
    endLabel = "${nativeRtLabel name}_end"
  in NativeFunc (nativeRtLabel name) frame
    (append (nativePrologue frame) (append (mapRetTo endLabel body) (append [ILabel endLabel] nativeEpilogue)))

-- | 把体内 `IRet` 改写成跳到 `endLabel`（单出口）。
mapRetTo : String -> List Instr -> List Instr
mapRetTo label [] = []
mapRetTo label (i :: rest) = case i of
  IRet => IJmp label :: mapRetTo label rest
  _ => i :: mapRetTo label rest

-- | 直接以 ret/exit 结束、无 prologue 的入口/陷阱。
rtRawFunc : String -> List Instr -> NativeFunc
rtRawFunc name body = NativeFunc (nativeRtLabel name) 0 body

-- | 二元 Int 运算：wrap 回 63-bit。
intBinary : String -> String -> NativeFunc
intBinary name op =
  rtFunc name 0
    [IMov (OpReg Rax) (OpReg Rdi), IBin op (OpReg Rsi), IBin "shl" (OpImm 1), IBin "sar" (OpImm 1)]

-- | 比较：Bool 结果 0/1。
intCompare : String -> String -> NativeFunc
intCompare name cond = rtFunc name 0 [ICmp (OpReg Rdi) (OpReg Rsi), ISetcc cond Rax, IMovzxAl]

-- | 位运算：63-bit 二进制补码（`Codegen.Term.bi_bit*` 的汇编实现）。
--   `and/or/xor` 复用 `intBinary` 的 wrap；`bitNot` 是 `xor -1` 再 wrap。
bitNotFn : NativeFunc
bitNotFn =
  rtFunc "bit_not" 0
    [IMov (OpReg Rax) (OpReg Rdi), IBin "xor" (OpImm (0 - 1)), IBin "shl" (OpImm 1), IBin "sar" (OpImm 1)]

-- | `bitShl`：计数 `n < 0 || n >= 63` → 0；否则 `a lsl n`（再 wrap 回 63-bit）。
bitShlFn : NativeFunc
bitShlFn =
  rtFunc "bit_shl" 0
    [ITest Rsi Rsi, IJcc "js" ".Lrt_bit_shl_zero", ICmp (OpReg Rsi) (OpImm 63), IJcc "jge" ".Lrt_bit_shl_zero", IMov (OpReg Rax) (OpReg Rdi), IMov (OpReg Rcx) (OpReg Rsi), IBinReg "shl" Rax (OpReg Rcx), IBin "shl" (OpImm 1), IBin "sar" (OpImm 1), IRet, ILabel ".Lrt_bit_shl_zero", IMov (OpReg Rax) (OpImm 0), IRet]

-- | `bitShr`：计数 `n < 0 || n >= 63` → 0；否则先把值按 63-bit 无符号展开再逻辑右移。
--   （bit 63 是 63-bit 值的符号扩展位；`shl`+`shr` 只清掉它，保留 bit 62）
bitShrFn : NativeFunc
bitShrFn =
  rtFunc "bit_shr" 0
    [ITest Rsi Rsi, IJcc "js" ".Lrt_bit_shr_zero", ICmp (OpReg Rsi) (OpImm 63), IJcc "jge" ".Lrt_bit_shr_zero", IMov (OpReg R11) (OpReg Rdi), IBinReg "shl" R11 (OpImm 1), IBinReg "shr" R11 (OpImm 1), IMov (OpReg Rax) (OpReg R11), IMov (OpReg Rcx) (OpReg Rsi), IBinReg "shr" Rax (OpReg Rcx), IRet, ILabel ".Lrt_bit_shr_zero", IMov (OpReg Rax) (OpImm 0), IRet]

-- | 把 rdi 当作 Nat 返回（恒等）。
natToIntFn : NativeFunc
natToIntFn = rtFunc "nat_to_int" 0 [IMov (OpReg Rax) (OpReg Rdi)]

-- ---------------------------------------------------------------
-- 可观测性原语桩（`docs/reference/observability.md` §4.1）
-- ---------------------------------------------------------------
-- native 后端只提供**叶子**原语的 no-op 桩：读级别与记事件都返回 Int 0（0 = 「没打开 /
-- 没产生事件」）。`@vuna@obs@span` 是**高阶**原语（吃一个 `Int -> a` 的 thunk），本后端
-- 没有闭包表示，故不在表里 —— 引用点由 `Module.genRtApp` 报
-- `NativeUnsupported`（编译期拒绝，不给假数据）。
obsZeroFn : String -> NativeFunc
obsZeroFn name = rtFunc name 0 [IMov (OpReg Rax) (OpImm 0)]

obsZero2Fn : String -> NativeFunc
obsZero2Fn name = rtFunc name 0 [IMov (OpReg Rax) (OpImm 0)]

-- `dbg!` 展开里的两个运行时符号（与 OCaml 的 `dtp_debug_on` / `dtp_debug_line` 对齐）：
-- 默认关闭 ⇒ `debug_on` 恒返回 0（False），`debug_line` 是 1 参恒等返回 0 的桩。
debugOnFn : NativeFunc
debugOnFn = rtFunc "debug_on" 0 [IMov (OpReg Rax) (OpImm 0)]

debugLineFn : NativeFunc
debugLineFn = rtFunc "debug_line" 0 [IMov (OpReg Rax) (OpImm 0)]

-- ---------------------------------------------------------------
-- Int 运算
-- ---------------------------------------------------------------
divFn : NativeFunc
divFn =
  rtFunc "div" 0
    [ITest Rsi Rsi, IJcc "jne" ".Lrt_div_ok", ICall (nativeRtLabel "trap_divzero"), ILabel ".Lrt_div_ok", IMov (OpReg Rax) (OpReg Rdi), ICqo, IDiv Rsi, IBin "shl" (OpImm 1), IBin "sar" (OpImm 1)]

-- ---------------------------------------------------------------
-- Nat 运算（饱和/夹取，照抄 OCaml 模板）
-- ---------------------------------------------------------------
natAddFn : NativeFunc
natAddFn =
  rtFunc "nat_add" 0
    [IMov (OpReg Rax) (OpReg Rdi), IMov (OpReg R11) (OpImm nativeMaxInt), IBinReg "sub" R11 (OpReg Rsi), ICmp (OpReg Rax) (OpReg R11), IJcc "jg" ".Lrt_nat_add_sat", IBin "add" (OpReg Rsi), IRet, ILabel ".Lrt_nat_add_sat", IMov (OpReg Rax) (OpReg R11)]

natSubFn : NativeFunc
natSubFn =
  rtFunc "nat_sub" 0
    [ICmp (OpReg Rdi) (OpReg Rsi), IJcc "jle" ".Lrt_nat_sub_zero", IMov (OpReg Rax) (OpReg Rdi), IBin "sub" (OpReg Rsi), IRet, ILabel ".Lrt_nat_sub_zero", IMov (OpReg Rax) (OpImm 0)]

natMulFn : NativeFunc
natMulFn =
  rtFunc "nat_mul" 0
    [ICmp (OpReg Rdi) (OpImm 0), IJcc "jle" ".Lrt_nat_mul_zero", ICmp (OpReg Rsi) (OpImm 0), IJcc "jle" ".Lrt_nat_mul_zero", IMov (OpReg Rax) (OpImm nativeMaxInt), ICqo, IDiv Rsi, ICmp (OpReg Rdi) (OpReg Rax), IJcc "jg" ".Lrt_nat_mul_sat", IMov (OpReg Rax) (OpReg Rdi), IBin "imul" (OpReg Rsi), IRet, ILabel ".Lrt_nat_mul_sat", IMov (OpReg Rax) (OpImm nativeMaxInt), IRet, ILabel ".Lrt_nat_mul_zero", IMov (OpReg Rax) (OpImm 0)]

natDivFn : NativeFunc
natDivFn =
  rtFunc "nat_div" 0
    [ITest Rsi Rsi, IJcc "jne" ".Lrt_nat_div_ok", ICall (nativeRtLabel "trap_divzero"), ILabel ".Lrt_nat_div_ok", IMov (OpReg Rax) (OpReg Rdi), ICqo, IDiv Rsi]

natFromIntFn : NativeFunc
natFromIntFn =
  rtFunc "nat_from_int" 0
    [ICmp (OpReg Rdi) (OpImm 0), IJcc "jle" ".Lrt_nat_from_zero", IMov (OpReg Rax) (OpReg Rdi), IRet, ILabel ".Lrt_nat_from_zero", IMov (OpReg Rax) (OpImm 0)]

natSuccFn : NativeFunc
natSuccFn =
  rtFunc "nat_succ" 0
    [IMov (OpReg Rax) (OpReg Rdi), IMov (OpReg R11) (OpImm nativeMaxInt), ICmp (OpReg Rax) (OpReg R11), IJcc "jge" ".Lrt_nat_succ_sat", IBin "add" (OpImm 1), IRet, ILabel ".Lrt_nat_succ_sat", IMov (OpReg Rax) (OpReg R11)]

-- ---------------------------------------------------------------
-- 字符串：堆分配与基本操作
-- ---------------------------------------------------------------
-- | `rdi` = 字符串**数据字节数**（不含长度头），返回 `rax` = 新对象起始地址。
--   分配 = 数据 + 8 字节头；bump 指针超过堆尾则 trap OOM。
--   只改 rax/rcx/rdx，不改 rdi/rsi。
strAllocFn : NativeFunc
strAllocFn =
  rtFunc "str_alloc" 0
    [IBinReg "add" Rdi (OpImm nativeStrHeaderBytes), ICall (nativeRtLabel "alloc"), IRet]

-- | `rdi` = 字符串 -> rax = 字节数。
strLengthFn : NativeFunc
strLengthFn = rtFunc "str_length" 0 [IMov (OpReg Rax) (OpMem Rdi 0)]

-- | `++`：rdi/rsi = 两个字符串 -> rax = 新字符串。
strConcatFn : NativeFunc
strConcatFn =
  rtFunc "str_concat" 32
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdi), IMov (OpMem Rbp (0 - 16)) (OpReg Rsi), IMov (OpReg Rax) (OpMem Rdi 0), IBin "add" (OpMem Rsi 0), IMov (OpMem Rbp (0 - 24)) (OpReg Rax), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "str_alloc"), IMov (OpReg R11) (OpReg Rax), IMov (OpReg Rax) (OpMem Rbp (0 - 24)), IMov (OpMem R11 0) (OpReg Rax), ILeaMem Rdi R11 8, IMov (OpReg Rsi) (OpMem Rbp (0 - 8)), IBinReg "add" Rsi (OpImm 8), IMov (OpReg Rcx) (OpMem Rsi (0 - 8)), IRepMovsb, IMov (OpReg Rsi) (OpMem Rbp (0 - 16)), IBinReg "add" Rsi (OpImm 8), IMov (OpReg Rcx) (OpMem Rsi (0 - 8)), IRepMovsb, IMov (OpReg Rax) (OpReg R11), IRet]

-- | `==`：rdi/rsi = 两个字符串 -> rax = 0/1。
strEqFn : NativeFunc
strEqFn =
  rtFunc "str_eq" 0
    [IMov (OpReg Rax) (OpMem Rdi 0), ICmp (OpReg Rax) (OpMem Rsi 0), IJcc "jne" ".Lrt_seq_false", IMov (OpReg Rcx) (OpMem Rdi 0), ILeaMem Rdi Rdi 8, ILeaMem Rsi Rsi 8, ITest Rcx Rcx, IJcc "jz" ".Lrt_seq_true", IRepeCmpsb, IJcc "je" ".Lrt_seq_true", IJmp ".Lrt_seq_false", ILabel ".Lrt_seq_true", IMov (OpReg Rax) (OpImm 1), IRet, ILabel ".Lrt_seq_false", IMov (OpReg Rax) (OpImm 0), IRet]

-- | `!=`：`str_eq` 的结果取反。
strNeqFn : NativeFunc
strNeqFn = rtFunc "str_neq" 0 [ICall (nativeRtLabel "str_eq"), IBin "xor" (OpImm 1), IRet]

-- | `strFromInt`：rdi = Int -> rax = 十进制字符串（含负号）。
strFromIntFn : NativeFunc
strFromIntFn =
  rtFunc "str_from_int" 32
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdi), IMov (OpReg Rax) (OpReg Rdi), IMov (OpReg R9) (OpImm 0), ITest Rax Rax, IJcc "jns" ".Lrt_fi_pos", INeg Rax, IMov (OpReg R9) (OpImm 1), ILabel ".Lrt_fi_pos", IMov (OpMem Rbp (0 - 16)) (OpReg Rax), IMov (OpReg Rcx) (OpImm 1), IMov (OpReg R10) (OpImm 10), ILabel ".Lrt_fi_count", ICmp (OpReg Rax) (OpReg R10), IJcc "jb" ".Lrt_fi_count_done", IBinReg "xor" Rdx (OpReg Rdx), IDivUnsigned R10, IBinReg "add" Rcx (OpImm 1), IJmp ".Lrt_fi_count", ILabel ".Lrt_fi_count_done", IMov (OpReg Rax) (OpReg Rcx), ITest R9 R9, IJcc "jz" ".Lrt_fi_len_ok", IBin "add" (OpImm 1), ILabel ".Lrt_fi_len_ok", IMov (OpMem Rbp (0 - 24)) (OpReg Rax), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "str_alloc"), IMov (OpReg R11) (OpReg Rax), IMov (OpReg Rdx) (OpMem Rbp (0 - 24)), IMov (OpMem R11 0) (OpReg Rdx), IMov (OpReg Rax) (OpMem Rbp (0 - 16)), ILeaMem Rdi R11 8, IBinReg "add" Rdi (OpMem Rbp (0 - 24)), IMov (OpReg R10) (OpImm 10), ILabel ".Lrt_fi_fill", IBinReg "xor" Rdx (OpReg Rdx), IDivUnsigned R10, IBinReg "sub" Rdi (OpImm 1), IBinReg "add" Rdx (OpImm 48), IMovByteRegOp (OpMem Rdi 0) Rdx, ICmp (OpReg Rax) (OpImm 0), IJcc "jne" ".Lrt_fi_fill", ITest R9 R9, IJcc "jz" ".Lrt_fi_done", IBinReg "sub" Rdi (OpImm 1), IMovByteOp (OpMem Rdi 0) 45, ILabel ".Lrt_fi_done", IMov (OpReg Rax) (OpReg R11), IRet]

-- | `strAt`：rdi = 字符串、rsi = 下标 -> rax = 字节值，越界 -1（与 `dtp_strAt` 一致）。
strAtFn : NativeFunc
strAtFn =
  rtFunc "str_at" 0
    [ICmp (OpReg Rsi) (OpImm 0), IJcc "jl" ".Lrt_sat_neg", ICmp (OpReg Rsi) (OpMem Rdi 0), IJcc "jge" ".Lrt_sat_neg", ILeaMem Rdx Rdi 8, IBinReg "add" Rdx (OpReg Rsi), IMovzx Rax (OpMem Rdx 0), IRet, ILabel ".Lrt_sat_neg", IMov (OpReg Rax) (OpImm (0 - 1)), IRet]

-- | `strSubstring start len s`（rdi=start、rsi=len、rdx=s）：夹取到 `[0, n]`。
strSubstringFn : NativeFunc
strSubstringFn =
  rtFunc "str_substring" 32
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdx), IMov (OpReg Rax) (OpMem Rdx 0), IMov (OpMem Rbp (0 - 16)) (OpReg Rax), IMov (OpReg Rax) (OpReg Rdi), ICmp (OpReg Rax) (OpImm 0), IJcc "jge" ".Lrt_ssub_st_hi", IMov (OpReg Rax) (OpImm 0), ILabel ".Lrt_ssub_st_hi", ICmp (OpReg Rax) (OpMem Rbp (0 - 16)), IJcc "jle" ".Lrt_ssub_st_ok", IMov (OpReg Rax) (OpMem Rbp (0 - 16)), ILabel ".Lrt_ssub_st_ok", IMov (OpMem Rbp (0 - 24)) (OpReg Rax), IMov (OpReg Rax) (OpReg Rsi), ICmp (OpReg Rax) (OpImm 0), IJcc "jge" ".Lrt_ssub_ln_hi", IMov (OpReg Rax) (OpImm 0), ILabel ".Lrt_ssub_ln_hi", IMov (OpReg Rcx) (OpMem Rbp (0 - 16)), IBinReg "sub" Rcx (OpMem Rbp (0 - 24)), ICmp (OpReg Rax) (OpReg Rcx), IJcc "jle" ".Lrt_ssub_ln_ok", IMov (OpReg Rax) (OpReg Rcx), ILabel ".Lrt_ssub_ln_ok", IMov (OpMem Rbp (0 - 32)) (OpReg Rax), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "str_alloc"), IMov (OpReg R11) (OpReg Rax), IMov (OpReg Rdx) (OpMem Rbp (0 - 32)), IMov (OpMem R11 0) (OpReg Rdx), ILeaMem Rdi R11 8, IMov (OpReg Rsi) (OpMem Rbp (0 - 8)), IBinReg "add" Rsi (OpImm 8), IBinReg "add" Rsi (OpMem Rbp (0 - 24)), IMov (OpReg Rcx) (OpMem Rbp (0 - 32)), IRepMovsb, IMov (OpReg Rax) (OpReg R11), IRet]

-- | `strHash`：`((h * 33) + c) land 1023`（与 `dtp_strHash` 一致）。
strHashFn : NativeFunc
strHashFn =
  rtFunc "str_hash" 0
    [IMov (OpReg R8) (OpMem Rdi 0), ILeaMem Rsi Rdi 8, IMov (OpReg R9) (OpImm 0), ILabel ".Lrt_hash_loop", ITest R8 R8, IJcc "jz" ".Lrt_hash_done", IMovzx Rax (OpMem Rsi 0), IBinReg "add" Rsi (OpImm 1), IBinReg "sub" R8 (OpImm 1), IMov (OpReg Rcx) (OpImm 33), IBinReg "imul" Rcx (OpReg R9), IBinReg "add" Rcx (OpReg Rax), IBinReg "and" Rcx (OpImm 1023), IMov (OpReg R9) (OpReg Rcx), IJmp ".Lrt_hash_loop", ILabel ".Lrt_hash_done", IMov (OpReg Rax) (OpReg R9), IRet]

-- | `strShow`：rdi = 字符串 -> rax = 带引号、按 `dt_show_string` 转义的新字符串。
--   分配上界 = 2*n + 8（头）+ 2（引号）；填完再回填实际长度。
strShowFn : NativeFunc
strShowFn =
  rtFunc "show_str" 32
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdi), IMov (OpReg Rax) (OpMem Rdi 0), IMov (OpMem Rbp (0 - 16)) (OpReg Rax), IMov (OpReg Rdi) (OpReg Rax), IBinReg "add" Rdi (OpReg Rax), IBinReg "add" Rdi (OpImm 10), ICall (nativeRtLabel "str_alloc"), IMov (OpReg R11) (OpReg Rax), ILeaMem R8 R11 8, IMovByteOp (OpMem R8 0) 34, IBinReg "add" R8 (OpImm 1), IMov (OpReg Rsi) (OpMem Rbp (0 - 8)), IBinReg "add" Rsi (OpImm 8), IMov (OpReg Rcx) (OpMem Rbp (0 - 16)), ILabel ".Lrt_ss_loop", ITest Rcx Rcx, IJcc "jz" ".Lrt_ss_end", IMovzx Rax (OpMem Rsi 0), IBinReg "add" Rsi (OpImm 1), IBinReg "sub" Rcx (OpImm 1), ICmp (OpReg Rax) (OpImm 34), IJcc "je" ".Lrt_ss_quote", ICmp (OpReg Rax) (OpImm 92), IJcc "je" ".Lrt_ss_bslash", ICmp (OpReg Rax) (OpImm 10), IJcc "je" ".Lrt_ss_nl", ICmp (OpReg Rax) (OpImm 9), IJcc "je" ".Lrt_ss_tab", ICmp (OpReg Rax) (OpImm 13), IJcc "je" ".Lrt_ss_cr", IMovByteRegOp (OpMem R8 0) Rax, IBinReg "add" R8 (OpImm 1), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_quote", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 34, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_bslash", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 92, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_nl", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 110, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_tab", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 116, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_cr", IMovByteOp (OpMem R8 0) 92, IMovByteOp (OpMem R8 1) 114, IBinReg "add" R8 (OpImm 2), IJmp ".Lrt_ss_loop", ILabel ".Lrt_ss_end", IMovByteOp (OpMem R8 0) 34, IBinReg "add" R8 (OpImm 1), ILeaMem Rax R11 8, IMov (OpReg Rdx) (OpReg R8), IBinReg "sub" Rdx (OpReg Rax), IMov (OpMem R11 0) (OpReg Rdx), IMov (OpReg Rax) (OpReg R11), IRet]

-- ---------------------------------------------------------------
-- 浮点（IEEE-754 double）
-- ---------------------------------------------------------------
-- 表示与 wasm 的 `$float` struct 同一决策：堆对象 `[f64]`。运算在 xmm 上做。
floatBox : List Instr
floatBox = [IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc"), IXmmStore (OpMem Rax 0) 0]

floatFromIntFn : NativeFunc
floatFromIntFn = rtFunc "float_from_int" 0 (append [IXmmFromInt 0 Rdi] floatBox)

intFromFloatFn : NativeFunc
intFromFloatFn = rtFunc "int_from_float" 0 [IXmmLoad 0 (OpMem Rdi 0), IXmmToInt Rax 0]

floatBinFn : String -> String -> NativeFunc
floatBinFn name op =
  rtFunc name 0
    (append [IXmmLoad 0 (OpMem Rdi 0), IXmmLoad 1 (OpMem Rsi 0), IXmmBin op 0 1] floatBox)

-- | 有序比较：`ucomisd` 之后先看 PF（NaN ⇒ 一律 false）。
floatCmpOrdered : String -> List Instr
floatCmpOrdered cc =
  [ IXmmCmp 0 1,
    ISetcc "setnp" Rax,
    IMovzxAl,
    ISetcc cc Rdx,
    IBinReg "and" Rdx (OpImm 1),
    IBinReg "and" Rax (OpReg Rdx)
  ]

-- | `!=`：NaN 参与时结果为 true（与 OCaml `<>` 一致）。
floatCmpNeq : List Instr
floatCmpNeq =
  [ IXmmCmp 0 1,
    ISetcc "setne" Rax,
    IMovzxAl,
    ISetcc "setp" Rdx,
    IBinReg "and" Rdx (OpImm 1),
    IBinReg "or" Rax (OpReg Rdx)
  ]

floatCmpFn : String -> List Instr -> NativeFunc
floatCmpFn name tail =
  rtFunc name 0 (append [IXmmLoad 0 (OpMem Rdi 0), IXmmLoad 1 (OpMem Rsi 0)] tail)

-- | `abs`：清掉符号位（按位操作，不碰 xmm）。
floatAbsFn : NativeFunc
floatAbsFn =
  rtFunc "float_abs" 8
    [IMov (OpReg Rax) (OpMem Rdi 0), IBinReg "shl" Rax (OpImm 1), IBinReg "shr" Rax (OpImm 1), IMov (OpMem Rbp (0 - 8)) (OpReg Rax), IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc"), IMov (OpReg Rdx) (OpMem Rbp (0 - 8)), IMov (OpMem Rax 0) (OpReg Rdx)]

floatSqrtFn : NativeFunc
floatSqrtFn = rtFunc "float_sqrt" 0 (append [IXmmLoad 0 (OpMem Rdi 0), IXmmUnop "sqrt" 0] floatBox)

-- ---------------------------------------------------------------
-- 效应 handler / 一次性续延（栈拷贝）
-- ---------------------------------------------------------------
-- 运行时表示：
--   * handler 链：`.bss` 里的 `rt_handlers` 指向最内层节点；节点 64 B：
--     `[0]=key [8]=name [16]=ret [24]=opH [32]=当前 comp 栈顶 [40]=prev`
--     `[48]=base_rbp [56]=活动 resume 记录（0 = 无）`。
--   * 续延记录 128 B：`[0]=捕获字节 [8]=字节数 [16]=perform 的 rbp`（`cur_rbp`）、
--     `[24]=used [32]=handler 节点 [40]=perform 时的链顶`、
--     `[48]=resume 调用者 rbp [56]=rsp [64]=返回地址 [72]=r15`、`[80]=恢复值 v`、
--     `[88]=prev_top [96]=new_cur [104]=new_top [112]=delta [120]=捕获时的栈顶`。
--   * 续延闭包 16 B：`[0]=code [8]=续延记录`；调用约定与普通闭包一致（rdi=闭包）。
--
-- `perform` 把 `[cur_rbp, rt_stack_top)` 的**整段栈**（含所有外层 handler 的挂起帧）
-- 拷到堆上，在当前栈上执行 `opH(op, k)`（opH 帧落在捕获区外）。`k v` 把整段栈搬到
-- 堆上的新栈段（保留向下增长的 slack）、平移 rbp 链与 handler 节点的栈地址，把匹配
-- handler 的顶部返回地址改到 `eff_kdone`；`kdone` 应用 `ret` 后撤销平移、恢复栈顶，把
-- 答案交回 `k` 的调用点。opH 不调用 `k` 时，其返回值直接作为 handler answer。
-- 续延是一次性的（`used` 标记）。
handlersLabel : String
handlersLabel = "rt_handlers"

export stackTopLabel : String
stackTopLabel = "rt_stack_top"

unhandledEffectMessage : String
unhandledEffectMessage = "vuna: runtime error: unhandled effect\n"

resumeTwiceMessage : String
resumeTwiceMessage = "vuna: runtime error: continuation already resumed\n"

badStackMessage : String
badStackMessage = "vuna: runtime error: invalid continuation stack\n"

trapUnhandledFn : NativeFunc
trapUnhandledFn =
  rtRawFunc "trap_unhandled_effect"
    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "unhandled_effect"), IMov (OpReg Rdx) (OpImm (strLength unhandledEffectMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

trapResumeTwiceFn : NativeFunc
trapResumeTwiceFn =
  rtRawFunc "trap_resume_twice"
    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "resume_twice"), IMov (OpReg Rdx) (OpImm (strLength resumeTwiceMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

trapBadStackFn : NativeFunc
trapBadStackFn =
  rtRawFunc "trap_bad_stack"
    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "bad_stack"), IMov (OpReg Rdx) (OpImm (strLength badStackMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

-- | `prim_effectPerform key name op`：rdi/rsi/rdx。找到最内层匹配 handler 后拷贝栈，
--   回到 handler 帧调用 `opH(op, k)`，再把它的结果作为 `handle` 的结果返回。
effPerformFn : NativeFunc
effPerformFn =
  rtFunc "eff_perform" 96
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rsi), IMov (OpMem Rbp (nativeSlotOff 2)) (OpReg Rdx), IMov (OpReg Rax) (OpRip handlersLabel), IMov (OpMem Rbp (nativeSlotOff 3)) (OpReg Rax), ILabel ".Lrt_eff_perform_scan", IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 3)), ITest Rax Rax, IJcc "jz" ".Lrt_eff_perform_unhandled", IMov (OpReg Rdi) (OpMem Rax 0), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 0)), ICall (nativeRtLabel "str_eq"), ITest Rax Rax, IJcc "jz" ".Lrt_eff_perform_next", IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 3)), IMov (OpReg Rdi) (OpMem Rax 8), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 1)), ICall (nativeRtLabel "str_eq"), ITest Rax Rax, IJcc "jnz" ".Lrt_eff_perform_found", ILabel ".Lrt_eff_perform_next", IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 3)), IMov (OpReg Rax) (OpMem Rax 40), IMov (OpMem Rbp (nativeSlotOff 3)) (OpReg Rax), IJmp ".Lrt_eff_perform_scan", ILabel ".Lrt_eff_perform_unhandled", ICall (nativeRtLabel "trap_unhandled_effect"), ILabel ".Lrt_eff_perform_found", IMov (OpReg Rax) (OpRip handlersLabel), IMov (OpMem Rbp (nativeSlotOff 4)) (OpReg Rax), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 3)), IMov (OpReg Rcx) (OpMem Rdx 40), IMov (OpRip handlersLabel) (OpReg Rcx), IMov (OpReg Rax) (OpRip stackTopLabel), IMov (OpMem Rbp (nativeSlotOff 9)) (OpReg Rax), IBinReg "sub" Rax (OpReg Rbp), IMov (OpMem Rbp (nativeSlotOff 5)) (OpReg Rax), ICmp (OpReg Rax) (OpImm 0), IJcc "jle" (nativeRtLabel "trap_bad_stack"), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (nativeSlotOff 6)) (OpReg Rax), IMov (OpReg Rdi) (OpReg Rax), IMov (OpReg Rsi) (OpReg Rbp), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 5)), IRepMovsb, IMov (OpReg Rdi) (OpImm 128), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (nativeSlotOff 7)) (OpReg Rax), IMov (OpReg Rdx) (OpReg Rax), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 6)), IMov (OpMem Rdx 0) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 5)), IMov (OpMem Rdx 8) (OpReg Rcx), IMov (OpReg Rcx) (OpReg Rbp), IMov (OpMem Rdx 16) (OpReg Rcx), IMov (OpMem Rdx 24) (OpImm 0), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 3)), IMov (OpMem Rdx 32) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 4)), IMov (OpMem Rdx 40) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 9)), IMov (OpMem Rdx 120) (OpReg Rcx), IMov (OpReg Rdi) (OpImm 16), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (nativeSlotOff 8)) (OpReg Rax), ILea Rcx (nativeRtLabel "eff_resume"), IMov (OpMem Rax 0) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 7)), IMov (OpMem Rax 8) (OpReg Rcx), IMov (OpReg R11) (OpMem Rbp (nativeSlotOff 2)), IMov (OpReg R10) (OpMem Rbp (nativeSlotOff 8)), IMov (OpReg R9) (OpMem Rbp (nativeSlotOff 3)), IMov (OpReg R8) (OpMem R9 24), IMov (OpReg Rdi) (OpReg R8), IMov (OpReg Rsi) (OpReg R11), IMov (OpReg Rdx) (OpReg R10), IMov (OpReg R9) (OpMem Rdi 0), ICallReg R9, IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 3)), IMov (OpReg R8) (OpMem Rcx 56), ITest R8 R8, IJcc "jz" ".Lrt_eff_perform_abort_handle", IMov (OpMem Rcx 56) (OpImm 0), IMov (OpReg R15) (OpReg R8), IMov (OpReg Rdi) (OpReg R8), ICall (nativeRtLabel "eff_unrelocate"), IMov (OpReg Rcx) (OpMem R15 64), IMov (OpReg Rbp) (OpMem R15 48), IMov (OpReg Rsp) (OpMem R15 56), IMov (OpReg R10) (OpMem R15 72), IMov (OpReg R15) (OpReg R10), IJmpReg Rcx, ILabel ".Lrt_eff_perform_abort_handle", IMov (OpReg Rbp) (OpMem Rcx 48), IJmp ".Lrt_eff_handle_abort"]

-- | `prim_effectHandle key name ret opH th u`（6 参，`u` 只作延迟标记）：安装节点、
--   执行 thunk，按需弹出，最后把结果交给 `ret`。
effHandleFn : NativeFunc
effHandleFn =
  rtFunc "eff_handle" 96
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rsi), IMov (OpMem Rbp (nativeSlotOff 2)) (OpReg Rdx), IMov (OpMem Rbp (nativeSlotOff 3)) (OpReg Rcx), IMov (OpMem Rbp (nativeSlotOff 4)) (OpReg R8), IMov (OpReg Rdi) (OpImm 64), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (nativeSlotOff 5)) (OpReg Rax), IMov (OpReg Rdx) (OpReg Rax), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 0)), IMov (OpMem Rdx 0) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 1)), IMov (OpMem Rdx 8) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 2)), IMov (OpMem Rdx 16) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 3)), IMov (OpMem Rdx 24) (OpReg Rcx), ILeaMem Rcx Rbp (nativeSlotOff 11), IMov (OpMem Rdx 32) (OpReg Rcx), IMov (OpReg Rcx) (OpRip handlersLabel), IMov (OpMem Rdx 40) (OpReg Rcx), IMov (OpReg Rcx) (OpReg Rbp), IMov (OpMem Rdx 48) (OpReg Rcx), IMov (OpMem Rdx 56) (OpImm 0), IMov (OpRip handlersLabel) (OpReg Rdx), IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 4)), IMov (OpReg Rsi) (OpImm 0), IMov (OpReg R11) (OpMem Rdi 0), ICallReg R11, IMov (OpMem Rbp (nativeSlotOff 6)) (OpReg Rax), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 5)), IMov (OpReg Rcx) (OpRip handlersLabel), ICmp (OpReg Rcx) (OpReg Rdx), IJcc "jne" ".Lrt_eff_handle_no_pop", IMov (OpReg Rcx) (OpMem Rdx 40), IMov (OpRip handlersLabel) (OpReg Rcx), ILabel ".Lrt_eff_handle_no_pop", IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 2)), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 6)), IMov (OpReg R11) (OpMem Rdi 0), ICallReg R11, ILabel ".Lrt_eff_handle_abort"]

-- | 把 `[lo, hi)` 内的栈地址（handler 节点 base_rsp / base_rbp）平移 `delta`。
--   `rdi` = 续延记录（先处理 record.node），随后沿 `rt_handlers` 链处理；`rsi` = lo、
--   `rdx` = hi、`rcx` = delta。只改节点里的栈地址；保留 rax / rbp / rsp / r15 / rdi。
effTranslateNodesFn : NativeFunc
effTranslateNodesFn =
  rtRawFunc "eff_translate_nodes"
    [IMov (OpReg R8) (OpMem Rdi 32), IMov (OpReg R9) (OpMem R8 32), ICmp (OpReg R9) (OpReg Rsi), IJcc "jb" ".Lrt_translate_rec_rsp", ICmp (OpReg R9) (OpReg Rdx), IJcc "jae" ".Lrt_translate_rec_rsp", IBinReg "add" R9 (OpReg Rcx), IMov (OpMem R8 32) (OpReg R9), ILabel ".Lrt_translate_rec_rsp", IMov (OpReg R9) (OpMem R8 48), ICmp (OpReg R9) (OpReg Rsi), IJcc "jb" ".Lrt_translate_rec_rbp", ICmp (OpReg R9) (OpReg Rdx), IJcc "jae" ".Lrt_translate_rec_rbp", IBinReg "add" R9 (OpReg Rcx), IMov (OpMem R8 48) (OpReg R9), ILabel ".Lrt_translate_rec_rbp", IMov (OpReg R8) (OpRip handlersLabel), ILabel ".Lrt_translate_nodes_loop", ITest R8 R8, IJcc "jz" ".Lrt_translate_nodes_done", IMov (OpReg R9) (OpMem R8 32), ICmp (OpReg R9) (OpReg Rsi), IJcc "jb" ".Lrt_translate_node_rsp", ICmp (OpReg R9) (OpReg Rdx), IJcc "jae" ".Lrt_translate_node_rsp", IBinReg "add" R9 (OpReg Rcx), IMov (OpMem R8 32) (OpReg R9), ILabel ".Lrt_translate_node_rsp", IMov (OpReg R9) (OpMem R8 48), ICmp (OpReg R9) (OpReg Rsi), IJcc "jb" ".Lrt_translate_node_rbp", ICmp (OpReg R9) (OpReg Rdx), IJcc "jae" ".Lrt_translate_node_rbp", IBinReg "add" R9 (OpReg Rcx), IMov (OpMem R8 48) (OpReg R9), ILabel ".Lrt_translate_node_rbp", IMov (OpReg R8) (OpMem R8 40), IJmp ".Lrt_translate_nodes_loop", ILabel ".Lrt_translate_nodes_done", IRet]

-- | 撤销一次 resume 的栈迁移：节点地址按 -delta 平移，`rt_stack_top` 恢复为 prev_top。
--   `rdi` = 续延记录；保留 rax（answer）。
effUnrelocateFn : NativeFunc
effUnrelocateFn =
  rtRawFunc "eff_unrelocate"
    [IMov (OpReg Rcx) (OpMem Rdi 112), INeg Rcx, IMov (OpReg Rsi) (OpMem Rdi 96), IMov (OpReg Rdx) (OpMem Rdi 104), ICall (nativeRtLabel "eff_translate_nodes"), IMov (OpReg Rcx) (OpMem Rdi 88), IMov (OpRip stackTopLabel) (OpReg Rcx), IRet]

-- | 续延闭包体：`rdi` = 闭包、`rsi` = v。把 `[perform_rbp, rt_stack_top)` 整段
--   （含外层 handler 的挂起帧）拷到新栈段，平移 rbp 链与节点栈地址，把匹配 handler 的
--   顶部返回地址改到 `eff_kdone`，再从 perform 的返回点继续。
effResumeFn : NativeFunc
effResumeFn =
  rtRawFunc "eff_resume"
    [IMov (OpReg R8) (OpMem Rdi 8), IMov (OpReg Rax) (OpMem R8 24), ITest Rax Rax, IJcc "jnz" ".Lrt_eff_resume_used", IMov (OpMem R8 24) (OpImm 1), IMov (OpMem R8 48) (OpReg Rbp), ILeaMem Rax Rsp 8, IMov (OpMem R8 56) (OpReg Rax), IMov (OpReg Rax) (OpMem Rsp 0), IMov (OpMem R8 64) (OpReg Rax), IMov (OpMem R8 72) (OpReg R15), IMov (OpMem R8 80) (OpReg Rsi), IMov (OpReg R15) (OpReg R8), IMov (OpReg R9) (OpMem R8 16), IMov (OpReg R10) (OpMem R8 8), IMov (OpReg R11) (OpMem R8 120), IMov (OpReg Rdi) (OpReg R10), IBinReg "add" Rdi (OpImm 524304), ICall (nativeRtLabel "alloc"), IMov (OpReg R9) (OpMem R15 16), IMov (OpReg R10) (OpMem R15 8), IMov (OpReg Rdi) (OpReg Rax), IBinReg "add" Rdi (OpImm 524288), IBinReg "add" Rdi (OpReg R10), IBinReg "add" Rdi (OpImm 15), IBinReg "and" Rdi (OpImm (0 - 16)), IMov (OpReg Rsi) (OpReg Rdi), IBinReg "sub" Rsi (OpReg R10), IMov (OpReg Rcx) (OpReg Rsi), IBinReg "sub" Rcx (OpReg R9), IMov (OpReg Rax) (OpRip stackTopLabel), IMov (OpMem R15 88) (OpReg Rax), IMov (OpMem R15 96) (OpReg Rsi), IMov (OpMem R15 104) (OpReg Rdi), IMov (OpMem R15 112) (OpReg Rcx), IMov (OpReg Rdi) (OpReg Rsi), IMov (OpReg Rsi) (OpMem R15 0), IMov (OpReg Rcx) (OpReg R10), IRepMovsb, IMov (OpReg Rax) (OpMem R15 40), IMov (OpRip handlersLabel) (OpReg Rax), IMov (OpReg Rcx) (OpMem R15 112), IMov (OpReg Rdx) (OpMem R15 120), IMov (OpReg R8) (OpMem R15 96), IMov (OpReg R10) (OpMem R15 104), IMov (OpReg Rsi) (OpMem R15 96), ILabel ".Lrt_eff_resume_reloc", ICmp (OpReg R8) (OpReg R10), IJcc "jae" ".Lrt_eff_resume_reloc_done", ICmp (OpReg R8) (OpReg Rsi), IJcc "jb" ".Lrt_eff_resume_reloc_done", IMov (OpReg R11) (OpMem R8 0), ICmp (OpReg R11) (OpReg R9), IJcc "jb" ".Lrt_eff_resume_reloc_next", ICmp (OpReg R11) (OpReg Rdx), IJcc "jae" ".Lrt_eff_resume_reloc_next", IBinReg "add" R11 (OpReg Rcx), IMov (OpMem R8 0) (OpReg R11), ILabel ".Lrt_eff_resume_reloc_next", IMov (OpReg R8) (OpReg R11), IJmp ".Lrt_eff_resume_reloc", ILabel ".Lrt_eff_resume_reloc_done", IMov (OpReg Rdi) (OpReg R15), IMov (OpReg Rsi) (OpMem R15 16), IMov (OpReg Rdx) (OpMem R15 120), IMov (OpReg Rcx) (OpMem R15 112), ICall (nativeRtLabel "eff_translate_nodes"), IMov (OpReg Rax) (OpMem R15 32), IMov (OpReg R8) (OpMem Rax 32), IBinReg "sub" R8 (OpImm 8), ILea Rax (nativeRtLabel "eff_kdone"), IMov (OpMem R8 0) (OpReg Rax), IMov (OpReg Rax) (OpMem R15 32), IMov (OpMem Rax 56) (OpReg R15), IMov (OpReg Rax) (OpMem R15 104), IMov (OpRip stackTopLabel) (OpReg Rax), IMov (OpReg R8) (OpMem R15 96), IMov (OpReg Rax) (OpMem R15 80), IMov (OpReg Rcx) (OpMem R8 8), IMov (OpReg Rbp) (OpMem R8 0), IMov (OpReg Rsp) (OpReg R8), IBinReg "add" Rsp (OpImm 16), IJmpReg Rcx, ILabel ".Lrt_eff_resume_used", ICall (nativeRtLabel "trap_resume_twice")]

-- | comp 在续延恢复后正常结束：按需弹掉 handler，应用 `ret`，撤销栈迁移，把答案交回
--   `k` 的调用点。
effKdoneFn : NativeFunc
effKdoneFn =
  rtRawFunc "eff_kdone"
    [IMov (OpReg R8) (OpMem R15 32), IMov (OpReg R9) (OpRip handlersLabel), ICmp (OpReg R9) (OpReg R8), IJcc "jne" ".Lrt_eff_kdone_no_pop", IMov (OpReg R9) (OpMem R8 40), IMov (OpRip handlersLabel) (OpReg R9), ILabel ".Lrt_eff_kdone_no_pop", IMov (OpReg R9) (OpMem R8 56), ICmp (OpReg R9) (OpReg R15), IJcc "jne" ".Lrt_eff_kdone_keep_ctx", IMov (OpMem R8 56) (OpImm 0), ILabel ".Lrt_eff_kdone_keep_ctx", IMov (OpReg Rsi) (OpReg Rax), IMov (OpReg Rdi) (OpMem R8 16), IMov (OpReg R11) (OpMem Rdi 0), ICallReg R11, IMov (OpReg Rdi) (OpReg R15), ICall (nativeRtLabel "eff_unrelocate"), IMov (OpReg Rcx) (OpMem R15 64), IMov (OpReg Rbp) (OpMem R15 48), IMov (OpReg Rsp) (OpMem R15 56), IMov (OpReg R10) (OpMem R15 72), IMov (OpReg R15) (OpReg R10), IJmpReg Rcx]

-- ---------------------------------------------------------------
-- 效应原语（宿主层叶子 + IORef）
-- ---------------------------------------------------------------
-- `Eff` 的运行时壳是 base 的 `MkEff` data；这些原语只负责「做一次宿主操作」。
-- 续延（`prim_effectPerform` / `prim_effectHandle`）需要栈捕获，仍不支持。
-- | `IORef` 单元：一个 8 字节槽（`[value]`）。
effNewRefFn : NativeFunc
effNewRefFn =
  rtFunc "prim_eff_new_ref" 8
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdi), IMov (OpReg Rdi) (OpImm 8), ICall (nativeRtLabel "alloc"), IMov (OpReg Rdx) (OpMem Rbp (0 - 8)), IMov (OpMem Rax 0) (OpReg Rdx)]

effReadRefFn : NativeFunc
effReadRefFn = rtFunc "prim_eff_read_ref" 0 [IMov (OpReg Rax) (OpMem Rdi 0)]

effWriteRefFn : NativeFunc
effWriteRefFn =
  rtFunc "prim_eff_write_ref" 0 [IMov (OpMem Rdi 0) (OpReg Rsi), IMov (OpReg Rax) (OpImm 0)]

-- | `print` / `eprint`：写 fd 后返回写出的字节数（OCaml 侧返回 `String.length`）。
effPrintFn : String -> Int -> NativeFunc
effPrintFn name fd =
  rtFunc name 0
    [IMov (OpReg Rdx) (OpMem Rdi 0), ILeaMem Rsi Rdi 8, IMov (OpReg Rdi) (OpImm fd), IMov (OpReg Rax) (OpImm 1), ISyscall]

-- | `prim_erase`：运行时恒等（擦除 cast）。
eraseFn : NativeFunc
eraseFn = rtFunc "prim_erase" 0 [IMov (OpReg Rax) (OpReg Rdi)]

effExitFn : NativeFunc
effExitFn = rtFunc "prim_eff_exit" 0 [IMov (OpReg Rax) (OpImm 60), ISyscall, IRet]

-- ---------------------------------------------------------------
-- 数组（不可变、copy-on-write）
-- ---------------------------------------------------------------
-- 布局与 wasm 侧同一决策：`[len][elem0][elem1]...`，每个元素一个机器字
-- （Int 未装箱；String / 对象 / 闭包都是指针）。`arraySet` 复制整块再写，原数组不变。
arrayLengthFn : NativeFunc
arrayLengthFn = rtFunc "array_length" 0 [IMov (OpReg Rax) (OpMem Rdi 0)]

-- | `arrayGet`：rdi = 数组、rsi = 下标 -> rax = 元素；越界 trap（exit 2）。
arrayGetFn : NativeFunc
arrayGetFn =
  rtFunc "array_get" 0
    [ICmp (OpReg Rsi) (OpImm 0), IJcc "jl" (nativeRtLabel "trap_array_oob"), ICmp (OpReg Rsi) (OpMem Rdi 0), IJcc "jge" (nativeRtLabel "trap_array_oob"), IBinReg "shl" Rsi (OpImm 3), ILeaMem Rdx Rdi 8, IMov (OpReg Rax) (OpMemX Rdx Rsi 0)]

-- | `arraySet`：rdi = 数组、rsi = 下标、rdx = 新值 -> rax = 新数组。
arraySetFn : NativeFunc
arraySetFn =
  rtFunc "array_set" 64
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdi), IMov (OpMem Rbp (0 - 16)) (OpReg Rsi), IMov (OpMem Rbp (0 - 24)) (OpReg Rdx), ICmp (OpReg Rsi) (OpImm 0), IJcc "jl" (nativeRtLabel "trap_array_oob"), ICmp (OpReg Rsi) (OpMem Rdi 0), IJcc "jge" (nativeRtLabel "trap_array_oob"), IMov (OpReg Rcx) (OpMem Rdi 0), IMov (OpMem Rbp (0 - 32)) (OpReg Rcx), IMov (OpReg Rdi) (OpReg Rcx), IBinReg "add" Rdi (OpImm 1), IBinReg "shl" Rdi (OpImm 3), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (0 - 40)) (OpReg Rax), IMov (OpReg Rcx) (OpMem Rbp (0 - 32)), IMov (OpMem Rax 0) (OpReg Rcx), ILeaMem Rdi Rax 8, IMov (OpReg Rsi) (OpMem Rbp (0 - 8)), ILeaMem Rsi Rsi 8, IBinReg "shl" Rcx (OpImm 3), IRepMovsb, IMov (OpReg Rax) (OpMem Rbp (0 - 40)), IMov (OpReg Rdx) (OpMem Rbp (0 - 24)), IMov (OpReg Rcx) (OpMem Rbp (0 - 16)), IBinReg "shl" Rcx (OpImm 3), ILeaMem Rax Rax 8, IMov (OpMemX Rax Rcx 0) (OpReg Rdx), IMov (OpReg Rax) (OpMem Rbp (0 - 40))]

-- | `arrayMake`：rdi = 长度、rsi = 初值 -> rax = 新数组。
arrayMakeFn : NativeFunc
arrayMakeFn =
  rtFunc "array_make" 48
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdi), IMov (OpMem Rbp (0 - 16)) (OpReg Rsi), IMov (OpReg Rdi) (OpReg Rdi), IBinReg "add" Rdi (OpImm 1), IBinReg "shl" Rdi (OpImm 3), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (0 - 24)) (OpReg Rax), IMov (OpReg Rcx) (OpMem Rbp (0 - 8)), IMov (OpMem Rax 0) (OpReg Rcx), IMov (OpReg Rdx) (OpReg Rax), ILeaMem Rdx Rdx 8, IMov (OpReg Rax) (OpMem Rbp (0 - 16)), IMov (OpReg R8) (OpImm 0), ILabel ".Lrt_array_make_fill", ICmp (OpReg R8) (OpMem Rbp (0 - 8)), IJcc "jge" ".Lrt_array_make_done", IMov (OpMem Rdx 0) (OpReg Rax), IBinReg "add" Rdx (OpImm 8), IBinReg "add" R8 (OpImm 1), IJmp ".Lrt_array_make_fill", ILabel ".Lrt_array_make_done", IMov (OpReg Rax) (OpMem Rbp (0 - 24))]

-- ---------------------------------------------------------------
-- 入口打印
-- ---------------------------------------------------------------
-- | 十进制打印 rdi（含负号）+ 换行。缓冲在 rbp-64..rbp-1。
printIntFn : NativeFunc
printIntFn =
  rtFunc "print_int" 64
    [IMov (OpReg R8) (OpReg Rdi), IMov (OpReg R9) (OpImm 0), ITest R8 R8, IJcc "jns" ".Lrt_pi_pos", INeg R8, IMov (OpReg R9) (OpImm 1), ILabel ".Lrt_pi_pos", IMov (OpReg Rcx) (OpReg Rbp), IMov (OpReg Rax) (OpReg R8), IMov (OpReg R10) (OpImm 10), ITest Rax Rax, IJcc "jne" ".Lrt_pi_loop", IBinReg "sub" Rcx (OpImm 1), IMov (OpReg Rdx) (OpImm 48), IMovByteRegOp (OpMem Rcx 0) Rdx, IJmp ".Lrt_pi_sign", ILabel ".Lrt_pi_loop", IBinReg "xor" Rdx (OpReg Rdx), IDivUnsigned R10, IBinReg "add" Rdx (OpImm 48), IBinReg "sub" Rcx (OpImm 1), IMovByteRegOp (OpMem Rcx 0) Rdx, ITest Rax Rax, IJcc "jne" ".Lrt_pi_loop", ILabel ".Lrt_pi_sign", ITest R9 R9, IJcc "jz" ".Lrt_pi_write", IBinReg "sub" Rcx (OpImm 1), IMov (OpReg Rdx) (OpImm 45), IMovByteRegOp (OpMem Rcx 0) Rdx, ILabel ".Lrt_pi_write", ILeaMem Rdx Rbp 0, IBinReg "sub" Rdx (OpReg Rcx), IMov (OpReg Rsi) (OpReg Rcx), IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 1), ISyscall, IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 1), ILea Rsi (nativeDataLabel "nl"), IMov (OpReg Rdx) (OpImm 1), ISyscall, IRet]

-- | 打印 rdi 为 True/False + 换行。
printBoolFn : NativeFunc
printBoolFn =
  rtFunc "print_bool" 0
    [ILea Rsi (nativeDataLabel "false"), IMov (OpReg Rdx) (OpImm (strLength "False")), ITest Rdi Rdi, IJcc "jz" ".Lrt_pb_write", ILea Rsi (nativeDataLabel "true"), IMov (OpReg Rdx) (OpImm (strLength "True")), ILabel ".Lrt_pb_write", IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 1), ISyscall, IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 1), ILea Rsi (nativeDataLabel "nl"), IMov (OpReg Rdx) (OpImm 1), ISyscall, IRet]

-- | 打印 rdi 为 String（原样字节）+ 换行。
printStrFn : NativeFunc
printStrFn =
  rtFunc "print_str" 0
    [IMov (OpReg Rdx) (OpMem Rdi 0), ILeaMem Rsi Rdi 8, IMov (OpReg Rdi) (OpImm 1), IMov (OpReg Rax) (OpImm 1), ISyscall, IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 1), ILea Rsi (nativeDataLabel "nl"), IMov (OpReg Rdx) (OpImm 1), ISyscall, IRet]

-- | 对象分配：`rdi` = 字节数 -> `rax` = 新对象地址；越过堆尾则 trap OOM。
allocFn : NativeFunc
allocFn =
  rtRawFunc "alloc"
    [IMov (OpReg R11) (OpReg Rdi), IMov (OpReg Rax) (OpRip nativeHeapPtrLabel), IMov (OpReg Rcx) (OpReg Rax), IBinReg "add" Rcx (OpReg R11), IMov (OpReg Rdx) (OpRip nativeArenaEndLabel), ICmp (OpReg Rcx) (OpReg Rdx), IJcc "jbe" ".Lrt_alloc_ok", IMov (OpReg Rax) (OpImm 9), IMov (OpReg Rdi) (OpImm 0), IMov (OpReg Rsi) (OpImm nativeHeapBytes), IMov (OpReg Rdx) (OpImm 3), IMov (OpReg R10) (OpImm 34), IMov (OpReg R8) (OpImm (0 - 1)), IMov (OpReg R9) (OpImm 0), ISyscall, IMov (OpRip nativeHeapPtrLabel) (OpReg Rax), IMov (OpReg Rcx) (OpReg Rax), IBinReg "add" Rcx (OpImm nativeHeapBytes), IMov (OpRip nativeArenaEndLabel) (OpReg Rcx), IMov (OpReg Rax) (OpRip nativeHeapPtrLabel), IMov (OpReg Rcx) (OpReg Rax), IBinReg "add" Rcx (OpReg R11), ILabel ".Lrt_alloc_ok", IMov (OpRip nativeHeapPtrLabel) (OpReg Rcx), IRet]

trapImpossibleFn : NativeFunc
trapImpossibleFn =
  rtRawFunc "trap_impossible"
    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "impossible"), IMov (OpReg Rdx) (OpImm (strLength impossibleMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

trapDivZeroFn : NativeFunc
trapDivZeroFn =
  rtRawFunc "trap_divzero"
    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "divzero"), IMov (OpReg Rdx) (OpImm (strLength divZeroMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

trapArrayOobFn : NativeFunc
trapArrayOobFn =
  rtRawFunc "trap_array_oob"
    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "array_oob"), IMov (OpReg Rdx) (OpImm (strLength arrayOobMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

trapOomFn : NativeFunc
trapOomFn =
  rtRawFunc "trap_oom"
    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "oom"), IMov (OpReg Rdx) (OpImm (strLength oomMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

-- ---------------------------------------------------------------
-- 断言 / 未实现占位 / 显式失败
-- ---------------------------------------------------------------
-- 失败报告协议（与 OCaml 报告器 `dt_report_exn` 的第一行一致）：
--   stderr `vuna: runtime error: <msg>\n`，exit 2。
--
-- 失败路径**不分配**（不走 `str_concat`）：前缀是 `.rodata` 裸文本，msg 是带长度头的
-- 字符串。因此逐段 write syscall，避免把裸 rodata 当字符串对象传给分配器。
-- | 写一段裸 rodata：fd=2。
writeErrRaw : String -> Int -> List Instr
writeErrRaw label len =
  [ IMov (OpReg Rax) (OpImm 1),
    IMov (OpReg Rdi) (OpImm 2),
    ILea Rsi label,
    IMov (OpReg Rdx) (OpImm len),
    ISyscall
  ]

-- | 写 r8 指向的字符串对象（长度取自 [r8]，数据从 r8+8 起）。
writeErrMsg : List Instr
writeErrMsg =
  [ IMov (OpReg Rdx) (OpMem R8 0),
    ILeaMem Rsi R8 8,
    IMov (OpReg Rax) (OpImm 1),
    IMov (OpReg Rdi) (OpImm 2),
    ISyscall
  ]

-- | 写报错换行 + exit 2。
errFinish : List Instr
errFinish =
  [ IMov (OpReg Rax) (OpImm 1),
    IMov (OpReg Rdi) (OpImm 2),
    ILea Rsi (nativeDataLabel "nl"),
    IMov (OpReg Rdx) (OpImm 1),
    ISyscall,
    IMov (OpReg Rax) (OpImm 60),
    IMov (OpReg Rdi) (OpImm 2),
    ISyscall
  ]

-- | `vuna: runtime error: ` + prefix + msg + `\n` + exit 2；`rdi` = msg（入口保存到 r8）。
trapWithPrefix : String -> Int -> List Instr
trapWithPrefix label len =
  append [IMov (OpReg R8) (OpReg Rdi)]
    (append (writeErrRaw (nativeDataLabel "err_prefix") (strLength errPrefix)) (append (writeErrRaw label len) (append writeErrMsg errFinish)))

-- | `prim_fail msg`（以及无前缀的失败）：`vuna: runtime error: ` + msg + `\n` + exit 2。
trapMsgFn : NativeFunc
trapMsgFn =
  rtRawFunc "trap_msg"
    (append [IMov (OpReg R8) (OpReg Rdi)] (append (writeErrRaw (nativeDataLabel "err_prefix") (strLength errPrefix)) (append writeErrMsg errFinish)))

-- | `assert False msg _` 的失败路径：`vuna: runtime error: assertion failed: msg\n` + exit 2。
trapAssertFn : NativeFunc
trapAssertFn =
  rtRawFunc "trap_assert"
    (trapWithPrefix (nativeDataLabel "assert_prefix") (strLength assertPrefix))

-- | `todo msg` 的失败路径：`vuna: runtime error: TODO: msg\n` + exit 2。
trapTodoFn : NativeFunc
trapTodoFn =
  rtRawFunc "trap_todo" (trapWithPrefix (nativeDataLabel "todo_prefix") (strLength todoPrefix))

-- | `assert cond msg x`（rdi=cond 0/1、rsi=msg、rdx=x）→ 成功返回 x；失败跳 trap_assert。
assertFn : NativeFunc
assertFn =
  rtFunc "assert" 0
    [ICmp (OpReg Rdi) (OpImm 0), IJcc "je" ".Lrt_assert_fail", IMov (OpReg Rax) (OpReg Rdx), IRet, ILabel ".Lrt_assert_fail", IMov (OpReg Rdi) (OpReg Rsi), IJmp (nativeRtLabel "trap_assert")]

-- | `prim_fail msg`：直接把 msg 交给 `trap_msg`。
primFailFn : NativeFunc
primFailFn = rtFunc "prim_fail" 0 [IJmp (nativeRtLabel "trap_msg")]

-- | `todo msg`：直接把 msg 交给 `trap_todo`。
todoFn : NativeFunc
todoFn = rtFunc "todo" 0 [IJmp (nativeRtLabel "trap_todo")]

