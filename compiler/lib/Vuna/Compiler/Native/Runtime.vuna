-- | 以**运行时值**（非 `IrRtApp`）出现的符号的 arity（`irInlineArity` 为 0 的那些）。
--   `IrApp (IrRt sym) args` 只有饱和到这个 arity 才生成调用；部分应用仍拒绝。
export nativeRtValueArity : String -> Int
nativeRtValueArity "strFromInt" = 1
nativeRtValueArity "strLength" = 1
nativeRtValueArity "strHash" = 1
nativeRtValueArity "strShow" = 1
nativeRtValueArity "strAt" = 2
nativeRtValueArity "strSubstring" = 3
nativeRtValueArity "bi_eq_str" = 2
nativeRtValueArity "bi_neq_str" = 2
nativeRtValueArity _ = 0
