module Vuna.Compiler.Native.Runtime where

-- native 运行时函数（汇编模板）+ IR 符号映射。
--
-- 运行时按 `Ir.Runtime` 契约的符号名实现；白名单之外的符号由 `Native.Module` 拒绝
-- （编译期 `NativeUnsupported`），不做「trap 兜底」。
--
-- 语义参考实现是 `Vuna.Compiler.Codegen.Term` 的 `bi_*` / `dt_show_*` / `dtp_*` 模板：
--   * Int/Nat 是 63-bit 有符号；`+ - *` wrap，`/` 向零截断、除零 exit 2；
--   * Bool 是 0/1；`&&`/`||` 的短路由 `Native.Module` 生成控制流，不在运行时；
--   * Nat 的加法/乘法饱和到 max_int，减法下溢到 0；
--   * String 是**指向长度头的指针**（`[p]` = 字节数，字节从 `p+8` 起），不可变，
--     所有构造都从堆分配新对象；
--   * 堆对象前有 8 字节块头（尺寸类 + 标记/空闲/叶子/钉住标志）；堆段由
--     `Native.Gc` 的保守标记-清扫回收，预算按 live 字节计；
--   * 入口打印格式与 OCaml 的 `print_endline (show main)` 一致（String 走 `show`，
--     即带引号与转义的调试形态）。
--
-- 边界：只 import Base 与 `Native.{Model,Abi,Gc}`。
import Base.Bool
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.String
import Vuna.Compiler.Native.Abi
import Vuna.Compiler.Native.Gc
import Vuna.Compiler.Native.Model

-- ---------------------------------------------------------------
-- 常量与只读数据
-- ---------------------------------------------------------------
-- | 63-bit 有符号的上界（与 OCaml `max_int` / `irNatChainMax` 一致）。
nativeMaxInt : Int
nativeMaxInt = 4611686018427387903

divZeroMessage : String
divZeroMessage = "vuna: runtime error: division by zero\n"

oomMessage : String
oomMessage = "vuna: runtime error: out of memory\n"

-- | 内存预算耗尽（`VUNA_NATIVE_MEM_LIMIT`）：与真的 `mmap` 失败分开，便于定位。
memLimitMessage : String
memLimitMessage = "vuna: runtime error: memory limit exceeded\n"

-- | 总超时（`VUNA_NATIVE_TIMEOUT_MS`）：SIGALRM 到点。
timeoutMessage : String
timeoutMessage = "vuna: runtime error: timeout exceeded\n"

-- | 默认内存预算：1 GiB。口径见 `docs/reference/native.md` §5：`.bss` 堆的**累计**分配
--   （arena 不回收）+ 续延捕获缓冲的**活跃**字节。
export nativeMemDefaultBytes : Int
nativeMemDefaultBytes = 1073741824

-- | 限制相关的 env 键与路径（NUL 结尾；启动时直接在 `envp` 上扫描，不经过分配器）。
memLimitKey : String
memLimitKey = "VUNA_NATIVE_MEM_LIMIT" ++ strPack [0]

timeoutKey : String
timeoutKey = "VUNA_NATIVE_TIMEOUT_MS" ++ strPack [0]

cpusKey : String
cpusKey = "VUNA_NATIVE_CPUS" ++ strPack [0]

inheritKey : String
inheritKey = "VUNA_NATIVE_INHERIT" ++ strPack [0]

-- | 子进程默认不继承的 env 前缀（`VUNA_NATIVE_INHERIT=1` 时原样传）。
nativeEnvPrefix : String
nativeEnvPrefix = "VUNA_NATIVE_" ++ strPack [0]

cgroupCpuMaxPath : String
cgroupCpuMaxPath = "/sys/fs/cgroup/cpu.max" ++ strPack [0]

-- | 生效的内存预算（live 字节；0 = 不限）。
memLimitLabel : String
memLimitLabel = "rt_mem_limit"

-- | 生效的核数上限（0 = 不限；启动时算出的快照，仅诊断用）。
cpuCountLabel : String
cpuCountLabel = "rt_cpus"

-- | `rt_sigaction(SIGALRM)` 的 act（handler / flags / restorer / mask，32 B）。
sigActLabel : String
sigActLabel = "rt_sigact"

-- | `setitimer` 的 `struct itimerval`（interval + value，32 B）。
itimerLabel : String
itimerLabel = "rt_itimer"

-- | `sched_getaffinity` / `sched_setaffinity` 的 1024-bit cpu_set_t（128 B）。
cpuCurLabel : String
cpuCurLabel = "rt_cpu_cur"

cpuNewLabel : String
cpuNewLabel = "rt_cpu_new"

-- | cgroup v2 `cpu.max` 的读取缓冲。
cgBufLabel : String
cgBufLabel = "rt_cg_buf"

-- | `runIn` / `spawn` 子进程的 envp（去掉 `VUNA_NATIVE_*`）。
envChildLabel : String
envChildLabel = "rt_env_child"

-- 运行时错误报告器的统一前缀（与 OCaml 报告器 `dt_report_exn` 的输出逐字对齐）。
errPrefix : String
errPrefix = "vuna: runtime error: "

assertPrefix : String
assertPrefix = "assertion failed: "

todoPrefix : String
todoPrefix = "TODO: "

impossibleMessage : String
impossibleMessage = "vuna: runtime error: impossible branch\n"

-- | 数组越界：与 OCaml `Invalid_argument ("index out of bounds")` 的报告器文本一致
--   （native 没有位置表，因此没有 OCaml 报告器那行 `at ...`）。
arrayOobMessage : String
arrayOobMessage = "vuna: runtime error: Invalid_argument(\"index out of bounds\")\n"

export nativeRodata : List NativeRodata
nativeRodata =
  append
    [NativeRodata (nativeDataLabel "true") "True", NativeRodata (nativeDataLabel "false") "False", NativeRodata (nativeDataLabel "nl") "\n", NativeRodata (nativeDataLabel "divzero") divZeroMessage, NativeRodata (nativeDataLabel "oom") oomMessage, NativeRodata (nativeDataLabel "mem_limit") memLimitMessage, NativeRodata (nativeDataLabel "timeout") timeoutMessage, NativeRodata (nativeDataLabel "err_prefix") errPrefix, NativeRodata (nativeDataLabel "assert_prefix") assertPrefix, NativeRodata (nativeDataLabel "todo_prefix") todoPrefix, NativeRodata (nativeDataLabel "impossible") impossibleMessage, NativeRodata (nativeDataLabel "array_oob") arrayOobMessage, NativeRodata (nativeDataLabel "unhandled_effect") unhandledEffectMessage, NativeRodata (nativeDataLabel "resume_twice") resumeTwiceMessage, NativeRodata (nativeDataLabel "bad_stack") badStackMessage, NativeRodata (nativeDataLabel "stack_overflow") stackOverflowMessage, NativeRodata (nativeDataLabel "proc_self_exe") ("/proc/self/exe" ++ strPack [0]), NativeRodata (nativeDataLabel "tmp_suffix") (".tmp" ++ strPack [0]), NativeRodata (nativeDataLabel "sh_path") ("/bin/sh" ++ strPack [0]), NativeRodata (nativeDataLabel "sh_dash_c") ("-c" ++ strPack [0]), NativeRodata (nativeDataLabel "env_mem_limit") memLimitKey, NativeRodata (nativeDataLabel "env_timeout") timeoutKey, NativeRodata (nativeDataLabel "env_cpus") cpusKey, NativeRodata (nativeDataLabel "env_inherit") inheritKey, NativeRodata (nativeDataLabel "env_prefix") nativeEnvPrefix, NativeRodata (nativeDataLabel "cg_cpu_max") cgroupCpuMaxPath]
    nativeGcRodata

-- | `_start` 从初始栈拷下来的进程入参（`argc` / `argv` / `envp`）。
export argcLabel : String
argcLabel = "rt_argc"

export argvLabel : String
argvLabel = "rt_argv"

export envpLabel : String
envpLabel = "rt_envp"

-- | 宿主状态槽：fs / process 的 `try*` 原语把 errno 风格的状态码留在这里，
--   `@vuna@prim_eff_hostStatus` 读它（0 = 成功）。
export hostStatusLabel : String
hostStatusLabel = "rt_host_status"

-- | `getcwd` / `readlink` 的路径缓冲。
export pathBufLabel : String
pathBufLabel = "rt_path_buf"

-- | `clock_gettime` / `nanosleep` 的 timespec（16 B）与 `ioctl(TCGETS)` 的 termios 缓冲。
export tsLabel : String
tsLabel = "rt_ts"

export termiosLabel : String
termiosLabel = "rt_termios"

-- | `bracket` / `finally` 的 cleanup 登记表（LIFO 链表头；`prim_cleanupPush/Pop` 维护）。
export cleanupHeadLabel : String
cleanupHeadLabel = nativeCleanupHeadLabel

-- | `resume` 迁移栈段的向下可用空间（字节）。段按 `pow2_ceil(len + slack + 16)` 预留，
--   页惰性提交：嵌套 handler 各占一段时，只有真正用到的页计入 RSS。
export nativeSegSlackBytes : Int
nativeSegSlackBytes = 33554432

-- | 迁移栈段的专用地址区间起点。栈段必须**远离 arena / 堆**（`mmap(NULL)` 的 0x7f... 一带）：
--   `effResume` 的重定位是保守扫描——落在 `(perform_rbp, stack_top)` 里的字一律当栈指针
--   平移，堆指针如果也在这个区间里就会被误平移。固定高地址区间让两者不相交。
export nativeStackArenaBase : Int
nativeStackArenaBase = 35184372088832

-- | 栈段区间的 bump 指针（0 = 尚未使用）。
export stackArenaLabel : String
stackArenaLabel = "rt_stack_arena"

-- | 第二个路径缓冲（`rename` / `symlink` / 原子写的 tmp 路径要同时持有两个 C 路径）。
export pathBuf2Label : String
pathBuf2Label = "rt_path_buf2"

-- | `stat` / `lstat` 的 `struct stat`（x86-64 144 B；`st_size` 在 +48、`st_mode` 在 +24、
--   `st_mtim.tv_sec` 在 +88）。
export statBufLabel : String
statBufLabel = "rt_stat_buf"

-- | `getdents64` 的读取缓冲（32 KiB）与 `tryReadDir` 的名字数组。
export dirBufLabel : String
dirBufLabel = "rt_dir_buf"

export dirNamesLabel : String
dirNamesLabel = "rt_dir_names_buf"

-- | `runIn` 的 shell 命令行、`getcwd` 备份、`spawn` 的 argv 数组与字符串arena、
--   以及 `/bin/sh` 自己的 argv 数组。
export cmdBufLabel : String
cmdBufLabel = "rt_cmd_buf"

export cwdBufLabel : String
cwdBufLabel = "rt_cwd_buf"

export spawnArgvLabel : String
spawnArgvLabel = "rt_spawn_argv"

export spawnBufLabel : String
spawnBufLabel = "rt_spawn_buf"

export shArgvLabel : String
shArgvLabel = "rt_sh_argv"

-- | `tryReadFile` 的读缓冲（8 MiB；`.bss` 零填充，不占 ELF 体积）。
export readBufLabel : String
readBufLabel = "rt_read_buf"

-- | `.bss`：bump 堆缓冲 → 堆结束标记 → 堆指针（由 `_start` 初始化）→ 进程入参 → 宿主槽。
export nativeBss : List NativeBss
nativeBss =
  append
    [NativeBss nativeHeapSegLabel 32 8, NativeBss nativeHeapLabel nativeHeapBytes 16, NativeBss nativeHeapEndLabel 0 0, NativeBss nativeHeapPtrLabel 8 8, NativeBss nativeArenaEndLabel 8 8, NativeBss nativeSegsLabel 8 8, NativeBss nativeCurSegLabel 8 8, NativeBss nativeFreeTableLabel nativeFreeTableBytes 8, NativeBss nativeHugeFreeLabel 8 8, NativeBss handlersLabel 8 8, NativeBss stackTopLabel 8 8, NativeBss selfLabel 8 8, NativeBss stackLimitLabel 8 8, NativeBss segFreeLabel 8 8, NativeBss capFreeLabel 8 8, NativeBss argcLabel 8 8, NativeBss argvLabel 8 8, NativeBss envpLabel 8 8, NativeBss hostStatusLabel 8 8, NativeBss pathBufLabel 4096 8, NativeBss tsLabel 16 8, NativeBss termiosLabel 64 8, NativeBss cleanupHeadLabel 8 8, NativeBss stackArenaLabel 8 8, NativeBss pathBuf2Label 4096 8, NativeBss statBufLabel 256 8, NativeBss dirBufLabel 32768 8, NativeBss dirNamesLabel 32256 8, NativeBss readBufLabel 8388608 8, NativeBss cmdBufLabel 65536 8, NativeBss cwdBufLabel 4096 8, NativeBss spawnArgvLabel 2048 8, NativeBss spawnBufLabel 65536 8, NativeBss shArgvLabel 32 8, NativeBss memLimitLabel 8 8, NativeBss cpuCountLabel 8 8, NativeBss sigActLabel 32 8, NativeBss itimerLabel 32 8, NativeBss cpuCurLabel 128 16, NativeBss cpuNewLabel 128 16, NativeBss cgBufLabel 64 8, NativeBss envChildLabel 8192 8]
    nativeGcBss

-- ---------------------------------------------------------------
-- 构架 helper（`rtFunc` / `rtRawFunc` / `stackGuardInstrs` 在 `Native.Abi`）
-- ---------------------------------------------------------------
-- | 二元 Int 运算：wrap 回 63-bit。
intBinary : String -> String -> NativeFunc
intBinary name op =
  rtFunc name 0
    [IMov (OpReg Rax) (OpReg Rdi), IBin op (OpReg Rsi), IBin "shl" (OpImm 1), IBin "sar" (OpImm 1)]

-- | 比较：Bool 结果 0/1。
intCompare : String -> String -> NativeFunc
intCompare name cond = rtFunc name 0 [ICmp (OpReg Rdi) (OpReg Rsi), ISetcc cond Rax, IMovzxAl]

-- | 位运算：63-bit 二进制补码（`Codegen.Term.bi_bit*` 的汇编实现）。
--   `and/or/xor` 复用 `intBinary` 的 wrap；`bitNot` 是 `xor -1` 再 wrap。
bitNotFn : NativeFunc
bitNotFn =
  rtFunc "bit_not" 0
    [IMov (OpReg Rax) (OpReg Rdi), IBin "xor" (OpImm (0 - 1)), IBin "shl" (OpImm 1), IBin "sar" (OpImm 1)]

-- | `bitShl`：计数 `n < 0 || n >= 63` → 0；否则 `a lsl n`（再 wrap 回 63-bit）。
bitShlFn : NativeFunc
bitShlFn =
  rtFunc "bit_shl" 0
    [ITest Rsi Rsi, IJcc "js" ".Lrt_bit_shl_zero", ICmp (OpReg Rsi) (OpImm 63), IJcc "jge" ".Lrt_bit_shl_zero", IMov (OpReg Rax) (OpReg Rdi), IMov (OpReg Rcx) (OpReg Rsi), IBinReg "shl" Rax (OpReg Rcx), IBin "shl" (OpImm 1), IBin "sar" (OpImm 1), IRet, ILabel ".Lrt_bit_shl_zero", IMov (OpReg Rax) (OpImm 0), IRet]

-- | `bitShr`：计数 `n < 0 || n >= 63` → 0；否则先把值按 63-bit 无符号展开再逻辑右移。
--   （bit 63 是 63-bit 值的符号扩展位；`shl`+`shr` 只清掉它，保留 bit 62）
bitShrFn : NativeFunc
bitShrFn =
  rtFunc "bit_shr" 0
    [ITest Rsi Rsi, IJcc "js" ".Lrt_bit_shr_zero", ICmp (OpReg Rsi) (OpImm 63), IJcc "jge" ".Lrt_bit_shr_zero", IMov (OpReg R11) (OpReg Rdi), IBinReg "shl" R11 (OpImm 1), IBinReg "shr" R11 (OpImm 1), IMov (OpReg Rax) (OpReg R11), IMov (OpReg Rcx) (OpReg Rsi), IBinReg "shr" Rax (OpReg Rcx), IRet, ILabel ".Lrt_bit_shr_zero", IMov (OpReg Rax) (OpImm 0), IRet]

-- | 把 rdi 当作 Nat 返回（恒等）。
natToIntFn : NativeFunc
natToIntFn = rtFunc "nat_to_int" 0 [IMov (OpReg Rax) (OpReg Rdi)]

-- ---------------------------------------------------------------
-- 可观测性原语桩（`docs/reference/observability.md` §4.1）
-- ---------------------------------------------------------------
-- native 后端只提供**叶子**原语的 no-op 桩：读级别与记事件都返回 Int 0（0 = 「没打开 /
-- 没产生事件」）。高阶原语 `@vuna@obs@span` 调 thunk 后原样返回，不写事件
-- （`VUNA_OBS` 在 native 产物上不生效）。
obsZeroFn : String -> NativeFunc
obsZeroFn name = rtFunc name 0 [IMov (OpReg Rax) (OpImm 0)]

obsZero2Fn : String -> NativeFunc
obsZero2Fn name = rtFunc name 0 [IMov (OpReg Rax) (OpImm 0)]

-- | 高阶跨度：`obs_span_run name cat f` 只在 f 是闭包时调用 `f 0` 并返回结果；
--   事件写盘为 no-op（`VUNA_OBS` 在 native 产物上不生效）。
obsSpanFn : NativeFunc
obsSpanFn =
  rtFunc "obs_span_run" 0
    [IMov (OpReg Rdi) (OpReg Rdx), IMov (OpReg Rsi) (OpImm 0), IMov (OpReg R11) (OpMem Rdi 0), ICallReg R11]

-- | `obs_span_lab name cat label f`：与 `obs_span` 同形，多一个 label 实参。
obsSpanLabFn : NativeFunc
obsSpanLabFn =
  rtFunc "obs_span_lab_run" 0
    [IMov (OpReg Rdi) (OpReg Rcx), IMov (OpReg Rsi) (OpImm 0), IMov (OpReg R11) (OpMem Rdi 0), ICallReg R11]

-- `dbg!` 展开里的两个运行时符号（与 OCaml 的 `dtp_debug_on` / `dtp_debug_line` 对齐）：
-- 默认关闭 ⇒ `debug_on` 恒返回 0（False），`debug_line` 是 1 参恒等返回 0 的桩。
debugOnFn : NativeFunc
debugOnFn = rtFunc "debug_on" 0 [IMov (OpReg Rax) (OpImm 0)]

debugLineFn : NativeFunc
debugLineFn = rtFunc "debug_line" 0 [IMov (OpReg Rax) (OpImm 0)]

-- ---------------------------------------------------------------
-- Int 运算
-- ---------------------------------------------------------------
divFn : NativeFunc
divFn =
  rtFunc "div" 0
    [ITest Rsi Rsi, IJcc "jne" ".Lrt_div_ok", ICall (nativeRtLabel "trap_divzero"), ILabel ".Lrt_div_ok", IMov (OpReg Rax) (OpReg Rdi), ICqo, IDiv Rsi, IBin "shl" (OpImm 1), IBin "sar" (OpImm 1)]

-- ---------------------------------------------------------------
-- Nat 运算（饱和/夹取，照抄 OCaml 模板）
-- ---------------------------------------------------------------
natAddFn : NativeFunc
natAddFn =
  rtFunc "nat_add" 0
    [IMov (OpReg Rax) (OpReg Rdi), IMov (OpReg R11) (OpImm nativeMaxInt), IBinReg "sub" R11 (OpReg Rsi), ICmp (OpReg Rax) (OpReg R11), IJcc "jg" ".Lrt_nat_add_sat", IBin "add" (OpReg Rsi), IRet, ILabel ".Lrt_nat_add_sat", IMov (OpReg Rax) (OpReg R11)]

natSubFn : NativeFunc
natSubFn =
  rtFunc "nat_sub" 0
    [ICmp (OpReg Rdi) (OpReg Rsi), IJcc "jle" ".Lrt_nat_sub_zero", IMov (OpReg Rax) (OpReg Rdi), IBin "sub" (OpReg Rsi), IRet, ILabel ".Lrt_nat_sub_zero", IMov (OpReg Rax) (OpImm 0)]

natMulFn : NativeFunc
natMulFn =
  rtFunc "nat_mul" 0
    [ICmp (OpReg Rdi) (OpImm 0), IJcc "jle" ".Lrt_nat_mul_zero", ICmp (OpReg Rsi) (OpImm 0), IJcc "jle" ".Lrt_nat_mul_zero", IMov (OpReg Rax) (OpImm nativeMaxInt), ICqo, IDiv Rsi, ICmp (OpReg Rdi) (OpReg Rax), IJcc "jg" ".Lrt_nat_mul_sat", IMov (OpReg Rax) (OpReg Rdi), IBin "imul" (OpReg Rsi), IRet, ILabel ".Lrt_nat_mul_sat", IMov (OpReg Rax) (OpImm nativeMaxInt), IRet, ILabel ".Lrt_nat_mul_zero", IMov (OpReg Rax) (OpImm 0)]

natDivFn : NativeFunc
natDivFn =
  rtFunc "nat_div" 0
    [ITest Rsi Rsi, IJcc "jne" ".Lrt_nat_div_ok", ICall (nativeRtLabel "trap_divzero"), ILabel ".Lrt_nat_div_ok", IMov (OpReg Rax) (OpReg Rdi), ICqo, IDiv Rsi]

natFromIntFn : NativeFunc
natFromIntFn =
  rtFunc "nat_from_int" 0
    [ICmp (OpReg Rdi) (OpImm 0), IJcc "jle" ".Lrt_nat_from_zero", IMov (OpReg Rax) (OpReg Rdi), IRet, ILabel ".Lrt_nat_from_zero", IMov (OpReg Rax) (OpImm 0)]

natSuccFn : NativeFunc
natSuccFn =
  rtFunc "nat_succ" 0
    [IMov (OpReg Rax) (OpReg Rdi), IMov (OpReg R11) (OpImm nativeMaxInt), ICmp (OpReg Rax) (OpReg R11), IJcc "jge" ".Lrt_nat_succ_sat", IBin "add" (OpImm 1), IRet, ILabel ".Lrt_nat_succ_sat", IMov (OpReg Rax) (OpReg R11)]

-- ---------------------------------------------------------------
-- 字符串：堆分配与基本操作
-- ---------------------------------------------------------------
-- | `rdi` = 字符串**数据字节数**（不含长度头），返回 `rax` = 新对象起始地址。
--   分配 = 数据 + 8 字节头；payload 是字节，标记时不扫。
strAllocFn : NativeFunc
strAllocFn =
  rtFunc "str_alloc" 0
    [IBinReg "add" Rdi (OpImm nativeStrHeaderBytes), ICall (nativeRtLabel "alloc_leaf"), IRet]

-- | `rdi` = 字符串 -> rax = 字节数。
strLengthFn : NativeFunc
strLengthFn = rtFunc "str_length" 0 [IMov (OpReg Rax) (OpMem Rdi 0)]

-- | `++`：rdi/rsi = 两个字符串 -> rax = 新字符串。
strConcatFn : NativeFunc
strConcatFn =
  rtFunc "str_concat" 32
    [IMov (OpMem Rbp (0 - 8)) (OpReg Rdi), IMov (OpMem Rbp (0 - 16)) (OpReg Rsi), IMov (OpReg Rax) (OpMem Rdi 0), IBin "add" (OpMem Rsi 0), IMov (OpMem Rbp (0 - 24)) (OpReg Rax), IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "str_alloc"), IMov (OpReg R11) (OpReg Rax), IMov (OpReg Rax) (OpMem Rbp (0 - 24)), IMov (OpMem R11 0) (OpReg Rax), ILeaMem Rdi R11 8, IMov (OpReg Rsi) (OpMem Rbp (0 - 8)), IBinReg "add" Rsi (OpImm 8), IMov (OpReg Rcx) (OpMem Rsi (0 - 8)), IRepMovsb, IMov (OpReg Rsi) (OpMem Rbp (0 - 16)), IBinReg "add" Rsi (OpImm 8), IMov (OpReg Rcx) (OpMem Rsi (0 - 8)), IRepMovsb, IMov (OpReg Rax) (OpReg R11), IRet]

-- | `==`：rdi/rsi = 两个字符串 -> rax = 0/1。
strEqFn : NativeFunc
strEqFn =
  rtFunc "str_eq" 0
    [IMov (OpReg Rax) (OpMem Rdi 0), ICmp (OpReg Rax) (OpMem Rsi 0), IJcc "jne" ".Lrt_seq_false", IMov (OpReg Rcx) (OpMem Rdi 0), ILeaMem Rdi Rdi 8, ILeaMem Rsi Rsi 8, ITest Rcx Rcx, IJcc "jz" ".Lrt_seq_true", IRepeCmpsb, IJcc "je" ".Lrt_seq_true", IJmp ".Lrt_seq_false", ILabel ".Lrt_seq_true", IMov (OpReg Rax) (OpImm 1), IRet, ILabel ".Lrt_seq_false", IMov (OpReg Rax) (OpImm 0), IRet]

-- | `!=`：`str_eq` 的结果取反。
strNeqFn : NativeFunc
strNeqFn = rtFunc "str_neq" 0 [ICall (nativeRtLabel "str_eq"), IBin "xor" (OpImm 1), IRet]

-- | `str_compare`：rdi/rsi = 两个字符串 -> rax = -1 / 0 / 1。
--   语义与 OCaml `compare` 的字符串分支一致：逐字节无符号比较，公共前缀相同则比长度。
--   `cmpsb` 的 flags 反映 `[rsi] - [rdi]`（第二操作数减第一），所以「a < b」对应 `ja`。
strCompareFn : NativeFunc
strCompareFn =
  rtFunc "str_compare" 16
    [IMov (OpReg Rax) (OpMem Rdi 0), IMov (OpMem Rbp (0 - 8)) (OpReg Rax), IMov (OpReg Rax) (OpMem Rsi 0), IMov (OpMem Rbp (0 - 16)) (OpReg Rax), IMov (OpReg Rcx) (OpMem Rbp (0 - 8)), ICmp (OpReg Rcx) (OpMem Rbp (0 - 16)), IJcc "jle" ".Lrt_sc_len_ok", IMov (OpReg Rcx) (OpMem Rbp (0 - 16)), ILabel ".Lrt_sc_len_ok", ILeaMem Rdi Rdi 8, ILeaMem Rsi Rsi 8, ITest Rcx Rcx, IJcc "jz" ".Lrt_sc_prefix", IRepeCmpsb, IJcc "je" ".Lrt_sc_prefix", IJcc "ja" ".Lrt_sc_less", IJmp ".Lrt_sc_greater", ILabel ".Lrt_sc_prefix", IMov (OpReg Rax) (OpMem Rbp (0 - 8)), ICmp (OpReg Rax) (OpMem Rbp (0 - 16)), IJcc "jl" ".Lrt_sc_less", IJcc "jg" ".Lrt_sc_greater", IMov (OpReg Rax) (OpImm 0), IRet, ILabel ".Lrt_sc_less", IMov (OpReg Rax) (OpImm (0 - 1)), IRet, ILabel ".Lrt_sc_greater", IMov (OpReg Rax) (OpImm 1), IRet]

