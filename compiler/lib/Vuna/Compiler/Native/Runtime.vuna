    [IMov (OpReg Rax) (OpImm 1), IMov (OpReg Rdi) (OpImm 2), ILea Rsi (nativeDataLabel "oom"), IMov (OpReg Rdx) (OpImm (strLength oomMessage)), ISyscall, IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 2), ISyscall]

-- ---------------------------------------------------------------
-- 断言 / 未实现占位 / 显式失败
-- ---------------------------------------------------------------
-- 失败报告协议（与 OCaml 报告器 `dt_report_exn` 的第一行一致）：
--   stderr `vuna: runtime error: <msg>\n`，exit 2。
--
-- 失败路径**不分配**（不走 `str_concat`）：前缀是 `.rodata` 裸文本，msg 是带长度头的
-- 字符串。因此逐段 write syscall，避免把裸 rodata 当字符串对象传给分配器。
-- | 写一段裸 rodata：fd=2。
writeErrRaw : String -> Int -> List Instr
writeErrRaw label len =
  [ IMov (OpReg Rax) (OpImm 1),
    IMov (OpReg Rdi) (OpImm 2),
    ILea Rsi label,
    IMov (OpReg Rdx) (OpImm len),
    ISyscall
  ]

-- | 写 r8 指向的字符串对象（长度取自 [r8]，数据从 r8+8 起）。
writeErrMsg : List Instr
writeErrMsg =
  [ IMov (OpReg Rdx) (OpMem R8 0),
    ILeaMem Rsi R8 8,
    IMov (OpReg Rax) (OpImm 1),
    IMov (OpReg Rdi) (OpImm 2),
    ISyscall
  ]

-- | 写报错换行 + exit 2。
errFinish : List Instr
errFinish =
  [ IMov (OpReg Rax) (OpImm 1),
    IMov (OpReg Rdi) (OpImm 2),
    ILea Rsi (nativeDataLabel "nl"),
    IMov (OpReg Rdx) (OpImm 1),
    ISyscall,
    IMov (OpReg Rax) (OpImm 60),
    IMov (OpReg Rdi) (OpImm 2),
    ISyscall
  ]

-- | `vuna: runtime error: ` + prefix + msg + `\n` + exit 2；`rdi` = msg（入口保存到 r8）。
trapWithPrefix : String -> Int -> List Instr
trapWithPrefix label len =
  append [IMov (OpReg R8) (OpReg Rdi)]
    (append (writeErrRaw (nativeDataLabel "err_prefix") (strLength errPrefix)) (append (writeErrRaw label len) (append writeErrMsg errFinish)))

-- | `prim_fail msg`（以及无前缀的失败）：`vuna: runtime error: ` + msg + `\n` + exit 2。
trapMsgFn : NativeFunc
trapMsgFn =
  rtRawFunc "trap_msg"
    (append [IMov (OpReg R8) (OpReg Rdi)] (append (writeErrRaw (nativeDataLabel "err_prefix") (strLength errPrefix)) (append writeErrMsg errFinish)))

-- | `assert False msg _` 的失败路径：`vuna: runtime error: assertion failed: msg\n` + exit 2。
trapAssertFn : NativeFunc
trapAssertFn =
  rtRawFunc "trap_assert"
    (trapWithPrefix (nativeDataLabel "assert_prefix") (strLength assertPrefix))

-- | `todo msg` 的失败路径：`vuna: runtime error: TODO: msg\n` + exit 2。
trapTodoFn : NativeFunc
trapTodoFn =
  rtRawFunc "trap_todo" (trapWithPrefix (nativeDataLabel "todo_prefix") (strLength todoPrefix))

-- | `assert cond msg x`（rdi=cond 0/1、rsi=msg、rdx=x）→ 成功返回 x；失败跳 trap_assert。
assertFn : NativeFunc
assertFn =
  rtFunc "assert" 0
    [ICmp (OpReg Rdi) (OpImm 0), IJcc "je" ".Lrt_assert_fail", IMov (OpReg Rax) (OpReg Rdx), IRet, ILabel ".Lrt_assert_fail", IMov (OpReg Rdi) (OpReg Rsi), IJmp (nativeRtLabel "trap_assert")]

-- | `prim_fail msg`：直接把 msg 交给 `trap_msg`。
primFailFn : NativeFunc
primFailFn = rtFunc "prim_fail" 0 [IJmp (nativeRtLabel "trap_msg")]

-- | `todo msg`：直接把 msg 交给 `trap_todo`。
todoFn : NativeFunc
todoFn = rtFunc "todo" 0 [IJmp (nativeRtLabel "trap_todo")]

-- ---------------------------------------------------------------
-- 闭包应用（饱和 / 部分 / 过度）
-- ---------------------------------------------------------------
-- 闭包布局：`[0]`=code、`[8]`=arity（运行时 binder 数）、`[16..]`=捕获值。
-- 调用约定：rdi = 闭包自身，实参从 rsi 起（rsi/rdx/rcx/r8/r9，第 6 个起压栈）。
--
-- `rt_apply` 是生成代码里**唯一**的动态调用入口：调用点把实参按升序放成数组
-- （arg i 在 [argp+8i]），由 `rt_apply` 决定饱和调用 / 构造部分应用闭包 / 先调用再
-- 继续应用剩余实参。部分应用闭包由 `rt_apply_shim` 在真正饱和时合并捕获实参。
applyFn : NativeFunc
applyFn =
  rtFunc "apply" 48
    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IMov (OpMem Rbp (nativeSlotOff 1)) (OpReg Rsi), IMov (OpMem Rbp (nativeSlotOff 2)) (OpReg Rdx), IMov (OpReg Rax) (OpMem Rdi 8), IMov (OpMem Rbp (nativeSlotOff 3)) (OpReg Rax), ICmp (OpReg Rsi) (OpReg Rax), IJcc "je" ".Lrt_apply_exact", IJcc "jl" ".Lrt_apply_partial", IJmp ".Lrt_apply_over", ILabel ".Lrt_apply_exact", IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 0)), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 1)), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 2)), ICall (nativeRtLabel "apply_exact"), IRet, ILabel ".Lrt_apply_over", IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 0)), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 3)), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 2)), ICall (nativeRtLabel "apply_exact"), IMov (OpReg R10) (OpReg Rax), IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff 2)), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 3)), IBinReg "shl" Rcx (OpImm 3), IBinReg "add" Rdx (OpReg Rcx), IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 1)), IBinReg "sub" Rsi (OpMem Rbp (nativeSlotOff 3)), IMov (OpReg Rdi) (OpReg R10), ICall (nativeRtLabel "apply"), IRet, ILabel ".Lrt_apply_partial", IMov (OpReg Rdi) (OpMem Rbp (nativeSlotOff 1)), IBinReg "add" Rdi (OpImm 3), IBinReg "shl" Rdi (OpImm 3), ICall (nativeRtLabel "alloc"), IMov (OpMem Rbp (nativeSlotOff 4)) (OpReg Rax), ILea Rcx (nativeRtLabel "apply_shim"), IMov (OpMem Rax 0) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 3)), IBinReg "sub" Rcx (OpMem Rbp (nativeSlotOff 1)), IMov (OpMem Rax 8) (OpReg Rcx), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 0)), IMov (OpMem Rax 16) (OpReg Rcx), ILeaMem Rdi Rax 24, IMov (OpReg Rsi) (OpMem Rbp (nativeSlotOff 2)), IMov (OpReg Rcx) (OpMem Rbp (nativeSlotOff 1)), IBinReg "shl" Rcx (OpImm 3), IRepMovsb, IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff 4)), IRet]

-- | `rdi`=闭包、`rsi`=实参个数（等于 arity）、`rdx`=实参数组 → 值。
applyExactFn : NativeFunc
