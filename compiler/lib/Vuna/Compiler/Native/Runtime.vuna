    [IMov (OpMem Rbp (nativeSlotOff 0)) (OpReg Rdi), IBinReg "xor" Rax (OpReg Rax), IMov (OpRip hostStatusLabel) (OpReg Rax), ILea Rsi statBufLabel, IBinReg "xor" Rdx (OpReg Rdx), IBinReg "xor" R10 (OpReg R10), IMov (OpReg Rax) (OpImm 61), ISyscall, ICmp (OpReg Rax) (OpImm 0), IJcc "jl" ".Lrt_wp_fail", ILea Rcx statBufLabel, IMov (OpReg Rax) (OpMem Rcx 0), IMov (OpReg Rcx) (OpReg Rax), IBinReg "and" Rcx (OpImm 127), ICmp (OpReg Rcx) (OpImm 0), IJcc "jne" ".Lrt_wp_signaled", IBinReg "shr" Rax (OpImm 8), IBinReg "and" Rax (OpImm 255), IRet, ILabel ".Lrt_wp_signaled", IMov (OpReg Rax) (OpImm 1), IRet, ILabel ".Lrt_wp_fail", IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "fs_fail"), IMov (OpReg Rax) (OpImm 1)]

-- | `rdi` = 退出码：真实退出进程（不返回）。
exitWithFn : NativeFunc
exitWithFn = rtFunc "exit_with" 0 [IMov (OpReg Rax) (OpImm 60), ISyscall]

-- ---------------------------------------------------------------
-- 资源限制：内存预算 / 核数（亲和性）/ 总超时
-- ---------------------------------------------------------------
-- `_start` 在 `vuna_main` 之前调用三个 `init_*`（见 `Native.Module.startFunc`）。
-- 配置全部来自 env，不进 codegen：同一 IR 的 `main.s` 逐字节确定。
--
--   * `VUNA_NATIVE_MEM_LIMIT`（字节，0 = 不限，缺省 1 GiB）
--   * `VUNA_NATIVE_CPUS`（`auto` 缺省 / `0` 不限 / N）
--   * `VUNA_NATIVE_TIMEOUT_MS`（毫秒，0 = 不限，缺省不限）
--   * `VUNA_NATIVE_INHERIT`（`1` = 子进程继承上述变量）
--
-- 解析失败一律回落缺省，不阻断启动（限制器不能把程序跑不起来）。
--
-- | `rdi` = NUL 结尾的键 → `rax` = 值起点（`=` 之后），未设置时 0。
--   直接在 `envp` 上扫描，不经过分配器（`_start` 早期可用）。
envLookupFn : NativeFunc
envLookupFn =
  rtRawFunc "env_lookup"
    [IMov (OpReg R11) (OpReg Rdi), IMov (OpReg R8) (OpRip envpLabel), IBinReg "xor" R9 (OpReg R9), ILabel ".Lrt_env_outer", IMov (OpReg Rcx) (OpReg R9), IBinReg "shl" Rcx (OpImm 3), IMov (OpReg R10) (OpMemX R8 Rcx 0), ITest R10 R10, IJcc "jz" ".Lrt_env_none", IBinReg "xor" Rcx (OpReg Rcx), ILabel ".Lrt_env_cmp", IMovzx Rax (OpMemX R11 Rcx 0), ITest Rax Rax, IJcc "jz" ".Lrt_env_eq", IMovzx Rdx (OpMemX R10 Rcx 0), ICmp (OpReg Rax) (OpReg Rdx), IJcc "jne" ".Lrt_env_next", IBinReg "add" Rcx (OpImm 1), IJmp ".Lrt_env_cmp", ILabel ".Lrt_env_eq", IMovzx Rdx (OpMemX R10 Rcx 0), ICmp (OpReg Rdx) (OpImm 61), IJcc "jne" ".Lrt_env_next", IMov (OpReg Rax) (OpReg R10), IBinReg "add" Rax (OpReg Rcx), IBinReg "add" Rax (OpImm 1), IRet, ILabel ".Lrt_env_next", IBinReg "add" R9 (OpImm 1), IJmp ".Lrt_env_outer", ILabel ".Lrt_env_none", IBinReg "xor" Rax (OpReg Rax), IRet]

-- | `rdi` = C 字符串 → `rax` = 十进制值、`rdx` = 1（至少一位数字）/ 0（无效）。
--   超过 18 位按无效处理（限制器不需要更大范围，避免 64-bit 溢出分支）。
parseU64Fn : NativeFunc
parseU64Fn =
  rtRawFunc "parse_u64"
    [IBinReg "xor" Rax (OpReg Rax), IBinReg "xor" R9 (OpReg R9), IBinReg "xor" R8 (OpReg R8), ILabel ".Lrt_pu_loop", IMovzx Rdx (OpMemX Rdi R8 0), ICmp (OpReg Rdx) (OpImm 48), IJcc "jb" ".Lrt_pu_done", ICmp (OpReg Rdx) (OpImm 57), IJcc "ja" ".Lrt_pu_done", ICmp (OpReg R8) (OpImm 18), IJcc "jae" ".Lrt_pu_done", IBinReg "imul" Rax (OpImm 10), IBinReg "sub" Rdx (OpImm 48), IBinReg "add" Rax (OpReg Rdx), IMov (OpReg R9) (OpImm 1), IBinReg "add" R8 (OpImm 1), IJmp ".Lrt_pu_loop", ILabel ".Lrt_pu_done", IMov (OpReg Rdx) (OpReg R9), IRet]

-- | `VUNA_NATIVE_MEM_LIMIT` → `rt_mem_limit`（缺省 1 GiB；`0` = 不限）。
initMemFn : NativeFunc
initMemFn =
  rtRawFunc "init_mem"
    [ILea Rdi (nativeDataLabel "env_mem_limit"), ICall (nativeRtLabel "env_lookup"), ITest Rax Rax, IJcc "jz" ".Lrt_im_default", IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "parse_u64"), ITest Rdx Rdx, IJcc "jz" ".Lrt_im_default", IMov (OpRip memLimitLabel) (OpReg Rax), IRet, ILabel ".Lrt_im_default", IMov (OpReg Rax) (OpImm nativeMemDefaultBytes), IMov (OpRip memLimitLabel) (OpReg Rax), IRet]

