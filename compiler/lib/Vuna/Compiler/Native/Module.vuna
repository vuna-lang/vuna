module Vuna.Compiler.Native.Module where

-- Vuna.Compiler.Native.Module：IrProgram -> NativeProgram（x86-64 汇编，M2 + M3a）。
--
-- M2 切片：M1 的 Int/Nat/Bool 纯值 + `String`（字面量、`++`、`strFromInt`、`strLength`、
-- `strAt`、`strHash`、`strShow`、`strSubstring`、`bi_eq_str` / `bi_neq_str`、`IrConcatMany`、
-- String 入口）。字符串是**指向长度头的指针**，由运行时从 bump 堆分配。
-- M3a：用户 `data`（变体对象 `[0]`=tag + 8 字节字段）、record（纯字段对象）、
-- 通用 `IrCase`（tag 线性分派）、`IrProj` / `IrRecUpd`。
--
-- 生成策略（见 docs/reference/native.md）：
--   * 从 entry main 沿 `irDefDeps` 收集可达定义，只生成可达函数；不可达的 base
--     定义不检查（与 wasm M1 的 `collectNeeded` 同策略）；
--   * 不做寄存器分配：binder 与中间值都走 `[rbp - 8*(slot+1)]`；
--   * 调用约定在 `Native.Abi`；运行时符号在 `Native.Runtime`；
--   * 字符串字面量按**内容去重**进 `.rodata`（首现顺序编号），`IrStr` 求值成 `lea`；
--   * 内部 label 全程序唯一（编号跨定义累加；M1 每函数从 0 起，会让两个函数撞名）；
--   * 生成器带 fuel，越界报 `NativeInternal`，不 panic。
--
-- 边界：只 import Base、`Vuna.Compiler.Ir` 与 `Native.*`。
import Base.Bool
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.String
import Vuna.Compiler.Ir
import Vuna.Compiler.Native.Abi
import Vuna.Compiler.Native.Model
import Vuna.Compiler.Native.Runtime

-- ---------------------------------------------------------------
-- 结果类型：区分「目标不支持」与「生成器不变式破坏」
-- -----------------------------------------------------------
export data NRes a(..) : Type where
  NOk : a -> NRes a
  NFail : NativeErr -> NRes a

nbind : NRes a -> (a -> NRes b) -> NRes b
nbind (NOk x) k = k x
nbind (NFail e) _ = NFail e

unsupported : String -> NRes a
unsupported msg = NFail (NativeUnsupported msg)

internal : String -> NRes a
internal msg = NFail (NativeInternal msg)

-- ---------------------------------------------------------------
-- 生成状态与栈槽
-- -----------------------------------------------------------
record FGen where
  fgDefs : List IrDef
  fgPool : List (Pair String String)
  fgSlots : List (Pair IrBinder Int)
  fgFams : List IrTyDecl
  fgNextSlot : Int
  fgNextLabel : Int

freshSlot : FGen -> Pair Int FGen
freshSlot st =
  let
    slot = st.fgNextSlot
    st1 = { st | fgNextSlot = st.fgNextSlot + 1 }
  in Pair slot st1

freshLabel : FGen -> Pair String FGen
freshLabel st =
  let
    label = nativeJumpLabel st.fgNextLabel
    st1 = { st | fgNextLabel = st.fgNextLabel + 1 }
  in Pair label st1

storeSlot : Int -> List Instr
storeSlot slot = [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]

loadSlot : Int -> List Instr
loadSlot slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot))]

loadReg : Reg -> Int -> List Instr
loadReg r slot = [IMov (OpReg r) (OpMem Rbp (nativeSlotOff slot))]

-- ---------------------------------------------------------------
-- binder
-- -----------------------------------------------------------
bNameEq : IrBName -> IrBName -> Bool
bNameEq (IrBUser x) (IrBUser y) = x == y
bNameEq (IrBArm x) (IrBArm y) = x == y
bNameEq (IrBNat x) (IrBNat y) = x == y
bNameEq IrBWild IrBWild = True
bNameEq _ _ = False

binderEq : IrBinder -> IrBinder -> Bool
binderEq a b = bNameEq a.irBinderName b.irBinderName && a.irBinderErased == b.irBinderErased

lookupBinder : IrBinder -> List (Pair IrBinder Int) -> Maybe Int
lookupBinder _ [] = Nothing
lookupBinder b (p :: rest) =
  if binderEq b (firstOf p) then Just (secondOf p) else lookupBinder b rest

pushBinder : IrBinder -> Int -> FGen -> FGen
pushBinder b slot st = { st | fgSlots = Pair b slot :: st.fgSlots }

isErasedBinder : IrBinder -> Bool
isErasedBinder b = b.irBinderErased

-- | 结束一个 binder 作用域：只恢复 binder 表；slot/label 计数器不回退（槽不复用）。
restoreBinderScope : FGen -> List (Pair IrBinder Int) -> FGen
restoreBinderScope st slots = { st | fgSlots = slots }

runtimeBinders : List IrBinder -> List IrBinder
runtimeBinders bs = filter (\b => not (isErasedBinder b)) bs

-- ---------------------------------------------------------------
-- 定义查找 / 可达性
-- -----------------------------------------------------------
findDef : String -> List IrDef -> Maybe IrDef
findDef _ [] = Nothing
findDef name (d :: rest) = if irDefName d == name then Just d else findDef name rest

memStr : String -> List String -> Bool
memStr _ [] = False
memStr s (x :: rest) = s == x || memStr s rest

collectNeeded : Int -> List String -> List String -> List IrDef -> List String
collectNeeded fuel work seen defs = if fuel <= 0 then reverse seen
else case work of
  [] => reverse seen
  n :: rest => if memStr n seen then collectNeeded (fuel - 1) rest seen defs
  else case findDef n defs of
    Nothing => collectNeeded (fuel - 1) rest (n :: seen) defs
    Just d => collectNeeded (fuel - 1) (append rest (irDefDeps d)) (n :: seen) defs

-- ---------------------------------------------------------------
-- 字符串字面量池
-- -----------------------------------------------------------
-- | 收集一个 IR 项里的**全部**字符串字面量（含 `IrConcatMany` 的叶子）。
strLitsOf : Ir -> List String
strLitsOf (IrStr s) = [s]
strLitsOf (IrCtor _ _ args) = concatMap strLitsOf args
strLitsOf (IrRecord _ fields) = concatMap strLitsOfField fields
strLitsOf (IrProj base _ _) = strLitsOf base
strLitsOf (IrRecUpd base _ fields) = append (strLitsOf base) (concatMap strLitsOfField fields)
strLitsOf (IrRtApp _ args) = concatMap strLitsOf args
strLitsOf (IrCast inner) = strLitsOf inner
strLitsOf (IrLet _ scrut body) = append (strLitsOf scrut) (strLitsOf body)
strLitsOf (IrLam _ body) = strLitsOf body
strLitsOf (IrApp f a) = append (strLitsOf f) (strLitsOf a)
strLitsOf (IrIf c t e) = append (strLitsOf c) (append (strLitsOf t) (strLitsOf e))
strLitsOf (IrCase scrut alts) = append (strLitsOf scrut) (concatMap strLitsOfAlt alts)
strLitsOf (IrNatCase scrut _ z s c) =
  append (strLitsOf scrut)
    (append (strLitsOfAltMaybe z) (append (strLitsOfAltMaybe s) (strLitsOfAltMaybe c)))
strLitsOf (IrConcatMany parts) = concatMap strLitsOf parts
strLitsOf (IrEffThunk _ _ _ _ prim) = strLitsOf prim
strLitsOf _ = []

strLitsOfField : Pair String Ir -> List String
strLitsOfField p = strLitsOf (secondOf p)

strLitsOfAlt : IrAlt -> List String
strLitsOfAlt alt = strLitsOf (irAltBodyOf alt)

strLitsOfAltMaybe : Maybe IrAlt -> List String
strLitsOfAltMaybe Nothing = []
strLitsOfAltMaybe (Just alt) = strLitsOfAlt alt

strLitsOfDef : IrDef -> List String
strLitsOfDef d = case irDefBody d of
  Nothing => []
  Just b => strLitsOf b

addLit : List (Pair String String) -> String -> List (Pair String String)
addLit pool s =
  if memStr s (map (\p => firstOf p) pool) then pool
  else append pool [Pair s (nativeStrLitLabel (length pool))]

poolOfDefs : List IrDef -> List (Pair String String)
poolOfDefs defs = foldl addLit [] (concatMap strLitsOfDef defs)

poolLabelOf : String -> List (Pair String String) -> Maybe String
poolLabelOf _ [] = Nothing
poolLabelOf s (p :: rest) = if firstOf p == s then Just (secondOf p) else poolLabelOf s rest

poolItems : List (Pair String String) -> List NativeStrLit
poolItems [] = []
poolItems ((Pair text label) :: rest) = NativeStrLit label text :: poolItems rest

-- ---------------------------------------------------------------
-- 参数
-- -----------------------------------------------------------
loadArgRegs : List Reg -> List Int -> List Instr
loadArgRegs [] _ = []
loadArgRegs _ [] = []
loadArgRegs (r :: rs) (s :: ss) = append (loadReg r s) (loadArgRegs rs ss)

argRegAt : Int -> Maybe Reg
argRegAt i = argRegAtIn i nativeArgRegs

argRegAtIn : Int -> List Reg -> Maybe Reg
argRegAtIn _ [] = Nothing
argRegAtIn i (r :: rest) = if i == 0 then Just r else argRegAtIn (i - 1) rest

-- ---------------------------------------------------------------
-- 表达式
-- -----------------------------------------------------------
genArgs : Int -> FGen -> List Ir -> NRes (Pair (List Instr) (Pair (List Int) FGen))
genArgs _ st [] = NOk (Pair [] (Pair [] st))
genArgs fuel st (a :: rest) = if fuel <= 0 then internal "native codegen fuel exhausted"
else nbind (genExpr (fuel - 1) st a) (\p => let
  st1 = secondOf p
  slotP = freshSlot st1
  slot = firstOf slotP
  st2 = secondOf slotP
in nbind (genArgs (fuel - 1) st2 rest) (\q => let
  qInstrs = firstOf q
  qSlots = firstOf (secondOf q)
  st3 = secondOf (secondOf q)
in NOk (Pair (append (firstOf p) (append (storeSlot slot) qInstrs)) (Pair (slot :: qSlots) st3))
)
)

-- | 饱和调用：实参左→右求值到槽；前 6 个装参数寄存器，其余逆序压栈（SysV AMD64）。
--   调用前 `rsp` 必须 16 字节对齐：栈参数个数为奇数时先 `sub rsp, 8` 补空洞
--   （空洞在参数**上方**，被调用方忽略）；返回后一次性 `add rsp, 8*k + pad`。
genSaturatedCall : Int -> FGen -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genSaturatedCall fuel st label args = if fuel <= 0 then internal "native codegen fuel exhausted"
else nbind (genArgs (fuel - 1) st args) (\p => let
  slots = firstOf (secondOf p)
  st1 = secondOf (secondOf p)
  regSlots = take nativeMaxArgs slots
  stackSlots = drop nativeMaxArgs slots
  k = length stackSlots
  pad = if k - k / 2 * 2 == 1 then 8 else 0
  popped = 8 * k + pad
  callPart = append [ICall label] (if popped == 0 then [] else [IBinReg "add" Rsp (OpImm popped)])
  body = append (pushStackArgs stackSlots) (append (loadArgRegs nativeArgRegs regSlots) callPart)
in NOk (Pair (append (firstOf p) body) st1)
)

-- | 栈参数压栈：逆序（最后一个先压），第 7 个参数最终位于 `[rbp+16]`。
--   `slots` 已按实参顺序排列（从第 7 个起）。先 `sub rsp, 8` 补对齐空洞（若需要）。
pushStackArgs : List Int -> List Instr
pushStackArgs slots =
  let
    k = length slots
    pad = if k - k / 2 * 2 == 1 then [IBinReg "sub" Rsp (OpImm 8)] else []
    pushes = concatMap pushOne (reverse slots)
  in append pad pushes

pushOne : Int -> List Instr
pushOne slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot)), IPush Rax]

genGlobalCall : Int -> FGen -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genGlobalCall fuel st name args = if fuel <= 0 then internal "native codegen fuel exhausted"
else case findDef name st.fgDefs of
  Nothing => internal "undefined global in native codegen: ${name}"
  Just d =>
    let
      arity = irDefArity d
    in if length args /= arity then unsupported "native target: partial application is not supported yet"
    else genSaturatedCall (fuel - 1) st (nativeFuncLabel name) args

genNatSuccCall : Int -> FGen -> Ir -> NRes (Pair (List Instr) FGen)
genNatSuccCall fuel st arg =
  if fuel <= 0 then internal "native codegen fuel exhausted"
  else nbind (genExpr (fuel - 1) st arg)
    (\p => NOk (Pair (append (firstOf p) [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "nat_succ")]) (secondOf p)))

genRtApp : Int -> FGen -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genRtApp fuel st sym args = if fuel <= 0 then internal "native codegen fuel exhausted"
else case sym of
  "&&" => genBoolChain (fuel - 1) st args True
  "||" => genBoolChain (fuel - 1) st args False
  _ => case nativeRtTarget sym of
    Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
    Just label =>
      if length args /= irInlineArity sym then internal "runtime symbol arity mismatch: ${sym}"
      else genSaturatedCall (fuel - 1) st label args

-- | `IrApp (IrRt sym) args`：运行时常量函数值的饱和应用（`irInlineArity = 0` 的那些）。
genRtValueCall : Int -> FGen -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genRtValueCall fuel st sym args = if fuel <= 0 then internal "native codegen fuel exhausted"
else
  let
    arity = nativeRtValueArity sym
  in if sym == "@vuna@obs@span" || sym == "@vuna@obs@spanLab" then unsupported
    "native target: obs spans need closures (not supported yet); leaf obs primitives (level/log/counter/mark/sample) are no-op stubs"
  else if arity <= 0 then unsupported "native target: runtime function values are not supported yet"
  else if length args /= arity then unsupported "native target: partial application of runtime functions is not supported yet"
  else case nativeRtTarget sym of
    Nothing => unsupported "native target: runtime symbol `${sym}` is not supported yet"
    Just label => genSaturatedCall (fuel - 1) st label args

-- | `IrConcatMany`：左→右两两拼接（与 OCaml 的 `String.concat ""` 语义一致）。
--   `parts` 至少 3 项（Lowering 的门槛），空/单元素的兜底只防空指针。
genConcatMany : Int -> FGen -> List Ir -> NRes (Pair (List Instr) FGen)
genConcatMany fuel st parts = if fuel <= 0 then internal "native codegen fuel exhausted"
else case parts of
  [] => internal "empty string concatenation in native codegen"
  [one] => genExpr (fuel - 1) st one
  first :: rest => nbind (genExpr (fuel - 1) st first) (\p => let
    slotP = freshSlot (secondOf p)
    slot = firstOf slotP
    st1 = secondOf slotP
  in nbind (genConcatRest (fuel - 1) st1 slot rest)
    (\q => NOk (Pair (append (firstOf p) (append (storeSlot slot) (firstOf q))) (secondOf q)))
  )

-- | 累加器在 `slot`；对每个后续片段求值后与累加值拼接，结果回写累加器。
genConcatRest : Int -> FGen -> Int -> List Ir -> NRes (Pair (List Instr) FGen)
genConcatRest _ st slot [] = NOk (Pair (loadSlot slot) st)
genConcatRest fuel st slot (part :: rest) =
  if fuel <= 0 then internal "native codegen fuel exhausted"
  else nbind (genExpr (fuel - 1) st part)
    (\p => nbind (genConcatRest (fuel - 1) (secondOf p) slot rest) (\q => NOk (Pair (append (firstOf p) (append [IMov (OpReg Rsi) (OpReg Rax)] (append (loadReg Rdi slot) (append [ICall (nativeRtLabel "str_concat"), IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)] (firstOf q))))) (secondOf q))))

genExpr : Int -> FGen -> Ir -> NRes (Pair (List Instr) FGen)
genExpr fuel st ir = if fuel <= 0 then internal "native codegen fuel exhausted"
else case ir of
  IrVar b => case lookupBinder b st.fgSlots of
    Just slot => NOk (Pair (loadSlot slot) st)
    Nothing => internal "unbound runtime binder in native codegen"
  IrGlobal name => case findDef name st.fgDefs of
    Nothing => internal "undefined global in native codegen: ${name}"
    Just d =>
      if irDefArity d == 0 then NOk (Pair [ICall (nativeFuncLabel name)] st)
      else unsupported "native target: function values are not supported yet"
  IrInt n =>
    if n < 0 - 4611686018427387903 - 1 || n > 4611686018427387903 then unsupported "native target: integer literal outside the 63-bit range"
    else NOk (Pair [IMov (OpReg Rax) (OpImm n)] st)
  IrStr s => case poolLabelOf s st.fgPool of
    Nothing => internal "string literal missing from native pool"
    Just label => NOk (Pair [ILea Rax label] st)
  IrBool b => NOk (Pair [IMov (OpReg Rax) (OpImm (if b then 1 else 0))] st)
  IrCast inner => genExpr (fuel - 1) st inner
  IrLet bs scrut body => nbind (genExpr (fuel - 1) st scrut) (\p => let
    rbs = runtimeBinders bs
    st1 = secondOf p
  in case rbs of
    [] =>
      nbind (genExpr (fuel - 1) st1 body)
        (\q => NOk (Pair (append (firstOf p) (firstOf q)) (secondOf q)))
    [b] =>
      let
        slotP = freshSlot st1
        slot = firstOf slotP
        st2 = secondOf slotP
      in nbind (genExpr (fuel - 1) (pushBinder b slot st2) body)
        (\q => NOk (Pair (append (firstOf p) (append (storeSlot slot) (firstOf q))) (restoreBinderScope (secondOf q) st1.fgSlots)))
    _ => unsupported "native target: let with more than one runtime binder is not supported yet"
  )
  IrIf c t e => nbind (genExpr (fuel - 1) st c) (\p => let
    lElseP = freshLabel (secondOf p)
    lElse = firstOf lElseP
    st1 = secondOf lElseP
    lEndP = freshLabel st1
    lEnd = firstOf lEndP
    st2 = secondOf lEndP
  in nbind (genExpr (fuel - 1) st2 t) (\pt => nbind (genExpr (fuel - 1) (secondOf pt) e) (\pe => let
    body =
      append (firstOf p)
        (append [ITest Rax Rax, IJcc "je" lElse] (append (firstOf pt) (append [IJmp lEnd, ILabel lElse] (append (firstOf pe) [ILabel lEnd]))))
  in NOk (Pair body (secondOf pe))
  )
  )
  )
  IrCtor family ctor args => genCtor (fuel - 1) st family ctor args
  IrRecord family fields => genRecord (fuel - 1) st family fields
  IrProj base family field => genProj (fuel - 1) st base family field
  IrRecUpd base family fields => genRecUpd (fuel - 1) st base family fields
  IrCase scrut alts => genCase (fuel - 1) st scrut alts
  IrApp _ _ => genApp (fuel - 1) st ir
  IrRtApp sym args => genRtApp (fuel - 1) st sym args
  IrConcatMany parts => genConcatMany (fuel - 1) st parts
  IrNatCase scrut _fresh zero succ catch => genNatCase (fuel - 1) st scrut zero succ catch
  IrCase _ _ => unsupported "native target: case is not supported yet"
  IrLam _ _ => unsupported "native target: lambdas are not supported yet"
  IrRt "@vuna@obs@span" =>
    unsupported
      "native target: obs spans need closures (not supported yet); leaf obs primitives (level/log/counter/mark/sample) are no-op stubs"
  IrRt "@vuna@obs@spanLab" =>
    unsupported
      "native target: obs spans need closures (not supported yet); leaf obs primitives (level/log/counter/mark/sample) are no-op stubs"
  IrRt _ => unsupported "native target: runtime function values are not supported yet"
  IrFloatLit _ => unsupported "native target: float literals are not supported yet"
  IrEffThunk _ _ _ _ _ => unsupported "native target: effect thunks are not supported yet"
  IrEffBind _ _ _ => unsupported "native target: effect bindings are not supported yet"

-- `&&` / `||`：短路；a 为 0/1，b 为 Bool。
genBoolChain : Int -> FGen -> List Ir -> Bool -> NRes (Pair (List Instr) FGen)
genBoolChain fuel st args isAnd = if fuel <= 0 then internal "native codegen fuel exhausted"
else case args of
  [a, b] => nbind (genExpr (fuel - 1) st a) (\p => let
    lEndP = freshLabel (secondOf p)
    lEnd = firstOf lEndP
    st1 = secondOf lEndP
    cond = if isAnd then "je" else "jne"
  in nbind (genExpr (fuel - 1) st1 b)
    (\q => NOk (Pair (append (firstOf p) (append [ITest Rax Rax, IJcc cond lEnd] (append (firstOf q) [ILabel lEnd]))) (secondOf q)))
  )
  _ => internal "`&&`/`||` must have exactly two arguments"

-- 应用：flatten 左脊，支持饱和顶层调用、`@ir@natSucc`、运行时值函数。
flattenApp : Ir -> Pair Ir (List Ir)
flattenApp (IrApp f a) =
  let
    p = flattenApp f
  in Pair (firstOf p) (append (secondOf p) [a])
flattenApp x = Pair x []

genLamApp : Int -> FGen -> IrBinder -> Ir -> Ir -> NRes (Pair (List Instr) FGen)
genLamApp fuel st b arg body = if fuel <= 0 then internal "native codegen fuel exhausted"
else nbind (genExpr (fuel - 1) st arg) (\p => let
  slotP = freshSlot (secondOf p)
  slot = firstOf slotP
  st1 = secondOf slotP
in nbind (genExpr (fuel - 1) (pushBinder b slot st1) body)
  (\q => NOk (Pair (append (firstOf p) (append (storeSlot slot) (firstOf q))) (restoreBinderScope (secondOf q) st.fgSlots)))
)

genApp : Int -> FGen -> Ir -> NRes (Pair (List Instr) FGen)
genApp fuel st ir = if fuel <= 0 then internal "native codegen fuel exhausted"
else case flattenApp ir of
  Pair head args => case head of
    IrGlobal name => genGlobalCall (fuel - 1) st name args
    IrRt s => if s == irRtNatSucc then case args of
      [a] => genNatSuccCall (fuel - 1) st a
      _ => internal "Nat Succ must have exactly one argument"
    else genRtValueCall (fuel - 1) st s args
    IrLam bs body => case runtimeBinders bs of
      [b] => case args of
        [a] => genLamApp (fuel - 1) st b a body
        _ => unsupported "native target: only saturated single-argument lambdas are supported yet"
      _ => unsupported "native target: lambdas are not supported yet"
    _ => unsupported "native target: higher-order application is not supported yet"

-- ---------------------------------------------------------------
-- data / record（M3a）
-- ---------------------------------------------------------------
-- 对象布局（与 wasm 侧同一表示决策）：
--   * 变体 = 堆对象：`[obj+0]` = tag（i64），`[obj+8]` 起 = 运行时字段（i64，按最大 arity 补齐）；
--   * record = 堆对象：`[obj+0]` 起就是字段（没有 tag）。
-- 分配走 bump 堆（`rt_alloc`）；对象只写后读，不做初始化。
cat : List (List Instr) -> List Instr
cat xs = concatMap (\x => x) xs

listLengthI : List a -> Int
listLengthI [] = 0
listLengthI (_ :: rest) = 1 + listLengthI rest

setLocal : Int -> List Instr
setLocal slot = [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]

getLocal : Int -> List Instr
getLocal slot = [IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff slot))]

-- | 写对象字段：rax ← 槽 `fromSlot`，rdx ← 对象基址，`[rdx+off]` ← rax。
setObjFromSlot : Int -> Int -> Int -> List Instr
setObjFromSlot obj off fromSlot =
  [ IMov (OpReg Rax) (OpMem Rbp (nativeSlotOff fromSlot)),
    IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)),
    IMov (OpMem Rdx off) (OpReg Rax)
  ]

setObjImm : Int -> Int -> Int -> List Instr
setObjImm obj off imm =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpMem Rdx off) (OpImm imm)]

getObjField : Int -> Int -> List Instr
getObjField obj off =
  [IMov (OpReg Rdx) (OpMem Rbp (nativeSlotOff obj)), IMov (OpReg Rax) (OpMem Rdx off)]

-- | 分配 `slots` 个 8 字节槽的对象；返回 (分配指令, 对象槽)。
genAlloc : FGen -> Int -> Pair (List Instr) (Pair Int FGen)
genAlloc st slots =
  let
    slotP = freshSlot st
    obj = firstOf slotP
    st1 = secondOf slotP
    instrs =
      [ IMov (OpReg Rdi) (OpImm (8 * slots)),
        ICall (nativeRtLabel "alloc"),
        IMov (OpMem Rbp (nativeSlotOff obj)) (OpReg Rax)
      ]
  in Pair instrs (Pair obj st1)

declOf : String -> List IrTyDecl -> Maybe IrTyDecl
declOf _ [] = Nothing
declOf family (d :: rest) = if declName d == family then Just d else declOf family rest

declName : IrTyDecl -> String
declName (IrVariantDecl name _ _) = name
declName (IrRecordDecl name _ _ _) = name
declName (IrUnboxedDecl name _ _) = name

ctorTagIn : List (Pair String (List IrTy)) -> String -> Maybe Int
ctorTagIn ctors ctor = ctorTagGo ctors ctor 0

ctorTagGo : List (Pair String (List IrTy)) -> String -> Int -> Maybe Int
ctorTagGo [] _ _ = Nothing
ctorTagGo (p :: rest) name i = if firstOf p == name then Just i else ctorTagGo rest name (i + 1)

ctorArityIn : List (Pair String (List IrTy)) -> String -> Maybe Int
ctorArityIn [] _ = Nothing
ctorArityIn (p :: rest) name =
  if firstOf p == name then Just (listLengthI (secondOf p)) else ctorArityIn rest name

maxArityIn : List (Pair String (List IrTy)) -> Int
maxArityIn [] = 0
maxArityIn (p :: rest) =
  let
    n = listLengthI (secondOf p)
    m = maxArityIn rest
  in if n > m then n else m

recordPosOf : List (Pair Int String) -> String -> Maybe Int
recordPosOf fields name = recordPosGo fields name 0

recordPosGo : List (Pair Int String) -> String -> Int -> Maybe Int
recordPosGo [] _ _ = Nothing
recordPosGo (p :: rest) name i =
  if secondOf p == name then Just i else recordPosGo rest name (i + 1)

storeSlotFields : Int -> Int -> List Int -> List Instr
storeSlotFields obj idx [] = []
storeSlotFields obj idx (s :: rest) =
  append (setObjFromSlot obj (8 * idx) s) (storeSlotFields obj (idx + 1) rest)

padObjZero : Int -> Int -> Int -> List Instr
padObjZero obj idx maxIdx = concatMap (\i => setObjImm obj (8 * i) 0) (range idx maxIdx)

-- | 变体构造：分配 `1 + maxArity` 槽；写 tag，按实参顺序写字段，尾部补 0。
genCtor : Int -> FGen -> String -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genCtor fuel st family ctor args = if fuel <= 0 then internal "native codegen fuel exhausted"
else case declOf family st.fgFams of
  Nothing => internal "unknown data family in native codegen: ${family}"
  Just (IrVariantDecl _ _ ctors) => genCtorGo fuel st ctors ctor args
  _ => internal "constructor `${ctor}` does not belong to a variant family: ${family}"

genCtorGo : Int -> FGen -> List (Pair String (List IrTy)) -> String -> List Ir -> NRes (Pair (List Instr) FGen)
genCtorGo fuel st ctors ctor args = if fuel <= 0 then internal "native codegen fuel exhausted"
else case ctorTagIn ctors ctor of
  Nothing => internal "unknown constructor in native codegen: ${ctor}"
  Just tag => case ctorArityIn ctors ctor of
    Nothing => internal "unknown constructor in native codegen: ${ctor}"
    Just n =>
      if listLengthI args /= n then internal "constructor `${ctor}` applied to the wrong number of arguments"
      else nbind (genArgs (fuel - 1) st args) (\p => genCtorFinish n tag p ctors)

-- | 纯指令拼装（不再递归进 genExpr）：分配 + 写 tag + 写字段 + 补齐。
genCtorFinish : Int -> Int -> Pair (List Instr) (Pair (List Int) FGen) -> List (Pair String (List IrTy)) -> NRes (Pair (List Instr) FGen)
genCtorFinish n tag p ctors =
  let
    st = secondOf (secondOf p)
    maxF = maxArityIn ctors
    allocP = genAlloc st (1 + maxF)
    obj = firstOf (secondOf allocP)
    body =
      cat
        [firstOf p, firstOf allocP, setObjImm obj 0 tag, storeSlotFields obj 1 (firstOf (secondOf p)), padObjZero obj (1 + n) (1 + maxF), getLocal obj]
  in NOk (Pair body (secondOf (secondOf allocP)))

-- | record 构造：按运行时字段顺序求值后写入新对象。
genRecord : Int -> FGen -> String -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genRecord fuel st family fields = if fuel <= 0 then internal "native codegen fuel exhausted"
else case declOf family st.fgFams of
  Nothing => internal "unknown record family in native codegen: ${family}"
  Just (IrRecordDecl _ _ flds _) =>
    if listLengthI fields /= listLengthI flds then internal "record `${family}` constructed with the wrong number of fields"
    else nbind (genArgs (fuel - 1) st (map (\p => secondOf p) fields)) (\p => genRecordFinish p flds)
  _ => internal "family `${family}` is not a record"

genRecordFinish : Pair (List Instr) (Pair (List Int) FGen) -> List (Pair Int String) -> NRes (Pair (List Instr) FGen)
genRecordFinish p flds =
  let
    st = secondOf (secondOf p)
    slots = firstOf (secondOf p)
    allocP = genAlloc st (listLengthI flds)
    obj = firstOf (secondOf allocP)
    body = cat [firstOf p, firstOf allocP, storeSlotFields obj 0 slots, getLocal obj]
  in NOk (Pair body (secondOf (secondOf allocP)))

genProj : Int -> FGen -> Ir -> String -> String -> NRes (Pair (List Instr) FGen)
genProj fuel st base family field = if fuel <= 0 then internal "native codegen fuel exhausted"
else case declOf family st.fgFams of
  Nothing => internal "unknown record family in native codegen: ${family}"
  Just (IrRecordDecl _ _ flds _) => case recordPosOf flds field of
    Nothing => internal "unknown record field in native codegen: `${family}.${field}`"
    Just idx => nbind (genExpr (fuel - 1) st base) (\p => genProjFinish p idx)
  _ => internal "family `${family}` is not a record"

genProjFinish : Pair (List Instr) FGen -> Int -> NRes (Pair (List Instr) FGen)
genProjFinish p idx =
  let
    slotP = freshSlot (secondOf p)
    slot = firstOf slotP
    body = cat [firstOf p, setLocal slot, getObjField slot (8 * idx)]
  in NOk (Pair body (secondOf slotP))

-- | record 更新：分配新对象；逐字段写（被改字段求新值，其余从旧对象复制）。
genRecUpd : Int -> FGen -> Ir -> String -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genRecUpd fuel st base family fields = if fuel <= 0 then internal "native codegen fuel exhausted"
else case declOf family st.fgFams of
  Nothing => internal "unknown record family in native codegen: ${family}"
  Just (IrRecordDecl _ _ flds _) =>
    nbind (genExpr (fuel - 1) st base)
      (\p => genRecUpdStart fuel (firstOf p) (secondOf p) flds fields)
  _ => internal "family `${family}` is not a record"

genRecUpdStart : Int -> List Instr -> FGen -> List (Pair Int String) -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genRecUpdStart fuel baseInstrs st flds fields = if fuel <= 0 then internal "native codegen fuel exhausted"
else
  let
    baseP = freshSlot st
    baseSlot = firstOf baseP
    allocP = genAlloc (secondOf baseP) (listLengthI flds)
    obj = firstOf (secondOf allocP)
  in nbind (genUpdFields (fuel - 1) (secondOf (secondOf allocP)) baseSlot obj 0 flds fields)
    (\q => NOk (Pair (cat [baseInstrs, setLocal baseSlot, firstOf allocP, firstOf q, getLocal obj]) (secondOf q)))

genUpdFields : Int -> FGen -> Int -> Int -> Int -> List (Pair Int String) -> List (Pair String Ir) -> NRes (Pair (List Instr) FGen)
genUpdFields fuel st baseSlot obj idx flds fields = if fuel <= 0 then internal "native codegen fuel exhausted"
else case flds of
  [] => NOk (Pair [] st)
  (Pair _ name) :: rest => case lookupFieldIr name fields of
    Just ir => nbind (genExpr (fuel - 1) st ir) (\p => let
      valP = freshSlot (secondOf p)
      val = firstOf valP
    in nbind (genUpdFields (fuel - 1) (secondOf valP) baseSlot obj (idx + 1) rest fields)
      (\q => NOk (Pair (cat [firstOf p, setLocal val, setObjFromSlot obj (8 * idx) val, firstOf q]) (secondOf q)))
    )
    Nothing =>
      let
        srcP = freshSlot st
        src = firstOf srcP
      in nbind (genUpdFields (fuel - 1) (secondOf srcP) baseSlot obj (idx + 1) rest fields)
        (\q => NOk (Pair (cat [getObjField baseSlot (8 * idx), setLocal src, setObjFromSlot obj (8 * idx) src, firstOf q]) (secondOf q)))

lookupFieldIr : String -> List (Pair String Ir) -> Maybe Ir
lookupFieldIr _ [] = Nothing
lookupFieldIr name (p :: rest) =
  if firstOf p == name then Just (secondOf p) else lookupFieldIr name rest

-- ---------------------------------------------------------------
-- 通用 case
-- ---------------------------------------------------------------
-- | 变体按 tag 分派（线性 compare 链）；record 没有 tag，直接按字段序绑定。
genCase : Int -> FGen -> Ir -> List IrAlt -> NRes (Pair (List Instr) FGen)
genCase fuel st scrut alts = if fuel <= 0 then internal "native codegen fuel exhausted"
else nbind (genExpr (fuel - 1) st scrut) (\p => let
  scP = freshSlot (secondOf p)
  sc = firstOf scP
in nbind (genCaseAlts (fuel - 1) (secondOf scP) sc alts)
  (\q => NOk (Pair (cat [firstOf p, setLocal sc, firstOf q]) (secondOf q)))
)

genCaseAlts : Int -> FGen -> Int -> List IrAlt -> NRes (Pair (List Instr) FGen)
genCaseAlts fuel st sc alts = if fuel <= 0 then internal "native codegen fuel exhausted"
else case caseFamilyOf alts of
  Nothing => genDefault fuel st sc alts
  Just family => case declOf family st.fgFams of
    Nothing => internal "unknown data family in native codegen: ${family}"
    Just (IrVariantDecl _ _ ctors) => genVariantAlts fuel st sc ctors alts
    Just (IrRecordDecl _ _ _ _) => genRecordAlts fuel st sc alts
    _ => internal "case on an unboxed family is not supported yet"

caseFamilyOf : List IrAlt -> Maybe String
caseFamilyOf [] = Nothing
caseFamilyOf (alt :: rest) = case irAltCtorOf alt of
  Nothing => caseFamilyOf rest
  Just p => Just (firstOf p)

findCatchAll : List IrAlt -> Maybe IrAlt
findCatchAll [] = Nothing
findCatchAll (alt :: rest) = case irAltCtorOf alt of
  Nothing => Just alt
  Just _ => findCatchAll rest

trapImpossible : List Instr
trapImpossible = [ICall (nativeRtLabel "trap_impossible")]

genDefault : Int -> FGen -> Int -> List IrAlt -> NRes (Pair (List Instr) FGen)
genDefault fuel st sc alts = if fuel <= 0 then internal "native codegen fuel exhausted"
else case findCatchAll alts of
  Nothing => NOk (Pair trapImpossible st)
  Just alt => genArm fuel st sc alt

genArm : Int -> FGen -> Int -> IrAlt -> NRes (Pair (List Instr) FGen)
genArm fuel st sc alt = if fuel <= 0 then internal "native codegen fuel exhausted"
else case runtimeBinders (irAltBindersOf alt) of
  [] => genExpr (fuel - 1) st (irAltBodyOf alt)
  [b] =>
    let
      slotP = freshSlot st
      slot = firstOf slotP
    in nbind (genExpr (fuel - 1) (pushBinder b slot (secondOf slotP)) (irAltBodyOf alt))
      (\q => NOk (Pair (cat [getLocal sc, setLocal slot, firstOf q]) (secondOf q)))
  _ => internal "case arm has more than one runtime binder"

tagOfScrut : Int -> List Instr
tagOfScrut sc = cat [getLocal sc, [IMov (OpReg Rdx) (OpReg Rax), IMov (OpReg Rax) (OpMem Rdx 0)]]

-- | 变体分支链：跳过 catch-all（它只作默认臂），其余按 tag 线性比较。
genVariantAlts : Int -> FGen -> Int -> List (Pair String (List IrTy)) -> List IrAlt -> NRes (Pair (List Instr) FGen)
genVariantAlts fuel st sc ctors alts = if fuel <= 0 then internal "native codegen fuel exhausted"
else case alts of
  [] => genDefault (fuel - 1) st sc []
  alt :: rest => case irAltCtorOf alt of
    Nothing => genVariantAlts (fuel - 1) st sc ctors rest
    Just (Pair _ ctor) => case ctorTagIn ctors ctor of
      Nothing => internal "unknown constructor in native codegen: ${ctor}"
      Just tag =>
        let
          lNextP = freshLabel st
          lNext = firstOf lNextP
          lEndP = freshLabel (secondOf lNextP)
          lEnd = firstOf lEndP
        in nbind (genVariantArm (fuel - 1) (secondOf lEndP) sc alt)
          (\a => nbind (genVariantAlts (fuel - 1) (secondOf a) sc ctors rest) (\r => NOk (Pair (cat [tagOfScrut sc, [ICmp (OpReg Rax) (OpImm tag), IJcc "jne" lNext], firstOf a, [IJmp lEnd, ILabel lNext], firstOf r, [ILabel lEnd]]) (secondOf r))))

-- | 变体分支：按 keep 形状绑定字段（tag 占 index 0），再求值分支体。
genVariantArm : Int -> FGen -> Int -> IrAlt -> NRes (Pair (List Instr) FGen)
genVariantArm fuel st sc alt =
  if fuel <= 0 then internal "native codegen fuel exhausted"
  else nbind (bindFields st sc 1 (runtimeBinders (irAltBindersOf alt)))
    (\bp => nbind (genExpr (fuel - 1) (secondOf bp) (irAltBodyOf alt)) (\q => NOk (Pair (append (firstOf bp) (firstOf q)) (secondOf q))))

bindFields : FGen -> Int -> Int -> List IrBinder -> NRes (Pair (List Instr) FGen)
bindFields st _ _ [] = NOk (Pair [] st)
bindFields st sc idx (b :: rest) =
  let
    slotP = freshSlot st
    slot = firstOf slotP
  in nbind (bindFields (pushBinder b slot (secondOf slotP)) sc (idx + 1) rest)
    (\q => NOk (Pair (cat [getObjField sc (8 * idx), setLocal slot, firstOf q]) (secondOf q)))

-- | record 分支只有一个（按字段序绑定）；catch-all 兜底。
genRecordAlts : Int -> FGen -> Int -> List IrAlt -> NRes (Pair (List Instr) FGen)
genRecordAlts fuel st sc alts = if fuel <= 0 then internal "native codegen fuel exhausted"
else case alts of
  [] => genDefault (fuel - 1) st sc []
  alt :: rest => case irAltCtorOf alt of
    Nothing => genDefault (fuel - 1) st sc alts
    Just _ =>
      nbind (bindFields st sc 0 (runtimeBinders (irAltBindersOf alt)))
        (\bp => nbind (genExpr (fuel - 1) (secondOf bp) (irAltBodyOf alt)) (\q => NOk (Pair (append (firstOf bp) (firstOf q)) (secondOf q))))

genNatArm : Int -> FGen -> Maybe IrAlt -> String -> Int -> NRes (Pair (List Instr) FGen)
genNatArm _ st Nothing _ _ = NOk (Pair [] st)
genNatArm fuel st (Just alt) mode srcSlot = if fuel <= 0 then internal "native codegen fuel exhausted"
else
  let
    bs = runtimeBinders (irAltBindersOf alt)
  in case bs of
    [] => genExpr (fuel - 1) st (irAltBodyOf alt)
    [b] => if mode == "none" then internal "Nat case arm has a binder but no runtime binding"
    else
      let
        slotP = freshSlot st
        slot = firstOf slotP
        st1 = secondOf slotP
        bindInstrs =
          if mode == "pred" then append (loadSlot srcSlot) [IBin "sub" (OpImm 1)]
          else loadSlot srcSlot
      in nbind (genExpr (fuel - 1) (pushBinder b slot st1) (irAltBodyOf alt))
        (\q => NOk (Pair (append bindInstrs (append (storeSlot slot) (firstOf q))) (restoreBinderScope (secondOf q) st.fgSlots)))
    _ => internal "Nat case arm has more than one runtime binder"

hasNatBranch : Maybe IrAlt -> Maybe IrAlt -> Bool
hasNatBranch (Just _) _ = True
hasNatBranch Nothing (Just _) = True
hasNatBranch Nothing Nothing = False

genNatCase : Int -> FGen -> Ir -> Maybe IrAlt -> Maybe IrAlt -> Maybe IrAlt -> NRes (Pair (List Instr) FGen)
genNatCase fuel st scrut zero succ catch = if fuel <= 0 then internal "native codegen fuel exhausted"
else nbind (genExpr (fuel - 1) st scrut) (\p => let
  st1 = secondOf p
  slotP = freshSlot st1
  slotSc = firstOf slotP
  st2 = secondOf slotP
  lzP = freshLabel st2
  lz = firstOf lzP
  st3 = secondOf lzP
  lendP = freshLabel st3
  lend = firstOf lendP
  st4 = secondOf lendP
  zeroAlt = case zero of
    Just z => Just z
    Nothing => catch
  zeroMode = case zero of
    Just _ => "none"
    Nothing => "sc"
  succAlt = case succ of
    Just s => Just s
    Nothing => catch
  succMode = case succ of
    Just _ => "pred"
    Nothing => "sc"
in if not (hasNatBranch zero catch) then internal "Nat case has no zero/catch branch"
else if not (hasNatBranch succ catch) then internal "Nat case has no succ/catch branch"
else nbind (genNatArm (fuel - 1) st4 zeroAlt zeroMode slotSc) (\z => nbind (genNatArm (fuel - 1) (secondOf z) succAlt succMode slotSc) (\s => let
  body =
    append (firstOf p)
      (append (storeSlot slotSc) (append [ICmp (OpMem Rbp (nativeSlotOff slotSc)) (OpImm 0), IJcc "je" lz] (append (firstOf s) (append [IJmp lend, ILabel lz] (append (firstOf z) [ILabel lend])))))
in NOk (Pair body (secondOf s))
)
)
)

-- ---------------------------------------------------------------
-- 定义
-- -----------------------------------------------------------
bindArgs : List IrBinder -> FGen -> NRes (Pair (List Instr) FGen)
bindArgs bs st = bindArgsGo bs 0 st

-- | 绑定形参：前 6 个来自参数寄存器，其余来自调用方压栈（`[rbp+16]` 起）。
bindArgsGo : List IrBinder -> Int -> FGen -> NRes (Pair (List Instr) FGen)
bindArgsGo [] _ st = NOk (Pair [] st)
bindArgsGo (b :: rest) i st =
  let
    src = case argRegAt i of
      Just reg => [IMov (OpReg Rax) (OpReg reg)]
      Nothing => [IMov (OpReg Rax) (OpMem Rbp (nativeStackArgOff i))]
    slotP = freshSlot st
    slot = firstOf slotP
    st1 = secondOf slotP
    store = append src [IMov (OpMem Rbp (nativeSlotOff slot)) (OpReg Rax)]
  in nbind (bindArgsGo rest (i + 1) (pushBinder b slot st1))
    (\q => NOk (Pair (append store (firstOf q)) (secondOf q)))

-- | 生成一个定义；返回函数与该定义之后**全局** label/slot 计数（label 必须跨定义
--   累加，否则两个函数会撞同名 `.L`）。
genDefFunc : List IrDef -> List (Pair String String) -> List IrTyDecl -> Int -> IrDef -> NRes (Pair NativeFunc Int)
genDefFunc _defs _pool _fams _nextLabel (IrExternDef name _ _ _) =
  unsupported "native target: extern definition `${name}` is not supported yet"
genDefFunc defs pool fams nextLabel (IrDef name arity _ body _ _ _) =
  let
    st0 = FGen defs pool [] fams 0 nextLabel
  in if arity == 0 then nbind (genExpr 100000 st0 body) (\p => let
    st1 = secondOf p
    frame = nativeFrameBytes st1.fgNextSlot
    instrs = append (firstOf p) nativeEpilogue
  in NOk
    (Pair (NativeFunc (nativeFuncLabel name) frame (append (nativePrologue frame) instrs)) st1.fgNextLabel)
  )
  else case body of
    IrLam bs inner =>
      let
        rbs = runtimeBinders bs
      in if length rbs /= arity then internal "function body lambda arity mismatch: ${name}"
      else nbind (bindArgs rbs st0) (\bp => nbind (genExpr 100000 (secondOf bp) inner) (\q => let
        st1 = secondOf q
        frame = nativeFrameBytes st1.fgNextSlot
        instrs = append (firstOf bp) (append (firstOf q) nativeEpilogue)
      in NOk
        (Pair (NativeFunc (nativeFuncLabel name) frame (append (nativePrologue frame) instrs)) st1.fgNextLabel)
      )
      )
    _ => internal "function body is not a lambda: ${name}"

genDefs : List IrDef -> List (Pair String String) -> List IrTyDecl -> Int -> List IrDef -> List NativeFunc -> NRes (Pair (List NativeFunc) Int)
genDefs _all _pool _fams next [] acc = NOk (Pair (reverse acc) next)
genDefs all pool fams next (d :: rest) acc =
  nbind (genDefFunc all pool fams next d)
    (\p => genDefs all pool fams (secondOf p) rest (firstOf p :: acc))

-- ---------------------------------------------------------------
-- 入口
-- -----------------------------------------------------------
entryShowKind : Ir -> Maybe String
entryShowKind (IrRt s) = case s of
  "@ir@showInt" => Just "int"
  "@ir@showNat" => Just "int"
  "@ir@showBool" => Just "bool"
  "@ir@showStr" => Just "str"
  _ => Nothing
entryShowKind _ = Nothing

startFunc : Bool -> String -> String -> NativeFunc
startFunc printResult kind mainName =
  let
    initHeap =
      [ ILea Rax nativeHeapLabel,
        IMov (OpRip nativeHeapPtrLabel) (OpReg Rax),
        IMov (OpReg Rcx) (OpReg Rax),
        IBinReg "add" Rcx (OpImm nativeHeapBytes),
        IMov (OpRip nativeArenaEndLabel) (OpReg Rcx)
      ]
    callMain = [IBinReg "and" Rsp (OpImm (0 - 16)), ICall (nativeFuncLabel mainName)]
    printer = if printResult then case kind of
      "bool" => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_bool")]
      "str" =>
        [ IMov (OpReg Rdi) (OpReg Rax),
          ICall (nativeRtLabel "show_str"),
          IMov (OpReg Rdi) (OpReg Rax),
          ICall (nativeRtLabel "print_str")
        ]
      _ => [IMov (OpReg Rdi) (OpReg Rax), ICall (nativeRtLabel "print_int")]
    else []
    exitInstrs = [IMov (OpReg Rax) (OpImm 60), IMov (OpReg Rdi) (OpImm 0), ISyscall]
  in NativeFunc nativeEntryLabel 0 (append initHeap (append callMain (append printer exitInstrs)))

-- ---------------------------------------------------------------
-- 装配
-- -----------------------------------------------------------
export build : IrProgram -> Bool -> NativeOutcome
build program printResult =
  let
    unit = irProgUnitOf program
    defs = concatMap irGroupDefs unit.irUnitGroups
  in case unit.irUnitEntry of
    Nothing => NativeRejected (NativeUnsupported "native target: no main definition")
    Just e => if irEntryIsActionOf e then NativeRejected (NativeUnsupported "native target: effectful main is not supported yet")
    else
      let
        mainName = irEntryMainOf e
      in case findDef mainName defs of
        Nothing => NativeRejected (NativeUnsupported "native target: main definition not found")
        Just mainDef => if irDefArity mainDef /= 0 then NativeRejected (NativeUnsupported "native target: main must be a zero-argument value")
        else
          let
            kindM = if printResult then entryShowKind (irEntryShowOf e) else Just "none"
          in case kindM of
            Nothing =>
              NativeRejected
                (NativeUnsupported "native target: custom Show entry is not supported yet")
            Just kind =>
              let
                needed = collectNeeded 100000 [mainName] [] defs
                ordered = filter (\d => memStr (irDefName d) needed) defs
                pool = poolOfDefs ordered
              in case genDefs defs pool unit.irUnitTyDecls 0 ordered [] of
                NFail err => NativeRejected err
                NOk pair =>
                  let
                    start = startFunc printResult kind mainName
                  in NativeOk
                    (NativeProgram nativeRodata (poolItems pool) nativeBss (append nativeRtFuncs (append (firstOf pair) [start])))
