-- | 编译管线的图节点族：node key 构造 + **审计路径**的提交 helper。
module Vuna.Compiler.Driver.Graph where

-- Vuna.Compiler.Driver.Graph：把「包级 check / build」的缓存判定搬进查询图（阶段 2）。
--
-- 这里只放**纯**部分：节点 key 的构造、输入摘要依赖表、以及审计路径的提交 helper。
-- 真正的执行（命中判定 / 精化 / codegen / span / 取消）在 `Driver.Compile`，统一经
-- `Query.Run.runCachedNode`——同一份「命中 ⇒ 跳过、未命中 ⇒ 算 + 提交」语义只有一处。
-- `Driver.Compile` import 本模块，反向不行——否则成环。
--
-- 节点族（key 是纯字符串，不参与哈希输入）：
--
--   check:<pkg>:<kind>            包级 check 节点（值 = `QMarker`）
--   split:<pkg>:pr0|pr1           包级 build 节点（值 = 产物 blob 的 `QRef`）
--   env:<pkg>:<manifestHash>      包的 vuna.toml 内容摘要
--   src:<pkg>:<closureHash>       本包源文件闭包摘要
--   deps:<pkg>:<closureHash>      依赖包接口闭包摘要
--   ver:<verHash>                 编译器版本 + 指纹
--
-- **为什么输入节点的摘要直接写进 key**：这些输入每轮都要重新读盘算摘要（否则跨进程
-- 会读到过期值——`Db` 的纯语义没有「输入可变」概念）。把摘要放进 key 是最省的做法：
-- 任何输入变化 ⇒ key 串变化 ⇒ check 节点的依赖表变化（`sameDeps` 比 key 名）⇒ miss。
-- 因此输入节点**不需要**真的存在 `Db` 里（缺 dep 用 `QBytes key` 占位，摘要仍是 key 的
-- 函数，同一轮内稳定）。
--
-- 与旧 `check/` marker 目录的关系：语义完全等价（四个摘要全等 ⇒ 命中），但判定从「拼一个
-- 复合 key 当文件名」变成「一个节点 + 依赖快照」，可以直接被 `Query.Run` 的会话索引持久化，
-- 且是和其它图节点同一套 cutoff / trace / span 语义。
import Base.List
import Base.Pair
import Base.String
import Vuna.Compiler.Query
import Vuna.Compiler.Query.Run

-- | 包级 check 节点的输入摘要（四个 hash + kind）。
--
-- `cmKind` = `exe`（可执行包入口）/ `lib:<namesHash>`（库包导出面）。`cmVer` 是
-- 「编译器版本 + 指纹」，换二进制即整套 node key 换代。
export record CheckMods(..) where
  cmPkg : String
  cmKind : String
  cmManifest : String
  cmSources : String
  cmDeps : String
  cmVer : String

-- | 拼 `CheckMods`（纯构造；摘要由调用方算好传入）。
export checkModsOf : String -> String -> String -> String -> String -> String -> CheckMods
checkModsOf pkg kind manifest sources deps ver = CheckMods pkg kind manifest sources deps ver

-- | 通用节点 key：`<family>:<pkg>:<kind>`（稳定：不含摘要；摘要进依赖表）。
export graphNodeKey : String -> CheckMods -> String
graphNodeKey family m = "${family}:${m.cmPkg}:${m.cmKind}"

-- | check 节点的 key。
export checkNodeKey : CheckMods -> String
checkNodeKey m = graphNodeKey "check" m

-- | 四个输入节点的 key（顺序固定 = env / src / deps / ver）。
export graphCheckMods : CheckMods -> List String
graphCheckMods m =
  [ nodeEnvKey m.cmPkg m.cmManifest,
    nodeSrcKey m.cmPkg m.cmSources,
    nodeDepsKey m.cmPkg m.cmDeps,
    nodeCompilerKey m.cmVer
  ]

export nodeEnvKey : String -> String -> String
nodeEnvKey pkg manifestHash = "env:${pkg}:${manifestHash}"

export nodeSrcKey : String -> String -> String
nodeSrcKey pkg closureHash = "src:${pkg}:${closureHash}"

export nodeDepsKey : String -> String -> String
nodeDepsKey pkg closureHash = "deps:${pkg}:${closureHash}"

export nodeCompilerKey : String -> String
nodeCompilerKey verHash = "ver:${verHash}"

-- | 包级 check 会话的配置：来源 `pkg`、不设预算、按包名分桶持久化。
export graphRunOpts : String -> RunOpts
graphRunOpts pkg = RunOpts "pkg" 0 True pkg

-- | 审计路径（`VUNA_IFACE_AUDIT=1`）提交一次成功的 build：值 = 产物内容地址 `QRef`，
-- 依赖表 = 本次输入摘要。正常路径的提交由 `Query.Run.runCachedNode` 做，不用本函数。
export graphCommitRef : Db -> String -> CheckMods -> String -> Db
graphCommitRef db key mods digest =
  firstOf (queryResolve db key (graphCheckMods mods) (Pair (QRef digest) []))

-- 说明：`Db` 的 trace 行只用于调试与测试断言（`--debug-query` / `Query.Run.runSpansText`），
-- 不参与正确性；会话索引落盘前会被裁掉（`Query.Run.encQueryIndex` 不含 trace）。
