module Vuna.Compiler.Driver.Compile where

-- Vuna.Compiler.Driver.Compile：编译入口（供 CompilerCli / 测试使用）。唯一路径是 DT：
-- 精化（Elab）→ 擦除检查 + 逐模块 OCaml 生成（Codegen.Split）；`check*` 只检查不产码。
-- M26：包上下文（`PackageContext`）是唯一入口形状；旧的 `effectiveRoots` /
-- 单文件 codegen（main.ml + build.sh）/ `seedSplit` 已删除——`compile` 与 `seed`
-- rotation 共用 `compileToDir`（目录 + build.sh）。
-- M30：`build` 在链接成功后写 `build-meta.json`（源/依赖闭包内容哈希 + compiler 版本），
-- 同哈希直接跳过；`compile` / `build --no-compile` 不写 meta（seed rotation 与快照
-- 只认 .ml/build.sh 的确定性产物）。
-- C35：codegen 改为全限定跨单元引用后，每个模块只 `open` / 依赖它真正引用的前序单元；
-- `writeCompiledNormalized` 把 SplitFile 的直接依赖传给 `buildScript`，生成的 build.sh 按 vuna
-- 预先算好的层**分层并行**编译 + 精确增量（每单元 stamp 只含直接依赖），依赖图不再
-- 退化为全序链。
--
-- 效果显式化：扫描/读文件/写文件/建目录/删除/子进程/时钟/环境/二进制指纹全部显式在
-- `Eff hostRow` 里；纯逻辑（路径/哈希/序列化/缓存键计算/AST 变换）保持纯函数。下挂模块
-- （`Driver.Split`、`Driver.Dt`、`Packages.Pkg` 的磁盘层）同样是 `Eff hostRow`，这里直接调用。
import Base.HostRow
import Vuna.Compiler.Addr
import Vuna.Compiler.Common
import Vuna.Compiler.Hash
import Vuna.Compiler.Diagnostics.Pkg
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Fingerprint
import Vuna.Compiler.Store
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Packages.Source
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Elab
import Vuna.Compiler.Driver.Cache
import Vuna.Compiler.Driver.Iface
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader
import Vuna.Compiler.Version
import Base.List

-- ---------------------------------------------------------------
-- 效果辅助（本模块自用；顺序与纯 `map` / `concatMap` / `mapMaybe` 一致）
-- ---------------------------------------------------------------
mapEff : (a -> Eff hostRow b) -> List a -> Eff hostRow (List b)
mapEff f [] = pure []
mapEff f (x :: rest) = do
  y <- f x
  ys <- mapEff f rest
  pure (y :: ys)

concatMapEff : (a -> Eff hostRow (List b)) -> List a -> Eff hostRow (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

mapMaybeEff : (a -> Eff hostRow (Maybe b)) -> List a -> Eff hostRow (List b)
mapMaybeEff f [] = pure []
mapMaybeEff f (x :: rest) = do
  y <- f x
  ys <- mapMaybeEff f rest
  pure (case y of
    Just v => v :: ys
    Nothing => ys
  )

-- 包级 check：可执行包检查 app/Main.vuna；库包检查 [export].modules。
-- M34.5：结果走磁盘缓存（key = 闭包源哈希 + 依赖哈希 + manifest + 版本）。
-- M45：`wantWarnings` = 调用方要 warning（`-W` / `--deny-warnings`）。warning 不持久化，
-- 缓存命中/干净模块复用都会跳过精化、丢掉 warning，所以这里跳过 check 缓存并强制本包
-- 模块重算（依赖仍走接口摘要，不重算依赖包）。
export checkPackage : Bool -> Bool -> Package -> Eff hostRow (Check (List Diagnostic))
checkPackage release wantWarnings pkg =
  let
    ctx = contextWithRelease release (packageContext pkg)
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists (packageEntry pkg))
    if exists then do
      exeR <- checkCachedExe wantWarnings ctx (packageEntry pkg)
      case exeR of
        ErrC e => pure (ErrC e)
        OkC ds => case packageExports pkg of
          -- 纯可执行包：入口闭包就是全部模块面。
          Nothing => pure (OkC ds)
          -- 既是可执行包又导出库模块：入口闭包之外还有模块面。依赖方可能 import 这些模块，
          -- 而接口对象只从被精化的模块产生 —— 不补这一次 lib check，包会「有源文件但没有
          -- 接口」，依赖方读接口缺件后只能整体回退全量。第二遍不重复报 warning。
          Just names => do
            -- 入口闭包已经覆盖全部导出模块时（典型：Main import 了库模块），入口那遍
            -- 已经写全 order + iface 对象，再补一遍 lib check 只会重复精化整包
            -- （4000 定义探针上约 +0.9 s，且放大增长比）。order 只在「完整模块面」
            -- 写成功后才存在，所以「order 覆盖 names」等价于 iface 也已写全。
            covered <- orderCoversEff (packageName pkg) names
            if covered then do
              let
                _ = dbg! "check-lib-skip covered=${length names}"
              in pure (OkC ds)
            else do
              libR <- checkCachedLib False ctx names
              case libR of
                ErrC e => pure (ErrC e)
                OkC ds2 => pure (OkC (append ds ds2))
    else case packageExports pkg of
      Nothing => pure (pkgNoLoc1 (LibraryWithoutEntry (packageName pkg)) (packageName pkg))
      Just names => checkCachedLib wantWarnings ctx names

-- 逐级创建目录（`--out a/b` 的父目录可能不存在）。
--
-- 并发注意：并行构建会在同一目录上竞争；宿主 `makeDir` 不幂等（EEXIST 直接抛异常），
-- 「先 exists 再 makeDir」有 TOCTOU 窗口。末级创建走 `mkdir -p`（幂等）。
-- 递归沿 `parentOfPath` 上升，不是结构下降，用显式 fuel 守卫（路径深度上限）。
export ensureDirPath : String -> Eff hostRow Int
ensureDirPath path = ensureDirPathFuel 256 path

ensureDirPathFuel : Int -> String -> Eff hostRow Int
ensureDirPathFuel fuel path = if fuel <= 0 then pure 0
else if path == "" || path == "." || path == "/" then pure 0
else do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then pure 0 else @vuna@prim_eff_runIn "." ["mkdir", "-p", path]

-- 去掉最后一段（`a/b/c` -> `a/b`；无 `/` -> "."；绝对路径的父仍绝对）。
-- 先 reverse，跳过第一个 `/` 后剩下的字符再 reverse 回来。
dropPastSlash : List Int -> List Int
dropPastSlash [] = []
dropPastSlash (c :: rest) = if c == 47 then rest else dropPastSlash rest

parentOfPath : String -> String
parentOfPath path =
  let
    chars = strUnpack path
    rev = reverse chars
    after = dropPastSlash rev
  in if length after == length rev then "."
  else
    let
      parent = strPack (reverse after)
    in if parent == "" then if startsWith "/" path then "/" else "."
    else if startsWith "/" path && not (startsWith "/" parent) then "/${parent}" else parent

-- 逐模块 split 输出到 outDir：各模块 .ml + Main.ml + build.sh；Ok 写出的文件数。
-- outDir 在 codegen 成功后才创建（精化失败不留产物）。
-- M33 W5：包根 `ffi/*.c` 复制到 `OUTDIR/ffi/` 并写进 build.sh（受限 FFI 的 C 实现）。
export compileToDir : PackageContext -> String -> Bool -> String -> Eff hostRow (Check (Pair Int (List Diagnostic)))
compileToDir ctx entry printResult outDir = do
  audit <- ifaceAuditRequested
  if audit then auditCompile ctx entry printResult outDir
  else compileToDirNormal ctx entry printResult outDir

-- 摘要路径的 split（**不读 split 缓存**）：接口可用 ⇒ 摘要路径（干净模块 + 依赖接口），
-- 否则全量。抽出来供正常路径与审计路径共用，保证两条路径的「摘要分支」完全一致。
-- 构建路径的 codegen 口径：**只用同一套（全量）**。
--
-- 为什么要放弃「干净模块从接口补 defloc 行」这条增量口径：`miDefLocs` 只记录
-- `cachedDefs` 里有 span 的定义，而全量路径的位置表由 Lowering 从完整程序算出——两者
-- 在派生/预处理定义上不等（实测差的是一行 `Member.greet`）。于是同一个输入在「冷 store
-- → 全量」与「热 store → 增量」下产出不同字节；旧的内容寻址 blob 把它掩盖了（节点记住
-- 第一份内容），改成输入寻址后同一路径被两份内容先后覆盖（§41 回归）。
-- 现在构建一律走全量 lowering（单元缓存仍按声明哈希命中，所以热构建依然快），
-- 产物因此是输入摘要的纯函数。
summarySplitParts : PackageContext -> String -> Bool -> Eff hostRow (Check (Pair (List SplitFile) CheckedPackage))
summarySplitParts ctx entry printResult = do
  depIfaces <- depIfacesOf ctx
  case depIfaces of
    Just ifaces => do
      depTbl <- depIfaceHashTable ctx
      clean <- ownCleanModules ctx depTbl
      let
        _ = case clean of
          Just clean2 => dbg! "cache-own-clean=${length clean2}"
          Nothing => 0
      in do
        dtSplitProjectWithIfaces ctx entry printResult ifaces
    Nothing => dtSplitProjectParts ctx entry printResult

-- | 构建（codegen）入口：两级输入寻址。
--
-- 1. **快 key**（`splitInOf`）：源闭包 + 依赖身份 + 编译器指纹；命中
--    `objects/splitptr/<快 key>` 就直接读语义 blob（未改动源码 = 零精化）；
-- 2. **语义 key**（`splitIdentityOf`）：本包 `pkgIfaceHash` + `pkgImplHash` + 布局摘要；
--    `blobs/<语义 key>` 是产物真身。注释变更 ⇒ 快 key 变、语义 key 不变 ⇒ 精化一次、
--    codegen 复用；行移动 ⇒ 布局摘要变 ⇒ 重建（运行时位置表正确）。
compileToDirNormal : PackageContext -> String -> Bool -> String -> Eff hostRow (Check (Pair Int (List Diagnostic)))
compileToDirNormal ctx entry printResult outDir = do
  mods <- splitModsOf ctx entry printResult
  let
    fast = splitInOf mods
  in do
    ptr <- readSplitPointer fast
    case ptr of
      Just sem => do
        cached <- readSplitBlob sem
        case cached of
          Just files => do
            let
              _ = dbg! "split-pointer-hit cache-path=hit"
            in do
              n <- writeCompiledNormalized ctx outDir files
              pure (case n of
                ErrC e => ErrC e
                OkC count => OkC (Pair count [])
              )
          Nothing => rebuildSplit ctx entry printResult outDir fast
      Nothing => rebuildSplit ctx entry printResult outDir fast

-- 快指针未命中：精化一次 → 写接口（返回模块摘要）→ 语义 key → blob 命中则复用，
-- 否则 codegen + 写 blob + 写快指针。
rebuildSplit : PackageContext -> String -> Bool -> String -> String -> Eff hostRow (Check (Pair Int (List Diagnostic)))
rebuildSplit ctx entry printResult outDir fast = do
  summary <- summarySplitParts ctx entry printResult
  case summary of
    ErrC e => pure (ErrC e)
    OkC p => do
      let
        canon = canonicalTopo (firstOf p)
        checked = secondOf p
      in do
        shadow <- writeIfaceShadow ctx checked
        case shadow of
          ErrC e => pure (ErrC e)
          OkC modules => do
            tag <- compilerTagEff
            let
              -- 入口-only 包没有可写的模块面（`modules=[]`），语义 key 无从谈起：
              -- 退回源输入 key（正确优先，放弃这类包的注释复用）。
              sem = case modules of
                [] => fast
                _ => splitIdentityOf ctx printResult tag modules
            in do
              cached <- readSplitBlob sem
              case cached of
                Just files => do
                  _ <- writeSplitPointer fast sem
                  _ <- rootKeepEff ctx [fast, sem]
                  let
                    _ = dbg! "split-identity-hit cache-path=hit"
                  in do
                    n <- writeCompiledNormalized ctx outDir files
                    pure (case n of
                      ErrC e => ErrC e
                      OkC count => OkC (Pair count checked.checkedWarnings)
                    )
                Nothing => do
                  _ <- writeSplitBlobAt sem canon
                  _ <- writeSplitPointer fast sem
                  _ <- rootKeepEff ctx [fast, sem]
                  n <- writeCompiledNormalized ctx outDir canon
                  pure (case n of
                    ErrC e => ErrC e
                    OkC count => OkC (Pair count checked.checkedWarnings)
                  )

-- 审计（`VUNA_IFACE_AUDIT=1`）：同一进程分别走摘要路径与全量路径，codegen 产物逐字节比较；
-- 一致才落盘，不一致报 `iface-audit-mismatch` 且**不写任何缓存/接口**。
auditCompile : PackageContext -> String -> Bool -> String -> Eff hostRow (Check (Pair Int (List Diagnostic)))
auditCompile ctx entry printResult outDir = do
  mods <- splitModsOf ctx entry printResult
  summary <- summarySplitParts ctx entry printResult
  full <- dtSplitProjectParts ctx entry printResult
  let
    _ = dbg! "iface-audit subject=compile entry=${entry}"
  in do
    compared <-
      pure (auditCompare "compile" entry (splitSignatureOf summary) (splitSignatureOf full))
    case compared of
      ErrC e => pure (ErrC e)
      OkC _ => case summary of
        ErrC e => pure (ErrC e)
        OkC p => do
          let
            files = firstOf p
            checked = secondOf p
            canon = canonicalTopo files
            fast = splitInOf mods
          in do
            shadow <- writeIfaceShadow ctx checked
            case shadow of
              ErrC e => pure (ErrC e)
              OkC modules => do
                tag <- compilerTagEff
                let
                  sem = case modules of
                    [] => fast
                    _ => splitIdentityOf ctx printResult tag modules
                in do
                  _ <- writeSplitBlobAt sem canon
                  _ <- writeSplitPointer fast sem
                  _ <- rootKeepEff ctx [fast, sem]
                  n <- writeCompiledNormalized ctx outDir canon
                  pure (case n of
                    ErrC e => ErrC e
                    OkC count => OkC (Pair count checked.checkedWarnings)
                  )

-- 把**已规范拓扑序**的 split 文件写入 outDir 并写 build.sh。
-- 调用方保证 files 已过 `canonicalTopo`：命中路径的 blob 在写侧就规范化了，未命中路径
-- 在写 blob 前规范化。build.sh 的层/顺序因此不在热路径重算（旧实现每次命中都重跑
-- `canonicalTopo`，119 单元时占 build-warm 的 ~250 ms）。
writeCompiledNormalized : PackageContext -> String -> List SplitFile -> Eff hostRow (Check Int)
writeCompiledNormalized ctx outDir files = do
  _ <- ensureDirPath outDir
  let
    _ = dbg! "write-compiled-start"
  in do
    written <- writeSplitFilesIfChanged outDir files
    case written of
      ErrC e => pure (ErrC e)
      OkC n => do
        let
          _ = dbg! "write-split-files-done"
          graph = splitGraph files
          _ = dbg! "split-graph-done"
        in do
          cFiles <- copyFfiFiles (contextDir ctx) outDir
          _ <-
            raiseToRow hostRow
              (@vuna@prim_eff_writeFile "${outDir}/build.sh" (buildScript graph cFiles))
          let
            _ = dbg! "build-script-done"
          in do
            pure (OkC n)

-- 包根 `ffi/*.c` → OUTDIR/ffi/<name>.c；返回写进 build.sh 的相对路径列表。
-- 没有 ffi/ 目录时返回 []（旧包行为不变）。
copyFfiFiles : String -> String -> Eff hostRow (List String)
copyFfiFiles ctxDir outDir = do
  let
    ffiDir = "${ctxDir}/ffi"
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists ffiDir)
    isDir <- if exists then @vuna@prim_eff_isDirectory ffiDir else pure False
    if exists && isDir then do
      names <- raiseToRow hostRow (@vuna@prim_eff_readDir ffiDir)
      let
        cs = filter (\n => endsWith ".c" n) names
      in do
        _ <- ensureDirPath "${outDir}/ffi"
        _ <- mapEff (\n => do
          content <- raiseToRow hostRow (@vuna@prim_eff_readFile "${ffiDir}/${n}")
          @vuna@prim_eff_writeFile "${outDir}/ffi/${n}" content
        ) cs
        pure (map (\n => "ffi/${n}") cs)
    else pure []

-- loadPackage + compileToDir：给定包目录的代码生成（seed rotation / 测试用）。
export buildSplit : String -> String -> Eff hostRow (Check Int)
buildSplit dir outDir = do
  pkgR <- loadPackage dir
  case pkgR of
    ErrC e => pure (ErrC e)
    OkC pkg => do
      r <- compileToDir (packageContext pkg) (packageEntry pkg) True outDir
      pure (case r of
        ErrC e => ErrC e
        OkC p => OkC (firstOf p)
      )

-- ---------------------------------------------------------------
-- M30：build meta（确定性、无绝对路径/时间戳）
--
-- 目的：同输入同产物 + 依赖闭包哈希 + 同哈希跳过。meta 只记录**模块名**与内容
-- 哈希（模块名由模块根相对路径推导，跨机器稳定）；不记录绝对路径/时间戳。
-- `build` 链接成功后写；`compile` / `build --no-compile` 不写（seed rotation 与
-- 快照只认 .ml/build.sh）。
-- ---------------------------------------------------------------
metaSchema : Int
metaSchema = 1

metaFileName : String
metaFileName = "build-meta.json"

-- 内容哈希：SHA-256 的 63-bit 派生键（替代旧的「strHash 10-bit + 长度」组合）。
textHash : String -> Int
textHash s = Vuna.Compiler.Hash.contentKey s

-- M34.5：编译器二进制指纹（缓存 key 必须含它：check/codegen 语义随编译器变化）。
-- M38：用**可执行文件自身**的路径 + 大小 + mtime，而不是 `@vuna@prim_eff_getArgs` 的第一个用户参数。
-- 旧实现把子命令名（如 `test`）当路径：只要 cwd 里恰好有同名文件/目录（包根的 `test/`
-- 就是最常见的情况），`@vuna@prim_eff_readFile` 会去读目录并抛 `Failure("readFile: ...")`——
-- `vuna test` 在包根直接崩溃即此。store 路径 + size + mtime 足以区分重新构建的编译器。
-- env/stat 是宿主动作，显式 `Eff hostRow`。
compilerFingerprint : Eff hostRow Int
compilerFingerprint = compilerFingerprintEff

-- 缓存根：与对象库同一棵树（`storeRootEff`）。split / unit / 会话索引都落在这里，
-- 这样 GC / roots 只需要认识一个根。
cacheBase : Eff hostRow String
cacheBase = storeRootReadyEff

-- 目录遍历（模块根内的 .vuna）。跳过名单与包内容收集共用一份（`Packages.Source`），
-- 避免「什么算包内容」出现两套规则。fuel 守卫目录图（符号链接环）。
skipMetaDir : String -> Bool
skipMetaDir name = skipSourceDir name

collectVunaMeta : Int -> String -> Eff hostRow (List String)
collectVunaMeta fuel dir = if fuel <= 0 then pure []
else do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists dir)
  isDir <- if exists then @vuna@prim_eff_isDirectory dir else pure False
  if exists && isDir then do
    names <- raiseToRow hostRow (@vuna@prim_eff_readDir dir)
    concatMapEff (walkVunaMeta (fuel - 1) dir) names
  else pure []

walkVunaMeta : Int -> String -> String -> Eff hostRow (List String)
walkVunaMeta fuel dir name = if fuel <= 0 then pure []
else case name of
  "." => pure []
  ".." => pure []
  _ => if skipMetaDir name then pure []
  else do
    let
      path = "${dir}/${name}"
    in do
      exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
      isDir <- if exists then @vuna@prim_eff_isDirectory path else pure False
      if exists && isDir then collectVunaMeta (fuel - 1) path
      else pure (if endsWith ".vuna" name then [path] else [])

dropPrefixMeta : String -> String -> String
dropPrefixMeta prefix s =
  if startsWith prefix s then substring (byteLength prefix) (byteLength s - byteLength prefix) s
  else s

slashesToDots : String -> String
slashesToDots s = strPack (map slashToDot (strUnpack s))

slashToDot : Int -> Int
slashToDot c = if c == 47 then 46 else c

moduleNameOfPath : String -> String -> String
moduleNameOfPath rootPath path =
  let
    rel0 = dropPrefixMeta "${rootPath}/" path
    rel = if endsWith ".vuna" rel0 then substring 0 (byteLength rel0 - 5) rel0 else rel0
  in slashesToDots rel

rootSources : Root -> Eff hostRow (List (Pair String Int))
rootSources root = do
  paths <- collectVunaMeta 1048576 (rootDir root)
  mapEff (\p => do
    content <- raiseToRow hostRow (@vuna@prim_eff_readFile p)
    pure (Pair (moduleNameOfPath (rootDir root) p) (textHash content))
  ) paths

rootHash : Root -> Eff hostRow Int
rootHash root = do
  sources <- rootSources root
  pure (closureHashOf sources 0)

closureHashOf : List (Pair String Int) -> Int -> Int
closureHashOf [] acc = acc
closureHashOf ((Pair name h) :: rest) acc = closureHashOf rest (acc * 1000003 + h)

-- 入口文件 + 所有模块根的源码（模块名 → 哈希）。
entrySource : String -> Eff hostRow (Pair String Int)
entrySource entry = do
  content <- raiseToRow hostRow (@vuna@prim_eff_readFile entry)
  pure (Pair "<entry>" (textHash content))

-- 本包自己的模块根（依赖根由 `depIdentitiesEff` 的接口身份负责，不进源闭包）。
ownRootsOf : PackageContext -> List Root
ownRootsOf ctx = filter (\r => rootName r == contextPackageName ctx) (contextRoots ctx)

contextSources : PackageContext -> String -> Eff hostRow (List (Pair String Int))
contextSources ctx entry = do
  own <- concatMapEff rootSources (ownRootsOf ctx)
  es <- entrySource entry
  pure (append own [es])

-- 依赖闭包（跳过第一个根：它是本包自己的 lib；base-only 由 build 不会走到）。
dependencyHashes : PackageContext -> Eff hostRow (List (Pair String Int))
dependencyHashes ctx = case contextRoots ctx of
  [] => pure []
  _ :: deps => mapEff (\r => do
    h <- rootHash r
    pure (Pair (rootName r) h)
  ) deps

-- ---------------------------------------------------------------
-- 依赖身份（D69）：依赖方只消费依赖包的**接口身份**，不是源字节闭包。
--
-- 依赖包 check/build 成功后写一个稳定对象 `objects/pkgiface/<key>`，key = 包名 + 该包
-- lib 根源闭包摘要 + 编译器 tag，载荷 = `pkgIfaceHashOfModules`。依赖方按同样的 key 读取：
--   * 命中 ⇒ `iface:<pkgIfaceHash>`（注释 / 诊断配置 / opaque 体变化不脏依赖方）；
--   * 缺失（依赖还没 check、或源码变了还没重跑）⇒ `manifest:<toml 内容摘要>` 回退，
--     冷 store 仍可确定性判脏；依赖重跑后同一个接口身份会回到 `iface:` 值。
-- 没有读依赖接口对象，因此不会回到 `ifaceModsEff`（env）形成环。
-- ---------------------------------------------------------------
pkgIfaceSummaryKind : String
pkgIfaceSummaryKind = "pkgiface"

pkgIfaceSummaryCodec : String
pkgIfaceSummaryCodec = "pkg-iface-summary 1"

pkgIfaceSummaryKeyOf : String -> String -> String -> String
pkgIfaceSummaryKeyOf pkg srcClosure tag = addrOf ["pkgiface", pkg, srcClosure, tag]

-- | 依赖根的接口身份（或 manifest 回退）。
depRootIdentityEff : Root -> Eff hostRow (Pair String String)
depRootIdentityEff root = do
  h <- rootHash root
  tag <- compilerTagEff
  let
    key = pkgIfaceSummaryKeyOf (rootName root) (strFromInt h) tag
  in do
    saved <- storeObjectReadEff pkgIfaceSummaryKind pkgIfaceSummaryCodec key
    let
      verdict = case saved of
        Just _ => "iface"
        Nothing => "manifest"
      _ = dbg! "dep-identity=${rootName root} verdict=${verdict}"
    in case saved of
      Just s => pure (Pair (rootName root) "iface:${s}")
      Nothing => do
        let
          tomlPath = "${rootDir root}/vuna.toml"
        in do
          exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists tomlPath)
          toml <- if exists then @vuna@prim_eff_readFile tomlPath else pure ""
          pure (Pair (rootName root) "manifest:${textHash toml}")

depIdentitiesEff : PackageContext -> Eff hostRow (List (Pair String String))
depIdentitiesEff ctx = case contextRoots ctx of
  [] => pure []
  _ :: deps => mapEff depRootIdentityEff deps

depIdentitiesHash : List (Pair String String) -> String
depIdentitiesHash pairs = addrOf ("dep-identities" :: map pairText pairs)

pairText : Pair String String -> String
pairText p = "${firstOf p}=${secondOf p}"

-- | 写本包的接口身份摘要（供依赖方读；失败/缺根不影响正确性，只是依赖方回退 manifest）。
writePkgIfaceSummaryEff : PackageContext -> List ModuleIface -> Eff hostRow Int
writePkgIfaceSummaryEff ctx modules = case filter (\r => rootName r == contextPackageName ctx) (contextRoots ctx) of
  [] => pure 0
  r :: _ => do
    h <- rootHash r
    tag <- compilerTagEff
    let
      key = pkgIfaceSummaryKeyOf (contextPackageName ctx) (strFromInt h) tag
      payload = pkgIfaceHashOfModules (contextPackageName ctx) modules
    in storeObjectWriteEff pkgIfaceSummaryKind pkgIfaceSummaryCodec key payload

metaPairText : Pair String Int -> String
metaPairText (Pair name hash) = "{\"name\":\"${name}\",\"hash\":${hash}}"

joinJsonList : List String -> String
joinJsonList [] = ""
joinJsonList ([x]) = x
joinJsonList (x :: rest) = "${x},${joinJsonList rest}"

-- 路径最后一段（`splitPath` 按第一个 `/` 切，不适合取 basename）。
-- 输入是反向字符流；acc 里已是原顺序的最后一段字符，直接 strPack。
lastSegmentRev : List Int -> List Int -> String
lastSegmentRev [] acc = strPack acc
lastSegmentRev (c :: rest) acc = if c == 47 then strPack acc else lastSegmentRev rest (c :: acc)

lastSegment : String -> String
lastSegment path = lastSegmentRev (reverse (strUnpack path)) []

export buildMetaText : PackageContext -> String -> Bool -> Eff hostRow String
buildMetaText ctx entry linked = do
  sources <- contextSources ctx entry
  deps <- dependencyHashes ctx
  toml <- raiseToRow hostRow (@vuna@prim_eff_readFile "${contextDir ctx}/vuna.toml")
  let
    manifestHash = textHash toml
    entryName = lastSegment entry
    linkedText = if linked then "true" else "false"
  in do
    pure
      "{\"schema\":${metaSchema},\"compiler\":\"${vunaVersion}\",\"package\":\"${contextPackageName ctx}\",\"entry\":\"${entryName}\",\"linked\":${linkedText},\"closure\":${closureHashOf sources 0},\"manifest\":${manifestHash},\"sources\":[${joinJsonList (map metaPairText sources)}],\"dependencies\":[${joinJsonList (map metaPairText deps)}]}\n"

metaPathOf : String -> String
metaPathOf outDir = "${outDir}/${metaFileName}"

export writeBuildMeta : String -> PackageContext -> String -> Bool -> Eff hostRow Int
writeBuildMeta outDir ctx entry linked = do
  text <- buildMetaText ctx entry linked
  @vuna@prim_eff_writeFile (metaPathOf outDir) text

-- 同哈希跳过：meta 内容与期望（linked=true）完全一致，且产物二进制存在。
export metaUpToDate : String -> PackageContext -> String -> String -> Eff hostRow Bool
metaUpToDate outDir ctx entry binPath = do
  let
    path = metaPathOf outDir
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
    binExists <- if exists then @vuna@prim_eff_fileExists binPath else pure False
    if exists && binExists then do
      raw <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
      expected <- buildMetaText ctx entry True
      pure (raw == expected)
    else pure False

-- 在 dir 里跑生成的 build.sh：`sh build.sh <out>`（out 相对 dir，例如 "bin/<pkg>"）。
-- 链接失败给出带包名/目录/退出码的清晰错误（ocamlopt 的 stderr 已在终端）。
export runBuildScript : String -> String -> String -> Eff hostRow (Check Int)
runBuildScript dir out name = do
  code <- raiseToRow hostRow (@vuna@prim_eff_runIn dir ["sh", "build.sh", out])
  pure
    (if code == 0 then OkC 0 else err "build: ${name}: `sh build.sh ${out}` failed in ${dir} (exit ${code})")

-- 历史：旧实现是「拼一个复合 key 当文件名」（`check/` marker 目录），后来搬进查询图
-- 节点（`Query`），现在收敛成**输入寻址对象存在性**：`checkIn` 就是那四个摘要的哈希，
-- 存在即判过。查询图与会话索引都已删除（见 `docs/reference/cache.md`）。
-- ---------------------------------------------------------------
-- | 输入摘要的 schema（结构变化必须 bump；旧对象自然拒绝）。
checkNodeSchema : String
checkNodeSchema = "vuna-check-node 2"

hashText : Int -> String
hashText n = strFromInt n

-- | 可执行包的 check 节点输入：源闭包 / 依赖身份 / manifest / 编译器。
checkModsExe : PackageContext -> String -> Eff hostRow CheckMods
checkModsExe ctx entry = do
  sources <- contextSources ctx entry
  deps <- depIdentitiesEff ctx
  toml <- raiseToRow hostRow (@vuna@prim_eff_readFile "${contextDir ctx}/vuna.toml")
  fp <- compilerFingerprint
  let
    srcHash = closureHashOf sources 0
    manHash = textHash toml
    verHash = textHash (checkNodeSchema ++ vunaVersion) + fp
  in pure
    (checkModsOf (contextPackageName ctx) "exe" (hashText manHash) (hashText srcHash) (depIdentitiesHash deps) (hashText verHash))

-- | 库包的 check 节点输入：全部模块根（不受入口闭包限制）+ 导出面 + 依赖身份 + manifest。
checkModsLib : PackageContext -> List String -> Eff hostRow CheckMods
checkModsLib ctx names = do
  rootSourcesAll <- concatMapEff rootSources (ownRootsOf ctx)
  deps <- depIdentitiesEff ctx
  toml <- raiseToRow hostRow (@vuna@prim_eff_readFile "${contextDir ctx}/vuna.toml")
  fp <- compilerFingerprint
  let
    srcHash = closureHashOf rootSourcesAll 0
    manHash = textHash toml
    namesHash = textHash (join "\t" names)
    verHash = textHash (checkNodeSchema ++ vunaVersion) + fp
  in pure
    (checkModsOf (contextPackageName ctx) "lib:${hashText namesHash}" (hashText manHash) (hashText srcHash) (depIdentitiesHash deps) (hashText verHash))

-- 依赖优先的 DFS 后序 + 按包名去重（与 Packages.Pkg.dependencyRoots 同规则）。
-- 记录字段访问（`p.packageDependencies`）不再被终止性判据识别为「结构投影」，
-- 非结构递归在 SCT 里没有下降参数；用 fuel 守卫（同 loader 的遍历惯例）。
collectDepPackages : List String -> List Package -> Pair (List String) (List Package)
collectDepPackages seen ps = collectDepPackagesFuel 4096 seen ps

collectDepPackagesFuel : Int -> List String -> List Package -> Pair (List String) (List Package)
collectDepPackagesFuel fuel seen [] = Pair seen []
collectDepPackagesFuel fuel seen (p :: rest) = if fuel <= 0 then Pair seen (Base.List.Cons p rest)
else if memName (packageName p) seen then collectDepPackagesFuel (fuel - 1) seen rest
else case collectDepPackagesFuel (fuel - 1) (packageName p :: seen) p.packageDependencies of
  Pair seen1 transitive => case collectDepPackagesFuel (fuel - 1) seen1 rest of
    Pair seen2 siblings => Pair seen2 (append transitive (p :: siblings))

sameNameSet : List String -> List String -> Bool
sameNameSet a b = length a == length b && allNamesIn a b && allNamesIn b a

allNamesIn : List String -> List String -> Bool
allNamesIn [] _ = True
allNamesIn (x :: rest) ys = memName x ys && allNamesIn rest ys

-- 依赖包接口哈希表：写本包接口时给 `miDepHashes` 用。
-- M34.5（S2）：依赖包**模块接口**加载（TTC 的 module 复用）。
--
-- 旧路径按包读 check 缓存里的 `CachedProgram`；S2 改为读每包的 `.vuna-iface`
-- 并逐项校验：schema/编译器指纹/包名 → 每个模块的源码哈希 → 依赖接口哈希链
-- （`miDepHashes`）→ 依赖包当前源码模块集合与接口模块集合一致。任一失败 ⇒ Nothing ⇒
-- 调用方回退全量（宁可慢，不静默用陈旧接口）。
depPackageList : PackageContext -> List Package
depPackageList ctx = case ctx.contextPackage of
  Nothing => []
  Just pkg => secondOf (collectDepPackages [] pkg.packageDependencies)

depPackageCount : PackageContext -> Int
depPackageCount ctx = length (depPackageList ctx)

-- ---------------------------------------------------------------
-- 输入寻址的 iface 层（终态）
--
-- 取代原来的「per-module 文件 + 包级 manifest + `miDepHashes` 链」：模块接口的**地址**
-- 由它的输入摘要决定 —— 源码摘要 + 包身份 + 包环境 + 直接依赖模块的地址（+ 隐式 Prelude）。
-- 落盘是 `objects/iface/<地址>`，「模块干净」因此退化为一次路径存在性检查；manifest、
-- 写锁、`meOrigin`、`pmEnv` 字段全部不再需要。
--
-- 依赖图从 **header 对象**得到（按源摘要寻址，热路径只读每个模块一个几百字节的对象），
-- 缺失时现 parse 一次并写回 —— 冷启动只付一次 parse，之后不再 parse 依赖包。
-- ---------------------------------------------------------------
ifaceObjectCodec : String
ifaceObjectCodec = "module-iface 3"

export record PkgEntry(..) where
  peName : String
  peDir : String
  peKey : String
  peEnv : String

export record ClosureMod(..) where
  cmPkg : String
  cmPkgKey : String
  cmPkgEnv : String
  cmName : String
  cmPath : String
  cmSrc : String
  cmImports : List String
  cmAddr : String

-- 包身份：**只要包名**。vuna 的依赖解析是「按名字在闭包里唯一」（同名不同目录会被 loader
-- 拒绝），所以名字就是身份；目录不进 key 反而是必要的——同一个包在不同入口写法、不同 cwd、
-- 作为依赖被引用时，路径字符串会不同（相对/绝对/`.` 分量），把目录算进身份会让
-- 「自己 check」与「被别人当依赖」算出两套地址，接口永远互相看不见（实测 56 个模块的
-- header 全部重复）。
pkgKeyOf : String -> String
pkgKeyOf name = addrOf ["pkg", name]

pkgTableEff : PackageContext -> Eff hostRow (List PkgEntry)
pkgTableEff ctx = do
  ownEnv <- packageEnvHash ctx
  let
    own =
      PkgEntry (contextPackageName ctx) (contextDir ctx) (pkgKeyOf (contextPackageName ctx))
        (strFromInt ownEnv)
  in do
    deps <- mapEff (\p => do
      e <- packageEnvHash (packageContext p)
      pure (PkgEntry (packageName p) (packageDir p) (pkgKeyOf (packageName p)) (strFromInt e))
    ) (depPackageList ctx)
    pure (own :: deps)

findPkgEntry : String -> List PkgEntry -> Maybe PkgEntry
findPkgEntry _ [] = Nothing
findPkgEntry n (e :: rest) = if e.peName == n then Just e else findPkgEntry n rest

findClosureMod : String -> List ClosureMod -> Maybe ClosureMod
findClosureMod _ [] = Nothing
findClosureMod n (m :: rest) = if m.cmName == n then Just m else findClosureMod n rest

closureModsEff : PackageContext -> List PkgEntry -> Eff hostRow (List ClosureMod)
closureModsEff ctx pkgs = do
  per <- mapEff (\r => case findPkgEntry (rootName r) pkgs of
    Nothing => pure []
    Just pe => do
      paths <- collectVunaMeta 1048576 (rootDir r)
      mapEff (\p => do
        raw <- raiseToRow hostRow (@vuna@prim_eff_readFile p)
        pure
          (ClosureMod pe.peName pe.peKey pe.peEnv (moduleNameOfPath (rootDir r) p) p (contentAddress raw) [] "")
      ) paths
  ) (contextRoots ctx)
  pure (concatMap (\xs => xs) per)

-- header 地址：包身份 + 模块名 + 源摘要（同一份源在不同包里是不同模块）。
headerAddrOfMod : ClosureMod -> String
headerAddrOfMod m = headerAddrOf m.cmPkgKey m.cmName m.cmSrc

-- 尾接隐式 Prelude（作为**普通图边**）：不这样做的话，Prelude 会作为「每个模块的额外依赖」
-- 后置在地址里，而它在拓扑序里没有前驱 ⇒ 早于 Prelude 的模块算地址时它还没分配，
-- 退化成 `ext:Prelude` 哨兵。哨兵/真实地址混用会让地址依赖遍历顺序（跨上下文不稳定，
-- 实测 `check compiler` 与 `check .` 算出两套地址）。写进 header 后它就是正常边。
loadHeaderEff : Bool -> ClosureMod -> Eff hostRow ClosureMod
loadHeaderEff hasPrelude m = do
  cached <- readHeaderEff (headerAddrOfMod m)
  case cached of
    Just h =>
      pure
        (ClosureMod m.cmPkg m.cmPkgKey m.cmPkgEnv m.cmName m.cmPath m.cmSrc (withPrelude hasPrelude m h) "")
    Nothing => do
      raw <- raiseToRow hostRow (@vuna@prim_eff_readFile m.cmPath)
      parsed <- parseFileWithPath m.cmPath raw
      case parsed of
        ErrC _ => pure m
        OkC sf => do
          let
            h = headerOfSource m.cmName sf
            imports = withPrelude hasPrelude m h
            h2 = ModHeader h.mhName imports h.mhFixities
          in do
            _ <- writeHeaderEff (headerAddrOfMod m) h2
            pure (ClosureMod m.cmPkg m.cmPkgKey m.cmPkgEnv m.cmName m.cmPath m.cmSrc imports "")

withPrelude : Bool -> ClosureMod -> ModHeader -> List String
withPrelude hasPrelude m h =
  if hasPrelude && m.cmName /= "Prelude" && not (memName "Prelude" h.mhImports) then append h.mhImports ["Prelude"]
  else h.mhImports

modGraphEntry : ClosureMod -> Pair String (List String)
modGraphEntry m = Pair m.cmName m.cmImports

modNameOf : ClosureMod -> String
modNameOf m = m.cmName

isDepModOf : PackageContext -> ClosureMod -> Bool
isDepModOf ctx m = m.cmPkg /= contextPackageName ctx

isSelfModOf : PackageContext -> ClosureMod -> Bool
isSelfModOf ctx m = m.cmPkg == contextPackageName ctx

moduleGraphOf : List ClosureMod -> List (Pair String (List String))
moduleGraphOf mods = map modGraphEntry mods

-- 依赖地址：已分配的查表，未分配的用哨兵（外部名字；真实包图里不会出现）。
depAddrOf : List (Pair String String) -> String -> String
depAddrOf assign name = case lookupPair name assign of
  Just a => a
  Nothing => "ext:${name}"

-- 地址解析：**按模块名排序**逐个赋值，未赋值的依赖取 `ext:<name>`。
--
-- 为什么不是拓扑序：compiler 包的 import 图**有环**（如 `Vuna.Compiler.Canonical` 与它的
-- 子模块互相 import），环里永远没有「依赖都已赋值」的成员；而拓扑 DFS 的遍历顺序依赖
-- 图规模，导致同一模块在 `check base` 与 `check .` 下算出不同地址（跨包接口永不命中）。
-- 改按全局字典序赋值后，结果只由「模块名集合 + 各自的边」决定，与图规模/遍历顺序无关。
-- 环内被 `ext:` 挡住的那条边是已知近似（后续用 SCC 收缩成单一摘要替换）。
ifaceAddrIn : List (Pair String String) -> ClosureMod -> String
ifaceAddrIn assign m =
  addrOf
    (append ["iface", ifaceObjectCodec, m.cmPkgKey, m.cmName, m.cmSrc, m.cmPkgEnv] (map (depAddrOf assign) m.cmImports))

addrOfModIn : List (Pair String String) -> ClosureMod -> String
addrOfModIn assign m = case lookupPair m.cmName assign of
  Just a => a
  Nothing => "ext:${m.cmName}"

withAddr : List (Pair String String) -> ClosureMod -> ClosureMod
withAddr assign m =
  ClosureMod m.cmPkg m.cmPkgKey m.cmPkgEnv m.cmName m.cmPath m.cmSrc m.cmImports
    (addrOfModIn assign m)

sortNames : List String -> List String
sortNames [] = []
sortNames (x :: rest) = insertName x (sortNames rest)

insertName : String -> List String -> List String
insertName x [] = [x]
insertName x (y :: rest) = if x <= y then x :: y :: rest else y :: insertName x rest

assignGo : List String -> List ClosureMod -> List (Pair String String) -> List ClosureMod -> List ClosureMod
assignGo _ mods _ _ =
  let
    -- 关键：地址表**只算一次**。写成 `map (withAddr (assignOrdered …)) mods` 时，实参在
    -- 每个元素上都要重新求值（本语言没有共享 thunk）⇒ 145 个模块 × 一次完整 assign ≈ 1.4s，
    -- 而 `ifaceModsEff` 一次 check 要跑 6 次以上（实测冷 `check compiler` 里占 ~8s）。
    assign = assignOrdered (sortNames (map modNameOf mods)) mods []
  in map (withAddr assign) mods

assignOrdered : List String -> List ClosureMod -> List (Pair String String) -> List (Pair String String)
assignOrdered [] _ assign = assign
assignOrdered (n :: rest) mods assign = case findClosureMod n mods of
  Nothing => assignOrdered rest mods assign
  Just m =>
    let
      a = ifaceAddrIn assign m
    in assignOrdered rest mods (Pair n a :: assign)

-- | 整个依赖闭包的模块 + 各自接口地址（依赖在前，本包在后）。
export ifaceModsEff : PackageContext -> Eff hostRow (List ClosureMod)
ifaceModsEff ctx = do
  pkgs <- pkgTableEff ctx
  ifaceModsWithEff ctx pkgs

ifaceModsWithEff : PackageContext -> List PkgEntry -> Eff hostRow (List ClosureMod)
ifaceModsWithEff ctx pkgs = do
  ta <- raiseToRow hostRow effTimeUs
  mods0 <- closureModsEff ctx pkgs
  tb <- raiseToRow hostRow effTimeUs
  let
    hasPrelude = memName "Prelude" (map modNameOf mods0)
  in do
    mods <- mapEff (loadHeaderEff hasPrelude) mods0
    tc <- raiseToRow hostRow effTimeUs
    -- 地址表是**判定**：同样的闭包（包身份 / 模块名 / 源摘要 / 包环境 / import 名）
    -- 一定算出同样的地址表，所以按闭包摘要存一个极小对象（145 个模块 ≈ 8 KB）。
    -- 这一步原本每次 check 都要重算 6 次以上，而 `addrOf` 走的是纯 vuna SHA-256：
    -- 实测单次 assign ≈ 1.35 s，占冷 `check compiler`（28 s）的 ~8 s。
    let
      key = modsKeyOf mods
    in do
      cached <- storeObjectReadEff modsKind modsCodec key
      case cached of
        Just bytes => case decMods bytes of
          Just table => do
            td <- raiseToRow hostRow effTimeUs
            _ <-
              pure
                (dbg! "iface-mods-phases n=${strFromInt (length mods)} closure=${strFromInt ((tb - ta) / 1000)}ms headers=${strFromInt ((tc - tb) / 1000)}ms assign=cached total=${strFromInt ((td - ta) / 1000)}ms")
            pure (addrsVia table mods)
          Nothing => assignAndWriteMods key mods ta tb tc
        Nothing => assignAndWriteMods key mods ta tb tc

-- | 地址表对象：`objects/mods/<闭包摘要>`。
modsKind : String
modsKind = "mods"

modsCodec : String
modsCodec = "mods-order 1"

modKeyOf : ClosureMod -> String
modKeyOf m = "${m.cmPkgKey}|${m.cmName}|${m.cmSrc}|${m.cmPkgEnv}|${join "," m.cmImports}"

modsKeyOf : List ClosureMod -> String
modsKeyOf mods = addrOf ("mods" :: modsCodec :: map modKeyOf mods)

encMods : List (Pair String String) -> String
encMods ps = encTop (encList (encPair encStr encStr)) ps

decMods : String -> Maybe (List (Pair String String))
decMods bytes = case decList (decPair decStr decStr) 65536 (curOf bytes) of
  Nothing => Nothing
  Just p => if curAtEnd (secondOf p) then Just (firstOf p) else Nothing

addrsVia : List (Pair String String) -> List ClosureMod -> List ClosureMod
addrsVia table mods = map (withAddr table) mods

assignAndWriteMods : String -> List ClosureMod -> Int -> Int -> Int -> Eff hostRow (List ClosureMod)
assignAndWriteMods key mods ta tb tc = do
  let
    table = assignOrdered (sortNames (map modNameOf mods)) mods []
  in do
    _ <- storeObjectWriteEff modsKind modsCodec key (encMods table)
    td <- raiseToRow hostRow effTimeUs
    _ <-
      pure
        (dbg! "iface-mods-phases n=${strFromInt (length mods)} closure=${strFromInt ((tb - ta) / 1000)}ms headers=${strFromInt ((tc - tb) / 1000)}ms assign=${strFromInt ((td - tc) / 1000)}ms")
    pure (addrsVia table mods)

-- | 只有 roots、没有包记录的上下文（单文件夹具 / base-only 会话）：按 root 名建表。
-- env 与 `packageEnvHash` 在「无依赖」时同口径（`<toml 内容哈希>|<tag>|`）。
rootEnvHashOf : String -> Eff hostRow Int
rootEnvHashOf dir = do
  tomlPath <- pure "${dir}/vuna.toml"
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists tomlPath)
  toml <- if exists then @vuna@prim_eff_readFile tomlPath else pure ""
  tag <- ifaceCompilerTag
  pure (textHash "${textHash toml}|${tag}|")

rootPkgTableEff : PackageContext -> Eff hostRow (List PkgEntry)
rootPkgTableEff ctx = mapEff (\r => do
  env <- rootEnvHashOf (rootDir r)
  pure (PkgEntry (rootName r) (rootDir r) (pkgKeyOf (rootName r)) (strFromInt env))
) (contextRoots ctx)

-- | 某上下文的整个模块闭包接口（工具 / 单文件 / 测试会话用）。
export ifacesForContextEff : PackageContext -> Eff hostRow (Maybe (List ModuleIface))
ifacesForContextEff ctx = do
  mods <- ifaceModsEff ctx
  readIfaceListEff mods

-- | 同上，但上下文只有 roots（无包记录）：按 root 名建身份表。
export ifacesForRootsEff : PackageContext -> Eff hostRow (Maybe (List ModuleIface))
ifacesForRootsEff ctx = do
  pkgs <- rootPkgTableEff ctx
  mods <- ifaceModsWithEff ctx pkgs
  readIfaceListEff mods

-- | 按地址读一个模块接口（载荷自证：解码失败即 `Nothing`）。
export readIfaceAtEff : String -> Eff hostRow (Maybe ModuleIface)
readIfaceAtEff a = do
  payload <- storeObjectReadEff "iface" ifaceObjectCodec a
  pure (case payload of
    Nothing => Nothing
    Just bytes => decModuleIfaceComplete bytes
  )

readIfaceListEff : List ClosureMod -> Eff hostRow (Maybe (List ModuleIface))
readIfaceListEff [] = pure (Just [])
readIfaceListEff (m :: rest) = do
  mi <- readIfaceAtEff m.cmAddr
  case mi of
    Nothing => do
      let
        _ = dbg! "iface-miss ${m.cmName} ${m.cmAddr} pkg=${m.cmPkg} src=${m.cmSrc}"
      in do
        pure Nothing
    Just x => do
      xs <- readIfaceListEff rest
      pure (case xs of
        Nothing => Nothing
        Just ys => Just (x :: ys)
      )

depModsOf : PackageContext -> List ClosureMod -> List ClosureMod
depModsOf ctx mods = filter (isDepModOf ctx) mods

selfModsOf : PackageContext -> List ClosureMod -> List ClosureMod
selfModsOf ctx mods = filter (isSelfModOf ctx) mods

depIfacesOf : PackageContext -> Eff hostRow (Maybe (List ModuleIface))
depIfacesOf ctx = case ctx.contextPackage of
  Nothing => pure Nothing
  Just _ => do
    mods <- ifaceModsEff ctx
    ordered <- depModsByOrderEff ctx mods
    case ordered of
      Nothing => do
        let
          _ = dbg! "iface-reject=module-order"
        in do
          pure Nothing
      Just depMods => readIfaceListEff depMods

-- ---------------------------------------------------------------
-- 模块顺序对象
--
-- 下游 codegen 的 split 串接要求模块顺序与**精化顺序**一致（否则 `canonicalTopo` 报
-- "split dependency is not in topological order"）。对象库只按输入摘要寻址、没有顺序；
-- 用依赖图重新拓扑排序也不行——base/compiler 的 import 图**有环**，环内顺序任意。
-- 所以写侧把「这次写全的模块名顺序」单独存一个极小对象，读侧照它排列；缺失 ⇒ 回退全量。
-- ---------------------------------------------------------------
orderKind : String
orderKind = "order"

orderCodec : String
orderCodec = "module-order 1"

encOrderNames : List String -> String
encOrderNames names = encTop (encList encStr) names

decOrderNamesComplete : String -> Maybe (List String)
decOrderNamesComplete s = case decList decStr (strLength s) (curOf s) of
  Nothing => Nothing
  Just (Pair names rest) => if curAtEnd rest then Just names else Nothing

-- | 写某包的模块顺序（完整模块面写全后调用）。
writeOrderEff : String -> List String -> Eff hostRow Int
writeOrderEff pkgKey names =
  storeObjectWriteEff orderKind orderCodec (addrOf ["order", pkgKey]) (encOrderNames names)

-- | 读某包的模块顺序；缺失/损坏 ⇒ Nothing（调用方回退全量，宁可慢，不产错序）。
readOrderEff : String -> Eff hostRow (Maybe (List String))
readOrderEff pkgKey = do
  payload <- storeObjectReadEff orderKind orderCodec (addrOf ["order", pkgKey])
  pure (case payload of
    Nothing => Nothing
    Just bytes => decOrderNamesComplete bytes
  )

-- | 已写的模块顺序是否覆盖这些导出模块（覆盖 ⇒ 入口那遍已写全 iface，无需再补 lib check）。
orderCoversEff : String -> List String -> Eff hostRow Bool
orderCoversEff pkg names = do
  ord <- readOrderEff (pkgKeyOf pkg)
  pure (case ord of
    Just written => allNamesIn names written
    Nothing => False
  )

pickByOrder : List ClosureMod -> List String -> List ClosureMod
pickByOrder _ [] = []
pickByOrder mods (n :: rest) = case findClosureMod n mods of
  Just m => m :: pickByOrder mods rest
  Nothing => pickByOrder mods rest

pkgEq : String -> ClosureMod -> Bool
pkgEq p m = m.cmPkg == p

distinctPkgs : List ClosureMod -> List String -> List String
distinctPkgs [] acc = reverse acc
distinctPkgs (m :: rest) acc =
  if memName m.cmPkg acc then distinctPkgs rest acc else distinctPkgs rest (m.cmPkg :: acc)

goPkgs : List ClosureMod -> List String -> List ClosureMod -> Eff hostRow (Maybe (List ClosureMod))
goPkgs _ [] acc = pure (Just acc)
goPkgs mods (p :: rest) acc = do
  ord <- readOrderEff (pkgKeyOf p)
  case ord of
    Nothing => pure Nothing
    Just names =>
      let
        picked = pickByOrder mods names
        expect = length (filter (pkgEq p) mods)
      in if length picked == expect then goPkgs mods rest (append acc picked) else pure Nothing

-- | 依赖模块接口按**写侧模块顺序**排列；任一步不可得 ⇒ Nothing。
depModsByOrderEff : PackageContext -> List ClosureMod -> Eff hostRow (Maybe (List ClosureMod))
depModsByOrderEff ctx mods = goPkgs mods (distinctPkgs (depModsOf ctx mods) []) []

-- 依赖模块接口按**拓扑序**（依赖在前）返回：下游 `Dt`/split 期望模块串接顺序与 import
-- 依赖一致（否则 `canonicalTopo` 报 "split dependency is not in topological order"）。
-- 旧实现直接读各包 manifest，manifest 本身按拓扑序写；对象库没有顺序，这里显式排序。
pickDepMods : PackageContext -> List ClosureMod -> List String -> List String -> List ClosureMod
pickDepMods _ _ [] _ = []
pickDepMods ctx mods (n :: rest) seen = if memName n seen then pickDepMods ctx mods rest seen
else case findClosureMod n mods of
  Just m =>
    if m.cmPkg /= contextPackageName ctx then m :: pickDepMods ctx mods rest (n :: seen)
    else pickDepMods ctx mods rest (n :: seen)
  Nothing => pickDepMods ctx mods rest seen

depModsOrdered : PackageContext -> List ClosureMod -> List ClosureMod
depModsOrdered ctx mods = pickDepMods ctx mods (topoModules (moduleGraphOf mods)) []

-- 来源校验：接口记录的每个模块源信息 = 当前文件（默认内容哈希；`VUNA_CACHE_MTIME=1` 时
-- mtime+size 相同且落在安全窗外即视为未变，否则回落内容哈希）。反过来当前目录里的模块
-- 判据：接口记录的每个模块，其源文件必须仍然存在且内容未变。
-- **不做**「磁盘模块集合 == 接口模块集合」的相等比较：可执行包的接口只覆盖入口
-- import 闭包，磁盘上允许存在未被引用的模块（它们不参与编译，也不该进接口；
-- §64 起基础设施模块已入口导入，但工具包 / 本地夹具仍可能带未引用模块）。
-- 集合变化由其它判据覆盖：新增并 import 的模块会改使用者源码哈希、`[export]` 变化会改
-- `pmEnv`、删除文件会让下面的 entry 查找直接失败。
depIfaceSourcesValid : List Root -> Package -> PackageIface -> Eff hostRow Bool
depIfaceSourcesValid roots p pi = do
  let
    pkgRoots = filter (\r => rootName r == packageName p) roots
  in do
    walked <- sourcePathMapOfRoots pkgRoots
    allModuleSourcesValid pi.piModules walked

sourcePathMapOfRoots : List Root -> Eff hostRow (List (Pair String String))
sourcePathMapOfRoots roots = do
  walked <- mapEff (\r => do
    paths <- collectVunaMeta 1048576 (rootDir r)
    pure (map (\path => Pair (moduleNameOfPath (rootDir r) path) path) paths)
  ) roots
  pure (concatMap (\xs => xs) walked)

allModuleSourcesValid : List ModuleIface -> List (Pair String String) -> Eff hostRow Bool
allModuleSourcesValid [] _ = pure True
allModuleSourcesValid (m :: rest) paths = case lookupPair (miNameOf m) paths of
  Just path => do
    unchanged <- sourceInfoUnchanged path (miSourceOf m)
    if unchanged then allModuleSourcesValid rest paths else pure False
  Nothing => pure False

-- mtime 秒精度的安全窗：`@vuna@prim_eff_fileMtime` 只有秒级分辨率，同秒内改内容且大小不变的编辑
-- 用 mtime+size 不可分辨。mtime 距当前不足该窗口的文件一律回落内容哈希（近期编辑不走
-- 快路径）；窗口外可安全信任 mtime+size（写侧记录的是当时的内容哈希，记录后至少过了
-- 窗口才可能被信任）。窗口同样用于工具链会话的 `sourceFresh`。
mtimeSafetyWindowSec : Int
mtimeSafetyWindowSec = 5

sourceInfoUnchanged : String -> SourceInfo -> Eff hostRow Bool
sourceInfoUnchanged path si = do
  fast <- mtimeFastPath
  if fast then do
    m <- raiseToRow hostRow (@vuna@prim_eff_fileMtime path)
    sz <- raiseToRow hostRow (@vuna@prim_eff_fileSize path)
    if m == siMtimeOf si && sz == siSizeOf si then do
      now <- toolNowSec
      if m + mtimeSafetyWindowSec < now then pure True
      else do
        content <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
        pure (payloadDigest content == siHashOf si)
    else do
      content <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
      pure (payloadDigest content == siHashOf si)
  else do
    content <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
    pure (payloadDigest content == siHashOf si)

-- 可选快路径（默认关闭；`VUNA_CACHE_MTIME=1` 打开）：mtime + size 相同且 mtime 落在安全窗
-- 外即跳过读文件算哈希。实测缓存命中路径收益 <1%（check/build 的缓存 key 本来就要读全部
-- 源文件算哈希），未达默认开启门槛（5%），见 docs/reference/cache.md。
-- 快路径默认关闭 ⇒ 正确性默认由内容哈希保证；打开后靠 mtimeSafetyWindowSec 兜住同秒编辑。
mtimeFastPath : Eff hostRow Bool
mtimeFastPath = do
  v <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_CACHE_MTIME")
  pure (v == "1")

-- M34.5（LSP/REPL）：把「本包依赖闭包的模块接口」暴露给工具链（不暴露内部实现）。
-- 无包上下文/依赖接口不全时返回 Nothing，调用方退回不带 ifaces 的旧路径。
export depIfacesForCheck : PackageContext -> Eff hostRow (Maybe (List ModuleIface))
depIfacesForCheck ctx = depIfacesOf ctx

-- 工具链消费默认走接口：M34.6 起默认开启（`VUNA_IFACE_TOOL=0` 关闭做 A/B/排障）。
-- 一次性读全依赖闭包接口只用于旧调试入口；LSP/REPL 走下面的惰性闭包。
-- M34.5（S7）：工具链**按需**读依赖接口。
importNameStr : Import -> String
importNameStr (Import n alias q sp) = n

toolImportsOfSource : PackageContext -> String -> String -> Eff hostRow (List String)
toolImportsOfSource ctx label source = do
  parsed <- parseFileWithPath label source
  case parsed of
    ErrC _ => pure []
    OkC (SourceFile hdr imports fixities decls _ _ _) => case hdr of
      Just (ModDecl dname _ _ _ _ _ _) => toolImportNamesOf ctx dname imports
      Nothing => toolImportNamesOf ctx "" imports

toolImportNamesOf : PackageContext -> String -> List Import -> Eff hostRow (List String)
toolImportNamesOf ctx current imports = do
  implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) current imports
  pure (case implicitR of
    ErrC _ => map importNameStr imports
    OkC implicit => map importNameStr (append imports implicit)
  )

-- 工具链消费：默认按源码 import 闭包按需读依赖接口；`VUNA_IFACE_TOOL=0` 关闭（排障/A-B）。
-- M34.6：闭包必须含**同包模块的 import**——entry 直接 import 的模块可能再由同包模块
-- import 别的依赖包模块；只沿 entry imports 展开会漏掉这些依赖模块（Loader 从源码加载
-- 它们却没有 artifact 注入 ⇒ 假 `TC_UnknownName`）。同包模块名/import 从本包 manifest 取
-- （`check`/`build` 会写）；没有本包 manifest 或闭包仍不完整时，`Dt` 侧安全阀回退全量。
toolEnabled : Eff hostRow Bool
toolEnabled = do
  v <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_IFACE_TOOL")
  pure (v /= "0")

importClosureGo : Int -> List ClosureMod -> List String -> List String -> List String
importClosureGo fuel _ [] acc = acc
importClosureGo fuel mods (n :: rest) acc = if fuel <= 0 then acc
else if memName n acc then importClosureGo (fuel - 1) mods rest acc
else case findClosureMod n mods of
  Nothing => importClosureGo (fuel - 1) mods rest (n :: acc)
  Just m => importClosureGo (fuel - 1) mods (append m.cmImports rest) (n :: acc)

-- 从起点名单沿 header 的 import 边做传递闭包（不读模块文件；header 已在内存）。
-- fuel 守卫：header 图理论上无环（loader 拒绝环），这里只防脏数据。
importClosureOf : List ClosureMod -> List String -> List String
importClosureOf mods starts = importClosureGo 8192 mods starts []

isNeededMod : List String -> ClosureMod -> Bool
isNeededMod needed m = memName m.cmName needed

-- 闭包里的**依赖包**模块（同包模块由工具链从源码加载，不需要接口）。
toolDepModsOf : PackageContext -> List ClosureMod -> List String -> List ClosureMod
toolDepModsOf ctx mods needed = filter (isNeededMod needed) (depModsOf ctx mods)

export depIfacesForToolSource : PackageContext -> String -> String -> Eff hostRow (Maybe (List ModuleIface))
depIfacesForToolSource ctx label source = do
  enabled <- toolEnabled
  if enabled then do
    mods <- ifaceModsEff ctx
    starts <- toolImportsOfSource ctx label source
    let
      needed = importClosureOf mods starts
      depMods = toolDepModsOf ctx mods needed
      _ = dbg! "tool-closure modules=${length depMods}"
    in do
      readIfaceListEff depMods
  else pure Nothing

-- REPL：program 是「imports + 定义」的源码，闭包同样从它的 import 算。
export depIfacesForToolProgram : PackageContext -> String -> Eff hostRow (Maybe (List ModuleIface))
depIfacesForToolProgram ctx program = depIfacesForToolSource ctx "<repl>" program

export depIfacesForTool : PackageContext -> Eff hostRow (Maybe (List ModuleIface))
depIfacesForTool ctx = do
  enabled <- toolEnabled
  if enabled then depIfacesOf ctx else pure Nothing

-- M44：base-only 上下文（无 manifest 的单文件夹具）的依赖接口 = base 包的模块接口。
-- `depIfacesOf` 需要 `ctx.contextPackage`（有 manifest 才有），单文件夹具拿不到；
-- 这里直接读 roots 里 base 包的接口，供会话化工具（test runner 等）注入。
-- 接口缺失 / schema / 编译器 tag 不符 ⇒ Nothing（调用方回退全量精化）。
export baseDepIfacesOf : PackageContext -> Eff hostRow (Maybe (List ModuleIface))
baseDepIfacesOf ctx = case ctx.contextPackage of
  Just _ => pure Nothing
  Nothing => ifacesForRootsEff ctx

-- ---------------------------------------------------------------
-- M34.6（5a/5c）：工具链（LSP / REPL）会话上下文
--
-- 一次工具请求需要的「依赖包接口 + 依赖接口哈希表 + 本包 manifest + 本次 buffer 的 import
-- 闭包 + 校验面」。全部由 manifest（小文件）算出来，模块接口按闭包惰性读；会话层把它按
-- 「编译器指纹 + 包名 + manifest 内容 + 闭包源文件 stat」缓存，失效时重建。
-- ---------------------------------------------------------------
-- `tcDepIfaces`：import 闭包里需要的依赖包模块接口（惰性读取的子集）；
-- `tcDepHashes`：依赖闭包**全部**模块的接口哈希（来自 manifest，不读模块文件；写本包接口
-- 时填 `miDepHashes` 用）；
-- `tcOwnManifest`：本包 manifest（干净同包模块 / 单模块写回的合并基）；
-- `tcNeeded`：本次 buffer 的 import 闭包（含本包模块名）——buffer 引入新依赖时据此失效；
-- `tcStats`：校验面（依赖/本包模块源文件 + manifest 文件的 (路径, 内容哈希, mtime, size)）；
-- `tcDepTable`：依赖模块名 → (接口目录, manifest 条目)，buffer 改 import 时重算闭包用；
-- `tcOwnDir`：本包接口目录（建会话时在 Eff 上取好；`toolNeededOfImports` 仍是纯函数）。
export record ToolContext(..) where
  tcDepIfaces : List ModuleIface
  tcDepHashes : List (Pair String String)
  tcNeeded : List String
  -- 本包模块名集合。LSP 用它把闭包分成「本包模块」（可预置干净接口）与依赖模块；
  -- 旧实现从包级 manifest 取，manifest 删除后由会话建立时直接算好。
  tcOwnNames : List String
  tcStats : List SourceInfo

-- 内容哈希（与缓存 key / 接口源信息同一函数）：工具链侧比较 buffer 与磁盘内容用。
export toolTextHash : String -> String
toolTextHash = payloadDigest

export sourceInfoForPath : String -> Eff hostRow SourceInfo
sourceInfoForPath path = do
  raw <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
  mtime <- raiseToRow hostRow (@vuna@prim_eff_fileMtime path)
  size <- raiseToRow hostRow (@vuna@prim_eff_fileSize path)
  pure (SourceInfo path (payloadDigest raw) mtime size)

export toolNowSec : Eff hostRow Int
toolNowSec = do
  us <- effTimeUs
  pure (us / 1000000)

-- 校验：文件还在，且（mtime+size 快路径）或（内容哈希）与记录一致。
-- 安全窗与 `sourceInfoUnchanged` 同一个（`mtimeSafetyWindowSec`）：记录的 mtime 距会话建立
-- 不足窗口时，同秒内同大小编辑不可分辨 ⇒ 回读哈希。
sourceFresh : Int -> SourceInfo -> Eff hostRow Bool
sourceFresh builtSec si = do
  let
    path = siPathOf si
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
    if exists == False then pure False
    else do
      m <- raiseToRow hostRow (@vuna@prim_eff_fileMtime path)
      sz <- raiseToRow hostRow (@vuna@prim_eff_fileSize path)
      if m == siMtimeOf si && sz == siSizeOf si && siMtimeOf si + mtimeSafetyWindowSec <= builtSec then pure True
      else do
        content <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
        pure (payloadDigest content == siHashOf si)

export toolSessionFresh : Int -> List SourceInfo -> Eff hostRow Bool
toolSessionFresh builtSec [] = pure True
toolSessionFresh builtSec (si :: rest) = do
  fresh <- sourceFresh builtSec si
  if fresh then toolSessionFresh builtSec rest else pure False

-- import 名 → 闭包；buffer 每次变化都按当前 imports 重算。
export toolNeededOfImports : PackageContext -> ToolContext -> String -> List Import -> Eff hostRow (List String)
toolNeededOfImports ctx tool currentName imports = do
  mods <- ifaceModsEff ctx
  importNames <- toolImportNamesOf ctx currentName imports
  pure (importClosureOf mods importNames)

-- 惰性工具接口 + 会话上下文（M34.6 5a）：与 `depIfacesForToolSource` 同一套校验，
-- 额外返回依赖哈希表 / 本包 manifest / 闭包 / 校验面。
export depIfacesForToolSourceDetailed : PackageContext -> String -> String -> Eff hostRow (Maybe ToolContext)
depIfacesForToolSourceDetailed ctx label source = do
  enabled <- toolEnabled
  if enabled then do
    mods <- ifaceModsEff ctx
    starts <- toolImportsOfSource ctx label source
    let
      needed = importClosureOf mods starts
      depMods = toolDepModsOf ctx mods needed
      depHashes = map modHashPair depMods
      ownNames = map modNameOf (selfModsOf ctx mods)
    in do
      ifaces <- readIfaceListEff depMods
      case ifaces of
        Nothing => pure Nothing
        Just ifs => do
          stats <- mapEff statOfClosureMod depMods
          let
            _ = dbg! "tool-closure modules=${length ifs}"
          in pure (Just (ToolContext ifs depHashes needed ownNames stats))
  else pure Nothing

modHashPair : ClosureMod -> Pair String String
modHashPair m = Pair m.cmName m.cmAddr

statOfClosureMod : ClosureMod -> Eff hostRow SourceInfo
statOfClosureMod m = do
  mtime <- raiseToRow hostRow (@vuna@prim_eff_fileMtime m.cmPath)
  size <- raiseToRow hostRow (@vuna@prim_eff_fileSize m.cmPath)
  pure (SourceInfo m.cmPath m.cmSrc mtime size)

-- 本包干净模块（M34.6 5a/5c）：manifest 条目里「源内容未变 + 依赖哈希链仍成立」的模块。
-- 只读 `needed` 里的模块接口文件（闭包子集）；`exclude` 是当前正在编辑的模块名（buffer
-- 可能与磁盘不同，不能复用它的 iface）。
-- 本包干净模块：manifest 删除后直接按**对象地址**读本包模块接口，再做源内容 / 依赖链校验。
-- 只读 `needed` 里的模块（闭包子集）；`exclude` 是当前正在编辑的模块名（buffer 可能与
-- 磁盘不同，不能复用它的 iface）。
export toolCleanOwnModules : PackageContext -> ToolContext -> Int -> Maybe String -> List String -> Eff hostRow (List ModuleIface)
toolCleanOwnModules ctx tool builtSec exclude needed = do
  mods <- ifaceModsEff ctx
  let
    cands = filter (ownCleanWanted needed exclude) (selfModsOf ctx mods)
  in do
    ifs <- readIfaceListEff cands
    case ifs of
      Nothing => pure []
      Just clean => toolCleanGo builtSec tool.tcDepHashes clean []

ownCleanWanted : List String -> Maybe String -> ClosureMod -> Bool
ownCleanWanted needed exclude m = memName m.cmName needed && (case exclude of
  Just x => m.cmName /= x
  Nothing => True
)

toolCleanGo : Int -> List (Pair String String) -> List ModuleIface -> List ModuleIface -> Eff hostRow (List ModuleIface)
toolCleanGo builtSec depTbl [] cleanRev = pure (reverse cleanRev)
toolCleanGo builtSec depTbl (m :: rest) cleanRev = do
  selfOk <- payloadSelfOk m
  let
    _ = if selfOk then 0 else dbg! "iface-reject=self-hash ${miNameOf m}"
  in do
    fresh <- sourceFresh builtSec (miSourceOf m)
    if fresh && cachedProgramValid (miCachedOf m) && selfOk && not (hasMissingDep (miDepHashesOf m)) && moduleDepsOk depTbl cleanRev (miDepHashesOf m) then toolCleanGo builtSec depTbl rest (m :: cleanRev)
    else toolCleanGo builtSec depTbl rest cleanRev

-- 单模块接口写回（M34.6 5a）：LSP 每次成功请求后只写「当前模块」的接口（合并进本包
-- manifest，保留其他条目）。语义与整包 ifaceOfPackage 一致（见 `Iface.ifaceOfModule`）；
-- 有缺口/其他脏模块时返回 Err，调用方静默跳过（不影响诊断）。
export toolWriteModuleIface : PackageContext -> ToolContext -> List ModuleIface -> CheckedPackage -> String -> SourceInfo -> Eff hostRow (Check ModuleIface)
toolWriteModuleIface ctx tool clean checked name si = do
  let
    miResult =
      ifaceOfModule (contextPackageName ctx) si tool.tcDepHashes checked.checkedInherited clean
        checked.checkedModules checked.checkedEntryDecls checked.checkedProgram name
  in do
    case miResult of
      ErrC e => pure (ErrC e)
      OkC mi => do
        _ <- writeModuleIfaceGuarded ctx mi
        pure (OkC mi)

-- | 单模块写回的只读写降级：失败静默跳过（诊断/会话缓存不受影响）。
writeModuleIfaceGuarded : PackageContext -> ModuleIface -> Eff hostRow Int
writeModuleIfaceGuarded ctx mi = if contextPackageName ctx == "" then pure 0
else do
  mods <- ifaceModsEff ctx
  case findClosureMod (miNameOf mi) mods of
    Nothing => pure 0
    Just m => storeObjectWriteEff "iface" ifaceObjectCodec m.cmAddr (encModuleIface mi)

-- 冷启动（没有工具会话 / 本包还没有 manifest）：依赖哈希从磁盘接口汇总，干净模块按
-- 现有判定重算；能写就写（LSP-only 会话逐步变热），失败不影响诊断。
export toolWriteModuleIfaceCold : PackageContext -> CheckedPackage -> String -> SourceInfo -> Eff hostRow (Check ModuleIface)
toolWriteModuleIfaceCold ctx checked name si = do
  clean <- cleanIfacesOrEmpty ctx
  depTbl <- depIfaceHashTable ctx
  let
    miResult =
      ifaceOfModule (contextPackageName ctx) si depTbl checked.checkedInherited clean
        checked.checkedModules checked.checkedEntryDecls checked.checkedProgram name
  in do
    case miResult of
      ErrC e => pure (ErrC e)
      OkC mi => do
        _ <- writeModuleIfaceGuarded ctx mi
        pure (OkC mi)

-- LSP 写回守卫：本包 manifest 是否已存在（冷启动写回只在没有 manifest 时做，
-- 避免把「工具接口暂时不可用」的会话写进去污染依赖哈希链）。
export toolCompilerFingerprint : Eff hostRow Int
toolCompilerFingerprint = compilerFingerprint

-- | 包级 check 的判定入口：命中 = `objects/check/<checkIn>` 存在 → 未命中则跑精化，
-- 成功后写 marker 并把摘要登记进本项目 roots。
--
-- 命中时**完全跳过**精化；`-W` / `--deny-warnings`（warning 不持久化）、
-- `VUNA_ELAB_FULL=1`（强制全量）、`VUNA_IFACE_AUDIT=1`（双路径对拍）都直接绕过判定
-- （既不判命中也不提交），保持各自的既有语义。
-- 没有节点执行器，也就没有 span / 预算 / trace。
-- check marker 的 codec：空载荷（存在性即是全部信息）。
checkMarkerCodec : String
checkMarkerCodec = "check-marker 1"

-- 包级缓存判定的输入摘要（纯数据；key 由 `checkInOf` / `splitInOf` 换算成对象地址）。
--
-- `cmKind` = `exe`（可执行包入口）/ `lib:<namesHash>`（库包导出面）。`cmVer` 是
-- 「编译器版本 + 指纹」：换二进制即整套判定换代。
export record CheckMods(..) where
  cmPkg : String
  cmKind : String
  cmManifest : String
  cmSources : String
  cmDeps : String
  cmVer : String

-- | 拼 `CheckMods`（纯构造；摘要由调用方算好传入）。
checkModsOf : String -> String -> String -> String -> String -> String -> CheckMods
checkModsOf pkg kind manifest sources deps ver = CheckMods pkg kind manifest sources deps ver

-- 项目身份：**规范化绝对包目录**的摘要。roots 按项目分目录（`store/roots/<id>/`），
-- 项目只追加自己关心的摘要；GC 扫所有项目的并集，所以 A 不需要知道 B 的存在。
-- 公式在 `Addr.projectIdAddrOf`：`vuna fetch` 也要写同一个项目的 roots。
projectIdOf : PackageContext -> Eff hostRow String
projectIdOf ctx = do
  abs <- absolutePath (contextDir ctx)
  pure (projectIdAddrOf abs)

-- | 把摘要追加进本项目 roots（GC 的保留集合）。失败不影响正确性（删了只是重算）。
rootKeepEff : PackageContext -> List String -> Eff hostRow Int
rootKeepEff ctx digests = do
  pid <- projectIdOf ctx
  storeRootAppendEff pid digests

-- 包级 check 判定：**输入寻址对象的「存在性」**。
--
-- 判据就是 `checkInOf mods` 这个摘要：包名 + kind + manifest/源闭包/依赖闭包摘要 +
-- 编译器指纹。存在 ⇒ 判过（跳过精化）；不存在 ⇒ 精化后写一个 0 字节 marker 对象。
-- 没有查询图、没有会话索引、没有依赖快照比较：跨进程天然一致，坏字节由 framing 拒绝。
checkViaGraph : PackageContext -> CheckMods -> Eff hostRow (Check (List Diagnostic)) -> Eff hostRow (Check (List Diagnostic))
checkViaGraph ctx mods run = do
  full <- elabFullRequested
  audit <- ifaceAuditRequested
  if full || audit then run
  else do
    let
      dig = checkInOf mods
    in do
      cached <- storeObjectExistsEff "check" dig
      if cached then do
        let
          _ = dbg! "cache-path=hit"
        in do
          pure (OkC [])
      else do
        r <- run
        case r of
          ErrC e => pure (ErrC e)
          OkC ds => do
            _ <- storeObjectWriteEff "check" checkMarkerCodec dig ""
            _ <- rootKeepEff ctx [dig]
            let
              _ = dbg! "cache-path=miss"
            in do
              pure (OkC ds)

checkCachedExe : Bool -> PackageContext -> String -> Eff hostRow (Check (List Diagnostic))
checkCachedExe wantWarnings ctx entry = do
  mods <- checkModsExe ctx entry
  if wantWarnings then checkUncachedExe wantWarnings ctx entry
  else checkViaGraph ctx mods (checkUncachedExe wantWarnings ctx entry)

-- 缓存未命中时的精化入口：默认「依赖接口摘要齐全 ⇒ 摘要路径，否则全量」。
-- 摘要路径返回 `Err` 时**直接上报**（不回退——回退会吞掉本包真实错误）。
-- `VUNA_ELAB_FULL=1` 强制全量：排障/A-B 对拍用（测试里对两份诊断逐字节比较）。
checkUncachedExe : Bool -> PackageContext -> String -> Eff hostRow (Check (List Diagnostic))
checkUncachedExe wantWarnings ctx entry = do
  full <- elabFullRequested
  if full then fullCheckExe ctx entry
  else do
    audit <- ifaceAuditRequested
    if audit then auditCheckExe wantWarnings ctx entry
    else do
      summary <- summaryCheckExeParts wantWarnings ctx entry
      checkAndShadow ctx (pure summary)

-- 摘要路径（**不落盘**）：接口不可用 ⇒ 全量（与旧行为一致，只是不再直接写缓存）。
-- wantWarnings 时 clean 列表清空 ⇒ 本包模块全部重算（warning 不在缓存里）。
summaryCheckExeParts : Bool -> PackageContext -> String -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
summaryCheckExeParts wantWarnings ctx entry = do
  depIfaces <- depIfacesOf ctx
  case depIfaces of
    Nothing => do
      let
        _ = dbg! "cache-path=full"
      in do
        dtCheckWithProgramParts ctx entry
    Just ifaces => do
      depTbl <- depIfaceHashTable ctx
      clean <- ownCleanModules ctx depTbl
      case clean of
        Just clean2 => do
          let
            cleanReal = if wantWarnings then [] else clean2
            _ = dbg! "cache-path=summary deps=${depPackageCount ctx}"
            _ = dbg! "cache-own-clean=${length cleanReal}"
          in do
            dtCheckPackageIncrementalParts ctx entry ifaces cleanReal
        Nothing => do
          let
            _ = dbg! "cache-path=summary deps=${depPackageCount ctx}"
          in do
            dtCheckPackageWithIfacesParts ctx entry ifaces

fullCheckExe : PackageContext -> String -> Eff hostRow (Check (List Diagnostic))
fullCheckExe ctx entry =
  let
    _ = dbg! "cache-path=full"
  in checkAndShadow ctx (dtCheckWithProgramParts ctx entry)

-- 审计（`VUNA_IFACE_AUDIT=1`）：摘要路径 vs 全量路径的诊断逐字节对拍。一致才按摘要结果
-- 落盘；不一致报 `iface-audit-mismatch` 并**不写缓存/接口**。
auditCheckExe : Bool -> PackageContext -> String -> Eff hostRow (Check (List Diagnostic))
auditCheckExe wantWarnings ctx entry = do
  summary <- summaryCheckExeParts wantWarnings ctx entry
  full <- dtCheckWithProgramParts ctx entry
  let
    _ = dbg! "iface-audit subject=check entry=${entry}"
  in do
    compared <- pure (auditCompare "check" entry (checkSignatureOf summary) (checkSignatureOf full))
    case compared of
      ErrC e => pure (ErrC e)
      OkC _ => checkAndShadow ctx (pure summary)

-- `VUNA_ELAB_FULL=1`：强制全量精化（接口摘要路径的排障开关；默认关闭）。
elabFullRequested : Eff hostRow Bool
elabFullRequested = do
  v <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_ELAB_FULL")
  pure (v == "1")

-- `VUNA_IFACE_AUDIT=1`：排障/CI 开关——摘要路径与全量路径在同一进程各跑一次并逐字节比较
-- 诊断/产物；不一致即失败且不写缓存。默认关闭（双倍精化，不适合热路径）。
ifaceAuditRequested : Eff hostRow Bool
ifaceAuditRequested = do
  v <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_IFACE_AUDIT")
  pure (v == "1")

-- 诊断签名：`Ok`/`Err` 都参与比较（顺序敏感，逐字节）。
-- 直接按构造子在 clause 头分派（dispatch-lift），避免再嵌一层 case。
-- warning 不参与签名：摘要路径在 `wantWarnings=false` 时会复用干净模块（不重算 warning），
-- 全量路径会全算，二者在 warning 上不可比（warning 不进缓存，见 M45）。
checkSignatureOf : Check (Pair (List Diagnostic) CheckedPackage) -> String
checkSignatureOf (OkC _) = "ok\n"
checkSignatureOf (ErrC e) = "err\n${diagText e}"

splitSignatureOf : Check (Pair (List SplitFile) CheckedPackage) -> String
-- 审计签名：只用于「摘要路径与全量路径产物是否一致」的比较，不进缓存。
-- 用规范编码（C32：不再 `prim_marshal`）——同一 SplitFile 列表编码逐字节稳定。
splitSignatureOf (OkC p) = "ok\n" ++ encTop encSplitFiles (firstOf p)
splitSignatureOf (ErrC e) = "err\n${diagText e}"

joinLines : List String -> String
joinLines [] = ""
joinLines (x :: rest) = if rest == [] then x else "${x}\n${joinLines rest}"

-- 不一致时只报签名指纹与长度（诊断可能很长，整段回显会把终端淹掉）；
-- `subject`/`at` 给出入口与位置，便于定位。
auditCompare : String -> String -> String -> String -> Check Int
auditCompare subject at s f =
  if s == f then OkC 0
  else err
    "iface-audit-mismatch subject=${subject} at=${at} summary=${textHash s}/${strLength s} full=${textHash f}/${strLength f}"

-- 依赖模块的「名字 → 输入摘要」表：写本包接口时给 `miDepHashes` 用。
-- 对象库下依赖的标识就是它的接口地址（与 `depAddrOf` 的口径一致）。
depIfaceHashTable : PackageContext -> Eff hostRow (List (Pair String String))
depIfaceHashTable ctx = do
  mods <- ifaceModsEff ctx
  pure (map modHashPair (depModsOf ctx mods))

-- 包环境指纹（`peEnv`）：本包 manifest 内容 + 依赖**接口身份** + 编译器标签。
-- **不含目录**：目录字符串依赖入口写法（相对/绝对/`.` 分量），把它算进环境会让同一个包
-- 「自己 check」与「被别的包当依赖」得到两套 env、进而两套接口地址（实测跨包永不命中）。
-- 依赖接口身份来自 `depIdentitiesEff`（见 D69）：注释 / 诊断配置 / opaque 体变化不脏
-- 依赖方；接口或声明面变化会换 env。
packageEnvHash : PackageContext -> Eff hostRow Int
packageEnvHash ctx = do
  -- 没有包上下文的场景（base-only 单文件 / REPL）：`contextDir` 可能是空串，
  -- 直接 `readFile "/vuna.toml"` 会崩（实测 REPL `:load` 触发）。缺 manifest 就当空。
  let
    tomlPath = "${contextDir ctx}/vuna.toml"
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists tomlPath)
    toml <- if exists then @vuna@prim_eff_readFile tomlPath else pure ""
    deps <- depIdentitiesEff ctx
    tag <- ifaceCompilerTag
    pure (textHash "${textHash toml}|${tag}|${joinLines (map pairText deps)}")

-- ---------------------------------------------------------------
-- M34.5（S4）：包内逐模块增量的脏/净判定
--
-- 保守规则：模块干净 ⇔ 源内容哈希未变 ∧ 闭合产物有效 ∧ 它记录的直接依赖接口哈希全部
-- 仍然成立。依赖哈希来自：外部依赖包（当前接口表）或**同包已判定干净的模块**（旧接口
-- 哈希未变）。同包依赖若是脏模块或新模块，则本模块也判脏（接口哈希可能变），不做乐观
-- 复用；脏性沿 import 边自然传播（干净表里查不到 ⇒ 脏）。
-- ---------------------------------------------------------------
-- 与 `ownCleanModules` 同一次读取，同时回报「旧整包接口是否可完整读回」（写侧信任旧
-- manifest 做按模块跳过的前提）：check/build 的写前校验已经解码过整包接口，写回时复用
-- 这次结果，不再把同样的 65 个模块文件读 + unmarshal 第二遍。
readOneModIface : ClosureMod -> Eff hostRow (Pair ClosureMod (Maybe ModuleIface))
readOneModIface m = do
  mi <- readIfaceAtEff m.cmAddr
  pure (Pair m mi)

ownCleanInfo : PackageContext -> List (Pair String String) -> Eff hostRow (Pair Bool (Maybe (List ModuleIface)))
ownCleanInfo ctx _ = do
  mods <- ifaceModsEff ctx
  reads <- mapEff readOneModIface (selfModsOf ctx mods)
  let
    clean = collectClean reads
  in pure (Pair True (if length clean == 0 then Nothing else Just clean))

collectClean : List (Pair ClosureMod (Maybe ModuleIface)) -> List ModuleIface
collectClean [] = []
collectClean (p :: rest) = case secondOf p of
  Nothing => collectClean rest
  Just mi => mi :: collectClean rest

ownCleanModules : PackageContext -> List (Pair String String) -> Eff hostRow (Maybe (List ModuleIface))
ownCleanModules ctx depTbl = do
  info <- ownCleanInfo ctx depTbl
  pure (secondOf info)

-- 工具路径（LSP 冷启动写单模块接口）复用的干净模块：记录原样写回，避免用增量路径缺失的
-- 整包 sols 重算导致擦除位残 meta 的 zonk 结果漂移。命令行 check/build 走
-- writeIfaceShadow 的同一次 `ownCleanInfo` 读取，不经过这里。
cleanIfacesOrEmpty : PackageContext -> Eff hostRow (List ModuleIface)
cleanIfacesOrEmpty ctx = do
  depTbl <- depIfaceHashTable ctx
  clean <- ownCleanModules ctx depTbl
  pure (case clean of
    Just clean2 => clean2
    Nothing => []
  )

cleanModulesGo : List (Pair String String) -> List (Pair String SourceInfo) -> List (Pair String String) -> List ModuleIface -> List ModuleIface -> Eff hostRow (Pair (List ModuleIface) (List String))
cleanModulesGo origins sources depTbl [] cleanRev = pure (Pair (reverse cleanRev) [])
cleanModulesGo origins sources depTbl (m :: rest) cleanRev = do
  let
    pkgOrigin = case lookupPair (miNameOf m) origins of
      Just o => o == "pkg"
      Nothing => False
    _ = if pkgOrigin then 0 else dbg! "iface-reject=tool-origin ${miNameOf m}"
    sameSource = case lookupPair (miNameOf m) sources of
      Just si => siHashOf si == siHashOf (miSourceOf m)
      Nothing => False
  in do
    selfOk <- payloadSelfOk m
    let
      _ = if selfOk then 0 else dbg! "iface-reject=self-hash ${miNameOf m}"
      keep =
        pkgOrigin
          && sameSource
          && cachedProgramValid (miCachedOf m)
          && selfOk
          && not (hasMissingDep (miDepHashesOf m))
          && moduleDepsOk depTbl cleanRev (miDepHashesOf m)
    in do
      if keep then cleanModulesGo origins sources depTbl rest (m :: cleanRev)
      else cleanModulesGo origins sources depTbl rest cleanRev

-- 载荷自证（`VUNA_IFACE_SELFTEST=1`）：复用前用载荷重算哈希，与记录的 `miIfaceHash`
-- 比对。默认关闭——热路径只做 schema / 编译器指纹 / 环境指纹这些 O(1) 门；CI 打开
-- 后能抓住「载荷被改写但哈希字段没变」的接口。成本 O(payload)。
payloadSelfOk : ModuleIface -> Eff hostRow Bool
payloadSelfOk m = do
  self <- ifaceSelfTestRequested
  pure (if self then hashOfIface m == miIfaceHashOf m else True)

moduleDepsOk : List (Pair String String) -> List ModuleIface -> List (Pair String String) -> Bool
moduleDepsOk depTbl cleanRev [] = True
moduleDepsOk depTbl cleanRev ((Pair name h) :: rest) = if h == depMissingHash then moduleDepsOk depTbl cleanRev rest
else case lookupPair name depTbl of
  Just h2 => h2 == h && moduleDepsOk depTbl cleanRev rest
  Nothing => case cleanHashOf cleanRev name of
    Just h2 => h2 == h && moduleDepsOk depTbl cleanRev rest
    Nothing => False

cleanHashOf : List ModuleIface -> String -> Maybe String
cleanHashOf [] _ = Nothing
cleanHashOf (m :: rest) name =
  if miNameOf m == name then Just (miIfaceHashOf m) else cleanHashOf rest name

-- M34.5（S1/S2/S3）：接口摘要的**影子写**。整包 check / build 成功后按声明归属把 DtProgram
-- 切成每模块一份 `ModuleIface`，按地址写 `objects/iface/` + `objects/order/`（依赖侧的
-- 接口加载与失效判定读它）；写失败/归属缺口只打 note（不影响 check 结果），缺口存在时
-- **不写**（避免依赖方拿到不完整接口）。
ifaceSchemaTag : String
ifaceSchemaTag = ifaceSchema

ifaceCompilerTag : Eff hostRow String
ifaceCompilerTag = compilerTagEff

-- | iface 目录：默认与源码同布局（`<包目录>/lib/.../X.vuna` → 同目录 `X.iface`）；
-- `VUNA_IFACE_DIR` 非空时整体镜像到该根（`<根>/<包绝对目录>/lib/.../X.iface`），便于
-- 持久化/共享。相对值按进程 cwd 解析（启动时读取一次）。
ownSourceInfos : PackageContext -> Eff hostRow (List (Pair String SourceInfo))
ownSourceInfos ctx = do
  walked <- mapEff (\root => do
    paths <- collectVunaMeta 1048576 (rootDir root)
    mapEff (\p => do
      abs <- absolutePath p
      raw <- raiseToRow hostRow (@vuna@prim_eff_readFile abs)
      mtime <- raiseToRow hostRow (@vuna@prim_eff_fileMtime abs)
      size <- raiseToRow hostRow (@vuna@prim_eff_fileSize abs)
      pure
        (Pair (moduleNameOfPath (rootDir root) p) (SourceInfo abs (payloadDigest raw) mtime size))
    ) paths
  ) (filter (\r => rootName r == contextPackageName ctx) (contextRoots ctx))
  pure (concatMap (\xs => xs) walked)

-- | 干净模块的 `miSource` 来自磁盘接口记录（可能是上一次以相对/绝对不同写法 check 时写入的
-- 路径）。复用时必须换成本次上下文的路径，否则相对/绝对入口交替会算出空路径而整包跳过写
-- （§57c 覆盖）。
resyncCleanSources : List (Pair String SourceInfo) -> List ModuleIface -> List ModuleIface
resyncCleanSources sources clean = map (\m => case lookupPair (miNameOf m) sources of
  Just si =>
    ModuleIface (miNameOf m) (miPackageOf m) si (miIfaceHashOf m) (miImplHashOf m) (miDepHashesOf m)
      (miImportsOf m) (miImplicitImportsOf m) (miExportsOf m) (miFixitiesOf m) (miDeclsOf m)
      (miRecordsOf m) (miPreparedOf m) (miCachedOf m) (miDefLocsOf m)
  Nothing => m
) clean

-- 只有「声明了导出模块的包」才写接口对象。
--
-- 入口-only 包（单文件夹具、`vuna compile <file>`）没有可复用的库模块面：给它们写接口
-- 会让同一份源码在后续阶段（check → compile）命中缓存而**跳过精化**，于是只在精化时
-- 产生的诊断（典型 `UN_UnusedImport`）静默消失。
shadowAllowed : PackageContext -> Bool
shadowAllowed ctx = case ctx.contextPackage of
  Nothing => False
  Just pkg => case packageExports pkg of
    Just _ => True
    Nothing => False

writeIfaceShadow : PackageContext -> CheckedPackage -> Eff hostRow (Check (List ModuleIface))
writeIfaceShadow ctx checked = if contextPackageName ctx == "" then pure (OkC [])
else if not (shadowAllowed ctx) then pure (OkC [])
else do
  let
    _ = dbg! "iface-shadow-start"
  in do
    -- 闭包只算一次：`depIfaceHashTable` 原本自己再跑一遍 `ifaceModsEff`（那是「读全部源文件
    -- + 算地址 + 取 header」的全量扫描），冷路径上等于把最贵的一步做了两遍。
    t0 <- raiseToRow hostRow effTimeUs
    mods <- ifaceModsEff ctx
    t1 <- raiseToRow hostRow effTimeUs
    sources <- ownSourceInfos ctx
    t2 <- raiseToRow hostRow effTimeUs
    let
      depTbl = map modHashPair (depModsOf ctx mods)
      own = selfModsOf ctx mods
    in do
      case ifaceOfPackage (contextPackageName ctx) sources depTbl checked.checkedInherited [] checked.checkedModules checked.checkedEntryDecls checked.checkedProgram of
        ErrC e => do
          let
            _ = dbg! "iface-reject=compute iface-skip ${diagText e}"
          in do
            pure (OkC [])
        OkC modules => do
          t3 <- raiseToRow hostRow effTimeUs
          let
            unwritten = missingNamesOf own (map miNameOf modules)
          in do
            -- **只写完整的模块面**：一次 check 若只覆盖包的一部分模块（典型是入口闭包，
            -- 而包同时导出库里还有模块），就不写接口 —— 否则同一个地址会先后被两份
            -- 不同精化上下文（入口 vs 库）的载荷覆盖，`miPrepared`/`miDecls` 随写入顺序漂移，
            -- 下游 codegen 对拍与实例可见性都会抖。
            -- 可执行包 + `[export] modules` 时由 `checkPackage` 补的那遍 lib check 写全。
            if length unwritten > 0 then do
              let
                _ =
                  dbg!
                    "iface-skip partial closure=${length own} covered=${length modules} missing=${join "," unwritten}"
              in do
                pure (OkC [])
            else do
              -- 先写「模块顺序」再写接口对象：读侧只有两份都在时才用接口路径。
              _ <- writeOrderEff (pkgKeyOf (contextPackageName ctx)) (map miNameOf modules)
              n <- writeIfaceObjects own modules
              -- 依赖身份摘要（D69）：依赖方按 lib 根源闭包摘要 + 编译器 tag 读。
              _ <- writePkgIfaceSummaryEff ctx modules
              t4 <- raiseToRow hostRow effTimeUs
              let
                _ =
                  dbg!
                    "iface-write=${n}/${length modules} closure=${length own} phases mods=${strFromInt ((t1 - t0) / 1000)}ms sources=${strFromInt ((t2 - t1) / 1000)}ms compute=${strFromInt ((t3 - t2) / 1000)}ms write=${strFromInt ((t4 - t3) / 1000)}ms"
              in do
                pure (OkC modules)

-- 闭包里没有对应接口产物的模块名（写侧覆盖性诊断）。
missingNamesOf : List ClosureMod -> List String -> List String
missingNamesOf [] _ = []
missingNamesOf (m :: rest) written =
  if memName m.cmName written then missingNamesOf rest written
  else m.cmName :: missingNamesOf rest written

-- 按地址写模块接口（同一地址重复写幂等）。
-- 只统计**内容变化**的写入（`storeObjectWriteEff` 在字节相同时返回 0）：收敛后的
-- 第二次 check 应报 `iface-write=0/N`，这是「缓存已稳定」最直接的可观测信号。
writeIfaceObjects : List ClosureMod -> List ModuleIface -> Eff hostRow Int
writeIfaceObjects _ [] = pure 0
writeIfaceObjects mods (mi :: rest) = case findClosureMod (miNameOf mi) mods of
  Nothing => writeIfaceObjects mods rest
  Just m => do
    bytes <- storeObjectWriteEff "iface" ifaceObjectCodec m.cmAddr (encModuleIface mi)
    n <- writeIfaceObjects mods rest
    pure (if bytes > 0 then n + 1 else n)

-- 真正写接口：入口-only 包（没有 lib 模块）不写（没有可复用的模块接口；写空包只会让
-- 消费者读到 invalid 接口）。每模块按地址只写内容变化的接口对象，模块顺序最后提交。
-- 目标存储不可写（Nix store / 只读 store）时读侧没有接口就回退全量。
-- 影子写的自检（`VUNA_IFACE_SELFTEST=1`）：读回 + 包接口校验 + 模块名集合/接口哈希一致。
-- 失败让 check 失败（宁可暴露，不静默写坏缓存）。
ifaceSelfTestRequested : Eff hostRow Bool
ifaceSelfTestRequested = do
  v <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_IFACE_SELFTEST")
  pure (v == "1")

ifaceHashOfName : List ModuleIface -> String -> Maybe String
ifaceHashOfName [] _ = Nothing
ifaceHashOfName (m :: rest) name =
  if miNameOf m == name then Just (miIfaceHashOf m) else ifaceHashOfName rest name

allSelfHashesOk : List ModuleIface -> Bool
allSelfHashesOk [] = True
allSelfHashesOk (m :: rest) = hashOfIface m == miIfaceHashOf m && allSelfHashesOk rest

sameIfaceHashes : List ModuleIface -> List ModuleIface -> Bool
sameIfaceHashes [] _ = True
sameIfaceHashes (m :: rest) ys = case ifaceHashOfName ys (miNameOf m) of
  Just h => h == miIfaceHashOf m && sameIfaceHashes rest ys
  Nothing => False

-- 成功收尾：写接口影子（check 结果节点由 `checkViaGraph` 提交，这里不再写 marker 文件）。
checkAndShadow : PackageContext -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage)) -> Eff hostRow (Check (List Diagnostic))
checkAndShadow ctx checked = do
  checkedR <- checked
  case checkedR of
    ErrC e => pure (ErrC e)
    OkC pr => do
      shadow <- writeIfaceShadow ctx (secondOf pr)
      case shadow of
        ErrC e => pure (ErrC e)
        OkC _ => pure (OkC (firstOf pr))

checkCachedLib : Bool -> PackageContext -> List String -> Eff hostRow (Check (List Diagnostic))
checkCachedLib wantWarnings ctx names = do
  mods <- checkModsLib ctx names
  if wantWarnings then checkUncachedLib wantWarnings ctx names
  else checkViaGraph ctx mods (checkUncachedLib wantWarnings ctx names)

checkUncachedLib : Bool -> PackageContext -> List String -> Eff hostRow (Check (List Diagnostic))
checkUncachedLib wantWarnings ctx names = do
  full <- elabFullRequested
  if full then fullCheckLib ctx names
  else do
    audit <- ifaceAuditRequested
    if audit then auditCheckLib wantWarnings ctx names
    else do
      summary <- summaryCheckLibParts wantWarnings ctx names
      checkAndShadow ctx (pure summary)

summaryCheckLibParts : Bool -> PackageContext -> List String -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
summaryCheckLibParts wantWarnings ctx names = do
  depIfaces <- depIfacesOf ctx
  case depIfaces of
    Nothing => do
      let
        _ = dbg! "cache-path=full"
      in do
        dtCheckLibraryWithProgramParts ctx names
    Just ifaces => do
      depTbl <- depIfaceHashTable ctx
      clean <- ownCleanModules ctx depTbl
      case clean of
        Just clean2 => do
          let
            cleanReal = if wantWarnings then [] else clean2
            _ = dbg! "cache-path=summary deps=${depPackageCount ctx}"
            _ = dbg! "cache-own-clean=${length cleanReal}"
          in do
            dtCheckLibraryPackageIncrementalParts ctx names ifaces cleanReal
        Nothing => do
          let
            _ = dbg! "cache-path=summary deps=${depPackageCount ctx}"
          in do
            dtCheckLibraryPackageWithIfacesParts ctx names ifaces

fullCheckLib : PackageContext -> List String -> Eff hostRow (Check (List Diagnostic))
fullCheckLib ctx names =
  let
    _ = dbg! "cache-path=full"
  in checkAndShadow ctx (dtCheckLibraryWithProgramParts ctx names)

auditCheckLib : Bool -> PackageContext -> List String -> Eff hostRow (Check (List Diagnostic))
auditCheckLib wantWarnings ctx names = do
  summary <- summaryCheckLibParts wantWarnings ctx names
  full <- dtCheckLibraryWithProgramParts ctx names
  let
    subject = joinLines names
    _ = dbg! "iface-audit subject=check-lib entry=${subject}"
  in do
    compared <-
      pure (auditCompare "check-lib" subject (checkSignatureOf summary) (checkSignatureOf full))
    case compared of
      ErrC e => pure (ErrC e)
      OkC _ => checkAndShadow ctx (pure summary)

-- ---------------------------------------------------------------
-- codegen 产物的缓存判定：**输入寻址的 split blob 存在性**。
--
-- 旧实现换过两代：`<cache>/<包桶>/split/<composite-key>` 一个文件 → 查询图节点
-- （值 = 内容地址）。现在是 `blobs/<splitIn>`：`splitIn` 由包名 + kind + 三项输入摘要 +
-- 编译器指纹算出，同一输入同一路径；命中判定就是文件存在，写侧重算结果覆盖同一路径。
-- ---------------------------------------------------------------
-- | split 输入摘要的 schema（结构变化必须 bump；旧 blob 自然失效）。
splitNodeSchema : String
splitNodeSchema = "vuna-split-node 2"

-- | split 载荷的编码版本（`Store` 的 codec 段）。
-- 2：载荷是 `canonicalTopo` 后的规范拓扑序（1 是 codegen 原始顺序）。命中路径直接按
-- 载荷顺序写产物，不再重算规范化；旧 1 载荷因 codec 不符自然失效（miss 重写）。
splitCacheCodec : String
splitCacheCodec = "split-files 2"

-- | blob 的 framing tag（schema + 编译器指纹）。
splitBlobTag : Eff hostRow String
splitBlobTag = do
  tag <- compilerTagEff
  pure "${splitNodeSchema}/${tag}"

-- | split 节点的输入摘要：源闭包 / 依赖身份 / 版本+指纹+printResult。
splitModsOf : PackageContext -> String -> Bool -> Eff hostRow CheckMods
splitModsOf ctx entry printResult = do
  sources <- contextSources ctx entry
  deps <- depIdentitiesEff ctx
  fp <- compilerFingerprint
  -- **产物口径**必须进判定 key：摘要路径（依赖接口齐全）与全量路径产出的代码不同
  -- （实测 runtime 的 defloc 表在两条路径下长度不同）。只用源码/依赖摘要当 key 会让
  -- 「先全量、后摘要」两次构建复用同一 blob 却覆盖不同内容（§41 回归）。
  ifaces <- depIfacesOf ctx
  let
    srcHash = closureHashOf sources 0
    verHash = textHash (splitNodeSchema ++ vunaVersion) + fp
    prHash = if printResult then 1 else 0
    mode = case ifaces of
      Just _ => "s"
      Nothing => "f"
    kind = "${mode}:${if printResult then "pr1" else "pr0"}"
  in pure
    (checkModsOf (contextPackageName ctx) kind "" (hashText srcHash) (depIdentitiesHash deps) (hashText (verHash + prHash)))

-- | blob 路径：内容寻址（`<cache>/blobs/<digest>`）。
splitBlobPath : String -> Eff hostRow String
splitBlobPath digest = do
  base <- cacheBase
  pure "${base}/blobs/${digest}"

-- | 写 blob 到**输入寻址**路径（key 由 `splitInOf` 给出，不再由内容哈希决定）：
-- 同一个输入永远同一个路径，命中判定就是「文件存在」。
writeSplitBlobAt : String -> List SplitFile -> Eff hostRow Int
writeSplitBlobAt digest files = do
  let
    payload = encTop encSplitFiles files
    -- 路径是**输入**地址；framing 头里记**内容**地址，读侧才能发现篡改。
    contentDigest = payloadDigest payload
  in do
    tag <- splitBlobTag
    path <- splitBlobPath digest
    base <- cacheBase
    _ <- storeEnsureDirEff "${base}/blobs"
    storeWriteIfChangedAsEff tag splitCacheCodec contentDigest path payload

-- | split 的输入摘要：包 + kind + 三个闭包摘要 + 编译器指纹（与 check 判定同口径）。
splitInOf : CheckMods -> String
splitInOf m = addrOf ["split", m.cmPkg, m.cmKind, m.cmManifest, m.cmSources, m.cmDeps, m.cmVer]

-- ---------------------------------------------------------------
-- 产物身份（代码即内容）：快 key → 语义 key 的指针 + 语义 blob。
--
-- `splitIdentityOf` 只看本包接口面 / 产物面 / 布局（span 行号）与编译器 tag，不看源字节：
-- 注释变更不换语义 key（复用 codegen），行移动换布局摘要（重建位置表），
-- `opaque`/`abstract` 体变更换 `pkgImplHash`（只换本包产物）。
-- ---------------------------------------------------------------
splitPtrKind : String
splitPtrKind = "splitptr"

splitPtrCodec : String
splitPtrCodec = "split-pointer 1"

readSplitPointer : String -> Eff hostRow (Maybe String)
readSplitPointer fast = do
  saved <- storeObjectReadEff splitPtrKind splitPtrCodec fast
  pure (case saved of
    Just sem => if sem == "" then Nothing else Just sem
    Nothing => Nothing
  )

writeSplitPointer : String -> String -> Eff hostRow Int
writeSplitPointer fast sem = storeObjectWriteEff splitPtrKind splitPtrCodec fast sem

defLocLine : PackageContext -> Pair String (Pair String Int) -> String
defLocLine ctx p =
  "${firstOf p}|${dropPrefixMeta "${contextDir ctx}/" (firstOf (secondOf p))}|${strFromInt (secondOf (secondOf p))}"

-- 布局摘要：排序后的模块 × 定义位置（相对包目录的文件 + startLine）。产物里的
-- `dt_def_locs` 由它决定；与源字节/注释/绝对路径无关。
layoutDigestOf : PackageContext -> List ModuleIface -> String
layoutDigestOf ctx modules =
  addrOf
    ("split-layout" :: concatMap (\m => map (\p => "${miNameOf m}|${defLocLine ctx p}") (miDefLocsOf m)) (sortModuleIfaces modules))

splitIdentityOf : PackageContext -> Bool -> String -> List ModuleIface -> String
splitIdentityOf ctx printResult tag modules =
  let
    pkg = contextPackageName ctx
    pr = if printResult then "1" else "0"
  in addrOf
    ["split-identity", splitNodeSchema, pkg, pr, pkgIfaceHashOfModules pkg modules, pkgImplHashOfModules pkg modules, layoutDigestOf ctx modules, tag]

-- | build 视图的地址：与 split 判定同一个输入摘要。默认输出目录就是
-- `$VUNA_STORE/views/bin/<该摘要>`，`.output` 只是指向它的符号链接。
export buildViewAddrOf : PackageContext -> String -> Bool -> Eff hostRow String
buildViewAddrOf ctx entry printResult = do
  mods <- splitModsOf ctx entry printResult
  pure (splitInOf mods)

-- | check 的判定摘要：四个输入摘要 + 包 + kind。存在即「判过」。
checkInOf : CheckMods -> String
checkInOf m = addrOf ["check", m.cmPkg, m.cmKind, m.cmManifest, m.cmSources, m.cmDeps, m.cmVer]

-- | 写 blob（内容不变就不写：同一产物被多次构建复用时零写放大）。
-- 调用方传入**已规范化**的列表：digest 与产物顺序都按规范序取，原始 codegen 顺序不落盘。
writeSplitBlob : List SplitFile -> Eff hostRow String
writeSplitBlob files = do
  let
    payload = encTop encSplitFiles files
    digest = payloadDigest payload
  in do
    tag <- splitBlobTag
    path <- splitBlobPath digest
    base <- cacheBase
    _ <- storeEnsureDirEff "${base}/blobs"
    _ <- storeWriteIfChangedAsEff tag splitCacheCodec digest path payload
    pure digest

-- | 读 blob：framing 全量校验（**重算**载荷内容地址，不只是比对头声明）+ 内容地址比对
-- 通过才解码；任何不符 ⇒ Nothing（重算并重写同一路径）。
--
-- C51 相邻修复：split 载荷没有 iface 那种「逐字段语义自证」，所以不能走
-- `storeReadAsEff`（只比头里的地址字符串，同长度载荷篡改会静默进入解码器 → 损坏的
-- codegen 产物）。重算成本是 `contentAddress` 的预折叠 + SHA-256（~2.2 ms/MB），
-- 只在 split 命中路径付一次；§52c 的「载荷中部单字节篡改」因此真正被拒绝。
readSplitBlob : String -> Eff hostRow (Maybe (List SplitFile))
readSplitBlob digest = do
  tag <- splitBlobTag
  path <- splitBlobPath digest
  -- 路径是输入地址；framing 头记内容地址，`storeReadEff` 重算并校验
  -- （截断/篡改必须被拒绝，不能把坏载荷当产物写出去）。
  payload <- storeReadEff tag splitCacheCodec path
  pure (case payload of
    Just bytes => decSplitFilesComplete bytes
    Nothing => Nothing
  )

-- 自检辅助：找出第一个 `cachedProgramValid` 不过的模块名（空 = 全部有效）。
firstInvalidModule : PackageIface -> String
firstInvalidModule p = firstInvalidGo (pmModulesOfIface p)

pmModulesOfIface : PackageIface -> List ModuleIface
pmModulesOfIface p = p.piModules

firstInvalidGo : List ModuleIface -> String
firstInvalidGo [] = ""
firstInvalidGo (m :: rest) =
  if cachedProgramValid (miCachedOf m) then firstInvalidGo rest
  else "${miNameOf m}:${cachedProgramIssue (miCachedOf m)}"
