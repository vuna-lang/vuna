module Vuna.Compiler.Driver.Compile
  ( ToolContext
  , baseDepIfacesOf
  , buildMetaText
  , buildSplit
  , checkPackage
  , compileToDir
  , depIfacesForCheck
  , depIfacesForTool
  , depIfacesForToolProgram
  , depIfacesForToolSource
  , depIfacesForToolSourceDetailed
  , ensureDirPath
  , metaUpToDate
  , runBuildScript
  , sourceInfoForPath
  , toolCleanOwnModules
  , toolCompilerFingerprint
  , toolHasOwnManifest
  , toolNeededOfImports
  , toolNowSec
  , toolOwnEntrySourceHash
  , toolSessionFresh
  , toolTextHash
  , toolWriteModuleIface
  , toolWriteModuleIfaceCold
  , writeBuildMeta
  ) where

-- Vuna.Compiler.Driver.Compile：编译入口（供 CompilerCli / 测试使用）。唯一路径是 DT：
-- 精化（Elab）→ 擦除检查 + 逐模块 OCaml 生成（Codegen.Split）；`check*` 只检查不产码。
-- M26：包上下文（`PackageContext`）是唯一入口形状；旧的 `effectiveRoots` /
-- 单文件 codegen（main.ml + build.sh）/ `seedSplit` 已删除——`compile` 与 `seed`
-- rotation 共用 `compileToDir`（目录 + build.sh）。
-- M30：`build` 在链接成功后写 `build-meta.json`（源/依赖闭包内容哈希 + compiler 版本），
-- 同哈希直接跳过；`compile` / `build --no-compile` 不写 meta（seed rotation 与快照
-- 只认 .ml/build.sh 的确定性产物）。
-- C35：codegen 改为全限定跨单元引用后，每个模块只 `open` / 依赖它真正引用的前序单元；
-- `writeCompiled` 把 SplitFile 的直接依赖传给 `buildScript`，生成的 build.sh 按 vuna
-- 预先算好的层**分层并行**编译 + 精确增量（每单元 stamp 只含直接依赖），依赖图不再
-- 退化为全序链。
--
-- M4（效果显式化）：扫描/读文件/写文件/建目录/删除/子进程/时钟/环境/二进制指纹全部
-- 显式在 `Eff []` 里（本模块不再用 `runPure` 隐藏执行）。纯逻辑（路径/哈希/序列化/
-- 缓存键计算/AST 变换）保持纯函数；仍在迁移中的下挂模块（`Driver.Split`、`Driver.Dt`、
-- `Packages.Pkg` 的磁盘层）由各自模块按过渡策略在内部收口，这里直接调用。
import Vuna.Compiler.Common
import Vuna.Compiler.Hash
import Vuna.Compiler.Diagnostics.Pkg
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Fingerprint
import Vuna.Compiler.Store
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Debug
import Vuna.Compiler.Elab
import Vuna.Compiler.Driver.Cache
import Vuna.Compiler.Driver.Graph
import Vuna.Compiler.Driver.Iface
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Loader
import Vuna.Compiler.Query
import Vuna.Compiler.Query.Run
import Vuna.Compiler.Version
import Base.Host

-- ---------------------------------------------------------------
-- 效果辅助（本模块自用；顺序与纯 `map` / `concatMap` / `mapMaybe` 一致）
-- ---------------------------------------------------------------
mapEff : (a -> Eff [] b) -> List a -> Eff [] (List b)
mapEff f [] = pure []
mapEff f (x :: rest) = do
  y <- f x
  ys <- mapEff f rest
  pure (y :: ys)

concatMapEff : (a -> Eff [] (List b)) -> List a -> Eff [] (List b)
concatMapEff f [] = pure []
concatMapEff f (x :: rest) = do
  xs <- f x
  ys <- concatMapEff f rest
  pure (append xs ys)

mapMaybeEff : (a -> Eff [] (Maybe b)) -> List a -> Eff [] (List b)
mapMaybeEff f [] = pure []
mapMaybeEff f (x :: rest) = do
  y <- f x
  ys <- mapMaybeEff f rest
  pure (case y of
    Just v => v :: ys
    Nothing => ys
  )

-- 包级 check：可执行包检查 app/Main.vuna；库包检查 [export].modules。
-- M34.5：结果走磁盘缓存（key = 闭包源哈希 + 依赖哈希 + manifest + 版本）。
-- M45：`wantWarnings` = 调用方要 warning（`-W` / `--deny-warnings`）。warning 不持久化，
-- 缓存命中/干净模块复用都会跳过精化、丢掉 warning，所以这里跳过 check 缓存并强制本包
-- 模块重算（依赖仍走接口摘要，不重算依赖包）。
checkPackage : Bool -> Package -> Eff [] (Check (List Diagnostic))
checkPackage wantWarnings pkg = do
  exists <- prim_eff_fileExists (packageEntry pkg)
  if exists then checkCachedExe wantWarnings (packageContext pkg) (packageEntry pkg)
  else case packageExports pkg of
    Nothing => pure (pkgNoLoc1 (LibraryWithoutEntry (packageName pkg)) (packageName pkg))
    Just names => checkCachedLib wantWarnings (packageContext pkg) names

-- 逐级创建目录（prim_eff_makeDir 只建一层；`--out a/b` 的父目录可能不存在）。
-- 递归沿 `parentOfPath` 上升，不是结构下降，用显式 fuel 守卫（路径深度上限）。
ensureDirPath : String -> Eff [] Int
ensureDirPath path = ensureDirPathFuel 256 path

ensureDirPathFuel : Int -> String -> Eff [] Int
ensureDirPathFuel fuel path = if fuel <= 0 then pure 0
else if path == "" || path == "." || path == "/" then pure 0
else do
  exists <- prim_eff_fileExists path
  if exists then pure 0
  else do
    _ <- ensureDirPathFuel (fuel - 1) (parentOfPath path)
    prim_eff_makeDir path

-- 去掉最后一段（`a/b/c` -> `a/b`；无 `/` -> "."；绝对路径的父仍绝对）。
-- 先 reverse，跳过第一个 `/` 后剩下的字符再 reverse 回来。
dropPastSlash : List Int -> List Int
dropPastSlash [] = []
dropPastSlash (c :: rest) = if c == 47 then rest else dropPastSlash rest

parentOfPath : String -> String
parentOfPath path =
  let
    chars = strUnpack path
    rev = reverse chars
    after = dropPastSlash rev
  in if length after == length rev then "."
  else
    let
      parent = strPack (reverse after)
    in if parent == "" then if startsWith "/" path then "/" else "."
    else if startsWith "/" path && not (startsWith "/" parent) then "/${parent}" else parent

-- 逐模块 split 输出到 outDir：各模块 .ml + Main.ml + build.sh；Ok 写出的文件数。
-- outDir 在 codegen 成功后才创建（精化失败不留产物）。
-- M33 W5：包根 `ffi/*.c` 复制到 `OUTDIR/ffi/` 并写进 build.sh（受限 FFI 的 C 实现）。
compileToDir : PackageContext -> String -> Bool -> String -> Eff [] (Check (Pair Int (List Diagnostic)))
compileToDir ctx entry printResult outDir = do
  audit <- ifaceAuditRequested
  if audit then auditCompile ctx entry printResult outDir
  else compileToDirNormal ctx entry printResult outDir

-- 摘要路径的 split（**不读 split 缓存**）：接口可用 ⇒ 摘要路径（干净模块 + 依赖接口），
-- 否则全量。抽出来供正常路径与审计路径共用，保证两条路径的「摘要分支」完全一致。
summarySplitParts : PackageContext -> String -> Bool -> Eff [] (Check (Pair (List SplitFile) CheckedPackage))
summarySplitParts ctx entry printResult = do
  depIfaces <- depIfacesOf ctx
  case depIfaces of
    Just ifaces => do
      depTbl <- depIfaceHashTable ctx
      clean <- ownCleanModules ctx depTbl
      case clean of
        Just clean2 => do
          let
            _ = note "cache-own-clean=${length clean2}"
          in do
            dtSplitProjectIncremental ctx entry printResult ifaces clean2
        Nothing => dtSplitProjectWithIfaces ctx entry printResult ifaces
    Nothing => dtSplitProjectParts ctx entry printResult

compileToDirNormal : PackageContext -> String -> Bool -> String -> Eff [] (Check (Pair Int (List Diagnostic)))
compileToDirNormal ctx entry printResult outDir = do
  key <- splitCacheKey ctx entry printResult
  path <- splitCachePath ctx key
  tag <- splitCacheTag
  let
    _ = stamp "split-cache-key-done"
  in do
    files <- readSplitCache tag path
    case files of
      Just cached => do
        let
          _ = stamp "split-cache-hit"
        in do
          n <- writeCompiled ctx outDir cached
          pure (case n of
            ErrC e => ErrC e
            OkC count => OkC (Pair count [])
          )
      Nothing => do
        summary <- summarySplitParts ctx entry printResult
        case summary of
          ErrC e => pure (ErrC e)
          OkC p => finishBuild ctx outDir tag path (firstOf p) (secondOf p)

-- 审计（`VUNA_IFACE_AUDIT=1`）：同一进程分别走摘要路径与全量路径，codegen 产物逐字节比较；
-- 一致才按摘要结果落盘，不一致报 `iface-audit-mismatch` 且**不写任何缓存/接口**
-- （坏缓存不能被下一次运行「合法」消费）。
auditCompile : PackageContext -> String -> Bool -> String -> Eff [] (Check (Pair Int (List Diagnostic)))
auditCompile ctx entry printResult outDir = do
  key <- splitCacheKey ctx entry printResult
  path <- splitCachePath ctx key
  tag <- splitCacheTag
  summary <- summarySplitParts ctx entry printResult
  full <- dtSplitProjectParts ctx entry printResult
  let
    _ = note "iface-audit subject=compile entry=${entry}"
  in do
    compared <-
      pure (auditCompare "compile" entry (splitSignatureOf summary) (splitSignatureOf full))
    case compared of
      ErrC e => pure (ErrC e)
      OkC _ => case summary of
        ErrC e => pure (ErrC e)
        OkC p => finishBuild ctx outDir tag path (firstOf p) (secondOf p)

-- 写产物 + 写 split 缓存 + 影子写模块接口（构建成功同样要产出接口，否则只 build 的工程
-- 永远无法给下游提供接口）。
finishBuild : PackageContext -> String -> String -> String -> List SplitFile -> CheckedPackage -> Eff [] (Check (Pair Int (List Diagnostic)))
finishBuild ctx outDir tag cachePath files checked = do
  n <- writeCompiled ctx outDir files
  case n of
    ErrC e => pure (ErrC e)
    OkC count => do
      _ <- writeSplitCache ctx tag cachePath files
      shadow <- writeIfaceShadow ctx checked
      case shadow of
        ErrC e => pure (ErrC e)
        OkC _ => pure (OkC (Pair count checked.checkedWarnings))

-- 把（缓存的或新生成的）split 文件写入 outDir 并写 build.sh。
writeCompiled : PackageContext -> String -> List SplitFile -> Eff [] (Check Int)
writeCompiled ctx outDir files = do
  _ <- ensureDirPath outDir
  let
    _ = stamp "write-compiled-start"
  in do
    written <- writeSplitFilesIfChanged outDir files
    case written of
      ErrC e => pure (ErrC e)
      OkC n => do
        let
          _ = stamp "write-split-files-done"
          graph = splitGraph (canonicalTopo files)
          _ = stamp "split-graph-done"
        in do
          cFiles <- copyFfiFiles (contextDir ctx) outDir
          _ <- prim_eff_writeFile "${outDir}/build.sh" (buildScript graph cFiles)
          let
            _ = stamp "build-script-done"
          in do
            pure (OkC n)

-- 包根 `ffi/*.c` → OUTDIR/ffi/<name>.c；返回写进 build.sh 的相对路径列表。
-- 没有 ffi/ 目录时返回 []（旧包行为不变）。
copyFfiFiles : String -> String -> Eff [] (List String)
copyFfiFiles ctxDir outDir = do
  let
    ffiDir = "${ctxDir}/ffi"
  in do
    exists <- prim_eff_fileExists ffiDir
    isDir <- if exists then prim_eff_isDirectory ffiDir else pure False
    if exists && isDir then do
      names <- prim_eff_readDir ffiDir
      let
        cs = filter (\n => endsWith ".c" n) names
      in do
        _ <- ensureDirPath "${outDir}/ffi"
        _ <- mapEff (\n => do
          content <- prim_eff_readFile "${ffiDir}/${n}"
          prim_eff_writeFile "${outDir}/ffi/${n}" content
        ) cs
        pure (map (\n => "ffi/${n}") cs)
    else pure []

-- loadPackage + compileToDir：给定包目录的代码生成（seed rotation / 测试用）。
buildSplit : String -> String -> Eff [] (Check Int)
buildSplit dir outDir = do
  pkgR <- loadPackage dir
  case pkgR of
    ErrC e => pure (ErrC e)
    OkC pkg => do
      r <- compileToDir (packageContext pkg) (packageEntry pkg) True outDir
      pure (case r of
        ErrC e => ErrC e
        OkC p => OkC (firstOf p)
      )

-- ---------------------------------------------------------------
-- M30：build meta（确定性、无绝对路径/时间戳）
--
-- 目的：同输入同产物 + 依赖闭包哈希 + 同哈希跳过。meta 只记录**模块名**与内容
-- 哈希（模块名由模块根相对路径推导，跨机器稳定）；不记录绝对路径/时间戳。
-- `build` 链接成功后写；`compile` / `build --no-compile` 不写（seed rotation 与
-- 快照只认 .ml/build.sh）。
-- ---------------------------------------------------------------
metaSchema : Int
metaSchema = 1

metaFileName : String
metaFileName = "build-meta.json"

-- 内容哈希：SHA-256 的 63-bit 派生键（替代旧的「strHash 10-bit + 长度」组合）。
textHash : String -> Int
textHash s = Vuna.Compiler.Hash.contentKey s

-- M34.5：编译器二进制指纹（缓存 key 必须含它：check/codegen 语义随编译器变化）。
-- M38：用**可执行文件自身**的路径 + 大小 + mtime，而不是 `prim_eff_getArgs` 的第一个用户参数。
-- 旧实现把子命令名（如 `test`）当路径：只要 cwd 里恰好有同名文件/目录（包根的 `test/`
-- 就是最常见的情况），`prim_eff_readFile` 会去读目录并抛 `Failure("readFile: ...")`——
-- `vuna test` 在包根直接崩溃即此。store 路径 + size + mtime 足以区分重新构建的编译器。
-- M4：env/stat 是宿主动作，显式 `Eff []`（原先在模块初始化时用 `runPure` 取一次）。
compilerFingerprint : Eff [] Int
compilerFingerprint = compilerFingerprintEff

-- M34.5：缓存根（TMPDIR 可写；Nix 构建的源树只读，缓存放临时目录 ⇒ 构建内不命中，
-- 无害；本地开发同机 TMPDIR 持久 ⇒ 命中）。按包路径哈希隔离项目。
cacheBase : Eff [] String
cacheBase = do
  -- `VUNA_CACHE_DIR` 覆盖（跨 run 复用 split / unit 缓存；测试 runner 按 worker
  -- 作用域 + 编译器指纹分桶，避免并发写冲突）。缺省仍是 `$TMPDIR/vuna-cache`。
  override <- prim_eff_getenv "VUNA_CACHE_DIR"
  tmp <- prim_eff_getenv "TMPDIR"
  pure (if override /= "" then override else "${if tmp == "" then "/tmp" else tmp}/vuna-cache")

-- 目录遍历（模块根内的 .vuna；与 Vuna.Files 的跳过规则一致，但 compiler 包不能
-- import 根包工具链）。fuel 守卫目录图（符号链接环）。
skipMetaDir : String -> Bool
skipMetaDir name =
  name == ".git"
    || name == ".local"
    || name == ".output"
    || name == ".direnv"
    || name == "node_modules"
    || name == "seed"
    || name == "_scratch"
    || name == "result"
    || name == "corpus"

collectVunaMeta : Int -> String -> Eff [] (List String)
collectVunaMeta fuel dir = if fuel <= 0 then pure []
else do
  exists <- prim_eff_fileExists dir
  isDir <- if exists then prim_eff_isDirectory dir else pure False
  if exists && isDir then do
    names <- prim_eff_readDir dir
    concatMapEff (walkVunaMeta (fuel - 1) dir) names
  else pure []

walkVunaMeta : Int -> String -> String -> Eff [] (List String)
walkVunaMeta fuel dir name = if fuel <= 0 then pure []
else case name of
  "." => pure []
  ".." => pure []
  _ => if skipMetaDir name then pure []
  else do
    let
      path = "${dir}/${name}"
    in do
      exists <- prim_eff_fileExists path
      isDir <- if exists then prim_eff_isDirectory path else pure False
      if exists && isDir then collectVunaMeta (fuel - 1) path
      else pure (if endsWith ".vuna" name then [path] else [])

dropPrefixMeta : String -> String -> String
dropPrefixMeta prefix s =
  if startsWith prefix s then substring (byteLength prefix) (byteLength s - byteLength prefix) s
  else s

slashesToDots : String -> String
slashesToDots s = strPack (map slashToDot (strUnpack s))

slashToDot : Int -> Int
slashToDot c = if c == 47 then 46 else c

moduleNameOfPath : String -> String -> String
moduleNameOfPath rootPath path =
  let
    rel0 = dropPrefixMeta "${rootPath}/" path
    rel = if endsWith ".vuna" rel0 then substring 0 (byteLength rel0 - 5) rel0 else rel0
  in slashesToDots rel

rootSources : Root -> Eff [] (List (Pair String Int))
rootSources root = do
  paths <- collectVunaMeta 1048576 (rootDir root)
  mapEff (\p => do
    content <- prim_eff_readFile p
    pure (Pair (moduleNameOfPath (rootDir root) p) (textHash content))
  ) paths

rootHash : Root -> Eff [] Int
rootHash root = do
  sources <- rootSources root
  pure (closureHashOf sources 0)

closureHashOf : List (Pair String Int) -> Int -> Int
closureHashOf [] acc = acc
closureHashOf ((Pair name h) :: rest) acc = closureHashOf rest (acc * 1000003 + h)

-- 入口文件 + 所有模块根的源码（模块名 → 哈希）。
entrySource : String -> Eff [] (Pair String Int)
entrySource entry = do
  content <- prim_eff_readFile entry
  pure (Pair "<entry>" (textHash content))

contextSources : PackageContext -> String -> Eff [] (List (Pair String Int))
contextSources ctx entry = do
  rootSourcesAll <- concatMapEff rootSources (contextRoots ctx)
  es <- entrySource entry
  pure (append rootSourcesAll [es])

-- 依赖闭包（跳过第一个根：它是本包自己的 lib；base-only 由 build 不会走到）。
dependencyHashes : PackageContext -> Eff [] (List (Pair String Int))
dependencyHashes ctx = case contextRoots ctx of
  [] => pure []
  _ :: deps => mapEff (\r => do
    h <- rootHash r
    pure (Pair (rootName r) h)
  ) deps

metaPairText : Pair String Int -> String
metaPairText (Pair name hash) = "{\"name\":\"${name}\",\"hash\":${hash}}"

joinJsonList : List String -> String
joinJsonList [] = ""
joinJsonList ([x]) = x
joinJsonList (x :: rest) = "${x},${joinJsonList rest}"

-- 路径最后一段（`splitPath` 按第一个 `/` 切，不适合取 basename）。
-- 输入是反向字符流；acc 里已是原顺序的最后一段字符，直接 strPack。
lastSegmentRev : List Int -> List Int -> String
lastSegmentRev [] acc = strPack acc
lastSegmentRev (c :: rest) acc = if c == 47 then strPack acc else lastSegmentRev rest (c :: acc)

lastSegment : String -> String
lastSegment path = lastSegmentRev (reverse (strUnpack path)) []

buildMetaText : PackageContext -> String -> Bool -> Eff [] String
buildMetaText ctx entry linked = do
  sources <- contextSources ctx entry
  deps <- dependencyHashes ctx
  toml <- prim_eff_readFile "${contextDir ctx}/vuna.toml"
  let
    manifestHash = textHash toml
    entryName = lastSegment entry
    linkedText = if linked then "true" else "false"
  in do
    pure
      "{\"schema\":${metaSchema},\"compiler\":\"${vunaVersion}\",\"package\":\"${contextPackageName ctx}\",\"entry\":\"${entryName}\",\"linked\":${linkedText},\"closure\":${closureHashOf sources 0},\"manifest\":${manifestHash},\"sources\":[${joinJsonList (map metaPairText sources)}],\"dependencies\":[${joinJsonList (map metaPairText deps)}]}\n"

metaPathOf : String -> String
metaPathOf outDir = "${outDir}/${metaFileName}"

writeBuildMeta : String -> PackageContext -> String -> Bool -> Eff [] Int
writeBuildMeta outDir ctx entry linked = do
  text <- buildMetaText ctx entry linked
  prim_eff_writeFile (metaPathOf outDir) text

-- 同哈希跳过：meta 内容与期望（linked=true）完全一致，且产物二进制存在。
metaUpToDate : String -> PackageContext -> String -> String -> Eff [] Bool
metaUpToDate outDir ctx entry binPath = do
  let
    path = metaPathOf outDir
  in do
    exists <- prim_eff_fileExists path
    binExists <- if exists then prim_eff_fileExists binPath else pure False
    if exists && binExists then do
      raw <- prim_eff_readFile path
      expected <- buildMetaText ctx entry True
      pure (raw == expected)
    else pure False

-- 在 dir 里跑生成的 build.sh：`sh build.sh <out>`（out 相对 dir，例如 "bin/<pkg>"）。
-- 链接失败给出带包名/目录/退出码的清晰错误（ocamlopt 的 stderr 已在终端）。
runBuildScript : String -> String -> String -> Eff [] (Check Int)
runBuildScript dir out name = do
  code <- prim_eff_runIn dir ["sh", "build.sh", out]
  pure
    (if code == 0 then OkC 0 else err "build: ${name}: `sh build.sh ${out}` failed in ${dir} (exit ${code})")

-- ---------------------------------------------------------------
-- 阶段 2：check 的缓存判定搬进查询图（`Driver.Graph` 的节点族）
--
-- 旧实现是「拼一个复合 key 当文件名」（`check/` marker 目录，C32 时缩成 0 字节载荷）。
-- 现在改成一个图节点 `check:<pkg>:<kind>`：值 = `QMarker`，依赖表 = 四个输入摘要
-- （manifest / 源闭包 / 依赖接口闭包 / 编译器版本+指纹）。语义等价（四个摘要全等 ⇒ 命中），
-- 但判定走 `Query.queryHit` / `queryResolve`，并且可以随会话索引持久化、与其它图节点
-- 共用 cutoff / trace 语义。
--
-- 为什么输入摘要写进 **dep key** 而不是单独节点：这些摘要每轮都必须重新读盘算（`Db`
-- 的纯语义里没有「输入可变」），把摘要放进 key 就能让「key 变了 ⇒ 依赖表变了 ⇒ miss」
-- 自然成立，不必给输入节点做可变性。
-- ---------------------------------------------------------------
-- | 图节点 key 的 schema（结构变化必须 bump；旧会话索引自然拒绝）。
checkNodeSchema : String
checkNodeSchema = "vuna-check-node 1"

hashText : Int -> String
hashText n = strFromInt n

-- | 可执行包的 check 节点输入：源闭包 / 依赖闭包 / manifest / 编译器。
checkModsExe : PackageContext -> String -> Eff [] CheckMods
checkModsExe ctx entry = do
  sources <- contextSources ctx entry
  deps <- dependencyHashes ctx
  toml <- prim_eff_readFile "${contextDir ctx}/vuna.toml"
  fp <- compilerFingerprint
  let
    srcHash = closureHashOf sources 0
    depsHash = closureHashOf deps 0
    manHash = textHash toml
    verHash = textHash (checkNodeSchema ++ vunaVersion) + fp
  in pure
    (checkModsOf (contextPackageName ctx) "exe" (hashText manHash) (hashText srcHash) (hashText depsHash) (hashText verHash))

-- | 库包的 check 节点输入：全部模块根（不受入口闭包限制）+ 导出面 + 依赖 + manifest。
checkModsLib : PackageContext -> List String -> Eff [] CheckMods
checkModsLib ctx names = do
  rootSourcesAll <- concatMapEff rootSources (contextRoots ctx)
  deps <- dependencyHashes ctx
  toml <- prim_eff_readFile "${contextDir ctx}/vuna.toml"
  fp <- compilerFingerprint
  let
    srcHash = closureHashOf rootSourcesAll 0
    depsHash = closureHashOf deps 0
    manHash = textHash toml
    namesHash = textHash (join "\t" names)
    verHash = textHash (checkNodeSchema ++ vunaVersion) + fp
  in pure
    (checkModsOf (contextPackageName ctx) "lib:${hashText namesHash}" (hashText manHash) (hashText srcHash) (hashText depsHash) (hashText verHash))

-- 依赖优先的 DFS 后序 + 按包名去重（与 Packages.Pkg.dependencyRoots 同规则）。
-- 记录字段访问（`p.packageDependencies`）不再被终止性判据识别为「结构投影」，
-- 非结构递归在 SCT 里没有下降参数；用 fuel 守卫（同 loader 的遍历惯例）。
collectDepPackages : List String -> List Package -> Pair (List String) (List Package)
collectDepPackages seen ps = collectDepPackagesFuel 4096 seen ps

collectDepPackagesFuel : Int -> List String -> List Package -> Pair (List String) (List Package)
collectDepPackagesFuel fuel seen [] = Pair seen []
collectDepPackagesFuel fuel seen (p :: rest) = if fuel <= 0 then Pair seen (p :: rest)
else if memName (packageName p) seen then collectDepPackagesFuel (fuel - 1) seen rest
else case collectDepPackagesFuel (fuel - 1) (packageName p :: seen) p.packageDependencies of
  Pair seen1 transitive => case collectDepPackagesFuel (fuel - 1) seen1 rest of
    Pair seen2 siblings => Pair seen2 (append transitive (p :: siblings))

-- 依赖包接口目录：与写侧 `ifaceDirOf` 同一规则（默认 = 包目录本身，接口文件与源码同目录；
-- `VUNA_IFACE_DIR` 覆盖时 = 外部镜像根下按包绝对目录镜像）。key 不再是包名哈希：接口文件
-- 落在源码树里，同一包在相对/绝对/含 `..` 的不同写法下指向同一份文件；同名不同目录的包
-- 也天然各占一棵树。陈旧接口由读侧源哈希 / 哈希链校验拒绝（回退全量），不会误用。
depIfaceDirOf : Package -> Eff [] String
depIfaceDirOf dep = ifaceBaseOf (packageDir dep)

depIfaceOf : Package -> Eff [] (Maybe PackageIface)
depIfaceOf dep = do
  dir <- depIfaceDirOf dep
  tag <- ifaceCompilerTag
  pi <- readPackageIface dir tag
  case pi of
    Just p => if p.piSchema == ifaceSchemaTag && p.piCompiler == tag && p.piPackage == packageName dep then do
      env <- packageEnvHash (packageContext dep)
      if p.piEnv == env then pure (Just p)
      else do
        let
          _ = note "iface-reject=dep-env ${packageName dep}"
        in do
          pure Nothing
    else do
      let
        _ = note "iface-reject=dep-tag ${packageName dep}"
      in do
        pure Nothing
    Nothing => pure Nothing

sameNameSet : List String -> List String -> Bool
sameNameSet a b = length a == length b && allNamesIn a b && allNamesIn b a

allNamesIn : List String -> List String -> Bool
allNamesIn [] _ = True
allNamesIn (x :: rest) ys = memName x ys && allNamesIn rest ys

-- 依赖包接口哈希表：写本包接口时给 `miDepHashes` 用。
-- M34.5（S2）：依赖包**模块接口**加载（TTC 的 module 复用）。
--
-- 旧路径按包读 check 缓存里的 `CachedProgram`；S2 改为读每包的 `.vuna-iface`
-- 并逐项校验：schema/编译器指纹/包名 → 每个模块的源码哈希 → 依赖接口哈希链
-- （`miDepHashes`）→ 依赖包当前源码模块集合与接口模块集合一致。任一失败 ⇒ Nothing ⇒
-- 调用方回退全量（宁可慢，不静默用陈旧接口）。
depPackageList : PackageContext -> List Package
depPackageList ctx = case ctx.contextPackage of
  Nothing => []
  Just pkg => secondOf (collectDepPackages [] pkg.packageDependencies)

depPackageCount : PackageContext -> Int
depPackageCount ctx = length (depPackageList ctx)

depIfacesOf : PackageContext -> Eff [] (Maybe (List ModuleIface))
depIfacesOf ctx = case ctx.contextPackage of
  Nothing => pure Nothing
  Just pkg =>
    depIfacesGo (contextRoots ctx) (secondOf (collectDepPackages [] pkg.packageDependencies)) []

depIfacesGo : List Root -> List Package -> List (List ModuleIface) -> Eff [] (Maybe (List ModuleIface))
depIfacesGo roots [] acc =
  let
    all = concatMap (\xs => xs) (reverse acc)
  in if depIfaceChainValid all then pure (Just all)
  else do
    let
      _ = note "iface-reject=dep-chain modules=${length all}"
    in do
      pure Nothing
depIfacesGo roots (p :: rest) acc = do
  pi <- depIfaceOf p
  case pi of
    Nothing => do
      let
        _ = note "iface-reject=dep-manifest-miss cache-dep-miss ${packageName p}"
      in do
        pure Nothing
    Just pif => do
      valid <- depIfaceSourcesValid roots p pif
      if valid then do
        let
          _ = note "cache-dep-ok ${packageName p}"
        in do
          depIfacesGo roots rest (pif.piModules :: acc)
      else do
        let
          _ = note "iface-reject=dep-invalid cache-dep-invalid ${packageName p}"
        in do
          pure Nothing

-- 来源校验：接口记录的每个模块源信息 = 当前文件（默认内容哈希；`VUNA_CACHE_MTIME=1` 时
-- mtime+size 相同且落在安全窗外即视为未变，否则回落内容哈希）。反过来当前目录里的模块
-- 判据：接口记录的每个模块，其源文件必须仍然存在且内容未变。
-- **不做**「磁盘模块集合 == 接口模块集合」的相等比较：可执行包的接口只覆盖入口
-- import 闭包，磁盘上允许存在未被引用的模块（它们不参与编译，也不该进接口；
-- §64 起基础设施模块已入口导入，但工具包 / 本地夹具仍可能带未引用模块）。
-- 集合变化由其它判据覆盖：新增并 import 的模块会改使用者源码哈希、`[export]` 变化会改
-- `pmEnv`、删除文件会让下面的 entry 查找直接失败。
depIfaceSourcesValid : List Root -> Package -> PackageIface -> Eff [] Bool
depIfaceSourcesValid roots p pi = do
  let
    pkgRoots = filter (\r => rootName r == packageName p) roots
  in do
    walked <- sourcePathMapOfRoots pkgRoots
    allModuleSourcesValid pi.piModules walked

sourcePathMapOfRoots : List Root -> Eff [] (List (Pair String String))
sourcePathMapOfRoots roots = do
  walked <- mapEff (\r => do
    paths <- collectVunaMeta 1048576 (rootDir r)
    pure (map (\path => Pair (moduleNameOfPath (rootDir r) path) path) paths)
  ) roots
  pure (concatMap (\xs => xs) walked)

allModuleSourcesValid : List ModuleIface -> List (Pair String String) -> Eff [] Bool
allModuleSourcesValid [] _ = pure True
allModuleSourcesValid (m :: rest) paths = case lookupPair (miNameOf m) paths of
  Just path => do
    unchanged <- sourceInfoUnchanged path (miSourceOf m)
    if unchanged then allModuleSourcesValid rest paths else pure False
  Nothing => pure False

-- mtime 秒精度的安全窗：`prim_eff_fileMtime` 只有秒级分辨率，同秒内改内容且大小不变的编辑
-- 用 mtime+size 不可分辨。mtime 距当前不足该窗口的文件一律回落内容哈希（近期编辑不走
-- 快路径）；窗口外可安全信任 mtime+size（写侧记录的是当时的内容哈希，记录后至少过了
-- 窗口才可能被信任）。窗口同样用于工具链会话的 `sourceFresh`。
mtimeSafetyWindowSec : Int
mtimeSafetyWindowSec = 5

sourceInfoUnchanged : String -> SourceInfo -> Eff [] Bool
sourceInfoUnchanged path si = do
  fast <- mtimeFastPath
  if fast then do
    m <- prim_eff_fileMtime path
    sz <- prim_eff_fileSize path
    if m == siMtimeOf si && sz == siSizeOf si then do
      now <- toolNowSec
      if m + mtimeSafetyWindowSec < now then pure True
      else do
        content <- prim_eff_readFile path
        pure (payloadDigest content == siHashOf si)
    else do
      content <- prim_eff_readFile path
      pure (payloadDigest content == siHashOf si)
  else do
    content <- prim_eff_readFile path
    pure (payloadDigest content == siHashOf si)

-- 可选快路径（默认关闭；`VUNA_CACHE_MTIME=1` 打开）：mtime + size 相同且 mtime 落在安全窗
-- 外即跳过读文件算哈希。实测缓存命中路径收益 <1%（check/build 的缓存 key 本来就要读全部
-- 源文件算哈希），未达默认开启门槛（5%），见 docs/reference/cache.md。
-- 快路径默认关闭 ⇒ 正确性默认由内容哈希保证；打开后靠 mtimeSafetyWindowSec 兜住同秒编辑。
mtimeFastPath : Eff [] Bool
mtimeFastPath = do
  v <- prim_eff_getenv "VUNA_CACHE_MTIME"
  pure (v == "1")

-- 依赖接口哈希链：每个模块记录的 import 接口哈希必须等于当前闭包里同名模块的哈希。
-- 这是「依赖接口变化 ⇒ 依赖者失效」的判据（TTC 的 `importHashes`）。
depIfaceChainValid : List ModuleIface -> Bool
depIfaceChainValid ifaces =
  let
    tbl = map (\m => Pair (miNameOf m) (miIfaceHashOf m)) ifaces
  in depHashesAllOk tbl ifaces

depHashesAllOk : List (Pair String String) -> List ModuleIface -> Bool
depHashesAllOk tbl [] = True
depHashesAllOk tbl (m :: rest) = depHashListOk tbl (miDepHashesOf m) && depHashesAllOk tbl rest

depHashListOk : List (Pair String String) -> List (Pair String String) -> Bool
depHashListOk tbl [] = True
depHashListOk tbl ((Pair name h) :: rest) = if h == depMissingHash then depHashListOk tbl rest
else case lookupPair name tbl of
  -- 哨兵（写接口时依赖接口不可得）不参与链校验：那份接口随后会被判脏并按真实依赖重写
  -- （见 `hasMissingDep` 在 clean/write 判定里的使用）。
  Just h2 => h2 == h && depHashListOk tbl rest
  Nothing => False

-- M34.5（LSP/REPL）：把「本包依赖闭包的模块接口」暴露给工具链（不暴露内部实现）。
-- 无包上下文/依赖接口不全时返回 Nothing，调用方退回不带 ifaces 的旧路径。
depIfacesForCheck : PackageContext -> Eff [] (Maybe (List ModuleIface))
depIfacesForCheck ctx = depIfacesOf ctx

-- 工具链消费默认走接口：M34.6 起默认开启（`VUNA_IFACE_TOOL=0` 关闭做 A/B/排障）。
-- 一次性读全依赖闭包接口只用于旧调试入口；LSP/REPL 走下面的惰性闭包。
-- M34.5（S7）：工具链**按需**读依赖接口。
-- manifest 已携带每模块的直接 import 名与依赖哈希：先只读 manifest（小）并按 entry 的
-- import 闭包算出需要哪些模块，再只 unmarshal 这些模块文件（不再一次读整包 N 个模块）。
-- 任一校验失败返回 Nothing，调用方回退全量（与旧行为一致，只是少读盘/少 unmarshal）。
toolDepManifests : PackageContext -> Eff [] (Maybe (List (Pair String PackageManifest)))
toolDepManifests ctx = case ctx.contextPackage of
  Nothing => pure Nothing
  Just pkg => do
    tag <- ifaceCompilerTag
    toolManifestsGo tag (contextRoots ctx)
      (secondOf (collectDepPackages [] pkg.packageDependencies)) []

toolManifestsGo : String -> List Root -> List Package -> List (Pair String PackageManifest) -> Eff [] (Maybe (List (Pair String PackageManifest)))
toolManifestsGo tag roots [] acc = pure (Just (reverse acc))
toolManifestsGo tag roots (p :: rest) acc = do
  dir <- depIfaceDirOf p
  mf <- readManifest dir tag
  case mf of
    Nothing => do
      let
        _ = note "iface-reject=tool-manifest-miss iface-tool-manifest-miss ${packageName p}"
      in do
        pure Nothing
    Just m => if pmSchemaOf m == ifaceSchema && pmCompilerOf m == tag && pmPackageOf m == packageName p then do
      env <- packageEnvHash (packageContext p)
      valid <- if pmEnvOf m == env then manifestSourcesValid roots p m else pure False
      if valid then toolManifestsGo tag roots rest (Pair dir m :: acc)
      else do
        let
          _ = note "iface-reject=tool-manifest-invalid iface-tool-manifest-invalid ${packageName p}"
        in do
          pure Nothing
    else do
      let
        _ = note "iface-reject=tool-manifest-invalid iface-tool-manifest-invalid ${packageName p}"
      in do
        pure Nothing

-- manifest 级来源校验：与 `depIfaceSourcesValid` 同判据，但只吃 manifest（不必读模块文件）。
manifestSourcesValid : List Root -> Package -> PackageManifest -> Eff [] Bool
manifestSourcesValid roots p mf = do
  let
    pkgRoots = filter (\r => rootName r == packageName p) roots
  in do
    walked <- sourcePathMapOfRoots pkgRoots
    allEntriesValid (pmModulesOf mf) walked

allEntriesValid : List ManifestEntry -> List (Pair String String) -> Eff [] Bool
allEntriesValid [] _ = pure True
allEntriesValid (e :: rest) paths = case lookupPair (meNameOfEntry e) paths of
  Just path => do
    unchanged <- sourceInfoUnchanged path (meSourceOfEntry e)
    if unchanged then allEntriesValid rest paths else pure False
  Nothing => pure False

toolEntryTable : List (Pair String PackageManifest) -> List (Pair String (Pair String ManifestEntry))
toolEntryTable [] = []
toolEntryTable ((Pair dir mf) :: rest) =
  append (map (\e => Pair (meNameOfEntry e) (Pair dir e)) (pmModulesOf mf)) (toolEntryTable rest)

toolFindEntry : List (Pair String (Pair String ManifestEntry)) -> String -> Maybe (Pair String (Pair String ManifestEntry))
toolFindEntry [] _ = Nothing
toolFindEntry (p :: rest) name = if firstOf p == name then Just p else toolFindEntry rest name

-- entry import 闭包：沿 manifest 的 meImports + meDeps 传递扩展（不读模块文件）。
toolClosure : List (Pair String (Pair String ManifestEntry)) -> List String -> List String
toolClosure table starts = toolClosureGo 8192 table [] starts

toolClosureGo : Int -> List (Pair String (Pair String ManifestEntry)) -> List String -> List String -> List String
toolClosureGo fuel table visited [] = visited
toolClosureGo fuel table visited (n :: rest) = if fuel <= 0 then visited
else if memName n visited then toolClosureGo fuel table visited rest
else case toolFindEntry table n of
  Nothing => toolClosureGo (fuel - 1) table (n :: visited) rest
  Just p =>
    let
      e = secondOf (secondOf p)
    in toolClosureGo (fuel - 1) table (n :: visited)
      (append rest (append (meImportsOfEntry e) (map firstOf (meDepsOfEntry e))))

toolReadIfaces : List (Pair String (Pair String ManifestEntry)) -> List String -> Eff [] (Maybe (List ModuleIface))
toolReadIfaces table needed = do
  tag <- ifaceCompilerTag
  toolReadIfacesGo tag table needed []

toolReadIfacesGo : String -> List (Pair String (Pair String ManifestEntry)) -> List String -> List ModuleIface -> Eff [] (Maybe (List ModuleIface))
toolReadIfacesGo tag [] _ acc = pure (Just (reverse acc))
toolReadIfacesGo tag (p :: rest) needed acc = if memName (firstOf p) needed then
  let
    d = secondOf p
    dir = firstOf d
    e = secondOf d
  in do
    m <- readModuleFile dir tag e
    case m of
      Just mi => toolReadIfacesGo tag rest needed (mi :: acc)
      Nothing => pure Nothing
else toolReadIfacesGo tag rest needed acc

-- 依赖接口哈希链（只针对读到的子集；闭包已沿 deps 扩到全部被引用模块）。
toolChainValid : List ModuleIface -> Bool
toolChainValid ifaces =
  let
    tbl = map (\m => Pair (miNameOf m) (miIfaceHashOf m)) ifaces
  in depHashesAllOk tbl ifaces

importNameStr : Import -> String
importNameStr (Import n alias q sp) = n

toolImportsOfSource : PackageContext -> String -> String -> Eff [] (List String)
toolImportsOfSource ctx label source = do
  parsed <- parseFileWithPath label source
  case parsed of
    ErrC _ => pure []
    OkC (SourceFile hdr imports fixities decls) => case hdr of
      Just (ModDecl dname _ _ _) => toolImportNamesOf ctx dname imports
      Nothing => toolImportNamesOf ctx "" imports

toolImportNamesOf : PackageContext -> String -> List Import -> Eff [] (List String)
toolImportNamesOf ctx current imports = do
  implicitR <- implicitPrelude (contextRoots ctx) (contextPackageName ctx) current imports
  pure (case implicitR of
    ErrC _ => map importNameStr imports
    OkC implicit => map importNameStr (append imports implicit)
  )

-- 工具链消费：默认按源码 import 闭包按需读依赖接口；`VUNA_IFACE_TOOL=0` 关闭（排障/A-B）。
-- M34.6：闭包必须含**同包模块的 import**——entry 直接 import 的模块可能再由同包模块
-- import 别的依赖包模块；只沿 entry imports 展开会漏掉这些依赖模块（Loader 从源码加载
-- 它们却没有 artifact 注入 ⇒ 假 `TC_UnknownName`）。同包模块名/import 从本包 manifest 取
-- （`check`/`build` 会写）；没有本包 manifest 或闭包仍不完整时，`Dt` 侧安全阀回退全量。
toolEnabled : Eff [] Bool
toolEnabled = do
  v <- prim_eff_getenv "VUNA_IFACE_TOOL"
  pure (v /= "0")

toolOwnManifest : PackageContext -> Eff [] (Maybe PackageManifest)
toolOwnManifest ctx = if contextPackageName ctx == "" then pure Nothing
else do
  dir <- ifaceDirOf ctx
  tag <- ifaceCompilerTag
  mf <- readManifest dir tag
  case mf of
    Just m => if pmSchemaOf m == ifaceSchema && pmCompilerOf m == tag && pmPackageOf m == contextPackageName ctx then do
      env <- packageEnvHash ctx
      pure (if pmEnvOf m == env then Just m else Nothing)
    else pure Nothing
    Nothing => pure Nothing

-- 本包 manifest 条目（目录 → 条目表）；目录由调用方在 Eff 上下文取好后传入。
ownEntriesOf : String -> PackageManifest -> List (Pair String (Pair String ManifestEntry))
ownEntriesOf dir mf = map (\e => Pair (meNameOfEntry e) (Pair dir e)) (pmModulesOf mf)

depIfacesForToolSource : PackageContext -> String -> String -> Eff [] (Maybe (List ModuleIface))
depIfacesForToolSource ctx label source = do
  enabled <- toolEnabled
  if enabled then do
    mans <- toolDepManifests ctx
    case mans of
      Nothing => pure Nothing
      Just mans2 => do
        ownMf <- toolOwnManifest ctx
        case ownMf of
          Nothing => pure Nothing
          Just ownManifest => do
            ownDir <- ifaceDirOf ctx
            importsOfSource <- toolImportsOfSource ctx label source
            let
              ownNames = map meNameOfEntry (pmModulesOf ownManifest)
              table = append (toolEntryTable mans2) (ownEntriesOf ownDir ownManifest)
              needed = toolClosure table importsOfSource
              -- 同包模块从源码加载（不是接口），只有依赖包模块需要读接口。
              depNeeded = filter (\n => memName n ownNames == False) needed
            in do
              ifaces <- toolReadIfaces (toolEntryTable mans2) depNeeded
              case ifaces of
                Nothing => pure Nothing
                Just ifs => if toolChainValid ifs then do
                  let
                    _ = note "iface-tool-lazy modules=${length ifs}"
                  in do
                    pure (Just ifs)
                else do
                  let
                    _ = note "iface-reject=tool-chain modules=${length ifs}"
                  in do
                    pure Nothing
  else pure Nothing

-- REPL：program 是「imports + 定义」的源码，闭包同样从它的 import 算。
depIfacesForToolProgram : PackageContext -> String -> Eff [] (Maybe (List ModuleIface))
depIfacesForToolProgram ctx program = depIfacesForToolSource ctx "<repl>" program

depIfacesForTool : PackageContext -> Eff [] (Maybe (List ModuleIface))
depIfacesForTool ctx = do
  enabled <- toolEnabled
  if enabled then depIfacesOf ctx else pure Nothing

-- M44：base-only 上下文（无 manifest 的单文件夹具）的依赖接口 = base 包的模块接口。
-- `depIfacesOf` 需要 `ctx.contextPackage`（有 manifest 才有），单文件夹具拿不到；
-- 这里直接读 roots 里 base 包的接口，供会话化工具（test runner 等）注入。
-- 接口缺失 / schema / 编译器 tag 不符 ⇒ Nothing（调用方回退全量精化）。
baseDepIfacesOf : PackageContext -> Eff [] (Maybe (List ModuleIface))
baseDepIfacesOf ctx = case ctx.contextPackage of
  Just _ => pure Nothing
  Nothing => case contextRoots ctx of
    [] => pure Nothing
    r :: _ => do
      tag <- ifaceCompilerTag
      baseIface <- ifaceBaseOf r.rootDir
      pi <- readPackageIface baseIface tag
      case pi of
        Nothing => pure Nothing
        Just p =>
          if p.piSchema == ifaceSchemaTag && p.piCompiler == tag then pure (Just p.piModules)
          else pure Nothing

-- ---------------------------------------------------------------
-- M34.6（5a/5c）：工具链（LSP / REPL）会话上下文
--
-- 一次工具请求需要的「依赖包接口 + 依赖接口哈希表 + 本包 manifest + 本次 buffer 的 import
-- 闭包 + 校验面」。全部由 manifest（小文件）算出来，模块接口按闭包惰性读；会话层把它按
-- 「编译器指纹 + 包名 + manifest 内容 + 闭包源文件 stat」缓存，失效时重建。
-- ---------------------------------------------------------------
-- `tcDepIfaces`：import 闭包里需要的依赖包模块接口（惰性读取的子集）；
-- `tcDepHashes`：依赖闭包**全部**模块的接口哈希（来自 manifest，不读模块文件；写本包接口
-- 时填 `miDepHashes` 用）；
-- `tcOwnManifest`：本包 manifest（干净同包模块 / 单模块写回的合并基）；
-- `tcNeeded`：本次 buffer 的 import 闭包（含本包模块名）——buffer 引入新依赖时据此失效；
-- `tcStats`：校验面（依赖/本包模块源文件 + manifest 文件的 (路径, 内容哈希, mtime, size)）；
-- `tcDepTable`：依赖模块名 → (接口目录, manifest 条目)，buffer 改 import 时重算闭包用；
-- `tcOwnDir`：本包接口目录（建会话时在 Eff 上取好；`toolNeededOfImports` 仍是纯函数）。
record ToolContext where
  tcDepIfaces : List ModuleIface
  tcDepHashes : List (Pair String String)
  tcOwnManifest : Maybe PackageManifest
  tcNeeded : List String
  tcStats : List SourceInfo
  tcDepTable : List (Pair String (Pair String ManifestEntry))
  tcOwnDir : String

-- 依赖 manifest 的条目 → 接口哈希表（不读模块文件）。
manifestHashTable : List (Pair String PackageManifest) -> List (Pair String String)
manifestHashTable mans = concatMap tableOfManifest mans

tableOfManifest : Pair String PackageManifest -> List (Pair String String)
tableOfManifest (Pair dir mf) =
  map (\e => Pair (meNameOfEntry e) (meIfaceHashOfEntry e)) (pmModulesOf mf)

-- 会话校验面：每个模块条目的 SourceInfo + manifest 文件本身。
statsOfManifest : Pair String PackageManifest -> Eff [] (List SourceInfo)
statsOfManifest (Pair dir mf) = do
  mfInfo <- sourceInfoForPath (manifestPathOf dir)
  pure (append (map meSourceOfEntry (pmModulesOf mf)) [mfInfo])

-- 内容哈希（与缓存 key / 接口源信息同一函数）：工具链侧比较 buffer 与磁盘内容用。
toolTextHash : String -> String
toolTextHash = payloadDigest

sourceInfoForPath : String -> Eff [] SourceInfo
sourceInfoForPath path = do
  raw <- prim_eff_readFile path
  mtime <- prim_eff_fileMtime path
  size <- prim_eff_fileSize path
  pure (SourceInfo path (payloadDigest raw) mtime size)

toolNowSec : Eff [] Int
toolNowSec = do
  us <- effTimeUs
  pure (us / 1000000)

-- 校验：文件还在，且（mtime+size 快路径）或（内容哈希）与记录一致。
-- 安全窗与 `sourceInfoUnchanged` 同一个（`mtimeSafetyWindowSec`）：记录的 mtime 距会话建立
-- 不足窗口时，同秒内同大小编辑不可分辨 ⇒ 回读哈希。
sourceFresh : Int -> SourceInfo -> Eff [] Bool
sourceFresh builtSec si = do
  let
    path = siPathOf si
  in do
    exists <- prim_eff_fileExists path
    if exists == False then pure False
    else do
      m <- prim_eff_fileMtime path
      sz <- prim_eff_fileSize path
      if m == siMtimeOf si && sz == siSizeOf si && siMtimeOf si + mtimeSafetyWindowSec <= builtSec then pure True
      else do
        content <- prim_eff_readFile path
        pure (payloadDigest content == siHashOf si)

toolSessionFresh : Int -> List SourceInfo -> Eff [] Bool
toolSessionFresh builtSec [] = pure True
toolSessionFresh builtSec (si :: rest) = do
  fresh <- sourceFresh builtSec si
  if fresh then toolSessionFresh builtSec rest else pure False

-- 本包 manifest 条目 + 依赖 manifest 条目 → 闭包计算用的表。
toolContextTable : PackageContext -> ToolContext -> List (Pair String (Pair String ManifestEntry))
toolContextTable ctx tool =
  let
    ownTable = case tool.tcOwnManifest of
      Just mf => ownEntriesOf tool.tcOwnDir mf
      Nothing => []
  in append tool.tcDepTable ownTable

-- import 名 → 闭包（含同包 manifest 里的模块）；buffer 每次变化都按当前 imports 重算。
toolNeededOfImports : PackageContext -> ToolContext -> String -> List Import -> Eff [] (List String)
toolNeededOfImports ctx tool currentName imports = do
  importNames <- toolImportNamesOf ctx currentName imports
  pure (toolClosure (toolContextTable ctx tool) importNames)

-- 惰性工具接口 + 会话上下文（M34.6 5a）：与 `depIfacesForToolSource` 同一套校验，
-- 额外返回依赖哈希表 / 本包 manifest / 闭包 / 校验面。
depIfacesForToolSourceDetailed : PackageContext -> String -> String -> Eff [] (Maybe ToolContext)
depIfacesForToolSourceDetailed ctx label source = do
  enabled <- toolEnabled
  if enabled then do
    mans <- toolDepManifests ctx
    case mans of
      Nothing => pure Nothing
      Just mans2 => do
        ownMf <- toolOwnManifest ctx
        case ownMf of
          Nothing => pure Nothing
          Just ownManifest => do
            ownDir <- ifaceDirOf ctx
            importsOfSource <- toolImportsOfSource ctx label source
            let
              ownNames = map meNameOfEntry (pmModulesOf ownManifest)
              table = append (toolEntryTable mans2) (ownEntriesOf ownDir ownManifest)
              needed = toolClosure table importsOfSource
              depNeeded = filter (\n => memName n ownNames == False) needed
            in do
              toolStats <- concatMapEff statsOfManifest mans2
              ownStats <- statsOfManifest (Pair ownDir ownManifest)
              ifaces <- toolReadIfaces (toolEntryTable mans2) depNeeded
              case ifaces of
                Nothing => pure Nothing
                Just ifs => if toolChainValid ifs then do
                  let
                    _ = note "iface-tool-lazy modules=${length ifs}"
                  in do
                    pure
                      (Just (ToolContext ifs (manifestHashTable mans2) (Just ownManifest) needed (append toolStats ownStats) (toolEntryTable mans2) ownDir))
                else do
                  let
                    _ = note "iface-reject=tool-chain modules=${length ifs}"
                  in do
                    pure Nothing
  else pure Nothing

-- 本包干净模块（M34.6 5a/5c）：manifest 条目里「源内容未变 + 依赖哈希链仍成立」的模块。
-- 只读 `needed` 里的模块接口文件（闭包子集）；`exclude` 是当前正在编辑的模块名（buffer
-- 可能与磁盘不同，不能复用它的 iface）。
toolCleanOwnModules : PackageContext -> ToolContext -> Int -> Maybe String -> List String -> Eff [] (List ModuleIface)
toolCleanOwnModules ctx tool builtSec exclude needed = case tool.tcOwnManifest of
  Nothing => pure []
  Just mf => do
    dir <- ifaceDirOf ctx
    tag <- ifaceCompilerTag
    cands <-
      mapMaybeEff (\e => readModuleFile dir tag e)
        (filterOwnEntries needed exclude (pmModulesOf mf))
    toolCleanGo builtSec tool.tcDepHashes cands []

filterOwnEntries : List String -> Maybe String -> List ManifestEntry -> List ManifestEntry
filterOwnEntries needed exclude [] = []
filterOwnEntries needed exclude (e :: rest) =
  let
    keep = memName (meNameOfEntry e) needed && (case exclude of
      Just x => meNameOfEntry e /= x
      Nothing => True
    )
  in if keep then e :: filterOwnEntries needed exclude rest else filterOwnEntries needed exclude rest

toolCleanGo : Int -> List (Pair String String) -> List ModuleIface -> List ModuleIface -> Eff [] (List ModuleIface)
toolCleanGo builtSec depTbl [] cleanRev = pure (reverse cleanRev)
toolCleanGo builtSec depTbl (m :: rest) cleanRev = do
  selfOk <- payloadSelfOk m
  let
    _ = if selfOk then 0 else note "iface-reject=self-hash ${miNameOf m}"
  in do
    fresh <- sourceFresh builtSec (miSourceOf m)
    if fresh && cachedProgramValid (miCachedOf m) && selfOk && not (hasMissingDep (miDepHashesOf m)) && moduleDepsOk depTbl cleanRev (miDepHashesOf m) then toolCleanGo builtSec depTbl rest (m :: cleanRev)
    else toolCleanGo builtSec depTbl rest cleanRev

-- 单模块接口写回（M34.6 5a）：LSP 每次成功请求后只写「当前模块」的接口（合并进本包
-- manifest，保留其他条目）。语义与整包 ifaceOfPackage 一致（见 `Iface.ifaceOfModule`）；
-- 有缺口/其他脏模块时返回 Err，调用方静默跳过（不影响诊断）。
toolWriteModuleIface : PackageContext -> ToolContext -> List ModuleIface -> CheckedPackage -> String -> SourceInfo -> Eff [] (Check ModuleIface)
toolWriteModuleIface ctx tool clean checked name si = do
  let
    miResult =
      ifaceOfModule (contextPackageName ctx) si tool.tcDepHashes checked.checkedInherited clean
        checked.checkedModules checked.checkedEntryDecls checked.checkedProgram name
  in do
    case miResult of
      ErrC e => pure (ErrC e)
      OkC mi => do
        _ <- writeModuleIfaceGuarded ctx mi
        pure (OkC mi)

-- | 单模块写回的只读写降级：失败静默跳过（诊断/会话缓存不受影响）。
writeModuleIfaceGuarded : PackageContext -> ModuleIface -> Eff [] Int
writeModuleIfaceGuarded ctx mi = if contextPackageName ctx == "" then pure 0
else do
  dir <- ifaceDirOf ctx
  let
    pkgDir = contextDir ctx
  in do
    filesOk <- ifaceFilesOk pkgDir [mi]
    if not filesOk then pure 0
    else do
      ready <- ifaceWriteReady dir pkgDir [mi]
      if not ready then do
        let
          _ = note "iface-reject=readonly iface-skip readonly ${dir}"
        in do
          pure 0
      else withIfaceLock ctx (\_ => do
        tag <- ifaceCompilerTag
        env <- packageEnvHash ctx
        writeModuleIfaceMerge dir tag (contextPackageName ctx) pkgDir env "tool" mi
      )

-- 冷启动（没有工具会话 / 本包还没有 manifest）：依赖哈希从磁盘接口汇总，干净模块按
-- 现有判定重算；能写就写（LSP-only 会话逐步变热），失败不影响诊断。
toolWriteModuleIfaceCold : PackageContext -> CheckedPackage -> String -> SourceInfo -> Eff [] (Check ModuleIface)
toolWriteModuleIfaceCold ctx checked name si = do
  clean <- cleanIfacesOrEmpty ctx
  depTbl <- depIfaceHashTable ctx
  let
    miResult =
      ifaceOfModule (contextPackageName ctx) si depTbl checked.checkedInherited clean
        checked.checkedModules checked.checkedEntryDecls checked.checkedProgram name
  in do
    case miResult of
      ErrC e => pure (ErrC e)
      OkC mi => do
        _ <- writeModuleIfaceGuarded ctx mi
        pure (OkC mi)

-- LSP 写回守卫：本包 manifest 是否已存在（冷启动写回只在没有 manifest 时做，
-- 避免把「工具接口暂时不可用」的会话写进去污染依赖哈希链）。
toolHasOwnManifest : PackageContext -> Eff [] Bool
toolHasOwnManifest ctx = do
  mf <- toolOwnManifest ctx
  pure (case mf of
    Just _ => True
    Nothing => False
  )

-- 本包 manifest 里某模块记录的源内容哈希（判断「磁盘内容已检查过」⇒ 不必重写接口）。
toolOwnEntrySourceHash : ToolContext -> String -> Maybe String
toolOwnEntrySourceHash tool name = case tool.tcOwnManifest of
  Just mf => entryHashOfEntries (pmModulesOf mf) name
  Nothing => Nothing

entryHashOfEntries : List ManifestEntry -> String -> Maybe String
entryHashOfEntries [] name = Nothing
entryHashOfEntries (e :: rest) name =
  if meNameOfEntry e == name then Just (siHashOf (meSourceOfEntry e))
  else entryHashOfEntries rest name

toolCompilerFingerprint : Eff [] Int
toolCompilerFingerprint = compilerFingerprint

-- | 包级 check 的图入口（阶段 2）：命中判定（`Driver.Graph` + `Query`）→ 未命中则跑
-- 现有精化路径 → 成功后提交节点并落会话索引。
--
-- 命中时**完全跳过**精化（与旧 `check/` marker 目录等价）；`-W` / `--deny-warnings`
-- （warning 不持久化）、`VUNA_ELAB_FULL=1`（强制全量）、`VUNA_IFACE_AUDIT=1`（双路径
-- 对拍）都直接绕过图（既不判命中也不提交），保持各自的既有语义。
checkViaGraph : PackageContext -> CheckMods -> Eff [] (Check (List Diagnostic)) -> Eff [] (Check (List Diagnostic))
checkViaGraph ctx mods run = do
  full <- elabFullRequested
  audit <- ifaceAuditRequested
  if full || audit then run
  else
    let
      opts = graphRunOpts (contextPackageName ctx)
      key = checkNodeKey mods
    in do
      db0 <- sessionLoad opts
      case graphHit db0 key mods of
        Just _ => do
          _ <- pure (note "query-hit ${key}")
          pure (OkC [])
        Nothing => do
          _ <- pure (note "query-miss ${key}")
          r <- run
          case r of
            ErrC e => pure (ErrC e)
            OkC ds => do
              db1 <- pure (graphCommit (graphNote db0 "query-commit" key) key mods)
              _ <- sessionSave opts db1
              _ <- pure (note "query-commit ${key}")
              pure (OkC ds)

checkCachedExe : Bool -> PackageContext -> String -> Eff [] (Check (List Diagnostic))
checkCachedExe wantWarnings ctx entry = do
  mods <- checkModsExe ctx entry
  if wantWarnings then checkUncachedExe wantWarnings ctx entry
  else checkViaGraph ctx mods (checkUncachedExe wantWarnings ctx entry)

-- 缓存未命中时的精化入口：默认「依赖接口摘要齐全 ⇒ 摘要路径，否则全量」。
-- 摘要路径返回 `Err` 时**直接上报**（不回退——回退会吞掉本包真实错误）。
-- `VUNA_ELAB_FULL=1` 强制全量：排障/A-B 对拍用（测试里对两份诊断逐字节比较）。
checkUncachedExe : Bool -> PackageContext -> String -> Eff [] (Check (List Diagnostic))
checkUncachedExe wantWarnings ctx entry = do
  full <- elabFullRequested
  if full then fullCheckExe ctx entry
  else do
    audit <- ifaceAuditRequested
    if audit then auditCheckExe wantWarnings ctx entry
    else do
      summary <- summaryCheckExeParts wantWarnings ctx entry
      checkAndShadow ctx (pure summary)

-- 摘要路径（**不落盘**）：接口不可用 ⇒ 全量（与旧行为一致，只是不再直接写缓存）。
-- wantWarnings 时 clean 列表清空 ⇒ 本包模块全部重算（warning 不在缓存里）。
summaryCheckExeParts : Bool -> PackageContext -> String -> Eff [] (Check (Pair (List Diagnostic) CheckedPackage))
summaryCheckExeParts wantWarnings ctx entry = do
  depIfaces <- depIfacesOf ctx
  case depIfaces of
    Nothing => do
      let
        _ = note "cache-path=full"
      in do
        dtCheckWithProgramParts ctx entry
    Just ifaces => do
      depTbl <- depIfaceHashTable ctx
      clean <- ownCleanModules ctx depTbl
      case clean of
        Just clean2 => do
          let
            cleanReal = if wantWarnings then [] else clean2
            _ = note "cache-path=summary deps=${depPackageCount ctx}"
            _ = note "cache-own-clean=${length cleanReal}"
          in do
            dtCheckPackageIncrementalParts ctx entry ifaces cleanReal
        Nothing => do
          let
            _ = note "cache-path=summary deps=${depPackageCount ctx}"
          in do
            dtCheckPackageWithIfacesParts ctx entry ifaces

fullCheckExe : PackageContext -> String -> Eff [] (Check (List Diagnostic))
fullCheckExe ctx entry =
  let
    _ = note "cache-path=full"
  in checkAndShadow ctx (dtCheckWithProgramParts ctx entry)

-- 审计（`VUNA_IFACE_AUDIT=1`）：摘要路径 vs 全量路径的诊断逐字节对拍。一致才按摘要结果
-- 落盘；不一致报 `iface-audit-mismatch` 并**不写缓存/接口**。
auditCheckExe : Bool -> PackageContext -> String -> Eff [] (Check (List Diagnostic))
auditCheckExe wantWarnings ctx entry = do
  summary <- summaryCheckExeParts wantWarnings ctx entry
  full <- dtCheckWithProgramParts ctx entry
  let
    _ = note "iface-audit subject=check entry=${entry}"
  in do
    compared <- pure (auditCompare "check" entry (checkSignatureOf summary) (checkSignatureOf full))
    case compared of
      ErrC e => pure (ErrC e)
      OkC _ => checkAndShadow ctx (pure summary)

-- `VUNA_ELAB_FULL=1`：强制全量精化（接口摘要路径的排障开关；默认关闭）。
elabFullRequested : Eff [] Bool
elabFullRequested = do
  v <- prim_eff_getenv "VUNA_ELAB_FULL"
  pure (v == "1")

-- `VUNA_IFACE_AUDIT=1`：排障/CI 开关——摘要路径与全量路径在同一进程各跑一次并逐字节比较
-- 诊断/产物；不一致即失败且不写缓存。默认关闭（双倍精化，不适合热路径）。
ifaceAuditRequested : Eff [] Bool
ifaceAuditRequested = do
  v <- prim_eff_getenv "VUNA_IFACE_AUDIT"
  pure (v == "1")

-- 诊断签名：`Ok`/`Err` 都参与比较（顺序敏感，逐字节）。
-- 直接按构造子在 clause 头分派（dispatch-lift），避免再嵌一层 case。
-- warning 不参与签名：摘要路径在 `wantWarnings=false` 时会复用干净模块（不重算 warning），
-- 全量路径会全算，二者在 warning 上不可比（warning 不进缓存，见 M45）。
checkSignatureOf : Check (Pair (List Diagnostic) CheckedPackage) -> String
checkSignatureOf (OkC _) = "ok\n"
checkSignatureOf (ErrC e) = "err\n${diagText e}"

splitSignatureOf : Check (Pair (List SplitFile) CheckedPackage) -> String
-- 审计签名：只用于「摘要路径与全量路径产物是否一致」的比较，不进缓存。
-- 用规范编码（C32：不再 `prim_marshal`）——同一 SplitFile 列表编码逐字节稳定。
splitSignatureOf (OkC p) = "ok\n" ++ encTop encSplitFiles (firstOf p)
splitSignatureOf (ErrC e) = "err\n${diagText e}"

joinLines : List String -> String
joinLines [] = ""
joinLines (x :: rest) = if rest == [] then x else "${x}\n${joinLines rest}"

-- 不一致时只报签名指纹与长度（诊断可能很长，整段回显会把终端淹掉）；
-- `subject`/`at` 给出入口与位置，便于定位。
auditCompare : String -> String -> String -> String -> Check Int
auditCompare subject at s f =
  if s == f then OkC 0
  else err
    "iface-audit-mismatch subject=${subject} at=${at} summary=${textHash s}/${strLength s} full=${textHash f}/${strLength f}"

depIfaceHashTable : PackageContext -> Eff [] (List (Pair String String))
depIfaceHashTable ctx = case ctx.contextPackage of
  Nothing => pure []
  Just pkg => concatMapEff hashTableOf (secondOf (collectDepPackages [] pkg.packageDependencies))

hashTableOf : Package -> Eff [] (List (Pair String String))
hashTableOf dep = do
  pi <- depIfaceOf dep
  pure (case pi of
    Just p => map (\m => Pair (miNameOf m) (miIfaceHashOf m)) p.piModules
    Nothing => []
  )

-- 包级环境指纹（manifest `pmEnv`）：自身 `vuna.toml` 内容 + 传递依赖（名字 / 规范化目录 /
-- 各自 toml 内容）+ 编译器标签。`[capabilities]` / `[trust]` / `[dependencies]` / flags
-- 都可能改变语义，但都不在模块源文件哈希里，必须单独构成失效判据（§44o）。
packageEnvHash : PackageContext -> Eff [] Int
packageEnvHash ctx = do
  toml <- prim_eff_readFile "${contextDir ctx}/vuna.toml"
  let
    own = textHash toml
    deps = case ctx.contextPackage of
      Nothing => []
      Just pkg => secondOf (collectDepPackages [] pkg.packageDependencies)
  in do
    depTexts <- mapEff depEnvText deps
    tag <- ifaceCompilerTag
    pure (textHash "${own}|${tag}|${joinLines depTexts}")

-- 依赖包在环境指纹里的投影：包名 + 规范化绝对目录 + 它自己的 toml 内容哈希。
-- 目录也参与：同名包换到另一棵树（worktree / 副本）必须整包判脏，不能共享接口。
depEnvText : Package -> Eff [] String
depEnvText dep = do
  abs <- absolutePath (packageDir dep)
  let
    dir = normalizeDir abs
  in do
    toml <- prim_eff_readFile "${dir}/vuna.toml"
    pure "${packageName dep}|${dir}|${textHash toml}"

-- ---------------------------------------------------------------
-- M34.5（S4）：包内逐模块增量的脏/净判定
--
-- 保守规则：模块干净 ⇔ 源内容哈希未变 ∧ 闭合产物有效 ∧ 它记录的直接依赖接口哈希全部
-- 仍然成立。依赖哈希来自：外部依赖包（当前接口表）或**同包已判定干净的模块**（旧接口
-- 哈希未变）。同包依赖若是脏模块或新模块，则本模块也判脏（接口哈希可能变），不做乐观
-- 复用；脏性沿 import 边自然传播（干净表里查不到 ⇒ 脏）。
-- ---------------------------------------------------------------
-- 与 `ownCleanModules` 同一次读取，同时回报「旧整包接口是否可完整读回」（写侧信任旧
-- manifest 做按模块跳过的前提）：check/build 的写前校验已经解码过整包接口，写回时复用
-- 这次结果，不再把同样的 65 个模块文件读 + unmarshal 第二遍。
ownCleanInfo : PackageContext -> List (Pair String String) -> Eff [] (Pair Bool (Maybe (List ModuleIface)))
ownCleanInfo ctx depTbl = do
  dir <- ifaceDirOf ctx
  tag <- ifaceCompilerTag
  pi <- readPackageIface dir tag
  case pi of
    Nothing => pure (Pair False Nothing)
    Just p => if p.piSchema /= ifaceSchemaTag || p.piCompiler /= tag || p.piPackage /= contextPackageName ctx then pure (Pair True Nothing)
    else do
      env <- packageEnvHash ctx
      if p.piEnv /= env then do
        let
          _ = note "iface-reject=own-env ${contextPackageName ctx}"
        in do
          pure (Pair True Nothing)
      else do
        origins <- ownOrigins ctx
        sources <- ownSourceInfos ctx
        clean <- cleanModulesGo origins sources depTbl p.piModules []
        pure (Pair True (if length (firstOf clean) == 0 then Nothing else Just (firstOf clean)))

ownCleanModules : PackageContext -> List (Pair String String) -> Eff [] (Maybe (List ModuleIface))
ownCleanModules ctx depTbl = do
  info <- ownCleanInfo ctx depTbl
  pure (secondOf info)

-- 工具路径（LSP 冷启动写单模块接口）复用的干净模块：记录原样写回，避免用增量路径缺失的
-- 整包 sols 重算导致擦除位残 meta 的 zonk 结果漂移。命令行 check/build 走
-- writeIfaceShadow 的同一次 `ownCleanInfo` 读取，不经过这里。
cleanIfacesOrEmpty : PackageContext -> Eff [] (List ModuleIface)
cleanIfacesOrEmpty ctx = do
  depTbl <- depIfaceHashTable ctx
  clean <- ownCleanModules ctx depTbl
  pure (case clean of
    Just clean2 => clean2
    Nothing => []
  )

-- manifest 条目的产物来源表（模块名 → "pkg" / "tool"）。命令行 check/build 只信任
-- 整包产物：LSP/REPL 单模块写回的接口可能来自部分上下文，源哈希看不见它的漂移。
ownOrigins : PackageContext -> Eff [] (List (Pair String String))
ownOrigins ctx = do
  dir <- ifaceDirOf ctx
  tag <- ifaceCompilerTag
  mf <- readManifest dir tag
  pure (case mf of
    Just m => map (\e => Pair (meNameOfEntry e) (meOriginOfEntry e)) (pmModulesOf m)
    Nothing => []
  )

cleanModulesGo : List (Pair String String) -> List (Pair String SourceInfo) -> List (Pair String String) -> List ModuleIface -> List ModuleIface -> Eff [] (Pair (List ModuleIface) (List String))
cleanModulesGo origins sources depTbl [] cleanRev = pure (Pair (reverse cleanRev) [])
cleanModulesGo origins sources depTbl (m :: rest) cleanRev = do
  let
    pkgOrigin = case lookupPair (miNameOf m) origins of
      Just o => o == "pkg"
      Nothing => False
    _ = if pkgOrigin then 0 else note "iface-reject=tool-origin ${miNameOf m}"
    sameSource = case lookupPair (miNameOf m) sources of
      Just si => siHashOf si == siHashOf (miSourceOf m)
      Nothing => False
  in do
    selfOk <- payloadSelfOk m
    let
      _ = if selfOk then 0 else note "iface-reject=self-hash ${miNameOf m}"
      keep =
        pkgOrigin
          && sameSource
          && cachedProgramValid (miCachedOf m)
          && selfOk
          && not (hasMissingDep (miDepHashesOf m))
          && moduleDepsOk depTbl cleanRev (miDepHashesOf m)
    in do
      if keep then cleanModulesGo origins sources depTbl rest (m :: cleanRev)
      else cleanModulesGo origins sources depTbl rest cleanRev

-- 载荷自证（`VUNA_IFACE_SELFTEST=1`）：复用前用载荷重算哈希，与记录的 `miIfaceHash`
-- 比对。默认关闭——热路径只做 schema / 编译器指纹 / 环境指纹这些 O(1) 门；CI 打开
-- 后能抓住「载荷被改写但哈希字段没变」的接口。成本 O(payload)。
payloadSelfOk : ModuleIface -> Eff [] Bool
payloadSelfOk m = do
  self <- ifaceSelfTestRequested
  pure (if self then hashOfIface m == miIfaceHashOf m else True)

moduleDepsOk : List (Pair String String) -> List ModuleIface -> List (Pair String String) -> Bool
moduleDepsOk depTbl cleanRev [] = True
moduleDepsOk depTbl cleanRev ((Pair name h) :: rest) = if h == depMissingHash then moduleDepsOk depTbl cleanRev rest
else case lookupPair name depTbl of
  Just h2 => h2 == h && moduleDepsOk depTbl cleanRev rest
  Nothing => case cleanHashOf cleanRev name of
    Just h2 => h2 == h && moduleDepsOk depTbl cleanRev rest
    Nothing => False

cleanHashOf : List ModuleIface -> String -> Maybe String
cleanHashOf [] _ = Nothing
cleanHashOf (m :: rest) name =
  if miNameOf m == name then Just (miIfaceHashOf m) else cleanHashOf rest name

-- M34.5（S1/S2/S3）：接口摘要的**影子写**。整包 check / build 成功后按声明归属把 DtProgram
-- 切成每模块一份 `ModuleIface`，写成 per-module 接口文件 + 包级 manifest（S2 的依赖侧
-- 接口加载与失效判定读它）；写失败/归属缺口只打 note（不影响 check 结果），缺口存在时
-- **不写**（避免依赖方拿到不完整接口）。
ifaceSchemaTag : String
ifaceSchemaTag = ifaceSchema

ifaceCompilerTag : Eff [] String
ifaceCompilerTag = compilerTagEff

-- | iface 目录：默认与源码同布局（`<包目录>/lib/.../X.vuna` → 同目录 `X.iface`）；
-- `VUNA_IFACE_DIR` 非空时整体镜像到该根（`<根>/<包绝对目录>/lib/.../X.iface`），便于
-- 持久化/共享。相对值按进程 cwd 解析（启动时读取一次）。
ifaceRootOverride : Eff [] String
ifaceRootOverride = do
  v <- prim_eff_getenv "VUNA_IFACE_DIR"
  if v == "" then pure ""
  else do
    abs <- absolutePath v
    pure (normalizeDir abs)

-- | 去掉路径前导 "/"，用于把包绝对目录拼到镜像根下。
dropLeadingSlash : String -> String
dropLeadingSlash s = if startsWith "/" s then strSubstring 1 (strLength s - 1) s else s

-- | 某包目录对应的接口目录：默认 = `<包目录>/.output/iface/<编译器指纹>`——
-- 与 `.ml`/`.cmx`/`build.sh` 等构建产物同处（删产物即清缓存），并按编译器指纹分桶，
-- 让 seed / nix 产品二进制 / 本地构建产物各自命中自己的接口，不再互相失效
-- （此前默认写在源树里，三者交替使用时每次都退化为全量精化，5–7s）。
-- `VUNA_IFACE_DIR` 非空时整体镜像到该根（调用方负责分桶）。
ifaceBaseOf : String -> Eff [] String
ifaceBaseOf pkgDir = do
  root <- ifaceRootOverride
  if root == "" then do
    fp <- compilerFingerprint
    pure (normalizeDir "${pkgDir}/.output/iface/${strFromInt fp}")
  else do
    abs <- absolutePath pkgDir
    pure (normalizeDir "${root}/${dropLeadingSlash abs}")

ifaceDirOf : PackageContext -> Eff [] String
ifaceDirOf ctx = ifaceBaseOf (contextDir ctx)

-- | 接口写权限探测（默认布局写在源树里；Nix 构建的源树只读）。一次 `sh`：`mkdir -p` 建目录
-- （对已存在目录是 no-op）+ 逐目录 `test -w`；返回 True = 可写。失败只降级不写，绝不把
-- `prim_eff_writeFileAtomic` 的宿主异常漏给 check。
ifaceDirsWritable : List String -> Eff [] Bool
ifaceDirsWritable dirs = do
  let
    script = "mkdir -p \"$@\" && for d in \"$@\"; do test -w \"$d\" || exit 1; done"
  in do
    code <- prim_eff_runIn "." (append ["sh", "-c", script, "sh"] dirs)
    pure (code == 0)

-- | 写入前准备目录并确认可写：manifest 所在目录 + 每个接口文件的父目录。
ifaceWriteReady : String -> String -> List ModuleIface -> Eff [] Bool
ifaceWriteReady dir pkgDir modules = do
  parents <- mapEff (\m => do
    rel <- ifaceRelPathOf (miIfaceHashOf m) pkgDir (miSourceOf m)
    pure (parentOfPath (modulePathOf dir rel))
  ) modules
  ifaceDirsWritable (append [dir] parents)

-- | 写侧安全阀：任一模块算不出「相对包目录」的镜像路径 ⇒ 整包不写（不写坏 manifest）。
ifaceFilesOk : String -> List ModuleIface -> Eff [] Bool
ifaceFilesOk pkgDir [] = pure True
ifaceFilesOk pkgDir (m :: rest) = do
  rel <- ifaceRelPathOf (miIfaceHashOf m) pkgDir (miSourceOf m)
  if rel == "" then pure False else ifaceFilesOk pkgDir rest

-- ---------------------------------------------------------------
-- 写入锁（S8）：同一包的多进程写者（check / build / LSP / test）串行化。
-- `mkdir` 原子；60s 过期自动抢占（崩溃残留）；拿不到锁就跳过这次写入（只读降级，
-- 读侧照旧回退全量），不排队死等。
-- ---------------------------------------------------------------
ifaceLockPath : PackageContext -> Eff [] String
ifaceLockPath ctx = do
  base <- cacheBase
  pure "${base}/${hashText (textHash (contextPackageName ctx))}/iface.lock"

ifaceLockFresh : String -> Eff [] Bool
ifaceLockFresh path = do
  mtime <- prim_eff_fileMtime path
  now <- toolNowSec
  pure (mtime + 60 > now)

acquireIfaceLock : String -> Eff [] Bool
acquireIfaceLock path = do
  _ <- prim_eff_runIn "." ["mkdir", "-p", parentOfPath path]
  made <- prim_eff_runIn "." ["mkdir", path]
  if made == 0 then pure True
  else do
    fresh <- ifaceLockFresh path
    if fresh then pure False
    else do
      _ <- prim_eff_runIn "." ["rm", "-rf", path]
      code <- prim_eff_runIn "." ["mkdir", path]
      pure (code == 0)

releaseIfaceLock : String -> Eff [] Int
releaseIfaceLock path = prim_eff_runIn "." ["rm", "-rf", path]

withIfaceLock : PackageContext -> (Int -> Eff [] Int) -> Eff [] Int
withIfaceLock ctx f = do
  path <- ifaceLockPath ctx
  acquired <- acquireIfaceLock path
  if acquired then do
    r <- f 0
    _ <- releaseIfaceLock path
    pure r
  else do
    let
      _ = note "iface-reject=lock ${contextPackageName ctx}"
    in do
      pure 0

-- ---------------------------------------------------------------
-- 镜像模式孤儿清理：只删「本次 manifest 未引用」且 mtime 超过 60s 的 `.iface`。
-- 60s 窗口避开并发写者「先写内容文件、后写 manifest」的中间态。
-- ---------------------------------------------------------------
collectIfaceFiles : Int -> String -> Eff [] (List String)
collectIfaceFiles fuel dir = if fuel <= 0 then pure []
else do
  exists <- prim_eff_fileExists dir
  isDir <- if exists then prim_eff_isDirectory dir else pure False
  if exists && isDir then do
    names <- prim_eff_readDir dir
    concatMapEff (walkIfaceFiles (fuel - 1) dir) names
  else pure []

walkIfaceFiles : Int -> String -> String -> Eff [] (List String)
walkIfaceFiles fuel dir name = if fuel <= 0 then pure []
else if name == "." || name == ".." then pure []
else do
  let
    path = "${dir}/${name}"
  in do
    exists <- prim_eff_fileExists path
    isDir <- if exists then prim_eff_isDirectory path else pure False
    if exists && isDir then collectIfaceFiles (fuel - 1) path
    else if endsWith ".iface" name && not (startsWith ".vuna" name) then pure [path] else pure []

gcIfaceOrphans : String -> String -> List ModuleIface -> Eff [] Int
gcIfaceOrphans dir pkgDir modules = do
  keep <- mapEff (\m => do
    rel <- ifaceRelPathOf (miIfaceHashOf m) pkgDir (miSourceOf m)
    pure (modulePathOf dir rel)
  ) modules
  files <- collectIfaceFiles 1048576 dir
  gcIfaceGo keep files

gcIfaceGo : List String -> List String -> Eff [] Int
gcIfaceGo keep [] = pure 0
gcIfaceGo keep (p :: rest) = do
  let
    referenced = memName p keep
  in do
    mtime <- prim_eff_fileMtime p
    now <- toolNowSec
    let
      old = mtime + 60 < now
    in do
      if referenced || not old then gcIfaceGo keep rest
      else do
        removed <- prim_eff_removeFile p
        tail <- gcIfaceGo keep rest
        pure (removed + tail)

-- 本包各模块的源信息表（模块名 → 绝对路径 / 内容哈希 / mtime / size）。
--
-- 路径一律**绝对化**：`SourceInfo.siPath` 会进接口载荷，而包目录/root 目录可能是相对入口
-- 给出的（`check base` vs `check $PWD/base`）。不归一的话同一份源码在不同入口写法下
-- 算出不同载荷字节 ⇒ 载荷摘要失配 ⇒ 每次 check 都整包重写接口（§57c 覆盖）。
ownSourceInfos : PackageContext -> Eff [] (List (Pair String SourceInfo))
ownSourceInfos ctx = do
  walked <- mapEff (\root => do
    paths <- collectVunaMeta 1048576 (rootDir root)
    mapEff (\p => do
      abs <- absolutePath p
      raw <- prim_eff_readFile abs
      mtime <- prim_eff_fileMtime abs
      size <- prim_eff_fileSize abs
      pure
        (Pair (moduleNameOfPath (rootDir root) p) (SourceInfo abs (payloadDigest raw) mtime size))
    ) paths
  ) (filter (\r => rootName r == contextPackageName ctx) (contextRoots ctx))
  pure (concatMap (\xs => xs) walked)

-- | 干净模块的 `miSource` 来自磁盘 manifest（可能是上一次以相对/绝对不同写法 check 时写入的
-- 路径）。接口文件路径按「包目录 + 当前源路径」推导，复用时必须换成本次上下文的路径，
-- 否则相对/绝对入口交替会算出空路径而整包跳过写（§57c 覆盖）。
resyncCleanSources : List (Pair String SourceInfo) -> List ModuleIface -> List ModuleIface
resyncCleanSources sources clean = map (\m => case lookupPair (miNameOf m) sources of
  Just si =>
    ModuleIface (miNameOf m) (miPackageOf m) si (miIfaceHashOf m) (miDepHashesOf m) (miImportsOf m)
      (miImplicitImportsOf m) (miCapabilitiesOf m) (miExportsOf m) (miFixitiesOf m) (miDeclsOf m)
      (miRecordsOf m) (miPreparedOf m) (miCachedOf m)
  Nothing => m
) clean

writeIfaceShadow : PackageContext -> CheckedPackage -> Eff [] (Check Int)
writeIfaceShadow ctx checked = if contextPackageName ctx == "" then pure (OkC 0)
else do
  let
    _ = stamp "iface-shadow-start"
  in do
    sources <- ownSourceInfos ctx
    depTbl <- depIfaceHashTable ctx
    info <- ownCleanInfo ctx depTbl
    let
      clean = resyncCleanSources sources (case secondOf info of
        Just c => c
        Nothing => []
      )
    in do
      case ifaceOfPackage (contextPackageName ctx) sources depTbl checked.checkedInherited clean checked.checkedModules checked.checkedEntryDecls checked.checkedProgram of
        ErrC e => do
          self <- ifaceSelfTestRequested
          if self then pure (ErrC e)
          else do
            let
              _ = note "iface-reject=compute iface-skip ${diagText e}"
            in do
              pure (OkC 0)
        OkC modules => do
          let
            _ = stamp "iface-compute-done"
          in do
            writeIfaceNow (firstOf info) ctx modules

-- 真正写接口：入口-only 包（没有 lib 模块）不写（没有可复用的模块接口；写空包只会让
-- 消费者读到 invalid 接口）。per-module 文件只重写接口哈希变化的模块，manifest 最后写。
-- 目标目录不可写（Nix store / 只读 checkout / `VUNA_IFACE_DIR` 指到只读树）时静默降级：
-- 不写、exit code 不变，读侧照旧（没有接口就回退全量）。`oldReadable` 来自写前那次
-- 整包接口读取，避免写回时再解码一遍所有模块文件。
writeIfaceNow : Bool -> PackageContext -> List ModuleIface -> Eff [] (Check Int)
writeIfaceNow oldReadable ctx modules = if length modules == 0 then do
  let
    _ = note "iface-reject=empty-package iface-skip empty-package"
  in do
    pure (OkC 0)
else do
  dir <- ifaceDirOf ctx
  let
    pkgDir = contextDir ctx
  in do
    filesOk <- ifaceFilesOk pkgDir modules
    if not filesOk then do
      let
        _ = note "iface-reject=path iface-skip path ${dir}"
      in do
        pure (OkC 0)
    else do
      ready <- ifaceWriteReady dir pkgDir modules
      if not ready then do
        let
          _ = note "iface-reject=readonly iface-skip readonly ${dir}"
        in do
          pure (OkC 0)
      else do
        n <- withIfaceLock ctx (\_ => do
          tag <- ifaceCompilerTag
          env <- packageEnvHash ctx
          writePackageIface oldReadable dir tag (contextPackageName ctx) pkgDir env modules
        )
        let
          _ = note "iface-write=${n}/${length modules}"
          _ = stamp "iface-write-done"
        in do
          mirror <- ifaceMirrorMode
          _ <- if mirror then gcIfaceOrphans dir pkgDir modules else pure 0
          self <- ifaceSelfTestRequested
          if self then ifaceSelfTest dir modules else pure (OkC n)

-- 影子写的自检（`VUNA_IFACE_SELFTEST=1`）：读回 + 包接口校验 + 模块名集合/接口哈希一致。
-- 失败让 check 失败（宁可暴露，不静默写坏缓存）。
ifaceSelfTestRequested : Eff [] Bool
ifaceSelfTestRequested = do
  v <- prim_eff_getenv "VUNA_IFACE_SELFTEST"
  pure (v == "1")

ifaceHashOfName : List ModuleIface -> String -> Maybe String
ifaceHashOfName [] _ = Nothing
ifaceHashOfName (m :: rest) name =
  if miNameOf m == name then Just (miIfaceHashOf m) else ifaceHashOfName rest name

ifaceSelfTest : String -> List ModuleIface -> Eff [] (Check Int)
ifaceSelfTest dir modules = do
  tag <- ifaceCompilerTag
  pi2 <- readPackageIface dir tag
  case pi2 of
    Nothing => pure (icInternal "iface selftest: written iface cannot be read back")
    Just p => if not (packageIfaceValid p) then do
      let
        _ = note "iface-invalid=${firstInvalidModule p}"
      in pure (icInternal "iface selftest: package iface invalid")
    else if p.piCompiler /= tag then pure (icInternal "iface selftest: compiler tag mismatch")
    else if p.piSchema /= ifaceSchemaTag then pure (icInternal "iface selftest: schema mismatch")
    else if length p.piModules /= length modules then pure (icInternal "iface selftest: module count mismatch")
    else if not (sameNameSet (moduleNamesOf p.piModules) (moduleNamesOf modules)) then pure (icInternal "iface selftest: module name set mismatch")
    else if not (sameIfaceHashes p.piModules modules) then pure (icInternal "iface selftest: iface hash mismatch")
    else if not (allSelfHashesOk p.piModules) then pure (icInternal "iface selftest: payload hash mismatch")
    else do
      let
        _ = note "iface-selftest=ok modules=${length modules}"
      in do
        pure (OkC 0)

-- 读回的每个模块都必须满足「载荷重算哈希 == 记录哈希」（写侧自证）。
allSelfHashesOk : List ModuleIface -> Bool
allSelfHashesOk [] = True
allSelfHashesOk (m :: rest) = hashOfIface m == miIfaceHashOf m && allSelfHashesOk rest

sameIfaceHashes : List ModuleIface -> List ModuleIface -> Bool
sameIfaceHashes [] _ = True
sameIfaceHashes (m :: rest) ys = case ifaceHashOfName ys (miNameOf m) of
  Just h => h == miIfaceHashOf m && sameIfaceHashes rest ys
  Nothing => False

-- 成功收尾：写接口影子（check 结果节点由 `checkViaGraph` 提交，这里不再写 marker 文件）。
checkAndShadow : PackageContext -> Eff [] (Check (Pair (List Diagnostic) CheckedPackage)) -> Eff [] (Check (List Diagnostic))
checkAndShadow ctx checked = do
  checkedR <- checked
  case checkedR of
    ErrC e => pure (ErrC e)
    OkC pr => do
      shadow <- writeIfaceShadow ctx (secondOf pr)
      case shadow of
        ErrC e => pure (ErrC e)
        OkC _ => pure (OkC (firstOf pr))

checkCachedLib : Bool -> PackageContext -> List String -> Eff [] (Check (List Diagnostic))
checkCachedLib wantWarnings ctx names = do
  mods <- checkModsLib ctx names
  if wantWarnings then checkUncachedLib wantWarnings ctx names
  else checkViaGraph ctx mods (checkUncachedLib wantWarnings ctx names)

checkUncachedLib : Bool -> PackageContext -> List String -> Eff [] (Check (List Diagnostic))
checkUncachedLib wantWarnings ctx names = do
  full <- elabFullRequested
  if full then fullCheckLib ctx names
  else do
    audit <- ifaceAuditRequested
    if audit then auditCheckLib wantWarnings ctx names
    else do
      summary <- summaryCheckLibParts wantWarnings ctx names
      checkAndShadow ctx (pure summary)

summaryCheckLibParts : Bool -> PackageContext -> List String -> Eff [] (Check (Pair (List Diagnostic) CheckedPackage))
summaryCheckLibParts wantWarnings ctx names = do
  depIfaces <- depIfacesOf ctx
  case depIfaces of
    Nothing => do
      let
        _ = note "cache-path=full"
      in do
        dtCheckLibraryWithProgramParts ctx names
    Just ifaces => do
      depTbl <- depIfaceHashTable ctx
      clean <- ownCleanModules ctx depTbl
      case clean of
        Just clean2 => do
          let
            cleanReal = if wantWarnings then [] else clean2
            _ = note "cache-path=summary deps=${depPackageCount ctx}"
            _ = note "cache-own-clean=${length cleanReal}"
          in do
            dtCheckLibraryPackageIncrementalParts ctx names ifaces cleanReal
        Nothing => do
          let
            _ = note "cache-path=summary deps=${depPackageCount ctx}"
          in do
            dtCheckLibraryPackageWithIfacesParts ctx names ifaces

fullCheckLib : PackageContext -> List String -> Eff [] (Check (List Diagnostic))
fullCheckLib ctx names =
  let
    _ = note "cache-path=full"
  in checkAndShadow ctx (dtCheckLibraryWithProgramParts ctx names)

auditCheckLib : Bool -> PackageContext -> List String -> Eff [] (Check (List Diagnostic))
auditCheckLib wantWarnings ctx names = do
  summary <- summaryCheckLibParts wantWarnings ctx names
  full <- dtCheckLibraryWithProgramParts ctx names
  let
    subject = joinLines names
    _ = note "iface-audit subject=check-lib entry=${subject}"
  in do
    compared <-
      pure (auditCompare "check-lib" subject (checkSignatureOf summary) (checkSignatureOf full))
    case compared of
      ErrC e => pure (ErrC e)
      OkC _ => checkAndShadow ctx (pure summary)

-- M34.5：elab + codegen 产物缓存（`List SplitFile` 是纯数据，可 Marshal）
--
-- key = 闭包源哈希 + 依赖哈希 + schema/版本 + 编译器二进制指纹 + printResult；
-- 命中直接写文件（省 load/resolve/elab/codegen）。`ffi/*.c` 每次重新复制（C 源小）。
-- 缓存放包根 `.local/split-cache/`（gitignored）。
-- C35：SplitFile 增加 splitDeps 字段（形状变了），schema 升到 2，旧缓存自然失效。
-- ---------------------------------------------------------------
splitCacheSchema : String
splitCacheSchema = "vuna-split-cache 4"

-- | split 缓存载荷的编码版本（`Store` 的 codec 段）。
splitCacheCodec : String
splitCacheCodec = "split-files 1"

splitCacheTag : Eff [] String
splitCacheTag = do
  tag <- compilerTagEff
  pure "${splitCacheSchema}/${tag}"

splitCacheDir : PackageContext -> Eff [] String
splitCacheDir ctx = do
  base <- cacheBase
  pure "${base}/${hashText (textHash (contextPackageName ctx))}/split"

splitCachePath : PackageContext -> String -> Eff [] String
splitCachePath ctx key = do
  dir <- splitCacheDir ctx
  pure "${dir}/${key}"

splitCacheKey : PackageContext -> String -> Bool -> Eff [] String
splitCacheKey ctx entry printResult = do
  sources <- contextSources ctx entry
  deps <- dependencyHashes ctx
  fp <- compilerFingerprint
  let
    srcHash = closureHashOf sources 0
    depsHash = closureHashOf deps 0
    verHash = textHash (splitCacheSchema ++ vunaVersion) + fp
    prHash = if printResult then 1 else 0
  in do
    pure "${hashText srcHash}-${hashText depsHash}-${hashText (verHash + prHash)}"

-- 读侧过 `Store` framing（magic/tag/codec/长度/载荷内容地址）+ 规范解码；任何一项
-- 不符（截断/篡改/旧格式）⇒ Nothing ⇒ 调用方重算并覆盖。
readSplitCache : String -> String -> Eff [] (Maybe (List SplitFile))
readSplitCache tag path = do
  payload <- storeReadEff tag splitCacheCodec path
  pure (case payload of
    Just bytes => decSplitFilesComplete bytes
    Nothing => Nothing
  )

writeSplitCache : PackageContext -> String -> String -> List SplitFile -> Eff [] Int
writeSplitCache ctx tag path files = do
  dir <- splitCacheDir ctx
  _ <- storeEnsureDirEff dir
  storeWriteEff tag splitCacheCodec path (encTop encSplitFiles files)

-- 自检辅助：找出第一个 `cachedProgramValid` 不过的模块名（空 = 全部有效）。
firstInvalidModule : PackageIface -> String
firstInvalidModule p = firstInvalidGo (pmModulesOfIface p)

pmModulesOfIface : PackageIface -> List ModuleIface
pmModulesOfIface p = p.piModules

firstInvalidGo : List ModuleIface -> String
firstInvalidGo [] = ""
firstInvalidGo (m :: rest) =
  if cachedProgramValid (miCachedOf m) then firstInvalidGo rest
  else "${miNameOf m}:${cachedProgramIssue (miCachedOf m)}"
