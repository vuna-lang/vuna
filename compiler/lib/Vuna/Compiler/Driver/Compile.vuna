module Vuna.Compiler.Driver.Compile (buildSplit, checkPackage, compileToDir, runBuildScript) where

-- Vuna.Compiler.Driver.Compile：编译入口（供 CompilerCli / 测试使用）。唯一路径是 DT：
-- 精化（Elab）→ 擦除检查 + 逐模块 OCaml 生成（Codegen.Split）；`check*` 只检查不产码。
-- M26：包上下文（`PackageContext`）是唯一入口形状；旧的 `effectiveRoots` /
-- 单文件 codegen（main.ml + build.sh）/ `seedSplit` 已删除——`compile` 与 `seed`
-- rotation 共用 `compileToDir`（目录 + build.sh）。
import Vuna.Compiler.Common
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Driver.Split

-- 包级 check：可执行包检查 app/Main.vuna；库包检查 [export].modules。
checkPackage : Package -> Result (List String)
checkPackage pkg = if fileExists (packageEntry pkg) then dtCheck (packageContext pkg) (packageEntry pkg)
else case packageExports pkg of
  Nothing =>
    Err
      ("check: library package " ++ packageName pkg ++ " has no app/Main.vuna (executable) and no [export].modules (library)")
  Just names => dtCheckLibrary (packageContext pkg) names

-- 逐模块 split 输出到 outDir：各模块 .ml + Main.ml + build.sh；Ok 写出的文件数。
-- outDir 在 codegen 成功后才创建（精化失败不留产物）。
compileToDir : PackageContext -> String -> Bool -> String -> Result Int
compileToDir ctx entry printResult outDir = andThen (dtSplitProject ctx entry printResult) (\files => let
  _ = makeDir outDir
in andThen (writeSplitFiles outDir files) (\n => let
  order = splitCompileOrder (splitInitFiles files)
in let
  _ = writeFile (outDir ++ "/build.sh") (buildScript order)
in Ok n
)
)

-- loadPackage + compileToDir：给定包目录的代码生成（seed rotation / 测试用）。
buildSplit : String -> String -> Result Int
buildSplit dir outDir =
  andThen (loadPackage dir)
    (\pkg => compileToDir (packageContext pkg) (packageEntry pkg) True outDir)

-- 在 dir 里跑生成的 build.sh：`sh build.sh <out>`（out 相对 dir，例如 "bin/<pkg>"）。
-- 链接失败给出带包名/目录/退出码的清晰错误（ocamlopt 的 stderr 已在终端）。
runBuildScript : String -> String -> String -> Result Int
runBuildScript dir out name =
  let
    code = prim_runIn dir ["sh", "build.sh", out]
  in if code == 0 then Ok 0
  else Err
    ("build: " ++ name ++ ": `sh build.sh " ++ out ++ "` failed in " ++ dir ++ " (exit " ++ strFromInt code ++ ")")
