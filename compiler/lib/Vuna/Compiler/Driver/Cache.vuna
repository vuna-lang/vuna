module Vuna.Compiler.Driver.Cache where

-- Vuna.Compiler.Driver.Cache：M34.5 / C37：接口摘要（依赖包 elab 复用）的载体——参考 Idris2 的 TTC：
-- **只含闭合结果，不携带任何 elab 状态**（sols / next / dict goals / defVals）。
--
-- 写摘要（`cachedOfProgram`）：把 DtProgram 的项按**出现点深度**内联已解元变量
-- （`substSolvedMetasAtTbl`）。深度 0 的 quote 会把 binder 下的解拍成错位/负索引
-- （`lookupEnv` 对 `i <= 0` 取最内层变量 ⇒ 静默取错 binder），所以必须传真实深度。
--
-- 读摘要（`cachedProgramValid`）：签名面 / 类型 / 实例 / 类必须闭合且无 `TMeta`、无负
-- 索引；def **body** 只允许保留**擦除位置**的未解 meta（精化器本来就不要求它们有解，
-- 读侧按包段重编号）。其它情况一律**不可用**（调用方回退全量精化）。宁可慢，不静默漏检。
--
-- 字段都是「本包自己的声明」：datas（kind + 构造子类型）、defs（type + body，body 是
-- delta 展开的唯一来源）、globals（签名面）、insts（tele / 约束 / 头）、classes。
-- 依赖闭包由调用方逐包读取并在 `depStartOf` 去重合并。
import Vuna.Compiler.Common
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Canonical.CoreTerm
import Vuna.Compiler.Canonical.Elab
import Base.HashMap
import Vuna.Compiler.Core
import Vuna.Compiler.Core.Term
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Types

export record CachedProgram(..) where
  cachedDatas : List DtData
  cachedDefs : List DtDef
  cachedGlobals : List (Pair String Term)
  cachedInsts : List DtInst
  cachedClasses : List DtClass

export cachedDatas : CachedProgram -> List DtData
cachedDatas (CachedProgram datas defs globals insts classes) = datas

export cachedDefs : CachedProgram -> List DtDef
cachedDefs (CachedProgram datas defs globals insts classes) = defs

export cachedGlobals : CachedProgram -> List (Pair String Term)
cachedGlobals (CachedProgram datas defs globals insts classes) = globals

export cachedInsts : CachedProgram -> List DtInst
cachedInsts (CachedProgram datas defs globals insts classes) = insts

export cachedClasses : CachedProgram -> List DtClass
cachedClasses (CachedProgram datas defs globals insts classes) = classes

-- ---------------------------------------------------------------
-- 写摘要：按出现点深度内联已解元变量
-- ---------------------------------------------------------------
fixTerm : HashMap Int Value -> Int -> Term -> Term
fixTerm tbl depth t = substSolvedMetasAtTbl tbl depth t

fixDef : HashMap Int Value -> DtDef -> DtDef
fixDef tbl (DtDef n ty body sp) = DtDef n (fixTerm tbl 0 ty) (fixTerm tbl 0 body) sp
fixDef tbl (DtAxiom n ty sp) = DtAxiom n (fixTerm tbl 0 ty) sp
fixDef tbl (DtExtern n ty c sp) = DtExtern n (fixTerm tbl 0 ty) c sp

fixCtor : HashMap Int Value -> DtCtor -> DtCtor
fixCtor tbl (DtCtor n fam tele ty sp) = DtCtor n fam tele (fixTerm tbl 0 ty) sp

fixData : HashMap Int Value -> DtData -> DtData

fixFieldMeta : HashMap Int Value -> DtFieldMeta -> DtFieldMeta
fixFieldMeta tbl (DtFieldMeta fn fi fty) = DtFieldMeta fn fi (fixTerm tbl 0 fty)

fixData tbl (DtData n ps ctors kind viaClasses lin repr fields isRec) =
  DtData n ps (map (fixCtor tbl) ctors) (fixTerm tbl 0 kind) viaClasses lin repr
    (map (fixFieldMeta tbl) fields) isRec

-- 投影签名是闭合的 Pi 链（`{p} -> {d} -> <方法类型>`）；字段类型精化在**全部类参数** binder
-- 之下（深度 = 类参数个数；单参数类是 1，多参数 trait 必须按个数，否则会被误判 free-var），
-- 自定义实例时由 `substInstParam` 把类参数换成头实参。
fixClass : HashMap Int Value -> DtClass -> DtClass
fixClass tbl (DtClass n ps projs tys) =
  DtClass n ps (map (\p => Pair (firstOf p) (fixTerm tbl 0 (secondOf p))) projs)
    (map (fixTerm tbl (length ps)) tys)

-- 实例 telescope：tele 第 i 项在 i 个 tele binder 之下；ctx 域与结果头在全部 tele binder 之下。
fixTele : HashMap Int Value -> Int -> List (Pair String Term) -> List (Pair String Term)
fixTele tbl depth [] = []
fixTele tbl depth ((Pair n t) :: rest) =
  Pair n (fixTerm tbl depth t) :: fixTele tbl (depth + 1) rest

fixInst : HashMap Int Value -> DtInst -> DtInst
fixInst tbl (DtInst n tele ctxE head sp) =
  let
    nTele = length tele
  in DtInst n (fixTele tbl 0 tele) (map (fixTerm tbl nTele) ctxE) (fixTerm tbl nTele head) sp

export cachedOfProgram : DtProgram -> CachedProgram
cachedOfProgram prog = cachedOfProgramWith (Base.HashMap.fromList (dtProgSols prog)) prog

-- M34.6：整包 sols 的 HashMap Int 可能很大（数万条）。接口写侧按模块切片后仍要按**整包**
-- sols 做一次深度 zonk：旧实现每个模块都重建一次整包 HashMap Int（O(#模块 × #sols)）。
-- 这里把表做成显式参数，调用方（Iface 的 `ProgParts`）整包只建一次。
export cachedOfProgramWith : HashMap Int Value -> DtProgram -> CachedProgram
cachedOfProgramWith tbl prog =
  CachedProgram (map (fixData tbl) (dtProgDatas prog)) (map (fixDef tbl) (dtProgDefs prog))
    (map (\p => Pair (firstOf p) (fixTerm tbl 0 (secondOf p))) (dtProgGlobals prog))
    (map (fixInst tbl) (dtProgInsts prog)) (map (fixClass tbl) (dtProgClasses prog))

-- ---------------------------------------------------------------
-- 读摘要前的校验：闭合 + 无 meta + 无负索引
-- ---------------------------------------------------------------
-- 摘要没有 sols：除 body 的擦除位置外，任何残留 `TMeta` 都不可重建；负索引在求值时
-- 会被当成最内层变量；超出当前深度上界的自由变量说明 quote 深度算错。任一命中即拒绝。
termValidAt : Int -> Term -> Bool
termValidAt depth t =
  length (termMetasAll t) == 0 && not (hasFreeTermVar depth t) && not (hasNegativeVar t)

ctorsValid : List DtCtor -> Bool
ctorsValid [] = True
ctorsValid (c :: rest) = termValidAt 0 (dtCtorType c) && ctorsValid rest

datasValid : List DtData -> Bool
datasValid [] = True
datasValid (d :: rest) =
  termValidAt 0 (dtDataKind d) && ctorsValid (dtDataCtors d) && datasValid rest

defsValid : List DtDef -> Bool
defsValid [] = True
defsValid (d :: rest) = case dtDefBody d of
  -- body 里**擦除位置**的未解 meta 允许保留（精化器本来就不要求它们有解）：读摘要时按
  -- 包段重编号，消费方当作新的未解元变量（只能出现在不生成代码/不被比较的位置）。
  Just body => termValidAt 0 (dtDefType d) && bodyValid body && defsValid rest
  Nothing => termValidAt 0 (dtDefType d) && defsValid rest

bodyValid : Term -> Bool
bodyValid t = length (termMetasRuntime t) == 0 && not (hasFreeTermVar 0 t) && not (hasNegativeVar t)

globalsValid : List (Pair String Term) -> Bool
globalsValid [] = True
globalsValid ((Pair n t) :: rest) = termValidAt 0 t && globalsValid rest

teleValid : Int -> List (Pair String Term) -> Bool
teleValid depth [] = True
teleValid depth ((Pair n t) :: rest) = termValidAt depth t && teleValid (depth + 1) rest

termsValidAt : Int -> List Term -> Bool
termsValidAt depth [] = True
termsValidAt depth (t :: rest) = termValidAt depth t && termsValidAt depth rest

instsValid : List DtInst -> Bool
instsValid [] = True
instsValid (i :: rest) =
  let
    nTele = length i.dtInstTele
  in teleValid 0 i.dtInstTele
    && termsValidAt nTele i.dtInstCtx
    && termValidAt nTele i.dtInstHead
    && instsValid rest

classesValid : List DtClass -> Bool
classesValid [] = True
classesValid (c :: rest) =
  let
    projs = map (\p => secondOf p) c.dtClassMethods
  in termsValidAt 0 projs
    && termsValidAt (length c.dtClassParams) c.dtClassFieldTys
    && classesValid rest

export cachedProgramValid : CachedProgram -> Bool
cachedProgramValid (CachedProgram datas defs globals insts classes) =
  datasValid datas
    && defsValid defs
    && globalsValid globals
    && instsValid insts
    && classesValid classes

-- ---------------------------------------------------------------
-- 诊断（仅摘要被判无效时调用）：指出第一个不可用项，便于 --debug-perf 定位
-- ---------------------------------------------------------------
termIssueAt : Int -> Term -> String
termIssueAt depth t =
  if length (termMetasAll t) > 0 then "meta"
  else if hasNegativeVar t then "negative-index" else if hasFreeTermVar depth t then "free-var" else ""

dataIssue : DtData -> String
dataIssue d =
  let
    kindIssue = termIssueAt 0 (dtDataKind d)
  in if kindIssue == "" then ctorIssues (dtDataCtors d) else "${dtDataName d} kind:${kindIssue}"

ctorIssues : List DtCtor -> String
ctorIssues [] = ""
ctorIssues (c :: rest) =
  let
    issue = termIssueAt 0 (dtCtorType c)
  in if issue == "" then ctorIssues rest else "${dtCtorName c} ctor:${issue}"

datasIssue : List DtData -> String
datasIssue [] = ""
datasIssue (d :: rest) =
  let
    issue = dataIssue d
  in if issue == "" then datasIssue rest else issue

bodyIssueAt : Term -> String
bodyIssueAt t =
  if length (termMetasRuntime t) > 0 then "meta"
  else if hasNegativeVar t then "negative-index" else if hasFreeTermVar 0 t then "free-var" else ""

defIssue : DtDef -> String
defIssue d =
  let
    typeIssue = termIssueAt 0 (dtDefType d)
  in if typeIssue == "" then case dtDefBody d of
    Just body =>
      let
        bodyIssue = bodyIssueAt body
      in if bodyIssue == "" then "" else "${dtDefName d} body:${bodyIssue}"
    Nothing => ""
  else "${dtDefName d} type:${typeIssue}"

defsIssue : List DtDef -> String
defsIssue [] = ""
defsIssue (d :: rest) =
  let
    issue = defIssue d
  in if issue == "" then defsIssue rest else issue

globalsIssue : List (Pair String Term) -> String
globalsIssue [] = ""
globalsIssue ((Pair n t) :: rest) =
  let
    issue = termIssueAt 0 t
  in if issue == "" then globalsIssue rest else "${n}:${issue}"

instIssue : DtInst -> String
instIssue i =
  let
    nTele = length i.dtInstTele
    teleIssue = teleIssueGo 0 i.dtInstTele
  in if teleIssue /= "" then "${dtInstName i} tele:${teleIssue}"
  else
    let
      ctxIssue = ctxIssues nTele i.dtInstCtx
    in if ctxIssue /= "" then "${dtInstName i} ctx:${ctxIssue}"
    else
      let
        headIssue = termIssueAt nTele i.dtInstHead
      in if headIssue == "" then "" else "${dtInstName i} head:${headIssue}"

teleIssueGo : Int -> List (Pair String Term) -> String
teleIssueGo depth [] = ""
teleIssueGo depth ((Pair n t) :: rest) =
  let
    issue = termIssueAt depth t
  in if issue == "" then teleIssueGo (depth + 1) rest else "${n}:${issue}"

ctxIssues : Int -> List Term -> String
ctxIssues depth [] = ""
ctxIssues depth (t :: rest) =
  let
    issue = termIssueAt depth t
  in if issue == "" then ctxIssues depth rest else issue

instsIssue : List DtInst -> String
instsIssue [] = ""
instsIssue (i :: rest) =
  let
    issue = instIssue i
  in if issue == "" then instsIssue rest else issue

classIssue : DtClass -> String
classIssue c =
  let
    projIssue = ctxIssues 0 (map (\p => secondOf p) c.dtClassMethods)
  in if projIssue /= "" then "${dtClassName c} proj:${projIssue}"
  else
    let
      fieldIssue = ctxIssues (length c.dtClassParams) c.dtClassFieldTys
    in if fieldIssue == "" then "" else "${dtClassName c} field:${fieldIssue}"

classesIssue : List DtClass -> String
classesIssue [] = ""
classesIssue (c :: rest) =
  let
    issue = classIssue c
  in if issue == "" then classesIssue rest else issue

export cachedProgramIssue : CachedProgram -> String
cachedProgramIssue (CachedProgram datas defs globals insts classes) =
  let
    datasI = datasIssue datas
    defsI = defsIssue defs
    globalsI = globalsIssue globals
    instsI = instsIssue insts
    classesI = classesIssue classes
  in if datasI /= "" then "datas ${datasI}"
  else if defsI /= "" then "defs ${defsI}"
  else if globalsI /= "" then "globals ${globalsI}"
  else if instsI /= "" then "insts ${instsI}" else if classesI /= "" then "classes ${classesI}" else ""

-- ---------------------------------------------------------------
-- 包段重编号：摘要里允许残留的「擦除位置未解 meta」
-- ---------------------------------------------------------------
-- 精化器（M23 决策）允许擦除位置留未解元变量；摘要无 sols，无法跨包共享这些解。
-- 读摘要时给每个依赖模块分配一个段并整体移位（段号 = 模块名排序后的名次，见
-- `Dt.shiftedDepPrograms` —— 与 iface 列表顺序无关）：段 0 留给根包，不同摘要 / 根包
-- 之间编号互不冲突；消费方把它们当作**新的未解元变量**（只出现在不生成代码、不参与
-- 运行时比较的擦除位置）。段宽 2^30 远大于单模块元变量数。
export summaryMetaSegment : Int
summaryMetaSegment = 1073741824

-- 项内元变量整体移位。meta 编号是**全局**的、与 binder 深度无关 ⇒ 只做结构遍历、不需要
-- 深度参数（`TRecUpd` 的 base/body、`TCase` 分支体、`TProj` 的 base 里的 meta 同样要移）。
--
-- 旧实现有两处**静默漏移**：(a) 漏了 `TMk` / `TRecord` / `TProj` / `TRecUpd`（落到
-- `_ => t`）——record 构造/更新里擦除位的残 meta 会保持旧编号、与本包 fresh 编号撞号；
-- (b) fuel 用尽后原样返回剩余子树。现在 fuel 耗尽 ⇒ `icFuel "meta-shift"`（内部错误、可
-- 检测，绝不静默用未移位的项）；fuel 取 `defaultFuel`，与 codegen / conv 的守卫同级
-- （codegen 能接受的项深度内不会触发）。
shiftTerm : Int -> Term -> Check Term
shiftTerm off t = shiftTermFuel defaultFuel off t

shiftTermFuel : Int -> Int -> Term -> Check Term
shiftTermFuel fuel off t = if fuel <= 0 then icFuel "meta-shift"
else case t of
  TVar n i sp => OkC (TVar n i sp)
  TMeta m => OkC (TMeta (m + off))
  TGlobal g => OkC (TGlobal g)
  TType l => OkC (TType l)
  TPi n i r d c =>
    Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off d)
      (\d2 => Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off c) (\c2 => OkC (TPi n i r d2 c2)))
  TLam n r b =>
    Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off b) (\b2 => OkC (TLam n r b2))
  TApp f a r =>
    Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off f)
      (\f2 => Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off a) (\a2 => OkC (TApp f2 a2 r)))
  TCon c args =>
    Vuna.Compiler.Common.bind (shiftArgs (fuel - 1) off args) (\args2 => OkC (TCon c args2))
  TMk c args =>
    Vuna.Compiler.Common.bind (shiftArgs (fuel - 1) off args) (\args2 => OkC (TMk c args2))
  TRecord c args =>
    Vuna.Compiler.Common.bind (shiftArgs (fuel - 1) off args) (\args2 => OkC (TRecord c args2))
  TCase s alts =>
    Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off s)
      (\s2 => Vuna.Compiler.Common.bind (shiftAlts (fuel - 1) off alts) (\alts2 => OkC (TCase s2 alts2)))
  TProj base c tele i fi =>
    Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off base)
      (\base2 => OkC (TProj base2 c tele i fi))
  TRecUpd base c tele idxs body =>
    Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off base)
      (\base2 => Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off body) (\body2 => OkC (TRecUpd base2 c tele idxs body2)))
  TInt n => OkC (TInt n)
  TStr s => OkC (TStr s)
  TBool b => OkC (TBool b)
  TIf c th el =>
    Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off c)
      (\c2 => Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off th) (\th2 => Vuna.Compiler.Common.bind (shiftTermFuel (fuel - 1) off el) (\el2 => OkC (TIf c2 th2 el2))))
  TFloat raw => OkC (TFloat raw)

-- 实参表 / case 分支表：元素项是 Term 的子项（不是结构子项，SCT 证不了终止 ⇒ 走 fuel）。
shiftArgs : Int -> Int -> List (Pair Term Rig) -> Check (List (Pair Term Rig))
shiftArgs fuel off [] = OkC []
shiftArgs fuel off ((Pair a r) :: rest) =
  Vuna.Compiler.Common.bind (shiftTermFuel fuel off a)
    (\a2 => Vuna.Compiler.Common.bind (shiftArgs fuel off rest) (\rest2 => OkC (Pair a2 r :: rest2)))

shiftAlts : Int -> Int -> List CaseAlt -> Check (List CaseAlt)
shiftAlts fuel off [] = OkC []
shiftAlts fuel off ((CaseAlt n bs b) :: rest) =
  Vuna.Compiler.Common.bind (shiftTermFuel fuel off b)
    (\b2 => Vuna.Compiler.Common.bind (shiftAlts fuel off rest) (\rest2 => OkC (CaseAlt n bs b2 :: rest2)))

shiftDef : Int -> DtDef -> Check DtDef
shiftDef off (DtDef n ty body sp) =
  Vuna.Compiler.Common.bind (shiftTerm off ty)
    (\ty2 => Vuna.Compiler.Common.bind (shiftTerm off body) (\body2 => OkC (DtDef n ty2 body2 sp)))
shiftDef off (DtAxiom n ty sp) =
  Vuna.Compiler.Common.bind (shiftTerm off ty) (\ty2 => OkC (DtAxiom n ty2 sp))
shiftDef off (DtExtern n ty c sp) =
  Vuna.Compiler.Common.bind (shiftTerm off ty) (\ty2 => OkC (DtExtern n ty2 c sp))

shiftCtor : Int -> DtCtor -> Check DtCtor
shiftCtor off (DtCtor n fam tele ty sp) =
  Vuna.Compiler.Common.bind (shiftTerm off ty) (\ty2 => OkC (DtCtor n fam tele ty2 sp))

shiftFieldMeta : Int -> DtFieldMeta -> Check DtFieldMeta
shiftFieldMeta off (DtFieldMeta fn fi fty) =
  Vuna.Compiler.Common.bind (shiftTerm off fty) (\fty2 => OkC (DtFieldMeta fn fi fty2))

shiftData : Int -> DtData -> Check DtData
shiftData off (DtData n ps ctors kind viaClasses lin repr fields isRec) =
  Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftCtor off) ctors)
    (\ctors2 => Vuna.Compiler.Common.bind (shiftTerm off kind) (\kind2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftFieldMeta off) fields) (\fields2 => OkC (DtData n ps ctors2 kind2 viaClasses lin repr fields2 isRec))))

shiftTele : Int -> List (Pair String Term) -> Check (List (Pair String Term))
shiftTele off [] = OkC []
shiftTele off ((Pair n t) :: rest) =
  Vuna.Compiler.Common.bind (shiftTerm off t)
    (\t2 => Vuna.Compiler.Common.bind (shiftTele off rest) (\rest2 => OkC (Pair n t2 :: rest2)))

shiftClass : Int -> DtClass -> Check DtClass
shiftClass off (DtClass n ps projs tys) =
  Vuna.Compiler.Common.bind (shiftTele off projs)
    (\projs2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftTerm off) tys) (\tys2 => OkC (DtClass n ps projs2 tys2)))

shiftInst : Int -> DtInst -> Check DtInst
shiftInst off (DtInst n tele ctxE head sp) =
  Vuna.Compiler.Common.bind (shiftTele off tele)
    (\tele2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftTerm off) ctxE) (\ctx2 => Vuna.Compiler.Common.bind (shiftTerm off head) (\head2 => OkC (DtInst n tele2 ctx2 head2 sp))))

shiftGlobal : Int -> Pair String Term -> Check (Pair String Term)
shiftGlobal off (Pair n t) = Vuna.Compiler.Common.bind (shiftTerm off t) (\t2 => OkC (Pair n t2))

export shiftCachedProgram : Int -> CachedProgram -> Check CachedProgram
shiftCachedProgram off (CachedProgram datas defs globals insts classes) =
  Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftData off) datas)
    (\datas2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftDef off) defs) (\defs2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftGlobal off) globals) (\globals2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftInst off) insts) (\insts2 => Vuna.Compiler.Common.bind (Vuna.Compiler.Common.traverse (shiftClass off) classes) (\classes2 => OkC (CachedProgram datas2 defs2 globals2 insts2 classes2))))))

-- ---------------------------------------------------------------
-- 载荷编码（CachedProgram 落盘 / 载荷自描述，D-Q2）
-- ---------------------------------------------------------------
-- 与 `Canonical.Elab` 的 iface 哈希输入同格式：`DtData`/`DtDef`/`DtInst`/`DtClass`
-- 逐个走 `Canonical.Elab` 的编码器（span 丢弃），`globals` 用 `(名字, 项)` 对。
-- 读侧用同一批解码器还原；span 只能还原成 `Nothing`（不影响消费方：codegen 的位置表
-- 由 `Codecgen.Term.dtDefLocTable` 从 span 生成，这里只服务「同输入曾成功」的判定与
-- 增量精化的起点，不产出用户可见位置）。
--
-- | `CachedProgram` 的规范编码。
export encCachedProgram : CachedProgram -> List String -> List String
encCachedProgram cp acc =
  encList encDtData cp.cachedDatas
    (encList encDtDef cp.cachedDefs (encList encGlobalPair cp.cachedGlobals (encList encDtInst cp.cachedInsts (encList encDtClass cp.cachedClasses acc))))

encGlobalPair : Pair String Term -> List String -> List String
encGlobalPair (Pair n t) acc = encStr n (encTerm t acc)

-- | 解析 `CachedProgram`（整串入口：要求恰好消费完）。
export decCachedProgramComplete : String -> Maybe CachedProgram
decCachedProgramComplete s = case decCachedProgram (strLength s) (curOf s) of
  Nothing => Nothing
  Just (Pair cp rest) => if curAtEnd rest then Just cp else Nothing

export decCachedProgram : Int -> Cur -> Maybe (Pair CachedProgram Cur)
decCachedProgram fuel c =
  thenPair (decList decDtData (fuel - 1) c)
    (\datas, b1 => thenPair (decList decDtDef (fuel - 1) b1) (\defs, b2 => thenPair (decList decGlobalPair (fuel - 1) b2) (\globals, b3 => thenPair (decList decDtInst (fuel - 1) b3) (\insts, b4 => thenPair (decList decDtClass (fuel - 1) b4) (\classes, b5 => Just (Pair (CachedProgram datas defs globals insts classes) b5))))))

decGlobalPair : Int -> Cur -> Maybe (Pair (Pair String Term) Cur)
decGlobalPair fuel c =
  thenPair (decStr (fuel - 1) c)
    (\n, b1 => thenPair (decTerm (fuel - 1) b1) (\t, b2 => Just (Pair (Pair n t) b2)))
