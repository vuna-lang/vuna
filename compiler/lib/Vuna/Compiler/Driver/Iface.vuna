module Vuna.Compiler.Driver.Iface where

-- Vuna.Compiler.Driver.Iface：**模块级接口摘要**（TTC 思路）的载体与读写。
--
-- M34.5 已落地包级摘要（`Driver.Cache.CachedProgram`）：一个包一份闭合结果，依赖包整体
-- 复用。本模块把粒度降到模块：每个模块一份 `ModuleIface`，包级 manifest 是
-- `PackageIface`（模块按拓扑序）。
--
-- 字段设计（对照 Idris2 TTC）：
--   - `miCached`：模块自己的闭合精化产物（datas / defs 含 body / globals / insts /
--     classes），等价于 TTC 里的「编译后定义」；消费方用它重建起始 `Ec`；
--   - `miDecls`：模块**已 Loader-resolved 的源码声明**。vuna 的 record 语法降级与终止性
--     SCT 都工作在源码 AST 上（`Elab.Records.prepareDeclsWith` /
--     `Elab.Termination.checkTerminationDeclsWith`），依赖模块要提供这两类上下文；
--     Idris2 存的是编译后的 case tree，vuna 的等价物就是 resolved 子句。**这是与 TTC
--     字段集的唯一实质差异**：多了 decls、少了编译后端产物（codegen 在 vuna 侧由
--     `Codegen.*` 从 DtProgram 现生成）。
--   - `miExports` / `miFixities` / imports：加载器把依赖模块「当已加载模块」
--     复用时需要的模块图数据（不读源码）。
--   - `miSource` / `miIfaceHash`：失效判定。`miIfaceHash` 覆盖**载荷全量语义面**
--     （导出表、imports、fixity、record 头、data/ctor、defs、globals、实例、
--     类），只排除 span / 源路径，因此换行/注释/路径变化不会误失效；读方实际消费的任何
--     字段都必须参与哈希，否则会出现「载荷变了、哈希没变」的陈旧复用（§44m/§44n）。
--     摘要算法是 **SHA-256**（`shaText`，D5）；`siHash` 是源内容摘要，同一函数。
--
-- 物理布局（S3/S8）：接口文件与源码同布局 + 包级 `.vuna-iface`（模块名 → 相对路径 /
-- 源信息 / 接口哈希）。默认接口文件就在源文件旁；`VUNA_IFACE_DIR` 覆盖时整体镜像到外部
-- 根。写侧只重写接口哈希变化的模块，manifest 最后提交；读侧先读 manifest 再逐模块
-- 读文件并校验（framing + 头内内容地址 + 语义自证三层）。载荷是 `Canonical.*` 显式编码
-- + `Store` framing；schema 见 `ifaceSchema`（布局/字段语义变化必须 bump）。
--
-- 效果显式化：manifest / 模块文件的读、写、存在性探测与 `VUNA_IFACE_DIR` 环境读取
-- 全部显式在 `Eff []` 里；纯构造（接口哈希、覆盖性检查、布局计算）保持纯函数。
import Vuna.Compiler.Canonical.Ast
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Canonical.CoreTerm
import Vuna.Compiler.Canonical.Elab
import Vuna.Compiler.Common
import Vuna.Compiler.Hash
import Vuna.Compiler.Store
import Base.HashMap
import Base.List
import Vuna.Compiler.Core
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Elab.Records
import Vuna.Compiler.Elab.Derive
import Vuna.Compiler.Driver.Cache
import Vuna.Compiler.Driver.Owner
import Vuna.Compiler.Intrinsics
import Vuna.Compiler.Source
import Vuna.Compiler.Loader.Modules
import Vuna.Compiler.Loader.Flatten
import Vuna.Compiler.Packages.Pkg

-- 源信息：模块名 → (绝对路径, 内容哈希, mtime, size)。路径只用于本机校验（换 checkout
-- 会失效，回退全量）；mtime/size 是可选快路径（`VUNA_CACHE_MTIME=1`），默认仍用内容哈希。
export record SourceInfo(..) where
  siPath : String
  siHash : String
  siMtime : Int
  siSize : Int

export record ModuleIface(..) where
  miName : String
  miPackage : String
  miSource : SourceInfo
  miIfaceHash : String
  -- D11: impl-visible digest (opaque body + prepared); not part of iface dependency key.
  miImplHash : String
  -- 直接 import 的模块接口哈希（含同包模块与隐式 import）：TTC 的 `importHashes`。
  -- 依赖接口变化会通过它使本模块失效；`depMissingHash` = 写接口时该依赖接口不可得
  -- （哨兵，永不失配任何真实哈希）。
  miDepHashes : List (Pair String String)
  miImports : List Import
  miImplicitImports : List Import
  miExports : List ExportEntry
  miFixities : List FixityDecl
  miDecls : List Decl
  -- R2（records-v2）：结构化字段表（名字 / 类型 / 序号 / 派生 / 表示档位），
  -- 工具与下游包按表查字段，不再依赖 `@vuna@record@field@` 前缀约定。
  miRecords : List RecordMeta
  -- 本模块 decls 的 prepared 形态（`prepareDeclsWith` + `expandDerivings` 之后），
  -- 供包内增量的 `termAux` 直接拼接，免去每次 CLI 重跑干净模块的 record 降级 /
  -- deriving 展开（那是「编辑一个模块后重建」的主要成本）。空表 = 无缓存/不完整，
  -- 调用方回退 `dtPrepareTermAux`。有效性由模块自身的源哈希 + 依赖哈希链
  -- （`miDepHashes`，clean 判定已包含）保证。
  miPrepared : List Decl
  miCached : CachedProgram
  -- 本模块每个定义的位置表（vuna 全名 → (spanFile, spanStartLine)），**不进
  -- `miIfaceHash`**：span 不是语义面，移动代码不能失效依赖方（见 §不变量第 3 条）。
  -- 只服务 codegen 的 `dt_def_locs`（运行时错误回溯）：增量路径从接口复用干净模块时，
  -- `DtDef` 的 span 不在载荷里，必须用本表把干净模块的行补回位置表，否则「首次全量
  -- 构建」与「后续增量构建」的 `Vuna_runtime.ml` 不可逐字节一致（C51）。
  miDefLocs : List (Pair String (Pair String Int))

export record PackageIface(..) where
  piSchema : String
  piCompiler : String
  piPackage : String
  -- 包级环境指纹（manifest 的 `pmEnv`）：包配置/依赖图变化时整包失效。
  piEnv : Int
  piModules : List ModuleIface

export siPathOf : SourceInfo -> String
siPathOf s = s.siPath

export siHashOf : SourceInfo -> String
siHashOf s = s.siHash

export siMtimeOf : SourceInfo -> Int
siMtimeOf s = s.siMtime

export siSizeOf : SourceInfo -> Int
siSizeOf s = s.siSize

export miNameOf : ModuleIface -> String
miNameOf m = m.miName

export miPackageOf : ModuleIface -> String
miPackageOf m = m.miPackage

export miCachedOf : ModuleIface -> CachedProgram
miCachedOf m = m.miCached

export miIfaceHashOf : ModuleIface -> String
miIfaceHashOf m = m.miIfaceHash

export miImplHashOf : ModuleIface -> String
miImplHashOf m = m.miImplHash

export miDepHashesOf : ModuleIface -> List (Pair String String)
miDepHashesOf m = m.miDepHashes

export miSourceOf : ModuleIface -> SourceInfo
miSourceOf m = m.miSource

export miImportsOf : ModuleIface -> List Import
miImportsOf m = m.miImports

export miImplicitImportsOf : ModuleIface -> List Import
miImplicitImportsOf m = m.miImplicitImports

export miExportsOf : ModuleIface -> List ExportEntry
miExportsOf m = m.miExports

export miFixitiesOf : ModuleIface -> List FixityDecl
miFixitiesOf m = m.miFixities

export miDeclsOf : ModuleIface -> List Decl
miDeclsOf m = m.miDecls

-- | R2：模块的结构化 record 字段表。
export miRecordsOf : ModuleIface -> List RecordMeta
miRecordsOf m = m.miRecords

export miPreparedOf : ModuleIface -> List Decl
miPreparedOf m = m.miPrepared

-- | 本模块定义的位置表（vuna 全名 → (spanFile, spanStartLine)）；不进接口哈希，
-- 只用于 codegen 的位置表补行（见字段注释）。
export miDefLocsOf : ModuleIface -> List (Pair String (Pair String Int))
miDefLocsOf m = m.miDefLocs

defLocOf : DtDef -> Maybe (Pair String (Pair String Int))
defLocOf d = case dtDefSpan d of
  Nothing => Nothing
  Just sp => Just (Pair (dtDefName d) (Pair sp.spanFile sp.spanStartLine))

-- 位置表按 vuna 名排序：写侧（整包接口）与读侧（增量 codegen 补行）各取一次，顺序
-- 必须与全量路径 codegen 的位置表逐字节一致（C51 的确定性要求）。无 span 的定义跳过
-- （与 `dtDefLocTable` 的跳过语义一致）。
insertByDefLoc : Pair String (Pair String Int) -> List (Pair String (Pair String Int)) -> List (Pair String (Pair String Int))
insertByDefLoc p [] = [p]
insertByDefLoc p ((Pair k v) :: rest) =
  if firstOf p <= k then Base.List.Cons p (Base.List.Cons (Pair k v) rest)
  else Base.List.Cons (Pair k v) (insertByDefLoc p rest)

defLocsOfDefs : List DtDef -> List (Pair String (Pair String Int))
defLocsOfDefs [] = []
defLocsOfDefs (d :: rest) = case defLocOf d of
  Nothing => defLocsOfDefs rest
  Just p => insertByDefLoc p (defLocsOfDefs rest)

-- 单模块的 prepared decls：aux = 同包其它模块的原始 decls + 入口声明。
-- 只在整包写回（本包模块数 > 1）时计算：LSP/单模块写回只有部分上下文，算出的
-- prepared 不完整 ⇒ 留空，让读侧回退整表 `dtPrepareTermAux`。
preparedForModule : List Module -> List Decl -> String -> Maybe (List Decl)
preparedForModule modules entryDecls name =
  let
    others = filter (\m => moduleNameOf m /= name) modules
    own = concatMap (\m => if moduleNameOf m == name then moduleDeclsOf m else []) modules
    auxDecls = append (concatMap moduleDeclsOf others) entryDecls
  in if length modules <= 1 then Nothing
  else case prepareDeclsWith auxDecls own of
    ErrC _ => Nothing
    OkC p => case expandDerivings (secondOf p) of
      ErrC _ => Nothing
      OkC ds2 => Just ds2

setPrepared : List Decl -> ModuleIface -> ModuleIface
setPrepared prepared mi =
  ModuleIface mi.miName mi.miPackage mi.miSource mi.miIfaceHash mi.miImplHash mi.miDepHashes
    mi.miImports mi.miImplicitImports mi.miExports mi.miFixities mi.miDecls mi.miRecords prepared
    mi.miCached mi.miDefLocs

-- 接口格式版本：Marshal 布局或字段语义变化必须 bump（旧缓存自然失效）。
-- R1（records-v2）：DRecord/DData/DtData 增加 ReprTier 槽位，Marshal 布局变化 ⇒ bump。
-- R2：ModuleIface.miRecords / DtData.dtDataFields 新增字段表，布局再变 ⇒ bump（13 → 14）。
-- R3：Term/Value 新增 TProj/VProj 构造子，Marshal 布局变化 ⇒ 15。
-- R4（records-v2）：DtData 新增 `dtDataIsRecord`，`miPrepared` 中的 DRecord 保留（不再
-- 降级成 DData），布局与语义变化 ⇒ 17。`Term` 新增 `TRecord` 类型前导 ⇒ 18。
-- D5：接口哈希改为 SHA-256（`shaText` 内容摘要），`SourceInfo.siHash` / `miIfaceHash` /
-- `miDepHashes` 由 Int 变 String ⇒ Marshal 布局变化 ⇒ 19。
-- C32：接口载荷改为 `Canonical.*` 显式编码 + `Store` framing（Marshal 彻底退出缓存面），
-- manifest 增加 `mePayloadDigest`，布局变化 ⇒ 20。
-- C51：`ModuleIface.miDefLocs`（定义位置表，不进接口哈希）随载荷持久化，布局变化 ⇒ 22。
export ifaceSchema : String
ifaceSchema = "vuna-iface 26"

-- | 接口哈希的**算法格式版本**：参与哈希输入（与 `ifaceSchema` 独立——schema 管载荷
-- 布局，本版本管摘要算法/分片编码；换算法时旧哈希自然换代）。
ifaceHashVersion : String
ifaceHashVersion = "vuna-iface-hash 7 (opaque/abstract bodies excluded)"

-- ---------------------------------------------------------------
-- 哈希：接口哈希必须比 `strHash`（10 bit）强得多
-- ---------------------------------------------------------------
-- `strHash` 是 0..1023 的 10 bit 哈希；接口哈希用它单发会在几百个模块上有可观测的碰撞
-- 概率，碰撞会直接导致「错误复用」。D5 起接口哈希改用 SHA-256（`shaText`）；
-- `hashTextStrong` 是「必须落成 Int」位置（排序键 / 工具缓存 / codegen unit key）的统一
-- 强哈希：SHA-256 的 63-bit 派生键（`Hash.contentKey`），不再是 6-lane 盐折叠。
export hashTextStrong : String -> Int
hashTextStrong s = Vuna.Compiler.Hash.contentKey s

-- | 内容摘要（SHA-256，64 位小写十六进制）。接口哈希用它替换旧的 6-lane strHash 折叠
-- （后者只有约 60 bit，碰撞面在几百模块规模上不可忽略）。
export shaText : String -> String
shaText s = Vuna.Compiler.Hash.digestHex (Vuna.Compiler.Hash.digestOfString s)

-- | 大载荷段（源文本 / 规范编码字节）的内容地址：先 4-lane 预哈希折叠，再做 SHA-256
-- （与 `Hash.contentAddress` 同一函数）。
export payloadDigest : String -> String
payloadDigest s = Vuna.Compiler.Hash.contentAddress s

-- | 可解析分片：长度前缀，保证多段拼接无歧义。
partOf : String -> String
partOf s = "${strLength s}:${s}"

-- | 多个规范分片 → 一个内容摘要。
digestParts : List String -> String
digestParts ps = shaText (strConcatMany (map partOf ps))

-- | 依赖接口不可得时的哨兵（永不失配任何真实哈希）。
export depMissingHash : String
depMissingHash = "missing"

-- 哈希前按**语义键文本**规范化顺序（不再用哈希值当排序键）：同一集合在「全量 / 增量」
-- 两条路径上的列表顺序可能不同（globals 由「干净模块产物 + 本次精化产物」拼接），
-- 接口哈希不能因此漂移。按键文本排序是确定性的，也消除「两个名字哈希碰撞 ⇒ 顺序歧义」
-- 这一类隐患。插入排序仍是 O(d²)（已知边界：真实包每模块几十项，见 performance.md）。
insertByText : String -> a -> List (Pair String a) -> List (Pair String a)
insertByText k x [] = [Pair k x]
insertByText k x ((Pair ky y) :: rest) =
  if k <= ky then Base.List.Cons (Pair k x) (Base.List.Cons (Pair ky y) rest)
  else Base.List.Cons (Pair ky y) (insertByText k x rest)

sortTextPairs : List (Pair String a) -> List (Pair String a)
sortTextPairs [] = []
sortTextPairs ((Pair k x) :: rest) = insertByText k x (sortTextPairs rest)

sortByText : (a -> String) -> List a -> List a
sortByText key xs = map secondOf (sortTextPairs (map (\x => Pair (key x) x) xs))

-- C32 方向：接口哈希里的项要**规范化**。增量路径与全量路径的擦除位残 meta 编号不同
-- （增量从干净模块 meta 之上开始编号），直接 Marshal 会让同一模块的哈希随路径漂移；
-- 这里把每个定义里的 TMeta 按首次出现顺序重编号为 0,1,2,...（只影响擦除位、无解）。
record CanonState where
  csNext : Int
  csMap : HashMap Int Int

canonStateEmpty : CanonState
canonStateEmpty = CanonState 0 (Base.HashMap.fromList [])

canonTerm : CanonState -> Term -> Pair Term CanonState
canonTerm st (TMeta m) = case Base.HashMap.lookup m st.csMap of
  Just m2 => Pair (TMeta m2) st
  Nothing =>
    Pair (TMeta st.csNext) (CanonState (st.csNext + 1) (Base.HashMap.insert m st.csNext st.csMap))
canonTerm st (TPi n i r d c) =
  let
    pd = canonTerm st d
    pc = canonTerm (secondOf pd) c
  in Pair (TPi n i r (firstOf pd) (firstOf pc)) (secondOf pc)
canonTerm st (TLam n r b) =
  let
    pb = canonTerm st b
  in Pair (TLam n r (firstOf pb)) (secondOf pb)
canonTerm st (TApp f a r) =
  let
    pf = canonTerm st f
    pa = canonTerm (secondOf pf) a
  in Pair (TApp (firstOf pf) (firstOf pa) r) (secondOf pa)
canonTerm st (TCon c args) =
  let
    pr = canonArgs st args
  in Pair (TCon c (firstOf pr)) (secondOf pr)
canonTerm st (TMk c args) =
  let
    pr = canonArgs st args
  in Pair (TMk c (firstOf pr)) (secondOf pr)
canonTerm st (TRecord c args) =
  let
    pr = canonArgs st args
  in Pair (TRecord c (firstOf pr)) (secondOf pr)
canonTerm st (TCase s alts) =
  let
    ps = canonTerm st s
    pa = canonAlts (secondOf ps) alts
  in Pair (TCase (firstOf ps) (firstOf pa)) (secondOf pa)
canonTerm st (TIf c th el) =
  let
    pc = canonTerm st c
    pt = canonTerm (secondOf pc) th
    pe = canonTerm (secondOf pt) el
  in Pair (TIf (firstOf pc) (firstOf pt) (firstOf pe)) (secondOf pe)
canonTerm st t = Pair t st

canonArgs : CanonState -> List (Pair Term Rig) -> Pair (List (Pair Term Rig)) CanonState
canonArgs st [] = Pair [] st
canonArgs st ((Pair t r) :: rest) =
  let
    pt = canonTerm st t
    pr = canonArgs (secondOf pt) rest
  in Pair (Pair (firstOf pt) r :: firstOf pr) (secondOf pr)

canonAlts : CanonState -> List CaseAlt -> Pair (List CaseAlt) CanonState
canonAlts st [] = Pair [] st
canonAlts st ((CaseAlt n bs b) :: rest) =
  let
    pb = canonTerm st b
    pr = canonAlts (secondOf pb) rest
  in Pair (CaseAlt n bs (firstOf pb) :: firstOf pr) (secondOf pr)

canonTermTop : Term -> Term
canonTermTop t = firstOf (canonTerm canonStateEmpty t)

canonMaybe : Maybe Term -> Maybe Term
canonMaybe (Just t) = Just (canonTermTop t)
canonMaybe Nothing = Nothing

-- 定义视图：名字 + 类型 + 体（`DtDef` 的 span 不参与；vuna 的精化会 delta 展开定义，
-- 所以导出体的变化必须使依赖者失效——与 Idris2 的 `hashit = Public` 同一规则）。
defView : DtDef -> Pair String (Pair Term (Maybe Term))
defView d = Pair (dtDefName d) (Pair (canonTermTop (dtDefType d)) (canonMaybe (dtDefBody d)))

-- ---------------------------------------------------------------
-- 接口哈希的各段（C32 哈希输入侧：显式规范编码，不再 `prim_marshal`）
-- ---------------------------------------------------------------
-- 段输入先规范化顺序（`sortByText`），再由 `Canonical.*` 编码：span / 路径不参与，
-- 读方消费的字段全部覆盖（含 `ExportEntry.parent`、fixity 别名目标、record 字段类型）。
encDefView : Pair String (Pair Term (Maybe Term)) -> List String -> List String
encDefView (Pair name (Pair ty body)) acc = encStr name (encTerm ty (encMaybe encTerm body acc))

hashDefView : List String -> DtDef -> Pair String (Pair Term (Maybe Term))
hashDefView names d =
  let
    name = dtDefName d
    body = if memName name names then Nothing else dtDefBody d
  in Pair name (Pair (canonTermTop (dtDefType d)) (canonMaybe body))

hashDefs : List String -> List DtDef -> String
hashDefs names ds =
  payloadDigest
    (encTop (encList encDefView) (sortByText (\p => firstOf p) (map (hashDefView names) ds)))

hashOpaque : List String -> String
hashOpaque names = payloadDigest (encTop (encList encStr) (sortByText (\n => n) names))

-- 数据族 + 构造子 / 实例 / 类 / globals / 导出表：闭合项，无 span / 无路径，显式编码。
hashDatas : List DtData -> String
hashDatas ds = payloadDigest (encTop (encList encDtData) (sortByText (\d => dtDataName d) ds))

hashInsts : List DtInst -> String
hashInsts is = payloadDigest (encTop (encList encDtInst) (sortByText (\i => dtInstName i) is))

hashClasses : List DtClass -> String
hashClasses cs = payloadDigest (encTop (encList encDtClass) (sortByText (\c => dtClassName c) cs))

-- | globals 的（名字, 项）对。
encGlobal : Pair String Term -> List String -> List String
encGlobal (Pair n t) acc = encStr n (encTerm t acc)

hashGlobals : List (Pair String Term) -> String
hashGlobals gs = payloadDigest (encTop (encList encGlobal) (sortByText (\p => firstOf p) gs))

-- 导出条目：ctor 条目的 `parent`（所属类型）也参与键与编码（旧版漏了 → §44m 类缺口）。
exportKeyOf : ExportEntry -> String
exportKeyOf e = "${e.public}|${e.kind}|${e.target}|${e.parent}"

hashExports : List ExportEntry -> String
hashExports es = payloadDigest (encTop (encList encExportEntry) (sortByText exportKeyOf es))

-- fixity 带 span：编码器丢弃 span，只写操作符 / 级别 / 结合性 / 别名目标。
hashFixities : List FixityDecl -> String
hashFixities fs = payloadDigest (encTop (encList encFixity) fs)

-- record 头：结构化 `RecordMeta`（字段类型表达式也进编码，旧版只覆盖名字+序号 = C47 残余）。
hashRecords : List RecordMeta -> String
hashRecords recs = payloadDigest (encTop (encList encRecordMeta) recs)

-- 模块图数据（import 名 / alias / 限定标志；span 不参与）。
hashImports : List Import -> String
hashImports is = payloadDigest (encTop (encList encImport) is)

-- | 已解析源码声明（`miDecls`）的内容摘要：显式规范编码（span / 路径不参与）。
-- 旧实现完全不哈希 decls（只靠 record 头兜底），「模式形状/子句结构变了但 datas/defs
-- 没变」会漏失效（C47）；这里把它作为独立段整段纳入。
hashDecls : List Decl -> String
hashDecls ds = payloadDigest (encTop encDecls ds)

hashOfParts : String -> String -> List Import -> List Import -> List FixityDecl -> List RecordMeta -> List ExportEntry -> List Decl -> CachedProgram -> String
hashOfParts name pkg imports implicitImports fixities records exports decls cp =
  digestParts
    [ifaceHashVersion, name, pkg, hashImports imports, hashImports implicitImports, hashFixities fixities, hashRecords records, hashDecls decls, hashDatas (cachedDatas cp), hashDefs (map opaqueBaseName (cachedOpaqueOf cp)) (cachedDefs cp), hashGlobals (cachedGlobals cp), hashInsts (cachedInsts cp), hashClasses (cachedClasses cp), hashExports exports, hashOpaque (cachedOpaqueOf cp)]

export hashOfIface : ModuleIface -> String
hashOfIface m =
  hashOfParts (miNameOf m) (miPackageOf m) (miImportsOf m) (miImplicitImportsOf m) (miFixitiesOf m)
    (miRecordsOf m) (miExportsOf m) (miDeclsOf m) (miCachedOf m)

-- D11：包级双摘要。模块按名字排序后聚合；iface 摘要只含下游可见面，impl 摘要含产物面。
export pkgIfaceHashOf : PackageIface -> String
pkgIfaceHashOf (PackageIface schema compiler pkg env mods) =
  digestParts ("vuna-pkg-iface-hash 1" :: pkg :: map miIfaceHashOf (sortByText miNameOf mods))

export pkgImplHashOf : PackageIface -> String
pkgImplHashOf (PackageIface schema compiler pkg env mods) =
  digestParts ("vuna-pkg-impl-hash 1" :: pkg :: map miImplHashOf (sortByText miNameOf mods))

-- D11：产物摘要。与 ifaceHash 的差别只有 opaque body：ifaceHash 不含它，implHash 含它。
implHashOfParts : String -> String -> List RecordMeta -> List ExportEntry -> List Decl -> CachedProgram -> String
implHashOfParts name pkg records exports decls cp =
  digestParts
    ["vuna-impl-hash 1", name, pkg, hashRecords records, hashExports exports, hashDecls decls, hashDatas (cachedDatas cp), hashDefs [] (cachedDefs cp), hashGlobals (cachedGlobals cp), hashInsts (cachedInsts cp), hashClasses (cachedClasses cp)]

-- ---------------------------------------------------------------
-- 归属索引（与 codegen 同一规则）：decl/data 表命中优先，带点名字回落模块前缀。
-- 用 HashMap 而不是线性 lookupPair：一个包有上千个 global、几十个模块，线性扫描会让
-- 写接口的代价变成 O(#模块 × #声明 × #归属项)。
-- ---------------------------------------------------------------
record OwnerIndex where
  oiDef : HashMap String String
  oiData : HashMap String String
  oiCtor : HashMap String String
  oiKnown : List String

tblOwner : HashMap String String -> String -> Maybe String
tblOwner t name = Base.HashMap.lookup name t

prefixOwner : List String -> String -> Maybe String
prefixOwner knownModules name =
  let
    prefix = modulePrefixOfName name
  in if memName prefix knownModules then Just prefix else Nothing

defOwnerOf : OwnerIndex -> String -> Maybe String
defOwnerOf oi name = case tblOwner oi.oiDef name of
  Just o => Just o
  Nothing => if containsDot name then prefixOwner oi.oiKnown name else Nothing

dataOwnerOf : OwnerIndex -> String -> Maybe String
dataOwnerOf oi name = case tblOwner oi.oiData name of
  Just o => Just o
  Nothing => if containsDot name then prefixOwner oi.oiKnown name else Nothing

-- 构造子 → 数据族名；数据族自身的归属在 oiData 里。
ctorFamilyPairs : List DtData -> List (Pair String String)
ctorFamilyPairs [] = []
ctorFamilyPairs (d :: rest) =
  append (map (\c => Pair (dtCtorName c) (dtDataName d)) (dtDataCtors d)) (ctorFamilyPairs rest)

ctorOwnerOf : OwnerIndex -> String -> Maybe String
ctorOwnerOf oi name = case tblOwner oi.oiCtor name of
  Just fam => dataOwnerOf oi fam
  Nothing => Nothing

-- iface 覆盖性/归属检查用的 prelude 名单：用户可见内建 + 编译器 tracing 隐藏原语
-- （`@vuna@…` 是 prelude 共享项，不归属任何模块）。
ifacePreludeNames : List String
ifacePreludeNames = append preludeNames internalIntrinsicNames

-- global 的归属：prelude 名字（内建 primitive/原语）是共享项，不进任何模块；
-- 其余按 def / data / 构造子 → 模块前缀。
globalOwnerOf : OwnerIndex -> String -> Maybe String
globalOwnerOf oi name = if memName name ifacePreludeNames then Nothing
else case defOwnerOf oi name of
  Just o => Just o
  Nothing => case dataOwnerOf oi name of
    Just o => Just o
    Nothing => ctorOwnerOf oi name

ownerIndexOf : SplitMeta -> List DtData -> OwnerIndex
ownerIndexOf meta datas =
  OwnerIndex (Base.HashMap.fromList meta.smDefOwners) (Base.HashMap.fromList meta.smDataOwners)
    (Base.HashMap.fromList (ctorFamilyPairs datas)) meta.smKnownModules

-- M34.6：按 owner **一次分桶**。旧实现每个模块对整包 datas/defs/globals/insts/classes
-- 各做一遍 `filter`（O(#模块 × #程序项)，接口阶段 ~457ms）；这里整包扫一遍建五张
-- owner → 项表，逐模块 O(1) 取桶。桶内保持程序原顺序（前插后统一 reverse）。
-- 整包 sols 的 HashMap Int 也只建一次：旧实现每个模块切片后 `cachedOfProgram` 都
-- `HashMap.fromList (dtProgSols prog)`（O(#模块 × #sols)，本机 compiler 包接口阶段 ~40ms）。
record ProgParts where
  ppSols : HashMap Int Value
  ppDatas : HashMap String (List DtData)
  ppDefs : HashMap String (List DtDef)
  ppGlobals : HashMap String (List (Pair String Term))
  ppInsts : HashMap String (List DtInst)
  ppClasses : HashMap String (List DtClass)

partitionByOwner : (a -> Maybe String) -> List a -> HashMap String (List a)
partitionByOwner ownerOf xs =
  reverseBuckets (partitionByOwnerGo ownerOf xs (Base.HashMap.fromList []))

partitionByOwnerGo : (a -> Maybe String) -> List a -> HashMap String (List a) -> HashMap String (List a)
partitionByOwnerGo ownerOf [] tbl = tbl
partitionByOwnerGo ownerOf (x :: rest) tbl = case ownerOf x of
  Nothing => partitionByOwnerGo ownerOf rest tbl
  Just o =>
    partitionByOwnerGo ownerOf rest (Base.HashMap.insert o (Base.List.Cons x (bucketOf o tbl)) tbl)

bucketOf : String -> HashMap String (List a) -> List a
bucketOf name tbl = case Base.HashMap.lookup name tbl of
  Just xs => xs
  Nothing => []

reverseBuckets : HashMap String (List a) -> HashMap String (List a)
reverseBuckets tbl = Base.HashMap.fromList (map reverseBucket (Base.HashMap.toList tbl))

reverseBucket : Pair String (List a) -> Pair String (List a)
reverseBucket (Pair k xs) = Pair k (reverse xs)

progPartsOf : OwnerIndex -> DtProgram -> ProgParts
progPartsOf oi prog =
  ProgParts (Base.HashMap.fromList (dtProgSols prog))
    (partitionByOwner (\d => dataOwnerOf oi (dtDataName d)) (dtProgDatas prog))
    (partitionByOwner (\d => defOwnerOf oi (dtDefName d)) (dtProgDefs prog))
    (partitionByOwner (\p => globalOwnerOf oi (firstOf p)) (dtProgGlobals prog))
    (partitionByOwner (\i => defOwnerOf oi (dtInstName i)) (dtProgInsts prog))
    (partitionByOwner (\c => defOwnerOf oi (dtClassName c)) (dtProgClasses prog))

-- 单模块的闭合产物：从预分桶取切片，再用整包 sols 做一次深度 zonk。sols 表由
-- `ProgParts` 整包建一次（`cachedOfProgramWith`），不再逐模块重建。
cpOfModule : ProgParts -> DtProgram -> String -> List String -> CachedProgram
cpOfModule parts prog mod opaqueNames =
  let
    datas = bucketOf mod parts.ppDatas
    defs = bucketOf mod parts.ppDefs
    globals = bucketOf mod parts.ppGlobals
    insts = bucketOf mod parts.ppInsts
    classes = bucketOf mod parts.ppClasses
    slice =
      DtProgram datas defs [] (dtProgSols prog) globals insts classes 0 (Base.HashMap.fromList [])
        [] []
  in withCachedOpaque opaqueNames (cachedOfProgramWith parts.ppSols slice)

sourceOf : List (Pair String SourceInfo) -> String -> SourceInfo
sourceOf [] _ = SourceInfo "" "" 0 0
sourceOf ((Pair n s) :: rest) name = if n == name then s else sourceOf rest name

importNameOf : Import -> String
importNameOf = importName

importNamesOfModule : Module -> List String
importNamesOfModule m = map importNameOf (append m.moduleImportsOf m.moduleImplicitImportsOf)

-- | 依赖哈希表里是否还有"写接口时不可得"的哨兵：有则说明这份接口是在依赖接口缺失时
-- 写下的，读侧不能信任它的依赖链（要重算并重写，见 Compile 的 clean 判定）。
export hasMissingDep : List (Pair String String) -> Bool
hasMissingDep [] = False
hasMissingDep ((Pair _ h) :: rest) = h == depMissingHash || hasMissingDep rest

hashOfImportName : List (Pair String String) -> String -> String
hashOfImportName tbl name = case lookupPair name tbl of
  Just h => h
  Nothing => depMissingHash

depHashesOf : List (Pair String String) -> Module -> List (Pair String String)
depHashesOf tbl m = map (\n => Pair n (hashOfImportName tbl n)) (importNamesOfModule m)

cleanIfaceOf : List ModuleIface -> String -> Maybe ModuleIface
cleanIfaceOf [] _ = Nothing
cleanIfaceOf (m :: rest) name = if miNameOf m == name then Just m else cleanIfaceOf rest name

-- 记录分两步：先算内容 + 接口哈希（哈希**不含**依赖哈希，与 TTC 的 ifaceHash 一致），
-- 再用「全部模块 + 外部依赖」的完整哈希表回填 `miDepHashes`。这样不依赖折叠顺序，
-- 也不会出现「依赖还没算到 → 哨兵/旧值」导致下一次运行误判脏。
-- `clean` = 包内增量复用的模块（记录原样保留：重算依赖整包 sols，而增量路径没有干净
-- 模块的 sols，重算会改变擦除位残 meta 的 zonk 结果 → 哈希漂移）。
mkIfaceBase : String -> ProgParts -> DtProgram -> List (Pair String SourceInfo) -> List ModuleIface -> Module -> ModuleIface
mkIfaceBase pkg parts prog sources clean m = case cleanIfaceOf clean (moduleNameOf m) of
  Just old => old
  Nothing =>
    let
      name = moduleNameOf m
      cp = cpOfModule parts prog name (moduleOpaqueOf m)
      records = recordsOfDecls m.moduleDeclsOf
      h =
        hashOfParts name pkg m.moduleImportsOf m.moduleImplicitImportsOf m.moduleFixitiesOf records
          m.moduleExportsOf m.moduleDeclsOf cp
      hi = implHashOfParts name pkg records m.moduleExportsOf m.moduleDeclsOf cp
    in ModuleIface name pkg (sourceOf sources name) h hi [] m.moduleImportsOf m.moduleImplicitImportsOf
      m.moduleExportsOf m.moduleFixitiesOf m.moduleDeclsOf records [] cp
      (defLocsOfDefs (cachedDefs cp))

finishIface : List (Pair String String) -> List ModuleIface -> Module -> ModuleIface -> ModuleIface
finishIface tbl clean m mi = case cleanIfaceOf clean (miNameOf mi) of
  Just old => old
  Nothing =>
    ModuleIface (miNameOf mi) (miPackageOf mi) (miSourceOf mi) (miIfaceHashOf mi) (miImplHashOf mi)
      (depHashesOf tbl m) (miImportsOf mi) (miImplicitImportsOf mi) (miExportsOf mi)
      (miFixitiesOf mi) (miDeclsOf mi) (miRecordsOf mi) (miPreparedOf mi) (miCachedOf mi)
      (miDefLocsOf mi)

ifacesGo : String -> ProgParts -> DtProgram -> List (Pair String SourceInfo) -> List (Pair String String) -> List ModuleIface -> List Module -> Pair (List ModuleIface) (List (Pair String String))
ifacesGo pkg parts prog sources knownDeps clean modules =
  let
    built = map (\m => Pair m (mkIfaceBase pkg parts prog sources clean m)) modules
    hashes = map (\p => Pair (miNameOf (secondOf p)) (miIfaceHashOf (secondOf p))) built
    fullTbl = append knownDeps hashes
  in Pair (map (\p => finishIface fullTbl clean (firstOf p) (secondOf p)) built) fullTbl

-- ---------------------------------------------------------------
-- 覆盖性检查：本包模块拥有的 def/data/inst/class/global 必须全部出现在某个模块摘要里
-- （归属表漏项会让依赖方静默拿到不完整接口，所以写侧宁可失败，不写缓存）。
-- M34.6：四个成员判断改用 HashMap String Bool（旧实现对每个 artifact 名线性扫 merged
-- ~数千项，接口阶段 ~473ms）。
-- ---------------------------------------------------------------
ownerOfAny : OwnerIndex -> String -> Maybe String
ownerOfAny oi name = case defOwnerOf oi name of
  Just o => Just o
  Nothing => case dataOwnerOf oi name of
    Just o => Just o
    Nothing => ctorOwnerOf oi name

coverageIssueOf : OwnerIndex -> HashMap String Bool -> HashMap String Bool -> HashMap String Bool -> HashMap String Bool -> String -> String
coverageIssueOf oi ourNames inherited merged prelude name = if Base.HashMap.member name prelude then ""
else if Base.HashMap.member name inherited then ""
else case ownerOfAny oi name of
  Just o =>
    if o == entryOwner then ""
    else if Base.HashMap.member o ourNames then if Base.HashMap.member name merged then "" else "missing-from-iface ${name} -> ${o}"
    else ""
  Nothing => "unowned ${name}"

coverageIssueGo : OwnerIndex -> HashMap String Bool -> HashMap String Bool -> HashMap String Bool -> HashMap String Bool -> List String -> String
coverageIssueGo oi ourNames inherited merged prelude [] = ""
coverageIssueGo oi ourNames inherited merged prelude (name :: rest) =
  let
    issue = coverageIssueOf oi ourNames inherited merged prelude name
  in if issue == "" then coverageIssueGo oi ourNames inherited merged prelude rest else issue

artifactNamesOf : DtProgram -> List String
artifactNamesOf prog =
  append (map dtDataName (dtProgDatas prog))
    (append (map dtDefName (dtProgDefs prog)) (append (map dtInstName (dtProgInsts prog)) (append (map dtClassName (dtProgClasses prog)) (map firstOf (dtProgGlobals prog)))))

-- 摘要里已出现的全部名字（data / ctor / def / inst / class / global），用于覆盖性检查。
dataNamesOf : CachedProgram -> List String
dataNamesOf cp = map dtDataName (cachedDatas cp)

ctorNamesOf : CachedProgram -> List String
ctorNamesOf cp = concatMap (\d => map dtCtorName (dtDataCtors d)) (cachedDatas cp)

ifaceNamesOf : ModuleIface -> List String
ifaceNamesOf m =
  let
    cp = miCachedOf m
  in append (dataNamesOf cp)
    (append (ctorNamesOf cp) (append (map dtDefName (cachedDefs cp)) (append (map dtInstName (cachedInsts cp)) (append (map dtClassName (cachedClasses cp)) (map firstOf (cachedGlobals cp))))))

ifaceArtifactNames : List ModuleIface -> List String
ifaceArtifactNames ifaces = concatMap ifaceNamesOf ifaces

firstCoverageIssue : OwnerIndex -> List String -> List String -> List ModuleIface -> DtProgram -> Maybe String
firstCoverageIssue oi ourNames inherited ifaces prog =
  let
    merged = ifaceArtifactNames ifaces
    mergedTbl = Base.HashMap.ofNames merged
    ourTbl = Base.HashMap.ofNames ourNames
    inhTbl = Base.HashMap.ofNames inherited
    preludeTbl = Base.HashMap.ofNames ifacePreludeNames
    issue = coverageIssueGo oi ourTbl inhTbl mergedTbl preludeTbl (artifactNamesOf prog)
  in if issue == "" then Nothing else Just issue

-- ---------------------------------------------------------------
-- 包接口构造
-- ---------------------------------------------------------------
-- 本包模块 → `PackageIface` 的模块列表（拓扑序：Loader 的列表是依赖者在前的反序）。
-- 入口声明（合成模块 `Main`）暂不写接口：它没有导出面、加载侧永远从源码进；模块级
-- 增量（S4）需要时再补。
coverageResult : OwnerIndex -> List String -> List String -> List ModuleIface -> DtProgram -> Check (List ModuleIface)
coverageResult oi ourNames inherited ifaces prog = case firstCoverageIssue oi ourNames inherited ifaces prog of
  Just issue => icInternal "iface: ${issue}"
  Nothing => OkC ifaces

export ifaceOfPackage : String -> List (Pair String SourceInfo) -> List (Pair String String) -> List String -> List ModuleIface -> List Module -> List Decl -> DtProgram -> Check (List ModuleIface)
ifaceOfPackage pkg sources knownDeps inherited clean modules entryDecls prog =
  let
    ourModules = reverse (filter (\m => modulePackageOf m == pkg) modules)
    declModules = map (\m => Pair (moduleNameOf m) (moduleDeclsOf m)) modules
    meta = splitMetaOf declModules entryDecls
    oi = ownerIndexOf meta (dtProgDatas prog)
    parts = progPartsOf oi prog
    ourNames = map moduleNameOf ourModules
  in case ifacesGo pkg parts prog sources knownDeps clean ourModules of
    Pair ifaces _ => coverageResult oi ourNames inherited ifaces prog

-- ---------------------------------------------------------------
-- 单模块接口（M34.6 5a：LSP 增量写回）
-- ---------------------------------------------------------------
-- 与 `ifaceOfPackage` 同一套归属 / 接口哈希 / 覆盖性语义，只构造 `name` 这一个模块的
-- 摘要（LSP 每次请求只精化当前模块，写回也只写它）。
--   - `clean`：包内其余已判干净的模块记录（原样参与覆盖性检查，不重算）；
--   - `knownDeps`：依赖包模块的接口哈希表（调用方从依赖 manifest 汇总）；
--   - 覆盖性检查用 clean ∪ {本模块} 的 artifact 名字集合：任一 artifact 缺归属或未被
--     覆盖（例如同时还有别的脏模块被精化）⇒ Err，调用方跳过写（不写不完整摘要）。
findNamedModule : List Module -> String -> Maybe Module
findNamedModule [] _ = Nothing
findNamedModule (m :: rest) name =
  if moduleNameOf m == name then Just m else findNamedModule rest name

-- 单模块覆盖性：只要求「归属本模块的 artifact」都出现在摘要里。依赖包注入的 artifact
-- （`inherited`）与包内其它模块的 artifact 不参与（它们各自有接口，或不由本次写回负责）。
sameOwner : String -> Maybe String -> Bool
sameOwner mod (Just o) = o == mod
sameOwner mod Nothing = False

ownedByModule : OwnerIndex -> String -> String -> Bool
ownedByModule oi name artifact = sameOwner name (globalOwnerOf oi artifact)

moduleCoverageOk : OwnerIndex -> List String -> String -> DtProgram -> ModuleIface -> Bool
moduleCoverageOk oi inherited name prog mi =
  let
    present = ifaceNamesOf mi
  in allOwnedPresent oi inherited name (artifactNamesOf prog) present

allOwnedPresent : OwnerIndex -> List String -> String -> List String -> List String -> Bool
allOwnedPresent oi inherited name [] present = True
allOwnedPresent oi inherited name (a :: rest) present =
  let
    skip = memName a inherited || not (ownedByModule oi name a)
  in if skip then allOwnedPresent oi inherited name rest present
  else memName a present && allOwnedPresent oi inherited name rest present

export ifaceOfModule : String -> SourceInfo -> List (Pair String String) -> List String -> List ModuleIface -> List Module -> List Decl -> DtProgram -> String -> Check ModuleIface
ifaceOfModule pkg si knownDeps inherited clean modules entryDecls prog name =
  let
    ourModules = reverse (filter (\m => modulePackageOf m == pkg) modules)
    declModules = map (\m => Pair (moduleNameOf m) (moduleDeclsOf m)) modules
    meta = splitMetaOf declModules entryDecls
    oi = ownerIndexOf meta (dtProgDatas prog)
    parts = progPartsOf oi prog
    ourNames = map moduleNameOf ourModules
  in case findNamedModule ourModules name of
    Nothing => icInternal "iface: module ${name} is not part of the checked package"
    Just m =>
      let
        mi0 = mkIfaceBase pkg parts prog [Pair name si] [] m
        tbl =
          append knownDeps (map (\x => Pair (miNameOf x) (miIfaceHashOf x)) (append clean [mi0]))
        mi = finishIface tbl [] m mi0
        miP = case preparedForModule ourModules entryDecls name of
          Nothing => mi
          Just decls => setPrepared decls mi
      in if moduleCoverageOk oi inherited name prog miP then OkC miP
      else icInternal "iface: module ${name} has uncovered artifacts"

-- 包接口自检：schema/编译器指纹由读侧校验；这里只检查模块集合非空 + 摘要闭合。
export packageIfaceValid : PackageIface -> Bool
packageIfaceValid pi =
  pi.piSchema == ifaceSchema && length pi.piModules > 0 && allValid pi.piModules

allValid : List ModuleIface -> Bool
allValid [] = True
allValid (m :: rest) = cachedProgramValid (miCachedOf m) && allValid rest

export moduleNamesOf : List ModuleIface -> List String
moduleNamesOf [] = []
moduleNamesOf (m :: rest) = miNameOf m :: moduleNamesOf rest

--
-- 写侧只重写「接口哈希变化或文件缺失」的模块；manifest 最后原子写 = 提交点。读侧先读
-- manifest，再逐模块读文件并校验「相对路径合法 ↔ 记录名 / 接口哈希」；缺件/损坏 ⇒
export ifaceCodec : String
ifaceCodec = "module-iface 3"

-- | `SourceInfo`：路径 / 源内容摘要 / mtime / size（全部参与载荷 roundtrip）。
export encSourceInfo : SourceInfo -> List String -> List String
encSourceInfo s acc = encStr s.siPath (encStr s.siHash (encInt s.siMtime (encInt s.siSize acc)))

export decSourceInfo : Int -> Cur -> Maybe (Pair SourceInfo Cur)
decSourceInfo fuel c =
  thenPair (decStr (fuel - 1) c)
    (\path, b1 => thenPair (decStr (fuel - 1) b1) (\hash, b2 => thenPair (decInt (fuel - 1) b2) (\mtime, b3 => thenPair (decInt (fuel - 1) b3) (\size, b4 => Just (Pair (SourceInfo path hash mtime size) b4)))))

export encDepPair : Pair String String -> List String -> List String
encDepPair (Pair n h) acc = encStr n (encStr h acc)

export decDepPair : Int -> Cur -> Maybe (Pair (Pair String String) Cur)
decDepPair fuel c =
  thenPair (decStr (fuel - 1) c)
    (\n, b1 => thenPair (decStr (fuel - 1) b1) (\h, b2 => Just (Pair (Pair n h) b2)))

-- | 定义位置表条目：vuna 全名 → (spanFile, spanStartLine)。
encDefLoc : Pair String (Pair String Int) -> List String -> List String
encDefLoc (Pair name (Pair file line)) acc = encStr name (encStr file (encInt line acc))

decDefLoc : Int -> Cur -> Maybe (Pair (Pair String (Pair String Int)) Cur)
decDefLoc fuel c =
  thenPair (decStr (fuel - 1) c)
    (\name, b1 => thenPair (decStr (fuel - 1) b1) (\file, b2 => thenPair (decInt (fuel - 1) b2) (\line, b3 => Just (Pair (Pair name (Pair file line)) b3))))

-- | `ModuleIface` 的规范编码（字段顺序 = record 声明顺序）。
encModuleIfacePayload : ModuleIface -> List String -> List String
encModuleIfacePayload m acc =
  encStr m.miName
    (encStr m.miPackage (encSourceInfo m.miSource (encStr m.miIfaceHash (encStr m.miImplHash (encList encDepPair m.miDepHashes (encList encImport m.miImports (encList encImport m.miImplicitImports (encList encExportEntry m.miExports (encList encFixity m.miFixities (encList encDecl m.miDecls (encList encRecordMeta m.miRecords (encList encDecl m.miPrepared (encCachedProgram m.miCached (encList encDefLoc m.miDefLocs acc))))))))))))))

-- | `ModuleIface` 载荷字节（落盘用）。
export encModuleIfaceAt : ModuleIface -> List String -> List String
encModuleIfaceAt = encModuleIfacePayload

export encModuleIface : ModuleIface -> String
encModuleIface m = encTop encModuleIfacePayload m

export decModuleIfaceAt : Int -> Cur -> Maybe (Pair ModuleIface Cur)
decModuleIfaceAt = decModuleIfacePayload

decModuleIfacePayload : Int -> Cur -> Maybe (Pair ModuleIface Cur)
decModuleIfacePayload fuel c = do
  p1 <- decStr (fuel - 1) c
  p2 <- decStr (fuel - 1) (secondOf p1)
  p3 <- decSourceInfo (fuel - 1) (secondOf p2)
  p4 <- decStr (fuel - 1) (secondOf p3)
  p5 <- decStr (fuel - 1) (secondOf p4)
  p6 <- decList decDepPair (fuel - 1) (secondOf p5)
  p7 <- decList decImport (fuel - 1) (secondOf p6)
  p8 <- decList decImport (fuel - 1) (secondOf p7)
  p9 <- decList decExportEntry (fuel - 1) (secondOf p8)
  p10 <- decList decFixity (fuel - 1) (secondOf p9)
  p11 <- decList decDecl (fuel - 1) (secondOf p10)
  p12 <- decList decRecordMeta (fuel - 1) (secondOf p11)
  p13 <- decList decDecl (fuel - 1) (secondOf p12)
  p14 <- decCachedProgram (fuel - 1) (secondOf p13)
  p15 <- decList decDefLoc (fuel - 1) (secondOf p14)
  pure
    (Pair (ModuleIface (firstOf p1) (firstOf p2) (firstOf p3) (firstOf p4) (firstOf p5) (firstOf p6) (firstOf p7) (firstOf p8) (firstOf p9) (firstOf p10) (firstOf p11) (firstOf p12) (firstOf p13) (firstOf p14) (firstOf p15)) (secondOf p15))

export decModuleIfaceComplete : String -> Maybe ModuleIface
decModuleIfaceComplete s = case decModuleIfacePayload (strLength s) (curOf s) of
  Nothing => Nothing
  Just (Pair m rest) => if curAtEnd rest then Just m else Nothing
