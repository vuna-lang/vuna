module Vuna.Compiler.Driver.CompilerCli where

-- Vuna.Compiler.Driver.CompilerCli：编译器自己的 CLI（vuna-compiler）。
--
-- M24 起唯一路径是 DT（精化 + 逐模块擦除 codegen）：compile / check / build。
-- M26：包上下文统一——`compile` 与 `build` 都产**目录**（split + build.sh），
-- 不再有 seed 子命令、split 开关与环境根 flag（移除时给出可操作提示）。
-- 工具命令（lint / interp / test / fmt / repl / doc）在 Vuna.Cli。
--
-- 效果显式化：命令分发后的执行、打印/诊断/警告、workspace 并行 spawn/wait、recovery
-- 路径全部显式在 `Eff hostRow` 里；纯逻辑（参数解析、help/usage 文本、路径判断、诊断文本
-- 拼装）保持纯函数。`CliOpts` 也没有 ambient 存储：入口构造一次后作为显式参数沿命令链
-- 传递，需要写回的地方（manifest 诊断配置、sarif/json 收集）返回更新后的 `CliOpts`
-- （`Pair Int CliOpts`）。
import Base.HostRow
import Vuna.Compiler.Common
import Vuna.Compiler.Fingerprint
import Vuna.Compiler.Diagnostics.Sink
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Wasm
import Vuna.Compiler.Driver.Native
import Vuna.Compiler.Store
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Version
import Vuna.Compiler.Diag
import Vuna.Compiler.Diag.Format
import Vuna.Compiler.Frontend.Manifest
import Base.Nat
import Base.List

-- | CLI 辅助：compilerUsageLines（参数/退出码约定见 tooling.md）。
export compilerUsageLines : String -> String
compilerUsageLines prog = """  ${prog} compile [--no-print] [--release] [--target ocaml|wasm|native] (<entry.vuna> | <package-dir>) <out-dir>
  ${prog} check [--release] [--continue-on-error] (<file.vuna> | <package-dir>)
  <file.vuna>                   带 module 头 → 按库模块检查（包上下文）；无头 → 入口文件
  ${prog} build [--release] [--no-compile] [--out DIR] [--package NAME] [--target ocaml|wasm|native] [DIR]
  --no-print                    compile 生成的程序不打印 main 结果（默认打印）
  --release                     release 构建：拒绝 assert / todo 等 debug 专用构造
  --continue-on-error           best-effort 多错误：逐次移除失败声明后继续（仅入口文件）
  ${prog} version, --version          显示版本
  ${prog} help, -h
"""

compilerUsage : String -> String
compilerUsage prog = "usage:\n${compilerUsageLines prog}"

-- 效果辅助：按顺序对每个元素执行动作（顺序与纯 `map` 一致，结果收集成 List）。
mapEff : (a -> Eff hostRow b) -> List a -> Eff hostRow (List b)
mapEff f [] = pure []
mapEff f (x :: rest) = do
  y <- f x
  ys <- mapEff f rest
  pure (y :: ys)

-- | CLI 辅助：runCompilerCli（参数/退出码约定见 tooling.md）。
export runCompilerCli : List String -> Eff hostRow Int
runCompilerCli args = runCompilerCliFor "vuna-compiler" args

-- CLI 选项集中状态：入口构造一次，命令链显式传递（M4：不再有 ambient 存储）。
record CliOpts where
  optDiagFormat : String
  optDiagLang : String
  optLangExplicit : Bool
  optDenyWarnings : Bool
  optShowWarnings : Bool
  optFormatExplicit : Bool
  optWarningsExplicit : Bool
  optDenyExplicit : Bool
  optMaxErrors : Int
  optContinueOnError : Bool
  optSarifItems : List Diagnostic
  optRelease : Bool
  optShowCascade : Bool
  optWithSources : Bool
  optFailFast : Bool
  optTarget : String

defaultCliOpts : CliOpts
defaultCliOpts =
  CliOpts "short" "en" False False False False False False 20 False [] False False False False
    "ocaml"

-- | 在已有 opts 上打开 release 模式（`--release`）。
markRelease : CliOpts -> CliOpts
markRelease o = { o | optRelease = True }

-- | 选择后端目标；M1 只允许 ocaml | wasm。
markTarget : String -> CliOpts -> CliOpts
markTarget t o =
  CliOpts o.optDiagFormat o.optDiagLang o.optLangExplicit o.optDenyWarnings o.optShowWarnings
    o.optFormatExplicit o.optWarningsExplicit o.optDenyExplicit o.optMaxErrors o.optContinueOnError
    o.optSarifItems o.optRelease o.optShowCascade o.optWithSources o.optFailFast t

-- | 强制「格式由命令行显式给出」（机器格式的单文档契约用；成员 manifest 不得改格式）。
-- 位构造而非记录更新：记录更新在该位置触发当前精化器的 erased binder 问题。
markFormatExplicit : CliOpts -> CliOpts
markFormatExplicit o =
  CliOpts o.optDiagFormat o.optDiagLang o.optLangExplicit o.optDenyWarnings o.optShowWarnings True
    o.optWarningsExplicit o.optDenyExplicit o.optMaxErrors o.optContinueOnError o.optSarifItems
    o.optRelease o.optShowCascade o.optWithSources o.optFailFast o.optTarget

-- 显式 state 辅助：把不改 opts 的动作结果带回（退出码 + 当前 CliOpts）。
withOpts : CliOpts -> Eff hostRow Int -> Eff hostRow (Pair Int CliOpts)
withOpts o m = do
  code <- m
  pure (Pair code o)

diagExitFor : Diagnostic -> Int
diagExitFor d = if d.diagInternal then 70
else case d.diagSeverity of
  SevError => 1
  _ => 0

-- 按当前格式输出收集到的 sarif/json 诊断；返回原退出码。
flushSarif : Int -> CliOpts -> Eff hostRow Int
flushSarif code o =
  let
    shown = takeDiags o.optMaxErrors o.optSarifItems
  in if o.optDiagFormat == "sarif" then do
    _ <- raiseToRow hostRow (@vuna@prim_eff_print (renderSarif shown ++ "\n"))
    pure code
  else if o.optDiagFormat == "json" then do
    if o.optWithSources then do
      sources <- sourcePairsEff (reverse (collectLabelFiles shown []))
      _ <-
        raiseToRow hostRow
          (@vuna@prim_eff_print (renderJsonListWithSources o.optDiagLang shown sources ++ "\n"))
      pure code
    else do
      _ <- raiseToRow hostRow (@vuna@prim_eff_print (renderJsonList o.optDiagLang shown ++ "\n"))
      pure code
  else pure code

-- 应用 vuna.toml [diagnostics]（命令行显式 flag 优先），返回合并后的 opts。
applyDiagConfig : Maybe Package -> CliOpts -> CliOpts
applyDiagConfig m o = applyManifestOpts m o

applyManifestOpts : Maybe Package -> CliOpts -> CliOpts
applyManifestOpts Nothing o = o
applyManifestOpts (Just pkg) o =
  let
    man = pkg.packageManifest
    fmt0 = case man.manifestDiagFormat of
      Just f => f
      Nothing => o.optDiagFormat
    lang = if o.optLangExplicit then o.optDiagLang
    else case man.manifestDiagLang of
      Just l => l
      Nothing => o.optDiagLang
    fmt =
      if o.optFormatExplicit then o.optDiagFormat
      else if lang == "en" then fmt0 else if man.manifestDiagFormat == Nothing then "human" else fmt0
    showW = if o.optWarningsExplicit then o.optShowWarnings
    else case man.manifestDiagWarnings of
      Just b => b
      Nothing => o.optShowWarnings
    deny = if o.optDenyExplicit then o.optDenyWarnings
    else case man.manifestDiagDenyWarnings of
      Just b => b
      Nothing => o.optDenyWarnings
    showW2 = if deny then True else showW
    maxE = case man.manifestDiagMaxErrors of
      Just n => n
      Nothing => o.optMaxErrors
  in CliOpts fmt lang o.optLangExplicit deny showW2 o.optFormatExplicit o.optWarningsExplicit
    o.optDenyExplicit maxE o.optContinueOnError o.optSarifItems o.optRelease o.optShowCascade
    o.optWithSources o.optFailFast o.optTarget

-- --fail-fast：只显示首条诊断（与 --max-errors 取较小者语义）。
maxErrorsOf : CliOpts -> Int
maxErrorsOf o = if o.optFailFast then 1 else o.optMaxErrors

-- | 诊断/告警实现：takeDiags（详见 diagnostics.md）。
takeDiags : Int -> List Diagnostic -> List Diagnostic
takeDiags n ds = if n <= 0 then ds else takeDiagsGo n ds

-- | 诊断/告警实现：takeDiagsGo（详见 diagnostics.md）。
takeDiagsGo : Int -> List Diagnostic -> List Diagnostic
takeDiagsGo n [] = []
takeDiagsGo n (d :: rest) = if n <= 0 then [] else Base.List.Cons d (takeDiagsGo (n - 1) rest)

-- | 诊断/告警实现：stripDenyWarnings（详见 diagnostics.md）。
stripDenyWarnings : List String -> List String
stripDenyWarnings [] = []
stripDenyWarnings (arg :: rest) =
  if arg == "--deny-warnings" || arg == "--warnings" || arg == "-W" then stripDenyWarnings rest
  else arg :: stripDenyWarnings rest

-- | 诊断/告警实现：hasDenyWarnings（详见 diagnostics.md）。
hasDenyWarnings : List String -> Bool
hasDenyWarnings [] = False
hasDenyWarnings (arg :: rest) = if arg == "--deny-warnings" then True else hasDenyWarnings rest

-- 级联折叠：默认只显示 direct 诊断；--show-cascade 打开恢复路径的级联错误。
hasShowCascade : List String -> Bool
hasShowCascade [] = False
hasShowCascade (arg :: rest) = if arg == "--show-cascade" then True else hasShowCascade rest

stripShowCascade : List String -> List String
stripShowCascade [] = []
stripShowCascade ("--show-cascade" :: rest) = stripShowCascade rest
stripShowCascade (arg :: rest) = arg :: stripShowCascade rest

hasWithSources : List String -> Bool
hasWithSources [] = False
hasWithSources (arg :: rest) = if arg == "--with-sources" then True else hasWithSources rest

hasFailFast : List String -> Bool
hasFailFast [] = False
hasFailFast (arg :: rest) = if arg == "--fail-fast" then True else hasFailFast rest

stripFailFast : List String -> List String
stripFailFast [] = []
stripFailFast ("--fail-fast" :: rest) = stripFailFast rest
stripFailFast (arg :: rest) = arg :: stripFailFast rest

stripWithSources : List String -> List String
stripWithSources [] = []
stripWithSources ("--with-sources" :: rest) = stripWithSources rest
stripWithSources (arg :: rest) = arg :: stripWithSources rest

-- JSON 的 source 身份：收集诊断引用的文件并附内容摘要（--with-sources）。
collectLabelFiles : List Diagnostic -> List String -> List String
collectLabelFiles [] acc = acc
collectLabelFiles (d :: rest) acc = collectLabelFiles rest (labelFiles d.diagLabels acc)

labelFiles : List Label -> List String -> List String
labelFiles [] acc = acc
labelFiles (l :: rest) acc = labelFiles rest (case l.labelSpan of
  Nothing => acc
  Just sp => if sp.spanFile == "" || memStr sp.spanFile acc then acc else sp.spanFile :: acc
)

memStr : String -> List String -> Bool
memStr s [] = False
memStr s (x :: rest) = if s == x then True else memStr s rest

-- 源身份：文件 + 内容摘要 + 最近祖先包的包名 + 包相对路径 + 模块名。
lastSlashGo : List Int -> Int -> Int -> Int
lastSlashGo [] _ last = last
lastSlashGo (c :: rest) idx last = lastSlashGo rest (idx + 1) (if c == 47 then idx else last)

lastSlashIndexOf : String -> Int
lastSlashIndexOf s = lastSlashGo (strUnpack s) 0 (0 - 1)

dirOf : String -> String
dirOf path =
  let
    n = lastSlashIndexOf path
  in if n < 0 then "." else if n == 0 then "/" else substring 0 (natFromInt n) path

stripPathPrefix : String -> String -> String
stripPathPrefix base file =
  if startsWith "${base}/" file then substring (natFromInt (strLength base + 1)) (natFromInt (strLength file - strLength base - 1))
    file
  else file

splitSlash : String -> List String
splitSlash s = splitSlashGo (strUnpack s) [] []

splitSlashGo : List Int -> List Int -> List String -> List String
splitSlashGo [] cur acc = reverse (strPack (reverse cur) :: acc)
splitSlashGo (c :: rest) cur acc =
  if c == 47 then splitSlashGo rest [] (strPack (reverse cur) :: acc)
  else splitSlashGo rest (c :: cur) acc

moduleOfRel : String -> String
moduleOfRel rel =
  let
    rel1 =
      if startsWith "lib/" rel then substring (natFromInt 4) (natFromInt (strLength rel - 4)) rel
      else if startsWith "app/" rel then substring (natFromInt 4) (natFromInt (strLength rel - 4)) rel
      else rel
    rel2 =
      if endsWith ".vuna" rel1 then substring 0 (natFromInt (strLength rel1 - 5)) rel1 else rel1
  in join "." (splitSlash rel2)

findPkgRootGo : Int -> String -> Eff hostRow (Pair String String)
findPkgRootGo fuel dir = if fuel <= 0 then pure (Pair "" "")
else
  let
    candidate = if dir == "/" then "/vuna.toml" else "${dir}/vuna.toml"
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists candidate)
    if exists then do
      text <- raiseToRow hostRow (@vuna@prim_eff_readFile candidate)
      let
        name = case Vuna.Compiler.Frontend.Manifest.parseManifest candidate text of
          OkC man => case man.manifestName of
            Nothing => ""
            Just n => n
          ErrC _ => ""
      in pure (Pair dir name)
    else if dir == "/" || dir == "." then pure (Pair "" "") else findPkgRootGo (fuel - 1) (dirOf dir)

sourceRefEff : String -> Eff hostRow SourceRef
sourceRefEff file = do
  abs <- absolutePath file
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists abs)
  digest <- if exists then do
    text <- raiseToRow hostRow (@vuna@prim_eff_readFile abs)
    pure (strFromInt (Vuna.Compiler.Fingerprint.textHashOf text))
  else pure ""
  root <- findPkgRootGo 12 (dirOf abs)
  let
    pkgDir = firstOf root
    pkgName = secondOf root
    rel = if pkgDir == "" then file else stripPathPrefix pkgDir abs
  in pure (SourceRef file digest pkgName (moduleOfRel rel) rel)

sourcePairsEff : List String -> Eff hostRow (List SourceRef)
sourcePairsEff [] = pure []
sourcePairsEff (f :: rest) = do
  more <- sourcePairsEff rest
  ref <- sourceRefEff f
  pure (ref :: more)

isCascadeDiag : Diagnostic -> Bool
isCascadeDiag d = case d.diagOrigin of
  OriginCascade _ => True
  OriginDirect => False

-- 过滤后若一条不剩，退回原列表（级联是唯一诊断时不能静默）。
isTextDiagFormat : String -> Bool
isTextDiagFormat f = f == "short" || f == "human"

visibleDiags : CliOpts -> List Diagnostic -> List Diagnostic
visibleDiags o ds = if o.optShowCascade || not (isTextDiagFormat o.optDiagFormat) then ds
else
  let
    kept = filter (\d => not (isCascadeDiag d)) ds
  in if length kept == 0 && length ds > 0 then ds else kept

-- | 诊断/告警实现：hasShowWarnings（详见 diagnostics.md）。
hasShowWarnings : List String -> Bool
hasShowWarnings [] = False
hasShowWarnings (arg :: rest) =
  if arg == "--warnings" || arg == "-W" then True else hasShowWarnings rest

-- | 诊断/告警实现：hasFormatFlag（详见 diagnostics.md）。
hasFormatFlag : List String -> Bool
hasFormatFlag [] = False
hasFormatFlag (arg :: rest) =
  if arg == "--json" || startsWith "--error-format" arg || startsWith "--message-format" arg then True
  else hasFormatFlag rest

-- | 剥离并解析诊断格式参数。
stripDiagFormat : List String -> Pair (List String) (Maybe String)
stripDiagFormat args = stripDiagFormatGo args [] Nothing

-- | 诊断格式参数扫描实现。
stripDiagFormatGo : List String -> List String -> Maybe String -> Pair (List String) (Maybe String)
stripDiagFormatGo [] acc found = Pair (reverse acc) found
stripDiagFormatGo ("--json" :: rest) acc found = stripDiagFormatGo rest acc (Just "json")
stripDiagFormatGo ("--error-format" :: rest) acc found = case rest of
  value :: more => stripDiagFormatGo more acc (Just value)
  [] => Pair (reverse acc) (Just "short")
stripDiagFormatGo (arg :: rest) acc found =
  if startsWith "--error-format=" arg then stripDiagFormatGo rest acc
    (Just (substring (natFromInt 15) (natFromInt (strLength arg - 15)) arg))
  else if startsWith "--message-format=" arg then stripDiagFormatGo rest acc
    (Just (substring (natFromInt 17) (natFromInt (strLength arg - 17)) arg))
  else stripDiagFormatGo rest (arg :: acc) found

-- 终端探测：用一次 sh 判定 stdout 是否 TTY（不加原语、不动 TCB；同 REPL 的 stty 做法）。
stdoutIsTty : Eff hostRow Bool
stdoutIsTty = do
  code <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["sh", "-c", "[ -t 1 ]"])
  pure (code == 0)

-- | 编译器 CLI 入口：剥离诊断参数后分发。
export runCompilerCliFor : String -> List String -> Eff hostRow Int
runCompilerCliFor prog args = do
  envRel <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_RELEASE")
  tty <- stdoutIsTty
  let
    stripped = stripDiagFormat args
    strippedLang = stripLang (firstOf stripped)
    strippedMax = stripMaxErrors (firstOf strippedLang)
    kept = stripDenyWarnings (firstOf strippedMax)
    strippedContinue = stripContinueOnError kept
    detectedLang = secondOf strippedLang
    -- 默认格式按消费端选：交互终端用 human（片段/note），管道/CI 用 short（稳定首行）。
    fmt = case secondOf stripped of
      Just f => f
      Nothing => if detectedLang == "en" then if tty then "human" else "short" else "human"
    opts =
      CliOpts fmt detectedLang (hasLangFlag args) (hasDenyWarnings args)
        (hasDenyWarnings args || hasShowWarnings args) (hasFormatFlag args)
        (hasDenyWarnings args || hasShowWarnings args) (hasDenyWarnings args) (secondOf strippedMax)
        (secondOf strippedContinue) [] (envRel == "1") (hasShowCascade args) (hasWithSources args)
        (hasFailFast args) "ocaml"
  in if anyHelp (firstOf strippedContinue) then helpFor prog
  else do
    r <-
      runCompilerCliFor1 prog
        (stripFailFast (stripWithSources (stripShowCascade (firstOf strippedContinue)))) opts
    flushSarif (firstOf r) (secondOf r)

-- 剥离 `--max-errors N`（写入全局上限；缺省 20，0 = 不限）。
-- | 诊断参数解析：十进制数字，失败用默认值。
parseIntOr : String -> Int -> Int
parseIntOr s fallback = parseIntChars (strUnpack s) 0 0 fallback

-- | 十进制数字逐字符解析。
parseIntChars : List Int -> Int -> Int -> Int -> Int
parseIntChars [] acc count fallback = if count == 0 then fallback else acc
parseIntChars (c :: cs) acc count fallback =
  if c >= 48 && c <= 57 then parseIntChars cs (acc * 10 + (c - 48)) (count + 1) fallback
  else if count == 0 then fallback else acc

-- | 剥离并解析 --max-errors（写入全局上限）。
stripMaxErrors : List String -> Pair (List String) Int
stripMaxErrors args = stripMaxErrorsGo args [] 20

-- | --max-errors 参数扫描实现。
stripMaxErrorsGo : List String -> List String -> Int -> Pair (List String) Int
stripMaxErrorsGo [] acc n = Pair (reverse acc) n
stripMaxErrorsGo ("--max-errors" :: rest) acc n = case rest of
  v :: more => stripMaxErrorsGo more acc (parseIntOr v n)
  [] => Pair (reverse acc) n
stripMaxErrorsGo (arg :: rest) acc n =
  if startsWith "--max-errors=" arg then stripMaxErrorsGo rest acc
    (parseIntOr (substring (natFromInt 13) (natFromInt (strLength arg - 13)) arg) n)
  else stripMaxErrorsGo rest (arg :: acc) n

-- | 编译器 CLI 子命令分发。
runCompilerCliFor1 : String -> List String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
runCompilerCliFor1 prog args o = case args of
  [] => withOpts o (usageErr prog)
  arg :: rest => case arg of
    "compile" => compileArgs prog rest o
    "check" => checkArgs prog rest o
    "build" => buildArgs prog rest o
    "version" => withOpts o (printVersion 0)
    "--version" => withOpts o (printVersion 0)
    "seed" =>
      withOpts o (removedCommand prog "seed" "use `build --out OUT [DIR]` or `compile DIR OUT`")
    "help" => withOpts o (helpFor prog)
    _ =>
      if startsWith "-" arg then withOpts o (removedFlag prog arg)
      else withOpts o (unknownCommand prog arg)

printVersion : Int -> Eff hostRow Int
printVersion _ = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "vuna-compiler ${vunaVersion}\n")
  pure 0

-- | 参数里是否含 -h/--help。
anyHelp : List String -> Bool
anyHelp [] = False
anyHelp (arg :: rest) = if arg == "-h" || arg == "--help" then True else anyHelp rest

-- | CLI 辅助：helpFor（参数/退出码约定见 tooling.md）。
helpFor : String -> Eff hostRow Int
helpFor prog = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print (compilerUsage prog))
  pure 0

-- | CLI 辅助：usageErr（参数/退出码约定见 tooling.md）。
usageErr : String -> Eff hostRow Int
usageErr prog = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print (compilerUsage prog))
  pure 2

-- | CLI 辅助：unknownCommand（参数/退出码约定见 tooling.md）。
unknownCommand : String -> String -> Eff hostRow Int
unknownCommand prog arg = do
  _ <-
    raiseToRow hostRow
      (@vuna@prim_eff_print "error: unknown command `${arg}`\nrun `${prog} help` for the command list\n")
  pure 2

removedCommand : String -> String -> String -> Eff hostRow Int
removedCommand prog cmd hint = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print "error: `${cmd}` has been removed; ${hint}\n")
  pure 2

-- 被删除 flag 的可操作提示（Vuna.Cli 的工具命令复用同一张表）。
-- flag 名用「两条横线 + 名字」拼接：M26 验收要求源码中不再出现已删除 flag 的字面量
-- （尤其环境根 flag），同时保留可操作提示。
dashFlag : String -> String
dashFlag name = "--${name}"

export removedFlagHint : String -> Maybe String
removedFlagHint flag =
  if flag == dashFlag "dt" then Just "DT is the only path; drop the flag"
  else if flag == dashFlag "package" then Just "use `build` or `compile`"
  else if flag == dashFlag "split" then Just "split is the only output model; use `build --out OUT [DIR]` or `compile <pkg-dir> OUT`"
  else if flag == dashFlag "root" then Just "module resolution is decided by the nearest vuna.toml; set VUNA_BASE for standalone files"
  else if flag == dashFlag "out" then Just "pass OUTDIR positionally to `compile`; `build` accepts --out DIR"
  else if flag == dashFlag "no-typecheck" then Just "checking is always enabled"
  else if flag == dashFlag "typecheck" then Just "checking is always enabled"
  else if flag == dashFlag "typed" then Just "DT is the only path" else Nothing

-- | CLI 辅助：removedFlag（参数/退出码约定见 tooling.md）。
removedFlag : String -> String -> Eff hostRow Int
removedFlag prog flag = case removedFlagHint flag of
  Nothing => usageErr prog
  Just hint => do
    _ <- raiseToRow hostRow (@vuna@prim_eff_print "error: ${flag} has been removed; ${hint}\n")
    pure 2

-- 文本输出：直接打印。诊断片段由 emitDiag 用结构化 label 渲染（见 Diag.Format），
-- 不再从消息文本里反解析 `file:line:col`。用法/工具错误（无 span）原样输出。
-- | CLI 辅助：printErrText（参数/退出码约定见 tooling.md）。
printErrText : String -> Eff hostRow Int
printErrText e = do
  _ <- raiseToRow hostRow (@vuna@prim_eff_print e)
  pure 1

-- | 诊断/告警实现：severityLabelOf（详见 diagnostics.md）。
severityLabelOf : Diagnostic -> String
severityLabelOf d = case d.diagSeverity of
  SevError => "error"
  SevWarning => "warning"
  SevNote => "note"
  SevHelp => "help"

-- 单条诊断按当前格式输出并返回退出码；json/sarif 时把诊断收集进 opts（显式写回）。
emitDiag : CliOpts -> String -> Diagnostic -> Eff hostRow (Pair Int CliOpts)
emitDiag o extra d = if o.optDiagFormat == "json" then pure (Pair (diagExitFor d) (collectSarifIn o d))
else if o.optDiagFormat == "human" then do
  msg <- renderHuman o.optDiagLang d
  _ <- printErrText (msg ++ "\n")
  pure (Pair (diagExitFor d) o)
else if o.optDiagFormat == "sarif" then pure (Pair (diagExitFor d) (collectSarifIn o d))
else if o.optDiagFormat == "github" then do
  _ <- printErrText (renderGithub d ++ "\n")
  pure (Pair (diagExitFor d) o)
else do
  -- short：首行保持 `error: [pkg] file:line:col: [CODE] 消息`；片段从 label 结构化渲染。
  snippet <- renderShortSnippetEff d
  _ <- printErrText (severityLabelOf d ++ ": " ++ extra ++ renderShort d ++ snippet ++ "\n")
  pure (Pair (diagExitFor d) o)

-- sarif/json 诊断收集（写回 CliOpts，显式 state 传递）。
collectSarifIn : CliOpts -> Diagnostic -> CliOpts
collectSarifIn o d = { o | optSarifItems = append o.optSarifItems [d] }

-- 从尾到头逐条输出诊断（丢弃退出码），累积更新后的 opts。旧代码里的
-- `_ = map f xs` 依赖 `f x :: map f rest` 的右侧优先求值，打印/收集顺序是从尾到头；
-- 这里保持逐字不变。
emitDiagRevSeq : CliOpts -> String -> List Diagnostic -> Eff hostRow CliOpts
emitDiagRevSeq o extra [] = pure o
emitDiagRevSeq o extra (d :: rest) = do
  o1 <- emitDiagRevSeq o extra rest
  r <- emitDiag o1 extra d
  pure (secondOf r)

printDiagWithPrefix : CliOpts -> String -> Diagnostic -> Eff hostRow (Pair Int CliOpts)
printDiagWithPrefix o extra d = case d.diagChildren of
  [] => emitDiag o extra d
  _ =>
    let
      shown = takeDiags (maxErrorsOf o) (d :: visibleDiags o d.diagChildren)
    in do
      o1 <- emitDiagRevSeq o extra shown
      pure (Pair (diagExitFor d) o1)

-- | 输出错误诊断并返回退出码。
printDiag : CliOpts -> Diagnostic -> Eff hostRow (Pair Int CliOpts)
printDiag o d = printDiagWithPrefix o "" d

-- | 诊断输出辅助：printErr。
printErr : String -> Eff hostRow Int
printErr e = printErrText "error: ${e}\n"

-- | 诊断/告警实现：printDiagList（详见 diagnostics.md）。
printDiagList : CliOpts -> String -> List Diagnostic -> Eff hostRow (Pair Int CliOpts)
printDiagList o extra ds =
  let
    shown = takeDiags (maxErrorsOf o) (visibleDiags o ds)
  in do
    o1 <- emitDiagRevSeq o extra shown
    pure (Pair 0 o1)

defaultDir : Maybe String -> String
defaultDir (Just dir2) = dir2
defaultDir Nothing = "."

-- 路径既不是文件也不是目录时的统一错误（先 @vuna@prim_eff_fileExists 再 @vuna@prim_eff_isDirectory：
-- 内建 @vuna@prim_eff_isDirectory 对不存在的路径会抛异常）。
-- | CLI 辅助：dtPathErr（参数/退出码约定见 tooling.md）。
dtPathErr : String -> Eff hostRow Int
dtPathErr path = printErr "no such file or package directory: ${path}"

-- 可执行包解析：必须是目录、能读 vuna.toml、且有 app/Main.vuna。
executablePackage : String -> String -> Eff hostRow (Check Package)
executablePackage label dir = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists dir)
  if exists then do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory dir)
    if isDir then executablePackageAt label dir
    else pure (err "${label}: expects a package directory, not a file: ${dir}")
  else pure (err "no such file or package directory: ${dir}")

executablePackageAt : String -> String -> Eff hostRow (Check Package)
executablePackageAt label dir = do
  pkgR <- loadPackage dir
  case pkgR of
    ErrC e => pure (ErrC e)
    OkC pkg => do
      exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists (packageEntry pkg))
      if exists then pure (OkC pkg)
      else pure
        (err "${label}: library package ${packageName pkg} has no app/Main.vuna (executable package required)")

-- ---------------------------------------------------------------
-- compile：文件入口（最近的 vuna.toml 包上下文 / 无 manifest 的 base-only）
-- 或包目录入口（可执行包），逐模块写出到 OUTDIR；成功静默。
-- ---------------------------------------------------------------
-- | CLI 辅助：compileArgs（参数/退出码约定见 tooling.md）。
compileArgs : String -> List String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
compileArgs prog args o = compileParse prog True Nothing Nothing args o

compileParse : String -> Bool -> Maybe String -> Maybe String -> List String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
compileParse prog printResult entry outDir args o = case args of
  [] => compileFinish prog printResult entry outDir o
  "--no-print" :: rest => compileParse prog False entry outDir rest o
  "--release" :: rest => compileParse prog printResult entry outDir rest (markRelease o)
  "--target" :: t :: rest => compileParse prog printResult entry outDir rest (markTarget t o)
  arg :: rest => if startsWith "-" arg then withOpts o (removedFlag prog arg)
  else case entry of
    Nothing => compileParse prog printResult (Just arg) outDir rest o
    Just _ => case outDir of
      Nothing => compileParse prog printResult entry (Just arg) rest o
      Just _ => withOpts o (usageErr prog)

compileFinish : String -> Bool -> Maybe String -> Maybe String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
compileFinish prog printResult Nothing outDir o = withOpts o (usageErr prog)
compileFinish prog printResult (Just e) outDir o = case outDir of
  Nothing => withOpts o (usageErr prog)
  Just out => compileRun printResult e out o

compileRun : Bool -> String -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
compileRun printResult entry outDir o = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists entry)
  if exists then do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory entry)
    if isDir then compilePkgDir printResult entry outDir o
    else compileFileEntry printResult entry outDir o
  else withOpts o (dtPathErr entry)

-- | 按 `--target` 选择后端；wasm/native 分支不产 OCaml split 目录。
compileToTarget : PackageContext -> String -> Bool -> String -> String -> Eff hostRow (Check (Pair Int (List Diagnostic)))
compileToTarget ctx entry printResult outDir target = if target == "wasm" then do
  r <- compileWasm ctx entry printResult outDir
  pure (case r of
    ErrC e => ErrC e
    OkC n => OkC (Pair n [])
  )
else if target == "native" then do
  r <- compileNative ctx entry printResult outDir
  pure (case r of
    ErrC e => ErrC e
    OkC n => OkC (Pair n [])
  )
else compileToDir ctx entry printResult outDir

compileFileEntry : Bool -> String -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
compileFileEntry printResult entry outDir o = do
  ctxR <- contextForFile entry
  case ctxR of
    ErrC e => printDiag o e
    OkC ctx0 =>
      let
        ctx = contextWithRelease o.optRelease ctx0
        o1 = applyDiagConfig (contextPackageOf ctx) o
      in do
        r <- compileToTarget ctx entry printResult outDir o.optTarget
        case r of
          ErrC e => printDiag o1 e
          OkC p => finishWarningsDir (secondOf p) o1 outDir 0

compilePkgDir : Bool -> String -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
compilePkgDir printResult dir outDir o = do
  pkgR <- executablePackage "compile" dir
  case pkgR of
    ErrC e => printDiag o e
    OkC pkg =>
      let
        o1 = applyDiagConfig (Just pkg) o
      in do
        r <-
          compileToTarget (contextWithRelease o.optRelease (packageContext pkg)) (packageEntry pkg)
            printResult outDir o.optTarget
        case r of
          ErrC e => printDiag o1 e
          OkC p => finishWarningsDir (secondOf p) o1 outDir 0

-- ---------------------------------------------------------------
-- check：文件入口（包上下文）或包目录（可执行包 check 入口；库包 check [export].modules）
-- ---------------------------------------------------------------
-- | CLI 辅助：checkArgs（参数/退出码约定见 tooling.md）。
checkArgs : String -> List String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkArgs prog [] o = withOpts o (usageErr prog)
checkArgs prog ("--release" :: rest) o = checkArgs prog rest (markRelease o)
checkArgs prog (arg :: rest) o = if startsWith "-" arg then withOpts o (removedFlag prog arg)
else case rest of
  [] => checkEmit arg o
  _ => withOpts o (usageErr prog)

-- | CLI 辅助：checkEmit（参数/退出码约定见 tooling.md）。
checkEmit : String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkEmit path o = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists path)
  if exists then do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory path)
    if isDir then checkPkgDir path o else checkFileEntry path o
  else withOpts o (dtPathErr path)

checkPkgDir : String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkPkgDir dir o = do
  pkgsR <- workspacePackages dir
  case pkgsR of
    ErrC e => printDiag o e
    OkC pkgs => checkPackages pkgs 0 o

-- M30：workspace 是检查单元——根包 + [workspace].members 逐个检查，成员错误不再被
-- 根 check 忽略。错误带 `[包名]` 前缀；全部跑完再汇总退出码。
-- M34.4：多包 workspace 并行（成员包各一个 `vuna check <dir>` 子进程；根包在当前进程
-- 串行）。根包目录就是 workspace 根，spawn 它会再展开整个 workspace ⇒ 递归，所以按
-- `workspacePackages <dir>` 是否返回多包区分根 / 成员；单包目录的子进程只查自己。
-- 子进程继承 stdout/stderr（错误可能交错），退出码按失败汇总。
-- | CLI 辅助：checkSpawnArgs（参数/退出码约定见 tooling.md）。
checkSpawnArgs : CliOpts -> String -> List String
checkSpawnArgs o dir =
  let
    head0 = if o.optRelease then ["check", "--release"] else ["check"]
    base =
      if o.optDiagFormat == "short" then append head0 [dir]
      else append head0 ["--error-format", o.optDiagFormat, dir]
    base2 = if o.optShowWarnings then append base ["--warnings"] else base
    base3 = if o.optDenyWarnings then append base2 ["--deny-warnings"] else base2
    -- 诊断显示选项必须透传，否则成员包的输出与根包口径不一致（i18n / 上限）。
    langArgs = if o.optLangExplicit then ["--lang", o.optDiagLang] else []
    cascadeArgs = if o.optShowCascade then ["--show-cascade"] else []
    sourceArgs = if o.optWithSources then ["--with-sources"] else []
    failFastArgs = if o.optFailFast then ["--fail-fast"] else []
    maxArgs = if o.optMaxErrors > 0 then ["--max-errors", strFromInt o.optMaxErrors] else []
  in append base3
    (append langArgs (append maxArgs (append cascadeArgs (append sourceArgs failFastArgs))))

-- 机器格式（json/sarif）的判定：这些格式要求 stdout **恰好一份**文档。
isMachineFormat : String -> Bool
isMachineFormat f = f == "json" || f == "sarif"

checkPackages : List Package -> Int -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkPackages [] code o = pure (Pair code o)
checkPackages ([pkg]) code o = checkPackageSeq pkg code o
-- 成员在父进程内逐个检查，诊断进同一个 optSarifItems，stdout 只在最后的
-- flushSarif 输出一次（多进程各打一份会得到非法 JSON / 多份 SARIF）。
checkPackages pkgs code o =
  let
    -- 机器格式的单文档契约：显式格式不被成员 manifest 的 [diagnostics] 覆盖。
    oMachine = markFormatExplicit o
  in if isMachineFormat o.optDiagFormat then checkPkgsInProcess pkgs code oMachine
  else checkPackagesSpawn pkgs code o

-- 文本格式的工作区检查：成员包各起一个子进程并行检查（输出可交错），根包当前进程串行。
checkPackagesSpawn : List Package -> Int -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkPackagesSpawn [] code o = pure (Pair code o)
checkPackagesSpawn pkgs code o = do
  classified <- mapEff (\pkg => do
    root <- isWorkspaceRoot pkg
    pure (Pair pkg root)
  ) pkgs
  let
    members = map firstOf (filter (\p => not (secondOf p)) classified)
    roots = map firstOf (filter (\p => secondOf p) classified)
  in do
    started <- mapEff (\pkg => do
      pid <- raiseToRow hostRow (@vuna@prim_eff_spawn (checkSpawnArgs o (packageDir pkg)))
      pure (Pair pkg pid)
    ) members
    r1 <- checkRootsSeq roots code o
    codes <- mapEff (\pr => @vuna@prim_eff_wait (secondOf pr)) started
    pure (Pair (countFailures (firstOf r1) codes) (secondOf r1))

-- 机器格式的工作区检查：父进程内顺序检查每个包，共享同一份 CliOpts/SARIF 收集器。
checkPkgsInProcess : List Package -> Int -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkPkgsInProcess [] code o = pure (Pair code o)
checkPkgsInProcess (pkg :: rest) code o = do
  r <- checkPackageSeq pkg code o
  checkPkgsInProcess rest (firstOf r) (secondOf r)

isWorkspaceRoot : Package -> Eff hostRow Bool
isWorkspaceRoot pkg = do
  pkgsR <- workspacePackages (packageDir pkg)
  pure (case pkgsR of
    OkC ps => length ps > 1
    ErrC e => False
  )

checkRootsSeq : List Package -> Int -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkRootsSeq [] code o = pure (Pair code o)
checkRootsSeq (pkg :: rest) code o = do
  r <- checkPackageSeq pkg code o
  let
    code1 = firstOf r
  in if o.optFailFast && code1 /= 0 then pure (Pair code1 (secondOf r))
  else checkRootsSeq rest code1 (secondOf r)

checkPackageSeq : Package -> Int -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkPackageSeq pkg code o =
  let
    o1 = applyDiagConfig (Just pkg) o
    -- M45：warning 需要本包模块重新精化（warning 不持久化）；-W / --deny-warnings 时
    -- 跳过 check 缓存与干净模块复用（依赖仍走接口摘要）。
    wantWarnings = o1.optShowWarnings || o1.optDenyWarnings
  in do
    r <- checkPackageCode pkg wantWarnings o1
    pure (Pair (if firstOf r > code then firstOf r else code) (secondOf r))

checkPackageCode : Package -> Bool -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkPackageCode pkg wantWarnings o = do
  r <- checkPackage o.optRelease wantWarnings pkg
  case r of
    ErrC e => checkPackageErr pkg e o
    OkC ws0 =>
      let
        ws = filter (ownedByPackage pkg) (dedupeWarnings ws0)
        shown = if o.optShowWarnings || o.optDenyWarnings then ws else []
        failed = if o.optDenyWarnings && length ws > 0 then 1 else 0
      in do
        r1 <- printDiagList o "[${packageName pkg}] " shown
        pure (Pair failed (secondOf r1))

countFailures : Int -> List Int -> Int
countFailures acc [] = acc
countFailures acc (c :: rest) = if c == 0 then countFailures acc rest else countFailures 1 rest

checkFileEntry : String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkFileEntry path o = do
  ctxR <- contextForFile path
  case ctxR of
    ErrC e => printDiag o e
    OkC ctx0 =>
      let
        ctx = contextWithRelease o.optRelease ctx0
        o1 = applyDiagConfig (contextPackageOf ctx) o
      in do
        moduleEntry <- isModuleFileEntry ctx path
        if moduleEntry then checkModuleFileEntry ctx path o1 else checkEntryFile ctx path o1

-- M45：带 `module` 头、且**不是**当前包入口的文件按库模块检查。包入口保持入口语义
-- （它的 module 头仍报 `LD_ModuleHeaderInEntryFile`，与包级 check 一致）；无头文件走入口。
isModuleFileEntry : PackageContext -> String -> Eff hostRow Bool
isModuleFileEntry ctx path = do
  pkgEntry <- isPackageEntryPath ctx path
  if pkgEntry then pure False else dtFileHasModuleHeader path

isPackageEntryPath : PackageContext -> String -> Eff hostRow Bool
isPackageEntryPath ctx path = case contextPackageOf ctx of
  Nothing => pure False
  Just pkg => do
    abs <- absolutePath path
    pure (stripDotSlash abs == stripDotSlash (packageEntry pkg))

-- 单文件库模块检查：错误直接上报（`--continue-on-error` 的恢复只支持入口文件）；
-- 成功时只打印/统计本文件的告警（依赖模块不刷屏）。
checkModuleFileEntry : PackageContext -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkModuleFileEntry ctx path o = do
  checked <- dtCheckModuleFile ctx path
  case checked of
    ErrC e => printDiag o e
    OkC ws0 =>
      let
        ws = filter (ownedByFile path) (dedupeWarnings ws0)
        shown = if o.optShowWarnings || o.optDenyWarnings then ws else []
      in do
        r <- printDiagList o "" shown
        pure (Pair (if o.optDenyWarnings && length ws > 0 then 1 else 0) (secondOf r))

-- 入口文件检查（无 module 头；唯一支持 `--continue-on-error` 恢复的路径）。
checkEntryFile : PackageContext -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkEntryFile ctx path o = do
  checked <- dtCheck ctx path
  case checked of
    ErrC e => if o.optContinueOnError then do
      recovered <- dtCheckRecovering ctx path
      case recovered of
        OkC ds =>
          let
            shown = takeDiags o.optMaxErrors ds
          in do
            r <- printDiagList o "" shown
            if length shown == 0 then printDiag (secondOf r) e else pure (Pair 1 (secondOf r))
        ErrC e2 => printDiag o e
    else printDiag o e
    OkC ws0 =>
      let
        ws = filter (ownedByFile path) (dedupeWarnings ws0)
        shown = if o.optShowWarnings || o.optDenyWarnings then ws else []
      in do
        r <- printDiagList o "" shown
        pure (Pair (if o.optDenyWarnings && length ws > 0 then 1 else 0) (secondOf r))

-- ---------------------------------------------------------------
-- build：包级逐模块 codegen 到 DIR（默认 <PKG-DIR>/.output），再跑 build.sh 链接到
-- DIR/bin/<包名>；--no-compile 只做 codegen 不链接。
-- M30：workspace 根 = 构建单元（所有可执行成员各建到自己的 .output 或 DIR/<包名>；
-- 库成员只检查）；--package NAME 只建指定包（Nix 构建根包用，避免重复构建成员）。
-- build meta（同哈希跳过）见 Vuna.Compiler.Driver.Compile。
-- ---------------------------------------------------------------
-- | CLI 辅助：buildArgs（参数/退出码约定见 tooling.md）。
buildArgs : String -> List String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildArgs prog args o = buildParse prog False Nothing Nothing Nothing args o

buildParse : String -> Bool -> Maybe String -> Maybe String -> Maybe String -> List String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildParse prog noCompile out dir pkg args o = case args of
  [] => buildRun noCompile (defaultDir dir) out pkg o
  "--no-compile" :: rest => buildParse prog True out dir pkg rest o
  "--release" :: rest => buildParse prog noCompile out dir pkg rest (markRelease o)
  "--target" :: t :: rest => buildParse prog noCompile out dir pkg rest (markTarget t o)
  "--out" :: rest => case rest of
    outDir :: more => if startsWith "-" outDir then withOpts o (removedFlag prog outDir)
    else case out of
      Nothing => buildParse prog noCompile (Just outDir) dir pkg more o
      Just _ => withOpts o (usageErr prog)
    [] => withOpts o (usageErr prog)
  "--package" :: rest => case rest of
    name :: more => if startsWith "-" name then withOpts o (removedFlag prog name)
    else case pkg of
      Nothing => buildParse prog noCompile out dir (Just name) more o
      Just _ => withOpts o (usageErr prog)
    [] => withOpts o (usageErr prog)
  arg :: rest => if startsWith "-" arg then withOpts o (removedFlag prog arg)
  else case dir of
    Nothing => buildParse prog noCompile out (Just arg) pkg rest o
    Just _ => withOpts o (usageErr prog)

buildRun : Bool -> String -> Maybe String -> Maybe String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildRun noCompile dir outM pkgM o = do
  pkgsR <- workspacePackages dir
  case pkgsR of
    ErrC e => printDiag o e
    OkC pkgs => do
      libOnly <- isSingleLibraryPackage pkgs
      if libOnly then withOpts o (printErr (libraryOnlyMessage pkgs))
      else case selectBuildTargets pkgM pkgs of
        ErrC e => printDiag o e
        OkC targets => buildTargets noCompile (length pkgs > 1) outM targets 0 o

-- 单包目录且是库包（没有 app/Main.vuna）→ build 必须报错（不是静默 skip）。
-- workspace 根里的库成员仍走 skip（构建单元覆盖全部可执行成员）。
isSingleLibraryPackage : List Package -> Eff hostRow Bool
isSingleLibraryPackage ([pkg]) = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists (packageEntry pkg))
  pure (not exists)
isSingleLibraryPackage _ = pure False

libraryOnlyMessage : List Package -> String
libraryOnlyMessage (pkg :: _) =
  "library package ${packageName pkg} has no app/Main.vuna (executable package required; use `check` for libraries)"
libraryOnlyMessage [] = "no package to build"

selectBuildTargets : Maybe String -> List Package -> Check (List Package)
selectBuildTargets Nothing pkgs = OkC pkgs
selectBuildTargets (Just name) pkgs = case findPackageByName name pkgs of
  Nothing => err "no such package in workspace: ${name}"
  Just pkg => OkC [pkg]

findPackageByName : String -> List Package -> Maybe Package
findPackageByName name [] = Nothing
findPackageByName name (pkg :: rest) =
  if packageName pkg == name then Just pkg else findPackageByName name rest

-- | CLI 辅助：buildTargets（参数/退出码约定见 tooling.md）。
buildTargets : Bool -> Bool -> Maybe String -> List Package -> Int -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildTargets noCompile multiOut outM [] code o = pure (Pair code o)
buildTargets noCompile multiOut outM (pkg :: rest) code o = do
  r <- buildOne noCompile multiOut outM pkg o
  let
    next = if firstOf r > code then firstOf r else code
  in buildTargets noCompile multiOut outM rest next (secondOf r)

-- 单包：可执行包 build；库包只 check（workspace 构建单元覆盖所有成员）。
-- | native 目标的 build：compile 产 main.s，再调系统 cc 链接成静态可执行。
buildNativeOne : Bool -> Bool -> Maybe String -> Package -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildNativeOne noCompile multiOut outM pkg o =
  let
    name = packageName pkg
    outDir = case outM of
      Just out => if multiOut then "${out}/${name}" else out
      Nothing => "${packageDir pkg}/.output"
    sPath = "${outDir}/main.s"
    binDir = "${outDir}/bin"
    binPath = "${binDir}/${name}"
    script =
      "#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")\"\nmkdir -p bin\ncc -static -nostdlib -no-pie -Wl,--build-id=none -o \"bin/${name}\" main.s\n"
    ccArgs = ["cc", "-static", "-nostdlib", "-no-pie", "-Wl,--build-id=none", "-o", binPath, sPath]
  in do
    r <-
      compileNative (contextWithRelease o.optRelease (packageContext pkg)) (packageEntry pkg) True
        outDir
    case r of
      ErrC e => printDiag o e
      OkC _ => do
        _ <- raiseToRow hostRow (@vuna@prim_eff_writeFile "${outDir}/build.sh" script)
        if noCompile then do
          _ <- raiseToRow hostRow (@vuna@prim_eff_print "wrote ${sPath}\n")
          pure (Pair 0 o)
        else do
          _ <- ensureDirPath binDir
          code <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ccArgs)
          if code == 0 then do
            _ <- raiseToRow hostRow (@vuna@prim_eff_print "wrote ${binPath}\n")
            pure (Pair 0 o)
          else do
            _ <-
              raiseToRow hostRow
                (@vuna@prim_eff_print "native link failed: cc exited ${strFromInt code}\n")
            pure (Pair 1 o)

-- | wasm 目标的 build：只产 main.wat（+ build.sh），不走 OCaml 链接。
buildWasmOne : Bool -> Maybe String -> Package -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildWasmOne noCompile outM pkg o =
  let
    outDir = case outM of
      Just out => out
      Nothing => "${packageDir pkg}/.output"
  in do
    r <-
      compileWasm (contextWithRelease o.optRelease (packageContext pkg)) (packageEntry pkg) True
        outDir
    case r of
      ErrC e => printDiag o e
      OkC _ => if noCompile then do
        _ <- raiseToRow hostRow (@vuna@prim_eff_print "wrote ${outDir}/main.wat\n")
        pure (Pair 0 o)
      else do
        _ <-
          raiseToRow hostRow
            (@vuna@prim_eff_writeFile "${outDir}/build.sh" "#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")\"\nwasm-tools parse main.wat -o main.wasm\n")
        _ <- raiseToRow hostRow (@vuna@prim_eff_print "wrote ${outDir}/main.wat\n")
        pure (Pair 0 o)

buildOne : Bool -> Bool -> Maybe String -> Package -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildOne noCompile multiOut outM pkg o = if o.optTarget == "wasm" then buildWasmOne noCompile outM pkg o
else if o.optTarget == "native" then buildNativeOne noCompile multiOut outM pkg o
else
  let
    name = packageName pkg
    entry = packageEntry pkg
  in do
    exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists entry)
    if exists then
      let
        ctx = contextWithRelease o.optRelease (packageContext pkg)
      in if noCompile then case outM of
        Just out => compileCodegen ctx entry (if multiOut then "${out}/${name}" else out) o
        Nothing => compileCodegen ctx entry "${packageDir pkg}/.output" o
      else case outM of
        Just out => buildExplicit out multiOut pkg ctx entry o
        Nothing => do
          viewDigest <- buildViewAddrOf ctx entry True
          buildDefaultView ctx pkg name entry viewDigest o
    else do
      r <- checkPackage o.optRelease False pkg
      case r of
        ErrC e => printDiag o e
        OkC _ => do
          _ <- raiseToRow hostRow (@vuna@prim_eff_print "skipped (library): ${name}\n")
          pure (Pair 0 o)

-- 显式 `--out`：外部消费者要求真目录，保持直写；不发布 store 视图。
buildExplicit : String -> Bool -> Package -> PackageContext -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildExplicit out multiOut pkg ctx entry o =
  let
    name = packageName pkg
    outDir = if multiOut then "${out}/${name}" else out
    binPath = "${outDir}/bin/${name}"
  in do
    fresh <- metaUpToDate outDir ctx entry binPath
    if fresh then do
      _ <- raiseToRow hostRow (@vuna@prim_eff_print "up to date: ${binPath}\n")
      pure (Pair 0 o)
    else do
      r <- compileToDir ctx entry True outDir
      case r of
        ErrC e => printDiag o e
        OkC _ => buildLinked ctx entry outDir name o

-- 默认输出：`$VUNA_STORE/views/bin/<splitIn>`；`<pkg>/.output` 只是符号链接。
-- 同一 digest 用 mkdir 锁串行化；在**最终 view 路径**构建，保证 codegen 路径稳定。
buildDefaultView : PackageContext -> Package -> String -> String -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildDefaultView ctx pkg name entry viewDigest o = do
  view <- storeViewPathEff "bin" viewDigest
  let
    binPath = "${view}/bin/${name}"
  in do
    valid <- storeViewValidEff "bin" viewDigest
    fresh <- if valid then metaUpToDate view ctx entry binPath else pure False
    if fresh then do
      _ <- linkDefaultOutput Nothing pkg view viewDigest
      _ <- raiseToRow hostRow (@vuna@prim_eff_print "up to date: ${binPath}\n")
      pure (Pair 0 o)
    else do
      state <- waitView "bin" viewDigest 600
      if state == "locked" then do
        valid2 <- storeViewValidEff "bin" viewDigest
        fresh2 <- if valid2 then metaUpToDate view ctx entry binPath else pure False
        if fresh2 then do
          _ <- linkDefaultOutput Nothing pkg view viewDigest
          _ <- storeViewUnlockEff "bin" viewDigest
          _ <- raiseToRow hostRow (@vuna@prim_eff_print "up to date: ${binPath}\n")
          pure (Pair 0 o)
        else do
          r <- compileToDir ctx entry True view
          case r of
            ErrC e => do
              _ <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", view])
              _ <- storeViewUnlockEff "bin" viewDigest
              printDiag o e
            OkC _ => do
              br <- buildLinked ctx entry view name o
              if firstOf br == 0 then do
                _ <- markViewComplete view viewDigest
                _ <- linkDefaultOutput Nothing pkg view viewDigest
                _ <- storeViewUnlockEff "bin" viewDigest
                pure br
              else do
                _ <- storeViewUnlockEff "bin" viewDigest
                pure br
      else if state == "ready" then do
        _ <- linkDefaultOutput Nothing pkg view viewDigest
        _ <- raiseToRow hostRow (@vuna@prim_eff_print "up to date: ${binPath}\n")
        pure (Pair 0 o)
      else do
        _ <-
          raiseToRow hostRow
            (@vuna@prim_eff_print "error: timed out waiting for view ${viewDigest}\n")
        pure (Pair 1 o)

-- 等同一 view 的构建：拿到锁 => "locked"；别人已发布 => "ready"；超时 => "timeout"。
waitView : String -> String -> Int -> Eff hostRow String
waitView kind digest fuel = do
  ok <- storeViewLockEff kind digest
  if ok then pure "locked"
  else do
    valid <- storeViewValidEff kind digest
    if valid then pure "ready"
    else if fuel <= 0 then pure "timeout"
    else do
      _ <- raiseToRow hostRow (@vuna@prim_eff_sleep 100000)
      waitView kind digest (fuel - 1)

markViewComplete : String -> String -> Eff hostRow Int
markViewComplete dir digest =
  raiseToRow hostRow (@vuna@prim_eff_writeFileAtomic "${dir}/.complete" digest)

-- 默认输出时把 `<pkg>/.output` 指向视图；`--out` 时不动磁盘布局。
-- `.complete` 由持锁者在构建成功后写（`markViewComplete`），不在这里写，
-- 避免“链接失败但视图已被标记完成”。
linkDefaultOutput : Maybe String -> Package -> String -> String -> Eff hostRow Int
linkDefaultOutput (Just _) _ _ _ = pure 0
linkDefaultOutput Nothing pkg outDir _viewDigest = do
  let
    link = "${packageDir pkg}/.output"
  in do
    _ <- raiseToRow hostRow (@vuna@prim_eff_runIn "." ["rm", "-rf", link])
    @vuna@prim_eff_runIn "." ["ln", "-s", outDir, link]

compileCodegen : PackageContext -> String -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
compileCodegen ctx entry outDir o = do
  r <- compileToDir ctx entry True outDir
  case r of
    ErrC e => printDiag o e
    OkC _ => pure (Pair 0 o)

-- 链接：先建 bin/（build.sh 的 -o bin/<pkg> 需要父目录存在），再跑 build.sh；
-- 链接成功后写 build-meta.json（同哈希跳过在 buildOne 入口判定）。
buildLinked : PackageContext -> String -> String -> String -> CliOpts -> Eff hostRow (Pair Int CliOpts)
buildLinked ctx entry outDir name o = do
  _ <- ensureDirPath "${outDir}/bin"
  r <- runBuildScript outDir "bin/${name}" name
  case r of
    ErrC e => printDiag o e
    OkC _ => do
      _ <- writeBuildMeta outDir ctx entry True
      _ <- raiseToRow hostRow (@vuna@prim_eff_print "built ${outDir}/bin/${name}\n")
      pure (Pair 0 o)

-- ---------------------------------------------------------------
-- warning 归属：只显示当前检查单元自己的文件（依赖包的 warning 不重复刷屏）。
-- ---------------------------------------------------------------
-- | 诊断/告警实现：stripDotSlash（详见 diagnostics.md）。
stripDotSlash : String -> String
stripDotSlash s =
  if startsWith "./" s then substring (natFromInt 2) (natFromInt (strLength s - 2)) s else s

-- | 诊断/告警实现：ownedByFile（详见 diagnostics.md）。
ownedByFile : String -> Diagnostic -> Bool
ownedByFile path d = stripDotSlash (diagFileOf d) == stripDotSlash path

-- | 诊断/告警实现：ownedByPackage（详见 diagnostics.md）。
ownedByPackage : Package -> Diagnostic -> Bool
ownedByPackage pkg d =
  let
    dir = stripDotSlash (packageDir pkg)
    file = stripDotSlash (diagFileOf d)
    prefix = if dir == "." || dir == "" then "" else "${dir}/"
  in startsWith "${prefix}lib/" file
    || startsWith "${prefix}app/" file
    || startsWith "${prefix}test/" file

-- compile/build 成功路径的 warning 消费（默认静默；-W 显示；--deny-warnings 提升退出码）。
-- | 诊断/告警实现：finishWarnings（详见 diagnostics.md）。
finishWarnings : List Diagnostic -> Int -> CliOpts -> Eff hostRow (Pair Int CliOpts)
finishWarnings warns code o =
  let
    ws = dedupeWarnings warns
    shown = if o.optShowWarnings || o.optDenyWarnings then ws else []
  in do
    r <- printDiagList o "" shown
    pure (Pair (if o.optDenyWarnings && length ws > 0 then 1 else code) (secondOf r))

-- 与 finishWarnings 相同，但失败时删除已生成的输出目录（编译失败不留产物）。
-- | 诊断/告警实现：finishWarningsDir（详见 diagnostics.md）。
finishWarningsDir : List Diagnostic -> CliOpts -> String -> Int -> Eff hostRow (Pair Int CliOpts)
finishWarningsDir warns o dir code =
  let
    ws = dedupeWarnings warns
    shown = if o.optShowWarnings || o.optDenyWarnings then ws else []
  in do
    r <- printDiagList o "" shown
    if o.optDenyWarnings && length ws > 0 then do
      _ <- raiseToRow hostRow (@vuna@prim_eff_runIn "/" ["rm", "-rf", dir])
      pure (Pair 1 (secondOf r))
    else pure (Pair code (secondOf r))

-- 剥离 `--lang zh`（human 说明语言；默认 en）。
-- | 剥离 --lang 参数。
stripLang : List String -> Pair (List String) String
stripLang args = stripLangGo args [] "en"

-- | --lang 参数扫描实现。
stripLangGo : List String -> List String -> String -> Pair (List String) String
stripLangGo [] acc lang = Pair (reverse acc) lang
stripLangGo ("--lang" :: rest) acc lang = case rest of
  v :: more => stripLangGo more acc v
  [] => Pair (reverse acc) lang
stripLangGo (arg :: rest) acc lang =
  if startsWith "--lang=" arg then stripLangGo rest acc (substring (natFromInt 7) (natFromInt (strLength arg - 7)) arg)
  else stripLangGo rest (arg :: acc) lang

-- | 参数里是否显式给了 --lang。
hasLangFlag : List String -> Bool
hasLangFlag [] = False
hasLangFlag (arg :: rest) =
  if arg == "--lang" || startsWith "--lang=" arg then True else hasLangFlag rest

stripContinueOnError : List String -> Pair (List String) Bool
stripContinueOnError args = stripContinueGo args [] False

stripContinueGo : List String -> List String -> Bool -> Pair (List String) Bool
stripContinueGo [] acc found = Pair (reverse acc) found
stripContinueGo ("--continue-on-error" :: rest) acc found = stripContinueGo rest acc True
stripContinueGo (arg :: rest) acc found = stripContinueGo rest (arg :: acc) found

checkPackageErr : Package -> Diagnostic -> CliOpts -> Eff hostRow (Pair Int CliOpts)
checkPackageErr pkg e o =
  if o.optContinueOnError then packageRecover pkg e o
  else printDiagWithPrefix o "[${packageName pkg}] " e

-- | 包检查恢复入口：可执行包走入口文件，库包走 [export].modules。
-- | 包检查恢复入口：可执行包走入口文件，库包走导出模块。
packageRecover : Package -> Diagnostic -> CliOpts -> Eff hostRow (Pair Int CliOpts)
packageRecover pkg e o = do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists (packageEntry pkg))
  if exists then packageRecoverExe pkg e o else packageRecoverLib pkg e o

-- | 可执行包入口的恢复式检查。
packageRecoverExe : Package -> Diagnostic -> CliOpts -> Eff hostRow (Pair Int CliOpts)
packageRecoverExe pkg e o = do
  recovered <-
    dtCheckRecovering (contextWithRelease o.optRelease (packageContext pkg)) (packageEntry pkg)
  case recovered of
    OkC ds => printRecovered pkg e ds o
    ErrC e2 => printDiagWithPrefix o "[${packageName pkg}] " e2

-- | 库包（[export].modules）的恢复式检查。
packageRecoverLib : Package -> Diagnostic -> CliOpts -> Eff hostRow (Pair Int CliOpts)
packageRecoverLib pkg e o = case packageExports pkg of
  Just names => do
    recovered <-
      dtCheckLibraryRecovering (contextWithRelease o.optRelease (packageContext pkg)) names
    case recovered of
      OkC ds => printRecovered pkg e ds o
      ErrC e2 => printDiagWithPrefix o "[${packageName pkg}] " e2
  Nothing => printDiagWithPrefix o "[${packageName pkg}] " e

-- | 打印恢复出的诊断并返回退出码。
printRecovered : Package -> Diagnostic -> List Diagnostic -> CliOpts -> Eff hostRow (Pair Int CliOpts)
printRecovered pkg e ds o =
  let
    shown = takeDiags o.optMaxErrors ds
  in do
    r <- printDiagList o "[${packageName pkg}] " shown
    if length shown == 0 then printDiagWithPrefix (secondOf r) "[${packageName pkg}] " e
    else pure (Pair 1 (secondOf r))
