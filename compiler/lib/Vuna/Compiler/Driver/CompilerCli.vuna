module Vuna.Compiler.Driver.CompilerCli
  ( compilerUsageLines
  , runCompilerCli
  , runCompilerCliFor
  ) where

-- Vuna.Compiler.Driver.CompilerCli：编译器自己的 CLI（vuna-compiler）。
--
-- M24 起唯一路径是 DT（精化 + 擦除 codegen）：compile / check / build / seed。
-- 工具命令（lint / interp / test / fmt / repl / doc）在 Vuna.Cli。
-- compiler/app/Main.vuna 的入口闭包就是 seed 闭包。
import Vuna.Compiler.Common
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.SplitCli
import Vuna.Compiler.Driver.Process

compilerUsageLines : String -> String
compilerUsageLines prog =
  "  "
    ++ prog
    ++ " compile [--no-print] [--root DIR]... (<entry.vuna> | <package-dir>) [out.ml]\n"
    ++ "  "
    ++ prog
    ++ " check [--root DIR]... (<entry.vuna> | <package-dir>)\n"
    ++ "  "
    ++ prog
    ++ " build [--no-compile] [DIR]    包级 DT 单文件 codegen + ocamlopt → .output/bin/<name>\n"
    ++ "  "
    ++ prog
    ++ " build --split OUT [DIR]        逐模块 DT codegen：OUT/<Module>.ml... + build.sh\n"
    ++ "  "
    ++ prog
    ++ " seed OUT [DIR]                 同 build --split（seed rotation 用）\n"
    ++ "  --no-print                     compile 不打印结果钩子（调试/测试用）\n"
    ++ "  "
    ++ prog
    ++ " help, -h\n"

compilerUsage : String -> String
compilerUsage prog = "usage:\n" ++ compilerUsageLines prog

runCompilerCli : List String -> Int
runCompilerCli args = runCompilerCliFor "vuna-compiler" args

runCompilerCliFor : String -> List String -> Int
runCompilerCliFor prog args = if anyHelp args then helpFor prog else runCompilerCliFor1 prog args

runCompilerCliFor1 : String -> List String -> Int
runCompilerCliFor1 prog args = case args of
  [] => usageErr prog
  arg :: rest => case arg of
    "compile" => compileArgs prog rest
    "check" => checkArgs prog rest
    "build" => buildArgs prog rest
    "seed" => seedArgs prog rest
    "help" => helpFor prog
    _ => if startsWith "-" arg then removedFlag prog arg else unknownCommand prog arg

anyHelp : List String -> Bool
anyHelp [] = False
anyHelp (arg :: rest) = if arg == "-h" || arg == "--help" then True else anyHelp rest

helpFor : String -> Int
helpFor prog =
  let
    _ = print (compilerUsage prog)
  in 0

usageErr : String -> Int
usageErr prog =
  let
    _ = print (compilerUsage prog)
  in 2

unknownCommand : String -> String -> Int
unknownCommand prog arg =
  let
    _ = print ("error: unknown command `" ++ arg ++ "`\n" ++ "run `" ++ prog ++ " help`\n")
  in 2

removedHint : String -> String
removedHint flag = case flag of
  "--dt" => "DT is the only path; drop the flag"
  "--package" => "use `build`, `build --split`, or `seed`"
  "--out" => "use the positional OUT argument"
  "--no-typecheck" => "checking is always enabled"
  "--typecheck" => "checking is always enabled"
  "--typed" => "DT is the only path"
  _ => ""

removedFlag : String -> String -> Int
removedFlag prog flag = case removedHint flag of
  "" => usageErr prog
  hint =>
    let
      _ = print ("error: " ++ flag ++ " has been removed; " ++ hint ++ "\n")
    in 2

printErrText : String -> Int
printErrText e =
  let
    _ = print e
  in 1

printErr : String -> Int
printErr e = printErrText ("error: " ++ e ++ "\n")

printWarnings : List String -> Int
printWarnings [] = 0
printWarnings (w :: rest) =
  let
    _ = print (w ++ "\n")
  in printWarnings rest

rootArg : String -> List Root -> List String -> (List Root -> List String -> Int) -> Int
rootArg prog roots rest k = case rest of
  dir :: rest2 => k (append roots [rawRoot dir]) rest2
  [] => usageErr prog

defaultDir : Maybe String -> String
defaultDir dir = case dir of
  Just dir2 => dir2
  Nothing => "."

defaultOutDir : String -> String
defaultOutDir dir = dir ++ "/.output"

-- 路径既不是文件也不是目录时的统一错误（先 fileExists 再 isDirectory：
-- 内建 isDirectory 对不存在的路径会抛异常）。
dtPathErr : String -> Int
dtPathErr path = printErr ("no such file or package directory: " ++ path)

-- 可执行包解析：必须是目录、能读 vuna.toml、且有 app/Main.vuna。
executablePackage : String -> String -> Result Package
executablePackage label dir =
  if fileExists dir then if isDirectory dir then executablePackageAt label dir
  else Err (label ++ ": expects a package directory, not a file: " ++ dir)
  else Err ("no such file or package directory: " ++ dir)

executablePackageAt : String -> String -> Result Package
executablePackageAt label dir =
  andThen (loadPackage dir)
    (\pkg => if fileExists (packageEntry pkg) then Ok pkg else Err (label ++ ": library package " ++ packageName pkg ++ " has no app/Main.vuna (executable package required)"))

-- ---------------------------------------------------------------
-- compile：文件（单文件 / --root）或包目录，DT 单文件输出
-- ---------------------------------------------------------------
compileArgs : String -> List String -> Int
compileArgs prog args = compileParse prog True [] args

compileParse : String -> Bool -> List Root -> List String -> Int
compileParse prog printResult roots args = case args of
  [] => usageErr prog
  arg :: rest => case arg of
    "--no-print" => compileParse prog False roots rest
    "--root" =>
      rootArg prog roots rest (\roots2, rest2 => compileParse prog printResult roots2 rest2)
    _ =>
      if startsWith "-" arg then removedFlag prog arg
      else compileEmit prog printResult roots arg rest

compileEmit : String -> Bool -> List Root -> String -> List String -> Int
compileEmit prog printResult roots entry rest =
  if fileExists entry then if isDirectory entry then compilePkg prog printResult entry rest
  else compileFile prog printResult roots entry rest
  else dtPathErr entry

compileFile : String -> Bool -> List Root -> String -> List String -> Int
compileFile prog printResult roots entry rest = case compileFileDt (map rootDir (effectiveRoots roots)) entry printResult of
  Ok code => emitCode prog code rest
  Err e => printErr e

compilePkg : String -> Bool -> String -> List String -> Int
compilePkg prog printResult dir rest = case executablePackage "compile" dir of
  Err e => printErr e
  Ok pkg => case compileProjectDt (packageRoots pkg) (packageName pkg) (packageEntry pkg) printResult of
    Ok code => emitCode prog code rest
    Err e => printErr e

emitCode : String -> String -> List String -> Int
emitCode prog code rest = case rest of
  [] =>
    let
      _ = print code
    in 0
  [out] =>
    let
      _ = writeFile out code
    in 0
  _ => usageErr prog

-- ---------------------------------------------------------------
-- check：文件或包目录（可执行包走项目路径，库包走 [export].modules）
-- ---------------------------------------------------------------
checkArgs : String -> List String -> Int
checkArgs prog args = checkParse prog [] args

checkParse : String -> List Root -> List String -> Int
checkParse prog roots args = case args of
  [] => usageErr prog
  "--root" :: rest => rootArg prog roots rest (\roots2, rest2 => checkParse prog roots2 rest2)
  [arg] =>
    if startsWith "-" arg then removedFlag prog arg
    else if fileExists arg then if isDirectory arg then checkPkg arg else checkFile (effectiveRoots roots) arg
    else dtPathErr arg
  _ => usageErr prog

checkFile : List Root -> String -> Int
checkFile roots path = case checkFileDt (map rootDir roots) path of
  Err e => printErr e
  Ok warnings =>
    let
      _ = printWarnings warnings
    in 0

checkPkg : String -> Int
checkPkg dir = case loadPackage dir of
  Err e => printErr e
  Ok pkg => if fileExists (packageEntry pkg) then checkPkgEntry pkg else checkPkgLibrary pkg

checkPkgEntry : Package -> Int
checkPkgEntry pkg = case checkProjectDt (packageRoots pkg) (packageName pkg) (packageEntry pkg) of
  Err e => printErr e
  Ok warnings =>
    let
      _ = printWarnings warnings
    in 0

checkPkgLibrary : Package -> Int
checkPkgLibrary pkg = case packageExports pkg of
  Nothing => printErr ("check: library package " ++ packageName pkg ++ " has no [export].modules")
  Just names => case checkLibraryDt (packageRoots pkg) (packageName pkg) names of
    Err e => printErr e
    Ok warnings =>
      let
        _ = printWarnings warnings
      in 0

-- ---------------------------------------------------------------
-- build：默认 DT 单文件；--split 走逐模块输出
-- ---------------------------------------------------------------
buildArgs : String -> List String -> Int
buildArgs prog args = buildParse prog False Nothing Nothing args

buildParse : String -> Bool -> Maybe String -> Maybe String -> List String -> Int
buildParse prog noCompile splitOut dir args = case args of
  [] => buildRun prog (defaultDir dir) noCompile splitOut
  "--no-compile" :: rest => buildParse prog True splitOut dir rest
  "--split" :: rest => case rest of
    out :: more => if startsWith "-" out then removedFlag prog out
    else case splitOut of
      Nothing => buildParse prog noCompile (Just out) dir more
      Just _ => usageErr prog
    [] => usageErr prog
  arg :: rest => if startsWith "-" arg then removedFlag prog arg
  else case dir of
    Nothing => buildParse prog noCompile splitOut (Just arg) rest
    Just _ => usageErr prog

buildRun : String -> String -> Bool -> Maybe String -> Int
buildRun prog dir noCompile splitOut = case splitOut of
  Just outDir => buildSplitRun outDir dir
  Nothing => buildDefault dir noCompile

buildDefault : String -> Bool -> Int
buildDefault dir noCompile = case executablePackage "build" dir of
  Err e => printErr e
  Ok pkg => case writeDtOutput (defaultOutDir dir) pkg of
    Err e => printErr e
    Ok n =>
      let
        _ = print ("wrote " ++ strFromInt n ++ " files to " ++ defaultOutDir dir ++ "\n")
      in if noCompile then 0 else buildBinary dir pkg

writeDtOutput : String -> Package -> Result Int
writeDtOutput outDir pkg = andThen (dtProjectFiles (packageRoots pkg) (packageName pkg) (packageEntry pkg) True) (\files => let
  _ = makeDir outDir
in Ok (writeFiles outDir files)
)

writeFiles : String -> List (Pair String String) -> Int
writeFiles dir [] = 0
writeFiles dir (f :: rest) =
  let
    _ = writeFile (dir ++ "/" ++ firstOf f) (secondOf f)
  in 1 + writeFiles dir rest

buildBinary : String -> Package -> Int
buildBinary dir pkg =
  let
    outDir = defaultOutDir dir
    name = packageName pkg
    binRel = ".output/bin/" ++ name
    binPath = outDir ++ "/bin/" ++ name
    _ = makeDir (outDir ++ "/bin")
    _ = removeFile binPath
    code =
      runIn dir
        ["ocamlopt", "-w", "-a", "-I", "+unix", "-o", binRel, "unix.cmxa", ".output/main.ml"]
  in if code == 0 then
    let
      _ = print ("built " ++ dir ++ "/" ++ binRel ++ "\n")
    in 0
  else
    let
      _ = removeFile binPath
    in let
      _ = print ("error: build: ocamlopt failed (exit " ++ strFromInt code ++ ")\n")
    in 1

buildSplitRun : String -> String -> Int
buildSplitRun outDir dir = case executablePackage "build --split" dir of
  Err e => printErr e
  Ok pkg =>
    let
      _ = makeDir outDir
    in case buildSplit dir outDir of
      Err e => printErr e
      Ok n =>
        let
          _ = print ("wrote " ++ strFromInt n ++ " files to " ++ outDir ++ "\n")
        in 0

-- ---------------------------------------------------------------
-- seed：显式 OUT 的逐模块 DT 输出（seed rotation 用）
-- ---------------------------------------------------------------
seedArgs : String -> List String -> Int
seedArgs prog args = seedParse prog Nothing Nothing args

seedParse : String -> Maybe String -> Maybe String -> List String -> Int
seedParse prog out dir args = case args of
  [] => case out of
    Nothing => seedOutErr
    Just outDir => seedRun outDir (defaultDir dir)
  arg :: rest => if startsWith "-" arg then removedFlag prog arg
  else case out of
    Nothing => seedParse prog (Just arg) dir rest
    Just _ => case dir of
      Nothing => seedParse prog out (Just arg) rest
      Just _ => usageErr prog

seedOutErr : Int
seedOutErr =
  let
    _ = print "error: seed requires an explicit OUT directory\n"
  in 2

seedRun : String -> String -> Int
seedRun outDir dir = case executablePackage "seed" dir of
  Err e => printErr e
  Ok pkg =>
    let
      _ = makeDir outDir
    in case seedSplit dir outDir of
      Err e => printErr e
      Ok n =>
        let
          _ = print ("wrote " ++ strFromInt n ++ " files to " ++ outDir ++ "\n")
        in 0
