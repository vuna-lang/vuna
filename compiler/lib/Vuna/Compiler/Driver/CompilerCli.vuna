module Vuna.Compiler.Driver.CompilerCli
  ( compilerUsageLines
  , removedFlagHint
  , runCompilerCli
  , runCompilerCliFor
  ) where

-- Vuna.Compiler.Driver.CompilerCli：编译器自己的 CLI（vuna-compiler）。
--
-- M24 起唯一路径是 DT（精化 + 逐模块擦除 codegen）：compile / check / build。
-- M26：包上下文统一——`compile` 与 `build` 都产**目录**（split + build.sh），
-- 不再有 seed 子命令、split 开关与环境根 flag（移除时给出可操作提示）。
-- 工具命令（lint / interp / test / fmt / repl / doc）在 Vuna.Cli。
import Vuna.Compiler.Common
import Vuna.Compiler.Diagnostics.Sink
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.DiagRender
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Version
import Vuna.Compiler.Diag.Format
import Base.IO.Host
import Base.IORef
import Base.Nat

-- | CLI 辅助：compilerUsageLines（参数/退出码约定见 tooling.md）。
compilerUsageLines : String -> String
compilerUsageLines prog = """  ${prog} compile [--no-print] [--release] (<entry.vuna> | <package-dir>) <out-dir>
  ${prog} check [--release] [--continue-on-error] (<entry.vuna> | <package-dir>)
  ${prog} build [--release] [--no-compile] [--out DIR] [--package NAME] [DIR]
  --no-print                    compile 生成的程序不打印 main 结果（默认打印）
  --release                     release 构建：拒绝 assert / todo 等 debug 专用构造
  --continue-on-error           best-effort 多错误：逐次移除失败声明后继续（仅文件入口）
  ${prog} version, --version          显示版本
  ${prog} help, -h
"""

compilerUsage : String -> String
compilerUsage prog = "usage:\n${compilerUsageLines prog}"

-- | CLI 辅助：runCompilerCli（参数/退出码约定见 tooling.md）。
runCompilerCli : List String -> Int
runCompilerCli args = runCompilerCliFor "vuna-compiler" args

-- --error-format=short|human|json（也接受 --json）在入口统一剥离并写进全局渲染模式。
-- | CLI 辅助：diagFormatRef（参数/退出码约定见 tooling.md）。
diagFormatRef : IORef String
diagFormatRef = runIO (newRef "short")

record SarifBox where
  sarifItems : List Diagnostic
  sarifTag : Int

-- | 诊断/告警实现：sarifRef（详见 diagnostics.md）。
sarifRef : IORef SarifBox
sarifRef = runIO (newRef (SarifBox [] 0))

-- | 诊断/告警实现：resetSarif（详见 diagnostics.md）。
resetSarif : Int -> Int
resetSarif _ = runIO (writeRef sarifRef (SarifBox [] 0))

-- | 诊断/告警实现：collectSarif（详见 diagnostics.md）。
collectSarif : Diagnostic -> Int
collectSarif d = runIO (modifyRef sarifRef (\b => SarifBox (append b.sarifItems [d]) 0))

-- | 诊断/告警实现：diagExitFor（详见 diagnostics.md）。
diagExitFor : Diagnostic -> Int
diagExitFor d = if d.diagInternal then 70
else case d.diagSeverity of
  SevError => 1
  _ => 0

-- | 诊断/告警实现：flushSarif（详见 diagnostics.md）。
flushSarif : Int -> Int
flushSarif code =
  let
    fmt = diagFormatOf 0
    box = runIO (readRef sarifRef)
    shown = takeDiags (maxErrorsOf 0) box.sarifItems
    _ = case fmt of
      "sarif" => runIO (prim_print (renderSarif shown ++ "\n"))
      "json" => runIO (prim_print (renderJsonList shown ++ "\n"))
      _ => 0
    _ = resetSarif 0
  in code

-- | 诊断/告警实现：denyWarningsRef（详见 diagnostics.md）。
denyWarningsRef : IORef Bool
denyWarningsRef = runIO (newRef False)

-- | 诊断/告警实现：showWarningsRef（详见 diagnostics.md）。
showWarningsRef : IORef Bool
showWarningsRef = runIO (newRef False)

-- | 诊断/告警实现：formatExplicitRef（详见 diagnostics.md）。
formatExplicitRef : IORef Bool
formatExplicitRef = runIO (newRef False)

-- | 诊断/告警实现：warningsExplicitRef（详见 diagnostics.md）。
warningsExplicitRef : IORef Bool
warningsExplicitRef = runIO (newRef False)

-- | 诊断/告警实现：maxErrorsRef（详见 diagnostics.md）。
maxErrorsRef : IORef Int
maxErrorsRef = runIO (newRef 0)

-- | 诊断/告警实现：maxErrorsOf（详见 diagnostics.md）。
maxErrorsOf : Int -> Int
maxErrorsOf _ = runIO (readRef maxErrorsRef)

-- 应用 vuna.toml [diagnostics]（命令行显式 flag 优先）。
-- | 诊断/告警实现：applyDiagConfig（详见 diagnostics.md）。
applyDiagConfig : Maybe Package -> Int
applyDiagConfig Nothing = 0
applyDiagConfig (Just pkg) =
  let
    m = pkg.packageManifest
    _ = if not (runIO (readRef formatExplicitRef)) then case m.manifestDiagFormat of
      Just f => runIO (writeRef diagFormatRef f)
      Nothing => 0
    else 0
    _ = if not (runIO (readRef warningsExplicitRef)) then case m.manifestDiagWarnings of
      Just b => runIO (writeRef showWarningsRef b)
      Nothing => 0
    else 0
    _ = if not (runIO (readRef langExplicitRef)) then case m.manifestDiagLang of
      Just l =>
        let
          _ = setDiagLang l
          _ = if l == "en" then 0
          else if not (runIO (readRef formatExplicitRef)) then case m.manifestDiagFormat of
            Nothing => runIO (writeRef diagFormatRef "human")
            Just _ => 0
          else 0
        in 0
      Nothing => 0
    else 0
    _ = if not (runIO (readRef denyExplicitRef)) then case m.manifestDiagDenyWarnings of
      Just b =>
        let
          _ = runIO (writeRef denyWarningsRef b)
          _ = if b then runIO (writeRef showWarningsRef True) else 0
        in 0
      Nothing => 0
    else 0
    _ = case m.manifestDiagMaxErrors of
      Just n => runIO (writeRef maxErrorsRef n)
      Nothing => 0
  in 0

-- | 诊断/告警实现：takeDiags（详见 diagnostics.md）。
takeDiags : Int -> List Diagnostic -> List Diagnostic
takeDiags n ds = if n <= 0 then ds else takeDiagsGo n ds

-- | 诊断/告警实现：takeDiagsGo（详见 diagnostics.md）。
takeDiagsGo : Int -> List Diagnostic -> List Diagnostic
takeDiagsGo n [] = []
takeDiagsGo n (d :: rest) = if n <= 0 then [] else d :: takeDiagsGo (n - 1) rest

-- | 诊断/告警实现：denyWarningsOn（详见 diagnostics.md）。
denyWarningsOn : Int -> Bool
denyWarningsOn _ = runIO (readRef denyWarningsRef)

-- | 诊断/告警实现：showWarningsOn（详见 diagnostics.md）。
showWarningsOn : Int -> Bool
showWarningsOn _ = runIO (readRef showWarningsRef)

-- | 诊断/告警实现：stripDenyWarnings（详见 diagnostics.md）。
stripDenyWarnings : List String -> List String
stripDenyWarnings [] = []
stripDenyWarnings (arg :: rest) =
  if arg == "--deny-warnings" || arg == "--warnings" || arg == "-W" then stripDenyWarnings rest
  else arg :: stripDenyWarnings rest

-- | 诊断/告警实现：hasDenyWarnings（详见 diagnostics.md）。
hasDenyWarnings : List String -> Bool
hasDenyWarnings [] = False
hasDenyWarnings (arg :: rest) = if arg == "--deny-warnings" then True else hasDenyWarnings rest

-- | 诊断/告警实现：hasShowWarnings（详见 diagnostics.md）。
hasShowWarnings : List String -> Bool
hasShowWarnings [] = False
hasShowWarnings (arg :: rest) =
  if arg == "--warnings" || arg == "-W" then True else hasShowWarnings rest

-- | 诊断/告警实现：hasFormatFlag（详见 diagnostics.md）。
hasFormatFlag : List String -> Bool
hasFormatFlag [] = False
hasFormatFlag (arg :: rest) =
  if arg == "--json" || startsWith "--error-format" arg || startsWith "--message-format" arg then True
  else hasFormatFlag rest

-- | 剥离并解析诊断格式参数。
stripDiagFormat : List String -> Pair (List String) (Maybe String)
stripDiagFormat args = stripDiagFormatGo args [] Nothing

-- | 诊断格式参数扫描实现。
stripDiagFormatGo : List String -> List String -> Maybe String -> Pair (List String) (Maybe String)
stripDiagFormatGo [] acc found = Pair (reverse acc) found
stripDiagFormatGo ("--json" :: rest) acc found = stripDiagFormatGo rest acc (Just "json")
stripDiagFormatGo ("--error-format" :: rest) acc found = case rest of
  value :: more => stripDiagFormatGo more acc (Just value)
  [] => Pair (reverse acc) (Just "short")
stripDiagFormatGo (arg :: rest) acc found =
  if startsWith "--error-format=" arg then stripDiagFormatGo rest acc
    (Just (substring (natFromInt 15) (natFromInt (strLength arg - 15)) arg))
  else if startsWith "--message-format=" arg then stripDiagFormatGo rest acc
    (Just (substring (natFromInt 17) (natFromInt (strLength arg - 17)) arg))
  else stripDiagFormatGo rest (arg :: acc) found

-- | 编译器 CLI 入口：剥离诊断参数后分发。
runCompilerCliFor : String -> List String -> Int
runCompilerCliFor prog args =
  let
    stripped = stripDiagFormat args
    strippedLang = stripLang (firstOf stripped)
    strippedMax = stripMaxErrors (firstOf strippedLang)
    _ = case secondOf stripped of
      Just fmt => runIO (writeRef diagFormatRef fmt)
      Nothing => 0
    kept = stripDenyWarnings (firstOf strippedMax)
    strippedContinue = stripContinueOnError kept
    _ = setDiagLang (secondOf strippedLang)
    _ =
      if secondOf strippedLang == "en" then 0
      else if secondOf stripped == Nothing then runIO (writeRef diagFormatRef "human") else 0
    _ = if secondOf strippedMax > 0 then runIO (writeRef maxErrorsRef (secondOf strippedMax)) else 0
    _ = resetSarif 0
    _ = runIO (writeRef denyWarningsRef (hasDenyWarnings args))
    _ = runIO (writeRef showWarningsRef (hasDenyWarnings args || hasShowWarnings args))
    _ = runIO (writeRef formatExplicitRef (hasFormatFlag args))
    _ = runIO (writeRef langExplicitRef (hasLangFlag args))
    _ = runIO (writeRef denyExplicitRef (hasDenyWarnings args))
    _ = runIO (writeRef warningsExplicitRef (hasDenyWarnings args || hasShowWarnings args))
    _ = runIO (writeRef continueOnErrorRef (secondOf strippedContinue))
  in if anyHelp (firstOf strippedContinue) then helpFor prog
  else flushSarif (runCompilerCliFor1 prog (firstOf strippedContinue))

-- 剥离 `--max-errors N`（写入全局上限；默认 0 = 不限）。
-- | 诊断参数解析：十进制数字，失败用默认值。
parseIntOr : String -> Int -> Int
parseIntOr s fallback = parseIntChars (strUnpack s) 0 0 fallback

-- | 十进制数字逐字符解析。
parseIntChars : List Int -> Int -> Int -> Int -> Int
parseIntChars [] acc count fallback = if count == 0 then fallback else acc
parseIntChars (c :: cs) acc count fallback =
  if c >= 48 && c <= 57 then parseIntChars cs (acc * 10 + (c - 48)) (count + 1) fallback
  else if count == 0 then fallback else acc

-- | 剥离并解析 --max-errors（写入全局上限）。
stripMaxErrors : List String -> Pair (List String) Int
stripMaxErrors args = stripMaxErrorsGo args [] 0

-- | --max-errors 参数扫描实现。
stripMaxErrorsGo : List String -> List String -> Int -> Pair (List String) Int
stripMaxErrorsGo [] acc n = Pair (reverse acc) n
stripMaxErrorsGo ("--max-errors" :: rest) acc n = case rest of
  v :: more => stripMaxErrorsGo more acc (parseIntOr v n)
  [] => Pair (reverse acc) n
stripMaxErrorsGo (arg :: rest) acc n =
  if startsWith "--max-errors=" arg then stripMaxErrorsGo rest acc
    (parseIntOr (substring (natFromInt 13) (natFromInt (strLength arg - 13)) arg) n)
  else stripMaxErrorsGo rest (arg :: acc) n

-- | 编译器 CLI 子命令分发。
runCompilerCliFor1 : String -> List String -> Int
runCompilerCliFor1 prog args = case args of
  [] => usageErr prog
  arg :: rest => case arg of
    "compile" => compileArgs prog rest
    "check" => checkArgs prog rest
    "build" => buildArgs prog rest
    "version" => printVersion 0
    "--version" => printVersion 0
    "seed" => removedCommand prog "seed" "use `build --out OUT [DIR]` or `compile DIR OUT`"
    "help" => helpFor prog
    _ => if startsWith "-" arg then removedFlag prog arg else unknownCommand prog arg

printVersion : Int -> Int
printVersion _ =
  let
    _ = runIO (prim_print "vuna-compiler ${vunaVersion}\n")
  in 0

anyHelp : List String -> Bool
anyHelp [] = False
anyHelp (arg :: rest) = if arg == "-h" || arg == "--help" then True else anyHelp rest

-- | CLI 辅助：helpFor（参数/退出码约定见 tooling.md）。
helpFor : String -> Int
helpFor prog =
  let
    _ = runIO (prim_print (compilerUsage prog))
  in 0

-- | CLI 辅助：usageErr（参数/退出码约定见 tooling.md）。
usageErr : String -> Int
usageErr prog =
  let
    _ = runIO (prim_print (compilerUsage prog))
  in 2

-- | CLI 辅助：unknownCommand（参数/退出码约定见 tooling.md）。
unknownCommand : String -> String -> Int
unknownCommand prog arg =
  let
    _ =
      runIO
        (prim_print "error: unknown command `${arg}`\nrun `${prog} help` for the command list\n")
  in 2

removedCommand : String -> String -> String -> Int
removedCommand prog cmd hint =
  let
    _ = runIO (prim_print "error: `${cmd}` has been removed; ${hint}\n")
  in 2

-- 被删除 flag 的可操作提示（Vuna.Cli 的工具命令复用同一张表）。
-- flag 名用「两条横线 + 名字」拼接：M26 验收要求源码中不再出现已删除 flag 的字面量
-- （尤其环境根 flag），同时保留可操作提示。
dashFlag : String -> String
dashFlag name = "--${name}"

removedFlagHint : String -> Maybe String
removedFlagHint flag =
  if flag == dashFlag "dt" then Just "DT is the only path; drop the flag"
  else if flag == dashFlag "package" then Just "use `build` or `compile`"
  else if flag == dashFlag "split" then Just "split is the only output model; use `build --out OUT [DIR]` or `compile <pkg-dir> OUT`"
  else if flag == dashFlag "root" then Just "module resolution is decided by the nearest vuna.toml; set VUNA_BASE for standalone files"
  else if flag == dashFlag "out" then Just "pass OUTDIR positionally to `compile`; `build` accepts --out DIR"
  else if flag == dashFlag "no-typecheck" then Just "checking is always enabled"
  else if flag == dashFlag "typecheck" then Just "checking is always enabled"
  else if flag == dashFlag "typed" then Just "DT is the only path" else Nothing

-- | CLI 辅助：removedFlag（参数/退出码约定见 tooling.md）。
removedFlag : String -> String -> Int
removedFlag prog flag = case removedFlagHint flag of
  Nothing => usageErr prog
  Just hint =>
    let
      _ = runIO (prim_print "error: ${flag} has been removed; ${hint}\n")
    in 2

-- 诊断打印统一走 DiagRender：能定位到源码时追加「位置 + 源码行 + 插入符」片段，
-- 定位失败（无位置 / 文件不可读 / 行越界 / 消息含换行）时逐字原样输出。
-- | CLI 辅助：printErrText（参数/退出码约定见 tooling.md）。
printErrText : String -> Int
printErrText e =
  let
    _ = runIO (prim_print (renderCliDiagnostic e))
  in 1

-- | 诊断/告警实现：diagFormatOf（详见 diagnostics.md）。
diagFormatOf : Int -> String
diagFormatOf _ = runIO (readRef diagFormatRef)

-- | 诊断/告警实现：severityLabelOf（详见 diagnostics.md）。
severityLabelOf : Diagnostic -> String
severityLabelOf d = case d.diagSeverity of
  SevError => "error"
  SevWarning => "warning"
  SevNote => "note"
  SevHelp => "help"

printDiagWithPrefix : String -> Diagnostic -> Int
printDiagWithPrefix extra d =
  let
    errs = takeParseErrors 0
  in case errs of
    [] => emitDiag extra d
    e :: _ =>
      let
        shown = takeDiags (maxErrorsOf 0) errs
        _ = map (emitDiag extra) shown
      in diagExitFor e

-- 单条诊断按当前格式输出并返回退出码。
-- | 按当前格式输出单条诊断并返回退出码。
emitDiag : String -> Diagnostic -> Int
emitDiag extra d =
  let
    fmt = diagFormatOf 0
  in if fmt == "json" then
    let
      _ = collectSarif d
    in diagExitFor d
  else if fmt == "human" then
    let
      _ = printErrText (renderHuman d ++ "\n")
    in diagExitFor d
  else if fmt == "sarif" then
    let
      _ = collectSarif d
    in diagExitFor d
  else
    let
      _ = printErrText (severityLabelOf d ++ ": " ++ extra ++ renderShort d ++ "\n")
    in diagExitFor d

-- | 输出错误诊断并返回退出码。
printDiag : Diagnostic -> Int
printDiag d = printDiagWithPrefix "" d

-- | 诊断输出辅助：printErr。
printErr : String -> Int
printErr e = printErrText "error: ${e}\n"

-- | 诊断/告警实现：printDiagList（详见 diagnostics.md）。
printDiagList : String -> List Diagnostic -> Int
printDiagList extra ds =
  let
    _ = map (printDiagWithPrefix extra) (takeDiags (maxErrorsOf 0) ds)
  in 0

printWarnings : List String -> Int
printWarnings [] = 0
printWarnings (w :: rest) =
  let
    _ = runIO (prim_print (renderCliDiagnostic "${w}\n"))
  in printWarnings rest

defaultDir : Maybe String -> String
defaultDir (Just dir2) = dir2
defaultDir Nothing = "."

-- 路径既不是文件也不是目录时的统一错误（先 prim_fileExists 再 prim_isDirectory：
-- 内建 prim_isDirectory 对不存在的路径会抛异常）。
-- | CLI 辅助：dtPathErr（参数/退出码约定见 tooling.md）。
dtPathErr : String -> Int
dtPathErr path = printErr "no such file or package directory: ${path}"

-- 可执行包解析：必须是目录、能读 vuna.toml、且有 app/Main.vuna。
executablePackage : String -> String -> Check Package
executablePackage label dir =
  if runIO (prim_fileExists dir) then if runIO (prim_isDirectory dir) then executablePackageAt label dir
  else err "${label}: expects a package directory, not a file: ${dir}"
  else err "no such file or package directory: ${dir}"

executablePackageAt : String -> String -> Check Package
executablePackageAt label dir =
  Vuna.Compiler.Common.bind (loadPackage dir)
    (\pkg => if runIO (prim_fileExists (packageEntry pkg)) then OkC pkg else err "${label}: library package ${packageName pkg} has no app/Main.vuna (executable package required)")

-- ---------------------------------------------------------------
-- compile：文件入口（最近的 vuna.toml 包上下文 / 无 manifest 的 base-only）
-- 或包目录入口（可执行包），逐模块写出到 OUTDIR；成功静默。
-- ---------------------------------------------------------------
-- | CLI 辅助：compileArgs（参数/退出码约定见 tooling.md）。
compileArgs : String -> List String -> Int
compileArgs prog args = compileParse prog True Nothing Nothing args

compileParse : String -> Bool -> Maybe String -> Maybe String -> List String -> Int
compileParse prog printResult entry outDir args = case args of
  [] => compileFinish prog printResult entry outDir
  "--no-print" :: rest => compileParse prog False entry outDir rest
  "--release" :: rest => compileParse prog printResult entry outDir rest
  arg :: rest => if startsWith "-" arg then removedFlag prog arg
  else case entry of
    Nothing => compileParse prog printResult (Just arg) outDir rest
    Just _ => case outDir of
      Nothing => compileParse prog printResult entry (Just arg) rest
      Just _ => usageErr prog

compileFinish : String -> Bool -> Maybe String -> Maybe String -> Int
compileFinish prog printResult Nothing outDir = usageErr prog
compileFinish prog printResult (Just e) outDir = case outDir of
  Nothing => usageErr prog
  Just out => compileRun printResult e out

compileRun : Bool -> String -> String -> Int
compileRun printResult entry outDir =
  if runIO (prim_fileExists entry) then if runIO (prim_isDirectory entry) then compilePkgDir printResult entry outDir
  else compileFileEntry printResult entry outDir
  else dtPathErr entry

compileFileEntry : Bool -> String -> String -> Int
compileFileEntry printResult entry outDir = case contextForFile entry of
  ErrC e => printDiag e
  OkC ctx =>
    let
      _ = applyDiagConfig (contextPackageOf ctx)
    in case compileToDir ctx entry printResult outDir of
      ErrC e => printDiag e
      OkC _ => finishWarningsDir outDir 0

compilePkgDir : Bool -> String -> String -> Int
compilePkgDir printResult dir outDir = case executablePackage "compile" dir of
  ErrC e => printDiag e
  OkC pkg =>
    let
      _ = applyDiagConfig (Just pkg)
    in case compileToDir (packageContext pkg) (packageEntry pkg) printResult outDir of
      ErrC e => printDiag e
      OkC _ => finishWarningsDir outDir 0

-- ---------------------------------------------------------------
-- check：文件入口（包上下文）或包目录（可执行包 check 入口；库包 check [export].modules）
-- ---------------------------------------------------------------
-- | CLI 辅助：checkArgs（参数/退出码约定见 tooling.md）。
checkArgs : String -> List String -> Int
checkArgs prog [] = usageErr prog
checkArgs prog ("--release" :: rest) = checkArgs prog rest
checkArgs prog (arg :: rest) = if startsWith "-" arg then removedFlag prog arg
else case rest of
  [] => checkEmit arg
  _ => usageErr prog

-- | CLI 辅助：checkEmit（参数/退出码约定见 tooling.md）。
checkEmit : String -> Int
checkEmit path =
  if runIO (prim_fileExists path) then if runIO (prim_isDirectory path) then checkPkgDir path else checkFileEntry path
  else dtPathErr path

checkPkgDir : String -> Int
checkPkgDir dir = case workspacePackages dir of
  ErrC e => printDiag e
  OkC pkgs => checkPackages pkgs 0

-- M30：workspace 是检查单元——根包 + [workspace].members 逐个检查，成员错误不再被
-- 根 check 忽略。错误带 `[包名]` 前缀；全部跑完再汇总退出码。
-- M34.4：多包 workspace 并行（成员包各一个 `vuna check <dir>` 子进程；根包在当前进程
-- 串行）。根包目录就是 workspace 根，spawn 它会再展开整个 workspace ⇒ 递归，所以按
-- `workspacePackages <dir>` 是否返回多包区分根 / 成员；单包目录的子进程只查自己。
-- 子进程继承 stdout/stderr（错误可能交错），退出码按失败汇总。
-- | CLI 辅助：checkSpawnArgs（参数/退出码约定见 tooling.md）。
checkSpawnArgs : String -> List String
checkSpawnArgs dir =
  let
    fmt = diagFormatOf 0
  in let
    base = if fmt == "short" then ["check", dir] else ["check", "--error-format", fmt, dir]
    base2 = if showWarningsOn 0 then append base ["--warnings"] else base
  in if denyWarningsOn 0 then append base2 ["--deny-warnings"] else base2

checkPackages : List Package -> Int -> Int
checkPackages [] code = code
checkPackages ([pkg]) code = checkPackageSeq pkg code
checkPackages pkgs code =
  let
    members = filter (\pkg => not (isWorkspaceRoot pkg)) pkgs
    roots = filter (\pkg => isWorkspaceRoot pkg) pkgs
    started = map (\pkg => Pair pkg (runIO (prim_spawn (checkSpawnArgs (packageDir pkg))))) members
    code1 = checkRootsSeq roots code
    codes = map (\pr => runIO (prim_wait (secondOf pr))) started
  in countFailures code1 codes

isWorkspaceRoot : Package -> Bool
isWorkspaceRoot pkg = case workspacePackages (packageDir pkg) of
  OkC ps => length ps > 1
  ErrC e => False

checkRootsSeq : List Package -> Int -> Int
checkRootsSeq [] code = code
checkRootsSeq (pkg :: rest) code = checkRootsSeq rest (checkPackageSeq pkg code)

checkPackageSeq : Package -> Int -> Int
checkPackageSeq pkg code =
  let
    _ = applyDiagConfig (Just pkg)
    c = case checkPackage pkg of
      ErrC e => checkPackageErr pkg e
      OkC _ =>
        let
          ws = filter (ownedByPackage pkg) (takeWarnings 0)
          shown = if showWarningsOn 0 || denyWarningsOn 0 then ws else []
          _ = printDiagList "[${packageName pkg}] " shown
          failed = if denyWarningsOn 0 && length ws > 0 then 1 else 0
        in failed
  in if c > code then c else code

countFailures : Int -> List Int -> Int
countFailures acc [] = acc
countFailures acc (c :: rest) = if c == 0 then countFailures acc rest else countFailures 1 rest

checkFileEntry : String -> Int
checkFileEntry path = case contextForFile path of
  ErrC e => printDiag e
  OkC ctx =>
    let
      _ = applyDiagConfig (contextPackageOf ctx)
    in case dtCheck ctx path of
      ErrC e => if runIO (readRef continueOnErrorRef) then case dtCheckRecovering ctx path of
        OkC ds =>
          let
            shown = takeDiags (runIO (readRef maxErrorsRef)) ds
            _ = printDiagList "" shown
          in if length shown == 0 then printDiag e else 1
        ErrC e2 => printDiag e
      else printDiag e
      OkC _ =>
        let
          ws = filter (ownedByFile path) (takeWarnings 0)
          shown = if showWarningsOn 0 || denyWarningsOn 0 then ws else []
          _ = printDiagList "" shown
        in if denyWarningsOn 0 && length ws > 0 then 1 else 0

-- ---------------------------------------------------------------
-- build：包级逐模块 codegen 到 DIR（默认 <PKG-DIR>/.output），再跑 build.sh 链接到
-- DIR/bin/<包名>；--no-compile 只做 codegen 不链接。
-- M30：workspace 根 = 构建单元（所有可执行成员各建到自己的 .output 或 DIR/<包名>；
-- 库成员只检查）；--package NAME 只建指定包（Nix 构建根包用，避免重复构建成员）。
-- build meta（同哈希跳过）见 Vuna.Compiler.Driver.Compile。
-- ---------------------------------------------------------------
-- | CLI 辅助：buildArgs（参数/退出码约定见 tooling.md）。
buildArgs : String -> List String -> Int
buildArgs prog args = buildParse prog False Nothing Nothing Nothing args

buildParse : String -> Bool -> Maybe String -> Maybe String -> Maybe String -> List String -> Int
buildParse prog noCompile out dir pkg args = case args of
  [] => buildRun noCompile (defaultDir dir) out pkg
  "--no-compile" :: rest => buildParse prog True out dir pkg rest
  "--release" :: rest => buildParse prog noCompile out dir pkg rest
  "--out" :: rest => case rest of
    outDir :: more => if startsWith "-" outDir then removedFlag prog outDir
    else case out of
      Nothing => buildParse prog noCompile (Just outDir) dir pkg more
      Just _ => usageErr prog
    [] => usageErr prog
  "--package" :: rest => case rest of
    name :: more => if startsWith "-" name then removedFlag prog name
    else case pkg of
      Nothing => buildParse prog noCompile out dir (Just name) more
      Just _ => usageErr prog
    [] => usageErr prog
  arg :: rest => if startsWith "-" arg then removedFlag prog arg
  else case dir of
    Nothing => buildParse prog noCompile out (Just arg) pkg rest
    Just _ => usageErr prog

buildRun : Bool -> String -> Maybe String -> Maybe String -> Int
buildRun noCompile dir outM pkgM = case workspacePackages dir of
  ErrC e => printDiag e
  OkC pkgs => if isSingleLibraryPackage pkgs then printErr (libraryOnlyMessage pkgs)
  else case selectBuildTargets pkgM pkgs of
    ErrC e => printDiag e
    OkC targets => buildTargets noCompile (length pkgs > 1) outM targets 0

-- 单包目录且是库包（没有 app/Main.vuna）→ build 必须报错（不是静默 skip）。
-- workspace 根里的库成员仍走 skip（构建单元覆盖全部可执行成员）。
isSingleLibraryPackage : List Package -> Bool
isSingleLibraryPackage ([pkg]) = not (runIO (prim_fileExists (packageEntry pkg)))
isSingleLibraryPackage _ = False

libraryOnlyMessage : List Package -> String
libraryOnlyMessage (pkg :: _) =
  "library package ${packageName pkg} has no app/Main.vuna (executable package required; use `check` for libraries)"
libraryOnlyMessage [] = "no package to build"

selectBuildTargets : Maybe String -> List Package -> Check (List Package)
selectBuildTargets Nothing pkgs = OkC pkgs
selectBuildTargets (Just name) pkgs = case findPackageByName name pkgs of
  Nothing => err "no such package in workspace: ${name}"
  Just pkg => OkC [pkg]

findPackageByName : String -> List Package -> Maybe Package
findPackageByName name [] = Nothing
findPackageByName name (pkg :: rest) =
  if packageName pkg == name then Just pkg else findPackageByName name rest

-- | CLI 辅助：buildTargets（参数/退出码约定见 tooling.md）。
buildTargets : Bool -> Bool -> Maybe String -> List Package -> Int -> Int
buildTargets noCompile multiOut outM [] code = code
buildTargets noCompile multiOut outM (pkg :: rest) code =
  let
    c = buildOne noCompile multiOut outM pkg
    next = if c > code then c else code
  in buildTargets noCompile multiOut outM rest next

-- 单包：可执行包 build；库包只 check（workspace 构建单元覆盖所有成员）。
buildOne : Bool -> Bool -> Maybe String -> Package -> Int
buildOne noCompile multiOut outM pkg =
  let
    name = packageName pkg
    outDir = case outM of
      Just out => if multiOut then "${out}/${name}" else out
      Nothing => "${packageDir pkg}/.output"
    entry = packageEntry pkg
  in if runIO (prim_fileExists entry) then
    let
      ctx = packageContext pkg
      binPath = "${outDir}/bin/${name}"
    in if noCompile then compileCodegen ctx entry outDir
    else if metaUpToDate outDir ctx entry binPath then
      let
        _ = runIO (prim_print "up to date: ${binPath}\n")
      in 0
    else case compileToDir ctx entry True outDir of
      ErrC e => printDiag e
      OkC _ => buildLinked ctx entry outDir name
  else case checkPackage pkg of
    ErrC e => printDiag e
    OkC warnings =>
      let
        _ = printWarnings warnings
        _ = runIO (prim_print "skipped (library): ${name} -> ${outDir}\n")
      in 0

compileCodegen : PackageContext -> String -> String -> Int
compileCodegen ctx entry outDir = case compileToDir ctx entry True outDir of
  ErrC e => printDiag e
  OkC _ => 0

-- 链接：先建 bin/（build.sh 的 -o bin/<pkg> 需要父目录存在），再跑 build.sh；
-- 链接成功后写 build-meta.json（同哈希跳过在 buildOne 入口判定）。
buildLinked : PackageContext -> String -> String -> String -> Int
buildLinked ctx entry outDir name =
  let
    _ = ensureDirPath "${outDir}/bin"
  in case runBuildScript outDir "bin/${name}" name of
    ErrC e => printDiag e
    OkC _ =>
      let
        _ = writeBuildMeta outDir ctx entry True
        _ = runIO (prim_print "built ${outDir}/bin/${name}\n")
      in 0

-- ---------------------------------------------------------------
-- warning 归属：只显示当前检查单元自己的文件（依赖包的 warning 不重复刷屏）。
-- ---------------------------------------------------------------
-- | 诊断/告警实现：stripDotSlash（详见 diagnostics.md）。
stripDotSlash : String -> String
stripDotSlash s =
  if startsWith "./" s then substring (natFromInt 2) (natFromInt (strLength s - 2)) s else s

-- | 诊断/告警实现：ownedByFile（详见 diagnostics.md）。
ownedByFile : String -> Diagnostic -> Bool
ownedByFile path d = stripDotSlash (diagFileOf d) == stripDotSlash path

-- | 诊断/告警实现：ownedByPackage（详见 diagnostics.md）。
ownedByPackage : Package -> Diagnostic -> Bool
ownedByPackage pkg d =
  let
    dir = stripDotSlash (packageDir pkg)
    file = stripDotSlash (diagFileOf d)
    prefix = if dir == "." || dir == "" then "" else "${dir}/"
  in startsWith "${prefix}lib/" file
    || startsWith "${prefix}app/" file
    || startsWith "${prefix}test/" file

-- compile/build 成功路径的 warning 消费（默认静默；-W 显示；--deny-warnings 提升退出码）。
-- | 诊断/告警实现：finishWarnings（详见 diagnostics.md）。
finishWarnings : Int -> Int
finishWarnings code =
  let
    ws = takeWarnings 0
    shown = if showWarningsOn 0 || denyWarningsOn 0 then ws else []
    _ = printDiagList "" shown
  in if denyWarningsOn 0 && length ws > 0 then 1 else code

-- 与 finishWarnings 相同，但失败时删除已生成的输出目录（编译失败不留产物）。
-- | 诊断/告警实现：finishWarningsDir（详见 diagnostics.md）。
finishWarningsDir : String -> Int -> Int
finishWarningsDir dir code =
  let
    ws = takeWarnings 0
    shown = if showWarningsOn 0 || denyWarningsOn 0 then ws else []
    _ = printDiagList "" shown
  in if denyWarningsOn 0 && length ws > 0 then
    let
      _ = runIO (prim_runIn "/" ["rm", "-rf", dir])
    in 1
  else code

-- 剥离 `--lang zh`（human 说明语言；默认 en）。
-- | 剥离 --lang 参数。
stripLang : List String -> Pair (List String) String
stripLang args = stripLangGo args [] "en"

-- | --lang 参数扫描实现。
stripLangGo : List String -> List String -> String -> Pair (List String) String
stripLangGo [] acc lang = Pair (reverse acc) lang
stripLangGo ("--lang" :: rest) acc lang = case rest of
  v :: more => stripLangGo more acc v
  [] => Pair (reverse acc) lang
stripLangGo (arg :: rest) acc lang =
  if startsWith "--lang=" arg then stripLangGo rest acc (substring (natFromInt 7) (natFromInt (strLength arg - 7)) arg)
  else stripLangGo rest (arg :: acc) lang

-- | 语言是否由命令行显式指定（显式 flag 优先于 manifest）。
langExplicitRef : IORef Bool
langExplicitRef = runIO (newRef False)

-- | 参数里是否显式给了 --lang。
hasLangFlag : List String -> Bool
hasLangFlag [] = False
hasLangFlag (arg :: rest) =
  if arg == "--lang" || startsWith "--lang=" arg then True else hasLangFlag rest

-- | `--deny-warnings` 是否由命令行显式给出（显式优先于 manifest）。
denyExplicitRef : IORef Bool
denyExplicitRef = runIO (newRef False)

-- | best-effort 多错误（elab 逐 decl 恢复）是否开启。
continueOnErrorRef : IORef Bool
continueOnErrorRef = runIO (newRef False)

stripContinueOnError : List String -> Pair (List String) Bool
stripContinueOnError args = stripContinueGo args [] False

stripContinueGo : List String -> List String -> Bool -> Pair (List String) Bool
stripContinueGo [] acc found = Pair (reverse acc) found
stripContinueGo ("--continue-on-error" :: rest) acc found = stripContinueGo rest acc True
stripContinueGo (arg :: rest) acc found = stripContinueGo rest (arg :: acc) found

checkPackageErr : Package -> Diagnostic -> Int
checkPackageErr pkg e =
  if recoverEnabled pkg then packageRecover pkg e else printDiagWithPrefix "[${packageName pkg}] " e

recoverEnabled : Package -> Bool
recoverEnabled pkg =
  runIO (readRef continueOnErrorRef) && runIO (prim_fileExists (packageEntry pkg))

packageRecover : Package -> Diagnostic -> Int
packageRecover pkg e = case dtCheckRecovering (packageContext pkg) (packageEntry pkg) of
  OkC ds =>
    let
      shown = takeDiags (runIO (readRef maxErrorsRef)) ds
      _ = printDiagList "[${packageName pkg}] " shown
    in if length shown == 0 then printDiagWithPrefix "[${packageName pkg}] " e else 1
  ErrC e2 => printDiagWithPrefix "[${packageName pkg}] " e2
