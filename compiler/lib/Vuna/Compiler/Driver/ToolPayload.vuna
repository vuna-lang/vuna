-- | 工具会话载荷的规范编码：`ToolContext` / `Index` 的记录树 → 规范字节。
module Vuna.Compiler.Driver.ToolPayload where

-- Vuna.Compiler.Driver.ToolPayload：工具会话（LSP / REPL）缓存载荷的**显式规范编码**。
--
-- 为什么要有这一层：`QVal` 只有 `QMarker` / `QBytes` / `QRef` 三种形态，装不下记录树。
-- 工具会话的类型值走「`QRef` + 内容寻址 blob」，所以必须有「记录 → 规范字节」的编码，
-- 而且必须是**自描述**的（不依赖 OCaml 值表示、不依赖 Marshal）。
--
-- 编码复用 iface 的既有编码器（`encModuleIfaceAt` / `encManifestAt` / `encSourceInfo` /
-- `encManifestEntry` / `encDepPair`），字段顺序 = `ToolContext` 的 record 声明顺序；
-- `decToolContextComplete` 要求**全部消费完**（尾部多余字节 ⇒ `Nothing`，与其它载荷一致）。
--
-- 载荷本身由 `Store` 承载（`storeWriteEff` / `storeReadAsEff`），codec 段用
-- `toolContextCodec`；blob 路径仍是内容寻址的 `<cache>/blobs/<digest>`。
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.String
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Iface

-- | 载荷 schema（字段集变化必须 bump；旧 blob 自然拒绝）。
export toolContextSchema : String
toolContextSchema = "vuna-tool-context 2"

-- | `Store` 载荷的 codec 段。
export toolContextCodec : String
toolContextCodec = "tool-context 2"

encToolContextPayload : ToolContext -> List String -> List String
encToolContextPayload ctx acc =
  let
    a = encList encModuleIfaceAt ctx.tcDepIfaces acc
    b = encList encDepPair ctx.tcDepHashes a
    c = encList encStr ctx.tcNeeded b
    d = encList encStr ctx.tcOwnNames c
  in encList encSourceInfo ctx.tcStats d

-- | `ToolContext` → 规范字节。
export encToolContext : ToolContext -> String
encToolContext ctx = encTop encToolContextPayload ctx

-- | 规范字节 → `ToolContext`（任何一步不符即 `Nothing`）。
export decToolContextComplete : String -> Maybe ToolContext
decToolContextComplete s = case decToolContextPayload (strLength s) (curOf s) of
  Nothing => Nothing
  Just (Pair ctx rest) => if curAtEnd rest then Just ctx else Nothing

decToolContextPayload : Int -> Cur -> Maybe (Pair ToolContext Cur)
decToolContextPayload fuel c = case decList decSourceInfo (fuel - 1) c of
  Nothing => Nothing
  Just (Pair stats b0) => case decList decStr (fuel - 1) b0 of
    Nothing => Nothing
    Just (Pair ownNames b1) => case decList decStr (fuel - 1) b1 of
      Nothing => Nothing
      Just (Pair needed b2) => case decList decDepPair (fuel - 1) b2 of
        Nothing => Nothing
        Just (Pair depHashes b3) => case decList decModuleIfaceAt (fuel - 1) b3 of
          Nothing => Nothing
          Just (Pair depIfaces b4) =>
            Just (Pair (ToolContext depIfaces depHashes needed ownNames stats) b4)
