module Vuna.Compiler.Driver.Native where

-- Vuna.Compiler.Driver.Native：native 目标驱动（M1）。
--
-- 复用 DT 检查 + `Codegen.Lower.lowerProgramOf` 得到整程序 IR，再交给
-- `Native.Module.build` / `Native.Render.renderProgram`，写到 `OUT/main.s`。
-- 链接由 CLI 的 `build` 分支调系统 `cc` 完成（`Native` 模块本身不 spawn）。
--
-- 边界：不 import Core/Elab/Intrinsics；只经由 Driver.Dt 与 Codegen.Lower。
import Base.Eff
import Base.HostRow
import Base.Int
import Base.Pair
import Vuna.Compiler.Common
import Vuna.Compiler.Diag
import Vuna.Compiler.Driver.Compile
import Vuna.Compiler.Driver.Dt
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Codegen.Lower
import Vuna.Compiler.Native.Model
import Vuna.Compiler.Native.Module
import Vuna.Compiler.Native.Render

nativeErrDiag : NativeErr -> Diagnostic
nativeErrDiag err = diagNoLoc SevError PhCodegen CatCodegen "" (nativeErrText err)

export compileNative : PackageContext -> String -> Bool -> String -> Eff hostRow (Check Int)
compileNative ctx entry printResult outDir = do
  _ <- ensureDirPath outDir
  checked <- dtCheckWithProgramParts ctx entry
  case checked of
    ErrC e => pure (ErrC e)
    OkC pair =>
      let
        pkg = secondOf pair
      in case lowerProgramOf pkg.checkedProgram.dtProgDatas pkg.checkedProgram.dtProgDefs of
        ErrC e => pure (ErrC e)
        OkC program => case build program printResult of
          NativeRejected err => pure (ErrC (nativeErrDiag err))
          NativeOk m => do
            _ <- raiseToRow hostRow (@vuna@prim_eff_writeFile "${outDir}/main.s" (renderProgram m))
            pure (OkC 1)
