module Vuna.Compiler.Driver.Dt where

-- Vuna.Compiler.Driver.Dt：DT 路径的 facade（供 Compile / CompilerCli / Interp 使用）。
--
-- M13 时 DT 是单文件自包含：parseSource → Elab →（check / codegen / 核心求值），
-- 不经过 Loader。**M20 起改为复用 `Loader`**：多文件、`import`、包目录都能用，
-- 名字解析完全交给既有 Loader（不新建平行 Loader）。
-- **M26**：入口统一吃 `PackageContext`（最近 vuna.toml + 依赖闭包；无 manifest 时
-- base-only）；旧环境根 / 单文件原始模式的 `dtCheckFile` / `dtCompileFile` 已删除。
-- 唯一 codegen 入口是 `dtSplitProject`（逐模块 split 输出模型）；DT 精化器按
-- **整程序**精化，模块边界对精化不构成约束。
import Base.HostRow
import Base.List
import Base.String
import Vuna.Compiler.Common
import Vuna.Compiler.Canonical.Ast
import Vuna.Compiler.Canonical.Bytes
import Base.HashMap
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Diagnostics.Warning
import Vuna.Compiler.Frontend.Ast
import Vuna.Compiler.Frontend.Parser
import Vuna.Compiler.Packages.Pkg
import Vuna.Compiler.Loader
import Vuna.Compiler.Core
import Vuna.Compiler.Elab
import Vuna.Compiler.Elab.Derive
import Vuna.Compiler.Elab.Meta
import Vuna.Compiler.Elab.Records
import Vuna.Compiler.Elab.Termination.Measure
import Vuna.Compiler.Elab.Types
import Vuna.Compiler.Elab.Prelude
import Vuna.Compiler.Intrinsics
import Vuna.Compiler.Codegen
import Vuna.Compiler.Codegen.Lower
import Vuna.Compiler.Codegen.Assembly
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Ir
import Vuna.Compiler.Driver.Cache
import Vuna.Compiler.Driver.Iface
import Vuna.Compiler.Driver.PerfCache
import Vuna.Compiler.Driver.Split

-- M34.5 模块级接口（S1）：一次成功 check 的**完整输入面**。接口摘要要按模块归属切
-- `DtProgram`，所以 check 的出口需要保留加载/解析后的模块表与入口声明（此前只返回
-- `DtProgram`，归属信息在中途被丢掉）。Loader 顺序是依赖者在前的反序。
export record CheckedPackage(..) where
  checkedProgram : DtProgram
  checkedModules : List Module
  checkedEntryDecls : List Decl
  -- 摘要路径下由依赖包摘要注入、因而不属于本包的 artifact 名字（写本包接口时跳过覆盖检查）。
  -- 全量路径为空（依赖模块的 decls 都在，归属可从声明推导）。
  checkedInherited : List String
  -- M4：本次检查产生的 warning（loader 的 unused-import + Elab 的 Ec.ecWarnings）。
  checkedWarnings : List Diagnostic

-- 项目声明的拼接顺序：Loader 的 modules 列表是「依赖在前」的**反序**（依赖者先
-- 出现，被依赖者靠后），DT 精化要求定义先于使用，因此先 reverse modules 再逐模块
-- 拼接，入口声明放最后。
dtProjectDecls : Pair (List Decl) (List Module) -> List Decl
dtProjectDecls parts = append (concatMap moduleDeclsOf (reverse (secondOf parts))) (firstOf parts)

-- 可执行包：入口文件 + 依赖模块（模块可见性由上下文的 roots 决定）。
dtLoad : PackageContext -> String -> Eff hostRow (Check (Pair (List Decl) (List Diagnostic)))
dtLoad ctx entry =
  let
    _ = dbg! "load-start"
  in do
    projectR <- loadProject ctx entry
    pure (case projectR of
      ErrC e => ErrC e
      OkC project =>
        let
          _ = dbg! "load-modules-done"
        in case resolveProjectWith (contextRelease ctx) project of
          ErrC e => ErrC e
          OkC resolved =>
            let
              _ = dbg! "resolve-done"
            in OkC (Pair (dtProjectDecls (secondOf resolved)) (firstOf resolved))
    )

-- M34.5 接口摘要（S1）：加载 + resolve 并保留模块归属（入口 / 库包两条入口）。
dtLoadPartsForCheck : PackageContext -> String -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module))))
dtLoadPartsForCheck ctx entry = do
  projectR <- loadProject ctx entry
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => resolveProjectWith (contextRelease ctx) project
  )

dtLoadModulesParts : PackageContext -> List String -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module))))
dtLoadModulesParts ctx names = do
  projectR <- loadProjectModules ctx names
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => resolveProjectWith (contextRelease ctx) project
  )

-- 声明序列的 check 尾部（入口与库包同一条精化路径）。
-- | 从已加载声明跑完整检查。
dtCheckDecls : Eff hostRow (Check (Pair (List Decl) (List Diagnostic))) -> Eff hostRow (Check (List Diagnostic))
dtCheckDecls loaded = do
  loadedR <- loaded
  pure (case loadedR of
    ErrC e => ErrC e
    OkC p => checkDeclsWithWarns (secondOf p) (firstOf p)
  )

checkDeclsWithWarns : List Diagnostic -> List Decl -> Check (List Diagnostic)
checkDeclsWithWarns loaderWarns decls =
  let
    _ = dbg! "decls-ready"
  in case elabProgramFull decls of
    ErrC e => ErrC e
    OkC program =>
      let
        _ = dbg! "elab-done"
      in case checkDtProgramOf (dtProgDatas program) (dtProgDefs program) of
        ErrC e => ErrC e
        OkC _ =>
          let
            _ = dbg! "codegen-check-done"
          in OkC
            (append loaderWarns (append (dtProgWarnings program) (warnUnusedDefsIn (dtProgDefs program))))

-- M34.5：与 dtCheck 同一条精化路径，但把 DtProgram / 模块表 / 入口声明一并返回
-- （检查缓存写接口摘要用）。
export dtCheckWithProgramParts : PackageContext -> String -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckWithProgramParts ctx entry =
  dtCheckPartsWithProgram (contextPackageName ctx) (dtLoadPartsForCheck ctx entry)

export dtCheckLibraryWithProgramParts : PackageContext -> List String -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckLibraryWithProgramParts ctx names =
  dtCheckPartsWithProgram (contextPackageName ctx) (dtLoadModulesParts ctx names)

dtCheckPartsWithProgram : String -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module)))) -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckPartsWithProgram pkg loaded = do
  loadedR <- loaded
  pure (case loadedR of
    ErrC e => ErrC e
    OkC resolved =>
      let
        parts = secondOf resolved
        loaderWarns = firstOf resolved
        decls = sealOpaqueDecls (secondOf parts) (firstOf parts)
      in case elabProgramFull decls of
        ErrC e => ErrC e
        OkC program =>
          let
            _ = dbg! "elab-done"
            warns = append loaderWarns (dtProgWarnings program)
          in case checkDtProgramOf (dtProgDatas program) (dtProgDefs program) of
            ErrC e => ErrC e
            OkC _ =>
              let
                _ = dbg! "codegen-check-done"
              in OkC (Pair warns (CheckedPackage program (secondOf parts) (firstOf parts) [] warns))
  )

-- D11：模块边界 seal。opaque 在模块末尾 seal（定义模块自身可展开）；abstract 在
-- 其 DFun 之后立即 seal（定义模块自身也不能展开）。seal 是内部 DAxiom，名字带
-- `@seal@` 前缀，elabBodies 见到后从 deftbl 移除目标体；体仍留在 ecDefs 供 codegen。
sealOpaqueDecls : List Module -> List Decl -> List Decl
sealOpaqueDecls modules entryDecls = append (concatMap sealModule (reverse modules)) entryDecls

sealModule : Module -> List Decl
sealModule m =
  let
    decls = moduleDeclsOf m
    names = moduleOpaqueOf m
    abstracts = map opaqueBaseName (filter isAbstractOpaqueName names)
    opaques = map opaqueBaseName (filter (\n => not (isAbstractOpaqueName n)) names)
    body = sealAbstractAfter decls abstracts
  in append body (map (sealDeclOf decls) opaques)

sealAbstractAfter : List Decl -> List String -> List Decl
sealAbstractAfter [] names = []
sealAbstractAfter (d :: rest) names = case d of
  DFun n pats body sp =>
    if memName n names then Base.List.Cons d (Base.List.Cons (sealDeclOf (d :: rest) n) (sealAbstractAfter rest names))
    else Base.List.Cons d (sealAbstractAfter rest names)
  _ => Base.List.Cons d (sealAbstractAfter rest names)

sealDeclOf : List Decl -> String -> Decl
sealDeclOf decls name =
  let
    ty = case opaqueSigType name decls of
      Just t => t
      Nothing => EVar "Type" sealSpan
  in DAxiom ("vuna_seal_" ++ name) ty sealSpan

sealSpan : Span
sealSpan = Span "<seal>" 1 1 1 1

opaqueSigType : String -> List Decl -> Maybe Expr
opaqueSigType name [] = Nothing
opaqueSigType name (d :: rest) = case d of
  DSig n ctx ty sp => if n == name then Just ty else opaqueSigType name rest
  _ => opaqueSigType name rest

-- | 入口文件检查。
export dtCheck : PackageContext -> String -> Eff hostRow (Check (List Diagnostic))
dtCheck ctx entry = do
  loadedR <- dtLoadPartsForCheck ctx entry
  pure (case loadedR of
    ErrC e => ErrC e
    OkC resolved =>
      let
        parts = secondOf resolved
        modules = secondOf parts
        decls = sealOpaqueDecls modules (firstOf parts)
      in checkDeclsWithWarns (firstOf resolved) decls
  )

-- M45：单文件检查的两个入口（`vuna check <file.vuna>`）。
--
-- 带 `module` 头的文件按**库模块**语义检查：与 LSP 打开同包库文件走同一条
-- `loadModuleSource` + `elabProgramFull` + `checkDtProgramOf` 链（含用量/遮蔽告警），
-- 但**不**跑 `warnUnusedDefsIn`（库包导出面未知，会把导出函数全报成未使用），
-- 也不写 iface / check 缓存。无头文件仍走入口语义（`dtCheck`）。
export dtFileHasModuleHeader : String -> Eff hostRow Bool
dtFileHasModuleHeader path = do
  text <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
  parsed <- parseFileWithPath path text
  pure (case parsed of
    OkC (SourceFile (Just _) _ _ _ _ _ _) => True
    _ => False
  )

-- | 按库模块检查单个文件（调用方已确认带 `module` 头）。
export dtCheckModuleFile : PackageContext -> String -> Eff hostRow (Check (List Diagnostic))
dtCheckModuleFile ctx path = do
  text <- raiseToRow hostRow (@vuna@prim_eff_readFile path)
  checked <- dtCheckSourceChecked ctx path text
  pure (case checked of
    ErrC e => ErrC e
    OkC p => OkC (firstOf p)
  )

-- 核心求值器：精化后用 NbE + delta 求 main 的值并 show（与 codegen 结果对照）。
export dtEvalFile : PackageContext -> String -> Eff hostRow (Check String)
dtEvalFile ctx entry = do
  partsR <- dtLoadPartsForCheck ctx entry
  pure (case partsR of
    ErrC e => ErrC e
    OkC resolved =>
      let
        parts = secondOf resolved
        decls = sealOpaqueDecls (secondOf parts) (firstOf parts)
      in Vuna.Compiler.Common.bind (elabProgramFull decls) evalDtMain
  )

-- REPL 的表达式求值（M23）：上下文 + program 源码 + 表达式源码。
-- program 里的定义必须有签名（REPL 用户逐行输入签名）；表达式在程序的环境
-- （globals / 实例 / 字典解表）里精化，再求值并 show。program 的 import 按上下文
-- 的 roots 从磁盘解析（`loadProjectSource`），所以 REPL 可以把 import 行一起缓冲进来。
--
-- 表达式的名字解析**必须**经过 Loader（`import Base.List` 后写 `length xs` 得到的是
-- `Base.List.length`）：因此把表达式拼成一条合成定义 `vuna_repl_expr = <expr>` 一起
-- 加载，取回解析/限定后的体，再把这条合成定义从声明表里摘掉、交给 DT 精化。
-- 全量加载 REPL program + 合成表达式定义，并取出 (DtProgram, Expr)。
-- 接口路径不可用/闭包不完整时的回退目标（与 dtEvalExpr* 共用，避免两套加载语义）。
replProgramFull : PackageContext -> String -> String -> Eff hostRow (Check (Pair DtProgram Expr))
replProgramFull ctx program exprSource = do
  projectR <- loadProjectSource ctx "<repl>" "${program}\n${replExprName} = ${exprSource}\n"
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => case resolveProjectWith (contextRelease ctx) project of
      ErrC e => ErrC e
      OkC resolved => case splitReplExpr (sealOpaqueDecls (secondOf (secondOf resolved)) (firstOf (secondOf resolved))) of
        ErrC e => ErrC e
        OkC p => case elabProgramFull (firstOf p) of
          ErrC e => ErrC e
          OkC prog => OkC (Pair prog (secondOf p))
  )

export dtEvalExpr : PackageContext -> String -> String -> Eff hostRow (Check String)
dtEvalExpr ctx program exprSource = do
  pR <- replProgramFull ctx program exprSource
  pure (case pR of
    ErrC e => ErrC e
    OkC p => dtEvalExprIn (firstOf p) (secondOf p)
  )

-- M30 · REPL：表达式求值 + 类型文本。REPL 用类型判断是否为 `Eff [] a`（决定是否走
-- compile+run）；类型文本经 `showTerm` 渲染 zonk 后的类型，可直接写回合成签名的
-- `main : <type>`。
export dtEvalExprInfo : PackageContext -> String -> String -> Eff hostRow (Check (Pair String String))
dtEvalExprInfo ctx program exprSource = do
  pR <- replProgramFull ctx program exprSource
  pure (case pR of
    ErrC e => ErrC e
    OkC p => dtEvalExprInInfo (firstOf p) (secondOf p)
  )

-- M30 · LSP：把内存里的源码当入口（无模块头）或库模块（有模块头）加载并精化。
-- 返回空 warning 列表；错误串仍是带 `<label>:line:col` 的稳定诊断，LSP 自行解析。
export dtCheckSource : PackageContext -> String -> String -> Eff hostRow (Check (List Diagnostic))
dtCheckSource ctx label source = do
  projectR <- loadModuleSource ctx label source
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => case resolveProjectWith (contextRelease ctx) project of
      ErrC e => ErrC e
      OkC resolved => case elabProgramFull (sealOpaqueDecls (secondOf (secondOf resolved)) (firstOf (secondOf resolved))) of
        ErrC e => ErrC e
        OkC prog => OkC (append (firstOf resolved) (dtProgWarnings prog))
  )

-- M34.5（LSP 消费接口）：依赖包模块从接口预置（零 parse/resolve/elab），只精化当前
-- 源码文件与同包源码。接口不可用时调用方退回不带 ifaces 的版本。
-- M34.6 安全阀：同包模块自己的 import 可能带出闭包外的依赖模块（它们会被 Loader 从源码
-- 加载、却没有 artifact 注入 ⇒ 假 TC_UnknownName）。发现任何依赖模块缺 artifact 就整体
-- 回退全量路径：宁可慢，不能静默给出错误诊断。
missingDepModules : String -> List Module -> List String -> List String
missingDepModules pkg [] _ = []
missingDepModules pkg (m :: rest) ifaceNames =
  if modulePackageOf m /= pkg && memName (moduleNameOf m) ifaceNames == False then Base.List.Cons (moduleNameOf m) (missingDepModules pkg rest ifaceNames)
  else missingDepModules pkg rest ifaceNames

export dtCheckSourceWithIfaces : PackageContext -> String -> String -> List ModuleIface -> Eff hostRow (Check (List Diagnostic))
dtCheckSourceWithIfaces ctx label source ifaces =
  let
    _ = dbg! "iface-source=check modules=${length ifaces}"
  in do
    projectR <- loadModuleSourceWithPreloaded ctx label source (modulesOfIfaces ifaces)
    case projectR of
      ErrC e => pure (ErrC e)
      OkC project => case filterProjectToImports (contextPackageName ctx) project of
        Pair filtered mods =>
          let
            missing = missingDepModules (contextPackageName ctx) mods (map miNameOf ifaces)
            _ =
              if length missing > 0 then dbg! "iface-fallback=check missing=${join "," missing}"
              else 0
          in if length missing == 0 then pure (case resolveProjectKeeping (contextRelease ctx) (preloadKeepOf ifaces mods) filtered of
            ErrC e => ErrC e
            OkC resolved => case shiftedDepPrograms (materializedDeps (contextPackageName ctx) (secondOf resolved) ifaces) of
              ErrC e => ErrC e
              OkC deps => case dtCheckOursParts ctx resolved deps of
                ErrC e => ErrC e
                OkC p => OkC (firstOf p)
          )
          else dtCheckSource ctx label source

-- M34.5（REPL 消费接口）：REPL 程序（入口声明）在依赖接口之上精化，不再重精化依赖。
-- M34.6：
--   ① **同包**源码模块（REPL 所在包里被 program import 的模块）不是依赖接口，必须与入口
--     声明一起精化，否则表达式引用同包定义会报假 `TC_UnknownName <模块>.<定义>`；
--   ② 组装结果必须补回依赖接口的 datas / defs（`elabProgramFullWithAux` 只返回本次新精化
--     的 datas，表达式求值 `dtEvalExprIn` 会从 DtProgram 重建 Ec；缺依赖 datas ⇒ 依赖包
--     构造子查不到，`[1, 2, 3]` 这类字面量在 REPL 里报 `TC_UnknownName Base.List.Cons`）；
--   ③ M34.6（5b）：termAux（依赖包 decls）跨表达式不变，record/deriving 预处理可复用。
replCheckParts : Pair Ec (List (Pair String Term)) -> String -> List CachedProgram -> Pair (List Decl) (List Module) -> Check (Pair DtProgram Expr)
replCheckParts start pkgName deps parts =
  Vuna.Compiler.Common.bind (replCheckPartsAux start pkgName deps parts [] Nothing)
    (\r => OkC (firstOf r))

-- `ifaces` 只用于缓存 key（与 termAux 的模块集合一一对应；为空时不共享缓存）。
replCheckPartsAux : Pair Ec (List (Pair String Term)) -> String -> List CachedProgram -> Pair (List Decl) (List Module) -> List ModuleIface -> Maybe AuxCache -> Check (Pair (Pair DtProgram Expr) (Maybe AuxCache))
replCheckPartsAux start pkgName deps parts ifaces cache =
  let
    modules = reverse (secondOf parts)
    depsOnly = filter (\m => modulePackageOf m /= pkgName) modules
    oursOnly = filter (\m => modulePackageOf m == pkgName) modules
    termAux = concatMap moduleDeclsOf depsOnly
    ownDecls = concatMap moduleDeclsOf oursOnly
    -- 依赖模块由 iface start 注入（termAux 只服务 record/终止性上下文）；
    -- 同包模块按 dtProjectDecls 的顺序（依赖在前）与入口声明一起精化。
    sourceDecls = append ownDecls (firstOf parts)
    key = dtAuxKey pkgName ifaces []
    cacheable = length ifaces > 0
    cachedDecls = if cacheable then dtAuxOfCache key cache else Nothing
    prepared = case cachedDecls of
      Just c => OkC c.auxCacheDecls
      Nothing => dtPrepareTermAux termAux
  in Vuna.Compiler.Common.bind prepared (\preparedAux => Vuna.Compiler.Common.bind (splitReplExpr sourceDecls) (\p => Vuna.Compiler.Common.bind (dtElabFullWithPrepared (firstOf start) (secondOf start) termAux preparedAux (firstOf p)) (\prog => let
    depDatas = concatMap cachedDatas deps
    depDefs = concatMap cachedDefs deps
    depGlobals = concatMap cachedGlobals deps
    assembled =
      DtProgram (append depDatas (dtProgDatas prog)) (append depDefs (dtProgDefs prog))
        (dtProgGoals prog) (dtProgSols prog) (dedupGlobals (append depGlobals (dtProgGlobals prog)))
        (dtProgInsts prog) (dtProgClasses prog) prog.dtProgNext prog.dtProgDefVals prog.dtProgDepths
        (dtProgWarnings prog)
  in OkC
    (Pair (Pair assembled (secondOf p)) (if cacheable then Just (AuxCache key preparedAux (Pair ecEmpty []) [] []) else Nothing))
  )
  )
  )

replProgramWithIfaces : PackageContext -> String -> String -> List ModuleIface -> Eff hostRow (Check (Pair DtProgram Expr))
replProgramWithIfaces ctx program exprSource ifaces = do
  r <- replProgramWithIfacesAux ctx program exprSource ifaces Nothing
  pure (case r of
    ErrC e => ErrC e
    OkC p => OkC (firstOf p)
  )

-- M34.6（5b）：会话入口带 termAux 预处理缓存（同一条加载/精化路径，缓存只是省的固定开销）。
replProgramWithIfacesAux : PackageContext -> String -> String -> List ModuleIface -> Maybe AuxCache -> Eff hostRow (Check (Pair (Pair DtProgram Expr) (Maybe AuxCache)))
replProgramWithIfacesAux ctx program exprSource ifaces cache =
  let
    _ = dbg! "iface-source=repl modules=${length ifaces}"
    src = "${program}\n${replExprName} = ${exprSource}\n"
  in do
    loaded <- loadProjectSourceWithPreloaded ctx "<repl>" src (modulesOfIfaces ifaces)
    case loaded of
      ErrC e => pure (ErrC e)
      OkC project => case filterProjectToImports (contextPackageName ctx) project of
        Pair filtered mods =>
          let
            missing = missingDepModules (contextPackageName ctx) mods (map miNameOf ifaces)
            _ =
              if length missing > 0 then dbg! "iface-fallback=repl missing=${join "," missing}"
              else 0
          in if length missing == 0 then pure (case resolveProjectKeeping (contextRelease ctx) (preloadKeepOf ifaces mods) filtered of
            ErrC e => ErrC e
            OkC resolved => case shiftedDepPrograms (materializedDeps (contextPackageName ctx) (secondOf resolved) ifaces) of
              ErrC e => ErrC e
              OkC deps =>
                let
                  parts = secondOf resolved
                in replCheckPartsAux (depStartOf deps) (contextPackageName ctx) deps parts ifaces cache
          )
          else do
            pR <- replProgramFull ctx program exprSource
            pure (case pR of
              ErrC e => ErrC e
              OkC p => OkC (Pair p cache)
            )

-- REPL 会话入口：复用 termAux 预处理缓存（5b），返回更新后的缓存。
export dtEvalExprInfoWithAuxCache : PackageContext -> String -> String -> List ModuleIface -> Maybe AuxCache -> Eff hostRow (Check (Pair (Pair String String) (Maybe AuxCache)))
dtEvalExprInfoWithAuxCache ctx program exprSource ifaces cache = do
  pR <- replProgramWithIfacesAux ctx program exprSource ifaces cache
  pure (case pR of
    ErrC e => ErrC e
    OkC p => case dtEvalExprInInfo (firstOf (firstOf p)) (secondOf (firstOf p)) of
      ErrC e => ErrC e
      OkC info => OkC (Pair info (secondOf p))
  )

export dtEvalExprWithAuxCache : PackageContext -> String -> String -> List ModuleIface -> Maybe AuxCache -> Eff hostRow (Check (Pair String (Maybe AuxCache)))
dtEvalExprWithAuxCache ctx program exprSource ifaces cache = do
  pR <- replProgramWithIfacesAux ctx program exprSource ifaces cache
  pure (case pR of
    ErrC e => ErrC e
    OkC p => case dtEvalExprIn (firstOf (firstOf p)) (secondOf (firstOf p)) of
      ErrC e => ErrC e
      OkC out => OkC (Pair out (secondOf p))
  )

export dtEvalExprInfoWithIfaces : PackageContext -> String -> String -> List ModuleIface -> Eff hostRow (Check (Pair String String))
dtEvalExprInfoWithIfaces ctx program exprSource ifaces = do
  pR <- replProgramWithIfaces ctx program exprSource ifaces
  pure (case pR of
    ErrC e => ErrC e
    OkC p => dtEvalExprInInfo (firstOf p) (secondOf p)
  )

export dtEvalExprWithIfaces : PackageContext -> String -> String -> List ModuleIface -> Eff hostRow (Check String)
dtEvalExprWithIfaces ctx program exprSource ifaces = do
  pR <- replProgramWithIfaces ctx program exprSource ifaces
  pure (case pR of
    ErrC e => ErrC e
    OkC p => dtEvalExprIn (firstOf p) (secondOf p)
  )

-- ---------------------------------------------------------------
-- REPL v2：自动签名与缓冲绑定类型
--
-- `dtInferDefTypes` 为缺签名的顶层 DFun 推断可回读的类型签名：
--   1. 解析 defSource 得到每个 target 的参数元数（多 clause 取首子句）；
--   2. 用 `newMeta` 为每个 target 造「域元变量 + 结果元变量」的匿名 Pi telescope，
--      作为 `elabProgramFullWith` 的起始 globals；
--   3. 复用整程序精化路径检查定义体（模式 / trait / 终止性规则与普通定义一致）；
--   4. 类型里残余的未解元变量是定义边界上的自由类型变量，泛化成隐式 `{tN : Type}`
--      （按最大应用元数给 `Type -> … -> Type`），再用 `showTypeSig` 渲染。
-- 推断结果由 REPL 写回源码后**再检查一遍**；失败回滚，不污染会话。
-- 走全量加载路径（不复用依赖接口缓存）：自动签名只在定义时发生一次，正确性优先。
record GenMeta where
  genMetaId : Int
  genMetaName : String
  genMetaKind : Term

export dtInferDefTypes : PackageContext -> String -> List String -> String -> Eff hostRow (Check (List (Pair String String)))
dtInferDefTypes ctx program targets defSource = if length targets == 0 then pure (OkC [])
else case parseSource "<repl>" defSource of
  ErrC e => pure (ErrC e)
  OkC (SourceFile hdr _ _ defDecls _ _ _) => case hdr of
    Just _ => pure (err "自动签名不支持模块文件")
    Nothing => case aritiesOf targets defDecls of
      ErrC e => pure (ErrC e)
      OkC arities =>
        let
          Pair entries ecStart = allocTelescopes emptyCtx ecEmpty arities
          startGlobals = append entries preludeGlobals
        in do
          allDeclsR <- loadReplDecls ctx (program ++ "\n" ++ defSource ++ "\n")
          pure (case allDeclsR of
            ErrC e => ErrC e
            OkC allDecls => case elabProgramFullWith ecStart startGlobals allDecls of
              ErrC e => ErrC e
              OkC prog =>
                let
                  taken = topNames allDecls
                  Pair ecOut _ = ecOfProgram prog
                in inferEachType targets prog ecOut taken
          )

-- target 名 → 参数元数（找不到 DFun 就报错：自动签名只处理函数/值定义）。
aritiesOf : List String -> List Decl -> Check (List (Pair String Int))
aritiesOf [] decls = OkC []
aritiesOf (t :: rest) decls = case findArity t decls of
  Nothing => err ("自动签名: 找不到定义 " ++ t ++ "（需要 DFun）")
  Just n =>
    Vuna.Compiler.Common.bind (aritiesOf rest decls) (\more => OkC (Base.List.Cons (Pair t n) more))

findArity : String -> List Decl -> Maybe Int
findArity name [] = Nothing
findArity name (d :: rest) = case d of
  DFun n pats _ _ => if n == name then Just (listLen pats) else findArity name rest
  _ => findArity name rest

-- 每个 target 一条 `?d1 -> ... -> ?dn -> ?r`（域匿名 binder，结果元变量）。
allocTelescopes : Ctx -> Ec -> List (Pair String Int) -> Pair (List (Pair String Term)) Ec
allocTelescopes ctx ec [] = Pair [] ec
allocTelescopes ctx ec ((Pair name arity) :: rest) =
  let
    Pair doms ec1 = allocMetas ctx ec (range 0 arity)
    Pair results ec2 = allocMetas ctx ec1 (range 0 1)
  in case results of
    [r] =>
      let
        Pair more ec3 = allocTelescopes ctx ec2 rest
      in Pair (Pair name (buildPi doms r) :: more) ec3
    _ => Pair [] ec2

allocMetas : Ctx -> Ec -> List Int -> Pair (List Term) Ec
allocMetas ctx ec [] = Pair [] ec
allocMetas ctx ec (_ :: rest) =
  let
    Pair meta ec1 = newMeta ctx ec
    Pair metas ec2 = allocMetas ctx ec1 rest
  in Pair (meta :: metas) ec2

buildPi : List Term -> Term -> Term
buildPi [] result = result
buildPi (dom :: rest) result = TPi "_" False RigOmega dom (buildPi rest result)

inferEachType : List String -> DtProgram -> Ec -> List String -> Check (List (Pair String String))
inferEachType [] prog ec taken = OkC []
inferEachType (t :: rest) prog ec taken = case findDtDef t (dtProgDefs prog) of
  Nothing => err ("自动签名: 精化结果里找不到定义 " ++ t)
  Just def =>
    Vuna.Compiler.Common.bind (generalizeSignature (zonkTerm ec 0 (dtDefType def)) taken)
      (\sigText => Vuna.Compiler.Common.bind (inferEachType rest prog ec taken) (\more => OkC (Base.List.Cons (Pair t sigText) more)))

findDtDef : String -> List DtDef -> Maybe DtDef
findDtDef name [] = Nothing
findDtDef name (d :: rest) = if dtDefName d == name then Just d else findDtDef name rest

-- 全量读取内存 program 的声明（Loader flatten → 入口+模块声明）。
loadReplDecls : PackageContext -> String -> Eff hostRow (Check (List Decl))
loadReplDecls ctx source = do
  projectR <- loadProjectSource ctx "<repl>" source
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => case resolveProjectWith (contextRelease ctx) project of
      ErrC e => ErrC e
      OkC resolved => OkC (dtProjectDecls (secondOf resolved))
  )

-- `:defs` / `:info`：program 里每个定义的 zonk 后类型文本。
export dtBindingTypes : PackageContext -> String -> Eff hostRow (Check (List (Pair String String)))
dtBindingTypes ctx program = do
  declsR <- loadReplDecls ctx program
  pure (case declsR of
    ErrC e => ErrC e
    OkC decls => case elabProgramFull decls of
      ErrC e => ErrC e
      OkC prog =>
        let
          Pair ec _ = ecOfProgram prog
        in OkC
          (map (\d => Pair (dtDefName d) (showTypeSig (zonkTerm ec 0 (dtDefType d)))) (dtProgDefs prog))
  )

-- 残余未解元变量 → 隐式类型参数；元变量按类型项中出现顺序（去重）编号。
generalizeSignature : Term -> List String -> Check String
generalizeSignature ty taken =
  let
    metas = dedupInts (metaIdsOf ty)
  in if length metas == 0 then OkC (showTypeSig ty)
  else if length metas > 8 then err "自动推断出的类型参数超过 8 个，请先写类型签名"
  else
    let
      entries = buildGenMetas metas taken 0 ty
      total = listLen entries
      body = substGenMetas ty entries 0 total
      sigText = showTypeSig (wrapGenMetas entries body)
    in if contains "?" sigText then err "自动推断的签名仍含未解元变量，请先写类型签名"
    else OkC sigText

buildGenMetas : List Int -> List String -> Int -> Term -> List GenMeta
buildGenMetas [] taken i ty = []
buildGenMetas (m :: rest) taken i ty =
  let
    name = freshMetaName ("t" ++ strFromInt i) taken
    kind = kindOfArity (maxMetaArity m ty)
  in GenMeta m name kind :: buildGenMetas rest (name :: taken) (i + 1) ty

freshMetaName : String -> List String -> String
freshMetaName base taken = pickFreshName base taken (0 :: range 1 64)

pickFreshName : String -> List String -> List Int -> String
pickFreshName base taken [] = base
pickFreshName base taken (n :: rest) =
  let
    cand = if n == 0 then base else base ++ "_" ++ strFromInt n
  in if memName cand taken then pickFreshName base taken rest else cand

-- 第 i 个泛化元变量在 n 个新 binder 中从外到内排：出现点局部深度 d 处的引用索引
-- 应为 d + (n - 1 - i)，即 `substMetaVar m name (i + 1 - n)`（q 可为负）。
substGenMetas : Term -> List GenMeta -> Int -> Int -> Term
substGenMetas ty [] i total = ty
substGenMetas ty (g :: rest) i total =
  substGenMetas (substMetaVar g.genMetaId g.genMetaName (i + 1 - total) ty) rest (i + 1) total

wrapGenMetas : List GenMeta -> Term -> Term
wrapGenMetas [] t = t
wrapGenMetas (g :: rest) t = TPi g.genMetaName True RigOmega g.genMetaKind (wrapGenMetas rest t)

kindOfArity : Int -> Term
kindOfArity k = kindArrows (range 0 k)

kindArrows : List Int -> Term
kindArrows [] = TType levelZero
kindArrows (_ :: rest) = TPi "_" False RigOmega (TType levelZero) (kindArrows rest)

-- 类型项里的未解元变量（zonk 已替换已解者，剩下的都是未解）。
metaIdsOf : Term -> List Int
metaIdsOf (TMeta m) = [m]
metaIdsOf (TPi _ _ _ dom cod) = append (metaIdsOf dom) (metaIdsOf cod)
metaIdsOf (TLam _ _ body) = metaIdsOf body
metaIdsOf (TApp f a _) = append (metaIdsOf f) (metaIdsOf a)
metaIdsOf (TCon _ args) = metaIdsOfArgs args
metaIdsOf (TCase scrut alts) = append (metaIdsOf scrut) (concatMap metaIdsOfAlt alts)
metaIdsOf (TIf c th el) = append (metaIdsOf c) (append (metaIdsOf th) (metaIdsOf el))
metaIdsOf _ = []

metaIdsOfArgs : List (Pair Term Rig) -> List Int
metaIdsOfArgs [] = []
metaIdsOfArgs ((Pair a _) :: rest) = append (metaIdsOf a) (metaIdsOfArgs rest)

metaIdsOfAlt : CaseAlt -> List Int
metaIdsOfAlt (CaseAlt _ _ body) = metaIdsOf body

dedupInts : List Int -> List Int
dedupInts [] = []
dedupInts (x :: rest) =
  if memMetaId x rest then dedupInts rest else Base.List.Cons x (dedupInts rest)

-- 某个元变量在类型项里被应用的最大元数（决定泛化后的 kind）。
maxMetaArity : Int -> Term -> Int
maxMetaArity m (TApp f a r) =
  imax (applyArity m (TApp f a r)) (imax (maxMetaArity m f) (maxMetaArity m a))
maxMetaArity m (TPi _ _ _ dom cod) = imax (maxMetaArity m dom) (maxMetaArity m cod)
maxMetaArity m (TLam _ _ body) = maxMetaArity m body
maxMetaArity m (TCon _ args) = maxMetaArityArgs m args
maxMetaArity m (TCase scrut alts) = imax (maxMetaArity m scrut) (maxMetaArityAlts m alts)
maxMetaArity m (TIf c th el) =
  imax (maxMetaArity m c) (imax (maxMetaArity m th) (maxMetaArity m el))
maxMetaArity m _ = 0

maxMetaArityArgs : Int -> List (Pair Term Rig) -> Int
maxMetaArityArgs m [] = 0
maxMetaArityArgs m ((Pair a _) :: rest) = imax (maxMetaArity m a) (maxMetaArityArgs m rest)

maxMetaArityAlts : Int -> List CaseAlt -> Int
maxMetaArityAlts m [] = 0
maxMetaArityAlts m (alt :: rest) = imax (maxMetaArity m (caseAltBody alt)) (maxMetaArityAlts m rest)

applyArity : Int -> Term -> Int
applyArity m t = if headIsMeta m t then spineLen t else 0

headIsMeta : Int -> Term -> Bool
headIsMeta m (TApp f _ _) = headIsMeta m f
headIsMeta m (TMeta n) = m == n
headIsMeta m _ = False

spineLen : Term -> Int
spineLen (TApp f _ _) = 1 + spineLen f
spineLen _ = 0

imax : Int -> Int -> Int
imax a b = if a >= b then a else b

listLen : List a -> Int
listLen [] = 0
listLen (_ :: rest) = 1 + listLen rest

-- M30 · LSP hover：内存源码的洞目标（与 `vuna goal` 同源）。
export dtGoalsSource : PackageContext -> String -> String -> Eff hostRow (Check (List DtGoalInfo))
dtGoalsSource ctx label source = do
  projectR <- loadModuleSource ctx label source
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => case resolveProjectWith (contextRelease ctx) project of
      ErrC e => ErrC e
      OkC resolved => goalsOfProgram (dtProjectDecls (secondOf resolved))
  )

-- M40 · 容错版：未解洞也会让严格收尾失败，但 hover 仍要显示目标与上下文（M40 起改用这个）。
export dtGoalsSourceTolerant : PackageContext -> String -> String -> Eff hostRow (Check (List DtGoalInfo))
dtGoalsSourceTolerant ctx label source = do
  projectR <- loadModuleSource ctx label source
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => case resolveProjectWith (contextRelease ctx) project of
      ErrC e => ErrC e
      OkC resolved => goalsOfProgramTolerant (dtProjectDecls (secondOf resolved))
  )

-- M30 · `vuna test`：main 的返回类别，决定执行路径。
--   "Eff"    —— 效果程序，走 compile + 运行（退出码判定）；
--   "String" —— 纯测试，空串通过；
--   "Int"    —— 0 通过；
--   "Bool"   —— True 通过；
--   "Other"  —— 明确拒绝（不是静默当失败）。
export dtMainKind : PackageContext -> String -> Eff hostRow (Check String)
dtMainKind ctx entry = do
  declsR <- dtLoad ctx entry
  pure (case declsR of
    ErrC e => ErrC e
    OkC loaded => case elabProgram (firstOf loaded) of
      ErrC e => ErrC e
      OkC p => case findMainDef (secondOf p) of
        Nothing => cgErr0At (Span entry 1 1 1 1) NoMain
        Just mainDef => if mainActionKind (dtDefType mainDef) == "Eff" then OkC "Eff"
        else case force (Base.HashMap.fromList (defTableOf (secondOf p))) solsEmpty defaultFuel (eval [] (dtDefType mainDef)) of
          VNeutral n => case n of
            NGlobal g sp => case sp of
              [] => mainKindForName g
              _ => OkC "Other"
            _ => OkC "Other"
          _ => OkC "Other"
  )

mainKindForName : String -> Check String
mainKindForName g =
  if g == intTypeName then OkC "Int"
  else if g == natTypeName then OkC "Nat"
  else if g == strTypeName then OkC "String" else if g == boolTypeName then OkC "Bool" else OkC "Other"

-- 合成定义的唯一名字：只在 `dtEvalExpr` 内部出现，摘除时按名字识别。
replExprName : String
replExprName = "vuna_repl_expr"

-- 取出合成定义并还原成表达式；它一定是加载后的最后一条声明（追加在源码末尾）。
splitReplExpr : List Decl -> Check (Pair (List Decl) Expr)
splitReplExpr decls = case reverse decls of
  (DFun n pats body sp) :: rest =>
    if n == replExprName then OkC (Pair (reverse rest) body)
    else icInternal "REPL expression definition is not last"
  _ => icInternal "REPL expression was not parsed as a definition"

-- B44：核心求值器支持浮点（`Float` 原语按 IEEE-754 double 归约，见 `Core/Eval`），
-- interp 不再需要「程序用到浮点就拒绝」的 guard。
evalDtMain : DtProgram -> Check String
evalDtMain program = evalDtMainCore program

-- 核心求值器对 `main` 的求值边界（M23 终态契约，B44 起含 Float）：
--   - 纯 `main : Int/Nat/String/Bool/Float`：核心求值并展示值（Float 用
--     `string_of_float` 规范文本，与产物一致）；
--   - `main : Eff [] a`：**一律报错**。核心求值器是纯的、不执行效果；即使动作结果不依赖
--     效果（`do @vuna@prim_eff_print "hi"; pure 7`），效果也会被静默丢弃——误导用户。所以不做
--     「尝试归约、卡住才报错」这种不可靠的判定。效果程序只走 compile + 运行
--     （夹具用 `.nointerp` 标记）。动作 main 的识别按精化后类型的动作层（`mainActionKind`）。
-- | 核心求值器对 `main` 的求值边界：纯 Int/String/Bool/Nat/Float 归约并展示，动作 main 一律报错。
evalDtMainCore : DtProgram -> Check String
evalDtMainCore program = case findMainDef (dtProgDefs program) of
  Nothing => cgErr0 NoMain
  Just mainDef =>
    let
      table = defTableOf (dtProgDefs program)
      sols = solsPutDefVals solsEmpty program.dtProgDefVals
      mainVal =
        normalize (Base.HashMap.fromList table) sols defaultFuel (VNeutral (NGlobal "main" []))
    in if not (mainActionKind (dtDefType mainDef) == "") then cgErr0 InterpCannotExecuteEffects
    else case mainVal of
      VInt n => OkC (strFromInt n)
      VStr s => OkC (showValue mainVal)
      VBool b => OkC (showValue mainVal)
      VFloat raw => OkC raw
      VCon c args => case natValueToInt mainVal of
        Just n => OkC (strFromInt n)
        Nothing => interpMainShow table sols mainVal
      _ => interpMainShow table sols mainVal

-- D17：非内建 main 类型的展示。Elab 收尾已合成 `@vuna@main_show : T -> String`
-- （`Elab.Driver.synthMainShow`），这里对 main 值应用它并打印结果字符串；与编译产物的
-- main 钩子走同一展示（Show 字典投影）。
interpMainShow : List (Pair String Term) -> Sols -> Value -> Check String
interpMainShow table sols mainVal = case normalize (Base.HashMap.fromList table) sols defaultFuel (VNeutral (NGlobal mainShowDefName [mainVal])) of
  -- 与非内建 main 的编译路径一致：main 钩子直接 `print_endline (show T x)`（不加引号），
  -- 所以 interp 也返回 raw 文本（内建 String main 仍走 dt_show_string 的加引号形态）。
  VStr s => OkC s
  _ => cgErr0 MainNotValue

-- main 的动作层类别："Eff"（行已处理干净的 Eff 入口）/ ""（纯 main）。
mainActionKind : Term -> String
mainActionKind (TApp (TApp fn row _) _ _) = case fn of
  TGlobal g => if g == effTypeName then "Eff" else ""
  _ => ""
mainActionKind _ = ""

-- | `Base.Eff.Row.Nil` 的语法形态（与 Elab/codegen 同形）。
isNilRowTermDt : Term -> Bool
isNilRowTermDt (TGlobal g) = g == effRowNilCtor
isNilRowTermDt (TCon g []) = g == effRowNilCtor
isNilRowTermDt _ = False

findMainDef : List DtDef -> Maybe DtDef
findMainDef [] = Nothing
findMainDef (d :: rest) = if dtDefName d == "main" then Just d else findMainDef rest

-- 有体定义（名字 → 体）：axiom 无体，不进核心求值器的 delta 表。
defTableOf : List DtDef -> List (Pair String Term)
defTableOf [] = []
defTableOf (d :: rest) = case dtDefBody d of
  Just body => Pair (dtDefName d) body :: defTableOf rest
  Nothing => defTableOf rest

-- M26：唯一 codegen 入口 = 逐模块 split（`compile` / `build` / seed rotation 共用）。
-- 与单文件路径共用同一次精化，生成器把 datas/defs 按声明归属切到各模块文件；
-- 模块列表按依赖序（Loader 的 modules 是依赖者在前的反序，这里 reverse）。
-- M34.5 接口摘要：加载 + resolve 项目并保留模块归属（本包 decls 过滤用）。
dtLoadParts : PackageContext -> String -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module))))
dtLoadParts ctx entry = dtLoadPartsForCheck ctx entry

-- 只精化本包 decls（依赖 artifact 从接口合并）；调用方保证接口已校验。
-- 依赖摘要携带的全部 artifact 名字：摘要路径下这些名字由依赖包提供，不属于本包接口，
-- 写本包 iface 时不能要求「归属可推导 / 出现在本包模块里」。
cachedNamesOf : List CachedProgram -> List String
cachedNamesOf progs = concatMap cachedNamesOne progs

cachedNamesOne : CachedProgram -> List String
cachedNamesOne cp =
  append (map dtDataName (cachedDatas cp))
    (append (concatMap (\d => map dtCtorName (dtDataCtors d)) (cachedDatas cp)) (append (map dtDefName (cachedDefs cp)) (append (map firstOf (cachedGlobals cp)) (append (map dtInstName (cachedInsts cp)) (map dtClassName (cachedClasses cp))))))

dtCheckOursParts : PackageContext -> Pair (List Diagnostic) (Pair (List Decl) (List Module)) -> List CachedProgram -> Check (Pair (List Diagnostic) CheckedPackage)
dtCheckOursParts ctx resolved deps =
  let
    parts = secondOf resolved
    loaderWarns = firstOf resolved
    pkgName = contextPackageName ctx
    modules = reverse (secondOf parts)
    ours = filter (\m => modulePackageOf m == pkgName) modules
    depsOnly = filter (\m => modulePackageOf m /= pkgName) modules
    -- 本包声明：本包模块 + 入口声明；依赖模块只作为终止性分析上下文（不精化）。
    decls = append (concatMap sealModule ours) (firstOf parts)
    termAux = concatMap moduleDeclsOf depsOnly
    start = depStartOf deps
  in Vuna.Compiler.Common.bind (elabProgramFullWithAux (firstOf start) (secondOf start) termAux decls) (\prog => let
    -- codegen 的 check（擦除/名字/构造子护栏）需要依赖包的 datas（构造子与标签信息）；
    -- 只生成本包 defs（依赖包 body 不重精化、不重新生成）。
    allDatas = append (concatMap cachedDatas deps) (dtProgDatas prog)
  in Vuna.Compiler.Common.bind (checkDtProgramOf allDatas (dtProgDefs prog)) (\_ => let
    warns = append loaderWarns (dtProgWarnings prog)
  in OkC (Pair warns (CheckedPackage prog (secondOf parts) (firstOf parts) (cachedNamesOf deps) warns))
  )
  )

-- 依赖接口 → 精化起始状态。
-- **硬不变量**：deftbl 只能装定义体（body）。签名项（尤其 `Int ↦ Type` 这类内建类型
-- global）一旦进 deftbl，`force` 的 delta 展开就会把 primitive 类型归约成 `Type`
-- （`Eq String` 的类参数变成 `Type`，所有实例头同归约 ⇒ 假歧义，C37 的
-- `TC_AmbiguousInstance (Eq Type)` 即此）。
depStartOfAt : Int -> List CachedProgram -> Pair Ec (List (Pair String Term))
depStartOfAt next progs =
  let
    datas = dedupDatas (concatMap cachedDatas progs)
    dataKeys =
      append (map dtDataName datas) (concatMap (\d => map dtCtorName (dtDataCtors d)) datas)
    defGlobals =
      filter (\p => memName (firstOf p) dataKeys == False)
        (dedupGlobals (append preludeGlobals (concatMap cachedGlobals progs)))
    globals = append defGlobals (map (\d => Pair (dtDataName d) (dtDataKind d)) datas)
    opaqueNames = map opaqueBaseName (concatMap cachedOpaqueOf progs)
    bodies =
      filter (\p => not (memName (firstOf p) opaqueNames))
        (dedupDefBodies (concatMap cachedDefs progs))
    ec0 = ecEmpty
    ec1 = addDatasEc ec0 datas
    ec2 = addInstsEc ec1 (dedupInsts (concatMap cachedInsts progs))
    ec3 = addClassesEc ec2 (dedupClasses (concatMap cachedClasses progs))
    ec4 = ecPutNext ec3 next
    ec5 = ecPutGlobalsTbl ec4 (Base.HashMap.fromList globals)
    ec6 = ecPutDefTbl ec5 (Base.HashMap.fromList bodies)
  in Pair ec6 globals

depStartOf : List CachedProgram -> Pair Ec (List (Pair String Term))
depStartOf progs = depStartOfAt 0 progs

-- M34.5（S4）：干净模块的残 meta 不重编号（保持接口哈希稳定），新精化从它们之上编号。
maxMetaList : Int -> List Int -> Int
maxMetaList m [] = m
maxMetaList m (x :: rest) = maxMetaList (if x > m then x else m) rest

maxMetaDef : Int -> DtDef -> Int
maxMetaDef m d = case dtDefBody d of
  Just body => maxMetaList m (termMetasAll body)
  Nothing => m

maxMetaCached : Int -> CachedProgram -> Int
maxMetaCached m cp = foldl maxMetaDef m (cachedDefs cp)

maxMetaCps : List CachedProgram -> Int
maxMetaCps cps = foldl maxMetaCached (0 - 1) cps

cleanStartNext : List CachedProgram -> Int
cleanStartNext cps =
  let
    m = maxMetaCps cps
  in if m < 0 then 0 else m + 1

-- 名字去重（后出现者胜、保序）：旧实现对每个元素重建 `map key rest` 再线性扫，
-- 整表 O(n²)（增量 check/build 收尾的 globals 表可达上万项；实测 16k 项 17.6s）。
-- 这里从右往左一次走完，用 `HashMap String Bool` 记已见名 ⇒ O(n)。
-- 语义与原实现逐项一致：同名只保留**最后一次**出现，其余元素相对顺序不变。
dedupKeepLast : (a -> String) -> List a -> List a
dedupKeepLast key xs = dedupKeepLastGo key (reverse xs) (Base.HashMap.fromList []) []

dedupKeepLastGo : (a -> String) -> List a -> HashMap String Bool -> List a -> List a
dedupKeepLastGo key [] seen acc = acc
dedupKeepLastGo key (x :: rest) seen acc =
  let
    k = key x
  in if Base.HashMap.member k seen then dedupKeepLastGo key rest seen acc
  else dedupKeepLastGo key rest (Base.HashMap.insert k True seen) (x :: acc)

-- 定义体表（delta 展开的唯一来源）：只取有体的 `DtDef`（axiom / extern 跳过）；
-- 依赖包之间的共享声明按名字去重（后出现者胜，与 datas/insts/classes 一致）。
dedupDefBodies : List DtDef -> List (Pair String Term)
dedupDefBodies ds = bodyPairs (dedupDefs ds)

dedupDefs : List DtDef -> List DtDef
dedupDefs ds = dedupKeepLast dtDefName ds

bodyPairs : List DtDef -> List (Pair String Term)
bodyPairs [] = []
bodyPairs (d :: rest) = case dtDefBody d of
  Just body => Pair (dtDefName d) body :: bodyPairs rest
  Nothing => bodyPairs rest

dedupDatas : List DtData -> List DtData
dedupDatas ds = dedupKeepLast dtDataName ds

dedupInsts : List DtInst -> List DtInst
dedupInsts ds = dedupKeepLast dtInstName ds

dedupClasses : List DtClass -> List DtClass
dedupClasses ds = dedupKeepLast dtClassName ds

dedupGlobals : List (Pair String Term) -> List (Pair String Term)
dedupGlobals gs = dedupKeepLast (\g => firstOf g) gs

-- ---------------------------------------------------------------
-- M34.5（S2）：依赖接口加载（TTC 的 module 复用）
-- ---------------------------------------------------------------
-- 依赖模块来自接口文件：`Module` 用接口里存的已解析 decls 构造，Loader 直接命中、不读
-- 源码；起始 Ec 由模块摘要合并（`depStartOf`）。模块表顺序 = reverse(topo)，与 `loadAll`
-- 的「新加载者前插」约定一致，这样 `dtProjectDecls` 的 reverse 之后仍是依赖在前。
-- 依赖模块摘要合并：每个模块分配独立元变量段。摘要允许保留**擦除位置**的未解 meta
-- （精化器不要求有解），而根包精化从 0 开始编号；不分配段会让依赖 meta 与根包 meta
-- 编号相撞（同号被当成同一个元变量）。
--
-- **段号只由模块名排序后的名次决定**（C37 A②）：旧实现用 iface 列表位置 `idx+1`，
-- 而该列表 = 依赖包 DFS 序 + 每包 manifest 模块序 ⇒ 换模块顺序会改变段号（并让 payload
-- 字节抖动）。现在按 `miNameOf` 排序后取名的名次，列表顺序变化不再影响任何编号。
-- 段号下界 = `summaryMetaSegment`（2^30）> 本包一次运行的 fresh 编号上界；因此 dep meta
-- 既不会与 fresh/clean 撞号，也不在 `unsolvedFrom 0 (ecNext)` 的扫描范围内（不会被当成本包
-- 未解洞报错）。移位失败（项深超 codegen guard）⇒ 内部错误，不静默用未移位的项。
shiftedDepPrograms : List ModuleIface -> Check (List CachedProgram)
shiftedDepPrograms ifaces =
  let
    names = dedupSortedNames (sortNames (map miNameOf ifaces))
  in if length names /= length ifaces then icInternal "iface: duplicate dependency module name"
  else shiftedDepProgramsGo (nameSlotTbl names 0) ifaces

-- 模块名排序（插入排序；依赖模块数 ~几十，与哈希表相比更省常数）。
sortNames : List String -> List String
sortNames [] = []
sortNames (x :: rest) = insertName x (sortNames rest)

insertName : String -> List String -> List String
insertName x [] = [x]
insertName x (y :: rest) =
  if x <= y then Base.List.Cons x (Base.List.Cons y rest) else Base.List.Cons y (insertName x rest)

-- 排序后去重（重名意味着两个模块抢同一个段 ⇒ 静默撞号，调用方按内部错误拒绝）。
-- 累加器版本：只在结构子项（列表尾）上递归，SCT 可证终止；比较「最后保留的那个名字」。
dedupSortedNames : List String -> List String
dedupSortedNames xs = reverse (dedupSortedGo xs [])

dedupSortedGo : List String -> List String -> List String
dedupSortedGo [] acc = acc
dedupSortedGo (x :: rest) acc = case acc of
  [] => dedupSortedGo rest (Base.List.Cons x acc)
  y :: _ => if x == y then dedupSortedGo rest acc else dedupSortedGo rest (Base.List.Cons x acc)

nameSlotTbl : List String -> Int -> List (Pair String Int)
nameSlotTbl [] _ = []
nameSlotTbl (x :: rest) i = Base.List.Cons (Pair x i) (nameSlotTbl rest (i + 1))

shiftedDepProgramsGo : List (Pair String Int) -> List ModuleIface -> Check (List CachedProgram)
shiftedDepProgramsGo _ [] = OkC []
shiftedDepProgramsGo tbl (m :: rest) = case lookupPair (miNameOf m) tbl of
  Nothing => icInternal "iface: dependency module missing from shift table: ${miNameOf m}"
  Just slot =>
    Vuna.Compiler.Common.bind (shiftCachedProgram ((slot + 1) * summaryMetaSegment) (miCachedOf m))
      (\cp => Vuna.Compiler.Common.bind (shiftedDepProgramsGo tbl rest) (\rest2 => OkC (Base.List.Cons cp rest2)))

modulesOfIfaces : List ModuleIface -> List Module
modulesOfIfaces ifaces = reverse (map moduleOfIface ifaces)

-- ---------------------------------------------------------------
-- M34.5（S4）：包内逐模块增量的加载/精化
--
-- 干净模块以「预置模块」进入 Loader（零 parse/resolve），闭合产物并入起始 Ec；只精化
-- 脏模块 + 入口声明；然后按同样顺序把干净产物合并回 DtProgram（codegen / 接口写仍看
-- 整包）。干净模块判定在 Compile（依赖源哈希 + miDepHashes 链，保守传播）。
-- ---------------------------------------------------------------
dtLoadPartsIncremental : PackageContext -> String -> List ModuleIface -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module))))
dtLoadPartsIncremental ctx entry depIfaces cleanIfaces =
  let
    preloaded = append (modulesOfIfaces depIfaces) (reverse (map moduleOfIface cleanIfaces))
    allIfaces = append depIfaces cleanIfaces
  in do
    projectR <- loadProjectWithPreloaded ctx entry preloaded
    pure (case projectR of
      ErrC e => ErrC e
      OkC project => case filterProjectToImports (contextPackageName ctx) project of
        Pair filtered mods =>
          resolveProjectKeeping (contextRelease ctx) (preloadKeepOf allIfaces mods) filtered
    )

-- M34.6（5b）：termAux 的 record 降级 / deriving 展开结果可跨请求复用。
--
-- `elabProgramFullWithAux` 每次都会对 termAux（依赖包 + 干净同包模块的**原始 decls**）
-- 重跑 `prepareDecls` + `expandDerivings`：工具链连续请求里 termAux 常常完全不变（只有
-- 当前模块在变），这一步在根包 / REPL 重场景里是固定开销。这里把预处理结果做成显式的
-- 可复用参数（语义与 `elabProgramFullWithAux` 逐项相同：startEc/startGlobals 不变，
-- termAux 原始 decls 仍传给 `prepareDeclsWith`，prepared 版本只服务 record 头解消与
-- 终止性 SCT 上下文）。
export dtPrepareTermAux : List Decl -> Check (List Decl)
dtPrepareTermAux aux =
  Vuna.Compiler.Common.bind (prepareDecls aux) (\p => expandDerivings (secondOf p))

-- 终止性 SCT 的 termAux 裁剪（5b 的关键）：依赖包 / 干净模块的终止性已在写它们自己的
-- 接口时验过，本路径只报告当前模块函数的失败。import 图无环 ⇒ 调用图无跨模块环 ⇒
-- 「含本模块函数的 SCC」只含本模块声明；因此 aux 的函数体对当前 SCC 的 size-change
-- 判定没有贡献，SCT 只需要 aux 的**构造子**（data / record 头）与**投影**（单子句选择子）。
-- 裁掉其余 aux 函数后 call-graph / 正事实不动点从 O(整包函数) 降到 O(投影)，判据等价。
dtAuxForTermination : List Decl -> List Decl
dtAuxForTermination [] = []
dtAuxForTermination (d :: rest) = case d of
  DFun n pats body sp => case projectionOfDef (Pair n [Pair pats body]) of
    Just _ => d :: dtAuxForTermination rest
    Nothing => dtAuxForTermination rest
  _ => d :: dtAuxForTermination rest

dtElabFullWithPrepared : Ec -> List (Pair String Term) -> List Decl -> List Decl -> List Decl -> Check DtProgram
-- 与全量路径（`Elab.Driver.elabProgramFullWithAux`）对齐：记录字段的 `HasField`
-- 自动实例也必须在增量路径上生成，否则 `getField` 在 LSP / 测试会话里会假报
-- `TC_NoInstanceFound`（夹具 18/records_files/10_has_field 就是这条用例）。
dtElabFullWithPrepared startEc startGlobals termAux preparedAux decls = Vuna.Compiler.Common.bind (prepareDeclsWith termAux (maybeAddHasFieldInstances startGlobals decls)) (\p => case p of
  Pair records ds =>
    Vuna.Compiler.Common.bind (expandDerivings ds)
      (\ds2 => elabProgramGoWithAux startEc startGlobals records (dtAuxForTermination preparedAux) ds2)
)

-- 工具链增量会话缓存（M34.6 5a/5b）：一次请求的**固定开销**按 iface 集合缓存。
--   - decls：termAux（依赖包 + 干净同包模块 decls）的 record / deriving 预处理结果；
--   - start：依赖 / 干净模块产物构造的起始 Ec + globals（`depStartOfAt` + shift 很贵）；
--   - depCps / cleanCps：shift 后的闭合产物（组装与收窄范围检查复用）。
-- key = 包名 + 参与模块名 + 接口哈希；iface 集合一变即失配（保守但正确）。
export record AuxCache where
  auxCacheKey : String
  auxCacheDecls : List Decl
  auxCacheStart : Pair Ec (List (Pair String Term))
  auxCacheDepCps : List CachedProgram
  auxCacheCleanCps : List CachedProgram

auxKeyOne : ModuleIface -> String
auxKeyOne m = "${miNameOf m}:${miIfaceHashOf m}"

export dtAuxKey : String -> List ModuleIface -> List ModuleIface -> String
dtAuxKey pkg deps clean =
  strFromInt
    (hashTextStrong "aux|${pkg}|${join ";" (map auxKeyOne deps)}|${join ";" (map auxKeyOne clean)}")

dtAuxOfCache : String -> Maybe AuxCache -> Maybe AuxCache
dtAuxOfCache key Nothing = Nothing
dtAuxOfCache key (Just c) = if c.auxCacheKey == key then Just c else Nothing

dtIncrementalChecked : PackageContext -> Pair (List Diagnostic) (Pair (List Decl) (List Module)) -> List ModuleIface -> List ModuleIface -> Check CheckedPackage
dtIncrementalChecked ctx resolved depIfaces cleanIfaces = Vuna.Compiler.Common.bind (dtIncrementalCheckedCore ctx resolved depIfaces cleanIfaces Nothing True) (\r => case firstOf (secondOf r) of
  Just checked => OkC checked
  Nothing => icInternal "incremental check produced no package"
)

-- 增量精化核心：`needPackage` = 是否需要组装整包 DtProgram（写接口 / codegen 用）。
-- 工具链诊断只要「当前文件能不能过检查」，此时跳过整包组装与全量 codegen 检查
-- （依赖 / 干净模块的产物在写各自接口时已经验过），只对本次新精化的 datas/defs 跑同一条
-- 检查链 —— 诊断语义与全量路径一致（错误都落在本次精化的文件上）。
dtIncrementalCheckedCore : PackageContext -> Pair (List Diagnostic) (Pair (List Decl) (List Module)) -> List ModuleIface -> List ModuleIface -> Maybe AuxCache -> Bool -> Check (Pair (List Diagnostic) (Pair (Maybe CheckedPackage) (Maybe AuxCache)))
dtIncrementalCheckedCore ctx resolved depIfaces cleanIfaces cache needPackage =
  let
    parts = secondOf resolved
    loaderWarns = firstOf resolved
    pkgName = contextPackageName ctx
    modules = reverse (secondOf parts)
    ours = filter (\m => modulePackageOf m == pkgName) modules
    depsOnly = filter (\m => modulePackageOf m /= pkgName) modules
    cleanNames = moduleNamesOf cleanIfaces
    dirtyOurs = filter (\m => memName (moduleNameOf m) cleanNames == False) ours
    decls = append (concatMap sealModule dirtyOurs) (firstOf parts)
    termAux = append (concatMap moduleDeclsOf depsOnly) (concatMap miDeclsOf cleanIfaces)
    key = dtAuxKey pkgName depIfaces cleanIfaces
    cacheable = length depIfaces + length cleanIfaces > 0
    hit = if cacheable then dtAuxOfCache key cache else Nothing
    -- dep 产物要移位：失败（项深超 codegen guard）⇒ 内部错误，不静默使用未移位项。
    depCpsR = case hit of
      Just c => OkC c.auxCacheDepCps
      Nothing => shiftedDepPrograms depIfaces
    -- termAux 的 prepared 形态优先取接口里持久化的版本（每个模块自己一份，写侧算好）：
    -- 「编辑一个模块」只让该模块脏，其余干净模块的 prepared 仍有效 ⇒ 不必对整表重跑
    -- record 降级 / deriving 展开（这是编辑后重建的主要成本）。任一参与模块缺
    -- prepared（旧 schema / LSP 单模块写回）就整体回退 `dtPrepareTermAux`。
    ifacePrepared = concatMap miPreparedOf (append depIfaces cleanIfaces)
    missingPrepared = filter (\mi => length (miPreparedOf mi) == 0) (append depIfaces cleanIfaces)
  in Vuna.Compiler.Common.bind depCpsR (\depCps => let
    cleanCps = case hit of
      Just c => c.auxCacheCleanCps
      Nothing => map miCachedOf cleanIfaces
    start = case hit of
      Just c => c.auxCacheStart
      Nothing => depStartOfAt (cleanStartNext cleanCps) (append depCps cleanCps)
    prepared = case hit of
      Just c => OkC c.auxCacheDecls
      Nothing =>
        if length ifacePrepared > 0 && length missingPrepared == 0 then OkC ifacePrepared
        else dtPrepareTermAux termAux
    startGlobals = secondOf start
    startEc = firstOf start
  in Vuna.Compiler.Common.bind prepared (\preparedAux => let
    next = if cacheable then Just (AuxCache key preparedAux start depCps cleanCps) else Nothing
  in Vuna.Compiler.Common.bind (dtElabFullWithPrepared startEc startGlobals termAux preparedAux decls) (\prog => let
    warns = append loaderWarns (dtProgWarnings prog)
  in Vuna.Compiler.Common.bind
    (if needPackage then dtFinishPackageScoped loaderWarns depCps cleanCps prog parts next else dtFinishScoped depCps cleanCps prog next)
    (\r => OkC (Pair warns r))
  )
  )
  )

-- 需要整包产物（写接口 / build）：组装 DtProgram + 整包 codegen 检查（与旧行为一致）。
dtFinishPackage : List Diagnostic -> List CachedProgram -> List CachedProgram -> DtProgram -> Pair (List Decl) (List Module) -> Maybe AuxCache -> Check (Pair (Maybe CheckedPackage) (Maybe AuxCache))
dtFinishPackage loaderWarns depCps cleanCps prog parts next =
  let
    assembled =
      DtProgram
        (append (concatMap cachedDatas depCps) (append (concatMap cachedDatas cleanCps) (dtProgDatas prog)))
        (append (concatMap cachedDefs depCps) (append (concatMap cachedDefs cleanCps) (dtProgDefs prog)))
        (dtProgGoals prog) (dtProgSols prog)
        (dedupGlobals (append (concatMap cachedGlobals cleanCps) (dtProgGlobals prog)))
        (dtProgInsts prog) (dtProgClasses prog) prog.dtProgNext prog.dtProgDefVals prog.dtProgDepths
        (dtProgWarnings prog)
    warns = append loaderWarns (dtProgWarnings prog)
    checked = CheckedPackage assembled (secondOf parts) (firstOf parts) (cachedNamesOf depCps) warns
  in Vuna.Compiler.Common.bind (checkDtProgramOf (dtProgDatas assembled) (dtProgDefs assembled))
    (\_ => OkC (Pair (Just checked) next))

-- 增量路径的整包组装：产物照常组装（写 iface 需要 per-module 的 cp/parts），但
-- codegen 检查只跑**本次新精化**的 datas/defs（`dtCheckScoped`）——干净模块在它们
-- 自己的接口写回时就跑过整包检查，依赖包同理。整包 `checkDtProgramOf` 会把这 65 个
-- 模块再检查一遍（编辑一个模块后 1.4s 里的大头），对增量路径是纯重复。
dtFinishPackageScoped : List Diagnostic -> List CachedProgram -> List CachedProgram -> DtProgram -> Pair (List Decl) (List Module) -> Maybe AuxCache -> Check (Pair (Maybe CheckedPackage) (Maybe AuxCache))
dtFinishPackageScoped loaderWarns depCps cleanCps prog parts next =
  let
    assembled =
      DtProgram
        (append (concatMap cachedDatas depCps) (append (concatMap cachedDatas cleanCps) (dtProgDatas prog)))
        (append (concatMap cachedDefs depCps) (append (concatMap cachedDefs cleanCps) (dtProgDefs prog)))
        (dtProgGoals prog) (dtProgSols prog)
        (dedupGlobals (append (concatMap cachedGlobals cleanCps) (dtProgGlobals prog)))
        (dtProgInsts prog) (dtProgClasses prog) prog.dtProgNext prog.dtProgDefVals prog.dtProgDepths
        (dtProgWarnings prog)
    warns = append loaderWarns (dtProgWarnings prog)
    checked = CheckedPackage assembled (secondOf parts) (firstOf parts) (cachedNamesOf depCps) warns
    allDatas =
      append (concatMap cachedDatas depCps)
        (append (concatMap cachedDatas cleanCps) (dtProgDatas prog))
  in Vuna.Compiler.Common.bind (dtCheckScoped allDatas (dtProgDatas prog) (dtProgDefs prog))
    (\_ => OkC (Pair (Just checked) next))

-- 工具链诊断：只对本次新精化的 datas/defs 跑检查链（组装省掉），返回无 CheckedPackage。
dtFinishScoped : List CachedProgram -> List CachedProgram -> DtProgram -> Maybe AuxCache -> Check (Pair (Maybe CheckedPackage) (Maybe AuxCache))
dtFinishScoped depCps cleanCps prog cache =
  let
    allDatas =
      append (concatMap cachedDatas depCps)
        (append (concatMap cachedDatas cleanCps) (dtProgDatas prog))
    newDatas = dtProgDatas prog
    newDefs = dtProgDefs prog
  in Vuna.Compiler.Common.bind (dtCheckScoped allDatas newDatas newDefs)
    (\_ => OkC (Pair Nothing cache))

-- `codegen` 检查的收窄版：`allDatas` 是渲染/构造子表的完整视图（依赖 + 干净 + 本次），
-- `unitDatas` 只生成本次精化模块的类型声明；检查链（名字护栏 / 擦除 / SCC / 生成）只跑
-- `defs`。每个 def 的检查只看自身项与全部数据族，因此对本文件的诊断语义与整包检查一致。
dtCheckScoped : List DtData -> List DtData -> List DtDef -> Check Int
dtCheckScoped allDatas unitDatas defs =
  let
    env = mkLwEnv allDatas defs ""
  in Vuna.Compiler.Common.bind (lowerUnitOf env (map dtDefName defs) (map dtDataName unitDatas))
    (\unitIr => Vuna.Compiler.Common.bind (genUnitParts noQual (lwEnvShared env) unitIr) (\_ => OkC 0))

-- M34.6（5a）：单文件（LSP buffer / REPL 所在模块）的增量精化。
--   1. 依赖包模块与**干净的同包模块**以「预置模块」进 Loader（零 parse/resolve）；
--   2. 由它们的 iface 产物构造起始 Ec（依赖包按段 shift 元变量、干净模块保持编号），
--      只精化当前模块（+ 安全阀兜底：闭包外依赖缺 artifact 就返回 Nothing 让调用方全量）；
--   3. termAux 预处理 / 起始 Ec / 已 shift 产物都可经 `cache` 复用（5b）；`needPackage` =
--      调用方是否需要整包 CheckedPackage（只做诊断时跳过整包组装 + 整包 codegen 检查）。
-- 返回 `Nothing` 表示「本路径不适用」（调用方回退全量，诊断必须仍正确）。
export dtCheckSourceIncremental : PackageContext -> String -> String -> List ModuleIface -> List ModuleIface -> Maybe AuxCache -> Bool -> Eff hostRow (Check (Pair Bool (Pair (List Diagnostic) (Pair (Maybe CheckedPackage) (Maybe AuxCache)))))
dtCheckSourceIncremental ctx label source depIfaces cleanIfaces cache needPackage =
  let
    pkgName = contextPackageName ctx
    preloaded = append (modulesOfIfaces depIfaces) (reverse (map moduleOfIface cleanIfaces))
    allIfaces = append depIfaces cleanIfaces
  in do
    projectR <- loadModuleSourceWithPreloaded ctx label source preloaded
    pure (case projectR of
      ErrC e => ErrC e
      OkC project => case filterProjectToImports pkgName project of
        Pair filtered mods =>
          let
            missing = missingDepModules pkgName mods (map miNameOf allIfaces)
            _ =
              if length missing > 0 then dbg! "iface-fallback=check-incremental missing=${join "," missing}"
              else 0
          in if length missing > 0 then OkC (Pair False (Pair [] (Pair Nothing cache)))
          else case resolveProjectKeeping (contextRelease ctx) (preloadKeepOf allIfaces mods) filtered of
            ErrC e => ErrC e
            OkC resolved => case dtIncrementalCheckedCore ctx resolved (materializedDeps pkgName (secondOf resolved) depIfaces) (materializedOwn pkgName (secondOf resolved) cleanIfaces) cache needPackage of
              ErrC e => ErrC e
              OkC r => OkC (Pair True r)
    )

-- M44：会话化 interp。与 `dtCheckSourceIncremental` 同一条增量路径（依赖包 / 干净
-- 同包模块以接口预置，只精化当前入口），但需要整包组装后的 `CheckedPackage`——依赖
-- 模块的 defs 要在场，`evalDtMain` 才能归约跨模块调用（`needPackage = True`）。
-- 第一分量沿用后者的语义：False = 本路径不适用（调用方回退全量）。
export dtEvalSourceIncremental : PackageContext -> String -> String -> List ModuleIface -> Maybe AuxCache -> Eff hostRow (Check (Pair Bool (Pair String (Maybe AuxCache))))
dtEvalSourceIncremental ctx label source depIfaces cache = do
  rR <- dtCheckSourceIncremental ctx label source depIfaces [] cache True
  pure (case rR of
    ErrC e => ErrC e
    OkC r => case secondOf r of
      Pair warns rest => case firstOf rest of
        Just checked => case evalDtMain checked.checkedProgram of
          ErrC e => ErrC e
          OkC out => OkC (Pair (firstOf r) (Pair out (secondOf rest)))
        Nothing => OkC (Pair (firstOf r) (Pair "" (secondOf rest)))
  )

-- 全量 checked（无 iface / 安全阀回退时用）：与 `dtCheckSource` 同一条加载/精化路径，
-- 但保留 CheckedPackage（LSP 冷启动写回单模块接口用）。
export dtCheckSourceChecked : PackageContext -> String -> String -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckSourceChecked ctx label source = do
  projectR <- loadModuleSource ctx label source
  case projectR of
    ErrC e => pure (ErrC e)
    OkC project =>
      dtCheckPartsWithProgram (contextPackageName ctx)
        (pure (resolveProjectWith (contextRelease ctx) project))

export dtCheckPackageIncrementalParts : PackageContext -> String -> List ModuleIface -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckPackageIncrementalParts ctx entry depIfaces cleanIfaces = do
  partsR <- dtLoadPartsIncremental ctx entry depIfaces cleanIfaces
  pure (case partsR of
    ErrC e => ErrC e
    OkC resolved => case dtIncrementalChecked ctx resolved (materializedDeps (contextPackageName ctx) (secondOf resolved) depIfaces) (materializedOwn (contextPackageName ctx) (secondOf resolved) cleanIfaces) of
      ErrC e => ErrC e
      OkC checked => OkC (Pair checked.checkedWarnings checked)
  )

-- codegen 的 split 层要求模块列表按依赖序（外部依赖在前）。增量路径的 loader 列表是
-- 「新加载者前插 + 预置模块在尾」，直接 reverse 会把干净模块排在它们依赖的外部模块
-- 之前；这里显式做一次 DFS 拓扑排序（只依赖 import 名，跨包/同包一视同仁）。
findModuleNameField : Import -> String
findModuleNameField i = i.importName

findModuleNamed : List Module -> String -> Maybe Module
findModuleNamed [] _ = Nothing
findModuleNamed (m :: rest) name =
  if moduleNameOf m == name then Just m else findModuleNamed rest name

topoDepsOf : List Module -> Module -> List String
topoDepsOf mods m = filter (\n => case findModuleNamed mods n of
  Just _ => True
  Nothing => False
) (map findModuleNameField (append m.moduleImportsOf m.moduleImplicitImportsOf))

-- fuel 守卫：模块图是有向无环的，但 SCT 不能从「visited 集合」证明互递归下降。
topoVisit : Int -> List Module -> String -> List String -> List Module -> Pair (List String) (List Module)
topoVisit fuel mods name visited acc = if fuel <= 0 then Pair visited acc
else if memName name visited then Pair visited acc
else case findModuleNamed mods name of
  Nothing => Pair (Base.List.Cons name visited) acc
  Just m =>
    let
      step = topoVisitAll (fuel - 1) mods (topoDepsOf mods m) (name :: visited) acc
    in Pair (firstOf step) (append (secondOf step) [m])

topoVisitAll : Int -> List Module -> List String -> List String -> List Module -> Pair (List String) (List Module)
topoVisitAll fuel mods [] visited acc = Pair visited acc
topoVisitAll fuel mods (n :: rest) visited acc =
  let
    step = topoVisit fuel mods n visited acc
  in topoVisitAll fuel mods rest (firstOf step) (secondOf step)

topoModules : List Module -> List Module
topoModules mods = secondOf (topoVisitAll 8192 mods (map moduleNameOf mods) [] [])

-- M34.5（S5）：codegen 单元级缓存。单元 key = 单元名 + 模块声明内容哈希 + 传递依赖
-- 单元 key 的哈希链（与 build 系统同思路）：依赖接口变化沿链使依赖者失效，无关模块
-- 变化不影响。生成命中缓存时直接复用 `SplitFile`，不再重跑该单元 codegen。
-- M34.6：默认开启（见 `unitCacheEnabled`），桶内 GC 只保留本次 key 集合对应的文件。
-- | 模块声明的内容摘要：显式规范编码（span / 路径不参与 ⇒ 换行、移动代码不再让单元
-- 缓存失效），不再 `prim_marshal`（C32 哈希输入侧的完整形态）。
unitDeclsHash : Module -> String
unitDeclsHash m = encTop encDecls (moduleDeclsOf m)

pairKeyValue : Pair String String -> String
pairKeyValue p = secondOf p

unitImportsOf : Module -> List String
unitImportsOf m = map findModuleNameField (append m.moduleImportsOf m.moduleImplicitImportsOf)

concatKeys : List String -> String
concatKeys [] = ""
concatKeys (k :: rest) = "${k};${concatKeys rest}"

unitImportKey : List (Pair String String) -> String -> String
unitImportKey acc n = case lookupPair n acc of
  Just k => k
  Nothing => "?"

unitKeyOne : List (Pair String String) -> Module -> String
unitKeyOne acc m =
  let
    deps = map (unitImportKey acc) (unitImportsOf m)
  in shaText "u|${moduleNameOf m}|${unitDeclsHash m}|${concatKeys deps}"

unitKeysGo : List Module -> List (Pair String String) -> List (Pair String String)
unitKeysGo [] acc = reverse acc
unitKeysGo (m :: rest) acc = unitKeysGo rest (Pair (moduleNameOf m) (unitKeyOne acc m) :: acc)

unitKeysOf : List Module -> List Decl -> Bool -> List (Pair String String)
unitKeysOf modules entryDecls printResult =
  let
    modKeys = unitKeysGo modules []
    entryHash = encTop encDecls entryDecls
    entryKey =
      shaText
        "e|${entryHash}|${if printResult then "@vuna@prim_eff_print" else "noprint"}|${concatKeys (map pairKeyValue modKeys)}"
  in Pair "__entry__" entryKey :: modKeys

-- M4（效果显式化）：PerfCache 的磁盘层与生成器的 lookup/store 回调都是宿主动作，
-- 显式在 `Eff []` 里；单元 key / 文件名 / GC 保留集合保持纯计算。
unitCacheLookup : String -> List (Pair String String) -> String -> Eff hostRow (Maybe SplitFile)
unitCacheLookup dir keys name = case lookupPair name keys of
  Just k => do
    cached <- unitCacheRead dir name k
    pure (case cached of
      Just sf =>
        let
          _ = dbg! "unit-cache-hit ${name}"
        in Just sf
      Nothing => Nothing
    )
  Nothing => pure Nothing

unitCacheStore : String -> List (Pair String String) -> String -> SplitFile -> Eff hostRow Int
unitCacheStore dir keys name sf = case lookupPair name keys of
  Just k => unitCacheWrite dir name k sf
  Nothing => pure 0

-- M34.6：**默认开启**（`VUNA_UNIT_CACHE=0` opt-out）。同机 A/B（预热后改入口再
-- `build --no-compile .`，workspace 双入口大包，7 轮中位数）：单元缓存 4045ms vs 关闭
-- 4430ms（-8.7%，≥ 默认开启门槛 5%）；单包 root 场景同法 -10%。缓存语义安全：单元 key
-- 含模块声明 Marshal 哈希（span 里的源路径也在内）+ 传递依赖单元 key + printResult，
-- 文件头 tag 含 schema/版本/编译器二进制指纹；坏文件由 framing 拒绝重算。
unitCacheEnabled : Eff hostRow Bool
unitCacheEnabled = do
  v <- raiseToRow hostRow (@vuna@prim_eff_getenv "VUNA_UNIT_CACHE")
  pure (v /= "0")

splitGenerateCached : PackageContext -> String -> List Module -> List (Pair String (List Decl)) -> List Decl -> DtProgram -> Bool -> List (Pair String (Pair String Int)) -> Eff hostRow (Check (List SplitFile))
splitGenerateCached ctx entry modules moduleParts entryDecls prog printResult extraDefLocs =
  let
    pkg = contextPackageName ctx
    keys = unitKeysOf modules entryDecls printResult
    bucketKey = "${pkg}|${entry}"
    roots = map rootDir (contextRoots ctx)
    cdir = contextDir ctx
  in do
    enabled <- unitCacheEnabled
    base <- unitCacheDir pkg
    let
      dir = unitCacheEntryDir base bucketKey
      keepNames = map (\p => unitCacheFileName (firstOf p) (secondOf p)) keys
    in do
      _ <- if enabled && pkg /= "" then unitCacheBucketGc dir keepNames else pure 0
      if pkg == "" || not enabled then generateDtSplitProgram moduleParts entryDecls prog printResult roots cdir extraDefLocs
      else generateDtSplitProgramWith (unitCacheLookup dir keys) (unitCacheStore dir keys) moduleParts
        entryDecls prog printResult roots cdir extraDefLocs

dtGenerateIncremental : PackageContext -> String -> Pair (List Decl) (List Module) -> CheckedPackage -> Bool -> List (Pair String (Pair String Int)) -> Eff hostRow (Check (Pair (List SplitFile) CheckedPackage))
dtGenerateIncremental ctx entry parts checked printResult extraDefLocs =
  let
    modules = topoModules (secondOf parts)
    moduleParts = map (\m => Pair (moduleNameOf m) (moduleDeclsOf m)) modules
  in do
    filesR <-
      splitGenerateCached ctx entry modules moduleParts (firstOf parts) checked.checkedProgram
        printResult extraDefLocs
    pure (case filesR of
      ErrC e => ErrC e
      OkC files => OkC (Pair files checked)
    )

export dtSplitProjectIncremental : PackageContext -> String -> Bool -> List ModuleIface -> List ModuleIface -> Eff hostRow (Check (Pair (List SplitFile) CheckedPackage))
dtSplitProjectIncremental ctx entry printResult depIfaces cleanIfaces = do
  partsR <- dtLoadPartsIncremental ctx entry depIfaces cleanIfaces
  case partsR of
    ErrC e => pure (ErrC e)
    OkC resolved =>
      let
        pkgName = contextPackageName ctx
        parts = secondOf resolved
        cleanOwn = materializedOwn pkgName parts cleanIfaces
        -- 增量路径的干净模块 `DtDef` 来自接口载荷（span 不在载荷里），codegen 的位置表
        -- 用接口持久化的 `miDefLocs` 补行；全量路径的 defs 自带 span，补行表为空。
        extraDefLocs = concatMap miDefLocsOf cleanOwn
      in case dtIncrementalChecked ctx resolved (materializedDeps pkgName parts depIfaces) cleanOwn of
        ErrC e => pure (ErrC e)
        OkC checked => dtGenerateIncremental ctx entry parts checked printResult extraDefLocs

moduleOfIface : ModuleIface -> Module
moduleOfIface mi =
  Module (miNameOf mi) (miPackageOf mi) (miImportsOf mi) (miImplicitImportsOf mi) (miDeclsOf mi)
    (miExportsOf mi) (miFixitiesOf mi) [] (cachedOpaqueOf (miCachedOf mi))

-- ---------------------------------------------------------------
-- M34.5（S6）：依赖可见性收敛。全量路径只加载 entry/本包模块的 **import 闭包**；
-- 接口路径一次性预置整包模块，因此这里在 load 之后按闭包过滤模块表（entry imports +
-- 传递 import），让摘要路径与全量路径看到同一组模块/实例/类，消除过近似差异。
-- ---------------------------------------------------------------
importsOfModuleNames : Module -> List String
importsOfModuleNames m =
  map findModuleNameField (append m.moduleImportsOf m.moduleImplicitImportsOf)

closureGo : Int -> List Module -> List String -> List String -> List String
closureGo fuel mods visited [] = visited
closureGo fuel mods visited (n :: rest) = if fuel <= 0 then visited
else if memName n visited then closureGo fuel mods visited rest
else case findModuleNamed mods n of
  Nothing => closureGo (fuel - 1) mods (n :: visited) rest
  Just m => closureGo (fuel - 1) mods (n :: visited) (append rest (importsOfModuleNames m))

filterProjectToImports : String -> Project -> Pair Project (List Module)
filterProjectToImports pkg (Project ds imports implicit mods epkg fixes) =
  let
    entryStarts = map findModuleNameField (append imports implicit)
    ownNames = map moduleNameOf (filter (\m => modulePackageOf m == pkg) mods)
    starts = append entryStarts ownNames
    closed = closureGo 8192 mods [] starts
    kept = filter (\m => memName (moduleNameOf m) closed) mods
  in Pair (Project ds imports implicit kept epkg fixes) kept

preloadKeepOf : List ModuleIface -> List Module -> List String
preloadKeepOf ifaces mods =
  map miNameOf (filter (\mi => memName (miNameOf mi) (map moduleNameOf mods)) ifaces)

materializedDeps : String -> Pair (List Decl) (List Module) -> List ModuleIface -> List ModuleIface
materializedDeps pkg parts ifaces =
  let
    depNames = map moduleNameOf (filter (\m => modulePackageOf m /= pkg) (secondOf parts))
  in filter (\mi => memName (miNameOf mi) depNames) ifaces

materializedOwn : String -> Pair (List Decl) (List Module) -> List ModuleIface -> List ModuleIface
materializedOwn pkg parts ifaces =
  let
    ourNames = map moduleNameOf (filter (\m => modulePackageOf m == pkg) (secondOf parts))
  in filter (\mi => memName (miNameOf mi) ourNames) ifaces

dtLoadPartsWithIfaces : PackageContext -> String -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module))))
dtLoadPartsWithIfaces ctx entry ifaces = do
  projectR <- loadProjectWithPreloaded ctx entry (modulesOfIfaces ifaces)
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => case filterProjectToImports (contextPackageName ctx) project of
      Pair filtered mods =>
        resolveProjectKeeping (contextRelease ctx) (preloadKeepOf ifaces mods) filtered
  )

dtLoadModulesPartsWithIfaces : PackageContext -> List String -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module))))
dtLoadModulesPartsWithIfaces ctx names ifaces = do
  projectR <- loadProjectModulesWithPreloaded ctx names (modulesOfIfaces ifaces)
  pure (case projectR of
    ErrC e => ErrC e
    OkC project => case filterProjectToImports (contextPackageName ctx) project of
      Pair filtered mods =>
        resolveProjectKeeping (contextRelease ctx) (preloadKeepOf ifaces mods) filtered
  )

export dtCheckPackageWithIfacesParts : PackageContext -> String -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckPackageWithIfacesParts ctx entry ifaces = do
  partsR <- dtLoadPartsWithIfaces ctx entry ifaces
  pure (case partsR of
    ErrC e => ErrC e
    OkC resolved => case shiftedDepPrograms (materializedDeps (contextPackageName ctx) (secondOf resolved) ifaces) of
      ErrC e => ErrC e
      OkC deps => dtCheckOursParts ctx resolved deps
  )

dtLoadModulesPartsIncremental : PackageContext -> List String -> List ModuleIface -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) (Pair (List Decl) (List Module))))
dtLoadModulesPartsIncremental ctx names depIfaces cleanIfaces =
  let
    preloaded = append (modulesOfIfaces depIfaces) (reverse (map moduleOfIface cleanIfaces))
    allIfaces = append depIfaces cleanIfaces
  in do
    projectR <- loadProjectModulesWithPreloaded ctx names preloaded
    pure (case projectR of
      ErrC e => ErrC e
      OkC project => case filterProjectToImports (contextPackageName ctx) project of
        Pair filtered mods =>
          resolveProjectKeeping (contextRelease ctx) (preloadKeepOf allIfaces mods) filtered
    )

export dtCheckLibraryPackageIncrementalParts : PackageContext -> List String -> List ModuleIface -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckLibraryPackageIncrementalParts ctx names depIfaces cleanIfaces = do
  partsR <- dtLoadModulesPartsIncremental ctx names depIfaces cleanIfaces
  pure (case partsR of
    ErrC e => ErrC e
    OkC resolved => case dtIncrementalChecked ctx resolved (materializedDeps (contextPackageName ctx) (secondOf resolved) depIfaces) (materializedOwn (contextPackageName ctx) (secondOf resolved) cleanIfaces) of
      ErrC e => ErrC e
      OkC checked => OkC (Pair checked.checkedWarnings checked)
  )

export dtCheckLibraryPackageWithIfacesParts : PackageContext -> List String -> List ModuleIface -> Eff hostRow (Check (Pair (List Diagnostic) CheckedPackage))
dtCheckLibraryPackageWithIfacesParts ctx names ifaces = do
  partsR <- dtLoadModulesPartsWithIfaces ctx names ifaces
  pure (case partsR of
    ErrC e => ErrC e
    OkC resolved => case shiftedDepPrograms (materializedDeps (contextPackageName ctx) (secondOf resolved) ifaces) of
      ErrC e => ErrC e
      OkC deps => dtCheckOursParts ctx resolved deps
  )

-- 只精化本包声明、从接口合并依赖产物，再走同一条逐模块 split；返回 codegen 文件 +
-- CheckedPackage（构建路径也写接口摘要）。
export dtSplitProjectWithIfaces : PackageContext -> String -> Bool -> List ModuleIface -> Eff hostRow (Check (Pair (List SplitFile) CheckedPackage))
dtSplitProjectWithIfaces ctx entry printResult ifaces = do
  partsR <- dtLoadPartsWithIfaces ctx entry ifaces
  case partsR of
    ErrC e => pure (ErrC e)
    OkC resolved => case shiftedDepPrograms (materializedDeps (contextPackageName ctx) (secondOf resolved) ifaces) of
      ErrC e => pure (ErrC e)
      OkC deps =>
        dtSplitPartsOursWith ctx entry (secondOf resolved) deps printResult
          (concatMap miDefLocsOf ifaces)

dtSplitPartsOursWith : PackageContext -> String -> Pair (List Decl) (List Module) -> List CachedProgram -> Bool -> List (Pair String (Pair String Int)) -> Eff hostRow (Check (Pair (List SplitFile) CheckedPackage))

dtSplitPartsOurs : PackageContext -> String -> Pair (List Decl) (List Module) -> List CachedProgram -> Bool -> Eff hostRow (Check (Pair (List SplitFile) CheckedPackage))
dtSplitPartsOurs ctx entry parts deps printResult =
  dtSplitPartsOursWith ctx entry parts deps printResult []

dtSplitPartsOursWith ctx entry parts deps printResult extraDefLocs =
  let
    pkgName = contextPackageName ctx
    modules = reverse (secondOf parts)
    ours = filter (\m => modulePackageOf m == pkgName) modules
    depsOnly = filter (\m => modulePackageOf m /= pkgName) modules
    allDecls = append (concatMap moduleDeclsOf ours) (firstOf parts)
    termAux = concatMap moduleDeclsOf depsOnly
    start = depStartOf deps
  in case elabProgramFullWithAux (firstOf start) (secondOf start) termAux allDecls of
    ErrC e => pure (ErrC e)
    OkC prog =>
      let
        assembled =
          DtProgram (append (concatMap cachedDatas deps) (dtProgDatas prog))
            (append (concatMap cachedDefs deps) (dtProgDefs prog)) (dtProgGoals prog)
            (dtProgSols prog) (dtProgGlobals prog) (dtProgInsts prog) (dtProgClasses prog)
            prog.dtProgNext prog.dtProgDefVals prog.dtProgDepths (dtProgWarnings prog)
        moduleParts = map (\m => Pair (moduleNameOf m) (moduleDeclsOf m)) modules
        checked =
          CheckedPackage prog (secondOf parts) (firstOf parts) (cachedNamesOf deps)
            (dtProgWarnings prog)
      in do
        filesR <-
          splitGenerateCached ctx entry modules moduleParts (firstOf parts) assembled printResult
            extraDefLocs
        pure (case filesR of
          ErrC e => ErrC e
          OkC files => OkC (Pair files checked)
        )

-- 全量路径的 parts 版本（构建缓存未命中且依赖接口不可用）：同一份 CheckedPackage 供
-- 接口影子写使用，避免 build 后还要再 check 一次才写接口。
export dtSplitProjectParts : PackageContext -> String -> Bool -> Eff hostRow (Check (Pair (List SplitFile) CheckedPackage))
dtSplitProjectParts ctx entry printResult = do
  partsR <- dtLoadParts ctx entry
  case partsR of
    ErrC e => pure (ErrC e)
    OkC resolved =>
      let
        parts = secondOf resolved
        loaderWarns = firstOf resolved
        modules = reverse (secondOf parts)
        allDecls = append (concatMap moduleDeclsOf modules) (firstOf parts)
      in case elabProgramFull allDecls of
        ErrC e => pure (ErrC e)
        OkC prog => do
          filesR <-
            splitGenerateCached ctx entry modules
              (map (\m => Pair (moduleNameOf m) (moduleDeclsOf m)) modules) (firstOf parts) prog
              printResult []
          pure (case filesR of
            ErrC e => ErrC e
            OkC files =>
              let
                warns = append loaderWarns (dtProgWarnings prog)
              in OkC (Pair files (CheckedPackage prog (secondOf parts) (firstOf parts) [] warns))
          )

-- ---------------------------------------------------------------
-- UN_UnusedDefinition：入口检查完成后，未被任何定义体/类型引用的定义告警。
-- 只对入口路径启用（库包导出面未知，避免误报）；`main` / `_` 前缀 / `$` 内部名跳过。
-- ---------------------------------------------------------------
-- | 入口检查后收集未引用定义的 UN_UnusedDefinition 告警（返回值交给驱动层输出）。
warnUnusedDefsIn : List DtDef -> List Diagnostic
warnUnusedDefsIn defs =
  let
    used = concatMap dtDefGlobalNames defs
  in warnUnusedDefsGo defs used

-- 定义出现的外部名字（body + type；Maybe 为空则跳过）。
-- | 定义体/类型里引用的外部名字。
dtDefGlobalNames : DtDef -> List String
dtDefGlobalNames d = append (maybeTermGlobals (dtDefBody d)) (termGlobalNames (dtDefType d))

-- | Maybe 项的全局名集合（空则空集）。
maybeTermGlobals : Maybe Term -> List String
maybeTermGlobals Nothing = []
maybeTermGlobals (Just t) = termGlobalNames t

-- | 未使用定义扫描实现（按定义顺序返回诊断）。
warnUnusedDefsGo : List DtDef -> List String -> List Diagnostic
warnUnusedDefsGo [] used = []
warnUnusedDefsGo (d :: rest) used =
  let
    name = dtDefName d
    skip = name == "main" || startsWith "_" name || startsWith "$" name
  in if skip then warnUnusedDefsGo rest used
  else if memName name used then warnUnusedDefsGo rest used
  else case dtDefSpan d of
    Just sp =>
      Base.List.Cons
        (warnDiagAtMod (\x => withSuggestion (Suggestion "remove unused definition `${name}`" MachineApplicable [DiagEdit sp ""]) x) sp (UnusedDefinition name) [name])
        (warnUnusedDefsGo rest used)
    Nothing => warnUnusedDefsGo rest used

-- 恢复式检查（MVP，仅入口文件）：逐次精化，失败时按诊断所在行移除对应顶层声明后重试，
-- 收集最多 fuel 条独立错误。移除导致的后续级联错误也会被收集（调用方标注 best-effort）。
-- 成功路径仍由 `dtCheck` 负责（含 codegen）；本函数只在首次失败时使用。
-- | 诊断/告警实现：dtCheckRecovering（详见 diagnostics.md）。
export dtCheckRecovering : PackageContext -> String -> Eff hostRow (Check (List Diagnostic))
dtCheckRecovering ctx entry = do
  declsR <- dtLoad ctx entry
  pure (case declsR of
    ErrC e => ErrC e
    OkC loaded => recoverElab 8 (firstOf loaded) [] []
  )

-- | 恢复式精化循环：失败后移除相关声明继续。
recoverElab : Int -> List Decl -> List String -> List Diagnostic -> Check (List Diagnostic)
recoverElab fuel decls removed errs = if fuel <= 0 then OkC (reverse errs)
else case elabProgram decls of
  OkC _ => OkC (reverse errs)
  ErrC d =>
    let
      d2 = markCascade removed d
      names = case primarySpanOf d.diagLabels of
        Nothing => []
        Just sp => concatMap (\x => if declMatchesDiag sp x then declNames x else []) decls
      decls2 = filter (\x => not (declDropped names x)) decls
    in if length decls2 == length decls then OkC (reverse (Base.List.Cons d2 errs))
    else recoverElab (fuel - 1) decls2 (append removed names) (Base.List.Cons d2 errs)

-- | 诊断主 label 的起始行（无位置返回 Nothing）。
diagPrimaryLine : Diagnostic -> Maybe Int
diagPrimaryLine d = primaryLineOf d.diagLabels

-- | 诊断主 label 的 span（无位置返回 Nothing）。
primarySpanOf : List Label -> Maybe Span
primarySpanOf [] = Nothing
primarySpanOf ((Label (Just sp) _ LabelPrimary _) :: _) = Just sp
primarySpanOf (_ :: rest) = primarySpanOf rest

-- | 声明是否与诊断位置（文件 + 行）匹配。
declMatchesDiag : Span -> Decl -> Bool
declMatchesDiag sp x =
  let
    dsp = declSpan x
    sameFile =
      spanFile dsp == ""
        || spanFile sp == ""
        || normalizeDiagFile (spanFile dsp) == normalizeDiagFile (spanFile sp)
  in sameFile && spanContainsLine dsp (spanStartLine sp)

-- | 从 label 列表取主 label 起始行。
primaryLineOf : List Label -> Maybe Int
primaryLineOf [] = Nothing
primaryLineOf ((Label (Just sp) _ LabelPrimary _) :: _) = Just (spanStartLine sp)
primaryLineOf (_ :: rest) = primaryLineOf rest

-- | span 是否覆盖某行。
spanContainsLine : Span -> Int -> Bool
spanContainsLine sp line = spanStartLine sp <= line && line <= spanEndLine sp

-- | 声明是否包含待移除的名字。
declDropped : List String -> Decl -> Bool
declDropped names d = anyNameIn (declNames d) names

-- | 名字列表是否有交集。
anyNameIn : List String -> List String -> Bool
anyNameIn [] names = False
anyNameIn (n :: rest) names = if memName n names then True else anyNameIn rest names

-- | 若诊断文本提到已移除声明名，标记为级联（best-effort 恢复的已知副作用）。
-- | 级联标记：诊断提到被移除声明名时标 origin=cascade。
markCascade : List String -> Diagnostic -> Diagnostic
markCascade [] d = d
markCascade removed d =
  if mentionedAny removed d.diagMessage then withOrigin (OriginCascade Nothing)
    (withField (FieldNote "best-effort: may be a cascade from an earlier removed declaration") d)
  else d

-- | 诊断消息是否按单词命中任一名字。
mentionedAny : List String -> String -> Bool
mentionedAny names msg = anyWordIn names (wordsOf msg)

-- | 名字列表与单词列表是否有交集。
anyWordIn : List String -> List String -> Bool
anyWordIn [] words = False
anyWordIn (n :: rest) words = if memName n words then True else anyWordIn rest words

-- | 按标识符字符切词。
wordsOf : String -> List String
wordsOf s = wordsGo (strUnpack s) [] []

-- | 切词循环。
wordsGo : List Int -> List Int -> List String -> List String
wordsGo [] cur acc = reverse (flushWord cur acc)
wordsGo (c :: rest) cur acc =
  if isIdentChar c then wordsGo rest (Base.List.Cons c cur) acc
  else wordsGo rest [] (flushWord cur acc)

-- | 把当前词刷入累积列表。
flushWord : List Int -> List String -> List String
flushWord [] acc = acc
flushWord cur acc = Base.List.Cons (strPack (reverse cur)) acc

-- | 标识符字符判定。
isIdentChar : Int -> Bool
isIdentChar c = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

-- | 库包（[export].modules）的恢复式检查：加载模块后对汇总声明做逐声明恢复。
export dtCheckLibraryRecovering : PackageContext -> List String -> Eff hostRow (Check (List Diagnostic))
dtCheckLibraryRecovering ctx names = do
  partsR <- dtLoadModulesParts ctx names
  pure (case partsR of
    ErrC e => ErrC e
    OkC resolved => recoverElab 8 (dtProjectDecls (secondOf resolved)) [] []
  )

-- | 去掉 ./ 前缀便于路径比较。
normalizeDiagFile : String -> String
normalizeDiagFile p =
  if startsWith "./" p then substring (natFromInt 2) (natFromInt (strLength p - 2)) p else p

-- `vuna check` 的整包 codegen 检查：Lowering（擦除 / 表示决策 / SCC）+ 装配（丢弃文本），
-- 保证「能 check 就能 build」。main 的存在与返回类型只在生成入口要求（库模块也能 check）。
checkDtProgramOf : List DtData -> List DtDef -> Check Int
checkDtProgramOf datas defs =
  Vuna.Compiler.Common.bind (lowerProgramOf datas defs)
    (\programIr => Vuna.Compiler.Common.bind (genUnitParts noQual (irProgSharedOf programIr) (irProgUnitOf programIr)) (\_ => OkC 0))
