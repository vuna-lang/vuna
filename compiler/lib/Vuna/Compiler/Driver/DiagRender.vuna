module Vuna.Compiler.Driver.DiagRender where

-- Vuna.Compiler.Driver.DiagRender：CLI 诊断的源码片段渲染（M38 P3）。
--
-- 编译器各阶段把诊断拼成 `<file>:<line>:<col>: <消息>`（`Diagnostics.Common.diagErrAt`
-- / `Elab.Types.errAt`），CLI 打印前用本模块追加位置、源码行与插入符片段：
--
--   error: [pkg] <file>:<line>:<col>: <消息>
--     --> <file>:<line>:<col>
--      |
--    N | <源码行>
--      |     ^^^^
--
-- 设计约束（零行为变化）：
--   * 无法定位 / 文件不可读 / 行越界 / 消息本身含换行 → 原样返回原诊断；
--   * 首行（`error: `/`warning: ` 前缀 + 可选 `[pkg] ` + 原消息）**保持原样**：
--     诊断首行是稳定输出契约（corpus 的 `.err` 片段会断言它），本模块只追加片段。
--
-- 位置扫描按「连续两段数字」找 `<file>:<line>:<col>:`——思路同 LSP 的 Protocol 解析，
-- 但 compiler 包不能 import lib，故在本模块内独立实现；file 可含 ':'，也可能带
-- `Vuna.Compiler.X: ` / `[CG_X] ` 之类的前置标签，故对候选做宽松归一化后再读文件。
import Base.HostRow
import Vuna.Compiler.Common
import Base.List

-- ---------------------------------------------------------------
-- 字符与文本小工具
-- ---------------------------------------------------------------
isDigitCode : Int -> Bool
isDigitCode c = c >= 48 && c <= 57

-- 标识符/数字字符：字母、数字、下划线、撇号（词法器的 isIdentChar）与限定名里的 '.'。
isWordCode : Int -> Bool
isWordCode c =
  isDigitCode c || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 39 || c == 46

charAt : List Int -> Int -> Int
charAt [] _ = 0 - 1
charAt (c :: rest) i = if i <= 0 then c else charAt rest (i - 1)

-- 第一次出现字符 c 的下标；找不到返回 -1。
findCharIdx : Int -> List Int -> Int -> Int
findCharIdx c [] i = 0 - 1
findCharIdx c (x :: rest) i = if x == c then i else findCharIdx c rest (i + 1)

clampInt : Int -> Int -> Int -> Int
clampInt lo hi v = if v < lo then lo else if v > hi then hi else v

-- 行号右对齐用：不足 n 字符时左侧补空格。
padLeft : Int -> String -> String
padLeft n s = if strLength s >= n then s else repeat (natFromInt (n - strLength s)) " " ++ s

digitsValue : List Int -> Int -> Int
digitsValue [] acc = acc
digitsValue (c :: rest) acc = digitsValue rest (acc * 10 + (c - 48))

parseNum : String -> Int
parseNum s = digitsValue (strUnpack s) 0

allDigitCodes : List Int -> Bool
allDigitCodes [] = True
allDigitCodes (c :: rest) = isDigitCode c && allDigitCodes rest

-- 非空且全为 ASCII 数字（`<line>` / `<col>` 段）。
isNumText : String -> Bool
isNumText s = strLength s > 0 && allDigitCodes (strUnpack s)

lastText : List String -> String
lastText [] = ""
lastText (x :: rest) = case rest of
  [] => x
  _ => lastText rest

-- ---------------------------------------------------------------
-- 前缀拆分：`error: ` / `warning: ` 与可选 `[pkg] `
-- ---------------------------------------------------------------
splitCliPrefix : String -> Pair String String
splitCliPrefix s =
  let
    n = if startsWith "error: " s then 7 else if startsWith "warning: " s then 9 else 0
  in Pair (substring 0 (natFromInt n) s) (substring (natFromInt n) (natFromInt (strLength s - n)) s)

-- 可选包前缀：包级检查把 `[包名] ` 放在 `error: ` 之后；剥掉后渲染完再拼回，
-- 保证首行与片段头部顺序不变。`[TC_...]` 之类错误码前缀即使被剥掉也会原样拼回。
splitPkg : String -> Pair String String
splitPkg s = if startsWith "[" s then
  let
    i = findCharIdx 93 (strUnpack s) 0
  in if i < 0 then Pair "" s
  else if charAt (strUnpack s) (i + 1) == 32 then Pair (substring 0 (natFromInt (i + 2)) s)
    (substring (natFromInt (i + 2)) (natFromInt (strLength s - i - 2)) s)
  else Pair "" s
else Pair "" s

-- ---------------------------------------------------------------
-- 位置扫描：按 ':' 切段，找连续两段纯数字（<line>:<col>），再还原 file 前缀
-- ---------------------------------------------------------------
locCandidates : String -> List (Pair String (Pair Int Int))
locCandidates msg = scanCandidates msg [] (split ":" msg)

scanCandidates : String -> List String -> List String -> List (Pair String (Pair Int Int))
scanCandidates msg acc [] = []
scanCandidates msg acc (a :: rest) = case rest of
  [] => []
  b :: more => case more of
    [] => []
    c :: tail =>
      let
        next = scanCandidates msg (a :: acc) rest
      in if isNumText b && isNumText c then Base.List.Cons
        (Pair (normalizeFile (join ":" (reverse (a :: acc)))) (Pair (parseNum b) (parseNum c))) next
      else next

-- 候选 file 可能带前置标签（`Vuna.Compiler.Common: ` / `[CG_X] ` / `in name: `）。
-- 取最后一个 `: `、`] ` 之后的路径并 trim；读不到文件时仍会退回原样，故宽松无害。
normalizeFile : String -> String
normalizeFile part =
  let
    noBracket = if startsWith "[" part then dropBracket part else part
    noLabel = if contains ": " noBracket then lastText (split ": " noBracket) else noBracket
  in trim noLabel

dropBracket : String -> String
dropBracket s =
  let
    i = findCharIdx 93 (strUnpack s) 0
  in if i < 0 then s else trim (substring (natFromInt (i + 1)) (natFromInt (strLength s - i - 1)) s)

-- 取第 line 行（1-based）；越界返回 Nothing。
lineAt : List String -> Int -> Maybe String
lineAt [] n = Nothing
lineAt (x :: rest) n = if n <= 1 then Just x else lineAt rest (n - 1)

stripCr : String -> String
stripCr s = if endsWith "\r" s then substring 0 (natFromInt (strLength s - 1)) s else s

-- 依次尝试语法候选：文件存在、不是目录、行号在范围内才采纳；否则尝试下一个。
firstReadableLocEff : List (Pair String (Pair Int Int)) -> Eff hostRow (Maybe (Pair String (Pair Int (Pair Int String))))
firstReadableLocEff [] = pure Nothing
firstReadableLocEff ((Pair file (Pair line col)) :: rest) = if line < 1 then firstReadableLocEff rest
else do
  exists <- raiseToRow hostRow (@vuna@prim_eff_fileExists file)
  if exists then do
    isDir <- raiseToRow hostRow (@vuna@prim_eff_isDirectory file)
    if isDir then firstReadableLocEff rest
    else do
      raw <- raiseToRow hostRow (@vuna@prim_eff_readFile file)
      case lineAt (lines raw) line of
        Nothing => firstReadableLocEff rest
        Just rawLine => pure (Just (Pair file (Pair line (Pair col (stripCr rawLine)))))
  else firstReadableLocEff rest

-- ---------------------------------------------------------------
-- 片段渲染：tab 显示成单空格；插入符覆盖 col 处的 token（标识符/数字/字符串/单符号）
-- ---------------------------------------------------------------
displayLine : String -> String
displayLine s = strPack (map tabToSpace (strUnpack (stripCr s)))

tabToSpace : Int -> Int
tabToSpace 9 = 32
tabToSpace c = c

caretStart : String -> Int -> Int
caretStart display col = clampInt 0 (strLength display) (col - 1)

-- 从 start 起扫 token 的显示宽度：字符串字面量到闭引号（含引号）、标识符/数字到
-- 词字符结束、其余按单符号；行尾/越界时至少 1 个插入符。
caretWidth : List Int -> Int -> Int
caretWidth chars start = case drop start chars of
  [] => 1
  c :: rest =>
    if c == 34 then litWidth (c :: rest) 0 False
    else if isWordCode c then wordWidth (c :: rest) 0 else 1

wordWidth : List Int -> Int -> Int
wordWidth [] n = n
wordWidth (c :: rest) n = if isWordCode c then wordWidth rest (n + 1) else n

-- 字符串字面量宽度（含首尾引号）；未闭引号取到行尾。首字符是开引号（n = 0）。
litWidth : List Int -> Int -> Bool -> Int
litWidth [] n esc = n
litWidth (c :: rest) n esc = if esc then litWidth rest (n + 1) False
else case c of
  92 => litWidth rest (n + 1) True
  34 => if n <= 0 then litWidth rest (n + 1) False else n + 1
  _ => litWidth rest (n + 1) False

gutter : Int -> String
gutter width = "${repeat (natFromInt (width + 1)) " "}|"

numberRow : Int -> Int -> String -> String
numberRow width line display = "${padLeft width (strFromInt line)} | ${display}"

caretRow : Int -> Int -> Int -> String
caretRow width start carets =
  "${repeat (natFromInt (width + 1)) " "}|${repeat (natFromInt (start + 1)) " "}${repeat (natFromInt carets) "^"}"

snippetBlock : String -> Int -> Int -> String -> String
snippetBlock file line col srcLine =
  let
    display = displayLine srcLine
    width = strLength (strFromInt line)
    start = caretStart display col
    carets = caretWidth (strUnpack display) start
  in join "\n"
    ["  --> ${file}:${line}:${col}", gutter width, numberRow width line display, caretRow width start carets]

-- ---------------------------------------------------------------
-- 对外入口
-- ---------------------------------------------------------------
-- 消息体渲染：可渲染时返回「原消息 + 换行 + 片段」，否则原样返回。
renderBodyEff : String -> Eff hostRow String
renderBodyEff msg = do
  found <- firstReadableLocEff (locCandidates msg)
  case found of
    Nothing => pure msg
    Just (Pair file (Pair line (Pair col srcLine))) =>
      pure "${msg}\n${snippetBlock file line col srcLine}"

-- 保留一个尾随换行（调用方常按 `message ++ "\n"` 传入）；消息内部含换行则退回原样。
renderBodyWithNewlineEff : String -> Eff hostRow String
renderBodyWithNewlineEff body =
  let
    trailing = endsWith "\n" body
    core = if trailing then substring 0 (natFromInt (strLength body - 1)) body else body
  in if contains "\n" core then pure body
  else do
    rendered <- renderBodyEff core
    pure (if trailing then "${rendered}\n" else rendered)

-- | 完整 CLI 诊断行：保留前缀与可选 `[pkg] `，消息体追加源码片段。
export renderCliDiagnosticEff : String -> Eff hostRow String
renderCliDiagnosticEff s =
  let
    pp = splitCliPrefix s
    pk = splitPkg (secondOf pp)
  in do
    body <- renderBodyWithNewlineEff (secondOf pk)
    pure (firstOf pp ++ firstOf pk ++ body)

-- 用调用方给的显式前缀渲染（包级检查：前缀里带 `error: [包名] `）。
export renderWithPrefixEff : String -> String -> Eff hostRow String
renderWithPrefixEff prefix msg =
  let
    pk = splitPkg msg
  in do
    body <- renderBodyWithNewlineEff (secondOf pk)
    pure (prefix ++ firstOf pk ++ body)
