module Vuna.Compiler.Driver.PerfCache
  ( unitCacheBucketGc
  , unitCacheCodec
  , unitCacheDir
  , unitCacheEntryDir
  , unitCacheEntryKeyOf
  , unitCacheFileName
  , unitCacheGc
  , unitCacheRead
  , unitCacheTag
  , unitCacheWrite
  ) where

-- Vuna.Compiler.Driver.PerfCache：codegen **单元级**缓存（M34.5 S5）的磁盘层。
--
-- 与包级 split 缓存（`List SplitFile` 一把存）不同，这里按**单元**存生成结果：
-- 包内一个模块改动时，其余单元（源码/依赖哈希都没变）直接复用上次生成的 `SplitFile`
-- 文本，不重新跑 codegen。key 由调用方（`Driver.Dt`）算好：单元名 + 声明/import 内容
-- + 传递依赖单元 key + printResult。
--
-- 文件 = `Store` framing + `SplitFile` 的**显式规范编码**（codec `split-file 1`，
-- 见 `Driver.Split.encSplitFile`）。tag 里带编译器 tag（schema + 版本 + 二进制指纹）：
-- 编译器或格式变化后旧缓存自然失效；framing/内容地址不符即未命中，坏文件回退重算，
-- 不会把任意字节喂给解码器。
-- 产物放 `<cacheBase>/<pkg>/split-units/e-<entry 桶>/`，构建前先做**桶间 GC**（只留当前
-- entry）与**桶内 GC**（只留本次单元 key 集合对应的文件，见 `unitCacheBucketGc`）。
--
-- 效果显式化：目录遍历 / 读文件 / 写文件 / 建目录 / 删除 / 环境与二进制指纹全部显式在
-- `Eff []` 里；纯数据逻辑（路径 / 哈希 / 文件名 / 桶 key）保持纯函数。
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Common
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Fingerprint
import Vuna.Compiler.Store
import Vuna.Compiler.Version

unitCacheSchema : String
unitCacheSchema = "vuna-unit-cache 2"

-- | 单元缓存载荷的编码版本（`Store` 的 codec 段）。
unitCacheCodec : String
unitCacheCodec = "split-file 1"

unitCacheTag : Eff [] String
unitCacheTag = do
  tag <- compilerTagEff
  pure "${unitCacheSchema}/${tag}"

cacheBaseOf : Eff [] String
cacheBaseOf = do
  t <- prim_eff_getenv "TMPDIR"
  pure (case t of
    "" => "/tmp"
    tmp => tmp
  )

unitCacheDir : String -> Eff [] String
unitCacheDir pkg = do
  base <- cacheBaseOf
  pure "${base}/vuna-cache/${hashTextOf pkg}/split-units"

hashTextOf : String -> String
hashTextOf s = strFromInt (textHashOf s)

unitCachePath : String -> String -> String -> String
unitCachePath dir name key = "${dir}/${unitCacheFileName name key}"

-- 单元文件名（桶内 GC 用同一函数算「本次仍被引用」的集合，不能另写一套命名）。
unitCacheFileName : String -> String -> String
unitCacheFileName name key =
  let
    h1 = textHashOf "k1:${key}"
    h2 = textHashOf "k2:${key}"
    h3 = textHashOf "k3:${key}"
  in "${unitNameSafe name}-${h1}-${h2}-${h3}.unit"

unitNameSafe : String -> String
unitNameSafe s = strPack (map charSafe (strUnpack s))

charSafe : Int -> Int
charSafe c = if c == 46 then 95 else c

-- M34.5（S7）：单元缓存按 **entry 分桶**。同一包在不同工具/入口下共用包名 key 会让
-- 不同入口的单元互相污染（entry key 已含声明哈希，但桶隔离才是清理与命中的边界）。
-- 目录名带 entry key 的两个哈希；GC 只保留当前 entry 桶（旧 layout 的散落文件一并清）。
unitCacheEntryDir : String -> String -> String
unitCacheEntryDir base entryKey =
  "${base}/e-${textHashOf "entry:${entryKey}"}-${textHashOf "entry2:${entryKey}"}"

unitCacheEntryKeyOf : List (Pair String String) -> String
unitCacheEntryKeyOf keys = case lookupPair "__entry__" keys of
  Just k => k
  Nothing => ""

-- | 删除文件，**文件不存在也不报错**。
--
-- 为什么不能直接用 `prim_eff_removeFile`：单元缓存目录按包共享，`vuna test --jobs N` /
-- workspace 并行 check 会有多个进程同时 GC 同一个桶。`removeFile` 在文件已被别的进程
-- 删掉时抛宿主异常（语言里没有 try/catch），表现为
-- `runtime error: removeFile: ... No such file or directory`。
-- `exists` 再删仍有 TOCTOU 窗口，所以走 `rm -f`（幂等）。
safeRemoveFile : String -> Eff [] Int
safeRemoveFile path = do
  exists <- prim_eff_fileExists path
  if exists then prim_eff_runIn "/" ["rm", "-f", path] else pure 0

unitCacheGc : String -> String -> Eff [] Int
unitCacheGc base keepDir = do
  _ <- storeEnsureDirEff base
  names <- prim_eff_readDir base
  gcEntries base keepDir names

gcEntries : String -> String -> List String -> Eff [] Int
gcEntries base keepDir [] = pure 0
gcEntries base keepDir (n :: rest) =
  let
    path = "${base}/${n}"
  in if path == keepDir then gcEntries base keepDir rest
  else do
    isDir <- prim_eff_isDirectory path
    if isDir then do
      _ <- dropDirFiles path
      gcEntries base keepDir rest
    else do
      _ <- safeRemoveFile path
      gcEntries base keepDir rest

dropDirFiles : String -> Eff [] Int
dropDirFiles dir = do
  names <- prim_eff_readDir dir
  dropFiles dir names

dropFiles : String -> List String -> Eff [] Int
dropFiles dir [] = pure 0
dropFiles dir (f :: rest) = do
  _ <- safeRemoveFile "${dir}/${f}"
  dropFiles dir rest

-- M34.6（S7 补完）：**桶内 GC**。同一 entry 桶只清「本次构建仍会引用」的 unit 文件之外
-- 的旧条目：`keepNames` = 本次全部单元 key（含 entry）算出的文件名，所以即将查询/命中的
-- 单元一定在保留集合里（不会删掉马上要命中的），而同一入口反复编辑累积下来的旧 key 文件
-- 全部清掉 ⇒ 桶内文件数有界（≤ 单元数 + 1）。
-- key 的传递依赖链保证「依赖接口变化 ⇒ 依赖者 key 变化」，旧 key 文件不再可能被命中。
unitCacheBucketGc : String -> List String -> Eff [] Int
unitCacheBucketGc dir keepNames = do
  _ <- storeEnsureDirEff dir
  names <- prim_eff_readDir dir
  bucketGcGo dir keepNames names

bucketGcGo : String -> List String -> List String -> Eff [] Int
bucketGcGo dir keepNames [] = pure 0
bucketGcGo dir keepNames (f :: rest) =
  let
    path = "${dir}/${f}"
  in if memName f keepNames then bucketGcGo dir keepNames rest
  else do
    exists <- prim_eff_fileExists path
    isDir <- if exists then prim_eff_isDirectory path else pure False
    if exists && isDir then bucketGcGo dir keepNames rest
    else do
      _ <- safeRemoveFile path
      bucketGcGo dir keepNames rest

unitCacheRead : String -> String -> String -> Eff [] (Maybe SplitFile)
unitCacheRead dir name key = do
  tag <- unitCacheTag
  payload <- storeReadEff tag unitCacheCodec (unitCachePath dir name key)
  pure (case payload of
    Just bytes => decSplitFileComplete bytes
    Nothing => Nothing
  )

unitCacheWrite : String -> String -> String -> SplitFile -> Eff [] Int
unitCacheWrite dir name key sf = do
  _ <- storeEnsureDirEff dir
  tag <- unitCacheTag
  storeWriteEff tag unitCacheCodec (unitCachePath dir name key) (encTop encSplitFile sf)
