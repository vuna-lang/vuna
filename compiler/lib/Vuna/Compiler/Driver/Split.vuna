module Vuna.Compiler.Driver.Split where

-- Vuna.Compiler.Driver.Split：分离编译的输出文件模型与构建脚本生成。
--
-- Codegen.Split.generateDtSplitProgram 产出 `List SplitFile`（相对文件名 + 内容 +
-- 该单元的直接依赖单元名）；本模块负责落盘并生成**分层并行**的增量构建脚本：
--   - C35：跨单元引用改为全限定 OCaml 名字后，每个单元只依赖它真正引用的前序单元，
--     依赖图不再退化为「open 全部前序」的全序链；
--   - 分层由 vuna 侧预先算好（splitLayers：depth(u) = 1 + max(depth(dep))，无依赖
--     depth = 0）：同层单元互不依赖，脚本逐层编译、层内多单元用后台任务并行；
--   - 增量判据 = 本单元 .ml/.mli + **直接依赖** 的 .stamp 内容哈希（M30/D15：同输入
--     同产物，不依赖 mtime），改一个单元只重编它的直接/传递依赖者；
--   - 最后按依赖拓扑序链接成可执行文件。
-- 构建脚本只用 POSIX sh + ocamlopt，可在 Nix 沙箱内复现。
import Vuna.Compiler.Canonical.Bytes
import Vuna.Compiler.Common
import Vuna.Compiler.Hash
import Base.HashMap
import Base.List

export record SplitFile(..) where
  splitName : String
  splitText : String
  splitDeps : List String

splitName : SplitFile -> String
splitName (SplitFile name text deps) = name

splitText : SplitFile -> String
splitText (SplitFile name text deps) = text

-- 该输出文件所在编译单元的直接依赖（单元名 = 模块名 sanitize 后，无扩展名）。
splitDeps : SplitFile -> List String
splitDeps (SplitFile name text deps) = deps

-- M4（效果显式化）：落盘是宿主动作，显式在 `Eff []` 里；文件内容/依赖图计算保持纯。
export writeSplitFiles : String -> List SplitFile -> Eff [] (Check Int)
writeSplitFiles dir [] = pure (OkC 0)
writeSplitFiles dir (f :: rest) = do
  restR <- writeSplitFiles dir rest
  case restR of
    ErrC e => pure (ErrC e)
    OkC n => do
      _ <- prim_eff_writeFile "${dir}/${splitName f}" (splitText f)
      pure (OkC (n + 1))

-- M30：只写内容变化的文件（build 的逐模块增量写盘；内容相同不 touch）。
export writeSplitFilesIfChanged : String -> List SplitFile -> Eff [] (Check Int)
writeSplitFilesIfChanged dir [] = pure (OkC 0)
writeSplitFilesIfChanged dir (f :: rest) = do
  restR <- writeSplitFilesIfChanged dir rest
  case restR of
    ErrC e => pure (ErrC e)
    OkC n =>
      let
        path = "${dir}/${splitName f}"
        text = splitText f
      in do
        exists <- prim_eff_fileExists path
        if exists then do
          old <- prim_eff_readFile path
          if old == text then pure (OkC (n + 1))
          else do
            _ <- prim_eff_writeFile path text
            pure (OkC (n + 1))
        else do
          _ <- prim_eff_writeFile path text
          pure (OkC (n + 1))

-- 编译单元依赖图：按输出顺序取 .ml（跳过 .mli），unit = 文件名去掉 ".ml"；
-- deps 原样保留（已是直接依赖单元名，保持顺序、不去重）。
export splitGraph : List SplitFile -> List (Pair String (List String))
splitGraph [] = []
splitGraph (f :: rest) =
  let
    name = splitName f
  in if endsWith ".ml" name then Base.List.Cons (Pair (stripMl name) (splitDeps f)) (splitGraph rest)
  else splitGraph rest

stripMl : String -> String
stripMl name = substring 0 (byteLength name - 3) name

-- 按直接依赖分层。graph 是拓扑序（依赖在前），一遍扫描即可算出所有层的 depth：
--   depth(unit) = 1 + max(depth(dep))；无依赖 depth = 0；dep 不在 graph 里按 depth 0 计。
-- 层内保持 graph 顺序（确定），层间按 depth 升序。
export splitLayers : List (Pair String (List String)) -> List (List (Pair String (List String)))
splitLayers [] = []
splitLayers graph =
  let
    depths = splitDepths graph (Base.HashMap.fromList [])
    maxD = graphMaxDepth graph depths 0
  in map (\d => filter (\q => depthOfUnit depths (firstOf q) == d) graph) (range 0 (maxD + 1))

-- 扫描 graph 建 depth 表；依赖都已在前（拓扑序），因此一遍就够。
splitDepths : List (Pair String (List String)) -> HashMap String Int -> HashMap String Int
splitDepths [] depths = depths
splitDepths ((Pair unit deps) :: rest) depths =
  splitDepths rest (Base.HashMap.insert unit (depthOfDeps depths deps) depths)

-- depth(unit) = 1 + max(depth(dep))；空依赖 = 0。
depthOfDeps : HashMap String Int -> List String -> Int
depthOfDeps depths [] = 0
depthOfDeps depths (dep :: rest) = maxInt (depthOfUnit depths dep + 1) (depthOfDeps depths rest)

depthOfUnit : HashMap String Int -> String -> Int
depthOfUnit depths unit = case Base.HashMap.lookup unit depths of
  Just d => d
  Nothing => 0

graphMaxDepth : List (Pair String (List String)) -> HashMap String Int -> Int -> Int
graphMaxDepth [] depths acc = acc
graphMaxDepth ((Pair unit deps) :: rest) depths acc =
  graphMaxDepth rest depths (maxInt acc (depthOfUnit depths unit))

maxInt : Int -> Int -> Int
maxInt a b = if a > b then a else b

-- 构建脚本；graph 是 (单元名, 直接依赖单元名) 的拓扑序（依赖在前，链接顺序即 graph 顺序）。
-- M33 W5：cFiles 是包根 `ffi/*.c` 复制到 OUTDIR 后的相对路径（如 `ffi/add.c`），
-- 由 ocamlopt 编译成 .o 并参与链接；空列表时行为与旧版一致。
-- 并行度由 `$JOBS` 决定（`VUNA_BUILD_JOBS` > `NIX_BUILD_CORES` > `nproc`）：
--   * 干净构建（没有 .cmx，例如 Nix 构建 seed / stage1）**且 JOBS ≤ 1**：一次 ocamlopt
--     调用，避免几十次进程启动（单核下分层并行的进程/I/O 开销反而更慢）；
--   * 其余情况（干净 + 多核，或已有 .cmx 的增量）：按**内容哈希**（.ml/.mli + 直接依赖
--     .stamp）逐单元编译，单单元层前台、多单元层 `&` 并行 + 逐个 `wait` 收尾。
export buildScript : List (Pair String (List String)) -> List String -> String
buildScript graph cFiles = """#!/bin/sh
# 由 vuna 生成：分离编译构建脚本（C35：按直接依赖分层并行 + 内容哈希增量）。用法: ./build.sh [OUT]
# 干净构建且 JOBS<=1：一次 ocamlopt 编译全部 .mli/.ml 并链接；
# 增量构建：每单元 .ml/.mli 与直接依赖 .stamp 的内容哈希写 $base.stamp，命中即跳过；
# 同层单元互不依赖：多单元层用后台任务并行编译，层间用 wait 串行。
set -eu
cd \"$(dirname \"$0\")\"
OUT=\${1:-program}
FLAGS=\"-g -w -a+39 -warn-error +39\"
MODULES=\"${spaceJoin (graphUnits graph)}\"
JOBS=\${VUNA_BUILD_JOBS:-}
if [ -z \"$JOBS\" ]; then
  JOBS=$(nproc 2>/dev/null || echo 1)
  case \"\${NIX_BUILD_CORES:-}\" in
    ''|*[!0-9]*) ;;
    0) ;;
    *) JOBS=$NIX_BUILD_CORES ;;
  esac
fi
C_MODULES=\"${spaceJoin cFiles}\"
C_OBJS=\"\"
if [ -n \"$C_MODULES\" ]; then
  for c in $C_MODULES; do ocamlopt -I +unix -c \"$c\"; b=\${c##*/}; C_OBJS=\"$C_OBJS \${b%.c}.o\"; done
fi
hash_of() {
  for f in \"$@\"; do
    if [ -f \"$f\" ]; then cat \"$f\"; else printf '%s' '-'; fi
  done | sha256sum | awk '{print $1}'
}
stamp_want() {
  base=$1
  shift
  deps=\"\"
  for d in \"$@\"; do deps=\"$deps $d.stamp\"; done
  hash_of \"$base.ml\" \"$base.mli\" $deps
}
clean=1
for m in $MODULES; do
  if [ -f \"$m.cmx\" ]; then clean=0; fi
done
if [ \"$clean\" -eq 1 ] && [ \"$JOBS\" -le 1 ]; then
  SOURCES=\"\"
  for m in $MODULES; do
    if [ -f \"$m.mli\" ]; then SOURCES=\"$SOURCES $m.mli\"; fi
    SOURCES=\"$SOURCES $m.ml\"
  done
  ocamlopt $FLAGS -I +unix -o \"$OUT\" unix.cmxa $SOURCES $C_OBJS
${stampWrites graph}  echo \"built $OUT\"
  exit 0
fi
compile_mod() {
  base=$1
  shift
  want=$(stamp_want \"$base\" \"$@\")
  if [ -f \"$base.cmx\" ] && [ -f \"$base.stamp\" ] && [ \"$(cat \"$base.stamp\")\" = \"$want\" ]; then return 0; fi
  echo \"compile $base\"
  if [ -f \"$base.mli\" ]; then ocamlopt $FLAGS -I +unix -c \"$base.mli\"; fi
  ocamlopt $FLAGS -I +unix -c \"$base.ml\"
  printf '%s' \"$want\" > \"$base.stamp\"
}
${layerScripts (splitLayers graph)}ocamlopt $FLAGS -I +unix -o \"$OUT\" unix.cmxa ${joinCmxs (graphUnits graph)} $C_OBJS
echo \"built $OUT\"
"""

-- 干净构建成功后按 graph 顺序写每单元 stamp（只含直接依赖的 .stamp，与增量公式一致；
-- 依赖在前，因此依赖的 stamp 先写好）。用 `printf '%s' "$(...)"` 而不是直接重定向，
-- 让 stamp 的**字节**与增量路径（`printf '%s' "$want"`）完全相同——否则干净构建后
-- 第一次增量重编会因多一个换行而重算依赖链。
stampWrites : List (Pair String (List String)) -> String
stampWrites [] = ""
stampWrites (m :: rest) =
  "  printf '%s' \"$(stamp_want ${firstOf m}${depsSuffix (secondOf m)})\" > \"${firstOf m}.stamp\"\n${stampWrites rest}"

graphUnits : List (Pair String (List String)) -> List String
graphUnits [] = []
graphUnits (m :: rest) = firstOf m :: graphUnits rest

-- 逐层生成调用：单单元层前台执行；多单元层并行执行并收集 $!，最后逐个 wait。
layerScripts : List (List (Pair String (List String))) -> String
layerScripts [] = ""
layerScripts (layer :: rest) = layerCalls layer ++ layerScripts rest

layerCalls : List (Pair String (List String)) -> String
layerCalls [] = ""
layerCalls ([m]) = "compile_mod ${firstOf m}${depsSuffix (secondOf m)}\n"
layerCalls layer = """pids=\"\"
${bgCalls layer}for p in $pids; do wait \"$p\" || exit 1; done
"""

bgCalls : List (Pair String (List String)) -> String
bgCalls [] = ""
bgCalls (m :: rest) = """compile_mod ${firstOf m}${depsSuffix (secondOf m)} &
pids=\"$pids $!\"
${bgCalls rest}"""

spaceJoin : List String -> String
spaceJoin [] = ""
spaceJoin (name :: rest) = "${name} ${spaceJoin rest}"

depsSuffix : List String -> String
depsSuffix [] = ""
depsSuffix (dep :: rest) = " ${dep}${depsSuffix rest}"

joinCmxs : List String -> String
joinCmxs [] = ""
joinCmxs ([name]) = "${name}.cmx"
joinCmxs (name :: rest) = "${name}.cmx ${joinCmxs rest}"

-- M34.5（S5）：把 split 文件列表规范化为**确定性拓扑序**（依赖在前；同层按名字哈希
-- 排序）。单元缓存复用旧 `SplitFile` 后列表顺序会随命中集合变化，build.sh 的层/顺序
-- 不能因此漂移（否则增量/全量产物不一致）。深度用迭代松弛算（与列表顺序无关）。
--
-- 性能（2026-11）：旧实现在 119 单元的 `compiler` 包上占 `build-warm` 的 ~254 ms/次，
-- 三处叠加的 O(n²)：① 迭代松弛每轮对每个依赖线性扫 memo 表；② 插入排序每次比较重算
-- SHA-256 的 `unitTieKey`；③ 排序结果按名在 `files` 里线性找文件。现在：
--   ① 迭代松弛改用 `HashMap String Int` memo（每轮查找 O(1)，缺失键按 0）；
--   ② graph 单元 + 全部依赖去重成表，每个名字只算一次 tie key；
--   ③ `HashMap String SplitFile` 文件名索引。
-- 输出与旧实现一致：depth 是最长路径的同一不动点、稳定插入排序、同 depth 内按
-- `unitTieKey` 升序（`<=`）。
unitTieKey : String -> Int
unitTieKey name = Vuna.Compiler.Hash.contentKey "t:${name}"

-- 名字集合（graph 单元 + 全部直接依赖）：tie key 只对唯一名字各算一次 SHA-256。
nameSetOf : List (Pair String (List String)) -> HashMap String Bool -> HashMap String Bool
nameSetOf [] seen = seen
nameSetOf ((Pair unit deps) :: rest) seen =
  nameSetOf rest (markNames deps (Base.HashMap.insert unit True seen))

markNames : List String -> HashMap String Bool -> HashMap String Bool
markNames [] seen = seen
markNames (n :: rest) seen = markNames rest (Base.HashMap.insert n True seen)

tieTableOf : List (Pair String (List String)) -> HashMap String Int
tieTableOf graph =
  Base.HashMap.fromList
    (map (\n => Pair n (unitTieKey n)) (map firstOf (Base.HashMap.toList (nameSetOf graph (Base.HashMap.fromList [])))))

tieOf : HashMap String Int -> String -> Int
tieOf ties name = case Base.HashMap.lookup name ties of
  Just k => k
  Nothing => 0

-- 迭代松弛到不动点：depth(u) = 1 + max(depth(dep))（无依赖 = 0；dep 不在 graph 按 0）。
-- 每轮用上一轮的 depth 同步更新，与旧实现同一语义；HashMap 让每轮查找 O(1)。
maxDepth : HashMap String Int -> List String -> Int
maxDepth memo [] = 0 - 1
maxDepth memo (d :: rest) =
  let
    dd = depthOfUnit memo d
    mm = maxDepth memo rest
  in if dd > mm then dd else mm

stepDepths : HashMap String Int -> List (Pair String (List String)) -> List (Pair String Int)
stepDepths memo [] = []
stepDepths memo (p :: rest) =
  let
    md = maxDepth memo (secondOf p)
  in Pair (firstOf p) (if md < 0 then 0 else md + 1) :: stepDepths memo rest

-- 与旧 `sameDepthValue next memo` 等价：层表键集固定（graph 的单元名），逐项比同值。
sameDepthTable : HashMap String Int -> List (Pair String Int) -> Bool
sameDepthTable memo [] = True
sameDepthTable memo (p :: rest) =
  depthOfUnit memo (firstOf p) == secondOf p && sameDepthTable memo rest

fixDepths : Int -> List (Pair String (List String)) -> HashMap String Int -> HashMap String Int
fixDepths fuel graph memo = if fuel <= 0 then memo
else
  let
    next = stepDepths memo graph
  in if sameDepthTable memo next then memo else fixDepths (fuel - 1) graph (Base.HashMap.fromList next)

-- 排序键 = (depth, tieKey)；预计算后比较只碰 Int（旧实现在每次比较里跑 SHA-256）。
depthEntryLess : Pair (Pair Int Int) String -> Pair (Pair Int Int) String -> Bool
depthEntryLess a b =
  if firstOf (firstOf a) /= firstOf (firstOf b) then firstOf (firstOf a) < firstOf (firstOf b)
  else secondOf (firstOf a) <= secondOf (firstOf b)

insertDepthEntry : Pair (Pair Int Int) String -> List (Pair (Pair Int Int) String) -> List (Pair (Pair Int Int) String)
insertDepthEntry x [] = [x]
insertDepthEntry x (y :: rest) =
  if depthEntryLess x y then Base.List.Cons x (Base.List.Cons y rest)
  else Base.List.Cons y (insertDepthEntry x rest)

sortDepthEntries : List (Pair (Pair Int Int) String) -> List (Pair (Pair Int Int) String)
sortDepthEntries [] = []
sortDepthEntries (x :: rest) = insertDepthEntry x (sortDepthEntries rest)

-- 文件名索引：查 `${unit}.ml`；非 .ml 项与旧 `findFileNamed` 一样不参与。
filesOfDepthEntries : HashMap String SplitFile -> List String -> List SplitFile
filesOfDepthEntries table [] = []
filesOfDepthEntries table (unit :: rest) = case Base.HashMap.lookup "${unit}.ml" table of
  Just f => f :: filesOfDepthEntries table rest
  Nothing => filesOfDepthEntries table rest

export canonicalTopo : List SplitFile -> List SplitFile
canonicalTopo files =
  let
    graph = splitGraph files
    ties = tieTableOf graph
    fileTable = Base.HashMap.fromList (map (\f => Pair (splitName f) f) files)
    baseMemo = Base.HashMap.fromList (map (\p => Pair (firstOf p) 0) graph)
    depths = fixDepths (length graph + 2) graph baseMemo
    keyed =
      map (\p => Pair (Pair (depthOfUnit depths (firstOf p)) (tieOf ties (firstOf p))) (firstOf p))
        graph
    ordered = map secondOf (sortDepthEntries keyed)
  in map (normalizeFileDeps ties) (filesOfDepthEntries fileTable ordered)

sortDepsByTie : HashMap String Int -> List String -> List String
sortDepsByTie ties deps = map firstOf (sortDepEntries (map (\d => Pair d (tieOf ties d)) deps))

sortDepEntries : List (Pair String Int) -> List (Pair String Int)
sortDepEntries [] = []
sortDepEntries (x :: rest) = insertDep x (sortDepEntries rest)

insertDep : Pair String Int -> List (Pair String Int) -> List (Pair String Int)
insertDep x [] = [x]
insertDep x (y :: rest) =
  if secondOf x <= secondOf y then Base.List.Cons x (Base.List.Cons y rest)
  else Base.List.Cons y (insertDep x rest)

normalizeFileDeps : HashMap String Int -> SplitFile -> SplitFile
normalizeFileDeps ties f = SplitFile (splitName f) (splitText f) (sortDepsByTie ties (splitDeps f))

-- ---------------------------------------------------------------
-- 载荷编码（split 缓存 / 单元缓存共用，C32 收口）
-- ---------------------------------------------------------------
-- `SplitFile` 是 codegen 的输出模型（文件名 + 文本 + 直接依赖单元名）。落盘走这里，
-- 不再是 `prim_marshal`：文本本身就是产物，显式编码后逐字节稳定，且能被 `Store` 的
-- 内容地址覆盖。
--
-- | `SplitFile` 的规范编码：名字 / 文本 / 依赖表。
export encSplitFile : SplitFile -> List String -> List String
encSplitFile f acc = encStr f.splitName (encStr f.splitText (encList encStr f.splitDeps acc))

decSplitFile : Int -> Cur -> Maybe (Pair SplitFile Cur)
decSplitFile fuel c = do
  p1 <- decStr (fuel - 1) c
  p2 <- decStr (fuel - 1) (secondOf p1)
  p3 <- decList decStr (fuel - 1) (secondOf p2)
  pure (Pair (SplitFile (firstOf p1) (firstOf p2) (firstOf p3)) (secondOf p3))

-- | `List SplitFile` 的规范编码（split 缓存载荷）。
export encSplitFiles : List SplitFile -> List String -> List String
encSplitFiles fs acc = encList encSplitFile fs acc

-- | 整串解析 `List SplitFile`（split 缓存载荷入口）。
export decSplitFilesComplete : String -> Maybe (List SplitFile)
decSplitFilesComplete s = case decList decSplitFile (strLength s) (curOf s) of
  Nothing => Nothing
  Just (Pair fs rest) => if curAtEnd rest then Just fs else Nothing

-- | 整串解析单个 `SplitFile`（单元缓存载荷入口）。
export decSplitFileComplete : String -> Maybe SplitFile
decSplitFileComplete s = case decSplitFile (strLength s) (curOf s) of
  Nothing => Nothing
  Just (Pair f rest) => if curAtEnd rest then Just f else Nothing
