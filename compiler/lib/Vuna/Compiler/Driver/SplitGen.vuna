module Vuna.Compiler.Driver.SplitGen where

-- 逐模块 split 生成（`compile` / `build` / `seed` 的唯一输出模型）。
--
-- **输入是 Lowering 的产物形态**：每个单元的 `IrUnit` 由 `SplitInput.siLowerUnit`
-- 闭包按需求值（由 Driver 从 `DtProgram` + 归属表构造），命中单元缓存时不调用。
-- 本模块只做「归属过滤 + 分文件装配 + 依赖序校验」，不 import Core / Elab / Intrinsics。
--
-- 每个单元只 `open Vuna_runtime`，跨单元引用（值 / 构造子 / 类型）由 `Codegen.Decl` /
-- `Codegen.Term` 生成 `Unit.name` 全限定名；每个 `SplitFile` 因此带一张**直接依赖单元**
-- 表（实际引用到的单元，由 `Codegen.Assembly.UnitParts` 累积），文件顺序仍是拓扑序但
-- 编译不再依赖 open 链 —— 依赖图是精确 DAG，可分层/并行编译。
import Vuna.Compiler.Common
import Base.Eff.Types
import Base.HashMap
import Vuna.Compiler.Driver.Split
import Vuna.Compiler.Diagnostics
import Vuna.Compiler.Ir
import Vuna.Compiler.Codegen.Assembly
import Vuna.Compiler.Codegen.Decl
import Vuna.Compiler.Codegen.Term

export splitUnitOfModule : String -> String
splitUnitOfModule modName = sanitizeName modName

-- 入口单元在定义求值**之前**就开启回栈记录（零参 `main` 在模块初始化期求值，
-- 早于 main 钩子的 try；初始化异常靠当时已开启的回栈打印 vuna 位置帧）。
mainInitPrologue : String
mainInitPrologue = "let () = Printexc.record_backtrace true\n"

-- ---------------------------------------------------------------
-- 按归属过滤 + 生成
-- ---------------------------------------------------------------
-- 名字 → 归属单元的哈希索引。对**每个**模块把全部名字逐个线性扫 pairs 是
-- O(#模块 × #名字 × #pairs)，大包上就是几秒。
export ownerTblOf : List (Pair String String) -> HashMap String String
ownerTblOf pairs = Base.HashMap.insertAll pairs (Base.HashMap.fromList [])

ownerOfTbl : HashMap String String -> String -> String
ownerOfTbl t name = case Base.HashMap.lookup name t of
  Just o => o
  Nothing => ""

export namesInUnit : HashMap String String -> String -> List String -> List String
namesInUnit ownerT u names = filter (\n => ownerOfTbl ownerT n == u) names

-- ---------------------------------------------------------------
-- 依赖序：每单元的直接依赖必须全部落在更早的模块里。
-- 生成器累积的依赖来自**实际引用**（`QualCtx` 限定 / 类型声明 / List 桥接 / main
-- 钩子），所以这里只需校验拓扑序并按编译顺序排列（build.sh 的分层吃这份顺序）。
-- ---------------------------------------------------------------
-- 位置以 1 起算，0 = 不在表里（vuna 没有负整数字面量，不用 -1 哨兵）。
posOfName : String -> List String -> Int
posOfName name units = posOfNameGo 1 name units

posOfNameGo : Int -> String -> List String -> Int
posOfNameGo i name [] = 0
posOfNameGo i name (u :: rest) = if u == name then i else posOfNameGo (i + 1) name rest

checkDepsOrder : List String -> String -> List String -> Check Int
checkDepsOrder ordered self [] = OkC 0
checkDepsOrder ordered self (d :: rest) =
  let
    selfPos = posOfName self ordered
    depPos = posOfName d ordered
  in if depPos == 0 then icInternal "${self} references unknown unit `${d}`"
  else if selfPos == 0 then icInternal "split unit `${self}` is not in the module order"
  else if depPos >= selfPos then icInternal "split dependency is not in topological order: ${self} -> ${d}"
  else checkDepsOrder ordered self rest

depsInOrder : List String -> String -> List String -> List String
depsInOrder ordered self deps = filter (\u => not (u == self) && memName u deps) ordered

unitDepsOf : List String -> String -> List String -> Check (List String)
unitDepsOf ordered self deps =
  Vuna.Compiler.Common.bind (checkDepsOrder ordered self deps)
    (\_ => OkC (depsInOrder ordered self deps))

-- 分文件生成的共享上下文（归属表一次建好，所有单元复用）。
record SplitGenCtx where
  -- 程序级共享元数据（装配与 List 桥接用）。
  sgcShared : IrShared
  -- 全部运行时定义名 / 数据族名（程序顺序；按归属过滤出每单元的子集）。
  sgcDefNames : List String
  sgcDataNames : List String
  -- 名字 → 归属模块（原始模块名，入口是 `Main`）。
  sgcDefOwnerT : HashMap String String
  sgcDataOwnerT : HashMap String String
  -- 名字 → 归属**单元**（sanitize 之后；渲染限定名用）。
  sgcDefUnitT : HashMap String String
  sgcDataUnitT : HashMap String String
  -- 单元编译顺序（`Vuna_runtime` 在前、入口在最后）。
  sgcOrdered : List String
  -- `#line` 路径归一（包相对）：与 `dt_def_locs` 位置表用同一函数（`splitLocPath`）。
  sgcNormPath : String -> String
  -- 单元 lowering（Driver 提供；命中缓存时不调用）。参数是原始模块名。
  sgcLowerUnit : String -> Check IrUnit
  -- 入口形态（动作 vs 值、展示函数、handler 序列）。
  sgcLowerEntry : Check (Maybe IrEntry)
  sgcPrintResult : Bool

mapToUnit : List (Pair String String) -> List (Pair String String)
mapToUnit pairs = map (\q => Pair (firstOf q) (splitUnitOfModule (secondOf q))) pairs

-- ---------------------------------------------------------------
-- 定义位置表（Vuna_runtime.ml 的 dt_def_locs）的路径归一
-- ---------------------------------------------------------------
-- 定义 span 里的路径是解析时的原样：模块文件是 `<rootDir>/<模块路径>.vuna` 的绝对
-- 路径，入口可能是绝对 `<contextDir>/app/Main.vuna` 或调用方给的相对路径。位置表按
-- 「模块根 → 包目录 → 前导 ./」顺序尽量剥成短路径；都不匹配则保留原样。
splitStripPrefix : String -> String -> String
splitStripPrefix prefix path =
  if prefix == "" then path
  else if startsWith "${prefix}/" path then strSubstring (strLength "${prefix}/") (strLength path - strLength "${prefix}/") path
  else path

splitStripRoots : List String -> String -> String
splitStripRoots [] path = path
splitStripRoots (root :: rest) path =
  if startsWith "${root}/" path then splitStripPrefix root path else splitStripRoots rest path

splitStripDotSlash : String -> String
splitStripDotSlash path =
  if startsWith "./" path then strSubstring 2 (strLength path - 2) path else path

export splitLocPath : List String -> String -> String -> String
splitLocPath roots contextDir path =
  splitStripDotSlash (splitStripPrefix contextDir (splitStripRoots roots path))

noUnitLookup : {r : Row} -> String -> Eff r (Maybe SplitFile)
noUnitLookup _ = pure Nothing

noUnitStore : {r : Row} -> String -> SplitFile -> Eff r Int
noUnitStore _ _ = pure 0

-- | 生成输入：归属表、共享元数据、运行时文本与按需求值的单元 lowering。
export record SplitInput where
  -- loader 模块序（原始模块名；文件顺序）。
  siModuleNames : List String
  -- 编译顺序（单元名：`Vuna_runtime` 在前、入口在最后）。
  siOrdered : List String
  -- 全部运行时定义名 / 数据族名（程序顺序）。
  siDefNames : List String
  siDataNames : List String
  -- 名字 → 归属模块（原始名）。
  siDefOwner : List (Pair String String)
  siDataOwner : List (Pair String String)
  -- 程序级共享元数据。
  siShared : IrShared
  -- `Vuna_runtime.ml` 文本（位置表已按 `siNormPath` 归一）。
  siRuntimeText : String
  -- 生成的入口是否打印 main 结果。
  siPrintResult : Bool
  siNormPath : String -> String
  siLowerUnit : String -> Check IrUnit
  siLowerEntry : Check (Maybe IrEntry)

export generateDtSplitProgram : {r : Row} -> SplitInput -> Eff r (Check (List SplitFile))
generateDtSplitProgram si = generateDtSplitProgramWith noUnitLookup noUnitStore si

-- 带**单元级缓存**的生成入口（`lookup` 按模块名，入口用 `__entry__`；
-- 命中即跳过该单元的 lowering + 文本生成，`store` 只对重新生成的单元调用）。
export generateDtSplitProgramWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> SplitInput -> Eff r (Check (List SplitFile))
generateDtSplitProgramWith lookup store si =
  let
    _ = dbg! "cg-splitstart"
    defUnitT = unitTblOf (mapToUnit si.siDefOwner)
    dataUnitT = unitTblOf (mapToUnit si.siDataOwner)
    ctx =
      SplitGenCtx si.siShared si.siDefNames si.siDataNames (ownerTblOf si.siDefOwner)
        (ownerTblOf si.siDataOwner) defUnitT dataUnitT si.siOrdered si.siNormPath si.siLowerUnit
        si.siLowerEntry si.siPrintResult
  in do
    moduleFilesR <- splitModuleFilesWith lookup store ctx si.siModuleNames
    case moduleFilesR of
      ErrC e => pure (ErrC e)
      OkC moduleFiles => do
        mainFileR <- splitMainFileWith lookup store ctx
        pure (case mainFileR of
          ErrC e => ErrC e
          OkC mainFile =>
            OkC (SplitFile "Vuna_runtime.ml" si.siRuntimeText [] :: append moduleFiles [mainFile])
        )

-- 单模块：按归属取名字 → 单元 lowering（闭包）→ 装配成文件。
splitModuleFilesWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> SplitGenCtx -> List String -> Eff r (Check (List SplitFile))
splitModuleFilesWith lookup store ctx [] = pure (OkC [])
splitModuleFilesWith lookup store ctx (mname :: rest) = do
  cached <- lookup mname
  case cached of
    Just cachedFile => do
      tailR <- splitModuleFilesWith lookup store ctx rest
      pure (case tailR of
        ErrC e => ErrC e
        OkC tail => OkC (cachedFile :: tail)
      )
    Nothing =>
      let
        unit = splitUnitOfModule mname
        unitDefs = namesInUnit ctx.sgcDefOwnerT mname ctx.sgcDefNames
        unitDatas = namesInUnit ctx.sgcDataOwnerT mname ctx.sgcDataNames
        qc = QualCtx unit ctx.sgcDefUnitT ctx.sgcDataUnitT
      in case ctx.sgcLowerUnit mname of
        ErrC e => pure (ErrC e)
        OkC unitIr => case genUnitPartsWith ctx.sgcNormPath qc ctx.sgcShared unitIr of
          ErrC e => pure (ErrC e)
          OkC parts => do
            tailR <- splitModuleFilesWith lookup store ctx rest
            case tailR of
              ErrC e => pure (ErrC e)
              OkC tail => case unitDepsOf ctx.sgcOrdered unit (unitPartsDeps parts) of
                ErrC e => pure (ErrC e)
                OkC deps =>
                  let
                    sf = SplitFile "${unit}.ml" "${genUnitText parts}\n" deps
                  in do
                    _ <- store mname sf
                    pure (OkC (sf :: tail))

-- 入口文件：`Main` 单元正文 + main 钩子。
splitMainFileWith : {r : Row} -> (String -> Eff r (Maybe SplitFile)) -> (String -> SplitFile -> Eff r Int) -> SplitGenCtx -> Eff r (Check SplitFile)
splitMainFileWith lookup store ctx = do
  cached <- lookup "__entry__"
  case cached of
    Just cachedFile => pure (OkC cachedFile)
    Nothing =>
      let
        entryUnit = splitUnitOfModule entryUnitName
        qc = QualCtx entryUnit ctx.sgcDefUnitT ctx.sgcDataUnitT
      in case ctx.sgcLowerUnit entryUnitName of
        ErrC e => pure (ErrC e)
        OkC unitIr => case ctx.sgcLowerEntry of
          ErrC e => pure (ErrC e)
          OkC entryM => case entryM of
            Nothing => pure (cgErr0 NoMain)
            Just entryIr => case genUnitPartsWith ctx.sgcNormPath qc ctx.sgcShared unitIr of
              ErrC e => pure (ErrC e)
              OkC parts => case genEntryHook (mkGenStWith ctx.sgcNormPath qc ctx.sgcShared) entryIr ctx.sgcPrintResult of
                ErrC e => pure (ErrC e)
                OkC hook => case unitDepsOf ctx.sgcOrdered entryUnit (append (unitPartsDeps parts) (secondOf hook)) of
                  ErrC e => pure (ErrC e)
                  OkC deps =>
                    let
                      sf =
                        SplitFile "Main.ml" (mainInitPrologue ++ genUnitText parts ++ firstOf hook)
                          deps
                    in do
                      _ <- store "__entry__" sf
                      pure (OkC sf)
