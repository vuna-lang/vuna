-- | 规范字节编码的原子层：自定界原子 + 对应的解析器（roundtrip 与载荷解码共用）。
module Vuna.Compiler.Canonical.Bytes where

-- Vuna.Compiler.Canonical.Bytes：内容寻址的**规范字节格式**（C32 哈希输入侧 + 载荷解码侧）。
--
-- 编码目标：把语义值写成一串**自定界**字节，供 SHA-256 取摘要，也可作为缓存载荷落盘。
-- 与 `prim_marshal`（已删除）的区别，这正是 C32 的缺口：
--   * 显式：格式只由本模块定义，不随编译器/OCaml 运行时版本漂移；
--   * 规范：调用方先去掉 span / 路径、按名字排序，编码本身不含任何位置信息；
--   * 自定界：每个原子带类型前缀与长度，串接无歧义（`encConcat` 一次拼接）；
--   * 可解析：每个原子都有对应 `dec*`，`enc`+`dec` 构成 roundtrip（见 examples/infra）。
--
-- 原子文法（字节）：
--   tag     = '#' DEC ';'          int  = 'i' ['-'] DEC ';'
--   string  = 's' DEC ':' BYTES     bool = 'b0' | 'b1'
--   list    = '[' DEC ':' ITEM*     maybe = '0' | '1' ITEM
--
-- 编码器是**累积器（difference-list）风格**：`encX x acc` 把 x 的分片 cons 到 acc 上，
-- 不拷贝子分片；顶层用 `encTop`/`encConcat` 一次 `strConcatMany`（单遍分配）。
-- 因此整个值的编码是 O(字节数)，不会出现逐层 `++` 的 O(n²) 拷贝（MB 级载荷会直接
-- 卡住 iface 阶段）。
--
-- 解析器吃**光标 `Cur`（原串 + 偏移）**而不是 `List Int`：载荷是 MB 级（iface 单包
-- 9 MB / split 单条 5 MB），`strUnpack` 会把字节逐个装箱成 cons cell 再拼回字符串——
-- 本机实测 5 MB 的 `strUnpack` 约 990 ms，而光标解码 12 MB 约 19 ms。`strAt` 是 OCaml
-- `String.get`，O(1)；`strSubstring` 只在取字符串原子时调用一次（一次拷贝）。
--
-- 燃料（显式 `Int`）仍然保留并逐原子递减：光标前进不体现在参数结构上，`Nat`/结构递归
-- 无法证明终止（与 `storeEnsureDirEff` 的 fuel 同级惯例）。每次进入递归组 fuel 严格下降。
-- 解析只在**载荷读回**与 roundtrip 自检里用；写侧只编码。
import Base.Bool
import Base.Int
import Base.List
import Base.Maybe
import Base.Pair
import Base.String

-- | 解析光标：`curS` 是尚未消费的**整个**字节串（不切片），`curI` 是已消费偏移。
--
-- 不持有「剩余串」（`curS` 始终是原串、偏移递增）是有意的：`decStr` 取子串时用
-- `strSubstring start len curS` 一次拷贝，其余原子只推进偏移，不做任何字符串拼接。
export record Cur(..) where
  curS : String
  curI : Int

-- | 从串头开一个光标。
export curOf : String -> Cur
curOf s = Cur s 0

-- | 光标是否已到串尾。
export curAtEnd : Cur -> Bool
curAtEnd c = c.curI >= strLength c.curS

-- | 当前字节（越界返回 `Nothing`；`strAt` 越界返回 -1，这里显式判）。
export curChar : Cur -> Maybe Int
curChar c = if c.curI < strLength c.curS then Just (strAt c.curS c.curI) else Nothing

-- | 前进一格（只在确认未越界后调用）。
export curSkip : Cur -> Cur
curSkip c = Cur c.curS (c.curI + 1)

-- | 取 `[start, start+len)` 的字节串（越界时调用方已校验，见 `decStr`）。
export curSlice : Cur -> Int -> Int -> String
curSlice c start len = strSubstring start len c.curS

-- | `List` 长度（`Base.List.length` 返回 `Nat`；编码要 `Int`）。
export lenOf : List a -> Int
lenOf [] = 0
lenOf (_ :: rest) = 1 + lenOf rest

-- | 把分片列表拼成最终字节串（一次 `strConcatMany`）。
export encConcat : List String -> String
encConcat parts = strConcatMany parts

-- | 编码入口：`encTop f x` = 把 x 的完整编码拼成一个字符串。
export encTop : (a -> List String -> List String) -> a -> String
encTop f x = encConcat (f x [])

-- | 和类型构造子序号：`#<n>;`。
export encTag : Int -> List String -> List String
encTag n acc = "#${strFromInt n};" :: acc

-- | 整数：`i<十进制>;`（负数带前置 `-`；无前导零）。
export encInt : Int -> List String -> List String
encInt n acc = "i${strFromInt n};" :: acc

-- | 字符串：`s<字节长度>:<原始字节>`（长度是字节数，不是字符数）。
export encStr : String -> List String -> List String
encStr s acc = "s${strFromInt (strLength s)}:" :: s :: acc

-- | 布尔：`b1` / `b0`。
export encBool : Bool -> List String -> List String
encBool True acc = "b1" :: acc
encBool False acc = "b0" :: acc

-- | 列表：`[<n>:<元素编码...>`（n = 元素个数）。
export encList : (a -> List String -> List String) -> List a -> List String -> List String
encList f xs acc = "[${strFromInt (lenOf xs)}:" :: encListGo f xs acc

-- | 列表元素：正序 cons 到 acc 上（递归吃 tail；编码本身不拷贝子分片）。
encListGo : (a -> List String -> List String) -> List a -> List String -> List String
encListGo f [] acc = acc
encListGo f (x :: rest) acc = f x (encListGo f rest acc)

-- | Maybe：`0` 表示 Nothing；`1<值编码>` 表示 Just。
export encMaybe : (a -> List String -> List String) -> Maybe a -> List String -> List String
encMaybe f Nothing acc = "0" :: acc
encMaybe f (Just x) acc = "1" :: f x acc

-- | 二元组（`Pair`）：两个分量直接串接（各自自定界，无需额外前缀）。
export encPair : (a -> List String -> List String) -> (b -> List String -> List String) -> Pair a b -> List String -> List String
encPair fa fb (Pair x y) acc = fa x (fb y acc)

-- | 解析一步的绑定：`thenPair (Just (Pair v rest)) k = k v rest`。
export thenPair : Maybe (Pair a Cur) -> (a -> Cur -> Maybe (Pair b Cur)) -> Maybe (Pair b Cur)
thenPair Nothing k = Nothing
thenPair (Just (Pair v rest)) k = k v rest

-- | 字节是否为 ASCII 十进制数字（`0`..`9`）。
isDigit : Int -> Bool
isDigit c = c >= 48 && c <= 57

-- | 读十进制数字直到 `stop` 字节（`:` = 58 / `;` = 59）。
-- 返回累计值 + 停在 stop 之后的光标；遇见非数字或燃料耗尽返回 Nothing。
decNumStop : Int -> Int -> Int -> Cur -> Maybe (Pair Int Cur)
decNumStop fuel stop acc c = if fuel <= 0 then Nothing
else case curChar c of
  Nothing => Nothing
  Just b =>
    if b == stop then Just (Pair acc (curSkip c))
    else if isDigit b then decNumStop (fuel - 1) stop (acc * 10 + (b - 48)) (curSkip c) else Nothing

-- | 解析 tag：`#<n>;`。
export decTag : Int -> Cur -> Maybe (Pair Int Cur)
decTag fuel c = if fuel <= 0 then Nothing
else case curChar c of
  Just 35 => decNumStop (fuel - 1) 59 0 (curSkip c)
  _ => Nothing

-- | 解析整数：`i[-]<n>;`。
export decInt : Int -> Cur -> Maybe (Pair Int Cur)
decInt fuel c = if fuel <= 0 then Nothing
else case curChar c of
  Just 105 => case curChar (curSkip c) of
    Just 45 =>
      thenPair (decNumStop (fuel - 1) 59 0 (curSkip (curSkip c))) (\n, b => Just (Pair (0 - n) b))
    _ => thenPair (decNumStop (fuel - 1) 59 0 (curSkip c)) (\n, b => Just (Pair n b))
  _ => Nothing

-- | 解析布尔：`b1` / `b0`。
export decBool : Int -> Cur -> Maybe (Pair Bool Cur)
decBool fuel c = if fuel <= 0 then Nothing
else case curChar c of
  Just 98 => case curChar (curSkip c) of
    Just 49 => Just (Pair True (curSkip (curSkip c)))
    Just 48 => Just (Pair False (curSkip (curSkip c)))
    _ => Nothing
  _ => Nothing

-- | 解析字符串：`s<n>:<n 个字节>`（按字节取，不重新解码 UTF-8）。
export decStr : Int -> Cur -> Maybe (Pair String Cur)
decStr fuel c = if fuel <= 0 then Nothing
else case curChar c of
  Just 115 =>
    thenPair (decNumStop (fuel - 1) 58 0 (curSkip c))
      (\n, b => if n < 0 || b.curI + n > strLength b.curS then Nothing else Just (Pair (curSlice b b.curI n) (Cur b.curS (b.curI + n))))
  _ => Nothing

-- | 解析列表：`[<n>:<n 个元素>`。
export decList : (Int -> Cur -> Maybe (Pair a Cur)) -> Int -> Cur -> Maybe (Pair (List a) Cur)
decList fp fuel c = if fuel <= 0 then Nothing
else case curChar c of
  Just 91 =>
    thenPair (decNumStop (fuel - 1) 58 0 (curSkip c)) (\n, b => decItems fp n (fuel - 1) b [])
  _ => Nothing

-- | 列表元素的循环（`n` 个，fuel 每步递减）。
decItems : (Int -> Cur -> Maybe (Pair a Cur)) -> Int -> Int -> Cur -> List a -> Maybe (Pair (List a) Cur)
decItems fp n fuel c acc =
  if n <= 0 then Just (Pair (reverse acc) c)
  else if fuel <= 0 then Nothing
  else thenPair (fp fuel c) (\x, b => decItems fp (n - 1) (fuel - 1) b (x :: acc))

-- | 解析 Maybe：`0` = Nothing；`1<item>` = Just。
export decMaybe : (Int -> Cur -> Maybe (Pair a Cur)) -> Int -> Cur -> Maybe (Pair (Maybe a) Cur)
decMaybe fp fuel c = if fuel <= 0 then Nothing
else case curChar c of
  Just 48 => Just (Pair Nothing (curSkip c))
  Just 49 => thenPair (fp (fuel - 1) (curSkip c)) (\x, b => Just (Pair (Just x) b))
  _ => Nothing

-- | 解析二元组：两个分量按编码顺序消费。
export decPair : (Int -> Cur -> Maybe (Pair a Cur)) -> (Int -> Cur -> Maybe (Pair b Cur)) -> Int -> Cur -> Maybe (Pair (Pair a b) Cur)
decPair fa fb fuel c =
  thenPair (fa (fuel - 1) c)
    (\x, b1 => thenPair (fb (fuel - 1) b1) (\y, b2 => Just (Pair (Pair x y) b2)))
