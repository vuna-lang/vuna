module Vuna.Compiler.CoreCodegen (checkDtProgram, generateDtProgram) where

-- Vuna.Compiler.CoreCodegen：DT 的擦除检查与 OCaml 生成（M14：索引族 + 依赖模式匹配）。
--
-- 与 TypedCodegen（HM 路径）完全独立：只依赖 Vuna.Compiler.Core / Vuna.Compiler.Elab，
-- 自带最小 runtime（bi_* 与 show helper），不引用 HM codegen 的内部 helper。
--
-- 擦除规则（由精化器在项上标好的标志驱动）：
-- - `rigIsErased` 为真的绑定不生成参数；同样为真的实参不生成实参；
-- - 类型级定义（类型 force 后是宇宙）整体不生成运行时定义；
-- - 运行时项里出现被擦除绑定 / 类型级定义 / 类型本身 → 报错（M16 做完整擦除分析）。
--
-- M14 追加：
-- - data 声明 → OCaml 变体类型（每个族一个 `type 'a t_F = ...`）；
-- - TCon → 变体构造子应用（跳过擦除实参）；
-- - TCase → OCaml match（分支绑定变量用去重名，擦除绑定子不进 pattern 但占 index）；
-- - 递归定义 → SCC 分组，自/互递归分量用 `let rec ... and ...` 生成。
import Vuna.Compiler.Common
import Vuna.Compiler.Core
import Vuna.Compiler.Elab

-- ---------------------------------------------------------------
-- 构造子应用的标准形态
-- ---------------------------------------------------------------
--
-- 精化器可能把饱和的构造子应用表示成嵌套 `TApp (TApp (TCon c []) a) b`，
-- 也可能直接给 `TCon c [a, b]`。这里统一折叠成 (构造子名, 实参列表)：
-- 擦除/依赖分析按实参自带的擦除标志判断，生成侧好一次性 tupled 出来。
flattenConApp : Term -> Maybe (Pair String (List (Pair Term Rig)))
flattenConApp t = case t of
  TApp f a rig => case flattenConApp f of
    Just (Pair c args) => Just (Pair c (append args [Pair a rig]))
    Nothing => Nothing
  TCon c args => Just (Pair c args)
  _ => Nothing

-- ---------------------------------------------------------------
-- 预处理：分区（类型级 / 运行时）、擦除检查、依赖拓扑排序
-- ---------------------------------------------------------------
defTable : List DtDef -> List (Pair String Term)
defTable [] = []
defTable (d :: rest) = Pair (dtDefName d) (dtDefBody d) :: defTable rest

findDtDef : String -> List DtDef -> Maybe DtDef
findDtDef name [] = Nothing
findDtDef name (d :: rest) = if dtDefName d == name then Just d else findDtDef name rest

isTypeLevelDef : List (Pair String Term) -> DtDef -> Bool
isTypeLevelDef table d = isTypeValue (force table [] defaultFuel (eval [] (dtDefType d)))

partitionDefs : List (Pair String Term) -> List DtDef -> Pair (List DtDef) (List String)
partitionDefs table defs = partitionDefsGo table defs [] []

partitionDefsGo : List (Pair String Term) -> List DtDef -> List DtDef -> List String -> Pair (List DtDef) (List String)
partitionDefsGo table [] runtime typeNames = Pair (reverse runtime) (reverse typeNames)
partitionDefsGo table (d :: rest) runtime typeNames =
  if isTypeLevelDef table d then partitionDefsGo table rest runtime (dtDefName d :: typeNames)
  else partitionDefsGo table rest (d :: runtime) typeNames

checkAllErasure : List String -> List DtDef -> Result Int
checkAllErasure typeNames [] = Ok 0
checkAllErasure typeNames (d :: rest) =
  andThen (checkOneErasure typeNames d) (\_ => checkAllErasure typeNames rest)

-- 报错带上定义名：同一份程序里哪个函数有问题要能一眼看出来。
checkOneErasure : List String -> DtDef -> Result Int
checkOneErasure typeNames d = case checkErasure typeNames [] (dtDefBody d) of
  Err e => Err ("in `" ++ dtDefName d ++ "`: " ++ e)
  Ok n => Ok n

-- binders：最近绑定在前（名字 + 是否擦除）。
showMetaHint : Int -> String
showMetaHint m = " ?" ++ strFromInt m

checkErasure : List String -> List (Pair String Rig) -> Term -> Result Int
checkErasure typeNames binders t = case t of
  TVar name i => case binderAt i binders of
    Just (Pair n rig) =>
      if rigIsErased rig then Err ("DT: type-level binding `" ++ name ++ "` is used at runtime (M13 limitation)")
      else Ok 0
    Nothing => Err ("DT: internal: unbound runtime variable " ++ name)
  TGlobal name =>
    if memName name typeNames then Err ("DT: type-level name `" ++ name ++ "` is used at runtime (M13 limitation)")
    else Ok 0
  TType l => Err "DT: a type is used at runtime (M13 limitation)"
  TPi name implicit rig dom cod => Err "DT: a type is used at runtime (M13 limitation)"
  TMeta m => Err ("DT: unsolved metavariable in runtime code" ++ showMetaHint m)
  TLam name rig body => checkErasure typeNames (Pair name rig :: binders) body
  TApp f a rig => case flattenConApp t of
    -- 嵌套在构造子上的应用按构造子实参检查（实参自带擦除标志，比 TApp 的更准）。
    Just (Pair c args) => checkConArgsErasure typeNames binders args
    Nothing =>
      if rigIsErased rig then checkErasure typeNames binders f
      else andThen (checkErasure typeNames binders f) (\_ => checkErasure typeNames binders a)
  -- M14：构造子应用只看非擦除实参（擦除实参是族参数/索引，允许是类型项）。
  TCon c args => checkConArgsErasure typeNames binders args
  -- M14：case 的分支把「完整 telescope（表面顺序）」压栈后再检查分支体。
  TCase scrut alts =>
    andThen (checkErasure typeNames binders scrut) (\_ => checkAltErasure typeNames binders alts)
  TInt n => Ok 0
  TStr s => Ok 0
  TBool b => Ok 0
  TIf c th el =>
    andThen (checkErasure typeNames binders c)
      (\_ => andThen (checkErasure typeNames binders th) (\_ => checkErasure typeNames binders el))

checkConArgsErasure : List String -> List (Pair String Rig) -> List (Pair Term Rig) -> Result Int
checkConArgsErasure typeNames binders [] = Ok 0
checkConArgsErasure typeNames binders ((Pair arg rig) :: rest) =
  if rigIsErased rig then checkConArgsErasure typeNames binders rest
  else andThen (checkErasure typeNames binders arg) (\_ => checkConArgsErasure typeNames binders rest)

checkAltErasure : List String -> List (Pair String Rig) -> List CaseAlt -> Result Int
checkAltErasure typeNames binders [] = Ok 0
checkAltErasure typeNames binders (alt :: rest) =
  let
    altBinders = caseAltBinders alt
    env = append (reverse altBinders) binders
  in andThen (checkErasure typeNames env (caseAltBody alt))
    (\_ => checkAltErasure typeNames binders rest)

binderAt : Int -> List (Pair String Rig) -> Maybe (Pair String Rig)
binderAt i [] = Nothing
binderAt i (b :: rest) = if i <= 0 then Just b else binderAt (i - 1) rest

-- 依赖：运行时会用到的 TGlobal（擦除实参里的不算）。
termDepsInto : List String -> List String -> Term -> List String
termDepsInto runtimeNames acc t = case t of
  TGlobal name => if memName name runtimeNames then addName name acc else acc
  TVar name i => acc
  TMeta m => acc
  TType l => acc
  TPi name implicit rig dom cod => acc
  TLam name rig body => termDepsInto runtimeNames acc body
  TApp f a rig => case flattenConApp t of
    Just (Pair c args) => termDepsArgs runtimeNames acc args
    Nothing =>
      if rigIsErased rig then termDepsInto runtimeNames acc f
      else termDepsInto runtimeNames (termDepsInto runtimeNames acc f) a
  TCon c args => termDepsArgs runtimeNames acc args
  TCase scrut alts => termDepsAlts runtimeNames (termDepsInto runtimeNames acc scrut) alts
  TInt n => acc
  TStr s => acc
  TBool b => acc
  TIf c th el =>
    termDepsInto runtimeNames (termDepsInto runtimeNames (termDepsInto runtimeNames acc c) th) el

termDepsArgs : List String -> List String -> List (Pair Term Rig) -> List String
termDepsArgs runtimeNames acc [] = acc
termDepsArgs runtimeNames acc ((Pair arg rig) :: rest) =
  if rigIsErased rig then termDepsArgs runtimeNames acc rest
  else termDepsArgs runtimeNames (termDepsInto runtimeNames acc arg) rest

termDepsAlts : List String -> List String -> List CaseAlt -> List String
termDepsAlts runtimeNames acc [] = acc
termDepsAlts runtimeNames acc (alt :: rest) =
  termDepsAlts runtimeNames (termDepsInto runtimeNames acc (caseAltBody alt)) rest

addName : String -> List String -> List String
addName name [] = [name]
addName name (x :: rest) = if x == name then x :: rest else x :: addName name rest

runtimeNamesOf : List DtDef -> List String
runtimeNamesOf [] = []
runtimeNamesOf (d :: rest) = dtDefName d :: runtimeNamesOf rest

lookupDtDef : List DtDef -> String -> Maybe DtDef
lookupDtDef defs name = findDtDef name defs

-- ---------------------------------------------------------------
-- SCC 分组（M14：替代 M13 的「递归 = 报错」）
-- ---------------------------------------------------------------
--
-- 与 TypedCodegen 的 Kosaraju 分组同构：先在正向依赖图上求完成顺序，再在反向图
-- 上按该顺序收集分量，最后按依赖就绪顺序排列分量。分量内成员按源码顺序排列，
-- 保证同一输入产出逐字节稳定的 OCaml。
neighborsOf : List (Pair String (List String)) -> String -> List String
neighborsOf adj name = case adj of
  [] => []
  (Pair n ns) :: rest => if n == name then ns else neighborsOf rest name

dependentsOf : String -> List (Pair String (List String)) -> List String
dependentsOf name [] = []
dependentsOf name ((Pair n ns) :: rest) =
  let
    dep = dependentsOf name rest
  in if memName name ns then n :: dep else dep

reverseAdj : List String -> List (Pair String (List String)) -> List (Pair String (List String))
reverseAdj names adj = map (\n => Pair n (dependentsOf n adj)) names

foldNeighborsPost : List (Pair String (List String)) -> List String -> List String -> List String -> Pair (List String) (List String)
foldNeighborsPost adj [] visited order = Pair visited order
foldNeighborsPost adj (m :: rest) visited order = if memName m visited then foldNeighborsPost adj rest visited order
else case dfsPost adj m (m :: visited) order of
  Pair visited2 order2 => foldNeighborsPost adj rest visited2 order2

dfsPost : List (Pair String (List String)) -> String -> List String -> List String -> Pair (List String) (List String)
dfsPost adj n visited order = case foldNeighborsPost adj (neighborsOf adj n) visited order of
  Pair visited2 order2 => Pair visited2 (n :: order2)

postOrder : List (Pair String (List String)) -> List String -> List String -> List String -> Pair (List String) (List String)
postOrder adj nodes visited order = case nodes of
  [] => Pair visited order
  n :: rest => if memName n visited then postOrder adj rest visited order
  else case dfsPost adj n (n :: visited) order of
    Pair visited2 order2 => postOrder adj rest visited2 order2

foldNeighborsCollect : List (Pair String (List String)) -> List String -> List String -> List String -> Pair (List String) (List String)
foldNeighborsCollect revAdj [] visited comp = Pair visited comp
foldNeighborsCollect revAdj (m :: rest) visited comp = if memName m visited then foldNeighborsCollect revAdj rest visited comp
else case dfsCollect revAdj m (m :: visited) comp of
  Pair visited2 comp2 => foldNeighborsCollect revAdj rest visited2 comp2

dfsCollect : List (Pair String (List String)) -> String -> List String -> List String -> Pair (List String) (List String)
dfsCollect revAdj n visited comp = case foldNeighborsCollect revAdj (neighborsOf revAdj n) visited comp of
  Pair visited2 comp2 => Pair visited2 (n :: comp2)

collectComps : List (Pair String (List String)) -> List String -> List String -> List (List String) -> List (List String)
collectComps revAdj nodes visited comps = case nodes of
  [] => comps
  n :: rest => if memName n visited then collectComps revAdj rest visited comps
  else case dfsCollect revAdj n (n :: visited) [] of
    Pair visited2 comp => collectComps revAdj rest visited2 (comp :: comps)

componentOf : List (List String) -> String -> Maybe (List String)
componentOf [] name = Nothing
componentOf (g :: rest) name = if memName name g then Just g else componentOf rest name

-- 按 names 首次出现顺序产出 SCC，组内成员按 names 顺序排列。
groupsFromComps : List (List String) -> List String -> List (List String)
groupsFromComps comps names = groupsFromCompsGo comps names names []

groupsFromCompsGo : List (List String) -> List String -> List String -> List String -> List (List String)
groupsFromCompsGo comps allNames [] emitted = []
groupsFromCompsGo comps allNames (n :: rest) emitted = if memName n emitted then groupsFromCompsGo comps allNames rest emitted
else case componentOf comps n of
  Just g =>
    filterNames (\m => memName m g) allNames
      :: groupsFromCompsGo comps allNames rest (append g emitted)
  Nothing => groupsFromCompsGo comps allNames rest emitted

filterNames : (String -> Bool) -> List String -> List String
filterNames pred names = case names of
  [] => []
  n :: rest => if pred n then n :: filterNames pred rest else filterNames pred rest

notIn : String -> List String -> Bool
notIn name names = if memName name names then False else True

uniqueNames : List String -> List String
uniqueNames [] = []
uniqueNames (name :: rest) =
  if name == "" then uniqueNames rest
  else if memName name rest then uniqueNames rest else name :: uniqueNames rest

groupDeps : List (Pair String (List String)) -> List String -> List String
groupDeps adj group =
  filterNames (\n => notIn n group) (uniqueNames (concatMap (neighborsOf adj) group))

allIn : List String -> List String -> Bool
allIn names allowed = case names of
  [] => True
  n :: rest => if memName n allowed then allIn rest allowed else False

groupReady : List (Pair String (List String)) -> List String -> List String -> Bool
groupReady adj group emitted = allIn (groupDeps adj group) emitted

pickReady : List (Pair String (List String)) -> List (List String) -> List String -> Maybe (Pair (List String) (List (List String)))
pickReady adj groups emitted = pickReadyAcc adj groups [] emitted

pickReadyAcc : List (Pair String (List String)) -> List (List String) -> List (List String) -> List String -> Maybe (Pair (List String) (List (List String)))
pickReadyAcc adj [] before emitted = Nothing
pickReadyAcc adj (g :: rest) before emitted =
  if groupReady adj g emitted then Just (Pair g (append (reverse before) rest))
  else pickReadyAcc adj rest (g :: before) emitted

orderGroups : List (Pair String (List String)) -> List (List String) -> Result (List (List String))
orderGroups adj groups = orderGroupsAcc adj groups []

orderGroupsAcc : List (Pair String (List String)) -> List (List String) -> List String -> Result (List (List String))
orderGroupsAcc adj [] emitted = Ok []
orderGroupsAcc adj remaining emitted = case pickReady adj remaining emitted of
  Nothing => Err "DT: dependency cycle between runtime definitions"
  Just (Pair g rest) =>
    andThen (orderGroupsAcc adj rest (append g emitted)) (\tail => Ok (g :: tail))

-- 运行时定义的依赖邻接表（只保留运行时会用到的 TGlobal 边）。
depAdjacency : List DtDef -> List (Pair String (List String))
depAdjacency defs =
  let
    names = runtimeNamesOf defs
  in map (\d => Pair (dtDefName d) (termDepsInto names [] (dtDefBody d))) defs

groupRuntimeDefs : List DtDef -> Result (List (List DtDef))
groupRuntimeDefs defs =
  let
    names = runtimeNamesOf defs
    adj = depAdjacency defs
    revAdj = reverseAdj names adj
  in case postOrder adj names [] [] of
    Pair _ order =>
      let
        comps = collectComps revAdj order [] []
        groups = groupsFromComps comps names
      in andThen (orderGroups adj groups) (\ordered => Ok (map (groupDefsOf defs) ordered))

groupDefsOf : List DtDef -> List String -> List DtDef
groupDefsOf defs [] = []
groupDefsOf defs (n :: rest) = case lookupDtDef defs n of
  Nothing => groupDefsOf defs rest
  Just d => d :: groupDefsOf defs rest

-- check / compile 共用的准备阶段：分区 + 擦除检查 + SCC 分组。
-- 返回 (运行时定义（源码顺序）, 已按依赖排序的分组)。
prepareDtProgram : Pair (List DtData) (List DtDef) -> Result (Pair (List DtDef) (List (List DtDef)))
prepareDtProgram program =
  let
    datas = firstOf program
    defs = secondOf program
    table = defTable defs
    familyNames = map dtDataName datas
  in case partitionDefs table defs of
    Pair runtime typeNames =>
      let
        allTypeNames = append typeNames familyNames
      in andThen (checkAllErasure allTypeNames runtime)
        (\_ => andThen (groupRuntimeDefs runtime) (\groups => Ok (Pair runtime groups)))

-- ---------------------------------------------------------------
-- OCaml 生成
-- ---------------------------------------------------------------
sanitizeChar : Int -> List Int
-- `#` 出现在 Loader 生成的匿名实例名里（`#default`、`#fancy`），OCaml 标识符不允许。
sanitizeChar c =
  if c == 46 then [95, 100]
  else if c == 95 then [95, 117] else if c == 39 then [95, 112] else if c == 35 then [95, 104] else [c]

sanitizeName : String -> String
sanitizeName name = strPack (concatMap sanitizeChar (strUnpack name))

ocamlPad3 : String -> String
ocamlPad3 s = if strLength s == 1 then "00" ++ s else if strLength s == 2 then "0" ++ s else s

ocamlEscapeChar : Int -> List Int
ocamlEscapeChar c =
  if c == 34 then [92, 34]
  else if c == 92 then [92, 92]
  else if c == 10 then [92, 110]
  else if c == 9 then [92, 116]
  else if c == 13 then [92, 114]
  else if c >= 32 && c <= 126 then [c] else strUnpack ("\\" ++ ocamlPad3 (strFromInt c))

ocamlString : String -> String
ocamlString s = "\"" ++ strPack (concatMap ocamlEscapeChar (strUnpack s)) ++ "\""

valueName : String -> String
valueName name = "v_" ++ sanitizeName name

-- 单独提出来：OCaml `if` 直接作构造子实参时 TypedCodegen 的括号处理不可靠，
-- 这里把它包成一个命名函数，保证自举编译本文件时生成的 OCaml 合法。
boolText : Bool -> String
boolText b = if b then "true" else "false"

-- M14：族 → OCaml 变体类型名；构造子 → 带族前缀的变体构造子名（避免跨族重名）。
typeName : String -> String
typeName name = "t_" ++ sanitizeName name

ctorOcamlName : String -> String -> String
ctorOcamlName family ctor = "C_" ++ sanitizeName family ++ "_" ++ sanitizeName ctor

-- DT runtime：只包含 prelude 里出现的运算与 show（与 TypedCodegen 的 helper 同名/同义）。
dtRuntime : String
dtRuntime =
  "let bi_add a b = a + b\n"
    ++ "let bi_sub a b = a - b\n"
    ++ "let bi_mul a b = a * b\n"
    ++ "let bi_div a b = if b = 0 then failwith \"division by zero\" else a / b\n"
    ++ "let bi_eq_int (a : int) (b : int) = a = b\n"
    ++ "let bi_neq_int (a : int) (b : int) = a <> b\n"
    ++ "let bi_eq_str (a : string) (b : string) = a = b\n"
    ++ "let bi_neq_str (a : string) (b : string) = a <> b\n"
    ++ "let bi_strFromInt (n : int) = string_of_int n\n"
    ++ "let bi_strLength (s : string) = String.length s\n"
    ++ "let bi_strUnpack (s : string) = List.init (String.length s) (fun i -> Char.code s.[i])\n"
    ++ "let bi_strPack (cs : int list) = String.init (List.length cs) (fun i -> Char.chr (List.nth cs i))\n"
    ++ "let bi_lt_int (a : int) (b : int) = a < b\n"
    ++ "let bi_le_int (a : int) (b : int) = a <= b\n"
    ++ "let bi_gt_int (a : int) (b : int) = a > b\n"
    ++ "let bi_ge_int (a : int) (b : int) = a >= b\n"
    ++ "let bi_concat a b = a ^ b\n"
    ++ "let bi_and a b = a && b\n"
    ++ "let bi_or a b = a || b\n"
    ++ "let dt_show_bool b = if b then \"True\" else \"False\"\n"
    ++ "let dt_show_string s =\n"
    ++ "  let buf = Buffer.create 16 in\n"
    ++ "  Buffer.add_char buf (Char.chr 34);\n"
    ++ "  String.iter (fun c ->\n"
    ++ "    let n = Char.code c in\n"
    ++ "    if n = 34 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 34))\n"
    ++ "    else if n = 92 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 92))\n"
    ++ "    else if n = 10 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"n\")\n"
    ++ "    else if n = 9 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"t\")\n"
    ++ "    else if n = 13 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"r\")\n"
    ++ "    else Buffer.add_char buf c) s;\n"
    ++ "  Buffer.add_char buf (Char.chr 34);\n"
    ++ "  Buffer.contents buf\n"

-- M19：`==` / `/=` 的跨类型特化（精化期已按实参类型重写成 `bi_eq_int` / `bi_eq_str`
-- 这类名字），以及 str* 内建。codegen 只做名字映射、不感知类型——M18.6 的
-- 「codegen 不感知判定来源」不被破坏。
globalRef : String -> Result String
globalRef name = case name of
  "True" => Ok "true"
  "False" => Ok "false"
  "+" => Ok "bi_add"
  "-" => Ok "bi_sub"
  "*" => Ok "bi_mul"
  "/" => Ok "bi_div"
  "==" => Ok "bi_eq_int"
  "/=" => Ok "bi_neq_int"
  "<" => Ok "bi_lt_int"
  "<=" => Ok "bi_le_int"
  ">" => Ok "bi_gt_int"
  ">=" => Ok "bi_ge_int"
  "++" => Ok "bi_concat"
  "&&" => Ok "bi_and"
  "||" => Ok "bi_or"
  "bi_eq_int" => Ok "bi_eq_int"
  "bi_neq_int" => Ok "bi_neq_int"
  "bi_eq_str" => Ok "bi_eq_str"
  "bi_neq_str" => Ok "bi_neq_str"
  "strFromInt" => Ok "bi_strFromInt"
  "strUnpack" => Ok "bi_strUnpack"
  "strPack" => Ok "bi_strPack"
  "strLength" => Ok "bi_strLength"
  _ => Ok (valueName name)

-- 零参构造子（True/False 之外的 user 构造子）作为普通值引用时，OCaml 里就是裸构造子；
-- 但只有 datas 表知道它是构造子，所以生成入口先查构造子表，再回落到 globalRef。
genGlobalRef : GenSt -> String -> Result (Pair String GenSt)
genGlobalRef st name = case lookupPair name (gsCtors st) of
  Just family => Ok (Pair (ctorOcamlName family name) st)
  Nothing => andThen (globalRef name) (\r => Ok (Pair r st))

-- ---------------------------------------------------------------
-- 变体类型声明（族 → OCaml type）
-- ---------------------------------------------------------------
--
-- 每个族生成 `type 'a t_F = C_F_C1 [of T1 * T2 ...] | ...`（永远带一个类型参数 'a）。
-- 字段类型渲染规则（DT 的运行时类型只有这几种）：
--   Int → int；String → string；Bool → bool；
--   族应用 F ... → 'a t_F（索引/类型实参全部丢掉，统一用族内固定的 'a）；
--   其它（类型变量、Type、类型别名等）→ 'a。
-- 这样任何字段都能被 'a 或具体类型容纳，一定可编译（-w -a 关掉未使用变量警告）。
ocamlFieldTy : List String -> Value -> String
ocamlFieldTy families v = case v of
  VNeutral n => case n of
    NGlobal g sp =>
      if g == "Int" then "int"
      else if g == "String" then "string"
      else if g == "Bool" then "bool" else if memName g families then "'a " ++ typeName g else "'a"
    _ => "'a"
  _ => "'a"

-- 从构造子的完整 Pi 类型项里按位置取出每个未擦除 binder 的域类型。
ctorFieldTys : List String -> List (Pair String Rig) -> Int -> Value -> List String
ctorFieldTys families [] lvl v = []
ctorFieldTys families ((Pair name rig) :: rest) lvl v = case v of
  VPi pname implicit _ dom clo =>
    let
      next = applyClosure clo (VNeutral (NVar pname lvl []))
    in if rigIsErased rig then ctorFieldTys families rest (lvl + 1) next
    else ocamlFieldTy families dom :: ctorFieldTys families rest (lvl + 1) next
  _ => []

ctorDeclText : String -> List String -> String
ctorDeclText name [] = name
ctorDeclText name ([t]) = name ++ " of " ++ t
ctorDeclText name ts = name ++ " of " ++ joinWith " * " ts

genCtorDecl : List String -> DtCtor -> Result String
genCtorDecl families c =
  Ok
    (ctorDeclText (ctorOcamlName (dtCtorFamily c) (dtCtorName c)) (ctorFieldTys families (dtCtorTelescope c) 0 (eval [] (dtCtorType c))))

genDataDecl : List String -> DtData -> Result String
genDataDecl families d =
  andThen (traverse (genCtorDecl families) (dtDataCtors d))
    (\cs => Ok ("'a " ++ typeName (dtDataName d) ++ " = " ++ ctorBodyText cs))

ctorBodyText : List String -> String
ctorBodyText [] = "|"
ctorBodyText cs = joinWith " | " cs

-- 族之间可能互相引用字段类型，统一放进一个 `type ... and ...` 递归组，声明顺序无关。
genTypeDecls : List DtData -> Result String
genTypeDecls datas = case datas of
  [] => Ok ""
  _ =>
    andThen (traverse (genDataDecl (map dtDataName datas)) datas)
      (\parts => Ok ("type " ++ joinWith "\nand " parts ++ "\n\n"))

-- ---------------------------------------------------------------
-- 项 → OCaml
-- ---------------------------------------------------------------
--
-- 生成状态：族名表、构造子 → 族表、fresh 变量计数（case 分支绑定子用去重名）。
-- binder 环境是「最近绑定在前」的 (OCaml 变量名, 是否擦除)，TVar 靠 index 解析。
data GenSt : Type where
  GenSt : List String -> List (Pair String String) -> Int -> GenSt

gsCtors (GenSt families ctors next) = ctors

gsNext (GenSt families ctors next) = next

gsPutNext (GenSt families ctors next) n = GenSt families ctors n

ctorTableOfData : DtData -> List (Pair String String)
ctorTableOfData d = map (\c => Pair (dtCtorName c) (dtCtorFamily c)) (dtDataCtors d)

ctorTableOf : List DtData -> List (Pair String String)
ctorTableOf [] = []
ctorTableOf (d :: rest) = append (ctorTableOfData d) (ctorTableOf rest)

mkGenSt : List DtData -> GenSt
mkGenSt datas = GenSt (map dtDataName datas) (ctorTableOf datas) 0

-- case 分支的绑定环境：全部 telescope binder 都进环境（擦除的用占位名 + True），
-- 顺序为 telescope 表面顺序的逆序；pattern 只保留未擦除的 fresh 名。
data AltEnv : Type where
  AltEnv : List (Pair String Rig) -> List String -> GenSt -> AltEnv

aeEnv (AltEnv env pats st) = env

aePats (AltEnv env pats st) = pats

aeSt (AltEnv env pats st) = st

altEnvGo : GenSt -> List (Pair String Rig) -> List (Pair String Rig) -> List String -> AltEnv
altEnvGo st env [] pats = AltEnv env (reverse pats) st
altEnvGo st env ((Pair name rig) :: rest) pats = if rigIsErased rig then altEnvGo st (Pair "" Rig0 :: env) rest pats
else
  let
    fresh = gsNext st
    nm = "dtb__" ++ strFromInt fresh
  in altEnvGo (gsPutNext st (fresh + 1)) (Pair nm Rig1 :: env) rest (nm :: pats)

altEnv : GenSt -> List (Pair String Rig) -> List (Pair String Rig) -> AltEnv
altEnv st outer tele = altEnvGo st outer tele []

genTerm : GenSt -> List (Pair String Rig) -> Term -> Result (Pair String GenSt)
genTerm st binders t = case t of
  TVar name i => case binderAt i binders of
    Just (Pair oc rig) =>
      if rigIsErased rig then Err ("DT: type-level binding `" ++ name ++ "` is used at runtime (M13 limitation)")
      else Ok (Pair oc st)
    Nothing => Err "DT: internal: unbound runtime variable"
  TGlobal name => genGlobalRef st name
  TInt n => Ok (Pair (strFromInt n) st)
  TStr s => Ok (Pair (ocamlString s) st)
  TBool b => Ok (Pair (boolText b) st)
  TIf c th el => andThen (genTerm st binders c) (\pc => case pc of
    Pair gc st1 => andThen (genTerm st1 binders th) (\pt => case pt of
      Pair gt st2 => andThen (genTerm st2 binders el) (\pe => case pe of
        Pair ge st3 => Ok (Pair ("(if " ++ gc ++ " then " ++ gt ++ " else " ++ ge ++ ")") st3)
      )
    )
  )
  TLam name rig body => if rigIsErased rig then andThen (genTerm st (Pair "" Rig0 :: binders) body) (\p => case p of
    Pair b st2 => Ok (Pair b st2)
  )
  else
    let
      ocName = sanitizeName name
    in andThen (genTerm st (Pair ocName Rig1 :: binders) body) (\p => case p of
      Pair b st2 => Ok (Pair ("(fun " ++ ocName ++ " -> " ++ b ++ ")") st2)
    )
  TApp f a rig => genApp st binders f a rig
  TCon c args => genConApp st binders c args
  TCase scrut alts => genCase st binders scrut alts
  TPi name implicit rig dom cod => Err "DT: a type is used at runtime (M13 limitation)"
  TType l => Err "DT: a type is used at runtime (M13 limitation)"
  TMeta m => Err ("DT: unsolved metavariable in runtime code" ++ showMetaHint m)

-- 应用：精化器可能把饱和的构造子应用表示成嵌套 `TApp (TApp (TCon c []) a) b`。
-- 这种形态必须先折叠成 `TCon c [a, b]`，否则 OCaml 侧会把它当成 curried 调用
-- （多变体构造子是 tupled 的，`C 1 2` 类型不对）。
genApp : GenSt -> List (Pair String Rig) -> Term -> Term -> Rig -> Result (Pair String GenSt)
genApp st binders f a rig = if rigIsErased rig then genTerm st binders f
else case flattenConApp (TApp f a rig) of
  Just (Pair c args) => genConApp st binders c args
  Nothing => andThen (genTerm st binders f) (\pf => case pf of
    Pair fs st1 => andThen (genTerm st1 binders a) (\pa => case pa of
      Pair at st2 => Ok (Pair ("(" ++ fs ++ " " ++ at ++ ")") st2)
    )
  )

-- OCaml 的多参变体构造子是 **tupled**（`C of t1 * t2` 写作 `C (a, b)`），
-- 不是 curried，所以多实参必须用逗号包成一个元组。
conAppText : String -> List String -> String
conAppText name [] = name
conAppText name ([a]) = "(" ++ name ++ " " ++ a ++ ")"
conAppText name args = "(" ++ name ++ " (" ++ joinWith ", " args ++ "))"

genConArgs : GenSt -> List (Pair String Rig) -> List (Pair Term Rig) -> Result (Pair (List String) GenSt)
genConArgs st binders [] = Ok (Pair [] st)
genConArgs st binders ((Pair arg rig) :: rest) = if rigIsErased rig then genConArgs st binders rest
else andThen (genTerm st binders arg) (\p => case p of
  Pair text st2 => andThen (genConArgs st2 binders rest) (\q => case q of
    Pair texts st3 => Ok (Pair (text :: texts) st3)
  )
)

genConApp : GenSt -> List (Pair String Rig) -> String -> List (Pair Term Rig) -> Result (Pair String GenSt)
genConApp st binders c args = case lookupPair c (gsCtors st) of
  Nothing => Err ("DT: internal: unknown constructor " ++ c)
  Just family => andThen (genConArgs st binders args) (\p => case p of
    Pair argTexts st2 => Ok (Pair (conAppText (ctorOcamlName family c) argTexts) st2)
  )

hasFallbackAlt : List CaseAlt -> Bool
hasFallbackAlt [] = False
hasFallbackAlt (alt :: rest) = if caseAltName alt == "" then True else hasFallbackAlt rest

armPatternText : String -> List String -> String
armPatternText cname [] = cname
armPatternText cname pats = cname ++ " (" ++ joinWith ", " pats ++ ")"

genArm : GenSt -> List (Pair String Rig) -> CaseAlt -> Result (Pair String GenSt)
genArm st outer alt = if caseAltName alt == "" then
  let
    bound = altEnv st outer (caseAltBinders alt)
  in andThen (genTerm (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
    Pair b st2 => Ok (Pair ("  | _ -> " ++ b ++ "\n") st2)
  )
else case lookupPair (caseAltName alt) (gsCtors st) of
  Nothing => Err ("DT: internal: unknown constructor " ++ caseAltName alt)
  Just family =>
    let
      bound = altEnv st outer (caseAltBinders alt)
    in andThen (genTerm (aeSt bound) (aeEnv bound) (caseAltBody alt)) (\p => case p of
      Pair b st2 =>
        let
          cname = ctorOcamlName family (caseAltName alt)
          patText = armPatternText cname (aePats bound)
        in Ok (Pair ("  | " ++ patText ++ " -> " ++ b ++ "\n") st2)
    )

genArms : GenSt -> List (Pair String Rig) -> List CaseAlt -> Result (Pair String GenSt)
genArms st binders [] = Ok (Pair "" st)
genArms st binders (alt :: rest) = andThen (genArm st binders alt) (\p => case p of
  Pair arm st2 => andThen (genArms st2 binders rest) (\q => case q of
    Pair arms st3 => Ok (Pair (arm ++ arms) st3)
  )
)

genCase : GenSt -> List (Pair String Rig) -> Term -> List CaseAlt -> Result (Pair String GenSt)
genCase st binders scrut alts = andThen (genTerm st binders scrut) (\p => case p of
  Pair scrutText st1 => andThen (genArms st1 binders alts) (\q => case q of
    Pair arms st2 =>
      let
        fallback =
          if hasFallbackAlt alts then "" else "  | _ -> failwith \"DT: impossible branch\"\n"
      in Ok (Pair ("(match " ++ scrutText ++ " with\n" ++ arms ++ fallback ++ ")") st2)
  )
)

-- ---------------------------------------------------------------
-- 分组 → OCaml 定义
-- ---------------------------------------------------------------
joinWith : String -> List String -> String
joinWith sep [] = ""
joinWith sep ([x]) = x
joinWith sep (x :: rest) = x ++ sep ++ joinWith sep rest

genGroupDef : GenSt -> DtDef -> Result (Pair String GenSt)
genGroupDef st d = andThen (genTerm st [] (dtDefBody d)) (\p => case p of
  Pair body st2 => Ok (Pair (valueName (dtDefName d) ++ " = " ++ body) st2)
)

genGroupBodies : GenSt -> List DtDef -> Result (Pair (List String) GenSt)
genGroupBodies st [] = Ok (Pair [] st)
genGroupBodies st (d :: rest) = andThen (genGroupDef st d) (\p => case p of
  Pair def st2 => andThen (genGroupBodies st2 rest) (\q => case q of
    Pair defs st3 => Ok (Pair (def :: defs) st3)
  )
)

-- 单函数 SCC 且不引用自身时用 let；多函数 SCC（互递归）或自递归才用 let rec。
groupNeedsRec : List (Pair String (List String)) -> List DtDef -> Bool
groupNeedsRec adj [] = False
groupNeedsRec adj ([d]) = memName (dtDefName d) (neighborsOf adj (dtDefName d))
groupNeedsRec adj group = True

genGroup : List (Pair String (List String)) -> GenSt -> List DtDef -> Result (Pair String GenSt)
genGroup adj st group = andThen (genGroupBodies st group) (\p => case p of
  Pair defs st2 =>
    Ok
      (Pair ((if groupNeedsRec adj group then "let rec " else "let ") ++ joinWith "\nand " defs) st2)
)

genGroups : List (Pair String (List String)) -> GenSt -> List (List DtDef) -> Result (Pair (List String) GenSt)
genGroups adj st [] = Ok (Pair [] st)
genGroups adj st (g :: rest) = andThen (genGroup adj st g) (\p => case p of
  Pair text st2 => andThen (genGroups adj st2 rest) (\q => case q of
    Pair texts st3 => Ok (Pair (text :: texts) st3)
  )
)

-- main 的展示方式（类型 force 后必须是 Int/String/Bool）。
mainShow : List (Pair String Term) -> Term -> Result (Pair String String)
mainShow table tyTerm = case force table [] defaultFuel (eval [] tyTerm) of
  VNeutral n => case n of
    NGlobal g [] => mainShowForName g
    _ => mainShowErr
  _ => mainShowErr

-- M21：main : IO a 的执行（对齐 HM ioRunExpr）。先归约 main 到 IO 构造子
-- （`MkIO f`），再对世界令牌 0 应用 `f 0` 并继续归约。IO 的识别按 main 的
-- **类型**（族名 `IO`，含 `Base.IO.IO` 这类带模块前缀的名字）。
lastName : String -> String
lastName name = case splitLastDot (splitOnDot name) of
  Pair rev base => base

-- 把 `IO a` 拆成内层类型 `a`；不是 `IO ...` 则 Nothing。
ioResultTy : Term -> Maybe Term
ioResultTy t = case t of
  TApp fn arg _ => case fn of
    TGlobal g => if lastName g == "IO" then Just arg else Nothing
    _ => Nothing
  _ => Nothing

-- 找 IO 族的（族名, 构造子名），用于生成 `match main with C_IO_MkIO f -> f 0`。
ioCtorOf : List DtData -> Maybe (Pair String String)
ioCtorOf [] = Nothing
ioCtorOf (d :: rest) = if lastName (dtDataName d) == "IO" then firstCtorOf d else ioCtorOf rest

firstCtorOf : DtData -> Maybe (Pair String String)
firstCtorOf d = case dtDataCtors d of
  c :: _ => Just (Pair (dtDataName d) (dtCtorName c))
  [] => Nothing

mainShowForName : String -> Result (Pair String String)
mainShowForName g = case g of
  "Int" => Ok (Pair "string_of_int" "int")
  "String" => Ok (Pair "dt_show_string" "string")
  "Bool" => Ok (Pair "dt_show_bool" "bool")
  _ => mainShowErr

mainShowErr : Result (Pair String String)
mainShowErr = Err "DT: main must return Int, String or Bool (M13 limitation)"

-- 生成主体（不含 main 钩子）：类型声明 + 按 SCC 顺序的函数定义。
-- check / compile 共用这一份，保证两者的判定完全一致。
genProgramBody : Pair (List DtData) (List DtDef) -> Result (Pair String (Pair (List DtDef) (List (Pair String Term))))
genProgramBody program =
  let
    datas = firstOf program
    defs = secondOf program
  in andThen (prepareDtProgram program) (\p => case p of
    Pair runtime groups => andThen (genTypeDecls datas) (\typeText => andThen (genGroups (depAdjacency runtime) (mkGenSt datas) groups) (\q => case q of
      Pair bodies st2 =>
        Ok
          (Pair (dtRuntime ++ "\n" ++ typeText ++ joinWith "\n\n" bodies) (Pair runtime (defTable defs)))
    )
    )
  )

generateDtProgram : Pair (List DtData) (List DtDef) -> Bool -> Result String
generateDtProgram program printResult = andThen (genProgramBody program) (\p => case p of
  Pair bodyText (Pair runtime table) => case findDtDef "main" runtime of
    Nothing => Err "DT: no main definition"
    Just mainDef =>
      let
        mainTy = dtDefType mainDef
        mainRef = valueName "main"
      in case ioResultTy mainTy of
        Just innerTy => genDtHook bodyText table innerTy (ioRunText program mainRef) printResult
        Nothing => genDtHook bodyText table mainTy mainRef printResult
)

-- main 钩子：`mainExpr` 是运行时求 main 值的表达式（普通 main 直接是 `v_main`；
-- main : IO a 则是 `match v_main with C_IO_MkIO f -> f 0`），按类型 `tyTerm` 选展示函数。
genDtHook : String -> List (Pair String Term) -> Term -> String -> Bool -> Result String
genDtHook bodyText table tyTerm mainExpr printResult = andThen (mainShow table tyTerm) (\showPair => case showPair of
  Pair showFn kind =>
    let
      hook =
        if printResult then "let () = print_endline (" ++ showFn ++ " (" ++ mainExpr ++ "))\n"
        else "let () = ignore (" ++ mainExpr ++ ")\n"
    in Ok (bodyText ++ "\n" ++ hook)
)

-- `match v_main with C_IO_MkIO f -> f 0`（找不到 IO 构造子时回退为原样引用）。
ioRunText : Pair (List DtData) (List DtDef) -> String -> String
ioRunText program mainRef = case ioCtorOf (firstOf program) of
  Just (Pair family ctor) =>
    "match " ++ mainRef ++ " with " ++ ctorOcamlName family ctor ++ " f -> f 0"
  Nothing => mainRef

-- `vuna check --dt` 跑一遍完整生成主体（丢弃产物），保证「能 check 就能 compile」：
-- 擦除检查、构造子引用、SCC 分组、类型声明与函数生成都在这一步走到。
-- main 的存在与返回类型只在 generate 阶段要求，这样没有 main 的库文件也能 check。
checkDtProgram : Pair (List DtData) (List DtDef) -> Result Int
checkDtProgram program = andThen (genProgramBody program) (\_ => Ok 0)
