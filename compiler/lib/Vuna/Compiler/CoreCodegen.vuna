module Vuna.Compiler.CoreCodegen (checkDtProgram, generateDtProgram) where

-- Vuna.Compiler.CoreCodegen：M13 的 DT 擦除与 OCaml 生成。
--
-- 与 TypedCodegen（HM 路径）完全独立：只依赖 Vuna.Compiler.Core / Vuna.Compiler.Elab，
-- 自带最小 runtime（bi_* 与 show helper），不引用 HM codegen 的内部 helper。
--
-- 擦除规则（由精化器在项上标好的标志驱动）：
-- - TLam erased = True 的绑定不生成参数；TApp 实参 erased = True 时不生成实参；
-- - 类型级定义（类型 force 后是宇宙）整体不生成运行时定义；
-- - 运行时项里出现被擦除绑定 / 类型级定义 / 类型本身 → 报错（M16 做完整擦除分析）。

import Vuna.Compiler.Common
import Vuna.Compiler.Core
import Vuna.Compiler.Elab

-- ---------------------------------------------------------------
-- 预处理：分区（类型级 / 运行时）、擦除检查、依赖拓扑排序
-- ---------------------------------------------------------------

defTable : List DtDef -> List (Pair String Term)
defTable Nil = Nil
defTable (Cons d rest) = Cons (Pair (dtDefName d) (dtDefBody d)) (defTable rest)

findDtDef : String -> List DtDef -> Maybe DtDef
findDtDef name Nil = Nothing
findDtDef name (Cons d rest) =
  if dtDefName d == name then Just d else findDtDef name rest

isTypeLevelDef : List (Pair String Term) -> DtDef -> Bool
isTypeLevelDef table d =
  isTypeValue (force table Nil defaultFuel (eval Nil (dtDefType d)))

partitionDefs : List (Pair String Term) -> List DtDef -> Pair (List DtDef) (List String)
partitionDefs table defs = partitionDefsGo table defs Nil Nil

partitionDefsGo : List (Pair String Term) -> List DtDef -> List DtDef -> List String -> Pair (List DtDef) (List String)
partitionDefsGo table Nil runtime typeNames = Pair (reverse runtime) (reverse typeNames)
partitionDefsGo table (Cons d rest) runtime typeNames =
  if isTypeLevelDef table d then
    partitionDefsGo table rest runtime (Cons (dtDefName d) typeNames)
  else partitionDefsGo table rest (Cons d runtime) typeNames

checkAllErasure : List String -> List DtDef -> Result Int
checkAllErasure typeNames Nil = Ok 0
checkAllErasure typeNames (Cons d rest) =
  andThen (checkErasure typeNames Nil (dtDefBody d)) (\_ => checkAllErasure typeNames rest)

-- binders：最近绑定在前（名字 + 是否擦除）。
checkErasure : List String -> List (Pair String Bool) -> Term -> Result Int
checkErasure typeNames binders t =
  case t of
    TVar name i =>
      case binderAt i binders of
        Just (Pair n erased) =>
          if erased then
            Err ("DT: type-level binding `" ++ name ++ "` is used at runtime (M13 limitation)")
          else Ok 0
        Nothing => Err ("DT: internal: unbound runtime variable " ++ name)
    TGlobal name =>
      if memName name typeNames then
        Err ("DT: type-level name `" ++ name ++ "` is used at runtime (M13 limitation)")
      else Ok 0
    TType n => Err "DT: a type is used at runtime (M13 limitation)"
    TPi name implicit dom cod => Err "DT: a type is used at runtime (M13 limitation)"
    TMeta m => Err "DT: unsolved metavariable in runtime code"
    TLam name erased body => checkErasure typeNames (Cons (Pair name erased) binders) body
    TApp f a erased =>
      if erased then checkErasure typeNames binders f
      else andThen (checkErasure typeNames binders f) (\_ => checkErasure typeNames binders a)
    TInt n => Ok 0
    TStr s => Ok 0
    TBool b => Ok 0
    TIf c th el =>
      andThen (checkErasure typeNames binders c) (\_ =>
        andThen (checkErasure typeNames binders th) (\_ => checkErasure typeNames binders el))

binderAt : Int -> List (Pair String Bool) -> Maybe (Pair String Bool)
binderAt i Nil = Nothing
binderAt i (Cons b rest) = if i <= 0 then Just b else binderAt (i - 1) rest

-- 依赖：运行时会用到的 TGlobal（擦除实参里的不算）。
termDepsInto : List String -> List String -> Term -> List String
termDepsInto runtimeNames acc t =
  case t of
    TGlobal name => if memName name runtimeNames then addName name acc else acc
    TVar name i => acc
    TMeta m => acc
    TType n => acc
    TPi name implicit dom cod => acc
    TLam name erased body => termDepsInto runtimeNames acc body
    TApp f a erased =>
      if erased then termDepsInto runtimeNames acc f
      else termDepsInto runtimeNames (termDepsInto runtimeNames acc f) a
    TInt n => acc
    TStr s => acc
    TBool b => acc
    TIf c th el =>
      termDepsInto runtimeNames (termDepsInto runtimeNames (termDepsInto runtimeNames acc c) th) el

addName : String -> List String -> List String
addName name Nil = Cons name Nil
addName name (Cons x rest) = if x == name then Cons x rest else Cons x (addName name rest)

runtimeNamesOf : List DtDef -> List String
runtimeNamesOf Nil = Nil
runtimeNamesOf (Cons d rest) = Cons (dtDefName d) (runtimeNamesOf rest)

lookupDtDef : List DtDef -> String -> Maybe DtDef
lookupDtDef defs name = findDtDef name defs

topoSortDefs : List DtDef -> Result (List DtDef)
topoSortDefs defs =
  let runtimeNames = runtimeNamesOf defs
  in andThen (visitMany defs runtimeNames Nil Nil Nil) (\p =>
       case p of
         Pair visited order => Ok (reverse order))

-- visitMany：按依赖顺序（依赖先）产出定义。
visitMany : List DtDef -> List String -> List String -> List String -> List DtDef -> Result (Pair (List String) (List DtDef))
visitMany defs Nil stack visited order = Ok (Pair visited order)
visitMany defs (Cons name rest) stack visited order =
  andThen (visitOne defs name stack visited order) (\p =>
    case p of
      Pair visited2 order2 => visitMany defs rest stack visited2 order2)

visitOne : List DtDef -> String -> List String -> List String -> List DtDef -> Result (Pair (List String) (List DtDef))
visitOne defs name stack visited order =
  if memName name visited then Ok (Pair visited order)
  else if memName name stack then
    Err ("DT: definition " ++ name ++ " is recursive (not supported until M14/M16)")
  else
    case lookupDtDef defs name of
      Nothing => Ok (Pair (Cons name visited) order)
      Just d =>
        andThen (visitMany defs (termDepsInto (runtimeNamesOf defs) Nil (dtDefBody d)) (Cons name stack) visited order) (\p =>
          case p of
            Pair visited2 order2 => Ok (Pair (Cons name visited2) (Cons d order2)))

-- check / compile 共用的准备阶段：分区 + 擦除检查 + 拓扑排序。
prepareDtProgram : List DtDef -> Result (Pair (List DtDef) (List String))
prepareDtProgram defs =
  let table = defTable defs
  in case partitionDefs table defs of
       Pair runtime typeNames =>
         andThen (checkAllErasure typeNames runtime) (\_ =>
           andThen (topoSortDefs runtime) (\sorted => Ok (Pair sorted typeNames)))

-- `vuna check --dt` 也跑擦除检查，保证「能 check 就能 compile」。
checkDtProgram : List DtDef -> Result Int
checkDtProgram defs =
  andThen (prepareDtProgram defs) (\p => Ok 0)

-- ---------------------------------------------------------------
-- OCaml 生成
-- ---------------------------------------------------------------

sanitizeChar : Int -> List Int
sanitizeChar c =
  if c == 46 then Cons 95 (Cons 100 Nil)
  else if c == 95 then Cons 95 (Cons 117 Nil)
  else if c == 39 then Cons 95 (Cons 112 Nil)
  else Cons c Nil

sanitizeName : String -> String
sanitizeName name = strPack (concatMap sanitizeChar (strUnpack name))

ocamlPad3 : String -> String
ocamlPad3 s =
  if strLength s == 1 then "00" ++ s
  else if strLength s == 2 then "0" ++ s
  else s

ocamlEscapeChar : Int -> List Int
ocamlEscapeChar c =
  if c == 34 then Cons 92 (Cons 34 Nil)
  else if c == 92 then Cons 92 (Cons 92 Nil)
  else if c == 10 then Cons 92 (Cons 110 Nil)
  else if c == 9 then Cons 92 (Cons 116 Nil)
  else if c == 13 then Cons 92 (Cons 114 Nil)
  else if c >= 32 && c <= 126 then Cons c Nil
  else strUnpack ("\\" ++ ocamlPad3 (strFromInt c))

ocamlString : String -> String
ocamlString s = "\"" ++ strPack (concatMap ocamlEscapeChar (strUnpack s)) ++ "\""

valueName : String -> String
valueName name = "v_" ++ sanitizeName name

-- DT runtime：只包含 prelude 里出现的运算与 show（与 TypedCodegen 的 helper 同名/同义）。
dtRuntime : String
dtRuntime =
  "let bi_add a b = a + b\n"
  ++ "let bi_sub a b = a - b\n"
  ++ "let bi_mul a b = a * b\n"
  ++ "let bi_div a b = if b = 0 then failwith \"division by zero\" else a / b\n"
  ++ "let bi_eq_int (a : int) (b : int) = a = b\n"
  ++ "let bi_neq_int (a : int) (b : int) = a <> b\n"
  ++ "let bi_lt_int (a : int) (b : int) = a < b\n"
  ++ "let bi_le_int (a : int) (b : int) = a <= b\n"
  ++ "let bi_gt_int (a : int) (b : int) = a > b\n"
  ++ "let bi_ge_int (a : int) (b : int) = a >= b\n"
  ++ "let bi_concat a b = a ^ b\n"
  ++ "let bi_and a b = a && b\n"
  ++ "let bi_or a b = a || b\n"
  ++ "let dt_show_bool b = if b then \"True\" else \"False\"\n"
  ++ "let dt_show_string s =\n"
  ++ "  let buf = Buffer.create 16 in\n"
  ++ "  Buffer.add_char buf (Char.chr 34);\n"
  ++ "  String.iter (fun c ->\n"
  ++ "    let n = Char.code c in\n"
  ++ "    if n = 34 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 34))\n"
  ++ "    else if n = 92 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ String.make 1 (Char.chr 92))\n"
  ++ "    else if n = 10 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"n\")\n"
  ++ "    else if n = 9 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"t\")\n"
  ++ "    else if n = 13 then Buffer.add_string buf (String.make 1 (Char.chr 92) ^ \"r\")\n"
  ++ "    else Buffer.add_char buf c) s;\n"
  ++ "  Buffer.add_char buf (Char.chr 34);\n"
  ++ "  Buffer.contents buf\n"

globalRef : String -> Result String
globalRef name =
  case name of
    "True" => Ok "true"
    "False" => Ok "false"
    "+" => Ok "bi_add"
    "-" => Ok "bi_sub"
    "*" => Ok "bi_mul"
    "/" => Ok "bi_div"
    "==" => Ok "bi_eq_int"
    "/=" => Ok "bi_neq_int"
    "<" => Ok "bi_lt_int"
    "<=" => Ok "bi_le_int"
    ">" => Ok "bi_gt_int"
    ">=" => Ok "bi_ge_int"
    "++" => Ok "bi_concat"
    "&&" => Ok "bi_and"
    "||" => Ok "bi_or"
    _ => Ok (valueName name)

genTerm : Term -> Result String
genTerm t =
  case t of
    TVar name i => Ok (sanitizeName name)
    TGlobal name => globalRef name
    TInt n => Ok (strFromInt n)
    TStr s => Ok (ocamlString s)
    TBool b => Ok (if b then "true" else "false")
    TIf c th el =>
      andThen (genTerm c) (\gc =>
        andThen (genTerm th) (\gt =>
          andThen (genTerm el) (\ge => Ok ("(if " ++ gc ++ " then " ++ gt ++ " else " ++ ge ++ ")"))))
    TLam name erased body =>
      andThen (genTerm body) (\b =>
        if erased then Ok b else Ok ("(fun " ++ sanitizeName name ++ " -> " ++ b ++ ")"))
    TApp f a erased =>
      if erased then genTerm f
      else
        andThen (genTerm f) (\fs =>
          andThen (genTerm a) (\argText => Ok ("(" ++ fs ++ " " ++ argText ++ ")")))
    TPi name implicit dom cod => Err "DT: a type is used at runtime (M13 limitation)"
    TType n => Err "DT: a type is used at runtime (M13 limitation)"
    TMeta m => Err "DT: unsolved metavariable in runtime code"

genDef : DtDef -> Result String
genDef d =
  andThen (genTerm (dtDefBody d)) (\body =>
    Ok ("let " ++ valueName (dtDefName d) ++ " = " ++ body))

genDefs : List DtDef -> Result (List String)
genDefs Nil = Ok Nil
genDefs (Cons d rest) =
  andThen (genDef d) (\g =>
    andThen (genDefs rest) (\gs => Ok (Cons g gs)))

joinWith : String -> List String -> String
joinWith sep Nil = ""
joinWith sep (Cons x Nil) = x
joinWith sep (Cons x rest) = x ++ sep ++ joinWith sep rest

-- main 的展示方式（类型 force 后必须是 Int/String/Bool）。
mainShow : List (Pair String Term) -> Term -> Result (Pair String String)
mainShow table tyTerm =
  case force table Nil defaultFuel (eval Nil tyTerm) of
    VNeutral n =>
      case n of
        NGlobal g Nil => mainShowForName g
        _ => mainShowErr
    _ => mainShowErr

mainShowForName : String -> Result (Pair String String)
mainShowForName g =
  case g of
    "Int" => Ok (Pair "string_of_int" "int")
    "String" => Ok (Pair "dt_show_string" "string")
    "Bool" => Ok (Pair "dt_show_bool" "bool")
    _ => mainShowErr

mainShowErr : Result (Pair String String)
mainShowErr = Err "DT: main must return Int, String or Bool (M13 limitation)"

generateDtProgram : List DtDef -> Bool -> Result String
generateDtProgram defs printResult =
  andThen (prepareDtProgram defs) (\p =>
    case p of
      Pair sorted typeNames =>
        andThen (genDefs sorted) (\bodies =>
          case findDtDef "main" sorted of
            Nothing => Err "DT: no main definition"
            Just mainDef =>
              andThen (mainShow (defTable defs) (dtDefType mainDef)) (\showPair =>
                case showPair of
                  Pair showFn kind =>
                    let mainRef = valueName "main"
                        hook =
                          if printResult then
                            "let () = print_endline (" ++ showFn ++ " (" ++ mainRef ++ "))\n"
                          else "let () = ignore (" ++ mainRef ++ ")\n"
                        body = joinWith "\n\n" bodies
                    in Ok (dtRuntime ++ "\n" ++ body ++ "\n" ++ hook))))
