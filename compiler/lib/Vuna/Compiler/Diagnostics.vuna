module Vuna.Compiler.Diagnostics
  ( module Base.Nat
  , module Base.Vec
  , module Vuna.Compiler.Common
  , module Vuna.Compiler.Diagnostics.Cg
  , module Vuna.Compiler.Diagnostics.Ic
  , module Vuna.Compiler.Diagnostics.Tc
  ) where

-- Vuna.Compiler.Diagnostics：错误码体系门面（M30 B19 拆分后保留原名字集合）。
--
-- 把诊断的「标识 + 模板 + arity」从「字符串字面量 + 就近 `-- @code` 注释」收拢为
-- **域枚举 + 构造子携带模板**。三个不变量：
--
-- 1. **arity 编译期锁定**（路 A）：`TcErr : Nat -> Type`，构造子的索引即模板插值个数
--    （`UnknownName : String -> TcErr (Succ Zero)` = arity 1）。throw 点给 `Vec n String`，
--    长度由类型 unify 锁定——arity 拼错**编译失败**。`n` 隐式（Rig0），运行时零开销。
-- 2. **构造子 = 唯一真源**：每个构造子携带自己的模板（String payload，占位符 `<0>` `<1>`…）
--    + arity（类型索引）+ code（`tcCode` 派生）。模板/arity/code 一处声明，永不漂移。
--    渲染用 `Base.Vec.substTemplate`。
-- 3. **`tcAll`/`cgAll` = 文档遍历源**：同构 `List TcEntry`/`CgEntry`（code + 模板 + 说明），
--    `gen-errors` 遍历它渲染 `docs/.generated/errors.md`，不再扫 `-- @code` 注释。
--
-- 约定：
-- - 符号语义稳定、**只增不删**；同语义多处共享一个构造子（不再「同规则不同码」）。
-- - 一个码只承载**一种**语义。旧 `TC_OpOnlyIntString` / `TC_CtorError` 各自混了两种消息，
--   已拆开（`OpOnlyIntString` / `NotTraitMethod` / `OpNotDefinedFor`；
--   `CtorWrongIndices` / `CtorError`）。
-- - 占位符 `<k>` 每个只出现一次（`substTemplate` 按序号单次替换）；需要同一实参出现两处时
--   用两个序号并传两次（如 `WhereNeedsSig`）。
-- - `DT: internal:`（编译器内部不变量）不占符号，仍走裸字符串，不经本模块。
-- - 旧 `DT: ` 消息前缀已删除（`[CODE]` 已承载阶段信息）。
--
-- 分层（M30 B19）：本门面只做**整模块重导出**，实现按域拆到
-- `Diagnostics.Common`（共享拼装 helper）、`Diagnostics.Tc`（TC_）、`Diagnostics.Cg`（CG_）；
-- 对外名字集合与拆分前逐项一致，调用点零改动。
-- 本模块是**编译器侧**真源，进 seed（被 `vuna check .` 自检）。根包 Lint/Diagnostics 与
-- Frontend/Diagnostics 单向 import 本模块；compiler 永不 import 根包。
import Vuna.Compiler.Common
import Base.Nat
import Base.Vec
import Vuna.Compiler.Diagnostics.Cg as Cg
import Vuna.Compiler.Diagnostics.Ic as Ic
import Vuna.Compiler.Diagnostics.Tc as Tc
