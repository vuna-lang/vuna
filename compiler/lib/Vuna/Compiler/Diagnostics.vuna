cgCode : {n : Nat} -> CgErr n -> String
cgCode DependencyCycle = "CG_DependencyCycle"
cgCode InterpCannotExecuteEffects = "CG_InterpCannotExecuteEffects"
cgCode MainNotValue = "CG_MainNotValue"
cgCode MainReturnType = "CG_MainReturnType"
cgCode NoMain = "CG_NoMain"
cgCode TypeUsedAtRuntime = "CG_TypeUsedAtRuntime"
cgCode (AxiomAtRuntime _) = "CG_AxiomAtRuntime"
cgCode (ListBridgeRequired _) = "CG_ListBridgeRequired"
cgCode (RecursiveValueDefinition _) = "CG_RecursiveValueDefinition"
cgCode (TypeLevelBindingRuntime _) = "CG_TypeLevelBindingRuntime"
cgCode (TypeLevelNameRuntime _) = "CG_TypeLevelNameRuntime"
cgCode (UnsolvedMetavarRuntime _) = "CG_UnsolvedMetavarRuntime"

-- ---------------------------------------------------------------
-- 模板（构造子 payload，占位符 `<0>`/`<1>`；已去掉旧 `DT: ` 前缀）
-- ---------------------------------------------------------------
tcTemplate : {n : Nat} -> TcErr n -> String
tcTemplate BoolCaseRestriction = "case on Bool only accepts True / False / variable patterns (M19)"
tcTemplate BranchAfterCatchAll = "this branch is unreachable: it follows a catch-all branch"
tcTemplate CaseBranchTooFewArgs = "case branch has too few arguments for its constructor"
tcTemplate CatchAllNotLast = "the catch-all branch must be the last one"
tcTemplate ClauseTooManyPatterns = "clause has more patterns than the function arity"
tcTemplate DataKindArrows =
  "the kind of a data declaration must be a chain of arrows ending in Type"
tcTemplate DefFewerParams = "definition has fewer parameters than its signature"
tcTemplate DefMoreParams = "definition has more parameters than its signature"
tcTemplate DefParamsMustBeVars = "definition parameters must be variables (M13)"
tcTemplate DoUnsupported = "do blocks are not supported yet (M19)"
tcTemplate DuplicateCtorInCase = "duplicate constructor in case"
tcTemplate FunctionNoClauses = "function has no clauses"
tcTemplate HoleNoExpectedType = "cannot infer the type of a hole; give it an expected type"
tcTemplate ImplicitParamKind = "implicit parameters must be types or inductive families (M15)"
tcTemplate ImpossibleBranchEmptyCtx =
  "this branch is impossible (its context contains an empty inductive family)"
tcTemplate ImpossibleBranchIndex = "this branch is impossible (index constraints are unsatisfiable)"
tcTemplate IndexFuel = "index unification ran out of reduction fuel"
tcTemplate InstanceAnnotationWrongUse =
  "@instance can only be used with a trait method (write `method @instance`)"
tcTemplate InstanceHeadNotApp = "instance head must be an interface application (e.g. Show Int)"
tcTemplate InstanceContextNotDict =
  "instance context item must be a single-parameter interface application (e.g. Eq a)"
tcTemplate InstanceMissingMethod = "instance is missing an implementation for an interface method"
tcTemplate InterfaceOneParam = "interfaces must have exactly one parameter (M15 limitation)"
tcTemplate IntStringCaseNeedsFallback =
  "case on Int / String needs a variable or wildcard branch as fallback (M19)"
tcTemplate IntStringCaseRestriction =
  "case on Int / String only accepts literals / variable patterns (M19)"
tcTemplate InvalidArrowType = "invalid arrow type"
tcTemplate LambdaNoSignature = "cannot infer the type of a lambda; add a signature"
tcTemplate LambdaTooManyParams = "lambda has more parameters than the expected function type"
tcTemplate LetBindingPattern = "let bindings must be simple names or wildcards (M19)"
tcTemplate NestedPatterns = "nested patterns must be constructor patterns (M19)"
tcTemplate NotInductiveFamily = "case scrutinee is not an inductive family"
tcTemplate OnlyCtorPatterns = "only constructor patterns are supported in case (M14)"
tcTemplate PatternFuel = "pattern matrix recursion ran out of fuel"
tcTemplate RecordFieldAccessUnsupported = "record field access is not supported yet (M15)"
tcTemplate RecordsUnsupported = "records are not supported yet (M15)"
tcTemplate RecordUpdateUnsupported = "record update is not supported yet (M15)"
tcTemplate TooManyArgs = "too many arguments (not a function)"
tcTemplate TypeLevelArg = "Type needs exactly one non-negative level (or none)"
tcTemplate TypeMismatchCaseCount = "type mismatch: case branches differ in number"
tcTemplate TypeMismatchCtorArity = "type mismatch: constructor arguments differ in length"
tcTemplate UniverseLevelNonNegative = "universe level must be non-negative"
tcTemplate (AxiomWithDefinition _) = "axiom `<0>` cannot have a definition"
tcTemplate (BranchTooManyArgs _) = "branch for constructor <0> has too many arguments"
tcTemplate (CannotProveTermination _) = "cannot prove termination of <0>"
tcTemplate (CannotRedefineBuiltin _) = "cannot redefine builtin <0>"
tcTemplate (CannotSolveMetavar _) =
  "cannot solve metavariable ?<0> (solution would escape its scope)"
tcTemplate (CannotSolveHigherOrder _) =
  "cannot solve higher-order metavariable ?<0> (M15 limitation)"
tcTemplate (CannotSolveOccurs _) = "cannot solve metavariable ?<0> (occurs check)"
tcTemplate (TypeMismatchCaseVars _) =
  "type mismatch: case branch <0> binds a different number of variables"
tcTemplate (DuplicateInstance _) = "duplicate instance <0>"
tcTemplate (InstanceContextMissing _) = "instance context cannot be satisfied: <0>"
tcTemplate (OverlappingInstances _) = "overlapping instance <0>"
tcTemplate (DuplicateSignature _) = "duplicate signature for <0>"
tcTemplate (ExpectedSignature _) = "expected a type signature for <0>"
tcTemplate (ExpectedType _) = "expected a type, but this expression has type <0>"
tcTemplate (EqRequiresEvidence _) =
  "cannot use == or /= on values of type <0>: provide an Eq instance (or derive Eq); the Eq trait must be in scope"
tcTemplate (InstanceNotTrait _) = "instance <0> is not an instance of a trait"
tcTemplate (InstanceUnknownMethod _) = "instance has unknown method <0>"
tcTemplate (NeedsTwoArgs _) = "`<0>` needs exactly two arguments"
tcTemplate (NoInstanceFound _) = "no instance found for <0>"
tcTemplate (NotExhaustive _) = "case is not exhaustive: missing <0>"
tcTemplate (RedundantCtorBranch cname) =
  "redundant constructor branch: `" ++ cname ++ "` is already covered by an earlier branch"
tcTemplate (RedundantLiteralBranch lit) =
  "redundant literal branch: " ++ lit ++ " is already covered by an earlier branch"
tcTemplate (SignatureNoDef _) = "signature for <0> has no definition"
tcTemplate (UnknownInterface _) = "unknown interface <0> in instance head"
tcTemplate (UnknownName _) = "unknown name <0>"
tcTemplate (UnknownNamedInstance _) = "unknown named instance <0>"
tcTemplate (UnsolvedHole _) = "unsolved hole <0>"
tcTemplate (UnsolvedMetavarInfer _) =
  "cannot infer a type for this expression (unsolved metavariable ?<0>); add a type annotation"
tcTemplate (AmbiguousInstance _ _) = "ambiguous instance for <0> (candidates: <1>)"
tcTemplate (AppliedNotType _) = "expected a type, but <0> applied to these arguments is not a type"
tcTemplate (CtorDoesNotReturn _ _) = "constructor <0> does not return <1>"
tcTemplate (CtorError _ _) = "constructor <0>: <1>"
tcTemplate (CtorWrongIndices _ _) = "constructor <0> has the wrong number of indices for <1>"
tcTemplate (NotTraitMethod _ _) = "`<0>` is not a method of trait <1>"
tcTemplate (OpNotDefinedFor _ _) = "`<0>` is not defined for <1> (Ord instance required)"
tcTemplate (OpOnlyIntString _ _) = "`<0>` is only defined for Int and String (found <1>; M19)"
tcTemplate (UnknownConstructorInCase _ _) = "unknown constructor <0> in case <1>"
tcTemplate (UnsolvedMetavar _ _) = "unsolved metavariable ?<0><1>"
tcTemplate (TypeMismatch _ _) = "type mismatch: expected <0>, got <1>"
tcTemplate (TypeMismatchCaseBranch _ _) = "type mismatch: case branch <0> vs <1>"
tcTemplate (WhereNeedsSig _ _) =
  "where binding `<0>` needs a type signature (write `<1> : <type>` before the clause)"

cgTemplate : {n : Nat} -> CgErr n -> String
cgTemplate DependencyCycle = "dependency cycle between runtime definitions"
cgTemplate InterpCannotExecuteEffects =
  "interp cannot execute effects (main : IO a); compile and run the program instead"
cgTemplate MainNotValue = "main does not reduce to a value"
cgTemplate MainReturnType = "main must return Int, String or Bool (M13 limitation)"
cgTemplate NoMain = "no main definition"
cgTemplate TypeUsedAtRuntime = "a type is used at runtime (M13 limitation)"
cgTemplate (AxiomAtRuntime _) =
  "axiom `<0>` cannot be used at runtime (it has no runtime definition)"
cgTemplate (ListBridgeRequired _) =
  "builtin `<0>` requires the canonical `Base.List.List` declaration from vuna-base (no base dependency in this package)"
cgTemplate (RecursiveValueDefinition _) =
  "top-level value definition `<0>` cannot be recursive; make it a function or remove the cycle"
cgTemplate (TypeLevelBindingRuntime _) = "type-level binding `<0>` is used at runtime"
cgTemplate (TypeLevelNameRuntime _) = "type-level name `<0>` is used at runtime"
cgTemplate (UnsolvedMetavarRuntime _) = "unsolved metavariable in runtime code<0>"

-- ---------------------------------------------------------------
-- 文档遍历源（同构 List；`gen-errors` 遍历渲染；不承载 arity——arity 在构造子类型里）
-- ---------------------------------------------------------------
data TcEntry : Type where
  TcEntry : String -> String -> String -> TcEntry

tcEntryCode : TcEntry -> String
tcEntryCode (TcEntry code template desc) = code

tcEntryTemplate : TcEntry -> String
tcEntryTemplate (TcEntry code template desc) = template

tcEntryDesc : TcEntry -> String
tcEntryDesc (TcEntry code template desc) = desc

data CgEntry : Type where
  CgEntry : String -> String -> String -> CgEntry

cgEntryCode : CgEntry -> String
cgEntryCode (CgEntry code template desc) = code

cgEntryTemplate : CgEntry -> String
cgEntryTemplate (CgEntry code template desc) = template

cgEntryDesc : CgEntry -> String
cgEntryDesc (CgEntry code template desc) = desc

-- 遍历所有 TC 构造子（新增构造子必须在此登记）
tcAll : List TcEntry
tcAll =
  [ TcEntry (tcCode BoolCaseRestriction) (tcTemplate BoolCaseRestriction) "Bool 的 case 只接受 True/False/变量模式",
    TcEntry (tcCode (AxiomWithDefinition "")) (tcTemplate (AxiomWithDefinition "")) "axiom 不能同时有定义体",
    TcEntry (tcCode BranchAfterCatchAll) (tcTemplate BranchAfterCatchAll) "兜底分支之后的分支不可达",
    TcEntry (tcCode CaseBranchTooFewArgs) (tcTemplate CaseBranchTooFewArgs) "case 分支实参少于构造子字段",
    TcEntry (tcCode CatchAllNotLast) (tcTemplate CatchAllNotLast) "兜底分支必须在最后",
    TcEntry (tcCode ClauseTooManyPatterns) (tcTemplate ClauseTooManyPatterns) "子句模式多于函数元数",
    TcEntry (tcCode DataKindArrows) (tcTemplate DataKindArrows) "data 的 kind 必须是箭头链",
    TcEntry (tcCode DefFewerParams) (tcTemplate DefFewerParams) "定义实参少于签名（M28 起按 η 展开补 λ；保留码但不再触发）",
    TcEntry (tcCode DefMoreParams) (tcTemplate DefMoreParams) "定义实参多于签名",
    TcEntry (tcCode DefParamsMustBeVars) (tcTemplate DefParamsMustBeVars) "定义参数必须是变量",
    TcEntry (tcCode DoUnsupported) (tcTemplate DoUnsupported) "do 块尚不支持",
    TcEntry (tcCode DuplicateCtorInCase) (tcTemplate DuplicateCtorInCase) "case 里重复的构造子",
    TcEntry (tcCode FunctionNoClauses) (tcTemplate FunctionNoClauses) "函数没有子句",
    TcEntry (tcCode HoleNoExpectedType) (tcTemplate HoleNoExpectedType) "洞缺少期望类型",
    TcEntry (tcCode ImplicitParamKind) (tcTemplate ImplicitParamKind) "隐式参数必须是类型",
    TcEntry (tcCode ImpossibleBranchEmptyCtx) (tcTemplate ImpossibleBranchEmptyCtx) "上下文含空归纳族，分支不可达",
    TcEntry (tcCode ImpossibleBranchIndex) (tcTemplate ImpossibleBranchIndex) "索引约束不可满足，分支不可达",
    TcEntry (tcCode IndexFuel) (tcTemplate IndexFuel) "索引归一化耗尽归约燃料",
