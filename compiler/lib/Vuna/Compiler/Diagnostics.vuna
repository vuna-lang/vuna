cgAll : List CgEntry
cgAll =
  [ CgEntry (cgCode DependencyCycle) (cgTemplate DependencyCycle) "运行时定义间依赖成环",
    CgEntry (cgCode InterpCannotExecuteEffects) (cgTemplate InterpCannotExecuteEffects) "interp 不能执行效果",
    CgEntry (cgCode MainNotValue) (cgTemplate MainNotValue) "main 未归约到值",
    CgEntry (cgCode MainReturnType) (cgTemplate MainReturnType) "main 返回类型受限",
    CgEntry (cgCode NoMain) (cgTemplate NoMain) "入口缺少 main 定义",
    CgEntry (cgCode TypeUsedAtRuntime) (cgTemplate TypeUsedAtRuntime) "类型被运行时使用（M13 限制）",
    CgEntry (cgCode (AxiomAtRuntime "")) (cgTemplate (AxiomAtRuntime "")) "axiom 被运行时使用（它没有运行时定义体）",
    CgEntry (cgCode (ListBridgeRequired "")) (cgTemplate (ListBridgeRequired "")) "内建需要 canonical Base.List.List 桥接但包没有 base 依赖",
    CgEntry (cgCode (RecursiveValueDefinition "")) (cgTemplate (RecursiveValueDefinition "")) "递归组里的零参值定义无法安全落地",
    CgEntry (cgCode (TypeLevelBindingRuntime "")) (cgTemplate (TypeLevelBindingRuntime "")) "类型级绑定被运行时使用（M13 限制）",
    CgEntry (cgCode (TypeLevelNameRuntime "")) (cgTemplate (TypeLevelNameRuntime "")) "类型级名字被运行时使用",
    CgEntry (cgCode (UnsolvedMetavarRuntime "")) (cgTemplate (UnsolvedMetavarRuntime "")) "运行时代码里有未解元变量"
  ]

-- ---------------------------------------------------------------
-- throw：拼 `[CODE] 消息`（去掉旧 `DT: ` 前缀）；TC 的 Span 经 showSpanLoc 拼在头部
-- ---------------------------------------------------------------
tcMsg : {n : Nat} -> TcErr n -> Vec String n -> String
tcMsg e args = "[" ++ tcCode e ++ "] " ++ substTemplate (tcTemplate e) args

cgMsg : {n : Nat} -> CgErr n -> Vec String n -> String
cgMsg e args = "[" ++ cgCode e ++ "] " ++ substTemplate (cgTemplate e) args

-- TC 诊断带位置（`文件:行:列: [CODE] 消息`）。
-- 本模块**不**依赖 `Elab/Types`（避免 Elab ↔ Diagnostics 成环）：用 Common 的
-- `showSpanLoc` 拼 span 前缀，与 `Elab/Types.errAt` 的输出格式一致。
tcErr : {n : Nat} -> Span -> TcErr n -> Vec String n -> Result a
tcErr sp e args = Err (showSpanLoc sp ++ ": " ++ tcMsg e args)

-- CG 诊断无位置（`[CODE] 消息`）
cgErr : {n : Nat} -> CgErr n -> Vec String n -> Result a
cgErr e args = Err (cgMsg e args)

-- ---------------------------------------------------------------
-- 人体工学：按 arity 分档的 throw（调用点不必手搓 Vec）
-- ---------------------------------------------------------------
tcErr0 : Span -> TcErr Zero -> Result a
tcErr0 sp e = tcErr sp e VNil

tcErr1 : Span -> TcErr (Succ Zero) -> String -> Result a
tcErr1 sp e a0 = tcErr sp e (VCons a0 VNil)

tcErr2 : Span -> TcErr (Succ (Succ Zero)) -> String -> String -> Result a
tcErr2 sp e a0 a1 = tcErr sp e (VCons a0 (VCons a1 VNil))

cgErr0 : CgErr Zero -> Result a
cgErr0 e = cgErr e VNil

cgErr1 : CgErr (Succ Zero) -> String -> Result a
cgErr1 e a0 = cgErr e (VCons a0 VNil)

-- ---------------------------------------------------------------
-- M29（A14）：定义级 CG 诊断（带来源位置）
-- ---------------------------------------------------------------
-- `DtDef` 现在携带来源 `Maybe Span`（顶层定义 = 子句 span；instance 生成定义 =
-- instance 声明 span；trait 投影 = trait 声明 span）。CG 诊断在 **def 粒度**补位置，
-- 格式与 Elab 诊断一致：`文件:行:列: in `name`: [CODE] 消息`；没有 span 时退回旧的
-- `in `name`: `（不改变既有夹具断言的子串）。
-- 本模块不依赖 `Elab/Types`（避免环），因此以 `Maybe Span` + 名字为参数。
cgDefLoc : Maybe Span -> String -> String
cgDefLoc span name = case span of
  Just sp => showSpanLoc sp ++ ": in `" ++ name ++ "`: "
  Nothing => "in `" ++ name ++ "`: "

cgErrDefAt : Maybe Span -> String -> {n : Nat} -> CgErr n -> Vec String n -> Result a
cgErrDefAt span name e args = Err (cgDefLoc span name ++ cgMsg e args)

-- ---------------------------------------------------------------
-- 无位置版本：Core（Conv/Eval）等底层诊断拿不到 Span，但仍要走同一套码与模板。
-- 输出形态是无前缀的 `[CODE] 消息`（与带位置的 `文件:行:列: [CODE] 消息` 区分）。
-- ---------------------------------------------------------------
tcErr0NoLoc : TcErr Zero -> Result a
tcErr0NoLoc e = Err (tcMsg e VNil)

tcErr1NoLoc : TcErr (Succ Zero) -> String -> Result a
tcErr1NoLoc e a0 = Err (tcMsg e (VCons a0 VNil))

tcErr2NoLoc : TcErr (Succ (Succ Zero)) -> String -> String -> Result a
tcErr2NoLoc e a0 a1 = Err (tcMsg e (VCons a0 (VCons a1 VNil)))
