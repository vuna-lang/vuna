module Vuna.Compiler.Debug (debugLine, perfEnabled, perfMark, releaseBuild, sampled, unit) where

-- Vuna.Compiler.Debug：内置探针宏的运行时后端（**不是调用入口**）。
--
-- 调用点只写内置宏 `perfNote!` / `perfStamp!` / `perfSample!`（展开规则见
-- `Loader.Expand`）。宏在展开里做 `perfEnabled` 判断，所以本模块的发射函数是**无守卫
-- 原语**：直接调用会在关闭 `--debug-perf` 时也打印——不要绕过宏调用 `debugLine` /
-- `perfMark`。
--
-- 开关（argv/env 各读一次，之后只判 Bool）：
--   * `perfEnabled`：`--debug-perf`（任意子命令后加；`Vuna.Cli` 先剥掉再分发）或
--     环境变量 `VUNA_DEBUG_PERF=1`（不经过 `Vuna.Cli` 的 `vuna-compiler` 入口用）；
--   * `releaseBuild`：`--release` 或 `VUNA_RELEASE=1`；release 下 `assert` / `todo` 由
--     `Loader.Resolve` 拒绝（见 docs/reference/debugging.md §3）。
--
-- 输出协议（与 performance.md / 工具链一致）：
--   `DEBUG <text>`           任意诊断文本（表规模、计数等）；
--   `PERF <label> <epoch-us>` 微秒时间戳（`effTimeUs`，无 fork），相邻两行相减即耗时。
-- 关闭开关时每个探针只花一次 Bool 判据；探针宏返回 `Unit`（不再用 `0` 哨兵）。
--
-- 本模块是 `nix/eff-boundary.exceptions` 里唯一 sanctioned 的 runPure tracing 通道：
-- 发射函数在纯签名里执行写 stdout 的宿主动作，只为此保留。
import Vuna.Compiler.Common
import Base.Hashable
import Base.Eff

args : List String
args = runPure prim_eff_getArgs

-- | perf tracing 开关（`--debug-perf` / `VUNA_DEBUG_PERF=1`）；探针宏展开引用它。
perfEnabled : Bool
perfEnabled = memName "--debug-perf" args || runPure (prim_eff_getenv "VUNA_DEBUG_PERF") == "1"

-- | release 构建开关（`--release` / `VUNA_RELEASE=1`）：release 下 assert/todo 被拒。
releaseBuild : Bool
releaseBuild = memName "--release" args || runPure (prim_eff_getenv "VUNA_RELEASE") == "1"

-- | 宏展开的 no-op 分支值（`Unit`；全限定引用，避免被调用方同名构造子捕获）。
unit : Unit
unit = MkUnit

-- | 写一行 `<kind> <payload>` 到 stdout（无守卫；只供下面的原语使用）。
emit : String -> String -> Unit
emit kind payload =
  let
    _ = runPure (prim_eff_print "${kind} ${payload}\n")
  in unit

-- | 无守卫写 `DEBUG <text>`（宏 `perfNote!` 的展开目标）。
debugLine : String -> Unit
debugLine text = emit "DEBUG" text

-- | 无守卫写 `PERF <label> <epoch-us>`（宏 `perfStamp!` / `perfSample!` 的展开目标）。
perfMark : String -> Unit
perfMark label = emit "PERF" "${label} ${runPure effTimeUs}"

-- | 确定性 1/64 采样（名字哈希低位为 0，与 `Base.Hashable.hashStr` 同一哈希）。
sampled : String -> Bool
sampled key =
  let
    h = Base.Hashable.hashStr key
  in h - h / 64 * 64 == 0
