module Vuna.Compiler.Debug (debugOn, note, noteInt, sampleKey, stamp, stampSample) where

-- Vuna.Compiler.Debug：**CLI 参数开关**的性能/诊断探针（长期保留，关闭时近零成本）。
--
-- 开关：`vuna ... --debug-perf`（任意子命令后加；`Vuna.Cli.runCli` 先剥掉再分发）。
-- 打开后输出两类行：
--   `PERF <label> <us>`   内建 `timeUs` 的微秒时间戳（`Unix.gettimeofday`）。相邻两行
--                         相减即阶段耗时；打点本身 ~1µs，所以可以逐定义、逐阶段打点
--                         （旧实现 shell `date` 要 5ms，只能 1/64 采样）；
--   `DEBUG <text>`        任意诊断文本（表规模等）。
-- 关闭时每次调用只花一次 `getArgs`（微秒级），可长期留在生产代码里。
import Vuna.Compiler.Common

args : List String
args = getArgs

debugOn : Bool
debugOn = memName "--debug-perf" args

note : String -> Int
note msg = if debugOn then
  let
    _ = prim_print ("DEBUG " ++ msg ++ "\n")
  in 0
else 0

noteInt : String -> Int -> Int
noteInt label n = note (label ++ "=" ++ strFromInt n)

stampNow : String -> Int
stampNow label =
  let
    _ = prim_print ("PERF " ++ label ++ " " ++ strFromInt timeUs ++ "\n")
  in 0

stamp : String -> Int
stamp label = if debugOn then stampNow label else 0

-- 采样键：1/64 命中（名字哈希低位为 0），与 `hashStr` 同一哈希，结果确定。
sampleKey : String -> Bool
sampleKey name =
  let
    h = hashStr name
  in h - h / 64 * 64 == 0

stampSample : String -> String -> Int
stampSample key label = if sampleKey key then stamp label else 0
