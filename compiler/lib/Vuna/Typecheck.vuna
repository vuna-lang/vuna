module Vuna.Typecheck (Ty, TVar, TCon, TFun, TApp, Scheme, lookupScheme, checkProgramInfoElab, checkProgramInfoElabOwners, checkProgramInfo, checkProgram, exhaustiveWarnings) where

-- Vuna.Typecheck：core-v0 的 Hindley-Milner 风格类型检查。
-- M7b 先覆盖单文件程序与显式顶层签名；模块类型名解析与自检在 M7c 处理。

import Vuna.Base
import Vuna.Ast
import Vuna.Parser

data Ty : Type where
  TVar : Int -> Ty
  TCon : String -> List Ty -> Ty
  TFun : Ty -> Ty -> Ty
  -- 高阶 kind（M11）：类型变量当作类型构造器应用，如 `m a`。head 通常是 TVar；
  -- resolveTy 会把 head 已解析成 TCon 的 TApp 归一化回 TCon。
  TApp : Ty -> List Ty -> Ty

-- scheme：量化类型变量、trait 约束（trait 名 + 类型）、类型。
-- M10.5c：泛型（裸类型变量）trait 约束通过方法函数参数穿参（字典扁平化）。
data Scheme : Type where
  Scheme : List Int -> List (Pair String Ty) -> Ty -> Scheme

mkScheme qs ty = Scheme qs Nil ty

-- M10.5 记录声明信息：类型名、参数名、字段（名+类型表达式）、deriving 列表。
data RecordInfo : Type where
  RecordInfo : String -> List String -> List (Pair String Expr) -> List String -> RecordInfo

-- 延迟求解的记录约束：字段访问 / 更新需要 base 的类型确定后才能消歧。
data RecConstraint : Type where
  FieldCon : Ty -> String -> Ty -> Span -> RecConstraint
  UpdateCon : Ty -> String -> Ty -> Span -> RecConstraint

-- 推断状态：下一个类型变量编号、substitution、类型名表、记录表、待求解记录约束、
-- 方法表 + trait 上下文（M10.5 静态派发）。
data TC : Type where
  TC : Int -> TySubst -> List String -> List RecordInfo -> List RecConstraint -> List TraitMethodRef -> TraitCtx -> TC

-- 类型变量替换：Int 键 → Ty 的 AVL 树。
-- 原先用关联表（TySubst）：每次 unify 都要 resolveTy 整个类型，
-- 而每次 TVar 查找线性扫描 substitution，整体退化为 O(n²)（自举约 15s）。
-- AVL 把查找/插入都降到 O(log n)，是 M12.5 之后的编译性能修复。
data TySubst : Type where
  TsLeaf : TySubst
  TsNode : Int -> Ty -> Int -> TySubst -> TySubst -> TySubst

tsHeight : TySubst -> Int
tsHeight TsLeaf = 0
tsHeight (TsNode k v h l r) = h

tsMax a b = if a >= b then a else b

tsMake k v l r = TsNode k v (1 + tsMax (tsHeight l) (tsHeight r)) l r

tsRotRight s =
  case s of
    TsNode k v h (TsNode lk lv lh ll lr) r => tsMake lk lv ll (tsMake k v lr r)
    _ => s

tsRotLeft s =
  case s of
    TsNode k v h l (TsNode rk rv rh rl rr) => tsMake rk rv (tsMake k v l rl) rr
    _ => s

tsBalance s =
  case s of
    TsNode k v h l r =>
      let bf = tsHeight l - tsHeight r
      in tsBalanceBy bf s
    _ => s

tsBalanceBy bf s =
  if bf > 1 then tsBalanceLeft s
  else if bf < 0 - 1 then tsBalanceRight s
  else s

tsBalanceLeft s =
  case s of
    TsNode k v h l r => case l of
      TsNode lk lv lh ll lr =>
        if tsHeight ll >= tsHeight lr then tsRotRight s
        else tsRotRight (tsMake k v (tsRotLeft l) r)
      _ => s
    _ => s

tsBalanceRight s =
  case s of
    TsNode k v h l r => case r of
      TsNode rk rv rh rl rr =>
        if tsHeight rr >= tsHeight rl then tsRotLeft s
        else tsRotLeft (tsMake k v l (tsRotRight r))
      _ => s
    _ => s

tsPut : Int -> Ty -> TySubst -> TySubst
tsPut i ty TsLeaf = TsNode i ty 1 TsLeaf TsLeaf
tsPut i ty (TsNode j tj h l r) =
  if i == j then TsNode j ty h l r
  else if i < j then tsBalance (tsMake j tj (tsPut i ty l) r)
  else tsBalance (tsMake j tj l (tsPut i ty r))

tsGet : Int -> TySubst -> Maybe Ty
tsGet i TsLeaf = Nothing
tsGet i (TsNode j t h l r) =
  if i == j then Just t else if i < j then tsGet i l else tsGet i r

-- 推断阶段产出的 annotated 表达式：比较运算应用暂存操作数类型（Ty），
-- 待子句与顶层签名 unify 完成后，再用最终 substitution 决定合成 builtin 名。
-- 每个节点保留源码 span，供 lower 回 Expr 后做运行时错误定位。
data EExpr : Type where
  XEVar : String -> Span -> EExpr
  XEInt : Int -> Span -> EExpr
  XEStr : String -> Span -> EExpr
  XELam : List String -> EExpr -> Span -> EExpr
  XEApp : EExpr -> List EExpr -> Span -> EExpr
  XELet : List (Pair Pat EExpr) -> EExpr -> Bool -> Span -> EExpr
  XECase : EExpr -> Ty -> List (Pair Pat EExpr) -> Span -> EExpr
  XEIf : EExpr -> EExpr -> EExpr -> Span -> EExpr
  XEField : EExpr -> String -> Ty -> Span -> EExpr
  XERecUpdate : EExpr -> Ty -> List (Pair String EExpr) -> Span -> EExpr
  XEFun : String -> List (Pair String Ty) -> Span -> EExpr
  XEMethod : String -> String -> Ty -> Span -> EExpr
  XEMethodInst : String -> String -> String -> Ty -> Span -> EExpr

eeSpan e =
  case e of
    XEVar n sp => sp
    XEInt n sp => sp
    XEStr s sp => sp
    XELam ps b sp => sp
    XEApp f a sp => sp
    XELet bs b _ sp => sp
    XECase s ty a sp => sp
    XEIf c t e sp => sp
    XEField b f ty sp => sp
    XERecUpdate b ty fs sp => sp
    XEFun name cons sp => sp
    XEMethod tr meth ty sp => sp
    XEMethodInst tr meth inst ty sp => sp

-- ---------------------------------------------------------------
-- 基础工具
-- ---------------------------------------------------------------

lookupSubst i Nil = Nothing
lookupSubst i (Cons (Pair j t) rest) =
  if i == j then Just t else lookupSubst i rest

memInt i Nil = False
memInt i (Cons x rest) = if i == x then True else memInt i rest

addUnique x xs = if memInt x xs then xs else Cons x xs

unionInts Nil ys = ys
unionInts (Cons x rest) ys = addUnique x (unionInts rest ys)

diffInts Nil ys = Nil
diffInts (Cons x rest) ys = if memInt x ys then diffInts rest ys else Cons x (diffInts rest ys)

resolveTy : TySubst -> Ty -> Ty
resolveTy s ty =
  case ty of
    TVar i =>
      case tsGet i s of
        Just t => resolveTy s t
        Nothing => ty
    TCon n args => TCon n (map (resolveTy s) args)
    TFun a b => TFun (resolveTy s a) (resolveTy s b)
    TApp head args =>
      case resolveTy s head of
        TCon n hargs => resolveTy s (TCon n (append hargs (map (resolveTy s) args)))
        head2 => TApp head2 (map (resolveTy s) args)

occursIn : Int -> TySubst -> Ty -> Bool
occursIn i s ty =
  case resolveTy s ty of
    TVar j => i == j
    TCon n args => occursInArgs i s args
    TFun a b => occursIn i s a || occursIn i s b
    TApp head args => occursIn i s head || occursInArgs i s args

occursInArgs i s Nil = False
occursInArgs i s (Cons ty rest) = occursIn i s ty || occursInArgs i s rest

showTy : Ty -> String
showTy ty =
  case ty of
    TVar i => "t" ++ strFromInt i
    TCon n Nil => n
    TCon n args => "(" ++ n ++ " " ++ showTyArgs args ++ ")"
    TFun a b => "(" ++ showTy a ++ " -> " ++ showTy b ++ ")"
    TApp head args => "(" ++ showTy head ++ " " ++ showTyArgs args ++ ")"

showTyArgs Nil = ""
showTyArgs (Cons ty Nil) = showTy ty
showTyArgs (Cons ty rest) = showTy ty ++ " " ++ showTyArgs rest

nextVar : TC -> Pair Int TC
nextVar (TC n s typeNames records cons methods tctx) = Pair n (TC (n + 1) s typeNames records cons methods tctx)

freshTy : TC -> Pair Ty TC
freshTy st =
  case nextVar st of
    Pair n st2 => Pair (TVar n) st2

bindVar : Int -> Ty -> TC -> Result TC
bindVar i ty (TC n s typeNames records cons methods tctx) = Ok (TC n (tsPut i ty s) typeNames records cons methods tctx)

unifyLists : List Ty -> List Ty -> TC -> Result TC
unifyLists Nil Nil st = Ok st
unifyLists (Cons a ar) (Cons b br) st =
  case unify a b st of
    Err e => Err e
    Ok st2 => unifyLists ar br st2
unifyLists _ _ st = Err "type mismatch: different number of arguments"

unify : Ty -> Ty -> TC -> Result TC
unify a b st =
  case resolveTy (substOf st) a of
    ra => case resolveTy (substOf st) b of
            rb => unifyResolved ra rb st

unifyResolved ra rb st =
  case ra of
    TVar i =>
      case rb of
        TVar j =>
          if i == j then Ok st else bindVar i rb st
        _ =>
          if occursIn i (substOf st) rb then Err ("occurs check: " ++ showTy rb)
          else bindVar i rb st
    TCon tn xs =>
      case rb of
        TVar j =>
          if occursIn j (substOf st) ra then Err ("occurs check: " ++ showTy ra)
          else bindVar j ra st
        TCon tn2 ys =>
          if tn == tn2 || sameBuiltinTy tn tn2 then unifyLists xs ys st
          else Err ("type mismatch: expected " ++ showTy rb ++ " but got " ++ showTy ra)
        TApp h ys =>
          andThen (unify (TCon tn Nil) h st) (\st2 => unifyLists xs ys st2)
        _ => Err ("type mismatch: expected " ++ showTy rb ++ " but got " ++ showTy ra)
    TFun x y =>
      case rb of
        TVar j =>
          if occursIn j (substOf st) ra then Err ("occurs check: " ++ showTy ra)
          else bindVar j ra st
        TFun x2 y2 => andThen (unify x x2 st) (\st2 => unify y y2 st2)
        _ => Err ("type mismatch: expected " ++ showTy rb ++ " but got " ++ showTy ra)
    TApp h xs =>
      case rb of
        TVar j =>
          if occursIn j (substOf st) ra then Err ("occurs check: " ++ showTy ra)
          else bindVar j ra st
        TApp h2 ys => andThen (unify h h2 st) (\st2 => unifyLists xs ys st2)
        TCon tn2 ys => andThen (unify h (TCon tn2 Nil) st) (\st2 => unifyLists xs ys st2)
        _ => Err ("type mismatch: expected " ++ showTy rb ++ " but got " ++ showTy ra)

instantiateVars Nil st = Pair Nil st
instantiateVars (Cons q rest) st =
  case freshTy st of
    Pair ty st2 =>
      case instantiateVars rest st2 of
        Pair mapping st3 => Pair (Cons (Pair q ty) mapping) st3

renameTy mapping ty =
  case ty of
    TVar i =>
      case lookupSubst i mapping of
        Just t => t
        Nothing => ty
    TCon n args => TCon n (map (renameTy mapping) args)
    TFun a b => TFun (renameTy mapping a) (renameTy mapping b)
    TApp head args => TApp (renameTy mapping head) (map (renameTy mapping) args)

instantiateFull : TC -> Scheme -> Pair (Pair Ty (List (Pair String Ty))) TC
instantiateFull st (Scheme qs cons ty) =
  case instantiateVars qs st of
    Pair mapping st2 =>
      let ty2 = renameTy mapping ty
      in let cons2 = map (\c => Pair (firstOf c) (renameTy mapping (secondOf c))) cons
         in Pair (Pair ty2 cons2) st2

instantiate : TC -> Scheme -> Pair Ty TC
instantiate st sch =
  case instantiateFull st sch of
    Pair (Pair ty cons) st2 => Pair ty st2

freeVarsTy ty =
  case ty of
    TVar i => Cons i Nil
    TCon n args => freeVarsArgs args
    TFun a b => unionInts (freeVarsTy a) (freeVarsTy b)
    TApp head args => unionInts (freeVarsTy head) (freeVarsArgs args)

freeVarsArgs Nil = Nil
freeVarsArgs (Cons ty rest) = unionInts (freeVarsTy ty) (freeVarsArgs rest)

freeVarsScheme (Scheme qs cons ty) =
  diffInts (append (freeVarsTy ty) (concatMap consFreeVars cons)) qs

consFreeVars (Pair tr ty) = freeVarsTy ty

freeVarsEnv Nil = Nil
freeVarsEnv (Cons (Pair n sch) rest) =
  unionInts (freeVarsScheme sch) (freeVarsEnv rest)

-- ---------------------------------------------------------------
-- 类型表达式 → Ty
-- ---------------------------------------------------------------

isLowerName name =
  case strUnpack name of
    Nil => False
    Cons c rest => c >= 97 && c <= 122

lookupTyVar name Nil = Nothing
lookupTyVar name (Cons (Pair n ty) rest) =
  if n == name then Just ty else lookupTyVar name rest

knownTypeName typeNames name =
  memName name typeNames || name == "Int" || name == "String" || name == "Bool"

convertTypes typeNames vars Nil st = Ok (Pair (Pair Nil vars) st)
convertTypes typeNames vars (Cons e rest) st =
  andThen (convertType typeNames vars st e) (\pa =>
    case pa of
      Pair (Pair ty vars1) st1 =>
        andThen (convertTypes typeNames vars1 rest st1) (\pb =>
          case pb of
            Pair (Pair tys vars2) st2 => Ok (Pair (Pair (Cons ty tys) vars2) st2)))

convertType typeNames vars st expr =
  case expr of
    EVar name _ =>
      if knownTypeName typeNames name then
        Ok (Pair (Pair (TCon name Nil) vars) st)
      else if isLowerName name then
        case lookupTyVar name vars of
          Just ty => Ok (Pair (Pair ty vars) st)
          Nothing =>
            case freshTy st of
              Pair ty st2 => Ok (Pair (Pair ty (Cons (Pair name ty) vars)) st2)
      else Err ("unknown type: " ++ name)
    EApp fn args _ =>
      case fn of
        EVar "->" _ =>
          case args of
            Cons a (Cons b Nil) =>
              andThen (convertType typeNames vars st a) (\pa =>
                case pa of
                  Pair (Pair ta vars1) st1 =>
                    andThen (convertType typeNames vars1 st1 b) (\pb =>
                      case pb of
                        Pair (Pair tb vars2) st2 =>
                          Ok (Pair (Pair (TFun ta tb) vars2) st2)))
            _ => Err "invalid arrow type"
        EVar name _ =>
          if knownTypeName typeNames name then
            andThen (convertTypes typeNames vars args st) (\pc =>
              case pc of
                Pair (Pair tys vars1) st1 => Ok (Pair (Pair (TCon name tys) vars1) st1))
          else if isLowerName name then
            -- M11：类型变量可以当类型构造器应用（`m a`），得到 TApp。
            case lookupTyVar name vars of
              Just ty =>
                andThen (convertTypes typeNames vars args st) (\pc =>
                  case pc of
                    Pair (Pair tys vars1) st1 => Ok (Pair (Pair (TApp ty tys) vars1) st1))
              Nothing =>
                case freshTy st of
                  Pair ty st2 =>
                    andThen (convertTypes typeNames (Cons (Pair name ty) vars) args st2) (\pc =>
                      case pc of
                        Pair (Pair tys vars1) st3 => Ok (Pair (Pair (TApp ty tys) vars1) st3))
          else Err ("unknown type constructor: " ++ name)
        _ => Err "invalid type application"
    _ => Err "invalid type expression"

varIds Nil = Nil
varIds (Cons (Pair n ty) rest) =
  case ty of
    TVar i => Cons i (varIds rest)
    _ => varIds rest

schemeOfSig typeNames ty st =
  andThen (convertType typeNames Nil st ty) (\p =>
    case p of
      Pair (Pair ty2 vars) st2 => Ok (Pair (mkScheme (varIds vars) ty2) st2))

seedVars Nil st = Pair Nil st
seedVars (Cons name rest) st =
  case freshTy st of
    Pair ty st1 =>
      case seedVars rest st1 of
        Pair vars st2 => Pair (Cons (Pair name ty) vars) st2

schemeOfCtor typeNames params st (Ctor name ty arity _) =
  case seedVars params st of
    Pair vars st1 =>
      andThen (convertType typeNames vars st1 ty) (\p =>
        case p of
          Pair (Pair ty2 vars2) st2 =>
            Ok (Pair (Pair name (mkScheme (varIds vars2) ty2)) st2))

-- ---------------------------------------------------------------
-- 收集声明：数据类型名、签名、构造器 scheme
-- ---------------------------------------------------------------

declDataNames Nil = Nil
declDataNames (Cons d rest) =
  case d of
    DData name params ctors _ _ => Cons name (declDataNames rest)
    _ => declDataNames rest

collectSigs typeNames Nil st = Ok (Pair Nil st)
collectSigs typeNames (Cons d rest) st =
  case d of
    DSig name ty _ =>
      andThen (schemeOfSig typeNames ty st) (\p =>
        case p of
          Pair sch st1 =>
            andThen (collectSigs typeNames rest st1) (\q =>
              case q of Pair sigs st2 => Ok (Pair (Cons (Pair name sch) sigs) st2)))
    _ => collectSigs typeNames rest st

collectCtors typeNames Nil st = Ok (Pair Nil st)
collectCtors typeNames (Cons d rest) st =
  case d of
    DData name params ctors _ _ =>
      andThen (collectCtorList typeNames params ctors st) (\p =>
        case p of
          Pair newCtors st1 =>
            andThen (collectCtors typeNames rest st1) (\q =>
              case q of Pair ctors2 st2 => Ok (Pair (append newCtors ctors2) st2)))
    _ => collectCtors typeNames rest st

collectCtorList typeNames params Nil st = Ok (Pair Nil st)
collectCtorList typeNames params (Cons c rest) st =
  andThen (schemeOfCtor typeNames params st c) (\p =>
    case p of
      Pair (Pair cname sch) st1 =>
        andThen (collectCtorList typeNames params rest st1) (\q =>
          case q of Pair ctors st2 => Ok (Pair (Cons (Pair cname sch) ctors) st2)))

-- ---------------------------------------------------------------
-- 内建函数类型
-- ---------------------------------------------------------------

intTy = TCon "Int" Nil

strTy = TCon "String" Nil

boolTy = TCon "Bool" Nil

listOf ty = TCon "List" (Cons ty Nil)

fun2 a b c = TFun a (TFun b c)

builtinSchemes =
  [ Pair "True" (mkScheme Nil boolTy)
  , Pair "False" (mkScheme Nil boolTy)
  , Pair "Nil" (mkScheme (Cons 0 Nil) (TCon "List" (Cons (TVar 0) Nil)))
  , Pair "Cons" (mkScheme (Cons 0 Nil) (fun2 (TVar 0) (TCon "List" (Cons (TVar 0) Nil)) (TCon "List" (Cons (TVar 0) Nil))))
  , Pair "+" (mkScheme Nil (fun2 intTy intTy intTy))
  , Pair "-" (mkScheme Nil (fun2 intTy intTy intTy))
  , Pair "*" (mkScheme Nil (fun2 intTy intTy intTy))
  , Pair "/" (mkScheme Nil (fun2 intTy intTy intTy))
  , Pair "bi_eq_int" (mkScheme Nil (fun2 intTy intTy boolTy))
  , Pair "bi_neq_int" (mkScheme Nil (fun2 intTy intTy boolTy))
  , Pair "bi_lt_int" (mkScheme Nil (fun2 intTy intTy boolTy))
  , Pair "bi_le_int" (mkScheme Nil (fun2 intTy intTy boolTy))
  , Pair "bi_gt_int" (mkScheme Nil (fun2 intTy intTy boolTy))
  , Pair "bi_ge_int" (mkScheme Nil (fun2 intTy intTy boolTy))
  , Pair "bi_eq_str" (mkScheme Nil (fun2 strTy strTy boolTy))
  , Pair "bi_neq_str" (mkScheme Nil (fun2 strTy strTy boolTy))
  , Pair "bi_eq_bool" (mkScheme Nil (fun2 boolTy boolTy boolTy))
  , Pair "bi_neq_bool" (mkScheme Nil (fun2 boolTy boolTy boolTy))
  , Pair "bi_show_string" (mkScheme Nil (TFun strTy strTy))
  , Pair "bi_eq_generic" (mkScheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "bi_neq_generic" (mkScheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "bi_lt_generic" (mkScheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "bi_le_generic" (mkScheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "bi_gt_generic" (mkScheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "bi_ge_generic" (mkScheme (Cons 0 Nil) (fun2 (TVar 0) (TVar 0) boolTy))
  , Pair "&&" (mkScheme Nil (fun2 boolTy boolTy boolTy))
  , Pair "||" (mkScheme Nil (fun2 boolTy boolTy boolTy))
  , Pair "++" (mkScheme Nil (fun2 strTy strTy strTy))
  , Pair "strLength" (mkScheme Nil (TFun strTy intTy))
  , Pair "strUnpack" (mkScheme Nil (TFun strTy (listOf intTy)))
  , Pair "strPack" (mkScheme Nil (TFun (listOf intTy) strTy))
  , Pair "strFromInt" (mkScheme Nil (TFun intTy strTy))
  , Pair "readFile" (mkScheme Nil (TFun strTy strTy))
  , Pair "writeFile" (mkScheme Nil (fun2 strTy strTy intTy))
  , Pair "print" (mkScheme Nil (TFun strTy intTy))
  , Pair "getArgs" (mkScheme Nil (listOf strTy))
  , Pair "readLine" (mkScheme Nil strTy)
  , Pair "readDir" (mkScheme Nil (TFun strTy (listOf strTy)))
  , Pair "isDirectory" (mkScheme Nil (TFun strTy boolTy))
  , Pair "makeDir" (mkScheme Nil (TFun strTy intTy))
  , Pair "removeFile" (mkScheme Nil (TFun strTy intTy))
  , Pair "fileExists" (mkScheme Nil (TFun strTy boolTy))
  , Pair "exit" (mkScheme Nil (TFun intTy intTy))
  , Pair "prim_readFile" (mkScheme Nil (TFun strTy strTy))
  , Pair "prim_writeFile" (mkScheme Nil (fun2 strTy strTy intTy))
  , Pair "prim_print" (mkScheme Nil (TFun strTy intTy))
  , Pair "prim_getArgs" (mkScheme Nil (listOf strTy))
  , Pair "prim_readLine" (mkScheme Nil strTy)
  , Pair "prim_readDir" (mkScheme Nil (TFun strTy (listOf strTy)))
  , Pair "prim_isDirectory" (mkScheme Nil (TFun strTy boolTy))
  , Pair "prim_makeDir" (mkScheme Nil (TFun strTy intTy))
  , Pair "prim_removeFile" (mkScheme Nil (TFun strTy intTy))
  , Pair "prim_fileExists" (mkScheme Nil (TFun strTy boolTy))
  , Pair "prim_exit" (mkScheme Nil (TFun intTy intTy))
  ]

elabAppExpr fn fnElab args argTys argEls sp = XEApp fnElab argEls sp

-- ---------- trait lowering / 校验 ----------

noInstanceMsg tctx tr ty = "no instance " ++ tr ++ " " ++ showTy ty ++ " (M10.5 静态派发：调用点类型必须确定)"

showFallback tctx ty =
  case ty of
    TCon "Int" Nil => Ok "vuna_show_int"
    TCon "String" Nil => Ok "vuna_show_string"
    TCon "Bool" Nil => Ok "vuna_show_bool"
    TCon n Nil => if memName n (traitCtxSupported tctx) then Ok (showFnName n) else Err (noInstanceMsg tctx "Show" ty)
    _ => Err (noInstanceMsg tctx "Show" ty)

boolTrueExpr = EApp (EVar "bi_eq_int" tcNoSpan) (Cons (EInt 0 tcNoSpan) (Cons (EInt 0 tcNoSpan) Nil)) tcNoSpan

boolFalseExpr = EApp (EVar "bi_eq_int" tcNoSpan) (Cons (EInt 0 tcNoSpan) (Cons (EInt 1 tcNoSpan) Nil)) tcNoSpan

eqMethodExprFor tctx ty =
  case traitMethodExpr tctx ty "Eq" "eq" of
    Ok e => e
    Err _ => EVar "vuna_eq_generic" tcNoSpan

-- List 元素级的 Eq 回退：inline 递归函数（利用内置 Nil/Cons 构造器）。
eqListExpr tctx elemTy =
  let goName = "vuna_eq_list_go"
  in let x = "vuna_eq_lx"
     in let y = "vuna_eq_ly"
        in let h = "vuna_eq_lh"
           in let t = "vuna_eq_lt"
              in let h2 = "vuna_eq_lh2"
                 in let t2 = "vuna_eq_lt2"
                    in let elemEq = eqMethodExprFor tctx elemTy
                       in let recCall = EApp (EVar goName tcNoSpan) (Cons (EVar t tcNoSpan) (Cons (EVar t2 tcNoSpan) Nil)) tcNoSpan
                          in let consBody = EApp (EVar "&&" tcNoSpan) (Cons (EApp elemEq (Cons (EVar h tcNoSpan) (Cons (EVar h2 tcNoSpan) Nil)) tcNoSpan) (Cons recCall Nil)) tcNoSpan
                             in let consCase = ECase (EVar y tcNoSpan) (Cons (Pair (PCon "Cons" (Cons (PVar h2 tcNoSpan) (Cons (PVar t2 tcNoSpan) Nil)) tcNoSpan) consBody) (Cons (Pair (PWild tcNoSpan) boolFalseExpr) Nil)) tcNoSpan
                                in let nilCase = ECase (EVar y tcNoSpan) (Cons (Pair (PCon "Nil" Nil tcNoSpan) boolTrueExpr) (Cons (Pair (PWild tcNoSpan) boolFalseExpr) Nil)) tcNoSpan
                                   in let goBody = ECase (EVar x tcNoSpan) (Cons (Pair (PCon "Nil" Nil tcNoSpan) nilCase) (Cons (Pair (PCon "Cons" (Cons (PVar h tcNoSpan) (Cons (PVar t tcNoSpan) Nil)) tcNoSpan) consCase) Nil)) tcNoSpan
                                      in ELet (Cons (Pair (PVar goName tcNoSpan) (ELam (Cons x (Cons y Nil)) goBody tcNoSpan)) Nil) (EVar goName tcNoSpan) True tcNoSpan

eqFallback tctx ty key =
  case ty of
    TCon "Int" Nil => if key == "neq" then Ok "vuna_neq_int" else Ok "vuna_eq_int"
    TCon "Bool" Nil => if key == "neq" then Ok "vuna_neq_bool" else Ok "vuna_eq_bool"
    TCon "String" Nil => if key == "neq" then Ok "vuna_neq_str" else Ok "vuna_eq_str"
    TCon n args =>
      if memName n (traitCtxEqSupported tctx) then
        if key == "neq" then Ok (neqFnName n) else Ok (eqFnName n)
      else Err (noInstanceMsg tctx "Eq" ty)
    _ => Err (noInstanceMsg tctx "Eq" ty)

ordFallback tctx ty key =
  case ty of
    TCon "Int" Nil =>
      case key of
        "lt" => Ok "vuna_lt_int"
        "le" => Ok "vuna_le_int"
        "gt" => Ok "vuna_gt_int"
        _ => Ok "vuna_ge_int"
    TCon "String" Nil => Ok (ordGenericName key)
    TCon "Bool" Nil => Ok (ordGenericName key)
    _ => Err (noInstanceMsg tctx "Ord" ty)

ordGenericName key =
  case key of
    "lt" => "vuna_lt_generic"
    "le" => "vuna_le_generic"
    "gt" => "vuna_gt_generic"
    _ => "vuna_ge_generic"

genericMethodName tr key =
  case tr of
    "Eq" => if key == "neq" then Just "vuna_neq_generic" else Just "vuna_eq_generic"
    "Ord" =>
      case key of
        "lt" => Just "vuna_lt_generic"
        "le" => Just "vuna_le_generic"
        "gt" => Just "vuna_gt_generic"
        _ => Just "vuna_ge_generic"
    _ => Nothing

listNeqExpr tctx elemTy =
  let eqExpr = eqListExpr tctx elemTy
  in let a = "vuna_neq_la"
     in let b = "vuna_neq_lb"
        in let cond = EApp eqExpr (Cons (EVar a tcNoSpan) (Cons (EVar b tcNoSpan) Nil)) tcNoSpan
           in ELam (Cons a (Cons b Nil)) (EIf cond boolFalseExpr boolTrueExpr tcNoSpan) tcNoSpan

traitMethodExpr tctx ty tr key =
  if traitArityOf tctx tr > 0 then
    -- 高阶 kind trait：按 head 类型构造器静态派发（携带类型参数也能派发）。
    andThen (concreteMethodName tctx ty tr key) (\fn => Ok (EVar fn tcNoSpan))
  else if freeVarsTy ty /= Nil then
    case genericMethodName tr key of
      Just fn => Ok (EVar fn tcNoSpan)
      Nothing => Err ("trait method " ++ key ++ " used at a polymorphic type (only Eq/Ord have a generic fallback in M10.5)")
  else
    case tr of
      "Eq" =>
        case ty of
          TCon "List" (Cons elemTy Nil) =>
            if key == "neq" then Ok (listNeqExpr tctx elemTy) else Ok (eqListExpr tctx elemTy)
          _ => andThen (concreteMethodName tctx ty tr key) (\fn => Ok (EVar fn tcNoSpan))
      _ => andThen (concreteMethodName tctx ty tr key) (\fn => Ok (EVar fn tcNoSpan))

-- 高阶 kind 的实例 head 是类型构造器本身（无参数）；按短名匹配候选类型。
headCtorMatches patternTy ty =
  case patternTy of
    TCon pn pargs =>
      if pargs == Nil then
        case ty of
          TCon tn targs => shortTyName pn == shortTyName tn
          TApp head args =>
            case head of
              TCon tn hargs => shortTyName pn == shortTyName tn
              _ => False
          _ => False
      else tyMatchesPattern patternTy ty
    _ => tyMatchesPattern patternTy ty

concreteMethodName tctx ty tr key =
  let arity = traitArityOf tctx tr
  in case findDefaultInst arity tr ty (traitCtxInsts tctx) of
    Just inst =>
      case lookupImpl (lastSeg key) (instImpls inst) of
        Just fn => Ok fn
        Nothing => Err ("instance " ++ tr ++ " " ++ showTy ty ++ " does not implement " ++ key)
    Nothing =>
      case tr of
        "Show" => showFallback tctx ty
        "Eq" => eqFallback tctx ty key
        "Ord" => ordFallback tctx ty key
        _ => Err (noInstanceMsg tctx tr ty)

-- M10.5c：泛型（裸类型变量）trait 约束 → 方法函数参数（字典扁平化穿参）。
data DictParam : Type where
  DictParam : String -> Int -> String -> String -> DictParam

dictParamTrait (DictParam tr vid key name) = tr

dictParamVar (DictParam tr vid key name) = vid

dictParamKey (DictParam tr vid key name) = key

dictParamName (DictParam tr vid key name) = name

traitMethodKeys tctx tr =
  case lookupTraitDecl tr (traitCtxDecls tctx) of
    Nothing => Nil
    Just td => map methodInfoName (traitDeclMethods td)

isDictTrait tr = tr /= "Eq" && tr /= "Ord"

-- 约束 head 的类型变量：`TVar v` 与高阶 kind 的 `TApp (TVar v) args` 都归到 v。
headVarOf ty =
  case ty of
    TVar v => Just v
    TApp head args =>
      case head of
        TVar v => Just v
        _ => Nothing
    _ => Nothing

needsHave need needs = memName need needs

addNeed : String -> Ty -> List (Pair String Ty) -> List (Pair String Ty)
addNeed tr ty needs =
  let key = tr ++ "|" ++ showTy ty
  in if hasNeed key needs then needs else append needs (Cons (Pair tr ty) Nil)

hasNeed : String -> List (Pair String Ty) -> Bool
hasNeed key Nil = False

hasNeed key (Cons (Pair tr ty) rest) =
  if tr ++ "|" ++ showTy ty == key then True else hasNeed key rest

collectNeedsFromExpr : TySubst -> TraitCtx -> List (Pair String Ty) -> EExpr -> List (Pair String Ty)
collectNeedsFromExpr subst tctx needs expr =
  case expr of
    XEMethod tr key paramTy sp =>
      if isDictTrait tr then
        case headVarOf (resolveTy subst paramTy) of
          Just v => addNeed tr (TVar v) needs
          Nothing => needs
      else needs
    XEFun name cons sp => foldNeeds subst tctx needs cons
    XEVar n sp => needs
    XEInt n sp => needs
    XEStr s sp => needs
    XELam ps b sp => collectNeedsFromExpr subst tctx needs b
    XEApp f args sp => collectNeedsFromExprList subst tctx (collectNeedsFromExpr subst tctx needs f) args
    XELet binds body rec_ sp =>
      collectNeedsFromExpr subst tctx (collectNeedsFromBinds subst tctx needs binds) body
    XECase scrut ty alts sp =>
      collectNeedsFromExprList subst tctx (collectNeedsFromExpr subst tctx needs scrut) (map secondOf alts)
    XEIf c t e sp =>
      collectNeedsFromExpr subst tctx
        (collectNeedsFromExpr subst tctx (collectNeedsFromExpr subst tctx needs c) t) e
    XEField base fname baseTy sp => collectNeedsFromExpr subst tctx needs base
    XERecUpdate base baseTy fields sp =>
      collectNeedsFromExpr subst tctx needs base
    XEMethodInst tr key instName paramTy sp => needs

collectNeedsFromExprList : TySubst -> TraitCtx -> List (Pair String Ty) -> List EExpr -> List (Pair String Ty)
collectNeedsFromExprList subst tctx needs Nil = needs

collectNeedsFromExprList subst tctx needs (Cons e rest) =
  collectNeedsFromExprList subst tctx (collectNeedsFromExpr subst tctx needs e) rest

collectNeedsFromBinds : TySubst -> TraitCtx -> List (Pair String Ty) -> List (Pair Pat EExpr) -> List (Pair String Ty)
collectNeedsFromBinds subst tctx needs Nil = needs

collectNeedsFromBinds subst tctx needs (Cons (Pair pat value) rest) =
  collectNeedsFromBinds subst tctx (collectNeedsFromExpr subst tctx needs value) rest

foldNeeds : TySubst -> TraitCtx -> List (Pair String Ty) -> List (Pair String Ty) -> List (Pair String Ty)
foldNeeds subst tctx needs Nil = needs

foldNeeds subst tctx needs (Cons (Pair tr ty) rest) =
  if isDictTrait tr then
    case headVarOf (resolveTy subst ty) of
      Just v => foldNeeds subst tctx (addNeed tr (TVar v) needs) rest
      Nothing => foldNeeds subst tctx needs rest
  else foldNeeds subst tctx needs rest

collectNeedsClauses : TySubst -> TraitCtx -> List (Pair (List Pat) EExpr) -> List (Pair String Ty)
collectNeedsClauses subst tctx clauses =
  foldClauseNeeds subst tctx Nil clauses

foldClauseNeeds : TySubst -> TraitCtx -> List (Pair String Ty) -> List (Pair (List Pat) EExpr) -> List (Pair String Ty)
foldClauseNeeds subst tctx needs Nil = needs

foldClauseNeeds subst tctx needs (Cons (Pair pats body) rest) =
  foldClauseNeeds subst tctx (collectNeedsFromExpr subst tctx needs body) rest

-- need 列表（"tr|tN" 字符串）→ DictParam 列表（顺序确定）。
dictParamsFor : TraitCtx -> List (Pair String Ty) -> List DictParam
dictParamsFor tctx needs =
  dictParamsForGo tctx needs Nil 0

dictParamsForGo tctx Nil acc idx = reverse acc

dictParamsForGo tctx (Cons (Pair tr ty) rest) acc idx =
  case headVarOf ty of
    Just v => dictParamsForMethods tctx tr v (traitMethodKeys tctx tr) acc idx rest
    Nothing => dictParamsForGo tctx rest acc idx

dictParamsForMethods tctx tr v Nil acc idx rest = dictParamsForGo tctx rest acc idx

dictParamsForMethods tctx tr v (Cons key keys) acc idx rest =
  let pname = "vuna_dict" ++ strFromInt idx
  in dictParamsForMethods tctx tr v keys (Cons (DictParam tr v key pname) acc) (idx + 1) rest

dictParamNames params = map dictParamName params

findDictParam params tr v key =
  case params of
    Nil => Nothing
    Cons p rest =>
      if dictParamTrait p == tr && dictParamVar p == v && dictParamKey p == key then Just (dictParamName p)
      else findDictParam rest tr v key

dictMethodExpr : TraitCtx -> TySubst -> List DictParam -> String -> String -> Ty -> Result Expr
dictMethodExpr tctx subst params tr key paramTy =
  let ty = resolveTy subst paramTy
  in case headVarOf ty of
       Just v =>
         case findDictParam params tr v (lastSeg key) of
           Just p => Ok (EVar p tcNoSpan)
           Nothing => traitMethodExpr tctx ty tr key
       Nothing => traitMethodExpr tctx ty tr key

dictArgsFor : TraitCtx -> TySubst -> List DictParam -> List (Pair String Ty) -> List Expr
dictArgsFor tctx subst params cons =
  foldDictArgs tctx subst params Nil cons

foldDictArgs tctx subst params acc Nil = reverse acc

foldDictArgs tctx subst params acc (Cons (Pair tr ty) rest) =
  foldDictArgs tctx subst params (append acc (dictMethodArgs tctx subst params tr ty)) rest

dictMethodArgs tctx subst params tr ty =
  case traitMethodKeys tctx tr of
    Nil => Nil
    keys => map (\key => dictMethodArg tctx subst params tr (lastSeg key) ty) keys

dictMethodArg tctx subst params tr key ty =
  case dictMethodExpr tctx subst params tr key ty of
    Ok e => e
    Err _ => EVar "vuna_missing_dict" tcNoSpan

validateTraitUsesList : TySubst -> TraitCtx -> List DictParam -> List EExpr -> Result Int
validateTraitUsesList subst tctx params Nil = Ok 0

validateTraitUsesList subst tctx params (Cons e rest) =
  andThen (validateTraitUses subst tctx params e) (\_ => validateTraitUsesList subst tctx params rest)

validateTraitUses : TySubst -> TraitCtx -> List DictParam -> EExpr -> Result Int
validateTraitUses subst tctx params expr =
  case expr of
    XEVar n sp => Ok 0
    XEInt n sp => Ok 0
    XEStr s sp => Ok 0
    XELam ps b sp => validateTraitUses subst tctx params b
    XEApp f args sp =>
      andThen (validateTraitUses subst tctx params f) (\_ => validateTraitUsesList subst tctx params args)
    XELet binds body rec_ sp =>
      andThen (validateTraitUsesBinds subst tctx params binds) (\_ => validateTraitUses subst tctx params body)
    XECase scrut ty alts sp =>
      andThen (validateTraitUses subst tctx params scrut) (\_ => validateTraitUsesAlts subst tctx params alts)
    XEIf c t e sp =>
      andThen (validateTraitUses subst tctx params c) (\_ =>
        andThen (validateTraitUses subst tctx params t) (\_ => validateTraitUses subst tctx params e))
    XEField base fname baseTy sp => validateTraitUses subst tctx params base
    XERecUpdate base baseTy fields sp =>
      andThen (validateTraitUses subst tctx params base) (\_ => validateTraitUsesFields subst tctx params fields)
    XEFun name cons sp =>
      andThen (validateFunDicts subst tctx params cons) (\_ => Ok 0)
    XEMethod tr key paramTy sp =>
      case dictMethodExpr tctx subst params tr key paramTy of
        Err e => Err (showSpanLoc sp ++ ": " ++ e)
        Ok ex => Ok 0
    XEMethodInst tr key instName paramTy sp =>
      let ty = resolveTy subst paramTy
      in case lookupNamedInst instName (traitCtxInsts tctx) of
           Nothing => Err (showSpanLoc sp ++ ": unknown named instance " ++ instName)
           Just inst =>
             if instTraitName inst == tr then
               if tyEqual (instHeadTy inst) ty then Ok 0
               else Err (showSpanLoc sp ++ ": instance " ++ instName ++ " expects " ++ showTy (instHeadTy inst) ++ " but method is used at " ++ showTy ty)
             else Err (showSpanLoc sp ++ ": instance " ++ instName ++ " is not an instance of " ++ tr)

validateFunDicts subst tctx params Nil = Ok 0

validateFunDicts subst tctx params (Cons (Pair tr ty) rest) =
  case traitMethodKeys tctx tr of
    Nil => validateFunDicts subst tctx params rest
    keys =>
      andThen (validateFunDictKeys subst tctx params tr keys ty) (\_ => validateFunDicts subst tctx params rest)

validateFunDictKeys subst tctx params tr Nil ty = Ok 0

validateFunDictKeys subst tctx params tr (Cons key keys) ty =
  case dictMethodExpr tctx subst params tr key ty of
    Err e => Err e
    Ok ex => validateFunDictKeys subst tctx params tr keys ty

validateTraitUsesClauses : TySubst -> TraitCtx -> List DictParam -> List (Pair (List Pat) EExpr) -> Result Int
validateTraitUsesClauses subst tctx params Nil = Ok 0

validateTraitUsesClauses subst tctx params (Cons (Pair pats body) rest) =
  andThen (validateTraitUses subst tctx params body) (\_ => validateTraitUsesClauses subst tctx params rest)

validateTraitUsesBinds : TySubst -> TraitCtx -> List DictParam -> List (Pair Pat EExpr) -> Result Int
validateTraitUsesBinds subst tctx params Nil = Ok 0

validateTraitUsesBinds subst tctx params (Cons (Pair pat value) rest) =
  andThen (validateTraitUses subst tctx params value) (\_ => validateTraitUsesBinds subst tctx params rest)

validateTraitUsesAlts : TySubst -> TraitCtx -> List DictParam -> List (Pair Pat EExpr) -> Result Int
validateTraitUsesAlts subst tctx params Nil = Ok 0

validateTraitUsesAlts subst tctx params (Cons (Pair pat body) rest) =
  andThen (validateTraitUses subst tctx params body) (\_ => validateTraitUsesAlts subst tctx params rest)

validateTraitUsesFields : TySubst -> TraitCtx -> List DictParam -> List (Pair String EExpr) -> Result Int
validateTraitUsesFields subst tctx params Nil = Ok 0

validateTraitUsesFields subst tctx params (Cons (Pair fname value) rest) =
  andThen (validateTraitUses subst tctx params value) (\_ => validateTraitUsesFields subst tctx params rest)

-- 记录字段降级用的临时模式变量（只在生成的一小段 case 内可见）。
recFieldVarsAt i n = if i >= n then Nil else Cons ("vuna_rf" ++ strFromInt i) (recFieldVarsAt (i + 1) n)

recFieldVars n = recFieldVarsAt 0 n

nthNameAt i Nil = ""

nthNameAt i (Cons x rest) = if i == 0 then x else nthNameAt (i - 1) rest

nthName i vars = nthNameAt i vars

recFieldCount Nil = 0

recFieldCount (Cons (Pair n t) rest) = 1 + recFieldCount rest

lowerFieldAccess subst typeNames records tctx params base fname baseTy sp =
  case resolveTy subst baseTy of
    TCon rname args =>
      case lookupRecord rname records of
        Nothing => EInt 0 sp
        Just (RecordInfo rname2 rparams fdefs derivings) =>
          case fieldIndex fname fdefs of
            Nothing => EInt 0 sp
            Just k =>
              let n = recFieldCount fdefs
              in let names = recFieldVars n
                 in let pats = map (\nm => PVar nm sp) names
                    in ECase (lowerExpr subst typeNames records tctx params base)
                         (Cons (Pair (PCon rname pats sp) (EVar (nthName k names) sp)) Nil) sp
    _ => EInt 0 sp

recUpdateArgs subst typeNames records tctx params fields provided vars i sp =
  case fields of
    Nil => Nil
    Cons (Pair fname fty) rest =>
      case lookupProvided fname provided of
        Just e =>
          Cons (lowerExpr subst typeNames records tctx params e)
               (recUpdateArgs subst typeNames records tctx params rest provided vars (i + 1) sp)
        Nothing =>
          Cons (EVar (nthName i vars) sp)
               (recUpdateArgs subst typeNames records tctx params rest provided vars (i + 1) sp)

lowerRecUpdate subst typeNames records tctx params base baseTy fields sp =
  case resolveTy subst baseTy of
    TCon rname args =>
      case lookupRecord rname records of
        Nothing => EInt 0 sp
        Just (RecordInfo rname2 rparams fdefs derivings) =>
          let n = recFieldCount fdefs
          in let names = recFieldVars n
             in let pats = map (\nm => PVar nm sp) names
                in let args2 = recUpdateArgs subst typeNames records tctx params fdefs fields names 0 sp
                   in ECase (lowerExpr subst typeNames records tctx params base)
                        (Cons (Pair (PCon rname pats sp) (EApp (EVar rname sp) args2 sp)) Nil) sp
    _ => EInt 0 sp

lowerExpr subst typeNames records tctx params expr =
  case expr of
    XEVar name sp => EVar name sp
    XEInt n sp => EInt n sp
    XEStr s sp => EStr s sp
    XELam ps b sp => ELam ps (lowerExpr subst typeNames records tctx params b) sp
    XEApp fn args sp =>
      EApp (lowerExpr subst typeNames records tctx params fn)
           (map (lowerExpr subst typeNames records tctx params) args) sp
    XELet binds body rec_ sp =>
      ELet (map (lowerBind subst typeNames records tctx params) binds)
           (lowerExpr subst typeNames records tctx params body) rec_ sp
    XECase scrut ty alts sp =>
      ECase (lowerExpr subst typeNames records tctx params scrut)
            (map (lowerAlt subst typeNames records tctx params) alts) sp
    XEIf c t e sp =>
      EIf (lowerExpr subst typeNames records tctx params c)
          (lowerExpr subst typeNames records tctx params t)
          (lowerExpr subst typeNames records tctx params e) sp
    XEField base fname baseTy sp =>
      lowerFieldAccess subst typeNames records tctx params base fname baseTy sp
    XERecUpdate base baseTy fields sp =>
      lowerRecUpdate subst typeNames records tctx params base baseTy fields sp
    XEFun name cons sp =>
      case dictArgsFor tctx subst params cons of
        Nil => EVar name sp
        args => EApp (EVar name sp) args sp
    XEMethod tr key paramTy sp =>
      case dictMethodExpr tctx subst params tr key paramTy of
        Ok ex => ex
        Err _ => EVar "vuna_missing_instance" sp
    XEMethodInst tr key instName paramTy sp =>
      case lookupNamedInst instName (traitCtxInsts tctx) of
        Just inst =>
          case lookupImpl (lastSeg key) (instImpls inst) of
            Just fn => EVar fn sp
            Nothing => EVar "vuna_missing_instance" sp
        Nothing => EVar "vuna_missing_instance" sp

lowerBind subst typeNames records tctx params (Pair pat value) =
  Pair pat (lowerExpr subst typeNames records tctx params value)

lowerAlt subst typeNames records tctx params (Pair pat body) =
  Pair pat (lowerExpr subst typeNames records tctx params body)

lowerClause subst typeNames records tctx params (Pair pats body) =
  Pair pats (lowerExpr subst typeNames records tctx params body)

lowerClauses subst typeNames records tctx params Nil = Nil

lowerClauses subst typeNames records tctx params (Cons clause rest) =
  Cons (lowerClause subst typeNames records tctx params clause)
       (lowerClauses subst typeNames records tctx params rest)

-- 给每条子句前置字典参数。
prependClauseParam pname Nil = Nil

prependClauseParam pname (Cons (Pair pats body) rest) =
  Cons (Pair (Cons (PVar pname tcNoSpan) pats) body) (prependClauseParam pname rest)

prependClauseParams Nil clauses = clauses

prependClauseParams (Cons pname prest) clauses =
  prependClauseParams prest (prependClauseParam pname clauses)

-- ---------------------------------------------------------------
-- 记录（M10.5）：声明抽取、语法降级、延迟约束求解、lower
-- ---------------------------------------------------------------

recordsOf (TC n s typeNames records cons methods tctx) = records

traitMethodsOf (TC n s typeNames records cons methods tctx) = methods

traitCtxOf (TC n s typeNames records cons methods tctx) = tctx

typeNamesOfTC (TC n s typeNames records cons methods tctx) = typeNames

constraintsOfTC (TC n s typeNames records cons methods tctx) = cons

addRecConstraint c (TC n s typeNames records cons methods tctx) = TC n s typeNames records (Cons c cons) methods tctx

clearRecConstraints (TC n s typeNames records cons methods tctx) = TC n s typeNames records Nil methods tctx

lookupRecord name Nil = Nothing

lookupRecord name (Cons (RecordInfo rname params fields derivings) rest) =
  if rname == name then Just (RecordInfo rname params fields derivings)
  else lookupRecord name rest

zipParamTys Nil Nil = Nil

zipParamTys (Cons p ps) (Cons t ts) = Cons (Pair p t) (zipParamTys ps ts)

freshParamTys Nil st = Pair Nil st

freshParamTys (Cons p ps) st =
  case freshTy st of
    Pair ty st1 =>
      case freshParamTys ps st1 of
        Pair tys st2 => Pair (Cons ty tys) st2

fieldNamesOf Nil = Nil

fieldNamesOf (Cons (Pair n t) rest) = Cons n (fieldNamesOf rest)

fieldIndexAt fname Nil i = Nothing

fieldIndexAt fname (Cons (Pair n t) rest) i =
  if n == fname then Just i else fieldIndexAt fname rest (i + 1)

fieldIndex fname fields = fieldIndexAt fname fields 0

lookupProvided : String -> List (Pair String a) -> Maybe a
lookupProvided fname Nil = Nothing

lookupProvided fname (Cons (Pair n e) rest) =
  if n == fname then Just e else lookupProvided fname rest

hasDuplicateFieldNames : List (Pair String a) -> Bool
hasDuplicateFieldNames Nil = False

hasDuplicateFieldNames (Cons (Pair n e) rest) =
  case lookupProvided n rest of
    Just _ => True
    Nothing => hasDuplicateFieldNames rest

missingFieldMsg sp fname = showSpanLoc sp ++ ": missing field " ++ fname

unknownFieldMsg sp fname = showSpanLoc sp ++ ": unknown field " ++ fname

duplicateFieldMsg sp = showSpanLoc sp ++ ": duplicate field"

hasUnknownFields fieldNames Nil = False

hasUnknownFields fieldNames (Cons (Pair n v) rest) =
  if memName n fieldNames then hasUnknownFields fieldNames rest else True

firstUnknownFieldMsg sp fieldNames Nil = unknownFieldMsg sp ""

firstUnknownFieldMsg sp fieldNames (Cons (Pair n v) rest) =
  if memName n fieldNames then firstUnknownFieldMsg sp fieldNames rest
  else unknownFieldMsg sp n

checkProvidedFields fieldNames Nil sp = Ok Nil

checkProvidedFields fieldNames (Cons (Pair n v) rest) sp =
  if memName n fieldNames then checkProvidedFields fieldNames rest sp
  else Err (unknownFieldMsg sp n)

-- 记录声明抽取：DRecord 记住 RecordInfo，并降级成单构造器 DData。
extractRecords Nil = Pair Nil Nil

extractRecords (Cons d rest) =
  case extractRecords rest of
    Pair recs ds =>
      case d of
        DRecord dname params fields derivings sp =>
          let info = RecordInfo dname params (map recordFieldPair fields) derivings
          in Pair (Cons info recs) (Cons (recordDeclToData d) ds)
        _ => Pair recs (Cons d ds)

recordFieldPair (Field fname ty sp) = Pair fname ty

recordParamNames Nil = Nil

recordParamNames (Cons p rest) = Cons p (recordParamNames rest)

recordParamVarExprs params sp = map (\p => EVar p sp) params

recordCtorFieldExprs fields = map fieldType fields

recordRetType dname params sp = EApp (EVar dname sp) (recordParamVarExprs (recordParamNames params) sp) sp

recordArrowType Nil ret sp = ret

recordArrowType (Cons f fs) ret sp =
  EApp (EVar "->" sp) (Cons (fieldType f) (Cons (recordArrowType fs ret sp) Nil)) sp

recordDeclToData (DRecord dname params fields derivings sp) =
  DData dname params
    (Cons (Ctor dname (recordArrowType fields (recordRetType dname params sp) sp) (length fields) sp) Nil)
    derivings sp

-- 记录语法降级：构造 → 构造器应用；记录模式 → 构造器模式（按声明顺序补 PWild）。
desugarRecords : List RecordInfo -> List Decl -> Result (List Decl)
desugarRecords records decls = traverse (desugarRecordDecl records) decls

desugarRecordDecl : List RecordInfo -> Decl -> Result Decl
desugarRecordDecl records d =
  case d of
    DFun name pats body sp =>
      andThen (traverse (desugarPattern records) pats) (\pats2 =>
        andThen (desugarExpr records body) (\body2 => Ok (DFun name pats2 body2 sp)))
    DData name params ctors derivings sp => Ok d
    DRecord name params fields derivings sp => Ok d
    DTrait name params methods sp => Ok d
    DInstance iname isDefault head methods sp =>
      andThen (traverse (desugarRecordDecl records) methods) (\ms => Ok (DInstance iname isDefault head ms sp))
    DSig name ty sp => Ok d

desugarPattern records pat =
  case pat of
    PWild sp => Ok (PWild sp)
    PVar n sp => Ok (PVar n sp)
    PInt n sp => Ok (PInt n sp)
    PStr s sp => Ok (PStr s sp)
    PCon name pats sp =>
      andThen (traverse (desugarPattern records) pats) (\ps => Ok (PCon name ps sp))
    PRecord name fields sp =>
      case lookupRecord name records of
        Nothing => Err (showSpanLoc sp ++ ": unknown record: " ++ name)
        Just (RecordInfo rname params fdefs derivings) =>
          if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
          else if hasUnknownFields (fieldNamesOf fdefs) fields then
            Err (firstUnknownFieldMsg sp (fieldNamesOf fdefs) fields)
          else
            andThen (desugarRecordPatternFields records fdefs fields sp) (\ps =>
              Ok (PCon rname ps sp))

desugarRecordPatternFields records Nil provided sp = Ok Nil

desugarRecordPatternFields records (Cons (Pair fname fty) rest) provided sp =
  case lookupProvided fname provided of
    Nothing =>
      andThen (desugarRecordPatternFields records rest provided sp) (\ps =>
        Ok (Cons (PWild sp) ps))
    Just p =>
      andThen (desugarPattern records p) (\p2 =>
        andThen (desugarRecordPatternFields records rest provided sp) (\ps =>
          Ok (Cons p2 ps)))

desugarExpr : List RecordInfo -> Expr -> Result Expr
desugarExpr records e =
  case e of
    EVar n sp => Ok e
    EInt n sp => Ok e
    EStr s sp => Ok e
    ELam ps b sp =>
      andThen (desugarExpr records b) (\b2 => Ok (ELam ps b2 sp))
    EApp f args sp =>
      andThen (desugarExpr records f) (\f2 =>
        andThen (traverse (desugarExpr records) args) (\a2 => Ok (EApp f2 a2 sp)))
    ELet binds body rec_ sp =>
      andThen (traverse (desugarBind records) binds) (\b2 =>
        andThen (desugarExpr records body) (\body2 => Ok (ELet b2 body2 rec_ sp)))
    ECase scrut alts sp =>
      andThen (desugarExpr records scrut) (\s2 =>
        andThen (traverse (desugarAlt records) alts) (\a2 => Ok (ECase s2 a2 sp)))
    EIf c t el sp =>
      andThen (desugarExpr records c) (\c2 =>
        andThen (desugarExpr records t) (\t2 =>
          andThen (desugarExpr records el) (\e2 => Ok (EIf c2 t2 e2 sp))))
    EField base fname sp =>
      andThen (desugarExpr records base) (\b => Ok (EField b fname sp))
    ERecord name fields sp =>
      case lookupRecord name records of
        Nothing => Err (showSpanLoc sp ++ ": unknown record: " ++ name)
        Just (RecordInfo rname params fdefs derivings) =>
          if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
          else if hasUnknownFields (fieldNamesOf fdefs) fields then
            Err (firstUnknownFieldMsg sp (fieldNamesOf fdefs) fields)
          else
            andThen (desugarRecordValues records fdefs fields sp) (\vs =>
              Ok (EApp (EVar rname sp) vs sp))
    ERecUpdate base fields sp =>
      andThen (desugarExpr records base) (\b =>
        andThen (traverse (desugarFieldValue records) fields) (\fs => Ok (ERecUpdate b fs sp)))
    EInstSel m n sp =>
      andThen (desugarExpr records m) (\m2 => Ok (EInstSel m2 n sp))

desugarRecordValues : List RecordInfo -> List (Pair String Expr) -> List (Pair String Expr) -> Span -> Result (List Expr)
desugarRecordValues records Nil provided sp = Ok Nil

desugarRecordValues records (Cons (Pair fname fty) rest) provided sp =
  case lookupProvided fname provided of
    Nothing => Err (missingFieldMsg sp fname)
    Just v =>
      andThen (desugarExpr records v) (\v2 =>
        andThen (desugarRecordValues records rest provided sp) (\vs =>
          Ok (Cons v2 vs)))

desugarFieldValue : List RecordInfo -> Pair String Expr -> Result (Pair String Expr)
desugarFieldValue records (Pair fname v) =
  andThen (desugarExpr records v) (\v2 => Ok (Pair fname v2))

desugarBind : List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarBind records (Pair pat value) =
  andThen (desugarPattern records pat) (\p2 =>
    andThen (desugarExpr records value) (\v2 => Ok (Pair p2 v2)))

desugarAlt : List RecordInfo -> Pair Pat Expr -> Result (Pair Pat Expr)
desugarAlt records (Pair pat body) =
  andThen (desugarPattern records pat) (\p2 =>
    andThen (desugarExpr records body) (\b2 => Ok (Pair p2 b2)))

-- ---------------------------------------------------------------
-- 环境查询与推断
-- ---------------------------------------------------------------

lookupLocal name Nil = Nothing
lookupLocal name (Cons (Pair n ty) rest) =
  if n == name then Just ty else lookupLocal name rest

lookupScheme name Nil = Nothing
lookupScheme name (Cons (Pair n sch) rest) =
  if n == name then Just sch else lookupScheme name rest

funArgs ty =
  case ty of
    TFun a b => Cons a (funArgs b)
    _ => Nil

funResult ty =
  case ty of
    TFun a b => funResult b
    _ => ty

foldFun Nil body = body
foldFun (Cons a rest) body = TFun a (foldFun rest body)

seedPatTypes Nil st = Pair Nil st
seedPatTypes (Cons p rest) st =
  case freshTy st of
    Pair ty st1 =>
      case seedPatTypes rest st1 of
        Pair tys st2 => Pair (Cons ty tys) st2

inferPatterns globals locals Nil Nil st = Ok (Pair locals st)
inferPatterns globals locals (Cons p pr) (Cons ty tr) st =
  andThen (inferPattern globals locals st p ty) (\q =>
    case q of
      Pair locals2 st1 => inferPatterns globals locals2 pr tr st1)
inferPatterns globals locals _ _ st = Err "pattern arity mismatch"

inferPattern globals locals st pat expected =
  case pat of
    PWild _ => Ok (Pair locals st)
    PVar name _ => Ok (Pair (Cons (Pair name expected) locals) st)
    PInt n _ => andThen (unify intTy expected st) (\st2 => Ok (Pair locals st2))
    PStr s _ => andThen (unify strTy expected st) (\st2 => Ok (Pair locals st2))
    PCon name pats _ =>
      case lookupScheme name globals of
        Nothing => Err ("unknown constructor: " ++ name ++ suggest name (map firstOf globals))
        Just sch =>
          case instantiate st sch of
            Pair ctorTy st1 =>
              let argTys = funArgs ctorTy
              in if length pats == length argTys then
                   andThen (unify (funResult ctorTy) expected st1) (\st2 =>
                     inferPatterns globals locals pats argTys st2)
                 else Err ("constructor " ++ name ++ " expects " ++ strFromInt (length argTys) ++ " arguments")

inferArgs globals locals fnTy Nil st = Ok (Pair Nil (Pair Nil (Pair fnTy st)))
inferArgs globals locals fnTy (Cons arg rest) st =
  andThen (inferExpr globals locals st arg) (\pa =>
    case pa of
      Pair (Pair argTy argElab) st1 =>
        case freshTy st1 of
          Pair resTy st2 =>
            andThen (unify fnTy (TFun argTy resTy) st2) (\st3 =>
              andThen (inferArgs globals locals resTy rest st3) (\pr =>
                case pr of
                  Pair argTys (Pair argEls (Pair finalTy st4)) =>
                    Ok (Pair (Cons argTy argTys) (Pair (Cons argElab argEls) (Pair finalTy st4))))))

seedLocals Nil locals st = Pair Nil (Pair locals st)
seedLocals (Cons name rest) locals st =
  case freshTy st of
    Pair ty st1 =>
      case seedLocals rest (Cons (Pair name ty) locals) st1 of
        Pair tys (Pair locals2 st2) => Pair (Cons ty tys) (Pair locals2 st2)

inferBinds globals locals Nil st = Ok (Pair Nil (Pair locals st))
inferBinds globals locals (Cons (Pair pat value) rest) st =
  andThen (inferExpr globals locals st value) (\pv =>
    case pv of
      Pair (Pair valueTy valueElab) st1 =>
        andThen (inferPattern globals locals st1 pat valueTy) (\pp =>
          case pp of
            Pair locals2 st2 =>
              andThen (inferBinds globals locals2 rest st2) (\pr =>
                case pr of
                  Pair bindEls (Pair locals3 st3) =>
                    Ok (Pair (Cons (Pair pat valueElab) bindEls) (Pair locals3 st3)))))

-- 递归 let（where 块）：所有绑定名对全部 value 与 body 可见，可互相/自引用。
inferRecLet globals locals binds body sp st =
  case seedRecNames binds st of
    Err e => Err e
    Ok (Pair recPairs st1) =>
      let locals2 = recExtendLocals locals recPairs
      in case checkRecValues globals locals2 recPairs st1 of
           Err e => Err e
           Ok (Pair recElabs st2) =>
             case inferExpr globals locals2 st2 body of
               Err e => Err e
               Ok (Pair (Pair bodyTy bodyElab) st3) =>
                 Ok (Pair (Pair bodyTy (XELet recElabs bodyElab True sp)) st3)

seedRecNames Nil st = Ok (Pair Nil st)
seedRecNames (Cons (Pair pat value) rest) st =
  case pat of
    PVar name _ =>
      case freshTy st of
        Pair ty st1 =>
          case seedRecNames rest st1 of
            Ok (Pair tail st2) => Ok (Pair (Cons (Pair (Pair name ty) (Pair pat value)) tail) st2)
            Err e => Err e
    _ => Err "recursive let bindings must be simple names"

recExtendLocals locals Nil = locals
recExtendLocals locals (Cons (Pair (Pair name ty) _) rest) =
  recExtendLocals (Cons (Pair name ty) locals) rest

checkRecValues globals locals Nil st = Ok (Pair Nil st)
checkRecValues globals locals (Cons (Pair (Pair _ ty) (Pair pat value)) rest) st =
  andThen (inferExpr globals locals st value) (\pv =>
    case pv of
      Pair (Pair valueTy valueElab) st1 =>
        andThen (unify ty valueTy st1) (\st2 =>
          case checkRecValues globals locals rest st2 of
            Ok (Pair tail st3) => Ok (Pair (Cons (Pair pat valueElab) tail) st3)
            Err e => Err e))

inferAlts globals locals scrutTy Nil st = Err "empty case"
inferAlts globals locals scrutTy (Cons (Pair pat body) rest) st =
  andThen (inferPattern globals locals st pat scrutTy) (\pp =>
    case pp of
      Pair locals2 st1 =>
        andThen (inferExpr globals locals2 st1 body) (\pb =>
          case pb of
            Pair (Pair bodyTy bodyElab) st2 =>
              case rest of
                Nil => Ok (Pair (Cons (Pair pat bodyElab) Nil) (Pair bodyTy st2))
                _ =>
                  andThen (inferAlts globals locals scrutTy rest st2) (\pr =>
                    case pr of
                      Pair altsElab (Pair restTy st3) =>
                        andThen (unify bodyTy restTy st3) (\st4 =>
                          Ok (Pair (Cons (Pair pat bodyElab) altsElab) (Pair bodyTy st4))))))

instantiateForParam st (Scheme qs cons ty) pid =
  case instantiateVars qs st of
    Pair mapping st2 =>
      let ty2 = renameTy mapping ty
      in let paramTy = case lookupSubst pid mapping of
                         Just t => t
                         Nothing => TVar pid
         in Pair (Pair ty2 paramTy) st2

inferExpr globals locals st expr =
  case expr of
    EVar name sp =>
      case lookupLocal name locals of
        Just ty => Ok (Pair (Pair ty (XEVar name sp)) st)
        Nothing =>
          case lookupScheme name globals of
            Just sch =>
              case instantiateFull st sch of
                Pair (Pair ty cons) st2 =>
                  if cons == Nil then Ok (Pair (Pair ty (XEVar name sp)) st2)
                  else Ok (Pair (Pair ty (XEFun name cons sp)) st2)
            Nothing =>
              case methodRefForName name (traitMethodsOf st) of
                Just (TraitMethodRef key tr sch pid) =>
                  case instantiateForParam st sch pid of
                    Pair (Pair ty paramTy) st2 =>
                      Ok (Pair (Pair ty (XEMethod tr key paramTy sp)) st2)
                Nothing => Err ("unbound variable: " ++ name ++ suggest name (map firstOf globals))
    EInt n sp => Ok (Pair (Pair intTy (XEInt n sp)) st)
    EStr s sp => Ok (Pair (Pair strTy (XEStr s sp)) st)
    EApp fn args sp =>
      andThen (inferExpr globals locals st fn) (\pf =>
        case pf of
          Pair (Pair fnTy fnElab) st1 =>
            andThen (inferArgs globals locals fnTy args st1) (\pr =>
              case pr of
                Pair argTys (Pair argEls (Pair resTy st2)) =>
                  Ok (Pair (Pair resTy (elabAppExpr fn fnElab args argTys argEls sp)) st2)))
    ELam params body sp =>
      case seedLocals params locals st of
        Pair paramTys (Pair locals2 st1) =>
          andThen (inferExpr globals locals2 st1 body) (\pb =>
            case pb of
              Pair (Pair bodyTy bodyElab) st2 =>
                Ok (Pair (Pair (foldFun paramTys bodyTy) (XELam params bodyElab sp)) st2))
    ELet binds body rec_ sp =>
      if rec_ then inferRecLet globals locals binds body sp st
      else
        andThen (inferBinds globals locals binds st) (\pb =>
          case pb of
            Pair bindEls (Pair locals2 st1) =>
              andThen (inferExpr globals locals2 st1 body) (\pr =>
                case pr of
                  Pair (Pair bodyTy bodyElab) st2 =>
                    Ok (Pair (Pair bodyTy (XELet bindEls bodyElab False sp)) st2)))
    ECase scrut alts sp =>
      andThen (inferExpr globals locals st scrut) (\ps =>
        case ps of
          Pair (Pair scrutTy scrutElab) st1 =>
            andThen (inferAlts globals locals scrutTy alts st1) (\pr =>
              case pr of
                Pair altsElab (Pair bodyTy st2) =>
                  Ok (Pair (Pair bodyTy (XECase scrutElab scrutTy altsElab sp)) st2)))
    EIf c t e sp =>
      andThen (inferExpr globals locals st c) (\pc =>
        case pc of
          Pair (Pair condTy condElab) st1 =>
            andThen (unify condTy boolTy st1) (\st2 =>
              andThen (inferExpr globals locals st2 t) (\pt =>
                case pt of
                  Pair (Pair thenTy thenElab) st3 =>
                    andThen (inferExpr globals locals st3 e) (\pe =>
                      case pe of
                        Pair (Pair elseTy elseElab) st4 =>
                          andThen (unify thenTy elseTy st4) (\st5 =>
                            Ok (Pair (Pair thenTy (XEIf condElab thenElab elseElab sp)) st5))))))
    EField base fname sp =>
      andThen (inferExpr globals locals st base) (\pb =>
        case pb of
          Pair (Pair baseTy baseElab) st1 =>
            case freshTy st1 of
              Pair resTy st2 =>
                Ok (Pair (Pair resTy (XEField baseElab fname baseTy sp))
                      (addRecConstraint (FieldCon baseTy fname resTy sp) st2)))
    ERecUpdate base fields sp =>
      andThen (inferExpr globals locals st base) (\pb =>
        case pb of
          Pair (Pair baseTy baseElab) st1 =>
            if hasDuplicateFieldNames fields then Err (duplicateFieldMsg sp)
            else
              andThen (inferUpdateValues globals locals baseTy sp fields st1) (\p =>
                case p of
                  Pair vals st2 =>
                    Ok (Pair (Pair baseTy (XERecUpdate baseElab baseTy vals sp)) st2)))
    ERecord rname fields sp => Err (showSpanLoc sp ++ ": internal: record expression should be desugared before inference")
    EInstSel inner iname sp =>
      andThen (inferExpr globals locals st inner) (\p =>
        case p of
          Pair (Pair ty elab) st1 =>
            case elab of
              XEMethod tr key paramTy msp =>
                Ok (Pair (Pair ty (XEMethodInst tr key iname paramTy sp)) st1)
              _ => Err (showSpanLoc sp ++ ": @instance 只能用于 trait 方法"))

inferUpdateValues globals locals baseTy sp Nil st = Ok (Pair Nil st)

inferUpdateValues globals locals baseTy sp (Cons (Pair fname e) rest) st =
  andThen (inferExpr globals locals st e) (\p =>
    case p of
      Pair (Pair vty velab) st1 =>
        andThen (inferUpdateValues globals locals baseTy sp rest st1) (\r =>
          case r of
            Pair vs st2 =>
              Ok (Pair (Cons (Pair fname velab) vs)
                    (addRecConstraint (UpdateCon baseTy fname vty sp) st2))))

tcNoSpan = Span "" 0 0 0 0

nthFieldTy i Nil = EInt 0 tcNoSpan

nthFieldTy i (Cons (Pair n t) rest) = if i == 0 then t else nthFieldTy (i - 1) rest

-- 延迟记录约束求解：逐个尝试；全部求解后清空 TC 中的约束列表。
solveRecConstraints typeNames records cons st =
  case solveRecPass typeNames records cons st Nil of
    Err e => Err e
    Ok (Pair remaining st2) =>
      case remaining of
        Nil => Ok (clearRecConstraints st2)
        _ =>
          if length remaining == length cons then
            Err (recConstraintFailMsg remaining)
          else solveRecConstraints typeNames records remaining st2

recConstraintFailMsg Nil = "cannot resolve record type; add a type signature"

recConstraintFailMsg (Cons c rest) =
  case c of
    FieldCon baseTy fname resTy sp =>
      showSpanLoc sp ++ ": cannot resolve record type for field access ." ++ fname
      ++ "; add a type signature"
    UpdateCon baseTy fname valTy sp =>
      showSpanLoc sp ++ ": cannot resolve record type for record update {" ++ fname
      ++ " = ...}; add a type signature"

solveRecPass typeNames records Nil st acc = Ok (Pair (reverse acc) st)

solveRecPass typeNames records (Cons c rest) st acc =
  case solveOneConstraint typeNames records c st of
    Err e => Err e
    Ok (Pair solved st1) =>
      case solved of
        True => solveRecPass typeNames records rest st1 acc
        False => solveRecPass typeNames records rest st1 (Cons c acc)

solveOneConstraint typeNames records c st =
  case c of
    FieldCon baseTy fname targetTy sp =>
      solveFieldConstraint typeNames records baseTy fname targetTy sp st
    UpdateCon baseTy fname valTy sp =>
      solveFieldConstraint typeNames records baseTy fname valTy sp st

solveFieldConstraint typeNames records baseTy fname targetTy sp st =
  case resolveTy (substOf st) baseTy of
    TVar i => Ok (Pair False st)
    TCon rname args =>
      case lookupRecord rname records of
        Nothing => Err (showSpanLoc sp ++ ": not a record type: " ++ rname)
        Just (RecordInfo rname2 params fdefs derivings) =>
          case fieldIndex fname fdefs of
            Nothing =>
              Err (showSpanLoc sp ++ ": unknown field " ++ fname ++ " for record " ++ rname)
            Just k =>
              andThen (convertType typeNames (zipParamTys params args) st (nthFieldTy k fdefs)) (\p =>
                case p of
                  Pair (Pair fty vars) st1 =>
                    andThen (unify targetTy fty st1) (\st2 => Ok (Pair True st2)))
    _ => Err (showSpanLoc sp ++ ": not a record type in field access/update")

inferClause globals st (Pair pats body) =
  case seedPatTypes pats st of
    Pair paramTys st1 =>
      andThen (inferPatterns globals Nil pats paramTys st1) (\pp =>
        case pp of
          Pair locals2 st2 =>
            andThen (inferExpr globals locals2 st2 body) (\pb =>
              case pb of
                Pair (Pair bodyTy bodyElab) st3 =>
                  Ok (Pair (Pair (foldFun paramTys bodyTy) (Pair pats bodyElab)) st3)))

inferClauses globals Nil st = Err "function has no clauses"
inferClauses globals (Cons clause rest) st =
  andThen (inferClause globals st clause) (\pc =>
    case pc of
      Pair (Pair ty clauseElab) st1 =>
        case rest of
          Nil => Ok (Pair (Cons clauseElab Nil) (Pair ty st1))
          _ =>
            andThen (inferClauses globals rest st1) (\pr =>
              case pr of
                Pair clauseEls (Pair restTy st2) =>
                  andThen (unify ty restTy st2) (\st3 =>
                    Ok (Pair (Cons clauseElab clauseEls) (Pair ty st3)))))

functionNames decls = uniqueNames (map declFunName decls)

declFunName d =
  case d of
    DFun name pats body _ => name
    _ => ""

uniqueNames Nil = Nil
uniqueNames (Cons name rest) =
  if name == "" then uniqueNames rest
  else if memName name rest then uniqueNames rest
  else Cons name (uniqueNames rest)

hasSig name sigs = memName name (map firstOf sigs)

seedPlaceholders Nil sigs st = Pair Nil st
seedPlaceholders (Cons name rest) sigs st =
  if hasSig name sigs then seedPlaceholders rest sigs st
  else
    case freshTy st of
      Pair ty st1 =>
        case seedPlaceholders rest sigs st1 of
          Pair ps st2 => Pair (Cons (Pair name (mkScheme Nil ty)) ps) st2

updateScheme name sch env =
  case env of
    Nil => Nil
    Cons (Pair n s) rest =>
      if n == name then Cons (Pair n sch) rest else Cons (Pair n s) (updateScheme name sch rest)

-- 判断类型变量 v 是否 free 于 env（排除 name 自身）：
-- 只需要对 inferred 里出现的少量 free vars 逐个查 env，避免为每个函数构造整个 env 的并集。
varInScheme v sch =
  case sch of
    Scheme Nil Nil (TVar k) => v == k
    _ => memInt v (freeVarsScheme sch)

varInEnvExcept v name env =
  case env of
    Nil => False
    Cons (Pair n sch) rest =>
      if n == name then varInEnvExcept v name rest
      else if varInScheme v sch then True
      else varInEnvExcept v name rest

-- 可泛化的类型变量：freeVarsTy resolved 中不 free 于 env 的那些。
generalizableVars name env ty =
  filter (\v => not (varInEnvExcept v name env)) (freeVarsTy ty)

substOf (TC n s typeNames records cons methods tctx) = s

-- 类型错误的源码位置：取函数第一个子句体的 span（诊断）。
funLoc name decls =
  case clausesFor decls name of
    Nil => ""
    Cons (Pair pats body) _ =>
      let sp = exprSpan body
      in if spanStartLine sp == 0 then "" else showSpanLoc sp ++ ": "

filterNeeds genVars Nil = Nil

filterNeeds genVars (Cons (Pair tr ty) rest) =
  case headVarOf ty of
    Just v =>
      if memInt v genVars then Cons (Pair tr ty) (filterNeeds genVars rest)
      else filterNeeds genVars rest
    Nothing => filterNeeds genVars rest

checkFunctionOnce globals decls sigs name st =
  case lookupScheme name globals of
    Nothing => Err ("missing type signature: " ++ name)
    Just sch =>
      case instantiate st sch of
        Pair expected st1 =>
          case inferClauses globals (clausesFor decls name) st1 of
            Err e => Err (funLoc name decls ++ "in " ++ name ++ ": " ++ e)
            Ok (Pair clauseEls (Pair inferred st2)) =>
              case unify inferred expected st2 of
                Err e => Err (funLoc name decls ++ "in " ++ name ++ ": " ++ e)
                Ok st3 =>
                  andThen
                    (solveRecConstraints (typeNamesOfTC st3) (recordsOf st3) (constraintsOfTC st3) st3)
                    (\st4 =>
                      let resolved = resolveTy (substOf st4) inferred
                      in let genVars = generalizableVars name globals resolved
                         in let needs = collectNeedsClauses (substOf st4) (traitCtxOf st4) clauseEls
                            in Ok (Pair clauseEls (Pair inferred (Pair needs (Pair genVars st4)))))

finishFunction globals decls sigs name inferred needs genVars clauses st =
  let params = dictParamsFor (traitCtxOf st) needs
  in finishFunctionCheck globals name inferred needs params clauses st

finishFunctionCheck globals name inferred needs params clauses st =
  case prependClauseParams (dictParamNames params) clauses of
    clauses2 =>
      andThen (validateTraitUsesClauses (substOf st) (traitCtxOf st) params clauses2) (\_ =>
        finishFunctionLower globals name inferred needs params clauses2 st)

finishFunctionLower globals name inferred needs params clauses2 st =
  let elab = lowerClauses (substOf st) (typeNamesOfTC st) (recordsOf st) (traitCtxOf st) params clauses2
  in finishFunctionScheme globals name inferred needs elab st

finishFunctionScheme globals name inferred needs elab st =
  let resolved = resolveTy (substOf st) inferred
  in let qs = generalizableVars name globals resolved
     in let scheme = Scheme qs needs resolved
        in Ok (Pair elab (Pair (updateScheme name scheme globals) st))

checkFunction globals decls sigs name st =
  case checkFunctionOnce globals decls sigs name st of
    Err e => Err e
    Ok (Pair clauses (Pair inferred (Pair needs (Pair genVars st1)))) =>
      let needs1 = filterNeeds genVars needs
      in if needs1 == Nil then
           finishFunction globals decls sigs name inferred Nil genVars clauses st1
         else
           let resolved = resolveTy (substOf st1) inferred
           in let scheme1 = Scheme genVars needs1 resolved
              in let globals2 = updateScheme name scheme1 globals
                 in case checkFunctionOnce globals2 decls sigs name st1 of
                      Err e => Err e
                      Ok (Pair clauses2 (Pair inferred2 (Pair needs2 (Pair genVars2 st2)))) =>
                        finishFunction globals2 decls sigs name inferred2 (filterNeeds genVars2 needs2) genVars2 clauses2 st2

checkFunctions globals decls sigs Nil st elabMap = Ok (Pair (reverse elabMap) (Pair globals st))
checkFunctions globals decls sigs (Cons name rest) st elabMap =
  andThen (checkFunction globals decls sigs name st) (\p =>
    case p of
      Pair clauseEls (Pair globals2 st1) =>
        checkFunctions globals2 decls sigs rest st1 (Cons (Pair name clauseEls) elabMap))

rebuildDecls Nil elabMap = Nil
rebuildDecls (Cons d rest) elabMap =
  case d of
    DFun name pats body sp =>
      case lookupPair name elabMap of
        Just (Cons (Pair pats2 body2) restElab) =>
          Cons (DFun name pats2 body2 sp) (rebuildDecls rest (replaceElab name restElab elabMap))
        _ => Cons d (rebuildDecls rest elabMap)
    _ => Cons d (rebuildDecls rest elabMap)

replaceElab name clauses Nil = Nil
replaceElab name clauses (Cons (Pair n old) rest) =
  if n == name then Cons (Pair n clauses) rest
  else Cons (Pair n old) (replaceElab name clauses rest)

-- ---------------------------------------------------------------
-- trait（M10.5）：静态派发
-- 方法调用在类型检查结束前确定实例（default 实例 / @命名实例 / Show、Eq 的结构回退），
-- lowering 直接换成实例方法函数引用。M10.5 不做约束泛化：调用点类型必须确定。
-- ---------------------------------------------------------------

tcJoin sep Nil = ""

tcJoin sep (Cons x Nil) = x

tcJoin sep (Cons x rest) = x ++ sep ++ tcJoin sep rest

sanitizeSymChar c = if c == 46 || c == 35 then 95 else c

sanitizeSym name = strPack (map sanitizeSymChar (strUnpack name))

lastSeg name =
  case splitLastDot (splitOnDot name) of
    Pair rev base => base

modulePrefixOf name =
  case splitLastDot (splitOnDot name) of
    Pair rev base => joinDots rev

tcQuoteChar c =
  if c == 34 then "\\\""
  else if c == 92 then "\\\\"
  else if c == 10 then "\\n"
  else if c == 9 then "\\t"
  else if c == 13 then "\\r"
  else strPack (Cons c Nil)

tcQuoteChars Nil = ""

tcQuoteChars (Cons c rest) = tcQuoteChar c ++ tcQuoteChars rest

tcQuote s = "\"" ++ tcQuoteChars (strUnpack s) ++ "\""

renderTyExpr ty =
  case ty of
    EVar n sp => n
    EApp (EVar "->" sp) (Cons a (Cons b Nil)) _ =>
      "(" ++ renderTyExpr a ++ " -> " ++ renderTyExpr b ++ ")"
    EApp f args sp =>
      "(" ++ renderTyExpr f ++ " " ++ tcJoin " " (map renderTyExpr args) ++ ")"
    _ => "Int"

-- 方法/实例数据结构
data TraitMethodInfo : Type where
  TraitMethodInfo : String -> Scheme -> Expr -> TraitMethodInfo

-- TraitDecl：trait 名、类型参数名、参数 kind 元数（0 = `*`，n = `* -> ... -> *`）、方法。
data TraitDecl : Type where
  TraitDecl : String -> String -> Int -> List TraitMethodInfo -> TraitDecl

data TraitMethodRef : Type where
  TraitMethodRef : String -> String -> Scheme -> Int -> TraitMethodRef

data TraitInst : Type where
  TraitInst : String -> Maybe String -> Ty -> List (Pair String String) -> TraitInst

data TraitCtx : Type where
  TraitCtx : List TraitDecl -> List TraitInst -> List String -> List String -> List TraitMethodRef -> TraitCtx

traitDeclName (TraitDecl n p a ms) = n

traitDeclParam (TraitDecl n p a ms) = p

traitDeclArity (TraitDecl n p a ms) = a

traitDeclMethods (TraitDecl n p a ms) = ms

traitArityOf tctx tr =
  case lookupTraitDecl tr (traitCtxDecls tctx) of
    Just td => traitDeclArity td
    Nothing => 0

methodInfoName (TraitMethodInfo n s t) = n

methodInfoScheme (TraitMethodInfo n s t) = s

methodInfoSig (TraitMethodInfo n s t) = t

instTraitName (TraitInst t n h impls) = t

instNameOf (TraitInst t n h impls) = n

instHeadTy (TraitInst t n h impls) = h

instImpls (TraitInst t n h impls) = impls

traitCtxDecls (TraitCtx ds is sup eqsup refs) = ds

traitCtxInsts (TraitCtx ds is sup eqsup refs) = is

traitCtxSupported (TraitCtx ds is sup eqsup refs) = sup

traitCtxEqSupported (TraitCtx ds is sup eqsup refs) = eqsup

traitCtxRefs (TraitCtx ds is sup eqsup refs) = refs

lookupTraitDecl name Nil = Nothing

lookupTraitDecl name (Cons (TraitDecl n p a ms) rest) =
  if n == name then Just (TraitDecl n p a ms) else lookupTraitDecl name rest

lookupMethodRef name Nil = Nothing

lookupMethodRef name (Cons (TraitMethodRef key tr sch pid) rest) =
  if key == name then Just (TraitMethodRef key tr sch pid) else lookupMethodRef name rest

lookupImpl meth Nil = Nothing

lookupImpl meth (Cons (Pair m fn) rest) =
  if m == meth then Just fn else lookupImpl meth rest

lookupNamedInst name Nil = Nothing

lookupNamedInst name (Cons inst rest) =
  case instNameOf inst of
    Just n => if n == name then Just inst else lookupNamedInst name rest
    Nothing => lookupNamedInst name rest

tyMatchesPattern pattern ty =
  case pattern of
    TVar i => True
    TCon n ps =>
      case ty of
        TCon m args => n == m && tyListMatches ps args
        _ => False
    TFun a b =>
      case ty of
        TFun x y => tyMatchesPattern a x && tyMatchesPattern b y
        _ => False
    TApp head args =>
      case ty of
        TApp head2 args2 => tyMatchesPattern head head2 && tyListMatches args args2
        _ => False

tyListMatches Nil Nil = True

tyListMatches (Cons p ps) (Cons t ts) =
  if tyMatchesPattern p t then tyListMatches ps ts else False

tyListMatches _ _ = False

-- arity > 0 的 trait（高阶 kind）：实例 head 是类型构造器本身，按 head 短名匹配。
findDefaultInst arity tr ty Nil = Nothing

findDefaultInst arity tr ty (Cons inst rest) =
  case instNameOf inst of
    Nothing =>
      if instTraitName inst == tr && instHeadMatches arity (instHeadTy inst) ty then Just inst
      else findDefaultInst arity tr ty rest
    Just _ => findDefaultInst arity tr ty rest

instHeadMatches arity headTy ty =
  if arity > 0 then headCtorMatches headTy ty
  else tyMatchesPattern headTy ty

tyEqual a b =
  case a of
    TVar i =>
      case b of
        TVar j => i == j
        _ => False
    TCon n xs =>
      case b of
        TCon m ys => n == m && tyListEqual xs ys
        _ => False
    TFun x y =>
      case b of
        TFun x2 y2 => tyEqual x x2 && tyEqual y y2
        _ => False
    TApp h xs =>
      case b of
        TApp h2 ys => tyEqual h h2 && tyListEqual xs ys
        _ => False

tyListEqual Nil Nil = True

tyListEqual (Cons a xs) (Cons b ys) = tyEqual a b && tyListEqual xs ys

tyListEqual _ _ = False

-- ---------- 内建 trait 声明 ----------

builtinA = EVar "a" tcNoSpan

builtinArrow a b = EApp (EVar "->" tcNoSpan) (Cons a (Cons b Nil)) tcNoSpan

builtinShowTrait =
  TraitDecl "Show" "a" 0
    (Cons
      (TraitMethodInfo "show"
        (mkScheme (Cons 0 Nil) (TFun (TVar 0) strTy))
        (builtinArrow builtinA (EVar "String" tcNoSpan)))
      Nil)

builtinEqTrait =
  TraitDecl "Eq" "a" 0
    (Cons
      (TraitMethodInfo "eq"
        (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy)))
        (builtinArrow builtinA (builtinArrow builtinA (EVar "Bool" tcNoSpan))))
      (Cons
        (TraitMethodInfo "neq"
          (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy)))
          (builtinArrow builtinA (builtinArrow builtinA (EVar "Bool" tcNoSpan))))
        Nil))

builtinOrdTrait =
  TraitDecl "Ord" "a" 0
    (Cons
      (TraitMethodInfo "lt"
        (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy)))
        (builtinArrow builtinA (builtinArrow builtinA (EVar "Bool" tcNoSpan))))
      (Cons
        (TraitMethodInfo "le"
          (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy)))
          (builtinArrow builtinA (builtinArrow builtinA (EVar "Bool" tcNoSpan))))
        (Cons
          (TraitMethodInfo "gt"
            (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy)))
            (builtinArrow builtinA (builtinArrow builtinA (EVar "Bool" tcNoSpan))))
          (Cons
            (TraitMethodInfo "ge"
              (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy)))
              (builtinArrow builtinA (builtinArrow builtinA (EVar "Bool" tcNoSpan))))
            Nil))))

builtinTraitDecls = Cons builtinShowTrait (Cons builtinEqTrait (Cons builtinOrdTrait Nil))

builtinMethodRefs =
  [ TraitMethodRef "show" "Show" (mkScheme (Cons 0 Nil) (TFun (TVar 0) strTy)) 0
  , TraitMethodRef "eq" "Eq" (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy))) 0
  , TraitMethodRef "neq" "Eq" (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy))) 0
  , TraitMethodRef "lt" "Ord" (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy))) 0
  , TraitMethodRef "le" "Ord" (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy))) 0
  , TraitMethodRef "gt" "Ord" (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy))) 0
  , TraitMethodRef "ge" "Ord" (mkScheme (Cons 0 Nil) (TFun (TVar 0) (TFun (TVar 0) boolTy))) 0
  ]

operatorMethod name =
  case name of
    "==" => Just (Pair "Eq" "eq")
    "/=" => Just (Pair "Eq" "neq")
    "<" => Just (Pair "Ord" "lt")
    "<=" => Just (Pair "Ord" "le")
    ">" => Just (Pair "Ord" "gt")
    ">=" => Just (Pair "Ord" "ge")
    _ => Nothing

methodRefForName name refs =
  case lookupMethodRef name refs of
    Just r => Just r
    Nothing =>
      case operatorMethod name of
        Just (Pair tr key) => lookupMethodRef key refs
        Nothing => Nothing

-- trait 参数固定用 TVar 0 表示；临时 TC 的 fresh 编号从 1 开始，避免与参数 0 撞号。
traitMethodScheme typeNames paramName sigTy =
  convertType typeNames (Cons (Pair paramName (TVar 0)) Nil) (TC 1 TsLeaf typeNames Nil Nil Nil (TraitCtx Nil Nil Nil Nil Nil)) sigTy

-- trait 类型参数的 kind 元数：方法签名里 `p a b ...` 的最大应用参数个数（0 = `*`）。
tyExprParamArity paramName ty =
  case ty of
    EApp (EVar n sp) args _ =>
      if n == paramName then length args else tyListParamArity paramName args
    EApp f args _ => maxInt (tyExprParamArity paramName f) (tyListParamArity paramName args)
    _ => 0

tyListParamArity paramName Nil = 0

tyListParamArity paramName (Cons ty rest) =
  maxInt (tyExprParamArity paramName ty) (tyListParamArity paramName rest)

maxInt a b = if a > b then a else b

traitParamArityCheck paramName Nil arity = Pair arity Nothing

traitParamArityCheck paramName (Cons (Pair mname sigTy) rest) arity =
  case traitParamArityCheck paramName rest arity of
    Pair arity2 conflict =>
      let a = tyExprParamArity paramName sigTy
      in if a == 0 || a == arity2 then Pair arity2 conflict
         else if arity2 == 0 then Pair a conflict
         else Pair arity2 (Just a)

collectTraitDecls typeNames decls = collectTraitDeclsGo typeNames decls builtinTraitDecls builtinMethodRefs

collectTraitDeclsGo typeNames Nil acc refs = Ok (Pair acc refs)

collectTraitDeclsGo typeNames (Cons d rest) acc refs =
  case d of
    DTrait tname params methods sp =>
      case params of
        Cons p Nil =>
          if memName tname (map traitDeclName acc) then
            Err (showSpanLoc sp ++ ": duplicate trait " ++ tname)
          else
            case traitParamArityCheck p methods 0 of
              Pair arity conflict =>
                case conflict of
                  Just other =>
                    Err (showSpanLoc sp ++ ": trait " ++ tname ++ " uses its type parameter both as a type and as a type constructor")
                  Nothing =>
                    case traitMethodInfos typeNames tname p methods Nil Nil sp of
                      Err e => Err e
                      Ok (Pair infos newRefs) =>
                        collectTraitDeclsGo typeNames rest (append acc (Cons (TraitDecl tname p arity infos) Nil)) (append refs newRefs)
        _ => Err (showSpanLoc sp ++ ": trait " ++ tname ++ " must have exactly one type parameter")
    _ => collectTraitDeclsGo typeNames rest acc refs

traitMethodInfos typeNames tname paramName methods infos refs sp =
  case methods of
    Nil => Ok (Pair (reverse infos) (reverse refs))
    Cons (Pair mname sigTy) rest =>
      if memName (lastSeg mname) (map methodInfoName infos) then
        Err (showSpanLoc sp ++ ": duplicate trait method " ++ mname)
      else
        case traitMethodScheme typeNames paramName sigTy of
          Err e => Err (showSpanLoc sp ++ ": in trait " ++ tname ++ " method " ++ mname ++ ": " ++ e)
          Ok (Pair (Pair ty vars) st) =>
            case lookupTyVar paramName vars of
              Just (TVar pid) =>
                traitMethodInfos typeNames tname paramName rest
                  (Cons (TraitMethodInfo (lastSeg mname) (mkScheme (varIds vars) ty) sigTy) infos)
                  (Cons (TraitMethodRef mname tname (mkScheme (varIds vars) ty) pid) refs) sp
              _ => Err (showSpanLoc sp ++ ": internal trait parameter error")

-- ---------- data shape + 结构 Show/Eq 生成 ----------

data DataShape : Type where
  DataShape : String -> List String -> List (Pair String (List Expr)) -> DataShape

shapeName (DataShape n p cs) = n

shapeParams (DataShape n p cs) = p

shapeCtors (DataShape n p cs) = cs

splitTyFields ty =
  case ty of
    EApp (EVar "->" _) (Cons a (Cons b Nil)) _ => Cons a (splitTyFields b)
    _ => Nil

shapeOfCtor (Ctor cname ty arity sp) = Pair cname (splitTyFields ty)

collectDataShapes Nil = Nil

collectDataShapes (Cons d rest) =
  case d of
    DData name params ctors derivings sp =>
      Cons (DataShape name params (map shapeOfCtor ctors)) (collectDataShapes rest)
    _ => collectDataShapes rest

lookupDataShape name Nil = Nothing

lookupDataShape name (Cons sh rest) =
  if shapeName sh == name then Just sh else lookupDataShape name rest

fieldTypeSupported supported ty =
  case ty of
    EVar "Int" sp => True
    EVar "String" sp => True
    EVar "Bool" sp => True
    EVar n sp => memName n supported
    _ => False

fieldTypesSupported supported Nil = True

fieldTypesSupported supported (Cons ty rest) =
  if fieldTypeSupported supported ty then fieldTypesSupported supported rest else False

shapeSupported supported (DataShape n params ctors) =
  if params == Nil then ctorsSupported supported ctors else False

ctorsSupported supported Nil = True

ctorsSupported supported (Cons (Pair cname ftypes) rest) =
  if fieldTypesSupported supported ftypes then ctorsSupported supported rest else False

addSupportedShapes Nil supported = Pair supported 0

addSupportedShapes (Cons sh shapes) supported =
  case addSupportedShapes shapes supported of
    Pair supported2 cnt =>
      if memName (shapeName sh) supported2 then Pair supported2 cnt
      else if shapeSupported (Cons (shapeName sh) supported2) sh then Pair (append supported2 (Cons (shapeName sh) Nil)) (cnt + 1)
      else Pair supported2 cnt

supportedShapesLoop shapes supported =
  case addSupportedShapes shapes supported of
    Pair supported2 cnt =>
      if cnt == 0 then supported2 else supportedShapesLoop shapes supported2

supportedShapes shapes = supportedShapesLoop shapes Nil

-- Eq 结构回退覆盖参数化 data：参数位置字段用泛型结构相等。
eqFieldSupported eqsup params ty =
  case ty of
    EVar n sp =>
      if memName n params then True
      else if n == "Int" || n == "String" || n == "Bool" then True
      else memName n eqsup
    EApp (EVar n sp) args _ => memName n eqsup && eqArgsSupported eqsup params args
    _ => False

eqArgsSupported eqsup params Nil = True

eqArgsSupported eqsup params (Cons ty rest) =
  if eqFieldSupported eqsup params ty then eqArgsSupported eqsup params rest else False

eqShapeSupported eqsup (DataShape n params ctors) =
  eqCtorsSupported eqsup params ctors

eqCtorsSupported eqsup params Nil = True

eqCtorsSupported eqsup params (Cons (Pair cname ftypes) rest) =
  if fieldsEqSupported eqsup params ftypes then eqCtorsSupported eqsup params rest else False

fieldsEqSupported eqsup params Nil = True

fieldsEqSupported eqsup params (Cons ty rest) =
  if eqFieldSupported eqsup params ty then fieldsEqSupported eqsup params rest else False

addEqSupportedShapes Nil eqsup = Pair eqsup 0

addEqSupportedShapes (Cons sh shapes) eqsup =
  case addEqSupportedShapes shapes eqsup of
    Pair eqsup2 cnt =>
      if memName (shapeName sh) eqsup2 then Pair eqsup2 cnt
      else if eqShapeSupported (Cons (shapeName sh) eqsup2) sh then Pair (append eqsup2 (Cons (shapeName sh) Nil)) (cnt + 1)
      else Pair eqsup2 cnt

eqSupportedLoop shapes eqsup =
  case addEqSupportedShapes shapes eqsup of
    Pair eqsup2 cnt => if cnt == 0 then eqsup2 else eqSupportedLoop shapes eqsup2

eqSupportedShapes shapes = eqSupportedLoop shapes Nil

showFnName tyName = "vuna_show_" ++ sanitizeSym tyName

eqFnName tyName = "vuna_eq_" ++ sanitizeSym tyName

neqFnName tyName = "vuna_neq_" ++ sanitizeSym tyName

varNamesAt prefix i n = if i >= n then Nil else Cons (prefix ++ strFromInt i) (varNamesAt prefix (i + 1) n)

varNames prefix n = varNamesAt prefix 0 n

ctorPatternSrc cname vars =
  case vars of
    Nil => cname
    _ => cname ++ " " ++ tcJoin " " vars

showArgParts Nil = Nil

showArgParts (Cons v rest) = Cons (tcQuote " ") (Cons ("(show " ++ v ++ ")") (showArgParts rest))

showCtorBody cname n =
  if n == 0 then tcQuote (lastSeg cname)
  else "(" ++ tcJoin " ++ " (append (Cons (tcQuote "(") (Cons (tcQuote (lastSeg cname)) (append (showArgParts (varNames "v" n)) (Cons (tcQuote ")") Nil)))) Nil) ++ ")"

structuralShowClause (Pair cname ftypes) =
  "  " ++ ctorPatternSrc cname (varNames "v" (length ftypes)) ++ " => " ++ showCtorBody cname (length ftypes)

structuralShowSrc sh =
  let tyName = shapeName sh
  in (showFnName tyName ++ " : " ++ tyName ++ " -> String\n"
      ++ showFnName tyName ++ " x = case x of\n"
      ++ tcJoin "\n" (map structuralShowClause (shapeCtors sh)))

eqCondAt Nil Nil = "(0 == 0)"

eqCondAt (Cons v vs) (Cons w ws) =
  case eqCondAt vs ws of
    "(0 == 0)" => "((" ++ v ++ ") == (" ++ w ++ "))"
    rest => "((" ++ v ++ ") == (" ++ w ++ ")) && " ++ rest

eqFieldFnSource params ty =
  case ty of
    EVar n sp =>
      if memName n params then "vuna_eq_generic"
      else if n == "Int" then "vuna_eq_int"
      else if n == "String" then "vuna_eq_str"
      else if n == "Bool" then "vuna_eq_bool"
      else eqFnName n
    EApp (EVar n sp) args _ => eqFnName n
    _ => "vuna_eq_generic"

eqPairConds Nil Nil params = Nil

eqPairConds (Cons fty frest) (Cons v rest) params =
  andThenListPair (eqFieldFnSource params fty) v (eqPairConds frest rest params)

andThenListPair fn v rest = Cons (fn ++ " (" ++ v ++ ")") rest

eqCondSrc params ftypes vvars wvars = eqCondJoin (eqPairConds ftypes vvars params) wvars

eqCondJoin Nil Nil = "(0 == 0)"

eqCondJoin (Cons f rest) (Cons w wrest) =
  case eqCondJoin rest wrest of
    "(0 == 0)" => "(" ++ f ++ " " ++ w ++ ")"
    more => "(" ++ f ++ " " ++ w ++ ") && " ++ more

structuralEqClause params (Pair cname ftypes) =
  let n = length ftypes
  in "  " ++ ctorPatternSrc cname (varNames "v" n) ++ " => case y of\n"
     ++ "    " ++ ctorPatternSrc cname (varNames "w" n) ++ " => " ++ eqCondSrc params ftypes (varNames "v" n) (varNames "w" n) ++ "\n"
     ++ "    _ => (0 == 1)"

eqSigTypeSrc sh =
  let tyName = shapeName sh
  in let params = shapeParams sh
  in case params of
       Nil => tyName
       _ => "(" ++ tyName ++ " " ++ tcJoin " " params ++ ")"

structuralEqSrc sh =
  let tyName = shapeName sh
  in let params = shapeParams sh
     in (eqFnName tyName ++ " : " ++ eqSigTypeSrc sh ++ " -> " ++ eqSigTypeSrc sh ++ " -> Bool\n"
         ++ eqFnName tyName ++ " x y = case x of\n"
         ++ tcJoin "\n" (map (structuralEqClause params) (shapeCtors sh))
         ++ "\n  _ => (0 == 1)\n"
         ++ neqFnName tyName ++ " : " ++ eqSigTypeSrc sh ++ " -> " ++ eqSigTypeSrc sh ++ " -> Bool\n"
         ++ neqFnName tyName ++ " x y = if " ++ eqFnName tyName ++ " x y then (0 == 1) else (0 == 0)")

structuralSrcs shapes supported eqSupported =
  concatMap
    (\sh => append
       (if memName (shapeName sh) supported then Cons (structuralShowSrc sh) Nil else Nil)
       (if memName (shapeName sh) eqSupported then Cons (structuralEqSrc sh) Nil else Nil))
    shapes
builtinHelperSrc =
  "vuna_show_int n = strFromInt n\n"
  ++ "vuna_show_bool b = if b then \"True\" else \"False\"\n"
  ++ "vuna_show_string s = bi_show_string s\n"
  ++ "vuna_eq_int a b = bi_eq_int a b\n"
  ++ "vuna_neq_int a b = bi_neq_int a b\n"
  ++ "vuna_eq_bool a b = bi_eq_bool a b\n"
  ++ "vuna_neq_bool a b = bi_neq_bool a b\n"
  ++ "vuna_eq_str a b = bi_eq_str a b\n"
  ++ "vuna_neq_str a b = bi_neq_str a b\n"
  ++ "vuna_lt_int a b = bi_lt_int a b\n"
  ++ "vuna_le_int a b = bi_le_int a b\n"
  ++ "vuna_gt_int a b = bi_gt_int a b\n"
  ++ "vuna_ge_int a b = bi_ge_int a b\n"
  ++ "vuna_eq_generic a b = bi_eq_generic a b\n"
  ++ "vuna_neq_generic a b = bi_neq_generic a b\n"
  ++ "vuna_lt_generic a b = bi_lt_generic a b\n"
  ++ "vuna_le_generic a b = bi_le_generic a b\n"
  ++ "vuna_gt_generic a b = bi_gt_generic a b\n"
  ++ "vuna_ge_generic a b = bi_ge_generic a b\n"

parseGenerated src =
  case parseSource "<generated>" src of
    Err e => Err ("internal generated source error: " ++ e)
    Ok (Source hdr imports decls) =>
      case hdr of
        Just h => Err "internal generated source error: unexpected module header"
        Nothing =>
          case imports of
            Nil => Ok decls
            _ => Err "internal generated source error: unexpected imports"

-- ---------- instance / deriving ----------

methodClauses name Nil = Nil

methodClauses name (Cons d rest) =
  case d of
    DFun n pats body sp => if n == name then Cons (Pair pats body) (methodClauses name rest) else methodClauses name rest
    _ => methodClauses name rest

substTyParam paramName headTy ty =
  case ty of
    EVar n sp => if n == paramName then headTy else EVar n sp
    EApp f args sp => EApp (substTyParam paramName headTy f) (map (substTyParam paramName headTy) args) sp
    _ => ty

instanceHeadParts headExpr =
  case headExpr of
    EApp (EVar traitName sp) (Cons headTy Nil) _ => Ok (Pair traitName headTy)
    _ => Err "invalid instance head (expected `instance Trait Type`)"

instanceNameFor isDefault iname =
  case iname of
    Just n => if isDefault then Nothing else Just n
    Nothing => Nothing

instKeyOf isDefault iname headTy =
  if isDefault then "d_" ++ sanitizeSym (renderTyExpr headTy)
  else
    case iname of
      Just n => sanitizeSym n
      Nothing => "d_" ++ sanitizeSym (renderTyExpr headTy)

implNameOf instKey methodShort = "vuna_inst_" ++ sanitizeSym instKey ++ "_" ++ sanitizeSym methodShort

unknownMethodNames known Nil = Nil

unknownMethodNames known (Cons d rest) =
  case d of
    DFun n pats body sp => if memName n known then unknownMethodNames known rest else Cons n (unknownMethodNames known rest)
    DSig n ty sp => unknownMethodNames known rest
    _ => unknownMethodNames known rest

clauseDecl implName (Pair pats body) sp = DFun implName pats body sp

instanceImpls typeNames traitDecl headTyExpr methods instKey sp =
  instanceImplsGo typeNames traitDecl headTyExpr methods instKey sp (traitDeclMethods traitDecl) Nil Nil

instanceImplsGo typeNames traitDecl headTyExpr methods instKey sp Nil decls impls =
  case unknownMethodNames (map methodInfoName (traitDeclMethods traitDecl)) methods of
    Nil => Ok (Pair (reverse impls) (reverse decls))
    Cons bad rest => Err (showSpanLoc sp ++ ": instance has unknown method " ++ bad)

instanceImplsGo typeNames traitDecl headTyExpr methods instKey sp (Cons info rest) decls impls =
  let short = methodInfoName info
  in let clauses = methodClauses short methods
     in case clauses of
          Nil => Err (showSpanLoc sp ++ ": instance is missing method " ++ short)
          _ =>
            let implName = implNameOf instKey short
            in let sigTy = substTyParam (traitDeclParam traitDecl) headTyExpr (methodInfoSig info)
               in let sigDecl = DSig implName sigTy sp
                  in let funDecls = map (\c => clauseDecl implName c sp) clauses
                     in instanceImplsGo typeNames traitDecl headTyExpr methods instKey sp rest
                          (append (Cons sigDecl (append funDecls Nil)) decls)
                          (Cons (Pair short implName) impls)

preludeModule = "<prelude>"

isBuiltinTypeName name = name == "Int" || name == "String" || name == "Bool" || name == "List"

orphanAllowed instModule traitName headTy =
  let traitModule = if memName traitName (Cons "Show" (Cons "Eq" (Cons "Ord" Nil))) then preludeModule else modulePrefixOf traitName
  in let outerName = tyOuterTypeName headTy
     in let headModule = if isBuiltinTypeName outerName then preludeModule else modulePrefixOf outerName
        in instModule == traitModule || instModule == headModule

tyOuterName ty =
  case ty of
    TCon n args => modulePrefixOf n
    _ => ""

tyOuterTypeName ty =
  case ty of
    TCon n args => n
    _ => ""

-- 类型构造器的 kind 元数（data/record 的参数个数；内建与未知类型按 0 处理）。
typeArityOf decls name =
  case decls of
    Nil => 0
    Cons d rest =>
      case d of
        DData dn params ctors derivings sp => if dn == name then length params else typeArityOf rest name
        DRecord dn params fields derivings sp => if dn == name then length params else typeArityOf rest name
        _ => typeArityOf rest name

-- 生成声明的归属模块（M12 分离编译）：函数名 → 定义它的 vuna 模块名（"" = runtime）。
declDefName d =
  case d of
    DSig name ty sp => name
    DFun name pats body sp => name
    _ => ""

declNamesOf Nil = Nil

declNamesOf (Cons d rest) =
  case declDefName d of
    "" => declNamesOf rest
    n => Cons n (declNamesOf rest)

declOwners owner decls = map (\n => Pair n owner) (declNamesOf decls)

instanceOwnerOf iname =
  case iname of
    Just n => modulePrefixOf n
    Nothing => ""

collectUserInstances typeNames traitDecls decls = collectUserInstancesGo typeNames traitDecls decls decls Nil Nil Nil

collectUserInstancesGo typeNames traitDecls allDecls Nil insts declsOut ownersOut = Ok (Pair (reverse insts) (Pair (reverse declsOut) (reverse ownersOut)))

collectUserInstancesGo typeNames traitDecls allDecls (Cons d rest) insts declsOut ownersOut =
  case d of
    DInstance iname isDefault headExpr methods sp =>
      case instanceHeadParts headExpr of
        Err e => Err (showSpanLoc sp ++ ": " ++ e)
        Ok (Pair traitName headTyExpr) =>
          case lookupTraitDecl traitName traitDecls of
            Nothing => Err (showSpanLoc sp ++ ": unknown trait " ++ traitName)
            Just traitDecl =>
              case convertType typeNames Nil (TC 0 TsLeaf typeNames Nil Nil Nil (TraitCtx Nil Nil Nil Nil Nil)) headTyExpr of
                Err e => Err (showSpanLoc sp ++ ": in instance head: " ++ e)
                Ok (Pair (Pair headTy vars) st) =>
                  if traitDeclArity traitDecl > 0 then
                    case headTyExpr of
                      EVar tcName sp2 =>
                        if typeArityOf allDecls tcName == traitDeclArity traitDecl then
                          finishInstanceKinded typeNames traitDecls allDecls traitDecl traitName iname isDefault headTyExpr headTy methods sp insts declsOut ownersOut rest
                        else
                          Err (showSpanLoc sp ++ ": instance head " ++ shortTyName tcName ++ " has kind * but trait " ++ traitName ++ " expects a type constructor of arity " ++ strFromInt (traitDeclArity traitDecl))
                      _ => Err (showSpanLoc sp ++ ": instance head for higher-kinded trait must be a type constructor name")
                  else if vars == Nil then
                    case iname of
                      Just internalName =>
                        if isDefault then
                          if orphanAllowed (modulePrefixOf internalName) traitName headTy then
                            finishInstance typeNames traitDecls allDecls traitDecl traitName iname isDefault headTyExpr headTy methods sp insts declsOut ownersOut rest
                          else
                            Err (showSpanLoc sp ++ ": orphan default instance " ++ traitName ++ " " ++ tyOuterTypeName headTy ++ "; name it with `as`")
                        else finishInstance typeNames traitDecls allDecls traitDecl traitName iname isDefault headTyExpr headTy methods sp insts declsOut ownersOut rest
                      Nothing => finishInstance typeNames traitDecls allDecls traitDecl traitName iname isDefault headTyExpr headTy methods sp insts declsOut ownersOut rest
                  else Err (showSpanLoc sp ++ ": instance head must be a concrete type")
    _ => collectUserInstancesGo typeNames traitDecls allDecls rest insts declsOut ownersOut

finishInstanceKinded typeNames traitDecls allDecls traitDecl traitName iname isDefault headTyExpr headTy methods sp insts declsOut ownersOut rest =
  let headTy2 = TCon (tyOuterTypeName headTy) Nil
  in finishInstance typeNames traitDecls allDecls traitDecl traitName iname isDefault headTyExpr headTy2 methods sp insts declsOut ownersOut rest

finishInstance typeNames traitDecls allDecls traitDecl traitName iname isDefault headTyExpr headTy methods sp insts declsOut ownersOut rest =
  let instKey = instKeyOf isDefault iname headTyExpr
  in case instanceImpls typeNames traitDecl headTyExpr methods instKey sp of
       Err e => Err e
       Ok (Pair impls newDecls) =>
         collectUserInstancesGo typeNames traitDecls allDecls rest
           (Cons (TraitInst traitName (instanceNameFor isDefault iname) headTy impls) insts)
           (append newDecls declsOut)
           (append (declOwners (instanceOwnerOf iname) newDecls) ownersOut)

defaultInstanceAllowed derivedType derivings traitName supported sp =
  if memName (tyOuterTypeName (TCon derivedType Nil)) supported then
    if memName traitName (Cons "Show" (Cons "Eq" Nil)) then Ok Nil
    else Err (showSpanLoc sp ++ ": deriving only supports Show/Eq in M10.5 (got " ++ traitName ++ ")")
  else Err (showSpanLoc sp ++ ": deriving " ++ traitName ++ " is not supported for type " ++ derivedType ++ " (fields must be Int/String/Bool or data types built from them)")

derivingImpls traitName tyName =
  case traitName of
    "Show" => Cons (Pair "show" (showFnName tyName)) Nil
    "Eq" => Cons (Pair "eq" (eqFnName tyName)) (Cons (Pair "neq" (neqFnName tyName)) Nil)
    _ => Nil

collectDerivings supported eqSupported decls = collectDerivingsGo supported eqSupported decls Nil

collectDerivingsGo supported eqSupported Nil insts = Ok (reverse insts)

collectDerivingsGo supported eqSupported (Cons d rest) insts =
  case declDerivings d of
    Nil => collectDerivingsGo supported eqSupported rest insts
    derivings =>
      case d of
        DData tyName params ctors derivings2 sp =>
          collectDerivingNames supported eqSupported tyName params derivings sp insts rest
        _ => collectDerivingsGo supported eqSupported rest insts

collectDerivingNames supported eqSupported tyName params Nil sp insts rest =
  collectDerivingsGo supported eqSupported rest insts

collectDerivingNames supported eqSupported tyName params (Cons traitName drest) sp insts rest =
  if traitName == "Show" && params /= Nil then
    Err (showSpanLoc sp ++ ": deriving Show is only supported for non-parameterized data types")
  else
    let allowedSet = if traitName == "Eq" then eqSupported else supported
    in case defaultInstanceAllowed tyName drest traitName allowedSet sp of
         Err e => Err e
         Ok _ =>
           collectDerivingNames supported eqSupported tyName params drest sp
             (Cons
               (TraitInst traitName Nothing
                 (dataHeadTy tyName params)
                 (derivingImpls traitName tyName))
               insts)
             rest

dataHeadTy tyName Nil = TCon tyName Nil

dataHeadTy tyName params = TCon tyName (map (\p => TVar 0) params)

instUniqueKey inst =
  case instNameOf inst of
    Just n => "named|" ++ n
    Nothing => "default|" ++ instTraitName inst ++ "|" ++ showTy (instHeadTy inst)

checkInstUniqueness Nil seen = Ok Nil

checkInstUniqueness (Cons inst rest) seen =
  let key = instUniqueKey inst
  in if memName key seen then
       Err ("duplicate instance: " ++ instTraitName inst ++ " " ++ showTy (instHeadTy inst))
     else checkInstUniqueness rest (Cons key seen)

stripTraitDecls Nil = Nil

stripTraitDecls (Cons d rest) =
  case d of
    DTrait n p ms sp => stripTraitDecls rest
    DInstance iname isDefault head methods sp => stripTraitDecls rest
    _ => Cons d (stripTraitDecls rest)

-- 结构 Show/Eq 生成函数的归属：按类型名反推定义模块。
structuralOwnersOf supported eqSupported sh =
  let tyName = shapeName sh
  in let owner = modulePrefixOf tyName
     in append
          (if memName tyName supported then Cons (Pair (showFnName tyName) owner) Nil else Nil)
          (if memName tyName eqSupported then
             Cons (Pair (eqFnName tyName) owner) (Cons (Pair (neqFnName tyName) owner) Nil)
           else Nil)

structuralOwners shapes supported eqSupported =
  concatMap (structuralOwnersOf supported eqSupported) shapes

prepareTraits typeNames decls =
  case collectTraitDecls typeNames decls of
    Err e => Err e
    Ok (Pair traitDecls methodRefs) =>
      case collectUserInstances typeNames traitDecls decls of
        Err e => Err e
        Ok (Pair userInsts (Pair instanceDecls instanceOwners)) =>
          let shapes = collectDataShapes decls
          in let supported = supportedShapes shapes
             in let eqSupported = eqSupportedShapes shapes
                in case collectDerivings supported eqSupported decls of
                  Err e => Err e
                  Ok derivedInsts =>
                    case checkInstUniqueness (append userInsts derivedInsts) Nil of
                      Err e => Err e
                      Ok _ =>
                        case parseGenerated builtinHelperSrc of
                          Err e => Err e
                          Ok builtinDecls =>
                            case parseGenerated (tcJoin "\n\n" (structuralSrcs shapes supported eqSupported)) of
                              Err e => Err e
                              Ok structDecls =>
                                let owners = append
                                               (append instanceOwners (declOwners "" builtinDecls))
                                               (structuralOwners shapes supported eqSupported)
                                in Ok (Pair
                                         (TraitCtx traitDecls (append userInsts derivedInsts) supported eqSupported methodRefs)
                                         (Pair
                                           (append (stripTraitDecls decls) (append instanceDecls (append builtinDecls structDecls)))
                                           owners))

totalConstraints Nil = 0

totalConstraints (Cons (Pair name (Scheme qs cons ty)) rest) =
  length cons + totalConstraints rest

checkProgramInfoElab : List Decl -> Result (Pair (List (Pair String Scheme)) (List Decl))
checkProgramInfoElab decls0 =
  andThen (checkProgramInfoElabImpl decls0) (\p => Ok (firstOf p))

-- 与 checkProgramInfoElab 相同，但额外返回生成声明的归属模块（M12 分离编译）。
checkProgramInfoElabOwners : List Decl -> Result (Pair (Pair (List (Pair String Scheme)) (List Decl)) (List (Pair String String)))
checkProgramInfoElabOwners decls0 = checkProgramInfoElabImpl decls0

checkProgramInfoElabImpl decls0 =
  case extractRecords decls0 of
    Pair records decls1 =>
      let typeNames = typeNamesOf decls1
      in case prepareTraits typeNames decls1 of
           Err e => Err e
           Ok (Pair tctx (Pair declsT owners)) =>
             case desugarRecords records declsT of
               Err e => Err e
               Ok decls2 =>
                 let freshTC = TC 0 TsLeaf typeNames records Nil (traitCtxRefs tctx) tctx
                 in case collectSigs typeNames decls2 freshTC of
                      Err e => Err e
                      Ok (Pair sigs st1) =>
                        case collectCtors typeNames decls2 st1 of
                          Err e => Err e
                          Ok (Pair ctors st2) =>
                            case seedPlaceholders (functionNames decls2) sigs st2 of
                              Pair placeholders st3 =>
                                let names = functionNames decls2
                                in let env0 = append builtinSchemes (append ctors (append sigs placeholders))
                                in case checkFunctions env0 decls2 sigs names st3 Nil of
                                     Err e => Err e
                                     Ok (Pair elab1 (Pair g1 stA)) =>
                                       if totalConstraints g1 == 0 then
                                         Ok (Pair (Pair (finalizeGlobals (substOf stA) g1) (rebuildDecls decls2 elab1)) owners)
                                       else
                                         case checkFunctions g1 decls2 sigs names freshTC Nil of
                                           Err e => Err e
                                           Ok (Pair elab2 (Pair g2 stB)) =>
                                             if totalConstraints g2 <= totalConstraints g1 then
                                               Ok (Pair (Pair (finalizeGlobals (substOf stB) g2) (rebuildDecls decls2 elab2)) owners)
                                             else
                                               case checkFunctions g2 decls2 sigs names freshTC Nil of
                                                 Err e => Err e
                                                 Ok (Pair elab3 (Pair g3 stC)) =>
                                                   Ok (Pair (Pair (finalizeGlobals (substOf stC) g3) (rebuildDecls decls2 elab3)) owners)

checkProgramInfo : List Decl -> Result (List (Pair String Scheme))
checkProgramInfo decls =
  andThen (checkProgramInfoElab decls) (\p => Ok (firstOf p))

checkProgram : List Decl -> Result (List String)
checkProgram decls =
  andThen (checkProgramInfo decls) (\_ => Ok Nil)

-- ---------------------------------------------------------------
-- 穷尽性 / 冗余诊断（非致命警告；typecheck 成功后单独运行）
-- ---------------------------------------------------------------

exhaustiveWarnings : List Decl -> List String
exhaustiveWarnings decls =
  case checkProgramInfo decls of
    Ok globals => programWarnings globals decls
    Err _ => Nil

programWarnings globals decls =
  concatMap (funWarnings globals decls) (functionNames decls)

funWarnings globals decls name =
  case lookupScheme name globals of
    Nothing => Nil
    Just sch =>
      let clauses = clausesFor decls name
      in let paramTys = flattenFun (schemeTy sch)
         in let bodyWarn = concatMap (clauseBodyWarnings globals decls paramTys) clauses
            in append (funCoverageWarnings decls paramTys clauses) bodyWarn

clauseBodyWarnings globals decls paramTys (Pair pats body) =
  let locals = zipLocals (patsVarNames pats) paramTys
  in exprWarnings globals decls locals body

exprWarnings globals decls locals e =
  case e of
    EVar n sp => Nil
    EInt n sp => Nil
    EStr s sp => Nil
    ELam ps body sp =>
      case inferExpr globals locals (TC 0 TsLeaf Nil Nil Nil Nil (TraitCtx Nil Nil Nil Nil Nil)) e of
        Ok (Pair (Pair ty _) _) =>
          let pty = flattenFun ty
          in exprWarnings globals decls (append (zipLocals ps pty) locals) body
        Err _ => exprWarnings globals decls locals body
    EApp fn args sp => concatMap (exprWarnings globals decls locals) (Cons fn args)
    ELet binds body _ sp =>
      let locals2 = append (letLocals globals locals binds) locals
      in append (concatMap (bindWarnings globals decls) binds) (exprWarnings globals decls locals2 body)
    ECase scrut alts sp =>
      append (caseWarnings globals decls locals scrut alts sp)
            (append (exprWarnings globals decls locals scrut) (concatMap (altWarnings globals decls locals) alts))
    EIf c t e sp => concatMap (exprWarnings globals decls locals) (Cons c (Cons t (Cons e Nil)))

altWarnings globals decls locals (Pair pat body) =
  exprWarnings globals decls locals body

letLocals globals locals Nil = Nil
letLocals globals locals (Cons (Pair pat value) rest) =
  let patTys = patternLocals globals locals pat value
  in append patTys (letLocals globals locals rest)

patternLocals globals locals pat value =
  case inferExpr globals locals (TC 0 TsLeaf Nil Nil Nil Nil (TraitCtx Nil Nil Nil Nil Nil)) value of
    Ok (Pair (Pair ty _) _) => patVarsTy pat ty
    Err _ => Nil

patVarsTy (PVar n _) ty = Cons (Pair n ty) Nil
patVarsTy (PCon _ subpats _) ty = subPatsVarNames subpats ty
patVarsTy _ ty = Nil

subPatsVarNames Nil ty = Nil
subPatsVarNames (Cons p rest) ty = append (patVarsTy p ty) (subPatsVarNames rest ty)

bindWarnings globals decls (Pair pat value) =
  case pat of
    PVar n _ => Nil
    PWild _ => Nil
    _ => Cons (showSpanLoc (patSpan pat) ++ ": non-exhaustive let pattern") Nil

caseWarnings globals decls locals scrut alts sp =
  case inferExpr globals locals (TC 0 TsLeaf Nil Nil Nil Nil (TraitCtx Nil Nil Nil Nil Nil)) scrut of
    Err _ => Nil
    Ok (Pair (Pair ty _) _) =>
      let ctors = tyCtorNames decls ty
      in if ctors == Nil then Nil
         else
           let pats = map firstOf alts
           in let exhaustive = hasCatchAll pats || allCtorsCovered pats ctors
              in let nonEx = if exhaustive then Nil else Cons (showSpanLoc sp ++ ": non-exhaustive case") Nil
                 in append nonEx (redundantWarnings pats)

funCoverageWarnings decls Nil clauses = Nil
funCoverageWarnings decls (Cons ty rest) clauses =
  let posPats = map (clausePatAt 0) clauses
  in let w1 = coverageWarnings decls ty posPats
     in append w1 (funCoverageWarnings decls rest (map dropFirstPat clauses))

clausePatAt i (Pair pats body) = nthOrWild i pats

coverageWarnings decls ty posPats =
  let ctors = tyCtorNames decls ty
  in if ctors == Nil then Nil
     else if posPats == Nil then Nil
     else
       let exhaustive = hasCatchAll posPats || allCtorsCovered posPats ctors
       in let nonEx = if exhaustive then Nil
                      else Cons (showSpanLoc (patSpan (firstPat posPats)) ++ ": non-exhaustive function clauses") Nil
          in append nonEx (redundantWarnings posPats)

firstPat (Cons p rest) = p
firstPat Nil = PWild (Span "" 0 0 0 0)

nthOrWild i Nil = PWild (Span "" 0 0 0 0)
nthOrWild 0 (Cons p rest) = p
nthOrWild i (Cons p rest) = nthOrWild (i - 1) rest

dropFirstPat (Pair pats body) =
  case pats of
    Nil => Pair Nil body
    Cons p pr => Pair pr body

tyCtorNames decls ty =
  case ty of
    TCon name _ => ctorNamesOf decls name
    _ => Nil

ctorNamesOf Nil name = Nil
ctorNamesOf (Cons d rest) name =
  case d of
    DData dn params ctors _ _ =>
      if dn == name then map ctorName ctors else ctorNamesOf rest name
    _ => ctorNamesOf rest name

allCtorsCovered pats Nil = True
allCtorsCovered pats (Cons c rest) =
  if ctorCovered c pats then allCtorsCovered pats rest else False

ctorCovered c Nil = False
ctorCovered c (Cons p rest) =
  if patCoversCtor c p then True else ctorCovered c rest

patCoversCtor c p =
  case p of
    PVar n _ => True
    PWild _ => True
    PCon pn subpats _ => pn == c
    _ => False

hasCatchAll Nil = False
hasCatchAll (Cons p rest) =
  case p of
    PVar n _ => True
    PWild _ => True
    _ => hasCatchAll rest

redundantWarnings pats = redWarn Nil pats

redWarn prefix Nil = Nil
redWarn prefix (Cons p rest) =
  let more = redWarn (append prefix (Cons p Nil)) rest
  in if anySubsumes p prefix then Cons (showSpanLoc (patSpan p) ++ ": redundant pattern") more
     else more

anySubsumes p Nil = False
anySubsumes p (Cons earlier rest) =
  if subsumes earlier p then True else anySubsumes p rest

subsumes earlier p =
  case earlier of
    PVar n _ => True
    PWild _ => True
    PCon en subpats _ =>
      case p of
        PCon pn ps2 _ => en == pn
        _ => False
    _ => False

patsVarNames Nil = Nil
patsVarNames (Cons p rest) = append (patVarNames p) (patsVarNames rest)

patVarNames p =
  case p of
    PVar n _ => Cons n Nil
    PCon _ subpats _ => concatMap patVarNames subpats
    _ => Nil

zipLocals Nil Nil = Nil
zipLocals (Cons n ns) (Cons t ts) = Cons (Pair n t) (zipLocals ns ts)
zipLocals _ _ = Nil

schemeTy (Scheme qs cons ty) = ty

flattenFun ty =
  case ty of
    TFun a b => Cons a (flattenFun b)
    _ => Nil

collectData decls =
  Pair (declDataNames decls) decls
shortTyName name =
  case splitLastDot (splitOnDot name) of
    Pair rev base => base

sameBuiltinTy a b =
  let sa = shortTyName a
  in (sa == "Bool" || sa == "List") && sa == shortTyName b

finalizeScheme subst (Scheme qs cons ty) =
  Scheme qs (map (\c => Pair (firstOf c) (resolveTy subst (secondOf c))) cons) (resolveTy subst ty)

finalizeGlobals subst globals =
  case globals of
    Nil => Nil
    Cons (Pair name sch) rest =>
      Cons (Pair name (finalizeScheme subst sch)) (finalizeGlobals subst rest)

