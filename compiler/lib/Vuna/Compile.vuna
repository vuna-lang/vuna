module Vuna.Compile (effectiveRoots, compileFile, compileFileChecked, compileFileTyped, compileFileTypedExec, checkFile, compileFileIn, compileFileCheckedIn, compileFileTypedIn, compileFileTypedExecIn, checkFileIn, programNeedsElab) where

-- Vuna.Compile：编译入口（供 CompilerCli / CLI / 测试使用）。
--
-- 从 Vuna.Interp 拆出的“编译半边”：只依赖 loader 与 codegen 管线，
-- 不依赖 Vuna.Eval（解释器属于工具链，不进 seed 闭包）。
import Vuna.Base
import Vuna.Pkg
import Vuna.Ast
import Vuna.Loader
import Vuna.Codegen
import Vuna.Typecheck
import Vuna.TypedCodegen

-- 默认模块根：编译器自身仓库布局（lib/ + stdlib/）。
effectiveRoots [] = [rawRoot "lib", rawRoot "stdlib/lib"]
effectiveRoots roots = roots

-- M10.5：使用记录/trait/deriving 的程序必须先经过类型检查与降级；
-- 旧程序保持原 legacy 路径（--no-typecheck 仍不类型检查）。
programNeedsElab [] = False
programNeedsElab (d :: rest) = case d of
  DRecord name params fields derivings sp => True
  DTrait name params methods sp => True
  DInstance iname isDefault head methods sp => True
  DData name params ctors derivings sp => case derivings of
    [] => programNeedsElab rest
    _ => True
  DFun name pats body sp =>
    if patsNeedElab pats then True else if exprNeedsElab body then True else programNeedsElab rest
  DSig name ty sp => programNeedsElab rest

patsNeedElab [] = False
patsNeedElab (p :: rest) = if patNeedsElab p then True else patsNeedElab rest

patNeedsElab p = case p of
  PRecord name fields sp => True
  PCon name pats sp => patsNeedElab pats
  _ => False

argsNeedElab [] = False
argsNeedElab (e :: rest) = if exprNeedsElab e then True else argsNeedElab rest

bindsNeedElab [] = False
bindsNeedElab ((Pair pat value) :: rest) =
  if patNeedsElab pat then True else if exprNeedsElab value then True else bindsNeedElab rest

altsNeedElab [] = False
altsNeedElab ((Pair pat body) :: rest) =
  if patNeedsElab pat then True else if exprNeedsElab body then True else altsNeedElab rest

exprNeedsElab e = case e of
  EField base fname sp => True
  ERecord name fields sp => True
  ERecUpdate base fields sp => True
  EInstSel meth iname sp => True
  EVar name sp => False
  EInt n sp => False
  EStr s sp => False
  ELam ps body sp => exprNeedsElab body
  EApp fn args sp => if exprNeedsElab fn then True else argsNeedElab args
  ELet binds body rec_ sp => if bindsNeedElab binds then True else exprNeedsElab body
  ECase scrut alts sp => if exprNeedsElab scrut then True else altsNeedElab alts
  EIf c t el sp =>
    if exprNeedsElab c then True else if exprNeedsElab t then True else exprNeedsElab el

compileFile roots entry printResult = compileFileIn "" roots entry printResult

compileFileIn entryPkg roots entry printResult =
  andThen (loadProgram roots entryPkg entry)
    (\decls => if programNeedsElab decls then andThen (checkProgramInfoElab decls) (\p => generateProgram (secondOf p) printResult) else generateProgram decls printResult)

compileFileChecked roots entry printResult = compileFileCheckedIn "" roots entry printResult

compileFileCheckedIn entryPkg roots entry printResult =
  andThen (loadProgram roots entryPkg entry)
    (\decls => if programNeedsElab decls then andThen (checkProgramInfoElab decls) (\p => generateProgram (secondOf p) printResult) else andThen (checkProgram decls) (\_ => generateProgram decls printResult))

compileFileTyped roots entry printResult = compileFileTypedIn "" roots entry printResult

compileFileTypedIn entryPkg roots entry printResult = andThen (loadProgram roots entryPkg entry) (\decls => andThen (checkProgramInfoElab decls) (\p => case p of
  Pair globals elabDecls => generateProgramTyped elabDecls globals printResult
)
)

compileFileTypedExec roots entry printResult = compileFileTypedExecIn "" roots entry printResult

compileFileTypedExecIn entryPkg roots entry printResult = andThen (loadProgram roots entryPkg entry) (\decls => andThen (checkProgramInfoElab decls) (\p => case p of
  Pair globals elabDecls => generateProgramTypedExec elabDecls globals printResult
)
)

-- 诊断：typecheck + 穷尽性/冗余警告（非致命）。返回警告列表。
checkFile roots entry = checkFileIn "" roots entry

checkFileIn entryPkg roots entry = case loadProgram roots entryPkg entry of
  Err e => Err e
  Ok decls => if programNeedsElab decls then case checkProgramInfoElab decls of
    Err e => Err e
    Ok (Pair globals elabDecls) => Ok (exhaustiveWarnings elabDecls)
  else case checkProgramInfo decls of
    Err e => Err e
    Ok _ => Ok (exhaustiveWarnings decls)
