module Vuna.CompilerCli (runCompilerCli, runCompilerCliFor, compilerUsageLines) where

-- Vuna.CompilerCli：编译器自己的 CLI（vuna-compiler）。
--
-- 只包含“把源码变成 OCaml / seed”需要的命令：compile / check / build / seed；
-- 工具命令（lint / interp / test / fmt / repl / doc）在 Vuna.Cli。
-- compiler/app/Main.vuna 的入口闭包就是 seed 闭包。
--
-- CLI 只有 typed codegen 一条路径；旧的 dynamic 开关（--no-typecheck /
-- --typecheck / --typed）已删除。--no-print 只用于 compile 的调试/测试场景。

import Vuna.Base
import Vuna.Pkg
import Vuna.Compile
import Vuna.SplitCli

compilerUsageLines : String -> String
compilerUsageLines prog =
  "  " ++ prog ++ " compile [--dt] [--no-print] [--root DIR]... <entry.vuna> [out.ml]\n"
  ++ "  " ++ prog ++ " check [--dt] [--root DIR]... (<entry.vuna> | <package-dir>)\n"
  ++ "  " ++ prog ++ " build [DIR [OUT]]              从 vuna.toml 构建包（默认 DIR=.，OUT=DIR/Main.ml）\n"
  ++ "  " ++ prog ++ " build --split OUT [DIR]        分离编译：逐模块 OCaml 源码 + build.sh 写到 OUT\n"
  ++ "  " ++ prog ++ " seed [OUT [DIR]]               生成多文件 seed（默认 OUT=seed，DIR=.）\n"
  ++ "  --dt                            experimental DT (core TT) single-file pipeline (M13)\n"
  ++ "  " ++ prog ++ " help, -h\n"

compilerUsage prog = "usage:\n" ++ compilerUsageLines prog

runCompilerCli : List String -> Int
runCompilerCli args = runCompilerCliFor "vuna-compiler" args

runCompilerCliFor : String -> List String -> Int
runCompilerCliFor prog args =
  if anyHelp args then helpFor prog else runCompilerCliFor1 prog args

runCompilerCliFor1 prog args =
  case args of
    Nil => usageErr prog
    Cons arg rest =>
      case arg of
        "compile" => compileArgs prog rest
        "check" => checkArgs prog rest
        "build" => if anyDt rest then dtCmdErr prog else buildArgs prog rest
        "seed" => if anyDt rest then dtCmdErr prog else seedArgs prog rest
        "help" => helpFor prog
        "--no-typecheck" => removedFlag prog arg
        "--typecheck" => removedFlag prog arg
        "--typed" => removedFlag prog arg
        "--out" => removedFlag prog arg
        _ =>
          if startsWith "-" arg then missingCommand prog arg
          else unknownCommand prog arg

anyHelp : List String -> Bool
anyHelp Nil = False
anyHelp (Cons arg rest) =
  if arg == "-h" || arg == "--help" then True else anyHelp rest

helpFor prog = let _ = print (compilerUsage prog) in 0

usageErr prog = let _ = print (compilerUsage prog) in 2

missingCommand prog arg =
  let msg = "error: missing command before `" ++ arg ++ "`\n" ++ "run `" ++ prog ++ " help` (or `" ++ prog ++ " compile ...`)\n"
  in let _ = print msg in 2

unknownCommand prog arg =
  let _ = print ("error: unknown command `" ++ arg ++ "`\n" ++ "run `" ++ prog ++ " help`\n") in 2

removedHint flag =
  case flag of
    "--no-typecheck" => "use `vuna interp` for unchecked execution"
    "--typecheck" => "typed codegen is always enabled"
    "--typed" => "typed codegen is always enabled"
    "--out" => "use the positional OUT argument"
    _ => ""

removedFlag prog flag =
  case removedHint flag of
    "" => usageErr prog
    hint => let _ = print ("error: " ++ flag ++ " has been removed; " ++ hint ++ "\n") in 2

invalidFlag prog flag =
  case flag of
    "--no-print" =>
      let _ = print "error: --no-print is only valid for `compile`; `build` never prints main's result\n" in 2
    _ => removedFlag prog flag

anyDt : List String -> Bool
anyDt Nil = False
anyDt (Cons arg rest) = if arg == "--dt" then True else anyDt rest

dtCmdErr prog =
  let _ = print ("error: --dt is only supported by compile/check/interp (M13 single-file mode)\n") in 2

dtRootErr prog =
  let _ = print ("error: --dt does not support --root yet (DT single-file mode)\n") in 2

dtDirErr prog =
  let _ = print ("error: --dt only supports a single file (DT packages come later)\n") in 2

-- ---------------------------------------------------------------
-- compile / check（文件模式）
-- ---------------------------------------------------------------

compileArgs prog args = compileParse prog True False False Nil args

compileParse prog printResult dt hasRoot roots args =
  case args of
    Nil => usageErr prog
    Cons arg rest =>
      case arg of
        "--dt" => compileParse prog printResult True hasRoot roots rest
        "--no-print" => compileParse prog False dt hasRoot roots rest
        "--root" => rootArg prog roots rest (\roots2, rest2 => compileParse prog printResult dt True roots2 rest2)
        _ =>
          if startsWith "-" arg then removedFlag prog arg
          else compileEmit prog printResult dt hasRoot roots arg rest

rootArg prog roots rest k =
  case rest of
    Cons dir rest2 => k (append roots (Cons (rawRoot dir) Nil)) rest2
    Nil => usageErr prog

compileEmit prog printResult dt hasRoot roots entry rest =
  if dt then
    if hasRoot then dtRootErr prog
    else
      case compileFileDt entry printResult of
        Ok code =>
          case rest of
            Nil => let _ = print code in 0
            Cons out Nil => let _ = writeFile out code in 0
            _ => usageErr prog
        Err e => let _ = print ("error: " ++ e ++ "\n") in 1
  else
    let actualRoots = effectiveRoots roots
    in case compileFileTyped actualRoots entry printResult of
         Ok code =>
           case rest of
             Nil => let _ = print code in 0
             Cons out Nil => let _ = writeFile out code in 0
             _ => usageErr prog
         Err e => let _ = print ("error: " ++ e ++ "\n") in 1

checkArgs prog args = checkParse prog False False Nil args

checkParse prog dt hasRoot roots args =
  case args of
    Cons "--dt" rest => checkParse prog True hasRoot roots rest
    Cons "--root" rest => rootArg prog roots rest (\roots2, rest2 => checkParse prog dt True roots2 rest2)
    Cons arg Nil =>
      if startsWith "-" arg then removedFlag prog arg
      else if dt then
        if hasRoot then dtRootErr prog
        else if isDirectory arg then dtDirErr prog
        else checkEmitDt arg
      else if isDirectory arg then checkPackage arg
      else checkEmit (effectiveRoots roots) arg
    _ => usageErr prog

checkEmitDt path =
  case checkFileDt path of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok warnings => let _ = printWarnings warnings in 0

checkEmit roots path =
  case checkFile roots path of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok warnings => let _ = printWarnings warnings in 0

printWarnings Nil = 0
printWarnings (Cons w rest) = let _ = print (w ++ "\n") in printWarnings rest

checkPackage dir =
  case loadPackage dir of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok pkg =>
      case checkFileIn (packageName pkg) (packageRoots pkg) (packageEntry pkg) of
        Err e => let _ = print ("error: " ++ e ++ "\n") in 1
        Ok warnings => let _ = printWarnings warnings in 0

-- ---------------------------------------------------------------
-- build（包模式）
-- ---------------------------------------------------------------

buildArgs prog args =
  case args of
    Cons "--split" Nil => usageErr prog
    Cons "--split" (Cons outDir rest) => buildSplitCmd prog outDir rest
    _ => buildParse prog Nothing Nothing args

buildSplitCmd prog outDir args =
  case args of
    Nil => splitRun outDir "."
    Cons dir Nil =>
      if startsWith "-" dir then invalidFlag prog dir else splitRun outDir dir
    _ => usageErr prog

splitRun outDir dir =
  let _ = makeDir outDir
  in case buildSplit dir outDir of
       Err e => let _ = print ("error: " ++ e ++ "\n") in 1
       Ok n =>
         let _ = print ("wrote " ++ strFromInt n ++ " files to " ++ outDir ++ "\n")
         in 0

seedArgs prog args =
  case args of
    Nil => seedRun "seed" "."
    Cons out rest =>
      if startsWith "-" out then invalidFlag prog out
      else case rest of
        Nil => seedRun out "."
        Cons dir Nil =>
          if startsWith "-" dir then invalidFlag prog dir else seedRun out dir
        _ => usageErr prog

seedRun out dir =
  let _ = makeDir out
  in case seedSplit dir out of
       Err e => let _ = print ("error: " ++ e ++ "\n") in 1
       Ok n =>
         let _ = print ("wrote " ++ strFromInt n ++ " files to " ++ out ++ "\n")
         in 0

buildParse prog dir out args =
  case args of
    Nil => buildRun (defaultDir dir) (defaultOut dir out)
    Cons arg rest =>
      if startsWith "-" arg then invalidFlag prog arg
      else case dir of
        Nothing => buildParse prog (Just arg) out rest
        Just _ =>
          case out of
            Nothing => buildParse prog dir (Just arg) rest
            Just _ => usageErr prog

defaultDir dir =
  case dir of
    Just dir2 => dir2
    Nothing => "."

defaultOut dir out =
  case out of
    Just out2 => out2
    Nothing =>
      let dir2 = defaultDir dir
      in if dir2 == "." then "Main.ml" else dir2 ++ "/Main.ml"

buildRun dir out =
  case loadPackage dir of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok pkg =>
      case compileFileTypedExecIn (packageName pkg) (packageRoots pkg) (packageEntry pkg) of
        Err e => let _ = print ("error: " ++ e ++ "\n") in 1
        Ok code =>
          let parent = firstOf (splitPath out)
          in let _ = if parent == "" then 0 else makeDir parent
             in let _ = writeFile out code
                in let _ = print ("wrote " ++ out ++ "\n")
                   in 0
