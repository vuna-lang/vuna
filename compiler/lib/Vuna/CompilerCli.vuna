module Vuna.CompilerCli (runCompilerCli, runCompilerCliFor, compilerUsageLines) where

-- Vuna.CompilerCli：编译器自己的 CLI（vuna-compiler）。
--
-- 只包含“把源码变成 OCaml / seed”需要的命令：compile / check / build / seed；
-- 工具命令（lint / interp / test / fmt / repl / doc）在 Vuna.Cli。
-- compiler/app/Main.vuna 的入口闭包就是 seed 闭包。

import Vuna.Base
import Vuna.Pkg
import Vuna.Compile
import Vuna.SplitCli

compilerUsageLines : String -> String
compilerUsageLines prog =
  "  " ++ prog ++ " compile [--no-print] [--no-typecheck] [--typecheck] [--typed] [--root DIR]... <entry.vuna> [out.ml]\n"
  ++ "  " ++ prog ++ " check [--root DIR]... (<entry.vuna> | <package-dir>)\n"
  ++ "  " ++ prog ++ " build [--no-print] [DIR] [OUT]        从 vuna.toml 构建包（默认 DIR=.，OUT=DIR/Main.ml）\n"
  ++ "  " ++ prog ++ " build --split OUT [DIR]               分离编译：逐模块 OCaml 源码 + build.sh 写到 OUT\n"
  ++ "  " ++ prog ++ " seed [OUT] [DIR]                      生成多文件 seed（默认 OUT=seed，DIR=.）\n"
  ++ "  " ++ prog ++ " help\n"

compilerUsage prog = "usage:\n" ++ compilerUsageLines prog

runCompilerCli : List String -> Int
runCompilerCli args = runCompilerCliFor "vuna-compiler" args

runCompilerCliFor : String -> List String -> Int
runCompilerCliFor prog args =
  case args of
    Nil => usageErr prog
    Cons arg rest =>
      case arg of
        "compile" => compileArgs prog rest
        "check" => checkArgs prog rest
        "build" => buildArgs prog rest
        "seed" => seedArgs prog rest
        "help" => helpFor prog
        "--help" => helpFor prog
        _ => compileArgs prog args

helpFor prog = let _ = print (compilerUsage prog) in 0

usageErr prog = let _ = print (compilerUsage prog) in 2

-- ---------------------------------------------------------------
-- compile / check（文件模式）
-- ---------------------------------------------------------------

compileArgs prog args = compileParse prog True True True Nil args

compileParse prog printResult typeCheck typed roots args =
  case args of
    Nil => usageErr prog
    Cons arg rest =>
      case arg of
        "--no-print" => compileParse prog False typeCheck typed roots rest
        "--no-typecheck" => compileParse prog printResult False False roots rest
        "--typecheck" => compileParse prog printResult True typed roots rest
        "--typed" => compileParse prog True True True roots rest
        "--root" => rootArg prog roots rest (\roots2, rest2 => compileParse prog printResult typeCheck typed roots2 rest2)
        _ => compileEmit printResult typeCheck typed roots arg rest

rootArg prog roots rest k =
  case rest of
    Cons dir rest2 => k (append roots (Cons (rawRoot dir) Nil)) rest2
    Nil => usageErr prog

compileEmit printResult typeCheck typed roots entry rest =
  let actualRoots = effectiveRoots roots
  in let result =
           if typed then compileFileTyped actualRoots entry printResult
           else if typeCheck then compileFileChecked actualRoots entry printResult
           else compileFile actualRoots entry printResult
     in case result of
          Ok code =>
            case rest of
              Cons out Nil => let _ = writeFile out code in 0
              _ => let _ = print code in 0
          Err e => let _ = print ("error: " ++ e ++ "\n") in 1

checkArgs prog args = checkParse prog Nil args

checkParse prog roots args =
  case args of
    Cons "--root" rest => rootArg prog roots rest (\roots2, rest2 => checkParse prog roots2 rest2)
    Cons path Nil =>
      if isDirectory path then checkPackage path
      else checkEmit (effectiveRoots roots) path
    _ => usageErr prog

checkEmit roots path =
  case checkFile roots path of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok warnings => let _ = printWarnings warnings in 0

printWarnings Nil = 0
printWarnings (Cons w rest) = let _ = print (w ++ "\n") in printWarnings rest

checkPackage dir =
  case loadPackage dir of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok pkg =>
      case compileFileCheckedIn (packageName pkg) (packageRoots pkg) (packageEntry pkg) False of
        Err e => let _ = print ("error: " ++ e ++ "\n") in 1
        Ok code => 0

-- ---------------------------------------------------------------
-- build（包模式）
-- ---------------------------------------------------------------

buildArgs prog args =
  case args of
    Cons "--split" (Cons outDir rest) => buildSplitCmd prog outDir rest
    _ => buildParse prog True Nothing Nothing args

buildSplitCmd prog outDir args =
  case args of
    Nil => splitRun outDir "."
    Cons dir Nil => splitRun outDir dir
    _ => usageErr prog

splitRun outDir dir =
  let _ = makeDir outDir
  in case buildSplit dir outDir of
       Err e => let _ = print ("error: " ++ e ++ "\n") in 1
       Ok n =>
         let _ = print ("wrote " ++ strFromInt n ++ " files to " ++ outDir ++ "\n")
         in 0

seedArgs prog args =
  case args of
    Nil => seedRun "seed" "."
    Cons out Nil => seedRun out "."
    Cons out (Cons dir Nil) => seedRun out dir
    _ => usageErr prog

seedRun out dir =
  let _ = makeDir out
  in case seedSplit dir out of
       Err e => let _ = print ("error: " ++ e ++ "\n") in 1
       Ok n =>
         let _ = print ("wrote " ++ strFromInt n ++ " files to " ++ out ++ "\n")
         in 0

buildParse prog printResult dir out args =
  case args of
    Nil => buildRun printResult (defaultDir dir) (defaultOut dir out)
    Cons arg rest =>
      case arg of
        "--no-print" => buildParse prog False dir out rest
        "--out" =>
          case rest of
            Cons out2 rest2 => buildParse prog printResult dir (Just out2) rest2
            Nil => usageErr prog
        _ =>
          case dir of
            Nothing => buildParse prog printResult (Just arg) out rest
            Just dir2 =>
              case out of
                Nothing =>
                  case rest of
                    Nil => buildRun printResult dir2 arg
                    _ => usageErr prog
                Just out2 => usageErr prog

defaultDir dir =
  case dir of
    Just dir2 => dir2
    Nothing => "."

defaultOut dir out =
  case out of
    Just out2 => out2
    Nothing =>
      let dir2 = defaultDir dir
      in if dir2 == "." then "Main.ml" else dir2 ++ "/Main.ml"

buildRun printResult dir out =
  case loadPackage dir of
    Err e => let _ = print ("error: " ++ e ++ "\n") in 1
    Ok pkg =>
      case compileFileTypedExecIn (packageName pkg) (packageRoots pkg) (packageEntry pkg) printResult of
        Err e => let _ = print ("error: " ++ e ++ "\n") in 1
        Ok code =>
          let parent = firstOf (splitPath out)
          in let _ = if parent == "" then 0 else makeDir parent
             in let _ = writeFile out code
                in let _ = print ("wrote " ++ out ++ "\n")
                   in 0
