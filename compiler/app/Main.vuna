-- vuna-compiler：编译器 CLI 入口（seed 与 stage 1 编译器共用）。
-- main : Eff [] Int——由运行时执行；getArgs/exit 走宿主原语 @vuna@prim_eff_getArgs / @vuna@prim_eff_exit。
import Vuna.Compiler.Driver.CompilerCli
-- 包接口面：下面这些模块不在编译器的运行路径上，但属于 compiler 包的导出面
-- （工具链与 examples/infra 消费）。显式 import 让它们进入入口闭包：seed 与包 iface
-- 都按入口闭包生成。
--
-- **不变量（已放宽）**：写侧完整性按 `compiler/vuna.toml` 的 `[export].modules` 判
-- （`Compile.writeIfaceShadow` 的 `exportedOwnOf`），不再要求「入口闭包覆盖 lib 根下
-- 全部 `.vuna`」——未导出的内部模块不参与判据。但**导出模块仍必须被入口闭包覆盖**：
-- 否则 `iface-skip partial`（不写接口），`Compile.checkPackage` 于是补一遍 lib check，
-- 同一份源码精化两遍（冷 `check compiler` 实测 21.5 s vs 单遍 12.5 s）。
-- 新增导出模块时同步补这里的 import。
import Vuna.Compiler.Frontend.Canonical.Ast
import Vuna.Compiler.Frontend.Canonical.Lex
import Vuna.Compiler.Frontend.Canonical.Pkg
import Vuna.Compiler.Core.Canonical
import Vuna.Compiler.Elab.Canonical
import Vuna.Compiler.Base.Bytes
import Vuna.Compiler.Driver.ToolPayload
import Vuna.Compiler.Native.Audit
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Base.Hash
import Vuna.Compiler.Base.Store
import Base.EffArgs
import Base.EffExit
import Base.Monad
import Base.Eff.Types
import Base.EffClock
import Base.EffConsole
import Base.EffEnv
import Base.EffFs
import Base.EffProcess

main : Eff [FsOp, ConsoleOp, ClockOp, EnvOp, ProcessOp, ExitOp, ArgsOp] Int
main = do
  args <- argsGetArgs
  code <- runCompilerCli args
  exitWith code
