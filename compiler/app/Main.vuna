-- vuna-compiler：编译器 CLI 入口（seed 与 stage 1 编译器共用）。
-- main : Eff [] Int——由运行时执行；getArgs/exit 走宿主原语 @vuna@prim_eff_getArgs / @vuna@prim_eff_exit。
import Vuna.Compiler.Driver.CompilerCli
-- 包接口面：下面这些模块不在编译器的运行路径上，但属于 compiler 包的导出面
-- （工具链与 examples/infra 消费）。显式 import 让它们进入入口闭包：seed 与包 iface
-- 都按入口闭包生成，iface 覆盖完整模块面后，根包 `check .` 才能走依赖 iface 的摘要/
-- 增量路径（否则 vuna-compiler 依赖被判 invalid，只能回退 full）。
--
-- **必须与 `compiler/vuna.toml` 的 `[export].modules` 全覆盖**：入口闭包少一个导出模块，
-- `writeIfaceShadow` 就判 `iface-skip partial`（不写接口），`Compile.checkPackage` 于是
-- 每轮都补一遍 lib check —— 同一份源码精化两遍（冷 `check compiler` 实测 21.5 s vs
-- 单遍 12.5 s）。新增导出模块时同步补这里的 import。
import Vuna.Compiler.Canonical
import Vuna.Compiler.Driver.ToolPayload
import Vuna.Compiler.Frontend.Cst
import Vuna.Compiler.Hash
import Vuna.Compiler.Store
import Base.EffArgs
import Base.EffExit
import Base.HostRow
import Base.Monad
import Base.Eff

main : Eff hostRow Int
main = do
  args <- argsGetArgs
  code <- runCompilerCli args
  exitWith code
